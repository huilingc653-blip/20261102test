<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{erpBasicDataPage.id}">
		<input id="dataTypeCode" name="dataTypeCode" type="hidden" value="$!{erpBasicDataPage.dataTypeCode}">
		<input id="typeCode" name="typeCode" type="hidden" value="$!{erpBasicDataPage.typeCode}">
		<input id="createDate" name="createDate" type="hidden" value="$!{erpBasicDataPage.createDate}">
		<input id="createBy" name="createBy" type="hidden" value="$!{erpBasicDataPage.createBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{erpBasicDataPage.updateDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{erpBasicDataPage.updateBy}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##内部系统代码
				<td class="textRight">#springMessage('table.erpBasicData.bytterCode')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="bytterCode" name="bytterCode" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.erpBasicData.bytterCode')">
										</td>
        		##外部系统代码
				<td class="textRight">#springMessage('table.erpBasicData.erpCode')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="erpCode" name="erpCode" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.erpBasicData.erpCode')">
										</td>
			</tr>
        	<tr>
        		##外部系统名称
				<td class="textRight">#springMessage('table.erpBasicData.erpName')</td>
				<td >
						<!--number-->
                        <input type="text" id="erpName" name="erpName" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.erpBasicData.erpName')">
										</td>
        		##外部系统备用
				<td class="textRight">#springMessage('table.erpBasicData.erpReverse')</td>
				<td >
						<!--number-->
                        <input type="text" id="erpReverse" name="erpReverse" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.erpBasicData.erpReverse')">
										</td>
			</tr>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button type="button" class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/dataexchange2/basic/erpbasicdata.add.js?_btv=${resourceVersion}"></script>
</html>
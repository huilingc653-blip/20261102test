<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.erpBasicData.typeCode')</td>
            <td width="40%" >
                <div class="layui-inline">
                    <div class="bt-biz-selectType"  data-required="true" data-biz-name="typeCode" data-url="${basePath}/dataexchange2/basic/erptype/json"
                         data-valuefield="typeCode" data-textfield="showName"
                         data-method ="get" data-name="eqs_typeCode" data-search="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.erpBasicData.bytterCode')</td>
            <td  width="40%">
                <input type="text" name="likes_innerCode" autocomplete="off" class="layui-input" placeholder="#springMessage('table.erpBasicData.bytterCode')">
            </td>
            ##内部系统名称
            <td class="textRight">#springMessage('table.erpBasicData.bytterName')</td>
            <td width="40%">
                <input type="text" name="likes_innerName" autocomplete="off" class="layui-input" placeholder="#springMessage('table.erpBasicData.bytterName')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.erpBasicData.dataTypeCode')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType"  data-required="true" data-biz-name="dataTypeId" data-url="${basePath}/dataexchange2/basic/erpdynamicdata/dataType"
                         data-valuefield="id" data-textfield="showName"
                         data-method ="get" data-name="eqs_dataTypeId" data-search="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.erpBasicData.erpCode')</td>
            <td>
				<input type="text" name="likes_externalCode" autocomplete="off" class="layui-input" placeholder="#springMessage('table.erpBasicData.erpCode')">
			</td>
            ##外部系统名称
            <td class="textRight">#springMessage('table.erpBasicData.erpName')</td>
            <td>
                <input type="text" name="likes_externalName" autocomplete="off" class="layui-input" placeholder="#springMessage('table.erpBasicData.erpName')">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.erpBasicData.bytterCode')</th>
        <th>#springMessage('table.erpBasicData.bytterName')</th>
        <th>#springMessage('table.erpBasicData.bytterReverse')</th>
        <th>#springMessage('table.erpBasicData.erpCode')</th>
        <th>#springMessage('table.erpBasicData.erpName')</th>
        <th>#springMessage('table.erpBasicData.erpReverse')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/dataexchange/basic/erpDynamicData.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
        <input id="id" name="id" type="hidden" value="$!{erpDataTypePage.id}">
        <table class="layui-table">
            <tbody>
            <tr>
            ##类型代码
                <td width="30%" class="textRight">#springMessage('table.erpDataType.code')</td>
                <td >$!{erpDataTypePage.code}</td>
            </tr>
            <tr>
            ##类型名称
                <td class="textRight">#springMessage('table.erpDataType.name')</td>
                <td>$!{erpDataTypePage.name}</td>
            </tr>
            <tr>
            ##表名
                <td class="textRight">#springMessage('table.erpDataType.tableName')</td>
                <td >$!{erpDataTypePage.tableName}</td>
            </tr>
            <tr>
            ##CODE字段
                <td class="textRight">#springMessage('table.erpDataType.keyField')</td>
                <td >$!{erpDataTypePage.keyField}</td>
            </tr>
            <tr>
            ##NAME字段
                <td class="textRight">#springMessage('table.erpDataType.valueField')</td>
                <td >$!{erpDataTypePage.valueField}</td>
            </tr>
            <tr>
            ##是否有效
                <td class="textRight">#springMessage('table.erpDataType.validSign')</td>
                <td>$!{erpDataTypePage.validSignName}</td>

            </tr>
            <tr>
            ##条件
                <td class="textRight">#springMessage('table.erpDataType.condition')</td>
                <td >$!{erpDataTypePage.queryCondition}</td>
            </tr>
            <tr>
            ##备注
                <td class="textRight">#springMessage('table.erpDataType.rmk')</td>
                <td >$!{erpDataTypePage.rmk}</td>
            </tr>
            </tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{erpTypePage.id}">
        <table class="layui-table">
            <tbody>
				<tr>
					##系统代码
					<td class="textRight">#springMessage('table.erpType.typeCode')</td>
    				<td width="40%">
						<!--number-->
						<input type="text" id="typeCode" name="typeCode"
							   
							    autocomplete="off" class="layui-input" lay-verify="required|numberOrletter|strlength" data-maxlength="50" placeholder="#springMessage('table.erpType.typeCode')" value="$!{erpTypePage.typeCode}">
											</td>
					##系统名称
					<td class="textRight">#springMessage('table.erpType.typeName')</td>
    				<td width="40%">
						<!--number-->
						<input type="text" id="typeName" name="typeName"
							   
							    autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="50" placeholder="#springMessage('table.erpType.typeName')" value="$!{erpTypePage.typeName}">
											</td>
        		</tr>
				<tr>
					##备注
					<td class="textRight">#springMessage('table.erpType.rmk')</td>
    				<td >
						<!--number-->
						<input type="text" id="rmk" name="rmk" lay-verify="strlength" data-maxlength="100"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.erpType.rmk')" value="$!{erpTypePage.rmk}">
											</td>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button type="button" class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/dataexchange/basic/erpType.edit.js?_btv=${resourceVersion}"></script>
</html>
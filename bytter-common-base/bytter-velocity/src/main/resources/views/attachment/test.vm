<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/common/footer.vm")
</head>
<body>
<div class="layui-input-inline" style="padding-bottom: 20px;">
    <button class="layui-btn" onclick="up && alert(up.getData());">获取Data</button>
    <button class="layui-btn" onclick="up && alert(up.getGroupId());">获取GroupId</button>
    <button class="layui-btn" onclick="up1 && alert(up1.getData());">获取Data1</button>
    <button class="layui-btn" onclick="up1 && alert(up1.getGroupId());">获取GroupId1</button>
</div>
<br/>
<div id="uploader" class="layui-input-inline"></div>
<div id="uploader1" class="layui-input-inline"></div>
<script>
    var up,up1;
    bt.use(['btUpload'], function(){
        up = bt.btUpload.init({
            elem: "#uploader",
            isExpand: true,
            auto: false,
            gid: '402880275e12fb12015e12fb12de0000'
        });
        up1 = bt.btUpload.init({
            elem: "#uploader1",
            isExpand: true,
            auto: false
        });
    });
</script>
</body>
</html>
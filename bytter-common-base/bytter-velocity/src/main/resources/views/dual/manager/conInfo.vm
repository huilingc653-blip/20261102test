##挂接的合同信息
<input type="hidden" id="relateCon" name="relateCon" value="$!{relateCon}" />
<input type="hidden" id="conType" name="conType" value="$!{conType}" />
<input type="hidden" id="conTypeId" name="conTypeId" value="$!{conTypeId}">
#if($!{relateCon}==1 && $!{conType}==1)
<div id="contractInfo" class="layui-input-inline">
    <input type="hidden" id="conId" name="conId" value="$!{conId}"/>
    <div class="layui-input-inline">
        <button class="layui-btn bt-biz-conSelect"  data-biz-name="conInfo" type="button"
                data-callback="conSelectCallback" data-beforeClick="conSelectBefore">#springMessage('common.button.select')</button>
    </div>
    <div class="layui-input-inline" id="viewCon"
         #if(!$conId)
         style="display: none"
         #end>
        <button class="layui-btn bt-biz-conView"  data-biz-name="conView" type="button"
                data-callback="conViewCallback" data-beforeClick="conViewBefore">#springMessage('common.button.view')</button>
    </div>
</div>
#end
<script src="${basePath}/static/modules/cms/loan/hookConOp.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/contract/conCommon.js?_btv=${resourceVersion}"></script>

*#
<tr>
    ##是否挂保证金
    <td class="textRight">#springMessage('table.fcBond.includeBond')</td>
    <td>
        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
            #if($!{isHookBond})
             data-defaultvalue="$!{isHookBond}"
            #else
             data-defaultvalue="1"
            #end
             data-biz-name="isHookBond"
             data-name="isHookBond" data-callback="changeFcBond"></div>
    </td>
    ##保证金额度单
    <td width="15%" class="textRight bondInfo">#springMessage('table.fcBond.quotas')</td>
    <td width="35%" class="bondInfo">
        <div class="layui-inline">
            <input id="bondBankAcc" name="bondBankAcc" type="text" readonly="true" class="layui-input"
                   value="$!{bondBankAcc}" lay-verify="required">
        </div>
        <div class="layui-inline">
            <button class="layui-btn bt-biz-bondAccInfo" data-biz-name="bondAcc" type="button"
                    data-callback="bondAccinfoCallback" data-beforeClick="checkCorp">#springMessage('common.button.select')
            </button>
        </div>
    </td>
</tr>
<tr>
    ##    保证金币种
    <td class="textRight">#springMessage('table.urationapply.bondCurId')</td>
    <td>
        <div class="layui-inline">
            <div class="bt-biz-selectType"
                 data-required="true" data-url=""
                 data-name="bondCurId" data-valuefield="id" data-textfield="curName" data-callback="changeBondCur"
                 data-defaultvalue="$!{bondCurId}" data-biz-name="bondCurId"></div>
        </div>
    </td>
    ##保证金比例
    <td width="15%" class="textRight">#springMessage('table.fcBond.bondPercent')</td>
    <td width="35%">
        <div class="layui-input-inline">
            <input type="text" data-name="bailmoneyRate" data-decimal="2"
                #if($!{bailmoneyRate})
                   value="$!{bailmoneyRate}"
                #else
                   value="0"
                #end
                   lay-verify="required" data-supermax="10"
                   class="layui-input bt-biz-rateType" data-biz-name="bailmoneyRate" data-callback="setBailMoney">
        </div>
    </td>
</tr>

<tr>
    ##保证金金额
    <td widht="15%" class="textRight">#springMessage('table.fcBond.bondmoney')</td>
    <td width="35%">
        <div class="layui-input-inline">
            <input type="text" id="bailmoney" name="bailmoney"
                #if($!{bailmoneyRate})
                   value="$!{bailmoney}"
                #end
                   data-decimal="2" class="layui-input bt-biz-moneyType" lay-verify="required"
                   data-biz-name="bailmoney" data-callback="setBailMoneyRate"
                   placeholder="#springMessage('table.cmsProvideLoanInfo.bailmoney')">
        </div>
    </td>
    ##保证金合同号
    <td width="15%" class="textRight">#springMessage('table.fcBond.contractNum')</td>
    <td width="35%">
        <div class="layui-input-inline">
            <input type="text" id="bailmoneyContract" name="bailmoneyContract" value="$!{bailmoneyContract}"
                   autocomplete="off" class="layui-input">
        </div>
    </td>
</tr>
<tr>
    <td width="15%" class="textRight">#springMessage('table.fcBond.bondRate')</td>
    <td>
        <div class="layui-inline">
            <input type="text" id="bondRate" data-name="bondRate" data-biz-name="bondRate"
                   class="layui-input bt-biz-rateType" value="$!{bondRate}">
        </div>
    </td>
</tr>
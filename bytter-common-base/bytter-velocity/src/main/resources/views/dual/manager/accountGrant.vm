<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<table class="layui-table">
    <colgroup>
        <col width="100">
        <col width="100">
        <col>
    </colgroup>
    <thead>
    <tr>
        <th>账号</th>
        <th>账号名称</th>
        <th>账号类型</th>
        <th>所属网点/单位</th>
        <th>用户</th>
        <th width="50">明细查询</th>
        <th width="50">查询余额</th>
        <th width="50">转账</th>
    </tr>
    </thead>
    <tbody>
#foreach($accountGrant in $accountGrantList)
    <tr>
        <td>$!{accountGrant.account}</td>
        <td>$!{accountGrant.accountName}</td>
        <td>$dictTag.get("sys.account.type",${accountGrant.accountType})</td>
        <td>$!{accountGrant.corpName}</td>
        <td>$!{accountGrant.username}</td>
        <td>
            #set($canQueryDetail=$accountGrant.canQueryDetail)
            #set($canQueryDetailHistory=$accountGrant.canQueryDetailHistory)
            #if($canQueryDetail == $canQueryDetailHistory)
                #if($canQueryDetail==0)否 #else 是#end
            #else
                 #if($canQueryDetailHistory==0)否 #else 是#end -> #if($canQueryDetail==0)否 #else 是#end
            #end
        </td>
        <td>
            #set($canQueryBalance=$accountGrant.canQueryBalance)
            #set($canQueryBalanceHistory=$accountGrant.canQueryBalanceHistory)
            #if($canQueryBalance == $canQueryBalanceHistory)
                #if($canQueryBalance==0)否 #else 是#end
            #else
                #if($canQueryBalanceHistory==0)否 #else 是#end -> #if($canQueryBalance==0)否 #else 是#end
            #end
        </td>
        <td>
            #set($canTransferAccounts=$accountGrant.canTransferAccounts)
            #set($canTransferAccountsHistory=$accountGrant.canTransferAccountsHistory)
            #if($canTransferAccounts == $canTransferAccountsHistory)
                #if($canTransferAccounts==0)否 #else 是#end
            #else
                #if($canTransferAccountsHistory==0)否 #else 是#end -> #if($canTransferAccounts==0)否 #else 是#end
            #end
        </td>
    </tr>
#end
    </tbody>
</table>
	#workFlowHtml()
    #parse("views/common/footer.vm")
	#workFlowScript()
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<table class="layui-table">
    <colgroup>
        <col width="100">
        <col width="100">
        <col>
    </colgroup>
    <thead>
    <tr>
        <th>单位</th>
        <th>用户名</th>
        <th>角色</th>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td>($!{sourceUser.corp.code})$!{sourceUser.corp.name}</td>
        <td>$!{sourceUser.username}</td>
        <td>
            #foreach($role in $sourceUserRoles)
                $!{role.name}
            #end
        </td>
    </tr>
    </tbody>
</table>
    <h4>将上方用户的角色复制并且替换到下方用户的角色</h4>
<table class="layui-table">
    <colgroup>
        <col width="100">
        <col width="100">
        <col>
    </colgroup>
    <thead>
    <tr>
        <th>单位</th>
        <th>用户名</th>
        <th>角色</th>
    </tr>
    </thead>
    <tbody>
#foreach($user in $userList)
    <tr>
        <td>$!{user.corpName}</td>
        <td>$!{user.username}</td>
        <td>
            #foreach($role in $user.roles)
                $!{role.name}
            #end
        </td>
    </tr>
#end
    </tbody>
</table>
	#workFlowHtml()
    #parse("views/common/footer.vm")
	#workFlowScript()
</body>
</html>

<input type="hidden" id="ratBankConfig" value="$!{ratBankConfig}">##授信银行控制
<tr id="isRmbRatTr" style="display:none";>
##是否折合成本位币
    <td class="textRight">#springMessage('table.cmsProvideLoanInfo.isRmbRat')</td>
    <td >
        <input type="checkbox" lay-skin="primary" id="isRmbRat" name="isRmbRat" lay-filter="isStandCur"
            #if($!{isRmbRat} == "1")
               checked="checked"
            #else

            #end
               value="$!{isRmbRat}" /> #springMessage('table.cmsProvideLoanInfo.isRmbRatWarn')
    </td>
##保存当前币种转换汇率
    <td class="textRight" id="exchangerateTd1">#springMessage('table.cmsProvideLoanInfo.exchangerate')</td>
    <td id="exchangerateTd2">
        <input class="layui-input bt-biz-moneyType" type="text" data-name="exchangerate" data-id="exchangerate" data-biz-name="exchangerate" readonly="readonly" value="$!{exchangerate}"
               autocomplete="off" data-minus="false" data-convert ="true">
    </td>
</tr>

<tr class="ratInfo">
    <input type="hidden" id="ratBankCode" value="$!{ratBankCode}">##授信银行联行号
    <td class="textRight">#springMessage('table.cmsProvideLoanInfo.itemCode')</td>
    <td >
        <div class="layui-inline" id="ratItemCodeDiv">
            <div class="bt-biz-selectType" data-biz-name="ratItemCode" data-url="${basePath}/cms/rat/ratitemcustom/getAllRatItem?type=0"
                 data-valuefield="id" data-textfield="name" data-name="ratItemCode" data-search="true" data-callback="setRationBtn" data-required="true" data-value="$!{ratItemCode}">
            </div>
            <input type="hidden" id="ratIsHangGua">
            ##    业务品种
            #springMessage('cms.business.race')
            <div class="bt-biz-selectType" data-biz-name="billName" data-initCallback="checkData"
                #if($!{ratItemCode})
                 data-url="${basePath}/cms/rat/ratBusinessRace/getBillByCustomId?customId=$!{ratItemCode}"
                    #else
                 data-url=""
                #end
                 data-valuefield="id" data-textfield="raceName" data-name="billName" data-search="true" data-value="$!{billName}" data-defaultvalue="first">
            </div>
        </div>
    </td>
##授信额度单
    <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rationSelect')</td>
    <td colspan="3">
    ##浏览按钮
        <div class="layui-input-inline" id="ratChooseBtn">
            <div>
                <button type="button" onclick="chooseRatCode()" class="layui-btn">#springMessage('common.button.browse')</button>
            </div>
        </div>
        <div class="layui-input-inline">
            <div style="display: none" id="rationBtn">
                <button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
            </div>
        </div>
    ##额度编号
    ##占用授信代码
        <span id="itemCodeTd"></span>
    </td>
</tr>

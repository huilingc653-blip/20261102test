#set($basePath=$springMacroRequestContext.contextPath)
#set($resourceVersion=$resourceVersion.get())
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>错误</title>
    <link rel="stylesheet" href="${basePath}/static/css/error.page.css">
</head>
<body>
<section class="page-error">
    <div class="page404"></div>
    <div class="text404">
        <h3>${errorMessage}</h3>
        <p><a href="${loginUrl}" >点击这里</a> 重新登录</p>
    </div>
</section>
<script src="${basePath}/static/plugins/jquery/jquery.min.js?_btv=${resourceVersion}" charset="utf-8"></script>
<script type="text/javascript">
    $(".text404 a").click(function(){
        var index = parent.layer.getFrameIndex(window.name);
        if(!index){
            if(typeof(layer) != "undefined"){
                index = layer.getFrameIndex(window.name);
            }
            if(index){
                layer.close(index);
                return;
            }
        }else{
            parent.layer.close(index);
            return;
        }

        var bt = parent.bt;
        if(bt && bt.navtab && bt.navtab.getCurrentNavTabId()){
            bt.navtab.closeCurrent();
            return;
        }
        window.history.go(-1);
    });
</script>
</body>
</html>

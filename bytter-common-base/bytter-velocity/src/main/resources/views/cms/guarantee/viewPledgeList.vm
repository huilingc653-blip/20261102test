<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<table  id="infoTable" class="layui-table layui-form" style="width:100%;" data-test="test">
    <thead>
    <tr>
        <th>#springMessage('table.guaPledge.pledgeAttr')</th>
        <th>#springMessage('table.guaPledge.pledgeNo')</th>
        <th>#springMessage('table.guaPledge.pledgeType')</th>
        <th>#springMessage('table.guaPledge.pledgeName')</th>
        <th>#springMessage('table.guaPledge.startDate')</th>
        <th>#springMessage('table.guaPledge.endDate')</th>
        <th>#springMessage('table.guaPledge.curId')</th>
        <th>#springMessage('table.guaPledge.pledgeMoney')</th>
        <th>#springMessage('table.guaPledge.availMoney')</th>
        <th>#springMessage('table.guaContractInfo.occupyMoney')</th>
    </tr>
    </thead>
    <tbody id="pledgeInfo">
        #foreach($item in $pledgeList)
        <tr id="$!{item.id}">
            <td style="text-align:center">$dictTag.get("guarantee.pledge.TypeAttr",$!{item.pledgeAttr})</td>
            <td style="text-align:center">$!{item.pledgeNo}</td>
            <td style="text-align:center">$!{item.typeName}</td>
            <td style="text-align:center">$!{item.pledgeName}</td>
            <td style="text-align:center">$!date.format('yyyy-MM-dd',$!{item.startDate})</td>
            <td style="text-align:center">$!date.format('yyyy-MM-dd',$!{item.endDate})</td>
            <td style="text-align:center">$!{item.curName}</td>
            <td style="text-align:right">$!number.formatNumeric($!{item.pledgeMoney})</td>
            <td style="text-align:right">$!number.formatNumeric($!{item.availMoney})</td>
            <td style="text-align:right">$!number.formatNumeric($!{item.occupyMoney})</td>
        </tr>
        #end
    </tbody>
    #if($!{viewFlag}=="0")
        <footer>
            <tr>
                <td colspan="10" style="text-align: center;">
                    <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.close')</button>
                </td>
            </tr>
        </footer>
    #end
</table>
</body>
#parse("views/common/footer.vm")
</html>
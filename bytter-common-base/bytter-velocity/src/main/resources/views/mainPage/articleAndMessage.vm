<script>
    bt.use(['laypage', 'layer','form','element','jquery'], function(){
        var form = layui.form();
        var element = layui.element();
        var laypage = layui.laypage;

        var fetchData = function(params){
            var page = params.page*10;
            var datas = [];
            for(var i=page;i<page+10;i++){
                var data = {};
                data.id = params.type+"-id-"+i;
                data.title = params.type+"测试标题"+i;
                data.content = "测试内容"+i;
                data.createBy = "admin"+i;
                data.createDate = new Date();
                data.status = i%2;
                datas.push(data);
            }
            renderTable(datas,params.type);
            params.pages=100;
            initPage(params);
        };

        var initPage = function(params){
            laypage({
                cont: params.type+'-page', first:false, pages: params.pages, curr:params.page||1, prev: '<em><</em>', next: '<em>></em>',
                jump: function(obj, first){
                    if(first){return;}
                    params.page = obj.curr;
                    params.type = obj.cont.replace("-page","");
                    fetchData(params,params.page);
                }
            });
        };

        var renderTable = function(dataList,type){
            var html = '';
            for(var i=0;i<dataList.length;i++){
                var data = dataList[i];
                html += '<tr data-id="'+data.id+'"><td>'+data.title+'</td>\n' +
                        '<td>'+data.content+'</td>\n'+
                        '<td>'+data.createBy+'</td>\n'+
                        '<td>'+data.createDate+'</td>\n';
                if("receive-message"===type){
                    html+='<td><span class="dot '+(data.status===0?"dot-unread":"dot-read")+'"></span>未读</td>\n';
                }
                html+= '<td><a href="javascript:void(0)" class="view">查看</a><a href="javascript:void(0)" class="delete">删除</a></td></tr>';
            }
            $('.message .'+type+' table tbody').html(html);
        };
        $('.message table tbody').on('click','.view,.delete',function(){
            var action = $(this).attr('class');
            var id = $(this).parents('tr').data('id');
            if(action==="view"){

            }else{

            }
        });
        element.on('tab(user-message-tab)', function(){
            if(this.getAttribute('lay-id')==="send-message"){
                $(".search-conditions,.tag-read").hide();
            }else{
                $(".search-conditions,.tag-read").show();
            }
        });
        form.on('select(message-condition)',function(data){
            console.log(data);
        });

        var types = ["receive-message","send-message"];
        for(var i=0;i<types.length;i++){
            var type = types[i];
            fetchData({page:1,type:type});
        }
    });
</script>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .calendarWrapper {
            height: 740px;
            width: 100%;
            overflow: auto;
        }
        .dark-skin #calendar {
            background-color: #25262B;
            border-radius: 8px;
        }
        .dark-skin tr:first-child > td > .fc-day-grid-event {
            border: none;
            /*background-color: #25262B!important;*/
            background-color: inherit!important;
        }
        .dark-skin .fc-basic-view .fc-day-number {
            color: #d3d3d3;
        }
        .dark-skin .fc-unthemed td.fc-today {
            background-color: #526dd9;
        }
        .dark-skin .fc-unthemed th,
        .dark-skin .fc-unthemed td,
        .dark-skin .fc-unthemed thead,
        .dark-skin .fc-unthemed tbody,
        .dark-skin .fc-unthemed .fc-divider,
        .dark-skin .fc-unthemed .fc-row,
        .dark-skin .fc-unthemed .fc-content,
        .dark-skin .fc-unthemed .fc-popover,
        .dark-skin .fc-unthemed .fc-list-view,
        .dark-skin .fc-unthemed .fc-list-heading td {
            border-color: rgb(46, 47, 52)
        }
        .dark-skin .h_calendar_alm {
           border: 1px solid #25262B;
        }
        .h_calendar_alm1 {
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
        }
        .h_calendar_alm2 {
            border-bottom-left-radius: 8px;
            border-bottom-right-radius: 8px;
        }
        .dark-skin .alm_content {
            border-top: 3px solid #25262B;
            background: #25262B;
        }
        .dark-skin .alm_date {
            background: #25262B;
            color: #d3d3d3;
            padding-left: 8px;
        }
    </style>
</head>
<body>
<div class="calendarWrapper layui-form">
    <div class="rightSidePanel mb50">
        <div id="div_day_detail" class="h_calendar_alm h_calendar_alm1 ">
            <div class="alm_content nofestival">
                <div class="layui-form-item" style="text-align: center;padding-top:15px;">
                    <input type="hidden" name="countryId">
                    <div class="layui-inline" style="margin-bottom: 20px;">
                        <input type="radio" name="type" value="0" title="#springMessage('fex.cotp.place')" checked=""
                               lay-filter="changeType">
                        <input type="radio" name="type" value="1"
                               title="#springMessage('table.ratBkrationRelief.curCode')" lay-filter="changeType">
                    </div>
                    <div class="layui-inline">
                        <input id="countryId" type="text" name="nameZh" class="layui-input text"
                               lay-verify="tableData" placeholder="#springMessage('common.placeholder.select')"
                               value="$!{btSwiftInfoVO.nameZh}" autocomplete="off">
                        <table id="countryCode" class="hide">
                            <thead>
                            <tr>
                                <th>#springMessage('table.tbCreditPeriod.code')</th>
                                <th>#springMessage('table.btswiftinfo.namezh')</th>
                                <th>#springMessage('table.btswiftinfo.nameen')</th>
                            </tr>
                            </thead>
                        </table>
                        <div id="curId" style="display: none" class="bt-biz-selectType" data-callback="bt.changeType"
                             data-url="${basePath}/basic/business/btcurrency/json" data-name="curId"
                             data-valueField="id" data-textField="curName" ></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="rightSidePanel mb50">
        <div id="div_day_detail" class="h_calendar_alm h_calendar_alm2">
            <div class="alm_date" style="padding-left:8px;text-align: left;"></div>
            <div class="alm_content nofestival">
                ##                <div class="today_icon" style="left:190px;top:-37px;"></div>
                <!--<div class="today_date"></div>
                <p id="alm_cnD"></p>
                <p id="alm_cnY"></p>
                <p id="alm_cnA"></p>
                <div class="alm_lunar_date"></div>-->
                <div class="layui-form-item" style="text-align: center;padding-top:15px;">
                    <div class="layui-inline">
                        <input type="radio" name="status" value="1" title="#springMessage("sys.calendar.workDay")"
                               checked="">
                        <input type="radio" name="status" value="0"
                               title="#springMessage("sys.calendar.non-workDay")">
                    </div>
                </div>
                <div class="layui-form-item" style="text-align: center;padding-top:15px;">
                    <div class="layui-inline">
                        <input type="text" name="startTime" id="startTime" lay-verify="required"
                               class="layui-input bt-input-inline bt-biz-dateType" data-endid="endTime"
                               style="width: 84px;">
                        <span class="date-mid">~</span>
                        <input type="text" name="endTime" id="endTime" lay-verify="required"
                               class="layui-input bt-input-inline bt-biz-dateType" style="width: 84px;">
                    </div>
                </div>
                <div class="layui-form-item" style="text-align: center;padding-top:15px;">
                    <div class="layui-inline">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                                'common.button.submit')</button>
                        <button type="button" onclick="resetForm();"
                                class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id='calendar' class="fl" style="position:absolute;top:20px;left:295px;"></div>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/calendar/sysCalendar.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

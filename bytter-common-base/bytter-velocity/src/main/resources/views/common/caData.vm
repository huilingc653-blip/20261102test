<script>
    /**
     * 根据加密方式加载证书控件
     * @param encrypt 加密方式
     */
    function loadCa(encrypt) {
        if($("#encrypt").val() == 1){
            //天威证书
            iTrusLoad();
        }else if($("#encrypt").val() == 2){
            //cfca证书
            OnLoad();
        }else if($("#encrypt").val() == 3){
            xyLoad();
        }
    }

    /**
     *  显示证书列表
     * @param encrypt 加密方式
     */
    function selectCa(encrypt,sourceData,msg,caCodId,callback) {
        if($("#encrypt").val() == 1){
            //天威证书
            selectiTrusCa();
        }else if($("#encrypt").val() == 2){
            //cfca证书
            SelectCertificateOnClick(getChromeCa,sourceData,msg,caCodId,callback);
        }else if($("#encrypt").val() == 3){
            //兴业证书
            selectXyCa();
        }
    }
    function getChromeCa(sourceData,msg,caCodId,callback) {
        if(isChrome){
            var caCoding = "";
            CryptoKit.signMsgPKCS7(sourceData, "SHA-1", true)
                    .then(function (response) {
                        caCoding = response.result;
                        if (caCoding == "") {
                            msg = "sys.ca.abnormal";
                        }
                        if(caCodId && caCodId != null){
                            $("#" + caCodId).val(caCoding);
                        }
                        $("#caCoding").val(caCoding);
                        $("#isCFCACheck").val("");
                        if(callback && callback != null) {
                            callback();
                        }
                    })
                    .catch(function (response) {
                        ShowErrorInfo(response);
                        msg = "sys.ca.abnormal";
                        $("#isCFCACheck").val("sys.ca.abnormal");
                    });
        }
    }

    /**
     * 根据不同的加密方式选择验签方法
     * @param encrypt 加密方式
     * @param signature 签名结果
     *
     */
    function verify(encrypt,sourceData,signature) {
        var bResult = false;
        if($("#encrypt").val() == 1){
            //天威证书
            bResult = iTrusVerifyData(sourceData,signature);
        }else if($("#encrypt").val() == 2){
            //cfca证书
            bResult = VerifyPKCS7OnClick(signature);
        }else if($("#encrypt").val() == 4){
            //山地证书
            bResult = check(sourceData,signature);
        }else if($("#encrypt").val() == 5){
            //晟安证书
            bResult = verifySa(sourceData,signature);
        }
        return bResult;
    }

    /**
     *  根据不同的加密方式选择不同的签名方法
     * @param encrypt 加密方式
     * @param signature 签名源
     */
    function sign(encrypt,sourceData){
        var signature = "";
        if(encrypt == 1){
            //天威证书
            signature = iTrusSignData(sourceData);
        }else if(encrypt == 2){
            //cfca证书
            signature = SignOnClick(sourceData);
        }else if(encrypt == 3){
            signature = signXyCa(sourceData);
        }else if(encrypt == 4){
            signature = signsd(sourceData);
        }else if(encrypt == 5){
            signature = signsa(sourceData);
        }
        return signature;
    }

    /**
     * 得到证书序列号
     * @param encrypt加密方式
     */
    function getCertInfo(encrypt) {
        var InfoContent = "";
        if(encrypt == 1){
            //天威证书
            InfoContent = getCertiTrus();
        }else if(encrypt == 2){
            //cfca证书
            InfoContent = GetCertInfoOnClick();
        }else if(encrypt == 3){
            InfoContent = getXyCertCN();
        }else if(encrypt == 4){
            InfoContent = getCertSN();
        }else if(encrypt == 5){
            InfoContent = getCertSN();
        }
        return InfoContent;
    }

    bt.use(['form','jquery'], function() {
        var form = bt.form();
        var $ = bt.jquery;
        var encrypt = $("#encrypt").val();
        loadCa(encrypt);
    });
    /**
     * 签名接口
     * @param sourceData
     */
    function signData(sourceData,type,callback) {
        var msg = "";
        bt.use(['form', 'jquery'], function () {
            var form = bt.form();
            var $ = bt.jquery;
            try {
                var licenceApp = $("#licenceApp").val();
                var encrypt = $("#encrypt").val();
                var caCoding = "";
                var cadn = $("#cadn").val();
                var t = licenceApp.indexOf(type) >= 0
                if( '0' != encrypt && t) {
                    if (encrypt == 1) {
                        if (cadn == "") {
                            msg = "sys.login.ca.no.binding";
                        }else {
                            CurCert = selectSingleCert("", cadn);
                            if(CurCert == null){
                                msg = "sys.ca.abnormal";
                            }else {
                                caCoding = iTrusSignData(sourceData);
                                $("#encrySource").val(sourceData);
                                $("#caCoding").val(caCoding);
                                if(caCoding == null){
                                    msg = "sys.ca.abnormal";
                                }
                                if(caCoding == "time"){
                                    msg = "sys.ca.time";
                                }
                                if(callback && callback != null && msg==""){
                                    callback();
                                }
                            }
                        }
                    } else if (encrypt == 2) {
                        if (cadn == "") {
                            msg = "sys.login.ca.no.binding";
                        }else {
                            selectCa(encrypt,sourceData,msg,null,callback);
                            $("#encrySource").val(sourceData);
                            if (!isChrome) {
                                caCoding = sign(encrypt, sourceData);
                                if (caCoding == "") {
                                    msg = "sys.ca.abnormal";
                                }
                                $("#caCoding").val(caCoding);
                                if(callback && callback != null && msg==""){
                                    callback();
                                }
                            }
                        }
                    }else if(encrypt == 3){
                        if (cadn == "") {
                            msg = "sys.login.ca.no.binding";
                        }else {
                            selectCa(encrypt,sourceData,msg);
                            $("#encrySource").val(sourceData);
                            caCoding = sign(encrypt, sourceData);
                            if (caCoding == "") {
                                msg = "sys.ca.abnormal";
                            }
                            $("#caCoding").val(caCoding);
                            if(callback && callback != null && msg==""){
                                callback();
                            }
                        }
                    }else if(encrypt == 4){
                        if (cadn == "") {
                            msg = "sys.login.ca.no.binding";
                        }else {
                            var key = keyExist();
                            if(key != "true"){
                                msg = "sys.login.insertCertificate";
                                return false;
                            }
                            var loginName = $("#loginName").val();
                            var certName = getCertName();
                            if(loginName != certName){
                                msg = "sys.ca.cert.name";
                                return false;
                            }
                            $("#encrySource").val(sourceData);
                            caCoding = sign(encrypt, sourceData);
                            if (caCoding == "") {
                                msg = "sys.ca.abnormal";
                            }
                            $("#caCoding").val(caCoding);
                            if(callback && callback != null && msg==""){
                                callback();
                            }
                        }
                    }else if(encrypt == 5){
                        if (cadn == "") {
                            msg = "sys.login.ca.no.binding";
                        }else {
                            $("#encrySource").val(sourceData);
                            caCoding = sign(encrypt, sourceData);
                            if (caCoding == "") {
                                msg = "sys.ca.abnormal";
                            }
                            $("#caCoding").val(caCoding);
                            if(callback && callback != null && msg==""){
                                callback();
                            }
                        }
                    }
                }else{
                    //不挂证书直接回调
                    if(callback && callback != null && msg==""){
                        callback();
                    }
                }

            }catch (e){
                // 如果是天威证时，异常e有相对应的报错信息，就采用它的内容
                if(encrypt == 1 && e){
                    msg = ''
                }else{
                    msg = "sys.ca.abnormal";
                }
            }

        });
        return msg;
    }

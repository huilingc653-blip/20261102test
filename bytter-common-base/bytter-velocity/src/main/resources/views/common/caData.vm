##cfca js 方法
#macro(cfcaScript)
<script>
    //cfca script begin
    var CryptoAgent = "";
    var CryptoKit;
    var isChrome = false;
    function BrowserInfo() {
        var res = {
            name: "",
            version: "",
        };
        var reg;
        var userAgent = self.navigator.userAgent;

        if (reg = /edge\/([\d\.]+)/i.exec(userAgent)) {
            res.name = "Edge";
            res.version = reg[1];
        }
        else if (reg = /edg\/([\d\.]+)/i.exec(userAgent)) {
            res.name = "Edge(Chromium)";
            res.version = reg[1];
        }
        else if (/msie/i.test(userAgent)) {
            res.name = "Internet Explorer";
            res.version = /msie ([\d\.]+)/i.exec(userAgent)[1];
        }
        else if (/Trident/i.test(userAgent)) {
            res.name = "Internet Explorer";
            res.version = /rv:([\d\.]+)/i.exec(userAgent)[1];
        }
        else if (/chrome/i.test(userAgent)) {
            res.name = "Chrome";
            res.version = /chrome\/([\d\.]+)/i.exec(userAgent)[1];
        }
        else if (/safari/i.test(userAgent)) {
            res.name = "Safari";
            res.version = /version\/([\d\.]+)/i.exec(userAgent)[1];
        }
        else if (/firefox/i.test(userAgent)) {
            res.name = "Firefox";
            res.version = /firefox\/([\d\.]+)/i.exec(userAgent)[1];
        }
        return res;
    }
    // 如果有异常了，则全部关闭是否要提交的弹框 liuyj 20250410
    function ShowErrorInfo(response) {
        if(null == response){
            alert("Extension has been remove!");
            top.layer && top.layer.closeAll();
            bt.loading && bt.loading.hide();
        }
        else if(1 == response.errorcode) { // connection error
            alert(response.result);
            top.layer && top.layer.closeAll();
            bt.loading && bt.loading.hide();
        }
        else { // host error
            CryptoKit.getLastErrorDesc()
                    .then(function (response) {
                        // alert(response.result);
                        top.layer && top.layer.closeAll();
                        bt.loading && bt.loading.hide();
                    });
        }
    }
    //加载证书控件
    function OnLoad() {
        try {
            var browser = BrowserInfo();
            if (("Chrome" == browser.name && parseInt(browser.version) > 41) ||
                    ("Firefox" == browser.name && parseInt(browser.version) > 52)) {

                CryptoKit = new nmCryptokit(browser.name);
                CryptoKit.init()
                        .then(function () {
                            isChrome = true;
                        })
                        .catch(function (response) {

                            CryptoKit = new nmCryptokit("Edge(Chromium)");
                            CryptoKit.init()
                                    .then(function () {
                                        isChrome = true;
                                    })
                                    .catch(function (response) {
                                        alert(response.result);
                                        installExtension();
                                    });
                        });
            }else {
                var eDiv = document.createElement("div");
                //cfca sm2 by zhoul 国密加载不同的cab包 需要设置csp
                var cspList = document.getElementById("cspList").value;
                if(cspList){
                    if (navigator.appName.indexOf("Internet") >= 0 || navigator.appVersion.indexOf("Trident") >= 0) {
                        if (window.navigator.platform == "win32" || window.navigator.cpuClass == "x86") {
                            eDiv.innerHTML = "<object id=\"CryptoAgent\" codebase=\"${basePath}/static/cabs/CryptoKit.NEPTUNUS.x86.cab\" classid=\"clsid:11831B08-CF8D-40E5-9AC0-0EBE0AA894DE\" ></object>";
                        } else {
                            eDiv.innerHTML = "<object id=\"CryptoAgent\" codebase=\"${basePath}/static/cabs/CryptoKit.NEPTUNUS.x64.cab\" classid=\"clsid:CCF04070-B493-46FD-8F51-7C8B6E90BE73\" ></object>";
                        }
                    } else {
                        eDiv.innerHTML = "<embed id=\"CryptoAgent\" type=\"application/npCryptoKit.NEPTUNUS.x86\" style=\"height: 0px; width: 0px\">";
                    }
                } else {
                    if (navigator.appName.indexOf("Internet") >= 0 || navigator.appVersion.indexOf("Trident") >= 0) {
                        if (window.navigator.cpuClass == "x86") {
                            eDiv.innerHTML = "<object id=\"CryptoAgent\" codebase=\"${basePath}/static/cabs/CryptoKit.Ultimate.x86.cab\" classid=\"clsid:4C588282-7792-4E16-93CB-9744402E4E98\" ></object>";
                        } else {
                            eDiv.innerHTML = "<object id=\"CryptoAgent\" codebase=\"${basePath}/static/cabs/CryptoKit.Ultimate.x64.cab\" classid=\"clsid:B2F2D4D4-D808-43B3-B355-B671C0DE15D4\" ></object>";
                        }
                    } else {
                        eDiv.innerHTML = "<embed id=\"CryptoAgent\" src=\"${basePath}/static/cabs/npCryptoKit.Ultimate.x86.exe\" type=\"application/npCryptoKit.Ultimate.x86\" style=\"height: 0px; width: 0px\">";
                    }
                }
                document.body.appendChild(eDiv);
            }
        }
        catch (e) {
            alert(e);
            return;
        }
        CryptoAgent = document.getElementById("CryptoAgent");
    }

    function installExtension(){
        var browser = BrowserInfo();
        if ("Firefox" == browser.name) {
            document.getElementById("CryptoKitExtension").style.display = "block";
            document.getElementById("CryptoKitExtension").href = "https://www.ovfintech.com/CryptoKitExtension.NEPTUNUS.xpi";
        }
        else if ("Chrome" == browser.name) {
            alert("请联系管理员安装谷歌浏览器插件！");
        }
        else {
            alert("Unsupported browser!");
        }
    }

    function OnUnLoad() {
        try {
            CryptoKit.uninit().then(function () {
                EnableButton(false);
            });
        }
        catch (e) {
            alert(e);
            return;
        }
    }



    /**
     * 选择证书
     */
    function SelectCertificateOnClick(callback,sourceData,msg,caCodId,callback1) {
        try {
            var issuer = document.getElementById("issuer").value;
            var cadn = document.getElementById("cadn").value;
            if(isChrome){
                CryptoKit.selectCertificate("", issuer, cadn, "")
                        .then(function (response) {
                            document.getElementById("bSelectCertResult").value = response.result;
                            CryptoKit.getSignCertInfo("SerialNumber")
                                    .then(function (response) {
                                        document.getElementById("bSelectCertResult").value = response.result;
                                        CryptoKit.getSignCertInfo("SerialNumber")
                                                .then(function (response) {
                                                    InfoContent = response.result;
                                                    callback(sourceData,msg,caCodId,callback1);
                                                })
                                                .catch(function (response) {
                                                    ShowErrorInfo(response);
                                                    msg = "sys.ca.abnormal";
                                                    $("#isCFCACheck").val("sys.ca.abnormal");
                                                });
                                    })
                                    .catch(function (response) {
                                        ShowErrorInfo(response)
                                        msg = "sys.ca.abnormal";
                                        $("#isCFCACheck").val("sys.ca.abnormal");
                                    });
                        })
                        .catch(function (response) {
                            ShowErrorInfo(response)
                            msg = "sys.ca.abnormal";
                            $("#isCFCACheck").val("sys.ca.abnormal");
                        });
            }else {
                //cfca sm2 byzhoul 选择证书时 国密证书加上csp
                var cspList = document.getElementById("cspList").value;
                if(cspList){
                    bSelectCertResult = CryptoAgent.SelectCertificate("", issuer, cadn, cspList);
                }else{
                    bSelectCertResult = CryptoAgent.SelectCertificate("", issuer, cadn);
                }
                document.getElementById("bSelectCertResult").value = bSelectCertResult;
            }
        }
        catch (e) {
            var errorDesc = CryptoAgent.GetLastErrorDesc();
        }
    }

    /**
     *签名
     *sourceData 签名源
     */
    function SignOnClick(sourceData) {
        var signature = "";
        try {
            if(isChrome){
                CryptoKit.signMsgPKCS7(sourceData, "SHA-1", true)
                        .then(function (response) {
                            signature = response.result;
                        })
                        .catch(function (response) {
                            ShowErrorInfo(response);
                        });
            }else {
                signature = CryptoAgent.SignMsgPKCS7(sourceData, "SHA-1", true);
            }
        }
        catch (e) {
            var errorDesc = CryptoAgent.GetLastErrorDesc();
            alert(errorDesc);
        }
        return signature;
    }
    /**
     * 验签
     * signature 签名结果
     */
    function VerifyPKCS7OnClick(signature) {
        try {
            var bResult = false;
            if(isChrome){
                CryptoKit.verifyMsgSignaturePKCS7Attached(signature, "RSA")
                        .then(function (response) {
                            alert("验签结果：" + response.result);
                        })
                        .catch(function (response) {
                            ShowErrorInfo(response);
                        });
            }else {
                bResult = CryptoAgent.VerifyMsgSignaturePKCS7Attached(signature, "RSA");
                if (!bResult) {
                    var errorDesc = CryptoAgent.GetLastErrorDesc();
                    bResult = false;
                }
                //alert("验签结果：" + bResult);
                // Opera浏览器，NPAPI函数执行结果为false时，不能触发异常，需要自己判断返回值。
                if (!signature) {
                    var errMsg = "";
                    errMsg = CryptoAgent.GetLastErrorDesc();
                    return;
                }
            }
        } catch (e) {
            var errorDesc = CryptoAgent.GetLastErrorDesc();
            alert(errorDesc);
        }
        return bResult;
    }
    /**
     * 获取证书序列号
     * @returns {String}
     */
    function GetCertInfoOnClick() {
        try {
            var InfoTypeID = "SerialNumber";
            var InfoContent = "";
            if(isChrome){
                CryptoKit.getSignCertInfo(InfoTypeID)
                        .then(function (response) {
                            InfoContent = response.result;
                            alert(InfoContent+"获取序列号");
                            return InfoContent;
                        })
                        .catch(function (response) {
                            ShowErrorInfo(response);
                        });
            }else {
                InfoContent = CryptoAgent.GetSignCertInfo(InfoTypeID);
                // Opera浏览器，NPAPI函数执行结果为false时，不能触发异常，需要自己判断返回值。
                if (!InfoContent) {

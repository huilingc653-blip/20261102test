bt.userResource={};#foreach($resource in ${resources})bt.userResource["${resource.permission}"]=1;#end
#set($temp="")bt.userCorpResource={};#foreach($corpResource in $corpResources)#if($temp != ${corpResource.corpId})#set($temp = ${corpResource.corpId})bt.userCorpResource["${corpResource.corpId}"]={};#end bt.userCorpResource["${corpResource.corpId}"]["${corpResource.permission}"] = 1;#end
bt.isResource = function(code, corpId, index) {
    if (corpId || corpId == "") {
        if (bt.userCorpResource[corpId]) {
            if (bt.userCorpResource[corpId][code]==1) {
                return true;
            } else {
                if (index) {
                    layer.alert(bt.lang('common.message.dataResourceCheck', [index]), {
                        icon: 7
                    });
                }
                return false
            }
        } else {
            return false
        }
    } else {
        if (bt.userResource[code]==1) {
            return true
        } else {
            return false
        }
    }
};
bt.isnotResource = function(code, corpId, index) {
    return ! bt.isResource(code, corpId, index)
}


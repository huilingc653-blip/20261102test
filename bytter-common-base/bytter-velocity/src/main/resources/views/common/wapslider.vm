<style>
    aside {background: #E8E8E8 url(${basePath}/static/mui/images/slide_bg.png) no-repeat right bottom !important;background-size: 100% auto !important;-webkit-background-size: 100% auto !important;}
    aside .mui-icon{margin-right: 10px;}
    #leftslider .mui-table-view-chevron .mui-table-view-cell>a:not(.mui-btn).mui-active{background-color:#E8E8E8 !important;color:#666 !important;}
    #leftslider .mui-table-view-inverted .mui-table-view-cell.mui-active, .mui-table-view-inverted .mui-table-view-cell>a:not(.mui-btn).mui-active{background-color:#E8E8E8;}
    #leftslider .mui-table-view{background-color:#E8E8E8;}
    #leftslider .mui-table-view-header{background-color:#1874d0;}
    #leftslider .mui-table-view-cell>.mui-badge{top:23px;}
    #leftslider .mui-table-view-cell>a:not(.mui-btn).mui-active{background-color:#1874d0;}
</style>
<aside class="mui-off-canvas-left" id="leftslider">
    <ul class="mui-table-view mui-table-view-header">
        <li class="mui-table-view-cell mui-media">
            <a href="javascript:;">
                <img class="mui-media-object mui-pull-left" src="${basePath}/static/mui/images/user_grey.png">
                <div class="mui-media-body">
                    <span class="username H-theme-font-color-white"></span>
                    <p class='mui-ellipsis'></p>
                </div>
            </a>
        </li>
    </ul>
    <ul class="mui-table-view mui-table-view-chevron mui-table-view-inverted leftslider_meum">
        <li class="mui-table-view-cell mui-collapse">
            <a class="mui-navigate-right" href="#" tapmode=""><i class="mui-icon mui-icon-compose H-theme-font-color10"></i>审批</a>
            <span class="mui-badge mui-badge-danger mui-badge-min mui-hidden" id="todoPoint"></span>
            <ul class="mui-table-view mui-table-view-chevron">
                <li class="mui-table-view-cell index_a" data-index="0" data-url="${basePath}/m/bpm/list?type=todo" tapmode onclick="openMeum(this);">
                    <a class="mui-navigate-right index_a" href="#" tapmode="">待审批</a>
                    <span class="mui-badge mui-badge-danger mui-hidden" id="todoNumber">0</span>
                </li>
                <li class="mui-table-view-cell index_a" data-index="1" data-url="${basePath}/m/bpm/list?type=historic" tapmode onclick="openMeum(this);">
                    <a class="mui-navigate-right" href="#" tapmode="">流程跟踪</a>
                </li>
            </ul>
        </li>
        <li class="mui-table-view-cell index_a" data-index="2" data-url="${basePath}/m/user/msg_win" tapmode onclick="openMeum(this);">
            <a class="mui-navigate-right" href="#" tapmode=""><i class="mui-icon mui-icon-chatbubble H-theme-font-color10"></i>我的消息</a>
            <span class="mui-badge mui-badge-danger mui-hidden" id="messageNumber">0</span>
        </li>
        <li class="mui-table-view-cell" tapmode>
            <a class="mui-navigate-right" href="#" tapmode=""><i class="mui-icon mui-icon-extra mui-icon-extra-trend H-theme-font-color10" style="font-size: 2rem;"></i>报表统计</a>
        </li>
        <!--<li class="mui-table-view-cell" tapmode>
            <a class="mui-navigate-right" href="#" tapmode=""><i class="mui-icon mui-icon-locked"></i>安全设置</a>
        </li>-->
    </ul>
    <div class="logout-exit" id="logout" tapmode>
        <a><i class="mui-icon mui-icon-arrowthinright"></i>退出</a>
    </div>
    <div class="settings settingright" id="settings" tapmode>
        <a><i class="mui-icon mui-icon-gear"></i>设置</a>
    </div>
</aside>
<div class="mui-off-canvas-backdrop"></div>
<script>
    document.getElementById('logout') && document.getElementById('logout').addEventListener('tap', function(event) {
        if(H.isAPICloud()){
            H.closeSlidPane();
            H.execScript("index_m","","logout()");
        }else{
            mui('#mui-inner-wrap').offCanvas().close();
            mui.confirm('确认退出当前账号吗？',' ',['否', '是'],function(e) {
                if (e.index == 1) {
                    H.rmStorage("bytterToken");
                    H.get(function(){},basePath+"/logout");
                    setTimeout(function () {
                        H.closeToWin("index_m",basePath+"/m/user/login");
                    },100);
                }
            });
        }
    });
    document.getElementById('settings') && document.getElementById('settings').addEventListener('tap', function(event) {
        if(H.isAPICloud()){
            H.closeSlidPane();
        }else{
            mui('#mui-inner-wrap').offCanvas().close();
        }
        H.openWin("set_win",basePath+"/m/bpm/set_win",{});
    });
    function changeBageTodo(num) {
        if(num){
            var tip = "0";
            if(num>99){
                tip = "99+";
            }else{
                tip = num;
            }
            $("#todoNumber").html(tip),$("#todoNumber").removeClass("mui-hidden");
            $("#todoPoint").removeClass("mui-hidden");
        }else{
            $("#todoPoint").addClass("mui-hidden");
            $("#todoNumber").addClass("mui-hidden"),$("#todoNumber").html("0");
        }
    }
    function changeBageMessage(num) {
        if(num){
            var tip = "0";
            if(num>99){
                tip = "99+";
            }else{
                tip = num;
            }
            $("#messageNumber").html(tip),$("#messageNumber").removeClass("mui-hidden");
        }else{
            $("#messageNumber").addClass("mui-hidden"),$("#messageNumber").html("0");
        }
    }
    function openMeum(el) {
        if(H){
            var index = $(el).data("index"),url = $(el).data("url");
            if(index==2){
                H.openWin("msg_win",url,{});
            }else{
                H.execScript("index_m","","setPage('"+index+"','"+url+"')");
                H.closeSlidPane();
            }
        }
    }
</script>
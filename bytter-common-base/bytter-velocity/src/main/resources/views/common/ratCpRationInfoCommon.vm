<tr id="cpRatItemCodeDiv">
##授信品种
##    <input type="hidden" id="cpRatCode1"  name="cpRatCode1" value="$!{cpURationDTO.ratCode}"/>
##    $!{cpURationDTO.ratCode}
    <td class="textRight" id="cpRatItemCode_verify">#springMessage('table.cmsProvideLoanInfo.itemCode')</td>
    <td >
        <input type="hidden" id="cpRatItemCode" value="$!{cpURationDTO.ratItemCode}">
        <div class="layui-inline">
            <div class="bt-biz-selectType" id="cpRatItemCode_select" #if($!{relateRat} == "1") data-required="true" #end
                 data-biz-name="cpRatItemCode" data-url="${basePath}/cms/rat/ratitemcustom/getAllRatItem?type=1"
                 data-valuefield="id" data-textfield="name" data-name="cpRatItemCode" data-search="true" data-value="$!{cpURationDTO.ratItemCode}" data-callback="setCpRationBtn">
            </div>
        </div>
    </td>
##授信额度单
    <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rationSelect')</td>
    <td colspan="3">
    ##浏览按钮
        <div class="layui-input-inline">
            <div  id="ratChooseBtn" >
                <button type="button" onclick="chooseCpRatCode()" class="layui-btn">#springMessage('common.button.browse')</button>
            </div>
        </div>
        ##查看按钮
        <div class="layui-input-inline">
            <div style="display: none" id="cpRationBtn">
                <button type="button" onclick="viewCpRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
            </div>
        </div>
    ##额度编号
    ##占用授信代码
        <span id="cpItemCodeTd">
            <input type="hidden" id="cpRatCode"  name="cpRatCode" value="$!{cpURationDTO.ratCode}"/>
            <input type="hidden" id="cpRatCode1"  name="cpRatCode1" value="$!{cpURationDTO.ratCode}"/>
						<input type="hidden" id="cpItemFlag" name="cpItemFlag" value="$!{cpURationDTO.itemFlag}"/>
						<input type="hidden" id="cpItemMoney" name="cpItemMoney" value="$!{cpURationDTO.money}"/>
						<input type="hidden"  id="cpUrationId" name="cpUrationId" value="$!{cpURationDTO.urationId}"/>
        </span>
    </td>
</tr>

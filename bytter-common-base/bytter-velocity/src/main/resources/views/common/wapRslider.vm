<script id="cate_list_tpl" type="text/html">
    {{# for(var i = 0, len = d.list.length; i < len; i++){ }}
    <li class="clearfix" data-index="category_{{i}}">
        <span class="icon-expand-more"><i class="mui-icon mui-icon-arrowright"></i></span>
        <div class="floatleft">
            <p class="">{{ d.list[i].name }}</p>
        </div>
    </li>
    {{# } }}
</script>
<script id="cate_list_c_tpl" type="text/html">
    {{# for(var i = 0, len = d.list.length; i < len; i++){ }}

    {{# for(var x = 0, a = d.list[i].children.length; x < a; x++){ }}
    {{# for(var y = 0, b = d.counts.length; y < b; y++){ }}
    {{# if(d.list[i].children[x].key==d.counts[y].key){  }}
    <li class="clearfix category category_{{i}} {{# if(d.counts[y].key==d.ckey ){ }}choosed{{# } }}" data-index="{{i}}" data-categoryid="{{d.list[i].children[x].id}}" data-key="{{d.counts[y].key}}">
        <span class="radio_ico"><i class="H-iconfont H-icon-right"></i></span>
        <div class="floatleft">
            <p class="">{{ d.list[i].children[x].name }}({{ d.counts[y].num }})</p>
        </div>
    </li>
    {{# } }}
    {{# } }}
    {{# } }}
    {{# } }}
</script>
<script>
    document.getElementById('closeSide') && document.getElementById('closeSide').addEventListener('tap', function() {
        if(H.isAPICloud()){
            H.closeFrame("appRslider");
        }else{
            parent.mui('#rightslider').offCanvas('toggle');
            if(parent.$("#rightslider").hasClass("mui-active")){
                parent.$("#rightslider").removeClass("mui-active");
            }
            parent.$("#rightslider").hide();
            parent.$("#leftslider").show();
        }
    });
    document.getElementById('backSide') && document.getElementById('backSide').addEventListener('tap', function() {
        $("#closeSide").show();
        $("#backSide").hide();
        $("#typeDIV_index").show();
        $("#itemDIV_index").hide();
    });
</script>
        function getSubData() {
            var params = {};
            params.corpId = $("#corpId").val();
            params.netId = $("#netId").val();
            /*params.netId = "402880425b8abcfb015b8ac16e980000";
            params.corpId = "402880425b8abcfb015b8ac16e980000";*/
            var dateTypeTemp = $("#dateTypeStr").val();
            if (isEmpty(dateTypeTemp)) {
                params.dateType = "day"
            }else{
                params.dateType = dateTypeTemp;
            }
            var curTemp = $("#curId").val();
            if(isEmpty(curTemp)){
                params.curId = "$!{natualId}"
            }else{
                params.curId = curTemp;
            }
            params.stockType = $("#stockTypeStr").val();
            params.reducedCurId = $("#reducedCurIdStr").val();
            params.reportType = reportType;
            params.beginDate = $("#beginDate").data("begin");
            params.endDate =  $("#endDate").data("end");
            return params;
        }


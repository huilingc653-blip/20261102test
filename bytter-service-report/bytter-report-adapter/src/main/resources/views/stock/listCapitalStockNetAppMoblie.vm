            function updateValue($this) {
                var value = $this.data('value');
                if ($this.hasClass(ACTIVE)) { //如果当前被选中时，点击会取消选中 删除值
                    $this.removeClass(ACTIVE);
                    if ("#indexCard" == id) { //多选
                        var hiddenValue = hiddenInput.val();
                        var valueArr = hiddenValue.split(',');
                        for(var i = 0; i < valueArr.length; i++) {
                            if(valueArr[i] == value) {
                                valueArr.splice(i,1);
                                break
                            }
                        }
                        value = valueArr.join(',');
                        hiddenInput.val(value);
                    }else { //单选
                        value = '';
                        hiddenInput.val(value);
                    }
                } else { //添加值
                    if ("#indexCard" == id) { //多选
                        var hiddenValue = hiddenInput.val();
                        if (!isEmpty(hiddenValue)) {
                            hiddenInput.val(hiddenInput.val() + "," + value);
                        } else {
                            hiddenInput.val(value);
                        }
                    }else { //单选
                        $card.find('.bt-card-item').removeClass(ACTIVE);
                        hiddenInput.val(value);
                    }
                    $this.addClass(ACTIVE);
                }
                return value;
            }
        }


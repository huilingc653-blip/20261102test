                                bal: data[i].inAmt
                            }))
                        }else if("3" == btnVal){
                            dataArr.push(Object.assign({},{
                                name: '减少',
                                bal: data[i].outAmt
                            }))
                        }else if("4" == btnVal) {
                            dataArr.push(Object.assign({},{
                                name: '期末',
                                bal: data[i].endBal
                            }))
                        }else if("5" == btnVal) {
                            dataArr.push(Object.assign({},{
                                name: '不可用',
                                bal: data[i].freezeMoney
                            }))
                        }else if("6" == btnVal) {
                            dataArr.push(Object.assign({},{
                                name: '可用',
                                bal: data[i].availBal
                            }))
                        }else{
                            dataArr = [];
                        }
                    }
                }else{
                    dataArr = [{
                        name: '期初',
                        bal: data[i].beginBal
                    }, {
                        name: '增加',
                        bal: data[i].inAmt
                    }, {
                        name: '减少',
                        bal: data[i].outAmt
                    }, {
                        name: '期末',
                        bal: data[i].endBal
                    }, {
                        name: '不可用',
                        bal: data[i].freezeMoney
                    }, {
                        name: '可用',
                        bal: data[i].availBal
                    }];
                }
                var bid = 'barChart' + data[i].netId + data[i].stockType;
                //图表对象
                var chart = new F2.Chart({
                    id: bid,
                    pixelRatio: window.devicePixelRatio // 指定分辨率
                });
                //图表写入
                chart.source(dataArr, {
                    bal: {
                        tickCount: 5,
                        formatter: function formatter(ivalue) {
                            if(!isEmpty(unitTemp) && "2" == unitTemp){
                                return bt.money.format(bt.money.toMillion(ivalue));
                            }else{
                                return bt.money.format(ivalue);
                            }
                        }
                    }
                });
                chart.tooltip({
                    showItemMarker: false,
                    onShow: function onShow(ev) {
                        var items = ev.items;
                        items[0].name = null;
                        items[0].name = items[0].title;
                        // items[0].value = '¥ ' + items[0].value;
                        items[0].value = items[0].value;
                    }
                });
                chart.interval()
                        .position('name*bal')
                        .size(8)　//设置柱状大小
                .adjust({
                        type: 'dodge',
                        marginRatio: 0.5 // 设置分组间柱子的间距
                    })
                    .style('type', {
                        radius: function radius() {　//设置柱状图圆角
                            return [3, 3, 3, 3]
                        }
                    })
                chart.render();
            }
        }

        /**判断字符串是否为空*/
        function isEmpty(ms) {
            if (typeof (ms) == "undefined" || ms == null || ms == "" || ms == " ") {
                return true;
            }
            return false;
        }

    })(document, window);
</script>
</html>

                    <div class="bt-popup-bottom">
                        <button type="button" id="clearValue4" class="bt-popup-reset resetBtn">重置</button>
                        <button type="button" id="submitValue4" class="bt-popup-submit submitBtn">确定</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

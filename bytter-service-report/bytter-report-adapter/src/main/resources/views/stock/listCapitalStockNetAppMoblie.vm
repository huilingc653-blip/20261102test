<script>
    var typeToDate = ${typeToDate};
    window.getListNetMoblie = (data)=>{
        console.log('data'+ data)
        postData(data)
    }

    window.getListNetMoblieSearchActionCallback = (data)=>{
        console.log('data'+ data)
        // seachType = "seach"
        searchActionCallback(data)
    }
    (function (doc, win) {
        var reportType = $("#reportType").val();
        F2.track(false);

        initBal();
        //初始化日期
        $("#beginDate").html($("#newDate").val());
        $("#endDate").html($("#newDate").val());
        $("#beginDate").attr("data-begin",$("#newDate").val());
        $("#endDate").attr("data-end",$("#newDate").val());

        //初始化列表数据
        function initBal() {
            $("#showDate").html(typeToDate["day"]);
            //通过Ajax获取数据
            setTimeout(function () {
               var data = BTAppBridge.post("/bi/capitalStock/getInfoList", getSubData(),'postData');
               uni.postMessage({
                   data:data
               })
            },100);
            /*$.ajax({
                type: "get",
                url: basePath + "/bi/capitalStock/getInfoList1",
                async: true,
                data: getSubData(),
                dataType: "json",
                success: function (res) {
                    createDataTable(res);
                },
                error: function (jqXHQ) {
                    alert("发生错误:" + jqXHQ.status);
                }
            });*/
        }
        //初始化生成表格
        postData = function (res) {
            createDataTable(res,"");
        }

        function addSheet($this, id) {
            if ( $this.parent().hasClass('active')) {
                hideSheet($this);
                return
            }
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
            $this.parent().addClass('active');
            $(id).addClass('show');
        }

        //弹框选择
        function hideSheet($this) {
            $('.ui-actionsheet').removeClass('show');
                $this.parent().removeClass('active');
        }

        //日期控制
        $("#btn1").click(function () {
            addSheet($(this), '#actionsheet1')
        });
        //存量种类控制
        $("#btn2").click(function () {
            addSheet($(this), '#actionsheet2')
        });
        //币别控制
        $("#btn3").click(function () {
            addSheet($(this), '#actionsheet3')
        });
        //指标筛选控制
        $("#btn4").click(function () {
            addSheet($(this), '#actionsheet4')
        });
        //时间选择
        $('.date').on('click', function () {
            openDatePickerPage();
        });
        //时间组件
        function openDatePickerPage() {
           var data = BTAppBridge.openDatePickerPage && BTAppBridge.openDatePickerPage('searchActionCallback');
            uni.postMessage({
                data:data
            })
        }
        /**
         * 搜索回调方法
         * @param data
         */
        window.searchActionCallback = function (data) {
            if (data.datePickData) {
                var dateObj = data.datePickData;
                var startDate = dateObj.startDate;
                var endDate = dateObj.endDate;
                var startTemp = bt.date.format(parseInt(startDate), "yyyy-MM-dd");
                var endTemp = bt.date.format(parseInt(endDate), "yyyy-MM-dd");
                $("#beginDate").html(startTemp);
                $("#endDate").html(endTemp);
                $("#beginDate").attr("data-begin",startTemp);
                $("#endDate").attr("data-end",endTemp);
                addSheet($(this), '#actionsheet1')
            }
        }


        var ACTIVE = 'active';

        function initCard(id, value, clickCallback, isNotInit) {
            if (!id) {
                return
            }
            var $card =
            $(id);
            var hiddenInput = $card.find('.bt-card-header input');
            var items = $card.find('.bt-card-item');
            items.removeClass(ACTIVE);
            hiddenInput.val("");
            //设置选中值
            if (value) {
                for (var i = 0; i < items.length; i++) {
                    if (value === $(items[i]).data('value')) {
                        $(items[i]).addClass(ACTIVE);
                        if ("#indexCard" != id) {
                            hiddenInput.val(value);
                        } else {
                            var hiddenValue = hiddenInput.val();
                            if (!isEmpty(hiddenValue)) {
                                hiddenInput.val(hiddenInput.val() + "," + value);
                            } else {
                                hiddenInput.val(value);
                            }
                        }
                        break;
                    }
                }
            }
            if (isNotInit) {
                return;
            }

            $(id).on('click', '.bt-card-item', function () {
                var value = updateValue($(this));
                if(value =="day" || value=="week" || value=="month" || value == "season" || value == "year"){
                    setTimeout(function () {
                       var data = BTAppBridge.post("/bi/capitalStock/getDate", {dateType: value},'setDate');
                        uni.postMessage({
                            data:data
                        })
                    },100);
                }
                ## if ($(this).hasClass(ACTIVE)) { //如果当前被选中时，点击会取消选中
                ##
                ##     $(this).removeClass(ACTIVE);
                ## } else {
                ##     if ("#indexCard" != id) {
                ##         $card.find('.bt-card-item').removeClass(ACTIVE);
                ##     }
                ##     $(this).addClass(ACTIVE);
                ##     value = $(this).data('value');
                ## }
                ## if ("#indexCard" != id) {
                ##     hiddenInput.val(value);
                ## }else {
                ##     var hiddenValue = hiddenInput.val();
                ##     if (!isEmpty(hiddenValue)) {
                ##         hiddenInput.val(hiddenInput.val() + "," + value);

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="reportType" name="reportType" value="$!{reportType}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.btwarnstrategy.netName')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/bi/capitalStock/json" data-valuefield="id"
                         data-textfield="name"
                         data-name="netId" data-biz-name="netId" data-search="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.capitalStock.dateType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="capitalStock.dateType" data-defaultvalue="day"
                     data-name="dateType" data-biz-name="dateType" data-selecttext="false" data-callback="checkDate"></div>
            </td>
            <td class="textRight">#springMessage('netbanck.reporter.checktime')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="beginDate" data-type="date" data-biz-name="beginDate" lay-verify="required"
                           class="layui-input bt-biz-dateType" data-endid="endDate" data-today="true">
                </div>
                <div class="layui-inline">~</div>
                <div class="layui-inline">
                    <input type="text" name="endDate" data-type="date" data-biz-name="endDate" lay-verify="required"
                           class="layui-input bt-biz-dateType" id="led_queryDate" data-today="true">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.capitalStock.stockTypeName')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="capitalStock.stockType"
                     data-name="stockType" data-biz-name="stockType"></div>
            </td>
            <td class="textRight">#springMessage('table.capitalStock.moneyUnit')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="capitalStock.moneyUnit" data-defaultvalue="yuan"
                     data-name="moneyUnit" data-biz-name="moneyUnit" data-selecttext="false"></div>
            </td>
            <td class="textRight">#springMessage('table.capitalStock.curName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-defaultvalue="$!{curId}" data-callback="curCallBack"
                     data-name="curId" data-valueField="id"  data-textField="curName" data-biz-name="curId" data-selecttext="false" ></div>
            </td>
        </tr>
        <tr>
            ##折合币种
            <td class="textRight">#springMessage("commom.converted.into.currency")</td>
            <td>
                <div class="bt-biz-selectType"
                     data-biz-name="reducedCurId"
                     data-url="${basePath}/basic/business/btcurrency/json"
                     data-valuefield="id"
                     data-textfield="curName"
                     data-name="reducedCurId"
                     data-search="true"
                     data-callback="checkConvertCurCallBack"
                     data-defaultvalue="$!{reducedCurId}"
                ></div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button type="button" class="layui-btn" lay-submit lay-filter="search">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <td class="textRight">#springMessage('table.capitalStock.curName')</td>
        <td id="curNameText" class="textLeft" colspan="2"></td>
        <td class="textRight">#springMessage('table.capitalStock.dateType')</td>
        <td id="dateText" class="textLeft" colspan="2"></td>
        <td class="textRight">#springMessage('table.capitalStock.moneyUnit')</td>
        <td class="textLeft"><span id="moneyUnitText"></span></td>
    </tr>
    <tr>
        <th>#springMessage('table.capitalStock.netName')</th>
        <th>#springMessage('table.capitalStock.stockTypeName')</th>
        <th>#springMessage('table.capitalStock.beginBal')</th>
        <th>#springMessage('table.capitalStock.inAmt')</th>
        <th>#springMessage('table.capitalStock.outAmt')</th>
        <th>#springMessage('table.capitalStock.endBal')</th>
        <th>#springMessage('table.capitalStock.freezeMoney')</th>
        <th>#springMessage('table.capitalStock.availBal')</th>
    </tr>
    </thead>
</table>
<br/>
<br/>
<br/>
<table class="layui-form" style="width:100%;display: none;">
    <tr align="center">
        <td><div id="netChart" style="width:400px;height:400px;"></div></td>
        <td><div id="chart" style="width:400px;height:400px;"></div></td>
    </tr>
</table>
    #parse("views/common/footer.vm")
</body>
<script>
    var typeToDate = ${typeToDate};
</script>
<script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
##<script src="${basePath}/static/modules/bi/capitalStockNet.report.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bi/capitalStockNet.list.js?_btv=${resourceVersion}"></script>
</html>
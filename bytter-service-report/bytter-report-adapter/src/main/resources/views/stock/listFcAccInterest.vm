<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReport.corpName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-name="ins_corpId" data-biz-type="corp" data-type="selectTree"
                         data-tree-type="check"
                         data-checkkboxtype='{"Y":"s","N":"s"}'
                         data-resource="netbank:report:fcAccInterest:query"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReport.curName')</td>
            <td class="rCode">
            ##		 <div class="layui-input-inline">
                <div class="layui-form-item">
                    <div class="layui-inline">
                        <div class="selectDemo bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrency/json"
                             data-name="ins_curId" data-valueField="id" data-textField="curName" data-method="get"></div>
                    </div>
                </div>
            </td>
            <td class="textRight">#springMessage("netbanck.reporter.checktime")</td>
            <td >
                <input type="text" name="beginDate" data-name="beginDate" class="layui-input bt-input-inline bt-biz-dateType"  lay-verify="required"
                       data-endid="endDate" data-biz-name="beginDate" value="${monthFirstDay}">
                <span class="date-mid">~</span>
                <input type="text" name="endDate" data-name="endDate" class="layui-input bt-input-inline bt-biz-dateType" lay-verify="required" data-today="true"
                       id="endDate" data-biz-name="endDate">
            </td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button type="button" class="layui-btn" lay-submit lay-filter="search">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th rowspan="2" >#springMessage('bill.accebill.abBillDiscountApply.discountNet')</th>
        <th rowspan="2" >#springMessage('table.fcloanrepay.corpName')</th>
        <th rowspan="2" >#springMessage('table.fbsBudgetProcess.curCode')</th>
        <th colspan="2" style="border-bottom:1px solid #d2d2d2;">#springMessage('table.fcacc.accType01')</th>##企业活期存款
        <th colspan="2" style="border-bottom:1px solid #d2d2d2;">#springMessage('table.fcacc.accType05')</th>##企业定期
        <th colspan="2" style="border-bottom:1px solid #d2d2d2;">#springMessage('table.fcacc.accType08')</th>##企业通知
        <th colspan="2" style="border-bottom:1px solid #d2d2d2;">#springMessage('table.fcacc.accType03')</th>##企业放款
        <th colspan="2" style="border-bottom:1px solid #d2d2d2;">#springMessage('table.fcacc.accType02')</th>##银行活期存款
        <th colspan="2" style="border-bottom:1px solid #d2d2d2;">#springMessage('table.fcacc.accType04')</th>##银行借款

    </tr>
    <tr>
        <th>#springMessage('table.cms.loan.interest.payable')</th>##应付利息
        <th>#springMessage('table.cmsProvideLoanRepay.onlineInterest')</th>##实付利息

        <th>#springMessage('table.cms.loan.interest.payable')</th>##应付利息
        <th>#springMessage('table.cmsProvideLoanRepay.onlineInterest')</th>##实付利息

        <th>#springMessage('table.cms.loan.interest.payable')</th>##应付利息
        <th>#springMessage('table.cmsProvideLoanRepay.onlineInterest')</th>##实付利息

        <th>#springMessage('table.choProductQuery.receivableMoney')</th>##应收利息
        <th>#springMessage('table.choBankFinance.blInterest')</th>##实收利息

        <th>#springMessage('table.choProductQuery.receivableMoney')</th>##应收利息
        <th>#springMessage('table.choBankFinance.blInterest')</th>##实收利息

        <th>#springMessage('table.choProductQuery.receivableMoney')</th>##应收利息
        <th>#springMessage('table.choBankFinance.blInterest')</th>##实收利息
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bi/listFcAccInterest.list.js?_btv=${resourceVersion}"></script>
</html>

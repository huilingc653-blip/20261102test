<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="reportType" name="reportType" value="$!{reportType}">
    <input type="hidden" id="bankTypeId" name="bankTypeId" value="$!{bankTypeId}">
    <input type="hidden" id="dateType" name="dateType" value="$!{dateType}">
    <input type="hidden" id="stockType" name="stockType" value="$!{stockType}">
    <input type="hidden" id="corpId" name="corpId" value="$!{corpId}">
    <input type="hidden" id="reducedCurId" name="reducedCurId" value="$!{reducedCurId}">
    <input type="hidden" id="beginDate" name="beginDate" value="$!{beginDate}">
    <input type="hidden" id="endDate" name="endDate" value="$!{endDate}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.capitalStock.moneyUnit')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="capitalStock.moneyUnit" data-defaultvalue="$!{moneyUnit}"
                     data-name="moneyUnit" data-biz-name="moneyUnit" data-selecttext="false"></div>
            </td>
            <td class="textRight">#springMessage('table.capitalStock.curName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-defaultvalue="$!{curId}"
                     data-name="curId" data-valueField="id"  data-textField="curName" data-biz-name="curId" data-selecttext="false" data-displayData="$!{curId}"></div>
            </td>
            ##折合币种
            <td class="textRight">#springMessage("commom.converted.into.currency")</td>
            <td>
                <div class="bt-biz-selectType"
                     data-biz-name="reducedCurId"
                     data-url="${basePath}/basic/business/btcurrency/json"
                     data-valuefield="id"
                     data-textfield="curName"
                     data-name="reducedCurName"
                     data-search="true"
                     data-callback="checkConvertCurCallBack"
                     data-defaultvalue="$!{reducedCurId}"
                ></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button type="button" class="layui-btn" lay-submit lay-filter="search">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('bill.accebill.corpId')</th>
        <th>#springMessage('bill.accebill.origNo')</th>
        <th>#springMessage('bill.accebill.bustype')</th>
        <th>#springMessage('table.abVoucherinfoVice.billSource')</th>
        <th>#springMessage('table.abVoucherinfo.billFlag')</th>
        <th>#springMessage('table.abVoucherinfo.billType')</th>
        <th>#springMessage('table.abAccrecords.businessDate')</th>
        <th>#springMessage('bill.accebill.billMoney')</th>
        <th>#springMessage('bill.accebill.applyName')</th>
        <th>#springMessage('bill.accebill.applyDate')</th>
        <th>#springMessage('table.abVoucherinfo.startDate')</th>
        <th>#springMessage('table.abVoucherinfo.endDate')</th>
        <th>#springMessage('table.abDiscount.interestRates')</th>
        <th>#springMessage('table.abDiscount.interest')</th>
        <th>#springMessage('bill.accebill.cnAccrecords')</th>
        <th>#springMessage('bill.accebill.rearAccrecords')</th>
        <th>#springMessage('bill.accebill.theBankAcc')</th>
        <th>#springMessage('bill.accebill.busStatus')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bi/capitalStockAbBillDtl.list.js?_btv=${resourceVersion}"></script>
</html>

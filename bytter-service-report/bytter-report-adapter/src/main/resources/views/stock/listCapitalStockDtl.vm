<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="reportType" name="reportType" value="$!{reportType}">
    <input type="hidden" id="bankTypeId" name="bankTypeId" value="$!{bankTypeId}">
    <input type="hidden" id="dateType" name="dateType" value="$!{dateType}">
    <input type="hidden" id="stockType" name="stockType" value="$!{stockType}">
    <input type="hidden" id="corpId" name="corpId" value="$!{corpId}">
    <input type="hidden" id="curId" name="curId" value="$!{curId}">
    <input type="hidden" id="reducedCurId" name="reducedCurId" value="$!{reducedCurId}">
    <input type="hidden" id="beginDate" name="beginDate" value="$!{beginDate}">
    <input type="hidden" id="endDate" name="endDate" value="$!{endDate}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.capitalStock.moneyUnit')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="capitalStock.moneyUnit" data-defaultvalue="$!{moneyUnit}"
                     data-name="moneyUnit" data-biz-name="moneyUnit" data-selecttext="false"></div>
            </td>
            <td class="textRight">#springMessage('table.capitalStock.curName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name="curName" data-valueField="id" data-textField="curName" data-biz-name="curId"
                     data-defaultvalue="$!{curId}" data-selecttext="false" data-displayData="$!{curId}"></div>
            </td>
        </tr>
        <tr>
            ##折合币种
            <td class="textRight">#springMessage("commom.converted.into.currency")</td>
            <td>
                <div class="bt-biz-selectType"
                     data-biz-name="reducedCurId"
                     data-url="${basePath}/basic/business/btcurrency/json"
                     data-valuefield="id"
                     data-textfield="curName"
                     data-name="reducedCurName"
                     data-search="true"
                     data-callback="checkConvertCurCallBack"
                     data-defaultvalue="$!{reducedCurId}"
                ></div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="4" class="center">
                <button type="button" class="layui-btn" lay-submit lay-filter="search">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btBankAccDtl.transTime')</th>
        <th>#springMessage('table.btBankAccDtl.corp')</th>
        <th>#springMessage('table.btBankAccDtl.bankTypeName')</th>
        <th>#springMessage('table.btBankAccDtl.curName')</th>
        <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
        <th>#springMessage('table.btBankAccDtl.accName')</th>
        <th>#springMessage('table.btBankAccDtl.bankName')</th>
        <th>#springMessage('table.btBankAccDtl.amt')</th>
        <th>#springMessage('table.btBankAccDtl.bal')</th>
        <th>#springMessage('table.btBankAccDtl.cdSign')</th>
        <th>#springMessage('table.btBankAccDtl.rbSign')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccBank')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bi/capitalStockDtl.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table layui-table-border">
        <tr>
            ##报表日期
            <td width="10%" class="textRight">报表日期</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="reportDate" class="layui-input bt-biz-dateType" data-type="date"
                           data-biz-name="reportDate" style="width: 100%;display: inline-block" value="${reportDate}"
                           lay-verify="required">
                </div>
            </td>
        </tr>
        <tr>
            ##单位
            <td class="textRight">#springMessage('table.report.corpId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-biz-type="corp" data-type="selectTree"
                         data-resource="cms:report:amount:query"
                         data-tree-type="check" data-checkkboxtype='{"Y":"s","N":"s"}'
                         data-name="corpId" data-scope="all" data-biz-name="corpId"
                         data-defaultvalue="$!{corpId}"></div>
                </div>
            </td>
            ##银行类别
            <td class="textRight">#springMessage('table.btBankAcc.bankTypeId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-name="bankTypeId"
                         data-url="${basePath}/basic/business/btbanktype/json" data-biz-name="bankTypeId"
                         data-valuefield="id" data-textfield="typeName" data-value="$!{bankTypeId}"
                         data-method="get"></div>
                </div>
            </td>
            <td class="textRight">#springMessage("table.ratBkration.ratMode")</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="RatBkration.RatMode"
                         data-value="$!{ratMode}"
                         data-name="ratMode" data-biz-name="ratMode">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##币别
            <td class="textRight">
                #springMessage('table.fcBusinessRuleDefine.curCode')
            </td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-biz-name="curCode"
                         data-url="${basePath}/basic/business/btcurrency/json"
                         data-valuefield="id" data-textfield="curName" data-name="curCode"
                         data-value="$!{curCode}"></div>
                </div>
            </td>
            ##金额单位
            <td class="textRight">#springMessage('common.moneyType')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="common.MoneyType" data-defaultvalue="1"
                         data-required="true"
                         data-name="moneyType" data-biz-name="moneyType" data-value="$!{moneyType}"
                         data-selecttext="false" data-displayData="1,10000">
                    </div>
                </div>
            </td>
            <td class="textRight">#springMessage("common.table.status")</td>
            <td class="status">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="ration.billStatus"
                         data-name="status" data-biz-name="status" data-value="$!{status}">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.ratBkration.begindate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="beginDate" class="layui-input bt-biz-dateType"
                           id="beginDate"
                           data-endid="endDate" value="$!{beginDate}"
                           data-type="date" data-biz-name="beginDate">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input type="text" name="endDate" class="layui-input bt-biz-dateType" id="endDate"
                           data-type="date" data-biz-name="endDate" value="$!{endDate}">
                </div>
            </td>
            <td class="textRight">#springMessage('table.ratBkration.enddate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="beginDate2" class="layui-input bt-biz-dateType"
                           data-endid="endDate2"
                           id="beginDate2"
                           data-type="date" data-biz-name="beginDate2" value="$!{beginDate2}">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input type="text" name="endDate2" class="layui-input bt-biz-dateType" id="endDate2"
                           data-type="date" data-biz-name="endDate2" value="$!{endDate2}">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="button" class="layui-btn layui-btn-primary" onClick="amountStaticsReset()">#springMessage(
                    'common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<div>
    <div class="dt-buttonst" style="display: inline-block;width: 60%;margin-top: 10px">
        <button type="button" class="layui-btn" lay-submit="" lay-filter="excel">#springMessage(
            'common.button.exports')</button>
        <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage(
            'common.button.print')</button>
    </div>
    <table width="30%" id="search" style="float: right; margin: 10px 0">
        <tr>
            <td align="right">#springMessage('table.cmsRatInfo.reportDate')：</td>
            <td align="left">$!{reportDate}</td>
            <td align="right">#springMessage("common.moneyType")：</td>
            <td align="left">$dictTag.get('common.MoneyType',$!{moneyType})</td>
            <td align="right">#springMessage('table.cmsRatInfo.TabPerson')：</td>
            <td align="left">$!{userName}</td>
        </tr>
    </table>
</div>
<div id="print" style="width:100%;height: 500px;overflow:auto;padding: 0">
    <table id="appTable" class="layui-table layui-form" style="width:100%; margin-top: 0;">
        <thead>
        <tr>
            <th width="15%">#springMessage("table.ratBkration.corpId")</th>
            <th width="15%">#springMessage("table.ratBkration.bankName")</th>
            <th width="8%">#springMessage("table.ratBkration.ratMode")</th>
            <th width="8%">#springMessage("table.ratBkrationDis.distributeWay")</th>
            <th width="8%">#springMessage("table.ratBkration.begindate")</th>
            <th width="8%">#springMessage("table.ratBkration.enddate")</th>
            <th width="8%">#springMessage("table.ratBkration.curName")</th>
            <th width="10%">#springMessage("table.ratBkration.money")</th>
            <th width="10%">#springMessage('table.ratBkrationDisDetail.superProcessMoney')</th>
            <th width="10%">#springMessage('table.ratBkrationDisDetail.checkProcessMoney')</th>
            <th width="10%">#springMessage('table.ratBkrationDisDetail.overPlusMoney')</th>
            <th width="10%">#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>
            <th width="10%">#springMessage('common.table.status')</th>
        </tr>
        </thead>
        <tbody>
            #if($list)
                #foreach($ratBean in $!{list})
                <tr>
                    #if($!{ratBean.flagSign} == "total")
                        <td align="right" colspan="7">$!{ratBean.corpName}</td>
                        ##授信总额
                        <td align="center">$number.formatNumeric($!{ratBean.money})</td>
                        <td align="right">$number.formatNumeric($!{ratBean.useMoney})</td>
                        <td align="right">$number.formatNumeric($!{ratBean.approveMoney})</td>
                    #else
                        <td align="center">$!{ratBean.corpName}</td>
                        <td align="center">$!{ratBean.bankName}</td>
                        <td align="center">$!{ratBean.ratModeName}</td>
                        <td align="center">$!{ratBean.disWayName}</td>
                        <td align="center">$!date.format('yyyy-MM-dd',$!{ratBean.beginDate})</td>
                        <td align="center">$!date.format('yyyy-MM-dd',$!{ratBean.endDate})</td>
                        <td align="center">$!{ratBean.curName}</td>
                        ##授信总额
                        <td align="center">$!number.formatNumeric($!{ratBean.money})</td>
                        <td align="right">$number.formatNumeric($!{ratBean.useMoney})</td>
                        <td align="right">$number.formatNumeric($!{ratBean.approveMoney})</td>
                    #end
                    <td align="right">$number.formatNumeric($!{ratBean.overPlusMoney})</td>
                    <td align="right">$number.formatNumeric($!{ratBean.leftMoney})</td>
                    <td align="center">$!{ratBean.statusStr}</td>
                </tr>
                #end
            #end
        </tbody>
    </table>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratBkStaticsHis.list.js?_btv=${resourceVersion}"></script>
</html>

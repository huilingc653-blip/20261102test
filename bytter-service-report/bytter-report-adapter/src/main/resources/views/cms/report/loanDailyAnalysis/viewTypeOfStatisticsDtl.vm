<!DOCTYPE html>
<html lang="en" style="height: 100%">
<head>
    #parse("views/common/head.vm")
</head>
<body style="height: 85%">
    <form id="searchForm" class="layui-form" method="post">
        <input type="hidden" id="legendsData"  value='$!{legendsData}'>
        <input type="hidden" id="seriesData"  value='$!{seriesData}'>
        <input type="hidden" id="searchFrequency"  value='$!{paramVO.searchFrequency}'>
    </form>
    <div id="chartSum" style="width:100%;height:60%;text-align: center;"></div>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            #if($!{paramVO.typesOfStatistics}=="0")##统计维度为单位
                <th>#springMessage('table.report.corpId')</th><!-- 单位 -->
            #else
                <th>#springMessage('table.report.bankOrNet')</th><!-- 银行/结算中心 -->
            #end
            <th >#springMessage('cms.report.cur')</th><!--币别  -->
            <th >#springMessage('cms.report.loanType')</th><!--融资种类  -->
            #if($!{paramVO.searchFrequency}=="0")##按天统计
                <th>#springMessage('table.report.dailyAverage')</th><!--日均  -->
            #else
                <th>#springMessage('table.report.monthAverage')</th><!--月均  -->
            #end
        </tr>
        </thead>
        <tbody>
        #foreach($!{analysisVO} in $!{analysisVOList})
        <tr>
            #if($!{paramVO.typesOfStatistics}=="0")##统计维度为单位
                <td class="center">$!{analysisVO.corpName}</td>
            #else
                <td class="center">$!{analysisVO.bankTypeName}</td>
            #end
            <td class="center">$!{analysisVO.curName}</td>
            <td class="center">$dictTag.get("Loan.Sign",$!{analysisVO.loanSign})</td>
            <td class="textRight">$!number.formatNumeric($!{analysisVO.curLoanDailyMoney})</td>
        </tr>
        #end
        </tbody>
    </table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/loan/cmsLoanDailyCorpDtl.view.js?_btv=${resourceVersion}"></script>
</html>
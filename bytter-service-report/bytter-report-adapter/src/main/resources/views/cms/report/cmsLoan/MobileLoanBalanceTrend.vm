         */
        function getSubData() {
            var params = {};
            var corpIds = $("#corpIds").val();
            var curId = $("input[name = 'curId']")[0].value;
            var isInclude = $("input[name = 'isInclude']")[0].value;
            var isConvert = $("input[name = 'isConvert']")[0].value;
            var convertCurId = $("input[name = 'convertCurId']")[0].value;
            params.corpId = corpIds;
            params.curCode = curId;

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        /*//这里填写新的样式代码*/
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="corpId" value="$!{corpId}">
    <input type="hidden" name="loanType" value="$!{loanType}">
    <input type="hidden" name="remainTermId" value="$!{remainTermId}">
    <input type="hidden" name="curId" value="$!{curId}">
</form>
<div id="showDataTable">
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.cmsLoanInfo.billCode')</th><!--贷款流水号  -->
            <th>#springMessage('table.cmsLoanInfo.net')</th><!--所属资金中心  -->
            <th>#springMessage('table.abBillTransfer.applyCorp')</th><!--申请单位  -->
            <th>#springMessage('table.cmsLoanInfo.contractCode')</th><!--贷款合同编号  -->
            <th>#springMessage('table.cmsLoanSend.billCode')</th><!--贷款发放编号  -->
            <th>#springMessage('table.cmsLoanInfo.provideLoanAcc')</th><!--放款账号  -->
            <th>#springMessage('ttpay.currency')</th><!--币种  -->
            <th>#springMessage('table.cmsLoanInfo.loanMoney')</th><!--贷款金额  -->
            <th>#springMessage('table.cmsLoanInfo.loanDate')</th><!--贷款日期  -->
            <th>#springMessage('table.cmsLoanDeferred.matureDate')</th><!--还款日期  -->
            <th>#springMessage('table.cmsLoanInfo.loanGenre')</th><!--贷款类型  -->
            <th>#springMessage('table.cmsLoanInfo.loanTerm')</th><!--贷款期限  -->
            <th>#springMessage('table.cmsProvideLoanSend.money')</th><!--发放金额  -->
            <th>#springMessage('table.cmsLoanRepay.inwayMoney')</th><!--还款在途金额  -->
            <th>#springMessage('cms.report.repayMoney')</th><!--已还款金额  -->
            <th>#springMessage('table.accountDTO.balance')</th><!--余额  -->
        </tr>
        </thead>
    </table>
</div>
<div class="layui-form-item" style="width: 100%">
    <div class="layui-inline" style="text-align: center;width: 100%">
        <button class="layui-btn" type="button" onclick="doClose()">#springMessage('common.button.close')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
<script>
    bt.use(["jquery", "form", "datatable", "moneyType"], function () {
        $ = bt.jquery;
        form = bt.form();
        moneyType = bt.moneyType.init();
        moneyfun = moneyType.getFun();
        bt.datatable.init({
            elem: "#appTable",
            ajax: {
                url: basePath + "/cms/report/cmsExpireAnalysis/getCmsLoanDtlData",
            },
            searchForm:{
                formElem:"#searchForm",
                formFilter:"search"
            },
            checkbox:true,
            columns: [
                {
                    data: "billCode",
                    className: "center"
                },
                {
                    data: "netName",
                    className: "center"
                },
                {
                    data: "corpName",
                    className: "center"
                },
                {
                    data: "contractNo",
                    className: "center"
                },
                {
                    data: "sendBillCode",
                    className: "textRight"
                },
                {
                    data: "sendAcc",
                    className: "textRight"
                },
                {
                    data: "curName",
                    className: "textRight"
                },
                {
                    data: "money",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                },
                {
                    data: "loanDate",
                    className: "textRight"
                },
                {
                    data: "repayDate",
                    className: "textRight"
                },
                {
                    data: "loanGenre",
                    className: "textRight"
                },
                {
                    data: "loanTerm",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return data + bt.dict("cms.loan.ternUnit",row.ternUnit);
                    }

                },
                {
                    data: "sendMoney",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                },
                {
                    data: "repayingMoney",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                },
                {
                    data: "repayMoney",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                },
                {
                    data: "leftMoney",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                }
            ],
            summary: {
                pageSum: true,//小计功能开启
                selectSum: true,//已选汇总功能开启
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '8',//汇总列序号
                        dataName: 'money',//汇总列数据
                    },
                    {
                        colNum: '13',//汇总列序号
                        dataName: 'sendMoney',//汇总列数据
                    },
                    {
                        colNum: '14',//汇总列序号
                        dataName: 'repayingMoney',//汇总列数据
                    },
                    {
                        colNum: '16',//汇总列序号
                        dataName: 'leftMoney',//汇总列数据
                    }
                ]
            }
        });
        //这里填写新的js代码，请参考前端文档
    });
    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }
</script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>融资详情</title>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <script>var basePath = "${basePath}"</script>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no,minimum-scale=1.0,maximum-scale=1.0">
    <link rel="stylesheet" href="$!{basePath}/static/mobile/plugins/fixedTable/table.min.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="$!{basePath}/static/plugins/frozen/css/frozenui.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="$!{basePath}/static/css/mobile/index.css?_btv=${resourceVersion}">
    <style>
        html {
            font-size: 26.66667vw;
        }

        body {
            background: #fff;
        }

        .bt-chart-container {
            margin: 0.2rem;
        }

        .popup-block * {
            font-size: 0.14rem;
        }

        .container {
            height: calc(100% - 100px);
            overflow-y: auto;
        }

        .ui-tab-nav-multi li {
            display: inline;
        }

        input::-webkit-input-placeholder {
            color: #666;
        }

        .cms-rat-dtl-comminfo {
            color: #666666;
        }

        .com-rat-title{
            margin-right: 0.1rem;
        }
    </style>
</head>
<body>
##内部贷款
<section id="tab" class="ui-container" style="margin-top: 0.2rem">
#foreach($ration in $!{rations})
    <div>
        <div class="cms-rat-dtl-comminfo" style="margin-bottom: 0.1rem">
            <div class="ui-row-flex ui-whitespace">
                <div class="com-rat-title">授信模式:</div>
                <div>$dictTag.get("RatBkration.RatMode", "$!{ration.ratMode}")</div>
            </div>

            <div class="ui-row-flex ui-whitespace">
                <div class="com-rat-title">授信单位:</div>
                <div>$!{ration.corpName}</div>
            </div>

            <div class="ui-row-flex ui-whitespace">
                <div class="com-rat-title">银行信息:</div>
                <div>$!{ration.bankName}</div>
            </div>

            <div class="ui-row-flex ui-whitespace">
                <div class="com-rat-title">授信有效日期:</div>
                <div>$!date.format('yyyy-MM-dd',$!ration.beginDate)至$!date.format('yyyy-MM-dd',$!ration.endDate)</div>
            </div>

            <div class="ui-row-flex ui-whitespace">
                <div class="com-rat-title">单位:</div>
                <div>元</div>
            </div>
        </div>

        <div id="sp-list" class="data-table" style="margin-bottom: 0.1rem;height: calc(100vh - 2.35rem)">
            <div class="t_l" style="width: 100px">
                <!--1.1 冻结列表头-->
                <table style="width: 100%">
                    <tbody>
                    <tr>
                        <th>授信品种类型</th>
                    </tr>
                    </tbody>
                </table>
                <!--1.2 冻结列表体-->
                <div class="t_l_freeze">
                    <table style="width: 100px">
                        <tbody>
                            #foreach($rationDtl in $!{ration.rationDlts})
                                #set($vcount = $velocityCount - 1)
                                #if($!{rationDtl.itemFlag} == "0")
                                <tr>
                                    <td align="center">
                                        $dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
                                    </td>
                                </tr>
                                #else
                                <tr>
                                    #set($vcompcount = $!{ration.rationSize} + 1)
                                    #if($!{rationDtl.itemFlag})
                                        <td>
                                            $dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
                                        </td>
                                    #else
                                        <td align="center">
                                            #springMessage("table.interet.sum")
                                        </td>
                                    #end
                                </tr>
                                    #foreach($comRationDtl in $!{rationDtl.rationDlts})
                                    <tr>
                                        <td></td>
                                    </tr>
                                    #end
                                #end
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="t_r">
                <!--2.1　冻结行表头-->
                <div class="t_r_t">
                    <table style="width: 1000px">
                        <tbody>
                        <tr>
                            <th>授信品种</th>
                            <th>授信方式</th>
                            <th>授信额度</th>
                            <th>占用额度</th>
                            <th>在审占用额度</th>
                            <th>可用额度</th>
                            <th>剩余额度</th>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <!--2.2 表格中心内容区域-->
                <div class="t_r_content">
                    <table style="width: 1000px">
                        <tbody>
                            #foreach($rationDtl in $!{ration.rationDlts})
                                #set($vcount = $velocityCount - 1)
                                #if($!{rationDtl.itemFlag} == "0")
                                <tr data-tt-id="$!{ration.ratCode}_$!{rationDtl.itemFlag}" data-tt-parent-id="$!{ration.ratCode}" >
#*                                    <td>
                                        $dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
                                    </td>*#
                                    <td>
                                        $!{rationDtl.itemName}
                                    </td>
                                    <td>$dictTag.get("rat.creditType",$!{rationDtl.creditType})</td>
                                    <td style="text-align: right">$number.formatNumeric($!{rationDtl.money})</td>
                                    <td style="text-align: right">$number.formatNumeric($!{rationDtl.useMoney})</td>
                                    <td style="text-align: right">$number.formatNumeric($!{rationDtl.approveMoney})</td>
                                    <td style="text-align: right">$number.formatNumeric($!{rationDtl.overPlusMoney})</td>
                                    <td style="text-align: right">$number.formatNumeric($!{rationDtl.leftMoney})</td>
                                </tr>
                                #else
                                <tr data-tt-id="$!{ration.ratCode}_$!{rationDtl.itemFlag}" data-tt-parent-id="$!{ration.ratCode}" >
                                    #set($vcompcount = $!{ration.rationSize} + 1)
                                    #if($!{rationDtl.itemFlag})
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right">$number.formatNumeric($!{rationDtl.money})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{rationDtl.useMoney})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{rationDtl.approveMoney})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{rationDtl.overPlusMoney})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{rationDtl.leftMoney})</td>
                                    #else
                                        <td></td>
                                        <td></td>
                                        <td style="text-align: right">$number.formatNumeric($!{rationDtl.money})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{rationDtl.useMoney})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{rationDtl.approveMoney})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{rationDtl.overPlusMoney})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{rationDtl.leftMoney})</td>
                                    #end
                                </tr>
                                    #foreach($comRationDtl in $!{rationDtl.rationDlts})
                                    <tr data-tt-id="$!{rationDtl.itemCode}" data-tt-parent-id="$!{ration.ratCode}_$!{rationDtl.itemFlag}" >
                                        <td align="center" >
                                            $!{comRationDtl.itemName}
                                        </td>
                                        <td align="center">$dictTag.get("rat.creditType",$!{comRationDtl.creditType})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{comRationDtl.money})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{comRationDtl.useMoney})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{comRationDtl.approveMoney})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{comRationDtl.overPlusMoney})</td>
                                        <td style="text-align: right">$number.formatNumeric($!{comRationDtl.leftMoney})</td>
                                    </tr>
                                    #end
                                #end
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
#end
</section>
<script src="$!{basePath}/static/mobile/plugins/zepto/zepto.min.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/mobile/plugins/f2/f2.min.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/mobile/plugins/fixedTable/iscroll-probe.min.js?_btv=${resourceVersion}" id="probe"></script>
<script src="$!{basePath}/static/mobile/plugins/fixedTable/table.min.js?_btv=${resourceVersion}"></script>
<!-- 注意：如果你直接复制所有代码到本地，上述js路径需要改成你本地的 -->
<script>
(function (doc, win) {

})(document, window);
</script>
</body>
</html>
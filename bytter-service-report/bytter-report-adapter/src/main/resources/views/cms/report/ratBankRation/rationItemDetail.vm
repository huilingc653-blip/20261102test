<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
</form>
<div>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        #foreach($ration in $!{rations})
            <thead>
            <tr>
                <th align="center" colspan="2">#springMessage('table.ratBkration.ratMode')：$dictTag.get("RatBkration.RatMode", "$!{ration.ratMode}")</th>
                <th align="center" colspan="2">#springMessage('table.ratBkration.corpId')：$!{ration.corpName}</th>
                <th align="center" colspan="2">#springMessage('table.ratBkration.bankCode')：$!{ration.bankName}</th>
                <th align="center">#springMessage('table.ratBkrationDis.distributeWay')：$dictTag.get("RatBkrationDis.DistributeWay", $!{ration.disWay})</th>
                <th align="center" colspan="2">#springMessage('table.ratBkration.validDate')：$!date.format('yyyy-MM-dd',$!ration.beginDate)~$!date.format('yyyy-MM-dd',$!ration.endDate)</th>
            </tr>
            <tr>
                <th align="center">#springMessage('table.ratBkrationDetail.itemFlag')</th>
                <th align="center">#springMessage('table.ratBkrationDetail.itemCode')</th>
                <th align="center">#springMessage('table.ratBkrationDetail.creditType')</th> ##授信方式
                <th align="center">#springMessage('table.ratBkration.money')</th>
                <th align="center">#springMessage('table.ratBkrationDisDetail.superProcessMoney')</th>##占用额度
                <th align="center">#springMessage('table.ratBkrationDisDetail.checkProcessMoney')</th>##在审占用额度
                <th align="center">#springMessage('table.ratBkrationDisDetail.overPlusMoney')</th>##可用额度
                <th align="center">#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>##剩余授信额度
            </tr>
            </thead>
        <tbody>
            #foreach($rationDtl in $!{ration.rationDlts})
                #set($vcount = $velocityCount - 1)
                #if($!{rationDtl.itemFlag} == "0")
                <tr data-tt-id="$!{ration.ratCode}_$!{rationDtl.itemFlag}" data-tt-parent-id="$!{ration.ratCode}" >
                ##if($!{vcount} == "0")
                    <td align="center">
                        $dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
                    </td>
                ##end
                    <td align="center">
                        $!{rationDtl.itemName}
                    </td>
                    <td align="center">$dictTag.get("rat.creditType",$!{rationDtl.creditType})</td>
                    <td align="right">$number.formatNumeric($!{rationDtl.money})</td>
                    <td align="right">$number.formatNumeric($!{rationDtl.useMoney})</td>
                    <td align="right">$number.formatNumeric($!{rationDtl.approveMoney})</td>
                    <td align="right">$number.formatNumeric($!{rationDtl.overPlusMoney})</td>
                    <td align="right">$number.formatNumeric($!{rationDtl.leftMoney})</td>
                </tr>
                #else
                <tr data-tt-id="$!{ration.ratCode}_$!{rationDtl.itemFlag}" data-tt-parent-id="$!{ration.ratCode}" >
                    #set($vcompcount = $!{ration.rationSize} + 1)
                        #if($!{rationDtl.itemFlag})
                            <td align="center" >
                                $dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
                            </td>
                            <td></td>
                            <td></td>
                            <td align="right">$number.formatNumeric($!{rationDtl.money})</td>
                            <td align="right">$number.formatNumeric($!{rationDtl.useMoney})</td>
                            <td align="right">$number.formatNumeric($!{rationDtl.approveMoney})</td>
                            <td align="right">$number.formatNumeric($!{rationDtl.overPlusMoney})</td>
                            <td align="right">$number.formatNumeric($!{rationDtl.leftMoney})</td>
                        #else
                            <td align="center" style='color: red;'>
                                #springMessage("table.interet.sum")
                            </td>
                            <td></td>
                            <td></td>
                            <td align="right" style='color: red;'>$number.formatNumeric($!{rationDtl.money})</td>
                            <td align="right" style='color: red;'>$number.formatNumeric($!{rationDtl.useMoney})</td>
                            <td align="right" style='color: red;'>$number.formatNumeric($!{rationDtl.approveMoney})</td>
                            <td align="right" style='color: red;'>$number.formatNumeric($!{rationDtl.overPlusMoney})</td>
                            <td align="right" style='color: red;'>$number.formatNumeric($!{rationDtl.leftMoney})</td>
                        #end
                </tr>
                    #foreach($comRationDtl in $!{rationDtl.rationDlts})
                    <tr data-tt-id="$!{rationDtl.itemCode}" data-tt-parent-id="$!{ration.ratCode}_$!{rationDtl.itemFlag}" >
                        <td></td>
                        <td align="center" >
                            $!{comRationDtl.itemName}
                        </td>
                        <td align="center">$dictTag.get("rat.creditType",$!{comRationDtl.creditType})</td>
                        <td align="right">$number.formatNumeric($!{comRationDtl.money})</td>
                        <td align="right">$number.formatNumeric($!{comRationDtl.useMoney})</td>
                        <td align="right">$number.formatNumeric($!{comRationDtl.approveMoney})</td>
                        <td align="right">$number.formatNumeric($!{comRationDtl.overPlusMoney})</td>
                        <td align="right">$number.formatNumeric($!{comRationDtl.leftMoney})</td>
                    </tr>
                    #end
                #end
            #end
        #end
    </tbody>
    </table>
</div>
    #parse("views/common/footer.vm")
</body>
</html>

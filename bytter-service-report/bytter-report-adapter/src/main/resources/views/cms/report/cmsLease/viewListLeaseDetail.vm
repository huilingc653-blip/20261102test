<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<table class="layui-table">
    <input id="leaseId" name="leaseId" type="hidden" value="$!{leaseId}">
    <tbody>
    <tr>
        <td align="right" width="10%">#springMessage('cms:lease:sub:mater:itemCode')：</td>
        <td width="23%" align="left">$!{cmsLeaseReportVO.leaseCode}</td>
        <td align="right" width="10%">#springMessage('cms:lease:sub:mater:leaseType')：</td>
        <td width="23%">$!dictTag.get("cms.financing.lease.info.leaseType",$!{cmsLeaseReportVO.leaseType})</td>
    </tr>
    <tr>
        <td align="right" width="10%">#springMessage("table.cmsLease.acceptor")：</td>
        <td width="23%" align="left">$!{cmsLeaseReportVO.corpName}</td>
        <td align="right" width="10%">#springMessage('table.cmsLease.beginDate')：</td>
        <td width="23%" align="left">$!date.format('yyyy-MM-dd',$!{cmsLeaseReportVO.beginDate})</td>
    </tr>
    <tr>
        <td align="right" width="10%">#springMessage('table.cmsLease.lessor')：</td>
        <td width="23%" align="left">$!{cmsLeaseReportVO.lessor}</td>
        <td align="right" width="10%">#springMessage('table.cmsLease.endDate')：</td>
        <td width="23%" align="left">$!date.format('yyyy-MM-dd',$!{cmsLeaseReportVO.endDate})</td>
    </tr>
    </tbody>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.fbsbudget.preiodName')</th><!--期次-->
            <th>#springMessage('table.cmsLease.payDate')</th><!--付租日期-->
            <th>#springMessage('table.cmsLease.payPlanDate')</th><!--计划付租日  -->
            <th>#springMessage('table.cmsLease.thisMoney')</th><!--本期租金  -->
            <th>#springMessage('table.cmsLease.leaseMonry')</th><!--租赁本金  -->
            <th>#springMessage('table.cmsLease.leaseInterest')</th><!--租赁利息  -->
            <th>#springMessage('table.cmsLease.thisCost')</th><!--本期费用  -->
            <th>#springMessage('table.cmsLease.surplusMoney')</th><!--剩余本金  -->
            <th>#springMessage('cms.lease.extend.pointsProportionSelect')</th><!--比例%/BP点数-->
            <th>#springMessage('table.cmsLease.isRepay')</th><!--是否已还-->
            <th>#springMessage('table.btBankAcc.rates')</th>
            <th>#springMessage('table.fcInterestDtlTemp.days')</th>
            <th>#springMessage('cms.lease.planBailMoney')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/lease/viewListLeaseReportDetail.list.js?_btv=${resourceVersion}"></script>
</html>

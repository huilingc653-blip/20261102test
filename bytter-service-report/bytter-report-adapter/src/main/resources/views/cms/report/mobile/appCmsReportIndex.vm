<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>信贷融资</title>
</head>
#set($resourceVersion=$resourceVersion.get())
#set($basePath=$springMacroRequestContext.contextPath)
<link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css?_btv=${resourceVersion}">
<link rel="stylesheet" href="${basePath}/static/css/mobile/appChartListMenu.css?_btv=${resourceVersion}">


<section class="ui-container">

    <input type="hidden" id="corpId" value="$!{corpId}">
    <input type="hidden" id="netId" value="$!{netId}">

    <ul class="ui-list ui-list-link ui-border-tb">

        <li onclick="openIntegratedQueryReportPage()" class="chart-row-container ui-border-t">
            <div class="row-item-icon-parent-container">
                <div class="row-item-icon-container" >
                    <img class="row-item-icon" src="${basePath}/static/mobile/icon/chartPage/icon_chart_intergrated_query@2x.png?_btv=${resourceVersion}" />
                </div>
            </div>
            <div class="ui-list-info">
                <h4 class="ui-nowrap chart-name-text">
                    查询
                </h4>
                <p class="ui-nowrap chart-description-text">信贷综合类业务查询</p>
            </div>
            <div class="row-arrowlink-icon-container">
                <img class="icon-right-arrowlink" src="${basePath}/static/mobile/icon/common/icon_right_arrowlink@2x.png?_btv=${resourceVersion}" />
            </div>
        </li>

        <li onclick="openGuaReportPage()" class="chart-row-container ui-border-t">
            <div class="row-item-icon-parent-container">
                <div class="row-item-icon-container">
                    <img class="row-item-icon" src="${basePath}/static/mobile/icon/chartPage/cms/icon_chart_cms_dbgl@2x.png?_btv=${resourceVersion}" />
                </div>
            </div>
            <div class="ui-list-info">
                <h4 class="ui-nowrap chart-name-text">
                    担保管理
                </h4>
                <p class="ui-nowrap chart-description-text">被担保合同查询</p>
            </div>
            <div class="row-arrowlink-icon-container">
                <img class="icon-right-arrowlink" src="${basePath}/static/mobile/icon/common/icon_right_arrowlink@2x.png?_btv=${resourceVersion}" />
            </div>
        </li>

</section>
<script src="${basePath}/static/plugins/frozen/js/zepto.min.js?_btv=${resourceVersion}"></script>
<script>

    var corpId = $("#corpId").val();
    var netId = $("#netId").val();

    function openIntegratedQueryReportPage() {
        // alert("打开综合查询报表页面");
        BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
            tabsData: [
                {
                    url: '/cms/provide/loaninfo/loanMobileQuery',
                    tabName: '银行借款查询',
                    params: {}
                },
            ],
            headerTitle: '查询'
        });
    }

    function openGuaReportPage() {
        // alert("打开担保管理报表页面")
        var url = "/cms/guarantee/guaContractInfo/appReportlist";
        setTimeout(function () {

            // BTAppBridge.jump({url: url, corpId: $("#corpId").val(), selfUI: true,rightViews:["search"]});
            BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
                tabsData: [
                    {
                        url: "/cms/guarantee/guaContractInfo/appReportlist",
                        tabName: '被担保合同查询',
                        params: {
                            corpId: corpId,
                            netId: netId,
                        }
                    },
                ],
                headerTitle: '担保管理'
            });

        },100);
    }

    (function (doc, win) {


    })(document, window);
</script>


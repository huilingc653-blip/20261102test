<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form " method="post">
    <input type="hidden" id="corpId" name="corpId">
    <input type="hidden" id="bankTypeId" name="bankTypeId">
    <input type="hidden" id="reportDate" name="reportDate" value="$!{reportDate}">
    <input type="hidden" id="ratMode" name="ratMode" value="$!{ratMode}">
    <input type="hidden" id="curCode" name="curCode" value="$!{curCode}">
    <input type="hidden" id="moneyType" name="moneyType" value="$!{moneyType}">
    <input type="hidden" id="status" name="status" value="$!{status}">
    <input type="hidden" id="beginDate" name="beginDate" value="$!{beginDate}">
    <input type="hidden" id="endDate" name="endDate" value="$!{endDate}">
    <input type="hidden" id="beginDate2" name="beginDate2" value="$!{beginDate2}">
    <input type="hidden" id="endDate2" name="endDate2" value="$!{endDate2}">
</form>
    #parse("views/common/footer.vm")
</body>
<script>
    var webObj = bt.navtab.getParentDom();
    var corpId = webObj.corpInit.get("corpId").val();
    var bankTypeId = "";
    var bankInfos = webObj.mulselect.get("bankTypeId").val();
    for (var i = 0; i < bankInfos.length; i++) {
        if (bankInfos[i] && bankInfos[i].id !== undefined && bankInfos[i].id != null && bankInfos[i].id !== "") {
            bankTypeId = bankTypeId + bankInfos[i].id + ",";
        }
    }

    console.log("corpId:" + corpId);
    console.log("bankTypeId:" + bankTypeId);

    $("#corpId").val(corpId);
    $("#bankTypeId").val(bankTypeId);
    var action = basePath + "/cms/report/ratBkStaticHis/list";
    $("#searchForm").attr("action", action);
    $("#searchForm").submit();
</script>
</html>
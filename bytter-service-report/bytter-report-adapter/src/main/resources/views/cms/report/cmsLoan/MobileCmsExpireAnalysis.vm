                                $("#sp_head_vHeads").html(item.corpName);
                            }
                            canvas = "<div style='background-color: #FFFFFF;'><canvas id=\"barChart" + index + "\" style=\"width: 3.5rem;height: 3rem\"></canvas></div>";
                        } else {
                            canvas = "<div style='margin-top: 0.1rem;background-color: #FFFFFF;padding-top: 0.05rem;font-weight: 700;font-size: 0.14rem'><div style=\"width: 100%\"><span style='margin-left: 0.13rem;margin-top: 0.05rem'>" + item.corpName + "</span></div><canvas id=\"barChart" + index + "\" style=\"width: 3.5rem;height: 3rem\"></canvas></div>";
                        }
                        $("#sp-map").append(canvas);
                        createChart(item.corpMbileData, "barChart" + index,xData,item.maxYValue);
                    });
                }
                $('#bt-loading').hide()
            }
        }

        // 构造图标
        function createChart(barData, id, xData, maxYValue) {
            F2.track(false);
            var chart = new F2.Chart({
                id: id,
                pixelRatio: window.devicePixelRatio, // 指定分辨率
            });
            var originDates = xData;
            maxYValue = Math.ceil(maxYValue);
            chart.source(barData, { //1、立即更新数据chart.changeData(data);　2、
                "xValue": {
                    type: 'cat',
                    tickCount: xData.length,
                    values: originDates
                },
                "yValue": {
                    tickCount: 5,
                    min: 0,
                    max: maxYValue
                }
            });

            //设置横坐标样式
            chart.axis('xValue', { // 横坐标样式
                label: function (text, index, total) {  //横坐标文字设置
                    return {
                        text: text.substring(0, 3) + "\n" + text.substring(3),//内容
                        fill: '#666666' //字体颜色
                    };
                },
                line: {
                    top: true
                }
            });

            //设置纵坐标样式
            chart.axis('yValue', {
                position: 'left', // 纵坐标位置
                label: function label(text) {
                    return {
                        text: text.substring(0, 5) + "\n" + text.substring(5),
                        fill: '#666666'
                    };
                },
                tickCount: 5,
                grid: { //网格线
                    stroke: '#EFEFEF',
                    border: 'line'
                }
            });

            chart.legend({
                align: 'center'
            }); // 是否显示图例

            chart.tooltip({
                showItemMarker: false,
                background: {
                    fill: '#69A4FF',
                    radius: 4,
                },
                valueStyle: {
                    fontSize: 10,
                    fill: '#fff',
                },
                titleStyle: {
                    fontSize: 10,
                    fill: '#fff',
                }, // tooltip 标题的文本样式配置，showTitle 为 false 时不生效
                nameStyle: {
                    fontSize: 10,
                    fill: '#fff',

                }
            });


            chart.interval()
                    .position('xValue*yValue')
                    .size(6)　//设置柱状大小
                    .color('categoryName', function (categoryName) { //设置柱状图的颜色
                        if (categoryName === '内部贷款') {
                            return 'l(90) 0:#FD9574 1:#FEBF40'
                        } else if (categoryName === '委托贷款') {
                            return 'l(90) 0:#EDAEF9 1:#A1B1F9'
                        } else if (categoryName === '银行借款') {
                            return 'l(90) 0:#14D2B8 1:#2DC9EB'
                        }
                    })
                    .adjust({
                        type: 'dodge',
                        marginRatio: 0.05 // 设置分组间柱子的间距
                    })
                    .style('type', {
                        radius: function radius() {　//设置柱状图圆角
                            return [3, 3, 3, 3]
                        }
                    });
            chart.interaction("pan");
            chart.scrollBar({
                xStyle: {
                    backgroundColor: "#e8e8e8",
                    fillerColor: "#808080",
                    offsetY: -2
                }
            });
            chart.render();
        }

        $(".cms-selectItem").on("click", function () {
            // 判断当前是否已经选中
            if ($(this).hasClass("cms-selectedItem")) {
                $(this).removeClass("cms-selectedItem");
                $(this).find(".cms-select-itemFont").removeClass("cms-selected-itemFont");
            } else {
                // 删除其它选中
                var allItem = $($(this).parents(".ui-list-info")[0]);
                var selected = $(allItem).find(".cms-selectedItem");
                if ($(selected).length > 0 && $(selected[0]).hasClass("cms-selectedItem")) {
                    $(selected[0]).removeClass("cms-selectedItem");
                    $(selected[0]).find(".cms-select-itemFont").removeClass("cms-selected-itemFont");
                }
                // 添加当前选中
                $(this).addClass("cms-selectedItem");
                $(this).find(".cms-select-itemFont").addClass("cms-selected-itemFont");
            }
        });


        //图标tab切换
        $('.sp-tab-switch > span').on('click', function () {
            $(".sp_head_vHeads").empty();
            var name = $(this).data('name');
            if ($("#btn3").parent().hasClass('active')) {
                $('.ui-actionsheet').removeClass('show');
                $('.bt-select-popup').removeClass('active');
                $('#sp_cycleDate').hide();
            }
            $(this).addClass('active').siblings('span').removeClass('active');
            if (name == 'list') {
                $("#sp-list").parent("div").show();
                $("#sp-map").hide();
                $("#sp_head_vHeads").html("数据列表");
                // $('#sp_map_view').hide();
                $('#sp_cycleDate span').removeClass('active');
                // loadListFormData();
                $("#showDate").hide();
                $("#unit").hide();
                $('#bt-loading').hide()
            } else {
                $("#sp-list").parent("div").hide();
                $("#sp-map").show();
                $("#sp-map").show();
                $("#showDate").show();
                $("#unit").show();
                $('#bt-loading').show();
                initChart();
            }
        });

        // 表格行监听
        $("#listData").on("click", ".dtl", function () {
            var params = {};
            params.loanType = $(this).data("loantype");
            params.corpId = $(this).data("corpid");
            params.remainTermId = $(this).data("remaintermid");
            params.curId = $(this).data("curid");
            params.url = "/cms/report/cmsExpireAnalysis/getMobileDtlData";
            var data = BTAppBridge.jump(params);
            uni.postMessage({
                data:data
            })
        });

        /**
         * 提交查询
         */
        $(".bt-popup-submit").on("click", function () {
            var linkId = $(this).data('link');
            hidePopup($('#' + linkId));
            refreshPage();
        });


        // 刷新数据
        function refreshPage() {
            console.log("777")
            $('#bt-loading').show()
            setTimeout(function () {
               var data = BTAppBridge.post("/cms/report/cmsExpireAnalysis/getMobileData", getSubData(), 'refreshData');
               uni.postMessage({
                   data:data
               })
            }, 100);

            /**
             * 刷新数据
             */
            refreshData = function (data) {
                console.log(data)
                if (data.success) {
                    $("#dtl1").empty();
                    $("#dtl2").empty();
                    createDataTable(data.obj);
                    if ($("#mapImg").hasClass("active")) {
                        initChart();
                    }
                }
                $('#bt-loading').hide();
            };
        }

        /**
         * 获取提交参数
         */
        function getSubData() {
            var params = {};
            var corpIds = $("#corpIds").val();
            var loanType = $("input[name = 'loanType']")[0].value;
            var biRemainTerm = $("input[name = 'biRemainTerm']")[0].value;
            var curId = $("input[name = 'curId']")[0].value;
            var isConvert = $("input[name = 'isConvert']")[0].value;
            var convertCurId = $("input[name = 'convertCurId']")[0].value;
            var isInclude = $("input[name = 'isInclude']")[0].value;
            params.corpId = corpIds;
            params.loanType = loanType;
            params.expireAnalysis = biRemainTerm;
            params.curId = curId;
            params.isConvert = isConvert;
            params.convertCurId = convertCurId;
            params.isInclude = isInclude;
            return params;
        }

        function createDataTable(data) {
            var html1 = "";
            var html2 = "";
            $.each(data, function (index,item) {
                html1 += "                            <tr>\n" +
                        "                                <td>" + item.corpName + "</td>\n" +
                        "                            </tr>";
                html2 += "                            <tr>\n" +
                        "                                <td>" + (isEmpty(item.loanTypeName) ? "" : item.loanTypeName) + "</td>\n" +
                        "                                <td>" + (isEmpty(item.expireAnalysis) ? "" : item.expireAnalysis) + "</td>\n" +
                        "                                <td>" + (isEmpty(item.curName) ? "" : item.curName) + "</td>\n" +
                        "                                <td style='text-align: right;color: #3D8EFF'><span class=\"dtl\" data-loanType = \"" + (isEmpty(item.loanType) ? "" : item.loanType) + "\" data-corpId = \"" + item.corpId + "\" data-remainTermId = \"" + (isEmpty(item.remainTermId) ? "" : item.remainTermId) + "\" data-curId = \"" + item.curId + "\" " +
                        "                                   style='text-align: right'>" + bt.money.format(item.money) + "</span></td>\n" +
                        "                                <td style='text-align: right'>" + bt.money.format(item.convertMoney) + "</td>\n" +
                        "                            </tr>";
            });
            $("#dtl1").append(html1);
            $("#dtl2").append(html2);
            adjustHeight();
            initTableSize();
        }

        /**
         * 为空判断
         * @param stringData
         * @returns {boolean}
         */
        function isEmpty(stringData) {
            if (null == stringData || stringData == "" || stringData == undefined || stringData == " ") {
                return true;
            } else {
                return false;
            }
        }

        /**
         * 非空判断
         * @param stringData
         * @returns {boolean}
         */
        function isNotEmpty(stringData) {
            return !isEmpty(stringData)
        }
    })(document, window);
</script>


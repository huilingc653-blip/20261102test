<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    ##        <input type="hidden" id="searchSatrtMonth" value="$!{searchSatrtMonth}">
    <table class="layui-table">
        <tbody>
        <tr>
            ##查询时间
            <td class="textRight">#springMessage("cms.report.date")</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text"
                           lay-verify="required"
                           data-biz-name="queryDate"
                           id="queryDate"
                           name="queryDate"
                           class="layui-input bt-input-inline bt-biz-dateType"
                           data-today="true">
                </div>
            </td>
            ##币种
            <td class="textRight">#springMessage('table.nisBillhead.curCode')</td>
            <td>
                <div class="bt-biz-selectType"
                     required="true"
                     data-url="${basePath}/basic/business/btcurrency/json"
                     data-biz-name="curId"
                     data-name="curId"
                     data-valueField="id"
                     data-required="true"
                     data-textField="curName"></div>
            </td>

            <td colspan="2" class="textRight">#springMessage('table.nisAllocationReport.curType')</td>
        </tr>
        <tr>
            <td colspan="8" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                    'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.report.corpId')</th><!-- 单位 -->
        <th class="averageTh">#springMessage('cms.report.risk.flowLoanRiskBal')</th><!--流贷余额  -->
        <th class="averageTh">#springMessage('cms.report.risk.billRiskBal')</th><!--票据票面余额  -->
        <th>#springMessage('cms.report.risk.bondRiskBal')</th><!--债券票面余额  -->
        <th>#springMessage('cms.report.risk.financingSum')</th><!--融资合计  -->
        <th class="averageTh">#springMessage('cms.report.risk.netInterestSum')</th><!--利息支出总额 -->
        <th>#springMessage('cms.report.rzfxckye.chainIncrease')</th><!--环比增幅  -->
        <th>#springMessage('cms.report.rzfxckye.increaseComparedLastYearEnd')</th><!--较去年底增幅  -->
        <th>#springMessage('cms.report.rzfxckye.chainIncreaseRatio')</th><!--环比增长比例  -->
        <th>#springMessage('cms.report.rzfxckye.increaseRatioComparedLastYearEnd')</th><!--较去年底增长比例  -->
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bi/cms/financingRiskBalance.list.js?_btv=${resourceVersion}"></script>
</html>
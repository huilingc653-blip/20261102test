<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##统计日期
            <td class="textRight" style="width: 20%">#springMessage('table.capitalDailyReport.totalDate')</td>
            <td style="width: 25%">
                <div class="layui-inline">
                    <input type="text"
                           lay-verify="required"
                           data-biz-name="queryDate"
                           id="calcDate"
                           name="calcDate"
                           class="layui-input bt-input-inline bt-biz-dateType"
                           placeholder="#springMessage('table.relationBank.searchDate')"
                           value="$!date.format("yyyy-MM-dd",$!{calcDate})">
                </div>
            </td>
            ##币别
            <td class="textRight" style="width: 20%">#springMessage('table.cmsProvideLoanInfo.curId')</td>
            <td style="width: 25%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="curId" data-biz-name="curId"data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-required="true" data-textfield="curName" data-defaultvalue=""></div>
                </div>
            </td>
            ##<td colspan="2" class="textRight">#springMessage('table.nisAllocationReport.curType')</td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.report.corpId')</td>
            <td class="rCode">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-biz-type="corp" data-type="selectTree" data-resource="bi:report:provide:capitalize"
                         data-tree-type="check" data-checkkboxtype='{"Y":"s","N":"s"}'
                         data-name="corpId" data-scope="all" data-biz-name="corpId" data-defaultvalue="$!{corpId}"></div>
                </div>
            </td>
            ##银行类别
            <td class="textRight">#springMessage('table.btBankAcc.bankTypeId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-name="bankTypeId" data-url="${basePath}/basic/business/btbanktype/json" data-biz-name="bankTypeId"
                         data-valuefield="id" data-textfield="typeName" data-defaultvalue="$!{bankTypeId}" data-method="get"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('cms.borrowDate')</td>
            <td>
                <div class="layui-inline">
                    <input name="ged_borrowDate" data-biz-name="startBorrowDate" data-name="startBorrowDate" data-endid="endBorrowDate" class="layui-input bt-biz-dateType" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input name="led_borrowDate" id="endBorrowDate" data-name="endBorrowDate" data-biz-name="endBorrowDate" class="layui-input bt-biz-dateType" type="text">
                </div>
            </td>
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td>
                <div class="layui-inline">
                    <input name="ged_repayDate" data-biz-name="startRepayDate" data-name="startRepayDate" data-endid="endRepayDate" class="layui-input bt-biz-dateType" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input name="led_repayDate" id="endRepayDate" data-name="endRepayDate" data-biz-name="endRepayDate" class="layui-input bt-biz-dateType" type="text">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight" width="25%">#springMessage('cms.report.loanType')</td>
            <td width="25%">
                ##<div class="bt-biz-dict"
                 ##    data-name="loanSign"
                 ##    data-type="select"
                  ##   data-value="$!{queryVO.loanSign}"
                  ##   data-group="Loan.Sign">
               ## </div>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="plClass"
                         data-url="${basePath}/cms/provide/loaninfo/queryLoanTypeList" data-valuefield="code"
                         data-textfield="name" ></div>
                </div>
            </td>
            <td class="textRight" width="25%">#springMessage('table.cmsProvideLoanInfo.plType')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-mulselectType" data-name="guaWay" data-biz-name="guaWay" data-inputValue="false"
                         data-method="get"
                         data-url="${basePath}/cms/guarantee/guaway/listGuaWay" data-valuefield="id"
                         data-textfield="name"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <table width="100%" align="center" id="search">
        <tr>
            <td align="right" width="10%">#springMessage("table.nisAllocationReport.curType")</td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsLoanSend.borrowCorpId')</th><!-- 借款单位-->
        <th>#springMessage('table.ratBkration.bankName')</th><!-- 银行名称 -->
        <th>#springMessage('table.cmsProvideLoanInfo.bankName')</th><!-- 支行名称 -->
        <th>#springMessage('cms.report.loanType')</th><!-- 借款种类-->
        <th>#springMessage('bill.accebill.billMoney')</th><!-- 借款金额-->
        <th>#springMessage('table.cmsProvideLoanInfo.bailmoney')</th><!-- 保证金-->
        <th>#springMessage('table.cmsLoanSend.remainMoney')</th><!-- 贷款余额-->
        <th>#springMessage('table.cmsProvideLoanInfo.plRate')</th><!-- 借款利率 -->
        <th>#springMessage('cms.borrowDate')</th><!-- 借款发放日期 -->
        <th>#springMessage('table.cmsProvideLoanSend.repayDate')</th><!-- 借款到期日期 -->
        <th>#springMessage('table.guaContract.guaMoney')</th><!-- 担保额度 -->
        <th>#springMessage('table.cmsProvideLoanInfo.plType')</th><!-- 担保方式 -->
        <th>#springMessage('table.guaContract.htNo')</th><!-- 担保合同 -->
        <th>#springMessage('contract.guaStartDate')</th><!-- 担保起始日 -->
        <th>#springMessage('contract.guaEndDate')</th><!-- 担保截止日 -->
        <th>#springMessage('table.cmsProvideLoanInfo.guaOtherRmk')</th><!-- 其他担保方式备注 -->
        <th>#springMessage('table.cmsProvideLoanInfo.rmk')</th><!-- 备注 -->
        <th>#springMessage('table.cmsProvideLoanInfo.guaOtherDate')</th><!-- 担保合同披露时间 -->
        <th width="6%">#springMessage('table.ratBkration.begindate')</th><!-- 授信开始时间 -->
        <th width="6%">#springMessage('table.ratBkration.enddate')</th><!-- 授信结束时间 -->
        <th width="8%">#springMessage('table.ratBkration.money')</th><!-- 授信额度 -->
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bi/cms/capitalize.js?_btv=${resourceVersion}"></script>
</html>

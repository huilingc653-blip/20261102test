<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form expandFormBox" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.corpId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="bi:cms:interest:withholding:query"
                         data-scope="all"
                         data-tree-type="check">
                    </div>
                </div>
            </td>
            ##发放单号
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.billCode')</td>
            <td>
                <input type="text" name="likes_sendBillCode" value=""  class="layui-input" placeholder="#springMessage('发放单号')" />
            </td>
            ##借款银行
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.bankId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-name="ins_bankType"
                         data-url="${basePath}/basic/business/btbanktype/json" data-biz-name="ins_bankType"
                         data-valuefield="id" data-textfield="typeName"
                         data-method="get"></div>
                </div>
            </td>
        </tr>

        <tr>
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plClass')</td>
            <td>
                <div class="bt-biz-selectType" data-name="eqs_plClass"
                     data-url="${basePath}/cms/provide/loaninfo/queryLoanTypeList" data-valuefield="code"
                     data-textfield="name"></div>
            </td>
            ##借款发放日期
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.sendDate')</td>
            <td>
                <div class="layui-inline">
                    <input name="ged_sendDate" data-endid="endSendDate" class="layui-input bt-biz-dateType" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input name="led_sendDate" id="endSendDate" class="layui-input bt-biz-dateType" type="text">
                </div>
            </td>
            ##借款到期日期
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td>
                <div class="layui-inline">
                    <input name="ged_repayDate" data-endid="endRepayDate" class="layui-input bt-biz-dateType" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input name="led_repayDate" id="endRepayDate" class="layui-input bt-biz-dateType" type="text">
                </div>
            </td>
        </tr>
        <tr>
            ##利息测算区间
            <td class="textRight">#springMessage('table.interestReport.Interest.period')</td>
            <td>
                <div class="layui-inline">
                    <input name="ged_interestDate" data-endid="endInterestDate" value="$!{firstMonthDate}" class="layui-input bt-biz-dateType" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input name="led_interestDate" id="endInterestDate" value="$!{lastMonthDate}" class="layui-input bt-biz-dateType" type="text">
                </div>
            </td>
            ##预提期限
            <td class="textRight">#springMessage('table.interestReport.provision.period')</td>
            <td>
                <div class="layui-inline">
                    <input name="ged_withholdingDate" data-biz-name="ged_withholdingDate" value="$!{firstMonth}" data-endid="endWithholdingDate" class="layui-input bt-biz-dateType" data-type="month" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input name="led_withholdingDate" data-biz-name="led_withholdingDate" value="$!{lastMonth}" id="endWithholdingDate" class="layui-input bt-biz-dateType" data-type="month" type="text">
                </div>
            </td>

        </tr>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" id="btnSearch" type="button">#springMessage('common.button.search')</button>
                <button class="layui-btn" lay-submit lay-filter="search" type="button" style="display: none">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<div class="dataTable-box">
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsProvideLoanInfo.corpId')</th><!-- 申请单位 -->
        <th>#springMessage('table.cmsProvideLoanSend.billCode')</th><!-- 发放单号 -->
        <th>#springMessage('table.cmsProvideLoanInfo.bankId')</th><!-- 银行类型 -->
        <th>#springMessage('table.cmsProvideLoanInfo.plClass')</th><!-- 借款种类 -->
        <th>#springMessage('table.cmsProvideLoanInfo.curId')</th><!-- 币别-->
        <th>#springMessage('table.cmsProvideLoanSend.sendDate')</th><!-- 借款发放日期 -->
        <th>#springMessage('table.cmsProvideLoanSend.repayDate')</th><!-- 借款到期日期 -->
        <th>#springMessage('table.cmsProvideLoanSend.money')</th><!-- 本次发放金额-->
        <th>#springMessage('table.cmsProvideLoanRepay.plBalance')</th><!-- 借款余额 -->
        <th>#springMessage('replenish.CalcInterest')</th>#*测算区间利息*#
        #foreach($item in $!{months})
            <th>$item</th>
        #end
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
</div>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form','datatable','corp','moneyType','dateType','selectType','dicts','mulselect'], function(){
        $ = bt.jquery,form = bt.form(),moneyFun = bt.moneyType.getFun();
        bt.corp.init();//单位
        bt.moneyType.init();//金额
        var dateTypes = bt.dateType.init();//日期
        bt.selectType.init();//日期
        bt.dicts.init();//数据字典
        bt.mulselect.init();

        // 初始化月
        var months = "$!{monthSize}";
        var newCoumns = initColumns(months);
        var baseTableConfig = {
            elem: "#appTable",
            colReorder: true,
            searchForm:{
                formElem:"#searchForm",
                formFilter:"search"
            },
            order: [[1, 'desc']],
            fixedColumns: {
                rightColumns:0//代表冻结右边一列
            },
            checkbox:false,
            ajax: {
                'url': basePath+"/bi/cms/interestReport/queryBankLoanWithholdingData"
            },
            // ignoreButtons: ['print', 'state'],// 忽略的表单打印按钮 state取消表格保存按钮
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            fixedColumns: {
                rightColumns:1//代表冻结右边一列
            },
        }
        baseTableConfig.columns = newCoumns
        //生成列表
        bt.datatable.init(baseTableConfig);

        // 通过查询切换表格
        $("#btnSearch").click(function(){
            var table = $('#appTable').DataTable();
            // 清空表格内容
            table.clear();
            // 销毁DataTable实例
            table.destroy();
            $('#appTable').remove();
            bt.loading.show();

            // 获取预提日期区间
            var ged_withholdingDate = dateTypes.get("ged_withholdingDate").val();
            var led_withholdingDate = dateTypes.get("led_withholdingDate").val();
            var monthsDifference = getMonthDifference(ged_withholdingDate, led_withholdingDate);

            // 创建新表格
            var newTable = '<table id="appTable" class="layui-table layui-form" >'
            newTable += '<thead><tr>'
            newTable += '<th>'+bt.lang("table.cmsProvideLoanInfo.corpId")+'</th>'
            newTable += '<th>'+bt.lang("table.cmsProvideLoanSend.billCode")+'</th>'
            newTable += '<th>'+bt.lang("table.cmsProvideLoanInfo.bankId")+'</th>'
            newTable += '<th>'+bt.lang("table.cmsProvideLoanInfo.plClass")+'</th>'
            newTable += '<th>'+bt.lang("table.cmsProvideLoanInfo.curId")+'</th>'
            newTable += '<th>'+bt.lang("table.cmsProvideLoanSend.sendDate")+'</th>'
            newTable += '<th>'+bt.lang("table.cmsProvideLoanSend.repayDate")+'</th>'
            newTable += '<th>'+bt.lang("table.cmsProvideLoanSend.money")+'</th>'
            newTable += '<th>'+bt.lang("table.cmsProvideLoanRepay.plBalance")+'</th>'
            newTable += '<th>'+bt.lang("replenish.CalcInterest")+'</th>'
            newTable += '<th>'+ged_withholdingDate+'</th>'// 开始月
            var _tempDate = new Date(ged_withholdingDate+"-01");
            for (let i = 0; i < monthsDifference; i++) {
                // 获取下个月
                var nextMonth = new Date(_tempDate);
                nextMonth.setMonth(nextMonth.getMonth() + 1);
                var nextMonthStr = nextMonth.getFullYear() + "-" + String(nextMonth.getMonth() + 1).padStart(2, '0');
                newTable += '<th>'+nextMonthStr+'</th>'
                _tempDate = nextMonth;
            }
            newTable += '<th>操作</th>'
            newTable += '</tr></thead>'
            newTable += '</table>'

            $('.dataTable-box').html(newTable);

            // 初始化表格
            newCoumns = initColumns(Number(monthsDifference) + 1);
            baseTableConfig.columns = newCoumns
            baseTableConfig.btDrawCallback = function (settings){
                bt.loading.hide();
            }
            bt.datatable.init(baseTableConfig);

        });


        /**判断字符串是否为空*/
        bt.empty = function(ms){
            if(typeof(ms) == "undefined" || ms == null || ms == "" || ms == "null"){
                return true;
            }
            return false;
        }
    });

    function initColumns(months){
        var columns = [
            {data:"corpName",bSortable:true},
            {data:"sendBillCode",bSortable:true},
            {data:"bankName",bSortable:true},
            {data:"plClassName",bSortable:true},
            {data:"curName",bSortable:false,render: function ( data, type, full, meta ){
                    return full.curName;
                }},
            {data:"sendDate",bSortable:true},
            {data:"repayDate",bSortable:true},
            {data:"sendMoney", className:"textRight",bSortable:false,render: function ( data, type, full, meta ){
                    return bt.money.format(full.sendMoney);
                }},
            {data:"sendBalanceMoney",className:"textRight",bSortable:false,render: function ( data, type, full, meta ){
                    return bt.money.format(full.sendBalanceMoney);
                }},
            {data:"sectionInterest",className:"textRight",bSortable:false,render: function ( data, type, full, meta ){
                    return bt.money.format(full.sectionInterest);
                }}
        ];

        for (var i = 0; i < months; i++) {
            // data:"monthInterest"+i,必须有，否则无法导出该列
            columns.push({data:"monthInterest"+i,className:"textRight",bSortable:false,render: function ( data, type, full, meta ){
                // 下面只能用列取值 不能用full.monthInterest[i]取值。
                var months = full.monthInterest;
                var colIndex = meta.col;
                colIndex = colIndex -10;// 前面有多少列就减多少
                if(bt.empty(months) || bt.empty(months[colIndex])){
                    return "";
                }else{
                    return bt.money.format(months[colIndex]);
                }
                }})
        }

        columns.push({data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
                var html = '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a>';
                html += ' \<span class="text-explode">|</span>\ <a class="" href="#" data-row="' + meta.row + '" onclick="repayInterest(this)">' + bt.lang('cms.button.provideInterest') + '</a>';
                return html;
            }
        })

        return columns;
    }

    function view(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/provide/loaninfo/viewPerfectlyLoanInfo?infoBillCode=" + data.infoBillCode + "&sendBillCode=" + data.sendBillCode + "&show=1" + "&enableUpload=1");
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/provide/loaninfo/viewPerfectlyLoanInfo?infoBillCode=" + data.infoBillCode+"&sendBillCode=" + data.sendBillCode + "&show=1"
        });
    }
    /**加载利息预计明细*/
    function repayInterest(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('cms.button.provideInterest'),basePath + "/cms/provide/cmsprovideinterest/list?sendBillCode="+data.sendBillCode+"&showSign=0&repairSign=0");
        }
    }

    function getMonthDifference(start, end) {
        // 解析起始日期和结束日期
        const [startYear, startMonth] = start.split('-').map(Number);
        const [endYear, endMonth] = end.split('-').map(Number);

        // 计算总月份数
        const startTotalMonths = startYear * 12 + startMonth - 1; // 月份从0开始计数
        const endTotalMonths = endYear * 12 + endMonth - 1;

        // 返回相差的月份数
        return endTotalMonths - startTotalMonths;
    }

</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.abBillTransfer.allocatedCode.apply')</th><!-- 申请单号 -->
        <th>#springMessage('table.cmsProvideLoanInfo.bankId')</th><!-- 借款银行 -->
        <th>#springMessage('table.cmsProvideLoanInfo.curId')</th><!-- 币种 -->
        <th>#springMessage('table.cmsProvideLoanInfo.plClass')</th><!-- 借款种类 -->
        <th>#springMessage('contract.loanStartDate')</th><!-- 借款开始日期 -->
        <th>#springMessage('contract.loanEndDate')</th><!-- 借款结束日期 -->
        <th>#springMessage('table.cmsProvideLoanInfo.plMoney')</th><!-- 借款金额 -->
    </tr>
    </thead>
    <tbody>
    <tr>
        <td class="center">$!{cmsProvideLoanInfo.billCode}</td>
        <td class="center">$!{cmsProvideLoanInfo.bankName}</td>
        <td class="center">$!{cmsProvideLoanInfo.curName}</td>
        <td class="center">$!{cmsProvideLoanInfo.plClassName}</td>
        <td class="center">$!date.format('yyyy-MM-dd',$!{cmsProvideLoanInfo.plDate})</td>
        <td class="center">$!date.format('yyyy-MM-dd',$!{cmsProvideLoanInfo.repayDate})</td>
        <td class="textRight">$!number.formatNumeric($!{cmsProvideLoanInfo.plMoney})</td>
    </tr>
    </tbody>
</table>
    #parse("views/common/footer.vm")
</body>
</html>

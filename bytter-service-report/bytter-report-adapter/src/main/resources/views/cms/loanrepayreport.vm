<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>

        <tr>
            <td class="textRight">#springMessage('table.cmsLoanInfo.loanDate')</td>
            <td>
                <div class="layui-inline">
                    <input name="loanStartDate" data-biz-name="loanStartDate" data-name="loanStartDate" data-endid="loanEndDate" lay-verify="required"  class="layui-input bt-biz-dateType" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input name="loanEndDate" id="loanEndDate" data-name="loanEndDate" data-biz-name="loanEndDate" lay-verify="required" class="layui-input bt-biz-dateType" type="text">
                </div>
            </td>
            #*<td class="textRight">#springMessage('table.report.corpId')</td>
            <td class="rCode">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-biz-type="corp" data-type="selectTree" data-resource="bi:report:provide:capitalize"
                         data-tree-type="check" data-checkkboxtype='{"Y":"s","N":"s"}'
                         data-name="corpId" data-scope="all" data-biz-name="corpId" data-defaultvalue="$!{corpId}"></div>
                </div>
            </td>*#
        </tr>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>

</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsLoanInfo.corp')</th><!--申请单位  -->
        <th>#springMessage('table.cmsLoanInfo.net')</th><!--所属资金中心   -->
        <th>#springMessage('table.cmsLoanInfo.loan.beginBal')</th><!--期初贷款余额  -->
        <th>#springMessage('table.cmsLoanInfo.loan.current')</th><!--本期贷款  -->
        <th>#springMessage('table.cmsLoanInfo.repay.current')</th><!--	本期还款  -->
        <th>#springMessage('table.cmsLoanInfo.loan.endBal')</th><!--期末贷款余额  -->

    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bi/cms/loanrepayreport.js?_btv=${resourceVersion}"></script>
</html>

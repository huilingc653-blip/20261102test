<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form " method="post" id="searchForm">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位
            <td class="textRight" width="10%">#springMessage('bi.financial.generalLedger.corpName')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="net"
                         data-scope="net"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="corpId"
                         data-resource="bi:financial:general.ledger:query"
                         ></div>
                </div>
            </td>
            ##币别
            <td class="textRight" width="10%">#springMessage('bi.financial.generalLedger.curName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name="curId" data-biz-name="curId" data-valueField="id" data-textField="curName"></div>
            </td>
            ##日期
            <td class="textRight" width="10%">#springMessage('bi.financial.generalLedger.optDate')</td>
            <td>
                <input type="text" name="beginDate" class="layui-input bt-input-inline bt-biz-dateType" lay-verify="required"
                       id="beginDate" data-today="true" data-type="month" data-biz-name="beginDate" data-endid="endDate">
                <span class="date-mid">~</span>
                <input type="text" name="endDate" class="layui-input bt-input-inline bt-biz-dateType" lay-verify="required"
                       id="endDate" data-today="true" data-type="month" data-biz-name="endDate">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('bi.financial.generalLedger.showDetailSubject')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0"
                     data-name="showDetailSubject" data-biz-name="showDetailSubject"></div>
            </td>
            <td class="textRight">#springMessage('bi.financial.generalLedger.subject')</td>
            <td>
                <div class="bt-biz-selectType" data-biz-name="subjectId" data-beforeInitResiveData="beforeInitSubject"
                     data-url="${basePath}/finacial/paramconfig/fcsubject/findSubjectByFatherId" data-valuefield="id"
                     data-textfield="subjectNameText" data-name="subjectId" data-search="true"></div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" style="width:100%;display: none" class="layui-form">
    <thead>
    <tr>
        <th>#springMessage('bi.financial.generalLedger.corpName')</th>
        <th>#springMessage('bi.financial.generalLedger.curName')</th>
        <th>#springMessage('bi.financial.generalLedger.optDate')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>

    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bi/financial/generalLedger.list.js?_btv=${resourceVersion}"></script>
</html>
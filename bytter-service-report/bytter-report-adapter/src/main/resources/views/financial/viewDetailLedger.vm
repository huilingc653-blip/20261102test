<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        .print-list * {
            font-family: '宋体';
        }
        .no-data {
            text-align: center;
            color: red;
        }

        .voucher-title1, .voucher-title2 {
            text-align: center;
            font-size: 24px;
            color: #333;
            line-height: 50px;
        }

        .voucher-title2 {
            font-size: 18px;
            line-height: 22px;
        }

        .table-header-container {
            text-align: center;
            height: 30px;
            line-height: 30px;
            position: relative;
            font-size: 12px;
            margin-top: 20px;
        }

        .table-header-left {
            position: absolute;
            left: 20px;
            top: 0;
        }

        .table-header-right {
            position: absolute;
            right: 0px;
            top: 0;
        }

        table tbody tr {
            line-height: 20px;
        }

        .table-page .table-length {
            display: none!important;
        }
        #headerRight span {
            position: relative;
            display: inline-block;
            height: 30px;
        }
        #headerRight button {
            position: relative;
            display: inline-block;
            box-sizing: border-box;
            border: 1px solid #999;
            border-radius: 2px;
            cursor: pointer;
            color: black;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            vertical-align: middle;
            text-align: center;
            line-height: 30px;
            padding: 0 10px;
            font-size: 12px;
            height: 30px;
            margin-right: 5px;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            text-decoration: none;
            outline: none;
            background: #5472A2;
        }
        #headerRight div div {
            z-index: 2;
            position: absolute;
            top: 30px;
            left: 0;
            margin-top: 3px;
            padding: 8px 8px 4px 8px;
            border: 1px solid #ccc;
            border: 1px solid rgba(0, 0, 0, 0.4);
            background-color: white;
            /* overflow: hidden; */
            z-index: 2002;
            border-radius: 5px;
            box-shadow: 3px 3px 5px rgba(0, 0, 0, 0.3);
            z-index: 2002;
            -webkit-column-gap: 8px;
            -moz-column-gap: 8px;
            -ms-column-gap: 8px;
            -o-column-gap: 8px;
            column-gap: 8px;

        }
        #headerRight div a {
            position: relative;
            left: 0;
            right: 0;
            display: block;
            float: none;
            margin-bottom: 4px;
            margin-right: 0;
            background-image: linear-gradient(to bottom, #f0f0f0 0%, #dadada 100%);
            padding: 0 5px;
            border-radius: 4px;
        }
    </style>
</head>
<body>
<form class="layui-form layui-form-pane" method="post" id="searchForm">
    <input type="hidden" id="netId" name="netId" value="$!{generalLedgerSearchVO.netId}">
    <input type="hidden" id="curId" name="curId" value="$!{generalLedgerSearchVO.curId}">
    <input type="hidden" id="balanceWay" name="balanceWay" value="$!{generalLedgerSearchVO.balanceWay}">
    <input type="hidden" id="subjectId" name="subjectId" value="$!{generalLedgerSearchVO.subjectId}">
    <input type="hidden" id="beginDate" name="beginDate" value="$!{generalLedgerSearchVO.beginDate}">
    <input type="hidden" id="endDate" name="endDate" value="$!{generalLedgerSearchVO.endDate}">
    <input type="hidden" id="showDetailSubject" name="showDetailSubject" value="$!{generalLedgerSearchVO.showDetailSubject}">
</form>
<div id="print" class="print-list">
        <div class="voucher-title1">
            <span id="netName">$!{generalLedgerSearchVO.netName}</span>
        </div>
        <div class="voucher-title2">
            #springMessage('bi.financial.generalLedger.generalLedger')
        </div>

        <div class="table-header-container layui-form">
            <div class="table-header-left" style="text-align: left;font-family: '宋体';">
                <span id="headerLeft">#springMessage('bi.financial.generalLedger.subjectName')：</span>
                #if($!{generalLedgerSearchVO.showDetailSubject} == 1)
                    <div class="bt-biz-selectType" data-biz-name="detailSubjectId" id="detailSubjectId"
                         data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSubjectDate" data-valuefield="id"
                         data-textfield="subjectNameText" data-name="subjectId" data-search="true" data-beforeInitResiveData="beforeInitSubject"
                         data-defaultvalue="$!{generalLedgerSearchVO.subjectId}" data-callback="onChangeSubject"></div>
                #else
                    <div class="bt-biz-selectType" data-biz-name="detailSubjectId" id="detailSubjectId"
                         data-url="${basePath}/finacial/paramconfig/fcsubject/findSubjectByFatherId" data-valuefield="id"
                         data-textfield="subjectNameText" data-name="subjectId" data-search="true" data-beforeInitResiveData="beforeInitSubject"
                         data-defaultvalue="$!{generalLedgerSearchVO.subjectId}" data-callback="onChangeSubject"></div>
                #end
            </div>
            <div class="table-header-center" id="headerCenter">#springMessage('com.table.makeDate')：$dateTag.formatDate()        &nbsp;&nbsp;&nbsp;&nbsp;#springMessage('bi.financial.generalLedger.curName')：<span id="curName"></span></div>
            <div class="table-header-right" id="headerRight">
                <div class="layui-input-inline">
                    <button type="button" class="layui-btn" data-link="printBtn" data-type="print">#springMessage('common.button.print')</button>
                    <button type="button" class="layui-btn" data-link="exportBtn" data-type="export" style="margin-left: 0;">#springMessage('common.button.exports')</button>
                    <div class="layui-hide operate-container" id="printBtn">
                        <a href="#" onclick="doPrintAll()"><span>#springMessage('common.button.printall')</span></a>
                        <a href="#" onclick="doPrintCurrent()"><span>#springMessage('common.button.printcurrent')</span></a>
                    </div>
                    <div class="layui-hide operate-container" id="exportBtn" style="left:auto;right: 0">
                        <a href="#" onclick="doExportAll()"><span>#springMessage('common.button.exportsAll')</span></a>
                        <a href="#" onclick="doExportCurrentPage()"><span>#springMessage('common.button.exportsCurrentPage')</span></a>
                    </div>

                </div>
            </div>
        </div>
        <div style="min-height: 300px;">
            <table class="layui-table" >
                <thead id="detailThead" >
                <th style="text-align: center;">${year}年</th>
                <th style="text-align: center;">#springMessage('bi.financial.generalLedger.summary')</th>
                <th style="text-align: center">#springMessage('bi.financial.generalLedger.debitMoney')</th>
                <th style="text-align: center">#springMessage('bi.financial.generalLedger.creditMoney')</th>
                <th style="text-align: center;">#springMessage('bi.financial.generalLedger.balanceWay')</th>
                <th style="text-align: center">#springMessage('bi.financial.generalLedger.balance')</th>
                </thead>
                <tbody id="detailTable"></tbody>
            </table>
        </div>

</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bi/financial/generalLedger.view.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
</html>

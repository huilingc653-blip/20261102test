<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('bi.money.map.corp')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-tree-type="check"
                         data-type="selectTree"
                         data-name="corpId"
                         data-resource="bi:synthesize:moneyMap:query"
                         data-scope="all"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('bi.money.map.balance.type')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="bi.money.map.balance.type"
                     data-name="balanceType" data-biz-name="balanceType"
                ></div>
            </td>
            <td class="textRight">#springMessage('bi.money.map.bank')</td>
            <td>
                <input type="text" name="bankName" id="bankName" data-biz-name="bankName"
                       autocomplete="off" class="layui-input" >
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('bi.money.map.cur.name')</td>
            <td>
                <div class="bt-biz-selectType" data-name="curId" data-valueField="id" data-textField="curName"
                     data-biz-name="curId" data-selecttext="false" data-callback="clearCur"
                     data-url="${basePath}/basic/business/btcurrency/json"
                     data-defaultvalue="$!{currencyTag.getRMBCurrency().id}"
                ></div>
            </td>
            <td class="textRight">#springMessage('bi.money.map.balance.date')</td>
            <td>
                <input type="text" name="balanceDate" class="layui-input bt-input-inline bt-biz-dateType" data-today="true" >
            </td>
            <td class="textRight">#springMessage('bi.money.map.statistical.dimension')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="bi.money.map.statistical.dimension"
                     data-name="statisticalDimension" data-biz-name="statisticalDimension" data-selecttext="false" data-defaultvalue="1"
                ></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('bi.money.map.account')</td>
            <td>
                <input type="text" name="account" id="account" data-biz-name="account"
                       autocomplete="off" class="layui-input" >
            </td>
            <td class="textRight">#springMessage('bi.money.map.unit')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="common.moneyMap.unit"
                     data-name="moneyUnit" data-biz-name="moneyUnit" data-selecttext="false" data-defaultvalue="yuan"
                ></div>
            </td>
            <td class="textRight">#springMessage('bi.money.map.show.type')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="bi.money.map.show.type"
                     data-name="showType" data-biz-name="showType" data-defaultvalue="1"
                ></div>
            </td>
        </tr>
        <tr>
            ##折合币种
            <td class="textRight">#springMessage("commom.converted.into.currency")</td>
            <td>
                <div class="bt-biz-selectType"
                     data-biz-name="reducedCurId"
                     data-url="${basePath}/basic/business/btcurrency/json"
                     data-valuefield="id"
                     data-textfield="curName"
                     data-name="reducedCurId"
                     data-search="true"
                     data-callback="checkConvertCurCallBack"
                ></div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button type="button" class="layui-btn" lay-submit lay-filter="search">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<div id="moneyMapDetail">
    <div id="tableContainer">

    </div>
##    <div id="mapContainer" class="layui-hide">
##
##    </div>

</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bi/moneyMap/moneyMap.list.js?_btv=${resourceVersion}"></script>
</html>

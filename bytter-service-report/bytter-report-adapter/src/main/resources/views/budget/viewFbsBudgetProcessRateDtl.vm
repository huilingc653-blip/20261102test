<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
        <input id="id" name="id" type="hidden" value="$!{id}">
        <input id="timeType" name="timeType" type="hidden" value="$!{timeType}">
        <input id="beginDate" name="beginDate" type="hidden" value="$!{beginDate}">
        <input id="endDate" name="endDate" type="hidden" value="$!{endDate}">
        <!-- 新增币种 -->
        <div class="layui-input-inline" style="padding: 10px; float: right">
            <div class="layui-input-inline">
                #springMessage('table.fbsBudgetDetail.curId')：$!{cur.curName}
            </div>
        </div>
		<table id="appTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('table.fbsBudgetYear.number')</th>
        		<th>#springMessage('table.fbsBudgetYear.itemCode')</th>
                <th>#springMessage('table.fbsBudgetYear.itemName')</th>
                <th>#springMessage('table.fbsBudgetYear.bMoney')</th>
                <th>#springMessage('table.fbsBudgetProcess.processMoney')</th>
                <th>#springMessage('table.fbsBudget.processRatio')</th>
            </tr>
            </thead>
        	<tbody>
            	#foreach($date in $dtlList)
            		<tr>
            			<td>$!{velocityCount}</td>
            			<td>$!{date.itemCode}</td>
        				<td>$!{date.itemName}</td>
        				<td class="textRight">$!number.formatNumeric($!{date.bMoney})</td>
						<td class="textRight">$!number.formatNumeric($!{date.processMoney})</td>
						<td class="textRight">$!number.formatNumeric($!{date.processRatio})</td>
            		</tr>
            	#end
            </tbody>
        </table>
		</div>
	</form>
    <div id="chartSum" style="width:100%;height:500px;"></div>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bi/fbsBudgetProcessRate.bar.js?_btv=${resourceVersion}"></script>
<script >
bt.use(['form','layedit','treeTable'], function(){
    var $ = bt.jquery,form = bt.form();
	bt.treeTable.init({elem:"#appTable",column:1});
});
</script>
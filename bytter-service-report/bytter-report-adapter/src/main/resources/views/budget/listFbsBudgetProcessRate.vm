<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位
            <td class="textRight" width="10%"></font>#springMessage('table.fbsBudget.corpId')</td>
            <td width="20%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-defaultvalue="$!{queryVO.corpId}"
                         data-resource="budget:report:fbsBudgetProcess:query"
                         data-tree-type="check"
                         data-scope="all"></div>
                </div>
            </td>
            ##周期类型
            <td class="textRight" width="10%">#springMessage('table.fbsBudget.timeType')</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="select" data-value="$!{queryVO.timeType}" data-displayData="$!{itemTypes}"
                     data-group="fbs.timeType" data-name="timeType" data-required = "true"></div>
            </td>
            ##日期
            <td class="textRight" width="10%">#springMessage('table.fcOutSubjectDay.optDate')</td>
            <td width="30%">
                <input type="text" name="beginDate" class="layui-input bt-input-inline bt-biz-dateType" lay-verify="required" data-endid="endDate" value="$!date.format('yyyy-MM-dd',$!{queryVO.beginDate})">
                <span class="date-mid">~</span>
                <input type="text" name="endDate" class="layui-input bt-input-inline bt-biz-dateType" lay-verify="required" id="endDate" value="$!date.format('yyyy-MM-dd',$!{queryVO.endDate})">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" id="search" lay-submit="" lay-filter="submit">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <table id="appTable" class="layui-table" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.fbsBudgetReport.period')</th>
            <th>#springMessage('table.fbsBudget.corpId')</th>
            <th>#springMessage('table.fbsBudget.beginDate')</th>
            <th>#springMessage('table.fbsBudget.endDate')</th>
            <th>#springMessage('table.fbsBudgetDetail.curId')</th>
            <th>#springMessage('table.fbsBudgetYear.bMoney')</th>
            <th>#springMessage('table.fbsBudgetProcess.processMoney')</th>
            <th>#springMessage('table.fbsBudget.processRatio')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
        <tbody>
            #foreach($data in $dtlList)
            <tr>
                <td align="center">$!{data.timeTypeShow}</td>
                <td>($!{data.corpCode})$!{data.corpName}</td>
                <td align="center">$!date.format('yyyy-MM-dd',$!{data.beginDate})</td>
                <td align="center">$!date.format('yyyy-MM-dd',$!{data.endDate})</td>
                <td align="center">$!{data.curName}</td>
                <td class="textRight">$!number.formatNumeric($!{data.bMoney})</td>
                <td class="textRight">$!number.formatNumeric($!{data.processMoney})</td>
                <td class="textRight">$!number.formatNumeric($!{data.processRatio})</td>
                <td class="textRight"><a class="" href="#" onclick="view('$!{data.id}','$!{data.curId}','$!{data.timeType}','$!{data.beginDate}','$!{data.endDate}')">#springMessage('common.button.view')</a></td>
            </tr>
            #end
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bi/fbsBudgetProcessRate.list.js?_btv=${resourceVersion}"></script>
</html>
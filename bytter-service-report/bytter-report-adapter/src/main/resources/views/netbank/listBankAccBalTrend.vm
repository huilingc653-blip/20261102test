<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        table.fixedHeader-floating.table-dark {background-color:#262936!important;display:none!important;}
    </style>
</head>
<body>
<form class="layui-form " method="post" id="searchForm">
    <input id="curId" name="curId" type="hidden"value="$!{currencyTag.getNatualCurrency().id}">
 #*   <input type="hidden" id="corpIdHidden" name="corpId" value="${corpId}"/>*#
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="10%">#springMessage('table.bankAccBalTrend.corpId')</td>
            <td width="20%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="ins_corpId"
                         data-type="selectTree"
                         data-name="corpId"
                         data-defaultvalue="${corpId}"
                         data-resource="netbank:report:bankaccbaltrend:query"
                         data-scope="all"></div>
                </div>
            </td>
        ##日期
            <td class="textRight" width="10%">#springMessage('table.bankAccBalTrend.balDate')</td>
            <td width="30%">
##                <input type="text" name="seachBeginDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="endDate" data-today="true" data-biz-name="seachBeginDate" >
##                <span class="date-mid">~</span>
##                <input type="text" name="seachEndDate" class="layui-input bt-input-inline bt-biz-dateType" id="endDate" data-today="true" data-biz-name="seachEndDate">
                <input type="text" name="seachEndDate" class="layui-input bt-input-inline bt-biz-dateType" id="endDate" data-today="true" data-biz-name="seachEndDate">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button type="button" class="layui-btn" onclick="search()">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    <table id="appTable"  style="width:100%;display: none" class="layui-table layui-form">
        <thead>
        <tr>
            <th></th>
            <th>#springMessage('table.bankAccBalTrend.corpId')</th>
            <th>#springMessage('table.bankAccBalTrend.balDate')</th>
            <th>#springMessage('table.bankAccBalTrend.curId')</th>
            <th>#springMessage('table.bankAccBalTrend.bal')</th>
            <th>#springMessage('table.bankAccBalTrend.budgetMoney')</th>
            <th>#springMessage('table.bankAccBalTrend.lastBal')</th>
            <th>#springMessage('table.bankAccBalTrend.compareRate')</th>
        </tr>
        </thead>
    </table>

<div id="chartSum" style="width:75%;height:500px; float:left;"></div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bi/bankAccBalTrend.list.js?_btv=${resourceVersion}"></script>
</html>
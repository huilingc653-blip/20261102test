<!DOCTYPE html>
#set($basePath=$springMacroRequestContext.contextPath)
<html>
<head>
    <meta charset="utf-8">
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no,minimum-scale=1.0,maximum-scale=1.0">
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <title>信贷融资</title>
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css"/>
    <link rel="stylesheet1" href="${basePath}/static/plugins/frozen/css/base.css" />
    <link rel="stylesheet" href="${basePath}/static/css/mobile/index.css"/>
    <style>
        .popup-block * {
            font-size: 0.14rem;
        }
        .bt-select-popup {
            position: relative;
            margin-right: 10px;
        }
        .bt-select-popup input {
            border: none;
            width: 0.58rem;
            height: 0.32rem;
            background-color: #F5F5F5;
            border-radius: 0.16rem;
            padding: 0 0.15rem;
            /*width: 0.36rem;;*/
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 600;
            color: rgba(102, 102, 102, 1);
        }
        .bt-select-popup.active input {
            color: #2988FF;
            background-color: #E9F1FF;
        }

        .bt-select-popup.active:after {
            color: #2988FF;
        }

        /*网格一排三个选择*/
        .bt-card {
            background-color: #fff;
        }
        .bt-card .active {
            color:#2988FF;
            font-weight:700;
        }
        .bt-card-header {
            font-size:0.14rem;
            font-family:PingFangSC-Medium,PingFang SC;
            font-weight:700;
            color:rgba(51,51,51,1);
            line-height:0.35rem;
            height: 0.35rem;
            padding-left: 0.15rem;
            text-align: left;
        }
        .bt-card-body {
            padding-bottom: 0.15rem;
        }
        .bt-card-item {
            height:0.34rem;
            background:rgba(240,240,240,1);
            border-radius:0.18rem;
            line-height: 0.34rem;
            text-align: center;
            margin: 0.05rem 0.1rem 0.05rem 0;
            font-size:0.14rem;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(102,102,102,1);
        }
        .bt-card-body .ui-col:nth-last-child(1) .bt-card-item {
            margin-right: 0;
        }
        /*浮框的按钮*/
      /*  .bt-popup-bottom button {
            height: 0.4rem;
            line-height: 0.4rem;
            border-radius: 0.2rem;
            font-size: 0.16rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            margin: 0 0.08rem;
        }

        .bt-popup-bottom .bt-popup-submit {
            width: 2.1rem;
            background: linear-gradient(90deg, rgba(75, 226, 255, 1) 0%, rgba(50, 104, 249, 1) 100%);
            color: rgba(255, 255, 255, 1);
        }

        .bt-popup-bottom .bt-popup-reset {
            width: 1.1rem;
            background: rgba(255, 255, 255, 1);
            border: 1px solid rgba(212, 212, 212, 1);
            color: rgba(102, 102, 102, 1);
        }

        .bt-popup-bottom {
            background-color: #ffffff;
            position:relative;
        }*/

        .bt-popup-container {
            position: relative;
            background-color: #fff;
            /*max-height: calc(100% - 1.8rem);*/
            /*padding-bottom: 0.6rem;*/
            overflow-y: auto;
        }

        .left-title{
            width:128px;
            height:16px;
            font-size:16px;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(51,51,51,1);
            line-height:16px;
        }
        .right-title{
            width:112px;
            height:16px;
            font-size:16px;
            font-family:PingFangSC-Semibold,PingFang SC;
            font-weight:600;
            color:rgba(41,136,255,1);
            line-height:16px;
        }
        .cms-sign{
            background:rgba(233,241,255,1);
            border-radius:0.16rem;
            margin-left:-0.90rem;
            left: 0.78rem;
        }
        .cur-id{
            height:0.32rem;
            background:rgba(245,245,245,1);
            border-radius:0.16rem;
            left: 0.5rem;
        }
        .date-id{
            height:0.32rem;
            background:rgba(245,245,245,1);
            border-radius:0.16rem;
            left: 0.5rem;
        }
        .cms-title{
            font-size:0.16rem;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(51,51,51,1);
            line-height:0.17rem;
        }
        .yuan{
            font-size:0.12rem;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(153,153,153,1);
            line-height:0.12rem;
            margin-left: 3rem;
            padding-top: 0.05rem;
        }
        .dtl-title{
            font-size:0.16rem;
            font-family:PingFangSC-Semibold,PingFang SC;
            font-weight:600;
            color:rgba(41,136,255,1);
            line-height:0.16rem;
        }
        .cms-tab-title > div {
            display: inline-block;
            width:0.7rem;
            height:0.31rem;
            border-radius:0.16rem;
            border:1px  rgba(105,164,255,1);
        }
        .sum-money{
            width:1.92rem;
            height:0.31rem;
            font-size:0.30rem;
            font-family:DINAlternate-Bold,DINAlternate;
            font-weight:bold;
            color:rgba(41,136,255,1);
            line-height:0.28rem;
        }
        .query-date{
            width:1.26rem;
            height:0.12rem;
            font-size:0.12rem;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(153,153,153,1);
            line-height:0.12rem;
        }
        .cms-tab-body {
           /* height: calc(100vh - 3rem)*/
            height: 2.15rem!important;
            overflow-y: auto;
            padding-left: 0.05rem;
        }
        .ui-whitespace{
            padding-top:0.16rem;
        }
        .corp-name{
            height:0.26rem;
            font-size:0.14rem;
            font-family:PingFangSC-Medium,PingFang SC;
            font-weight:700;
            color:rgba(51,51,51,1);
            line-height:0.26rem;
        }
        .res-date{
            width:1.05rem;
            height:0.10rem;
            font-size:0.10rem;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(153,153,153,1);
            line-height:0.10rem;
        }
        .cms-cycle {
            width:0.08rem;
            height:0.08rem;
            display: inline-block;
            border-radius: 50%;
        }
        .d-sign{
            background:rgba(95,137,248,1);
        }
        .t-sign{
            background:rgba(91,243,185,1);
        }
        .l-sign{
            background:rgba(248,212,38,1);
        }
        .s-sign{
            background:rgba(253,125,57,1);
        }
        .cms-popup-body {
            background-color: #fff;
            position: relative;
        }
        .sp-tab-switch {
            width:3.12rem;
            height:0.3rem;
            border-radius:0.15rem;
            border:1px solid #6A7088;
            display:inline-block;
            text-align:center;
            margin:0 auto;
        }
        .sp-rat-tab {
            padding: 0 0.15rem;
            height:0.3rem;
            border-radius:0.15rem;
            border:none;
            font-size:0.12rem;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(102,102,102,1);
            line-height:0.3rem;
            display:inline-block;
            float:left;
        }
        .sp-rat-tab1 {
            position: absolute;
            left: -0.01rem;
        }
        .sp-rat-tab.active {
            background:rgba(105,164,255,1);
            /*border:1px solid rgba(105,164,255,1);*/
            color:#fff;
            line-height: 0.3rem;
        }
        .money-type{
            width:0.56rem;
            height:0.14rem;
            font-size:0.14rem;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(51,51,51,1);
            line-height:0.14rem;
        }
        .money-dtl{
            width:1.25rem;
            height:0.14rem;
            font-size:0.14rem;
            font-family:PingFangSC-Semibold,PingFang SC;
            font-weight:600;
            color:rgba(51,51,51,1);
            line-height:0.14rem;
        }
        .ui-sp-btn > input{
            /*margin-left: 0.01rem;*/
            font-size: 0.12rem;
            font-family:苹方-简 常规体;
            font-weight:400;
            color:#333333;
            width: 1.11rem;
        }
        .ui-sp-boder{
            width:30px;
            height:1px;
            background:rgba(211,211,211,1);
            margin: 0.15rem 0.1rem
        }
        .ui-form-item input{
            padding-left: 0.16rem;
        }
        .startDateDIV{
            width:110px;
            height:30px;
            background:rgba(246,246,246,1);
            border-radius:15px;
        }
        .cms-selectTitle {
            width: 0.56rem;
            height: 0.14rem;
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 600;
            color: rgba(51, 51, 51, 1);
            line-height: 0.14rem;
        }
        .cms-date-input {
            background-color: #f3f3f3!important;
        }
        .bt-card-header {
            padding-left: 0.15rem;
        }
        .ui-searchbar {
            margin: 0 0.15rem;
        }
        .cms-popup-container {
            height: calc(100% - 1.65rem);
            overflow-y: auto;
        }
        .bt-select-popup {
            margin: 0;
        }
        #tab > div {
            text-align: center;
            padding-top: 0.08rem;
            padding-bottom: 0.07rem;
        }
        #tab {
            background-color: #fff;
        }
        .cms-total-money {
            background-color: #F5F5F5;
            padding-bottom: 0.04rem;
        }

    </style>
</head>
<body>
    #*<header class="bt-header-title" style="border:0px dashed #000; height:0.44rem;width:100%">
        <div class="ui-col">
            <li class="ui-border-b">信贷融资</li>
        </div>
    </header>*#

    #*<div class="ui-tab">
        <div class="ui-tab-nav-wrap">
            <div class="ui-tab ">
                <ul class="ui-tab-nav ui-border-b" data-id="cms-body">
                    <li class="left-title" style="width: 1.8rem;"><span>授信额度综合统计</span></li>
                    <li class="right-title current" style="width: 1.8rem;"><span>融资余额汇总</span></li>
                </ul>
            </div>
        </div>
    </div>*#
    <input id="startDate" value="$!{startDate}" type="hidden"/>
    <input id="endDate" value="$!{endDate}" type="hidden"/>
##    <input id="corpId" value="$!{corpId}" type="hidden"/>

    <form id="inputForm">
        <input type="hidden" id="statisticsMonth" name="statisticsMonth" value=""/>
        <ul class="ui-tab-content" style="width:100%" id="cms-body">
            #*<li>余额分析</li>*#
            <li class="bt-show">
                <form action="">
                    <div class="ui-row-flex">
                        <!-- 搜索框 -->
                        <div class="ui-col ui-col">
                            <div class="ui-searchbar-wrap ui-border-b">
                                <div class="ui-searchbar ui-border-radius" id="corpDiv" style="border-color:red;">
                                    <i class="ui-icon-search"></i>
                                    <div class="ui-searchbar-text">请选择单位</div>
                                    <div class="ui-searchbar-input">
                                        <input value="" id="corpId" name="corpId" type="text" placeholder="请选择单位"
                                               autocapitalize="off" readonly="readonly">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div style="width:3.75rem;height: 0.52rem;background-color:#fff;">
                        <div class="ui-btn-wrap">

                            <div class="bt-select-popup" style="">
                                <input type="text" value="融资方式" id="btn1" readonly="readonly" style="width:0.74rem;">
                            </div>
                            <div class="bt-select-popup" style="margin-right: 0.3rem;margin-left: 0.3rem;">
                                <input type="text" value="币别" id="btn2" readonly="readonly"  style="width: 0.6rem;">
                            </div>
                            <div class="bt-select-popup">
                                <input type="text" value="日期" id="btn3" readonly="readonly"  style="width: 0.6rem;">
                            </div>

                            <div class="popup-block">
                                <div class="ui-actionsheet" id="actionsheet1" style="height:calc(100% - 1.9rem);top:1.9rem;" data-link="btn1">
                                    <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 0.9rem;">
                                        <section class="bt-popup-container cms-popup-container">
                                            <div class="bt-card" id="currency">
                                                <div class="bt-card-header">
                                                    融资方式
                                                    <input type="hidden" id="cmsSign" name="loanSign" value="">
                                                </div>
                                                <div class="bt-card-body">
                                                    <div class="ui-row-flex ui-whitespace">
                                                        <div class="ui-col ui-col"><div class="bt-card-item" data-value="01" >内部贷款</div></div>
                                                        <div class="ui-col ui-col"><div class="bt-card-item" data-value="02">银行借款</div></div>
                                                        <div class="ui-col ui-col" ><div class="bt-card-item" data-value="03">委托贷款</div></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>
                                        <div class="bt-popup-bottom">
                                            <button type="button" id="clearValue" class="bt-popup-reset resetBtn">重置</button>
                                            <button type="button" class="bt-popup-submit submitBtn" id="submitValue">确定</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="popup-block">
                                <div class="ui-actionsheet" id="actionsheet2" style="height:calc(100% - 1.9rem);top:1.9rem;" data-link="btn2">
                                    <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 0.9rem;">
                                        <section class="bt-popup-container cms-popup-container">
                                            <div class="bt-card" id="currency1">
                                                <div class="bt-card-header">
                                                    币别选择
                                                    <input type="hidden" id="curId"name="curId" value="">
                                                </div>
                                                ##vcount 下标   velocityCount length
                                                <div class="bt-card-body">
                                                    #foreach($cur in $curList)
                                                        #set($vcount = $velocityCount - 1)
                                                        #set($velocityCount = $curList.size() - 1)
                                                        #if($!{vcount}%3 == 0)
                                                            <div class="ui-row-flex ui-whitespace">
                                                        #end
                                                        <div class="ui-col ui-col">
                                                            <div class="bt-card-item" data-value="$!{cur.id}">$!{cur.curName}</div>
                                                        </div>
                                                        #if($!{vcount}%3 != 0)
                                                            #if(($!{vcount}+1)%3 == 0)
                                                                </div>
                                                            #end
                                                        #end
                                                        #if($!{vcount} == $!{velocityCount})
                                                            #if(($!{vcount})%3 == 0)
                                                                <div class="ui-col ui-col"></div>
                                                                <div class="ui-col ui-col"></div>
            ##                                                </div>
                                                            #end
                                                            #if(($!{vcount})%3 > 0)
                                                                <div class="ui-col ui-col"></div>
            ##                                                </div>
                                                            #end
                                                        </div>
                                                        #end
                                                    #end
                                                </div>
                                        </section>
                                        <div class="bt-popup-bottom">
                                            <button type="button" id="clearValue1" class="bt-popup-reset resetBtn">重置</button>
                                            <button type="button" class="bt-popup-submit submitBtn" id="submitValue1">确定</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            ##日期控制
                            <div class="popup-block">
                                <div class="ui-actionsheet" id="actionsheet3" style="height:calc(100% - 1.9rem);top:1.9rem;" data-link="btn3">
                                    <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 0.9rem;">
                                        <section class="bt-popup-container cms-popup-container">
                                            <div class="bt-card" id="checkDate">
                                                <div class="bt-card-header">
                                                    日期选择
                                                </div>
                                                <div class="bt-card-body">
                                                    <div class="ui-form-item" style="height: 0.36rem; margin-top: 0.15rem;">
                                                       ## <div><label class="cms-selectTitle" style="line-height: 0.1rem;height: 0.3rem;margin-top: 0.10rem;margin-left: 0.02rem">发放日</label></div>
                                                        <div class="ui-sp-btn">
                                                            <input type="text" class="startDateDIV cms-date-input" id="startDateBegin" name="startDate" readonly="readonly" placeholder="开始时间"/>
                                                        </div>
                                                        <div class="ui-sp-boder" style="margin-top: 0.22rem;"></div>
                                                        <div class="ui-sp-btn">
                                                            <input type="text" class="startDateDIV cms-date-input" id="startDateEnd" name="endDate" readonly="readonly" placeholder="结束时间"/>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>
                                        <div class="bt-popup-bottom">
                                            <button type="button" id="clearValue3" class="bt-popup-reset resetBtn">重置</button>
                                            <button type="button" id="submitValue3" class="bt-popup-submit submitBtn">确定</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </form>
            </li>
        </ul>
    </form>

    <div style="width:3.75rem;background-color:#fff;">
        <div style="padding-top: 0.19rem;">
            <div class="fl bt-chart-title-left cms-title" style="margin-left: 0.2rem" id="titleName">融资概览($!{curName})</div>
            <div class="ui-searchbar-text yuan" >单位:元</div>
        </div>
        <section id="tab" class="ui-container" style="padding-top: 0.15rem">
            <div>
                <div class="ui-tab ">
                    <ul class="ui-tab-content" style="width:100%">
                        <li class="bt-show">
                            <section class="cho-body ui-container-title">
                                <section id="tab">
                                    <div class="cho-rat-item" align="center">
                                        <div class="sp-tab-switch" align="center" style="position: relative">
                                            <span id="resetBtn" class="sp-rat-tab sp-rat-tab1 active" data-name="befor">期初余额</span>
                                            <span class="sp-rat-tab" data-name="shou" style="margin-left: 0.78rem;">融资收入</span>
                                            <span class="sp-rat-tab" data-name="zhi">融资支出</span>
                                            <span class="sp-rat-tab" data-name="balance" style="position: absolute;right:-0.01rem;">期末余额</span>
                                        </div>

                                    </div>
                                </section>
                            </section>
                            <section class="cho-body ui-container-content ui-border-b cho-content-model cms-total-money">
                                <section id="tab">
                                    <div id="befor" style="text-align: center;padding-top: 0.08rem;">
                                        <span class="sum-money" id="yesterSum">$number.formatNumeric($!{yesterBalance})</span><br>
                                        <span class="query-date">$!{searchDate}</span>
                                    </div>
                                    <div id="shou" style="display: none;">
                                        <span class="sum-money" id="earningSum">$number.formatNumeric($!{earningMoney})</span><br>
                                        <span class="query-date">$!{searchDate}</span>
                                    </div>
                                    <div id="zhi" style="display: none;">
                                        <span class="sum-money" id="defraySum">$number.formatNumeric($!{defrayMoney})</span><br>
                                        <span class="query-date">$!{searchDate}</span>
                                    </div>
                                    <div id="balance" style="display: none;">
                                        <span class="sum-money" id="balSum">$number.formatNumeric($!{balance})</span><br>
                                        <span class="query-date">$!{searchDate}</span>
                                    </div>
                                </section>
                             </section>
                        </li>
                    </ul>
                </div>
            </div>
         </section>
    </div>

    <div style="padding-bottom: 0.08rem;width:3.75rem;height: auto;padding-top: 0.05rem;">##background: rebeccapurple
        <div class="ui-tab" style="background-color:#fff;height: auto;">
            <ul class="ui-tab-nav dtl-title" data-id="dtl-body">
                <li class="current" style="left: -0.15rem;" id="pro"><span>银行借款</span></li>
                <li style="left: -0.4rem;" id="pre"><span>委托贷款</span></li>
                <li style="left: -0.6rem;" id="loan"><span>内部贷款</span></li>
            </ul>
            <ul class="ui-tab-content ui-row" style="width:100%;" id="dtl-body">
                <li class="bt-show cms-tab-body" id="provideDtl">
                    #if("[]" != $!{provideList})
                        #foreach($pro in $!{provideList})
                            <div class="ui-row-flex ui-whitespace">
                                <div class="ui-col ui-col">
                                    <span class="corp-name" id="dtlCorpName">$!{pro.corpName}</span>
                                </div>
                                <div class="ui-col ui-col" style="text-align: right">
                                    <span class="res-date" id="dtlSearchDate">$!{searchDate}</span>
                                </div>
                            </div>

                            <div class="ui-row-flex ui-whitespace ui-border-b">
                                <div class="ui-col ui-col">
                                    <span class="d-sign cms-cycle"></span>
                                    <span class="money-type">期初余额</span>
                                </div>
                                <div class="ui-col ui-col" style="text-align: right">
                                    <span class="money-dtl" id="dtlBeforMoney">$number.formatNumeric($!{pro.beformMoney})</span>
                                </div>
                            </div>
                            <div class="ui-row-flex ui-whitespace ui-border-b">
                                <div class="ui-col ui-col">
                                    <span class="t-sign cms-cycle"></span>
                                    <span class="money-type">融资收入</span>

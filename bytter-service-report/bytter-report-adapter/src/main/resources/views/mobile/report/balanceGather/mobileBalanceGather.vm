<script>
    (function (doc, win) {

        //initDate();
        // 用于记录页面的查询参数
        const searchParams = {
            corpId: null,
            startDate: null,
            endDate: null,
            curId: null,
            loanSign: null
        };
        window.getCreditSeach = (data)=>{
            if(typeof data == 'string') {
                searchActionCallback(JSON.parse(data))
            }else {
                searchActionCallback(data)
            }
        }
        window.getMobileBalance = (data)=>{
            if(typeof data == 'string') {
                postData(JSON.parse(data))
            }else {
                postData(data)
            }
        }

        $('.ui-tab-nav > li').on('click', function () {
            var linkId = $(this).parent('ul').data('id');
            $(this).addClass('current').siblings('li').removeClass('current');
            $('#'+linkId).find('li').removeClass('bt-show');
            $('#'+linkId).find('li').eq($(this).index()).addClass('bt-show');
        });

        //搜索框点击
        $('.ui-searchbar').on('click', function () {
            $('.ui-searchbar-wrap').addClass('focus');
            $('.ui-searchbar-input input').focus();
        });
        $('.ui-searchbar-cancel').on('click', function () {
            $('.ui-searchbar-wrap').removeClass('focus');
        });

        //搜索框
        $('.ui-icon-search').on('click', function () {
            alert("请输入查询条件");
        });

        //弹框选择
        function showPopup($this, id) {
            if( $this.parent().hasClass('active')){
                hideSheet($this);
                return
            }
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
                $this.parent().addClass('active');
            $(id).addClass('show');
        }
        //弹框隐藏
        function hideSheet($this){
            $('.ui-actionsheet').removeClass('show');
                $this.parent().removeClass('active');
        }

        $("#btn1").click(function () {
            showPopup($(this), '#actionsheet1');
        });

        $("#btn2").click(function () {
            showPopup($(this), '#actionsheet2');
        });

        $("#btn3").click(function () {
            showPopup($(this), '#actionsheet3');
        });

        $('.popup-block').on('click', '.bt-popup-item', function () {
            var linkId = $(this).parents('.ui-actionsheet').data('link');
            hidePopup($('#' + linkId));
            $('#'+linkId).val($(this).text())
            //initBal();
            //document.location.reload();
        })

        //时间选择
        $('.startDateDIV').on('click', function () {
            openDatePickerPage();
        });

        //单位选择
        $("#corpDiv").click(function () {
            openCorpSelectionPage();
        });

        //单位组件
        function openCorpSelectionPage() {
            setTimeout(function () {
              var data =  BTAppBridge.openCorpSelectionPage && BTAppBridge.openCorpSelectionPage('searchActionCallback',{
                    resource:"cms:report:loan:balancegather:query"
                });
              uni.postMessage({
                  data:data
              })
            }, 100);
        }

        //时间组件
        function openDatePickerPage() {
           var data = BTAppBridge.openDatePickerPage && BTAppBridge.openDatePickerPage('searchActionCallback');
           uni.postMessage({
               data:data
           })
        }

        /**
         * 搜索回调方法
         * @param data
         */
        window.searchActionCallback = function (data) {
            searchParams.corpId = data.corpIds;
            // 根据data参数，查询数据
            if (data.corpNames) {
                setTimeout(function () {
                  var data =  BTAppBridge.post("/mobile/report/cms/cmsbalancegather/getAppList", searchParams, 'postData');
                  uni.postMessage({
                      data:data
                  })
                }, 100);
                $("#corpId").val(data.corpNames);
            } else {
                $("#corpId").val('');
            }
            if (data.datePickData) {
                var dateObj = data.datePickData;
                var startDate = dateObj.startDate;
                var endDate = dateObj.endDate;
                var startTemp = bt.date.format(parseInt(startDate), "yyyy-MM-dd");
                $("#startDateBegin").val(startTemp);
                var endTemp = bt.date.format(parseInt(endDate), "yyyy-MM-dd");
                $("#startDateEnd").val(endTemp);
                showPopup($(this), '#actionsheet3');
            }
        }

        //点击确定
        $('.submitBtn').on('click',function(){
            var btn = $(this).parents('.ui-actionsheet').removeClass('show')
                    .data('link');
            $('#'+btn).removeClass('active');
            //确认提交
            submiteData(false);
        })

        //数据提交
        function submiteData(isInit) {
            if(searchParams.corpId == null){
                searchParams.corpId = $("#corpId").val();
            }
            searchParams.startDate = $("#startDateBegin").val();
            searchParams.endDate =  $("#startDateEnd").val();
            searchParams.curId = $("#curId").val();
            searchParams.loanSign = $("#cmsSign").val();
            setTimeout(function () {
               var data = BTAppBridge.post("/mobile/report/cms/cmsbalancegather/getAppList", searchParams, 'postData');
                uni.postMessage({
                    data:data
                })
            }, 100);
        }

        //点击重置
        $('#clearValue').on('click',function(){
            initCard('#currency','','',true);
        })
        $('#clearValue1').on('click',function(){
            initCard('#currency1','','',true);
        })
        $('#clearValue3').on('click',function(){
            $("#startDateBegin").val("");
            $("#startDateEnd").val("");
            searchParams.datePickData.startDate = null;
            searchParams.datePickData.endDate = null;
        })

        var ACTIVE = 'active';
        /**
         * id 为面板容器id
         * value　为要选择中币别
         * clickCallback
         */
        function initCard(id,value,clickCallback,isInit){
            if(!id){
                return
            }
            var $card = $(id);
            var hiddenInput = $card.find('.bt-card-header input');
            var items = $card.find('.bt-card-item');
            items.removeClass(ACTIVE);
            hiddenInput.val('');
            //设置选中值
            if(value){
                var items = $card.find('.bt-card-item');
                items.removeClass(ACTIVE);
                for( var i=0;i < items.length; i++ ){
                    if(value === $(items[i]).data('value')){
                        $(items[i]).addClass(ACTIVE);
                        break
                    }
                }
            }

            if(isInit){
                return;
            }

            $(id).on('click','.bt-card-item',function(){
                var value = '';
                if($(this).hasClass(ACTIVE)){ //如果当前被选中时，点击会取消选中
                    $(this).removeClass(ACTIVE);
                } else {
                    $card.find('.bt-card-item').removeClass(ACTIVE);
                    $(this).addClass(ACTIVE);
                    value = $(this).data('value');
                }
                hiddenInput.val(value);
                if(clickCallback){
                    clickCallback(value);
                }
                return false;
            })
        }

        //初始化
        initCard('#currency');
        initCard('#currency1');

        //切换
        $('.sp-tab-switch > span').on('click',function(){
            $(this).addClass('active').siblings('span').removeClass('active');
            var name = $(this).data('name');
            if(name=="befor"){
                $('#befor').show();
                $('#shou').hide();
                $('#zhi').hide();
                $('#balance').hide();
            }else if(name=="shou"){
                $('#shou').show();
                $('#zhi').hide();
                $('#balance').hide();
                $('#befor').hide();
            }else if(name=="zhi"){
                $('#zhi').show();
                $('#balance').hide();
                $('#befor').hide();
                $('#shou').hide();
            }else {
                $('#balance').show();
                $('#befor').hide();
                $('#shou').hide();
                $('#zhi').hide();
            }
        });

        postData = function (result) {
            var searchDay = result.searchDate;
            var provideHtml = '';
            var precativeHtml = '';
            var loanHtml = '';

            //操作成功，且有值做拼接操作
            if(result.provideList.length > 0){
                for(var i=0;i<result.provideList.length;i++){
                    var obj = result.provideList[i];
                    provideHtml += appHtml(obj,searchDay,"true");
                }
            }else {
                provideHtml += appHtml(null,null,"false");
            }

            if(result.precativeList.length > 0){
                for(var i=0;i<result.precativeList.length;i++){
                    var obj = result.precativeList[i];
                    precativeHtml += appHtml(obj,searchDay,"true");
                }
            }else {
                precativeHtml += appHtml(null,null,"false");
            }

            if(result.loanList.length > 0){
                for(var i=0;i<result.loanList.length;i++){
                    var obj = result.loanList[i];
                    loanHtml += appHtml(obj,searchDay,"true");
                }
            }else {
                loanHtml += appHtml(null,null,"false");
            }

            $("#titleName").html("融资概览("+result.curName+")");
            $("#yesterSum").html(bt.money.format(result.beformMoney));
            $("#earningSum").html(bt.money.format(result.earningMoney));
            $("#defraySum").html(bt.money.format(result.defrayMoney));
            $("#balSum").html(bt.money.format(result.balance));
            $(".query-date").html(result.searchDate);
            $("#provideDtl").html(provideHtml);
            $("#precativeDtl").html(precativeHtml);
            $("#loanDtl").html(loanHtml);
            $("#startDate").val(result.startDate);
            $("#endDate").val(result.endDate);

            if(result.loanSign == "01"){
                $("#loan").addClass("current");
                $("#loanDtl").addClass("bt-show");
                $("#pro").removeClass("current");
                $("#provideDtl").removeClass("bt-show");
                $("#pre").removeClass("current");
                $("#precativeDtl").removeClass("bt-show");
            }else if(result.loanSign == "02"){
                $("#pro").addClass("current");
                $("#provideDtl").addClass("bt-show");
                $("#pre").removeClass("current");
                $("#precativeDtl").removeClass("bt-show");
                $("#loan").removeClass("current");
                $("#loanDtl").removeClass("bt-show");
            }else if(result.loanSign == "03"){
                $("#pre").addClass("current");
                $("#precativeDtl").addClass("bt-show");
                $("#pro").removeClass("current");
                $("#provideDtl").removeClass("bt-show");
                $("#loan").removeClass("current");
                $("#loanDtl").removeClass("bt-show");
            }
        }

        function appHtml(obj,searchDay,sign) {
            var appendContent='';
            if(sign == "true") {
                appendContent += '<div class="ui-row-flex ui-whitespace">';
                appendContent += '    <div class="ui-col ui-col">';
                appendContent += '        <span class="corp-name">' + obj.corpName + '</span>';
                appendContent += '    </div>';
                appendContent += '    <div class="ui-col ui-col" style="text-align: right">';
                appendContent += '        <span class="res-date">' + searchDay + '</span>';
                appendContent += '     </div>';
                appendContent += '</div>';
            }


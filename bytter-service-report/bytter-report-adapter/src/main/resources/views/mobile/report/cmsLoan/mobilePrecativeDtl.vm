<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>融资详情</title>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <script>var basePath = "${basePath}"</script>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no,minimum-scale=1.0,maximum-scale=1.0">
    <link rel="stylesheet" href="$!{basePath}/static/mobile/plugins/fixedTable/table.min.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="$!{basePath}/static/plugins/frozen/css/frozenui.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="$!{basePath}/static/css/mobile/index.css?_btv=${resourceVersion}">
    <style>
        html {
            font-size: 26.66667vw;
        }

        body {
            background: #fff;
        }

        .bt-chart-container {
            margin: 0.2rem;
        }

        .popup-block * {
            font-size: 0.14rem;
        }

        .container {
            height: calc(100% - 100px);
            overflow-y: auto;
        }

        .ui-tab-nav-multi li {
            display: inline;
        }

        input::-webkit-input-placeholder {
            color: #666;
        }

    </style>
</head>
<body>
##委托贷款
<section id="tab" class="ui-container">
    <div style="margin-bottom: 0.1rem;height: calc(100vh - 0.2rem)">
        <div id="sp-list" class="data-table">
            <div class="t_l" style="width: 100px">
                <!--1.1 冻结列表头-->
                <table style="100%">
                    <tbody>
                    <tr>
                        <th>委托单据号</th>
                    </tr>
                    </tbody>
                </table>
                <!--1.2 冻结列表体-->
                <div class="t_l_freeze" style="width: 100px">
                    <table width="100%">
                        <tbody>
                            #foreach($item in $!{dtlData})
                            <tr>
                                <td>$!{item.billCode}</td>
                            </tr>
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="t_r"">
            <!--2.1　冻结行表头-->
                <div class="t_r_t">
                    <table style="width: 1200px">
                        <tbody>
                        <tr>
                            <th>委托人</th>
                            <th>受委托人</th>
                            <th>借款人</th>
                            <th>委托合同号</th>
                            <th>发放申请单号</th>
                            <th>币种</th>
                            <th>贷款金额</th>
                            <th>贷款日期</th>
                            <th>还款日期</th>
                            <th>贷款年限</th>
                            <th>发放金额</th>
                            <th>还款在途金额</th>
                            <th>已还款金额</th>
                            <th>余额</th>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <!--2.2 表格中心内容区域-->
                <div class="t_r_content">
                    <table style="width: 1200px">
                        <tbody>
                            #foreach($item in $!{dtlData})
                            <tr>
                                <td>$!{item.precativeName}</td>
                                <td>$!{item.corpName}</td>
                                <td>$!{item.loanOppName}</td>
                                <td>$!{item.contractCode}</td>
                                <td>$!{item.sendBillCode}</td>
                                <td>$!{item.curName}</td>
                                <td style="text-align: right;">$!number.formatNumeric($!{item.money})</td>
                                <td>$!{item.startDate}</td>
                                <td>$!{item.endDate}</td>
                                <td>$!{item.term}$!dictTag.get("PrecativeLoanInfo.ternUnit",$!{item.ternUnit})</td>
                                <td style="text-align: right;">$!number.formatNumeric($!{item.sendMoney})</td>
                                <td style="text-align: right;">$!number.formatNumeric($!{item.repayingMoney})</td>
                                <td style="text-align: right;">$!number.formatNumeric($!{item.repayMoney})</td>
                                <td style="text-align: right;">$!number.formatNumeric($!{item.leftMoney})</td>
                            </tr>
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
<script src="$!{basePath}/static/mobile/plugins/zepto/zepto.min.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/mobile/plugins/f2/f2.min.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/mobile/plugins/fixedTable/iscroll-probe.min.js?_btv=${resourceVersion}" id="probe"></script>
<script src="$!{basePath}/static/mobile/plugins/fixedTable/table.min.js?_btv=${resourceVersion}"></script>
<!-- 注意：如果你直接复制所有代码到本地，上述js路径需要改成你本地的 -->
</body>
</html>
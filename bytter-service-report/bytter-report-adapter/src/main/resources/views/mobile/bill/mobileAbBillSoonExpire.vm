//单位搜索组件
function openCorpSelectionPage() {
    setTimeout(function(){
        var data = BTAppBridge.openCorpSelectionPage && BTAppBridge.openCorpSelectionPage('searchActionCallback',{
        	resource:"${billSoonExpireReson}"
        });
        uni.postMessage({
			data:data
		})
    },100);
}
(function (doc, win) {
	 // 用于记录页面的查询参数
     const searchParams = {
         corpIds: [],
         corpNames: [],
         type: "0",
         billTypeName: null

     };
     waitLoading();
     //图标tab切换
     $('.sp-tab-switch > span').on('click',function(){
 	 	  $(".sp_head_vHeads").empty();
    	  var name = $(this).data('name');
    	  if($("#btn3").parent().hasClass('active')){
    		  $('.ui-actionsheet').removeClass('show');
//          	  $('.bt-select-popup').removeClass('active');
//          	  $('#sp_cycleDate').hide();
    	  }
    	  $(this).addClass('active').siblings('span').removeClass('active');
    	  if(name == 'list'){
    		  $("#sp-list").show();
    		  adjustHeight();
              initTableSize();
    		  $("#sp-map").hide();
    		  $("#sp_head_vHeads").append("数据列表");
    		  $("#sp-map").hide();
    		  $('#sp_map_view').hide();
//     		  $('#sp_cycleDate span').removeClass('active');
    		  waitLoading();
    	  }else {
    		  $("#sp-list").hide();
    		  $("#sp-map").show();
    		  adjustHeight();
              initTableSize();
    		  $("#sp_head_vHeads").append("可视化图表");
    		  $("#sp-map").show();
    		  $('#sp_map_view').show();
    		  loadViewMap();
    	  }
      });

     //切换
     $('.cho-tab-title > span').on('click',function(){
    	 if($(this).hasClass('active')){
    		 $(this).removeClass('active')
    	 }else{
    		 $(this).addClass('active')
    	 }
    	 adjustHeight();
         initTableSize();
//     	  $(this).addClass('active').siblings('span').removeClass('active');
    	  loadInfoToData();
      });

     $("#typeRest").click(function () {
     	$('#m-t-vt >div .bt-card-item').removeClass('active');
     	searchParams.billTypeName = null;
     });
     $("#busRest").click(function () {
     	$('#m-t-ct >div .bt-card-item').removeClass('active');
     	$('#yfBill').addClass('active');
     	$('#bisName').val('应付票据');
		searchParams.type = "0";
     });

     $("#submitTypeValue").click(function () {
	   	 $('.ui-actionsheet').removeClass('show');
		 $('.bt-select-popup').removeClass('active');
		 searchParams.billTypeName = $('#m-t-vt >div .bt-card-item.active').data('value');
    	 loadInfoToData();
     });

     $("#submitBusValue").click(function () {
	   	 $('.ui-actionsheet').removeClass('show');
		 $('.bt-select-popup').removeClass('active');
		 searchParams.type =$('#m-t-ct >div .bt-card-item.active').data('value');
		 $('#bisName').val($('#m-t-ct >div .bt-card-item.active').text());
		 loadInfoToData();
     });

     $('.bt-card-item').on('click',function(){
    	if($(this).data('value')=="1" || $(this).data('value')=="0"){
    		$('#m-t-ct >div .bt-card-item').removeClass('active');
    	}else{
    		$('#m-t-vt >div .bt-card-item').removeClass('active');
    	}
    	$(this).addClass('active');
     });

     //搜索框点击
     $('.ui-searchbar').on('click',function(){
         $('.ui-searchbar-wrap').addClass('focus');
         $('.ui-searchbar-input input').focus();
     });

     $('.ui-searchbar-cancel').on('click',function(){
         $('.ui-searchbar-wrap').removeClass('focus');
     });

     //搜索框
     $('.ui-icon-search').on('click',function(){
    	 loadInfoToData();
     });

     function loadInfoToData(){
    	 $('#bt-loading').show();
         setTimeout(function(){
             $('#bt-loading').hide();
	    	 if($('.sp-tab-map').hasClass('active')){
	    		 loadBillView();
	    	 }else{
	        	 loadListFormData();
	    	 }
         },500)
     }

     //弹框选择
     function showPopup($this,id,flag){
         if( $this.parent().hasClass('active')){
        	 $('.ui-actionsheet').removeClass('show');
        	 $('.bt-select-popup').removeClass('active');
        	 if(id=="#actionsheet3"){
        		 $('#sp_cycleDate').hide();
        	 }
             return
         }
         $('.ui-actionsheet').removeClass('show');
         $('.bt-select-popup').removeClass('active');
         $this.parent().addClass('active');
         $(id).addClass('show');
         if(flag){
        	 $('#sp_cycleDate').show();
        	 //加载图表数据
        	 $('#sp_map_view').show();
//         	 if(!$('.sp-tab-map').hasClass('active')){
        	 if(!$('.cho-tab-title > span').hasClass('apostBalDatactive')){
        		 $('.cho-tab-title > span').addClass('active').siblings('span').removeClass('active');
        		 $('#sp_cycleDate span').eq(0).addClass('active');
//         	 }
         	}
        	 loadInfoToData();
         }else {
        	$('#sp_cycleDate').hide();
        	 if(id=="#actionsheet3"){
        		 $('#sp_cycleDate').hide();
        		 $('#sp_map_view').hide();
        	 }
         }
     }
     $("#btn1").click(function(){
         showPopup($(this),'#actionsheet1');
     });

     $("#btn2").click(function(){
         showPopup($(this),'#actionsheet2');
     });

     $("#btn3").click(function(){
         showPopup($(this),'#actionsheet3',true);
     });

     $('.popup-block').on('click','.bt-popup-item',function(){
         var linkId = $(this).parents('.ui-actionsheet').data('link');
         $(this).addClass('active');
         $(this).addClass('active').siblings('div').removeClass('active');
         hidePopup($('#'+linkId));
         loadInfoToData();
     })

     //弹框隐藏
     function hidePopup($this){
          $('.ui-actionsheet').removeClass('show');
          $this.parent().removeClass('active');
     }

     //单位选择
     $("#corpDiv").click(function () {
         openCorpSelectionPage();
     });

     /**
      * 搜索回调方法
      * @param data
      */
     window.searchActionCallback = function (data) {
         // 根据data参数，查询数据
         if (data.corpNames && data.corpNames.length > 0) {
             searchParams.corpNames = data.corpNames;
             $("#corpId").val(data.corpNames);
         }else{
             $("#corpId").val('');
         }
         if (data.corpIds) {
             searchParams.corpIds = data.corpIds;
         }
         loadInfoToData();
     }

     F2.track(false);
     //加载图表
     function loadBillView(){
 		 var billType =$('#m-t-ct >div .bt-card-item.active').data('value');
       	 var billTypeName= $('#btn1').siblings('input').val();
       	 var buisTypeName= "0";
       	 if($('#bisName').val() == "应付票据") {
			 buisTypeName = "1";
		 }
    	 var remainMonId="";
    	 if($("#sp_cycleDate >span").hasClass('apostBalDatactive')){
//     		 $("#lastMonth").empty();
//         	 $('#lastMonth').append($('#sp_cycleDate >span.active #termName').val());
        	 $("#sp_cycleDate >span.active #termId").each(function() {
                 if(remainMonId == ''){
                 	remainMonId=$(this).val();
                 }else{
                 	remainMonId+=","+$(this).val();
                 }
             })
    	 }
         var url = "/mobile/bill/accebill/soonExpireBill/getMapAppData";
		 setTimeout(function () {
            var data = BTAppBridge.post(url,{"billTypeName":searchParams.billTypeName,"corpId":searchParams.corpIds,"billType":billType,"buisTypeName":buisTypeName,"remainMonId":remainMonId},"postBalData");
			console.log('map'+JSON.stringify(data) )
			 uni.postMessage({
				 data:data
			 })
            },100);

  	    var chart=null;
		 postBalData = function (result) {
  	    	console.log("result1"+result, result.originDate, result.dataFinal)
// 	    	alert(JSON.stringify(result.data));
 	        if(chart==null){
	 	           chart = new F2.Chart({
	        		   id: 'mountNode',
	        		   pixelRatio: window.devicePixelRatio, // 指定分辨率
	 	           });
	 	           var originDates = result.originDate;
	 	           chart.source(result.dataFinal,{
	 	        	   'corpName':{
	 	        		  type: 'cat',
	        		      tickCount: 5,
		        		  values: originDates
	 	        	   },
	 	        	   steps: { 
	 	        		  tickCount:6
	 	        	   },
	 	        	   'money':{
	 	        			tickCount: 5,
	 	        			min:0
	 	        	   }

	 	           });
	 	          chart.tooltip({
	 	        	  showItemMarker: false,
	 	        	  background: {
	 	        	    fill: '#69A4FF',
	 	        	    radius: 4,
	 	        	  },
	 	        	  valueStyle: {
	 	        	    fontSize:10,
	 	        	    fill: '#fff',
	 	        	  },
	 	        	  titleStyle: {
	 	        	    fontSize:10,
	 	        	    fill: '#fff',
	 	        	  }, // tooltip 标题的文本样式配置，showTitle 为 false 时不生效
	 	        	  nameStyle: {
	 	        	    fontSize:10,
	 	        	    fill: '#fff',

	 	        	  },
	 	         });

 	           //设置横坐标样式
 	           chart.axis('corpName', { // 横坐标样式
 	                 tickLine: { // 横坐标名字上面那个突出的小线段
 	                   length: 0,
 	                   stroke: '#EFEFEF' //小线段的颜色
 	                 },
 	                 label: function (text, index, total) {  //横坐标文字设置
 	                   return {
 	                     text: text.length > 6 ? text.substring(0, 6) + '...' : text,//内容
 	                     fill: '#666666' //字体颜色
 	                   }
 	                 },
 	                 line: {
 	                   top: true
 	                 }
 	          });

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bytter.olap.dao.CategoryDao">

    <select id="getCategoryList" resultType="com.bytter.olap.pojo.DashboardCategory">
       SELECT category_id id,category_name name FROM olap_category
       order by category_name
    </select>

    <insert id="save" parameterType="com.bytter.olap.pojo.DashboardCategory">
        <![CDATA[
        INSERT INTO olap_category(category_id,category_name) VALUES (#{id},#{name})
        ]]>
    </insert>

    <update id="update" parameterType="com.bytter.olap.pojo.DashboardCategory">
        <![CDATA[
        UPDATE olap_category SET category_name = #{name} where category_id = #{id}
        ]]>
    </update>

    <select id="countExistCategoryName" resultType="java.lang.Long">
        SELECT count(1) from olap_category where 1=1
        <if test="category_id != null" >
            <![CDATA[
            and category_id <> #{category_id}
            ]]>
        </if>
        and category_name = #{category_name}
    </select>

    <delete id="delete">
        delete from olap_category where category_id = #{0}
    </delete>
</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.bytter.olap.dao.BoardRolePermissionDao">

    <select id="getPermissionListByBoardId" resultType="com.bytter.olap.pojo.DashboardRolePermission">
        SELECT
        id,
        board_id  AS boardId,
        role_id   AS roleId
        FROM olap_role_permission
        WHERE board_id = #{boardId}
    </select>


    <insert id="save" parameterType="com.bytter.olap.pojo.DashboardRolePermission">
        insert into olap_role_permission(id, board_id, role_id)
        VALUES(#{id}, #{boardId}, #{roleId})
    </insert>


    <delete id="deleteByBatch" parameterType="java.util.List">
        delete from olap_role_permission
        where id IN
        <foreach collection="ids" item="outputId" open="(" separator="," close=")">
            #{outputId}
        </foreach>
    </delete>

    <delete id="deleteAllByBoardId">
        DELETE FROM olap_role_permission WHERE board_id = #{boardId}
    </delete>

</mapper>
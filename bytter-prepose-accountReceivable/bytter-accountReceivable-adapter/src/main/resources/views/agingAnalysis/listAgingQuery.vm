<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .submitcol-button.disabled {
            display: none;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form" style="width:100%;">
    <input id="opType" name="opType" type="hidden" value="list">
    <input type="hidden" name="type" value="$!type">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td class="textRight">#springMessage('统计维度')</td>
                        <td>
                            <div class="layui-inline">
                                <select name="dimension" lay-filter="dimensionFilterName">
                                    <option value="byCus">按客商</option>
                                    <option value="byBill">按单据</option>
                                    <option value="byContract">按交易合同</option>
                                </select>
                            </div>
                        </td>
                        ##币别
                        <td class="textRight">#springMessage('table.ratBkrationRelief.curCode')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-selectType" id="selectTypeCurId" data-url="${basePath}/basic/business/btcurrency/json"
                                     data-name="curId" data-valueField="id" data-textField="curName"
                                     data-biz-name="curId"></div><!--data-callback="clearCur"-->
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            #if($shiro.hasPermission("netbank:netBank:nisReceivable:query"))
                            <div id="byCusSearchDiv">
                                <button class="layui-btn" lay-submit lay-filter="byCusSearch" type="button">#springMessage('common.button.search')</button>
                                <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetTable">#springMessage('common.button.reset')</button>
                            </div>
                            <div id="byBillSearchDiv" style="display:none">
                                <button class="layui-btn" lay-submit lay-filter="byBillSearch" type="button">#springMessage('common.button.search')</button>
                                <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetTable">#springMessage('common.button.reset')</button>
                            </div>
                            <div id="byContractSearchDiv" style="display:none">
                                <button class="layui-btn" lay-submit lay-filter="byContractSearch" type="button">#springMessage('common.button.search')</button>
                                <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetTable">#springMessage('common.button.reset')</button>
                            </div>
                            #end
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>

<div id="byCusDiv" style="width:100%; display:none;">
<table id="byCusTable" class="layui-table layui-form" data-biz-name="byCusTable">
    <thead>
    <tr>
        <th>#springMessage('单位')</th>
        <th>#springMessage('客商')</th>
        <th>#springMessage('币种')</th>
        <th>#springMessage('应收余额')</th>
        <th>#springMessage('0-30天')</th>
        <th>#springMessage('31-60天')</th>
        <th>#springMessage('61-90天')</th>
        <th>#springMessage('90天以上')</th>
    </tr>
    </thead>
</table>
</div>

<div id="byBillDiv" style="width:100%; display:none;">
<table id="byBillTable" class="layui-table layui-form" style="width:100%;" data-biz-name="byBillTable">
    <thead>
    <tr>
        <th>#springMessage('单据编号')</th>
        <th>#springMessage('单位')</th>
        <th>#springMessage('客商')</th>
        <th>#springMessage('币种')</th>
        <th>#springMessage('应收余额')</th>
        <th>#springMessage('0-30天')</th>
        <th>#springMessage('31-60天')</th>
        <th>#springMessage('61-90天')</th>
        <th>#springMessage('90天以上')</th>
    </tr>
    </thead>
</table>
</div>

<div id="byContractDiv" style="width:100%;display:none;">
<table id="byContractTable" class="layui-table layui-form" style="width:100%;" data-biz-name="byContractTable">
    <thead>
    <tr>
        <th>#springMessage('交易合同编号')</th>
        <th>#springMessage('单据编号')</th>
        <th>#springMessage('单位')</th>
        <th>#springMessage('客商')</th>
        <th>#springMessage('币种')</th>
        <th>#springMessage('应收余额')</th>
        <th>#springMessage('0-30天')</th>
        <th>#springMessage('31-60天')</th>
        <th>#springMessage('61-90天')</th>
        <th>#springMessage('90天以上')</th>
    </tr>
    </thead>
</table>
</div>
#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/agingAnalysis/agingAnalysis.list.js?_btv=${resourceVersion}"></script>
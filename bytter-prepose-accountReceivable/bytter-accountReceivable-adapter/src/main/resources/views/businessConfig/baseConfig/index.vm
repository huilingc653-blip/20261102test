#parse("views/common/footer.vm")
<script>
    var dicts;
    bt.use(['form','jquery','rateType','moneyType','element','dicts','budgetFbsItem'], function(){
        var form = bt.form(),$  = bt.jquery;
		bt.element();
        var rateTye = bt.rateType.init();
        bt.moneyType.init();
        dicts = bt.dicts.init();
        //监听提交
        form.on('submit(configSubmit)', function(data){
            //拼接basic.remind
            var remindValues = [];
            $("input[name='basic.remind']").each(function(){
                 remindValues.push($(this).val());
            })
            data.field["basic.remind"] = remindValues.join(',');

            $.post(basePath + "/sys/config/save",data.field,function(result){
                parent.layer.alert(result.msg, {icon: result.success?1:2});
                // 页面刷新
                window.location.reload();
            },"JSON");
            return false;
        });

        var basicDefaultBudgetSelCode  = $("#basicDefaultBudgetSelCode").val();
        var budgetFbsItem = bt.budgetFbsItem.init({title: '挂接资金计划科目'});
        bt.budgetFbsItemParams = function () {
            //供应商默认不查
            budgetFbsItem.set({
                // "corpId": bt.corp.get("corpId").val() ? bt.corp.get("corpId").val() : "0",
                itemCode: basicDefaultBudgetSelCode
            });
            return true;
        }

        // 说明显示隐藏
        showDesc();

        var budgetSel1 = $("#budgetSelValue").val();
        if(1==budgetSel1) {
            $("#basicDefaultBudgetSel").attr("lay-verify","required");
        } else {
            $("#basicDefaultBudgetSel").removeAttr("lay-verify","required");
        }

        initRemindNumFun();
    });

    function budgetSelCallBack(){
        var budgetSel = dicts.get("basic.budgetSel").val();
        if(1==budgetSel) {
            $("#basicDefaultBudgetSel").attr("lay-verify","required");
        } else {
            $("#basicDefaultBudgetSel").val('');
            $("#basicDefaultBudgetSel").removeAttr("lay-verify","required");
        }
    }

    function showDesc() {
        var tip_index1 = 0;
        $('#recItem-desc').mouseenter(function () {
            tip_index1 = layer.tips(bt.lang('config.basic.recItem.desc'), '#recItem-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index1);
        });

        $('#recItem-desc2').mouseenter(function () {
            tip_index1 = layer.tips(bt.lang('到期前提醒总共可自定义4次提醒时间，到期当日默认必须提醒，不可修改。'), '#recItem-desc2', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index1);
        });
    }


    let count = 0; //用于记录已添加的提醒次数
    var remindBodyArr=new Array();
    function initRemindNumFun(){
        var initRemindNum = $("#initRemindNum").val();
        if(initRemindNum){
            count = initRemindNum-1;
            for(let i=0;i<=count;i++){
                remindBodyArr.push(i);
            }
        }
    }
    function add(){
        //最多新增4次，如需新增提醒，需删除其他提醒后再新增！
        if(remindBodyArr.length >= 4) {
            layer.msg('最多新增4次，如需新增提醒，需删除其他提醒后再新增！');
            return;
        }

        count++;
        var remindBody = document.getElementById('remindBody');
        var newtr = document.createElement('tr');
        newtr.innerHTML = `
                            <td>
                                提醒时间点
                            </td>
                            <td>
                                <span class="layui-inline">距离到期日提前</span>
                                <input type="number"
                                       class="layui-input bt-input-inline"
                                       placeholder="请输入正整数"
                                       min="1"
                                       oninput="validity.valid||(value='');"
                                       name="basic.remind"
                                       value="$dn"
                                >
                                <span class="layui-inline">天</span>
                            </td>
                            <td>
                                <a href="javascript:void(0);" onclick="add()">新增</a>
                                <a href="javascript:void(0);" onclick="del(${count})">删除</a>
                            </td>
                           `;
        remindBody.appendChild(newtr);
        remindBodyArr.push(count);
        //form.render();
        //form.renderIcon();
    }

    function del(index){
        var remindBody = document.getElementById('remindBody');
        var childNodes = remindBody.children;
        for(var i=0;i<remindBodyArr.length;i++){
            if(index==remindBodyArr[i]){
                remindBody.removeChild(childNodes[i]);
                remindBodyArr.splice(i,1);
                break;
            }
        }
    }

    $('#basicDefaultBudgetSel').blur(function(){
        // 有'('的情况下就不再赋值，回调的方法里已经赋值
        var content = $(this).val().indexOf('(');
        if(content > -1 ){
            return
        }
         $("#basicDefaultBudgetSelCode").val(content );
    })

    // 挂接资金计划科目 回调
    function budgetFbsItemCallback(data,dom) {
        /*设置 挂接资金计划科目*/
        $("#basicDefaultBudgetSel").val(data.itemNameStr);
        $("#basicDefaultBudgetSelCode").val(data.itemCodeStr);
    }

    function goBtwarnstrategy(){
        if(bt.isResource('fundwarn:warnstrategy:op')){
            if(bt.navtab){
                bt.navtab.addNavtab(bt.lang('预警策略'),basePath + "/fundwarn/btwarnstrategy/list?overdueWarn=1");
                return;
            }
            parent.layer.open({
                type: 2,
                area: ['850px', '530px'],
                maxmin: true,
                content: basePath + "/fundwarn/btwarnstrategy/list?overdueWarn=1"
            });
        }else {
            layer.alert("无功能权限，请在柜面开通决策支持功能模块及联系管理员在决策支持的预警策略分配权限。", {icon: 2, title:bt.lang('暂无权限访问')});
        }
    }


    function closeModal() {
        document.getElementById('resetModal').style.display = 'none';
    }

    function goReset() {
        parent.layer.customConfirmV2('确定要一键重置所有参数为默认参数状态！', {icon: 2}, ['确定','取消']
        , function(index){
            parent.layer.close(index);
            bt.loading.show()
            $.ajax({
                type: "POST",
                url: basePath + "/accountReceivable/businessConfig/baseConfig/goReset",
                dataType: "json",
                success: function (result) {
                    parent.layer.alert(result.msg, {icon: result.success?1:2});
                    if(result.success){
                        if (bt.navtab) {
                            // window.location= basePath + '/accountReceivable/businessConfig/baseConfig/index'
                            location.reload();
                        } else {
                            parent.layer ? parent.layer.closeAll() : layer.closeAll();
                        }
                    }
                    bt.loading.hide()
                }
            })
     }, function () {},'listDocManageCustomStyle', '重置基础设置','', true, true);

        return false;
    }

</script>
</body>
</html>

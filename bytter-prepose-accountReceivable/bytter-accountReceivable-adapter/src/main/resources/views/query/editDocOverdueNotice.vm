<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    .layui-input-list {
        width: 100%;
        padding-right: 26px;
    }
    .layui-disabled, .layui-disabled:hover{
        color: #181818 !important;
    }
  .layui-colla-custom-item{
        margin: 10px 0;
    }
    .layui-colla-custom{
        border-left: 5px solid #C70D0D;
        padding-left: 15px;
    }
    .layui-colla-elm{
        border-bottom: 1px solid #EEEEEE;
        padding-bottom: 10px;
    }
    .layui-colla-custom-title{
        font-weight: bold;
        font-size: 14px;
        color: black;
    }
    </style>
</head>
<body>

<form class="layui-form" method="post" id="inputForm">
    <input type="hidden" name="id" id="docId" value="$!{docId}"/>
    <div class="layui-colla-custom-parent">
        <div class="layui-colla-custom-item" >
            <div class="layui-colla-content layui-show" style="margin-top: 10px;border:none;">
                <table class="layui-table ignore-required-icon isDown" id="appTable" width="100%">
                    <thead>
                    <tr>
                        <th style="display:none;">id</th>
                        <th style="display:none;">createBy</th>
                        <th>#springMessage("催收时间")</th>
                        <th>#springMessage("催收人")</th>
                        <th>#springMessage("催收结果")</th>
                        <th>#springMessage("逾期原因")</th>
                        <th>#springMessage("common.table.thead.operation")</th>
                    </tr>
                    </thead>
                    <tbody id="rowBody">
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5" style="border:0;text-align: center;" >
                                #if($shiro.hasPermission("accountReceivable:docOverdueNotice:update"))
                                    <button class="layui-btn" type="button" onClick="closecurrent();" style="background-color: #d2d2d2;border-radius: 2px;font-family: FZLTHIW;color: #25262b;">#springMessage('返回')</button>
                                    <button class="layui-btn" lay-submit lay-filter="submit" type="button" style="background-color: #C70D0D;border-radius: 2px;font-family: FZLTHIW;color: #fff;">#springMessage( '保存')</button>
                                #end
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</form>
#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/query/docOverdueNotice.edit.js?_btv=${resourceVersion}"></script>

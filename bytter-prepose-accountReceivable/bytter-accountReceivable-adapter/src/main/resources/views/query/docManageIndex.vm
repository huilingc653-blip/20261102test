<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <link rel="stylesheet"
          href="${basePath}/static/v3.2/fonts/fonts2/iconfont.css?_btv=${resourceVersion}"
          media="all">
    <link rel="stylesheet"
          href="${basePath}/static/modules/bi/statics/homeBankAccBalDistribute.css?_btv=${resourceVersion}"
          media="all">
    <style>
        .receivableHeader-flex,.receivables-bg{
            display:flex;
        }

        .receivableHeader-flex > div, .receivables-bg > div{
            flex: 1;
            padding-top:10px;
        }
        .receivableHeader-flex  .receivables-bg {
            flex: 2;
        }

        .receivables-bg {
            background-image: linear-gradient(156deg, #FFE6E6 0%, #FFFFFF 96%);
            border-radius: 4px;
            height:72px;
        }
        .receivables-bg > div {
            padding-left:32px;
             padding-top:0;
        }
        .receivableHeader-flex > div > div:first-child,.receivables-bg > div > div:first-child{
            font-size:24px;
            font-family: DINAlternate-Bold;
            color: #181818;
            line-height: 32px;
            margin-bottom:4px;
        }
        .receivableHeader-flex > div > div:last-child,.receivables-bg > div > div:last-child{
            font-size:14px;
            color: #999999;
            line-height: 22px;
        }
        .chart-container{
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
        }
        .legend-item{
            display: flex;
            align-item: center;
            margin-bottom: 15px;
            width: 100%;
        }
        .legend-color{
            width: 16px;
            height: 16px;
            border-radius: 3px;
            margin-right: 10px;
            flex-shrink: 0; /* 防止颜色块被压缩*/
        }
        .legend-text{
            font-size: 14px;
            color: #333;
            width: 120px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .legend-percent{
            font-size: 16px;
            color: #333;
            margin-left: auto;
            text-align: left;
            min-width: 50px;
        }
        .chartArDocTypeDist{
            width: 100%;
            height: 100%;
        }
        #agingCustomTooltip {
            position: absolute;
            display: none;
            background: #fff;
            border: 1px solid #ddd;
            padding: 10px;
            border-radius: 4px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            z-index: 9999;
            pointer-events: auto;
            width: 160px;
            height: 80px;
            /*自动换行*/
            word-wrap: break-word;
            overflow-wrap: break-word;
            white-space: normal;
        }
        #tooltipLink {
            color: #C70D0D;
            text-decoration: underline;
            cursor: pointer;
        }
        #customerNameTooltip {
            position: absolute;
            display: none;
            background: #fff;
            border: 1px solid #ddd;
            padding: 10px;
            border-radius: 4px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            z-index: 1000;
            pointer-events: none; /*auto 改为none，通常工具提示不需要响应鼠标事件*/
            width: 160px;
            /*height: 10px;*/
            /*自动换行*/
            word-wrap: break-word;
            overflow-wrap: break-word;
            white-space: normal;
        }
        #chartARTrendTooltip {
            position: absolute;
            display: none;
            background: #fff;
            border: 1px solid #ddd;
            padding: 10px;
            border-radius: 4px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            z-index: 9999;
            pointer-events: auto;
            width: 160px;
            height: 10px;
        }
        #chartArDocTooltip {
            position: absolute;
            display: none;
            background: #fff;
            border: 1px solid #ddd;
            padding: 10px;
            border-radius: 4px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            z-index: 9999;
            pointer-events: auto;
            width: 160px;
            height: 10px;
        }
        .clickable:hover {
            cursor: pointer;
            text-decoration: underline;
            text-decoration-thickness: 2px;
            text-underline-offset: 4px;
        }
        .article-empty img {
            width: 80px;
            margin-top: 80px;
        }
    </style>
</head>
<body class="${shiro.getPrincipal().sysSkin}">
<input id="uiStyle" name="uiStyle" type="hidden" value="$!{configTag.getConfig('sys','uiStyle')}">
<div class="panel-wrapper" style="padding-top:0; height: 100vh;">
    <div class="header-panel header-height layui-form" style="display:none;">
        ##浅色：文字：#9497AC  边线：#EBEDF1
        ##深色：文字：#797979  边线：#2E2F34
        ##边线颜色
        <input id="lineColor" name="lineColor" type="hidden"
               #if($shiro.getPrincipal().sysSkin == 'dark-skin')
        value="#2E2F34"
        #else
        value="#EBEDF1"
        #end
        >
        ##文字颜色
        <input id="textColor" name="textColor" type="hidden"
               #if($shiro.getPrincipal().sysSkin == 'dark-skin')
        value="#797979"
        #else
        value="#9497AC"
        #end
        >
        <input id="curId" name="curId" type="hidden" value="$!{currencyTag.getNatualCurrency().id}">
        <input id="bal" name="bal" type="hidden" value="$!{curBal.bal}">
        <input id="standardBal" name="standardBal" type="hidden" value="$!{curBal.standardBal}">
        <input id="foreignBal" name="foreignBal" type="hidden" value="$!{curBal.foreignBal}">
        <div class="panel-left header-height">
            ## #springMessage('应收款分析')
        </div>
    </div>

    <div class="layui-row layui-col-space20 report-wrapper" style="height: 133px;">
        <div class="layui-col-lg12 layui-col-sm12 layui-col-xs12" style="width: 64%;">
            <div class="card-wrapper" style="height:133px;padding-bottom:16px;">
                <div class="card-header" style="margin-bottom: 0px;">
                    <div class="layui-row">
                        <div class="layui-col-md6">#springMessage('应收账款分析(折合人民币)')</div>
                    </div>
                </div>
                <div class="card-content" style="width:100%;height: calc(100% - 22px);">
                    <div class="layui-col-md12 receivableHeader-flex">
                        <div>
                            <div><span id="writeOffBal" class="clickable" data-action="writeOffBal"></span></div>
                            <div>应收余额</div>
                        </div>
                        <div>
                            <div><span id="overdueAmount" class="clickable" data-action="overdueAmount"></span></div>
                            <div>逾期金额</div>
                        </div>
                        <div>
                            <div><span id="contractMoney" class="clickable" data-action="contractMoney"></span></div>
                            <div>合同金额</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="layui-col-lg12 layui-col-sm12 layui-col-xs12" style="width: 36%;padding-left: 0.5%;">
            <div class="card-wrapper" style="height:133px;padding-bottom:16px;">
                <div class="card-header" style="margin-bottom: 0px;">
                            #springMessage('应收账款周转分析')<i class="layui-icon" id="cycle-desc">&#xe60b;</i>
                        <div class="date-month">
                            <input type="text" class="layui-input" id="turnoverAnsDate" placeholder="~" style="">
                        </div>
                </div>
                <div class="layui-col-md12 receivableHeader-flex">
                    <div>
                        <div id="arTurnoverRatio"></div>
                        <div>应收账款周转率<i class="layui-icon" id="rule-desc">&#xe60b;</i>
                        </div>
                    </div>
                    <div>
                        <div id="averageArBalance"></div>
                        <div>平均应收账款余额（人民币）</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="layui-row layui-col-space20 report-wrapper" style="height: calc(calc(100% - 149px) * 0.55);">
        ##应收趋势分析
        <div class="layui-col-lg6 layui-col-sm6 layui-col-xs6" style="height: 100%;">
            <div class="card-wrapper" style="height: 100%;">
                <div class="card-header">
                    #springMessage('应收趋势分析')
                    <div class="date-month">
                        <input type="hidden" id="ged_receiptDate" name="ged_receiptDate" value="$!{beginDate}">
                        <input type="hidden" id="led_receiptDate" name="led_receiptDate" value="$!{endDate}">
                        <input type="text" class="layui-input" id="receiptDate" placeholder="~" style="">
                    </div>
                </div>
                <div class="card-content" style="width:100%;height: calc(100% - 28px);">
                    <div id="chartARTrendAnalysis" style="width:100%;height:100%;"></div> <!--chartBalDistribute-->
                    <div id="chartARTrendTooltip"></div>
                </div>
            </div>
        </div>
        ##应收款占比分析
        <div class="layui-col-lg6 layui-col-sm6 layui-col-xs6" style="height: 100%;">
            <div class="card-wrapper" style="height:100%;">
                <div class="card-header">
                    #springMessage('TOP10应收款比例分析')
                    <span class="select-wrapper layui-form" style="">
                        <button type="button" class="active" id="byWriteOffBalBut" style="margin-right: 9px;">#springMessage('应收余额')</button>
                        <button type="button" id="byOverDueAmountBut">#springMessage('逾期金额')</button>
                    </span>
                </div>

                <div class="card-content" style="width:100%;height: calc(100% - 28px);">
                    <div id="chartArRatio" style="width:100%;height:100%;"></div> <!--chartBalDistribute-->
                    <div id="customerNameTooltip"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="layui-row layui-col-space20 report-wrapper" style="height: calc(calc(100% - 149px) * 0.45);">
        ##应收款业务类型分布
        <div class="layui-col-lg6 layui-col-sm6 layui-col-xs6" style="height: 100%;">
            <div class="card-wrapper" style="height: 100%;">
                <div class="card-header">
                    #springMessage('应收款业务类型分布')
                </div>
                <div class="card-content chart-container" style="height: calc(100% - 42px);">
                    <div id="chartArDocTypeDist" class="chartArDocTypeDist" style="height: calc(100% - 22px); width: 95%;"></div>
                    <div id="chartArDocTooltip"></div>
                </div>
            </div>
        </div>
        ##账龄分布图
        <div class="layui-col-lg6 layui-col-sm6 layui-col-xs6" style="height: 100%;">
            <div class="card-wrapper" style="height: 100%;">
                <div class="card-header width-auto" style="height: auto;width: calc(100% - 148px);">
                    #springMessage('账龄分布图')
                </div>
                <!--<span class="select-wrapper layui-form" style="">
                    <div class="layui-inline">
                        <select name="dimension" lay-filter="dimensionFilterName">
                            <option value="byCus">按客商</option>
                            <option value="byBill">按单据</option>
                            <option value="byContract">按交易合同</option>
                        </select>
                    </div>
                </span>-->
                <div class="card-content chart-container" style="height: calc(100% - 42px);">
                    <div id="chartAgingDistribution" style="height: calc(100% - 22px); width: 95%;"></div>
                    <div id="agingCustomTooltip"></div>
                </div>
            </div>
        </div>
    </div>
</div>
#parse("views/common/footer_report.vm")
</body>
<script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/query/docManageBi.index.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
         .layui-input-list {
            width: 100%;
            padding-right: 26px;
        }
        .layui-table td{
            border: 0px;
        }
        .auto-wrap {
            white-space: pre-wrap; /* 保留空白符，允许自动换行*/
            word-wrap: break-word; /* 长单词或URL换行*/
            overflow-wrap: break-word; /* 更现代的属性*/
            word-break: break-all; /* 更激进的换行方式*/
            resize: none; /* 禁止用户调整大小*/
        }
    </style>
</head>
<body>

<form class="layui-form" method="post" id="inputForm">
    <input type="hidden" name="id" id="docId" value="$!{docId}"/>
    <table id="appTable" style="width:100%">
        <thead>
            <tr>
                <th>#springMessage('催收时间')</th>
                <th>#springMessage('催收人')</th>
                <th>#springMessage('催收结果')</th>
                <th>#springMessage('逾期原因')</th>
            </tr>
        </thead>
        <tbody></tbody>
        <tfoot>
            <tr>
                <td colspan="4" style="text-align: right;">
                    #if($shiro.hasPermission("accountReceivable:docOverdueNotice:query"))
                    <button class="layui-btn" type="button" onClick="closecurrent();">#springMessage('common.button.close')</button>
                    #end
                </td>
            </tr>
        </tfoot>
    </table>
    <!--<table class="layui-table">
        <tbody>
        <tr>
            <td colspan="4" style="text-align: center;">
                #if($shiro.hasPermission("accountReceivable:docOverdueNotice:query"))
                <button class="layui-btn" type="button" onClick="closecurrent();">#springMessage('common.button.close')</button>
                #end
            </td>
        </tr>
        </tbody>
    </table>-->
</form>
#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/query/docOverdueNotice.view.js?_btv=${resourceVersion}"></script>

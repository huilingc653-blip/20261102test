<script>
var form;
bt.use(['form', 'layedit', 'dateType','corp',"selectTableType", 'selectTable', 'bank', 'rateType','bankInfo',
    'moneyType', 'externalCorpBankAcc', 'btUpload', 'dicts','bttable','selectType', 'inputExternalCorpBankAcc'], function () {

    var $ = bt.jquery;
    form = bt.form();
    var gInfoId = $("#attachmentId").val();
    var gInfoId2 = $("#attachmentId2").val();
    var up = bt.btUpload.init({ elem: "#uploader", auto: false, hasDelete: false, hasUpload: false, isExpand: true, gid: gInfoId });
    var up2 = bt.btUpload.init({ elem: "#uploader2", auto: false, hasDelete: false, hasUpload: false, isExpand: true, gid: gInfoId2 });

    $("#tagItemDetailDiv").hide();
    // 资金计划挂接
    renderBudget()
    function renderBudget() {
            //判断付款方式是否挂资金计划
            var isBudget = $("#isBudget").val();
            if (isBudget == "1") {
                $("#tagItemDetailDiv").show();
                $genOtherHtml();
            } else {
                $("#tagItemDetailDiv").hide();
                $("#tagItemDetail").html("");

            }
        }
});

function $genOtherHtml() {
    var url = basePath + "/budget/fbsBudgetProcess/getViewItemDetail";
    var param = {
        corpId: $("#corpIdFbs").val(),
        itemCode: $("#inlInfoItem").val(),
        billNo: $("#billNoFbs").val(),
        businessName: $("#businessName").val(),
        processSysname: $("#processSysname").val(),
        processDate: $("#processDateFbs").val(),
        curId: $("#curIdFbs").val(),//币别
        type: 'select',
        date: (new Date()).getTime()
    };
    $.ajax({
        url: url, method: 'POST', data: param, async: true, success: function (json) {
            $("#tagItemDetail").html("");
            $("#tagItemDetail").html(json);
            form.render();
        }
    });
}

//跳转核销查看页面
function viewHisDetail(writeOffType,docId,batchNo,receivableMoney,paymentMeans,relationId){
    parent.layer.open({
    type: 2,
    area: ['1400px', '800px'],
    maxmin: true,
    content: basePath + "/accountReceivable/writeOff/infoApproveDetail?writeOffType="+writeOffType+"&docId="+docId+"&batchNo="+batchNo+"&money0="+receivableMoney+"&type="+paymentMeans+"&businessId="+relationId
});

}
var docId = $('#docId').val();
//跳转强制核销查看页面
function viewHisDetailV2(batchNo){
    parent.layer.open({
        type: 2,
        area: ['850px', '530px'],
        maxmin: true,
        content: basePath + "/accountReceivable/writeOff/viewHisDetailV2?docId="+docId+"&batchNo="+batchNo
    });
}
// 取消核销查看页面
function viewHisDetailV3(){
    parent.layer.open({　
        type: 2,
        area: ['900px', '600px'],
        maxmin: true,
        content: basePath + "/accountReceivable/writeOff/viewHisV?docId="+docId,
        end:function(){
            bt.datatable.refreshTable("appTableDoc");
        }
    });
}

//跳转收款单查看页面
function viewReceivable(id,writeOffType) {
    //todo 加单位权限
    if(bt.isResource('netbank:netBankQuery:nisReceivable:query')){
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('查看'), basePath + "/receivable/nisreceivable/view/" + id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['950px', '530px'],
            maxmin: true,
            content: basePath + "/receivable/nisreceivable/view/" + id
        });
    }else {
        layer.alert("无功能权限，请在柜面开通结算管理功能模块及联系管理员在结算管理的收款查询分配权限。", {icon: 2});
    }
}
//跳转收款单查看页面
function viewReceivableV2(id,writeOffType) {
    //todo 加单位权限
    if(bt.isResource('netbank:netBankQuery:nisReceivable:query')){
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('查看'), basePath + "/receivable/nisreceivable/view/" + id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['950px', '530px'],
            maxmin: true,
            content: basePath + "/receivable/nisreceivable/view/" + id
        });
    }else {
        layer.alert("无功能权限，请在柜面开通结算管理功能模块及联系管理员在结算管理的收款查询分配权限。", {icon: 2});
    }
}

</script>

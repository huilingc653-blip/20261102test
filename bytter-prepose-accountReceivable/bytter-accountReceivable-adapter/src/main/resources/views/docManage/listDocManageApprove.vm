<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input id="opType" name="opType" type="hidden" value="list">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}"/>
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td class="textRight">#springMessage('单据编号')</td>
                        <td>
                            <input type="text"name="likes_code" autocomplete="off"
                                   class="layui-input" placeholder="#springMessage('单据编号')">
                        </td>
                        <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-corp"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-tree-type="check"
                                     data-name="ins_corpId"
                                     data-resource="account:receivable:doc:manage:apply"
                                     data-scope="all"
                                     data-callback="bt.corpCallback"></div>
                            </div>
                        </td>
                        <td class="textRight">#springMessage('单据日期')</td>
                        <td>
                            <input type="text" name="ged_receiptDate" class="layui-input bt-input-inline bt-biz-dateType"
                                   data-endid="led_receiptDate">
                            <span class="date-mid">~</span>
                            <input type="text" name="led_receiptDate" class="layui-input bt-input-inline bt-biz-dateType"
                                   id="led_receiptDate">
                        </td>
                    </tr>
                    <tr>

                        <td class="textRight">#springMessage('结算方式')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="select" data-biz-name="voucherType"
                                 data-group="account.receivable.doc.voucherType" data-name="voucherType"></div>
                        </td>
                        <td class="textRight">#springMessage('账龄起算日')</td>
                        <td>
                            <input type="text" name="ged_agingDate" class="layui-input bt-input-inline bt-biz-dateType"
                                   data-endid="led_agingDate">
                            <span class="date-mid">~</span>
                            <input type="text" name="led_agingDate" class="layui-input bt-input-inline bt-biz-dateType"
                                   id="led_agingDate">
                        </td>
                        <td class="textRight">#springMessage('到期日期')</td>
                        <td>
                            <input type="text" name="ged_endDate" class="layui-input bt-input-inline bt-biz-dateType"
                                   data-endid="led_endDate">
                            <span class="date-mid">~</span>
                            <input type="text" name="led_endDate" class="layui-input bt-input-inline bt-biz-dateType"
                                   id="led_endDate">
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            #if($shiro.hasPermission("netbank:netBank:nisReceivable:query"))
                            <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                                'common.button.search')</button>
                            <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                'common.button.reset')</button>
                            #end
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('单据编号')</th>
        <th>#springMessage('单位')</th>
        <th>#springMessage('业务类型')</th>
        <th>#springMessage('单据来源')</th>
        <th>#springMessage('结算方式')</th>
        <th>#springMessage('状态')</th>
        <th>#springMessage('单据日期')</th>
        <th>#springMessage('到期日期')</th>
        <th>#springMessage('账龄起算日')</th>
        <th>#springMessage('应收金额')</th>
        <th>#springMessage('应收币种')</th>
        <th>#springMessage('客商名称')</th>
        <th>#springMessage('客商类型')</th>
        <th>#springMessage('交易合同编号')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
#workFlowHtml()
#workFlowScript()
</body>
</html>
<script src="${basePath}/static/modules/docManage/DocManageApprove.list.js?_btv=${resourceVersion}"></script>

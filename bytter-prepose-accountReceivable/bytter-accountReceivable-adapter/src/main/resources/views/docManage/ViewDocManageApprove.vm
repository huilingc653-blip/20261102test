<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<style>
    .class-td-6 td:nth-child(1),td:nth-child(3),td:nth-child(5){
        width:10% !important;
    }
    .class-td-6 td:nth-child(2),td:nth-child(4),td:nth-child(6){
        width:23% !important;
    }
    .layui-colla-custom-item{
        margin: 10px 0;
    }
    .layui-colla-custom{
        /*border-left: 5px solid #C70D0D;*/
        padding-left: 15px;
    }
    .layui-colla-elm{
        border-bottom: 1px solid #EEEEEE;
        padding-bottom: 10px;
    }
    .layui-colla-custom-title{
        font-weight: bold;
        font-size: 14px;
        color: black;
    }
</style>
<form class="layui-form" method="post" id="inputForm">
    <input type="hidden" name="busType" id="busType" value="$!{busType}"/>
    <input type="hidden" name="id" id="id" value="$!{docManage.id}"/>
    <input type="hidden" name="batchNo" id="batchNo" value="$!{batchNo}"/>
    <input type="hidden" id="taskId" name= "taskId" value="$!{taskId}">
    <input type="hidden" name="corpIdFbs" id="corpIdFbs" value="$!{docManage.corpId}"/>
    <input type="hidden" name="billNoFbs" id="billNoFbs" value="$!{docManage.code}"/>
    <input type="hidden" name="curIdFbs" id="curIdFbs" value="$!{docManage.curId}"/>
    <input type="hidden" name="processDateFbs" id="processDateFbs" value="$!{docManage.receiptDate}"/>
    ## 基本信息
    <div class="layui-colla-custom-parent">
        <div class="layui-colla-custom-item">
            <div class="layui-colla-elm">
                <div class="layui-colla-custom">
                    <span class="layui-colla-custom-title">#springMessage('基本信息')</span>
                </div>
            </div>


            <div class="layui-colla-content layui-show" style="padding: 0 35px;">
                <div>
                    <table class="layui-table class-td-6" style="border: none;margin: 0;">
                        <tbody>
                        <tr>
                            <td class="textRight">#springMessage('单据编号')</td>
                            <td >
                                $!{docManage.code}
                            </td>
                            <td class="textRight">#springMessage('业务类型')</td>
                            <td>
                                $!{docManage.batchBusTypeName}
                            </td>
                            <td class="textRight" >#springMessage('单据日期')</td>
                            <td >
                                $!date.format('yyyy-MM-dd',$!{docManage.receiptDate})
                            </td>
                        </tr>
                        <tr>
                            ##单位
                            <td class="textRight" >#springMessage('单位')</td>
                            <td class="ui-formtable-padding" >
                                $!{docManage.corpName}
                            </td>
                            <!--                        单据来源-->
                            <td class="textRight" >#springMessage('table.nisBillhead.billFrom')</td>
                            <td >
                                $dictTag.get("writeOff.docSource",$!{docManage.source})
                            </td>
                            <td class="textRight" >#springMessage('到期日期')</td>
                            <td >
                                $!date.format('yyyy-MM-dd',$!{docManage.endDate})
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight" >#springMessage('结算方式')</td>
                            <td >
                                $dictTag.get("account.receivable.doc.voucherType",$!{docManage.voucherType})
                            </td>
                            <td class="textRight" >#springMessage('账龄起算日')</td>
                            <td >
                                $!date.format('yyyy-MM-dd',$!{docManage.agingDate})
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="layui-colla-custom-item" >
            <div class="layui-colla-elm">
                <div class="layui-colla-custom">
                    <span class="layui-colla-custom-title">#springMessage('本方账户信息')</span>
                </div>
            </div>
            <div class="layui-colla-content layui-show" style="margin-top: 10px;border:none;">
                <table class="layui-table class-td-6" style="border: none;margin: 0;">
                    <tbody>
                    <tr>
                        <td class="textRight" >#springMessage('收款户名')</td>
                        <td >
                            $!{docManage.payeeAccName}
                        </td>
                        <td class="textRight"  >#springMessage('收款账号')</td>
                        <td  >
                            $!{docManage.payeeAcc}
                        </td>
                        ##本方开户行
                        <td class="textRight" >#springMessage('收款账号开户行')</td>
                        <td >
                            $!{docManage.payeeBankName}
                        </td>
                    </tr>
                    <tr>
                        ##金额
                        <td class="textRight" >#springMessage('应收金额')</td>
                        <td >
                            $!number.formatNumeric($!{docManage.receivableMoney})
                        </td>
                        ##币别
                        <td class="textRight" >#springMessage('应收币种')</td>
                        <td >
                            $!{docManage.curName}
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="layui-colla-custom-item" >
            <div class="layui-colla-elm">
                <div class="layui-colla-custom">
                    <span class="layui-colla-custom-title">#springMessage('对方账户信息')</span>
                </div>
            </div>
            <div class="layui-colla-content layui-show" style="margin-top: 10px;border:none;">
                <table class="layui-table class-td-6" style="border: none;margin: 0;">
                    <tbody>
                    <tr>
                        <td class="textRight" >#springMessage('付款户名')</td>
                        <td >
                            $!{docManage.payerAccName}
                        </td>
                        <td class="textRight" >#springMessage('付款账号')</td>
                        <td >
                            $!{docManage.payerAccNo}
                        </td>

                        <td class="textRight" >#springMessage('付款账号开户行')</td>
                        <td >
                            $!{docManage.payerBankName}
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight" >#springMessage('客商名称')</td>
                        <td >
                            $!{docManage.externalName}
                        </td>
                        ##客商类型
                        <td class="textRight" >#springMessage("table.externalCorp.externalType")</td>
                        <td >
                            $dictTag.get("external.type",$!{docManage.externalType})
                        </td>
                        <td >
                        <td >
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <!-- 日志 -->
        <div class="layui-colla-custom-item" >
            <div class="layui-colla-elm">
                <div class="layui-colla-custom">
                    <span class="layui-colla-custom-title">#springMessage('操作日志')</span>
                </div>
                <div id="tagMsg"></div>
            </div>
        </div>
        <div class="layui-colla-custom-item" >
            <div class="layui-colla-elm">
                <div class="layui-colla-custom">
                    <span class="layui-colla-custom-title">#springMessage('合同信息')</span>
                </div>
            </div>
            <div class="layui-colla-content layui-show" style="margin-top: 10px;border:none;">
                <table class="layui-table class-td-6" style="border: none;margin: 0;">
                    <tbody>
                    <tr>
                        ## 交易合同编号
                        <td class="textRight">#springMessage('交易合同编号')</td>
                        <td >
                            $!{docManage.contractCode}
                        </td>
                        <td class="textRight">#springMessage('交易合同名称')</td>
                        <td >
                            $!{docManage.contractName}
                        </td>
                        <td ></td>
                        <td ></td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('交易合同金额')</td>
                        <td >
                            $!number.formatNumeric($!{docManage.contractMoney})
                        </td>
                        <td class="textRight">#springMessage('交易合同日期')</td>
                        <td >
                            $!date.format('yyyy-MM-dd',$!{docManage.contractDate})
                        </td>
                        <td>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <div style="margin-bottom: 10px">
                <table style="width:100%">
                    <tbody>
                    <tr>
                        <td style="width:100%">
                            <div>

                                <input id="attachmentId2" name="contractAttachmentId" type="hidden" value="$!{docManage.contractAttachmentId}">
                                <div id="uploader2" class="layui-input-inline" style="width:100%"></div>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="layui-colla-custom-item" >
            <div class="layui-colla-elm">
                <div class="layui-colla-custom">
                    <span class="layui-colla-custom-title">#springMessage('发票信息')</span>
                </div>
            </div>
            <div class="layui-colla-content layui-show" style="margin-top: 10px;border:none;">
                <table class="layui-table ignore-required-icon isDown" id="editTable" width="100%">
                    <thead>
                    <tr>
                        <th>#springMessage("发票号")</th>
                        <th>#springMessage("发票代码")</th>
                        <th>#springMessage("发票票面金额")</th>
                        <th>#springMessage("不含税金额")</th>
                        <th>#springMessage("开票日期")</th>
                        <th>#springMessage("发票类型")</th>
                        <th>#springMessage("发票校验码")</th>
                    </tr>
                    </thead>
                    <tbody>
                    #if($!{docManage.invoiceVos})
                    #foreach($invoiceVo in $docManage.invoiceVos)
                    <tr>
                        <td style="text-align: center">$!{invoiceVo.number}</td>
                        <td style="text-align: center">$!{invoiceVo.code}</td>
                        <td style="text-align: center">$!number.formatNumeric($!{invoiceVo.parAmt})</td>
                        <td style="text-align: center">$!number.formatNumeric($!{invoiceVo.taxincAmt})</td>
                        <td style="text-align: center">$!date.format('yyyy-MM-dd',$!{invoiceVo.draDate})</td>
                        <td style="text-align: center">$!{invoiceVo.typeName}</td>
                        <td style="text-align: center">$!{invoiceVo.checkCode}</td>
                    </tr>
                    #end
                    #end
                    </tbody>
                </table>
            </div>
        </div>
        <div style="margin-bottom: 10px">
            <table style="width:100%">
                <tbody>
                <tr>
                    <td style="width:100%">
                        <div>
                            <input id="attachmentId" name="attachmentId" type="hidden" value="$!{docManage.attachmentId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="layui-colla-custom-item" id="tagItemDetailDiv">
        <div class="layui-colla-elm">
            <div class="layui-colla-custom">
                <span class="layui-colla-custom-title">#springMessage('资金计划')</span>
            </div>
        </div>
        <div class="layui-colla-content layui-show" style="margin-top: 10px;border:none;">
            <!-- 资金计划 -->
            ##    资金计划挂接参数
            <input type="hidden" name="isBudget" id="isBudget" value="$!{config.basic.budgetSel}">
            <input id="inlInfoItem" name="inlInfoItem" type="hidden" value="$!{config.basic.defaultBudgetSel}">
            <input id="defItemCode" name="defItemCode" type="hidden" value="$!{config.basic.defaultBudgetSel}">
            <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
            <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
            <div id="tagItemDetail"></div>
        </div>
    </div>
        <div style="text-align: center;" class="padding-top">
            <button class="layui-btn close">#springMessage('common.button.close')</button>
        </div>

</form>
</body>
#workFlowHtml()
#parse("views/common/footer.vm")
#workFlowScript()
<script>
var form,layer;
bt.use(['form', 'layedit', 'dateType','corp',"selectTableType", 'selectTable', 'bank', 'rateType','bankInfo',
    'moneyType', 'externalCorpBankAcc', 'btUpload', 'dicts','bttable','selectType', 'inputExternalCorpBankAcc'], function () {
    layer = parent ? parent.layer : layer;
    var $ = bt.jquery;
    form = bt.form();
     var gInfoId = $("#attachmentId").val();
     var gInfoId2 = $("#attachmentId2").val();
    var up = bt.btUpload.init({ elem: "#uploader", auto: false, hasDelete: false, hasUpload: false, isExpand: true, gid: gInfoId });
    var up2 = bt.btUpload.init({ elem: "#uploader2", auto: false, hasDelete: false, hasUpload: false, isExpand: true, gid: gInfoId2 });
    $("#tagItemDetailDiv").hide();
    // 资金计划挂接
    renderBudget()
    function renderBudget() {
            //判断付款方式是否挂资金计划
            var isBudget = $("#isBudget").val();
            if (isBudget == "1") {
                $("#tagItemDetailDiv").show();
                $genOtherHtml();
            } else {
                $("#tagItemDetailDiv").hide();
                $("#tagItemDetail").html("");

            }
        }
    $(".close").click(function () {
            bt.navtab.closeCurrent();
    });

   /**
     * 生成日志列表
     * @return
     */
	$genMsgHtml= function() {
		var url=basePath + "/netbank/nismessage/list/"+$('#id').val()+"/"+$("#busType").val();
        $.ajax({
            url:url,
            method: 'GET',
            async:false,
            success: function (json) {
                $("#tagMsg").html("");
                $("#tagMsg").html(json);
                form.render();
            }
        });
    }
	$genMsgHtml();


function $genOtherHtml() {
    var url = basePath + "/budget/fbsBudgetProcess/getViewItemDetail";
    var param = {
        corpId: $("#corpIdFbs").val(),
        itemCode: $("#inlInfoItem").val(),
        billNo: $("#billNoFbs").val(),
        businessName: $("#businessName").val(),
        processSysname: $("#processSysname").val(),
        processDate: $("#processDateFbs").val(),
        curId: $("#curIdFbs").val(),//币别
        type: 'select',
        date: (new Date()).getTime()
    };
    $.ajax({
        url: url, method: 'POST', data: param, async: true, success: function (json) {
            $("#tagItemDetail").html("");
            $("#tagItemDetail").html(json);
            form.render();
        }
    });
}
});
</script>
</html>
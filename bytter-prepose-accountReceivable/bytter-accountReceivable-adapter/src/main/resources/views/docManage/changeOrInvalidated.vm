<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>

<style>
    body {
        min-width: 0px !important;
    }
</style>
<body>
<form class="layui-form" method="post" id="inputForm">
    <!-- 所用账号单位代码 -->
    <input id="id" name="id" type="hidden" value="$!{id}">
    <input id="type" name="type" type="hidden" value="$!{type}">
    <!--标明变更还是，作废-->
     <input id="status" name="status" type="hidden" value="$!{status}">
     <table class="layui-table" >
         <tbody>
         <tr>
             <td class="text-right" >#springMessage("调整原因")</td>
             <td>
                 <div class="bt-biz-dict" data-type="select" id="reasonTitle" data-biz-name="reasonTitle" data-name="reasonTitle"
                      data-required="true"  data-group="account.receivable.doc.reasonTitle" data-callback="bt.reasonTitleCallback"></div>
             </td>
         </tr>
         <tr>
             <td class="text-right"><font id="fontId" color="red" type="hidden" >*</font>#springMessage("说明")</td>
             <td>
                 <textarea name="reasonContent" placeholder="请输入" maxlength="150" id="reasonContent" class="layui-textarea" style="height: 135px; width: 360px;"></textarea>
             </td>
         </tr>
         <tr>
             <td colspan="4" style="text-align: right; padding-right: 17%;">
                 <button type="button" class="layui-btn layui-btn-primary" onclick="closeForms()">#springMessage('返回')</button>
                 #if($!{type} == "2")
                    <button type="button" class="layui-btn" onclick="toChange()">#springMessage('common.button.sure')</button>
                 #else
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.sure')</button>
                 #end
             </td>
         </tr>
         </tr>
         </tbody>
     </table>

 </form>
 #parse("views/common/footer.vm")
 </body>
 <script src="${basePath}/static/modules/docManage/changeOrInvalidated.add.js?_btv=${resourceVersion}"></script>
 </html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<style>
    .a-btn-color{
       color: #2864E8 !important;
    }
    .layui-disabled, .layui-disabled:hover{
        color: #181818 !important;
    }
    .layui-colla-custom-item{
        margin: 10px 0;
    }
    .layui-colla-custom{
        /*border-left: 5px solid #C70D0D;*/
        padding-left: 15px;
    }
    .layui-colla-elm{
        border-bottom: 1px solid #EEEEEE;
        padding-bottom: 10px;
    }
    .layui-colla-custom-title{
        font-weight: bold;
        font-size: 14px;
        color: black;
    }
    .layui-input{
        width: 250px !important;
    }
    .layui-input-list {
        width: 140px !important;
        padding-right: 26px;
    }
    .bt-biz-moneyType{
        text-align:left !important;
    }
    .btn-deal-upload-file{
        height: 30px !important;
        /*color: #C70D0D !important;*/
        background: #FEFEFE !important;
        /*border: 1px solid #C70D0D !important;*/
        line-height: 30px !important;
    }
    .pull-left{
        float: none;
    }
    .pull-right{
        float: none;
    }
    .list-content{
        text-align: center;
    }
    .file-item .pull-left{
        padding-right: 0px;
    }
    .uploader-list .layui-table > thead >tr > th{
        padding: 6px 10px 6px 10px;
        font-weight: 700;
        font-size: 14px;
    }
    .layui-table > thead > tr > th {
        font-weight: normal !important;
    }
    .isDown .layui-icon{
        color: #c9c9c9;
    }
</style>
<body>
<input id="pageCurName" type="hidden" value="执行金额（原币）">
<form class="layui-form" method="post" id="inputForm">
    <!-- 所用账号单位代码 -->
    <input id="curId" name="curId" type="hidden" value="">
    <input id="accCorpId" name="accCorpId" type="hidden" value="">
    <input type="hidden" id="rowIndex" name="rowIndex" value="0">
    <input id="status" name="status" type="hidden" value="0">
    <input id="externalCode" name="externalCode" type="hidden" value="">

    <!--    资金计划-->
    <input id="timeStamp" name="timeStamp" type="hidden" value="">
    <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
    <input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
    <input id="defItemCode" name="defItemCode" type="hidden" value="$!{defItemCode}">
    ## 基本信息
    <div class="layui-colla-custom-parent">
        <div class="layui-colla-custom-parent">
            <div class="layui-colla-custom-item">
                <div class="layui-colla-elm">
                    <div class="layui-colla-custom">
                        <span class="layui-colla-custom-title">#springMessage('基本信息')</span>
                    </div>
                </div>
                <div class="layui-colla-content layui-show" style="padding: 10px 35px;">


                    <table class="layui-table" style="border: none;margin: 0;">
                        <tbody>
                        <tr>
                            ##单位
                            <td class="textRight">#springMessage('单位')</td>
                            <td class="ui-formtable-padding">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-corp"
                                         data-biz-type="corp"
                                         data-type="selectTree"
                                         data-name="corpId"
                                         data-biz-name="corpId"
                                         data-scope="all"
                                         data-resource="account:receivable:doc:manage:apply"
                                         data-required="true"
                                         data-placeholder="#springMessage('请选择')"
                                         data-callback="bt.corpCallback"></div>
                                </div>
                            </td>
                            <td class="textRight">#springMessage('业务类型')</td>
                            <td>
                                <div class="bt-biz-selectType" data-url="" data-name="batchBusType"
                                     data-biz-name="batchBusType" data-callback="busTypeCallback"
                                     data-valuefield="busId" data-textfield="busTypeName" data-search="true"
                                     data-required="required" data-beforeinit="busBefore"></div>
                            </td>
                            <td class="textRight">
                                <a class="a-btn-color" href="#" style="color:blue"
                                   onclick="setBusTypeCallBack()">设置业务类型</a>
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight">#springMessage('单据编号')</td>
                            <td>
                                <input type="text" id="code" name="code" autocomplete="off" value="$!{docManageCode}"
                                       disabled="true" class="layui-input" placeholder="#springMessage('单据编号')">
                            </td>
                            <!--                        单据来源-->
                            <td class="textRight">#springMessage('table.nisBillhead.billFrom')</td>
                            <td>
<!--                                <div class="bt-biz-dict" data-type="select" data-biz-name="source" data-required="true"-->
<!--                                     data-disabled="true" id="dmSource"-->
<!--                                     data-defaultvalue="1" data-group="writeOff.docSource" data-name="source"></div>-->
                                <input type="text" autocomplete="off" value="手工新增" style="background:#E6E9F0;"
                                       disabled="true" class="layui-input">
                                <input type="hidden" value="1" name="source">
                            </td>
                            <td class="textRight">#springMessage('结算方式')</td>
                            <td>
                                <div class="bt-biz-dict" data-type="select" data-biz-name="voucherType"
                                     data-required="true"
                                     data-group="account.receivable.doc.voucherType" data-name="voucherType"></div>
                            </td>

                        </tr>
                        <tr>
                            <td class="textRight">#springMessage('单据日期')</td>
                            <td>
                                <input type="text" name="receiptDate" lay-verify="required"
                                       class="layui-input bt-biz-dateType"
                                       data-type="date" data-name="receiptDate" data-biz-name="receiptDate"
                                       placeholder="#springMessage('请选择')"
                                       data-callback="dateCallBack">
                            </td>
                            <td class="textRight">#springMessage('账龄起算日')</td>
                            <td>
                                <input type="text" id="agingDate" name="agingDate" lay-verify="required"
                                       class="layui-input bt-biz-dateType"
                                       placeholder="#springMessage('请选择')"
                                       data-type="date" data-name="agingDate" data-biz-name="agingDate">
                            </td>
                            <td class="textRight">#springMessage('到期日期')</td>
                            <td>
                                <input type="text" name="endDate" lay-verify="required"
                                       class="layui-input bt-biz-dateType"
                                       placeholder="#springMessage('请选择')"
                                       data-type="date" data-name="endDate" data-biz-name="endDate">
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="layui-colla-custom-item">
                <div class="layui-colla-elm">
                    <div class="layui-colla-custom">
                        <span class="layui-colla-custom-title">#springMessage('本方账户信息')</span>
                    </div>
                </div>
                <div class="layui-colla-content layui-show" style="margin-top: 10px;border:none;padding: 10px 35px;">
                    <table class="layui-table" style="border: none;margin: 0;">
                        <tbody>
                        <tr>
                            ##
                            <td class="textRight">#springMessage('收款账号')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="payeeAcc" name="payeeAcc" lay-verify="tableData"
                                           data-biz-name="payeeAcc"
                                           data-name="payeeAcc"
                                           autocomplete="off" class="layui-input text payeeAcc"
                                           placeholder="#springMessage('请选择')">
                                    <table id="bankAccTable" class="hide bankAccTable">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('账号')</th>
                                            <th>#springMessage('账号名称')</th>
                                            <th>#springMessage('开户行')</th>
                                            <th>#springMessage('币别')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </div>
                            </td>
                            <td class="textRight">#springMessage('收款户名')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="payeeAccName" name="payeeAccName" readonly="readonly"
                                           autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('-')">
                                </div>
                            </td>
                            ##本方开户行
                            <td class="textRight">#springMessage('收款账号开户行')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="payeeBankName" name="payeeBankName"
                                           readonly="readonly"
                                           autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('-')">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##金额
                            <td class="textRight">#springMessage('应收金额')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="receivableMoney" name="receivableMoney"
                                           style="text-align:left !important;" lay-verify="required|number2"
                                           onkeyup=value=value.replace(/^[1-9]\d{0,11}(\.\d{1,2})?$)
                                           data-name="receivableMoney" data-biz-name="receivableMoney"
                                           autocomplete="off" class="layui-input bt-biz-moneyType inputMoney"
                                           placeholder="#springMessage('请输入')">
                                </div>
                            </td>
                            ##币别
                            <td class="textRight">#springMessage('应收币种')</td>
                            <td>
                                <div class="layui-inline">
                                    <div class="bt-biz-selectType" id="curDiv"
                                         data-url="${basePath}/basic/business/btcurrency/json"
                                         data-biz-name="curId" data-required="true"
                                         data-callback="curCallback"
                                         data-name="curId" data-valueField="id" data-textField="curName"></div>
                                </div>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="layui-colla-custom-item">
                <div class="layui-colla-elm">
                    <div class="layui-colla-custom">
                        <span class="layui-colla-custom-title">#springMessage('对方账户信息')</span>
                    </div>
                </div>
                <div class="layui-colla-content layui-show" style="margin-top: 10px;border:none;padding: 10px 35px;">
                    <table class="layui-table" style="border: none;margin: 0;">
                        <tbody>
                        <tr>
                            <td class="textRight">#springMessage('付款账号')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="payerAccNo" name="payerAccNo"
                                           autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('请输入')">
                                    <div class="bt-div-search">
                                        <button class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button"
                                                data-beforeClick="bt.externalCorpBankAccParams"
                                                data-callback="bt.externalCorpCallback"
                                                title="#springMessage('common.button.select')">
                                            <i class="layui-icon">&#xe615;</i>
                                        </button>
                                    </div>
                                </div>
                            </td>
                            <td class="textRight">#springMessage('付款户名')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="payerAccName"
                                           class="layui-input bt-biz-inputExternalCorpBankAcc"
                                           data-url="" name="payerAccName" data-biz-name="payerAccName"
                                           data-valuefield="inputExternalValue" data-textfield="inputExternalText"
                                           data-search="seachExternalCorpBankAcc"
                                           placeholder="#springMessage('请输入')"
                                           data-callback="inputExternalCorpCallback">
                                </div>
                            </td>
                            <td class="textRight">#springMessage('付款账号开户行')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="payerBankName" name="payerBankName" readonly="readonly"
                                           autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('请选择')">
                                    <div class="bt-div-search">
                                        <button class="bt-biz-bankInfo" id="selPayeeBankBut" type="button"
                                                data-callback="bt.bankinfoCallback"
                                                title="#springMessage('common.button.select')">
                                            <i class="layui-icon">&#xe615;</i>
                                        </button>
                                    </div>
                                </div>
                                <input id="payerBankNo" name="payerBankNo" type="hidden" value="">
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight">#springMessage('客商名称')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="externalName" name="externalName" lay-verify="required"
                                           autocomplete="off" class="layui-input" data-required="true"
                                           placeholder="#springMessage('请选择')">
                                    <input id="externalId" name="externalId" type="hidden" value="">
                                    <div class="bt-div-search">
                                        <button class="bt-biz-externalCorpBankAcc" id="selExternalNameBut" type="button"
                                                data-beforeClick="bt.externalCorpBankAccParams2"
                                                data-callback="bt.externalCorpNameCallback"
                                                title="#springMessage('common.button.select')">
                                            <i class="layui-icon">&#xe615;</i>
                                        </button>
                                    </div>
                                </div>
                                <!--                          <div class="layui-input-inline">-->
                                <!--                              <input type="text" id="externalName" name="externalName"-->
                                <!--                                     lay-verify="required"-->
                                <!--                                     autocomplete="off" class="layui-input"-->
                                <!--                                     placeholder="#springMessage('客商名称')">-->
                                <!--                          </div>-->
                            </td>
                            ##客商类型
                            <td class="textRight">#springMessage("table.externalCorp.externalType")</td>
                            <td>
                                <div class="bt-biz-dict" data-type="select" data-group="external.type"
                                     data-required="true" data-biz-name="externalType" data-disabled="true"
                                     name="externalType" data-name="externalType"
                                     data-value="$!{externalCorp.externalType}"
                                ></div>
                            </td>
                            <td class="textRight">
                                <a class="a-btn-color" href="#" style="color:blue" onclick="setExternalCallBack()">设置客商资料</a>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="layui-colla-custom-item">
            <div class="layui-colla-elm">
                <div class="layui-colla-custom">
                    <span class="layui-colla-custom-title">#springMessage('合同信息')</span>
                </div>
            </div>
            <div class="layui-colla-content layui-show" style="margin-top: 10px;border:none;padding: 10px 35px;">
                <table class="layui-table" style="border: none;margin: 0;">
                    <tbody>
                    <tr>
                        ## 交易合同编号
                        <td class="textRight">#springMessage('交易合同编号')</td>
                        <td style="display: flex; align-items: center;">
                            <input id="contractCode" name="contractCode" class="layui-input" max-length="150"
                                   placeholder="#springMessage('请输入')">
                            <i id="contractCode-desc" class="layui-icon" style="color:#c9c9c9;">&#xe60b;</i>
                        </td>
                        <td class="textRight">#springMessage('交易合同名称')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input name="contractName" id="contractName" class="layui-input" max-length="20"
                                       placeholder="#springMessage('请输入')">
                            </div>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('交易合同金额')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input name="contractMoney" id="contractMoney" placeholder="#springMessage('请输入')"
                                        type="text" style="text-align:left !important;"
                                       onkeyup=value=value.replace(/^[1-9]\d{0,11}(\.\d{1,2})?$)
                                       lay-verify="number2"
                                       data-name="contractMoney" data-biz-name="contractMoney" autocomplete="off"
                                       class="layui-input bt-biz-moneyType inputMoney"
                                >
                            </div>
                        </td>
                        <td class="textRight">#springMessage('交易合同日期')</td>
                        <td>
                            <input type="text" name="contractDate" class="layui-input bt-biz-dateType"
                                   placeholder="#springMessage('请选择')"
                                   data-type="date" data-name="contractDate">
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div style="margin-bottom: 10px">
        <table style="width:100%">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('交易合同')</td>
                <td style="width:100%">
                    <div>
                        <input id="attachmentId2" name="contractAttachmentId" type="hidden">
                        <div id="uploader2" class="layui-input-inline" style="width:100%"></div>
                    </div>
                </td>
            </tr>
            </tbody>
        </table>
    </div>
    <div class="layui-colla-custom-item">
        <div class="layui-colla-elm">
            <div class="layui-colla-custom">
                <span class="layui-colla-custom-title">#springMessage('发票信息')</span>
            </div>
        </div>
        <div class="layui-colla-content layui-show" style="margin-top: 10px;border:none;">
            <table class="layui-table ignore-required-icon isDown" id="editTable" width="100%">
                <thead>
                <tr>
                    <th>
                        <span>#springMessage("发票号")</span>
                        <div class="layui-input-inline">
                            <i id="invoiceCode-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </th>
                    <th>#springMessage("发票代码")</th>
                    <th>#springMessage("发票票面金额")</th>
                    <th>
                        <span>#springMessage("不含税金额")</span>
                        <div class="layui-input-inline">
                            <i id="taxincAmt-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </th>
                    <th>#springMessage("开票日期")</th>
                    <th>#springMessage("发票类型")</th>
                    <th>#springMessage("发票校验码")</th>
                    <th>#springMessage("common.table.thead.operation")</th>
                </tr>

                </thead>
                <tbody id="rowBody">
                </tbody>
            </table>
        </div>
    </div>
    </div>
    <div style="margin-bottom: 10px">
        <table style="width:100%">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('发票附件')</td>
                <td style="width:100%">
                    <div>
                        <input id="attachmentId" name="attachmentId" type="hidden">
                        <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                    </div>
                </td>
            </tr>
            </tbody>
        </table>
    </div>
    </div>
    <div class="layui-colla-custom-item" id="tagItemDetailDiv">
        <div class="layui-colla-elm">
            <div class="layui-colla-custom">
                <span class="layui-colla-custom-title">#springMessage('资金计划')</span>
            </div>
        </div>
        <div class="layui-colla-content layui-show" style="margin-top: 10px;border:none;">
            <!-- 资金计划 -->
            <div id="tagItemDetail"></div>
        </div>
    </div>
    </div>
    <div style="text-align: center; padding-top: 10px;">
        <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')
        </button>
        <button class="layui-btn layui-btn-Staging" lay-submit="" lay-filter="submit" value="0">
            #springMessage('common.button.temp')
        </button>
        <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">
            #springMessage('common.button.reset')
        </button>

    </div>

</form>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/docManage/DocManage.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<!--用户没有证书--->
<!--<input type="hidden" id="caType"  value="4"/>-->
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="docSearchForm" class="layui-form">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}"/>
    <table class="layui-table">
        <tbody>
            <tr>
                ##结算方式
                <td class="textRight">#springMessage('单据编号')</td>
                <td>
                    <input type="text"name="likes_code" autocomplete="off" class="layui-input" placeholder="#springMessage('单据编号')">
                </td>
                ##核销类型
                <td class="textRight" width="10%">#springMessage('核销类型')</td>
                <td width="30%">
                    <div class="bt-biz-dict" data-type="select" data-group="writeOff.type" data-name="eqs_writeOffType" name="eqs_writeOffType"
                         data-biz-name="doc_eqs_writeOffType"
                    ></div>
                </td>
                <td class="textRight" width="10%"></td>
                <td width="30%"></td>
            </tr>
        </tbody>
        <tbody>
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="docSearch" type="button">#springMessage(
                        'common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </tbody>
    </table>
</form>

<table id="appTableDoc" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('应收单核销批次号')</th>
        <th>#springMessage('单据编号')</th>
        <th>#springMessage('单位')</th>
        <th>#springMessage('业务类型')</th>
        <th>#springMessage('单据来源')</th>
        <th>#springMessage('应收金额')</th>
        <th>#springMessage('应收余额')</th>
        <th>#springMessage('执行金额')</th>
        <th>#springMessage('币种')</th>
        <th>#springMessage('汇率')</th>
        <th>#springMessage('客商名称')</th>
         <th>#springMessage('核销类型')</th>
        <th>#springMessage('操作类型')</th>
    </tr>
    </thead>
</table>
#workFlowHtml()
#parse("views/common/footer.vm")
#workFlowScript()
<script src="${basePath}/static/modules/writeOff/writeOffApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

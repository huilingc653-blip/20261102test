<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="hisSearchForm" class="layui-form">
    <input type="hidden" name="batchNo" id="batchNo" value="$!{batchNo}"/>
    <input type="hidden" id="taskId" name= "taskId" value="$!{taskId}">
    <input type="hidden" id="docId" name= "docId" value="$!{relationVo.docId}">
    <input type="hidden" id="paymentMeans" name= "paymentMeans" value="$!{relationVo.paymentMeans}">

    <table id="appTable" class="layui-table layui-form" style="width:100%;" data-biz-name="appTable">
        <thead>
        <tr>
            <th>单据编号</th>
            <th>本次核销金额</th>
            <th>客商名称</th>
            <th>单位</th>
            <th>业务类型</th>
            <th>单据来源</th>
            <th>核销前状态</th>
            <th>核销后状态</th>
            <th>本次核销类型</th>
            <th>单据日期</th>
            <th>到期日期</th>
            <th>账龄起算日</th>
            <th>本次核销前应收余额</th>
            <th>本次核销后应收余额</th>
        </tr>
        </thead>
    </table>
</form>

<form id="searchFormDtl" class="layui-form">
    <input type="hidden" id="dtl_eqs_id" name= "eqs_id" value="$!{relationVo.relationId}">
    <input type="hidden" id="dtl_queryType" name= "queryType" value="approve">
    <table id="appTableDtl" class="layui-table layui-form #if($!{relationVo.paymentMeans}!=1) then hide #end" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('银行流水')</th>
            <th>#springMessage('table.btNetChalk.transTime')</th>
            <th>#springMessage('table.btBankAccDtl.curName')</th>
            <th>#springMessage('金额')</th>
            <th>#springMessage('可核销金额')</th>
            <th>#springMessage('table.btBankAccDtl.accName')</th>
            <th>#springMessage('本方账户银行名称')</th>
            <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
            <th>#springMessage('流水时间')</th>
            <th>#springMessage('table.btBankAccDtl.uses')</th>
            <th>#springMessage('附言')</th>
            <th>#springMessage('核销状态')</th>
            <th>#springMessage('核销类型')</th>
        </tr>
        </thead>
    </table>
</form>

<form id="searchFormBill" class="layui-form">
    <input type="hidden" id="bill_eqs_id" name= "eqs_id" value="$!{relationVo.relationId}">
    <input type="hidden" id="bill_queryType" name= "queryType" value="approve">
    <table id="appTableBill" class="layui-table layui-form #if($!{relationVo.paymentMeans}!=2) then hide #end" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.abVoucherinfo.billType')</th>
            <th>#springMessage('table.abVoucherinfo.billFlag')</th>
            <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
            <th>#springMessage('票据单位统一社会信用代码')</th>
            <th>#springMessage('table.abVoucherinfo.payer')</th>
            <th>#springMessage('table.abVoucherinfo.acceptor')</th>
            <th>#springMessage('table.abVoucherinfo.origNo')</th>
            <th>#springMessage('票据（包）金额')</th>
            <th>#springMessage('实付金额')</th>
            <th>#springMessage('可核销金额')</th>
            <th>#springMessage('table.abVoucherinfo.startDate')</th>
            <th>#springMessage('table.abVoucherinfo.endDate')</th>
            <th>#springMessage('table.btwarnstrategy.warnDate')</th>
            <th>#springMessage('业务类型')</th>
            <th>#springMessage('所属库存')</th>
            <th>#springMessage('bill.accebill.bustype')</th>
            <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
            <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>
            <th>#springMessage('转让标记')</th>
            <th>#springMessage('核销状态')</th>
            <th>#springMessage('核销类型')</th>
        </tr>
        </thead>
    </table>
</form>

<form id="searchFormLc" class="layui-form">
    <input type="hidden" id="lc_eqs_id" name= "eqs_id" value="$!{relationVo.relationId}">
    <input type="hidden" id="lc_queryType" name= "queryType" value="approve">
    <table id="appTableLc" class="layui-table layui-form #if($!{relationVo.paymentMeans}!=3) then hide #end" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.internation.arrival.com.no')</th>##到单号
            <th>#springMessage('单位名称')</th>
            <th>#springMessage('international.credit.creditNo')</th>##信用证号
            <th>#springMessage('international.credit.lcInter')</th>##信用证类型
            <th>#springMessage('table.internation.arrival.bank')</th>##交单银行
            <th>#springMessage('international.credit.beneficiary')</th>##受益人
            <th>#springMessage('交单金额')</th>
            <th>#springMessage('需收款金额')</th>
            <th>#springMessage('已收款金额')</th>
            <th>#springMessage('可核销金额')</th>
            <th>#springMessage('已抵押金额')</th>
            <th>#springMessage('已议付金额')</th>
            <th>#springMessage('币别')</th>
            <th>#springMessage('交单日期')</th>
            <th>#springMessage('所属库存')</th>
            <th>#springMessage('核销状态')</th>
            <th>#springMessage('核销类型')</th>
        </tr>
        </thead>
    </table>
</form>

#workFlowHtml()
#parse("views/common/footer.vm")
#workFlowScript()
</body>
<script>
var moneyType;
bt.use(['form', 'datatable', 'dateType', 'corp', 'dicts', 'money', 'selectType', 'accountTable', 'bank', 'moneyType', 'mulselect', 'externalCorpBankAcc'], function () {
     var $ = bt.jquery, form = bt.form();
     moneyType = bt.moneyType.init();

     var appTable = bt.datatable.initMultiTables({
             elem: "#appTable",
             checkbox: false,
             mulselect: true,
             selectCss: true,
             jumpPageSelect: true,//开启跨页选择
             isInitData: true,
             searchForm: {
                formElem: "#hisSearchForm"
             },
             order: [[1, 'desc']],
             ajax: {
                 'url': basePath + "/accountReceivable/writeOff/sureDatatable"
             },
             buttons: [
                {
                     extend: "colvis",
                     text: bt.lang('common.button.theadHide'),
                     columns: ':not(:first):not(:last)'
                 }
             ],
             columns: [
                {data: "docManageVo.code", bSortable: false},
                 {
                      data: "docMoney", bSortable: true, className: 'textRight',
                      render: function (data, type, full, meta) {
                          return bt.money.format(full.docMoney);
                      }
                  },
                 {data: "docManageVo.externalName", bSortable: true},
                 {data: "docManageVo.corpName", bSortable: false},
                 {data: "docManageVo.batchBusTypeName", bSortable: false},
                 {data: "docManageVo.sourceName", bSortable: false},
                 {data: "docManageVo.writeOffStatusName", bSortable: false},
                 {data: "afterDocWriteOffStatusName", bSortable: false},
                 {data: "writeOffTypeName", bSortable: false},
                 {data: "docManageVo.receiptDate", bSortable: false},
                 {data: "docManageVo.endDate", bSortable: false},
                 {data: "docManageVo.agingDate", bSortable: false},
                 {
                   data: "docManageVo.writeOffBal", bSortable: true, className: 'textRight',
                   render: function (data, type, full, meta) {
                       return bt.money.format(full.docManageVo.writeOffBal);
                   }
                 },
                 {
                    data: "afterDocWriteOffBal", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.afterDocWriteOffBal);
                    }
                 }
             ],
             btClickRowCallback: function (data1) {

             },
             btDrawCallback: function (setting) { //回调方法

             },
             summary: {
             pageSum: false,
             allSum: true,
             selectSum: false,
             format: {
                 decimal: 2
             },
             sumList: [
                 {
                     money: true,
                     colNum: '1',
                     dataName: 'docMoney'
                 }/*,{
                     money: true,
                     colNum:'13',
                     dataName:'docManageVo.writeOffBal'
                 },
                 {
                     money: true,
                     colNum:'14',
                     dataName:'afterDocWriteOffBal'
                 }*/
             ]
         }
         });



        //获取流水表格数据
        var tbDtl;
        function getDtlDate() {
            if (null == tbDtl) {
                tbDtl = bt.datatable.initMultiTables({
                    elem: "#appTableDtl",
                    isInitData: true,
                    checkbox: false,
                    mulselect: true,
                    selectCss: true,
                    jumpPageSelect: false,//开启跨页选择
                    searchForm: {
                        formElem: "#searchFormDtl",
                        formFilter: "dtlSearch"
                    },
                    order: [[1, 'desc']],
                    ajax: {
                        'url': basePath + "/accountReceivable/writeOff/dtlDatatable"
                    },
                    buttons: [
                        {
                            extend: "colvis",
                            text: bt.lang('common.button.theadHide'),
                            columns: ':not(:first):not(:last)'
                        }
                    ],
                    columns: [
                        {data: "bankSerialNo", bSortable: true},
                        {data: "transTime", bSortable: true},
                        {data: "curName", bSortable: true},
                        {
                            data: "amt", bSortable: true, className: 'textRight',
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.amt);
                            }
                        },
                        {
                            data: "writeOffBal", bSortable: true, className: 'textRight',
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.writeOffBal);
                            }
                        },
                        {data: "accName", bSortable: true},
                        {data: "bankName", bSortable: true},
                        {data: "bankAcc", bSortable: true},
                        {data: "oppAccName", bSortable: true},
                        {data: "oppAccNo", bSortable: true},
                        {data: "returnTime", bSortable: true, format: "YYYY-MM-DD hh:mm:ss"},
                        {data: "uses", bSortable: true},
                        {data: "postscript", bSortable: true},
                        {data: "writeOffStatusName", bSortable: true},
                        {data: "writeOffTypeName", bSortable: true}
                    ],
                    btDrawCallback: function () {
                    },
                    btClickRowCallback: function (data1) {
                    }
                });
            } else {
                bt.datatable.refreshTable("appTableDtl");
            }
        }

        var tbBill;
        function getBillData() {
            if (null == tbBill) {
                tbBill = bt.datatable.initMultiTables({
                    elem: "#appTableBill",
                    checkbox: false,
                    mulselect: true,
                    selectCss: true,
                    isInitData: true,
                    jumpPageSelect: false,//开启跨页选择
                    searchForm: {
                        formElem: "#searchFormBill",
                        formFilter: "billSearch"
                    },
                    order: [[1, 'desc']],
                    ajax: {
                        'url': basePath + "/accountReceivable/writeOff/billDatatable"
                    },
                    buttons: [
                        {
                            extend: "colvis",
                            text: bt.lang('common.button.theadHide'),
                            columns: ':not(:first):not(:last)'
                        }
                    ],
                    columns: [
                        {data: "billTypeName", bSortable: true},
                        {data: "billFlagName", bSortable: true},
                        {data: "corpCodeAndName", bSortable: true},
                        {data: "blRmtrUnnIdNo", bSortable: true},
                        {data: "payer", bSortable: true},
                        {data: "acceptor", bSortable: true},
                        {data: "origNo", bSortable: true},
                        {data: "billMoney", bSortable: true,
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.billMoney);
                            }
                        },
                        {data: "realMoney", bSortable: true,
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.realMoney);
                            }
                        },
                        {data: "writeOffBal", bSortable: true,
                             render: function (data, type, full, meta) {
                                 return bt.money.format(full.writeOffBal);
                             }
                         },
                        {data: "startDate", bSortable: true},
                        {data: "endDate", bSortable: true},
                        {data: "receDate", bSortable: true},
                        {data: "briefIdName", bSortable: true},
                        {data: "enterStockName", bSortable: true},
                        {data: "newStmIssuofpprIndName", bSortable: true},
                        {data: "blgrdbagcrclPrmtIndName", bSortable: true},
                        {data: "sbbllRngStrtSn", bSortable: true},
                        {data: "sbbllRngEndSn", bSortable: true},
                        {data: "blStdAmt", bSortable: true,
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.blStdAmt);
                            }
                        },
                        {data: "transferWayName", bSortable: true,
                            render: function (data, type, full, meta) {
                                if (full.briefId == '8018' && full.transferWay == '0') {
                                    data = '票据池质押';
                                }
                                return data;
                            }
                        },
                        {data: "writeOffStatusName", bSortable: true},
                        {data: "writeOffTypeName", bSortable: true}
                    ],
                    btDrawCallback: function () {
                    },

                });
            } else {
                bt.datatable.refreshTable("appTableBill");
            }
        }

        var tbLc;
        function getLcData() {
            if (null == tbLc) {
                tbLc = bt.datatable.initMultiTables({
                    elem: "#appTableLc",
                    isInitData: true,
                    checkbox: false,
                    mulselect: true,
                    selectCss: true,
                    jumpPageSelect: false,//开启跨页选择
                    searchForm: {
                        formElem: "#searchFormLc",
                        formFilter: "lcSearch"
                    },
                    order: [[1, 'desc']],
                    ajax: {
                        'url': basePath + "/accountReceivable/writeOff/lcDatatable"
                    },
                    buttons: [
                        {
                            extend: "colvis",
                            text: bt.lang('common.button.theadHide'),
                            columns: ':not(:first):not(:last)'
                        }
                    ],
                    columns: [
                        {data: "arrivalCode", bSortable: true},
                        {data: "corpName", bSortable: true},
                        {data: "creditNo", bSortable: true},
                        {data: "lcInter", bSortable: true,
                            render: function (data, type, full, meta) {
                                return bt.dict("letter_of_credit_inter", full.lcInter);
                            }
                        },
                        {data: "handDocBank", bSortable: true},
                        //{data: "beneficiary", bSortable: true},
                        {data: "corpName", bSortable: true, className: "center"},
                        {
                            data: "billMoney", bSortable: true, className: "textRight",
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.billMoney);
                            }
                        },
                        {
                            data: "payMoney", bSortable: true, className: "textRight",
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.payMoney);
                            }
                        },
                        {
                            data: "incomingMoney", bSortable: true, className: "textRight",
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.incomingMoney);
                            }
                        },
                        {
                            data: "writeOffBal", bSortable: true, className: "textRight",
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.writeOffBal);
                            }
                        },
                        {
                            data: "mortgageMoney", bSortable: true, className: "textRight",
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.mortgageMoney);
                            }
                        },
                        {
                            data: "negotiationMoney", bSortable: true, className: "textRight",
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.negotiationMoney);
                            }
                        },
                        {data: "curName", bSortable: true},
                        {data: "paymentDate", bSortable: true, className: "center"},
                        {data: "corpName", bSortable: true},
                        {data: "writeOffStatusName", bSortable: true},
                        {data: "writeOffTypeName", bSortable: true}
                    ],
                    btDrawCallback: function () {
                    },

                });
            } else {
                bt.datatable.refreshTable("appTableLc");
            }
        }

        function initRelationTable(){
            var paymentMeansSel = $("#paymentMeans").val();
            if("1" == paymentMeansSel){
                getDtlDate()
            }else if("2" == paymentMeansSel){
                getBillData()
            }else if("3" == paymentMeansSel){
                getLcData()
            }
        }
        initRelationTable();
});


</script>
<div class="layui-tab layui-tab-brief" lay-filter="paymentMeansTab">
    <ul class="layui-tab-title">
        <li data-paymentMeans="1" class="layui-this tab-type"　#if($paymentMeans.indexOf("1") < 0) style="display:none;" #end>#springMessage("银行流水")</li>
        <li data-paymentMeans="2" #if($paymentMeans.indexOf("2") < 0) style="display:none;" #end>#springMessage("票据")</li>
        <li data-paymentMeans="3" #if($paymentMeans.indexOf("3") < 0) style="display:none;" #end>#springMessage("信用证")</li>
    </ul>
</div>


<!--结算方式-银行流水-->
<div id="div_Dtl" #if($!{paymentMeansDefault}!="1") style="display:none;" #end>
    <form id="searchFormDtl" class="layui-form">
        <input type="hidden" name="eqs_id" id="eqs_dtl_id"/>
        <table class="layui-table">
            <tbody >
            <tr>
                ##单位
                <td class="textRight" width="10%">#springMessage('单位')</td>
                <td width="20%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-tree-type="radio"
                             data-name="eqs_corpId"
                             id="dtl_eqs_corpId"
                             data-biz-name="dtl_eqs_corpId"
                             data-scope="all" data-resource="accountReceivable:writeOff:op"
                             data-placeholder="请选择"
                             data-callback="dtlCorpCallback"></div>
                    </div>
                </td>
                ##核销状态
                <td class="textRight" width="10%">#springMessage('核销状态')</td>
                <td width="30%">
                    <div class="bt-biz-dict" data-group="writeOff.status" data-name="ins_writeOffStatus" name="ins_writeOffStatus"
                         data-biz-name="dtl_ins_writeOffStatus" data-defaultvalue="0,1" data-type="mulselect"
                    ></div>
                </td>
                ##银行类别
                <td class="textRight">#springMessage('银行类别')</td>
                <td>
                    <div class="bt-biz-bankType" data-name="eqs_bankType" data-biz-name="dtl_eqs_bankType" ></div>
                </td>
            </tr>
            <tr>
                ##核销类型
                <td class="textRight" width="10%">#springMessage('核销类型')</td>
                <td width="30%">
                    <div class="bt-biz-dict" data-type="select" data-group="writeOff.type" data-name="eqs_writeOffType" name="eqs_writeOffType"
                         data-biz-name="dtl_eqs_writeOffType" data-filterData="3"
                    ></div>
                </td>
                ##对方账号
                <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.oppAccNo')</td>
                <td width="30%">
                    <input type="text" id="dtl_likes_oppAccNo" name="likes_oppAccNo" lay-verify="strlength" data-maxlength="30"
                           autocomplete="off" placeholder="#springMessage('请输入')"
                           data-biz-name="dtl_likes_oppAccNo"  data-name="dtl_oppAccNo"
                           class="layui-input bt-biz-accountTable dtl_likes_oppAccNo" data-resource="netbank:bankAcc:bisAccBal:managerQuery"
                           data-callback="accountCallBack4" data-valuefromtable="true"
                    >
                </td>
                ##对方
                <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.oppAccName')</td>
                <td width="30%">
                    <input type="text" id="dtl_likes_oppAccName" name="likes_oppAccName" lay-verify="strlength" data-maxlength="30"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('请输入')">
                </td>
            </tr>
            </tbody>
            <tbody id="hide-search-dtl">
            <tr>
                ##交易金额
                <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.amt')</td>
                <td width="30%">
                    <div class="layui-inline">
                        <input type="text" name="geg_amt" autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" data-biz-name="dtl_geg_amt" data-callback="dtlGegAmtChange"
                               style="text-align:right" id="dtl_geg_amt" data-moneyendid="dtl_leg_amt" placeholder="#springMessage('最小金额')">
                        <span class="date-mid">~</span>
                        <input type="text" name="leg_amt" autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" data-biz-name="dtl_leg_amt" data-callback="dtlLegAmtChange"
                               style="text-align:right" id="dtl_leg_amt" placeholder="#springMessage('最大金额')">
                    </div>
                </td>
                ##交易日期
                <td class="textRight" width="10%">#springMessage('table.btNetChalk.transTime')</td>
                <td width="30%">
                    <input type="text" name="ged_transTime" data-type="date" id="dtl_ged_transTime" placeholder="#springMessage('开始日期')" data-biz-name="dtl_ged_transTime" class="layui-input bt-input-inline bt-biz-dateType" data-endid="dtl_led_transTime">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_transTime" data-type="date" id="dtl_led_transTime" placeholder="#springMessage('结束日期')" data-biz-name="dtl_led_transTime" class="layui-input bt-input-inline bt-biz-dateType">
                </td>
                ##银行流水号
                <td class="textRight">#springMessage('table.bisExc.bankSerialNo')</td>
                <td>
                    <input type="text" id="dtl_likes_bankSerialNo" name="likes_bankSerialNo" class="bank layui-input" autocomplete="off"
                           placeholder="#springMessage('请输入')">
                </td>
            </tr>
            <tr>
                ##用途
                <td class="textRight">#springMessage('用途')</td>
                <td>
                    <input type="text" id="dtl_likes_uses" name="likes_uses" class="layui-input" autocomplete="off"
                           placeholder="#springMessage('请输入')">
                </td>
                ##附言
                <td class="textRight">#springMessage('附言')</td>
                <td>
                    <input type="text" id="dtl_likes_postscript" name="likes_postscript" class="layui-input" autocomplete="off"
                           placeholder="#springMessage('请输入')">
                </td>
                ##币别
                <td class="textRight">#springMessage('table.btBankAccDtl.curName')</td>
                <td>
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name ="eqs_curId" name ="eqs_curId" data-biz-name ="dtl_eqs_curId"  data-valueField="id" data-textField="curName"></div>
                </td>
            </tr>
            <tr>
                ##本方账号
                <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.bankAcc')</td>
                <td width="30%">
                    <input type="text" id="dtl_likes_bankAcc" name="likes_bankAcc" lay-verify="strlength" data-maxlength="30"
                           autocomplete="off"  placeholder="#springMessage('请输入')"

<input id="paymentMeansDefault" type="hidden" value="$!{paymentMeansDefault}">
<form id="docSearchForm" class="layui-form">
    <input type="hidden" name="eqs_id" id="doc_Id" value="$!{docId}"/>
    <input type="hidden" name="curIdRMB" id="curIdRMB" value="$!{curIdRMB}"/>
    <table class="layui-table">
        <tbody >
        <tr>
            ##单据编号
            <td class="textRight" width="10%">#springMessage('单据编号')</td>
            <td width="30%">
                <input type="text" id="doc_likes_code" name="likes_code"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('请输入')">
            </td>
            ##单位
            <td class="textRight" width="10%">#springMessage('单位')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="radio"
                         data-name="eqs_corpId"
                         id="doc_eqs_corpId"
                         data-biz-name="doc_eqs_corpId"
                         data-scope="all" data-resource="accountReceivable:writeOff:op"
                         data-callback="docCorpCallback"
                         data-placeholder="请选择"></div>
                </div>
            </td>
            ##应收币种
            <td class="textRight" width="10%">#springMessage('应收币种')</td>
            <td width="30%">
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-value="$!{curIdRMB}"
                     data-name ="eqs_curIdShow" data-biz-name ="doc_eqs_curIdShow"  data-valueField="id" data-textField="curName"
                     data-callBack="changeDocCurShowCallback"></div>
                <input id="doc_eqs_curId" type="hidden"  name="eqs_curId" value="$!{curIdRMB}">
            </td>

        </tr>

        <tr>
            ##状态
            <td class="textRight" width="10%">#springMessage('状态')</td>
            <td width="30%">
                <div class="bt-biz-dict" data-type="select" data-group="docManage.status" data-name="eqi_status" name="eqi_status"
                     data-biz-name="doc_eqi_status" data-displayData="-1,11,95"
                ></div>
            </td>
            ##核销状态
            <td class="textRight" width="10%">#springMessage('核销状态')</td>
            <td width="30%">
                <div class="bt-biz-dict" data-group="writeOff.status" data-name="ins_writeOffStatus" name="ins_writeOffStatus"
                     data-biz-name="doc_ins_writeOffStatus" data-defaultvalue="0,1" data-type="mulselect"
                ></div>
            </td>
            ##核销类型
            <td class="textRight" width="10%">#springMessage('核销类型')</td>
            <td width="30%">
                <div class="bt-biz-dict" data-type="select" data-group="writeOff.type" data-name="eqs_writeOffType" name="eqs_writeOffType"
                     data-biz-name="doc_eqs_writeOffType"
                ></div>
            </td>
        </tr>
        </tbody>
        <tbody id="hide-search">
        <tr>
            ##交易合同编号
            <td class="textRight" width="10%">#springMessage('交易合同编号')</td>
            <td width="30%">
                <input type="text" id="doc_likes_contractCode" name="likes_contractCode"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('请输入')">
            </td>
            ##结算方式
            <td class="textRight" width="10%">#springMessage('结算方式')</td>
            <td width="30%">
                <div class="bt-biz-dict" data-type="select" data-group="account.receivable.doc.voucherType" data-name="eqs_voucherType"
                     data-biz-name="doc_eqs_voucherType" data-defaultvalue="" ></div>
            </td>
            ##账龄起算日
            <td class="textRight" width="10%">#springMessage('账龄起算日')</td>
            <td width="30%">
                <input type="text" name="ged_agingDate" data-type="date" id="doc_ged_agingDate" data-biz-name="doc_ged_agingDate"
                       class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="doc_led_agingDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_agingDate" data-type="date" id="doc_led_agingDate" data-biz-name="doc_led_agingDate"
                       class="layui-input bt-input-inline bt-biz-dateType" >
            </td>
        </tr>
        <tr>
            ##客商名称
            <td class="textRight" width="10%">#springMessage('客商名称')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_externalName" id="doc_likes_externalName" data-biz-name="doc_likes_externalName"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('请选择')">
                    <div class="bt-div-search">
                        <button  class="bt-biz-externalCorpBankAcc" id="doc_selexternalName" type="button" data-beforeClick="bt.externalCorpBankAccParams" data-callback="bt.externalCorpCallback" title="#springMessage('common.button.select')">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
            ##客商类型
            <td class="textRight" width="10%">#springMessage("table.externalCorp.externalType")</td>
            <td width="30%">
                <div class="bt-biz-dict" data-type="select" data-group="external.type"
                     name="eqs_externalType" data-name="eqs_externalType" data-biz-name="doc_eqs_externalType"></div>
            </td>
            ##业务类型
            <td class="textRight" width="10%">业务类型</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-name="eqs_batchBusType" data-biz-name="doc_eqs_batchBusType" data-defaultvalue=""
                         data-url="${basePath}/netbank/niscorpbus/listNisCorpBusVOByCorpIdAndCdSign?cdSign=0&corpId="
                         data-valuefield="busId" data-textfield="busTypeName" data-search="true" data-beforeinit="batchBusTypeBefore" ></div>
                </div>
            </td>
        </tr>
        <tr>
            ##到期日期
            <td class="textRight" width="10%">#springMessage('到期日期')</td>
            <td width="30%">
                <input type="text" name="ged_endDate" data-type="date" id="doc_ged_endDate" data-biz-name="doc_ged_endDate"
                       class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_endDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_endDate" data-type="date" id="doc_led_endDate" data-biz-name="doc_led_endDate"
                       class="layui-input bt-input-inline bt-biz-dateType" >
            </td>

            ##单据来源
            <td class="textRight" width="10%">#springMessage('单据来源')</td>
            <td width="30%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="writeOff.docSource"
                         data-defaultvalue="" data-callBack=""
                         data-name="eqs_source" data-biz-name="doc_eqs_source"></div>
                </div>
            </td>

            ##单据日期
            <td class="textRight" width="10%">#springMessage('单据日期')</td>
            <td width="30%">
                <input type="text" name="ged_receiptDate" data-type="date" id="doc_ged_receiptDate" data-biz-name="doc_ged_receiptDate"
                       class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="doc_led_receiptDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_receiptDate" data-type="date" id="doc_led_receiptDate" data-biz-name="doc_led_receiptDate"
                       class="layui-input bt-input-inline bt-biz-dateType" >
            </td>
        </tr>
        </tbody>
        <tbody>
        ##查询
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit lay-filter="docSearch" type="button">#springMessage('common.button.search')</button>
                <button type="button" class="layui-btn layui-btn-primary" onclick="clearDocFrom()">#springMessage('common.button.reset')</button>
                <span class="ui-more-btn" onclick="showMoreBtn()">更多筛选</span><img src="${basePath}/static/images/table/icon_arrow_down.svg" class="ui-arrow-down">
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTableDoc" class="layui-table layui-form" style="width:100%;" data-biz-name="appTableDoc">
    <div id="writeOffMenu" class="layui-form" style="display: none; position: absolute; z-index: 1000; background: #fff; border: 1px solid #ddd; padding: 15px;">
        <ul class="layui-unselect">
            <li><a href="javascript:;" class="write-off-option manualButton active" data-type="manual" id="manualWriteOff">手工核销</a></li>
            <li><a href="javascript:;" class="write-off-option cancelButton" data-type="cancel" id="cancelWriteOff">取消核销</a></li>
            <li><a href="javascript:;" class="write-off-option forceButton" data-type="force" id="forceWriteOff">强制核销</a></li>
        </ul>
    </div>
    <thead>
    <tr>
        <th>#springMessage('单据编号')</th>
        <th>#springMessage('单位')</th>
        <th>#springMessage('业务类型')</th>
        <th>#springMessage('单据来源')</th>
        <th>#springMessage('核销状态')</th>
        <th>#springMessage('状态')</th>
        <th>#springMessage('核销类型')</th>
        <th>#springMessage('结算方式')</th>
        <th>#springMessage('单据日期')</th>
        <th>#springMessage('到期日期')</th>
        <th>#springMessage('账龄起算日')</th>
        <th>#springMessage('应收金额')</th>
        <th>#springMessage('应收余额')</th>
        <th>#springMessage('应收币种')</th>
        <th>#springMessage('客商名称')</th>
        <th>#springMessage('客商类型')</th>
        <th>#springMessage('交易合同编号')</th>
    </tr>
    </thead>
</table>


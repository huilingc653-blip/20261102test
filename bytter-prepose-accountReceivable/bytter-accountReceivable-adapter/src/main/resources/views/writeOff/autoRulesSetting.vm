<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="forceSearchForm" class="layui-form">
    <input type="hidden" name="docId" id="docId" value="$!{docId}"/>
    <input type="hidden" name="relationId" id="relationId" value=""/>
    <input type="hidden" name="writeOffType" id="writeOffType" value=""/>
    <input type="hidden" name="paymentMeans" id="paymentMeans" value=""/>
    <input type="hidden" name="bankAccTypeStr" id="bankAccTypeStr" value=""/>
    <input type="hidden" name="exchangeRate" id="exchangeRate" value=""/>
    <input type="hidden" name="docManageApproveVoList" id="docManageApproveVoList" value=""/>
    <input type="hidden" name="bisAccDtlVOList" id="bisAccDtlVOList" value=""/>

    <table class="layui-table">
        <tr class="matchingRuleTr">
            ##自动核销匹配规则
            <td class="textRight">#springMessage('自动核销匹配规则')</td>
            <td>
                <div class="bt-biz-dict" data-type="mulselect" data-group="writeOff.autoMatchRule" data-name="ins_matchingRule" data-required="true"
                     data-biz-name="matchingRule" data-defaultvalue="" data-displayData="1,2,3,4,5" data-callback="matchingRuleCallback"
                     ></div>
            </td>
        </tr>
        <tr class="transTimeRuleTr hide">
            ##到期日期到匹配规则
            <td class="textRight">#springMessage('到期日期匹配规则')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="writeOff.expireDateMatchRule" data-name="transTimeRule"
                     data-biz-name="transTimeRule" data-defaultvalue=""
                ></div>
            </td>
        </tr>
    </table>

    <table class="layui-table">
        <tbody>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button type="button" class="layui-btn layui-btn-primary" style="background-color: #E7E7E7;" onclick="closeOpen()">#springMessage('取消')</button>
                <button class="layui-btn" style="background-color: #C70D0D;color: #FFFFFF;" onclick="sureWriteOffCheck()" type="button">#springMessage('确定')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/writeOff/autoRulesSetting.js?_btv=${resourceVersion}"></script>
</html>
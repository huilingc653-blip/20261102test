<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<style type="text/css">
	.writerStyle{
        border-radius: 3px;
        background: #F9E6E6 !important;
        border: 1px solid #E58F8F;
        min-width: 500px !important;
	}
	.td_font{
        color: rgba(0,0,0,0.90);
        font-weight: 700;
	}
	.td_font_size{
	    font-size: 14px !important;
	    width: 229px !important;
	    padding: 0px 19px !important;
	}
	.hisSearchForm{
	min-width: 500px !important;
	}
	.light-skin{
	    min-width: 500px !important;
	}
    .divHeightV1{
        height: 82px;
    }
    .divHeightV2{
        height: 266px;
    }
    .item_pc{
        display: flex;
        justify-content: space-between;
    }
    .spanPadding{
    	font-size: 14px !important;
	    width: 229px !important;
        padding-left: 44px !important;
    }

</style>
<body>
<form id="hisSearchForm" class="layui-form hisSearchForm" method="post">
    <input type="hidden" name="writeOffSize" id="writeOffSize" value="$!{writeOffSize}"/>

    #if($!{writeOffSize} == 1)
    <table class="layui-table writerStyle">
        <tbody>
        <tr>
            <td class="td_font td_font_size"><span>批次号: </span><span>$!{relation.batchNo}</span></td>
            <input type="hidden" name="batchNo" id="batchNo" value="$!{relation.batchNo}"/>
            <td class="td_font td_font_size"></td>
        </tr>
        <tr>
            <td class="td_font_size"><span>核销金额: </span><span>$!{relation.relationConvertMoney}</span></td>
            <td class="td_font_size"><span>核销日期: </span><span>$!date.format('yyyy-MM-dd HH:mm:ss',$!{relation.createDate})</span></td>
        </tr>
        </tbody>
    </table>
    #else
    #foreach($relation in $!{writeOffHis})
    <table class="layui-table ">
        <tbody class="writerStyle">
        <tr>
            <td class="td_font td_font_size">
                <input type="radio" name="radioWrite" value="$!{relation.batchNo}"  title="批次号: $!{relation.batchNo}" lay-skin="none">
            </td>
            <td class="td_font td_font_size"></td>
        </tr>
        <tr>
            <td class="spanPadding"><span>核销金额: </span><span>$!{relation.relationConvertMoney}</span></td>
            <td class="td_font_size"><span>核销日期: </span><span>$!{relation.createDate}</span></td>
        </tr>
        #end
        </tbody>
    </table>
    #end
    </div>

    <table class="layui-table">
        <tbody>
        <tr>
            <td colspan="4" style="text-align: right;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('确认')</button>
                <button type="button" class="layui-btn layui-btn-primary" onclick="cancle()">#springMessage('取消')
                </button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/writeOff/writeOffHis.view.js?_btv=${resourceVersion}"></script>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<style>
    .class-td-6 td:nth-child(1),td:nth-child(3),td:nth-child(5){
        width:10% !important;
    }
    .class-td-6 td:nth-child(2),td:nth-child(4),td:nth-child(6){
        width:23% !important;
    }
    .layui-colla-custom-item{
        margin: 10px 0;
    }
    .layui-colla-custom{
        border-left: 5px solid #C70D0D;
        padding-left: 15px;
    }
    .layui-colla-elm{
        border-bottom: 1px solid #EEEEEE;
        padding-bottom: 10px;
    }
    .layui-colla-custom-title{
        font-weight: bold;
        font-size: 14px;
        color: black;
    }
</style>
<form class="layui-form" method="post" id="inputForm">
    <input type="hidden" name="docId" id="docId" value="$!{docId}"/>

    ## 应收单和银行流水信息
    <div class="layui-colla-custom-parent">
        <div class="layui-colla-custom-item">
            <div class="layui-colla-elm">
                <div class="layui-colla-custom">
                    <span class="layui-colla-custom-title">#springMessage('应收单信息')</span>
                </div>
            </div>


            <div class="layui-colla-content layui-show" style="padding: 0 35px;">
                <div>
                    <table class="layui-table class-td-6" style="border: none;margin: 0;">
                        <tbody>
                        <tr>
                            <td class="textRight">#springMessage('单据编号')</td>
                            <td class="docManageVo-code"></td>

                            <td class="textRight">#springMessage('单位')</td>
                            <td class="docManageVo-corpName"></td>

                            <td class="textRight" >#springMessage('业务类型')</td>
                            <td class="docManageVo-batchBusTypeName"></td>
                        </tr>
                        <tr>
                            <td class="textRight" >#springMessage('单据来源')</td>
                            <td class="docManageVo-sourceName"></td>

                            <td class="textRight" >#springMessage('当前状态')</td>
                            <td class="docManageVo-writeOffStatusName"></td>

                            <td class="textRight" >#springMessage('核销后状态')</td>
                            <td class="afterDocWriteOffStatusName"></td>
                        </tr>
                        <tr>
                            <td class="textRight" >#springMessage('单据日期')</td>
                            <td class="docManageVo-receiptDate"></td>

                            <td class="textRight" >#springMessage('到期日期')</td>
                            <td class="docManageVo-endDate"></td>

                            <td class="textRight" >#springMessage('账龄起算日')</td>
                            <td class="docManageVo-agingDate"></td>
                        </tr>
                        <tr>
                            <td class="textRight" >#springMessage('应收金额')</td>
                            <td class="docManageVo-receivableMoney"></td>

                            <td class="textRight" >#springMessage('应收余额')</td>
                            <td class="docManageVo-writeOffBal"></td>

                            <td class="textRight" >#springMessage('执行金额')</td>
                            <td class="docManageVo-executeMoney"></td>
                        </tr>
                        <tr>
                            <td class="textRight" >#springMessage('本次核销后应收余额')</td>
                            <td class="docManageVo-newWriteOffBal"></td>

                            <td class="textRight" >#springMessage('应收币种')</td>
                            <td class="docManageVo-curName"></td>

                            <td class="textRight" >#springMessage('结算方式')</td>
                            <td class="docManageVo-voucherTypeName"></td>
                        </tr>
                        <tr>
                            <td class="textRight" >#springMessage('客商名称')</td>
                            <td class="docManageVo-externalName"></td>

                            <td class="textRight" >#springMessage('客商类型')</td>
                            <td class="docManageVo-externalTypeName"></td>

                            <td class="textRight" >#springMessage('交易合同编号')</td>
                            <td class="docManageVo-contractCode"></td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


        <div class="layui-colla-custom-item" >
            <div class="layui-colla-elm">
                <div class="layui-colla-custom">
                    <span class="layui-colla-custom-title">#springMessage('匹配收入信息')</span>
                </div>
            </div>
            <div class="layui-colla-content layui-show" style="margin-top: 10px;border:none;">
                <table class="layui-table class-td-6" style="border: none;margin: 0;">
                    <tbody>
                    <tr>
                        <td class="textRight" >#springMessage('银行流水号')</td>
                        <td class="bisAccDtlVO-bankSerialNo"></td>

                        <td class="textRight" >#springMessage('交易日期')</td>
                        <td class="bisAccDtlVO-transTime"></td>

                        <td class="textRight" >#springMessage('流水时间')</td>
                        <td class="bisAccDtlVO-transDateTime"></td>
                    </tr>
                    <tr>
                        <td class="textRight"  >#springMessage('本方账户名')</td>
                        <td class="bisAccDtlVO-accName"></td>

                        <td class="textRight"  >#springMessage('本方账户银行名称')</td>
                        <td class="bisAccDtlVO-bankName"></td>

                        <td class="textRight" >#springMessage('本方账号')</td>
                        <td class="bisAccDtlVO-bankAcc"></td>
                    </tr>
                    <tr>
                        <td class="textRight"  >#springMessage('对方账户名')</td>
                        <td class="bisAccDtlVO-oppAccName"></td>

                        <td class="textRight" >#springMessage('对方账号')</td>
                        <td class="bisAccDtlVO-oppAccNo"></td>

                        <td class="textRight" >#springMessage('用途')</td>
                        <td class="bisAccDtlVO-uses"></td>
                    </tr>
                    <tr>
                        <td class="textRight" >#springMessage('金额')</td>
                        <td class="bisAccDtlVO-amt"></td>

                        <td class="textRight" >#springMessage('可核销金额')</td>
                        <td class="bisAccDtlVO-writeOffBal"></td>

                        <td class="textRight" >#springMessage('执行金额')</td>
                        <td class="bisAccDtlVO-executeMoney"></td>
                    </tr>
                    <tr>
                        <td class="textRight" >#springMessage('当前状态')</td>
                        <td class="bisAccDtlVO-writeOffStatusName"></td>

                        <td class="textRight" >#springMessage('核销后状态')</td>
                        <td class="afterRelationWriteOffStatusName"></td>

                        <td class="textRight" >#springMessage('附言')</td>
                        <td class="bisAccDtlVO-postscript"></td>
                    </tr>
                    <tr>
                        <td class="textRight" >#springMessage('币种')</td>
                        <td class="bisAccDtlVO-curName"></td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/writeOff/viewDetailAuto.js?_btv=${resourceVersion}"></script>
</html>
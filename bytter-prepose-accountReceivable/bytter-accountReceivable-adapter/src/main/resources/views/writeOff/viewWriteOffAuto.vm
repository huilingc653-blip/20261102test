<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

    <style>
        .tips{
            background-color: #E0FFFF;
			height:20px;
			border: 1px solid rgba(220,220,220,1);
			border-radius: 4px;
			padding: 20px;
		}
		.tips > span{
			display: block;
			font-size: 15px;
			color: #666666;
			line-height: 22px;
			font-weight: 400;
		}


        div.dt-buttons {
            padding-bottom: 0px;
            padding-top: 0px;
        }

		.dataTables_scroll table.dataTable thead tr:first-child th:first-child {
             border-right: 1px solid #DFE0E4;
        }

        .submitcol-button.disabled {
            display: none;
        }
    </style>
</head>
<body>
<div class="tips">
    <span id="bankAccTypeStr">

    </span>
</div>
<form id="sureSearchForm" class="layui-form">
    <input type="hidden" name="docId" id="docId" value="$!{relationVo.docId}"/>
    <input type="hidden" name="relationId" id="relationId" value="$!{relationVo.relationId}"/>
    <input type="hidden" name="writeOffType" id="writeOffType" value="$!{relationVo.writeOffType}"/>
    <input type="hidden" name="paymentMeans" id="paymentMeans" value="$!{relationVo.paymentMeans}"/>
    <input type="hidden" name="exchangeRate" id="exchangeRate" value="$!{relationVo.exchangeRate}"/>

    <table id="appTableSure" class="layui-table layui-form" style="width:100%;" data-biz-name="appTableSure">
        <thead>

        <tr class="title">
            <th colspan="5">#springMessage('应收单信息')</th>
            <th colspan="5">#springMessage('匹配收入信息')</th>
        </tr>

        <tr class="title">
            <th>单据编号</th>
            <th>应收余额</th>
            <th>执行金额</th>
            <th>当前状态</th>
            <th>核销后状态</th>

            <th>银行流水号</th>
            <th>可核销金额</th>
            <th>执行金额</th>
            <th>当前状态</th>
            <th>核销后状态</th>

            <th>#springMessage('操作')</th>
        </tr>
        </thead>
    </table>

    <table class="layui-table">
        <tbody>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button type="button" class="layui-btn layui-btn-primary" style="background-color: #E7E7E7;" onclick="cancle()">#springMessage('取消')</button>
                <button class="layui-btn" lay-submit="" lay-filter="submit" style="background-color: #C70D0D;color: #FFFFFF;">#springMessage('确定')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/writeOff/writeOffAuto.view.js?_btv=${resourceVersion}"></script>
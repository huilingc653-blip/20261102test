<style>
    body{
        padding: 40px;
        background: #E6E9F0;
    }
    .font-til{
        font-size: 14px;
        color: black;
        font-weight:bold;
    }
    .font-content{
        color: black;
    }
    .itemBg{
        background-color: #7dd1f152;
    }
    .ml-5{
        margin-left: 5px;
    }
    .pl-5{
        padding-left: 5px;
    }
    .mr-5{
        margin-right: 5px;
    }
    .mt-10{
        margin-top: 10px;
    }
    .ml-10{
        margin-left: 10px;
    }
    .mr-10{
        margin-right: 10px;
    }
    .elm-item{
        background: white;
        padding: 20px;
        margin-bottom: 20px;
    }
    .bs1{
        border: 1px solid #c9c9c9;
     }
     .dfc{
        color: #818080;
        font-size:14px;
     }
     .elm-item-til{
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid #c9c9c9;
        padding-bottom: 10px;
     }
     .elm-item-til-info{
        /*border-left: 5px solid #C70D0D;*/
     }
     .elm-item-content{
        padding: 0 40px;
        font-size: 16px;
     }
     .elm-item-content .layui-inline{
        display: flex;
     }
     .elm-item-content-item{
        width: 33%;
        display: flex;
     }
     .cur-bg{
        background-color: #c9c9c9;
        padding: 5px 10px;
        border-top-left-radius: 2px;
        border-bottom-left-radius: 2px;
     }
     .elm-center{
        display:flex;
        align-items: center;
     }
     .rate0 .layui-input{
        width:100px !important;
        height:30px !important;
        border-left: 0;
        border-right: 0;
     }
     .rate0 .layui-btn{
        font-family: FZLTHIW!important;
        height: 30px!important;
        background: #C70D0D!important;
        border-top-right-radius: 2px!important;
        border-top-left-radius: 0!important;
        border-bottom-right-radius: 2px!important;
        border-bottom-left-radius: 0!important;
        color: #fff!important;
        padding: 0 10px!important;
        border: none!important;
     }
     .item-til{
        display: inline-block;
        min-width: 130px;
     }
</style>

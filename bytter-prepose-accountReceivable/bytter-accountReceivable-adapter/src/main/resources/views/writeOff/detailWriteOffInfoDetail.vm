#if($!{docManageVo})
<div class="elm-item">
    <div class="elm-item-til">
        <div class="elm-item-til-info pl-5 font-til">#springMessage('强制核销')</div>
    </div>
    <div class="elm-item-content">
        <div class="layui-inline">
            <div class="elm-item-content-item mt-10">
                <span class="item-til textRight">#springMessage('应收单据编号')</span>
                <span class="ml-10 font-content">$!{docManageVo.code}</span>
            </div>
            <div class="elm-item-content-item mt-10" >
                <span class="item-til textRight">#springMessage('强制核销类型')</span>
                <span class="ml-10 font-content dateStr">$dictTag.get("writeOff.force.reason",$!{docManageVo.forceReasonType})</span>
            </div>
            <!--1.收入的结算方式为现金或支票,2.异币种核销后的汇率尾差,3.确认不再作为应收款进行管理--->
            #if($!{docManageVo.forceReasonType}=='1')
            <div class="elm-item-content-item mt-10" >
                <span class="item-til textRight">#springMessage('收入结算方式')</span>
                <span class="ml-10 font-content dateStr">$dictTag.get("writeOff.force.paymentMeans",$!{docManageVo.forcePaymentMeans})</span>
            </div>
            #end
            #if($!{docManageVo.forceReasonType}=='3')
            <div class="elm-item-content-item mt-10" >
                <span class="item-til textRight">#springMessage('强制核销原因')</span>
                <span class="ml-10 font-content dateStr">$!{docManageVo.forceReason}</span>
            </div>
            #end

        </div>

        <div class="layui-inline">

            <div class="elm-item-content-item mt-10">
                <span class="item-til textRight">#springMessage('业务类型')</span>
                <span class="ml-10 font-content">$!{docManageVo.batchBusTypeName}</span>
            </div>
            <div class="elm-item-content-item mt-10">
                <span class="item-til textRight">#springMessage('本次核销类型')</span>
                <span class="ml-10 font-content">$dictTag.get("writeOff.type",$!{docManageVo.writeOffType})</span>
            </div>
        </div>
        <div class="layui-inline">
            <div class="elm-item-content-item mt-10">
                <span class="item-til textRight">#springMessage('单位')</span>
                <span class="ml-10 font-content">$!{docManageVo.corpName}</span>
            </div>
            <div class="elm-item-content-item mt-10">
                <span class="item-til textRight">#springMessage('客商名称')</span>
                <span class="ml-10 font-content">$!{docManageVo.externalName}</span>
            </div>

            <div class="elm-item-content-item mt-10">
                <span class="item-til textRight">#springMessage('单据来源')</span>
                <span class="ml-10 font-content">$dictTag.get("writeOff.docSource",$!{docManageVo.source})</span>
            </div>
        </div>
        <div class="layui-inline">
            <div class="elm-item-content-item mt-10">
                <span class="item-til textRight">#springMessage('单据日期')</span>
                <span class="ml-10 font-content">$!date.format('yyyy-MM-dd',$!{docManageVo.receiptDate})</span>
            </div>
            <div class="elm-item-content-item mt-10">
                <span class="item-til textRight">#springMessage('到期日期')</span>
                <span class="ml-10 font-content">$!date.format('yyyy-MM-dd',$!{docManageVo.endDate})</span>
            </div>
            <div class="elm-item-content-item mt-10">
                <span class="item-til textRight">#springMessage('账龄起算日')</span>
                <span class="ml-10 font-content">$!date.format('yyyy-MM-dd',$!{docManageVo.agingDate})</span>
            </div>
        </div>
        <div class="layui-inline">
            <div class="elm-item-content-item mt-10">
                <span class="item-til textRight">#springMessage('本次核销前应收余额')</span>
                <span class="ml-10 font-content">$!{docManageVo.beforeWriteOffBal}</span>
            </div>
            <div class="elm-item-content-item mt-10">
                <span class="item-til textRight">#springMessage('核销金额')</span>
                <span class="ml-10 font-content timeStr">$!{docManageVo.afterDocWriteOffBal}</span>
            </div>

            <div class="elm-item-content-item mt-10">
                <span class="item-til textRight">#springMessage('本次核销后应收余额')</span>
                <span class="ml-10 font-content">$!{docManageVo.relationConvertMoney}</span>

            </div>
        </div>
    </div>
</div>
#end




#parse("views/common/footer.vm")
</body>
<script>
    var arr = $('span');
    for(var i = 0; i < arr.length; i++) {
        var content = $(arr[i]).text();
        if(!content){
            $(arr[i]).text("-");
        }
    }
    var arr2 = $('.dateStr');
    for(var i = 0; i < arr2.length; i++) {
        var content = $(arr2[i]).text();
        if(content){
            $(arr2[i]).text($(arr2[i]).text().split(' ')[0]);
        }
    }
    var arr3 = $('.timeStr');
    for(var i = 0; i < arr3.length; i++) {
        var content = $(arr3[i]).text();
        if(content){
            $(arr3[i]).text($(arr3[i]).text().split(' ')[1].split('.')[0]);
        }
    }
</script>

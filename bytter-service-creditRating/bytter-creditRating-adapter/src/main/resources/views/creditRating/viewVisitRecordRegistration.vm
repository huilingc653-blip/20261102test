<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <table class="layui-table">
        <tbody>
        <tr>
            ## 拜访事项
            <td class="textRight">#springMessage('table.institution.visitingMatters')</td>
            <td >$!{visitVo.visitingMatters}</td>
        </tr>
        <tr>
            ## 拜访人员
            <td class="textRight">#springMessage('table.institution.visitingPersonnel')</td>
            <td>$!{visitVo.visitingPersonnel}</td>
        </tr>
        <tr>
            ## 拜访对象
            <td class="textRight">#springMessage('table.institution.visitingObject')</td>
            <td >$!{visitVo.visitingObj}</td>
        </tr>
        <tr>
            ## 拜访对象职务
            <td class="textRight">#springMessage('table.institution.visitingObject.job')</td>
            <td >$!{visitVo.visitingObjJob}</td>
        </tr>
        <tr>
            ## 拜访日期
            <td class="textRight">#springMessage('table.institution.visitingDate')</td>
            <td >$!date.format('yyyy-MM-dd',$!{visitVo.visitDate})</td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('common.message.remark')</td>
            <td >$!{visitVo.rmk}</td>
        </tr>
        <tr>
            ## 创建人
            <td class="textRight">#springMessage('table.common.createby')</td>
            <td >$!{visitVo.creator}</td>
        </tr>
        <tr>
            ## 创建日期
            <td class="textRight">#springMessage('table.common.createDate')</td>
            <td >$!date.format('yyyy-MM-dd HH:mm:ss',$!{visitVo.createDate})</td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
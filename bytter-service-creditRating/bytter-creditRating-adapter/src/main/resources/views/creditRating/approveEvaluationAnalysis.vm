<!DOCTYPE html>
<html lang="en">
<body>
	<form class="layui-form layui-form-pane">
		<input type="hidden" id="taskId" name= "taskId" value="$!{taskId}">
		<input type="hidden" id="taskNo" name= "taskNo" value="$!{crTaskInfo.taskNo}">
		<input type="hidden" id="corpId" name= "corpId" value="$!{crTaskInfo.corpId}">
	</form>
	##parse("views/bankacc/viewBtBankAccHandle.vm")
	#parse("views/creditRating/viewEvaluationAnalysis.vm")
	#workFlowHtml($!{btnPrependHtml})
	#workFlowScript()

	<script>
		bt.use(['form','jquery'], function(){
			var $ = bt.jquery,form = bt.form();
			bt.workFlow.beforeSubmit = function(submitData){
				var taskIds = [];
				taskIds.push($("#taskId").val());
				bt.workFlow.taskList = taskIds;
				return true;
			}
			bt.workFlow.afterSubmit = function(){
				parent.layer?parent.layer.closeAll():layer.closeAll();
			}
		});
	</script>
</body>
</html>
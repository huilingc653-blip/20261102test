<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="id" name="id" value="$!{scoringGrade.id}">
    ##主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.crmModel.mainMessage')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        ##评分标准代码
                        <td class="textRight">#springMessage('table.crmScoringGrade.code')</td>
                        <td>
                            $!{scoringGrade.scoringGradeCode}
                        </td>
                        ##评分标准名称
                        <td class="textRight">#springMessage('table.crmScoringGrade.name')</td>
                        <td>
                            <input id="scoringGradeName" name="scoringGradeName" value="$!{scoringGrade.scoringGradeName}"
                                   class="layui-input" type="text" lay-verify="required"
                                   placeholder="#springMessage('table.crmScoringGrade.name')" maxlength="100"/>
                        </td>
                    </tr>
                    <tr>
                        ##机构类别
                        <td class="textRight">#springMessage('table.crTaskInfo.orgType')</td>
                        <td>
                            <div class="layui-inline">
                                ##机构类别
                                <div class="bt-biz-dict" data-name="institutionType" data-type="mulselect"
                                     data-biz-name="institutionType"  data-required="true" data-value="$!{scoringGrade.institutionType}"
                                     data-group="INSTITUTIONA_TYPE"
                                ></div>
                            </div>
                        </td>
                        ##有效标志
                        <td class="textRight">#springMessage('table.choProduct.validSign')</td>
                        <td>
                            <div class="bt-biz-dict" id="radio" data-type="radio" data-group="valid_sign"
                                 data-defaultvalue="1"   data-required="true" data-value="$!{scoringGrade.validSign}"
                                 data-name="validSign" data-biz-name="validSign">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.repay.rmk')</td>
                        <td  colspan="3">
                    <textarea type="text" id="scoringGradeDescription" name="scoringGradeDescription" class="layui-textarea"
                              data-maxlength="200"  placeholder="#springMessage('table.repay.rmk')">$!{scoringGrade.scoringGradeDescription}</textarea>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    ##评分等级
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.crmScoringGrade.level')</h2>
            ##            <div class="layui-colla-content layui-show">
            ##                <br>
            ##                <table>
            ##                    <td>#springMessage('积分制')</td>
            ##                    <td>   <input id="scoringSystem" name="scoringSystem" value=""
            ##                                  class="layui-input bt-biz-moneyType" data-decimal="0"  type="text" lay-verify="required"
            ##                                  placeholder="#springMessage('积分制')"/>
            ##                    </td>
            ##                </table>
            ##            </div>
            <br>
            <table id="dataTable" class="layui-table ignore-required-icon">
                <thead>
                <tr>
                    <th>#springMessage('table.crmScoringGrade.conditions')</th>
                    <th>#springMessage('table.crmScoringGrade.score')</th>
                    <th>#springMessage('table.crmScoringGrade.grade')</th>
                    <th>#springMessage('table.repay.rmk')</th>
                    <th>#springMessage('sys.organtype.operate')</th>
                </tr>
                </thead>
                <tbody>
                #foreach($gradeLevel in $gradeLevels)
                    #set($vcount = $velocityCount - 1)
                <tr data-row="${vcount}">
                    <td style="text-align:center">

                        <div class="bt-biz-dict" data-type="select" data-width="70px" data-group="FUNDWARN_OPERATOR"
                             data-value="$!{gradeLevel.scoringSymbol}" data-inputvalue="false"
                             #if($vcount=="0")
                             data-filterData="20,21"
                             #elseif($!{gradeLevel.scoringSymbol}=="10"||$!{gradeLevel.scoringSymbol}=="21")
                             data-filterData="11,20"
                             #elseif($!{gradeLevel.scoringSymbol}=="11"||$!{gradeLevel.scoringSymbol}=="20")
                             data-filterData="10,21"
                             #end
                             id="scoringSymbol${vcount}" data-biz-name="scoringSymbol${vcount}" data-name="gradeLevels[${vcount}].scoringSymbol"
                             data-placeholder="" data-required="true" data-callBack="makeUpperScore"
                        ></div>
                        <div class="layui-input-inline">
                            <input class="layui-input   bt-biz-moneyType" type="text" id="scoreLimitLevel${vcount}" data-biz-name="scoreLimitLevel${vcount}"
                                   style="width: 120px;" autocomplete="off" data-decimal="0" data-callBack="makeUpperScore" data-name="gradeLevels[${vcount}].scoreLimitLevel"
                                   data-maxlength="18" lay-verify="required" value="$!{gradeLevel.scoreLimitLevel}">
                        </div>
                    </td>
                    <input type="hidden" id="upperScoreLimitLevel${vcount}" name="gradeLevels[${vcount}].upperScoreLimitLevel" value="$!{gradeLevel.upperScoreLimitLevel}">
                    <input type="hidden" id="lowerScoreLimitLevel${vcount}" name="gradeLevels[${vcount}].lowerScoreLimitLevel" value="$!{gradeLevel.lowerScoreLimitLevel}">
                    <input type="hidden" id="upScoringSymbol${vcount}" name="gradeLevels[${vcount}].upScoringSymbol" value="$!{gradeLevel.upScoringSymbol}">
                    <input type="hidden" id="downScoringSymbol${vcount}" name="gradeLevels[${vcount}].downScoringSymbol" value="$!{gradeLevel.downScoringSymbol}">
                    <td id="showRow${vcount}" style="text-align:center">

                    </td>
                    <td>
                        <input id="scoringLevel${vcount}" name="gradeLevels[${vcount}].scoringLevel" value="$!{gradeLevel.scoringLevel}"
                               data-maxlength="10" class="layui-input" type="text" lay-verify="required"/>
                    </td>
                    <td>
                        <input id="explanationOfScoringLevel${vcount}" name="gradeLevels[${vcount}].explanationOfScoringLevel" value="$!{gradeLevel.explanationOfScoringLevel}"
                               data-maxlength="300" class="layui-input" type="text"/>
                    </td>

                    <td id="showBon${vcount}" style="text-align:center">

                    </td>

                </tr>
                 #end
                </tbody>
            </table>
        </div>
    </div>
    <br>
    <br>
    <div style="text-align:center">
        <button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/creditRating/scoringGrade.add.js?_btv=${resourceVersion}"></script>
</body>
</html>

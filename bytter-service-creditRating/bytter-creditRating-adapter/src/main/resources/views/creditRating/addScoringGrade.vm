<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    ##主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.crmModel.mainMessage')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
##                        ##评级标准编码
##                        <td class="textRight">#springMessage('table.crmScoringGrade.code')</td>
##                        <td>
##                            <input id="scoringGradeCode" name="scoringGradeCode" value=""
##                                   class="layui-input" type="text" lay-verify="required"
##                                   placeholder="#springMessage('table.crmScoringGrade.code')" maxlength="10"/>
##                        </td>
                        ##评分标准名称
                        <td class="textRight">#springMessage('table.crmScoringGrade.name')</td>
                        <td>
                            <input id="scoringGradeName" name="scoringGradeName" value=""
                                   class="layui-input" type="text" lay-verify="required"
                                   placeholder="#springMessage('table.crmScoringGrade.name')" maxlength="100"/>
                        </td>
                        ##有效标志
                        <td class="textRight">#springMessage('table.choProduct.validSign')</td>
                        <td>
                            <div class="bt-biz-dict" id="radio" data-type="radio" data-group="valid_sign"
                                 data-defaultvalue="1"   data-required="true"
                                 data-name="validSign" data-biz-name="validSign">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##机构类别
                        <td class="textRight">#springMessage('table.crTaskInfo.orgType')</td>
                        <td>
                        <div class="layui-inline">
                            ##机构类别
                            <div class="bt-biz-dict" data-name="institutionType" data-type="mulselect"
                                 data-biz-name="institutionType"  data-required="true"
                                  data-group="INSTITUTIONA_TYPE"
                            ></div>
                        </div>
                        </td>

                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.repay.rmk')</td>
                        <td  colspan="3">
                    <textarea type="text" id="scoringGradeDescription" name="scoringGradeDescription" class="layui-textarea"
                              data-maxlength="200"     placeholder="#springMessage('table.repay.rmk')"></textarea>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    ##评分等级
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.crmScoringGrade.level')</h2>
##            <div class="layui-colla-content layui-show">
##                <br>
##                <table>
##                    <td>#springMessage('积分制')</td>
##                    <td>   <input id="scoringSystem" name="scoringSystem" value=""
##                                  class="layui-input bt-biz-moneyType" data-decimal="0"  type="text" lay-verify="required"
##                                  placeholder="#springMessage('积分制')"/>
##                    </td>
##                </table>
##            </div>
            <br>

            <table id="dataTable" class="layui-table ignore-required-icon">
                <thead>
                <tr>
                    <th>#springMessage('table.crmScoringGrade.conditions')</th>
                    <th>#springMessage('table.crmScoringGrade.score')</th>
                    <th>#springMessage('table.crmScoringGrade.grade')</th>
                    <th>#springMessage('table.repay.rmk')</th>
                    <th>#springMessage('table.cmsBond.operation')</th>
                </tr>
                </thead>
                <tbody>
                <tr data-row="0">
                    <td style="text-align:center">

                        <div class="bt-biz-dict" data-type="select" data-width="70px" data-group="FUNDWARN_OPERATOR"
                             data-defaultvalue="10" data-inputvalue="false"  data-filterData="20,21"
                             id="scoringSymbol0" data-biz-name="scoringSymbol0" data-name="gradeLevels[0].scoringSymbol"
                             data-placeholder="" data-required="true" data-callBack="makeUpperScore"
                        ></div>
                        <div class="layui-input-inline">
                            <input class="layui-input   bt-biz-moneyType" type="text" id="scoreLimitLevel0" data-biz-name="scoreLimitLevel0"
                                   style="width: 120px;" autocomplete="off" data-decimal="0" data-callBack="makeUpperScore" data-name="gradeLevels[0].scoreLimitLevel"
                                   data-maxlength="18" lay-verify="required">
                        </div>
                    </td>
                    <input type="hidden" id="upperScoreLimitLevel0" name="gradeLevels[0].upperScoreLimitLevel">
                    <input type="hidden" id="lowerScoreLimitLevel0" name="gradeLevels[0].lowerScoreLimitLevel">
                    <input type="hidden" id="upScoringSymbol0" name="gradeLevels[0].upScoringSymbol">
                    <input type="hidden" id="downScoringSymbol0" name="gradeLevels[0].downScoringSymbol">
                    <td id="showRow0" style="text-align:center">

                    </td>
                    <td>
                        <input id="scoringLevel0" name="gradeLevels[0].scoringLevel" value=""
                               data-maxlength="10"  class="layui-input" type="text" lay-verify="required"/>
                    </td>
                    <td>
                        <input id="explanationOfScoringLevel0" name="gradeLevels[0].explanationOfScoringLevel" value=""
                               data-maxlength="300" class="layui-input" type="text"/>
                    </td>

                    <td id="showBon0" style="text-align:center">
                        <button class="layui-btn"  type="button"
                                onclick="addTr()" >#springMessage('common.button.add')
                        </button>
                    </td>

                </tr>
                </tbody>
            </table>
        </div>
    </div>
    <br>
    <br>
    <div style="text-align:center">
        <button class="layui-btn" lay-submit="" id="submit">#springMessage(
                                'common.button.submit')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                'common.button.reset')</button>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/creditRating/scoringGrade.add.js?_btv=${resourceVersion}"></script>
</body>
</html>

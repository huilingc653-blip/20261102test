<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <input type="hidden" id="update" name="update" value="0">
        <table class="layui-table">
            <tbody>
            <tr>
                ##姓名
                <td class="textRight">#springMessage('table.institution.userName')</td>
                <td >
                    <input type="text" id="name" name="name"
                           autocomplete="off" class="layui-input"
                           lay-verify="strlength" data-maxlength="64"
                           class="layui-input"
                           placeholder="#springMessage('table.institution.userName')">
                </td>
            </tr>
            <tr>
                ##性别
                <td class="textRight">#springMessage('table.common.gender')</td>
                <td>
                    <input type="text" id="sex" name="sex"
                           autocomplete="off" class="layui-input"
                           lay-verify="strlength" data-maxlength="100"
                           placeholder="#springMessage('table.common.gender')">
                </td>
            </tr>
            <tr>
                ##职务
                <td class="textRight">#springMessage('table.institution.job')</td>
                <td>
                    <input type="text" id="job" name="job"
                           autocomplete="off" class="layui-input"
                           lay-verify="strlength" data-maxlength="100"
                           placeholder="#springMessage('table.institution.job')">
                </td>
            </tr>
            <tr>
			##电话号码
                <td class="textRight">#springMessage('table.institution.telephoneNum')</td>
                <td>
                    <input type="text" id="telephoneNum" name="telephoneNum"
                           autocomplete="off" class="layui-input"
                           lay-verify="strlength" data-maxlength="100"
                           placeholder="#springMessage('table.institution.telephoneNum')">
                </td>
            </tr>
            <tr>
			##邮箱
                <td class="textRight">#springMessage('table.common.email')</td>
                <td>
##                    <input type="text" id="email" name="email"
##                           autocomplete="off" class="layui-input"
##                           lay-verify="strlength" data-maxlength="100"
##                           placeholder="#springMessage('table.common.email')">
                    <input type="text" id="email" name="email" autocomplete="off"
                           class="layui-input"
                           lay-verify="emailFex|strlength" data-maxlength="100"
                           placeholder="#springMessage('table.common.email')">
                </td>
            </tr>
            <tr>
			##微信号
                <td class="textRight">#springMessage('table.common.weChatNum')</td>
                <td >
                    <input type="text" id="weChatNum" name="weChatNum"
                           autocomplete="off"
                           class="layui-input"
                           lay-verify="strlength"
                           data-maxlength="128"
                           placeholder="#springMessage('table.common.weChatNum')">
                </td>
            </tr>
            <tr>
                ##QQ号
                <td class="textRight">#springMessage('table.common.QQNum')</td>
                <td >
                    <input type="text" id="qqNum" name="qqNum"
                           autocomplete="off"
                           class="layui-input"
                           lay-verify="strlength"
                           data-maxlength="128"
                           placeholder="#springMessage('table.common.QQNum')">
                </td>
            </tr>
            <tr>
			##备注
                <td class="textRight">#springMessage('common.message.remark')</td>
                <td >
                    <textarea type="text" id="rmk" name="rmk" class="layui-textarea"
                              placeholder="#springMessage('table.cmsProvideLoanInfo.rmk')"></textarea>
                </td>

            </tr>

            <tr>
                <td colspan="6" style="text-align: center;">
                    <button type="button" class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/contactAddressBook.add.js?_btv=${resourceVersion}"></script>
</html>
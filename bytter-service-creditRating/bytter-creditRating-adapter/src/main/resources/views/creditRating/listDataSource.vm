<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="get" action="${basePath}/creditRating/dataSource/list">
    <table class="layui-table">
        <tbody>
        <tr>
            ##指标类别
            <td class="textRight" width="10%">#springMessage('credit.indicator.dataSource')</td>
            <td width="20%">
                <div class="layui-inline">
                    <input  class="layui-input" type="text" name="dataSourceName" id="dataSourceName" value="$!{dataSourceName}" >
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
##                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button class="layui-btn" type="submit">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallback">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form breakRow" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('sys.organtype.operate')</th><!--指标类别名称  -->
        <th>#springMessage('credit.indicator.dataSource')</th><!--指标类别说明  -->
        <th>#springMessage('取值来源')</th><!--创建日期  -->
    </tr>
    </thead>
    <tbody>
    #foreach($vo in $!{list})
    <tr>
        <td style="width: 10%;text-align: center;" ><a href="#" class="select-dataSource" data-id="$!{vo.id}">#springMessage('common.button.select')</a></td>
        <td class="source-name" style="width: 20%">$!{vo.dataSourceName}</td>
        <td class="source-origin" style="width: 70%">$!{vo.dataSourceOrigin}</td>
        <input type="hidden" class="source-code" value="$!{vo.dataSourceCode}">
    </tr>
    #end
    </tbody>
</table>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form','selectType','dicts'], function() {
        var $ = bt.jquery, form = bt.form();
        $(".select-dataSource").on('click',function (data) {
            var data = {
                id:$(this).data('id'),
                dataSourceName:$(this).parents('tr').find('.source-name').text(),
                dataSourceCode:$(this).parents('tr').find('.source-code').val(),
                dataSourceOrigin:$(this).parents('tr').find('.source-origin').text()
            }
            bt.navtab.getCurrentDom().dataSourceCallback && bt.navtab.getCurrentDom().dataSourceCallback(data);
            parent.layer ? parent.layer.closeAll() : layer.closeAll();
        })
    })
    function resetCallback() {
        $("#dataSourceName").val("")
    }
</script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .treetable  input.table-checkbox{
            width: 16px;
            height: 16px;
            margin-top: 6px;
            border-color: #c2c2c2;
            margin-left: 2px;
        }
        .layui-table > thead >tr > th {
            padding: 0 10px;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form" method="get" action="${basePath}/creditRating/computationalModel/tickIndicator">
    <table class="layui-table">
        <tbody>
        <tr>
            <input type="hidden" name="scoringIds" id="scoringIds" value="$!{scoringIds}"/>
            ##指标类别编号
            <td class="textRight" width="10%">#springMessage('credit.indicator.type.code')</td>
            <td width="20%">
                <div class="layui-inline">
                    <input  class="layui-input" type="text" name="scoringIndicatorCode" id="scoringIndicatorCode" value="$!{scoringIndicatorCode}">
                </div>
            </td>
            ##指标类别名称
            <td class="textRight" width="10%">#springMessage('credit.indicator.type.name')</td>
            <td width="20%">
                <div class="layui-inline">
                    <input  class="layui-input" type="text" name="scoringIndicatorName" id="scoringIndicatorName" value="$!{scoringIndicatorName}">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" type="submit">#springMessage('common.button.search')</button>
                <button type="button" class="layui-btn layui-btn-primary" onclick="resetDate()">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<div style="padding-bottom: 50px;">
    <button class="layui-btn"  type="button"
            onclick="expandAll()" >#springMessage('common.open.all') </button>
    <button class="layui-btn"  type="button"
                onclick="collapseAll()" >#springMessage('common.close.all')</button>
    <table id="scoringIndicatorTable" class="layui-table treetable layui-form breakRow" style="width:100%;">
        <thead>
        <tr>
         <th width="20"><input class="table-checkbox" type="checkbox" name="" lay-skin="primary" id="checkallcorp" lay-ignore style="margin-left: 0;">
        </th><!--序号  -->
            <th style="min-width: 140px;">#springMessage('credit.indicator.type.code')</th><!--指标类别编码  -->
            <th >#springMessage('credit.indicator.type.name')</th><!--指标类别名称  -->
            <th>#springMessage('credit.indicator.rmk')</th><!--备注  -->

        </tr>
        </thead>
        <tbody>
            #foreach($vo in $treeDate)
            <tr data-tt-id="$!{vo.id}" data-tt-parent-id="$!{vo.parentId}" data-tt-voject-sort="$!{vo.scoringIndicatorCode}" >
                <td>
                    <input type="checkbox" name="checkIds" class="checkIds table-checkbox" id="$!{vo.id}" data-parentid="$!{vo.parentId}"
                            #if("1"==$!{vo.isChecked})
                           checked="checked"
                            #end
                           lay-skin="primary" value="$!{vo.id}" lay-filter="itemCorp" lay-ignore/>
                </td>
                <td align="center">
                    $!{vo.scoringIndicatorCode}
                </td>
                <td width="30%">
                    <span class="type-name">$!{vo.scoringIndicatorName}</span>
                </td>
                <td>
                    $!{vo.scoringIndicatorDescription}
                </td>
            </tr>
            #end
        </tbody>
    </table>
    <div style="position: fixed;bottom: 0;left: 0;width: 100%;background-color:#fff;height: 48px;line-height: 48px;text-align: center;">
        <button class="layui-btn"  type="button" onclick="submitData()" >#springMessage('common.button.confirm')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/creditRating/tickIndicator.list.js?_btv=${resourceVersion}"></script>
</body>
</html>


<form class="layui-form" method="post">
    <input type="hidden" id="id" name="id" value="$!{vo.id}">
    <input type="hidden" id="regionalCodeName" name="regionalCodeName" value="$!{vo.regionalCodeName}">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.common.basicInfo')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table breakRow">
                    <tbody>
                    <tr>
                        ##机构类别
                        <td class="textRight">#springMessage('table.institution.type')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="select" data-group="INSTITUTIONA_TYPE"
                                 data-name="institutionType"
                                 data-value="$!{vo.institutionType}"
                                 data-callback="instTypesCallBack" data-required="true"></div>
                        </td>
                        ##机构名称
                        <td class="textRight">
                            <span class="pl"><span class="required-icon">*</span></span>#springMessage('table.institution.name')</td>
                        ##机构类别：总行 下拉框 取值 银行类型管理中有效的银行类型
                        <td id="org-box">
                            ##                        <td id="headOffice"> if()
                            <div id="headOffice" class="layui-input-inline #if($!{vo.institutionType} != "001") layui-hide #end">
                                <div class="bt-biz-selectType"
                                     data-biz-name="institutionName"
                                     data-url="${basePath}/basic/business/btbanktype/json" data-valuefield="bankType"
                                     data-textfield="typeName"
                                     data-name="institutionName"
                                     data-callback = "initBankTypeCallBack"
                                     #if($!{vo.institutionType} == "001")
                                         data-required="true"
                                     #end

                                     data-value="$!{vo.institutionNameCode}"></div>
                            </div>
                            ##机构类别：支行
                            <div id="branchOffice" class="#if($!{vo.institutionType} != "002") layui-hide #end">
                                <div class="layui-inline">
                                    <input class="layui-input" id="shouBankName" name="shouBankName" value="$!{vo.institutionName}"
                                                                                   readonly="readonly" type="text"
                                    #if($!{vo.institutionType} == "002") lay-verify = "required"
                                    #end/>
                                    <input type="hidden" name="shouBankNameId" id="shouBankNameId" value="$!{vo.institutionNameCode}">
                                    <input type="hidden" name="bankCode" id="bankCode" value="$!{vo.bankCode}">
                                    <div class="bt-div-search">
                                        ## 境内境外联行号组件
                                        <button type="button" class="bt-biz-domesticAndOverseasBank"
                                                data-beforeClick="bt.domesticAndOverseasBankBeforeClick"
                                                data-callback="domesticAndOverseasBankCallback">
                                            <i class="layui-icon">&#xe615;</i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div id="other" class="#if($!{vo.institutionType} == "001" || $!{vo.institutionType} == "002") layui-hide #end">
                                <input type="text" id="otherInstitutionName" name="otherInstitutionName" lay-verify="strlength"
                                       data-maxlength="200"
                                       autocomplete="off" class="layui-input value" value="$!{vo.institutionName}">
                            </div>

                        </td>
                    </tr>
                        #if($!{vo.institutionType} == "001" || $!{vo.institutionType} == "002")

                        <tr id="bankTypeTR">
                            ##银行种类 <span class="required"><b>*&nbsp;</b></span>
                            <td class="textRight">#springMessage('btBankType.bankKind')</td>
                            <td>
                                <div class="bt-biz-dict" data-group="sys.bankType" data-name="bankType"
                                     data-biz-name="bankType" data-type="select" data-value="$!{vo.bankType}">
                                </div>
                            </td>
                            </td>
                            <td></td>
                            <td></td>
                        </tr>
                        #end
                    <tr>
                        ##金融许可证机构编码
                        <td class="textRight">#springMessage('financial.license.institution.code')</td>
                        <td>
                            <input type="text" id="financialLicenseInstCode"
                                   name="financialLicenseInstCode"
                                   autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="200"
                                   value="$!{vo.financialLicenseInstCode}">
                        </td>
                        ##统一社会信用代码
                        <td class="textRight">#springMessage('table.common.socCode')</td>
                        <td>
                            <input type="text" id="unifiedSocialCreditCode" name="unifiedSocialCreditCode"
                                   autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="100"
                                   value="$!{vo.unifiedSocialCreditCode}">
                        </td>
                    </tr>
                    <tr>
                        ##国家/地区
                        <td class="textRight">#springMessage('fex.cotp.countryRegion')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-selectType"
                                     data-biz-name="countryId"
                                     data-url="${basePath}/basic/business/syscountrycust/listSysCountryCust"
                                     data-valuefield="id" data-textfield="nameZh"
                                     data-name="regionalCode" data-value="$!{vo.regionalCode}"
                                     data-callback="setArea" ></div>
                            </div>
                        </td>
                        ##地点
                        <td class="textRight">#springMessage('fex.cotp.place')</td>
                        <td>
                            <div class="layui-input-inline" id="addressDiv">
                                <div class="bt-biz-selectType"
                                     data-url="${basePath}/basic/business/syscountrycust/listSysCountryArea/$!{vo.regionalCode}" data-valuefield="id" data-textfield="nameZh"
                                     data-name="place"
                                     data-defaultValue="$!{vo.place}"></div>
                            </div>
                            <div class="layui-input-inline" id="addrDiv" style="display: none">
                                <div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="prov"
                                     data-biz-name="prov" data-change="city"
                                     data-defaultValue="$!{vo.prov}"
                                     data-callback="bt.provCallback"></div>
                                <div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="city"
                                     data-biz-name="city" data-defaultValue="$!{vo.city}"
                                     data-callback="bt.cityCallback"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                        <td colspan="3">
                            <textarea type="text" id="rmk" name="rmk" class="layui-textarea" lay-verify="strlength" data-maxlength="300">$!{vo.rmk}</textarea>
                        </td>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    ## 工商登记信息：
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.institution.brInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <tbody>
                    <tr>
                        ## 法定代表人
                        <td class="textRight">#springMessage('table.institution.legalRepresentative')</td>
                        <td>
                            <input type="text" id="legalRepresentative" name="legalRepresentative"  class="layui-input"
                                   lay-verify="strlength" maxlength="200" autocomplete="off" value="$!{vo.legalRepresentative}">
                        </td>
                        ##注册资本
                        <td class="textRight">#springMessage('table.creditRating.registeredCapital')</td>
                        <td>
                            <input type="text" id="registeredCapital" name="registeredCapital"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{vo.registeredCapital}">
                        </td>
                    </tr>
                    <tr>
                        ## 成立日期
                        <td class="textRight ">#springMessage('table.institution.dateOfInc')</td>
                        <td>
                            <input type="text" id="establishmentDate" name="establishmentDate"
                                   class="layui-input bt-biz-dateType"
                                   data-type="date" data-biz-name="establishmentDate"
                                   value="$!date.format('yyyy-MM-dd',$!vo.establishmentDate)">
                        </td>
                        ## 营业期限
                        <td class="textRight">#springMessage('table.institution.businessTerm')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="startBusinessPeriod" data-biz-name="startBusinessPeriod"
                                       class="layui-input bt-input-inline  bt-biz-dateType"
                                       data-endid="endBusinessPeriod"
                                       value="$!date.format('yyyy-MM-dd',$!vo.startBusinessPeriod)">
                                <span class="date-mid">~</span>
                                <input type="text" id="endBusinessPeriod"
                                       name="endBusinessPeriod" data-name="endBusinessPeriod"
                                       class="layui-input bt-input-inline  bt-biz-dateType"
                                       value="$!date.format('yyyy-MM-dd',$!vo.endBusinessPeriod)">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 电话
                        <td class="textRight">#springMessage('table.common.tel')</td>
                        <td>
                            <input type="text" id="tel" name="tel"
                                   autocomplete="off" class="layui-input" lay-verify="strlength"
                                   data-maxlength="64" value="$!{vo.tel}">
                        </td>
                        ##邮箱
                        <td class="textRight">#springMessage('table.common.email')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="email" autocomplete="off"
                                       class="layui-input"
                                       lay-verify="emailFex|strlength"
                                       data-maxlength="128"
                                       value="$!{vo.email}">
                            </div>
                        </td>

                    </tr>
                    <tr>
                        ## 人员规模
                        <td class="textRight">#springMessage('table.institution.personnelScale')</td>
                        <td>
                            <input type="text" id="employeeCount" name="employeeCount" maxlength="8" lay-verify="number2"
                                   autocomplete="off" class="layui-input" value="$!{vo.employeeCount}">
                        </td>
                        ## 经营状态
                        <td class="textRight">#springMessage('table.institution.businessStatus')</td>
                        <td>
                            <div class="bt-biz-dict" data-group="business_status"
                                 data-name="businessStatus" data-type="select"
                                 data-value="$!{vo.businessStatus}">
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    ## 股权结构
    <input type="hidden" name="ssIds" id="ssIds" value="$!{vo.ssIds}">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.institution.shareholdingStructure')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <br>
                <table id="ownershipStructure" class="layui-table layui-form breakRow" style="width:100%;">
                    <thead>
                    <tr>
                        <th>#springMessage('table.common.orderNum')</th>
                        <th>#springMessage('table.cmsEquity.investor')</th>
                        <th>#springMessage('table.cmsEquity.financingWay')</th>
                        <th>#springMessage('table.cmsEquity.invWay')</th>
                        <th>#springMessage('table.cmsEquity.invMoney')</th>
                        <th>#springMessage('table.cmsEquity.equityPro')</th>
                        <th>#springMessage('table.cmsEquity.assetName')</th>
                        <th>#springMessage('common.message.remark')</th>
                        <th>#springMessage('common.table.thead.operation')</th>
                    </tr>
                    </thead>
                </table>

            </div>
        </div>
    </div>
    ## 联系人通讯录
    <input type="hidden" name="bookIds" id="bookIds" value="$!{vo.bookIds}">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.institution.contactAddressBook')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <br>
                <table id="contactAddressBook" class="layui-table layui-form breakRow" style="width:100%;">
                    <thead>
                    <tr>
                        <th>#springMessage('table.common.orderNum')</th>
                        <th>#springMessage('table.institution.userName')</th>
                        <th>#springMessage('table.common.gender')</th>
                        <th>#springMessage('table.institution.job')</th>
                        <th>#springMessage('table.institution.telephoneNum')</th>
                        <th>#springMessage('table.common.email')</th>
                        <th>#springMessage('table.common.weChatNum')</th>
                        <th>#springMessage('table.common.QQNum')</th>
                        <th>#springMessage('common.message.remark')</th>
                        <th>#springMessage('table.common.createby')</th>
                        <th>#springMessage('common.table.thead.operation')</th>
                    </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    ##拜访记录登记
    <input type="hidden" name="visitIds" id="visitIds" value="$!{vo.visitIds}">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.institution.visitRecordRegistration')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                                <br>
                <table id="visitRecordRegistration" class="layui-table layui-form breakRow" style="width:100%;">
                    <thead>
                    <tr>
                        <th>#springMessage('table.common.orderNum')</th>
                        <th>#springMessage('table.institution.visitingMatters')</th>
                        <th>#springMessage('table.institution.visitingPersonnel')</th>
                        <th>#springMessage('table.institution.visitingObject')</th>
                        <th>#springMessage('table.institution.visitingObject.job')</th>
                        <th>#springMessage('table.institution.visitingDate')</th>
                        <th>#springMessage('common.message.remark')</th>
                        <th>#springMessage('table.common.createby')</th>
                        <th>#springMessage('common.table.thead.operation')</th>
                    </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    ## 附件
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <div class="layui-colla-content  layui-show">
                <table class="layui-table breakRow">
                    <tbody>
                    <tr>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
##                            <input id="attachmentId" name="uploadId" type="hidden" value="$!{vo.attachmentId}">
##                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                            <input id="attachmentId" name="attachmentId" type="hidden" value="$!{vo.attachmentId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: center;" colspan="4">
                            <button class="layui-btn" lay-submit="" id="modifySubmit">#springMessage(
                                'common.button.submit')</button>
                            <button class="layui-btn" lay-submit="" id="modifyTemp">#springMessage(
                                'common.button.temp')</button>
                            <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                'common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</form>

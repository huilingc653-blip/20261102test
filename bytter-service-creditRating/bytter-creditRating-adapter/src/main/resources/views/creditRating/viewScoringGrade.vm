<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    ##主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.crmModel.mainMessage')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <tr>
                        ##评分标准代码
                        <td class="textRight" style="width: 15%;">#springMessage('table.crmScoringGrade.code')</td>
                        <td>
                            $!{scoringGrade.scoringGradeCode}
                        </td>
                        ##评分标准名称
                        <td class="textRight" style="width: 15%;">#springMessage('table.crmScoringGrade.name')</td>
                        <td>
                           $!{scoringGrade.scoringGradeName}
                        </td>
                    </tr>
                    <tr>
                        ##机构类别
                        <td class="textRight">#springMessage('table.crTaskInfo.orgType')</td>
                        <td>
                            <div class="layui-inline">
                                ##机构类别
                                $!{scoringGrade.institutionTypeName}
                            </div>
                        </td>
                        ##有效标志
                        <td class="textRight">#springMessage('table.choProduct.validSign')</td>
                        <td>
                            $dictTag.get("valid_sign",$!{scoringGrade.validSign})
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.repay.rmk')</td>
                        <td  colspan="3">
                        $!{scoringGrade.scoringGradeDescription}
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    ##评分等级
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.crmScoringGrade.level')</h2>
            <div class="layui-colla-content layui-show">
            <table id="dataTable" class="layui-table ignore-required-icon layui-table-border">
                <thead>
                <tr>
                    <th>#springMessage('table.fcBankBill.bankId')</th>
                    <th>#springMessage('table.crmScoringGrade.conditions')</th>
                    <th>#springMessage('table.crmScoringGrade.score')</th>
                    <th>#springMessage('table.crmScoringGrade.grade')</th>
                    <th>#springMessage('table.repay.rmk')</th>
                </tr>
                </thead>
                <tbody>
                    #foreach($gradeLevel in $gradeLevels)
                    <tr>
                        <td>$velocityCount</td>
                        <td style="text-align:center">

                            <div class="bt-biz-dict" data-type="select" data-width="70px" data-group="FUNDWARN_OPERATOR"
                                 data-value="$!{gradeLevel.scoringSymbol}" data-inputvalue="false"
                                #if($vcount=="0")
                                 data-filterData="20,21"
                                #elseif($!{gradeLevel.scoringSymbol}=="10"||$!{gradeLevel.scoringSymbol}=="21")
                                 data-filterData="11,20"
                                #elseif($!{gradeLevel.scoringSymbol}=="11"||$!{gradeLevel.scoringSymbol}=="20")
                                 data-filterData="10,21"
                                #end
                                 id="scoringSymbolScoreLimitLevel" data-biz-name="scoringSymbolScoreLimitLevel" data-name="scoringSymbolScoreLimitLevel"
                                 data-placeholder=""
                            ></div>
                            <div class="layui-input-inline">
                                <input class="layui-input   bt-biz-moneyType" disabled="disabled" type="text"
                                       style="width: 120px;" autocomplete="off" data-decimal="0"  value="$!{gradeLevel.scoreLimitLevel}">
                            </div>
                        </td>
                        <td>
                            $!{gradeLevel.downScoringSymbol}
                            #if($!{gradeLevel.lowerScoreLimitLevel})
                                $!{gradeLevel.lowerScoreLimitLevel}
                                #else
                                -00
                            #end
                            ,
                            #if($!{gradeLevel.upperScoreLimitLevel})
                                $!{gradeLevel.upperScoreLimitLevel}
                            #else
                                +00
                            #end
                            $!{gradeLevel.upScoringSymbol}
                        </td>
                        <td>$!{gradeLevel.scoringLevel}</td>
                        <td>$!{gradeLevel.explanationOfScoringLevel}</td>
                    </tr>
                    #end
                </tbody>
            </table>
            </div>
        </div>
    </div>

</form>
    #parse("views/common/footer.vm")
<script>
    var selectTypes,moneyTypes,moneyFun,dicts
    bt.use(['form','element','bttable','selectType','moneyType', 'dicts'], function () {
        $ = bt.jquery, form = bt.form();
        selectTypes = bt.selectType.init();//下拉框
        moneyTypes  = bt.moneyType.init();//金额
        moneyFun=bt.moneyType.getFun();
        dicts = bt.dicts.init();//字典
        dicts.get("scoringSymbolScoreLimitLevel").val({"disabled": true});
    })
</script>
</body>
</html>

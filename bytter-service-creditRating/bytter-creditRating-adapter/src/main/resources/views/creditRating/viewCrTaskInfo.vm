<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="defaultCorpId" value="$!{defaultCorpId}">
    <input type="hidden" id="taskInfoId" value="$!{taskInfoVo.id}">
    <input type="hidden" id="taskNo" value="$!{taskInfoVo.taskNo}">
    <input type="hidden" id="creator" value="$!{taskInfoVo.creator}">
    <input type="hidden" id="createDate" value="$!date.format('yyyy-MM-dd',$!{taskInfoVo.createDate})">
    <table class="layui-table  breakRow">
        <tbody>
        <tr>
            ##评价任务编号
            <td width="15%" class="textRight">#springMessage('table.crTaskInfo.taskNo')</td>
            <td width="20%">
                <div>$!{taskInfoVo.taskNo}</div>
            </td>
            ##	评价任务名称
            <td width="12%" class="textRight">#springMessage('table.crTaskInfo.taskName')</td>
            <td width="20%">
                $!{taskInfoVo.taskName}
            </td>
            ##评价组织权重
            <td width="8%" class="textRight">#springMessage('table.crTaskInfo.weight')</td>
            <td width="25%">
                <div class="layui-inline">
                    $dictTag.get("credit.crTaskInfo.weight",$!{taskInfoVo.taskWeight})
                </div>
            </td>
        </tr>
        <tr>
            ##机构类别
            <td class="textRight" width="8%"><font color="red">*</font>#springMessage('table.crTaskInfo.orgType')</td>
            <td width="25%">
                $!{taskInfoVo.orgType}
            </td>
            ##机构名称
            <td class="textRight">#springMessage('table.crTaskInfo.orgName')</td>
            <td>
                <div class="layui-input-inline" id="orgId">
                    <div>
                        $!{taskInfoVo.orgName}
                    </div>
                </div>
                <div id="bankTypeDiv" style="display: none"></div>
            </td>
            ##评价模板名称
            <td class="textRight">#springMessage('table.crTaskInfo.templateName')</td>
            <td>
                $!{taskInfoVo.templateName}
            </td>
        </tr>
        <tr>
            ##评价周期
            <td class="textRight">#springMessage('table.crTaskInfo.taskCycle')</td>
            <td>
                $dictTag.get("credit.crTaskInfo.cycle",$!{taskInfoVo.taskCycle})
            </td>
            ##评价开始日期
            <td class="textRight">#springMessage('table.crTaskInfo.evaluateStartDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{taskInfoVo.evaluateStartDate})
            </td>
            ##评价结束日期
            <td class="textRight">#springMessage('table.crTaskInfo.evaluateEndDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{taskInfoVo.evaluateEndDate})
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight" colspan="1">#springMessage('table.common.rmk')</td>
            <td class="textLeft" colspan="5">
                $!{taskInfoVo.rmk}
            </td>
        </tr>
        </tbody>
    </table>
    <table id="dataTable" class="layui-table layui-form layui-table-border" style="width:100%;">
        <thead>
        <tr>
            ##指标类别
            <th id="nameTitle" colspan="1">#springMessage('table.creditRating.indicatorCategory')</th>
            ##评分细则
            <th>#springMessage('credit.indicator.scoringRubric')</th>
            ##权重
            <th>#springMessage('credit.indicator.weight')</th>
            ##额外加/减分项
            <th>#springMessage('credit.indicator.addOrSub')</th>
            ##评价组织
            <th>#springMessage('table.crTaskInfo.corpName')</th>
        </tr>
        </thead>
        <tbody id="tableBody">
        </tbody>
    </table>
</form>
<div style="width: 100%;text-align: center;">
    <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{taskInfoVo.id}')">#springMessage('common.button.trackFlow')</button>
    <button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage(
            'common.button.close')</button>

</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/crTaskInfo.view.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .remark-div {
            width: calc( 30vw );
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form" method="post" action="${basePath}/creditRating/crScoringIndicator/queryList">
    <table class="layui-table">
        <tbody>
        <tr>
            ##指标类别编号
            <td class="textRight" width="10%">#springMessage('credit.indicator.type.code')</td>
            <td width="20%">
                <div class="layui-inline">
                    <input class="layui-input" type="text" name="scoringIndicatorCode" id="scoringIndicatorCode"
                           value="$!{scoringIndicatorCode}">
                </div>
            </td>
            ##指标类别名称
            <td class="textRight" width="10%">#springMessage('credit.indicator.type.name')</td>
            <td width="20%">
                <div class="layui-inline">
                    <input class="layui-input" type="text" name="scoringIndicatorName" id="scoringIndicatorName"
                           value="$!{scoringIndicatorName}">
                </div>
            </td>
            ##有效标志
            <td class="textRight">#springMessage('table.choProduct.validSign')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-biz-name="status" data-group="valid_sign"
                         data-name="status" data-defaultValue="$!{status}"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" type="submit">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallback">#springMessage(
                    'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<button type="button" class="layui-btn" name="add">#springMessage('common.button.add')</button>
<button type="button" class="layui-btn" id="printBt">#springMessage('common.button.print')</button>
<button class="layui-btn" type="button" id="exportExecl">#springMessage('common.button.exports')</button>
<div>
    <table id="scoringIndicatorTable" class="layui-table treetable layui-form" style="width:100%;">
        <thead>
        <tr>
            <th width="10%">#springMessage('credit.indicator.type.code')</th><!--指标类别编码  -->
            <th width="30%">#springMessage('credit.indicator.type.name')</th><!--指标类别名称  -->
            <th width="10%">#springMessage('credit.indicator.is.effective')</th><!--有效标志  -->
            <th width="30%">#springMessage('credit.indicator.rmk')</th><!--备注  -->
            <th width="20%">#springMessage('common.table.thead.operation')</th><!--操作  -->
        </tr>
        </thead>
        <tbody>
            #foreach($vo in $treeDate)
            <tr data-tt-id="$!{vo.id}" data-tt-parent-id="$!{vo.parentId}">
                <td style="text-align: center">
                    $!{vo.scoringIndicatorCode}
                </td>
                <td style="text-align: left">
                    $!{vo.scoringIndicatorName}
                </td>
                <td>
                    $dictTag.get("valid_sign",${vo.status})
                </td>
                <td title="$!{vo.scoringIndicatorDescription}">
                    <div style="white-space: nowrap;overflow: hidden;text-overflow: ellipsis; " class="remark-div">
                        $!{vo.scoringIndicatorDescription}
                    </div>
                </td>
                <td style="text-align: center" class="optional">
                    <a class="" href="#" name="copy" class="layui-btn layui-btn-mini layui-btn-normal">#springMessage(
                        'common.button.copy')</a><span class="text-explode">|</span>
                    <input type="hidden" class="isEffect" value="$!{vo.status}">
                    <a class="" href="#" name="add" class="layui-btn layui-btn-mini layui-btn-normal">#springMessage(
                        'credit.indicator.addChildren')</a><span class="text-explode">|</span>
                    <a class="" href="#" name="edit" class="layui-btn layui-btn-mini layui-btn-normal">#springMessage(
                        'common.button.edit')</a><span class="text-explode">|</span>
                    <a class="" href="#" name="del" class="layui-btn layui-btn-mini layui-btn-normal">#springMessage(
                        'common.button.delete')</a><span class="text-explode">|</span>
                    <a class="" href="#" name="view" class="layui-btn layui-btn-mini layui-btn-normal">#springMessage(
                        'common.button.view')</a>
                </td>
            </tr>
            #end
        </tbody>
    </table>
</div>
<div id="print" style="display: none">
    <table class="layui-table treetable layui-form" style="width:100%;">
        <thead>
        <tr>
            <th width="10%">#springMessage('credit.indicator.type.code')</th><!--指标类别编码  -->
            <th width="20%">#springMessage('credit.indicator.type.name')</th><!--指标类别名称  -->
            <th width="10%">#springMessage('credit.indicator.is.effective')</th><!--有效标志  -->
            <th width="40%">#springMessage('credit.indicator.rmk')</th><!--备注  -->
        </tr>
        </thead>
        <tbody>
            #foreach($vo in $treeDate)
            <tr data-tt-id="$!{vo.id}" data-tt-parent-id="$!{vo.parentId}"
                data-tt-voject-sort="$!{vo.scoringIndicatorCode}">
                <td style="text-align: center">
                    $!{vo.scoringIndicatorCode}
                </td>
                <td style="text-align: left">
                    $!{vo.scoringIndicatorName}
                </td>
                <td style="text-align: left">
                    $dictTag.get("valid_sign",${vo.status})
                </td>
                <td style="text-align: left">
                    $!{vo.scoringIndicatorDescription}
                </td>
            </tr>
            #end
        </tbody>
    </table>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/creditRating/scoringIndicator.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="searchForm">
        <table class="layui-table">
            <tbody>
            <tr>
                ##指标类别名称
                <td class="textRight" style="width: 50%;">#springMessage('指标类别名称')</td>
                <td>
                    $!{vo.categoryName}
                </td>
            </tr>
            <tr>
                ##指标类别代码
                <td class="textRight" style="width: 50%;">#springMessage('指标类别代码')</td>
                <td>
                    $!{vo.categoryEnCoding}
                </td>
            </tr>
            <tr>
                ##指标类别说明
                <td class="textRight" style="width: 50%;">#springMessage('指标类别说明')</td>
                <td>
                    $!{vo.categoryDescription}
                </td>
            </tr>
            </tbody>
        </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="defaultCorpId" value="$!{defaultCorpId}">
    <input type="hidden" id="taskNo" value="$!{taskInfoVo.taskNo}">
    <table class="layui-table ">
        <tbody>
        <tr>
            ##	评价任务名称
            <td width="12%" class="textRight">#springMessage('table.crTaskInfo.taskName')</td>
            <td width="20%">
                <input type="text" name="taskName" id="taskName" value="$!{taskName}" class="layui-input">
            </td>
            ##评价组织权重
            <td width="8%" class="textRight">#springMessage('table.crTaskInfo.weight')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="credit.crTaskInfo.weight"
                         data-name="taskWeight" data-biz-name="taskWeight" data-defaultvalue="0" data-value="$!{taskWeight}"></div>
                </div>
            </td>
            ##评价周期
            <td class="textRight">#springMessage('table.crTaskInfo.taskCycle')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="credit.crTaskInfo.cycle"
                     data-name="taskCycle" data-biz-name="taskCycle" data-defaultvalue="0" data-value="$!{taskCycle}"></div>
            </td>
        </tr>
        <tr>
            ##机构类别
            <td class="textRight"><font color="red">*</font>#springMessage('table.crTaskInfo.orgType')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict"
                         data-type="mulselect"
                         data-group="INSTITUTIONA_TYPE"
                         data-displayData="$!{orgType}"
                         data-name="orgType"
                         data-biz-name="orgType"
                         data-callback="getOrgData"
                         data-required="true"></div>
                </div>
            </td>
            ##机构名称
            <td class="textRight">#springMessage('table.crTaskInfo.orgName')</td>
            <td>
                <div class="layui-input-inline" id="orgId">
                    <div>
                        <div class="selectDemo bt-biz-mulselectType" data-id="orgId" data-biz-name="orgId"
                             data-method="get"
                             data-url="${basePath}/credit/institutionalRawData/queryByTypes"
                             data-valuefield="id"
                             data-textfield="institutionName"
                             data-required="true"
                             data-name="orgId"></div>
                    </div>
                </div>
                <div id="bankTypeDiv" style="display: none"></div>
            </td>
            ##评价模板名称
            <td class="textRight">#springMessage('table.crTaskInfo.templateName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/creditRating/computationalModel/getModelJson"
                     data-required="true"
                     data-name="computationalModelId"
                     data-biz-name="computationalModelId"
                     data-valueField="id"
                     data-callback="getModelScoring"
                     data-textField="modelName"></div>
            </td>
        </tr>
        <tr>
            ##评价开始日期
            <td class="textRight">#springMessage('table.crTaskInfo.evaluateStartDate')</td>
            <td>
                <input type="text" name="evaluateStartDate" class="layui-input bt-biz-dateType" data-type="date"
                       id="evaluateStartDate"
                       value="$!date.format('yyyy-MM-dd',$!{fcBondPreserveVO.endDate})"
                       data-biz-name="evaluateStartDate" data-endid="evaluateEndDate" lay-verify="required">
            </td>
            ##评价结束日期
            <td class="textRight">#springMessage('table.crTaskInfo.evaluateEndDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="evaluateEndDate" class="layui-input bt-biz-dateType" data-type="date"
                           id="evaluateEndDate"
                           data-biz-name="evaluateEndDate" lay-verify="required">
                </div>
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight" colspan="1">#springMessage('table.common.rmk')</td>
            <td class="textRight" colspan="5">
                <textarea  name="rmk" id="rmk"  class="layui-textarea">$!{rmk}</textarea>
##                <input style="width: 87.4%" type="text" name="rmk" id="rmk" value="$!{rmk}" class="layui-input">
            </td>
        </tr>
        </tbody>
    </table>
    <table id="dataTable" class="layui-table layui-form dark-layui-table layui-table-border" style="width:100%;">
        <thead>
        <tr>
            ##指标类别
            <th id="nameTitle" colspan="1">#springMessage('table.creditRating.indicatorCategory')</th>
            ##评分细则
            <th>#springMessage('credit.indicator.scoringRubric')</th>
            ##权重
            <th>#springMessage('credit.indicator.weight')</th>
            ##额外加/减分项
            <th>#springMessage('credit.indicator.addOrSub')</th>
            ##评价组织
            <th><font color="red">*</font>#springMessage('table.crTaskInfo.corpName')</th>
        </tr>
        </thead>
        <tbody id="tableBody">
        </tbody>
    </table>
    <br>
    <br>
    <div style="text-align:center">
        <button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
        <button class="layui-btn" lay-submit="" id="temp">#springMessage('common.button.temp')</button>
        <button type="reset" class="layui-btn layui-btn-primary" onClick="resetCode()">#springMessage('common.button.reset')</button>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/crTaskInfo.add.js?_btv=${resourceVersion}"></script>
</html>

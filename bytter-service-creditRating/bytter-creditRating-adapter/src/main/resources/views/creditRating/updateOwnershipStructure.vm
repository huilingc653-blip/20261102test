<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <input type="hidden" id="id" name="id" value="$!{osdVo.id}">
        <input type="hidden" id="institutionalRawDataId" name="institutionalRawDataId" value="$!{osdVo.institutionalRawDataId}">
        <input type="hidden" id="update" name="update" value="1">
        <table class="layui-table">
            <tbody>
            <tr>
                ##出资人
                <td class="textRight">#springMessage('table.cmsEquity.investor')</td>
                <td >
                    <input type="text" id="investor" name="investor"
                           autocomplete="off" class="layui-input" ##lay-verify="strlength"
                           data-maxlength="64"
                           value="$!{osdVo.investor}"
                           placeholder="#springMessage('table.cmsEquity.investor')">
                </td>
            </tr>
            <tr>
                ##融资方式
                <td class="textRight">#springMessage('table.cmsEquity.financingWay')</td>
                <td>
##                    <input type="text" id="financingWay" name="financingWay"
##                           autocomplete="off" class="layui-input" ##lay-verify="required"
##                           value="$!{osdVo.financingWay}"
##                           placeholder="#springMessage('table.cmsEquity.financingWay')">
                    <div class="bt-biz-dict" data-name="investmentMethod" data-type="select" data-biz-name="investmentMethod"
                         data-group="cms.equity.financingWay"  ##data-required="true"
                         data-defaultvalue="$!{osdVo.financingWay}"></div>
                </td>
            </tr>
            <tr>
                ##出资方式
                <td class="textRight">#springMessage('table.cmsEquity.invWay')</td>
                <td>
                    <!--number-->
##                    <input type="text" id="investmentMethod" name="investmentMethod"
##                           autocomplete="off" class="layui-input"
##                           lay-verify="strlength" data-maxlength="100"
##                           value="$!{osdVo.investmentMethod}"
##                           placeholder="#springMessage('table.cmsEquity.invWay')">
                    <div class="bt-biz-dict" data-name="financingWay" data-type="select" data-biz-name="financingWay"
                         data-group="cms.equity.invWay"  ##data-required="true"
                         data-callback="changeInvWay"
                         data-defaultvalue="$!{osdVo.investmentMethod}"></div>
                </td>
            </tr>
            <tr>
			##出资金额
                <td class="textRight">#springMessage('table.cmsEquity.invMoney')</td>
                <td >
                    <input class="layui-input bt-biz-moneyType"
                           data-maxlength="20"
                           data-name="contributionAmount"
                           lay-verify="strlength"
                           data-biz-name="contributionAmount"
                           value="$!{osdVo.contributionAmount}"
                           data-decimal="2" data-minus="false" type="text"
                           placeholder="#springMessage('table.cmsEquity.invMoney')">
                </td>
            </tr>
            <tr>
			##持股比例
                <td class="textRight">#springMessage('table.cmsEquity.equityPro')</td>
                <td >
                    <input type="text"
                           data-name="shareholdingRatio" class="layui-input bt-biz-rateType"
                           value="$!{osdVo.shareholdingRatio}"
                           data-maxlength="5"
                           data-decimal="2" data-minus="false" type="text"
                           placeholder="#springMessage('table.cmsEquity.equityPro')">
                </td>
            </tr>
            <tr>
			##资产名称
                <td class="textRight">#springMessage('table.cmsEquity.assetName')</td>
                <td >
                    <!--number-->
                    <input type="text" id="assetName" name="assetName"
                           autocomplete="off" class="layui-input" lay-verify="strlength"
                           data-maxlength="50" value="$!{osdVo.assetName}"
                           placeholder="#springMessage('table.cmsEquity.assetName')">
                </td>
            </tr>
            <tr>
			##备注
                <td class="textRight">#springMessage('common.message.remark')</td>
                <td>
                    <textarea type="text" id="rmk" name="rmk" class="layui-textarea"
                          placeholder="#springMessage('common.message.remark')">$!{osdVo.rmk}</textarea>
                </td>
            </tr>

            <tr>
                <td colspan="6" style="text-align: center;">
                    <button type="button" class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/ownershipStructureData.add.js?_btv=${resourceVersion}"></script>
</html>

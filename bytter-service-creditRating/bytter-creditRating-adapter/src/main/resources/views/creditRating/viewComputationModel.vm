<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" name="id" id="id" value="$!{computationalModel.id}">
    ##模型信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.crmModel.modelMessage')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        ##计算模型名称
                        <td class="textRight">#springMessage('table.crTaskInfo.templateName')</td>
                        <td>
                           $!{computationalModel.modelName}
                        </td>
                        ##有效标志
                        <td class="textRight">#springMessage('table.choProduct.validSign')</td>
                        <td>
                            $dictTag.get("valid_sign",$!{computationalModel.validSign})
                        </td>
                        ##计算模型代码
##                        <td class="textRight">#springMessage('计算模型代码')</td>
##                        <td>
##                            $!{computationalModel.modelCode}
##                        </td>
                    </tr>
##                    <tr>
##                        ##模型公式
##                        <td class="textRight">#springMessage('table.crmModel.modelFormula')</td>
##                        <td>
##                            <div class="layui-inline">
##                                $!{computationalModel.modelFormulaName}
##                            </div>
##                        </td>
##
##                    </tr>
                    <tr>
                        ##计算模型说明
                        <td class="textRight">#springMessage('table.repay.rmk')</td>
                        <td colspan="3">
                        $!{computationalModel.modelDescription}
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    ##评分指标
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.creditRating.scoringIndicators')</h2>
            <div class="layui-colla-content layui-show">
                <br>
                <div class="ui-box">
                    <table class="layui-table layui-table-border dark-layui-table breakRow" id="dataTable">
                        <thead>
                        <tr>
                            <th id="nameTitle" colspan="1" style="min-width: 160px;">#springMessage('table.creditRating.indicatorCategory')</th>
                            <th>#springMessage('credit.indicator.scoringRubric')</th>
                            <th style="min-width: 82px;">#springMessage('credit.indicator.addOrSub')</th>
                            <th style="min-width: 100px;">#springMessage('credit.indicator.weight')</th>
                        </tr>
                        </thead>
                        <tbody id="ScoringContract">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <input type="hidden" id="oldScoringIds" name="oldScoringIds" value="$!{oldScoringIds}">##固化表取数id
    <input type="hidden" id="newScoringIds" name="newScoringIds">##新增或者变更指标表取数id
    <br>
    <br>
    <div align="center">
        <button class="layui-btn" lay-submit="" lay-filter="close">#springMessage('common.button.close')</button>
        ##<a href="#" class="layui-btn layui-btn-small" onClick="calculationSurplusMoney()" >测试</a>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/creditRating/computationModel.view.js?_btv=${resourceVersion}"></script>
</body>
</html>

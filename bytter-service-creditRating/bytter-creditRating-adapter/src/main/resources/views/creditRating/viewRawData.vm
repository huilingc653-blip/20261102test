<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .dataTables_empty {
            border-bottom: 1px solid #DFE0E4 !important;
        }

        .dark-skin .dataTables_empty {
            border-bottom: 1px solid #2E2F34 !important;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post" id="searchForm">
    <div class="layui-collapse" style="margin-bottom: 60px;">
        <div class="layui-colla-item">
##            <h2 class="layui-colla-title">#springMessage('table.btwarnstrategy.add.title')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td class="textRight">#springMessage('table.creditRating.dataSource')</td>
                        <td>
                            $!{vo.dataName}
                        </td>
                    </tr>
                    <tr>
                        ##数据名称
                        <td class="textRight">#springMessage('table.creditRating.dataName')</td>
                        <td>
                            $!{vo.dataName}
                        </td>
                        ##成立时间
                        <td class="textRight">#springMessage('table.creditRating.establishmentTime')</td>
                        <td>
                            $!{vo.establishmentTime}
                        </td>
                    </tr>
                    <tr>
                        ##注册资本
                        <td class="textRight">#springMessage('table.creditRating.registeredCapital')</td>
                        <td>
                            $number.formatNumeric($!{vo.registeredCapital})
                        </td>
                        ##法定代表
                        <td class="textRight">#springMessage('table.creditRating.legalRepresentative')</td>
                        <td>
                            $!{vo.legalRepresentative}
                        </td>
                    </tr>
                    <tr id="statusView" style="display: none">
                        ##经营范围
                        <td class="textRight">#springMessage('table.creditRating.businessScope')</td>
                        <td>
                            $!{vo.businessScope}
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

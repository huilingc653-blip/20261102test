<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="searchForm">
    <input type="hidden" name="parentId" value="$!{parentId}">
    <div class="layui-collapse" style=" margin-bottom: 60px;">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('credit.scoring.add')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##指标类别名称
                        <td class="textRight" width="10px">#springMessage('credit.indicator.type.name')</td>
                        <td>
                            <div class="layui-inline">
                                <input  class="layui-input" type="text" name="scoringIndicatorName" id="scoringIndicatorName" lay-verify="required">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##有校标志
                        <td class="textRight" width="10%">#springMessage('credit.indicator.is.effective')</td>
                        <td width="20%">
                            <div class="bt-biz-dict" data-type="radio" data-group="valid_sign"
                                 data-defaultvalue="1" data-name="status"
                                 data-biz-name="status"></div>
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight" width="10px">#springMessage('credit.indicator.rmk')</td>
                        <td>
                            <div class="layui-inline" style="width: 50%">
                                <textarea  name="scoringIndicatorDescription" id="scoringIndicatorDescription"  class="layui-textarea"></textarea>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" type="button" lay-submit="" lay-filter="submit">#springMessage(
                        'common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/scoringIndicator.add.js?_btv=${resourceVersion}"></script>
</html>

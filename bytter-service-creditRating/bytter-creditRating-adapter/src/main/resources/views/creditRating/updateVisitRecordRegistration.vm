<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <input type="hidden" id="id" name="id" value="$!{visitVo.id}">
        <input type="hidden" id="update" name="update" value="1">
        <table class="layui-table">
            <tbody>
            <tr>
                ## 拜访事项
                <td class="textRight">#springMessage('table.institution.visitingMatters')</td>
                <td >
                    <input type="text" id="visitingMatters" name="visitingMatters"
                           autocomplete="off" class="layui-input" ##lay-verify="strlength"
                           data-maxlength="64"
                           value="$!{visitVo.visitingMatters}"
                           placeholder="#springMessage('table.institution.visitingMatters')">
                </td>
            </tr>
            <tr>
                ## 拜访人员
                <td class="textRight">#springMessage('table.institution.visitingPersonnel')</td>
                <td>
                    <input type="text" id="visitingPersonnel" name="visitingPersonnel"
                           autocomplete="off" class="layui-input" ##lay-verify="required"
                           value="$!{visitVo.visitingPersonnel}"
                           placeholder="#springMessage('table.institution.visitingPersonnel')">
                </td>
            </tr>
            <tr>
                ## 拜访对象
                <td class="textRight">#springMessage('table.institution.visitingObject')</td>
                <td>
                    <input type="text" id="visitingObj" name="visitingObj"
                           autocomplete="off" class="layui-input"
                           lay-verify="strlength" data-maxlength="100"
                           value="$!{visitVo.visitingObj}"
                           placeholder="#springMessage('table.institution.visitingObject')">
                </td>
            </tr>
            <tr>
                ## 拜访对象职务
                <td class="textRight">#springMessage('table.institution.visitingObject.job')</td>
                <td >
                    <input type="text" id="visitingObjJob" name="visitingObjJob"
                           autocomplete="off" class="layui-input" lay-verify="strlength"
                           data-maxlength="50" value="$!{visitVo.visitingObjJob}"
                           placeholder="#springMessage('table.institution.visitingObject.job')">
                </td>
            </tr>
            <tr>
##                <td>
##                    <input id="financingDate" name="financingDate"
##                           data-biz-name="financingDate"  data-type="date"
##                           class="layui-input bt-biz-dateType" ></input>
##                </td>
                ## 拜访日期
                <td class="textRight">#springMessage('table.institution.visitingDate')</td>
                <td >
                    <input  id="visitingData" name="visitDate" data-type="date"
                           autocomplete="off" class="layui-input bt-biz-dateType" lay-verify="strlength"
                           data-maxlength="50" value="$!{visitVo.visitDate}"
                           placeholder="#springMessage('table.institution.visitingData')">
                </td>
            </tr>
            <tr>
			##备注
                <td class="textRight">#springMessage('common.message.remark')</td>
                <td>
                    <textarea type="text" id="rmk" name="rmk" class="layui-textarea"
                          placeholder="#springMessage('common.message.remark')">$!{visitVo.rmk}</textarea>
                </td>
            </tr>

            <tr>
                <td colspan="6" style="text-align: center;">
                    <button type="button" class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/visitRecordRegistration.add.js?_btv=${resourceVersion}"></script>
</html>
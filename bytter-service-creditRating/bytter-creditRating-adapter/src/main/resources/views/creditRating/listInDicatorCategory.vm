<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##指标类别
            <td class="textRight" width="10%">#springMessage('指标类别')</td>
            <td width="20%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-biz-name="eqs_categoryEnCoding"
                         data-url="${basePath}/creditRating/crIndicatorCategory/json"
                         data-valuefield="categoryEnCoding" data-textfield="categoryName" data-required="false"
                         data-name="eqs_categoryEnCoding" data-search="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('指标类别名称')</th><!--指标类别名称  -->
        <th>#springMessage('指标类别说明')</th><!--指标类别说明  -->
        <th>#springMessage('创建日期')</th><!--创建日期  -->
        <th>#springMessage('common.table.thead.operation')</th><!--操作  -->
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/inDicatorCategory.list.js?_btv=${resourceVersion}"></script>
</html>

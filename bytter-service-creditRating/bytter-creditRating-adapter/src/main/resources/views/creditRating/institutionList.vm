<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>

    </style>
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##机构编号
                    <td class="textRight">#springMessage('table.institution.code')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_insCode" autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.institution.code')">
                        </div>
                    </td>
					##机构类别
					<td class="textRight">#springMessage('table.institution.type')</td>
					<td>
                        <div class="bt-biz-dict" data-type="mulselect" data-group="INSTITUTIONA_TYPE" data-name="ins_instTypes" ></div>
                    </td>
                    ##机构名称
                    <td class="textRight">#springMessage('table.institution.name')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_insName" autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.institution.name')">
                        </div>
                    </td>
				</tr>
                <tr>
                    ##状态
                    <td class="textRight">#springMessage("table.institution.status")</td>
                    <td>
                        <div class="bt-biz-dict" data-type="mulselect" data-group="institution_status" data-name="ins_insStatus" data-filterData="-2"></div>
                    </td>
                    <td class="textRight">#springMessage("table.common.createby")</td>
                    <td>
                        <div class="layui-input-inline">
                        <input type="text" name="likes_createby" autocomplete="off" class="layui-input"
                               placeholder="#springMessage('table.common.createby')">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
            </tbody>
        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.institution.code')</th><!--机构编号  -->
            <th>#springMessage('table.institution.type')</th><!--机构类别  -->
            <th>#springMessage('table.institution.name')</th><!--机构名称  -->
            <th>#springMessage('table.institution.status')</th><!--状态  -->
            <th>#springMessage('table.common.createby')</th><!--创建人  -->
            <th>#springMessage('table.common.createDate')</th><!--创建日期  -->
            <th>#springMessage('common.table.thead.operation')</th><!--操作  -->
        </tr>
        </thead>
    </table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/institution.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="taskNo" value="$!{crTaskOrgInfo.taskNo}">
    <input type="hidden" id="orgId" value="$!{orgId}">
    <table class="layui-table">
        <thead>
        <tr>
            ##基础信息
            <td colspan="4">#springMessage('table.common.basicInfo')</td>
        </tr>
        </thead>
        <tbody>
        <tr>
            ##机构名称
            <td class="textRight" width="20%">#springMessage('table.crTaskInfo.orgName')</td>
            <td width="30%">
                $!{crTaskOrgInfo.orgName}
            </td>
            ##评价模板名称
            <td class="textRight" width="10%">#springMessage('table.crTaskInfo.templateName')</td>
            <td width="40%">
                $!{crTaskOrgInfo.templateName}
            </td>
        </tr>
        <tr>
            ##评价任务名称
            <td class="textRight">#springMessage('table.crTaskInfo.taskName')</td>
            <td>
                $!{crTaskOrgInfo.taskName}
            </td>
            ##评价开始日期
            <td class="textRight">#springMessage('table.crTaskInfo.evaluateStartDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{crTaskOrgInfo.evaluateStartDate})
            </td>
        </tr>
        <tr>
            ##评价结束日期
            <td class="textRight">#springMessage('table.crTaskInfo.evaluateEndDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{crTaskOrgInfo.evaluateEndDate})
            </td>
            ##评价周期
            <td class="textRight">#springMessage('table.crTaskInfo.taskCycle')</td>
            <td>
                $!dictTag.get("credit.crTaskInfo.cycle",$!{crTaskOrgInfo.taskCycle})
            </td>
        </tr>
        <tr>
            ##评价等级名称
            <td class="textRight">#springMessage('table.crTaskInfo.grade')</td>
            <td>
                $!{crTaskOrgInfo.orgEvaluateLevel}
            </td>
            ##评价得分
            <td class="textRight">#springMessage('table.crTaskInfo.score')</td>
            <td>
                $!{crTaskOrgInfo.orgAvg}
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.crTaskInfo.rmk')</td>
            <td>
                $!{crTaskOrgInfo.rmk}
            </td>
            <td></td>
            <td></td>
        </tr>
    </table>
    <div class="table-header">#springMessage('table.evaluationReport.creditRatingScore')</div>

    <table id="singleTable" class="layui-table layui-form layui-table-border" style="width:100%;">
        <thead id="singleTableThead">
        </thead>
        <tbody id="tableBody">
        </tbody>
    </table>
    <table id="endTable" class="layui-table">
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" onclick="closeDoc()" type="button">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/evaluationReport.view.js?_btv=${resourceVersion}"></script>
</html>
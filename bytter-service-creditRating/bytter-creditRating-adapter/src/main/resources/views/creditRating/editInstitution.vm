<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab layui-tab-card" lay-filter="institution">
    <ul class="layui-tab-title">
        <li class="layui-this" lay-id="detail"> #springMessage("credit.institution.details")</li>
        <li lay-id="evaluation">#springMessage("credit.Institutional.evaluation.info")</li>
    </ul>
    <div class="layui-tab-content" > ##style="height: 100px;"
        <div class="layui-tab-item layui-show">
            #parse("views/creditRating/editInstitutionToDetail.vm")
        </div>
        <div class="layui-tab-item">
            #parse("views/creditRating/informationEvaluationInfo.vm")
        </div>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/institution.update.js?_btv=${resourceVersion}"></script>
</html>

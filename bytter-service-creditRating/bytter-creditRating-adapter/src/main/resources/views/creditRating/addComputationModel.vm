<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <link rel="stylesheet"
          href="${basePath}/static/v3.2/plugins/dad/dad.css?_btv=${resourceVersion}"
          media="all">
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" name="id" id="id" value="$!{computationalModel.id}">
    ##复制用原模型id
    <input type="hidden" name="copyModelId" id="copyModelId" value="$!{copyModelId}">
    ##模型信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.crmModel.modelMessage')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        ##评价模板名称
                        <td class="textRight">#springMessage('table.crTaskInfo.templateName')</td>
                        <td>
                            <input id="modelName" name="modelName" value="$!{computationalModel.modelName}"
                                   class="layui-input" type="text" lay-verify="required"
                                   placeholder="#springMessage('table.crTaskInfo.templateName')"/>
                        </td>
                        ##有效标志
                        <td class="textRight">#springMessage('table.choProduct.validSign')</td>
                        <td>
                            <div class="bt-biz-dict" id="radio" data-type="radio" data-group="valid_sign"
                                 data-defaultvalue="1"   data-required="true" data-value="$!{computationalModel.validSign}"
                                 data-name="validSign" data-biz-name="validSign">
                            </div>
                        </td>
##                        ##评价模板编码
##                        <td class="textRight">#springMessage('table.crmModel.modelCode')</td>
##                        <td>
##                            <input id="modelCode" name="modelCode" value="$!{computationalModel.modelCode}"
##                                   class="layui-input" type="text" lay-verify="required"
##                                   placeholder="#springMessage('table.crmModel.modelCode')"/>
##                        </td>
                    </tr>
##                    <tr>
##                        ##模型公式
##                        <td class="textRight">#springMessage('table.crmModel.modelFormula')</td>
##                        <td>
##                            <div class="layui-inline">
##                                <div class="bt-biz-selectType" data-name="modelFormulaName" data-value="$!{computationalModel.modelFormulaName}"
##                                     data-url="${basePath}/creditRating/computationalModel/getCrmModelFormulaVOs" data-valuefield="modelFormulaName"
##                                     data-textfield="modelFormulaName"  data-callback="changModel"
##                                     data-biz-name="modelFormulaName"></div>
##                            </div>
##                            <input type="hidden" id="modelFormulaNumber" name="modelFormulaNumber">
##                        </td>
##
##                    </tr>
                    <tr>
                        ##计算模型说明
                        <td class="textRight">#springMessage('common.message.remark')</td>
                        <td colspan="3">
                            <textarea type="text" id="modelDescription" name="modelDescription" class="layui-textarea" maxlength="100"
                                      placeholder="#springMessage('common.message.remark')">$!{computationalModel.modelDescription}</textarea>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    ##评分指标
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.creditRating.scoringIndicators')</h2>
            <div class="layui-colla-content layui-show">
            <br>
                <button class="layui-btn"  type="button"
                        onclick="addScoringCallback()" >#springMessage('common.button.select')
                </button>
                <div class="ui-box">
                <table class="layui-table layui-table-border dark-layui-table breakRow" id="dataTable">
                    <thead>
                    <tr>
                        <th id="nameTitle" colspan="1" style="min-width: 160px;">#springMessage('table.creditRating.indicatorCategory')</th>
                        <th style="min-width: 50px;">#springMessage('credit.indicator.scoringRubric')</th>
                        <th style="min-width: 82px;"><span class="pl"></span> #springMessage('credit.indicator.addOrSub')</th>
                        <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('credit.indicator.weight')</th>
                        <th>#springMessage('sys.organtype.operate')</th>
                    </tr>
                    </thead>
##                    <tbody id="ScoringContract">
##                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div>
    <input type="hidden" id="oldScoringIds" name="oldScoringIds" value="$!{oldScoringIds}">##固化表取数id
    <input type="hidden" id="newScoringIds" name="newScoringIds">##新增或者变更指标表取数id
    <br>
    <br>
    <div style="text-align:center">
        <button class="layui-btn" lay-submit="" id="submit">#springMessage(
                                'common.button.submit')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                'common.button.reset')</button>
    </div>
</form>
    #parse("views/common/footer.vm")
<script type="text/javascript"
        src="${basePath}/static/v3.2/plugins/dad/dad.min.js?_btv=${resourceVersion}"
        charset="utf-8"></script>
<script src="${basePath}/static/modules/creditRating/computationModel.add.js?_btv=${resourceVersion}"></script>
</body>
</html>

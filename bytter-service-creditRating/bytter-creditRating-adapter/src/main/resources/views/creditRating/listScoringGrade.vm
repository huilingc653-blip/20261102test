<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##评级标准编号
            <td class="textRight">#springMessage('table.crmScoringGrade.code')</td>
            <td>
                <input name="likes_scoringGradeCode" class="layui-input" type="text">
            </td>
            ##评级标准名称
            <td class="textRight">#springMessage('table.crmScoringGrade.name')</td>
            <td>
                <input name="likes_scoringGradeName" class="layui-input" type="text">
            </td>
            ##机构类别
            <td class="textRight">#springMessage("table.crTaskInfo.orgType")</td>
            <td width="30%">
                <div class="layui-inline">
                    <div class="bt-biz-dict"  data-type="select"
                         data-biz-name="likes_institutionType" data-name="likes_institutionType" data-group="INSTITUTIONA_TYPE"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##有效标志
            <td class="textRight">#springMessage("table.choProduct.validSign")</td>
            <td width="30%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select"
                         data-biz-name="eqs_validSign" data-name="eqs_validSign" data-group="valid_sign"></div>
                </div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.crmScoringGrade.code')</th>
        <th>#springMessage('table.crmScoringGrade.name')</th>
        <th>#springMessage('table.crTaskInfo.orgType')</th>
        <th>#springMessage('table.choProduct.validSign')</th>
        <th>#springMessage('table.repay.rmk')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
    #workFlowScript()
<script src="${basePath}/static/modules/creditRating/scoringGrade.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

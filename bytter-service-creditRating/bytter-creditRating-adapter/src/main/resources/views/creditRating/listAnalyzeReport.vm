<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##机构编号
            <td class="textRight">#springMessage('table.institution.code')</td>
            <td>
                <input name="likes_orgCode" class="layui-input" type="text">
            </td>
            ##机构名称
            <td class="textRight">#springMessage('table.institution.name')</td>
            <td>
                <input name="likes_orgName" class="layui-input" type="text">
            </td>
            ##机构类别
            <td class="textRight">#springMessage("table.institution.type")</td>
            <td width="30%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select"
                         data-biz-name="eqs_orgType" data-name="eqs_orgType" data-group="INSTITUTIONA_TYPE"></div>
                </div>
            </td>
        </tr>
        <tr>

                        ##评价开始日期
                        <td class="textRight">#springMessage('table.crTaskInfo.evaluateStartDate')</td>
                        <td>
                            <div class="layui-inline">
                                <input name="ged_evaluateStartDate" data-endid="endEvaluateStartDate" class="layui-input bt-biz-dateType" type="text" >
                            </div>
                            <div class="layui-inline">
                                <span class="date-mid">~</span>
                            </div>
                            <div class="layui-inline">
                                <input name="led_evaluateStartDate" id="endEvaluateStartDate" class="layui-input bt-biz-dateType" type="text">
                            </div>
                        </td>

            ##评价结束日期
            <td class="textRight">#springMessage('table.crTaskInfo.evaluateEndDate')</td>
            <td>
                <div class="layui-inline">
                    <input name="ged_evaluateEndDate" data-endid="endEvaluateEndDate" class="layui-input bt-biz-dateType" type="text" >
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input name="led_evaluateEndDate" id="endEvaluateEndDate" class="layui-input bt-biz-dateType" type="text">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.institution.code')</th>##机构编号
        <th>#springMessage('table.institution.name')</th>##机构名称
        <th>#springMessage('table.institution.type')</th>##机构类别
        <th>#springMessage('table.crTaskInfo.grade')</th>##评价等级
        <th>#springMessage('table.crTaskInfo.score')</th>##评价得分
        <th>#springMessage('table.crTaskInfo.evaluateStartDate')</th>##评价开始日期
        <th>#springMessage('table.crTaskInfo.evaluateEndDate')</th>##评价结束日期
        <th>#springMessage('table.ratBkrationDisDetail.ratMoneySum')</th>##授信总额
        <th>#springMessage('table.cmsProvideLoanRepay.plBalance')</th>##借款余额
        <th>#springMessage('table.credit.analyze.settleacc')</th>##结算总量
        <th>#springMessage('table.nisBillhead.balance')</th>##账户余额
        <th>#springMessage('table.credit.analyze.financebal')</th>##理财余额

    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
    #workFlowScript()
<script>
    bt.use(['form','datatable','dateType','dicts','moneyType'], function(){
        $ = bt.jquery,form = bt.form();
        //时间
        bt.dateType.init();
        dicts = bt.dicts.init();//字典
        moneyTypes = bt.moneyType.init();//金额
        moneyFun=bt.moneyType.getFun();
        /**判断字符串是否为空*/
        bt.empty = function (ms) {
            if (typeof (ms) == "undefined" || ms == null || ms == "" || ms == " ") {
                return true;
            }
            return false;
        }
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            searchForm:{
                formElem:"#searchForm",
                formFilter:"search"
            },
            colReorder: true,
            ordering:false,
            ajax: {
                'url': basePath+"/credit/analyzeReport/getAnalyzeDataTables"
            },
            buttons:[
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            columns: [
                {data:"orgCode",bSortable:true,className:"center"},
                {data:"orgName",bSortable:true,className:"center"},
                {data:"orgTypeName",bSortable:true,className:"center",
                    render: function (data, type, full, meta) {
                        return bt.dict("INSTITUTIONA_TYPE", full.orgType);
                    }
                },
                {data:"grade",bSortable:true,className:"center"},
                {data:"orgAvg",bSortable:true,className:"center"},
                {data:"evaluateStartDate",bSortable:true,className:"center"},
                {data:"evaluateEndDate",bSortable:true,className:"center"},
                {data:"creditTotal",bSortable:false,className:"center", render: function (data, type, full, meta) {
                        var opt = {
                            separator: ",",
                            decimal: full.decimalPlaces
                        }
                        return moneyFun.format(full.creditTotal, opt);
                    }},
                {data:"loanBalance",bSortable:false,className:"center",render: function (data, type, full, meta) {
                        var opt = {
                            separator: ",",
                            decimal: full.decimalPlaces
                        }
                        return moneyFun.format(full.loanBalance, opt);
                    }},
                {data:"settlementTotal",bSortable:false,className:"center",render: function (data, type, full, meta) {
                        var opt = {
                            separator: ",",
                            decimal: full.decimalPlaces
                        }
                        return moneyFun.format(full.settlementTotal, opt);
                    }},
                {data:"accountBalance",bSortable:false,className:"center",render: function (data, type, full, meta) {
                        var opt = {
                            separator: ",",
                            decimal: full.decimalPlaces
                        }
                        return moneyFun.format(full.accountBalance, opt);
                    }},
                {data:"financeBalance",bSortable:false,className:"center",render: function (data, type, full, meta) {
                        var opt = {
                            separator: ",",
                            decimal: full.decimalPlaces
                        }
                        return moneyFun.format(full.financeBalance, opt);
                    }},
            ],

        });
    });
</script>
</body>
</html>

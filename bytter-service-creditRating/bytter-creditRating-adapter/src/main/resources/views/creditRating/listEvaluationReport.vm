<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##评估任务名称
                    <td class="textRight" width="10%">#springMessage('table.crTaskInfo.taskName')</td>
                    <td width="20%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_taskName"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.crTaskInfo.taskName')">
                        </div>
                    </td>
                    ##机构编号
                    <td class="textRight" width="10%">#springMessage('table.institution.code')</td>
                    <td width="20%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_orgCode"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.institution.code')">
                        </div>
                    </td>
                    ##机构名称
                    <td class="textRight" width="10%">#springMessage('table.crTaskInfo.orgName')</td>
                    <td width="20%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_orgName"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.crTaskInfo.orgName')">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
##                        <button type="reset" class="layui-btn layui-btn-primary" data-callback="clearAllConditions">#springMessage('common.button.reset')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
            </tbody>
        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.crTaskInfo.taskNo')</th><!--  评价任务编号  -->
            <th>#springMessage('table.crTaskInfo.taskName')</th><!--  评价任务名称  -->
            <th>#springMessage('table.institution.code')</th><!-- 机构编号  -->
            <th>#springMessage('table.crTaskInfo.corpName')</th><!--  评价组织  -->
            <th>#springMessage('table.crTaskInfo.orgType')</th><!--  机构类别  -->
            <th>#springMessage('table.crTaskInfo.orgName')</th><!--  机构名称  -->
            <th>#springMessage('table.crTaskInfo.score')</th><!--  得分  -->
            <th>#springMessage('table.crTaskInfo.grade')</th><!--  等级  -->
            <th>#springMessage('table.crTaskInfo.evaluateStartDate')</th><!--  评价开始日期  -->
            <th>#springMessage('table.crTaskInfo.evaluateEndDate')</th><!--  评价结束日期  -->
            <th>#springMessage('common.table.thead.operation')</th><!--  操作  -->
        </tr>
        </thead>
    </table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/evaluationReport.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
    <table class="layui-table">
        <tbody>
        <tr>
            ##评估任务名称
            <td class="textRight" width="10%">#springMessage('table.crTaskInfo.taskName')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_taskName"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.crTaskInfo.taskName')">
                </div>
            </td>
            ##评估组织
            <td class="textRight" width="10%">#springMessage('table.crTaskInfo.corpName')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="layui-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-tree-type="check"
                             data-name="ins_corpId"
                             data-resource="credit:evaluation:analysis:apply"
                             data-scope="all"
                             data-callback="bt.corpCallback"
                             data-textStyle="bt.corpFont"></div>

                    </div>
                </div>
            </td>
            ##机构名称
            <td class="textRight" width="10%">#springMessage('table.crTaskInfo.orgName')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_orgName"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.crTaskInfo.orgName')">
                </div>
            </td>
        </tr>
        <tr>
            ##评估开始日期
            <td class="textRight" width="10%">#springMessage('table.crTaskInfo.evaluateStartDate')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_evaluateStartDate" data-endid="led_evaluateEndDate" data-type="date"
                           autocomplete="off" class="layui-input bt-input-inline bt-biz-dateType">
                </div>
            </td>
            ##评估结束日期
            <td class="textRight" width="10%">#springMessage('table.crTaskInfo.evaluateEndDate')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" name="led_evaluateEndDate" id="led_evaluateEndDate" data-type="date"
                           autocomplete="off" class="layui-input bt-input-inline bt-biz-dateType">
                </div>
            </td>
            ##状态
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td align="center" colspan="6">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.crTaskInfo.taskNo')</th><!--  评价任务编号  -->
        <th>#springMessage('table.crTaskInfo.taskName')</th><!--  评价任务名称  -->
        <th>#springMessage('table.crTaskInfo.corpName')</th><!--  评价组织  -->
        <th>#springMessage('table.crTaskInfo.orgType')</th><!--  机构类别  -->
        <th>#springMessage('table.crTaskInfo.orgName')</th><!--  机构名称  -->
        <th>#springMessage('table.crTaskInfo.evaluateStartDate')</th><!--  评价开始日期  -->
        <th>#springMessage('table.crTaskInfo.evaluateEndDate')</th><!--  评价结束日期  -->
        <th>#springMessage('table.crTaskInfo.taskCycle')</th><!--  评价周期  -->
        <th>#springMessage('table.crTaskInfo.evaluator')</th><!--  评价人  -->
        <th>#springMessage('table.crTaskInfo.status')</th><!--  状态  -->
        <th>#springMessage('common.table.thead.operation')</th><!--  操作  -->
    </tr>
    </thead>
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
</body>
<script src="${basePath}/static/modules/creditRating/evaluationAnalysisApprove.list.js?_btv=${resourceVersion}"></script>
</html>

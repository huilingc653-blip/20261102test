<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="taskNo" value="$!{taskNo}">
    <input type="hidden" id="corpId" value="$!{corpId}">
    <table class="layui-table breakRow">
        <thead>
        <tr>
            ##基础信息
            <td colspan="4">#springMessage('table.common.basicInfo')</td>
        </tr>
        </thead>
        <tbody>
        <tr>
            ##评价任务编号
            <td class="textRight" width="20%">#springMessage('table.crTaskInfo.taskNo')</td>
            <td width="30%">
                $!{crTaskInfo.taskNo}
            </td>
            ##评价任务名称
            <td class="textRight" width="10%">#springMessage('table.crTaskInfo.taskName')</td>
            <td width="40%">
                $!{crTaskInfo.taskName}
            </td>
        </tr>
        <tr>
            ##评价组织
            <td class="textRight">#springMessage('table.crTaskInfo.corpName')</td>
            <td>
                $!{crTaskInfo.corpName}
            </td>
            ##评价组织权重
            <td class="textRight">#springMessage('table.crTaskInfo.weight')</td>
            <td>
                <div class="layui-inline">
                    $dictTag.get("credit.crTaskInfo.weight",$!{crTaskInfo.taskWeight})
                </div>
            </td>
        </tr>
        <tr>
            ##机构类别
            <td class="textRight">#springMessage('table.crTaskInfo.orgType')</td>
            <td>
                $!{crTaskInfo.orgTypeName}
            </td>
            ##机构名称
            <td class="textRight">#springMessage('table.crTaskInfo.orgName')</td>
            <td>
                $!{crTaskInfo.orgName}
            </td>
        </tr>
        <tr>
            ##评价模板名称
            <td class="textRight">#springMessage('table.crTaskInfo.templateName')</td>
            <td>
                $!{crTaskInfo.templateName}
            </td>
            ##评价周期
            <td class="textRight">#springMessage('table.crTaskInfo.taskCycle')</td>
            <td>
                $!dictTag.get('credit.crTaskInfo.cycle',$!{crTaskInfo.taskCycle})
            </td>
        </tr>
        <tr>
            ##评价开始日期
            <td class="textRight">#springMessage('table.crTaskInfo.evaluateStartDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{crTaskInfo.evaluateStartDate})
            </td>
            ##评价结束日期
            <td class="textRight">#springMessage('table.crTaskInfo.evaluateEndDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{crTaskInfo.evaluateEndDate})
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.crTaskInfo.rmk')</td>
            <td class="textLeft" colspan="3">
                $!{crTaskInfo.rmk}
            </td>
        </tr>
        </tbody>
    </table>
    <table id="singleTable" class="layui-table layui-form layui-table-border" style="width:100%;">
        <thead id="singleTableThead">
        </thead>
        <tbody id="tableBody">
        </tbody>
    </table>
    <table id="endTable" class="layui-table">
        <tr>
            <td colspan="6" style="text-align: center;">
                <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{crTaskInfo.id}')">#springMessage('common.button.trackFlow')</button>
                <button class="layui-btn" onclick="closeDoc()" type="button">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/evaluationAnalysis.view.js?_btv=${resourceVersion}"></script>
</html>

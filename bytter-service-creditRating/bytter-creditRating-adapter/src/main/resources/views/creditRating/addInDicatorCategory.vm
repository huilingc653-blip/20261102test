<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="searchForm">
    <div class="layui-collapse" style="margin-bottom: 60px;">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('新增指标类别')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##指标类别名称
                        <td class="textRight">#springMessage('指标类别名称')</td>
                        <td>
                            <input type="text" id="categoryName" name="categoryName" lay-verify="required|coordVfy|strlength" data-maxlength="100"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('指标类别名称')">

                        </td>
                    </tr>
                    <tr>
                        ##指标类别代码
                        <td class="textRight">#springMessage('指标类别代码')</td>
                        <td>
                            <input type="text" id="categoryEnCoding" name="categoryEnCoding" lay-verify="required|coordVfy|strlength" data-maxlength="4"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('指标类别代码')">

                        </td>
                    </tr>
                    <tr>
                        ##指标类别说明
                        <td class="textRight">#springMessage('指标类别说明')</td>
                        <td>
                            <input type="text" id="categoryDescription" name="categoryDescription" lay-verify="required|coordVfy|strlength" data-maxlength="200"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('指标类别说明')">
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit">
            <div class="layui-input-block">
                <button class="layui-btn" type="button" lay-submit="" lay-filter="submit">#springMessage(
                        'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/inDicatorCategory.add.js?_btv=${resourceVersion}"></script>
</html>

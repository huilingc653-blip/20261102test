<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
    <style>
        .table-ellipsis {
            max-width: 200px;
            width: 100%;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}"/>
    <table class="layui-table">
        <tbody>
        <tr>
            ##评价任务编号
            <td class="textRight">#springMessage('table.crTaskInfo.taskNo')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_taskNo" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.crTaskInfo.taskNo')">
                </div>
            </td>
            ##评价任务名称
            <td class="textRight">#springMessage('table.crTaskInfo.taskName')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_taskName" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.crTaskInfo.taskName')">
                </div>
            </td>
            ##评价组织
            <td class="textRight">#springMessage('table.crTaskInfo.corpName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="cms:provide:info:query"
                         data-scope="all"
                         data-tree-type="check">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##机构名称
            <td class="textRight">#springMessage('table.crTaskInfo.orgName')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_orgName" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.crTaskInfo.orgName')">
                </div>
            </td>
            ##评价开始日期
            <td class="textRight">#springMessage('table.crTaskInfo.evaluateStartDate')</td>
            <td>
                <input type="text" name="ged_evaluateStartDate"
                       class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_evaluateStartDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_evaluateStartDate"
                       class="layui-input bt-input-inline bt-biz-dateType"
                       id="led_evaluateStartDate">
            </td>
            ##评价结束日期
            <td class="textRight">#springMessage('table.crTaskInfo.evaluateEndDate')</td>
            <td>
                <input type="text" name="ged_evaluateEndDate" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_evaluateEndDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_evaluateEndDate" class="layui-input bt-input-inline bt-biz-dateType"
                       id="led_evaluateEndDate">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.crTaskInfo.taskNo')</th><!--	评价任务编号  -->
        <th>#springMessage('table.crTaskInfo.taskName')</th><!--	评价任务名称  -->
        <th>#springMessage('table.crTaskInfo.corpName')</th><!--评价组织  -->
        <th>#springMessage('table.crTaskInfo.orgType')</th><!--	机构类别  -->
        <th>#springMessage('table.crTaskInfo.orgName')</th><!--机构名称  -->
        <th>#springMessage('table.crTaskInfo.templateName')</th><!--评价模板名称  -->
        <th>#springMessage('table.crTaskInfo.evaluateStartDate')</th><!--评价开始日期  -->
        <th>#springMessage('table.crTaskInfo.evaluateEndDate')</th><!--	评价结束日期  -->
        <th>#springMessage('table.rasLog.createName')</th><!--	创建人名称  -->
        <th>#springMessage('common.table.createTime')</th><!--	创建时间  -->
        <th>#springMessage('common.table.status')</th><!--	状态  -->
        <th>#springMessage('common.table.thead.operation')</th><!--操作  -->
    </tr>
    </thead>
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
</body>
<script src="${basePath}/static/modules/creditRating/crTaskInfo.approve.js?_btv=${resourceVersion}"></script>
</html>

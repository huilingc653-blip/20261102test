<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .scoringExample table{
            border-collapse: collapse;
        }
        .scoringExample table tr td{
            border: 1px solid black;
            align-content: center;
        }
        .scoring-table-sample .layui-input {
            width:calc(100% - 20px);
        }
        .scoring-table-sample td {
            text-align: center;
            height: 28px!important;
            line-height: 28px!important;

        }

        .input-50 > input,
        .input-50 > div{
            width: calc( 50% - 10px);
        }
        .input-50 > div .layui-input {
            width: 100%;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post" id="searchForm">
    <input type="hidden" name="id" id="id" value="$!{crScoringIndicatorVo.id}"/>
    <input type="hidden" name="parentId" id="parentId" value="$!{crScoringIndicatorVo.parentId}"/>
    <input type="hidden" name="flag" id="flag" value="$!{flag}"/>
    <input type="hidden" name="rubicNum" id="rubicNum" value="$!{rubicNum}"/>
    <input type="hidden" id="isAutoScoringCopy" value="$!{isAutoScoring}">
    <input type="hidden" id="indexPropertyCopy" value="$!{indexProperty}">
    <input type="hidden" id="scoringMethodCopy" value="$!{scoringMethod}">
    <div class="layui-collapse" style="margin-bottom: 60px;">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('credit.indicator.type.message')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##指标类别编号
                        <td class="textRight" width="10%">#springMessage('credit.indicator.type.code')</td>
                        <td width="20%">
                            <div class="layui-inline">
                                <input  class="layui-input" type="text" name="scoringIndicatorCode" id="scoringIndicatorCode" lay-verify="required" value="$!{crScoringIndicatorVo.scoringIndicatorCode}" readonly="readonly">
                            </div>
                        </td>
                        ##指标类别名称
                        <td class="textRight" width="10%">#springMessage('credit.indicator.type.name')</td>
                        <td width="20%">
                            <div class="layui-inline">
                                <input  class="layui-input" type="text" name="scoringIndicatorName" id="scoringIndicatorName" lay-verify="required" value="$!{crScoringIndicatorVo.scoringIndicatorName}">
                            </div>
                        </td>
                        ##有校标志
                        <td class="textRight" width="10%">#springMessage('credit.indicator.is.effective')</td>
                        <td width="20%">
                            <div class="bt-biz-dict" data-type="radio" data-group="valid_sign"
                                 data-defaultvalue="$!{crScoringIndicatorVo.status}" data-name="status"
                                 data-biz-name="status"></div>
                        </td>
                    </tr>
                    <tr>
                        ##指标性质
                        <td class="textRight indexProperty" width="10%">#springMessage('credit.indicator.type.nature')</td>
                        <td width="20%" class="indexProperty">
                            <div class="bt-biz-dict" data-type="select" data-group="credit_scoring_property"
                                 data-name="indexProperty" data-defaultvalue="$!{indexProperty}"
                                 data-biz-name="indexProperty" data-callback="indexPropertyCallback" data-required="true"></div>
                        </td>
                        ##是否自动评分
                        <td class="textRight isAutoScoring" width="10%">#springMessage('credit.indicator.is.autoScoring')</td>
                        <td width="20%" class="isAutoScoring">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" id="isAutoScoring"
                                 data-defaultvalue="$!{isAutoScoring}" data-name="isAutoScoring"
                                 data-biz-name="isAutoScoring" data-callback="isAutoScoringCallback" data-required="true"></div>
                        </td>
                        ##评分方法
                        <td class="textRight scoringMethod" width="10%">#springMessage('credit.indicator.scoring.method')</td>
                        <td  width="20%" class="scoringMethod">
                            <div class="bt-biz-dict" data-type="select" data-group="credit_scoring_method"
                                 data-name="scoringMethod" id="scoringMethod" data-biz-name="scoringMethod"
                                 data-required="true" data-callback="scoringMethodCallback" data-defaultValue="$!{scoringMethod}"></div>
                        </td>
                    </tr>
                    <tr>
                        ##额外加/减分项
                        <td  width="10%" class="textRight"><span>#springMessage('credit.indicator.addOrSub')</span></td>
                        <td width="20%">
                            #if($!{isAddOrSubGrade}==1)
                                <input type="checkbox" id="isAddOrSubGrade" name="isAddOrSubGrade" data-name="isAddOrSubGrade" lay-skin="primary" checked value="$!{isAddOrSubGrade}">
                            #else
                                <input type="checkbox" id="isAddOrSubGrade" name="isAddOrSubGrade" data-name="isAddOrSubGrade" lay-skin="primary" value="$!{isAddOrSubGrade}">
                            #end
                        </td>
                        ##数据源
                            <td class="textRight dataSource" width="10%">
                                <div class="change-show #if ($!{isAutoScoring}=='0') layui-hide #end">
                                    #springMessage('credit.indicator.dataSource')</div></td>
                            <td width="20%" class="dataSource">
                                <div class="layui-inline change-show #if ($!{isAutoScoring}=='0') layui-hide #end">
                                    <input class="layui-input" id="dataSourceName" readonly="readonly" type="text" #if ($!{isAutoScoring}=='1') lay-verify="required" #end  value="$!{crScoringIndicatorVo.dataSourceName}"/>
                                    <input  id="dataSourceId" type="hidden" name="dataSourceId" value="$!{crScoringIndicatorVo.dataSourceId}"/>
                                    <input  id="dataSourceOrigin" type="hidden" name="dataSourceOrigin" value="$!{crScoringIndicatorVo.dataSourceOrigin}"/>
                                    <input  id="dataSourceCode" type="hidden" name="dataSourceCode" value="$!{crScoringIndicatorVo.dataSourceCode}"/>
                                    <div class="bt-div-search">
                                        ## 组件
                                        <button type="button" class="bt-biz-crScoringDataSource"  data-callback="dataSourceCallback">
                                            <i class="layui-icon">&#xe615;</i>
                                        </button>
                                    </div>
                                </div>
                            </td>
                    </tr>
                    <tr>
                        ##评分细则
                        <td class="textRight" width="10%">#springMessage('credit.indicator.scoringRubric')</td>
                        <td  colspan="3">
                            <div class="layui-inline"  style="width: 100%">
                                <textarea name="scoringRubric" id="scoringRubric" class="layui-textarea" maxlength="200">$!{crScoringIndicatorVo.scoringRubric}</textarea>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight" width="10%">#springMessage('credit.indicator.rmk')</td>
                        <td colspan="3">
                            <div class="layui-inline" style="width: 100%">
                                <textarea  name="scoringIndicatorDescription" id="scoringIndicatorDescription"  class="layui-textarea">$!{crScoringIndicatorVo.scoringIndicatorDescription}</textarea>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
<form class="layui-form" method="post" id="scoringRForm">
    <div class="layui-collapse" style="margin-bottom: 60px;" id="scoringR">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('credit.indicator.standard.setting')</h2>
            <div class="layui-colla-content layui-show" style="width: 60%;  margin: 0 auto;">
                <div id="description">
                    说明：定性指标无需设置评分标准，机构评价时手动输入分值即可。
                </div>
                <div  class="layui-collapse" lay-filter="collapse" id="example">
                    <div class="layui-colla-item">
                        <h2 class="layui-colla-title">示例</h2>
                        <div class="layui-colla-content layui-show">
                            <!--评分方法对应的评分细则填写说明-->
                            <div style="text-align: left" id="remind">
                                评分方法说明：以授信额度为例，获取评价任务中评价机构的最高授信额度、最低授信额度，机构得分=“(该组织的<br>
                                授信额度-最低授信额度)/(最高授信额度-最低授信额度)*满分分值
                            </div>
                            <!--评分方法对应的评分细则样例-->
                            <div id="scoringExample">

                            </div>
                        </div>
                    </div>

                </div>


                <!--评分方法不为归一法的评分细则列表-->
                <table class="layui-table" id="scoringRubricTable1" style="display: none">
                    <thead>
                    <tr>
                        <th align="center">
                            <span class="pl"><span class="required-icon">*</span></span>#springMessage('credit.indicator.scoringCondition')
                        </th><!--评分条件  -->
                        <th align="center">
                            <span class="pl"><span class="required-icon">*</span></span>#springMessage('credit.indicator.grade')
                        </th><!--分值  -->
                        <th align="center">#springMessage('common.table.thead.operation')</th><!--操作  -->
                    </tr>
                    </thead>
                    <tbody>
                    #if($!{flag}==0)
                    <tr data-row="0">
                        <td width="55%" class="input-50">
                            <div class="bt-biz-dict direction" data-type="select" data-group="credit_scoring_direciton"
                                 data-name="direction0" id="direction0" data-biz-name="direction0"
                                 data-filterdata="6" data-callback="bt.changeDirection"></div>
                                <input type="text" name="scoringStandard0" id="scoringStandard0" data-name="scoringStandard0"
                                       autocomplete="off" class="layui-input bt-biz-moneyType scoring-standard scoringStandard" style="float: right"
                                       data-biz-name="scoringStandard0" >
                        </td>
                        <td width="30%" align="center">
                            <input type="text" name="grade0" id="grade0" data-name="grade0" autocomplete="off"
                                   class="layui-input bt-biz-moneyType grade" data-biz-name="grade0">
                        </td>
                        <td align="center">
                            <a  class="" href="javascript:void(0)" name="add0" class="layui-btn layui-btn-mini layui-btn-normal" onclick="add()" >#springMessage('common.button.add')</a><sapn>     </sapn>
                            <a  class="" href="javascript:void(0)" name="del0" class="layui-btn layui-btn-mini layui-btn-normal" onclick="del(0)" style="display: none">#springMessage('common.button.delete')</a>
                        </td>
                    </tr>
                    #else
                        #set ($index = 0 )
                        #set ($rowNum = 1)
                        #foreach($standardVo in $!{crScoringIndicatorVo.crScoringStandardVoList})
                        <tr data-row="$!{index}">
                            <td width="55%" class="input-50">
                                <div class="bt-biz-dict direction" data-type="select" data-group="credit_scoring_direciton"
                                     data-name="direction$!{index}" id="direction$!{index}" data-biz-name="direction$!{index}"
                                     data-filterdata="6" data-callback="bt.changeDirection" data-defaultValue="$!{standardVo.valueDirection}"></div>
                                <input type="text" name="scoringStandard$!{index}" id="scoringStandard$!{index}" data-name="scoringStandard$!{index}" data-minus="true" data-min="0.00"
                                       autocomplete="off" class="layui-input bt-biz-moneyType scoring-standard scoringStandard" style="float: right"
                                       data-biz-name="scoringStandard$!{index}" value="$!number.formatNumeric($!{standardVo.value})">
                            </td>
                            <td width="30%" align="center">
                                <input type="text" name="grade$!{index}" id="grade$!{index}" data-name="grade$!{index}" data-minus="true" autocomplete="off" data-min="0.00"
                                       class="layui-input bt-biz-moneyType grade" data-biz-name="grade$!{index}" value="$!{standardVo.grade}">
                            </td>
                            <td align="center">
                                #if($!{rowNum}==$!{rubicNum})<!---->
                                    <a  class="" href="javascript:void(0)" name="add$!{index}" class="layui-btn layui-btn-mini layui-btn-normal" onclick="add()">#springMessage('common.button.add')</a><sapn>     </sapn>
                                    <a  class="" href="javascript:void(0)" name="del$!{index}" class="layui-btn layui-btn-mini layui-btn-normal" onclick="del(this)">#springMessage('common.button.delete')</a>
                                #else
                                    <a  class="" href="javascript:void(0)" name="add$!{index}" class="layui-btn layui-btn-mini layui-btn-normal" onclick="add()" style="display: none">#springMessage('common.button.add')</a><sapn>     </sapn>
                                    <a  class="" href="javascript:void(0)" name="del$!{index}" class="layui-btn layui-btn-mini layui-btn-normal" onclick="del(this)" style="display: none">#springMessage('common.button.delete')</a>
                                #end

                            </td>
                        </tr>
                            #set($index = $index + 1)
                            #set($rowNum = $rowNum + 1)
                        #end
                    #end
                    </tbody>
                </table>
                <!--评分方法为归一法展示的评分细则-->
                <table class="layui-table" id="scoringRubricTable2">
                    <thead>
                    <tr>
                        <th align="center">#springMessage('credit.indicator.scoringCondition')</th><!--评分条件  -->
                        <th align="center">#springMessage('credit.indicator.grade')</th><!--分值  -->
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td width="50%" align="center" class="input-50">
                            <div class="bt-biz-dict direction" data-type="select" data-group="credit_scoring_direciton"
                                 data-name="direction0" id="direction0" data-biz-name="direction0"
                                 data-placeholder="" data-required="true" data-defaultValue="6" data-disabled="true"></div>
                        </td>
                        <td width="30%" align="center">
                            <input type="text" id="onlyGrade0" data-name="onlyGrade0" data-minus="true" data-min="0.01" autocomplete="off"
                                   class="layui-input bt-biz-moneyType onlyGrade" data-biz-name="onlyGrade0" value="$!{grade}" >
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
<div class="layui-form-item layui-form-submit">
    <div class="layui-input-block">
        <button class="layui-btn" type="button" id="submit">#springMessage(
                        'common.button.submit')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/scoringIndicatorDetail.edit.js?_btv=${resourceVersion}"></script>
</html>

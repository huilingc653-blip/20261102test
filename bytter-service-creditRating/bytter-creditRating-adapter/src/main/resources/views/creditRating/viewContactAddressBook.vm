<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <table class="layui-table">
        <tbody>
        <tr>
            ##姓名
            <td class="textRight">#springMessage('table.institution.userName')</td>
            <td >$!{bookVo.name}</td>
        </tr>
        <tr>
            ##性别
            <td class="textRight">#springMessage('table.common.gender')</td>
            <td>$!{bookVo.sex}</td>
        </tr>
        <tr>
            ##职务
            <td class="textRight">#springMessage('table.institution.job')</td>
            <td >$!{bookVo.job}</td>
        </tr>
        <tr>
            ##电话号码
            <td class="textRight">#springMessage('table.institution.telephoneNum')</td>
            <td >$!{bookVo.telephoneNum}</td>
        </tr>
        <tr>
            ##邮箱
            <td class="textRight">#springMessage('table.common.email')</td>
            <td >$!{bookVo.email}</td>
        </tr>
        <tr>
            ##微信号
            <td class="textRight">#springMessage('table.common.weChatNum')</td>
            <td>$!{bookVo.weChatNum}</td>
        </tr>
        <tr>
            ##QQ号
            <td class="textRight">#springMessage('table.common.QQNum')</td>
            <td>$!{bookVo.qqNum}</td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('common.message.remark')</td>
            <td >$!{bookVo.rmk}</td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
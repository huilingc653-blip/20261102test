<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .dataTables_empty {
            border-bottom: 1px solid #DFE0E4 !important;
        }

        .dark-skin .dataTables_empty {
            border-bottom: 1px solid #2E2F34 !important;
        }
    </style>
</head>
<body>
<form class="layui-form" method="get" id="dataSource">
    <div class="layui-collapse" style="margin-bottom: 60px;">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.creditRating.dataCol')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##数据来源
                        <td class="textRight">#springMessage('table.creditRating.dataSource')</td>
                        ##                        <td class="textRight">#springMessage('table.bisAccBal.bifCode')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-mulselectType"
                                     data-url="${basePath}/credit/dataSourceCategory/dataTable"
                                     data-method="get"
                                     data-valuefield="id" data-textfield="name" data-name="ins_dataSourceId"
                                     data-inputvalue="inputvalue" data-search="true"></div>
                            </div>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td colspan="4" style="text-align: center;">
                            <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                                    'table.creditRating.collectData')</button>
                            ##                            <button type="reset" class="layui-btn layui-btn-primary" data-callback="clearAllConditions">#springMessage('common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
<div class="table-container">
    <h2 class="layui-colla-title">#springMessage('table.creditRating.rawData')</h2>
    <div>
        <table class="layui-table">
            <tbody>
            <tr>
                ##数据来源
                <td class="textRight">#springMessage('table.creditRating.dataSource')</td>
                ##                        <td class="textRight">#springMessage('table.bisAccBal.bifCode')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-mulselectType"
                             data-url="${basePath}/credit/dataSourceCategory/dataTable"
                             data-method="get"
                             data-valuefield="id" data-textfield="name" data-name="ins_dataSourceId"
                             data-inputvalue="inputvalue" data-search="true"></div>
                    </div>
                </td>
                <td></td>
                <td></td>
            </tr>
            </tr>
            <tr>
                <td colspan="4">
                    <button class="layui-btn" lay-submit="" lay-filter="queryData" type="button">#springMessage(
                            'common.button.search') </button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                            'common.button.reset')</button>
                </td>

            </tr>
            </tbody>
        </table>
    </div>
    <div class="table-box">
        <table id="queryTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('table.creditRating.dataSource')</th>
                <th>#springMessage('table.creditRating.dataName')</th>
                <th>#springMessage('table.creditRating.establishmentTime')</th>
                <th>#springMessage('table.creditRating.registeredCapital')</th>
                <th>#springMessage('table.creditRating.legalRepresentative')</th>
                <th>#springMessage('table.creditRating.businessScope')</th>
                <th>#springMessage('table.creditRating.createDate')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
        </table>
    </div>
    <form class="qarams-form layui-form">
        <table class="layui-table">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('table.creditRating.indicatorCategory')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-mulselectType"
                             data-url="${basePath}/creditRating/crIndicatorCategory/json"
                             data-method="get"
                             data-valuefield="id" data-textfield="categoryEnCoding" data-name="ins_indicateId"
                             data-inputvalue="inputvalue" data-search="true"></div>
                    </div>
                </td>
                <td class="textRight">#springMessage('table.creditRating.scoringIndicators')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-mulselectType"
                             data-url="${basePath}/creditRating/crSoringIndicator/json"
                             data-method="get"
                             data-valuefield="id" data-textfield="scoringIndicatorName" data-name="ins_scoringId"
                             data-inputvalue="inputvalue" data-search="true"></div>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="saveData" type="button">#springMessage(
                        'table.creditRating.setIndicators')</button>
                    ##                            <button type="reset" class="layui-btn layui-btn-primary" data-callback="clearAllConditions">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
    </form>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/dataCollectionAndClean.list.js?_btv=${resourceVersion}"></script>
</html>

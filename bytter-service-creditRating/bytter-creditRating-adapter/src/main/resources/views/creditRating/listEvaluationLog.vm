<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <input type="hidden" name="eqs_quoteId" value="$!{taskId}">
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.nisMessage.enrolDate')</th><!--  操作日期  -->
            <th>#springMessage('table.cmsProcessMsg.createBy')</th><!--  用户代码  -->
            <th>#springMessage('table.cmsProcessMsg.createName')</th><!--  用户名称  -->
            <th>#springMessage('table.cmsProcessMsg.messageType')</th><!--  操作类型  -->
            <th>#springMessage('table.cmsProcessMsg.message')</th><!--  操作信息  -->
        </tr>
        </thead>
    </table>
    <div align="center">
        <a href="#" class="layui-btn layui-btn-small" onClick="doClose()">#springMessage('common.button.close')</a>
    </div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/creditRating/evaluationLog.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="get">
    <table class="layui-table">
        <tbody>
        <tr>
            ##票据池代码
            <td class="textRight" width="40%">#springMessage('billPool.abPool.bpCode')</td>
            <td width="60%" >
                <input type="text" id="bpCode" name="bpCode"  lay-verify="required|strlength|codeCheck" data-maxlength="21"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.abPool.bpCode')">
            </td>
        </tr>
        <tr>
            ##票据池名称
            <td class="textRight"  width="40%">#springMessage('billPool.abPool.bpName')</td>
            <td width="60%" >
                <input type="text" id="bpName" name="bpName"  lay-verify="required|strlength|nameCheck" data-maxlength="100"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.abPool.bpName')">
            </td>
        </tr>
        <tr>
            ##池控制机构
            <td class="textRight"  width="40%">#springMessage('billPool.abPool.bpOrg')</td>
            <td width="60%" >
                <input type="text" id="bpOrg" name="bpOrg"  lay-verify="strlength" data-maxlength="100"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.abPool.bpOrg')">
            </td>
        </tr>
        <tr>
            ##池模式
            <td class="textRight" width="40%">#springMessage('billPool.abPool.bpMode')</td>
            <td width="60%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-name="bpMode" data-required="true" data-defaultvalue="1" data-placeholder=""   data-group="AB_BILL_POOL_BP_MODE">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##池类型
            <td class="textRight" width="40%">#springMessage('billPool.abPool.bpType')</td>
            <td width="60%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-name="bpType" data-required="true" data-defaultvalue="3" data-placeholder=""   data-group="AB_BILL_POOL_BP_TYPE">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##池接口
            <td class="textRight" width="40%">#springMessage('billPool.abPool.pifName')</td>
            <td width="60%">
                <div class="layui-inline">
                    <div class="bt-biz-billPoolif" id="pifId" data-name="pifId" data-required="true"
                         data-biz-name="pifId"  data-callback="pifIdCheck" >
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight"  width="40%">#springMessage('billPool.abPool.rmk')</td>
            <td width="60%">
                <input type="text" id="rmk" name="rmk"  lay-verify="strlength" data-maxlength="200"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.abPool.rmk')">
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPool.add.js?_btv=${resourceVersion}"></script>
</html>


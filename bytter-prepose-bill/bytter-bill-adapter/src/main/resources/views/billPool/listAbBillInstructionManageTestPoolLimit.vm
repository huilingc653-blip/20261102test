<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
                ##单位
                    <td class="textRight" >#springMessage('billPool.bail.corp')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-billPoolCorp"
                                 data-tree-type="check"
                                 data-biz-name="corpId"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 data-resource="bill:accebill:abBillInstruction:queryTest"
                                 data-placeholder="#springMessage('billPool.bail.corp')">
                            </div>
                        </div>
                    </td>
                ##操作额度
                    <td class="textRight" >#springMessage('billPool.Limit.opMoney')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="geg_applyMoney" data-moneyendid="endApplyMoney" autocomplete="off"
                                   class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.opMoney')">
                            <span class="date-mid">~</span>
                            <input type="text" name="leg_applyMoney" id="endApplyMoney" autocomplete="off"
                                   class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.opMoney')">
                        </div>
                    </td>
                ##操作日期
                    <td class="textRight" >#springMessage('billPool.Limit.opTime')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="ged_createTime" class="layui-input bt-input-inline bt-biz-dateType" id="appDateStart" data-endid="appDateEnd"
                                   placeholder="#springMessage('billPool.Limit.opTime')"  >
                            <span class="date-mid">~</span>
                            <input type="text" name="led_createTime" class="layui-input bt-input-inline bt-biz-dateType" id="appDateEnd"
                                   placeholder="#springMessage('billPool.Limit.opTime')" >
                        </div>
                    </td>
				</tr>
                <tr>
                ##票据池
                    <td class="textRight" >#springMessage('billPool.Limit.bpName')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-billPool"
                                 data-biz-type="billPool"
                                 data-biz-name="billPool"
                                 data-name="eqs_bpId"
                                 data-placeholder="#springMessage('billPool.Limit.bpName')">
                            </div>
                        </div>
                    </td>
                ##额度类型
                    <td class="textRight" width="11%">#springMessage('billPool.Limit.type')</td>
                    <td width="21%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="mulselect" data-name="ini_typeName" placeholder="#springMessage('billPool.bail.transtype')"
                                 data-group="AB_POOL_LIMIT_OP_TYPE">
                            </div>
                        </div>
                    </td>
                ##指令状态
                    <td class="textRight" >#springMessage('billPool.optStatus')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="mulselect" data-name="ins_optStatus" placeholder="#springMessage('billPool.optStatus')"
                                 data-group="AB_POOL_OPT_STATUS">
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('billPool.bail.corp')</th>
		<th>#springMessage('billPool.Limit.type')</th>
		<th>#springMessage('billPool.Limit.limtType')</th>
		<th>#springMessage('billPool.Limit.opMoney')</th>
        <th>#springMessage('billPool.Limit.opTime')</th>
        <th>#springMessage('billPool.limit.apply.enddata')</th>
		<th>#springMessage('billPool.Limit.rmk')</th>
		<th>#springMessage('billPool.Limit.parentName')</th>
		<th>#springMessage('billPool.Limit.bustypeLevel')</th>
		<th>#springMessage('billPool.Limit.bpName')</th>
		<th>#springMessage('billPool.Limit.checkType')</th>
		<th>#springMessage('billPool.Limit.checkMsg')</th>
		<th>#springMessage('billPool.optStatus')</th>
        <th>#springMessage('billPool.returnCode')</th>
        <th>#springMessage('billPool.bail.returnMsg')</th>
    </tr>
    </thead>
</table>


#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abBillInstructionManageTestPoolLimit.list.js?_btv=${resourceVersion}"></script>
</html>

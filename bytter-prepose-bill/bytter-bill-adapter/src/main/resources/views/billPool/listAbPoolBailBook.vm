<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="20%">#springMessage('billPool.bail.corp')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPoolCorp"
                         data-tree-type="check"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="abpool:query:bail:op"
                         data-placeholder="#springMessage('billPool.bail.corp')">
                    </div>
                </div>
            </td>
        ##票据池
            <td class="textRight" width="20%">#springMessage('billPool.bail.bp')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPool"
                         data-biz-type="billPool"
                         data-biz-name="billPool"
                         data-name="eqs_pbCodeAndName"
                         data-placeholder="#springMessage('billPool.bail.bp')">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
        ##交易日期
            <td class="textRight" width="10%">#springMessage('billPool.bailBook.transDate')</td>
            <td width="23%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_transDate" class="layui-input bt-input-inline bt-biz-dateType" id="transDateStart" data-endid="transDateEnd"
                           placeholder="#springMessage('billPool.bailBook.transDate')" value="$!{startDate}" >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_transDate" class="layui-input bt-input-inline bt-biz-dateType" id="transDateEnd"
                           placeholder="#springMessage('billPool.bailBook.transDate')" value="$!{endDate}">
                </div>
            </td>
        ##交易类型
            <td class="textRight" width="11%">#springMessage('billPool.bail.transtype')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="mulselect" data-name="ins_typeName" placeholder="#springMessage('billPool.bail.transtype')"
                         data-group="AB_POOL_BAIL_TRANS_TYPE">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button type="button" class="layui-btn" id="manual" name="manual">#springMessage('billPool.button.manualSync')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
    ##单位
        <th>#springMessage('billPool.bail.corp')</th>
    ##保证金账户
        <th>#springMessage('billPool.bail.bankAcc')</th>
    ##交易日期
        <th>#springMessage('billPool.bailBook.transDate')</th>
    ##交易金额
        <th>#springMessage('billPool.bail.transAmount')</th>
    ##交易类型
        <th>#springMessage('billPool.bail.transtype')</th>
    ##对方账号
        <th>#springMessage('billPool.bail.oppAcc')</th>
    ##对方账号名称
        <th>#springMessage('billPool.bail.oppAccName')</th>
    ##票据池
        <th>#springMessage('billPool.bail.bp')</th>
    ##同步日期
        <th>#springMessage('billPool.bank.syn.date')</th>
    ##操作
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolBailBook.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form input150-container" method="post">
    <input id="ids" name="ids" type="hidden" value="$!{ids}">
     <input id="billFlag"  name="billFlag" type="hidden" value="$!{billFlag}">
<div class="layui-form-item">
<table class="layui-table">
<tbody>
<tr>
	##票据张数
    <td class="textRight" width="25%">#springMessage('billPool.intoApple.sum')</td>
    <td   width="25%">
        $!{abCount}
    </td>
    ##合计金额
    <td class="textRight" width="25%">#springMessage('billPool.intoApple.sumMoney')</td>
    <td  width="25%">
       $number.formatNumeric($!{abBillMoney})
    </td>
</tr>
<tr>
	##入池方式
    <td class="textRight"  width="25%">#springMessage('billPool.intoApple.intoType')</td> 
    <td width="25%">
       <div class="bt-biz-dict" data-type="select" data-required="true" data-group="AB_POOL_INOUT_TYPE" id="intoType" name="intoType" data-name="intoType"></div>
    </td>
	##票据池名称 
    <td class="textRight"  width="25%">#springMessage('billPool.Pledgee.name')</td>
    <td width="25%">
				<div class="layui-input-inline">
                            <div class="bt-biz-billPool"
                                 data-tree-type="check"
                                 data-biz-type="billPool"
                                 data-biz-name="bpId"
                                 data-type="selectTree"
                                 data-name="bpId"
                                 name="bpId"
                                 data-required="true"
                                 data-callback="abPoolCallBack"
                                 data-placeholder="">
                            </div>
                        </div>
     </td>
</tr>
        <tr class="rationSelectDIV">
        ##质权人账号
            <td class="textRight" width="25%">#springMessage('billPool.Pledgee.bankAcc')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="bankAcc" id="bankAcc"
                           autocomplete="off" class="layui-input" value="0" placeholder="#springMessage('billPool.Pledgee.bankAcc')">
                </div>
            </td>
            <td width="25%">
            </td>
            <td width="25%">
            </td>
        </tr>
        <tr class="rationSelectDIV">
        ##质权人名称
            <td class="textRight" width="25%">#springMessage('billPool.Pledgee.bankAccName')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="accName" id="accName"
                           autocomplete="off" class="layui-input" value="$!{abPoolPledgeeVO.accName}" placeholder="#springMessage('billPool.Pledgee.bankAccName')">
                </div>
            </td>
            <td width="25%">
            </td>
            <td width="25%">
            </td>
        </tr>
        <tr class="rationSelectDIV">
        ##质权人开户行
            <td class="textRight" width="25%">#springMessage('bill.abBillPledgeApply.pledgeeBankAcc')</td>
            <td width="25%">
                <div class="layui-input-inline" id="payeeBankCodeDiv" >
	                <div class="layui-input-inline"><input type="text" id="bankNo" name="bankNo" autocomplete="off" class="layui-input" placeholder="#springMessage('bill.abBillPledgeApply.pledgeeBankAcc')" lay-verify="strlength" data-maxlength="12">
							<div class="bt-div-search"><button class="bt-biz-bankInfo" type="button" data-callback="bt.bankinfoCallback" ><i class="layui-icon">&#xe615;</i></button></div>
					</div>
		    	</div>
            </td>
            <td width="25%"> 
            </td>
            <td width="25%">
            </td>
        </tr>
        <tr class="rationSelectDIV">
        ##质权人开户行名称
            <td class="textRight" width="25%">#springMessage('billPool.Pledgee.pledgeeBankName')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="bankName"  id="bankName"
                           autocomplete="off" class="layui-input" value=""  placeholder="#springMessage('billPool.Pledgee.pledgeeBankName')">
                </div>
            </td>
            <td width="25%">
            </td>
            <td width="25%">
            </td>
        </tr>
        </tbody>
        </table>
        </div>

        <div class="layui-form-submit-adaptive">
            <div style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="retreat">#springMessage('common.button.save')</button>
                <button class="layui-btn layui-btn-primary" type="button" name="revert">#springMessage('common.button.revert')</button>
            </div>
        </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolInto.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
                ##单位
                    <td class="textRight" >#springMessage('billPool.bail.corp')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-billPoolCorp"
                                 data-tree-type="check"
                                 data-biz-name="corpId"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 data-resource="abpool:limitallot:resource:queryOp"
                                 data-placeholder="#springMessage('billPool.bail.corp')">
                            </div>
                        </div>
                    </td>
                    ##票据池
                    <td class="textRight" width="11%">#springMessage('billPool.bail.bp')</td>
                    <td width="21%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-billPool"
                                 data-biz-type="billPool"
                                 data-biz-name="billPool"
                                 data-name="eqs_poolNo"
                                 data-placeholder="#springMessage('billPool.bail.bp')">
                            </div>
                        </div>
                    </td>
##                ##分配金额
##                    <td class="textRight" >#springMessage('billPool.Limit.applyMoney')</td>
##                    <td width="24%">
##                        <div class="layui-input-inline">
##                            <input type="text" name="geg_applyMoney" data-moneyendid="endApplyMoney" autocomplete="off" data-minus="true"
##                                   class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.applyMoney')">
##                            <span class="date-mid">~</span>
##                            <input type="text" name="leg_applyMoney" id="endApplyMoney" autocomplete="off" data-minus="true"
##                                   class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.applyMoney')">
##                        </div>
##                    </td>
                    ##调剂后额度
                    <td class="textRight" >#springMessage('billPool.Limit.finalMoney')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="geg_finalMoney" data-moneyendid="finalMoney" autocomplete="off" data-minus="true"
                                   class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.finalMoney')">
                            <span class="date-mid">~</span>
                            <input type="text" name="leg_finalMoney" id="endfinalMoney" autocomplete="off" data-minus="true"
                                   class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.finalMoney')">
                        </div>
                    </td>
				</tr>
                <tr>
                ##调剂类型
                    <td class="textRight" >#springMessage('billPool.adjust.type')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="mulselect" data-name="ins_adjustType" placeholder="#springMessage('billPool.adjust.type')"
                                 data-group="pool_limit_adjust_type">
                            </div>
                        </div>
                    </td>
                    ##上划金额
                    <td class="textRight" >#springMessage('billPool.Limit.overAmt')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="geg_overAmt" data-moneyendid="endoverAmt" autocomplete="off" data-minus="true"
                                   class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.overAmt')">
                            <span class="date-mid">~</span>
                            <input type="text" name="leg_overAmt" id="endoverAmt" autocomplete="off" data-minus="true"
                                   class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.overAmt')">
                        </div>
                    </td>
                    ##下拨金额
                    <td class="textRight" >#springMessage('billPool.Limit.downAmt')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="geg_downAmt" data-moneyendid="enddownAmt" autocomplete="off" data-minus="true"
                                   class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.downAmt')">
                            <span class="date-mid">~</span>
                            <input type="text" name="leg_downAmt" id="enddownAmt" autocomplete="off" data-minus="true"
                                   class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.downAmt')">
                        </div>
                    </td>
                </tr>
                <tr>
                    ##分配日期
                    <td class="textRight" >#springMessage('billPool.Limit.createTime')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="ged_createTime" class="layui-input bt-input-inline bt-biz-dateType" id="appDateStart" data-endid="appDateEnd"
                                   placeholder="#springMessage('billPool.Limit.createTime')"  >
                            <span class="date-mid">~</span>
                            <input type="text" name="led_createTime" class="layui-input bt-input-inline bt-biz-dateType" id="appDateEnd"
                                   placeholder="#springMessage('billPool.Limit.createTime')" >
                        </div>
                    </td>
                    <td class="textRight" >#springMessage('billPool.bank.synInfo')</td>
                    <td width="24%">
                        <div class="bt-biz-dict" data-type="radio" data-defaultvalue="0"
                             data-group="sf_yn" data-name="bankSynInfo" ></div>
                    </td>
                    <td class="textRight" ></td>
                    <td width="24%">
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                        <button type="button" class="layui-btn" id="manual" name="manual">#springMessage('billPool.button.manualSync')</button>
                    </td>
				</tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('billPool.bail.corp')</th>
        ##票据池
        <th>#springMessage('billPool.bail.bp')</th>
		<th>#springMessage('billPool.Limit.poolMoney')</th>
		<th>#springMessage('billPool.Limit.lockMoney')</th>
		<th>#springMessage('billPool.Limit.validMoney')</th>
##		<th>#springMessage('billPool.Limit.applyMoney')</th>
		<th>#springMessage('billPool.adjust.type')</th>
        <th>#springMessage('billPool.Limit.overAmt')</th>
		<th>#springMessage('billPool.Limit.downAmt')</th>
        <th>#springMessage('billPool.Limit.finalMoney')</th>
        <th>#springMessage('billPool.Limit.createTime')</th>
		<th>#springMessage('billPool.Limit.rmk')</th>
		<th>#springMessage('billPool.Limit.parentName')</th>
		<th>#springMessage('billPool.Limit.bustypeLevel')</th>
##		<th>#springMessage('billPool.Limit.bpName')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>


#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolLimitAllotQuery.list.js?_btv=${resourceVersion}"></script>
</html>

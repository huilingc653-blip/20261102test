<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div>
	<table class="layui-table"  class="layui-form input150-container">
        <tbody>
        <tr>
    ##单位
            <td class="textRight" width="15%">#springMessage('billPool.bail.corp')</td>
            <td width="35%">
				#if($info.poolNo)
					($!{info.corpCode})
				#end
                 $!{info.corpName}
            </td>
    ##票据类型
            <td class="textRight" width="15%">#springMessage('bill.accebill.billType')</td>
            <td width="35%">
                $dictTag.get("AB_BILL_TYPE",$!{info.billType})
            </td>
        </tr>
        <tr>
    ##票据介质
            <td class="textRight"  width="15%">#springMessage('table.abVoucherinfo.billFlag')</td>
            <td width="35%">
                $dictTag.get("AB_BILL_FLAG",$!{info.billFlag})
		    </td>
   ##票据池
            <td class="textRight"  width="15%">#springMessage('billPool.bail.bp')</td>
            <td width="35%">
				#if($info.poolNo)
					($!{info.poolNo})
				#end
                 $!{info.poolName}
		    </td>
        </tr>
        <tr>
    ##票据号码
            <td class="textRight"  width="15%">#springMessage('bill.accebill.origNo')</td>
            <td width="35%">
                 $!{info.origNo}
		    </td>
	##票面金额
            <td class="textRight"  width="15%">#springMessage('table.abVoucherinfo.billMoney')</td>
            <td width="35%">
				#if($info.billMoney)
				$number.formatNumeric($!{info.billMoney})
				#end
		    </td>
        </tr>
        <tr>
    ##出票日
            <td class="textRight"  width="15%">#springMessage('table.abVoucherinfo.startDate')</td>
            <td width="35%">
				$!date.format('yyyy-MM-dd',$!{info.startDate})
		    </td>
	##到期日
            <td class="textRight"  width="15%">#springMessage('billPool.limit.apply.enddata')</td>
            <td width="35%">
				$!date.format('yyyy-MM-dd',$!{info.endDate})
		    </td>
        </tr>
        <tr>
    ##出票人
            <td class="textRight"  width="15%">#springMessage('bill.accebill.payer')</td>
            <td width="35%">
                 $!{info.payer}
		    </td>
	##收票人
            <td class="textRight"  width="15%">#springMessage('table.abVoucherinfo.payee')</td>
            <td width="35%">
                 $!{info.payee}
		    </td>
        </tr>
        <tr>
   ##承兑人
            <td class="textRight"  width="15%">#springMessage('table.abVoucherinfo.acceptor')</td>
            <td width="35%">
                 $!{info.acceptor}
		    </td>
   ##预约日期
            <td class="textRight"  width="15%">#springMessage('billPool.query.payDate')</td>
            <td width="35%">
				#if($info.updateTime)
				$!date.format('yyyy-MM-dd',$!{info.updateTime})
				#end
		    </td>
        </tr>
        <tr>
   ##清算方式
            <td class="textRight"  width="15%">#springMessage('table.abDiscount.sttlmmk')</td>
            <td width="35%">
                $dictTag.get("AB_STTLMMK",$!{info.sttlmmk})
		    </td>
    ##逾期理由
            <td class="textRight"  width="15%">#springMessage('billPool.collection.overdue')</td>
            <td width="35%">
                 $!{info.rsn}
		    </td>
        </tr>
        <tr>
    ##同步日期
            <td class="textRight"  width="15%">#springMessage('billPool.bank.syn.date')</td>
            <td width="35%">
				#if($info.createTime)
				$!date.format('yyyy-MM-dd HH:mm:ss',$!{info.createTime})
				#end
		    </td>
		    <td></td>
		    <td></td>
        </tr>
        </tbody>
    </table>
<div class="layui-form-item layui-form-submit" id="buttonDiv">
	<div class="layui-input-block">
	<button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
</div>
    #parse("views/common/footer.vm")
</body>
</html>
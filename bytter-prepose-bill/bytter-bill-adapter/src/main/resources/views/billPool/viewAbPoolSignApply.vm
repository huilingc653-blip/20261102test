<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-table {
            margin: 0px 0;
        }
    </style>
</head>
<body>
<div>
    <form class="layui-form layui-form-pane" id="fromVerify">
    <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('bill.accebill.billInfo.title')</h2>
        <div class="layui-colla-content layui-show">
            <table class="layui-table">
                <tbody>
                <tr>
                    <td width="20%" class="textRight">#springMessage('bill.accebill.signerType')</td>
                    <td width="30%">$!{info.signerType}</td>
                    <td width="20%" class="textRight">#springMessage('bill.accebill.origNo')</td>
                    <td width="30%">$!{info.origNo}<input id="origNo" name="origNo" value="$!{info.origNo}" type="hidden" /></td>
                </tr>
                <tr>
                    <td width="20%" class="textRight">#springMessage('bill.accebill.billMoney')</td>
                    <td width="30%">$number.formatNumeric($!{info.billMoney})</td>
                    <td width="20%" class="textRight">#springMessage('bill.accebill.billType')</td>
                    <td width="30%">$!{info.billTypeName}</td>
                </tr>
                <tr>
                    <td width="20%" class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                    <td width="30%">$!date.format('yyyy-MM-dd',$!{info.startDate})</td>
                    <td width="20%" class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                    <td width="30%">$!date.format('yyyy-MM-dd',$!{info.endDate})</td>
                </tr>
                <tr>
                    <td width="20%" class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
                    <td width="30%">$!{info.payer}</td>
                    <td width="20%" class="textRight">#springMessage('table.abVoucherinfo.payeracc')</td>
                    <td width="30%">$!{info.payeracc}</td>
                </tr>
                <tr>
                    <td width="20%" class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
                    <td width="30%">$!{info.acceptor}</td>
                    <td width="20%" class="textRight">#springMessage('table.abVoucherinfo.acceptoracc')</td>
                    <td width="30%">$!{info.acceptoracc}</td>
                </tr>
                <tr>
                    <td width="20%" class="textRight">#springMessage('table.abVoucherinfo.payee')</td>
                    <td width="30%">$!{info.payee}</td>
                    <td width="20%" class="textRight">#springMessage('table.abVoucherinfo.payeeacc')</td>
                    <td width="30%">$!{info.payeeacc}</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
#if($abPoolSignVO.statusName)
    <div class="layui-colla-item">
        ##票据池交易明细
        <h2 class="layui-colla-title">#springMessage('billPool.sign.poolDtl.title')</h2>
        <div class="layui-colla-content layui-show">
            <table class="layui-table">
                <tbody>
                    <tr>
                    ##票据池单位
                        <td width="20%" class="textRight">#springMessage('billPool.corp.name')</td>
                        <td width="30%">
                            ($!{abPoolSignVO.corpCode})$!{abPoolSignVO.corpName}
                        </td>
                        <td width="20%" class="textRight">#springMessage('billPool.Limit.bpName')</td>
                        <td width="30%" >
                            $!{abPoolSignVO.abPoolName}
                        </td>
                    </tr>
                    #if(!$isApprove)
                    <tr>
                    ##审批状态
                        <td width="20%" class="textRight">#springMessage('billPool.status')</td>
                        <td width="30%">
                            $!{abPoolSignVO.statusName}
                        </td>
                    ##指令状态
                        <td width="20%" class="textRight">#springMessage('billPool.optStatus')</td>
                        <td width="30%">
                            $!{abPoolSignVO.optStatusName}
                        </td>
                    </tr>
                    #end
                </tbody>
            </table>
        </div>
    </div>
#end
    #set($vmPage = "views/bill/accebill/busOpAbBillReceivebiz"+${info.msgtype}+".vm")
    #parse($vmPage)
    </form>
    #if(!$isApprove)
        <h2 class="layui-colla-title">#springMessage('common.button.businessDtl')</h2>
        <table class="layui-table layui-form" style="width: 100%;">
            <thead>
            <tr>
                <th>#springMessage('table.abAccrecords.briefId')</th>
                <th>#springMessage('bill.accebill.InstructionStatus')</th>
                <th>#springMessage('table.abAccrecords.returnCode')</th>
                <th>#springMessage('table.abAccrecords.returnMsg')</th>
                <th>#springMessage('table.abLog.createDate')</th>
            </tr>
            </thead>
            <body>
                #if($!accrecordsList)
                    #foreach($accrecords in $accrecordsList)
                    <tr>
                        <td>$!{accrecords.briefIdName}</td>
                        <td>$!{accrecords.instructStatusName}</td>
                        <td>$!{accrecords.returnCode}</td>
                        <td>$!{accrecords.returnMsg}</td>
                        <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{accrecords.createDate})</td>
                    </tr>
                    #end
                #end
            </body>
        </table>
    #end
    #if(!$isApprove)
        <br>
        <br>
        <br>
        <br>
        <h2 class="layui-colla-title">#springMessage('bill.logInfo.title')</h2>
        <table class="layui-table layui-form" style="width: 100%;">
            <thead>
            <tr>
                <th>#springMessage('table.abLog.createDate')</th>
                <th>#springMessage('table.abLog.createBy')</th>
                <th>#springMessage('table.abLog.createName')</th>
                <th>#springMessage('table.abLog.logType')</th>
                <th>#springMessage('table.abLog.msg')</th>
            </tr>
            </thead>
            <body>
                #if($!abLogList)
                    #foreach($logInfo in $abLogList)
                    <tr>
                        <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.createDate})</td>
                        <td>$!{logInfo.createBy}</td>
                        <td>$!{logInfo.createName}</td>
                        <td>$!{logInfo.logTypeName}</td>
                        <td>#springMessage($!{logInfo.msg})</td>
                    </tr>
                    #end
                #end
            </body>
        </table>
    #end
<br />
<br /> 
<div class="layui-form-item layui-form-submit" id="buttonDiv">
	<div class="layui-input-block">
	<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{abPoolSignVO.id}')">#springMessage('common.button.trackFlow')</button>
	<button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
</div>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="get">
    <input type="hidden" id="ids" name="ids" value="$!{abPoolSignVO.id}" />
    <input type="hidden" id="accId" name="accId" value="$!{abPoolSignVO.accId}" />
    <input type="hidden" id="bifCode" name="bifCode" value="$!{abPoolSignVO.bifCode}" />
    <h2 class="layui-colla-title">#springMessage('billPool.Sign.signDetail')</h2>
    <table class="layui-table" >
        <tbody>
        <tr>
            ##张数
            <td class="textRight" width="15%">#springMessage('billPool.number')</td>
            <td width="35%" >
                $!{abPoolSignVO.length}
            </td>
            ##合计金额
            <td class="textRight" width="15%">#springMessage('billPool.totalMoney')</td>
            <td width="35%" >
                $number.formatNumeric($!{abPoolSignVO.billMoney})
            </td>
        </tr>
        <tr>
            ##签收入池
            <td class="textRight" width="15%">#springMessage('billPool.Sign.isSignInPool')</td>
            <td width="35%" >
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1"
                         data-name="isIntoPool" data-biz-name="isIntoPool" ></div>
                </div>
            </td>
            ##票据池
                <td class="textRight"><div class="layui-input-inline" id="poolNameDiv"><font color="red">*</font>#springMessage('billPool.Limit.bpName')</div></td>
                <td>
                    <div class="layui-input-inline" id="poolDiv">
                        <div class="bt-biz-billPool" data-biz-name="bpId" data-name="bpId" data-callback="poolCallback"
                             data-placeholder="#springMessage('billPool.Limit.bpName')">
                        </div>
                    </div>
                </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="submit">#springMessage('common.button.save')</button>
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolSign.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="get">
    <table class="layui-table">
        <tbody>
        <tr>
            ##接口代码
            <td class="textRight" width="35%">#springMessage('billPool.abPoolif.pifCode')</td>
            <td width="65%">
                <input type="text" id="pifCode" name="pifCode"  lay-verify="required|strlength|codeCheck" data-maxlength="12"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.abPoolif.pifCode')">
            </td>
        </tr>
        <tr>
            ##接口名称
            <td class="textRight"  width="35%">#springMessage('billPool.abPoolif.pifName')</td>
            <td width="65%">
                <input type="text" id="pifName" name="pifName"  lay-verify="required|strlength|nameCheck" data-maxlength="100"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.abPoolif.pifName')">
            </td>
        </tr>
        <tr>
            ##银行接口代码
            <td class="textRight" width="35%">#springMessage('billPool.abPoolif.bifCode')</td>
            <td width="65%">
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/json"
                         data-name="bifCode" data-biz-name="bifCode" data-search="true"   data-valueField="bifCode" data-textField="name"
                         data-required="true" data-callback="checkBifCode"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight"  width="35%">#springMessage('billPool.abPoolif.rmk')</td>
            <td width="65%">
                <input type="text" id="rmk" name="rmk"  lay-verify="strlength" data-maxlength="200"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.abPoolif.rmk')">
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolif.add.js?_btv=${resourceVersion}"></script>
</html>
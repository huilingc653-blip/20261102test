<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div>
	<table class="layui-table"  class="layui-form input150-container">
        <tbody>
        <tr>
    ##单位
            <td class="textRight"  width="15%" >#springMessage('billPool.bail.corp')</td>
            <td width="35%">
				#if($info.poolNo)
					($!{info.corpCode})
				#end
                 $!{info.corpName}
            </td>
            <td class="textRight" colspan="2"></td>
        </tr>
        <tr>
            ##票据质押额度
            <td class="textRight"  width="15%">#springMessage('billPool.limit.pledgeMoney')</td>
            <td width="35%">
                #if($info.pledgeMoney)
				$number.formatNumeric($!{info.pledgeMoney})
				#end
            </td>
    ##保证金余额
            <td class="textRight"  width="15%">#springMessage('billPool.bail.balMoney')</td>
            <td width="35%">
				#if($info.bailMoney)
				$number.formatNumeric($!{info.bailMoney})
				#end
		    </td>
        </tr>
        <tr>
            ##票据池额度
            <td class="textRight" rowspan="2" width="15%">#springMessage('billPool.limit.poolMoney')</td>
            <td width="35%" rowspan="2">
                #if($info.poolMoney)
				$number.formatNumeric($!{info.poolMoney})
				#end
            </td>
            ##低风险额度
            <td class="textRight" width="15%">#springMessage('billPool.Limit.LowRiskMoney')</td>
            <td width="35%">
                #if($info.lowRiskMoney)
				$number.formatNumeric($!{info.lowRiskMoney})
				#end
            </td>

        </tr>
        <tr>
            ##非低风险额度
            <td class="textRight"  width="15%">#springMessage('billPool.Limit.inLowRiskMoney')</td>
            <td width="35%">
                #if($info.inLowRiskMoney)
				$number.formatNumeric($!{info.inLowRiskMoney})
				#end
            </td>
        </tr>
        <tr>
        </tr>
        <tr>
      ##已用额度
            <td class="textRight" rowspan="2"  width="15%">#springMessage('billPool.limit.lockMoney')</td>
            <td width="35%" rowspan="2">
				#if($info.lockMoney)
				$number.formatNumeric($!{info.lockMoney})
				#end
		    </td>
            ##已用低风险额度
            <td class="textRight" width="15%">#springMessage('billPool.Limit.UsedLowRiskMoney')</td>
            <td width="35%">
                #if($info.usedLowRiskMoney)
				$number.formatNumeric($!{info.usedLowRiskMoney})
				#end
            </td>
        </tr>
        <tr>
            ##已用非低风险额度
            <td class="textRight"  width="15%">#springMessage('billPool.Limit.UsedInLowRiskMoney')</td>
            <td width="35%">
                #if($info.usedInLowRiskMoney)
				$number.formatNumeric($!{info.usedInLowRiskMoney})
				#end
            </td>
        </tr>
        <tr>
            ##可用额度
            <td class="textRight" rowspan="2"  width="15%">#springMessage('billPool.limit.validMoney')</td>
            <td width="35%" rowspan="2" >
                #if($info.validMoney)
				$number.formatNumeric($!{info.validMoney})
				#end
            </td>
            ##可用低风险额度
            <td class="textRight" width="15%">#springMessage('billPool.Limit.ValidLowRiskMoney')</td>
            <td width="35%">
                #if($info.validLowRiskMoney)
				$number.formatNumeric($!{info.validLowRiskMoney})
				#end
            </td>
        </tr>
        <tr>
            ##可用非低风险额度
            <td class="textRight"  width="15%">#springMessage('billPool.Limit.ValidLowRiskMoney')</td>
            <td width="35%">
                #if($info.validInLowRiskMoney)
				$number.formatNumeric($!{info.validInLowRiskMoney})
				#end
            </td>
        </tr>
        <tr>
     ##票据池
            <td class="textRight"  width="15%">#springMessage('billPool.bail.bp')</td>
            <td width="35%">
				#if($info.poolNo)
					($!{info.poolNo})
				#end
                 $!{info.poolName}
		    </td>
    ##同步日期
            <td class="textRight"  width="15%">#springMessage('billPool.bank.syn.date')</td>
            <td width="35%">
				#if($info.createTime)
				$!date.format('yyyy-MM-dd HH:mm:ss',$!{info.createTime})
				#end
		    </td>
        </tr>
        </tbody>
    </table>
    <br>
    #set($poolDtl = $info.poolDtl)
    <table width="100%" border="0" cellspacing="0" cellpadding="0">
        <thead>
        <tr>
            <th colspan="4" align="center" style="font-size:24px; font-weight:bold; height:40px;">
##                资产质押池融资业务日计表
                #springMessage('bill.pool.busDayInfoTitle')
            </th>
        </tr>
        <tr>
            <th colspan="2" width="51%" class="textLeft">
                ##编制单位：
                #*<div class="layui-inline">
                    <label class="layui-form-label">#springMessage('bill.pool.createCorp')</label>
                    <div class="layui-input-inline">
                        <label class="layui-form-label">$!{info.corpName}</label>
                    </div>
                </div>*#
                #springMessage('bill.pool.createCorp')$!{info.corpName}
            </th>
            <th width="29%" class="textLeft">
                ##日期:
                #*<div class="layui-inline">
                    <label class="layui-form-label">#springMessage('bill.pool.poolDtl.date')</label>
                    <div class="layui-input-inline">
                        <label class="layui-form-label">$!date.format('yyyy-MM-dd',$!info.queryDate)</label>
                    </div>
                </div>*#
                #springMessage('bill.pool.poolDtl.date')$!date.format('yyyy-MM-dd',$!info.queryDate)
            </th>
            <th width="20%" class="textRight">
                ##单位:
                #*<div class="layui-inline">
                    <label class="layui-form-label">#springMessage('bill.pool.poolDtl.moneyUnit')</label>
                    <div class="layui-input-inline">
                        <label class="layui-form-label">#springMessage('config.choBank.moneyUnit')</label>
                    </div>
                </div>*#
                #springMessage('bill.pool.poolDtl.moneyUnit')#springMessage('config.choBank.moneyUnit')
            </th>
        </tr>
        </thead>
    </table>
    <table class="layui-table" width="100%">
        <thead>
        <tr>
            <th width="30%">#springMessage('bill.pool.poolDtl.poolAsset')</th>##池内资产
            <th width="20%">#springMessage('bill.pool.poolDtl.dayEndBal')</th>##日终余额
            <th width="30%">#springMessage('bill.pool.poolDtl.unclearedPoolBus')</th>##未结清池融资业务
            <th width="20%">#springMessage('bill.pool.poolDtl.dayEndBal')</th>##日终余额
        </tr>
        </thead>
        <tbody>
        <tr>
            ##资产池保证金
            <td width="30%">#springMessage('bill.pool.poolDtl.assetBailMoney')</td>
            <td class="textRight" width="20%">
                $!number.formatNumeric($!{info.bailMoney})
            </td>
            <td width="30%"></td>
            <td width="20%">
            </td>
        </tr>
        <tr>
            ##银行承兑汇票（含电票）合计
            <td>#springMessage('bill.pool.poolDtl.billSumMoney')</td>
            <td class="textRight">
                $!number.formatNumeric($!{poolDtl.sumholdmoney})
            </td>
            ##银行承兑汇票（含电票）合计
            <td >#springMessage('bill.pool.poolDtl.billSumMoney')</td>
            <td class="textRight">
                $!number.formatNumeric($!{poolDtl.sumemitmoney})
            </td>
        </tr>
        <tr>
            ##其中：1个月（含）内到期
            <td >#springMessage('bill.pool.poolDtl.dateM1in.money')</td>
            <td class="textRight" class="textRight" >
                $!number.formatNumeric($!{poolDtl.sumholdmoney1})
            </td>
            ##其中：1个月（含）内到期
            <td >#springMessage('bill.pool.poolDtl.dateM1in.money')</td>
            <td class="textRight">
                $!number.formatNumeric($!{poolDtl.sumemitmoney1})
            </td>
        </tr>
        <tr>
            ##1-2个月（含）内到期
            <td >　　　#springMessage('bill.pool.poolDtl.dateM1to2.money')</td>
            <td class="textRight" >
                $!number.formatNumeric($!{poolDtl.sumholdmoney2})
            </td>
            ##1-2个月（含）内到期
            <td>　　　#springMessage('bill.pool.poolDtl.dateM1to2.money')</td>
            <td class="textRight" >
                $!number.formatNumeric($!{poolDtl.sumemitmoney2})
            </td>
        </tr>
        <tr>
            ##2-3个月（含）内到期
            <td>　　　#springMessage('bill.pool.poolDtl.dateM2to3.money')</td>
            <td class="textRight" >
                $!number.formatNumeric($!{poolDtl.sumholdmoney3})
            </td>
            ##2-3个月（含）内到期
            <td>　　　#springMessage('bill.pool.poolDtl.dateM2to3.money')</td>
            <td class="textRight" >
                $!number.formatNumeric($!{poolDtl.sumemitmoney3})
            </td>
        </tr>
        <tr>
            ##3-6个月（含）内到期
            <td>　　　#springMessage('bill.pool.poolDtl.dateM3to6.money')</td>
            <td class="textRight" >
                $!number.formatNumeric($!{poolDtl.sumholdmoney6})
            </td>
            ##3-6个月（含）内到期
            <td>　　　#springMessage('bill.pool.poolDtl.dateM3to6.money')</td>
            <td class="textRight" >
                $!number.formatNumeric($!{poolDtl.sumemitmoney6})
            </td>
        </tr>
        <tr>
            ##6个月以上到期
            <td>　　　#springMessage('bill.pool.poolDtl.dateM6out.money')</td>
            <td class="textRight" >
                $!number.formatNumeric($!{poolDtl.sumholdmoney7})
            </td>
            ##6个月以上到期
            <td>　　　#springMessage('bill.pool.poolDtl.dateM6out.money')</td>
            <td class="textRight" >
                $!number.formatNumeric($!{poolDtl.sumemitmoney7})
            </td>
        </tr>
        </tbody>
    </table>

<div class="layui-form-item layui-form-submit" id="buttonDiv">
	<div class="layui-input-block">
	<button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
</div>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="13%">#springMessage('billPool.bail.corp')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPoolCorp"
                         data-tree-type="check"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="abpool:query:limit:op"
                         data-placeholder="#springMessage('billPool.bail.corp')">
                    </div>
                </div>
            </td>
        ##票据池
            <td class="textRight" width="11%">#springMessage('billPool.bail.bp')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPool"
                         data-biz-type="billPool"
                         data-biz-name="billPool"
                         data-name="eqs_poolNo"
                         id="billPool"
                         data-placeholder="#springMessage('billPool.bail.bp')">
                    </div>
                </div>
            </td>
            ##可用额度
                <td class="textRight" width="12%">#springMessage('billPool.limit.validMoney')</td>
                <td width="20%">
                    <div class="layui-input-inline">
                        <input type="text" name="geg_validMoney" data-moneyendid="validMoneyEnd" autocomplete="off"
                               class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.limit.validMoney')">
                        <span class="date-mid">~</span>
                        <input type="text" name="leg_validMoney" id="validMoneyEnd" autocomplete="off"
                               class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.limit.validMoney')">
                    </div>
                </td>
            </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button type="button" class="layui-btn" id="manual" name="manual">#springMessage('billPool.button.manualSync')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
    ##单位
        <th>#springMessage('billPool.bail.corp')</th>
    ##票据质押额度
        <th>#springMessage('billPool.limit.pledgeMoney')</th>
    ##保证金余额
        <th>#springMessage('billPool.bail.balMoney')</th>
    ##票据池额度
        <th>#springMessage('billPool.limit.poolMoney')</th>
    ##低风险额度
        <th>#springMessage('billPool.Limit.LowRiskMoney')</th>
    ##非低风险额度
        <th>#springMessage('billPool.Limit.inLowRiskMoney')</th>
    ##已用额度
        <th>#springMessage('billPool.limit.lockMoney')</th>
    ##已用低风险额度
        <th>#springMessage('billPool.Limit.UsedLowRiskMoney')</th>
    ##已用非低风险额度
        <th>#springMessage('billPool.Limit.UsedInLowRiskMoney')</th>
    ##可用额度
        <th>#springMessage('billPool.limit.validMoney')</th>
    ##可用低风险额度
        <th>#springMessage('billPool.Limit.ValidLowRiskMoney')</th>
    ##可用非低风险额度
        <th>#springMessage('billPool.Limit.ValidInLowRiskMoney')</th>
    ##票据池
        <th>#springMessage('billPool.bail.bp')</th>
    ##同步日期
        <th>#springMessage('billPool.bank.syn.date')</th>
    ##操作
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolLimit.list.js?_btv=${resourceVersion}"></script>
</html>

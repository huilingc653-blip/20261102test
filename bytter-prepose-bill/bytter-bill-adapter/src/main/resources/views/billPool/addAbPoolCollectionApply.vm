<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="dtlIds" id="dtlIds" value="$!{abPoolCollectionApplyVO.dtlIds}"/>
    <table class="layui-table">
        <tbody>
        <tr>
        ##票据张数
            <td class="textRight" width="17%">#springMessage('billPool.collection.billNum')</td>
            <td width="33%">
                $!{abPoolCollectionApplyVO.length}
            </td>
        ##合计金额
            <td class="textRight" width="17%">#springMessage('billPool.collection.totalAmount')</td>
            <td width="33%">
                $!number.formatNumeric($!{abPoolCollectionApplyVO.billMoney})
            </td>
        </tr>
        <tr>
        ##预约日期
            <td class="textRight" width="17%">#springMessage('billPool.collection.orderDate')</td>
            <td width="33%">
                <input type="text" name="businessDate" data-name="businessDate" class="layui-input bt-biz-dateType" data-type="date"
                       lay-verify="required" data-biz-name="businessDate" value="$!{businessDate}">
            </td>
        ##清算方式
            <td class="textRight" width="17%">#springMessage('table.abDiscount.sttlmmk')</td>
            <td width="33%">
                <div class="bt-biz-dict" data-type="select" data-group="AB_STTLMMK" data-name="sttlmmk" data-required="true"
                     data-selecttext="false" data-defaultvalue="SM01"></div>
            </td>
        </tr>
        <tr>
        ##逾期理由
            <td class="textRight" width="17%">#springMessage('billPool.collection.overdue')</td>
            <td width="33%">
                <div class="layui-input-inline">
                    <input type="text" id="rsn" name="rsn" data-name="rsn" class="layui-input" lay-verify="strlength"
                           data-maxlength="100"  placeholder="#springMessage('billPool.collection.overdue')" >
                </div>
            </td>
            <td class="textRight" width="17%"></td>
            <td width="33%">
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" type="button" lay-filter="submit">#springMessage('common.button.submit')</button>
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolCollectionApply.add.js?_btv=${resourceVersion}"></script>
</html>

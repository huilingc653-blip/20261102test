<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##单位
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.corp')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolBailDtlVO.corpCodeAndName}
        </span>
    </li>
##票据池
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.bp')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolBailDtlVO.pbCodeAndName}
        </span>
    </li>
##保证金账户
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.bankAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolBailDtlVO.bankAcc}
        </span>
    </li>
##保证金金额
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.balance')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{abPoolBailDtlVO.bailMoney})
        </span>
    </li>
##保证金日期
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.bailDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{abPoolBailDtlVO.bailDate})
        </span>
    </li>
#if(${inBail})
##存入金额
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.depositAmount')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{abPoolBailDtlVO.money})
        </span>
    </li>
##转出账号
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.oppOutAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolBailDtlVO.oppAcc}
        </span>
    </li>
##转出账户名称
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.oppOutAccName')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolBailDtlVO.oppAccName}
        </span>
    </li>
##转出账户行号
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.oppOutBankNo')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolBailDtlVO.oppBankNo}
        </span>
    </li>
##转出账户行名
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.oppOutBankName')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolBailDtlVO.oppBankName}
        </span>
    </li>
#else

##提取金额
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.extractAmount')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{abPoolBailDtlVO.money})
        </span>
    </li>
##转入账号
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.oppInAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolBailDtlVO.oppAcc}
        </span>
    </li>
##转入账户名称
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.oppInAccName')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolBailDtlVO.oppAccName}
        </span>
    </li>
##转入账户行号
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.oppInBankNo')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolBailDtlVO.oppBankNo}
        </span>
    </li>
##转入账户行名
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.oppInBankName')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolBailDtlVO.oppBankName}
        </span>
    </li>
#end
##申请日期
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.appDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{abPoolBailDtlVO.appDate})
        </span>
    </li>

</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>
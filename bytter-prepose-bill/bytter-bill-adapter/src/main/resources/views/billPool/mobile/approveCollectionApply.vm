<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell mui-collapse">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.billInfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
##票据号
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.origNo')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.origNo}
        </span>
    </li>
##单位名称
    <li class="mui-table-view-cell">
        #springMessage('billPool.corp.name')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.corpCodeAndName}
        </span>
    </li>
##票据池
    <li class="mui-table-view-cell">
        #springMessage('billPool.bail.bp')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.pbCodeAndName}
        </span>
    </li>
##转让标记
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.banendrsmtmk')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.banendrsmtmkName}
        </span>
    </li>
##票据金额
    <li class="mui-table-view-cell">
        #springMessage('billPool.emitFinaApply.billMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{abPoolCollectionApplyVO.billMoney})
        </span>
    </li>
##出票日期
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.startDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{abPoolCollectionApplyVO.startDate})
        </span>
    </li>
##到期日期
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.endDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{abPoolCollectionApplyVO.endDate})
        </span>
    </li>
##票据类型
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.billType')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.billTypeName}
        </span>
    </li>
##流通介质
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.billFlag')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.billFlagName}
        </span>
    </li>
##出票人
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.payer')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.payer}
        </span>
    </li>
##出票人账号
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.payeracc')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.payeracc}
        </span>
    </li>
##出票人开户银行
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.payerBankName')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.payerBankName}
        </span>
    </li>
##收票人
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.payee')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.payee}
        </span>
    </li>
##收票人账号
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.payeeacc')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.payeeacc}
        </span>
    </li>
##收票人开户银行
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.payeeBankName')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.payeeBankName}
        </span>
    </li>
##承兑人
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.acceptor')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.acceptor}
        </span>
    </li>
##承兑人账号
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.acceptoracc')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.acceptoracc}
        </span>
    </li>
##承兑人开户银行
    <li class="mui-table-view-cell">
        #springMessage('table.abVoucherinfo.acceptorBankName')
        <span class="mui-badge mui-badge-inverted">
            $!{abPoolCollectionApplyVO.acceptorBankName}
        </span>
    </li>
        </ul>
    </li>
##提示付款信息
    <li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('billPool.collection.info')</a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
            ##清算方式
                #springMessage('table.abDiscount.sttlmmk')
                <span class="mui-badge mui-badge-inverted">
                    $!{abPoolCollectionApplyVO.sttlmmkName}
                </span>
            </li>
            <li class="mui-table-view-cell">
            ##预约日期
                #springMessage('table.abAccrecords.businessDate')
                <span class="mui-badge mui-badge-inverted">
                    $!date.format('yyyy-MM-dd',$!{abPoolCollectionApplyVO.businessDate})
                </span>
            </li>
            <li class="mui-table-view-cell">
            ##逾期原因
                #springMessage('billPool.collection.overdue')
                <span class="mui-badge mui-badge-inverted">
                    $!{abPoolCollectionApplyVO.rsn}
                </span>
            </li>
        </ul>
    </li>
    #parse("views/common/wapfooter.vm")
</body>
</html>
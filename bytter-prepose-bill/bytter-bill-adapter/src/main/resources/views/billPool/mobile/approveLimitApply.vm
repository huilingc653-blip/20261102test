<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<script src="${basePath}/static/plugins/jquery/jquery.min.js?_btv=${resourceVersion}"></script>
<body>
 <ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.billInfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
			<li class="mui-table-view-cell">
				#springMessage('billPool.corp.name')
				<span class="mui-badge mui-badge-inverted">$!{abPoolLimitApplyVO.apcName}</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('billPool.Limit.bpName')
				<span class="mui-badge mui-badge-inverted">$!{abPoolLimitApplyVO.bpName}</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('billPool.busType')
				<span class="mui-badge mui-badge-inverted"> $!{abPoolLimitApplyVO.bustypeName}</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('billPool.Limit.limtType')
				<span class="mui-badge mui-badge-inverted">$!{abPoolLimitApplyVO.limtTypeName}</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('billPool.limit.apply.money')
				<span class="mui-badge mui-badge-inverted">$number.formatNumeric($!{abPoolLimitApplyVO.applyMoney})</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('billPool.limit.apply.enddata')
				<span class="mui-badge mui-badge-inverted">$!date.format('yyyy-MM-dd',$!{abPoolLimitApplyVO.endDate})</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('billPool.abPoolif.rmk')
				<span class="mui-badge mui-badge-inverted"> $!{abPoolLimitApplyVO.rmk}</span>
			</li>
        </ul>
    </li>
	#parse($vmPage)
</ul>
#parse("views/common/wapfooter.vm")
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<script src="${basePath}/static/plugins/jquery/jquery.min.js?_btv=${resourceVersion}"></script>
<body>
 <ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.billInfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
			<li class="mui-table-view-cell">
			##票据号码
				#springMessage('table.abVoucherinfo.origNo')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.origNo}</span>
			</li>
			<li class="mui-table-view-cell">
			##不得转让标记/能否转让
				#springMessage('table.abVoucherinfo.banendrsmtmk')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.banendrsmtmkName}</span>
			</li>
			<li class="mui-table-view-cell">
			##票据金额
				#springMessage('table.abVoucherinfo.billMoney')
				<span class="mui-badge mui-badge-inverted">$number.formatNumeric($!{billInfo.billMoney})</span>
			</li>
			<li class="mui-table-view-cell">
			##票据类型
				#springMessage('table.abVoucherinfo.billType')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.billTypeName}</span>
			</li>
			<li class="mui-table-view-cell">
			##流通介质
				#springMessage('table.abVoucherinfo.billFlag')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.billFlagName}</span>
			</li>
			<li class="mui-table-view-cell">
			##出票日期
				#springMessage('table.abVoucherinfo.startDate')
				<span class="mui-badge mui-badge-inverted">$!date.format('yyyy-MM-dd',$!{billInfo.startDate})</span>
			</li>
			<li class="mui-table-view-cell">
			##到期日期
				#springMessage('table.abVoucherinfo.endDate')
				<span class="mui-badge mui-badge-inverted">$!date.format('yyyy-MM-dd',$!{billInfo.endDate})</span>
			</li>
			<li class="mui-table-view-cell">
			##出票人全称
				#springMessage('table.abVoucherinfo.payer')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.payer}</span>
			</li>
			<li class="mui-table-view-cell">
			##出票人账号
				#springMessage('table.abVoucherinfo.payeracc')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.payeracc}</span>
			</li>
			<li class="mui-table-view-cell">
			##收票人全称
				#springMessage('table.abVoucherinfo.payee')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.payee}</span>
			</li>
			<li class="mui-table-view-cell">
			##收票人账号
				#springMessage('table.abVoucherinfo.payeeacc')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.payeeacc}</span>
			</li>
			<li class="mui-table-view-cell">
			##承兑人名称
				#springMessage('table.abVoucherinfo.acceptor')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.acceptor}</span>
			</li>
			##承兑人账号
			<li class="mui-table-view-cell">
				#springMessage('table.abVoucherinfo.acceptoracc')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.acceptoracc}</span>
			</li>
        </ul>
    </li>
    <li class="mui-table-view-cell mui-collapse">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.billBuInfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
			<li class="mui-table-view-cell">
			##持票单位
				#springMessage('table.abVoucherinfoVice.corpId')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.corpName}</span>
			</li>
			<li class="mui-table-view-cell">
			##持票单位账号
				#springMessage('table.abVoucherinfoVice.bankAcc')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.bankAcc}</span>
			</li>
			<li class="mui-table-view-cell">
			##业务申请日期
				#springMessage('bill.accebill.bussdt')
				<span class="mui-badge mui-badge-inverted">$!date.format('yyyy-MM-dd',$!{billInfo.applyDate})</span>
			</li>
			<li class="mui-table-view-cell">
			##业务办理日期
				#springMessage('table.abAccrecords.businessDate')
				<span class="mui-badge mui-badge-inverted">$!date.format('yyyy-MM-dd',$!{billInfo.businessDate})</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.discountReq.title')
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.name')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.reqNm}</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.bankacc')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.reqAcctId}</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.discountRec.title')
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.name')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.recNm}</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.bankacc')
				<span class="mui-badge mui-badge-inverted">$!{billInfo.recAcctId}</span>
			</li>
        </ul>
    </li>
 ##票据池交易明细
     <li class="mui-table-view-cell mui-collapse">
         <a class="mui-navigate-right" href="#">#springMessage('billPool.sign.poolDtl.title')</a>
         <ul class="mui-table-view H-theme-background-color-white">
             <li class="mui-table-view-cell">
			 ##票据池单位
				 #springMessage('billPool.corp.name')
                 <span class="mui-badge mui-badge-inverted">($!{abPoolDiscountVO.corpCode})$!{abPoolDiscountVO.corpName}</span>
             </li>
             <li class="mui-table-view-cell">
			 ##票据池
				 #springMessage('billPool.Limit.bpName')
                 <span class="mui-badge mui-badge-inverted">$!{abPoolDiscountVO.bpName}</span>
             </li>
         </ul>
     </li>
</ul>
#parse("views/common/wapfooter.vm")
</body>
</html>
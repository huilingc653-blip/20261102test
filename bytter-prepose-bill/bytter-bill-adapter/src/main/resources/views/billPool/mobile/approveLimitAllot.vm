<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<script src="${basePath}/static/plugins/jquery/jquery.min.js?_btv=${resourceVersion}"></script>
<body>
 <ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('billPool.LimitAllot')</a>
        <ul class="mui-table-view H-theme-background-color-white">
			<li class="mui-table-view-cell">
			##票据池单位
				#springMessage('billPool.corp.name')
				<span class="mui-badge mui-badge-inverted">($!{abPoolLimitAllotVO.corpCode})$!{abPoolLimitAllotVO.corpName}</span>
			</li>
			<li class="mui-table-view-cell">
			##票据池
				#springMessage('billPool.Limit.bpName')
				<span class="mui-badge mui-badge-inverted">$!{abPoolLimitAllotVO.bpName}</span>
			</li>
			<li class="mui-table-view-cell">
			##票据池额度
				#springMessage('billPool.Limit.poolMoney')
				<span class="mui-badge mui-badge-inverted">
				 #if($!{abPoolLimitAllotVO.poolMoney})
				   $number.formatNumeric($!{abPoolLimitAllotVO.poolMoney})
				 #end
				</span>
			</li>
			<li class="mui-table-view-cell">
			##可用额度
				#springMessage('billPool.Limit.validMoney')
				<span class="mui-badge mui-badge-inverted">
					#if($!{abPoolLimitAllotVO.validMoney})
						$number.formatNumeric($!{abPoolLimitAllotVO.validMoney})
					#end
				</span>
			</li>
			<li class="mui-table-view-cell">
			##已用额度
				#springMessage('billPool.Limit.lockMoney')
				<span class="mui-badge mui-badge-inverted">
					#if($!{abPoolLimitAllotVO.lockMoney})
						$number.formatNumeric($!{abPoolLimitAllotVO.lockMoney})
					#end
				</span>
			</li>
			<li class="mui-table-view-cell">
			##业务类型
				#springMessage('billPool.busType')
				<span class="mui-badge mui-badge-inverted">$!{abPoolLimitAllotVO.busTypeName}</span>
			</li>
			<li class="mui-table-view-cell">
			##额度种类
				#springMessage('billPool.Limit.limtType')
				<span class="mui-badge mui-badge-inverted">$!{abPoolLimitAllotVO.limtTypeName}</span>
			</li>
			<li class="mui-table-view-cell">
			##分配额度
				#springMessage('billPool.Limit.applyMoney')
				<span class="mui-badge mui-badge-inverted">
					#if($!{abPoolLimitAllotVO.applyMoney})
						$number.formatNumeric($!{abPoolLimitAllotVO.applyMoney})
					#end
			</span>
			</li>
			##分配日期
			<li class="mui-table-view-cell">
				#springMessage('billPool.Limit.createTime')
				<span class="mui-badge mui-badge-inverted">$!date.format('yyyy-MM-dd',$!{abPoolLimitAllotVO.createTime})</span>
			</li>
			<li class="mui-table-view-cell">
			##上级单位
				#springMessage('billPool.Limit.parentName')
				<span class="mui-badge mui-badge-inverted">$!{abPoolLimitAllotVO.parentName}</span>
			</li>
			<li class="mui-table-view-cell">
			##层级
				#springMessage('billPool.Limit.bustypeLevel')
				<span class="mui-badge mui-badge-inverted">$!{abPoolLimitAllotVO.bustypeLevel}</span>
			</li>
			<li class="mui-table-view-cell">
			##备注
				#springMessage('billPool.Limit.rmk')
				<span class="mui-badge mui-badge-inverted">$!{abPoolLimitAllotVO.rmk}</span>
			</li>
        </ul>
    </li>
</ul>
#parse("views/common/wapfooter.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
	<input type="hidden" name="ins_briefId" value="8018,8019" />
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="13%">#springMessage('billPool.bail.corp')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPoolCorp"
                         data-tree-type="check"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="abpool:query:inout:op"
                         data-placeholder="#springMessage('billPool.bail.corp')">
                    </div>
                </div>
            </td>
        ##票据池
            <td class="textRight" width="11%">#springMessage('billPool.bail.bp')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPool"
                         data-biz-type="billPool"
                         data-biz-name="billPool"
                         data-name="eqs_poolNo"
                         data-placeholder="#springMessage('billPool.bail.bp')">
                    </div>
                </div>
            </td>
            
            ##票据类型
            <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE" data-name="eqs_billTypeName"></div>
            </td>
         </tr>
         <tr>
		    ##流通介质
            <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_FLAG" data-name="eqs_billFlagName"></div>
            </td>
            ##出票日期
            <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
            <td >
                <div class="layui-inline">
                <input type="text" name="ged_startDate" data-name="ged_startDate" class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date">
                </div>
                ~
                <div class="layui-inline">
                <input type="text" name="led_startDate"　data-name="led_startDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date">
                </div>
			</td>
            ##业务类型
            <td class="textRight">#springMessage('billPool.busType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="AB_POOL_INOUT_BRIEF_ID" data-name="eqs_briefIdName"></div>
            </td>
        </tr>
         <tr>
		    ##票据号码
            <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_origNo"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
                </div>
            </td>
             ##到期日期
             <td class="textRight" width="10%">#springMessage('table.abVoucherinfo.endDate')</td>
             <td width="20%">
                 <div class="layui-inline">
                     <input type="text" name="ged_endDate" data-name="ged_endDate" class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                 </div>
                 ~
                 <div class="layui-inline">
                     <input type="text" name="led_endDate"　data-name="led_endDate" class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                 </div>
             </td>
            ##出入池方式
            <td class="textRight">#springMessage('billPool.query.inoutType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="AB_POOL_INOUT_TYPE" data-name="eqs_inoutTypeName"></div>
            </td>
        </tr>
        <tr>
            ##出入池日期
            <td class="textRight">#springMessage('billPool.query.intoData')</td>
            <td >
                <div class="layui-inline">
                    <input type="text"  name="ged_createTime" data-name="ged_createTime" class="layui-input bt-biz-dateType" id="dateStart" data-endid="dateEnd" data-callback="setCreateTimeEnd" data-type="date">
                </div>
                ~
                <div class="layui-inline">
                    <input type="text" data-biz-name="createTimeEnd" name="led_createTime"　data-name="led_createTime" class="layui-input bt-biz-dateType" id="dateEnd" data-type="date">
                </div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button type="button" class="layui-btn" id="manual" name="manual">#springMessage('billPool.button.manualSync')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
    ##单位
        <th>#springMessage('billPool.bail.corp')</th>
    ##票据类型
        <th>#springMessage('bill.accebill.billType')</th>
    ##票据介质
        <th>#springMessage('table.abVoucherinfo.billFlag')</th>
    ##业务类型
        <th>#springMessage('billPool.busType')</th>
    ##出入池方式
        <th>#springMessage('billPool.query.inoutType')</th>
    ##票据号码
        <th>#springMessage('bill.accebill.origNo')</th>
    ##票面金额
        <th>#springMessage('table.abVoucherinfo.billMoney')</th>
    ##出票日
        <th>#springMessage('table.abVoucherinfo.startDate')</th>
    ##到期日
        <th>#springMessage('billPool.limit.apply.enddata')</th>
    ##出票人
        <th>#springMessage('bill.accebill.payer')</th>
    ##收票人
        <th>#springMessage('table.abVoucherinfo.payee')</th>
    ##承兑人
        <th>#springMessage('table.abVoucherinfo.acceptor')</th>
    ##票据池
        <th>#springMessage('billPool.bail.bp')</th>
    ##同步日期
        <th>#springMessage('billPool.bank.syn.date')</th>
    ##入池日期
        <th>#springMessage('billPool.query.intoData')</th>
    ##操作
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolInoutBook.list.js?_btv=${resourceVersion}"></script>
</html>

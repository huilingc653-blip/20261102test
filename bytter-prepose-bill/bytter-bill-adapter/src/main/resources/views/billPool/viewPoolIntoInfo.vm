<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div>
       <input type="hidden" id="billMoney" value="$!{abReceiveBillPage.billMoney}"></input>
		<h2 class="layui-colla-title">#springMessage('bill.accebill.billInfo.title')</h2>
		<table class="layui-table">
			<tbody>
				<tr>
    				##票据号码
    				<td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.origNo')</td>
    				<td >
    					$!{abReceiveBillPage.origNo}
    				</td>
					##不得转让标记/能否转让
    				<td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.banendrsmtmk')</td>
    				<td >
						$dictTag.get("AB_BANEM",$!{abReceiveBillPage.bankendrsmtmk})
    				</td>
    			</tr>
				<tr>
    				##票据金额
    				<td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.billMoney')</td>
    				<td >
    					$number.formatNumeric($!{abReceiveBillPage.billMoney})
    				</td>
    				##人民币大写
    				<td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.billMoneyUp')</td>
    				<td >
						<div id="moneyUp"></div>
    				</td>
    			</tr>
    			<tr>
    				##出票日期
    				<td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.startDate')</td>
    				<td >
    					$!date.format('yyyy-MM-dd',$!{abReceiveBillPage.startDate})
    				</td>
    				##到期日期
    				<td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.endDate')</td>
    				<td >
    					$!date.format('yyyy-MM-dd',$!{abReceiveBillPage.endDate})
    				</td>
    			</tr>
    			<tr>
    				##票据类型
    				<td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.billType')</td>
    				<td >
						$dictTag.get("AB_BILL_TYPE",$!{abReceiveBillPage.billType})
    				</td>
    				##流通介质
    				<td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.billFlag')</td>
    				<td width="35%">
						$dictTag.get("AB_BILL_FLAG",$!{abReceiveBillPage.billFlag})
    				</td>
    			</tr>
				<tr>
					 ##出票人全称
					<td rowspan="3">#springMessage('bill.accebill.view.payer')</td>
    				<td class="textRight">#springMessage('bill.accebill.view.name')</td>
    				<td width="35%">
    					$!{abReceiveBillPage.payer}
    				</td>
    				##收票人全称
					<td rowspan="3">#springMessage('bill.accebill.view.payee')</td>
    				<td class="textRight">#springMessage('bill.accebill.view.name')</td>
    				<td width="35%">
						$!{abReceiveBillPage.payee}
    				</td>
    			</tr>
				<tr>
    				##出票人账号
    				<td class="textRight">#springMessage('bill.accebill.view.acc')</td>
    				<td >
    					$!{abReceiveBillPage.payeracc}
    				</td>
    				##收票人账号
    				<td class="textRight">#springMessage('bill.accebill.view.acc')</td>
    				<td >
						$!{abReceiveBillPage.payeeacc}
    				</td>
    			</tr>
				<tr>
    				##出票人开户银行
    				<td class="textRight">#springMessage('bill.accebill.view.BankName')</td>
    				<td >
    					$!{abReceiveBillPage.payerBankName}
    				</td>
    				##收票人开户银行
    				<td class="textRight">#springMessage('bill.accebill.view.BankName')</td>
    				<td >
						$!{abReceiveBillPage.payeeBankName}
    				</td>
    			</tr>
				<tr>
    				##承兑人名称
					<td rowspan="2">#springMessage('bill.accebill.view.acceptor')</td>
    				<td class="textRight">#springMessage('bill.accebill.view.name')</td>
    				<td width="35%">
    					$!{abReceiveBillPage.acceptor}
    				</td>
    				##承兑人开户行行号
    				<td class="textRight" colspan="2" >#springMessage('bill.accebill.bankno')</td>
    				<td width="35%">
						$!{abReceiveBillPage.acceptorbankno}
    				</td>
    			</tr>
				<tr>
    				##承兑人账号
    				<td class="textRight">#springMessage('bill.accebill.view.acc')</td>
    				<td >
    					$!{abReceiveBillPage.acceptoracc}
    				</td>
    				##承兑人开户行名称
    				<td class="textRight" colspan="2" >#springMessage('bill.accebill.bankname')</td>
    				<td >
						$!{abReceiveBillPage.acceptorBankName}
    				</td>
    			</tr>
				#*<tr>
					##业务申请日期
    				<td class="textRight" colspan="2">#springMessage('table.abAccrecords.applyDate')</td>
    				<td width="35%">
    					$!date.format('yyyy-MM-dd',$!{abReceiveBillPage.applyDate})
    				</td>
    				##业务办理日期
    				<td class="textRight" colspan="2" >#springMessage('table.abAccrecords.businessDate')</td>
    				<td >
						$!date.format('yyyy-MM-dd',$!{abReceiveBillPage.businessDate})
    				</td>
				</tr>*#
				<tr>
					##承兑合同号/交易合同号
    				<td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.aContractNo')</td>
    				<td width="35%">
    					$!{abReceiveBillPage.acontractNo}
    				</td>
    				##发票号
    				<td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.aInvcnb')</td>
    				<td >
						$!{abReceiveBillPage.ainvcnb}
    				</td>
    			</tr>
				<tr>
    				##摘要
    				<td class="textRight" colspan="2" >#springMessage('table.abAccrecords.abs')</td>
    				<td >
						$!{abReceiveBillPage.abs}
    				</td>
					##备注
    				<td class="textRight" colspan="2" >#springMessage('table.abAccrecords.rmk')</td>
    				<td >
						#if($!abReceiveBillPage.briefId eq '6001')
    					$!{abReceiveBillPage.rmk}
						#end
    				</td>
    			</tr>
            </tbody>
        </table>
		#if(!$isApprove||$!abReceiveBillPage.briefId eq '6001')
		<h2 class="layui-colla-title">#springMessage('bill.accebill.billBuInfo.title')</h2>
		<table class="layui-table" width="100%">
			<tbody>
    			<tr>
    				##持票单位
    				<td class="textRight" colspan="2" >#springMessage('table.abVoucherinfoVice.corpId')</td>
    				<td width="35%">
    					$!{abReceiveBillPage.corpName}
    				</td>
    				##持票单位账号
    				<td class="textRight" colspan="2" >#springMessage('table.abVoucherinfoVice.bankAcc')</td>
    				<td width="35%">
    					$!{abReceiveBillPage.bankAcc}
    				</td>
    			</tr>
				
    			<tr>
    				##业务标记
    				<td colspan="2" class="textRight" width="15%">#springMessage('table.abVoucherinfo.Business.Brief.Id')</td>
    				<td width="35%">
						$dictTag.get("AB_POOL_BRIEF_ID",$!{abReceiveBillPage.briefId})
    				</td>
    				<td colspan="2" class="textRight" width="15%">#springMessage('bill.accebill.op')</td>
    				<td width="35%">
						($!{abReceiveBillPage.createBy})$!{abReceiveBillPage.createName}
    				</td>
    			</tr>
    			<tr>
    				##业务申请日期
    				<td colspan="2" class="textRight" >#springMessage('bill.accebill.bussdt')</td>
    				<td >
						$!date.format('yyyy-MM-dd',$!{abReceiveBillPage.applyDate})
    				</td>
					##业务办理日期
    				<td colspan="2" class="textRight" >#springMessage('table.abAccrecords.businessDate')</td>
    				<td >
						$!date.format('yyyy-MM-dd',$!{abReceiveBillPage.businessDate})
    				</td>
    			</tr>
            </tbody>
        </table>
		#end
<div class="layui-form-item layui-form-submit" id="buttonDiv">
	<div class="layui-input-block">
	#if($!abReceiveBillPage.billFlag eq '11')
	<button type="button" class="layui-btn" onclick="electronbillView('$!{abReceiveBillPage.vid}','$!{abReceiveBillPage.id}')">#springMessage('bill.accebill.electronbill.info')</button>
	#end
	<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{abReceiveBillPage.id}')">#springMessage('common.button.trackFlow')</button>
	<button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
</div>
<div>
	 <h2 class="layui-colla-title">#springMessage('abPool.intoApple.intfo')</h2>
	<table class="layui-table" width="100%">
      <tbody>
      	  <tr>
             <td class="textRight" width="15%">#springMessage('billPool.Pledgee.name')</td>
             <td td width="35%">
                 $!{poolDTO.abPoolName}
             </td>
             <td class="textRight" width="15%">#springMessage('billPool.intoApple.intoData')</td>
             <td width="35%" >
				$!date.format('yyyy-MM-dd',$!{poolDTO.createTime})
             </td>
         </tr>
         <tr>
             <td class="textRight" width="15%">#springMessage('billPool.intoApple.intoType')</td>
             <td width="35%" >
				 $dictTag.get("AB_POOL_INOUT_TYPE",$!{poolDTO.inoutType})
             </td>
             
             <td class="textRight" width="15%">#springMessage('bill.pool.poolbillstatus')</td>
             <td width="35%" >
				 $dictTag.get("AB_BILL_POOL_STATUS",$!{poolDTO.poolSatatus})
             </td>
         </tr>
      </tbody>
	</table>
<br />
	#if($!accrecordsList)
        <h2 class="layui-colla-title">#springMessage('common.button.businessDtl')</h2>
        <table class="layui-table layui-form" style="width: 100%;">
            <thead>
            <tr>
                <th>#springMessage('table.abAccrecords.briefId')</th>
                <th>#springMessage('bill.accebill.InstructionStatus')</th>
                <th>#springMessage('table.abAccrecords.returnCode')</th>
                <th>#springMessage('table.abAccrecords.returnMsg')</th>
                <th>#springMessage('table.abLog.createDate')</th>
            </tr>
            </thead>
            <body>
				#foreach($accrecords in $accrecordsList)
                <tr>
                    <td>$!{accrecords.briefIdName}</td>
                    <td>$!{accrecords.instructStatusName}</td>
                    <td>$!{accrecords.returnCode}</td>
                    <td>$!{accrecords.returnMsg}</td>
                    <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{accrecords.createDate})</td>
                </tr>
				#end
            </body>
        </table>
	#end
    <br />
	#if($!tstList)
	 <h2 class="layui-colla-title">#springMessage('table.innerAccChanging.detail')</h2>
	<table class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('table.abLog.briefId')</th>
                <th>#springMessage('bill.accebill.applyDate')</th>
                <th>#springMessage('billPool.intoApple.intoType')</th>
                <th>#springMessage('common.table.status')</th>
                <th>#springMessage('billPool.optStatus')</th>
            </tr>
            </thead>
		   <body>
				#foreach($tst in $tstList)
				<tr>
                <td>$!{tst.briefIdTypeName}</td>
                <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{tst.createTime})</td>
                <td>$!{tst.inoutTypeName}</td>
                <td>$!{tst.statusName}</td>
                <td>$!{tst.optStatusName}</td>
				</tr>
                #end

            </body>
    	</table>
        #end
    <table class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.abLog.logType')</th>
            <th>#springMessage('table.abLog.briefId')</th>
            <th>#springMessage('table.abLog.msg')</th>
            <th>#springMessage('table.abLog.createName')</th>
            <th>#springMessage('table.abLog.createBy')</th>
            <th>#springMessage('table.abLog.createDate')</th>
        </tr>
        </thead>
        <body>
			#if($!abLogPage)
				#foreach($abLog in $abLogPage)
                <tr>
                    <td>$!{abLog.logTypeName}</td>
                    <td>$!{abLog.briefIdName}</td>
                    <td>#springMessage($!{abLog.msg})</td>
                    <td>$!{abLog.createName}</td>
                    <td>$!{abLog.createBy}</td>
                    <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{abLog.createDate})</td>
                </tr>
				#end
			#end
        </body>
    </table>
    <br />
</div>
<div class="layui-form-item layui-form-submit" id="buttonDiv">
	<div class="layui-input-block">
	<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{poolDTO.viceId}')">#springMessage('common.button.trackFlow')</button>
	<button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div> 
    #parse("views/common/footer.vm")
</body>

<script type="text/javascript">
	bt.use(['moneyType'], function() {
		var billMoney =$("#billMoney").val();
	    $("#moneyUp").text(bt.moneyType.getFun().toChinese(billMoney));

	});
	/**
	*var closeForms=function(){
	*	var index = parent.layer.getFrameIndex(window.name); //先得到当前iframe层的索引
	*	parent.layer.close(index); //再执行关闭 
	*}
	*/
	/**
     * 进行票据信息查看
     * @param id 签收表ID
     * @param type front正面，back背面
     */
    var electronbillView=function(vid,aid){
        parent.layer.open({
        	title:bt.lang('common.button.billinfo'),
            type: 2,
            area: ['850px', '500px'],
            maxmin: true,
            content: basePath + "/bill/accebill/abvoucherinfo/billEcdsInfoView?accId="+aid+"&id=" + vid 
        });
    }

</script>
</html>
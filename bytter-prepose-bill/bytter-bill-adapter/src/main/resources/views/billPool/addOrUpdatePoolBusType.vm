<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{abPoolBusTypeVO.id}">
		<input id="parentId" name="parentId" type="hidden" value="$!{abPoolBusTypeVO.parentId}">
		<input id="bustypeLevel" name="bustypeLevel" type="hidden" value="$!{abPoolBusTypeVO.bustypeLevel}">
		
		<div class="layui-form-item">
			<table class="layui-table">
            <tbody>
                <tr>
					##业务类型代码
                    <td class="textRight" width="25%">#springMessage('billPool.type.bustypeCode')</td>
                    <td width="75%">
 						<div class="layui-input-inline">
                            <input type="text" name="bustypeCode"
                            	   lay-verify="required"   data-maxlength="12"
                                   autocomplete="off" class="layui-input" value="$!{abPoolBusTypeVO.bustypeCode}" placeholder="#springMessage('billPool.type.bustypeCode')">
                        </div>                    
                    </td>
				</tr>
			<tr>
					##业务类型名称
                    <td class="textRight" width="25%">#springMessage('billPool.type.name')</td>
                    <td width="75%">
 						<div class="layui-input-inline">
                            <input type="text" name="bustypeName"
                           		   data-maxlength="100"  lay-verify="required" 
                                   autocomplete="off" class="layui-input" value="$!{abPoolBusTypeVO.bustypeName}" placeholder="#springMessage('billPool.type.name')">
                        </div>                    
                    </td>
				</tr>
            </tbody>
        </table>
		</div>

        <div class="layui-form-submit-adaptive">
            <div style="text-align: center;">
				<button class="layui-btn" lay-submit="" type="button" lay-filter="retreat">#springMessage('common.button.save')</button>
				<button class="layui-btn layui-btn-primary" type="button" name="revert">#springMessage('common.button.revert')</button>
			</div>
		</div>
		
		
		
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
bt.use(['form'], function(){
    var $ = bt.jquery,form = bt.form();
    form.on('submit(retreat)', function(data){
        bt.loading.show();
        submitForm(data);
    });
    //返回
    $("[name='revert']").click(function(){
    	parent.layer.closeAll();
    });
}); 

function submitForm(data){
	   $.post(basePath + '/abpool/bustype/updateAbPoolBusType', data.field, function (result) {
			bt.loading.hide();
			parent.layer.alert(bt.lang(result.msg), {icon: result.success?1:2});
	        if(result.success){
	        	parent.layer.closeAll();
	        }
    },'JSON');
}
</script>
</html>
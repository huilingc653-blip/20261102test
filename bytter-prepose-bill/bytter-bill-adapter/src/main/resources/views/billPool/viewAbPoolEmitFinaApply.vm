<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-table {
            margin: 0px 0;
        }
    </style>
</head>
<body>
<div>
    <form class="layui-form layui-form-pane" id="fromVerify">
        <input type="hidden" id="voucherId" value="$!{abPoolEmitFinaApplyVO.voucherId}">
        <input type="hidden" id="billMoney" value="$!{abPoolEmitFinaApplyVO.billMoney}"></input>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('bill.accebill.billInfo.title')</h2>
            <table class="layui-table">
                <tbody>
                <tr>
                ##申请单号
                    <td class="textRight" colspan="2" >#springMessage('billPool.emitFinaApply.appNo')</td>
                    <td >
                        $!{abPoolEmitFinaApplyVO.appNo}
                    </td>
                ##不得转让标记/能否转让
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.banendrsmtmk')</td>
                    <td >
                        $dictTag.get("AB_BANEM",$!{abPoolEmitFinaApplyVO.banendrsmtmk})
                    </td>
                </tr>
                <tr>
                ##票据金额
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.billMoney')</td>
                    <td >
                        $number.formatNumeric($!{abPoolEmitFinaApplyVO.billMoney})
                    </td>
                ##人民币大写
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.billMoneyUp')</td>
                    <td >
                        <div id="moneyUp"></div>
                    </td>
                </tr>
                <tr>
                ##出票日期
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.startDate')</td>
                    <td >
                        $!date.format('yyyy-MM-dd',$!{abPoolEmitFinaApplyVO.startDate})
                    </td>
                ##到期日期
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.endDate')</td>
                    <td >
                        $!date.format('yyyy-MM-dd',$!{abPoolEmitFinaApplyVO.endDate})
                    </td>
                </tr>
                <tr>
                ##票据类型
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.billType')</td>
                    <td >
                        $dictTag.get("AB_BILL_TYPE",$!{abPoolEmitFinaApplyVO.billType})
                    </td>
                ##流通介质
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.billFlag')</td>
                    <td width="35%">
                        $dictTag.get("AB_BILL_FLAG",$!{abPoolEmitFinaApplyVO.billFlag})
                    </td>
                </tr>
                <tr>
                ##出票人全称
                    <td rowspan="3">#springMessage('bill.accebill.view.payer')</td>
                    <td class="textRight">#springMessage('bill.accebill.view.name')</td>
                    <td width="35%">
                        $!{abPoolEmitFinaApplyVO.payer}
                    </td>
                ##收票人全称
                    <td rowspan="3">#springMessage('bill.accebill.view.payee')</td>
                    <td class="textRight">#springMessage('bill.accebill.view.name')</td>
                    <td width="35%">
                        $!{abPoolEmitFinaApplyVO.payee}
                    </td>
                </tr>
                <tr>
                ##出票人账号
                    <td class="textRight">#springMessage('bill.accebill.view.acc')</td>
                    <td >
                        $!{abPoolEmitFinaApplyVO.payeracc}
                    </td>
                ##收票人账号
                    <td class="textRight">#springMessage('bill.accebill.view.acc')</td>
                    <td >
                        $!{abPoolEmitFinaApplyVO.payeeacc}
                    </td>
                </tr>
                <tr>
                ##出票人开户银行
                    <td class="textRight">#springMessage('bill.accebill.view.BankName')</td>
                    <td >
                        $!{abPoolEmitFinaApplyVO.payerBankName}
                    </td>
                ##收票人开户银行
                    <td class="textRight">#springMessage('bill.accebill.view.BankName')</td>
                    <td >
                        $!{abPoolEmitFinaApplyVO.payeeBankName}
                    </td>
                </tr>
                <tr>
                ##承兑人名称
                    <td rowspan="2">#springMessage('bill.accebill.view.acceptor')</td>
                    <td class="textRight">#springMessage('bill.accebill.view.name')</td>
                    <td width="35%">
                        $!{abPoolEmitFinaApplyVO.acceptor}
                    </td>
                ##承兑人开户行行号
                    <td class="textRight" colspan="2" >#springMessage('bill.accebill.bankno')</td>
                    <td width="35%">
                        $!{abPoolEmitFinaApplyVO.acceptorbankno}
                    </td>
                </tr>
                <tr>
                ##承兑人账号
                    <td class="textRight">#springMessage('bill.accebill.view.acc')</td>
                    <td >
                        $!{abPoolEmitFinaApplyVO.acceptoracc}
                    </td>
                ##承兑人开户行名称
                    <td class="textRight" colspan="2" >#springMessage('bill.accebill.bankname')</td>
                    <td >
                        $!{abPoolEmitFinaApplyVO.acceptorBankName}
                    </td>
                </tr>
                <tr>
                ##融资用途
                    <td width="20%" class="textRight" colspan="2">#springMessage('billPool.emitFinaApply.purposes')</td>
                    <td width="30%">
                        $!{abPoolEmitFinaApplyVO.abs}
                    </td>
                ##
                    <td width="20%" class="textRight" colspan="2"></td>
                    <td width="30%">
                    </td>
                </tr>
#if($!{abPoolEmitFinaApplyVO.voucherId})
                <tr>
                    ##付款单号
                    <td width="20%" class="textRight" colspan="2">#springMessage('table.nisBillhead.viewTitle')</td>
                    <td width="30%">
                        <button type="button" class="layui-btn" onclick="nisBillView()">#springMessage('common.button.view')</button>
                    </td>
                    ##
                    <td width="20%" class="textRight" colspan="2"></td>
                    <td width="30%">
                    </td>
                </tr>
#end
                </tbody>
            </table>
        ##票据池交易明细
            <h2 class="layui-colla-title">#springMessage('billPool.sign.poolDtl.title')</h2>
            <table class="layui-table" width="100%">
                <tbody>
                <tr>
                ##票据池单位
                    <td width="20%" class="textRight">#springMessage('billPool.corp.name')</td>
                    <td width="30%">
                        $!{abPoolEmitFinaApplyVO.corpCodeAndName}
                    </td>
                    <td width="20%" class="textRight">#springMessage('billPool.Limit.bpName')</td>
                    <td width="30%" >
                        $!{abPoolEmitFinaApplyVO.pbCodeAndName}
                    </td>
                </tr>
                    #if(!$isApprove)
                    <tr>
                    ##审批状态
                        <td width="20%" class="textRight">#springMessage('billPool.status')</td>
                        <td width="30%">
                            $dictTag.get("AB_POOL_STATUS",$!{abPoolEmitFinaApplyVO.status})
                        </td>
                    ##指令状态
                        <td width="20%" class="textRight">#springMessage('billPool.optStatus')</td>
                        <td width="30%">
                            $dictTag.get("AB_POOL_DTL_OPT_STATUS",$!{abPoolEmitFinaApplyVO.optStatus})
                        </td>
                    </tr>
                    #end
                </tbody>
            </table>
            #if(!$isApprove)
        ##合同信息
            <h2 class="layui-colla-title">#springMessage('common.button.conInfo')</h2>
            <table class="layui-table" width="100%">
                <thead>
                <tr>
                    <th>#springMessage('contract.conName')</th>
                    <th>#springMessage('contract.conStatus')</th>
                    <th>#springMessage('billPool.optStatus')</th>
                </tr>
                </thead>
                <body>
                    #if($!conInfoList)
                        #foreach($conInfo in $conInfoList)
                        <tr>
                            <td>$!{conInfo.conName}</td>
                            <td>$!dictTag.get("AB_POOL_CON_OP_TYPE",$!{conInfo.conStatus})</td>
                            <td>$!{conInfo.conOptStatusName}</td>
                        </tr>
                        #end
                    #end
                </body>
            </table>
                <br>
                <br>
                <h2 class="layui-colla-title">#springMessage('bill.logInfo.title')</h2>
                <table class="layui-table layui-form" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>#springMessage('table.abLog.createDate')</th>
                        <th>#springMessage('table.abLog.createBy')</th>
                        <th>#springMessage('table.abLog.createName')</th>
                        <th>#springMessage('table.abLog.logType')</th>
                        <th>#springMessage('table.abLog.msg')</th>
                    </tr>
                    </thead>
                    <body>
                        #if($!abLogList)
                            #foreach($logInfo in $abLogList)
                            <tr>
                                <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.createDate})</td>
                                <td>$!{logInfo.createBy}</td>
                                <td>$!{logInfo.createName}</td>
                                <td>$!{logInfo.logTypeName}</td>
                                <td>#springMessage($!{logInfo.msg})</td>
                            </tr>
                            #end
                        #end
                    </body>
                </table>
            #end
            <div class="layui-form-item layui-form-submit">
                <div class="layui-input-block">
                    <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
                </div>
            </div>
        </div>
    </form>
</div>
    #parse("views/common/footer.vm")
</body>

<script type="text/javascript">
    bt.use(['moneyType'], function() {
        var billMoney =$("#billMoney").val();
        $("#moneyUp").text(bt.moneyType.getFun().toChinese(billMoney));

    });
    /**
     * 进行付款单查看
     */
    function nisBillView(){
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/netbank/nisbillhead/viewCommon/" + $("#voucherId").val()
        });
    }
</script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <table class="layui-table">
            <tbody>
              <tr>
                ## 持票单位
                    <td class="textRight">#springMessage('table.fcBond.corpName')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-billPoolCorp"
                                 data-tree-type="check"
                                 data-biz-type="billPoolCorp"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 data-scope="all"
                                 data-resource="abpool:lintoapply:resource:op">
                            </div>
                        </div>
                    </td>
                    ##票据池
                    <td class="textRight">#springMessage('billPool.bail.bp')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-billPool"
                                 data-tree-type="check"
                                 data-biz-type="billPool"
                                 data-biz-name="ins_abPoolId"
                                 data-type="selectTree"
                                 data-name="ins_abPoolId"
                                 data-placeholder="">
                            </div>
                        </div>
                    </td>
                    ##票据类型
                    <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                    <td width="25%">
                        <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE" data-name="eqs_billTypeName"></div>
                    </td>
                    </td>
				</tr>
				<tr>
                    ##票据介质
                    <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_FLAG" data-name="eqs_billFlagName"></div>
                    </td>
                    ##票据金额
                        <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="geg_billMoney" data-moneyendid="endMoney" autocomplete="off"
                                       class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                                <span class="date-mid">~</span>
                                <input type="text" name="leg_billMoney" id="endMoney" autocomplete="off"
                                       class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                            </div>
                        </td>
                    ##票据号码
                        <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_origNo"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
                            </div>
                        </td>
				</tr>
                <tr>
                ##出票日期
                    <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                    <td >
                        <div class="layui-inline"">
                        <input type="text" name="ged_startDate" data-name="ged_startDate" class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date">
                        </div>
                        ~
                        <div class="layui-inline"">
                        <input type="text" name="led_startDate"　data-name="led_startDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date">
                        </div>
                    </td>
                ##出票人
                    <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
                    <td >
                        <div class="layui-input-inline">
                            <input type="text" name="likes_payer"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payer')">
                        </div>
                    </td>
                </tr>
                 <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr> 
            </tbody>
        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
       <th>#springMessage('table.fcBond.corpName')</th>
        <th>#springMessage('bill.accebill.origNo')</th>
		<th>#springMessage('bill.accebill.billType')</th>
		<th>#springMessage('table.abVoucherinfo.billFlag')</th>
		<th>#springMessage('table.abVoucherinfo.billMoney')</th>
		<th>#springMessage('table.abVoucherinfo.startDate')</th>
		<th>#springMessage('billPool.limit.apply.enddata')</th>
		<th>#springMessage('bill.accebill.payer')</th>
        <th>#springMessage('table.abVoucherinfo.payee')</th>
        <th>#springMessage('table.abVoucherinfo.acceptor')</th>
        <th>#springMessage('billPool.bail.bp')</th>
        <th>#springMessage('billPool.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
	#workFlowHtml()
    #parse("views/common/footer.vm")
	#workFlowScript()
</body>
<script type="text/javascript">
var billTable = {};
bt.use(['form','datatable','moneyType','billPool','btdate','billPoolCorp','select','dateType','corp','dicts','selectType'], function () {
    $ = bt.jquery, form = bt.form();
    bt.billPoolCorp.init();
    bt.dicts.init();
    bt.moneyType.init();
    bt.billPool.init();
    bt.corp.init();
    bt.dateType.init();
    bt.selectType.init();
    //生成列表
    billTable = bt.datatable.init({
        elem: "#appTable",
        dom: 'Brtlip',
        colReorder: true,
        checkbox: true, order: [[6, 'desc']],
        searchForm: {
            formElem: "#searchForm",
            formFilter: "search"
        },
        ajax: {
            'url': basePath + "/billPool/intoRepeal/dataTableApprove"
        }
        , columns: [
            {data:"corpName",bSortable:true,
                render: function ( data, type, full, meta ) {
                   return '('+full.corpCode+')'+full.corpName;
                }
            },
            {data:"origNo",bSortable:true},
            {data:"billTypeName",bSortable:true},
            {data:"billFlagName",bSortable:true},
            {data:"billMoney",bSortable:true,className:'textRight',
                render: function ( data, type, full, meta ) {
                    return bt.money.format(full.billMoney);
                }
            },
            {data:"startDate",bSortable:true},
            {data:"endDate",bSortable:true},
            {data:"payer",bSortable:true},
            {data:"payee",bSortable:true},
            {data:"acceptor",bSortable:true},
            {data:"abPoolName",bSortable:true},
            {data:"statusName",bSortable:true},
            {data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
                var html = '';
                if ($("#flowStatus").val() == 'todo') {
                    html += '<a class="" href="#" data-row="' + meta.row + '" onclick="approve(this)">' + bt.lang("common.button.approve") + '</a>&nbsp;|&nbsp;';
                }
                html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                return html;
            }
            }
        ],
        fixedColumns: {
            rightColumns: 1
        }
    });
});


/*审核*/
function approve(el) {
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    var rid = data.apdId;
    if (bt.navtab) {
        bt.navtab.addNavtab(bt.lang('common.button.approve'), basePath + "/billPool/intoRepeal/approve?businessId=" + rid + "&taskId=" + data.taskId);
        return;
    }
    parent.layer.open({
        type: 2,
        area: ['850px', '530px'],
        maxmin: true,
        content: basePath + "/billPool/intoRepeal/approve?businessId=" +  data.apdId + "&taskId=" + data.taskId
    });
}
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
#parse("views/flow/flow.vm")
</head>
<body>
<div>
    <table class="layui-table"  class="layui-form input150-container">
        <tbody>
        <tr>
            ##票据池单位
            <td class="textRight" width="15%">#springMessage('billPool.corp.name')</td>
            <td width="35%">
                 $!{abPoolLimitApplyVO.apcName}
            </td>
            ##票据池
            <td class="textRight" width="15%">#springMessage('billPool.Limit.bpName')</td>
            <td width="35%">
                 $!{abPoolLimitApplyVO.bpName}
            </td>
        </tr>
        <tr>
            ##业务类型
            <td class="textRight"  width="15%">#springMessage('billPool.busType')</td>
            <td width="35%">
                 $!{abPoolLimitApplyVO.bustypeName}
		    </td>
		    ##额度种类
            <td class="textRight"  width="15%">#springMessage('billPool.Limit.limtType')</td>
            <td width="35%">
				$!{abPoolLimitApplyVO.limtTypeName}
		    </td>
        </tr>
        <tr>
            ##申领额度
            <td class="textRight"  width="15%">#springMessage('billPool.limit.apply.money')</td>
            <td width="35%">
				$number.formatNumeric($!{abPoolLimitApplyVO.applyMoney})
		    </td>
		    ##到期日期
            <td class="textRight"  width="15%">#springMessage('billPool.limit.apply.enddata')</td>
            <td width="35%">
				$!date.format('yyyy-MM-dd',$!{abPoolLimitApplyVO.endDate})
		    </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight"  width="15%">#springMessage('billPool.abPoolif.rmk')</td>
            <td width="35%" colspan="3">
               	 $!{abPoolLimitApplyVO.rmk}
		    </td>
        </tr>
        </tbody>
    </table>
    <br/>
    <br/>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn"
                    onclick="bt.trackFlowByBusinessId('$!{abPoolLimitApplyVO.id}')">#springMessage(
                'common.button.trackFlow')</button>
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage(
                'common.button.revert')</button>
        </div>
    </div>
</div>
    #parse("views/common/footer.vm")
    #workFlowHtml()
    #workFlowScript()
<script type="text/javascript">

</script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="13%">#springMessage('billPool.bail.corp')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPoolCorp"
                         data-tree-type="check"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="abpool:bail:in:resource:op"
                         data-placeholder="#springMessage('billPool.bail.corp')">
                    </div>
                </div>
            </td>
        ##票据池
            <td class="textRight" width="11%">#springMessage('billPool.bail.bp')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPool"
                         data-biz-type="billPool"
                         data-biz-name="billPool"
                         data-name="eqs_pbCodeAndName"
                         data-placeholder="#springMessage('billPool.bail.bp')">
                    </div>
                </div>
            </td>
        ##存入金额
            <td class="textRight" width="11%">#springMessage('billPool.bail.depositAmount')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_money" data-moneyendid="endMoney" autocomplete="off"
                           class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.bail.depositAmount')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_money" id="endMoney" autocomplete="off"
                           class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.bail.depositAmount')">
                </div>
            </td>
        </tr>
        <tr>
        ##转出账号
            <td class="textRight" width="12%">#springMessage('billPool.bail.oppOutAcc')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_oppAcc" id="oppAcc" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('billPool.bail.oppOutAcc')">
                </div>
            </td>
        ##申请日期
            <td class="textRight" width="10%">#springMessage('billPool.bail.appDate')</td>
            <td width="23%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_appDate" class="layui-input bt-input-inline bt-biz-dateType" id="appDateStart" data-endid="appDateEnd"
                           placeholder="#springMessage('billPool.bail.appDate')" value="$!{trandTimeStart}" >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_appDate" class="layui-input bt-input-inline bt-biz-dateType" id="appDateEnd"
                           placeholder="#springMessage('billPool.bail.appDate')" value="$!{trandTimeEnd}">
                </div>
            </td>
            <td class="textRight" width="11%"></td>
            <td width="21%">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
    ##单位
        <th>#springMessage('billPool.bail.corp')</th>
    ##保证金账户
        <th>#springMessage('billPool.bail.bankAcc')</th>
    ##存入金额
        <th>#springMessage('billPool.bail.depositAmount')</th>
    ##转出账号
        <th>#springMessage('billPool.bail.oppOutAcc')</th>
    ##申请日期
        <th>#springMessage('billPool.bail.appDate')</th>
    ##票据池
        <th>#springMessage('billPool.bail.bp')</th>
    ##操作
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
</body>
<script src="${basePath}/static/modules/billPool/approve/abPoolBailDtlInApprove.list.js?_btv=${resourceVersion}"></script>
</html>

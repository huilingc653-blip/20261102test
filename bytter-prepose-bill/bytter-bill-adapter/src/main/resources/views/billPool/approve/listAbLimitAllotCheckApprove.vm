<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <table class="layui-table">
            <tbody>
            <tr>
			##单位
                <td class="textRight" >#springMessage('billPool.bail.corp')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-billPoolCorp"
                             data-tree-type="check"
                             data-biz-name="corpId"
                             data-type="selectTree"
                             data-name="ins_corpId"
                             data-resource="abpool:limitallotcheck:resource:op"
                             data-placeholder="#springMessage('billPool.bail.corp')">
                        </div>
                    </div>
                </td>
			##分配额度
                <td class="textRight" >#springMessage('billPool.Limit.applyMoney')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <input type="text" name="geg_applyMoney" data-moneyendid="endApplyMoney" autocomplete="off" data-minus="true"
                               class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.applyMoney')">
                        <span class="date-mid">~</span>
                        <input type="text" name="leg_applyMoney" id="endApplyMoney" autocomplete="off" data-minus="true"
                               class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.applyMoney')">
                    </div>
                </td>
			##分配日期
                <td class="textRight" >#springMessage('billPool.Limit.createTime')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <input type="text" name="ged_createTime" class="layui-input bt-input-inline bt-biz-dateType" id="appDateStart" data-endid="appDateEnd"
                               placeholder="#springMessage('billPool.Limit.createTime')"  >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_createTime" class="layui-input bt-input-inline bt-biz-dateType" id="appDateEnd"
                               placeholder="#springMessage('billPool.Limit.createTime')" >
                    </div>
                </td>
            </tr>
            <tr>
			##票据池
                <td class="textRight" >#springMessage('billPool.bail.bp')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-billPool"
                             data-biz-type="billPool"
                             data-biz-name="billPool"
                             data-name="eqs_bpId"
                             data-placeholder="#springMessage('billPool.bail.bp')">
                        </div>
                    </div>
                </td>
			##可用额度
                <td class="textRight" >#springMessage('billPool.Limit.validMoney')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <input type="text" name="geg_validMoney" data-moneyendid="endValidMoney" autocomplete="off"
                               class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.validMoney')">
                        <span class="date-mid">~</span>
                        <input type="text" name="leg_validMoney" id="endValidMoney" autocomplete="off"
                               class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.Limit.validMoney')">
                    </div>
                </td>
                <td class="textRight" ></td>
                <td width="24%">
                </td>
            </tr>
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('billPool.bail.corp')</th>
        <th>#springMessage('billPool.Limit.createTime')</th>
        <th>#springMessage('billPool.Limit.limtType')</th>
        <th>#springMessage('billPool.Limit.poolMoney')</th>
        <th>#springMessage('billPool.Limit.lockMoney')</th>
        <th>#springMessage('billPool.Limit.validMoney')</th>
        <th>#springMessage('billPool.Limit.applyMoney')</th>
        <th>#springMessage('billPool.Limit.rmk')</th>
        <th>#springMessage('billPool.Limit.parentName')</th>
        <th>#springMessage('billPool.Limit.bustypeLevel')</th>
        <th>#springMessage('billPool.Limit.bpName')</th>
        <th>#springMessage('billPool.Limit.checkType')</th>
        <th>#springMessage('billPool.Limit.checkMsg')</th>
        <th>#springMessage('billPool.bail.returnMsg')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
	#workFlowHtml()
    #parse("views/common/footer.vm")
	#workFlowScript()
</body>
<script src="${basePath}/static/modules/billPool/approve/abPoolLimitAllotCheckApprove.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="12%">#springMessage('billPool.bail.corp')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPoolCorp"
                         data-tree-type="check"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="abpool:emitfina:apply:resource:op"
                         data-placeholder="#springMessage('billPool.bail.corp')">
                    </div>
                </div>
            </td>
        ##票据池
            <td class="textRight" width="12%">#springMessage('billPool.bail.bp')</td>
            <td width="22%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPool"
                         data-biz-type="billPool"
                         data-biz-name="billPool"
                         data-name="eqs_pbCodeAndName"
                         data-placeholder="#springMessage('billPool.bail.bp')">
                    </div>
                </div>
            </td>
        ##票据金额
            <td class="textRight" width="11%">#springMessage('billPool.emitFinaApply.billMoney')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_billMoney" data-moneyendid="endMoney" autocomplete="off"
                           class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_billMoney" id="endMoney" autocomplete="off"
                           class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                </div>
            </td>
        </tr>
        <tr>
        ##融资用途
            <td class="textRight" width="11%">#springMessage('billPool.emitFinaApply.purposes')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_purposes" id="oppAcc" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('billPool.emitFinaApply.purposes')">
                </div>
            </td>
        ##出票日期
            <td class="textRight" width="10%">#springMessage('table.abVoucherinfo.startDate')</td>
            <td width="23%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_startDate" class="layui-input bt-input-inline bt-biz-dateType" id="dateStart" data-endid="dateEnd"
                           placeholder="#springMessage('table.abVoucherinfo.startDate')" value="$!{dateStart}" >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_startDate" class="layui-input bt-input-inline bt-biz-dateType" id="dateEnd"
                           placeholder="#springMessage('table.abVoucherinfo.startDate')" value="$!{dateEnd}">
                </div>
            </td>
        ##审批状态
            <td class="textRight" width="11%"></td>
            <td width="21%">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
    ##单位
        <th>#springMessage('billPool.bail.corp')</th>
    ##申请单号
        <th>#springMessage('billPool.emitFinaApply.appNo')</th>
    ##票据池
        <th>#springMessage('billPool.bail.bp')</th>
    ##票据类型
        <th>#springMessage('bill.accebill.billType')</th>
    ##票据介质
        <th>#springMessage('billPool.emitFinaApply.billFlag')</th>
    ##票据金额
        <th>#springMessage('billPool.emitFinaApply.billMoney')</th>
    ##申请人账号
        <th>#springMessage('billPool.emitFinaApply.applyAcc')</th>
    ##融资用途
        <th>#springMessage('billPool.emitFinaApply.purposes')</th>
    ##是否转让
        <th>#springMessage('billPool.emitFinaApply.transfer')</th>
    ##出票日期
        <th>#springMessage('table.abVoucherinfo.startDate')</th>
    ##到期日期
        <th>#springMessage('billPool.limit.apply.enddata')</th>
    ##收票人
        <th>#springMessage('table.abVoucherinfo.payee')</th>
    ##承兑人
        <th>#springMessage('billPool.emitFinaApply.acceptor')</th>
        ##付款单号
        <th>#springMessage('table.nisBillhead.billNo')</th>
    ##操作
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
</body>
<script src="${basePath}/static/modules/billPool/approve/abPoolEmitFinaApplyApprove.list.js?_btv=${resourceVersion}"></script>
</html>

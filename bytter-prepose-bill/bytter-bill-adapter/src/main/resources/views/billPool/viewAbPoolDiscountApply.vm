<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-table {
            margin: 0px 0;
        }
    </style>
</head>
<body>
<div>
    <form class="layui-form layui-form-pane" id="fromVerify">
        <input type="hidden" id="billMoney" value="$!{billInfo.billMoney}"></input>
    <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('bill.accebill.billInfo.title')</h2>
            <table class="layui-table">
                <tbody>
                <tr>
                ##票据号码
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.origNo')</td>
                    <td >
                        $!{billInfo.origNo}
                    </td>
                ##不得转让标记/能否转让
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.banendrsmtmk')</td>
                    <td >
                        $!{billInfo.banendrsmtmkName}
                    </td>
                </tr>
                <tr>
                ##票据金额
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.billMoney')</td>
                    <td >
                        $number.formatNumeric($!{billInfo.billMoney})
                    </td>
                ##人民币大写
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.billMoneyUp')</td>
                    <td >
                        <div id="moneyUp"></div>
                    </td>
                </tr>
                <tr>
                ##出票日期
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.startDate')</td>
                    <td >
                        $!date.format('yyyy-MM-dd',$!{billInfo.startDate})
                    </td>
                ##到期日期
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.endDate')</td>
                    <td >
                        $!date.format('yyyy-MM-dd',$!{billInfo.endDate})
                    </td>
                </tr>
                <tr>
                ##票据类型
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.billType')</td>
                    <td >
                        $!{billInfo.billTypeName}
                    </td>
                ##流通介质
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.billFlag')</td>
                    <td width="35%">
                        $!{billInfo.billFlagName}
                    </td>
                </tr>
                <tr>
                ##出票人全称
                    <td rowspan="3">#springMessage('bill.accebill.view.payer')</td>
                    <td class="textRight">#springMessage('bill.accebill.view.name')</td>
                    <td width="35%">
                        $!{billInfo.payer}
                    </td>
                ##收票人全称
                    <td rowspan="3">#springMessage('bill.accebill.view.payee')</td>
                    <td class="textRight">#springMessage('bill.accebill.view.name')</td>
                    <td width="35%">
                        $!{billInfo.payee}
                    </td>
                </tr>
                <tr>
                ##出票人账号
                    <td class="textRight">#springMessage('bill.accebill.view.acc')</td>
                    <td >
                        $!{billInfo.payeracc}
                    </td>
                ##收票人账号
                    <td class="textRight">#springMessage('bill.accebill.view.acc')</td>
                    <td >
                        $!{billInfo.payeeacc}
                    </td>
                </tr>
                <tr>
                ##出票人开户银行
                    <td class="textRight">#springMessage('bill.accebill.view.BankName')</td>
                    <td >
                        $!{billInfo.payerBankName}
                    </td>
                ##收票人开户银行
                    <td class="textRight">#springMessage('bill.accebill.view.BankName')</td>
                    <td >
                        $!{billInfo.payeeBankName}
                    </td>
                </tr>
                <tr>
                ##承兑人名称
                    <td rowspan="2">#springMessage('bill.accebill.view.acceptor')</td>
                    <td class="textRight">#springMessage('bill.accebill.view.name')</td>
                    <td width="35%">
                        $!{billInfo.acceptor}
                    </td>
                ##承兑人开户行行号
                    <td class="textRight" colspan="2" >#springMessage('bill.accebill.bankno')</td>
                    <td width="35%">
                        $!{billInfo.acceptorbankno}
                    </td>
                </tr>
                <tr>
                ##承兑人账号
                    <td class="textRight">#springMessage('bill.accebill.view.acc')</td>
                    <td >
                        $!{billInfo.acceptoracc}
                    </td>
                ##承兑人开户行名称
                    <td class="textRight" colspan="2" >#springMessage('bill.accebill.bankname')</td>
                    <td >
                        $!{billInfo.acceptorBankName}
                    </td>
                </tr>
                <tr>
                ##承兑合同号/交易合同号
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.aContractNo')</td>
                    <td width="35%">
                        $!{billInfo.acontractNo}
                    </td>
                ##发票号
                    <td class="textRight" colspan="2" >#springMessage('table.abVoucherinfo.aInvcnb')</td>
                    <td >
                        $!{billInfo.ainvcnb}
                    </td>
                </tr>
                </tbody>
            </table>
        #if($abPoolDiscountVO.status)
        <h2 class="layui-colla-title">#springMessage('bill.accebill.billBuInfo.title')</h2>
        <table class="layui-table" width="100%">
            <tbody>
            <tr>
            ##持票单位
                <td class="textRight" colspan="2">#springMessage('table.abVoucherinfoVice.corpId')</td>
                <td width="35%">
                    $!{billInfo.corpName}
                </td>
            ##持票单位账号
                <td class="textRight" colspan="2">#springMessage('table.abVoucherinfoVice.bankAcc')</td>
                <td width="35%">
                    $!{billInfo.bankAcc}
                </td>
            </tr>
            <tr>
                ##业务申请日期
                <td colspan="2" class="textRight">#springMessage('bill.accebill.bussdt')</td>
                <td>
                    $!date.format('yyyy-MM-dd',$!{billInfo.applyDate})
                </td>
                ##业务办理日期
                <td colspan="2" class="textRight">#springMessage('table.abAccrecords.businessDate')</td>
                <td>
                    $!date.format('yyyy-MM-dd',$!{billInfo.businessDate})
                </td>
            </tr>
            <tr>
                <td rowspan="2">#springMessage('bill.accebill.discountReq.title')</td>
                <td class="textRight">#springMessage('bill.accebill.role')</td>
                <td>$!{billInfo.reqRoleName}</td>
                <td class="textRight" colspan="2">#springMessage('bill.accebill.name')</td>
                <td>$!{billInfo.reqNm}</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('bill.accebill.bankacc')</td>
                <td>$!{billInfo.reqAcctId}</td>
                <td class="textRight" colspan="2">#springMessage('bill.accebill.bankno')</td>
                <td>$!{billInfo.reqAcctsvcr}</td>
            </tr>

            <tr>
                <td rowspan="2">#springMessage('bill.accebill.discountRec.title')</td>
                <td class="textRight">#springMessage('bill.accebill.name')</td>
                <td>$!{billInfo.recNm}</td>
                <td class="textRight" colspan="2">#springMessage('bill.accebill.bankacc')</td>
                <td>$!{billInfo.recAcctId}</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('bill.accebill.bankno')</td>
                <td>$!{billInfo.recAcctsvcr}</td>
                <td class="textRight" colspan="2"></td>
                <td></td>
            </tr>
            </tbody>
        </table>
        #end
        ##票据池交易明细
        <h2 class="layui-colla-title">#springMessage('billPool.sign.poolDtl.title')</h2>
            <table class="layui-table">
                <tbody>
                    <tr>
                    ##票据池单位
                        <td width="20%" class="textRight">#springMessage('billPool.corp.name')</td>
                        <td width="30%">
                            ($!{abPoolDiscountVO.corpCode})$!{abPoolDiscountVO.corpName}
                        </td>
                        <td width="20%" class="textRight">#springMessage('billPool.Limit.bpName')</td>
                        <td width="30%" >
                            $!{abPoolDiscountVO.bpName}
                        </td>
                    </tr>
                    #if(!$isApprove)
                    <tr>
                    ##审批状态
                        <td width="20%" class="textRight">#springMessage('billPool.status')</td>
                        <td width="30%">
                            $!{abPoolDiscountVO.statusName}
                        </td>
                    ##指令状态
                        <td width="20%" class="textRight">#springMessage('billPool.optStatus')</td>
                        <td width="30%">
                            $!{abPoolDiscountVO.optStatusName}
                        </td>
                    </tr>
                    #end
                </tbody>
            </table>
    </div>
        #if(!$isApprove)
            <h2 class="layui-colla-title">#springMessage('common.button.businessDtl')</h2>
            <table class="layui-table layui-form" style="width: 100%;">
                <thead>
                <tr>
                    <th>#springMessage('table.abAccrecords.briefId')</th>
                    <th>#springMessage('bill.accebill.InstructionStatus')</th>
                    <th>#springMessage('table.abAccrecords.returnCode')</th>
                    <th>#springMessage('table.abAccrecords.returnMsg')</th>
                    <th>#springMessage('table.abLog.createDate')</th>
                </tr>
                </thead>
                <body>
                    #if($!accrecordsList)
                        #foreach($accrecords in $accrecordsList)
                        <tr>
                            <td>$!{accrecords.briefIdName}</td>
                            <td>$!{accrecords.instructStatusName}</td>
                            <td>$!{accrecords.returnCode}</td>
                            <td>$!{accrecords.returnMsg}</td>
                            <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{accrecords.createDate})</td>
                        </tr>
                        #end
                    #end
                </body>
            </table>
        #end
    </form>
    #if(!$isApprove)
        <br>
        <br>
        <h2 class="layui-colla-title">#springMessage('bill.logInfo.title')</h2>
        <table class="layui-table layui-form" style="width: 100%;">
            <thead>
            <tr>
                <th>#springMessage('table.abLog.createDate')</th>
                <th>#springMessage('table.abLog.createBy')</th>
                <th>#springMessage('table.abLog.createName')</th>
                <th>#springMessage('table.abLog.logType')</th>
                <th>#springMessage('table.abLog.msg')</th>
            </tr>
            </thead>
            <body>
                #if($!abLogList)
                    #foreach($logInfo in $abLogList)
                    <tr>
                        <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.createDate})</td>
                        <td>$!{logInfo.createBy}</td>
                        <td>$!{logInfo.createName}</td>
                        <td>$!{logInfo.logTypeName}</td>
                        <td>#springMessage($!{logInfo.msg})</td>
                    </tr>
                    #end
                #end
            </body>
        </table>
    #end
<br />
<br /> 
<div class="layui-form-item layui-form-submit" id="buttonDiv">
	<div class="layui-input-block">
	<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{abPoolDiscountVO.id}')">#springMessage('common.button.trackFlow')</button>
	<button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
</div>
    #parse("views/common/footer.vm")
</body>

<script type="text/javascript">
    bt.use(['moneyType'], function() {
        var billMoney =$("#billMoney").val();
        $("#moneyUp").text(bt.moneyType.getFun().toChinese(billMoney));

    });
    /**
     *var closeForms=function(){
	*	var index = parent.layer.getFrameIndex(window.name); //先得到当前iframe层的索引
	*	parent.layer.close(index); //再执行关闭
	*}
     */


</script>
</html>
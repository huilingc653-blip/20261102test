<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
     <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
					##持票单位
                    <td class="textRight">#springMessage('table.fcBond.corpName')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-billPoolCorp"
                                 data-tree-type="check"
                                 data-biz-type="billPoolCorp"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 data-scope="all"
                                 data-resource="abpool:applycheck:resource:op">
                            </div>
                        </div>
                    </td>
					##票据池
					<td class="textRight" width="10%">#springMessage('billPool.Limit.bpName')</td>
					<td  width="23%">
                         <div class="layui-input-inline">
		                    <div class="bt-biz-billPool"
		                         data-tree-type="check"
		                         data-biz-type="billPool"
		                         data-name="eqs_bpId"
		                         data-type="selectTree"
		                         data-name="bpId"
		                         data-placeholder="">
		                    </div>
		                </div>
                    </td>
                    ##申领日期
                    <td class="textRight" width="10%">#springMessage('billPool.bail.appDate')</td>
					<td  width="23%">
                        <div class="layui-inline">
                    		<input type="text" name="ged_transDate" class="layui-input bt-biz-dateType" data-endid="led_transDate" data-today="false">
                	  	</div>
	                	<span class="date-mid">~</span>
	                	 <div class="layui-inline">
	                    	<input type="text" name="led_transDate" class="layui-input bt-biz-dateType" id="led_transDate" data-today="false">
	               		 </div>
                    </td>
				</tr>
				<tr>
					##业务类型
                   <td class="textRight" width="10%">#springMessage('billPool.busType')</td>
		            <td width="23%">
		                <div class="layui-input-inline">
		                    <div class="bt-biz-busType"
		                         data-tree-type="check"
		                         data-biz-type="busType"
		                         data-biz-name="busTypeId"
		                         data-type="selectTree"
		                         data-name="ins_busTypeId"
		                         data-placeholder="">
		                    </div>
		                </div>
		            </td>
		           ##额度类型
                   <td class="textRight" width="10%">#springMessage('billPool.Limit.limtType')</td>
		           <td width="23%">
		                  <div class="bt-biz-dict" data-type="select" data-group="AB_POOL_LIMT_TYPE" data-name="eqs_limtType"></div>
		           </td>
		           ##申领额度
                   <td class="textRight" width="10%">#springMessage('billPool.limit.apply.money')</td>
		           <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="geg_applyMoney" data-moneyendid="endMoney" autocomplete="off"
                                       class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('billPool.limit.apply.money')">
                                <span class="date-mid">~</span>
                                <input type="text" name="leg_applyMoney" id="endMoney" autocomplete="off"
                                       class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('billPool.limit.apply.money')">
                            </div>
                   </td>
				</tr>
				<tr>
				  ##审批状态
                   <td class="textRight" width="10%">#springMessage('billPool.bail.status')</td>
		            <td width="23%">
                        <div class="bt-biz-dict" data-type="select" data-group="AB_POOL_STATUS"  data-filterData="0,-2" data-name="eqs_status"></div>
		            </td>
		           ##指令状态
                   <td class="textRight" width="10%">#springMessage('billPool.optStatus')</td>
		            <td width="23%">
		                  <div class="bt-biz-dict" data-type="select" data-group="AB_POOL_OPT_STATUS"  data-name="eqs_opStatus"></div>
		            </td>
				</tr>
				#if($shiro.hasPermission("abpool:applycheck:resource:op"))
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
				#end
            </tbody>
        </table>
        </form>
		#if($shiro.hasPermission("abpool:applycheck:resource:op"))
		<table id="appTable" class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		    	<th>#springMessage('table.fcBond.corpName')</th>
		    	<th>#springMessage('billPool.Limit.checkType')</th>
		    	<th>#springMessage('billPool.Limit.parentName')</th> 
		        <th>#springMessage('billPool.type.bustypeCode')</th>
		        <th>#springMessage('billPool.type.name')</th>
				<th>#springMessage('billPool.type.parentBusName')</th>
				<th>#springMessage('billPool.Limit.limtType')</th>
				<th>#springMessage('billPool.limit.apply.money')</th>
				<th>#springMessage('billPool.limit.apply.enddata')</th>
				<th>#springMessage('billPool.Limit.rmk')</th>
				<th>#springMessage('bill.accebill.applyDate')</th>
				<th>#springMessage('billPool.Limit.bustypeLevel')</th>
				<th>#springMessage('billPool.Limit.bpName')</th>
				<th>#springMessage('billPool.bail.status')</th>
				<th>#springMessage('billPool.bail.optStatus')</th>
				<th>#springMessage('billPool.bail.returnMsg')</th>
				<th>#springMessage('common.table.thead.operation')</th>
		    </tr>
		    </thead>
		</table>
		#end
#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
var billTable={},corp,busTypeJson={};
bt.use(['form','selectTree','treeTable','datatable','moneyType','billPoolCorp','busType','dateType','dicts','billPool','moneyType'],function(){
	 bt.billPool.init();
	 bt.moneyType.init();
	 bt.billPoolCorp.init();
	 bt.dicts.init();
	 bt.dateType.init();
	 bt.moneyType.init();
	  $ = bt.jquery,form = bt.form();
	  busTypeJson = bt.busType.init();
	//生成列表
	    billTable = bt.datatable.init({
	        elem: "#appTable",
	        dom: 'Brtlip',
	        colReorder: true,
	        checkbox: true, 
	        order: [[1, 'asc']],
	        searchForm: {
	            formElem: "#searchForm",
	            formFilter: "search"
	        },
	        ajax: {
	            'url': basePath + "/billPool/applyCheck/datatable"
	        },
	        buttons: [
	            //新增、导出
	            {
	                text: bt.lang('common.button.audit'),
	                action: function (e, dt, node, config) {
	                    audit(dt.rows('.selected').data());
	                }
	            }, {
	                extend: "colvis",
	                text: bt.lang('common.button.theadHide'),
	                columns: ':not(:first):not(:last)'
	            }
	        ]
	        , columns: [
	         	{data:"corpName",bSortable:true,
                    render: function ( data, type, full, meta ) {
                       return '('+full.corpCode+')'+full.corpName;
                    }
                },
                {data: "checkTypeName", bSortable: true},
                {data: "parentCorpName", bSortable: true},
	            {data: "bustypeCode", bSortable: true},
	            {data: "bustypeName", bSortable: true},
	            {data: "parentBusName", bSortable: true},
	            {data: "limtTypeName", bSortable: true},
	            {data:"applyMoney",bSortable:true,className:'textRight',
	                render: function ( data, type, full, meta ) {
	                   	return bt.money.format(full.applyMoney); 
	                   }
	            },
	            {data: "endDate", bSortable: true},
	            {data: "rmk", bSortable: true},
	            {data:"createTime",className:'center',bSortable:true,
	                render: function (data, type, full, meta) {
	                     return bt.date.format(full.createTime, "yyyy-MM-dd");
	                }
	            },
	            {data: "corpLevel", bSortable: true},
	            {data: "bpName", bSortable: true},
	            {data: "statusName", bSortable: true},
	            {data: "opStatusName", bSortable: true},
	            {data: "returnMsg", bSortable: true},
	            {
	                 data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
		                var html = '';
						//交易失败的可重新发送或中止
						if(data.opStatus==-1){
							html = html+'<a class="" href="#" data-row="'+meta.row+'" onclick="operation(this,16)">'+bt.lang("common.button.resend")+'</a>';
							html = html+' | <a class="" href="#" data-row="'+meta.row+'" onclick="operation(this,-2)">'+bt.lang("common.button.tovoid")+'</a>  | ';
						}
						html = html + '<a class="" href="#" data-row="' + meta.row + '" onclick="detail(this)">' + bt.lang("common.button.view") + '</a>';
		                return html;
	            	}
	            }
	        ],
	        fixedColumns: {
	            rightColumns: 1
	        }
	    });
});

function audit(data){
	var len = data.length;
    if(!len){
        layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 7});
        return;
    }
    //校验数据权限
    var rowData = data.splice(0,len);
    var ids;
    var abCount = 0;
    var abBillMoney=0.00;
    for(i=0;i<len;i++){
        if(ids){
            ids=ids+","+rowData[i].id;
            abBillMoney=abBillMoney+bt.money.toNumber(rowData[i].applyMoney);
            abCount++;
        }else{
            ids=rowData[i].id;
            abCount++;
            abBillMoney=bt.money.toNumber(rowData[i].applyMoney);
        }
    }
    parent.layer.open({
        type: 2,
        area: ['885px', '459px'],
        maxmin: true,
        content: basePath + "/billPool/applyCheck/markeApple/" + ids+"?abBillMoney="+abBillMoney+"&abCount="+abCount,
        end:function(){
            bt.datatable.refreshCurrentPage();
        }
    });

}

function detail(el){
 		var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
	    parent.layer.open({
	        type: 2,
	        area: ['850px', '459px'],
	        maxmin: true,
	        content: basePath + "/billPool/applyCheck/detail/" + data.id,
	        end:function(){
	        	bt.datatable.refreshCurrentPage();
	        }
	  });  
}

//操作   重发、中止
function operation(el,status){
	var data = billTable.row(layui.jquery(el).data("row")).data();
	var msg;
	if(status==16){
		msg = "common.message.confirm.bisquerycmd.resend";
	}else if(status==-2){
		msg = "common.message.confirm.tovoid";
	}
	parent.layer.confirm(bt.lang(msg),function(){
		bt.loading.show();
		$.post(basePath + "/bill/pool/abbillInstructionManage/operation",{"id":data.id,"type":"applyCheck","status":status}, function(result){
			bt.loading.hide();
			if(result.success){
				parent.layer.alert(bt.lang(result.msg), {icon: result.success?1:2});
				bt.datatable.refreshCurrentPage();
			}else{
				parent.layer.alert(bt.lang(result.msg), {icon: result.success?1:2});
			}
		},'JSON');
	});
}
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="13%">#springMessage('billPool.bail.corp')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPoolCorp"
                         data-tree-type="check"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="bill:accebill:abBillInstruction:queryTest"
                         data-placeholder="#springMessage('billPool.bail.corp')">
                    </div>
                </div>
            </td>
        ##票据池
            <td class="textRight" width="11%">#springMessage('billPool.bail.bp')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPool"
                         data-biz-type="billPool"
                         data-biz-name="billPool"
                         data-name="eqs_pbCodeAndName"
                         data-placeholder="#springMessage('billPool.bail.bp')">
                    </div>
                </div>
            </td>
            ##交易金额
                <td class="textRight" width="11%">#springMessage('billPool.bail.transAmount')</td>
                <td width="21%">
                    <div class="layui-input-inline">
                        <input type="text" name="geg_money" data-moneyendid="endMoney" autocomplete="off"
                               class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.bail.transAmount')">
                        <span class="date-mid">~</span>
                        <input type="text" name="leg_money" id="endMoney" autocomplete="off"
                               class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('billPool.bail.transAmount')">
                    </div>
                </td>
        </tr>
        <tr>
            ##对方账号
                <td class="textRight" width="12%">#springMessage('billPool.bail.oppAcc')</td>
                <td width="20%">
                    <div class="layui-input-inline">
                        <input type="text" name="likes_oppAcc" id="oppAcc" autocomplete="off" class="layui-input"
                               placeholder="#springMessage('billPool.bail.oppAcc')">
                    </div>
                </td>
            ##交易类型
                <td class="textRight" width="11%">#springMessage('billPool.bail.transtype')</td>
                <td width="21%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="mulselect" data-name="ini_typeName" placeholder="#springMessage('billPool.bail.transtype')"
                             data-group="AB_POOL_BAIL_TRANS_TYPE">
                        </div>
                    </div>
                </td>
            ##指令状态
                <td class="textRight" width="11%">#springMessage('billPool.bail.optStatus')</td>
                <td width="21%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="mulselect" data-name="ins_optStatus" placeholder="#springMessage('billPool.bail.status')"
                             data-group="AB_POOL_OPT_STATUS">
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
            ##申请日期
                <td class="textRight" width="10%">#springMessage('billPool.bail.appDate')</td>
                <td width="23%">
                    <div class="layui-input-inline">
                        <input type="text" name="ged_appDate" class="layui-input bt-input-inline bt-biz-dateType" id="appDateStart" data-endid="appDateEnd"
                               placeholder="#springMessage('billPool.bail.appDate')" value="$!{appDateStart}" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_appDate" class="layui-input bt-input-inline bt-biz-dateType" id="appDateEnd"
                               placeholder="#springMessage('billPool.bail.appDate')" value="$!{appDateEnd}">
                    </div>
                </td>
                <td class="textRight" width="11%"></td>
                <td width="21%">
                </td>
                <td class="textRight" width="11%"></td>
                <td width="21%">
                </td>
            </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
    ##单位
        <th>#springMessage('billPool.bail.corp')</th>
    ##保证金账户
        <th>#springMessage('billPool.bail.bankAcc')</th>
    ##交易金额
        <th>#springMessage('billPool.bail.transAmount')</th>
    ##对方账号
        <th>#springMessage('billPool.bail.oppAcc')</th>
    ##对方户名
        <th>#springMessage('billPool.bail.oppAccName')</th>
    ##申请日期
        <th>#springMessage('billPool.bail.appDate')</th>
    ##票据池
        <th>#springMessage('billPool.bail.bp')</th>
    ##交易类型
        <th>#springMessage('billPool.bail.transtype')</th>
    ##指令状态
        <th>#springMessage('billPool.bail.optStatus')</th>
    ##银行返回代码
        <th>#springMessage('billPool.returnCode')</th>
    ##银行返回信息
        <th>#springMessage('billPool.bail.returnMsg')</th>
    ##操作
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abBillInstructionManageTestPoolBail.list.js?_btv=${resourceVersion}"></script>
</html>

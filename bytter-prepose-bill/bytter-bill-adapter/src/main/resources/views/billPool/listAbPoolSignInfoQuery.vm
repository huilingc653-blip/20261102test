<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="13%">#springMessage('billPool.bail.corp')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPoolCorp"
                         data-tree-type="check"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="abpool:query:poolsign:op"
                         data-placeholder="#springMessage('billPool.bail.corp')">
                    </div>
                </div>
            </td>
        ##票据池
            <td class="textRight" width="11%">#springMessage('billPool.bail.bp')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPool"
                         data-biz-type="billPool"
                         data-biz-name="billPool"
                         data-name="eqs_poolNo"
                         data-placeholder="#springMessage('billPool.bail.bp')">
                    </div>
                </div>
            </td>
            ##签约机构
                <td class="textRight" width="12%">#springMessage('billPool.sign.origName')</td>
                <td width="20%">
                    <div class="layui-input-inline">
                        <input type="text" name="likes_signOrgName" id="signOrgName" autocomplete="off" class="layui-input"
                               placeholder="#springMessage('billPool.sign.origName')">
                    </div>
                </td>
            </tr>
            <tr>
            ##签约日期
                <td class="textRight" width="10%">#springMessage('billPool.sign.date')</td>
                <td width="23%">
                    <div class="layui-input-inline">
                        <input type="text" name="ged_signDate" class="layui-input bt-input-inline bt-biz-dateType" id="signDateBegin" data-endid="signDateEnd"
                               placeholder="#springMessage('billPool.sign.date')" value="" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_signDate" class="layui-input bt-input-inline bt-biz-dateType" id="signDateEnd"
                               placeholder="#springMessage('billPool.sign.date')" value="">
                    </div>
                </td>
                <td class="textRight" width="11%"></td>
                <td width="21%">
                </td>
                <td class="textRight" width="11%"></td>
                <td width="21%">
                </td>
            </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
    ##单位
        <th>#springMessage('billPool.bail.corp')</th>
    ##合同编号
        <th>#springMessage('billPool.sign.conNo')</th>
    ##合同日期
        <th>#springMessage('billPool.sign.conDate')</th>
    ##签约日期
        <th>#springMessage('billPool.sign.date')</th>
    ##签约机构
        <th>#springMessage('billPool.sign.signOrigName')</th>
    ##票据池状态
        <th>#springMessage('billPool.sign.status')</th>
    ##保证金账户
        <th>#springMessage('billPool.bail.bankAcc')</th>
    ##保证金余额
        <th>#springMessage('billPool.bail.balMoney')</th>
    ##票据池
        <th>#springMessage('billPool.bail.bp')</th>
    ##企业票据池机构号
        <th>#springMessage('billPool.sign.origCode')</th>
    ##企业票据池机名称
        <th>#springMessage('billPool.sign.origName')</th>
    ##同步日期
        <th>#springMessage('billPool.bank.syn.date')</th>
    ##操作
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolSignInfoQuery.list.js?_btv=${resourceVersion}"></script>
</html>

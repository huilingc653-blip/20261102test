<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位代码
            <td class="textRight" width="20%">#springMessage('billPool.corp.code')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <input type="text" name="corpCode" id="corpCode" autocomplete="off" value="$!{queryVO.corpCode}"
                           class="layui-input" placeholder="#springMessage('billPool.corp.code')">
                </div>
            </td>
        ##单位名称
            <td class="textRight" width="20%">#springMessage('billPool.corp.name')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <input type="text" name="corpName" id="corpName" autocomplete="off" value="$!{queryVO.corpName}"
                           class="layui-input" placeholder="#springMessage('billPool.corp.name')">
                </div>
            </td>
        </tr>
        #*<tr>
        ##票据池单位组件使用
            <td class="textRight" width="20%">#springMessage('billPool.corp.name')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPoolCorp"
                         data-tree-type="check"
                         data-biz-type="billPoolCorp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="corpId"
                         data-resource="abpool:corp:op"
                         data-defaultvalue="$!{queryVO.corpId}"
                         data-placeholder="#springMessage('billPool.corp.name')">
                    </div>
                </div>
            </td>
        </tr>*#
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" type="button" onclick="searchForm()">#springMessage('common.button.search')</button>
                <button class="layui-btn" type="button" onclick="resetClick()">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <div style="padding-top: 10px;">
    ##新增
        <button class="layui-btn" type="button" onclick="addBillPoolCorp()" >#springMessage('common.button.add')</button>
    ##删除
        <button class="layui-btn" type="button" onclick="deleteBillPoolCorp()" >#springMessage('common.button.delete')</button>
    </div>
    <div style="width: 100%;margin-bottom: 10px;">
        <table id="appTable" class="layui-table" style="width:100%;">
            <thead>
            <tr>
                <th width="5%" style="padding-left: 10px"><input type="checkbox" name="checkAll" lay-skin="primary" lay-filter="checkAll"></th>
                ##单位代码
                <th>#springMessage('billPool.corp.code')</th>
                ##单位名称
                <th>#springMessage('billPool.corp.name')</th>
                ##上级单位
                <th>#springMessage('billPool.corp.higher')</th>
                ##层级
                <th>#springMessage('billPool.corp.level')</th>
                ##状态
                <th>#springMessage('billPool.corp.status')</th>

                <th width="18%">#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
            <tbody>
                #foreach($info in $listInfo)
                <tr data-tt-id="$!{info.id}"  data-tt-parent-id="$!{info.parentId}" onclick="checkTr('$!{info.id}')">
                    <td align="center"><input lay-skin="primary" type="checkbox" #if($!{info.validSign} == 1) disabled #end lay-filter="check" name="checkDetailId" value="$!{info.id}"></td>
                    <td>$!{info.corpCode}</td>
                    <td >
                        $!{info.corpName}
                    </td>
                    <td >$!{info.higherCorp}</td>
                    <td >$!{info.bustypeLevel}</td>
                    <td align="center">
                        $!dictTag.get('AB_POOL_VALID_SIGN', $!{info.validSign})
                    </td>
                    <td align="center">
                    ##修改
                        #if($!{info.validSign} != 1)
                            <a class="" href="#" onclick="updateCorp('$!{info.id}')">#springMessage("common.button.edit")</a>
                            <span class="text-explode">|</span>
                        #end
                    ##增加下级
                        <a class="" href="#" onclick="addLowerCorp('$!{info.id}','$!{info.bustypeLevel}')">#springMessage("common.link.add")</a>
                        <span class="text-explode">|</span>
                    ##禁用启用
                        #if($info.validSign eq '1')
                            <a class="" href="#" onclick="changeBillPoolCorp('$!{info.id}','disable')">#springMessage("common.button.disable")</a>
                        #else
                        <a class="" href="#" onclick="changeBillPoolCorp('$!{info.id}','enable')">#springMessage("common.button.enable")</a>
                        #end
                    </td>
                </tr>
                #end
        </table>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolCorp.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
     <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
					##申领额度
					<td class="textRight" width="10%">#springMessage('billPool.limit.apply.money')</td>
					<td  width="23%">
                          <div class="layui-inline">
                            <input type="text" name="geg_applyMoney" class="layui-input bt-biz-moneyType" data-moneyendid="endMoney" placeholder="#springMessage('billPool.limit.apply.money')">
                         </div>
                          <span class="date-mid">~</span>
                         <div class="layui-inline">
                            <input type="text" name="leg_applyMoney" class="layui-input bt-biz-moneyType" id="endMoney" placeholder="#springMessage('billPool.limit.apply.money')">
                        </div>
                    </td>
					##票据池
					<td class="textRight" width="10%">#springMessage('billPool.Limit.bpName')</td>
					<td  width="23%">
                         <div class="layui-input-inline">
		                    <div class="bt-biz-billPool"
		                         data-tree-type="check"
		                         data-biz-type="billPool"
		                         data-name="eqs_bpId"
		                         data-type="selectTree"
		                         data-name="bpId"
		                         data-placeholder="">
		                    </div>
		                </div>
                    </td>
                    ##申领日期
                    <td class="textRight" width="10%">#springMessage('billPool.bail.appDate')</td>
					<td  width="23%">
                        <div class="layui-inline">
                    		<input type="text" name="ged_transDate" class="layui-input bt-biz-dateType" data-endid="led_transDate" data-today="false">
                	  	</div>
	                	<span class="date-mid">~</span>
	                	 <div class="layui-inline">
	                    	<input type="text" name="led_transDate" class="layui-input bt-biz-dateType" id="led_transDate" data-today="false">
	               		 </div>
                    </td>
				</tr>
				<tr>
					##业务类型
                   <td class="textRight" width="10%">#springMessage('billPool.busType')</td>
		            <td width="23%">
		                <div class="layui-input-inline">
		                    <div class="bt-biz-busType"
		                         data-tree-type="check"
		                         data-biz-type="busType"
		                         data-biz-name="busTypeId"
		                         data-type="selectTree"
		                         data-name="ins_busTypeId"
		                         data-placeholder="">
		                    </div>
		                </div>
		            </td>
				</tr>
				#if($shiro.hasPermission("abpool:limitapply:resource:op"))
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
				#end
            </tbody>
        </table>
        </form>
		#if($shiro.hasPermission("abpool:limitapply:resource:op"))
		<table id="appTable" class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		    	<th>#springMessage('billPool.Limit.apply.corp')</th>
				<th>#springMessage('billPool.Limit.parentName')</th>
				<th>#springMessage('billPool.Limit.bustypeLevel')</th>
		        <th>#springMessage('billPool.type.bustypeCode')</th>
		        <th>#springMessage('billPool.type.name')</th>
				<th>#springMessage('billPool.type.parentBusName')</th>
				<th>#springMessage('billPool.Limit.limtType')</th>
				<th>#springMessage('billPool.limit.apply.money')</th>
				<th>#springMessage('billPool.limit.apply.enddata')</th>
				<th>#springMessage('billPool.Limit.rmk')</th>
				<th>#springMessage('billPool.Limit.applyDate')</th>
				<th>#springMessage('billPool.Limit.bpName')</th>
				<th>#springMessage('common.table.thead.operation')</th>
		    </tr>
		    </thead>
		</table>
		#end
#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
var billTable={},corp,busTypeJson={};
bt.use(['form','selectTree','treeTable','datatable','busType','dateType','dicts','billPool','moneyType'],function(){
	 bt.billPool.init();
	 bt.dicts.init();
	 bt.dateType.init();
	 bt.moneyType.init();
	  $ = bt.jquery,form = bt.form();
	  busTypeJson = bt.busType.init();
	//生成列表
	    billTable = bt.datatable.init({
	        elem: "#appTable",
	        dom: 'Brtlip',
	        colReorder: true,
	        checkbox: false, 
	        order: [[1, 'asc']],
	        searchForm: {
	            formElem: "#searchForm",
	            formFilter: "search"
	        },
	        ajax: {
	            'url': basePath + "/abpool/limitApply/datatable"
	        },
	        buttons: [
	            //新增、导出
	            {
	                text: bt.lang('common.button.add'),
	                hide:bt.isnotResource('abpool:limitapply:resource:op'),
	                action: function (e, dt, node, config) {
	                    add();
	                }
	            }, {
	                extend: "colvis",
	                text: bt.lang('common.button.theadHide'),
	                columns: ':not(:first):not(:last)'
	            }
	        ]
	        , columns: [
	        	{data: "apcName", bSortable: true},
	            {data: "parentCorpName", bSortable: true},
	            {data: "corpLevel", bSortable: true},
	            {data: "bustypeCode", bSortable: true},
	            {data: "bustypeName", bSortable: true},
	            {data: "parentBusName", bSortable: true},
	            {data: "limtTypeName", bSortable: true},
	            {data: "applyMoney",bSortable:true,className:'textRight',
	                render: function ( data, type, full, meta ) {
	                   	return bt.money.format(full.applyMoney);
	                   }
	            },
	            {data: "endDate", bSortable: true},
	            {data: "rmk", bSortable: true},
	            {data:"createTime",className:'center',bSortable:true,
	                render: function (data, type, full, meta) {
	                     return bt.date.format(full.createTime, "yyyy-MM-dd");
	                }
	            },
	            {data: "bpName", bSortable: true},
	            {
	                 data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
		                var html = '';
		                    html = html + '<a class="" href="#" data-row="' + meta.row + '" onclick="detail(this)">' + bt.lang("common.button.view") + '</a>';
		                return html;
	            	}
	            }
	        ],
	        fixedColumns: {
	            rightColumns: 2
	        }
	    });
	

	  //时间
	  $.each($("div[type='date']"),function(i,item){
	      bt.btdate.init({
	          elem: "[field='"+$(item).attr("field")+"']",//需显示日期的元素选择器
	          name: $(item).attr("field"),
	          start: $(item).attr("defaultVal"),
	          format: "YYYY-MM-DD",
	          istime: false
	      });
	  });
	  $.each($("div[type='datetime']"),function(i,item){
	      bt.btdate.init({
	          elem: "[field='"+$(item).attr("field")+"']",
	          name: $(item).attr("field"),
	          start: $(item).attr("defaultVal"),
	          format: "YYYY-MM-DD hh:mm:ss",
	          istime: true
	      });
	  });
});

function add(){
	if(bt.navtab){
        bt.navtab.addNavtab(bt.lang('billPool.Limit.apply.info'),basePath + "/abpool/limitApply/add");
        return;
    }
}

function detail(el){
 		var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
	    parent.layer.open({
	        type: 2,
	        area: ['850px', '459px'],
	        maxmin: true,
	        content: basePath + "/abpool/limitApply/detail/" + data.id,
	        end:function(){
	        	bt.datatable.refreshCurrentPage();
	        }
	  });  
}

</script>
</html>

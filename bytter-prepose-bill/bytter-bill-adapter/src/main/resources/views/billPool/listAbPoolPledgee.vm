<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
     <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
					##票据池名称
					<td class="textRight" width="25%">#springMessage('billPool.Pledgee.name')</td>
					<td width="25%">
                         <div class="layui-input-inline">
                            <input type="text" name="likes_bpName"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.Pledgee.name')">
                        </div>
                    </td>
					##池类型
                    <td class="textRight">#springMessage('billPool.Pledgee.type')</td>
                   	<td width="25%" >
                          <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_POOL_BP_TYPE" data-name="eqs_bpType"></div>
                    </td>
				</tr>
				<tr>
					##池控制机构
                    <td class="textRight" width="25%">#springMessage('billPool.Pledgee.org')</td>
                    <td width="25%">
 						<div class="layui-input-inline">
                            <input type="text" name="likes_bpOrg"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.Pledgee.org')">
                        </div>        
                     </td>
                    ##池状态
                    <td class="textRight" width="25%">#springMessage('billPool.Pledgee.state')</td>
                    <td width="25%" >
                        <div class="bt-biz-dict" data-filterData="-2" data-type="select" data-group="AB_POOL_VALID_SIGN" data-name="eqs_validSign"></div>
                    </td>
				</tr>
				
				#if($shiro.hasPermission("abpool:pledgee:resource:op"))
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
				#end
            </tbody>
        </table>
    </form>

#if($shiro.hasPermission("abpool:pledgee:resource:op"))
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('billPool.Pledgee.code')</th>
        <th>#springMessage('billPool.Pledgee.name')</th>
        <th>#springMessage('billPool.Pledgee.type')</th>
		<th>#springMessage('billPool.Pledgee.bankAcc')</th>
		<th>#springMessage('billPool.Pledgee.bankAccName')</th>
		<th>#springMessage('billPool.Pledgee.bankName')</th>
		<th>#springMessage('billPool.Pledgee.bankNo')</th>
		<th>#springMessage('billPool.Pledgee.rmk')</th>
		<th>#springMessage('billPool.Pledgee.status')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#end
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolPledgee.list.js?_btv=${resourceVersion}"></script>
</html>

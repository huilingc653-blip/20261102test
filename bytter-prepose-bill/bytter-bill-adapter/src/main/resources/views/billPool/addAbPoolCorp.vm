<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="parentId" id="parentId" value="$!{parentId}"/>
    <input type="hidden" name="id" id="id" value="$!{id}"/>
    <input type="hidden" name="bustypeLevel" id="bustypeLevel" value="$!{bustypeLevel}"/>
    <input type="hidden" name="corpIds" id="corpIds" value="$!{corpIds}"/>
    <table class="layui-table">
        <tbody>
        <tr>
        ###单位
            <td class="textRight" width="40%">#springMessage('billPool.bail.corp')</td>
            <td width="60%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="radio"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="corpId"
                         data-scope="all"
                         data-required="true"
                         data-callbackData="corpCallback"
                         data-defaultvalue="$!{abPoolCorpVO.corpId}"
                         placeholder="#springMessage('billPool.bail.corp')">
                    </div>
                </div>
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" lay-filter="save" value="submit">#springMessage('common.button.save')</button>
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.cancel')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolCorp.add.js?_btv=${resourceVersion}"></script>
</html>

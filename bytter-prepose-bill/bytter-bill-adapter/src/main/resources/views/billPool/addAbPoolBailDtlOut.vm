<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="oppAccName" id="oppAccName" value=""/>
    <input type="hidden" name="oppBankName" id="oppBankName" value=""/>
    <input type="hidden" name="oppBankNo" id="oppBankNo" value=""/>
    <input type="hidden" name="type" id="type" value=""/>
    <input type="hidden" name="bailId" id="bailId" value=""/>
    <input type="hidden" name="bailMoney" id="bailMoney" value=""/>
    <input type="hidden" name="validMoney" id="validMoney" value=""/>
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="17%">#springMessage('billPool.bail.corp')</td>
            <td width="33%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPoolCorp"
                         data-tree-type="radio"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="corpId"
                         data-callback="corpCallback"
                         data-required="true"
                         data-resource="abpool:bail:out:resource:op"
                         data-placeholder="#springMessage('billPool.bail.corp')">
                    </div>
                </div>
            </td>
        ##票据池
            <td class="textRight" width="17%">#springMessage('billPool.bail.bp')</td>
            <td width="33%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPool" data-biz-name="billPool" data-name="billPool" data-callback="poolCallback" id="billPool"
                         data-required="true" data-placeholder="#springMessage('billPool.bail.bp')">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
        ##保证金账户
            <td class="textRight" width="17%">#springMessage('billPool.bail.bankAcc')</td>
            <td width="33%">
                <div id="bankAcc"></div>
            </td>
            ##转入账号
            <td class="textRight" width="17%">#springMessage('billPool.bail.oppInAcc')</td>
            <td width="33%">
                <div class="layui-input-inline">
                    <input type="text" id="oppAcc" name="oppAcc" data-name="oppAcc" data-biz-name="oppAcc"
                           data-resource="abpool:bail:in:resource:op" lay-verify="required" data-defaultcorp = "xx"
                           class="bank layui-input bt-biz-accountTable" data-callback="oppAccCallBack">
                </div>
            </td>
        </tr>
        <tr>
            ##保证金余额
            <td class="textRight" width="17%">#springMessage('billPool.bail.balance')</td>
            <td width="33%">
                <div id="bailMoney1"></div>
            </td>
            ##可用额度
            <td class="textRight" width="17%">#springMessage('billPool.Limit.validMoney')</td>
            <td width="33%">
                <div id="validMoney1"></div>
            </td>
        </tr>
        <tr>
            ##提取金额
            <td class="textRight" width="17%">#springMessage('billPool.bail.extractAmount')</td>
            <td width="33%">
                <div class="layui-input-inline">
                    <input type="text" id="money" name="money"  lay-verify="required" data-biz-name="money" autocomplete="off"
                           class="layui-input bt-biz-moneyType" placeholder="#springMessage('billPool.bail.extractAmount')">
                </div>
            </td>
            <td class="textRight" width="17%"></td>
            <td width="33%">
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="submit">#springMessage('common.button.submit')</button>
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolBailDtlOut.add.js?_btv=${resourceVersion}"></script>
</html>

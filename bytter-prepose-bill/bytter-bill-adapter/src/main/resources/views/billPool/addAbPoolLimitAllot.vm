<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <input type="hidden" name="poolMoney" id="poolMoney" value=""/>
    <input type="hidden" name="validMoney" id="validMoney" value=""/>
    <input type="hidden" name="lockMoney" id="lockMoney" value=""/>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('billPool.LimitAllot')</h2>
            <div class="layui-colla-content layui-show">
            <table class="layui-table">
                <tbody>
                <tr>
                ##单位
                    <td class="textRight" width="17%">#springMessage('billPool.bail.corp')</td>
                    <td width="33%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-billPoolCorp"
                                 data-tree-type="radio"
                                 data-biz-name="corpId"
                                 data-type="selectTree"
                                 data-name="corpId"
                                 data-callback="corpCallback"
                                 data-required="true"
                                 data-resource="abpool:limitallot:resource:op"
                                 data-placeholder="#springMessage('billPool.bail.corp')">
                            </div>
                        </div>
                    </td>
                ##票据池
                    <td class="textRight" width="17%">#springMessage('billPool.Limit.bpName')</td>
                    <td width="33%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-billPool" data-biz-name="bpId" data-name="bpId" data-callback="poolCallback"
                                 data-required="true" data-placeholder="#springMessage('billPool.Limit.bpName')">
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                ##票据池额度
                    <td class="textRight" width="17%">#springMessage('billPool.Limit.poolMoney')</td>
                    <td width="33%">
                        <div id="poolMoneyDiv"></div>
                    </td>
                ##可用额度
                    <td class="textRight" width="17%">#springMessage('billPool.Limit.validMoney')</td>
                    <td width="33%">
                        <div id="validMoneyDiv"></div>
                    </td>
                </tr>
                <tr>
                ##业务类型
                    <td class="textRight" width="17%">#springMessage('billPool.busType')</td>
                    <td width="33%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-busType"
                                 data-biz-type="check"
                                 data-tree-type="radio"
                                 data-type="selectTree"
                                 data-name="busTypeId"
                                 name="busTypeId"
                                 data-biz-name="busTypeId"
                                 data-defaultvalue=""
                                 data-placeholder="#springMessage('billPool.busType')">
                            </div>
                        </div>
                    </td>
                ##额度种类
                    <td class="textRight" width="17%">#springMessage('billPool.Limit.limtType')</td>
                    <td width="33%">
                        <div class="bt-biz-dict" data-type="select" data-group="AB_POOL_LIMT_TYPE" data-name="limtType"  ></div>
                    </td>
                </tr>
                <tr>
                ##分配额度
                    <td class="textRight" width="17%">#springMessage('billPool.Limit.applyMoney')</td>
                    <td width="33%">
                        <div class="layui-input-inline">
                            <input type="text" id="applyMoney" name="applyMoney" lay-verify="required" data-biz-name="applyMoney" autocomplete="off"
                                   class="layui-input bt-biz-moneyType" data-minus="true" data-callback="applyMoneyEvent" placeholder="#springMessage('billPool.Limit.applyMoney')">
                        </div>
                    </td>
                ##调剂后额度
                    <td class="textRight" width="17%">#springMessage('billPool.Limit.finalMoney')</td>
                    <td width="33%">
                        <div class="layui-input-inline">
                            <input type="text" id="finalMoney" name="finalMoney"  lay-verify="required" data-biz-name="finalMoney" autocomplete="off"
                                   class="layui-input bt-biz-moneyType" data-callback="finalMoneyEvent" placeholder="#springMessage('billPool.Limit.finalMoney')">
                        </div>
                    </td>
                </tr>
                <tr>
                    ##备注
                    <td class="textRight" width="17%">#springMessage('billPool.Limit.rmk')</td>
                    <td width="33%">
                        <div class="layui-input-inline">
                            <input type="text" id="rmk" name="rmk"  lay-verify="strlength" data-maxlength="200"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.Limit.rmk')">
                        </div>
                    </td>
                    <td class="textRight" width="17%"></td>
                    <td width="33%">
                    </td>
                </tr>
                </tbody>
            </table>
            </div>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" id="subBtn" lay-submit="" lay-filter="submit" value="submit">#springMessage('common.button.submit')</button>
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolLimitAllot.add.js?_btv=${resourceVersion}"></script>
</html>


<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
					## 接口名称
					<td class="textRight" width="25%">#springMessage('billPool.abPoolif.pifName')</td>
					<td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_pifName"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.abPoolif.pifName')">
                        </div>
                    </td>
					##接口状态
                    <td class="textRight" width="25%">#springMessage('billPool.abPoolif.ifstatus')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <div class=bt-biz-dict data-type="select" data-name="eqi_validSign"  data-group="AB_POOL_VALID_SIGN">
                            </div>
                        </div>
                    </td>
				</tr>
				#if($shiro.hasPermission("abpool:poolif:resource:op"))
                <tr>
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
				#end
            </tbody>
        </table>
    </form>

#if($shiro.hasPermission("abpool:poolif:resource:op"))
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('billPool.abPoolif.pifCode')</th>
        <th>#springMessage('billPool.abPoolif.pifName')</th>
        <th>#springMessage('billPool.abPoolif.bifCode')</th>
		<th>#springMessage('billPool.abPoolif.rmk')</th>
		<th>#springMessage('billPool.abPoolif.status')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#end


#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolif.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{abPoolPledgeeVO.id}">
		<input id="pId" name="pId" type="hidden" value="$!{abPoolPledgeeVO.pId}">
		
		<div class="layui-form-item">
			<table class="layui-table">
            <tbody>
                <tr>
					##票据池代码	
					<td class="textRight" width="25%">#springMessage('billPool.Pledgee.code')</td>
					<td   width="75%">
                         $!{abPoolPledgeeVO.bpCode}
                    </td>
				</tr>
				 <tr>
					##票据池名称
					<td class="textRight"  width="25%">#springMessage('billPool.Pledgee.name')</td>
					<td width="25%">
                         $!{abPoolPledgeeVO.bpName}
                    </td>
				</tr>
			#if(${flag})				
	
				<tr>
					##质权人账号
                    <td class="textRight" width="25%">#springMessage('billPool.Pledgee.bankAcc')</td>
                    <td width="75%">
                         $!{abPoolPledgeeVO.bankAcc}               
                    </td>
				</tr>
				<tr>
					##质权人名称
                    <td class="textRight" width="25%">#springMessage('billPool.Pledgee.bankAccName')</td>
                    <td width="75%">
 						$!{abPoolPledgeeVO.accName}                         
                    </td>
				</tr>
				<tr>
					##质权人开户行号
					<td class="textRight" width="25%">#springMessage('billPool.Pledgee.bankNo')</td>
					<td width="75%">
						$!{abPoolPledgeeVO.bankNo}
					</td>
				</tr>
				<tr>
					##质权人开户行
                    <td class="textRight" width="25%">#springMessage('billPool.Pledgee.bankName')</td>
                    <td width="75%">
                        $!{abPoolPledgeeVO.bankName}                   
                    </td>
				</tr>
				<tr>
					##备注
                    <td class="textRight" width="25%">#springMessage('billPool.Pledgee.rmk')</td>
                    <td width="75%">
 						  $!{abPoolPledgeeVO.rmk}                              
                    </td>
				</tr>
            </tbody>
        </table>
		</div>

        <div class="layui-form-submit-adaptive">
            <div style="text-align: center;">
				<button class="layui-btn layui-btn-primary" type="button" name="revert">#springMessage('common.button.revert')</button>
			</div>
		</div>
		#else
			<tr>
					##质权人账号
                    <td class="textRight" width="25%">#springMessage('billPool.Pledgee.bankAcc')</td>
                    <td width="75%">
 						<div class="layui-input-inline">
                            <input type="text" name="bankAcc" lay-verify="required"
                                   autocomplete="off" class="layui-input" value="$!{abPoolPledgeeVO.bankAcc}" placeholder="#springMessage('billPool.Pledgee.bankAcc')">
                        </div>                    
                    </td>
				</tr>
				<tr>
					##质权人名称
                    <td class="textRight" width="25%">#springMessage('billPool.Pledgee.bankAccName')</td>
                    <td width="75%">
 						<div class="layui-input-inline">
                            <input type="text" name="accName" lay-verify="required"
                                   autocomplete="off" class="layui-input" value="$!{abPoolPledgeeVO.accName}" placeholder="#springMessage('billPool.Pledgee.bankAccName')">
                        </div>                    
                    </td>
				</tr>
				<tr>
					##质权人开户行号
					<td class="textRight" width="25%">#springMessage('billPool.Pledgee.bankNo')</td>
					<td width="75%">
						<div class="layui-input-inline"><input type="text" id="bankNo"  value="$!{abPoolPledgeeVO.bankNo}" name="bankNo" autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.Pledgee.bankNo')" lay-verify="required|strlength" data-maxlength="12">
							<div class="bt-div-search"><button class="bt-biz-bankInfo" type="button" data-callback="bt.bankinfoCallback" ><i class="layui-icon">&#xe615;</i></button></div>
						</div>
					</td>
				</tr>
				<tr>
					##质权人开户行
                    <td class="textRight" width="25%">#springMessage('billPool.Pledgee.bankName')</td>
                    <td width="75%">
 						<div class="layui-input-inline">
                            <input type="text" name="bankName" id="bankName" lay-verify="required"
                                   autocomplete="off" class="layui-input" value="$!{abPoolPledgeeVO.bankName}" placeholder="#springMessage('billPool.Pledgee.bankName')">
                        </div>                    
                    </td>
				</tr>
				<tr>
					##备注
                    <td class="textRight" width="25%">#springMessage('billPool.Pledgee.rmk')</td>
                    <td width="75%">
 						<div class="layui-input-inline">
                            <input type="text" name="rmk" value="$!{abPoolPledgeeVO.rmk}"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.Pledgee.rmk')">
                        </div>                    
                    </td>
				</tr>
            </tbody>
        </table>
		</div>

        <div class="layui-form-submit-adaptive">
            <div style="text-align: center;">
				<button class="layui-btn" lay-submit="" type="button" lay-filter="retreat">#springMessage('common.button.save')</button>
				<button class="layui-btn layui-btn-primary" type="button" name="revert">#springMessage('common.button.revert')</button>
			</div>
		</div>
		#end
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolPledgeeDtl.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
	#springMessage('billPool.busType'):
    <div class="layui-input-inline">
        <div class="bt-biz-busType" 
			 id="busType"  data-name="busType"
             data-biz-name="conType" 
			 data-corpid="$!{params.corpId}" 
			 data-pdcode="$!{params.pdCode}"> 
		</div>
    </div>
    </form>
#parse("views/common/footer.vm")
<script type="text/javascript">
var conType;
bt.use(['form','busType'], function(){
	busType=bt.busType.init();
});

var callbackdata = function () {
   var conTypeId = bt.conType.get("conType").val();
   return conTypeId.trim();
}

</script>
</body>
</html>

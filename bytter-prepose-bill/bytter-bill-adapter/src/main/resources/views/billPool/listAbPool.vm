<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
					## 票据池名称
					<td class="textRight" width="25%">#springMessage('billPool.abPool.bpName')</td>
					<td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_bpName"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.abPool.bpName')">
                        </div>
                    </td>
					##池类型
                    <td class="textRight" width="25%">#springMessage('billPool.abPool.bpType')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <div class=bt-biz-dict data-type="select" data-name="eqi_bpType"  data-group="AB_BILL_POOL_BP_TYPE">
                            </div>
                        </div>
                    </td>
				</tr>
                <tr>
                    ##池控制机构
                    <td class="textRight" width="25%">#springMessage('billPool.abPool.bpOrg')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_bpOrg"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('billPool.abPool.bpOrg')">
                        </div>
                    </td>
                ##池状态
                    <td class="textRight">#springMessage('billPool.abPool.status')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <div class=bt-biz-dict data-type="select" data-name="eqi_validSign"  data-group="AB_POOL_VALID_SIGN">
                            </div>
                        </div>
                    </td>
                </tr>
				#if($shiro.hasPermission("abpool:pool:resource:op"))
                <tr>
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
				#end
            </tbody>
        </table>
    </form>
#if($shiro.hasPermission("abpool:pool:resource:op"))
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('billPool.abPool.bpCode')</th>
        <th>#springMessage('billPool.abPool.bpName')</th>
		<th>#springMessage('billPool.abPool.bpOrg')</th>
        <th>#springMessage('billPool.abPool.bpMode')</th>
		<th>#springMessage('billPool.abPool.bpType')</th>
		<th>#springMessage('billPool.abPool.pifName')</th>
		<th>#springMessage('billPool.abPool.rmk')</th>
		<th>#springMessage('billPool.abPool.status')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#end

#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPool.list.js?_btv=${resourceVersion}"></script>
</html>

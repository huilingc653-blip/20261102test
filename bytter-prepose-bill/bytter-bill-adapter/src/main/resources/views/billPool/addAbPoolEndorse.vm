<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="get">
    <input type="hidden" id="ids" name="ids" value="$!{abPoolEndorseVO.id}" />
    <input type="hidden" id="billFlag" name="billFlag" value="$!{abPoolEndorseVO.billFlag}" />
    <h2 class="layui-colla-title">#springMessage('billPool.endorse.detail')</h2>
    <table class="layui-table" >
        <tbody>
        <tr>
        ##票据张数
            <td class="textRight" width="15%">#springMessage('billPool.billNumber')</td>
            <td width="35%" >
                $!{abPoolEndorseVO.length}
            </td>
        ##合计金额
            <td class="textRight" width="15%">#springMessage('billPool.totalMoney')</td>
            <td width="35%" >
                $number.formatNumeric($!{abPoolEndorseVO.billMoney})
            </td>
        </tr>
        <tr>
        ##被背书人账号
            <td class="textRight">#springMessage('bill.accebill.endorseeNo')</td>
            <td>
                <div class="layui-input-inline"  >
                    <input type="text" id="recAcctId" name="recAcctId"  lay-verify="required|strlength"  data-maxlength="32"
                           autocomplete="off" class="layui-input bank" placeholder="#springMessage('bill.accebill.endorseeNo')">

                    <div class="bt-div-search" >
                        <button class="bt-biz-externalCorpBankAcc" type="button" data-callback="bt.bailCorpCallback"><i class="layui-icon">&#xe615;</i></button>
                    </div>
                </div>
            </td>
        ##是否转让
            <td class="textRight">#springMessage('table.abBillEndorse.isMakeOver')</td>
            <td align="left">
                <div class="bt-biz-dict" data-type="radio" data-group="AB_BANEM" data-defaultvalue="EM00" data-name="banendrsmtmk" data-required="true" data-placeholder=""></div>
            </td>
        </tr>
        <tr>
        ##被背书人
            <td class="textRight">#springMessage('bill.accebill.endorseeName')</td>
            <td width="35%">
                    <input type="text" id="recNm" name="recNm"  lay-verify="required|strlength" data-maxlength="60"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.endorseeName')"/>
            </td>
        ##被背书人开户行行号
            <td class="textRight">#springMessage('bill.accebill.endorseeBankNo')</td>
            <td width="35%">
                <div class="layui-input-inline">
                    <input type="text" id="recAcctsvcr" name="recAcctsvcr"  readonly="true" lay-verify="required|strlength" data-maxlength="12"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.endorseeBankNo')">
                    <div class="bt-div-search"  >
                        <button class="bt-biz-bankInfo" type="button" data-callback="bt.bankinfoCallback"><i class="layui-icon">&#xe615;</i></button>
                    </div>
                </div>
                <div class="layui-input-inline" >
                    <input type="text" id="recAcctsvcrName" name="recAcctsvcrName" lay-verify="strlength" data-maxlength="150"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.endorseeBankName')">
                </div>
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="submit">#springMessage('common.button.save')</button>
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolEndorse.add.js?_btv=${resourceVersion}"></script>
</html>
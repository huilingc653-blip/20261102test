<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="get">
    <input type="hidden" id="ids" name="ids" value="$!{ids}" />
    <input type="hidden" id="num" name="num" value="$!{num}" />
    <h2 class="layui-colla-title">#springMessage('billPool.Limit.allotCheck')</h2>
    <table class="layui-table" >
        <tbody>
        <tr>
            ##笔数
            <td class="textRight" width="15%">#springMessage('billPool.Limit.number')</td>
            <td width="35%" >
                $!{num}
            </td>
            ##合计分配额度
            <td class="textRight" width="15%">#springMessage('billPool.Limit.applyMoneySum')</td>
            <td width="35%" >
                $number.formatNumeric($!{applyMoney})
            </td>
        </tr>
        </tbody>
    </table>
    ##核准意见
    <div class="layui-form-item layui-form-text margin-top">
        <label class="layui-form-label">#springMessage("billPool.Limit.approvalOpinion")</label>
        <div class="layui-input-block" style="width: 600px;">
            <textarea name="checkMsg" id="checkMsg" lay-verify="strlength" data-maxlength="200" placeholder="#springMessage("billPool.Limit.approvalOpinion")" class="layui-textarea"></textarea>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" value="1" lay-filter="submit">#springMessage('common.button.pass')</button>
            <button class="layui-btn" lay-submit="" value="0" lay-filter="submit">#springMessage('common.button.notPass')</button>
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolLimitAllotCheck.add.js?_btv=${resourceVersion}"></script>
</html>
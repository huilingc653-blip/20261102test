<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div>
	<table class="layui-table"  class="layui-form input150-container">
        <tbody>
        <tr>
    ##单位
            <td class="textRight" width="15%">#springMessage('billPool.bail.corp')</td>
            <td width="35%">
				#if($info.poolNo)
					($!{info.corpCode})
				#end
                 $!{info.corpName}
            </td>
   ##合同编号
            <td class="textRight" width="15%">#springMessage('billPool.sign.conNo')</td>
            <td width="35%">
                 $!{info.conNo}
            </td>
        </tr>
        <tr>
    ##合同日期
            <td class="textRight"  width="15%">#springMessage('billPool.sign.conDate')</td>
            <td width="35%">
				$!date.format('yyyy-MM-dd',$!{info.conDate})
		    </td>
	   ##签约日期
            <td class="textRight"  width="15%">#springMessage('billPool.sign.date')</td>
            <td width="35%">
				$!date.format('yyyy-MM-dd',$!{info.signDate})
		    </td>
        </tr>
        <tr>
      ##签约机构
            <td class="textRight"  width="15%">#springMessage('billPool.sign.signOrigName')</td>
            <td width="35%">
                 $!{info.signOrgName}
		    </td>
		##票据池状态
            <td class="textRight"  width="15%">#springMessage('billPool.sign.status')</td>
            <td width="35%">
                 $!{info.validSignName}
		    </td>
        </tr>
        <tr>
      ##保证金账户
            <td class="textRight"  width="15%">#springMessage('billPool.bail.bankAcc')</td>
            <td width="35%">
                 $!{info.bailAcc}
		    </td>
	##保证金余额
            <td class="textRight"  width="15%">#springMessage('billPool.bail.balMoney')</td>
            <td width="35%">
				#if($info.bailMoney)
				$number.formatNumeric($!{info.bailMoney})
				#end
		    </td>
        </tr>
        <tr>
     ##票据池
            <td class="textRight"  width="15%">#springMessage('billPool.bail.bp')</td>
            <td width="35%">
				#if($info.poolNo)
					($!{info.poolNo})
				#end
                 $!{info.poolName}
		    </td>
	##企业票据池机构号
            <td class="textRight"  width="15%">#springMessage('billPool.sign.origCode')</td>
            <td width="35%">
                 $!{info.origCode}
		    </td>
        </tr>
        <tr>
   ##企业票据池机名称
            <td class="textRight"  width="15%">#springMessage('billPool.sign.origName')</td>
            <td width="35%">
                 $!{info.origName}
		    </td>
    ##同步日期
            <td class="textRight"  width="15%">#springMessage('billPool.bank.syn.date')</td>
            <td width="35%">
				#if($info.createTime)
				$!date.format('yyyy-MM-dd HH:mm:ss',$!{info.updateTime})
				#end
		    </td>
        </tr>
        </tbody>
    </table>
<div class="layui-form-item layui-form-submit" id="buttonDiv">
	<div class="layui-input-block">
	<button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
</div>
    #parse("views/common/footer.vm")
</body>
</html>
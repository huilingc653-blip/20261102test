<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="billFlag" id="billFlag" value="11"/>
    <input type="hidden" name="billType" id="billType" value="10"/>
    <input type="hidden" name="dtlId" id="dtlId" value="$!{abPoolEmitFinaApplyVO.dtlId}"/>
    <input type="hidden" name="payer" id="payer" value="$!{abPoolEmitFinaApplyVO.payer}"/>
    <input type="hidden" name="payerBankName" id="payerBankName" value="$!{abPoolEmitFinaApplyVO.payerBankName}"/>
    <input type="hidden" name="payerbankno" id="payerbankno" value="$!{abPoolEmitFinaApplyVO.payerbankno}"/>
    <input type="hidden" name="aid" id="aid" value="$!{abPoolEmitFinaApplyVO.aid}"/>
    <input type="hidden" name="voucherId" id="voucherId" value="$!{abPoolEmitFinaApplyVO.voucherId}"/>
    <input type="hidden" name="source" id="source" value="$!{abPoolEmitFinaApplyVO.source}"/>
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="17%">#springMessage('billPool.bail.corp')</td>
            <td style="width: 291px">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPoolCorp"
                         data-tree-type="radio"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="corpId"
                         data-callback="corpCallback"
                         data-required="true"
                         data-resource="abpool:emitfina:apply:resource:op"
                         data-defaultvalue="$!{abPoolEmitFinaApplyVO.corpId}"
                         data-placeholder="#springMessage('billPool.bail.corp')">
                    </div>
                </div>
            </td>
        ##票据池
            <td class="textRight" width="17%">#springMessage('billPool.bail.bp')</td>
            <td style="width: 291px">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPool"
                         data-biz-type="billPool"
                         data-biz-name="bpId"
                         data-name="bpId"
                         data-required="true"
                         data-callback="poolCallback"
                         data-defaultvalue="$!{abPoolEmitFinaApplyVO.bpId}">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
        ##票据类型
            <td class="textRight">#springMessage('bill.accebill.billType')</td>
            <td>
                #springMessage('billPool.emitFinaApply.billType_10')
            </td>
        ##票据介质
            <td class="textRight">#springMessage('billPool.emitFinaApply.billFlag')</td>
            <td>
                #springMessage('table.abVoucherinfo.billFlag_11')
            </td>
        </tr>
        <tr>
        ##申请人账号
            <td class="textRight">#springMessage('billPool.emitFinaApply.applyAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="payeracc" name="payeracc" data-name="payeracc" data-biz-name="payeracc"
                        #if($!{externalCorpNum} eq '1' ) readonly="readonly" #end data-resource="abpool:emitfina:apply:resource:op" lay-verify="required" isOnline="1"
                        #if($!{abPoolEmitFinaApplyVO.corpId}) data-defaultcorp = "$!{abPoolEmitFinaApplyVO.corpId}" #else data-defaultcorp = "xx" #end electricBill="1"
                           class="bank layui-input bt-biz-accountTable" data-callback="accountPayeeCallBack" data-biz-name="payeracc" value="$!{abPoolEmitFinaApplyVO.payeracc}">
                </div>
            </td>
        ##票据金额
            <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
            <td>
                <input type="text" data-name="billMoney" lay-verify="required" class="layui-input bt-biz-moneyType" value="$!{abPoolEmitFinaApplyVO.billMoney}"
                       placeholder="#springMessage('table.abVoucherinfo.billMoney')" data-biz-name="test" id="billMoney" data-min="0.01">
            </td>
        </tr>
        ##是否转让
        <tr>
            <td class="textRight">#springMessage('table.abVoucherinfo.banendrsmtmk')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="AB_BANEM" data-name="banendrsmtmk"
                     data-placeholder="" data-defaultvalue="$!{abPoolEmitFinaApplyVO.banendrsmtmk}"></div>
            </td>
        ##融资用途
            <td class="textRight">#springMessage('billPool.emitFinaApply.purposes')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="abs" name="abs" data-name="abs" class="layui-input" lay-verify="required|strlength"
                           data-maxlength="100"  placeholder="#springMessage('billPool.emitFinaApply.purposes')" value="$!{abPoolEmitFinaApplyVO.abs}">
                </div>
            </td>
        </tr>
        <tr>
        ##出票日期
            <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
            <td >
                <input type="text" name="startDate" data-name="startDate" class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date"
                       lay-verify="required" data-biz-name="startDate" value="$!{abPoolEmitFinaApplyVO.startDate}">
            </td>
        ##到期日期
            <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
            <td >
                <input type="text" name="endDate" data-name="endDate" class="layui-input bt-biz-dateType" id="endDate" data-type="date"
                       lay-verify="required" data-biz-name="endDate"  value="$!{abPoolEmitFinaApplyVO.endDate}">
            </td>

        </tr>
        <tr>
        ##收票人账号
            <td class="textRight">
                <div class="layui-input-inline" id="pledgeeAccSpanDiv">
                    <span style="color:red;font-size: 14px;font-weight:bold;vertical-align: middle;">*</span>
                </div>
                #springMessage('table.abVoucherinfo.payeeacc')
            </td>
            <td>
                <div class="layui-input-inline" id="pledgeeAccDiv">
                ##收票人账号--客商
                    <input type="text" id="payeeacc" name="payeeacc" lay-verify="required|strlength" data-maxlength="30"
                        #if($!{externalCorpNum} eq '1' ) readonly="readonly" #end value="$!{abPoolEmitFinaApplyVO.payeeacc}"
                           autocomplete="off" class="bank layui-input" placeholder="#springMessage('table.abVoucherinfo.payeeacc')">
                    <div class="bt-div-search" id="pledgeeNameDiv">
                        <button class="bt-biz-externalCorpBankAcc" type="button" data-callback="bt.payeeCorpCallback"
                                data-beforeClick="bt.externalCorpBankAccParams">
                            <i class="layui-icon">&#xe615;</i></button>
                    </div>
                </div>
            </td>
        ##收票人全称
            <td class="textRight">#springMessage('table.abVoucherinfo.payee')</td>
            <td>
            ##收票人全称--客商
                <div class="layui-input-inline" id="payeeAccNameDiv">
                    <input type="text" id="payeeAccName" name="payee" #if($!{externalCorpNum} eq '1' ) readonly="readonly" #end lay-verify="required|strlength" data-maxlength="240"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payee')" value="$!{abPoolEmitFinaApplyVO.payee}" >
                </div>
            </td>
        </tr>
        <tr>
        ##收票人开户银行名称
            <td class="textRight">#springMessage('table.abVoucherinfo.payeeBankName')</td>
            <td >
                <input type="text" id="payeeBankName" name="payeeBankName" lay-verify="required|strlength" data-maxlength="240"
                    #if($!{externalCorpNum} eq '1' ) readonly="readonly" #end value="$!{abPoolEmitFinaApplyVO.payeeBankName}"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payeeBankName')">
            </td>
        ##收票人开户银行行号
            <td class="textRight">#springMessage('table.abVoucherinfo.payeebankno')</td>
            <td >
                <input type="text" id="payeebankno" name="payeebankno" lay-verify="required|strlength" data-maxlength="30"
                    #if($!{externalCorpNum} eq '1' ) readonly="readonly" #end value="$!{abPoolEmitFinaApplyVO.payeebankno}"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payeebankno')">
            </td>
        </tr>
        <tr>
        ##承兑人账号
            <td class="textRight"><span id="spanAcc" style="color:red;font-size: 14px;font-weight:bold;vertical-align: middle;">*</span>#springMessage('table.abVoucherinfo.acceptoracc')</td>
            <td>
                <div class="layui-input-inline"  >
                    <input type="text" id="acceptoracc" name="acceptoracc" value="$!{abPoolEmitFinaApplyVO.acceptoracc}" lay-verify="required" data-maxlength="30"
                           autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.abVoucherinfo.acceptoracc')">
                    <div class="bt-div-search" >
                        <button class="bt-biz-externalCorpBankAcc" type="button" data-callback="bt.bailCorpCallback"><i class="layui-icon">&#xe615;</i></button>
                    </div>
                </div>
            </td>
        ##承兑人
            <td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="acceptor" name="acceptor" lay-verify="required|strlength" data-maxlength="240" value="$!{abPoolEmitFinaApplyVO.acceptor}"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptor')">
                </div>
            </td>
        </tr>
        <tr>
        ##承兑人开户行行号
            <td class="textRight"><span id="spanBankNo" style="color:red;font-size: 14px;font-weight:bold;vertical-align: middle">*</span>#springMessage('table.abVoucherinfo.acceptorbankno')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="acceptorbankno" name="acceptorbankno"  readonly="true" lay-verify="required|strlength" data-maxlength="12"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptorbankno')" value="$!{abPoolEmitFinaApplyVO.acceptorbankno}">
                    <div class="bt-div-search"  >
                        <button class="bt-biz-bankInfo" type="button" data-callback="bt.bankinfoCallback"><i class="layui-icon">&#xe615;</i></button>
                    </div>
                </div>
            </td>
        ##承兑人开户行名称
            <td class="textRight">#springMessage('table.abVoucherinfo.acceptorBankName')</td>
            <td >
                <input type="text" id="acceptorBankName" name="acceptorBankName" lay-verify="required|strlength" data-maxlength="240" value="$!{abPoolEmitFinaApplyVO.acceptorBankName}"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptorBankName')">
            </td>
        </tr>
        </tbody>
    </table>
    #if($!{abPoolEmitFinaApplyVO.source} == 10)
        <div class="layui-form-item layui-form-text margin-top">
            <label class="layui-form-label">#springMessage('table.approve.repulse')</label>
            <div class="layui-input-block" style="width: 600px;">
            <textarea id="reason" name="reason" placeholder="#springMessage('table.fcFreeze.refuseWhy')"
                      class="layui-textarea" lay-verify="strlength" data-maxlength="150" ></textarea>
            </div>
        </div>
    #end
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" type="button" lay-filter="save">#springMessage('common.button.save')</button>
            <button class="layui-btn" lay-submit="" type="button" lay-filter="submit">#springMessage('common.button.submit')</button>
            #if($!{abPoolEmitFinaApplyVO.source} == 10)
                <button class="layui-btn layui-btn-normal" onclick="repulse()" type="button">#springMessage('common.button.repulse')</button>
            #end
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolEmitFinaApply.add.js?_btv=${resourceVersion}"></script>
</html>

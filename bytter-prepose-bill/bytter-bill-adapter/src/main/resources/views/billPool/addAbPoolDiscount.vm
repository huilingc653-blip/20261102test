<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="get">
    <input type="hidden" id="ids" name="ids" value="$!{abPoolDiscountVO.id}" />
    <h2 class="layui-colla-title">#springMessage('billPool.discount.detail')</h2>
    <table class="layui-table" >
        <tbody>
        <tr>
            ##票据张数
            <td class="textRight" width="15%">#springMessage('billPool.billNumber')</td>
            <td width="35%" >
                $!{abPoolDiscountVO.length}
            </td>
            ##合计金额
            <td class="textRight" width="15%">#springMessage('billPool.totalMoney')</td>
            <td width="35%" >
                $number.formatNumeric($!{abPoolDiscountVO.billMoney})
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="submit">#springMessage('common.button.save')</button>
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolDiscount.add.js?_btv=${resourceVersion}"></script>
</html>
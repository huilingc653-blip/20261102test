<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form input150-container" method="post">
    <input id="ids" name="ids" type="hidden" value="$!{ids}">
     <input id="billFlag"  name="billFlag" type="hidden" value="$!{billFlag}">
<div class="layui-form-item">
<table class="layui-table">
<tbody>
<tr>
	##票据张数
    <td class="textRight" width="25%">#springMessage('billPool.intoApple.sum')</td>
    <td   width="25%">
        $!{abCount}
    </td>
    ##合计金额
    <td class="textRight" width="20%">#springMessage('billPool.intoApple.sumMoney')</td>
    <td  width="30%">
       $number.formatNumeric($!{abBillMoney})
    </td>
</tr>
        </tbody>
        </table>
        </div>

        <div class="layui-form-submit-adaptive">
            <div style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="retreat">#springMessage('common.button.save')</button>
                <button class="layui-btn layui-btn-primary" type="button" name="revert">#springMessage('common.button.revert')</button>
            </div>
        </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolTst.add.js?_btv=${resourceVersion}"></script>
</html>
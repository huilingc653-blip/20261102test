<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
	<input type="hidden" name="eqs_briefId" value="8001" />
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="13%">#springMessage('billPool.bail.corp')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPoolCorp"
                         data-tree-type="check"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="abpool:query:financing:op"
                         data-placeholder="#springMessage('billPool.bail.corp')">
                    </div>
                </div>
            </td>
        ##票据池
            <td class="textRight" width="11%">#springMessage('billPool.bail.bp')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPool"
                         data-biz-type="billPool"
                         data-biz-name="billPool"
                         data-name="eqs_poolNo"
                         data-placeholder="#springMessage('billPool.bail.bp')">
                    </div>
                </div>
            </td>

            ##票据类型
            <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE" data-name="eqs_billTypeName" data-displayData="10"  ></div>
            </td>
         </tr>

         <tr>
            ##起始日期
            <td class="textRight">#springMessage('billPool.finaApply.stDate')</td>
            <td >
                <div class="layui-inline">
                <input type="text" name="ged_startDate" data-name="ged_startDate" class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date">
                </div>
                ~
                <div class="layui-inline">
                <input type="text" name="led_startDate"　data-name="led_startDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date">
                </div>
			</td>
            ##截止日期
            <td class="textRight">#springMessage('billPool.finaApply.endDate')</td>
            <td >
                <div class="layui-inline">
                <input type="text" name="ged_endDate" data-name="ged_endDate" class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                </div>
                ~
                <div class="layui-inline">
                <input type="text" name="led_endDate"　data-name="led_endDate" class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                </div>
			</td>
            <td class="textRight"></td>
            <td width="25%">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
    ##单位
        <th>#springMessage('billPool.bail.corp')</th>
    ##融资金额
        <th>#springMessage('billPool.finaApply.financeAmt')</th>
    ##申请日期
        <th>#springMessage('billPool.finaApply.applyDate')</th>
    ##起始日期
        <th>#springMessage('billPool.finaApply.stDate')</th>
    ##到期日期
        <th>#springMessage('billPool.finaApply.endDateStr')</th>
    ##申请状态
        <th>#springMessage('billPool.finaApply.applyStatus')</th>
    ##业务品种
        <th>#springMessage('billPool.finaApply.bizName')</th>
    ##业务类型
        <th>#springMessage('billPool.finaApply.businessType')</th>
    ##商票交易类型
        <th>#springMessage('billPool.finaApply.type')</th>
    ##票据类型
        <th>#springMessage('bill.accebill.billType')</th>
    ##票据池
        <th>#springMessage('billPool.bail.bp')</th>
    ##同步日期
        <th>#springMessage('billPool.bank.syn.date')</th>
    ##操作
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolBillFinaApplyBook.list.js?_btv=${resourceVersion}"></script>
</html>

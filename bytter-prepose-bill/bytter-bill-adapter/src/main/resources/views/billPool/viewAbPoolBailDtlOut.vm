<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
<div>
    <h2 class="layui-colla-title">#springMessage('billPool.bail.extractInfo')</h2>
    <table class="layui-table layui-form" width="100%">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="15%">#springMessage('billPool.bail.corp')</td>
            <td width="35%">
                $!{abPoolBailDtlVO.corpCodeAndName}
            </td>
        ##票据池
            <td class="textRight" width="15%">#springMessage('billPool.bail.bp')</td>
            <td width="35%">
                $!{abPoolBailDtlVO.pbCodeAndName}
            </td>
        </tr>
        <tr>
        ##保证金账户
            <td class="textRight" width="15%">#springMessage('billPool.bail.bankAcc')</td>
            <td width="35%">
                $!{abPoolBailDtlVO.bankAcc}
            </td>
        ##保证金余额
            <td class="textRight" width="15%">#springMessage('billPool.bail.balance')</td>
            <td width="35%">
                $!number.formatNumeric($!{abPoolBailDtlVO.bailMoney})
            </td>
        </tr>
        <tr>
        ##保证金日期
            <td class="textRight" width="15%">#springMessage('billPool.bail.bailDate')</td>
            <td width="35%">
                $!date.format('yyyy-MM-dd',$!{abPoolBailDtlVO.bailDate})
            </td>
        ##提取金额
            <td class="textRight" width="15%">#springMessage('billPool.bail.extractAmount')</td>
            <td width="35%">
                $!number.formatNumeric($!{abPoolBailDtlVO.money})
            </td>
        </tr>
        <tr>
        ##转入账号
            <td class="textRight" width="15%">#springMessage('billPool.bail.oppInAcc')</td>
            <td width="35%">
                $!{abPoolBailDtlVO.oppAcc}
            </td>
        ##转入账户名称
            <td class="textRight" width="15%">#springMessage('billPool.bail.oppInAccName')</td>
            <td width="35%">
                $!{abPoolBailDtlVO.oppAccName}
            </td>
        </tr>
        <tr>
        ##转入账户行号
            <td class="textRight" width="15%">#springMessage('billPool.bail.oppInBankNo')</td>
            <td width="35%">
                $!{abPoolBailDtlVO.oppBankNo}
            </td>
        ##转入账户行名
            <td class="textRight" width="15%">#springMessage('billPool.bail.oppInBankName')</td>
            <td width="35%">
                $!{abPoolBailDtlVO.oppBankName}
            </td>
        </tr>
        <tr>
        ##申请日期
            <td class="textRight" width="15%">#springMessage('billPool.bail.appDate')</td>
            <td width="35%">
                $!date.format('yyyy-MM-dd',$!{abPoolBailDtlVO.appDate})
            </td>
            #if(!$isApprove)
        ##审批状态
            <td class="textRight" width="15%">#springMessage('billPool.bail.status')</td>
            <td width="35%">
                $!{abPoolBailDtlVO.statusName}
            </td>
        </tr>
        <tr>
        ##指令状态
            <td class="textRight" width="15%">#springMessage('billPool.bail.optStatus')</td>
            <td width="35%">
                $!{abPoolBailDtlVO.optStatusName}
            </td>
        ##银行返回信息
            <td class="textRight" width="15%">#springMessage('billPool.bail.returnMsg')</td>
            <td width="35%">
                $!{abPoolBailDtlVO.returnMsg}
            </td>
        #else
            <td class="textRight" width="15%"></td>
            <td width="35%">
            </td>
        #end
        </tr>
        </tbody>
    </table>

    #if(!$isApprove)
        <br>
        <br>
        <h2 class="layui-colla-title">#springMessage('bill.logInfo.title')</h2>
        <table class="layui-table layui-form" style="width: 100%;">
            <thead>
            <tr>
                <th>#springMessage('table.abLog.createDate')</th>
                <th>#springMessage('table.abLog.createBy')</th>
                <th>#springMessage('table.abLog.createName')</th>
                <th>#springMessage('table.abLog.logType')</th>
                <th>#springMessage('table.abLog.msg')</th>
            </tr>
            </thead>
            <body>
                #if($!abLogList)
                    #foreach($logInfo in $abLogList)
                    <tr>
                        <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.createDate})</td>
                        <td>$!{logInfo.createBy}</td>
                        <td>$!{logInfo.createName}</td>
                        <td>$!{logInfo.logTypeName}</td>
                        <td>#springMessage($!{logInfo.msg})</td>
                    </tr>
                    #end
                #end
            </body>
        </table>
    #end
    <br />
    <br />
</div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
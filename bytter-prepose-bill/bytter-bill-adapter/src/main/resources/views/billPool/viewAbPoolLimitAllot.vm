<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div>
    <h2 class="layui-colla-title">#springMessage('billPool.LimitAllot')</h2>
	<table class="layui-table"  class="layui-form input150-container">
        <tbody>
        <tr>
        ##票据池单位
            <td class="textRight" width="17%">#springMessage('billPool.corp.name')</td>
            <td width="33%">
                ($!{abPoolLimitAllotVO.corpCode})$!{abPoolLimitAllotVO.corpName}
            </td>
        ##票据池
            <td class="textRight" width="17%">#springMessage('billPool.Limit.bpName')</td>
            <td width="33%">
                $!{abPoolLimitAllotVO.bpName}
            </td>
        </tr>
        <tr>
            ##分配额度
            <td class="textRight"  width="17%">#springMessage('billPool.Limit.applyMoney')</td>
            <td width="33%">
                #if($!{abPoolLimitAllotVO.applyMoney})
                    $number.formatNumeric($!{abPoolLimitAllotVO.applyMoney})
                #end
            </td>
            ##分配日期
            <td class="textRight"  width="17%">#springMessage('billPool.Limit.createTime')</td>
            <td width="33%">
                $!date.format('yyyy-MM-dd',$!{abPoolLimitAllotVO.createTime})
            </td>
        </tr>
        <tr>
        ##票据池额度
            <td class="textRight"  width="17%">#springMessage('billPool.Limit.poolMoney')</td>
            <td width="33%">
             #if($!{abPoolLimitAllotVO.poolMoney})
               $number.formatNumeric($!{abPoolLimitAllotVO.poolMoney})
             #end
            </td>
        ##可用额度
            <td class="textRight"  width="17%">#springMessage('billPool.Limit.validMoney')</td>
            <td width="33%">
                #if($!{abPoolLimitAllotVO.validMoney})
                    $number.formatNumeric($!{abPoolLimitAllotVO.validMoney})
                #end
            </td>
        </tr>
        <tr>
        ##已用额度
            <td class="textRight"  width="17%">#springMessage('billPool.Limit.lockMoney')</td>
            <td width="33%">
                #if($!{abPoolLimitAllotVO.lockMoney})
                    $number.formatNumeric($!{abPoolLimitAllotVO.lockMoney})
                #end
            </td>
            <td class="textRight"  width="17%">#springMessage('billPool.Limit.finalMoney')</td>
            <td width="33%">
                #if($!{abPoolLimitAllotVO.poolMoney})
                    #set($finalMoney=$abPoolLimitAllotVO.poolMoney + $abPoolLimitAllotVO.applyMoney)
                    $number.formatNumeric($!{finalMoney})
                #end</td>
        </tr>
        <tr>
        ##业务类型
            <td class="textRight"  width="17%">#springMessage('billPool.busType')</td>
            <td width="33%">
                $!{abPoolLimitAllotVO.busTypeName}
            </td>
        ##额度种类
            <td class="textRight"  width="17%">#springMessage('billPool.Limit.limtType')</td>
            <td width="33%">
                $!{abPoolLimitAllotVO.limtTypeName}
            </td>
        </tr>
        <tr>
        ##上级单位
            <td class="textRight"  width="17%">#springMessage('billPool.Limit.parentName')</td>
            <td width="33%">
                $!{abPoolLimitAllotVO.parentName}
            </td>
        ##层级
            <td class="textRight"  width="17%">#springMessage('billPool.Limit.bustypeLevel')</td>
            <td width="33%">
                $!{abPoolLimitAllotVO.bustypeLevel}
            </td>
        </tr>
        #if(!$isApprove)
            <tr>
            ##审批状态
                <td class="textRight"  width="17%">#springMessage('billPool.status')</td>
                <td width="33%">
                    $!{abPoolLimitAllotVO.statusName}
                </td>
            ##指令状态
                <td class="textRight"  width="17%">#springMessage('billPool.optStatus')</td>
                <td width="33%">
                    $!{abPoolLimitAllotVO.optStatusName}
                </td>
            </tr>
            <tr>
                ##银行返回原因
                <td class="textRight"  width="17%">#springMessage('billPool.bail.returnMsg')</td>
                <td width="33%" colspan="3">
                    $!{abPoolLimitAllotVO.returnMsg}
                </td>
            </tr>
        #end
        <tr>
            ##备注
            <td class="textRight"  width="17%">#springMessage('billPool.Limit.rmk')</td>
            <td width="33%" colspan="3">
                $!{abPoolLimitAllotVO.rmk}
            </td>
        </tr>
        </tbody>
    </table>
    #if(!$isApprove)
        <br>
        <br>
        <h2 class="layui-colla-title">#springMessage('bill.logInfo.title')</h2>
        <table class="layui-table layui-form" style="width: 100%;">
            <thead>
            <tr>
                <th>#springMessage('table.abLog.createDate')</th>
                <th>#springMessage('table.abLog.createBy')</th>
                <th>#springMessage('table.abLog.createName')</th>
                <th>#springMessage('table.abLog.logType')</th>
                <th>#springMessage('table.abLog.msg')</th>
            </tr>
            </thead>
            <body>
                #if($!abLogList)
                    #foreach($logInfo in $abLogList)
                    <tr>
                        <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.createDate})</td>
                        <td>$!{logInfo.createBy}</td>
                        <td>$!{logInfo.createName}</td>
                        <td>$!{logInfo.logTypeName}</td>
                        <td>#springMessage($!{logInfo.msg})</td>
                    </tr>
                    #end
                #end
            </body>
        </table>
    #end
<br />
<br /> 
<div class="layui-form-item layui-form-submit" id="buttonDiv">
	<div class="layui-input-block">
	<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{abPoolLimitAllotVO.id}')">#springMessage('common.button.trackFlow')</button>
	<button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
</div>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <div>
##        <h2 class="layui-colla-title">#springMessage('billPool.bail.saveInfo')</h2>
        <table class="layui-table layui-form" width="100%">
            <tbody>
            <tr>
            ##单位
                <td class="textRight" width="15%">#springMessage('billPool.bail.corp')</td>
                <td width="35%">
                    $!{abPoolBailBookVO.corpCodeAndName}
                </td>
            ##票据池
                <td class="textRight" width="15%">#springMessage('billPool.bail.bp')</td>
                <td width="35%">
                    $!{abPoolBailBookVO.pbCodeAndName}
                </td>
            </tr>
            <tr>
            ##保证金账户
                <td class="textRight" width="15%">#springMessage('billPool.bail.bankAcc')</td>
                <td width="35%">
                    $!{abPoolBailBookVO.bailAcc}
                </td>
            ##交易金额
                <td class="textRight" width="15%">#springMessage('billPool.bail.transAmount')</td>
                <td width="35%">
                    $!number.formatNumeric($!{abPoolBailBookVO.money})
                </td>
            </tr>
            <tr>
            ##交易日期
                <td class="textRight" width="15%">#springMessage('billPool.bailBook.transDate')</td>
                <td width="35%">
                    $!date.format('yyyy-MM-dd HH:mm:ss',$!{abPoolBailBookVO.transDate})
                </td>
            ##交易类型
                <td class="textRight" width="15%">#springMessage('billPool.bail.transtype')</td>
                <td width="35%">
                    $dictTag.get("AB_POOL_BAIL_TRANS_TYPE",$!{abPoolBailBookVO.type})
                </td>
            </tr>
            <tr>
            ##对方账号
                <td class="textRight" width="15%">#springMessage('billPool.bail.oppAcc')</td>
                <td width="35%">
                    $!{abPoolBailBookVO.oppAcc}
                </td>
            ##对方账户名称
                <td class="textRight" width="15%">#springMessage('billPool.bail.oppAccName')</td>
                <td width="35%">
                    $!{abPoolBailBookVO.oppAccName}
                </td>
            </tr>
            <tr>
            ##对方账户行号
                <td class="textRight" width="15%">#springMessage('billPool.bailBook.oppBankNo')</td>
                <td width="35%">
                    $!{abPoolBailBookVO.oppBankNo}
                </td>
            ##对方账户行名
                <td class="textRight" width="15%">#springMessage('billPool.bailBook.oppBankName')</td>
                <td width="35%">
                    $!{abPoolBailBookVO.oppBankName}
                </td>
            </tr>
            <tr>
            ##同步日期
                <td class="textRight" width="15%">#springMessage('billPool.bank.syn.date')</td>
                <td width="35%">
                    $!date.format('yyyy-MM-dd HH:mm:ss',$!{abPoolBailBookVO.createTime})
                </td>
                <td class="textRight" width="15%"></td>
                <td width="35%">
                </td>
            </tr>
            </tbody>
        </table>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="12%">#springMessage('billPool.bail.corp')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPoolCorp"
                         data-tree-type="check"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="abpool:collectio:apply:resource:op"
                         data-placeholder="#springMessage('billPool.bail.corp')">
                    </div>
                </div>
            </td>
        ##票据池
            <td class="textRight" width="12%">#springMessage('billPool.bail.bp')</td>
            <td width="22%">
                <div class="layui-input-inline">
                    <div class="bt-biz-billPool"
                         data-biz-type="billPool"
                         data-biz-name="billPool"
                         data-name="eqs_pbCodeAndName"
                         data-placeholder="#springMessage('billPool.bail.bp')">
                    </div>
                </div>
            </td>
        ##票据类型
            <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE" data-name="eqs_billTypeName"></div>
            </td>
        </tr>
        <tr>
        ##流通介质
            <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_FLAG" data-name="eqs_billFlagName"></div>
            </td>
        ##入池方式
            <td class="textRight" width="12%">#springMessage('billPool.collection.inPoolType')</td>
            <td width="22%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="mulselect" data-name="ins_inoutType" placeholder="#springMessage('billPool.collection.inPoolType')"
                         data-group="AB_POOL_INOUT_TYPE">
                    </div>
                </div>
            </td>
        ##票据金额
            <td class="textRight" width="11%">#springMessage('billPool.emitFinaApply.billMoney')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_billMoney" data-moneyendid="endMoney" autocomplete="off"
                           class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_billMoney" id="endMoney" autocomplete="off"
                           class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                </div>
            </td>
        </tr>
        <tr>
        ##票据号
            <td class="textRight" width="11%">#springMessage('billPool.emit.origNo')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_origNo" id="origNo" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('billPool.emit.origNo')">
                </div>
            </td>
        ##出票日期
            <td class="textRight" width="10%">#springMessage('table.abVoucherinfo.startDate')</td>
            <td width="23%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_startDate" class="layui-input bt-input-inline bt-biz-dateType" id="dateStart" data-endid="dateEnd"
                           placeholder="#springMessage('table.abVoucherinfo.startDate')" value="$!{dateStart}" >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_startDate" class="layui-input bt-input-inline bt-biz-dateType" id="dateEnd"
                           placeholder="#springMessage('table.abVoucherinfo.startDate')" value="$!{dateEnd}">
                </div>
            </td>
        ##到期日期
            <td class="textRight" width="10%">#springMessage('billPool.limit.apply.enddata')</td>
            <td width="23%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_endDate" class="layui-input bt-input-inline bt-biz-dateType" id="endDateStart" data-endid="endDateEndv"
                           placeholder="#springMessage('billPool.limit.apply.enddata')" >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_endDate" class="layui-input bt-input-inline bt-biz-dateType" id="endDateEnd"
                           placeholder="#springMessage('billPool.limit.apply.enddata')">
                </div>
            </td>
        </tr>
        <tr>
        ##审批状态
            <td class="textRight" width="11%">#springMessage('billPool.bail.status')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="mulselect" data-name="ini_status" placeholder="#springMessage('billPool.bail.status')"
                         data-group="AB_POOL_STATUS">
                    </div>
                </div>
            </td>
        ##指令状态
            <td class="textRight" width="11%">#springMessage('billPool.bail.optStatus')</td>
            <td width="21%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="mulselect" data-name="ins_optStatus" placeholder="#springMessage('billPool.bail.optStatus')"
                         data-group="AB_POOL_DTL_OPT_STATUS">
                    </div>
                </div>
            </td>
        ##
            <td class="textRight" width="10%"></td>
            <td width="23%">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
    ##单位
        <th>#springMessage('billPool.bail.corp')</th>
    ##票据池
        <th>#springMessage('billPool.bail.bp')</th>
    ##票据号
        <th>#springMessage('billPool.emit.origNo')</th>
    ##票据类型
        <th>#springMessage('bill.accebill.billType')</th>
    ##票据介质
        <th>#springMessage('billPool.emitFinaApply.billFlag')</th>
    ##票据金额
        <th>#springMessage('billPool.emitFinaApply.billMoney')</th>
    ##入池方式
        <th>#springMessage('billPool.collection.inPoolType')</th>
    ##出票日期
        <th>#springMessage('table.abVoucherinfo.startDate')</th>
    ##到期日期
        <th>#springMessage('billPool.limit.apply.enddata')</th>
    ##出票人
        <th>#springMessage('table.abVoucherinfo.payer')</th>
    ##收票人
        <th>#springMessage('table.abVoucherinfo.payee')</th>
    ##承兑人
        <th>#springMessage('billPool.emitFinaApply.acceptor')</th>
    ##审批状态
        <th>#springMessage('billPool.bail.status')</th>
    ##指令状态
        <th>#springMessage('billPool.bail.optStatus')</th>
    ##操作
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/billPool/abPoolCollectionApply.list.js?_btv=${resourceVersion}"></script>
</html>

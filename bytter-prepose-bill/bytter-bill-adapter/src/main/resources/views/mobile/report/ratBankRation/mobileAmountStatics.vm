<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <script>var basePath = "${basePath}"</script>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no,minimum-scale=1.0,maximum-scale=1.0">
    <title>详细明细</title>
    <link rel="stylesheet" href="$!{basePath}/static/mobile/plugins/fixedTable/table.min.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="$!{basePath}/static/plugins/frozen/css/frozenui.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="$!{basePath}/static/css/mobile/index.css?_btv=${resourceVersion}">

    <style>
        html {
            font-size: 26.66667vw;
        }

        body {
            background: #fff;
        }

        .bt-chart-container {
            margin: 0.2rem;
        }

        .popup-block * {
            font-size: 0.14rem;
        }

        .container {
            height: calc(100% - 1rem);
            overflow-y: auto;
        }

        .ui-tab-nav-multi li {
            display: inline;
        }

        input::-webkit-input-placeholder {
            color: #666;
        }

        .sp-tab-list {
            display: inline-block;
            background: url('$!{basePath}/static/images/d-m-e.png');
            height: 0.17rem;
            width: 0.17rem;
        }

        .sp-tab-map {
            display: inline-block;
            background: url('$!{basePath}/static/images/c-m.png');
            height: 0.17rem;
            width: 0.17rem;
        }

        .sp-tab-list.active {
            display: inline-block;
            background: url('$!{basePath}/static/images/d-m.png') !important;
            height: 0.17rem;
            width: 0.17rem;
        }

        .sp-tab-map.active {
            display: inline-block;
            background: url('$!{basePath}/static/images/c-m-e.png');
            height: 0.17rem;
            width: 0.17rem;
        }

        .bt-popup-container {
            position: relative;
            background-color: #fff;
            max-height: calc(100% - 0.5rem);
            overflow-y: auto;
            height: calc(100% - 1.65rem);
        }
        .cms-select-title {
            padding:0.1rem 0.15rem;
        }
        .cms-select-title > div {
            margin-right: 0;
        }
        .bt-card .bt-card-header {
            text-align: left;
            padding-left: 0.15rem;
        }

        .cms-rate-content {
            text-align: right;
            color: #333333;
            font-size: 0.15rem;
        }

        .cms-rate-name {
            color: #999999;
            font-size: 0.15rem;
        }


        .cms-rate-title {
            /*margin-left: 0.13rem;*/
            margin-bottom: 0.13!important;
            font-weight: 600;
            font-size: 0.15rem;
        }

        .cms-rate-container {
            background-color: white;
            margin-bottom: 0.15rem;
            border-radius: 0.1rem;
        }


        .cms-rate-baseinfo {
            padding-bottom: 0.1rem;
            border-bottom: 1px solid #1B1D75;
            border-bottom-color: #EFEFEF;
        }

        .cms-rate-unit {
            color: #999999;
            font-size: 0.1rem;
            margin-right: 0.15rem;
            font-weight: normal;
        }


        .cms-baseinfo {
            display: inline-block;
            background: url('$!{basePath}/static/images/c-m-l-b1.png');
            background-size: 17px 20px;
            height: 0.2rem;
            width: 0.17rem;
            margin-right: 0.05rem;
        }

        .cms-otherinfo {
            display: inline-block;
            background: url('$!{basePath}/static/images/c-m-l-b2.png');
            background-size: 17px 20px;
            height: 0.2rem;
            width: 0.17rem;
            margin-right: 0.05rem;
        }
    </style>
</head>
<body>
<section id="tab" class="ui-container">
    <div>
        <div class="ui-tab ">
            <ul class="ui-tab-content" style="width:100%">
                <li class="bt-show">
                    <div class="ui-searchbar-wrap ui-border-b">
                        <div class="ui-searchbar ui-border-radius" style="margin: 0 0.15rem;">
                            <i class="ui-icon-search"></i>
                            <div class="ui-searchbar-text">请选择单位</div>
                            <div class="ui-searchbar-input">
                                <input id="corpName" value="" type="text" readonly="readonly" placeholder="请选择单位" autocapitalize="off">
                                <input id="corpIds" type="hidden">
                            </div>
                        </div>
                    </div>
                    <div class="ui-btn-wrap bt-select-popup-left cms-select-title">
                        <div class="bt-select-popup">
                            <input type="text" value="银行类别" id="btn1" style="width:0.74rem;" readonly="readonly">
                        </div>
                        <div class="bt-select-popup" style="margin: 0 0.16rem">
                            <input type="text" value="授信模式" id="btn2" readonly="readonly" style="width:0.74rem;">
                        </div>
                        <div class="bt-select-popup">
                            <input type="text" value="更多" id="btn3" readonly="readonly" style="width:0.45rem;">
                        </div>

                        <div class="popup-block">
                            <div class="ui-actionsheet" id="actionsheet1" style="height:calc(100% - 1rem);top:1rem;"
                                 data-link="btn1">
                                <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 1rem;">
                                    <section class="bt-popup-container">
                                        <div class="bt-card" id="bankTypeId">
                                            <div class="bt-card-header">
                                                银行类别
                                                <input type="hidden" name="bankTypeId" value="">
                                            </div>
                                            <div class="bt-card-body">
                                            #foreach($item in $bankList)
                                                #set($vcount = $velocityCount - 1)
                                                #if($!{vcount}%3 == 0)
                                                <div class="ui-row-flex ui-whitespace">
                                                #end
                                                <div class="ui-col ui-col">
                                                    <div class="bt-card-item"
                                                         data-value="$!{item.id}">$!{item.typeName}</div>
                                                </div>
                                                #if($!{foreach.last})
                                                    #if($velocityCount % 3 == 1)
                                                        <div class="ui-col ui-col"></div>
                                                        <div class="ui-col ui-col"></div>
                                                    </div>
                                                    #elseif($velocityCount % 3 == 2)
                                                        <div class="ui-col ui-col"></div>
                                                    </div>
                                                    #end
                                                #else
                                                    #if($velocityCount % 3 == 0)
                                                    </div>
                                                    #end
                                                #end
                                            #end
                                            </div>
                                        </div>
                                    </section>
                                    <div class="bt-popup-bottom">
                                        <button type="button" id="clearValue1" class="bt-popup-reset">重置</button>
                                        <button type="button" class="bt-popup-submit" data-link="btn1" name="submitValue">确定</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="popup-block">
                            <div class="ui-actionsheet" id="actionsheet2" style="height:calc(100% - 1rem);top:1rem;"
                                 data-link="btn2">
                                <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 1rem;">
                                    <section class="bt-popup-container">
                                        <div class="bt-card" id="ratMode">
                                            <div class="bt-card-header">
                                                授信模式
                                                <input type="hidden" name="ratMode" value="">
                                            </div>
                                        <div class="bt-card-body">
                                            #foreach($item in $ratModes)
                                                #set($vcount = $velocityCount - 1)
                                                #if($!{vcount}%3 == 0)
                                                <div class="ui-row-flex ui-whitespace">
                                                #end
                                                <div class="ui-col ui-col">
                                                    <div class="bt-card-item"
                                                         data-value="$!{item.code}">$!{item.name}</div>
                                                </div>
                                                #if($!{foreach.last})
                                                        #if($velocityCount % 3 == 1)
                                                                <div class="ui-col ui-col"></div>
                                                                <div class="ui-col ui-col"></div>
                                                            </div>
                                                            #elseif($velocityCount % 3 == 2)
                                                                <div class="ui-col ui-col"></div>
                                                            </div>
                                                        #end
                                                    #else
                                                        #if($velocityCount % 3 == 0)
                                                            </div>
                                                        #end
                                                #end
                                            #end
                                            </div>
                                        </div>
                                    </section>
                                    <div class="bt-popup-bottom">
                                        <button type="button" id="clearValue2" class="bt-popup-reset">重置</button>
                                        <button type="button" class="bt-popup-submit" data-link="btn2" name="submitValue">确定</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="popup-block">
                            <div class="ui-actionsheet" id="actionsheet3" style="height:calc(100% - 1rem);top:1rem;"
                                 data-link="btn3">
                                <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 1rem;">
                                    <section class="bt-popup-container">
                                        <div class="bt-card" id="date">
                                            <div class="bt-card-header">
                                                授信开始时间
                                            </div>
                                            <div class="bt-card-body">
                                                <div class="ui-row-flex ui-whitespace">
                                                    <div style="width: 30%" class="bt-card-item date" data-begin="" id="beginDate">开始时间</div>
                                                    <div style="width: 30%" class="bt-card-item date" data-end="" id="endDate">结束时间</div>
                                                </div>
                                            </div>
                                            <div class="bt-card-header">
                                                授信结束时间
                                            </div>
                                            <div class="bt-card-body">
                                                <div class="ui-row-flex ui-whitespace">
                                                    <div style="width: 30%" class="bt-card-item date2" data-begin="" id="beginDate2">开始时间</div>
                                                    <div style="width: 30%" class="bt-card-item date2" data-end="" id="endDate2">结束时间</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="bt-card" id="curId">
                                            <div class="bt-card-header">
                                                币种选择
                                                <input type="hidden" name="curId" value="">
                                            </div>
                                            <div class="bt-card-body">
                                                #foreach($cur in $curList)
                                                    #set($vcount = $velocityCount - 1)
                                                    #if($!{vcount}%3 == 0)
                                                    <div class="ui-row-flex ui-whitespace">
                                                    #end
                                                    <div class="ui-col ui-col">
                                                        <div class="bt-card-item"
                                                             data-value="$!{cur.id}">$!{cur.curName}</div>
                                                    </div>
                                                    #if($!{foreach.last})
                                                        #if($velocityCount % 3 == 1)
                                                            <div class="ui-col ui-col"></div>
                                                            <div class="ui-col ui-col"></div>
                                                        </div>
                                                        #elseif($velocityCount % 3 == 2)
                                                            <div class="ui-col ui-col"></div>
                                                        </div>
                                                        #else
                                                        </div>
                                                        #end
                                                    #else
                                                        #if($velocityCount % 3 == 0)
                                                        </div>
                                                        #end
                                                    #end
                                                #end
                                            </div>
                                        </div>
                                    </section>
                                    <div class="bt-popup-bottom">
                                        <button type="button" id="clearValue3" class="bt-popup-reset">重置</button>
                                        <button type="button" class="bt-popup-submit" data-link="btn3" name="submitValue">确定</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </div>
    <div>
        <div id="dtl" style="height: calc(100vh - 1.4rem);background-color: #F5F5F5;padding: 0.15rem;overflow-y: auto">
            #foreach($ratBean in $!{list})
                <div class="viewDtl cms-rate-container" style="padding: 0.1rem"
                     data-curcode="$!{ratBean.curCode}" data-corpid = "$!{ratBean.corpId}" data-ratCode="$!{ratBean.ratCode}" data-bankCode="$!{ratBean.bankCode}" data-beginDate="$!{ratBean.beginDate}" data-endDate="$!{ratBean.endDate}"  data-beginDate="$!{ratBean.beginDate2}" data-endDate="$!{ratBean.endDate2}">
                    <div class="cms-rate-baseinfo">
                        ##                基本信息
                        <div class="ui-row-flex cms-rate-title">
                            <div class="cms-baseinfo"></div>
                            <div class="ui-col ui-col">基本信息</div>
                        </div>

                        <div class="ui-row-flex">
                            <div class="ui-col cms-rate-name">授信单位</div>
                            <div class="ui-col ui-col-2 cms-rate-content">$!{ratBean.corpName}</div>
                        </div>

                        <div class="ui-row-flex">
                            <div class="ui-col cms-rate-name">授信银行</div>
                            <div class="ui-col ui-col-2 cms-rate-content">$!{ratBean.bankName}</div>
                        </div>

                        <div class="ui-row-flex">
                            <div class="ui-col cms-rate-name">授信模式</div>
                            <div class="ui-col ui-col-2 cms-rate-content">$dictTag.get('RatBkration.RatMode',$!{ratBean.ratMode})</div>
                        </div>

                        <div class="ui-row-flex">
                            <div class="ui-col cms-rate-name">授信有效期</div>
                            <div class="ui-col ui-col-2 cms-rate-content">$!{ratBean.rationDateStr}</div>
                        </div>

                        <div class="ui-row-flex">
                            <div class="ui-col cms-rate-name">币种</div>
                            <div class="ui-col ui-col-2 cms-rate-content">$!{ratBean.curName}</div>
                        </div>
                    </div>
                    <div style="margin-top: 0.1rem">
                        ##                额度信息
                        <div class="ui-row-flex cms-rate-title">
                            <div class="cms-otherinfo"></div>
                            <div class="ui-col ui-col">额度信息</div>
                            <div class="cms-rate-unit">单位：万元</div>
                        </div>
                        <div>
                            <div class="ui-row-flex">
                                <div class="ui-col cms-rate-name">授信额度</div>
                                <div class="ui-col ui-col-2 cms-rate-content">$currencyTag.getCurName($!{ratBean.curId})$!{ratBean.moneyStr}</div>
                            </div>

                            <div class="ui-row-flex">
                                <div class="ui-col cms-rate-name">占用额度</div>
                                <div class="ui-col ui-col-2 cms-rate-content">$currencyTag.getCurName($!{ratBean.curId})$number.formatNumeric($!{ratBean.useMoney})</div>
                            </div>

                            <div class="ui-row-flex">
                                <div class="ui-col cms-rate-name">在审占用额度</div>
                                <div class="ui-col ui-col-2 cms-rate-content">$currencyTag.getCurName($!{ratBean.curId})$number.formatNumeric($!{ratBean.approveMoney})</div>
                            </div>

                            <div class="ui-row-flex">
                                <div class="ui-col cms-rate-name">可用额度</div>
                                <div class="ui-col ui-col-2 cms-rate-content">$currencyTag.getCurName($!{ratBean.curId})$number.formatNumeric($!{ratBean.overPlusMoney})</div>
                            </div>

                            <!--div class="ui-row-flex">
                                <div class="ui-col cms-rate-name">剩余额度</div>
                                <div class="ui-col ui-col-2 cms-rate-content">$currencyTag.getCurName($!{ratBean.curId})$number.formatNumeric($!{ratBean.leftMoney})</div>
                            </div>-->

                        </div>
                    </div>
                </div>
            #end
        </div>
        <div id="bt-loading" class="bt-loading" style="text-align: center">
            <center>
                <img style="width:25px;" src="$!{basePath}/static/mobile/icon/loadinggif.gif">
            </center>
        </div>
    </div>
</section>
<script src="$!{basePath}/static/mobile/plugins/zepto/zepto.min.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/mobile/plugins/f2/f2.min.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/mobile/js/popup.js?_btv=${resourceVersion}" id="tableJS"></script>
<script src="$!{basePath}/static/js/mobile/money.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/modules/mobile/webViewAppScriptBridage.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/modules/mobile/webViewApp.js?_btv=${resourceVersion}"></script>
<!-- 注意：如果你直接复制所有代码到本地，上述js路径需要改成你本地的 -->
<script>

    var seachType = ""
    window.getSeachrMobileBkAmountRation = (data)=>{
        console.log('seachdata'+data)

        seachType = "seach"
        searchActionCallback(data)
    }
    window.getSeachrMobileBkCallback = (data)=>{
        seachType = "seach"
        datePickerCallback(data)
    }
    window.getSeachrMobileBkCallbackEnd = (data)=>{
        seachType = "seach"
        datePickerCallbackeEnd(data)
    }


    window.getMobileBkAmountRation = (data)=>{
        console.log('data'+data)
        refreshData(data)
        seachType = ""
    }
    (function (doc, win) {
        var ACTIVE = 'active';
        initCard('#bankTypeId')
        initCard('#ratMode')
        initCard('#curId')

        $("#clearValue1").click(function () {
            initCard("#bankTypeId", "", "", true);
        });

        $("#clearValue2").click(function () {
            initCard("#ratMode", "", "", true);
        });

        $("#clearValue3").click(function () {
            initCard("#curId", "", "", true);
            $("#beginDate").html("开始时间");
            $("#endDate").html("结束时间");
            $("#beginDate2").html("开始时间");
            $("#endDate2").html("结束时间");
        });


        /**
         * 初始化筛选条件
         * @param id
         * @param value
         * @param clickCallback
         * @param isInit
         */
        function initCard(id, value, clickCallback, isInit) {
            if (!id) {
                return
            }
            var $card = $(id);
            var hiddenInput = $card.find('.bt-card-header input');
            var items = $card.find('.bt-card-item');
            items.removeClass(ACTIVE);
            if (id) {
                hiddenInput.val("");
            }
            //设置选中值
            if (value) {
                for (var i = 0; i < items.length; i++) {
                    if (value === $(items[i]).data('value')) {
                        $(items[i]).addClass(ACTIVE);
                        if ("#bankTypeId" != id) {
                            hiddenInput.val(value);
                        } else {
                            var hiddenValue = hiddenInput.val();
                            if (isNotEmpty(hiddenValue)) {
                                hiddenInput.val(hiddenInput.val() + "," + value);
                            } else {
                                hiddenInput.val(value);
                            }
                        }
                        break;
                    }
                }
            }
            if (isInit) {
                return;
            }
            $(id).on('click', '.bt-card-item', function () {
                var value = '';
                if ($(this).hasClass(ACTIVE)) { //如果当前被选中时，点击会取消选中
                    $(this).removeClass(ACTIVE);
                } else {
                    if ("#bankTypeId" != id) {
                            $card.find('.bt-card-item').removeClass(ACTIVE);
                    }
                    $(this).addClass(ACTIVE);
                    value = $(this).data('value');
                }
                if ("#bankTypeId" != id) {
                    hiddenInput.val(value);
                } else {
                    var hiddenValue = hiddenInput.val();
                    if (isNotEmpty(hiddenValue)) {
                        hiddenInput.val(hiddenInput.val() + "," + value);
                    } else {
                        hiddenInput.val(value);
                    }
                }
                if (clickCallback) {
                    clickCallback(value);
                }
            })
        }

        //搜索框点击
        $('.ui-searchbar').on('click', function () {
            $('.ui-searchbar-wrap').addClass('focus');
            $('.ui-searchbar-input input').focus();
            setTimeout(function(){
               var data = BTAppBridge.openCorpSelectionPage && BTAppBridge.openCorpSelectionPage('searchActionCallback',{resource: "cms:rat:rationQuery:query"});
                uni.postMessage({
                    data:data
                })
               },100);
        });
        $('.ui-searchbar-cancel').on('click', function () {
            $('.ui-searchbar-wrap').removeClass('focus');
        });

        window.searchActionCallback = function (data) {
            // 根据data参数，查询数据
            $("#corpName").val(data.corpNames);
            $("#corpIds").val(data.corpIds);
            // 加载数据
            refreshPage();
        }


        //弹框选择
        function showPopup($this, id) {
            if ( $this.parent().hasClass('active')) {
                hidePopup($this)
                return;
            }
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
            $this.parent().addClass('active');
            $(id).addClass('show');
        }

        //弹框隐藏
        function hidePopup($this) {
            $('.ui-actionsheet').removeClass('show');
            $this.parent().removeClass('active');
        }

        $("#btn1").click(function () {
            showPopup($(this), '#actionsheet1');
        });

        $("#btn2").click(function () {
            showPopup($(this), '#actionsheet2');
        });

        $("#btn3").click(function () {
            showPopup($(this), '#actionsheet3');
        });

        $('.popup-block').on('click', '.bt-popup-item', function () {
            var linkId = $(this).parents('.ui-actionsheet').data('link');
            hidePopup($('#' + linkId));
            $('#' + linkId).val($(this).text())
        })

        //数字格式化
        function numberToMoney(n) {
            return String(Math.floor(n * 100) / 100).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }


        $(".cms-selectItem").on("click", function () {
            // 判断当前是否已经选中
            if ($(this).hasClass("cms-selectedItem")) {
                $(this).removeClass("cms-selectedItem");
                $(this).find(".cms-select-itemFont").removeClass("cms-selected-itemFont");
            } else {
                // 删除其它选中
                var allItem = $($(this).parents(".ui-list-info")[0]);
                var selected = $(allItem).find(".cms-selectedItem");
                if ($(selected).length > 0 && $(selected[0]).hasClass("cms-selectedItem")) {
                    $(selected[0]).removeClass("cms-selectedItem");
                    $(selected[0]).find(".cms-select-itemFont").removeClass("cms-selected-itemFont");
                }
                // 添加当前选中
                $(this).addClass("cms-selectedItem");
                $(this).find(".cms-select-itemFont").addClass("cms-selected-itemFont");
            }
        });


        // 表格行监听
        $("#dtl").on("click", ".viewDtl", function () {
            var params = {};
            params.curCode = $(this).data("curcode");
            params.corpId = $(this).data("corpid");
            params.ratCode = $(this).data("ratcode");
            params.bankCode = $(this).data("bankcode");
            params.beginDate = $(this).data("begindate");
            params.endDate = $(this).data("enddate");
            params.beginDate2 = $(this).data("begindate2");
            params.endDate2 = $(this).data("enddate2");
            params.url = "/mobile/cms/report/ratbkstatistics/viewMobileItemRatio";
           var data = BTAppBridge.jump(params);
            uni.postMessage({
                data:data
            })
        });

        /**
         * 提交查询
         */
        $(".bt-popup-submit").on("click", function () {
            var linkId = $(this).data('link');
            hidePopup($('#' + linkId));
            refreshPage();
        });


        function refreshPage() {
            $("#bt-loading").show();
            setTimeout(function () {
               var data = BTAppBridge.post("/mobile/report/cms/ratbkstatistics/getMobileData", getSubData(), 'refreshData');
               uni.postMessage({
                   data:data
               })
            }, 100);

            /**
             * 刷新数据
             */
            refreshData = function (data) {
                if (data.success) {

#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##担保单位
    <li class="mui-table-view-cell">
        #springMessage('table.guaContract.guaPerson')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.corpName}
        </span>
    </li>
##担保编号
    <li class="mui-table-view-cell">
        #springMessage('table.guaContract.guaNo')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.guaNo}
        </span>
    </li>
##币别
    <li class="mui-table-view-cell">
        #springMessage('table.guaContract.curId')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.curName}
        </span>
    </li>
##担保日期
    <li class="mui-table-view-cell" >
        #springMessage('table.guaContractInfo.date')
        <span class="mui-badge-inverted" style="color: #929292;font-size: 14px;float: right;right: 15px;padding: 0 5px 0 0">
            $!date.format('yyyy-MM-dd',$!{vo.startDate})
						<span class="date-mid">#springMessage('table.guaContract.range')</span>
            $!date.format('yyyy-MM-dd',$!{vo.endDate})
        </span>
    </li>
##债务人
    <li class="mui-table-view-cell">
        #springMessage('table.guaContract.debtorPersonName')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.debtorPerson}
        </span>
    </li>
##债权人
    <li class="mui-table-view-cell">
        #springMessage('table.guaContract.creditorPerson')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.creditorPerson}
        </span>
    </li>
##担保方式
    <li class="mui-table-view-cell">
        #springMessage('table.guaContract.guaType')
        <span class="mui-badge mui-badge-inverted">
            $!{guaWayNames}
        </span>
    </li>
##合同编号
    <li class="mui-table-view-cell">
        #springMessage('table.guaContract.contractCode')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.contractCode}
        </span>
    </li>
##担保范围
    <li class="mui-table-view-cell">
        #springMessage('table.guaContract.warr')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.warr}
        </span>
    </li>
##担保额度
    <li class="mui-table-view-divider">#springMessage('table.guaContract.guaMoney')</li>
    <li class="ui-border-t">
        <div class="ui-list-info">
            <ul class="ui-row"
                style="border-width: 1px; text-align: center;">
                <li class="ui-col ui-col-50" style="background: #C4E1FF;"
                    style="border-width: 1px; width: 100%;">
                    <table style="border-collapse: collapse;border-spacing: 0; width: 100%; text-align: center;">
                        <thead>
                        <tr>
                            <th>#springMessage('table.guaContract.guaType')</th>
                            <th>#springMessage('table.guaContract.trackMoney')</th>
                        </tr>
                        </thead>
                        <tbody style="background: #fff;">
                            #foreach($guaWay in $!{guaWayVOList})
                            <tr>
                                <td align="center">
                                    $!{guaWay.guaWayName}
                                </td>
                                <td align="center">
                                    $!number.formatNumeric($!{guaWay.money})
                                </td>
                            </tr>
                            #end
                        </tbody>
                    </table>
                </li>
            </ul>
        </div>
    </li>

##备注
    <li class="mui-table-view-cell">
        #springMessage('table.guaContract.rmk')
        <textarea rows="3" class="layui-textarea" readonly="readonly">$!{vo.rmk}</textarea>
    </li>
    #parse("views/common/wapfooter.vm")
</body>
</html>

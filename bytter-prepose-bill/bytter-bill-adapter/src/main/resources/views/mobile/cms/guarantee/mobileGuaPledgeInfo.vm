#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##抵质押申请单位
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.corpName}
        </span>
    </li>
##抵质押物编号
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.pledgeNo')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.pledgeNo}
        </span>
    </li>
##性质
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.pledgeAttr')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.pledge.TypeAttr",$!{guaPledge.pledgeAttr})
        </span>
    </li>
##抵质押日期
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.date')
        <span class="mui-badge mui-badge-inverted">
			$!{guaPledge.startDate}
				   <span class="date-mid">#springMessage('table.guaPledge.range')</span>
            $!{guaPledge.endDate}
        </span>
    </li>
##抵质押类型
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.pledgeType')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.typeName}
        </span>
    </li>
##抵质押物名称
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.pledgeName')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.pledgeName}
        </span>
    </li>
##评估价值
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.pledgeMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{guaPledge.pledgeMoney})
        </span>
    </li>
##币别
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.curId')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.curName}
        </span>
    </li>
##出质人名称
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.pledge')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.pledge}
        </span>
    </li>
##资产状况
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.assetState')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.assetState}
        </span>
    </li>
##资产状况
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.assetNumber')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.assetNumber}
        </span>
    </li>
##土地面积
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.buildArea')
        <span class="mui-badge mui-badge-inverted">
            #if($!{guaPledge.buildArea})
                $number.formatNumeric($!{guaPledge.buildArea})<span>#springMessage('gua.pledgeAreaUnit')</span>
            #end
        </span>
    </li>
##容积率建筑面积
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.buildAreaRate')
        <span class="mui-badge mui-badge-inverted">
            #if($!{guaPledge.buildAreaRate})
						$number.formatNumeric($!{guaPledge.buildAreaRate})
					#end
        </span>
    </li>
##登记日期
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.regDate')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.regDate}
        </span>
    </li>
##工商登记单号
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.regNumber')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.regNumber}
        </span>
    </li>
##抵质押折旧
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.pledgeDepreciation')
        <span class="mui-badge mui-badge-inverted">
            #if($!{guaPledge.pledgeDepreciation})
						$number.formatNumeric($!{guaPledge.pledgeDepreciation})
					#end
        </span>
    </li>
##抵质押原值
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.pledgeInitMoney')
        <span class="mui-badge mui-badge-inverted">
            #if($!{guaPledge.pledgeInitMoney})
						$number.formatNumeric($!{guaPledge.pledgeInitMoney})
					#end
        </span>
    </li>
##折旧率
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.depreciationRate')
        <span class="mui-badge mui-badge-inverted">
            #if($!{guaPledge.depreciationRate})
						$number.formatNumeric($!{guaPledge.depreciationRate})
					#end
        </span>
    </li>
##评估机构
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.evaluationDep')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.evaluationDep}
        </span>
    </li>
##数量
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.amount')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.amount}
        </span>
    </li>
##规格
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.specification')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.specification}
        </span>
    </li>
##存放地点
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.place')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.place}
        </span>
    </li>
##保管人
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.keeper')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.keeper}
        </span>
    </li>
##调查人
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.investigators')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.investigators}
        </span>
    </li>
##填报单位名称
    <li class="mui-table-view-cell">
        #springMessage('table.guaPledge.regCorp')
        <span class="mui-badge mui-badge-inverted">
            $!{guaPledge.regCorpName}
        </span>
    </li>
    #parse("views/common/wapfooter.vm")
</body>
</html>

#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
    ##保函申请单
    <li class="mui-table-view-divider">#springMessage('table.guaGuarantee.application')</li>
##保函申请人
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.applyPeople')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.corpName}
        </span>
    </li>
##保函类型
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.type')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.Lg.TypeAttr", "$!{lgChangeInfoVo.guaranteeType}")
        </span>
    </li>
##保函编号
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.No')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.guaranteeNo}
        </span>
    </li>
##开立人类型
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.openPeopleType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.Lg.openPeopleType", "$!{lgChangeInfoVo.openCorpType}")
        </span>
    </li>
##开立方式
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.openWay')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.Lg.openWay", "$!{lgChangeInfoVo.openWay}")
        </span>
    </li>
##开立类型
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.openType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.Lg.openType", "$!{lgChangeInfoVo.openType}")
        </span>
    </li>
##保函开立人
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.openPeople')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.openCorpName}
        </span>
    </li>
##保函受益人
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.beneficiary')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.incomeCorp}
        </span>
    </li>
##币别
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.curId')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.curName}
        </span>
    </li>
##保函金额
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.money')
        <span class="mui-badge mui-badge-inverted">
            $number.formatNumeric($!{lgChangeInfoVo.guaranteeMoneyOld})
        </span>
    </li>
##保函性质
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.lgNature')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.Lg.nature", "$!{lgChangeInfoVo.guaranteeAttr}")
        </span>
    </li>
##保函预计结束日期
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.expectEndDate')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.expectEndDateOld}
        </span>
    </li>
##保函开始时间
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.startDate')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.startDate}
        </span>
    </li>
##保函截止时间
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.endDate')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.endDateOld}
        </span>
    </li>
##转开行
    #if($!{LgInfoVo.openWay} == "1")
        <li class="mui-table-view-cell">
            #springMessage('table.guaGuarantee.turnBank')
            <span class="mui-badge mui-badge-inverted">
                $!{LgInfoVo.turnBank}
            </span>
        </li>
    #end
    ##挂接授信开始
        #if($!{rations})
            <li class="mui-table-view-divider">#springMessage('table.guarantee.rationSelect')</li>
            #foreach($ration in $!{rations})
            ##授信额度使用单位
                <li class="mui-table-view-cell">
                    #springMessage('table.ratUrationApply.corpId')
                    <span class="mui-badge mui-badge-inverted">
                        $!{ration.corpName}
                    </span>
                </li>
            ##授信币别
                <li class="mui-table-view-cell">
                    #springMessage('table.ratBkration.curCode')
                    <span class="mui-badge mui-badge-inverted">
                        $!{ration.curName}
                    </span>
                </li>
            ##授信开始日期
                <li class="mui-table-view-cell">
                    #springMessage('table.ratUrationApply.beginDate')
                    <span class="mui-badge mui-badge-inverted">
                        $!date.format('yyyy-MM-dd',$!ration.beginDate)
                    </span>
                </li>
            ##授信结束日期
                <li class="mui-table-view-cell">
                    #springMessage('table.ratUrationApply.endDate')
                    <span class="mui-badge mui-badge-inverted">
                        $!date.format('yyyy-MM-dd',$!ration.endDate)
                    </span>
                </li>
                #foreach($rationDlt in $!{ration.rationDlts})
                ##授信品种
                    <li class="mui-table-view-cell">
                        #springMessage('table.guarantee.ratItemCode')
                        <span class="mui-badge mui-badge-inverted">
                            $!{rationDlt.itemName}
                        </span>
                    </li>
                    #if($!{rationDlt.itemFlag} == "1")
                    ##剩余最高额度
                        #foreach($uratDtl in $!{rationDlt.rationDlts})
                            #set($vcount1 = $velocityCount - 1)
                            <li class="mui-table-view-cell">
                                #springMessage('table.ratBkrationDetail.leftMaxMoney')
                                <span class="mui-badge mui-badge-inverted">
                                    $!number.formatNumeric($!{uratDtl.itemMoney})
                                </span>
                            </li>
                        #end

                    #end
                ##授信额度
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkration.money')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($!{rationDlt.money})
                        </span>
                    </li>
                ##占用额度
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkrationDisDetail.superProcessMoney')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($!{rationDlt.useMoney})
                        </span>
                    </li>
                ##在审占用额度
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkrationDisDetail.checkProcessMoney')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($!{rationDlt.approveMoney})
                        </span>
                    </li>
                ##剩余授信额度
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkrationDisDetail.leftDisMoney')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($!{rationDlt.leftMoney})
                        </span>
                    </li>
                ##可用额度
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkrationDisDetail.overPlusMoney')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($!{rationDlt.overPlusMoney})
                        </span>
                    </li>
                ##授信占用比例
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkrationDisDetail.ratOccupyRatio')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($math.mul($!{rationDlt.ratOccupyRatio},100),"0.00")%
                        </span>
                    </li>
                ##已占用比例
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkrationDisDetail.ratOccupiedRation')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($math.mul($!{ration.ratOccupiedRation},100),"0.00")%
                        </span>
                    </li>
                #end
                </tr>
            #end
        #end
##保函更改信息
    <li class="mui-table-view-divider">#springMessage('table.guaGuarantee.changeMsg')</li>
##保函更改申请日期
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.lgChangedate')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.changeDate}
        </span>
    </li>
    ##保函变更单号
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.lgChangeNo')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.guaraChangeNo}
        </span>
    </li>
    ##保函更改次数
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.lgChangeNum')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.changeCount}
        </span>
    </li>
    ##币别
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.curId')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.curName}
        </span>
    </li>
    ##新截止日期
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.newEndDate')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.endDate}
        </span>
    </li>
    ##新预计结束日期
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.newExpectEndDate')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.expectEndDate}
        </span>
    </li>
    ##保函金额调整类型
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.lgChangeType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.Lg.ChangeType", "$!{lgChangeInfoVo.guaChangeType}")
        </span>
    </li>
    ##保函保证金调整类型
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.bondChangeType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.Lg.ChangeType", "$!{lgChangeInfoVo.bondChangeType}")
        </span>
    </li>
    ##保函调整金额
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.lgChangeMoney')
        <span class="mui-badge mui-badge-inverted">
            #if($!{lgChangeInfoVo.guaChangeMoney})
						$number.formatNumeric($!{lgChangeInfoVo.guaChangeMoney})
			#end
        </span>
    </li>
    ##保证金调整金额
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.bondChangeMoney')
        <span class="mui-badge mui-badge-inverted">
            #if($!{lgChangeInfoVo.bondChangeMoney})
                    $number.formatNumeric($!{lgChangeInfoVo.bondChangeMoney})
            #end
        </span>
    </li>
    ##调整后保函金额
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.moneySum')
        <span class="mui-badge mui-badge-inverted">
            #if($!{lgChangeInfoVo.guaranteeMoney})
				$number.formatNumeric($!{lgChangeInfoVo.guaranteeMoney})
			#end
        </span>
    </li>
    ##调整后保证金
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.bondMoneySum')
        <span class="mui-badge mui-badge-inverted">
            #if($!{lgChangeInfoVo.bondMoney})
				$number.formatNumeric($!{lgChangeInfoVo.bondMoney})
			#end
        </span>
    </li>
    ##调整后保函手续费金额
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.hanleChargeSum')
        <span class="mui-badge mui-badge-inverted">
            #if($!{lgChangeInfoVo.handleCharge})
						$number.formatNumeric($!{lgChangeInfoVo.handleCharge})</td>
            #end
        </span>
    </li>
    ##修改条款
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.changeTerm')
        <span class="mui-badge mui-badge-inverted">
            $!{lgChangeInfoVo.changeTerm}
        </span>
    </li>
    ##修改原因
        <li class="mui-table-view-cell">
            #springMessage('table.guaGuarantee.changeReason')
            <span class="mui-badge mui-badge-inverted">
                $!{lgChangeInfoVo.changeReason}
            </span>
        </li>
    ##经办人
        <li class="mui-table-view-cell">
            #springMessage('table.guaGuarantee.operator')
            <span class="mui-badge mui-badge-inverted">
                $!{lgChangeInfoVo.operator}
            </span>
        </li>
    #parse("views/common/wapfooter.vm")
</body>
</html>

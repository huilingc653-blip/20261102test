<script>
    //用于存储页面查询参数
    const searchParams = {
        corpNames: [],
        datePickData: {
            startDate: null,
            endDate: null,
        }
    };
    var seachType = ""
    var guaWayCode="";
    window.getReportData = (data)=>{
        console.log(data)
        postBalData(data)
    }
    window.getReportDataSeach = (data)=>{
        console.log('seach'+data)
        seachType = 'seach'
        searchActionCallback(data)
    }
    window.getDateActionCallback = (data)=>{
        seachType = 'seach'
        dateActionCallback(data)
        initBal()
    }
    //时间处理方法
    function timestampToTime(timestamp) {
        var date = new Date(timestamp);//时间戳为10位需*1000，时间戳为13位的话不需乘1000
        Y = date.getFullYear() + '-';
        M = (date.getMonth() + 1 < 10 ? '0' + (date.getMonth() + 1) : date.getMonth() + 1) + '-';
        var D = (date.getDate() < 10 ? '0' + date.getDate() : date.getDate());
        return Y + M + D;//时分秒可以根据自己的需求加上
    }
    //担保方式占用轨迹按钮点击事件
    function guaWayTrack(id){
        var url ="/mobile/cms/guarantee/guaContractInfo/mobileGuaTypeTrack";
        setTimeout(function () {
           var data = BTAppBridge.jump({url: url, 'contractId': id});
           uni.postMessage({
               data:data
           })
        },100);
    }

    //担保合同使用情况按钮点击事件
    function guaContractUseList(id){
        var url = "/mobile/cms/guarantee/guaContractOccup/mobileContractUseView";
        setTimeout(function () {
           var data = BTAppBridge.jump({url: url, 'contractId': id});
            uni.postMessage({
                data:data
            })
        },100);
    }
    (function (doc, win) {
        F2.track(false);
        $('.ui-tab-nav > li').on('click', function () {
            $(this).addClass('current').siblings('li').removeClass('current');
            $('.ui-tab-content>li').removeClass('bt-show');
            $('.ui-tab-content li').eq($(this).index()).addClass('bt-show');
        });

        //搜索框点击
        $('#corpDiv>.ui-searchbar').on('click', function () {
            $('.ui-searchbar-wrap').addClass('focus');
            $('.ui-searchbar-input input').focus();
        });
        $('#corpDiv>.ui-searchbar-cancel').on('click', function () {
            $('.ui-searchbar-wrap').removeClass('focus');
        });

        //搜索框
        $('.ui-icon-search').on('click', function () {
            alert("请输入查询条件");
        });


        //弹框选择显示和隐藏
        function showPopup($this, id) {
            if ( $this.parent().hasClass('active')) {
                hidePopup($this);
                return
            }
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
                $this.parent().addClass('active');
            $(id).addClass('show');
        }


        //单位选择
        $("#corpDiv").click(function () {
            openCorpSelectionPage();
        });


        //弹框隐藏
        function hidePopup($this) {
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
                $this.parent().removeClass('active');
        }


        //单位搜索组件
        function openCorpSelectionPage() {
            setTimeout(function(){
               var data = BTAppBridge.openCorpSelectionPage && BTAppBridge.openCorpSelectionPage('searchActionCallback',{
                    resource:'gua:contract:info:query'
                });
                uni.postMessage({
                    data: data
                });
            },100);
        }

        // //担保编号点击事件
        $('#inputSerach1>.ui-searchbar').on('click', function () {
            $('#inputSerach1').addClass('focus');
            $('#inputSerach1 >.ui-searchbar-input input').focus();
        });
        $('#inputSerach1 >.ui-searchbar-cancel').on('click', function () {
            $('#inputSerach1').removeClass('focus');
        });
        // //合同编号点击事件
        $('#inputSerach2>.ui-searchbar').on('click', function () {
            $('#inputSerach2').addClass('focus');
            $('#inputSerach2 >.ui-searchbar-input input').focus();
        });
        $('#inputSerach2 >.ui-searchbar-cancel').on('click', function () {
            $('#inputSerach2').removeClass('focus');
        });

        /**
         * 搜索回调方法
         * @param data
         */
        window.searchActionCallback = function (data) {
            // 根据data参数，查询数据
            if (data.corpNames && data.corpNames.length > 0) {
                /* let msg = "选择的成员单位名称：" + JSON.stringify(data.corpNames);
                 msg = msg + ", 成员单位ID：" + JSON.stringify(data.corpIds)*/
                searchParams.corpNames = data.corpNames;
                $("#corpId").val(data.corpNames);
            }else{
                $("#corpId").val('');
            }
            if (data.corpIds) {
                $("#corpIds").val(data.corpIds);
            }
            initBal();
        }



        //初始化列表数据
        function initBal() {
            if(seachType && seachType != 'seach'){
                return
            }
            var params={
                corpIds:$("#corpIds").val(),
                guaWayCode:$("#guaWayCode").val(),
                guaNo:$("#guaNo").val(),
                contractCode:$("#contractCode").val(),
                startDate:searchParams.datePickData.startDate,
                endDate:searchParams.datePickData.endDate
            };
            //通过Ajax获取数据
            var url = "/mobile/cms/guarantee/guaContractInfo/appReportData";
            setTimeout(function () {
              var data = BTAppBridge.post(url,params,'postBalData');
                uni.postMessage({
                    data: data
                });
            },100);
            // $.ajax({
            //     type:"post",
            //     url:url,
            //     async:true,
            //     data:params,
            //     dataType:"json",
            //     success:function(res){
            //         setBalDataDiv(res);
            //     },
            //     error:function(jqXHQ){
            //         alert("发生错误:"+jqXHQ.status);
            //     }
            // });
            postBalData = function (result) {
                //var data = JSON.parse(result.series);
                setBalDataDiv(result);
            }
        }


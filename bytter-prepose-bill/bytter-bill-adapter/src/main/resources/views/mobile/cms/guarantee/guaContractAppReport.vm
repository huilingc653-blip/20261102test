                balDivHtml +='<div class="ui-gua-info-title"><h4>开始日期</h4>';
                balDivHtml +='<p class="ui-gua-info-content">'+data[i].startDate+'</p></div>';
                balDivHtml +='</li>';
                balDivHtml +='<li>';
                balDivHtml +='<div class="ui-gua-info-title"><h4>结束日期</h4>';
                balDivHtml +='<p class="ui-gua-info-content">'+data[i].endDate+'</p></div>';
                balDivHtml +='</li>';
                balDivHtml +='</ul>';
                balDivHtml +='</div>';
                balDivHtml +='<div class="gua-btn-container">';

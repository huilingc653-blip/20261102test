            setBalChartDiv(result);
        }


        //金额格式化
        function moneyFormat(val){
            if(val=='' || val==null){
                return 0.00;
            }
            //金额转换 元 保留2位小数 并每隔3位用逗号分开 1,234.56
            var str = val.toFixed(2) + '';
            var intSum = str.substring(0,str.indexOf(".")).replace( /\B(?=(?:\d{3})+$)/g, ',' );//取到整数部分
            var dot = str.substring(str.length,str.indexOf("."))//取到小数部分搜索
            var ret = intSum + dot;
            return ret;
        }


        //弹框选择
        function showPopup($this, id) {
            if ( $this.parent().hasClass('active')) {
                $('.ui-actionsheet').removeClass('show');
                $('.bt-select-popup').removeClass('active');
                return
            }
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
                $this.parent().addClass('active');
            $(id).addClass('show');
        }

        $("#btn1").click(function () {
            showPopup($(this), '#actionsheet1');
        });

        //更多弹出框重置
        $("#curBtRest").click(function () {
            $('#guaWayCode').val('');
            $('#guaNo').val('');
            $('#contractCode').val('');
            $("#startDateBegin").val('');
            $("#startDateEnd").val('');
            searchParams.datePickData.startDate = null;
            searchParams.datePickData.endDate = null;
            $('.bt-card-item').removeClass('active');
        });

        //更多弹出框提交
        $("#curBtSubmit").click(function () {
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
            initBal();
        });

        //担保编号查询
        $("#guaNo").on('blur',function () {
            initBal();
        })

        //合同编号查询
        $("#contractCode").on('blur',function () {
            initBal();
        })
        //选中某个担保方式
        $('.bt-card-item').on('click',function(){
            if ($(this).hasClass('active')) { //如果当前被选中时，点击会取消选中
                $(this).removeClass('active');
                var thisGuaWay=$(this).data('value');
                guaWayCode=guaWayCode.replace(thisGuaWay+",","");
            } else {
                $(this).addClass('active');
                guaWayCode+=$(this).data('value')+",";
            }
            $('#guaWayCode').val(guaWayCode);
            return false;
        });


        //日期选择
        window.dateActionCallback = function (data) {
            if (data.datePickData){
                var dateObj = data.datePickData;
                var startDate = dateObj.startDate;
                var endDate = dateObj.endDate;
                var startTemp = timestampToTime(parseInt(startDate));
                var endTemp = timestampToTime(parseInt(endDate));
                $("#startDateBegin").val(startTemp);
                $("#startDateEnd").val(endTemp);
                searchParams.datePickData.startDate=startTemp;
                searchParams.datePickData.endDate=endTemp;
            }
        }

        $(".startDateDIV").click(function () {
            openDatePickerPage();
        });

        function openDatePickerPage() {
           var data = BTAppBridge.openDatePickerPage && BTAppBridge.openDatePickerPage('dateActionCallback');
           uni.postMessage({
               data:data
           })
        }

        initBal();//初始化数据
    })(document, window);
</script>
</html>

                balDivHtml +='</li>';
                balDivHtml +='</ul>';
                balDivHtml +=' </div>';
                balDivHtml +='</div>';
                balDivHtml +='<div class="ui-grid ui-grid-trisect">';
                balDivHtml +='<ul class="ui-border-b">';
                balDivHtml +='<li>';
                balDivHtml +='<div class="ui-gua-info-title"><h4>担保方式</h4>';
                balDivHtml +='<p class="ui-gua-info-content">'+data[i].guaTypeName+'</p></div>';
                balDivHtml +='</li>';

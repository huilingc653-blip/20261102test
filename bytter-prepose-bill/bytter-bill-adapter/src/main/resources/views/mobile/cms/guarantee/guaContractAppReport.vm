                balDivHtml +='<div class="cho-content-item-money-left">'+moneyFormat(data[i].guaMoney)+'</div>';
                balDivHtml +='<div class="cho-content-item-font-left">担保额度('+data[i].curName+')</div>';
                balDivHtml +=' <div class="ui-grid ui-grid-bisect">';
                balDivHtml +='<ul>';
                balDivHtml +='<li>';
                balDivHtml +='<div class="ui-gua-info-title" style="padding-left: 0.03rem;">';
                balDivHtml +='<h4>债权人</h4>';
                balDivHtml +=' <p style="padding-left: 0.01rem;">';
                balDivHtml +=data[i].creditorPerson;
                balDivHtml +=' </p></div>';
                balDivHtml +='</li>';
                balDivHtml +='<li>';
                balDivHtml +='<div class="ui-gua-info-title"><h4>';
                balDivHtml +=' 担保单位';
                balDivHtml +='</h4>';
                balDivHtml +='<p>';
                balDivHtml +=data[i].guaPerson;

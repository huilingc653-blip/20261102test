<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
				<tr>
			        <th>#springMessage('table.cmsPrecativeLoanInfo.billCode')</th>
			        <th>#springMessage('table.cmsPrecativeLoanInfo.contractCode')</th>
			        <th>#springMessage('table.cmsPrecativeLoanInfo.precativeId')</th>
			        <th>#springMessage('table.cmsPrecativeLoanInfo.money')</th>
			        <th>#springMessage('table.cmsPrecativeLoanSend.sendDate')</th>
			        <th>#springMessage('table.cmsPrecativeLoanSend.rate')</th>
			        <th>#springMessage('table.cmsPrecativeLoanInfo.term')</th>
			        <th>#springMessage('table.cmsPrecativeLoanInfo.status')</th>
			        <th>#springMessage('table.cmsPrecativeLoanInfo.createDate')</th>
    			</tr>
				</thead>
    			#foreach($send in $sendList)
		    	<tr>
		    		<td style="text-align:center;">
		    			$!{send.billCode}
		    		</td>
		    		<td style="text-align:center;">
		    			$!{send.contractCode}
		    		</td>
		    		<td style="text-align:center;">
		    			$!{send.precativeName}
		    		</td>
		    		<td style="text-align:right;">
		    			$number.formatNumeric($!{send.money})
		    		</td>
		    		<td style="text-align:center;">
		    			$!date.format('yyyy-MM-dd',$!{send.sendDate})
		    		</td>
		    		<td style="text-align:center;">
		    			##set($sendRate = $!{send.rate} * 100)
		    			$rateTag.show($!{send.rate})
		    		</td>
		    		<td style="text-align:center;">
		    			$!{send.term}$!{send.ternUnitStatus}
		    		</td>
		    		<td style="text-align:center;">
		    			$dictTag.get("cms.bizStatus",$!{send.bizStatus})
		    			##$!{send.status}
		    		</td>
		    		<td style="text-align:center;">
		    			$!date.format('yyyy-MM-dd',$!{send.createDate})
		    		</td>
		    	</tr>
		    #end
		    <!-- <tr>
            	<td colspan="9" align="center">
	       				<button class="layui-btn"  onClick="doClose()">#springMessage('common.button.close')</button>
       			</td>
            </tr> -->
			
		</table>
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','datatable','btdate','corp','moneyType','rateType','dateType','selectType','date'], function(){
    $ = bt.jquery,form = bt.form();
    bt.corp.init();
    moneyType = bt.moneyType.init();
    moneyFun = bt.moneyType.getFun();
    bt.dateType.init();
  //关闭窗口
    /* doClose = function(){
    	if(bt.navtab){
			bt.navtab.closeCurrent();
		}
    } */
});
</script>
</html>

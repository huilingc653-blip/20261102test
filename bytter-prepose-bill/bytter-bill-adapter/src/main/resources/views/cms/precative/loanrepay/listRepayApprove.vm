<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
   <form class="layui-form" id="searchForm">
  		<input type="hidden" id="opType" value="$!{opType}">
  		<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
       <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
        <table class="layui-table">
            <tbody>
                <tr>
                    ##借款人
                    <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</td>
                    <td width="30%">
                        <div class="layui-input-inline">
                           <div class="bt-biz-corp" data-biz-type="corp"data-type="selectTree"data-name="eqs_loanOpp"data-scope="all"  data-defaultvalue="$!{precativePage.loanOpp}" ></div>
                        </div>
                    </td>
                   ##单据编号
					<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.billCode')</td>
					<td width="30%">
						<input type="text layui-input" name="likes_infoBillCode"  autocomplete="off" class="layui-input">
					</td>
                </tr>
                <tr>
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
	    <tr>
            <th>#springMessage('table.cmsPrecativeLoanInfo.billCode')</th>
	        <th>#springMessage('table.cmsPrecativeLoanRepay.sendCode')</th>
            <th>#springMessage('table.cmsPrecativeLoanRepay.billCode')</th>
            <th>#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</th>
	        <th>#springMessage('table.cmsPrecativeLoanRepay.corpId')</th>
            <th>#springMessage('table.cmsPrecativeLoanInfo.curId')</th>
	        <th>#springMessage('table.cmsPrecativeLoanRepay.repayMoney')</th>
	        <th>#springMessage('table.cmsPrecativeLoanRepay.contractCode')</th>
	        <th>#springMessage('table.cmsPrecativeLoanRepay.repayDate')</th>
	        <th>#springMessage('table.cmsPrecativeLoanRepay.repayAccrual')</th>
	        <th>#springMessage('table.cmsPrecativeLoanRepay.repayType')</th>
	        <th>#springMessage('table.cmsPrecativeLoanRepay.status')</th>
	        <th>#springMessage('common.table.thead.operation')</th>
	    </tr>
    </thead>
</table>
#workFlowHtml()
#parse("views/common/footer.vm")
#workFlowScript()
</body>
<script>
bt.use(['form','datatable','corp','moneyType'], function(){
    $ = bt.jquery,form = bt.form();
    bt.corp.init();
    var moneyType = bt.moneyType.init();
    var moneyFun = bt.moneyType.getFun();
    //生成列表
    datatable = bt.datatable.init({
    	elem: "#appTable",
        dom: 'Brtlip',
        colReorder: true,
        checkbox:true,
        mulselect:true,
        selectCss:true,
        ajax: {
            'url': basePath+"/cms/precative/loanrepay/dataTableApprove"
        },searchForm:{
            formFilter:"search",
            formElem:"#searchForm"
        },
        buttons: []
        ,columns: [
            {data:"infoBillCode",bSortable:true,className:"center"},
            {data:"sendCode",bSortable:false,className:"center"},
            {data:"billCode",bSortable:false,className:"center"},
            {data:"loanOppName",bSortable:false,className:"center"},
            {data:"corpName",bSortable:true,className:"center"},
            {data:"curName",bSortable:false,className:"center"},
            {data:"repayMoney",bSortable:true,className:"textRight",
            	render: function (data, type, full, meta) {
            		return moneyFun.format(full.repayMoney);
            	}
            },
            {data:"contractCode",bSortable:false,className:"center"},
            {data:"repayDate",bSortable:true,className:"center"},
            {data:"repayAccrual",bSortable:true,className:"center"},
            {data:"repayType",bSortable:false,className:"center",
            	render : function(data,type,full,meta){
            		return bt.dict("cms.repayType",full.repayType);
            	}
            },
            {data:"bizStatus",bSortable:false,className:"center",
            	render : function(data,type,full,meta){
            		return bt.dict("cms.bizStatus",full.bizStatus);
            	}
            },
            {data:null,bSortable:false,className:'center',render: function (data, type, full, meta) {
            	var html='';
            	if($("#flowStatus").val()=='todo'){
            		html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
            	}
                if($("#flowStatus").val() == 'pass'){
                    html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a><span class="text-explode">|</span>';
                    html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                }else {
                    html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                }
                return html;
            }}
        ],
        summary:{
            pageSum: true,//小计功能开启
            selectSum: true,//已选汇总功能开启
            //groupColumn: 'curName',//分类汇总列参数
            format: {
                decimal: 2
            },
            sumList: [
                {
                    colNum: '5',//汇总列序号
                    dataName: 'repayMoney',//汇总列数据
                }
            ]
        }
    });
});

/*审核*/
function approve(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    if(bt.navtab){
        bt.navtab.addNavtab(bt.lang('common.button.approve') ,basePath + "/cms/precative/loanrepay/approve?businessId=" + data.billCode +"&id="+data.id + "&taskId=" + data.taskId);
        return;
    }
    parent.layer.open({
        type: 2,
        area: ['850px', '530px'],
        maxmin: true,
        content: basePath + "/cms/precative/loanrepay/approve?businessId=" + data.billCode +"&id="+data.id + "&taskId=" + data.taskId
    });
}

function view(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    if(data){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.view'),basePath + "/cms/precative/loanrepay/view/?sendCode=" + data.sendCode);
            return;
        }
    }
}

</script>
</html>

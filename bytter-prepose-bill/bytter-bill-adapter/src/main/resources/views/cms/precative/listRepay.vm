<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
				<tr>
			        <th>#springMessage('cms.precative.send.billCode')</th>
			        <th>#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</th>
			        <th>#springMessage('table.cmsPrecativeLoanSend.contractCode')</th>
			        <th>#springMessage('table.cmsPrecativeLoanRepay.repayDate')</th>
			        <th>#springMessage('table.cmsPrecativeLoanRepay.repayMoney')</th>
			        <th>#springMessage('table.cmsPrecativeLoanRepay.repayAccrual')</th>
			        <th>#springMessage('table.cmsPrecativeLoanRepay.repayType')</th>
			        <th>#springMessage('table.cmsPrecativeLoanInfo.status')</th>
    			</tr>
				</thead>
    			#foreach($repay in $repayList)
		    	<tr>
		    		<td style="text-align:center;">
		    			$!{repay.billCode}
		    		</td>
		    		<td style="text-align:center;">
		    			$!{repay.corpName}
		    		</td>
		    		<td style="text-align:center;">
		    			$!{repay.contractCode}
		    		</td>
		    		<td style="text-align:center;">
						$!date.format('yyyy-MM-dd',$!repay.repayDate)
		    		</td>
		    		<td style="text-align:right;">
		    			$number.formatNumeric($!{repay.repayMoney})
		    		</td>
		    		<td style="text-align:right;">
		    			#if($!number.formatNumeric($!{repay.repayAccrual}))
		    			$!number.formatNumeric($!{repay.repayAccrual})
		    			#else
		    			$!number.formatNumeric(0)
		    			#end
		    		</td>
		    		<td style="text-align:center;">
		    			$dictTag.get("cms.repayType",$!{repay.repayType})
		    		</td>
		    		<td>
		    			$dictTag.get("cms.bizStatus",$!{repay.bizStatus})
		    		</td>
		    	</tr>
		    #end
		    <!-- <tr>
            	<td colspan="9" align="center">
	       				<button class="layui-btn"  onClick="doClose()">#springMessage('common.button.close')</button>
       			</td>
            </tr> -->
			
		</table>
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','datatable','btdate','corp','moneyType','rateType','dateType','selectType','date'], function(){
    $ = bt.jquery,form = bt.form();
    bt.corp.init();
    moneyType = bt.moneyType.init();
    moneyFun = bt.moneyType.getFun();
    bt.dateType.init();
  	//关闭窗口
   /*  doClose = function(){
    	if(bt.navtab){
			bt.navtab.closeCurrent();
		}
    } */
});
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" id="searchForm">
	<input type="hidden" id="opType" value="$!{opType}">
	<table class="layui-table">
		<tbody>
			<tr>
				##委托人
				<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.precativeId')</td>
				<td width="35%">
					<div class="layui-input-inline">
						<div class="bt-biz-corp" data-biz-type="corp"  data-type="selectTree" data-name="eqs_precativeId" data-scope="all"></div>
					</div>
				</td>
				##借款人
				<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</td>
				<td width="35%">
					<div class="layui-input-inline">
						<div class="bt-biz-corp" data-biz-type="corp"  data-type="selectTree" data-name="eqs_loanOpp" data-scope="all"></div>
					</div>
				</td>
			</tr>
			<tr>
				##单据编号
				<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.billCode')</td>
				<td width="35%">
					<input type="text layui-input" name="likes_infoBillCode"  autocomplete="off" class="layui-input">
				</td>
				##合同号
				<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.contractCode')</td>
				<td width="35%" >
					<input type="text layui-input" name="likes_infoContractCode"  autocomplete="off" class="layui-input">
				</td>
			</tr>
			<tr>
				##借款开始时间
				<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.startDate')</td>
				<td width="35%" >
					<input type="text" name="ged_startDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="startDate" >
					<span class="date-mid">~</span>
					<input type="text" name="led_startDate" class="layui-input bt-input-inline bt-biz-dateType" id="startDate">
				</td>
				##借款结束时间
				<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.endDate')</td>
				<td width="35%" >
					<input type="text" name="ged_endDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="endDate">
					<span class="date-mid">~</span>
					<input type="text" name="led_endDate" class="layui-input bt-input-inline bt-biz-dateType" id="endDate">
				</td>
			</tr>
			<tr>
				##贷款金额
				<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.money')</td>
				<td width="35%" >
					<input type="text" data-name="geg_money" class="layui-input bt-input-inline  bt-biz-moneyType" data-moneyendid="money"  >
					<span class="date-mid">~</span>
					<input type="text" data-name="leg_money" class="layui-input bt-input-inline  bt-biz-moneyType" id="money" >
				</td>
				<td></td>
				<td></td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
				<button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
	<thead>
		<tr>
	        <th>#springMessage('table.cmsPrecativeLoanInfo.billCode')</th>
	        <th>#springMessage('table.cmsPrecativeLoanInfo.precativeId')</th>
	        <th>#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</th>
	        <th>#springMessage('table.cmsPrecativeLoanInfo.contractCode')</th>
	        <th>#springMessage('table.cmsPrecativeLoanInfo.startDate')</th>
	        <th>#springMessage('table.cmsPrecativeLoanInfo.endDate')</th>
	        <th>#springMessage('table.cmsPrecativeLoanInfo.term')</th>
	        <th>#springMessage('table.cmsPrecativeLoanInfo.curId')</th>
	        <th>#springMessage('table.cmsPrecativeLoanInfo.money')</th>
	        <th>#springMessage('table.cmsPrecativeLoanInfo.sendApproveMoney')</th>
	        <th>#springMessage('table.cmsPrecativeLoanSend.contractCode')</th>
	        <th>#springMessage('table.cmsPrecativeLoanSend.money')</th>
	        <th>#springMessage('table.cmsPrecativeLoanInfo.loanSendOutType')</th>
	        <th>#springMessage('table.cmsPrecativeLoanSend.sendTime')</th>
	   		<!--<th>#springMessage('table.cmsPrecativeLoanInfo.plType')</th> -->
	        <th>#springMessage('table.cmsPrecativeLoanInfo.status')</th>
	       	<th>#springMessage('common.table.thead.operation')</th>
		</tr>
	</thead>
</table>
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','datatable','btdate','corp','moneyType','rateType','dateType','selectType','date'], function(){
    $ = bt.jquery,form = bt.form();
    bt.corp.init();
    var moneyType = bt.moneyType.init();
    var moneyFun = bt.moneyType.getFun();
    var test = bt.dateType.init();
  	//生成列表
    datatable = bt.datatable.init({
        elem: "#appTable",
        dom: 'Brtlip',
        colReorder: true,
        mulselect:false,
        selectCss:true,
        ajax: {
            'url': basePath+"/cms/precative/loansend/datatable"
        },searchForm:{
            formFilter:"search",
            formElem:"#searchForm"
        },
        fixedColumns: {
            rightColumns: 1//浠ｈ〃鍐荤粨鍙宠竟涓€鍒�
        },
        buttons: [
            {
                extend: "colvis",
                text: bt.lang('common.button.theadHide'),
                columns: ':not(:first):not(:last)'
            }
        ],
        columns: [
            {data:"infoBillCode",bSortable:true,className:"center"},
            {data:"precativeName",bSortable:true,className:"center"},
            {data:"loanOppName",bSortable:true,className:"center"},
            {data:"infoContractCode",bSortable:false,className:"center"},
            {data:"startDate",bSortable:true,className:'center'},
            {data:"endDate",bSortable:true,className:'center'},
            {data:"term",bSortable:true,className:"center",
            	render : function( data , type , full , meta ){
                    if (full.ternUnit == 'D') {
                        return full.term + bt.lang("cms.loan.ternUnit.day");
                    } else if (full.ternUnit == 'M') {
                        return full.term + bt.lang("cms.loan.ternUnit.month");
                    } else {
                        return full.term;
                    }
            	}	
            },
            {data:"curName",bSortable:true,className:"center"},
            {data:"infoMoney",bSortable:true,className:"textRight",
            	render: function (data, type, full, meta) {
            		return moneyFun.format(full.infoMoney);
            	}
            },
            {data:"issuedMoney",bSortable:true,className:"textRight",
            	render: function (data, type, full, meta) {
            		return moneyFun.format(full.issuedMoney);
            	}
            },
            {data:"contractCode",bSortable:false,className:"center"},
            {data:"sendApproveMoney",bSortable:true,className:"textRight",
            	render: function (data, type, full, meta) {
            		return moneyFun.format(full.sendApproveMoney);
            	}
            },
         /*    {data:"plName",bSortable:true,className:"textRight"}, */
         	{data:"loanSendOutType",bSortable:true,className:"center",
            	render: function (data, type, full, meta) {
                	return bt.dict("cms.loan.loanSendOutType",full.loanSendOutType);
            	}
         	},
         	{data:"sendTime",bSortable:false,className:"center",
            	render: function ( data, type, full, meta ) {
	        		if(full.sendTime > 0){
	        			return '<a class="" href="#" data-row="'+meta.row+'" onclick="sendList(this)"><u>'+ full.sendTime +'</u></a>';
	        		}else{
	        			return full.sendTime ;
	        		}
            	}
         	},
            {data:"bizStatus",bSortable:true,className:"center",
            	render: function (data, type, full, meta) {
            		var bizStatus = (full.bizStatus == null ? full.infoBizStatus : full.bizStatus);
                	return bt.dict("cms.bizStatus",bizStatus);
            	}
            },
            {data:null,bSortable:false,className:'center',render: function (data, type, full, meta) {
            	var html ='' ;
            	if(full.status == '0' || full.status == '-1' ){
                    html += '<a class="" href="#" data-row="' + meta.row + '" onclick="update(this)">' + bt.lang("cms.precative.send.change") + '</a> |';
            	}else if(full.infoStatus == '96' && full.status !='11' ){
                    html += '<a class="" href="#" data-row="' + meta.row + '" onclick="send(this)">' + bt.lang("table.cmsProvideLoanSend.sendApply") + '</a> |';
            	}
            	if(full.sendApproveMoney == '0' && full.status != '11'){
	                html += ' <a class="" href="#" data-row="'+meta.row+'" onclick="back(this)">'+bt.lang("common.button.back")+'</a> |';
                }
                html += ' <a class="" href="#" data-row="'+meta.row+'" onclick="view(this)">'+bt.lang("common.button.view")+'</a>';
                html +=' | <a class="" href="#" data-row="'+meta.row+'" onclick="listMsg(this)">'+bt.lang("common.button.logInfo")+'</a>';
 //               html += '<span class="text-explode">|</span><a class="" href="#" data-row="'+meta.row+'" onclick="bt.trackFlowByBusinessId(\''+full.id+'\')">'+bt.lang("common.button.trackFlow")+'</a>';
                return html;
            }}
        ],
        summary:{
            pageSum: true,//小计功能开启
            selectSum: false,//已选汇总功能开启
            //groupColumn: 'curName',//分类汇总列参数
            format: {
                decimal: 2
            },
            sumList: [
                {
                    colNum: '9', //汇总列序号
                    dataName: 'infoMoney' //汇总列贷款金额
                },
                {
                    colNum: '10', //汇总列序号
                    dataName: 'issuedMoney' //汇总列待发放金额
                },
                {
                    colNum: '12', //汇总列序号
                    dataName: 'sendApproveMoney' //汇总列发放金额
                }
            ]
        }
    });
});

function view(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    if(bt.navtab){
        bt.navtab.addNavtab(bt.lang('common.button.view'),basePath + "/cms/precative/loansend/view?fatherCode=" + data.infoBillCode );
        return;
    }
    parent.layer.open({
        type: 2,
        area: ['850px', '650px'],
        maxmin: true,
        content: basePath + "/cms/precative/loansend/view/" + data.infoBillCode
    });
}

function update(el){
	var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    if(data){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('cms.precative.send.change'),basePath + "/cms/precative/loansend/send?infoBillCode=" + data.infoBillCode +"&type=Edit&id="+data.id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/precative/loansend/send?fatherCode=" + data.fatherCode +"&type=Edit&id="+data.id ,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }
}

function back(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    parent.layer.confirm(bt.lang('common.message.confirm.back'),function(){
        $.post(basePath + "/cms/precative/loansend/back/" + data.infoId, function(result){
            location.reload();
            parent.layer.alert(result.msg, {icon: result.success?1:2});
        },'JSON');
    });
}

function send(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    if(data){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('table.cmsProvideLoanSend.sendApply'),basePath + "/cms/precative/loansend/send?infoBillCode=" + data.infoBillCode +"&type=init&id="+data.id );
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/precative/loansend/send?infoBillCode=" + data.infoBillCode +"&type=init&id="+data.id ,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }
}

//查询发放列表
function sendList(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    if(bt.navtab){
        bt.navtab.addNavtab(bt.lang('table.precative.sendlist'),basePath + "/cms/precative/loansend/sendList?fatherCode=" + data.infoBillCode );
        return;
    }
    parent.layer.open({
        type: 2,
        area: ['950px', '630px'],
        maxmin: true,
        content: basePath + "/cms/precative/loansend/sendList/" + data.infoBillCode 
    });
}

//日志列表
function listMsg(el){
	var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
	if(data){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.logInfo'),basePath + "/cms/basedata/cmsprocessmsg/list?billCode=" + data.infoBillCode+","+data.billCode);
            return;
        }
	}
}

</script>
</html>

//获取字符串长度
function strLen(str) {  
	var len = 0;  
	for (var i=0; i<str.length; i++) {  
		if (str.charCodeAt(i)>127 || str.charCodeAt(i)==94) {  
			len += 2;  
		} else {  
			len ++;  
		}  
	}  
	return len;  
}
	
/**判断字符串是否为空*/
function isEmpty(ms){
	if(typeof(ms) == "undefined" || ms == null || ms == ""){
		return true;
	}
	return false;
}


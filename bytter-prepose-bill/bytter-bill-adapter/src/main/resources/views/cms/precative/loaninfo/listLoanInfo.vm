//根据单位ID和业务类型判断是否挂预算
function isBudget(corpId,briefId,startValue){
	$.ajax({ 
	      type: 'POST',
	      url: basePath+"/cms/precative/loaninfo/isBudget", 
	      data:{'corpId':corpId,'briefId':briefId},  
	      async: false, 
	      dataType:'json',
	      success: function(result){
	            if(result.success){
	            	if(result.attributes.isBudget){
						$("input[data-name='money']").attr("readonly","readonly");
	            		genOtherHtml(corpId,startValue);
	            		return true;
	            	}else{
					   $("input[data-name='money']").attr("readonly",false);
	            		$("#tagItemDetail").html("");
	            		return false;
	            	}
	            }else{
	            	parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
	            }
		}
	});
}


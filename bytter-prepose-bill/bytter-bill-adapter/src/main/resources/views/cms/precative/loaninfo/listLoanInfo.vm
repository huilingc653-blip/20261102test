<script>
	var selectType,budgetSel;
bt.use(['form','datatable','btdate','corp','moneyType','rateType','dateType','selectType','date','dicts','bankInfo'], function(){
    $ = bt.jquery,form = bt.form();
    corps = bt.corp.init();
    moneyType = bt.moneyType.init();
    selectType = bt.selectType.init();
    rateTye = bt.rateType.init();
    dateType = bt.dateType.init();
    dicts = bt.dicts.init();
    bt.bankInfo.init();

   budgetSel=$("#budgetSel").val();//参数设置是否挂接资金计划

    //监听是否银行办理
    form.on('switch(isBank)', function(data){
		var corpId = $("input[name='corpId']");
		var bankCode = $("input[name='bankCode']");
		if(data.elem.checked){
			$("#isBank").val(1);
			$("#corpIdDiv").hide(); 
			$("#bankCodeDiv").show();
			$("#bankSelectDiv").show();
			$("#bankSelectDiv").attr("style","display:inline-block;margin-left:5px;margin-right:5px;padding-top:4px;");
			$("#isBankName").text("#springMessage('table.cmsPrecativeLoanInfo.bankCode')");
			$("#bankName").attr("lay-verify","required");
			$("select[name='corpId']").removeAttr("lay-verify");
		}else{
			$("#isBank").val(0);
			$("#corpIdDiv").show(); 
			$("#bankCodeDiv").hide();
			$("#bankSelectDiv").hide();
			$("#bankName").removeAttr("lay-verify");
			$("select[name='corpId']").attr("lay-verify","required");
			$("#isBankName").text("#springMessage('table.cmsPrecativeLoanInfo.corpId')");
		    $.post(basePath + "/cms/precative/loaninfo/getCorp/",{precativeId:corps.get("precativeId").val()}, function(result){
		    	corps.get("corpId").val(result);
         	},'JSON');
		}
		form.renderIcon();
   	});  
    
  	//监听提交
    form.on('submit', function(data){
	$("input[name='corpId']").val(data.field.corpId);
    	bt.loading.show();//显示加载中
    	//委托人和借款人不能为同一单位
    	if(data.field.precativeId == data.field.loanOpp){
    		layer.msg(bt.lang('table.precativeLoan.precativeAndLoan.notOneCorp'));
    		bt.loading.hide(); //关闭加载中
    		return false;
    	}
    	//设置提交时委托人或者委托行的值
    	var isBank = $("#isBank").val();
    	if( isBank == "1"){
    		data.field['corpId'] = "";
    	}else{
    		data.field['bankCode'] = "";
    	}
        var action = "/cms/precative/loaninfo/submit";
        var type = $(this).attr("id");
        if(type == "submit"){
        	$("input[name='saveType']").val("1");
        }
    	var purposrLen = strLen(data.field['purpose']);
    	if(purposrLen >= 50){
    		layer.msg(bt.lang('table.precativeLoan.purposeLengthBeyond'));
    		bt.loading.hide(); //关闭加载中
    		return false;
    	}
        $.post(basePath + action,$('#inputForm').serialize(),function(result){
       		bt.loading.hide(); //关闭加载中
            if(result.success){
            	if(!bt.navtab){
            		location.reload();
                    parent.layer?parent.layer.closeAll():layer.closeAll();
            	} else {
            		if($("#type").val() == "Edit"){
            			bt.navtab.closeCurrent();
            		}else{
            			location.reload();
            		}
            	}
            }
            parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
        },'JSON');
        return false;
    });
  	
  	
   ## <div class="bt-biz-corp" data-biz-type="corp" data-biz-name="loanOpp" data-tree-type="radio"
   ##  data-type="selectTree" data-name="loanOpp" data-scope="all"
	## 	data-required="true" data-callback="corpCallback" data-callbackData="loanOppCallBack"
	## 	data-defaultvalue="$!{precativePage.loanOpp}" ></div>
  	initLoanOpp = function(){
		var precativeId = $("#precative").val();
		var loanOpp = $("#loan").val();
		//初始化委托人
  		loanOppTree = bt.selectTree.init({
  			url:basePath+"/cms/precative/loaninfo/getLoanOpp?precativeId="+ precativeId,
  			elem:".testLoanOpp",
  			name: "loanOpp",
  			checkType:'radio',
  			selected: loanOpp,
  			//clickCallBack:"loanOppCallBack",
  			//clickCallBackData:loanOppCallBack,
  			required:true,
  			setting:{
  	            data:{
  	                simpleData: {
  	                	pIdKey: "parentId"
  	                }
  	            },
  	            check : {
  	            	chkboxType: { "Y": "s", "N": "s" }
  	            }
  	        },
  	        beforeInit:function(nodes){
  	            for(k in nodes){
  	                nodes[k].name = "(" + nodes[k].code + ")" + nodes[k].name;
  	            }   
  	            return nodes;
  	        }
  		});
  		form.renderIcon();//渲染必填
  	}
  	
 	//监听修改重置
  	if($("#type").val() == "Edit"){
	    form.on('submit(reset)', function(data){
	    	location.reload();
	    })
  	}
 	
  	initLoanOpp();
  
});

//监听贷款期限单位
function setTerm(ele,data){
	var  startValue = dateType.get("startDate").val();
	var  endValue = dateType.get("endDate").val();
	var  startDate = new Date(startValue);
	var  endDate = new Date(endValue);
	var  corpId=corps.get("precativeId").val();
	var  planStartTime=$("#planStartTime").val();
	var  planEndTime=$("#planEndTime").val();
	if(startValue !=="" && endValue !==""){
		if(startValue >= endValue){//结束日期应大于开始日期
    		dateType.get($(data).attr("data-biz-name")).val("");
    		layer.tips(bt.lang("cms.precative.startdateenddate.more"), '#'+$(data).attr("data-biz-name"));
    		return false;
    	} 
		
		var ternUnit = dicts.get("ternUnit").val();
		if(ternUnit == "M"){
			//$("#term").val((endDate.getYear() - startDate.getYear())*12 + endDate.getMonth() - startDate.getMonth());
			$("#term").val(dataSubtract(startValue,endValue,"M"));
		}else if(ternUnit == "D"){
			$("#term").val((endDate-startDate)/(1000*60*60*24));
		}
	}
	
}

//监听贷款期限单位 开始日期回调
function setStartTerm(ele,data){
	var  startValue = dateType.get("startDate").val();
	var  endValue = dateType.get("endDate").val();
	var  startDate = new Date(startValue);
	var  endDate = new Date(endValue);
	var  corpId=corps.get("precativeId").val();
	var  planStartTime=$("#planStartTime").val();
	var  planEndTime=$("#planEndTime").val();
	if(startValue !=="" && endValue !==""){
		if(startValue >= endValue){//结束日期应大于开始日期
    		dateType.get($(data).attr("data-biz-name")).val("");
    		layer.tips(bt.lang("cms.precative.startdateenddate.more"), '#'+$(data).attr("data-biz-name"));
    		return false;
    	} 
		
		var ternUnit = dicts.get("ternUnit").val();
		if(ternUnit == "M"){
			//$("#term").val((endDate.getYear() - startDate.getYear())*12 + endDate.getMonth() - startDate.getMonth());
			$("#term").val(dataSubtract(startValue,endValue,"M"));
		}else if(ternUnit == "D"){
			$("#term").val((endDate-startDate)/(1000*60*60*24));
		}
	}
	
	//开始日期应在计划周期范围内
	if(budgetSel=="1"&&!isEmpty(startValue)){
		if(!(startValue >= planStartTime && startValue <= planEndTime)){
		    dateType.get($(data).attr("data-biz-name")).val("");
		    layer.tips(bt.lang("cms.precative.startdateplanTime.more"), '#'+$(data).attr("data-biz-name"));
    		return false;
		}
	}
	if(!isEmpty(startValue) && !isEmpty(corpId)){
	  corpCallback(corpId,startValue);
	}
}




/**计算data1 与 data2 相差多少param单位 data为字符串*/
function dataSubtract(data1,data2,param){
    var dates;
	var start = new Date(data1);
    var end = new Date(data2);
    var addMonth = end.getMonth() - start.getMonth();//月份差
    var startLastDay = mGetDate(start.getYear(),start.getMonth());//开始时间当前月总共多少天
    var endLastDay = mGetDate(end.getYear(),end.getMonth());//结束时间当前月总共多少天
    if(startLastDay == start.getDate()){//开始日期月末最后一天
    	if(endLastDay == end.getDate()){//结束日期月末最后一天
    		addMonth ++;//月份+1
    	}else{
    		if(end.getDate() > start.getDate()){//结束日期当月天数 > 开始日期单月天数
	    		addMonth ++;//月份+1
	    	}
    	}
    }else{
    	if(endLastDay == end.getDate()){//结束日期月末最后一天
    		addMonth ++;//月份+1
    	}else{
    		if(end.getDate() > start.getDate()){//结束日期当月天数 > 开始日期单月天数
	    		addMonth ++;//月份+1
	    	}
    	}
    }
	dates = (end.getYear() - start.getYear())*12 + addMonth;     
    return  dates;
}

function mGetDate(year, month){
    var d = new Date(year, month  + 1, 0);
    return d.getDate();
}


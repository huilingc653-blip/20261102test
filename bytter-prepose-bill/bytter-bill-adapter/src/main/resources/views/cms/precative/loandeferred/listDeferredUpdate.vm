<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
            	<input type="hidden" id="pageType" value="${pageType}">
                <tr>
                	##单位
                	<td width="25%" class="textRight">#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</td>
                	<td >
                		<div class="layui-input-inline">
                   			<div class="bt-biz-corp" data-biz-type="corp" data-type="selectTree" data-name="eqs_loanOpp" data-scope="all" data-resource="cms:precative:deferred:update:query"></div>
                  		</div>
                  	</td>
                  	##借款单号
                  	<td width="25%" class="textRight">#springMessage('table.cmsLoanDeferred.billCode')</td> 
                  	<td>
                  		<input type="text" name="likes_billCode" class="layui-input">
                  	</td>
                </tr>
                ##按钮组
                <tr>
                	#if($shiro.hasPermission("cms:precative:deferred:update:query"))
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                    #end
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsLoanDeferred.billCode')</th>
        <th>#springMessage('table.cmsPrecativeLoanRepay.sendCode')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</th>
        <!-- <th>#springMessage('cms.provide.deferred.expiryhandletype')</th> -->
        <th>#springMessage('table.lastTime.deferredRepayDate')</th>
        <th>#springMessage('table.cmsLoanSend.deferredReplayDate')</th>
        <th>#springMessage('table.cmsPrecativeLoanDeferred.deferredLimt')</th>
     	<!-- <th>#springMessage('table.cmsLoanSend.deferredNum')</th> -->
        <th>#springMessage('table.btBankAcc.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/precative/precativeDeferredUpdate.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
	<input id="id" name="id" type="hidden" value="$!{cmsLoanRepayPage.id}">
	##委托方单位id
	<input id="precativeId" name="precativeId" type="hidden" value="$!{precativePage.precativeId}">
	##借款方单位id
    <input id="loanOpp" name="loanOpp" type="hidden" value="$!{precativePage.loanOpp}">
    <table class="layui-table">
		<colgroup>
	  		<col width="15%">
	  		<col width="35%">
	  		<col width="15%">
	  		<col width="35%">
       	</colgroup>
		<tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label>#springMessage('table.cmsLoanInfo.createDate')</label>&nbsp;&nbsp;
					<div class="layui-input-inline" style="padding-bottom: 4px;">
						$!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.createDate)
						<input type="hidden" name="createDate"  autocomplete="off" class="layui-input" value="$!date.format('yyyy-MM-dd',$!{opDate})" readonly="readonly">
					</div>
				</td>
			</tr>
			<tr>
        		##申请单位
				<td class="textRight">#springMessage('table.cmsLoanInfo.corp')</td>
				<td>
					<span>$!{cmsLoanInfoPage.loanOppName}</span>
				</td>
				
				 ##借款人
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</td>
                 <td >
                    $!{precativePage.loanOppName}
                </td>
			</tr>
			<tr>
				##贷款单号
				<td class="textRight">#springMessage('table.cmsLoanInfo.billCode')</td>
				<td>
					<span>$!{cmsLoanInfoPage.billCode}</span>
				</td>
				##合同号
				<td class="textRight">#springMessage('table.cmsLoanInfo.contractCode')</td>
				<td>
					<span>$!{cmsLoanInfoPage.contractCode}</span>
				</td>
			</tr>
			<tr>
			##贷款发放编号
				<td class="textRight" >#springMessage('table.cmsLoanSend.billCode')</td>
				<td colspan="3">
					<span>$!{cmsLoanSendPage.billCode}</span>
				</td>
			</tr>
			#if($isAccounting)
			<tr>
				##委贷账号
				<td class="textRight">#springMessage('table.cmsPrecativeLoanSend.loanAcc')</td>
				<td>
					<span>$!{cmsLoanSendPage.loanAcc}</span>
				</td>
				##委存账号
				<td class="textRight">#springMessage('table.cmsPrecativeLoanSend.depositAcc')</td>
				<td >
					<span>$!{cmsLoanSendPage.depositAcc}</span>
				</td>
			</tr>
			#end
			<tr>
				##放款币别
				<td class="textRight">#springMessage('table.cmsLoanInfo.curCode')</td>
				<td >
					<div class="layui-input-inline">
						$!{cmsLoanInfoPage.curName}
					</div>
				</td>
				##放款金额
				<td class="textRight">#springMessage('table.cmsLoanSend.loanMoney')</td>
				<td>
					$number.formatNumeric($!{cmsLoanSendPage.money})
					<input type="hidden" id="loanMoney" value="$!{cmsLoanSendPage.money}">
				</td>
			</tr>
			<tr>
				##还款在途金额
				<td class="textRight">#springMessage('table.cmsLoanRepay.inwayMoney')</td>
				<td >
					$number.formatNumeric($!{inwayMoney})
				</td>
				##已还金额
				<td class="textRight">#springMessage('table.cmsLoanRepay.processMoney')</td>
				<td >
					$number.formatNumeric($!{rpayedMoney})
				</td>
			</tr>
			<tr>
				##贷款发放日期
				<td class="textRight">#springMessage('table.cmsLoanSend.loanDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.sendDate)</td>
				##到期日期
				<td class="textRight">#springMessage('table.cmsPrecativeLoanSend.deadlineDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.deadlineDate)</td>
			</tr>
			<tr>
				##展期到期日期
				<td class="textRight">#springMessage('table.fcAcc.delayDeadlineDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!{cmsLoanSendPage.deferredDate})</td>
				##还款类型
				<td class="textRight">#springMessage('table.cmsLoanRepay.repayType')</td>
				<td>
					<div class="bt-biz-dict" data-type="select" data-group="cms.repayType" data-defaultvalue="$!{cmsLoanRepayPage.repayType}" data-name="repayType" data-biz-name="repayType"  data-disabled="true"></div>
					<input type="hidden" id="initRepayType" name="repayType" value="$!{cmsLoanRepayPage.repayType}">
				</td>
			</tr>
			<tr>
				##还款日期
				<td class="textRight">#springMessage('table.cmsLoanRepay.repayDate')</td>
				<td>
					$!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.repayDate)
					<input type="hidden" name="repayDate" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.repayDate)" data-type="date" id="repayDate" data-biz-name="repayDate">
				</td>
				##还款金额
				<td class="textRight">#springMessage('table.cmsLoanRepay.repayMoney')</td>
				<td>
					<div class="layui-inline">
						<span id="repayMoneyShow">
							#if($cmsLoanRepayPage.repayType==4)
								$number.formatNumeric(0)    
							#else
								$number.formatNumeric($!{cmsLoanRepayPage.repayMoney})  ##归还本金
							#end								
						</span>
					</div>
				</td>
			</tr>
			<tr>
				##还款利息
       			<td class="textRight">#springMessage('table.cmsLoanRepay.repayAccrual')</td>
					<td>
						<input data-name="repayAccrual" class="layui-input bt-biz-moneyType layui-input " data-biz-name="repayAccrual" value="$!{cmsLoanRepayPage.repayAccrual}" readonly="readonly">
						
						#if($isAccounting)
							##<button  type="button" id="lixqdButton" class="layui-btn layui-btn-small" onClick="showlxqd()" >#springMessage('table.interet.lxqd')</button>
						#end
						##<span id="curAccrualShow" style="color: red"></span>
						##<input type="hidden" id="SyncAccrual" value="">
					</td>
				<td class="textRight">#springMessage('table.cmsLoanSend.repayType')</td>
				<td>
					$!cmsLoanSendPage.repayTypes
				</td>
			</tr>
			<tr>
				<td colspan="4" style="text-align: center;">
					<button class="layui-btn" lay-submit=""  lay-filter="submit" value="106">#springMessage('common.button.submit')</button>
					<button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
				</td>
			</tr>
       	</tbody>
	</table>
	 <!-- 资金计划 -->
	<div id="tagItemDetail"></div>
	<input type="hidden" value="" name="total" id="total">
		
	<input type="hidden" id ="sendCode" name="sendCode" value="$!{cmsLoanSendPage.billCode}"><!-- 发放编号 -->
	<input type="hidden" id="repayAccrual2" value="$!{cmsLoanRepayPage.repayAccrual}"><!-- 还款利息 -->
	<input type="hidden" id ="sendId" value="$!{cmsLoanSendPage.id}"><!-- 发放编号 -->
	<input type="hidden" id ="closeDay" value="$!{closeDay}"><!-- 日结日期 -->
	<input type="hidden" id="loanAcc" value="$!{cmsLoanSendPage.loanAcc}"><!-- 贷款账号 -->
	<input type="hidden" id="repayMoney" name="repayMoney" value="$!{cmsLoanRepayPage.repayMoney}"><!-- 还款金额 -->
	<input type="hidden" id="sendMoney" value="$!{cmsLoanSendPage.money}"><!--发放金额 -->
	<input type="hidden" id="orderNo" value=""><!-- 利息流水号-->
	<input type="hidden" id="repayDate" value="$!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.repayDate)"><!-- 还款日期 -->
	<input type="hidden" id="isAccounting" value="$!{isAccounting}"><!-- 还款日期 -->
	<input type="hidden" id="billCode" name="billCode" value="$!{cmsLoanRepayPage.billCode}"><!-- 还款表billcode -->
	<input type="hidden" id="corpId" name="corpId" value="$!{cmsLoanRepayPage.corpId}"><!-- 还款表corpId -->
	<input type="hidden" id="curId" name="curId" value="$!{cmsLoanInfoPage.curId}"><!-- 还款表curId -->
	<input id="endorseItem" name="endorseItem" type="hidden" value="$!{endorseItem}">
	<input id="defItemCode" name="defItemCode" type="hidden" value="">
</form>
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','layedit','dateType','dicts','moneyType'], function(){
    $ = bt.jquery,form = bt.form();
    moneyFun = bt.moneyType.getFun();

    
    $(document).ready(function(){
		var loanOpp = $("#loanOpp").val();
		corpCallback(loanOpp);
	});

    var dateType = bt.dateType.init();
    var dicts = bt.dicts.init();
    var moneyType = bt.moneyType.init();
     
    form.on('submit(submit)', function(data){
    	bt.loading.show();//显示加载中
    	//var status = $(this).attr("value");
        var action = "/cms/precative/loanrepay/repayAdditionalSave";
        //data.field.status = status;
    //    data.field.deferredStartDate = (($('#scDeferredDate').val() == ""||$('#scDeferredDate').val() == undefined) ? $("#matureDate").val() : $('#scDeferredDate').val());
        $.post(basePath + action,$('#inputForm').serialize(),function(result){
            parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            bt.loading.hide(); //关闭加载中
            if(result.success){
                if(!bt.navtab){
                    parent.layer?parent.layer.closeAll():layer.closeAll();
                } else {
                	bt.navtab.refreshParent();
                	bt.navtab.closeCurrent();
                }
            }
        },'JSON');
        return false;
    });  
   
});    	
    
    //关闭窗口
doClose = function(){
    if(bt.navtab){
		bt.navtab.closeCurrent();
	}
}

//借款人回调函数
function corpCallback(data){
	isBudget(data,"3000");
}

//根据单位ID和业务类型判断是否挂预算
function isBudget(corpId,briefId){
	$.ajax({
		type:'POST',
		url:basePath+"/cms/precative/loaninfo/isBudget",
		data:{'corpId':corpId,'briefId':briefId},
		async:false,//是否异步
		dataType:'json',
		success:function(result){
			if(result.success){
				if(result.attributes.isBudget){
					genOtherHtml(corpId);
					return true;
				}else{
					$("#tagItemDetail").html("");
					return false;
				}
			}else{
				parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
			}
		}
		
	})
}

//生成资金计划的表格
genOtherHtml = function(corpId){
	var itemCode = $('input[name = "endorseItem"]').val();//委托贷款业务选择的预算科目
	var defItemCode = $('input[name="defItemCode"]').val();//还没存值
	var processDate = $('input[name="repayDate"]').val();//还款日期
	var curId = $('#curId').val();
	var url = basePath + "/budget/fbsBudgetProcess/getItemDetail"//返回的表格页面控件
	var param = {
			corpId:corpId,
			itemCode:itemCode,
			defItemCode:defItemCode,
			processDate:processDate,
			type:'select',
			date:(new Date()).getTime(),
			curId:curId
			
	};
	$.ajax({url:url,method:'post',data:param,async:true,success:function(json){
		$("#tagItemDetail").html("");
		$("#tagItemDetail").html(json);
	}})
}

/**
 * 计划执行输入金额汇总后的回调
 * @param data
 */
function sumMoneyCallBack(data){
	  var moneyData = moneyFun.toNumber(data);
      $("#total").attr("value",moneyData)
}

</script>
</html>
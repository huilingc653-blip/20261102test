<script>
	bt.use(['form','datatable','btdate','corp','moneyType','rateType','dateType','selectType','date','dicts','rateType','element','btUpload'], function(){
		element = layui.element();
		$ = bt.jquery,form = bt.form();
		bt.corp.init();
		moneyType = bt.moneyType.init();
		loadLoanRate();
		selectType = bt.selectType.init();
		rateType = bt.rateType.init();
		dateType = bt.dateType.init();
		dicts = bt.dicts.init();
		var gid = $("#annexName").val();
		var up = bt.btUpload.init({
			elem: "#uploader",
			isExpand: true,
			auto: false,
			gid: gid
		});
		//获取利率
		$("#getRate").click(function(){
			getRate();
		});
		//设置还款计划
		$("#openRepayMentSchedule").click(function(){
			repayPlan();
		});

		//监听提交
		form.on('submit', function(data){
			bt.loading.show();//显示加载中
			if($("#remainMoney").val() == ""){
				layer.msg(bt.lang("table.cmsLoan.sendMoneylessApproveMoney"));
				bt.loading.hide(); //关闭加载中
				return false;
			}
			if(parseInt(data.field['money']) > parseInt($("#remainMoney").val())){
				layer.msg(bt.lang("table.cmsLoan.sendMoneylessApproveMoney"));
				bt.loading.hide(); //关闭加载中
				return false;
			}
			if(data.field['money'] == 0){
				layer.tips(bt.lang("cms.loan.sendMoney.zero"), '.moneyShow');
				bt.loading.hide(); //关闭加载中
				return false;
			}
			var action = "/cms/precative/loansend/submitOrTemp";
			var type = $(this).attr("id");
			if(type == "submit"){
				data.field.saveType = "1";
			}
			var flag = false;
			data.field.annexName = up.getGroupId();
			if($("#planStatus").val()=="1"){//维护还款计划且贷款利率、还款方式、本次放款金额被修改
				layer.confirm(bt.lang('cms.loan.resetRepayPlanMsg'), {icon: 3, title:bt.lang('table.cmsProcessMsg.message')}, function(index){
					layer.close(index);
					data.field.planId = '';
					$.post(basePath + action,data.field,function(result){
						parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
						bt.loading.hide(); //关闭加载中
						if(result.success){
							$.each($(".layui-form"), function(){
								this.reset();
							});
							if(!bt.navtab){
								parent.layer?parent.layer.closeAll():layer.closeAll();
							} else {
								bt.navtab.refreshParent();
								bt.navtab.closeCurrent();
							}
						}
					},'JSON');
					return false;
				});
				return false;
			}else{
				flag = true;
			}
			if(flag){//未维护还款计划
				$.post(basePath + action,data.field,function(result){
					bt.loading.hide(); //关闭加载中
					if(result.success){
						if(!bt.navtab){
							location.reload();
							parent.layer?parent.layer.closeAll():layer.closeAll();
						} else {
							bt.navtab.refreshParent();
							bt.navtab.closeCurrent();
						}
					}
					parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
				},'JSON');
				return false;
			}
			return false;
		});

//   $(function(){
//		initRepayCycle($("#floatWay").val());
//	})
		$(function(){
			var postfix = "";
			var floatWay = dicts.get("floatWay").val();
			var floatWayNext = $("#floatWayNext").val();
			if(floatWay == "01"){//固定利率

			}else if(floatWay == "02"){//即时浮动

			}else if(floatWay == "03"){//按月浮动
				postfix = "Month";
			}else if(floatWay == "04"){//按季浮动
				postfix = "Season";
			}else if(floatWay == "05"){//按半年浮动
				postfix = "HY";
			}else if(floatWay == "06"){//按年浮动
				postfix = "Year";
			}
			if(postfix == ""){
				$("#nextDetail").html("");//删除页面元素
			}else{
				var htl = '<div class="bt-biz-dict" data-name="floatWayNext" data-disabled="true" data-defaultvalue="'+ floatWayNext +'" data-type="select" data-biz-name="floatWayNext'+ postfix +'" data-group="Cms.FloatWay'+ postfix +'" ></div>';
				$("#nextDetail").html(htl);
				bt.dicts.render();
			}
		})
	});

	//初始化贷款周期
	//function initRepayCycle(type){
	//	loadLoanRate();
	//}

	/**加载基准利率和利率期限*/
	function loadLoanRate(){
		var curId = $("#curId").val();
		var isNatualCurrency = $("#isNatualCurrency").val();
		var url ="";
		if(isEmpty(curId)){
			//selectType.get("referenceRateType").attr("data-url","");
		}else if(isNatualCurrency == "false"){
			url = basePath+"/cms/loanrate/maintence/queryNotBaseRate";
			//selectType.get("referenceRateType").attr("data-url",basePath+"/cms/loanrate/maintence/queryNotBaseRate");
		}else{//本位币
			url = basePath+"/cms/loanrate/maintence/queryBaseRate";
			//selectType.get("referenceRateType").attr("data-url",basePath+"/cms/loanrate/maintence/queryBaseRate");
		}
		$("#referenceRateType").data("url",url);
	}

	function checkMoney(data , elem){
		var remainMoney = $("#remainMoney").val();
		if(remainMoney == ""){
			layer.tips(bt.lang("table.cmsLoan.sendMoneylessApproveMoney"), '.moneyShow');
			moneyType.get($(elem).attr("data-biz-name")).val(0);
			return false;
		}
		if(data > remainMoney){
			moneyType.get($(elem).attr("data-biz-name")).val(remainMoney);
			moneyType.reset();
			layer.tips(bt.lang("table.cmsLoan.sendMoneylessApproveMoney"), '.moneyShow');
			return false;
		}
		retPayPlan1();
	}

	/**加载还款计划*/
	function repayPlan(){
		var loanCode = $("input[name='billCode']").val();//录入单号
		//var loanRate = rateType.get("rate").val();//委托贷款利率
		var loanRate = $("input[name='rate']").val();
		var loanDate = dateType.get("sendDate").val();//委托贷款发放日期
		var repayDate = dateType.get("deadlineDate").val();//到期日期
		var repayType = selectType.get("repayType").val();//还款方式
		//var repayType = $("input[name='repayType']").val();
		var loanMoney = moneyType.get("money").val();//金额
		var planId = $("#planId").val();
		/* var params = "loanRate=" + rateType.get("loanRate").val() +"&loanDate=" + data.loanDate + "&repayDate=" + data.repayDate
        + "&repayType=" + data.repayType + "&loanMoney=" + data.loanMoney + "&planId=" + $("#planId").val(); */
		if(isEmpty(loanRate)){
			parent.layer.msg(bt.lang("cms.precative.rate.not.null"), {icon: 2});
			return false;
		}
		if(isEmpty(loanDate)){
			parent.layer.msg(bt.lang("cms.precative.senddate.not.null"), {icon: 2});
			return false;
		}
		if(isEmpty(repayDate)){
			parent.layer.msg(bt.lang("cms.precative.deadlinedate.not.null"), {icon: 2});
			return false;
		}
		if(isEmpty(repayType)){
			parent.layer.msg(bt.lang("cms.provide.loaninfo.repaytypeempty"), {icon: 2});
			return false;
		}
		if(isEmpty(loanMoney)){
			parent.layer.msg(bt.lang("cms.provide.loaninfo.plmoneyempty"), {icon: 2});
			return false;
		}
		var params = "billCode=" + loanCode + "&loanRate=" + loanRate +"&loanDate=" + loanDate + "&repayDate=" + repayDate
				+ "&repayType=" + repayType + "&loanMoney=" + loanMoney + "&planId=" + planId+"&rateBase=360";
		if(bt.navtab){
			// 计提计息改造暂时注掉，使用新版计提计息页面
			// bt.navtab.addNavtab(bt.lang('cms.button.repayPlan'), basePath + "/cms/basedata/repaymentschedule/toRepayPlan?" + params);
			bt.navtab.addNavtab(bt.lang('cms.button.repayPlan'), basePath + "/cms/basedata/repaymentschedule/makeRepayPlan?" + params);
		}
	}

	/* 基准利率加载完成后 加载利率周期*/
	function loanRepayCycle(){
		var curId = $("#curId").val();
		var sendDate = $.trim(bt.dateType.init().get("sendDate").val());//借款申请日期
		if(isEmpty(sendDate)){
			startDate = $("#createDate").val();//为空默认录入日期
		}
		var referenceRateType = selectType.get("referenceRateType").val();//基准利率类型
		if(isEmpty(curId)){
			selectType.get("repayCycle").attr("data-url","");
		}else{//本位币
			selectType.get("repayCycle").attr("data-url",basePath+"/cms/loanrate/maintence/querRateMaintence?time="+sendDate+"&curId="+curId+"&baseId="+referenceRateType);
		}
	}


	function checkTime(ele,data){
		var startDate = $("#startDate").val();
		var endDate = $("#endDate").val();
		var sendDate = dateType.get("sendDate").val();
		var deadlineDate = dateType.get("deadlineDate").val();
		if(sendDate !==""){
			if(bt.date.compare( sendDate,startDate ) < 0){//发放日期不能小于开始日期
				dateType.get($(data).attr("data-biz-name")).val("");
				dateType.get($(data).attr("data-biz-name")).render();
				layer.tips(bt.lang("cms.precative.sendate.notless.startdate"), '#'+$(data).attr("data-biz-name"));
				return false;
			}
		}
		if(deadlineDate !==""){
			if(bt.date.compare( endDate , deadlineDate ) > 0){//到期日期应大于等于结束日期
				dateType.get($(data).attr("data-biz-name")).val("");
				dateType.get($(data).attr("data-biz-name")).render();
				layer.tips(bt.lang("cms.precative.enddate.pass.deadlinedate"), '#'+$(data).attr("data-biz-name"));
				return false;
			}
		}
		if(sendDate !=="" && deadlineDate !==""){
			if(sendDate > deadlineDate){//发放日期不能大于到期日期
				dateType.get($(data).attr("data-biz-name")).val("");
				dateType.get($(data).attr("data-biz-name")).render();
				layer.tips(bt.lang("cms.precative.sendate.pass.deadlinedate"), '#'+$(data).attr("data-biz-name"));
				return false;
			}
		}
	}

	//重置还款计划
	function retPayPlan1(){
		if($("#planStatus").val()=="0"){
			$("#planStatus").val(1);
			$("#planId").val('');
		}
	}

	/**判断字符串是否为空*/
	function isEmpty(ms){
		if(typeof(ms) == "undefined" || ms == null || ms == ""){
			return true;
		}
		return false;
	}

	/**
	 * 还款方式选择回调
	 */
	function repayTypeCallBack(data, el) {
		if (data.capitalfrequencytype == "N" && data.interestfrequencytype == "N") {
			$("#makePlanBtn").addClass("layui-disabled");
			$("#makePlanBtn").attr("disabled", "disabled");
			$("#planStatus").val("0")
			$("#planId").val("");
		} else {
			$("#makePlanBtn").removeClass("layui-disabled");
			$("#makePlanBtn").removeAttr("disabled", "disabled");
			$("#planStatus").val("1")
		}
		;
	}
</script>

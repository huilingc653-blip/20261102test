#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
	<ul class="mui-table-view" id="mulTable">
		##在途金额
		<li class="mui-table-view-cell">
			在途金额
        <span class="mui-badge mui-badge-inverted">
			$number.formatNumeric($!{PassageMoney})
        </span>
    	</li>
    	
    	##已还金额
		<li class="mui-table-view-cell">
			已还金额
        <span class="mui-badge mui-badge-inverted">
			$number.formatNumeric($!{repayMoney})
        </span>
    	</li>
    	
    	##展期开始日期
		<li class="mui-table-view-cell">
			#springMessage('cms.precative.deferred.startdate')
        <span class="mui-badge mui-badge-inverted">
			$!date.format('yyyy-MM-dd',$!{deferred.deferredStartDate})
        </span>
    	</li>
    	
    	##展期到期日期
		<li class="mui-table-view-cell">
			#springMessage('table.cmsLoanSend.deferredReplayDate')
        <span class="mui-badge mui-badge-inverted">
			$!date.format('yyyy-MM-dd',$!{deferred.deferredRepayDate})
        </span>
    	</li>
    	
    	##展期期限
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanDeferred.deferredLimt')
        <span class="mui-badge mui-badge-inverted">
			$!{deferred.deferredLimt} $dictTag.get("PrecativeLoanInfo.ternUnit",$!{deferred.ternUnit})
        </span>
    	</li>
    	
    	##展期利率
		<li class="mui-table-view-cell">
			#springMessage('table.fcAcc.delayRate')
        <span class="mui-badge mui-badge-inverted">
			$!{deferred.deferredRate}
        </span>
    	</li>
    	
    	##备注
		<li class="mui-table-view-cell">
			#springMessage('table.btBankAcc.rmk')
        <span class="mui-badge mui-badge-inverted">
			$!{deferred.rmk}
        </span>
    	</li>
    	#if($pageType=='repair')
	    	##展期合同号
			<li class="mui-table-view-cell">
				#springMessage('table.cmsLoanDeferred.contractCode')
	        <span class="mui-badge mui-badge-inverted">
				$!{deferred.contractCode}
	        </span>
	    	</li>
    	#end
	</ul>
	
	<ul class="mui-table-view" id="mulTable">
		<li class="mui-table-view-cell" style="text-align: center;">
	       	<strong>#springMessage('cms.loan.oldInfo')</strong>
	        </span>
	    </li>
	    
		##创建时间
		<li class="mui-table-view-cell">
        	#springMessage('table.cmsLoanInfo.createDate')
        <span class="mui-badge mui-badge-inverted">
           $!date.format('yyyy-MM-dd',$!{precativePage.createDate})
        </span>
    	</li>
    	
    	##委托人
    	<li class="mui-table-view-cell">
      		#springMessage('table.cmsPrecativeLoanInfo.precativeId')
        <span class="mui-badge mui-badge-inverted">
           $!{precativePage.precativeName}
        </span>
    	</li>
    	
    	 ##受托人或者受托行
    	<li class="mui-table-view-cell">
    	#if($!{precativePage.isBank} && $!{precativePage.isBank} == 1)
      		#springMessage('table.cmsPrecativeLoanInfo.precativeId')
      	
        #else
        	#springMessage('table.cmsPrecativeLoanInfo.corpId')
        #end
        <span class="mui-badge mui-badge-inverted">
           $!{precativePage.corpName}
           $!{precativePage.bankName}
        </span>
    	</li>
    	
    	##借款人
    	<li class="mui-table-view-cell">
     		#springMessage('table.cmsPrecativeLoanInfo.loanOpp')
        <span class="mui-badge mui-badge-inverted">
           $!{precativePage.loanOppName}
        </span>
    	</li>
    	
    	##贷款金额
		<li class="mui-table-view-cell">
			#springMessage('table.cmsPrecativeLoanInfo.money')
		<span class="mui-badge mui-badge-inverted">
			$number.formatNumeric($!{precativePage.money})
		</span>
		</li>
		
		##贷款金额大写
		<li class="mui-table-view-cell">
			#springMessage('table.cmsPrecativeLoanInfo.money.upper')
		<span class="mui-badge mui-badge-inverted">
			$!{InfoMoneyUpper}
		</span>
		</li>
		
		##贷款币种
		<li class="mui-table-view-cell">
			#springMessage('table.cmsPrecativeLoanInfo.curId')
		<span class="mui-badge mui-badge-inverted">
			$!{precativePage.curName}
		</span>
		</li>
		
		##期限
		<li class="mui-table-view-cell">
			#springMessage('table.cmsPrecativeLoanInfo.term')
		<span class="mui-badge mui-badge-inverted">
			$!{precativePage.term}$!{precativePage.ternUnitStatus}
		</span>
		</li>
		
		##开始日期
		<li class="mui-table-view-cell">
			#springMessage('table.cmsPrecativeLoanInfo.startDate')
		<span class="mui-badge mui-badge-inverted">
			$!date.format('yyyy-MM-dd',$!{precativePage.startDate})
		</span>
		</li>
		
		##结束日期
		<li class="mui-table-view-cell">
			#springMessage('table.cmsPrecativeLoanInfo.endDate')
		<span class="mui-badge mui-badge-inverted">
			$!date.format('yyyy-MM-dd',$!{precativePage.endDate})
		</span>
		</li>
		
		##手续费率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsPrecativeLoanInfo.poundageRate')
		<span class="mui-badge mui-badge-inverted">
			$rateTag.show($!{precativePage.poundageRate})
		</span>
		</li>
		
		##用途
		<li class="mui-table-view-cell">
			#springMessage('table.cmsPrecativeLoanInfo.purpose')
		<span class="mui-badge mui-badge-inverted">
			$!{precativePage.purpose} 
		</span>
		</li>
		
		##备注
		<li class="mui-table-view-cell">
			#springMessage('table.cmsPrecativeLoanInfo.rmk')
		<textarea rows="3" class="layui-textarea" readonly="readonly">
			$!{precativePage.rmk}
		</textarea>
		</li>
	    	
    	##贷款合同编号
		<li class="mui-table-view-cell">
        	#springMessage('table.cmsPrecativeLoanSend.contractCode')
        <span class="mui-badge mui-badge-inverted">
            $!{precativePage.contractCode}
        </span>
    	</li>
    	
    	##还款方式
		<li class="mui-table-view-cell">
        	#springMessage('table.cmsPrecativeLoanInfo.repayType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("Provide.RepayType",$!{precativePage.repayType}) 
        </span>
    	</li>
    	
    	##计息方式
		<li class="mui-table-view-cell">
        	#springMessage('table.cmsPrecativeLoanInfo.interestWay')
        <span class="mui-badge mui-badge-inverted">
           $dictTag.get("Admin.PredrawSign",$!{precativePage.interestWay})
        </span>
    	</li>
    	
    	##贷款发放方式
		<li class="mui-table-view-cell">
        	#springMessage('table.cmsPrecativeLoanInfo.loanSendOutType')
        <span class="mui-badge mui-badge-inverted">
        	$!{precativePage.sendOutType}
        </span>
    	</li>
    	
    	##跳过贷款发放功能
		<li class="mui-table-view-cell">
        	#springMessage('table.cmsPrecativeLoanInfo.skipLoanSendOut')
        <span class="mui-badge mui-badge-inverted">
			$dictTag.get("sf_yn",$!{precativePage.skipLoanSendOut})
        </span>
    	</li>
    	
    	##浮动方式
		<li class="mui-table-view-cell">
        	#springMessage('table.cmsPrecativeLoanInfo.floatWay')
        <span class="mui-badge mui-badge-inverted">
			$dictTag.get("Cms.FloatWay",$!{precativePage.floatWay})	
        </span>
    	</li>
    	
    	##浮动利率
	    	#if($cmsLoanInfoPage.floatWay!='01')
			<li class="mui-table-view-cell">
	      	#springMessage('cms.loan.floatRate')(#springMessage('table.cmsLoanType.type'))
	        <span class="mui-badge mui-badge-inverted">
				$!{precativePage.baseTypeName}
	        </span>
	    	</li>
	    	<li class="mui-table-view-cell">
	    		#springMessage('cms.loan.floatRate')(#springMessage('table.cmsLoanInfo.ternUnit'))
	    		<span class="mui-badge mui-badge-inverted">
	    			$!{precativePage.periodName}
	    			</span>
	    	</li>
	    	<li class="mui-table-view-cell">
	    	#springMessage('cms.loan.floatRate')(#springMessage('table.cmsLoanInfo.pointsProportionSelect'))
	    		<span class="mui-badge mui-badge-inverted">
	    			$dictTag.get("Cms.PointsProportion",$!{precativePage.pointsProportionSelect})&nbsp;
					$number.formatNumeric($!{precativePage.pointsProportionText})
	    			</span>
	    	</li>
			#end
		
		##利率调整生效日期
		<li class="mui-table-view-cell">
      		#springMessage('table.cmsPrecativeLoanInfo.rateEntriesEffectDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{precativePage.rateEntriesEffectDate})
        </span>
    	</li>
    	
    	##贷款利率
		<li class="mui-table-view-cell">
      		#springMessage('table.cmsPrecativeLoanInfo.rate')
        <span class="mui-badge mui-badge-inverted">
            $rateTag.show($!{precativePage.rate})
        </span>
    	</li>
    	
    	</li>
    	##逾期利率
		<li class="mui-table-view-cell">
      		#springMessage('table.cmsLoanSend.overdueRate')
        <span class="mui-badge mui-badge-inverted">
            $rateTag.show($!{precativePage.overdueRate})
        </span>
    	</li>
	</ul>
	#parse("views/common/wapfooter.vm")
</body>
</html>

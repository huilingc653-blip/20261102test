<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 12px;
	text-align: center;
	border-left: 0px;
	border-right: 0px;
	background-color: #d2d2d2;
}
</style>
</head>
<body>
<!-- <div>
	<h2 class="layui-colla-title voucher-title">录入信息</h2>
</div> -->
<form class="layui-form">
	<input type="hidden" id="type" value="$!{type}">
	<input type="hidden"  name="id" value="$!{precativePage.id}">
	<input type="hidden"  name="billCode" id="billCode" value="$!{precativePage.billCode}">
	<input id="endorseItem" name="endorseItem" type="hidden" value="$!{endorseItem}">
	<input id="defItemCode" name="defItemCode" type="hidden" value="">
	<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
	<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
    <input id="curId"  type="hidden" value="$!{precativePage.curId}">
	<input id="dataType" type="hidden" value="$!{dataType}">
	<input id="loanOpp" type="hidden" value="$!{precativePage.loanOpp}">
    <table class="layui-table">
        <tbody>
         <tr class="dark-table-header">
       		 	##录入信息
				<td colspan="4" class="voucher-title">#springMessage('table.cmsPrecativeLoanInfo.info')</td>
			</tr>
        	<tr>
                <td colspan="4" style="text-align: center;">
                	##录入日期
                	<label>#springMessage('table.fcAccbookHis.enrolTime')</label>
                    <div class="layui-input-inline" style="padding-bottom: 4px;">
                       	##<input type="text" name="createDate"  autocomplete="off" class="layui-input" value="$!{precativePage.createDate}" readonly="readonly">
						$!date.format('yyyy-MM-dd',$!{opDate})
						  <input type="hidden" name="createDate"  autocomplete="off" class="layui-input" value="$!date.format('yyyy-MM-dd',$!{opDate})" readonly="readonly">
                    </div>
                </td>
            </tr>
            <tr>
                ##委托人
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.precativeId')</td>
                <td width="36%">
                    <div class="layui-input-inline">
                       <span>$!{precativePage.precativeName}</span>
					   <input type="hidden" id="precativeId" value="$!{precativePage.precativeId}" name="precativeId">
                    </div>
                </td>
                ##受托人或者受托行
                #if($!{precativePage.isBank} && $!{precativePage.isBank} == 1)
                	<td class="textRight" id="isBankName">#springMessage('table.cmsPrecativeLoanInfo.bankCode')</td>
                    <td width="36%">
                        <span>$!{precativePage.bankName}</span>
                    </td>
                #else
                	<td class="textRight" id="isBankName">#springMessage('table.cmsPrecativeLoanInfo.corpId')</td>
                    <td width="36%">
                        <span>$!{precativePage.corpName}</span>
                    </td>
                #end
            <tr>
                ##借款人
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</td>
                <td >
                    <span>$!{precativePage.loanOppName}</span>
					 ##借款人值

                </td>
                <td></td>
                <td></td>
                 ##委托申请单号
                <!-- <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</td>
                <td >
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp" data-biz-type="corp"data-type="selectTree"data-name="loanOpp"data-scope="all"></div>
                    </div>

                </td> -->
             </tr>
             <tr>
              	##贷款金额
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.money')</td>
                <td >
               		$number.formatNumeric($!{precativePage.money})
					<!-- <div style="display: none;">
                       <input type="text" data-name="money" class="layui-input bt-biz-moneyType" data-decimal="2" data-minus="true" value="$!{precativePage.money}">
                    </div> -->
                </td>
             	##贷款金额大写
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.money.upper')</td>
                <td >
                    <!-- <div class="layui-input-inline">
                       ##<input type="text" name="money"  id="money" class="layui-input">
                       <div class="layui-input-inline layui-input" id="dx"></div>
                    </div> -->
                    $!{InfoMoneyUpper}
                </td>

             </tr>
            <tr>
                ##贷款币种
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.curId')</td>
                <td >
                    <span>$!{precativePage.curName}</span>
                </td>
                ##期限
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.term')</td>
                <td >
					<span>
						$!{precativePage.term}$dictTag.get("PrecativeLoanInfo.ternUnit",$!{precativePage.ternUnit})
					</span>
                </td>
             <tr>
                ##开始日期
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.startDate')</td>
                <td >
                    <div class="layui-inline">
                        ##<input type="text" name="startDate" data-biz-name="startDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="t2" lay-verify="required"  value="$!{precativePage.startDate}" readonly="readonly">
                    	$!date.format('yyyy-MM-dd',$!{precativePage.startDate})
						 <input type="hidden" name="startDate"  id="" value="$!date.format('yyyy-MM-dd',$!{precativePage.startDate})" readonly="readonly">
                    </div>
                </td>
                ##结束日期
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.endDate')</td>
                <td >
                    <div class="layui-inline">
						##<input type="text" name="endDate" data-biz-name="endDate" class="layui-input bt-input-inline bt-biz-dateType" id="t2" lay-verify="required" value="$!{precativePage.endDate}" readonly="readonly">
                    	$!date.format('yyyy-MM-dd',$!{precativePage.endDate})
                    </div>
                </td>
            <tr>
                ##手续费率
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.poundageRate')</td>
                <td>
                    $rateTag.show($!{precativePage.poundageRate})
                </td>
                ##用途
            	<td class="textRight" >#springMessage('table.cmsPrecativeLoanInfo.purpose')</td>
                <td colspan="3">
					<span>$!{precativePage.purpose}</span>
                </td>

            </tr>
           <!--  <tr>
            	##担保方式
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.plType'):</td>
                <td >
                    <span>$!{precativePage.plName}</span>
                </td>
            </tr>
            <tr>
                ##担保说明
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.suretyExplain'):</td>
                <td colspan="3">
						<span>$!{precativePage.suretyExplain}</span>
                </td>
            </tr> -->
            <tr>
                ##备注
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.rmk')</td>
				<td colspan="3">
						<textarea style="min-height:70px"
							    class="layui-textarea" readonly="readonly">$!{precativePage.rmk}</textarea>
				</td>
            </tr>
            #if($!{precativePage.refuseWhy})
            <tr>
				<td class="textRight" >#springMessage('table.cmsPrecativeLoanInfo.refuseWhy')</td>
           		<td>$!{precativePage.refuseWhy}</td>
           		<td></td>
           		<td></td>
            </tr>
			#end
			#if($!{precativePage.contractCode})
				<tr class="dark-table-header">
       			##补录信息(办理成功)
				<td colspan="4" class="voucher-title">#springMessage('table.cmsPrecativeLoanInfo.repair.success')</td>
			</tr>
        	<tr>
	        	##合同编号
	            <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.contractCode')</td>
	            <td width="30%">
	            $!{precativePage.contractCode}
	            </td>
	            <td></td>
	            <td></td>
            </tr>
            <tr>
	        	##还款方式
				<td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.repayType')</td>
				<td >
				    $!{precativePage.repayTypeName}
				</td>
				##计息方式
				<td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.interestWay')</td>
				<td >
					$dictTag.get("Admin.PredrawSign",$!{precativePage.interestWay})
				</td>
            </tr>
            <tr>
	        	##贷款发放方式
				<td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.loanSendOutType')</td>
				<td >
                    $dictTag.get("cms.loan.loanSendOutType", $!{precativePage.loanSendOutType})
				 </td>
				 #if($!{precativePage.loanSendOutType}==1)
				##跳过贷款发放功能
				<td class="textRight" id="skipLoanText">#springMessage('table.cmsPrecativeLoanInfo.skipLoanSendOut')</td>
				<td>
				   $dictTag.get("sf_yn",$!{precativePage.skipLoanSendOut})
				</td>
				#end
            </tr>
            <tr>
        		##浮动方式
				<td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.floatWay')</td>
				<td >
					$dictTag.get("Cms.FloatWay",$!{precativePage.floatWay})
				</td>
        		##利率调整生效日期
				<td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.rateEntriesEffectDate')</td>
				<td >
                   $!date.format('yyyy-MM-dd', $!precativePage.rateEntriesEffectDate)
				</td>
			</tr>
            <tr>
        		##浮动利率
				<td class="textRight" rowspan="2">#springMessage('table.cmsProvideLoanInfo.floatRate')</td>
				<td rowspan="2">
					<div class="layui-inline" >
						<div style="padding-bottom: 10px;padding-top: 10px;" >
							##基准利率类型
							$!{precativePage.baseTypeName}
						</div>

						<div style="padding-bottom: 10px;padding-top: 10px;" >
							$!{precativePage.periodName}
							</div>
						</div>
						<div style="padding-bottom: 10px;padding-top: 10px;">
							##点数或者浮动比例选择与文本
							<div class="layui-input-inline">
							      $dictTag.get("Cms.PointsProportion",$!{precativePage.pointsProportionSelect})
							</div>
						<div class="layui-input-inline">
							##<input class="layui-input" id="pointsProportionText" name="pointsProportionText" value="$!{precativePage.pointsProportionText}" disabled="disabled">
							##<input class="layui-input bt-biz-moneyType" id="pointsProportionText" name="pointsProportionText" data-biz-name="pointsProportionText" value="0" data-decimal="2" data-max="100" data-min="0" disabled="disabled">
								#if($!{precativePage.pointsProportionSelect} == '01')
									#if($!{precativePage.pointsProportionText})
										$number.formatNumeric($!{precativePage.pointsProportionText})BP
									#else
                                        0.00BP
									#end
								#elseif($!{precativePage.pointsProportionSelect} == '02')
									#if($!{precativePage.pointsProportionText})
										$number.formatNumeric($!{precativePage.pointsProportionText})%
									#else
                                        0.00%
									#end
								#end


						</div>
						</div>
					</div>
				</td>
				<td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.rate')</td>
				<td>
					##取贷款利率
					<div style="display: inline-block;">
					 $rateTag.show($!{precativePage.rate})
				</td>
			</tr>
			<tr>
				##逾期利率
				<td class="textRight">
					#springMessage('table.cmsLoanSend.overdueRate')
				</td>
				<td>
				   $rateTag.show($!{precativePage.overdueRate})
				</td>
			</tr>
			#end
		</tbody>
  	</table>
	   #if($!{processSysname} && ${status} != "21")
	<!-- 资金计划 -->
		<div id="tagItemDetail"></div>
	   #end
	   <table class="layui-table border0">

	    #if($!{opType} == "view")
            <tr>
            	<td colspan="9" align="center">
	       			<button class="layui-btn"  onClick="doClose()" type="button">#springMessage('common.button.close')</button>
       			</td>
            </tr>
            #end
	   </table>
</form>
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','datatable','btdate','corp','moneyType','rateType','dateType','selectType','date','dicts'], function(){
    $ = bt.jquery,form = bt.form();
    bt.corp.init();
    moneyType = bt.moneyType.init();
   	tt = bt.selectType.init();
    rateTye = bt.rateType.init();
    dateType = bt.dateType.init();
    bt.dicts.init();
	$(document).ready(function(){
		var precativeId = $("#precativeId").val();
		corpCallback(precativeId);
	})
 	//关闭窗口
    doClose = function(){
    	if(bt.navtab){
			bt.navtab.closeCurrent();
		}
		parent.layer.closeAll();
		return false
    }



});

//借款人回调函数
function corpCallback(data){
	isBudget(data,"3000");
}


//根据单位ID和业务类型判断是否挂预算
function isBudget(corpId,briefId){
	$.ajax({
		type:'POST',
		url:basePath+"/cms/precative/loaninfo/isBudget",
		data:{'corpId':corpId,'briefId':briefId},
		async:false,//是否异步
		dataType:'json',
		success:function(result){
			if(result.success){
				if(result.attributes.isBudget){
					genOtherHtml(corpId);
					return true;
				}else{
					$("#tagItemDetail").html("");
					return false;
				}
			}else{
				parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
			}
		}

	})
}

//生成资金计划的表格
genOtherHtml=function(corpId){
    var itemCode = $('input[name="endorseItem"]').val();
    var defItemCode = $('input[name="defItemCode"]').val();
    var processDate = $('input[name="startDate"]').val();
    var dataType=$("#dataType").val();
    var curId=$("#curId").val();;
    if(dataType=="repair"){//已补录的数据挂接借款方的资金计划
		corpId=$("#loanOpp").val();
	}
    var url=basePath+"/budget/fbsBudgetProcess/getViewItemDetail";
    var param={
        corpId:corpId,
        itemCode:itemCode,
        defItemCode:defItemCode,
        processDate:processDate,
		billNo:$("#billCode").val(),
		businessName: $("#businessName").val(),
        processSysname: $("#processSysname").val(),
        curId:curId,
        type:'select',
        date:(new Date()).getTime()
    };
    $.ajax({url:url,method: 'POST',data: param,async:true, success: function (json) {
    	  $("#tagItemDetail").html("");
         $("#tagItemDetail").html(json);

        }
    });
};

// 执行回调，控制高度
function fbsItemTableInitCallback(){
        var bodyHeight = $('body').height();
		$(parent.document).find('#sendIframe').height(bodyHeight);
}



</script>
</html>

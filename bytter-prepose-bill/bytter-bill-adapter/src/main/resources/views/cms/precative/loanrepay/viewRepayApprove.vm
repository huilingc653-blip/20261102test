<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 12px;
	text-align: center;
	border-left: 0px;
	border-right: 0px;
	background-color: #d2d2d2;
}

</style>
</head>
<body id="body">
<input type="hidden" id="billCodes" name="billCodes" value="$!{repayVo.billCode}">
<input type="hidden" id="types" name="types" value="$!{types}">
<div id="viewRepay" class="viewRepay"> </div>

#workFlowHtml()
#parse("views/common/footer.vm")
#workFlowScript()

</body>
<script>
bt.use(['form','datatable','btdate','corp','moneyType','rateType','dateType','selectType','date','dicts'], function(){
    $ = bt.jquery,form = bt.form();
    bt.corp.init();
    moneyType = bt.moneyType.init();
    tt = bt.selectType.init();
    rateTye = bt.rateType.init();
    dateType = bt.dateType.init();
    bt.dicts.init();
});

window.onload = function () {

	var url=basePath+"/cms/precative/loanrepay/viewRepay";
	param={
	  billCode:$("#billCodes").val(),
	  type:$("#types").val()
	}
	 $.ajax({
	 url:url,
	 method:'POST',
	 data:param,
	 async:true,
	 success:function(json){
	    	$("#viewRepay").html("");
			$("#viewRepay").html(json);
	  		}
	});
};


</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>

<body>
	<form action="" id="searchForm" class=layui-form>
		<table class="layui-table ">
		<input type="hidden" id="pageType" value="$!{pageType}">
		<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
			<input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
			<tbody>
				<tr>
					##借款编号
					<td  class="textRight" width="25%">#springMessage('table.cmsProvideLoanInfo.billCode')</td>
					<td width="25%"><input type="text" class="layui-input" name="likes_billCode" /></td>
				<tr>


				<tr>

					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>

				</tr>



			</tbody>
		</table>
	</form>


	<table id="appTable" class="layui-table layui-form"
		style="width: 100%;">
		<thead>
			<tr>
				<th>#springMessage('table.cmsLoanDeferred.billCode')</th>
				<th>#springMessage('table.cmsPrecativeLoanRepay.sendCode')</th>
				<th>#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</th>
				<!-- <th>#springMessage('table.bvStorageBox.createDate')</th> -->
				<th>#springMessage('table.cmsPrecativeLoanDeferred.matureDate')</th>
				<th>#springMessage('table.fcAcc.delayDeadlineDate')</th>
				<th>#springMessage('table.cmsPrecativeLoanDeferred.contractCode')</th>
				<th>#springMessage('common.table.thead.operation')</th>
			</tr>
		</thead>
	</table>

		#workFlowHtml()
		#parse("views/common/footer.vm")
		#workFlowScript()
##<script src="${basePath}/static/modules/cms/provide/cmsProvideDeferredApprove.list.js?_btv=${resourceVersion}"></script>

<script>
bt.use(['form','datatable','dateType','moneyType','corp'], function(){
    $ = bt.jquery,form = bt.form();
    //时间
    bt.dateType.init();
    bt.corp.init();

    //生成列表
    datatable = bt.datatable.init({
        elem: "#appTable",
        dom: 'rtlip',
        colReorder: true,
        checkbox:true,order: [1,'desc'],
        ajax: {
            'url': basePath+"/cms/precative/precativeloandeferred/dataTableRepairApprove"
        },
        searchForm:{
            formElem:"#searchForm",
            formFilter:"search"
        },
        columns: [
            {data:"billCode",className:'center',bSortable:false},
          	{data:"liCode",className:'center',bSortable:false},
           	{data:"loanOppName",className:'center',bSortable:false},
            /* {data:"createDate",className:'center',bSortable:false}, */
            {data:"matureDate",className:'center',bSortable:false},
           	{data:"deferredRepayDate",className:'center',bSortable:false},
           	{data:"contractCode",className:'center',bSortable:false},
            {data:null,bSortable:false,className:'center',render: function (data, type, full, meta) {
            	var html='';
            	if($("#flowStatus").val()=='todo'){
            		html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
            	}
				if($("#flowStatus").val() == 'pass'){
					html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a><span class="text-explode">|</span>';
					html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
				}else {
					html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
				}
                return html;
            }}
        ]
    });
});

/*审核*/
function approve(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    if(bt.navtab){
	bt.navtab.addNavtab(bt.lang('common.button.approve') ,basePath + "/cms/precative/precativeloandeferred/approve?businessId=" + data.liCode + "&taskId=" + data.taskId + "&repairType=" + "repair"+ "&billCode=" + data.billCode);
	return;
    }
    parent.layer.open({
	type: 2,
	area: ['850px', '530px'],
	maxmin: true,
	content: basePath + "/cms/precative/precativeloandeferred/approve?businessId=" + data.liCode + "&taskId=" + data.taskId+ "&billCode=" + data.billCode
    });
}

function view(el){
	var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
	if(bt.navtab){
		bt.navtab.addNavtab(bt.lang('common.button.view'),basePath + "/cms/precative/precativeloandeferred/view?sendBillCode=" + data.sendNo);
		return;
	}
	parent.layer.open({
		type: 2,
		area: ['850px', '530px'],
		maxmin: true,
		content: basePath + "/cms/precative/precativeloandeferred/view?sendBillCode=" + data.sendNo
	});
}
</script>
</body>

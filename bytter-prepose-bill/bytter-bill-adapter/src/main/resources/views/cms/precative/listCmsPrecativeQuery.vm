	/* $.ajax({ 
	      type: 'POST',
	      url: basePath+"/cms/precative/precativeQuery/changePrecative", 
	      data:{'ids':data} ,
	      async: false, 
	      dataType:'json',
	      success: function(result){
	    	  console.log(result.attributes.loanOpps);
	    	  //corps.get("loanOpp").setUrl({"data-filterdata":result.attributes.loanOpps});
	    	  //corps.get("loanOpp").render();
	      }
	}); */
}
</script>
</html>

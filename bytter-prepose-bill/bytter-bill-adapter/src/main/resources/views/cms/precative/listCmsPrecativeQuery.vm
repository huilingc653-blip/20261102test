			        <th>#springMessage('table.cmsLoanSend.loanMoney')</th>##发放金额
			        <th>#springMessage('table.cmsProvideLoanRepay.moneyFinish')</th><!-- 已还款本金-->
			        <th>#springMessage('table.cmsProvideLoanRepay.moneyPassage')</th>##  还款在途本金
			        <th>#springMessage('table.cmsLoanSend.deferredNum')</th>##展期次数
			        <!-- <th>#springMessage('table.cmsPrecative.outstandingAmount')</th>##未还金额 -->
			     <!--    <th>担保方式</th> -->
			        <th>#springMessage('table.cmsLoanInfo.status')</th>##状态
			        <th>#springMessage('common.table.thead.operation')</th>##操作
    			</tr>
			</thead>
		</table>
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','datatable','btdate','corp','moneyType','select','rateType','dateType','selectType','date','selectTree'], function(){
    $ = bt.jquery,form = bt.form();
    corps = bt.corp.init();
    moneyType = bt.moneyType.init();
    moneyFun = bt.moneyType.getFun();
    bt.dateType.init();
    
    //初始化委托人
	bt.selectTree.init({
		url:basePath+"/cms/precative/precativeQuery/getCorps",
		elem:".precativeTree",
		name: "ins_precativeId",
		checkType:'check',
		setting:{
            data:{
                simpleData: {
                	pIdKey: "parentId"
                }
            },
            check : {
            	chkboxType: { "Y": "s", "N": "s" }
            }
        },
        beforeInit:function(nodes){
            for(k in nodes){
                nodes[k].name = "(" + nodes[k].code + ")" + nodes[k].name;
            }   
            return nodes;
        }
	});
    
	 //初始化委托人
	bt.selectTree.init({
		url:basePath+"/cms/precative/precativeQuery/getCorps",
		elem:".loanOppTree",
		name: "ins_loanOpp",
		checkType:'check',
		setting:{
            data:{
                simpleData: {
                	pIdKey: "parentId"
                }
            },
            check : {
            	chkboxType: { "Y": "s", "N": "s" }
            }
        },
        beforeInit:function(nodes){
            for(k in nodes){
                nodes[k].name = "(" + nodes[k].code + ")" + nodes[k].name;
            }   
            return nodes;
        }
	});
	
	form.render("select");
  	//生成列表
    datatable = bt.datatable.init({
    	elem: "#appTable",
        dom: 'Brtlip',
        colReorder: true,
        fixedColumns: {
            leftColumns:1,//代表冻结左边两列
            rightColumns:1//代表冻结右边一列
        },
        //order:[3,'desc'],
        rowsGroup:[0,3,5,6,9],
        ajax: {
            'url': basePath+"/cms/precative/precativeQuery/dataTable"
        },searchForm:{
            formFilter:"search",
            formElem:"#searchForm"
        },
        buttons: [
            {
                extend: "colvis",
                text: bt.lang('common.button.theadHide'),
                columns: ':not(:first):not(:last)'
            }
		],
        columns: [
           /* {data:"sendBillCode",bSortable:false,className:"center"}, */
            {data:"infoBillCode",bSortable:true,className:"center"},
            {data:"precativeName",bSortable:false,className:"center"},
            {data:"loanOpp",bSortable:false,className:"center",
            	render: function (data, type, full, meta) {
            		return full.loanOppName;
            	}	
            },
            {data:"infoContractCode",bSortable:true,className:"center"},
            {data:"sendContractCode",bSortable:false,className:"center"},
            {data:"startDate",bSortable:true,className:"center"},
            {data:"endDate",bSortable:true,className:"center"},
            {data:"sendDate",bSortable:false,className:"center"},
            {data:"deadlineDate",bSortable:false,className:"center"},
            /* {data:"term",bSortable:false,className:"center",
            	render : function( data , type , full , meta ){
            		var term = full.term + full.ternUnitStatus;
            		return term;
            	}	
            },
            {data:"rate",bSortable:false,className:"center"},
            {data:"curName",bSortable:false,className:"center"}, */
            {data:"infoMoney",bSortable:true,className:"textRight",
            	render: function (data, type, full, meta) {
            		return moneyFun.format(full.infoMoney);
            	}
            },
            {data:"sendMoney",bSortable:false,className:"textRight",
            	render: function (data, type, full, meta) {
            		//return moneyFun.format(full.sendMoney);
            		return '<a class="" href="#" data-row="'+meta.row+'" onclick="sendList(this)"><u>'+ moneyFun.format(full.sendMoney) +'</u></a>';
            	}
            },
            {data:"repayMoney",bSortable:false,className:"textRight",
            	render: function ( data, type, full, meta ) {
	        		if(full.repayMoney > 0){
	        			return '<a class="" href="#" data-row="'+meta.row+'" onclick="repayList(this)"><u>'+ moneyFun.format(full.repayMoney) +'</u></a>';
	        		}else{
	        			return moneyFun.format(full.repayMoney) ;
	        		}
            	}
            },
            {data:"passageMoney",bSortable:false,className:"textRight",
            	render: function ( data, type, full, meta ) {
	        		if(full.passageMoney > 0){
	        			return '<a class="" href="#" data-row="'+meta.row+'" onclick="passageList(this)"><u>'+ moneyFun.format(full.passageMoney) +'</u></a>';
	        		}else{
	        			return  moneyFun.format(full.passageMoney) ;
	        		}
            		//return  moneyFun.format(full.passageMoney) ;
            	}
            },
            {data:"counts",bSortable:false,className:"textRight",
            	render: function (data, type, full, meta) {
            		if(full.counts > 0){
	        			return '<a class="" href="#" data-row="'+meta.row+'" onclick="sendInfolist(this)"><u>'+ full.counts +'</u></a>';
	        		}else{
	        			return  full.counts ;
	        		}
            	}
            },
          /*   {data:"plName",bSortable:false,className:"textRight"}, */
            {data:"bizStatus",bSortable:false,className:"center",
            	render : function(data,type,full,meta){
            		return bt.dict("cms.bizStatus",full.status);
            	}
            },
            {data:null,bSortable:false,className:'center',
            	render: function (data, type, full, meta) {
                	var html ="";
                	html += '<a class="" href="#" data-row="'+meta.row+'" onclick="sendList(this)">'+bt.lang("common.button.view")+'</a>'
                	html += '<span class="text-explode">|</span><a class="" href="#" data-row="'+meta.row+'" onclick="listMsg(this)">'+bt.lang("common.button.logInfo")+'</a>';
                    if(!bt.empty(full.conId) && $('#relateCon').val()=='1'){
                        html += '<span class="text-explode">|</span><a  href="#" data-row="'+meta.row+'" onclick="conView(this)">'+bt.lang("common.button.conInfo")+'</a>';
                    }
                	return html;
            	}
            },
        ],
        summary:{
            pageSum: true,//小计功能开启
            selectSum: false,//已选汇总功能开启
            //groupColumn: 'curName',//分类汇总列参数
            format: {
                decimal: 2
            },
            sumList: [
                {
                    colNum: '10', //汇总列序号
                    dataName: 'infoMoney' //汇总列贷款金额
                },
                {
                    colNum: '11', //汇总列序号
                    dataName: 'sendMoney' //汇总列发放金额
                },
				{
				    colNum: '12', //汇总列序号
					dataName: 'repayMoney' //汇总列已还金额
				},
				{
				    colNum: '13', //汇总列序号
					dataName: 'passageMoney' //汇总还款在途金额
				}
            ]
        }
    });
});

//作废
function del(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    parent.layer.confirm("#springMessage('confirm.delete.this.record')",function(){
        $.post(basePath + "/cms/precative/loaninfo/delete/" + data.id, function(result){
            location.reload();
            parent.layer.alert(result.msg, {icon: result.success?1:2});
        },'JSON');
    });
}

//查询send列表
function sendList(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
 //   var url = "/cms/precative/loanrepay/view?view&billCode=" + data.sendBillCode ;
  //  if(data.sendBillCode == null){
    	url = "/cms/precative/loaninfo/view?billCode=" + data.infoBillCode + "&type=view"+"&sendCode=" + data.sendBillCode ;
 //   }
    if(bt.navtab){
        bt.navtab.addNavtab(bt.lang('common.button.view'),basePath + url);
        return;
    }
    parent.layer.open({
        type: 2,
        area: ['950px', '630px'],
        maxmin: true,
        content: basePath + url
    });
}

//查询归还列表
function repayList(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    parent.layer.open({
        type: 2,
        area: ['950px', '630px'],
        maxmin: true,
        content: basePath + "/cms/precative/precativeQuery/repayList/" + data.sendBillCode 
    });
}

//查询在途列表
function passageList(el){
	var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    parent.layer.open({
        type: 2,
        area: ['950px', '630px'],
        maxmin: true,
        content: basePath + "/cms/precative/precativeQuery/passageList/" + data.sendBillCode 
    });
}

//日志列表
function listMsg(el){
	var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
	if(data){
		var billCode = "";
		if(data.sendBillCode!=null){
			billCode += data.infoBillCode+","+data.sendBillCode
    	}else{
    		billCode += data.infoBillCode;
    	}
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.logInfo'),basePath + "/cms/basedata/cmsprocessmsg/list?billCode=" + billCode);
            return;
        }
	}
}

//展期次数
function sendInfolist(el){
	var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
	if(data.sendBillCode){
		if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'),basePath+"/cms/precative/precativeloandeferred/deferredInfolist?liCode="+data.sendBillCode);
            return;
        }
	}
}

/**
 * 查看合同信息
 * @param el
 */
function conView(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    var conId = data.conId;
    parent.layer.open({
        type: 2,
        area: ['1080px', '720px'],
        maxmin: true,
        content: basePath + "/contract/conCommon/conView?id=" + conId
    });
}

/**判断字符串是否为空*/
bt.empty = function(ms){
    if(typeof(ms) == "undefined" || ms == null || ms == "" || ms == " "){
        return true;
    }
    return false;
}


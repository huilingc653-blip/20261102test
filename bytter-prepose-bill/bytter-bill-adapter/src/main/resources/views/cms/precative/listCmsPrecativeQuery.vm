</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
				<tr>
			       <!--  <th>单据编号</th>
			        <th>委托贷款发放单号</th> -->
			        <th>#springMessage('cms.precative.info.billCode')</th>##合同编号
			        <th>#springMessage('table.cmsPrecativeLoanInfo.precativeId')</th>##委托方
			        <th>#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</th>##借款人
			        <th>#springMessage('table.cmsPrecativeLoanInfo.contractCode')</th>##合同编号
			        <th>#springMessage('table.cmsPrecativeLoanSend.contractCode')</th> ##发放编码
			      <!--   <th>开始日期</th>
			        <th>结束日期</th> -->
			        <th>#springMessage('table.cmsPrecativeLoanInfo.startDate')</th>##开始日期
			        <th>#springMessage('table.cmsPrecativeLoanInfo.endDate')</th>##结束日期
			        <th>#springMessage('table.cmsPrecativeLoanSend.sendDate')</th>##发放日期
			        <th>#springMessage('table.cmsPrecativeLoanSend.deadlineDate')</th>##到期日期

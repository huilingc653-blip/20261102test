                    <input type="text" data-name="geg_infoMoney" class="layui-input bt-input-inline  bt-biz-moneyType" data-moneyendid="money">
       				<span class="date-mid">~</span>
        			<input type="text" data-name="leg_infoMoney" class="layui-input bt-input-inline  bt-biz-moneyType" id="money">
           		</td>
           		<td></td>
           		<td></td>
           		##状态
           		<!-- <td style="text-align:right;">状态：</td>
        		<td width="40%" style="text-align:left;">
                      <input class="layui-input">
           		</td> -->
        	</tr>
        	<tr>
        		##开始日期
        		<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.startDate')</td>
        		<td width="40%" style="text-align:left;">
                    <input type="text" name="ged_startDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="startDate">

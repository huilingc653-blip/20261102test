<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
<input type="hidden" id="pageType" value="$!{pageType}">
		<table class="layui-table">
		<tr>
			<td width="10%" class="textRight">#springMessage('table.cmsPrecativeLoanInfo.billCode')</td>
			<td width="20%">
				<input type="text" name="likes_infoBillCode" class="layui-input" ">
			</td>
			<td width="70%">
				<button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
				<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
			</td>
		</tr>
		</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('table.cmsPrecativeLoanInfo.billCode')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</th><!--借款方-->
        <th>#springMessage('table.cmsPrecativeLoanInfo.curId')</th><!--币别  -->
        <th>#springMessage('table.cmsLoanSend.loanMoney')</th><!-- 贷款金额 -->
        <th>#springMessage('table.cmsLoanRepay.repayMoney')</th><!-- 还款金额 -->
        <th>#springMessage('table.cmsLoanRepay.repayAccrual')</th><!-- 还款利息 -->
        <th>#springMessage('cms.common.deadlineDate')</th><!--合同到期日  -->
        <th>#springMessage('table.cmsLoanSend.repayType')</th><!--还款方式  -->
        <th>#springMessage('table.cmsLoanRepay.status')</th><!-- 状态 -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','datatable','moneyType'], function(){
    $ = bt.jquery,form = bt.form(),moneyFun = bt.moneyType.getFun();
    //生成列表
    datatable = bt.datatable.init({
        elem: "#appTable",
        dom: 'Brtlip',
        colReorder: true,
        order: [2,'desc'],
        ajax: {
            'url': basePath+"/cms/precative/loanrepay/interetAffirm"
        },
        searchForm:{
            formElem:"#searchForm",
            formFilter:"search"
        },
        buttons: [
            {
                extend: "colvis",
                text: bt.lang('common.button.theadHide'),
                columns: ':not(:first):not(:last)'
            } 
              ],
        columns: [
			{data:"infoBillCode",className:'center',bSortable:false},
            {data:"loanOppName",className:'center',bSortable:false},
            {data:"curName",className:'center',bSortable:false},
            {data:"sendMoney",className:'textRight',bSortable:true,
            	render: function ( data, type, full, meta ) {
                    return moneyFun.format(full.sendMoney);
                }	
            },
            {data:"repayMoney",className:'textRight',bSortable:true,
            	render: function ( data, type, full, meta ) {
                    return moneyFun.format(full.repayMoney);
                }	
            },
            {data:"repayAccrual",className:'textRight',bSortable:true,
            	render: function ( data, type, full, meta ) {
                    return moneyFun.format(full.repayAccrual);
                }	
            },
            {data:"repayDate",className:'center',bSortable:true},
            {data:"repaywayName",className:'center',bSortable:false},
            {data:"bizStatus",className:'center',bSortable:false,
            	render: function ( data, type, full, meta ) {
                    return bt.dict("cms.bizStatus",full.bizStatus);
                }
            },
            {data:null,bSortable:false,className:'center',render: function (data, type, full, meta) {
            	var html = '<a class="" href="#" data-row="'+meta.row+'" onclick="view(this)">'+bt.lang("common.button.view")+'</a>\
                <span class="text-explode">|</span><a class="" href="#" data-row="'+meta.row+'" onclick="repayAffirm(this)">'+bt.lang("cms.loan.repayAffirm")+'</a>\
                <span class="text-explode">|</span><a class="" href="#" data-row="'+meta.row+'" onclick="doBack(this)">'+bt.lang("common.button.back")+'</a>\
                <span class="text-explode">|</span><a class="" href="#" data-row="'+meta.row+'" onclick="listMsg(this)">'+bt.lang("common.button.logInfo")+'</a>';
                return html;
            }}
        ],
        summary:{
            pageSum: true,//小计功能开启
            selectSum: false,//已选汇总功能开启
            //groupColumn: 'curName',//分类汇总列参数
            format: {
                decimal: 2
            },
            sumList: [
                {
                    colNum: '4', //汇总列序号
                    dataName: 'sendMoney' //汇总列发放金额
                },
                {
                    colNum: '5', //汇总列序号
                    dataName: 'repayMoney' //汇总列还金额
                }
            ]
        }
    });
});
function view(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    if(data){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'),basePath + "/cms/precative/loanrepay/view?billCode=" + data.billCode + "&type="+"repay" +"&sendCode=" + data.sendCode);
            return;
        }
	    parent.layer.open({
	        type: 2,
	        area: ['850px', '530px'],
	        maxmin: true,
	        content: basePath + "/cms/precative/loanrepay/view?billCode=" + data.billCode + "&type="+"repay"
	    });
    }       
}
function repayAffirm(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    if(data){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang("cms.loan.repayAffirm"),basePath + "/cms/precative/loanrepay/repayAffirm?id=" + data.id + "&sign=2");
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/loan/cmsloanrepay/repayAffirm?id=" + data.id,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }
}
//利息确认打回
function doBack(el){
	var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
	parent.layer.confirm(bt.lang('common.message.confirm.repulse'),function(){
        $.post(basePath + "/cms/precative/loanrepay/back/" + data.id, function(result){
            parent.layer.alert(result.msg, {icon: result.success?1:2});
            if(result.success){
                	bt.navtab.refreshCurrent();
            }
        },'JSON');
    });
}
//日志列表
function listMsg(el){
	var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
	if(data){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.logInfo'),basePath + "/cms/basedata/cmsprocessmsg/list?billCode=" + data.billCode);
            return;
        }
	}
}
</script>
</html>
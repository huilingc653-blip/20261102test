<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	<input id="id" name="id" type="hidden" value="$!{cmsLoanRepayPage.id}">
	<table class="layui-table">
		<colgroup>
	  		<col width="15%">
	  		<col width="35%">
	  		<col width="15%">
	  		<col width="35%">
       	</colgroup>
		<tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label>#springMessage('table.cmsLoanInfo.createDate')</label>&nbsp;&nbsp;
					<div class="layui-input-inline" style="padding-bottom: 4px;">
						$!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.createDate)
					</div>
				</td>
			</tr>
			<tr>
        		##申请单位
				<td class="textRight">#springMessage('table.cmsLoanInfo.corp')</td>
				<td colspan="3">
					<span>$!{cmsLoanInfoPage.loanOppName}</span>
				</td>
			</tr>
			<tr>
				##贷款单号
				<td class="textRight">#springMessage('table.cmsLoanInfo.billCode')</td>
				<td>
					<span>$!{cmsLoanInfoPage.billCode}</span>
				</td>
				##合同号
				<td class="textRight">#springMessage('table.cmsLoanInfo.contractCode')</td>
				<td>
					<span>$!{cmsLoanInfoPage.contractCode}</span>
				</td>
			</tr>
			<tr>
			##贷款发放编号
				<td class="textRight" >#springMessage('table.cmsLoanSend.billCode')</td>
				<td colspan="3">
					<span>$!{cmsLoanSendPage.billCode}</span>
				</td>
			</tr>
			#if($isAccounting)
			<tr>
				##委贷账号
				<td class="textRight">#springMessage('table.cmsPrecativeLoanSend.loanAcc')</td>
				<td>
					<span>$!{cmsLoanSendPage.loanAcc}</span>
				</td>
				##委存账号
				<td class="textRight">#springMessage('table.cmsPrecativeLoanSend.depositAcc')</td>
				<td >
					<span>$!{cmsLoanSendPage.depositAcc}</span>
				</td>
			</tr>
			#end
			<tr>
				##放款币别
				<td class="textRight">#springMessage('table.cmsLoanInfo.curCode')</td>
				<td >
					<div class="layui-input-inline">
						$!{cmsLoanInfoPage.curName}
					</div>
				</td>
				##放款金额
				<td class="textRight">#springMessage('table.cmsLoanSend.loanMoney')</td>
				<td>
					$number.formatNumeric($!{cmsLoanSendPage.money})
					<input type="hidden" id="loanMoney" value="$!{cmsLoanSendPage.money}">
				</td>
			</tr>
			<tr>
				##还款在途金额
				<td class="textRight">#springMessage('table.cmsLoanRepay.inwayMoney')</td>
				<td >
					$number.formatNumeric($!{inwayMoney})
				</td>
				##已还金额
				<td class="textRight">#springMessage('table.cmsLoanRepay.processMoney')</td>
				<td >
					$number.formatNumeric($!{rpayedMoney})
				</td>
			</tr>
			<tr>
				##贷款发放日期
				<td class="textRight">#springMessage('table.cmsLoanSend.loanDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.sendDate)</td>
				##到期日期
				<td class="textRight">#springMessage('table.cmsPrecativeLoanSend.deadlineDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.deadlineDate)</td>
			</tr>
			<tr>
				##展期到期日期
				<td class="textRight">#springMessage('table.fcAcc.delayDeadlineDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!{cmsLoanSendPage.deferredDate})</td>
				##还款类型
				<td class="textRight">#springMessage('table.cmsLoanRepay.repayType')</td>
				<td>
	##				<div class="bt-biz-dict" data-type="select" data-group="cms.repayType" data-defaultvalue="$!{cmsLoanRepayPage.repayType}" data-name="repayType" data-biz-name="repayType" data-callback="changeRepayType"></div>
					$dictTag.get("cms.repayType",$!{cmsLoanRepayPage.repayType})
					<input type="hidden" id="initRepayType" value="$!{cmsLoanRepayPage.repayType}">
				</td>
			</tr>
			<tr>
				##还款日期
				<td class="textRight">#springMessage('table.cmsLoanRepay.repayDate')</td>
				<td>
					$!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.repayDate)
					<input type="hidden" name="repayDate" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.repayDate)" data-type="date" id="repayDate" data-biz-name="repayDate">
				</td>
				##还款金额
				<td class="textRight">#springMessage('table.cmsLoanRepay.repayMoney')</td>
				<td>
					<div class="layui-inline">
						<span id="repayMoneyShow">
							#if($cmsLoanRepayPage.repayType==4)
								$number.formatNumeric(0)
							#else
								$number.formatNumeric($!{cmsLoanRepayPage.repayMoney})
							#end
						</span>
					</div>
				</td>
			</tr>
			<tr>
				##还款利息
       			<td class="textRight">#springMessage('table.cmsLoanRepay.repayAccrual')</td>
					<td>
						<div class="layui-inline">
							<input type="text" data-name="repayAccrual" class="layui-input bt-biz-moneyType" data-biz-name="repayAccrual" value="$!{cmsLoanRepayPage.repayAccrual}"  placeholder="#springMessage('table.fcInterestDtlTemp.interest')" readonly="readonly">
						</div>
						#if($isAccounting)
							<button  type="button" id="lixqdButton" class="layui-btn layui-btn-small" onClick="showlxqd()" >#springMessage('table.interet.lxqd')</button>
						#end
	##					<span id="curAccrualShow" style="color: red"></span>
						<input type="hidden" id="SyncAccrual" value="">
					</td>
				<td class="textRight">#springMessage('table.cmsLoanSend.repayType')</td>
				<td>
##					$dictTag.get("cms.LoanRepayType",$!cmsLoanSendPage.repayType)
					$!{cmsLoanSendPage.repayTypes}
				</td>
			</tr>
			<tr>
				<td colspan="4" style="text-align: center;">
					<button class="layui-btn" lay-submit="" value="1" lay-filter="submit">#springMessage('common.button.sure')</button>
					<button class="layui-btn" lay-submit="" value="0" lay-filter="submit">#springMessage('common.button.back')</button>
					<button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
				</td>
			</tr>
       	</tbody>
	</table>
	<input type="hidden" id ="sendCode" name="sendCode" value="$!{cmsLoanSendPage.billCode}"><!-- 发放编号 -->
	<input type="hidden" id="repayAccrual2" value="$!{cmsLoanRepayPage.repayAccrual}"><!-- 还款利息 -->
	<input type="hidden" id ="sendId" value="$!{cmsLoanSendPage.id}"><!-- 发放编号 -->
	<input type="hidden" id ="closeDay" value="$!{closeDay}"><!-- 日结日期 -->
	<input type="hidden" id="loanAcc" value="$!{cmsLoanSendPage.loanAcc}"><!-- 贷款账号 -->
	<input type="hidden" id="repayMoney" value="$!{cmsLoanRepayPage.repayMoney}"><!-- 还款金额 -->
	<input type="hidden" id="sendMoney" value="$!{cmsLoanSendPage.money}"><!--发放金额 -->
	<input type="hidden" id="orderNo" value=""><!-- 利息流水号-->
	<input type="hidden" id="repayDate" value="$!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.repayDate)"><!-- 还款日期 -->
	<input type="hidden" id="isAccounting" value="$!{isAccounting}"><!-- 还款日期 -->
</form>
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','layedit','dateType','dicts','moneyType'], function(){
    $ = bt.jquery,form = bt.form();
    moneyFun = bt.moneyType.getFun();
    /**判断字符串是否为空*/
    bt.empty = function(ms){
    	if(typeof(ms) == "undefined" || ms == null || ms == ""){
    		return true;
    	}
    	return false;
    }
    
    changeRepayType = function(data,ele){
    	if(data.value==1){//归还本金
    		moneyType.get("repayAccrual").attr("lay-verify","");
    		moneyType.get("repayAccrual").val("");
    		$("#lixqdButton").attr("disabled","true");
    		$("#lixqdButton").addClass("layui-btn-disabled");
    	}else{
    		moneyType.get("repayAccrual").val(0);
    		moneyType.get("repayAccrual").attr("lay-verify","required");
    		getFixedMoneyInterest();
    		$("#lixqdButton").removeAttr("disabled");
    		$("#lixqdButton").removeClass("layui-btn-disabled");
    	}
    	if(data.value==4){
    		$("#repayMoneyShow").html(moneyFun.format(0));
    	}else{
    		$("#repayMoneyShow").html(moneyFun.format($("#repayMoney").val()));
    	}
    	if($("#isAccounting").val() == "false"){
    		moneyType.get("repayAccrual").attr("lay-verify","");
    	}
    }
    
    /**
     * 根据账号金额获取利息
     */
    getFixedMoneyInterest = function(){
    	if(bt.empty($("#loanAcc").val())||bt.empty($("#repayMoney").val())||dicts.get("repayType").val()==1||dicts.get("repayType").val()==" "){
    		moneyType.get("repayAccrual").val("");
			return false;
		}
    	var params = {
			"account":$("#loanAcc").val(),
			"money":dicts.get("repayType").val()==2?$("#repayMoney").val():$("#sendMoney").val(),
			"businessID":$("#orderNo").val(),
			"endInstDate":dateType.get("repayDate").val()
		};
    	$.ajax({
    		type: "POST",
    		url: basePath+"/cms/loan/cmsloanrepay?getFixedMoneyInterest",
    		data: params,
    		dataType : "json",
    		success: function(rs){
    			moneyType.get("repayAccrual").val(rs.obj.interest);
    			$("#SyncAccrual").val(0);
    			$("#curAccrualShow").html("");
    		}
    	});
    }
    
    initAccrualInfo = function(){
    	if(bt.empty($("#loanAcc").val())||$("#initRepayType").val()==1){
    		moneyType.get("repayAccrual").val("");
			return false;
		}
    	var params = {
				"account":$("#loanAcc").val(),
				"money":$("#initRepayType").val()==2?$("#repayMoney").val():$("#sendMoney").val(),
				"businessID":"",
				"endInstDate":dateType.get("repayDate").val()
		};
    	$.ajax({
    		type: "POST",
    		url: basePath+"/cms/loan/cmsloanrepay?getFixedMoneyInterest",
    		data: params,
    		dataType : "json",
    		success: function(rs){
    			if(rs.obj.interest!=$("#repayAccrual2").val()){//利息已变更，当前利息为：
    				$("#curAccrualShow").html(bt.lang("cms.loan.repayAccrual.isChange")+"<strong>"+moneyFun.format(rs.obj.interest)+"</strong>");
    				$("#SyncAccrual").val(1);
    			}
    		}
    	});
    }
    
    var dateType = bt.dateType.init();
    var dicts = bt.dicts.init();
    var moneyType = bt.moneyType.init();
    if($("#initRepayType").val()==1){
    	$("#lixqdButton").attr("disabled","true");
    	$("#lixqdButton").addClass("layui-btn-disabled");
    }
    initAccrualInfo();
  	//监听提交
    form.on('submit(submit)', function(data){
   		var status=$(this).attr("value");
   		data.field.status = status;//提交状态
   		if(status==0){//打回
   			parent.layer.confirm(bt.lang('common.message.confirm.repulse'),{icon:3},function(){
   				submitData(data);
   			});
   		}else{//确认通过
   			if(bt.empty($("#loanAcc").val())){//没有贷款账号不做利息校验
   				submitData(data);
   			}else if(dicts.get("repayType").val()!=1){//已记账产生积数且还款类型包含利息则计息
//   				if((!bt.empty($("#SyncAccrual").val()))&&$("#SyncAccrual").val()==1){
					//还款利息与当前系统利息不符，请更改还款方式以重新计算利息
//					layer.tips(bt.lang("cms.loan.repay.NotSyncAccrual"), '#lixqdButton',{tips: 3});
//					return false;
//				}
   				var closeDay = new Date($("#closeDay").val());
       			var endIntDate = bt.date.addDay(new Date(dateType.get("repayDate").val()),-1);
//       			if(closeDay < endIntDate){//日结日期小于还款前一天
//       				parent.layer.confirm(bt.lang("cms.loan.notDayColseEndDate",new Array(bt.date.format(endIntDate))),{icon:3},function(){
//       					submitData(data);
//      				});
//       			}else{//日结到还款前一天
       				submitData(data);
//       			}
   			}else{
  				submitData(data);
   			}
   		}
        return false;
    });
    
    submitData = function(data){
    	var mask = layer.load(1, {shade: [0.1, '#FFF']});//遮罩层
    	var action = "/cms/precative/loanrepay/interetAffirmPass";
    	$.post(basePath + action,data.field,function(result){
            parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            if(result.success){
            	layer.close(mask);
            	if(!bt.navtab){
                    parent.layer?parent.layer.closeAll():layer.closeAll();
                } else {
                	bt.navtab.refreshParent();
                	bt.navtab.closeCurrent();
                }
            }else{
            	layer.close(mask);
            }
        },'JSON');
    }
    
    //关闭窗口
    doClose = function(){
    	if(bt.navtab){
			bt.navtab.closeCurrent();
		}
    }
    
  	//显示利息清单
    showlxqd = function(){
    	if($("#loanAcc").val()==null || $("#loanAcc").val()==undefined || $("#loanAcc").val() == ""){
    		layer.alert(bt.lang("cms.loan.notFcAccBook.NotInterest"),{icon:5});//未产生账务，不计息
    		return false;
    	}
    	var params= "account="+ $("#loanAcc").val()+"&money="+(dicts.get("repayType").val()==2?$("#repayMoney").val():$("#sendMoney").val())+"&endInstDate="+$("#repayDate").val()+"&businessID="+$("#orderNo").val();
	    parent.layer.open({
	    	title:bt.lang("table.interet.lxqd"),
	        type: 2,
	        area: ['75%', '80%'],
	        maxmin: true,
	        content: basePath + "/cms/loan/cmsloanrepay/repayInteretDtl?" + params
	    });
    }
});

</script>
</html>
});


//根据单位ID和业务类型判断是否挂预算
 $(document).ready(function(){
   var corpId=$("#corpId").val();
   var briefId="3000";
    $.ajax({
	    type:"POST",
	    url:basePath+"/cms/precative/loaninfo/isBudget",
		data:{'corpId':corpId,'briefId':briefId},
		async:false,
		dataType:'json',
		success:function(result){
		   if(result.success){
		     if(result.attributes.isBudget){
			    genOtherHtml(corpId);
				return true;
			 }else{
			   $("#tagItemDetail").html("");
			   return false;
			 }
		   }else{
		      parent.layer?parent.layer.alert(result.msg,{icon:result.success?1:2}):layer.alert(result.msg,{icon:result.success?1:2});
		   }
		}

	});
 });

 function genOtherHtml(corpId){
    var itemCode=$("#endorseItem").val();
	var defItemCode=$("#defItemCode").val();
	var processDate=$("#repayDate").val();
	var url=basePath+"/budget/fbsBudgetProcess/getViewItemDetail";
	var param={
	    corpId:corpId,
        itemCode:itemCode,
        defItemCode:defItemCode,
        processDate:processDate,
		billNo:$("#billCode").val(),
		businessName: $("#businessName").val(),
        processSysname: $("#processSysname").val(),
        curId:$("#curId").val(),
        type:'select',
        date:(new Date()).getTime()
	  };
	 $.ajax({url:url,method:'POST',data:param,async:true,success:function(json){


<script>
bt.use(['form','btdate','corp','moneyType','rateType','dateType','selectType','date','dicts','rateType','money'], function(){
    $ = bt.jquery,form = bt.form();
    bt.corp.init();
    moneyType = bt.moneyType.init();
 	selectType = bt.selectType.init();
   	rateTye = bt.rateType.init();
    var dateType = bt.dateType.init();
   	dicts = bt.dicts.init();
   	var moneyFun = bt.moneyType.getFun();
	var repayDate=dateType.get("repayDate").val();
    //监听提交
    form.on('submit', function(data){
    	bt.loading.show();//显示加载中
    	if($("type")=="Edit"){
    		if(!validataRepayMent()){//验证还款计划
       			layer.tips(bt.lang("cms.loan.repaymentIsModifyMsg"), '#repayPlanButton',{tips: 1});
        		bt.loading.hide(); //关闭加载中
        		return false;
        	}
    	}
    	
    	//未维护还款计划，在委托贷款归还（还款）时，还款日期大于贷款发放的日期
    	if(!isEmpty($("#repaymentScheduleId").val())){
    		/* var repayDate = data.field[];
    		var sendDate = $("#").val();   */
    	}
    	if(parseInt(data.field['repayMoney']) > parseInt($("#loanMoney").val())){
    		layer.msg(bt.lang("table.precativeLoanReapy.repayMoneyThanLoanMoney"));
    		bt.loading.hide(); //关闭加载中
    		return false;
    	}
		
		var repayMoney=bt.moneyType.getFun().toNumber($("#repayMoney").val());
		var repayAccrual=bt.moneyType.getFun().toNumber($("#repayAccrual").val());
		var sumMoneys=$("#sumMoneys").val();
		if(sumMoneys !="" && sumMoneys!=(bt.moneyType.getFun().add(repayMoney, repayAccrual))){
		  	layer.msg(bt.lang("table.precativeLoanReapy.repayMoneyNotEqualsSummoney"));
    		bt.loading.hide(); //关闭加载中
    		return false;
		}
        var action = "/cms/precative/loanrepay/submit";
        var status=$(this).attr("value");
		$("#status").val(status); //提交状态
        $.post(basePath + action,$('#inputForm').serialize(),function(result){
       		bt.loading.hide(); //关闭加载中
            if(result.success){
            	if(!bt.navtab){
            		location.reload();
                    parent.layer?parent.layer.closeAll():layer.closeAll();
            	} else {
            		bt.navtab.refreshParent();
           			bt.navtab.closeCurrent();
            	}
            }
            parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
        },'JSON');
        return false;
    });
    
    $("#repayPlan").click(function(){
    	repayPlan();
    });
	
    if(!isEmpty(repayDate)){
	   isBudget(repayDate);
	}
	
	
});

//通过还款计划回调还款日期
 function initRepayDate(data){
   if(!isEmpty(data)){
     isBudget(data);
  }
 }
 
	
function isBudget(repayDate){
 //var corpId=$("#corpId").val();
 var corpId=$("#precativeId").val();
 var briefId="3000";
    $.ajax({
	    type:"POST",
	    url:basePath+"/cms/precative/loaninfo/isBudget",
		data:{'corpId':corpId,'briefId':briefId},
		async:false,
		dataType:'json',
		success:function(result){
		   if(result.success){
		     if(result.attributes.isBudget){
			    $genOtherHtml(corpId,repayDate);
				return true;
			 }else{
			   $("#tagItemDetail").html("");
			   return false;
			 }
		   }else{
		      parent.layer?parent.layer.alert(result.msg,{icon:result.success?1:2}):layer.alert(result.msg,{icon:result.success?1:2});
		   }
		}
	
	});
 
 }

/**
 * 挂资金计划
 */
 
 
 $genOtherHtml=function(corpId,repayDate){
    var itemCode=$("#endorseItem").val();
	var defItemCode=$("#defItemCode").val();
	var url=basePath+"/budget/fbsBudgetProcess/getEditItemDetail";
	var param={
	    corpId:corpId,
        itemCode:itemCode,
        defItemCode:defItemCode,
        processDate:repayDate,
		billNo:$("#billCode").val(),
		businessName: $("#businessName").val(),
        processSysname: $("#processSysname").val(),
        curId:$("#curId").val(),
        type:'select',
        date:(new Date()).getTime()
	  };
	 $.ajax({url:url,method:'POST',data:param,async:true,success:function(json){
	    $("#tagItemDetail").html("");
		$("#tagItemDetail").html(json);
	  }
	 
	 });
 };
 
 function sumMoneyCallBack(sumMoney){
 $("#sumMoneys").val(sumMoney);
 }
 

/**
 * 打开还款计划
 */
function repayPlan(){
	if($("#isHaveRepayMent").val()==0){//未维护还款计划
		layer.tips(bt.lang("cms.noReplament.Message"), '#repayPlan',{tips: 1});
		return false;
	}
	var repayType=$("select[name='repayType']").val();
	if($("#skipLoanSendOut").val()=="0"){
	  	var billcode=$("#sendId").val()
	}else if($("#skipLoanSendOut").val()=="1"){
	    var  billcode=$("#infoId").val();
	}
	var tallySign = $("#tallySign").val();
	if(bt.navtab){
        bt.navtab.addNavtab(bt.lang('cms.button.repayPlan'),basePath + "/cms/basedata/repaymentschedule/toRepayPlanSave?billCode="+billcode+"&repayType="+repayType+"&tallySign="+tallySign+"&repayway="+repayType  );
        return false;
	}
}

function checkTime(ele,data){
	var sendDate = $("#sendDate").val();
	var repayDate = bt.dateType.init().get("repayDate").val();
	if(sendDate !==""){
		if(bt.date.compare( repayDate,sendDate ) < 0){//归还日期要大于发放日期
			bt.dateType.init().get($(data).attr("data-biz-name")).val("");
			bt.dateType.init().get($(data).attr("data-biz-name")).render();
			layer.tips(bt.lang("cms.precative.repayDate.pass.senddate"), '#'+$(data).attr("data-biz-name"));
			return false;
		}
	}
}

function changeRepayType(data,ele){
	if(data.value==1){//归还本金
		$("#repayPlan").show();
		moneyType.get("repayAccrual").attr("lay-verify","");
		moneyType.get("repayAccrual").val("");
		resetRepayInfo();
	}else if(data.value==2){//归还本金及归还金额利息
		$("#repayPlan").show();
		moneyType.get("repayAccrual").val("");
		moneyType.get("repayAccrual").attr("lay-verify","required");
		resetRepayInfo();
		getFixedMoneyInterest();
	}else if(data.value==3){//归还本金及所有利息
		$("#repayPlan").show();
		moneyType.get("repayAccrual").val("");
		moneyType.get("repayAccrual").attr("lay-verify","required");
		resetRepayInfo();
		getFixedMoneyInterest();
	}else if(data.value==4){//归还利息
		$("#repayPlan").hide();
		moneyType.get("repayAccrual").val($("#repaymentIst").val());
		moneyType.get("repayAccrual").attr("lay-verify","required");
		resetRepayInfo();
		getFixedMoneyInterest();
	}
	form.renderIcon();
}

/**
 * 根据账号金额获取利息
 */
function getFixedMoneyInterest(){
    var tallySign = $("#tallySign").val();
    
 	if(isEmpty($("#loanAcc").val())||isEmpty(moneyType.get("repayMoney").val())||
 				isEmpty(bt.dateType.init().get("repayDate").val())||dicts.get("repayType").val()==1||dicts.get("repayType").val()==" "){
 		moneyType.get("repayAccrual").val("");
 		if(isEmpty($("#loanAcc").val())){
	 		moneyType.get("repayAccrual").attr("lay-verify","");
 		}
		return false;
	}
 	var params = {
		"account":$("#loanAcc").val(),
		"money":dicts.get("repayType").val()==2?moneyType.get("repayMoney").val():$("#loanMoney").val(),
		"businessID":$("#orderNo").val(),
		"endInstDate":bt.dateType.init().get("repayDate").val(),
        "tallySign":tallySign
	};
 	$.ajax({
 		type: "POST",
 		url: basePath+"/cms/loan/cmsloanrepay?getFixedMoneyInterest",
 		data: params,
 		dataType : "json",
 		success: function(rs){
			moneyType.get("repayAccrual").val(rs.obj.interest);
 		}
 	});
 }

/**
 * 验证还款计划
 */
function validataRepayMent(){
	var valiSign = true;
	if(!isEmpty($("#repaymentScheduleId").val())){
		$.ajax({
   			type: "POST",
    		url: basePath+"/cms/loan/cmsloanrepay?validataRepayMent",
    		async:false,
    		data: {
    			"repaymentId":$("#repaymentScheduleId").val()
    		},
    		dataType : "json",
    		success: function(rs){
   				if(!rs.obj){
    				valiSign = false;
    			}else{
    				valiSign = true;
    			}
    		}
    	});
	}
	return valiSign;
}

/**
 * 还款金额变更，重新计息
 */
function changeRepayMoney(data,ele){
	if(dicts.get("repayType").val()!=1){
		getFixedMoneyInterest();
	}
}

/**
 * 还款日期变更，重新计息
 */
function changeRepayDate(data,ele){
	var sendDate = $("#sendDate").val();
	var repayDate = bt.dateType.init().get("repayDate").val();
	if(sendDate !==""){
		if(bt.date.compare( repayDate,sendDate ) < 0){//归还日期要大于发放日期
			bt.dateType.init().get($(ele).attr("data-biz-name")).val("");
			bt.dateType.init().get($(ele).attr("data-biz-name")).render();
			layer.tips(bt.lang("cms.precative.repayDate.pass.senddate"), '#'+$(ele).attr("data-biz-name"));
			return false;
		}
		
	}
	if(dicts.get("repayType").val()!=1){
		getFixedMoneyInterest();
	}
	isBudget(repayDate);
	
}

/**
 * 判断字符串是否为空
 */
function isEmpty(ms){
	if(typeof(ms) == "undefined" || ms == null || ms == ""){
		return true;
	}
	return false;
}

/**
 * 是否已选还款计划
 */
function isSelectRepayment(){
	if(isEmpty($("#isSelectRepayment").val())){//是否已选还款计划
		return false;
	}else{
		return true;
	}
}

/**
 * 重置还款信息
 */
function resetRepayInfo(){
	if(!isSelectRepayment()){
		if($("#isHaveRepayMent").val()=="1"){
    		$("#repaymentScheduleId").val("");
	    	moneyType.get("repayMoney").val(dicts.get("repayType").val()==4?0:"");
			bt.dateType.init().get("repayDate").attr("readonly",dicts.get("repayType").val()==4?false:true);
			bt.dateType.init().get("repayDate").val("");
			bt.dateType.init().get("repayDate").render();
    	}else{
    		if(dicts.get("repayType").val()==4){
    			moneyType.get("repayMoney").val($("#repayMoneyOld").val());
    		}
    	}
	}else{
		moneyType.get("repayMoney").val(dicts.get("repayType").val()==4?0:$("#repayMoneyOld").val());
		bt.dateType.init().get("repayDate").val($("#repayDateOld").val());
		bt.dateType.init().get("repayDate").render();
	}
	
}

</script>
</html>
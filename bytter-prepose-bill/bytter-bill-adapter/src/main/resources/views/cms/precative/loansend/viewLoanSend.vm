<!DOCTYPE html>
<html lang="en" style="height:100%; ">
<head>
    #parse("views/common/head.vm")
</head>
<body style="height:100%; ">
<input type="hidden" id="billCode" value="$!{billCode}">
<iframe src="${basePath}/cms/precative/loaninfo/view?billCode=$!{billCode}&loan=repair" id="sendIframe" frameborder="0" scrolling="no"  style="width:100%;height:655px;"></iframe>
 <div id="loanSend" style="padding-bottom: 20px;"></div>
#parse("views/common/footer.vm")
</body>

<script>
bt.use(['jquery'], function(){
    var $ = bt.jquery;
    var url=basePath+"/cms/precative/loansend/pullLoan";
    var param={
        billCode:$("#billCode").val()
    };
    $.ajax({url:url,method:'POST',data:param,async:true,success:function(json){
            $("#loanSend").html(json);
        }

    });
});
</script>
</html>

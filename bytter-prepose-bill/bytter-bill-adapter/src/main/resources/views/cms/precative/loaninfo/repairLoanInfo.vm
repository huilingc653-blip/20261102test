                	<label>#springMessage('table.fcAccbookHis.enrolTime')</label>
                    <div class="layui-input-inline" style="padding-bottom: 4px;">
                    	$!date.format('yyyy-MM-dd',$!{opDate})
                        <input type="hidden" name="createDate"  autocomplete="off" class="layui-input" value="$!date.format('yyyy-MM-dd',$!{opDate})" readonly="readonly">
                    </div>
                </td>
            </tr>
            <tr>
                ##委托人  ttttttttt
                <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.precativeId')</td>

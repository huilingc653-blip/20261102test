							</div>
						</div>
						<div style="padding-bottom: 10px;padding-top: 10px;">
							##点数或者浮动比例选择与文本
							<div class="layui-input-inline">
							<div class="bt-biz-dict" data-name="pointsProportionSelect" data-type="select" data-biz-name="pointsProportionSelect" data-group="Cms.PointsProportion"
										data-value="$!{precativePage.pointsProportionSelect}" data-defaultvalue="02" data-disabled="true"></div>
						</div>
						<div class="layui-input-inline input-bp">
							##<input class="layui-input" id="pointsProportionText" name="pointsProportionText" value="$!{precativePage.pointsProportionText}" disabled="disabled">
							##<input class="layui-input bt-biz-moneyType" id="pointsProportionText" name="pointsProportionText" data-biz-name="pointsProportionText" value="0" data-decimal="2" data-max="100" data-min="0" disabled="disabled">
							#if($!{precativePage.floatWay} == "01")
								<div class="pl rateWrap" style="width:212px">
									<input class="layui-input bt-biz-moneyType" id="pointsProportionText" name="pointsProportionText" data-callback="getRate"
										data-biz-name="pointsProportionText"  data-value="$!{precativePage.pointsProportionText}" data-decimal="2" data-max="100" data-min="-100" data-minus="true" readonly="readonly">
                                    <span name="percentsymbol" class="inputMark" id="inputMark"></span>

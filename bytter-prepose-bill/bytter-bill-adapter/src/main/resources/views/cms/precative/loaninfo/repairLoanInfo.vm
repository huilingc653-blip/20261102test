/**基准利率加载完成后 加载利率周期*/
function loanRepayCycle(){
	var curId = $("#curId").val();
	var startDate = $.trim(bt.dateType.init().get("startDate").val());//借款申请日期
	if(isEmpty(startDate)){
		startDate = $("#createDate").val();//为空默认录入日期
	}
   	var referenceRateType = selectType.get("referenceRateType").val();//基准利率类型
   	if(isEmpty(curId)){
   		selectType.get("repayCycle").attr("data-url","");
	}else{//本位币
        if(floatWayChangeFlag.isChange){
            selectType.get("repayCycle").attr({
                "data-required":floatWayChangeFlag.flag,
                "data-disabled":!floatWayChangeFlag.flag,
                "data-url":basePath+"/cms/loanrate/maintence/querRateMaintence?time="+startDate+"&curId="+curId+"&baseId="+referenceRateType
            });
            floatWayChangeFlag.isChange = false;
            form.renderIcon();
        }else {
            selectType.get("repayCycle").attr("data-url",basePath+"/cms/loanrate/maintence/querRateMaintence?time="+startDate+"&curId="+curId+"&baseId="+referenceRateType);
		}
   	}
}

//设置还款计划按钮
function skip(data){
	if(data.value == "1" || data == "1"){
		$("#openRepayDiv").show();
	}else{
		$("#openRepayDiv").hide();
	}
}

//监听是否跳过贷款发放功能
function changeSendOutType(data){
	if(data.value == "2"){
		$(".skipLoan").hide();
		$("#skipLoanText").html("");
		$("input[lay-filter='skipLoanSendOut']").attr('name','');
		$("#openRepayDiv").hide();
	}else{
		$(".skipLoan").show();
		$("#skipLoanText").html("#springMessage('table.cmsPrecativeLoanInfo.skipLoanSendOut')");
		$("input[lay-filter='skipLoanSendOut']").attr('name','skipLoanSendOut');
		skip($("input[lay-filter='skipLoanSendOut']:checked").val());
	}
}

/**加载还款计划*/
function repayPlan(){
	var loanCode = $("input[name='billCode']").val();//录入单号
	var loanRate = rateType.get("rate").val();//委托贷款利率
	var loanDate = dateType.get("startDate").val();//委托贷款日期
	var repayDate = dateType.get("endDate").val();//还款日期
	var repayType = selectType.get("repayType").val();//还款方式
	var loanMoney = moneyType.get("money").val();//金额
	var id = $("#id").val();
	var planId = $("#planId").val();

	if(isEmpty(loanRate)){
		parent.layer.msg(bt.lang("cms.provide.loaninfo.loanrateempty"), {icon: 2});
		return false;
	}
	if(isEmpty(loanDate)){
		parent.layer.msg(bt.lang("cms.provide.loaninfo.pldateempty"), {icon: 2});
		return false;
	}
	if(isEmpty(repayDate)){
		parent.layer.msg(bt.lang("cms.provide.loaninfo.repaydateempty"), {icon: 2});
		return false;
	}
	if(bt.empty(repayType)){
		parent.layer.msg(bt.lang("cms.provide.loaninfo.repaytypeempty"), {icon: 2});
		return false;
	}
	if(isEmpty(loanMoney)){
		parent.layer.msg(bt.lang("cms.provide.loaninfo.plmoneyempty"), {icon: 2});
		return false;
	}

	var params = "billCode=" + id + "&loanRate=" + loanRate +"&loanDate=" + loanDate + "&repayDate=" + repayDate
			+ "&repayType=" + repayType + "&loanMoney=" + loanMoney+ "&planId=" + planId+"&rateBase=360";

	if(bt.navtab){
		// 计提计息改造暂时注掉，使用新版计提计息页面
        // bt.navtab.addNavtab(bt.lang('cms.button.repayPlan'),basePath + "/cms/basedata/repaymentschedule/toRepayPlan?" + params);
		bt.navtab.addNavtab(bt.lang('cms.button.repayPlan'), basePath + "/cms/basedata/repaymentschedule/makeRepayPlan?" + params);
	}
}


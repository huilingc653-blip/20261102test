//根据单位ID和业务类型判断是否挂预算
function isBudget(corpId,briefId){
	$.ajax({
		type:'POST',
		url:basePath+"/cms/precative/loaninfo/isBudget",
		data:{'corpId':corpId,'briefId':briefId},
		async:false,//是否异步
		dataType:'json',
		success:function(result){
			if(result.success){
				if(result.attributes.isBudget){
					genOtherHtml(corpId);
					return true;
				}else{
					$("#tagItemDetail").html("");
					return false;
				}
			}else{
				parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
			}
		}

	})
}

//生成资金计划的表格
genOtherHtml=function(corpId){
    var itemCode = $('input[name="endorseItem"]').val();

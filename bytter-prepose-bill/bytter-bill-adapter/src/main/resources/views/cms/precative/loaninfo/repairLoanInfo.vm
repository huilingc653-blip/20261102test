<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 12px;
	text-align: center;
	border-left: 0px;
	border-right: 0px;
	background-color: #d2d2d2;
}
.input-bp input {
    border: none;
    width: 192px;
}
.input-bp span {
    position: absolute;
    right: 4px;
    top: 1px;
}
</style>
</head>
<body>
<form class="layui-form" id="inputForm">
	<input type="hidden" id="type" value="$!{type}">
	<input type="hidden" id="id" name="id" value="$!{precativePage.id}">
	<input type="hidden"  name="billCode" id="billCode" value="$!{precativePage.billCode}">
	<input type="hidden"  id="isNatualCurrency" value="$!{isNatualCurrency}">

    var processDate = $.trim(bt.dateType.init().get("startDate").val());
    var url=basePath+"/budget/fbsBudgetProcess/getEditItemDetail";
    var param={
        corpId:corpId,
        itemCode:itemCode,
        defItemCode:defItemCode,

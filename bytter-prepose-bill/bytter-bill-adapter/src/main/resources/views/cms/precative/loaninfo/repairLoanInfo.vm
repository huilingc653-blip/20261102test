<script src="${basePath}/static/modules/cms/precative/cmsPrecativeLoan.js?_btv=${resourceVersion}"></script>
<script>
bt.use(['form','datatable','btdate','corp','moneyType','rateType','dateType','selectType','date','dicts','bankInfo','btUpload','conSelect','conView'], function(){
    $ = bt.jquery,form = bt.form();
    bt.corp.init();
    moneyType = bt.moneyType.init();
    moneyFun = bt.moneyType.getFun();
    selectType = bt.selectType.init();
   	rateType = bt.rateType.init();
    dateType = bt.dateType.init();
   	dicts = bt.dicts.init();
   	bt.bankInfo.init();
    conSelectInit = bt.conSelect.init(); // 合同挂接组件初始化
    conView = bt.conView.init(); //  合同查看组件初始化
   	var gid = $("#annexName").val();
   	var up = bt.btUpload.init({
        elem: "#uploader",
        isExpand: true,
        auto: false,
        gid: gid
    });

   	$(document).ready(function(){
		initRepayCycle($("#floatWay").val());
	})

	$(function(){
		setOutType($("#loanSendOutType").val());
	})

	$(document).ready(function(){
		var loanOpp = $("#loanOpp").val();
		corpCallback(loanOpp);
	})

  	//监听提交
    form.on('submit(submit)', function(data){
/*		console.info($('#inputForm').serialize());
		return false;*/
        bt.loading.show();//显示加载中
        // 如果委托贷款对接了合同
        if($("#relateCon").val()==1){
            if ($("#conType").val()==1 && bt.empty($("#conId").val())){ // 业务选择合同
                layer.msg(bt.lang('cms.conInfo.unSelect'));
                bt.loading.hide(); //关闭加载中
                return false;
			}
            if ($("#conType").val()==0){ // 业务生成合同
                var corpId = $("#precativeId").val();
                var conTypeId = $("#conTypeId").val();
                if (bt.empty(conTypeId)){
                    conTypeId = getConTypeEntrustLoan(corpId);
				}
                if (typeof conTypeId === "boolean"){
                    return false;
				}
                data.field.conTypeId = conTypeId;
                $("#conTypeId").val("");
			}
        }
    	//委托人和借款人不能为同一单位
    	if(data.field.precativeId == data.field.loanOpp){
    		layer.msg(bt.lang('table.precativeLoan.precativeAndLoan.notOneCorp'));
    		bt.loading.hide(); //关闭加载中
    		return false;
    	}
        var action = "/cms/precative/loaninfo/repairSubmit";
        /* if(data.field['floatWay'] == "01"){
        	data.field['referenceRateType'] = "";
        	data.field['repayCycle'] = "";
        	data.field['pointsProportionSelect'] = "";
        	data.field['pointsProportionText'] = "";
        } */
    	data.field.annexName = up.getGroupId();
		var disabled = selectType.get("repayCycle").attr("data-disabled");
		var inputData;
		if (disabled == true| "true" == disabled || "disabled" == disabled) {
			inputData = $('#inputForm').serialize();
		} else {
			inputData = $('#inputForm').serialize();
		}
		inputData += "&repayCycle=" + selectType.get("repayCycle").val();
		inputData += "&annexName=" + data.field.annexName + "&pointsProportionSelect=" + dicts.get("pointsProportionSelect").val();
		$.post(basePath + action, inputData, function (result) {
			bt.loading.hide(); //关闭加载中
			if (result.success) {
				if (!bt.navtab) {
					location.reload();
					parent.layer ? parent.layer.closeAll() : layer.closeAll();
				} else {
					bt.navtab.refreshParent();
					bt.navtab.closeCurrent();
				}
			}
			parent.layer ? parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}) : layer.alert(result.msg, {icon: result.success ? 1 : 2});
		}, 'JSON');
        return false;
    });

  	//监听重置
    form.on('submit(reset)', function(data){
    	location.reload();
    })

    //监听打回
    form.on('submit(back)', function(data){
    	bt.loading.show();//显示加载中
        var action = "/cms/precative/loaninfo/back";
        var id = $("input[name='id']").val();
        var refuseWhy = $("#refuseWhy").val();
        $.post(basePath + action, { id:id , refuseWhy:refuseWhy },function(result){
       		bt.loading.hide(); //关闭加载中
        	if(!bt.navtab){
        		location.reload();
                parent.layer?parent.layer.closeAll():layer.closeAll();
        	} else {
        		bt.navtab.refreshParent();
       			bt.navtab.closeCurrent();
        	}
            parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
        },'JSON');
        return false;
    });

    //设置还款计划
    $("#openRepayMentSchedule").click(function(){
    	repayPlan();
    });

	 //获取利率
	$("#getRate").click(function(){
		getRate();
	});


});


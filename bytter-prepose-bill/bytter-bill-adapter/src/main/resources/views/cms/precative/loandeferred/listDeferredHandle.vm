<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
            	<input type="hidden" id="pageType" value="${pageType}">
                <tr>
                	##单位
                	<td width="25%" class="textRight">#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</td>
                	<td >
                		<div class="layui-input-inline">
                   			<div class="bt-biz-corp" data-biz-type="corp" data-type="selectTree" data-name="eqs_loanOpp" data-scope="all" data-resource="cms:precative:deferred:handle:query"></div>
                  		</div>
                  	</td>
                  	##展期单号
                  	<td width="25%" class="textRight">#springMessage('table.cmsLoanDeferred.billCode')</td> 
                  	<td>
                  		<input type="text" name="likes_billCode" class="layui-input">
                  	</td>
                </tr>
                ##按钮组
                <tr>
    
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                  
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('cms.precative.info.billCode')</th>
        <th>#springMessage('table.cmsLoanDeferred.billCode')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.contractCode')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.precativeId')</th>
        <th>#springMessage('table.cmsPrecativeLoanSend.depositAcc')</th>
        <th>#springMessage('table.cmsPrecativeLoanSend.loanAcc')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.curId')</th>
        <th>#springMessage('table.cmsPrecativeLoanSend.money')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.term')</th>
        <th>#springMessage('table.fbsBudgetPeriod.beginDate')</th>
        <th>#springMessage('table.fbsBudgetPeriod.endDate')</th>
        <th>#springMessage('table.fcAcc.delayDeadlineDate')</th>
        <th>#springMessage('table.btBankAcc.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/precative/precativeDeferredHandle.list.js?_btv=${resourceVersion}"></script>
</html>

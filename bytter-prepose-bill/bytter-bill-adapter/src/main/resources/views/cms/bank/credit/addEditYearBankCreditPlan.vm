<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" >
        <input type="hidden" name="id" id="id" value="$!{info.id}">
		<table class="layui-table"  >
		<tbody>
        	<tr>
        		##单位
				<td class="textRight">单位</td>
				<td>
					<div class="layui-input-inline">
						<div class="bt-biz-corp"
							data-biz-type="corp"
							data-type="selectTree"
							data-name="corpId"
							data-biz-name="corpId"
							data-scope="all"
							data-required="true"
                            data-defaultvalue="$!{info.corpId}"
							data-resource="cms:bank:credit:plan:add"
                            data-disabled="#if($info.corpId)true#{else}false#end"
                        >
						</div>
					</div>
				</td>

                ##授信银行
                <td class="textRight">授信银行</td>
                <td colspan="3">
                    <input type="hidden" id="bankCode" name="bankCode" value="$!{info.bankCode}" />
                    <input type="hidden" id="bankId" name="bankId" value="$!{info.bankId}" />
                    <div class="layui-inline">
                        <input lay-verify="required" class="layui-input" id="bankName" readonly="readonly"
                               value="$!{info.bankName}" name="bankName" type="text" style="width: 280px"/>
                    </div>
                    <div class="layui-inline">
                        <button type="button" class="layui-btn bt-biz-bankInfo" data-beforeClick="bt.bankInfoBeforeClick"
                                data-callback="bankInfoCallback">#springMessage('common.button.select')</button>
                    </div>
                </td>
			</tr>

            <tr>
                ##授信类型
                <td  class="textRight">授信类型</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="cms.bank.credit.plan" data-defaultvalue="$!{info.creditType}"
                         data-name="creditType" data-biz-name="creditType" data-required="true" data-disabled="#if($info.creditType)true#{else}false#end"></div>
                </td>

                ##年度
                <td class="textRight">年度</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" data-name="year" name="year" class="layui-input bt-input-inline bt-biz-dateType"
                            value="#if($!{info.year})$!{info.year}#else$!{currentYear}#end" lay-verify="required" data-type="year"/>
                    </div>
                </td>
            </tr>

            <tr>
                ##币别
                <td class="textRight">币别</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-selectType" data-biz-name="curCode" data-url="${basePath}/basic/business/btcurrency/json"
                             data-valuefield="id" data-textfield="curName" data-name="curId" data-search="true"
                             data-defaultvalue="$!{info.curId}" data-required="true"></div>
                    </div>
                </td>
                ##计划授信金额
                <td class="textRight">计划授信金额</td>
                <td >
                    <input type="text" data-name="creditAmount" lay-verify="required" value="$!{info.creditAmount}"
                           autocomplete="off" class="layui-input bt-biz-moneyType" data-minus="false" placeholder="计划授信金额">
                </td>
            </tr>

            <tr>
                ##是否自动还款
                <td class="textRight">是否正常使用</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-dict" id="radio" data-type="radio" data-group="sf_yn"
                             data-defaultvalue="#if($info.status)$info.status#{else}1#end"
                             data-name="status" data-biz-name="status">
                        </div>
                    </div>
                </td>
            </tr>

			<tr>
				<td style="text-align: center;" colspan="4">
                    <button class="layui-btn" lay-submit="" value="11" lay-filter="submit">#springMessage('common.button.save')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/bank/credit/yearBankCreditPlan.add.edit.js?_btv=${resourceVersion}"></script>
</html>

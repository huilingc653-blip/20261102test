<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
            <tr>
                ##单位
                <td class="textRight">单位</td>
                <td >
                    <div class="layui-inline">
                        <div class="bt-biz-corp"
                             data-type="selectTree"
                             data-tree-type="check"
                             data-name="ins_corpId"
                             data-scope="all"
                             data-placeholder="#springMessage('common.placeholder.select')"
                             data-resource="cms:bank:credit:plan:query"
                        >
                        </div>
                    </div>
##                    <div class="layui-input-inline">
##                        <div class="bt-biz-corp"
##                             data-biz-type="corp"
##                             data-type="selectTree"
##                             data-name="eqs_corpId"
##                             data-resource="cms:bank:credit:plan:query"
##                             data-scope="all">
##                        </div>
##                    </div>
                </td>

                ##授信银行
                <td class="textRight">授信银行</td>
                <td colspan="3">
                    <div class="layui-inline">
                        <input class="layui-input" id="shouBankName" readonly="readonly" type="text" style="width: 280px"/>
                    </div>
                    <div class="layui-inline">
                        <button type="button" class="layui-btn bt-biz-bankInfo" data-beforeClick="bt.bankInfoBeforeClick"
                                data-callback="bankinfoCallback">#springMessage('common.button.select')</button>
                    </div>
                    <input type="hidden" id="bankCode" name="bankCode" />
                    <input type="hidden" id="bankType" name="bankType" />
                </td>

            </tr>

            <tr>
                ##授信类型
                <td class="textRight">授信类型</td>
                <td id="status">
                    <div class="bt-biz-dict" data-biz-name="creditType" data-type="mulselect" data-group="cms.bank.credit.plan"
                         data-name="ins_creditType"></div>
                </td>

                ##年度
                <td class="textRight">年度</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" name="eqs_year" class="layui-input bt-input-inline bt-biz-dateType"
##                               lay-verify="required"
                               data-type="year">
                    </div>
                </td>
            </tr>

            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>单位</th>
            <th>授信银行</th>
            <th>授信类型</th>
            <th>年度</th>
            <th>币别</th>
            <th>计划授信金额</th>
            <th>是否正常使用</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/bank/credit/yearBankCreditPlan.list.js?_btv=${resourceVersion}"></script>
</html>

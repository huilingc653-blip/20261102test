<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
            <tr>
                ##单位
                <td class="textRight">日期</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" data-name="date" name="date" class="layui-input bt-input-inline bt-biz-dateType"
                               data-type="month"/>
                    </div>
                </td>
            </tr>

            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>

        <tr>
            <th colspan="2" rowspan="2">区域</th>
            <th colspan="3">年度融资规划（万元）</th>
            <th colspan="4">计划授信（万元）</th>
            <th colspan="12">授信情况</th>
            <th colspan="8">额度使用情况（万元）</th>
            <th rowspan="3">授信完成率</th>
            <th rowspan="3">存在的困难</th>
            <th rowspan="3">解决措施</th>
        </tr>

        <tr>
            ##年度融资规划（万元）
            <th rowspan="2">年采购量</th>
            <th rowspan="2">并购投资</th>
            <th rowspan="2">授信额度需求</th>

            ##计划授信（万元）
            <th rowspan="2">银行合作情况</th>
            <th rowspan="2">授信银行名称</th>
            <th rowspan="2">授信额度</th>
            <th rowspan="2">额度变动情况</th>

            ##授信情况
            <th rowspan="2">银行额度</th>
            <th rowspan="2">授信银行名称</th>
            <th rowspan="2">合同起止日</th>
            <th colspan="5">授信额度（万元）</th>
            <th colspan="4">银承可使用条件</th>

            ##额度使用情况（万元）
            <th colspan="3">本期</th>
            <th rowspan="1">上年同期</th>
            <th colspan="3">本年</th>
            <th rowspan="1">上年</th>

        </tr>

        <tr>
            ##区域
            <th>大区</th>
            <th>单位</th>

            ##授信额度（万元）
            <th>综合额度</th>
            <th>其中：流贷额度</th>
            <th>其中：银承额度</th>
            <th>其他</th>
            <th>待分配子公司额度</th>

            ##银承可使用条件
            <th>保证金比率</th>
            <th>开票手续费</th>
            <th>保证金利率</th>
            <th>是否可正常使用</th>

            ##本期
            <th>已使用额度</th>
            <th>可使用额度</th>
            <th>目前实际额度缺口</th>

            <th>已使用额度</th>

            <th>已使用额度</th>
            <th>可使用额度</th>
            <th>目前实际额度缺口</th>

            <th>已使用额度</th>

        </tr>

        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/bank/credit/bankCreditPlanTrace.list.js?_btv=${resourceVersion}"></script>
</html>

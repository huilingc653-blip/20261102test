<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    ##本金支付频率
    <input id="capitalFrequencyType" name="capitalFrequencyType" type="hidden"
           value="$!{repayTypePage.capitalFrequencyType}">
    <input id="capitalFrequencyNext" name="capitalFrequencyNext" type="hidden"
           value="$!{repayTypePage.capitalFrequencyNext}">
    <input id="capitalFrequencyNum" name="capitalFrequencyNum" type="hidden"
           value="$!{repayTypePage.capitalFrequencyNum}">
    <input id="capitalFrequencyDetail" name="capitalFrequencyDetail" type="hidden"
           value="$!{repayTypePage.capitalFrequencyDetail}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.repay.repayCode')</td>
            <td>
                $!{repayTypePage.repayCode}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.repay.repayName')</td>
            <td>
                $!{repayTypePage.repayName}
            </td>
        </tr>
        <tr>
            ##本息关系
            <td class="textRight">#springMessage('table.repay.capitalAndInterest')</td>
            <td>
                #if($!{repayTypePage.capitalAndInterest}=="1")
                    ## 利息按剩余本金计算
                    #springMessage('table.repay.capitalAndInterest.money')
                #elseif($!{repayTypePage.capitalAndInterest}=="2")
                    ## 等额本息（仅频率一致支持）
                    #springMessage('table.repay.capitalAndInterest.equality')
                #elseif($!{repayTypePage.capitalAndInterest}=="3")
                    ## 利息与本金无关系（分别自定义）
                    #springMessage('table.repay.capitalAndInterest.irrelative')
                #end
            </td>
        </tr>
        <tr>
            ##本金支付频率
            <td class="textRight">#springMessage('table.repay.capitalFrequency')</td>
            <td>
                $dictTag.get("repay.frequency",$!{repayTypePage.capitalFrequencyType})
            #if($!{repayTypePage.capitalFrequencyType}=="D")
                $dictTag.get("accrual.dateType",$!{repayTypePage.capitalFrequencyNext})
            #elseif($!{repayTypePage.capitalFrequencyType}=="C")
                $dictTag.get("repay.numberType",$!{repayTypePage.capitalFrequencyNext})
            #end
            #if("$!{repayTypePage.capitalFrequencyType}" == "D")
                #if("$!{repayTypePage.capitalFrequencyNext}" == "5")
                    $dictTag.get("accrual.yearType",$!{repayTypePage.capitalFrequencyThird})
                #end
            #end
            #if($!{repayTypePage.capitalFrequencyType} == "D")
                #if("$!{repayTypePage.capitalFrequencyNext}" == "1")
                    $dictTag.get("accrual.dayCycle",$!{repayTypePage.capitalFrequency})
                #elseif("$!{repayTypePage.capitalFrequencyNext}" == "2")
                    $dictTag.get("accrual.weekCycle",$!{repayTypePage.capitalFrequency})
                #elseif("$!{repayTypePage.capitalFrequencyNext}" == "3")
                    $dictTag.get("accrual.monthCycle",$!{repayTypePage.capitalFrequency})
                #elseif("$!{repayTypePage.capitalFrequencyNext}" == "4")
                    $dictTag.get("accrual.seasonCycle",$!{repayTypePage.capitalFrequency})
                #elseif("$!{repayTypePage.capitalFrequencyNext}" == "5")
                    #if("$!{repayTypePage.capitalFrequencyThird}" == "12")
                        $dictTag.get("accrual.yearCycle",$!{repayTypePage.capitalFrequency})
                    #end
                #end
                #if($!{repayTypePage.capitalFrequency} == "other")
                    $!{repayTypePage.capitalFrequencyNum}
                #end
            #elseif($!{repayTypePage.capitalFrequencyType} == "C")
                $!{repayTypePage.capitalFrequencyNum}
            #end
            </td>
        </tr>
        <tr style="display: none" id="capitalFrequencyDetailShow">
            ##本金支付频率详细信息
            <td class="textRight"></td>
            <td>
                <table class="layui-table">
                    <tr>
                        <td align="center" width="80">
                            <table id="dataTableDetail" class="layui-table">
                                <thead>
                                <th>#springMessage('table.repay.num')</th>##次数
                                <th>#springMessage('table.repay.percent')</th>##比例%
                                </thead>
                                <tbody id="dataTableDetailBody" class="layui-form">
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            ##利息支付频率
            <td class="textRight">#springMessage('table.repay.interestFrequency')</td>
            <td>
                $dictTag.get("repay.frequency",$!{repayTypePage.interestFrequencyType})
            #if($!{repayTypePage.interestFrequencyType}=="D")
                $dictTag.get("accrual.dateType",$!{repayTypePage.interestFrequencyNext})
            #elseif($!{repayTypePage.interestFrequencyType}=="C")
                $dictTag.get("repay.numberType",$!{repayTypePage.interestFrequencyNext})
            #end
            #if("$!{repayTypePage.interestFrequencyType}" == "D")
                #if("$!{repayTypePage.interestFrequencyNext}" == "5")
                    $dictTag.get("accrual.yearType",$!{repayTypePage.interestFrequencyThird})
                #end
            #end
            #if($!{repayTypePage.interestFrequencyType} == "D")
                #if("$!{repayTypePage.interestFrequencyNext}" == "1")
                    $dictTag.get("accrual.dayCycle",$!{repayTypePage.interestFrequency})
                #elseif("$!{repayTypePage.interestFrequencyNext}" == "2")
                    $dictTag.get("accrual.weekCycle",$!{repayTypePage.interestFrequency})
                #elseif("$!{repayTypePage.interestFrequencyNext}" == "3")
                    $dictTag.get("accrual.monthCycle",$!{repayTypePage.interestFrequency})
                #elseif("$!{repayTypePage.interestFrequencyNext}" == "4")
                    $dictTag.get("accrual.seasonCycle",$!{repayTypePage.interestFrequency})
                #elseif("$!{repayTypePage.interestFrequencyNext}" == "5")
                    #if("$!{repayTypePage.interestFrequencyThird}" == "12")
                        $dictTag.get("accrual.yearCycle",$!{repayTypePage.interestFrequency})
                    #end
                #end
                #if($!{repayTypePage.interestFrequency} == "other")
                    $!{repayTypePage.interestFrequencyNum}
                #end
                #if("$!{repayTypePage.interestFrequencyNext}" == "3")
                    $dictTag.get("accrual.month.thisinterest",$!{repayTypePage.interestFrequencyThis})
                #elseif("$!{repayTypePage.interestFrequencyNext}" == "4")
                    $dictTag.get("accrual.season.thisinterest",$!{repayTypePage.interestFrequencyThis})
                #elseif("$!{repayTypePage.interestFrequencyNext}" == "5" && "$!{repayTypePage.interestFrequencyThird}" == "6")
                    $dictTag.get("accrual.year.thisinterest",$!{repayTypePage.interestFrequencyThis})
                #end
            #elseif($!{repayTypePage.interestFrequencyType} == "C")
                $!{repayTypePage.interestFrequencyNum}
            #end
            </td>
        </tr>
        <tr #if($!{repayTypePage.capitalAndInterest} != "1")
                style="display: none"
        #end>
            <td class="textRight">#springMessage('table.repayType.interestRepayType')</td>
            <td>
                $dictTag.get("repayType.interestRepayType",$!{repayTypePage.interestRepayType})
                #if($!{repayTypePage.interestRepayType} != "0")
                    &nbsp;&nbsp;$dictTag.get("repayType.interestRepayType.next",$!{repayTypePage.interestRepayTypeNext})
                #end
            </td>
        </tr>

            ##当利息与金额相关，并且是一次性还本金时，还利息为时间周期时，利息的计算有按实际天数和平均还息的算法
        <tr
            #if("$!{repayTypePage.capitalFrequency}"!="num")
                    style="display: none"
            #end>
            <td class="textRight">#springMessage('table.repayType.interestWay')</td>
            <td>
                $dictTag.get("repayType.interestWay",$!{repayTypePage.interestWay})
            </td>
        </tr>
        <tr>
            ##            计息日
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.expiryDate')</td>
            <td>
                #if($!{repayTypePage.interestDay})
                    #set($interestDay=$!{repayTypePage.interestDay})
                #end
            #if($!{repayTypePage.interestFrequencyNext} == "2")
                $dictTag.get("accrued.week",$interestDay)
            #else
                $dictTag.get("cms.repayType.interestDay",$interestDay)
            #end
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.accrual.validSign')</td>
            <td>
                $dictTag.get("valid_sign",$!{repayTypePage.validSign})
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.accrual.rmk')</td>
            <td>
                $!{repayTypePage.rmk}
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form', 'layedit', 'selectType', 'dicts', 'selectTree', 'rateType', 'moneyType',], function () {
        var $ = bt.jquery, form = bt.form();
        selectTypes = bt.selectType.init();//下拉框
        dicts = bt.dicts.init();//字典
        rateType = bt.rateType.init();
        moneyType = bt.moneyType.init();
        moneyFun = bt.moneyType.getFun();

        initCapitalFrequencyDetail();

        // 本金支付频率详细信息
        function initCapitalFrequencyDetail() {
            var capitalFrequencyType = $("#capitalFrequencyType").val()
            var capitalFrequencyNext = $("#capitalFrequencyNext").val()
            var capitalFrequencyNum = $("#capitalFrequencyNum").val()
            var capitalFrequencyDetail = $("#capitalFrequencyDetail").val()
            if (capitalFrequencyType == "C" && capitalFrequencyNext == "1") {
                var detailNum = Number(capitalFrequencyNum);
                if (detailNum) {
                    $("#capitalFrequencyDetailShow").show();
                    var details = capitalFrequencyDetail.split(",");
                    var html = '';
                    for (var rowNum = 1; rowNum <= detailNum; rowNum++) {
                        var subscript = rowNum - 1;
                        html += '<tr>';
                        html += '<td>' + rowNum + ' </td>';
                        html += '<td>' + moneyFun.format(details[subscript] * 100) + '%</td>';
                        html += '</tr>';
                    }
                    $('#dataTableDetailBody').html(html)
                } else {
                    $("#capitalFrequencyDetailShow").hide();
                }
            }

        }
    });
</script>
</html>

<!DOCTYPE html>  
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #page a, #page span {
            height: 30px;
            line-height: 30px;
        }

        #page .layui-laypage-total {
            padding-right: 0px;
        }
    </style>
</head>
<body>
    <form id="searchForm" class="layui-form">
    <input type="hidden" id="ratCode" name="ratCode" value="${disVO.ratCode}">
    <input type="hidden" id="total" value="${model.total}">
	<input type="hidden" id="curr" value="${model.curr}">
        <table class="layui-table">
            <tbody>
                <tr>
					<td colspan="6" style="text-align: center;">
						<button type="button" class="layui-btn" lay-submit="" lay-filter="add" onclick="add">#springMessage('ration.bkrationdis.add')</button>
						<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
					</td>
				</tr>
            </tbody>
        </table>
    </form>
<div>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.ratBkrationDis.disCode')</th>
        <th>#springMessage('table.ratBkration.corpId')</th>
        <th>#springMessage('table.ratBkrationDis.corpId')</th>
        <th>#springMessage('table.ratBkration.curCode')</th>
        <th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
        <th>#springMessage('table.ratBkrationDetail.itemCode')</th>
        <th>#springMessage('table.ratCpration.disMoney')</th>
        <th>#springMessage('table.ratBkration.begindate')</th>
        <th>#springMessage('table.ratBkration.enddate')</th>
        <th>#springMessage('table.ratBkration.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
    <tbody>
    #foreach($ration in $!{model.rations})
  		<tr>
  			<td align="center" rowspan="$!{ration.itemSize}">$!{ration.disCode}</td>
  			<td align="center" rowspan="$!{ration.itemSize}">$!{ration.ratCorpName}</td>
  			<td align="center" rowspan="$!{ration.itemSize}">$!{ration.corpName}</td>
  			<td align="center" rowspan="$!{ration.itemSize}">$!{ration.curName}</td>
		#foreach($rationDtl in $!{ration.rationDtls})
			#set($vcount = $velocityCount - 1)
  			#if(${vcount} == 0)
		  		#if($!{rationDtl.itemFlag} == "0")
		  	<td align="center">
		  		#else
		  	<td align="center" rowspan="$!{ration.compItemSize}">
		  		#end
  				$dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
  			</td>	
	  		<td align="center">
  				$!{rationDtl.itemName}
  			</td>
  				#if($!{rationDtl.itemFlag} == "0")
		  	<td align="right">
		  		#else
		  	<td align="right" rowspan="$!{ration.compItemSize}">	
		  		#end
  				$number.formatNumeric($!{rationDtl.money})
  			</td>
		  	<td align="center" rowspan="$!{ration.itemSize}">$!date.format('yyyy-MM-dd',$!ration.beginDate)</td>
  			<td align="center" rowspan="$!{ration.itemSize}">$!date.format('yyyy-MM-dd',$!ration.endDate)</td>
  			<td align="center" rowspan="$!{ration.itemSize}">
  				$dictTag.get("common.status", $!{ration.status})
  			</td>
  			<td align="center" rowspan="$!{ration.itemSize}">
  				##操作链接
                #if($!{ration.status} < 11)
                <a class="" href="#" onclick="update('$!{ration.id}')">#springMessage("common.button.edit")</a>&nbsp;|
                <a class="" href="#" onclick="del('$!{ration.id}')">#springMessage("common.button.delete")</a>&nbsp;|
  				#end
  				<a class="" href="#" onclick="view('$!{ration.id}')">#springMessage("common.button.view")</a>&nbsp;|
				<a class="" href="#" onclick="listMsg('$!{ration.id}')">#springMessage("common.button.logInfo")</a>
##					&nbsp;|
##  				<a class="" href="#" onclick="bt.trackFlowByBusinessId('$!{ration.id}')">#springMessage("common.button.trackFlow")</a>
  			</td>
			#else
  		</tr>
		<tr>
				#if($!{rationDtl.itemFlag} == "0")
	  		<td align="center">
  				$dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
  			</td>
	  		<td align="center">
  				$!{rationDtl.itemName}
  			</td>
  			<td align="right">
  				$number.formatNumeric($!{rationDtl.money})
  			</td>
				#else
					#if($!{rationDtl.firstComp} == "1")
			<td align="center" rowspan="$!{ration.compItemSize}">
  				$dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
  			</td>
	  		<td align="center">
  				$!{rationDtl.itemName}
  			</td>
			<td align="right" rowspan="$!{ration.compItemSize}">
  				$number.formatNumeric($!{rationDtl.money})
  			</td>
  					#else
	  		<td align="center">
  				$!{rationDtl.itemName}
  			</td>
  					#end
				#end
		  	#end
  		#end
  		</tr>
	#end
    </tbody>
</table>
</div>
    <div id="page" style="position:fixed ; bottom:0px;width:100%;" ></div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/cpration/ratCprationDised.list.js?_btv=${resourceVersion}"></script>
</html>
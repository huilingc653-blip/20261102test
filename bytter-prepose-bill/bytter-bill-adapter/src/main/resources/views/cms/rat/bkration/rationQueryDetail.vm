<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<input type="hidden" name="changeType" id="changeType" value="$!{changeType}">
	<input type="hidden" id="ratCode" value="$!{queryVO.ratCode}">
	<input type="hidden" id="itemFlag" value="$!{queryVO.itemFlag}">
	<input type="hidden" id="itemCode" value="$!{queryVO.itemCode}">
	<input type="hidden" id="corpId" value="$!{queryVO.corpId}">
	<input type="hidden" id="useType" value="$!{queryVO.useType}">
	<input type="hidden" id="businessName" value="$!{queryVO.businessName}">
</form>
<div>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
	#if($!{rations.size()} > 0)
		<button type="button" class="layui-btn" onclick="exportOccupyDtl()">#springMessage('common.button.exports')</button>
	#end
    <thead>
    <tr>
        <th>#springMessage('table.ratUrationApply.corpId')</th>
        <th>#springMessage('table.ratUrationApply.type')</th>
        <th>#springMessage('table.ratUrationApply.itemCode')</th>
        <th>#springMessage('table.ratBkrationDetail.creditType')</th> ##授信方式
        <th>#springMessage('table.ratUration.curCode')</th>
        <th>#springMessage('table.ratUration.initCurCode')</th>
        <th>#springMessage('table.ratUration.money')</th>
        <th>#springMessage('table.ratUration.convertPreMoney')</th>
        <th>#springMessage('table.ratUration.exchangeRate')</th>
        <th>#springMessage('table.ratUrationApply.beginDate')</th>
        <th>#springMessage('table.ratUrationApply.endDate')</th>
        <th>#springMessage('table.ratUration.billNo')</th>
        <th>#springMessage('table.ratBkration.status')</th>
    </tr>
    </thead>
#foreach($ration in $!{rations})
	<tr>
		<td align="center">$!{ration.corpName}</td>
		<td align="center">$dictTag.get("ratUration.businessName", $!{ration.businessName})</td>
        #*<td align="center">$!{ration.typeName}</td>*#
		<td align="center">$!{ration.itemName}</td>
        <td align="center">$dictTag.get("rat.creditType",$!{ration.creditType})</td>
		<td align="center">$!{ration.curName}</td>
		<td align="center">$!{ration.initCurName}</td>
		<td align="right">$!number.formatNumeric($!{ration.money})</td>
		#*<td align="right">$number.formatNumeric($!{ration.convertPreMoney})</td>*#
		<td align="right">$!number.formatNumeric($!{ration.billMoney})</td>
		<td align="right">
			$!excRateTag.getConvert($!{ration.exchangeRate})
		</td>
		<td align="center">$!date.format('yyyy-MM-dd',$!{ration.beginDate})</td>
		<td align="center">$!date.format('yyyy-MM-dd',$!{ration.endDate})</td>
		<td align="center">$!{ration.billNo}</td>
		<td align="center">
		#if($!{ration.businessName} == "06" || $!{ration.businessName} == "07")
		$dictTag.get("common.status", $!{ration.status})
		#else
		$dictTag.get("uration.status", $!{ration.status})
		#end
		</td>
	</tr>
#end
</table>
</div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationSelect.list.js?_btv=${resourceVersion}"></script>
</html>

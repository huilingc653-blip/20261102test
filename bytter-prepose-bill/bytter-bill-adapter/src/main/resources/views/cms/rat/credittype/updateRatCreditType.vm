<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{ratCreditTypePage.id}">
        <table class="layui-table">
            <tbody>
				<tr>
					##额度类型编码
					<td class="textRight">#springMessage('table.ratCreditType.code')</td>
    				<td width="40%">
						<!--number-->
						<input type="text" id="code" name="code" maxlength="10" readonly="readonly"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratCreditType.code')" value="$!{ratCreditTypePage.code}">
											</td>
					##额度类型名称
					<td class="textRight">#springMessage('table.ratCreditType.name')</td>
                        <td width="40%">
                            <!--number-->
							<div class="layui-inline">
                            <input style="display: inline" type="text" id="name" name="name" lay-verify="required"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.ratCreditType.name')"
                                   value="$!{ratCreditTypePage.name}">
                            </div>
                        </td>
        		</tr>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/credittype/ratCreditType.edit.js?_btv=${resourceVersion}"></script>
</html>
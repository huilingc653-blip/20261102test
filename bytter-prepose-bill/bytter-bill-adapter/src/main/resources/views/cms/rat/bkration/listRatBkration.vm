<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-table > thead th, .layui-table td {
            position: static;
        }

        #page a, #page span {
            height: 30px;
            line-height: 30px;
        }

        #page .layui-laypage-total {
            padding-right: 0px;
        }
    </style>
</head>
<body style="padding-bottom: 40px;">
<form id="searchForm" class="layui-form">
    <input type="hidden" id="curr" value="${model.curr}">
    <input type="hidden" id="pageCount" value="${model.pageCount}">
    <input type="hidden" id="pageSize" value="${model.pageSize}">
    <input type="hidden" id="resultCount" value="${model.resultCount}">
    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            ##授信合同号
            <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.contractNo')</td>
            <td class="rCode" style="width: 23%">
                <div class="layui-input-inline">
                    <input type="text" name="contractNo" id="contractNo" value="$!{contractNo}" class="layui-input">
                </div>
            </td>
            ##授信结束时间
            <td class="textRight" style="width: 10%" hidden>#springMessage('table.ratBkration.ratDate')</td>
            <td style="width: 23%" class="rCode" hidden>
                <input type="text" name="ratDate" id="ratDate" class="layui-input bt-biz-dateType"
                       data-type="date" data-biz-name="ratDate" value="$!{ratDate}">
            </td>

            ##                -------------------------------------------------------------------------
            ## 授信开始时间
            <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.begindate')</td>
            <td style="width: 23%" class="rCode">
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-type="date" data-endid="lBeginDate"
                           data-name="gBeginDate" data-biz-name="gBeginDate" value="$!{gBeginDate}">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-type="date" id="lBeginDate"
                           data-name="lBeginDate" data-biz-name="lBeginDate" value="$!{lBeginDate}">
                </div>
            </td>
            ## 授信结束时间
            <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.enddate')</td>
            <td class="rCode">
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-type="date" data-endid="lEndDate"
                           data-name="gEndDate" data-biz-name="gEndDate" value="$!{gEndDate}" >
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-type="date" id="lEndDate"
                           data-name="lEndDate" data-biz-name="lEndDate" value="$!{lEndDate}" >
                </div>
            </td>

        </tr>

        <tr>

            ##                    授信额度
            <td class="textRight">#springMessage('table.ratBkration.money')</td>
            <td>
                <div class="layui-input-inline" style="width: 45%">
                    <input data-name="gMoney" data-biz-name="gMoney" class="layui-input bt-biz-moneyType" type="text"
                           value="$!{gMoney}" style="width: 67%;display: inline-block">
                    ~
                    <input data-name="lMoney" data-biz-name="lMoney" class="layui-input bt-biz-moneyType" type="text"
                           value="$!{lMoney}" style="width: 67%;display: inline-block">
                </div>
            </td>

            #*                    ##                    银行类型
                                <td class="textRight">#springMessage('table.ratBkration.bankType')</td>
                                <td>
                                    <div>
                                        <div class="bt-biz-selectType" data-biz-name="bankType" data-url="${basePath}/basic/business/btbanktype/json"
                                             data-valuefield="id" data-textfield="typeName" data-defaultvalue="$!{bankType}"
                                             data-name="bankType"></div>
                                    </div>
                                </td>*#
            ##                    银行信息
            <td class="textRight">#springMessage('table.ratBkration.bankCode')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="bankName" id="bankName" value="$!{bankName}" class="layui-input">
                </div>
            </td>
            ##                    授信类型
            <td class="textRight">#springMessage('table.ratBkrationDetail.itemCodeFlag')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="RatModel.ItemFlag"
                         data-defaultvalue="$!{itemFlag}"
                         data-name="itemFlag" data-biz-name="itemFlag">
                    </div>
                </div>
            </td>
        </tr>

        <tr>
            ##                    授信品种
            <td class="textRight">#springMessage('table.ratBkrationDetail.itemCode')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-biz-name="itemCode"
                         data-url="${basePath}/cms/rat/ratitemcustom/getAllRatItem?type=0"
                         data-valuefield="id" data-textfield="name" data-defaultvalue="$!{itemCode}"
                         data-name="itemCode"></div>
                </div>
            </td>

            ##                    受信单位
            <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.corpId')</td>
            <td style="width: 23%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="corpId"
                         data-name="corpId"
                         data-biz-type="corp"
                         data-defaultvalue="$!{corpId}"
                         data-tree-type="check"
                         data-resource="cms:rat:ration:query"
                         data-type="selectTree"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.sysAttachment.createBy')</td>
            <td>
                <input type="text" name="userName" id="userName" class="layui-input"
                       value="$!{userName}">
            </td>
        </tr>
        <tr>
            ## 授信编号
            <td class="textRight">#springMessage('table.ratBkration.ratCode')</td>
            <td>
                <input type="text" name="ratCode" id="ratCode" class="layui-input"
                       value="$!{ratCode}">
            </td>
            ## 担保合同开始时间
            <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.garanteeContract.begindate')</td>
            <td style="width: 23%" class="rCode">
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-type="date" data-endid="lGuaranteeBeginDate"
                           data-name="gGuaranteeBeginDate"  data-biz-name="gGuaranteeBeginDate" value="$!{gGuaranteeBeginDate}">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-type="date" id="lGuaranteeBeginDate"
                           data-name="lGuaranteeBeginDate" data-biz-name="lGuaranteeBeginDate" value="$!{lGuaranteeBeginDate}">
                </div>
            </td>
            ## 担保合同结束时间
            <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.garanteeContract.enddate')</td>
            <td class="rCode">
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-type="date" data-endid="lGuaranteeEndDate"
                           data-name="gGuaranteeEndDate" data-biz-name="gGuaranteeEndDate" value="$!{gGuaranteeEndDate}">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-type="date" id="lGuaranteeEndDate"
                           data-name="lGuaranteeEndDate" data-biz-name="lGuaranteeEndDate" value="$!{lGuaranteeEndDate}">
                </div>
            </td>
        </tr>
        <tr>
            ##状态
            <td class="textRight">#springMessage('table.ratBkration.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="common.status" data-defaultvalue="$!{status}"
                     data-name="status" data-biz-name="status">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">

                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="button" class="layui-btn layui-btn-primary" onClick="setNull()">#springMessage(
                    'common.button.reset')</button>
                ##                        <button type="button" class="layui-btn layui-btn-primary" onClick="resetCode()">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<div>
    <div style="margin-bottom: 5px;">
        <button class="layui-btn" lay-submit="" lay-filter="add" type="button" onclick="add()">#springMessage(
                    'common.button.add')</button>
        <button class="layui-btn" type="button" onclick="importExcel()">#springMessage('导入')</button>
        <button class="layui-btn" type="button" onclick="exports(0)">#springMessage('common.button.exportsCurrentPage')</button>
        <button class="layui-btn" type="button" onclick="exports(1)">#springMessage('common.button.exportsAll')</button>
    </div>
    <table id="appTable" class="layui-table layui-form dark-layui-table layui-table-border" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.ratBkration.ratMode')</th>
            <th>#springMessage('table.ratBkration.ratCode')</th>
            <th>#springMessage('table.ratBkration.contractNo')</th>
            <th>#springMessage('table.ratBkration.corpId')</th>
            <th>#springMessage('table.ratBkration.bankCode')</th>
            <th>#springMessage('table.ratBkration.curCode')</th>
            <th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
            <th>#springMessage('table.ratBkrationDetail.itemCode')</th>
            <th>#springMessage('table.ratBkrationDetail.creditType')</th>##授信方式
            <th>#springMessage('table.ratBkrationDetail.maxMoney')</th>
            <th>#springMessage('table.ratBkration.money')</th>
            <th>#springMessage('table.ratBkration.begindate')</th>
            <th>#springMessage('table.ratBkration.enddate')</th>
            <th>#springMessage('table.ratBkration.garanteeContract.begindate')</th>
            <th>#springMessage('table.ratBkration.garanteeContract.enddate')</th>
            <th>#springMessage('table.sysAttachment.createBy')</th>
            <th>#springMessage('table.ratBkration.status')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
        <tbody>
            #foreach($ration in $!{model.rations})
            <tr>
                <td align="center" rowspan="$!{ration.itemSize}">$dictTag.get(
                    "RatBkration.RatMode", $!{ration.ratMode})</td>
                <td align="center" rowspan="$!{ration.itemSize}">$!{ration.ratCode}</td>
                <td align="center" rowspan="$!{ration.itemSize}">$!{ration.contractNo}</td>
                <td align="center" rowspan="$!{ration.itemSize}">$!{ration.corpName}</td>
                <td align="center" rowspan="$!{ration.itemSize}">$!{ration.bankName}</td>
                <td align="center" rowspan="$!{ration.itemSize}">$!{ration.curName}</td>
                #if($!{ration.rationDtls})
                #foreach($rationDtl in $!{ration.rationDtls})
                    #if(${rationDtl.itemOrder} == 1)
                        #if($!{rationDtl.itemFlag} == "0")
                        <td align="center" rowspan="$!{ration.singItemSize}">
                        #else
                        <td align="center" rowspan="$!{ration.compItemSize}">
                        #end
                        $dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
                        </td>
                        <td align="center">
                            $!{rationDtl.itemName}
                        </td>
                        <td align="center">
                            $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                        </td>

                        <td align="right">
                            $number.formatNumeric($!{rationDtl.maxMoney})
                        </td>

                        #if($!{rationDtl.itemFlag} == "0")
                        <td align="right">
                        #else
                        <td align="right" rowspan="$!{ration.compItemSize}">
                        #end
                        $number.formatNumeric($!{rationDtl.money})
                        </td>
                        <td align="center" rowspan="$!{ration.itemSize}">$!date.format('yyyy-MM-dd',$!ration.beginDate)</td>
                        <td align="center" rowspan="$!{ration.itemSize}">$!date.format('yyyy-MM-dd',$!ration.endDate)</td>
                        <td align="center" rowspan="$!{ration.itemSize}">$!date.format('yyyy-MM-dd',$!ration.guaranteeBeginDate)</td>
                        <td align="center" rowspan="$!{ration.itemSize}">$!date.format('yyyy-MM-dd',$!ration.guaranteeEndDate)</td>
                        <td align="center" rowspan="$!{ration.itemSize}">$!{ration.userName}</td>
                        <td align="center" rowspan="$!{ration.itemSize}">$dictTag.get("common.status", $!{ration.status})</td>
                        <td align="center" rowspan="$!{ration.itemSize}">
                            ##操作链接
                            #if(($!{ration.status} < 11 && $!{ration.status} != -5) || ($!{ration.status}==95 && $!{ration.toUpdate}))
                                <a class="" href="#" onclick="update('$!{ration.id}')">#springMessage("common.button.edit")</a>&nbsp;|
                            #end
                            #if($!{ration.status} < 11 && $!{ration.status} != -5)
                                <a class="" href="#" onclick="deleteColumn('$!{ration.id}')">#springMessage("common.button.delete")</a>&nbsp;|
                            #end
                            <a class="" href="#" onclick="view('$!{ration.id}')">#springMessage("common.button.view")</a>
                        </td>
                    #else
                    </tr>
                    <tr>
                        #if($!{rationDtl.itemFlag} == "0")
                            ##<td align="center">
                            ##    $dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
                            ##</td>
                            <td align="center">
                                $!{rationDtl.itemName}
                            </td>
                            <td align="center">
                                $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                            </td>
                            <td align="right">
                                $number.formatNumeric($!{rationDtl.maxMoney})
                            </td>
                            <td align="right">
                                $number.formatNumeric($!{rationDtl.money})
                            </td>
                        #else
                            #if($!{rationDtl.firstComp} == "1")
                                <td align="center" rowspan="$!{ration.compItemSize}">
                                    $dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
                                </td>
                                <td align="center">
                                    $!{rationDtl.itemName}
                                </td>
                                <td align="center">
                                    $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                                </td>
                                <td align="right">
                                    $number.formatNumeric($!{rationDtl.maxMoney})
                                </td>
                                <td align="right" rowspan="$!{ration.compItemSize}">
                                    $number.formatNumeric($!{rationDtl.money})
                                </td>
                            #else
                                <td align="center">
                                    $!{rationDtl.itemName}
                                </td>
                                <td align="center">
                                    $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                                </td>
                                <td align="right">
                                    $number.formatNumeric($!{rationDtl.maxMoney})
                                </td>
                            #end
                        #end
                    #end
                #end
                #else
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td align="center" >$!date.format('yyyy-MM-dd',$!ration.beginDate)</td>
                    <td align="center" >$!date.format('yyyy-MM-dd',$!ration.endDate)</td>
                    <td align="center" >$!date.format('yyyy-MM-dd',$!ration.guaranteeBeginDate)</td>
                    <td align="center" >$!date.format('yyyy-MM-dd',$!ration.guaranteeEndDate)</td>
                    <td align="center" >$!{ration.userName}</td>
                    <td align="center">$dictTag.get("common.status", $!{ration.status})
                    </td>
                    <td align="center">
                        ##操作链接
                        #if($!{ration.status} < 11 && $!{ration.status} != -5)
                            <a class="" href="#" onclick="update('$!{ration.id}')">#springMessage("common.button.edit")</a>&nbsp;|
                            <a class="" href="#" onclick="deleteColumn('$!{ration.id}')">#springMessage("common.button.delete")</a>&nbsp;|
                        #end
                        <a class="" href="#" onclick="view('$!{ration.id}')">#springMessage("common.button.view")</a>
                    </td>
                #end
            </tr>
            #end
        </tbody>
    <!--    <tfoot>
            #foreach($ratItemSum in $!{ratItemSumList})
                <tr>
                    <td align="right" colspan="9">$!{ratItemSum.sumBusName}</td>
                    <td align="right">$number.formatNumeric($!{ratItemSum.sumMoney})</td>
                    <td colspan="8"></td>
                </tr>
            #end
        </tfoot>-->
        <tfoot>
            <tr>
                <td colspan="18" style="text-align: right; border: none;">
                    <div id="page"></div>
                </td>
            </tr>
        </tfoot>
    </table>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratBkration.list.js?_btv=${resourceVersion}"></script>

</html>
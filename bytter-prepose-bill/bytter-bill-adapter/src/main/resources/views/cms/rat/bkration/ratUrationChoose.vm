<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="changeType" id="changeType" value="${changeType}">
</form>
<div>
    <button class="layui-btn" type="button" onclick="selectAll()">全选</button>
    <table id="appTable" class="layui-table layui-form layui-table-border" style="width:100%;">
        <thead>
        <tr>
            <th></th>
            <th>#springMessage('table.ratUrationApply.corpId')</th>
            <th>#springMessage('table.ratBkration.ratCode')</th>
            <th>#springMessage('table.ratBkration.bankCode')</th>
            <th>#springMessage('table.ratBkration.money')</th>
            <th>#springMessage('table.ratBkrationDisDetail.superProcessMoney')</th>##占用额度
            <th>#springMessage('table.ratBkrationDisDetail.checkProcessMoney')</th>##在审占用额度
            <th>#springMessage('table.ratBkrationDisDetail.overPlusMoney')</th>##可用额度
            <th>#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>##剩余授信额度
            <th>#springMessage('table.ratUrationApply.beginDate')</th>
            <th>#springMessage('table.ratUrationApply.endDate')</th>
        </tr>
        </thead>
        #foreach($urationBean in $!{urationBeans})
            <tr uration-id = "$!{urationBean.urationId}">
                <td align="center" colspan="2">
                    #springMessage('table.ratUration.urationCode')：$!{urationBean.urationCode}
                </td>
                <td align="center">
                    ##需结转金额：
                    #springMessage('table.ratUration.rationMoney')：$number.formatNumeric($!{urationBean.money})
                </td>
                <td colspan="6"></td>
            </tr>
			#if($!{urationBean.rationDtls})
				#foreach($ration in $!{urationBean.rationDtls})
					<tr>
						<td align="center">
							<input type="radio" name="$!{urationBean.urationId}" value="$!{urationBean.urationId},$!{ration.ratCode}" title=" ">
						</td>
						<td align="center">$!{ration.corpName}</td>
						<td align="center">$!{ration.ratNo}</td>
						<td align="center">$!{ration.bankName}</td>
						<td align="right">$number.formatNumeric($!{ration.money})</td>##授信额度
						<td align="right">$number.formatNumeric($!{ration.useMoney})</td>##占用额度
						<td align="right">$number.formatNumeric($!{ration.approveMoney})</td>##在审占用额度
						<td align="right">$number.formatNumeric($!{ration.overPlusMoney})</td>##可用额度
						<td align="right">$number.formatNumeric($!{ration.leftMoney})</td>##剩余授信额度
						<td align="center">$!date.format('yyyy-MM-dd',$!{ration.beginDate})</td>
						<td align="center">$!date.format('yyyy-MM-dd',$!{ration.endDate})</td>
					</tr>
				#end
			#else
				<tr>
					<td colspan="11" align="center"><font color="red">#springMessage('cms.rat.bkration.notexists')</font></td>
				</tr>
			#end
        #end
        <tr>
            <td colspan="11" style="text-align: center;">
                <button type="button" class="layui-btn" onclick="submitRation()">#springMessage('common.button.confirm')</button>
                <button type="button" class="layui-btn" onclick="cancelRation()">#springMessage('common.button.cancel')</button>
            </td>
        </tr>
    </table>
</div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationChoose.list.js?_btv=${resourceVersion}"></script>
</html>

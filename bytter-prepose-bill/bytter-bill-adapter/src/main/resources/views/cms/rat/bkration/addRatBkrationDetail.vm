<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{ratBkrationDetailPage.id}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##授信主键
				<td class="textRight">#springMessage('table.ratBkrationDetail.ratCode')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="ratCode" name="ratCode" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.ratCode')">
										</td>
        		##品种标识
				<td class="textRight">#springMessage('table.ratBkrationDetail.itemFlag')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="itemFlag" name="itemFlag" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.itemFlag')">
										</td>
			</tr>
        	<tr>
        		##授信品种排序
				<td class="textRight">#springMessage('table.ratBkrationDetail.itemOrder')</td>
				<td >
						<!--number-->
                        <input type="text" id="itemOrder" name="itemOrder" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.itemOrder')">
										</td>
        		##授信品种
				<td class="textRight">#springMessage('table.ratBkrationDetail.itemCode')</td>
				<td >
						<!--number-->
                        <input type="text" id="itemCode" name="itemCode" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.itemCode')">
										</td>
			</tr>
        	<tr>
        		##授信金额
				<td class="textRight">#springMessage('table.ratBkrationDetail.money')</td>
				<td >
						<!--number-->
                        <input type="text" id="money" name="money" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.money')">
										</td>
        		##敞口金额
				<td class="textRight">#springMessage('table.ratBkrationDetail.openMoney')</td>
				<td >
						<!--number-->
                        <input type="text" id="openMoney" name="openMoney" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.openMoney')">
										</td>
			</tr>
        	<tr>
        		##已分配授信金额
				<td class="textRight">#springMessage('table.ratBkrationDetail.superDistributeMoney')</td>
				<td >
						<!--number-->
                        <input type="text" id="superDistributeMoney" name="superDistributeMoney" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.superDistributeMoney')">
										</td>
        		##已分配授信敞口金额
				<td class="textRight">#springMessage('table.ratBkrationDetail.superDistributeOpenMoney')</td>
				<td >
						<!--number-->
                        <input type="text" id="superDistributeOpenMoney" name="superDistributeOpenMoney" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.superDistributeOpenMoney')">
										</td>
			</tr>
        	<tr>
        		##追加金额
				<td class="textRight">#springMessage('table.ratBkrationDetail.superAddMoney')</td>
				<td >
						<!--number-->
                        <input type="text" id="superAddMoney" name="superAddMoney" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.superAddMoney')">
										</td>
        		##追加敞口金额
				<td class="textRight">#springMessage('table.ratBkrationDetail.superAddOpenMoney')</td>
				<td >
						<!--number-->
                        <input type="text" id="superAddOpenMoney" name="superAddOpenMoney" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.superAddOpenMoney')">
										</td>
			</tr>
        	<tr>
        		##担保条件
				<td class="textRight">#springMessage('table.ratBkrationDetail.assurecondition')</td>
				<td >
						<!--number-->
                        <input type="text" id="assurecondition" name="assurecondition" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.assurecondition')">
										</td>
        		##保证金比例
				<td class="textRight">#springMessage('table.ratBkrationDetail.assurepercent')</td>
				<td >
						<!--number-->
                        <input type="text" id="assurepercent" name="assurepercent" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.assurepercent')">
										</td>
			</tr>
        	<tr>
        		##利率
				<td class="textRight">#springMessage('table.ratBkrationDetail.interestrate')</td>
				<td >
						<!--number-->
                        <input type="text" id="interestrate" name="interestrate" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.interestrate')">
										</td>
        		##总额共享追加金额
				<td class="textRight">#springMessage('table.ratBkrationDetail.totalMoneyAddMoney')</td>
				<td >
						<!--number-->
                        <input type="text" id="totalMoneyAddMoney" name="totalMoneyAddMoney" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.totalMoneyAddMoney')">
										</td>
			</tr>
        	<tr>
        		##总额共享追加敞口额度
				<td class="textRight">#springMessage('table.ratBkrationDetail.totalMoneyAddOpenMoney')</td>
				<td >
						<!--number-->
                        <input type="text" id="totalMoneyAddOpenMoney" name="totalMoneyAddOpenMoney" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.totalMoneyAddOpenMoney')">
										</td>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/rat/ratBkrationDetail.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>  
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{ratCpration.Id}">
			<input type="hidden" id="ratType" name="ratType" value="1">
			<input type="hidden" id="corpId" name="corpId" value="$!{ratCpration.corpId}">
			<input type="hidden" id="netCode" name="netCode" value="$!{ratCpration.netCode}">
			<input type="hidden" id="updateSign" name="updateSign" value="true">
			<input type="hidden" id="singItemSize" value="$!{ratCpration.singItemSize}">
			<input type="hidden" id="itemSize" value="$!{ratCpration.itemSize}">	
        <table class="layui-table">
			<tbody>
        	<tr>
        		##单位代码
				<td width="12%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="20%">
					<div class="layui-input-inline" id="ratCorpDiv">
            			<div class="bt-biz-corp"
                        data-biz-type="corp"
                        data-type="selectTree"
                        data-name="corpId"
                        data-biz-name="corpId"
                        data-width="300px;"
                        data-resource="cms:cprat:ration:apply"
						data-defaultvalue="$!{ratCpration.corpId}"
						data-required="true"
						data-callback="bt.corpCallback"></div>
                    </div>
				</td>
				##授信合同号
				<td width="13%" class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td width="20%">
					<div class="layui-input-inline">
						<input type="text" id="contractNo" name="contractNo" style="display: inline" #if($!{relateCon}==1 && $!{conType}==0)lay-verify="required"#end
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkration.contractNo')"
							   value="$!{ratCpration.contractNo}">
						#parse("views/dual/manager/conInfo.vm")
					</div>
				</td>
			</tr>
        	<tr>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					<input type="text" name="begindate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="begindate" 
						data-endid="enddate" lay-verify="required" value="$!date.format('yyyy-MM-dd',$!ratCpration.begindate)">
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					<input type="text" name="enddate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="enddate" 
						id="enddate" lay-verify="required" value="$!date.format('yyyy-MM-dd',$!ratCpration.enddate)">
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					<div class="layui-inline">
					<div class="bt-biz-selectType" data-biz-name="curCode" data-url="${basePath}/basic/business/btcurrency/json" 
						data-valuefield="id" data-textfield="curName" data-required="true"
						data-name="curCode" data-search="true" data-defaultvalue="$!{ratCpration.curCode}" ></div>
					</div>						
				</td>
			</tr>
        	<tr>
				<td colspan="6">
					<button class="layui-btn" id="addSingleTr" lay-submit="false" type="button" lay-filter="addSingleTr">#springMessage('ration.addSingleTr')</button>
				</td>
			</tr>
			</tbody>
		</table>
		
		<table id="singleTable" class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		        <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.money')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.maxMoney')</th>
		        <th >#springMessage('common.table.thead.operation')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	<tr style="display: none">
		    		<td>
		    	<tr>
		    </tbody>
			<tfoot>
	    	<tr>
		        <td align="center">#springMessage('table.ratBkration.sumMoney')</td>
		        <td >&nbsp;</td>
		        <td align="right">
		        	<input type="text" id="moneysum" data-name="moneysum" data-biz-name="moneysum" readonly="readonly" data-decimal="2"
						autocomplete="off" class="layui-input bt-biz-moneyType" 
						placeholder="#springMessage('table.ratBkration.money')" value="$!{ratCpration.money}">
				</td>
		        <td >&nbsp;</td>
		        <td >&nbsp;</td>
		    </tr>
		    </tfoot>
		</table>
		<table class="layui-table">
			<tbody>
			<tr>
        		##备注
				<td class="textRight" width="15%">#springMessage('table.ratBkration.remark')</td>
				<td colspan="6">
                	<input type="text" id="remark" name="remark" style="width:90%"
			    		autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkration.remark')"
						value="$!{ratCpration.remark}">
				</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="temp" id="temp">#springMessage('common.button.temp')</button>
					<button class="layui-btn" id="submit" lay-submit="" lay-filter="submit" id="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/cpration/ratCpration.edit.js?_btv=${resourceVersion}"></script>
</html>
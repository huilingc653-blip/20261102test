<!DOCTYPE html>  
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input type="hidden" name="id" value="$!{ratCprationPage.addCode}">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{ratCprationPage.id}">
			<input type="hidden" id="ratType" name="ratType" value="1">
			<input type="hidden" id="flag" name="flag" value="${flag}">
			<input type="hidden" id="itemSize" name="itemSize" value="$!{ratCprationPage.itemSize}">
			<input type="hidden" id="singItemSize" name="singItemSize" value="$!{ratCprationPage.singItemSize}">
			<input type="hidden" id="corpId" name="corpId" value="$!{ratCprationPage.corpId}">
		    <input type="hidden" id="updateSign" name="updateSign" value="true"/>
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="20%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="30%">
					$!{ratCprationPage.corpName}
				</td>
				##授信编号
				<td width="20%" class="textRight">#springMessage('table.ratBkration.ratCode')</td>
				<td width="30%">
                	$!{ratCprationPage.ratCode}
				</td>
			</tr>
        	<tr>
				##授信合同号
				<td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td>
                	$!{ratCprationPage.contractNo}
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratCprationPage.curName}
				</td>
			</tr>
        	<tr>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.endDate)
				</td>
			</tr>
        	<tr>
        		##授信额度
				<td class="textRight">#springMessage('table.ratBkration.money')</td>
				<td >
					$number.formatNumeric($!{ratCprationPage.money})
				</td>
        		##授信敞口额度
				<td class="textRight"></td>
				<td >
				</td>
			</tr>
			</tbody>
		</table>
		
		<table id="singleTable" class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		        <th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th>#springMessage('table.ratBkrationDetail.itemCode')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.oriMoney')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.money')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($rationDtl in $!{ratCprationPage.singRationDtls})
	    		<tr>
    				<td align="center">
	    				$dictTag.get("RatModel.ItemFlag", "0")
    				</td>
	    			<td align="center">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemFlag" id="itemFlag$!{rationDtl.itemOrder}" value="$!{rationDtl.itemFlag}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemCode" value="$!{rationDtl.itemCode}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemOrder" value="$!{rationDtl.itemOrder}">
	    				<input type="hidden" id="assurepercent$!{rationDtl.itemOrder}" value="$!{rationDtl.assurepercent}">
	    				$!{rationDtl.itemName}
					</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.money})
    				</td>
    				<td align="right">
    					<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].money" id="$!{rationDtl.itemOrder}money" data-biz-name="$!{rationDtl.itemOrder}money" 
    						class="layui-input bt-biz-moneyType" data-min="-$!{rationDtl.leftMoney}" value="$!{rationDtl.addMoney}" data-decimal="2" data-minus="true" data-callback="bt.calMoney">
    				</td>
	    		</tr>
	    		#end
		    </tbody>
		    <tfoot>
			    <tr>
	 				<td align="center">#springMessage('table.ratBkrationAdd.sumMoney')</td>
	 				<td></td>
	 				<td></td>
	 				<td align="right">
		 				<input type="text" data-name="moneysum" data-biz-name="moneysum" readonly="readonly" data-decimal="2" value="$!{ratCprationPage.addMoney}"
							autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.ratBkrationDis.money')">
	 				</td>
				</tr>
			</tfoot>
		</table>
		
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" id="temp">#springMessage('common.button.temp')</button>
					<button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/cpration/ratCprationAdd.add.js?_btv=${resourceVersion}"></script>
</html>
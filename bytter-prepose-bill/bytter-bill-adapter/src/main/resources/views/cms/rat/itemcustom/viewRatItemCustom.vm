<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
	<table class="layui-table">
		<tbody>
        	<tr>
                <td width="20%" class="textRight">#springMessage('table.ratItemCustom.name')</td>
        		<td width="30%" >
					$!{ratItemCustomPage.name}
                </td>
                <td width="20%" class="textRight">#springMessage('table.ratItemCustom.flag')</td>
        		<td width="30%" >
        			$dictTag.get("RatModel.RatType", $!{ratItemCustomPage.flag})
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.ratItemCustom.sysItemCode')</td>
        		<td width="30%" >
					$!{ratItemCustomPage.sysItemCode}
               	</td>
                <td class="textRight">#springMessage('table.ratItemCustom.type')</td>
        		<td width="30%" >
					$!{ratItemCustomPage.type}
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.ratItemCustom.ritCode')</td>
        		<td width="30%" >
					$!{ratItemCustomPage.ritCode}
                </td>
           	</tr>
            <tr>
                <td class="textRight">#springMessage('table.ratItemCustom.remark')</td>
        		<td colspan="3">
					$!{ratItemCustomPage.remark}
                </td>
            </tr>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{ratItemCustomPage.id}">
			<input id="type" name="type" type="hidden" value="$!{ratItemCustomPage.type}">
        <table class="layui-table">
            <tbody>
				<tr>
					##授信品种名称
					<td class="textRight">#springMessage('table.ratItemCustom.name')</td>
                        <td width="40%">
                            <!--number-->
							<div class="layui-inline">
                                <input style="display: inline" type="text" id="name" name="name" lay-verify="required"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.ratItemCustom.name')"
                                       value="$!{ratItemCustomPage.name}">
                                <span data-toggle="i18n" data-key-id="$!{ratItemCustomPage.id}"/>
							</div>
                        </td>
					##授信主体类型
					<td class="textRight">#springMessage('table.ratItemCustom.type')</td>
    				<td width="40%">
    					$dictTag.get("RatModel.RatType",$!{ratItemCustomPage.type})
					</td>
        		</tr>
				<tr>
					##系统授信品种
					<td class="textRight">#springMessage('table.ratItemCustom.sysItemCode')</td>
					<td >
						<div class="layui-inline">
						<div class="layui-form">
		                    <select id="sysItemCode" name="sysItemCode" lay-filter="sysItemCode">
								#foreach($itemCode in $!{sysItemCodes})
								#if($!{itemCode.code} == $!{ratItemCustomPage.sysItemCode})
			                    <option value="$!{itemCode.code}" selected="selected">$!{itemCode.name}</option>
								#else
			                    <option value="$!{itemCode.code}">$!{itemCode.name}</option>
								#end
								#end
		                    </select>
	                    </div>
	                    </div>
					</td>
	        		##授信品种类型
					<td class="textRight">#springMessage('table.ratItemCustom.ritCode')</td>
					<td >
						<div class="layui-inline">
						<div class="layui-form">
							<select lay-filter="ritCode" name="ritCode" lay-filter="ritCode">
								#foreach($itemType in $!{ritCodes})
								#if($!{itemType.id} == $!{ratItemCustomPage.ritCode})
			                    <option value="$!{itemType.id}" selected="selected">$!{itemType.ritName}</option>
								#else
			                    <option value="$!{itemType.id}">$!{itemType.ritName}</option>
								#end
								#end
		                    </select>
	                    </div>
	                    </div>
					</td>
        		</tr>
				<tr>
					##备注
					<td class="textRight">#springMessage('table.ratItemCustom.remark')</td>
    				<td colspan="3">
						<!--number-->
						<input type="text" id="remark" name="remark"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratItemCustom.remark')" value="$!{ratItemCustomPage.remark}">
					</td>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/itemcustom/ratItemCustom.edit.js?_btv=${resourceVersion}"></script>
</html>
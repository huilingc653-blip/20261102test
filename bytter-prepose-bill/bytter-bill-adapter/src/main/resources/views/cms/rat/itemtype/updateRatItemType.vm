<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{ratItemTypePage.id}">
		<input id="createName" name="createName" type="hidden" value="$!{ratItemTypePage.createName}">
		<input id="createBy" name="createBy" type="hidden" value="$!{ratItemTypePage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{ratItemTypePage.createDate}">
		<input id="updateName" name="updateName" type="hidden" value="$!{ratItemTypePage.updateName}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{ratItemTypePage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{ratItemTypePage.updateDate}">
        <table class="layui-table">
            <tbody>
				<tr>
					##品种类型编码
					<td class="textRight">#springMessage('table.ratItemType.ritCode')</td>
    				<td width="40%">
						<!--number-->
						<input type="text" id="ritCode" name="ritCode" maxlength="10" readonly="readonly" lay-verify="required"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratItemType.ritCode')" value="$!{ratItemTypePage.ritCode}">
											</td>
					##品种类型名称
					<td class="textRight">#springMessage('table.ratItemType.ritName')</td>
    				<td width="40%">
						<!--number-->
                        <div class="layui-inline">
                        <input type="text" style="display: inline" id="ritName" name="ritName" lay-verify="required"
                               autocomplete="off" class="layui-input"
                               placeholder="#springMessage('table.ratItemType.ritName')"
                               value="$!{ratItemTypePage.ritName}">
                        <span data-toggle="i18n" data-key-id="$!{ratItemTypePage.id}"/>
						</div>
                    </td>
        		</tr>
				<tr>
					##品种类型描述
					<td class="textRight">#springMessage('table.ratItemType.ritDesc')</td>
    				<td colspan="3">
						<!--number-->
						<input type="text" id="ritDesc" name="ritDesc"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratItemType.ritDesc')" value="$!{ratItemTypePage.ritDesc}">
											</td>
        		</tr>
				<tr>
					<td colspan="4" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/itemtype/ratItemType.edit.js?_btv=${resourceVersion}"></script>
</html>
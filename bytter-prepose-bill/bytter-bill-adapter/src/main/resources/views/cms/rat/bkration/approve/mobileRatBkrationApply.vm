#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##资金中心
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.corpName}
        </span>
    </li>
##银行信息
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.bankCode')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.bankName}
        </span>
    </li>
##授信合同号
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.contractNo')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.contractNo}
        </span>
    </li>
##授信币种
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.curCode')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.curName}
        </span>
    </li>
##授信开始时间
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.begindate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
        </span>
    </li>
##授信结束时间
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.enddate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
        </span>
    </li>
##额度使用单位
    <li class="mui-table-view-cell">
		#springMessage('table.ratUrationApply.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.corpName}
        </span>
    </li>
##占用授信品种
#if(${applyDTO.itemFlag} == "0")
    <li class="mui-table-view-cell">
        #springMessage('table.ratUrationApply.itemCode')
        <span class="mui-badge mui-badge-inverted">
            $!{applyDTO.singItemName}
        </span>
    </li>
    #else
    #foreach($applyDtl in $!{applyDTO.applyDtls})
        <li class="mui-table-view-cell">
            #springMessage('table.ratUrationApply.itemCode')
            <span class="mui-badge mui-badge-inverted">
                $!{applyDtl.itemName}
            </span>
        </li>
    #end
#end
##授信类型
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkrationDetail.itemCodeFlag')
        <span class="mui-badge mui-badge-inverted">
            $!dictTag.get("RatModel.ItemFlag", $!{applyDTO.itemFlag})
        </span>
    </li>
##业务品种
    <li class="mui-table-view-cell">
        #springMessage('cms.business.race')
        <span class="mui-badge mui-badge-inverted">
            $!{applyDTO.billName}
        </span>
    </li>
##业务币种
    <li class="mui-table-view-cell">
        #springMessage('table.urationapply.billCurId')
        <span class="mui-badge mui-badge-inverted">
            $!{applyDTO.initCurName}
        </span>
    </li>
##业务金额
    <li class="mui-table-view-cell">
        #springMessage('table.urationapply.billMoney')
        <span class="mui-badge mui-badge-inverted">
            $number.formatNumeric($!{applyDTO.billMoney})
        </span>
    </li>
##是否启用敞口授信
#if($!{isOpenRat}=="1")
    <li class="mui-table-view-cell">
        #springMessage('table.urationapply.isOpenRat')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("sf_yn",$!{applyDTO.isOpenRat})
        </span>
    </li>
#end
##保证金币种
    <li class="mui-table-view-cell">
        #springMessage('table.urationapply.bondCurId')
        <span class="mui-badge mui-badge-inverted">
            $!{applyDTO.bondCurName}
        </span>
    </li>
##保证金比例
    <li class="mui-table-view-cell">
        #springMessage('table.urationapply.bondPercent')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($math.mul($!{applyDTO.assurepercent},100),"#0.0000")%
        </span>
    </li>
##保证金金额
    <li class="mui-table-view-cell">
        #springMessage('table.urationapply.bondMoney')
        <span class="mui-badge mui-badge-inverted">
            $number.formatNumeric($!{applyDTO.bondMoney})
        </span>
    </li>
##担保方式
        <li class="mui-table-view-cell">
            #springMessage('table.guaContract.guaType')
            <span class="mui-badge mui-badge-inverted">
                $!{guaWayNames}
            </span>
        </li>
##开始日期
    <li class="mui-table-view-cell">
        #springMessage('table.ratUrationApply.beginDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!applyDTO.beginDate)
        </span>
    </li>
##结束日期
    <li class="mui-table-view-cell">
        #springMessage('table.ratUrationApply.endDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!applyDTO.endDate)
        </span>
    </li>
##占用期限(系统自动计算)
    <li class="mui-table-view-cell">
        #springMessage('table.ratUrationApply.days')
        <span class="mui-badge mui-badge-inverted">
            $!{applyDTO.applyDays}<span>#springMessage('common.timeUnit.day')</span>
        </span>
    </li>
##合同号
    <li class="mui-table-view-cell">
        #springMessage('table.ratUrationApply.contactNo')
        <span class="mui-badge mui-badge-inverted">
            $!{applyDTO.contactNo}
        </span>
    </li>
##信用证号
    <li class="mui-table-view-cell">
        #springMessage('table.ratUrationApply.lcNo')
        <span class="mui-badge mui-badge-inverted">
            $!{applyDTO.lcNo}
        </span>
    </li>
##票据号码
    <li class="mui-table-view-cell">
        #springMessage('table.ratUrationApply.billNo')
        <span class="mui-badge mui-badge-inverted">
            $!{applyDTO.billNo}
        </span>
    </li>
##备注
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.remark')
            <textarea rows="3" class="layui-textarea" readonly="readonly">$!{applyDTO.remark}</textarea>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

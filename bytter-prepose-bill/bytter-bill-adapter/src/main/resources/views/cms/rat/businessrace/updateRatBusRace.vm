<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	 <input name="id" type="hidden" value="$!{ratRace.id}">
	 <table class="layui-table">
        <tbody>
			<tr>
				<td class="textRight">#springMessage("table.ratUrationApply.type")</td>
				<td width="35%">
					<div class="layui-inline">
                        <input style="display: inline;" type="text" name="raceName" lay-verify="required" class="layui-input" value="$!{ratRace.raceName}">
                        <span data-toggle="i18n" data-key-id="$!{ratRace.id}"/>
					</div>

				</td>
	
				<td class="textRight">#springMessage("cms.bank.rat.race")</td>
				<td width="35%">
					<div class="bt-biz-selectType" data-name="customId" data-biz-name="customId" data-defaultvalue="$!{ratRace.customId}"
						 data-url="${basePath}/cms/rat/ratBusinessRace/getBankCustom" data-required="true"
						 data-valuefield="id" data-textfield="name" data-search="true" data-callback="getRatInfo"></div>
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage("table.cms.ratCorp")</td>
				<td width="35%">
					<input type="text" id="ratType" class="layui-input" readonly="readonly"
						   value="$!dictTag.get("RatModel.RatType",$!{customVO.type})">
				</td>
	
				<td class="textRight">#springMessage("table.ratItemCustom.ritCode")</td>
				<td width="35%">
					<input type="text" id="ritName" readonly="readonly" class="layui-input" value="$!{customVO.ritName}">
				</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage("common.button.submit")</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage("common.button.reset")</button>
				</td>
			</tr>
		</tbody>
	</table>
</form>
#parse("views/common/footer.vm")
</body>
</html>
<script>
bt.use(['form','layedit','corp','selectType','dicts'], function(){
	$ = bt.jquery,form = bt.form();
	bt.corp.init();
	bt.selectType.init();
    bt.dicts.init();
    
	//监听提交
    form.on('submit(submit)', function(data){
    	bt.loading.show();//显示加载中
        var action = "/cms/rat/ratBusinessRace/modify";
        $.post(basePath + action,data.field,function(result){
            if(result.success){
                parent.layer?parent.layer.closeAll():layer.closeAll();
            }
            bt.loading.hide(); //关闭加载中
            parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
        },'JSON');
        return false;
    });
});


function getRatInfo(data) {
    $("#ratType").val(bt.dict("RatModel.RatType",data.type));
    $("#ritName").val(data.ritname);
}
	
</script>
<!DOCTYPE html>  
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
    	<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
        <table class="layui-table">
            <tbody>
                <tr>
                    ##授信使用单位
	                 <td class="textRight">#springMessage('table.ratBkrationDis.corpId')</td>
					<td>
						<div class="layui-input-inline">
							<div class="bt-biz-corp" data-biz-type="corp"
								data-type="selectTree" data-name="eqs_corpId"
								data-biz-name="corpId" data-bizName="corpId"
								data-defaultvalue="$!{corpId}" data-scope="all"></div>
						</div>
					</td> ##授信分配时间
                    <td class="textRight">#springMessage('table.ratBkrationDis.createDate')</td>
                    <td width="40%">
                    	<input type="text" name="ged_startDate1" id="startDate1" class="layui-input bt-input-inline bt-biz-dateType" 
	                		data-type="date" data-biz-name="startDate1" data-endid="startDate2" >
	               		<span class="date-mid">~</span>
	                	<input type="text" name="startDate2" id="startDate2" class="layui-input bt-input-inline bt-biz-dateType" 
	                		data-type="date" data-biz-name="startDate2" >
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.ratBkrationDis.disCode')</th>
        <th>#springMessage('table.ratBkration.curName')</th>
        <th>#springMessage('table.ratCpration.disMoney')</th>
        <th>#springMessage('table.ratBkrationDis.createDate')</th>
        <th>#springMessage('table.ratBkrationDis.corpId')</th>
        <th>#springMessage('table.ratBkration.ratCode')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
</table>
#workFlowHtml()
	#parse("views/common/footer.vm")
	#workFlowScript()
	<script src="${basePath}/static/modules/cms/rat/cpration/ratCprationDisApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{applyDTO.id}">
			<input id="disCode" name="disCode" type="hidden" value="$!{ratBkrationPage.disCode}">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{ratBkrationPage.id}">
			<input id="curCode" name="curCode" type="hidden" value="$!{ratBkrationPage.curCode}">
			<input type="hidden" id="corpId" name="corpId" value="$!{ratBkrationPage.corpId}">
			<input type="hidden" id="ratType" name="ratType" value="0">
            <input type="hidden" value="$!{applyDTO.guaWay}" name="guaWay" id="guaWays"/>
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="15%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="18%">
					$!{ratBkrationPage.ratCorpName}
				</td>
				##银行信息
				<td width="15%" class="textRight">#springMessage('table.ratBkration.bankCode')</td>
				<td width="18%">
					$!{ratBkrationPage.bankName}
				</td>
				##授信合同号
				<td width="15%" class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td width="19%">
                	$!{ratBkrationPage.contractNo}
				</td>
			</tr>
        	<tr>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratBkrationPage.curName}
				</td>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
				</td>
			</tr>
			<tr>
        		##额度使用单位
				<td class="textRight">#springMessage('table.ratUrationApply.corpId')</td>
				<td >
					$!{ratBkrationPage.corpName}
				</td>
				##占用授信品种
                    <td class="textRight">#springMessage('table.ratUrationApply.itemCode')</td>
                    <td >
                        <input type="hidden" name="itemFlag" id="itemFlag" value="$!{applyDTO.itemFlag}">
						#if(${applyDTO.itemFlag} == "0")
                            <input type="hidden" name="itemCode" id="itemCode" value="$!{applyDTO.singItemCode}">
							$!{applyDTO.singItemName}
						#else
							#foreach($applyDtl in $!{applyDTO.applyDtls})
								#set($vcount = $velocityCount - 1)
                                <input type="hidden" id="itemOrder" value="$!{applyDtl.itemOrder}"/>
                                <input type="hidden" name="applyDtls[$!{applyDtl.itemOrder}].itemOrder" id="$!{applyDtl.itemOrder}itemOrder" value="$!{applyDtl.itemOrder}">
                                <input  type="hidden" name="applyDtls[$!{applyDtl.itemOrder}].itemCode" id="$!{applyDtl.itemOrder}itemCode"
                                        itemOrder="$!{applyDtl.itemOrder}" id="itemCode$!{applyDtl.itemOrder}" value="$!{applyDtl.itemCode}">
								$!{applyDtl.itemName}
                                <input type="hidden" data-name="applyDtls[$!{applyDtl.itemOrder}].maxMoney" data-biz-name="maxMoney$!{applyDtl.itemOrder}"
                                       data-id="maxMoney$!{applyDtl.itemOrder}" class="layui-input bt-biz-moneyType" data-decimal="2" data-max="$!{applyDtl.leftMaxMoney}"
                                       data-minus="false"  value="$!{applyDtl.maxMoney}">

							#end
						##					<table class="layui-table" width="100%" style="margin:0px">
						##						<tr>
						##							<th>#springMessage("table.ratBkrationDetail.itemCodeFlag")</th>
						##							<th>#springMessage("table.ratBkrationDetail.itemCode")</th>
						##							<th>#springMessage("table.ratUrationApply.money")</th>
						##						</tr>
						##						#foreach($applyDtl in $!{applyDTO.applyDtls})
						##							#set($vcount = $velocityCount - 1)
						##							<tr>
						##								#if($!{vcount} == "0")
						##								<td rowspan="$!{applyDTO.applyDtlSize}">$dictTag.get("RatModel.ItemFlag", "$!{applyDTO.itemFlag}")</td>
						##								#end
						##								<td>
						##									<input type="hidden" name="applyDtls[$!{applyDtl.itemOrder}].itemOrder" id="$!{applyDtl.itemOrder}itemOrder" value="'+item.itemOrder+'">
						##									<input type="hidden" name="applyDtls[$!{applyDtl.itemOrder}].itemCode" id="$!{applyDtl.itemOrder}itemCode"
						##										itemOrder="$!{applyDtl.itemOrder}" id="itemCode$!{applyDtl.itemOrder}" value="$!{applyDtl.itemCode}">
						##									$!{applyDtl.itemName}
						##								</td>
						##								<td align="right">
						##									$number.formatNumeric($!{applyDtl.maxMoney})
						##								</td>
						##							</tr>
						##							#end
						##					</table>
						#end
                    </td>
					##授信额度类型
					<td class="textRight">#springMessage('table.ratBkrationDetail.creditType')</td>
					<td>
						$!dictTag.get("rat.creditType", $!{applyDTO.ratCreditType})
					</td>
			</tr>
			<tr>
			##授信类型
                <td class="textRight">#springMessage('table.ratBkrationDetail.itemCodeFlag')</td>
                <td >
                    <input type="hidden" name="itemFlag" id="itemFlag" value="$!{applyDTO.itemFlag}">
					$!dictTag.get("RatModel.ItemFlag", $!{applyDTO.itemFlag})
                </td>
			##业务品种
                <td class="textRight">#springMessage('cms.business.race')</td>
                <td >
					$!{applyDTO.billName}
                </td>
			##业务币种
                <td class="textRight">#springMessage('table.urationapply.billCurId')</td>
                <td >
					$!{applyDTO.initCurName}
                </td>
			</tr>
			<tr>
			##业务金额
                <td class="textRight">#springMessage('table.urationapply.billMoney')</td>
                <td >
					$!number.formatNumeric($!{applyDTO.billMoney})
                </td>
				#if($!{isOpenRat}=="1")
				##是否启用敞口授信
                    <td class="textRight">#springMessage('table.urationapply.isOpenRat')</td>
                    <td >
						$dictTag.get("sf_yn",$!{applyDTO.isOpenRat})
                    </td>
				#end
			##保证金币种
                <td width="15%" class="textRight">#springMessage('table.urationapply.bondCurId')</td>
                <td width="18%">
					$!{applyDTO.bondCurName}
                </td>
			</tr>
			<tr>
			##保证金比例
                <td width="15%" class="textRight">#springMessage('table.urationapply.bondPercent')</td>
                <td width="18%">
					$!number.formatNumeric($math.mul($!{applyDTO.assurepercent},100),"#0.00")%
                </td>
			##保证金金额
                <td width="15%" class="textRight">#springMessage('table.urationapply.bondMoney')</td>
                <td width="18%">
					$!number.formatNumeric($!{applyDTO.bondMoney})
                </td>
			##授信占用金额
                <td width="15%" class="textRight">#springMessage('table.ratUrationApply.money')</td>
                <td width="18%">
					$!number.formatNumeric($!{applyDTO.money})
                </td>
			</tr>
			<tr>
			##担保方式
				#if($!{isGuarantee}=="1")
                    <td  width="15%" class="textRight">#springMessage('table.guaContract.guaType')</td>
                    <td  width="18%">
					##                    <div class="cks" data-biz-name="guaTypes"></div>
					$!{guaWayNames}
                    </td>
				#end
            ##开始日期
                <td width="15%" class="textRight">#springMessage('table.ratUrationApply.beginDate')</td>
                <td width="18%">
                    $!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
                </td>
            ##结束日期
                <td width="15%" class="textRight">#springMessage('table.ratUrationApply.endDate')</td>
                <td width="18%">
                    $!date.format('yyyy-MM-dd',$!applyDTO.endDate)
                </td>
			</tr>
        	<tr>
			##占用期限(系统自动计算)
                <td width="15%" class="textRight">#springMessage('table.ratUrationApply.days')</td>
                <td width="19%">
					$!{applyDTO.applyDays}<span>#springMessage('common.timeUnit.day')</span>
                </td>
        		##合同号
				<td class="textRight">#springMessage('table.ratUrationApply.contactNo')</td>
				<td >
					$!{applyDTO.contactNo}
				</td>
			##信用证号
                <td class="textRight">#springMessage('table.ratUrationApply.lcNo')</td>
                <td>
					$!{applyDTO.lcNo}
                </td>
			</tr>
			<tr>
			##票据号码
                <td class="textRight">#springMessage('table.ratUrationApply.billNo')</td>
                <td >
					$!{applyDTO.billNo}
                </td>
			</tr>
			<tr>
			##备注
                <td class="textRight">#springMessage('table.ratBkration.remark')</td>
                <td colspan="5">
					$!{applyDTO.remark}
                </td>
			</tr>
            <tr>
			##附件
                <td class="textRight">#springMessage('table.ratBkration.attach')</td>
                <td colspan="5">
                    <!-- 附件上传 -->
                    <input id="annexNameInfo" name="annexNameInfo" type="hidden" value="$!{applyDTO.attachmentId}">
                    <div id="uploaderInfo" class="layui-input-inline" style="width:100%"></div>
                </td>
            </tr>
			</tbody>
		</table>
		#if($!{viewFlag} == "1")
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button type="button" onclick="closeTab()" class="layui-btn">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
        #end
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
var ck;
bt.use(['form','layedit','checkboxs','btUpload'], function(){
	var $ = bt.jquery,form = bt.form();
    var gInfoId = $("#annexNameInfo").val();
    bt.btUpload.init({
        elem: "#uploaderInfo",
        hasUpload: false,
        hasDelete: false,
        isExpand: true,
        gid: gInfoId
    });

    // 担保方式
    ck = bt.checkboxs.initGetCurrent({
        elem : ".cks",
        name : "guaTypes",
        valueField : "id",
        textField : "name",
        url : basePath + "/cms/guarantee/guaContractInfo/json",
        checkAll : false,
        required : true,
        checkedvalue: $("#guaWays").val(),

    });
});

var closeTab =  function(){
	if(!bt.navtab){
        parent.layer?parent.layer.closeAll():layer.closeAll();
    } else {
    	//bt.navtab.refreshParent();
    	bt.navtab.closeCurrent();
    }
	return false;
};

</script>
</html>
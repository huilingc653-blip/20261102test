<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="searchForm">
    <table class="layui-table">
        <tr>
        ##                融资方
            <td class="textRight" style="width: 15%">#springMessage('uration.financCorp')</td>
            <td style="width: 35%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-resource="cms:rat:rationItemUse:query"></div>
                </div>
            </td>
##            贷款行
            <td class="textRight" style="width: 15%">#springMessage('common.loanBank')</td>
            <td>
                <input class="layui-input" name="likes_bankName">
            </td>
        </tr>
        <tr>
##            银行授信品种
            <td class="textRight" style="width: 15%">#springMessage('cms.bank.rat.race')</td>
            <td style="width: 35%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-biz-name="itemCode" data-url="${basePath}/cms/rat/ratitemcustom/getAllRatItem?type=0"
                         data-callback="setBusinessRac"
                         data-valuefield="id" data-textfield="name" data-name="eqs_itemCode" data-search="true">
                    </div>
                </div>
            </td>
##    业务品种
            <td class="textRight" style="width: 15%">#springMessage('cms.business.race')</td>
            <td>
                <div class="bt-biz-selectType" data-biz-name="billName" data-url=""
                     data-valuefield="id" data-textfield="raceName" data-name="eqs_billName" data-search="true" >
                </div>
            </td>
        </tr>
        <tr>
##            业务币种
            <td class="textRight" style="width: 15%">#springMessage('table.urationapply.billCurId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_initCurCode" data-inputValue="false"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName" data-biz-name="initCurId"></div>
                </div>
            </td>
##    业务金额
    <td class="textRight">#springMessage('table.urationapply.billMoney')</td>
    <td>
        <div class="layui-inline">
            <input data-name="geg_billMoney" data-moneyendid="endMoney" class="layui-input bt-biz-moneyType" type="text">
        </div>
        <div class="layui-inline">
            <span class="date-mid">~</span>
        </div>
        <div class="layui-inline">
            <input id="endMoney" data-name="leg_billMoney" class="layui-input bt-biz-moneyType" type="text">
        </div>
    </td>
        </tr>
        <tr>
        ##借入日期
            <td class="textRight">#springMessage('cms.borrowDate')</td>
            <td width="40%" class="rCode">
                <div class="layui-inline layui-input-inline">
                    <input type="text" name="ged_beginDate" id="beginDate"  data-endid="endDate" class="layui-input bt-input-inline bt-biz-dateType"
                           data-type="date" data-biz-name="beginDate" value="$!{beginDate}">
                </div>
            </td>
            ##到期日期
            <td class="textRight">#springMessage('cms.common.deadlineDate')</td>
            <td width="40%" class="rCode">
                <div class="layui-inline layui-input-inline">
                    <input type="text" name="led_endDate" id="endDate" class="layui-input bt-input-inline bt-biz-dateType"
                           data-type="date" data-biz-name="endDate" value="$!{endDate}">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" type="button" lay-submit="" lay-filter="search">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="datatable" class="layui-table" style="width:100%">
    <thead>
    <tr>
        <th>#springMessage('cms.bank.rat.race')</th>##业务品种
        <th>#springMessage('cms.business.race')</th>##业务品种
        <th>#springMessage('table.ratBkrationDetail.creditType')</th> ## 授信方式
        <th>#springMessage('uration.financCorp')</th>##融资方
        <th>#springMessage('common.loanBank')</th>##贷款行
        <th>#springMessage('cms.borrowDate')</th>##借入日期
        <th>#springMessage('cms.common.deadlineDate')</th>##到期日期
        <th>#springMessage('table.urationapply.billCurId')</th>##业务币种
        <th>#springMessage('cms.ratUration.applayMoney')</th>##占用金额
        <th>#springMessage('table.urationapply.billMoney')</th>##业务金额
        <th>#springMessage('international.credit.nativeCreditMoney')</th>##折合本位币金额
        <th>#springMessage('table.ratUration.exchangeRate')</th>##汇率
        <th>#springMessage('table.urationapply.bondPercent')</th>##保证金比例
        <th>#springMessage('table.urationapply.bondMoney')</th>##保证金金额
        <th>#springMessage('table.guaContract.guaType')</th>##担保方式
        <th>#springMessage('table.ratBkrationAdd.remark')</th>##备注
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery', 'form', 'dicts', 'dateType', 'selectType', 'rateType', 'moneyType', 'corp', 'datatable'], function () {
        $ = bt.jquery;
        form = bt.form();
        dicts = bt.dicts.init();//字典
        dateObj = bt.dateType.init();//时间
        selectType = bt.selectType.init();//下拉选择
        rateType = bt.rateType.init();//利率
        moneyType = bt.moneyType.init();//金额
        corp = bt.corp.init();//单位
        fun = bt.moneyType.getFun()
        //这里填写新的js代码，请参考前端文档
        var datatable = bt.datatable.init({
            elem: "#datatable",
            checkbox: false,
            ajax: {
                url: basePath + "/cms/rat/raturation/getRaturationUsedItemDetail",
                dataSrc: "data"
            }, colReorder: true,
            columns: [
                {
                    data: "sysItemName",
                    className: "center"
                },
                {
                    data: "raceName",
                    className: "center"
                },
                {
                    data: "creditType",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return  bt.dict("rat.creditType", full.creditType);
                    }
                },
                {
                    data: "corpName",
                    className: "center"
                }, {
                    data: "bankName",
                    className: "center"
                }, {
                    data: "beginDate",
                    className: "center",
                    render:function( data, type, full, meta){
                        return bt.date.format(full.beginDate, 'yyyy-MM-dd');
                    }
                }, {
                    data: "endDate",
                    className: "center",
                    render:function( data, type, full, meta){
                        return bt.date.format(full.endDate, 'yyyy-MM-dd');
                    }
                }, {
                    data: "initCurName",
                    className: "center"
                }, {
                    data: "money",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return fun.format(row.money);
                    }
                }, {
                    data: "billMoney",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return fun.format(row.billMoney);
                    }
                }, {
                    data: "convertPreMoney",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return fun.format(row.convertPreMoney);
                    }
                }, {
                    data: "exchangeRate",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return fun.formatConvert(row.exchangeRate);
                    }
                }, {
                    data: "assurepercent",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return fun.format(row.assurepercent * 100, {decimal: 2}) + "%";
                    }
                }, {
                    data: "bondMoney",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return fun.format(row.bondMoney);
                    }
                },{
                    data: "guaWay",
                    className: "center"
                }, {
                    data: "remark",
                    className: "center"
                }
            ],
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search",
                callback: function (data) {

                }
            }
        });
    });


    /**
     * 设置业务品种
     * @param data
     * @param elem
     * @param beforevalue
     * @param wrapObj
     */
    function setBusinessRac(data, elem, beforevalue, wrapObj) {
        var url = basePath + "/cms/rat/ratBusinessRace/getBillByCustomId?customId="+data.id;
        selectType.get("billName").val("");
        selectType.get("billName").attr("data-url", url);
        selectType.get("billName").init();
    }
</script>
</body>
</html>
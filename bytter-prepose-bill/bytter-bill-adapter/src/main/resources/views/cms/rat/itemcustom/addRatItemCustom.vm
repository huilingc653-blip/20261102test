<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{ratItemCustomPage.id}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##授信品种名称
				<td class="textRight">#springMessage('table.ratItemCustom.name')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="name" name="name" lay-verify="required" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratItemCustom.name')">
				</td>
        		##授信主体类型
				<td class="textRight">#springMessage('table.ratItemCustom.type')</td>
				<td width="40%">
					<div class="layui-form">
					    <div class="bt-biz-dict" data-type="select" data-group="RatModel.RatType" data-required="true"
					    	data-defaultvalue="0" data-name="type" data-biz-name="type" data-callback="bt.getSysItemCode"></div>
					</div>
				</td>
			</tr>
        	<tr>
        		##系统授信品种
				<td class="textRight">#springMessage('table.ratItemCustom.sysItemCode')</td>
				<td >
					<div class="layui-inline">
					<div class="layui-form">
	                    <select id="sysItemCode" name="sysItemCode" lay-filter="sysItemCode">
							#foreach($itemCode in $!{sysItemCodes})
		                        <option value="$!{itemCode.code}">$!{itemCode.name}</option>
							#end
	                    </select>
                    </div>
                    </div>
				</td>
        		##授信品种类型
				<td class="textRight">#springMessage('table.ratItemCustom.ritCode')</td>
				<td >
					<div class="layui-inline">
					<div class="layui-form">
						<select lay-filter="ritCode" name="ritCode" >
							#foreach($itemType in $!{ritCodes})
		                    <option value="$!{itemType.id}">$!{itemType.ritName}</option>
							#end
	                    </select>
                    </div>
                    </div>
				</td>
			</tr>
        	<tr>
        		##备注
				<td class="textRight">#springMessage('table.ratItemCustom.remark')</td>
				<td colspan="3">
						<!--number-->
                        <input type="text" id="remark" name="remark" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratItemCustom.remark')">
				</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/itemcustom/ratItemCustom.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input type="hidden" name="rowIndex" id="rowIndex" value="$!{rowIndex}">
        <table class="layui-table">
			<tbody>
        	<tr>
##        		##担保条件
##				<td width="15%" class="textRight">#springMessage('table.ratBkrationDetail.assurecondition')</td>
##				<td width="20%">
##					<input type="text" id="assurecondition" name="assurecondition"
##						autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkrationDetail.assurecondition')" 
##						value="$!{ratBkrationDtlPage.assurecondition}">
##				</td>
				##保证金金额
				<td class="textRight">#springMessage('table.fcBond.bondmoney')</td>
				<td >
					<input class="layui-input bt-biz-moneyType" data-maxlength="20"  data-name="bondMoney"  data-biz-name="bondMoney"
						   data-decimal="2" data-minus="false" type="text" value="$!{ratBkrationDtlPage.bondMoney}">
				</td>
				##保证金比例
				<td width="12%" class="textRight">#springMessage('table.ratBkrationDetail.assurepercent')</td>
				<td width="20%">
					<input type="text" data-name="assurepercent" data-decimal="2" data-minus="false" data-biz-name="assurepercent"
						   data-max="100" data-min="0" class="layui-input bt-biz-rateType" value="$!{ratBkrationDtlPage.assurepercent}">
				</td>
			</tr>
			
			<tr>
				##手续费用	
                <td class="textRight">#springMessage('table.fcChargeAccrue.chargeMoney')</td>
                <td >
                    <input class="layui-input bt-biz-moneyType" data-maxlength="20"  data-name="procedureFee"  data-biz-name="procedureFee"
                           data-decimal="2" data-minus="false" type="text" value="$!{ratBkrationDtlPage.procedureFee}">
                </td>

				##利率/费率
				<td width="12%" class="textRight">#springMessage('table.guaGuarantee.handleRate')</td>
				<td width="20%">
					<input type="text" data-name="procedureFeeRate" data-decimal="4" data-minus="false" data-biz-name="procedureFeeRate"
						   data-max="100" data-min="0" class="layui-input bt-biz-rateType" value="$!{ratBkrationDtlPage.procedureFeeRate}">
				</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button type="button" class="layui-btn" lay-submit="" lay-filter="commit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
bt.use(['form','layedit','moneynum', 'selectType','rateType','moneyType'], function(){
	var $ = bt.jquery,form = bt.form();
	var rateTye = bt.rateType.init();
    var moneyType = bt.moneyType.init();
    
	//监听提交
    form.on('submit(commit)', function(data){
    	//parent.document.getElementById("applySourceType").value=${param.type};  
        
    	var rowIndex = $("#rowIndex").val();
        //获取值
        var assurepercent = rateTye.get("assurepercent").val();
        var procedureFeeRate = rateTye.get("procedureFeeRate").val();
        var bondMoney = moneyType.get("bondMoney").val();
        var procedureFee = moneyType.get("procedureFee").val();
        parent.getAssure(rowIndex, assurepercent, procedureFeeRate, bondMoney,procedureFee);
        
        var index = parent.layer.getFrameIndex(window.name); //先得到当前iframe层的索引
        parent.layer.close(index); //再执行关闭    
    	return false;
    });
	
});

</script>
</html>
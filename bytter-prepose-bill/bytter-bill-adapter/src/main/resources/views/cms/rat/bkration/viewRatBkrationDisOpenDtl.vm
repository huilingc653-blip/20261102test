<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{ratBkrationPage.disCode}">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{ratBkrationPage.id}">
			<input type="hidden" id="ratType" name="ratType" value="0">
			<input type="hidden" id="ratCorpId" name="ratCorpId" value="$!{ratBkrationPage.corpId}">
			<input type="hidden" id="disCorpId" name="disCorpId" value="$!{ratBkrationPage.disCorpId}">
			<input type="hidden" id="disWay" name="disWay" value="$!{ratBkrationPage.disWay}">
			<input type="hidden" id="itemSize" name="itemSize" value="$!{ratBkrationPage.itemSize}">
			<input type="hidden" id="singItemSize" name="singItemSize" value="$!{ratBkrationPage.singItemSize}">
			<input type="hidden" id="compItemSize" name="compItemSize" value="$!{ratBkrationPage.compItemSize}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="20%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="30%">
					$!{ratBkrationPage.corpName}
				</td>
				##授信编号
				<td width="20%" class="textRight">#springMessage('table.ratBkration.ratCode')</td>
				<td width="30%">
                	$!{ratBkrationPage.ratCode}
				</td>
			</tr>
        	<tr>
        		##授信银行编号
				<td class="textRight">#springMessage('table.ratBkration.bankType')</td>
				<td >
					$!{ratBkrationPage.TypeName}
				</td>
        		##授信银行编号
				<td class="textRight">#springMessage('table.ratBkration.bankCode')</td>
				<td >
					$!{ratBkrationPage.bankName}
				</td>
			</tr>
        	<tr>
				##授信合同号
				<td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td>
                	$!{ratBkrationPage.contractNo}
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratBkrationPage.curName}
				</td>
			</tr>
        	<tr>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
				</td>
			</tr>
        	<tr>
        		##授信额度
				<td class="textRight">#springMessage('table.ratBkration.money')</td>
				<td >
					$number.formatNumeric($!{ratBkrationPage.disMoney})
				</td>
        		##授信敞口额度
				<td class="textRight">#springMessage('table.ratBkration.openMoney')</td>
				<td >
					$number.formatNumeric($!{ratBkrationPage.disOpenMoney})
				</td>
			</tr>
        	<tr>
        		##授信分配方式
				<td class="textRight">#springMessage('table.ratBkrationDis.distributeWay')</td>
				<td >
					$dictTag.get("RatBkrationDis.DistributeWay", $!{ratBkrationPage.disWay})
				</td>
        		##额度类型
				<td class="textRight">#springMessage('table.ratBkrationDis.type')</td>
				<td >
					$!{ratBkrationPage.creditTypeName}
				</td>
			</tr>
        	<tr>
        		##二次授信对象
				<td class="textRight">#springMessage('table.ratBkrationDis.corpId')</td>
				<td colspan="3">
					$!{ratBkrationPage.disCorpName}
				</td>
			</tr>
			</tbody>
		</table>
		
		<table id="singleTable" class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		        <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.money')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.openMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDisDetail.leftDisOpenMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.maxMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDisDetail.leftMaxMoney')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($rationDtl in $!{ratBkrationPage.singRationDtls})
	    		<tr>
    				<td align="center">
	    				$dictTag.get("RatModel.ItemFlag", "0")
    				</td>
	    			<td align="center">
	    				$!{rationDtl.itemName}
					</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.disMoney})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.leftMoney})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.disOpenMoney})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.leftOpenMoney})
    				</td>
	    			<td></td>
	    			<td></td>
	    		</tr>
	    		#end
		   ##综合授信
	    	#foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
	    		#set($vcount = $velocityCount - 1)
	    		<tr>
	    			#if($!{vcount} == "0")
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
	    				$dictTag.get("RatModel.ItemFlag", "1")
    				</td>
	    			#end
	    			<td align="center">
	    				$!{rationDtl.itemName}
					</td>
					#if($!{vcount} == "0")
					<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
						$number.formatNumeric($!{rationDtl.disMoney})
    				</td>
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					$number.formatNumeric($!{rationDtl.leftMoney})
    				</td>
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					$number.formatNumeric($!{rationDtl.disOpenMoney})
    				</td>
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					$number.formatNumeric($!{rationDtl.leftOpenMoney})
    				</td>
	    			#end
	    			<td align="right">
	    				$number.formatNumeric($!{rationDtl.disMaxMoney})
	    			</td>
	    			<td align="right">
    					$number.formatNumeric($!{rationDtl.leftMaxMoney})
	    			</td>
	    		</tr>
	    	#end
		    </tbody>
		    <tfoot>
			    <tr>
	 				<td align="center">#springMessage('table.ratBkration.sumMoney')</td>
	 				<td></td>
	 				<td align="right">
		 				$number.formatNumeric($!{ratBkrationPage.disMoney})
	 				</td>
	 				<td></td>
	 				<td align="right">
		 				$number.formatNumeric($!{ratBkrationPage.disOpenMoney})
	 				</td>
	 				<td></td>
	 				<td></td>
	 				<td></td>
				</tr>
			</tfoot>
		</table>
		#if($!{viewFlag} == "1")
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button type="button" onclick="closeTab()" class="layui-btn">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
        #end
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
bt.use(['form','layedit'], function(){
	var $ = bt.jquery,form = bt.form();
    //监听提交
});

var closeTab =  function(){
	if(!bt.navtab){
        parent.layer?parent.layer.closeAll():layer.closeAll();
    } else {
    	//bt.navtab.refreshParent();
    	bt.navtab.closeCurrent();
    }
	return false;
};

</script>
</html>
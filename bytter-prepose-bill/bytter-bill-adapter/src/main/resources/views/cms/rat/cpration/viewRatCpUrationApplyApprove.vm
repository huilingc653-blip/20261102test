<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input type="hidden" id="taskId" name= "taskId" value="$!{taskId}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="15%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="18%">
					$!{ratCprationPage.corpName}
				</td>
				##授信编号
				<td width="15%" class="textRight">#springMessage('table.ratBkration.ratCode')</td>
				<td width="18%">
					$!{ratCprationPage.ratCode}
				</td>
				##授信合同号
				<td width="15%" class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td width="19%">
                	$!{ratCprationPage.contractNo}
				</td>
			</tr>
        	<tr>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratCprationPage.curName}
				</td>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.endDate)
				</td>
			</tr>
			<tr>
        		##额度使用单位
				<td class="textRight">#springMessage('table.ratUrationApply.corpId')</td>
				<td >
					$!{ratCprationPage.corpName}
				</td>
        		##业务名称
				<td class="textRight">#springMessage('table.ratUrationApply.type')</td>
				<td >
					<input type="hidden" name="type" id="type" value="$!{applyDTO.type}">
					$!{applyDTO.typeName}
				</td>
        		##占用授信品种
				<td class="textRight">#springMessage('table.ratUrationApply.itemCode')</td>
				<td >
					$!{applyDTO.singItemName}
				</td>
			</tr>
        	<tr>
        		##开始日期
				<td width="15%" class="textRight">#springMessage('table.ratUrationApply.beginDate')</td>
				<td width="18%">
					$!date.format('yyyy-MM-dd',$!applyDTO.beginDate)
				</td>
				##结束日期
				<td width="15%" class="textRight">#springMessage('table.ratUrationApply.endDate')</td>
				<td width="18%">
					$!date.format('yyyy-MM-dd',$!applyDTO.endDate)
				</td>
        		##合同号
				<td class="textRight">#springMessage('table.ratUrationApply.contactNo')</td>
				<td >
					$!{applyDTO.contactNo}
				</td>
			</tr>
			<tr>
        		##授信占用金额
				<td class="textRight">#springMessage('table.ratUrationApply.money')</td>
					<td >$number.formatNumeric($!{applyDTO.money})</td>
					##信用证号
                    <td class="textRight">#springMessage('table.ratUrationApply.lcNo')</td>
                    <td >
						$!{applyDTO.lcNo}
                    </td>
        		##票据号码
				<td class="textRight">#springMessage('table.ratUrationApply.billNo')</td>
				<td >
					$!{applyDTO.billNo}
				</td>
			</tr>
			<tr>
        		##备注
				<td class="textRight">#springMessage('table.ratBkration.remark')</td>
				<td colspan="5">
					$!{applyDTO.remark}
				</td>
			</tr>
			</tbody>
		</table>
	</form>
#workFlowHtml()
	#parse("views/common/footer.vm")
	#workFlowScript()
</body>
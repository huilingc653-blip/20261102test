<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table id="appTable" class="layui-table layui-form layui-table-border" style="width:100%;">
        <thead>
            <tr>
                <th width='50px'>序号</th>
                <th width='150px'>单位代码</th>
                <th width='200px'>单位名称</th>
            </tr>
        </thead>
        <tbody>
            #foreach($corp in $!{corpList})
                <tr>
                    <td align="center">$velocityCount</td>
                    ##单位代码
                    <td align="center">
                        $!{corp.code}
                    </td>
                    ##单位名称
                    <td align="center">
                        $!{corp.name}
                    </td>
                </tr>
            #end
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form', 'layedit', 'btUpload'], function () {
        var $ = bt.jquery, form = bt.form();

    });

    function closeTab () {
        if (!bt.navtab) {
            parent.layer ? parent.layer.closeAll() : layer.closeAll();
        } else {
            bt.navtab.closeCurrent();
        }
        return false;
    }
</script>
</html>
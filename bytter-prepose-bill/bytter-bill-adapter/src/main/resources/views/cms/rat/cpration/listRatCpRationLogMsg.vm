<!DOCTYPE html>  
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input type="hidden" id="billCode" value="$!{billCode}">
<input  type="hidden" id="rationId" name="rationId" value="$!{rationId}">
<table id="appTable" class="layui-table layui-form"
		style="width: 100%;">
<colgroup>
	<col width="15%">
	<col width="15%">
	<col width="15%">
	<col width="15%">
	<col width="40%">
</colgroup>
	<thead>
		<tr>
			<td>#springMessage('table.cmsProcessMsg.createDate')</td><!--操作日期  -->
			<td>#springMessage('table.cmsProcessMsg.createBy')</td><!--用户代码  -->
			<td>#springMessage('table.cmsProcessMsg.createName')</td><!--用户名称  -->
			<td>#springMessage('table.cmsProcessMsg.messageType')</td><!--操作类型  -->
			<td>#springMessage('table.cmsProcessMsg.message')</td><!--操作信息  -->
		</tr>
	</thead>
</table>
<div align="center">
	<a href="#" class="layui-btn layui-btn-small" onClick="doClose()" >#springMessage('common.button.close')</a>
</div>
#parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
bt.use(['form','date','datatable','dicts'], function(){
    $ = bt.jquery,form = bt.form();
    bt.dicts.init();
    datatable = bt.datatable.init({
        elem: "#appTable",
       
        ajax: {
        	url:basePath+"/cms/rat/ratcprationlog/listlogdata?rationId="+$('#rationId').val()
        }
      
        ,columns: [
{data:"createDate"},
{data:"createBy"},
{data:"createByName"},
{data:"msgType",
	render: function (data, type, full, meta) {
		return bt.dict("fcBond.messageType",full.msgType);
	}
},
{data:"message",
    render: function (data, type, full, meta) {
		if(full.msgType == "26"){
			return "撤回";
		}else{
			return bt.dict("cms.messageType",full.message);
		}
    }}, ]
    });
});
    
//关闭窗口
function doClose(){
	if(bt.navtab){
		bt.navtab.closeCurrent();
	}
}
</script>

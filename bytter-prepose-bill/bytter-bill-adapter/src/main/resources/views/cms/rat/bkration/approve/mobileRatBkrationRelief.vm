#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##资金中心
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{result.ratBkrationPage.corpName}
        </span>
    </li>
##授信银行编号
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.bankCode')
        <span class="mui-badge mui-badge-inverted">
            $!{result.ratBkrationPage.bankName}
        </span>
    </li>
##授信合同号
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.contractNo')
        <span class="mui-badge mui-badge-inverted">
            $!{result.ratBkrationPage.contractNo}
        </span>
    </li>
##授信币种
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.curCode')
        <span class="mui-badge mui-badge-inverted">
            $!{result.ratBkrationPage.curName}
        </span>
    </li>
##调剂单位
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkrationRelief.reliefCorp')
        <span class="mui-badge mui-badge-inverted">
            $!{result.ratBkrationReliefPage.reliefCorpName}
        </span>
    </li>
##被调剂单位
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkrationRelief.byReliefCorp')
        <span class="mui-badge mui-badge-inverted">
            $!{result.ratBkrationReliefPage.byReliefCorpName}
        </span>
    </li>
##调剂品种类型
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkrationRelief.reliefItemFlag')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("RatModel.ItemFlag", ${result.ratBkrationReliefPage.reliefItemFlag})
        </span>
    </li>
##调剂品种
#if($!{result.ratBkrationReliefPage.reliefItemFlag} == "0")
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkrationRelief.reliefItemCode')
        <span class="mui-badge mui-badge-inverted">
            ${result.ratBkrationReliefPage.reliefItemName}
        </span>
    </li>
#else
    <li class="mui-table-view-divider">#springMessage('table.ratBkrationRelief.reliefItemCode')</li>
        <li class="ui-border-t">
            <div class="ui-list-info">
                <ul class="ui-row" border-width: 1px; text-align: center;">
        <li style="background: #C4E1FF;border-width: 1px; width: 100%;" class="ui-col ui-col-50" >
            <table style="border-collapse: collapse;border-spacing: 0; width: 100%; text-align: center;">
                <thead>
                <th>#springMessage("table.ratBkrationDetail.itemCode")</th>
                <th>#springMessage("table.ratBkrationDisDetail.leftDisMoney")</th>
                <th>#springMessage("table.ratBkrationRelief.byReliefMoney")</th>
                </thead>
                <tbody style="background: #fff;">
                    #foreach($item in $!{result.reliefItems})
                    <tr>
                        <td><input type="hidden" name="reliefDtls['$!{item.itemOrder}'].itemOrder" value="$!{item.itemOrder}">
                            <input type="hidden" name="reliefDtls['$!{item.itemOrder}'].reliefItemCode" value="$!{item.itemCode}">$!{item.itemName}</td>
                        <td align="center">$number.formatNumeric($!{item.maxMoney})</td>
                        <td align="center">$number.formatNumeric($!{item.money})</td>
                    </tr>
                    #end
                </tbody>
            </table>
        </li>
    </ul>
    </div>
    </li>
#end
##调剂额度
<li class="mui-table-view-cell">
    #springMessage('table.ratBkrationRelief.byReliefMoney')
    <span class="mui-badge mui-badge-inverted">
        $number.formatNumeric($!{result.disMoneyDTO.money})
    </span>
</li>
##被调剂品种类型
<li class="mui-table-view-cell">
    #springMessage('table.ratBkrationRelief.byReliefItemFlag')
    <span class="mui-badge mui-badge-inverted">
        $dictTag.get("RatModel.ItemFlag", ${result.ratBkrationReliefPage.byReliefItemFlag})
    </span>
</li>
##被调剂品种
    #if($!{result.ratBkrationReliefPage.byReliefItemFlag} == "0")
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkrationRelief.byReliefItemCode')
        <span class="mui-badge mui-badge-inverted">
            ${result.ratBkrationReliefPage.byReliefItemName}
        </span>
    </li>
    #else
    <li class="mui-table-view-divider">#springMessage('table.ratBkrationRelief.byReliefItemCode')</li>
    <li class="ui-border-t">
        <div class="ui-list-info">
            <ul class="ui-row" border-width: 1px; text-align: center;">
    <li style="background: #C4E1FF;border-width: 1px; width: 100%;" class="ui-col ui-col-50" >
        <table style="border-collapse: collapse;border-spacing: 0; width: 100%; text-align: center;">
            <thead>
            <th>#springMessage("table.ratBkrationDetail.itemCode")</th>
            <th>#springMessage("table.ratBkrationDisDetail.leftDisMoney")</th>
            <th>#springMessage("table.ratBkrationRelief.canReliefMoney")</th>
            </thead>
            <tbody style="background: #fff;">
                #foreach($item in $!{result.byReliefItems})
                <tr>
                    <td><input type="hidden" name="reliefDtls['$!{item.itemOrder}'].byItemOrder" value="$!{item.itemOrder}">
                        <input type="hidden" name="reliefDtls['$!{item.itemOrder}'].byReliefItemCode" value="$!{item.itemCode}">$!{item.itemName}</td>
                    <td align="center">$number.formatNumeric($!{item.maxMoney})</td>
                    <td align="center">$number.formatNumeric($!{item.money})</td>
                </tr>
                #end
            </tbody>
        </table>
    </li>
    </ul>
    </div>
    </li>
    #end
##被调剂额度
<li class="mui-table-view-cell">
    #springMessage('table.ratBkrationRelief.reliefMoney')
    <span class="mui-badge mui-badge-inverted">
        $number.formatNumeric($!{result.ratBkrationReliefPage.reliefMoney})
    </span>
</li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

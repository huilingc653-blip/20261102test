<!DOCTYPE html> 
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{applyDTO.id}">
			<input id="disCode" name="disCode" type="hidden" value="$!{ratCprationPage.disCode}">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{ratCprationPage.id}">
			<input id="curCode" name="curCode" type="hidden" value="$!{ratCprationPage.curCode}">
			<input type="hidden" id="corpId" name="corpId" value="$!{ratCprationPage.corpId}">
			<input type="hidden" id="ratType" name="ratType" value="1">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="15%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="30%">
					$!{ratCprationPage.ratCorpName}
				</td>
				##授信编号
                    <td width="20%" class="textRight">#springMessage('table.ratBkration.ratCode')</td>
                    <td width="30%">
						$!{ratCprationPage.ratCode}
                    </td>
				##授信合同号
				<td width="15%" class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td width="19%">
                	$!{ratCprationPage.contractNo}
				</td>
			</tr>
        	<tr>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratCprationPage.curName}
				</td>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.endDate)
				</td>
			</tr>
			</tbody>
		</table>
		
		<table class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		        <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.money')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($rationDtl in $!{ratCprationPage.rationDtls})
	    		<tr>
    				<td align="center">
	    				$dictTag.get("RatModel.ItemFlag", "0")
    				</td>
	    			<td align="center">
	    				$!{rationDtl.itemName}
					</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.money})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.leftMoney})
    				</td>
	    		</tr>
	    		#end
		    </tbody>
		</table>
		<table class="layui-table">
			<tbody>
			<tr>
        		##额度使用单位
				<td class="textRight">#springMessage('table.ratUrationApply.corpId')</td>
				<td >
					$!{ratCprationPage.corpName}
				</td>
        		##业务名称
				<td class="textRight">#springMessage('table.ratUrationApply.type')</td>
				<td >
					<input type="hidden" name="type" id="type" value="$!{applyDTO.type}">
					$!{applyDTO.typeName}
				</td>
        		##占用授信品种
				<td class="textRight">#springMessage('table.ratUrationApply.itemCode')</td>
				<td >
					<input type="hidden" name="itemFlag" id="itemFlag" value="$!{applyDTO.itemFlag}">
					<input type="hidden" name="itemCode" id="itemCode" value="$!{applyDTO.singItemCode}">
					$!{applyDTO.singItemName}
				</td>
			</tr>
        	<tr>
        		##开始日期
				<td width="15%" class="textRight">#springMessage('table.ratUrationApply.beginDate')</td>
				<td width="18%">
					<input type="text" name="beginDate" id="beginDate" class="layui-input bt-biz-dateType" data-type="date" lay-verify="required"
						data-min="$!date.format('yyyy-MM-dd',$!ratCprationPage.beginDate)" data-initmax="$!date.format('yyyy-MM-dd',$!ratCprationPage.endDate)"
						data-biz-name="beginDate" data-endid="endDate" data-callback="bt.setDays" value="$!date.format('yyyy-MM-dd',$!applyDTO.beginDate)">
				</td>
				##结束日期
				<td width="15%" class="textRight">#springMessage('table.ratUrationApply.endDate')</td>
				<td width="18%">
					<input type="text" name="endDate" id="endDate" class="layui-input bt-biz-dateType" data-type="date" lay-verify="required"
						data-biz-name="endDate" data-callback="bt.setDays" value="$!date.format('yyyy-MM-dd',$!applyDTO.endDate)">
				</td>
				##贷款期限(系统自动计算)
				<td width="15%" class="textRight">#springMessage('table.ratUrationApply.days')</td>
				<td width="19%">
                	<input type="text" class="layui-input" name="days" id="days" readonly="readonly" value="$!{applyDTO.days}" lay-verify="required">
				</td>
			</tr>
			<tr>
        		##授信占用金额
				<td class="textRight">#springMessage('table.ratUrationApply.money')</td>
				<td >
					<input type="text" data-name="money" id="money" data-biz-name="money" value="$!{applyDTO.money}" data-max="$!{applyDTO.leftMoney}"
						class="layui-input bt-biz-moneyType" data-decimal="2" data-minus="false" data-callback="bt.calMoney" lay-verify="required">
				</td>
        		##合同号
				<td class="textRight">#springMessage('table.ratUrationApply.contactNo')</td>
				<td >
					<input type="text" class="layui-input" name="contactNo" id="contactNo" maxlength="50" lay-verify="required" value="$!{applyDTO.contactNo}">
				</td>
				##信用证号
                    <td class="textRight">#springMessage('table.ratUrationApply.lcNo')</td>
                    <td >
                        <input type="text" class="layui-input" name="lcNo" id="lcNo" maxlength="32" value="$!{applyDTO.lcNo}">
                    </td>
			</tr>
			<tr>
			##票据号码
                <td class="textRight">#springMessage('table.ratUrationApply.billNo')</td>
                <td >
                    <input type="text" class="layui-input" name="billNo" id="billNo" maxlength="32" value="$!{applyDTO.billNo}">
                </td>
				<td colspan="3"></td>
			</tr>
			<tr>
        		##备注
				<td class="textRight">#springMessage('table.ratBkration.remark')</td>
				<td colspan="3">
					<input type="text" class="layui-input" name="remark" id="remark" maxlength="100" style="width:90%" value="$!{applyDTO.remark}">
				</td>
				<td ></td>
				<td ></td>
			</tr>
			</tbody>
		</table>
		
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					#if ($applyDTO.status == "0")
					<button class="layui-btn" lay-submit="" id="temp">#springMessage('common.button.temp')</button>
					#end
					<button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/cpration/ratCprationApply.edit.js?_btv=${resourceVersion}"></script>
</html>
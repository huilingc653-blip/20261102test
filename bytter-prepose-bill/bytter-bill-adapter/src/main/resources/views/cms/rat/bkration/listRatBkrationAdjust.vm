<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #page a, #page span {
            height: 30px;
            line-height: 30px;
        }

        #page .layui-laypage-total {
            padding-right: 0px;
        }
    </style>
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" id="businessType" value="$!{businessType}">
        <input type="hidden" id="businessId" value="$!{businessId}">
        <input type="hidden" id="curr" value="$!{curr}">
        <input type="hidden" id="pageCount" value="$!{pageCount}">
        <input type="hidden" id="pageSize" value="$!{pageSize}">
        <input type="hidden" id="resultCount" value="$!{resultCount}">
        <table class="layui-table">
            <tbody>
                <tr>
					<td colspan="6" style="text-align: center;">
						<button type="button" class="layui-btn" lay-submit="" lay-filter="add" >#springMessage('ration.maxMoneyAdjust.add')</button>
						<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
					</td>
				</tr>
            </tbody>
        </table>
    </form>
<div>
<table id="appTable" class="layui-table layui-form layui-table-border" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.ratBkration.adjustCode')</th>##调整编号
		<th>#springMessage('table.ratBkration.businessType')</th>##业务种类
        <th>#springMessage('table.ratBkration.corpId')</th>##授信单位
        <th>#springMessage('table.ratBkration.bankCode')</th>##授信银行
        <th>#springMessage('table.ratBkration.curCode')</th>##币别
		<th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>##授信类型
        <th>#springMessage('table.ratBkrationDetail.itemCode')</th>##品种
        <th>#springMessage('table.ratBkrationDetail.creditType')</th>##授信方式
        <th>#springMessage('table.ratBkrationDetail.adjustMoney')</th>##调整额度
        <th>#springMessage('table.ratBkration.status')</th>##状态
        <th>#springMessage('common.table.thead.operation')</th>##操作
    </tr>
    </thead>
    <tbody>
    #foreach($adjust in $!{adjustList})
  		<tr>
  			<td align="center" rowspan="$!{adjust.itemSize}">$!{adjust.adjustCode}</td>
            <td align="center" rowspan="$!{adjust.itemSize}">$dictTag.get("ratBkration.adjustType", $!{adjust.businessType})</td>
  			<td align="center" rowspan="$!{adjust.itemSize}">$!{adjust.corpName}</td>
  			<td align="center" rowspan="$!{adjust.itemSize}">$!{adjust.bankName}</td>
  			<td align="center" rowspan="$!{adjust.itemSize}">$!{adjust.curName}</td>
            #foreach($adjustDtl in $!{adjust.adjustDtls})
                #set($vcount = $velocityCount - 1)
                #if($!{vcount} == "0")
                    <td align="center" rowspan="$!{adjust.itemSize}">
                        $dictTag.get("RatModel.ItemFlag", $!{adjustDtl.itemFlag})
                    </td>
                #end
                <td align="center">
                    $!{adjustDtl.itemName}
                </td>
                <td align="center">
                    $dictTag.get("rat.creditType", $!{adjustDtl.creditType})
                </td>
                <td align="right">
                    $number.formatNumeric($!{adjustDtl.money})
                </td>
                #if($!{vcount} == "0")
                    <td align="center" rowspan="$!{adjust.itemSize}">
                        $dictTag.get("common.status", $!{adjust.status})
                    </td>
                    <td align="center" rowspan="$!{adjust.itemSize}">
                        ##操作链接
                        #if($!{adjust.status} < 11)
                        <a class="" href="#" onclick="update('$!{adjust.id}')">#springMessage("common.button.edit")</a>&nbsp;|
                        <a class="" href="#" onclick="del('$!{adjust.id}')">#springMessage("common.button.delete")</a>&nbsp;|
                        #end
                        <a class="" href="#" onclick="view('$!{adjust.id}')">#springMessage("common.button.view")</a>
                    </td>
                #end
            </tr>
            #end
	#end
    </tbody>
</table>
</div>
    <div id="page" ></div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratBkrationAdjust.list.js?_btv=${resourceVersion}"></script>
</html>
#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##授信模式
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.ratMode')
        <span class="mui-badge mui-badge-inverted">
			$dictTag.get("RatBkration.RatMode", "$!{ratBkrationPage.ratMode}")
        </span>
    </li>
##单位代码
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.corpId')
        <span class="mui-badge mui-badge-inverted">
			$!{ratBkrationPage.corpName}
        </span>
    </li>
##授信合同号
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.contractNo')
        <span class="mui-badge mui-badge-inverted">
			$!{ratBkrationPage.contractNo}
        </span>
    </li>
##银行编号
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.bankCode')
        <span class="mui-badge mui-badge-inverted">
			$!{ratBkrationPage.bankName}
        </span>
    </li>
##授信开始时间
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.begindate')
        <span class="mui-badge mui-badge-inverted">
			$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
        </span>
    </li>
##授信结束时间
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.enddate')
        <span class="mui-badge mui-badge-inverted">
			$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
        </span>
    </li>
##授信币种
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.curCode')
        <span class="mui-badge mui-badge-inverted">
			$!{ratBkrationPage.curName}
        </span>
    </li>

    ##创建人
    <li class="mui-table-view-cell">
        #springMessage('table.sysAttachment.createBy')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.userName}
        </span>
    </li>

   ##备注
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.remark')
        <textarea rows="3" class="layui-textarea" readonly="readonly">$!{ratBkrationPage.remark}</textarea>
    </li>
    ##授信明细
    <li class="ui-border-t">
        <div class="ui-list-info">
            <ul class="ui-row"
                style="border-width: 1px; text-align: center;">
                <li class="ui-col ui-col-50" style="background: #C4E1FF;"
                    style="border-width: 1px; width: 100%;">
                    <table style="border-collapse: collapse;border-spacing: 0; width: 100%; text-align: center;">
                        <thead>
                        <tr>
                            <th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
                            <th>#springMessage('table.ratBkrationDetail.itemCode')</th>
                            <th>#springMessage('table.ratBkrationDetail.money')</th>
                            <th>#springMessage('table.ratBkrationDetail.maxMoney')</th>
                        </tr>
                        </thead>
                        <tbody style="background: #fff;">
                            #foreach($rationDtl in $!{ratBkrationPage.singRationDtls})
                            <tr>
                                <td align="center">
                                    $dictTag.get("RatModel.ItemFlag", "0")
                                </td>
                                <td align="center">
                                    $!{rationDtl.itemName}
                                </td>
                                <td align="center">
                                    $number.formatNumeric($!{rationDtl.money})
                                </td>
                                <td>
                                </td>
                            </tr>
                            #end
                        ##综合授信
                            #foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
                                #set($vcount = $velocityCount - 1)
                            <tr>
                                #if($!{vcount} == "0")
                                    <td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
                                        $dictTag.get("RatModel.ItemFlag", "1")
                                    </td>
                                #end
                                <td align="center">
                                    $!{rationDtl.itemName}
                                </td>
                                #if($!{vcount} == "0")
                                    <td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
                                        $number.formatNumeric($!{rationDtl.money})
                                    </td>
                                #end
                                <td align="center">
                                    $number.formatNumeric($!{rationDtl.maxMoney})
                                </td>
                            </tr>
                            #end
                        </tbody>
                        <tfoot>
                        <tr style="background: #fff;">
                            <td align="center">#springMessage('table.ratBkration.sumMoney')</td>
                            <td >&nbsp;</td>
                            <td align="center">
                                $number.formatNumeric($!{ratBkrationPage.money})
                            </td>
                            <td >&nbsp;</td>
                        </tr>
                        </tfoot>
                    </table>
                </li>
            </ul>
        </div>
    </li>

##担保合同信息
    #if($!{guaContractUseDTO})##
        <li class="mui-table-view-divider">#springMessage('table.guaContract.ContractMsg')</li>
    ##担保合同明细
        <li class="ui-border-t">
            <div class="ui-list-info">
                <ul class="ui-row"
                    style="border-width: 1px; text-align: center;">
                    <li class="ui-col ui-col-50" style="background: #C4E1FF;"
                        style="border-width: 1px; width: 100%;">
                        <table style="border-collapse: collapse;border-spacing: 0; width: 100%; text-align: center;">
                            <thead>
                            <tr>
                                <th>#springMessage('table.guaContract.contractCode')</th>##合同编号
##                                <th>#springMessage('table.guaContract.guaNo')</th>##担保编号
                                <th>#springMessage('table.guaContract.guaType')</th>##担保方式
                                <th>#springMessage('table.guaContract.guaMoney')</th>##担保额度
                            </tr>
                            </thead>
                            <tbody style="background: #fff;">
                                #foreach($contract in $!{guaContractUseDTO.contracts})
                                <tr>
                                    <td align="center" >$!{contract.contractCode}</td>
##                                    <td align="center" >$!{contract.guaNo}</td>
                                    <td align="center" >$!{contract.guaTypeName}</td>
                                    <td align="center">$number.formatNumeric($!{contract.guaMoney})</td>
                                </tr>
                                #end
                            </tbody>
                        </table>
                    </li>
                </ul>
            </div>
        </li>
    #end
</ul>

    #parse("views/common/wapfooter.vm")
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{ratBkrationReliefPage.id}">
			<input type="hidden" id="ratType" name="ratType" value="0">
			<input type="hidden" id="corpId" name="corpId" value="$!{ratBkrationReliefPage.corpId}">
			<input type="hidden" id="curCode" name="curCode" value="$!{ratBkrationReliefPage.curCode}">
			<input type="hidden" id="flag" name="flag" value="$!{flag}">
			<input type="hidden" id="assurepercent" name="assurepercent" value="">
			<input type="hidden" id="interestrate" name="interestrate" value="">
			<input type="hidden" id="reliefCode" name="reliefCode" value="">
			<input type="hidden" id="byReliefCode" name="byReliefCode" value="">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="18%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="32%" colspan="2">
					$!{ratBkrationReliefPage.corpName}
				</td>
        		##授信银行编号
				<td width="18%" class="textRight">#springMessage('table.ratBkration.bankCode')</td>
				<td width="32%" colspan="2">
					$!{ratBkrationReliefPage.bankName}
				</td>
			</tr>
        	<tr>
				##授信合同号
				<td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td colspan="2">
                	$!{ratBkrationReliefPage.contractNo}
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td colspan="2">
					$!{ratBkrationReliefPage.curName}
				</td>
			</tr>
			<tr>
				##调剂单位
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.reliefCorp')</td>
				<td colspan="2">
                	<div class="layui-input-inline">
                		<div class="bt-biz-selectType" data-biz-name="reliefCorp" data-url="${basePath}/cms/rat/ratbkrationrelief/getRefCorpDTOs?flag=${flag}&ratCode=$!{ratBkrationReliefPage.id}&corpId=$!{ratBkrationReliefPage.corpId}" 
                			data-valuefield="id" data-textfield="name" data-name="reliefCorp" data-search="true" 
                			data-callback="setItemFlag"></div>
                    </div>
				</td>
				##被调剂单位
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.byReliefCorp')</td>
				<td colspan="2">
                	<div class="layui-input-inline">
                		<div class="bt-biz-selectType" data-biz-name="byReliefCorp" data-url="${basePath}/cms/rat/ratbkrationrelief/getRefCorpDTOs?flag=${flag}&ratCode=$!{ratBkrationReliefPage.id}&corpId=$!{ratBkrationReliefPage.corpId}" 
                			data-valuefield="id" data-textfield="name" data-name="byReliefCorp" data-search="true" 
                			data-callback="setByItemFlag"></div>
                    </div>
				</td>
			</tr>
			<tr>
        		##调剂品种类型
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.reliefItemFlag')</td>
				<td colspan="2">
					<div class="layui-input-inline">
						<select name="reliefItemFlag" id="reliefItemFlag" lay-verify="required" lay-search="" lay-filter="reliefItemFlag">
							<option value=""></option>
						</select>
					</div>
				</td>
        		##被调剂品种类型
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.byReliefItemFlag')</td>
				<td colspan="2">
					<div class="layui-input-inline">
						<select name="byReliefItemFlag" id="byReliefItemFlag" lay-verify="required" lay-search="" lay-filter="byReliefItemFlag">
							<option value=""></option>
						</select>
					</div>
				</td>
			</tr>
			<tr>
        		##调剂品种
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.reliefItemCode')</td>
				<td colspan="2" id="reliefItemCodeTd">
					<div class="layui-input-inline">
						<select name="reliefItemCode" id="reliefItemCode" lay-verify="required" lay-search="" lay-filter="reliefItemCode">
							<option value=""></option>
						</select>
					</div>
				</td>
        		##被调剂品种
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.byReliefItemCode')</td>
				<td id="byReliefItemCodeTd">
					<div class="layui-input-inline">
						<select name="byReliefItemCode" id="byReliefItemCode" lay-verify="required" lay-search="" lay-filter="byReliefItemCode">
							<option value=""></option>
						</select>
					</div>
				</td>
			</tr>
			<tr>
				##调剂额度
				<td class="textRight">#springMessage('table.ratBkrationRelief.byReliefMoney')</td>
				<td colspan="2">
                	<input type="text" data-name="byReliefMoney" id="byReliefMoney" data-biz-name="byReliefMoney" class="layui-input bt-biz-moneyType" 
                		data-decimal="2" data-minus="false" readonly="readonly">
				</td>
        		##被调剂额度
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.reliefMoney')</td>
				<td colspan="2">
                	<input type="text" data-name="reliefMoney" id="reliefMoney" data-biz-name="reliefMoney" class="layui-input bt-biz-moneyType" 
                		data-decimal="2" data-minus="false" data-callback="bt.calMoney">
				</td>
			</tr>
			<tr>
				##调剂敞口额度
				<td class="textRight">#springMessage('table.ratBkrationRelief.byReliefOpenMoney')</td>
				<td colspan="2">
                	<input type="text" data-name="byReliefOpenMoney" id="byReliefOpenMoney" data-biz-name="byReliefOpenMoney" class="layui-input bt-biz-moneyType" 
                		data-decimal="2" data-minus="false" readonly="readonly">
				</td>
        		##被调剂敞口额度
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.reliefOpenMoney')</td>
				<td colspan="2">
                	<input type="text" data-name="reliefOpenMoney" id="reliefOpenMoney" data-biz-name="reliefOpenMoney" class="layui-input bt-biz-moneyType" 
                		data-decimal="2" data-minus="false" readonly="readonly">
				</td>
			</tr>
			</tbody>
		</table>
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratBkrationReliefOpen.add.js?_btv=${resourceVersion}"></script>
</html>
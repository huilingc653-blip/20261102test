<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{ratBkrationPage.disCode}">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{ratBkrationPage.id}">
			<input type="hidden" id="ratType" name="ratType" value="0">
			<input type="hidden" id="ratCorpId" name="ratCorpId" value="$!{ratBkrationPage.corpId}">
			<input type="hidden" id="disCorpId" name="disCorpId" value="$!{ratBkrationPage.disCorpId}">
			<input type="hidden" id="disWay" name="disWay" value="$!{ratBkrationPage.disWay}">
			<input type="hidden" id="itemSize" name="itemSize" value="$!{ratBkrationPage.itemSize}">
			<input type="hidden" id="singItemSize" name="singItemSize" value="$!{ratBkrationPage.singItemSize}">
			<input type="hidden" id="compItemSize" name="compItemSize" value="$!{ratBkrationPage.compItemSize}">
			<input type="hidden" id="compItemIndex" name="compItemIndex" value="$!{ratBkrationPage.compItemIndex}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="20%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="30%">
					$!{ratBkrationPage.corpName}
				</td>
				##授信编号
				<td width="20%" class="textRight">#springMessage('table.ratBkration.ratCode')</td>
				<td width="30%">
                	$!{ratBkrationPage.ratCode}
				</td>
			</tr>
        	<tr>
        		##授信银行编号
				<td class="textRight">#springMessage('table.ratBkration.bankType')</td>
				<td >
					$!{ratBkrationPage.TypeName}
				</td>
        		##授信银行编号
				<td class="textRight">#springMessage('table.ratBkration.bankCode')</td>
				<td >
					$!{ratBkrationPage.bankName}
				</td>
			</tr>
        	<tr>
				##授信合同号
				<td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td>
                	$!{ratBkrationPage.contractNo}
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratBkrationPage.curName}
				</td>
			</tr>
        	<tr>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
				</td>
			</tr>
        	<tr>
        		##授信额度
				<td class="textRight">#springMessage('table.ratBkration.money')</td>
				<td >
					$number.formatNumeric($!{ratBkrationPage.money})
				</td>
        		##授信敞口额度
				<td class="textRight">#springMessage('table.ratBkration.openMoney')</td>
				<td >
					$number.formatNumeric($!{ratBkrationPage.openMoney})
				</td>
			</tr>
        	<tr>
        		##待分配授信金额
				<td class="textRight">#springMessage('table.ratBkrationDis.unDisMoney')</td>
				<td >
					$number.formatNumeric($!{ratBkrationPage.unUserMoney})
				</td>
        		##待分配敞口金额
				<td class="textRight">#springMessage('table.ratBkrationDis.unDisOpenMoney')</td>
				<td >
					$number.formatNumeric($!{ratBkrationPage.unUserOpenMoney})
				</td>
			</tr>
        	<tr>
        		##授信分配方式
				<td class="textRight">#springMessage('table.ratBkrationDis.distributeWay')</td>
				<td >
				#if($!{ratBkrationPage.disWay} == "1")
					<div class="bt-biz-dict" data-type="radio" data-group="RatBkrationDis.DistributeWay" data-defaultvalue="$!{ratBkrationPage.disWay}" 
						data-name="distributeWay" data-biz-name="distributeWay" data-disabledValue="2,3">
				#elseif($!{ratBkrationPage.disWay} == "2")
					<div class="bt-biz-dict" data-type="radio" data-group="RatBkrationDis.DistributeWay" data-defaultvalue="$!{ratBkrationPage.disWay}" 
						data-name="distributeWay" data-biz-name="distributeWay" data-disabledValue="1,3">
				#else
					<div class="bt-biz-dict" data-type="radio" data-group="RatBkrationDis.DistributeWay" data-defaultvalue="$!{ratBkrationPage.disWay}" 
						data-name="distributeWay" data-biz-name="distributeWay" data-disabledValue="1,2">
				#end
				</td>
        		##额度类型
				<td class="textRight">#springMessage('table.ratBkrationDis.type')</td>
				<td >
					<div class="layui-inline">
						<div class="bt-biz-selectType" data-biz-name="type" data-url="${basePath}/cms/rat/ratcredittype/getAll" data-valuefield="id" 
							data-textfield="name" data-name="type" data-biz-name="type" data-defaultvalue="$!{ratBkrationPage.type}">
						</div>
        			</div>
				</td>
			</tr>
        	<tr>
        		##二次授信对象
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationDis.corpId')</td>
				<td colspan="3">
					<div class="layui-inline" id="ratCorpDiv">
					</div>
				</td>
			</tr>
			</tbody>
		</table>
		
		<table id="singleTable" class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		        <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.money')</th>
                <th width='180px'>#springMessage('table.ratBkrationDisDetail.overPlusMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.openMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDisDetail.leftDisOpenMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.maxMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDisDetail.leftMaxMoney')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($rationDtl in $!{ratBkrationPage.singRationDtls})
	    		<tr>
    				<td align="center">
	    				$dictTag.get("RatModel.ItemFlag", "0")
    				</td>
	    			<td align="center">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemFlag" id="itemFlag$!{rationDtl.itemOrder}" value="$!{rationDtl.itemFlag}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemCode" value="$!{rationDtl.itemCode}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemOrder" value="$!{rationDtl.itemOrder}">
	    				<input type="hidden" id="assurepercent$!{rationDtl.itemOrder}" value="$!{rationDtl.assurepercent}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].compSign" value="$!{rationDtl.compSign}">
	    				$!{rationDtl.itemName}
					</td>
    				<td align="right">
    					<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].money" id="$!{rationDtl.itemOrder}money" data-biz-name="$!{rationDtl.itemOrder}money" rowindex="$!{rationDtl.itemOrder}"
    						class="layui-input bt-biz-moneyType" oldValue="$!{rationDtl.leftMoney}" data-max="$!{rationDtl.leftMoney}" value="$!{rationDtl.disMoney}" data-decimal="2" data-minus="false" data-callback="bt.calMoney">
    				</td>
                    <td align="right">
						$number.formatNumeric($!{rationDtl.unUserMoney})
                    </td>
    				<td align="right">
    					<input type="hidden" id="$!{rationDtl.itemOrder}unUserMoney" value="$!{rationDtl.unUserMoney}" >
    					<div id="$!{rationDtl.itemOrder}moneySpan">
    					$number.formatNumeric($!{rationDtl.leftMoney})
    					</div>
    				</td>
    				<td align="right">
    					<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].openMoney" id="$!{rationDtl.itemOrder}openMoney" data-biz-name="$!{rationDtl.itemOrder}openMoney" 
    						class="layui-input bt-biz-moneyType" oldValue="$!{rationDtl.unUserOpenMoney}" data-max="$!{rationDtl.unUserOpenMoney}" readonly="readonly" value="$!{rationDtl.disOpenMoney}" data-decimal="2" data-minus="false" data-callback="bt.calOpenMoney">
    				</td>
    				<td align="right">
    					<input type="hidden" id="$!{rationDtl.itemOrder}unUserOpenMoney" value="$!{rationDtl.unUserOpenMoney}" >
    					<div id="$!{rationDtl.itemOrder}openMoneySpan">
    					$number.formatNumeric($!{rationDtl.leftOpenMoney})
    					</div>
    				</td>
	    			<td></td>
	    			<td></td>
	    		</tr>
	    		#end
		   ##综合授信
	    	#foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
	    		#set($vcount = $velocityCount - 1)
	    		<tr>
	    			#if($!{vcount} == "0")
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
	    				$dictTag.get("RatModel.ItemFlag", "1")
    				</td>
	    			#end
	    			<td align="center">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemFlag" id="itemFlag$!{rationDtl.itemOrder}" value="$!{rationDtl.itemFlag}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemCode" value="$!{rationDtl.itemCode}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemOrder" value="$!{rationDtl.itemOrder}">
	    				<input type="hidden" id="interestrate$!{rationDtl.itemOrder}" value="$!{rationDtl.interestrate}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].compSign" value="$!{rationDtl.compSign}">
	    				$!{rationDtl.itemName}
					</td>
					#if($!{vcount} == "0")
					<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].money" data-id="$!{rationDtl.itemOrder}money" data-biz-name="$!{rationDtl.itemOrder}money" rowindex="$!{rationDtl.itemOrder}"
    						class="layui-input bt-biz-moneyType" oldValue="$!{rationDtl.leftMoney}" data-max="$!{rationDtl.leftMoney}" value="$!{rationDtl.disMoney}" data-decimal="2" data-minus="false" data-callback="bt.calCompMoney">
    				</td>
					<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
						$number.formatNumeric($!{rationDtl.unUserMoney})
					</td>
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					<input type="hidden" id="$!{rationDtl.itemOrder}unUserMoney" value="$!{rationDtl.unUserMoney}" >
    					<div id="$!{rationDtl.itemOrder}moneySpan">
    					$number.formatNumeric($!{rationDtl.leftMoney})
    					</div>
    				</td>
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].openMoney" id="$!{rationDtl.itemOrder}openMoney" data-biz-name="$!{rationDtl.itemOrder}openMoney" 
    						class="layui-input bt-biz-moneyType" oldValue="$!{rationDtl.unUserOpenMoney}" data-max="$!{rationDtl.unUserOpenMoney}" readonly="readonly" value="$!{rationDtl.disOpenMoney}" data-decimal="2" data-minus="false" data-callback="bt.calOpenMoney">
    				</td>
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					<input type="hidden" id="$!{rationDtl.itemOrder}unUserOpenMoney" value="$!{rationDtl.unUserOpenMoney}" >
    					<div id="$!{rationDtl.itemOrder}openMoneySpan">
    					$number.formatNumeric($!{rationDtl.leftOpenMoney})
    					</div>
    				</td>
	    			#end
	    			<td align="right">
    					<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].maxMoney" data-id="$!{rationDtl.itemOrder}maxMoney" data-biz-name="$!{rationDtl.itemOrder}maxMoney" rowindex="$!{rationDtl.itemOrder}"
    						class="layui-input bt-biz-moneyType" oldValue="$!{rationDtl.leftMaxMoney}" data-max="$!{rationDtl.leftMaxMoney}" value="$!{rationDtl.disMaxMoney}" data-decimal="2" data-minus="false" data-callback="bt.calMaxMoney">
	    			</td>
	    			<td align="right">
    					<input type="hidden" class="rationHidden" index="$!{rationDtl.itemOrder}" id="$!{rationDtl.itemOrder}leftMaxMoney" 
    						value="$!{rationDtl.leftMaxMoney}" oldValue="$!{rationDtl.leftMaxMoney}">
    					<div id="$!{rationDtl.itemOrder}maxMoneySpan" >
    					$number.formatNumeric($!{rationDtl.leftMaxMoney})
    					</div>
	    			</td>
	    		</tr>
	    	#end
		    </tbody>
		    <tfoot>
			    <tr>
	 				<td align="center">#springMessage('table.ratBkration.sumMoney')</td>
	 				<td></td>
	 				<td>
		 				<input type="text" data-name="moneysum" data-biz-name="moneysum" readonly="readonly" data-decimal="2" value="$!{ratBkrationPage.disMoney}"
							autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.ratBkrationDis.money')">
	 				</td>
	 				<td></td>
	 				<td>
		 				<input type="text" data-name="openMoneysum" data-biz-name="openMoneysum" readonly="readonly" data-decimal="2" value="$!{ratBkrationPage.disOpenMoney}"
							autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.ratBkrationDis.openMoney')">
	 				</td>
	 				<td></td>
	 				<td></td>
	 				<td></td>
				</tr>
			</tfoot>
		</table>
		
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratBkrationOpenDis.edit.js?_btv=${resourceVersion}"></script>
</html>
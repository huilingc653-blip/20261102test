<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
        <input type="hidden" id="total" value="${total}">
        <input type="hidden" id="curr" value="${curr}">
        <input type="hidden" id="businessType" value="$!{businessType}">
        <table class="layui-table">
            <tbody>
            <tr style="width: 100%">
            ##调整编号
                <td class="textRight" width="45%">#springMessage('table.ratBkration.adjustCode')</td>
                <td width="55%">
                   <input type="text" class="layui-input" name="likes_adjustCode" id="adjustCode" >
                </td>
            </tr>
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
    </form>
<div>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.ratBkration.adjustCode')</th>##调整编号
		<th>#springMessage('table.ratBkration.businessType')</th>##业务种类
        <th>#springMessage('table.ratBkration.corpId')</th>##授信单位
        <th>#springMessage('table.ratBkration.bankCode')</th>##授信银行
        <th>#springMessage('table.ratBkration.curCode')</th>##币别
        <th>#springMessage('table.ratBkration.createDate')</th>##创建日期
        <th>#springMessage('common.table.thead.operation')</th>##操作
    </tr>
    </thead>
    <tbody>
    </tbody>
</table>
</div>
        #workFlowHtml()
        #parse("views/common/footer.vm")
        #workFlowScript()
<script  src="${basePath}/static/modules/cms/rat/bkration/ratBkAdjustApprove.list.js?_btv=${resourceVersion}" ></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##授信银行名称
            <td class="textRight">#springMessage("table.ratBkration.creditBankName")</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_bankName" autocomplete="off" class="layui-input">
                </div>
            </td>
            ##合作情况
            <td class="textRight">#springMessage("table.ratBkration.cooperationType")</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="rat.cooperation.type" data-name="eqs_cooperationType" data-biz-name="cooperationType"></div>
                </div>
            </td>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.ratBkration.creditBankName')</th>##授信银行名称
        <th>#springMessage('table.ratBkration.cooperationType')</th>##合作情况
        <th>#springMessage('common.table.thead.operation')</th>##操作
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/creditcooperationbank/ratCreditCooperationBank.list.js?_btv=${resourceVersion}"></script>
</html>

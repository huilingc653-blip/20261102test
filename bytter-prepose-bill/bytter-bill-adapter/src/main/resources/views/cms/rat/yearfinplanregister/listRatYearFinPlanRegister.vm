<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            ##单位名称
            <td class="textRight">#springMessage("table.sysCorp.corpName")</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-biz-type="corp" data-type="selectTree" data-resource="cms:rat:yearFinPlanRegister:query"
                         data-tree-type="check" data-checkkboxtype='{"Y":"s","N":"s"}'
                         data-name="ins_corpId" data-biz-name="corpId" data-defaultvalue="$!{corpId}"></div>
                </div>
            </td>
            ##年度
            <td class="textRight">#springMessage("table.yearFinPlanRegister.years")</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" class="layui-input" name="eqs_years" id="years">
##                    <input type="text" class="layui-input bt-biz-dateType" data-type="year" name="eqs_years" data-biz-name="years">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form layui-table-border" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.sysCorp.corpName')</th>##单位名称
        <th>#springMessage('table.yearFinPlanRegister.years')</th>##年度
        <th>#springMessage('table.yearFinPlanRegister.yearPurchaseAmount')</th>##年采购量
        <th>#springMessage('table.yearFinPlanRegister.mergeInvestmentAmount')</th>##并购投资
        <th>#springMessage('table.yearFinPlanRegister.solveMeasure')</th>##解决措施
        <th>#springMessage('table.yearFinPlanRegister.existDifficulty')</th>##存在的困难
        <th>#springMessage('common.table.thead.operation')</th>##操作
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/yearfinplanregister/ratYearFinPlanRegister.list.js?_btv=${resourceVersion}"></script>
</html>

#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##授信单位
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.corpName}
        </span>
    </li>
##授信编号
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.ratCode')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.ratCode}
        </span>
    </li>
##银行类型
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.bankType')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.TypeName}
        </span>
    </li>
##授信银行名称
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.bankCode')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.bankName}
        </span>
    </li>
##授信合同号
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.contractNo')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.contractNo}
        </span>
    </li>
##授信币种
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.curCode')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.curName}
        </span>
    </li>
##授信开始时间
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.begindate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
        </span>
    </li>
##授信结束时间
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.enddate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
        </span>
    </li>
##授信额度
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.money')
        <span class="mui-badge mui-badge-inverted">
            $number.formatNumeric($!{ratBkrationPage.money})
        </span>
    </li>

##授信追加明细
    <li class="ui-border-t">
        <div class="ui-list-info">
            <ul class="ui-row" border-width: 1px; text-align: center;">
    <li style="background: #C4E1FF;border-width: 1px; width: 100%;" class="ui-col ui-col-50" >
        <table style="border-collapse: collapse;border-spacing: 0; width: 100%; text-align: center;">
            <thead>
            <th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
            <th>#springMessage('table.ratBkrationDetail.itemCode')</th>
            <th>#springMessage('table.ratBkrationAddDetail.money')</th>
            </thead>
            <tbody style="background: #fff;">
                #foreach($rationDtl in $!{ratBkrationPage.singRationDtls})
                    #if("$!{rationDtl.money}" != "0")
                    <tr>
                        <td align="center">
                            $dictTag.get("RatModel.ItemFlag", "0")
                        </td>
                        <td align="center">
                            $!{rationDtl.itemName}
                        </td>
                        <td align="center">
                            $number.formatNumeric($!{rationDtl.addMoney})
                        </td>
                    </tr>
                    #end
                #end
            ##综合授信
                #foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
                    #set($vcount = $velocityCount - 1)
                <tr>
                    #if($!{vcount} == "0")
                        <td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
                            $dictTag.get("RatModel.ItemFlag", "1")
                        </td>
                    #end
                    <td align="center">
                        $!{rationDtl.itemName}
                    </td>
                    #if($!{vcount} == "0")
                        <td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
                            $!number.formatNumeric($!{rationDtl.addMoney})
                        </td>
                    #end
                </tr>
                #end
            </tbody>
            <tfoot style="background: #fff;">
            <tr>
                <td align="center">#springMessage('table.ratBkrationAdd.sumMoney')</td>
                <td></td>
                <td align="center">
                    $!number.formatNumeric($!{ratBkrationPage.addMoney})
                </td>
            </tr>
            </tfoot>
        </table>
    </li>

</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #page a, #page span {
            height: 30px;
            line-height: 30px;
        }

        #page .layui-laypage-total {
            padding-right: 0px;
        }
    </style>
</head>
<body>
    <form id="searchForm" class="layui-form">
    <input type="hidden" id="curId" name="curId" value="$!{naturalCur}" >
        <table class="layui-table">
            <tbody>
                <tr>
                	##授信单位
                    <td class="textRight" width="12%">#springMessage('table.ratBkration.corpId')</td>
                    <td width="20%" class="rCode">
                        <div class="layui-input-inline">
							<div class="bt-biz-corp" data-biz-type="corp" data-type="selectTree" data-resource="cms:rat:rationQuery:query"
								 data-tree-type="check" data-checkkboxtype='{"Y":"s","N":"s"}'
								 data-name="corpId" data-biz-name="corpId" data-defaultvalue="$!{corpId}"></div>
                   		</div>
                    </td>
                    ##银行
                    <td class="textRight" width="12%">#springMessage('table.ratBkration.bankCode')</td>
                    <td width="20%">
                        <div class="layui-input-inline" >
							<div class="bt-biz-mulselectType"
								 data-biz-name="bankCode"
								 data-url="${basePath}/cms/rat/raturation/getBanks"
                                 data-value="$!{paramDTO.bankCode}"
								 data-search="true"
								 data-valuefield="bankCode" data-textfield="bankName" data-name="bankCode"></div>
                   		</div>
                    </td>
                    ##品种
                    <td class="textRight" width="15%">#springMessage('table.ratBkrationDetail.itemCode')</td>
                    <td class="rCode" class="rCode">
                        <div class="layui-inline">
	        				<div class="bt-biz-selectType" data-biz-name="itemCode" data-url="${basePath}/cms/rat/ratitemcustom/getAllRatItem?type=0"
	        					data-valuefield="id" data-textfield="name" data-name="itemCode" data-search="true" data-value="$!{paramDTO.itemCode}">
	        				</div>
	        			</div>
                    </td>
                </tr>
                <tr>
                	##授信币种
					<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkration.curCode')</td>
					<td >
						<div class="layui-inline">
						<div class="bt-biz-selectType" data-biz-name="curCode" data-url="${basePath}/basic/business/btcurrency/json" 
							data-valuefield="id" data-textfield="curName" data-required="false"
							data-name="curCode" data-search="true" data-value="$!{paramDTO.curCode}"></div>
						</div>						
					</td>
					##估计授信时间 我们展示不用这个
					<td class="textRight" hidden>#springMessage('table.ratBkration.ratDate')</td>
					<td width="40%" class="rCode" hidden>
						<div class="layui-inline layui-input-inline">
							<input type="text" name="beginDate" id="beginDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="endDate"
								   data-type="date" data-biz-name="beginDate" value="$!date.format('yyyy-MM-dd',$!paramDTO.beginDate)">
							<span class="date-mid">~</span>
							<input type="text" name="endDate" id="endDate" class="layui-input bt-input-inline bt-biz-dateType"
								   data-type="date" data-biz-name="endDate" value="$!date.format('yyyy-MM-dd',$!paramDTO.endDate)">
						</div>
					</td>

					##                -------------------------------------------------------------------------
					## 授信开始时间
					<td class="textRight" style="width: 10%">#springMessage('table.ratBkration.begindate')</td>
					<td style="width: 23%" class="rCode">
						<div class="layui-inline">
							<input type="text" name="gBeginDate" data-name="gBeginDate" class="layui-input bt-biz-dateType"
								   data-type="date" data-biz-name="gBeginDate" value="$!date.format('yyyy-MM-dd',$!paramDTO.gBeginDate)">
						</div>
						<div class="layui-inline">
							<span class="date-mid">~</span>
						</div>
						<div class="layui-inline">
							<input type="text" name="lBeginDate" data-name="lBeginDate" class="layui-input bt-biz-dateType"
								   data-type="date" data-biz-name="lBeginDate" value="$!date.format('yyyy-MM-dd',$!paramDTO.lBeginDate)">
						</div>
					</td>
					## 授信结束时间
					<td class="textRight" style="width: 10%">#springMessage('table.ratBkration.enddate')</td>
					<td class="rCode">
						<div class="layui-inline">
							<input name="gEndDate" data-name="gEndDate" data-biz-name="gEndDate" value="$!date.format('yyyy-MM-dd',$!paramDTO.gEndDate)" data-type="date"
								   class="layui-input bt-biz-dateType" type="text">
						</div>
						<div class="layui-inline">
							<span class="date-mid">~</span>
						</div>

						<div class="layui-inline">
							<input name="lEndDate" data-name="lEndDate" data-biz-name="lEndDate" value="$!date.format('yyyy-MM-dd',$!paramDTO.lEndDate)" data-type="date"
								   class="layui-input bt-biz-dateType" type="text">
						</div>
					</td>
                </tr>
				<tr>
					##金额单位
					<td class="textRight">#springMessage('common.moneyType')</td>
					<td >
						<div class="layui-input-inline">
							<div class="bt-biz-dict" data-type="select" data-group="common.MoneyType"
								 data-name="moneyType" data-biz-name="moneyType" data-value="$!{paramDTO.moneyType}">
							</div>
						</div>
					</td>
				</tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="button" class="layui-btn layui-btn-primary" onClick="resetCode()">#springMessage('common.button.reset')</button>
                        <button type="button" lay-submit="" class="layui-btn" lay-filter="excel">#springMessage('common.button.exports')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<div>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
#foreach($ration in $!{rations})
    <thead>
    <tr>
        <th align="center" colspan="3">#springMessage('table.ratBkration.ratMode')：$dictTag.get("RatBkration.RatMode", "$!{ration.ratMode}")</th>
        <th align="center">#springMessage('table.ratBkration.corpId')：$!{ration.corpName}</th>
        <th align="center" colspan="3">#springMessage('table.ratBkration.bankCode')：$!{ration.bankName}</th>
        <th align="center">#springMessage('table.ratBkrationDis.distributeWay')：$dictTag.get("RatBkrationDis.DistributeWay", $!{ration.disWay})</th>
        <th align="center">#springMessage('table.ratBkration.validDate')：$!date.format('yyyy-MM-dd',$!ration.beginDate)~$!date.format('yyyy-MM-dd',$!ration.endDate)</th>
		<th></th>
    </tr>
    <tr>
        <th align="center">#springMessage('table.ratBkrationDetail.itemFlag')</th>
        <th align="center">#springMessage('table.ratBkrationDetail.itemCode')</th>
		<th align="center">#springMessage('table.ratBkrationDetail.creditType')</th> ## 授信方式
        <th align="center">#springMessage('table.ratBkration.money')</th>
        <th align="center">#springMessage('table.ratBkration.businessType')</th>##业务分类
        <th align="center">#springMessage('table.ratBkrationDisDetail.superProcessMoney')</th>##占用额度
        <th align="center">#springMessage('table.ratBkrationDisDetail.checkProcessMoney')</th>##在审占用额度
        <th align="center">#springMessage('table.ratBkrationDisDetail.overPlusMoney')</th>##可用额度
        <th align="center">#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>##剩余授信额度
		<th align="center">#springMessage('common.table.thead.operation')</th>#*操作*#
    </tr>
    </thead>
    <tbody>
    #foreach($rationDtl in $!{ration.rationDlts})
		#set($vcount = $velocityCount - 1)
  		#if($!{rationDtl.itemFlag} == "0")
  		<tr data-tt-id="$!{ration.ratCode}_$!{rationDtl.itemFlag}" data-tt-parent-id="$!{ration.ratCode}" >
  			##if($!{vcount} == "0")
		  	<td align="center" rowspan="$!{rationDtl.sysRationSize}">
  				$dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
  			</td>
	  		##end
		  	<td align="center" rowspan="$!{rationDtl.sysRationSize}">
  				$!{rationDtl.itemName}
  			</td>
            <td align="center" rowspan="$!{rationDtl.sysRationSize}">
				$dictTag.get("rat.creditType",$!{rationDtl.creditType})
			</td>
			<td align="right" rowspan="$!{rationDtl.sysRationSize}">$number.formatNumeric($!{rationDtl.money})</td>
            #foreach($sysBean in $!{rationDtl.sysBeans})
            <td align="center">$dictTag.get("ratUration.businessName", $!{sysBean.sysCode})</td>
            <td align="right"><a href="javascript:viewRatioUse('2','$!{ration.curCode}','$!{ration.corpId}','$!{ration.ratCode}','$!{rationDtl.itemFlag}','$!{rationDtl.itemCode}', '$!{sysBean.sysCode}')">$number.formatNumeric($!{sysBean.useMoney})</a></td>
            <td align="right"><a href="javascript:viewRatioUse('1','$!{ration.curCode}','$!{ration.corpId}','$!{ration.ratCode}','$!{rationDtl.itemFlag}','$!{rationDtl.itemCode}', '$!{sysBean.sysCode}')">$number.formatNumeric($!{sysBean.appMoney})</a></td>
                #if(${sysBean.order} == 1)
			<td align="right" rowspan="$!{rationDtl.sysRationSize}">$number.formatNumeric($!{rationDtl.overPlusMoney})</td>
			<td align="right" rowspan="$!{rationDtl.sysRationSize}">$number.formatNumeric($!{rationDtl.leftMoney})</td>
            #if($vcount == 0)
                #if($!{relateCon} == 1 && $!{ration.conId})
                    <td align="center" rowspan="$!{ration.lineNos}" align="right">$!{rationDtl.rationDlts.rationSize}<a href="#" onclick="conView('$!{ration.conId}')">#springMessage('common.button.conInfo')</a></td>
					<td align="center" rowspan="$!{ration.lineNos}" align="right"><a href="#" onclick="uploadAttachFile('$!{ration.ratCode}')">#springMessage('common.button.uploadAttachFile')</a></td>
                #else
                    <td align="center" rowspan="$!{ration.lineNos}" align="right"><a href="#" onclick="uploadAttachFile('$!{ration.ratCode}')">#springMessage('common.button.uploadAttachFile')</a></td>
                #end
            #end
                #end
                #if(${sysBean.order} != ${rationDtl.sysRationSize})
        </tr>
        <tr>
                #end
            #end
  		</tr>
		#else
		<tr data-tt-id="$!{ration.ratCode}_$!{rationDtl.itemFlag}" data-tt-parent-id="$!{ration.ratCode}" >
		  	<td align="center" >
  				$dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
  			</td>
			<td></td>
			<td></td>
			<td align="right">$number.formatNumeric($!{rationDtl.money})</td>
			<td align="center"></td>
  			<td align="right"><a href="javascript:viewRatioUse('2','$!{ration.curCode}','$!{ration.corpId}','$!{ration.ratCode}','$!{rationDtl.itemFlag}','','')">$number.formatNumeric($!{rationDtl.useMoney})</a></td>
			<td align="right"><a href="javascript:viewRatioUse('1','$!{ration.curCode}','$!{ration.corpId}','$!{ration.ratCode}','$!{rationDtl.itemFlag}','','')">$number.formatNumeric($!{rationDtl.approveMoney})</a></td>
			<td align="right">$number.formatNumeric($!{rationDtl.overPlusMoney})</td>
			<td align="right">$number.formatNumeric($!{rationDtl.leftMoney})</td>
			#if($vcount == 0)
				#if($!{relateCon} == 1 && $!{ration.conId})
					<td align="center" rowspan="$!{ration.rationSize}" align="right">$!{rationDtl.rationDlts.rationSize}<a href="#" onclick="conView('$!{ration.conId}')">#springMessage('common.button.conInfo')</a></td>
					<td align="center" rowspan="$!{ration.rationSize}" align="right"><a href="#" onclick="uploadAttachFile('$!{ration.ratCode}')">#springMessage('common.button.uploadAttachFile')</a></td>
				#else
					<td align="center" rowspan="$!{ration.rationSize}" align="right"><a href="#" onclick="uploadAttachFile('$!{ration.ratCode}')">#springMessage('common.button.uploadAttachFile')</a></td>
				#end
			#end
  		</tr>
			#foreach($comRationDtl in $!{rationDtl.rationDlts})
		<tr data-tt-id="$!{rationDtl.itemCode}" data-tt-parent-id="$!{ration.ratCode}_$!{rationDtl.itemFlag}" >
			<td rowspan="$!{comRationDtl.sysRationSize}"></td>
		  	<td align="center" rowspan="$!{comRationDtl.sysRationSize}">
  				$!{comRationDtl.itemName}
  			</td>
            <td align="center" rowspan="$!{comRationDtl.sysRationSize}">
				$dictTag.get("rat.creditType",$!{comRationDtl.creditType})
            </td>
			<td align="right" rowspan="$!{comRationDtl.sysRationSize}">$number.formatNumeric($!{comRationDtl.money})</td>
            #foreach($sysBean in $!{comRationDtl.sysBeans})
            <td align="center">$dictTag.get("ratUration.businessName", $!{sysBean.sysCode})</td>
		  	<td align="right"><a href="javascript:viewRatioUse('2','$!{ration.curCode}','$!{ration.corpId}','$!{ration.ratCode}','$!{rationDtl.itemFlag}','$!{comRationDtl.itemCode}', '$!{sysBean.sysCode}')">$number.formatNumeric($!{sysBean.useMoney})</a></td>
			<td align="right"><a href="javascript:viewRatioUse('1','$!{ration.curCode}','$!{ration.corpId}','$!{ration.ratCode}','$!{rationDtl.itemFlag}','$!{comRationDtl.itemCode}', '$!{sysBean.sysCode}')">$number.formatNumeric($!{sysBean.appMoney})</a></td>
                #if(${sysBean.order} == 1)
			<td align="right" rowspan="$!{comRationDtl.sysRationSize}">$number.formatNumeric($!{comRationDtl.overPlusMoney})</td>
			<td align="right" rowspan="$!{comRationDtl.sysRationSize}">$number.formatNumeric($!{comRationDtl.leftMoney})</td>
                #end
                #if(${sysBean.order} != ${comRationDtl.sysRationSize})
            </tr>
            <tr>
                #end
            #end
  		</tr>
  			#end
 		#end
 	#end
#end
    </tbody>
</table>
</div>
    <div id="page" style="position:fixed ; bottom:0px;width:100%;" ></div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/listRationQuery.js?_btv=${resourceVersion}"></script>
</html>
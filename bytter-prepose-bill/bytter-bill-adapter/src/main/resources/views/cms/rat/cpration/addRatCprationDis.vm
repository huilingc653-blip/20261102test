<!DOCTYPE html>  
<html lang="en">
<head>
<style type="text/css">
	.selectTreeDemo{
		width : 400px;
	}
</style>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{ratCprationPage.id}">
			<input type="hidden" id="ratType" name="ratType" value="1">
			<input type="hidden" id="disCount" name="disCount" value="1">
			<input type="hidden" id="itemSize" name="itemSize" value="$!{ratCprationPage.itemSize}">
			<input type="hidden" id="singItemSize" name="singItemSize" value="$!{ratCprationPage.singItemSize}">
			<input type="hidden" id="ratCorpId" name="ratCorpId" value="$!{ratCprationPage.corpId}">
		<input type="hidden" id="unUserMoney" value="$!{ratCprationPage.unUserMoney}">
        <table class="layui-table">
        	<tbody>
        	<tr>
        		##资金中心
				<td width="20%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="30%">
					$!{ratCprationPage.corpName}
				</td>
				##授信编号
				<td width="20%" class="textRight">#springMessage('table.ratBkration.ratCode')</td>
				<td width="30%">
                	$!{ratCprationPage.ratCode}
				</td>
			</tr>
        	<tr>
				##授信合同号
				<td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td>
                	$!{ratCprationPage.contractNo}
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratCprationPage.curName}
				</td>
			</tr>
        	<tr>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.endDate)
				</td>
			</tr>
        	<tr>
        		##授信额度
				<td class="textRight">#springMessage('table.ratBkration.money')</td>
				<td >
					$number.formatNumeric($!{ratCprationPage.money})
				</td>
        		##待分配授信金额
				<td class="textRight">#springMessage('table.ratBkrationDis.unDisMoney')</td>
				<td >
					$number.formatNumeric($!{ratCprationPage.unUserMoney})
				</td>
			</tr>
        	<tr>
        		##二次授信对象
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationDis.corpId')</td>
				<td colspan="3">
					<div class="layui-inline" id="ratCorpDiv">
						<div class="layui-input-inline">
							<div class="selectTreeDemo" data-width="400px;"></div>
						</div>
					</div>
				</td>
			</tr>
			</tbody>
		</table>
		
		<table id="singleTable" class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		        <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
		        <th width='180px'>#springMessage('table.ratCpration.disMoney')</th>
				##<th width="180px">#springMessage('table.ratBkrationDisDetail.overPlusMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($rationDtl in $!{ratCprationPage.singRationDtls})
	    		<tr>
    				<td align="center">
	    				$dictTag.get("RatModel.ItemFlag", "0")
    				</td>
	    			<td align="center">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemFlag" value="$!{rationDtl.itemFlag}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemCode" value="$!{rationDtl.itemCode}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemOrder" value="$!{rationDtl.itemOrder}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].compSign" value="$!{rationDtl.compSign}">
	    				$!{rationDtl.itemName}
					</td>
    				<td align="right">
    					<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].money" data-id="$!{rationDtl.itemOrder}money" data-biz-name="$!{rationDtl.itemOrder}money" 
    						class="layui-input bt-biz-moneyType" oldValue="$!{rationDtl.leftMoney}" data-max="$!{rationDtl.leftMoney}" value="0" data-decimal="2" data-minus="false" data-callback="bt.calMoney">
    				</td>
##					<td align="right">
##						$number.formatNumeric($!{rationDtl.unUserMoney})
##					</td>
    				<td align="right">
    					<input type="hidden" class="rationHidden" index="$!{rationDtl.itemOrder}" id="$!{rationDtl.itemOrder}unUserMoney" 
    						value="$!{rationDtl.unUserMoney}" oldValue="$!{rationDtl.unUserMoney}">
    					<div id="$!{rationDtl.itemOrder}moneySpan">
    					$number.formatNumeric($!{rationDtl.leftMoney})
    					</div>
    				</td>
	    		</tr>
	    		#end
		    </tbody>
		    <tfoot>
			    <tr>
	 				<td align="center">#springMessage('table.ratBkration.sumMoney')</td>
	 				<td ></td>
	 				<td align="right">
		 				<input type="text" data-name="moneysum" data-biz-name="moneysum" readonly="readonly" data-decimal="2" value="0"
							autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.ratBkrationDis.money')">
	 				</td>
					<td></td>
				</tr>
			</tfoot>
		</table>
		
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" id="temp">#springMessage('common.button.temp')</button>
					<button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/cpration/ratCprationDis.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            ##单位名称
            <td class="textRight">#springMessage("table.sysCorp.corpName")</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-biz-type="corp" data-type="selectTree" data-resource="cms:rat:yearFinPlanRegister:query"
                         data-required="true" data-name="corpId" data-biz-name="corpId" data-scope="all"></div>
                </div>
            </td>
            ##年度
            <td class="textRight">#springMessage("table.yearFinPlanRegister.years")</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" class="layui-input" name="years" id="years" lay-verify="required">
                </div>
            </td>
        </tr>
        <tr>
            ##年采购量
            <td class="textRight">#springMessage('table.yearFinPlanRegister.yearPurchaseAmount')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" class="layui-input bt-biz-moneyType" id="yearPurchaseAmount" data-name="yearPurchaseAmount" data-biz-name="yearPurchaseAmount"
                           data-decimal="2" data-minus="false" lay-verify="required" data-toup="yearPurchaseAmountUpper" >
                </div>
            </td>
            ##年采购量大写金额
            <td class="textRight">#springMessage('table.yearFinPlanRegister.yearPurchaseAmountUpper')</td>
            <td>
                <div class="layui-input-inline">
                    <div id="yearPurchaseAmountUpper"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##并购投资
            <td class="textRight">#springMessage('table.yearFinPlanRegister.mergeInvestmentAmount')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" class="layui-input bt-biz-moneyType" id="mergeInvestmentAmount" data-name="mergeInvestmentAmount" data-biz-name="mergeInvestmentAmount"
                           data-decimal="2" data-minus="false" lay-verify="required" data-toup="mergeInvestmentAmountUpper" >
                </div>
            </td>
            ##并购投资大写金额
            <td class="textRight">#springMessage('table.yearFinPlanRegister.mergeInvestmentAmountUpper')</td>
            <td>
                <div class="layui-input-inline">
                     <div id="mergeInvestmentAmountUpper"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##解决措施
            <td class="textRight">#springMessage('table.yearFinPlanRegister.solveMeasure')</td>
            <td colspan="6">
                <input type="text" class="layui-input" name="solveMeasure" lay-verify="strlength" data-maxlength="1000" autocomplete="off"
                       style="width:90%" placeholder="#springMessage('table.yearFinPlanRegister.solveMeasure')"/>
            </td>
        </tr>
        <tr>
            ##存在的困难
            <td class="textRight">#springMessage('table.yearFinPlanRegister.existDifficulty')</td>
            <td colspan="6">
                <input type="text" class="layui-input" name="existDifficulty" lay-verify="strlength" data-maxlength="1000" autocomplete="off"
                       style="width:90%" placeholder="#springMessage('table.yearFinPlanRegister.existDifficulty')"/>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/yearfinplanregister/ratYearFinPlanRegister.add.js?_btv=${resourceVersion}"></script>
</html>
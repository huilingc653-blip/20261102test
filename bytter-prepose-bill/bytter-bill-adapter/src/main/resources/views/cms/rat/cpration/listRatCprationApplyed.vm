<!DOCTYPE html> 
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #page a, #page span {
            height: 30px;
            line-height: 30px;
        }

        #page .layui-laypage-total {
            padding-right: 0px;
        }
    </style>
</head>
<body>
    <form id="searchForm" class="layui-form">
    <input type="hidden" id="ratCode" name="ratCode" value="${disVO.id}">
	<input type="hidden" id="disCode" name="disCode" value="${disVO.disCode}">
    <input type="hidden" id="corpId" name="corpId" value="${disVO.corpId}">
    </form>
<table border="0" width="100%">
    <tr align="center">
		<td colspan="11" align="center">
			<button type="button" class="layui-btn" onclick="add()">#springMessage('ration.urationapply.add')</button>
			<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
		</td>
	</tr>
</table>    
<div>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.ratUrationApply.applyCode')</th>
        <th>#springMessage('table.ratUrationApply.corpId')</th>
        <th>#springMessage('table.ratBkration.curCode')</th>
        <th>#springMessage('table.ratBkrationDetail.itemCode')</th>
        <th>#springMessage('table.ratUration.money')</th>
        <th>#springMessage('table.ratUrationApply.beginDate')</th>
        <th>#springMessage('table.ratUrationApply.endDate')</th>
        <th>#springMessage('table.ratBkration.status')</th>
##        <th>#springMessage('table.ratUration.urationCode')</th>
        <th style="width:190px;">#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
</div>
    <div id="page" style="position:fixed ; bottom:0px;width:100%;" ></div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/cpration/ratCprationApplyed.list.js?_btv=${resourceVersion}"></script>
</html>
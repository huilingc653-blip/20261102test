<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        .layui-body2 {
            padding：0px;
            /*position: absolute;*/
            left: 0px;
            right: 0;
            top: 0;
            bottom: 0;
            z-index: 998;
            width: auto;
            overflow: hidden;
            overflow-y: auto;
            -webkit-box-sizing: border-box;
            -moz-box-sizing: border-box;
            box-sizing: border-box;
        }

        .layui-tab-content {
            box-sizing: border-box;
            width: 100%;
            padding: 0px;
        }

        .layui-tab-item {
            width: 100%;
            height: 100%;
        }

        iframe {
            width: 100%;
            height: 100%;
            border: 0px;
        }

        html, body {
            height: 100%;
            box-sizing: border-box;
            -moz-box-sizing: border-box; /* Firefox */
            -webkit-box-sizing: border-box; /* Safari */
            padding-bottom: 0px;
        }
    </style>
</head>
<body>
<form id="search" class="layui-form">
    <table class="layui-table layui-table-border">
        <tr>
            ##授信单位
            <td class="textRight"><span id="showCorpName">#springMessage('table.ratBkration.corpId')</span></td>
            <td style="width: 30%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="corpId"
                         data-name="corpId"
                         data-biz-type="corp"
                         data-tree-type="check"
                         data-resource="cms:rat:rationAdjust:query"
                         data-type="selectTree"
                         data-defaultvalue="$!{corpId}"
                    ></div>
                </div>
            </td>
            ##银行信息
            <td class="textRight">#springMessage('table.ratBkration.bankCode')</td>
            <td style="width: 30%">
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-biz-name="bankCode"
                         data-url="${basePath}/cms/rat/raturation/getBanks"
                         data-valuefield="bankCode" data-textfield="bankName"
                         data-value="$!{bankCode}"
                         data-search="true" data-name="bankCode">
                    </div>
                </div>
            </td>
            ##授信品种
            <td class="textRight">#springMessage('table.ratBkrationDetail.itemCode')</td>
            <td style="width: 30%">
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-biz-name="itemCode"
                         data-url="${basePath}/cms/rat/ratitemcustom/getAllRatItem?type=0" data-method="get"
                         data-valuefield="id" data-textfield="name" data-value="$!{itemCode}"
                         data-search="true" data-name="itemCode">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##授信模式
            <td class="textRight">#springMessage('table.ratBkration.ratMode')</td>
            <td class="rCode">
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType"
                         data-biz-name="ratMode"
                         data-url="${basePath}/sys/dict/listByGroupCode?code=RatBkration.RatMode"
                         data-valuefield="code" data-textfield="name"
                         data-defaultvalue="$!{ratMode}" data-search="true"
                         data-name="ratMode">
                    </div>
                </div>
            </td>
            ##授信合同号
            <td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
            <td class="rCode">
                <div class="layui-input-inline">
                    <input type="text" name="contractNo" id="contractNo" value="$!{contractNo}"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.ratBkration.contractNo')">
                </div>
            </td>
            ##授信编号
            <td class="textRight">#springMessage('table.ratBkration.ratCode')</td>
            <td class="rCode">
                <div class="layui-input-inline">
                    <input type="text" name="ratCode" id="ratCode" value="$!{ratCode}"
                           autocomplete="off" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            ## 授信开始时间
            <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.begindate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-name="gBeginDate" data-biz-name="gBeginDate"
                           data-type="date" value="$!{gBeginDate}" data-endid="lBeginDate">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-name="lBeginDate" data-biz-name="lBeginDate"
                           data-type="date" value="$!{lBeginDate}" id="lBeginDate">
                </div>
            </td>
            ## 授信结束时间
            <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.enddate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-name="gEndDate" data-biz-name="gEndDate"
                           data-type="date" value="$!{gEndDate}" data-endid="lEndDate">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-name="lEndDate" data-biz-name="lEndDate"
                           data-type="date" value="$!{lEndDate}" id="lEndDate">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;" data-list="test">
                <button type="button" class="layui-btn" lay-filter="search" onclick="search()">#springMessage(
                    'common.button.search')</button>
                <button type="button" class="layui-btn layui-btn-primary" onclick="resetAdjust()">#springMessage(
                    'common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<div class="layui-body2">
    <div class="layui-tab layui-tab-brief" lay-filter="RatAdjust" style="height: 100%">
        <ul class="layui-tab-title">
            <li class="layui-this" lay-id="ratInputTab">#springMessage('ration.bkration.add')</li><!--授信录入  -->
            <li lay-id="ratDisTab">#springMessage('ration.bkrationdis.add')</li><!--授信分配  -->
        </ul>
        <div class="layui-tab-content">
            <div class="layui-tab-item layui-show">
                <iframe name="ratInputIframe" frameborder="0" style="width: 100%; height: 100%"></iframe>
            </div>
            <div class="layui-tab-item">
                <iframe name="ratDisIframe" frameborder="0" style="width: 100%; height: 100%"></iframe>
            </div>
        </div>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script>
    var $, form, layId, dateTypes, corpInit, dicts, selectType, mulselectType;
    initTabContentHeight();
    bt.use(['element', 'form', 'layedit', 'dateType', 'corp', 'dicts', 'selectType', 'mulselect'], function () {
        $ = bt.jquery;
        form = bt.form();
        dateTypes = bt.dateType.init();
        corpInit = bt.corp.init();
        dicts = bt.dicts.init();
        selectType = bt.selectType.init();//下拉框
        mulselectType = bt.mulselect.init();

        search();

        var element = layui.element();
        element.on('tab(RatAdjust)', function (data) {
            layId = data.elem.find('.layui-tab-title > li.layui-this').attr('lay-id');
            if (layId === "ratInputTab") {
                $("#showCorpName").html("授信单位");
            } else {
                $("#showCorpName").html("额度使用单位");
            }
            search();
        });
    });

    function search() {
        // 授信单位
        var corpIds = corpInit.get("corpId").val();
        var contractNo = $('#contractNo').val();
        var ratCode = $('#ratCode').val();
        var gBeginDate = dateTypes.get("gBeginDate").val();
        var lBeginDate = dateTypes.get("lBeginDate").val();
        var gEndDate = dateTypes.get("gEndDate").val();
        var lEndDate = dateTypes.get("lEndDate").val();
        var ratMode = selectType.get("ratMode").val();
        var bankInfos = mulselectType.get("bankCode").val();
        var itemCodeInfos = mulselectType.get("itemCode").val();
        var bankCode = "";
        for (var a = 0; a < bankInfos.length; a++) {
            if (!(bankInfos[a].bankcode === undefined || bankInfos[a].bankcode == null || bankInfos[a].bankcode === "")) {
                if (a === bankInfos.length - 1) {
                    bankCode = bankCode + bankInfos[a].bankcode;
                } else {
                    bankCode = bankCode + bankInfos[a].bankcode + ",";
                }
            }
        }
        var itemCode = "";
        for (var b = 0; b < itemCodeInfos.length; b++) {
            if (!(itemCodeInfos[b].id === undefined || itemCodeInfos[b].id == null || itemCodeInfos[b].id === "")) {
                if (b === itemCodeInfos.length - 1) {
                    itemCode = itemCode + itemCodeInfos[b].id;
                } else {
                    itemCode = itemCode + itemCodeInfos[b].id + ",";
                }
            }
        }
        try {
            var form = $("<form></form>").attr("style", "display:none").attr("method", "post");
            if (layId === "ratDisTab") {
                form.attr("action", basePath + "/cms/rat/ratbkrationadjust/ratDisAdjust?&start=1&len=10");
                form.attr("target", "ratDisIframe");
            } else {
                form.attr("action", basePath + "/cms/rat/ratbkrationadjust/ratInputAdjust?&start=1&len=10");
                form.attr("target", "ratInputIframe")
            }
            form.append($("<input/>").attr("type", "hidden").attr("name", "corpId").attr("value", corpIds));
            form.append($("<input/>").attr("type", "hidden").attr("name", "contractNo").attr("value", contractNo));
            form.append($("<input/>").attr("type", "hidden").attr("name", "ratCode").attr("value", ratCode));
            form.append($("<input/>").attr("type", "hidden").attr("name", "gBeginDate").attr("value", gBeginDate));
            form.append($("<input/>").attr("type", "hidden").attr("name", "lBeginDate").attr("value", lBeginDate));
            form.append($("<input/>").attr("type", "hidden").attr("name", "gEndDate").attr("value", gEndDate));
            form.append($("<input/>").attr("type", "hidden").attr("name", "lEndDate").attr("value", lEndDate));
            form.append($("<input/>").attr("type", "hidden").attr("name", "ratMode").attr("value", ratMode));
            form.append($("<input/>").attr("type", "hidden").attr("name", "bankCode").attr("value", bankCode));
            form.append($("<input/>").attr("type", "hidden").attr("name", "itemCode").attr("value", itemCode));
            form.appendTo('body');
            form.submit();
        } finally {
            form.remove();
        }
        return false;
    }

    // 重置
    function resetAdjust() {
        corpInit.get("corpId").val("");
        mulselectType.get("bankCode").val({value: ""});
        mulselectType.get("itemCode").val({value: ""});
        selectType.get("ratMode").val("");
        $("#contractNo").val("");
        $("#ratCode").val("");
        dateTypes.get("gBeginDate").val("");
        dateTypes.get("lBeginDate").val("");
        dateTypes.get("gEndDate").val("");
        dateTypes.get("lEndDate").val("");
    }

    function initTabContentHeight() {
        var tabContentHeight = $(window).height();
        $(document).find('.layui-tab-content').height(tabContentHeight)
    }

</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input type="hidden" id="conId" value="$!{conId}">
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{ratBkrationPage.id}">
    <input id="ratCode" name="ratCode" type="hidden" value="$!{ratBkrationPage.ratCode}">
    <input type="hidden" id="ratType" name="ratType" value="0">
    <input type="hidden" id="copmRatSize" name="copmRatSize" value="$!{copmRatSize}">
    <input type="hidden" id="singItemSize" name="singItemSize" value="$!{singItemSize}">
    <input type="hidden" id="compItemSize" name="compItemSize" value="$!{compItemSize}">
    <input type="hidden" id="itemSize" name="itemSize" value="$!{itemSize}">
    <input type="hidden" id="corpId" value="$!{ratBkrationPage.corpId}">
    <input type="hidden" id="curId" value="$!{ratBkrationPage.curId}">
    <input type="hidden" id="beginDate" value="$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)">
    <input type="hidden" id="endDate" value="$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)">
    <table class="layui-table">
        <tbody>
        <tr>
            ##授信模式
            <td width="15%" class="textRight">#springMessage('table.ratBkration.ratMode')</td>
            <td width="20%">
                $dictTag.get("RatBkration.RatMode", "$!{ratBkrationPage.ratMode}")
            </td>
            ##单位代码
            <td width="12%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
            <td width="20%">
                $!{ratBkrationPage.corpName}
            </td>
            ##授信合同号
            <td width="13%" class="textRight">#springMessage('table.ratBkration.contractNo')</td>
            <td width="20%">
                $!{ratBkrationPage.contractNo}
                #if($!{relateCon}==1 && $!{conType}==1)
                    <div id="contractInfo" class="layui-input-inline">
                        <input type="hidden" id="conId" name="conId" value="$!{conId}"/>
                        <div class="layui-input-inline">
                            <button class="layui-btn bt-biz-conView" data-biz-name="conView" type="button"
                                    data-callback="conViewCallback" data-beforeClick="conViewBefore">#springMessage(
                                'common.button.view')</button>
                        </div>
                    </div>
                #end
            </td>
        </tr>
        <tr>
            ##银行编号
            <td class="textRight">#springMessage('table.ratBkration.bankCode')</td>
            <td colspan="3">
                $!{ratBkrationPage.bankName}
            </td>
            ##授信币种
            <td class="textRight">#springMessage('table.ratBkration.curCode')</td>
            <td>
                $!{ratBkrationPage.curName}
            </td>
            ##额度是否包含保证金
            <!-- 				<td class="textRight">#springMessage('table.ratBkration.includeBailmoney')</td> -->
            <!-- 				<td> -->
            <!-- 					$dictTag.get("sf_yn", "$!{ratBkrationPage.includeBailmoney}") -->
            <!-- 				</td> -->
        </tr>
        <tr>
            ##授信开始时间
            <td class="textRight">#springMessage('table.ratBkration.begindate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
            </td>
            ##授信结束时间
            <td class="textRight">#springMessage('table.ratBkration.enddate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
            </td>
            ##结转授信编号
            <td class="textRight">#springMessage('table.ratBkration.changeCode')</td>
            <td>
                $!{ratBkrationPage.oldRatCode}
            </td>
        </tr>
        <tr>

            <td class="textRight">#springMessage('table.sysAttachment.createBy')</td>
            <td>
                $!{ratBkrationPage.userName}
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            ##备注
            <td class="textRight" width="15%">#springMessage('table.ratBkration.remark')</td>
            <td colspan="6">
                $!{ratBkrationPage.remark}
            </td>
        </tr>
        </tbody>
    </table>
    <table id="singleTable" class="layui-table layui-form  layui-table-border" style="width:100%;">
        <thead>
        <tr>
            <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
            <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
            <th width='220px'>#springMessage('table.ratBkrationDetail.creditType')</th>##授信方式
            <th width='180px'>#springMessage('table.ratBkrationDetail.money')</th>
            <th width='180px'>#springMessage('table.ratBkrationDetail.maxMoney')</th>
        </tr>
        </thead>
        <tbody>
            #foreach($rationDtl in $!{ratBkrationPage.singRationDtls})
            <tr>
                <td align="center">
                    $dictTag.get("RatModel.ItemFlag", "0")
                </td>
                <td align="center">
                    $!{rationDtl.itemName}
                </td>
                <td align="center">
                    $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                </td>
                <td align="right">
                    $number.formatNumeric($!{rationDtl.money})
                </td>
                <td>
                </td>
            </tr>
            #end
            ##综合授信
            #foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
                #set($vcount = $velocityCount - 1)
            <tr>
                #if($!{vcount} == "0")
                    <td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
                        $dictTag.get("RatModel.ItemFlag", "1")
                    </td>
                #end
                <td align="center">
                    $!{rationDtl.itemName}
                </td>
                <td align="center">
                    $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                </td>
                #if($!{vcount} == "0")
                    <td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
                        $number.formatNumeric($!{rationDtl.money})
                    </td>
                #end
                <td align="right">
                    $number.formatNumeric($!{rationDtl.maxMoney})
                </td>
            </tr>
            #end
        </tbody>
        <tfoot>
        <tr>
            <td align="center">#springMessage('table.ratBkration.sumMoney')</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td align="right">
                $number.formatNumeric($!{ratBkrationPage.money})
            </td>
            <td>&nbsp;</td>
        </tr>
        </tfoot>
    </table>
    <table class="layui-table">
        <tbody>
            ##合同附件
        <tr>
            <td class="textRight">#springMessage('table.ratBkration.contractAttach')</td>
            <td style="text-align: center;" colspan="3">
                <!-- 合同附件上传 -->
                <input id="contractAnnexName" name="contractUploadId" type="hidden"
                       value="$!{ratBkrationPage.contractAttachfilepath}">
                <div id="contractUploader" class="layui-input-inline" style="width:100%"></div>
            </td>
        </tr>
        <tr>
            ##附件
            <td class="textRight">#springMessage('table.ratBkration.attach')</td>
            <td colspan="3">
                <!-- 附件上传 -->
                <input id="annexNameInfo" name="annexNameInfo" type="hidden" value="$!{ratBkrationPage.attachfilepath}">
                <div id="uploaderInfo" class="layui-input-inline" style="width:100%"></div>
            </td>
        </tr>
        </tbody>
    </table>
    #if($!{isHangBail}=="1")
        ##保证金信息
        #if(${ratBkrationPage.isHookBond}=="1")
            <h2 class="layui-colla-title">#springMessage('table.fcBond.BondMsg')</h2>
            #set($fcBondApplyDTO=$fcBondTag.getBondApplyDetail($!{ratBkrationPage.id},$!{ratBkrationPage.ratCode}))
            #parse("views/common/viewFcBondDetail.vm")
        #end
    #end
    #if($!{isGuarantee}=="1")##授信参数设置挂接担保
        ##担保合同信息
        #if(${ratBkrationPage.isHangGuarantee}=="1")
            <h2 class="layui-colla-title">#springMessage('table.guaContract.ContractMsg')</h2>
            #set($guaContractUseDTO=$guaContractTag.getGuaContractOccupyDetail($!{ratBkrationPage.id},$!{ratBkrationPage.ratCode}))
            #if($!{guaContractUseDTO})
                #parse("views/common/guaContractDetail.vm")
            #end
        #end
    #end
    <table class="layui-table">
        <tr colspan="6" style="text-align: center;">
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" lay-filter="close">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaContractSelect.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">
    bt.use(['form', 'layedit', 'btUpload', 'jquery', 'conView'], function () {
        var $ = bt.jquery, form = bt.form();
        bt.conView.init();

        var gInfoId = $("#annexNameInfo").val();
        bt.btUpload.init({
            elem: "#uploaderInfo",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gInfoId
        });

        // 合同附件上传
        var contractGid = $("#contractAnnexName").val();
        var contractUp = bt.btUpload.init({
            elem: "#contractUploader",
            isExpand: true,
            auto: false,
            gid: contractGid
        });

        //监听提交
        form.on('submit(submit)', function (data) {
            var url = "/cms/rat/raturation/saveAttachFile";
            data.field.contractAttachfilepath = contractUp.getGroupId();//设置合同附件id
            bt.loading.show();//显示加载中
            $.post(basePath + url, data.field, function (result) {
                bt.loading.hide(); //关闭加载中
                parent.layer ? parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}) : layer.alert(result.msg, {icon: result.success ? 1 : 2});
                if (result.success) {
                    if (!bt.navtab) {
                        parent.layer ? parent.layer.closeAll() : layer.closeAll();
                    } else {
                        bt.navtab.closeCurrent();
                    }
                }
            }, 'JSON');
            return false;
        });

        //监听关闭
        form.on('submit(close)', function (data) {
            if (!bt.navtab) {
                parent.layer ? parent.layer.closeAll() : layer.closeAll();
            } else {
                //bt.navtab.refreshParent();
                bt.navtab.closeCurrent();
            }
            return false;
        });
    });

    /**
     * 查看挂接的合同信息
     */
    function conViewBefore() {
        var conId = $('#conId').val();
        var params = new Object();
        params.id = conId;
        if (bt.empty(conId)) {
            layer.alert(bt.lang('common.table.selectConstract'), {icon: 5});
            return false;
        } else {
            bt.conView.set(params);
        }
        return true;
    }

    /**
     * 合同查看回调函数
     * @param data
     * @param dom
     * @returns {boolean}
     */
    function conViewCallback(data, dom) {
        return true;
    }
</script>
</html>

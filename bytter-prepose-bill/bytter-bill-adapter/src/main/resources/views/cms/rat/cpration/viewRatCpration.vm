<!DOCTYPE html> 
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
		<input type="hidden" id="conId" value="$!{conId}">
	<form class="layui-form" method="post">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##单位代码
				<td width="12%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="20%">
					$!{ratCprationPage.corpName}
				</td>
				##授信合同号
				<td width="13%" class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td width="20%">
                	$!{ratCprationPage.contractNo}
					#if($!{relateCon}==1 && $!{conType}==1)
						<div id="contractInfo" class="layui-input-inline">
							<input type="hidden" id="conId" name="conId" value="$!{conId}"/>
							<div class="layui-input-inline">
								<button class="layui-btn bt-biz-conView"  data-biz-name="conView" type="button"
										data-callback="conViewCallback" data-beforeClick="conViewBefore">#springMessage('common.button.view')</button>
							</div>
						</div>
					#end
				</td>
				##授信编号
				<td width="13%" class="textRight">#springMessage('table.ratBkration.ratCode')</td>
				<td width="20%">
                	$!{ratCprationPage.ratCode}
				</td>
			</tr>
        	
				##额度是否包含保证金
<!-- 				<td class="textRight">#springMessage('table.ratBkration.includeBailmoney')</td> -->
<!-- 				<td> -->
<!-- 					$dictTag.get("sf_yn", "$!{ratCprationPage.includeBailmoney}") -->
<!-- 				</td> -->
        	<tr>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.endDate)
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratCprationPage.curName}
				</td>
			</tr>
			</tbody>
		</table>
		<table id="singleTable" class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		        <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.money')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($rationDtl in $!{ratCprationPage.singRationDtls})
	    		<tr>
    				<td align="center">
	    				$dictTag.get("RatModel.ItemFlag", "0")
    				</td>
	    			<td align="center">
	    				$!{rationDtl.itemName}
					</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.money})
    				</td>
	    		</tr>
	    		#end
		    </tbody>
		    <tfoot>
	    	<tr>
		        <td align="center">#springMessage('table.ratBkration.sumMoney')</td>
		        <td >&nbsp;</td>
		        <td align="right">
		        	$number.formatNumeric($!{ratCprationPage.money})
				</td>
		    </tr>
		    </tfoot>
		</table>
		<table class="layui-table">
			<tbody>
			<tr>
        		##备注
				<td class="textRight" width="15%">#springMessage('table.ratBkration.remark')</td>
				<td colspan="6">
                	$!{ratCprationPage.remark}
				</td>
			</tr>
			#if($!{viewFlag} == "1")
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="close">#springMessage('common.button.close')</button>
				</td>
			</tr>
			#end
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
bt.use(['form','layedit','conView'], function(){
	var $ = bt.jquery,form = bt.form();
	bt.conView.init();
    //监听提交
    form.on('submit(close)', function(data){
    	if(!bt.navtab){
            parent.layer?parent.layer.closeAll():layer.closeAll();
        } else {
        	//bt.navtab.refreshParent();
        	bt.navtab.closeCurrent();
        }
    	return false;
    });
});

/**
 * 查看挂接的合同信息
 */
function conViewBefore() {
	var conId = $('#conId').val();
	var params = new Object();
	params.id = conId;
	if(bt.empty(conId)){
		layer.alert(bt.lang('common.table.selectConstract'), {icon:5});
		return false;
	}else{
		bt.conView.set(params);
	}
	return true;
}

/**
 * 合同查看回调函数
 * @param data
 * @param dom
 * @returns {boolean}
 */
function conViewCallback(data,dom){
	return true;
}

bt.empty = function (Str) {
	if (null == Str || Str == undefined || Str == "") {
		return true;
	} else {
		return false
	}

};
</script>

</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input type="hidden" id="id" name="id" value="$!{addCode}">
			<input type="hidden" id="ratCode" name="ratCode" value="$!{ratBkrationPage.id}">
			<input type="hidden" id="ratType" name="ratType" value="0">
			<input type="hidden" id="flag" name="flag" value="${flag}">
			<input type="hidden" id="itemSize" name="itemSize" value="$!{ratBkrationPage.itemSize}">
			<input type="hidden" id="singItemSize" name="singItemSize" value="$!{ratBkrationPage.singItemSize}">
			<input type="hidden" id="compItemSize" name="compItemSize" value="$!{ratBkrationPage.compItemSize}">
			<input type="hidden" id="compItemIndex" name="compItemIndex" value="$!{ratBkrationPage.compItemIndex}">
			<input type="hidden" id="corpId" name="corpId" value="$!{ratBkrationPage.corpId}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="20%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="30%">
					$!{ratBkrationPage.ratCorpName}
				</td>
				##授信编号
				<td width="20%" class="textRight">#springMessage('table.ratBkration.ratCode')</td>
				<td width="30%">
                	$!{ratBkrationPage.ratCode}
				</td>
			</tr>
        	<tr>
        		##授信银行编号
				<td class="textRight">#springMessage('table.ratBkration.bankType')</td>
				<td >
					$!{ratBkrationPage.TypeName}
				</td>
        		##授信银行编号
				<td class="textRight">#springMessage('table.ratBkration.bankCode')</td>
				<td >
					$!{ratBkrationPage.bankName}
				</td>
			</tr>
        	<tr>
				##授信合同号
				<td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td>
                	$!{ratBkrationPage.contractNo}
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratBkrationPage.curName}
				</td>
			</tr>
        	<tr>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
				</td>
			</tr>
        	<tr>
        		##可追加授信额度
				<td class="textRight">#springMessage('table.ratBkrationadd.addmoney')</td>
				<td >
					$number.formatNumeric($!{ratBkrationPage.allAddMoney})
				</td>
        		##可追加授信敞口额度
				<td class="textRight">#springMessage('table.ratBkration.addOpenMoney')</td>
				<td >
					$number.formatNumeric($!{ratBkrationPage.allAddOpenMoney})
				</td>
			</tr>
        	<tr>
        		##二次授信对象
				<td class="textRight">#springMessage('table.ratBkrationDis.corpId')</td>
				<td colspan="3">
					$!{ratBkrationPage.corpName}
				</td>
			</tr>
			</tbody>
		</table>
		
		<table id="singleTable" class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		        <th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th>#springMessage('table.ratBkrationDetail.itemCode')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.disMoney')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.allDisMoney')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.allAddMoney')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.disOpenMoney')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.allDisOpenMoney')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.allAddOpenMoney')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.money')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.openMoney')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.leftMaxMoney')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.maxMoney')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($rationDtl in $!{ratBkrationPage.singRationDtls})
	    		<tr>
    				<td align="center">
	    				$dictTag.get("RatModel.ItemFlag", "0")
    				</td>
	    			<td align="center">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemFlag" id="itemFlag$!{rationDtl.itemOrder}" value="$!{rationDtl.itemFlag}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemCode" value="$!{rationDtl.itemCode}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemOrder" value="$!{rationDtl.itemOrder}">
	    				<input type="hidden" id="assurepercent$!{rationDtl.itemOrder}" value="$!{rationDtl.assurepercent}">
	    				$!{rationDtl.itemName}
					</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.money})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.allDisMoney})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.allAddMoney})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.openMoney})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.allDisOpenMoney})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.allAddOpenMoney})
    				</td>
    				<td align="right">
    					<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].money" id="$!{rationDtl.itemOrder}money" data-biz-name="$!{rationDtl.itemOrder}money" 
    						class="layui-input bt-biz-moneyType" data-min="-$!{rationDtl.allDisMoney}" data-max="$!{rationDtl.allAddMoney}" value="$!{rationDtl.addMoney}" data-decimal="2" data-minus="true" data-callback="bt.calMoney">
    				</td>
    				<td align="right">
    					<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].openMoney" id="$!{rationDtl.itemOrder}openMoney" data-biz-name="$!{rationDtl.itemOrder}openMoney" 
    						class="layui-input bt-biz-moneyType" data-min="-$!{rationDtl.allDisOpenMoney}" data-max="$!{rationDtl.allAddOpenMoney}" value="$!{rationDtl.addOpenMoney}" data-decimal="2" data-minus="true" readonly="readonly">
    				</td>
	    			<td></td>
	    			<td></td>
	    		</tr>
	    		#end
		   ##综合授信
	    	#foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
	    		#set($vcount = $velocityCount - 1)
	    		<tr>
	    			#if($!{vcount} == "0")
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
	    				$dictTag.get("RatModel.ItemFlag", "1")
    				</td>
	    			#end
	    			<td align="center">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemFlag" id="itemFlag$!{rationDtl.itemOrder}" value="$!{rationDtl.itemFlag}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemCode" value="$!{rationDtl.itemCode}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemOrder" value="$!{rationDtl.itemOrder}">
	    				<input type="hidden" id="interestrate$!{rationDtl.itemOrder}" value="$!{rationDtl.interestrate}">
	    				$!{rationDtl.itemName}
					</td>
					#if($!{vcount} == "0")
					<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
						$number.formatNumeric($!{rationDtl.money})
					</td>
					<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
						$number.formatNumeric($!{rationDtl.allDisMoney})
					</td>
					<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
						$number.formatNumeric($!{rationDtl.allAddMoney})
					</td>
					<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
						$number.formatNumeric($!{rationDtl.openMoney})
					</td>
					<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
						$number.formatNumeric($!{rationDtl.allDisOpenMoney})
					</td>
					<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
						$number.formatNumeric($!{rationDtl.allAddOpenMoney})
					</td>
					<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].money" id="$!{rationDtl.itemOrder}money" data-biz-name="$!{rationDtl.itemOrder}money" 
    						class="layui-input bt-biz-moneyType" data-min="-$!{rationDtl.allDisMoney}" data-max="$!{rationDtl.allMoney}" value="$!{rationDtl.addMoney}" data-decimal="2" data-minus="true" data-callback="bt.calMoney">
    				</td>
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].openMoney" id="$!{rationDtl.itemOrder}openMoney" data-biz-name="$!{rationDtl.itemOrder}openMoney" 
    						class="layui-input bt-biz-moneyType" data-min="-$!{rationDtl.allDisOpenMoney}" data-max="$!{rationDtl.allAddOpenMoney}" value="$!{rationDtl.addOpenMoney}" data-decimal="2" data-minus="true" readonly="readonly">
    				</td>
	    			#end
	    			<td align="right">
    					$number.formatNumeric($!{rationDtl.allDisMaxMoney})
	    			</td>
	    			<td align="right">
    					<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].maxMoney" data-id="$!{rationDtl.itemOrder}maxMoney" rowindex="$!{rationDtl.itemOrder}" data-biz-name="$!{rationDtl.itemOrder}maxMoney" 
    						class="layui-input bt-biz-moneyType" data-min="-$!{rationDtl.allDisMaxMoney}" data-max="$!{rationDtl.allAddMoney}" value="$!{rationDtl.addMaxMoney}" data-decimal="2" data-minus="true" data-callback="bt.calMaxMoney">
	    			</td>
	    		</tr>
	    	#end
		    </tbody>
		    <tfoot>
			    <tr>
	 				<td align="center">#springMessage('table.ratBkrationAdd.sumMoney')</td>
	 				<td></td>
	 				<td></td>
	 				<td></td>
	 				<td></td>
	 				<td></td>
	 				<td></td>
	 				<td></td>
	 				<td align="right">
		 				<input type="text" data-name="moneysum" data-biz-name="moneysum" readonly="readonly" data-decimal="2" value="$!{ratBkrationPage.moneysum}"
							autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.ratBkrationDis.money')">
	 				</td>
	 				<td align="right">
		 				<input type="text" data-name="openMoneysum" data-biz-name="openMoneysum" readonly="readonly" data-decimal="2" value="$!{ratBkrationPage.openMoneysum}"
							autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.ratBkrationDis.openMoney')">
	 				</td>
	 				<td></td>
	 				<td></td>
				</tr>
			</tfoot>
		</table>
		
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/cpratBkrationOpenAdd.edit.js?_btv=${resourceVersion}"></script>
</html>
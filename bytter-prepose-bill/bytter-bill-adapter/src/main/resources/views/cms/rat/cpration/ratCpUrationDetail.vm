<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="changeType" id="changeType" value="${changeType}">
</form>
<div>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.ratUrationApply.corpId')</th>
            <th>#springMessage('table.ratBkration.curCode')</th>
            <th>#springMessage('table.ratUrationApply.beginDate')</th>
            <th>#springMessage('table.ratUrationApply.endDate')</th>
            <th>#springMessage('table.ratBkrationDetail.itemCode')</th>
            <th>#springMessage('table.ratBkration.money')</th>
            <th>#springMessage('table.ratBkrationDisDetail.superProcessMoney')</th>##占用额度
            <th>#springMessage('table.ratBkrationDisDetail.checkProcessMoney')</th>##在审占用额度
            <th>#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>##剩余授信额度
            <th>#springMessage('table.ratBkrationDisDetail.ratOccupyRatio')</th>##授信占用比列
            <th bgcolor style="color:red;">#springMessage('table.ratBkrationDisDetail.ratOccupiedRation')</th>##已占用比列
        </tr>
        </thead>
        #foreach($ration in $!{rations})
        <tr>
            <td align="center" rowspan="$!{ration.rationSize}">$!{ration.corpName}</td>
            <td align="center" rowspan="$!{ration.rationSize}">$!{ration.curName}</td>
            <td align="center" rowspan="$!{ration.rationSize}">$!{ration.beginDate}</td>
            <td align="center" rowspan="$!{ration.rationSize}">$!{ration.endDate}</td>
            #foreach($rationDlt in $!{ration.rationDlts})
                #set($vcount = $velocityCount - 1)
                #if($!{vcount} == "0")
                    #if($!{rationDlt.itemFlag} == "0")
                        <td align="center">$!{rationDlt.itemName}</td>
                        <td align="right">$number.formatNumeric($!{rationDlt.money})</td>
                        <td align="right">$number.formatNumeric($!{rationDlt.useMoney})</td>
                        <td align="right">$number.formatNumeric($!{rationDlt.approveMoney})</td>
                        <td align="right">$number.formatNumeric($!{rationDlt.leftMoney})</td>
                        <td align="right">$number.formatNumeric($math.mul($!{rationDlt.ratOccupyRatio},100),"0.00")%</td>
                        <td align="center" style="color:red;font-weight: bold;" rowspan="$!{ration.rationSize}">$number.formatNumeric($math.mul($!{ration.ratOccupiedRation},100),"0.00")%</td>
                    #end
                #else
                </tr>
                <tr>
                    #if($!{rationDlt.itemFlag} == "0")
                        <td align="center">$!{rationDlt.itemName}</td>
                        <td align="right">$number.formatNumeric($!{rationDlt.money})</td>
                        <td align="right">$number.formatNumeric($!{rationDlt.useMoney})</td>
                        <td align="right">$number.formatNumeric($!{rationDlt.approveMoney})</td>
                        <td align="right">$number.formatNumeric($!{rationDlt.leftMoney})</td>
                        <td align="right">$number.formatNumeric($math.mul($!{rationDlt.ratOccupyRatio},100),"0.00")%</td>
                        <td align="center" style="color:red;font-weight: bold;" rowspan="$!{ration.rationSize}">$number.formatNumeric($math.mul($!{ration.ratOccupiedRation},100),"0.00")%</td>
                    #end
                #end
            #end
        </tr>
        #end
        <tr>
            <td colspan="11" style="text-align: center;">
                <button type="button" class="layui-btn" onclick="cancelRation()">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationSelect.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html> 
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{result.ratBkrationReliefPage.id}">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{result.ratBkrationReliefPage.ratCode}">
			<input type="hidden" id="ratType" name="ratType" value="0">
			<input type="hidden" id="corpId" name="corpId" value="$!{result.ratBkrationReliefPage.corpId}">
			<input type="hidden" id="reliefCorp" name="reliefCorp" value="$!{result.ratBkrationReliefPage.reliefCorp}">
			<input type="hidden" id="byReliefCorp" name="byReliefCorp" value="$!{result.ratBkrationReliefPage.byReliefCorp}">
			<input type="hidden" id="curCode" name="curCode" value="$!{result.ratBkrationReliefPage.curCode}">
			<input type="hidden" id="flag" name="flag" value="$!{result.flag}">
			<input type="hidden" id="assurepercent" name="assurepercent" value="">
			<input type="hidden" id="interestrate" name="interestrate" value="">
			<input type="hidden" id="reliefCode" name="reliefCode" value="$!{result.ratBkrationReliefPage.reliefCode}">
			<input type="hidden" id="byReliefCode" name="byReliefCode" value="$!{result.ratBkrationReliefPage.byReliefCode}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="18%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="32%" colspan="2">
					$!{result.ratBkrationPage.corpName}
				</td>
				##授信编号
                    <td class="textRight">#springMessage('table.ratBkration.ratCode')</td>
                    <td colspan="2">
						$!{result.ratBkrationPage.ratCode}
                    </td>
			</tr>
        	<tr>
				##授信合同号
				<td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td colspan="2">
                	$!{result.ratBkrationPage.contractNo}
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td colspan="2">
					$!{result.ratBkrationPage.curName}
				</td>
			</tr>
			<tr>
				##调剂单位
				<td class="textRight">#springMessage('table.ratBkrationRelief.reliefCorp')</td>
				<td colspan="2">
                	$!{result.ratBkrationReliefPage.reliefCorpName}
				</td>
				##被调剂单位
				<td class="textRight">#springMessage('table.ratBkrationRelief.byReliefCorp')</td>
				<td colspan="2">
                	$!{result.ratBkrationReliefPage.byReliefCorpName}
				</td>
			</tr>
			<tr>
        		##调剂品种类型
				<td class="textRight">#springMessage('table.ratBkrationRelief.reliefItemFlag')</td>
				<td colspan="2">
					$dictTag.get("RatModel.ItemFlag", ${result.ratBkrationReliefPage.reliefItemFlag})
				</td>
        		##被调剂品种类型
				<td class="textRight">#springMessage('table.ratBkrationRelief.byReliefItemFlag')</td>
				<td colspan="2">
					$dictTag.get("RatModel.ItemFlag", ${result.ratBkrationReliefPage.byReliefItemFlag})
				</td>
			</tr>
			<tr>
        		##调剂品种
				<td class="textRight">#springMessage('table.ratBkrationRelief.reliefItemCode')</td>
				<td colspan="2" id="reliefItemCodeTd">
					#if($!{result.ratBkrationReliefPage.reliefItemFlag} == "0")
					<div class="layui-input-inline">
						${result.ratBkrationReliefPage.reliefItemName}
					</div>
					#else
						<table class="layui-table" width="100%" style="margin:0px">
							<tr>
								<th>#springMessage("table.ratBkrationDetail.itemCode")</th>
								<th>#springMessage("table.ratBkrationDisDetail.leftDisMoney")</th>
								<th>#springMessage("table.ratBkrationRelief.byReliefMoney")</th>
							</tr>
							#foreach($item in $!{result.reliefItems})
							<tr>
								<td><input type="hidden" name="reliefDtls['$!{item.itemOrder}'].itemOrder" value="$!{item.itemOrder}">
								<input type="hidden" name="reliefDtls['$!{item.itemOrder}'].reliefItemCode" value="$!{item.itemCode}">$!{item.itemName}</td>
								<td align="right">$number.formatNumeric($!{item.maxMoney})</td>
								<td align="right">$number.formatNumeric($!{item.money})</td>
							</tr>
							#end
						</table>
					#end
				</td>
        		##被调剂品种
				<td class="textRight">#springMessage('table.ratBkrationRelief.byReliefItemCode')</td>
				<td id="byReliefItemCodeTd">
					#if($!{result.ratBkrationReliefPage.byReliefItemFlag} == "0")
						${result.ratBkrationReliefPage.byReliefItemName}
					#else
						<table class="layui-table" width="100%" style="margin:0px">
							<tr>
								<th>#springMessage("table.ratBkrationDetail.itemCode")</th>
								<th>#springMessage("table.ratBkrationDisDetail.leftDisMoney")</th>
								<th>#springMessage("table.ratBkrationRelief.canReliefMoney")</th>
							</tr>
							#foreach($item in $!{result.byReliefItems})
							<tr>
								<td><input type="hidden" name="reliefDtls['$!{item.itemOrder}'].byItemOrder" value="$!{item.itemOrder}">
								<input type="hidden" name="reliefDtls['$!{item.itemOrder}'].byReliefItemCode" value="$!{item.itemCode}">$!{item.itemName}</td>
								<td align="right">$number.formatNumeric($!{item.maxMoney})</td>
								<td align="right">$number.formatNumeric($!{item.money})</td>
							</tr>
							#end
						</table>
					#end
				</td>
			</tr>
			<tr>
				##调剂额度
				<td class="textRight">#springMessage('table.ratBkrationRelief.byReliefMoney')</td>
				<td colspan="2">
                	$number.formatNumeric($!{result.disMoneyDTO.money})
				</td>
        		##被调剂额度
				<td class="textRight">#springMessage('table.ratBkrationRelief.reliefMoney')</td>
				<td colspan="2">
                	$number.formatNumeric($!{result.ratBkrationReliefPage.reliefMoney})
				</td>
			</tr>
			</tbody>
		</table>
		#if($!{viewFlag} == "1")
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button type="button" onclick="closeTab()" class="layui-btn">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
        #end
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
bt.use(['form','layedit'], function(){
	var $ = bt.jquery,form = bt.form();
    //监听提交
});

var closeTab =  function(){
	if(!bt.navtab){
        parent.layer?parent.layer.closeAll():layer.closeAll();
    } else {
    	//bt.navtab.refreshParent();
    	bt.navtab.closeCurrent();
    }
	return false;
};

</script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<style>
	#1{
		display: none;
	}
</style>
<body>
	<form class="layui-form" method="post">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{ratBkrationPage.id}">
			<input type="hidden" id="ratType" name="ratType" value="0">
			<input type="hidden" id="flag" name="flag" value="${flag}">
			<input type="hidden" id="itemSize" name="itemSize" value="$!{ratBkrationPage.itemSize}">
			<input type="hidden" id="singItemSize" name="singItemSize" value="$!{ratBkrationPage.singItemSize}">
			<input type="hidden" id="compItemSize" name="compItemSize" value="$!{ratBkrationPage.compItemSize}">
			<input type="hidden" id="compItemIndex" name="compItemIndex" value="$!{ratBkrationPage.compItemIndex}">
			<input type="hidden" id="corpId" name="corpId" value="$!{ratBkrationPage.corpId}">
			<input type="hidden" id="bondPercent" name="bondPercent" value="$!{dto.bondPercent}">
			
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="20%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="30%">
					$!{ratBkrationPage.corpName}
				</td>
				##授信编号
				<td width="20%" class="textRight">#springMessage('table.ratBkration.ratCode')</td>
				<td width="30%">
                	$!{ratBkrationPage.ratCode}
				</td>
			</tr>
        	<tr>
        		##授信银行编号
				<td class="textRight">#springMessage('table.ratBkration.bankType')</td>
				<td >
					$!{ratBkrationPage.TypeName}
				</td>
        		##授信银行编号
				<td class="textRight">#springMessage('table.ratBkration.bankCode')</td>
				<td >
					$!{ratBkrationPage.bankName}
				</td>
			</tr>
        	<tr>
				##授信合同号
				<td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td>
                	$!{ratBkrationPage.contractNo}
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratBkrationPage.curName}
				</td>
			</tr>
        	<tr>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
				</td>
			</tr>
        	<tr>
        		##授信额度
				<td class="textRight">#springMessage('table.ratBkration.money')</td>
				<td >
					$number.formatNumeric($!{ratBkrationPage.money})
				</td>
        		##授信敞口额度
				<td class="textRight"></td>
				<td >
				</td>
			</tr>
            <tr>
                <td colspan="6">
                    <button class="layui-btn" id="addSingleTr" lay-submit="false" type="button" lay-filter="addSingleTr">#springMessage('ration.addSingleTr')</button>
                    <button class="layui-btn" id="addCompTr" lay-submit="false" type="button" lay-filter="addCompTr">#springMessage('ration.addCompTr')</button>
                </td>
            </tr>
			</tbody>
		</table>
		
		<table id="ratTable" class="layui-table layui-form layui-table-border" style="width:100%;">
		    <thead>
		    <tr>
		        <th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th>#springMessage('table.ratBkrationDetail.itemCode')</th>
                <th>#springMessage('table.ratBkrationDetail.creditType')</th>##授信方式
		        <th>#springMessage('table.ratBkrationAddDetail.oriMoney')</th>
		        <th>#springMessage('table.ratBkrationDis.leftMoney')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.money')</th>
		        <th>#springMessage('table.ratBkrationDis.leftMaxMoney')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.maxMoney')</th>
                <th>#springMessage('common.table.thead.operation')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($rationDtl in $!{ratBkrationPage.singRationDtls})
					#if("$!{rationDtl.money}" != "0")
					<tr class="single">
						<td align="center"">
							$dictTag.get("RatModel.ItemFlag", "0")
                        <input class="$!{rationDtl.itemOrder}singleSign" value="0" type="hidden">
						</td>
						<td align="center">
							<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemFlag" id="itemFlag$!{rationDtl.itemOrder}" value="$!{rationDtl.itemFlag}">
							<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemCode" value="$!{rationDtl.itemCode}" class="default_itemCode">
							<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemOrder" value="$!{rationDtl.itemOrder}">
                            <input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].creditType" value="$!{rationDtl.creditType}">
							<input type="hidden" id="assurepercent$!{rationDtl.itemOrder}" value="$!{rationDtl.assurepercent}">
							$!{rationDtl.itemName}
						</td>
                        <td align="center">
							$dictTag.get("rat.creditType", $!{rationDtl.creditType})
                        </td>
						<td align="right">
							$number.formatNumeric($!{rationDtl.money})
						</td>
						<td align="right">
							$number.formatNumeric($!{rationDtl.leftMoney})
                            <input type="hidden" class="$!{rationDtl.itemOrder}singLeftMoney" value="$!{rationDtl.leftMoney}">
						</td>
						<td align="right">
							<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].money" id="$!{rationDtl.itemOrder}money" data-biz-name="$!{rationDtl.itemOrder}money" 
								class="layui-input bt-biz-moneyType" data-min="-$!{rationDtl.leftMoney}" value="0" data-decimal="2" data-minus="true" data-callback="bt.calMoney">
						</td>
						<td></td>
						<td></td>
                        <td></td>
					</tr>
					#end
	    		#end
		   
		    </tbody>
		</table>

		<table id="aTable" class="layui-table layui-form layui-table-border" style="width:100%;">
			<thead>
			<tr>
				<th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
				<th>#springMessage('table.ratBkrationDetail.itemCode')</th>
                <th>#springMessage('table.ratBkrationDetail.creditType')</th>##授信方式
				<th>#springMessage('table.ratBkrationAddDetail.oriMoney')</th>
				<th>#springMessage('table.ratBkrationDis.leftMoney')</th>
				<th>#springMessage('table.ratBkrationAddDetail.money')</th>
				<th>#springMessage('table.ratBkrationDis.leftMaxMoney')</th>
				<th>#springMessage('table.ratBkrationAddDetail.maxMoney')</th>
                <th>#springMessage('common.table.thead.operation')</th>
			</tr>
			</thead>
			<tbody class="aaa">
			##综合授信
				#foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
					#set($vcount = $velocityCount - 1)
					<tr class="compRat">
						#if($!{vcount} == "0")
							<td rowspan="$!{ratBkrationPage.compItemSize}" align="center" id="compRow" class="change_rowspan">
								$dictTag.get("RatModel.ItemFlag", "1")
                                <input class="isComp" value="1" type="hidden">
							</td>
						#end
						<td align="center">
							<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemFlag" id="itemFlag$!{rationDtl.itemOrder}" value="$!{rationDtl.itemFlag}">
							<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemCode" value="$!{rationDtl.itemCode}" class="default_itemCode">
							<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemOrder" value="$!{rationDtl.itemOrder}">
                            <input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].creditType" value="$!{rationDtl.creditType}">
							<input type="hidden" id="interestrate$!{rationDtl.itemOrder}" value="$!{rationDtl.interestrate}">
							$!{rationDtl.itemName}
						</td>
                        <td align="center">
							$dictTag.get("rat.creditType", $!{rationDtl.creditType})
                        </td>
						#if($!{vcount} == "0")
							<td rowspan="$!{ratBkrationPage.compItemSize}" align="right" class="change_rowspan">
								$number.formatNumeric($!{rationDtl.money})
							</td>
							<td rowspan="$!{ratBkrationPage.compItemSize}" align="right" class="change_rowspan">
								$number.formatNumeric($!{rationDtl.leftMoney})
                                <input type="hidden" id="leftMoney" value="$!{rationDtl.leftMoney}" >
							</td>
							<td rowspan="$!{ratBkrationPage.compItemSize}" align="right" class="change_rowspan">
								<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].money" id="$!{rationDtl.itemOrder}money" data-biz-name="$!{rationDtl.itemOrder}money"
									   class="layui-input bt-biz-moneyType" data-min="-$!{rationDtl.leftMoney}" value="0" data-decimal="2" data-minus="true" data-callback="bt.calMoney">
							</td>
						#end
						<td align="right">
                            <input type="hidden" id="leftMaxMoney" value="$!{rationDtl.leftMaxMoney}">
                            <input type="hidden" class="$!{rationDtl.itemOrder}remainMoney" value="$!{rationDtl.leftMaxMoney}">
							$number.formatNumeric($!{rationDtl.leftMaxMoney})
						</td>
						<td align="right">
							<input type="text" data-name="rationDtls[$!{rationDtl.itemOrder}].maxMoney" data-id="$!{rationDtl.itemOrder}maxMoney" rowindex="$!{rationDtl.itemOrder}" data-biz-name="$!{rationDtl.itemOrder}maxMoney"
								   class="layui-input bt-biz-moneyType" data-min="-$!{rationDtl.leftMaxMoney}" value="0" data-decimal="2" data-minus="true" data-callback="bt.calMaxMoney">
						</td>
                        <td></td>
					</tr>
				#end
			</tbody>
		    <tfoot>
			    <tr>
	 				<td align="center">#springMessage('table.ratBkrationAdd.sumMoney')</td>
	 				<td></td>
                    <td></td>
	 				<td></td>
	 				<td></td>
	 				<td align="right">
		 				<input type="text" data-name="moneysum" data-biz-name="moneysum" readonly="readonly" data-decimal="2" value="0"
							autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.ratBkrationDis.money')">
	 				</td>
	 				<td></td>
	 				<td></td>
                    <td></td>
				</tr>
			</tfoot>
		</table>
		
		<table class="layui-table" style="width:100%;">
			#if(${dto.itemNo})
			<thead>
                <tr style="text-align:center;">
                    <td>#springMessage('table.fcBond.bondAcc')</td>
					<td>#springMessage('table.fcBond.accountname')</td>
					<td>#springMessage('table.fcBondBack.bankName')</td>
					<td>#springMessage('table.fcBond.bondmoney')</td>
					<td>#springMessage('table.fcBond.addBondMoney')</td>
				</tr>
			</thead>
			#end
			<tbody>
				#if(${dto.itemNo})
                <tr style="text-align:center;">
					<td>$!{dto.bankAcc}</td>
					<td>$!{dto.accName}</td>
					<td>$!{dto.bankName}</td>
					##<td style="text-align:right">$number.formatNumeric($!{dto.applyMoney})</td>
					<td style="text-align:right">$number.formatNumeric($!{dto.applyMoneyTotal})</td>
					<td align="right;">
						 <div class="layui-input-inline">
                           <input type="text" id="bondAddMoney" name="bondAddMoney"  data-decimal="2"  class="layui-input bt-biz-moneyType" data-biz-name="bondAddMoney"
							data-min="-$!{dto.applyMoneyTotal}" data-minus="true"  data-callback="bt.checkBondMoney" >
                     </div>
					 <input type="hidden" id="accAvailMoney" name="accAvailMoney" value="$!{dto.availMoney}"/>
					</td>
				</tr>
				#end
            <tr>
                <td class="textRight">#springMessage('table.ratBkration.attach')</td>
                <td style="text-align: center;">
                    <!-- 附件上传 -->
                    <input id="annexName" name="attachmentId" type="hidden" value="">
                    <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                </td>
            </tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratBkrationAdd.add.js?_btv=${resourceVersion}"></script>
</html>
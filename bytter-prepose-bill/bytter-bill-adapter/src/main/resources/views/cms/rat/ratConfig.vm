<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>

<form class="layui-form" action="">

<table class="layui-table">
        <thead>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
			<td width="80%">#springMessage('config.fbs.paramValue')</td>
		</tr>
        </thead>
		<tbody>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.rat.ratContains')</td>
            <td width="80%">
            	<div class="layui-input-inline">
            		<input type="radio" name="rat.ratContains" value="0" #if($config.rat.ratContains == 0)checked#end title="#springMessage('nis.sc_yn.no')">
             		<input type="radio" name="rat.ratContains" value="1" #if($config.rat.ratContains == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
				</div>
			</td>
        </tr>
        ##是否挂担保
        <tr>
            <td class="textRight">#springMessage('config.rat.mountGuarantee')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="radio" name="rat.mountGuarantee" value="0"
                           #if($config.rat.mountGuarantee == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                    <input type="radio" name="rat.mountGuarantee" value="1"
                           #if($config.rat.mountGuarantee == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('config.rat.ratctrModel')</td>
            <td>
            <div class="layui-input-inline">
	        	<input type="radio" name="rat.ratctrModel" value="0" #if($config.rat.ratctrModel == 0)checked#end title="#springMessage('rat.ratctrModel.corp')">
            	<input type="radio" name="rat.ratctrModel" value="1" #if($config.rat.ratctrModel == 1)checked#end title="#springMessage('rat.ratctrModel.perme')">
			</div>
			</td>
        </tr>
        <tr>
            <td class="textRight">授信银行控制</td> ##授信银行控制
            <td>
                <div class="layui-input-inline">
                    <input type="radio" name="rat.bankControlType" value="0" #if($config.rat.bankControlType == 0)checked#end title="银行行号相同">
                    <input type="radio" name="rat.bankControlType" value="1" #if($config.rat.bankControlType == 1)checked#end title="银行类别相同">
                </div>
            </td>
        </tr>
        <tr>
             <td class="textRight">#springMessage('table.urationapply.isOpenRat')</td> ##是否启用银行授信敞口
             <td> 
                <div class="layui-input-inline"> 
                    <input type="radio" name="rat.isStartRatExposure" value="0" #if($config.rat.isStartRatExposure == 0)checked#end title="#springMessage('common.sc_yn.no')">
                    <input type="radio" name="rat.isStartRatExposure" value="1" #if($config.rat.isStartRatExposure == 1)checked#end title="#springMessage('common.sc_yn.yes')">
                </div> 
            </td> 
         </tr> 

		<tr>
            <td class="textRight">#springMessage('config.rat.notifyDays')</td>
            <td>
	            <div class="layui-input-inline">
		        	<input type="text" name="rat.notifyDays" class="layui-input" value="$!{config.rat.notifyDays}"
                           onkeyup="this.value=this.value.replace(/[^0-9,]/g, '')" title="#springMessage('config.rat.notifyDays')">
				</div>
				<span style="font-size: 12px; color: red">#springMessage('config.rat.notifyDaysRmk')</span>
			</td>
        </tr>
        ##授信合同必须控制
        <tr>
            <td class="textRight">#springMessage('cms.config.creditContract.control')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="radio" name="rat.creditContractControl" value="0" #if(($config.rat.creditContractControl == 0) || (!$config.rat.creditContractControl))checked#end title="不控制">
                    <input type="radio" name="rat.creditContractControl" value="1" #if($config.rat.creditContractControl == 1)checked#end title="提醒不控制">
                    <input type="radio" name="rat.creditContractControl" value="2" #if($config.rat.creditContractControl == 2)checked#end title="控制">
                </div>
            </td>
        </tr>
        ##是否对接合同管理
        <tr>
            <td class="textRight">#springMessage('cms.config.isRelate.con')</td>
            <input type="hidden" id="relateCon" value="$!{config.rat.relateCon}">
            <td>
                <input title="#springMessage("common.sc_yn.no")" name="rat.relateCon" value="0" lay-filter="relateCon"
                       #if($config.rat.relateCon == 0)checked#end CHECKED="" type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("common.sc_yn.no")</span>##否
                </div>

                <input title="#springMessage("common.sc_yn.yes")" name="rat.relateCon" value="1" lay-filter="relateCon"
                       #if($config.rat.relateCon == 1)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("common.sc_yn.yes")</span>##是
                </div>
            </td>
        </tr>
        ##对接合同管理模式
        <tr id="conTypeIsShow">
            <td class="textRight">#springMessage('cms.config.relate.con.type')</td>
            <td>
                <input title="#springMessage("cms.config.gua.createCon")" name="rat.conType" value="0" class="conType"
                       #if($config.rat.conType == 0)checked#end CHECKED="" type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("cms.config.gua.createCon")</span>##授信生成合同
                </div>

                <input title="#springMessage("cms.config.gua.relateCon")" name="rat.conType" value="1" class="conType"
                       #if($config.rat.conType== 1)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("cms.config.gua.relateCon")</span>##授信调用合同
                </div>
            </td>
        </tr>

        <tr>
        	<td colspan="6" style="text-align: center;">
        		<button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        	</td>
		<tr>
 	</tbody>
 </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form','jquery','moneyType'], function(){
        var form = bt.form(),$  = bt.jquery;
        bt.moneyType.init();

        var relateCon=$("#relateCon").val();
        if (relateCon == "1") {
            $(".conType").removeAttr("disabled", false);
        } else {
            $(".conType").attr("disabled", true);
        }
        form.render();
        //监听提交
        form.on('submit(configSubmit)', function(data){
            bt.loading.show();
            $.post(basePath + "/sys/config/save",data.field,function(result){
                bt.loading.hide();
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },"JSON");
            return false;
        });

        form.on('radio(relateCon)', function(data){
            if (data.value == "1") {
                $(".conType").removeAttr("disabled", false);
            } else {
                $(".conType").attr("disabled", true);
            }
            form.render();
        });
    });
</script>
</body>
</html>
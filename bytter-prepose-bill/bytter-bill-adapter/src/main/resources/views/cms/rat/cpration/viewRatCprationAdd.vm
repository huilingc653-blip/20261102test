<!DOCTYPE html> 
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <table class="layui-table">
        	<tbody>
        	<tr>
        		##资金中心
				<td width="20%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="30%">
					$!{ratCprationPage.corpName}
				</td>
				##授信编号
				<td width="20%" class="textRight">#springMessage('table.ratBkration.ratCode')</td>
				<td width="30%">
                	$!{ratCprationPage.ratCode}
				</td>
			</tr>
        	<tr>
				##授信合同号
				<td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td>
                	$!{ratCprationPage.contractNo}
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratCprationPage.curName}
				</td>
			</tr>
        	<tr>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.endDate)
				</td>
			</tr>
        	<tr>
        		##授信额度
				<td class="textRight">#springMessage('table.ratBkration.money')</td>
				<td >
					$number.formatNumeric($!{ratCprationPage.money})
				</td>
        		##授信敞口额度
				<td class="textRight"></td>
				<td >
				</td>
			</tr>
			</tbody>
		</table>
		
		<table id="singleTable" class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		        <th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th>#springMessage('table.ratBkrationDetail.itemCode')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.oriMoney')</th>
		        <th>#springMessage('table.ratBkrationAddDetail.money')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($rationDtl in $!{ratCprationPage.singRationDtls})
	    		<tr>
    				<td align="center">
	    				$dictTag.get("RatModel.ItemFlag", "0")
    				</td>
	    			<td align="center">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemFlag" id="itemFlag$!{rationDtl.itemOrder}" value="$!{rationDtl.itemFlag}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemCode" value="$!{rationDtl.itemCode}">
	    				<input type="hidden" name="rationDtls[$!{rationDtl.itemOrder}].itemOrder" value="$!{rationDtl.itemOrder}">
	    				<input type="hidden" id="assurepercent$!{rationDtl.itemOrder}" value="$!{rationDtl.assurepercent}">
	    				$!{rationDtl.itemName}
					</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.money})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.addMoney})
    				</td>
	    		</tr>
	    		#end
		    </tbody>
		    <tfoot>
			    <tr>
	 				<td align="center">#springMessage('table.ratBkrationAdd.sumMoney')</td>
	 				<td></td>
	 				<td></td>
	 				<td align="right">
	 					$number.formatNumeric($!{ratCprationPage.addMoney})
	 				</td>
				</tr>
			</tfoot>
		</table>
		#if($!{viewFlag} == "1")
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button type="button" onclick="closeTab()" class="layui-btn">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
        #end
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
bt.use(['form','layedit'], function(){
	var $ = bt.jquery,form = bt.form();
    //监听提交
});

var closeTab =  function(){
	if(!bt.navtab){
        parent.layer?parent.layer.closeAll():layer.closeAll();
    } else {
    	//bt.navtab.refreshParent();
    	bt.navtab.closeCurrent();
    }
	return false;
};

</script>
</html>
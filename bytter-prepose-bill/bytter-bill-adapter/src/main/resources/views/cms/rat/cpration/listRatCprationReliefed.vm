<!DOCTYPE html> 
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
    <input type="hidden" id="ratCode" name="ratCode" value="${addVO.id}">
    <input type="hidden" id="corpId" name="corpId" value="${addVO.corpId}">
    <input type="hidden" id="total" value="${model.total}">
	<input type="hidden" id="curr" value="${model.curr}">
    </form>
<table border="0" width="100%">
    <tr align="center">
		<td colspan="11" align="center">
			#if($shiro.hasPermission("cms:cprat:relief:apply"))
			<button type="button" class="layui-btn" onclick="add()">#springMessage('ration.bkrationrelief.add')</button>
			#end
			<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
		</td>
	</tr>
</table> 
<div>   
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.ratBkrationRelief.refCode')</th>
        <th>#springMessage('table.ratBkration.corpId')</th>
        <th>#springMessage('table.ratBkration.curCode')</th>
        <th>#springMessage('table.ratBkrationRelief.reliefCorp')</th>
        <th>#springMessage('table.ratBkrationRelief.reliefItemCode')</th>
        <th>#springMessage('table.ratBkrationRelief.byReliefCorp')</th>
        <th>#springMessage('table.ratBkrationRelief.byReliefItemCode')</th>
        <th>#springMessage('table.ratBkrationRelief.money')</th>
        <th>#springMessage('table.ratBkration.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
</div>
    <div id="page" style="position:fixed ; bottom:0px;width:100%;" ></div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/cpration/ratCprationReliefed.list.js?_btv=${resourceVersion}"></script>
</html>
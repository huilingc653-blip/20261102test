<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        /*#singleTable1 td input:not(.bt-biz-ratioType) {*/
        /*width: 100%!important;*/
        /*}*/

        .cks {
            width: 270px;
        }

        .layui-form-radio {
            float: none;
        }

    </style>
</head>
<body>
<form class="layui-form" method="post">
    <input id="disCode" name="disCode" type="hidden" value="$!{ratBkrationPage.disCode}">
    <input id="ratCode" name="ratCode" type="hidden" value="$!{ratBkrationPage.id}">
    <input id="curCode" name="curCode" type="hidden" value="$!{ratBkrationPage.curCode}">
    <input type="hidden" id="ratType" name="ratType" value="0">
    <input type="hidden" id="itemSize" name="itemSize" value="$!{ratBkrationPage.itemSize}">
    <input type="hidden" id="singItemSize" name="singItemSize" value="$!{ratBkrationPage.singItemSize}">
    <input type="hidden" id="compItemSize" name="compItemSize" value="$!{ratBkrationPage.compItemSize}">
    <input type="hidden" id="corpId" name="corpId" value="$!{ratBkrationPage.corpId}">
    <input type="hidden" id="beginDate" name="beginDate" value="$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)">
    <input type="hidden" id="endDate" name="endDate" value="$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)">
    <input type="hidden" id="isOpenRat" value="$!{isOpenRat}">
    <input type="hidden" id="curExrate" value="$!{curExrate}">
    <input type="hidden" id="isGuarantee" value="$!{isGuarantee}">
    <input type="hidden" id="isHangGuarantee" value="$!{isHangGuarantee}">
    <input type="hidden" id="guaWay" name="guaWay" value="$!{guaWay}">
    <input type="hidden" id="guaWayNames" value="$!{guaWayNames}">
    <input type="hidden" id="allGuaWayCode" value="$!{allGuaWayCode}">

    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            ##资金中心
            <td width="20%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
            <td width="30%">
                $!{ratBkrationPage.ratCorpName}
            </td>
            ##授信编号
            <td width="20%" class="textRight">#springMessage('table.ratBkration.bankCode')</td>
            <td width="30%">
                $!{ratBkrationPage.bankName}
            </td>
        </tr>
        <tr>
            ##授信合同号
            <td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
            <td>
                $!{ratBkrationPage.contractNo}
            </td>
            ##授信币种
            <td class="textRight">#springMessage('table.ratBkration.curCode')</td>
            <td>
                $!{ratBkrationPage.curName}
            </td>
        </tr>
        <tr>
            ##授信开始时间
            <td class="textRight">#springMessage('table.ratBkration.begindate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
            </td>
            ##授信结束时间
            <td class="textRight">#springMessage('table.ratBkration.enddate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
            </td>
        </tr>
        <tr>
            ##额度使用单位
            <td class="textRight">#springMessage('table.ratUrationApply.corpId')</td>
            <td colspan="3">
                $!{ratBkrationPage.corpName}
            </td>
            ##        ##担保方式
            ##            <td  class="textRight">#springMessage('table.guaContract.guaType')</td>
            ##            <td>
            ##                $!{guaWayNames}
            ##            </td>
        </tr>
        </tbody>
    </table>

    <table class="layui-table layui-form layui-table-border" style="width:100%;">
        <thead>
        <tr>
            <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
            <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
            <th width='200px'>#springMessage('table.ratBkrationDetail.creditType')</th>##授信方式
            <th width='180px'>#springMessage('table.ratBkrationDetail.money')</th>
            <th width='180px'>#springMessage('table.ratBkrationDisDetail.overPlusMoney')</th>
            <th width='180px'>#springMessage('table.ratBkrationDetail.maxMoney')</th>
            <th width='180px'>#springMessage('table.ratBkration.CanUseMaxMoney')</th>
        </tr>
        </thead>
        <tbody>
            #foreach($rationDtl in $!{ratBkrationPage.singRationDtls})
            <tr>
                <td align="center">
                    $dictTag.get("RatModel.ItemFlag", "0")
                </td>
                <td align="center">
                    $!{rationDtl.itemName}
                </td>
                <td align="center">
                    $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                </td>
                <td align="right">
                    $number.formatNumeric($!{rationDtl.money})
                </td>
                <td align="right">
                    $number.formatNumeric($!{rationDtl.allDisMoney})
                </td>
                <td></td>
                <td></td>
            </tr>
            #end
            ##综合授信
            #foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
                #set($vcount = $velocityCount - 1)
            <tr>
                #if($!{vcount} == "0")
                    <td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
                        $dictTag.get("RatModel.ItemFlag", "1")
                    </td>
                #end
                <td align="center">
                    $!{rationDtl.itemName}
                </td>
                <td align="center">
                    $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                </td>
                #if($!{vcount} == "0")
                    <td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
                        $number.formatNumeric($!{rationDtl.money})
                    </td>
                    <td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
                        $number.formatNumeric($!{rationDtl.allDisMoney})
                    </td>
                #end
                <td align="right">
                    $number.formatNumeric($!{rationDtl.maxMoney})
                </td>
                <td align="right">
                    $number.formatNumeric($!{rationDtl.allDisMaxMoney})
                </td>
            </tr>
            #end
        <tr>
            <td class="textRight">#springMessage('table.ratBkration.attach')</td>
            <td style="text-align: center;" colspan="6">
                <!-- 附件上传 -->
                <input id="annexName" name="attachmentId" type="hidden" value="">
                <div id="uploader" class="layui-input-inline" style="width:100%"></div>
            </td>
        </tr>
        </tbody>
    </table>
    <div class="ignore-required-icon isDown">
        <table id="singleTable1" class="layui-form layui-table-border" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('table.ratUrationApply.Order')</th>
                ##占用授信品种
                <th><font color="red">*</font>#springMessage('table.ratUrationApply.itemCode')</th>
                ##授信类型
                <th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
                <th>#springMessage('cms.business.race')</th>##业务品种
                #if($!{isOpenRat} == "1")
                    ##基础参数设置启用敞口
                    <th><font color="red">*</font>#springMessage('table.urationapply.isOpenRat')</th>##是否启用授信敞口
                #else
                    ##是否启用授信敞口
                    <th style="display: none"><font color="red">*</font>#springMessage('table.urationapply.isOpenRat')</th>
                #end
                <th><font color="red">*</font>#springMessage('table.urationapply.billCurId')</th>##业务币种
                <th><font color="red">*</font>#springMessage('table.urationapply.billMoney')</th>##业务金额
                <th><font color="red">*</font>#springMessage('table.urationapply.bondCurId')</th>##保证金币种
                <th>#springMessage('table.urationapply.bondPercent')</th> ##保证金比例
                <th>#springMessage('table.urationapply.bondMoney')</th>##保证金金额
                <th><font color="red">*</font>#springMessage('table.ratUrationApply.money')</th>
                #if($!{isGuarantee} == "1")##系统基础参数设置挂接担保
                    <th><font color="red">*</font>#springMessage('table.guaContract.guaType')</th>##担保方式
                #else
                    <th style="display: none"><font color="red">*</font>#springMessage('table.guaContract.guaType')</th>##担保方式
                #end
                <th><font color="red">*</font>#springMessage('table.ratUrationApply.beginDate')</th>
                <th><font color="red">*</font>#springMessage('table.ratUrationApply.endDate')</th>
                <th><font color="red">*</font>#springMessage('table.ratUrationApply.days')</th>
                <th><font color="red">*</font>#springMessage('table.ratUrationApply.contactNo')</th>
                <th>#springMessage('table.ratUrationApply.lcNo')</th>
                <th>#springMessage('table.ratUrationApply.billNo')</th>
                <th>#springMessage('table.ratBkration.remark')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
    <table class="layui-table layui-table-border" style="margin-top: 10px;">
        <tbody>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button type="button" class="layui-btn" onclick="importExcel()">#springMessage(
                    'common.button.imports')</button>
                <button type="button" class="layui-btn" lay-filter="add" id="add">#springMessage(
                    'common.button.add')</button>##common.addTr
                <button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="button" onclick="resetTab()" class="layui-btn layui-btn-primary">#springMessage(
                    'common.button.reset')</button>
                <button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage(
                    'common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationApply.add.js?_btv=${resourceVersion}"></script>
</html>

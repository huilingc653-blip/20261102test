<!DOCTYPE html>
<html lang="en">
<head>  
    #parse("views/common/head.vm")
    <style>
        #singleTable td input {
            width: 100%!important;
        }
    </style>
</head>
<body>
	<form class="layui-form" method="post">
			<input id="disCode" name="disCode" type="hidden" value="$!{ratCprationPage.disCode}">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{ratCprationPage.id}">
			<input id="curCode" name="curCode" type="hidden" value="$!{ratCprationPage.curCode}">
			<input type="hidden" id="ratType" name="ratType" value="1">
			<input type="hidden" id="itemSize" name="itemSize" value="$!{ratCprationPage.itemSize}">
			<input type="hidden" id="corpId" name="corpId" value="$!{ratCprationPage.corpId}">
			<input type="hidden" id="beginDate" name="beginDate" value="$!date.format('yyyy-MM-dd',$!ratCprationPage.beginDate)">
			<input type="hidden" id="endDate" name="endDate" value="$!date.format('yyyy-MM-dd',$!ratCprationPage.endDate)">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="20%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="30%">
					$!{ratCprationPage.ratCorpName}
				</td>
				##授信编号
				<td width="20%" class="textRight">#springMessage('table.ratBkration.ratCode')</td>
				<td width="30%">
                	$!{ratCprationPage.ratCode}
				</td>
			</tr>
        	<tr>
				##授信合同号
				<td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td>
                	$!{ratCprationPage.contractNo}
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratCprationPage.curName}
				</td>
			</tr>
        	<tr>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratCprationPage.endDate)
				</td>
			</tr>
        	<tr>
        		##额度使用单位
				<td class="textRight">#springMessage('table.ratUrationApply.corpId')</td>
				<td colspan="3">
					$!{ratCprationPage.CorpName}
				</td>
			</tr>
			</tbody>
		</table>
		
		<table class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		        <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.money')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($rationDtl in $!{ratCprationPage.rationDtls})
	    		<tr>
    				<td align="center">
	    				$dictTag.get("RatModel.ItemFlag", "0")
    				</td>
	    			<td align="center">
	    				$!{rationDtl.itemName}
					</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.money})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.leftMoney})
    				</td>
	    		</tr>
	    		#end
		    </tbody>
		</table>
		
		<table id="singleTable" class="layui-table layui-form" style="width:100%;overflow:scroll;">
			<thead>
		    <tr>
		    ##系统品种
		        <th><font color="red">*</font>#springMessage('table.ratUrationApply.type')</th>
		        <th><font color="red">*</font>#springMessage('table.ratUrationApply.itemCode')</th>
		        <th><font color="red">*</font>#springMessage('table.ratUrationApply.beginDate')</th>
		        <th><font color="red">*</font>#springMessage('table.ratUrationApply.endDate')</th>
		        <th><font color="red">*</font>#springMessage('table.ratUrationApply.days')</th>
		        <th><font color="red">*</font>#springMessage('table.ratUrationApply.money')</th>
		        <th><font color="red">*</font>#springMessage('table.ratUrationApply.contactNo')</th>
		        <th>#springMessage('table.ratUrationApply.lcNo')</th>
		        <th>#springMessage('table.ratUrationApply.billNo')</th>
		        ##<th>#springMessage('table.ratBkration.remark')</th>
		        <th>#springMessage('common.table.thead.operation')</th>
		    </tr>
		    </thead>
		    <tbody>
		    </tbody>
		</table>
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button type="button" class="layui-btn" lay-filter="add" id="add">#springMessage('common.addTr')</button>
					<button class="layui-btn" lay-submit="" id="temp">#springMessage('common.button.temp')</button>
					<button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/cpration/ratCprationApply.add.js?_btv=${resourceVersion}"></script>
</html>
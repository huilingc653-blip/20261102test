<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<table class="layui-table">
    	<tbody>
        	<tr>
            	##授信占用单位
                <td class="textRight">#springMessage('table.ratUrationApply.corpId')</td>
                <td class="rCode">
                    <div class="layui-input-inline">
           			<div class="bt-biz-corp"
                        data-biz-type="corp"
                        data-type="selectTree"
                        data-name="eqs_corpId"
                        data-biz-name="corpId"
                        data-bizName="corpId"
                        data-resource="cms:rat:change:apply"
                        data-defaultvalue="$!{corpId}"
                        data-scope="all"></div>
                   </div>
                </td>
                ##系统授信品种
                <td class="textRight">#springMessage('table.ratItemCustom.sysItemCode')</td>
                <td class="rCode">
                    <div class="layui-input-inline">
	                    <div class="bt-biz-selectType" data-name="eqs_type" data-method="post" data-url="${basePath}/cms/rat/ratitemcustom/sysItemJson?type=0"
							data-valuefield="code" data-textfield="name" data-biz-name="type" data-search="false" >
						</div>
                    </div>
                </td>
                ##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					<div class="layui-inline">
					<div class="bt-biz-selectType" data-biz-name="curCode" data-url="${basePath}/basic/business/btcurrency/json"
						data-valuefield="id" data-textfield="curName" data-required="false"
						data-name="eqs_curCode" data-search="true" data-value="$!{paramDTO.curCode}"></div>
					</div>
				</td>
            </tr>
            <tr>
                   ##估计授信时间
                   <td class="textRight" hidden>#springMessage('table.ratUration.applyDate')</td>
                   <td width="40%" hidden>
                   	<div class="layui-inline layui-input-inline">
##                  		<input type="text" name="beginDate" id="beginDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="endDate"
##                   		data-type="date" data-biz-name="beginDate" value="$!date.format('yyyy-MM-dd',$!paramDTO.beginDate)">
                        <input type="text" data-name="beginDate" id="beginDate" class="layui-input bt-biz-dateType"
                               data-type="date" data-biz-name="beginDate" value="$!{beginDate}">
                   	</div>
            	</td>
                ##                -------------------------------------------------------------------------
                ## 授信开始时间
                <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.begindate')</td>
                <td style="width: 23%" class="rCode">
                    <div class="layui-inline">
                        <input type="text" name="ged_beginDate" id="gBeginDate" data-name="gBeginDate" class="layui-input bt-biz-dateType"
                               data-type="date"  value="$!{paramDTO.gBeginDate}">
                    </div>
                    <div class="layui-inline">
                        <span class="date-mid">~</span>
                    </div>
                    <div class="layui-inline">
                        <input type="text" data-name="lBeginDate" name="led_beginDate" id="lBeginDate" class="layui-input bt-biz-dateType"
                               data-type="date" data-biz-name="lBeginDate" value="$!{paramDTO.lBeginDate}">
                    </div>
                </td>

                ## 授信结束时间
                <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.enddate')</td>
                <td class="rCode">
                    <div class="layui-inline">
                        <input data-name="gEndDate" name="ged_endDate" id="gEndDate" data-biz-name="gEndDate" value="$!{paramDTO.gEndDate}" data-type="date"
                               class="layui-input bt-biz-dateType" type="text">
                    </div>
                    <div class="layui-inline">
                        <span class="date-mid">~</span>
                    </div>
                    <div class="layui-inline">
                        <input data-name="lEndDate" name="led_endDate" id="lEndDate" data-biz-name="lEndDate" value="$!{paramDTO.lEndDate}" data-type="date"
                               class="layui-input bt-biz-dateType" type="text">
                    </div>
                </td>

                ##授信编号
                <td class="textRight">#springMessage('table.ratBkration.ratCode')</td>
                <td >
                    <div class="layui-input-inline">
                        <input type="text" name="likes_ratCode" id="ratCode" value="$!{paramDTO.ratCode}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkration.ratCode')">
                    </div>
                </td>
            </tr>
            <tr>
                ##银行
                <td class="textRight" width="12%">#springMessage('table.ratBkration.bankCode')</td>
                <td width="20%">
                    <div class="layui-inline">
                        <div class="bt-biz-selectType" data-biz-name="eqs_bankCode" data-url="${basePath}/cms/rat/raturation/getRationBank"
                             data-valuefield="bankCode" data-textfield="bankName" data-required="false"
                             data-name="eqs_bankCode" data-search="true" data-value="$!{paramDTO.bankCode}"></div>
                    </div>
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>

            <tr>
            	<td colspan="6" style="text-align: center;">
                    <button type="button" class="layui-btn" onclick="closeRation()">#springMessage('common.ration.close')</button>
                    <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </tbody>
    </table>
<div class="layui-form-item" id="test1" style="padding: 10px;display: none;">
    <div style="padding:0px 0 0px 40px" class="layui-clear">
        <div class="bt-biz-dict" data-type="radio" data-group="Ration.changeType" data-defaultvalue="1"
                            data-name="changeType" data-biz-name="changeType" ></div>
    </div>
    <div style="margin-top: 10px;text-align: center">
        <button type="button" class="layui-btn" onclick="submitRation()">#springMessage('common.button.confirm')</button>
        <button type="button" class="layui-btn" onclick="cancelRation()">#springMessage('common.button.cancel')</button>
    </div>
</div>
</form>
<div>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.ratUration.urationCode')</th>
        <th>#springMessage('table.ratUrationApply.corpId')</th>
        <th>#springMessage('table.ratBkration.bankCode')</th>
        <th>#springMessage('table.ratItemCustom.sysItemCode')</th>
        <th>#springMessage('table.ratUrationApply.itemCode')</th>
        <th>#springMessage('cms.business.race')</th>##业务品种
        <th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>##授信类型
        <th>#springMessage('table.ratBkration.curCode')</th>
        <th>#springMessage('table.ratUrationApply.money')</th>
        <th>#springMessage('table.ratUrationApply.beginDate')</th>
        <th>#springMessage('table.ratUrationApply.endDate')</th>
        <th>#springMessage('table.ratUration.billNo')</th>
        <th>#springMessage('table.ratBkration.ratCode')</th>
        <th>#springMessage('table.ratBkration.status')</th>
    </tr>
    </thead>
</table>
</div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUration.list.js?_btv=${resourceVersion}"></script>
</html>

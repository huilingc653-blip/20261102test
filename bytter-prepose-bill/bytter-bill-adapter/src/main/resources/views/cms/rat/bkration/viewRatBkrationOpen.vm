<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{ratBkrationPage.id}">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{ratBkrationPage.ratCode}">
			<input type="hidden" id="ratType" name="ratType" value="0">
			<input type="hidden" id="copmRatSize" name="copmRatSize" value="$!{copmRatSize}">
			<input type="hidden" id="singItemSize" name="singItemSize" value="$!{singItemSize}">
			<input type="hidden" id="compItemSize" name="compItemSize" value="$!{compItemSize}">
			<input type="hidden" id="itemSize" name="itemSize" value="$!{itemSize}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##授信模式
				<td width="15%" class="textRight">#springMessage('table.ratBkration.ratMode')</td>
				<td width="20%">
					$dictTag.get("RatBkration.RatMode", "$!{ratBkrationPage.ratMode}")
				</td>
        		##单位代码
				<td width="12%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="20%">
					$!{ratBkrationPage.corpName}
				</td>
				##授信合同号
				<td width="13%" class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td width="20%">
                	$!{ratBkrationPage.contractNo}
				</td>
			</tr>
        	<tr>
        		##银行编号
				<td class="textRight">#springMessage('table.ratBkration.bankCode')</td>
				<td colspan="3">
					$!{ratBkrationPage.bankName}
				</td>
				##额度是否包含保证金
				<td class="textRight">#springMessage('table.ratBkration.includeBailmoney')</td>
				<td>
					$dictTag.get("sf_yn", "$!{ratBkrationPage.includeBailmoney}")
				</td>
			</tr>
        	<tr>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratBkrationPage.curName}
				</td>
			</tr>
			</tbody>
		</table>
		<table id="singleTable" class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		        <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.money')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.openMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.maxMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.assurecondition')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.assurepercent')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.interestrate')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($rationDtl in $!{ratBkrationPage.singRationDtls})
	    		<tr>
    				<td align="center">
	    				$dictTag.get("RatModel.ItemFlag", "0")
    				</td>
	    			<td align="center">
	    				$!{rationDtl.itemName}
					</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.money})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.openMoney})
    				</td>
	    			<td>
	    			</td>
	    			<td align="center">
    					$!{rationDtl.assurecondition}
	    			</td>
	    			<td align="center">
    					$number.formatNumeric($!{rationDtl.assurepercent})
	    			</td>
	    			<td align="center">
    					$number.formatDoubleWithSix($!{rationDtl.interestrate})
	    			</td>
	    		</tr>
	    		#end
		   ##综合授信
	    	#foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
	    		#set($vcount = $velocityCount - 1)
	    		<tr>
	    			#if($!{vcount} == "0")
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
	    				$dictTag.get("RatModel.ItemFlag", "1")
    				</td>
	    			#end
	    			<td align="center">
	    				$!{rationDtl.itemName}
					</td>
					#if($!{vcount} == "0")
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					$number.formatNumeric($!{rationDtl.money})
    				</td>
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					$number.formatNumeric($!{rationDtl.openMoney})
    				</td>
	    			#end
	    			<td align="right">
    					$number.formatNumeric($!{rationDtl.maxMoney})
	    			</td>
	    			#if($!{vcount} == "0")
	    			<td align="center" rowspan="$!{ratBkrationPage.compItemSize}">
    					$!{rationDtl.assurecondition}
	    			</td>
	    			<td align="center" rowspan="$!{ratBkrationPage.compItemSize}">
	    			</td>
	    			<td align="center" rowspan="$!{ratBkrationPage.compItemSize}">
    					$number.formatDoubleWithSix($!{rationDtl.interestrate})
	    			</td>
	    			#end
	    		</tr>
	    	#end
		    </tbody>
		    <tfoot>
	    	<tr>
		        <td align="center">#springMessage('table.ratBkration.sumMoney')</td>
		        <td >&nbsp;</td>
		        <td align="right">
		        	$number.formatNumeric($!{ratBkrationPage.money})
				</td>
		        <td align="right">
		        	$number.formatNumeric($!{ratBkrationPage.openMoney})
				</td>
		        <td >&nbsp;</td>
		        <td >&nbsp;</td>
		        <td >&nbsp;</td>
		        <td >&nbsp;</td>
		    </tr>
		    </tfoot>
		</table>
		<table class="layui-table">
			<tbody>
        	<tr style="display: none">
        		##担保类型
				<td class="textRight" width="15%">#springMessage('table.ratBkration.guaType')</td>
				<td colspan="5">
					$dictTag.get("RatBkration.GuaType", "$!{ratBkrationPage.guaType}")
				</td>
			</tr>
			<tr id="guaTr" style="display: none">	
        		##担保单位
				<td class="textRight" width="15%">#springMessage('table.ratBkration.guaCorpId')</td>
				<td width="20%">
                	$!{ratBkrationPage.guaCorpId}
				</td>
        		##担保合同
				<td class="textRight" width="12%">#springMessage('table.ratBkration.guaContract')</td>
				<td width="20%">
                	$!{ratBkrationPage.guaContract}
				</td>
        		##合同号查看
				<td class="textRight" width="13%"></td>
				<td width="20%">
				</td>
			</tr>
			<tr>
        		##备注
				<td class="textRight" width="15%">#springMessage('table.ratBkration.remark')</td>
				<td colspan="6">
                	$!{ratBkrationPage.remark}
				</td>
			</tr>
			#if($!{viewFlag} == "1")
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="close">#springMessage('common.button.close')</button>
				</td>
			</tr>
			#end
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
bt.use(['form','layedit'], function(){
	var $ = bt.jquery,form = bt.form();
    //监听提交
    form.on('submit(close)', function(data){
    	if(!bt.navtab){
            parent.layer?parent.layer.closeAll():layer.closeAll();
        } else {
        	//bt.navtab.refreshParent();
        	bt.navtab.closeCurrent();
        }
    	return false;
    });
});

</script>
</html>
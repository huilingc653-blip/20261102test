<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{delay.id}">
    <input id="ratCode" name="ratCode" type="hidden" value="$!{delay.ratCode}">
    <input type="hidden" id="ratType" name="ratType" value="0">
    <input type="hidden" id="corpId" value="$!{ratBkrationPage.corpId}">
    <input type="hidden" id="curId" value="$!{ratBkrationPage.curId}">
    <input type="hidden" id="beginDate" value="$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)">
    <input type="hidden" id="endDate"  value="$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)">
    <input type="hidden" id="isHangGua"  value="$!{ratBkrationPage.isHangGuarantee}">
    <input type="hidden" id="contractIds" name="guaContract" value="$!{ratBkrationPage.guaContract}"><!-- 挂接担保合同id及合同号-->
    <table class="layui-table">
        <tbody>
        <tr>
		##授信模式
            <td width="15%" class="textRight">#springMessage('table.ratBkration.ratMode')</td>
            <td width="20%">
				$dictTag.get("RatBkration.RatMode", "$!{ratBkrationPage.ratMode}")
            </td>
		##单位代码
            <td width="12%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
            <td width="20%">
				$!{ratBkrationPage.corpName}
            </td>
		##授信合同号
            <td width="13%" class="textRight">#springMessage('table.ratBkration.contractNo')</td>
            <td width="20%">
				$!{ratBkrationPage.contractNo}
            </td>
        </tr>
        <tr>
		##        		##银行类型
		##				<td class="textRight">#springMessage('table.ratBkration.bankType')</td>
		##				<td >
		##					$!{ratBkrationPage.typeName}
		##				</td>
		##银行编号
            <td class="textRight">#springMessage('table.ratBkration.bankCode')</td>
            <td colspan="5">
				$!{ratBkrationPage.bankName}
            </td>
		##额度是否包含保证金
		##				<td class="textRight">#springMessage('table.ratBkration.includeBailmoney')</td>
		##				<td>
		##				$dictTag.get("sf_yn", "$!{ratBkrationPage.includeBailmoney}")
		##				</td>
        </tr>
        <tr>
		##授信开始时间
            <td class="textRight">#springMessage('table.ratBkration.begindate')</td>
            <td >
				$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
            </td>
		##授信结束时间
            <td class="textRight">#springMessage('table.ratBkration.enddate')</td>
            <td >
				$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
            </td>
		##授信币种
            <td class="textRight">#springMessage('table.ratBkration.curCode')</td>
            <td >
				$!{ratBkrationPage.curName}
            </td>
        </tr>
        <tr>
		##备注
            <td class="textRight" width="15%">#springMessage('table.ratBkration.remark')</td>
            <td colspan="5">
				$!{ratBkrationPage.remark}
            </td>
        </tr>
        <tr>
		##授信延期日期
            <td class="textRight">#springMessage('table.ratBkrationDelay.delayDate')</td>
            <td colspan="5">
				#if($!{delaySign} == "1")
					$!date.format('yyyy-MM-dd',$!delayDate)
					#end
            </td>
        </tr>
        </tbody>
    </table>
    <table id="singleTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th width='150px' align="center">#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
            <th width='200px' align="center">#springMessage('table.ratBkrationDetail.itemCode')</th>
            <th width='200px'>#springMessage('table.ratBkrationDetail.creditType')</th>##授信方式
            <th width='180px' align="center">#springMessage('table.ratBkrationDetail.money')</th>
            <th width='180px' align="center">#springMessage('table.ratBkrationDetail.maxMoney')</th>
        </tr>
        </thead>
        <tbody>
			#foreach($rationDtl in $!{ratBkrationPage.singRationDtls})
            <tr>
                <td align="center">
					$dictTag.get("RatModel.ItemFlag", "0")
                </td>
                <td align="center">
					$!{rationDtl.itemName}
                </td>
                <td align="center">
                    $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                </td>
                <td align="right">
					$number.formatNumeric($!{rationDtl.money})
                </td>
                <td>
                </td>
            </tr>
			#end
		##综合授信
			#foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
				#set($vcount = $velocityCount - 1)
            <tr>
				#if($!{vcount} == "0")
                    <td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
						$dictTag.get("RatModel.ItemFlag", "1")
                    </td>
				#end
                <td align="center">
					$!{rationDtl.itemName}
                </td>
                <td align="center">
                    $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                </td>
				#if($!{vcount} == "0")
                    <td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
						$number.formatNumeric($!{rationDtl.money})
                    </td>
				#end
                <td align="right">
					$number.formatNumeric($!{rationDtl.maxMoney})
                </td>
            </tr>
			#end
        <tr>
            <td align="center">#springMessage('table.ratBkration.sumMoney')</td>
            <td >&nbsp;</td>
            <td >&nbsp;</td>
            <td align="right">
				$number.formatNumeric($!{ratBkrationPage.money})
            </td>
            <td >&nbsp;</td>
        </tr>
        <tr>
        ##附件
            <td class="textRight">#springMessage('table.ratBkration.attach')</td>
            <td colspan="4">
                <!-- 附件上传 -->
                <input id="annexNameInfo" name="annexNameInfo" type="hidden"
                       value="$!{attachmentId}">
                <div id="uploaderInfo" class="layui-input-inline" style="width:100%"></div>
            </td>
        </tr>
        </tbody>
    </table>
    <div>
        <!-- 附件上传 -->
        <input id="annexNameInfo" name="annexNameInfo" type="hidden"
               value="$!{attachmentId}">
        <div id="uploaderInfo" class="layui-input-inline" style="width:100%"></div>
    </div>
    #if($!{isGuarantee}=="1")##授信参数设置挂接担保
    ##担保合同信息
        #if(${ratBkrationPage.isHangGuarantee}=="1")
            <h2 class="layui-colla-title">#springMessage('table.guaContract.ContractMsg')</h2>
            #set($guaContractUseDTO=$guaContractTag.getGuaContractOccupyDetail($!{ratBkrationPage.id},$!{ratBkrationPage.ratCode}))
            #if($!{guaContractUseDTO})
                #parse("views/common/guaContractDetail.vm")
            #end
        #end
    #end
	#if($!{viewFlag} == "1")
        <table class="layui-table">
            <tbody>
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button type="button" lay-filter="close"lay-submit=""  class="layui-btn">#springMessage('common.button.close')</button>
                </td>
            </tr>
            </tbody>
        </table>
	#end
</form>
	#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form','layedit','btUpload','jquery'], function(){
        var $ = bt.jquery,form = bt.form();
        var gInfoId = $("#annexNameInfo").val();
        bt.btUpload.init({
            elem: "#uploaderInfo",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gInfoId
        });

        /**判断字符串是否为空*/
        bt.empty = function(ms){
            if(typeof(ms) == "undefined" || ms == null || ms == "" || ms == " "){
                return true;
            }
            return false;
        }

        //监听提交
        form.on('submit(close)', function(data){
            if(!bt.navtab){
                parent.layer?parent.layer.closeAll():layer.closeAll();
            } else {
                //bt.navtab.refreshParent();
                bt.navtab.closeCurrent();
            }
            return false;
        });

    });

</script>
</html>

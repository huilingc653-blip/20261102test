<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{applyDTO.id}">
			<input id="disCode" name="disCode" type="hidden" value="$!{ratBkrationPage.disCode}">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{ratBkrationPage.id}">
			<input id="curCode" name="curCode" type="hidden" value="$!{ratBkrationPage.curCode}">
			<input type="hidden" id="corpId" name="corpId" value="$!{ratBkrationPage.corpId}">
			<input type="hidden" id="ratType" name="ratType" value="0">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="15%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="18%">
					$!{ratBkrationPage.ratCorpName}
				</td>
				##授信编号
				<td width="15%" class="textRight">#springMessage('table.ratBkration.bankCode')</td>
				<td width="18%">
					$!{ratBkrationPage.bankName}
				</td>
				##授信合同号
				<td width="15%" class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td width="19%">
                	$!{ratBkrationPage.contractNo}
				</td>
			</tr>
        	<tr>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td >
					$!{ratBkrationPage.curName}
				</td>
        		##授信开始时间
				<td class="textRight">#springMessage('table.ratBkration.begindate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
				</td>
        		##授信结束时间
				<td class="textRight">#springMessage('table.ratBkration.enddate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
				</td>
			</tr>
			</tbody>
		</table>
		
		<table class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		        <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
		        <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.money')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.openMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDisDetail.leftDisOpenMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.maxMoney')</th>
		        <th width='180px'>#springMessage('table.ratBkrationDetail.leftMaxMoney')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($rationDtl in $!{ratBkrationPage.singRationDtls})
	    		<tr>
    				<td align="center">
	    				$dictTag.get("RatModel.ItemFlag", "0")
    				</td>
	    			<td align="center">
	    				$!{rationDtl.itemName}
					</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.money})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.allDisMoney})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.openMoney})
    				</td>
    				<td align="right">
    					$number.formatNumeric($!{rationDtl.allDisOpenMoney})
    				</td>
	    			<td></td>
	    			<td></td>
	    		</tr>
	    		#end
		   ##综合授信
	    	#foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
	    		#set($vcount = $velocityCount - 1)
	    		<tr>
	    			#if($!{vcount} == "0")
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
	    				$dictTag.get("RatModel.ItemFlag", "1")
    				</td>
	    			#end
	    			<td align="center">
	    				$!{rationDtl.itemName}
					</td>
					#if($!{vcount} == "0")
					<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
						$number.formatNumeric($!{rationDtl.money})
    				</td>
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					$number.formatNumeric($!{rationDtl.allDisMoney})
    				</td>
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					$number.formatNumeric($!{rationDtl.openMoney})
    				</td>
    				<td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
    					$number.formatNumeric($!{rationDtl.allDisOpenMoney})
    				</td>
	    			#end
	    			<td align="right">
	    				$number.formatNumeric($!{rationDtl.maxMoney})
	    			</td>
	    			<td align="right">
    					$number.formatNumeric($!{rationDtl.allDisMaxMoney})
	    			</td>
	    		</tr>
	    	#end
		    </tbody>
		</table>
		<table class="layui-table">
			<tbody>
			<tr>
        		##额度使用单位
				<td class="textRight">#springMessage('table.ratUrationApply.corpId')</td>
				<td >
					$!{ratBkrationPage.corpName}
				</td>
        		##业务名称
				<td class="textRight">#springMessage('table.ratUrationApply.type')</td>
				<td >
					<input type="hidden" name="type" id="type" value="$!{applyDTO.type}">
					$!{applyDTO.typeName}
				</td>
        		##占用授信品种
				<td class="textRight">#springMessage('table.ratUrationApply.itemCode')</td>
				<td >
					<input type="hidden" name="itemFlag" id="itemFlag" value="$!{applyDTO.itemFlag}">
					#if(${applyDTO.itemFlag} == "0")
					<input type="hidden" name="itemCode" id="itemCode" value="$!{applyDTO.singItemCode}">
					$!{applyDTO.singItemName}
					#else
					<table class="layui-table" width="100%" style="margin:0px">
						<tr>
							<th>#springMessage("table.ratBkrationDetail.itemCodeFlag")</th>
							<th>#springMessage("table.ratBkrationDetail.itemCode")</th>
							<th>#springMessage("table.ratUrationApply.money")</th>
						</tr>
						#foreach($applyDtl in $!{applyDTO.applyDtls})
							#set($vcount = $velocityCount - 1)
							<tr>
								#if($!{vcount} == "0")
								<td rowspan="$!{applyDTO.applyDtlSize}">$dictTag.get("RatModel.ItemFlag", "$!{applyDTO.itemFlag}")</td>
								#end
								<td>
									<input type="hidden" name="applyDtls[$!{applyDtl.itemOrder}].itemOrder" id="$!{applyDtl.itemOrder}itemOrder" value="$!{applyDtl.itemOrder}">
									<input type="hidden" name="applyDtls[$!{applyDtl.itemOrder}].itemCode" id="$!{applyDtl.itemOrder}itemCode" 
										itemOrder="$!{applyDtl.itemOrder}" id="itemCode$!{applyDtl.itemOrder}" value="$!{applyDtl.itemCode}">
									$!{applyDtl.itemName}
								</td>
								<td align="right">
									<input type="text" data-name="applyDtls[$!{applyDtl.itemOrder}].maxMoney" data-biz-name="maxMoney$!{applyDtl.itemOrder}" 
									data-id="maxMoney$!{applyDtl.itemOrder}" class="layui-input bt-biz-moneyType" data-decimal="2" data-max="$!{applyDtl.leftMaxMoney}"
									data-minus="false" data-callback="bt.calUMoney" value="$!{applyDtl.maxMoney}">
								</td>
							</tr>
							#end
					</table>
					#end
				</td>
			</tr>
        	<tr>
        		##开始日期
				<td width="15%" class="textRight">#springMessage('table.ratUrationApply.beginDate')</td>
				<td width="18%">
					<input type="text" name="beginDate" id="beginDate" class="layui-input bt-biz-dateType" data-type="date" lay-verify="required"
						data-min="$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)" data-initmax="$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)"
						data-biz-name="beginDate" data-endid="endDate" data-callback="bt.setDays" value="$!date.format('yyyy-MM-dd',$!applyDTO.beginDate)">
				</td>
				##结束日期
				<td width="15%" class="textRight">#springMessage('table.ratUrationApply.endDate')</td>
				<td width="18%">
					<input type="text" name="endDate" id="endDate" class="layui-input bt-biz-dateType" data-type="date" lay-verify="required"
						data-biz-name="endDate" data-callback="bt.setDays" value="$!date.format('yyyy-MM-dd',$!applyDTO.endDate)">
				</td>
				##贷款期限(系统自动计算)
				<td width="15%" class="textRight">#springMessage('table.ratUrationApply.days')</td>
				<td width="19%">
                	<input type="text" class="layui-input" name="days" id="days" readonly="readonly" value="$!{applyDTO.days}" lay-verify="required">
				</td>
			</tr>
			<tr>
        		##保证金比例
				<td class="textRight">#springMessage('table.ratBkrationDetail.assurepercent')</td>
				<td >
					<input type="text" data-name="assurepercent" id="assurepercent" data-biz-name="assurepercent" value="$!{applyDTO.assurepercent}"
						class="layui-input bt-biz-moneyType" data-decimal="2" data-minus="false" data-callback="bt.calMoney">
				</td>
        		##利率
				<td class="textRight">#springMessage('table.ratBkrationDetail.interestrate')</td>
				<td >
					<input type="text" data-name="interestrate" id="interestrate" data-biz-name="interestrate" value="$!{applyDTO.interestrate}"
						class="layui-input bt-biz-moneyType" data-decimal="6" data-minus="false" data-callback="bt.calMoney">
				</td>
        		##合同号
				<td class="textRight">#springMessage('table.ratUrationApply.contactNo')</td>
				<td >
					<input type="text" class="layui-input" name="contactNo" id="contactNo" maxlength="50" value="$!{applyDTO.contactNo}" lay-verify="required">
				</td>
			</tr>
			<tr>
        		##授信占用金额
				<td class="textRight">#springMessage('table.ratUrationApply.money')</td>
				<td >
					#if(${applyDTO.itemFlag} == "0")
					<input type="text" data-name="money" id="money" data-biz-name="money" value="$!{applyDTO.money}" data-max="$!{applyDTO.leftMoney}"
						class="layui-input bt-biz-moneyType" data-decimal="2" data-minus="false" data-callback="bt.calMoney" lay-verify="required">
					#else
					<input type="text" data-name="money" id="money" data-biz-name="money" value="$!{applyDTO.money}" data-max="$!{applyDTO.applyDtls[0].leftMaxMoney}"
						   readonly="readonly" class="layui-input bt-biz-moneyType" data-decimal="2" data-minus="false" data-callback="bt.calMoney" lay-verify="required">
					#end
				</td>
        		##敞口占用金额
				<td class="textRight">#springMessage('table.ratUrationApply.openMoney')</td>
				<td >
					<input type="text" data-name="openMoney" id="openMoney" data-biz-name="openMoney" value="$!{applyDTO.openMoney}"
						class="layui-input bt-biz-moneyType" data-decimal="2" data-minus="false" readonly="readonly" lay-verify="required">
				</td>
        		##信用证号
				<td class="textRight">#springMessage('table.ratUrationApply.lcNo')</td>
				<td >
					<input type="text" class="layui-input" name="lcNo" id="lcNo" maxlength="32" value="$!{applyDTO.lcNo}">
				</td>
			</tr>
			<tr>
        		##票据号码
				<td class="textRight">#springMessage('table.ratUrationApply.billNo')</td>
				<td >
					<input type="text" class="layui-input" name="billNo" id="billNo" maxlength="32" value="$!{applyDTO.billNo}">
				</td>
        		##备注
				<td class="textRight">#springMessage('table.ratBkration.remark')</td>
				<td colspan="3">
					<input type="text" class="layui-input" name="remark" id="remark" maxlength="100" style="width:90%" value="$!{applyDTO.remark}">
				</td>
			</tr>
			</tbody>
		</table>
		
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationApplyOpen.edit.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #page a, #page span {
            height: 30px;
            line-height: 30px;
        }

        #page .layui-laypage-total {
            padding-right: 0px;
        }
    </style>
</head>
<body style="padding-bottom: 40px;">
<form id="searchForm" class="layui-form">
    <input type="hidden" id="curr" value="${model.curr}">
    <input type="hidden" id="pageCount" value="${model.pageCount}">
    <input type="hidden" id="pageSize" value="${model.pageSize}">
    <input type="hidden" id="resultCount" value="${model.resultCount}">
    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            ##授信单位
            <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.corpId')</td>
            <td style="width: 23%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="corpId"
                         data-name="corpId"
                         data-biz-type="corp"
                         data-defaultvalue="$!{corpId}"
                         data-tree-type="check"
                         data-resource="cms:rat:delay:query"
                         data-type="selectTree">
                    </div>
                </div>
            </td>
            ##银行信息
            <td class="textRight">#springMessage('table.ratBkration.bankCode')</td>
            <td width="20%">
                <div class="layui-input-inline" >
                    <div class="bt-biz-mulselectType"
                         data-biz-name="bankCode"
                         data-url="${basePath}/cms/rat/raturation/getBanks"
                         data-value="$!{bankCode}"
                         data-search="true"
                         data-valuefield="bankCode" data-textfield="bankName" data-name="bankCode">
                    </div>
                </div>
            </td>
            ##授信品种
            <td class="textRight">#springMessage('table.ratBkrationDetail.itemCode')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-biz-name="itemCode"
                         data-url="${basePath}/cms/rat/ratitemcustom/getAllRatItem?type=0" data-method="get"
                         data-valuefield="id" data-textfield="name" data-value="$!{itemCode}"
                         data-search="true" data-name="itemCode">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##授信模式
            <td class="textRight">#springMessage('table.ratBkration.ratMode')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType"
                         data-biz-name="ratMode"
                         data-url="${basePath}/sys/dict/listByGroupCode?code=RatBkration.RatMode"
                         data-valuefield="code" data-textfield="name"
                         data-defaultvalue="$!{ratMode}" data-search="true"
                         data-name="ratMode">
                    </div>
                </div>
            </td>
            ##授信合同号
            <td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="contractNo" id="contractNo" value="$!{contractNo}"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratBkration.contractNo')">
                </div>
            </td>
            ##授信编号
            <td class="textRight">#springMessage('table.ratBkration.ratCode')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="ratCode" id="ratCode" value="$!{ratCode}"
                           autocomplete="off" class="layui-input" >
                </div>
            </td>
        </tr>
        <tr>
            ## 授信开始时间
            <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.begindate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-name="gBeginDate" data-biz-name="gBeginDate"
                           data-type="date" value="$!{gBeginDate}" data-endid="lBeginDate">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-name="lBeginDate" data-biz-name="lBeginDate"
                           data-type="date" value="$!{lBeginDate}" id="lBeginDate">
                </div>
            </td>
            ## 授信结束时间
            <td class="textRight" style="width: 10%">#springMessage('table.ratBkration.enddate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-name="gEndDate" data-biz-name="gEndDate"
                           data-type="date" value="$!{gEndDate}" data-endid="lEndDate">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-name="lEndDate" data-biz-name="lEndDate"
                           data-type="date" value="$!{lEndDate}" id="lEndDate">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button type="button" class="layui-btn" lay-submit="" lay-filter="search">#springMessage(
                    'common.button.search')</button>
                <button type="button" class="layui-btn layui-btn-primary" onClick="resetForm()">#springMessage(
                    'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<div>
    <table id="appTable" class="layui-table layui-form layui-table-border" style="width:100%;">
        <button class="layui-btn" type="button" onclick="exports(0)">#springMessage('common.button.exportsCurrentPage')</button>
        <button class="layui-btn" type="button" onclick="exports(1)">#springMessage('common.button.exportsAll')</button>
        <br>
        <thead>
        <tr>
            <th>#springMessage('table.ratBkration.ratMode')</th>
            <th>#springMessage('table.ratBkration.ratCode')</th>
            <th>#springMessage('table.ratBkration.contractNo')</th>
            <th>#springMessage('table.ratBkration.corpId')</th>
            <th>#springMessage('table.ratBkration.bankCode')</th>
            <th>#springMessage('table.ratBkration.curCode')</th>
            <th>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
            <th>#springMessage('table.ratBkrationDetail.itemCode')</th>
            <th>#springMessage('table.ratBkrationDetail.creditType')</th>##授信方式
            <th>#springMessage('table.ratBkration.money')</th>
            <th>#springMessage('table.ratBkration.begindate')</th>
            <th>#springMessage('table.ratBkration.enddate')</th>
            <th>#springMessage('table.ratBkrationDelay.delayDate')</th>
            <th>#springMessage('table.ratBkration.status')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
        <tbody>
            #foreach($ration in $!{model.rations})
            <tr>
                <td align="center" rowspan="$!{ration.itemSize}">$dictTag.get(
                    "RatBkration.RatMode", $!{ration.ratMode})</td>
                <td align="center" rowspan="$!{ration.itemSize}">$!{ration.ratCode}</td>
                <td align="center" rowspan="$!{ration.itemSize}">$!{ration.contractNo}</td>
                <td align="center" rowspan="$!{ration.itemSize}">$!{ration.corpName}</td>
                <td align="center" rowspan="$!{ration.itemSize}">$!{ration.bankName}</td>
                <td align="center" rowspan="$!{ration.itemSize}">$!{ration.curName}</td>
                #foreach($rationDtl in $!{ration.rationDtls})
                    #if(${rationDtl.itemOrder} == 1)
                        #if($!{rationDtl.itemFlag} == "0")
                        <td align="center">
                        #else
                        <td align="center" rowspan="$!{ration.compItemSize}">
                        #end
                        $dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
                    </td>
                        <td align="center">
                            $!{rationDtl.itemName}
                        </td>
                        <td align="center">
                            $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                        </td>
                        #if($!{rationDtl.itemFlag} == "0")
                        <td align="right">
                        #else
                        <td align="right" rowspan="$!{ration.compItemSize}">
                        #end
                        $number.formatNumeric($!{rationDtl.money})
                    </td>
                        <td align="center" rowspan="$!{ration.itemSize}">$!date.format(
                            'yyyy-MM-dd',$!ration.beginDate)</td>
                        <td align="center" rowspan="$!{ration.itemSize}">$!date.format(
                            'yyyy-MM-dd',$!ration.endDate)</td>
                        <td align="center" rowspan="$!{ration.itemSize}">$!date.format(
                            'yyyy-MM-dd',$!ration.delayDate)</td>
                        <td align="center" rowspan="$!{ration.itemSize}">
                            #if($!{ration.delayStatus} == -2)
                                #springMessage("common.ratBkrationDelay.delayStatus")
                            #else
                                $dictTag.get("common.status", $!{ration.delayStatus})
                            #end
                        </td>
                        <td align="center" rowspan="$!{ration.itemSize}">
                            ##操作链接
                            ##<a class="" href="#" onclick="view('$!{ration.id}')">#springMessage("common.button.view")</a>
                            #if($!{ration.delayStatus} == -2)
                                <a class="" href="#" onclick="add('$!{ration.id}')">#springMessage(
                                    "common.ration.delay")</a>&nbsp;|
                            #elseif($!{ration.delayStatus} <= 1)
                                <a class="" href="#" onclick="update('$!{ration.delayCode}')">#springMessage(
                                    "common.button.edit")</a>&nbsp;|
                                <a class="" href="#" onclick="deleteColumn('$!{ration.delayCode}')">#springMessage(
                                    "common.button.delete")</a>&nbsp;|
                            #elseif($!{ration.delayStatus} < 95)
                                ##<a class="" href="#" onclick="viewdelay('$!{ration.delayCode}')">#springMessage("common.button.view")</a>
                            #elseif($!{ration.delayStatus} == 95)
                                <a class="" href="#" onclick="add('$!{ration.id}')">#springMessage(
                                    "common.ration.delay")</a>&nbsp;|
                            #end
                            <a class="" href="#" onclick="viewdelay('$!{ration.id}')">#springMessage(
                                "common.button.view")</a>
                            ##					&nbsp;|
                            ##  				<a class="" href="#" onclick="bt.trackFlowByBusinessId('$!{ration.id}')">#springMessage("common.button.trackFlow")</a>
                        </td>
                    #else
                    </tr>
                    <tr>
                        #if($!{rationDtl.itemFlag} == "0")
                            <td align="center">
                                $dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
                            </td>
                            <td align="center">
                                $!{rationDtl.itemName}
                            </td>
                            <td align="center">
                                $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                            </td>
                            <td align="right">
                                $number.formatNumeric($!{rationDtl.money})
                            </td>
                        #else
                            #if($!{rationDtl.firstComp} == "1")
                                <td align="center" rowspan="$!{ration.compItemSize}">
                                    $dictTag.get("RatModel.ItemFlag", $!{rationDtl.itemFlag})
                                </td>
                                <td align="center">
                                    $!{rationDtl.itemName}
                                </td>
                                <td align="center">
                                    $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                                </td>
                                <td align="right" rowspan="$!{ration.compItemSize}">
                                    $number.formatNumeric($!{rationDtl.money})
                                </td>
                            #else
                                <td align="center">
                                    $!{rationDtl.itemName}
                                </td>
                                <td align="center">
                                    $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                                </td>
                            #end
                        #end
                    #end
                #end
            </tr>
            #end
        </tbody>
    </table>
</div>
<div id="page"></div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratBkrationDelay.list.js?_btv=${resourceVersion}"></script>
</html>

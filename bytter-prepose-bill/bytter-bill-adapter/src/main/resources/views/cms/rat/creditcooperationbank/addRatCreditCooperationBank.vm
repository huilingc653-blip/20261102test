<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##授信银行名称
            <td class="textRight" width="46%">#springMessage('table.ratBkration.creditBankName')</td>
            <td width="54%">
                <div class="layui-inline">
                    <input type="text" class="layui-input" id="showBankName" readonly="readonly" lay-verify="required"/>
                </div>
                <div class="layui-inline">
                    <button type="button" class="layui-btn bt-biz-bankInfo" data-beforeClick="bt.bankInfoBeforeClick"
                            data-callback="bankinfoCallback">#springMessage('common.button.select')</button>
                </div>
                <input type="hidden" id="bankCode" name="bankCode"/>
                <input type="hidden" id="bankName" name="bankName"/>
            </td>
        </tr>
        <tr>
            ##合作情况
            <td class="textRight" width="46%">#springMessage('table.ratBkration.cooperationType')</td>
            <td width="54%">
                <div class="layui-form">
                    <div class="bt-biz-dict" data-type="select" data-group="rat.cooperation.type" data-name="cooperationType" data-biz-name="cooperationType" data-required="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/creditcooperationbank/ratCreditCooperationBank.add.js?_btv=${resourceVersion}"></script>
</html>
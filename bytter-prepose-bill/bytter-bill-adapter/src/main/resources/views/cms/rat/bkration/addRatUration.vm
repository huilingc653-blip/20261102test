<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{ratUrationPage.id}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##系统类型
				<td class="textRight">#springMessage('table.ratUration.type')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="type" name="type" 
							   decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.type')">
										</td>
        		##系统代码
				<td class="textRight">#springMessage('table.ratUration.syscode')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="syscode" name="syscode" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.syscode')">
										</td>
			</tr>
        	<tr>
        		##业务名称
				<td class="textRight">#springMessage('table.ratUration.businessName')</td>
				<td >
						<!--number-->
                        <input type="text" id="businessName" name="businessName" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.businessName')">
										</td>
        		##关联主业务主码
				<td class="textRight">#springMessage('table.ratUration.billNo')</td>
				<td >
						<!--number-->
                        <input type="text" id="billNo" name="billNo" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.billNo')">
										</td>
			</tr>
        	<tr>
        		##单位代码
				<td class="textRight">#springMessage('table.ratUration.compId')</td>
				<td >
						<!--number-->
                        <input type="text" id="compId" name="compId" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.compId')">
										</td>
        		##占用授信类型
				<td class="textRight">#springMessage('table.ratUration.ratType')</td>
				<td >
						<!--number-->
                        <input type="text" id="ratType" name="ratType" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.ratType')">
										</td>
			</tr>
        	<tr>
        		##授信编号
				<td class="textRight">#springMessage('table.ratUration.ratCode')</td>
				<td >
						<!--number-->
                        <input type="text" id="ratCode" name="ratCode" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.ratCode')">
										</td>
        		##币别
				<td class="textRight">#springMessage('table.ratUration.curCode')</td>
				<td >
						<!--number-->
                        <input type="text" id="curCode" name="curCode" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.curCode')">
										</td>
			</tr>
        	<tr>
        		##品种标识
				<td class="textRight">#springMessage('table.ratUration.itemFlag')</td>
				<td >
						<!--number-->
                        <input type="text" id="itemFlag" name="itemFlag" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.itemFlag')">
										</td>
        		##占用授信品种
				<td class="textRight">#springMessage('table.ratUration.itemCode')</td>
				<td >
						<!--number-->
                        <input type="text" id="itemCode" name="itemCode" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.itemCode')">
										</td>
			</tr>
        	<tr>
        		##占用到期日期
				<td class="textRight">#springMessage('table.ratUration.scheduleenddate')</td>
				<td >
						                        <div type="date" field="scheduleenddate" defaultVal="$!{ratUrationPage.scheduleenddate}"></div>
				</td>
        		##金额
				<td class="textRight">#springMessage('table.ratUration.money')</td>
				<td >
						<!--number-->
                        <input type="text" id="money" name="money" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.money')">
										</td>
			</tr>
        	<tr>
        		##敞口额度
				<td class="textRight">#springMessage('table.ratUration.openMoney')</td>
				<td >
						<!--number-->
                        <input type="text" id="openMoney" name="openMoney" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.openMoney')">
										</td>
        		##拆算前金额
				<td class="textRight">#springMessage('table.ratUration.preMoney')</td>
				<td >
						<!--number-->
                        <input type="text" id="preMoney" name="preMoney" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.preMoney')">
										</td>
			</tr>
        	<tr>
        		##折算前额度
				<td class="textRight">#springMessage('table.ratUration.convertPreMoney')</td>
				<td >
						<!--number-->
                        <input type="text" id="convertPreMoney" name="convertPreMoney" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.convertPreMoney')">
										</td>
        		##汇率
				<td class="textRight">#springMessage('table.ratUration.exchangeRate')</td>
				<td >
						<!--number-->
                        <input type="text" id="exchangeRate" name="exchangeRate" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.exchangeRate')">
										</td>
			</tr>
        	<tr>
        		##初始币别
				<td class="textRight">#springMessage('table.ratUration.initCurCode')</td>
				<td >
						<!--number-->
                        <input type="text" id="initCurCode" name="initCurCode" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.initCurCode')">
										</td>
        		##备注
				<td class="textRight">#springMessage('table.ratUration.remark')</td>
				<td >
						<!--number-->
                        <input type="text" id="remark" name="remark" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.remark')">
										</td>
			</tr>
        	<tr>
        		##状态
				<td class="textRight">#springMessage('table.ratUration.status')</td>
				<td >
						<!--number-->
                        <input type="text" id="status" name="status" 
							   decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.status')">
										</td>
        		##开始日期
				<td class="textRight">#springMessage('table.ratUration.beginDate')</td>
				<td >
						                        <div type="date" field="beginDate" defaultVal="$!{ratUrationPage.beginDate}"></div>
				</td>
			</tr>
        	<tr>
        		##结束日期
				<td class="textRight">#springMessage('table.ratUration.endDate')</td>
				<td >
						                        <div type="date" field="endDate" defaultVal="$!{ratUrationPage.endDate}"></div>
				</td>
        		##创建人名称
				<td class="textRight">#springMessage('table.ratUration.createName')</td>
				<td >
						<!--number-->
                        <input type="text" id="createName" name="createName" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.createName')">
										</td>
			</tr>
        	<tr>
        		##创建人登录名称
				<td class="textRight">#springMessage('table.ratUration.createBy')</td>
				<td >
						<!--number-->
                        <input type="text" id="createBy" name="createBy" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.createBy')">
										</td>
        		##创建日期
				<td class="textRight">#springMessage('table.ratUration.createDate')</td>
				<td >
						                        <div type="date" field="createDate" defaultVal="$!{ratUrationPage.createDate}"></div>
				</td>
			</tr>
        	<tr>
        		##更新人名称
				<td class="textRight">#springMessage('table.ratUration.updateName')</td>
				<td >
						<!--number-->
                        <input type="text" id="updateName" name="updateName" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.updateName')">
										</td>
        		##更新人登录名称
				<td class="textRight">#springMessage('table.ratUration.updateBy')</td>
				<td >
						<!--number-->
                        <input type="text" id="updateBy" name="updateBy" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratUration.updateBy')">
										</td>
			</tr>
        	<tr>
        		##更新日期
				<td class="textRight">#springMessage('table.ratUration.updateDate')</td>
				<td >
						                        <div type="date" field="updateDate" defaultVal="$!{ratUrationPage.updateDate}"></div>
				</td>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/rat/ratUration.add.js?_btv=${resourceVersion}"></script>
</html>
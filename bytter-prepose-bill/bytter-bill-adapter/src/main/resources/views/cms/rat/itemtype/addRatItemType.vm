<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{ratItemTypePage.id}">
			<input id="status" name="status" type="hidden" value="0">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##品种类型编码
				<td class="textRight">#springMessage('table.ratItemType.ritCode')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="ritCode" name="ritCode" maxlength="10" lay-verify="required"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratItemType.ritCode')">
										</td>
        		##品种类型名称
				<td class="textRight">#springMessage('table.ratItemType.ritName')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="ritName" name="ritName" lay-verify="required"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratItemType.ritName')">
										</td>
			</tr>
        	<tr>
        		##品种类型描述
				<td class="textRight">#springMessage('table.ratItemType.ritDesc')</td>
				<td colspan="3">
						<!--number-->
                        <input type="text" id="ritDesc" name="ritDesc" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.ratItemType.ritDesc')">
				</td>
			</tr>
			<tr>
				<td colspan="4" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/itemtype/ratItemType.add.js?_btv=${resourceVersion}"></script>
</html>
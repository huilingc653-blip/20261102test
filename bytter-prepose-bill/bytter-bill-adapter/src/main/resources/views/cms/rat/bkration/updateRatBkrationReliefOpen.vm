<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{result.ratBkrationReliefPage.id}">
			<input id="ratCode" name="ratCode" type="hidden" value="$!{result.ratBkrationReliefPage.ratCode}">
			<input type="hidden" id="ratType" name="ratType" value="0">
			<input type="hidden" id="corpId" name="corpId" value="$!{result.ratBkrationReliefPage.corpId}">
			<input type="hidden" id="reliefCorp" name="reliefCorp" value="$!{result.ratBkrationReliefPage.reliefCorp}">
			<input type="hidden" id="byReliefCorp" name="byReliefCorp" value="$!{result.ratBkrationReliefPage.byReliefCorp}">
			<input type="hidden" id="curCode" name="curCode" value="$!{result.ratBkrationReliefPage.curCode}">
			<input type="hidden" id="flag" name="flag" value="$!{result.flag}">
			<input type="hidden" id="assurepercent" name="assurepercent" value="$!{result.byItemAssure.assurepercent}">
			<input type="hidden" id="interestrate" name="interestrate" value="$!{result.byItemAssure.interestrate}">
			<input type="hidden" id="reliefCode" name="reliefCode" value="$!{result.ratBkrationReliefPage.reliefCode}">
			<input type="hidden" id="byReliefCode" name="byReliefCode" value="$!{result.ratBkrationReliefPage.byReliefCode}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##资金中心
				<td width="18%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
				<td width="32%" colspan="2">
					$!{result.ratBkrationPage.corpName}
				</td>
        		##授信银行编号
				<td width="18%" class="textRight">#springMessage('table.ratBkration.bankCode')</td>
				<td width="32%" colspan="2">
					$!{result.ratBkrationPage.bankName}
				</td>
			</tr>
        	<tr>
				##授信合同号
				<td class="textRight">#springMessage('table.ratBkration.contractNo')</td>
				<td colspan="2">
                	$!{result.ratBkrationPage.contractNo}
				</td>
        		##授信币种
				<td class="textRight">#springMessage('table.ratBkration.curCode')</td>
				<td colspan="2">
					$!{result.ratBkrationPage.curName}
				</td>
			</tr>
			<tr>
				##调剂单位
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.reliefCorp')</td>
				<td colspan="2">
                	$!{result.ratBkrationReliefPage.reliefCorpName}
				</td>
				##被调剂单位
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.byReliefCorp')</td>
				<td colspan="2">
                	$!{result.ratBkrationReliefPage.byReliefCorpName}
				</td>
			</tr>
			<tr>
        		##调剂品种类型
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.reliefItemFlag')</td>
				<td colspan="2">
					<div class="layui-input-inline">
						<select name="reliefItemFlag" id="reliefItemFlag" lay-verify="required" lay-search="" lay-filter="reliefItemFlag">
							#foreach($itemFlag in $!{result.reliefItemFlags})
								#if($!{itemFlag.itemFlag} == ${result.ratBkrationReliefPage.reliefItemFlag})
								<option value="$!{itemFlag.itemFlag}" selected="selected">$dictTag.get("RatModel.ItemFlag", $!{itemFlag.itemFlag})</option>
								#else
								<option value="$!{itemFlag.itemFlag}" >$dictTag.get("RatModel.ItemFlag", $!{itemFlag.itemFlag})</option>
								#end
							#end
						</select>
					</div>
				</td>
        		##被调剂品种类型
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.byReliefItemFlag')</td>
				<td colspan="2">
					<div class="layui-input-inline">
						<select name="byReliefItemFlag" id="byReliefItemFlag" lay-verify="required" lay-search="" lay-filter="byReliefItemFlag">
							#foreach($itemFlag in $!{result.byReliefItemFlags})
								#if($!{itemFlag.itemFlag} == ${result.ratBkrationReliefPage.byReliefItemFlag})
								<option value="$!{itemFlag.itemFlag}" selected="selected">$dictTag.get("RatModel.ItemFlag", $!{itemFlag.itemFlag})</option>
								#else
								<option value="$!{itemFlag.itemFlag}" >$dictTag.get("RatModel.ItemFlag", $!{itemFlag.itemFlag})</option>
								#end
							#end
						</select>
					</div>
				</td>
			</tr>
			<tr>
        		##调剂品种
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.reliefItemCode')</td>
				<td colspan="2" id="reliefItemCodeTd">
					#if($!{result.ratBkrationReliefPage.reliefItemFlag} == "0")
					<div class="layui-input-inline">
					#foreach($item in $!{result.reliefItems})
						#set($vcount = $velocityCount - 1)
						#if($!{vcount} == "0")
						<input type="hidden" name="reliefDtls[$!{item.itemOrder}].itemOrder" value="$!{item.itemOrder}">
					<div class="layui-input-inline">
						<select name="reliefDtls[$!{item.itemOrder}].reliefItemCode" id="reliefItemCode" lay-verify="required" lay-search="" lay-filter="reliefItemCode">
						#else
						#end
							#if($!{item.itemCode} == ${result.ratBkrationReliefPage.reliefItemCode})
							<option value="$!{item.itemCode}" selected="selected">$!{item.itemName}</option>
							#else
							<option value="$!{item.itemCode}">$!{item.itemName}</option>
							#end
					#end
						</select>
					</div>
					#else
						<table class="layui-table" width="100%" style="margin:0px">
							<tr>
								<th>#springMessage("table.ratBkrationDetail.itemCode")</th>
								<th>#springMessage("table.ratBkrationDisDetail.leftDisMoney")</th>
								<th>#springMessage("table.ratBkrationRelief.byReliefMoney")</th>
							</tr>
							#foreach($item in $!{result.reliefItems})
							<tr>
								<td><input type="hidden" name="reliefDtls[$!{item.itemOrder}].itemOrder" value="$!{item.itemOrder}">
								<input type="hidden" name="reliefDtls[$!{item.itemOrder}].reliefItemCode" value="$!{item.itemCode}">$!{item.itemName}</td>
								<td align="right">$number.formatNumeric($!{item.maxMoney})</td>
								<td align="right"><input type="text" data-name="reliefDtls[$!{item.itemOrder}].reliefMaxMoney" 
									data-biz-name="reliefMaxMoney$!{item.itemOrder}" id="reliefMaxMoney$!{item.itemOrder}" value="$!{item.money}" rowindex="$!{item.itemOrder}"
									class="layui-input bt-biz-moneyType" data-decimal="2" data-minus="false" data-max="$!{item.maxMoney}" data-callback="bt.checkReliefMoney"></td>
							</tr>
							#end
						</table>
					#end
				</td>
        		##被调剂品种
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.byReliefItemCode')</td>
				<td id="byReliefItemCodeTd">
					#if($!{result.ratBkrationReliefPage.byReliefItemFlag} == "0")
					<div class="layui-input-inline">
					#foreach($item in $!{result.byReliefItems})
						#set($vcount = $velocityCount - 1)
						#if($!{vcount} == "0")
						<input type="hidden" name="reliefDtls[$!{item.itemOrder}].byItemOrder" value="$!{item.itemOrder}">
					<div class="layui-input-inline">
						<select name="reliefDtls[$!{item.itemOrder}].byReliefItemCode" id="byReliefItemCode" lay-verify="required" lay-search="" lay-filter="byReliefItemCode">
						#else
						#end
							#if($!{item.itemCode} == ${result.ratBkrationReliefPage.byReliefItemCode})
							<option value="$!{item.itemCode}" selected="selected">$!{item.itemName}</option>
							#else
							<option value="$!{item.itemCode}">$!{item.itemName}</option>
							#end
					#end
						</select>
						</div>
					</div>
					#else
						<table class="layui-table" width="100%" style="margin:0px">
							<tr>
								<th>#springMessage("table.ratBkrationDetail.itemCode")</th>
								<th>#springMessage("table.ratBkrationDisDetail.leftDisMoney")</th>
								<th>#springMessage("table.ratBkrationRelief.canReliefMoney")</th>
							</tr>
							#foreach($item in $!{result.byReliefItems})
							<tr>
								<td><input type="hidden" name="reliefDtls[$!{item.itemOrder}].byItemOrder" value="$!{item.itemOrder}">
								<input type="hidden" name="reliefDtls[$!{item.itemOrder}].byReliefItemCode" value="$!{item.itemCode}">$!{item.itemName}</td>
								<td align="right">$number.formatNumeric($!{item.maxMoney})</td>
								<td align="right"><input type="text" data-name="reliefDtls[$!{item.itemOrder}].byReliefMaxMoney" 
									data-biz-name="byReliefMaxMoney$!{item.itemOrder}" id="byReliefMaxMoney$!{item.itemOrder}" value="$!{item.money}"
									class="layui-input bt-biz-moneyType" data-decimal="2" data-minus="false" data-max="$!{item.maxMoney}" data-callback="bt.checkMoney"></td>
							</tr>
							#end
						</table>
					#end
				</td>
			</tr>
			<tr>
				##调剂额度
				<td class="textRight">#springMessage('table.ratBkrationRelief.byReliefMoney')</td>
				<td colspan="2">
                	<input type="text" data-name="byReliefMoney" id="byReliefMoney" data-biz-name="byReliefMoney" class="layui-input bt-biz-moneyType" 
                		data-decimal="2" data-minus="false" readonly="readonly" value="$!{result.disMoneyDTO.money}">
				</td>
        		##被调剂额度
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.reliefMoney')</td>
				<td colspan="2">
               	#if($!{result.ratBkrationReliefPage.reliefItemFlag} == "0")
                	<input type="text" data-name="reliefMoney" id="reliefMoney" data-biz-name="reliefMoney" class="layui-input bt-biz-moneyType" 
                		data-decimal="2" data-minus="false" data-callback="bt.calMoney" value="$!{result.ratBkrationReliefPage.reliefMoney}">
				#else
                	<input type="text" data-name="reliefMoney" id="reliefMoney" data-biz-name="reliefMoney" class="layui-input bt-biz-moneyType" readonly="readonly"
                		data-decimal="2" data-minus="false" data-callback="bt.calMoney" value="$!{result.ratBkrationReliefPage.reliefMoney}">
				#end
				</td>
			</tr>
			<tr>
				##调剂敞口额度
				<td class="textRight">#springMessage('table.ratBkrationRelief.byReliefOpenMoney')</td>
				<td colspan="2">
                	<input type="text" data-name="byReliefOpenMoney" id="byReliefOpenMoney" data-biz-name="byReliefOpenMoney" class="layui-input bt-biz-moneyType" 
                		data-decimal="2" data-minus="false" readonly="readonly" value="$!{result.disMoneyDTO.openMoney}">
				</td>
        		##被调剂敞口额度
				<td class="textRight"><font color="red">*</font>#springMessage('table.ratBkrationRelief.reliefOpenMoney')</td>
				<td colspan="2">
                	<input type="text" data-name="reliefOpenMoney" id="reliefOpenMoney" data-biz-name="reliefOpenMoney" class="layui-input bt-biz-moneyType" 
                		data-decimal="2" data-minus="false" readonly="readonly" value="$!{result.ratBkrationReliefPage.reliefOpenMoney}">
				</td>
			</tr>
			</tbody>
		</table>
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratBkrationReliefOpen.edit.js?_btv=${resourceVersion}"></script>
</html>
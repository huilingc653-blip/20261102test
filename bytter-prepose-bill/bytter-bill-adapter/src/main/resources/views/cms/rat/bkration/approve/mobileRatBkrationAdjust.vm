#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-divider">#springMessage('table.ratBkration.ratMsg')</li>##授信信息
##授信模式
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.ratMode')
        <span class="mui-badge mui-badge-inverted">
			$dictTag.get("RatBkration.RatMode", "$!{ratBkrationPage.ratMode}")
        </span>
    </li>
##授信编号
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.ratCode')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.ratCode}
        </span>
    </li>
##银行名称
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.ratCode')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.bankName}
        </span>
    </li>
##授信单位
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.corpId')
        <span class="mui-badge mui-badge-inverted">
			$!{ratBkrationPage.corpName}
        </span>
    </li>
##授信币种
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.curCode')
        <span class="mui-badge mui-badge-inverted">
            $!{ratBkrationPage.curName}
        </span>
    </li>
##授信开始时间
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.begindate')
        <span class="mui-badge mui-badge-inverted">
			$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
        </span>
    </li>
##授信结束时间
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.enddate')
        <span class="mui-badge mui-badge-inverted">
			$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
        </span>
    </li>
   ##备注
    <li class="mui-table-view-cell">
		#springMessage('table.ratBkration.remark')
        <textarea rows="3" class="layui-textarea" readonly="readonly">$!{ratBkrationPage.remark}</textarea>
    </li>
    ##调整明细
    <li class="mui-table-view-divider">#springMessage('table.ratBkration.ratAdjustMsg')</li>
    <li class="ui-border-t">
        <div class="ui-list-info">
            <ul class="ui-row"
                style="border-width: 1px; text-align: center;">
                <li class="ui-col ui-col-50" style="background: #C4E1FF;"
                    style="border-width: 1px; width: 100%;">
                    <table style="border-collapse: collapse;border-spacing: 0; width: 100%; text-align: center;">
                        <thead>
                        <tr>
##                            <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
                            <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
##                            <th width='180px'>#springMessage('table.ratBkrationDetail.money')</th>
##                            <th width='180px'>#springMessage('table.ratBkrationDetail.maxMoney')</th>
                            #if($!{ratBkrationAdjust.businessType}=="0")##授信录入
                                <th width='180px'>#springMessage('table.ratBkrationDetail.disMoney')</th>##分配额度
                            #else
                                <th width='180px'>#springMessage('table.ratBkrationDisDetail.superProcessMoney')</th>##占用额度
                            #end
                            <th width='180px'>#springMessage('table.ratBkration.adjustMoney')</th>
                            <th width='180px'>#springMessage('table.ratBkration.adjustMaxMoney')</th>
##                            <th width='180px'>#springMessage('table.ratBkration.CanUseMaxMoney')</th>
                        </tr>
                        </thead>
                        <tbody style="background: #fff;"
                        #if($!{ratBkrationAdjust.businessType}=="0"&&$!{ratBkrationPage.ratMode}=="0")##授信录入且授信模式是集团授信
                            #foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
                                #set($vcount = $velocityCount - 1)
                                <tr>
##                                    #if($!{vcount} == "0")
##                                        <td rowspan="$!{ratBkrationPage.compItemSize}" align="center">##授信类型
##                            $dictTag.get("RatModel.ItemFlag", "1")
##                                        </td>
##                                    #end
                                    <td align="center">##授信品种
                            $!{rationDtl.itemName}
                                    </td>
##                                    #if($!{vcount} == "0")##授信额度
##                                        <td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
##                                            #set($ratMoney=$!{rationDtl.money})
##							$!number.formatNumeric($!{rationDtl.money})
##                                        </td>
##                                    #end
##                                    <td align="right">##最高额度
##                            $!number.formatNumeric($!{rationDtl.maxMoney})
##                                    </td>
                                    <td align="right">##分配额度
                            $!number.formatNumeric($!{rationDtl.disMoney})
                                    </td>
                                    <td align="right">##调整最高额度
                            $!number.formatNumeric($!{rationDtl.adjustMoney})
                                    </td>
                                    <td align="right">##调整后最高额度
                            $!number.formatNumeric($!{rationDtl.adjustedMoney})
                                    </td>
##                                    <td align="right">##可用最高额度
##                                        #set($canUseMaxMoney=($!{rationDtl.adjustedMoney}-$!{rationDtl.disMoney}))
##                                        <span id="$!{rationDtl.itemOrder}canUseMaxMoney"> $!number.formatNumeric($!{canUseMaxMoney})</span>
##                                    </td>
                                </tr>
                            #end
                        #else
                            #foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
                                #set($vcount = $velocityCount - 1)
                                <tr>
##                                    #if($!{vcount} == "0")
##                                        <td rowspan="$!{ratBkrationPage.compItemSize}" align="center">##授信类型
##                            $dictTag.get("RatModel.ItemFlag", "1")
##                                        </td>
##                                    #end
                                    <td align="center">##授信品种
                            $!{rationDtl.itemName}
                                    </td>
##                                    #if($!{vcount} == "0")##授信额度
##                                        <td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
##                                            #set($ratMoney=$!{rationDtl.money})
##							$!number.formatNumeric($!{rationDtl.money})
##                                        </td>
##                                    #end
##                                    <td align="right">##最高额度
##                            $!number.formatNumeric($!{rationDtl.maxMoney})
##                                    </td>
                                    <td align="right">##占用额度
                            $!number.formatNumeric($!{rationDtl.superProcessMoney})
                                    </td>
                                    <td align="right">##调整最高额度
                            $!number.formatNumeric($!{rationDtl.adjustMoney})
                                    </td>
                                    <td align="right">##调整后最高额度
                             $!number.formatNumeric($!{rationDtl.adjustedMoney})
                                    </td>
##                                    <td align="right">##可用最高额度
##                                        #set($canUseMaxMoney=($!{rationDtl.adjustedMoney}-$!{rationDtl.superProcessMoney}))
##                                        <span id="$!{rationDtl.itemOrder}canUseMaxMoney"> $!number.formatNumeric($!{canUseMaxMoney})</span>
##                                    </td>
                                </tr>
                            #end
                        #end
                        </tbody>
                        <tfoot>
                        <tr style="background: #fff;">
                            <td align="center">#springMessage('table.ratBkration.sumMoney')</td>
                            <td >&nbsp;</td>
                            <td align="right">
                                $number.formatNumeric($!{sumMoney})
                            </td>
                            <td >&nbsp;</td>
                        </tr>
                        </tfoot>
                    </table>
                </li>
            </ul>
        </div>
    </li>
##备注
    <li class="mui-table-view-cell">
        #springMessage('table.ratBkration.adjustRmk')
        <textarea rows="3" class="layui-textarea" readonly="readonly">$!{ratBkrationAdjust.remark}</textarea>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

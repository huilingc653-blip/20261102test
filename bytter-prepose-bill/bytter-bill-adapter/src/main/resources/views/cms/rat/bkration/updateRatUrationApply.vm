<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{applyDTO.id}">
    <input id="disCode" name="disCode" type="hidden" value="$!{ratBkrationPage.disCode}">
    <input id="ratCode" name="ratCode" type="hidden" value="$!{ratBkrationPage.id}">
    <input id="curCode" name="curCode" type="hidden" value="$!{ratBkrationPage.curCode}">
    <input type="hidden" id="corpId" name="corpId" value="$!{ratBkrationPage.corpId}">
    <input type="hidden" id="ratType" name="ratType" value="0">
    <input type="hidden" id="guaWay" name="guaWay" value="$!{guaWay}">
	<input type="hidden" id="beginDate" value="$!{beginDate}">
	<input type="hidden" id="exchangeMoney" value="$!{applyDTO.money}">
	<input type="hidden" id="exchangeBondMoney" value="$!{applyDTO.bondMoney}">
	## 占用授信金额汇率
	<input type="hidden" id="exchangeMoneyRate" value="$!{exchangeMoneyRate}">
	## 保证金金额汇率
	<input type="hidden" id="exchangeBondMoneyRate" value="$!{exchangeBondMoneyRate}">
    <input type="hidden" id="isOpenRat" value="$!{isOpenRat}">
    <input type="hidden" id="isGuarantee" value="$!{isGuarantee}">
    <input type="hidden" id="isHangGuarantee" value="$!{isHangGuarantee}">
    <input type="hidden" id="allGuaWayCode" value="$!{allGuaWayCode}">
    <table class="layui-table">
        <tbody>
        <tr>
            ##资金中心
            <td width="15%" class="textRight">#springMessage('table.ratBkration.corpId')</td>
            <td width="18%">
                $!{ratBkrationPage.ratCorpName}
            </td>
            ##授信编号
            <td width="15%" class="textRight">#springMessage('table.ratBkration.bankCode')</td>
            <td width="18%">
                $!{ratBkrationPage.bankName}
            </td>
            ##授信合同号
            <td width="15%" class="textRight">#springMessage('table.ratBkration.contractNo')</td>
            <td width="19%">
                $!{ratBkrationPage.contractNo}
            </td>
        </tr>
        <tr>
            ##授信币种
            <td class="textRight">#springMessage('table.ratBkration.curCode')</td>
            <td>
                $!{ratBkrationPage.curName}
            </td>
            ##授信开始时间
            <td class="textRight">#springMessage('table.ratBkration.begindate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)
            </td>
            ##授信结束时间
            <td class="textRight">#springMessage('table.ratBkration.enddate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)
            </td>
        </tr>
        <tr>
            ##额度使用单位
            <td class="textRight">#springMessage('table.ratUrationApply.corpId')</td>
            <td>
                $!{ratBkrationPage.corpName}
            </td>
            <td colspan="4"></td>
        </tr>
        </tbody>
    </table>

    <table class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th width='150px'>#springMessage('table.ratBkrationDetail.itemCodeFlag')</th>
            <th width='200px'>#springMessage('table.ratBkrationDetail.itemCode')</th>
            <th width='200px'>#springMessage('table.ratBkrationDetail.creditType')</th>##授信方式
            <th width='180px'>#springMessage('table.ratBkrationDetail.money')</th>
            <th width='180px'>#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>
            <th width='180px'>#springMessage('table.ratBkrationDetail.maxMoney')</th>
            <th width='180px'>#springMessage('table.ratBkrationDetail.leftMaxMoney')</th>
        </tr>
        </thead>
        <tbody>
            #foreach($rationDtl in $!{ratBkrationPage.singRationDtls})
            <tr>
                <td align="center">
                    $dictTag.get("RatModel.ItemFlag", "0")
                </td>
                <td align="center">
                    $!{rationDtl.itemName}
                </td>
                <td align="center">
                    $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                </td>
                <td align="right">
                    $number.formatNumeric($!{rationDtl.money})
                </td>
                <td align="right">
                    $number.formatNumeric($!{rationDtl.allDisMoney})
                </td>
                <td></td>
                <td></td>
            </tr>
            #end
            ##综合授信
            #foreach($rationDtl in $!{ratBkrationPage.compRationDtls})
                #set($vcount = $velocityCount - 1)
            <tr>
                #if($!{vcount} == "0")
                    <td rowspan="$!{ratBkrationPage.compItemSize}" align="center">
                        $dictTag.get("RatModel.ItemFlag", "1")
                    </td>
                #end
                <td align="center">
                    $!{rationDtl.itemName}
                </td>
                <td align="center">
                    $dictTag.get("rat.creditType", $!{rationDtl.creditType})
                </td>
                #if($!{vcount} == "0")
                    <td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
                        $number.formatNumeric($!{rationDtl.money})
                    </td>
                    <td rowspan="$!{ratBkrationPage.compItemSize}" align="right">
                        $number.formatNumeric($!{rationDtl.allDisMoney})
                    </td>
                #end
                <td align="right">
                    $number.formatNumeric($!{rationDtl.maxMoney})
                </td>
                <td align="right">
                    $number.formatNumeric($!{rationDtl.allDisMaxMoney})
                </td>
            </tr>
            #end
        </tbody>
    </table>
    <table class="layui-table" id="singleTable">
        <tbody>
        <tr>
            ##占用授信品种
            <td class="textRight">#springMessage('table.ratUrationApply.itemCode')</td>
            <td>
                #if(${applyDTO.itemFlag} == "0")
                    <input type="hidden" name="itemCode" id="itemCode" value="$!{applyDTO.singItemCode}">
                    <input type="hidden" data-name="maxMoney" data-biz-name="maxMoney" value="$!{applyDTO.leftMoney}"
                           class="layui-input bt-biz-moneyType">
                    $!{applyDTO.singItemName}
                #else
                    #foreach($applyDtl in $!{applyDTO.applyDtls})
                        #set($vcount = $velocityCount - 1)
                        <input type="hidden" id="itemOrder" value="$!{applyDtl.itemOrder}"/>
                        <input type="hidden" name="itemCode" value="$!{applyDtl.itemCode}">
                        <input type="hidden" name="ratCreditType" value="$!{applyDtl.creditType}">
                        <input type="hidden" name="applyDtls[$!{applyDtl.itemOrder}].itemOrder"
                               id="$!{applyDtl.itemOrder}itemOrder" value="$!{applyDtl.itemOrder}">
                        <input type="hidden" name="applyDtls[$!{applyDtl.itemOrder}].itemCode"
                               id="$!{applyDtl.itemOrder}itemCode"
                               itemOrder="$!{applyDtl.itemOrder}" id="itemCode$!{applyDtl.itemOrder}"
                               value="$!{applyDtl.itemCode}">
                        <input type="hidden" name="applyDtls[$!{applyDtl.itemOrder}].itemName"
                               id="$!{applyDtl.itemOrder}itemName"
                               id="itemName$!{applyDtl.itemOrder}" value="$!{applyDtl.itemName}">
                        <input type="hidden" name="applyDtls[$!{applyDtl.itemOrder}].creditType"
                               value="$!{applyDtl.creditType}">
                        $!{applyDtl.itemName}
                        <input type="hidden" data-name="applyDtls[$!{applyDtl.itemOrder}].maxMoney"
                               data-biz-name="maxMoney"
                               data-id="maxMoney$!{applyDtl.itemOrder}" class="layui-input bt-biz-moneyType"
                               data-decimal="2" data-minus="false" value="$!{applyDtl.maxMoney}">

                    #end
                #end
            </td>
            ##授信额度类型
            <td class="textRight">#springMessage('table.ratBkrationDetail.creditType')</td>
            <td>
                <input type="hidden" name="ratCreditType" value="$!{applyDTO.ratCreditType}">
                $!dictTag.get("rat.creditType", $!{applyDTO.ratCreditType})
            </td>
            ##授信类型
            <td class="textRight">#springMessage('table.ratBkrationDetail.itemCodeFlag')</td>
            <td>
                <input type="hidden" name="itemFlag" id="itemFlag" value="$!{applyDTO.itemFlag}">
                $!dictTag.get("RatModel.ItemFlag", $!{applyDTO.itemFlag})
            </td>
        </tr>
        <tr>
            ##业务品种
            <td class="textRight">#springMessage('cms.business.race')</td>
            <td>
                <input type="hidden" name="billName" value="$!{applyDTO.billNameId}">
                $!{applyDTO.billName}
            </td>
            ##业务币种
            <td class="textRight">#springMessage('table.urationapply.billCurId')</td>
            <td>
                <div class="layui-inline"><input type="hidden" id="initCurCode" value="">
                </div>
                <div class="bt-biz-selectType" data-biz-name="initCurCode"
                     data-url="${basePath}/cms/rat/raturationapply/getBillCurList?ratCurId=$!{applyDTO.curCode}"
                     data-valuefield="id" data-textfield="curName" data-required="true"
                     data-defaultvalue="$!{applyDTO.initCurCode}"
                     data-callback="bt.initCurIdCallback"
                     data-name="initCurCode" data-search="true"></div>
                </div>
            </td>
            ##业务金额
            <td class="textRight">#springMessage('table.urationapply.billMoney')</td>
            <td><input type="text" data-name="billMoney" id="billMoney"
                       data-biz-name="billMoney" class="layui-input bt-biz-moneyType"
                       data-decimal="2" data-min="0" data-minus="false" value="$!{applyDTO.billMoney}"
                       lay-verify="required" data-callback="bt.billMoneyCallback"></td>
        </tr>
        <tr>
            #if($!{isOpenRat}=="1")
                ##是否启用敞口授信
                <td class="textRight">#springMessage('table.urationapply.isOpenRat')</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                             data-defaultvalue="$!{applyDTO.isOpenRat}"
                             data-name="isOpenRat" data-biz-name="isOpenRat"
                             data-callback="bt.changeOpenRat"></div>
                    </div>
                </td>
            #end
            ##保证金币种
            <td class="textRight">#springMessage('table.urationapply.bondCurId')</td>
            <td>
						<span id="bondCurIdSpan">
							<div class="layui-inline">
                            <div class="bt-biz-selectType" data-biz-name="bondCurId"
                                 data-url="${basePath}/cms/rat/raturationapply/getBondCurList?billCurId=$!{applyDTO.initCurCode}&corpId=$!{ratBkrationPage.corpId}"
                                 data-valuefield="id" data-defaultvalue="$!{applyDTO.bondCurId}"
                                 data-textfield="curName" data-required="true"
                                 data-name="bondCurId" data-search="true" data-callback="bondCurIdCallback">
                        </div>
                        </div>
						</span>
            </td>
            ##保证金比例
            <td class="textRight">#springMessage('table.urationapply.bondPercent')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" data-name="assurepercent"
                           value="$!{applyDTO.assurepercent}" data-decimal="2" data-max="100"
                           class="layui-input bt-biz-ratioType"
                           data-biz-name="assurepercent"
                           data-callback="bt.setBailMoney"
                    /></div>
            </td>
        </tr>
        <tr>
            ##保证金金额
            <td class="textRight">#springMessage('table.urationapply.bondMoney')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="bondMoney"
                           name="bondMoney" data-decimal="2"
                           class="layui-input bt-biz-moneyType"
                           data-biz-name="bondMoney"
                           value="$!{applyDTO.bondMoney}"
                           data-callback="bt.setBailMoneyRate"/>
                </div>
            </td>
            ##授信占用金额
            <td class="textRight">#springMessage('table.ratUrationApply.money')</td>
            <td>
                #if(${applyDTO.itemFlag} == "0")
                    <input type="text" data-name="money" id="money" data-biz-name="money" value="$!{applyDTO.money}"
                           class="layui-input bt-biz-moneyType" data-decimal="2" data-minus="false"
                           lay-verify="required" > #*readonly="true"*#
                #else
                    <input type="text" data-name="money" id="money" data-biz-name="money" value="$!{applyDTO.money}"
                           class="layui-input bt-biz-moneyType" data-decimal="2" data-minus="false"
                           lay-verify="required" > #*readonly="true"*#
                #end
            </td>
            ##担保方式
            #if($!{isGuarantee}=="1")
                <td class="textRight">#springMessage('table.guaContract.guaType')</td>
                #if($!{isHangGuarantee}=="1")
                    <td>
                        <div class="layui-inline">
                            <input type="hidden" class="layui-input" name="guaWay" value="$!{guaWay}"
                                   readonly="readonly">
                            <input type="text" class="layui-input" readonly="readonly" value="$!{guaWayName}">
                        </div>
                    </td>
                #else
                    <td>
                        <div class="layui-inline">
                            <div class="selectDemo bt-biz-mulselectType" data-biz-name="guaWay" data-method="get"
                                 data-url="${basePath}/cms/guarantee/guaContractInfo/json" data-valuefield="code"
                                 data-textfield="name" data-defaultvalue="$!{applyDTO.guaWay}"
                                 data-name="guaWay"></div>
                        </div>
                    </td>
                #end

            #end
        </tr>
        <tr>
            ##开始日期
            <td class="textRight">#springMessage('table.ratUrationApply.beginDate')</td>
            <td>
                <input type="text" name="beginDate" id="beginDate" class="layui-input bt-biz-dateType" data-type="date"
                       lay-verify="required"
                       data-min="$!date.format('yyyy-MM-dd',$!ratBkrationPage.beginDate)"
                       data-initmax="$!date.format('yyyy-MM-dd',$!ratBkrationPage.endDate)"
                       data-biz-name="beginDate" data-endid="endDate" data-callback="bt.setDays"
                       value="$!date.format('yyyy-MM-dd',$!applyDTO.beginDate)">
            </td>
            ##结束日期
            <td class="textRight">#springMessage('table.ratUrationApply.endDate')</td>
            <td>
                <input type="text" name="endDate" id="endDate" class="layui-input bt-biz-dateType" data-type="date"
                       lay-verify="required"
                       data-biz-name="endDate" data-callback="bt.setDays"
                       value="$!date.format('yyyy-MM-dd',$!applyDTO.endDate)">
            </td>
            ##期限(系统自动计算)
            <td class="textRight">#springMessage('table.ratUrationApply.days')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="days" id="days" readonly="readonly"
                           value="$!{applyDTO.days}" lay-verify="required">
                </div>
                <div class="layui-inline"><span>#springMessage('common.timeUnit.day')</span></div>
            </td>
        </tr>
        <tr>
            ##合同号
            <td class="textRight">#springMessage('table.ratUrationApply.contactNo')</td>
            <td>
                <input type="text" class="layui-input" name="contactNo" id="contactNo" maxlength="50"
                       lay-verify="required" value="$!{applyDTO.contactNo}">
            </td>
            ##信用证号
            <td class="textRight">#springMessage('table.ratUrationApply.lcNo')</td>
            <td>
                <input type="text" class="layui-input" name="lcNo" id="lcNo" maxlength="32" value="$!{applyDTO.lcNo}">
            </td>
            ##票据号码
            <td class="textRight">#springMessage('table.ratUrationApply.billNo')</td>
            <td>
                <input type="text" class="layui-input" name="billNo" id="billNo" maxlength="32"
                       value="$!{applyDTO.billNo}">
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.ratBkration.remark')</td>
            <td colspan="9">
                <input type="text" class="layui-input" name="remark" id="remark" maxlength="100" style="width:90%"
                       value="$!{applyDTO.remark}">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.ratBkration.attach')</td>
            <td style="text-align: center;" colspan="9">
                <!-- 附件上传 -->
                <input id="annexName" name="attachmentId" type="hidden" value="$!{applyDTO.attachmentId}">
                <div id="uploader" class="layui-input-inline" style="width:100%"></div>
            </td>
        </tr>
        </tbody>
    </table>

    <table class="layui-table">
        <tbody>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage(
                    'common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationApply.edit.js?_btv=${resourceVersion}"></script>
</html>

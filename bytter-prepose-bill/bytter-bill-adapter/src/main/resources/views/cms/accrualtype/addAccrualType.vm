<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{accrualTypePage.id}">
    <input id="isSystem" name="isSystem" type="hidden" value="0">
    <input id="createBy" name="createBy" type="hidden" value="$!{accrualTypePage.createBy}">
    <input id="createDate" name="createDate" type="hidden" value="$!{accrualTypePage.createDate}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{accrualTypePage.updateBy}">
    <input id="updateDate" name="updateDate" type="hidden" value="$!{accrualTypePage.updateDate}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="30%">#springMessage('table.accrual.accrualCode')</td>
            <td>
                <input type="text" id="accrualCode" name="accrualCode" lay-verify="required|strlength"
                       data-minlength="2" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.accrual.accrualCode')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.accrual.accrualName')</td>
            <td>
                <input type="text" id="accrualName" name="accrualName" lay-verify="required|strlength"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.accrual.accrualName')">
            </td>
        </tr>
        <tr id="frequencyTypeTr">
            ##计提频率
            <td class="textRight">#springMessage('table.accrual.frequency')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-width="130px" data-name="frequencyType"
                         data-value="$!{accrualTypePage.frequencyType}" data-biz-name="frequencyType" data-type="select"
                         data-group="accrual.dateType" data-callback="showFrequency" data-required="true"></div>
                </div>
                <div class="layui-inline" id="showFrequencyDailyDate">
                    ## 天：accrual.dayCycle
                    #if("$!{accrualTypePage.frequencyType}" == "1")
                        <div class="bt-biz-dict" data-width="80px" data-name="frequency" data-type="select"
                             data-biz-name="frequencyDay" data-group="accrual.dayCycle"
                             data-callback="callFrequencyDailyDate"
                             data-value="$!{accrualTypePage.frequency}"
                             data-required="true"></div>
                    #elseif("$!{accrualTypePage.frequencyType}" == "2")
                        ## 周：accrual.weekCycle
                        <div class="bt-biz-dict" data-width="80px" data-name="frequency" data-type="select"
                             data-biz-name="frequencyWeek" data-group="accrual.weekCycle"
                             data-callback="callFrequencyDailyDate"
                             data-value="$!{accrualTypePage.frequency}"
                             data-required="true"></div>
                    #elseif("$!{accrualTypePage.frequencyType}" == "3")
                        ## 月：accrual.monthCycle
                        <div class="bt-biz-dict" data-width="80px" data-name="frequency" data-type="select"
                             data-biz-name="frequencyMonth" data-group="accrual.monthCycle"
                             data-callback="callFrequencyDailyDate"
                             data-value="$!{accrualTypePage.frequency}"
                             data-required="true"></div>
                    #elseif("$!{accrualTypePage.frequencyType}" == "4")
                        ## 季：accrual.seasonCycle
                        <div class="bt-biz-dict" data-width="80px" data-name="frequency" data-type="select"
                             data-biz-name="frequencyWeek" data-group="accrual.seasonCycle"
                             data-callback="callFrequencyDailyDate"
                             data-value="$!{accrualTypePage.frequency}"
                             data-required="true"></div>
                    #elseif("$!{accrualTypePage.frequencyType}" == "5")
                        ## 年：accrual.yearCycle
                        <div class="bt-biz-dict" data-width="80px" data-name="frequency" data-type="select"
                             data-biz-name="frequencyYear" data-group="accrual.yearCycle"
                             data-callback="callFrequencyDailyDate"
                             data-value="$!{accrualTypePage.frequency}"
                             data-required="true"></div>
                    #end
                </div>
                <div class="layui-inline" id="showFrequencyDailyDateInput">
                    #if("$!{accrualTypePage.frequencyDailyDate}"=="other")
                        <input type="text" id="frequencyDailyDateInput" name="frequencyDailyDate" lay-verify="required|number|numMax|numMin" autocomplete="off"
                               class="layui-input" style="width: 130px"
                               placeholder="#springMessage('sys.form.verify.mustBeInteger')"
                               value="$!{accrualTypePage.frequencyDailyDate}">
                    #end
                </div>
            </td>
        </tr>
        #if($!{accrualTypePage.frequencyType} != "1")
        <tr id="accruedDailyDateTr">
##            计提日
            <td class="textRight">#springMessage('accrued.daily.date')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-name="accruedDailyDate" data-type="select"
                         data-biz-name="accruedDailyDate"
                        #if($!{accrualTypePage.frequencyType} == "2")
                         data-group="accrued.week"
                        #elseif($!{accrualTypePage.frequencyType} == "3")
                         data-group="bisGatherPolicy.month"
                        #else
                         data-group="bisGatherPolicy.month"
                        #end
                         data-value="$!{accrualTypePage.accruedDailyDate}"
                         data-required="true"></div>
                </div>
            </td>
        </tr>
        #end
        <tr>
            <td class="textRight">#springMessage('table.accrual.validSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="1"
                     data-name="validSign" data-biz-name="validSign"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.accrual.rmk')</td>
            <td>
                <textarea placeholder="#springMessage('table.accrual.rmk')" lay-verify="strlength" data-maxlength="40"
                          class="layui-textarea" id="rmk" name="rmk"></textarea>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/accrualtype/accrualType.add.js?_btv=${resourceVersion}"></script>
</html>

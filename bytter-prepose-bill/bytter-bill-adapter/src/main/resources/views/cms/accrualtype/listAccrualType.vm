<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>

<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.accrual.accrualCode')</td>
            <td width="40%">
                <input type="text" name="likes_accrualCode"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.accrual.accrualCode')">
            </td>
            <td class="textRight">#springMessage('table.accrual.accrualName')</td>
            <td width="40%">
                <input type="text" name="likes_accrualName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.accrual.accrualName')">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.accrual.accrualCode')</th>
        <th>#springMessage('table.accrual.accrualName')</th>
        <th>#springMessage('table.accrual.rmk')</th>
        <th>#springMessage('table.accrual.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/accrualtype/accrualType.list.js?_btv=${resourceVersion}"></script>
</html>

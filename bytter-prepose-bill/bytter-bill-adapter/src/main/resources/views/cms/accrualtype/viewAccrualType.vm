<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="40%">#springMessage('table.accrual.accrualCode')</td>
            <td>
                $!{accrualTypePage.accrualCode}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.accrual.accrualName')</td>
            <td>
                $!{accrualTypePage.accrualName}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.accrual.frequency')</td>
            <td>
                #if($!{accrualTypePage.frequencyType} == "4")
                    $dictTag.get("accrual.seasonCycle",$!{accrualTypePage.frequency})
                    #else
                    $!{accrualTypePage.frequencyDailyDate}
                    $dictTag.get("accrual.dateType",$!{accrualTypePage.frequencyType})
                #end
            </td>
        </tr>
            #if($!{accrualTypePage.frequencyType} != "1")
            <tr id="accruedDailyDateTr">
                ##            计提日
                <td class="textRight">#springMessage('accrued.daily.date')</td>
                <td>
                    <div class="layui-inline">
                        #if($!{accrualTypePage.frequencyType} == "2")
                            $dictTag.get("accrued.week",$!{accrualTypePage.accruedDailyDate})
                        #else
                            $dictTag.get("bisGatherPolicy.month",$!{accrualTypePage.accruedDailyDate})
                        #end
                    </div>
                </td>
            </tr>
            #end
        <tr>
            <td class="textRight">#springMessage('table.accrual.validSign')</td>
            <td>
                $dictTag.get("valid_sign",$!{accrualTypePage.validSign})
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.accrual.rmk')</td>
            <td>
                $!{accrualTypePage.rmk}
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

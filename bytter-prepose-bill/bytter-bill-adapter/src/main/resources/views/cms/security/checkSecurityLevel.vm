<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    #set ($selectableSignRepayDate = "" )  ##所选计划的还款日期
<div>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th width="15%">#springMessage('cms.security.level')</th>##层级
            <th width="20%">#springMessage('cms.security.productName')</th>##产品名称
            <th width="20%">#springMessage('cms.security.expectIssSize')</th>##预计发行规模
            <th width="15%">#springMessage('cms.security.sizeOf')</th>##规模占比%
            <th width="15%">#springMessage('cms.security.limit')</th>##期限（年）
            <th>#springMessage('common.table.thead.operation')</th>

        </tr>
        </thead>
        <tbody>
            #foreach($levelInfo in $levelInfoVOS)
                #set($vcount = $velocityCount - 1)
            <tr data-row="$!{vcount}">

                <td width="15%" align="center">
                    $!{levelInfo.levelName}
                </td>

                <td width="20%" align="center">##产品名称
                   $!{levelInfo.productName}
                </td>

                <td width="20%" align="center">##预计发行规模
                    $number.formatNumeric($!{levelInfo.expectIssSize})
                </td>
                <td width="15%" align="center" >
                    $!{levelInfo.sizeOf}</td>##规模占比
                <td width="15%" align="center">##期限
                   $!{levelInfo.timeLimit}
                </td>
                <td>
                    <a class="" href="#" data-row="'+meta.row+'" onclick="chose(' $!{levelInfo.levelName}',' $!{levelInfo.productName}','$number.formatNumeric($!{levelInfo.expectIssSize})')">#springMessage('选择')</a>
                </td>
            </tr>
            #end
        </tbody>
    </table>

</div>
<div style="text-align: center;">
    <button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>
</div>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['jquery',"form",'bttable','moneyType'], function() {
        var $ = bt.jquery;
        moneyFun = bt.moneyType.getFun();
    });
    function chose(levelName,productName,money){
        var webObj = bt.navtab.getParentDom();
        webObj.setSelectData(levelName,productName,money);
        bt.navtab.closeCurrent();
    }

</script>
</html>

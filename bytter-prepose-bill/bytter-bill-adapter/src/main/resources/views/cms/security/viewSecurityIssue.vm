<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{Issue.id}">


    ##资产证券化发行主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsSecurity.issue.mainMessage')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##证券发行编号
                        <td class="textRight" >#springMessage('cms.security.securityIssueCode')</td>
                        <td >
                            $!{Issue.securityIssueCode}
                        </td>
                        ##批次
                        <td class="textRight">#springMessage('table.cmsBond.batchNo')</td>
                        <td>
                            $!{Issue.batchNo}
                        </td>
                    </tr>
                    <tr>
                        ##层级
                        <td class="textRight" >#springMessage('cms.security.level')</td>
                         <td>$!{Issue.levelName}</td>
                        ##产品名称
                        <td class="textRight">#springMessage('cms.security.productName')</td>
                        <td>
                            <div class="layui-inline">
                               $!{Issue.productName}
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##发行金额
                        <td class="textRight" >#springMessage('cms.security.issueMoney')</td>
                        <td id="issueMoney0">
                            $!number.formatNumeric($!{Issue.issueMoney})
                        </td>
                        ##面值
                        <td class="textRight">#springMessage('cms.security.faceValue')</td>
                        <td>
                            $!number.formatNumeric($!{Issue.faceValue})
                        </td>
                    </tr>
                    <tr>
                        ## 发行价格
                        <td class="textRight">#springMessage('cms.security.issuePrice')</td>
                        <td>
                            $!number.formatNumeric($!{Issue.issuePrice})
                        </td>
                        ## 本次发行金额
                        <td class="textRight">#springMessage('cms.security.thisIssueMoney')</td>
                        <td>
                            $!number.formatNumeric($!{Issue.thisIssueMoney})
                        </td>
                    </tr>

                    <tr>
                        ##发行日期
                        <td class="textRight">#springMessage('cms.security.issueDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{Issue.issueDate})
                        </td>
                        ##本次发行折合人民币金额
                        <td class="textRight">#springMessage('cms.security.issueRmbMoney')</td>
                        <td>
                            $!number.formatNumeric($!{Issue.issueRmbMoney})
                        </td>
                    </tr>
                    <tr>
                        ##预期到期日
                        <td class="textRight">#springMessage('cms.security.expectEndDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{Issue.expectEndDate})
                        </td>
                        ##法定到期日
                        <td class="textRight">#springMessage('cms.security.legalEndDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{Issue.legalEndDate})
                        </td>
                    </tr>
                    <tr>
                        ##期限(年）
                        <td class="textRight">#springMessage('cms.security.limit')</td>
                        <td >
                            $!{Issue.timeLimit}
                        </td>
                        ##还款方式
                        <td class="textRight" >#springMessage('table.cmsLoanRepay.repayway')</td>
                        <td>
                            $!dictTag.get("Provide.RepayType",$!{Issue.repayType})
                        </td>
                    </tr>
                    <tr>
                        ##发行方式
                        <td class="textRight" >#springMessage('cms.security.issueWay')</td>
                        <td>
                            $!dictTag.get("cms.security.issue.issueWay",$!{Issue.issueWay})
                        </td>
                        ##发行市场
                        <td class="textRight">#springMessage('cms.security.issueMarket')</td>
                        <td>
                           $!{Issue.issueMarket}
                        </td>
                    </tr>
                    <tr>
                        ##出表比例
                        <td class="textRight">#springMessage('cms.security.tablePortion')</td>
                        <td>
                            $!rateTag.show($!{Issue.tablePortion})
                        </td>
                        ##信用评级
                        <td class="textRight">#springMessage('cms.security.creditRating')</td>
                        <td>
                            $!{Issue.creditRating}
                        </td>
                    </tr>
                    <tr>
                        ##主承销商
                        <td class="textRight">#springMessage('table.cmsBond.leadUnderwriter')</td>
                        <td>
                            $!{Issue.underwriter}
                        </td>
                        ##信用评级机构
                        <td class="textRight">#springMessage('cms.security.creditRatingIns')</td>
                        <td>
                            $!{Issue.creditRatingIns}
                        </td>

                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                        <td colspan="3">
                            $!{Issue.rmk}
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    ##资产证券化利率信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsSecurity.rateMessage')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##息票类型
                        <td class="textRight" >#springMessage('cms.security.couponType')</td>
                        <td width="23%">
                            $!dictTag.get("cms.security.issue.couponType",$!{Issue.couponType})
                        </td>
                        ##浮动/固定
                        <td class="textRight" >#springMessage('table.cmdBond.isFloat')</td>
                        <td>
                            $!dictTag.get("CMS_BOND_FLOAT_TYPE",$!{Issue.isFloat})
                        </td>
                    </tr>
                    <tr>
                        ##票面利率
                        <td class="textRight">#springMessage('df.coupon.rate')</td>
                        <td >
                            $!rateTag.show($!{Issue.parRate})
                        </td>
                        ##利息年度天数
                        <td class="textRight">#springMessage('table.cmsBond.interestYearDays')</td>
                        <td style="width: 35%">
                            $!dictTag.get("Cms.RateBase",$!{Issue.rateBase})
                        </td>
                    </tr>
                    <tr>
                        ##起息日
                        <td class="textRight">#springMessage('cms.security.startDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{Issue.startDate})
                        </td>
                        ##利息分配方式
                        <td class="textRight">#springMessage('table.cmsBond.assignType')</td>
                        <td>
                            $!dictTag.get("cms.security.issue.assignType",$!{Issue.interestWay})
                        </td>
                    </tr>
                    <tr>
                        ##付息频率
                        <td class="textRight">#springMessage('table.cmsLease.interestFre')</td>
                        <td>
                            $!dictTag.get("CMS_BOND_PAY_FREQUENCY",$!{Issue.interestFre})
                        </td>
                        ##首次付息日
                        <td class="textRight">#springMessage('cms.security.beginPayinterestDate')</td>
                        <td>
                       $!date.format('yyyy-MM-dd',$!{Issue.beginPayinterestDate})
                        </td>
                    </tr>
                    <tr>
                        ##本金支付频率
                        <td class="textRight">#springMessage('cms.security.paymoneyFre')</td>
                        <td>
                            $!dictTag.get("CMS_BOND_PAY_FREQUENCY",$!{Issue.paymoneyFre})
                        </td>
                        ##首次本金支付日
                        <td class="textRight">#springMessage('cms.security.beginPaymoneyDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{Issue.beginPaymoneyDate})
                        </td>
                    </tr>
                    <tr>
                        ##定价基准
                        <td class="textRight">#springMessage('table.cmsBond.fixPriceBase')</td>
                        <td>
                            $!{tbBaseRate.baseTypeName}
                        </td>
                        ##利率期限
                        <td class="textRight">#springMessage('table.cmsLease.repayCycle')</td>
                        <td>
                            $!{tbCreditPeriod.periodName}
                        </td>
                    </tr>
                    <tr>
                        ##报价日期
                        <td class="textRight">#springMessage('table.cmsBond.quoteDate')</td>
                        <td>
                           $!date.format('yyyy-MM-dd',$!{Issue.quoDate})
                        </td>
                        ##基准利差(%/BP)
                        <td class="textRight">#springMessage('cms.security.pointsProportionText')</td>
                        <td >
                            $!rateTag.show($!{Issue.pointsProportionText})
                        </td>
                    </tr>

                    <tr>
                        ##首次基准利率
                        <td class="textRight">#springMessage('cms.security.baseRate')</td>
                        <td >
                            $!rateTag.show($!{Issue.baseRate})
                        </td>
                        ##利率上限
                        <td class="textRight">#springMessage('table.tbLoanRateMaintence.rateUpLimit')</td>
                        <td >
                            $!rateTag.show($!{Issue.upperRate})
                        </td>
                    </tr>
                    <tr>
                        ##利率下限
                        <td class="textRight">#springMessage('cms.security.lowestRate')</td>
                        <td >
                            $!rateTag.show($!{Issue.lowestRate})
                        </td>
                        ##备注
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                        <td >
                            $!{Issue.rateRmk}
                        </td>
                    </tr>
                    <tr>
                        ##基准利率确定规则
                        <td class="textRight">#springMessage('cms.security.baseRateRules')</td>
                        <td colspan="3">
                            $!{Issue.baseRateRules}
                        </td>
                    </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>
    ## 第三方费用信息
    <table class="layui-table">
        <thead>
        <tr><td colspan="4" align="center"><strong>#springMessage('table.cmsProvideLoan.chargeMessage')</strong></td></tr>
        </thead>
        <colgroup>
            <col width="15%">
            <col width="35%">
            <col width="15%">
            <col width="35%">
        </colgroup>
        <tbody>
        <tr>
            <td colspan="4" align="center" width="80">
                <table id="dataTable" class="layui-table">
                    <thead>
                    <th width="25%">#springMessage('table.fcChargeRule.fcChargeType')</th>##费用类型
                    <th width="25%"> #springMessage('table.guaGuarantee.handleRate')</th>##费率
                    <th width="25%">#springMessage('table.cms.projected.expemditure')</th>##预计费用
                    </thead>
                    <tbody>
                        #if($costVOS.size() > 0)
                            #foreach($detail in $!{costVOS})
                                #set($vcount = $velocityCount - 1)
                                #set($velocityCount = $costVOS.size() - 1)
                            <tr>
                                <td align="center">
                                    <input type="text" style="text-align: center;" value="$!{detail.costName}" disabled="true" class="layui-input">
                                </td>

                                <td align="center">##费率
                                    <input type="text" style="text-align: right;" value="$!rateTag.show($!{detail.rate})" disabled="true" class="layui-input">
                                </td>

                                <td align="center">##预计费用
                                    <input type="text" style="text-align: right;"  value="$!number.formatNumeric($!{detail.advanceFees})" disabled="true" class="layui-input">
                                </td>

                            </tr>
                            #end
                        #end
                    </tbody>
                </table>
            </td>
        </tr>
        <tbody>
    </table>
    ##其他业务挂接信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.otherBusMessage')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <tbody>

                        #if(${Issue.isHookBond}=="1")
                            ##增加保证金相关信息
                        <h2 class="layui-colla-title">#springMessage('table.fcBond.BondMsg')</h2>
                            #set($fcBondApplyDTO=$fcBondTag.getBondApplyDetail(${Issue.id},${Issue.securityIssueCode}))
                            #set($fcBondRate=($!{Issue.bondRate}))
                            #set($fromType='security')
                            #parse("views/common/viewFcBondDetail.vm")
                        #end


                        ##担保挂接
                        #if(${Issue.isHangGuarantee}=="1")
                        <h2 class="layui-colla-title">#springMessage('table.guaContract.ContractMsg')</h2>
                            #set($guaContractUseDTO=$guaContractTag.getGuaContractOccupyDetail($!{Issue.id},$!{Issue.securityIssueCode}))
                            #if($!{guaContractUseDTO})
                                #parse("views/common/guaContractDetail.vm")
                            #end
                        #end
                        ##抵质押物挂接
                        #if(${Issue.isRelatePledge}=="1")
                        <h2 class="layui-colla-title">#springMessage('table.cmsLease.guaPledgeTag')</h2>
                            #set($pledgeList=$guaPledgeTag.getPledgeOccupy($!{Issue.id},$!{Issue.securityIssueCode}))
                            #if($!{pledgeList})
                                #parse("views/cms/guarantee/viewPledgeList.vm")
                            #end
                        #end

                    <tr>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input id="annexName" name="uploadId" type="hidden" value="$!{Issue.uploadId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </div>
    <!-- 日志 -->
    #if(!$!{taskId})
        <div id="tagMsg"></div>
        <table class="layui-table">
            <tr>
                <td colspan="4" align="center">
                    <button class="layui-btn"  onClick="doClose()">#springMessage('common.button.close')</button>
                    #if($!{Issue.status} eq '0'||$!{Issue.status} eq '11'||$!{Issue.status} eq '-1')##待审批和审批打回时可查看审批流程
                        <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{Issue.id}')">#springMessage('common.button.trackFlow')</button>
                    #end
                </td>
            </tr>
        </table>
    #end
</form>

    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form','btUpload','moneyType'], function() {
        $ = bt.jquery,form = bt.form();
        bt.moneyType.init();
        var gid = $("#annexName").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gid
        });


        //关闭窗口
        doClose = function(){
            if(bt.navtab){
                bt.navtab.closeCurrent();
            }
        };

        /**
         * 生成日志列表
         * @return
         */
            $genMsgHtml = function () {
            var billCode = $("#id").val();
            var url = basePath + "/cms/basedata/cmsprocessmsg/list/" + billCode;
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                    form.render();
                }
            });
        }
            $genMsgHtml();
    });
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
    <input type="hidden" id="id" name="id" value="$!{info.id}">
    ##资产证券化主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsSecurity.mainMessage')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##资产证券化类型
                        <td class="textRight">#springMessage('cms.security.securityType')</td>
                        <td >
                           $!{info.securityTypeName}
                        </td>
                        ##境内境外
                        <td class="textRight">#springMessage('table.cmsLease.isDomestic')</td>
                        <td>
                            $!dictTag.get("btBankAcc.isDomesticBank",$!{info.isdomestic})
                        </td>
                    </tr>
                    <tr>
                        ##原始权益人
                        <td class="textRight" >#springMessage('cms.security.intrest')</td>
                        <td width="25%">
                            $!{info.corpName}
                        </td>
                        ##实际融资人
                        <td class="textRight" >#springMessage('cms.security.financier')</td>
                        <td >
                            $!{info.financier}
                        </td>
                    </tr>
                    <tr>
                        ##证券代码
                        <td class="textRight" >#springMessage('cms.security.securityCode')</td>
                        <td >
                            $!{info.securityCode}
                        </td>
                        ##证券简称
                        <td class="textRight" >#springMessage('cms.security.securitySname')</td>
                        <td >
                            $!{info.securitySname}
                        </td>
                    </tr>
                    <tr>
                        ##证券名称
                        <td class="textRight" >#springMessage('cms.security.securityName')</td>
                        <td>$!{info.securityName}</td>
                    </tr>
                    <tr>
                        ##批准文号
                        <td class="textRight" >#springMessage('cms.security.approvalNumber')</td>
                        <td >
                            $!{info.approvalNumber}
                        </td>
                        ##受托机构
                        <td class="textRight" >#springMessage('cms.security.trustee')</td>
                        <td >
                            $!{info.trustee}
                        </td>
                    </tr>
                    <tr>
                        ##基础资产类型
                        <td class="textRight">#springMessage('cms.security.assetType')</td>
                        <td>
                            <div class="layui-inline">
                                $!{info.assetTypeName}
                            </div>
                        </td>
                        ##证券原币币种
                        <td class="textRight">#springMessage('cms.security.curId')</td>
                        <td>
                            $!{info.curName}
                        </td>
                    </tr>
                    <tr>
                        ## 计划发行原币总额
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsBond.issueCurTotal')</td>
                        <td>
                            $number.formatNumeric($!{info.money})
                        </td>
                        ## 计划发行人民币总额
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsBond.issueRmbTotal')</td>
                        <td>
                            $number.formatNumeric($!{info.rmbMoney})
                        </td>
                    </tr>
                    <tr>
                        ##增信措施
                        <td class="textRight" >#springMessage('cms.security.measures')</td>
                        <td >
                           $!{info.measures}
                        </td>

                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                        <td colspan="3">
                                $!{info.rmk}
                        </td>
                    </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>
    ##资产分层信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsSecurity.levelMessage')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        <td align="center" width="80%">
                            ##新加的
                            <table id="dataTable" class="layui-table">
                                <thead>
                                <th width="15%">#springMessage('cms.security.level')</th>##层级
                                <th width="20%">#springMessage('cms.security.productName')</th>##产品名称
                                <th width="20%">#springMessage('cms.security.expectIssSize')</th>##预计发行规模
                                <th width="15%">#springMessage('cms.security.sizeOf')</th>##规模占比%
                                <th width="15%">#springMessage('cms.security.limit')</th>##期限（年）
                                </thead>
                                <tbody>
                                    #foreach($levelInfo in $levelInfoVOList)
                                        #set($vcount = $velocityCount - 1)
                                    <tr data-row="$!{vcount}">

                                        <td width="15%" align="center">
                                            <input type="text"  value="$!{levelInfo.levelName}" disabled="true" class="layui-input">
                                        </td>

                                        <td width="20%" align="center">##产品名称
                                            <input type="text" class="layui-input" value="$!{levelInfo.productName}" disabled>
                                        </td>

                                        <td width="20%" align="center">##预计发行规模
                                            <input type="text" id="expectIssSize$!{vcount}" data-name="levelVOList[$!{vcount}].expectIssSize"
                                                   data-biz-name="levelVOList[$!{vcount}]expectIssSize"  lay-verify="required"
                                                   autocomplete="off" class="layui-input bt-biz-moneyType ignore-required-icon" value="$!{levelInfo.expectIssSize}" disabled>
                                        </td>
                                        <td width="15%" align="center" id="total$!{vcount}">
                                            $!{levelInfo.sizeOf}</td>##规模占比
                                        <td width="15%" align="center">##期限
                                            <input type="text" id="timeLimit$!{vcount}" data-name="levelVOList[$!{vcount}].timeLimit" data-decimal="2" data-biz-name="levelVOList[$!{vcount}]timeLimit"
                                                   autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{levelInfo.timeLimit}" disabled>
                                        </td>

                                    </tr>
                                    #end
                                </tbody>
                            </table>
                        </td>
                    </tr>

                </table>
            </div>
        </div>
    </div>

    ##其他业务挂接信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.otherBusMessage')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td class="textRight">#springMessage('cms.loan.attachment')</td>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input id="attachmentId" name="attachmentId" type="hidden" value="$!{info.attachmentId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- 日志 -->
    #if(!$!{taskId})
        <div id="tagMsg"></div>
        <table class="layui-table">
            <tr>
                <td colspan="4" align="center">
                    <button class="layui-btn"  onClick="doClose()">#springMessage('common.button.close')</button>
                    #if($!{info.status} eq '0'||$!{info.status} eq '11'||$!{info.status} eq '-1')##待审批和审批打回时可查看审批流程
                        <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{info.id}')">#springMessage('common.button.trackFlow')</button>
                    #end
                </td>
            </tr>
        </table>
    #end

</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form','btUpload','moneyType'], function() {
        $ = bt.jquery,form = bt.form();
        bt.moneyType.init();
        var gid = $("#attachmentId").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gid
        });


        //关闭窗口
        doClose = function(){
            if(bt.navtab){
                bt.navtab.closeCurrent();
            }
        };

        /**
         * 生成日志列表
         * @return
         */
            $genMsgHtml = function () {
            var billCode = $("#id").val();
            var url = basePath + "/cms/basedata/cmsprocessmsg/list/" + billCode;
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                    form.render();
                }
            });
        }
            $genMsgHtml();
    });
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #collaTable .layui-input {
            width: 100%;
        }
     </style>
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <input type="hidden" id="infoId" value="$!{infoId}">
    <table class="layui-table">
        <tbody>
        <tr>
            ##证券发行编号
            <td class="textRight" >#springMessage('cms.security.securityIssueCode')</td>
            <td width="25%">
                <input type="text"  id="securityIssueCode" autocomplete="off"
                       class="layui-input"/>
            </td>
            ##层级
            <td class="textRight" >#springMessage('cms.security.level')</td>
            <td width="25%">
                <input type="text"  id="levelName" autocomplete="off"
                       class="layui-input"/>
            </td>
        </tr>
        <tr>
            ##还款日期
            <td class="textRight">#springMessage('table.cmsLoanRepay.repayDate')</td>
            <td width="25%">
                <input type="text" name="ged_repayDate" data-biz-name="ged_repayDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_repayDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_repayDate" data-biz-name="led_repayDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" id="led_repayDate">
            </td>
            ##产品
            <td class="textRight" >#springMessage('cms.security.productName')</td>
            <td width="25%">
                <input type="text"  id="productName" autocomplete="off"
                       class="layui-input"/>
            </td>
        </tr>

        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" onclick="search()" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>

<div class="layui-collapse">
    <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('table.cmsEquity.detail')</h2>
        <div class="layui-colla-content layui-show" style="margin-bottom: 10px;overflow-x: auto;">
            <br>
            <table id="appTable" class="layui-table self-adaption" style="width:100%;">
                <thead>
                <tr>
                    <th>#springMessage('cms.security.securityIssueCode')</th>
                    <th>#springMessage('cms.security.level')</th>
                    <th>#springMessage('cms.security.productName')</th>
                    <th>#springMessage('table.cmsLoanRepay.repayDate')</th>
                    <th>#springMessage('cms.security.planRepayDate')</th>
                    <th>#springMessage('table.createRepayPlan.repaymentMoney')</th>
                    <th>#springMessage('cms.security.surerate')</th>
                    <th>#springMessage('table.cmsLoanRepay.repayAccrual')</th>
                    <th>#springMessage('table.cmsLoanRepay.repayMoney')</th>
                    <th>#springMessage('table.cmsBond.remainMoney')</th>
                    <th>#springMessage('table.createRepayPlan.isRepay')</th>
                    <th>#springMessage('table.btBankAcc.rmk')</th>
                    <th>#springMessage('table.fcFreeze.status')</th>
                    <th>#springMessage('common.table.thead.operation')</th>
                </tr>
                </thead>
                <tbody id="collaTable">
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="layui-collapse">
    <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('table.cmsEquity.detail')</h2>
        <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
            <br>
            <table id="appTable1" class="layui-table self-adaption" style="width:100%;">
                <thead>
                <tr>
                    <th>#springMessage('cms.security.securityIssueCode')</th>
                    <th>#springMessage('cms.security.level')</th>
                    <th>#springMessage('cms.security.productName')</th>
                    <th>#springMessage('table.cmsLoanRepay.repayDate')</th>
                    <th>#springMessage('cms.security.planRepayDate')</th>
                    <th>#springMessage('table.createRepayPlan.repaymentMoney')</th>
                    <th>#springMessage('cms.security.surerate')</th>
                    <th>#springMessage('table.cmsLoanRepay.repayAccrual')</th>
                    <th>#springMessage('table.cmsLoanRepay.repayMoney')</th>
                    <th>#springMessage('table.cmsBond.remainMoney')</th>
                    <th>#springMessage('table.createRepayPlan.isRepay')</th>
                    <th>#springMessage('table.btBankAcc.rmk')</th>
                    <th>#springMessage('common.table.thead.operation')</th>
                </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<div class="layui-form-item layui-form-submit">
    <div class="layui-input-block">
        <button class="layui-btn layui-btn-small" lay-submit="" lay-filter="save">#springMessage('common.button.save')</button>
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/security/securityRepaySure.add.js?_btv=${resourceVersion}"></script>
</body>
</html>

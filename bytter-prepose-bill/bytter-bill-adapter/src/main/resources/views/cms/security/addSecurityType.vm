<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="myform">
    <table id="appTable" class="layui-table layui-form">
        <tr>
            ##类别编码
            <td class="textRight" style="width: 40%">#springMessage('table.Security.typeCode')</td>
            <td style="width: 60%">
                <div class="layui-input-inline">
                    <input type="text" id="typeCode" name="typeCode" maxlength="32" lay-verify="required|strlength" data-maxlength="32" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            ##类别名称
            <td class="textRight">#springMessage('table.Security.typeName')</td>
            <td>
                <input type="text" name="typeName"  maxlength="32" lay-verify="required|strlength" data-maxlength="32" class="layui-input">
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.cmsLoanRepay.rmk')</td>
            <td>
                <input type="text" name="rmk" class="layui-input"  maxlength="200" lay-verify="strlength" data-maxlength="200">
            </td>
        </tr>
        <tr>
            <td colspan="2"style="text-align: center">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    var dicts,form;
    bt.use(["jquery","dicts"], function () {
        $ = bt.jquery;
        form = bt.form();
        dicts = bt.dicts.init();

        //监听提交
        form.on("submit(submit)", function(data){
            var action = "/cms/security/type/save";
            bt.loading.show();
            $.post(basePath + action,data.field,function(data){
                parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                if (data.success) {
                    if (!bt.navtab) {
                        bt.navtab.refreshParentTable();
                    } else {
                        bt.navtab.closeCurrent();
                        bt.navtab.refreshCurrent();
                    }
                } else {
                    bt.loading.hide();
                }
            },'JSON');
            return false;
        });

        //这里填写新的js代码，请参考前端文档
    });
    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
            bt.navtab.refreshCurrent();
        }
    }
</script>
</body>
</html>

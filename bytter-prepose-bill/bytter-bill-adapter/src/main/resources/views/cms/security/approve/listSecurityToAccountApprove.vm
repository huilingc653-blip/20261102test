<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
    <table class="layui-table">
        <tbody>
        <tr>
            ##资产证券化发行编号
            <td class="textRight" >#springMessage('资产证券化发行编号')</td>
            <td >
                <input type="text"  name="likes_securityIssueCode" autocomplete="off"
                       class="layui-input"/>
            </td>

        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('cms.security.toAccountDate')</th>##到账日期
        <th>#springMessage('cms.security.toAccountMoney')</th>##本次到账金额
        <th>#springMessage('table.nisBillhead.payeeAcc')</th>##收款账号
        <th>#springMessage('table.cmsEquity.accName')</th>##账户名称
        <th>#springMessage('table.cmsEquity.bankName')</th>##开户行名称
        <th>#springMessage('table.cmsEquity.rmk')</th>##备注
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
<script>
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts", "corp","dateType"], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        selectType = bt.selectType.init();
        bt.dateType.init();//日期时间
        bt.moneyType.init();
        corp = bt.corp.init();//单位

        /**
         * 生成列表
         */
        datatable = bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            checkbox: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search",
                isInitData:"false"
            },
            ajax: {
                'url': basePath + "/cms/security/toAccount/dataTableApprove"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            fixedColumns: {
                rightColumns: 2//代表冻结右边一列
            },
            columns: [
                {data:"toAccountDate",className:"center",render:function ( data, type, full, meta ){
                            return bt.date.format(full.toAccountDate,'yyyy-mm-dd');
                    }},
                {data:"toAccountMoney",className:"textRight",render: function ( data, type, full, meta ){
                        return bt.money.format(full.toAccountMoney);
                    }},
                {data:"payee",className:"center",bSortable: true},
                {data:"accName",className:"center",bSortable: true},
                {data:"bankName",className:"center",bSortable: true},
                {data:"rmk",className:"center",bSortable: true},
                {data:null,bSortable:false,className:'center',
                    render: function (data, type, full, meta) {
                        var html='';
                        if($("#flowStatus").val()=='todo'){
                            html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
                        }
                        html += '<a class="" href="#" data-row="'+meta.row+'" onclick="bt.workFlow.trackFlow(\''+full.processInstanceId+'\')">'+bt.lang("common.button.trackFlow")+'</a>';
                        return html;
                    }
                }
            ]
        });
    });

    /*审核*/
    function approve(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.approve') ,basePath + "/cms/security/toAccount/approve?businessId=" + data.id + "&taskId=" + data.taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/security/toAccount/approve?businessId=" + data.id + "&taskId=" + data.taskId
        });
    }



</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

    <style>
        #collaTable .layui-input {
            width: 100%;
        }
        #collaTable2 .layui-input {
            width: 60%;
        }
        #collaTable2 td {
            border: none;
        }
        #collaTable2 .layui-input,.rateWrap,td
        {
            border: none;
        }
    </style>

</head>
<body>

<div class="layui-collapse">
    <form class="layui-form" method="post">
        <input type="hidden" id="id" name="id" value="$!{planId}">
        <input type="hidden" id="corpId" name="corpId" value="$!{corpId}">
        <input type="hidden" id="issueMoney" name="issueMoney" value="$!{issueMoney}">
        <input type="hidden" id="securityIssueCode" name="securityIssueCode" value="$!{securityIssueCode}">
        <input type="hidden" id="isPass" name="isPass" value="$!{isPass}">
        ##计划明细
        <div class="layui-collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('cms.equity.planDetail')</h2>
                <div class="layui-colla-content  layui-show" >
                    <br>
                    <table class="layui-table self-adaption ignore-required-icon" id="planDetailTB" style="width:100%; margin-bottom:8px;margin-top: 8px;">
                        <thead>
                        <tr>
                            <th>#springMessage('cms.security.securityIssueCode')</th>##证券发行编号
                            <th><span style="color:red">*</span>#springMessage('table.cmsLoanSend.repayDate')</th>##还款日期
                            <th><span style="color:red">*</span>#springMessage('cms.security.planRepayDate')</th>##计划还款日期
                            <th><span style="color:red">*</span>#springMessage('table.createRepayPlan.repaymentMoney')</th>##还款本金
                            <th><span style="color:red">*</span>#springMessage('table.cmsLoanRepay.repayAccrual')</th>##还款利息
                            <th><span style="color:red">*</span>#springMessage('table.cmsLoanRepay.repayMoney')</th>##还款金额
                            <th>#springMessage('table.cmsBond.remainMoney')</th>##剩余本金
                            <th>#springMessage('table.createRepayPlan.isRepay')</th>##是否已还
                            <th>#springMessage('cms.equity.rmk')</th>##备注
                            <th>#springMessage('common.table.thead.operation')</th>##操作
                        </tr>
                        </thead>
                        <tbody id="collaTable">
                        </tbody>
                        <tfoot>
                            ##合计行
                        <tr id="collaTable2" >
                            <td align="center">#springMessage('table.interet.sum')</td>
                            <td></td>
                            <td></td>
                            <td align="right">##本次还款本金合计
                                <input type="text" id="repayMoneySum" data-name="repayMoneySum" data-biz-name="repayMoneySum" readonly="readonly" data-decimal="2"
                                       autocomplete="off" class="layui-input bt-biz-moneyType">
                            </td>
                            <td align="right">##本次还款利息合计
                                <input type="text" id="repayInterestSum" data-name="repayInterestSum" data-biz-name="repayInterestSum" readonly="readonly" data-decimal="2"
                                       autocomplete="off" class="layui-input bt-biz-moneyType">
                            </td>
                            <td align="right">##本次还款金额合计
                                <input type="text" id="repayAmountSum" data-name="repayAmountSum" data-biz-name="repayAmountSum" readonly="readonly" data-decimal="2"
                                       autocomplete="off" class="layui-input bt-biz-moneyType">
                            </td>
                            <td >&nbsp;</td>
                            <td >&nbsp;</td>
                            <td >&nbsp;</td>
                            <td >&nbsp;</td>
                        </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <div class="layui-form-item layui-form-submit">
            <div class="layui-input-block">
                <button class="layui-btn layui-btn-small" lay-submit="" lay-filter="save">#springMessage('common.button.save')</button>
                <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
            </div>
        </div>
    </form>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/security/CommonPlanFunction.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/security/securityPlanDetail.add.js?_btv=${resourceVersion}"></script>
</html>

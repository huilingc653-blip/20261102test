<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .import-tablecss .dt-buttons {
            display: none!important;
        }
        .import_excel_common .layui-tab-content {
            padding-top: 10px!important;
        }
    </style>
</head>
<body>

<form class="layui-form" method="post">
    ##资产证券化主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsSecurity.mainMessage')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##资产证券化类型
                        <td class="textRight">#springMessage('cms.security.securityType')</td>
                        <td >
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="securityTypeId" data-biz-name="securityTypeId" data-inputValue="false"
                                     data-url="${basePath}/cms/security/type/listCmsSecurityType" data-valuefield="id"
                                     data-textfield="typeName" data-required="true"></div>
                            </div>
                        </td>
                        ##境内境外
                        <td class="textRight">#springMessage('table.cmsLease.isDomestic')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="btBankAcc.isDomesticBank"
                                 data-required="true"
                                 data-defaultvalue="1" data-name="isdomestic"
                                 data-biz-name="isdomestic"></div>
                        </td>
                    </tr>
                    <tr>
                        ##原始权益人
                        <td class="textRight" >#springMessage('cms.security.intrest')</td>
                        <td width="25%">
                            <div class="layui-inline">
                                <div class="bt-biz-corp" data-type="selectTree" data-required="true"
                                     data-biz-name="corpId" data-name="corpId" data-resource="cms:security:info:query" data-scope="all"></div>
                            </div>
                        </td>
                        ##实际融资人
                        <td class="textRight" >#springMessage('cms.security.financier')</td>
                        <td >
                            <input type="text"  name="financier" maxlength="100" data-maxlength="100" autocomplete="off" class="layui-input" lay-verify="strlength"/>
                        </td>
                    </tr>
                    <tr>
                        ##证券代码
                        <td class="textRight" >#springMessage('cms.security.securityCode')</td>
                        <td >
                            <input type="text"  name="securityCode" maxlength="32" data-maxlength="32" autocomplete="off"
                                   class="layui-input" lay-verify="required|strlength"/>
                        </td>
                        ##证券简称
                        <td class="textRight" >#springMessage('cms.security.securitySname')</td>
                        <td >
                            <input type="text" name="securitySname" maxlength="100" data-maxlength="100" autocomplete="off" class="layui-input" lay-verify="strlength"/>
                        </td>
                    </tr>
                    <tr>
                        ##证券名称
                        <td class="textRight" >#springMessage('cms.security.securityName')</td>
                        <td>  <input type="text" name="securityName" maxlength="100" data-maxlength="100" autocomplete="off" class="layui-input" lay-verify="required|strlength"/></td>
                    </tr>
                    <tr>
                        ##批准文号
                        <td class="textRight" >#springMessage('cms.security.approvalNumber')</td>
                        <td >
                            <input type="text" name="approvalNumber" maxlength="100" data-maxlength="100" autocomplete="off" class="layui-input" lay-verify="strlength"/>
                        </td>
                        ##受托机构
                        <td class="textRight" >#springMessage('cms.security.trustee')</td>
                        <td >
                            <input type="text" name="trustee" maxlength="150" data-maxlength="150" autocomplete="off" class="layui-input" lay-verify="required|strlength"/>
                        </td>
                    </tr>
                    <tr>
                        ##基础资产类型
                        <td class="textRight">#springMessage('cms.security.assetType')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="assetTypeCode" data-biz-name="assetTypeCode" data-inputValue="false"
                                     data-url="${basePath}/cms/security/assetType/listCmsSecurityAssetType" data-valuefield="assetTypeCode"
                                     data-textfield="assetTypeName" data-required="true"></div>
                            </div>
                        </td>
                        ##证券原币币种
                        <td class="textRight">#springMessage('cms.security.curId')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="curId"
                                     data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-callback="conver"
                                     data-textfield="curName" data-required="true" data-biz-name="curId"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 计划发行原币总额
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsBond.issueCurTotal')</td>
                        <td>
                            <input class="layui-input bt-biz-moneyType" data-maxlength="20" data-name="money"
                                   lay-verify="required|strlength" data-biz-name="money" data-callback="conver"
                                   data-decimal="2" data-minus="false" type="text">
                        </td>
                        ## 计划发行人民币总额
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsBond.issueRmbTotal')</td>
                        <td>
                            <input class="layui-input bt-biz-moneyType" data-maxlength="20" data-name="rmbMoney"
                                   lay-verify="required|strlength" data-biz-name="rmbMoney" disabled="true"
                                   data-decimal="2" data-minus="false" type="text">
                        </td>
                    </tr>
                    <tr>
                        ##增信措施
                        <td class="textRight" >#springMessage('cms.security.measures')</td>
                        <td >
                            <input type="text" name="measures" maxlength="100" data-maxlength="100" autocomplete="off" class="layui-input" lay-verify="strlength"/>
                        </td>

                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                        <td colspan="3">
                                <textarea type="text" id="rmk" name="rmk" class="layui-textarea" maxlength="200"
                                          placeholder="#springMessage('table.cmsProvideLoanInfo.rmk')"></textarea>
                        </td>
                    </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>
    ##资产分层信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsSecurity.levelMessage')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        <td width="80%">
                            <button type="button" class="layui-btn layui-btn-disabled" id="importLevelMessage">#springMessage('common.button.imports')</button>
                            ##新加的
                            <table id="dataTable" class="layui-table layui-table-border" style="margin-bottom: 10px;">
                                <thead>
                                <th width="15%"><span class="pl"><span class="required-icon">*</span></span>#springMessage('cms.security.level')</th>##层级
                                <th width="20%"><span class="pl"><span class="required-icon">*</span></span>#springMessage('cms.security.productName')</th>##产品名称
                                <th width="20%"><span class="pl"><span class="required-icon">*</span></span>#springMessage('cms.security.expectIssSize')</th>##预计发行规模
                                <th width="15%">#springMessage('cms.security.sizeOf')</th>##规模占比%
                                <th width="15%">#springMessage('cms.security.limit')</th>##期限（年）
                                <th width="15%">#springMessage('common.table.thead.operation')</th>##操作
                                </thead>
                                <tbody>
                                <tr data-row="0">
                                    <td width="15%" align="center">
                                        <div class="layui-inline">
                                            <div class="bt-biz-selectType ignore-required-icon" data-biz-name="levelVOList[0]levelId"
                                                 data-url="${basePath}/cms/security/level/listCmsSecurityLevel"
                                                 data-valuefield="id" data-textfield="levelName" id="levelId0"
                                                 data-name="levelVOList[0].levelId" data-search="true"
                                                 data-required="true" data-link="true">
                                            </div>
                                        </div>
                                    </td>

                                    <td width="20%" align="center">##产品名称
                                        <input type="text" id="productName0" name="levelVOList[0].productName" maxlength="100" data-maxlength="100"
                                               lay-verify="required|strlength" autocomplete="off" class="layui-input ignore-required-icon">
                                    </td>

                                    <td width="20%" align="center">##预计发行规模
                                        <input type="text" id="expectIssSize0" data-name="levelVOList[0].expectIssSize"
                                               data-biz-name="levelVOList[0]expectIssSize" data-callback="sizeof"
                                               lay-verify="required" autocomplete="off" class="layui-input bt-biz-moneyType ignore-required-icon">
                                    </td>
                                    <td width="15%" align="center" id="total0">

                                    </td>##规模占比
                                    <input type="hidden" id="sizeOf0" name="levelVOList[0].sizeOf" >
                                    <td width="15%" align="center">##期限
                                        <input type="text" id="timeLimit0" data-name="levelVOList[0].timeLimit" data-decimal="0" data-biz-name="levelVOList[0]timeLimit"
                                               autocomplete="off" class="layui-input bt-biz-moneyType">
                                    </td>
                                    <td width="15%" align="center">
                                        <a href="javascript:void(0);" title="#springMessage('common.addTr')"
                                           onClick="addTr()"><i class="layui-icon">&#xe654;</i></a>
                                    </td>
                                </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>

                </table>
            </div>
        </div>
    </div>

    ##其他业务挂接信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.otherBusMessage')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td class="textRight">#springMessage('cms.loan.attachment')</td>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input id="attachmentId" name="attachmentId" type="hidden" value="">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    <input type="hidden" name="status"/>
                    <tr>
                        <td style="text-align: center;" colspan="4">
                            <button class="layui-btn" lay-submit="" id="submit" value="11">#springMessage('common.button.submit')</button>
                            <button class="layui-btn" lay-submit="" id="temp" value="0">#springMessage('common.button.temp')</button>
                            <button type="button" onclick="resetCallback()" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/security/securityInfo.add.js?_btv=${resourceVersion}"></script>
</body>
</html>

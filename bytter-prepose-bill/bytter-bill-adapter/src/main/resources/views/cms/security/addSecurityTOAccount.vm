<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
    <input type="hidden" id="corpId" name="corpId" value="$!{info.corpId}">
    <input type="hidden" id="curId" name="curId" value="$!{info.curId}">
    ##发行到账确认信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('cms.security.toAaccount.message')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##证券发行编号
                        <td class="textRight" >#springMessage('cms.security.securityIssueCode')</td>
                        <td >
                            <input type="hidden" name="securityIssueCode" value="$!{Issue.securityIssueCode}">
                            $!{Issue.securityIssueCode}
                        </td>
                        ##批次
                        <td class="textRight">#springMessage('table.cmsBond.batchNo')</td>
                        <td>
                            $!{Issue.batchNo}
                        </td>
                    </tr>
                    <tr>
                        ##层级
                        <td class="textRight" >#springMessage('cms.security.level')</td>
                        <td>$!{Issue.levelName}</td>
                        ##产品名称
                        <td class="textRight">#springMessage('cms.security.productName')</td>
                        <td>
                            <div class="layui-inline">
                                $!{Issue.productName}
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##发行金额
                        <td class="textRight" >#springMessage('cms.security.issueMoney')</td>
                        <td id="issueMoney0">
                            $!number.formatNumeric($!{Issue.issueMoney})
                        </td>
                        ## 本次发行金额
                        <td class="textRight">#springMessage('cms.security.thisIssueMoney')</td>
                        <td>
                            $!number.formatNumeric($!{Issue.thisIssueMoney})
                        </td>
                    </tr>
                    <tr>
                        ##发行日期
                        <td class="textRight">#springMessage('cms.security.issueDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{Issue.issueDate})
                        </td>
                        ##本次发行折合人民币金额
                        <td class="textRight">#springMessage('cms.security.issueRmbMoney')</td>
                        <td>
                            $!number.formatNumeric($!{Issue.issueRmbMoney})
                        </td>
                    </tr>
                    <tr>
                        ##预期到期日
                        <td class="textRight">#springMessage('cms.security.expectEndDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{Issue.expectEndDate})
                        </td>
                        ##法定到期日
                        <td class="textRight">#springMessage('cms.security.legalEndDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{Issue.legalEndDate})
                        </td>
                    </tr>
                    <tr>
                        ##剩余应到账金额
                        <td class="textRight">#springMessage('cms.security.reToAccountMoney')</td>
                        <td>
                            $!number.formatNumeric($!{Issue.reToAccountMoney})
                        </td>
                        ##到账日期
                        <td class="textRight">#springMessage('cms.security.toAccountDate')</td>
                        <td>
                            <input id="toAccountDate" name="toAccountDate"  data-biz-name="toAccountDate" lay-verify="required"
                                   data-type="date" class="layui-input bt-biz-dateType"/>
                        </td>
                    </tr>
                    <tr>
                        ## 本次到账金额
                        <td class="textRight">#springMessage('cms.security.toAccountMoney')</td>
                        <td>
                            <input class="layui-input bt-biz-moneyType" data-maxlength="20" data-name="toAccountMoney"
                                   lay-verify="required|strlength" data-biz-name="toAccountMoney" id="toAccountMoney"
                                   data-max="$!{Issue.reToAccountMoney}"
                                   data-decimal="2" data-minus="false" type="text">
                        </td>
                        ##收款账号
                        <td class="textRight">#springMessage('table.nisBillhead.payeeAcc')</td>
                        <td>
                            <input type="text" name="payee" id="payee" class="layui-input account" data-biz-name="payee"  clickCallback="setIssuing">
                        </td>

                    </tr>
                    <tr>
                        ##账户名称
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.accName')</td>
                        <td>
                            <input type="text" name="accName" id="accName" class="layui-input"   >
                        </td>
                        ##开户行名称
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.bankName')</td>
                        <td>
                            <input type="text" name="bankName" id="bankName" class="layui-input" >
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                        <td colspan="3">
                                <textarea type="text" id="rmk" name="rmk" class="layui-textarea" maxlength="200"
                                          placeholder="#springMessage('table.cmsProvideLoanInfo.rmk')"></textarea>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: center;" colspan="4">
                            <button class="layui-btn" lay-submit="" id="submit" value="11">#springMessage('common.button.submit')</button>
                            <button type="button" onclick="resetCallback()" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/security/securityToAccount.add.js?_btv=${resourceVersion}"></script>
</body>
</html>

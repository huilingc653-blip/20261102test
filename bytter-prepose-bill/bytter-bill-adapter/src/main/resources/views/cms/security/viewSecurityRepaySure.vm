<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
        ##还款确认信息
        <div class="layui-collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('还款确认信息')</h2>
                <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                    <table class="layui-table">
                        <tbody>
                        <tr>
                            ##证券发行编号
                            <td class="textRight" >#springMessage('cms.security.securityIssueCode')</td>
                            <td >
                                $!{repaySure.securityIssueCode}
                            </td>
                            ##层级
                            <td class="textRight" >#springMessage('cms.security.level')</td>
                            <td>$!{repaySure.levelName}</td>
                        </tr>
                        <tr>
                            ##产品名称
                            <td class="textRight">#springMessage('cms.security.productName')</td>
                            <td>
                                <div class="layui-inline">
                                    $!{repaySure.productName}
                                </div>
                            </td>
                            ##还款日期
                            <td class="textRight">#springMessage('table.cmsLoanSend.repayDate')</td>
                            <td>
                                $!date.format('yyyy-MM-dd',$!{repaySure.repayDate})
                            </td>
                        </tr>
                        <tr>
                            ##计划还款日期
                            <td class="textRight">#springMessage('cms.security.planRepayDate')</td>
                            <td>
                                $!date.format('yyyy-MM-dd',$!{repaySure.planRepayDate})
                            </td>
                            ## 还款本金
                            <td class="textRight">#springMessage('table.createRepayPlan.repaymentMoney')</td>
                            <td>
                                $!number.formatNumeric($!{repaySure.repayMoney})
                            </td>
                        </tr>
                        <tr>
                            ##执行利率%
                            <td class="textRight">#springMessage('cms.security.surerate')</td>
                            <td >
                                $!rateTag.show($!{repaySure.rate})
                            </td>
                            ##还款利息
                            <td class="textRight">#springMessage('table.cmsLoanRepay.repayAccrual')</td>
                            <td>
                                $!number.formatNumeric($!{repaySure.repayInterest})
                            </td>
                        </tr>
                        <tr>
                            ##还款金额
                            <td class="textRight">#springMessage('table.cmsLoanRepay.repayMoney')</td>
                            <td>
                                $!number.formatNumeric($!{repaySure.repayAmount})
                            </td>
                            ##剩余本金
                            <td class="textRight">#springMessage('table.cmsBond.remainMoney')</td>
                            <td>
                                $!number.formatNumeric($!{repaySure.remainMoney})
                            </td>
                        </tr>
                      <tr>
                          <td class="textRight">#springMessage('table.createRepayPlan.isRepay')</td>
                          <td>
                              $!dictTag.get("nisBillhead.isPayed",$!{repaySure.isRepay})
                          </td>
                      </tr>
                        <tr>
                            ##备注
                            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                            <td colspan="3">
                                $!{repaySure.rmk}
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </form>
    #parse("views/common/footer.vm")
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="myform">
    <input  id="id" type="hidden" name="id" value="$!{cmsSecurityLevel.id}">
    <input  id="id" type="hidden" name="status" value="$!{cmsSecurityLevel.status}">
    <input  id="id" type="hidden" name="createDate" value="$!{cmsSecurityLevel.createDate}">
    <input  id="id" type="hidden" name="createBy" value="$!{cmsSecurityLevel.createBy}">
    <table id="appTable" class="layui-table layui-form">
        <tr>
            ##类别编码
            <td class="textRight" style="width: 50%">#springMessage('table.Security.levelCode') </td>
            <td style="width: 50%">
                <div class="layui-input-inline">
                    <input type="text" id="levelCode" name="levelCode" lay-verify="required|strlength" data-maxlength="32" class="layui-input" value="$!{cmsSecurityLevel.levelCode}">
                </div>
            </td>
        </tr>
        <tr>
            ##类别名称
            <td class="textRight">#springMessage('table.Security.levelName')</td>
            <td>
                <input type="text" name="levelName" lay-verify="required|strlength" data-maxlength="32" class="layui-input" value="$!{cmsSecurityLevel.levelName}">
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.cmsLoanRepay.rmk')</td>
            <td>
                <input type="text" name="rmk" class="layui-input" value="$!{cmsSecurityLevel.rmk}" maxlength="200">
            </td>
        </tr>
        <tr>
            <td colspan="2"style="text-align: center">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    var dicts,form;
    bt.use(["jquery","dicts"], function () {
        $ = bt.jquery;
        form = bt.form();
        dicts = bt.dicts.init();

        //监听提交
        form.on("submit(submit)", function(data){
            console.log(data.field);
            var action = "/cms/security/level/modify";
            data.field.createDate = data.field.createDate.substring(0,10);
            if (data.field.updateDate != "undefined" && data.field.updateDate != null) {
                data.field.updateDate = data.field.updateDate.substring(0,10);
            }
            bt.loading.show();
            $.post(basePath + action,data.field,function(data){
                parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                if (data.success) {
                    if (!bt.navtab) {
                        bt.navtab.refreshParentTable();
                    } else {
                        bt.navtab.closeCurrent();
                        bt.navtab.refreshCurrent();
                    }
                } else {
                    bt.loading.hide();
                }
            },'JSON');
            return false;
        });
    });
    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }
</script>
</body>
</html>

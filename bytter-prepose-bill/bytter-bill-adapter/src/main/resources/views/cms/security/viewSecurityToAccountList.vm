<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<div>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('cms.security.toAccountDate')</th>##到账日期
            <th>#springMessage('cms.security.toAccountMoney')</th>##本次到账金额
            <th>#springMessage('table.nisBillhead.payeeAcc')</th>##收款账号
            <th>#springMessage('table.cmsEquity.accName')</th>##账户名称
            <th>#springMessage('table.cmsEquity.bankName')</th>##开户行名称
            <th>#springMessage('table.cmsEquity.rmk')</th>##备注
            <th>#springMessage('table.fcFreeze.status')</th>##备注
        </tr>
        </thead>
        <tbody>
            #foreach($toAccount in $toAccountVOS)
            <tr>
                <td align="center">$!{toAccount.toAccountDate}</td>
                <td align="right">
                    $number.formatNumeric($!{toAccount.toAccountMoney})
                </td >
                <td align="center">$!{toAccount.payee}</td>
                <td align="center">$!{toAccount.accName}</td>
                <td align="center">$!{toAccount.bankName}</td>
                <td align="center">$!{toAccount.rmk}</td>
                <td align="center">$dictTag.get("nisExpenseDetail.status",$!{toAccount.status})</td>

            </tr>
            #end
        </tbody>
    </table>

</div>
<div style="text-align: center;">
    <button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>
</div>
    #parse("views/common/footer.vm")
</body>

</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##资产证券化类型
            <td class="textRight" >#springMessage('cms.security.securityType')</td>
            <td >
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_securityTypeId" data-biz-name="eqs_securityTypeId" data-inputValue="false"
                         data-url="${basePath}/cms/security/type/listCmsSecurityType" data-valuefield="id"
                         data-textfield="typeName"></div>
                </div>
            </td>
            ##原始权益人
            <td class="textRight" >#springMessage('cms.security.intrest')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-type="selectTree" data-name="eqs_corpId" data-resource="cms:security:info:query" data-scope="all"></div>
                </div>
            </td>
            ##证券代码
            <td class="textRight" >#springMessage('cms.security.securityCode')</td>
            <td width="25%">
                <input type="text"  name="likes_securityCode" autocomplete="off"
                       class="layui-input"/>
            </td>
        </tr>
        <tr>
            ##证券名称
            <td class="textRight" >#springMessage('cms.security.securityName')</td>
            <td width="25%">
                <input type="text"  name="likes_securityName" autocomplete="off"
                       class="layui-input"/>
            </td>
            ##币种
            <td class="textRight" >#springMessage('ttpay.currency')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_curId" data-biz-name="eqs_curId" data-inputValue="false"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName"></div>
                </div>
            </td>
            ##  计划发行原币总额
            <td  class="textRight">#springMessage('table.cmsBond.issueCurTotal')</td>
            <td >
                <div class="layui-inline">
                    <input type="text" name="geg_money"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_money"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" id="t20" >
                </div>
            </td>
        </tr>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('cms.security.securityType')</th>
        <th>#springMessage('cms.security.intrest')</th>
        <th>#springMessage('cms.security.securityCode')</th>
        <th>#springMessage('cms.security.securitySname')</th>
        <th>#springMessage('cms.security.securityName')</th>
        <th>#springMessage('ttpay.currency')</th>
        <th>#springMessage('table.cmsBond.issueCurTotal')</th>
        <th>#springMessage('table.fcFreeze.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
    #workFlowScript()
<script src="${basePath}/static/modules/cms/security/securityInfo.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{loanTypePage.id}">
			<input id="type" name="type" type="hidden" value="$!{loanTypePage.type}">
        <table class="layui-table">
			<tbody>
			<tr>
            	<td colspan="6" style="text-align: center;">#springMessage('common.add.loan.type')##新增贷款类型</td>
            </tr>
			
        	<tr>
        		##类型编号
				<td width="50%" class="textRight">#springMessage('table.cmsLoanType.code')</td>
				<td width="50%">
						<!--number-->
                        <input type="text" id="code" name="code" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanType.code')"
							    lay-verify="required">
				</td>
        	
			</tr>
        	<tr>
        		##类型名称
				<td width="50%" class="textRight">#springMessage('table.cmsLoanType.name')</td>
				<td width="50%">
						<!--number-->
                        <input type="text" id="name" name="name" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanType.name')"
							    lay-verify="required">
				</td>
     
			</tr>
        	
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/credit/loanType.add.js?_btv=${resourceVersion}"></script>
</html>
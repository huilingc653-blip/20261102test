<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
.layui-body2 {
	padding：0px;
	position: absolute;
	left: 0px;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 998;
	width: auto;
	overflow: hidden;
	overflow-y: auto;
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box;
}
.layui-tab-content{
	box-sizing:border-box;
	height: 80%;
	width: 100%;
}
.layui-tab-item{
	width: 100%;
	height: 90%;
}
iframe{
	width: 100%;
	height: 100%;
	border: 0px;
}
	</style>
</head>
<body>

<div class="layui-body2" style="width: 100%; height: 100%">
	<form id="searchForm" class="layui-form">
		<input type="hidden" id="syscode" name="eqs_sysCode" value=""/>##查询授信业务使用担保的标识
		<table class="layui-table">
			<tr>
				<td class="textRight" style="width: 15%">
					<div class="layui-inline">
						#springMessage('table.guaContract.applyDate')
					</div>
				</td>
				<td style="width: 35%">
					<div class="layui-inline">
						<input style="display: inline-block" type="text" data-biz-name="startDate" class="layui-input bt-biz-dateType" name="ged_useDate">
						#springMessage('table.guaGuarantee.range')
						<input style="display: inline-block" type="text" data-biz-name="endDate" class="layui-input bt-biz-dateType" name="led_useDate">
					</div>
				</td>
				<td class="textRight" style="width: 15%">#springMessage('common.table.status')</td>
				<td style="width: 35%">
					<div class="layui-form">
						<div class="bt-biz-dict" data-type="select" data-group="Contract.UseStatus" data-name="eqg_status" data-biz-name="status" data-width="250px"></div>
					</div>
				</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;" data-list="test">
					<button class="layui-btn" lay-filter="search" lay-submit>#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
		</table>
	</form>
	<div class="layui-tab layui-tab-brief" lay-filter="Gua" style="height: 90%">
	 	<ul class="layui-tab-title" id="tab_ul">
			<li class="layui-this" lay-id="rat">#springMessage("table.guaContract.ratUseInfo")</li><!--授信使用担保情况  -->
			<li lay-id="provide">#springMessage("table.guaContract.CmsProvideLoanUseInfo")</li>##银行借款使用担保情况
			<li lay-id="loan">#springMessage("table.guaContract.CmsLoanUseInfo")</li>##内部贷款使用担保情况
			<li lay-id="accebill">#springMessage("table.guaContract.billUseInfo")</li>##承兑汇票使用担保情况
			##<li lay-id="lcs">#springMessage("table.guaContract.lcUseInfo")</li>##国际结算使用担保情况
			<li lay-id="inl">#springMessage("内部拆借使用担保情况")</li>##内部拆借使用担保情况
		</ul>
		<div class="layui-tab-content">
	        <div class="layui-tab-item  layui-show">
				<table id="ratTable" class="layui-table layui-form" style="width:100%;">
					<thead>
					<tr>
						<th>#springMessage('table.ratBkration.ratCode')</th>##授信编号
						<th>#springMessage('table.ratBkration.contractNo')</th>##授信合同号
						<th>#springMessage('table.ratBkration.ratMode')</th>##授信模式
						<th>#springMessage('table.ratBkration.money')</th>##授信额度
						<th>#springMessage('table.ratBkration.begindate')</th>##授信开始时间
						<th>#springMessage('table.ratBkration.enddate')</th>##授信结束时间
						<th>#springMessage('table.guaContract.applyDate')</th>##使用时间
						<th>#springMessage('common.table.thead.operation')</th>##操作
					</tr>
					</thead>
				</table>
	        </div>
			<div class="layui-tab-item">
				<table id="cmsProvideLoanTable" class="layui-table layui-form" style="width:100%;">
					<thead>
					<tr>
						<th>#springMessage('table.cmsProvideLoanInfo.billCode')</th>##借款单号
						<th>#springMessage('table.cmsProvideLoanInfo.bankId')</th>##借款银行
						<th>#springMessage('table.cmsProvideLoanInfo.contractNo')</th>##借款合同号
						<th>#springMessage('table.ratBkrationRelief.curCode')</th>##币种
						<th>#springMessage('table.cmsProvideLoanInfo.plMoney')</th>##借款金额
						<th>#springMessage('cms.provide.deferred.repayDate')</th>##还款日期
						<th>#springMessage('table.guaContract.applyDate')</th>##使用时间
						<th>#springMessage('common.table.thead.operation')</th>##操作
					</tr>
					</thead>
				</table>
			</div>
			<div class="layui-tab-item">
				<table id="cmsLoanTable" class="layui-table layui-form" style="width:100%;">
					<thead>
					<tr>
						<th>#springMessage('table.cmsLoanInfo.billCode')</th>##贷款流水号
						<th>#springMessage('table.cmsLoanInfo.loanGenre')</th>##贷款类型
						<th>#springMessage('table.cmsLoanInfo.contractCode')</th>##贷款合同编号
						<th>#springMessage('table.ratBkrationRelief.curCode')</th>##币种
						<th>#springMessage('table.cmsLoanInfo.loanMoney')</th>##贷款金额
						<th>#springMessage('table.cmsLoanInfo.loanDate')</th>##贷款日期
						<th>#springMessage('table.cmsLoanDeferred.matureDate')</th>##还款日期
						<th>#springMessage('table.guaContract.applyDate')</th>##使用时间
						<th>#springMessage('common.table.thead.operation')</th>##操作
					</tr>
					</thead>
				</table>
			</div>
			<div class="layui-tab-item">
				<table id="billTable" class="layui-table layui-form" style="width:100%;">
					<thead>
					<tr>
						<th>#springMessage('accBill.applay.billCode')</th>##开票申请编号
						<th>#springMessage('table.abVoucherinfo.billType')</th>##票据类型
						<th>#springMessage('table.btBankAccApp.circulationMode')</th>##流通方式
						<th>#springMessage('table.abVoucherinfo.origNo')</th>##票据号码
						<th>#springMessage('table.abVoucherinfo.billMoney')</th>##票据金额
						<th>#springMessage('table.abVoucherinfo.payer')</th>##出票人
						<th>#springMessage('table.abVoucherinfo.payee')</th>##收票人
						<th>#springMessage('table.abVoucherinfo.acceptor')</th>##承兑人
						<th>#springMessage('table.abVoucherinfo.startDate')</th>##出票日期
						<th>#springMessage('cms.common.deadlineDate')</th>##到期日期
						<th>#springMessage('table.guaContract.applyDate')</th>##使用时间
						<th>#springMessage('common.table.thead.operation')</th>##操作
					</tr>
					</thead>
				</table>
			</div>
##			<div class="layui-tab-item">
##				<table id="internationalTable" class="layui-table layui-form" style="width:100%;">
##					<thead>
##					<tr>
##						<th>#springMessage('international.credit.applicant')</th>##开证人
##						<th>#springMessage('international.credit.beneficiary')</th>##受益人
##						<th>#springMessage('international.credit.issuingBank')</th>##开证银行
##						<th>#springMessage('table.ratUrationApply.lcNo')</th>##信用证号
##						<th>#springMessage('international.credit.lcInter')</th>##信用证类型
##						<th>#springMessage('international.lc.creditMoney')</th>##信用证金额
##						<th>#springMessage('table.guaContractInfo.contractCode')</th>##合同编号
##						<th>#springMessage('international.credit.issuingDate')</th>##开证日期
##						<th>#springMessage('international.credit.expiryDate')</th>##信用证有效期
##						<th>#springMessage('table.guaContract.applyDate')</th>##使用时间
##						<th>#springMessage('common.table.thead.operation')</th>##操作
##					</tr>
##					</thead>
##				</table>
##			</div>
			<div class="layui-tab-item">
				<table id="inlTable" class="layui-table layui-form" style="width:100%;">
					<thead>
					<tr>
						<th>#springMessage('cms.inl.info.billNo')</th>##内部拆借编号
						<th>#springMessage('内部资金拆借合同号')</th>##内部资金拆借合同号
						<th>#springMessage('拆借资金币种')</th>##拆借资金币种
						<th>#springMessage('cms.inl.info.money')</th>##拆借金额
						<th>#springMessage('拆借日期')</th>##拆借日期
						<th>#springMessage('到期日期')</th>##到期日期
						<th>#springMessage('使用日期')</th>##使用日期
						<th>#springMessage('common.table.thead.operation')</th>##操作
					</tr>
					</thead>
				</table>
			</div>
	    </div>
	 </div>
 </div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaContractOccupUseTab.js?_btv=${resourceVersion}"></script>
</html>

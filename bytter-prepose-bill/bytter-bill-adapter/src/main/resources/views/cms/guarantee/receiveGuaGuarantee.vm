<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	#rateInfo input {
    		text-align:right;
    	}
    	#rateInfo .bt-biz-rateType {
    		width:128px;
    	}
    </style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input type="hidden" id="incomeCorp" name="incomeCorp" value="$!{vo.incomeCorp}">
		<input type="hidden" id="guaranteeAttr" name="guaranteeAttr" value="$!{vo.guaranteeAttr}">
		<input type="hidden" id="curId" name="curId" value="$!{vo.curId}">
		<input type="hidden" id="id" name="id" value="$!{vo.id}">
		<input type="hidden" id="guaranteeNo" name="guaranteeNo" value="$!{vo.guaranteeNo}">
		<input type="hidden" id="bankName" name="bankName" value="$!{vo.openCorpName}">
		<input type="hidden" id="guaranteeType" name="guaranteeType" value="$!{vo.guaranteeType}">
		<input type="hidden" id="corpId" name="corpId" value="$!{vo.corpId}">
		<input type="hidden" id="openCorpType" name="openCorpType" value="$!{vo.openCorpType}">
		<input type="hidden" id="openWay" name="openWay" value="$!{vo.openWay}">
		<input type="hidden" id="openType" name="openType" value="$!{vo.openType}">
		<input type="hidden" id="openCorp" name="openCorp" value="$!{vo.openCorp}">
		<input type="hidden" id="curId" name="curId" value="$!{vo.curId}">
		<input type="hidden" id="guaItem" name="guaItem" value="$!{vo.guaItem}">
		<input type="hidden" id="expectEndDate" name="expectEndDate" value="$!date.format('yyyy-MM-dd',$!{vo.expectEndDate})">
		<input type="hidden" id="status" name="status" value="$!{vo.status}">
		<input type="hidden" id="createDate" name="createDate" value="$!date.format('yyyy-MM-dd',$!{vo.createDate})">
		<input type="hidden" id="createBy" name="createBy" value="$!{vo.createBy}">
		<input type="hidden" id="updateDate" name="updateDate" value="$!date.format('yyyy-MM-dd',$!{vo.updateDate})">
		<input type="hidden" id="updateBy" name="updateBy" value="$!{vo.updateBy}">
		<input type="hidden" id="turnBank" name="turnBank" value="$!{vo.turnBank}">
        <input type="hidden" id="guaranteeedCorp" name="guaranteeedCorp" value="$!{vo.guaranteeedCorp}">
        <input type="hidden" name="bondCurId" id="bondCurId" value="$!{vo.bondCurId}">
        <input type="hidden" name="isRmbRat" id="isRmbRat" value="$!{vo.isRmbRat}">
        <input type="hidden" name="isHookBond" id="isHookBond"  value="$!{vo.isHookBond}">
        <input type="hidden" name="isOpenRat" id="isOpenRat" value="$!{vo.isOpenRat}">
		<input type="hidden" name="bondAcc" value="$!{vo.bondAcc}">
        <input type="hidden" name="bondId" value="$!{bondId}">
		<input type="hidden" id="exchangeRate" name="exchangeRate" value="$!excRateTag.getConvert($!{exchangeRate})">
		<input type="hidden" id="isRat" value="$!{vo.ratmodel}">
        <input type="hidden" id="ratApplyMoney">##授信正式占用金额
        <input type="hidden" id="ratApplyMoneyPre" value="$!{ratApplyMoneyPre}">##未修改前保函金额
		<input type="hidden" id="corpCurId" value="$!{corpCurId}">
		<table class="layui-table" id="guaTable">
		<tbody>
        	<tr>
        		##保函编号
				<td class="textRight" width="14%">#springMessage('table.guaGuarantee.No')</td>
				<td width="36%">$!{vo.guaranteeNo}</td>
        		##保函类型
				<td class="textRight">#springMessage('table.guaGuarantee.type')</td>
				<td  width="36%">$dictTag.get("guarantee.Lg.TypeAttr", "$!{vo.guaranteeType}")</td>
			</tr>
           <tr>
		   ##保函申请人
           <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.applyPeople')</td>
		   <td  width="36%">$!{vo.corpName}</td>
			##开立人类型
			 <td class="textRight" >#springMessage('table.guaGuarantee.openPeopleType')</td>
             <td>$dictTag.get("guarantee.Lg.openPeopleType", "$!{vo.openCorpType}")
			  </td>
		   </tr>
		   <tr>
		      ##开立方式
              <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.openWay')</td>
		      <td>$dictTag.get("guarantee.Lg.openWay", "$!{vo.openWay}")</td>
			  ##开立类型
		      <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.openType')</td>
              <td  width="36%">$dictTag.get("guarantee.Lg.openType", "$!{vo.openType}")
			  </td>
		   </tr>
        	<tr>
        		##保函开立人
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.openPeople')</td>
				<td  width="36%">$!{vo.openCorpName}</td>
				##保函受益人
				<td class="textRight" width="14%">#springMessage('table.guaGuarantee.beneficiary')</td>
				<td width="36%">$!{vo.incomeCorp}</td>
			</tr>
			<tr>
				##币别
                <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.curId')</td>
                <td  width="36%">$!{vo.curName}</td>
        		##保函金额
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.money')</td>
				<td  width="36%">
					<input type="text" id="guaranteeMoney" name="guaranteeMoney" value="$!{vo.guaranteeMoney}"
					data-required="true" data-decimal="2"  class="layui-input bt-biz-moneyType" data-biz-name="guaranteeMoney"
					data-callback="circular">
				</td>
			</tr>
			<tr>
        		##保函性质
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.lgNature')</td>
				<td  width="36%">$dictTag.get("guarantee.Lg.nature", "$!{vo.guaranteeAttr}")</td>
				##保证事项
                <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.lgMatter')</td>
                <td  width="36%">$!{vo.guaItem}</td>
			</tr>
			<tr>
        		##保函开始时间
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.startDate')</td>
				<td  width="36%">
					<div class="layui-inline">
                        <input type="text" name="startDate" data-name="startDate" lay-verify="required" data-biz-name="startDate" data-callback="bt.changStartDate"
                               class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date" value="$!date.format('yyyy-MM-dd',$!{vo.startDate})">
				   </div>
				</td>
				##保函截止时间
                <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.endDate')</td>
                <td  width="36%">
					<div class="layui-inline"">
                    <input type="text" name="endDate"　data-name="endDate" data-biz-name="endDate"
                           class="layui-input bt-biz-dateType" id="endDate" data-type="date" value="$!date.format('yyyy-MM-dd',$!{vo.endDate})">
                	</div>
				</td>
			</tr>
			<tr>
        		##保函预计结束日期
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.expectEndDate')</td>
				<td  width="36%">$!date.format('yyyy-MM-dd',$!{vo.expectEndDate})</td>
				##转开行
                <td class="textRight" width="14%">
					#if($!{vo.turnBank})
						#springMessage('table.guaGuarantee.turnBank')
				    #end
				</td>
                <td  width="36%">
					#if($!{vo.turnBank})
						$!{vo.turnBank}
					#end
				</td>
			</tr>
            <tr>
			##被担保单位
                <td class="textRight">#springMessage('table.guaGuarantee.guaranteedCorp')</td>
                <td colspan="3">
                    <div class="layui-inline" id="guaranteedCorpDiv">
                        <div class="layui-input-inline">
                            <div class="selectTreeDemo" data-width="400px;"></div>
                        </div>
                    </div>
            </tr>
				#if($!{isHangBail}=="1")##参数设置挂接保证金
                <tr>
				##是否挂保证金
                    <td  class="textRight">#springMessage('table.fcBond.includeBond')</td>
                    <td >$dictTag.get("sf_yn", $!{vo.isHookBond})</td>
				##保证金账户
                    <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.bondAcc')</td>
                    <td  width="36%">
						$!{vo.bondAcc}
##                        <input type="text" id="bondAcc" name="bondAcc" autocomplete="off" class="layui-input bank" value="$!{vo.bondAcc}">
                    </td>
                </tr>
                <tr>
				## 保证金币种
                    <td class="textRight">#springMessage('table.urationapply.bondCurId')</td>
                    <td>$!{vo.bondCurName}</td>
				##保证金比例
                    <td width="15%" class="textRight">#springMessage('table.fcBond.bondPercent')</td>
                    <td width="40%">
                        <div class="layui-input-inline">
                            <input type="text" data-name="bondPercent" data-decimal="2" value="$!{vo.bondPercent}"
                                   class="layui-input bt-biz-rateType" data-biz-name="bondPercent" data-callback="setBailMoney">
                        </div>
                    </td>
                </tr>
                <tr>
				##保证金金额
                    <td widht="20%" class="textRight">#springMessage('table.fcBond.bondmoney')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" id="bondMoney"  name="bondMoney" value="$!{vo.bondMoney}" data-decimal="2" class="layui-input bt-biz-moneyType" data-biz-name="bondMoney" data-callback="setBailMoneyRate" placeholder="#springMessage('table.cmsProvideLoanInfo.bailmoney')">
                        </div>
                    </td>
				##保证金合同号
                    <td width="20%" class="textRight">#springMessage('table.fcBond.contractNum')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" id="bondContract" name="bondContract" value="$!{vo.bondContract}"
                                   autocomplete="off" class="layui-input" >
                        </div>
                    </td>
                </tr>
				##保证金利率
                <tr>
                    <td width="15%" class="textRight">#springMessage('table.fcBond.bondRate')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" id="bondRate" data-name="bondRate"  data-biz-name="bondRate" class="layui-input bt-biz-rateType"  value="$!{vo.bondRate}" readonly="true" >
                        </div>
                    </td>
                </tr>
				#end
			##挂接授信开始
				#if($!{urationDTO})
					<tr>
                        <td class="textRight">#springMessage('gua.related.rat')</td>##是否挂接授信
                        <td>
							$dictTag.get("sf_yn", "$!{vo.ratmodel}")
                        </td>
						#if("1"==$!{startOpenRat})##启用授信敞口参数
                            <td class="textRight">#springMessage('gua.start.Openrat')</td>##是否启用敞口授信
                            <td>
								$dictTag.get("sf_yn", "$!{vo.isOpenRat}")
                            </td>
						#else
                            <td></td>
                            <td></td>
						#end
					</tr>
                <tr>
				##授信品种
                    <td class="textRight">#springMessage('table.guarantee.ratItemCode')</td>
                    <td >$!{urationDTO.ratItemName}</td>
				##授信业务品种名称
                    <td class="textRight">#springMessage('cms.business.race')</td>
                    <td >$!{urationDTO.raceName}</td>
                </tr>
                <tr>
					#if($!{naturalSign}!="1")
					##是否折合本位币
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.isRmbRat')</td>
                        <td >
							$dictTag.get("sf_yn", "$!{vo.isRmbRat}")
                        </td>
					#end
				##授信额度单
                    <td class="textRight">#springMessage('table.guarantee.rationSelect')</td>
                    <td>
                        <div class="layui-input-inline">
							#if($!{vo.ratmodel} == "1")
                                <div id="rationBtn">
                                    <button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
                                </div>
							#else
                                <div style="display: none" id="rationBtn">
                                    <button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
                                </div>
							#end
                        </div>
					##额度编号
					##占用授信代码
                        <span id="itemCodeTd">
						<input type="hidden" name="ratCode" id="ratCode" value="$!{urationDTO.ratCode}">
						<input type="hidden" name="itemFlag" id="itemFlag" value="$!{urationDTO.itemFlag}">
						<input type="hidden" name="itemMoney" id="itemMoney" value="$!{urationDTO.money}">
						<input type="hidden" name="ratCurId" id="ratCurId" value="$!{urationDTO.curCode}">
						<input type="hidden" name="ratItemCode" id="ratItemCode" value="$!{urationDTO.ratItemCode}">
							#if($!{urationDTO.itemFlag} == "0")
                                <!-- 						<input type="hidden" name="ratItemCode" id="ratItemCode" value="$!{urationDTO.ratItemCode}"> -->
							#else
								#foreach($applyDtl in $!{urationDTO.applyDtls})
									#set($vcount = $velocityCount - 1)
                                    <input type="hidden" name="applyDtls[$!{vcount}].itemCode" id="itemCode$!{vcount}" value="$!{applyDtl.itemCode}">
								<input type="hidden" name="applyDtls[$!{vcount}].itemMoney" itemCode="$!{applyDtl.itemCode}" id="itemMoney$!{vcount}" value="$!{applyDtl.useMaxMoney}">
								#end
							#end
					</span>
                    </td>
                </tr>
				#end
			##挂接授信结束
		</tbody>
		</table>
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="8" class="textCenter"><b>#springMessage('table.guaGuarantee.receiveInfor')</b></td>
			</tr>
			<tr>
				##费率
				<td class="textRight">#springMessage('table.guaGuarantee.handleRate')</td>
				<td  width="36%">
					<div class="layui-input-inline">
                        <input type="text" data-name="handleRate"  data-decimal="2" class="layui-input bt-biz-rateType" data-biz-name="handleRate" lay-verify="required"
							data-callback="setHandleCharge">
                    </div>
				</td>
				##手续费
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.handleCharge')</td>
				<td  width="36%">
					<input type="text" id="handleCharge" name="handleCharge" value="$!{vo.handleCharge}"  lay-verify="required"
					data-decimal="2"  class="layui-input bt-biz-moneyType" data-biz-name="handleCharge" data-callback="setHandleRate">
				</td>
			</tr>
            <tr>
			##领取人
                <td class="textRight" width="14%">#springMessage('table.guaGuarantee.receiver')</td>
                <td width="36%">
                    <input type="text" id="receiver" name="receiver" autocomplete="off" class="layui-input"
                           value="$!{operator}">
                </td>
			##领取时间
                <td class="textRight" width="14%">#springMessage('table.guaGuarantee.receiveDate')</td>
                <td width="36%">
                    <div class="layui-inline">
                        <input type="text" name="receiveDate" data-name="receiveDate" data-biz-name="receiveDate"
                               class="layui-input bt-biz-dateType" data-endid="receiveDate" data-type="date">
                    </div>
                </td>
            </tr>
			<tr>
				<td class="textRight"  width="14%">#springMessage('cms.loan.attachment')</td>
				<td style="text-align: center;" colspan="3">
					<!-- 附件上传 -->
					<input id="annexName" name="uploadId" type="hidden" value="$!{vo.attachmentId}">
			        <div id="uploader" class="layui-input-inline" style="width:100%"></div>
				</td>
			</tr>
			<tr>
				<td style="text-align: center;" colspan="4">
					<button class="layui-btn" lay-submit="" >#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary" onclick="closeForms()">#springMessage('common.button.revert')</button>
				</td>
			</tr>
        	</tbody>
        </table>
		<table class="layui-table">
			<tbody>
			<tr>
				<td colspan="8" class="textCenter"><b>#springMessage('table.guaGuarantee.receiveInforfail')</b></td>
			</tr>
			<tr>
				##失败原因
				<td class="textRight"><span style="color: red;font-size: 18px;position:relative;top: 6px;left: -3px">*</span>#springMessage('table.bisExc.failReason')</td>
				<td colspan="3">
					<textarea rows="3" cols="80" id="failReason" name="failReason"  class="layui-textarea"></textarea>
				</td>
			</tr>
			<tr>
				<td style="text-align: center;" colspan="4">
					<button type="button" class="layui-btn" onclick="failreason()">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary" onclick="closeForms()">#springMessage('common.button.revert')</button>
				</td>
			</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationSet.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/guarantee/guaGuaranteeReceive.add.js?_btv=${resourceVersion}"></script>
</html>

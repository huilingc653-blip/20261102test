<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	#rateInfo input {
    		text-align:right;
    	}
    	#rateInfo .bt-biz-rateType {
    		width:128px;
    	}
    </style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
        <input type="hidden" id="ids" name="ids"/>
		<input type="hidden" id="id" name="id" value="$!{info.id}"/>
        <input type="hidden" id="pDids" name="pDids" value="$!{info.pDids}"/>
		<input type="hidden" id="pZids" name="pZids" value="$!{info.pZids}"/>
		##<input type="hidden" id="debtorPerson" name="debtorPerson" value="$!{info.debtorPerson}"/>
		<input type="hidden" id="guaId" name="guaId" value="$!{info.id}"/>
		<input type="hidden" id="moneys0" name="moneys0" value="$!{info.money0}"/>
		<input type="hidden" id="moneys1" name="moneys1" value="$!{info.money1}"/>
		<input type="hidden" id="moneys2" name="moneys2" value="$!{info.money2}"/>
		<!--担保方式-->
		<input type="hidden" id="guaWays" name="guaWays" value="$!{guaWays}"/>
		<input type="hidden" id="curId" name="curId" value="$!{info.curId}"/>
		<input type="hidden" id="corpName" name="corpName" value="$!{info.corpName}"/>
		<input type="hidden" id="curCode" name="curCode"/>
        </ins>
		<table class="layui-table" id="guaTable">
		<tbody>
        	<tr>
        		##融资主体
				<td class="textRight" width="14%">#springMessage('table.guaContract.corpId')</td>
				<td width="36%">
				<input class="layui-input" id="corpId" name="corpId"  type="hidden" value="$!{info.corpId}"/>
					$!{info.corpName}
				</td>
        		##担保编号
				<td class="textRight" width="14%">#springMessage('table.guaContract.guaNo')</td>
					<td width="36%">
					<input class="layui-input" id="guaNo" name="guaNo"  type="hidden" value="$!{info.guaNo}"/>
        			$!{info.guaNo}
				</td>
			</tr>
			<tr>
				##币别
                <td class="textRight" width="14%">#springMessage('table.guaContract.curId')</td>
                <td width="36%">
                    <input class="layui-input" id="curName" name="curName"  type="hidden" value="$!{info.curName}"/>
					$!{info.curName}
                </td>
				##担保日期
                <td class="textRight" width="14%">#springMessage('table.guaContract.date')</td>
                <td width="36%">
                    <div class="layui-inline">
                        <input type="text" name="startDate" data-name="startDate"  data-biz-name="startDate" data-callback="bt.dateChange"
                             class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date" lay-verify="required" value="$!{info.startDate}">
                    </div>
					<span class="date-mid">#springMessage('table.guaContract.range')</span>
                    <div class="layui-inline"">
                        <input type="text" name="endDate"　data-name="endDate"  data-biz-name="endDate" data-callback="bt.dateChange"
                             class="layui-input bt-biz-dateType" id="endDate" data-type="date" lay-verify="required" value="$!{info.endDate}">
                    </div>
                </td>
			</tr>
            <tr>
				##债务人
                <td class="textRight" width="14%">#springMessage('table.guaContract.debtorPersonName')</td>
                <td width="36%">
                    <input class="layui-input" id="debtorPerson" name="debtorPerson"  type="hidden" value="$!{info.debtorPerson}"/>
					$!{info.debtorPerson}
                </td>
				##债权人
                <td class="textRight" width="14%">#springMessage('table.guaContract.creditorPerson')</td>
                <td width="36%">
                    <input class="layui-input" id="creditorPerson" name="creditorPerson"  type="hidden" lay-verify="strlength" value="$!{info.creditorPerson}" data-maxlength="100"/>
					$!{info.creditorPerson}
                </td>
            </tr>
            <tr>
				## 是否集团内担保单位
                <td  class="textRight" width="14%">#springMessage('table.guaContract.innerGua')</td>
                <td>
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{info.innerGua}" data-name="innerGua"
                         data-biz-name="innerGua" data-callback="bt.changeType" data-required="true"></div>
                </td>
				##担保单位
                <td class="textRight" width="14%">#springMessage('table.guaContract.guaPerson')</td>
                <td width="36%">
                    <div class="layui-inline" id="guaPersonInfo">
						#if($!{info.innerGua}=='1')
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="guaPerson"
                                 data-required="true"
                                 data-scope="all"
                                 data-defaultvalue="$!{info.guaPerson}"
                                 data-resource="">
                            </div>
						#else
                            <input class="layui-input" id="guaPerson" name="guaPerson"  type="text" lay-verify="required|strlength" value="$!{info.guaPerson}" data-maxlength="200"/>
						#end
                    </div>
                </td>
            </tr>
		   <tr>
		       ##合同编号
               <td class="textRight" width="14%">#springMessage('table.guaContract.contractCode')</td>
               <td width="36%">
                   <div class="layui-inline">
                       <input class="layui-input" id="contractCode" name="contractCode"  type="text" lay-verify="required|strlength"  value="$!{info.contractCode}" data-maxlength="50"/>
                   </div>
               </td>
				##担保方式
              <td class="textRight" width="14%">#springMessage('table.guaContract.guaType')</td>
              <td width="36%">
                  <div class="layui-inline">
                      <div class="selectDemo bt-biz-mulselectType" data-id="guaWay" data-biz-name="guaWay" data-method="get" data-callback="bt.changeGuaWay" data-initCompleteCallback="bt.initGuaWay"
                           data-url="${basePath}/cms/guarantee/guaContractInfo/json" data-valuefield="id" data-textfield="name" data-defaultvalue="$!{guaWays}"
                           data-name="guaWay" ></div>
                  </div>
              </td>
			  #foreach($headSera in $headList)
                  <th>#if(${headSera.required}==true)<span style="color:red;">*</span> #end #springMessage(${headSera.name})</th>
			  #end
			  #foreach($guaWayMsg in $info.guaDtls)
				  #set($vcount = $velocityCount)
                  <input type="hidden" name="guaDtls[$!{guaWayMsg.guaWayCode}].id" value="$!{guaWayMsg.id}">
                  <input type="hidden" id="money$!{guaWayMsg.guaWayCode}" value="$!{guaWayMsg.money}">
                  <input type="hidden" id="pledgeIds$!{guaWayMsg.guaWayCode}"  value="$!{guaWayMsg.pledgeIds}">
                  <input type="hidden" id="pDids$!{guaWayMsg.guaWayCode}"  value="$!{guaWayMsg.pDids}">
                  <input type="hidden" id="index$!{velocityCount}" name="guaDtls[$!{guaWayMsg.guaWayCode}].wayCodes" value="$!{guaWayMsg.wayCodes}">
			  #end
              <input type="hidden" id="WayCount" value="$!{vcount}">
		    </tr>
        	<tr>
				##担保范围
                <td class="textRight" width="14%">#springMessage('table.guaContract.warr')</td>
                <td width="36%">
                    <input  type="warr"  id="" name="warr" class="layui-input" value="$!{info.warr}" lay-verify="strlength" data-maxlength="200">
                </td>
				##担保额度
                <td class="textRight" width="14%"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.guaContract.guaMoney')</td>
				<td id="guaMoney"></td>
			</tr>
			<tr>
				##备注
                <td class="textRight" width="14%">#springMessage("table.guaContract.rmk")</td>
                <td width="36%">
					<input  type="text"  id="rmk" name="rmk" class="layui-input" value="$!{info.rmk}" lay-verify="strlength" data-maxlength="200">
				</td>
                <td></td>
                <td></td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('cms.loan.attachment')</td>
				<td style="text-align: center;" colspan="3">
					<!-- 附件上传 -->
					<input id="annexName" name="uploadId" type="hidden" value="$!{info.attachmentId}">
			        <div id="uploader" class="layui-input-inline" style="width:100%"></div>
				</td>
			</tr>
			<tr>
				<td style="text-align: center;" colspan="4">
					<button class="layui-btn" lay-submit="" id="submit" value="11">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary" data-callback="clearData">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaContractInfo.change.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-input{
            width:170px;
            table-layout:fixed
        }
    </style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
        <input type="hidden" id="contractId" name="contractId" value="$!{vo.id}">
        <input type="hidden" id="guaWays" name="guaWays" value="$!{guaWays}">
        </ins>
        <table class="layui-table">
            <tbody>
            <tr>
			## 融资主体
                <td class="textRight" width="14%">#springMessage('table.guaContract.corpId')</td>
                <td width="36%">$!{vo.corpName}</td>
			##担保编号
                <td class="textRight">#springMessage('table.guaContract.guaNo')</td>
                <td>$!{vo.guaNo}</td>
            </tr>
            <tr>
			##币别
                <td class="textRight">#springMessage('table.guaContract.curId')</td>
                <td>$!{vo.curName}</td>
			##担保日期
                <td class="textRight">#springMessage('table.guaContractInfo.date')</td>
                <td>$!date.format('yyyy-MM-dd',$!{vo.startDate})
                    <span class="date-mid">#springMessage('table.guaContract.range')</span>
					$!date.format('yyyy-MM-dd',$!{vo.endDate})
                </td>
            </tr>
            <tr>
			##债务人
                <td class="textRight">#springMessage('table.guaContract.debtorPersonName')</td>
                <td>$!{vo.debtorPerson}</td>
			##债权人
                <td class="textRight">#springMessage('table.guaContract.creditorPerson')</td>
                <td>$!{vo.creditorPerson}</td>
            </tr>
            <tr>
			## 是否集团内担保单位
                <td class="textRight">#springMessage('table.guaContract.innerGua')</td>
                <td>
					$dictTag.get("sf_yn",$!{vo.innerGua})
                </td>
			##担保单位
                <td class="textRight">#springMessage('table.guaContract.guaPerson')</td>
                <td>$!{vo.guaPerson}</td>
            </tr>
            <tr>
			##合同编号
                <td class="textRight">#springMessage('table.guaContract.contractCode')</td>
                <td>$!{vo.contractCode}</td>
			##担保方式
                <td class="textRight">#springMessage('table.guaContract.guaType')</td>
                <td>$!{guaWayNames}</td>
				#foreach($guaWayMsg in $vo.guaDtls)
                    <input type="hidden" id="money$!{guaWayMsg.guaWayCode}" value="$!{guaWayMsg.money}">
				#end
            </tr>
            <tr>
			##担保范围
                <td class="textRight">#springMessage('table.guaContract.warr')</td>
                <td>$!{vo.warr}</td>
			##担保额度
                <td class="textRight">#springMessage('table.guaContract.guaMoney')</td>
                <td id="guaMoney"></td>
            </tr>
            <tr>
			##备注
                <td class="textRight">#springMessage("table.guaContract.rmk")</td>
                <td>$!{vo.rmk}</td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('cms.loan.attachment')</td>
                <td style="text-align: center;" colspan="3">
                    <!-- 附件上传 -->
                    <input id="annexNameInfo" name="annexNameInfo" type="hidden" value="$!{vo.attachmentId}">
                    <div id="uploaderInfo" class="layui-input-inline" style="width:100%"></div>
                </td>
            </tr>
            </tbody>
        </table>
		<table id="appTable" class="layui-table layui-form">
            <tr>
                <td align="center">#springMessage('table.guaContractUse.bizType')</td>##业务品种
                <td align="center">#springMessage('table.guaContractUse.bizCode')</td>##业务编号
                <td align="center">#springMessage('table.guaContractUse.bizCur')</td>##业务币种
                <td align="center">#springMessage('table.guaContractUse.bizMoney')</td>##业务金额
                <td align="center">#springMessage('table.guaContractUse.bizStartDate')</td>##开始日期
                <td align="center">#springMessage('table.guaContractUse.bizEndDate')</td>##预计结束日期
                <td align="center">#springMessage('table.guaContractUse.bizConCode')</td>##合同编号
            </tr>
            <tbody>
            <td align="center">$!{contractOccupVO.businessName}</td>
            <td align="center">$!{contractOccupVO.itemNo}</td>
            <td align="center">$!{contractOccupVO.itemCurName}</td>
            <td align="right">$!number.formatNumeric($!{contractOccupVO.itemMoney})</td>
            <td align="center">$!date.format('yyyy-MM-dd',$!{contractOccupVO.startDate})</td>
            <td align="center">$!date.format('yyyy-MM-dd',$!{contractOccupVO.endDate})</td>
            <td align="center">$!{contractOccupVO.itemConCode}</td>
            </tbody>
		</table>
        <table class="layui-table">
            <tbody>
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" type="button" onClick="closecurrent()">#springMessage('common.button.close')</button>
                </td>
            </tr>
            </tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form', 'datatable', 'corp', 'moneyType', 'btUpload', 'dicts', 'jquery', 'checkboxs'], function () {
        $ = bt.jquery, form = bt.form();
        bt.moneyType.init();
        var gInfoId = $("#annexNameInfo").val();
        var gSendId = $("#annexNameSend").val();
        bt.btUpload.init({
            elem: "#uploaderInfo",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gInfoId
        });

        bt.btUpload.init({
            elem: "#uploaderSend",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gSendId
        });

        // 担保方式
        initGuaWayDiv();
    });

    function closecurrent() {
        parent.layer ? parent.layer.closeAll() : layer.closeAll();
        return false;
    }

    function initGuaWayDiv() {
        var guaWaysValue = $("#guaWays").val();
        if (guaWaysValue.length) {
            var arr = new Array();
            arr = guaWaysValue.split(",");
            // 外币
            $.ajax({
                url: basePath + "/cms/guarantee/guaContractInfo/json",
                type: "get",
                dataType: "json",
                success: function (data) {
                    $.each(data, function (i) {
                        for (var j = 0; j < arr.length; j++) {
                            var str1 = data[i].id;
                            var str2 = arr[j];
                            if (str1 == str2) {
                                createHtml(data[i]);
                            }
                        }
                    });
                }
            });
        }
    }

    function createHtml(data) {
        var html = '<div id="div' + data.id + '">';
        html += '<label>' + data.name + '</label>';
        html += '<div class="layui-inline">';
        html += bt.money.format($("#money" + data.code).val());
        html += '</div>';
        $("#guaMoney").append(html);
        bt.moneyType.init();//金额
    }
    function closecurrent() {
        parent.layer ? parent.layer.closeAll() : layer.closeAll();
        return false;
    }
</script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
		<table class="layui-table">
           <tbody>
                <tr>
                    ## 抵质押物编号
					<td class="textRight">#springMessage('table.guaPledge.pledgeNo')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_pledgeNo" autocomplete="off"
								class="layui-input" placeholder="#springMessage('table.guaPledge.pledgeNo')">
                        </div>
                    </td>
					##抵质押类型
                    <td class="textRight">#springMessage('table.guaPledge.pledgeType')</td>
                    <td>
    				 	<div type="list" field="eqs_pledgeType" name = "eqs_pledgeType" fieldHref="${basePath}/cms/guarantee/pledgeType/json" dictField="id" dictText="typeName" ></div>
					</td>
					##抵质押性质
                    <td class="textRight">#springMessage('table.guaPledge.pledgeAttr')</td>
                    <td>
                        <div class="layui-inline">
							<select lay-filter="pledgeAttr" name="eqs_pledgeAttr" >
								<option value=" ">#springMessage('common.placeholder.select')</option>
								#foreach($dict in $dictTag.list("guarantee.pledge.TypeAttr"))
								<option value="$dict.code">$dict.name</option>
								#end
							</select>
						</div>
                    </td>
                </tr>
				<tr>
                    ##抵质押日期
					<td class="textRight">#springMessage('table.guaPledge.date')</td>
                    <td>
                        <div class="layui-inline">
							<input type="text" name="ged_startDate" data-name="ged_startDate"
								class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                		</div>
						<span class="date-mid">#springMessage('table.guaPledge.range')</span>
						<div class="layui-inline">
							<input type="text" name="led_endDate"　data-name="led_endDate"
								class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                		</div>
                    </td>
					##抵质押物名称
                    <td class="textRight">#springMessage('table.guaPledge.pledgeName')</td>
                    <td>
                        <input type="text" name="likes_pledgeName"  autocomplete="off" class="layui-input"
                               placeholder="#springMessage('table.guaPledge.pledgeName')">
                    </td>
					##评估价值
                    <td class="textRight">#springMessage('table.guaPledge.pledgeMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_pledgeMoney"
								autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="pledgeMoney">
                        </div>
                        <span class="date-mid">#springMessage('table.guaPledge.range')</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_pledgeMoney"
                                    autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="pledgeMoney">
                        </div>
                    </td>
                </tr>
                <tr>
					##工商登记单号
                    <td class="textRight">#springMessage('table.guaPledge.regNumber')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_regNumber" autocomplete="off"
								class="layui-input" placeholder="#springMessage('table.guaPledge.regNumber')">
                        </div>
                    </td>
                    <td class="textRight">#springMessage('table.guaPledge.pledgeOrg')</td>
                    <td width="25%">
                         <div class="layui-input-inline">
                             <input type="text" name="likes_pledgeOrg" autocomplete="off" class="layui-input"
                                    placeholder="#springMessage('table.guaPledge.pledgeOrg')">
                         </div>
                    </td>
                    ##				创建人
                    <td class="textRight">#springMessage('table.sysAttachment.createBy')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" name="likes_userName" id="userName" class="layui-input"
                                   placeholder="#springMessage('table.sysAttachment.createBy')">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.guaPledge.corpId')</th>
                <th>#springMessage('table.guaPledge.pledgeAttr')</th>
                <th>#springMessage('table.guaPledge.pledgeNo')</th>
                <th>#springMessage('table.guaPledge.pledgeType')</th>
                <th>#springMessage('table.guaPledge.pledgeName')</th>
                <th>#springMessage('table.guaPledge.startDate')</th>
				<th>#springMessage('table.guaPledge.endDate')</th>
				<th>#springMessage('table.guaPledge.pledgeMoney')</th>
                <th>#springMessage('table.guaPledge.netWorth')</th>
                <th>#springMessage('table.guaPledge.curId')</th>
				<th>#springMessage('table.guaPledge.pledge')</th>
                <th>#springMessage('table.guaPledge.pledgeOrg')</th>
				<th>#springMessage('table.guaPledge.regNumber')</th>
                <th>#springMessage('table.guaPledge.regCorp')</th>
                <th>#springMessage('table.sysAttachment.createBy')</th>
				<th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
	#workFlowHtml()
	#parse("views/common/footer.vm")
	#workFlowScript()
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaPledgeApprove.list.js?_btv=${resourceVersion}"></script>
</html>

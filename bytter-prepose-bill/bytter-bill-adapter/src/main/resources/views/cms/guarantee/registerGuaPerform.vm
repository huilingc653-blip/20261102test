<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	#rateInfo input {
    		text-align:right;
    	}
    	#rateInfo .bt-biz-rateType {
    		width:128px;
    	}
    </style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input type="hidden" id="guaraId" name="guaraId" value="$!{vo.id}">
		<input type="hidden" id="bankName" name="bankName" value="$!{vo.openCorpName}">
		<input type="hidden" id="curName" name="curName" value="$!{vo.curName}">
		<input type="hidden" id="corpName" name="corpName" value="$!{vo.corpName}">
		<table class="layui-table" id="guaTable">
		<tbody>
        	<tr>
        		##保函编号
				<td class="textRight" width="14%">#springMessage('table.guaGuarantee.No')</td>
				<td width="36%">$!{vo.guaranteeNo}</td>
        		##保函类型
				<td class="textRight">#springMessage('table.guaGuarantee.type')</td>
				<td  width="36%">$dictTag.get("guarantee.Lg.TypeAttr", "$!{vo.guaranteeType}")</td>
			</tr>
           <tr>
		   ##保函申请人
           <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.applyPeople')</td>
		   <td  width="36%">$!{vo.corpName}</td>
			##开立人类型
			 <td class="textRight" >#springMessage('table.guaGuarantee.openPeopleType')</td>
             <td>$dictTag.get("guarantee.Lg.openPeopleType", "$!{vo.openCorpType}")
			  </td>
		   </tr>
		   <tr>
		      ##开立方式
              <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.openWay')</td>
		      <td>$dictTag.get("guarantee.Lg.openWay", "$!{vo.openWay}")</td>
			  ##开立类型
		      <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.openType')</td>
              <td  width="36%">$dictTag.get("guarantee.Lg.openType", "$!{vo.openType}")
			  </td>
		   </tr>
        	<tr>
        		##保函开立人
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.openPeople')</td>
				<td  width="36%">$!{vo.openCorpName}</td>
				##保函受益人
				<td class="textRight" width="14%">#springMessage('table.guaGuarantee.beneficiary')</td>
				<td width="36%">$!{vo.incomeCorp}</td>
			</tr>
			<tr>
				##币别
                <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.curId')</td>
                <td  width="36%">$!{vo.curName}</td>
        		##保函金额
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.money')</td>
				<td  width="36%" class="textLeft" >$number.formatNumeric($!{vo.guaranteeMoney})</td>
			</tr>
			<tr>
        		##保函性质
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.lgNature')</td>
				<td  width="36%">$dictTag.get("guarantee.Lg.nature", "$!{vo.guaranteeAttr}")</td>
				##保证事项
                <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.lgMatter')</td>
                <td  width="36%">$!{vo.guaItem}</td>
			</tr>
			<tr>
        		##保函开始时间
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.startDate')</td>
				<td  width="36%">
						$!date.format('yyyy-MM-dd',$!vo.startDate)
				</td>
				##保函截止时间
                <td class="textRight"  width="14%">#springMessage('table.guaGuarantee.endDate')</td>
                <td  width="36%">
					$!date.format('yyyy-MM-dd',$!vo.endDate)
				</td>
			</tr>
		</tbody>
		</table>
		#if($!{isHangBail}=="1")
		##保证金信息
            <h2 class="layui-colla-title">#springMessage('table.fcBond.BondMsg')</h2>
			#if(${vo.isHookBond}=="1")
				#set($fcBondApplyDTO=$fcBondTag.getBondApplyDetail($!{vo.id},$!{vo.guaranteeNo}))
				#set($fcBondRate=($!{vo.bondRate}))
				#parse("views/common/viewFcBondDetail.vm")
			#else
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td class="textRight" width="14%">#springMessage('table.fcBond.corpName')</td>
                        <td>$!{vo.corpName}</td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td class="textRight" width="14%">#springMessage('table.fcBond.contractNum')</td>
                        <td>$!{vo.bondContract}</td>
                        <td class="textRight" width="14%">#springMessage('table.fcBond.curCode')</td>
                        <td>$!{vo.curName}</td>
                    </tr>
                    <tr>
                        <td class="textRight" width="14%">#springMessage('table.fcBond.bondmoney')</td>
                        <td>$!number.formatNumeric($!{vo.bondMoney})</td>
                        <td class="textRight" width="14%">#springMessage('table.fcBond.bondPercent')</td>
						#set($bondPercent=$!{vo.bondPercent}*100)
                        <td>$!number.formatDoubles($!bondPercent,2)%</td>
                    </tr>
                    <tr>
                        <td class="textRight" width="14%">#springMessage('table.fcBond.bondRate')</td>
						#set($bondRate=$!{vo.bondRate}*100)
                        <td width="36%">$number.formatNumeric($!bondRate,"#0.0000")%</td>
                        <td width="14%"></td>
                        <td></td>
                    </tr>
                    </tbody>
                </table>
			#end
		#end
	##挂接授信开始
		#if($!{urationDTO})
            <h2 class="layui-colla-title">#springMessage('table.cms.ratApplyMsg')</h2>
        <table class="layui-table">
        <tbody>
            <tr>
			##授信品种
                <td class="textRight" width="14%">#springMessage('table.guarantee.ratItemCode')</td>
                <td width="36%">$!{urationDTO.ratItemName}</td>
			##授信业务品种名称
                <td class="textRight" width="14%">#springMessage('cms.business.race')</td>
                <td width="36%">$!{urationDTO.raceName}</td>
            </tr>
            <tr>
				#if($!{naturalSign}!="1")
				##是否折合本位币
                    <td class="textRight" width="14%">#springMessage('table.cmsProvideLoanInfo.isRmbRat')</td>
                    <td width="36%">
						$dictTag.get("sf_yn", "$!{urationDTO.isRmbRat}")
                    </td>
				#end
			##授信额度单
                <td class="textRight" width="14%">#springMessage('table.guarantee.rationSelect')</td>
                <td width="36%">
                    <div class="layui-input-inline">
						#if($!{vo.ratmodel} == "1")
                            <div id="rationBtn">
                                <button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
                            </div>
						#else
                            <div style="display: none" id="rationBtn">
                                <button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
                            </div>
						#end
                    </div>
				##额度编号
				##占用授信代码
                    <span id="itemCodeTd">
						<input type="hidden" name="ratCode" id="ratCode" value="$!{urationDTO.ratCode}">
						<input type="hidden" name="itemFlag" id="itemFlag" value="$!{urationDTO.itemFlag}">
						<input type="hidden" name="itemMoney" id="itemMoney" value="$!{urationDTO.money}">
						<input type="hidden" name="ratItemCode" id="ratItemCode" value="$!{urationDTO.ratItemCode}">
							<input type="hidden" name="ratCurId" id="ratCurId" value="$!{urationDTO.curCode}">
						#if($!{urationDTO.itemFlag} == "0")
                            <!-- 						<input type="hidden" name="ratItemCode" id="ratItemCode" value="$!{urationDTO.ratItemCode}"> -->
						#else
							#foreach($applyDtl in $!{urationDTO.applyDtls})
								#set($vcount = $velocityCount - 1)
                                <input type="hidden" name="applyDtls[$!{vcount}].itemCode" id="itemCode$!{vcount}" value="$!{applyDtl.itemCode}">
								<input type="hidden" name="applyDtls[$!{vcount}].itemMoney" itemCode="$!{applyDtl.itemCode}" id="itemMoney$!{vcount}" value="$!{applyDtl.useMaxMoney}">
							#end
						#end
					</span>
                </td>
            </tr>
		</tbody>
		</table>
		#end
	##挂接授信结束
	<table class="layui-table">
		<tbody>
        <tr>
            <td colspan="8" class="textCenter"><b>#springMessage('table.guaGuarantee.registerInfo')</b></td>
        </tr>
		<tr>
				##合同编号
				<td class="textRight">#springMessage('table.guaGuarantee.contractNo')</td>
				<td  width="36%">
					<div class="layui-inline">
        				<input class="layui-input" id="contractNo" name="contractNo"
							   type="text" maxlength="32" lay-verify="required|strlength" data-maxlength="32" />
        			</div>
				</td>
				##合同签订日期
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.contractDate')</td>
				<td  width="36%">
					<div class="layui-inline">
						<input type="text" name="contractDate" data-name="contractDate"  data-biz-name="contractDate"
								class="layui-input bt-biz-dateType" data-endid="contractDate" data-type="date" lay-verify="required">
				   </div>
				</td>
			</tr>
			<tr>
				##收款方式
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.paymentMethod')</td>
				<td  width="36%">
					<input class="layui-input" id="paymentMethod" name="paymentMethod"
						   maxlength="50" lay-verify="strlength" data-maxlength="50" type="text"/>
				</td>
				##收款日期
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.paymentDate')</td>
				<td  width="36%">
					<div class="layui-inline">
						<input type="text" name="paymentDate" data-name="paymentDate"  data-biz-name="paymentDate"
								class="layui-input bt-biz-dateType"  data-type="date">
				   </div>
				</td>
			</tr>
			<tr>
				##备注
				<td class="textRight"  width="14%">#springMessage('table.guaGuarantee.rmk')</td>
				<td  width="36%">
					<input class="layui-input" id="rmk" name="rmk"  type="text" lay-verify="strlength" data-maxlength="400" />
				</td>
				<td  width="14%"></td>
				<td width="36%"></td>
			</tr>
			<tr>
				<td class="textRight"  width="14%">#springMessage('cms.loan.attachment')</td>
				<td style="text-align: center;" colspan="3">
					<!-- 附件上传 -->
					<input id="annexName" name="uploadId" type="hidden" value="$!{vo.attachmentId}">
			        <div id="uploader" class="layui-input-inline" style="width:100%"></div>
				</td>
			</tr>
			<tr>
				<td style="text-align: center;" colspan="4">
					<button class="layui-btn" lay-submit="">#springMessage('common.button.save')</button>
					<button type="reset" class="layui-btn layui-btn-primary" onclick="closeForms()">#springMessage('common.button.revert')</button>
				</td>
			</tr>
          </tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaGuaranteeRegister.add.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationSet.js?_btv=${resourceVersion}"></script>
</html>

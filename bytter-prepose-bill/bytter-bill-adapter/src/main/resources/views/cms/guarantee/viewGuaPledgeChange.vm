<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #rateInfo input {
            text-align:right;
        }
        #rateInfo .bt-biz-rateType {
            width:128px;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <input type="hidden" id="pledgeAttr" value="$!{guaPledge.pledgeAttr}"/>
    <table class="layui-table">
        <tbody>
        <tr>
            <td colspan="4" style="text-align: center;">
                <label><b>#springMessage('table.guaPledge.record')</b></label>
            </td>
        </tr>
        <tr>
            ##抵质押申请单位
            <td class="textRight" width="14%">#springMessage('table.guaPledge.corpId')</td>
            <td width="36%">
                $!{guaPledge.corpName}
            </td>
            ## 抵质押物编号
            <td class="textRight">#springMessage('table.guaPledge.pledgeNo')</td>
            <td>
                $!{guaPledge.pledgeNo}
            </td>
        </tr>
        <tr>
            ##性质
            <td class="textRight">#springMessage('table.guaPledge.pledgeAttr')</td>
            <td>
                $dictTag.get("guarantee.pledge.TypeAttr",$!{guaPledge.pledgeAttr})
            </td>
            ##抵质押日期
            <td class="textRight">#springMessage('table.guaPledge.date')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{guaPledge.startDate})
                <span class="date-mid">#springMessage('table.guaPledge.range')</span>
                $!date.format('yyyy-MM-dd',$!{guaPledge.endDate})
            </td>
        </tr>
        <tr>
            ##抵质押类型
            <td class="textRight">#springMessage('table.guaPledge.pledgeType')</td>
            <td >
                $!{guaPledge.typeName}
            </td>
            ##抵质押物名称
            <td class="textRight">#springMessage('table.guaPledge.pledgeName')</td>
            <td>
                $!{guaPledge.pledgeName}
            </td>
        </tr>
        <tr>
            ##抵押机构
            <td class="textRight">#springMessage('table.guaPledge.pledgeOrg')</td>
            <td>
                $!{guaPledge.pledgeOrg}
            </td>

            ##币别
            <td class="textRight">#springMessage('table.guaPledge.curId')</td>
            <td>
                $!{guaPledge.curName}
            </td>
            ##				<td class="showOrHide"></td>
            ##				<td class="showOrHide"></td>
        </tr>
        <tr>
            ##评估价值
            <td class="textRight">#springMessage('table.guaPledge.pledgeMoney')</td>
            <td >
                $number.formatNumeric($!{guaPledge.pledgeMoney})
            </td>
            ##评估净值
            <td class="textRight">#springMessage('table.guaPledge.netWorth')</td>
            <td>
                #if($!{guaPledge.pledgeNetWorth})
						$number.formatNumeric($!{guaPledge.pledgeNetWorth})
					#end
            </td>
        </tr>
        <tr>
            ##出质人名称
            <td class="textRight">#springMessage('table.guaPledge.pledge')</td>
            <td >
                $!{guaPledge.pledge}
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            ##资产状况
            <td class="textRight">#springMessage('table.guaPledge.assetState')</td>
            <td >
                $!{guaPledge.assetState}
            </td>
            ##资产产权证号
            <td class="textRight">#springMessage('table.guaPledge.assetNumber')</td>
            <td>
                $!{guaPledge.assetNumber}
            </td>
        </tr>
        <tr>
            ##土地面积
            <td class="textRight">#springMessage('table.guaPledge.buildArea')</td>
            <td >
                #if($!{guaPledge.buildArea})
                    $number.formatNumeric($!{guaPledge.buildArea})<span>#springMessage('gua.pledgeAreaUnit')</span>
                #end
            </td>
            ##容积率建筑面积
            <td class="textRight">#springMessage('table.guaPledge.buildAreaRate')</td>
            <td>
                #if($!{guaPledge.buildAreaRate})
						$number.formatNumeric($!{guaPledge.buildAreaRate})
					#end
            </td>
        </tr>
        <tr class="mortgageInfo">
            ## 土地证号
            <td class="textRight">#springMessage('table.guaPledge.landCardNo')</td>
            <td>
                $!{guaPledge.landCardNo}
            </td>
            ## 抵押面积
            <td class="textRight">#springMessage('table.guaPledge.PledgeArea')</td>
            <td>
                #if($!{guaPledge.landArea})
						$number.formatNumeric($!{guaPledge.pledgeArea})
					#end
            </td>
        </tr>
        <tr class="mortgageInfo">
            ## 宗地号
            <td class="textRight">#springMessage('table.guaPledge.landNo')</td>
            <td>
                $!{guaPledge.landNo}
            </td>
            ## 宗地面积
            <td class="textRight">#springMessage('table.guaPledge.landArea')</td>
            <td>
                #if($!{guaPledge.landArea})
						$number.formatNumeric($!{guaPledge.landArea})
					#end
            </td>
        </tr>
        <tr>
            ##登记日期
            <td class="textRight">#springMessage('table.guaPledge.regDate')</td>
            <td >
                $!date.format('yyyy-MM-dd',$!{guaPledge.regDate})
            </td>
            ##工商登记单号
            <td class="textRight">#springMessage('table.guaPledge.regNumber')</td>
            <td>
                $!{guaPledge.regNumber}
            </td>
        </tr>
        <tr>
            ##抵质押折旧
            <td class="textRight">#springMessage('table.guaPledge.pledgeDepreciation')</td>
            <td >
                #if($!{guaPledge.pledgeDepreciation})
						$number.formatNumeric($!{guaPledge.pledgeDepreciation})
					#end
            </td>
            ##抵质押原值
            <td class="textRight">#springMessage('table.guaPledge.pledgeInitMoney')</td>
            <td>
                #if($!{guaPledge.pledgeInitMoney})
						$number.formatNumeric($!{guaPledge.pledgeInitMoney})
					#end
            </td>
        </tr>
        <tr>
            ##折旧率
            <td class="textRight">#springMessage('table.guaPledge.depreciationRate')</td>
            <td >
                #if($!{guaPledge.depreciationRate})
						$number.formatNumeric($!{guaPledge.depreciationRate})
					#end
            </td>
            ##评估机构
            <td class="textRight">#springMessage('table.guaPledge.evaluationDep')</td>
            <td>
                $!{guaPledge.evaluationDep}
            </td>
        </tr>
        <tr>
            ##数量
            <td class="textRight">#springMessage('table.guaPledge.amount')</td>
            <td >
                $!{guaPledge.amount}
            </td>
            ##规格
            <td class="textRight">#springMessage('table.guaPledge.specification')</td>
            <td>
                $!{guaPledge.specification}
            </td>
        </tr>
        <tr>
            ##存放地点
            <td class="textRight">#springMessage('table.guaPledge.place')</td>
            <td >
                $!{guaPledge.place}
            </td>
            ##保管人
            <td class="textRight">#springMessage('table.guaPledge.keeper')</td>
            <td>
                $!{guaPledge.keeper}
            </td>
        </tr>
        <tr>
            ##调查人
            <td class="textRight">#springMessage('table.guaPledge.investigators')</td>
            <td >
                $!{guaPledge.investigators}
            </td>
            ##填报单位名称
            <td class="textRight">#springMessage('table.guaPledge.regCorp')</td>
            <td width="36%">
                $!{guaPledge.regCorpName}
            </td>
        </tr>
        <tr>
            ## 备注
            <td class="textRight">#springMessage('common.message.remark')</td>
            <td>
                $!{guaPledge.rmk}
            </td>
            <td class="textRight">#springMessage('table.sysAttachment.createBy')</td>
            <td>
                $!{guaPledge.userName}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td style="text-align: center;" colspan="3">
                <!-- 附件上传 -->
                <input id="annexNameInfo" name="annexNameInfo" type="hidden" value="$!{guaPledge.attachmentId}">
                <div id="uploaderInfo" class="layui-input-inline" style="width:100%"></div>
            </td>
        </tr>
            #if(!$taskId)
            <tr>
                <td colspan="6" style="text-align: center;">
                    ##<button class="layui-btn" lay-submit="" lay-filter="close">#springMessage('common.button.close')</button>
                    <button type="reset" class="layui-btn" onclick="closeForms()">#springMessage('common.button.close')</button>
                </td>
            </tr>
            #end
        </tbody>
    </table>

</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
    bt.use(['form','datatable','corp','moneyType','btUpload','dicts','jquery','checkboxs'], function(){
        $ = bt.jquery,form = bt.form();
        bt.moneyType.init();
        var gInfoId = $("#annexNameInfo").val();
        var gSendId = $("#annexNameSend").val();
        bt.btUpload.init({
            elem: "#uploaderInfo",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gInfoId
        });
        bt.btUpload.init({
            elem: "#uploaderSend",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gSendId
        });
        mortgageInfoShowOrHide();
    });
    /**
     *抵押信息的显示与隐藏
     */
    function mortgageInfoShowOrHide(){
        var pledgeAttr = $("#pledgeAttr").val();
        if (pledgeAttr == '1'){
            $(".mortgageInfo").hide();
        }else{
            $(".mortgageInfo").show();
        }
    }
</script>

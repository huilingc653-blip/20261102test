<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	#rateInfo input {
    		text-align:right;
    	}
    	#rateInfo .bt-biz-rateType {
    		width:128px;
    	}
    </style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input type="hidden" id="pledgeAttr" />
		<table class="layui-table">
			<input type ="hidden" id="corpName" name="corpName">##单号
			<input type ="hidden" id="regCorpName" name="regCorpName">##单号
		<tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label><b>#springMessage('table.guaPledge.record')</b></label>
				</td>
			</tr>
        	<tr>
        		## 抵质押申请单位
				<td class="textRight" width="14%">#springMessage('table.guaPledge.corpId')</td>
				<td width="36%">
					<div class="layui-input-inline">
						<div class="bt-biz-corp"
							data-biz-type="corp"
							data-type="selectTree"
							data-name="corpId"
							data-biz-name="corpId"
							data-scope="all"
							data-required="true"
							data-resource="gua:pledge:info:apply"
							data-callback="corpCallback">
						</div>
					</div>
				</td>
        		##抵质押物编号
				<td class="textRight">#springMessage('table.guaPledge.pledgeNo')</td>
					<td>
        			<div class="layui-inline">
        				<input class="layui-input" id="pledgeNo" name="pledgeNo" readonly="true" type="text" />
        			</div>
				</td>
			</tr>
           <tr>
		  ##性质
           <td class="textRight">#springMessage('table.guaPledge.pledgeAttr')</td>
			<td>
				<div class="bt-biz-dict" data-type="radio" data-group="pledge_type" data-defaultvalue="0"
						data-name="pledgeAttr" data-biz-name="pledgeAttr" data-required="true" data-callback="bt.changeType"></div>
			</td>
			##抵质押日期
			 <td class="textRight">#springMessage('table.guaPledge.date')</td>
              <td>
                   <div class="layui-inline">
						<input type="text" name="startDate" data-name="startDate"
								class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date" lay-verify="required">
				   </div>
				   <span class="date-mid">#springMessage('table.guaPledge.range')</span>
					<div class="layui-inline">
						<input type="text" name="endDate"　data-name="endDate"
								class="layui-input bt-biz-dateType" id="endDate" data-type="date" lay-verify="required">
                	</div>
               </td>
		   </tr>
        	<tr>
        		##抵质押类型
				<td class="textRight">#springMessage('table.guaPledge.pledgeType')</td>
				<td >
					<div class="bt-biz-selectType" data-name="pledgeType" data-url="${basePath}/cms/guarantee/pledgeType/json/0" data-valuefield="id" data-textfield="typeName" data-required="true" data-biz-name="pledgeType" ></div>
				</td>
				##抵质押物名称
                <td class="textRight">#springMessage('table.guaPledge.pledgeName')</td>
                <td>
                     <input type="text" id="pledgeName" name="pledgeName"  autocomplete="off" class="layui-input"  lay-verify="required">
                 </td>
			</tr>
            <tr>
				##抵押机构
                <td class="textRight">#springMessage('table.guaPledge.pledgeOrg')</td>
                <td>
                    <input type="text" id="pledgeOrg" name="pledgeOrg" autocomplete="off" class="layui-input" lay-verify="required">
                </td>

				##币别
                <td class="textRight">#springMessage('table.guaPledge.curId')</td>
                <td>
				##<div type="list" field="curId" fieldHref="${basePath}/basic/business/btcurrency/json" dictField="id" dictText="curName" defaultVal="$!{table.fc_instrate.cur_code}" data-required="true"></div>
                    <div class="bt-biz-selectType" data-name="curId" data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-textfield="curName"  data-defaultvalue="first" data-required="true" data-biz-name="curId"></div>
                </td>
            </tr>
			<tr>
        		##评估价值
				<td class="textRight">#springMessage('table.guaPledge.pledgeMoney')</td>
				<td>
					<div class="layui-inline">
                		<input type="text" id="pledgeMoney" name="pledgeMoney" data-decimal="2" class="layui-input bt-biz-moneyType" data-biz-name="pledgeMoney" lay-verify="required">
					</div>
					<div class="layui-inline">
						<span style="color: red">#springMessage('table.nisExpenseDetail.rmk'):#springMessage('table.guaPledge.pledgeMoney.description')</span>
					</div>
				</td>
				##评估净值
                <td class="textRight">#springMessage('table.guaPledge.netWorth')</td>
				<td>
                    <input type="text" id="pledgeNetWorth" name="pledgeNetWorth" data-decimal="2" class="layui-input bt-biz-moneyType" data-biz-name="pledgeNetWorth" lay-verify="required">
                </td>
			</tr>
			<tr>
        		##出质人名称
				<td class="textRight">#springMessage('table.guaPledge.pledge')</td>
				<td >
                	<input  type="text"  id="pledge" name="pledge" class="layui-input">
				</td>
                <td></td>
                <td></td>
			</tr>
			<tr>
        		##资产状况
				<td class="textRight">#springMessage('table.guaPledge.assetState')</td>
				<td >
                	<input  type="text"  id="assetState" name="assetState" class="layui-input">
				</td>
				##资产产权证号
                <td class="textRight">#springMessage('table.guaPledge.assetNumber')</td>
                <td>
					<input  type="text"  id="assetNumber" name="assetNumber" class="layui-input">
				</td>
			</tr>
			<tr>
        		##土地面积
				<td class="textRight">#springMessage('table.guaPledge.buildArea')</td>
				<td >
					<input  type="text"  id="buildArea" name="buildArea"  data-decimal="2" class="layui-input bt-input-inline bt-biz-moneyType"
							data-biz-name="buildArea" placeholder="#springMessage('table.guaPledge.squareMeter')"><span>#springMessage('gua.pledgeAreaUnit')</span>
				</td>
				##容积率建筑面积
                <td class="textRight">#springMessage('table.guaPledge.buildAreaRate')</td>
                <td>
					<input  type="text"  id="buildAreaRate" name="buildAreaRate"  data-decimal="2"
							class="layui-input bt-biz-moneyType" data-biz-name="buildAreaRate" placeholder="#springMessage('table.guaPledge.squareMeter')">
				</td>
			</tr>
            <tr class="mortgageInfo">
				## 土地证号
                <td class="textRight">#springMessage('table.guaPledge.landCardNo')</td>
                <td>
                    <input type="text" id="landCardNo" name="landCardNo" class="layui-input" >
                </td>
				## 抵押面积
                <td class="textRight">#springMessage('table.guaPledge.PledgeArea')</td>
                <td>
                    <input type="text" id="pledgeArea" name="pledgeArea" data-decimal="2" class="layui-input bt-biz-moneyType"
						   data-biz-name="pledgeArea" placeholder="#springMessage('table.guaPledge.squareMeter')">
                </td>
            </tr>
            <tr class="mortgageInfo">
				## 宗地号
                <td class="textRight">#springMessage('table.guaPledge.landNo')</td>
                <td>
                    <input type="text" id="landNo" name="landNo" class="layui-input">
                </td>
				## 宗地面积
                <td class="textRight">#springMessage('table.guaPledge.landArea')</td>
                <td>
                    <input type="text" id="landArea" name="landArea" class="layui-input bt-biz-moneyType"
						   data-biz-name="landArea" placeholder="#springMessage('table.guaPledge.squareMeter')">
                </td>
            </tr>
			<tr>
        		##登记日期
				<td class="textRight">#springMessage('table.guaPledge.regDate')</td>
				<td >
                	<input id="regDate" name="regDate"  data-biz-name="regDate" data-type="date" class="layui-input bt-biz-dateType"></input>
				</td>
				##工商登记单号
                <td class="textRight">#springMessage('table.guaPledge.regNumber')</td>
                <td>
					<input  type="text"  id="regNumber" name="regNumber" class="layui-input">
				</td>
			</tr>
			<tr>
        		##抵质押折旧
				<td class="textRight">#springMessage('table.guaPledge.pledgeDepreciation')</td>
				<td >
                	<input  type="text"  id="pledgeDepreciation" name="pledgeDepreciation" data-decimal="2" class="layui-input bt-biz-moneyType" data-biz-name="pledgeDepreciation">
				</td>
				##抵质押原值
                <td class="textRight">#springMessage('table.guaPledge.pledgeInitMoney')</td>
                <td>
					<input  type="text"  id="pledgeInitMoney" name="pledgeInitMoney" data-decimal="2" class="layui-input bt-biz-moneyType" data-biz-name="pledgeInitMoney">
				</td>
			</tr>
			<tr>
        		##折旧率
				<td class="textRight">#springMessage('table.guaPledge.depreciationRate')</td>
				<td >
                	<input  type="text"  id="depreciationRate" name="depreciationRate" data-decimal="4" class="layui-input bt-biz-moneyType" data-biz-name="depreciationRate">
				</td>
				##评估机构
                <td class="textRight">#springMessage('table.guaPledge.evaluationDep')</td>
                <td>
					<input  type="text"  id="evaluationDep" name="evaluationDep" class="layui-input">
				</td>
			</tr>
			<tr>
        		##数量
				<td class="textRight">#springMessage('table.guaPledge.amount')</td>
				<td >
                	<input  type="text"  id="amount" lay-verify="number2|strlength" name="amount" class="layui-input" data-maxlength="12" >
				</td>
				##规格
                <td class="textRight">#springMessage('table.guaPledge.specification')</td>
                <td>
					<input  type="text"  id="specification" name="specification" class="layui-input">
				</td>
			</tr>
			<tr>
        		##存放地点
				<td class="textRight">#springMessage('table.guaPledge.place')</td>
				<td >
                	<input  type="text"  id="place" name="place" class="layui-input">
				</td>
				##保管人
                <td class="textRight">#springMessage('table.guaPledge.keeper')</td>
                <td>
					<input  type="text"  id="keeper" name="keeper" class="layui-input">
				</td>
			</tr>
			<tr>
        		##调查人
				<td class="textRight">#springMessage('table.guaPledge.investigators')</td>
				<td >
                	<input  type="text"  id="investigators" name="investigators" class="layui-input">
				</td>
				##填报单位名称
                <td class="textRight">#springMessage('table.guaPledge.regCorp')</td>
				<td width="36%">
					<div class="layui-input-inline">
						<div class="bt-biz-corp"
							data-biz-type="corp"
							data-type="selectTree"
							data-name="regCorp"
							data-biz-name="regCorp"
							data-scope="all"
							data-required="false"
							data-resource="gua:pledge:info:apply"
							data-callback="corpRegCallback">
						</div>
					</div>
				</td>
			</tr>
			<tr>
				## 备注
				<td class="textRight">#springMessage('common.message.remark')</td>
				<td>
					<input type="text" id="rmk" name="rmk" class="layui-input">
				</td>
				<td></td>
				<td></td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('cms.loan.attachment')</td>
				<td style="text-align: center;" colspan="3">
					<!-- 附件上传 -->
					<input id="annexName" name="uploadId" type="hidden" value="">
			        <div id="uploader" class="layui-input-inline" style="width:100%"></div>
				</td>
			</tr>
			<tr>
				<td style="text-align: center;" colspan="4">
					<button class="layui-btn" lay-submit="" id="submit" value="11">#springMessage('common.button.submit')</button>
					<button class="layui-btn" lay-submit="" id="temp" value="0">#springMessage('common.button.temp')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaPledgeInfo.add.js?_btv=${resourceVersion}"></script>
</html>

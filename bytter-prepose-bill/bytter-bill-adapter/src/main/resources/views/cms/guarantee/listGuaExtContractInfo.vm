<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
            <tbody>
                <tr>
                    ##担保编号
					<td class="textRight" width="25%">#springMessage('table.guaContract.guaNo')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_guaNo" autocomplete="off" 
								class="layui-input" placeholder="#springMessage('table.guaContract.guaNo')">  
                        </div>
                    </td>
					##合同编号
                    <td class="textRight" width="25%">#springMessage('table.guaContract.contractCode')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_contractCode" autocomplete="off" 
								class="layui-input" placeholder="#springMessage('table.guaContract.contractCode')">  
                        </div>
                    </td>
                </tr>
                <tr>
                ##担保单位
                    <td class="textRight" width="25%">#springMessage('table.guaContract.guaPerson')</td>
                    <td width="25%">
                        <div class="layui-inline" >
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="ins_corpId"
                                 data-biz-name="ins_corpId"
                                 data-scope="all"
                                 data-resource="gua:extContract:info:query"##外担保合同登记: 查询权限
                                >
                            </div>
                        </div>
                    </td>
                ##债权人
                    <td class="textRight" width="25%">#springMessage('table.guaContract.creditorPerson')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_creditorPerson" autocomplete="off"
                                   class="layui-input" placeholder="#springMessage('table.guaContract.creditorPerson')">
                        </div>
                    </td>
                </tr>
				 <tr>
					 ##债务人
                     <td class="textRight" width="25%">#springMessage('table.guaContract.debtorPersonName')</td>
                     <td width="25%">
                         <input type="text" name="likes_debtorPerson" autocomplete="off"
                           class="layui-input" placeholder="#springMessage('table.guaContract.debtorPersonName')">
                     </td>
                    ##担保日期
					<td class="textRight" width="25%">#springMessage('table.guaContract.date')</td>
                    <td width="25%">
                        <div class="layui-inline">
							<input type="text" name="led_startDate" data-name="led_startDate"
								class="layui-input bt-input-inline bt-biz-dateType" data-endid="endDate" data-type="date">
                		</div>
						<span class="date-mid">#springMessage('table.guaContract.range')</span>
						<div class="layui-inline">
							<input type="text" name="ged_endDate"　data-name="ged_endDate"
								class="layui-input bt-input-inline bt-biz-dateType" id="endDate" data-type="date">
                		</div>
                    </td>
					</tr>
                <tr>
                ##担保额度
                    <td class="textRight">#springMessage('table.guaContract.sumMoney')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <input type="text" data-name="geg_guaMoney"
                                   autocomplete="off" class="layui-input bt-input-inline bt-biz-moneyType" style="text-align:right" data-moneyendid="guaMoney">
                        </div>
                        <span class="date-mid">#springMessage('table.guaContract.range')</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_guaMoney"
                                   autocomplete="off" class="layui-input bt-input-inline bt-biz-moneyType" style="text-align:right" id="guaMoney">
                        </div>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>	
    </form>  

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.guaContract.guaPerson')</th>##担保单位
                <th>#springMessage('table.guaContract.guaNo')</th>##担保编号
                <th>#springMessage('table.guaContract.guaType')</th>##担保方式
                <th>#springMessage('table.guaContract.debtorPersonName')</th>##债权人
                <th>#springMessage('table.guaContract.creditorPerson')</th>##债务人
				<th>#springMessage('table.guaContract.curId')</th>##币别
				<th>#springMessage('table.guaContract.sumMoney')</th>##担保额度
                <th>#springMessage('table.guaContract.contractCode')</th>##合同编号
				<th>#springMessage('table.guaContract.startDate')</th>##担保开始日期
				<th>#springMessage('table.guaContract.endDate')</th>##担保结束日期
                <th>#springMessage('table.guaContract.status')</th>##状态
                <th>#springMessage('table.drawdownPeriod.date')</th>##提款日期
				<th>#springMessage('common.table.thead.operation')</th>##操作
            </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaExtContractInfo.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	#rateInfo input {
    		text-align:right;
    	}
    	#rateInfo .bt-biz-rateType {
    		width:128px;
    	}
    
    </style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input type="hidden" id="bankCode" name="openCorp" value="$!{lgChangeInfoVo.openCorp}"/>
		<input type="hidden" id="applyCorp" value="$!{lgChangeInfoVo.corpId}" />
		<input type="hidden" id="guaraId" name="guaraId" value="$!{lgChangeInfoVo.guaraId}" />
		<input type="hidden" id="curId" name="curId" value="$!{lgChangeInfoVo.curId}" />
        <input type="hidden" id="bondCurId" name="bondCurId" value="$!{lgChangeInfoVo.bondCurId}" />
		<input type="hidden" id="bondMoneyOld" name="bondMoneyOld" value="$!{lgChangeInfoVo.bondMoneyOld}" />
		<input type="hidden" name="id" value="$!{lgChangeInfoVo.id}"/>
		<input type="hidden" id="corpId" name="corpId" valu="$!{lgChangeInfoVo.corpId}"/>
		##变更后保函金额用于暂存或提交时判断授信额度
		<input type="hidden" id="guaOldMoney" name="guaOldMoney" value="$!{lgChangeInfoVo.guaranteeMoneyOld}"/>
		<input type="hidden" id="isRat" value="$!{lgChangeInfoVo.ratmodel}"/>
		<table class="layui-table">
		<tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label><b>#springMessage('table.guaGuarantee.application')</b></label>
				</td>
			</tr>
        	<tr>
			 ##保函申请人
             <td class="textRight">#springMessage('table.guaGuarantee.applyPeople')</td>
				 <td>
                     <input type="text"  name="corpName"  autocomplete="off" class="layui-input" value="$!{lgChangeInfoVo.corpName}"
                             lay-verify="required" readonly="true">
				 </td>
##                 <div class="layui-input-inline">
##                     <div class="bt-biz-corp"
##                          data-biz-type="corp"
##                          data-type="selectTree"
##                          data-name="corpId"
##                          data-biz-name="corpId"
##                          data-scope="all"
##                          data-required="true"
##                          data-resource="gua:guarantee:change:apply"
##                          data-defaultvalue="$!{lgChangeInfoVo.corpId}"
##                          data-callback="bt.corpCallback">
##                     </div>
##                 </div>
        		##保函类型
				<td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.type')</td>
				<td>
					<div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.TypeAttr" data-defaultvalue="$!{lgChangeInfoVo.guaranteeType}"
						data-name="guaranteeType" data-biz-name="guaranteeType" data-required="true" data-disabled="true"></div>
				</td>
			</tr>
           <tr>
			    ##保函编号
               <td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.No')</td>
					<td>
                        <input type="text"  name="guaranteeNo"  autocomplete="off" class="layui-input" value="$!{lgChangeInfoVo.guaranteeNo}"
                               placeholder="#springMessage('table.guaGuarantee.No')" lay-verify="required" readonly="true">
##                        <div class="layui-input-inline">
##							<input type="text" id="guaranteeNo" name="guaranteeNo" lay-verify="required|tableData" data-biz-name="guaranteeNo" data-disabled="true"
##								 autocomplete="off" class="layui-input text" placeholder="#springMessage('table.guaGuarantee.No')" value="$!{lgChangeInfoVo.guaranteeNo}">
##							<table id="lgInfoTable" class="hide">
##								<thead>
##									<tr>
##										<th>#springMessage('table.guaGuarantee.No')</th>##保函编号
##										<th>#springMessage('table.guaGuarantee.type')</th>##保函类型
##										<th>#springMessage('table.guaGuarantee.openPeople')</th>##保函开立人
##                                        <th>#springMessage('table.guaGuarantee.beneficiary')</th>##保函受益人
##                                        <th>#springMessage('table.guaGuarantee.money')</th>##保函金额
##                                        </th>
##									</tr>
##								</thead>
##							</table>
##						</div>
				</td>
		    	##开立人类型
			 <td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.openPeopleType')</td>
              <td>
					<div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.openPeopleType"  data-name="openCorpType"
						data-biz-name="openCorpType" data-required="true" data-disabled="true" data-defaultvalue="$!{lgChangeInfoVo.openCorpType}"></div>
				<span>
				##开立方式
			   #springMessage('table.guaGuarantee.openWay')
			   <div class="bt-biz-dict" id="openWay" data-type="select" data-group="guarantee.Lg.openWay" data-defaultvalue="$!{lgChangeInfoVo.openWay}"
				data-name="openWay" data-biz-name="openWay" data-required="true" data-callback="openWayCallback" data-disabled="true"></div>
			   ##开立类型
			   #springMessage('table.guaGuarantee.openType')
			   <div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.openType"  data-name="openType" data-biz-name="openType" 
				data-required="true" disabled="disabled" data-disabled="true" data-defaultvalue="$!{lgChangeInfoVo.openType}"></div>
				</span>
			  </td>
		   </tr>
		   
        	<tr>
        		##保函开立人
				<td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.openPeople')</td>
				<td >
				 <input type="text" id="openCorpName" name="openCorpName"  autocomplete="off" class="layui-input"  value="$!{lgChangeInfoVo.openCorpName}"
					readonly="true" placeholder="#springMessage('table.guaGuarantee.openPeople')" lay-verify="required">				
				</td>
				##保函受益人
				<td class="textRight" width="14%">#springMessage('table.guaGuarantee.beneficiary')</td> 
				<td width="36%">
                    <input type="text" id="incomeCorp" name="incomeCorp"  autocomplete="off" class="layui-input" value="$!{lgChangeInfoVo.incomeCorp}"
						placeholder="#springMessage('table.guaGuarantee.beneficiary')" lay-verify="required" readonly="true">				
                </td>
			</tr>
			<tr>
				##币别
                <td class="textRight">#springMessage('table.guaGuarantee.curId')</td>
                <td>
					 <input class="layui-input curName"  name="curName"  readonly="readonly" autocomplete="off" value="$!{lgChangeInfoVo.curName}" lay-verify="required">
				</td>
        		##保函金额
				<td class="textRight">#springMessage('table.guaGuarantee.money')</td>
				<td >
                	<input type="text" id="guaranteeMoneyOld" name="guaranteeMoneyOld" data-decimal="2"  value="$!{lgChangeInfoVo.guaranteeMoneyOld}"
						class="layui-input bt-biz-moneyType" data-biz-name="guaranteeMoneyOld" lay-verify="required" readonly="true">
				</td>
				
			</tr>
			<tr>
        		##保函性质
				<td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.lgNature')</td>
				<td >
				 <div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.nature" data-defaultvalue="$!{lgChangeInfoVo.guaranteeAttr}" data-name="guaranteeAttr" data-biz-name="guaranteeAttr" data-required="true" data-disabled="true"> </div>
				</td>
				##保函预计结束日期
				<td class="textRight">#springMessage('table.guaGuarantee.expectEndDate')</td>
				<td >
                    <input type="text" name="expectEndDateOld"　data-name="expectEndDateOld"    value="$!date.format('yyyy-MM-dd',$!{lgChangeInfoVo.expectEndDateOld})"
                           class="layui-input bt-biz-dateType" id="expectEndDateOld"  data-endid="expectEndDate" data-type="date" readonly="true">
				</td>
			</tr>
			<tr>
        		##保函开始时间
				<td class="textRight">#springMessage('table.guaGuarantee.startDate')</td>
				<td >
                    <input type="text" name="startDate" data-name="startDate"  id="startDate" readonly="true" value="$!date.format('yyyy-MM-dd',$!{lgChangeInfoVo.startDate})"
                           data-biz-name="startDate"	 class="layui-input bt-biz-dateType"  data-type="date" lay-verify="required">
				</td>
				##保函截止时间
                <td class="textRight">#springMessage('table.guaGuarantee.endDate')</td>
                <td>
                    <input type="text" name="endDateOld"　data-name="endDateOld"  readonly="true" value="$!date.format('yyyy-MM-dd',$!{lgChangeInfoVo.endDateOld})"
                           class="layui-input bt-biz-dateType" id="endDateOld"  data-endid="endDate" data-type="date" >
				</td>
			</tr>
			<tr style="display:none";>
				 ##转开行
                <td class="textRight">#springMessage('table.guaGuarantee.turnBank')</td>
                <td>
				    <input type="text" id="turnBank" name="turnBank"  class="layui-input" placeholder="#springMessage('table.guaGuarantee.turnBank')">
				</td>
                <td></td>
				<td></td>
			</tr>
			##保证金相关信息
			#if($!{isHangBail}=="1")
            <tr id="isShowBondInfo">
                <td class="textRight" width="15%">#springMessage('table.fcBond.bondAcc')</td>
                <td><input type="text" id="bondAcc"  autocomplete="off" class="layui-input"
                           readonly="true" value="$!{lgChangeInfoVo.bondAcc}">
                </td>
                <td class="textRight" width="15%">#springMessage('table.fcBond.contractNum')</td>
                <td><input type="text" id="bondContract" autocomplete="off" class="layui-input"
                           readonly="true" value="$!{lgChangeInfoVo.bondContract}">
                </td>
            </tr>
			#end
			##挂接授信开始
			#if($!{urationDTO})
            <input type="hidden" name="billName" id="billName" value="$!{urationDTO.billName}">
				<tr>
				##授信品种
                    <td class="textRight">#springMessage('table.guarantee.ratItemCode')</td>
                    <td >$!{urationDTO.ratItemName}</td>
				##授信业务品种名称
                    <td class="textRight">#springMessage('cms.business.race')</td>
                    <td>$!{urationDTO.raceName}</td>
				</tr>
			<tr>
			##是否折合本位币
				#if($!{naturalSign}=="0")
                    <td class="textRight" >#springMessage('table.cmsProvideLoanInfo.isRmbRat')</td>
                    <td>$!dictTag.get("sf_yn",$!{lgChangeInfoVo.isRmbRat})</td>
				#end
				##授信额度单
				<td class="textRight">#springMessage('table.guarantee.rationSelect')</td>
				<td>
					<div class="layui-input-inline">
						#if($!{lgChangeInfoVo.ratmodel} == "1")
						<div id="rationBtn">
							<button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
						</div>
						#else
						<div style="display: none" id="rationBtn">
							<button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
						</div>
						#end
					</div>
					##额度编号
                    ##占用授信代码
					<span id="itemCodeTd">
						<input type="hidden" name="ratCode" id="ratCode" value="$!{urationDTO.ratCode}">
						<input type="hidden" name="itemFlag" id="itemFlag" value="$!{urationDTO.itemFlag}">
						<input type="hidden" name="itemMoney" id="itemMoney" value="$!{urationDTO.money}">
						<input type="hidden" name="ratItemCode" id="ratItemCode" value="$!{urationDTO.ratItemCode}">
						<input type="hidden" name="ratCurId" id="ratCurId" value="$!{urationDTO.curCode}">
						#if($!{urationDTO.itemFlag} == "0")
<!-- 						<input type="hidden" name="ratItemCode" id="ratItemCode" value="$!{urationDTO.ratItemCode}"> -->
						#else
							#foreach($applyDtl in $!{urationDTO.applyDtls})
								#set($vcount = $velocityCount - 1)
								<input type="hidden" name="applyDtls[$!{vcount}].itemCode" id="itemCode$!{vcount}" value="$!{applyDtl.itemCode}">
								<input type="hidden" name="applyDtls[$!{vcount}].itemMoney" itemCode="$!{applyDtl.itemCode}" id="itemMoney$!{vcount}" value="$!{applyDtl.useMaxMoney}">
							#end
						#end
					</span>		
				</td>
			</tr>
				<tr>
                    <td class="textRight">#springMessage('gua.start.Openrat')</td>##是否启用敞口授信
                    <td>$!dictTag.get("sf_yn",$!{urationDTO.isOpenRat})</td>
                    <td></td>
                    <td></td>
				</tr>
			#end
			##挂接授信结束
			
			</tbody>
        </table>
		<table class="layui-table">
		 <tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label><b>#springMessage('table.guaGuarantee.changeMsg')</b></label>
				</td>
			</tr>
			<tr>
				##保函更改申请日期
				<td class="textRight" width="11%">#springMessage('table.guaGuarantee.lgChangedate')</td>
				<td width="28%">
                    <input id="inputDate" name="changeDate" value="$!date.format('yyyy-MM-dd',$!{lgChangeInfoVo.changeDate})" readonly="readonly"
                           autocomplete="off" class="layui-input" lay-verify="required">
				</td>
				##保函变更单号
				<td class="textRight" width="12%">#springMessage('table.guaGuarantee.lgChangeNo')</td>
				<td> 
				   <input id="guaraChangeNo" name="guaraChangeNo" value="$!{lgChangeInfoVo.guaraChangeNo}" readonly="readonly" autocomplete="off" class="layui-input" lay-verify="required">
				</td>
			</tr>
			<tr>
				##保函更改次数
				<td class="textRight">#springMessage('table.guaGuarantee.lgChangeNum')</td>
				<td> 
				   <input id="changeCount" name="changeCount"  value="$!{lgChangeInfoVo.changeCount}"readonly="readonly" autocomplete="off" class="layui-input">
				</td>
				##币别
##                <td class="textRight">#springMessage('table.guaGuarantee.curId')</td>
##                <td>
##					 <input class="layui-input curName"  name="curName"  readonly="readonly" autocomplete="off" value="$!{lgChangeInfoVo.curName}">
##				</td>
                    <td class="textRight">#springMessage('table.urationapply.bondCurId')</td>
                    <td>
						$!{lgChangeInfoVo.bondCurName}
                    </td>
			</tr>
			<tr>
        		##新截止日期
				<td class="textRight">#springMessage('table.guaGuarantee.newEndDate')</td>
				<td >
                    <input type="text" name="endDate" data-name="endDate"  id="endDate" value="$!date.format('yyyy-MM-dd',$!{lgChangeInfoVo.endDate})"
                           class="layui-input bt-biz-dateType"  data-type="date" >
				</td>
				##新预计结束日期
				<td class="textRight">#springMessage('table.guaGuarantee.newExpectEndDate')</td>
				<td >
                    <input type="text" id="expectEndDate" name="expectEndDate"　data-name="expectEndDate"  value="$!date.format('yyyy-MM-dd',$!{lgChangeInfoVo.expectEndDate})"
                           class="layui-input bt-biz-dateType"  data-type="date" >
				</td>
			</tr>
			<tr>
        		##保函金额调整类型
				<td class="textRight">#springMessage('table.guaGuarantee.lgChangeType')</td>
				<td >
				 <div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.ChangeType"  data-callback="calLgMoney"
					data-defaultvalue="$!{lgChangeInfoVo.guaChangeType}" data-name="guaChangeType" data-biz-name="guaChangeType" ></div>
				</td>
				##保函保证金调整类型
				<td class="textRight">#springMessage('table.guaGuarantee.bondChangeType')</td>
				<td >
				 <div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.ChangeType" data-defaultvalue="$!{lgChangeInfoVo.bondChangeType}"
					data-name="bondChangeType" data-biz-name="bondChangeType" data-callback="calLgBondMoney" ></div>
				</td>
			</tr>
			<tr>
        		##保函调整金额
				<td class="textRight">#springMessage('table.guaGuarantee.lgChangeMoney')</td>
				<td >
                	<input type="text" id="guaChangeMoney" name="guaChangeMoney" data-decimal="2" class="layui-input bt-biz-moneyType" 
						data-biz-name="guaChangeMoney"  value="$!{lgChangeInfoVo.guaChangeMoney}" data-callback="calLgMoney">
				</td>
				##保证金调整金额
				<td class="textRight">#springMessage('table.guaGuarantee.bondChangeMoney')</td>
				<td >
                	<input type="text" id="bondChangeMoney" name="bondChangeMoney" data-decimal="2" class="layui-input bt-biz-moneyType" 
						data-biz-name="bondChangeMoney"  value="$!{lgChangeInfoVo.bondChangeMoney}" data-callback="calLgBondMoney">
				</td>
			</tr>
			<tr>
        		##调整后保函金额
				<td class="textRight">#springMessage('table.guaGuarantee.moneySum')</td>
				<td >
					<input type="text" id="guaranteeMoney" name="guaranteeMoney"  data-decimal="2" class="layui-input textRight bt-biz-moneyType" 
					data-biz-name="guaranteeMoney"  readonly="true" value="$!{lgChangeInfoVo.guaranteeMoney}">
				</td>
				##调整后保证金
				<td class="textRight">#springMessage('table.guaGuarantee.bondMoneySum')</td>
				<td >
                	<input type="text" id="bondMoney" name="bondMoney" data-decimal="2" class="layui-input bt-biz-moneyType"
						data-biz-name="bondMoney"  readonly="true" value="$!{lgChangeInfoVo.bondMoney}">
				</td>
			</tr>
			<tr>
        		##调整后保函手续费金额
				<td class="textRight">#springMessage('table.guaGuarantee.hanleChargeSum')</td>
				<td >
                	<input type="text" id="handleCharge" name="handleCharge" data-decimal="2" class="layui-input bt-biz-moneyType" 
						data-biz-name="handleCharge"  value="$!{lgChangeInfoVo.handleCharge}">
				</td>
				##修改条款
				<td class="textRight">#springMessage('table.guaGuarantee.changeTerm')</td>
				<td >
					<input type="text" id="changeTerm" name="changeTerm"  class="layui-input" value="$!{lgChangeInfoVo.changeTerm}">
				</td>
			</tr>
			<tr>
				##修改原因
				<td class="textRight">#springMessage('table.guaGuarantee.changeReason')</td>
				<td >
					<input type="text" id="changeReason" name="changeReason"  class="layui-input" value="$!{lgChangeInfoVo.changeReason}">
				</td>
				##经办人
				<td class="textRight">#springMessage('table.guaGuarantee.operator')</td>
				<td >
					<input type="text" id="operator" name="operator"  class="layui-input" lay-verify="required" value="$!{lgChangeInfoVo.operator}">
				</td>
			</tr>
			<tr>
				<td style="text-align: center;" colspan="4">
					<button class="layui-btn" lay-submit="" id="submit" value="11">#springMessage('common.button.submit')</button>
					<button class="layui-btn" lay-submit="" id="temp" value="0">#springMessage('common.button.temp')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaGuaranteeChangeInfo.edit.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationSet.js?_btv=${resourceVersion}"></script>
</html>
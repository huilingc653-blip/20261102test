<!DOCTYPE html>
    #set($basePath=$springMacroRequestContext.contextPath)
<html>
<head lang="en">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no"/>
    <meta charset="UTF-8">
    <title>担保方式占用轨迹</title>
    <link rel="stylesheet" href="${basePath}/static/mobile/plugins/fixedTable/table.min.css"/>
    <style>
        th {
            font-size: 0.14rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(255,251,223,1);
            line-height: 14px;
        }
        td{
            font-size:0.12rem;
            font-family:PingFangSC-Medium,PingFang SC;
            font-weight:500;
            color:rgba(102,102,102,1);
            line-height:12px;
        }
    </style>
</head>
<body>
<div class="data-table" >
    <!--1.0 冻列 -->
    <div class="t_l">
        <!--1.1 冻结列表头-->
        <table>
            <tbody>
            <tr>
                <th>担保编号</th>
            </tr>
            </tbody>
        </table>
        <!--1.2 冻结列表体-->
        <div class="t_l_freeze" >
            <table>
                <tbody>
                    #foreach(${track} in $!{trackList})
                    <tr>
                        <td align="center" class="td" >$!{track.guaNo}</td>
                    </tr>
                    #end
                </tbody>

            </table>
        </div>
    </div>
    <!--2.0 表格-->
    <div class="t_r">
        <!--2.1　冻结行表头-->
        <div class="t_r_t">
            <table  style="width:1200px">
                <tbody>
                <tr>
                    <th style="width:150px">合同编号</th>
                    <th>担保方式</th>
                    <th style="width:150px">抵质押物编号</th>
                    <th>抵质押物名称</th>
                    <th>评估值</th>
                    <th style="width:190px">日期</th>
                    <th>类型</th>
                    <th style="width:160px">释放时间</th>
                    <th>额度</th>
                </tr>
                </tbody>
            </table>
        </div>
        <!--2.2 表格中心内容区域-->
        <div class="t_r_content">
            <table style="width:1200px" >
                <tbody>
                    #foreach(${track} in $!{trackList})
                    <tr>
                        <td align="center" class="td" style="width:150px">$!{track.contractCode}</td>
                        <td align="center" class="td">$!{track.guaWayName}</td>
                        #if($!{track.pledgeAttr}=='0'||$!{track.pledgeAttr}=='1')
                            <td align="center" class="td" style="width:150px">$!{track.pledgeNo}</td>
                            <td align="center" class="td">$!{track.pledgeName}</td>
                            <td align="right" class="td">$!number.formatNumeric($!{track.pledgeMoney})</td>
                            <td align="center" class="td" style="width:190px">$!{track.startDate}~$!{track.endDate}</td>
                        #else
                            <td align="center" class="td"></td>
                            <td align="center" class="td"></td>
                            <td align="center" class="td"></td>
                            <td align="center" class="td"></td>
                        #end
                        <td align="center" class="td">$dictTag.get("gua.WayStatus", $!{track.trackType})</td>
                        <td align="center" class="td" style="width:160px">$!date.format("yyyy-MM-dd HH:mm:ss",$!{track.createTime})</td>
                        <td align="right" class="td">$number.formatNumeric($!{track.money})</td>
                    </tr>
                    #end
                </tbody>
            </table>
        </div>
    </div>
</div>
</body>
<script src="${basePath}/static/plugins/jquery/jquery.min.js"></script>
<script src="${basePath}/static/mobile/plugins/fixedTable/iscroll-probe.min.js"></script>
<script src="${basePath}/static/mobile/plugins/fixedTable/table.min.js"></script>
</html>
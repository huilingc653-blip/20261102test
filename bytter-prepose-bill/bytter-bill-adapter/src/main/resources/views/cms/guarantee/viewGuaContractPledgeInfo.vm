<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="" id="inputForm">
	<table  class="layui-table layui-form" style="width:100%;">
    <thead>
	<tr>
         <td class="textLeft" colspan="15">#springMessage('table.guaPledge.occupyInfo')</td>
	</tr>
    <tr>
        <th>#springMessage('table.fcBond.orderNo')</th>
        <th>#springMessage('table.guaPledge.pledgeNo')</th>
        <th>#springMessage('table.guaPledge.pledgeName')</th>
        <th>#springMessage('table.guaPledge.pledgeAttr')</th>
		<th>#springMessage('table.guaContract.htNo')</th>
		<th>#springMessage('table.guaContractInfo.startDate')</th>
		<th>#springMessage('table.guaContractInfo.endDate')</th>
		<th>#springMessage('table.guaContract.corpId')</th>
		<th>#springMessage('table.guaContract.guaNo')</th>
		<th>#springMessage('table.guaContract.guaType')</th>
		<th>#springMessage('table.guaContract.guaPerson')</th>
		<th>#springMessage('table.guaContract.debtorPersonName')</th>
		<th>#springMessage('table.guaContract.creditorPerson')</th>
		<th>#springMessage('table.guaContract.curId')</th>
		<th>#springMessage('table.guaPledge.occupyMoney')</th>
    </tr>
    </thead>
	#foreach($obj in $listInfo)
	<tr>
		<td style="text-align:center">$velocityCount</td>
		<td style="text-align:center">$!{obj.pledgeNo}</td>
		<td style="text-align:center">$!{obj.pledgeName}</td>
		<td style="text-align:center">$dictTag.get("pledge_type",$!{obj.pledgeAttr})</td>
		<td style="text-align:center">$!{obj.contractCode}</td>
		<td style="text-align:center">$!date.format('yyyy-MM-dd',$!{obj.startDate})</td>
		<td style="text-align:center">$!date.format('yyyy-MM-dd',$!{obj.endDate})</td>
		<td style="text-align:center">$!{obj.corpName}</td>
		<td style="text-align:center">$!{obj.guaNo}</td>
		<td style="text-align:center">$!{obj.guaTypeName}</td>
		<td style="text-align:center">$!{obj.guaPerson}</td>
		<td style="text-align:center">$!{obj.debtorPersonName}</td>
		<td style="text-align:center">$!{obj.creditorPerson}</td>
		<td style="text-align:center">$!{obj.curName}</td>
		<td style="text-align:right">$number.formatNumeric($!{obj.guaMoney})</td>
	</tr>
	#end
        <tr>
            <td colspan="15" style="text-align: center;">
                <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
            </td>
            </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
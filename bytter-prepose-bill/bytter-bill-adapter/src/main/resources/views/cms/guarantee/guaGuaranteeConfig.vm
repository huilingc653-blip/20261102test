<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>

<form class="layui-form" action="">

    <table class="layui-table">
        <thead>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
            <td width="80%">#springMessage('config.fbs.paramValue')</td>
        </tr>
        </thead>
        <tbody>
            ##是否挂银行授信
        <tr>
            <td width="20%" class="textRight">#springMessage('gua.related.rat')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="radio" name="gua.rat_Contains" value="0" #if($config.gua.rat_Contains == 0)checked#end CHECKED=""  title="#springMessage('gua.sc_rat.no')">
                    <input type="radio" name="gua.rat_Contains" value="1" #if($config.gua.rat_Contains == 1)checked#end title="#springMessage('gua.sc_rat.yes')">
                </div>
            </td>
        </tr>
            ##是否启用银行授信敞口
        <tr>
            <td width="20%" class="textRight">#springMessage('gua.start.Openrat')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="radio" name="gua.start_Openrat" value="0" #if($config.gua.start_Openrat == 0)checked#end CHECKED=""  title="#springMessage('common.sc_yn.no')">
                    <input type="radio" name="gua.start_Openrat" value="1" #if($config.gua.start_Openrat == 1)checked#end title="#springMessage('common.sc_yn.yes')">
                </div>
            </td>
        </tr>
            ##保函是否挂保证金
        <tr>
            <td width="20%" class="textRight">#springMessage('config.gua.isHangBail')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="radio" name="gua.is_HangBail" value="0" #if($!{config.gua.is_HangBail}=="0")checked#end title="#springMessage('common.sc_yn.no')">
                    <input type="radio" name="gua.is_HangBail" value="1" #if($!{config.gua.is_HangBail}=="1")checked#end title="#springMessage('common.sc_yn.yes')">
                </div>
            </td>
        </tr>

            ##保函到期天数
        <tr>
            <td class="textRight">#springMessage('table.guaGuarantee.notifyDays')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="gua.notify_Days" class="layui-input bt-biz-moneyType" data-decimal="0"
                           value="$!{config.gua.notify_Days}" data-min="10" data-minus="false" title="#springMessage('table.guaGuarantee.notifyDays')">
                </div>
                <span style="font-size: 12px; color: red">#springMessage('config.gua.notifyDaysRmk')</span>
            </td>
        </tr>
        <tr>

        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        <tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form','jquery','moneyType'], function(){
        var form = bt.form(),$  = bt.jquery;
        bt.moneyType.init();
        //监听提交
        form.on('submit(configSubmit)', function(data){
            $.post(basePath + "/sys/config/save",data.field,function(result){
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },"JSON");
            return false;
        });
    });
</script>
</body>
</html>
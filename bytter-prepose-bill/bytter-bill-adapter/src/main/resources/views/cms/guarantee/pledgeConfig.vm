<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

</head>
<body>
<form action="" style="padding: 0px 20px;" class="layui-form layui-form-pane">

    <table class="layui-table ">
        <tbody>
            <tr>
                <td class="textRight" width="20%">#springMessage('config.common.paramName')</td>
                <td width="80%">#springMessage('config.common.paramValue')</td>
            </tr>

            ##即将到期提醒天数
            <tr id="conConfig">
                <td class="textRight">#springMessage('pledge.manyTimes')</td>
                <td>
                    <input title="#springMessage("common.sc_yn.yes")" name="pledge.manyTimes" value="1"
                           #if($config.pledge.manyTimes == 1)checked#end type="radio">
                    <div class="layui-unselect layui-form-radio layui-form-radioed">
                        <i class="layui-anim layui-icon"> </i>
                        <span>#springMessage("common.sc_yn.yes")</span>##是
                    </div>

                    <input title="#springMessage("common.sc_yn.no")" name="pledge.manyTimes" value="0"
                           #if($config.pledge.manyTimes == 0)checked#end type="radio">
                    <div class="layui-unselect layui-form-radio layui-form-radioed">
                        <i class="layui-anim layui-icon"> </i>
                        <span>#springMessage("common.sc_yn.no")</span>##否
                    </div>
                </td>
            </tr>
        </tbody>
    </table>

    <br/><br/>
    <!-- 按钮 -->
    <div style="text-align: center;">
        <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage(
            'common.button.submit')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    </div>


</form>
    #parse("views/common/footer.vm")
<script>
    var ck,ck1,ck2;
    bt.use(['form', 'jquery', 'moneyType','dicts','checkboxs'], function () {
        var form = bt.form(), $ = bt.jquery;
        bt.moneyType.init();
        bt.dicts.init();
        //监听提交
        form.on('submit(configSubmit)', function (data) {
            bt.loading.show();
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                bt.loading.hide();
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, "JSON");
            return false;
        });
    });

</script>


</body>
</html>
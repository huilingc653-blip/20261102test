<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	#rateInfo input {
    		text-align:right;
    	}
    	#rateInfo .bt-biz-rateType {
    		width:128px;
    	}
    
    </style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input type="hidden" id="id" name="id" value="$!{LgInfoVo.id}"/>
		<input type="hidden" id="openWay" value="$!{LgInfoVo.openWay}"/>
		<input type="hidden" name="curId" id="curId" value="$!{LgInfoVo.curId}"/>
		<input type="hidden" name="openCorp" id="openCorp" value="$!{LgInfoVo.openCorp}"/>
		<input type="hidden" name="stratDate" id="startDate" value="$!{LgInfoVo.startDate}"/>
		<input type="hidden" name="corpId" id="corpId" value="$!{LgInfoVo.corpId}"/>
		<table class="layui-table">
		<tbody>
        	<tr>
        		##保函编号
				<td class="textRight" width="14%">#springMessage('table.guaGuarantee.No')</td>
				<td width="36%">
                    $!{LgInfoVo.guaranteeNo}			
                </td>
        		##保函类型
				<td class="textRight">#springMessage('table.guaGuarantee.type')</td>
				<td>
					$dictTag.get("guarantee.Lg.TypeAttr", "$!{LgInfoVo.guaranteeType}")
				</td>
			</tr>
           <tr>
		  ##保函申请人
           <td class="textRight">#springMessage('table.guaGuarantee.applyPeople')</td>
			<td>
				$!{LgInfoVo.corpName}
			</td>
			##开立人类型
			 <td class="textRight">#springMessage('table.guaGuarantee.openPeopleType')</td>
              <td>
              	$dictTag.get("guarantee.Lg.openPeopleType", "$!{LgInfoVo.openCorpType}")
              	&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
				<span>
					##开立方式
				   #springMessage('table.guaGuarantee.openWay')&nbsp;&nbsp;
				   $dictTag.get("guarantee.Lg.openWay", "$!{LgInfoVo.openWay}")
				</span>
			  </td>
		   </tr>
		   
        	<tr>
        		##保函开立人
				<td class="textRight">#springMessage('table.guaGuarantee.openPeople')</td>
				<td >
					$!{LgInfoVo.openCorpName}
				</td>
				##保函受益人
				<td class="textRight" width="14%">#springMessage('table.guaGuarantee.beneficiary')</td>
				<td width="36%">
                    $!{LgInfoVo.incomeCorp}
                </td>
			</tr>
			<tr>
				##币别
                <td class="textRight">#springMessage('table.guaPledge.curId')</td>
                <td>
					 $!{LgInfoVo.curName}
				</td>
        		##保函金额
				<td class="textRight">#springMessage('table.guaGuarantee.money')</td>
				<td >
                	$number.formatNumeric($!{LgInfoVo.guaranteeMoney})
				</td>
				
			</tr>
			<tr>
        		##保函性质
				<td class="textRight">#springMessage('table.guaGuarantee.lgNature')</td>
				<td>
				 	$dictTag.get("guarantee.Lg.nature", "$!{LgInfoVo.guaranteeAttr}")
				</td>
				##保证事项
                <td class="textRight">#springMessage('table.guaGuarantee.expectEndDate')</td>
                <td>
				   $!date.format('yyyy-MM-dd',$!LgInfoVo.expectEndDate)
				</td>
			</tr>
			<tr>
        		##保函开始时间
				<td class="textRight">#springMessage('table.guaGuarantee.startDate')</td>
				<td >
                	$!date.format('yyyy-MM-dd',$!LgInfoVo.startDate)
				</td>
				##保函截止时间
                <td class="textRight">#springMessage('table.guaGuarantee.endDate')</td>
                <td>
					$!date.format('yyyy-MM-dd',$!LgInfoVo.endDate)
				</td>
			</tr>
        </tbody>
        </table>
		#if($!{isHangBail}=="1")
		##保证金信息
            <h2 class="layui-colla-title">#springMessage('table.fcBond.BondMsg')</h2>
			#if(${LgInfoVo.isHookBond}=="1")
				#set($fcBondApplyDTO=$fcBondTag.getBondApplyDetail($!{LgInfoVo.id},$!{LgInfoVo.guaranteeNo}))
				#set($fcBondRate=($!{LgInfoVo.bondRate}))
				#parse("views/common/viewFcBondDetail.vm")

			#else
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td class="textRight" width="14%">#springMessage('table.fcBond.corpName')</td>
                        <td>$!{LgInfoVo.corpName}</td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td class="textRight" width="14%">#springMessage('table.fcBond.contractNum')</td>
                        <td>$!{LgInfoVo.bondContract}</td>
                        <td class="textRight" width="14%">#springMessage('table.fcBond.curCode')</td>
                        <td>$!{LgInfoVo.curName}</td>
                    </tr>
                    <tr>
                        <td class="textRight" width="14%">#springMessage('table.fcBond.bondmoney')</td>
                        <td>$!number.formatNumeric($!{LgInfoVo.bondMoney})</td>
                        <td class="textRight" width="14%">#springMessage('table.fcBond.bondPercent')</td>
						#set($bondPercent=$!{LgInfoVo.bondPercent}*100)
                        <td>$!number.formatDoubles($!bondPercent,2)%</td>
                    </tr>
                    <tr>
                        <td class="textRight" width="14%">#springMessage('table.fcBond.bondRate')</td>
						#set($bondRate=$!{LgInfoVo.bondRate}*100)
                        <td width="36%">$number.formatNumeric($!bondRate,"#0.0000")%</td>
                        <td width="14%"></td>
                        <td></td>
                    </tr>
                    </tbody>
                </table>
			#end
			#end
        <table class="layui-table">
            <tbody>
			##挂接授信开始
			#if($!{urationDTO})
            <h2 class="layui-colla-title">#springMessage('table.cms.ratApplyMsg')</h2>
			<tr>
				##授信品种
                    <td class="textRight" width="14%">#springMessage('table.guarantee.ratItemCode')</td>
                    <td width="36%">$!{urationDTO.ratItemName}</td>
				##授信业务品种名称
                    <td class="textRight" width="14%">#springMessage('cms.business.race')</td>
                    <td>$!{urationDTO.raceName}</td>
			</tr>
				<tr>
				##授信额度单
                    <td class="textRight" width="14%">#springMessage('table.guarantee.rationSelect')</td>
                    <td colspan="3">
                        <div class="layui-input-inline">
							#if($!{LgInfoVo.ratmodel} == "1")
                                <div id="rationBtn">
                                    <button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
                                </div>
							#else
                                <div style="display: none" id="rationBtn">
                                    <button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
                                </div>
							#end
                        </div>
					##额度编号
					##占用授信代码
                        <span id="itemCodeTd">
						<input type="hidden" name="ratCode" id="ratCode" value="$!{urationDTO.ratCode}">
						<input type="hidden" name="itemFlag" id="itemFlag" value="$!{urationDTO.itemFlag}">
						<input type="hidden" name="itemMoney" id="itemMoney" value="$!{urationDTO.money}">
						<input type="hidden" name="ratItemCode" id="ratItemCode" value="$!{urationDTO.ratItemCode}">
							#if($!{urationDTO.itemFlag} == "0")
                                <!-- 						<input type="hidden" name="ratItemCode" id="ratItemCode" value="$!{urationDTO.ratItemCode}"> -->
							#else
								#foreach($applyDtl in $!{urationDTO.applyDtls})
									#set($vcount = $velocityCount - 1)
                                    <input type="hidden" name="applyDtls[$!{vcount}].itemCode" id="itemCode$!{vcount}" value="$!{applyDtl.itemCode}">
								<input type="hidden" name="applyDtls[$!{vcount}].itemMoney" itemCode="$!{applyDtl.itemCode}" id="itemMoney$!{vcount}" value="$!{applyDtl.useMaxMoney}">
								#end
							#end
					</span>
                    </td>
				</tr>
			#end
			##挂接授信结束
			
			<tr>
        		##注销
				<td class="center" colspan="4"><b>#springMessage('table.guaGuarantee.logout.info')</b></td>
			</tr>
			<tr>
        		##注销时间
				<td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.logoutDate')</td>
				<td >
                	<input type="text" name="logoutDate" data-name="logoutDate"
								class="layui-input bt-biz-dateType" data-min="$!{LgInfoVo.startDate}" data-type="date" lay-verify="required">
				</td>
                <td></td>
                <td></td>
			</tr>
			<tr>
		      <td class="textRight">#springMessage('netbank.common.attachment')</td>
      	      <td colspan="3">
      		   <!-- 附件上传 -->
			  <input id="annexNameInfo" name="annexNameInfo" type="hidden" value="$!{LgInfoVo.attachmentId}">
	          <div id="uploaderInfo" class="layui-input-inline" style="width:100%"></div>
            </td>
	       </tr>
			<tr>
				<td style="text-align: center;" colspan="4">
					<button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaGuaranteeInfo.logout.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationSet.js?_btv=${resourceVersion}"></script>
</html>

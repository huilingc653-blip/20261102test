<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
</form>
<div>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.ratBkration.guaType')</th>##担保类型
        <th>#springMessage('table.guaContract.guaNo')</th>
        <th>#springMessage('table.guaContract.contractCode')</th>
        <th>#springMessage('table.guaContract.guaType')</th>
        <th>#springMessage('table.guaPledge.pledgeNo')</th>
        <th>#springMessage('table.guaPledge.pledgeName')</th>
        <th>#springMessage('table.guaPledge.pledgeMoney')</th>
        <th>#springMessage('table.guaPledge.pledgeDate')</th>
        <th>#springMessage('table.guaContract.trackType')</th>
        <th>#springMessage('table.guaContract.trackDate')</th>
        <th>#springMessage('table.guaContract.trackMoney')</th>
    </tr>
    </thead>
#foreach($track in $!{trackList})
	<tr>
        <td align="center">$!{track.conTypeName}</td>
		<td align="center">$!{track.guaNo}</td>
		<td align="center">$!{track.contractCode}</td>
		<td align="center">$!{track.guaWayName}</td>
		#if($!{track.pledgeAttr}=='0'||$!{track.pledgeAttr}=='1')
		<td align="center">$!{track.pledgeNo}</td>
		<td align="center">$!{track.pledgeName}</td>
		<td align="right">$number.formatNumeric($!{track.pledgeMoney})</td>
		<td align="center">$!{track.startDate}~$!{track.endDate}</td>
		#else
		<td align="center"></td>
		<td align="center"></td>
		<td align="right"></td>
		<td align="center"></td>
		#end
		<td align="center">$dictTag.get("gua.WayStatus", $!{track.trackType})</td>
		<td align="center">$!date.format("yyyy-MM-dd HH:mm:ss",$!{track.createTime})</td>
		<td align="right">$number.formatNumeric($!{track.money})</td>
	</tr>
#end
</table>
</div>
<div style="width: 100%;text-align: center;">
    <button class="layui-btn" lay-submit="" lay-filter="close">#springMessage('common.button.close')</button>
</div>
#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form','jquery'], function(){
        $ = bt.jquery,form = bt.form();
        //监听提交
        form.on('submit(close)', function(data){
            if(!bt.navtab){
                parent.layer?parent.layer.closeAll():layer.closeAll();
            } else {
                //bt.navtab.refreshParent();
                bt.navtab.closeCurrent();
            }
            return false;
        });
    });
</script>
</html>

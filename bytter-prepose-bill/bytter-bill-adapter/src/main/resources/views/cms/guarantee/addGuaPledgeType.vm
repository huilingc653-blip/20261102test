<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{ratCreditTypePage.id}">
		<input id="status" name="status" type="hidden" value="0">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##抵质押物类型编码
				<td class="textRight">#springMessage('table.guaPledge.typeCode')</td>
				<td width="40%">
                        <input type="text" id="typeCode" name="typeCode" maxlength="10" lay-verify="required|strlength" data-maxlength="10"
							   onblur="checkNO(this)"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.guaPledge.typeCode')">
				</td>
        		##抵质押物类型
				<td class="textRight">#springMessage('table.guaPledge.pledgeType')</td>
				<td width="40%">
                        <input type="text" id="typeName" name="typeName" lay-verify="required|strlength" data-maxlength="100"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.guaPledge.pledgeType')">
				</td>
			</tr>
            <tr>
				##抵质押物性质
				<td class="textRight">#springMessage('table.guaPledge.pledgeAttr')</td>
				<td colspan="3">
					<div class="bt-biz-dict" data-type="radio" data-group="pledge_type" data-defaultvalue="0" 
						data-name="typeAttr" data-biz-name="typeAttr" ></div>	
				</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaPledgeType.add.js?_btv=${resourceVersion}"></script>
</html>
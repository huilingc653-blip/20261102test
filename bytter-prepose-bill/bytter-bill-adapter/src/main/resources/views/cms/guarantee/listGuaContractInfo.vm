<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>

        <tr>
            ## 融资主体
            <td class="textRight">#springMessage('table.guaContract.corpId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="likes_corpId"
                         data-scope="all"
                         data-resource="gua:contract:info:query"
                         placeholder="#springMessage('common.placeholder.select')"></div>
                </div>
            </td>
            ##担保编号
            <td class="textRight" width="25%">#springMessage('table.guaContract.guaNo')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_guaNo" autocomplete="off"
                           class="layui-input" placeholder="#springMessage('table.guaContract.guaNo')">
                </div>
            </td>
        </tr>

        <tr>
            ## 担保方式
            <td class="textRight">#springMessage('table.guaContract.guaType')</td>
            <td>
                <div class="layui-inline">
                    <div class="selectDemo bt-biz-mulselectType" data-biz-name="guaWay" data-method="get"
                         data-url="${basePath}/cms/guarantee/guaContractInfo/json" data-valuefield="id"
                         data-textfield="name"
                         data-name="ins_guaType"></div>
                </div>
            </td>
            ## 担保单位
            <td class="textRight">#springMessage('table.guaContract.guaPerson')</td>
            <td>
                <input type="text"
                       class="layui-input"
                       placeholder="#springMessage('table.guaContract.guaPerson')"
                       name="likes_guaPerson"/>
            </td>
        </tr>

        <tr>
            ## 债务人
            <td class="textRight" width="25%">#springMessage('table.guaContract.debtorPersonName')</td>
            <td width="25%">
                <input type="text" name="likes_debtorPerson" autocomplete="off"
                       class="layui-input" placeholder="#springMessage('table.guaContract.debtorPersonName')">
            </td>
            ## 债权人
            <td class="textRight" width="25%">#springMessage('table.guaContract.creditorPerson')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_creditorPerson" autocomplete="off"
                           class="layui-input" placeholder="#springMessage('table.guaContract.creditorPerson')">
                </div>
            </td>
        </tr>

        <tr>
            ## 担保额度
            <td class="textRight">#springMessage('table.guaContract.sumMoney')</td>
            <td width="25%">
                <div class="layui-inline">
                    <input type="text" data-name="geg_guaMoney"
                           autocomplete="off" class="layui-input bt-input-inline bt-biz-moneyType"
                           style="text-align:right" data-moneyendid="guaMoney">
                </div>
                <span class="date-mid">#springMessage('table.guaContract.range')</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_guaMoney"
                           autocomplete="off" class="layui-input bt-input-inline bt-biz-moneyType"
                           style="text-align:right" id="guaMoney">
                </div>
            </td>
            ## 合同编号
            <td class="textRight" width="25%">#springMessage('table.guaContract.contractCode')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_contractCode" autocomplete="off"
                           class="layui-input" placeholder="#springMessage('table.guaContract.contractCode')">
                </div>
            </td>
        </tr>

        <tr>
            ## 担保日期
            <td class="textRight" width="25%">#springMessage('table.guaContract.date')</td>
            <td width="25%">
                <div class="layui-inline">
                    <input type="text" name="ged_startDate" data-name="ged_startDate"
                           class="layui-input bt-input-inline bt-biz-dateType" data-endid="endDate" data-type="date">
                </div>
                <span class="date-mid">#springMessage('table.guaContract.range')</span>
                <div class="layui-inline">
                    <input type="text" name="led_endDate" 　data-name="led_endDate"
                           class="layui-input bt-input-inline bt-biz-dateType" id="endDate" data-type="date">
                </div>
            </td>
            ## 操作人
            <td class="textRight">#springMessage('table.sysAttachment.createBy')</td>
            <td>
                <input type="text" class="layui-input" name="likes_createBy"
                       placeholder="#springMessage('common.message.operator')"/>
            </td>
        </tr>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.guaContract.corpId')</th>     ## 融资主体
        <th>#springMessage('table.guaContract.guaNo')</th>      ## 担保编号
        <th>#springMessage('table.guaContract.guaType')</th>    ## 担保方式
        <th>#springMessage('table.guaContract.guaPerson')</th>  ## 担保单位
        <th>#springMessage('table.guaContract.debtorPersonName')</th>   ## 债务人
        <th>#springMessage('table.guaContract.creditorPerson')</th>     ## 债权人
        <th>#springMessage('table.guaContract.curId')</th>      ## 币别
        <th>#springMessage('table.guaContract.sumMoney')</th>   ## 担保额度
        <th>#springMessage('table.guaContract.contractCode')</th>   ## 合同编号
        <th>#springMessage('table.guaContract.startDate')</th>  ## 担保开始日期
        <th>#springMessage('table.guaContract.endDate')</th>    ## 担保结束日期
        <th>#springMessage('table.sysAttachment.createBy')</th>      ## 操作人
        <th>#springMessage('table.guaContract.status')</th>     ## 状态
        <th>#springMessage('common.table.thead.operation')</th> ## 操作
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaContractInfo.list.js?_btv=${resourceVersion}"></script>
</html>

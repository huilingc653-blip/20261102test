<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
            <tbody>
                <tr>
                    ##保函编号
					<td class="textRight">#springMessage('table.guaGuarantee.No')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_guaranteeNo" autocomplete="off" 
								class="layui-input" placeholder="#springMessage('table.guaGuarantee.No')">  
                        </div>
                    </td>
					##保函申请单位
                    <td class="textRight">#springMessage('table.guaGuarantee.corp')</td>
                    <td width="20%" class="rCode">
            		<div class="layui-input-inline">
            			<div class="bt-biz-corp"
	                        data-biz-type="corp"
	                        data-type="selectTree"
	                        data-name="eqs_corpId"
	                        data-biz-name="corpId"
	                        data-bizName="corpId"
	                        data-width="300px;"
                            data-resource="gua:guarantee:info:query"
							data-callback="bt.corpCallback">
                   		</div>
					</div>
                    </td>
					##保函类型
                    <td class="textRight">#springMessage('table.guaGuarantee.type')</td>
                    <td>
                        <div class="layui-inline">
							<select lay-filter="pledgeAttr" name="eqs_guaranteeType" >
								<option value=" ">#springMessage('common.placeholder.select')</option>
								#foreach($dict in $dictTag.list("guarantee.Lg.TypeAttr"))
								<option value="$dict.code">$dict.name</option>
								#end
							</select>
						</div>
                    </td>
                </tr>
				<tr>
					##开立人类型
					<td class="textRight">#springMessage('table.guaGuarantee.openPeopleType')</td>
					<td>
						<div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.openPeopleType"  data-name="eqs_openCorpType" data-biz-name="openCorpType"></div>
					</td>
					##抵保函受益人
                    <td class="textRight">#springMessage('table.guaGuarantee.beneficiary')</td>
                    <td>
                        <input type="text" name="likes_incomeCorp"  autocomplete="off" class="layui-input" placeholder="#springMessage('table.guaGuarantee.beneficiary')">
                    </td>
                    ##保函状态
					<td class="textRight">#springMessage('table.guaGuarantee.guaStatus')</td>
                    <td>
                    	<div class="bt-biz-dict" data-type="select" data-group="guaGuarantee.status" data-name="eqi_status" data-biz-name="status"></div>
                    </td>
				</tr>
				<tr>
					##保函有效期
					<td class="textRight">#springMessage('table.guaGuarantee.date')</td>
                    <td>
                        <div class="layui-inline">
							<input type="text" name="ged_startDate" data-name="ged_startDate" 
								class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                		</div>
						<span class="date-mid">#springMessage('table.guaGuarantee.range')</span>
						<div class="layui-inline"">
							<input type="text" name="led_endDate"　data-name="led_endDate" 
								class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                		</div>
                    </td>
					##保函金额
                    <td class="textRight">#springMessage('table.guaGuarantee.money')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_guaranteeMoney"
								autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="guaranteeMoney">
                        </div>
                        <span class="date-mid">#springMessage('table.guaGuarantee.range')</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_guaranteeMoney"
                                    autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="guaranteeMoney">
                        </div>
                    </td>
					<td></td>
					<td></td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>	
    </form>  

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.guaGuarantee.No')</th>##保函编号
                <th>#springMessage('table.guaGuarantee.corp')</th>##保函申请单位
                <th>#springMessage('table.guaGuarantee.type')</th>##保函类型
                <th>#springMessage('table.guaGuarantee.openPeople')</th>##保函开立人
                <th>#springMessage('table.guaGuarantee.beneficiary')</th>##保函受益人
                <th>#springMessage('table.guaGuarantee.money')</th>##保函金额
			    <th>#springMessage('table.guaGuarantee.startDate')</th>##保函开始时间
				<th>#springMessage('table.guaGuarantee.endDate')</th>##保函结束时间
                <th>#springMessage('table.guaGuarantee.lgMatter')</th>##保证事项
                <th>#springMessage('table.guaGuarantee.contractNo')</th>##合同编号
				<th>#springMessage('table.guaGuarantee.bondMoney')</th>##保证金
				<th>#springMessage('table.guaGuarantee.bondAcc')</th>##保证金账户
				<th>#springMessage('table.guaGuarantee.status')</th>##状态
                <th>#springMessage('table.guaGuarantee.handleCharge')</th>##手续费
                <th>#springMessage('table.guaGuarantee.receiver')</th>##领取人
                <th>#springMessage('table.guaGuarantee.receiveDate')</th>##领取时间
				<th>#springMessage('common.table.thead.operation')</th>##操作
            </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaGuaranteeAll.list.js?_btv=${resourceVersion}"></script>
</html>

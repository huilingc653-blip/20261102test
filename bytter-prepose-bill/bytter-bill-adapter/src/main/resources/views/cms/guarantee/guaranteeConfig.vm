<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

</head>
<body>
<form action="" style="padding: 0px 20px;" class="layui-form layui-form-pane">
    <input type="hidden" id="guaCon" value="$!{config.gua.gua_relate_con}">
    <input type="hidden" id="guaExtCon" value="$!{config.gua.extCon_relate_con}">
    <table class="layui-table ">
        <tbody>
            ##被担保是否对接合同管理
        <tr>
            <td class="textRight" width="20%">#springMessage('gua.config.contract.isRelateCon')</td>
            <td>
                <input title="#springMessage("common.sc_yn.yes")" name="gua.gua_relate_con" value="1"
                       lay-filter="gua_relate_con"
                       #if($config.gua.gua_relate_con == 1)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("common.sc_yn.yes")</span>##是
                </div>

                <input title="#springMessage("common.sc_yn.no")" name="gua.gua_relate_con" value="0"
                       lay-filter="gua_relate_con"
                       #if($config.gua.gua_relate_con == 0)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("common.sc_yn.no")</span>##否
                </div>
            </td>
        </tr>
            ##被担保对接合同管理模式
        <tr id="conConfig">
            <td class="textRight">#springMessage('gua.config.relate.conType')</td>
            <td>
                <input title="#springMessage("cms.config.gua.createCon")" name="gua.gua_relate_con_type" value="0"
                       #if($config.gua.gua_relate_con_type == 0)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("cms.config.gua.createCon")</span>##担保生成合同
                </div>

                <input title="#springMessage("cms.config.gua.relateCon")" name="gua.gua_relate_con_type" value="1"
                       #if($config.gua.gua_relate_con_type== 1)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("cms.config.gua.relateCon")</span>##担保调用合同
                </div>
            </td>
        </tr>
            ##对外担保是否对接合同管理
        <tr>
            <td class="textRight">#springMessage('gua.config.extCon.isRelateCon')</td>
            <td>
                <input title="#springMessage("common.sc_yn.yes")" name="gua.extCon_relate_con" value="1"
                       lay-filter="extCon_relate_con"
                       #if($config.gua.extCon_relate_con == 1)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("common.sc_yn.yes")</span>##是
                </div>

                <input title="#springMessage("common.sc_yn.no")" name="gua.extCon_relate_con" value="0"
                       lay-filter="extCon_relate_con"
                       #if($config.gua.extCon_relate_con == 0)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("common.sc_yn.no")</span>##否
                </div>

            </td>
        </tr>
            ##对外担保对接合同管理模式
        <tr id="conConfig">
            <td class="textRight">#springMessage('gua.config.extCon.relate.conType')</td>
            <td>
                <input title="#springMessage("cms.config.gua.createCon")" name="gua.extCon_relate_con_type" value="0"
                       #if($config.gua.extCon_relate_con_type == 0)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("cms.config.gua.createCon")</span>##担保生成合同
                </div>

                <input title="#springMessage("cms.config.gua.relateCon")" name="gua.extCon_relate_con_type" value="1"
                       #if($config.gua.extCon_relate_con_type== 1)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("cms.config.gua.relateCon")</span>##担保调用合同
                </div>
            </td>
        </tr>
            ##集团内对外担保是否生成被担保合同
        <tr id="conConfig">
            <td class="textRight">#springMessage('gua.config.guaExt.autoExt')</td>
            <td>
                <input title="#springMessage("common.sc_yn.yes")" name="gua.autoExtGuaCon" value="1"
                       #if($config.gua.autoExtGuaCon == 1)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("common.sc_yn.yes")</span>##是
                </div>

                <input title="#springMessage("common.sc_yn.no")" name="gua.autoExtGuaCon" value="0"
                       #if($config.gua.autoExtGuaCon != 1)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage("common.sc_yn.no")</span>##否
                </div>
            </td>
        </tr>

            ##对外担保合同到期提醒天数
        <tr id="conConfig">
            <td class="textRight">#springMessage('gua.extCon.remind.day')</td>
            <td>
                <div class="layui-inline">
                    <input title="#springMessage("gua.extCon.remind.day")" name="gua.extCon_remind_day"
                           value="$!{config.gua.extCon_remind_day}" class="layui-input" type="text"
                           onkeyup="value=zhzs(this.value)">
                </div>
                <span>#springMessage('config.nis.day')</span>
            </td>
        </tr>

            ##被担保合同到期提醒天数
        <tr id="conConfig">
            <td class="textRight">#springMessage('gua.coverCon.remind.day')</td>
            <td>
                <div class="layui-inline">
                    <input title="#springMessage("gua.coverCon.remind.day")" name="gua.coverCon_remind_day"
                           value="$!{config.gua.coverCon_remind_day}" class="layui-input" type="text"
                           onkeyup="value=zhzs(this.value)">
                </div>
                <span>#springMessage('config.nis.day')</span>
            </td>
        </tr>
        </tbody>
    </table>

    <br/><br/>
    <!-- 按钮 -->
    <div style="text-align: center;">
        <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage(
            'common.button.submit')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    </div>


</form>
    #parse("views/common/footer.vm")
<script>
    var ck, ck1, ck2;
    bt.use(['form', 'jquery', 'moneyType', 'dicts', 'checkboxs'], function () {
        var form = bt.form(), $ = bt.jquery;
        bt.moneyType.init();
        bt.dicts.init();
        //监听提交
        form.on('submit(configSubmit)', function (data) {
            bt.loading.show();
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                bt.loading.hide();
                parent.layer.alert(result.msg ? result.msg : bt.lang('common.message.success'), {icon: result.success ? 1 : 2});
            }, "JSON");
            return false;
        });
        var guaCon = $("#guaCon").val();
        if (guaCon == "1") {
            $("input[name='gua.gua_relate_con_type']").removeAttr("disabled");
        } else {
            $("input[name='gua.gua_relate_con_type']").attr("disabled", true);
        }

        var guaExtCon = $("#guaExtCon").val();
        if (guaExtCon == "1") {
            $("input[name='gua.extCon_relate_con_type']").removeAttr("disabled");
        } else {
            $("input[name='gua.extCon_relate_con_type']").attr("disabled", true);
        }

        form.render();
        form.on('radio(gua_relate_con)', function (data) {
            if (data.value == "1") {
                $("input[name='gua.gua_relate_con_type']").removeAttr("disabled");
            } else {
                $("input[name='gua.gua_relate_con_type']").attr("disabled", true);
            }
            form.render();
            return false;
        });

        form.on('radio(extCon_relate_con)', function (data) {
            if (data.value == "1") {
                $("input[name='gua.extCon_relate_con_type']").removeAttr("disabled");
            } else {
                $("input[name='gua.extCon_relate_con_type']").attr("disabled", true);
            }
            form.render();
            return false;
        });
    });

    //只能输入数字
    function zhzs(value) {
        value = value.replace(/[^\d]/g, '');
        return value;
    }
</script>


</body>
</html>
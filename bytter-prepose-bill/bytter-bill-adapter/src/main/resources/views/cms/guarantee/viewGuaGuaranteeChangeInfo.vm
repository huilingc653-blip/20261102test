<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	#rateInfo input {
    		text-align:right;
    	}
    	#rateInfo .bt-biz-rateType {
    		width:128px;
    	}
    
    </style>
</head>
<body>
	<form class="layui-form" id="inputForm">
		<input type="hidden" id="openCorp" name="openCorp" value="$!{lgChangeInfoVo.openCorp}"/>
		<input type="hidden" id="applyCorp" value="$!{lgChangeInfoVo.corpId}" />
		<input type="hidden" name="guaraId" id="guaraId" value="" />
		<input type="hidden" name="id" value="$!{lgChangeInfoVo.id}"/>
		<input type="hidden" name="curId" id="curId" value="$!{lgChangeInfoVo.curId}"/>
		<input type="hidden" name="startDate" id="startDate" value="$!{lgChangeInfoVo.startDate}"/>
		<table class="layui-table">
		<tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label><b>#springMessage('table.guaGuarantee.application')</b></label>
				</td>
			</tr>
        	<tr>
			   ##保函申请人
               <td class="textRight" width="14%">#springMessage('table.guaGuarantee.applyPeople')</td>
			   <td width="36%">$!{lgChangeInfoVo.corpName}</td>
        		##保函类型
				<td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.type')</td>
				<td>$dictTag.get("guarantee.Lg.TypeAttr", "$!{lgChangeInfoVo.guaranteeType}")</td>
			</tr>
           <tr>
			    ##保函编号
               <td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.No')</td>
			   <td>$!{lgChangeInfoVo.guaranteeNo}</td>
		    	##开立人类型
			   <td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.openPeopleType')</td>
               <td>$dictTag.get("guarantee.Lg.openPeopleType", "$!{lgChangeInfoVo.openCorpType}")</td>
		   </tr>
		   <tr>
			    ##开立方式
               <td class="textRight">#springMessage('table.guaGuarantee.openWay')</td>
			   <td>$dictTag.get("guarantee.Lg.openWay", "$!{lgChangeInfoVo.openWay}")</td>
        		##开立类型
				<td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.openType')</td>
				<td>$dictTag.get("guarantee.Lg.openType", "$!{lgChangeInfoVo.openType}")</td>
			</tr>
        	<tr>
        		##保函开立人
				<td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.openPeople')</td>
				<td >$!{lgChangeInfoVo.openCorpName}</td>
				##保函受益人
				<td class="textRight" width="14%">#springMessage('table.guaGuarantee.beneficiary')</td> 
				<td width="36%">$!{lgChangeInfoVo.incomeCorp}</td>
			</tr>
			<tr>
				##币别
                <td class="textRight">#springMessage('table.guaGuarantee.curId')</td>
                <td>$!{lgChangeInfoVo.curName}</td>
        		##保函金额
				<td class="textRight">#springMessage('table.guaGuarantee.money')</td>
				<td >$number.formatNumeric($!{lgChangeInfoVo.guaranteeMoneyOld})</td>
			</tr>
			<tr>
        		##保函性质
				<td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.lgNature')</td>
				<td >$dictTag.get("guarantee.Lg.nature", "$!{lgChangeInfoVo.guaranteeAttr}")</td>
				##保函预计结束日期
				<td class="textRight">#springMessage('table.guaGuarantee.expectEndDate')</td>
				<td >$!date.format('yyyy-MM-dd',$!{lgChangeInfoVo.expectEndDateOld})</td>
			</tr>
			<tr>
        		##保函开始时间
				<td class="textRight">#springMessage('table.guaGuarantee.startDate')</td>
				<td >$!date.format('yyyy-MM-dd',$!{lgChangeInfoVo.startDate})</td>
				##保函截止时间
                <td class="textRight">#springMessage('table.guaGuarantee.endDate')</td>
                <td>$!date.format('yyyy-MM-dd',$!{lgChangeInfoVo.endDateOld})</td>
			</tr>
			<tr style="display:none";>
				 ##转开行
                <td class="textRight">#springMessage('table.guaGuarantee.turnBank')</td>
                <td>$!{lgChangeInfoVo.turnBank}</td>
                <td></td>
				<td></td>
			</tr>
        </tbody>
        </table>
		#if($!{isHangBail}=="1")
		##保证金信息
			#if(${lgChangeInfoVo.isHookBond}=="1")
                <h2 class="layui-colla-title">#springMessage('table.fcBond.BondMsg')</h2>
				#set($fcBondApplyDTO=$fcBondTag.getBondApplyDetail($!{lgChangeInfoVo.guaraId},$!{lgChangeInfoVo.guaranteeNo}))
				#parse("views/common/viewFcBondDetail.vm")
			#end
		#end
        <table class="layui-table">
            <tbody>
			##挂接授信开始
			#if($!{urationDTO})
            <tr>
			##授信品种
                <td class="textRight" width="14%">#springMessage('table.guarantee.ratItemCode')</td>
                <td width="36%">$!{urationDTO.ratItemName}</td>
			##授信业务品种名称
                <td class="textRight" width="14%">#springMessage('cms.business.race')</td>
                <td>$!{urationDTO.raceName}</td>
            </tr>
			<tr>
			##是否折合本位币
				#if($!{naturalSign}=="0")
                    <td class="textRight">#springMessage('table.cmsProvideLoanInfo.isRmbRat')</td>
                    <td>$!dictTag.get("sf_yn",$!{lgChangeInfoVo.isRmbRat})</td>
				#end
				##授信额度单
				<td class="textRight" width="14%">#springMessage('table.guarantee.rationSelect')</td>
				<td>
					<div class="layui-input-inline">
						#if($!{lgChangeInfoVo.ratmodel} == "1")
						<div id="rationBtn">
							<button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
						</div>
						#else
						<div style="display: none" id="rationBtn">
							<button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
						</div>
						#end
					</div>
					##额度编号
                    ##占用授信代码
					<span id="itemCodeTd">
						<input type="hidden" name="ratCode" id="ratCode" value="$!{urationDTO.ratCode}">
						<input type="hidden" name="itemFlag" id="itemFlag" value="$!{urationDTO.itemFlag}">
						<input type="hidden" name="itemMoney" id="itemMoney" value="$!{urationDTO.money}">
						<input type="hidden" name="ratItemCode" id="ratItemCode" value="$!{urationDTO.ratItemCode}">
						<input type="hidden" name="ratCurId" id="ratCurId" value="$!{urationDTO.curCode}">
						#if($!{urationDTO.itemFlag} == "0")
<!-- 						<input type="hidden" name="ratItemCode" id="ratItemCode" value="$!{urationDTO.ratItemCode}"> -->
						#else
							#foreach($applyDtl in $!{urationDTO.applyDtls})
								#set($vcount = $velocityCount - 1)
								<input type="hidden" name="applyDtls[$!{vcount}].itemCode" id="itemCode$!{vcount}" value="$!{applyDtl.itemCode}">
								<input type="hidden" name="applyDtls[$!{vcount}].itemMoney" itemCode="$!{applyDtl.itemCode}" id="itemMoney$!{vcount}" value="$!{applyDtl.useMaxMoney}">
							#end
						#end
					</span>		
				</td>
			</tr>
            <tr>
                <td class="textRight">#springMessage('gua.start.Openrat')</td>##是否启用敞口授信
                <td>$dictTag.get("sf_yn", "$!{urationDTO.isOpenRat}")</td>
                <td></td>
                <td></td>
            </tr>
			#end
			##挂接授信结束
			
			</tbody>
        </table>
		<table class="layui-table">
		 <tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label><b>#springMessage('table.guaGuarantee.changeMsg')</b></label>
				</td>
			</tr>
			<tr>
				##保函更改申请日期
				<td class="textRight" width="14%">#springMessage('table.guaGuarantee.lgChangedate')</td>
				<td width="36%"> $!date.format('yyyy-MM-dd',$!{lgChangeInfoVo.changeDate})</td>
				##保函变更单号
				<td class="textRight" width="14%">#springMessage('table.guaGuarantee.lgChangeNo')</td>
				<td width="36%"> $!{lgChangeInfoVo.guaraChangeNo}</td>
			</tr>
			<tr>
				##保函更改次数
				<td class="textRight">#springMessage('table.guaGuarantee.lgChangeNum')</td>
				<td> $!{lgChangeInfoVo.changeCount}</td>
##				##币别
##                <td class="textRight">#springMessage('table.guaGuarantee.curId')</td>
##                <td> $!{lgChangeInfoVo.curName}</td>
                    <td class="textRight">#springMessage('table.urationapply.bondCurId')</td>
                    <td>
						$!{lgChangeInfoVo.bondCurName}
                    </td>
			</tr>
			<tr>
        		##新截止日期
				<td class="textRight">#springMessage('table.guaGuarantee.newEndDate')</td>
				<td > $!date.format('yyyy-MM-dd',$!{lgChangeInfoVo.endDate})</td>
				##新预计结束日期
				<td class="textRight">#springMessage('table.guaGuarantee.newExpectEndDate')</td>
				<td >$!date.format('yyyy-MM-dd',$!{lgChangeInfoVo.expectEndDate})</td>
			</tr>
			<tr>
        		##保函金额调整类型
				<td class="textRight">#springMessage('table.guaGuarantee.lgChangeType')</td>
				<td >$dictTag.get("guarantee.Lg.ChangeType", "$!{lgChangeInfoVo.guaChangeType}")</td>
				##保函保证金调整类型
				<td class="textRight">#springMessage('table.guaGuarantee.bondChangeType')</td>
				<td >$dictTag.get("guarantee.Lg.ChangeType", "$!{lgChangeInfoVo.bondChangeType}")</td>
			</tr>
			<tr>
        		##保函调整金额
				<td class="textRight">#springMessage('table.guaGuarantee.lgChangeMoney')</td>
				<td>
					#if($!{lgChangeInfoVo.guaChangeMoney})
						$number.formatNumeric($!{lgChangeInfoVo.guaChangeMoney})
					#end
				</td>
				##保证金调整金额
				<td class="textRight">#springMessage('table.guaGuarantee.bondChangeMoney')</td>
				#if($!{lgChangeInfoVo.bondChangeMoney})
					<td >$number.formatNumeric($!{lgChangeInfoVo.bondChangeMoney})</td>
				#end
			</tr>
			<tr>
        		##调整后保函金额
				<td class="textRight">#springMessage('table.guaGuarantee.moneySum')</td>
				<td >
					#if($!{lgChangeInfoVo.guaranteeMoney})
						$number.formatNumeric($!{lgChangeInfoVo.guaranteeMoney})
					#end
				</td>
				##调整后保证金
				<td class="textRight">#springMessage('table.guaGuarantee.bondMoneySum')</td>
				<td >
					#if($!{lgChangeInfoVo.bondMoney})
						$number.formatNumeric($!{lgChangeInfoVo.bondMoney})
					#end
				</td>
			</tr>
			<tr>
        		##调整后保函手续费金额
				<td class="textRight">#springMessage('table.guaGuarantee.hanleChargeSum')</td>
				<td >
					#if($!{lgChangeInfoVo.handleCharge})
						$number.formatNumeric($!{lgChangeInfoVo.handleCharge})</td>
					#end
				##修改条款
				<td class="textRight">#springMessage('table.guaGuarantee.changeTerm')</td>
				<td >$!{lgChangeInfoVo.changeTerm}</td>
			</tr>
			<tr>
				##修改原因
				<td class="textRight">#springMessage('table.guaGuarantee.changeReason')</td>
				<td >$!{lgChangeInfoVo.changeReason}</td>
				##经办人
				<td class="textRight">#springMessage('table.guaGuarantee.operator')</td>
				<td >$!{lgChangeInfoVo.operator}</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="close">#springMessage('common.button.close')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationSet.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">
bt.use(['form','layedit'], function(){
	var $ = bt.jquery,form = bt.form();
    //监听提交
    form.on('submit(close)', function(data){
    	if(!bt.navtab){
            parent.layer?parent.layer.closeAll():layer.closeAll();
        } else {
        	//bt.navtab.refreshParent();
        	bt.navtab.closeCurrent();
        }
    	return false;
    });
});

 //查看授信
  function viewRatCode(){
		var params = beforeRation();
		if(bt.empty(params)){
			return;
		}
		viewRationDtl(params);
	}
	
	/**
	 * 授信额度选择
	 * @param params
	 */
	function beforeRation(){
		var corpId = $("#applyCorp").val();
		if(bt.empty(corpId) || corpId == 0){
			//选择保函申请人
			parent.layer.msg(bt.lang("cms.gua.guarantee.corpIdnull"), {icon: 2});
			return "";
		}
		var curId = $("#ratCurId").val();
		if(bt.empty(curId)){
			//选择币别
			parent.layer.msg(bt.lang("cms.gua.guarantee.curIdnull"), {icon: 2});
			return "";
		}
		var bankCode = $("#openCorp").val();//银行
		if(bt.empty(bankCode.trim())){
			//选择保函开立人
			parent.layer.msg(bt.lang("cms.gua.guarantee.bankIdnull"), {icon: 2});
			return "";
		}
		var startDate = $("#startDate").val();//保函开始日期
		var ratItemCode = $("#ratItemCode").val();//授信品种
		var params = {
				corpId : corpId,
				curCode : curId,
				bankCode : bankCode,
				ratItemCode : ratItemCode.replace(" ", "")
		}
		return params;
	}
</script>
</html>
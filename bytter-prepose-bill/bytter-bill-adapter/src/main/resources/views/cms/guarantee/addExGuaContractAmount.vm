<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">

    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('cms.exgua.corpId')</td>
            <td >
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-name="corpId" data-biz-type="corp" data-type="selectTree" data-tree-type="check"
                         data-checkkboxtype='{"Y":"s","N":"s"}' data-scope="all" data-required="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##币别
            <td class="textRight">#springMessage("table.choProduct.curId")</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-required="true"
                     data-name ="curId" data-biz-name ="curId" name="curId" id="curId" data-valueField="id" data-textField="curName"></div>
        </tr>
        <tr>
            <td class="textRight">#springMessage('cms.exgua.assets')</td>
            <td>
                <input type="text" id="assets" name="assets" style="text-align:right" data-name="assets" data-biz-name="assets"
                       autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="2" lay-verify="required">
            </td>
        </tr>
        <tr>
            ##对外担保限额占当期净资产比例
            <td class="textRight">#springMessage('对外担保限额占当期净资产比例')</td>
            <td>
                <div class="layui-inline">
                    ##利率
                    <input type="text" data-name="proportion" lay-verify="required"
                           data-biz-name="proportion"
                           class="layui-input bt-biz-rateType"
                           placeholder="">
                </div>
            </td>
        </tr>
        <tr>
            ##备注说明
            <td class="textRight">#springMessage('table.btBankAcc.rmk')</td>
            <td>
            <textarea id="rmk" name="rmk" class="layui-textarea" maxlength="200"></textarea>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/cms/guarantee/exGuaContractAmount.add.js?_btv=${resourceVersion}"></script>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="id" name="id" value="$!{amountVO.id}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="10%">#springMessage('cms.exgua.corpId')</td>
            <td>
                <table id="corpTable"></table>
            </td>
        </tr>
        <tr>
            ##币别
            <td class="textRight">#springMessage("table.choProduct.curId")</td>
            <td>
                $!{amountVO.curName}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('cms.exgua.assets')</td>
            <td>
                $!number.formatNumeric($!{amountVO.assets})
            </td>
        </tr>
        <tr>
            ##对外担保限额占当期净资产比例
            <td class="textRight">#springMessage('对外担保限额占当期净资产比例')</td>
            <td>
                <div class="layui-inline">
                    ##利率
                    $!rateTag.show($!{amountVO.proportion})
                </div>
            </td>
        </tr>
        <tr>
            ##备注说明
            <td class="textRight">#springMessage('table.btBankAcc.rmk')</td>
            <td>
                <textarea id="rmk" name="rmk" class="layui-textarea" maxlength="200"
                          readonly> $!{amountVO.rmk}</textarea>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form', 'layedit', 'corp', 'selectType', 'dicts', 'moneyType', 'rateType', 'treeGrid'], function () {
        var $ = bt.jquery, form = bt.form();
        bt.corp.init();
        bt.dicts.init();
        bt.selectType.init();
        bt.rateType.init();
        bt.moneyType.init();

        var treeGrid = bt.treeGrid.init({
            elem: "#corpTable",
            url: basePath + "/cms/guarantee/guaExGuaranteeAmount/corpId.json/" + $("#id").val(),
            ExpandColumn: "corpName",
            expandable: true,
            colModel: [
                {
                    name: "corpName",
                    label: bt.lang("table.sysCorp.name"),
                    formatter: function (cellvalue, options, rowObject) {
                        return "(" + rowObject.corpCode + ")" + rowObject.corpName;
                    }
                },
            ],
            loadComplete: function () {
                $("#jqgh_corpTable_name").hide();
            }
        });
    })

</script>

##挂接抵质押物公共页面
<input type="hidden" id="pledgeConfig" value="$!{pledgeConfig}">##业务模块是否挂抵质押物参数(必填)
##以下三个参数在业务关联抵质押物时必填，并传入名为pledgeDTOS的抵质押占用集合
<input type="hidden" id="itemNo" value="$!{itemNo}">##业务编号
<input type="hidden" id="businessId" value="$!{businessId}">##业务id
<input type="hidden" id="isRelatePledge" value="$!{isRelatePledge}">##业务是否关联抵质押物
<tr>
##是否挂抵质押物
    <td class="textRight" style="width: 15%">#springMessage("gua.config.isRelatePledge")</td>
    <td style="width: 35%">
        <div class="layui-form" id="isRelatePledgeDiv">
            <div class="bt-biz-dict is_not_render" data-type="radio" data-group="sf_yn"
                #if($!{isRelatePledge})
                 data-defaultvalue="$!{isRelatePledge}"
                #else
                 data-defaultvalue=0
                #end
                 data-name="isRelatePledge" data-biz-name="isRelatePledge"
                 data-callback="bt.setPledgeInfo"></div>##是否挂抵质押物选择按钮
        </div>
    </td>
##抵质押物相关操作
    <td class="textRight pledgeTd" style="width: 15%">#springMessage("table.guaPledge.occupyAmount")</td>##抵质押额度
    <span id="guaPledgeSpan">
        #set($pledgeIds = "")
        #set($pledgeMsg = "")
        #set($pledgeMoney=0)
        #foreach( $!{occupyDTO} in $!{pledgeDTOS})##抵质押物id集合
            #set($vcount = $velocityCount - 1)
            #set($pledgeIds =$!{pledgeIds}+$!{occupyDTO.pledgeId}+",")
            #set($pledgeMsg =$!{pledgeMsg}+$!{occupyDTO.pledgeId}+","+$!{occupyDTO.occupyMoney}+";")
            #set($pledgeMoney=${pledgeMoney}+$!{occupyDTO.occupyMoney})
             <input type="hidden" name="pledgeId[$vcount]"  value="$!{occupyDTO.pledgeId}">
             <input type="hidden" name="pledgeMoney[$vcount]"  value="$!{occupyDTO.occupyMoney}">
        #end
    </span>
    <td class="pledgeTd" style="width: 35%">
        <div class="layui-inline">
            <input id="guaPledgeMoney"  data-biz-name="guaPledgeMoney" class="layui-input bt-biz-moneyType" data-name="guaPledgeMoney" type="text" value="$!number.formatNumeric($!{pledgeMoney})" readonly="true" lay-verify="number2|required">
        </div>
        <div class="layui-inline">
            <button class="layui-btn" type="button" onclick="addGuaPledge()">#springMessage('common.button.select')</button>##选择担保合同按钮
        </div>
        <div class="layui-input-inline">
            <div style="display: none" id="viewBtn">
                <button type="button" onclick="viewGuaPledge()" class="layui-btn">#springMessage('common.button.view')</button>##查看担保合同按钮
            </div>
        </div>
    </td>
    <input type="hidden" id="pledgeIds" value="$!{pledgeIds}">
    <input type="hidden" id="pledgeMsg" value="$!{pledgeMsg}">
</tr>


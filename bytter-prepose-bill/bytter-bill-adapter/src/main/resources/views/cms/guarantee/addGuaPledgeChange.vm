<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	#rateInfo input {
    		text-align:right;
    	}
    	#rateInfo .bt-biz-rateType {
    		width:128px;
    	}
    </style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input type="hidden" id="corpId" name="corpId" value="$!{guaPledge.corpId}">
		<input type="hidden" name="pledgeId" id="pledgeId" value="$!{guaPledge.id}">
		<input type="hidden" name="oldMoney" id="oldMoney" value="$!{guaPledge.pledgeMoney}"/>
		<input type="hidden" name="pledgeAttr"  value="$!{guaPledge.pledgeAttr}" id="pledgeAttr"/>
		<input type="hidden" name="pledgeType" value="$!{guaPledge.pledgeType}"/>
		<input type="hidden" name="pledgeNo" value="$!{guaPledge.pledgeNo}"/>
		<input type="hidden" name="startDate" value="$!{guaPledge.startDate}"/>
		<input type="hidden" name="enddate" value="$!{guaPledge.endDate}"/>
		<input type="hidden" name="pledgeName" value="$!{guaPledge.pledgeName}"/>
		<input type="hidden" name="curId" value="$!{guaPledge.curId}"/>
		<input type="hidden" id="freezeMoney" name="freezeMoney" value="$!{guaPledge.freezeMoney}"/>
		<input type="hidden" id="occupyMoney" name="occupyMoney" value="$!{guaPledge.occupyMoney}"/>
		<input type="hidden" name="flag" id="flag" value="$!{flag}"/>
		<table class="layui-table">
		<tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label><b>#springMessage('table.guaPledge.record')</b></label>
				</td>
			</tr>
        	<tr>
        		## 抵质押申请单位
				<td class="textRight" width="14%">#springMessage('table.guaPledge.corpId')</td>
				<td width="36%">
					$!{guaPledge.corpName}
				</td>

        		##抵质押物编号
				<td class="textRight"><font color="red">*</font>#springMessage('table.guaPledge.pledgeNo')</td>
				<td>
					$!{guaPledge.pledgeNo}
				</td>
			</tr>
           <tr>
		  ##性质
           <td class="textRight">#springMessage('table.guaPledge.pledgeAttr')</td>
			<td>
				<div class="bt-biz-dict" data-type="radio" data-group="pledge_type" data-defaultvalue="$!{guaPledge.pledgeAttr}"
						data-name="typeAttr" data-biz-name="typeAttr"  data-disabled="true"></div>
			</td>
			##抵质押日期
			 <td class="textRight">#springMessage('table.guaPledge.date')</td>
              <td>
                   <div class="layui-inline">
					    <input type="text" name="startDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="startDate"
						    data-endid="endDate" lay-verify="required" value="$!date.format('yyyy-MM-dd',$!guaPledge.startDate)">
				   </div>
				   <span class="date-mid">#springMessage('table.guaPledge.range')</span>
					<div class="layui-inline"">
					      <input type="text" name="endDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="endDate"
						    id="endDate" lay-verify="required" value="$!date.format('yyyy-MM-dd',$!guaPledge.endDate)">
                	</div>
               </td>
		   </tr>
        	<tr>
        		##抵质押类型
				<td class="textRight">#springMessage('table.guaPledge.pledgeType')</td>
				<td >
                	##<div type="list" field="pledgeType" name ="pledgeType" fieldHref="${basePath}/cms/guarantee/pledgeType/json"
					##	dictField="id" dictText="typeName"  data-defaultvalue="$!{guaPledge.pledgeType}">
					##</div>
					<div class="bt-biz-selectType" data-name="pledgeType" data-url="${basePath}/cms/guarantee/pledgeType/json/$!{guaPledge.pledgeAttr}"  data-defaultvalue="$!{guaPledge.pledgeType}"  data-valuefield="id" data-textfield="typeName" data-required="true" data-biz-name="pledgeType" ></div>
				</td>
				##抵质押物名称
                <td class="textRight">#springMessage('table.guaPledge.pledgeName')</td>
                <td>
                     <input type="text" id="pledgeName" name="pledgeName"  autocomplete="off"
						class="layui-input" lay-verify="required" value="$!{guaPledge.pledgeName}">
                 </td>
			</tr>
            <tr>
				##抵押机构
                <td class="textRight">#springMessage('table.guaPledge.pledgeOrg')</td>
                <td>
                    <input type="text" id="pledgeOrg" name="pledgeOrg" autocomplete="off" class="layui-input" lay-verify="required" value="$!{guaPledge.pledgeOrg}">
                </td>

				##币别
                <td class="textRight">#springMessage('table.guaPledge.curId')</td>
                <td>
					$!{guaPledge.curName}
                </td>
            </tr>
			<tr>
        		##评估价值
				<td class="textRight">#springMessage('table.guaPledge.pledgeMoney')</td>
				<td >
					<div class="layui-inline">
						<input type="text" id="pledgeMoney" name="pledgeMoney"  lay-verify="required" value="$!{guaPledge.pledgeMoney}"
							data-decimal="2" class="layui-input bt-biz-moneyType" data-biz-name="pledgeMoney">
					</div>
					<div class="layui-inline">
						<span style="color: red">#springMessage('table.nisExpenseDetail.rmk'):#springMessage('table.guaPledge.pledgeMoney.description')</span>
					</div>
				</td>
				##评估净值
                <td class="textRight">#springMessage('table.guaPledge.netWorth')</td>
                <td>
                    <input type="text" id="pledgeNetWorth" name="pledgeNetWorth" data-decimal="2" class="layui-input bt-biz-moneyType"
						   data-biz-name="pledgeNetWorth" value="$!{guaPledge.pledgeNetWorth}" lay-verify="required">
                </td>
			</tr>
			<tr>
        		##出质人名称
				<td class="textRight">#springMessage('table.guaPledge.pledge')</td>
				<td >
                	<input  type="text"  id="pledge" name="pledge" class="layui-input" value="$!{guaPledge.pledge}">
				</td>
                <td></td>
                <td></td>
			</tr>
			<tr>
        		##资产状况
				<td class="textRight">#springMessage('table.guaPledge.assetState')</td>
				<td >
                	<input  type="text"  id="assetState" name="assetState" class="layui-input" value="$!{guaPledge.assetState}">
				</td>
				##资产产权证号
                <td class="textRight">#springMessage('table.guaPledge.assetNumber')</td>
                <td>
					<input  type="text"  id="assetNumber" name="assetNumber" class="layui-input" value="$!{guaPledge.assetNumber}">
				</td>
			</tr>
			<tr>
        		##土地面积
				<td class="textRight">#springMessage('table.guaPledge.buildArea')</td>
				<td >
                	<input  type="text"  id="buildArea" name="buildArea"  data-decimal="2" class="layui-input bt-input-inline bt-biz-moneyType"
							data-biz-name="buildArea" value="$!{guaPledge.buildArea}" placeholder="#springMessage('table.guaPledge.squareMeter')">
					<span>#springMessage('gua.pledgeAreaUnit')</span>
				</td>
				##容积率建筑面积
                <td class="textRight">#springMessage('table.guaPledge.buildAreaRate')</td>
                <td>
					<input  type="text"  id="buildAreaRate" name="buildAreaRate"  data-decimal="2"  class="layui-input bt-biz-moneyType" data-biz-name="buildAreaRate"
							value="$!{guaPledge.buildAreaRate}" placeholder="#springMessage('table.guaPledge.squareMeter')">
				</td>
			</tr>
            <tr class="mortgageInfo">
				## 土地证号
                <td class="textRight">#springMessage('table.guaPledge.landCardNo')</td>
                <td>
                    <input type="text" id="landCardNo" name="landCardNo" class="layui-input" value="$!{guaPledge.landCardNo}">
                </td>
				## 抵押面积
                <td class="textRight">#springMessage('table.guaPledge.PledgeArea')</td>
                <td>
                    <input type="text" id="pledgeArea" name="pledgeArea" data-decimal="2" class="layui-input bt-biz-moneyType" data-biz-name="pledgeArea"
						   value="$!{guaPledge.pledgeArea}" placeholder="#springMessage('table.guaPledge.squareMeter')">
                </td>
            </tr>
            <tr class="mortgageInfo">
				## 宗地号
                <td class="textRight">#springMessage('table.guaPledge.landNo')</td>
                <td>
                    <input type="text" id="landNo" name="landNo" class="layui-input" value="$!{guaPledge.landNo}">
                </td>
				## 宗地面积
                <td class="textRight">#springMessage('table.guaPledge.landArea')</td>
                <td>
                    <input type="text" id="landArea" name="landArea" class="layui-input bt-biz-moneyType" data-biz-name="landArea"
						   value="$!{guaPledge.landArea}" placeholder="#springMessage('table.guaPledge.squareMeter')">
                </td>
            </tr>
			<tr>
        		##登记日期
				<td class="textRight">#springMessage('table.guaPledge.regDate')</td>
				<td >
                	<input id="regDate" name="regDate"  data-biz-name="regDate" data-type="date" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!guaPledge.regDate)"></input>
				</td>
				##工商登记单号
                <td class="textRight">#springMessage('table.guaPledge.regNumber')</td>
                <td>
					<input  type="text"  id="regNumber" name="regNumber" class="layui-input" value="$!{guaPledge.regNumber}">
				</td>
			</tr>
			<tr>
        		##抵质押折旧
				<td class="textRight">#springMessage('table.guaPledge.pledgeDepreciation')</td>
				<td >
                	<input  type="text"  id="pledgeDepreciation" name="pledgeDepreciation" data-decimal="2"
						class="layui-input bt-biz-moneyType" data-biz-name="pledgeDepreciation" value="$!{guaPledge.pledgeDepreciation}">
				</td>
				##抵质押原值
                <td class="textRight">#springMessage('table.guaPledge.pledgeInitMoney')</td>
                <td>
					<input  type="text"  id="pledgeInitMoney" name="pledgeInitMoney" data-decimal="2"
						class="layui-input bt-biz-moneyType" data-biz-name="pledgeInitMoney" value="$!{guaPledge.pledgeInitMoney}">
				</td>
			</tr>
			<tr>
        		##折旧率
				<td class="textRight">#springMessage('table.guaPledge.depreciationRate')</td>
				<td >
                	<input  type="text"  id="depreciationRate" name="depreciationRate" data-decimal="4"
						class="layui-input bt-biz-moneyType" data-biz-name="depreciationRate" value="$!{guaPledge.depreciationRate}">
				</td>
				##评估机构
                <td class="textRight">#springMessage('table.guaPledge.evaluationDep')</td>
                <td>
					<input  type="text"  id="evaluationDep" name="evaluationDep" class="layui-input" value="$!{guaPledge.evaluationDep}">
				</td>
			</tr>
			<tr>
        		##数量
				<td class="textRight">#springMessage('table.guaPledge.amount')</td>
				<td >
                	<input  type="text"  id="amount" name="amount" lay-verify="number2|strlength" class="layui-input" value="$!{guaPledge.amount}" data-maxlength="12">
				</td>
				##规格
                <td class="textRight">#springMessage('table.guaPledge.specification')</td>
                <td>
					<input  type="text"  id="specification" name="specification" class="layui-input" value="$!{guaPledge.specification}">
				</td>
			</tr>
			<tr>
        		##存放地点
				<td class="textRight">#springMessage('table.guaPledge.place')</td>
				<td >
                	<input  type="text"  id="place" name="place" class="layui-input" value="$!{guaPledge.place}">
				</td>
				##保管人
                <td class="textRight">#springMessage('table.guaPledge.keeper')</td>
                <td>
					<input  type="text"  id="keeper" name="keeper" class="layui-input" value="$!{guaPledge.keeper}">
				</td>
			</tr>
			<tr>
        		##调查人
				<td class="textRight">#springMessage('table.guaPledge.investigators')</td>
				<td >
                	<input  type="text"  id="investigators" name="investigators" class="layui-input" value="$!{guaPledge.investigators}">
				</td>
				##填报单位名称
                <td class="textRight">#springMessage('table.guaPledge.regCorp')</td>
				<td width="36%">
					<div class="layui-input-inline">
						<div class="bt-biz-corp"
                        data-biz-type="corp"
                        data-type="selectTree"
                        data-name="regCorp"
                        data-biz-name="regCorp"
                        data-width="300px;"
						data-defaultvalue="$!{guaPledge.regCorp}"
						data-resource="gua:pledge:change:apply"
						data-callback="corpRegCallback">
						</div>
					</div>
				</td>
			</tr>
            <tr>
				## 备注
                <td class="textRight">#springMessage('common.message.remark')</td>
                <td>
                    <input type="text" id="rmk" name="rmk" class="layui-input" value="$!{guaPledge.rmk}">
                </td>
                <td></td>
                <td></td>
            </tr>
			<tr>
				<td class="textRight">#springMessage('cms.loan.attachment')</td>
				<td style="text-align: center;" colspan="3">
					<!-- 附件上传 -->
					<input id="annexName" name="uploadId" type="hidden" value="$!{guaPledge.attachmentId}">
			        <div id="uploader" class="layui-input-inline" style="width:100%"></div>
				</td>
			</tr>
			<tr>
				<td style="text-align: center;" colspan="4">
					<button class="layui-btn" lay-submit="" id="submit"  value="11">#springMessage('table.guaPledge.changed')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaPledgeChange.add.js?_btv=${resourceVersion}"></script>
</html>

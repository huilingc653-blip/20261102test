<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="" id="inputForm">
    <input type="hidden" id="corpId" value="$!{paramsVO.corpId}"/>
    <input type="hidden" id="startDate" value="$!date.format('yyyy-MM-dd',$!{paramsVO.startDate})"/>
    <input type="hidden" id="endDate" value="$!date.format('yyyy-MM-dd',$!{paramsVO.endDate})"/>
    <input type="hidden" id="curId" value="$!{paramsVO.curId}"/>
    <input type="hidden" id="contractIds" value="">
    <input type="hidden" id="businessId" value="$!{businessId}">
    <input type="hidden" id="billCode" value="$!{billCode}">
    <input type="hidden" id="sysCode" value="$!{sysCode}">
    <table  id="infoTable" class="layui-table layui-form" style="width:100%;" data-test="test">
        <thead>
        <tr>
            <th>#springMessage('table.guaContract.contractCode')</th>##合同编号
            <th>#springMessage('table.guaContract.guaNo')</th>##担保编号
            <th>#springMessage('table.guaContract.guaType')</th>##担保方式
            <th>#springMessage('table.guaContract.startDate')</th>##担保开始日期
            <th>#springMessage('table.guaContract.endDate')</th>##担保结束日期
            <th>#springMessage('table.guaContract.curId')</th>##币别
            <th>#springMessage('table.guaContract.guaMoney')</th>##担保额度
            <th>#springMessage('common.table.thead.operation')</th>##操作
            </th>
        </tr>
        </thead>
        <tbody id="guaContract">
            #foreach($contract in $!{contractlist})
            <tr id="$!{contract.id}">
                <td align="center" >$!{contract.contractCode}</td>
                <td align="center" >$!{contract.guaNo}</td>
                <td align="center" >$!{contract.guaTypeName}</td>
                <td align="center" >$!date.format('yyyy-MM-dd',$!{contract.startDate})</td>
                <td align="center" >$!date.format('yyyy-MM-dd',$!{contract.endDate})</td>
                <td align="center" >$!{contract.curName}</td>
                <td align="right">$number.formatNumeric($!{contract.guaMoney})</td>
                <td style="text-align:center"><button type="button" class="layui-btn release">#springMessage('common.gua.release')</button></td>
            </tr>
            #end
        </tbody>
        <footer>
            <tr>
                <td colspan="10" style="text-align: center;">
                    <button class="layui-btn bt-biz-guaContract"  data-biz-name="guaContract" type="button"
                            data-callback="guaContractCallback" data-beforeClick="bt.guaContractBeforeClick">#springMessage('common.button.add')
                    </button>
                    <button type="button" class="layui-btn" onclick="sureButton()">#springMessage('common.button.sure')</button>
                    <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.close')</button>
                </td>
            </tr>
        </footer>
    </table>
</form>
</body>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/guarantee/changeContract.list.js?_btv=${resourceVersion}"></script>
</html>
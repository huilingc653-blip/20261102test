<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            padding-bottom:0;
            padding-top:5px;
        }
    </style>
</head>
<body>
<form class="layui-form " id="searchForm">
    <input type="hidden" id="corpId" name="likes_corpId" value="$!{paramsVO.corpId}">
##    <input type="hidden" id="curId" name="likes_curId" value="$!{paramsVO.curId}">
	<table class="layui-table">
            <tbody>
                <tr>
                    <td class="textRight">#springMessage('table.guaContract.contractCode')</td>##合同编号
                    <td>
						<input type="text" name="likes_contractCode" autocomplete="off" class="layui-input" placeholder="#springMessage('table.guaContract.contractCode')">
                    </td>
                ##担保日期
                    <td class="textRight" width="25%">#springMessage('table.guaContract.date')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <input type="text" name="led_startDate" data-name="led_startDate"
                                   class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date" value="$!date.format('yyyy-MM-dd',$!{paramsVO.startDate})">
                        </div>
                        <span class="date-mid">#springMessage('table.guaContract.range')</span>
                        <div class="layui-inline">
                        <input type="text" name="ged_endDate"　data-name="ged_endDate"
                               class="layui-input bt-biz-dateType" id="endDate" data-type="date" value="$!date.format('yyyy-MM-dd',$!{paramsVO.endDate})">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td  class="textRight">#springMessage('table.bisAccDtl.curName')</td>
                    <td >
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" data-name="eqs_curId" data-biz-name="eqs_curId" data-inputValue="false"
                                 data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                                 data-textfield="curName"></div>
                        </div>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td style="text-align: center;" colspan="4">
                    	<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                        <button class="layui-btn"  onClick="transferData()" type="button">#springMessage('common.button.sure')</button>
                    </td>
                </tr>
			</tbody>
        </table>
    </div>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.guaContract.contractCode')</th>##合同编号
        <th>#springMessage('table.guaContract.guaNo')</th>##担保编号
        <th>#springMessage('table.ratBkration.guaCorpId')</th>##担保单位
        <th>#springMessage('table.guaContract.guaType')</th>##担保方式
        <th>#springMessage('table.guaContract.startDate')</th>##担保开始日期
        <th>#springMessage('table.guaContract.endDate')</th>##担保结束日期
        <th>#springMessage('table.guaContract.curId')</th>##币别
        <th>#springMessage('table.guaContract.guaMoney')</th>##担保额度
	    <th style="hidden"></th>##担保合同id
        <th style="hidden"></th>##担保方式code
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script>
    var datatable;
    bt.use(['form','datatable','dateType','select','corp','money','moneyType','btImport','dicts','selectType'], function(){
        $ = bt.jquery,form = bt.form();
        bt.corp.init();
        var dicts = bt.dicts.init();
        bt.moneyType.init();
        bt.dateType.init();
        bt.selectType.init();
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            checkbox:true,
            order: [[4,'asc']],
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath+"/cms/guarantee/guaContractInfo/approvedDatatable"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            fixedColumns: {
                rightColumns:1//代表冻结右边一列
            },
            columns: [
                {data:"contractCode",bSortable:false},
                {data:"guaNo",bSortable:false},
                {data:"guaPerson",bSortable:false},
                {data:"guaTypeName",className:'center',bSortable:false},
                {data:"startDate",className:'center',bSortable:false},
                {data:"endDate",className:'center',bSortable:false},
                {data:"curName",className:'center',bSortable:false},
                {data:"guaMoney",bSortable:true,className:'textRight',
                    render: function ( data, type, full, meta ) {
                        return bt.money.format(full.guaMoney);
                    }
                },
                {data:"id",visible:false},
                {data:"guaWayCode",visible:false}
            ]
        });

        //点击提交数据到前台页面
        transferData=function(){
            var info=[];
            //内置方法返回选中的数据
            var data=bt.datatable.getSelectData('#appTable');
            if(data.length>0){
                for(var i=0;i<data.length;i++){
                    var guaContractData={
                        id:data[i].id,
                        contractCode:data[i].contractCode,
                        guaNo:data[i].guaNo,
                        guaPerson:data[i].guaPerson,
                        guaTypeName:data[i].guaTypeName,
                        guaWayCode:data[i].guaWayCode,
                        startDate:data[i].startDate,
                        endDate:data[i].endDate,
                        curName:data[i].curName,
                        guaMoney:data[i].guaMoney
                    }
                    info.push(guaContractData);
                }
            }else{
                layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 2});
                return;
                //info.push("");
            }
            var parentIframe = decodeURIComponent((location.search.match(/[?&]parentIframe=([^&]*)/) || ['', ''])[1]);
            var currentParentIframe = parentIframe || top.$('.layui-tab-content > .layui-show').find('iframe')[0]['name'];
            var func = top.frames[currentParentIframe].btSelectCallBack['bt-biz-guaContract']['callback'];
            if (func) {
                var data =info;
                func(data);
            }
        }
    });
</script>
</body>
</html>

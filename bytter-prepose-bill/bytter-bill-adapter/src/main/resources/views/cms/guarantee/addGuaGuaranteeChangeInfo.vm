<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	#rateInfo input {
    		text-align:right;
    	}
    	#rateInfo .bt-biz-rateType {
    		width:128px;
    	}

    </style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input type="hidden" id="bankCode" name="openCorp" />
		<input type="hidden" id="applyCorp" value="" />
		<input type="hidden" id="guaraId" name="guaraId" value="" />
		<input type="hidden" id="curId" name="curId" value="" />
		<input type="hidden" id="bondMoneyOld" name="bondMoneyOld" value="" />
		##变更前保函金额用于暂存或提交时判断授信额度
		<input type="hidden" id="guaOldMoney" name="guaOldMoney" value=""/>
        <input type="hidden" id="isRat" value=""/>
        <input type="hidden" id="openCorp" value=""/>
        <input type="hidden" id="bankName" value=""/>
        <input type="hidden" id="corpName" value=""/>
        <input type="hidden" id="curName" value=""/>
		<table class="layui-table">
		<tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label><b>#springMessage('table.guaGuarantee.application')</b></label>
				</td>
			</tr>
        	<tr>
			 ##保函申请人
             <td class="textRight">#springMessage('table.guaGuarantee.applyPeople')</td>
			  <td>
				  <div class="layui-input-inline">
					<div class="bt-biz-corp"
							data-biz-type="corp"
							data-type="selectTree"
							data-name="corpId"
							data-biz-name="corpId"
							data-scope="all"
							data-required="true"
							data-resource="gua:guarantee:change:apply"
							data-callback="bt.corpCallback">
						</div>
				   </div>
			   </td>
        		##保函类型
				<td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.type')</td>
				<td>
					<div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.TypeAttr"  data-name="guaranteeType" data-biz-name="guaranteeType" data-required="true" data-disabled="true"></div>
				</td>
			</tr>
           <tr>
			    ##保函编号
               <td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.No')</td>
					<td>
						<div class="layui-input-inline">
							<input type="text" id="guaranteeNo" name="guaranteeNo" lay-verify="required|tableData" data-biz-name="guaranteeNo" lay-verify="required"
								 autocomplete="off" class="layui-input text" placeholder="#springMessage('table.guaGuarantee.No')">
							<table id="lgInfoTable" class="hide">
								<thead>
									<tr>
										<th>#springMessage('table.guaGuarantee.No')</th>##保函编号
										<th>#springMessage('table.guaGuarantee.type')</th>##保函类型
										<th>#springMessage('table.guaGuarantee.openPeople')</th>##保函开立人
                                        <th>#springMessage('table.guaGuarantee.beneficiary')</th>##保函受益人
                                        <th>#springMessage('table.guaGuarantee.money')</th>##保函金额
                                        </th>
									</tr>
								</thead>
							</table>
						</div>
				</td>
		    	##开立人类型
			 <td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.openPeopleType')</td>
              <td>
					<div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.openPeopleType"  data-name="openCorpType" data-biz-name="openCorpType" data-required="true" data-disabled="true"></div>
				<span>
				##开立方式
			   #springMessage('table.guaGuarantee.openWay')
			   <div class="bt-biz-dict" id="openWay" data-type="select" data-group="guarantee.Lg.openWay"
				data-name="openWay" data-biz-name="openWay" data-required="true" data-callback="openWayCallback" data-disabled="true"></div>
			   ##开立类型
			   #springMessage('table.guaGuarantee.openType')
			   <div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.openType"  data-name="openType" data-biz-name="openType" data-required="true" disabled="disabled" data-disabled="true"></div>
				</span>
			  </td>
		   </tr>

        	<tr>
        		##保函开立人
				<td class="textRight" width="11%"><font color="red">*</font>#springMessage('table.guaGuarantee.openPeople')</td>
				<td width="26%">
				 <input type="text" id="openCorpName" name="openCorpName"  autocomplete="off" class="layui-input" readonly="true" placeholder="#springMessage('table.guaGuarantee.openPeople')" lay-verify="required">
				</td>
				##保函受益人
				<td class="textRight" width="14%">#springMessage('table.guaGuarantee.beneficiary')</td>
				<td width="36%">
                    <input type="text" id="incomeCorp" name="incomeCorp"  autocomplete="off" class="layui-input" placeholder="#springMessage('table.guaGuarantee.beneficiary')" lay-verify="required" readonly="true">
                </td>
			</tr>
			<tr>
				##币别
                <td class="textRight">#springMessage('table.guaGuarantee.curId')</td>
                <td>
					 <input class="layui-input curName"  name="curName"  readonly="readonly" autocomplete="off" lay-verify="required">
				</td>
        		##保函金额
				<td class="textRight">#springMessage('table.guaGuarantee.money')</td>
				<td >
                	<input type="text" id="guaranteeMoneyOld" name="guaranteeMoneyOld"  data-decimal="2" class="layui-input bt-biz-moneyType"
						lay-verify="required" readonly="true" data-biz-name="guaranteeMoneyOld">
				</td>
			</tr>
			<tr>
        		##保函性质
				<td class="textRight"><font color="red">*</font>#springMessage('table.guaGuarantee.lgNature')</td>
				<td >
				 <div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.nature" data-name="guaranteeAttr" data-biz-name="guaranteeAttr" data-disabled="true"> </div>
				</td>
				##保函预计结束日期
				<td class="textRight">#springMessage('table.guaGuarantee.expectEndDate')</td>
				<td >
                	<input type="text" name="expectEndDateOld"　data-name="expectEndDateOld"    data-endid="expectEndDate"
								class="layui-input bt-biz-dateType" id="expectEndDateOld" data-type="date" readonly="true">
				</td>
			</tr>
			<tr>
        		##保函开始时间
				<td class="textRight">#springMessage('table.guaGuarantee.startDate')</td>
				<td >
                	<input type="text" name="startDate" data-name="startDate"  id="startDate" readonly="true"
					data-biz-name="startDate"	class="layui-input bt-biz-dateType"  data-type="date" lay-verify="required">
				</td>
				##保函截止时间
                <td class="textRight">#springMessage('table.guaGuarantee.endDate')</td>
                <td>
					<input type="text" name="endDateOld"　data-name="endDateOld"  readonly="true" id="endDateOld"   data-endid="endDate"
								class="layui-input bt-biz-dateType"  data-type="date" >
				</td>
			</tr>
			<tr style="display:none";>
				 ##转开行
                <td class="textRight">#springMessage('table.guaGuarantee.turnBank')</td>
                <td>
				    <input type="text" id="turnBank" name="turnBank"  class="layui-input" placeholder="#springMessage('table.guaGuarantee.turnBank')">
				</td>
                <td></td>
				<td></td>
			</tr>
			##保证金相关信息
				#if($!{isHangBail}=="1")
                <tr class="isShowBondInfo">
                    <td class="textRight" width="15%">#springMessage('table.fcBond.bondAcc')</td>
                    <td><input type="text" id="bondAcc" autocomplete="off" class="layui-input"
                               readonly="true">
                    </td>
                    <td class="textRight" width="15%">#springMessage('table.fcBond.contractNum')</td>
                    <td><input type="text" id="bondContract" autocomplete="off" class="layui-input"
                               readonly="true">
                    </td>
                </tr>
				#end
			##显示授信信息
                <tr class="isShowRatInfo" style="display: none;">
				##授信品种
                    <td class="textRight">#springMessage('table.guarantee.ratItemCode')</td>
                    <td id="itemCode"></td>
				##授信业务品种名称
                    <td class="textRight">#springMessage('cms.business.race')</td>
                    <td id="billName"></td>
                </tr>
                <tr>
				##是否折合本位币
                    <td class="showRBC textRight"  style="display: none;">#springMessage('table.cmsProvideLoanInfo.isRmbRat')</td>
                    <td class="showRBC" id="isRBC" style="display: none;"></td>
				##授信查看
                    <td class="textRight isShowRatInfo" style="display: none;">#springMessage('table.guarantee.rationSelect')</td>
                    <td class="isShowRatInfo" style="display: none;"><button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage('common.button.view')</button></td>
                    <span class="isShowRatInfo"  id="itemCodeTd" style="display: none;"></span>
                </tr>
            <tr class="isShowRatInfo" style="display: none;">
                <td class="textRight">#springMessage('gua.start.Openrat')</td>##是否启用敞口授信
                <td id="isOpenRat"></td>
				<td></td>
                <td></td>
            </tr>
			##授信信息显示结束


			</tbody>
        </table>
		<table class="layui-table">
		 <tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label><b>#springMessage('table.guaGuarantee.changeMsg')</b></label>
				</td>
			</tr>
			<tr>
				##保函更改申请日期
				<td class="textRight" width="11%">#springMessage('table.guaGuarantee.lgChangedate')</td>
				<td width="26%">
				   <input id="changeDate" name="changeDate" value="$!{inputDate}" readonly="readonly"
					autocomplete="off" class="layui-input" lay-verify="required">
				</td>
				##保函变更单号
				<td class="textRight" width="14%">#springMessage('table.guaGuarantee.lgChangeNo')</td>
				<td >
				   <input id="guaraChangeNo" name="guaraChangeNo" value="$!{guaraChangeNo}" readonly="readonly" autocomplete="off" class="layui-input" lay-verify="required">
				</td>
			</tr>
			<tr>
				##保函更改次数
				<td class="textRight">#springMessage('table.guaGuarantee.lgChangeNum')</td>
				<td>
				   <input id="changeCount" name="changeCount"  readonly="readonly" autocomplete="off" class="layui-input">
				</td>
				##币别
##                <td class="textRight">#springMessage('table.guaGuarantee.curId')</td>
##                <td>
##					 <input class="layui-input curName"  name="curName"  readonly="readonly" autocomplete="off" >
##				</td>
                    <td class="textRight">#springMessage('table.urationapply.bondCurId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" data-name="bondCurId"
                                 data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                                 data-textfield="curName"
                                 data-biz-name="bondCurId" data-disabled="true" ></div>
                        </div>
                    </td>
			</tr>
			<tr>
        		##新截止日期
				<td class="textRight">#springMessage('table.guaGuarantee.newEndDate')</td>
				<td >
                	<input type="text" name="endDate" data-name="endDate"  id="endDate"
								class="layui-input bt-biz-dateType"  data-type="date" >
				</td>
				##新预计结束日期
				<td class="textRight">#springMessage('table.guaGuarantee.newExpectEndDate')</td>
				<td >
                	<input type="text" name="expectEndDate"　data-name="expectEndDate"  id="expectEndDate"
								class="layui-input bt-biz-dateType"  data-type="date" >
				</td>
			</tr>
			<tr>
        		##保函金额调整类型
				<td class="textRight">#springMessage('table.guaGuarantee.lgChangeType')</td>
				<td >
				 <div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.ChangeType" data-defaultvalue="0" data-name="guaChangeType" data-biz-name="guaChangeType" data-callback="calLgMoney"></div>
				</td>
				##保函保证金调整类型
				<td class="textRight">#springMessage('table.guaGuarantee.bondChangeType')</td>
				<td >
				 <div class="bt-biz-dict" data-type="select" data-group="guarantee.Lg.ChangeType" data-defaultvalue="0" data-name="bondChangeType" data-biz-name="bondChangeType" data-callback="calLgBondMoney" ></div>
				</td>
			</tr>
			<tr>
        		##保函调整金额
				<td class="textRight">#springMessage('table.guaGuarantee.lgChangeMoney')</td>
				<td >
                	<input type="text" id="guaChangeMoney" name="guaChangeMoney" data-decimal="2"
						class="layui-input bt-biz-moneyType" data-biz-name="guaChangeMoney"
						data-callback="calLgMoney">
				</td>
				##保证金调整金额
				<td class="textRight">#springMessage('table.guaGuarantee.bondChangeMoney')</td>
				<td >
					<input type="text" id="bondChangeMoney" name="bondChangeMoney" data-decimal="2"
						class="layui-input bt-biz-moneyType" data-biz-name="bondChangeMoney"
						 data-callback="calLgBondMoney">
				</td>
			</tr>
			<tr>
        		##调整后保函金额
				<td class="textRight">#springMessage('table.guaGuarantee.moneySum')</td>
				<td >
					<input type="text" id="guaranteeMoney" name="guaranteeMoney" data-decimal="2" class="layui-input bt-biz-moneyType" data-biz-name="guaranteeMoney"  readonly="true">
				</td>
				##调整后保证金
				<td class="textRight">#springMessage('table.guaGuarantee.bondMoneySum')</td>
				<td >
					<input type="text" id="bondMoney" name="bondMoney"  data-decimal="2" class="layui-input bt-biz-moneyType" data-biz-name="bondMoney" readonly="true">
				</td>
			</tr>
			<tr>
        		##调整后保函手续费金额
				<td class="textRight">#springMessage('table.guaGuarantee.hanleChargeSum')</td>
				<td >
                	<input type="text" id="handleCharge" name="handleCharge" data-decimal="2" class="layui-input bt-biz-moneyType" data-biz-name="handleCharge" >
				</td>
				##修改条款
				<td class="textRight">#springMessage('table.guaGuarantee.changeTerm')</td>
				<td >
					<input type="text" id="changeTerm" name="changeTerm"  class="layui-input">
				</td>
			</tr>
			<tr>
				##修改原因
				<td class="textRight">#springMessage('table.guaGuarantee.changeReason')</td>
				<td >
					<input type="text" id="changeReason" name="changeReason"  class="layui-input">
				</td>
				##经办人
				<td class="textRight">#springMessage('table.guaGuarantee.operator')</td>
				<td >
					<input type="text" id="operator" name="operator"  class="layui-input" lay-verify="required">
				</td>
			</tr>
			<tr>
				<td style="text-align: center;" colspan="4">
					<button class="layui-btn" lay-submit="" id="submit" value="11">#springMessage('common.button.submit')</button>
					<button class="layui-btn" lay-submit="" id="temp" value="0">#springMessage('common.button.temp')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaGuaranteeChangeInfo.add.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationSet.js?_btv=${resourceVersion}"></script>
</html>

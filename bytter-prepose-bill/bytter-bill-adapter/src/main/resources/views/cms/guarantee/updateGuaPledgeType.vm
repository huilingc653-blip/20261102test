<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{guaPledgeType.id}">
		<input id="validSign" name="validSign" type="hidden" value="$!{guaPledgeType.validSign}">
		<input id="createDate" name="createDate" type="hidden" value="$!{guaPledgeType.createDate}">
		<input id="createBy" name="createBy" type="hidden" value="$!{guaPledgeType.createBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{guaPledgeType.updateDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{guaPledgeType.updateBy}">	
        <table class="layui-table">
			<tbody>
        	<tr>
        		##抵质押物类型编码
				<td class="textRight">#springMessage('table.guaPledge.typeCode')</td>
				<td width="40%">
                        <input type="text" id="typeCode" name="typeCode" maxlength="10" lay-verify="required|strlength" data-maxlength="10" value="$!{guaPledgeType.typeCode}"
                               onblur="checkNO(this)" maxlength="10"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.guaPledge.typeCode')">
				</td>
        		##抵质押物类型
				<td class="textRight">#springMessage('table.guaPledge.pledgeType')</td>
				<td width="40%">
                    <div class="layui-inline">
                        <input style="display: inline;" type="text" id="typeName" name="typeName"  lay-verify="required|strlength" data-maxlength="100"
                               value="$!{guaPledgeType.typeName}" maxlength="100"
                               autocomplete="off" class="layui-input"
                               placeholder="#springMessage('table.guaPledge.pledgeType')">
                        <span data-toggle="i18n" data-key-id="$!{guaPledgeType.id}"/>
                        <div>
				</td>
			</tr>
            <tr>
				##抵质押物性质
				<td class="textRight">#springMessage('table.guaPledge.pledgeAttr')</td>
				<td colspan="3">
					<div class="bt-biz-dict" data-type="radio" data-group="pledge_type" data-defaultvalue="$!{guaPledgeType.typeAttr}" 
						data-name="typeAttr" data-biz-name="typeAttr" ></div>	
				</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaPledgeType.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .operate:hover {
            color: #2b85e4;
        }
    </style>
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" id="relateCon" value="$!{relateCon}">
		<table class="layui-table">
            <tbody>
                <tr>
                ##担保编号
                    <td class="textRight" width="25%">#springMessage('table.guaContract.guaNo')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_guaNo" autocomplete="off"
                                   class="layui-input" placeholder="#springMessage('table.guaContract.guaNo')">
                        </div>
                    </td>
                ##合同编号
                    <td class="textRight" width="25%">#springMessage('table.guaContract.contractCode')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_contractCode" autocomplete="off"
                                   class="layui-input" placeholder="#springMessage('table.guaContract.contractCode')">
                        </div>
                    </td>
                </tr>
                <tr>
                ## 担保单位
                    <td class="textRight">#springMessage('table.guaContract.guaPerson')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="likes_corpId"
                                 data-scope="all"
                                 data-resource="gua:contract:info:query"
                                 placeholder="#springMessage('common.placeholder.select')"></div>
                        </div>
                    </td>
                ##债权人
                    <td class="textRight" width=25%">#springMessage('table.guaContract.creditorPerson')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <input class="layui-input"  name="likes_creditorPerson"  type="text" lay-verify="strlength" data-maxlength="100"/>
                        </div>
                    </td>
                </tr>
                <tr>
                ##                ##债务人
                ##                    <td class="textRight" width="25%">#springMessage('table.guaContract.debtorPersonName')</td>
                ##                    <td width="25%">
                ##                        <div class="layui-inline" id="debtorPersonDiv">
                ##                            <input class="layui-input" name="likes_debtorPerson"  type="text" lay-verify="strlength" data-maxlength="100"/>
                ##                        </div>
                ##                    </td>
                ##担保日期
                    <td class="textRight" width="25%">#springMessage('table.guaContract.date')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <input type="text" name="led_startDate" data-name="led_startDate"
                                   class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                        </div>
                        <span class="date-mid">#springMessage('table.guaContract.range')</span>
                        <div class="layui-inline">
                            <input type="text" name="ged_endDate" 　data-name="ged_endDate"
                                   class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                        </div>
                    </td>
                ##担保额度
                    <td class="textRight">#springMessage('table.guaContract.sumMoney')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <input type="text" data-name="geg_guaMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                   data-moneyendid="guaMoney">
                        </div>
                        <span class="date-mid">#springMessage('table.guaContract.range')</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_guaMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                   id="guaMoney">
                        </div>
                    </td>
                </tr>
                <tr>
                    ##担保方式
                    <td class="textRight" width="25%"><span class="pl">#springMessage('table.guaContract.guaType')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <div class="selectDemo bt-biz-mulselectType" data-id="guaWay" data-biz-name="ins_guaWay" data-method="get"
                                 data-url="${basePath}/cms/guarantee/guaContractInfo/json" data-valuefield="id" data-textfield="name"
                                 data-name="ins_guaWay" ></div>
                        </div>
                    </td>
                    ##状态
                        <td class="textRight">#springMessage('table.guaContract.status')</td>
                        <td>
                            <div class="layui-inline">
                                <select lay-filter="status" name="eqi_status" >
                                    <option value=" ">#springMessage('common.placeholder.select')</option>
                                    #foreach($dict in $dictTag.list("extContract.status"))
                                        <option value="$dict.code">$dict.name</option>
                                    #end
                                </select>
                            </div>
                        </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>	
    </form>  

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.guaContract.guaPerson')</th>
                <th>#springMessage('table.guaContract.guaNo')</th>
                <th>#springMessage('table.guaContract.guaType')</th>
				<th>#springMessage('table.guaContract.creditorPerson')</th>
                <th>#springMessage('table.guaContract.debtorPersonName')</th>
                <th>#springMessage('table.guaContract.curId')</th>
                <th>#springMessage('table.guaContract.sumMoney')</th>
                <th>#springMessage('table.guaContract.contractCode')</th>
				<th>#springMessage('table.guaContract.startDate')</th>
				<th>#springMessage('table.guaContract.endDate')</th>
                <th>#springMessage('table.guaContract.status')</th>
                <th>#springMessage('table.drawdownPeriod.date')</th>##提款日期
				<th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/searchGuaExtContractInfo.list.js?_btv=${resourceVersion}"></script>
</html>

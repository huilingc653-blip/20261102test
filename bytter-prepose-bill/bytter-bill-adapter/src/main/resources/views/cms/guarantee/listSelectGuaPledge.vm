<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<input type="hidden" name="eqs_corpId" autocomplete="off"  class="layui-input" value="$!{vo.corpId}">
			<input type="hidden" name="eqs_curId" autocomplete="off"  class="layui-input" value="$!{vo.curId}">
			<input type="hidden" name="led_startDate" data-name="led_startDate"  class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date" value="$!date.format('yyyy-MM-dd',$!{vo.startDate})">
			<input type="hidden" name="ged_endDate"　data-name="ged_endDate"  value="$!date.format('yyyy-MM-dd',$!{vo.endDate})"
								class="layui-input bt-biz-dateType" id="endDate" data-type="date">
			<input type="hidden" name="eqs_pledgeAttr" autocomplete="off"  class="layui-input" value="$!{vo.pledgeAttr}">
            <input type="hidden" name="eqs_pDids" id="pDids" value="$!{vo.pDids}">##抵押物id组合

        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.guaPledge.corpId')</th>
                <th>#springMessage('table.guaPledge.pledgeAttr')</th>
                <th>#springMessage('table.guaPledge.pledgeNo')</th>
                <th>#springMessage('table.guaPledge.pledgeType')</th>
                <th>#springMessage('table.guaPledge.pledgeName')</th>
                <th>#springMessage('table.guaPledge.startDate')</th>
				<th>#springMessage('table.guaPledge.endDate')</th>
                <th>#springMessage('table.guaPledge.curId')</th>
				<th>#springMessage('table.guaPledge.pledgeMoney')</th>
				<th>#springMessage('table.guaPledge.freezeMoney')</th>
				<th>#springMessage('table.guaPledge.occupyMoney')</th>
				<th>#springMessage('table.guaPledge.availMoney')</th>
            </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/selectGuaPledge.list.js?_btv=${resourceVersion}"></script>
</html>

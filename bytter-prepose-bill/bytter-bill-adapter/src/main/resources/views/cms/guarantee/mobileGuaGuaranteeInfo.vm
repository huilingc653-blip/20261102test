#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##保函编号
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.No')
        <span class="mui-badge mui-badge-inverted">
            $!{LgInfoVo.guaranteeNo}
        </span>
    </li>
##保函类型
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.type')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.Lg.TypeAttr", "$!{LgInfoVo.guaranteeType}")
        </span>
    </li>
##保函申请人
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.applyPeople')
        <span class="mui-badge mui-badge-inverted">
            $!{LgInfoVo.corpName}
        </span>
    </li>
##开立人类型
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.openPeopleType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.Lg.openPeopleType", "$!{LgInfoVo.openCorpType}")
        </span>
    </li>
##开立方式
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.openWay')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.Lg.openWay", "$!{LgInfoVo.openWay}")
        </span>
    </li>
##开立类型
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.openType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.Lg.openType", "$!{LgInfoVo.openType}")
        </span>
    </li>
##保函开立人
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.openPeople')
        <span class="mui-badge mui-badge-inverted">
            $!{LgInfoVo.openCorpName}
        </span>
    </li>
##保函受益人
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.beneficiary')
        <span class="mui-badge mui-badge-inverted">
            $!{LgInfoVo.incomeCorp}
        </span>
    </li>
##币别
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.curId')
        <span class="mui-badge mui-badge-inverted">
            $!{LgInfoVo.curName}
        </span>
    </li>
##保函金额
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.money')
        <span class="mui-badge mui-badge-inverted">
            $number.formatNumeric($!{LgInfoVo.guaranteeMoney})
        </span>
    </li>
##保函性质
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.lgNature')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("guarantee.Lg.nature", "$!{LgInfoVo.guaranteeAttr}")
        </span>
    </li>
##保证事项
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.lgMatter')
        <span class="mui-badge mui-badge-inverted">
            $!{LgInfoVo.guaItem}
        </span>
    </li>
##保函开始时间
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.startDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!LgInfoVo.startDate)
        </span>
    </li>
##保函截止时间
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.endDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!LgInfoVo.endDate)
        </span>
    </li>
##保函预计结束日期
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.expectEndDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!LgInfoVo.expectEndDate)
        </span>
    </li>
##转开行
    #if($!{LgInfoVo.openWay} == "1")
        <li class="mui-table-view-cell">
            #springMessage('table.guaGuarantee.turnBank')
            <span class="mui-badge mui-badge-inverted">
                $!{LgInfoVo.turnBank}
            </span>
        </li>
    #end
##被担保单位
    <li class="mui-table-view-cell">
        #springMessage('table.guaGuarantee.guaranteedCorp')
        <textarea rows="3" class="layui-textarea" readonly="readonly">$!{guaranteeedCorp}</textarea>
    </li>
##挂接授信开始
#if($!{rations})
    <li class="mui-table-view-divider">#springMessage('table.guarantee.rationSelect')</li>
    #foreach($ration in $!{rations})
    ##授信额度使用单位
        <li class="mui-table-view-cell">
            #springMessage('table.ratUrationApply.corpId')
            <span class="mui-badge mui-badge-inverted">
                $!{ration.corpName}
            </span>
        </li>
    ##授信币别
        <li class="mui-table-view-cell">
            #springMessage('table.ratBkration.curCode')
            <span class="mui-badge mui-badge-inverted">
                $!{ration.curName}
            </span>
        </li>
    ##授信开始日期
        <li class="mui-table-view-cell">
            #springMessage('table.ratUrationApply.beginDate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!ration.beginDate)
            </span>
        </li>
    ##授信结束日期
        <li class="mui-table-view-cell">
            #springMessage('table.ratUrationApply.endDate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!ration.endDate)
            </span>
        </li>
        #foreach($rationDlt in $!{ration.rationDlts})
                ##授信品种
                    <li class="mui-table-view-cell">
                        #springMessage('table.guarantee.ratItemCode')
                        <span class="mui-badge mui-badge-inverted">
                            $!{rationDlt.itemName}
                        </span>
                    </li>
                #if($!{rationDlt.itemFlag} == "1")
                ##剩余最高额度
                    #foreach($uratDtl in $!{rationDlt.rationDlts})
                        #set($vcount1 = $velocityCount - 1)
                        <li class="mui-table-view-cell">
                            #springMessage('table.ratBkrationDetail.leftMaxMoney')
                            <span class="mui-badge mui-badge-inverted">
                                $!number.formatNumeric($!{uratDtl.itemMoney})
                            </span>
                        </li>
                    #end

                #end
                ##授信额度
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkration.money')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($!{rationDlt.money})
                        </span>
                    </li>
                ##占用额度
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkrationDisDetail.superProcessMoney')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($!{rationDlt.useMoney})
                        </span>
                    </li>
                ##在审占用额度
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkrationDisDetail.checkProcessMoney')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($!{rationDlt.approveMoney})
                        </span>
                    </li>
                ##剩余授信额度
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkrationDisDetail.leftDisMoney')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($!{rationDlt.leftMoney})
                        </span>
                    </li>
                ##可用额度
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkrationDisDetail.overPlusMoney')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($!{rationDlt.overPlusMoney})
                        </span>
                    </li>
                ##授信占用比例
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkrationDisDetail.ratOccupyRatio')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($math.mul($!{rationDlt.ratOccupyRatio},100),"0.00")%
                        </span>
                    </li>
                ##已占用比例
                    <li class="mui-table-view-cell">
                        #springMessage('table.ratBkrationDisDetail.ratOccupiedRation')
                        <span class="mui-badge mui-badge-inverted">
                            $number.formatNumeric($math.mul($!{ration.ratOccupiedRation},100),"0.00")%
                        </span>
                    </li>
                #end
    #end
    #end
##保证金信息
    #if($!{isHangBail}=="1")
        <li class="mui-table-view-divider">#springMessage('table.fcBond.BondMsg')</li>
        #if(${LgInfoVo.isHookBond}=="1")##关联保证金账户
            #set($fcBondApplyDTO=$fcBondTag.getBondUseDetail($!{LgInfoVo.id},$!{LgInfoVo.guaranteeNo}))
            <li class="mui-table-view-cell">##保证金账户
                #springMessage('table.fcBond.bondAcc')
                <span class="mui-badge mui-badge-inverted">
                    $!{fcBondApplyDTO.bankAcc}
                </span>
            </li>
            <li class="mui-table-view-cell">##账户名称
                #springMessage('table.fcBond.accountname')
                <span class="mui-badge mui-badge-inverted">
                    $!{fcBondApplyDTO.accName}
                </span>
            </li>
            <li class="mui-table-view-cell">##银行名称
                #springMessage('table.fcBondBack.bankName')
                <span class="mui-badge mui-badge-inverted">
                    $!{fcBondApplyDTO.bankName}
                </span>
            </li>
            <li class="mui-table-view-cell">##单位名称
                #springMessage('table.fcBond.corpName')
                <span class="mui-badge mui-badge-inverted">
                    $!{fcBondApplyDTO.corpName}
                </span>
            </li>
            <li class="mui-table-view-cell">##保证金合同
                #springMessage('table.fcBond.contractNum')
                <span class="mui-badge mui-badge-inverted">
                    $!{fcBondApplyDTO.bondContract}
                </span>
            </li>
            <li class="mui-table-view-cell">##币别
                #springMessage('table.fcBond.curCode')
                <span class="mui-badge mui-badge-inverted">
                    $!{fcBondApplyDTO.curName}
                </span>
            </li>
            <li class="mui-table-view-cell">##保证金金额
                #springMessage('table.fcBond.bondmoney')
                <span class="mui-badge mui-badge-inverted">
                    $!number.formatNumeric($!{fcBondApplyDTO.applyMoney})
                </span>
            </li>
            <li class="mui-table-view-cell">##保证金比例
                #springMessage('table.fcBond.bondPercent')
                <span class="mui-badge mui-badge-inverted">
                   #set($bondPercent=$!{fcBondApplyDTO.bondPercent}*100)
                   $!number.formatDoubles($!bondPercent,2)%
                </span>
            </li>
            <li class="mui-table-view-cell">##保证金利率
                #springMessage('table.fcBond.bondRate')
                <span class="mui-badge mui-badge-inverted">
                    #set($bondRate=$!{LgInfoVo.bondRate}*100)
                    $!number.formatNumeric($!bondRate,"#0.0000")%
                </span>
            </li>
        #else
            <li class="mui-table-view-cell">
                #springMessage('table.fcBond.corpName')
                <span class="mui-badge mui-badge-inverted">
                    $!{LgInfoVo.corpName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fcBond.contractNum')
                <span class="mui-badge mui-badge-inverted">
                    $!{LgInfoVo.bondContract}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fcBond.curCode')
                <span class="mui-badge mui-badge-inverted">
                    $!{LgInfoVo.curName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fcBond.bondmoney')
                <span class="mui-badge mui-badge-inverted">
                    $!number.formatNumeric($!{LgInfoVo.bondMoney})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fcBond.bondPercent')
                <span class="mui-badge mui-badge-inverted">
                   #set($bondPercent=$!{LgInfoVo.bondPercent}*100)
                    $!number.formatDoubles($!bondPercent,2)%
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fcBond.bondRate')
                <span class="mui-badge mui-badge-inverted">
                    #set($bondRate=$!{LgInfoVo.bondRate}*100)
                    $!number.formatNumeric($!bondRate,"#0.0000")%
                </span>
            </li>
        #end
    #end
    #parse("views/common/wapfooter.vm")
</body>
</html>

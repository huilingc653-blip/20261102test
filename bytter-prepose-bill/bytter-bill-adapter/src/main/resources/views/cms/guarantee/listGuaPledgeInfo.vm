<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
            <tbody>
                <tr>
                    ## 抵质押物编号
					<td class="textRight">#springMessage('table.guaPledge.pledgeNo')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_pledgeNo" autocomplete="off"
								class="layui-input" placeholder="#springMessage('table.guaPledge.pledgeNo')">
                        </div>
                    </td>
					##抵质押性质
                    <td class="textRight">#springMessage('table.guaPledge.pledgeAttr')</td>
                    <td>
                        <div class="layui-inline">
							<div class="bt-biz-dict" data-type="select" data-group="guarantee.pledge.TypeAttr" data-name="eqs_pledgeAttr" data-biz-name="pledgeAttr"
								data-callback="bt.refreshPledgeType"></div>
						</div>
                    </td>
					##抵质押类型
                    <td class="textRight">#springMessage('table.guaPledge.pledgeType')</td>
                    <td>
    				 	##<div type="list" field="eqs_pledgeType" name = "eqs_pledgeType" fieldHref="${basePath}/cms/guarantee/pledgeType/json" dictField="id" dictText="typeName" ></div>
						<div class="bt-biz-selectType" data-name="eqs_pledgeType" data-url="${basePath}/cms/guarantee/pledgeType/json" data-valuefield="id" data-textfield="typeName"  data-biz-name="pledgeType"
							data-callback="bt.refreshPledgeAttr"></div>
					</td>
                </tr>
				<tr>
                    ##抵质押日期
					<td class="textRight">#springMessage('table.guaPledge.date')</td>
                    <td>
                        <div class="layui-inline">
							<input type="text" name="ged_startDate" data-name="ged_startDate"
								class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                		</div>
						<span class="date-mid">#springMessage('table.guaPledge.range')</span>
						<div class="layui-inline"">
							<input type="text" name="led_endDate"　data-name="led_endDate"
								class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                		</div>
                    </td>
					##抵质押物名称
                    <td class="textRight">#springMessage('table.guaPledge.pledgeName')</td>
                    <td>
                        <input type="text" name="likes_pledgeName"  autocomplete="off" class="layui-input">
                    </td>
					##评估价值
                    <td class="textRight">#springMessage('table.guaPledge.pledgeMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_pledgeMoney"
								autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="pledgeMoney">
                        </div>
                        <span class="date-mid">#springMessage('table.guaPledge.range')</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_pledgeMoney"
                                    autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="pledgeMoney">
                        </div>
                    </td>
					</tr>
					<tr>
					##工商登记单号
                    <td class="textRight">#springMessage('table.guaPledge.regNumber')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_regNumber" autocomplete="off"
								class="layui-input">
                        </div>
                    </td>
                    <td class="textRight">#springMessage('table.guaPledge.pledgeOrg')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_pledgeOrg" autocomplete="off" class="layui-input">
                         </div>
                     </td>
                    ##				创建人
                    <td class="textRight">#springMessage('table.sysAttachment.createBy')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" name="likes_createBy" id="createBy" class="layui-input" >
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary" onclick="resetPledgeType()">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.guaPledge.corpId')</th>#*抵质押申请单位*#
                <th>#springMessage('table.guaPledge.pledgeAttr')</th>#*抵质押性质*#
                <th>#springMessage('table.guaPledge.pledgeNo')</th>#*抵质押物编号*#
                <th>#springMessage('table.guaPledge.pledgeType')</th>#*抵质押物类型*#
                <th>#springMessage('table.guaPledge.pledgeName')</th>#*抵质押物名称*#
                <th>#springMessage('table.guaPledge.startDate')</th>#*抵质押开始时间*#
				<th>#springMessage('table.guaPledge.endDate')</th>#*抵质押结束时间*#
				<th>#springMessage('table.guaPledge.pledgeMoney')</th>#*评估值*#
                <th>#springMessage('table.guaPledge.netWorth')</th>#*市场价值*#
                <th>#springMessage('table.guaPledge.curId')</th>#*币种*#
				<th>#springMessage('table.guaPledge.pledge')</th>#*出质人*#
                <th>#springMessage('table.guaPledge.pledgeOrg')</th>#*抵押机构*#
				<th>#springMessage('table.guaPledge.regNumber')</th>#*工商登记号*#
                <th>#springMessage('table.guaPledge.regCorp')</th>#*填报单位名称*#
                <th>#springMessage('table.sysAttachment.createBy')</th>#*创建人*#
                <th>#springMessage('table.guaPledge.status')</th>#*状态*#
				<th>#springMessage('common.table.thead.operation')</th>#*操作*#
            </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/guarantee/guaPledgeInfo.list.js?_btv=${resourceVersion}"></script>
</html>

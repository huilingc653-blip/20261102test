<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        /
        /
        这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="myform">
    #if($!{dfBusinessTypeVO.id})
        <input type="hidden" id="id" name="id" value="$!{dfBusinessTypeVO.id}">
    #end

    <table id="appTable" class="layui-table layui-form">
        <tr>
        ##费用编码
            <td class="textRight" style="width: 50%">#springMessage('df.businessCode')</td>
            <td style="width: 50%">
                <div class="layui-input-inline">
                    <input type="text" id="businessCode" name="businessCode" lay-verify="required" class="layui-input" value="$!{dfBusinessTypeVO.businessCode}">
                </div>
            </td>
        </tr>
        <tr>
        ##费用名称
            <td class="textRight">#springMessage('df.businessName')</td>
            <td>
                <input type="text" name="businessName" lay-verify="required" class="layui-input" value="$!{dfBusinessTypeVO.businessName}">
            </td>
        </tr>
        <tr>
        ##是否有效
            <td class="textRight">#springMessage('table.erpDataType.validSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="isValid"
                    #if($!{dfBusinessTypeVO.isValid})
                     data-value="$!{dfBusinessTypeVO.isValid}"
                    #else
                     data-value="1"
                    #end
                     data-biz-name="status"></div>
            </td>
        </tr>
        <tr>
            <td colspan="2"style="text-align: center">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    var dicts,form;
    bt.use(["jquery", "form", "dicts"], function () {
        $ = bt.jquery;
        form = bt.form();
        dicts = bt.dicts.init();

//监听提交
        form.on("submit(submit)", function (data) {
            if (!validate($("#id").val(), $("#businessCode").val())) {
                layer.alert(bt.lang("df.costCode.alreadyExists"), {icon: 2});
                return false;
            }
            var action = "/cms/dfBusinessType/save";
            bt.loading.show();
            $.post(basePath + action, data.field, function (data) {
                parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                if (data.success) {
                    if (!bt.navtab) {
                        bt.navtab.refreshParentTable();
                    } else {
                        bt.navtab.closeCurrent();
                    }
                } else {
                    bt.loading.hide();
                }
            }, 'JSON');
            return false;
        });

        //这里填写新的js代码，请参考前端文档
    });

    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }

    function validate(id,businessCode) {
        var result = false;
        $.ajax({
            url: basePath + "/cms/dfBusinessType/validate",
            data: {
                id:id,
                businessCode: businessCode
            },
            type: "post",
            dataType: "json",
            async: false,
            success: function (data) {
                result = data.success;
            }
        });
        return result;
    }
</script>
</body>
</html>

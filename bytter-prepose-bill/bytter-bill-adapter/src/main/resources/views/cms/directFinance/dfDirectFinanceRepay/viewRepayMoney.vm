<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
    <table id="appTable" class="layui-table layui-form">
        <thead>
        <tr>
            <th>#springMessage('df.real.repay.date')</th>#*实际还款日期*#
            <th>#springMessage('table.createRepayPlan.realityRepayMoney')</th>#*实际还款本金*#
            <th>#springMessage('df.real.pay.interest')</th>#*实际还款利息*#
            <th>#springMessage('df.real.pay.service.charge')</th>#*实际支付手续费*#
            <th>#springMessage('ttpay.rmk')</th>#*备注*#
        </tr>
        </thead>
        #foreach($element in $DfDirectFinanceRepayVOS)
            <tr>
                <td>$!date.format('yyyy-MM-dd',$!{element.repayDate})</td>
                <td class="textRight">$!number.formatNumeric($!{element.repayMoney})</td>
                <td class="textRight">$!number.formatNumeric($!{element.interest})</td>
                <td class="textRight">$!number.formatNumeric($!{element.serviceCharge})</td>
                <td>$!{element.rmk}</td>
            </tr>
        #end
    </table>
    #parse("views/common/footer.vm")
</body>
</html>

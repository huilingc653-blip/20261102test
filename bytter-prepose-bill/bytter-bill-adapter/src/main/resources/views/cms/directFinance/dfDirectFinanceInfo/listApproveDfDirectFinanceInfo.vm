<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form id="searchForm" class="layui-form">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
    <table class="layui-table">
        <tr>
##            证券代码
            <td width="10%" class="textRight">#springMessage('df.securities.code')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_stockCode" class="layui-input" >
                </div>
            </td>
##    证券名称
            <td width="10%" class="textRight">#springMessage('df.securities.name')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_stockName" class="layui-input" >
                </div>
            </td>
##    直融类别
            <td width="10%" class="textRight">#springMessage('df.business.type')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-biz-name="dfBusinessTypeId" data-url="${basePath}/cms/dfBusinessType/getValidBusinessTypes" data-valuefield="id" data-textfield="businessName" data-name="eqs_dfBusinessTypeId"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
        <th>#springMessage('table.choBankFinance.billNo')</th>#*登记单号*#
        <th>#springMessage('df.securities.name')</th>#*证券名称*#
        <th>#springMessage('df.securities.code')</th>#*证券代码*#
        <th>#springMessage('df.business.type')</th>#*直融类别*#
        <th>#springMessage('df.issue.date')</th>#*发行日期*#
        <th>#springMessage('table.cmsProvideLoanSend.repayDate')</th>#*到期日期*#
        <th>#springMessage('df.issuing.period')</th>#*发行期限*#
        <th>#springMessage('table.accountDTO.balance')(#springMessage('config.choBank.moneyUnit'))</th>#*余额*#
        <th>#springMessage('df.bond.rating')</th>#*债券评级*#
        <th>#springMessage('df.main.rating')</th>#*主体评级*#
        <th>#springMessage('df.issue.amount')(#springMessage('config.choBank.moneyUnit'))</th>#*发行规模*#
        <th>#springMessage('common.table.status')</th>#*状态*#
        <th>#springMessage('common.table.thead.operation')</th>#*操作*#
    </tr>
    </thead>
</table>
#workFlowHtml()
#parse("views/common/footer.vm")
#workFlowScript()
<script>
    var form, dicts;
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts"], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        bt.selectType.init();//
        moneyFun = bt.moneyType.getFun();
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: "Brtlip",
            colReorder: true,
            ordering: false,
            checkbox: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            ajax: {
                "url": basePath + "/cms/dfDirectFinanceInfo/ApproveDataTable"
            }, columns: [
                {
                    data: "billCode",
                    className: "center"
                }, {
                    data: "stockName",
                    className: "center"
                }, {
                    data: "stockCode",
                    className: "center"
                }, {
                    data: "businessName",
                    className: "center"
                }, {
                    data: "startDate",
                    className: "center"
                }, {
                    data: "endDate",
                    className: "center"
                }, {
                    data: "peroid",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return data + bt.dict("choBankFinance.dateUnit", full.unit);
                    }
                }, {
                    data: "surplusMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "bondRating",
                    className: "center"
                }, {
                    data: "bondMainRating",
                    className: "center"
                }, {
                    data: "money",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "status",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("df.directfinance.approve.status", data);
                    }
                }, {
                    data: null,
                    className: 'center',
                    render: function (data, type, full, meta) {
                        var explode = "<span class=\"text-explode\">|</span>"
                        var id = full.id;
                        var taskId = full.taskId;
                        var html = "";
                        if ($("#flowStatus").val() == "todo") {
                            html += "<a class=\"\" href=\"#\" data-row=\"" + meta.row + "\" onclick=\"approve('" + id + "','" + taskId + "')\">" + bt.lang("common.button.approve") + "</a>" + explode;
                        }
                        if($("#flowStatus").val() == 'pass'){
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(\'' + id + '\')">' + bt.lang("common.button.view") + '</a><span class="text-explode">|</span>';
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }else {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }
                        return html;
                    }
                }
            ]
        });
        //这里填写新的js代码，请参考前端文档
    });

    function approve(id, taskId) {
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/dfDirectFinanceInfo/viewApprove?id=" + id + "&taskId=" + taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/dfDirectFinanceInfo/viewApprove?id=" + id + "&taskId=" + taskId,
            end: function () {
                datatable && datatable.draw();
            }
        });
    }

    function view(id) {
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/dfDirectFinanceInfo/view?id=" + id + "&flag=" + 1);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/dfDirectFinanceInfo/view?id=" + "&flag=" + 1,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }
</script>
</body>
</html>


<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<input type="hidden" id="surplusMoney" value="$!{dfDirectFinanceInfoVO.surplusMoney}">
<input type="hidden" id="allRepayMoney" value="$!{allRepayMoney}">
<input type="hidden" id="curId" value="$!{dfDirectFinanceInfoVO.curId}">
<form id="searchForm" class="layui-form">
    <input type="hidden" value="$!{dfDirectFinanceInfoVO.id}" name="directFinanceId">
    <input type="hidden" name="uploadId" id="gid">
    <table class="layui-table">
        <tr>
        ##            录入日期
            <td width="15%" class="textRight">#springMessage('table.cmsLoanSend.createDate')</td>
            <td width="35%">
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.createDate})
                </div>
            </td>
        ##            申请单位
            <td width="15%" class="textRight">#springMessage('table.abBillTransfer.applyCorp')</td>
            <td width="35%">
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.corpName}
                </div>
            </td>
        </tr>
        <tr>
        ##            证券名称
            <td class="textRight">#springMessage('df.securities.name')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.stockName}
                </div>
            </td>
        ##            证券代码
            <td class="textRight">#springMessage('df.securities.code')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.stockCode}
                </div>
            </td>
        </tr>
        <tr>
        ##            发行日期
            <td class="textRight">#springMessage('df.issue.date')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.startDate})
                </div>
            </td>
        ##            币种
            <td class="textRight">#springMessage('ttpay.currency')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.curName}
                </div>
            </td>
        </tr>
        <tr>
        ##            债券评级
            <td class="textRight">#springMessage('df.bond.rating')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.bondRating}
                </div>
            </td>
        ##            主体评级
            <td class="textRight">#springMessage('df.main.rating')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.bondMainRating}
                </div>
            </td>
        </tr>
        <tr>
        ##            发行期限
            <td class="textRight">#springMessage('df.issuing.period')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.peroid}
                    $dictTag.get("choBankFinance.dateUnit",$!{dfDirectFinanceInfoVO.unit})
                </div>
            </td>
        ##            发行规模
            <td class="textRight">#springMessage('df.issue.amount')（#springMessage('config.choBank.moneyUnit')）</td>
            <td>
                <div class="layui-inline">
                    $!number.formatNumeric($!{dfDirectFinanceInfoVO.money})
                </div>
            </td>
        </tr>
        <tr>
        ##            余额
            <td class="textRight">#springMessage('table.accountDTO.balance')</td>
            <td>
                <div class="layui-inline">
                    $!number.formatNumeric($!{dfDirectFinanceInfoVO.surplusMoney})
                </div>
            </td>
        ##            发行批文编号
            <td class="textRight">#springMessage('df.issue.approval.No')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.DocNo}
                </div>
            </td>
        </tr>
        <tr>
        ##            上市日期
            <td class="textRight">#springMessage('df.listing.date')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.listingDate})
                </div>
            </td>
        ##            到期日期
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.endDate})
                </div>
            </td>
        </tr>
        <tr>
        ##            是否包含回售条款
            <td class="textRight">#springMessage('df.resale.clause')</td>
            <td>
                <div class="layui-inline">
                    $dictTag.get("sf_yn",$!{dfDirectFinanceInfoVO.isResaleTerms})
                </div>
            </td>
        ##            回售日
            <td class="textRight">#springMessage('df.resale.day')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.reSaleDate})
                </div>
            </td>
        </tr>
        <tr>
        ##            是否包含赎回条款
            <td class="textRight">#springMessage('df.redemption.clause')</td>
            <td>
                <div class="layui-inline">
                    $dictTag.get("sf_yn",$!{dfDirectFinanceInfoVO.isRedemptionProvision})
                </div>
            </td>
        ##            赎回日
            <td class="textRight">#springMessage('df.redemption.day')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.RedemptionProvisionDate})
                </div>
            </td>
        </tr>
        <tr>
        ##            上市地点
            <td class="textRight">#springMessage('df.listing.place')</td>
            <td>
                <div class="layui-inline">
                    $dictTag.get("df.listingPlace",$!{dfDirectFinanceInfoVO.listingPlace})

                </div>
            </td>
        ##            预定用途
            <td class="textRight">#springMessage('df.purpose')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.purpose}
                </div>
            </td>
        </tr>
        <tr>
        ##            直融类别
            <td class="textRight">#springMessage('df.business.type')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.BusinessName}
                </div>
            </td>
        ##            发行主体类别
            <td class="textRight">#springMessage('df.issuing.subject.category')</td>
            <td>
                <div class="layui-inline">
                    $dictTag.get("df.releaseMainType",$!{dfDirectFinanceInfoVO.releaseMainType})
                </div>
            </td>
        </tr>
        <tr>
        ##            发行主体名称
            <td class="textRight">#springMessage('df.issuing.subject.name')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.releaseMainName}
                </div>
            </td>
        ##            联系承销商-机构
            <td class="textRight">#springMessage('df.contact.underwriter.org')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.underwriter}
                </div>
            </td>
        </tr>
        <tr>
        ##            主承销商
            <td class="textRight">#springMessage('df.lead.underwriter')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.leaderUnderwriter}
                </div>
            </td>
        ##            息票类型
            <td class="textRight">#springMessage('df.coupon.type')</td>
            <td>
                <div class="layui-inline">
                    $dictTag.get("df.couponType",$!{dfDirectFinanceInfoVO.couponType})
                </div>
            </td>
        </tr>
        <tr>
        ##            付息频率
            <td class="textRight">#springMessage('df.interest.rate.frequency')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.frequencyInterestPayments}
                </div>
            </td>
        ##            票面利率
            <td class="textRight">#springMessage('df.coupon.rate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{dfDirectFinanceInfoVO.faceInterestRate})
                        $!number.formatNumeric($math.mul($!{dfDirectFinanceInfoVO.faceInterestRate},100),"#0.0000")%
                    #end
                </div>
            </td>
        </tr>
        <tr>
        ##            浮动利率
            <td class="textRight">#springMessage('cms.loan.floatRate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{dfDirectFinanceInfoVO.floatInterestRat})
                        $!number.formatNumeric($math.mul($!{dfDirectFinanceInfoVO.floatInterestRat},100),"#0.0000")%
                    #end
                </div>
            </td>
        ##            利率值
            <td class="textRight">#springMessage('df.interestrrate.value')</td>
            <td>
                <div class="layui-inline">
                    #if($!{dfDirectFinanceInfoVO.interestRat})
                        $!number.formatNumeric($math.mul($!{dfDirectFinanceInfoVO.interestRat},100),"#0.0000")%
                    #end
                </div>
            </td>
        </tr>
        <tr>
        ##            综合成本年化利率
            <td class="textRight">#springMessage('df.comprehensive.cost.rate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{dfDirectFinanceInfoVO.compositeCostRate})
                        $!number.formatNumeric($math.mul($!{dfDirectFinanceInfoVO.compositeCostRate},100),"#0.0000")%
                    #end
                </div>
            </td>
        ##            综合成本
            <td class="textRight">#springMessage('international.credit.compCost')</td>
            <td>
                <div class="layui-inline">
                    $!number.formatNumeric($!{dfDirectFinanceInfoVO.compositeCost})
                </div>
            </td>
        </tr>
        <tr>
        ##            备注
            <td class="textRight">#springMessage('ttpay.rmk')</td>
            <td>
                <div class="layui-inline">
                    $!{dfDirectFinanceInfoVO.rmk}
                </div>
            </td>
            <td class="textRight"></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="4">
            ##                第三方机构
                <span style="font-weight: bold">#springMessage('df.third.party.organization')</span>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <table class="layui-table" id="thirdAgency">
                    <thead>
                    <tr>
                        <th>#springMessage('df.institutional.category')</th>#*机构类别*#
                        <th>#springMessage('table.btswiftinfo.bankName')</th>#*机构名称*#
                    </tr>
                    </thead>
                    #if($!{dfThirdPartyAgencyVOS})
                        #foreach($element in $!{dfThirdPartyAgencyVOS})
                            <tr>
                                <td>$!{element.agencyType}</td>
                                <td>$!{element.agencyName}</td>
                            </tr>
                        #end
                    #end
                </table>
            </td>
        </tr>
        <tr>
            <td colspan="4">
            ##                中间费用
                <span style="font-weight: bold">#springMessage('df.intermediate.cost')</span>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <table class="layui-table" id="intermediateCost">
                    <thead>
                    <tr>
                        <th>#springMessage('table.fcChargeRule.fcChargeType')</th>#*费用类型*#
                        <th>#springMessage('ttpay.rate')</th>#*费率*#
                        <th>#springMessage('table.cms.projected.expemditure')</th>#*预计费用*#
                    </tr>
                    </thead>
                    #if($!{dfIntermediateCostVOS})
                        #foreach($element in $!{dfIntermediateCostVOS})
                            <tr>
                                <td>$!{element.costName}</td>
                                <td>
                                    #if($!{element.rate})
                                        $!number.formatNumeric($math.mul($!{element.rate},100),"#0.0000")%
                                    #end
                                </td>
                                <td>$!number.formatNumeric($!{element.advanceFees})</td>
                            </tr>
                        #end
                    #end
                </table>
            </td>
        </tr>
        <tr>
            <td colspan="4">
            ##                还本付息计划
                <span style="font-weight: bold">#springMessage('df.debt.service.plan')</span>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <table class="layui-table" id="repayPlan">
                    <thead>
                    <tr>
                        <th style="width: 18%">#springMessage('df.repayment.time')</th>#*还款时间*#
                        <th style="width: 18%">#springMessage('table.createRepayPlan.repaymentMoney')</th>#*还款本金*#
                        <th style="width: 18%">#springMessage('table.fcLessPayBill.interest')</th>#*利息*#
                        <th style="width: 18%">#springMessage('table.cmsPrecativeLoanInfo.poundage')</th>#*手续费*#
                        <th style="width: 18%">#springMessage('table.datatable.total')</th>#*合计*#
                    </tr>
                    </thead>
                    #if($!{dfDirectFinanceRepayTmpVOS})
                        #foreach($element in $!{dfDirectFinanceRepayTmpVOS})
                            <tr>
                                <td>$!date.format('yyyy-MM-dd',$!{element.repayDate})</td>
                                <td>$!number.formatNumeric($!{element.repayMoney})</td>
                                <td>$!number.formatNumeric($!{element.interest})</td>
                                <td>$!number.formatNumeric($!{element.serviceCharge})</td>
                                #set($total = $!{element.repayMoney} + $!{element.interest} + $!{element.serviceCharge})
                                <td>$!number.formatNumeric($!{total})</td>
                            </tr>
                        #end
                    #end
                </table>
            </td>
        </tr>
    </table>

    <input type="hidden" id="corpId" name="corpId" value="$!{dfDirectFinanceInfoVO.corpId}">
    <input type="hidden" name="directFinanceId" value="$!{dfDirectFinanceInfoVO.id}">
    <table  class="layui-table">
        <tr>
            <td colspan="4" style="text-align: center">
##                还款信息
                <span style="font-weight: bold">#springMessage('cms.repayment.info')</span>
            </td>
        </tr>
        <tr>
##            实际还款日期
            <td class="textRight" style="width: 15%">#springMessage('df.real.repay.date')</td>
            <td style="width: 35%">
                <div class="layui-inline">
                    <input type="text" name="repayDate" data-callback="repayDateCallBack" lay-verify="required" data-biz-name="repayDate" data-today="true" class="layui-input bt-biz-dateType">
                </div>
            </td>
##            已还款本金
            <td class="textRight" style="width: 15%">#springMessage('df.repaid.money')</td>
            <td style="width: 35%">
                <span>$!number.formatNumeric($!{allRepayMoney})</span>
            </td>
        </tr>
        <tr>
##            实际还款本金
            <td class="textRight">#springMessage('table.createRepayPlan.realityRepayMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="repayMoney" data-biz-name="repayMoney" class="layui-input bt-biz-moneyType">
                </div>
            </td>
##            实际支付利息
            <td class="textRight">#springMessage('df.real.pay.interest')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="interest" data-biz-name="interest" class="layui-input bt-biz-moneyType">
                </div>
            </td>
        </tr>
        <tr>
##            实际支付手续费
            <td class="textRight">#springMessage('df.real.pay.service.charge')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="serviceCharge" data-biz-name="serviceCharge" class="layui-input bt-biz-moneyType">
                </div>
            </td>
##            备注
            <td class="textRight">#springMessage('ttpay.rmk')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="rmk"class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            <td>#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <!--预算-->
                <input id="isBudget" name="isBudget" type="hidden" value="$!{isBudget}">
                <input id="dfRepayItem" name="dfRepayItem" type="hidden" value="$!{dfRepayItem}">
                <input id="defItemCode" name="defItemCode" type="hidden" value="$!{defItemCode}">
                <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
                <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
                <div id="tagItemDetail"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4"style="text-align: center">
                <button class="layui-btn" type="button" lay-submit="submit" value="11" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" type="button" lay-submit="submit" value="0" lay-filter="submit">#springMessage('common.button.temp')</button>
                <button class="layui-btn" type="button" onclick="doClose()">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
<script src="${basePath}/static/modules/cms/df/dfDirectfinanceRepay.add.js?_btv=${resourceVersion}"></script>
</body>
</html>
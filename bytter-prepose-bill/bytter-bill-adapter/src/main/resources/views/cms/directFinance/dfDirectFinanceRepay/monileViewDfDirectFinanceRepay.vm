<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
    <style>
        table{
            border: 1px solid rgb(210, 210, 210);
        }
        th{
            border: 1px solid rgb(210, 210, 210);
        }
        td{
            border: 1px solid rgb(210, 210, 210)!important;
        }
    </style>
</head>
<body>
<ul class="mui-table-view" id="mulTable">

##                实际还款日期
    <li class="mui-table-view-cell">
        #springMessage('df.real.repay.date')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{dfDirectFinanceRepayVO.repayDate})
        </span>
    </li>

##                已还款本金
    <li class="mui-table-view-cell">
        #springMessage('df.repaid.money')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{allRepayMoney})
        </span>
    </li>

##                实际还款本金
    <li class="mui-table-view-cell">
        #springMessage('table.createRepayPlan.realityRepayMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{dfDirectFinanceRepayVO.repayMoney})
        </span>
    </li>

##                实际支付利息
    <li class="mui-table-view-cell">
        #springMessage('df.real.pay.interest')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{dfDirectFinanceRepayVO.interest})
        </span>
    </li>

##                实际支付手续费
    <li class="mui-table-view-cell">
        #springMessage('df.real.pay.service.charge')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{dfDirectFinanceRepayVO.serviceCharge})
        </span>
    </li>

##                备注
    <li class="mui-table-view-cell">
        #springMessage('ttpay.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{dfDirectFinanceRepayVO.rmk}
        </span>
    </li>


    <li class="mui-table-view-divider">#springMessage('df.business.registration.info')</li>


    <ul class="mui-table-view">
    ##                录入日期
        <li class="mui-table-view-cell">
            #springMessage('table.cmsLoanSend.createDate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.createDate})
            </span>
        </li>

    ##                申请单位
        <li class="mui-table-view-cell">
            #springMessage('table.abBillTransfer.applyCorp')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.corpName}
            </span>
        </li>

    ##                证券名称
        <li class="mui-table-view-cell">
            #springMessage('df.securities.name')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.stockName}
            </span>
        </li>

    ##                证券代码
        <li class="mui-table-view-cell">
            #springMessage('df.securities.code')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.stockCode}
            </span>
        </li>

    ##                发行日期
        <li class="mui-table-view-cell">
            #springMessage('df.issue.date')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.startDate})
            </span>
        </li>

    ##                币种
        <li class="mui-table-view-cell">
            #springMessage('ttpay.currency')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.curName}
            </span>
        </li>

    ##                债券评级
        <li class="mui-table-view-cell">
            #springMessage('df.bond.rating')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.bondRating}
            </span>
        </li>

    ##                主体评级
        <li class="mui-table-view-cell">
            #springMessage('df.main.rating')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.bondMainRating}
            </span>
        </li>

    ##                发行期限
        <li class="mui-table-view-cell">
            #springMessage('df.issuing.period')
            <span class="mui-badge mui-badge-inverted">
            $!{dfDirectFinanceInfoVO.peroid}
            $dictTag.get("choBankFinance.dateUnit",$!{dfDirectFinanceInfoVO.unit})
        </span>
        </li>

    ##                发行规模
        <li class="mui-table-view-cell">
            #springMessage('df.issue.amount')（#springMessage('config.choBank.moneyUnit')）
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{dfDirectFinanceInfoVO.money})
            </span>
        </li>

    ##                余额
        <li class="mui-table-view-cell">
            #springMessage('table.accountDTO.balance')（#springMessage('config.choBank.moneyUnit')）
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{dfDirectFinanceInfoVO.surplusMoney})
            </span>
        </li>

    ##                发行批文编号
        <li class="mui-table-view-cell">
            #springMessage('df.issue.approval.No')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.DocNo}
            </span>
        </li>

    ##                上市日期
        <li class="mui-table-view-cell">
            #springMessage('df.listing.date')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.listingDate})
            </span>
        </li>

    ##                到期日期
        <li class="mui-table-view-cell">
            #springMessage('table.cmsProvideLoanSend.repayDate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.endDate})
            </span>
        </li>

    ##                是否包含回售条款
        <li class="mui-table-view-cell">
            #springMessage('df.resale.clause')
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("sf_yn",$!{dfDirectFinanceInfoVO.isResaleTerms})
            </span>
        </li>

    ##                回售日
        <li class="mui-table-view-cell">
            #springMessage('df.resale.day')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.reSaleDate})
            </span>
        </li>

    ##                是否包含赎回条款
        <li class="mui-table-view-cell">
            #springMessage('df.redemption.clause')
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("sf_yn",$!{dfDirectFinanceInfoVO.isRedemptionProvision})
            </span>
        </li>

    ##                赎回日
        <li class="mui-table-view-cell">
            #springMessage('df.redemption.day')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.RedemptionProvisionDate})
            </span>
        </li>

    ##                上市地点
        <li class="mui-table-view-cell">
            #springMessage('df.listing.place')
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("df.listingPlace",$!{dfDirectFinanceInfoVO.listingPlace})
            </span>
        </li>

    ##                预定用途
        <li class="mui-table-view-cell">
            #springMessage('df.purpose')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.purpose}
            </span>
        </li>


    ##                直融类别
        <li class="mui-table-view-cell">
            #springMessage('df.business.type')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.BusinessName}
            </span>
        </li>


    ##                发行主体类别
        <li class="mui-table-view-cell">
            #springMessage('df.issuing.subject.category')
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("df.releaseMainType",$!{dfDirectFinanceInfoVO.releaseMainType})
            </span>
        </li>


    ##                发行主体名称
        <li class="mui-table-view-cell">
            #springMessage('df.issuing.subject.name')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.releaseMainName}
            </span>
        </li>


    ##                联系承销商-机构
        <li class="mui-table-view-cell">
            #springMessage('df.contact.underwriter.org')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.underwriter}
            </span>
        </li>


    ##                主承销商
        <li class="mui-table-view-cell">
            #springMessage('df.lead.underwriter')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.leaderUnderwriter}
            </span>
        </li>

    ##                息票类型
        <li class="mui-table-view-cell">
            #springMessage('df.coupon.type')
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("df.couponType",$!{dfDirectFinanceInfoVO.couponType})
            </span>
        </li>

    ##                付息频率
        <li class="mui-table-view-cell">
            #springMessage('df.interest.rate.frequency')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.frequencyInterestPayments}
            </span>
        </li>

    ##                票面利率
        <li class="mui-table-view-cell">
            #springMessage('df.coupon.rate')
            <span class="mui-badge mui-badge-inverted">
                #if($!{dfDirectFinanceInfoVO.faceInterestRate})
                    $!number.formatNumeric($math.mul($!{dfDirectFinanceInfoVO.faceInterestRate},100),"#0.0000")%
                #end
            </span>
        </li>

    ##                浮动利率
        <li class="mui-table-view-cell">
            #springMessage('cms.loan.floatRate')
            <span class="mui-badge mui-badge-inverted">
                #if($!{dfDirectFinanceInfoVO.floatInterestRat})
                    $!number.formatNumeric($math.mul($!{dfDirectFinanceInfoVO.floatInterestRat},100),"#0.0000")%
                #end
            </span>
        </li>

    ##                利率值
        <li class="mui-table-view-cell">
            #springMessage('df.interestrrate.value')
            <span class="mui-badge mui-badge-inverted">
                #if($!{dfDirectFinanceInfoVO.interestRat})
                    $!number.formatNumeric($math.mul($!{dfDirectFinanceInfoVO.interestRat},100),"#0.0000")%
                #end
            </span>
        </li>

    ##                综合成本年化利率
        <li class="mui-table-view-cell">
            #springMessage('df.comprehensive.cost.rate')
            <span class="mui-badge mui-badge-inverted">
                #if($!{dfDirectFinanceInfoVO.compositeCostRate})
                    $!number.formatNumeric($math.mul($!{dfDirectFinanceInfoVO.compositeCostRate},100),"#0.0000")%
                #end
            </span>
        </li>

    ##                综合成本
        <li class="mui-table-view-cell">
            #springMessage('international.credit.compCost')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{dfDirectFinanceInfoVO.compositeCost})
            </span>
        </li>

    ##                备注
        <li class="mui-table-view-cell">
            #springMessage('ttpay.rmk')
            <span class="mui-badge mui-badge-inverted">
                $!{dfDirectFinanceInfoVO.rmk}
            </span>
        </li>

        <ul class="mui-table-view">
            <li class="mui-table-view-cell mui-collapse">
                <a class="mui-navigate-right" href="#" style="font-weight: bold">#springMessage('df.third.party.organization')</a>
                <div class="mui-collapse-content">
                    <p>
                    <table class="layui-table" id="thirdAgency" style="width: 100%;text-align: center">
                        <thead>
                        <tr>
                            <th>#springMessage('df.institutional.category')</th>#*机构类别*#
                            <th>#springMessage('table.btswiftinfo.bankName')</th>#*机构名称*#
                        </tr>
                        </thead>
                        #if($!{dfThirdPartyAgencyVOS})
                            #foreach($element in $!{dfThirdPartyAgencyVOS})
                                <tr>
                                    <td>$!{element.agencyType}</td>
                                    <td>$!{element.agencyName}</td>
                                </tr>
                            #end
                        #end
                    </table>
                    </p>
                </div>
            </li>
        </ul>

        <ul class="mui-table-view">
            <li class="mui-table-view-cell mui-collapse">
                <a class="mui-navigate-right" href="#" style="font-weight: bold">#springMessage('df.intermediate.cost')</a>
                <div class="mui-collapse-content">
                    <p>
                    <table class="layui-table" id="intermediateCost" style="width: 100%;text-align: center">
                        <thead>
                        <tr>
                            <th>#springMessage('table.fcChargeRule.fcChargeType')</th>#*费用类型*#
                            <th>#springMessage('ttpay.rate')</th>#*费率*#
                            <th>#springMessage('table.cms.projected.expemditure')</th>#*预计费用*#
                        </tr>
                        </thead>
                        #if($!{dfIntermediateCostVOS})
                            #foreach($element in $!{dfIntermediateCostVOS})
                                <tr>
                                    <td>$!{element.costName}</td>
                                    <td>
                                        #if($!{element.rate})
                                            $!number.formatNumeric($math.mul($!{element.rate},100),"#0.0000")%
                                        #end
                                    </td>
                                    <td>$!number.formatNumeric($!{element.advanceFees})</td>
                                </tr>
                            #end
                        #end
                    </table>
                    </p>
                </div>
            </li>
        </ul>

        <ul class="mui-table-view">
            <li class="mui-table-view-cell mui-collapse">
                <a class="mui-navigate-right" href="#" style="font-weight: bold">#springMessage('df.debt.service.plan')</a>
                <div class="mui-collapse-content">
                    <p>
                    <table class="layui-table" id="repayPlan" style="width: 100%;text-align: center">
                        <thead>
                        <tr>
                            <th style="width: 18%">#springMessage('df.repayment.time')</th>#*还款时间*#
                            <th style="width: 18%">#springMessage('table.createRepayPlan.repaymentMoney')</th>#*还款本金*#
                            <th style="width: 18%">#springMessage('table.fcLessPayBill.interest')</th>#*利息*#
                            <th style="width: 18%">#springMessage('table.cmsPrecativeLoanInfo.poundage')</th>#*手续费*#
                            <th style="width: 18%">#springMessage('table.datatable.total')</th>#*合计*#
                        </tr>
                        </thead>
                        #if($!{dfDirectFinanceRepayTmpVOS})
                            #foreach($element in $!{dfDirectFinanceRepayTmpVOS})
                                <tr>
                                    <td>$!date.format('yyyy-MM-dd',$!{element.repayDate})</td>
                                    <td>$!number.formatNumeric($!{element.repayMoney})</td>
                                    <td>$!number.formatNumeric($!{element.interest})</td>
                                    <td>$!number.formatNumeric($!{element.serviceCharge})</td>
                                    #set($total = $!{element.repayMoney} + $!{element.interest} + $!{element.serviceCharge})
                                    <td>$!number.formatNumeric($!{total})</td>
                                </tr>
                            #end
                        #end
                    </table>
                    </p>
                </div>
            </li>
        </ul>
    </ul>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>
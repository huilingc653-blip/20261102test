<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        /
        /
        这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="myform">

    <table id="appTable" class="layui-table layui-form">
        <tr>
        ##费用编码
            <td class="textRight" style="width: 50%">#springMessage('df.businessCode')</td>
            <td style="width: 50%">
                <div class="layui-input-inline">
                    $!{dfBusinessTypeVO.businessCode}
                </div>
            </td>
        </tr>
        <tr>
        ##费用名称
            <td class="textRight">#springMessage('df.businessName')</td>
            <td>
                <div class="layui-input-inline">
                    $!{dfBusinessTypeVO.businessName}
                </div>
            </td>
        </tr>
        <tr>
        ##是否有效
            <td class="textRight">#springMessage('table.erpDataType.validSign')</td>
            <td>
                <div class="layui-input-inline">
                    $dictTag.get("sf_yn",$!{dfBusinessTypeVO.isValid})
                </div>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

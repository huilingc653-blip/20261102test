<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<form id="searchForm" class="layui-form">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
    <table class="layui-table">
        <tr>
        ##            业务单号
            <td width="10%" class="textRight">#springMessage('table.choBankFinance.billNo')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_billCode" class="layui-input" >
                </div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
#*            <td width="10%" class="textRight">#springMessage('证券名称')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_stockName" class="layui-input" >
                </div>
            </td>
            <td width="10%" class="textRight">#springMessage('直融类别')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-required="true" data-biz-name="dfBusinessTypeId" data-url="${basePath}/cms/dfBusinessType/getValidBusinessTypes" data-valuefield="id" data-textfield="businessCode" data-name="eqs_dfBusinessTypeId"></div>
                </div>
            </td>*#
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
        <th>#springMessage('table.choBankFinance.billNo')</th>#*流水号*#
        <th>#springMessage('table.cmsLoanDeferred.matureDate')</th>#*还款日期*#
        <th>#springMessage('table.createRepayPlan.repaymentMoney')</th>#*还款本金*#
        <th>#springMessage('table.fcLessPayBill.interest')</th>#*利息*#
        <th>#springMessage('table.cmsPrecativeLoanInfo.poundage')</th>#*手续费*#
        <th>#springMessage('ttpay.rmk')</th>#*备注*#
        <th>#springMessage('common.table.status')</th>#*状态*#
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
<script>
    var form, moneyFun, dicts;
    bt.use(["jquery", "datatable", "form", "moneyType", "corp", "selectType", "dicts"], function () {
        $ = bt.jquery;
        dicts = bt.dicts.init();
        form = bt.form()
        bt.selectType.init();
        corp = bt.corp.init();//单位
        moneyFun = bt.moneyType.getFun();
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: "Brtlip",
            colReorder: true,
            ordering: false,
            checkbox: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            ajax: {
                "url": basePath + "/cms/dfDirectFinanceRepay/ApproveDataTable"
            }, columns: [
                {
                    data: "billCode",
                    className: "center"
                }, {
                    data: "repayDate",
                    className: "center"
                }, {
                    data: "repayMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "interest",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "serviceCharge",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "rmk",
                    className: "center"
                }, {
                    data: "status",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("df.directfinance.approve.status", data);
                    }
                }, {
                    data: null,
                    className: 'center',
                    render: function (data, type, full, meta) {
                        var explode = "<span class=\"text-explode\">|</span>"
                        var id = full.id;
                        var taskId = full.taskId;
                        var html = "";
                        if ($("#flowStatus").val() == "todo") {
                            html += "<a class=\"\" href=\"#\" data-row=\"" + meta.row + "\" onclick=\"approve('" + id + "','" + taskId + "')\">" + bt.lang("common.button.approve") + "</a>" + explode;
                        }
                        if($("#flowStatus").val() == 'pass'){
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(\'' + id + '\')">' + bt.lang("common.button.view") + '</a><span class="text-explode">|</span>';
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }else {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }
                        return html;
                    }
                }
            ]
        });
        //这里填写新的js代码，请参考前端文档
    });

    function approve(id, taskId) {
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/dfDirectFinanceRepay/viewApprove?id=" + id + "&taskId=" + taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/dfDirectFinanceRepay/viewApprove?id=" + id + "&taskId=" + taskId,
            end: function () {
                datatable && datatable.draw();
            }
        });
    }

    /**
     * 查看
     * @param id
     */
    function view(id) {
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/dfDirectFinanceInfo/view?id=" + id + "&flag=" + 1);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/dfDirectFinanceInfo/view?id=" + "&flag=" + 1,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }
</script>
</body>
</html>

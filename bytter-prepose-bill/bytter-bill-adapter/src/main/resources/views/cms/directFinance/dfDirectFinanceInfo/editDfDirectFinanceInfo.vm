
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<input type="hidden" id="corpId" value="$!{dfDirectFinanceInfoVO.corpId}">
<form id="searchForm" class="layui-form">
    <input type="hidden" value="$!{dfDirectFinanceInfoVO.id}" name="id" id="id">
    <input type="hidden" value="$!{dfDirectFinanceInfoVO.billCode}" name="billCode">
    <input type="hidden" id="gid" name="uploadId" value="$!{dfDirectFinanceInfoVO.uploadId}">
    <table class="layui-table">
        <tr>
        ##            录入日期
            <td width="15%" class="textRight">#springMessage('table.cmsLoanSend.createDate')</td>
            <td width="35%">
                <div class="layui-inline">
                    <input type="text" name="createDate" data-biz-name="createDate" class="layui-input bt-biz-dateType" readonly="readonly" value="$!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.createDate})">
                </div>
            </td>
##            单位
            <td width="15%" class="textRight">#springMessage('table.abBillTransfer.applyCorp')</td>
            <td width="35%">
                <div class="layui-inline">
##                    <div class="bt-biz-corp" data-biz-name="corpId" data-name="corpId" data-biz-type="corp" data-type="selectTree" data-resource="df:direct:finance:info:edit" data-required="true" data-callback="corpOtherSet" data-defaultvalue="$!{dfDirectFinanceInfoVO.corpId}"></div>
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-biz-name="corpId"
                         data-scope="all"
                         data-resource="df:direct:finance:info:edit"
                         data-required="true"
                         data-callback="bt.corpOtherSet"
                         data-defaultvalue="$!{dfDirectFinanceInfoVO.corpId}"
                    ></div>
                </div>
            </td>
        </tr>
        <tr>
##            证券名
            <td class="textRight">#springMessage('df.securities.name')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="stockName" class="layui-input" lay-verify="required" value="$!{dfDirectFinanceInfoVO.stockName}">
                </div>
            </td>
##    证券代码
            <td class="textRight">#springMessage('df.securities.code')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="stockCode" class="layui-input" lay-verify="required" value="$!{dfDirectFinanceInfoVO.stockCode}">
                </div>
            </td>
        </tr>
        <tr>
##            发行日期
            <td class="textRight">#springMessage('df.issue.date')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="startDate" data-biz-name="startDate" class="layui-input bt-biz-dateType" lay-verify="required" value="$!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.startDate})">
                </div>
            </td>
##    币种
            <td class="textRight">#springMessage('ttpay.currency')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="curId" data-biz-name="curId" data-inputValue="false" data-required="true"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-value="$!{dfDirectFinanceInfoVO.curId}" data-displayData="4028802e5c346968015c346c18850008"
                         data-textfield="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
##            债券评级
            <td class="textRight">#springMessage('df.bond.rating')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="bondRating" class="layui-input" lay-verify="required" value="$!{dfDirectFinanceInfoVO.bondRating}">
                </div>
            </td>
##    主体评级
            <td class="textRight">#springMessage('df.main.rating')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="bondMainRating" class="layui-input" lay-verify="required" value="$!{dfDirectFinanceInfoVO.bondMainRating}">
                </div>
            </td>
        </tr>
        <tr>
##            发行期限
            <td class="textRight">#springMessage('df.issuing.period')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="peroid" class="layui-input" lay-verify="number|required" style="width: 42%;display: inline-block" value="$!{dfDirectFinanceInfoVO.peroid}">
                    <div class="bt-biz-dict" data-type="select" data-group="choBankFinance.dateUnit" data-filterData="D" data-value="$!{dfDirectFinanceInfoVO.unit}" data-name="unit" data-biz-name="unit" data-width="100px"></div>
                </div>
            </td>
##    发行规模
            <td class="textRight">#springMessage('df.issue.amount')（#springMessage('config.choBank.moneyUnit')）</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="money" data-biz-name="money" class="layui-input bt-biz-moneyType" value="$!{dfDirectFinanceInfoVO.money}" lay-verify="required">
                </div>
            </td>
        </tr>
        <tr>
##            余额
            <td class="textRight">#springMessage('table.accountDTO.balance')（#springMessage('config.choBank.moneyUnit')）</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="surplusMoney" data-biz-name="surplusMoney" data-callback="reCal" class="layui-input bt-biz-moneyType" value="$!{dfDirectFinanceInfoVO.surplusMoney}" lay-verify="required">
                </div>
            </td>
##    发行批文编号
            <td class="textRight">#springMessage('df.issue.approval.No')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="DocNo" class="layui-input" value="$!{dfDirectFinanceInfoVO.DocNo}">
                </div>
            </td>
        </tr>
        <tr>
##            上市日期
            <td class="textRight">#springMessage('df.listing.date')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="listingDate" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.listingDate})">
                </div>
            </td>
##    到期日期
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="endDate" data-biz-name="endDate" class="layui-input bt-biz-dateType" lay-verify="required" value="$!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.endDate})">
                </div>
            </td>
        </tr>
        <tr>
##            是否包含回售条款
            <td class="textRight">#springMessage('df.resale.clause')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-value="$!{dfDirectFinanceInfoVO.isResaleTerms}" data-name="isResaleTerms" data-biz-name="isResaleTerms"></div>
                </div>
            </td>
##    回售日
            <td class="textRight">#springMessage('df.resale.day')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="reSaleDate" data-biz-name="reSaleDate" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.reSaleDate})">
                </div>
            </td>
        </tr>
        <tr>
##            是否包含赎回条款
            <td class="textRight">#springMessage('df.redemption.clause')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-value="$!{dfDirectFinanceInfoVO.isRedemptionProvision}" data-name="isRedemptionProvision" data-biz-name="isRedemptionProvision" ></div>
                </div>
            </td>
##    赎回日
            <td class="textRight">#springMessage('df.redemption.day')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="RedemptionProvisionDate" data-biz-name="RedemptionProvisionDate" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!{dfDirectFinanceInfoVO.RedemptionProvisionDate})">
                </div>
            </td>
        </tr>
        <tr>
##            上市地点
            <td class="textRight">#springMessage('df.listing.place')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="df.listingPlace" data-name="listingPlace" data-biz-name="listingPlace" data-required="true" data-value="$!{dfDirectFinanceInfoVO.listingPlace}"></div>
                </div>
            </td>
##    预定用途
            <td class="textRight">#springMessage('df.purpose')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="purpose" class="layui-input" value="$!{dfDirectFinanceInfoVO.purpose}">
                </div>
            </td>
        </tr>
        <tr>
##            直融类别
            <td class="textRight">#springMessage('df.business.type')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-required="true" data-biz-name="dfBusinessTypeId" data-url="${basePath}/cms/dfBusinessType/getValidBusinessTypes"
                         data-valuefield="id" data-textfield="businessName" data-name="dfBusinessTypeId" data-value="$!{dfDirectFinanceInfoVO.dfBusinessTypeId}"></div>
                </div>
            </td>
##    发行主体类别
            <td class="textRight">#springMessage('df.issuing.subject.category')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="df.releaseMainType" data-name="releaseMainType" data-biz-name="releaseMainType" data-required="true" data-value="$!{dfDirectFinanceInfoVO.releaseMainType}"></div>
                </div>
            </td>
        </tr>
        <tr>
##            发行主体名称
            <td class="textRight">#springMessage('df.issuing.subject.name')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="releaseMainName" class="layui-input" lay-verify="required" value="$!{dfDirectFinanceInfoVO.releaseMainName}">
                </div>
            </td>
##    联系承销商-机构
            <td class="textRight">#springMessage('df.contact.underwriter.org')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="underwriter" class="layui-input" value="$!{dfDirectFinanceInfoVO.underwriter}">
                </div>
            </td>
        </tr>
        <tr>
##            主承销商
            <td class="textRight">#springMessage('df.lead.underwriter')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="leaderUnderwriter" class="layui-input" lay-verify="required" value="$!{dfDirectFinanceInfoVO.leaderUnderwriter}">
                </div>
            </td>
##    息票类型
            <td class="textRight">#springMessage('df.coupon.type')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="df.couponType" data-name="couponType" data-biz-name="couponType" data-required="true" data-value="$!{dfDirectFinanceInfoVO.couponType}"></div>
                </div>
            </td>
        </tr>
        <tr>
##            付息频率
            <td class="textRight">#springMessage('df.interest.rate.frequency')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="frequencyInterestPayments" class="layui-input" lay-verify="required" value="$!{dfDirectFinanceInfoVO.frequencyInterestPayments}">
                </div>
            </td>
##    票面利率
            <td class="textRight">#springMessage('df.coupon.rate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="faceInterestRate" class="layui-input bt-biz-rateType" lay-verify="required" value="$!{dfDirectFinanceInfoVO.faceInterestRate}">
                </div>
            </td>
        </tr>
        <tr>
##            浮动利率
            <td class="textRight">#springMessage('cms.loan.floatRate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="floatInterestRat" class="layui-input bt-biz-rateType" value="$!{dfDirectFinanceInfoVO.floatInterestRat}">
                </div>
            </td>
##    利率值
            <td class="textRight">#springMessage('df.interestrrate.value')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="interestRat" class="layui-input bt-biz-rateType" lay-verify="required" value="$!{dfDirectFinanceInfoVO.interestRat}">
                </div>
            </td>
        </tr>
        <tr>
##            综合成本年化利率
            <td class="textRight">#springMessage('df.comprehensive.cost.rate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="compositeCostRate" class="layui-input bt-biz-rateType" value="$!{dfDirectFinanceInfoVO.compositeCostRate}">
                </div>
            </td>
##    综合成本
            <td class="textRight">#springMessage('international.credit.compCost')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="compositeCost" data-biz-name="compositeCost" class="layui-input bt-biz-moneyType" value="$!{dfDirectFinanceInfoVO.compositeCost}">
                </div>
            </td>
        </tr>
        <tr>
##            备注
            <td class="textRight">#springMessage('ttpay.rmk')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="rmk" class="layui-input" value="$!{dfDirectFinanceInfoVO.rmk}">
                </div>
            </td>
            <td class="textRight"></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="4">
##                第三方机构
                <span style="font-weight: bold">#springMessage('df.third.party.organization')</span>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <table class="layui-table" id="thirdAgency">
                    <thead>
                    <tr>
                        <th>#springMessage('df.institutional.category')</th>#*机构类别*#
                        <th>#springMessage('table.btswiftinfo.bankName')</th>#*机构名称*#
                        <th>#springMessage('common.table.thead.operation')</th>
                    </tr>
                    </thead>
                    #if($!{dfThirdPartyAgencyVOS})
                        #foreach($element in $!{dfThirdPartyAgencyVOS})
                            #set($countIndex = $velocityCount - 1)
                            <tr>
                                <td><input type="text" name="dfThirdPartyAgencyVOS[$!{countIndex}].agencyType" class="layui-input" value="$!{element.agencyType}"></td>
                                <td><input type="text" name="dfThirdPartyAgencyVOS[$!{countIndex}].agencyName" class="layui-input" value="$!{element.agencyName}"></td>
                                #if($!{countIndex} == 0)
                                    <td class="inCenter"><span class="addRow" onclick="addRows(1)">#springMessage('common.button.add')</span></td>
                                #else
                                    <td class="inCenter"><span class="addRow" onclick="deleteRows(this)">#springMessage('common.button.delete')</span></td>
                                #end
                            </tr>
                        #end
                    #else
                        <tr>
                            <td><input type="text" name="dfThirdPartyAgencyVOS[0].agencyType" class="layui-input"></td>
                            <td><input type="text" name="dfThirdPartyAgencyVOS[0].agencyName" class="layui-input"></td>
                            <td class="inCenter"><span class="addRow" onclick="addRows(1)">#springMessage('common.button.add')</span></td>
                        </tr>
                    #end
                </table>
            </td>
        </tr>
        <tr>
            <td colspan="4">
##                中间费用
                <span style="font-weight: bold">#springMessage('df.intermediate.cost')</span>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <table class="layui-table" id="intermediateCost">
                    <thead>
                    <tr>
                        <th>#springMessage('table.fcChargeRule.fcChargeType')</th>#*费用类型*#
                        <th>#springMessage('ttpay.rate')</th>#*费率*#
                        <th>#springMessage('table.cms.projected.expemditure')</th>#*预计费用*#
                        <th>#springMessage('common.table.thead.operation')</th>
                    </tr>
                    </thead>
                    #if($!{dfIntermediateCostVOS})
                        #foreach($element in $!{dfIntermediateCostVOS})
                            #set($countIndex = $velocityCount - 1)
                            <tr rows = "$!{countIndex}">
                                <td><div class="bt-biz-selectType" data-biz-name="costTypeId$!{countIndex}" data-url="${basePath}/cms/dfCostType/getValidDfCostType" data-value="$!{element.costTypeId}"
                                         data-valuefield="id" data-textfield="costName" data-name="dfIntermediateCostVOS[$!{countIndex}].costTypeId"></div>
                                </td>
                                <td><input type="text" data-name="dfIntermediateCostVOS[$!{countIndex}].rate" data-id="rate$!{countIndex}" data-biz-name="rate$!{countIndex}" data-callback="calAdvanceFees" class="layui-input bt-biz-rateType" value="$!{element.rate}"></td>
                                <td><input type="text" data-name="dfIntermediateCostVOS[$!{countIndex}].advanceFees" data-id="advanceFees$!{countIndex}" data-biz-name="advanceFees$!{countIndex}" class="layui-input bt-biz-moneyType" readonly="readonly"  value="$!{element.advanceFees}"></td>
                                #if($!{countIndex} == 0)
                                    <td class="inCenter"><span class="addRow" onclick="addRows(2)">#springMessage('common.button.add')</span></td>
                                #else
                                    <td class="inCenter"><span class="addRow" onclick="deleteRows(this)">#springMessage('common.button.delete')</span></td>
                                #end
                            </tr>
                        #end
                    #else
                        <tr rows = "0">
                            <td><div class="bt-biz-selectType" data-biz-name="costTypeId0" data-url="${basePath}/cms/dfCostType/getValidDfCostType"
                                     data-valuefield="id" data-textfield="costName" data-name="costTypeId"></div>
                            </td>
                            <td><input type="text" data-name="dfIntermediateCostVOS[0].rate" data-id="rate0" data-biz-name="rate0" data-callback="calAdvanceFees" class="layui-input bt-biz-rateType"></td>
                            <td><input type="text" data-name="dfIntermediateCostVOS[0].advanceFees" data-id="advanceFees0" data-biz-name="advanceFees0" readonly="readonly"  class="layui-input bt-biz-moneyType"></td>
                            <td class="inCenter"><span class="addRow" onclick="addRows(2)">#springMessage('common.button.add')</span></td>
                        </tr>
                    #end
                </table>
            </td>
        </tr>
        <tr>
            <td colspan="4">
##                还本付息计划
                <span style="font-weight: bold">#springMessage('df.debt.service.plan')</span>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <table class="layui-table" id="repayPlan">
                    <thead>
                    <tr>
                        <th style="width: 18%">#springMessage('df.repayment.time')</th>#*还款时间*#
                        <th style="width: 18%">#springMessage('table.createRepayPlan.repaymentMoney')</th>#*还款本金*#
                        <th style="width: 18%">#springMessage('table.fcLessPayBill.interest')</th>#*利息*#
                        <th style="width: 18%">#springMessage('table.cmsPrecativeLoanInfo.poundage')</th>#*手续费*#
                        <th style="width: 18%">#springMessage('table.datatable.total')</th>#*合计*#
                        <th style="width: 10%">#springMessage('common.table.thead.operation')</th>
                    </tr>
                    </thead>
                    #if($!{dfDirectFinanceRepayTmpVOS})
                        #foreach($element in $!{dfDirectFinanceRepayTmpVOS})
                            #set($countIndex = $velocityCount - 1)
                            <tr rows = "$!{countIndex}">
                                <td><input type="text" rows = "$!{countIndex}" name="dfDirectFinanceRepayTmpVOS[$!{countIndex}].repayDate" data-callback="validRepay" data-id="repayDate$!{countIndex}" data-biz-name="repayDate$!{countIndex}" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!{element.repayDate})"></td>
                                <td><input type="text" rows = "$!{countIndex}" data-name="dfDirectFinanceRepayTmpVOS[$!{countIndex}].repayMoney" data-callback="calMoney" data-id="repayMoney$!{countIndex}" data-biz-name="repayMoney$!{countIndex}" class="layui-input bt-biz-moneyType" value="$!{element.repayMoney}"></td>
                                <td><input type="text" rows = "$!{countIndex}" data-name="dfDirectFinanceRepayTmpVOS[$!{countIndex}].interest" data-callback="calMoney" data-id="interest$!{countIndex}" data-biz-name="interest$!{countIndex}" class="layui-input bt-biz-moneyType" value="$!{element.interest}"></td>
                                <td><input type="text" rows = "$!{countIndex}" data-name="dfDirectFinanceRepayTmpVOS[$!{countIndex}].serviceCharge" data-callback="calMoney" data-id="serviceCharge$!{countIndex}" data-biz-name="serviceCharge$!{countIndex}" class="layui-input bt-biz-moneyType" value="$!{element.serviceCharge}"></td>
                                #set($total = $!{element.repayMoney} + $!{element.interest} + $!{element.serviceCharge})
                                <td id="total$!{countIndex}">$!number.formatNumeric($!{total})</td>
                                #if($!{countIndex} == 0)
                                    <td class="inCenter"><span class="addRow" onclick="addRows(3)">#springMessage('common.button.add')</span></td>
                                #else
                                    <td class="inCenter"><span class="addRow" onclick="deleteRows(this)">#springMessage('common.button.delete')</span></td>
                                #end
                            </tr>
                        #end
                    #else
                        <tr rows = "0">
                            <td><input type="text" rows = "0" data-name="dfDirectFinanceRepayTmpVOS[0].repayDate" data-callback="validRepay" data-id="repayDate0" data-biz-name="repayDate0" class="layui-input bt-biz-dateType"></td>
                            <td><input type="text" rows = "0" data-name="dfDirectFinanceRepayTmpVOS[0].repayMoney" data-callback="calMoney" data-id="repayMoney0" data-biz-name="repayMoney0" class="layui-input bt-biz-moneyType"></td>
                            <td><input type="text" rows = "0" data-name="dfDirectFinanceRepayTmpVOS[0].interest" data-callback="calMoney" data-id="interest0" data-biz-name="interest0" class="layui-input bt-biz-moneyType"></td>
                            <td><input type="text" rows = "0" data-name="dfDirectFinanceRepayTmpVOS[0].serviceCharge" data-callback="calMoney" data-id="serviceCharge0" data-biz-name="serviceCharge0" class="layui-input bt-biz-moneyType"></td>
                            <td id="total0"></td>
                            <td class="inCenter"><span class="addRow" onclick="addRows(3)">#springMessage('common.button.add')</span></td>
                        </tr>
                    #end
                </table>
            </td>
        </tr>
        <tr>
            <td>#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <!--预算-->
                <input id="isBudget" name="isBudget" type="hidden" value="$!{isBudget}">
                <input id="dfInfoItem" name="dfInfoItem" type="hidden" value="$!{dfInfoItem}">
                <input id="defItemCode" name="defItemCode" type="hidden" value="$!{defItemCode}">
                <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
                <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">

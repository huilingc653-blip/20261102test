    #parse("views/common/footer.vm")
<script>
    var form, moneyFun, dicts;
    bt.use(["jquery", "datatable", "form", "moneyType", "corp", "selectType", "dicts"], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        bt.selectType.init();
        corp = bt.corp.init();//单位
        moneyFun = bt.moneyType.getFun();
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: "Brtlip",
            colReorder: true,
            ordering: false,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            ajax: {
                "url": basePath + "/cms/dfDirectFinanceRepay/TempOrBackDataTable"
            }, columns: [
                {
                    data: "billCode",
                    className: "center"
                }, {
                    data: "repayDate",
                    className: "center"
                }, {
                    data: "repayMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "interest",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "serviceCharge",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "rmk",
                    className: "center"
                }, {
                    data: "status",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("df.directfinance.approve.status", data);
                    }
                }, {
                    data: null,
                    className: 'center',
                    render: function (data, type, full, meta) {
                        var html = "";
                        var split = "<span class=\"text-explode\">|</span>"
                        html += "<a href=\"#\" onclick=\"edit('" + full.id + "')\">" + bt.lang("common.button.edit") + "</a>";
                        html += split + "<a href=\"#\" onclick=\"deleteById('" + full.id + "')\">" + bt.lang("common.button.delete") + "</a>";
                        return html;
                    }
                }
            ]
        });
        //这里填写新的js代码，请参考前端文档
    });

    function deleteById(id) {
        parent.layer.confirm(bt.lang("table.sysTask.deletedsw")+"?",function () {
            bt.loading.show();
            var url = "/cms/dfDirectFinanceRepay/deleteById?id=" + id;
            $.post(basePath + url,function(data){
                bt.loading.hide();
                parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                datatable.draw();
            },'JSON');
        });
    }


    /**
     * 编辑
     * @param id
     */
    function edit(id) {
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.button.edit'), basePath + "/cms/dfDirectFinanceRepay/edit?id=" + id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/dfDirectFinanceRepay/edit?id=" + id,
            end: function () {
                datatable && datatable.draw();
            }
        });
    }
</script>
</body>
</html>

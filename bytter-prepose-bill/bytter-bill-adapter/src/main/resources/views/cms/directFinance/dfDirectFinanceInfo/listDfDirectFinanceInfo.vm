<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
        ##            证券代码
            <td width="10%" class="textRight">#springMessage('df.securities.code')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_stockCode" class="layui-input" >
                </div>
            </td>
        ##            证券名称
            <td width="10%" class="textRight">#springMessage('df.securities.name')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_stockName" class="layui-input" >
                </div>
            </td>
        ##            直融类别
            <td width="10%" class="textRight">#springMessage('df.business.type')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-biz-name="dfBusinessTypeId" data-url="${basePath}/cms/dfBusinessType/getValidBusinessTypes" data-valuefield="id" data-textfield="businessName" data-name="eqs_dfBusinessTypeId"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
        <th>#springMessage('table.choBankFinance.billNo')</th>#*登记单号*#
        <th>#springMessage('df.securities.name')</th>#*证券名称*#
        <th>#springMessage('df.securities.code')</th>#*证券代码*#
        <th>#springMessage('df.business.type')</th>#*直融类别*#
        <th>#springMessage('df.issue.date')</th>#*发行日期*#
        <th>#springMessage('table.cmsProvideLoanSend.repayDate')</th>#*到期日期*#
        <th>#springMessage('df.issuing.period')</th>#*发行期限*#
        <th>#springMessage('table.accountDTO.balance')(#springMessage('config.choBank.moneyUnit'))</th>#*余额*#
        <th>#springMessage('df.bond.rating')</th>#*债券评级*#
        <th>#springMessage('df.main.rating')</th>#*主体评级*#
        <th>#springMessage('df.issue.amount')(#springMessage('config.choBank.moneyUnit'))</th>#*发行规模*#
        <th>#springMessage('common.table.status')</th>#*状态*#
        <th>#springMessage('common.table.thead.operation')</th>#*操作*#
    </tr>
    </thead>
</table>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<script>
    var form, moneyFun, dicts;
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts"], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        bt.selectType.init();
        bt.moneyType.init();
        moneyFun = bt.moneyType.getFun();
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: "Brtlip",
            colReorder: true,
            ordering: false,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                "url": basePath + "/cms/dfDirectFinanceInfo/dataTable"
            },
            buttons: [
                {
                    hide: bt.isnotResource('df:direct:finance:info:add'),
                    text: bt.lang('common.button.add'),
                    action: function (e, dt, node, config) {
                        add();
                    }
                },
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ]
            , columns: [
                {
                    data: "billCode",
                    className: "center"
                }, {
                    data: "stockName",
                    className: "center"
                }, {
                    data: "stockCode",
                    className: "center"
                }, {
                    data: "businessName",
                    className: "center"
                }, {
                    data: "startDate",
                    className: "center"
                }, {
                    data: "endDate",
                    className: "center"
                }, {
                    data: "peroid",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return data + bt.dict("choBankFinance.dateUnit", full.unit);
                    }
                }, {
                    data: "surplusMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "bondRating",
                    className: "center"
                }, {
                    data: "bondMainRating",
                    className: "center"
                }, {
                    data: "money",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "status",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("df.directfinance.approve.status", data);
                    }
                }, {
                    data: null,
                    className: 'center',
                    render: function (data, type, full, meta) {
                        var html = "";
                        var split = "<span class=\"text-explode\">|</span>"
                        html += "<a href=\"#\" onclick=\"edit('" + full.id + "')\">" + bt.lang("common.button.edit") + "</a>";
                        html += split;
                        html += "<a href=\"#\" onclick=\"deleteById('" + full.id + "')\">" + bt.lang("common.button.delete") + "</a>";
                        html += split;
                        html += "<a href=\"#\" onclick=\"view('" + full.id + "')\">" + bt.lang("common.button.view") + "</a>";
                        return html;
                    }
                }
            ]
        });
        //这里填写新的js代码，请参考前端文档
    });


    function add() {
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.add.data'),basePath + "/cms/dfDirectFinanceInfo/add");
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/dfDirectFinanceInfo/add",
            end:function(){
                datatable && datatable.draw();
            }
        });
    }

    function edit(id) {
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.edit'), basePath + "/cms/dfDirectFinanceInfo/edit?id=" + id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/dfDirectFinanceInfo/edit?id=" + id,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }

    function deleteById(id) {
        parent.layer.confirm(bt.lang("table.sysTask.deletedsw")+"?",function () {
            bt.loading.show();
            var url = "/cms/dfDirectFinanceInfo/delete?id=" + id;
            $.post(basePath + url,function(data){
                bt.loading.hide();
                parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                datatable.draw();
            },'JSON');
        });
    }

    function view(id) {
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/dfDirectFinanceInfo/view?id=" + id + "&flag=" + 1);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/dfDirectFinanceInfo/view?id=" + "&flag=" + 1,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }
</script>
</body>
</html>

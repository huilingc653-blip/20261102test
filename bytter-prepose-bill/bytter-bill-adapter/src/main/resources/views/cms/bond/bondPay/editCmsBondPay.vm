<!DOCTYPE html>
<html lang="en" style="height: 100%">
<head>
    #parse("views/common/head.vm")
</head>
<style type="text/css">
    .voucher-title {
        font-weight: bold;
        font-size: 12px;
        text-align: center;
        border-left: 0px;
        border-right: 0px;
        background-color: #d2d2d2;
    }
</style>
<body style="height: 100%">
<div>
    <table class="layui-table  breakRow">
        <thead>
        <tr>
            ##债券主信息
            <td colspan="10" align="center">#springMessage('cms.cmsBond.registerInfo')</td>
        </tr>
        </thead>
        <tbody>
        <tr>
            ##债券类型
            <td class="textRight" width="14%">#springMessage('table.cmsBond.bondType')</td>
            <td width="36%">$!{cmsBondRegisterInfoVo.bondTypeName}</td>
            ##境内/境外
            <td class="textRight">#springMessage('table.cmsBond.isDomestic')</td>
            <td width="36%">$!dictTag.get("btBankAcc.isDomesticBank",$!{cmsBondRegisterInfoVo.isTerritory})</td>
        </tr>
        <tr>
            ##发行人/债务人
            <td class="textRight">#springMessage('table.cmsBond.bondIssuer')</td>
            <td colspan="3">$!{cmsBondRegisterInfoVo.corpName}</td>
        </tr>
        <tr>
            ##发行批文名称
            <td class="textRight" width="14%">#springMessage('table.cmsBond.issueName')</td>
            <td width="36%">$!{cmsBondRegisterInfoVo.issueName}</td>
            ##批准文号
            <td class="textRight" width="14%">#springMessage('table.cmsBond.approvalNumber')</td>
            <td width="36%">$!{cmsBondRegisterInfoVo.approvalNumber}</td>
        </tr>
        <tr>
            ##债券全称
            <td class="textRight">#springMessage('table.cmsBond.bondFullName')</td>
            <td colspan="3">$!{cmsBondRegisterInfoVo.bondFullName}</td>
        </tr>
        <tr>
            ##债券代码
            <td class="textRight" width="14%">#springMessage('table.cmsBond.bondCode')</td>
            <td width="36%">$!{cmsBondRegisterInfoVo.bondCode}</td>
            ##债券简称
            <td class="textRight" width="14%">#springMessage('table.cmsBond.bondShortName')</td>
            <td width="36%">$!{cmsBondRegisterInfoVo.bondShortName}</td>
        </tr>
        <tr>
            ##债券期限
            <td class="textRight" width="14%">#springMessage('table.cmsBond.bondDeadline')</td>
            <td width="36%"><span>$!{cmsBondRegisterInfoVo.bondDeadline}</span>
                <div class="layui-inline">
						<span>
                            $!dictTag.get("remainTerm.unit",${cmsBondRegisterInfoVo.deadlineUnit})
                        </span>
                </div>
            </td>
            ##债券原币币种
            <td class="textRight" width="14%">#springMessage('table.cmsBond.bondOriCur')</td>
            <td width="36%">$!{cmsBondRegisterInfoVo.bondCurName}</td>
        </tr>
        <tr>
            ##计划发行原币总额
            <td class="textRight">#springMessage('table.cmsBond.issueCurTotal')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    $number.formatNumeric($!{cmsBondRegisterInfoVo.issueCurTotal})
                </div>
            </td>
            ##计划发行人民币总额
            <td class="textRight">#springMessage('table.cmsBond.issueRmbTotal')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    $number.formatNumeric($!{cmsBondRegisterInfoVo.issueRmbTotal})
                </div>
            </td>
        </tr>
        <tr>
            ##债券信用评级
            <td class="textRight" width="14%">#springMessage('table.cmsBond.bondCreditRate')</td>
            <td width="36%">$!{cmsBondRegisterInfoVo.bondCreditRate}</td>
            ##发行人信用评级
            <td class="textRight" width="14%">#springMessage('table.cmsBond.debtorCreditRate')</td>
            <td width="36%">$!{cmsBondRegisterInfoVo.debtorCreditRate}</td>
        </tr>
        <tr>
            ##可转换开始日
            <td class="textRight">#springMessage('table.cmsBond.convertStartDate')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    $!date.format('yyyy-MM-dd',$!cmsBondRegisterInfoVo.convertStartDate)
                </div>
            </td>
            ##可转换结束日
            <td class="textRight" width="14%">#springMessage('table.cmsBond.convertEndDate')</td>
            <td width="36%">
                $!date.format('yyyy-MM-dd',$!cmsBondRegisterInfoVo.convertEndDate)
            </td>
        </tr>
        <tr>
            ##转换比例
            <td class="textRight" width="14%">#springMessage('table.cmsBond.convertRate')</td>
            <td width="36%">$!rateTag.show($!{cmsBondRegisterInfoVo.convertRate})</td>
            ##融资用途
            <td class="textRight" width="14%">#springMessage('table.cmsBond.purpose')</td>
            <td width="36%">$!{cmsBondRegisterInfoVo.purpose}</td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.cmsBond.rmk')</td>
            <td colspan="3">
                <div class="layui-input-inline">
                    $!{cmsBondRegisterInfoVo.rmk}
                </div>
            </td>
        </tr>
        </tbody>
    </table>
</div>
<form class="layui-form" method="post" id="inputForm">
    <input id="id" name="id" type="hidden" value="$!{leasePayVo.id}">
    <input id="corpId" name="corpId" type="hidden" value="$!{cmsBondRegisterInfoVo.corpId}">
    <input id="registerId" name="registerId" type="hidden" value="$!{cmsBondRegisterInfoVo.id}">
    <input id="issueId" name="issueId" type="hidden" value="$!{cmsBondPayVo.issueId}">

    <input id="onlineSign" type="hidden" value="$!{onlineSign}">
    <input id="tempOrSubmitSign" name="tempOrSubmitSign" type="hidden" value="$!{tempOrSubmitSign}">
    <table class="layui-table">
        <tbody>
        <tr class="dark-table-header">
            <td colspan="4" class="voucher-title">#springMessage('cms.cmsBond.bondPayInfo')</td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;" style="position: relative;">
                <label><b>#springMessage('table.leasepay.enrolTime')</b></label>
                <div class="layui-input-inline">
                    <input id="createDate" name="createDate"
                           value="$!date.format('yyyy-MM-dd',$!cmsBondPayVo.createDate)"
                           readonly="readonly" autocomplete="off" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            ##发行编码
            <td class="textRight">#springMessage('table.cmsBond.bondIssueNum')</td>
            <td>
                <input id="bondIssueNum" name="bondIssueNum" data-biz-name="bondIssueNum" class="layui-input"
                       readonly="true" placeholder="#springMessage('table.cmsBond.bondIssueNum')"/>
            </td>
            ##发行金额
            <td class="textRight">#springMessage('table.cmsBond.issueMoney')</td>
            <td>
                <input class="layui-input bt-biz-moneyType"
                       data-name="issueMoney"
                       data-biz-name="issueMoney"
                       data-decimal="2"
                       readonly="true"
                       placeholder="#springMessage('table.cmsBond.issueMoney')">
            </td>
        </tr>
        <tr>
            ##未还本金
            <td class="textRight" width="14%">#springMessage('table.cmsBond.unpaidMoney')</td>
            <td>
                <input class="layui-input bt-biz-moneyType"
                       data-name="unpaidMoney"
                       data-biz-name="unpaidMoney"
                       data-decimal="2"
                       readonly="true"
                       placeholder="#springMessage('table.cmsBond.unpaidMoney')">
            </td>
            ##还款日期
            <td class="textRight" width="14%">#springMessage('table.cmsBond.repayDate')</td>
            <td width="36%">
                <div class="layui-inline">
                    <input class="layui-input bt-biz-dateType"
                           id="payDate"
                           name="payDate"
                           value="$!{cmsBondPayVo.payDate}"
                           data-biz-name="payDate"
                           data-type="date"
                           lay-verify="required">
                </div>
                <div class="layui-inline">
                    <!-- 还款计划 -->
                    <!-- 利息预计明细 -->
                    <button class="layui-btn" type="button" onclick="repayInterest();">#springMessage(
                            'cms.button.detail')</button>
                    <input id="planDtlId" name="planDtlId" type="hidden"
                           value="$!{cmsBondPayVo.planDtlId}">
                </div>
            </td>
        </tr>
        <tr>
            ##本金
            <td class="textRight">#springMessage('table.cmsBond.principalMoney')</td>
            <td>
                <div class="layui-inline">
                    <input class="layui-input bt-biz-moneyType"
                           data-name="repayMoney"
                           lay-verify="required"
                           data-biz-name="repayMoney"
                           data-decimal="2"
                           placeholder="#springMessage('table.cmsBond.principalMoney')">
                </div>
            </td>
            ##是否付息
            <td class="textRight">
                #springMessage('table.cmsBond.isPayInterest')
            </td>
            <td>
                <div class="bt-biz-dict" data-name="isPayInterest" data-defaultvalue="0"
                     data-callback="showInterest" data-biz-name="isPayInterest"
                     data-type="radio" data-group="sf_yn"></div>
            </td>
        </tr>
        <tr id="showInterest" style="display:none">
            ##测算利息
            <td class="textRight">#springMessage('table.cmsBond.calculateInterest')</td>
            <td>
                <div class="layui-inline">
                    <input class="layui-input bt-biz-moneyType"
                           data-name="calculateInterest"
                           value="$!{cmsBondPayVo.calculateInterest}"
                           data-biz-name="calculateInterest"
                           data-decimal="2"
                           placeholder="#springMessage('table.cmsBond.calculateInterest')">
                </div>
            </td>
            ##实付利息
            <td class="textRight">#springMessage('table.cmsBond.payInterest')</td>
            <td>
                <input class="layui-input bt-biz-moneyType requiredInterest"
                       data-name="interest"
                       value="$!{cmsBondPayVo.interest}"
                       data-biz-name="interest"
                       data-decimal="2"
                       placeholder="#springMessage('table.cmsBond.payInterest')">
            </td>
        </tr>
            #if("$!{cmsBondPayVo.onlineSign}" == "1")
                ##线上还款
            <input type="hidden" id="onlineSign" name="onlineSign" value="1">
            <tr>
                ##收款人
                <td class="textRight">#springMessage('table.cmsBond.payeeName')</td>
                <td>
                    <input id="payee" name="payee" value="$!{cmsBondPayVo.payee}"
                           class="layui-input" readonly="readonly"
                           placeholder="#springMessage('table.cmsBond.payeeName')"/>
                </td>
                ##收款账号
                <td class="textRight">#springMessage('table.cmsBond.payeeAcc')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="onlinePaymentAcc" name="onlinePaymentAcc" lay-verify="required"
                               value="$!{cmsBondPayVo.onlinePaymentAcc}"
                               autocomplete="off" class="layui-input"
                               placeholder="#springMessage('table.cmsBond.payeeAcc')">
                        <div class="bt-div-search">
                            <button class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button"
                                    data-beforeClick="bt.externalCorpBankAccParams"
                                    data-callback="bt.externalCorpCallback"
                                    title="#springMessage('common.button.select')">
                                <i class="layui-icon">&#xe615;</i>
                            </button>
                        </div>
                    </div>
                    <div class="layui-inline" id="accMsg">
                        <span></span>
                    </div>
                </td>
            </tr>
            <tr>
                ##收款账号名称
                <td class="textRight">#springMessage('table.cmsBond.payeeAccName') </td>
                <td>
                    <input type="hidden" id="onlinePaymentAccId" name="onlinePaymentAccId"
                           value="$!{cmsBondPayVo.onlinePaymentAccId}">
                    <input id="onlineAccName" name="onlineAccName" value="$!{cmsBondPayVo.onlineAccName}"
                           class="layui-input"
                           type="text" readonly="readonly" lay-verify="required"
                           placeholder="#springMessage('table.cmsBond.payeeAccName')"/>
                </td>
                ##收款开户行名称
                <td class="textRight">#springMessage('table.cmsBond.payeeBank')</td>
                <td>
                    <input id="onlineBankName" name="onlineBankName" value="$!{cmsBondPayVo.onlineBankName}"
                           class="layui-input" type="text" readonly="readonly" lay-verify="required"
                           placeholder="#springMessage('table.cmsBond.payeeBank')"/>
                </td>
            </tr>
            <tr>
                ##用途
                <td class="textRight">
                    #springMessage('table.cmsBond.purpose')
                </td>
                <td>
                    <div class=layui-inline>
                        <div class=bt-biz-selectType
                             data-name="purpose"
                             data-textField="purpose"
                             data-valueField="purpose"
                             data-biz-name="purpose"
                             data-url="${basePath}/cms/provide/loaninfo/getPurpose?corpId=${cmsBondRegisterInfoVo.corpId}"
                             data-defaultvalue="$!{cmsBondPayVo.purpose}"
                             data-required="true"
                             data-inputvalue="true"
                             data-search="true">
                        </div>
                    </div>
                </td>
                ##备注
                <td class="textRight">#springMessage('table.cmsBond.rmk')</td>
                <td>
                    <input id="rmk" name="rmk" value="$!{cmsBondPayVo.rmk}" data-biz-name="rmk" class="layui-input"
                           placeholder="#springMessage('table.cmsBond.rmk')"/>
                </td>
            </tr>
            #elseif("$!{cmsBondPayVo.onlineSign}" == "0")
                ##线下还款
            <input type="hidden" id="onlineSign" name="onlineSign" value="0">
            <tr>
                ##备注
                <td class="textRight">#springMessage('table.cmsBond.rmk')</td>
                <td>
                    <input id="rmk" name="rmk" value="$!{cmsBondPayVo.rmk}" data-biz-name="rmk" class="layui-input"
                           placeholder="#springMessage('table.cmsBond.rmk')"/>
                </td>
            </tr>
            #end
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit ">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" id="submit" type="button">#springMessage(
                'common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            <button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage(
                'common.button.close')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/bond/bondPay/cmsBondPay.edit.js?_btv=${resourceVersion}"></script>
</html>

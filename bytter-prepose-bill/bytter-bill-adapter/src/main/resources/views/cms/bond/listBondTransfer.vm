<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input type="hidden" id="isHistory"  name="isHistory" value="$!{isHistory}"/>
<input type="hidden" id="issueId"  name="issueId"  value="$!{issueId}"/>
<form id="searchForm" class="layui-form" style="display:none;">
    <table class="layui-table">
        <tbody>
        <tr>
            <td >
                <input type="hidden" id="issueId"  name="eqs_issueId"  value="$!{issueId}"/>
            </td>
        </tr>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsBond.transferDate')</th>
        <th>#springMessage('table.cmsBond.transferPrice')</th>
        <th>#springMessage('table.cmsBond.transferAmount')</th>
        <th>#springMessage('table.cmsBond.totalTransferAmount')</th>
        <th>#springMessage('table.cmsBond.totalTransferRate')</th>
        <th>#springMessage('table.cmsBond.totalTransferMoney')</th>
        <th>#springMessage('table.cmsBond.status')</th>
        #if("$!{isHistory}" == '0') <th>#springMessage('table.cmsBond.operation')</th> #end
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/bond/listBondTransfer.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

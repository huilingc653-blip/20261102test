<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>

<body>
<table class="layui-table">
    <tbody>
    <tr>
        ##债券类型
        <td class="textRight" width="14%">#springMessage('table.cmsBond.bondType')</td>
        <td width="36%">$!{cmsBondRegisterInfoVo.bondTypeName}</td>
        ##境内/境外
        <td class="textRight">#springMessage('table.cmsBond.isDomestic')</td>
        <td width="36%">$!dictTag.get("btBankAcc.isDomesticBank",$!{cmsBondRegisterInfoVo.isTerritory})</td>
    </tr>
    <tr>
        ##发行人/债务人
        <td class="textRight">#springMessage('table.cmsBond.bondIssuer')</td>
        <td colspan="3">$!{cmsBondRegisterInfoVo.corpName}</td>
    </tr>
    <tr>
        ##发行批文名称
        <td class="textRight" width="14%">#springMessage('table.cmsBond.issueName')</td>
        <td width="36%">$!{cmsBondRegisterInfoVo.issueName}</td>
        ##批准文号
        <td class="textRight" width="14%">#springMessage('table.cmsBond.approvalNumber')</td>
        <td width="36%">$!{cmsBondRegisterInfoVo.approvalNumber}</td>
    </tr>
    <tr>
        ##债券全称
        <td class="textRight">#springMessage('table.cmsBond.bondFullName')</td>
        <td colspan="3">$!{cmsBondRegisterInfoVo.bondFullName}</td>
    </tr>
    <tr>
        ##债券代码
        <td class="textRight" width="14%">#springMessage('table.cmsBond.bondCode')</td>
        <td width="36%">$!{cmsBondRegisterInfoVo.bondCode}</td>
        ##债券简称
        <td class="textRight" width="14%">#springMessage('table.cmsBond.bondShortName')</td>
        <td width="36%">$!{cmsBondRegisterInfoVo.bondShortName}</td>
    </tr>
    <tr>
        ##债券期限
        <td class="textRight" width="14%">#springMessage('table.cmsBond.bondDeadline')</td>
        <td width="36%">$!{cmsBondRegisterInfoVo.bondDeadline}
            <div class="layui-inline">
						<span>
                            $!dictTag.get("remainTerm.unit",${cmsBondRegisterInfoVo.deadlineUnit})
                        </span>
            </div>
        </td>
        ##债券原币币种
        <td class="textRight" width="14%">#springMessage('table.cmsBond.bondOriCur')</td>
        <td width="36%">$!{cmsBondRegisterInfoVo.bondCurName}</td>
    </tr>
    <tr>
        ##计划发行原币总额
        <td class="textRight">#springMessage('table.cmsBond.issueCurTotal')</td>
        <td width="36%">
            <div class="layui-input-inline">
                $number.formatNumeric($!{cmsBondRegisterInfoVo.issueCurTotal})
            </div>
        </td>
        ##计划发行人民币总额
        <td class="textRight">#springMessage('table.cmsBond.issueRmbTotal')</td>
        <td width="36%">
            <div class="layui-input-inline">
                $number.formatNumeric($!{cmsBondRegisterInfoVo.issueRmbTotal})
            </div>
        </td>
    </tr>
    <tr>
        ##债券信用评级
        <td class="textRight" width="14%">#springMessage('table.cmsBond.bondCreditRate')</td>
        <td width="36%">$!{cmsBondRegisterInfoVo.bondCreditRate}</td>
        ##发行人信用评级
        <td class="textRight" width="14%">#springMessage('table.cmsBond.debtorCreditRate')</td>
        <td width="36%">$!{cmsBondRegisterInfoVo.debtorCreditRate}</td>
    </tr>
    <tr>
        ##可转换开始日
        <td class="textRight">#springMessage('table.cmsBond.convertStartDate')</td>
        <td width="36%">
            <div class="layui-input-inline">
                $!date.format('yyyy-MM-dd',$!cmsBondRegisterInfoVo.convertStartDate)
            </div>
        </td>
        ##可转换结束日
        <td class="textRight" width="14%">#springMessage('table.cmsBond.convertEndDate')</td>
        <td width="36%">
            $!date.format('yyyy-MM-dd',$!cmsBondRegisterInfoVo.convertEndDate)
        </td>
    </tr>
    <tr>
        ##转换比例
        <td class="textRight" width="14%">#springMessage('table.cmsBond.convertRate')</td>
        <td width="36%">$!rateTag.show($!{cmsBondRegisterInfoVo.convertRate})</td>
        ##融资用途
        <td class="textRight" width="14%">#springMessage('table.cmsBond.purpose')</td>
        <td width="36%">$!{cmsBondRegisterInfoVo.purpose}</td>
    </tr>
    <tr>
        ##备注
        <td class="textRight">#springMessage('table.cmsBond.rmk')</td>
        <td colspan="3">
            <div class="layui-input-inline">
                $!{cmsBondRegisterInfoVo.rmk}
            </div>
        </td>
    </tr>
    </tbody>
</table>

<form class="layui-form" method="post">
    <div>
        <div>#springMessage('table.cmsBond.bondIssueNum')</div>
        <div class="layui-inline" style="margin-left: 90px;margin-top: -20px">
            <div class="bt-biz-selectType" data-name="bondIssueNum" data-biz-name="bondIssueNum"
                 data-inputValue="false"
                 data-url="${basePath}/cms/bond/issue/listValidBondIssueNum/$!{cmsBondRegisterInfoVo.id}"
                 data-valuefield="id"
                 data-callback="typeCallBack"
                 data-textfield="bondIssueNum" data-required="true"
                 data-defaultvalue="$!{cmsBondIssueInfoVo.id}"></div>
        </div>
    </div>
</form>
<table class="layui-table" width="100%">
    <thead>
    <input type="hidden" id="registerId" name="registerId" value="$!{cmsBondRegisterInfoVo.id}">##债券主表id
    <input type="hidden" id="issueId" name="issueId" value="$!{cmsBondIssueInfoVo.id}">##债券发行表id
    <input type="hidden" id="bondIssueNum" name="bondIssueNum" value="$!{cmsBondIssueInfoVo.bondIssueNum}">##债券发行编号
    <tr>
        <th>#springMessage('table.cmsBond.bondIssueNum')</th> ##债券发行编号
        <th>#springMessage('table.cmsBond.repayDate')</th>    ##还款日期
        <th>#springMessage('table.cmsBond.planRepayDate')</th> ##计划还款日
        <th>#springMessage('table.cmsBond.repayMoney')</th>    ##还款本金值
        <th>#springMessage('table.cmsBond.remainMoney')</th> ##剩余本金值
        <th>#springMessage('table.cmsBond.repayAmount')</th> ##本次还款金额
        <th>#springMessage('table.cmsBond.repayRate')</th>    ##本次偿还站发行总额比例%
        <th>#springMessage('table.cmsBond.isRepay')</th>    ##是否已还
        <th>#springMessage('table.cmsBond.rmk')</th> ##备注
    </tr>
    </thead>
    <tbody id="cmsBondRepayPlanDtlBody">

    </tbody>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
    var moneyFun
    bt.use(['form', 'datatable', 'corp', 'moneyType', 'dateType', 'selectType', 'dicts', 'mulselect', 'rateType'], function () {
        $ = bt.jquery, form = bt.form(), moneyFun = bt.moneyType.getFun();
        bt.corp.init();
        bt.moneyType.init();//金额
        bt.dateType.init();//日期
        bt.selectType.init();
        bt.dicts.init();//数据字典
        bt.mulselect.init();

        initTableData();
    });

    function initTableData() {
        $.ajax({
            type: "post",
            url: basePath + "/cms/bond/cmsbondrepayplan/listPlanDtlByRegisterId",
            dataType: "json",
            data: {registerId: $("#registerId").val()},
            success: function (result) {
                if (result) {
                    // 渲染表格
                    createTbody(result);
                }
            }
        });
    }

    function createTbody(bodyData) {
        var html = '';
        for (var i = 0; i < bodyData.length; i++) {
            rowNum = i
            var data = bodyData[i];
            html += '<tr class="bondIssueNum_' + data.bondIssueNum + '">';
            html += '<td style="text-align: center">' + data.bondIssueNum + '</td>';
            html += '<td style="text-align: center">' + data.repayDate + '</td>';
            html += '<td style="text-align: center">' + data.planRepayDate + '</td>';
            html += '<td style="text-align: center">' + moneyFun.format(data.repayMoney) + '</td>';
            html += '<td style="text-align: center">' + moneyFun.format(data.remainMoney) + '</td>';
            html += '<td style="text-align: center">' + moneyFun.format(data.repayAmount) + '</td>';
            html += '<td style="text-align: center">' + data.repayRate * 100 + '%</td>';
            html += '<td style="text-align: center">' + bt.dict("sf_yn",data.isRepay)  + '</td>';
            html += data.rmk == null ? '<td></td>' : '<td>' + data.rmk + '</td>';
            html += '</tr>';
        }
        $('#cmsBondRepayPlanDtlBody').html(html)

        // 根据当前发行编号删选数据
        $('#cmsBondRepayPlanDtlBody').find('tr').hide()
        var bondIssueNum = $("#bondIssueNum").val();
        $('.bondIssueNum_' + bondIssueNum).show();
        bt.dicts.init();
        bt.rateType.init();
    }

    // 切换发行编码
    function typeCallBack(data) {
        $('#cmsBondRepayPlanDtlBody').find('tr').hide()
        $('.bondIssueNum_' + data.bondissuenum).show();
    }
</script>

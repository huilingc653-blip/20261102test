<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post" style="display:none;">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />

</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsBond.extendApplyDate')</th>
        <th>#springMessage('table.cmsBond.bondIssueNum')</th>
        <th>#springMessage('cms.lease.extend.expendedCode')</th>
        <th>#springMessage('table.cmsBond.extendEndDate')</th>
        <th>#springMessage('table.cmsLoanDeferred.deferredLimt')</th>
        <th>#springMessage('cms.lease.extend.pointsProportionSelect')</th>
        <th>#springMessage('table.cmsLoanSend.deferredRate')（%）</th>
        <th>#springMessage('table.cmsBond.rmk')</th>
        <th>#springMessage('table.cmsBond.operation')</th>
    </tr>
    </thead>
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
</body>

<script>
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts", "corp","dateType",'rateType'], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        selectType = bt.selectType.init();
        bt.dateType.init();//日期时间
        bt.moneyType.init();
        corp = bt.corp.init();//单位

        /**
         * 生成列表
         */
        datatable = bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            checkbox: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search",
                isInitData:"false"
            },
            ajax: {
                'url': basePath + "/cms/bond/extend/dataTableApprove"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            fixedColumns: {
                rightColumns: 2//代表冻结右边一列
            },
            columns: [
                {data: "extendApplyDate", className: 'center', bSortable: true},
                {data: "bondIssueNum", className: 'center', bSortable: true},
                {data: "extendCode", className: 'center', bSortable: true},
                {data: "extendEndDate", className: 'center', bSortable: true},
                {
                    data: "extendDeadline", className: 'center', render: function (data, type, full, meta) {
                        return data !== null ? data + bt.dict("remainTerm.unit",full.deadlineUnit) : ''
                    }
                },
                {
                    data: "basicPoint", className: 'textRight', render: function (data, type, full, meta) {
                        return basicPoint = bt.rateType.getFun().format(full.basicPoint);
                    }
                },
                {
                    data: "extendRate", className: 'textRight', render: function (data, type, full, meta) {
                        return extendRate = bt.rateType.getFun().format(full.extendRate);
                    }
                },
                {data: "rmk", bSortable: true},
                {data:null,bSortable:false,className:'center',
                    render: function (data, type, full, meta) {
                        var html='';
                        if($("#flowStatus").val()=='todo'){
                            html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
                        }
                        html += '<a class="" href="#" data-row="'+meta.row+'" onclick="bt.workFlow.trackFlow(\''+full.processInstanceId+'\')">'+bt.lang("common.button.trackFlow")+'</a>';
                        return html;
                    }
                }
            ]
        });
    });


    /*审核*/
    function approve(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.approve') ,basePath + "/cms/bond/extend/approve?businessId=" + data.id + "&taskId=" + data.taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/bond/extend/approve?businessId=" + data.id + "&taskId=" + data.taskId
        });
    }

</script>
</html>

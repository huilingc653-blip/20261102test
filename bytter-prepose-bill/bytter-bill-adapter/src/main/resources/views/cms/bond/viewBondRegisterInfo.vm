<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input id="id" name="id" type="hidden" value="$!{registerInfo.id}">
    <table class="layui-table">
        <thead>
        <tr><td colspan="4" align="center"><strong>#springMessage('table.cmsBond.registerMainMsg')</strong></td></tr>
        </thead>
        <colgroup>
            <col width="15%">
            <col width="35%">
            <col width="15%">
            <col width="35%">
        </colgroup>
        <tbody>
        <tr>
            ## 债券类型
            <td class="textRight">#springMessage('table.cmsBond.bondType')</td>
            <td>
                <span>$!{registerInfo.bondTypeName}</span>
            </td>
            ## 境内境外
            <td class="textRight">#springMessage('table.cmsBond.isDomestic')</td>
            <td>
                #if($!{registerInfo.isDomestic} eq '1')
                    <span>境内</span>
                #else
                    <span>境外</span>
                #end
            </td>
        </tr>
        <tr>
            ## 发行人/债务人
            <td class="textRight">#springMessage('table.cmsBond.bondIssuer')</td>
            <td>
                <span>$!{registerInfo.corpName}</span>
            </td>
            ## 债券全称
            <td class="textRight">#springMessage('table.cmsBond.bondFullName')</td>
            <td>
                <span>$!{registerInfo.bondFullName}</span>
            </td>
        </tr>
        <tr>
            ## 发行批文名称
            <td class="textRight">#springMessage('table.cmsBond.issueName')</td>
            <td>
                <span>$!{registerInfo.issueName}</span>
            </td>
            ## 批准文号
            <td class="textRight">#springMessage('table.cmsBond.approvalNumber')</td>
            <td>
                <span>$!{registerInfo.approvalNumber}</span>
            </td>
        </tr>
        <tr>
            ## 债券代码
            <td class="textRight">#springMessage('table.cmsBond.bondCode')</td>
            <td>
                <span>$!{registerInfo.bondCode}</span>
            </td>
            ## 债券简称
            <td class="textRight">#springMessage('table.cmsBond.bondShortName')</td>
            <td>
                <span>$!{registerInfo.bondShortName}</span>
            </td>
        </tr>
        <tr>
            ## 债券期限
            <td class="textRight">#springMessage('table.cmsBond.bondDeadline')</td>
            <td>
                <div class="layui-inline">
                    <span>$!{registerInfo.bondDeadline}</span>
                </div>
                <div class="layui-inline">
						<span>
                            $!dictTag.get("remainTerm.unit",${registerInfo.deadlineUnit})
                        </span>
                </div>
            </td>
            ## 债券原币币种
            <td class="textRight">#springMessage('table.cmsBond.bondOriCur')</td>
            <td>
                <span>$!{registerInfo.bondCurName}</span>
            </td>
        </tr>
        <tr>
            ## 计划发行原币总额
            <td class="textRight">#springMessage('table.cmsBond.issueCurTotal')</td>
            <td>
                <span>
                    $number.formatNumeric($!{registerInfo.issueCurTotal})
                </span>
            </td>
            ## 计划发行人民币总额
            <td class="textRight">#springMessage('table.cmsBond.issueRmbTotal')</td>
            <td>
                <span>
                    $number.formatNumeric($!{registerInfo.issueRmbTotal})
                </span>
            </td>
        </tr>
        <tr>
            ## 债券信用评级
            <td class="textRight">#springMessage('table.cmsBond.bondCreditRate')</td>
            <td>
                <span>$!{registerInfo.bondCreditRate}</span>
            </td>
            ## 发行人信用评级
            <td class="textRight">#springMessage('table.cmsBond.debtorCreditRate')</td>
            <td>
                <span>$!{registerInfo.debtorCreditRate}</span>
            </td>
        </tr>
        <tr>
            ## 可转换开始日
            <td class="textRight">#springMessage('table.cmsBond.convertStartDate')</td>
            <td>
                <span>
                    $!date.format('yyyy-MM-dd',$!registerInfo.convertStartDate)
                </span>
            </td>
            ## 可转换结束日
            <td class="textRight">#springMessage('table.cmsBond.convertEndDate')</td>
            <td>
                <span>
                $!date.format('yyyy-MM-dd',$!registerInfo.convertEndDate)</span>
            </td>
        </tr>
        <tr>
            ## 转换比例
            <td class="textRight">#springMessage('table.cmsBond.convertRate')</td>
            <td>
                <span>$rateTag.show($!{registerInfo.convertRate}) </span>
            </td>
            ## 融资用途
            <td class="textRight">#springMessage('table.cmsBond.purpose')</td>
            <td>
                <span>$!{registerInfo.purpose}</span>
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.cmsLoanInfo.rmk')</td>
            <td colspan="3">
                <textarea style="min-height:70px"  class="layui-textarea" readonly="readonly">$!{registerInfo.rmk}</textarea>
            </td>
        </tr>
        <tr>
            ##附件
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <!-- 附件上传 -->
                <input id="annexName" name="annexName" type="hidden" value="$!{registerInfo.attachmentId}">
                <div id="uploader" class="layui-input-inline" style="width:100%"></div>
            </td>
        </tr>
        </tbody>

    </table>
    <!-- 日志 -->
    #if(!$!{taskId})
        <div id="tagMsg"></div>
        <table class="layui-table">
            <tr>
                <td colspan="4" align="center">
                    <button class="layui-btn"  onClick="doClose()">#springMessage('common.button.close')</button>
                    #if($!{registerInfo.status} eq '0'||$!{registerInfo.status} eq '11'||$!{registerInfo.status} eq '-1')##待审批和审批打回时可查看审批流程
                        <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{registerInfo.id}')">#springMessage('common.button.trackFlow')</button>
                    #end
                </td>
            </tr>
        </table>
    #end


</form>

    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form','btUpload','moneyType'], function() {
        $ = bt.jquery,form = bt.form();
        bt.moneyType.init();
        var gid = $("#annexName").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gid
        });


        //关闭窗口
        doClose = function(){
            if(bt.navtab){
                bt.navtab.closeCurrent();
            }
        };

        /**
         * 生成日志列表
         * @return
         */
        $genMsgHtml = function () {
            var billCode = $("#id").val();
            var url = basePath + "/cms/basedata/cmsprocessmsg/list/" + billCode;
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                    form.render();
                }
            });
        }
        $genMsgHtml();
    });
</script>
</html>

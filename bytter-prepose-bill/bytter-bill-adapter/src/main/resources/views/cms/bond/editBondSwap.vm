<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
    ##可交债信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsBond.swap')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <input type="hidden" id="issueId" name="issueId" value="$!{cmsBondSwapVO.issueId}">
                        <input type="hidden" id="swapId" name="id" value="$!{cmsBondSwapVO.id}">
                        ##换股日
                        <td class="textRight" >#springMessage('table.cmsBond.swapDate')</td>
                        <td >
                            <div class="layui-input-inline">
                                <input type="text" id="swapDate" name="swapDate" data-biz-name="swapDate"
                                       lay-verify="required"
                                       data-type="date" class="layui-input bt-biz-dateType"
                                       value="$!date.format('yyyy-MM-dd',$!cmsBondSwapVO.swapDate)">
                            </div>
                        </td>
                        ##换股价
                        <td class="textRight" >#springMessage('table.cmsBond.swapPrice')</td>
                        <td >
                            <div class="layui-input-inline">
                                <input type="text" id="swapPrice" name="swapPrice" data-name="swapPrice"
                                       value="$!{cmsBondSwapVO.swapPrice}"
                                       lay-verify="required" class="layui-input bt-biz-moneyType" data-decimal="2">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##换股数量
                        <td class="textRight">#springMessage('table.cmsBond.swapAmount')</td>
                        <td>
                            <input type="text" id="swapAmount" name="swapAmount" data-name="swapAmount"
                                   value="$!{cmsBondSwapVO.swapAmount}"
                                   lay-verify="required" class="layui-input bt-biz-moneyType" data-decimal="0">
                        </td>
                        ##累计换股数量
                        <td class="textRight">#springMessage('table.cmsBond.totalSwapAmount')</td>
                        <td>
                            <input type="text" id="totalSwapAmount" name="totalSwapAmount"
                                   data-name="totalSwapAmount" value="$!{cmsBondSwapVO.totalSwapAmount}"
                                   lay-verify="required" class="layui-input bt-biz-moneyType" data-decimal="0">
                        </td>
                    </tr>
                    <tr>
                        ##累计换股金额
                        <td class="textRight">#springMessage('table.cmsBond.totalSwapMoney')</td>
                        <td>
                            <input id="totalSwapMoney" data-name="totalSwapMoney" name="totalSwapMoney"
                                   data-decimal="2"
                                   lay-verify="required" class="layui-input bt-biz-moneyType"
                                   value="$!{cmsBondSwapVO.totalSwapMoney}">
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    <tr>
                        <td colspan="4" style="text-align: center">
                            <div class="layui-form-item layui-form-submit ">
                                <div class="layui-input-block">
                                    <button class="layui-btn" lay-submit="" id="submit" type="button">#springMessage(
                'common.button.submit')</button>

                                    <button class="layui-btn" lay-submit="" id="temp" type="button">#springMessage(
                    'common.button.temp')</button>

                                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                        'common.button.reset')</button>
                                    <button class="layui-btn" type="button"
                                            onClick="javascript:bt.navtab.closeCurrent();">#springMessage(
                'common.button.close')</button>
                                </div>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/bond/editBondSwap.edit.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <input type="hidden" id="isSaveSign" name="isSaveSign" value="$!{isSaveSign}">## 是否保存操作
    <table class="layui-table">
        <tbody>
        <tr>
            ##债券类型
            <td class="textRight">#springMessage('table.cmsBond.bondType')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_typeId" data-biz-name="eqs_typeId"
                         data-inputValue="false"
                         data-url="${basePath}/cms/bond/type/listValidBondType" data-valuefield="id"
                         data-textfield="bondName"></div>
                </div>
            </td>
            ##发行人/债务人
            <td class="textRight">#springMessage('table.cmsBond.bondIssuer')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-type="selectTree" data-name="eqs_corpId"
                         data-resource="cms:bond:cmsbondpay:query" data-scope="all"></div>
                </div>
            </td>
            ##债券代码
            <td class="textRight">#springMessage('table.cmsBond.bondCode')</td>
            <td width="25%">
                <input name="likes_bondCode" class="layui-input"
                       placeholder="#springMessage('table.cmsBond.bondCode')">
            </td>
        </tr>
        <tr>
            ##债券全称
            <td class="textRight" width="8%">#springMessage('table.cmsBond.bondFullName')</td>
            <td width="25%">
                <input name="likes_bondFullName" class="layui-input"
                       placeholder="#springMessage('table.cmsBond.bondFullName')">
            </td>
            ##币种
            <td class="textRight">#springMessage('table.cmsBond.bondCur')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_bondCur" data-biz-name="eqs_bondCur"
                         data-inputValue="false"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName"></div>
                </div>
            </td>
            ##计划发行原币总额
            <td class="textRight">#springMessage('table.cmsBond.issueCurTotal')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="geg_issueCurTotal"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_issueCurTotal"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" id="t20">
                </div>
            </td>
        </tr>
        <tr>
            #if($shiro.hasPermission("cms:bond:cmsbondpay:query"))
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                        'common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
                </td>
            #end
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsBond.bondType')</th><!-- 债券类型 -->
        <th>#springMessage('table.cmsBond.bondIssuer')</th><!-- 发行人/债务人 -->
        <th>#springMessage('table.cmsBond.bondCode')</th><!-- 债券代码 -->
        <th>#springMessage('table.cmsBond.bondShortName')</th><!-- 债券简称 -->
        <th>#springMessage('table.cmsBond.bondFullName')</th><!-- 债券全称 -->
        <th>#springMessage('table.cmsBond.bondCur')</th><!-- 币种-->
        <th>#springMessage('table.cmsBond.issueCurTotal')</th><!-- 计划发行原币总额-->
        <th>#springMessage('table.cmsBond.status')</th><!-- 状态-->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
    bt.use(['form', 'datatable', 'corp', 'moneyType', 'dateType', 'selectType', 'dicts', 'mulselect'], function () {
        $ = bt.jquery, form = bt.form(), moneyFun = bt.moneyType.getFun();
        bt.corp.init();
        bt.moneyType.init();//金额
        bt.dateType.init();//日期
        bt.selectType.init();
        bt.dicts.init();//数据字典
        bt.mulselect.init();

        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath + "/cms/bond/cmsbondpay/datatable"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            columns: [
                {data: "bondTypeName", bSortable: true},
                {data: "corpName", bSortable: true},
                {data: "bondCode", bSortable: true},
                {data: "bondShortName", bSortable: true},
                {data: "bondFullName", bSortable: true},
                {data: "bondCurName", bSortable: true},
                {
                    data: "issueCurTotal", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.issueCurTotal);
                    }
                },
                {
                    data: "status", bSortable: true, className: 'center',
                    render: function (data, type, full, meta) {
                        return bt.dict("lease.status", full.status);
                    }
                },
                {
                    data: null,
                    bSortable: false,
                    className: 'center',
                    render: function (data, type, full, meta) {
                        var html = '';
                        if (full.bizStatus != '51' && full.bizStatus != '61' && full.bizStatus != '71') {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bondPay(this,\'0\')">' + bt.lang('cms.button.bondpay.offline') + '</a>';
                            html += '\<span class="text-explode">|</span>\ <a class="" href="#" data-row="' + meta.row + '" onclick="bondPay(this,\'1\')">' + bt.lang('cms.button.bondpay.online') + '</a>';
                            html += '\<span class="text-explode">|</span>\ ';
                        }
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a>';
                        return html;
                    }
                }
            ]
        });

        /**判断字符串是否为空*/
        bt.empty = function (ms) {
            if (typeof (ms) == "undefined" || ms == null || ms == "" || ms == "null") {
                return true;
            }
            return false;
        }
    });

    function view(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/bond/cmsbondpay/view/" + data.id);
            return;
        }
    }

    /**支付*/
    function bondPay(el, sign) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        var tempOrSubmitSign = 0;
        var url = basePath + "/cms/bond/cmsbondpay/edit?registerId=" + data.id + "&tempOrSubmitSign=" + tempOrSubmitSign + "&onlineSign=" + sign;
        if (parent.bt.navtab) {
            parent.bt.navtab.addNavtab(bt.lang('common.add.data'), url);
            return;
        }
        top.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: url,
            end: function () {
                datatable && datatable.draw();
            }
        });
    }
</script>

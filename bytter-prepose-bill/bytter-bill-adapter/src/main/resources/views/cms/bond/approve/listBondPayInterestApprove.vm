<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}"/>
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
    <table class="layui-table">
        <tbody>
        <tr>
            ##债券代码
            <td class="textRight">#springMessage('table.cmsBond.bondCode')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="likes_bondCode" id="bondCode" class="layui-input">
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsBond.bondType')</th><!-- 债券类型 -->
        <th>#springMessage('table.cmsBond.bondIssuer')</th><!-- 发行人/债务人 -->
        <th>#springMessage('table.cmsBond.bondCode')</th><!-- 债券代码 -->
        <th>#springMessage('table.cmsBond.bondShortName')</th><!-- 债券简称 -->
        <th>#springMessage('table.cmsBond.bondFullName')</th><!-- 债券全称 -->
        <th>#springMessage('table.cmsBond.bondCur')</th><!-- 币种-->
        <th>#springMessage('table.cmsBond.issueCurTotal')</th><!-- 计划发行原币总额-->
        <th>#springMessage('table.cmsBond.bondIssueNum')</th>
        <th>#springMessage('table.cmsLease.createBy')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
</body>
<script>
    bt.use(['form', 'datatable', 'corp', 'moneyType'], function () {
        $ = bt.jquery, form = bt.form();
        bt.corp.init();//单位
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            checkbox: true,
            ajax: {
                'url': basePath + "/cms/bond/cmsbondpayinterest/dataTableApprove"
            },
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            columns: [
                {data: "bondTypeName", bSortable: true},
                {data: "corpName", bSortable: true},
                {data: "bondCode", bSortable: true},
                {data: "bondShortName", bSortable: true},
                {data: "bondFullName", bSortable: true},
                {data: "bondCurName", bSortable: true},
                {
                    data: "issueCurTotal", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.issueCurTotal);
                    }
                },
                {data: "bondIssueNum", bSortable: true},
                {data: "createBy"},
                {
                    data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
                        var html = '';
                        if ($("#flowStatus").val() == 'todo') {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="approve(this)">' + bt.lang("common.button.approve") + '</a>&nbsp;|&nbsp;';
                        }
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        if ($("#flowStatus").val() == 'pass') {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }
                        return html;
                    }
                }
            ],
            summary: {
                pageSum: true,//小计功能关闭
                selectSum: true,//已选汇总功能开启
                // groupColumn: 'curName',//分类汇总列参数
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '5',//汇总列序号
                        dataName: 'plMoney',//汇总列数据
                    }
                ]
            }
        });
    });

    /**审批*/
    function approve(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.button.approve'), basePath + "/cms/bond/cmsbondpayinterest/viewApprove?businessId=" + data.id + "&taskId=" + data.taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/bond/cmsbondpay/viewApprove?businessId=" + data.id + "&taskId=" + data.taskId
        });
    }
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
    ##可转债信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsBond.transfer')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
        <table class="layui-table">
        <tbody>
        <tr>
            <input type="hidden" id="issueId" name="issueId" value="$!{cmsBondTransferVO.issueId}">
            <input type="hidden" id="transferId" name="id" value="$!{cmsBondTransferVO.id}">
            <td class="textRight" >#springMessage('table.cmsBond.transferDate')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" id="transferDate" name="transferDate" data-biz-name="transferDate" lay-verify="required"
                           data-type="date" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!cmsBondTransferVO.transferDate)">
                </div>
            </td>
            ## 转股价
            <td class="textRight" >#springMessage('table.cmsBond.transferPrice')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" id="transferPrice" name="transferPrice" data-name="transferPrice" value="$!{cmsBondTransferVO.transferPrice}"
                           lay-verify="required" class="layui-input bt-biz-moneyType" data-decimal="2">
                </div>
            </td>
        </tr>
        <tr>
            ##转股数量
            <td class="textRight">#springMessage('table.cmsBond.transferAmount')</td>
            <td>
                <input type="text" id="transferAmount" name="transferAmount" data-name="transferAmount" value="$!{cmsBondTransferVO.transferAmount}"
                       lay-verify="required" class="layui-input bt-biz-moneyType" data-decimal="0">
            </td>
            ##累计转股数量
            <td class="textRight">#springMessage('table.cmsBond.totalTransferAmount')</td>
            <td>
                <input type="text" id="totalTransferAmount" name="totalTransferAmount" data-name="totalTransferAmount" value="$!{cmsBondTransferVO.totalTransferAmount}"
                       lay-verify="required" class="layui-input bt-biz-moneyType" data-decimal="0">
            </td>
        </tr>
        <tr>
            ##累计转股比例
            <td class="textRight">#springMessage('table.cmsBond.totalTransferRate')</td>
            <td>
                <input  id="totalTransferRate" data-name="totalTransferRate" value="$!{cmsBondTransferVO.totalTransferRate}"
                        class="layui-input bt-biz-rateType" name="totalTransferRate" lay-verify="required">
            </td>
            ##累计转股金额
            <td class="textRight">#springMessage('table.cmsBond.totalTransferMoney')</td>
            <td>
                <input  id="totalTransferMoney" data-name="totalTransferMoney" name="totalTransferMoney" data-decimal="2"
                       lay-verify="required" class="layui-input bt-biz-moneyType" value="$!{cmsBondTransferVO.totalTransferMoney}">
            </td>
        </tr>

        <tr>
            <td colspan="4"style="text-align: center">
                <div class="layui-form-item layui-form-submit ">
                    <div class="layui-input-block">
                        <button class="layui-btn" lay-submit="" id="submit" type="button">#springMessage(
                'common.button.submit')</button>

                            <button class="layui-btn" lay-submit="" id="temp" type="button">#springMessage(
                    'common.button.temp')</button>

                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                        <button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage(
                'common.button.close')</button>
                    </div>
                </div>
            </td>
        </tr>
        </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/bond/editTransfer.edit.js?_btv=${resourceVersion}"></script>
</body>
</html>

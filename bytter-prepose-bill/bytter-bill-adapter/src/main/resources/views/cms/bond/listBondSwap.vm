<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input type="hidden" id="isHistroy" name="isHistroy" value="$!{isHistroy}"/>
<form id="searchForm" class="layui-form" style="display:none;">
    <table class="layui-table">
        <tbody>
        <tr>
            <td>
                <input type="text" id="issueId" name="issueId" value="$!{issueId}"/>
            </td>
        </tr>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsBond.swapDate')</th>
        <th>#springMessage('table.cmsBond.swapPrice')</th>
        <th>#springMessage('table.cmsBond.swapAmount')</th>
        <th>#springMessage('table.cmsBond.totalSwapAmount')</th>
        <th>#springMessage('table.cmsBond.totalSwapMoney')</th>
        <th>#springMessage('table.cmsBond.status')</th>
        #if("$!{isHistroy}" == '0')
            <th>#springMessage('table.cmsBond.operation')</th> #end
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/bond/listBondSwap.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
    ##展期信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsBond.extendMsg')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                    </thead>
                    <colgroup>
                        <col width="15%">
                        <col width="35%">
                        <col width="15%">
                        <col width="35%">
                    </colgroup>
                    <tbody>
                    <tr>
                        <input type="hidden" id="issueId" name="issueId" value="$!{cmsBondExtendVO.issueId}">
                        <input type="hidden" id="extendId" name="id" value="$!{cmsBondExtendVO.id}">
                        ##展期申请日期
                        <td class="textRight" >#springMessage('table.cmsBond.extendApplyDate')</td>
                        <td>
                            <span>$!date.format('yyyy-MM-dd',$!{cmsBondExtendVO.extendApplyDate})</span>
                        </td>
                        ##债券发行编号
                        <td class="textRight" >#springMessage('table.cmsBond.bondIssueNum')</td>
                        <td>
                            <span>$!{cmsBondExtendVO.bondIssueNum}</span>
                        </td>
                    </tr>
                    <tr> ##发行金额
                        <td class="textRight" >#springMessage('table.cmsBond.issueMoney')</td>
                        <td>
                            <span>$!{cmsBondExtendVO.issueMoney}</span>
                        </td>
                        ##未还金额
                        <td class="textRight" >#springMessage('table.cmsPrecative.outstandingAmount')</td>
                        <td>
                            <span>$!{cmsBondExtendVO.outstandingAmount}</span>
                        </td>
                    </tr>
                    <tr> ##展期合同编号
                        <td class="textRight">#springMessage('cms.lease.extend.expendedCode')</td>
                        <td>
                            <span> $!{cmsBondExtendVO.extendCode}</span>
                        </td>
                        ##上次展期/到期日期
                        <td class="textRight">#springMessage('cms.lease.extend.lastExpendedDate')</td>
                        <td>
                            <span>$!{cmsBondExtendVO.lastExtendDate}</span>
                        </td>
                    </tr>
                    <tr>
                        ##展期到期日期
                        <td class="textRight" >#springMessage('table.cmsBond.extendEndDate')</td>
                        <td>
                            <span>$!{cmsBondExtendVO.extendEndDate}</span>
                        </td>
                        ##展期期限
                        <td class="textRight">#springMessage('table.cmsLoanDeferred.deferredLimt')</td>
                        <td>
                            #if($!{cmsBondExtendVO.extendDeadline})
                                <span>$!{cmsBondExtendVO.extendDeadline}
                                    $dictTag.get("remainTerm.unit",${cmsBondExtendVO.deadlineUnit})
                                </span>
                            #end
                        </td>
                    </tr>
                    <tr>
                        ##比例%/BP点数
                        <td class="textRight">#springMessage('cms.lease.extend.pointsProportionSelect')</td>
                        <td>
                            <span>$!rateTag.show($!{cmsBondExtendVO.basicPoint})</span>
                        </td>
                        ##展期利率
                        <td class="textRight">#springMessage('table.cmsLoanSend.deferredRate')(%)</td>
                        <td>
                            <span>$!rateTag.show($!{cmsBondExtendVO.extendRate})</span>
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.cmsBond.rmk')</td>
                        <td colspan="3">
                            <span>$!{cmsBondExtendVO.rmk}</span>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="4"style="text-align: center">
                            <div class="layui-form-item layui-form-submit ">
                                <div class="layui-input-block">
                                    <button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage(
                'common.button.close')</button>
                                </div>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

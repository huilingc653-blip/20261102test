<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
    ##展期信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsBond.extendMsg')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                        <tbody>
                        <tr>
                            <input type="hidden" id="registerId" name="registerId" value="$!{cmsBondExtendVO.registerId}">
                            <input type="hidden" id="issueId" name="issueId" value="$!{cmsBondExtendVO.issueId}">
                            <input type="hidden" id="extendId" name="id" value="$!{cmsBondExtendVO.id}">
                            ##展期申请日期
                            <td class="textRight" >#springMessage('table.cmsBond.extendApplyDate')</td>
                            <td >
                                <div class="layui-input-inline">
                                    <input type="text" id="extendApplyDate" name="extendApplyDate" data-biz-name="startDate"
                                           data-type="date" data-today="true" class="layui-input bt-biz-dateType"
                                           value="$!date.format('yyyy-MM-dd',$!cmsBondExtendVO.extendApplyDate)" data-callback="setStartTerm">
                                </div>
                            </td>
                            ##债券发行编号
                            <td class="textRight" >#springMessage('table.cmsBond.bondIssueNum')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" name="bondIssueNum" id="bondIssueNum" data-biz-name="bondIssueNum" lay-verify="required"
                                           value="$!{cmsBondExtendVO.bondIssueNum}"
                                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsBond.bondIssueNum')">
                                    <table id="bondIssueNumTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.cmsBond.bondIssueNum')</th>
                                            <th>#springMessage('table.cmsBond.issueMoney')</th>
                                            <th>#springMessage('table.cmsBond.rmbIssueTotal')</th>
                                            <th>#springMessage('table.cmsBond.issueStartDate')</th>
                                            <th>#springMessage('table.cmsBond.issueEndDate')</th>
                                            <th>#springMessage('table.cmsBond.issuePrice')</th>
                                            <th>#springMessage('table.cmsBond.rmk')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </div>
                            </td>

                        </tr>
                        <tr>
                            ##发行金额
                            <td class="textRight" >#springMessage('table.cmsBond.issueMoney')</td>
                            <td >
                                <div class="layui-input-inline">
                                    <input type="text" id="issueMoney" data-name="issueMoney" data-biz-name="issueMoney"
                                           data-maxlength="20" data-decimal="2" data-minus="false"
                                           class="layui-input bt-biz-moneyType" value="$!{cmsBondExtendVO.issueMoney}">
                                </div>
                            </td>
                            ##未还金额
                            <td class="textRight" >#springMessage('table.cmsPrecative.outstandingAmount')</td>
                            <td >
                                <div class="layui-input-inline">
                                    <input type="text" id="outstandingAmount" data-name="outstandingAmount" data-biz-name="outstandingAmount"
                                           data-maxlength="20" data-decimal="2" data-minus="false"
                                           class="layui-input bt-biz-moneyType" value="$!{cmsBondExtendVO.outstandingAmount}">
                                </div>
                                <div class="layui-inline">
                                    <!-- 还款计划 -->
                                    <!-- 利息预计明细 -->
                                    <button class="layui-btn" type="button" onclick="repayInterest();">#springMessage(
                            'cms.button.repayPlan')</button>
                                    <input id="planDtlId" name="planDtlId" type="hidden"
                                           value="$!{cmsBondPayVo.planDtlId}">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##展期合同编号
                            <td class="textRight">#springMessage('cms.lease.extend.expendedCode')</td>
                            <td>
                                <input type="text" id="extendCode" name="extendCode"
                                       data-name="totalSwapAmount" value="$!{cmsBondExtendVO.extendCode}"
                                       class="layui-input" >
                            </td>
                            ##上次展期/到期日期
                            <td class="textRight">#springMessage('cms.lease.extend.lastExpendedDate')</td>
                            <td>
                                <input type="text" id="lastExtendDate" name="lastExtendDate"
                                       data-type="date" class="layui-input" readonly = readonly
                                       value="$!{lastExtendDate}">
                            </td>
                        </tr>
                        <tr>
                            ##展期到期日期
                            <td class="textRight" >#springMessage('table.cmsBond.extendEndDate')</td>
                            <td >
                                <div class="layui-input-inline">
                                    <input type="text" id="extendEndDate" name="extendEndDate" data-biz-name="endDate"
                                           data-type="date" lay-verify="required" data-callback="setTerm" class="layui-input bt-biz-dateType"
                                            #if($!{lastExtendDate})
                                               data-min="$!{lastExtendDate}"
                                            #end
                                           value="$!date.format('yyyy-MM-dd',$!cmsBondExtendVO.extendEndDate)">
                                </div>
                            </td>
                            ##展期期限
                            <td class="textRight">#springMessage('table.cmsLoanDeferred.deferredLimt')</td>
                            <td>
                                <div class="layui-inline">
                                    <input type="text" id="extendDeadline" name="extendDeadline"
                                           data-name="extendDeadline" value="$!{cmsBondExtendVO.extendDeadline}"
                                           class="layui-input" data-decimal="0" readonly="readonly">
                                </div>
                                <div class="layui-inline">
                                    <div class="bt-biz-dict" data-width="80px" data-name="deadlineUnit" data-type="select" data-biz-name="deadlineUnit"
                                         data-group="remainTerm.unit" data-callback="setTerm"
                                         #if($!{cmsBondExtendVO.deadlineUnit})
                                         data-defaultvalue="$!{cmsBondExtendVO.deadlineUnit}"
                                         #else
                                         data-defaultvalue="M"
                                         #end
                                         ></div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##比例%/BP点数
                            <td class="textRight">#springMessage('cms.lease.extend.pointsProportionSelect')</td>
                            <td>
                                <input type="text" id="basicPoint" name="basicPoint"
                                       data-name="basicPoint" value="$!{cmsBondExtendVO.basicPoint}"
                                       lay-verify="required" class="layui-input bt-biz-rateType" data-decimal="0">
                            </td>
                            ##展期利率
                            <td class="textRight">#springMessage('table.cmsLoanSend.deferredRate')(%)</td>
                            <td>
                                <input type="text" id="extendRate" name="extendRate"
                                       data-name="extendRate" value="$!{cmsBondExtendVO.extendRate}"
                                       lay-verify="required" class="layui-input bt-biz-rateType" data-decimal="0">
                            </td>
                        </tr>
                        <tr>
                            ##备注
                            <td class="textRight">#springMessage('table.cmsBond.rmk')</td>
                            <td colspan="3">
                                <input type="text" id="rmk" name="rmk" data-name="rmk"
                                       value="$!{cmsBondExtendVO.rmk}"
                                          class="layui-textarea" >
                            </td>
                        </tr>

                        <tr>
                            <td colspan="4" style="text-align: center">
                                <div class="layui-form-item layui-form-submit ">
                                    <div class="layui-input-block">
                                        <button class="layui-btn" lay-submit="" id="submit" type="button">#springMessage(
                    'common.button.submit')</button>

                                        <button class="layui-btn" lay-submit="" id="temp" type="button">#springMessage(
                        'common.button.temp')</button>

                                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                            'common.button.reset')</button>
                                        <button class="layui-btn" type="button"
                                                onClick="javascript:bt.navtab.closeCurrent();">#springMessage(
                    'common.button.close')</button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/bond/editBondExtend.edit.js?_btv=${resourceVersion}"></script>
</body>
</html>

</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsBond.bondIssueNum')</th>
        <th>#springMessage('table.cmsBond.leadUnderwriter')</th>
        <th>#springMessage('table.cmsBond.batchNo')</th>
        <th>#springMessage('table.cmsBond.issueMoney')</th>
        <th>#springMessage('table.cmsBond.rmbIssueTotal')</th>
        <th>#springMessage('table.cmsBond.startDate')</th>
        <th>#springMessage('table.cmsBond.dueDate')</th>
        <th>#springMessage('table.cmsBond.issueStartDate')</th>
        <th>#springMessage('table.cmsBond.issueEndDate')</th>
        <th>#springMessage('table.cmsBond.issuePrice')</th>
        <th>#springMessage('table.cmsBond.rmk')</th>
        <th>#springMessage('table.cmsBond.status')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")

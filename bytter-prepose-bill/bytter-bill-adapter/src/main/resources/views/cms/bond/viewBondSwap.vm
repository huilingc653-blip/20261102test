<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
    ##可交债信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <thead>
                    <tr>
                        ##可交债信息
                        <td colspan="4" align="center"><strong>#springMessage("table.cmsBond.swap")</strong></td>
                    </tr>
                    </thead>
                    <colgroup>
                        <col width="15%">
                        <col width="35%">
                        <col width="15%">
                        <col width="35%">
                    </colgroup>
                    <tbody>
                    <tr>
                        <input type="hidden" id="issueId" name="issueId" value="$!{cmsBondSwapVO.issueId}">
                        <input type="hidden" id="swapId" name="id" value="$!{cmsBondSwapVO.id}">
                        <td class="textRight">#springMessage('table.cmsBond.swapDate')</td>
                        <td>
                            <span>$!date.format('yyyy-MM-dd',$!cmsBondSwapVO.swapDate)</span>
                        </td>
                        ##换股价
                        <td class="textRight">#springMessage('table.cmsBond.swapPrice')转股价</td>
                        <td>
                            <span>$!{cmsBondSwapVO.swapPrice}</span>
                        </td>
                    </tr>
                    <tr>
                        ##换股数量
                        <td class="textRight">#springMessage('table.cmsBond.swapAmount')</td>
                        <td>
                            <span>$!{cmsBondSwapVO.swapAmount}</span>
                        </td>
                        ##累计换股数量
                        <td class="textRight">#springMessage('table.cmsBond.totalSwapAmount')</td>
                        <td>
                            <span>$!{cmsBondSwapVO.totalSwapAmount}</span>
                        </td>
                    </tr>
                    <tr>
                        ##累计换股金额
                        <td class="textRight">#springMessage('table.cmsBond.totalSwapMoney')</td>
                        <td>
                            <span>$!{cmsBondSwapVO.totalSwapMoney}</span>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    <tr>
                        <td colspan="4" style="text-align: center">
                            <div class="layui-form-item layui-form-submit ">
                                <div class="layui-input-block">
                                    <button class="layui-btn" type="button"
                                            onClick="javascript:bt.navtab.closeCurrent();">#springMessage(
                'common.button.close')</button>
                                </div>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

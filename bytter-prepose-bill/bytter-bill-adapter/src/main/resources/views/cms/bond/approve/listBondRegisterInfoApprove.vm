<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
    <table class="layui-table">
        <tbody>
        <tr>
            ##债券类型
            <td class="textRight">#springMessage('table.cmsBond.bondType')</td>
            <td >
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_typeId" data-biz-name="eqs_typeId" data-inputValue="false"
                         data-url="${basePath}/cms/bond/type/listValidBondType" data-valuefield="id"
                         data-textfield="bondName"></div>
                </div>
            </td>
            ##发行人/债务人
            <td class="textRight" >#springMessage('table.cmsBond.bondIssuer')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-type="selectTree" data-name="eqs_corpId" data-resource="sys:flow:query:corpop" data-scope="all"></div>
                </div>
            </td>
            ##债券代码
            <td class="textRight" >#springMessage('table.cmsBond.bondCode')</td>
            <td >
                <input type="text"  name="likes_bondCode" autocomplete="off"
                       class="layui-input"/>
            </td>
        </tr>
        <tr>
            ##债券全称
            <td class="textRight" >#springMessage('table.cmsBond.bondFullName')</td>
            <td >
                <input type="text"  name="likes_bondFullName" autocomplete="off"
                       class="layui-input"/>
            </td>
            ##币种
            <td  class="textRight">#springMessage('table.cmsLease.oriCur')</td>
            <td >
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_bondCur" data-biz-name="eqs_bondCur" data-inputValue="false"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName"></div>
                </div>
            </td>
            ##租金金额
            <td class="textRight">#springMessage('table.cmsBond.issueCurTotal')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="geg_issueCurTotal"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_issueCurTotal"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" id="t20">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsBond.bondType')</th>
        <th>#springMessage('table.cmsBond.bondIssuer')</th>
        <th>#springMessage('table.cmsBond.bondCode')</th>
        <th>#springMessage('table.cmsBond.bondFullName')</th>
        <th>#springMessage('table.cmsBond.bondShortName')</th>
        <th>#springMessage('table.cmsBond.bondDeadline')</th>
        <th>#springMessage('table.cmsBond.bondCur')</th>
        <th>#springMessage('table.cmsBond.issueCurMoney')</th>
        <th>#springMessage('table.cmsBond.issueRmbMoney')</th>
        <th>#springMessage('table.cmsBond.purpose')</th>
        <th>#springMessage('table.cmsBond.rmk')</th>
        <th>#springMessage('table.cmsBond.operation')</th>
    </tr>
    </thead>
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
</body>

<script>
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts", "corp","dateType"], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        selectType = bt.selectType.init();
        bt.dateType.init();//日期时间
        bt.moneyType.init();
        corp = bt.corp.init();//单位

        /**
         * 生成列表
         */
        datatable = bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            checkbox: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search",
                isInitData:"false"
            },
            ajax: {
                'url': basePath + "/cms/bond/register/dataTableApprove"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            fixedColumns: {
                rightColumns: 2//代表冻结右边一列
            },
            columns: [
                {data:"bondTypeName",bSortable:true},
                {data:"corpName",bSortable:true},
                {data:"bondCode",bSortable:true},
                {data:"bondFullName",bSortable:true},
                {data:"bondShortName",bSortable:true},
                {data:"bondDeadline",bSortable:true,className:'textRight',
                    render: function ( data, type, full, meta ) {
                        return data + bt.dict("remainTerm.unit", full.deadlineUnit);
                    }
                },
                {data:"bondCurName",bSortable:true},
                {data:"issueCurTotal",bSortable:true,className:'textRight',
                    render: function ( data, type, full, meta ) {
                        return bt.money.format(full.issueCurTotal);
                    }
                },
                {data:"issueRmbTotal",bSortable:true,className:'textRight',
                    render: function ( data, type, full, meta ) {
                        return bt.money.format(full.issueRmbTotal);
                    }
                },
                {data:"purpose",bSortable:true},
                {data:"rmk",bSortable:true},
                {data:null,bSortable:false,className:'center',
                    render: function (data, type, full, meta) {
                        var html='';
                        if($("#flowStatus").val()=='todo'){
                            html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
                        }
                        html += '<a class="" href="#" data-row="'+meta.row+'" onclick="bt.workFlow.trackFlow(\''+full.processInstanceId+'\')">'+bt.lang("common.button.trackFlow")+'</a>';
                        return html;
                    }
                }
            ]
        });
    });


    /*审核*/
    function approve(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.approve') ,basePath + "/cms/bond/register/approve?businessId=" + data.id + "&taskId=" + data.taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/bond/register/approve?businessId=" + data.id + "&taskId=" + data.taskId
        });
    }

</script>
</html>

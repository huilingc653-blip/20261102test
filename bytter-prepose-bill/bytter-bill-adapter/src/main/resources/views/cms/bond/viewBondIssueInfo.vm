<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input id="id" name="id" type="hidden" value="$!{issueInfo.id}">
    ## 发行主信息
    <table class="layui-table">
        <thead>
        <tr><td colspan="4" align="center"><strong>#springMessage('table.cmsBond.issueMainMsg')</strong></td></tr>
        </thead>
        <colgroup>
            <col width="15%">
            <col width="35%">
            <col width="15%">
            <col width="35%">
        </colgroup>
        <tbody>
        <tr>
            ## 债券发行编号
            <td class="textRight">#springMessage('table.cmsBond.bondIssueNum')</td>
            <td>
                <span>$!{issueInfo.bondIssueNum}</span>
            </td>
            ## 批次
            <td class="textRight">#springMessage('table.cmsBond.batchNo')</td>
            <td>
                <span>$!{issueInfo.batchNo}</span>
            </td>
        </tr>
        <tr>
            ## 主承销商
            <td class="textRight">#springMessage('table.cmsBond.leadUnderwriter')</td>
            <td>
                <span>$!{issueInfo.leadUnderwriter}</span>
            </td>
            ## 发行金额
            <td class="textRight">#springMessage('table.cmsBond.issueMoney')</td>
            <td>
                <span>$number.formatNumeric($!{issueInfo.issueMoney})</span>
            </td>
        </tr>
        <tr>
            ## 起息日
            <td class="textRight">#springMessage('table.cmsBond.startDate')</td>
            <td>
                <span>
                    $!date.format('yyyy-MM-dd',$!issueInfo.startDate)
                </span>
            </td>
            ##实际发行总额（折合人民币）
            <td class="textRight">#springMessage('table.cmsBond.rmbIssueTotal')</td>
            <td>
                <span>$number.formatNumeric($!{issueInfo.rmbIssueTotal})</span>
            </td>
        </tr>
        <tr>
            ## 到期兑付日
            <td class="textRight">#springMessage('table.cmsBond.dueDate')</td>
            <td>
                <span>
                    $!date.format('yyyy-MM-dd',$!issueInfo.dueDate)
                </span>
            </td>
            ## 还款方式
            <td class="textRight">#springMessage('table.cmsLoanRepay.repayway')</td>
            <td>
                $!dictTag.get("Provide.RepayType",$!{issueInfo.repayType})
            </td>
        </tr>
        <tr>
            ## 发行开始日
            <td class="textRight">#springMessage('table.cmsBond.issueStartDate')</td>
            <td>
                <span>
                    $!date.format('yyyy-MM-dd',$!issueInfo.issueStartDate)
                </span>
            </td>
            ## 发行结束日
            <td class="textRight">#springMessage('table.cmsBond.issueEndDate')</td>
            <td>
                <span>
                    $!date.format('yyyy-MM-dd',$!issueInfo.issueEndDate)
                </span>
            </td>
        </tr>
        <tr>
            ## 分销开始日
            <td class="textRight">#springMessage('table.cmsBond.assignStartDate')</td>
            <td>
                <span>
                    $!date.format('yyyy-MM-dd',$!issueInfo.assignStartDate)
                </span>
            </td>
            ## 分销结束日
            <td class="textRight">#springMessage('table.cmsBond.assignEndDate')</td>
            <td>
                <span>
                    $!date.format('yyyy-MM-dd',$!issueInfo.assignEndDate)
                </span>
            </td>
        </tr>
        <tr>
            ## 公告日
            <td class="textRight">#springMessage('table.cmsBond.announcementDate')</td>
            <td>
                <span>
                    $!date.format('yyyy-MM-dd',$!issueInfo.announcementDate)
                </span>
            </td>
            ## 承销缴款日
            <td class="textRight">#springMessage('table.cmsBond.paymentDate')</td>
            <td>
                <span>
                    $!date.format('yyyy-MM-dd',$!issueInfo.paymentDate)
                </span>
            </td>
        </tr>
        <tr>
            ## 发行价格
            <td class="textRight">#springMessage('table.cmsBond.issuePrice')</td>
            <td>
                #if($!{issueInfo.issuePrice})
                    <span>$number.formatNumeric($!{issueInfo.issuePrice})</span>
                #end
            </td>

            ## 发行范围
            <td class="textRight">#springMessage('table.cmsBond.issueScope')</td>
            <td>
                #if($!{issueScopeList})
                    #foreach($issueScope in $issueScopeList)
                        #if( $!{velocityCount} eq '1')
                            $!dictTag.get("CMS_BOND_ISSUE_SCOPE",$!{issueScope})
                        #else
                            ,$!dictTag.get("CMS_BOND_ISSUE_SCOPE",$!{issueScope})
                        #end
                    #end
                #end
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
            <td colspan="3">
                <textarea style="min-height:70px"  class="layui-textarea" readonly="readonly">$!{issueInfo.issueRmk}</textarea>
            </td>
        </tr>
        </tbody>

    </table>
    ## 利率信息
    <table class="layui-table">
        <thead>
        <tr><td colspan="4" align="center"><strong>#springMessage('table.cmsBond.rateMessage')</strong></td></tr>
        </thead>
        <colgroup>
            <col width="15%">
            <col width="35%">
            <col width="15%">
            <col width="35%">
        </colgroup>
        <tbody>
        <tr>
            ## 计息方式
            <td class="textRight">#springMessage('table.cmsLoanInfo.interestWay')</td>
            <td>
                <span>$!dictTag.get("CMS_BOND_ISSUE_INTEREST_WAY",$!{issueInfo.calcuInterestType})</span>
            </td>
            ## 浮动/固定
            <td class="textRight">#springMessage('table.cmdBond.isFloat')</td>
            <td>
                <span>$!dictTag.get("CMS_BOND_FLOAT_TYPE",$!{issueInfo.isFloat})</span>
            </td>
        </tr>
        <tr>
            ## 报价日期
            <td class="textRight">#springMessage('table.cmsBond.quoteDate')</td>
            <td>
                <span>$!date.format('yyyy-MM-dd',$!issueInfo.quoteDate)</span>
            </td>
            ## 利息年度天数
            <td class="textRight">#springMessage('table.cmsBond.interestYearDays')</td>
            <td>
                <span>$!dictTag.get("Cms.RateBase",$!{issueInfo.interestYearDays})</span>
                #if($!{issueInfo.interestYearDays} eq '360')
                    <span>$!dictTag.get("CMS_BOND_INTEREST_DAYS",$!{issueInfo.interestDays})</span>
                #else
                     #if($!{issueInfo.isLeapYear} eq '0')
                         <span>$!dictTag.get("CMS_BOND_LEAP_YEAR_TYPE",$!{issueInfo.isLeapYear})</span>
                         <span>$!dictTag.get("CMS_BOND_LEAP_IS_INTEREST",$!{issueInfo.leapIsInterest})</span>
                     #else
                         <span>$!dictTag.get("CMS_BOND_LEAP_YEAR_TYPE",$!{issueInfo.isLeapYear})</span>
                     #end
                #end
            </td>
        </tr>
        <tr>
            ## 定价基准
            <td class="textRight">#springMessage('table.cmsBond.fixPriceBase')</td>
            <td>
                <span>
                    $!{tbBaseRate.baseTypeName}
                </span>
            </td>
            ## 利率期限
            <td class="textRight">#springMessage('table.cmsLease.repayCycle')</td>
            <td>
                <span>
                    $!{tbCreditPeriod.periodName}
                </span>
            </td>
        </tr>
        <tr>
            ## 基准利率
            <td class="textRight">#springMessage('table.tbLoanRateMaintence.rate')</td>
            <td>
                $!rateTag.show($!{issueInfo.baseRate})
            </td>
            ## 比例%/bp点数
            <td class="textRight">#springMessage('cms.lease.extend.pointsProportionSelect')</td>
            <td>
                $!rateTag.show($!{issueInfo.basicPoint})
            </td>
        </tr>
        <tr>
            ## 票面利率
            <td class="textRight">#springMessage('df.coupon.rate')</td>
            <td>
                $!rateTag.show($!{issueInfo.faceValueRate})
            </td>
            ## 付息日
            <td class="textRight">#springMessage('table.cmsBond.payDate')</td>
            <td>
                <span>
                    $!date.format('yyyy-MM-dd',$!issueInfo.payDate)
                </span>
            </td>
        </tr>
        <tr>
            ## 付息频率
            <td class="textRight">#springMessage('table.cmsLease.interestFre')</td>
            <td>
                <span>$!dictTag.get("CMS_BOND_PAY_FREQUENCY",$!{issueInfo.payFrequency})</span>
            </td>
            ## 利息分配方式
            <td class="textRight">#springMessage('table.cmsBond.assignType')</td>
            <td>
                <span>$!dictTag.get("CMS_BOND_ASSIGN_TYPE",$!{issueInfo.assignType})</span>
            </td>
        </tr>
        <tr>
            ## 发行时利差
            <td class="textRight">#springMessage('table.cmsBond.spreadIssue')</td>
            <td>
                <span>
                    $!rateTag.show($!{issueInfo.spreadIssue})
                </span>
            </td>
            ## 利率上限
            <td class="textRight">#springMessage('table.tbLoanRateMaintence.rateUpLimit')</td>
            <td>
                <span>
                    $!rateTag.show($!{issueInfo.upperLimitRate})
                </span>
            </td>
        </tr>
        <tr>
            ## 保底利率
            <td class="textRight">#springMessage('table.cmsBond.lowestRate')</td>
            <td>
                <span>
                    $!rateTag.show($!{issueInfo.lowestRate})
                </span>
            </td>
            ## 基准利率生效方式
            <td class="textRight">#springMessage('table.cmsBond.rateEffectType')</td>
            <td>
                <span>$!dictTag.get("CMS_BOND_RATE_EFFECT_TYPE",$!{issueInfo.rateEffectType})</span>
            </td>
        </tr>
        <tr>
            ## 生效时期
            <td class="textRight">#springMessage('table.cmsBond.effectPeriod')</td>
            <td>
                <span>$!dictTag.get("CMS_BOND_EFFECT_PERIOD",$!{issueInfo.effectPeriod})</span>
            </td>
            ## 生效条件
            <td class="textRight">#springMessage('table.cmsBond.effectCondition')</td>
            <td>
                <span>$!dictTag.get("CMS_BOND_EFFECT_CONDITION",$!{issueInfo.effectCondition})</span>
            </td>
        </tr>
        <tr>
            ##说明
            <td class="textRight">#springMessage('table.nisExpenseDetail.rmk')</td>
            <td colspan="3">
                <textarea style="min-height:70px"  class="layui-textarea" readonly="readonly">$!{issueInfo.interestRmk}</textarea>
            </td>
        </tr>
        </tbody>

    </table>
    ## 第三方费用信息
    <table class="layui-table">
        <thead>
        <tr><td colspan="4" align="center"><strong>#springMessage('table.cmsProvideLoan.chargeMessage')</strong></td></tr>
        </thead>
        <colgroup>
            <col width="15%">
            <col width="35%">
            <col width="15%">
            <col width="35%">
        </colgroup>
        <tbody>
        <tr>
            <td colspan="4" align="center" width="80">
                <table id="dataTable" class="layui-table">
                    <thead>
                    <th width="25%">#springMessage('table.fcChargeRule.fcChargeType')</th>##费用类型
                    <th width="25%"> #springMessage('table.guaGuarantee.handleRate')</th>##费率
                    <th width="25%">#springMessage('table.cms.projected.expemditure')</th>##预计费用
                    </thead>
                    <tbody>
                        #if($costVOS.size() > 0)
                            #foreach($detail in $!{costVOS})
                                #set($vcount = $velocityCount - 1)
                                #set($velocityCount = $costVOS.size() - 1)
                            <tr>
                                <td align="center">
                                    <input type="text" style="text-align: center;" value="$!{detail.costName}" disabled="true" class="layui-input">
                                </td>

                                <td align="center">##费率
                                    <input type="text" style="text-align: right;" value="$!rateTag.show($!{detail.rate})" disabled="true" class="layui-input">
                                </td>

                                <td align="center">##预计费用
                                    <input type="text" style="text-align: right;"  value="$!number.formatNumeric($!{detail.advanceFees})" disabled="true" class="layui-input">
                                </td>

                            </tr>
                            #end
                        #end
                    </tbody>
                </table>
            </td>
        </tr>
        <tbody>
    </table>
    ##其他业务挂接信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.otherBusMessage')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <tbody>

                        #if(${issueInfo.isHookBail}=="1")
                            ##增加保证金相关信息
                        <h2 class="layui-colla-title">#springMessage('table.fcBond.BondMsg')</h2>
                            #set($fcBondApplyDTO=$fcBondTag.getBondApplyDetail(${issueInfo.id},${issueInfo.bondIssueNum}))
                            #set($fcBondRate=($!{issueInfo.bondRate}))
                            #set($fromType='cmsBond')
                            #parse("views/common/viewFcBondDetail.vm")
                        #end


                        ##担保挂接
                        #if(${issueInfo.isHookGuarantee}=="1")
                        <h2 class="layui-colla-title">#springMessage('table.guaContract.ContractMsg')</h2>
                            #set($guaContractUseDTO=$guaContractTag.getGuaContractOccupyDetail($!{issueInfo.id},$!{issueInfo.bondIssueNum}))
                            #if($!{guaContractUseDTO})
                                #parse("views/common/guaContractDetail.vm")
                            #end
                        #end
                        ##抵质押物挂接
                        #if(${issueInfo.isHookPledge}=="1")
                        <h2 class="layui-colla-title">#springMessage('table.cmsLease.guaPledgeTag')</h2>
                            #set($pledgeList=$guaPledgeTag.getPledgeOccupy($!{issueInfo.id},$!{issueInfo.bondIssueNum}))
                            #if($!{pledgeList})
                                #parse("views/cms/guarantee/viewPledgeList.vm")
                            #end
                        #end

                    <tr>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input id="annexName" name="uploadId" type="hidden" value="$!{issueInfo.attachmentId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </div>
    <!-- 日志 -->
    #if(!$!{taskId})
        <div id="tagMsg"></div>
        <table class="layui-table">
            <tr>
                <td colspan="4" align="center">
                    <button class="layui-btn"  onClick="doClose()">#springMessage('common.button.close')</button>
                    #if($!{issueInfo.status} eq '0'||$!{issueInfo.status} eq '11'||$!{issueInfo.status} eq '-1')##待审批和审批打回时可查看审批流程
                        <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{issueInfo.id}')">#springMessage('common.button.trackFlow')</button>
                    #end
                </td>
            </tr>
        </table>
    #end

</form>

    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form','btUpload','moneyType'], function() {
        $ = bt.jquery,form = bt.form();
        bt.moneyType.init();
        var gid = $("#annexName").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gid
        });


        //关闭窗口
        doClose = function(){
            if(bt.navtab){
                bt.navtab.closeCurrent();
            }
        };

        /**
         * 生成日志列表
         * @return
         */
        $genMsgHtml = function () {
            var billCode = $("#id").val();
            var url = basePath + "/cms/basedata/cmsprocessmsg/list/" + billCode;
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                    form.render();
                }
            });
        }
        $genMsgHtml();
    });
</script>
</html>

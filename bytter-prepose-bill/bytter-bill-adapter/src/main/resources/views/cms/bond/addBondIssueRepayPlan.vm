<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab-content" style="width: 100%; height: 100%">
    <form class="layui-form" method="post">
        <table class="layui-table  breakRow">
            <input type="hidden" data-name="issueStartDate" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!issueInfo.issueStartDate)"
                   data-type="date" data-biz-name="issueStartDate">
            <input type="hidden" data-name="issueEndDate" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!issueInfo.issueEndDate)"
                   data-type="date" data-biz-name="issueEndDate">
            <thead>
            <tr>
                ##债券主信息
                <td colspan="10" align="center">#springMessage('cms.cmsBond.registerInfo')</td>
            </tr>
            </thead>
            <tbody>
            <tr>
                ## 债券类型
                <td class="textRight" width="14%">#springMessage('table.cmsBond.bondType')</td>
                <td width="36%">
                    <span>$!{cmsBondRegisterInfoVo.bondTypeName}</span>
                </td>
                ## 境内境外
                <td class="textRight">#springMessage('table.cmsBond.isDomestic')</td>
                <td width="36%">
                    #if($!{cmsBondRegisterInfoVo.isDomestic} eq '1')
                        <span>境内</span>
                    #else
                        <span>境外</span>
                    #end
                </td>
            </tr>
            <tr>
                ## 发行人/债务人
                <td class="textRight">#springMessage('table.cmsBond.bondIssuer')</td>
                <td>
                    <span>$!{cmsBondRegisterInfoVo.corpName}</span>
                </td>
                ## 债券全称
                <td class="textRight">#springMessage('table.cmsBond.bondFullName')</td>
                <td>
                    <span>$!{cmsBondRegisterInfoVo.bondFullName}</span>
                </td>
            </tr>
            <tr>
                ## 发行批文名称
                <td class="textRight">#springMessage('table.cmsBond.issueName')</td>
                <td>
                    <span>$!{cmsBondRegisterInfoVo.issueName}</span>
                </td>
                ## 批准文号
                <td class="textRight">#springMessage('table.cmsBond.approvalNumber')</td>
                <td>
                    <span>$!{cmsBondRegisterInfoVo.approvalNumber}</span>
                </td>
            </tr>
            <tr>
                ## 债券代码
                <td class="textRight">#springMessage('table.cmsBond.bondCode')</td>
                <td>
                    <span>$!{cmsBondRegisterInfoVo.bondCode}</span>
                </td>
                ## 债券简称
                <td class="textRight">#springMessage('table.cmsBond.bondShortName')</td>
                <td>
                    <span>$!{cmsBondRegisterInfoVo.bondShortName}</span>
                </td>
            </tr>
            <tr>
                ## 债券期限
                <td class="textRight">#springMessage('table.cmsBond.bondDeadline')</td>
                <td>
                    <div class="layui-inline">
                        <span>$!{cmsBondRegisterInfoVo.bondDeadline}</span>
                    </div>
                    <div class="layui-inline">
						<span>
                            $!dictTag.get("remainTerm.unit",${cmsBondRegisterInfoVo.deadlineUnit})
                        </span>
                    </div>
                </td>
                ## 债券原币币种
                <td class="textRight">#springMessage('table.cmsBond.bondOriCur')</td>
                <td>
                    <span>$!{cmsBondRegisterInfoVo.bondCurName}</span>
                </td>
            </tr>
            <tr>
                ## 计划发行原币总额
                <td class="textRight">#springMessage('table.cmsBond.issueCurTotal')</td>
                <td>
                <span>
                    $number.formatNumeric($!{cmsBondRegisterInfoVo.issueCurTotal})
                </span>
                </td>
                ## 计划发行人民币总额
                <td class="textRight">#springMessage('table.cmsBond.issueRmbTotal')</td>
                <td>
                <span>
                    $number.formatNumeric($!{cmsBondRegisterInfoVo.issueRmbTotal})
                </span>
                </td>
            </tr>
            <tr>
                ## 债券信用评级
                <td class="textRight">#springMessage('table.cmsBond.bondCreditRate')</td>
                <td>
                    <span>$!{cmsBondRegisterInfoVo.bondCreditRate}</span>
                </td>
                ## 发行人信用评级
                <td class="textRight">#springMessage('table.cmsBond.debtorCreditRate')</td>
                <td>
                    <span>$!{cmsBondRegisterInfoVo.debtorCreditRate}</span>
                </td>
            </tr>
            <tr>
                ## 可转换开始日
                <td class="textRight">#springMessage('table.cmsBond.convertStartDate')</td>
                <td>
                <span>
                    $!date.format('yyyy-MM-dd',$!cmsBondRegisterInfoVo.convertStartDate)
                </span>
                </td>
                ## 可转换结束日
                <td class="textRight">#springMessage('table.cmsBond.convertEndDate')</td>
                <td>
                <span>
                    $!date.format('yyyy-MM-dd',$!cmsBondRegisterInfoVo.convertEndDate)</span>
                </td>
            </tr>
            <tr>
                ## 转换比例
                <td class="textRight">#springMessage('table.cmsBond.convertRate')</td>
                <td>
                    <span>$rateTag.show($!{cmsBondRegisterInfoVo.convertRate}) </span>
                </td>
                ## 融资用途
                <td class="textRight">#springMessage('table.cmsBond.purpose')</td>
                <td>
                    <span>$!{cmsBondRegisterInfoVo.purpose}</span>
                </td>
            </tr>
            <tr>
                ##备注
                <td class="textRight">#springMessage('table.cmsBond.rmk')</td>
                <td colspan="3">
                    <div class="layui-input-inline">
                        $!{cmsBondRegisterInfoVo.rmk}
                    </div>
                </td>
            </tr>
            </tbody>
        </table>

        <table class="layui-table self-adaption" style="margin-bottom:8px">
            <thead>
            <tr>
                <td colspan="10" align="center">#springMessage('cms.cmsBond.repayPlan')</td>
            </tr>
            <input type="hidden" id="registerId" name="registerId" value="$!{cmsBondRegisterInfoVo.id}">##债券主表id
            <input type="hidden" id="planId" name="planId" value="$!{cmsBondRepayPlanVo.id}">##债券还款计划id
            <input type="hidden" id="issueId" name="issueId" value="$!{cmsBondIssueInfoVo.id}">##债券发行id
            <input type="hidden" id="corpId" name="corpId" value="$!{cmsBondRegisterInfoVo.corpId}">##还款单位
            <input type="hidden" id="beginDate" name="beginDate" value="$!{cmsBondRegisterInfoVo.beginDate}">##发行日
            <input type="hidden" id="endDate" name="endDate" value="$!{cmsBondRegisterInfoVo.endDate}">##到期日
            <input type="hidden" id="orig_repayType" value="$!{cmsBondRepayPlanVo.repayType}">##还款方式
            <input type="hidden" id="isSave" name="isSave" value="$!{cmsBondRepayPlanVo.isSave}">##还款计划是否保存操作
            <input type="hidden" id="status" name="status" value="$!{cmsBondRepayPlanVo.status}">##还款计划状态
            </thead>
            <tbody>
            <tr style="display: none">
                <td width="3%"></td>
                <td align="right" width="10%">#springMessage('table.RepaymentSchedule.beginDate')</td>
                <td width="10%">
                    <input id="repayStartDate" disabled data-min="$!{cmsBondRegisterInfoVo.beginDate}"
                           data-max="$!{cmsBondRegisterInfoVo.beginDate}"
                           name="repayStartDate" class="layui-input bt-biz-dateType" data-type="date"
                        #if($!{cmsBondRepayPlanVo.repayType} == "07")
                            ## 自定义时还款计划 则还款开始日期为空
                           readonly="readonly"
                        #end
                        #if($!{cmsBondRepayPlanVo.repayType} != "07")
                            ## 自定义时还款计划 则还款开始日期为空
                           value="$!{cmsBondRegisterInfoVo.beginDate}"
                        #end
                           data-callback="beginDateChange" data-biz-name="repayStartDate">
                </td>
                ##还款方式
                <td class="textRight" width="10%">#springMessage('cms.RepaymentSchedule.repayTypeMsg')</td>
                <td width="10%">
                    <div class="layui-inline">
                        <div class="bt-biz-dict" id="repayType" data-name="repayType" data-biz-name="repayType"
                             data-type="select"
                             data-group="Provide.RepayType" data-defaultvalue="$!{cmsBondRepayPlanVo.repayType}"
                            #if($!{cmsBondRepayPlanVo.repayType} == "07")
                                ##							 自定义时还款计划不允许更改还款方式
                             data-displayData="07"
                            #end
                             data-callback="repayTypeChange" data-initCallback="repayTypeChange"></div>
                    </div>
                </td>
                <td align="right" width="10%">#springMessage('table.RepaymentSchedule.cycle')</td>
                <td colspan="3" width="30%">
                    <div class=layui-form>
                        <div class=bt-biz-dict data-type="radio" data-callback="cycleChange" data-name="repayCycel"
                            #if($!{cmsBondRepayPlanVo.repayType} == "07")
                                ##							 自定义时还款计划计划还款周期不允许选择
                             data-disabled="true" data-defaultvalue="$!{cmsBondRepayPlanVo.repayCycel}"
                            #end
                             data-biz-name="repayCycel" data-group="Repayment.cycle"></div>
                    </div>
                </td>
                ##<td align="center" colspan="3" width="37%">
                ##<button class="layui-btn" lay-submit="false" type="button" id="addRow">新增行</button>
                ##</td>
            </tr>
            <tr>
                ##债券发行编号
                <td align="right" width="10%">#springMessage('table.cmsBond.bondIssueNum')</td>
                <td width="10%">
                    <div class="layui-inline">
                        <input type="text" readonly="readonly" class="layui-input" id="bondIssueNum" value="$!{issueInfo.bondIssueNum}" />
                    </div>
                </td>
                ##发行金额
                <td class="textRight" width="10%">#springMessage('table.cmsBond.issueMoney')</td>
                <td width="10%">
                    <div class="layui-inline">
                        <input class="layui-input bt-biz-moneyType"
                               data-name="issueMoney"
                               data-biz-name="issueMoney"
                               data-decimal="2"
                               readonly="true"
                               value="$!{issueInfo.issueMoney}"
                               placeholder="#springMessage('table.cmsBond.issueMoney')">
                    </div>
                </td>
            </tr>
            </tbody>
        </table>
        <button id="addTrShow" class="layui-btn" type="button" onclick="add()">#springMessage(
            'common.addTr')</button>
        <table class="layui-table self-adaption layui-table-border" id="cmsBondRepayPlanTB" style="margin-bottom:8px">
            <thead>
            <tr>
                <th>#springMessage('table.cmsBond.bondIssueNum')</th> ##债券发行编号
                <th>#springMessage('table.cmsBond.repayDate')</th>    ##还款日期
                <th>#springMessage('table.cmsBond.planRepayDate')</th> ##计划还款日
                <th>#springMessage('table.cmsBond.repayMoney')</th>    ##还款本金值
                <th>#springMessage('table.cmsBond.remainMoney')</th> ##剩余本金值
                <th>#springMessage('table.cmsBond.repayAmount')</th> ##本次还款金额
                <th>#springMessage('table.cmsBond.repayRate')</th>    ##本次偿还站发行总额比例%
                <th>#springMessage('table.cmsBond.isRepay')</th>    ##是否已还
                <th>#springMessage('table.cmsBond.rmk')</th> ##备注
                <th>#springMessage('table.cmsBond.operation')</th>    ##操作
            </tr>
            </thead>
            <tbody id="cmsBondRepayPlanBody">
            </tbody>
            <tfoot>
            <tr>
                <td align="center">#springMessage('table.interet.sum')</td>

                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td align="right">
                    <input type="text" style="border:none;" id="repayAmountSum" data-name="repayAmountSum"
                           data-biz-name="repayAmountSum" readonly="readonly"
                           autocomplete="off" class="layui-input bt-biz-moneyType">
                </td>
                <td align="right">
                    <input type="text" style="border:none;" id="repayRateSum" data-name="repayRateSum"
                           data-biz-name="repayRateSum" readonly="readonly" data-max="100"
                           autocomplete="off" class="layui-input bt-biz-moneyType">
                </td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
            </tr>
            </tfoot>
        </table>
        <div align="center">
            <button class="layui-btn layui-btn-small" lay-submit="" lay-filter="save">#springMessage(
                'common.button.save')</button>
##            <button class="layui-btn layui-btn-primary layui-btn-small" onclick="resetClick">#springMessage(
##                "common.button.reset")</button>
            <a href="#" class="layui-btn layui-btn-small" onClick="doClose()">#springMessage('common.button.close')</a>
        </div>
    </form>
</div>
    #parse("views/common/footer.vm")
</body>
<style>
    html, body {
        height: 100%;
    }
</style>
<script src="${basePath}/static/modules/cms/bond/bondIssueRepayPlan.add.js?_btv=${resourceVersion}"></script>
</html>

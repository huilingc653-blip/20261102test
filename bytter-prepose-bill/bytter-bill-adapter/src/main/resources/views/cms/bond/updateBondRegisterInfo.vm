<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
    <input type="hidden" name="id" value="$!{registerInfo.id}">
    <input  id="createDate" type="hidden" name="createDate" value="$!{registerInfo.createDate}">
    <input  id="createBy" type="hidden" name="createBy" value="$!{registerInfo.createBy}">
    <input  id="bondTypeName" type="hidden" name="bondTypeName" value="$!{registerInfo.bondTypeName}">
    ##债券注册主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsBond.registerMainMsg')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##债券类型
                        <td class="textRight">#springMessage('table.cmsBond.bondType')</td>
                        <td >
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="typeId" data-biz-name="typeId" data-inputValue="false" data-initCallback="typeInitCallback"
                                     data-url="${basePath}/cms/bond/type/listValidBondType" data-valuefield="id" data-callback="typeCallBack"
                                     data-textfield="bondName" data-required="true" data-defaultvalue="$!{registerInfo.typeId}"></div>
                            </div>
                        </td>
                        ##境内境外
                        <td class="textRight">#springMessage('table.cmsLease.isDomestic')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="btBankAcc.isDomesticBank"
                                 data-required="true"
                                 data-defaultvalue="$!{registerInfo.isTerritory}" data-name="isTerritory"
                                 data-biz-name="isTerritory"></div>
                        </td>
                    </tr>
                    <tr>
                        <input type="hidden" id="corpName" name="corpName" value="$!{registerInfo.corpName}">

                        ##发行人/债务人
                        <td class="textRight" >#springMessage('table.cmsBond.bondIssuer')</td>
                        <td width="25%">
                            <div class="layui-inline">
                                <div class="bt-biz-corp" data-type="selectTree" data-required="true" data-callbackData="corpCallback"
                                     data-biz-name="corpId" data-name="corpId" data-defaultvalue="$!{registerInfo.corpId}"
                                     data-resource="cms:bond:register:query" data-scope="all"></div>
                            </div>
                        </td>
                        ##债券全称
                        <td class="textRight" >#springMessage('table.cmsBond.bondFullName')</td>
                        <td >
                            <input type="text"  name="bondFullName" maxlength="100" data-maxlength="100" autocomplete="off" value="$!{registerInfo.bondFullName}"
                                   class="layui-input" lay-verify="required|strlength"/>
                        </td>
                    </tr>
                    <tr>
                        ##发行批文名称
                        <td class="textRight" >#springMessage('table.cmsBond.issueName')</td>
                        <td >
                            <input type="text" name="issueName" maxlength="50" data-maxlength="50" autocomplete="off" class="layui-input" value="$!{registerInfo.issueName}" lay-verify="strlength"/>
                        </td>
                        ##批准文号
                        <td class="textRight" >#springMessage('table.cmsBond.approvalNumber')</td>
                        <td >
                            <input type="text" name="approvalNumber" maxlength="50" data-maxlength="50" autocomplete="off" class="layui-input" value="$!{registerInfo.approvalNumber}" lay-verify="strlength"/>
                        </td>
                    </tr>
                    <tr>
                        ##债券代码
                        <td class="textRight" >#springMessage('table.cmsBond.bondCode')</td>
                        <td >
                            <input type="text"  name="bondCode" maxlength="50" data-maxlength="50" autocomplete="off" value="$!{registerInfo.bondCode}"
                                   class="layui-input" lay-verify="required|code|strlength"/>
                        </td>
                        ##债券简称
                        <td class="textRight" >#springMessage('table.cmsBond.bondShortName')</td>
                        <td >
                            <input type="text" name="bondShortName" maxlength="50" data-maxlength="50" value="$!{registerInfo.bondShortName}" autocomplete="off" class="layui-input" lay-verify="strlength"/>
                        </td>
                    </tr>
                    <tr>
                        ##债券期限
                        <td class="textRight">#springMessage('table.cmsBond.bondDeadline')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" data-name="bondDeadline" data-decimal="0" data-biz-name="bondDeadline"
                                       autocomplete="off" lay-verify="required" value="$!{registerInfo.bondDeadline}"  class="layui-input bt-biz-moneyType">
                            </div>
                            <div class="layui-inline">
                                <div class="bt-biz-dict" data-width="80px" data-name="deadlineUnit" data-type="select" data-biz-name="deadlineUnit"
                                     data-group="remainTerm.unit"  data-required="true" data-defaultvalue="$!{registerInfo.deadlineUnit}"></div>
                            </div>
                        </td>
                        ##债券原币币种
                        <td class="textRight">#springMessage('table.cmsBond.bondOriCur')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="bondCur" data-defaultvalue="$!{registerInfo.bondCur}"
                                     data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-callback="conver"
                                     data-textfield="curName" data-required="true" data-biz-name="bondCur"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 计划发行原币总额
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsBond.issueCurTotal')</td>
                        <td>
                            <input class="layui-input bt-biz-moneyType" data-maxlength="20" data-name="issueCurTotal"
                                   lay-verify="required|strlength" data-biz-name="issueCurTotal" value="$!{registerInfo.issueCurTotal}"
                                   data-decimal="2" data-minus="false" data-callback="conver" type="text">
                        </td>
                        ## 计划发行人民币总额
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsBond.issueRmbTotal')</td>
                        <td>
                            <input class="layui-input bt-biz-moneyType" data-maxlength="20" data-name="issueRmbTotal"
                                   lay-verify="required|strlength" data-biz-name="issueRmbTotal" value="$!{registerInfo.issueRmbTotal}"
                                   data-decimal="2" data-minus="false" type="text" disabled="true">
                        </td>
                    </tr>
                    <tr>
                        ##债券信用评级
                        <td class="textRight" >#springMessage('table.cmsBond.bondCreditRate')</td>
                        <td >
                            <input type="text" name="bondCreditRate" maxlength="50" data-maxlength="50" autocomplete="off" class="layui-input" value="$!{registerInfo.bondCreditRate}" lay-verify="strlength"/>
                        </td>
                        ##发行人信用评级
                        <td class="textRight" >#springMessage('table.cmsBond.debtorCreditRate')</td>
                        <td >
                            <input type="text" name="debtorCreditRate" maxlength="50" data-maxlength="50" autocomplete="off" class="layui-input" value="$!{registerInfo.debtorCreditRate}" lay-verify="strlength"/>
                        </td>
                    </tr>
                    <tr>
                        ##可转换开始日
                        <td class="textRight">#springMessage('table.cmsBond.convertStartDate')</td>
                        <td>
                            <input id="convertStartDate" name="convertStartDate"  data-biz-name="convertStartDate"  value="$!{registerInfo.convertStartDate}"
                                   data-endid="convertEndDate" data-type="date" class="layui-input bt-biz-dateType"/>
                        </td>
                        ##可转换结束日
                        <td class="textRight">#springMessage('table.cmsBond.convertEndDate')</td>
                        <td>
                            <input id="convertEndDate" name="convertEndDate" value="$!{registerInfo.convertEndDate}"
                                   data-biz-name="convertEndDate"  data-type="date" class="layui-input bt-biz-dateType"/>
                        </td>
                    </tr>
                    <tr>
                        ##转换比例
                        <td class="textRight" >#springMessage('table.cmsBond.convertRate')</td>
                        <td >
                            <input type="text" data-name="convertRate" class="layui-input bt-biz-rateType"  value="$!{registerInfo.convertRate}" >
                        </td>
                        ##融资用途
                        <td class="textRight" >#springMessage('table.cmsBond.purpose')</td>
                        <td >
                            <input type="text" name="purpose" maxlength="100" data-maxlength="100" autocomplete="off" class="layui-input"  value="$!{registerInfo.purpose}" lay-verify="strlength"/>
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                        <td colspan="3">
                                <textarea type="text" id="rmk" name="rmk" class="layui-textarea"
                                          placeholder="#springMessage('table.cmsProvideLoanInfo.rmk')">$!{registerInfo.rmk}</textarea>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('cms.loan.attachment')</td>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input id="attachmentId" name="attachmentId" type="hidden" value="$!{registerInfo.attachmentId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    <input type="hidden" name="status"/>
                    <tr>
                        <td style="text-align: center;" colspan="4">
                            <button class="layui-btn" lay-submit="" id="submit" value="11">#springMessage('common.button.submit')</button>
                            <button class="layui-btn" lay-submit="" id="temp" value="0">#springMessage('common.button.temp')</button>
                            <button type="button" onclick="resetCallback()" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/bond/bondRegisterInfo.update.js?_btv=${resourceVersion}"></script>
</body>
</html>
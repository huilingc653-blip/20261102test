<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
    ##可转债信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <thead>
                    <tr>
                        ##可转债
                        <td colspan="4" align="center"><strong>#springMessage("table.cmsBond.transfer")</strong></td>
                    </tr>
                    </thead>
                    <colgroup>
                        <col width="15%">
                        <col width="35%">
                        <col width="15%">
                        <col width="35%">
                    </colgroup>
                    <tbody>
                    <tr>
                        <input type="hidden" id="issueId" name="issueId" value="$!{cmsBondTransferVO.issueId}">
                        <input type="hidden" id="transferId" name="id" value="$!{cmsBondTransferVO.id}">
                        <td class="textRight">#springMessage('table.cmsBond.transferDate')</td>
                        <td>
                            <span>$!date.format('yyyy-MM-dd',$!{cmsBondTransferVO.transferDate})</span>
                        </td>
                        ## 转股价
                        <td class="textRight">#springMessage('table.cmsBond.transferPrice')转股价</td>
                        <td>
                            <span>$!{cmsBondTransferVO.transferPrice}</span>
                        </td>
                    </tr>
                    <tr>
                        ##转股数量
                        <td class="textRight">#springMessage('table.cmsBond.transferAmount')</td>
                        <td>
                            <span>$!{cmsBondTransferVO.transferAmount}</span>
                        </td>
                        ##累计转股数量
                        <td class="textRight">#springMessage('table.cmsBond.totalTransferAmount')</td>
                        <td>
                            <span>$!{cmsBondTransferVO.totalTransferAmount}</span>
                        </td>
                    </tr>
                    <tr>
                        ##累计转股比例
                        <td class="textRight">#springMessage('table.cmsBond.totalTransferRate')</td>
                        <td>
                           <span> $rateTag.show($!{cmsBondTransferVO.totalTransferRate})</span>
                        </td>
                        ##累计转股金额
                        <td class="textRight">#springMessage('table.cmsBond.totalTransferMoney')</td>
                        <td>
                           #* <span>$!number.formatNumeric($!{cmsBondTransferVO.totalTransferMoney})</span>*#
                           <span>$!{cmsBondTransferVO.totalTransferMoney}</span>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="4"style="text-align: center">
                            <div class="layui-form-item layui-form-submit ">
                                <div class="layui-input-block">
                                    <button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage(
                'common.button.close')</button>
                                </div>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

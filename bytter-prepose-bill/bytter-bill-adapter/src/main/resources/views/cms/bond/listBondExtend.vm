<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <input type="hidden" id="registerId" name="registerId" value="$!{registerId}"/>
    <input type="hidden" id="isView" name="isView" value="$!{isView}"/>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsBond.extendApplyDate')</th>
        <th>#springMessage('table.cmsBond.bondIssueNum')</th>
        <th>#springMessage('cms.lease.extend.expendedCode')</th>
        <th>#springMessage('table.cmsBond.extendEndDate')</th>
        <th>#springMessage('table.cmsLoanDeferred.deferredLimt')</th>
        <th>#springMessage('cms.lease.extend.pointsProportionSelect')</th>
        <th>#springMessage('table.cmsLoanSend.deferredRate')（%）</th>
        <th>#springMessage('table.cmsBond.rmk')</th>
        <th>#springMessage('table.cmsBond.status')</th>
        #if("$!{isView}" == '0') <th>#springMessage('table.cmsBond.operation')</th> #end
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/bond/listBondExtend.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

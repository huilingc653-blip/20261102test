<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	<style>
		.input-bp input {
			border: none;
			width: 192px;
		}
		.input-bp span {
			position: absolute;
			right: 4px;
			top: 1px;
		}
	</style>
</head>
<body>
	<form class="layui-form" method="post">
        <table class="layui-table">
	        	<colgroup>
	        		<col width="15%">
	        		<col width="35%">
	        		<col width="15%">
	        		<col width="35%">
	        	</colgroup>
	        <thead>
        		<tr>
        			<td colspan="4" align="center"><strong>#springMessage('cms.loan.loanInfo')</strong></td>
        		</tr>
        	</thead>
			<tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label>#springMessage('table.cmsLoanInfo.createDate')</label>&nbsp;&nbsp;
					$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.createDate)
					<input type="hidden" name="inputDate" id="inputDate" value="$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.createDate)">
				</td>
			</tr>
        	##申请单位
				<td class="textRight">#springMessage('table.cmsLoanInfo.corp')</td>
				<td>
				<span>$!{cmsLoanInfoPage.corpName}</span>
				</td>
				#if($isCharging)
				##借款单位
				<td class="textRight">#springMessage('table.cmsLoanInfo.borrowCorpId')</td>
				<td>
				<span>$!{cmsLoanInfoPage.borrowCorpId}</span>
				</td>
				#else
				<td class="textRight" colspan="2"></td>
				#end
			</tr>
			<tr>
			##所属资金中心
				<td class="textRight">#springMessage('table.cmsLoanInfo.net')</td>
				<td>
				<span>$!{cmsLoanInfoPage.netName}</span>
				</td>
			#if(!$isCharging)
			##贷款类型
			<td class="textRight">#springMessage('table.cmsLoanInfo.loanGenre')</td>
			<td>
				<span>$!{cmsLoanInfoPage.loanGenreName}</span>
			</td>
			#else
			<td class="textRight" colspan="2"></td>
			#end

			</tr>
			<tr>
			##贷款金额(小写)
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanMoneyLower')</td>
				<td >
                       $number.formatNumeric($!{cmsLoanInfoPage.loanMoney})
                        <input type="hidden" class="layui-input bt-biz-moneyType" data-toup="loanMoneyUpper" value="$!{cmsLoanInfoPage.loanMoney}">
				</td>
			##贷款金额(大写)
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanMoneyUpper')</td>
				<td >
						<div id="loanMoneyUpper"></div>
				</td>
			</tr>
			<tr>
			##贷款日期
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanDate')</td>
				<td >
				<input type="hidden" id="loanDate" name="loanDate1" value="$!{cmsLoanInfoPage.loanDate}">
					$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.loanDate)
				</td>
			##还款日期
				<td class="textRight">#springMessage('table.cmsLoanDeferred.matureDate')</td>
				<td >
                 <input type="hidden" id="repayDate" value="$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.repayDate)">
				$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.repayDate)
				</td>
			</tr>
			#if($isCharging)
			<tr>
			##发放方式
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanSendOutType')</td>
				<td>
					$dictTag.get("cms.loan.loanSendOutType",${cmsLoanInfoPage.loanSendOutType})
				</td>
			##支付方式
				<td class="textRight">#springMessage('table.cmsLoanInfo.payType')</td>
				<td>
					$dictTag.get("cms.loan.payType",${cmsLoanInfoPage.payType})
				</td>

			</tr>
			#else
			<tr>
			##还款方式
				<td class="textRight">#springMessage('table.cmsLoanInfo.repayType')</td>
				<td>${cmsLoanInfoPage.repayTypeName}</td>
			##贷款种类
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanClass')</td>
				<td >
					$dictTag.get("cms.LoanClass",${cmsLoanInfoPage.loanClass})
				</td>
			</tr>
			#end
			<tr>
			##用途
				<td class="textRight">#springMessage('table.cmsLoanInfo.purpose')</td>
				<td >
				$!{cmsLoanInfoPage.purpose}
				</td>
			##放款币种
				<td class="textRight">#springMessage('table.cmsLoanInfo.curCode')</td>
				<td >
					$!{cmsLoanInfoPage.curName}
				</td>
			</tr>
			<tr>
			##贷款期限
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanTerm')</td>
				<td >
					$!{cmsLoanInfoPage.loanTerm} $dictTag.get("cms.loan.ternUnit",${cmsLoanInfoPage.ternUnit})
				</td>
			##放款利率
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanRate')</td>
				<td >
				$rateTag.show($!{cmsLoanInfoPage.loanRate})
				</td>
			</tr>
	   ##授信
	   #if($!{cmsLoanInfoPage.isHangCredit} == "1")
		   #parse("views/common/viewRatCprationDtl.vm")
		#end
			#if($isCharging)
			<tr>
			##固定费率
				<td class="textRight">#springMessage('table.cmsLoanInfo.clbFixedRate')</td>
				<td >
				$rateTag.show($!{cmsLoanInfoPage.clbFixedRate})
				</td>
			##协定费率
				<td class="textRight">#springMessage('table.cmsLoanInfo.clbAgreementRate')</td>
				<td >
					$rateTag.show($!{cmsLoanInfoPage.clbAgreementRate})
				</td>
			</tr>
			#end
			<tr>
			##备注
				<td class="textRight">#springMessage('table.cmsLoanInfo.rmk')</td>
				<td colspan="3">
						<textarea style="min-height:70px"
							    class="layui-textarea" readonly="readonly">$!{cmsLoanInfoPage.rmk}</textarea>
						</td>
			</tr>
        	</tbody>
        </table>
		#if($!{isGuarantee}=="1")##授信参数设置挂接担保
		##担保合同信息
			#if(${cmsLoanInfoPage.isHangGuarantee}=="1")
                <h2 class="layui-colla-title">#springMessage('table.guaContract.ContractMsg')</h2>
				#set($guaContractUseDTO=$guaContractTag.getGuaContractOccupyDetail($!{cmsLoanInfoPage.id},$!{cmsLoanInfoPage.billCode}))
				#if($!{guaContractUseDTO})
					#parse("views/common/guaContractDetail.vm")
				#end
			#end
		#end
        <table class="layui-table">
        	<colgroup>
        		<col width="15%">
        		<col width="35%">
        		<col width="15%">
        		<col width="35%">
        	</colgroup>
        	<thead>
        		<tr>
        			<td colspan="4" align="center"><strong>#springMessage('cms.loan.loansendInfo') (#springMessage('cms.loan.the')$!{sendCount}#springMessage('cms.load.count'))</strong></td>
        		</tr>
        	</thead>
        	<tbody>
        		<tr>
        			<td colspan="4" style="text-align: center;">
						<label>#springMessage('table.cmsLoanInfo.createDate')</label>&nbsp;&nbsp;
						<div class="layui-input-inline">
						<input type="text" name="createDate" class="layui-input" value="$!{createEnterDate}" readonly>
						</div>
					</td>
        		</tr>
        		<tr>
        		##贷款合同编号
        			<td class="textRight">#springMessage('table.cmsLoanInfo.contractCode')</td>
        			<td>
        				<input type="text" lay-verify="required"
							    autocomplete="off" class="layui-input" value="$!{cmsLoanInfoPage.contractCode}" readonly>
        			</td>
        		##发放合同编号
        			<td class="textRight">#springMessage('table.cmsLoanSend.contractCode')</td>
        			<td>
        				<input type="text" lay-verify="required" name ="contractCode"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanSend.contractCode')">
        			</td>
        		#if(!$isCharging)
        			<tr>
	        			##浮动方式
	        			<td class="textRight">#springMessage('table.cmsLoanInfo.floatWay')</td>
	        			<td>
		        			<div class="bt-biz-dict" data-type="select" data-group="Cms.FloatWay" data-defaultvalue="$!{cmsLoanInfoPage.floatWay}" data-name="floatWay" data-biz-name="floatWay" data-callback="setChangeFloatWay" data-disabled="true"></div></div>
	        				<div class="layui-inline" id="ChangeFloatWay">
	        				</div>
	        			</td>
	        			##计息方式
	        			<td class="textRight">#springMessage('table.cmsLoanInfo.interestWay')</td>
	        			<td>
	        			<div class="bt-biz-dict" data-type="select" data-group="Admin.PredrawSign" data-defaultvalue="$!{cmsLoanInfoPage.interestWay}" data-name="interestWay" data-biz-name="interestWay"></div>
	        			</td>
        			</tr>
        			<tr>
	        			##浮动利率
	        			<td class="textRight">#springMessage('cms.loan.floatRate')</td>
	        			<td>
		        			<div style="padding-bottom: 5px;padding-top: 5px;">
								#if($cur.id == $cmsLoanInfoPage.curCode)
									#set ($referenceRateTypeUrl = ${basePath}+"/cms/loanrate/maintence/queryBaseRate")
									#set ($repayCycleUrl = ${basePath}+"/period/tbcreditperiod/allJson")
								#else
									#set ($referenceRateTypeUrl = ${basePath}+"/cms/loanrate/maintence/queryNotBaseRate")
									#set ($repayCycleUrl = ${basePath}+"/period/tbcreditperiod/allJson")
								#end
								<div class="bt-biz-selectType"
                                           data-biz-name="referenceRateType"
                                           data-url="$!{referenceRateTypeUrl}"
                                           data-valuefield="id"
                                           data-textfield="baseTypeName"
                                           data-name="referenceRateType"
                                           data-callback="loanRepayCycle"
##                                           data-initcallback="loanRepayCycle"
                                           data-search="true"
                                           data-defaultvalue="$!{cmsLoanInfoPage.referenceRateType}"
                                           data-disabled="true">
								</div>
                            </div>
        				<div style="padding-bottom: 5px;padding-top: 5px;">
							<div class="bt-biz-selectType"
								data-biz-name="repayCycle"
								data-url="$!{repayCycleUrl}"
								data-valuefield="id"
								data-textfield="periodName"
								data-name="repayCycle"
								data-callback="loadrepayCycle"
								##data-initcallback="loadrepayCycle"
								data-defaultvalue="$!{cmsLoanInfoPage.repayCycle}"
								data-disabled="true">
							</div>
						</div>
        				<div class="layui-inline" style="padding-bottom: 5px;padding-top: 5px;">
	        				<div class="bt-biz-dict" data-name="pointsProportionSelect" data-type="select" data-biz-name="pointsProportionSelect" data-group="Cms.PointsProportion" data-defaultvalue="$!{cmsLoanInfoPage.pointsProportionSelect}" data-disabled="true"></div>
        				</div>
        				<div class="layui-inline input-bp" style="padding-bottom: 5px;padding-top:5px;">
        				<!-- <input class="layui-input bt-biz-moneyType" id="pointsProportionTextDIS" name="pointsProportionText" disabled="true" data-biz-name="pointsProportionText" value="0" data-decimal="2" data-max="100" data-min="0" data-callback="getLoanRate"> -->
							<div class="pl rateWrap" style="width:212px">
        						<input class="layui-input bt-biz-moneyType" id="pointsProportionText" name="pointsProportionText" value="$!{cmsLoanInfoPage.pointsProportionText}" data-biz-name="pointsProportionText"  data-decimal="2" data-max="100" data-min="-100" disabled="disabled" data-callback="getLoanRate">
								#if("01" == $!{cmsLoanInfoPage.pointsProportionSelect})
									<span class="inputMark">BP</span>
									#elseif("02" == $!{cmsLoanInfoPage.pointsProportionSelect})
									<span class="inputMark">%</span>
								#end
							</div>
        				</div>
	        			</td>
	        			##利率调整生效日期
	        			<td class="textRight">#springMessage('table.cmsLoanInfo.rateEntriesEffectDate')</td>
	        			<td><input type="text" name="rateEntriesEffectDate" class="layui-input bt-biz-dateType" data-type="date"
								   value="$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.rateEntriesEffectDate)"
								   data-biz-name="rateEntriesEffectDate" readonly="true">
	        			</td>
        			</tr>
        			<tr>
        				##贷款利率
        				<td class="textRight">#springMessage('table.cmsLoanInfo.loanRate')</td>
        				<td>
        					<div class="layui-inline">
        					<input type="text" data-name="loanRate" data-biz-name="loanRate" class="layui-input bt-biz-rateType"
								   data-supermin="0"
								   value="$!{cmsLoanInfoPage.loanRate}" lay-verify="required" onchange="retPayPlan2()">
        					</div>
        					<div class="layui-inline">
	        				<input type="button" class="layui-btn" id="getRate" value="#springMessage('cms.provide.getRate')" style="float:left ;display:none;">
	        				</div>
        				</td>
        				##逾期利率
        				<td class="textRight">#springMessage('table.cmsLoanSend.overdueRate')</td>
        				<td>
        					<input type="text" data-name="overdueRate" class="layui-input bt-biz-rateType" value="$!{cmsLoanInfoPage.overdueRate}" lay-verify="required" >
        				</td>
        			</tr>
        			<tr>
        				##展期利率
        				<td class="textRight">#springMessage('table.cmsLoanSend.deferredRate')</td>
        				<td>
        					<input type="text" data-name="deferredRate" class="layui-input bt-biz-rateType" value="$!{cmsLoanInfoPage.deferredRate}">
        				</td>
        				##待发放金额
        				<td class="textRight">#springMessage('table.cmsLoan.notSendMoney')</td>
        				<td>$number.formatNumeric($!{notSendMoney})</td>
        			</tr>
        		#end
        		<tr>
        			##发放日期
        			<td class="textRight">#springMessage('table.cmsLoanSend.loanDate')</td>
        			<td>
        				<!-- <input type="text" name="loanDate" id="sendDateShow" class="layui-input bt-biz-dateType" data-type="date" value="$!{cmsLoanInfoPage.loanDate}" data-biz-name="loanDate" lay-verify="required" data-min="$!{dayCloseDate}" data-callback="validataLoanDate"> -->
        				<input type="text" name="loanDate" id="sendDateShow" class="layui-input bt-biz-dateType" data-type="date" data-today=true data-biz-name="loanDate" lay-verify="required" data-min="$!{dayCloseDate}" data-callback="validataLoanDate">
        			</td>
        			##到期日期
        			<td class="textRight">#springMessage('cms.common.deadlineDate')</td>
        			<td>
        				<input type="text" name="repayDate" id="repayDateShow" class="layui-input bt-biz-dateType" data-type="date" value="$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.repayDate)" data-min="$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.repayDate)" data-biz-name="repayDate" lay-verify="required" data-callback="validataRepayDate">
        			</td>
        		</tr>
        		<tr>
        		##贷款发放方式
        			<td class="textRight">#springMessage('table.cmsLoanSend.loanSendOutType')</td>
        			<td>
        				<div class="bt-biz-dict" data-name="loanSendOutType" data-type="select" data-biz-name="loanSendOutType" data-group="cms.loan.loanSendOutType" #if($sendCount>1) data-disabled="true" data-defaultvalue="$!{cmsLoanInfoPage.loanSendOutType}" #else data-defaultvalue="1" #end data-callback="sentOutTypeChange"></div>
        			</td>
        			#if(!$isCharging)
	        			##还款方式
	        			<td class="textRight">#springMessage('table.cmsLoanSend.repayType')</td>
	        			<td>
							<div class="layui-inline">
								<div class="bt-biz-selectType" data-name="repayType" data-biz-name="repayType"
									 data-url="$basePath/cms/repay/repaytype/queryNoNRepayTypeList"
									 data-callback="repayTypeCallBack" data-defaultvalue="$!{cmsLoanInfoPage.repayType}"
									 data-valuefield="id" data-textfield="repayName"
									 data-required="true"></div>
							</div>
							<div class="layui-inline">
								<!-- 还款计划 -->
								<button class="layui-btn" type="button" id="makePlanBtn"
										onclick="repayLan();">#springMessage(
                                    'cms.button.repayPlan')</button>
								<input type="hidden" id="planId" name="planId" value="$!{planId}">
								<input type="hidden" id="planStatus" name="planStatus" value="0">
							</div>
	        				<!-- <a href="#" class="layui-btn layui-btn-small" onClick="repayPlan()" >#springMessage('cms.button.repayPlan')</a> -->
	        			</td>
        			#else
	        			##凭证号
	        			<td class="textRight">#springMessage('table.cmsLoanSend.voucherNo')</td>
	        			<td>
	        			</td>
        			#end
        		</tr>
        		<tr style="display: none;">
        			##支付方式
        			<td class="textRight">#springMessage('table.cmsLoanSend.payType')</td>
					<td>
						<div class="bt-biz-dict" data-type="select" data-group="cms.loan.payType" data-defaultvalue="1" data-name="payType" data-biz-name="payType" data-disabled="true"></div>
					</td>
					<td class="textRight">
					##待发放金额
					#springMessage('table.cmsLoan.notSendMoney')
					</td><td>$number.formatNumeric($!{notSendMoney})</td>
        		</tr>
        		<tr>
        			##贷款金额(小写)
					<td class="textRight">#springMessage('table.cmsLoanSend.loanMoney')</td>
					<td >
	                        <input type="text" id="loanMoney" data-name="loanMoney" data-toUp="loanMoneyUpper2" data-biz-name="loanMoney_biz" data-max="$!{notSendMoney}" lay-verify="required"
								     class="layui-input bt-biz-moneyType loanMoneyShow"
								     #if($cmsLoanInfoPage.loanSendOutType==2)
								     	value=""
								     #else
								     	value="$!{cmsLoanInfoPage.loanMoney}" readonly="readonly"
								     #end
								      onChange="retPayPlan1()"
								     />
					</td>
					##贷款金额(大写)
					<td class="textRight">#springMessage('table.cmsLoanSend.loanMoneyUpper')</td>
					<td >
							<div id="loanMoneyUpper2"></div>
					</td>
        		</tr>
        		<tr>
				##附件
					<td class="textRight">#springMessage('cms.loan.attachment')</td>
					<td colspan="3"><div id="uploader" style="width:100%" class="layui-input-inline"></div></td>
				</tr>
        		<tr>
        		<td colspan="4" align="center">
	        		<button class="layui-btn" lay-submit="" value="2" lay-filter="submit">#springMessage('common.button.submit')</button>
	        		<button class="layui-btn"  onClick="doClose()">#springMessage('common.button.close')</button>
        		</td>
        		</tr>
        	</tbody>
        	<tfoot>
        	<tr><td colspan="4" align="left">
				<font size="2" color="red" >
				#springMessage("cms.loansend.plan.msg")
				</font>
        	</td></tr>
        	</tfoot>
        </table>
        <input type="hidden" id="loanCode" name ="loanCode" value="$!{cmsLoanInfoPage.billCode}"><!--贷款信息编号  -->
        <input type="hidden" id="corpId" name ="corpId" value="$!{cmsLoanInfoPage.corpId}"><!-- 单位ID -->
        <input type="hidden" id="curCode" name ="curCode" value="$!{cmsLoanInfoPage.curCode}"><!--币别  -->
        <input type="hidden" name ="sendTime" value="$!{sendCount}"><!-- 发放次数 -->
        <input type="hidden" id="loan_Money_Default" #if($cmsLoanInfoPage.loanGenre==2) value="" #else value="$!{cmsLoanInfoPage.loanMoney}" #end><!-- 贷款金额 -->
        <input type="hidden" id="naturalSign" value="$!{naturalSign}">
        <input type="hidden" id="floatWayNext1" value="$!{cmsLoanInfoPage.floatWayNext}">
        <input type="hidden" id="sendBillCode" value="$!{sendBillCode}">
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/loan/cmsLoanSend.add.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/rat/cpration/ratCpUrationSet.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/guarantee/guaContractSelect.js?_btv=${resourceVersion}"></script>

</html>

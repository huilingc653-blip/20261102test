#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
	<ul class="mui-table-view" id="mulTable">
		##创建日期
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.createDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.createDate)
        </span>
    	</li>
		##申请单位
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.corp')
        <span class="mui-badge mui-badge-inverted">
            $!{cmsLoanInfoPage.corpName}
        </span>
    	</li>
		##所属资金中心
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.net')
        <span class="mui-badge mui-badge-inverted">
            $!{cmsLoanInfoPage.netName}
        </span>
    	</li>
    	##贷款类型
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.loanGenre')
        <span class="mui-badge mui-badge-inverted">
            $!{cmsLoanInfoPage.loanGenreName}
        </span>
    	</li>
    	##贷款单号
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.billCode')
        <span class="mui-badge mui-badge-inverted">
           $!{cmsLoanInfoPage.billCode}
        </span>
    	</li>
    	##合同号
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.contractCode')
        <span class="mui-badge mui-badge-inverted">
           $!{cmsLoanInfoPage.contractCode}
        </span>
    	</li>
    	##贷款发放编号
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.billCode')
        <span class="mui-badge mui-badge-inverted">
           $!{cmsLoanSendPage.billCode}
        </span>
    	</li>
    	##放款币别
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.curCode')
        <span class="mui-badge mui-badge-inverted">
           $!{cmsLoanInfoPage.curName}
        </span>
    	</li>
    	##放款金额
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.loanMoney')
        <span class="mui-badge mui-badge-inverted">
           $!number.formatNumeric($!{cmsLoanSendPage.loanMoney})
        </span>
    	</li>
    	##在途金额
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanRepay.inwayMoney')
        <span class="mui-badge mui-badge-inverted">
           $!number.formatNumeric($!{inwayMoney})
        </span>
    	</li>
    	##已还款金额
		<li class="mui-table-view-cell">
        #springMessage('table.cmsProvideLoanRepay.repayFinish')
        <span class="mui-badge mui-badge-inverted">
           $!number.formatNumeric($!{repayedMoney})
        </span>
    	</li>
    	##贷款发放日期
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.loanDate')
        <span class="mui-badge mui-badge-inverted">
           $!date.format('yyyy-MM-dd',$!cmsLoanSendPage.loanDate)
        </span>
    	</li>
    	##到期日期
		<li class="mui-table-view-cell">
        #springMessage('cms.common.deadlineDate')
        <span class="mui-badge mui-badge-inverted">
           $!date.format('yyyy-MM-dd',$!cmsLoanSendPage.repayDate)
        </span>
    	</li>
        ##还款类型
        <li class="mui-table-view-cell">
        #springMessage('table.cmsLoanRepay.repayType')
        <span class="mui-badge mui-badge-inverted">
         $dictTag.get("cms.repayType",${cmsLoanRepayPage.repayType})
        </span>
         </li>
    	#*##支付方式
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.payType')
        <span class="mui-badge mui-badge-inverted">
           $dictTag.get("cms.loan.payType",${cmsLoanRepayPage.payType})
        </span>
    	</li>*#
    	##还款日期
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanRepay.repayDate')
        <span class="mui-badge mui-badge-inverted">
           $!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.repayDate)
        </span>
    	</li>
    	##还款金额
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanRepay.repayMoney')
        <span class="mui-badge mui-badge-inverted">
           $!number.formatNumeric($!{cmsLoanRepayPage.repayMoney})
        </span>
    	</li>
    	##还款方式
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.repayType')
        <span class="mui-badge mui-badge-inverted">
           $dictTag.get("cms.LoanRepayType",$!cmsLoanSendPage.repayType)
        </span>
    	</li>
		##备注
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanRepay.rmk')
		<textarea rows="3" class="layui-textarea" readonly="readonly">$!{cmsLoanRepayPage.rmk}</textarea>
		</li>
	</ul>
	#parse("views/common/wapfooter.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form">
	<table class="layui-table">
	<thead>
			<tr>
			##贷款展期信息
				<td colspan="4" align="center"><strong>#springMessage("cms.loan.loanDeferredInfo")</strong></td>
			</tr>
		</thead>
	<colgroup>
		<col width="15%">
		<col width="35%">
		<col width="15%">
		<col width="35%">
	</colgroup>
		<tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label>#springMessage('table.cmsLoanDeferred.createDate')</label>&nbsp;&nbsp;
					$!date.format('yyyy-MM-dd',$!cmsLoanDeferredPage.createDate)
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.cmsLoanInfo.corp')</td>
				<td colspan="3"><span>$!{cmsLoanInfoPage.corpName}</span></td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.cmsLoanInfo.billCode')</td>
				<td >
					<span>$!{cmsLoanInfoPage.billCode}</span>
				</td>
				##贷款发放编号
				<td class="textRight">#springMessage('table.cmsLoanDeferred.liCode')</td>
				<td>
				<span>$!{cmsLoanDeferredPage.liCode}</span>
				</td>
			</tr>
			<tr>
				##放款金额
				<td class="textRight">#springMessage('table.cmsLoanSend.loanMoney')</td>
				<td >
				$number.formatNumeric($!{cmsLoanSendPage.loanMoney})
				</td>
				##贷款余额
				<td class="textRight">#springMessage('table.cmsLoanRepay.processMoney')</td>
				<td >$number.formatNumeric($!{repayedMoney})</td>
			</tr>
			<tr>
			##贷款发放日期
				<td class="textRight">#springMessage('table.cmsLoanSend.loanDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.loanDate)</td>
			##到期日期
				<td class="textRight">#springMessage('cms.common.deadlineDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.repayDate)</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.cmsLoanDeferred.deferredRepayDate')</td>
				<td>
				$!date.format('yyyy-MM-dd',$!cmsLoanDeferredPage.deferredRepayDate)
				</td>
				<td class="textRight">#springMessage('table.cmsLoanDeferred.deferredLimt')</td>
				<td>
				$!{cmsLoanDeferredPage.deferredLimt}
				#if($cmsLoanDeferredPage.ternUnit==2)
					#springMessage('cms.loan.ternUnit.day')
				#elseif($cmsLoanDeferredPage.ternUnit==1)
					#springMessage('cms.loan.ternUnit.month')
				#end
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.cmsLoanInfo.deferredRate')</td>
				<td>
					$rateTag.show($!{cmsLoanDeferredPage.deferredRate})
				</td>
				<td class="textRight">#springMessage('table.cmsLoanDeferred.contractCode')</td>
				<td>$!{cmsLoanDeferredPage.contractCode}</td>
			</tr>
			<tr>
			##上期展期到期日期
	        	<td class="textRight">#springMessage('table.cmsLoanDeferred.lastDeferredReplayDate')</td><td>
	        	<input type="hidden" id="lastdeferredReplayDate"  class="layui-input bt-biz-dateType" data-type="date" value="$!date.format('yyyy-MM-dd',$!lastDeferredReplayDate)" data-biz-name="lastdeferredReplayDate">
	        	$!date.format('yyyy-MM-dd',$!lastDeferredReplayDate)
	        	</td> 
				##已展期次数
	        	<td class="textRight">#springMessage('table.cmsLoanDeferred.deferredNum')</td>
				<td>
	        	$!{deferredNum}
	        	</td>
			</tr>
			<tr>
			<td class="textRight">#springMessage('table.cmsLoanDeferred.rmk')</td>
			<td colspan="3">
				<textarea id="rmk" name="rmk" style="min-height:70px"
							    class="layui-textarea" placeholder="#springMessage('table.cmsLoanDeferred.rmk')" readonly="readonly">$!{cmsLoanDeferredPage.rmk}</textarea>
			</td>
			</tr>
			<tr>
        	##附件
    		<td class="textRight">#springMessage('cms.loan.attachment')</td>
          	<td colspan="3">
          		<!-- 附件上传 -->
    			<input id="annexName" name="annexName" type="hidden" value="$!{cmsLoanDeferredPage.attachmentId}">
    	        <div id="uploader" class="layui-input-inline" style="width:100%"></div>
          	</td>
    		</tr>

		</tbody>
	</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
	#if($pageType=='repair')
	    	<li class="mui-table-view-divider">#springMessage('table.choBankFinance.bl')</li>
	    	##贷款合同编号
			<li class="mui-table-view-cell">
	        #springMessage('table.cmsLoanInfo.contractCode')
	        <span class="mui-badge mui-badge-inverted">
	            $!{cmsLoanInfoPage.contractCode}
	        </span>
	    	</li>
	    	##计息方式
			<li class="mui-table-view-cell">
	        #springMessage('table.cmsLoanInfo.interestWay')
	        <span class="mui-badge mui-badge-inverted">
	            $dictTag.get("Admin.PredrawSign",${cmsLoanInfoPage.interestWay}) 
	        </span>
	    	</li>
	    	##浮动方式
			<li class="mui-table-view-cell">
	        #springMessage('table.cmsLoanInfo.floatWay')
	        <span class="mui-badge mui-badge-inverted">
	            $dictTag.get("Cms.FloatWay",${cmsLoanInfoPage.floatWay})
	            &nbsp;&nbsp;&nbsp;&nbsp;
				#set($postfix ="") 
				#if(${cmsLoanInfoPage.floatWay} == "03")
					#set($postfix = "Month")
				#elseif(${cmsLoanInfoPage.floatWay} == "04")
					#set($postfix = "Season")
				#elseif(${cmsLoanInfoPage.floatWay} == "05")
					#set($postfix = "HY")
				#elseif(${cmsLoanInfoPage.floatWay} == "06")
					#set($postfix = "Year")
				#end
				$dictTag.get("Cms.FloatWay$postfix",${cmsLoanInfoPage.floatWayNext})
	        </span>
	    	</li>
	    	##浮动利率
		    	#if($cmsLoanInfoPage.floatWay!='01')
				<li class="mui-table-view-cell">
		      	#springMessage('cms.loan.floatRate')(#springMessage('table.cmsLoanType.type'))
		        <span class="mui-badge mui-badge-inverted">
						$!{cmsLoanInfoPage.referenceRateTypeName} 
		        </span>
		    	</li>
		    	<li class="mui-table-view-cell">
		    		#springMessage('cms.loan.floatRate')(#springMessage('table.cmsLoanInfo.ternUnit'))
		    		<span class="mui-badge mui-badge-inverted">
		    			$!{cmsLoanInfoPage.repayCycleName}
		    			</span>
		    	</li>
		    	<li class="mui-table-view-cell">
		    	#springMessage('cms.loan.floatRate')(#springMessage('table.cmsLoanInfo.pointsProportionSelect'))
		    		<span class="mui-badge mui-badge-inverted">
		    			$dictTag.get("Cms.PointsProportion",${cmsLoanInfoPage.pointsProportionSelect})&nbsp;
						$number.formatNumeric($number.formatNumeric($!{cmsLoanInfoPage.pointsProportionText}))
		    			</span>
		    	</li>
				#end
			##利率调整生效日期
			<li class="mui-table-view-cell">
	      	#springMessage('table.cmsLoanInfo.rateEntriesEffectDate')
	        <span class="mui-badge mui-badge-inverted">
	            $!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.rateEntriesEffectDate)
	        </span>
	    	</li>
	    	##贷款利率
			<li class="mui-table-view-cell">
	      	#springMessage('table.cmsLoanInfo.loanRate')
	        <span class="mui-badge mui-badge-inverted">
	            $rateTag.show($!{cmsLoanInfoPage.loanRate})
	        </span>
	    	</li>
	    	##展期利率
			<li class="mui-table-view-cell">
	      	#springMessage('table.cmsLoanInfo.deferredRate')
	        <span class="mui-badge mui-badge-inverted">
	            $rateTag.show($!{cmsLoanInfoPage.deferredRate})
	        </span>
	    	</li>
	    	##逾期利率
			<li class="mui-table-view-cell">
	      	#springMessage('table.cmsLoanInfo.overdueRate')
	        <span class="mui-badge mui-badge-inverted">
	            $rateTag.show($!{cmsLoanInfoPage.overdueRate})
	        </span>
	    	</li>
	
	#end
	

		#if($pageType=='repair')
		<li class="mui-table-view-divider">#springMessage('cms.loan.oldInfo')</li>
    	#end
		##创建时间
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.createDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.createDate)
        </span>
    	</li>
    	##申请单位
    	<li class="mui-table-view-cell">
      	#springMessage('table.cmsLoanInfo.corp')
        <span class="mui-badge mui-badge-inverted">
            $!{cmsLoanInfoPage.corpName}
        </span>
    	</li>
    	##所属资金中心
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.net')
		<span class="mui-badge mui-badge-inverted">$!{cmsLoanInfoPage.netName}
		</span>
		</li>
		##贷款类型
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.loanGenre')
		<span class="mui-badge mui-badge-inverted">$!{cmsLoanInfoPage.loanGenreName}
		</span>
		</li>
		##贷款流水号
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.billCode')
		<span class="mui-badge mui-badge-inverted">$!{cmsLoanInfoPage.billCode}
		</span>
		</li>
		##贷款金额(小写)
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.loanMoneyLower')
		<span class="mui-badge mui-badge-inverted">$number.formatNumeric($!{cmsLoanInfoPage.loanMoney})
		</span>
		</li>
		##贷款金额(大写)
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.loanMoneyUpper')
		<span class="mui-badge mui-badge-inverted">$!{loanMoneyUpper}
		</span>
		</li>
		##贷款日期
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.loanDate')
		<span class="mui-badge mui-badge-inverted">$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.loanDate)
		</span>
		</li>
		##还款日期
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanDeferred.matureDate')
		<span class="mui-badge mui-badge-inverted">$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.repayDate)
		</span>
		</li>
		##还款方式
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.repayType')
		<span class="mui-badge mui-badge-inverted">$dictTag.get("cms.LoanRepayType",${cmsLoanInfoPage.repayType}) 
		</span>
		</li>
		##贷款种类
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.loanClass')
		<span class="mui-badge mui-badge-inverted">$dictTag.get("cms.LoanClass",${cmsLoanInfoPage.loanClass}) 
		</span>
		</li>
		##放款币种
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.curCode')
		<span class="mui-badge mui-badge-inverted">$!{cmsLoanInfoPage.curName}
		</span>
		</li>
		##贷款期限
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.loanTerm')
		<span class="mui-badge mui-badge-inverted">$!{cmsLoanInfoPage.loanTerm} $!dictTag.get("cms.loan.ternUnit",${cmsLoanInfoPage.ternUnit}) 
		</span>
		</li>
		##放款利率
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.loanRate')
		<span class="mui-badge mui-badge-inverted">$rateTag.show($!{cmsLoanInfoPage.loanRate})  
		</span>
		</li>
		##用途
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.purpose')
		<span class="mui-badge mui-badge-inverted">$!{cmsLoanInfoPage.purpose}
		</span>
		</li>
		##备注
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanInfo.rmk')
		<textarea rows="3" class="layui-textarea" readonly="readonly">$!{cmsLoanInfoPage.rmk}</textarea>
		</li>
	</ul>
	#parse("views/common/wapfooter.vm")
</body>
</html>

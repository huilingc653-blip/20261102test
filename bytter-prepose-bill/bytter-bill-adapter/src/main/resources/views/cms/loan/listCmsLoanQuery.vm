<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="relateCon" value="$!{relateCon}">
    <table class="layui-table">
        <colgroup>
            <col width="10%">
            <col width="23%">
            <col width="10%">
            <col width="23%">
            <col width="10%">
            <col width="24%">
        </colgroup>
        <tbody>
        <tr>
            <input type="hidden" id="corpIdExtend" name="corpIdExtend" value="$!{corpId}"/>

            <td class="textRight">#springMessage('table.cmsLoanInfo.corp')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-biz-type="corp"
                         data-type="selectTree" data-name="ins_corpId" data-scope="all"
                         data-resource="cms:loan:report:query" data-defaultvalue="$!{corpId}"
                         data-tree-type="check"></div>
                </div>
            </td>
            ##贷款日期
            <td class="textRight">#springMessage('table.cmsLoanInfo.loanDate')</td>
            <td>
                <input type="text" name="ged_loanDate" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="startDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_loanDate" class="layui-input bt-input-inline bt-biz-dateType"
                       id="startDate">
            </td>
            <td class="textRight">#springMessage('table.cmsLoanDeferred.matureDate')</td>
            <td>
                <input type="text" name="ged_repayDate" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="endDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_repayDate" class="layui-input bt-input-inline bt-biz-dateType"
                       id="endDate">
            </td>
        </tr>
        <tr>
            ##贷款账号
            <td class="textRight">#springMessage('table.cmsLoanSend.loanAcc')</td>
            <td>
                <input type="text" name="likes_loanAcc" class="layui-input">
            </td>
            ##贷款金额
            <td class="textRight">#springMessage('table.cmsLoanInfo.loanMoney')</td>
            <td>
                <input type="text" data-name="geg_loanMoney" class="layui-input bt-input-inline  bt-biz-moneyType"
                       data-moneyendid="money">
                <span class="date-mid">~</span>
                <input type="text" data-name="leg_loanMoney" class="layui-input bt-input-inline  bt-biz-moneyType"
                       id="money">
            </td>
            ##还款金额
            <td class="textRight">#springMessage('table.cmsProvideLoanRepay.moneyFinish')</td>
            <td>
                <input type="text" data-name="geg_repayMoney" class="layui-input bt-input-inline  bt-biz-moneyType"
                       data-moneyendid="repaymoney">
                <span class="date-mid">~</span>
                <input type="text" data-name="leg_repayMoney" class="layui-input bt-input-inline  bt-biz-moneyType"
                       id="repaymoney">
            </td>
        </tr>
        <tr>
            ##单据编号
            <td class="textRight">#springMessage('table.cmsLoanInfo.billCode')</td>
            <td>
                <input type="text" name="likes_infoBillCode" class="layui-input">
            </td>
            ##合同编号
            <td class="textRight">#springMessage('table.cmsLoanInfo.contractCode')</td>
            <td>
                <input type="text" name="likes_contractCode" class="layui-input">
            </td>
            <td class="textRight">#springMessage('table.cmsLoanInfo.loanGenre')</td>
            <td>
                <div class="bt-biz-selectType" data-biz-name="t22"
                     data-url="${basePath}/cms/loan/cmsloaninfo/LoanTypeJson" data-valuefield="code"
                     data-textfield="name" data-name="eqs_loanGenre" data-search="true"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsLoanInfo.billCode')</th><!-- 贷款单号 -->
        <th>#springMessage('table.cmsLoanInfo.net')</th><!--所属资金中心   -->
        <th>#springMessage('table.cmsLoanInfo.corp')</th><!--申请单位  -->
        <th>#springMessage('table.cmsLoanInfo.contractCode')</th><!--贷款合同号  -->
        <th>#springMessage('table.cmsLoanInfo.createDate')</th><!--录入日期  -->
        <th>#springMessage('table.cmsLoanSend.billCode')</th><!--贷款发放单号  -->
        <th>#springMessage('table.cmsLoanSend.loanAcc')</th><!--贷款账号  -->
        <th>#springMessage('table.fcAcc.curId')</th><!--币别  -->
        <th>#springMessage('table.cmsLoanInfo.loanMoney')</th><!--贷款金额  -->
        <th>#springMessage('table.cmsLoanSend.loanMoney')</th><!--本次发放金额  -->
        <th>#springMessage('table.cmsProvideLoanRepay.moneyFinish')</th><!--已还款本金  -->
        <th>#springMessage('cms.inl.info.repayInterest')</th><!--已还利息  -->
        <th>#springMessage('table.cmsProvideLoanRepay.moneyPassage')</th><!--还款在途本金  -->
        <th>#springMessage('table.cmsLoanSend.remainMoney')</th><!--未还金额  -->
        <th>#springMessage('table.cmsLoanSend.deferredNum')</th><!--展期次数 -->
        <th>#springMessage('table.cmsLoanInfo.loanDate')</th><!--贷款日期  -->
        <th>#springMessage('table.cmsLoanDeferred.matureDate')</th><!--到期日期  -->
        <th>#springMessage('table.cmsLoanInfo.repayType')</th><!--还款方式  -->
        <th>#springMessage('table.cmsLoanInfo.loanClass')</th><!--贷款种类  -->
        <th>#springMessage('table.cmsLoanInfo.loanTerm')</th><!--贷款期限  -->
        <th>#springMessage('table.cmsLoanInfo.loanGenre')</th><!--贷款类型  -->
        <th>#springMessage('table.cmsLoanInfo.status')</th><!--状态  -->
        <th>#springMessage('common.table.thead.operation')</th><!--操作  -->
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form', 'datatable', 'btdate', 'corp', 'moneyType', 'rateType', 'dateType', 'selectType', 'date'], function () {
        $ = bt.jquery, form = bt.form();
        bt.corp.init();
        moneyType = bt.moneyType.init();
        moneyFun = bt.moneyType.getFun();
        bt.dateType.init();
        bt.selectType.init();
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            colReorder: true,
            fixedColumns: {
                leftColumns: 1,//代表冻结左边两列
                rightColumns: 1//代表冻结右边一列
            },
            order: [2, 'desc'],
            ajax: {
                'url': basePath + "/cms/loan/cmsloaninfo/dataTableLoanQuery"
            }, searchForm: {
                formFilter: "search",
                formElem: "#searchForm"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            btInitComplete: function (data) {
                $("#corpIdExtend").val("");
            },
            columns: [
                {data: "infoBillCode", className: "center", bSortable: true},
                {data: "netName", className: "center", bSortable: false},
                {data: "corpName", className: "center", bSortable: false},
                {data: "contractCode", className: "center", bSortable: true},
                {data: "createDate", className: "center", bSortable: true},
                {data: "sendBillCode", className: "center", bSortable: true},
                {data: "loanAcc", className: "center", bSortable: true},
                {data: "curName", className: "center", bSortable: false},
                {
                    data: "loanMoney", className: "textRight", bSortable: false,
                    render: function (data, type, full, meta) {
                        var money = moneyFun.format(full.loanMoney);
                        return money;
                    }
                },
                {
                    data: "sendMoney", className: "textRight", bSortable: false,
                    render: function (data, type, full, meta) {
                        var money = moneyFun.format(full.sendMoney);
                        return "<a href='javascript:void(0)' onclick='sendInfolist(\"" + full.sendBillCode + "\")' >" + money + "</a>";
                    }

                },
                {
                    data: "repayMoney", className: "textRight", bSortable: false,
                    render: function (data, type, full, meta) {
                        var money = moneyFun.format(full.repayMoney);
                        return "<a href='javascript:void(0)' onclick='repayInfolist(\"" + full.sendBillCode + "\",1)' >" + money + "</a>";
                    }
                },
                {
                    data: "repayAccrual", className: "textRight", bSortable: false,
                    render: function (data, type, full, meta) {
                        var money = moneyFun.format(full.repayAccrual);
                        return "<a href='javascript:void(0)' onclick='repayInfolist(\"" + full.sendBillCode + "\",1)' >" + money + "</a>";
                    }
                },
                {
                    data: "repayAwayMoney", className: "textRight", bSortable: false,
                    render: function (data, type, full, meta) {
                        var money = moneyFun.format(full.repayAwayMoney);
                        return "<a href='javascript:void(0)' onclick='repayInfolist(\"" + full.sendBillCode + "\",0)' >" + money + "</a>";
                    }

                },
                {
                    data: "stayMoney", bSortable: false, className: "textRight",
                    render: function (data, type, full, meta) {
                        var money = moneyFun.format(full.stayMoney);
                        return money;
                    }
                },
                {
                    data: "deferredNum", className: "center", bSortable: false,
                    render: function (data, type, full, meta) {
                        if (full.deferredNum && full.deferredNum > 0) {
                            return "<a href='javascript:void(0)' onclick='deferredInfolist(\"" + full.sendBillCode + "\")' >" + full.deferredNum + "</a>";
                        } else {
                            return '';
                        }
                    }
                },
                {data: "loanDate", className: "center", bSortable: true},
                {data: "repayDate", className: "center", bSortable: true},
                {
                    data: "repayTypeName", className: "center", bSortable: false},
                {
                    data: "loanClass", className: "center", bSortable: false,
                    render: function (data, type, full, meta) {
                        return bt.dict("cms.LoanClass", full.loanClass);
                    }
                },
                {
                    data: "loanTerm", className: "center", bSortable: false,
                    render: function (data, type, full, meta) {
                        if (full.ternUnit == 2) {
                            return full.loanTerm + bt.lang("cms.loan.ternUnit.day");
                        } else if (full.ternUnit == 1) {
                            return full.loanTerm + bt.lang("cms.loan.ternUnit.month");
                        } else {
                            return full.loanTerm;
                        }
                    }
                },
                {data: "loanGenreName", className: "center", bSortable: false},
                {
                    data: "bizStatus", className: "center", bSortable: false,
                    render: function (data, type, full, meta) {
                        return bt.dict("cms.bizStatus", full.bizStatus);
                    }
                },
                {
                    data: null, bSortable: false, className: 'center',
                    render: function (data, type, full, meta) {
                        var html = "";
                        if(!bt.empty(full.sendBillCode)) {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="interestView(this)">' + bt.lang("table.fcAgreedDeposit.interestInfo") + '</a>';
                            html += '<span class="text-explode">|</span>';
                        }
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a>';
                        if (!bt.empty(full.conId) && $('#relateCon').val() == '1') {
                            html += '<span class="text-explode">|</span><a  href="#" data-row="' + meta.row + '" onclick="conView(this)">' + bt.lang("common.button.conInfo") + '</a>';
                        }
                        html += '<span class="text-explode">|</span><a class="" href="#" data-row="'+meta.row+'" onclick="listMsg(this)">'+bt.lang("common.button.logInfo")+'</a>';
                        return html;
                    }
                }
            ],
            rowsGroup: [0, 1, 2, 3, 6, 7],
            summary: {
                pageSum: true,
                format: {
                    // separator: ",",
                    decimal: 2
                },
                sumList: [
                    /* {
                        colNum:'7',
                        dataName:'loanMoney'
                    }, */
                    {
                        colNum: '8',
                        dataName: 'sendMoney'
                    },
                    {
                        colNum: '9',
                        dataName: 'repayMoney'
                    },
                    {
                        colNum: '10',
                        dataName: 'repayAccrual'
                    },
                    {
                        colNum: '11',
                        dataName: 'repayAwayMoney'
                    },
                    {
                        colNum: '12',
                        dataName: 'stayMoney'
                    }
                ]
            }
        });
    });

    //计息信息
    function interestView(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (data) {
            var url = "";
            if (data.sendBillCode != null) {
                url = basePath + "/cms/loan/cmsloaninfo/interestView?loanAcc=" + data.loanAcc
            }
            if (bt.navtab) {
                bt.navtab.addNavtab(bt.lang('common.view.data'), url);
                return;
            }
            parent.layer.open({
                type: 2,
                area: ['850px', '530px'],
                maxmin: true,
                content: url
            });
        }
    }

    //查看
    function view(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (data) {
            var url = "";
            if (data.sendBillCode != null) {
                url = basePath + "/cms/loan/cmsloansend/queryView?type=2&billCode=" + data.sendBillCode
            } else {
                url = basePath + "/cms/loan/cmsloansend/queryView?type=1&billCode=" + data.infoBillCode
            }
            if (bt.navtab) {
                bt.navtab.addNavtab(bt.lang('common.view.data'), url);
                return;
            }
            parent.layer.open({
                type: 2,
                area: ['850px', '530px'],
                maxmin: true,
                content: url
            });
        }
    }

    //发放列表
    function sendInfolist(billCode) {
        if (billCode) {
            if (bt.navtab) {
                bt.navtab.addNavtab(bt.lang('cms.loan.send.detail'), basePath + "/cms/loan/cmsloaninfo/sendInfolist?billCode=" + billCode + "&type=1");
                return;
            }
        }
    }


    //还款列表
    function repayInfolist(sendCode, type) {
        if (sendCode) {
            if (bt.navtab) {
                bt.navtab.addNavtab(bt.lang('cms.loan.repay.detail'), basePath + "/cms/loan/cmsloansend/repayInfolist?sendCode=" + sendCode + "&type=" + type);
                return;
            }
        }
    }

    //展期列表
    function deferredInfolist(sendCode) {
        if (sendCode) {
            if (bt.navtab) {
                bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/loan/cmsloandeferred/deferredInfolist?liCode=" + sendCode);
                return;
            }
        }
    }


    //日志列表
    function listMsg(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (data) {
            var billCode = "";
            if (data.sendBillCode != null) {
                billCode += data.infoBillCode + "," + data.sendBillCode
            } else {
                billCode += data.infoBillCode;
            }
            if (bt.navtab) {
                bt.navtab.addNavtab(bt.lang('common.button.logInfo'), basePath + "/cms/basedata/cmsprocessmsg/list?billCode=" + billCode);
                return;
            }
        }
    }

    /**
     * 查看合同信息
     * @param el
     */
    function conView(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        var conId = data.conId;
        parent.layer.open({
            type: 2,
            area: ['1080px', '720px'],
            maxmin: true,
            content: basePath + "/contract/conCommon/conView?id=" + conId
        });
    }

    /**判断字符串是否为空*/
    bt.empty = function (ms) {
        if (typeof (ms) == "undefined" || ms == null || ms == "" || ms == " ") {
            return true;
        }
        return false;
    }

</script>
</html>

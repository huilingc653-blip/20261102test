<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
	<input id="id" name="id" type="hidden" value="$!{cmsLoanDeferredPage.id}">
	<table class="layui-table">
		<colgroup>
			    <col width="15%">
			    <col width="35%">
			    <col width="15%">
			    <col width="35%">
		  	</colgroup>
			<tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label>#springMessage('table.cmsLoanInfo.createDate')</label>&nbsp;&nbsp;
					$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.createDate)
				</td>
			</tr>
        	##申请单位
				<td class="textRight">#springMessage('table.cmsLoanInfo.corp')</td>
				<td>
				<span>$!{cmsLoanInfoPage.corpName}</span>
				</td>
				<td class="textRight" colspan="2"></td>
			</tr>
			
			<tr>
			##所属资金中心
				<td class="textRight">#springMessage('table.cmsLoanInfo.net')</td>
				<td>
					<span>$!{cmsLoanInfoPage.netName}</span>
				</td>
			##贷款类型
			<td class="textRight">#springMessage('table.cmsLoanInfo.loanGenre')</td>
			<td >
				<span>$!{cmsLoanInfoPage.loanGenreName}</span>
			</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.cmsLoanInfo.billCode')</td>	
				<td>$!{cmsLoanInfoPage.billCode}</td>	
				<td class="textRight">#springMessage('table.cmsLoanInfo.contractCode')</td>	
				<td>$!{cmsLoanInfoPage.contractCode}</td>
			</tr>
			<tr>
			##贷款金额(小写)
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanMoneyLower')</td>
				<td >
				$number.formatNumeric($!{cmsLoanInfoPage.loanMoney})
                        <input type="hidden" id="loanMoney" class="layui-input bt-biz-moneyType" data-toup="loanMoneyUpper" value="$!{cmsLoanInfoPage.loanMoney}">
				</td>
			##贷款金额(大写)
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanMoneyUpper')</td>
				<td >
						<div id="loanMoneyUpper"></div>
				</td>							
			</tr>
			<tr>
			##贷款日期
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanDate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.loanDate)
				</td>
			##还款日期
				<td class="textRight">#springMessage('table.cmsLoanDeferred.matureDate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.repayDate)
				</td>
			</tr>
			<tr>
			##还款方式
				<td class="textRight">#springMessage('table.cmsLoanInfo.repayType')</td>
				<td >
					${cmsLoanInfoPage.repayTypeName}
				</td>
       		##贷款种类
			<td class="textRight">#springMessage('table.cmsLoanInfo.loanClass')</td>
			<td >
				$dictTag.get("cms.LoanClass",${cmsLoanInfoPage.loanClass}) 
			</td>
			</tr>
			<tr>
			##用途
				<td class="textRight">#springMessage('table.cmsLoanInfo.purpose')</td>
				<td >
				$!{cmsLoanInfoPage.purpose}
				</td>
			##放款币种
				<td class="textRight">#springMessage('table.cmsLoanInfo.curCode')</td>
				<td >
					<div class="layui-input-inline">
					$!{cmsLoanInfoPage.curName}
					</div>
				</td>								
			</tr>
			<tr>
			##贷款期限
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanTerm')</td>
				<td >
						<div class="layui-inline">
						<span>$!{cmsLoanInfoPage.loanTerm}</span>
						</div>
						<div class="layui-inline">	
						<span>
						$!dictTag.get("cms.loan.ternUnit",${cmsLoanInfoPage.ternUnit}) 
						</span>   
						</div>
				</td>
			##放款利率
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanRate')</td>
				<td >
   				$rateTag.show($!{cmsLoanInfoPage.loanRate}) 
				</td>
			</tr>
			<tr>
			##备注
				<td class="textRight">#springMessage('table.cmsLoanInfo.rmk')</td>
				<td colspan="3">
						<textarea style="min-height:70px"
							    class="layui-textarea" readonly="readonly">$!{cmsLoanInfoPage.rmk}</textarea>
										</td>
			</tr>
        	</tbody>
        </table>
        
        <table class="layui-table">
		<colgroup>
			    <col width="15%">
			    <col width="35%">
			    <col width="15%">
			    <col width="35%">
		  	</colgroup>
			<tbody>
				<tr>
					<td class="textRight">#springMessage("table.cmsLoanSend.contractCode")</td>
					<td>$!{cmsLoanSendPage.contractCode}</td>
					<td class="textRight"></td>
					<td></td>
				</tr>
				<tr>
				##浮动方式
					<td class="textRight">#springMessage('table.cmsLoanInfo.floatWay')</td>
					<td>
						$dictTag.get("Cms.FloatWay",${cmsLoanSendPage.floatWay}) 
						&nbsp;&nbsp;&nbsp;&nbsp;
						#set($postfix ="") 
						#if(${cmsLoanInfoPage.floatWay} == "03")
							#set($postfix = "Month")
						#elseif(${cmsLoanInfoPage.floatWay} == "04")
							#set($postfix = "Season")
						#elseif(${cmsLoanInfoPage.floatWay} == "05")
							#set($postfix = "HY")
						#elseif(${cmsLoanInfoPage.floatWay} == "06")
							#set($postfix = "Year")
						#end
						$dictTag.get("Cms.FloatWay$postfix",${cmsLoanInfoPage.floatWayNext})
					</td>
				##计息方式
					<td class="textRight">#springMessage('table.cmsLoanInfo.interestWay')</td>
					<td>
						$dictTag.get("Admin.PredrawSign",${cmsLoanSendPage.interestWay}) 
					</td>
				</tr>
				#if($cmsLoanSendPage.floatWay!='01')
				<tr>
				##浮动利率
					<td class="textRight">#springMessage('cms.loan.floatRate')</td>
					<td>
						$!{cmsLoanInfoPage.referenceRateTypeName}<br><br>
						$!{cmsLoanInfoPage.repayCycleName} <br><br>
						$dictTag.get("Cms.PointsProportion",${cmsLoanSendPage.pointsProportionSelect})&nbsp;
						$number.formatNumeric($number.formatNumeric($!{cmsLoanSendPage.pointsProportionText})) 
					</td>
				##利率调整生效日期
					<td class="textRight">#springMessage('table.cmsLoanInfo.rateEntriesEffectDate')</td>
					<td>
						$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.rateEntriesEffectDate)
					</td>
				</tr>
				#end 
				<tr>
				##贷款利率
					<td class="textRight">#springMessage('table.cmsLoanSend.loanRate')</td>
					<td>
					$rateTag.show($!{cmsLoanSendPage.loanRate})
                    </td>
				##逾期利率
					<td class="textRight">#springMessage('table.cmsLoanSend.overdueRate')</td>
					<td>
					$rateTag.show($!{cmsLoanSendPage.overdueRate})
                    </td>					
				</tr>
				<tr>
				##展期利率
					<td class="textRight">#springMessage('table.cmsLoanSend.deferredRate')</td>
					<td>
					$rateTag.show($!{cmsLoanSendPage.deferredRate}) 
                    </td>						
				##本次放款金额
					<td class="textRight">#springMessage('table.cmsLoanSend.loanMoney')</td>
					<td>
					$number.formatNumeric($!{cmsLoanSendPage.loanMoney})
					</td>
				</tr>
				<tr>
				##贷款发放日期
					<td class="textRight">#springMessage('table.cmsLoanSend.loanDate')</td>
					<td>$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.loanDate)</td>
				##贷款到期日期
					<td class="textRight">#springMessage('cms.common.deadlineDate')</td>
					<td>
						$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.repayDate)
					</td>
				</tr>
				<tr>
				##贷款发放方式
					<td class="textRight">#springMessage('table.cmsLoanSend.loanSendOutType')</td>
					<td>
						$dictTag.get("cms.loan.loanSendOutType",${cmsLoanSendPage.loanSendOutType}) 
					</td>
				##还款方式
					<td class="textRight">#springMessage('table.cmsLoanSend.repayType')</td>
					<td>
						${cmsLoanInfoPage.repayTypeName}
					</td>
				</tr>
        	</tbody>
        </table>
        
        <table class="layui-table">
			<colgroup>
				<col width="15%">
				<col width="35%">
				<col width="15%">
				<col width="35%">
			</colgroup>
				<tbody>
					<tr>
	        		##上期展期到期日期
	        		<td class="textRight">#springMessage('table.cmsLoanDeferred.lastDeferredReplayDate')</td><td>
	        		<input type="hidden" id="lastdeferredReplayDate"  class="layui-input bt-biz-dateType" data-type="date" value="$!date.format('yyyy-MM-dd',$!lastDeferredReplayDate)" data-biz-name="lastdeferredReplayDate">
	        		$!date.format('yyyy-MM-dd',$!lastDeferredReplayDate)
	        		</td>
	        		##已展期次数
	        		<td class="textRight">#springMessage('table.cmsLoanDeferred.deferredNum')</td><td>
	        		$!{deferredNum}
	        		</td>
	        		</tr>
					<tr>
						<td class="textRight">#springMessage('table.cmsLoanDeferred.deferredRepayDate')</td>
						<td>
						$!date.format('yyyy-MM-dd',$!cmsLoanDeferredPage.deferredRepayDate)
						</td>
						<td class="textRight">#springMessage('table.cmsLoanDeferred.deferredLimt')</td>
						<td>
						$!{cmsLoanDeferredPage.deferredLimt}
						#if($cmsLoanDeferredPage.ternUnit==2)
							#springMessage('cms.loan.ternUnit.day')
						#elseif($cmsLoanDeferredPage.ternUnit==1)
							#springMessage('cms.loan.ternUnit.month')
						#end
						</td>
					</tr>
					<tr>
						<td class="textRight">#springMessage('table.cmsLoanInfo.deferredRate')</td>
						<td>
							$rateTag.show($!{cmsLoanDeferredPage.deferredRate})
						</td>
						<td class="textRight">#springMessage('table.cmsLoanDeferred.contractCode')</td>
						<td>$!{cmsLoanDeferredPage.contractCode}</td>
					</tr>
					<tr>
					<td class="textRight">#springMessage('table.cmsLoanDeferred.rmk')</td>
					<td colspan="3">
						<textarea id="rmk" name="rmk" style="min-height:70px"
									    class="layui-textarea" placeholder="#springMessage('table.cmsLoanDeferred.rmk')" readonly="readonly">$!{cmsLoanDeferredPage.rmk}</textarea>
					</td>
					</tr>
					<tr>
					<td colspan="4" style="text-align: center;">
						<button class="layui-btn" lay-submit="" value="1" lay-filter="submit">#springMessage('common.button.sure')</button>
						<button class="layui-btn" lay-submit="" value="0" lay-filter="submit">#springMessage('common.button.back')</button>
						<button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
					</td>
			</tr>
				</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/loan/cmsLoanDeferred.handle.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{cmsLoanRepayPage.id}">
        <table class="layui-table">
        	<colgroup>
        		<col width="15%">
        		<col width="35%">
        		<col width="15%">
        		<col width="35%">
        	</colgroup>
            <tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label>#springMessage('table.cmsLoanInfo.createDate')</label>&nbsp;&nbsp;
					<div class="layui-input-inline">
					$!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.createDate)
					</div>
				</td>
			</tr>
			<tr>
        	##申请单位
				<td class="textRight">#springMessage('table.cmsLoanInfo.corp')</td>
				<td colspan="3">
				<span>$!{cmsLoanInfoPage.corpName}</span>
				</td>
			</tr>
			<tr>
			##所属资金中心
				<td class="textRight">#springMessage('table.cmsLoanInfo.net')</td>
				<td>
					<span>$!{cmsLoanInfoPage.netName}</span>
				</td>
			##贷款类型
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanGenre')</td>
				<td >
					<span>$!{cmsLoanInfoPage.loanGenreName}</span>
				</td>
			</tr>
			<tr>
			##贷款单号
				<td class="textRight">#springMessage('table.cmsLoanInfo.billCode')</td>
				<td >
					<span>$!{cmsLoanInfoPage.billCode}</span>
				</td>
			##合同号
				<td class="textRight">#springMessage('table.cmsLoanInfo.contractCode')</td>
				<td >
					<span>$!{cmsLoanInfoPage.contractCode}</span>
				</td>
			</tr>
			<tr>
			##贷款发放编号
				<td class="textRight" >#springMessage('table.cmsLoanSend.billCode')</td>
				<td colspan="3">
				<span>$!{cmsLoanSendPage.billCode}</span>
				</td>
			</tr>
			#if($isAccounting)
			<tr>
			##贷款账号
				<td class="textRight">#springMessage('table.cmsLoanInfo.provideLoanAcc')</td>
				<td >
					<span>$!{cmsLoanSendPage.loanAcc}<span>
				</td>
			##还款账号
				<td class="textRight">#springMessage('table.cmsLoanRepay.repayAcc')</td>
				<td >
					$!{cmsLoanSendPage.provideLoanAcc}</span></span>
				</td>
			</tr>
			#end
			<tr>
			##放款币别
				<td class="textRight">#springMessage('table.cmsLoanInfo.curCode')</td>
				<td >
					<div class="layui-input-inline">
					$!{cmsLoanInfoPage.curName}
					</div>
				</td>
			##放款金额
				<td class="textRight">#springMessage('table.cmsLoanSend.loanMoney')</td>
				<td >
				$number.formatNumeric($!{cmsLoanSendPage.loanMoney})
				</td>
			</tr>
			<tr>
			##还款在途金额
				<td class="textRight">#springMessage('table.cmsLoanRepay.inwayMoney')</td>
				<td >
				$number.formatNumeric($!{inwayMoney})
				</td>
			##已还金额
				<td class="textRight">#springMessage('table.cmsLoanRepay.processMoney')</td>
				<td >
				$number.formatNumeric($!{rpayedMoney})
				</td>
			</tr>
			<tr>
			##贷款发放日期
				<td class="textRight">#springMessage('table.cmsLoanSend.loanDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.loanDate)</td>
			##到期日期
				<td class="textRight">#springMessage('cms.common.deadlineDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.repayDate)</td>
			</tr>
			<tr>
			<td class="textRight">#springMessage('table.fcAcc.delayDeadlineDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!deferredRepayDate)</td>
					##还款类型
					<td class="textRight">#springMessage('table.cmsLoanRepay.repayType')</td>
					<td>
					<div class="bt-biz-dict" data-type="select" data-group="cms.repayType" data-defaultvalue="$!{cmsLoanRepayPage.repayType}" data-name="repayType" data-biz-name="repayType" data-callback="changeRepayType"></div>
					<input type="hidden" id="initRepayType" value="$!{cmsLoanRepayPage.repayType}">
					</td>
			</tr>
			<tr>
			##还款日期
				<td class="textRight">#springMessage('table.cmsLoanRepay.repayDate')</td>
				<td>
				$!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.repayDate)
				<input type="hidden" name="repayDate" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.repayDate)" data-type="date" id="repayDate" data-biz-name="repayDate">
				</td>
			##还款金额
				<td class="textRight">#springMessage('table.cmsLoanRepay.repayMoney')</td>
				<td>
					<div class="layui-inline">
					<span id="repayMoneyShow">
					#if($cmsLoanRepayPage.repayType==4)
						$number.formatNumeric(0)
					#else
						$number.formatNumeric($!{cmsLoanRepayPage.repayMoney})
					#end
					</span>
					</div>
				</td>
			</tr>
			<tr>
			##还款利息
        			<td class="textRight">#springMessage('table.cmsLoanRepay.repayAccrual')</td>
					<td>
						<div class="layui-inline">
						<input type="text" data-name="repayAccrual" class="layui-input bt-biz-moneyType" data-biz-name="repayAccrual" value="$!{cmsLoanRepayPage.repayAccrual}"  placeholder="#springMessage('table.fcInterestDtlTemp.interest')" readonly="readonly">
						</div>
						#if($isAccounting)
						<button  type="button" id="lixqdButton" class="layui-btn layui-btn-small" onClick="showlxqd()" >#springMessage('table.interet.lxqd')</button>
						#end
						<span id="curAccrualShow" style="color: red"></span>
						<input type="hidden" id="SyncAccrual" value="">
					</td>
				##还款方式
				<td class="textRight">#springMessage('table.cmsLoanSend.repayType')</td>
				<td id="repayway">
					$!{repayTypeName}
				</td>
			</tr>
			<tr>
					<td colspan="4" style="text-align: center;">
						<button class="layui-btn" lay-submit="" value="1" lay-filter="submit">#springMessage('common.button.sure')</button>
						<button class="layui-btn" lay-submit="" value="0" lay-filter="submit">#springMessage('common.button.back')</button>
						<button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
					</td>
			</tr>
        	</tbody>
		</table>
		<input type="hidden" id ="sendCode" name="sendCode" value="$!{cmsLoanSendPage.billCode}"><!-- 发放编号 -->
		<input type="hidden" id="repayAccrual2" value="$!{cmsLoanRepayPage.repayAccrual}"<!-- 还款利息 -->
		<input type="hidden" id ="sendId" value="$!{cmsLoanSendPage.id}"><!-- 发放编号 -->
		<input type="hidden" id ="closeDay" value="$!{closeDay}"><!-- 日结日期 -->
		<input type="hidden" id="loanAcc" value="$!{cmsLoanSendPage.loanAcc}"><!-- 贷款账号 -->
		<input type="hidden" id="provideLoanAcc" value="$!{cmsLoanSendPage.provideLoanAcc}"><!-- 发放账号 -->
		<input type="hidden" id="repayMoney" value="$!{cmsLoanRepayPage.repayMoney}"><!-- 还款金额 -->
		<input type="hidden" id="sendMoney" value="$!{cmsLoanSendPage.loanMoney}"><!--发放金额 -->
		<input type="hidden" id="orderNo" value=""><!-- 利息流水号-->
		<input type="hidden" id="repayDate" value="$!date.format('yyyy-MM-dd',$!cmsLoanRepayPage.repayDate)"><!-- 还款日期 -->
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/loan/cmsRepayAffirm.edit.js?_btv=${resourceVersion}"></script>
</html>

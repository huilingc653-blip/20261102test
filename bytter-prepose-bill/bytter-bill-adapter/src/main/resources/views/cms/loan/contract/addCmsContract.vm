<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <table class="layui-table">
        	<thead>
        		<tr><td align="center">#springMessage('table.cmsContract.contractInfo')</td></tr>
        	</thead>
			<tbody>
			<tr>
				<td>
					<textarea id="contractInfo" name="contractInfo"  style="min-height:350px" lay-verify="required"
							    class="layui-textarea" placeholder="#springMessage('table.cmsContract.contractInfo')">$!{cmsContractPage.contractInfo}</textarea>
				</td>
			</tr>
			</tr>
				<tr>
					<td style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
						<button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
					</td>
				</tr>
        	</tbody>
        </table>
        <input type="hidden" name="contractCode" value="$!{cmsContractPage.contractCode}">
        <input type="hidden" name="liCode" value="$!{cmsContractPage.liCode}">
        <input type="hidden" name="corpId" value="$!{cmsContractPage.corpId}">
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/loan/cmsContract.add.js?_btv=${resourceVersion}"></script>
</html>
#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
	<ul class="mui-table-view" id="mulTable">
		##创建日期
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanDeferred.createDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!cmsLoanDeferredPage.createDate)
        </span>
    	</li>
		##申请单位
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.corp')
        <span class="mui-badge mui-badge-inverted">
            $!{cmsLoanInfoPage.corpName}
        </span>
    	</li>
    	##贷款流水号
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.billCode')
        <span class="mui-badge mui-badge-inverted">
            $!{cmsLoanInfoPage.billCode}
        </span>
    	</li>
    	##贷款发放编号
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanDeferred.liCode')
        <span class="mui-badge mui-badge-inverted">
            $!{cmsLoanDeferredPage.liCode}
        </span>
    	</li>
    	##放款金额
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.loanMoney')
        <span class="mui-badge mui-badge-inverted">
            $number.formatNumeric($!{cmsLoanSendPage.loanMoney})
        </span>
    	</li>
    	##贷款发放日期
    	<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.loanDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!cmsLoanSendPage.loanDate)
        </span>
    	</li>
    	##到期日期
    	<li class="mui-table-view-cell">
        #springMessage('cms.common.deadlineDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!cmsLoanSendPage.repayDate)
        </span>
    	</li>
    	#if($!deferredNum>0)
    		##已展期次数
	    	<li class="mui-table-view-cell">
	        #springMessage('table.cmsLoanDeferred.deferredNum')
	        <span class="mui-badge mui-badge-inverted">
	            $!{deferredNum}#springMessage('cms.load.count')
	        </span>
	    	</li>
    		##上期展期到期日期
	    	<li class="mui-table-view-cell">
	        #springMessage('table.cmsLoanDeferred.lastDeferredReplayDate')
	        <span class="mui-badge mui-badge-inverted">
	            $!date.format('yyyy-MM-dd',$!lastDeferredReplayDate)
	        </span>
	    	</li>
    	#end
    	##展期到期日
    	<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanDeferred.deferredRepayDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!cmsLoanDeferredPage.deferredRepayDate)
        </span>
    	</li>
    	##展期期限
    	<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanDeferred.deferredLimt')
        <span class="mui-badge mui-badge-inverted">
            $!{cmsLoanDeferredPage.deferredLimt}&nbsp;
            $dictTag.get("cms.loan.ternUnit",${cmsLoanDeferredPage.ternUnit})
        </span>
    	</li>
    	##展期利率
    	<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.deferredRate')
        <span class="mui-badge mui-badge-inverted">
            $rateTag.show($!{cmsLoanDeferredPage.deferredRate})
        </span>
    	</li>
    	##展期合同号
    	<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanDeferred.contractCode')
        <span class="mui-badge mui-badge-inverted">
            $!{cmsLoanDeferredPage.contractCode}
        </span>
    	</li>
    	##备注
		<li class="mui-table-view-cell">
		#springMessage('table.cmsLoanDeferred.rmk')
		<textarea rows="3" class="layui-textarea" readonly="readonly">$!{cmsLoanDeferredPage.rmk}</textarea>
		</li>
	</ul>
	#parse("views/common/wapfooter.vm")
</body>
</html>
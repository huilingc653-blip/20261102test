<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
<input type="hidden" id="pageType" value="$!{pageType}">
		<table class="layui-table">
            <tr>
                ##申请单位
                <td  class="textRight">#springMessage('table.cmsLoanInfo.corp')</td>
                <td >
                    <div class="layui-inline">
                        <div class="bt-biz-corp"
                             data-type="selectTree"
                             data-tree-type="check"
                             data-name="ins_corpId"
                             data-scope="all"
                             data-placeholder="#springMessage('common.placeholder.select')"
                             data-resource="cms:loan:cmsloanrepair:query"
                        >
                        </div>
                    </div>
                </td>
                ##贷款日期
                <td  class="textRight">#springMessage('table.cmsLoanInfo.loanDate')</td>
                <td >
                    <div class="layui-inline">
                        <input type="text" name="ged_loanDate" data-biz-name="ged_loanDate" class="layui-input bt-biz-dateType" data-endid="loanDate" data-type="date" value="$!{receDate}">
                    </div>
                    <span class="date-mid">~</span>
                    <div class="layui-inline">
                        <input type="text" name="led_loanDate"  data-name="led_loanDate" class="layui-input bt-biz-dateType" id="receDate" data-type="date">
                    </div>
                </td>
            </tr>
		<tr>
            ##贷款金额
            <td  class="textRight">#springMessage('table.cmsLoanInfo.loanMoney')</td>
            <td >
                <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text" data-name="geg_loanMoney"
                       data-moneyendid="leg_loanMoney" placeholder="#springMessage('table.cmsLoanInfo.loanMoney')" />
                <span class="date-mid">~</span>
                <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_loanMoney" type="text"
                       data-name="leg_loanMoney" placeholder="#springMessage('table.cmsLoanInfo.loanMoney')" />
            </td>

			<td  class="textRight">#springMessage('table.cmsLoanInfo.billCode')</td>
			<td >
				<input type="text" name="likes_billCode"
		                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanInfo.billCode')">
			</td>
		</tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
                    <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
                </td>
            </tr>
		</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsLoanInfo.corp')</th><!--申请单位  -->
        <th>#springMessage('table.cmsLoanInfo.net')</th><!--所属资金中心   -->
        <th>#springMessage('table.cmsLoanInfo.billCode')</th><!--贷款单号  -->
        <th>#springMessage('table.cmsLoanInfo.createDate')</th><!--录入日期  -->
        <th>#springMessage('table.cmsLoanInfo.curCode')</th><!--币别  -->
        <th style="text-align: center;">#springMessage('table.cmsLoanInfo.loanMoney')</th><!-- 贷款金额 -->
        <th>#springMessage('table.cmsLoanInfo.loanDate')</th><!--合同开始日  -->
        <th>#springMessage('table.cmsLoanDeferred.matureDate')</th><!--合同到期日  -->
        <th>#springMessage('table.cmsLoanInfo.repayType')</th><!--还款方式  -->
        <th>#springMessage('table.cmsLoanInfo.loanClass')</th><!--贷款种类  -->
        <!-- <th>#springMessage('table.cmsLoanInfo.loanType')</th>担保方式  -->
        <th>#springMessage('table.cmsLoanInfo.loanTerm')</th><!--贷款期限  -->
        <th>#springMessage('table.cmsLoanInfo.status')</th><!--状态  -->
        <th style="width:134px">#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/loan/cmsLoanInfolist.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form">
<div class="line-big">
    <div class="xb4" align="center">#springMessage('table.fcChargeType.curCode')：$!{curName}</div>
    <div class="xb4" align="center">#springMessage('table.nisBillhead.corpId')：$!{corpName}</div>
    <div class="xb4" align="center">#springMessage('table.interet.AccType')：$!{subjectName}</div>
</div>
	<table id="jxTb" style='width:100%' class="layui-table">
	                    <thead>
	                        <tr>
	                            <th>#springMessage('table.fcAccuBalance.account')</th><!--账号  -->
	                            <th>#springMessage('table.fcAcc.accName')</th><!--户名  -->
                            	<th>#springMessage('table.fcInterestDtlTemp.interestStartDate')</th><!--起息日期  -->
                            	<th>#springMessage('table.fcInterestDtlTemp.blnInstDate')</th><!--结束日期  -->
	                            <th>#springMessage('table.fcInterestDtlTemp.days')</th><!--天数  -->
	                            <th>#springMessage('table.fcInterestDtlTemp.cumulation')</th><!--积数  -->
	                            <th>#springMessage('table.fcInterestDtlTemp.interestRate')</th><!--利率  -->
                            	<th>#springMessage('table.fcInterestDtlTemp.interest')</th><!--利息  -->
                            	<th>#springMessage('table.fcInterestDtlTemp.rateType')</th><!--利率类型  -->
	                            <th>#springMessage('table.fcInterestDtlTemp.interestType')</th><!--计息类型  -->
	                        </tr>
	                    </thead>
	                    <tbody>
	                    #set($interestNum = 0)
	                    #if($interetDtls.size()>0)
	                    	#foreach($interestDtl in $interetDtls)
	                    		#set($interestNum = $interestNum + $interestDtl.interest)
	                    		<tr>
	                    			<td align="center" width="12%">$interestDtl.account</td>
	                    			<td align="center" width="12%">$!{accName}</td>
	                    			<td align="center" width="9%">$!date.format('yyyy-MM-dd',$interestDtl.interestStartDate)</td>
	                    			<td align="center" width="9%">$!date.format('yyyy-MM-dd',$!interestDtl.blnInstDate)</td>
	                    			<td align="center" width="8%">$interestDtl.days</td>
	                    			<td align="right" width="8%">$!number.formatNumeric($interestDtl.cumulation)</td>
	                    			<td align="center" width="8%">$rateTag.show($interestDtl.interestRate)</td>
	                    			<td align="right" width="8%">$!number.formatNumeric($interestDtl.interest)</td>
	                    			<td align="center" width="9%">$dictTag.get("interest.type",$!{interestDtl.interestType})</td>
	                    			<td align="center" width="9%">$dictTag.get("interest.sign",$!{interestDtl.interestSign})</td>
	                    		</tr>
							#end
							<tr>
								<td colspan=6></td>
								<td></td>
								<td align=right>$!{interestNum}</td>
								<td></td>
								<td></td>
							  </tr>
							<tr>
								<td colspan=6 rowspan=2></td>
								<td rowspan=2>#springMessage('table.interet.vourcherfl')</td><!-- 凭证分录 -->
								<td colspan=3>$!{voucherInfo[0]}</td>
							  </tr>
							   <tr>
								<td colspan=3>$!{voucherInfo[1]}</td>
							  </tr>
							  #else
							  <tr>
								<td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td>
								<td></td><td></td><td></td><td></td>
							  </tr>
							  <tr>
								<td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td>
								<td></td><td></td><td></td><td></td>
							  </tr>
							  <tr>
								<td colspan=6>&nbsp;</td><td></td><td></td><td></td><td></td>
							  </tr>
							  <tr>
								<td colspan=6 rowspan=2>&nbsp;</td>
								<td rowspan=2>#springMessage('table.interet.vourcherfl')</td><!-- 凭证分录 -->
								<td colspan=3>&nbsp;</td>
							  </tr>
							   <tr>
								<td colspan=3>&nbsp;</td>
							  </tr>
							  #end
	                    </tbody>
	                </table>
</form>	                
#parse("views/common/footer.vm")
</body>
</html>
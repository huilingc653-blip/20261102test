<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>

<body>
<table class="layui-table" width="100%">
    <thead>
    <tr>
        <th>#springMessage('table.fcInterestDtl.account')</th>
        <th>#springMessage('table.nisPersonnelDetail.accName')</th>
        <th>#springMessage('table.fbsBudgetDetail.curId')</th>
        <th>#springMessage('table.fcBond.operateTime')</th>
        <th>#springMessage('table.fcInterestDtl.interestStartDate')</th>
        <th>#springMessage('table.interet.blnInstDate')</th>
        <th>#springMessage('table.fcInterestDtl.days')</th>
        <th>#springMessage('table.fcInterestDtl.cumulation')</th>
        <th>#springMessage('table.fcInterestDtl.interestRate')</th>
        <th>#springMessage('table.fcInterestDtl.interest')</th>
        <th>#springMessage('table.fcInterestDtl.interestSign')</th>
    </tr>
    </thead>
    <body>
        #if($!interestList)
            #foreach($interest in $interestList)
            <tr>
                <td>$!{interest.account}</td>
                <td>$!{interest.accName}</td>
                <td>$!{interest.curName}</td>
                <td>$!date.format('yyyy-MM-dd',$!{interest.interestTime})</td>
                <td>$!date.format('yyyy-MM-dd',$!{interest.interestStartDate})</td>
                <td>$!date.format('yyyy-MM-dd',$!{interest.blnInstDate})</td>
                <td>$!{interest.days}</td>
                <td>$!number.formatNumeric($!{interest.cumulation})</td>
                <td>$!number.formatNumeric($!{interest.interestRate})</td>
                <td>$!number.formatNumeric($!{interest.interest})</td>
                <td>$!{interest.interestSignName}</td>
            </tr>
            #end
        #end
    </body>
</table>
    #parse("views/common/footer.vm")
</body>
</html>

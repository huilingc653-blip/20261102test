<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<form id="searchForm" class="layui-form">
	<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
	<input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
		<table class="layui-table">
		<tr>
			<td width="10%" class="textRight">#springMessage('table.cmsLoanSend.billCode')</td>
			<td width="20%">
				<input type="text" name="likes_liCode" autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanSend.billCode')">
			</td>
			<td width="70%">
				<button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
				<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
			</td>
		</tr>
		</table>
</form>
<body>
	<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsLoanDeferred.billCode')</th><!--展期单号  -->
    	<th>#springMessage('table.cmsLoanDeferred.liCode')</th><!--发放单号  -->
    	<th>#springMessage('table.cmsLoanDeferred.createDate')</th><!--录入时间  -->
    	<th>#springMessage('cms.common.deadlineDate')</th><!--还款日期  -->
    	<th>#springMessage('table.cmsLoanDeferred.deferredRepayDate')</th><!--展期到期日期  -->
    	<th>#springMessage('table.cmsLoanDeferred.deferredLimt')</th><!--展期期限  -->
    	<th>#springMessage('table.cmsLoanDeferred.contractCode')</th><!--展期合同号  -->
        <th>#springMessage('table.cmsLoanInfo.corp')</th><!--申请单位  -->
        <th>#springMessage('table.cmsLoanInfo.net')</th><!--所属资金中心   -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>

	#workFlowHtml()
	#parse("views/common/footer.vm")
	#workFlowScript()
	<script src="${basePath}/static/modules/cms/loan/cmsLoanDeferredApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>




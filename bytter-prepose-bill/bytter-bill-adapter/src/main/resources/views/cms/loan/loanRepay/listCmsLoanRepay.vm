<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
		<table class="layui-table">
		<tr>
			<td width="10%" class="textRight">#springMessage('table.cmsLoanRepay.billCode')</td>
			<td width="20%">
				<input type="text" name="likes_billCode"
		                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanRepay.billCode')">
			</td>
			<td width="70%">
				<button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
				<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
			</td>
		</tr>
		</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
    	<th>#springMessage('table.cmsLoanInfo.corp')</th><!--申请单位  -->
        <th>#springMessage('table.cmsLoanInfo.net')</th><!--所属资金中心   -->
        <th>#springMessage('table.cmsLoanRepay.billCode')</th><!--还款单号   -->
        <th>#springMessage('table.cmsLoanRepay.createDate')</th><!--还款单号   -->
        <th>#springMessage('table.cmsLoanRepay.sendCode')</th><!-- 贷款发放单号 -->
        <th>#springMessage('table.cmsLoanRepay.repayMoney')</th><!-- 还款金额 -->
        <th>#springMessage('table.cmsLoanRepay.repayDate')</th><!-- 还款日期 -->
        <th>#springMessage('table.fcAcc.curId')</th><!-- 币别 -->
        <th>#springMessage('table.cmsLoanRepay.status')</th><!-- 状态 -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/loan/cmsLoanRepay.list.js?_btv=${resourceVersion}"></script>
</html>

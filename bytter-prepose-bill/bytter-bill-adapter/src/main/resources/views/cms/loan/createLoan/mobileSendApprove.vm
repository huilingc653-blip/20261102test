#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
	<ul class="mui-table-view" id="mulTable">
		##贷款合同编号
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.contractCode')
        <span class="mui-badge mui-badge-inverted">
            $!{cmsLoanInfoPage.contractCode}
        </span>
    	</li>
    	##贷款发放合同号
		<li class="mui-table-view-cell">
        #springMessage("table.cmsLoanSend.contractCode")
        <span class="mui-badge mui-badge-inverted">
            $!{cmsLoanSendPage.contractCode}
        </span>
    	</li>
    	##浮动方式
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.floatWay')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("Cms.FloatWay",${cmsLoanSendPage.floatWay}) 
            &nbsp;&nbsp;&nbsp;&nbsp;
			#set($postfix ="") 
			#if(${cmsLoanSendPage.floatWay} == "03")
				#set($postfix = "Month")
			#elseif(${cmsLoanSendPage.floatWay} == "04")
				#set($postfix = "Season")
			#elseif(${cmsLoanSendPage.floatWay} == "05")
				#set($postfix = "HY")
			#elseif(${cmsLoanSendPage.floatWay} == "06")
				#set($postfix = "Year")
			#end
			$dictTag.get("Cms.FloatWay$postfix",${cmsLoanSendPage.floatWayNext})
        </span>
    	</li>
    	##计息方式
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.interestWay')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("Admin.PredrawSign",${cmsLoanSendPage.interestWay})
        </span>
    	</li>
    	##浮动利率
    	#if($cmsLoanSendPage.floatWay!='01')
    		<li class="mui-table-view-cell">
	      	#springMessage('cms.loan.floatRate')(#springMessage('table.cmsLoanType.type'))
	        <span class="mui-badge mui-badge-inverted">
					$!{cmsLoanSendPage.referenceRateTypeName} 
	        </span>
	    	</li>
	    	<li class="mui-table-view-cell">
	    		#springMessage('cms.loan.floatRate')(#springMessage('table.cmsLoanInfo.ternUnit'))
	    		<span class="mui-badge mui-badge-inverted">
	    			$!{cmsLoanSendPage.repayCycleName}
	    		</span>
	    	</li>
	    	<li class="mui-table-view-cell">
	    	#springMessage('cms.loan.floatRate')(#springMessage('table.cmsLoanInfo.pointsProportionSelect'))
	    		<span class="mui-badge mui-badge-inverted">
	    			$dictTag.get("Cms.PointsProportion",${cmsLoanSendPage.pointsProportionSelect})&nbsp;
					$number.formatNumeric($number.formatNumeric($!{cmsLoanSendPage.pointsProportionText}))
	    		</span>
	    	</li>
    	#end
    	##利率调整生效日期
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanInfo.rateEntriesEffectDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!cmsLoanSendPage.rateEntriesEffectDate)
        </span>
    	</li>
    	##贷款利率
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.loanRate')
        <span class="mui-badge mui-badge-inverted">
            $rateTag.show($!{cmsLoanSendPage.loanRate})
        </span>
    	</li>
    	##逾期利率
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.overdueRate')
        <span class="mui-badge mui-badge-inverted">
            $rateTag.show($!{cmsLoanSendPage.overdueRate})
        </span>
    	</li>
    	##展期利率
		<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.deferredRate')
        <span class="mui-badge mui-badge-inverted">
            $rateTag.show($!{cmsLoanSendPage.deferredRate})
        </span>
    	</li>
    	##增值税率
    	#*<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.texRate')
        <span class="mui-badge mui-badge-inverted">
            $rateTag.show($!{cmsLoanSendPage.texRate})
        </span>
    	</li>*#
    	##支付方式
    	#*<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.payType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("cms.loan.payType",${cmsLoanSendPage.payType}) 
        </span>
    	</li>*#
    	##贷款发放日期
    	<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.loanDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!cmsLoanSendPage.loanDate) 
        </span>
    	</li>
    	##贷款到期日期
    	<li class="mui-table-view-cell">
        #springMessage('cms.common.deadlineDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!cmsLoanSendPage.repayDate) 
        </span>
    	</li>
    	##贷款发放方式
    	<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.loanSendOutType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("cms.loan.loanSendOutType",${cmsLoanSendPage.loanSendOutType}) 
        </span>
    	</li>
    	##还款方式
    	<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.repayType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("cms.LoanRepayType",${cmsLoanSendPage.repayType})
        </span>
    	</li>
    	##本次放款金额
    	<li class="mui-table-view-cell">
        #springMessage('table.cmsLoanSend.loanMoney')
        <span class="mui-badge mui-badge-inverted">
            $number.formatNumeric($!{cmsLoanSendPage.loanMoney})
        </span>
    	</li>
    	##本次放款金额(大写)
    	<li class="mui-table-view-cell">
        #springMessage('cms.precative.loan.thisSendMoney.capitalize')
        <span class="mui-badge mui-badge-inverted">
            $!{loanMoneyUpper}
        </span>
    	</li>
	</ul>
	#parse("views/common/wapfooter.vm")
</body>
</html>
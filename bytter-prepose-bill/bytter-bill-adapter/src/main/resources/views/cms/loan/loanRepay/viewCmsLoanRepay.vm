<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form">
	#parse("views/cms/loan/loanRepay/viewCmsLoanRepaySub.vm")
		#if($!{viewFlag}=="1")
            <table class="layui-table">
                <tr>
                    <td colspan="4" align="center">
                        <button class="layui-btn"  onClick="doClose()">#springMessage('common.button.close')</button>
                    </td>
                </tr>
                </tbody>
            </table>
		#end
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
	<script type="text/javascript">
bt.use(['btUpload'], function() {
	$ = bt.jquery;
	var gid = $("#annexName").val();
    var up = bt.btUpload.init({
        elem: "#uploader",
        hasUpload: false,
        isExpand: true,
        gid: gid
    }); 
	//关闭窗口
    doClose = function(){
    	if(bt.navtab){
			bt.navtab.closeCurrent();
		}
    }
});
</script>
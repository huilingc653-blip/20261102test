<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<table class="layui-table">
	<thead>
		<th>#springMessage('table.cmsLoanSend.billCode')</th><!--发放合同编号  -->
		<th>#springMessage('table.cmsLoanSend.createDate')</th><!--录入日期  -->
		<th>#springMessage('table.cmsLoanSend.curCode')</th><!--币别  -->
		<th>#springMessage('table.cmsLoanInfo.loanMoney')</th><!-- 贷款金额 -->
		<th>#springMessage('table.cmsLoanSend.loanMoney')</th><!-- 放款金额 -->
		<th>#springMessage('table.cmsLoanSend.loanDate')</th><!--合同开始日  -->
        <th>#springMessage('cms.common.deadlineDate')</th><!--合同到期日  -->
        <th>#springMessage('table.cmsLoanSend.loanRate')</th><!--利率  -->
        <th>#springMessage('table.cmsLoanSend.sendedMoney')</th><!--已放金额  -->
        <th>#springMessage('table.cmsLoanSend.loanSendOutType')</th><!--发放方式 -->
        <th>#springMessage('table.cmsLoanSend.repayType')</th><!--还款方式  -->
        <th>#springMessage('table.cmsLoanInfo.loanTerm')</th><!--贷款期限  -->
        <th>#springMessage('table.cmsLoanSend.status')</th><!--状态  -->
	</thead>
	<tbody>
	#set($sendedMoeny = 0)
	#foreach($send in $cmsloanSends)
		#if($!{send.status}!=-2 && $!{send.status}!=-1)
    		#set($sendedMoeny = $!{send.loanMoney}+$!{sendedMoeny})
    	#else
    		#set($sendedMoeny = $!{sendedMoeny}+0)
    	#end
    <tr>
    	<td align="center">$!{send.billCode}</td>
    	<td align="center">$!date.format('yyyy-MM-dd',$!send.createDate)</td>
    	<td align="center">$!{send.curName}</td>
    	<td align="right">$!number.formatNumeric($!{send.loanInfoMoney})</td>
    	<td align="right">$!number.formatNumeric($!{send.loanMoney})</td>
    	<td align="center">$!date.format('yyyy-MM-dd',$!send.loanDate)</td>
    	<td align="center">$!date.format('yyyy-MM-dd',$!send.repayDate)</td>
    	<td align="right">$rateTag.show($!{send.loanRate})</td>
    	<td align="right">$!number.formatNumeric($!{sendedMoeny})</td>
    	<td align="center">$dictTag.get("cms.loan.loanSendOutType",$!{send.loanSendOutType})</td>
    	<td align="center">$!{send.repayTypeName}</td>
    	<td align="center">
    	#if($send.ternUnit==2)
    		$!{send.loanTerm} #springMessage('cms.loan.ternUnit.day')
    	#elseif($send.ternUnit==1)
    		$!{send.loanTerm} #springMessage('cms.loan.ternUnit.month')	
    	#else
    		$!{send.loanTerm}
    	#end
        </td>
    	<td align="center">$dictTag.get("cms.bizStatus",$!{send.bizStatus})</td>
    </tr> 
	#end
	</tbody>
</table>

#parse("views/common/footer.vm")
</body>
</html>

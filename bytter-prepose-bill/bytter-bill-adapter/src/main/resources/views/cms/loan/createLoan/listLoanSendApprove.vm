<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<form id="searchForm" class="layui-form">
<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
		<table class="layui-table">
		<tr>
			<td width="10%" class="textRight">#springMessage('table.cmsLoanSend.billCode')</td>
			<td width="20%">
				<input type="text" name="likes_billCode"
		                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanSend.billCode')">
			</td>
			<td width="70%">
				<button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
				<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
			</td>
		</tr>
		</table>
</form>
<body>
	<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        
        <th>#springMessage('table.cmsLoanSend.loanCode')</th><!--贷款单号  -->
        <th>#springMessage('table.cmsLoanSend.billCode')</th><!--发放合同编号  -->
        <th>#springMessage('table.cmsLoanSend.createDate')</th><!--录入日期  -->
        <th>#springMessage('table.cmsLoanSend.curCode')</th><!--币别  -->
        <th>#springMessage('table.cmsLoanInfo.loanMoney')</th><!-- 贷款金额 -->
        <th>#springMessage('table.cmsLoanSend.loanMoney')</th><!-- 贷款金额 -->
        <th>#springMessage('table.cmsLoanSend.loanDate')</th><!--合同开始日  -->
        <th>#springMessage('cms.common.deadlineDate')</th><!--合同到期日  -->
        <th>#springMessage('table.cmsLoanInfo.loanRate')</th><!--利率  -->
        <th>#springMessage('table.cmsLoanInfo.loanTerm')</th><!--贷款期限  -->
        <th>#springMessage('table.cmsLoanInfo.corp')</th><!--申请单位  -->
        <th>#springMessage('table.cmsLoanInfo.net')</th><!--所属资金中心   -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>

	#workFlowHtml()
	#parse("views/common/footer.vm")
	#workFlowScript()
	<script src="${basePath}/static/modules/cms/loan/cmsLoanSendApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>




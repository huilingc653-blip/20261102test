<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{cmsContractPage.id}">
			<input id="contractCode" name="contractCode" type="hidden" value="$!{cmsContractPage.contractCode}">
			<input id="corpId" name="corpId" type="hidden" value="$!{cmsContractPage.corpId}">
			<input id="liCode" name="liCode" type="hidden" value="$!{cmsContractPage.liCode}">
        <table class="layui-table">
        	<thead>
        		<tr><td align="center">#springMessage('table.cmsContract.contractInfo')</td></tr>
        	</thead>
			<tbody>
			<tr>
				<td>
					<textarea id="contractInfo" name="contractInfo"  style="min-height:350px" lay-verify="required"
							    class="layui-textarea" placeholder="#springMessage('table.cmsContract.contractInfo')">$!{cmsContractPage.contractInfo}</textarea>
				</td>
			</tr>
			</tr>
				<tr>
					<td style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
						<button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>	
					</td>
				</tr>
				#if($pageType=="set")
				<tr>
					<td style="text-align: center;color: blue;">			
						<span>  #springMessage('cms.loan.parameter.description') :<br>	
							#springMessage('table.cmsLoanSend.contractCode')：#htbh# #springMessage('table.cmsLoanInfo.net')：#dkr# #springMessage('table.cmsLoanInfo.corp')：#jkr# #springMessage('table.cmsLoanInfo.loanClass')：#dkzl# #springMessage('cms.precative.loan.curId')：#bb# #springMessage('table.cmsLoanSend.loanMoney')：#je#<br>
							#springMessage('table.cmsPrecativeLoanInfo.purpose')：#yt# #springMessage('table.cmsLoanInfo.loanTerm')： #qx# #springMessage('cms.precative.send.sendDate')：#ksrq# #springMessage('table.cmsLoanDeferred.matureDate')：#jsrq# #springMessage('table.cmsLoanInfo.loanRate')： #lv#
						</span>
					</td>
				</tr>
				#end
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/loan/cmsContract.edit.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input type="hidden" id="liCode" value="$!{liCode}">
<table class="layui-table" id="deferredList">
	<thead>
		<tr>
			<td>#springMessage('table.cmsLoanInfo.corp')</td>
			<td>#springMessage('table.cmsLoanDeferred.billCode')</td>
			<td>#springMessage('table.cmsLoanDeferred.liCode')</td>
			<td>#springMessage('table.cmsLoanDeferred.contractCode')</td>
			<td>#springMessage('cms.common.deadlineDate')</td>
			<td>#springMessage('table.cmsLoanDeferred.deferredLimt')</td>
			<td>#springMessage('table.cmsLoanDeferred.deferredRepayDate')</td>
			<td>#springMessage('table.cmsLoanInfo.deferredRate')</td>
			<td>#springMessage('table.cmsLoanDeferred.status')</td>
		</tr>
	</thead>
</table>

#parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
bt.use(['form','datatable','moneyType','date','bttable','rateType'], function(){
    $ = bt.jquery,form = bt.form(),moneyFun=bt.moneyType.getFun();
    bt.rateType.init()
    bt.bttable.init({
            elem:"#deferredList",
            url:basePath+"/cms/loan/cmsloandeferred/deferredInfoItems",
            urldata:{
            	liCode:$("#liCode").val()
            },
            mulselect:true,
            scrollX:true,
            columns:[
				{data:"corpName"},
                {data:"billCode"},
                {data:"liCode"},
                {data:"contractCode"},
                {data:"matureDate"},
                {data:"deferredLimt",
                	render: function ( data, id ) {
                		if(data.ternUnit==2){
                			return data.deferredLimt + bt.lang("cms.loan.ternUnit.day");
                		}else if(data.ternUnit==1){
                			return data.deferredLimt + bt.lang("cms.loan.ternUnit.month");
                		}else{
                			return data.deferredLimt;
                		}
                    }	
                },
                {data:"deferredRepayDate"},
                {data:"deferredRate",
                	render: function ( data, id ) {
                		return bt.rateType.getFun().format(data.deferredRate);
                	}
                },
                {data:"bizStatus",
                	render: function ( data, id ) {
                		return bt.dict("cms.bizStatus",data.bizStatus);
                	}
                },
            ]
       });
    
    });
</script>

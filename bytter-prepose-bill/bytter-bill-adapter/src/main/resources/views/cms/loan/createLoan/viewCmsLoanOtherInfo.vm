<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
        <table class="layui-table">
        	<colgroup>
			    <col width="15%">
			    <col width="35%">
			    <col width="15%">
			    <col width="35%">
		  	</colgroup>
        	<thead>
        		<tr><td colspan="4" align="center"><strong>#springMessage('cms.loan.OtherInfo')</strong></td></tr>
        	</thead>
        	<tbody>
        		<tr>
        		##在途金额
        		<td class="textRight">#springMessage('table.cmsLoanRepay.inwayMoney')</td>
        		<td>
        		#if(!$inwayMoney)
        			0.00
        		#else
        			$!number.formatNumeric($!{inwayMoney})
        		#end
        		</td>
        		##已还款金额
        		<td class="textRight">#springMessage('table.cmsProvideLoanRepay.repayFinish')</td>
        		<td>
        		#if(!$repayedMoney)
        			0.00
        		#else
        			$!number.formatNumeric($!{repayedMoney})
        		#end
        		</td>
        		</tr>
					#if($!{viewFlag}=="1")
                    <tr>
                        <td colspan="4" align="center">
                            <button class="layui-btn" onClick="doClose()">#springMessage('common.button.close')</button>
                        </td>
                    </tr>
					#end

        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
bt.use(['form'], function() {
	$ = bt.jquery,form = bt.form();
	
	//关闭窗口
    doClose = function(){
    	if(bt.navtab){
			bt.navtab.closeCurrent();
		}
    }
});
</script>


<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<form id="searchForm" class="layui-form">
<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
<input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
		<table class="layui-table">
		<tr>
			<td width="10%" class="textRight">#springMessage('table.cmsLoanInfo.billCode')</td>
			<td width="20%">
				<input type="text" name="likes_billCode"
		                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanInfo.billCode')">
			</td>
			<td width="70%">
				<button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
				<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
			</td>
		</tr>
		</table>
</form>
<body>
	<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsLoanInfo.billCode')</th><!--贷款单号  -->
        <th>#springMessage('table.cmsLoanInfo.createDate')</th><!--录入日期  -->
        <th>#springMessage('table.cmsLoanInfo.curCode')</th><!--币别  -->
        <th>#springMessage('table.cmsLoanInfo.loanMoney')</th><!-- 贷款金额 -->
        <th>#springMessage('table.cmsLoanInfo.loanDate')</th><!--合同开始日  -->
        <th>#springMessage('table.cmsLoanDeferred.matureDate')</th><!--合同到期日  -->
        <th>#springMessage('table.cmsLoanInfo.repayType')</th><!--还款方式  -->
        <th>#springMessage('table.cmsLoanInfo.loanClass')</th><!--贷款种类  -->
        <!-- <th>#springMessage('table.cmsLoanInfo.loanType')</th>担保方式  -->
        <th>#springMessage('table.cmsLoanInfo.loanTerm')</th><!--贷款期限  -->
        <th>#springMessage('table.cmsLoanInfo.corp')</th><!--申请单位  -->
        <th>#springMessage('table.cmsLoanInfo.net')</th><!--所属资金中心   -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
<input type="hidden" id="pageType" value="${pageType}">


	#workFlowHtml()
	#parse("views/common/footer.vm")
	#workFlowScript()
	<script src="${basePath}/static/modules/cms/loan/cmsLoanInfoApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>




<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<table class="layui-table">
	<thead>
        <th>#springMessage('table.cmsLoanRepay.billCode')</th><!--还款单号   -->
        <th>#springMessage('table.cmsLoanRepay.repayDate')</th><!--还款日期   -->
        <th>#springMessage('table.cmsLoanRepay.sendCode')</th><!-- 贷款发放单号 -->
        <th>#springMessage('table.cmsLoanRepay.repayMoney')</th><!-- 还款金额 -->
        <th>#springMessage('table.cmsLoanRepay.repayAccrual')</th><!-- 还款利息 -->
        <th>#springMessage('table.cmsLoanRepay.status')</th><!-- 状态 -->
        <th>#springMessage('common.table.thead.operation')</th>
	</thead>
		#foreach($repay in $cmsloanRepays)
			<tr>
				<td align="center">$!{repay.billCode}</td>
				<td align="center">$!date.format('yyyy-MM-dd',$!repay.repayDate)</td>
				<td align="center">$!{repay.sendCode}</td>
				<td align="right">$!number.formatNumeric($!{repay.repayMoney})</td>
				<td align="right">
				#if($repay.repayAccrual)
					$!number.formatNumeric($!{repay.repayAccrual})
				#else
					0.00
				#end
				</td>
				<td align="center">$dictTag.get("cms.bizStatus",$!{repay.bizStatus})</td>
				<td align="center">
					<a class="" href="#" onclick="listMsg('$!{repay.billCode}')">#springMessage("common.button.logInfo")</a>
				</td>
			</tr>
		#end
</table>

#parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
//日志列表
function listMsg(el){
      if(bt.navtab){
           bt.navtab.addNavtab(bt.lang('common.button.logInfo'),basePath + "/cms/basedata/cmsprocessmsg/list?billCode=" + el);
           return;
       }
}
</script>

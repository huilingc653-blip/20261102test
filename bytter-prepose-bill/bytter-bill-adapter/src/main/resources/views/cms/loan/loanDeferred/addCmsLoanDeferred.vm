<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{cmsLoanDeferredPage.id}">
        <table class="layui-table">
        	<colgroup>
			    <col width="15%">
			    <col width="35%">
			    <col width="15%">
			    <col width="35%">
		  	</colgroup>
			<tbody>
				<tr>
					<td colspan="4" style="text-align: center;">
						<label>#springMessage('table.cmsLoanInfo.createDate')</label>&nbsp;&nbsp;
						<div class="layui-input-inline">
						<input type="text" name="createDate" class="layui-input" value="$!{createDate}" readonly>
						</div>
					</td>
				</tr>
        		<tr>
        		##申请单位
				<td class="textRight">#springMessage('table.cmsLoanInfo.corp')</td>
				<td colspan="3">
				<span>$!{cmsLoanInfoPage.corpName}</span>
				</td>
        		</tr>
        		<tr>
        		##贷款类型
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanGenre')</td>
				<td colspan="3">
					<span>$!{cmsLoanInfoPage.loanGenreName}</span>
				</td>
        		</tr>
        		<tr>
        		##贷款单号
        			<td class="textRight">#springMessage('table.cmsLoanInfo.billCode')</td>
					<td>
						<span>$!{cmsLoanInfoPage.billCode}</span>
					</td>
				##贷款发放编号
					<td class="textRight">#springMessage('table.cmsLoanSend.billCode')</td>
					<td colspan="3">
					<span>$!{cmsLoanSendPage.billCode}</span>
					</td>
        		</tr>
        		<tr>
        		##放款金额
				<td class="textRight">#springMessage('table.cmsLoanSend.loanMoney')</td>
				<td >
				$number.formatNumeric($!{cmsLoanSendPage.loanMoney})
				</td>
				##已还金额
				<td class="textRight">#springMessage('table.cmsLoanRepay.processMoney')</td>
				<td>$number.formatNumeric($!{repayedMoney})</td>
        		</tr>
        		<tr>
        		##贷款发放日期
				<td class="textRight">#springMessage('table.cmsLoanSend.loanDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.loanDate)</td>
				##到期日期
				<td class="textRight">#springMessage('cms.common.deadlineDate')</td>
				<td>
				<input type="hidden" id="repayDate" name="repayDate" class="layui-input bt-biz-dateType" data-type="date" value="$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.repayDate)" data-biz-name="repayDate">
				<!-- <input type="hidden" id="repayDate" value="$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.repayDate)"> -->
				$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.repayDate)</td>
        		</tr>
        		<tr>
        		##上期展期到期日期
        		<td class="textRight">#springMessage('table.cmsLoanDeferred.lastDeferredReplayDate')</td><td>
        		<input type="hidden" id="lastdeferredReplayDate"  class="layui-input bt-biz-dateType" data-type="date" value="$!date.format('yyyy-MM-dd',$!lastDeferredReplayDate)" data-biz-name="lastdeferredReplayDate">
        		$!date.format('yyyy-MM-dd',$!lastDeferredReplayDate)
        		</td>
        		##已展期次数
        		<td class="textRight">#springMessage('table.cmsLoanDeferred.deferredNum')</td><td>
        		$!{deferredNum}
        		</td>
        		</tr>
        		<tr>
        		##展期到期日
        		<td class="textRight">#springMessage('table.cmsLoanDeferred.deferredRepayDate')</td>
        		<td>
        		<input type="text" id="deferredRepayDate" name="deferredRepayDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="deferredRepayDate" lay-verify="required" data-callback="setTerm">
        		</td>
        		##展期期限
        		<td class="textRight">#springMessage('table.cmsLoanDeferred.deferredLimt')</td>
        		<td>
        		<div class="layui-inline">
                        <input type="text" id="deferredLimt" name="deferredLimt" lay-verify="required" readonly="readonly"
							   decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanDeferred.deferredLimt')">
						</div>
						<div class="layui-inline">	   
						<div class="bt-biz-dict" data-type="select" data-group="cms.loan.ternUnit" data-defaultvalue="1" data-name="ternUnit" data-biz-name="ternUnit" data-callback="setTerm"></div>
						</div>
				</td>
        		</tr>
        		<tr>
        		##展期利率
        		<td class="textRight">#springMessage('table.cmsLoanInfo.deferredRate')</td>
        		<td>
        			<input type="text" data-name="deferredRate" class="layui-input bt-biz-rateType" lay-verify="required"  value="$!{cmsLoanInfoPage.deferredRate}">
        		</td>
        		##展期合同号
        		<td class="textRight">#springMessage('table.cmsLoanDeferred.contractCode')</td>
        		<td>
        			<input type="text" id="contractCode" name="contractCode"  lay-verify="required" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanDeferred.contractCode')">
        		</td>
        		</tr>
        		<tr>
        		##备注
        			<td class="textRight">#springMessage('table.cmsLoanDeferred.rmk')</td>
        			<td colspan="3">
        			<textarea id="rmk" name="rmk" style="min-height:70px" maxlength="30"
							    class="layui-textarea" placeholder="#springMessage('table.cmsLoanInfo.rmk')"></textarea>
        			</td>
        		</tr>
        		<tr>
				##附件
					<td class="textRight">#springMessage('cms.loan.attachment')</td>
					<td colspan="3">
						<div id="uploader" style="width:100%" class="layui-input-inline"></div>
					</td>
			</tr>
        		<tr>
					<td colspan="4" style="text-align: center;">
						<button class="layui-btn" lay-submit="" value="1" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button class="layui-btn" lay-submit="" value="0" lay-filter="submit">#springMessage('common.button.temp')</button>
						<button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
			</tr>
        	</tbody>
        </table>
        <input type="hidden" name="corpId" value="$!{cmsLoanSendPage.corpId}">
        <input type="hidden" name="liCode" value="$!{cmsLoanSendPage.billCode}">
        <input type="hidden" name="matureDate" value="$!date.format('yyyy-MM-dd',$!cmsLoanSendPage.repayDate)">
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/loan/cmsLoanDeferred.add.js?_btv=${resourceVersion}"></script>
</html>
<table class="layui-table">

    <thead>
    <tr>
        ##贷款发放信息
        <td colspan="4" align="center"><strong>#springMessage("cms.loaninfo.arguement.info")</strong></td>
    </tr>
    </thead>
    <colgroup>
        <col width="15%">
        <col width="35%">
        <col width="15%">
        <col width="35%">
    </colgroup>
    <tbody>
    <tr>
        <td class="textRight">#springMessage('cms.loaninfo.isover.repair')</td>
        <td>
            $dictTag.get("sf_yn",${cmsLoanInfoPage.isOverRepair})
        </td>
        <td></td>
        <td></td>
    </tr>
 #if($cmsLoanInfoPage.isOverRepair=='1')
    <tr>
        <td class="textRight">#springMessage("table.cmsLoanSend.contractCode")</td>
        <td>$!{cmsLoanInfoPage.contractCode}</td>
        <td class="textRight"></td>
        <td></td>
    </tr>

    <tr>
        ##浮动方式
        <td class="textRight">#springMessage('table.cmsLoanInfo.floatWay')</td>
        <td>
            $dictTag.get("Cms.FloatWay",${cmsLoanInfoPage.floatWay})
            &nbsp;&nbsp;&nbsp;&nbsp;
            #set($postfix ="")

            #if(${cmsLoanInfoPage.floatWay} == "03")
                #set($postfix = "Month")
            #elseif(${cmsLoanInfoPage.floatWay} == "04")
                #set($postfix = "Season")
            #elseif(${cmsLoanInfoPage.floatWay} == "05")
                #set($postfix = "HY")
            #elseif(${cmsLoanInfoPage.floatWay} == "06")
                #set($postfix = "Year")
            #end
            $dictTag.get("Cms.FloatWay$postfix",${cmsLoanInfoPage.floatWayNext})
        </td>
        ##计息方式
        <td class="textRight">#springMessage('table.cmsLoanInfo.interestWay')</td>
        <td>
            $dictTag.get("Admin.PredrawSign",${cmsLoanInfoPage.interestWay})
        </td>
    </tr>

        #if($cmsLoanInfoPage.floatWay!='01')
        <tr>
            ##浮动利率
            <td class="textRight">#springMessage('cms.loan.floatRate')</td>
            <td>
                $!{cmsLoanInfoPage.referenceRateTypeName}<br><br>
                $!{cmsLoanInfoPage.repayCycleName} <br><br>
                $dictTag.get("Cms.PointsProportion",${cmsLoanInfoPage.pointsProportionSelect})&nbsp;
                #if(${cmsLoanInfoPage.pointsProportionSelect} == '01')
                    #if($!{cmsLoanInfoPage.pointsProportionText})
                        $number.formatNumeric($number.formatNumeric($!{cmsLoanInfoPage.pointsProportionText}))BP
                    #else
                        0.00BP
                    #end
                #else
                    #if($!{cmsLoanInfoPage.pointsProportionText})
                        $number.formatNumeric($number.formatNumeric($!{cmsLoanInfoPage.pointsProportionText}))%
                    #else
                        0.00%
                    #end
                #end
            </td>
            ##利率调整生效日期
            <td class="textRight">#springMessage('table.cmsLoanInfo.rateEntriesEffectDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!cmsLoanInfoPage.rateEntriesEffectDate)
            </td>
        </tr>
        #end
    <tr>
        ##贷款利率
        <td class="textRight">#springMessage('table.cmsLoanSend.loanRate')</td>
        <td>
            $rateTag.show($!{cmsLoanInfoPage.loanRate})
        </td>
        ##逾期利率
        <td class="textRight">#springMessage('table.cmsLoanSend.overdueRate')</td>
        <td>
            $rateTag.show($!{cmsLoanInfoPage.overdueRate})
        </td>
    </tr>
    <tr>
        ##展期利率
        <td class="textRight">#springMessage('table.cmsLoanSend.deferredRate')</td>
        <td>
            $rateTag.show($!{cmsLoanInfoPage.deferredRate})
        </td>
        <td ></td>
        <td>
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('cms.loaninfo.ivover.distribute')</td>
        <td>
            $dictTag.get("sf_yn",${cmsLoanInfoPage.isOverDistribute})
        </td>
        <td></td>
        <td></td>
    </tr>
 #end
    <tr>
        ##附件
        <td class="textRight">#springMessage('cms.loan.attachment')</td>
        <td colspan="3">
            <!-- 附件上传 -->
            <input id="annexName" name="annexName" type="hidden" value="$!{cmsLoanInfoPage.attachmentId}">
            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
        </td>
    </tr>

    </tbody>
</table>

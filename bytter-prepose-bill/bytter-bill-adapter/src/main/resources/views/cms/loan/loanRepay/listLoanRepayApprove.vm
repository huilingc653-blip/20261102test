<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<form id="searchForm" class="layui-form">
<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
	<input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
		<table class="layui-table">
		<tr>
			<td width="10%" class="textRight">#springMessage('table.cmsLoanSend.billCode')</td>
			<td width="20%">
				<input type="text" name="likes_billCode"
		                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanSend.billCode')">
			</td>
			<td width="70%">
				<button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
				<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
			</td>
		</tr>
		</table>
</form>
<body>
	<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsLoanRepay.billCode')</th><!--还款单号   -->
        <th>#springMessage('table.cmsLoanRepay.sendCode')</th><!-- 贷款发放单号 -->
        <th>#springMessage('table.cmsLoanInfo.contractCode')</th><!-- 合同号 -->
        <th>#springMessage('table.cmsLoanRepay.createDate')</th><!--录入日期   -->
        <th>#springMessage('table.cmsLoanInfo.curCode')</th>
        <th>#springMessage('table.cmsLoanRepay.repayMoney')</th><!-- 还款金额 -->
        <th>#springMessage('table.cmsLoanRepay.repayDate')</th><!-- 还款日期 -->
        <th>#springMessage('table.cmsLoanInfo.corp')</th><!--申请单位  -->
        <th>#springMessage('table.cmsLoanInfo.net')</th><!--所属资金中心   -->
        <th>#springMessage('common.table.thead.operation')</th>

    </tr>
    </thead>
</table>

	#workFlowHtml()
	#parse("views/common/footer.vm")
	#workFlowScript()
	<script src="${basePath}/static/modules/cms/loan/cmsLoanRepayApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>




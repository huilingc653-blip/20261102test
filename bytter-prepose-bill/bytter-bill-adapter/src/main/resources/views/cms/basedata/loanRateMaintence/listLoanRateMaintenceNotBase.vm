<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
	##本位币标识
	<input type="hidden" name="eqs_isBaseLoanRate" value="$!{baseSign}"/>
	<table class="layui-table">
		<tbody>
	    	<tr>
	    		<!-- 基准利率名称 -外币基准利率 -->
	    		<td class="textRight">#springMessage('table.tbLoanRateMaintence.baseRateId')</td>
	    		<td width="25%">
	    			<div class="layui-input-inline">
						<div class="bt-biz-selectType" data-valuefield="id" data-textfield="baseTypeName" data-name="eqs_baseRateId" data-url="${basePath}/cms/loanrate/maintence/queryNotBaseRate"></div>
					</div>
				</td>
	    		<!-- 生效日期-->
	    		<td class="textRight">#springMessage('table.tbLoanRateMaintence.timeOfTakeEffect')</td>
	    		<td width="25%" class="input100">
	    			<div class="layui-inline">
		   				<input name="ged_timeOfTakeEffect" class="layui-input bt-biz-dateType" data-type="date" type="text">
		   			</div>
		   			<div class="layui-inline">
		   				 ~
		   			</div>
		   			<div class="layui-inline">
		   				<input name="led_timeOfTakeEffect" class="layui-input bt-biz-dateType" data-type="date" type="text">
		   			</div>
	    		</td>
	    		<!-- 贷款周期 -外币周期 -->
	    		<td class="textRight">#springMessage('table.basedata.loan.date')</td>
	    		<td width="25%">
	    			<div class="layui-input-inline">
		    			<div class="bt-biz-selectType" data-valuefield="id" data-textfield="periodName" data-name="eqs_creditPeriodId" data-method="post" data-url="${basePath}/period/tbcreditperiod/allJson"></div>
		         	</div>
	    		</td>
	    	</tr>
	    	<tr>
	    		<!-- 币别 -->
	    		<td class="textRight">#springMessage('table.tbLoanRateMaintence.moneyType')</td>
	    		<td>
	    			<div class="layui-input-inline">
						<div class="bt-biz-selectType" data-valuefield="id" data-textfield="curName" data-name="eqs_moneyType" data-url="${basePath}/cms/loanrate/maintence/queryNotBaseCur"></div>
					</div>
	    		</td>
	    		<!-- 拆借类型  -->
	    		<!-- <td class="textRight">#springMessage('table.tbLoanRateMaintence.borrowType')</td>
	    		<td>
	    			<div class="layui-input-inline">
						<div class="bt-biz-dict" data-name="eqs_borrowType" data-type="select" data-group="LoanRate.BorrowType"></div>
					</div>
	    		</td> -->
				<!-- 利率获取方式 -->
				<td class="textRight">#springMessage('table.tbBaseRate.rateFromWay')</td>
				<td >
					<div class="layui-input-inline">
						<div class="bt-biz-dict" data-type="select" data-group="baseRate.fromWay" data-name="eqs_rateFromWay" data-biz-name="eqs_rateFromWay"></div>
					</div>
				</td>
	    		<td></td>
	    		<td></td>
	    	</tr>
	    	<tr>
	    		<td colspan="6" style="text-align: center;">
	    			<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
	            	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
	    		</td>
	    	</tr>
	    </tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.tbLoanRateMaintence.baseRateId')</th><!-- 基准类型名称  -->
        <th>#springMessage('table.basedata.loan.date')</th><!--贷款类型 - 期限 -->
        <!-- <th>#springMessage('table.tbLoanRateMaintence.borrowType')</th>拆借类型  -->
        <th>#springMessage('table.tbLoanRateMaintence.moneyType')</th><!-- 币别  -->
        <th>#springMessage('table.tbLoanRateMaintence.timeOfTakeEffect')</th><!-- 生效日期  -->
        <th>#springMessage('table.tbCreditPeriod.periodType')</th><!--贷款类型 - 贷款期限类型 -->
        <th>#springMessage('table.tbCreditPeriod.period')</th><!--贷款类型 - 期限 -->
		<th>#springMessage('table.tbBaseRate.rateFromWay')</th>
        <th>#springMessage('table.tbLoanRateMaintence.rate')</th><!-- 利率 -->
		<th>#springMessage('table.LoanRate.Upper.limit.of.floating.range')</th><!-- 浮动范围上限-->
		<th>#springMessage('table.LoanRate.Lower.limit.of.floating.range')</th><!-- 浮动范围下限-->
#*        <th>#springMessage('table.tbLoanRateMaintence.rateUpLimitPoints')</th><!-- 浮动范围上限（点数）-->
        <th>#springMessage('table.tbLoanRateMaintence.rateDownLimitPoints')</th><!-- 浮动范围下限（点数） -->*#
        <th>#springMessage('table.tbLoanRateMaintence.timeOfLastModifier')</th><!-- 操作时间 -->
        <th>#springMessage('table.tbLoanRateMaintence.status')</th><!-- 状态 -->
        <th>#springMessage('table.tbLoanRateMaintence.isValid')</th><!-- 是否启用 -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/basedata/loanRateMaintence/loanRateMaintenceNotBase.list.js?_btv=${resourceVersion}"></script>
</html>

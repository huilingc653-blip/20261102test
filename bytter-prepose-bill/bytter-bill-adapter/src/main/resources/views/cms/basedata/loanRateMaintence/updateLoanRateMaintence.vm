<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .input-bp input {
            border: none;
            width: 192px;
        }
        .input-bp span {
            position: absolute;
            right: 4px;
            top: 1px;
        }
    </style>
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{vo.id}">
        <table class="layui-table">
        	<tbody>
        		##if("$!{baseSign}" == "1")
        		<tr>
			        <td width="50%"  class="textRight">#springMessage('table.tbBaseRate.Interest.rate.type.name')</td><!--贷款类型名称 -->
			        <td>$!{vo.baseRateName}</td>
			    </tr>
			    <tr>
			    	<td width="50%"  class="textRight">#springMessage('table.basedata.loan.date')</td><!--贷款类型 - 贷款期限类型 -->
			    	<td width="50%">$!{vo.creditPeriodName}</td>
			    </tr>
			    <tr>
			    	<td width="50%"  class="textRight">#springMessage('table.tbCreditPeriod.periodType')</td><!--贷款类型 - 贷款期限类型 -->
			    	<td width="50%">$dictTag.get("cms.LoanClass",$!{vo.loanClass})</td>
			    </tr>
			    ##elseif("$!{baseSign}" == "0")
			    <!-- <tr>
			    	<td width="50%"  class="textRight">#springMessage('table.tbLoanRateMaintence.borrowType')</td>拆借类型
			    	<td>$!{vo.borrowTypeName}</td>
			    </tr> -->
			    ##end
			    <tr>
			    	<td width="50%"  class="textRight">#springMessage('table.tbLoanRateMaintence.moneyType')</td><!--币别 -->
			    	<td>$!{vo.moneyTypeName}</td>
			    </tr>
			    <tr>
			    	<td width="50%"  class="textRight">#springMessage('table.tbLoanRateMaintence.timeOfTakeEffect')</td><!-- 生效日期  -->
			    	<td>$!date.format('yyyy-MM-dd',$!vo.timeOfTakeEffect)</td>
			    </tr>
				<tr>
					<td width="50%"  class="textRight">#springMessage('table.tbBaseRate.rateFromWay')</td><!-- 利率获取方式  -->
					<td> $dictTag.get("baseRate.fromWay",$!{vo.rateFromWay})</td>
				</tr>
			<tr>
			    	<td width="50%"  class="textRight"><!-- 利率 -->
						#if($!{vo.code}=='lpr')
							#springMessage('table.depositRate.baseRate')
						#else
							#springMessage('table.tbLoanRateMaintence.rate')
						#end
					</td>
			    	<td><input type="text" data-name="rate" value="$!{vo.rate}" lay-verify="required" data-max="100" class="layui-input bt-biz-rateType" ></td>
			    </tr>
			    <!-- 本位币 -->
			    #if("$!{baseSign}" == "1")
					#if($!{vo.code}=='lpr')
						<tr>
							<td width="50%"  class="textRight">#springMessage('table.tbLoanRateMaintence.rateUpLimitPoints')</td><!-- 浮动范围上限（点数） -->
							<td>
								<div class="layui-inline input-bp">
									<div class="pl rateWrap" style="width:212px">
										<input type="text" id="rateUpLimit" data-name="rateUpLimit" value="$!{vo.rateUpLimit}" lay-verify="required" data-max="10000" data-min="-10000" data-minus="true"  data-decimal="2" class="layui-input bt-biz-moneyType" >
                            			<span name="percentsymbol" class="inputMark">BP</span>
									</div>
								</div>
                            </td>
						</tr>
						<tr>
							<td width="50%" class="textRight">#springMessage('table.tbLoanRateMaintence.rateDownLimitPoints')</td><!-- 浮动范围下限（点数） -->
							<td>
                                <div class="layui-inline input-bp">
                                    <div class="pl rateWrap" style="width:212px">
										<input  type="text" data-moneyendid="rateUpLimit" data-name="rateDownLimit" value="$!{vo.rateDownLimit}" lay-verify="required" data-decimal="2" data-min="-10000" data-minus="true" class="layui-input bt-biz-moneyType" >
                           				<span name="percentsymbol" class="inputMark">BP</span>
                            		</div>
                            	</div>
                            </td>
						</tr>
					#else
						<tr>
							<td width="50%"  class="textRight">#springMessage('table.tbLoanRateMaintence.rateUpLimitProportion')</td><!-- 浮动范围上限（比例） -->
							<td>
								<div class="layui-inline input-bp">
									<div class="pl rateWrap" style="width:212px">
										<input type="text" id="rateUpLimit" data-name="rateUpLimit" value="$!{vo.rateUpLimit}" lay-verify="required" data-max="100"  data-min="-100" data-minus="true"  data-decimal="2" class="layui-input bt-biz-moneyType">
										<span name="percentsymbol" class="inputMark">%</span>
									</div>
								</div>
							</td>
						</tr>
						<tr>
							<td width="50%" class="textRight">#springMessage('table.tbLoanRateMaintence.rateDownLimitProportion')</td><!-- 浮动范围下限（比例） -->
							<td>
								<div class="layui-inline input-bp">
									<div class="pl rateWrap" style="width:212px">
										<input  type="text" data-moneyendid="rateUpLimit" data-name="rateDownLimit" value="$!{vo.rateDownLimit}" lay-verify="required"  data-min="-100" data-decimal="2" data-minus="true" class="layui-input bt-biz-moneyType" >
										<span name="percentsymbol" class="inputMark">%</span>
									</div>
								</div>
							</td>
						</tr>
					#end
			    #elseif("$!{baseSign}" == "0")
				    <tr>
				    	<td width="50%"  class="textRight">#springMessage('table.tbLoanRateMaintence.rateUpLimitPoints')</td><!-- 浮动范围上限（点数）-->
				    	<td>
							<div class="layui-inline input-bp">
								<div class="pl rateWrap" style="width:212px">
									<input type="text" id="rateUpLimit"  data-name="rateUpLimit" value="$!{vo.rateUpLimit}" lay-verify="required" data-max="10000"  data-min="-10000" data-minus="true" data-decimal="2" class="layui-input bt-biz-moneyType" >
									<span name="percentsymbol" class="inputMark">BP</span>
								</div>
							</div>
						</td>
				    </tr>
				    <tr>
				    	<td width="50%"  class="textRight">#springMessage('table.tbLoanRateMaintence.rateDownLimitPoints')</td><!-- 浮动范围下限（点数） -->
				    	<td>
							<div class="layui-inline input-bp">
								<div class="pl rateWrap" style="width:212px">
									<input type="text"  data-moneyendid="rateUpLimit" data-name="rateDownLimit" value="$!{vo.rateDownLimit}" lay-verify="required"  data-min="-10000" data-decimal="2" data-minus="true" class="layui-input bt-biz-moneyType">
									<span name="percentsymbol" class="inputMark">BP</span>
								</div>
							</div>
						</td>
				    </tr>
			    #end
		    </tbody>
		</table>
		<div class="layui-form-item">
			<div class="layui-input-block" style="text-align: center;">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
				<button class="layui-btn" type="button" onClick="closeWindow();">#springMessage('common.button.close')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
	bt.use(['form','rateType','moneyType'], function(){
		$ = bt.jquery,form = bt.form();
		bt.rateType.init();
		bt.moneyType.init();

		//监听提交
	    form.on('submit(submit)', function(data){
	        var action = "/cms/loanrate/maintence/modify";
	        $.post(basePath + action,data.field,function(result){
	        	parent.layer.alert(result.msg, {icon: result.success?1:2});
	            if(result.success){
	            	bt.navtab.closeCurrent();
	            }
	        },'JSON');
	        return false;
	    });
	});
	function closeWindow(){
		bt.navtab.closeCurrent();
	}
</script>
</html>

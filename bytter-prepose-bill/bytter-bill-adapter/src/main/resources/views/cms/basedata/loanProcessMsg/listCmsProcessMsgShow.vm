#parse("views/common/head.vm")
<table id="appTable" class="layui-table layui-form  dark-layui-table breakRow" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsProcessMsg.createDate')</th><!--操作日期  -->
        <th>#springMessage('table.cmsProcessMsg.createBy')</th><!--用户代码  -->
        <th>#springMessage('table.cmsProcessMsg.createName')</th><!--用户名称  -->
        <th>#springMessage('table.cmsProcessMsg.messageType')</th><!--操作类型  -->
        <th>#springMessage('table.cmsProcessMsg.message')</th><!--操作信息  -->
    </tr>
    </thead>
    #foreach($msg in $list)
        <tr>
            <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{msg.createDate})</td>
            <td> $!{msg.createBy} </td>
            <td> $!{msg.createName} </td>
            <td>$dictTag.get("cms.messageType",$!{msg.messageType})</td>
            <td>$dictTag.get("cms.messageType",$!{msg.message})</td>
##            <td>
##                #if($!{msg.message} && $!{msg.message}!="")
##                #springMessage($!{msg.message})
##            #end
##            </td>
        </tr>
    #end
</table>

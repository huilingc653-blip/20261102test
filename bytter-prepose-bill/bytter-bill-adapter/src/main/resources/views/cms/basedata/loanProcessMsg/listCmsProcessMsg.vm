<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input type="hidden" id="billCode" value="$!{billCode}">
<table id="appTable" class="layui-table layui-form dark-layui-table breakRow"
		style="width: 100%;">
<colgroup>
	<col width="15%">
	<col width="15%">
	<col width="15%">
	<col width="15%">
	<col width="40%">
</colgroup>
	<thead>
		<tr>
			<th>#springMessage('table.cmsProcessMsg.createDate')</th><!--操作日期  -->
			<th>#springMessage('table.cmsProcessMsg.createBy')</th><!--用户代码  -->
			<th>#springMessage('table.cmsProcessMsg.createName')</th><!--用户名称  -->
			<th>#springMessage('table.cmsProcessMsg.messageType')</th><!--操作类型  -->
			<th>#springMessage('table.cmsProcessMsg.message')</th><!--操作信息  -->
		</tr>
	</thead>
</table>
<div align="center">
	<a href="#" class="layui-btn layui-btn-small" onClick="doClose()" >#springMessage('common.button.close')</a>
</div>
#parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
bt.use(['form','date','datatable','dicts'], function(){
    $ = bt.jquery,form = bt.form();
    bt.dicts.init();
    datatable = bt.datatable.init({
        elem: "#appTable",
       
        ajax: {
        	url:basePath+"/cms/basedata/cmsprocessmsg/listMsgData?billCode="+$('#billCode').val()
        }
      
        ,columns: [
{data:"createDate"},
{data:"createBy"},
{data:"createName"},
{data:"messageType",
	render: function (data, type, full, meta) {
            return bt.dict("cms.messageType",full.messageType);
	}
},
{data:"message",
    render: function (data, type, full, meta) {
    if(full.message != "" && full.message !=null && full.message !=" "){
		if(isNaN(full.message)){
            return full.message;
		}else{
            return bt.dict("cms.messageType",full.message);
		}
	}else{
        return bt.dict("cms.messageType",full.message);
	}
    }
},
           
          
        ]
    });
    /* bt.datatable.init({
    		elem: "#appTable",
       		colReorder: true,
            ordering:false,
            ajax:{
            	url:basePath+"/cms/basedata/cmsprocessmsg/listMsgData?billCode="+$('#billCode').val(),
            },
 
            columns:[
				{data:"createDate"},
                {data:"createBy"},
                {data:"createName"},
                {data:"messageType",
                	render: function (data, type, full, meta) {
                		return bt.dict("cms.messageType",full.messageType);
                	}
                },
                {data:"message"},
            ]
       }); */
  
    });
    
//关闭窗口
function doClose(){
	if(bt.navtab){
		bt.navtab.closeCurrent();
	}
}
</script>

<!DOCTYPE html>##还款方式不是其它
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table self-adaption" id="reflashTable">
        <thead>
        <tr>
            <td colspan="10" align="center">#springMessage('table.cmsPrecativeLoanRepay.repaymentScheduleId')</td>

        </tr>
        <input type="hidden" id="billCode" name="billCode" value="$!{repayPlan.billCode}">##单号
        <input type="hidden" id="loanRate" name="loanRate" value="$!{repayPlan.loanRate}">##利率
        <input type="hidden" id="loanDate" name="loanDate" value="$!{repayPlan.loanDate}">##发放日期
        <input type="hidden" id="repayDate" name="repayDate" value="$!{repayPlan.repayDate}">##还款日期
        <input type="hidden" id="loanMoney" name="loanMoney" value="$!{repayPlan.loanMoney}">##发放金额
        <input type="hidden" id="internalSign" name="internalSign" value="$!{repayPlan.internalSign}">##内部标记 内部标志:A1 -内部贷款录入  A2 -- 内部贷款发放 B1 -银行借款录入  B2 -- 银行借款发放
        <input type="hidden" id="repayType" name="repayType" value="$!{repayPlan.repayType}">##还款方式
        <input type="hidden" id="planId" name="planId" value="$!{repayPlan.planId}">##还款计划id
        <input type="hidden" id="rateBase" name="rateBase" value="$!{repayPlan.rateBase}">##利息测算基数
        </thead>
        <tbody>
        <tr>
            <td width="3%"></td>
            <td align="right" width="10%">#springMessage('table.RepaymentSchedule.beginDate') </td>
            <td width="10%">
                <input type="text" id="repayBeginDate" data-min="$!{repayStartDateStr}"
                       data-max="$!{repayPlan.repayDate}" name="repayBeginDate"
##                       data-callback="beginDateChange"
                       class="layui-input bt-biz-dateType" data-type="date" data-biz-name="repayBeginDate">
            </td>
            <td width="10%"><button class="layui-btn layui-btn-small" type="button" id="calcBtn" onclick="beginDateChange()">#springMessage('cms.provide.inerest.cal')</button></td>
            <td align="right" width="10%">#springMessage('table.RepaymentSchedule.cycle') </td>
            <td colspan="3" width="30%">
                <DIV class=layui-form>
                    <DIV class=bt-biz-dict data-type="radio" data-defaultvalue="" data-callback="cycleChange"
                         data-name="repayCycel"
                         data-biz-name="repayCycel" data-disabledValue="0,1,2,3" data-group="Repayment.cycle"></DIV>
                </DIV>
            </td>
            ##<td align="center" colspan="3" width="37%">
            ##<button class="layui-btn" lay-submit="false" type="button" id="addRow">新增行</button>
            ##</td>
        </tr>
        </tbody>
    </table>
    <table class="layui-table self-adaption  layui-table-border" id="repayPlanTB">
        <thead>
        <tr>
            <th>#springMessage('table.createRepayPlan.prediceRepayDate')</th> ##预计还款日
            <th>#springMessage('table.createRepayPlan.repaymentMoney')</th>    ##还款本金
            <th>#springMessage('table.createRepayPlan.repaymentIst')</th> ##还款利息
            <th>#springMessage('table.createRepayPlan.currentRepayMoney')</th>    ##本期还款金额
            ##<th>#springMessage('table.createRepayPlan.realityRepayDate')</th> ##实际还款日
            ##<th>#springMessage('table.createRepayPlan.realityRepayMoney')</th>	##实际还款本金
            <th>#springMessage('table.createRepayPlan.surplusMoney')</th> ##剩余本金
            <th>#springMessage('table.createRepayPlan.isRepay')</th>    ##是否已还
            <th>#springMessage('table.createRepayPlan.rmk')</th> ##备注
            <th>#springMessage('common.table.thead.operation')</th> ##操作
        </tr>
        </thead>
        <tbody>
        </tbody>
        <tfoot>
        <tr>
            <td align="center">#springMessage('table.interet.sum')</td>

            <td align="right">
                <input type="text" style="border:none;" id="repaymentMoneySum" data-name="repaymentMoneySum"
                       data-biz-name="repaymentMoneySum" readonly="readonly" data-decimal="2"
                       autocomplete="off" class="layui-input bt-biz-moneyType">
            </td>
            <td align="right">
                <input type="text" style="border:none;" id="repaymentIstSum" data-name="repaymentIstSum"
                       data-biz-name="repaymentIstSum" readonly="readonly" data-decimal="2"
                       autocomplete="off" class="layui-input bt-biz-moneyType">
            </td>
            <td align="right">
                <input type="text" style="border:none;" id="currentRepayMoneySum" data-name="currentRepayMoneySum"
                       data-biz-name="currentRepayMoneySum" readonly="readonly" data-decimal="2"
                       autocomplete="off" class="layui-input bt-biz-moneyType">
            </td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
        </tr>
        </tfoot>
    </table>
    <div align="center">
        <button class="layui-btn layui-btn-small" lay-submit="" lay-filter="save">#springMessage(
            'common.button.save')</button>
        <a href="#" class="layui-btn layui-btn-small" onClick="doClose()">#springMessage('common.button.close')</a>
        ##<a href="#" class="layui-btn layui-btn-small" onClick="calculationSurplusMoney()" >测试</a>
    </div>

</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/basedata/tbCreditPeriod/CommonRepayPlanFunction.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/basedata/tbCreditPeriod/repayTypeRepayPlan.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/basedata/tbCreditPeriod/makRepayPlan.js?_btv=${resourceVersion}"></script>
</html>

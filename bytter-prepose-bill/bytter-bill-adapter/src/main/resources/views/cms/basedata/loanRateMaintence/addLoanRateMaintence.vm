<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
	<style>
		.input-bp input {
			border: none;
			width: 192px;
		}
		.input-bp span {
			position: absolute;
			right: 4px;
			top: 1px;
		}
	</style>
</head>
<body>
<form class="layui-form" method="post">
	<input type="hidden" id="isBaseLoanRate" name="isBaseLoanRate" value="$!{baseSign}" />
	<input type="hidden" id="code">
	<table class="layui-table">
		<tbody>
		<tr>
			#if("$!{baseSign}" == "1")
				<td  class="textRight" width="25%"><span style="color:red">*</span>#springMessage('table.tbBaseRate.Interest.rate.type.name')</td>
				<td width="25%">
					<div class="layui-input-inline">
						<div class="bt-biz-selectType"
							 data-valuefield="id"
							 data-textfield="baseTypeName"
							 data-required="true"
							 data-name="baseRateId"
							 data-biz-name="baseRateId"
							 data-callback="changeTitle"
							 data-initcallback="changeTitle"
							 data-url="${basePath}/cms/loanrate/maintence/queryBaseRate"></div>
					</div>
				</td>
				<td width="25%" class="textRight">#springMessage('table.tbLoanRateMaintence.moneyType')</td>
				<td width="25%">
					$!{cur.curName}
					<input type="hidden" name="moneyType" value="$!{cur.id}" />
				</td>
			#elseif("$!{baseSign}" == "0")
				<td  class="textRight" width="20%"><span style="color:red">*</span>#springMessage('table.tbLoanRateMaintence.baseRateId')</td>
				<td width="15%">
					<div class="layui-input-inline">
						<div class="bt-biz-selectType" data-valuefield="id" data-textfield="baseTypeName" data-required="true" data-name="baseRateId" data-initcallback="changeTitle" data-callback="changeTitle" data-url="${basePath}/cms/loanrate/maintence/queryNotBaseRate"></div>
					</div>
				</td>
				<td width="10%" class="textRight"><span style="color:red">*</span>#springMessage('table.tbLoanRateMaintence.moneyType')</td>
				<td width="15%">
					<div class="layui-input-inline">
						<div class="bt-biz-selectType" data-valuefield="id" data-textfield="curName" data-required="true" data-defaultvalue="first" data-name="moneyType" data-url="${basePath}/cms/loanrate/maintence/queryNotBaseCur"></div>
					</div>
				</td>
				<td></td>
				<td></td>
				<!-- <td width="10%" class="textRight">#springMessage('table.tbLoanRateMaintence.borrowType')</td>
				<td width="15%">
					<div class="layui-input-inline">
						<div class="bt-biz-dict" data-name="borrowType" data-type="select" data-group="LoanRate.BorrowType" data-defaultvalue="1"></div>
					</div>
				</td> -->
			#end
		</tr>
		</tbody>
	</table>
	<table class="layui-table" id="editTable">
		<thead>
		<tr>
			<th><span style="color:red">*</span>#springMessage('table.basedata.loan.date')</th><!--贷款类型 - 期限 -->
			<th><span style="color:red">*</span>#springMessage('table.tbCreditPeriod.periodType')</th><!--贷款类型 - 贷款期限类型 -->
			<th><span style="color:red">*</span>#springMessage('table.tbLoanRateMaintence.timeOfTakeEffect')</th><!-- 生效日期  -->
			<th id="rate"><span style="color:red">*</span><span id="rateName">#springMessage('table.tbLoanRateMaintence.rate')</span></th><!-- 利率 -->
			#if("$!{baseSign}" == "1")
				<th id="up"><span style="color:red">*</span><span id="upName">#springMessage('table.tbLoanRateMaintence.rateUpLimitProportion')</span></th><!-- 浮动范围上限（比例） -->
				<th id="down"><span style="color:red">*</span><span id="downName">#springMessage('table.tbLoanRateMaintence.rateDownLimitProportion')</span></th><!-- 浮动范围下限（比例） -->
			#elseif("$!{baseSign}" == "0")
				<th id="up"><span style="color:red">*</span><span id="upName">#springMessage('table.tbLoanRateMaintence.rateUpLimitPoints')</span></th><!-- 浮动范围上限（点数）-->
				<th id="down"><span style="color:red">*</span><span id="downName">#springMessage('table.tbLoanRateMaintence.rateDownLimitPoints')</span></th><!-- 浮动范围下限（点数） -->
			#end
			<th>#springMessage('common.table.thead.operation')</th><!-- 操作 -->
		</tr>
		</tr>
		</thead>
		<tbody>
		</tbody>
	</table>
	<div class="layui-form-item">
		<div class="layui-input-block" style="text-align: center;">
			<button type="button" class="layui-btn" lay-filter="add" id="add">#springMessage('common.addTr')</button>
			<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
			<button class="layui-btn" type="button" onClick="closeWindow();">#springMessage('common.button.close')</button>
		</div>
	</div>
</form>
	#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
	var dataUrl = "/period/tbcreditperiod/allJson"
</script>
<script src="${basePath}/static/modules/cms/basedata/loanRateMaintence/loanRateMaintence.add.js?_btv=${resourceVersion}"></script>
</html>

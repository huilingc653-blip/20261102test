<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>

<body>
<div>
    <table class="layui-table">
        <tbody>
        <tr>
            ##租赁种类
            <td class="textRight" width="14%">#springMessage('table.cmsLease.leaseType')</td>
            <td width="36%">$!dictTag.get("cms.financing.lease.info.leaseType",$!{leaseInfoVo.leaseType})</td>
            ##租赁合同号
            <td class="textRight">#springMessage('table.cmsLease.leaseCode')</td>
            <td width="36%">$!{leaseInfoVo.leaseCode}</td>
        </tr>
        <tr>
            ##租赁单号
            <td class="textRight">#springMessage('table.cmsLease.leaseNo')</td>
            <td width="36%">$!{leaseInfoVo.leaseNo}</td>
            ##境内境外
            <td class="textRight">#springMessage('table.cmsLease.isDomestic')</td>
            <td width="36%">$!dictTag.get("btBankAcc.isDomesticBank",$!{leaseInfoVo.isDomestic})</td>
        </tr>
        <tr>
            ##承租人
            <td class="textRight" width="14%">#springMessage('table.cmsLease.acceptor')</td>
            <td width="36%">$!{leaseInfoVo.corpName}</td>
            ##出租人
            <td class="textRight" width="14%">#springMessage('table.cmsLease.lessor')</td>
            <td width="36%">$!{leaseInfoVo.lessor}</td>
        </tr>
        <tr>
            ##供应商
            <td class="textRight" width="14%">#springMessage('table.cmsLease.supplier')</td>
            <td width="36%">$!{leaseInfoVo.supplier}</td>
            ##租赁物
            <td class="textRight" width="14%">#springMessage('table.cmsLease.leaseItem')</td>
            <td width="36%">$!{leaseInfoVo.leaseItem}</td>
        </tr>
        <tr>
            ##租赁币种
            <td class="textRight">#springMessage('table.cmsLease.oriCur')</td>
            <input type="hidden" id="curId" value="$!{leaseInfoVo.oriCurid}">
            <td width="36%">$!{leaseInfoVo.oriCurName}</td>
            ##租赁金额
            <td class="textRight">#springMessage('table.cmsLease.oriMoney')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    #if($leaseInfoVo.oriMoney)
                    $number.formatNumeric($!{leaseInfoVo.oriMoney})
                #end
                </div>
            </td>
        </tr>
        <tr>
            ##租金人民币金额
            <td class="textRight">#springMessage('table.cmsLease.rmbMoney')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    #if($leaseInfoVo.rmbMoney)
                    $number.formatNumeric($!{leaseInfoVo.rmbMoney})
                #end
                </div>
            </td>
            ##内涵报酬率
            <td class="textRight" width="14%">#springMessage('table.cmsLease.deferredRate')</td>
            <td width="36%">$!rateTag.show($!{leaseInfoVo.incRate})</td>
        </tr>
        <tr>
            ##起租日
            <td class="textRight">#springMessage('table.cmsLease.beginDate')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    $!date.format('yyyy-MM-dd',$!leaseInfoVo.beginDate)
                </div>
            </td>
            ##到期日
            <td class="textRight" width="14%">#springMessage('table.cmsLease.endDate')</td>
            <td width="36%">
                $!date.format('yyyy-MM-dd',$!leaseInfoVo.endDate)
            </td>
        </tr>
        <tr>
            ##租赁期限
            <td class="textRight">#springMessage('table.cmsLease.dayLimit')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    $!{leaseInfoVo.dayLimit}
                </div>
                <div class="layui-inline">
                    ##期限单位
               $!dictTag.get("PrecativeLoanInfo.ternUnit",$!{leaseInfoVo.ternUnit})
                </div>
            </td>
            ##到期处理
            <td class="textRight" width="14%">#springMessage('table.cmsLease.dueProcess')</td>
            <td width="36%">$!dictTag.get("cms.lease.Info.due.process",$!{leaseInfoVo.dueProcess})</td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.cmsLease.rmk')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    $!{leaseInfoVo.rmk}
                </div>
            </td>
            <td class="textRight" width="14%"></td>
            <td width="36%"></td>
        </tr>
        <tr>
            ##附件
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <!-- 附件上传 -->
                <input id="annexName" name="annexName" type="hidden" value="$!{leaseInfoVo.uploadId}">
                <div id="uploader" class="layui-input-inline" style="width:100%"></div>
            </td>
        </tr>
        </tbody>
    </table>

    <table class="layui-table" width="100%">
        <thead>
        <tr>
            <th>#springMessage('table.cmsLease.payDate')</th> <!-- 租金支付日期 -->
            <th>#springMessage('table.cmsLoanRepay.payType')</th><!-- 支付方式 -->
            <th>#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc')</th><!-- 收款账号 -->
            <th>#springMessage('table.cmsProvideLoanRepay.onlinePaymentAccName')</th><!-- 收款账户名称 -->
            <th>#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc.bankName')</th><!-- 收款账户开户行名称 -->
            <th>#springMessage('table.cmsLease.leaseMonry')</th><!-- 本金 -->
            <th>#springMessage('table.cmsLease.leaseInterest')</th><!-- 利息 -->
            <th>#springMessage('table.cmsLease.thisMoney')</th><!-- 租金 -->
            <th>#springMessage('table.cmsLease.status')</th><!-- 状态 -->
            <th>#springMessage('table.cmsProvideLoanRepay.onlinePurpose')</th><!-- 用途 -->
        </tr>
        </thead>
        <body>
            #if($!leasePayVOList)
                #foreach($leasePayVO in $leasePayVOList)
                <tr>
                    <td>$!date.format('yyyy-MM-dd',$!{leasePayVO.payDate})</td>
                    <td>$dictTag.get("cms.leasepay.online.sign",$!{leasePayVO.onlineSign})</td>
                    <td>$!{leasePayVO.onlinePaymentAcc}</td>
                    <td>$!{leasePayVO.onlineAccName}</td>
                    <td>$!{leasePayVO.onlineBankName}</td>
                    <td>$!number.formatNumeric($!{leasePayVO.money})</td>
                    <td>$!number.formatNumeric($!{leasePayVO.interest})</td>
                    <td>$!number.formatNumeric($!{leasePayVO.leaseMoney})</td>
                    <td>$dictTag.get("lease.status",$!{leasePayVO.status})</td>
                    <td>$!{leasePayVO.rmk}</td>
                </tr>
                #end
            #end
        </body>
    </table>
</div>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form', 'btUpload', 'dicts', 'moneyType',], function () {
        $ = bt.jquery, form = bt.form();
        fun = bt.moneyType.getFun();
        moneyUpper();
        var gid = $("#annexName").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });
    });

    /**金额大写*/
    function moneyUpper() {
        var money = fun.toNumber("${leaseInfoVo.leaseMoney}");
        /*var repayPassage = fun.toNumber("${repayPassage}");
        var repayFinish = fun.toNumber("${repayFinish}");*/

        $("#moneyUpper").text(bt.money.toChinese(money));
        /* $("#repayPassageUpper").text(bt.money.toChinese(repayPassage));
         $("#repayFinishUpper").text(bt.money.toChinese(repayFinish));*/
    }
</script>
</html>

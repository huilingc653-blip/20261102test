<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="leaseId" name="leaseId" type="hidden" value="$!{leaseId}">
    <table class="layui-table">
        <colgroup>
            <col width="15%">
            <col width="35%">
            <col width="15%">
            <col width="35%">
        </colgroup>
        <tbody>
        <tr>
            ##融资租赁类型
            <td class="textRight">#springMessage('cms:lease:sub:mater:leaseType')</td>
            <td>
                $dictTag.get("cms.financing.lease.info.leaseType",$!{cmsAfterLeaseInfoVO.leaseType})
            </td>
            ##承租人
            <td class="textRight">#springMessage('cms:lease:sub:mater:lessee')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.corpName}
            </td>
        </tr>
        <tr>
            ## 出租人
            <td class="textRight">#springMessage('cms:lease:sub:mater:lessor')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.lessor}
            </td>
            ## 回购金额
            <td class="textRight">#springMessage('cms.lease.repo.repomoney')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.repoMoney}
            </td>
        </tr>
        <tr>
            ##供应商
            <td class="textRight">#springMessage('cms:lease:sub:mater:supplier')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.supplier}
            </td>
            ##融资租赁合同编号
            <td class="textRight">#springMessage('cms:lease:sub:mater:itemCode')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.leaseCode}
            </td>
        </tr>
        <tr>
            ##买卖合同编号
            <td class="textRight">#springMessage('cms:lease:sub:mater:contractNumb')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.payCode}
            </td>
            ##回购日期
            <td class="textRight">#springMessage('cms.lease.repo.repodate')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.repoDate}
            </td>
        </tr>
        <tr>
            ##是否提前回购
            <td class="textRight">#springMessage('cms.lease.repo.isrepofront')</td>
            <td>
                $dictTag.get("sf_yn",$!{cmsAfterLeaseInfoVO.isAdvanceBack})
            </td>
            ##备注
            <td class="textRight">#springMessage('cms.lease.repo.rmk')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.repoRmk}
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

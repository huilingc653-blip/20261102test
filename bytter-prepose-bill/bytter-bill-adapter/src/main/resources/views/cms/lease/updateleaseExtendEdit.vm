<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        /
        /
        这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="myform">
    <input id="leaseId" type="hidden" name="leaseId" value="$!{leaseExtendVO.leaseId}">
    <input id="id" type="hidden" name="id" value="$!{leaseExtendVO.id}">
    <input id="nowRate" type="hidden" name="nowRate" value="$!{leaseInfo.rate}">
    <input id="nowText" type="hidden" name="nowText" value="$!{leaseInfo.pointsProportionText}">
    <input id="floatWay" type="hidden" name="floatWay" value="$!{leaseInfo.floatWay}">
    <input id="lastExpendedDate" type="hidden" name="lastExpendedDate" value="$!date.format('yyyy-MM-dd',$!{leaseInfo.endDate})">
    <table id="appTable" class="layui-table layui-form">
        <tr>
            ##展期合同编号
            <td class="textRight" style="width: 15%">#springMessage('cms.lease.extend.expendedCode')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="expendedCode" name="expendedCode" class="layui-input" value="$!{leaseExtendVO.expendedCode}">
                </div>
            </td>
            ##上次展期/到期日期
            <td class="textRight" style="width: 15%">#springMessage('cms.lease.extend.lastExpendedDate')</td>
            <td style="width: 35%">
                <div class="layui-inline">
                    <input type="text" data-name="lastExpendedDate" data-biz-name="lastExpendedDate"
                           class="layui-input bt-input-inline bt-biz-dateType" data-type="date" disabled
                           value="$!{leaseExtendVO.lastExpendedDate}">
                </div>
            </td>
        </tr>
        <tr>
            ##展期到期日期
            <td class="textRight">#springMessage('table.fcAcc.delayDeadlineDate')</td>
            <td style="width: 35%">
                <div class=layui-input-inline>
                    <input id="expendedDate" name="expendedDate" data-biz-name="expendedDate"
                           data-callback="computeplTerm" value="$!{leaseExtendVO.expendedDate}"
                           class="layui-input bt-biz-dateType" type="text" data-type="date" lay-verify="required">
                </div>
            </td>
            ##展期期限
            <td class="textRight">#springMessage('table.cmsLoanDeferred.deferredLimt')</td>
            <td>
                <div class=layui-input-inline>
                    <input type="text" id="expendedLimit" name="expendedLimit" decimal="0" autocomplete="off"
                           class="layui-input" value="$!{leaseExtendVO.expendedLimit}">
                </div>
                <div class="layui-inline">
                    ##期限单位
                    <div class="bt-biz-dict" data-name="ternUnit" data-type="select" data-biz-name="ternUnit"
                         data-callback="computeplTerm" data-group="PrecativeLoanInfo.ternUnit"
                         data-defaultvalue="M" value="$!{leaseExtendVO.ternUnit}"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##比例%/BP点数
            <td class="textRight">#springMessage('cms.lease.extend.pointsProportionSelect')</td>
            <td>
                <div >
                    ##点数或者浮动比例选择与文本
                    <div style="display: inline">
                        <div class="bt-biz-dict points-proportion-select" data-name="pointsProportionSelect" data-type="select"
                             data-group="Cms.PointsProportion" data-defaultvalue="$!{leaseExtendVO.pointsProportionSelect}"
                             data-biz-name="pointsProportionSelect" data-disabled="true" style="width: 20%"></div>
                    </div>
                    <div class="layui-inline input-def" >

                        <input lay-verify="required" class="layui-input bt-biz-moneyType" id="pointsProportionText" style="display: inline"
                               name="pointsProportionText" data-callback="getRate"
                               data-biz-name="pointsProportionText" value="$!{leaseExtendVO.pointsProportionText}" data-decimal="2"
                            #if($!{tbLoanRateMaintence})
                               data-max="$!{tbLoanRateMaintence.rateUpLimit}"
                               data-min="$!{tbLoanRateMaintence.rateDownLimit}"
                            #else
                               data-max="100"
                               data-min="-100"
                            #end data-minus="true">
                        #if (${leaseExtendVO.pointsProportionSelect}=='01' )
                            <span>BP</span>
                        #else
                            <span>%</span>
                        #end
                    </div>
                    <div class="layui-inline" id="nextDetail">
                    </div>
                </div>
            </td>
            ##展期利率
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.deferredRate')</td>
            <td>
                <div class="layui-inline">
                    ##利率
                    <input type="text" data-name="rate" value="$!{leaseExtendVO.rate}" lay-verify="required"
                           data-biz-name="rate"
                           class="layui-input bt-biz-rateType"
                           placeholder="">
                </div>

            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.ratItemCustom.remark')</td>
            <td colspan="3">
                <input type="text" name="rmk" class="layui-input" value="$!{leaseExtendVO.rmk}">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" lay-submit="" value="1" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button class="layui-btn" lay-submit="" value="0" lay-filter="submit">#springMessage(
                    'common.button.temp')</button>
                <a class="layui-btn" href="#" onclick="del()">#springMessage('common.button.delete')</a>
                <a class="layui-btn" href="#" onclick="resetCallback()">#springMessage('common.button.reset')</a>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/lease/LeaseExtendEdit.update.js?_btv=${resourceVersion}"></script>
</body>
</html>

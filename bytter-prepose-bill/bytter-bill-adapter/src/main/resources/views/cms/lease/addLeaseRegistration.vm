<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="leaseId" name="leaseId" type="hidden" value="$!{leaseId}">
    <table class="layui-table">
        <colgroup>
            <col width="15%">
            <col width="35%">
            <col width="15%">
            <col width="35%">
        </colgroup>
        <tbody>
        <tr>
            ##租赁物类别
            <td class="textRight">#springMessage('cms:lease:sub:mater:leasetype')</td>
            <td>
                <div class=bt-biz-selectType data-name="leaseTypeId" data-textField="name"
                     data-valueField="id"
                     data-biz-name="leaseTypeId" data-url="${basePath}/cms/LeaseObjectInfo/getModuleName"
                     data-inputvalue="true"
                     data-search="true" ></div>
            </td>
            ##租赁物编号
            <td class="textRight">#springMessage('cms:lease:sub:mater:code')</td>
            <td>
                <input type="text" id="leaseItemCode" name="leaseItemCode" lay-verify="required"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('cms:lease:sub:mater:code')">
            </td>
        </tr>
        <tr>
            ##租赁物名称
            <td class="textRight">#springMessage('cms:lease:sub:mater:name')</td>
            <td colspan="3">
                <input type="text" id="leaseItemName" name="leaseItemName" lay-verify="required"
                       autocomplete="off" class="layui-input">
            </td>
        </tr>
        <tr>
            ##品牌
            <td class="textRight">#springMessage('cms:lease:sub:mater:brand')</td>
            <td>
                <input type="text" id="brand" name="brand"
                       autocomplete="off" class="layui-input">
            </td>
            ##规格型号
            <td class="textRight">#springMessage('cms:lease:sub:mater:specification')</td>
            <td>
                <input type="text" id="speModel" name="speModel"
                       autocomplete="off" class="layui-input">
            </td>
        </tr>
        <tr>
            ##计量单位
            <td class="textRight">#springMessage('cms:lease:sub:mater:calCorp')</td>
            <td>
                <input type="text" id="calCorp" name="calCorp"
                       autocomplete="off" class="layui-input">
            </td>
            ##数量
            <td class="textRight">#springMessage('table.fcAccbookDtl.amount')</td>
            <td>
                <input type="text" id="numb"
                       data-name="numb" name="numb"
                       class="layui-input bt-biz-moneyType"
                       minus="false" maxlength="3" data-decimal="0" />
            </td>
        </tr>
        <tr>
            ##币种
            <td class="textRight">#springMessage('table.ratBkrationRelief.curCode')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="curId" data-biz-name="curId" data-inputValue="false"
                         data-required="true"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName"></div>
                </div>
            </td>
            ##原值金额
            <td class="textRight">#springMessage('cms:lease:sub:mater:oldMoney')</td>
            <td>
                <input type="text" id="oldMoney"
                       data-name="oldMoney" name="oldMoney"
                       class="layui-input bt-biz-moneyType"
                       minus="false" maxlength="3" data-decimal="2" />
            </td>
        </tr>
        <tr>
            ##现值金额
            <td class="textRight">#springMessage('cms:lease:sub:mater:nowMoney')</td>
            <td>
                <input type="text" id="nowMoney" lay-verify="required"
                       data-name="nowMoney" name="nowMoney"
                       class="layui-input bt-biz-moneyType" required="required"
                       minus="false" maxlength="3" data-decimal="2" />
            </td>
            ##存放地点
            <td class="textRight">#springMessage('cms:lease:sub:mater:saveAddr')</td>
            <td>
                <input type="text" id="saveAddr" name="saveAddr"
                       autocomplete="off" class="layui-input">
            </td>
        </tr>
        <tr>
            ##生产厂家
            <td class="textRight">#springMessage('cms:lease:sub:mater:makeBy')</td>
            <td>
                <input type="text" id="makeBy" name="makeBy"
                       autocomplete="off" class="layui-input">
            </td>
            ##购置时间
            <td class="textRight">#springMessage('cms:lease:sub:mater:buyDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="buyDate" data-biz-name="buyDate" name="buyDate"
                           class="layui-input bt-input-inline bt-biz-dateType" data-today="true" >
                </div>
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.cmsLoanDeferred.rmk')</td>
            <td colspan="3">
        			<textarea id="rmk" name="rmk" style="min-height:70px" maxlength="150"
                              class="layui-textarea" placeholder="#springMessage('table.cmsLoanInfo.rmk')"></textarea>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" value="1" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button class="layui-btn" lay-submit="" value="0" lay-filter="submit">#springMessage(
                    'common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/lease/leaseRegistration.add.js?_btv=${resourceVersion}"></script>
</html>
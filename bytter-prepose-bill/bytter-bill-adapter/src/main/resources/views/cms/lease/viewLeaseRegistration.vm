<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="leaseId" name="leaseId" type="hidden" value="$!{leaseId}">
    <table class="layui-table">
        <colgroup>
            <col width="15%">
            <col width="35%">
            <col width="15%">
            <col width="35%">
        </colgroup>
        <tbody>
        <tr>
            ##租赁物类别
            <td class="textRight">#springMessage('cms:lease:sub:mater:leasetype')</td>
            <td>
                $!{leaseObjectInfoVO.name}
            </td>
            ##租赁物编号
            <td class="textRight">#springMessage('cms:lease:sub:mater:code')</td>
            <td>
                $!{leaseObjectInfoVO.leaseItemCode}
            </td>
        </tr>
        <tr>
            ##租赁物名称
            <td class="textRight">#springMessage('cms:lease:sub:mater:code')</td>
            <td colspan="3">
                $!{leaseObjectInfoVO.leaseItemName}
            </td>
        </tr>
        <tr>
            ##品牌
            <td class="textRight">#springMessage('cms:lease:sub:mater:brand')</td>
            <td>
                $!{leaseObjectInfoVO.brand}
            </td>
            ##规格型号
            <td class="textRight">#springMessage('cms:lease:sub:mater:specification')</td>
            <td>
                $!{leaseObjectInfoVO.speModel}
            </td>
        </tr>
        <tr>
            ##计量单位
            <td class="textRight">#springMessage('table.fcOutAccbook.unit')</td>
            <td>
                $!{leaseObjectInfoVO.calCorp}
            </td>
            ##数量
            <td class="textRight">#springMessage('table.fcAccbookDtl.amount')</td>
            <td>
                $!{leaseObjectInfoVO.numb}
            </td>
        </tr>
        <tr>
            ##币种
            <td class="textRight">#springMessage('table.ratBkrationRelief.curCode')</td>
            <td>
                $!{leaseObjectInfoVO.curName}
            </td>
            ##原值金额
            <td class="textRight">#springMessage('cms:lease:sub:mater:oldMoney')</td>
            <td>
                #if($!{leaseObjectInfoVO.oldMoney})
                $number.formatNumeric($!{leaseObjectInfoVO.oldMoney})
                #else
                    $number.formatNumeric(0)
                #end

            </td>
        </tr>
        <tr>
            ##现值金额
            <td class="textRight">#springMessage('cms:lease:sub:mater:nowMoney')</td>
            <td>
                $number.formatNumeric($!{leaseObjectInfoVO.nowMoney})
            </td>
            ##存放地点
            <td class="textRight">#springMessage('cms:lease:sub:mater:saveAddr')</td>
            <td>
                $!{leaseObjectInfoVO.saveAddr}
            </td>
        </tr>
        <tr>
            ##生产厂家
            <td class="textRight">#springMessage('cms:lease:sub:mater:makeBy')</td>
            <td>
                $!{leaseObjectInfoVO.makeBy}
            </td>
            ##购置时间
            <td class="textRight">#springMessage('cms:lease:sub:mater:buyDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{leaseObjectInfoVO.buyDate})
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.cmsLoanDeferred.rmk')</td>
            <td colspan="3">
                $!{leaseObjectInfoVO.rmk}
            </td>
        </tr>

        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
##<script src="${basePath}/static/modules/cms/lease/leaseRegistration.view.js?_btv=${resourceVersion}"></script>
</html>
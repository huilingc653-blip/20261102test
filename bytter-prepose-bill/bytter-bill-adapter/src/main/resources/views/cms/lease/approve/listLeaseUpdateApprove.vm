<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
            <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
            ##租赁单号
            <td class="textRight" >#springMessage('table.cmsLease.leaseNo')</td>
            <td >
                <input type="text"  name="likes_leaseNo" autocomplete="off"
                       class="layui-input"/>
            </td>
            ##融资租赁类型
            <td class="textRight" >#springMessage('cms:lease:sub:mater:leaseType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="cms.financing.lease.info.leaseType"
                     data-name="eqs_leaseType" data-biz-name="leaseType"  ></div>
            </td>
            ##融资租赁合同编号
            <td class="textRight" >#springMessage('cms:lease:sub:mater:itemCode')</td>
            <td width="25%">
                <input type="text"  name="likes_leaseCode" autocomplete="off"
                       class="layui-input"/>
            </td>
        </tr>
        <tr>
            ##承租人
            <td class="textRight" >#springMessage('cms:lease:sub:mater:lessee')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-type="selectTree" data-name="eqs_corpId" data-resource="cms:lease:financing:apply:query" data-scope="all"></div>
                </div>
            </td>
            ##出租人
            <td class="textRight" >#springMessage('cms:lease:sub:mater:lessor')</td>
            <td width="25%">
                <input type="text"  name="likes_lessor" autocomplete="off"
                       class="layui-input"/>
            </td>
            ##            币种
            <td  class="textRight">#springMessage('table.cmsLease.oriCur')</td>
            <td >
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_oriCurid" data-biz-name="eqs_oriCurid" data-inputValue="false"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##租金金额
            <td class="textRight">#springMessage('table.cmsLease.oriMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="geg_oriMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20"
                           placeholder="#springMessage('cms:lease:sub:mater:rentalMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_oriMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" id="t20" placeholder="#springMessage('cms:lease:sub:mater:rentalMoney')">
                </div>
            </td>
            ##起租日
            <td class="textRight" >#springMessage('cms:lease:sub:mater:commencementDate')</td>
            <td >
                <input type="text" name="ged_beginDate" data-biz-name="ged_beginDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_beginDate" >
                <span class="date-mid">~</span>
                <input type="text" name="led_beginDate" data-biz-name="led_beginDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" id="led_beginDate" >
            </td>
            ##到期日
            <td class="textRight" >#springMessage('table.cmsLease.endDate')</td>
            <td >
                <input type="text" name="ged_endDate" data-biz-name="ged_endDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_endDate" >
                <span class="date-mid">~</span>
                <input type="text" name="led_endDate" data-biz-name="led_endDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" id="led_endDate" >
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsLease.leaseNo')</th>
        <th>#springMessage('table.cmsLease.leaseType')</th>
        <th>#springMessage('table.cmsLease.leaseCode')</th>
        <th>#springMessage('table.cmsLease.payCode')</th>
        <th>#springMessage('table.cmsLease.acceptor')</th>
        <th>#springMessage('table.cmsLease.lessor')</th>
        <th>#springMessage('cms:lease:sub:mater:supplier')</th>
        <th>#springMessage('table.cmsLease.oriCur')</th>
        <th>#springMessage('table.cmsLease.oriMoney')</th>
        <th>#springMessage('table.cmsLease.rmbMoney')</th>
        <th>#springMessage('table.cmsLease.beginDate')</th>
        <th>#springMessage('table.cmsLease.endDate')</th>
        <th>#springMessage('table.cmsLease.add.leaseCode')</th>
        <th>#springMessage('table.cmsLease.changeDate')</th>
        <th>#springMessage('table.fcFreeze.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
</body>
<script>
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts", "corp","dateType"], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        selectType = bt.selectType.init();
        bt.dateType.init();//日期时间
        bt.moneyType.init();
        corp = bt.corp.init();//单位

        /**
         * 生成列表
         */
        datatable = bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            checkbox: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search",
                isInitData:"false"
            },
            ajax: {
                'url': basePath + "/cms/lease/update/datatableUpdateApprove"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            fixedColumns: {
                rightColumns: 2//代表冻结右边一列
            },
            columns: [
                {data: "leaseNo", bSortable: true},
                {data:"leaseType", bSortable:true,className:'center',
                    render: function ( data, type, full, meta ){
                        return bt.dict("cms.financing.lease.info.leaseType",full.leaseType);
                    }},
                {data:"leaseCode",bSortable:true},
                {data:"payCode",bSortable:true},
                {data: "corpName", bSortable: true},
                {data: "lessor", bSortable: true},
                {data: "supplier", bSortable: true},
                {data:"oriCurName",bSortable:true},
                {data:"oriMoney",className:"textRight",render: function ( data, type, full, meta ){
                        return bt.money.format(full.oriMoney);
                    }},
                {data:"rmbMoney",className:"textRight",render: function ( data, type, full, meta ){
                        return bt.money.format(full.rmbMoney);
                    }},
                {data:"beginDate",bSortable:true},
                {data:"endDate",bSortable:true},
                {data:"addLeaseCode",bSortable:true},
                {data:"modifyDate",bSortable:true,className:'center'},
                {
                    data: "status", bSortable: true, className: 'center',
                    render: function (data, type, full, meta) {
                        return bt.dict("lease.status", full.status);
                    }
                },
                {data:null,bSortable:false,className:'center',
                    render: function (data, type, full, meta) {
                        var html='';
                        if($("#flowStatus").val()=='todo'){
                            html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
                        }
                        if($("#flowStatus").val() == 'pass'){
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a><span class="text-explode">|</span>';
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }else {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }
                        return html;
                    }
                },
            ]
        });
    });


    /*审核*/
    function approve(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.approve') ,basePath + "/cms/lease/update/UpdateApprove?businessId=" + data.id +"&leaseId="+data.leaseId + "&taskId=" + data.taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath +  "/cms/lease/update/UpdateApprove?businessId=" + data.id +"&leaseId="+data.leaseId + "&taskId=" + data.taskId
        });
    }

    function view(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'),basePath + "/cms/lease/financing/info/view/" + data.id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/lease/financing/info/view/" + data.id
        });
    }

</script>

</html>

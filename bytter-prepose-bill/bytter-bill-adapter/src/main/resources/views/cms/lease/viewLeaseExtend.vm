<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        /
        /
        这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="myform">
    <input id="leaseId" type="hidden" name="leaseId" value="$!{leaseId}">
    <input id="floatWay" type="hidden" name="floatWay" value="$!{leaseExtendVO.floatWay}">
    <input id="lastExpendedDate" type="hidden" name="lastExpendedDate" value="$!date.format('yyyy-MM-dd',$!{leaseExtendVO.endDate})">
    <table id="appTable" class="layui-table layui-form">
        <tr>
            ##展期合同编号
            <td class="textRight" style="width: 15%">#springMessage('cms.lease.extend.expendedCode')</td>
            <td>
                $!{leaseExtendVO.expendedCode}
            </td>
            ##上次展期/到期日期
            <td class="textRight" style="width: 15%">#springMessage('cms.lease.extend.lastExpendedDate')</td>
            <td style="width: 35%">
                $!{leaseExtendVO.endDate}
            </td>
        </tr>
        <tr>
            ##展期到期日期
            <td class="textRight">#springMessage('table.fcAcc.delayDeadlineDate')</td>
            <td style="width: 35%">
                $!{leaseExtendVO.expendedDate}
            </td>
            ##展期期限
            <td class="textRight">#springMessage('table.cmsPrecativeLoanDeferred.deferredLimt')</td>
            <td>
                $!{leaseExtendVO.expendedLimit}$dictTag.get("PrecativeLoanInfo.ternUnit",$!{leaseExtendVO.ternUnit})
            </td>
        </tr>
        <tr>
            ##比例%/BP点数
            <td class="textRight">#springMessage('cms.lease.extend.pointsProportionSelect')</td>
            <td>
                <div >
                    ##点数或者浮动比例选择与文本
                    <div style="display: inline">
                        <div class="bt-biz-dict points-proportion-select" data-name="pointsProportionSelect" data-type="select"
                             data-group="Cms.PointsProportion" data-defaultvalue="$!{leaseExtendVO.pointsProportionSelect}"
                             data-biz-name="pointsProportionSelect" data-disabled="true" style="width: 20%"></div>
                    </div>
                    <div class="layui-inline input-def" >
                        $!{leaseExtendVO.pointsProportionText}
                        #if (${leaseExtendVO.pointsProportionSelect}=='01' )
                            <span>BP</span>
                        #else
                            <span>%</span>
                        #end
                    </div>
                    <div class="layui-inline" id="nextDetail">
                    </div>
                </div>
            </td>
            ##展期利率
            <td class="textRight">#springMessage('table.cmsLoanSend.deferredRate')</td>
            <td>
                $!rateTag.show($!{leaseExtendVO.rate})
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.ratItemCustom.remark')</td>
            <td colspan="3">
                $!{leaseExtendVO.rmk}
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script >
    var dicts,form,rateTypes,selectTypes,moneyType;
    var dateTayps;
    bt.use(["jquery", 'dateType', 'dicts', 'rateType','moneyType','rateType','selectType'], function () {
        $ = bt.jquery;
        form = bt.form(),moneyFun = bt.moneyType.getFun();
        selectTypes = bt.selectType.init();//下拉框
        rateTypes = bt.rateType.init();//利率
        var dateTayps = bt.dateType.init();
        dictes = bt.dicts.init();
        moneyType=bt.moneyType.init();//金额
        //初始化利率
        bt.rateType.init();
        bt.empty = function(ms){
            if(typeof(ms) == "undefined" || ms == null || ms == ""){
                return true;
            }
            return false;
        }
        //这里填写新的js代码，请参考前端文档
    });

    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }
</script>
</body>
</html>

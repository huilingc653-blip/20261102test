<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="leaseId" name="leaseId" type="hidden" value="$!{leaseId}">
    <table class="layui-table">
        <colgroup>
            <col width="15%">
            <col width="35%">
            <col width="15%">
            <col width="35%">
        </colgroup>
        <tbody>
        <tr>
            ##融资租赁类型
            <td class="textRight">#springMessage('table.cmsLease.leaseType')</td>
            <td>
                $dictTag.get("cms.financing.lease.info.leaseType",$!{cmsAfterLeaseInfoVO.leaseType})
            </td>
            ##承租人
            <td class="textRight">#springMessage('cms:lease:sub:mater:lessee')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.corpName}
            </td>
        </tr>
        <tr>
            ##出租人
            <td class="textRight">#springMessage('cms:lease:sub:mater:lessor')</td>
            <td colspan="3">
                $!{cmsAfterLeaseInfoVO.lessor}
            </td>
        </tr>
        <tr>
            ##供应商
            <td class="textRight">#springMessage('cms:lease:sub:mater:supplier')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.supplier}
            </td>
            ##融资租赁合同编号
            <td class="textRight">#springMessage('cms:lease:sub:mater:itemCode')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.leaseCode}
            </td>
        </tr>
        <tr>
            ##买卖合同编号
            <td class="textRight">#springMessage('cms:lease:sub:mater:contractNumb')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.payCode}
            </td>
            ##退租日期
            <td class="textRight">#springMessage('common.button.refundDate')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.refundDate}
            </td>
        </tr>
        <tr>
            ##是否提前退租
            <td class="textRight">#springMessage('cms.lease.refund.isbackfront')</td>
            <td>
                $dictTag.get("sf_yn",$!{cmsAfterLeaseInfoVO.isAdvanceBack})
            </td>
            ##备注
            <td class="textRight">#springMessage('common.message.remark')</td>
            <td>
                $!{cmsAfterLeaseInfoVO.refundRmk}
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

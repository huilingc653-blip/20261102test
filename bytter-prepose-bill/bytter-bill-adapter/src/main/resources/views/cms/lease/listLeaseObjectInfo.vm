<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##租赁单号
            <td class="textRight" >#springMessage('table.cmsLease.leaseNo')</td>
            <td >
                <input type="text"  name="likes_leaseNo" autocomplete="off"
                       class="layui-input"/>
            </td>
            ##融资租赁类型
            <td class="textRight" >#springMessage('cms:lease:sub:mater:leaseType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="cms.financing.lease.info.leaseType"
                     data-name="eqs_leaseType" data-biz-name="leaseType"  ></div>
            </td>
            ##融资租赁合同编号
            <td class="textRight" >#springMessage('cms:lease:sub:mater:itemCode')</td>
            <td width="25%">
                <input type="text"  name="likes_leaseCode" autocomplete="off"
                       class="layui-input"/>
            </td>
        </tr>
        <tr>
            ##承租人
            <td class="textRight" >#springMessage('cms:lease:sub:mater:lessee')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-type="selectTree" data-name="eqs_corpId" data-resource="cms:lease:financing:apply:query" data-scope="all"></div>
                </div>
            </td>
            ##出租人
            <td class="textRight" >#springMessage('cms:lease:sub:mater:lessor')</td>
            <td width="25%">
                <input type="text"  name="likes_lessor" autocomplete="off"
                       class="layui-input"/>
            </td>
            ##            币种
            <td  class="textRight">#springMessage('table.cmsLease.oriCur')</td>
            <td >
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_oriCurid" data-biz-name="eqs_oriCurid" data-inputValue="false"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##租金金额
            <td class="textRight">#springMessage('table.cmsLease.oriMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="geg_oriMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20"
                           placeholder="#springMessage('cms:lease:sub:mater:rentalMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_oriMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" id="t20" placeholder="#springMessage('cms:lease:sub:mater:rentalMoney')">
                </div>
            </td>
            ##起租日
            <td class="textRight" >#springMessage('cms:lease:sub:mater:commencementDate')</td>
            <td >
                <input type="text" name="ged_beginDate" data-biz-name="ged_beginDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_beginDate" >
                <span class="date-mid">~</span>
                <input type="text" name="led_beginDate" data-biz-name="led_beginDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" id="led_beginDate" >
            </td>
            ##到期日
            <td class="textRight" >#springMessage('table.cmsLease.endDate')</td>
            <td >
                <input type="text" name="ged_endDate" data-biz-name="ged_endDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_endDate" >
                <span class="date-mid">~</span>
                <input type="text" name="led_endDate" data-biz-name="led_endDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" id="led_endDate" >
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsLease.leaseNo')</th>
        <th>#springMessage('table.cmsLease.leaseType')</th>
        <th>#springMessage('table.cmsLease.leaseCode')</th>
        <th>#springMessage('table.cmsLease.payCode')</th>
        <th>#springMessage('table.cmsLease.acceptor')</th>
        <th>#springMessage('table.cmsLease.lessor')</th>
        <th>#springMessage('cms:lease:sub:mater:supplier')</th>
        <th>#springMessage('table.cmsLease.oriCur')</th>
        <th>#springMessage('table.cmsLease.oriMoney')</th>
        <th>#springMessage('table.cmsLease.rmbMoney')</th>
        <th>#springMessage('table.cmsLease.beginDate')</th>
        <th>#springMessage('table.cmsLease.endDate')</th>
        <th>#springMessage('table.fcFreeze.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
    #workFlowScript()
<script src="${basePath}/static/modules/cms/lease/leaseObjectInfo.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

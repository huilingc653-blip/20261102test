<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##租赁单号
            <td class="textRight">#springMessage('table.cmsLease.leaseNo')</td>
            <td width="25%">
                <input name="likes_leaseNo" class="layui-input"
                       placeholder="#springMessage('table.cmsLease.leaseNo')">
            </td>
            ##融资租赁合同编号
            <td class="textRight">#springMessage('table.cmsLease.leaseCode')</td>
            <td width="25%">
                <input name="likes_leaseCode" class="layui-input"
                       placeholder="#springMessage('table.cmsLease.leaseCode')">
            </td>
            ##融资租赁类型
            <td class="textRight" width="8%">#springMessage('table.cmsLease.leaseType')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select"
                         data-group="cms.financing.lease.info.leaseType" data-name="eqs_leaseType"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##承租人
            <td class="textRight">#springMessage('table.cmsLease.acceptor')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="likes_corpId"
                         data-resource="cms:lease:leasecapitalplanquery:query"
                         data-scope="all"
                         data-callback="bt.corpCallback"></div>
                </div>
            </td>
            ##出租人
            <td class="textRight">#springMessage('table.cmsLease.lessor')</td>
            <td width="25%">
                <input name="likes_lessor" class="layui-input"
                       placeholder="#springMessage('table.cmsLease.lessor')">
            </td>
            ##原币币种
            <td class="textRight">#springMessage('table.cmsLease.oriCur')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_oriCurid" data-biz-name="eqs_oriCurid"
                         data-inputValue="false"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##租金金额
            <td class="textRight">#springMessage('table.cmsLease.thisMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="geg_thisMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20"
                           placeholder="#springMessage('table.cmsLease.thisMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_thisMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" id="t20"
                           placeholder="#springMessage('table.cmsLease.thisMoney')">
                </div>
            </td>
            ##起租日
            <td class="textRight">#springMessage('table.cmsLease.beginDate')</td>
            <td width="25%" class="input100">
                <div class="layui-inline">
                    <input id="ged_beginDate" name="ged_beginDate" data-endid="led_beginDate"
                           class="layui-input bt-biz-dateType" data-type="date" type="text">
                </div>
                <div class="layui-inline">
                    ~
                </div>
                <div class="layui-inline">
                    <input id="led_beginDate" name="led_beginDate" class="layui-input bt-biz-dateType"
                           data-type="date" type="text">
                </div>
            </td>
            ##到期日
            <td class="textRight">#springMessage('table.cmsLease.endDate')</td>
            <td width="25%" class="input100">
                <div class="layui-inline">
                    <input id="ged_endDate" name="ged_endDate" data-endid="led_sendDueData"
                           class="layui-input bt-biz-dateType" data-type="date" type="text">
                </div>
                <div class="layui-inline">
                    ~
                </div>
                <div class="layui-inline">
                    <input id="led_endDate" name="led_endDate" class="layui-input bt-biz-dateType"
                           data-type="date" type="text">
                </div>
            </td>
        </tr>
        <tr>
            #if($shiro.hasPermission("cms:lease:leasecapitalplanquery:query"))
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                        'common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
                </td>
            #end
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsLease.leaseNo')</th><!-- 租赁单号 -->
        <th>#springMessage('table.cmsLease.leaseCode')</th><!-- 融资租赁合同编号 -->
        <th>#springMessage('table.cmsLease.payCode')</th><!-- 买卖合同编号 -->
        <th>#springMessage('table.cmsLease.leaseType')</th><!-- 融资租赁类型 -->
        <th>#springMessage('table.cmsLease.acceptor')</th><!-- 承租人 -->
        <th>#springMessage('table.cmsLease.lessor')</th><!-- 出租人 -->
        <th>#springMessage('table.cmsLease.supplier')</th><!-- 供货商 -->
        <th>#springMessage('table.cmsLease.oriCur')</th><!-- 原币币种-->
        <th>#springMessage('table.cmsLease.oriMoney')</th><!-- 租金原币金额-->
        <th>#springMessage('table.cmsLease.rmbMoney')</th><!-- 租金人民币金额-->
        <th>#springMessage('table.cmsLease.beginDate')</th><!-- 起租日 -->
        <th>#springMessage('table.cmsLease.endDate')</th><!-- 到期日 -->
        <th>#springMessage('table.cmsLease.payDate')</th><!-- 付租日期 -->
        <th>#springMessage('table.cmsLease.thisMoney')</th><!-- 租金本金-->
        <th>#springMessage('table.cmsLease.leaseInterest')</th><!-- 租金利息-->
        <th>#springMessage('table.cmsLease.thisCost')</th><!-- 费用-->
        <th>#springMessage('table.cmsLease.bailMoney')</th><!-- 保证金金额-->
        <th>#springMessage('table.cmsLease.isRepay')</th>    ##是否已还/抵扣
        <th>#springMessage('table.cmsLease.status')</th><!-- 状态-->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
    // 是否保存操作
    var isSaveSign = $!{isSaveSign}
            bt.use(['form', 'datatable', 'moneyType', 'dateType', 'selectType', 'dicts', 'mulselect', 'corp'], function () {
                $ = bt.jquery, form = bt.form(), moneyFun = bt.moneyType.getFun();
                bt.moneyType.init();//金额
                bt.corp.init();
                bt.dateType.init();//日期
                bt.selectType.init();//日期
                bt.dicts.init();//数据字典
                bt.mulselect.init();
                //生成列表
                datatable = bt.datatable.init({
                    elem: "#appTable",
                    colReorder: true,
                    searchForm: {
                        formElem: "#searchForm",
                        formFilter: "search"
                    },
                    ajax: {
                        'url': basePath + "/cms/lease/leasecapitalplan/datatableQuery"
                    },
                    buttons: [
                        {
                            extend: "colvis",
                            text: bt.lang('common.button.theadHide'),
                            columns: ':not(:first):not(:last)'
                        }
                    ],
                    columns: [
                        {data: "leaseNo", bSortable: true},
                        {data: "leaseCode", bSortable: true},
                        {data: "payCode", bSortable: true},
                        {
                            data: "leaseType", bSortable: true, className: 'center',
                            render: function (data, type, full, meta) {
                                return bt.dict("cms.financing.lease.info.leaseType", full.leaseType);
                            }
                        },
                        {data: "corpName", bSortable: true},
                        {data: "lessor", bSortable: true},
                        {data: "supplier", bSortable: true},
                        {data: "oriCurName", bSortable: true},
                        {
                            data: "oriMoney", bSortable: true,
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.oriMoney);
                            }
                        },
                        {
                            data: "rmbMoney", bSortable: true,
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.rmbMoney);
                            }
                        },
                        {data: "beginDate", bSortable: true},
                        {data: "endDate", bSortable: true},
                        {data: "payDate", bSortable: true},
                        {
                            data: "thisMoney", bSortable: true, className: 'textRight',
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.thisMoney);
                            }
                        },
                        {
                            data: "leaseInterest", bSortable: true, className: 'textRight',
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.leaseInterest);
                            }
                        },
                        {
                            data: "thisCost", bSortable: true, className: 'textRight',
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.thisCost);
                            }
                        },
                        {
                            data: "bailMoney", bSortable: true, className: 'textRight',
                            render: function (data, type, full, meta) {
                                return bt.money.format(full.bailMoney);
                            }
                        },
                        {data: "isRepayName", bSortable: true},
                        {
                            data: "bizStatus", bSortable: true, className: 'center',
                            render: function (data, type, full, meta) {
                                return bt.dict("lease.bizStatus", full.bizStatus);
                            }
                        },
                        {
                            data: null,
                            bSortable: false,
                            className: 'center',
                            render: function (data, type, full, meta) {
                                var html = '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a>';
                                return html;
                            }
                        }
                    ]
                });

                /**判断字符串是否为空*/
                bt.empty = function (ms) {
                    if (typeof (ms) == "undefined" || ms == null || ms == "" || ms == "null") {
                        return true;
                    }
                    return false;
                }
            });

    function view(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/lease/leasecapitalplan/viewQuery/" + data.id);
            return;
        }
    }
</script>


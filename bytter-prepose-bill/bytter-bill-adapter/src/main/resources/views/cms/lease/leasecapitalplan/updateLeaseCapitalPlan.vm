<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab-content" style="width: 100%; height: 100%">
    <form class="layui-form" method="post">
        <table class="layui-table  breakRow">
            <tbody>
            <tr>
                ##租赁种类
                <td class="textRight" width="14%">#springMessage('table.cmsLease.leaseType')</td>
                <td width="36%">$!dictTag.get("cms.financing.lease.info.leaseType",$!{leaseInfoVo.leaseType})</td>
                ##租赁合同号
                <td class="textRight">#springMessage('table.cmsLease.leaseCode')</td>
                <td width="36%">$!{leaseInfoVo.leaseCode}</td>
            </tr>
            <tr>
                ##租赁单号
                <td class="textRight">#springMessage('table.cmsLease.leaseNo')</td>
                <td width="36%">$!{leaseInfoVo.leaseNo}</td>
                ##境内境外
                <td class="textRight">#springMessage('table.cmsLease.isDomestic')</td>
                <td width="36%">$!dictTag.get("btBankAcc.isDomesticBank",$!{leaseInfoVo.isDomestic})</td>
            </tr>
            <tr>
                ##承租人
                <td class="textRight" width="14%">#springMessage('table.cmsLease.acceptor')</td>
                <td width="36%">$!{leaseInfoVo.corpName}</td>
                ##出租人
                <td class="textRight" width="14%">#springMessage('table.cmsLease.lessor')</td>
                <td width="36%">$!{leaseInfoVo.lessor}</td>
            </tr>
            <tr>
                ##租赁币种
                <td class="textRight">#springMessage('table.cmsLease.oriCur')</td>
                <input type="hidden" id="curId" value="$!{leaseInfoVo.oriCurid}">
                <td width="36%">$!{leaseInfoVo.oriCurName}</td>
                ##租赁金额
                <td class="textRight">#springMessage('table.cmsLease.oriMoney')</td>
                <td width="36%">
                    <div class="layui-input-inline">
                        #if($leaseInfoVo.oriMoney)
                            $number.formatNumeric($!{leaseInfoVo.oriMoney})
                        #end
                    </div>
                </td>
            </tr>
            <tr>
                ##租金人民币金额
                <td class="textRight">#springMessage('table.cmsLease.rmbMoney')</td>
                <td width="36%">
                    <div class="layui-input-inline">
                        #if($leaseInfoVo.rmbMoney)
                            $number.formatNumeric($!{leaseInfoVo.rmbMoney})
                        #end
                    </div>
                </td>
                ##内涵报酬率
                <td class="textRight" width="14%">#springMessage('table.cmsLease.deferredRate')</td>
                <td width="36%">$!rateTag.show($!{leaseInfoVo.incRate})</td>
            </tr>
            <tr>
                ##起租日
                <td class="textRight">#springMessage('table.cmsLease.beginDate')</td>
                <td width="36%">
                    <div class="layui-input-inline">
                        $!date.format('yyyy-MM-dd',$!leaseInfoVo.beginDate)
                    </div>
                </td>
                ##到期日
                <td class="textRight" width="14%">#springMessage('table.cmsLease.endDate')</td>
                <td width="36%">
                    $!date.format('yyyy-MM-dd',$!leaseInfoVo.endDate)
                </td>
            </tr>
            <tr>
                ##租赁期限
                <td class="textRight">#springMessage('table.cmsLease.dayLimit')</td>
                <td width="36%">
                    <div class="layui-input-inline">
                        ${leaseInfoVo.dayLimit}
                    </div>
                    <div class="layui-inline">
                        ##期限单位
               $!dictTag.get("PrecativeLoanInfo.ternUnit",$!{leaseInfoVo.ternUnit})
                    </div>
                </td>
                ##到期处理
                <td class="textRight" width="14%">#springMessage('table.cmsLease.dueProcess')</td>
                <td width="36%">$!dictTag.get("cms.lease.Info.due.process",$!{leaseInfoVo.dueProcess})</td>
            </tr>
            <tr>
                ##备注
                <td class="textRight">#springMessage('table.cmsLease.rmk')</td>
                <td width="36%">
                    <div class="layui-input-inline">
                        $!{leaseInfoVo.rmk}
                    </div>
                </td>
                <td class="textRight" width="14%"></td>
                <td width="36%"></td>
            </tr>
            </tbody>
        </table>

        <table class="layui-table self-adaption" style="margin-bottom:8px">
            <thead>
            <tr>
                <td colspan="10" align="center">#springMessage('cms.cmsLease.leaseCapitalPlan')</td>
            </tr>
            <input type="hidden" id="id" name="id" value="$!{leaseCapitalPlanVo.id}">##租金计划id
            <input type="hidden" id="leaseId" name="leaseId" value="$!{leaseCapitalPlanVo.leaseId}">##租赁id
            <input type="hidden" id="payMoney" value="$!{leaseCapitalPlanVo.payMoney}">##租赁支付金额
            <input type="hidden" id="corpId" name="corpId" value="$!{leaseInfoVo.corpId}">##租赁单位
            <input type="hidden" id="leaseNo" name="leaseNo" value="$!{leaseInfoVo.leaseNo}">##租赁单号
            <input type="hidden" id="leaseCode" name="leaseCode" value="$!{leaseInfoVo.leaseCode}">##融资租赁合同编号
            <input type="hidden" id="beginDate" name="beginDate" value="$!{leaseInfoVo.beginDate}">##起租日
            <input type="hidden" id="endDate" name="endDate" value="$!{leaseInfoVo.endDate}">##到期日


            <input type="hidden" id="billCode" name="billCode" value="$!{leaseCapitalPlanVo.billCode}">##发放单号
            <input type="hidden" id="loanRate" value="$!{leaseCapitalPlanVo.loanRate}">##利率
            <input type="hidden" id="loanDate" value="$!{leaseCapitalPlanVo.loanDate}">##发放日期
            <input type="hidden" id="repayDate" value="$!{leaseCapitalPlanVo.repayDate}">##还款日期
            <input type="hidden" id="deferredRepayDate" value="$!{leaseCapitalPlanVo.deferredRepayDate}">##展期日期
            <input type="hidden" id="loanMoney" value="$!{leaseCapitalPlanVo.loanMoney}">##发放金额
            <input type="hidden" id="internalSign" name="internalSign"
                   value="$!{leaseCapitalPlanVo.internalSign}">##发放金额
            <input type="hidden" id="type" name="type" value="$!{leaseCapitalPlanVo.type}">##类型（0:借款 1：贷款 2：委托贷款）
            <input type="hidden" id="rateBase" name="rateBase" value="$!{leaseCapitalPlanVo.rateBase}">##还款计划id
            <input type="hidden" id="zqRate" name="zqRate" value="$!{leaseCapitalPlanVo.zqRate}">##展期利率
            <input type="hidden" id="zqDate" name="deferredRepayDate"
                   value="$!{leaseCapitalPlanVo.deferredRepayDate}">##展期利率
            <input type="hidden" id="orig_repayType" value="$!{leaseCapitalPlanVo.repayType}">
            <input type="hidden" id="orig_repayCycel" value="$!{leaseCapitalPlanVo.repayCycel}">

            </thead>
            <tbody>
            <tr style="display: none">
                <td width="3%"></td>
                <td align="right" width="10%">#springMessage('table.RepaymentSchedule.beginDate')</td>
                <td width="10%">
                    <input id="repayBeginDate" disabled data-min="$!{leaseInfoVo.beginDate}"
                           #*data-max="$!{leaseCapitalPlanVo.repayDate}"*#
                           name="repayBeginDate" class="layui-input bt-biz-dateType" data-type="date"
                        #if($!{leaseCapitalPlanVo.repayType} == "07")
                            ##							 自定义时还款计划 则还款开始日期为空
                           readonly="readonly"
                        #end
                        #if($!{leaseCapitalPlanVo.repayType} != "07")
                            ##							 自定义时还款计划 则还款开始日期为空
                           value="$!{leaseInfoVo.beginDate}"
                        #end
                           data-callback="beginDateChange" data-biz-name="repayBeginDate">
                </td>
                ##还款方式
                <td class="textRight" width="10%">#springMessage('cms.RepaymentSchedule.repayTypeMsg')</td>
                <td width="10%">
                    <div class="layui-inline">
                        <div class="bt-biz-dict" id="repayType" data-name="repayType" data-biz-name="repayType"
                             data-type="select"
                             data-group="Provide.RepayType" data-defaultvalue="$!{leaseCapitalPlanVo.repayType}"
                             data-required="true"
                            #if($!{leaseCapitalPlanVo.repayType} == "07")
                                ##							 自定义时还款计划不允许更改还款方式
                             data-displayData="07"
                            #end
                             data-callback="repayTypeChange" data-initCallback="repayTypeChange"></div>
                    </div>
                </td>
                <td align="right" width="10%">#springMessage('table.RepaymentSchedule.cycle') </td>
                <td colspan="3" width="30%">
                    <div class=layui-form>
                        <div class=bt-biz-dict data-type="radio" data-callback="cycleChange" data-name="repayCycel"
                            #if($!{leaseCapitalPlanVo.repayType} == "07")
                                ##							 自定义时还款计划计划还款周期不允许选择
                             data-disabled="true" data-defaultvalue="$!{leaseCapitalPlanVo.repayCycel}"
                            #end
                             data-biz-name="repayCycel" data-group="Repayment.cycle"></div>
                    </div>
                </td>
                ##<td align="center" colspan="3" width="37%">
                ##<button class="layui-btn" lay-submit="false" type="button" id="addRow">新增行</button>
                ##</td>
            </tr>
            </tbody>
        </table>
        <table class="layui-table self-adaption layui-table-border" id="leaseCapitalPlanVoTB" style="margin-bottom:8px">
            <thead>
            <tr>
                <th>#springMessage('table.cmsLease.payDate')</th> ##付租日期
                <th>#springMessage('table.cmsLease.payPlanDate')</th>    ##计划付租日
                <th>#springMessage('table.cmsLease.leaseMonry')</th> ##租赁本金
                <th>#springMessage('table.cmsLease.leaseInterest')</th>    ##租赁利息
                <th>#springMessage('table.cmsLease.thisMoney')</th> ##本期租金
                <th>#springMessage('table.cmsLease.thisCost')</th>    ##本期费用
                <th>#springMessage('table.cmsLease.surplusMoney')</th> ##剩余本金
                <th>#springMessage('table.cmsLease.bailMoney')</th> ##保证金
                <th>#springMessage('table.cmsLease.isRepay')</th>    ##是否已还
                <th>#springMessage('table.cmsLease.rmk')</th> ##备注
                <th>#springMessage('table.cmsLease.operation')</th>    ##操作
            </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot>
            <tr>
                <td align="center">#springMessage('table.interet.sum')</td>

                <td>&nbsp;</td>
                <td align="right">
                    <input type="text" style="border:none;" id="leaseMonrySum" data-name="leaseMonrySum"
                           data-biz-name="leaseMonrySum" readonly="readonly" data-decimal="2"
                           autocomplete="off" class="layui-input bt-biz-moneyType">
                </td>
                <td align="right">
                    <input type="text" style="border:none;" id="leaseInterestSum" data-name="leaseInterestSum"
                           data-biz-name="leaseInterestSum" readonly="readonly" data-decimal="2"
                           autocomplete="off" class="layui-input bt-biz-moneyType">
                </td>
                <td align="right">
                    <input type="text" style="border:none;" id="thisMoneySum" data-name="thisMoneySum"
                           data-biz-name="thisMoneySum" readonly="readonly" data-decimal="2"
                           autocomplete="off" class="layui-input bt-biz-moneyType">
                </td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
            </tr>
            </tfoot>
        </table>
        <div align="center">
            <button class="layui-btn layui-btn-small" lay-submit="" lay-filter="save">#springMessage(
                'common.button.save')</button>
            <button type="reset" class="layui-btn layui-btn-primary lay	ui-btn-small">#springMessage(
                "common.button.reset")</button>
            <a href="#" class="layui-btn layui-btn-small" onClick="doClose()">#springMessage('common.button.close')</a>
        </div>
    </form>
</div>
    #parse("views/common/footer.vm")
</body>
<style>
    html, body {
        height: 100%;
    }
</style>
<script src="${basePath}/static/modules/cms/lease/cmsleasecapitalplan/leaseCapitalPlan.update.js?_btv=${resourceVersion}"></script>
</html>

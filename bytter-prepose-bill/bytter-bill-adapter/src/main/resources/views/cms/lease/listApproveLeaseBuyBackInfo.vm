<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
    <style>
    </style>
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <input id="leaseId" name="leaseId" type="hidden" value="$!{leaseId}">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}"/>
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('cms:lease:sub:mater:leaseType')</th>
        <th>#springMessage('cms:lease:sub:mater:lessee')</th>
        <th>#springMessage('cms:lease:sub:mater:lessor')</th>
        <th>#springMessage('cms:lease:sub:mater:supplier')</th>
        <th>#springMessage('cms:lease:sub:mater:itemCode')</th>
        <th>#springMessage('cms:lease:sub:mater:contractNumb')</th>
        <th>#springMessage('cms.lease.repo.repodate')</th>
        <th>#springMessage('table.fcFreeze.status')</th>
        <th>#springMessage('cms.lease.repo.isrepofront')</th>
        <th>#springMessage('cms.lease.repo.repomoney')</th>
        <th>#springMessage('cms.lease.repo.rmk')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
<!-- 这里填写新HTML的代码 -->
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
<script>
    bt.use(['form', 'datatable', 'dateType', 'moneyType', 'btdate', 'corp', 'dicts', 'moneyType', 'btImport'], function () {
        $ = bt.jquery, form = bt.form(), moneyFun = bt.moneyType.getFun();
        bt.corp.init();
        bt.dicts.init();
        moneyType = bt.moneyType.init();
        bt.dateType.init();
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            checkbox: true,
            colReorder: true,
            ordering: false,
            order: [1, 'desc'],
            ajax: {
                'url': basePath + "/cms/afterLease/buyBack/approveDataTable?leaseId=" + $("#leaseId").val()
            },
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            fixedColumns: {
                rightColumns: 1//代表冻结右边一列
            },
            columns: [
                {
                    data: "leaseType", bSortable: true, className: 'center',
                    render: function (data, type, full, meta) {
                        return bt.dict("cms.financing.lease.info.leaseType", full.leaseType);
                    }
                },
                {data: "corpName", className: 'center', bSortable: true},
                {data: "lessor", className: 'center', bSortable: true},
                {data: "supplier", className: 'center', bSortable: true,},
                {data: "leaseCode", className: 'center', bSortable: true,},
                {data: "payCode", className: 'center', bSortable: true},
                {data: "repoDate", className: 'center', bSortable: true},
                {
                    data: "repoStatus", className: 'center', bSortable: true,
                    render: function (data, type, full, meta) {
                        return bt.dict("inl.info.status", full.repoStatus);
                    }
                },
                {
                    data: "isAdvanceBack", className: 'center', bSortable: true,
                    render: function (data, type, full, meta) {
                        return bt.dict("sf_yn", full.isAdvanceBack);
                    }
                },
                {data:"repoMoney",className:"textRight",render: function ( data, type, full, meta ){
                        return bt.money.format(full.repoMoney);
                    }},
                {data: "repoRmk", className: 'center', bSortable: true,},
                {
                    data: null,
                    className: 'center',
                    render: function (data, type, full, meta) {
                        var explode = "<span class=\"text-explode\">|</span>"
                        var id = full.id;
                        var taskId = full.taskId;
                        var html = "";
                        if ($("#flowStatus").val() == "todo") {
                            html += "<a class=\"\" href=\"#\" data-row=\"" + meta.row + "\" onclick=\"approve('" + id + "','" + taskId + "')\">" + bt.lang("common.button.approve") + "</a>" + explode;
                        }
                        if($("#flowStatus").val() == 'pass'){
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a><span class="text-explode">|</span>';
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }else {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }
                        return html;
                    }
                }
            ],
            summary: {
                pageSum: true,//小计功能开启
                selectSum: false,//已选汇总功能开启
                outerData: true,
                //groupColumn: 'curName',//分类汇总列参数
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '9', //汇总列序号
                        dataName: 'oriMoney' //汇总列数据
                    }
                ]
            }
        });
    });

    function approve(id, taskId) {
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/afterLease/buyBack/viewApprove?id=" + id + "&taskId=" + taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/afterLease/buyBack/viewApprove?id=" + id + "&taskId=" + taskId,
            end: function () {
                datatable && datatable.draw();
            }
        });
    }

    function view(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/lease/financing/info/view/" + data.id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/lease/financing/info/view/" + data.id
        });
    }
</script>
</body>
</html>

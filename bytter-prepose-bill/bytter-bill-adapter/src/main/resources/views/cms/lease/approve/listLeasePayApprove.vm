<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##租赁单号
            <td class="textRight" width="25%">#springMessage('table.cmsLease.leaseNo')</td>
            <td width="25%">
                <input name="likes_leaseNo" class="layui-input"
                       placeholder="#springMessage('table.cmsProvideLoanInfo.billCode')">
                <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}"/>
                <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
            </td>
            ##租赁合同号
            <td class="textRight">#springMessage('table.cmsLease.leaseCode')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="likes_leaseCode" id="leaseCode" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsLease.leaseNo')</th><!-- 租赁单号 -->
        <th>#springMessage('table.cmsLease.leaseCode')</th><!-- 融资租赁合同编号 -->
        <th>#springMessage('table.cmsLease.payCode')</th><!-- 买卖合同编号 -->
        <th>#springMessage('table.cmsLease.leaseType')</th><!-- 融资租赁类型 -->
        <th>#springMessage('table.cmsLease.acceptor')</th><!-- 承租人 -->
        <th>#springMessage('table.cmsLease.lessor')</th><!-- 出租人 -->
        <th>#springMessage('table.cmsLease.supplier')</th><!-- 供货商 -->
        <th>#springMessage('table.cmsLease.oriCur')</th><!-- 原币币种-->
        <th>#springMessage('table.cmsLease.oriMoney')</th><!-- 租金原币金额-->
        <th>#springMessage('table.cmsLease.rmbMoney')</th><!-- 租金人民币金额-->
        <th>#springMessage('table.cmsLease.beginDate')</th><!-- 起租日 -->
        <th>#springMessage('table.cmsLease.endDate')</th><!-- 到期日 -->
        <th>#springMessage('table.cmsLease.createBy')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
</body>
<script>
    bt.use(['form', 'datatable', 'corp', 'moneyType'], function () {
        $ = bt.jquery, form = bt.form();
        bt.corp.init();//单位
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            checkbox: true,
            ajax: {
                'url': basePath + "/cms/lease/leasepay/dataTableLeasePayApprove"
            },
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            columns: [
                {data: "leaseNo", bSortable: true},
                {data: "leaseCode", bSortable: true},
                {data: "payCode", bSortable: true},
                {
                    data: "leaseType", bSortable: true, className: 'center',
                    render: function (data, type, full, meta) {
                        return bt.dict("cms.financing.lease.info.leaseType", full.leaseType);
                    }
                },
                {data: "corpName", bSortable: true},
                {data: "lessor", bSortable: true},
                {data: "supplier", bSortable: true},
                {data: "oriCurName", bSortable: true},
                {
                    data: "oriMoney", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.oriMoney);
                    }
                },
                {
                    data: "rmbMoney", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.rmbMoney);
                    }
                },
                {data: "beginDate", bSortable: true},
                {data: "endDate", bSortable: true},
                {data: "createBy"},
                {
                    data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
                        var html = '';
                        if ($("#flowStatus").val() == 'todo') {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="approve(this)">' + bt.lang("common.button.approve") + '</a>&nbsp;|&nbsp;';
                        }
                        if($("#flowStatus").val() == 'pass'){
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a><span class="text-explode">|</span>';
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }else {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }
                        return html;
                    }
                }
            ],
            summary: {
                pageSum: true,//小计功能关闭
                selectSum: true,//已选汇总功能开启
                // groupColumn: 'curName',//分类汇总列参数
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '5',//汇总列序号
                        dataName: 'plMoney',//汇总列数据
                    }
                ]
            }
        });
    });

    /**审批*/
    function approve(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.button.approve'), basePath + "/cms/lease/leasepay/viewLeasePayApprove?businessId=" + data.id + "&taskId=" + data.taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/lease/leasepay/viewLeasePayApprove?businessId=" + data.id + "&taskId=" + data.taskId
        });
    }

    function view(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (parent.bt.navtab) {
            parent.bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/lease/leasepay/viewLeasePay?leaseId=" + data.leaseId);
            return;
        }
        top.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/lease/leasepay/viewRepay?leaseId=" + data.leaseId
        });
    }
</script>
</html>

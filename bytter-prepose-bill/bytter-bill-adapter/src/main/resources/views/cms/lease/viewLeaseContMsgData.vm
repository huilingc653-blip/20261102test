<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <input id="leaseId" name="leaseId" type="hidden" value="$!{leaseId}">
    <thead>
    <tr>
        <th>#springMessage('cms.lease.continue.continueCode')</th>
        <th>#springMessage('cms.lease.continue.continueEndDate')</th>
        <th>#springMessage('btAccNature.rmk')</th>
        <th>#springMessage('ttpay.refund.applyPeople')</th>
        <th>#springMessage('cms.lease.log.beginTime')</th>
        <th>#springMessage('bpm.model.assign')</th>
        <th>#springMessage('bpm.model.assignTime')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
    #workFlowScript()
<script>
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts", "corp", "dateType", 'rateType'], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        selectType = bt.selectType.init();
        bt.dateType.init();//日期时间
        bt.moneyType.init();
        corp = bt.corp.init();//单位
        //初始化利率
        bt.rateType.init();
        var rateType = bt.rateType.getFun();

        /**
         * 生成列表
         */
        datatable = bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            checkbox: false,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search",
                isInitData: "false"
            },
            ajax: {
                'url': basePath + "/cms/afterLease/continue/listMsgData?leaseId=" + $("#leaseId").val()
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            fixedColumns: {
                rightColumns: 2//代表冻结右边一列
            },
            columns: [
                {data: "continueCode", bSortable: true, className: 'center'},
                {data: "continueDate", bSortable: true},
                {data: "rmk", bSortable: true},
                {data: "createBy", bSortable: true},
                {data: "createDate", bSortable: true},
                {data: "updateBy", bSortable: true},
                {data: "updateDate", bSortable: true},
            ]
        });
    });
</script>
</body>
</html>

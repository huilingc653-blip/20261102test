<!DOCTYPE html>
<html lang="en" style="height: 100%">
<head>
    #parse("views/common/head.vm")
</head>
<style type="text/css">
    .voucher-title {
        font-weight: bold;
        font-size: 12px;
        text-align: center;
        border-left: 0px;
        border-right: 0px;
        background-color: #d2d2d2;
    }
</style>
<body style="height: 100%">
<div>
    <table class="layui-table  breakRow">
        <tbody>
        <tr>
            ##租赁种类
            <td class="textRight" width="14%">#springMessage('table.cmsLease.leaseType')</td>
            <td width="36%">$!dictTag.get("cms.financing.lease.info.leaseType",$!{leaseInfoVo.leaseType})</td>
            ##租赁合同号
            <td class="textRight">#springMessage('table.cmsLease.leaseCode')</td>
            <td width="36%">$!{leaseInfoVo.leaseCode}</td>
        </tr>
        <tr>
            ##租赁单号
            <td class="textRight">#springMessage('table.cmsLease.leaseNo')</td>
            <td width="36%">$!{leaseInfoVo.leaseNo}</td>
            ##境内境外
            <td class="textRight">#springMessage('table.cmsLease.isDomestic')</td>
            <td width="36%">$!dictTag.get("btBankAcc.isDomesticBank",$!{leaseInfoVo.isDomestic})</td>
        </tr>
        <tr>
            ##承租人
            <td class="textRight" width="14%">#springMessage('table.cmsLease.acceptor')</td>
            <td width="36%">$!{leaseInfoVo.corpName}</td>
            ##出租人
            <td class="textRight" width="14%">#springMessage('table.cmsLease.lessor')</td>
            <td width="36%">$!{leaseInfoVo.lessor}</td>
        </tr>
        <tr>
            ##租赁币种
            <td class="textRight">#springMessage('table.cmsLease.oriCur')</td>
            <input type="hidden" id="curId" value="$!{leaseInfoVo.oriCurid}">
            <td width="36%">$!{leaseInfoVo.oriCurName}</td>
            ##租赁金额
            <td class="textRight">#springMessage('table.cmsLease.oriMoney')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    $number.formatNumeric($!{leaseInfoVo.oriMoney})
                </div>
            </td>
        </tr>
        <tr>
            ##租金人民币金额
            <td class="textRight">#springMessage('table.cmsLease.rmbMoney')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    $number.formatNumeric($!{leaseInfoVo.rmbMoney})
                </div>
            </td>
            ##内涵报酬率
            <td class="textRight" width="14%">#springMessage('table.cmsLease.deferredRate')</td>
            <td width="36%">$!rateTag.show($!{leaseInfoVo.incRate})</td>
        </tr>
        <tr>
            ##起租日
            <td class="textRight">#springMessage('table.cmsLease.beginDate')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    $!date.format('yyyy-MM-dd',$!leaseInfoVo.beginDate)
                </div>
            </td>
            ##到期日
            <td class="textRight" width="14%">#springMessage('table.cmsLease.endDate')</td>
            <td width="36%">
                $!date.format('yyyy-MM-dd',$!leaseInfoVo.endDate)
            </td>
        </tr>
        <tr>
            ##租赁期限
            <td class="textRight">#springMessage('table.cmsLease.dayLimit')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    $!{leaseInfoVo.dayLimit}
                </div>
                <div class="layui-inline">
                    ##期限单位
               $!dictTag.get("PrecativeLoanInfo.ternUnit",$!{leaseInfoVo.ternUnit})
                </div>
            </td>
            ##到期处理
            <td class="textRight" width="14%">#springMessage('table.cmsLease.dueProcess')</td>
            <td width="36%">$!dictTag.get("cms.lease.Info.due.process",$!{leaseInfoVo.dueProcess})</td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.cmsLease.rmk')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    $!{leaseInfoVo.rmk}
                </div>
            </td>
            <td class="textRight" width="14%"></td>
            <td width="36%"></td>
        </tr>
        </tbody>
    </table>
</div>
<form class="layui-form" method="post" id="inputForm">
    <input id="id" name="id" type="hidden" value="$!{leasePayVo.id}">
    <input id="leaseId" name="leaseId" type="hidden" value="$!{leaseInfoVo.id}">
    <input id="corpId" name="corpId" type="hidden" value="$!{leaseInfoVo.corpId}">
    <input id="billCode" name="billCode" type="hidden" value="$!{leaseInfoVo.billCode}">
    <input id="sendCode" name="sendCode" type="hidden" value="$!{leaseInfoVo.sendCode}">
    <input id="leasePlanId" name="leasePlanId" type="hidden" value="$!{leasePayVo.leasePlanId}">    ## 租金计划主表
    <input id="curId" type="hidden" value="$!{leaseInfoVo.oriCurid}">   ## 租金币种
    <input id="onlineSign" type="hidden" value="$!{onlineSign}">
    <input id="downSign" type="hidden" value="$!{downSign}">
    <input id="tempOrSubmitSign" name="tempOrSubmitSign" value="$!{tempOrSubmitSign}" type="hidden">
    <table class="layui-table">
        <tbody>
        <tr class="dark-table-header">
            <td colspan="4" class="voucher-title">#springMessage('cms.cmsLease.leasepayInfo')</td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;" style="position: relative;">
                <label><b>#springMessage('table.leasepay.enrolTime')</b></label>
                <div class="layui-input-inline">
                    <input id="createDate" name="createDate" value="$!date.format('yyyy-MM-dd',$!leasePayVo.createDate)"
                           readonly="readonly" autocomplete="off" class="layui-input">
                </div>
                #*<div style="position: absolute;margin-left:50px;top:2px;" class="layui-input-inline">
                    ## 是否提前还款
                    <label><b>#springMessage('table.cmsProvideLoanRepay.isAdvancedRepay')</b></label>
                    <div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="radio"
                             data-group="cms.repay.isAdvancedRepay"
                             data-defaultvalue="0"
                             data-required="true"
                             data-name="isAdvancedRepay"
                             data-biz-name="isAdvancedRepay"></div>
                    </div>
                </div>*#
            </td>
        </tr>
        <tr>
            ##租金支付日期
            <td class="textRight" width="14%">#springMessage('table.cmsLease.payDate')</td>
            <td width="36%">
                <input class="layui-input bt-biz-dateType"
                       id="payDate"
                       name="payDate"
                       value="$!{leasePayVo.payDate}"
                       data-biz-name="payDate"
                       data-type="date"
                       lay-verify="required">
            </td>
            ##租赁本金
            <td class="textRight" width="14%">#springMessage('table.cmsLease.leaseMonry')</td>
            <td width="36%">
                <div class="layui-inline">
                    <input class="layui-input bt-biz-moneyType"
                           data-name="money"
                           value="$!{leasePayVo.money}"
                           data-max="$!{sendBalance}"
                           lay-verify="required"
                           data-biz-name="money"
                           data-callback="countOnlineMoney"
                           readonly="readonly"
                           data-decimal="2"
                           type="text"
                           placeholder="#springMessage('table.cmsLease.leaseMonry')">
                </div>
                <div class="layui-inline">
                    <!-- 还款计划 -->
                    <!-- 利息预计明细 -->
                    <button class="layui-btn" type="button" onclick="repayInterest();">#springMessage(
                            'cms.button.detail')</button>
                    <input type="hidden" id="leasePlanDelId" name="leasePlanDelId"
                           value="$!{leasePayVo.leasePlanDelId}">
                </div>
            </td>
        </tr>
        <tr>
            ##租赁利息
            <td class="textRight">#springMessage('table.cmsLease.leaseInterest')</td>
            <td>
                <div class="layui-inline">
                    <input class="layui-input bt-biz-moneyType"
                           data-name="interest"
                           value="$!{leasePayVo.interest}"
                           lay-verify="required"
                           data-biz-name="interest"
                           readonly="true"
                           data-decimal="2"
                           placeholder="#springMessage('table.cmsLease.leaseInterest')">
                </div>
            </td>
            ##金额
            <td class="textRight">
                #springMessage('table.cmsProvideLoanRepay.onlineMoney')
            </td>
            <td>
                <input class="layui-input bt-biz-moneyType"
                       data-name="leaseMoney"
                       value="$!{leasePayVo.leaseMoney}"
                       data-biz-name="leaseMoney"
                       data-decimal="2"
                       lay-verify="required"
                       placeholder="#springMessage('table.cmsProvideLoanRepay.onlineMoney')">
            </td>
        </tr>
            #if("$!{leasePayVo.onlineSign}" == "1" && "$!{downSign}" != "0")
                ##线上还款
            <input type="hidden" id="onlineSign" name="onlineSign" value="1">
            <tr>
                ##出租人/收款人
                <td class="textRight">#springMessage('table.cmsLease.lessor')</td>
                <td>
                    <input id="lessor" name="lessor" value="$!{leaseInfoVo.lessor}" data-biz-name="lessor"
                           class="layui-input" readonly="readonly"
                           placeholder="#springMessage('table.cmsLease.lessor')"/>
                </td>
                ##收款帐号
                <td class="textRight">#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="onlinePaymentAcc" name="onlinePaymentAcc" lay-verify="required"
                               value="$!{leasePayVo.onlinePaymentAcc}"
                               autocomplete="off" class="layui-input"
                               placeholder="#springMessage('table.nisBillhead.payeeAcc')">
                        <div class="bt-div-search">
                            <button class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button"
                                    data-beforeClick="bt.externalCorpBankAccParams"
                                    data-callback="bt.externalCorpCallback"
                                    title="#springMessage('common.button.select')">
                                <i class="layui-icon">&#xe615;</i>
                            </button>
                        </div>
                    </div>
                    <div class="layui-inline" id="accMsg">
                        <span></span>
                    </div>
                </td>
            </tr>
            <tr>
                ##收款帐号名称
                <td class="textRight">
                    #springMessage('table.cmsProvideLoanRepay.onlinePaymentAccName')
                </td>
                <td>
                    <input type="hidden" id="onlinePaymentAccId" name="onlinePaymentAccId"
                           value="$!{leasePayVo.onlinePaymentAccId}">
                    <input id="onlineAccName" name="onlineAccName" value="$!{leasePayVo.onlineAccName}"
                           class="layui-input"
                           type="text" readonly="readonly" lay-verify="required"
                           placeholder="#springMessage('table.cmsProvideLoanRepay.onlinePaymentAccName')"/>
                </td>
                ##收款开户行名称
                <td class="textRight">#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc.bankName')</td>
                <td>
                    <input id="onlineBankName" name="onlineBankName" value="$!{leasePayVo.onlineBankName}"
                           class="layui-input" type="text" readonly="readonly" lay-verify="required"
                           placeholder="#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc.bankName')"/>
                </td>
            </tr>
            <tr>
                ##用途
                <td class="textRight">
                    #springMessage('table.cmsProvideLoanRepay.onlinePurpose')
                </td>
                <td>
                    <div class=layui-inline>
                        <div class=bt-biz-selectType
                             data-name="purpose"
                             data-textField="purpose"
                             data-valueField="purpose"
                             data-biz-name="purpose"
                             data-url="${basePath}/cms/provide/loaninfo/getPurpose?corpId=${leaseInfoVo.corpId}"
                             data-defaultvalue="$!{leaseInfoVo.purpose}"
                             data-required="true"
                             data-inputvalue="true"
                             data-search="true">
                        </div>
                    </div>
                </td>
                ##备注
                <td class="textRight">#springMessage('table.cmsProvideLoanRepay.rmk')</td>
                <td>
                    <input id="rmk" name="rmk" value="$!{leasePayVo.rmk}" data-biz-name="rmk" class="layui-input"
                           placeholder="#springMessage('table.cmsProvideLoanRepay.rmk')"/>
                </td>
            </tr>
            #elseif("$!{leasePayVo.onlineSign}" == "0")
                ##线下还款
            <input type="hidden" id="onlineSign" name="onlineSign" value="0">
            <tr>
                ##备注
                <td class="textRight">#springMessage('table.cmsProvideLoanRepay.rmk')</td>
                <td>
                    <input id="rmk" name="rmk" value="$!{leasePayVo.rmk}" data-biz-name="rmk" class="layui-input"
                           placeholder="#springMessage('table.cmsProvideLoanRepay.rmk')"/>
                </td>
            </tr>
            #end
        </tbody>
    </table>
    <!-- 预算 -->
    <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
    <input id="repayItem" name="repayItem" type="hidden" value="$!{repayItem}">
    <input id="defItemCode" name="defItemCode" type="hidden" value="$!{defItemCode}">
    <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
    <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
    <div id="tagItemDetail"></div>
    <br>
    <br>
    <br>
    <br>
    <div class="layui-form-item layui-form-submit ">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" id="submit" type="button">#springMessage(
                'common.button.submit')</button>
            <!-- 撤回的单据不能显示暂存按钮 -->
            #*  #if("${leasePayVo.onlineStatus}" != "0")
                  <button class="layui-btn" lay-submit="" id="temp" type="button">#springMessage(
                      'common.button.temp')</button>
              #end*#
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            <button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage(
                'common.button.close')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
    #*<script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
    <script src="${basePath}/static/modules/cms/provide/cmsProvideLoanRepay.edit.js?_btv=${resourceVersion}"></script>*#

<script src="${basePath}/static/modules/cms/lease/leasepay/leasePay.edit.js?_btv=${resourceVersion}"></script>
</html>

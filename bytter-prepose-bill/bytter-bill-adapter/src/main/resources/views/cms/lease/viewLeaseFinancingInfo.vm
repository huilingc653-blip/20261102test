<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #rateInfo input {
            text-align: right;
        }

        #rateInfo .bt-biz-rateType {
            width: 128px;
        }

        .required {
            color: red;
        }

        .input-def input {
            border: none;
            width: 100%;
            height: 22px !important;
        }

        .input-def span {
            position: absolute;
            right: 4px;
            top: 0px;
        }

        .input-bp input {
            padding-right: 20px !important;
        }

        .input-percent input {
            padding-right: 18px !important;
        }

        .points-proportion-select input {
            width: 100%;
        }
    </style>
</head>
<body>


<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{leaseInfo.id}">
    <input id="leaseNo" name="leaseNo" type="hidden" value="$!{leaseInfo.leaseNo}">
    <input type="hidden" id="hasBond" value="$!{isHookBond}">
    ##融资租赁主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsLease.mainMessage')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                        <tbody>
                        <tr>
                            ##融资租赁类型
                            <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.leaseType')</td>
                            <td style="width: 35%">
                                $!dictTag.get("cms.financing.lease.info.leaseType",$!{leaseInfo.leaseType})
                            </td>
                            ##融资租赁合同编号
                            <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.leaseCode')</td>
                            <td style="width: 35%">
                            $!{leaseInfo.leaseCode}
                            </td>
                        </tr>
                        <tr>
                            ##境内境外
                            <td class="textRight">#springMessage('table.cmsLease.isDomestic')</td>
                            <td>
                                $!dictTag.get("btBankAcc.isDomesticBank",$!{leaseInfo.isDomestic})
                            </td>
                            ##买卖合同编号
                            <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.payCode')</td>
                            <td style="width: 35%">
                                $!{leaseInfo.payCode}
                            </td>
                        </tr>
                        <tr>
                            ##承租人
                            <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.acceptor')</td>
                            <td style="width: 35%">
                               $!{leaseInfo.corpName}
                            </td>
                            ##               出租人
                            <td class="textRight">#springMessage('table.cmsLease.lessor')</td>
                            <td>
                                $!{leaseInfo.lessor}
                            </td>
                        </tr>
                        <tr>
                            ##供应商
                            <td class="textRight">#springMessage('cms:lease:sub:mater:supplier')</td>
                            <td>
                                $!{leaseInfo.supplier}
                            </td>
                            ##租赁物
                            <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.leaseItem')</td>
                            <td style="width: 35%">
                                $!{leaseInfo.leaseItem}
                            </td>
                        </tr>
                        <tr>
                            ##原币币种
                            <td class="textRight">#springMessage('table.cmsLease.oriCur')</td>
                            <td>
                                $!{leaseInfo.oriCurName}
                            </td>
                            ##租金原币金额
                            <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.oriMoney')</td>
                            <td>
                                $!number.formatNumeric($!{leaseInfo.oriMoney})
                            </td>
                        </tr>

                        <tr>
                            ##内涵报酬率
                            <td class="textRight">#springMessage('table.cmsLease.deferredRate')</td>
                            <td>
                                $!rateTag.show($!{leaseInfo.incRate})
                            </td>
                            ##租金人民币金额
                            <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.rmbMoney')</td>
                            <td>
                                $!number.formatNumeric($!{leaseInfo.rmbMoney})
                            </td>
                        </tr>

                        <tr>
                            ##起租日
                            <td class="textRight">#springMessage('table.cmsLease.beginDate')</td>
                            <td>
                                $!date.format('yyyy-MM-dd',$!leaseInfo.beginDate)
                            </td>
                            ##到期日
                            <td class="textRight">#springMessage('table.cmsLease.endDate')</td>
                            <td>
                                $!date.format('yyyy-MM-dd',$!leaseInfo.endDate)
                            </td>
                        </tr>
                        <tr>
                            ##租赁期限（月）
                            <td class="textRight">#springMessage('table.cmsLease.dayLimit')</td>
                            <td>
                                <div class="layui-inline">
                                   $!{leaseInfo.dayLimit}
                                </div>
                                <div class="layui-inline">
                                    ##期限单位
                                    $!dictTag.get("PrecativeLoanInfo.ternUnit",$!{leaseInfo.ternUnit})
                                </div>
                            </td>
                            ##到期处理
                            <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.dueProcess')</td>
                            <td style="width: 35%">
                                $!dictTag.get("cms.lease.Info.due.process",$!{leaseInfo.dueProcess})
                            </td>
                        </tr>
                            ##备注
                        <tr>
                            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                            <td colspan="3">
                            $!{leaseInfo.rmk}
                            </td>
                        </tr>
                        </tbody>
                </table>
                </table>
            </div>
        </div>
    </div>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsLease.rateMessage')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##浮动方式
                        <td class="textRight">#springMessage('table.cmsLease.floatWay')</td>
                        <td>
                            $!dictTag.get("Cms.FloatWay",$!{leaseInfo.floatWay})
                        </td>
                        ##利息年度天数
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.rateBase')</td>
                        <td style="width: 35%">
                            $!dictTag.get("Cms.RateBase",$!{leaseInfo.rateBase})
                        </td>
                    </tr>
                    <tr>
                        ##浮动日期
                        <td class="textRight">#springMessage('table.cmsLease.floatDate')</td>
                        <td>
                            <div class="layui-inline" id="nextDetail">
                                #if("$!{leaseInfo.floatWay}" == "03"||"$!{leaseInfo.floatWay}" == "04"||"$!{leaseInfo.floatWay}" == "05"||"$!{leaseInfo.floatWay}" == "06")
                                    $!dictTag.get("Cms.FloatWayMonth",$!{leaseInfo.floatWayNext})
                                #end
                            </div>
                        </td>
                        ##计息方式
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLoanInfo.interestWay')</td>
                        <td style="width: 35%">
                            $!dictTag.get("cms.lease.Info.due.interestWay",$!{leaseInfo.interestWay})
                        </td>
                    </tr>
                    <tr>
                        ##利率调整生效日期
                        <td class="textRight">#springMessage('table.cmsLoanInfo.rateEntriesEffectDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!leaseInfo.effectiveDate)
                        </td>
                        ##租金计算方式
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.rentCalWay')</td>
                        <td style="width: 35%">
                            $!dictTag.get("cms.lease.Info.due.rentCalWay",$!{leaseInfo.rentCalWay})
                        </td>
                    </tr>
                    <tr>
                        ##定价基准利率类型
                        <td class="textRight">#springMessage('table.cmsLease.referenceRateType')</td>
                        <td>
                            $!{tbBaseRate.baseTypeName}
                        </td>
                        ##付息频率
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.interestFre')</td>
                        <td style="width: 35%">
                            $!dictTag.get("cms.lease.Info.due.paymoneyFre",$!{leaseInfo.interestFre})
                        </td>
                    </tr>
                    <tr>
                        ##利率期限
                        <td class="textRight">#springMessage('table.cmsLease.repayCycle')</td>
                        <td>
                              $!{tbCreditPeriod.periodName}
                        </td>
                        ##本金支付频率
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.paymoneyFre')</td>
                        <td style="width: 35%">
                            $!dictTag.get("cms.lease.Info.due.paymoneyFre",$!{leaseInfo.paymoneyFre})
                        </td>
                    </tr>
                    <tr>
                        ##报价日期
                        <td class="textRight">#springMessage('table.cmsLease.quoDate')</td>
                        <td>
                           $!date.format('yyyy-MM-dd',$!leaseInfo.quoDate)
                        </td>
                        ##费用支付频率
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.paymentFre')</td>
                        <td style="width: 35%">
                            $!dictTag.get("cms.lease.Info.due.paymoneyFre",$!{leaseInfo.paymentFre})
                        </td>
                    </tr>

                    <tr>
                        ##比例/点数
                        <td class="textRight">#springMessage('table.cmsLease.pointsProportionSelect')</td>
                        <td>
                            <div style="display: inline">
                                $!dictTag.get("Cms.PointsProportion",$!{leaseInfo.pointsProportionSelect})
                            </div>
                            <div class="layui-inline">
                                #if($!{leaseInfo.pointsProportionText})
                                    #if($!{leaseInfo.pointsProportionSelect} == "02")
                                        $!number.formatNumeric($!{leaseInfo.pointsProportionText})%
                                    #else
                                        $!number.formatNumeric($!{leaseInfo.pointsProportionText})BP
                                    #end
                                #else
                                    #if($!{leaseInfo.pointsProportionSelect} == "02")
                                        0.00%
                                    #else
                                        0.00BP
                                    #end
                                #end
                            </div>
                        </td>
                        ##租金起始支付日
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.beginPaymoneyDate')</td>
                        <td style="width: 35%">
                            $!date.format('yyyy-MM-dd',$!leaseInfo.beginPaymoneyDate)
                        </td>
                    </tr>
                    <tr>
                        ##利率
                        <td class="textRight">#springMessage('table.fcInterestDtlTemp.interestRate')</td>
                        <td>
                            $!rateTag.show($!{leaseInfo.rate})
                        </td>
                    </tr>
                    <tr>
                        ##说明
                        <td class="textRight">#springMessage('table.nisExpenseDetail.rmk')</td>
                        <td colspan="3">
                            $!{leaseInfo.ins}
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <table class="layui-table">
        ##第三方费用信息
        <tr class="dark-table-header">
            <td colspan="4" class="voucher-title" style="text-align: left">#springMessage("table.cmsProvideLoan.chargeMessage")</td>
        </tr>
        <tr>
            <td colspan="4" align="center" width="80">
                <table id="dataTable" class="layui-table">
                    <thead>
                    <th width="25%">#springMessage('table.fcChargeRule.fcChargeType')</th>##费用类型
                    <th width="25%"> #springMessage('table.guaGuarantee.handleRate')</th>##费率
                    <th width="25%">#springMessage('table.cms.projected.expemditure')</th>##预计费用
                    </thead>
                    <tbody>
                        #if($costVOS.size() > 0)
                            #foreach($detail in $!{costVOS})
                                #set($vcount = $velocityCount - 1)
                                #set($velocityCount = $costVOS.size() - 1)
                            <tr>
                                <td align="center">
                                    <input type="text" style="text-align: center;" value="$!{detail.costName}" disabled="true" class="layui-input">
                                </td>

                                <td align="center">##费率
                                    <input type="text" style="text-align: right;" value="$!rateTag.show($!{detail.rate})" disabled="true" class="layui-input">
                                </td>

                                <td align="center">##预计费用
                                    <input type="text" style="text-align: right;"  value="$!number.formatNumeric($!{detail.advanceFees})" disabled="true" class="layui-input">
                                </td>

                            </tr>
                            #end
                        #end
                    </tbody>
                </table>
            </td>
    </table>
    ##其他业务挂接信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.otherBusMessage')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <tbody>

                        #if(${leaseInfo.isHookBond}=="1")
                            ##增加保证金相关信息
                        <h2 class="layui-colla-title">#springMessage('table.fcBond.BondMsg')</h2>
                            #set($fcBondApplyDTO=$fcBondTag.getBondApplyDetail(${leaseInfo.id},${leaseInfo.leaseNo}))
                            #set($fcBondRate=($!{leaseInfo.bondRate}))
                            #set($fromType='lease')
                            #parse("views/common/viewFcBondDetail.vm")
                        #end


                        ##担保挂接
                        #if(${leaseInfo.isHangGuarantee}=="1")
                        <h2 class="layui-colla-title">#springMessage('table.guaContract.ContractMsg')</h2>
                            #set($guaContractUseDTO=$guaContractTag.getGuaContractOccupyDetail($!{leaseInfo.id},$!{leaseInfo.leaseNo}))
                            #if($!{guaContractUseDTO})
                                #parse("views/common/guaContractDetail.vm")
                            #end
                        #end
                        ##抵质押物挂接
                        #if(${leaseInfo.isRelatePledge}=="1")
                        <h2 class="layui-colla-title">#springMessage('table.cmsLease.guaPledgeTag')</h2>
                            #set($pledgeList=$guaPledgeTag.getPledgeOccupy($!{leaseInfo.id},$!{leaseInfo.leaseNo}))
                            #if($!{pledgeList})
                                #parse("views/cms/guarantee/viewPledgeList.vm")
                            #end
                        #end

                    <tr>
                        <td class="textRight">#springMessage('cms.loan.attachment')</td>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input id="annexName" name="uploadId" type="hidden" value="$!{leaseInfo.uploadId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </div>

</form>

    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    var billNo;
    bt.use(['form', 'datatable', 'corp', 'moneyType', 'btUpload', 'dicts', 'jquery','selectType','rateType'], function () {
        $ = bt.jquery, form = bt.form();
        bt.moneyType.init();
        bt.selectType.init();
        bt.rateType.init();

        var gid = $("#annexName").val();
        bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gid
        });

    })
</script>

</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <input id="leaseId" name="leaseId" type="hidden" value="$!{leaseId}">
    <input id="endDate" type="hidden" value="$!{leaseInfo.endDate}"/>
    <input id="expendedDate" type="hidden" value="$!{leaseInfo.expendedDate}"/>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsLease.mainMessage')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##融资租赁类型
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.leaseType')</td>
                        <td style="width: 35%">
                            $!dictTag.get("cms.financing.lease.info.leaseType",$!{leaseInfo.leaseType})
                        </td>
                        ##融资租赁合同编号
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.leaseCode')</td>
                        <td style="width: 35%">
                            $!{leaseInfo.leaseCode}
                        </td>
                    </tr>
                    <tr>
                        ##境内境外
                        <td class="textRight">#springMessage('table.cmsLease.isDomestic')</td>
                        <td>
                            $!dictTag.get("btBankAcc.isDomesticBank",$!{leaseInfo.isDomestic})
                        </td>
                        ##买卖合同编号
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.payCode')</td>
                        <td style="width: 35%">
                            $!{leaseInfo.payCode}
                        </td>
                    </tr>
                    <tr>
                        ##承租人
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.acceptor')</td>
                        <td style="width: 35%">
                            $!{leaseInfo.corpName}
                        </td>
                        ##               出租人
                        <td class="textRight">#springMessage('table.cmsLease.lessor')</td>
                        <td>
                            $!{leaseInfo.lessor}
                        </td>
                    </tr>
                    <tr>
                        ##供应商
                        <td class="textRight">#springMessage('cms:lease:sub:mater:supplier')</td>
                        <td>
                            $!{leaseInfo.supplier}
                        </td>
                        ##租赁物
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.leaseItem')</td>
                        <td style="width: 35%">
                            $!{leaseInfo.leaseItem}
                        </td>
                    </tr>
                    <tr>
                        ##原币币种
                        <td class="textRight">#springMessage('table.cmsLease.oriCur')</td>
                        <td>
                            $!{leaseInfo.oriCurName}
                        </td>
                        ##租金原币金额
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.oriMoney')</td>
                        <td>
                            $!number.formatNumeric($!{leaseInfo.oriMoney})
                        </td>
                    </tr>

                    <tr>
                        ##内涵报酬率
                        <td class="textRight">#springMessage('table.cmsLease.deferredRate')</td>
                        <td>
                            $!rateTag.show($!{leaseInfo.incRate})
                        </td>
                        ##租金人民币金额
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.rmbMoney')</td>
                        <td>
                            $!number.formatNumeric($!{leaseInfo.rmbMoney})
                        </td>
                    </tr>
                    <tr>
                        ##起租日
                        <td class="textRight">#springMessage('table.cmsLease.beginDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!leaseInfo.beginDate)
                        </td>
                        ##到期日
                        <td class="textRight">#springMessage('table.cmsLease.endDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!leaseInfo.endDate)
                        </td>
                    </tr>
                    <tr>
                        ##租赁期限（月）
                        <td class="textRight">#springMessage('table.cmsLease.dayLimit')</td>
                        <td>
                            <div class="layui-inline">
                                $!{leaseInfo.dayLimit}
                            </div>
                            <div class="layui-inline">
                                ##期限单位
                                    $!dictTag.get("PrecativeLoanInfo.ternUnit",$!{leaseInfo.ternUnit})
                            </div>
                        </td>
                        ##到期处理
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsLease.dueProcess')</td>
                        <td style="width: 35%">
                            $!dictTag.get("cms.lease.Info.due.process",$!{leaseInfo.dueProcess})
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                        <td>
                            $!{leaseInfo.rmk}
                        </td>
                        ##展期到期日
                        <td class="textRight">#springMessage('table.cmsPrecativeLoanDeferred.deferredRepayDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!leaseInfo.expendedDate)
                        </td>
                    </tr>
                    </tbody>
                </table>
                </table>
            </div>
        </div>
    </div>
    ##续租信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('cms.lease.repo.buyback')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##回购到期日期
                        <td class="textRight">#springMessage('cms.lease.repo.repodate')</td>
                        <td>
                            <input type="text" name="repoDate" data-biz-name="repoDate" data-type="date"
                                   lay-verify="required" data-callback="compelDate"
                                   class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_repoDate">
                        </td>
                        ##是否提前回购
                        <td width="20%" class="textRight">#springMessage('cms.lease.repo.isrepofront')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict"
                                     data-type="radio"
                                     data-disabled="true"
                                     data-name="isAdvanceBack"
                                     data-biz-name="isAdvanceBack"
                                     data-group="sf_yn"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##回购金额
                        <td width="10%" class="textRight">#springMessage('cms.lease.repo.repomoney')</td>
                        <td width="40%">
                            <div class="layui-inline">
                                <input type="text" class="layui-input bt-biz-moneyType bt-input-inline" id="repoMoney" name="repoMoney" lay-verify="required">
                            </div>
                        </td>
                        ##备注
                        <td width="10%" class="textRight">#springMessage('table.cmsLoanRepay.rmk')</td>
                        <td width="40%">
                            <div class="layui-inline">
                                <input type="text" class="layui-input" id="rmk" name="rmk">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: center;" colspan="4">
                            <button class="layui-btn" lay-submit="" value="1" id="submit">#springMessage(
                                'common.button.submit')</button>
                            <button class="layui-btn" lay-submit="" value="0" id="temp">#springMessage(
                                'common.button.temp')</button>
                            <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                'common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/lease/leaseBuyBackDetailInfo.list.js?_btv=${resourceVersion}"></script>
</html>

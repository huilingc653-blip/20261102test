<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        /*这里填写新的样式代码*/
        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }

        .noneElem {
            display: none;
        }

        .input-bp input {
            border: none;
            width: 192px;
        }
        .input-bp span {
            position: absolute;
            right: 4px;
            top: 1px;
        }
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        #parse("views/cms/inl/send/sendCommonInfo.vm")

        ##############################内部资金拆借利率调整信息######################################################################

        <tr>
            ##            内部资金拆借利率调整信息
            <td colspan="4" style="font-weight: bolder;text-align: center" class="textLeft">#springMessage('cms.inl.info.adjuestrateInfo')
                <input type="hidden" name="corpId" value="$!{inlInfo.borrowInCorp}">
                <input type="hidden" name="inlInfoId" value="$!{inlInfo.id}">
                <input type="hidden" name="inlSendId" value="$!{inlSend.id}">
            </td>
        </tr>
        <tr>
            ##            资金拆借利率
            <td class="textRight">#springMessage('cms.inl.info.rate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{inlInfo.rate})
                        $!number.formatNumeric($math.mul($!{inlInfo.rate},100),'#,##0.0000')%
                    #end
                </div>
            </td>
            ##            调整资金拆借利率
            <td class="textRight">#springMessage('cms.inl.info.adjustRate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-rateType"
                           data-biz-name="adjustRate" lay-verify="required" name="adjustRate">
                </div>
            </td>
        </tr>

        <tr>
            ##            展期利率
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.deferredRate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{inlInfo.deferredRate})
                        $!number.formatNumeric($math.mul($!{inlInfo.deferredRate},100),'#,##0.0000')%
                    #end

                </div>
            </td>
            ##            调整展期利率
            <td class="textRight">#springMessage('cms.inl.info.adjustDeferredRate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-rateType"
                           data-biz-name="adjustDeferredRate"  name="adjustDeferredRate">
                </div>
            </td>
        </tr>

        <tr>
            ##            逾期利率
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.overdueRate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{inlInfo.overdueRate})
                        $!number.formatNumeric($math.mul($!{inlInfo.overdueRate},100),'#,##0.0000')%
                    #end
                </div>
            </td>
##            调整逾期利率
            <td class="textRight">#springMessage('cms.inl.info.adjustOverdueRate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-rateType"
                           data-name="adjustOverdueRate" data-biz-name="adjustOverdueRate">
                </div>
            </td>
        </tr>
        <tr>
            ##            执行日期
            <td class="textRight">#springMessage('table.InterestWayUpdate.activeDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" name="execDate" id="execDate"
                           lay-verify="required"
                           data-name="execDate" data-biz-name="execDate">
                </div>
            </td>
            <td class="textRight"></td>
            <td>
                <div class="layui-inline">
                </div>
            </td>
        </tr>
        <tr>
            ##            备注
            <td class="textRight">#springMessage('table.cmsLoanInfo.rmk')</td>
            <td colspan="3">
                <textarea name="rmk" class="layui-textarea"></textarea>
            </td>
        </tr>
        <tr>
            ##            附件
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" name="attachmentId" id="adjuestrateAttachmentId">
                <div id="AdjuestrateUploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <table class="layui-table">
                    <thead>
                    <td>#springMessage('cms.inl.info.rate')</td>#*资金拆借利率*#
                    <td>#springMessage('table.cmsProvideLoanSend.deferredRate')</td>#*展期利率*#
                    <td>#springMessage('table.cmsProvideLoanSend.overdueRate')</td>#*逾期利率*#
                    <td>#springMessage('table.InterestWayUpdate.activeDate')</td>#*执行日期*#
                    </thead>
                    #foreach($item in $!{cmsInlAdjustrateVOs})
                        <tr>
                            <td>
                                #if(${item.adjustRate})
                                    $!number.formatNumeric($math.mul($!{item.adjustRate},100),'#,##0.0000')%
                                #end
                            </td>
                            <td>
                                #if(${item.adjustDeferredRate})
                                    $!number.formatNumeric($math.mul($!{item.adjustDeferredRate},100),'#,##0.0000')%
                                #end
                            </td>
                            <td>
                                #if(${item.adjustOverdueRate})
                                    $!number.formatNumeric($math.mul($!{item.adjustOverdueRate},100),'#,##0.0000')%
                                #end
                            </td>
                            <td>
                                $!date.format('yyyy-MM-dd',$!{item.execDate})
                            </td>
                        </tr>
                    #end
                </table>
            </td>
        </tr>
        <tr>
            <td colspan="4"style="text-align: center">
                <button class="layui-btn" type="button" lay-submit="submit" value="11" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" type="button" onclick="doClose()">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
<script>
    var form, moneyType, dateType, dicts, rateType;
    bt.use(["jquery", "form", "btUpload", "dateType", "rateType", "moneyType"], function () {
        $ = bt.jquery;
        form = bt.form();
        dateType = bt.dateType.init();
        rateType = bt.rateType.init();
        moneyType = bt.moneyType.init();
        var gid = $("#sendAttachmentId").val();
        var adjuestrateAttachmentId = $("#adjuestrateAttachmentId").val();
        var up = bt.btUpload.init({
            elem: "#sendUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });

        var adjuestrateUpload = bt.btUpload.init({
            elem: "#AdjuestrateUploader",
            isExpand: true,
            auto: false,
            gid: adjuestrateAttachmentId
        });

        // 资金计划挂接
        // renderBudget()

        form.on("submit(submit)", function (data) {
            var action = "/inl/adjustrate/save";
            bt.loading.show();
            data.field.status = 11;
            data.field.attachmentId = adjuestrateUpload.getGroupId();
            jQuery.ajaxSettings.traditional = true;
            $.post(basePath + action, data.field, function (data) {
                parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                if (data.success) {
                    if (!bt.navtab) {
                        bt.navtab.refreshParentTable();
                    } else {
                        bt.navtab.closeCurrent();
                    }
                } else {
                    bt.loading.hide();
                }
            }, 'JSON');
            return false;
        });
    });


    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }


    /**
     * 开始日期/到期日期回调
     * 计算拆借期限
     */
    function calTerm() {
        var sendEndDate = $("#infoEndDate").val();
        var endDate = dateType.get("nowDeferredDate").val();
        var unit = dicts.get("unit").val();
        if (isNotEmpty(sendEndDate) && isNotEmpty(endDate)) {
            if ("D" == unit) {
                $("#term").val(bt.date.getBetweenDay(sendEndDate, endDate));
            } else {
                $("#term").val(bt.date.getBetweenMonth(sendEndDate, endDate));
            }
        }
    }

    /**
     * 为空判断
     * @param value
     * @returns {boolean}
     */
    function isEmpty(value) {
        if (value == null || value == "" || value == undefined || value == " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param value
     * @returns {boolean}
     */
    function isNotEmpty(value) {
        return !isEmpty(value);
    }
</script>
</body>
</html>

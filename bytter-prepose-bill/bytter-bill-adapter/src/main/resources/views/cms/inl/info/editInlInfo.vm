<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }

        .noneElem {
            display: none;
        }

        .input-bp input {
            border: none;
            width: 192px;
        }
        .input-bp span {
            position: absolute;
            right: 4px;
            top: 1px;
        }
    </style>
</head>
<body>
<input type="hidden" id="natualCurId" name="natualCurId" value="$!{corp.curId}">
<input type="hidden" id="corpId" value="$!{corp.id}">
<form id="searchForm" class="layui-form">
##    内部授信挂接参数
    <input type="hidden" name="isHangCredit" id="isHangCredit" value="$!{config.inl.is_hang_credit}">
##    担保合同挂接参数
    <input type="hidden" name="isHangGuarantee" id="isHangGua" value="$!{config.inl.is_hang_gua}">
##  是否挂合同
    <input type="hidden" name="isCon" id="isCon" value="$!{config.inl.is_con}">
##    调用或者生成合同参数
    <input type="hidden" name="conType" id="conType" value="$!{config.inl.con_type}">
    <input type="hidden" name="id" id="id" value="$!{inlInfo.id}">
#*    <input type="hidden" name="conTypeId" id="conTypeId" value="$!{inlInfo.conTypeId}">*#

    ##    还款计划id
    <input type="hidden" name="planId" id="planId" value="$!{repayPlan.id}">
    #if($!{repayPlan.id})
        <input type="hidden" name="planStatus" id="planStatus" value="0">
        #else
            <input type="hidden" name="planStatus" id="planStatus" value="1">
    #end


    ##    基准利率
    <input type="hidden" name="benchmarkRate" id="benchmarkRate" value="$!{inlInfo.benchmarkRate}">
    <table class="layui-table">
        <tr>
##            内部拆借编号
            <td class="textRight" style="width: 15%">#springMessage('cms.inl.info.billNo')</td>
            <td style="width: 35%">
                <div class="layui-inline">
                    $!{inlInfo.billNo}
                    <input type="hidden" name="billNo" id="billNo" value="$!{inlInfo.billNo}">
                </div>
            </td>
            #if($!{config.inl.is_con} == 1)
                #if($!{config.inl.con_type} == 1)
                    ##            内部拆借合同号
                    <td style="width: 15%" class="textRight">#springMessage('cms.inl.info.contractNo')</td>
                    <td style="width: 35%">
                        <div class="layui-inline">
                            <input type="text" id="contractNo" class="layui-input" name="contractNo" value="$!{conInfo.conNo}">
                        </div>
                        ##挂接的合同信息
                        #parse("views/dual/manager/conInfo.vm")
                    </td>
                    #else
                    <td></td>
                    <td></td>
                #end
                #else
                    <td></td>
                    <td></td>
            #end
        </tr>
        <tr>
##            是否跳过放款申请
            <td class="textRight">#springMessage('cms.inl.info.isSkipSend')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-value="$!{inlInfo.isSkipSend}"
                         data-callback="isSkipSendCallBack"
                         data-name="isSkipSend" data-biz-name="isSkipSend" ></div>
                </div>
            </td>
            #if($!{inlInfo.isSkipSend} == 1)
                    ##            放款编号
                    <td class="textRight sendInfo">#springMessage('cms.inl.info.sendCode')</td>
                    <td class="sendInfo">
                        <div class="layui-inline">
                            <input type="text" class="layui-input" name="sendCode" id="sendCode" value="$!{inlInfo.sendCode}">
                        </div>
                    </td>
                #else
                    ##            放款编号
                    <td class="textRight sendInfo noneElem">#springMessage('cms.inl.info.sendCode')</td>
                    <td class="sendInfo noneElem">
                        <div class="layui-inline">
                            <input type="text" class="layui-input" name="sendCode" value="" id="sendCode">
                        </div>
                    </td>
            #end

        </tr>
        #if($!{inlInfo.isSkipSend} == 1)
            <tr class="sendInfo">
                ##            放款方式
                <td class="textRight">#springMessage('cms.inl.info.sendType')</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-type="select" data-group="cms.loan.loanSendOutType"
                             data-name="sendType" data-disabled="true" data-value="1" data-biz-name="sendType" ></div>
                    </div>
                </td>
                <td></td>
                <td></td>
            </tr>
            #else
                <tr class="sendInfo noneElem">
                    ##            放款方式
                    <td class="textRight">#springMessage('cms.inl.info.sendType')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="cms.loan.loanSendOutType"
                                 data-name="sendType" data-disabled="true" data-value="1" data-biz-name="sendType" ></div>
                        </div>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
        #end


        <tr>
##            单位信息
            <td class="textLeft" style="font-weight: bolder;" colspan="4">#springMessage('cms.inl.info.corpInfo')</td>
        </tr>

        <tr>
            ##            拆入单位
            <td class="textRight">#springMessage('cms.inl.info.borrowInCorp')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-biz-name="borrowInCorp" data-name="borrowInCorp" data-biz-name="borrowInCorp"
                         data-callbackData="borrowInCorpCallback" data-defaultvalue="$!{inlInfo.borrowInCorp}"
                         data-biz-type="corp" data-type="selectTree" data-required="true"></div>
                </div>
            </td>
##            拆出单位
            <td class="textRight">#springMessage('cms.inl.info.borrowOutCorp')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-biz-name="borrowOutCorp" data-name="borrowOutCorp"
                         data-defaultvalue="$!{inlInfo.borrowOutCorp}" data-callback="borrowOutCorpBack"
                         data-biz-type="corp" data-type="selectTree" data-required="true"></div>
                </div>
            </td>
        </tr>
        <tr>
##            内部资金拆借信息
            <td colspan="4" style="font-weight: bolder;" class="textLeft">#springMessage('cms.inl.info.infomation')</td>
        </tr>

        <tr>
##            拆借资金币种
            <td class="textRight">#springMessage('cms.inl.info.curId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="curId" data-biz-name="curId" data-inputValue="false" data-required="true"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-callback="curCallBack"
                         data-value="$!{inlInfo.curId}"
                         data-textfield="curName"></div>

                </div>
            </td>
##            拆借资金用途
            <td class="textRight">#springMessage('cms.inl.info.purpose')</td>
            <td>
                <div class="bt-biz-selectType" data-name="purpose" data-inputvalue="true" data-search="true" data-extradata="true"
                     data-url="${basePath}/basic/business/btpurpose?getByList&sysBusType=2&corpId=$!{inlInfo.borrowInCorp}" data-required="true"
                     data-value="$!{inlInfo.purpose}"
                     data-valuefield="purpose" data-textfield="purpose" data-biz-name="purpose"></div>
            </td>
        </tr>

        <tr>
##            拆借金额(小写)
            <td class="textRight">#springMessage('cms.inl.info.money')#springMessage('table.bisAccDtl.moneyLower')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-moneyType" data-name="money" data-biz-name="money"
                           value="$!{inlInfo.money}" data-callback="moneyCallback"
                           lay-verify="required" data-toUp="upMoney" >
                </div>
            </td>
##            拆借金额(大写)
            <td class="textRight">#springMessage('cms.inl.info.money')#springMessage('table.bisAccDtl.moneyUpper')</td>
            <td>
                <div class="layui-inline">
                    <div id="upMoney">

                    </div>
                </div>
            </td>
        </tr>

        <tr>
##            拆借日期
            <td class="textRight">#springMessage('cms.inl.info.startDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType"
                           data-biz-name="startDate"
                           data-callback="startDateCallBack" value="$!date.format('yyyy-MM-dd',$!{inlInfo.startDate})"
                           lay-verify="required" data-endId="endDate" name="startDate">
                </div>
            </td>
##            到期日期
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType"
                           data-callback="calTerm" data-biz-name="endDate" value="$!date.format('yyyy-MM-dd',$!{inlInfo.endDate})"
                           id="endDate" lay-verify="required" name="endDate">
                </div>
            </td>
        </tr>

        <tr>
##            还款方式
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayType')</td>
            <td>
                ## 取自定义还款方式
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="repayType" data-biz-name="repayType"
                         data-url="$basePath/cms/repay/repaytype/queryNoNRepayTypeList"
                         data-callback="repayTypeCallBack"
                         data-valuefield="id" data-textfield="repayName"
                         data-defaultvalue="$!{inlInfo.repayType}" data-value="$!{inlInfo.repayType}"
                         data-required="true"></div>
                </div>
                <div class="layui-inline">
                    <!-- 还款计划 -->
                    <button class="layui-btn" id="makePlanBtn" type="button"
                            onclick="repayPlan();">#springMessage('cms.button.repayPlan')</button>
                </div>
            </td>
            #if($!{inlInfo.isSkipSend} == 1)
                ##计息方式
                <td class="textRight sendInfo">#springMessage('table.cmsProvideLoanSend.interestWay')</td>
                <td class="sendInfo">
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-name="interestWay" data-value="$!{inlInfo.interestWay}"
                             data-required="true"
                             data-biz-name="interestWay" #if("$!{inlInfo.floatWayNext}" == '3') data-disabledValue='5' #end data-type="select" data-group="Admin.PredrawSign" data-callback="shouExpiryAccrued"></div>
                    </div>
                    ##计息日
                    <div class="layui-inline" id="showExpiryDate">
                        #if("$!{inlInfo.interestWay}" != "5")
                            #springMessage('table.cmsProvideLoanSend.expiryDate')
                            <div class="bt-biz-dict" data-name="expiryDate" data-type="select" data-width="100px"
                                 data-biz-name="expiryDate" data-group="bisGatherPolicy.month" data-value="$!{inlInfo.expiryDate}" data-callback="setRateEntriesEffectDate" data-defaultvalue="21" data-required="true"></div>
                        #end
                    </div>
                    ##预提日
                    <div class="layui-inline" id="showAccruedDailyDate">
                        #if("$!{inlInfo.interestWay}" == "1" || "$!{inlInfo.interestWay}" == "4")
                            #springMessage('table.cmsProvideLoanSend.accruedDailyDate')
                            <div class="bt-biz-dict" data-name="accruedDailyDate" data-type="select" data-width="100px"
                                 data-biz-name="accruedDailyDate" data-group="bisGatherPolicy.month" data-value="$!{inlInfo.accruedDailyDate}" data-defaultvalue="21" data-required="true"></div>
                        #end
                    </div>
                </td>
                #else
                    ##计息方式
                    <td class="textRight sendInfo noneElem">#springMessage('table.cmsProvideLoanSend.interestWay')</td>
                    <td class="sendInfo noneElem">
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-name="interestWay" data-value="$!{inlInfo.interestWay}"
                                 data-biz-name="interestWay" #if("$!{inlInfo.floatWayNext}" == '3') data-disabledValue='5' #end data-type="select" data-group="Admin.PredrawSign" data-callback="shouExpiryAccrued"></div>
                        </div>
                        ##计息日
                        <div class="layui-inline" id="showExpiryDate">
                            #if("$!{inlInfo.interestWay}" != "5")
                                #springMessage('table.cmsProvideLoanSend.expiryDate')
                                <div class="bt-biz-dict" data-name="expiryDate" data-type="select" data-width="100px"
                                     data-biz-name="expiryDate" data-group="bisGatherPolicy.month" data-value="$!{inlInfo.expiryDate}" data-callback="setRateEntriesEffectDate" data-defaultvalue="21" data-required="true"></div>
                            #end
                        </div>
                        ##预提日
                        <div class="layui-inline" id="showAccruedDailyDate">
                            #if("$!{inlInfo.interestWay}" == "1" || "$!{inlInfo.interestWay}" == "4")
                                #springMessage('table.cmsProvideLoanSend.accruedDailyDate')
                                <div class="bt-biz-dict" data-name="accruedDailyDate" data-type="select" data-width="100px"
                                     data-biz-name="accruedDailyDate" data-group="bisGatherPolicy.month" data-value="$!{inlInfo.accruedDailyDate}" data-defaultvalue="21" data-required="true"></div>
                            #end
                        </div>
                    </td>
            #end
        </tr>

        <tr>
            ##            拆借期限
            <td class="textRight">#springMessage('cms.inl.info.term')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="term" id="term" readonly="readonly" value="$!{inlInfo.term}">
                </div>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="PrecativeLoanInfo.ternUnit"
                         data-value="$!{inlInfo.unit}" data-callback="calTerm"
                         data-name="unit" data-biz-name="unit"></div>
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>

        <tr>
##            资金拆借利率形式
            <td class="textRight">#springMessage('cms.inl.info.floatWay')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-required="true" data-callback="floatWayCallBack"
                         data-group="Cms.FloatWay" data-name="floatWay" data-value="$!{inlInfo.floatWay}" data-biz-name="floatWay"></div>
                </div>
                <div class="layui-inline" id="nextDetail">
                </div>
            </td>
##            利率调整生效日
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rateEntriesEffectDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" data-biz-name="rateEntriesEffectDate" value="$!date.format('yyyy-MM-dd',$!{inlInfo.rateEntriesEffectDate})"
                           id="rateEntriesEffectDate" readonly="readonly" name="rateEntriesEffectDate">
                </div>
            </td>
        </tr>

        <tr>
##            浮动利率
            <td class="textRight" rowspan="3">#springMessage('table.cmsProvideLoanInfo.floatRate')</td>
            <td rowspan="3">
                <div class="layui-inline">
                    <div style="padding-bottom: 10px;padding-top: 10px;">
                        ##基准利率类型
                        <div class="bt-biz-selectType"
                             data-name="referenceRateType"
                             #if($!{corp.curId} == $!{inlInfo.curId})
##                             本位币
                             data-url="$basePath/cms/loanrate/maintence/queryBaseRate"
                             #else
##                             外币
                             data-url="$basePath/cms/loanrate/maintence/queryNotBaseRate"
                             #end
                             data-valuefield="id"
                             data-required="true"
                             data-textfield="baseTypeName"
                             data-callback="bt.loanRepayCycle"
                             data-initcallback="bt.loanRepayCycle"
                             data-defaultvalue="$!{inlInfo.referenceRateType}"
                             data-biz-name="referenceRateType">
                        </div>
                    </div>
                    <div style="padding-bottom: 10px;padding-top: 10px;">
                        ##贷款周期
                        <div class="bt-biz-selectType"
                             data-name="repayCycle"
                             data-required="true"
                             data-url="$basePath/cms/loanrate/maintence/querRateMaintence?time=$date.format("yyyy-MM-dd",$!{inlInfo.startDate})&curId=$!{inlInfo.curId}&baseId=$!{inlInfo.referenceRateType}"
                             data-valuefield="creditPeriodId"
                             data-textfield="creditPeriodName"
                             data-callback="bt.loadrepayCycle"
                             data-initcallback="initloadrepayCycle"
                             data-defaultvalue="$!{inlInfo.repayCycle}"
                             data-biz-name="repayCycle">
                        </div>
                    </div>

                    <div style="padding-bottom: 10px;padding-top: 10px;">
                        ##点数或者浮动比例选择与文本
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-name="pointsProportionSelect" data-type="select"
                                 data-value="$!{inlInfo.pointsProportionSelect}"
                                 data-group="Cms.PointsProportion" data-defaultvalue="02"
                                 data-biz-name="pointsProportionSelect" data-disabled="true"></div>
                        </div>
                        <div class="layui-inline input-bp">
                            <div class="pl rateWrap" style="width:212px">
                                <input class="layui-input bt-biz-moneyType" id="pointsProportionText"
                                       name="pointsProportionText" data-name="pointsProportionText"
                                       data-biz-name="pointsProportionText"  data-decimal="2"
                                       value="$!{inlInfo.pointsProportionText}" data-callback="getRate"
                                    #if($!{tbBaseRate.code} == 'lpr')
                                       data-max="$!{tbLoanRateMaintence.rateUpLimit}"
                                       data-min="$!{tbLoanRateMaintence.rateDownLimit}"
                                    #else
                                       data-max="100"
                                       data-min="-100"
                                    #end data-minus="true">
                                <span name="percentsymbol" class="inputMark" id="inputMark">
                                    #if($!{inlInfo.pointsProportionSelect} == '01')
                                    BP
                                        #else
                                            %
                                    #end
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </td>
##            利息计息基数
            <td class="textRight">#springMessage('cms.inl.info.rateBase')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="radio" data-value="$!{inlInfo.rateBase}" data-group="Cms.RateBase"
                         data-name="rateBase" data-biz-name="rateBase"></div>
                </div>
            </td>
        </tr>
        <tr>
##            资金拆借利率
            <td class="textRight">#springMessage('cms.inl.info.rate')</td>
            <td>
                <div class="layui-inline" style="vertical-align: baseline;">
                    <input type="text" class="layui-input bt-biz-rateType" lay-verify="required"
                           value="$!{inlInfo.rate}"
                           data-name="rate" data-biz-name="rate">
                </div>
                <div class="layui-inline" style="vertical-align: baseline;">
                    <button type="button" class="layui-btn" onclick="getRate()">#springMessage('cms.provide.getRate')</button>
                </div>
            </td>
        </tr>
        <tr>
##            拆借利息
            <td class="textRight">#springMessage('cms.inl.info.interest')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-moneyType" value="$!{inlInfo.interest}"
                           readonly="readonly" data-name="interest" data-biz-name="interest">
                </div>
            </td>
        </tr>
        <tr>
##            展期利率
            <td class="textRight">#springMessage('cms.inl.info.deferredRate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-rateType" value="$!{inlInfo.deferredRate}"
                           data-name="deferredRate" data-biz-name="deferredRate">
                </div>
            </td>
##            逾期利率
            <td class="textRight">#springMessage('cms.inl.info.overdueRate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-rateType" value="$!{inlInfo.overdueRate}"
                           data-name="overdueRate" data-biz-name="overdueRate">
                </div>
            </td>
        </tr>
        #if($!{config.inl.is_hang_credit} == 1 || $!{config.inl.is_hang_gua} == 1)
            <tr>
                ##            授信/担保信息
                <td colspan="4" style="font-weight: bolder;" class="textLeft">#springMessage('cms.inl.info.ratAndGuaInfo')</td>
            </tr>
        #end
        #if($!{config.inl.is_hang_credit} == 1)
            #parse("views/common/ratCpRationInfoCommon.vm")
            #*<tr>
                ##            授信品种
                <td class="textRight">#springMessage('授信品种')</td>
                <td>
                    <div class="layui-inline">
                        <div data-required="true" class="bt-biz-selectType" data-biz-name="itemCode"
                             data-url="${basePath}/cms/rat/ratitemcustom/getAllRatItem?type=0" data-value="$!{inlInfo.itemCode}"
                             data-valuefield="id" data-textfield="name" data-name="itemCode" data-search="true">
                        </div>
                        <div class="bt-biz-selectType" data-biz-name="billName"
                             data-url="${basePath}/cms/rat/ratBusinessRace/getBillByCustomId?customId=$!{inlInfo.itemCode}"
                             data-value="$!{inlInfo.ratBillCode}"
                             data-valuefield="id" data-textfield="raceName" data-name="billName" data-search="true">
                        </div>
                    </div>
                </td>
                ##            授信额度单
                <td class="textRight">#springMessage('授信额度单')</td>
                <td>
                    <div class="layui-inline">
                        <button class="layui-btn" type="button" onclick="selectCon()">#springMessage('选择')</button>
                    </div>
                    <div class="layui-input-inline">
                        <div id="rationBtn">
                            <button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage(
                                'common.button.view')</button>
                        </div>
                    </div>
                    ##占用授信代码
                    <span id="itemCodeTd">
                            <input type="hidden" id="ratIsHangGua" value="$!{ratUration.ratIsHangGua}">
                            <input id="rationCode" name="rationCode" value="$!{lcEnrol.rationCode}" type="hidden"/>
                            <input type="hidden" class="itemMoney" id="itemMoney" name="itemMoney" value="$!{lcEnrol.itemMoney}">
                            <input type="hidden" id="ratmodel" name="ratmodel" value="$!{lcEnrol.ratmodel}">
                    </span>
                </td>
            </tr>*#
        #end
        #if($!{config.inl.is_hang_gua} == 1)
            <tr>
                ##            担保合同
                <td class="textRight">#springMessage('table.ratBkration.guaContract')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" class="layui-input" name="guaContract" id="guaContract" value="$!{inlInfo.guaContract}" lay-verify="required" readonly="readonly">
                        <input type="hidden" name="guaContractId" id="guaContractId" value="$!{inlInfo.guaContractId}">
                    </div>
                    <div class="layui-inline">
                        <button class="layui-btn" type="button" onclick="addGuaContract()">#springMessage('选择')</button>
                    </div>
                </td>
                <td></td>
                <td></td>
            </tr>
        #end
        <tr class="sendInfo #if($!{inlInfo.isSkipSend} == 0) noneElem #end">
##            拆入方收本金账户
            <td class="textRight">#springMessage('cms.inl.info.borrowInAcc')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="borrowInAcc" id="borrowInAcc" value="$!{inlInfo.borrowInAcc}" #if($!{inlInfo.isSkipSend} == 1) lay-verify="required" #end readonly="readonly">
                    <div class="bt-div-search">
                        <button class="bt-biz-externalCorpBankAcc" data-acc="borrowInAcc" type="button" onclick="selectAcc(this)">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                    <input type="hidden" class="layui-input" name="borrowInAccId" id="borrowInAccId" value="$!{inlInfo.borrowInAccId}">
                </div>
            </td>
##            拆出方付本金账户
            <td class="textRight">#springMessage('cms.inl.info.borrowOutAcc')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="borrowOutAcc" id="borrowOutAcc" value="$!{inlInfo.borrowOutAcc}" readonly="readonly">
                    <div class="bt-div-search">
                        <button class="bt-biz-externalCorpBankAcc" data-acc="borrowOutAcc" type="button" onclick="selectAcc(this)">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                    <input type="hidden" class="layui-input" name="borrowOutAccId" id="borrowOutAccId" value="$!{inlInfo.borrowOutAccId}">
                </div>
            </td>
        </tr>
        <tr>
##            备注
            <td class="textRight">#springMessage('table.cmsLoanInfo.rmk')</td>
            <td colspan="3">
                <textarea name="rmk" class="layui-textarea">$!{inlInfo.rmk}</textarea>
            </td>
        </tr>
        <tr>
##            附件
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" name="attachmentId" id="attachmentId" value="$!{inlInfo.attachmentId}">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <!--预算-->
                ##    资金计划挂接参数
                <input type="hidden" name="isBudget" id="isBudget" value="$!{config.inl.is_budget}">
                <input id="inlInfoItem" name="inlInfoItem" type="hidden" value="$!{config.inl.info_budget}">
                <input id="defItemCode" name="defItemCode" type="hidden" value="$!{config.inl.info_budget}">
                <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
                <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
                <div id="tagItemDetail"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4"style="text-align: center">
                <button class="layui-btn" type="button" lay-submit="submit" value="11" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" type="button" lay-submit="submit" value="0" lay-filter="submit">#springMessage('common.button.temp')</button>
                <button class="layui-btn" type="button" onclick="doClose()">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</form>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }

        .noneElem {
            display: none;
        }

        .input-bp input {
            border: none;
            width: 192px;
        }
        .input-bp span {
            position: absolute;
            right: 4px;
            top: 1px;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="accId" id="accId" value="$!{accId}">
    <input type="hidden" name="flag" id="flag" value="$!{flag}">
    <input type="hidden" name="borrowInCorp" id="borrowInCorp" value="$!{borrowInCorp}">
    <input type="hidden" name="borrowOutCorp" id="borrowOutCorp" value="$!{borrowOutCorp}">
    <input type="hidden" name="eqs_curId" id="curId" value="$!{curId}">
    <input type="hidden" name="eqs_corpId"
           #if($!{flag} == 'borrowInAcc')
            value="$!{borrowInCorp}"
               #else
            value="$!{borrowOutCorp}"
           #end
           >
    <table class="layui-table">
        <tr>
            ##            账号
            <td width="10%" class="textRight">#springMessage('table.fcFreeze.blnctrAcc')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_bankAcc" class="layui-input">
                </div>
            </td>
            ##            户名
            <td width="10%" class="textRight">#springMessage('table.accountDTO.accName')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_accName" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn layui-btn-small" type="button" onclick="searchData()">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
                <div style="display: none">
                    <button class="layui-btn layui-btn-small" lay-submit lay-filter="search1" id="search1">#springMessage("common.button.search")</button>
                </div>
                <div style="display: none">
                    <button class="layui-btn layui-btn-small" lay-submit lay-filter="search2" id="search2">#springMessage("common.button.search")</button>
                </div>
            </td>
        </tr>
    </table>
</form>
<div class="layui-tab layui-tab-brief" lay-filter="listAcc">
    <ul class="layui-tab-title">
        <li class="layui-this">#springMessage('table.btBankAccApp.bankAcc')</li>
        <li class="innerTab">#springMessage('table.fcAcc.blnctrAcc')</li>
    </ul>
    <div class="layui-tab-content">
        <div class="layui-tab-item layui-show">
            <table id="appTable1" class="layui-table layui-form">
                <thead>
                <tr>
                    <th>#springMessage('table.accountDTO.accName')</th>#*户名*#
                    <th>#springMessage('table.fcInstrateAdjust.account')</th>#*账户*#
                    <th>#springMessage('table.accountDTO.bankName')</th>#*开户行*#
                    <th>#springMessage('table.bisAccDtl.curName')</th>#*币种*#
                </tr>
                </thead>
            </table>
        </div>
        <div class="layui-tab-item">
            <table id="appTable2" class="layui-table layui-form">
                <thead>
                <tr>
                    <th>#springMessage('table.accountDTO.accName')</th>#*户名*#
                    <th>#springMessage('table.fcInstrateAdjust.account')</th>#*账户*#
                    <th>#springMessage('table.bisAccDtl.curName')</th>#*币种*#
                </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<script>
    var form, element;
    bt.use(["jquery", "datatable", "form", "selectType","element"], function () {
        $ = bt.jquery;
        form = bt.form()
        element = layui.element();
        bt.selectType.init();

        element.on('tab(listAcc)', function(data){
            $.fn.dataTable.tables({visible: true, api: true}).columns.adjust().draw();
        });

        datatable1 = bt.datatable.initMultiTables({
            elem: "#appTable1",
            dom: "Brtlip",
            colReorder: true,
            ordering: false,
            checkbox: true,
            mulselect: false,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search1",
                callback:function () {
                    // console.info("1111111111")
                }
            },
            ajax: {
                "url": basePath + "/inl/info/listBankAccDataTable"
            }
            , columns: [
                {
                    data: "accName",
                    className: "center"
                }, {
                    data: "bankAcc",
                    className: "center"
                }, {
                    data: "bankName",
                    className: "center"
                }, {
                    data: "curName",
                    className: "center"
                }
            ]
        });

        datatable2 = bt.datatable.initMultiTables({
            elem: "#appTable2",
            autoWidth: false,
            colReorder: true,
            ordering: false,
            mulselect: false,
            checkbox: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search2",
                callback:function () {
                    console.info("222222222222")
                }
            },
            ajax: {
                "url": basePath + "/inl/info/listFcAccDataTable"
            }
            , columns: [
                {
                    data: "accName",
                    className: "center"
                }, {
                    data: "blnctrAcc",
                    className: "center"
                }, {
                    data: "curName",
                    className: "center"
                }
            ]
        });
        //这里填写新的js代码，请参考前端文档
    });

    /**
     * 为空判断
     * @param value
     * @returns {boolean}
     */
    function isEmpty(value) {
        if (value == null || value == "" || value == undefined || value == " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param value
     * @returns {boolean}
     */
    function isNotEmpty(value) {
        return !isEmpty(value);
    }

    /**
     * 获取选中数据
     * @returns {null}
     */
    function getSelectDate() {
        var data1 = bt.datatable.getSelectData("#appTable1");
        var data2 = bt.datatable.getSelectData("#appTable2");
        if (isNotEmpty(data1)) {
            return data1;
        }else if (isNotEmpty(data2)) {
            return data2;
        } else {
            return null;
        }
    }

    /**
     * 点击查询
     */
    function searchData() {
        $("#search1").removeClass("layui-btn-disabled");
        $("#search2").removeClass("layui-btn-disabled");
        $("#search1").trigger("click");
        $("#search2").trigger("click");
    }
    
</script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            ##            内部拆借编号
            <td width="10%" class="textRight">#springMessage('cms.inl.info.billNo')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_infoBillNo" class="layui-input">
                </div>
            </td>
            ##            拆入单位
            <td width="10%" class="textRight">#springMessage('cms.inl.info.borrowInCorp')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-biz-name="borrowInCorp" data-name="eqs_borrowInCorp" data-biz-name="borrowInCorp"
                         data-resource="cms:inl:repay:query"
                         data-biz-type="corp" data-type="selectTree"></div>
                </div>
            </td>
            ##            拆出单位
            <td width="10%" class="textRight">#springMessage('cms.inl.info.borrowOutCorp')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-biz-name="borrowOutCorp" data-name="eqs_borrowOutCorp" data-biz-name="borrowInCorp"
                         data-resource="cms:inl:repay:query"
                         data-biz-type="corp" data-type="selectTree"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##            拆借日期
            <td width="10%" class="textRight">#springMessage('cms.report.sendDate')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="ged_sendDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                    #springMessage('table.relationBank.dateRange')
                    <input type="text" name="led_sendDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                </div>
            </td>
            ##            到期日期
            <td width="10%" class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="ged_endDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                    #springMessage('table.relationBank.dateRange')
                    <input type="text" name="led_endDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                </div>
            </td>
            ##            币种
            <td width="10%" class="textRight">#springMessage('table.bisAccDtl.curName')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_curId" data-biz-name="curId" data-inputValue="false"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##            放款编号
            <td width="10%" class="textRight">#springMessage('cms.inl.info.sendCode')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_sendCode" class="layui-input">
                </div>
            </td>
            ##            还款方式
            <td width="10%" class="textRight">#springMessage('table.cmsProvideLoanSend.repayType')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_repayType" data-biz-name="repayType"
                         data-url="$basePath/cms/repay/repaytype/queryNoNRepayTypeList"
                         data-valuefield="id" data-textfield="repayName"></div>
                </div>
            </td>
            ##            下一还款日
            <td width="10%" class="textRight">#springMessage('cms.inl.info.nextRepayDate')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="layui-inline">
                        <input type="text" name="ged_nextRepayDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                        #springMessage('table.relationBank.dateRange')
                        <input type="text" name="led_nextRepayDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##            还款状态
            <td width="10%" class="textRight">#springMessage('cms.inl.info.repayStatus')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="checkbox" lay-skin="primary" name="repayStatus" value="2" checked="checked" title="#springMessage('cms.inl.info.noRepay')">
                    <input type="checkbox" lay-skin="primary" name="repayStatus" value="3" checked="checked" title="#springMessage('cms.inl.info.repayPart')">
                    <input type="checkbox" lay-skin="primary" name="repayStatus" value="1" title="#springMessage('cms.inl.info.repayAll')">
                </div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
        <th>#springMessage('cms.inl.info.billNo')</th>#*内部拆借编号*#
        <th>#springMessage('cms.inl.info.sendCode')</th>#*放款编号*#
        <th>#springMessage('cms.inl.info.borrowInCorp')</th>#*拆入单位*#
        <th>#springMessage('cms.inl.info.borrowOutCorp')</th>#*拆出单位*#
        <th>#springMessage('cms.report.sendDate')</th>#*拆借日期*#
        <th>#springMessage('table.cmsProvideLoanSend.repayDate')</th>#*到期日期*#
        <th>#springMessage('cms.inl.info.term')</th>#*拆借期限*#
        <th>#springMessage('table.bisAccDtl.curName')</th>#*币种*#
        <th>#springMessage('cms.report.sendMoney')</th>#*拆借金额*#
        <th>#springMessage('cms.inl.info.rate')</th>#*资金拆借利率*#
        <th>#springMessage('cms.inl.info.interest')</th>#*拆借利息*#
        <th>#springMessage('table.cmsProvideLoanSend.repayType')</th>#*还款方式*#
        <th>#springMessage('cms.inl.info.principalMoney')</th>#*已还本金金额*#
        <th>#springMessage('cms.inl.info.repayInterestMoney')</th>#*已还利息金额*#
        <th>#springMessage('cms.inl.info.nextRepayDate')</th>#*已还利息金额*#
        <th>#springMessage('cms.inl.info.nextRepayMoney')</th>#*已还利息金额*#
        <th>#springMessage('cms.inl.info.repayStatus')</th>#*已还利息金额*#
        <th>#springMessage('common.table.thead.operation')</th>#*操作*#
    </tr>
    </thead>
</table>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<script>
    var form, moneyFun, dicts, datatable;
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts", "corp","dateType"], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        bt.selectType.init();
        bt.dateType.init();//日期时间
        bt.moneyType.init();
        corp = bt.corp.init();//单位
        moneyFun = bt.moneyType.getFun();
        datatable = bt.datatable.initMultiTables({
            elem: "#appTable",
            dom: "Brtlip",
            colReorder: true,
            ordering: false,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                "url": basePath + "/inl/repay/dataTable"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ]
            , columns: [
                {
                    data: "infoBillNo",
                    className: "center"
                }, {
                    data: "sendCode",
                    className: "center"
                }, {
                    data: "borrowInCorpName",
                    className: "center"
                }, {
                    data: "borrowOutCorpName",
                    className: "center"
                }, {
                    data: "sendDate",
                    className: "center"
                }, {
                    data: "endDate",
                    className: "center"
                }, {
                    data: "term",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return data + bt.dict("PrecativeLoanInfo.ternUnit", full.unit);
                    }
                }, {
                    data: "curName",
                    className: "center"
                }, {
                    data: "sendMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "rate",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data * 100, {decimal: 4}) + "%";
                    }
                }, {
                    data: "interest",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "repayTypeName",
                    className: "center"
                }, {
                    data: "repayMoneyTotal",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "repayInterestTotal",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "nextRepayDate",
                    className: "center"
                }, {
                    data: "nextRepayMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "repayStatus",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("inl.send.repayStatus", data);
                    }
                }, {
                    data: null,
                    className: 'center',
                    render: function (data, type, full, meta) {
                        var html = "";
                        var split = "<span class=\"text-explode\">|</span>"
                        if (isEmpty(full.status) && Number(full.sendMoney) - Number(full.repayMoneyTotal) > 0) {
                            if (bt.isResource("cms:inl:repay:add")) {
                                html += "<a href=\"#\" onclick=\"add('" + full.inlSendId + "')\">" + bt.lang("还款申请") + "</a>";
                            }
                        }
                        if (bt.isResource("cms:inl:repay:view")) {
                            if (html != "" && html != null && html != undefined && html != " ") {
                                html += split;
                            }
                            html += "<a href=\"#\" onclick=\"view('" + full.inlSendId + "')\">" + bt.lang("common.button.view") + "</a>";
                        }
                        return html;
                    }
                }
            ]
        });
        //这里填写新的js代码，请参考前端文档
    });

    function add(id) {
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.add.data'), basePath + "/inl/repay/add?id=" + id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/inl/repay/add?id=" + id,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }

    /**
     * 查看
     * @param id
     */
    function view(id) {
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/inl/repay/viewAll?id=" + id + "&flag=" + 1);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/inl/deferred/viewAll?id=" + "&flag=" + 1,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }

    /**
     * 为空判断
     * @param value
     * @returns {boolean}
     */
    function isEmpty(value) {
        if (value === null || value === "" || value === undefined || value === " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param value
     * @returns {boolean}
     */
    function isNotEmpty(value) {
        return !isEmpty(value);
    }
</script>
</body>
</html>

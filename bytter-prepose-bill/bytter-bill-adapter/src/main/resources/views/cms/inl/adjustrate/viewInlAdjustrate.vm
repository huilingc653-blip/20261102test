<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }

        .noneElem {
            display: none;
        }

        .input-bp input {
            border: none;
            width: 192px;
        }
        .input-bp span {
            position: absolute;
            right: 4px;
            top: 1px;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        #parse("views/cms/inl/send/sendCommonInfo.vm")
        ##############################内部资金拆借展期申请信息######################################################################
        <tr>
            ##            内部资金拆借利率调整信息
            <td colspan="4" style="font-weight: bolder;text-align: center" class="textLeft">#springMessage('cms.inl.info.adjuestrateInfo')
                <input type="hidden" name="id" value="$!{inlAdjustrate.id}">
            </td>
        </tr>
        <tr>
            ##            资金拆借利率
            <td class="textRight">#springMessage('cms.inl.info.rate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{inlInfo.rate})
                        $!number.formatNumeric($math.mul($!{inlInfo.rate},100),'#,##0.0000')%
                    #end
                </div>
            </td>
            ##            调整资金拆借利率
            <td class="textRight">#springMessage('cms.inl.info.adjustRate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{inlAdjustrate.adjustRate})
                        $!number.formatNumeric($math.mul($!{inlAdjustrate.adjustRate},100),'#,##0.0000')%
                    #end
                </div>
            </td>
        </tr>

        <tr>
            ##            展期利率
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.deferredRate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{inlInfo.deferredRate})
                        $!number.formatNumeric($math.mul($!{inlInfo.deferredRate},100),'#,##0.0000')%
                    #end
                </div>
            </td>
            ##            调整展期利率
            <td class="textRight">#springMessage('cms.inl.info.adjustDeferredRate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{inlAdjustrate.adjustDeferredRate})
                        $!number.formatNumeric($math.mul($!{inlAdjustrate.adjustDeferredRate},100),'#,##0.0000')%
                    #end
                </div>
            </td>
        </tr>

        <tr>
            ##            逾期利率
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.overdueRate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{inlInfo.overdueRate})
                        $!number.formatNumeric($math.mul($!{inlInfo.overdueRate},100),'#,##0.0000')%
                    #end
                </div>
            </td>
            ##            调整逾期利率
            <td class="textRight">#springMessage('cms.inl.info.adjustOverdueRate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{inlAdjustrate.adjustOverdueRate})
                        $!number.formatNumeric($math.mul($!{inlAdjustrate.adjustOverdueRate},100),'#,##0.0000')%
                    #end
                </div>
            </td>
        </tr>
        <tr>
            ##            执行日期
            <td class="textRight">#springMessage('table.InterestWayUpdate.activeDate')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{inlAdjustrate.execDate})
                </div>
            </td>
            <td class="textRight"></td>
            <td>
                <div class="layui-inline">
                </div>
            </td>
        </tr>
        <tr>
            ##            备注
            <td class="textRight">#springMessage('table.cmsLoanInfo.rmk')</td>
            <td colspan="3">
                $!{inlAdjustrate.rmk}
            </td>
        </tr>
        <tr>
            ##            上次展期到期日期
            <td colspan="4">
                <table class="layui-table">
                    <thead>
                    <td>#springMessage('cms.inl.info.rate')</td>#*资金拆借利率*#
                    <td>#springMessage('table.cmsProvideLoanSend.deferredRate')</td>#*展期利率*#
                    <td>#springMessage('table.cmsProvideLoanSend.overdueRate')</td>#*逾期利率*#
                    <td>#springMessage('table.InterestWayUpdate.activeDate')</td>#*执行日期*#
                    </thead>
                    #foreach($item in $!{cmsInlAdjustrateVOs})
                        <tr>
                            <td>
                                #if(${item.adjustRate})
                                    $!number.formatNumeric($math.mul($!{item.adjustRate},100),'#,##0.0000')%
                                #end
                            </td>
                            <td>
                                #if(${item.adjustDeferredRate})
                                    $!number.formatNumeric($math.mul($!{item.adjustDeferredRate},100),'#,##0.0000')%
                                #end
                            </td>
                            <td>
                                #if(${item.adjustOverdueRate})
                                    $!number.formatNumeric($math.mul($!{item.adjustOverdueRate},100),'#,##0.0000')%
                                #end
                            </td>
                            <td>
                                $!date.format('yyyy-MM-dd',$!{item.execDate})
                            </td>
                        </tr>
                    #end
                </table>
            </td>
        </tr>
        <tr>
            ##            附件
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" name="attachmentId" id="adjuestrateAttachmentId" value="$!{inlAdjustrate.attachmentId}">
                <div id="AdjuestrateUploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
    </table>
</form>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<script>
    var form, moneyType, dateType, dicts, rateType;
    bt.use(["jquery", "form", "btUpload", "moneyType", "dateType", "dicts", "rateType"], function () {
        $ = bt.jquery;
        form = bt.form();
        moneyType = bt.moneyType.init();
        dateType = bt.dateType.init();
        rateType = bt.rateType.init();
        dicts = bt.dicts.init();
        var gid = $("#sendAttachmentId").val();
        var adjuestrateAttachmentId = $("#adjuestrateAttachmentId").val();
        bt.btUpload.init({
            elem: "#sendUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });

        bt.btUpload.init({
            elem: "#deferredUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: adjuestrateAttachmentId
        });

    });


    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }




    /**
     * 为空判断
     * @param value
     * @returns {boolean}
     */
    function isEmpty(value) {
        if (value == null || value == "" || value == undefined || value == " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param value
     * @returns {boolean}
     */
    function isNotEmpty(value) {
        return !isEmpty(value);
    }
</script>
</body>
</html>

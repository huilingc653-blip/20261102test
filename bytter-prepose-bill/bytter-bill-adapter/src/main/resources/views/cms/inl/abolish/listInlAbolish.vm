<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            ##            内部拆借编号
            <td width="10%" class="textRight">#springMessage('cms.inl.info.billNo')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_inlInfoBillNo" class="layui-input">
                </div>
            </td>
            ##            拆入单位
            <td width="10%" class="textRight">#springMessage('cms.inl.info.borrowInCorp')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-biz-name="borrowInCorp" data-name="eqs_borrowInCorp" data-biz-name="borrowInCorp" data-callback="borrowInCorpCallback"
                         data-resource="cms:inl:abolish:add"
                         data-biz-type="corp" data-type="selectTree"></div>
                </div>
            </td>
            ##            拆出单位
            <td width="10%" class="textRight">#springMessage('cms.inl.info.borrowOutCorp')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-biz-name="borrowOutCorp" data-name="eqs_borrowOutCorp" data-biz-name="borrowInCorp"
                         data-resource="cms:inl:abolish:add"
                         data-biz-type="corp" data-type="selectTree"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##            拆借日期
            <td width="10%" class="textRight">#springMessage('cms.inl.info.startDate')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="ged_startDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                    #springMessage('table.relationBank.dateRange')
                    <input type="text" name="led_startDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                </div>
            </td>
            ##            到期日期
            <td width="10%" class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="ged_endDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                    #springMessage('table.relationBank.dateRange')
                    <input type="text" name="led_endDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                </div>
            </td>
            ##            币种
            <td width="10%" class="textRight">#springMessage('table.bisAccDtl.curName')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_curId" data-biz-name="curId" data-inputValue="false"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##            资金用途
            <td width="10%" class="textRight">#springMessage('table.fexTranReq.capitalUse')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="likes_purpose" data-inputvalue="true" data-search="true"
                         data-url="${basePath}/basic/business/btpurpose?getByList&sysBusType=2"
                         data-valuefield="purpose" data-textfield="purpose" data-biz-name="purpose">
                    </div>
                </div>
            </td>
            ##            还款方式
            <td width="10%" class="textRight">#springMessage('table.cmsProvideLoanSend.repayType')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_repayType" data-biz-name="repayType"
                         data-url="$basePath/cms/repay/repaytype/queryNoNRepayTypeList"
                         data-valuefield="id" data-textfield="repayName"></div>
                </div>
            </td>
##            审批状态
            <td width="10%" class="textRight">#springMessage('df.approve.status')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select"
                         data-group="inl.info.status" data-name="eqi_inlInfoStatus" data-biz-name="status" data-filterData="-2"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
        <th>#springMessage('cms.inl.info.billNo')</th>#*内部拆借编号*#
        <th>#springMessage('cms.inl.info.borrowInCorp')</th>#*拆入单位*#
        <th>#springMessage('cms.inl.info.borrowOutCorp')</th>#*拆出单位*#
        <th>#springMessage('cms.inl.info.startDate')</th>#*拆借日期*#
        <th>#springMessage('table.cmsProvideLoanSend.repayDate')</th>#*到期日期*#
        <th>#springMessage('cms.inl.info.term')</th>#*拆借期限*#
        <th>#springMessage('table.bisAccDtl.curName')</th>#*币种*#
        <th>#springMessage('cms.inl.info.money')</th>#*拆借金额*#
        <th>#springMessage('cms.inl.info.rate')</th>#*资金拆借利率*#
        <th>#springMessage('cms.inl.info.interest')</th>#*拆借利息*#
        <th>#springMessage('table.btBankAccDtl.uses')</th>#*用途*#
        <th>#springMessage('table.cmsPrecativeLoanInfo.repayType')</th>#*还款方式*#
        <th>#springMessage('common.table.status')</th>#*状态*#
        <th>#springMessage('common.table.thead.operation')</th>#*操作*#
    </tr>
    </thead>
</table>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<script>
    var form, moneyFun, dicts, datatable, selectType;
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts", "corp","dateType"], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        selectType = bt.selectType.init();
        bt.dateType.init();//日期时间
        bt.moneyType.init();
        corp = bt.corp.init();//单位
        moneyFun = bt.moneyType.getFun();
        datatable = bt.datatable.initMultiTables({
            elem: "#appTable",
            dom: "Brtlip",
            colReorder: true,
            ordering: false,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                "url": basePath + "/inl/abolish/listAbolishInfoDataTable"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ]
            , columns: [
                {
                    data: "inlInfoBillNo",
                    className: "center"
                }, {
                    data: "borrowInCorpName",
                    className: "center"
                }, {
                    data: "borrowOutCorpName",
                    className: "center"
                }, {
                    data: "startDate",
                    className: "center"
                }, {
                    data: "endDate",
                    className: "center"
                }, {
                    data: "term",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return data + bt.dict("PrecativeLoanInfo.ternUnit", full.unit);
                    }
                }, {
                    data: "curName",
                    className: "center"
                }, {
                    data: "infoMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "infoRate",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data * 100, {decimal: 4}) + "%";
                    }
                }, {
                    data: "infoInterest",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "infoPurpose",
                    className: "textRight"
                }, {
                    data: "repayTypeName",
                    className: "center"
                }, {
                    data: "status",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("inl.info.status", data);
                    }
                }, {
                    data: null,
                    className: 'center',
                    render: function (data, type, full, meta) {
                        var html = "";
                        var split = "<span class=\"text-explode\">|</span>"
                        if (full.status == -1) {
                            if (bt.isResource("cms:inl:abolish:edit")) {
                                html += "<a href=\"#\" onclick=\"edit('" + full.id + "')\">" + bt.lang("common.button.edit") + "</a>";
                            }
                            if (bt.isResource("cms:inl:abolish:delete")) {
                                if (html != "" && html != null && html != undefined && html != " ") {
                                    html += split;
                                }
                                html += "<a href=\"#\" onclick=\"deleteById('" + full.id + "')\">" + bt.lang("common.button.delete") + "</a>";
                            }
                        }
                        if (isEmpty(full.status) || full.status == -2) {
                            if (bt.isResource("cms:inl:abolish:add")) {
                                if (html != "" && html != null && html != undefined && html != " ") {
                                    html += split;
                                }
                                html += "<a href=\"#\" onclick=\"add('" + full.inlInfoId + "')\">" + bt.lang("作废") + "</a>";
                            }
                        }
                        if (bt.isResource("cms:inl:info:view")) {
                            if (html != "" && html != null && html != undefined && html != " ") {
                                html += split;
                            }
                            html += "<a href=\"#\" onclick=\"view('" + full.inlInfoId + "')\">" + bt.lang("common.button.view") + "</a>";
                        }
                        return html;
                    }
                }
            ]
        });
        //这里填写新的js代码，请参考前端文档
    });

    function edit(id) {
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.edit'), basePath + "/inl/abolish/edit?id=" + id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/inl/abolish/edit?id=" + id,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }


    function add(id) {
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.add.data'), basePath + "/inl/abolish/add?id=" + id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/inl/info/add?id=" + id,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }


    function view(id) {
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/inl/info/view?id=" + id + "&flag=" + 1);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/inl/info/view?id=" + "&flag=" + 1,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }

    function deleteById(id) {
        parent.layer.confirm(bt.lang("table.sysTask.deletedsw")+"?",function () {
            bt.loading.show();
            var url = "/inl/abolish/deletById?id=" + id;
            $.post(basePath + url,function(data){
                bt.loading.hide();
                parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                datatable && datatable.draw();
            },'JSON');
        });
    }

    /**
     * 为空判断
     * @param value
     * @returns {boolean}
     */
    function isEmpty(value) {
        if (value == null || value == "" || value == undefined || value == " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param value
     * @returns {boolean}
     */
    function isNotEmpty(value) {
        return !isEmpty(value);
    }

    /**
     * 单位选择回调
     */
    function borrowInCorpCallback() {
        var corpId = corp.get("borrowInCorp").val();
        var url = basePath + "/basic/business/btpurpose?getByList&sysBusType=2&corpId=" + corpId;
        selectType.get("purpose").attr({"data-defaultvalue": "","data-url": url});
    }
</script>
</body>
</html>

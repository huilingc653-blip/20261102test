<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }

        .noneElem {
            display: none;
        }

        .input-bp input {
            border: none;
            width: 192px;
        }
        .input-bp span {
            position: absolute;
            right: 4px;
            top: 1px;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        #parse("views/cms/inl/send/sendCommonInfo.vm")

        ##############################内部资金拆借展期申请信息######################################################################

        <tr>
            ##            内部资金拆借展期申请信息
            <td colspan="4" style="font-weight: bolder;text-align: center" class="textLeft">#springMessage('cms.inl.info.deferredRecord')
                <input type="hidden" name="corpId" value="$!{inlInfo.borrowInCorp}">
                <input type="hidden" name="inlInfoId" value="$!{inlInfo.id}">
                <input type="hidden" name="inlSendId" value="$!{inlSend.id}">
            </td>
        </tr>

        <tr>
            ##            上次展期到期日期
            <td colspan="4">
                <table class="layui-table">
                    <thead>
                        <td>#springMessage('table.fcBond.orderNo')</td>
                        <td>#springMessage('table.lastTime.deferredRepayDate')</td>
                        <td>#springMessage('table.cmsLoanSend.deferredReplayDate')</td>
                        <td>#springMessage('table.cmsPrecativeLoanDeferred.deferredLimt')</td>
                        <td>#springMessage('table.cmsProvideLoanSend.deferredRate')</td>
                    </thead>
                    #foreach($item in $!{cmsInlDeferreds})
                        <tr>
                            <td>$velocityCount</td>
                            <td>$!date.format('yyyy-MM-dd',$!{item.lastDeferredDate})</td>
                            <td>$!date.format('yyyy-MM-dd',$!{item.nowDeferredDate})</td>
                            <td>
                                #if($!{item.term})
                                $!{item.term}$!dictTag.get('PrecativeLoanInfo.ternUnit',$!{item.unit})
                            #end
                            </td>
                            <td>
                                #if($!{item.deferredRate})
                                    $!number.formatNumeric($math.mul($!{item.deferredRate},100),'#,##0.0000')%
                                #end
                            </td>
                        </tr>
                    #end
                </table>
            </td>
        </tr>
    </table>
</form>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<script>
    var form, moneyType, dateType, dicts, rateType;
    bt.use(["jquery", "form", "btUpload", "moneyType", "dateType", "dicts", "rateType"], function () {
        $ = bt.jquery;
        form = bt.form();
        moneyType = bt.moneyType.init();
        dateType = bt.dateType.init();
        rateType = bt.rateType.init();
        dicts = bt.dicts.init();
        var gid = $("#sendAttachmentId").val();
        var deferredAttachmentId = $("#deferredAttachmentId").val();
        var up = bt.btUpload.init({
            elem: "#sendUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });

        var sendUpload = bt.btUpload.init({
            elem: "#deferredUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: deferredAttachmentId
        });

    });


    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }




    /**
     * 为空判断
     * @param value
     * @returns {boolean}
     */
    function isEmpty(value) {
        if (value == null || value == "" || value == undefined || value == " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param value
     * @returns {boolean}
     */
    function isNotEmpty(value) {
        return !isEmpty(value);
    }
</script>
</body>
</html>

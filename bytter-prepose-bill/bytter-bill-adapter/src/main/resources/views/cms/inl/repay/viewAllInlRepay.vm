<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>

        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }

        .noneElem {
            display: none;
        }

        .input-bp input {
            border: none;
            width: 192px;
        }
        .input-bp span {
            position: absolute;
            right: 4px;
            top: 1px;
        }

        .bread-text .capNubmer {
            height: auto;
            line-height: normal;
            min-height: 20px;
        }
    </style>
</head>
<body>

<form id="searchForm" class="layui-form">
    <table class="layui-table">
        #parse("views/cms/inl/send/sendCommonInfo.vm")
    </table>
    <table id="appTable" class="layui-table layui-form">
        <thead>
        <tr>
            <th>#springMessage('table.cmsProvideLoanRepay.billCode')</th>#*拆入单位*#
            <th>#springMessage('table.cmsProvideLoanRepay.repayDate')</th>#*拆出单位*#
            <th>#springMessage('cms.inl.info.repayCurId')</th>#*拆借日期*#
            <th>#springMessage('table.createRepayPlan.repaymentMoney')</th>#*到期日期*#
            <th>#springMessage('table.cmsProvideLoanRepay.repayAccrual')</th>#*拆借期限*#
            <th>#springMessage('common.table.status')</th>#*状态*#
        </tr>
        </thead>
        #foreach($item in $!{inlRepays})
            <tr>
                <td style="text-align: center">$!{item.billNo}</td>
                <td style="text-align: center">$!date.format('yyyy-MM-dd',$!{item.repayDate})</td>
                <td style="text-align: center">$!{item.curName}</td>
                <td style="text-align: right">$!number.formatNumeric($!{item.repayMoney})</td>
                <td style="text-align: right">$!number.formatNumeric($!{item.repayInterest})</td>
                #if($!{item.status} == 96)
                    <td style="text-align: center">#springMessage('cms.inl.info.status.Paid')</td>#*状态*#
                #else
                    <td style="text-align: center">#springMessage('cms.inl.info.inWay')</td>#*状态*#
                #end
            </tr>
        #end
    </table>
    <div style="width: 100%;text-align: center">
        <button class="layui-btn" type="button" onclick="doClose()">#springMessage('common.button.close')</button>
    </div>
</form>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<script>
    var form, moneyType, dateType, dicts, rateType;
    bt.use(["jquery", "form", "btUpload", "moneyType", "dateType", "dicts", "rateType"], function () {
        $ = bt.jquery;
        form = bt.form();
        moneyType = bt.moneyType.init();
        dateType = bt.dateType.init();
        rateType = bt.rateType.init();
        dicts = bt.dicts.init();
        var gid = $("#sendAttachmentId").val();
        var repayAttachmentId = $("#repayAttachmentId").val();
        var up = bt.btUpload.init({
            elem: "#sendUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });

        var repayUpload = bt.btUpload.init({
            elem: "#repayUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: repayAttachmentId
        });

        // 资金计划挂接
        // renderBudget()

    });


    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }

    /**
     * 为空判断
     * @param value
     * @returns {boolean}
     */
    function isEmpty(value) {
        if (value == null || value == "" || value == undefined || value == " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param value
     * @returns {boolean}
     */
    function isNotEmpty(value) {
        return !isEmpty(value);
    }

</script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            ##            内部拆借编号
            <td width="10%" class="textRight">#springMessage('cms.inl.info.billNo')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_billNo" class="layui-input">
                </div>
            </td>
            ##            拆入单位
            <td width="10%" class="textRight">#springMessage('cms.inl.info.borrowInCorp')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-biz-name="borrowInCorp" data-name="eqs_borrowInCorp" data-biz-name="borrowInCorp"
                         data-resource="cms:inl:report1:query"
                         data-biz-type="corp" data-type="selectTree"></div>
                </div>
            </td>
            ##            拆出单位
            <td width="10%" class="textRight">#springMessage('cms.inl.info.borrowOutCorp')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-biz-name="borrowOutCorp" data-name="eqs_borrowOutCorp" data-biz-name="borrowInCorp"
                         data-resource="cms:inl:report1:query"
                         data-biz-type="corp" data-type="selectTree"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##            拆借日期
            <td width="10%" class="textRight">#springMessage('cms.inl.info.startDate')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="ged_startDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                    #springMessage('table.relationBank.dateRange')
                    <input type="text" name="led_startDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                </div>
            </td>
            ##            到期日期
            <td width="10%" class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="ged_endDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                    #springMessage('table.relationBank.dateRange')
                    <input type="text" name="led_endDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                </div>
            </td>
            ##            币种
            <td width="10%" class="textRight">#springMessage('table.bisAccDtl.curName')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_curId" data-biz-name="curId" data-inputValue="false"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##            状态
            <td width="10%" class="textRight">#springMessage('cms.inl.info.sendStatus')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select"
                         data-group="inl.send.sendStatus" data-name="eqi_sendStatus" data-biz-name="sendStatus" ></div>
                </div>
            </td>
            ##            还款状态
            <td width="10%" class="textRight">#springMessage('cms.inl.info.repayStatus')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="checkbox" lay-skin="primary" name="repayStatus" value="2" checked="checked" title="#springMessage('cms.inl.info.noRepay')">
                    <input type="checkbox" lay-skin="primary" name="repayStatus" value="3" checked="checked" title="#springMessage('cms.inl.info.repayPart')">
                    <input type="checkbox" lay-skin="primary" name="repayStatus" value="1" title="#springMessage('cms.inl.info.repayAll')">
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
        <th>#springMessage('cms.inl.info.billNo')</th>#*内部拆借编号*#
        <th>#springMessage('cms.inl.info.borrowInCorp')</th>#*拆入单位*#
        <th>#springMessage('cms.inl.info.borrowOutCorp')</th>#*拆出单位*#
        <th>#springMessage('table.bisAccDtl.curName')</th>#*币种*#
        <th>#springMessage('cms.inl.info.money')</th>#*总拆借金额*#
        <th>#springMessage('cms.inl.info.startDate')</th>#*拆借日期*#
        <th>#springMessage('协议到期日期')</th>#*协议到期日期*#
        <th>#springMessage('cms.inl.info.term')</th>#*拆借期限*#
        <th>#springMessage('table.cmsLoanSend.sendedMoney')</th>#*已放款金额*#
        <th>#springMessage('cms.inl.info.waitSendMoney')</th>#*待放款金额*#
        <th>#springMessage('cms.inl.info.sendStatus')</th>#*放款状态*#
        <th>#springMessage('cms.inl.info.principalMoney')</th>#*已还本金金额*#
        <th>#springMessage('cms.inl.info.repayInterestMoney')</th>#*已还利息金额*#
        <th>#springMessage('cms.inl.info.repayStatus')</th>#*还款状态*#
        <th>#springMessage('cms.inl.info.leftRepayMoney')</th>#*剩余还款本金*#
    </tr>
    </thead>
</table>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<script>
    var form, moneyFun, dicts, datatable;
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts", "corp", "dateType", 'btImport'], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        bt.selectType.init();
        bt.dateType.init();//日期时间
        bt.moneyType.init();
        corp = bt.corp.init();//单位
        moneyFun = bt.moneyType.getFun();
        datatable = bt.datatable.initMultiTables({
            elem: "#appTable",
            dom: "Brtlip",
            colReorder: true,
            ordering: false,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                "url": basePath + "/inl/report/listReportData"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }, {
                    hide: bt.isnotResource('netbank:bankAcc:btBankAcc:apply'),
                    text: bt.lang("common.button.imports"),
                    action: function (e, dt, node, config) {
                        importExcel();
                    }
                }
            ]
            , columns: [
                {
                    data: "billNo",
                    className: "center"
                }, {
                    data: "borrowInCorpName",
                    className: "center"
                }, {
                    data: "borrowOutCorpName",
                    className: "center"
                }, {
                    data: "curName",
                    className: "center"
                }, {
                    data: "money",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "startDate",
                    className: "center"
                }, {
                    data: "endDate",
                    className: "center"
                }, {
                    data: "term",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return data + bt.dict("PrecativeLoanInfo.ternUnit", full.unit);
                    }
                }, {
                    data: "sendMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "waitSendMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "sendStatus",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return bt.dict("inl.send.sendStatus", data);
                    }
                }, {
                    data: "repayMoneyTotal",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "repayInterestTotal",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "repayStatus",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("inl.send.repayStatus", data);
                    }
                }, {
                    data: null,
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(Number(full.sendMoney) - Number(full.repayMoneyTotal));
                    }
                }
            ]
        });
        //这里填写新的js代码，请参考前端文档
    });

    /**
     * 为空判断
     * @param value
     * @returns {boolean}
     */
    function isEmpty(value) {
        if (value == null || value == "" || value == undefined || value == " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param value
     * @returns {boolean}
     */
    function isNotEmpty(value) {
        return !isEmpty(value);
    }

    importExcel = function () {
        up = bt.btImport.init({
            code: "70000002",
            titleRows: 0,
            width: "100%",
            height: "100%",
            headRows: 1,
            success: function (head, data, select) { //点击确认后回调方法，这里导入组件写了success方法这里可以不用此方法
                $.ajax({
                    type: "POST",
                    url: basePath + "/inl/report/saveImport",
                    dataType: "json",
                    contentType: "application/json",
                    data: JSON.stringify(up.getSelectData()),
                    success: function (result) {
                        bt.datatable.refreshCurrentPage();
                        parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                    }
                });
            }
        });
    }
</script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }

        .noneElem {
            display: none;
        }

        .input-bp input {
            border: none;
            width: 192px;
        }
        .input-bp span {
            position: absolute;
            right: 4px;
            top: 1px;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        #parse("views/cms/inl/send/sendCommonInfo.vm")

        ##############################内部资金拆借还款计划修改记录######################################################################
        <tr>
            ##            内部资金拆借还款计划修改记录
            <td colspan="4" style="font-weight: bolder;text-align: center" class="textLeft">#springMessage('cms.inl.info.replayPlanUpdate.Record')
                <input type="hidden" name="id" value="$!{inlAdjustrate.id}">
            </td>
        </tr>

        <tr>
            <td colspan="4">
                <table class="layui-table">
                    <thead>
                    <td>#springMessage('table.fcBond.orderNo')</td>#*序号*#
                    <td>#springMessage('cms.inl.info.repayStartDate')</td>#*还款开始日期*#
                    <td>#springMessage('table.cmsProvideLoanSend.repayType')</td>#*还款方式*#
                    <td>#springMessage('cms.inl.info.repayCycle')</td>#*还款周期*#
                    </thead>
                    #foreach($item in $!{cmsInlChanges})
                        <tr>
                            <td>
                                $velocityCount
                            </td>
                            <td>
                                $!date.format('yyyy-MM-dd',$!{item.repayStartDate})
                            </td>
                            <td>
                                $!{item.repayTypeName}
                            </td>
                            <td>
                                #if($!{item.repayCycelName})
                                    $!{item.repayCycelName}
                                #end
                            </td>
                        </tr>
                    #end
                </table>
            </td>
        </tr>
        <tr>
            ##            内部资金拆借还款计划修改记录
            <td colspan="4" style="font-weight: bolder;text-align: center" class="textLeft">#springMessage('内部资金拆借还款计划')
            </td>
        </tr>
        <tr>
            ##            上次展期到期日期
            <td colspan="4">
                <table class="layui-table">
                    <thead>
                    <th>#springMessage('table.createRepayPlan.prediceRepayDate')</th> ##预计还款日
                    <th>#springMessage('table.createRepayPlan.repaymentMoney')</th>	##还款本金
                    <th>#springMessage('table.createRepayPlan.repaymentIst')</th> ##还款利息
                    <th>#springMessage('table.createRepayPlan.currentRepayMoney')</th>	##本期还款金额
                    <th>#springMessage('table.createRepayPlan.surplusMoney')</th> ##剩余本金
                    <th>#springMessage('table.createRepayPlan.isRepay')</th>	##是否已还
                    </thead>
                    #set($repaymentMoneyTotal = 0)
                    #set($repaymentIstTotal = 0)
                    #set($currentRepayMoneyTotal = 0)
                    #foreach($item in $!{repayPlans})
                        #set($repaymentMoneyTotal = $repaymentMoneyTotal + $!{item.repaymentMoney})
                        #set($repaymentIstTotal = $repaymentIstTotal + $!{item.repaymentIst})
                        #set($currentRepayMoneyTotal = $currentRepayMoneyTotal + $!{item.currentRepayMoney})
                        #set($count = $velocityCount - 1)
                        <tr data-num="$count">
                            <td style="text-align: center">
                                $!date.format('yyyy-MM-dd',$!{item.prediceRepayDate})
                            </td>
                            <td style="text-align: right">
                                $!number.formatNumeric($!{item.repaymentMoney})
                            </td>
                            <td style="text-align: right">
                                $!number.formatNumeric($!{item.repaymentIst})
                            </td>
                            <td style="text-align: right">
                                $!number.formatNumeric($!{item.currentRepayMoney})
                            </td>
                            <td style="text-align: right">
                                $!number.formatNumeric($!{item.surplusMoney})
                            </td>
                            <td name="isRepay">
                                $dictTag.get("sf_yn",$!{item.isRepay})
                            </td>
                        </tr>
                    #end
                </table>
            </td>
        </tr>
        <tr>
            ##            附件
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" name="attachmentId" id="adjuestrateAttachmentId" value="$!{inlAdjustrate.attachmentId}">
                <div id="AdjuestrateUploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
    </table>
</form>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<script>
    var form, moneyType, dateType, dicts, rateType;
    bt.use(["jquery", "form", "btUpload", "moneyType", "dateType", "dicts", "rateType"], function () {
        $ = bt.jquery;
        form = bt.form();
        moneyType = bt.moneyType.init();
        dateType = bt.dateType.init();
        rateType = bt.rateType.init();
        dicts = bt.dicts.init();
        var gid = $("#sendAttachmentId").val();
        var adjuestrateAttachmentId = $("#adjuestrateAttachmentId").val();
        bt.btUpload.init({
            elem: "#sendUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });

        bt.btUpload.init({
            elem: "#AdjuestrateUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: adjuestrateAttachmentId
        });

    });


    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }




    /**
     * 为空判断
     * @param value
     * @returns {boolean}
     */
    function isEmpty(value) {
        if (value == null || value == "" || value == undefined || value == " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param value
     * @returns {boolean}
     */
    function isNotEmpty(value) {
        return !isEmpty(value);
    }
</script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }

        .noneElem {
            display: none;
        }

        .input-bp input {
            border: none;
            width: 192px;
        }
        .input-bp span {
            position: absolute;
            right: 4px;
            top: 1px;
        }
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<input type="hidden" id="natualCurId" name="natualCurId" value="$!{corp.curId}">
<form id="searchForm" class="layui-form">
    ##    内部授信挂接参数
    <input type="hidden" name="isHangCredit" value="$!{config.inl.is_hang_credit}">
    ##    担保合同挂接参数
    <input type="hidden" name="isHangGua" value="$!{config.inl.is_hang_gua}">
    ##  是否挂合同
    <input type="hidden" name="isCon" value="$!{config.inl.is_con}">
    ##    调用或者生成合同参数
    <input type="hidden" name="conType" value="$!{config.inl.con_type}">
    <input type="hidden" name="inlInfoId" value="$!{inlInfo.id}">
    <table class="layui-table">
        <tr>
            ##            内部拆借编号
            <td class="textRight" style="width: 15%">#springMessage('cms.inl.info.billNo')</td>
            <td style="width: 35%">
                <div class="layui-inline">
                    $!{inlInfo.billNo}
                </div>
            </td>
            #parse("views/cms/inl/info/conCommonInlInfo.vm")
        </tr>
        <tr>
            ##            拆入单位
            <td class="textRight">#springMessage('cms.inl.info.borrowInCorp')</td>
            <td>
                <div class="layui-inline">
                    $!{inlInfo.borrowInCorpName}
                </div>
            </td>
            ##            拆出单位
            <td class="textRight">#springMessage('cms.inl.info.borrowOutCorp')</td>
            <td>
                <div class="layui-inline">
                    $!{inlInfo.borrowOutCorpName}
                </div>
            </td>
        </tr>
        <tr>
            ##            拆借资金币种
            <td class="textRight">#springMessage('cms.inl.info.curId')</td>
            <td>
                <div class="layui-inline">
                    $!{inlInfo.curName}
                    <input type="hidden" id="curId" value="$!{inlInfo.curId}">
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>

        <tr>
            ##            拆借金额
            <td class="textRight">#springMessage('cms.inl.info.money')#springMessage('table.bisAccDtl.moneyLower')</td>
            <td>
                <div class="layui-inline">
                    $!number.formatNumeric($!{inlInfo.money},'#,##0.00')
                    <input type="hidden" class="layui-input bt-biz-moneyType" data-name="money" value="$!{inlInfo.money}" data-biz-name="money"
                           data-toUp="upMoney" >
                </div>
            </td>
            ##            拆借金额(大写)
            <td class="textRight">#springMessage('cms.inl.info.money')#springMessage('table.bisAccDtl.moneyUpper')</td>
            <td>
                <div class="layui-inline">
                    <div id="upMoney">

                    </div>
                </div>
            </td>
        </tr>

        <tr>
            ##            拆借日期
            <td class="textRight">#springMessage('cms.inl.info.startDate')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{inlInfo.startDate})
                    <input type="hidden" id="startDate" value="$!date.format('yyyy-MM-dd',$!{inlInfo.startDate})">
                </div>
            </td>
            ##            到期日期
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{inlInfo.endDate})
                </div>
            </td>
        </tr>
        <tr>
            #if($!{config.inl.is_hang_gua} == 1)
                ##            担保合同
                <td class="textRight">#springMessage('table.ratBkration.guaContract')</td>
                <td>
                    <div class="layui-inline">
                        $!{inlInfo.guaContract}
                    </div>
                </td>
                ##                内部拆借期限
                <td class="textRight">#springMessage('cms.inl.info.term')</td>
                <td>
                    #if($!{inlInfo.term})
                                $!{inlInfo.term}$dictTag.get("PrecativeLoanInfo.ternUnit",$!{inlInfo.unit})
                            #end
                </td>
            #else
                ##                内部拆借期限
                <td class="textRight">#springMessage('cms.inl.info.term')</td>
                <td>
                    #if($!{inlInfo.term})
                                $!{inlInfo.term}$dictTag.get("PrecativeLoanInfo.ternUnit",$!{inlInfo.unit})
                            #end
                </td>
                <td></td>
                <td></td>
            #end
        </tr>
        #if($!{config.inl.is_hang_credit} == 1)
            #if(${inlInfo.isHangCredit} == 1)
                <tr>
                    ##            授信品种
                    <td class="textRight">#springMessage('table.cmsProvideLoanInfo.itemCode')</td>
                    <td>
                        <div class="layui-inline">
                            $!{cpURationDTO.ratItemName}
                            <input type="hidden" id="cpRatItemCode" value="$!{cpURationDTO.ratItemCode}">
                        </div>
                    </td>
                    ##            授信额度单
                    <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rationSelect')</td>
                    <td>
                        <div class="layui-inline">
                            <div id="cpRationBtn">
                            <span id="cpItemCodeTd">
                                <input type="hidden" id="cpRatCode"  name="cpRatCode" value="$!{cpURationDTO.ratCode}"/>
                                <input type="hidden" id="cpItemFlag" name="cpItemFlag" value="$!{cpURationDTO.itemFlag}"/>
                                <input type="hidden" id="cpItemMoney" name="cpItemMoney" value="$!{cpURationDTO.money}"/>
                                <input type="hidden"  id="cpUrationId" name="cpUrationId" value="$!{cpURationDTO.urationId}"/>
                            </span>
                                <button type="button" onclick="viewCpRatCode()" class="layui-btn">#springMessage('common.button.view')</button>
                            </div>
                        </div>
                        </span>
                    </td>
                </tr>
            #end
        #end
        <tr>
            ##            附件
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" id="attachmentId" value="$!{inlInfo.attachmentId}">
                <div id="uploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>

        ##############################内部资金拆借放款信息######################################################################

        <tr>
            ##            内部资金拆借放款信息
            <td colspan="4" style="font-weight: bolder;text-align: center" class="textLeft">#springMessage('内部资金拆借放款信息')
                <input type="hidden" name="borrowInCorp" id="borrowInCorp" value="$!{inlSend.borrowInCorp}">
                <input type="hidden" name="borrowOutCorp" value="$!{inlSend.borrowOutCorp}">
                <input type="hidden" name="id" value="$!{inlSend.id}">
                <input type="hidden" id="billNo" value="$!{inlSend.billNo}">
                <input type="hidden" id="ProcessDate" value="$!{inlSend.sendDate}">
            </td>
        </tr>

        <tr>
            ##            待放款金额
            <td class="textRight">#springMessage('cms.inl.info.waitSendMoney')</td>
            <td>
                <div class="layui-inline">
                    $!number.formatNumeric($!{inlInfo.waitSendMoney})
                </div>
            </td>
            ##            放款编号
            <td class="textRight">#springMessage('cms.inl.info.sendCode')</td>
            <td>
                <div class="layui-inline">
                    $!{inlSend.sendCode}
                </div>
            </td>
        </tr>

        <tr>
            ##            放款方式
            <td class="textRight">#springMessage('cms.inl.info.sendType')</td>
            <td>
                <div class="layui-inline">
                    $!dictTag.get('cms.loan.loanSendOutType',$!{inlSend.sendType})
                </div>
            </td>
            ##            放款币种
            <td class="textRight">#springMessage('cms.inl.info.sendCurId')</td>
            <td>
                <div class="layui-inline">
                    $!{inlSend.curName}
                </div>
            </td>
        </tr>
        <tr>
            ##            放款金额
            <td class="textRight">#springMessage('cms.report.sendMoney')</td>
            <td>
                <div class="layui-inline">
                    $!number.formatNumeric($!{inlSend.sendMoney})
                    <input type="hidden" class="layui-input bt-biz-moneyType" data-name="sendMoney" data-biz-name="sendMoney"
                           value="$!{inlSend.sendMoney}"
                           data-min="0" data-max="$!{inlSend.sendMoney}"
                           data-toUp="upSendMoney" >
                </div>
            </td>
            ##            放款金额（大写）
            <td class="textRight">#springMessage('cms.report.sendMoney')#springMessage('table.bisAccDtl.moneyUpper')</td>
            <td>
                <div class="layui-inline">
                    <div id="upSendMoney"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##            放款日期
            <td class="textRight">#springMessage('cms.report.sendDate')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{inlSend.sendDate})
                </div>
            </td>
            ##            到期日期
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{inlSend.endDate})
                </div>
            </td>
        </tr>
        <tr>
            ##            还款方式
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayType')</td>
            <td>
                <div class="layui-inline">
                   $!{inlSend.repayTypeName}
                </div>
            </td>
            ##            计息方式
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.interestWay')</td>
            <td>
                $!dictTag.get('Admin.PredrawSign',$!{inlSend.interestWay}) &nbsp;&nbsp;
                #if($!{inlSend.expiryDate})
                    #springMessage('table.cmsProvideLoanSend.expiryDate')
                    $!{inlSend.expiryDate}
                #end
                #if($!{inlSend.accruedDailyDate})
                    #springMessage('table.cmsProvideLoanSend.accruedDailyDate')
                    $!{inlSend.accruedDailyDate}
                 #end
            </td>
        </tr>
        <tr>
            ##            拆借期限
            <td class="textRight">#springMessage('cms.inl.info.term')</td>
            <td>
                $!{inlSend.term}
                $!dictTag.get('PrecativeLoanInfo.ternUnit',$!{inlSend.unit})
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            ##            资金拆借利率形式
            <td class="textRight">#springMessage('cms.inl.info.floatWay')</td>
            <td>
                <div class="layui-inline">
                    $!dictTag.get('Cms.FloatWay',$!{inlSend.floatWay})
                </div>
            </td>
            ##            利率调整生效日
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rateEntriesEffectDate')</td>
            <td>
                <div class="layui-inline">
                    $!{inlSend.rateEntriesEffectDate}
                </div>
            </td>
        </tr>
        <tr>
            ##            浮动利率
            <td class="textRight" rowspan="3">#springMessage('table.cmsProvideLoanInfo.floatRate')</td>
            <td rowspan="3">
                <div class="layui-inline">
                    <div style="padding-bottom: 10px;padding-top: 10px;">
                        ##基准利率类型
                        $!{baseRate.baseTypeName}
                    </div>
                    <div style="padding-bottom: 10px;padding-top: 10px;">
                        ##贷款周期
                        $!{creditPeriod.periodName}
                    </div>

                    <div style="padding-bottom: 10px;padding-top: 10px;">
                        ##点数或者浮动比例选择与文本
                        #if($!{baseRate.code} == 'lpr')
                            #if($!{inlInfo.pointsProportionText})
                                $!{inlInfo.pointsProportionText}BP
                            #else
                                0.00BP
                            #end
                        #else
                            #if($!{inlInfo.pointsProportionText})
                                $!{inlInfo.pointsProportionText}%
                            #else
                                0.00%
                            #end
                        #end
                    </div>
                </div>
            </td>
            ##            利息计息基数
            <td class="textRight">#springMessage('cms.inl.info.rateBase')</td>
            <td>
                <div class="layui-inline">
                    $!dictTag.get('Cms.RateBase',$!{inlSend.rateBase})
                </div>
            </td>
        </tr>
        <tr>
            ##            资金拆借利率
            <td class="textRight">#springMessage('cms.inl.info.rate')</td>
            <td>
                <div class="layui-inline" style="vertical-align: baseline;">
                    #if($!{inlSend.rate})
                        $!number.formatNumeric($!math.mul($!{inlSend.rate},100),'#,##0.0000')%
                    #end
                </div>
            </td>
        </tr>
        <tr>
            ##            拆借利息
            <td class="textRight">#springMessage('cms.inl.info.interest')</td>
            <td>
                <div class="layui-inline">
                    $!number.formatNumeric($!{inlInfo.interest})
                </div>
            </td>
        </tr>
        <tr>
            ##            展期利率
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.deferredRate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{inlSend.deferredRate})
                        $!number.formatNumeric($!math.mul($!{inlSend.deferredRate},100),'#,##0.0000')%
                    #end
                </div>
            </td>
            ##            逾期利率
            <td class="textRight">#springMessage('cms.inl.info.overdueRate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{inlSend.overdueRate})
                        $!number.formatNumeric($!math.mul($!{inlSend.overdueRate},100),'#,##0.0000')
                    #end
                </div>
            </td>
        </tr>
        <tr>
            ##            拆入方收本金账户
            <td class="textRight">#springMessage('cms.inl.info.borrowInAcc')</td>
            <td>
                <div class="layui-inline">
                    $!{inlSend.borrowInAcc}
                </div>
            </td>
            ##            拆出方付本金账户
            <td class="textRight">#springMessage('cms.inl.info.borrowOutAcc')</td>
            <td>
                <div class="layui-inline">
                    $!{inlSend.borrowOutAcc}
                </div>
            </td>
        </tr>
        <tr>
            ##            备注
            <td class="textRight">#springMessage('table.cmsLoanInfo.rmk')</td>
            <td colspan="3">
                $!{inlSend.rmk}
            </td>
        </tr>
        <tr>
            ##            附件
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" name="attachmentId" id="sendAttachmentId" value="$!{inlSend.attachmentId}">
                <div id="sendUploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <!--预算-->
                ##    资金计划挂接参数
                <input type="hidden" name="isBudget" id="isBudget" value="$!{config.inl.is_budget}">
                <input id="inlInfoItem" name="inlInfoItem" type="hidden" value="$!{config.inl.info_budget}">
                <input id="defItemCode" name="defItemCode" type="hidden" value="$!{config.inl.info_budget}">
                <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
                <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
                <div id="tagItemDetail"></div>
            </td>
        </tr>
    </table>
</form>
<script src="${basePath}/static/modules/cms/rat/cpration/ratCpUrationSet.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/loan/hookConOp.js?_btv=${resourceVersion}"></script>
<script>
    bt.use(["jquery", "form", "btUpload", "moneyType", "conView"], function () {
        $ = bt.jquery;
        form = bt.form();
        bt.moneyType.init();//金额
        conView = bt.conView.init();//合同查看组件
        var gid = $("#attachmentId").val();
        var sendAttachmentId = $("#sendAttachmentId").val();
        var up = bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });

        var up = bt.btUpload.init({
            elem: "#sendUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: sendAttachmentId
        });

        /**
         * 加载资金计划
         */
        renderBudget();
    });

    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }

    /**
     * 设置授信参数
     * @returns {{beginDate, corpId: *, ratItemCode, curCode: *}}
     */
    function beforeCpRation(){
        var borrowInCorp = $("#borrowInCorp").val();
        var curId = $("#curId").val();
        var cpRatItemCode = $("#cpRatItemCode").val();
        var startDate = $("#startDate").val();
        var params = {
            corpId: borrowInCorp,
            curCode: curId,
            ratItemCode: cpRatItemCode,
            beginDate: startDate
        };
        return params;
    }


    /**
     * 资金计划查看
     */
    function renderBudget(){
        //判断支付结算是否挂接资金计划
        var isBudget = $("#isBudget").val();
        if(isBudget == "1"){
            //判断直融业务是否挂资金计划
            var inlInfoItem = $("#inlInfoItem").val();
            if(inlInfoItem != null && inlInfoItem != ""){
                genOtherHtml();
            }else{
                $("#tagItemDetail").html("");
            }
        }
    }

    function genOtherHtml() {
        var url = basePath + "/budget/fbsBudgetProcess/getViewItemDetail";
        var param = {
            corpId: $("#borrowInCorp").val(),
            itemCode: $("#inlInfoItem").val(),
            billNo: $("#billNo").val(),
            businessName: $("#businessName").val(),
            processSysname: $("#processSysname").val(),
            processDate: $("#ProcessDate").val(),
            curId: $("#curId").val(),//币别
            type: 'select',
            date: (new Date()).getTime()
        };
        $.ajax({
            url: url, method: 'POST', data: param, async: true, success: function (json) {
                $("#tagItemDetail").html("");
                $("#tagItemDetail").html(json);
                form.render();
            }
        });
    }
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>

<form class="layui-form" action="">

<table class="layui-table">
        <thead>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
			<td width="80%">#springMessage('config.fbs.paramValue')</td>
		</tr>
        </thead>
		<tbody>
        <tr>
            <td width="20%" class="textRight">#springMessage('拆入方内部拆借是否挂内部授信')</td>
            <td width="80%">
            	<div class="layui-input-inline">
            		<input type="radio" name="inl.is_hang_credit" value="0" #if($config.inl.is_hang_credit == 0)checked#end title="#springMessage('nis.sc_yn.no')">
             		<input type="radio" name="inl.is_hang_credit" value="1" #if($config.inl.is_hang_credit == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
				</div>
			</td>
        </tr>
        <tr>
            <td width="20%" class="textRight">#springMessage('拆入方内部拆借是否挂担保')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="radio" name="inl.is_hang_gua" value="0" #if($config.inl.is_hang_gua == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                    <input type="radio" name="inl.is_hang_gua" value="1" #if($config.inl.is_hang_gua == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                </div>
            </td>
        </tr>
        <tr>
            <td width="20%" class="textRight">#springMessage('内部拆借是否挂资金计划')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="radio" name="inl.is_budget" value="0" #if($config.inl.is_budget == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                    <input type="radio" name="inl.is_budget" value="1" #if($config.inl.is_budget == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                </div>
            </td>
        </tr>
        <tr>
            <td width="20%" class="textRight">#springMessage('内部资金拆借放款资金计划科目')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="text" class="layui-input" name="inl.info_budget" value="$!{config.inl.info_budget}">
                </div>
                <span style="font-size:12px; color:red">#springMessage("config.accebill.recItem.desc")</span>
            </td>
        </tr>
        <tr>
            <td width="20%" class="textRight">#springMessage('内部资金拆借还款资金计划科目')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="text" class="layui-input" name="inl.repay_budget" value="$!{config.inl.repay_budget}">
                </div>
                <span style="font-size:12px; color:red">#springMessage("config.accebill.recItem.desc")</span>
            </td>
        </tr>
        <tr>
            <td width="20%" class="textRight">#springMessage('内部拆借展期次数')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="radio" name="inl.deferred_num" value="0"
                           #if($config.inl.deferred_num == 0)checked#end title="#springMessage("cms.BorrowDfNum.one")">
                    <input type="radio" name="inl.deferred_num" value="1"
                           #if($config.inl.deferred_num == 1)checked#end title="#springMessage("cms.BorrowDfNum.more")">
                </div>
            </td>
        </tr>
        <tr>
            <td width="20%" class="textRight">#springMessage('还款到期提醒提前天数')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="text" class="layui-input" name="inl.notify_days" value="$!{config.inl.notify_days}">
                </div>
            </td>
        </tr>
        <tr>
            <td width="20%" class="textRight">#springMessage('是否对接合同管理')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="hidden" id="relateCon" value="$config.inl.is_con">
                    <input type="radio" name="inl.is_con" value="0" lay-filter="relateCon"
                           #if($config.inl.is_con == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                    <input type="radio" name="inl.is_con" value="1"  lay-filter="relateCon"
                           #if($config.inl.is_con == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                </div>
            </td>
        </tr>
        <tr>
            <td width="20%" class="textRight">#springMessage('对接合同管理模式')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="radio" name="inl.con_type" value="0" class="conType"
                           #if($config.inl.con_type == 0)checked#end title="#springMessage('拆借生成合同')">
                    <input type="radio" name="inl.con_type" value="1" class="conType"
                           #if($config.inl.con_type == 1)checked#end title="#springMessage('拆借调用合同')">
                </div>
            </td>
        </tr>
        <tr>
            <td width="20%" class="textRight">#springMessage('履约环节')</td>
            <td width="80%">
                <div class="layui-input-inline">
                    <input type="checkbox" lay-skin="primary" name="inl.con_segment" value="0" class="conType"
                           #if($config.inl.con_segment.indexOf("0") >= 0)checked#end title="#springMessage('cms.config.makeLoans')">
                    <input type="checkbox" lay-skin="primary" name="inl.con_segment" value="1" class="conType"
                           #if($config.inl.con_segment.indexOf("1") >= 0)checked#end title="#springMessage('cms.config.repayMents')">
                </div>
            </td>
        </tr>
        <tr>
        	<td colspan="6" style="text-align: center;">
        		<button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        	</td>
		<tr>
 	</tbody>
 </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form','jquery','moneyType'], function(){
        var form = bt.form(),$  = bt.jquery;
        bt.moneyType.init();

        var relateCon=$("#relateCon").val();
        if (relateCon == "1") {
            $(".conType").removeAttr("disabled", false);
        } else {
            $(".conType").attr("disabled", true);
        }
        form.render();
        //监听提交
        form.on('submit(configSubmit)', function(data){
            bt.loading.show();
            var con_segment1 = data.field["inl.con_segment"][0];
            var con_segment2 = data.field["inl.con_segment"][1];
            if (isNotEmpty(con_segment1)) {
                data.field["inl.con_segment"] = con_segment1;
            }
            if (isNotEmpty(con_segment2)) {
                data.field["inl.con_segment"] += "," + con_segment2;
            }
            $.post(basePath + "/sys/config/save",data.field,function(result){
                bt.loading.hide();
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },"JSON");
            return false;
        });

        form.on('radio(relateCon)', function(data){
            if (data.value == "1") {
                $(".conType").removeAttr("disabled", false);
            } else {
                $(".conType").attr("disabled", true);
            }
            form.render();
        });
    });

    /**
     * 为空判断
     * @param stringData
     * @returns {boolean}
     */
    function isEmpty(stringData) {
        if (null == stringData || stringData == "" || stringData == undefined || stringData == " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param stringData
     * @returns {boolean}
     */
    function isNotEmpty(stringData) {
        return !isEmpty(stringData)
    }
</script>
</body>
</html>
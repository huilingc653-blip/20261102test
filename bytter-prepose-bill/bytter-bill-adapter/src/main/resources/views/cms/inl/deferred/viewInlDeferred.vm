<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }

        .noneElem {
            display: none;
        }

        .input-bp input {
            border: none;
            width: 192px;
        }
        .input-bp span {
            position: absolute;
            right: 4px;
            top: 1px;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        #parse("views/cms/inl/send/sendCommonInfo.vm")

        ##############################内部资金拆借展期申请信息######################################################################

        <tr>
            ##            内部资金拆借展期申请信息
            <td colspan="4" style="font-weight: bolder;text-align: center" class="textLeft">#springMessage('cms.inl.info.deferredInfo')
                <input type="hidden" name="corpId" value="$!{inlInfo.borrowInCorp}">
                <input type="hidden" name="inlInfoId" value="$!{inlInfo.id}">
                <input type="hidden" name="inlSendId" value="$!{inlSend.id}">
            </td>
        </tr>

        <tr>
            ##            上次展期到期日期
            <td class="textRight">#springMessage('table.lastTime.deferredRepayDate')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{cmsInlDeferred.lastDeferredDate})
                </div>
            </td>
            ##            展期次数
            <td class="textRight">#springMessage('table.cmsLoanSend.deferredNum')</td>
            <td>
                <div class="layui-inline">
                    $!{deferredCount}
                </div>
            </td>
        </tr>

        <tr>
            ##            展期到期日期
            <td class="textRight">#springMessage('table.cmsLoanSend.deferredReplayDate')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{cmsInlDeferred.nowDeferredDate})
                </div>
            </td>
            ##            展期期限
            <td class="textRight">#springMessage('table.cmsPrecativeLoanDeferred.deferredLimt')</td>
            <td>
                <div class="layui-inline">
                    #if($!{cmsInlDeferred.term})
                        $!{cmsInlDeferred.term}$!dictTag.get('PrecativeLoanInfo.ternUnit',$!{cmsInlDeferred.unit})
                    #end
                </div>
            </td>
        </tr>

        <tr>
            ##            展期利率
            <td class="textRight">#springMessage('cms.inl.info.deferredRate')</td>
            <td>
                <div class="layui-inline">
                    #if($!{cmsInlDeferred.deferredRate})
                        $!number.formatNumeric($!math.mul($!{cmsInlDeferred.deferredRate},100),'#,##0.0000')%
                    #end
                </div>
            </td>
            <td class="textRight"></td>
            <td>
                <div class="layui-inline">
                </div>
            </td>
        </tr>
        <tr>
            ##            备注
            <td class="textRight">#springMessage('table.cmsLoanInfo.rmk')</td>
            <td colspan="3">
                $!{cmsInlDeferred.rmk}
            </td>
        </tr>
        <tr>
            ##            附件
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" name="attachmentId" id="deferredAttachmentId">
                <div id="deferredUploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
    </table>
</form>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<script>
    var form, moneyType, dateType, dicts, rateType;
    bt.use(["jquery", "form", "btUpload", "moneyType", "dateType", "dicts", "rateType"], function () {
        $ = bt.jquery;
        form = bt.form();
        moneyType = bt.moneyType.init();
        dateType = bt.dateType.init();
        rateType = bt.rateType.init();
        dicts = bt.dicts.init();
        var gid = $("#sendAttachmentId").val();
        var deferredAttachmentId = $("#deferredAttachmentId").val();
        var up = bt.btUpload.init({
            elem: "#sendUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });

        var sendUpload = bt.btUpload.init({
            elem: "#deferredUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: deferredAttachmentId
        });

    });


    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }




    /**
     * 为空判断
     * @param value
     * @returns {boolean}
     */
    function isEmpty(value) {
        if (value == null || value == "" || value == undefined || value == " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param value
     * @returns {boolean}
     */
    function isNotEmpty(value) {
        return !isEmpty(value);
    }
</script>
</body>
</html>

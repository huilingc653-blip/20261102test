<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }

        .noneElem {
            display: none;
        }

        .input-bp input {
            border: none;
            width: 192px;
        }
        .input-bp span {
            position: absolute;
            right: 4px;
            top: 1px;
        }
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        #parse("views/cms/inl/send/sendCommonInfo.vm")
    </table>

    <table class="layui-table">
        ##############################内部资金拆借利率调整信息######################################################################
        <tr>
            ##            内部资金拆借利率调整信息
            <td colspan="4" style="font-weight: bolder;text-align: center" class="textLeft">#springMessage('cms.inl.info.repayPlan')
                <input type="hidden" name="id" value="$!{inlChange.id}">
            </td>
        </tr>
        <tr>
            ##            还款开始日期
            <td class="textRight">#springMessage('cms.inl.info.repayStartDate')</td>
            <td>
                <div class="layui-inline">
                    $!date.format('yyyy-MM-dd',$!{inlChange.repayStartDate})
                </div>
            </td>
            ##            更改还款方式
            <td class="textRight">#springMessage('cms.RepaymentSchedule.repayTypeMsg')</td>
            <td>
                <div class="layui-inline">
                    $!{inlChange.repayTypeName}
                </div>
            </td>
            ##            还款周期
##            <td class="textRight">#springMessage('cms.inl.info.repayCycle')</td>
##            <td>
##                <div class="layui-inline">
##                    $!dictTag.get('Repayment.cycle',$!{inlChange.repayCycel})
##                </div>
##            </td>
        </tr>
        <tr>
            ##            备注
            <td colspan="6">
                <table class="layui-table">
                    <thead>
                    <tr>
                        <th>#springMessage('table.createRepayPlan.prediceRepayDate')</th> ##预计还款日
                        <th>#springMessage('table.createRepayPlan.repaymentMoney')</th>	##还款本金
                        <th>#springMessage('table.createRepayPlan.repaymentIst')</th> ##还款利息
                        <th>#springMessage('table.createRepayPlan.currentRepayMoney')</th>	##本期还款金额
                        <th>#springMessage('table.createRepayPlan.surplusMoney')</th> ##剩余本金
                        <th>#springMessage('table.createRepayPlan.isRepay')</th>	##是否已还
                    </tr>
                    </thead>
                    #set($repaymentMoneyTotal = 0)
                    #set($repaymentIstTotal = 0)
                    #set($currentRepayMoneyTotal = 0)
                    #foreach($item in $!{repayPlans})
                        #set($repaymentMoneyTotal = $repaymentMoneyTotal + $!{item.repaymentMoney})
                        #set($repaymentIstTotal = $repaymentIstTotal + $!{item.repaymentIst})
                        #set($currentRepayMoneyTotal = $currentRepayMoneyTotal + $!{item.currentRepayMoney})
                        #set($count = $velocityCount - 1)
                        <tr data-num="$count">
                            <td style="text-align: center">
                                $!date.format('yyyy-MM-dd',$!{item.prediceRepayDate})
                            </td>
                            <td style="text-align: right">
                                $!number.formatNumeric($!{item.repaymentMoney})
                            </td>
                            <td style="text-align: right">
                                $!number.formatNumeric($!{item.repaymentIst})
                            </td>
                            <td style="text-align: right">
                                $!number.formatNumeric($!{item.currentRepayMoney})
                            </td>
                            <td style="text-align: right">
                                $!number.formatNumeric($!{item.surplusMoney})
                            </td>
                            <td name="isRepay">
                                $dictTag.get("sf_yn",$!{item.isRepay})
                            </td>
                        </tr>
                    #end
                </table>
            </td>
        </tr>
        <tr>
            ##            备注
            <td class="textRight">#springMessage('table.cmsLoanInfo.rmk')</td>
            <td colspan="5">
                $!{inlChange.rmk}
            </td>
        </tr>
        <tr>
            ##            附件
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="5">
                <input type="hidden" name="attachmentId" id="changeAttachmentId" value="$!{inlChange.attachmentId}">
                <div id="changeUploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
    </table>
</form>
<script>
    var form, moneyType, dateType, dicts, rateType;
    bt.use(["jquery", "form", "btUpload", "dateType", "dicts","moneyType"], function () {
        $ = bt.jquery;
        form = bt.form();
        dateType = bt.dateType.init();
        dicts = bt.dicts.init();
        moneyType = bt.moneyType.init();
        var gid = $("#sendAttachmentId").val();
        var changeAttachmentId = $("#changeAttachmentId").val();
        var up = bt.btUpload.init({
            elem: "#sendUploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            auto: false,
            gid: gid
        });

        var changeUpload = bt.btUpload.init({
            elem: "#changeUploader",
            isExpand: true,
            auto: false,
            gid: changeAttachmentId
        });

        // 资金计划挂接
        // renderBudget()

        form.on("submit(submit)", function (data) {
            var action = "/inl/change/save";
            bt.loading.show();
            data.field.status = 11;
            data.field.attachmentId = changeUpload.getGroupId();
            jQuery.ajaxSettings.traditional = true;
            $.post(basePath + action, data.field, function (data) {
                parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                if (data.success) {
                    if (!bt.navtab) {
                        bt.navtab.refreshParentTable();
                    } else {
                        bt.navtab.closeCurrent();
                    }
                } else {
                    bt.loading.hide();
                }
            }, 'JSON');
            return false;
        });
    });


    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }


    /**
     * 开始日期/到期日期回调
     * 计算拆借期限
     */
    function calTerm() {
        var sendEndDate = $("#infoEndDate").val();
        var endDate = dateType.get("nowDeferredDate").val();
        var unit = dicts.get("unit").val();
        if (isNotEmpty(sendEndDate) && isNotEmpty(endDate)) {
            if ("D" == unit) {
                $("#term").val(bt.date.getBetweenDay(sendEndDate, endDate));
            } else {
                $("#term").val(bt.date.getBetweenMonth(sendEndDate, endDate));
            }
        }
    }

    /**
     * 为空判断
     * @param value
     * @returns {boolean}
     */
    function isEmpty(value) {
        if (value == null || value == "" || value == undefined || value == " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param value
     * @returns {boolean}
     */
    function isNotEmpty(value) {
        return !isEmpty(value);
    }
</script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            ##            内部拆借编号
            <td width="10%" class="textRight">#springMessage('cms.inl.info.billNo')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_billNo" class="layui-input">
                </div>
            </td>
            ##            拆入单位
            <td width="10%" class="textRight">#springMessage('cms.inl.info.borrowInCorp')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-biz-name="borrowInCorp" data-name="eqs_borrowInCorp" data-biz-name="borrowInCorp"
                         data-resource="cms:inl:send:query"
                         data-biz-type="corp" data-type="selectTree"></div>
                </div>
            </td>
            ##            拆出单位
            <td width="10%" class="textRight">#springMessage('cms.inl.info.borrowOutCorp')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-biz-name="borrowOutCorp" data-name="eqs_borrowOutCorp" data-biz-name="borrowInCorp"
                         data-resource="cms:inl:send:query"
                         data-biz-type="corp" data-type="selectTree"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##            放款日期
            <td width="10%" class="textRight">#springMessage('cms.report.sendDate')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="ged_sendDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                    #springMessage('table.relationBank.dateRange')
                    <input type="text" name="led_sendDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                </div>
            </td>
            ##            到期日期
            <td width="10%" class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="ged_endDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                    #springMessage('table.relationBank.dateRange')
                    <input type="text" name="led_endDate" class="layui-input bt-biz-dateType" style="width: 28%;display: inline-block">
                </div>
            </td>
            ##            币种
            <td width="10%" class="textRight">#springMessage('table.bisAccDtl.curName')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_curId" data-biz-name="curId" data-inputValue="false"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##            放款编号
            <td width="10%" class="textRight">#springMessage('cms.inl.info.sendCode')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_sendCode" class="layui-input">
                </div>
            </td>
            ##            还款方式
            <td width="10%" class="textRight">#springMessage('table.cmsProvideLoanSend.repayType')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_repayType" data-biz-name="repayType"
                         data-url="$basePath/cms/repay/repaytype/queryNoNRepayTypeList"
                         data-valuefield="id" data-textfield="repayName"></div>
                </div>
            </td>
            ##            状态
            <td width="10%" class="textRight">#springMessage('cms.inl.info.sendStatus')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select"
                         data-group="inl.send.sendConfirm" data-name="eqi_status" data-biz-name="status"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
        <th>#springMessage('cms.inl.info.billNo')</th>#*内部拆借编号*#
        <th>#springMessage('cms.inl.info.sendCode')</th>#*拆入单位*#
        <th>#springMessage('cms.inl.info.borrowInCorp')</th>#*拆出单位*#
        <th>#springMessage('cms.inl.info.borrowOutCorp')</th>#*拆借日期*#
        <th>#springMessage('cms.report.sendDate')</th>#*放款日期*#
        <th>#springMessage('table.cmsProvideLoanSend.repayDate')</th>#*拆借期限*#
        <th>#springMessage('cms.inl.info.term')</th>#*币种*#
        <th>#springMessage('table.bisAccDtl.curName')</th>#*拆借金额*#
        <th>#springMessage('cms.report.sendMoney')</th>#*资金拆借利率*#
        <th>#springMessage('cms.inl.info.rate')</th>#*拆借利息*#
        <th>#springMessage('cms.inl.info.interest')</th>#*用途*#
        <th>#springMessage('table.cmsProvideLoanSend.repayType')</th>#*还款方式*#
        <th>#springMessage('common.table.status')</th>#*状态*#
        <th>#springMessage('common.table.thead.operation')</th>#*操作*#
    </tr>
    </thead>
</table>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<script>
    var form, moneyFun, dicts, datatable,dateType;
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts", "corp","dateType"], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        bt.selectType.init();
        dateType = bt.dateType.init();//日期时间
        bt.moneyType.init();
        corp = bt.corp.init();//单位
        moneyFun = bt.moneyType.getFun();
        datatable = bt.datatable.initMultiTables({
            elem: "#appTable",
            dom: "Brtlip",
            colReorder: true,
            ordering: false,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                "url": basePath + "/inl/send/listSendConfirmDataTable"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ]
            , columns: [
                {
                    data: "infoBillNo",
                    className: "center"
                }, {
                    data: "sendCode",
                    className: "center"
                }, {
                    data: "borrowInCorpName",
                    className: "center"
                }, {
                    data: "borrowOutCorpName",
                    className: "center"
                }, {
                    data: "sendDate",
                    className: "center"
                }, {
                    data: "endDate",
                    className: "center"
                }, {
                    data: "term",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return data + bt.dict("PrecativeLoanInfo.ternUnit", full.unit);
                    }
                }, {
                    data: "curName",
                    className: "textRight"
                }, {
                    data: "sendMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                }, {
                    data: "rate",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data * 100, {decimal: 4}) + "%";
                    }
                }, {
                    data: "interest",
                    className: "textRight"
                }, {
                    data: "repayTypeName",
                    className: "center"
                }, {
                    data: "status",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("inl.send.sendConfirm", data);
                    }
                }, {
                    data: null,
                    className: 'center',
                    render: function (data, type, full, meta) {
                        var html = "";
                        var split = "<span class=\"text-explode\">|</span>"
                        if (full.status == 95) {
                            if (bt.isResource("cms:inl:send:confirm")) {
                                html += "<a href=\"#\" onclick=\"sendConfirm('" + full.curName + "','" + full.sendMoney + "','" + full.id + "','" + full.sendDate + "')\">" + bt.lang("放款确认") + "</a>";
                            }
                        }
                        if (bt.isResource("cms:inl:send:view")) {
                            if (html != "" && html != null && html != undefined && html != " ") {
                                html += split;
                            }
                            html += "<a href=\"#\" onclick=\"view('" + full.inlInfoId + "')\">" + bt.lang("common.button.view") + "</a>";
                        }
                        return html;
                    }
                }
            ]
        });
        //这里填写新的js代码，请参考前端文档
    });

    /**
     * 确认发放方法
     * @param curName
     * @param sendMoney
     * @param id
     */
    function sendConfirm(curName, sendMoney, id,sendDate) {
        $("#ConfirmCurName").html(curName);
        $("#ConfirmMoney").html(moneyFun.format(sendMoney));
        dateType.get("realSendDate").attr("data-min", sendDate);
        dateType.render();
        layer.open({
            type: 1,
            area: ['40%', '30%'],
            btn: ['确定', '关闭'],
            btnAlign: 'c',
            yes: function (index, layero) {
                var realSendDate = dateType.get("realSendDate").val();
                if (isEmpty(realSendDate)) {
                    parent.layer.alert("请填写实际放款日期", {icon: 2});
                    return;
                }
                $.ajax({
                    url: basePath + "/inl/send/sendConfirm",
                    type: "post",
                    data: {
                        id: id,
                        realSendDate: realSendDate
                    },
                    dataType: "json",
                    success: function (data) {
                        if (data.success) {
                            datatable && datatable.draw();
                        } else {
                            parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                        }
                        layer.close(index);
                    }
                });
            },
            btn2: function (index, layero) {
                dateType.get("realSendDate").val("");
                layer.close(index);
            },
            content: $("#sendConfirm") //这里content是一个DOM，注意：最好该元素要存放在body最外层，否则可能被其它的相对元素所影响
        });
    }

    /**
     * 查看操作
     * @param id
     */
    function view(id) {
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/inl/send/viewAllInlSend?id=" + id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/inl/info/viewAllInlSend?id=" + id,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }

    /**
     * 为空判断
     * @param value
     * @returns {boolean}
     */
    function isEmpty(value) {
        if (value == null || value == "" || value == undefined || value == " ") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param value
     * @returns {boolean}
     */
    function isNotEmpty(value) {
        return !isEmpty(value);
    }
</script>
<div id="sendConfirm" style="display: none">
    <table class="layui-table">
        <tr>
            <td class="textRight" style="width: 30%">
                #springMessage('cms.inl.info.realSendDate')
            </td>
            <td>
                <input type="text" class="layui-input bt-biz-dateType"
                       data-biz-name="realSendDate" name="realSendDate">
            </td>
        </tr>
        <tr>
            <td class="textRight">
                #springMessage('cms.inl.info.sendCurId')
            </td>
            <td id="ConfirmCurName">

            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('cms.report.sendMoney')</td>
            <td id="ConfirmMoney">

            </td>
        </tr>
    </table>
</div>
</body>
</html>

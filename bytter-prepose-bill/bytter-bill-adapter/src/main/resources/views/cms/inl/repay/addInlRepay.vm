<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
        .inCenter{
            text-align: center!important;
        }
        .addRow {
            cursor: pointer;
            color: rgb(0, 0, 204);
        }

        .noneElem {
            display: none;
        }

        .input-bp input {
            border: none;
            width: 192px;
        }
        .input-bp span {
            position: absolute;
            right: 4px;
            top: 1px;
        }
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        #parse("views/cms/inl/send/sendCommonInfo.vm")

        ##############################内部资金拆借还款申请信息######################################################################

        <tr>
            ##            内部资金拆借还款申请信息
            <td colspan="4" style="font-weight: bolder;text-align: center" class="textLeft">#springMessage('cms.inl.info.repayApp')
                <input type="hidden" name="borrowInCorp" id="borrowInCorp" value="$!{inlInfo.borrowInCorp}">
                <input type="hidden" name="borrowOutCorp" id="borrowOutCorp" value="$!{inlInfo.borrowOutCorp}">
                <input type="hidden" name="inlInfoId" value="$!{inlInfo.id}">
                <input type="hidden" name="inlSendId" id="inlSendId" value="$!{inlSend.id}">
                <input type="hidden" name="inlSendBillNo" id="inlSendBillNo" value="$!{inlSend.billNo}">
                <input type="hidden" name="curId" id="curId" value="$!{inlSend.curId}">
                <input type="hidden" name="inlRepayplanId" id="inlRepayplanId" value="">
                <input type="hidden" name="inlInterestId" id="inlInterestId" value="">
            </td>
        </tr>
        <tr>
            ##            还款金额
            <td class="textRight">#springMessage('table.cmsProvideLoanRepay.repayMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-moneyType" data-name="totalMoney" data-biz-name="totalMoney"
                           lay-verify="required" data-toUp="upper" >
                </div>
                <div class="layui-inline" style="vertical-align: baseline;">
##                    明细
                    <button type="button" class="layui-btn" onclick="selectRepay()">#springMessage('cms.button.detail')</button>
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            ##            还款本金
            <td class="textRight">#springMessage('table.createRepayPlan.repaymentMoney')</td>
            <td>
                <div class="layui-inline">
                    <div id="repayMoneyShow"></div>
                    <input type="hidden" class="layui-input bt-biz-moneyType" data-name="repayMoney" data-biz-name="repayMoney">
                </div>
            </td>
            ##            还款利息
            <td class="textRight">#springMessage('table.cmsProvideLoanRepay.repayAccrual')</td>
            <td>
                <div class="layui-inline">
                    <div id="repayInterestShow"></div>
                    <input type="hidden" class="layui-input bt-biz-moneyType" data-name="repayInterest" data-biz-name="repayInterest">
                </div>
            </td>
        </tr>
        <tr>
            ##            还款日期
            <td class="textRight">#springMessage('table.cmsProvideLoanRepay.repayDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType"
                           data-biz-name="repayDate"
                           id="repayDate" lay-verify="required" name="repayDate">
                </div>
            </td>
            ##            还款金额大写
            <td class="textRight">#springMessage('table.cmsProvideLoanRepay.repayMoney')#springMessage('table.bisAccDtl.moneyUpper')</td>
            <td>
                <div class="layui-inline">
                    <div id="upper"></div>
                </div>
            </td>
        </tr>

        <tr>
            ##            拆入方还款账户
            <td class="textRight">#springMessage('cms.inl.info.borrowInRepayMoneyAcc')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="borrowInAcc" id="borrowInAcc" readonly="readonly">
                    <div class="bt-div-search">
                        <button data-acc="borrowInAcc" type="button" onclick="selectAcc(this)">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                    <input type="hidden" class="layui-input" name="borrowInAccId" id="borrowInAccId">
                </div>
            </td>
##            拆出方收款账户
            <td class="textRight">#springMessage('cms.inl.info.borrowOutReceiveMoneyAcc')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="borrowOutAcc" id="borrowOutAcc" readonly="readonly">
                    <div class="bt-div-search">
                        <button data-acc="borrowOutAcc" type="button" onclick="selectAcc(this)">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                    <input type="hidden" class="layui-input" name="borrowOutAccId" id="borrowOutAccId">
                </div>
            </td>
        </tr>
        <tr>
            ##            备注
            <td class="textRight">#springMessage('table.cmsLoanInfo.rmk')</td>
            <td colspan="3">
                <textarea name="rmk" class="layui-textarea"></textarea>
            </td>
        </tr>
        <tr>
            ##            附件
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <input type="hidden" name="attachmentId" id="repayAttachmentId">
                <div id="repayUploader" class="layui-input-inline" style="width:100%;"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <!--预算-->
                ##    资金计划挂接参数
                <input type="hidden" name="isBudget" id="isBudget" value="$!{config.inl.is_budget}">
                <input id="inlRepayItem" name="inlRepayItem" type="hidden" value="$!{config.inl.repay_budget}">
                <input id="defItemCode" name="defItemCode" type="hidden" value="$!{config.inl.repay_budget}">
                <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
                <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
                <div id="tagItemDetail"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" type="button" lay-submit="submit" value="11" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" type="button" lay-submit="submit" value="0" lay-filter="submit">#springMessage('common.button.temp')</button>
                <button class="layui-btn" type="button" onclick="doClose()">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
<script src="${basePath}/static/modules/cms/inl/addInlReplay.js?_btv=${resourceVersion}"></script>
</body>
</html>

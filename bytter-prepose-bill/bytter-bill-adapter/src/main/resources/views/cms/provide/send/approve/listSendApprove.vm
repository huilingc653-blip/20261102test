<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
	<table class="layui-table">
		<tbody>
		   	<tr>
		   		<!-- ##单位代码
				<td class="textRight" width="25%">#springMessage('table.cmsProvideLoanInfo.corpId')</td>
		   		<td width="25%">
		   			<div class="layui-inline">
		   				<div class="bt-biz-corp" data-type="selectTree" data-name="eqs_corpId" data-scope="all"></div>
		   			</div>
		   		</td> -->
		   		##借款单号
		   		<td class="textLeft" width="25%">#springMessage('table.cmsProvideLoanInfo.billCode')</td>
		   		<td class="textLeft" width="25%">
					<input name="likes_loanCode" class="layui-input" placeholder="#springMessage('table.cmsProvideLoanInfo.billCode')">
		   			<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
					<input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
		   		</td>
		   	</tr>
		   	<tr>
		   		<td colspan="2" style="text-align: center;">
		   			<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
		           	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		   		</td>
		   	</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
    	<th>#springMessage('table.cmsProvideLoanInfo.corpId')</th><!-- 单位 -->
        <th>#springMessage('table.cmsProvideLoanSend.billCode')</th><!-- 发放单号 -->
        <th>#springMessage('table.cmsProvideLoanInfo.billCode')</th><!-- 借款单号 -->
        <th>#springMessage('table.cmsProvideLoanInfo.bankId')</th><!-- 借款银行名称 -->
        <!-- <th>#springMessage('table.cmsProvideLoanInfo.createDate')</th> --><!-- 录入日期 -->
        <th>#springMessage('table.cmsProvideLoanInfo.curId')</th><!-- 币别 -->
        <th>#springMessage('table.cmsProvideLoanSend.contractSumMoney')</th><!-- 合同总金额 -->
        <th>#springMessage('table.cmsProvideLoanSend.loanSendOutType')</th><!-- 放款方式 -->
        <th>#springMessage('table.cmsProvideLoanSend.contractCode')</th><!-- 发放合同 -->
        <th>#springMessage('table.cmsProvideLoanSend.money')</th><!-- 发放金额 -->
        <th>#springMessage('table.cmsProvideLoanSend.repayType')</th><!-- 还款方式 -->
        <th>#springMessage('table.cmsProvideLoanInfo.plTerm')</th><!-- 期限 -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#workFlowHtml()
#parse("views/common/footer.vm")
#workFlowScript()
<script src="${basePath}/static/modules/cms/provide/approve/sendApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

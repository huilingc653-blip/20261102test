<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input id="tempOrSubmitSign" name="tempOrSubmitSign" value="1" type="hidden">
<form id="searchForm" class="layui-form" method="post">
	<table class="layui-table">
		<tbody>
		   	<tr>
		   		##单位代码
				<td class="textRight" width="25%">#springMessage('table.cmsProvideLoanInfo.corpId')</td>
		   		<td width="25%">
		   			<div class="layui-inline">
		   				<div class="bt-biz-corp" data-type="selectTree" data-name="eqs_corpId" data-resource="cms:provide:repqy:query" data-scope="all"></div>
		   			</div>
		   		</td>
		   		##借款单号
		   		<td class="textRight" width="25%">#springMessage('table.cmsProvideLoanRepay.billCode')</td>
		   		<td width="25%">
					<input name="likes_billCode" class="layui-input" placeholder="#springMessage('table.cmsProvideLoanRepay.billCode')">
		   		</td>
		   	</tr>
		   	<tr>
##		   	#if($shiro.hasPermission("cms:provide:repqy:query"))
		   		<td colspan="4" style="text-align: center;">
		   			<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
		           	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		   		</td>
##		   	#end
		   	</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
    	<th>#springMessage('table.cmsProvideLoanInfo.corpId')</th><!-- 申请单位 -->
    	<th>#springMessage('table.cmsProvideLoanRepay.billCode')</th><!-- 还款单号 -->
    	<th>#springMessage('table.fcAccbook.enrolTime')</th><!-- 录入日期 -->
    	<th>#springMessage('table.cmsProvideLoanInfo.billCode')</th><!-- 借款单号 -->
        <th>#springMessage('table.cmsProvideLoanSend.billCode')</th><!-- 发放单号 -->
        <th>#springMessage('table.cmsProvideLoanInfo.curId')</th><!-- 币别-->
        <th>#springMessage('table.cmsProvideLoanRepay.repayMoney')</th><!-- 还款金额 -->
        <th>#springMessage('table.cmsProvideLoanRepay.repayDate')</th><!-- 发放金额 -->
        <th>#springMessage('table.cmsProvideLoanRepay.onlineSign')</th><!-- 还款模式-->
		<th>#springMessage('table.cmsProvideLoanRepay.isAdvancedRepay')</th><!-- 是否提前还款-->
        <th>#springMessage('table.cmsProvideLoanRepay.status')</th><!-- 状态 -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
	var upRepSing = "$!{upRepSing}";
	var dataUrl;
	if(upRepSing == "1"){//修改
		dataUrl = basePath+"/cms/provide/loanrepay/dataUpdateTable"
	}else{//补录
		dataUrl = basePath+"/cms/provide/loanrepay/dataRepairTable";
	}
</script>
<script src="${basePath}/static/modules/cms/provide/repayUpOrRep.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
<!-- 借款展期补录公用显示数据页面 -->
	##录入日期
	<div align="center">
		<div class="layui-inline"">
			<span>#springMessage('table.fcAccbook.enrolTime')</span>
		</div>
		<div class="layui-input-inline">
			<input type="text" class="layui-input" value="$!date.format('yyyy-MM-dd',$!provideLoanDeferred.createDate)" readonly="readonly">
		</div>
	</div>
	<table class="layui-table">
	<tbody>
		 <tr>
			 ##申请单位
			 <td class="textRight" width="14%">#springMessage('table.abBillTransfer.applyCorp')</td>
			 <td  width="36%">
			 	<input type="hidden" value="$!{deferredvo.corpId}" name="corpId" /> 
				$!{deferredvo.corpName}
			 </td> 
			 
			 ##付息方式
			 <td class="textRight" width="14%">#springMessage('table.cmsProvideLoanInfo.cplInterestPayment')</td>
			 <td  width="36%">
				<DIV class=layui-form>
					<DIV class=bt-biz-dict data-name="ss" data-type="select" data-defaultvalue="01" data-group="provide.payInterest" data-disabled="true"></DIV>
				</DIV>
			 </td>
	    </tr>
			    
		<tr>
			##借款银行
			<td class="textRight">#springMessage('table.cmsProvideLoanInfo.bankId')</td>
			<td>$!{deferredvo.bankName}</td> 
			
			##借款类别
			<td class="textRight">#springMessage('cms.provide.deferred.loanType')</td>
			<td>$!{deferredvo.plClass}</td>
		</tr>

		<tr>
			##借款编号
			<td class="textRight">#springMessage('cms.provide.deferred.loanNo')</td>
			<td>$!{deferredvo.billCode}</td>
			
			 ##借款合同编号
			<td class="textRight">#springMessage('table.cmsProvideLoanSend.contractCode')</td>
			<td>$!{deferredvo.contractCode}</td>
		</tr>

		<tr>
			##借款帐号
			<td class="textRight">#springMessage('table.ePrecativeLoanBill.loanAcc')</td>
			<td>
				<input type="hidden" name="loanAcc" value="$!{deferredvo.loanAcc}"> 
				$!{deferredvo.loanAcc}
			</td>

			##借款银行帐号
			<td class="textRight">#springMessage('table.cmsProvideLoanInfo.plAccount')</td>
			<td>$!{deferredvo.plAccount}</td>
		</tr>

		<tr>
			##借款币种
			<td class="textRight">#springMessage('table.cmsProvideLoanSend.curCode')</td>
			<td>$!{deferredvo.curName}</td> 
			
			##借款金额
			<td class="textRight">#springMessage('table.cmsProvideLoanInfo.plMoney')</td>
			<td>$number.formatNumeric($!{deferredvo.plMoney})</td>
		</tr>
		
		<tr>

			##发放编号
			<td class="textRight">#springMessage('table.cmsLoanSend.provideCode')</td>
			<td>
				<input type="hidden" name="liCode" value="$!{deferredvo.provideCode}">
				$!{deferredvo.provideCode}
			</td> 
			
			##发放金额
			<td class="textRight">#springMessage('table.cmsProvideLoanSend.money')</td>
			<td>$number.formatNumeric($!{deferredvo.money})</td>

		</tr>

	<!--	<tr>
			## 中间业务费计收  后期做
			##<td class="textRight">#springMessage('table.cmsProvideDeferred.interbusexpenses')</td>
			  <td>
				<div class="layui-inline">
					<input type="text" id="" name="interbusexpenses"autocomplete="off" class="layui-input" placeholder="中间业务费计收">
				</div>
				<div class="layui-inline">
					<input type="button" name="" id="" value="登记">
				</div>
			</td>
			<td colspan="2"></td>
		</tr>-->

		<tr>
			##发放日期
			<td class="textRight">#springMessage('table.cmsProvideLoanSend.sendDate')</td>
			<td>$!{deferredvo.sendDate}</td> 
			
			##借款到期日期
			<td class="textRight">#springMessage('cms.provide.deferred.repayDate')</td>
			<td>
				<div>$!date.format('yyyy-MM-dd',$!deferredvo.repayDate)</div>
				<input type="hidden" id="repayData" name="matureDate" value="$!date.format('yyyy-MM-dd',$!deferredvo.repayDate)"/>
			</td>
		</tr>

		<tr>
			##还款在途金额
			<td class="textRight">#springMessage('table.cmsProvideLoanRepay.repayPassage')</td>
			<td>
			$number.formatNumeric($!{money.passageMoney})
			</td> 
			
			##已还金额
			<td class="textRight">#springMessage('table.cmsLoanRepay.processMoney')</td>
			<td>
				$number.formatNumeric($!{deferredvo.repayMoney})
			</td>
		</tr>
		</tbody>
	</table>
	<div style="width: 100%;text-align: center;">
		<button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>	
	</div>
#parse("views/common/footer.vm")
</body>
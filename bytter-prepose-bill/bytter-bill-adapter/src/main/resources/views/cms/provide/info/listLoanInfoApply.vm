<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位代码
            <td class="textRight" width="25%">#springMessage('table.cmsProvideLoanInfo.corpId')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-resource="cms:loaninfo:apply:edit"
                         data-scope="all">
                    </div>
                </div>
            </td>
            ##借款单号
            <td class="textRight" width="25%">#springMessage('table.cmsProvideLoanInfo.billCode')</td>
            <td width="25%">
                <input name="likes_billCode" class="layui-input" type="text">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsProvideLoanInfo.corpId')</th>
        <th>#springMessage('table.cmsProvideLoanInfo.billCode')</th>
        <th>#springMessage('table.cmsProvideLoanInfo.createDate')</th>
        <th>#springMessage('table.cmsProvideLoanInfo.bankId')</th>
        <th>#springMessage('table.cmsProvideLoanInfo.curId')</th>
        <th>#springMessage('table.cmsProvideLoanInfo.plMoney')</th>
        <th>#springMessage('table.cmsProvideLoanInfo.plDate')</th>
        <th>#springMessage('cms.provide.deferred.repayDate')</th>
        <th>#springMessage('table.cmsProvideLoanInfo.repayType')</th>
        <th>#springMessage('table.cmsProvideLoanInfo.contractTerm')</th>
        <th>#springMessage('table.cmsProvideLoanInfo.plTerm')</th>
        <th>#springMessage('table.cmsProvideLoanInfo.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
    #workFlowScript()
<script src="${basePath}/static/modules/cms/provide/listLoanInfoApply.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

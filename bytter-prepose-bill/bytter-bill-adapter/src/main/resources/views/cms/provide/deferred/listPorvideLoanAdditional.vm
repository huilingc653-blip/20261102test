<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
<!-- 展期补录 -->
	<form action="" id="searchForm" class=layui-form>
		<table class="layui-table ">
			<tbody>
			<input type="hidden" id="pageType" value="$!{pageType}">
			<tr>
				<td width="20%" class="textRight">
					##所有单位
					#springMessage('cms.provide.deferred.allCorp'):
				</td>

				<td width="20%">
					<div class="layui-input-inline">
						<div class="bt-biz-corp" data-biz-type="corp" data-type="selectTree" data-resource="cms:provide:deferred:addit:query" data-name="eqs_corpId" data-scope="all"></div>
					</div>
				</td>

				<td width="20%" class="textRight">
					##借款展期单号
					#springMessage('table.cmsLoanDeferred.billCode')
				</td>

				<td width="20%">
					<input type="text" class="layui-input" name="likes_deferredCode" />
				</td>
			</tr>
			<tr>
				<td colspan="4" style="text-align: center;">
##					#if($shiro.hasPermission("cms:provide:deferred:update:query"))
					<button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
##					#end
				</td>
			</tr>
			</tbody>
		</table>
	</form>

	<table id="appTable" class="layui-table layui-form"
		style="width: 100%;">
		<thead>
			<tr>
				<th>#springMessage('table.cmsProvideLoanInfo.corpId')</th>
				<th>#springMessage('table.cmsProvideLoanInfo.billCode')</th>
				<th>#springMessage('table.cmsLoanDeferred.billCode')</th>
				<th>#springMessage('table.fcAccbookHis.enrolTime')</th>
				<th>#springMessage('table.cmsProvideLoanDeferred.liCode')</th>
				<th>#springMessage('table.cmsProvideLoanSend.repayDate')</th>
				<th>#springMessage('table.fcAcc.delayDeadlineDate')</th>
				<th>#springMessage('table.cmsProvideLoanDeferred.deferredLimt')</th>
				<th>#springMessage('table.fcBankBalanceAdjust.status')</th>
				<th>#springMessage('common.table.thead.operation')</th>
			</tr>
		</thead>
	</table>
	#parse("views/common/footer.vm")
</body>

<script
	src="${basePath}/static/modules/cms/provide/porvideLoanAdditional.list.js?_btv=${resourceVersion}"></script>
</html>

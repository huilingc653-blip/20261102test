<!DOCTYPE html>
<html lang="en" style="height: 100%">
<head>
    #parse("views/common/head.vm")
</head>
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 12px; 
	text-align: center;
	border-left: 0px;
	border-right: 0px;
	background-color: #d2d2d2;
	
}

</style>  
<body style="height: 100%">
	<div>
		<iframe src="${basePath}/cms/provide/loansend/viewSend/$!{repay.sendCode}" id="sendIframe" frameborder="0" scrolling="no" style="width: 100%;"></iframe>
	</div>
	<form class="layui-form" method="post" id="inputForm">
		<input id="mind" type="hidden" value="$!{mind}">
		<input id="maxd" type="hidden" value="$!{maxd}">
		<input id="repayMaxDate" name="repayMaxDate" type="hidden" value="$!{repayMaxDate}">
		<input id="repayMinDate" name="repayMinDate" type="hidden" value="$!{repayMinDate}">
		<input type="hidden" id="onlineSign" name="onlineSign" value="$!{repay.onlineSign}">
		<input id="id" name="id" type="hidden" value="$!{repay.id}">
		<input id="corpId" name="corpId" type="hidden" value="$!{repay.corpId}">
		<input id="billCode" name="billCode" type="hidden" value="$!{repay.billCode}">
		<input id="sendCode" name="sendCode" type="hidden" value="$!{repay.sendCode}">
		
		<input type="hidden" id="provideInterestId" name="provideInterestId" value="$!{repay.provideInterestId}">
		<input id="createDate" name="createDate" type="hidden" value="$!date.format('yyyy-MM-dd',$!repay.createDate)" >
        <table class="layui-table">
			<tbody>
       		<tr class="dark-table-header">
				<td colspan="4" class="voucher-title">#springMessage('cms.loan.loanRepayInfo')</td>
			</tr>
			<tr>
				##还款日期
				<td class="textRight" width="14%">#springMessage('table.cmsProvideLoanRepay.repayDate')</td>
				<td width="36%">
					<input class="layui-input bt-biz-dateType"
						   id="repayDate" 
						   name="repayDate" 
						   value="$!{repay.repayDate}"
						   data-name="repayDate"
						   data-biz-name="repayDate" 
						   data-type="date" 
						   lay-verify="required" 
						   #if("$!{overdueSign}" != 1) readonly="readonly" #end >
					</input>
				</td>
				##还款金额
				<td class="textRight" width="14%">#springMessage('table.cmsProvideLoanRepay.repayMoney')</td>
				<td width="36%">
					<div class="layui-inline">
						<input class="layui-input bt-biz-moneyType"
							   data-name="repayMoney" 
							   value="$!{repay.repayMoney}" 
							   data-max="$!{sendBalance}" 
							   lay-verify="required" 
							   data-biz-name="repayMoney" 
							   data-callback="countOnlineMoney"
							   #if("$!{overdueSign}" != 1) readonly="readonly" #end 
							   data-decimal="2" 
							   type="text" 
							   placeholder="#springMessage('table.cmsProvideLoanRepay.repayMoney')">
						</input>
					</div>
				</td>
			</tr>
			##线上还款
			<tr>
				##备注
				<td class="textRight">#springMessage('table.cmsProvideLoanRepay.rmk')</td>
				<td>
					<input id="rmk" name="rmk" value="$!{repay.rmk}" data-biz-name="rmk" class="layui-input" lay-verify="required" placeholder="#springMessage('table.cmsProvideLoanRepay.rmk')"/>
				</td>
				##还款利息 
				<td class="textRight">
					#springMessage('table.cmsProvideLoanRepay.repayAccrual')
				</td>
				<td >
					<input class="layui-input bt-biz-moneyType" 
						   data-name="repayAccrual" 
						   value="$!{repay.repayAccrual}" 
						   data-biz-name="repayAccrual" 
						   readonly="true"
						   data-decimal="2"
						   placeholder="#springMessage('table.cmsProvideLoanRepay.repayAccrual')">
				</td>
			</tr>
			<tr>
				##实付利息
				<td class="textRight">#springMessage('table.cmsProvideLoanRepay.onlineInterest')</td>
				<td>
					<div class="layui-inline">
						<input class="layui-input bt-biz-moneyType" 
						   data-name="onlineRealityInterest" 
						   value="$!{repay.onlineRealityInterest}" 
						   data-biz-name="onlineRealityInterest"
						   data-callback="countOnlineMoney"
						   data-decimal="2"
						   lay-verify="required"
						   placeholder="#springMessage('table.cmsProvideLoanRepay.onlineInterest')">
					</div>
					<div class="layui-inline">
						<span style="color: red;">#springMessage('table.cmsProvideLoanRepay.onlineInterestMsg')</span>
					</div>
				</td>
				##金额
				<td class="textRight">
					#springMessage('table.cmsProvideLoanRepay.onlineMoney')
				</td>
				<td>
					<input class="layui-input bt-biz-moneyType" 
						   data-name="onlineMoney" 
						   value="$!{repay.onlineMoney}" 
						   data-biz-name="onlineMoney"
						   data-decimal="2"
						   lay-verify="required"
						   readonly="readonly"
						   placeholder="#springMessage('table.cmsProvideLoanRepay.onlineMoney')">
				</td>
			</tr>
			<tr>
				##收款帐号
				<td class="textRight">#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc')</td>
				<td>
					<div class="layui-input-inline">
		    			<input id="onlinePaymentAcc" name="onlinePaymentAcc" value="$!{repay.onlinePaymentAcc}" class="layui-input" type="text" lay-verify="required" readonly="readonly" placeholder="#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc')" />
		    			<table id="paymentAccTable">
			    			<thead>
				    			<tr>
				    				<th>#springMessage('table.btBankAcc.bankAcc')</th>
				    				<th>#springMessage('table.btBankAcc.accName')</th>
				    				<th>#springMessage('table.btBankAcc.bankName')</th>
				    			</tr>
			    			</thead>
		    			</table>
		    		</div>
		    		<div class="layui-inline" id="accMsg">
						<span style="color: accMsg;"></span>
					</div>
				</td>
				##收款帐号名称
				<td class="textRight">
					#springMessage('table.cmsProvideLoanRepay.onlinePaymentAccName')
				</td>
				<td>
					<input type="hidden" id="onlinePaymentAccId" name="onlinePaymentAccId" value="$!{repay.onlinePaymentAccId}">
					<input id="onlineAccName" name="onlineAccName" value="$!{repay.onlineAccName}" class="layui-input" type="text" readonly="readonly" lay-verify="required" placeholder="#springMessage('table.cmsProvideLoanRepay.onlinePaymentAccName')" />
				</td>
			</tr>
			<tr>
				##收款开户行名称
				<td class="textRight">#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc.bankName')</td>
				<td>
					<input id="onlineBankName" name="onlineBankName" value="$!{repay.onlineBankName}" class="layui-input" type="text" readonly="readonly" lay-verify="required" placeholder="#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc.bankName')" />
				</td>
				##用途
				<td class="textRight">
					#springMessage('table.cmsProvideLoanRepay.onlinePurpose')
				</td>
				<td>
					<div class=layui-inline>
						<div class=bt-biz-selectType 
							data-name="onlinePurpose" 
							data-textField="purpose" 
							data-valueField="purpose" 
							data-biz-name="onlinePurpose"
							data-url="${basePath}/cms/provide/loaninfo/getPurpose?corpId=${repay.corpId}"
							data-defaultvalue="$!{repay.onlinePurpose}"
							data-required="true"
							data-inputvalue="true" 
							data-search="true">
						</div>
					</div>
				</td>
			</tr>
			<tr>
				## 是否提前还款
				<td class="textRight">
					#springMessage('table.cmsProvideLoanRepay.isAdvancedRepay')
				</td>
				<td>
					<div class="layui-input-inline">
						<div class="bt-biz-dict" data-type="radio"
							 id="isAdvancedRepay"
							 data-group="cms.repay.isAdvancedRepay"
							 data-value="$!{repay.isAdvancedRepay}"
							 data-defaultvalue="0"
							 data-required="true"
							 data-callback="isAdvancedRepayCallback"
							 data-name="isAdvancedRepay"
							 data-biz-name="isAdvancedRepay"></div>
					</div>
				</td>
			</tr>
			<input type="hidden" name = "acrossRepair" value="$!{repay.acrossRepair}"/>
			<!-- <tr>
			<td colspan="4">
				<table id="appTable" class="layui-table layui-form" style="width:100%;">

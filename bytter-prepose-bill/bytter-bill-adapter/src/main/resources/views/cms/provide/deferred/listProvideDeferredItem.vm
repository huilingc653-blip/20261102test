<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input type="hidden" id="liCode" value="$!{liCode}">
<table class="layui-table" id="deferredList">
	<thead>
		<tr>
			<td>#springMessage('table.cmsLoanInfo.corp')</td>
			<td>#springMessage('table.cmsLoanDeferred.billCode')</td>
			<td>#springMessage('table.cmsLoanDeferred.liCode')</td>
			<td>#springMessage('table.cmsLoanDeferred.contractCode')</td>
			<td>#springMessage('table.cmsLoanDeferred.matureDate')</td>
			<td>#springMessage('table.cmsLoanDeferred.deferredLimt')</td>
			<td>#springMessage('table.cmsLoanDeferred.deferredRepayDate')</td>
			<td>#springMessage('table.cmsLoanInfo.deferredRate')</td>
			<td>#springMessage('table.cmsLoanDeferred.status')</td>
		</tr>
	</thead>
</table>
	<div style="width: 100%;text-align: center;">
		<button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>	
	</div>
#parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
bt.use(['form','datatable','moneyType','date','bttable'], function(){
    $ = bt.jquery,form = bt.form(),moneyFun=bt.moneyType.getFun();
	bt.bttable.init({
		elem: "#deferredList",
		url: basePath + "/cms/provide/provideloandeferred/deferredInfoItems",
		urldata: {
			liCode: $("#liCode").val()
		},
		mulselect: true,
		scrollX: true,
		columns: [
			{data: "corpName"},
			{data: "billCode"},
			{data: "liCode"},
			{
				data: "contractCode",
				render: function (data, id) {
					return data.contractCode == null ? "" : data.contractCode;

				}
			},
			{data: "matureDate"},
			{
				data: "deferredLimt",
				render: function (data, id) {
					return data.deferredLimt + data.unit;
				}
			},
			{data: "deferredRepayDate"},
			{
				data: "deferredRate",
				render: function (data, id) {
					if(null != data.deferredRate && data.deferredRate != "" && data.deferredRate != undefined ){
						return moneyFun.format(data.deferredRate * 100, {decimal: 4}) + "%";
					}else {
						return "";
					}
				}
			},
			{
				data: "bizStatus",
				render: function (data, id) {
					return bt.dict("cms.bizStatus", data.bizStatus);
				}
			},
		]
	});
    
    });
</script>

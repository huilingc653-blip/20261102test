<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
	<ul class="mui-table-view" id="mulTable">
		##申请单位
		<li class="mui-table-view-cell">
        	#springMessage('table.cmsProvideLoanInfo.corpId')
	        <span class="mui-badge mui-badge-inverted">
	            $!{loanInfo.corpName}
	        </span>
    	</li>
    	##借款种类
    	<li class="mui-table-view-cell">
      		#springMessage('table.cmsProvideLoanInfo.plClass')
	        <span class="mui-badge mui-badge-inverted">
	            $!{loanInfo.plClassName}
	        </span>
    	</li>
    	##借款单号
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.billCode')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.billCode}
			</span>
		</li>
		##借款合同号
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.contractNo')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.contractNo}
			</span>
		</li>
		##借款银行
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.bankId')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.bankName}
			</span>
		</li>
		##借款银行账号
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.plAccount')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.plAccount}
			</span>
		</li>
		##借款币种
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.curId')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.curName}
			</span>
		</li>
		##发放金额
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.money')
			<span class="mui-badge mui-badge-inverted">
				$number.formatNumeric(${loanSend.money})
			</span>
		</li>
		##还款在途金额
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanRepay.repayPassage')
			<span class="mui-badge mui-badge-inverted">
				$number.formatNumeric(${repayPassage})
			</span>
		</li>
		##已还款金额
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanRepay.repayFinish')
			<span class="mui-badge mui-badge-inverted">
				$number.formatNumeric(${repayFinish})
			</span>
		</li>
		##发放单号
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.billCode')
			<span class="mui-badge mui-badge-inverted">
				$!{loanSend.billCode}
			</span>
		</li>
		##发放合同号
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.contractCode')
			<span class="mui-badge mui-badge-inverted">
				$!{loanSend.contractCode}
			</span>
		</li>
		##发放日期
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.sendDate')
			<span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!loanSend.sendDate)
			</span>
		</li>
		##到期日期
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.repayDate')
			<span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!loanSend.repayDate)
			</span>
		</li>
		##浮动方式
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.floatWay')
			<span class="mui-badge mui-badge-inverted">
				$!{loanSend.floatWayName}
			</span>
		</li>
		##利率调整生效日期
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.rateEntriesEffectDate')
			<span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!loanSend.rateEntriesEffectDate)
			</span>
		</li>
		##计息方式
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.interestWay')
			<span class="mui-badge mui-badge-inverted">
				$!{loanSend.interestWayName}
			</span>
		</li>
		##浮动利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.floatRate')(#springMessage('table.cmsLoanType.type'))
			<span class="mui-badge mui-badge-inverted">
				##基准利率类型
				$!{loanSend.referenceRateTypeName}
			</span>
		</li>
		##浮动利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.floatRate')(#springMessage('table.cmsLoanInfo.ternUnit'))
			<span class="mui-badge mui-badge-inverted">
				##贷款周期
				$!{loanSend.repayCycleName}
			</span>
		</li>
		##浮动利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.floatRate')(#springMessage('table.cmsLoanInfo.pointsProportionSelect'))
			<span class="mui-badge mui-badge-inverted">
				##点数或者浮动比例选择与文本
				$!{loanSend.pointsProportionSelectName} $number.formatNumeric($!{loanSend.pointsProportionText})
			</span>
		</li>
		##借款利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.plRate')
			<span class="mui-badge mui-badge-inverted">
				$rateTag.show($!{loanSend.plRate})
			</span>
		</li>
		##逾期利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.overdueRate')
			<span class="mui-badge mui-badge-inverted">
				$rateTag.show($!{loanSend.overdueRate})
			</span>
		</li>
		##展期利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.deferredRate')
			<span class="mui-badge mui-badge-inverted">
				$rateTag.show($!{loanSend.deferredRate})
			</span>
		</li>

         ##挂接资金计划
		 #if($!{budgetSel} == 1)

				#set($fbsBudgetItemDetail = $fbsBudgetTag.getViewItemDetailMobile($!{loanSend.billCode}, "", $!{businessName}, $!{processSysname},$!{loanSend.corpId}, $!{ProcessDate}))
				#parse("views/budget/fbsbudget.vm")

		 #end
	</ul>
	#parse("views/common/wapfooter.vm")
</body>
</html>

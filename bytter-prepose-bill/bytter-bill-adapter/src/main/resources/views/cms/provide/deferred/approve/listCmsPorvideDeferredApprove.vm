<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>

<body>
	<form action="" id="searchForm" class="layui-form">
		<input type="hidden" id="pageType" value="$!{pageType}">
		<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
		<input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
		<table class="layui-table">
			<tbody>
				<tr>
					## 查询区仅有展期编号：控件放在同一单元格，避免标题列被表格拉宽。
					<td>
						<div style="display: flex; align-items: center; flex-wrap: wrap; gap: 10px;">
							<label for="deferredBillCode" style="white-space: nowrap;">#springMessage('cms.porvide.loanDeferredNo')：</label>
							<input type="text" id="deferredBillCode" class="layui-input" name="likes_billCode"
								   style="width: 280px; max-width: 100%;" placeholder="#springMessage('cms.porvide.loanDeferredNo')" />
							<button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
							<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
						</div>
					</td>
				</tr>
			</tbody>
		</table>
	</form>

	<table id="appTable" class="layui-table layui-form"
		style="width: 100%;">
		<thead>
			<tr>
				<th>#springMessage('cms.porvide.loanDeferredNo')</th>
				<th>#springMessage('table.cmsPrecativeLoanRepay.sendCode')</th>
				<th>#springMessage('table.abBillTransfer.applyCorp')</th>
				<!-- <th>#springMessage('table.bvStorageBox.createDate')</th> -->
				<th>#springMessage('cms.common.deadlineDate')</th>
				<th>#springMessage('table.fcAcc.delayDeadlineDate')</th>
				<th>#springMessage('common.table.thead.operation')</th>
			</tr>
		</thead>
	</table>
				
		#workFlowHtml()
		#parse("views/common/footer.vm")
		#workFlowScript()
##<script src="${basePath}/static/modules/cms/provide/cmsProvideDeferredApprove.list.js?_btv=${resourceVersion}"></script>

<script>
bt.use(['form','datatable','dateType','moneyType','corp'], function(){
    $ = bt.jquery,form = bt.form();
    //时间
    bt.dateType.init();
    bt.corp.init();
    
    //生成列表
    datatable = bt.datatable.init({
        elem: "#appTable",
        dom: 'rtlip',
        colReorder: true,
        checkbox:true,order: [1,'desc'],
        ajax: {
            'url': basePath+"/cms/provide/provideloandeferred/dataTableApprove"
        },
        searchForm:{
            formElem:"#searchForm",
            formFilter:"search"
        },
        columns: [
            {data:"billCode",className:'center',bSortable:false},
            {data:"liCode",className:'center',bSortable:false},
            {data:"corpName",className:'center',bSortable:false},
            /* {data:"createDate",className:'center',bSortable:false}, */
            {data:"matureDate",className:'center',bSortable:false},
            {data:"deferredRepayDate",className:'center',bSortable:false},
            {data:null,bSortable:false,className:'center',render: function (data, type, full, meta) {
            	var html='';
            	if($("#flowStatus").val()=='todo'){
            		html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
            	}
				if($("#flowStatus").val() == 'pass'){
					html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a><span class="text-explode">|</span>';
					html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
				}else {
					html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
				}
                return html;
            }}
        ]
    });
});
 
/*审核*/
function approve(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    if(bt.navtab){
		bt.navtab.addNavtab(bt.lang('common.button.approve') ,basePath + "/cms/provide/provideloandeferred/viewDeferredApprove?businessId=" + data.id + "&taskId=" + data.taskId);
		return false;
    }
    parent.layer.open({
		type: 2,
		area: ['850px', '530px'],
		maxmin: true,
		content: basePath + "/cms/provide/provideloandeferred/viewDeferredApprove?businessId=" + data.id + "&taskId=" + data.taskId
    });
}

</script>
</body>
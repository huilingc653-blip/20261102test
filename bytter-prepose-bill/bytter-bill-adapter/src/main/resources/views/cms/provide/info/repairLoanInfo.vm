<script type="text/javascript">
    bt.use(['jquery', 'dicts'], function () {
        $ = bt.jquery;

        /**
         * 资金计划挂接
         */
        function myrenderBudget() {
            //跳过发放需要提前填写资金计划
            var loanSendOutType = $("#loanSendOutType").val();
            var acrossSend = $("#acrossSend").val();
            if (loanSendOutType == 1 && acrossSend == 1) {
                //判断支付结算是否挂接资金计划
                var budgetSel = $("#budgetSel").val();
                if (budgetSel == "1") {
                    //判断银行借款是否挂资金计划
                    var sendItem = $("#sendItem").val();
                    if (sendItem != null && sendItem != "") {
                            $genOtherHtml();
                    } else {
                        $("#tagItemDetail").html("");
                    }
                }
            } else {
                $("#tagItemDetail").html("");
            }
        }

        myrenderBudget();
    });
</script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab-content" style="width: 100%; height: 100%">

 <div class="layui-tab-item layui-show" style="width: 100%; height: 50%">
<iframe id="loanRepayIframe2" src="${basePath}/cms/provide/loaninfo/viewLoanInfo/$!{cmsProvideLoanRateVO.billCode}" frameborder="0" style="width: 100%; height: 100%"></iframe>
</div>

<form class="layui-form" id="searchForm"  method="post">
	<table class="layui-table layui-table-border">
		<thead>
		<tr>
			<td colspan="10" align="center">#springMessage('table.CmsProvideLoanRate.plRate')</td>

		</tr>
		<input type ="hidden" id="billCode" name="billCode" value="$!{cmsProvideLoanRateVO.id}">##借款id
		</thead>
		<tbody>
		<tr>
		    <td  align="center" width="15%">
			#springMessage('table.cmsProvideLoanInfo.plRate')##借款利率
		    </td>
			<td  width="40%">
			#set($plRate = $!{cmsProvideLoanRateVO.plRate} * 100)
			$!number.formatNumeric($!plRate,"0.0000") %
		    </td>
			 <td  align="center" width="15%">
			#springMessage('table.CmsProvideLoanRate.plRate')##调整借款利率
		    </td>
			<td >
				<div class="pl rateWrap layui-inline" style="width:104px;margin-right: 5px">
					<input  type="hidden" id="originalPointsProportionText" value="$!{loanInfo.pointsProportionText}" >
					<input  type="hidden" id="originalPLRate" value="$!{loanInfo.plRate}" >
					<input  type="hidden" id="isBankBaseRate" value="$!{isBankBaseRate}" >
					<input class="layui-input bt-biz-moneyType input-inline textRight" id="newPointsProportionText"
						   name="newPointsProportionText" data-callback="setPLRate"
						#if("$!{isBankBaseRate}" == true)  disabled="disabled" #end
						#if("$!{tbLoanRateMaintence}" != "")
						   data-max="$!{tbLoanRateMaintence.rateUpLimit}"
						   data-min="$!{tbLoanRateMaintence.rateDownLimit}"
						#else
						   data-max="100"
						   data-min="-100"
						#end
						   value="0.00"
						   data-biz-name="newPointsProportionText"
						   data-decimal="2" data-minus="true"
						   style="border: none; width: 80px;"
					>
					<span name="percentsymbol" class="inputMark">BP</span>
				</div>
				<div class="layui-inline">
				<input class="layui-input bt-biz-rateType" type="text" data-name="plRate" data-biz-name="plRate" placeholder="#springMessage('table.CmsProvideLoanRate.plRate')">
				</div>
		    </td>
	    </tr>

			<tr>
		    <td  align="center" width="15%">
			#springMessage('table.cmsProvideLoanInfo.deferredRate')##展期利率
		    </td>
			<td  width="40%">
			#set($zqRate = $!{cmsProvideLoanRateVO.deferredRate} * 100)
			$!number.formatNumeric($!zqRate,"0.0000") %
		    </td>
			 <td  align="center" width="15%">
			#springMessage('table.CmsProvideLoanRate.deferredRate')##调整展期利率
		    </td>
			<td>
				<div class="layui-inline">
					#springMessage('cms.loanInfo.deferredPoints')
				<div class="pl rateWrap layui-inline" style="width:104px;margin-right: 5px">

					<input class="layui-input bt-biz-moneyType input-inline textRight" id="deferredPoints"
						   name="deferredPoints" data-callback="setDeferredRate"
						#if("$!{isBankBaseRate}" == true)  disabled="disabled" #end
						   data-max="100"
						   data-min="0"
						   value="0.00"
						   data-biz-name="deferredPoints"
						   data-decimal="2" data-minus="true"
						   style="border: none; width: 80px;"
					>
					<span name="percentsymbol" class="inputMark">BP</span>
				</div>
				<div class="layui-inline">
				<input class="layui-input bt-biz-rateType" type="text" data-name="deferredRate" data-biz-name="deferredRate" placeholder="#springMessage('table.cmsProvideLoanInfo.deferredRate')">
				</div>
				</div>
		    </td>
	    </tr>

			<tr>
		    <td  align="center" width="15%">
			#springMessage('table.cmsProvideLoanInfo.overdueRate')##逾期利率
		    </td>
			<td  width="40">
			#set($yqRate = $!{cmsProvideLoanRateVO.overdueRate} * 100)
			$!number.formatNumeric($!yqRate,"0.0000") %
		    </td>
			 <td  align="center" width="15%">
			#springMessage('table.CmsProvideLoanRate.overdueRate')##调整逾期利率
		    </td>
			<td  >
				<div class="layui-inline">
					#springMessage('cms.loanInfo.overdueProportion')
				<div class="pl rateWrap layui-inline" style="width:104px;margin-right: 5px">

					<input class="layui-input bt-biz-moneyType input-inline textRight" id="overdueProportion"
						   name="overdueProportion" data-callback="setOverdueRate"
						#if("$!{isBankBaseRate}" == true)  disabled="disabled" #end
						   data-max="100"
						   data-min="0"
						   value="0.00"
						   data-biz-name="overdueProportion"
						   data-decimal="2" data-minus="true"
						   style="border: none; width: 80px;"
					>
					<span name="percentsymbol" class="inputMark">%</span>
				</div>
				</div>
				<div class="layui-inline">
				<input class="layui-input bt-biz-rateType" type="text" data-name="overdueRate" data-biz-name="overdueRate" placeholder="#springMessage('table.cmsProvideLoanInfo.overdueRate')">
				</div>
				#*<input type="text" data-name="overdueRate" value="$!{loanInfo.overdueRate}" class="layui-input bt-biz-rateType" lay-verify="required"  data-biz-name="overdueRate" placeholder="#springMessage('table.cmsProvideLoanInfo.overdueRate')">*#
		    </td>
	    </tr>

		<tr>
		    <td align="center" width="15%">
			#springMessage('table.InterestWayUpdate.activeDate')##执行日期
		    </td>
			<td   width="40%">
			<DIV class="layui-input-inline">
				<input lay-verify="required" type="text"  id="enterDate" name="enterDate"  data-min="$!{cmsProvideLoanRateVO.toDayDate}"   class="layui-input bt-biz-dateType" data-type="date" data-biz-name="activeDate">
               </DIV>
		    </td>
			<td></td>
			<td></td>
	    </tr>

	    </tbody>
	</table>
	<table class="layui-table" id="appTable" align="center">
		<thead>
			<tr>
        <th>#springMessage('table.cmsProvideLoanInfo.plRate')</th> ##借款利率
		<th>#springMessage('table.cmsProvideLoanInfo.deferredRate')</th> ##展期利率
        <th>#springMessage('table.cmsProvideLoanInfo.overdueRate')</th>	##逾期利率
        <th>#springMessage('table.InterestWayUpdate.activeDate')</th>	##执行日期
		</tr>
		</thead>
		<tbody>
		</tbody>

	</table>
	<div align="center">
		<button class="layui-btn" type="button" lay-submit="" id="submit" lay-filter="save">#springMessage('common.button.save')</button>
				<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
				<a href="#" class="layui-btn layui-btn-small" onClick="doClose()" >#springMessage('common.button.close')</a>
               ##<a href="#" class="layui-btn layui-btn-small" onClick="calculationSurplusMoney()" >测试</a>
			</div>

</form>

</div>

#parse("views/common/footer.vm")
</body>
<style>
    html,body{height:100%;}
</style>
<script src="${basePath}/static/modules/cms/provide/cmsProvideLoanRate.edit.js?_btv=${resourceVersion}"></script>
</html>


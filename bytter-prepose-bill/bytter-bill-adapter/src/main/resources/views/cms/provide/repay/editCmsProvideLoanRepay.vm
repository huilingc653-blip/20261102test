<!DOCTYPE html>
<html lang="en" style="height: 100%">
<head>
    #parse("views/common/head.vm")
</head>
<style type="text/css">
    .voucher-title {
        font-weight: bold;
        font-size: 12px;
        text-align: center;
        border-left: 0px;
        border-right: 0px;
        background-color: #d2d2d2;
    }
</style>
<body style="height: 100%">
<div>
    <iframe src="${basePath}/cms/provide/loansend/viewSend/$!{repay.sendCode}" id="sendIframe" frameborder="0"
            scrolling="no" style="width: 100%;"></iframe>
</div>
<form class="layui-form" method="post" id="inputForm">
    <input type="hidden" id="onlineSign" value="$!{repay.onlineSign}">
    <input id="id" name="id" type="hidden" value="$!{repay.id}">
    <input id="corpId" name="corpId" type="hidden" value="$!{repay.corpId}">
    <input id="curId" type="hidden" value="$!{send.curCode}">
    <input id="sendId" name="sendId" type="hidden" value="$!{send.id}">
    <input id="billCode" name="billCode" type="hidden" value="$!{repay.billCode}">
    <input id="sendCode" name="sendCode" type="hidden" value="$!{repay.sendCode}">
    <input id="mind" type="hidden" value="$!{mind}">
    <input id="maxd" type="hidden" value="$!{maxd}">
    <input id="repayMaxDate" name="repayMaxDate" type="hidden" value="$!{repayMaxDate}">
    <input id="repayMinDate" name="repayMinDate" type="hidden" value="$!{repayMinDate}">
    <input id="repayMaxLeftMoney" name="repayMaxLeftMoney" type="hidden" value="$!{repayMaxLeftMoney}">
    <input id="gua" value="$!{gua}" type="hidden">
    <input id="downSign" type="hidden" value="$!{downSign}">
    <input id="acrossRepair" value="$!{repay.acrossRepair}" type="hidden">
    <input id="tempOrSubmitSign" name="tempOrSubmitSign" value="$!{tempOrSubmitSign}" type="hidden">
    <input id="repayTypeJson"  value="$!{repayTypeJson}" type="hidden">
    <input id="accrualType" value="$!{send.accrualType}" type="hidden">
    <input id="repayType" name="repayType" type="hidden" value="$!{send.repayType}">
    <!-- 借款种类 -->
    <input id="plClass" name="plClass" value="$!{plClass}" type="hidden">
    <table class="layui-table">
        <tbody>
        <tr class="dark-table-header">
            <td colspan="4" class="voucher-title">#springMessage('cms.loan.loanRepayInfo')</td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;" style="position: relative;">
                <label><b>#springMessage('table.fcAccbook.enrolTime')</b></label>
                <div class="layui-input-inline">
                    <input id="createDate" name="createDate" value="$!date.format('yyyy-MM-dd',$!repay.createDate)"
                           readonly="readonly" autocomplete="off" class="layui-input">
                </div>

                <div style="position: absolute;margin-left:50px;top:2px;" class="layui-input-inline">
                    ## 是否提前还款
                    <label><b>#springMessage('table.cmsProvideLoanRepay.isAdvancedRepay')</b></label>
                    <div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="radio"
                             id="isAdvancedRepay"
                             data-group="cms.repay.isAdvancedRepay"
                             data-value="$!{repay.isAdvancedRepay}"
                             data-defaultvalue="0"
                             data-required="true"
                             data-callback="isAdvancedRepayCallback"
                             data-name="isAdvancedRepay"
                             data-biz-name="isAdvancedRepay"></div>
                    </div>
                </div>

            </td>
        </tr>
        <tr>
            ##还款日期
            <td class="textRight" width="14%">#springMessage('table.cmsProvideLoanRepay.repayDate')</td>
            <td width="36%">
                <input class="layui-input bt-biz-dateType"
                       id="repayDate"
                       name="repayDate"
                       value="$!{repay.repayDate}"
                       data-biz-name="repayDate"
                       data-type="date"
                       data-callback="nonSetRepayAccrual"
                       lay-verify="required">
                </input>
            </td>
            ##还款金额
            <td class="textRight" width="14%">#springMessage('table.cmsProvideLoanRepay.repayMoney')</td>
            <td width="36%">
                <div class="layui-inline">
                    <input class="layui-input bt-biz-moneyType"
                           data-name="repayMoney"
                           value="$!{repay.repayMoney}"
                           data-max="$!{sendBalance}"
                           lay-verify="required"
                           data-biz-name="repayMoney"
                           data-callback="countOnlineMoney"
                           data-decimal="2"
                           type="text"
                           placeholder="#springMessage('table.cmsProvideLoanRepay.repayMoney')">
                </div>
                <div class="layui-inline">
                    <!-- 还款计划 -->
                    <!-- 利息预计明细 -->
                    <button class="layui-btn" type="button" id="repayInterestOn" onclick="repayInterest();">#springMessage(
                        'cms.button.repayPlan')</button>
                    <!-- 试算按钮 -->
                    <button class="layui-btn layui-hide" type="button" id="repayInterestTest" onclick="repayInterest();">#springMessage(
                            'cms.button.repayPlanTest')</button>
                        <input type="hidden" id="provideInterestId" name="provideInterestId"
                               value="$!{repay.provideInterestId}">
                </div>
            </td>
        </tr>

            #if("$!{repay.onlineSign}" == "1" && "$!{downSign}" != "0")
                ##线上还款
            <input type="hidden" id="onlineSign" name="onlineSign" value="1">
            <tr>
                ##备注
                <td class="textRight">#springMessage('table.cmsProvideLoanRepay.rmk')</td>
                <td>
                    <input id="rmk" name="rmk" value="$!{repay.rmk}" data-biz-name="rmk" class="layui-input"
                           lay-verify="required" placeholder="#springMessage('table.cmsProvideLoanRepay.rmk')"/>
                </td>
                ##还款利息
                <td class="textRight">
                    #springMessage('table.cmsProvideLoanRepay.repayAccrual')
                </td>
                <td>
                    <input class="layui-input bt-biz-moneyType"
                           data-name="repayAccrual"
                           value="$!{repay.repayAccrual}"
                           data-biz-name="repayAccrual"
                           lay-verify="required"
                           data-decimal="2"
                           placeholder="#springMessage('table.cmsProvideLoanRepay.repayAccrual')">
                </td>
            </tr>
            <tr>
                ##实付利息
                <td class="textRight">#springMessage('table.cmsProvideLoanRepay.onlineInterest')</td>
                <td>
                    <div class="layui-inline">
                        <input class="layui-input bt-biz-moneyType"
                               data-name="onlineRealityInterest"
                               value="$!{repay.onlineRealityInterest}"
                               data-biz-name="onlineRealityInterest"
                               data-callback="countOnlineMoney"
                               data-decimal="2"
                               lay-verify="required"
                               placeholder="#springMessage('table.cmsProvideLoanRepay.onlineInterest')">
                    </div>
                    <div class="layui-inline">
                        <span style="color: red;">#springMessage('table.cmsProvideLoanRepay.onlineInterestMsg')</span>
                    </div>
                </td>
                ##金额
                <td class="textRight">
                    #springMessage('table.cmsProvideLoanRepay.onlineMoney')
                </td>
                <td>
                    <input class="layui-input bt-biz-moneyType"
                           data-name="onlineMoney"
                           value="$!{repay.onlineMoney}"
                           data-biz-name="onlineMoney"
                           data-decimal="2"
                           lay-verify="required"
                           readonly="readonly"
                           placeholder="#springMessage('table.cmsProvideLoanRepay.onlineMoney')">
                </td>
            </tr>
            <tr>
                ##还款帐号
                <td class="textRight">#springMessage('table.cmsPrecativeLoanRepay.repayAcc')</td>
                <td>
                    <div class="layui-input-inline">
                        <input id="onlinePaymentAcc" name="onlinePaymentAcc" value="$!{repay.onlinePaymentAcc}"
                               class="layui-input" type="text" lay-verify="required" readonly="readonly"
                               placeholder="#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc')"/>
                        <table id="paymentAccTable">
                            <thead>
                            <tr>
                                <th>#springMessage('table.btBankAcc.bankAcc')</th>
                                <th>#springMessage('table.btBankAcc.accName')</th>
                                <th>#springMessage('table.btBankAcc.bankName')</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                    <div class="layui-inline" id="accMsg">
                        <span></span>
                    </div>
                </td>
                ##还款帐号名称
                <td class="textRight">#springMessage('table.cmsPrecativeLoanRepay.repayAccName')</td>
                <td>
                    <input type="hidden" id="onlinePaymentAccId" name="onlinePaymentAccId"
                           value="$!{repay.onlinePaymentAccId}">
                    <input id="onlineAccName" name="onlineAccName" value="$!{repay.onlineAccName}" class="layui-input"
                           type="text" readonly="readonly" lay-verify="required"
                           placeholder="#springMessage('table.cmsProvideLoanRepay.onlinePaymentAccName')"/>
                </td>
            </tr>
            <tr>
                ##还款开户行名称
                <td class="textRight">#springMessage('table.cmsPrecativeLoanRepay.repayAcc.bankName')</td>
                <td>
                    <input id="onlineBankName" name="onlineBankName" value="$!{repay.onlineBankName}"
                           class="layui-input" type="text" readonly="readonly" lay-verify="required"
                           placeholder="#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc.bankName')"/>
                </td>
                ##用途
                <td class="textRight">
                    #springMessage('table.cmsProvideLoanRepay.onlinePurpose')
                </td>
                <td>
                    <div class=layui-inline>
                        <div class=bt-biz-selectType
                             data-name="onlinePurpose"
                             data-textField="purpose"
                             data-valueField="purpose"
                             data-biz-name="onlinePurpose"
                             data-url="${basePath}/cms/provide/loaninfo/getPurpose?corpId=${repay.corpId}"
                             data-defaultvalue="$!{repay.onlinePurpose}"
                             data-required="true"
                             data-inputvalue="true"
                             data-search="true">
                        </div>
                    </div>
                </td>
            </tr>
            #elseif("$!{repay.onlineSign}" == "0" || "$!{downSign}" == "0")
                ##线下还款
            <input type="hidden" id="onlineSign" name="onlineSign" value="0">
            <tr>
                ##备注
                <td class="textRight">#springMessage('table.cmsProvideLoanRepay.rmk')</td>
                <td>
                    <input id="rmk" name="rmk" value="$!{repay.rmk}" data-biz-name="rmk" class="layui-input"
                           lay-verify="required" placeholder="#springMessage('table.cmsProvideLoanRepay.rmk')"/>
                </td>
                ##还款利息
                <td class="textRight">
                    <div id="showLabal">
                        #springMessage('table.cmsProvideLoanRepay.repayAccrual')
                    </div>
                </td>
                <td>
                    <div id="showText">
                        <div class="layui-inline">
                            <input class="layui-input bt-biz-moneyType"
                                   data-name="repayAccrual"
                                   value="$!{repay.repayAccrual}"
                                   data-biz-name="repayAccrual"
                                   data-decimal="2"
                                   placeholder="#springMessage('table.cmsProvideLoanRepay.repayAccrual')">
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                ##跳过还款补录
                <td class="textRight">#springMessage('table.cmsProvideLoanRepay.acrossRepair')</td>
                <td>
                    <div class="bt-biz-dict" data-name="acrossRepair"
                         #if($!{repay.acrossRepair})
                            data-value="$!{repay.acrossRepair}"
                         #else
                            data-value="0"
                         #end
                         data-callback="showAccrual" data-biz-name="acrossRepair" data-required="true"
                         data-type="radio" data-group="sf_yn"></div>
                </td>
                ##实付利息
                <td class="textRight">#springMessage('table.cmsProvideLoanRepay.onlineInterest')</td>
                <td>
                    <div class="layui-inline">
                        <input class="layui-input bt-biz-moneyType"
                               data-name="onlineRealityInterest"
                               value="$!{repay.onlineRealityInterest}"
                               data-biz-name="onlineRealityInterest"
                               data-decimal="2"
                               placeholder="#springMessage('table.cmsProvideLoanRepay.onlineInterest')">
                    </div>
                    <div class="layui-inline">
                        <span style="color: red;">#springMessage('table.cmsProvideLoanRepay.onlineInterestMsg')</span>
                    </div>
                </td>
            </tr>
            #end
        <tr>
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td style="text-align: center;" colspan="3">
                <!-- 附件上传 -->
                <input id="annexName" name="annexName" type="hidden" value="$!{repay.uploadId}">
                <div id="uploader" class="layui-input-inline" style="width:100%"></div>
            </td>
        </tr>
        </tbody>
    </table>

    <!-- 银团明细信息 -->
    <table class="layui-table" style="display: none" id="syndicatedShow">
        <tr class="dark-table-header">
            <td colspan="4" class="voucher-title">#springMessage('cms.loan.ProvideSyndicatedDtlInfo')</td>
        </tr>
        <tr>
            <td>
                <button class="layui-btn" align="left" type="button" onclick="addSy()">#springMessage(
                            'common.addTr')</button>
                <button class="layui-btn" align="left" type="button" onclick="importExcel()">#springMessage(
                    'common.button.imports')</button>
                <table id="dataTableSy" class="layui-table">
                    <thead>
                    <th>#springMessage('table.cmsLoanInfo.leadingBank')</th>##是否牵头行
                    <th><span class="pl"><span
                            class="required-icon">*</span></span>#springMessage(
                        'table.cmsLoanInfo.bankName')</th>##银行名称
                    <th><span class="pl"><span
                            class="required-icon">*</span></span>#springMessage(
                        'table.cmsLoanInfo.bankCode')</th>##银行开户行号
                    <th><span class="pl"><span
                            class="required-icon">*</span></span>#springMessage(
                        'table.cmsLoanInfo.surplusMoney')</th>##待还款金额
                    <th><span class="pl"><span
                            class="required-icon">*</span></span>#springMessage(
                        'table.cmsLoanInfo.repaymentMoney')</th>##本次还款金额
                    <th>#springMessage('table.cmsLoanInfo.repaymentMoneyShare')</th>##还款本金占比%
                    <th><span class="pl"><span
                            class="required-icon">*</span></span>#springMessage('table.cmsLoanInfo.repaymentIst')</th>##还款利息
                    <th>#springMessage('common.table.thead.operation')</th>##操作
                    </thead>
                    <tbody id="dataTableSyBody">
                    </tbody>
                    <tfoot>
                    <tr>
                        <td>#springMessage('table.interet.sum')</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td></td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" style="border:none;width: 100px"
                                       value="0" data-biz-name="repaymentMoneySum"
                                       readonly="readonly" class="layui-input bt-biz-moneyType">
                            </div>
                        </td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" style="border:none;width: 100px"
                                       value="0" data-biz-name="repaymentMoneyShareSum"
                                       readonly="readonly" class="layui-input bt-biz-moneyType">
                            </div>
                            <div class="layui-inline">%</div>
                        </td>
                        <td>
                            <input type="text" style="border:none;width: 100px"
                                   value="0" data-biz-name="repaymentIstSum" readonly="readonly"
                                   class="layui-input bt-biz-moneyType">
                        </td>
                        <td>&nbsp;</td>
                    </tr>
                    </tfoot>
                </table>
            </td>
        </tr>
    </table>

    <br>
    <br>
    <br>
    <br>

    <!-- 预算 -->
    <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
    <input id="repayItem" name="repayItem" type="hidden" value="$!{repayItem}">
    <input id="defItemCode" name="defItemCode" type="hidden" value="$!{defItemCode}">
    <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
    <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
    <div id="tagItemDetail"></div>
    <br>
    <br>
    <br>
    <br>
    <div class="layui-form-item layui-form-submit ">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" id="submit" type="button">#springMessage(
                'common.button.submit')</button>
            <!-- 撤回的单据不能显示暂存按钮 -->
            #if("${repay.onlineStatus}" != "0")
                <button class="layui-btn" lay-submit="" id="temp" type="button">#springMessage(
                    'common.button.temp')</button>
            #end
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            <button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage(
                'common.button.close')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    var repayType=$!{repayTypeJson}
    var accrualType="$!{send.accrualType}"
</script>
<script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/provide/syndicatedDtl.public.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/provide/cmsProvideLoanRepay.edit.js?_btv=${resourceVersion}"></script>
</html>

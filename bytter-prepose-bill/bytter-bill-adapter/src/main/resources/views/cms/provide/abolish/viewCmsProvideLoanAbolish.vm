<!DOCTYPE html>
<html lang="en" style="height: 100%;">
<head>
    #parse("views/common/head.vm")
</head>
<body style="height: 100%;">
	<form class="layui-form layui-form-pane">
						<iframe src="${basePath}/cms/provide/loansend/view/$!{billCode}" id="sendIframe" frameborder="0" scrolling="no" style="width: 100%;margin: 0px;"></iframe>
  			
	</form>
	#if($!{struts} == 1)
	<form  class="layui-form layui-form-pane">
	 <table class="layui-table breakRow">
		<tbody>
				<tr>
        			##作废申请日期
					<td class="textRight" width="14%">#springMessage('table.fcOutAccbook.invalidOpTime'):</td>
					<td colspan="3">
						$date.format('yyyy-MM-dd',$!abolish.abolishedDate)
					</td>
				</tr>
        		
        		<tr>
        			##作废原因
					<td class="textRight" width="14%">#springMessage('table.fcOutAccbook.invalidReason')</td>
					<td colspan="3">
						<div class="layui-form-item layui-form-text" style="margin-bottom:0px;padding-right:500px;">
   					    	$!{abolish.rmk}
    					</div>
					</td>	
        		</tr>
        		
       	</tbody>
    </table>
    </form>
  #end
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
</html>
<script type="text/javascript">
    var billNo;
    bt.use(['form', 'datatable', 'corp', 'moneyType', 'btUpload', 'dicts', 'jquery','selectType','rateType'], function () {
        $ = bt.jquery, form = bt.form();
        bt.moneyType.init();
        bt.selectType.init();
        bt.rateType.init();
        var enableUpload = $("#enableUpload").val();
        showFloatWayNext();

        var gInfoId = $("#annexNameInfo").val();
        var gSendId = $("#annexNameSend").val();
        bt.btUpload.init({
            elem: "#uploaderInfo",
            hasUpload: enableUpload === "1" ? true : false,
            hasDelete: enableUpload === "1" ? true : false,
            auto: false,
            isExpand: true,
            gid: gInfoId,
            success: function (datas) {
                var infoAttachmentId = $("#annexNameInfo").val();
                if (infoAttachmentId === null || infoAttachmentId === undefined || infoAttachmentId === "" || infoAttachmentId === " ") {
                    if (datas.length > 0) {
                        setUploadFileId(datas[0]);
                    }
                }

            }
        });

        bt.btUpload.init({
            elem: "#uploaderSend",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gSendId
        });

        /**
         * 资金计划挂接
         */
        function renderBudget(corpId) {
            var acrossSend = $("#acrossSend").val();//是否跳过发放
            var sendBillCode = $("#sendBillCode").val();	//是否发放
            var budgetSel = $("#budgetSel").val();
            var sendItem = $("#sendItem").val();
            if ((acrossSend == "0" && sendBillCode != "") || (acrossSend == "1" && sendBillCode != "")) {
                billNo = sendBillCode;
                //判断支付结算是否挂接资金计划
                if (budgetSel == "1") {
                    if (sendItem != null && sendItem != "") {
                            $genOtherHtml(corpId);
                    } else {
                        $("#tagItemDetail").html("");
                    }
                }
            } else {
                billNo = $("#billCode").val();
                //判断支付结算是否挂接资金计划
                if (budgetSel == "1") {
                    if (sendItem != null && sendItem != "") {
                            $genOtherHtml(corpId);
                    } else {
                        $("#tagItemDetail").html("");
                    }
                }
            }
        }

        var corpId = $("#corpId").val();
        renderBudget(corpId);
    });

    /**
     * 生成公共的属性
     * @return
     */
        $genOtherHtml= function (corpId) {
        var url = basePath + "/budget/fbsBudgetProcess/getViewItemDetail";
        var param = {
            corpId: corpId,
            itemCode: $('#sendItem').val(),
            billNo: billNo,
            businessName: $("#businessName").val(),
            processSysname: $("#processSysname").val(),
            processDate: $("#ProcessDate").val(),
            curId: $("#curId").val(),//币别
            type: 'select',
            date: (new Date()).getTime()
        };
        $.ajax({
            url: url, method: 'POST', data: param, async: true, success: function (json) {
                $("#tagItemDetail").html("");
                $("#tagItemDetail").html(json);
                form.render();
            }
        });
    }


    function showFloatWayNext() {
        //显示nextFloatWya
        var floatWay = "";
        var nextFloatWay = "";
        if ("$!{loanSend}" != "") {
            floatWay = "$!{loanSend.floatWay}";
            nextFloatWay = "$!{loanSend.floatWayNext}"
        } else {
            floatWay = "$!{loanInfo.floatWay}";
            nextFloatWay = "$!{loanInfo.floatWayNext}"
        }

        var postfix = "";
        if (floatWay == "03") {//按月浮动
            postfix = "Month";
        } else if (floatWay == "04") {//按季浮动
            postfix = "Season";
        } else if (floatWay == "05") {//按半年浮动
            postfix = "HY";
        } else if (floatWay == "06") {//按年浮动
            postfix = "Year";
        }

        /*  var $.post({
             url:basePath + '',
             data:'',
             success:function(result){
                 if(result){
                     $("#nextFloatWay").html(result.data);
                 }
             }
         }) */

        if (postfix != "") {
            //var htl = '<div class="bt-biz-dict" data-name="floatWayNext" data-type="select" data-disabled="true" data-defaultvalue="'+ nextFloatWay +'" data-group="Cms.FloatWay'+ postfix +'"></div>';
            var float1 = bt.dict("Cms.FloatWay" + postfix, nextFloatWay);
            $("#nextFloatWay").html(float1);
            bt.dicts.render();

        }
    }

    //查看授信
    function viewRatCode() {
        var params = beforeRation();
        if (bt.empty(params)) {
            return;
        }
        viewRationDtl(params);
    }

    /**
     * 授信额度选择
     * @param params
     */
    function beforeRation() {
        var corpId = $("#corpId").val();
        var curId = $("#curId").val();//币别

        var bankId = $("#bankId").val();//银行

        var loanDate = $("#plDate").val();//借款日期

        var itemCode = $("#ratItemCode").val();//授信品种
        var beginDate = loanDate;
        var isRmbRat = $("#isRmbRat").val();//是否折合本位币
        var params = {
            corpId: corpId,
            curCode: curId,
            bankCode: bankId,
            ratItemCode: itemCode.replace(" ", ""),
            // beginDate: beginDate.replace(" ", ""),
            isRmbRat: isRmbRat
        }
        return params;
    }

    /**
     * 提交上传附件
     * @param attachment
     */
    function setUploadFileId(attachment){
        if (attachment != null) {
            var infoId = $("#infoId").val();
            $.ajax({
                url: basePath +"/cms/provide/loaninfo/setAttachmentId",
                type: "post",
                data: {
                    groupId: attachment.data.groupId,
                    infoId: infoId
                },
                dataType: "json",
                success: function (data) {
                    if (!data.success) {
                        layer.alert(data.msg, {icon: data.success ? 1 : 2});
                    } else {
                        var infoAttachmentId = $("#annexNameInfo").val();
                        if (infoAttachmentId === null || infoAttachmentId === undefined || infoAttachmentId === "" || infoAttachmentId === " "){
                            $("#annexNameInfo").val(attachment.data.groupId);
                        }
                    }
                }
            });
        }
    }
</script>

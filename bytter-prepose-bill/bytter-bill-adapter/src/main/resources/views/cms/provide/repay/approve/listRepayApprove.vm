<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
	<table class="layui-table">
		<tbody>
		   	<tr>
		   		<!-- ##单位代码
				<td class="textRight" width="25%">#springMessage('table.cmsProvideLoanInfo.corpId')</td>
		   		<td width="25%">
		   			<div class="layui-inline">
		   				<div class="bt-biz-corp" data-type="selectTree" data-name="eqs_corpId" data-scope="all"></div>
		   			</div>
		   		</td> -->
		   		##借款单号
		   		<td class="textRight" width="25%">#springMessage('table.cmsProvideLoanRepay.billCode')</td>
		   		<td width="25%">
					<input name="likes_billCode" class="layui-input" placeholder="#springMessage('table.cmsProvideLoanRepay.billCode')">
		   			<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
					<input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
		   		</td>
				##				创建人
				<td class="textRight">#springMessage('table.sysAttachment.createBy')</td>
				<td>
					<div class="layui-inline">
						<input type="text" name="likes_repayCreateName" id="createName" class="layui-input" >
					</div>
				</td>
		   	</tr>
		   	<tr>
		   		<td colspan="4" style="text-align: center;">
		   			<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
		           	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		   		</td>
		   	</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
    	<th>#springMessage('table.cmsProvideLoanInfo.corpId')</th><!-- 申请单位 -->
    	<th>#springMessage('table.cmsProvideLoanRepay.billCode')</th><!-- 借款单号 -->
    	<!-- <th>#springMessage('table.fcAccbook.enrolTime')</th> --><!-- 录入日期 -->
    	<th>#springMessage('table.cmsProvideLoanInfo.billCode')</th><!-- 借款单号 -->
        <th>#springMessage('table.cmsProvideLoanSend.billCode')</th><!-- 发放单号 -->
        <th>#springMessage('table.cmsProvideLoanRepay.repayMoney')</th><!-- 还款金额 -->
        <th>#springMessage('table.cmsProvideLoanRepay.repayDate')</th><!-- 还款时间 -->
        <th>#springMessage('table.cmsProvideLoanRepay.onlineSign')</th><!-- 还款模式-->
		<th>#springMessage('table.cmsProvideLoanRepay.isAdvancedRepay')</th><!-- 是否提前还款-->
		<th>#springMessage('table.sysAttachment.createBy')</th><!-- 创建人-->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#workFlowHtml()
#parse("views/common/footer.vm")
#workFlowScript()
</body>
<script src="${basePath}/static/modules/cms/provide/approve/repayApprove.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<style type="text/css">
    .voucher-title {
        font-weight: bold;
        font-size: 12px;
        text-align: center;
        border-left: 0px;
        border-right: 0px;
        background-color: #d2d2d2;
    }
    .layui-colla-title{
        font-size: 12px;
    }
</style>
<!-- 完整info信息的View -->
<body style="padding: 0px;">
<input type="hidden" id="corpId" name="corpId" value="$!{loanInfo.corpId}"/>
##查看表示
<input type="hidden" id="viewFlag" value="$!{viewFlag}">
<form class="layui-form" method="post">
<div>
    <input type="hidden" name="id" value="$!{loanInfo.id}">
    <table class="layui-table  breakRow">
        <tbody>
        <tr class="dark-table-header">
            <td colspan="4" class="voucher-title">#springMessage("cms.provide.info")</td>
        </tr>
        <tr class="dark-table-header">
            <td colspan="4" class="voucher-title" style="text-align: left">#springMessage("table.cmsProvideLoan.mainMessage")</td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <label>#springMessage("table.cmsProvideLoanAbolish.loanDate")</label>
                <div class="layui-input-inline">
                    $!date.format('yyyy-MM-dd',$!loanInfo.createDate)
                </div>
            </td>
        </tr>
        <tr>
        ##借款单号
            <td class="textRight" width="14%">#springMessage('table.cmsProvideLoanInfo.billCode')</td>
            <td width="36%">$!{loanInfo.billCode}</td>
            <td colspan="2"></td>
        </tr>
        <tr>
        ##申请单位
            <td class="textRight" width="14%">#springMessage('table.cmsProvideLoanInfo.corpId')</td>
            <td width="36%">$!{loanInfo.corpName}</td>
        ##借款种类
            <td class="textRight" width="14%">#springMessage('table.cmsProvideLoanInfo.plClass')</td>
            <td width="36%">$!{loanInfo.plClassName}</td>
        </tr>
        <tr>
            <!-- ##银行种类
			<td class="textRight">#springMessage('table.cmsProvideLoanInfo.bankType')</td>
			<td>$!{loanInfo.bankTypeName}</td> -->
        ##借款银行
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.bankId')</td>
            <td>
                $!{loanInfo.bankName}
                <input type="hidden" id="bankId" name="bankId" value="$!{loanInfo.bankId}">
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
        ##借款金额小写
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plMoneyLow')</td>
            <td>
                $!number.formatNumeric($!{loanInfo.plMoney})
                <div style="display: none;">
                    <input class="bt-biz-moneyType" data-name="plMoney" value="$!{loanInfo.plMoney}"
                           data-toup="plMoneyUpper" data-biz-name="plMoney" data-decimal="2" data-minus="false">
                </div>
            </td>
        ##借款金额大写
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plMoneyUpper')</td>
            <td>
                <div class="layui-input-inline " id="plMoneyUpper"></div>
            </td>
        </tr>
        <tr>
        ##借款币种
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.curId')</td>
            <td>
                $!{loanInfo.curName}
                <input type="hidden" id="curId" name="curId" value="$!{loanInfo.curId}"/>
            </td>
        ##借款期限
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plTerm')</td>
            <td>$!{loanInfo.plTerm} $!{loanInfo.ternUnitName}</td>
        </tr>
        <tr>
        ##借款日期
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!loanInfo.plDate)
                <input type="hidden" id="plDate" name="plDate" value="$!date.format('yyyy-MM-dd',$!loanInfo.plDate)"/>
            </td>
        ##还款日期
            <td class="textRight">#springMessage('cms.provide.deferred.repayDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!loanInfo.repayDate)
                <input type="hidden" id="repayDate" name="repayDate" value="$!date.format('yyyy-MM-dd',$!loanInfo.repayDate)">
            </td>
        </tr>
        <tr>
        ##借款用途
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plPurpose')</td>
            <td>$!{loanInfo.plPurpose}</td>
        ##合同期限
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.contractTerm')</td>
            <td>
                $!{loanInfo.contractTermName}
            </td>
        </tr>
        <tr>
        ##还款方式
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.repayType')</td>
            <td>$!{loanInfo.repayTypeName}</td>
        ##备注
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
            <td style="word-wrap: break-word;">
                $!{loanInfo.rmk}
            </td>
        </tr>
        </tbody>
    </table>
    <table class="layui-table">
        <tbody>
        <tr class="dark-table-header">
            <td colspan="4" class="voucher-title" style="text-align: left">#springMessage("table.cmsProvideLoan.rateMessage")</td>
        </tr>
        ##补录之后再显示这些信息
            #if("$!{loanInfo.contractNo}" != "")
            <tr>
            ##借款合同号
                <td class="textRight" width="14%">#springMessage('table.cmsProvideLoanInfo.contractNo')</td>
                <td width="36%">$!{loanInfo.contractNo}</td>
            ##发放方式
                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.loanSendOutType')</td>
                <td width="30%">$!{loanInfo.loanSendOutTypeName}</td>
            </tr>
            <tr>
                <td colspan="2"></td>
            ##是否跳过发放
                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.acrossSend')</td>
                <td width="30%">$!{loanInfo.acrossSendName}</td>
            </tr>
            #end

            #if("$!{loanInfo.contractNo}" != "")
            <tr>
            ##付息方式
                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.cplInterestPayment')</td>
                <td>$!{loanInfo.cplInterestPaymentName}</td>
                ##计提方式
                <td class="textRight">#springMessage('table.cmsProvideLoanSend.accrualWay')</td>
                <td>$!{loanInfo.accrualTypeName}</td>
            </tr>
            #end
        <tr>
        ##浮动方式
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.floatWay')</td>
            <td>
                <div class="layui-inline">
                    $!{loanInfo.floatWayName}
                </div>
                <div class="layui-inline" id="nextFloatWay"><!---->

                </div>
            </td>
        ##利率调整生效日期
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rateEntriesEffectDate')</td>
            <td>$!date.format('yyyy-MM-dd',$!loanInfo.rateEntriesEffectDate)</td>
        </tr>
        <tr>
        ##浮动利率
            <td class="textRight" width="14%">#springMessage('table.cmsProvideLoanInfo.floatRate')</td>
            <td width="36%">
                <div class="layui-inline">
                    <div style="padding-bottom: 10px;padding-top: 10px;">
                        <div class="layui-inline">
                        ##基准利率类型
                                $!{loanInfo.referenceRateTypeName}
                        </div>
                    </div>
                    <div style="padding-bottom: 10px;padding-top: 10px;">
                        <div class="layui-inline">
                        ##贷款周期
                                 $!{loanInfo.repayCycleName} <span style="padding-left: 30px;">$!date.format('yyyy-MM-dd',$!loanInfo.rateQuotedPriceDate)</span>
                        </div>
                    </div>
                    <div style="padding-bottom: 10px;padding-top: 10px;">
                    ##点数或者浮动比例选择与文本
                        <div class="layui-inline">
                            $!{loanInfo.pointsProportionSelectName}
                        </div>
                        <div class="layui-inline">
                            #if($!{loanInfo.pointsProportionText})
                                    #if($!{loanInfo.isBankBaseRate} == "1")
                                            $!number.formatNumeric($!{loanInfo.pointsProportionText})%
                                        #else
                                            $!number.formatNumeric($!{loanInfo.pointsProportionText})BP
                                    #end
                                #else
                                    #if($!{loanInfo.isBankBaseRate} == "1")
                                        0.00%
                                        #else
                                        0.00BP
                                    #end
                            #end
                        </div>
                    </div>
                </div>
            </td>
            <td colspan="2" align="center">
                <table class="layui-table" style="width: 90%">
                    <tr>
                        <td width="15%" align="right">#springMessage('table.cmsProvideLoanInfo.rateBase')</td>
                        <td width="80%" align="left" colspan="3">
                        ##利息测算基数
                                $!{loanInfo.rateBase}#springMessage('cms.loan.ternUnit.day')
                        </td>
                    </tr>
                    <tr>
                        <td width="18%" align="right">#springMessage('table.cmsProvideLoanInfo.plRate')</td>
                        <td width="27%" align="left">
                            <div class="layui-inline">
                            ##借款利率
                                    $!rateTag.show($!{loanInfo.plRate})
                            </div>
                        </td>
                        <td width="18%" align="right">
                            #springMessage('table.cmsProvideLoanInfo.anticInterest')
                        </td>
                        <td width="32%" align="left">
                        ##预计利息
                                $!number.formatNumeric($!{loanInfo.anticInterest})
                        </td>
                    </tr>
                    <tr>
                        <td width="18%" align="right">#springMessage(
                                    'table.cmsProvideLoanInfo.compositeFeeRate')</td>
                        <td width="27%" align="left">
                        ##综合成本年化利率
                                $!rateTag.show($!{loanInfo.compositeFeeRate})
                        </td>
                        <td width="18%" align="right">
                            #springMessage('table.cmsProvideLoanInfo.compositeFee')
                        </td>
                        <td width="32%" align="left">
                        ##综合成本
                                $!number.formatNumeric($!{loanInfo.compositeFee})
                        </td>
                    </tr>
                </table>
            </td>
            <!-- ##借款利率
                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plRate')</td>
                <td>
                    ##set($plRate = $!{loanInfo.plRate} * 100)
                    $!rateTag.show($!{loanInfo.plRate})
                </td> -->
        </tr>
        ##新加费用信息
        </tbody>
    </table>
    <table class="layui-table">
    ##第三方费用信息
        <tr class="dark-table-header">
            <td colspan="4" class="voucher-title" style="text-align: left">#springMessage("table.cmsProvideLoan.chargeMessage")</td>
        </tr>
    <tr>
        <td colspan="4" align="center" width="80">
            <table id="dataTable" class="layui-table">
                <thead>
                <th width="25%">#springMessage('table.fcChargeRule.fcChargeType')</th>##费用类型
                <th width="25%"> #springMessage('table.guaGuarantee.handleRate')</th>##费率
                <th width="25%">#springMessage('table.cms.projected.expemditure')</th>##预计费用
                </thead>
                <tbody>
                    #if($costVOS.size() > 0)
                        #foreach($detail in $!{costVOS})
                            #set($vcount = $velocityCount - 1)
                            #set($velocityCount = $costVOS.size() - 1)
                        <tr>
                            <td align="center">
                                <input type="text" style="text-align: center;" value="$!{detail.costName}" disabled="true" class="layui-input">
                            </td>

                            <td align="center">##费率
                                <input type="text" style="text-align: right;" value="$!rateTag.show($!{detail.rate})" disabled="true" class="layui-input">
                            </td>

                            <td align="center">##预计费用
                                <input type="text" style="text-align: right;"  value="$!number.formatNumeric($!{detail.advanceFees})" disabled="true" class="layui-input">
                            </td>

                        </tr>
                        #end
                    #end
                </tbody>
            </table>
        </td>
    </table>

##其他业务挂接信息
    <table class="layui-table">
        <tbody>
        <tr class="dark-table-header">
            <td colspan="4" class="voucher-title" style="text-align: left">#springMessage("table.cmsProvideLoan.otherBusMessage")</td>
        </tr>
            #if($!{relateRat} == "1")
            ##授信
            <tr class="ratInfo">
                <td class="textRight" style="width: 15%">#springMessage('table.cmsProvideLoanInfo.ratmodel')</td>
                <td style="width: 35%">$!dictTag.get("sf_yn",$!{loanInfo.ratmodel})</td>
                #if("1"==$!{isBond})##保证金参数开启的情况下才有授信是否敞口
                    #if($!{isOpenRat} == "1" && $!{loanInfo.ratmodel} == "1")
                    ##授信敞口
                        <td class="textRight" style="width: 15%">#springMessage('common.isOpen.ratUration')</td>
                        <td style="width: 35%">
                            <div class="layui-inline">
                                $!dictTag.get("sf_yn",$!{loanInfo.isOpenRat})
                            </div>
                        </td>
                        #else
                            <td style="width: 15%"></td>
                            <td style="width: 35%"></td>
                    #end
                #else
                    <td style="width: 15%"></td>
                    <td style="width: 35%"></td>
                #end
            </tr>
                #if($!{loanInfo.ratmodel} == "1")
                    #if("$!{cur.id}" != "$!{loanInfo.curId}")
                    <tr id="isRmbRatTr">
                    ##是否折合成本位币
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsProvideLoanInfo.isRmbRat')</td>
                        <td style="width: 35%">
                            $!dictTag.get("sf_yn",$!{loanInfo.isRmbRat})
                            <input type="hidden" id="isRmbRat" name="isRmbRat" value="$!{loanInfo.isRmbRat}"/>
                        </td>
                        #if("$!{loanInfo.isRmbRat}" == "1")
                        ##保存当前币种转换汇率
                            <td class="textRight" id="exchangerateTd1" style="width: 15%">#springMessage('table.cmsProvideLoanInfo.exchangerate')</td>
                            <td id="exchangerateTd2" style="width: 35%">
                                $!excRateTag.getConvert($!{loanInfo.exchangerate})
                            </td>
                        #else
                            <td style="width: 15%"></td>
                            <td style="width: 35%"></td>
                        #end
                    </tr>
                    #end
                <tr>
                    <td class="textRight" style="width: 15%">
                        #springMessage('table.cmsProvideLoanInfo.rationSelect')
                    </td>
                    <td style="width: 35%">
                        <div id="rationBtn">
                            <button type="button" onclick="viewRatCode()" class="layui-btn">#springMessage(
                            'common.button.view')</button>
                        </div>
                        <span id="itemCodeTd"></span>
                        <input type="hidden" id="ratItemCode" name="ratItemCode" value="$!{urationDTO.ratItemCode}"/>
                        <input type="hidden" name="ratCode" id="ratCode" value="$!{urationDTO.ratCode}">
                        <input type="hidden" name="itemFlag" id="itemFlag" value="$!{urationDTO.itemFlag}">
                        <input type="hidden" name="itemMoney" id="itemMoney" value="$!{urationDTO.money}">
                        #if($!{urationDTO.itemFlag} == "0")
                            <!-- 				<input type="hidden" name="ratItemCode" id="ratItemCode" value="$!{urationDTO.ratItemCode}"> -->
                        #else
                            #foreach($applyDtl in $!{urationDTO.applyDtls})
                                #set($vcount = $velocityCount - 1)
                                <input type="hidden" name="applyDtls[$!{vcount}].itemCode" id="itemCode$!{vcount}"
                                       value="$!{applyDtl.itemCode}">
                                <input type="hidden" name="applyDtls[$!{vcount}].itemMoney" itemCode="$!{applyDtl.itemCode}"
                                       id="itemMoney$!{vcount}" value="$!{applyDtl.useMaxMoney}">
                            #end
                        #end
                    </td>
                    <td class="textRight" style="width: 15%">#springMessage('table.cmsProvideLoanInfo.itemCode')</td>
                    <td style="width: 35%">
                        $!{urationDTO.ratItemName}&nbsp;&nbsp;
                        <label style="padding-left: 10px">
                            #springMessage('cms.business.race')：
                        </label>
                        &nbsp;$!{urationDTO.raceName}
                    </td>
                </tr>
                #end
            #end
            #if($!{isGuarantee} == 1)
            <tr>
                <td class="textRight" style="width: 15%">#springMessage('rat.Is.bkration.gua')</td>
                <td style="width: 35%">
                    <div class="layui-form">
                        $!dictTag.get("sf_yn",$!{loanInfo.isHangGuarantee})
                    </div>
                </td>
                #if($!{loanInfo.isHangGuarantee} == 1)
                    <td class="textRight" style="width: 15%">#springMessage('cms.guarantee.rmk')</td>
                    <td style="width: 35%">
                        <div class="layui-input-inline">
                            $!{loanInfo.guaranteeRmk}
                        </div>
                    </td>
                #else
                    <td style="width: 15%"></td>
                    <td style="width: 35%"></td>
                #end
            </tr>
            #end
            #if($!{pledgeConfig}=="1")
                ##抵质押物挂接
                    #parse("views/cms/guarantee/guaPledgeCommon.vm")
            #end
        <tr>
        ##附件
            <td class="textRight">#springMessage('cms.loan.attachment')</td>
            <td colspan="3">
                <!-- 附件上传 -->
                <input id="annexNameInfo" name="annexNameInfo" type="hidden" value="$!{loanInfo.uploadId}">
                <div id="uploaderInfo" class="layui-input-inline" style="width:100%"></div>
            </td>
        </tr>
        </tbody>
    </table>
    #if($!{loanInfo.status}==96)##发放列表的数据查看时显示补录信息
##借款补录信息
    <table class="layui-table">
        <tr class="dark-table-header">
            <td colspan="4" class="voucher-title" style="text-align: left">#springMessage('table.cmsProvideLoan.additionalMessage')</td>
        </tr>
        <tr>
        ##借款合同号
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.contractNo')</td>
            <td>
                $!{loanInfo.contractNo}
            </td>
        ##借款发放方式
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.loanSendOutType')</td>
            <td>
                $!dictTag.get("cms.loan.loanSendOutType",$!{loanInfo.loanSendOutType})
            </td>
        </tr>
        #if("$!{loanInfo.loanSendOutType}" == "1")
        ##跳过借款发放功能
            <tr>
                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.acrossSend')</td>
                <td>
                    $!dictTag.get("sf_yn",$!{loanInfo.acrossSend})
                </td>
                <td></td>
                <td></td>
            </tr>
        #end
       <tr>
        ##付息方式
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.cplInterestPayment')</td>
            <td>
                #if("$!loanInfo.cplInterestPayment" == "")
                    #set($cplInterestPayment = "01")
                #else
                    #set($cplInterestPayment = $loanInfo.cplInterestPayment)
                #end
                 $!dictTag.get("provide.payInterest",$!{cplInterestPayment})
            </td>
        ##计息方式
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.interestWay')</td>
            <td>
                $!dictTag.get("Admin.PredrawSign",$!{loanInfo.interestWay})
            </td>
        </tr>
        <tr>
        ##展期利率
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.deferredRate')</td>
            <td width="36%">
                $!rateTag.show($!{loanInfo.deferredRate})
            </td>
        ##逾期利率
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.overdueRate')</td>
            <td width="36%">
   				$!rateTag.show(${loanInfo.overdueRate})
            </td>
        </tr>
    </table>
    #end
##保证金信息
    #if("1"==$!{isBond})##参数设置挂接保证金时显示保证金信息
    <h2 class="layui-colla-title">#springMessage('table.fcBond.BondMsg')</h2>
        #if(${loanInfo.isHookBond}=="1")
            #set($fcBondApplyDTO=$fcBondTag.getBondApplyDetail(${loanInfo.id},${loanInfo.billCode}))
            #set($fcBondRate=($!{loanInfo.bondRate}))
            #parse("views/common/viewFcBondDetail.vm")
        #else
            <table class="layui-table">
                <tbody>
                <tr>
                    <td class="textRight" width="15%">#springMessage('table.fcBond.corpName')</td>
                    <td>$!{loanInfo.corpName}</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td class="textRight" width="15%">#springMessage('table.fcBond.contractNum')</td>
                    <td>$!{loanInfo.bailmoneyContract}</td>
                    <td class="textRight" width="15%">#springMessage('table.fcBond.curCode')</td>
                    <td>$!{loanInfo.curName}</td>
                </tr>
                <tr>
                    <td class="textRight" width="15%">#springMessage('table.fcBond.bondmoney')</td>
                    <td>$!number.formatNumeric($!{loanInfo.bailmoney})</td>
                    <td class="textRight" width="15%">#springMessage('table.fcBond.bondPercent')</td>
                    #set($bondPercent=$!{loanInfo.bailmoneyRate}*100)
                    <td>$!number.formatDoubles($!bondPercent,2)%</td>
                </tr>
                <tr>
                    <td class="textRight" width="14%">#springMessage('table.fcBond.bondRate')</td>
                    #set($bondRate=$!{loanInfo.bondRate}*100)
                    <td width="36%">$!number.formatNumeric($!bondRate,"#0.0000")%</td>
                    <td width="14%"></td>
                    <td></td>
                </tr>
                </tbody>
            </table>
        #end
    #end
##担保合同信息
    #if($!{isGuarantee}=="1")
        #if(${loanInfo.isHangGuarantee}=="1")
            <h2 class="layui-colla-title">#springMessage('table.guaContract.ContractMsg')</h2>
            #set($guaContractUseDTO=$guaContractTag.getGuaContractOccupyDetail($!{loanInfo.id},$!{loanInfo.billCode}))
            #if($!{guaContractUseDTO})
                #parse("views/common/guaContractDetail.vm")
            #end
        #end
    #end
    ##抵质押物信息
    #if($!{pledgeConfig}=="1")
        #if(${loanInfo.isRelatePledge}=="1")
            <h2 class="layui-colla-title">抵质押物信息</h2>
            #set($pledgeList=$guaPledgeTag.getPledgeOccupy($!{loanInfo.id},$!{loanInfo.billCode}))
            #if($!{pledgeList})
                #parse("views/cms/guarantee/viewPledgeList.vm")
            #end
        #end
    #end
    <table class="layui-table">
        <tbody>
        <tr>
        ##预算信息
            <td colspan="4">
                <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
                <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
                <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
                <input id="sendItem" name="sendItem" type="hidden" value="$!{sendItem}">
                <input id="acrossSend" name="acrossSend" type="hidden" value="$!{loanInfo.acrossSend}">
                <input id="billCode" name="billCode" type="hidden" value="$!{loanInfo.billCode}">
                <input id="ProcessDate" name="ProcessDate" type="hidden" value="$!{date.format('yyyy-MM-dd',$!{ProcessDate})}">
                <div id="tagItemDetail"></div>
            </td>
        </tr>
        </tbody>
    </table>
</div>
    <div style="width: 100%;text-align: center">
        <button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
    </div>
</form>
    <div style="height: 30px"></div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratUrationSet.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/guarantee/guaPledgeSelect.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">
    var billNo;
    bt.use(['form', 'datatable', 'corp', 'moneyType', 'btUpload', 'dicts', 'jquery','selectType','rateType'], function () {
        $ = bt.jquery, form = bt.form();
        bt.moneyType.init();
        bt.selectType.init();
        bt.rateType.init();
        showFloatWayNext();
        var gInfoId = $("#annexNameInfo").val();
        var gSendId = $("#annexNameSend").val();
        bt.btUpload.init({
            elem: "#uploaderInfo",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gInfoId
        });

        bt.btUpload.init({
            elem: "#uploaderSend",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gSendId
        });

        /**
         * 资金计划挂接
         */
        function renderBudget(corpId) {
            var acrossSend = $("#acrossSend").val();//是否跳过发放
            var budgetSel = $("#budgetSel").val();
            var sendItem = $("#sendItem").val();
            billNo = $("#billCode").val();
            //判断支付结算是否挂接资金计划
            if (budgetSel == "1" && "1" === acrossSend) {
                if (sendItem != null && sendItem != "") {
                        genOtherHtml(corpId);
                } else {
                    $("#tagItemDetail").html("");
                }
            }
        }

        //监听提交
        form.on('submit', function(data){
            var isRelatePledge = dicts.get("isRelatePledge").val();
            if ("1" == isRelatePledge) {
                var guaPledgeMoney = moneyTypes.get("guaPledgeMoney").val();
                if (Number(guaPledgeMoney) == 0) {
                    layer.alert(bt.lang("pledge.must.be.select"), {icon: 2});
                    return false;
                }
            }
            var action = "/cms/provide/loaninfo/saveChange";
            bt.loading.show();
            $.post(basePath + action,data.field,function(result){
                layer.alert(result.msg, {icon: result.success?1:2});
                if(result.success){
                    if(!bt.navtab){
                        location.reload();
                        parent.layer?parent.layer.closeAll():layer.closeAll();
                    } else {
                        if(data.field.id == ""){
                            bt.navtab.refreshCurrent();
                        }else{
                            bt.navtab.closeCurrent();
                        }
                    }
                }else{
                    bt.loading.hide();
                }
            },'JSON');
            return false;
        });

        var corpId = $("#corpId").val();
        renderBudget(corpId);
    });

    /**
     * 生成公共的属性
     * @return
     */
        genOtherHtml= function (corpId) {
        var url = basePath + "/budget/fbsBudgetProcess/getViewItemDetail";
        var param = {
            corpId: corpId,
            itemCode: $('#sendItem').val(),
            billNo: billNo,
            businessName: $("#businessName").val(),
            processSysname: $("#processSysname").val(),
            processDate: $("#ProcessDate").val(),
            curId: $("#curId").val(),//币别
            type: 'select',
            date: (new Date()).getTime()
        };
        $.ajax({
            url: url, method: 'POST', data: param, async: true, success: function (json) {
                $("#tagItemDetail").html("");
                $("#tagItemDetail").html(json);
                form.render();
            }
        });
    }


    function showFloatWayNext() {
        //显示nextFloatWya
        var floatWay = "";
        var nextFloatWay = "";
        floatWay = "$!{loanInfo.floatWay}";
        nextFloatWay = "$!{loanInfo.floatWayNext}"

        var postfix = "";
        if (floatWay == "03") {//按月浮动
            postfix = "Month";
        } else if (floatWay == "04") {//按季浮动
            postfix = "Season";
        } else if (floatWay == "05") {//按半年浮动
            postfix = "HY";
        } else if (floatWay == "06") {//按年浮动
            postfix = "Year";
        }
        if (postfix != "") {
            //var htl = '<div class="bt-biz-dict" data-name="floatWayNext" data-type="select" data-disabled="true" data-defaultvalue="'+ nextFloatWay +'" data-group="Cms.FloatWay'+ postfix +'"></div>';
            var float1 = bt.dict("Cms.FloatWay" + postfix, nextFloatWay);
            $("#nextFloatWay").html(float1);
            bt.dicts.render();

        }
    }

    //查看授信
    function viewRatCode() {
        var params = beforeRation();
        if (bt.empty(params)) {
            return;
        }
        viewRationDtl(params);
    }

    /**
     * 授信额度选择
     * @param params
     */
    function beforeRation() {
        var corpId = $("#corpId").val();
        var curId = $("#curId").val();//币别

        var bankId = $("#bankId").val();//银行

        var loanDate = $("#plDate").val();//借款日期

        var itemCode = $("#ratItemCode").val();//授信品种
        var beginDate = loanDate;
        var isRmbRat = $("#isRmbRat").val();//是否折合本位币
        var params = {
            corpId: corpId,
            curCode: curId,
            bankCode: bankId,
            ratItemCode: itemCode.replace(" ", ""),
            // beginDate: beginDate.replace(" ", ""),
            isRmbRat: isRmbRat
        }
        return params;
    }

    /**
     * 担保选择前参数检查
     * @returns {boolean}
     */
    function selectBefore(){
        return true;
    }



    /**
     * 担保选择参数设置
     * @param param
     */
    function setOtherParam(param){
        var corpId = $("#corpId").val() ;//单位
        var startDate = $("#plDate").val();//开始日期;//开始日期
        var endDate = $("#repayDate").val() ;;//结束日期
        var curId = $("#curId").val() ;;//币别
        param["corpId"] = bt.empty(corpId) ? "" : corpId;
        param["startDate"] = bt.empty(startDate) ? "" : startDate;
        param["endDate"] = bt.empty(endDate) ? "": endDate;
        param["curId"] = bt.empty(curId) ? "" : curId;
    }
</script>
</html>

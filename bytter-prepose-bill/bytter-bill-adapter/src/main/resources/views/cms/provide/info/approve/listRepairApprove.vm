<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
	<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
	<input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
	<table class="layui-table">
		<tbody>
			<tr>
				## 查询区只有借款单号：同一单元格内紧凑排列，避免表格自动拉宽标题列。
				<td>
					<div style="display: flex; align-items: center; flex-wrap: wrap; gap: 10px;">
						<label for="repairBillCode" style="white-space: nowrap;">#springMessage('table.cmsProvideLoanInfo.billCode')：</label>
						<input id="repairBillCode" name="likes_billCode" class="layui-input"
							   style="width: 280px; max-width: 100%;" placeholder="#springMessage('table.cmsProvideLoanInfo.billCode')">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</div>
				</td>
			</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
    	<th>#springMessage('table.cmsProvideLoanInfo.corpId')</th>
    	<th>#springMessage('table.cmsProvideLoanInfo.billCode')</th>
    	<!-- <th>#springMessage('table.cmsProvideLoanInfo.createDate')</th> -->
    	<th>#springMessage('table.cmsProvideLoanInfo.bankId')</th>
    	<th>#springMessage('table.cmsProvideLoanInfo.curId')</th>
    	<th>#springMessage('table.cmsProvideLoanInfo.plMoney')</th>
    	<th>#springMessage('table.cmsProvideLoanInfo.plDate')</th>
    	<th>#springMessage('cms.provide.deferred.repayDate')</th>
    	<th>#springMessage('table.cmsProvideLoanInfo.repayType')</th>
    	<th>#springMessage('table.cmsProvideLoanInfo.contractTerm')</th>
    	<th>#springMessage('table.cmsProvideLoanInfo.plTerm')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#workFlowHtml()
#parse("views/common/footer.vm")
#workFlowScript()
<script src="${basePath}/static/modules/cms/provide/approve/infoRepairApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

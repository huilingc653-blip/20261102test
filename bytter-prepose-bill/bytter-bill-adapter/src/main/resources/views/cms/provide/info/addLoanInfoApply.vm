<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>

        #rateInfo input {
            text-align: right;
        }

        #rateInfo .bt-biz-rateType {
            width: 128px;
        }

        .required {
            color: red;
        }

        .input-def input {
            border: none;
            width: 100%;
            height: 22px !important;
        }

        .input-def span {
            position: absolute;
            right: 4px;
            top: 0px;
        }

        .input-bp input {
            padding-right: 20px !important;
        }

        .input-percent input {
            padding-right: 18px !important;
        }

        .points-proportion-select input {
            width: 100%;
        }
    </style>
</head>
<body>

<input type="hidden" id="configIsHookBond" value="$!{configIsHookBond}">
<input type="hidden" id="configIsOpenRat" value="$!{configIsOpenRat}">
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{cmsProvideLoanInfoPage.id}">
    <input id="myflag" name="myflag" type="hidden" value="0">
    <input id="billCode" name="billCode" type="hidden" value="">
    <!-- 保存状态 -->
    <input id="saveType" name="saveType" type="hidden" value="0">
    ##		保证金相关信息
    <!--保存保证金Id-->
    <input id="bondId" name="bondId" type="hidden">
    <!--当前保证金账户的可用余额-->
    <input id="accAvailMoney" name="accAvailMoney" type="hidden">
    <input type="hidden" id="bondBankId" value=""/>
    <input type="hidden" id="bailMoneyPre" name="bailMoneyPre" value=""/>
    <input type="hidden" id="editFlag" value="0"><!-- 新增数据页面标志-->
    <input type="hidden" id="relateCon" value="$!{relateCon}">##是否对接合同管理参数
    <input type="hidden" id="relateConType" value="$!{relateConType}">##对接合同管理模式
    <input type="hidden" id="conTypeId" name="conTypeId">##合同类型
    <input type="hidden" id="conId" name="conId">##挂接合同时的合同id
    ##银行借款主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.mainMessage')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td colspan="4" style="text-align: center;">
                            <div class="layui-input-inline">
                                <input id="inputDate" name="createDate" value="$!date.format('yyyy-MM-dd',$!inputDate)"
                                       readonly="readonly" autocomplete="off" class="layui-input">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##单位代码
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsProvideLoanInfo.corpId')</td>
                        <td style="width: 35%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-callbackData="corpChange"
                                     data-type="selectTree"
                                     data-resource="cms:loaninfo:apply:edit"
                                     data-name="corpId"
                                     data-biz-name="corpId"
                                     data-scope="all"
                                     data-required="true">
                                </div>
                            </div>
                        </td>
                        ##借款种类
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsProvideLoanInfo.plClass')</td>
                        <td style="width: 35%">
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="plClass"
                                     data-biz-name="plClass"
                                     data-url="${basePath}/cms/provide/loaninfo/queryLoanTypeList"
                                     data-valuefield="code" data-callback="setLoanType"
                                     data-textfield="name" data-required="true"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        #if($!{relateRat} == "1")##先默认不挂授信
                            ##授信模式
                            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.ratmodel')</td>
                            <td>
                                <div class="layui-inline">
                                    <div class="bt-biz-dict" id="radio" data-type="radio" data-group="sf_yn"
                                         data-defaultvalue="1"
                                         data-name="ratmodel" data-biz-name="ratmodel" data-callback="setRatModel">
                                    </div>
                                </div>
                            </td>
                        #end

                        ##借款银行
                        <td class="textRight"><span class="required"><b>*&nbsp;</b></span>#springMessage(
                            'table.cmsProvideLoanInfo.bankId')</td>
                        <td id="dd">
                            <div id="xz">
                                <div class="layui-inline">
                                    <input class="layui-input" id="shouBankName" readonly="readonly" type="text"/>
                                    <div class="bt-div-search">
                                        <button class="bt-biz-bankInfo" type="button" data-callback="bankinfoCallback"
                                                title="#springMessage('common.button.select')"
                                                data-beforeClick="bt.bankInfoBeforeClick">
                                            <i class="layui-icon">&#xe615;</i>
                                        </button>
                                    </div>

                                </div>
                            </div>

                            <div id="xl">
                                <div class="layui-inline">
                                    <div class="bt-biz-selectType" data-name="bankxx"
                                         data-callback="bankinfoCallBackTwo"
                                         data-url="${basePath}/cms/provide/loaninfo/getBankName"
                                         data-valuefield="bankCode" data-textfield="bankName"
                                         data-biz-name="btBank"></div>
                                </div>
                            </div>

                        </td>
                        ##<td colspan="2">
                        <input type="hidden" id="ratmodelValue" value="$!{relateRat}"/>
                        <input type="hidden" id="bankId" name="bankId"/>
                        <input type="hidden" id="bankName" name="bankName" value=""/>
                        <input type="hidden" id="bankTypeName" name="bankTypeName" value=""/>
                        <input type="hidden" id="bankCode" name="bankCode" value=""/>
                        <input type="hidden" id="curName" name="curName" value=""/>
                        <input type="hidden" id="bankType" name="bankType"/>
                        ##</td>
                    </tr>
                    <tr>
                        ##借款金额小写
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plMoneyLow')</td>
                        <td>
                            <input class="layui-input bt-biz-moneyType" data-maxlength="20" data-name="plMoney"
                                   data-toup="plMoneyUpper" lay-verify="required|strlength" data-biz-name="plMoney"
                                   data-callback="setBailMoney" data-decimal="2" data-minus="false" type="text"
                                   placeholder="#springMessage('table.cmsProvideLoanInfo.plMoney')">
                        </td>
                        ##借款金额大写
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plMoneyUpper')</td>
                        <td>
                            <div class="layui-input-inline " id="plMoneyUpper"></div>
                        </td>
                    </tr>
                    <tr>
                        ##借款币种
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.curId')</td>
                        <td>
                            <input type="hidden" id="curId" name="curId" value="">
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="curId"
                                     data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                                     data-textfield="curName" data-callback="chengCur" data-initcallback="initChengCur"
                                     data-required="true" data-biz-name="curId"></div>
                            </div>
                        </td>
                        ##借款期限
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plTerm')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" data-name="plTerm" data-decimal="0" data-biz-name="plTerm"
                                       data-callback="setContractTermByPlTerm" autocomplete="off" readonly="readonly"
                                       class="layui-input bt-biz-moneyType"><!-- readonly="readonly" -->
                            </div>
                            <div class="layui-inline">
                                ##期限单位
                                <div class="bt-biz-dict" data-name="ternUnit" data-type="select"
                                     data-biz-name="ternUnit"
                                     data-callback="computeplTerm" data-group="PrecativeLoanInfo.ternUnit"
                                     data-defaultvalue="M"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##借款日期
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plDate')</td>
                        <td>
                            <!-- lay-verify="required" -->
                            <input id="plDate" name="plDate" value="$!{cmsProvideLoanInfoPage.plDate}"
                                   data-biz-name="plDate"
                                   data-callback="computeplTerm1" data-endid="repayDate" data-type="date"
                                   class="layui-input bt-biz-dateType" lay-verify="required"></input>
                        </td>
                        ##还款日期
                        <td class="textRight">#springMessage('cms.provide.deferred.repayDate')</td>
                        <td>
                            <input id="repayDate" name="repayDate" value="$!{cmsProvideLoanInfoPage.repayDate}"
                                   data-biz-name="repayDate" data-callback="computeplTerm" data-type="date"
                                   class="layui-input bt-biz-dateType" lay-verify="required"></input>
                        </td>
                    </tr>
                    <tr>
##                        计提方式
                        <td class="textRight">#springMessage('table.cmsProvideLoanSend.accrualWay')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="accrualType" data-biz-name="accrualType"
                                     data-url="$basePath/cms/accrual/accrualtype/queryAccrualTypeList"
                                     data-valuefield="id" data-textfield="accrualName"
                                     data-required="true"></div>
                            </div>
                        </td>
                        ##还款方式
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.repayType')</td>
                        <td>
                             ## 取自定义还款方式
                             <div class="layui-inline">
                                 <div class="bt-biz-selectType" data-name="repayType" data-biz-name="repayType"
                                      data-url="$basePath/cms/repay/repaytype/queryRepayTypeList"
                                      data-callback="repayTypeCallBack"
                                      data-valuefield="id" data-textfield="repayName"
                                      data-required="true"></div>
                             </div>
                            <div class="layui-inline">
                                <!-- 还款计划 -->
                                <button class="layui-btn" id="makePlanBtn" type="button" onclick="repayLan();">#springMessage('cms.button.repayPlan')</button>
                                <input type="hidden" id="planId" name="planId">
                                <input type="hidden" id="planStatus" name="planStatus" value="1">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##合同期限
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.contractTerm')</td>
                        <td>
                            <div class="bt-biz-dict" data-name="contractTerm" data-type="select"
                                 data-biz-name="contractTerm"
                                 data-group="Provide.ContractTerm" data-defaultvalue="01" data-required="true"
                                 data-disabled="true"></div>
                        </td>
                        ##借款用途
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plPurpose')</td>
                        <td>
                            <div class=layui-inline>
                                <div class=bt-biz-selectType
                                     data-name="plPurpose"
                                     data-textField="purpose"
                                     data-valueField="purpose"
                                     data-biz-name="plPurpose"
                                     data-url="${basePath}/cms/provide/loaninfo/getPurpose"
                                     data-inputvalue="true"
                                     data-search="true"
                                     data-required="true"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##收款帐号
                        <td class="textRight">#springMessage('table.cmsPrecativeLoanRepay.repayAcc')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="onlinePaymentAcc" id="onlinePaymentAcc" class="layui-input onlinePaymentAcc" data-biz-name="onlinePaymentAcc" > #*clickCallback="setIssuing"*#
                            </div>
                        </td>
                        ##收款帐号名称
                        <td class="textRight">#springMessage('table.cmsPrecativeLoanRepay.repayAccName')</td>
                        <td>
                            <input type="hidden" id="onlinePaymentAccId" name="onlinePaymentAccId"
                                   value="$!{repay.onlinePaymentAccId}">
                            <input id="onlineAccName" name="onlineAccName" value="$!{repay.onlineAccName}"
                                   class="layui-input"
                                   type="text" readonly="readonly"
                                   placeholder="#springMessage('table.cmsProvideLoanRepay.onlinePaymentAccName')"/>
                        </td>
                    </tr>
                    <tr>
                        ##收款开户行名称
                        <td class="textRight">#springMessage('table.cmsPrecativeLoanRepay.repayAcc.bankName')</td>
                        <td>
                            <input id="onlineBankName" name="onlineBankName" value="$!{repay.onlineBankName}"
                                   class="layui-input" type="text" readonly="readonly"
                                   placeholder="#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc.bankName')"/>
                        </td>
                        ##是否自动还款
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.isAutoPay')</td>
                        <td>
                            <div class="layui-inline">
                                #if($!{budgetConfig} == "1")
                                    <div class="bt-biz-dict" id="radio" data-type="radio" data-group="sf_yn"
                                         data-defaultvalue="0" data-disabled="true"
                                         data-name="isAutoPay" data-biz-name="isAutoPay">
                                    </div>
                                #else
                                    <div class="bt-biz-dict" id="radio" data-type="radio" data-group="sf_yn"
                                         data-defaultvalue="0"
                                         data-name="isAutoPay" data-biz-name="isAutoPay">
                                    </div>
                                #end
                            </div>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                        <td colspan="3">
                    <textarea type="text" id="rmk" name="rmk" class="layui-textarea"
                              placeholder="#springMessage('table.cmsProvideLoanInfo.rmk')"></textarea>
                        </td>
                    </tr>
                    </tbody>
                </table>
                </table>
            </div>
        </div>
    </div>
    ##银行借款利率信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.rateMessage')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##浮动方式
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.floatWay')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-dict" data-name="floatWay" data-type="select"
                                     data-biz-name="floatWay"
                                     data-callback="setNextDetail" data-group="Cms.FloatWay" data-defaultvalue="01"
                                     data-required="true"></div>
                            </div>
                            <div class="layui-inline" id="nextDetail">
                            </div>
                        </td>
                        ##利率调整生效日期
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rateEntriesEffectDate')</td>
                        <td>
                            <input id="rateEntriesEffectDate"
                                   name="rateEntriesEffectDate"
                                   value="$!{cmsProvideLoanInfoPage.rateEntriesEffectDate}"
                                   readonly="readonly"
                                   data-biz-name="rateEntriesEffectDate"
                                   class="layui-input bt-biz-dateType"
                                   data-type="date"/>
                        </td>
                    </tr>
                    <tr class="">
                        ##浮动利率
                        <td class="textRight "><font color="red">*</font>#springMessage(
                            'table.cmsProvideLoanInfo.floatRate')
                        </td>
                        <td class="ignore-required-icon">
                            <div class="layui-inline ">
                                <div style="padding-bottom: 10px;padding-top: 10px;">
                                    <div class="layui-inline">
                                        ##基准利率类型
                                        <div class="bt-biz-selectType"
                                             data-name="referenceRateType"
                                             data-url=""
                                             data-valuefield="baseRateId"
                                             data-textfield="baseRateName"
                                             data-callback="loanRepayCycle"
                                             data-initcallback="loanRepayCycle"
                                             data-defaultvalue="first"
                                             data-biz-name="referenceRateType">
                                        </div>
                                    </div>
                                    <div class="layui-inline">
                                        ##利率类型的生效日期 rateEntriesEffectDate2
                                        <input id="rateQuotedPriceDate"
                                               name="rateQuotedPriceDate"
                                               value="$!{cmsProvideLoanInfoPage.rateEntriesEffectDate}"
                                               data-callback="changeRateQuotedPriceDate"
                                               data-biz-name="rateQuotedPriceDate"
                                               class="layui-input bt-biz-dateType"
                                               data-type="date"/>
                                    </div>
                                </div>
                                <div style="padding-bottom: 10px;padding-top: 10px;">
                                    <div class="layui-inline">
                                        ##贷款周期
                                        <div class="bt-biz-selectType"
                                             data-name="repayCycle"
                                             data-url=""
                                             data-valuefield="creditPeriodId"
                                             data-textfield="creditPeriodName"
                                             data-callback="loadrepayCycle"
                                             data-initcallback="loadrepayCycle"
                                             data-defaultvalue="first"
                                             data-biz-name="repayCycle">
                                        </div>
                                    </div>
                                </div>

                                <div style="padding-bottom: 10px;padding-top: 10px;">
                                    ##点数或者浮动比例选择与文本
                                    <div style="display: inline">
                                        <div class="bt-biz-dict points-proportion-select"
                                             data-name="pointsProportionSelect" data-type="select"
                                             data-group="Cms.PointsProportion" data-defaultvalue="01"
                                             data-biz-name="pointsProportionSelect"
##                                             data-disabled="true"
                                             data-callback="pointsProportionCallback"
                                             style="width: 50%"></div>
                                    </div>
                                    <div class="layui-inline input-def" id="numUnit">
                                        <div class="pl rateWrap" style="width:100px">
                                            <input class="layui-input bt-biz-moneyType" id="pointsProportionText"
                                                   name="pointsProportionText" data-callback="getRate"
                                                   data-biz-name="pointsProportionText" value="0" data-decimal="2"
                                                   data-max="100"
                                                   data-min="-100" data-minus="true">
                                            <span name="percentsymbol" class="inputMark" id="inputMark"></span>
                                        </div>
                                    </div>
                                    <div class="layui-inline" id="nextDetail">
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td colspan="2" align="center">
                            <table class="layui-table" id="rateInfo" style="width: 90%">
                                <tr>
                                    <td width="15%" align="right">#springMessage(
                                        'table.cmsProvideLoanInfo.rateBase')</td>
                                    <td width="80%" align="left" colspan="3">
                                        ##利息测算基数
                                        <div class="bt-biz-dict" data-name="rateBase" data-type="radio"
                                             data-group="Cms.RateBase" data-callback="setInterestFee"
                                             data-defaultvalue="360"></div>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="18%" align="right">#springMessage('table.cmsProvideLoanInfo.plRate')</td>
                                    <td width="27%" align="left">
                                        <div class="layui-inline">
                                            ##借款利率
                                            <input type="text" data-name="plRate" value="0" lay-verify="required"
                                                   data-callback="setInterestFee" data-biz-name="plRate" data-width="100"
                                                   class="layui-input bt-biz-rateType"
                                                   placeholder="#springMessage('table.cmsProvideLoanInfo.plRate')">
                                        </div>
                                        <div class="layui-inline">
                                            <button type="button" id="getRate"
                                                    class="layui-btn layui-btn-mini">#springMessage(
										'cms.provide.getRate')</button>
                                        </div>
                                    </td>
                                    <td width="18%" align="right">
                                        #springMessage('table.cmsProvideLoanInfo.anticInterest')
                                    </td>
                                    <td width="32%" align="left">
                                        ##预计利息
                                        <input type="text" data-name="anticInterest" value="0"
                                               data-biz-name="anticInterest"
                                               data-callback="setInterestFee5" class="layui-input bt-biz-moneyType"
                                               placeholder="#springMessage('table.cmsProvideLoanInfo.anticInterest')">
                                    </td>
                                </tr>
                                <tr>
                                    <td width="18%" align="right">#springMessage(
                                        'table.cmsProvideLoanInfo.compositeFeeRate')</td>
                                    <td width="27%" align="left">
                                        ##综合成本年化利率
                                        <input type="text" data-name="compositeFeeRate" value="0"
                                               data-biz-name="compositeFeeRate" class="layui-input bt-biz-rateType"
                                               data-width="100"
                                               placeholder="#springMessage(
                                                   'table.cmsProvideLoanInfo.compositeFeeRate')">
                                    </td>
                                    <td width="18%" align="right">
                                        #springMessage('table.cmsProvideLoanInfo.compositeFee')
                                    </td>
                                    <td width="32%" align="left">
                                        ##综合成本
                                        <input type="text" data-name="compositeFee" value="0"
                                               data-biz-name="compositeFee" class="layui-input bt-biz-moneyType"
                                               placeholder="#springMessage('table.cmsProvideLoanInfo.compositeFee')">
                                    </td>
                                </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        ##基准利率
                        <td class="textRight ">#springMessage('table.tbLoanRateMaintence.rate')</td>
                        <td>
                            <input  type="text" id="benchmarkRate" value=""	data-name="benchmarkRate" data-biz-name="benchmarkRate"	class="layui-input bt-biz-rateType" readonly>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    ##银行借款办理信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('银行借款办理信息')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        <td class="textRight" style="width: 15%">#springMessage('cms.loaninfo.isover.repair')</td>
                        <td style="width: 35%">
                            <div class="layui-inline">##是否跳过补录功能
                                <div class="bt-biz-dict" id="radio" data-type="radio" data-group="sf_yn"
                                     data-defaultvalue="0" data-required="true"
                                     data-name="isOverRepair" data-biz-name="isOverRepair" onclick="changeOverRepair()">
                                </div>
                            </div>
                        </td>
                        <td style="width: 15%"></td>
                        <td style="widt: 35%"></td>
                    </tr>
                    <tr style="display: none" class="isOver">
                        ##借款合同号
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.contractNo')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" id="contractNo" name="contractNo" value="$!{loanInfo.contractNo}"
                                       lay-verify="required" class="layui-input"
                                       placeholder="#springMessage('table.cmsProvideLoanInfo.contractNo')"/>
                            </div>
                            #if($!{relateCon}=="1"&&$!{relateConType}=="1")##对接合同且合同对接管理模式选择银行借款调用合同
                                ##选择合同按钮
                                <div class="layui-input-inline">
                                    <div id="conChooseBtn">
                                        <button
                                                type="button"
                                                class="layui-btn bt-biz-conSelect"
                                                data-beforeClick="bt.conSelectParams"
                                                data-callback="bt.conSelectCallback"
                                        >#springMessage('common.button.select')</button>
                                    </div>
                                </div>
                                ##查看合同按钮
                                <div class="layui-input-inline viewConBtn" style="display:none">
                                    <div class="layui-inline">
                                        <button
                                                type="button"
                                                class="layui-btn bt-biz-conView"
                                                data-beforeClick="bt.conViewParams"
                                                data-callback="bt.conViewParams"
                                        >#springMessage('common.button.view')</button>

                                    </div>
                                </div>
                            #end
                        </td>
                        ##付息方式
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.cplInterestPayment')</td>
                        <td>
                            #if("$!loanInfo.cplInterestPayment" == "")
                                #set($cplInterestPayment = "01")
                            #else
                                #set($cplInterestPayment = $loanInfo.cplInterestPayment)
                            #end
                            ##判断是否为固定利率
                            ##                            #if("$!{loanInfo.floatWay}" == "01")
                            <div class="bt-biz-dict" data-name="cplInterestPayment"
                                 data-defaultvalue="$!{cplInterestPayment}" data-type="select"
                                 data-group="provide.payInterest" data-biz-name="cplInterestPayment"></div>
                            ##                            #else
                            ##                                <div class="bt-biz-dict" data-name="cplInterestPayment" data-defaultvalue="$!{cplInterestPayment}" data-type="select" data-group="provide.payInterest" data-biz-name="cplInterestPayment" data-disabled="true"></div>
                            ##                            #end
                        </td>
                    </tr>
                    <tr style="display: none" class="isOver">
                        ##借款发放方式
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.loanSendOutType')</td>
                        <td>
                            #if("$!loanInfo.loanSendOutType" == "")
                                #set($loanSendOutType = "1")
                            #else
                                #set($loanSendOutType = $loanInfo.loanSendOutType)
                            #end
                            <div class="bt-biz-dict" data-name="loanSendOutType" data-defaultvalue="$!{loanSendOutType}"
                                 data-required="true" data-type="select" data-group="cms.loan.loanSendOutType"
                                 data-biz-name="loanSendOutType" data-callback="loadAcrossSend"></div>
                        </td>
                        #if("$!loanSendOutType" == "1")
                            ##跳过借款发放功能
                            <td id="acrossSendShow" class="textRight">#springMessage(
                                'table.cmsProvideLoanInfo.acrossSend')</td>
                            <td id="acrossSendSelect">
                                <div class="bt-biz-dict" data-name="acrossSend" data-value="$!{loanInfo.acrossSend}"
                                     data-defaultvalue="0" data-required="true" data-type="radio"
                                     data-biz-name="acrossSend"
                                     data-callback="changeAcrossSend" data-group="sf_yn"></div>
                            </td>
                        #else
                            <td id="acrossSendShow" class="textRight">
                        <td id="acrossSendSelect">
                        #end
                    </tr>
                    <tr style="display: none" class="isOver">
                        ##展期利率
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.deferredRate')</td>
                        <td>
                            <div class="layui-inline" id="deferred" style="display: none;">
                                #springMessage('cms.loanInfo.deferredPoints')
                                <div class="pl rateWrap layui-inline" style="width:104px;margin-right: 5px">
                                    <input class="layui-input bt-biz-moneyType input-inline textRight"
                                           id="deferredPoints"
                                           name="deferredPoints" data-callback="setDeferredRate"
                                           data-max="100"
                                           data-min="0"
                                        #if($!{loanInfo.deferredPoints})
                                           value="$!{loanInfo.deferredPoints}"
                                        #else
                                           value="0"
                                        #end
                                           data-biz-name="deferredPoints"
                                           data-decimal="2" data-minus="true"
                                           style="border: none; width: 80px;"
                                    >
                                    <span name="percentsymbol" class="inputMark">BP</span>
                                </div>
                            </div>
                            <div class="layui-inline">
                                <input type="text" data-name="deferredRate" value="$!{loanInfo.deferredRate}"
                                       class="layui-input bt-biz-rateType" data-biz-name="deferredRate"
                                       placeholder="#springMessage('table.cmsProvideLoanInfo.deferredRate')">
                            </div>
                        </td>
                        ##逾期利率
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.overdueRate')</td>
                        <td>
                            <div class="layui-inline" id="overdue" style="display: none;">
                                #springMessage('cms.loanInfo.overdueProportion')
                                <div class="pl rateWrap layui-inline" style="width:104px;margin-right: 5px">

                                    <input class="layui-input bt-biz-moneyType input-inline textRight"
                                           id="overdueProportion"
                                           name="overdueProportion" data-callback="setOverdueRate"
                                           data-initcallback="setOverdueRate"
                                           data-max="100"
                                           data-min="0"
                                        #if($!{loanInfo.deferredPoints})
                                           value="$!{loanInfo.overdueProportion}"
                                        #else
                                           value="0"
                                        #end
                                           data-biz-name="overdueProportion"
                                           data-decimal="2" data-minus="true"
                                           style="border: none; width: 80px;"
                                    >
                                    <span name="percentsymbol" class="inputMark">%</span>
                                </div>
                            </div>
                            <div class="layui-inline">
                                <input type="text" data-name="overdueRate" value="$!{loanInfo.overdueRate}"
                                       class="layui-input bt-biz-rateType" lay-verify="required"
                                       data-biz-name="overdueRate"
                                       placeholder="#springMessage('table.cmsProvideLoanInfo.overdueRate')">
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    ##第三方费用信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.chargeMessage')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        <td align="center" width="80">
                            ##新加的
                            <table id="dataTable" class="layui-table">
                                <thead>
                                <th width="25%">#springMessage('table.fcChargeRule.fcChargeType')</th>##费用类型
                                <th width="25%"> #springMessage('table.guaGuarantee.handleRate')</th>##费率
                                <th width="25%">#springMessage('table.cms.projected.expemditure')</th>##预计费用
                                <th width="25%">#springMessage('common.table.thead.operation')</th>##操作
                                </thead>
                                <tbody>
                                <tr data-row="0">
                                    <td width="20%" align="center">
                                        <div class="layui-inline">
                                            <div class="bt-biz-selectType" data-biz-name="costTypeDtl[0]costCode"
                                                 id="costCode0"
                                                 data-url="${basePath}/cms/dfCostType/getValidDfCostType"
                                                 data-valuefield="id" data-textfield="costName" id="costCode0"
                                                 data-name="costTypeDtl[0].costTypeId" data-search="true"
                                                 data-link="true" data-callback="setItemCode">
                                            </div>
                                        </div>
                                    </td>

                                    <td width="15%" align="center">##费率
                                        <input type="text" id="rate0" data-name="costTypeDtl[0].rate"
                                               data-biz-name="costTypeDtl[0]rate" data-callback="setInterestFee1"
                                               autocomplete="off" class="layui-input bt-biz-rateType">
                                    </td>

                                    <td width="15%" align="center">##预计费用
                                        <input type="text" id="advanceFees0" data-name="costTypeDtl[0].advanceFees"
                                               data-biz-name="costTypeDtl[0]advanceFees" data-callback="setInterestFee4"
                                               autocomplete="off" class="layui-input bt-biz-moneyType">
                                    </td>

                                    <td width="10%" align="center">
                                        <a href="javascript:void(0);" title="#springMessage('common.addTr')"
                                           onClick="addTr()"><i class="layui-icon">&#xe654;</i></a>
                                    </td>
                                </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    ##银团明细信息
    <div class="layui-collapse" style="display: none" id="syndicatedShow">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsLoanInfo.syndicated')</h2>
            <div class="layui-colla-content layui-show">
                <br>
                <button class="layui-btn" type="button" onclick="addSy()">#springMessage(
                            'common.addTr')</button>
                <button class="layui-btn" type="button" onclick="importExcel()">#springMessage(
                    'common.button.imports')</button>
                <table class="layui-table">
                    <tr>
                        <td>
                            <table id="dataTableSy" class="layui-table">
                                <thead>
                                <th>#springMessage('table.cmsLoanInfo.leadingBank')</th>##是否牵头行
                                <th><span class="pl"><span
                                        class="required-icon">*</span></span>#springMessage(
                                    'table.cmsLoanInfo.bankCode')</th>##银行开户行号
                                <th><span class="pl"><span
                                        class="required-icon">*</span></span>#springMessage(
                                    'table.cmsLoanInfo.bankName')</th>##银行名称
                                <th><span class="pl"><span
                                        class="required-icon">*</span></span>#springMessage(
                                    'table.cmsLoanInfo.commitmentShare')</th>##承贷份额%
                                <th><span class="pl"><span
                                        class="required-icon">*</span></span>#springMessage(
                                    'table.cmsLoanInfo.commitmentMoney')</th>##承贷金额
                                <th>#springMessage('table.cmsLoanInfo.rmk')</th>##备注
                                <th>#springMessage('common.table.thead.operation')</th>##操作
                                </thead>
                                <tbody id="dataTableSyBody" class="layui-form ignore-required-icon">
                                </tbody>
                                <tfoot>
                                <tr>
                                    <td>#springMessage('table.interet.sum')</td>
                                    <td>&nbsp;</td>
                                    <td>&nbsp;</td>
                                    <td style="width: 165px">
                                        <div class="layui-inline">
                                            <input type="text" style="border:none;width: 150px"
                                                   data-name="commitmentShareSum" data-biz-name="commitmentShareSum"
                                                   readonly="readonly" class="layui-input bt-biz-moneyType">
                                        </div>
                                        <div class="layui-inline">
                                            %
                                        </div>
                                    </td>
                                    <td style="width: 165px">
                                        <div class="layui-inline">
                                            <input type="text" style="border:none;width: 100%"
                                                   data-name="commitmentMoneySum"
                                                   data-biz-name="commitmentMoneySum" readonly="readonly"
                                                   class="layui-input bt-biz-moneyType">
                                        </div>
                                    </td>
                                    <td>&nbsp;</td>
                                    <td>&nbsp;</td>
                                </tr>
                                </tfoot>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    ##其他业务挂接信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.otherBusMessage')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <tbody>
                        #if($!{configIsHookBond} == "1")
                            ##增加保证金相关信息
                            #parse("views/dual/manager/bondInfo.vm")
                        #end

                        #if($!{configIsOpenRat} == "1"&&$!{configIsHookBond} == "1")##挂接授信且挂接保证金的情况下可以选择是否启用敞口授信
                        <tr class="ratInfo">
                            ##授信敞口
                            <td class="textRight">#springMessage('common.isOpen.ratUration')</td>
                            <td>
                                <div class="layui-inline">
                                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                         data-defaultvalue="1" data-name="isOpenRat" data-biz-name="isOpenRat"></div>
                                </div>
                            </td>
                            <td></td>
                            <td></td>
                        </tr>
                        #end
                        #if($!{relateRat} == "1")
                            ##授信信息
                            #parse("views/dual/manager/ratInfo.vm")
                        #end

                        ##担保挂接
                        #if($!{isGuarantee}=="1")
                            #parse("views/common/guaContractChoose.vm")
                        #end

                        ##抵质押物挂接
                        #if($!{pledgeConfig}=="1")
                            #parse("views/cms/guarantee/guaPledgeCommon.vm")
                        #end
                    <tr>
                        <td class="textRight">#springMessage('cms.loan.attachment')</td>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input id="annexName" name="uploadId" type="hidden" value="">
                            <div id="uploader" class="layui-input-inline" style="width:100%;text-align: left">
##                                <span style="color: red;font-size: medium;margin-left:20px;height: 35px;display: inline-block;line-height: 35px;">请上传借款合同和收款回单</span>
                            </div>

                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: center;" colspan="4">
                            <button class="layui-btn" lay-submit="" id="submit">#springMessage(
                                'common.button.submit')</button>
                            <button class="layui-btn" lay-submit="" id="temp">#springMessage(
                                'common.button.temp')</button>
                            <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                'common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>

                <!--预算-->
                <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
                <input id="sendItem" name="sendItem" type="hidden" value="$!{sendItem}">
                <input id="defItemCode" name="defItemCode" type="hidden" value="$!{defItemCode}">
                <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
                <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
                <div id="tagItemDetail"></div>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>

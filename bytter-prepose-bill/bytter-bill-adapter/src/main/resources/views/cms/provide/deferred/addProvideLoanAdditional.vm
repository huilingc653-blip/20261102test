<form class="layui-form">
  <table class="layui-table">
        <tbody>
          <tr>
            ##补录信息(办理失败)
        <td colspan="6" style="text-align: center;">#springMessage('cms.provide.deferred.failure')</td>
      </tr>
          <tr>
            ##打回原因
              <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.refuseWhy')</td>
              <td colspan="3">
                    <textarea id="refuseWhy"  style="min-height:70px" lay-verify="required"
                  class="layui-textarea"></textarea>
              </td>
            </tr>
      <tr>
        	 <td colspan="6" style="text-align: center;">
              	<button class="layui-btn" lay-submit="" lay-filter="back" value="-1">#springMessage('common.button.back')</button>
       		</td>
      </tr>
    </tbody>
    </table>

</form>

	#parse("views/common/footer.vm")
</body>

<script
	src="${basePath}/static/modules/cms/provide/porvideLoanAdditional.add.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{abolish.id}">
			<iframe src="${basePath}/cms/provide/loansend/view/$!{billCode}" id="sendIframe" frameborder="0" scrolling="no" style="width: 100%;margin: 0px;"></iframe>


        <table class="layui-table">
			<tbody>
				<input name="pliCode" type="hidden" value="$!{info.billCode}"/>
				<input name="corpId" type="hidden" value="$!{info.corpId}"/>
				<input name="loanDate" type="hidden" value="$date.format('yyyy-MM-dd',$!{info.createDate})"/>

        		<tr>
        			##作废申请日期
					<td class="textRight">#springMessage('table.fcOutAccbook.invalidOpTime'):</td>
					<td colspan="3">
						$date.format('yyyy-MM-dd',$!date)
					</td>
				</tr>

        		<tr>
        			##作废原因
					<td class="textRight">#springMessage('table.fcOutAccbook.invalidReason')</td>
					<td colspan="3">
						<div class="layui-form-item layui-form-text" style="margin-bottom:0px;padding-right:600px;">
   					    	<textarea name="rmk" placeholder="#springMessage('sys.resource.contentShow')" class="layui-textarea" style="min-height:70px" lay-verify="required" >$!{abolish.rmk}</textarea>
    					</div>
					</td>
        		</tr>

        		<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
						<button id="close" class="layui-btn" type="button" >#springMessage('common.button.revert')</button>
					</td>
				</tr>


        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/provide/cmsProvideLoanAbolish.add.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
</html>

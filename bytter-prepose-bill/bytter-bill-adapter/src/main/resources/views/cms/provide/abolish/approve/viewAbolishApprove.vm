<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
	<iframe src="${basePath}/cms/provide/loansend/view/$!{abolish.pliCode}" id="sendIframe" frameborder="0" scrolling="no" style="width: 100%;"></iframe>
	<script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
	<table class="layui-table breakRow">
	<tbody>
		<tr>
	    	##作废申请日期
			<td class="textRight" width="14%">#springMessage('table.fcOutAccbook.invalidOpTime'):</td>
			<td colspan="3" width="86%">
				$!date.format('yyyy-MM-dd',$!abolish.abolishedDate)
			</td>
		</tr>
	    <tr>
	    	##作废原因
			<td class="textRight">#springMessage('table.fcOutAccbook.invalidReason')</td>
			<td colspan="3">
				<div class="layui-form-item layui-form-text" style="margin-bottom:0px;padding-right:500px;">
					$!{abolish.rmk}
				</div>
			</td>	
		</tr>
	</tbody>
	</table>
	
    #workFlowHtml()
	#parse("views/common/footer.vm")
	#workFlowScript()
</body>
<script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
</html>
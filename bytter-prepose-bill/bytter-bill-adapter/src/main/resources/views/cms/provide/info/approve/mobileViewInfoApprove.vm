<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
	<ul class="mui-table-view" id="mulTable">
		<li class="mui-table-view-divider">
       		#springMessage("cms.provide.info")
    	</li>
		##录入日期
		<li class="mui-table-view-cell">
        	#springMessage('table.cmsProvideLoanAbolish.loanDate')
	        <span class="mui-badge mui-badge-inverted">
	            $!date.format('yyyy-MM-dd',$!loanInfo.createDate)
	        </span>
    	</li>
    	##借款单号
    	<li class="mui-table-view-cell">
      		#springMessage('table.cmsProvideLoanInfo.billCode')
	        <span class="mui-badge mui-badge-inverted">
	            $!{loanInfo.billCode}
	        </span>
    	</li>
    	##申请单位
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.corpId')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.corpName}
			</span>
		</li>
		##借款种类
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.plClass')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.plClassName}
			</span>
		</li>
		##银行种类
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.bankType')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.bankTypeName}
			</span>
		</li>
		##借款银行
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.bankId')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.bankName}
			</span>
		</li>
		##借款金额小写
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.plMoneyLow')
			<span class="mui-badge mui-badge-inverted">
				$!number.formatNumeric($!{loanInfo.plMoney})
			</span>
		</li>
		##借款金额大写
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.plMoneyUpper')
			<span class="mui-badge mui-badge-inverted">
				$!{plMoneyUpper}
			</span>
		</li>
		##借款币种
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.curId')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.curName}
			</span>
		</li>
		##借款期限
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.plTerm')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.plTerm} $!{loanInfo.ternUnitName}
			</span>
		</li>
		##借款日期
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.plDate')
			<span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!loanInfo.plDate)
			</span>
		</li>
		##还款日期
		<li class="mui-table-view-cell">
			#springMessage('cms.provide.deferred.repayDate')
			<span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!loanInfo.repayDate)
			</span>
		</li>
		##借款用途
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.plPurpose')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.plPurpose}
			</span>
		</li>
		##合同期限
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.contractTerm')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.contractTermName}
			</span>
		</li>
		##还款方式
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.repayType')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.repayTypeName}
			</span>
		</li>
		##备注
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.rmk')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.rmk}
			</span>
		</li>
		##创建人
		<li class="mui-table-view-cell">
			#springMessage('table.sysAttachment.createBy')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.createName}
			</span>
		</li>
	#if("$!{loanInfo.contractNo}" != "")
		##借款合同号
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.contractNo')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.contractNo}
			</span>
		</li>
		##发放方式
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.loanSendOutType')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.loanSendOutTypeName}
			</span>
		</li>
		##付息方式
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.cplInterestPayment')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.cplInterestPaymentName}
			</span>
		</li>
		##计息方式
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.interestWay')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.interestWayName} 
				#if("$!{loanInfo.expiryDate}" != "") 
					#springMessage('table.cmsProvideLoanSend.expiryDate')
					$!{loanInfo.expiryDate}
				#end
				#if("$!{loanInfo.accruedDailyDate}" != "") 
					#springMessage('table.cmsProvideLoanSend.accruedDailyDate')
					$!{loanInfo.accruedDailyDate}
				#end
			</span>
		</li>
	#end
		##浮动方式
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.floatWay')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.floatWayName}
			</span>
		</li>
		##利率调整生效日期
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.rateEntriesEffectDate')
			<span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!loanInfo.rateEntriesEffectDate)
			</span>
		</li>
		##浮动利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.floatRate')(#springMessage('table.cmsLoanType.type'))
			<span class="mui-badge mui-badge-inverted">
				##基准利率类型
				$!{loanInfo.referenceRateTypeName}
			</span>
		</li>
		##浮动利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.floatRate')(#springMessage('table.cmsLoanInfo.ternUnit'))
			<span class="mui-badge mui-badge-inverted">
				##贷款周期
				$!{loanInfo.repayCycleName}
			</span>
		</li>
		##浮动利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.floatRate')(#springMessage('table.cmsLoanInfo.pointsProportionSelect'))
			<span class="mui-badge mui-badge-inverted">
				##点数或者浮动比例选择与文本
				$!{loanInfo.pointsProportionSelectName} $number.formatNumeric($!{loanInfo.pointsProportionText})
			</span>
		</li>
		##借款利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.plRate')
			<span class="mui-badge mui-badge-inverted">
				$rateTag.show($!{loanInfo.plRate})
			</span>
		</li>
	#if("$!{loanInfo.contractNo}" != "")
		##逾期利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.overdueRate')
			<span class="mui-badge mui-badge-inverted">
				$rateTag.show($!{loanInfo.overdueRate})
			</span>
		</li>
		##展期利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.deferredRate')
			<span class="mui-badge mui-badge-inverted">
				$rateTag.show($!{loanInfo.deferredRate})
			</span>
		</li>
	#end

	#if($!{configIsHookBond} == "1")
	##是否挂保证金
		<li class="mui-table-view-cell">
			#springMessage('table.fcBond.includeBond')
			<span class="mui-badge mui-badge-inverted">
				$dictTag.get("sf_yn",$!{isHookBond})
			</span>
		</li>
	##                    保证金额度单
		#if($!{isHookBond} == 1)
			<li class="mui-table-view-cell">
				#springMessage('table.fcBond.quotas')
				<span class="mui-badge mui-badge-inverted">
					$!{bondBankAcc}
				</span>
			</li>
		#end
	##保证金比例
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.bailmoneyRate')
			<span class="mui-badge mui-badge-inverted">
				$rateTag.show($!{loanInfo.bailmoneyRate})
			</span>
		</li>
	##保证金
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.bailmoney')
			<span class="mui-badge mui-badge-inverted">
				$!number.formatNumeric($!{loanInfo.bailmoney})
			</span>
		</li>
	##保证金合同号
		<li class="mui-table-view-cell">
			#springMessage('table.fcBond.contractNum')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.bailmoneyContract}
			</span>
		</li>
	#end
	##授信
#if($!{relateRat} == "1")
	##是启用授信
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.ratmodel')
			<span class="mui-badge mui-badge-inverted">
				$dictTag.get("sf_yn",$!{loanInfo.ratmodel})
			</span>
		</li>
	#if($!{isOpenRat} == "1" && $!{loanInfo.ratmodel} == "1")
	##是启用授信敞口
		<li class="mui-table-view-cell">
			#springMessage('common.isOpen.ratUration')
			<span class="mui-badge mui-badge-inverted">
				$dictTag.get("sf_yn",$!{loanInfo.isOpenRat})
			</span>
		</li>
	#end
	#if($!{loanInfo.ratmodel} == "1")
		##是否折合成本位币
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.isRmbRat')
			<span class="mui-badge mui-badge-inverted">
				$dictTag.get("sf_yn",$!{loanInfo.isRmbRat})
			</span>
		</li>
		##保存当前币种转换汇率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.exchangerate')
			<span class="mui-badge mui-badge-inverted">
				$!excRateTag.getConvert($!{loanInfo.exchangerate})
			</span>
		</li>
		##授信品种
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.itemCode')
			<span class="mui-badge mui-badge-inverted">
				$!{urationDTO.ratItemName}
			</span>
		</li>
	##业务品种
		<li class="mui-table-view-cell">
			#springMessage('cms.business.race')
			<span class="mui-badge mui-badge-inverted">
				$!{urationDTO.raceName}
			</span>
		</li>
	#end
#end
	##            是否挂担保
		<li class="mui-table-view-cell">
			#springMessage('rat.Is.bkration.gua')
			<span class="mui-badge mui-badge-inverted">
				$dictTag.get("sf_yn",$!{loanInfo.isHangGuarantee})
			</span>
		</li>
		#if($!{lcEnrol.isHangGuarantee} == 1)
		##                    担保合同
			<li class="mui-table-view-cell">
				#springMessage('table.ratBkration.guaContract')
				<span class="mui-badge mui-badge-inverted">
					$!{guaConstractCode}
				</span>
			</li>

		##                    担保方式
			<li class="mui-table-view-cell">
				#springMessage('table.guaContract.guaType')
				<span class="mui-badge mui-badge-inverted">
					$!{guaWayNames}
				</span>
			</li>

		##                担保备注
			<li class="mui-table-view-cell">
				#springMessage('table.cmsProvideLoanInfo.itemCode')
				<span class="mui-badge mui-badge-inverted">
					$!{loanInfo.guaranteeRmk}
				</span>
			</li>
		#end

	## 挂接资金计划
		#if($!{budgetSel} == 1)
			#if($!{loanInfo.acrossSend} == 1)
				#set($fbsBudgetItemDetail = $fbsBudgetTag.getViewItemDetailMobile($!{loanInfo.billCode}, "", $!{businessName}, $!{processSysname},$!{loanInfo.corpId}, $!{ProcessDate}))
				#parse("views/budget/fbsbudget.vm")
			#end
		#end
	</ul>
	#parse("views/common/wapfooter.vm")
</body>
</html>

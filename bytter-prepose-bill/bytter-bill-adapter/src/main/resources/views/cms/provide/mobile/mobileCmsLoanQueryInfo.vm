<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
      <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no,minimum-scale=1.0,maximum-scale=1.0">
          <script type="text/javascript">var basePath = "${basePath}";var basePathAll=window.location.protocol+"//"+window.location.host+basePath;</script>
  #set($resourceVersion=$resourceVersion.get())
  #set($basePath=$springMacroRequestContext.contextPath)
  <title>借款详情</title>
  <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css" />
  <link rel="stylesheet" href="${basePath}/static/modules/bill/accebill/lib/index.css" />
  <style>
     html {
            font-size: 26.66667vw;
        }

        .cho-body {
            background-color: #F5F5F5;
        }

        .cho-border {
            border-top: 1px solid #EDEDED;
            padding: 0.1rem 0;
            padding-bottom: 0;
        }

        #tab {
            background: rgba(255, 255, 255, 1);
        }

        .cho-panel-view-item .cho-panel-item-title {
            font-size: 0.16rem;
            font-family: PingFangSC-Semibold, PingFang SC;
            font-weight: 600;
            color: rgba(51, 51, 51, 1);
            line-height: 0.22rem;
            padding: 0.1rem 0.26rem;
        }

        .cho-panel-item-money-left {
            font-size: 0.24rem;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(228, 70, 29, 1);
            padding: 0.02rem 0.26rem;
            padding-bottom: 0
        }

        .cho-panel-item-font-left {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.17rem;
            padding: 0.02rem 0.26rem;
            padding-bottom: 0.12rem;
        }

        .cho-panel-item-money-right {
            font-size: 0.18rem;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(51, 51, 51, 1);
            padding: 0.06rem 0.02rem;;
            padding-bottom: 0;
        }

        .cho-panel-item-font-right {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.17rem;
            padding: 0.06rem 0.02rem;
            padding-bottom: 0.12rem;
        }

        .box-border{
            padding: 0 0.15rem;
        }

        .cho-panel-item-date{
            font-size:0.16rem;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(51,51,51,1);
            line-height: 0.27rem;
            height: 0.27rem;
        }
        .cho-panel-day {
            font-size:0.18rem;
            font-family:PingFangSC-Semibold,PingFang SC;
            font-weight:600;
            color:#C7A277;
        }
        .cho-panel-item-date-font{
            font-size: 12px;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.17rem;
            padding: 0.04rem 0;
            padding-bottom: 0.1rem
        }
        .pt-info-sum{
            font-size: 0.22rem;
            font-family: DIN Alternate Bold;
           	font-weight: bold;
            color:#333333;
        }
        .pt-info-font{
            font-size: 0.16rem;
            font-family: 苹方-简 中黑体;
           	font-weight: bold;
            color:#999999;
        }

        #tab1 {
            background: rgba(255, 255, 255, 1);
        }

        #tab1 .cho-content-item {
            background: rgba(255, 255, 255, 1);
/*             border-top: 1px solid #EDEDED; */
        }

        #tab1 .cho-content-item-title-left {
            font-size: 14px;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(153, 153, 153, 1);
            line-height: 14px;
            padding-top: 0.14rem;
            padding-left: 0.16rem;
        }

        #tab1 .cho-content-item-money-left {
            min-height: 16px;
            font-size: 14px;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(51, 51, 51, 1);
            line-height: 14px;
            padding-top: 0.14rem;
            padding-right: 0.2rem;
        }
    </style>
  </style>
</head>
<body>
 <section class=" ui-container">
    <section id="tab">
			        <div class="cho-panel-view-item ui-border-b" style="width: 100%;">
			           <table width="100%" class="ui-border-b" style="table-layout:fixed; left:0.1rem;right:0.1rem; margin:0.12rem 0.12rem;">
				           	<tbody class="sp_tab_tbody" style="height: 100%;">
				           		<tr style="height:100%;">
				           			<td style="width: 2.68rem;word-wrap:break-word;"> $!{vo.corpName}</td>
				           			<td style="padding-left:0.4rem; width: 0.44rem;word-wrap:break-word;">

				           			<span id="ratBtn" style="color:#2988FF;">预计利息明细</span>
				           			<input type="hidden" id="loanCode" name="loanCode" value="$!{loanCode}"/>
				           			<input type="hidden" id="sendCode" name="sendCode" value="$!{sendCode}"/>
				           			</td>
				           		</tr>
				           	</tbody>
			           </table>
    				</div>
        <div class="cho-panel-view-item">
            <div class="" style="height: 0.60rem;width: 100%;">
            	<div class="pt-info-font" align="center">
            		借款总额( $!{vo.curName})
            	</div>
            	<div class="pt-info-sum" align="center">
					        ￥$!number.formatNumeric($!{vo.plMoney})
            	</div>
            </div>
    </section>
    <section id="tab1" style="height: calc(100vh - 2.1rem); overflow-y: auto;">
        <div class="cho-content-item" >
            <ul class="ui-row ui-border-b" style="padding-bottom:  0.1rem;">
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">发放金额</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                       $!number.formatNumeric($!{sendVO.money})
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">已归还金额</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                      $!number.formatNumeric($!{repayFinish})
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">还款在途金额</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                      $!number.formatNumeric($!{repayPassage})
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">借款余额</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
					$!number.formatNumeric($!{queryVo.sendBalanceMoney})
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">借款日期</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                       $!date.format('yyyy-MM-dd',$!vo.plDate)
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">到期日期</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                     	$!date.format('yyyy-MM-dd',$!vo.repayDate)
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">录入日期</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $!date.format('yyyy-MM-dd',$!vo.createDate)
                    </div>
                </li>
             </ul>
         </div>

           <div class="cho-content-item">
             <ul class="ui-row ui-border-b">
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">借款单号</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                       $!{vo.billCode}
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">借款种类</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                       $!{vo.plClassName}
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">借款银行</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $!{vo.bankName}
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">借款期限</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $!{vo.plTerm} $!{vo.ternUnitName}
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">借款用途</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                      	$!{vo.plPurpose}
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">还款方式</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                      	$!{vo.repayTypeName}
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">借款利率</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                       $rateTag.show($!{vo.plRate})
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">借款币别</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $!{vo.curName}
                    </div>
                </li>
            </ul>
        </div>
    </section>
</section>
</body>
<script src="${basePath}/static/modules/bill/accebill/lib/f2.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/lib/zepto.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/plugins/web-view/webView.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/mobile/js/webViewScriptBridage.js?_btv=${resourceVersion}"></script>
<script>
(function (doc, win) {
	  //搜索框点击
    $('#ratBtn').on('click', function () {
    	var loanCode=$('#loanCode').val();
    	var sendCode=$('#sendCode').val();
		 setTimeout(function () {
			 var data = BTAppBridge.jump({url:"/cms/provide/loaninfo/loanMobileRatInfo","businessId":loanCode,"sendCode":sendCode});
                uni.postMessage({
                data:data
                        })
    	},100);
    });

})(document, window);
</script>

<script>

</script>
</html>

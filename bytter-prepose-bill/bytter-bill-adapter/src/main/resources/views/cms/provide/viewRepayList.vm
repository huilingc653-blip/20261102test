<!DOCTYPE html>
<html lang="en" style="height: 100%;">
<head>
    #parse("views/common/head.vm")
</head>
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 12px; 
	text-align: center;
	border-left: 0px;
	border-right: 0px;
	background-color: #d2d2d2;
}
</style>  
<body style="padding: 0px;height: 100%;" >
	<div>
		<iframe src="${basePath}/cms/provide/loansend/viewSend/$!{sendBillCode}" frameborder="0" scrolling="no" style="width: 100%;" ></iframe>
	    <script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
    </div>
    
    <div>
	    <table class="layui-table layui-form">
	    	<thead>
	    		<tr>
	    			<th>#springMessage('table.cmsProvideLoanRepay.repayDate')</th><!-- 还款日期 -->
	    			<th>#springMessage('table.cmsProvideLoanRepay.billCode')</th><!-- 还款单号 -->
	    			<th>#springMessage('table.cmsProvideLoanRepay.repayMoney')</th><!-- 还款金额 -->
	    			<th>#springMessage('table.cmsProvideLoanRepay.repayAccrual')</th><!-- 还款利息 -->
	    			##foreach($repay1 in $repayList)
	    				##if("$!{repay1.onlineSign}" != "0")
	    					<th>#springMessage('table.cmsProvideLoanRepay.onlineInterest')</th>##实付利息
	    				##end
	    			##end
	    			<th>#springMessage('table.cmsProvideLoanRepay.rmk')</th><!-- 备注 -->
	    			<th>#springMessage('table.cmsProvideLoanRepay.voucherNo')</th><!-- 记账凭证 -->
	    			<th>#springMessage('table.cmsProvideLoanRepay.onlineSign')</th><!-- 还款模式-->
	    			<th>#springMessage('table.cmsProvideLoanSend.status')</th><!-- 状态 -->
	    			<th>#springMessage('common.button.logInfo')</th><!-- 日志 -->
	    		</tr>
	    	</thead>
	    	<tbody>
	    		#foreach($repay in $repayList)
	   			<tr>
	   				<td class="center">$!date.format('yyyy-MM-dd',$!repay.repayDate)</td>
	   				<td class="center">$!{repay.billCode}</td>
	   				<td align="right">$!number.formatNumeric($!{repay.repayMoney})</td>
	   				<td align="right">$!number.formatNumeric($!{repay.repayAccrual})</td>
	   				##if("$!{repay.onlineSign}" != "0")
	   					<td align="right">
							#if("$!{repay.onlineRealityInterest}" != "")
								$!number.formatNumeric($!{repay.onlineRealityInterest})
							#else
								0.00
							#end
						</td>
	   				##end
	   				<td class="center">$!{repay.rmk}</td>
	   				<td class="center">$!{repay.voucherNo}</td>
	   				<td class="center">$!{repay.onlineSignName}</td>
	   				<td class="center">$!{repay.bizStatusName}</td>
	   				<td>
	   					<a href="#" onclick="listMsg('$!{repay.billCode}')">#springMessage('common.button.logInfo')</a>
	   				</td>
	   			</tr>
	    		#end
	    	</tbody>
	    </table>
    </div>
    #parse("views/common/footer.vm")
</body>

<script type="text/javascript">
//日志列表
function listMsg(repayCode){
	if(repayCode){
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.logInfo'),basePath + "/cms/basedata/cmsprocessmsg/list?billCode=" + repayCode);
            return;
        }
	}
}
</script>
</html>
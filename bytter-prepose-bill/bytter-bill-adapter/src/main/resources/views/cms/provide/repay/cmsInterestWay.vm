<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
	<style>
		.detail-header {
			text-align:center;padding:10px 0px 10px 0px;border: none;border:1px solid #D2D2D2;background:#D2D2D2; color:#000
		}
		.dark-skin .detail-header {
			color: #D3D3D3;
			background-color: #262936;
			border: 1px solid #2E2F34;
		}
		.dark-skin .detail-select {
			border-color: #2E2F34!important;
		}
	</style>
</head>
<body>
	#if($type=="NS"&&$showSign!=0)
	<div class="layui-inline">
		<button class="layui-btn layui-btn-small" type="button" onclick="toUpdateNsPlan()">#springMessage('还款计划修改')</button>
	</div>
	#end
<input type="hidden" id="cmsType" value="$!{type}">
<input type="hidden" id="sendBillCode" value="$!{sendBillCode}">
	#set ($selectableSignRepayDate = "" )  ##所选计划的还款日期
<form>
	<div>
		<table id="appTable" class="layui-table layui-form layui-table-border" style="width:100%;">
			<thead>
			<tr>
				<th>#springMessage('table.cmsProvideLoanInfo.repayDate')</th>##还款日期
				<th>#springMessage('table.fcCompareAcc.interestStartDate')</th>##起息日期
				<th>#springMessage('table.cmsPrecativeLoanInfo.endDate')</th>##结束日期
				<th>#springMessage('table.provide.interestDay')</th>##计息天数
				<th>#springMessage('table.provide.interestRate')</th>##计息利率
				<th>#springMessage('cms.loan.repay.principal')</th>##本金
				<th>#springMessage('table.createRepayPlan.repaymentMoney')</th>##还款本金
				<th>#springMessage('table.createRepayPlan.surplusMoney')</th>##剩余本金
				<th>#springMessage('cms.loan.repay.principalInterest')</th>##归还本金利息
				<th>#springMessage('table.cmsProvideLoanInfo.anticInterest')</th>##预计利息
				<th>#springMessage('table.cmsProvideLoanRepay.onlineInterest')</th>##实付利息
				#if("$!{showSign}" == "0")
					<th>#springMessage('table.cmsProvideLoanInfo.status')</th>
				#else
					<th>#springMessage('common.table.thead.operation')</th>
				#end
			</tr>
			</thead>
			<tbody>
				#set ($index = 1 )
				#set ($signRepayDate = "" )
				#set ($rowsNum = 0 ) ##合并次数
				#set($sumInterest=0) ##合计归还本金利息
				#set($sumPayInterest=0) ##合计支付利息
				#set($sumRealInterest=0)
				#foreach($interest in $list)
				<tr>
					#if("$!{signRepayDate}" != $!date.format('yyyy-MM-dd',$!{interest.signRepayDate}))
						#set ($rowsNum = 0 )
					#else
						#set ($rowsNum = $rowsNum + 1 )
					#end

					#if($!{rowsNum} == 0)
						<td rowspan="$!{interest.count}" align="center">$!date.format('yyyy-MM-dd',$!{interest.signRepayDate})</td>
					#end

					<td align="center">$!date.format('yyyy-MM-dd',$!{interest.interestStartDate})</td>
					<td align="center">$!date.format('yyyy-MM-dd',$!{interest.blnInstDate})</td>
					<td align="center">$!{interest.days}</td>
					#set($interestRate =$!{interest.interestRate}*100)
					<td align="right">$!number.formatDoubles($!interestRate,4)%</td>
					<td class="textRight">$!number.formatNumeric($!{interest.loanMoney})</td>
					<td class="textRight">$!number.formatNumeric($!{interest.repayMoney})</td>
					<td class="textRight">$!number.formatNumeric($!{interest.leftMoney})</td>
					<td class="textRight">$!number.formatNumeric($!{interest.interest})</td>
					#set($sumInterest=$sumInterest +$!{interest.interest}) ##合计归还本金利息
					<td class="textRight">$!number.formatNumeric($!{interest.payInterest})</td>
					#set($sumPayInterest=$sumPayInterest+$!{interest.payInterest}) ##合计支付利息
					#if($!{rowsNum} == 0)
						<td rowspan="$!{interest.count}"  class="textRight">$!number.formatNumeric($!{interest.realInterest})</td>
					#end
					#if("$!{interest.status}" == "1")
						##只统计已还数据的实付利息
						#set($sumRealInterest=$sumRealInterest+$!{interest.realInterest})
					#end
					#if("$!{showSign}" == "0") ##查看
						#if($!{rowsNum} == 0)

							<td rowspan="$!{interest.count}">
								#if("$!{interest.status}" == "1")
									<span  style="color:#5FB878">#springMessage('cms.repaymentSchedule.used')</span>
								#elseif("$!{interest.status}" == "2")
									<span  style="color:#5FB878"> #springMessage('在途') </span>
								#else
									#springMessage('cms.repaymentSchedule.unused')
								#end
							</td>
						#end
					#else
						#if($!{rowsNum} == 0)
							<td rowspan="$!{interest.count}">
								#if("$!{interestID}" == $!{interest.id})##还款已经选中的数据
									<span  style="color:#009688">#springMessage('cms.msg.select')</span>
									#set ($index = $index + 1 )
								#else
									#if("$!{interest.status}" == "0")
										#if("$!{repairSign}" == "1")##新增标识 ,补录、修改不能更改还款利息选项
											#if("$!{index}" == "1")
												#set ($index = $index + 1 )
												#set ($selectableSignRepayDate = $!date.format('yyyy-MM-dd',$!{interest.signRepayDate}) )
												<button class="layui-btn" type="button" onClick="interest('$!date.format('yyyy-MM-dd',$!interest.signRepayDate)','$!{interest.countRepayMoney}','$!{interest.countPayInterest}','$!{interest.id}');" >#springMessage('common.button.select')</button>
											#else
												#springMessage('cms.repaymentSchedule.unused')
											#end
										#end
									#elseif("$!{interest.status}" == "2")
										<span  style="color:#5FB878"> #springMessage('在途') </span>
									#else
										<span  style="color:#5FB878"> #springMessage('cms.repaymentSchedule.used') </span>
									#end
								#end
							</td>
						#end
					#end

					#set ($signRepayDate = $!date.format('yyyy-MM-dd',$!{interest.signRepayDate}) )
				</tr>
				#end
			<tr>
				<td align="center">#springMessage('table.interet.sum')</td>
				<td></td>
				<td></td>
				<td></td>
				<td></td>
				<td></td>
				<td></td>
				<td></td>
				<td class="textRight">$number.formatNumeric($sumInterest)</td>
				<td class="textRight">$number.formatNumeric($sumPayInterest)</td>
				<td class="textRight">$number.formatNumeric($sumRealInterest)</td>
				<td>
					#if("$!{showSign}" == "0") ##查看
						<i id="sumRealInterest-Next" class="layui-icon">&#xe60b;</i>
					#end
				</td>
				#if("$!{showSign}" == "0")
					<td></td>
				#end
			</tr>
			</tbody>
		</table>
	</div>
	<div class="detail-header"><b> 利息明细 </b></div>
	#if($type=="NS"&&$showSign!=0)##内部拆借的预计明细查看，不显示全面明细选项
		<div class="detail-select" style="padding:8px 0px 8px 40px;border: none;border:1px solid #D2D2D2;bgcolor:#D2D2D2"> <input id="detailtype" name="detailtype" type="radio" value="current" checked onclick="changeDetailType(this)"/> 还款计划对应明细 <input id="detailtype" name="detailtype" type="radio" style="margin-left:20px" onclick="changeDetailType(this)" value="all" />所有明细 </div>
	#end
	<div id="currentdetailtable" style="display: block;">
		<table id="appTable2" class="layui-table layui-form" style="width:100%;">
			<thead>
			<tr>
				<th>序号</th>##还款日期
				<th>项目</th>##还款日期
				<th>#springMessage('table.fcCompareAcc.interestStartDate')</th>##起息日期
				<th>#springMessage('table.cmsPrecativeLoanInfo.endDate')</th>##结束日期
				<th>#springMessage('table.provide.interestDay')</th>##计息天数
				<th>#springMessage('table.provide.interestRate')</th>##计息利率
				<th>#springMessage('cms.loan.repay.principal')</th>##本金
				<th>#springMessage('cms.loan.repay.payInterest')</th>##支付利息
				<th>备注</th>##备注
			</tr>
			</thead>
			<tbody>
				#set ($index = 0 )
				#foreach($selectableInterest in $selectableInterests)
				<tr>
					#set ($index = $index + 1 )
					<td align="center">$!{index}</td>
					<td align="center">$!{selectableInterest.projectName}</td>
					<td align="center">$!date.format('yyyy-MM-dd',$!{selectableInterest.interestStartDate})</td>
					<td align="center">$!date.format('yyyy-MM-dd',$!{selectableInterest.blnInstDate})</td>
					<td align="center">$!{selectableInterest.days}</td>
					#set($interestRate =$!{selectableInterest.interestRate}*100)
					<td align="right">#if("$!{selectableInterest.projectName}" != "结息") $!number.formatDoubles($!interestRate,4)% #else #end</td>
					<td class="textRight">#if("$!{selectableInterest.projectName}" != "结息") $!number.formatNumeric($!{selectableInterest.loanMoney}) #else #end</td>
					<td class="textRight"> $!number.formatNumeric($!{selectableInterest.payInterest})</td>
					<td class="textRight">$!{selectableInterest.rmk}</td>
				</tr>
				#end
			</tbody>
		</table>
	</div>
	<div id="alldetailtable" style="display: none;">
		<table id="appTable3" class="layui-table layui-form" style="width:100%;">
			<thead>
			<tr>
				<th>序号</th>##还款日期
				<th>项目</th>##还款日期
				<th>#springMessage('table.fcCompareAcc.interestStartDate')</th>##起息日期
				<th>#springMessage('table.cmsPrecativeLoanInfo.endDate')</th>##结束日期
				<th>#springMessage('table.provide.interestDay')</th>##计息天数
				<th>#springMessage('table.provide.interestRate')</th>##计息利率
				<th>#springMessage('cms.loan.repay.principal')</th>##本金
				<th>#springMessage('cms.loan.repay.payInterest')</th>##支付利息
				<th>备注</th>##支付利息
			</tr>
			</thead>
			<tbody>
				#set ($index = 0 )
				#foreach($interestEle in $allInterests)
				<tr #if($!{interestEle.selected}) style="background-color: #2b85e4" #end  >
					#set ($index = $index + 1 )
					<td align="center">$!{index}</td>
					<td align="center">$!{interestEle.projectName}</td>
					<td align="center">$!date.format('yyyy-MM-dd',$!{interestEle.interestStartDate})</td>
					<td align="center">$!date.format('yyyy-MM-dd',$!{interestEle.blnInstDate})</td>
					<td align="center">$!{interestEle.days}</td>
					#set($interestRate =$!{interestEle.interestRate}*100)
					<td align="right">#if("$!{interestEle.projectName}" != "结息") $!number.formatDoubles($!interestRate,4)% #else #end</td>
					<td class="textRight">#if("$!{interestEle.projectName}" != "结息") $!number.formatNumeric($!{interestEle.loanMoney}) #else #end</td>
					<td class="textRight"> $!number.formatNumeric($!{interestEle.payInterest})</td>
					<td class="textRight">$!{interestEle.rmk}</td>
				</tr>
				#end
			</tbody>
		</table>
	</div>
</form>
<div style="text-align: center;">
	<button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>
</div>
	#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
	bt.use(['jquery',"form",'bttable','moneyType'], function() {
		var $ = bt.jquery;
		var index = 1;
		moneyFun = bt.moneyType.getFun();
		showDesc();
	});

	function merge(tableId){
		var tr = document.getElementById(tableId);
		for(var i=1; i<tr.rows.length; i++){                //表示数据内容的第二行
			if(tr.rows[i].cells[col].innerHTML == tr.rows[i - 1].cells[col].innerHTML){//col代表列
				t = i-1;
				while(tr.rows[i].cells[col].innerHTML == tr.rows[t].cells[col].innerHTML){
					tr.rows[i].cells[col].style.display="none";
					if(tr.rows[t].cells[col].rowSpan <= (i-t)){
						tr.rows[t].cells[col].rowSpan +=1;      //设置前一行的rowspan+1
					}
					i++;
				}
			}
		}
	}

	function interest(repayDate,repayMoney,payInterest,id){
		var webObj = bt.navtab.getParentDom();
		var cmsType=$("#cmsType").val();
		if(cmsType=="NS") {
			//对拆借选择数据进行校验,(是否在审批中，是否已做更改)
			$.post(basePath + "/inl/change/checkInterest", {
				"inlInterestId": id,
				"sendBillCode": $("#sendBillCode").val()
			}, function (data) {
				if (data.success) {
					webObj.setSelectInterestData(repayDate,repayMoney,payInterest,id);
					bt.navtab.closeCurrent();
				}else {
					parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
				}
			}, "JSON");
		}else {
			webObj.setSelectInterestData(repayDate,repayMoney,payInterest,id);
			bt.navtab.closeCurrent();
		}
	}

	function changeDetailType(obj) {
		var detailtype0=obj.value;
		var haschecked=obj.checked;
		//、$("#demo").attr("style","display:none;");//隐藏div
		//$("#demo").attr("style","display:block;");//显示div
		if("all" == detailtype0 && haschecked){
			$("#alldetailtable").attr("style","display:block;");
			$("#currentdetailtable").attr("style","display:none;");
			//$("#alldetailtable").show();
			//$("#currentdetailtable").hide();
		}else{
			$("#currentdetailtable").attr("style","display:block;");
			$("#alldetailtable").attr("style","display:none;");
			//$("#currentdetailtable").show();
			//$("#alldetailtable").hide();
		}
	}

	function toUpdateNsPlan() {
		var sendBillCode=$("#sendBillCode").val();
		if(bt.navtab){
			bt.navtab.addNavtab(bt.lang('common.button.edit'), basePath + "/inl/change/addUpdate?sendBillCode=" + sendBillCode);
			return;
		}
		parent.layer.open({
			type: 2,
			area: ['850px', '530px'],
			maxmin: true,
			content: basePath + "/inl/change/addUpdate?sendBillCode=" + sendBillCode,
			end:function(){
				datatable && datatable.draw();
			}
		});
	}

	function showDesc() {
		var tip_index1 = 0;
		$('#sumRealInterest-Next').mouseenter(function () {
			tip_index1 = layer.tips(bt.lang('说明：实付利息的合计数不包含在途状态的利息金额'), '#sumRealInterest-Next', {time: 30000,maxWidth:400});
		}).mouseleave(function () {
			layer.close(tip_index1);
		});
	}

</script>
</html>

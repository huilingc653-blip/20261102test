<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<table class="layui-table">
		<tbody>
		   	<tr>
		   		##单位代码
				<td class="textRight" width="10%">#springMessage('table.cmsProvideLoanInfo.corpId')</td>
		   		<td width="20%">
		   			<div class="layui-input-inline">
                   			<div class="bt-biz-corp" 
                   				 data-biz-type="corp" 
                   				 data-type="selectTree" 
                   				 data-name="eqs_corpId" 
                   				 data-resource="cms:provide:info:change"
                   				 data-scope="all">
                   			</div>
                  		</div>
		   		</td>
		   		##借款单号
		   		<td class="textRight" width="10%">#springMessage('table.cmsProvideLoanInfo.billCode')</td>
		   		<td width="20%">
					<input name="likes_billCode" class="layui-input" type="text">
		   		</td>
				##借款银行
				<td class="textRight" width="10%">#springMessage('table.cmsProvideLoanInfo.bankId')</td>
				<td width="20%">
					<input name="likes_bankName" class="layui-input" type="text">
				</td>
		   	</tr>
			<tr>
				##借款金额
				<td class="textRight">#springMessage('借款金额')</td>
				<td>
					<div class="layui-input-inline" style="width: 45%">
						<input name="geg_plMoney" class="layui-input bt-biz-moneyType" type="text" style="width: 67%;display: inline-block">
						~
						<input name="leg_plMoney" class="layui-input bt-biz-moneyType" type="text" style="width: 67%;display: inline-block">
					</div>
				</td>
				<td></td>
				<td></td>
				<td></td>
				<td></td>
			</tr>
		   	<tr>
		   		<td colspan="6" style="text-align: center;">
		   			<button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
		           	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		   		</td>
		   	</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
    	<th>#springMessage('table.cmsProvideLoanInfo.corpId')</th>#*申请单位*#
    	<th>#springMessage('table.cmsProvideLoanInfo.billCode')</th>#*借款单号*#
    	<th>#springMessage('table.cmsProvideLoanInfo.bankId')</th>#*借款银行*#
    	<th>#springMessage('table.cmsProvideLoanInfo.curId')</th>#*借款币种*#
    	<th>#springMessage('table.cmsProvideLoanInfo.plMoney')</th>#*借款金额*#
    	<th>#springMessage('table.cmsProvideLoanInfo.plDate')</th>#*借款日期*#
    	<th>#springMessage('cms.provide.deferred.repayDate')</th>#*还款日期*#
    	<th>#springMessage('table.cmsProvideLoanInfo.repayType')</th>#*还款方式*#
    	<th>#springMessage('table.cmsProvideLoanInfo.contractTerm')</th>#*借款种类*#
    	<th>#springMessage('table.cmsProvideLoanInfo.plTerm')</th>#*借款期限*#
    	<th>#springMessage('table.cmsProvideLoanInfo.status')</th>#*状态*#
        <th>#springMessage('common.table.thead.operation')</th>#*操作*#
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
	#workFlowScript()
<script src="${basePath}/static/modules/cms/provide/changeLoanInfo.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

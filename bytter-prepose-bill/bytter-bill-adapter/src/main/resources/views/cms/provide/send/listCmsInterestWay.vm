<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	<style>
		html,body{height:100%;}
	</style>
</head>
<body>
<div class="layui-tab-content" style="width: 100%; height: 100%">

 <div class="layui-tab-item layui-show" style="width: 100%; height: 50%">
<iframe id="loanRepayIframe2" src="${basePath}/cms/provide/loansend/viewSend/$!{cmsInterestWayVO.sendCode}" frameborder="0" style="width: 100%; height: 100%"></iframe>
</div>

<form class="layui-form"  method="post">
	<table class="layui-table">
		<thead>
		<tr>
			<td colspan="10" align="center">#springMessage('table.InterestWayUpdate.interestWay')</td>

		</tr>
		<input type ="hidden" id="id" name="id" value="$!{cmsInterestWayVO.id}">##单号
		<input type ="hidden" id="sendCode" name="sendCode" value="$!{cmsInterestWayVO.sendCode}">##单号
		<input type ="hidden" id="lastUpdateTime" name="lastUpdateTime" value="$!{cmsInterestWayVO.lastUpdateTime}">##单号
		</thead>
		<tbody>
		<tr>
			<td class="textRight">#springMessage('table.InterestWayUpdate.activeDate'):</td>
			<td>
				##执行日期
					<div class="layui-input-inline">
				<input type="text"  id="activeDate" name="activeDate"  data-min="$!{cmsInterestWayVO.toDayDate}"   class="layui-input bt-biz-dateType" data-type="date" data-biz-name="activeDate" lay-verify="required">
               </div>
			</td>
			<td class="textRight">#springMessage('table.repay.interestFrequency')</td>
			<td>
				<div class="layui-inline">
					<div class="bt-biz-dict" data-width="130px" data-name="interestFrequencyType"
						 data-value="$!{repayTypePage.interestFrequencyType}" data-biz-name="interestFrequencyType"
						 data-type="select" data-displayData="D"
						 data-group="repay.frequency" data-callback="showInterestFrequencyType"
						 data-required="true"></div>
				</div>
				<div class="layui-inline" id="showInterestFrequencyNext">

				</div>
				<div class="layui-inline" id="showInterestFrequency">

				</div>
				<div class="layui-inline" id="showInterestFrequencyNumInput">

				</div>
            </td>
	    </tr>
		<tr>
			<td class="textRight">#springMessage('table.cmsProvideLoanSend.expiryDate')</td>
			<td>
				<div class="layui-inline" id="expiryDateTd">
					<div class="bt-biz-dict" data-name="expiryDay" data-type="select"
						 data-biz-name="expiryDateMonth"
						 data-group="bisGatherPolicy.month"
						 data-required="true"></div>
				</div>
			</td>
		</tr>
	    </tbody>
	</table>
	<table class="layui-table" id="appTable" align="center">
		<thead>
			<tr>
        <th>#springMessage('table.InterestWayUpdate.interestWay')</th> ##计算方式
        <th>#springMessage('table.InterestWayUpdate.expiryDay')</th>	##结息日
		 <th>#springMessage('table.InterestWayUpdate.withholdingDay')</th> ##预提日
        <th>#springMessage('table.InterestWayUpdate.activeDate')</th>	##执行日期
		</tr>
		</thead>
		<tbody>
		</tbody>

	</table>
<div align="center">
				 <button class="layui-btn layui-btn-small" lay-submit="" lay-filter="save">#springMessage('common.button.save')</button>
				<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
				<a href="#" class="layui-btn layui-btn-small" onClick="doClose()" >#springMessage('common.button.close')</a>
               ##<a href="#" class="layui-btn layui-btn-small" onClick="calculationSurplusMoney()" >测试</a>
			</div>

</form>
</div>

#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
	
</script>
<script src="${basePath}/static/modules/cms/provide/cmsInterestWay.list.js?_btv=${resourceVersion}"></script>
</html>


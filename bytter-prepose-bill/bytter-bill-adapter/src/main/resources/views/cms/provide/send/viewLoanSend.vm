<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 12px;
	text-align: center;
	border-left: 0px;
	border-right: 0px;
	background-color: #d2d2d2;
}
</style>
<body style="padding: 0px;">
	<div>
		<table class="layui-table dark-layui-table breakRow">
	    	<tbody>
			<tr>
		    	##申请单位
				<td class="textRight" width="14%">#springMessage('table.cmsProvideLoanInfo.corpId')</td>
				<td width="36%">$!{loanInfo.corpName}</td>
		      	##借款种类
				<td class="textRight" width="14%">#springMessage('table.cmsProvideLoanInfo.plClass')</td>
				<td width="36%">$!{loanInfo.plClassName}</td>
			</tr>
		    <tr>
		    	##借款单号
				<td class="textRight">#springMessage('table.cmsProvideLoanInfo.billCode')</td>
				<td width="36%">$!{loanInfo.billCode}</td>
		      	##借款合同号
				<td class="textRight">#springMessage('table.cmsProvideLoanInfo.contractNo')</td>
				<td width="36%">$!{loanInfo.contractNo}</td>
			</tr>
			<tr>
		      	##借款银行
				<td class="textRight">#springMessage('table.cmsProvideLoanInfo.bankId')</td>
				<td width="36%">$!{loanInfo.bankName}</td>
				<td colspan="2"></td>
			</tr>
			<tr>
				##借款币种
				<td class="textRight">#springMessage('table.cmsProvideLoanInfo.curId')</td>
					<input type="hidden" id="curId" value="$!{loanInfo.curId}">
				<td width="36%">$!{loanInfo.curName}</td>
		    	##发放金额
				<td class="textRight">#springMessage('table.cmsProvideLoanSend.money')</td>
				<td width="36%">
					<div class="layui-input-inline">
						$number.formatNumeric(${loanSend.money})
					</div>
					&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
					<div class="layui-input-inline" id="moneyUpper">

					</div>
				</td>
			</tr>
			<tr>
		    	##还款在途金额
				<td class="textRight">#springMessage('table.cmsProvideLoanRepay.repayPassage')</td>
				<td width="36%">
					<div class="layui-input-inline">
						$number.formatNumeric(${repayPassage})
					</div>
					&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
					<div class="layui-input-inline" id="repayPassageUpper">

					</div>
				</td>
		      	##已还款金额
				<td class="textRight">#springMessage('table.cmsProvideLoanRepay.repayFinish')</td>
				<td width="36%">
					<div class="layui-input-inline">
						$number.formatNumeric(${repayFinish})
					</div>
					&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
					<div class="layui-input-inline" id="repayFinishUpper">

					</div>
				</td>
			</tr>
			<tr>
		    	##发放单号
				<td class="textRight">#springMessage('table.cmsProvideLoanSend.billCode')</td>
				<td width="36%">$!{loanSend.billCode}</td>
				<td class="textRight">#springMessage('table.cmsProvideLoanSend.contractCode')</td>
				<td width="36%">
					$!{loanSend.contractCode}
				</td>
			</tr>
			<tr>
		    	##发放日期
				<td class="textRight">#springMessage('table.cmsProvideLoanSend.sendDate')</td>
				<td width="36%">$!date.format('yyyy-MM-dd',$!loanSend.sendDate)</td>
		      	##到期日期
				<td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
				<td width="36%">$!date.format('yyyy-MM-dd',$!loanSend.repayDate)</td>
			</tr>
			<tr>
				<td colspan="2"></td>
				##展期日期
				<td class="textRight">#springMessage('table.cmsProvideLoanDeferred.deferredRepayDate')</td>
				<td width="36%">$!date.format('yyyy-MM-dd',$!loanSend.deferredDate)</td>
			</tr>
			<tr>
				##银行活期帐号
				<td class="textRight">#springMessage('table.cmsProvideLoanSend.blnctrAcc')</td>
				<td width="36%">$!{loanSend.blnctrAcc}</td>
		    	##银行借款账号
				<td class="textRight">#springMessage('table.cmsProvideLoanSend.loanAcc')</td>
				<td width="36%">$!{loanSend.loanAcc}</td>
			</tr>
			#if($!{loanSend.accrualType})
				<tr>
					##计提方式
					<td class="textRight">#springMessage('table.cmsProvideLoanSend.accrualWay')</td>
					<td width="36%">$!{loanSend.accrualTypeName}</td>
					##还款方式
					<td class="textRight">#springMessage('table.cmsProvideLoanInfo.repayType')</td>
					<td width="36%">
						$!{loanSend.repayTypeName}
					</td>
				</tr>
				#else
				<tr>
					##还款方式
					<td class="textRight">#springMessage('table.cmsProvideLoanSend.repayType')</td>
					<td width="36%">$!{loanSend.repayTypeName}</td>
					##计息方式
					<td class="textRight">#springMessage('table.cmsProvideLoanSend.interestWay')</td>
					<td width="36%">
						$!{loanSend.interestWayName}
					#if($!{loanSend.repayType} != "07")
						#if("$!{loanSend.expiryDate}" != "")
							#springMessage('table.cmsProvideLoanSend.expiryDate')
							$!{loanSend.expiryDate}
						#end
						#if("$!{loanSend.accruedDailyDate}" != "")
							#springMessage('table.cmsProvideLoanSend.accruedDailyDate')
							$!{loanSend.accruedDailyDate}
						#end
					#end
					</td>
				</tr>
			#end
			<tr>
				##是否自动还款
				<td class="textRight">#springMessage('table.cmsProvideLoanInfo.isAutoPay')</td>
				<td width="36%">$!{loanInfo.isAutoPayName}</td>
				<td class="textRight"></td>
				<td width="36%">
				</td>
			</tr>
			<tr>
				##浮动方式
				<td class="textRight">#springMessage('table.cmsProvideLoanSend.floatWay')</td>
				<td width="36%">
					<div class="layui-inline">
						$!{loanSend.floatWayName}
					</div>
					<div class="layui-inline" id="nextFloatWay">

					</div>
				</td>
		    	##利率调整生效日期
				<td class="textRight">#springMessage('table.cmsProvideLoanSend.rateEntriesEffectDate')</td>
				<td width="36%">$!date.format('yyyy-MM-dd',$!loanSend.rateEntriesEffectDate)</td>
			</tr>
			<tr>
		    	##浮动利率
				<td class="textRight">#springMessage('table.cmsProvideLoanInfo.floatRate')</td>
				<td width="36%">
					<div class="layui-inline">
						<div style="padding-bottom: 10px;padding-top: 10px;">
							<div class="layui-inline">
								##基准利率类型
								$!{loanSend.referenceRateTypeName}
							</div>
						</div>
						<div style="padding-bottom: 10px;padding-top: 10px;">
							<div class="layui-inline">
								##贷款周期
								 $!{loanSend.repayCycleName} <span style="padding-left: 30px;">$!date.format('yyyy-MM-dd',$!loanInfo.rateQuotedPriceDate)</span>
							</div>
						</div>
						<div style="padding-bottom: 10px;padding-top: 10px;">
							##点数或者浮动比例选择与文本
							<div class="layui-inline">
								 $!{loanSend.pointsProportionSelectName}
							</div>
							<div class="layui-inline">
								#if($!{loanInfo.pointsProportionText})
									#if($!{loanInfo.pointsProportionSelect} == "01")
										$!number.formatNumeric($!{loanInfo.pointsProportionText})BP
									#else
										$!number.formatNumeric($!{loanInfo.pointsProportionText})%
									#end
								#else
									#if($!{loanInfo.pointsProportionSelect} == "01")
										0.00BP
									#else
										0.00%
									#end
								#end
							</div>
						</div>
					</div>
				</td>
		      	##借款利率
				<td class="textRight">#springMessage('table.cmsProvideLoanInfo.plRate')</td>
				<td>
	   				$rateTag.show($!{loanSend.plRate})
				</td>
			</tr>
			<tr>
				##逾期利率
				<td class="textRight">#springMessage('table.cmsProvideLoanSend.overdueRate')</td>
				<td width="36%">
					#if($!{loanInfo.isBankBaseRate} != "1"&&$!{loanSend.overdueRate})
						#springMessage('cms.loanInfo.overdueProportion')
						$!number.formatNumeric($!{loanSend.overdueProportion})%
						&nbsp; &nbsp;
					#else
					#end
	   				$rateTag.show($!{loanSend.overdueRate})
				</td>
		      	##展期利率
				<td class="textRight">#springMessage('table.cmsProvideLoanSend.deferredRate')</td>
				<td width="36%">
					#if($!{loanInfo.isBankBaseRate} != "1"&&$!{loanSend.deferredRate})
						#springMessage('cms.loanInfo.deferredPoints')
						$!number.formatNumeric($!{loanSend.deferredPoints})BP
						&nbsp; &nbsp;
					#else
					#end
					$rateTag.show($!{loanSend.deferredRate})
				</td>
			</tr>
			#if($!{loanInfo.plClass} == "1000")
			<tr>
				<td colspan="4">
					<table id="dataTableSy" class="layui-table">
						<thead>
						<th>#springMessage('table.cmsLoanInfo.leadingBank')</th>##是否牵头行
						<th>#springMessage('table.cmsLoanInfo.bankCode')</th>##银行开户行号
						<th>#springMessage('table.cmsLoanInfo.bankName')</th>##银行名称
						<th>#springMessage('table.cmsLoanInfo.notsendMoney')</th>##未发放金额
						<th>#springMessage('table.cmsLoanInfo.sendMoney')</th>##本次放款
						<th>#springMessage('table.cmsLoanInfo.sendMoneyShare')</th>##放款占比%
						</thead>
						<tbody>
						#foreach($!{item} in $!{syndicatedSend})
						<tr>
							<td>$!dictTag.get("sf_yn",$!{item.leadingBank})</td>
							<td>$!{item.bankCode}</td>
							<td>$!{item.bankName}</td>
							<td style="text-align: right">$number.formatNumeric($!{item.notsendMoney})</td>
							<td style="text-align: right">$number.formatNumeric($!{item.sendMoney})</td>
							<td>$number.formatNumeric($math.mul($!{item.sendMoneyShare},100))%</td>
						</tr>
						#end
						</tbody>
					</table>
				</td>
			</tr>
			#end
			<tr>
				##附件
				<td class="textRight">#springMessage('cms.loan.attachment')</td>
		      	<td colspan="3">
		      		<!-- 附件上传 -->
					<input id="annexName" name="annexName" type="hidden" value="$!{loanSend.uploadId}">
			        <div id="uploader" class="layui-input-inline" style="width:100%"></div>
		      	</td>
			</tr>
			</tbody>
	    </table>
	</div>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
bt.use(['form','btUpload','dicts','moneyType',], function(){
	$ = bt.jquery,form = bt.form();fun = bt.moneyType.getFun();
	showFloatWayNext();
	moneyUpper();
	var gid = $("#annexName").val();
    var up = bt.btUpload.init({
        elem: "#uploader",
        hasUpload: false,
        hasDelete: false,
        isExpand: true,
        auto: false,
        gid: gid
    });
});

/**金额大写*/
function moneyUpper(){
	var money = fun.toNumber("${loanSend.money}");
	var repayPassage = fun.toNumber("${repayPassage}");
	var repayFinish = fun.toNumber("${repayFinish}");

	$("#moneyUpper").text(bt.money.toChinese(money));
	$("#repayPassageUpper").text(bt.money.toChinese(repayPassage));
	$("#repayFinishUpper").text(bt.money.toChinese(repayFinish));
}

function showFloatWayNext(){
	//显示nextFloatWya
	var floatWay = "$!{loanSend.floatWay}";
	var nextFloatWay = "$!{loanSend.floatWayNext}";

	var postfix = "";
    if(floatWay == "03"){//按月浮动
    	postfix = "Month";
	}else if(floatWay == "04"){//按季浮动
		postfix = "Season";
	}else if(floatWay == "05"){//按半年浮动
		postfix = "HY";
	}else if(floatWay == "06"){//按年浮动
		postfix = "Year";
	}

    if(postfix != ""){
    	var htl = '<div class="bt-biz-dict" data-name="floatWayNext" data-type="select" data-disabled="true" data-defaultvalue="'+ nextFloatWay +'" data-group="Cms.FloatWay'+ postfix +'"></div>';
		$("#nextFloatWay").html(htl);
		bt.dicts.render();
    }
}

//查看授信
function viewRatCode(){
	var params = beforeRation();
	if(bt.empty(params)){
		return;
	}
	viewRationDtl(params);
}

/**
 * 授信额度选择
 * @param params
 */
function beforeRation(){
	var corpId = $("#corpId").val();
	var curId = $("#curId").val();//币别

	var bankId = $("#bankId").val();//银行

	var loanDate = $("#plDate").val();//借款日期

	var itemCode = $("#ratItemCode").val();//授信品种
	var beginDate = loanDate;
	var isRmbRat = $("#isRmbRat").val();//是否折合本位币
	var params = {
			corpId : corpId,
			curCode : curId,
			bankCode : bankId,
			ratItemCode : itemCode.replace(" ", ""),
			beginDate : beginDate.replace(" ", ""),
			isRmbRat : isRmbRat
	}
	return params;
}
</script>
</html>

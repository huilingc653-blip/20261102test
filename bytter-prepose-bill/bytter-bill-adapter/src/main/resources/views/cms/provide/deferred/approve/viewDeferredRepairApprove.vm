<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<iframe src="${basePath}/cms/provide/loansend/viewSend/$!{deferredvo.provideCode}" id="sendIframe" frameborder="0" scrolling="no" style="width: 100%;"></iframe>
<script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
	<table class="layui-table">
	<tbody>
		<!-- <tr>
			##到期处理类型
			<td class="textRight" width="14%">#springMessage('cms.provide.deferred.expiryhandletype')</td>
			<td width="36%">
				$dictTag.get("provide.deferredHandleType",$!provideLoanDeferred.expiryHandleType)
			</td>
			<td colspan="2"></td>
		</tr> -->

		<tr>
			##展期到期日期
			<td class="textRight"  width="14%">#springMessage('table.fcAcc.delayDeadlineDate')</td>
			<td width="36%">
				<div class=layui-input-inline>
					$!date.format('yyyy-MM-dd',$!provideLoanDeferred.deferredRepayDate)
				</div>
			</td>

			##展期期限
			<td class="textRight" width="14%">#springMessage('table.cmsProvideLoanDeferred.deferredLimt')</td>
			<td width="36%">
				$!{provideLoanDeferred.deferredLimt} $dictTag.get("PrecativeLoanInfo.ternUnit",$!provideLoanDeferred.ternUnit)
			</td>
		</tr>

		<tr>
			##展期利率
			<td class="textRight">#springMessage('table.fcAcc.delayRate')</td>
			<td>
				#if($!{loanInfo.isBankBaseRate} != "1"&&$!{loanInfo.deferredPoints})
					#springMessage('cms.loanInfo.deferredPoints')
					$!number.formatNumeric($!{loanInfo.deferredPoints})BP
					&nbsp; &nbsp;
				#else
				#end
				##$number.formatDoubleWithSix($!{provideLoanDeferred.deferredRate})
				$rateTag.show($!{provideLoanDeferred.deferredRate})
			</td>

			##备注
			<td class="textRight">#springMessage('table.bvStorageBox.rmk')</td>
			<td>
				$!{provideLoanDeferred.rmk}
			</td>
		</tr>

		<tr>
			##展期合同号
			<td class="textRight">
				#if($provideLoanDeferred.expiryHandleType=='1')
					##展期合同号
					#springMessage('table.cmsPrecativeLoanDeferred.contractCode')
				#else
					##合同号
					#springMessage('table.cgsBill.pactCode')
				#end
			</td>
			<td>
				$!{provideLoanDeferred.contractCode}
			</td>
			<td colspan="2"></td>
		</tr>
	</tbody>
	</table>

    #workFlowHtml()
	#parse("views/common/footer.vm")
	#workFlowScript()
</body>
</html>

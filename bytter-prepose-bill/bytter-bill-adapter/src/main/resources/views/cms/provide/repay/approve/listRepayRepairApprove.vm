<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
	<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
	<input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
	<table class="layui-table">
		<tbody>
			<tr>
				## 查询区仅有借款单号：紧凑排列标题、输入框和按钮，避免单独标题列占满宽度。
				<td>
					<div style="display: flex; align-items: center; flex-wrap: wrap; gap: 10px;">
						<label for="repayRepairBillCode" style="white-space: nowrap;">#springMessage('table.cmsProvideLoanRepay.billCode')：</label>
						<input id="repayRepairBillCode" name="likes_billCode" class="layui-input"
							   style="width: 280px; max-width: 100%;" placeholder="#springMessage('table.cmsProvideLoanRepay.billCode')">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</div>
				</td>
			</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
    	<th>#springMessage('table.cmsProvideLoanInfo.corpId')</th><!-- 申请单位 -->
    	<th>#springMessage('table.cmsProvideLoanRepay.billCode')</th><!-- 借款单号 -->
    	<!-- <th>#springMessage('table.fcAccbook.enrolTime') --></th><!-- 录入日期 -->
    	<th>#springMessage('table.cmsProvideLoanInfo.billCode')</th><!-- 借款单号 -->
        <th>#springMessage('table.cmsProvideLoanSend.billCode')</th><!-- 发放单号 -->
        <th>#springMessage('table.cmsProvideLoanRepay.repayMoney')</th><!-- 还款金额 -->
        <th>#springMessage('table.cmsProvideLoanRepay.repayDate')</th><!-- 发放金额 -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#workFlowHtml()
#parse("views/common/footer.vm")
#workFlowScript()
</body>
<script src="${basePath}/static/modules/cms/provide/approve/repayRepairApprove.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<style type="text/css">
.layui-body2 {
	padding：0px;
	position: absolute;
	left: 0px;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 2000;
	width: auto;
	overflow: hidden;
	overflow-y: auto;
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box;
}
</style> 
<body>
	<div class="layui-body2" style="width: 100%; height: 100%">
		<div class="layui-tab layui-tab-brief"  style="width: 100%; height: 100%">
			<ul class="layui-tab-title">
				<li  lay-id="rushbook" class="innerTab layui-this">#springMessage("cms.provide.repqyApp")</li>
				<li lay-id="oribook" class="innerTab">#springMessage("cms.provide.repayFollow")</li>
			</ul>
	    	<div class="layui-tab-content" style="width: 100%; height: 100%">
		      	##还款申请
		       	<div class="layui-tab-item layui-show" style="width: 100%; height: 100%">##listBtNetChalk
		           	<iframe id="repayApp" name='repayApp' src="${basePath}/cms/provide/loanrepay/listApp" frameborder="0" style="width: 100%; height: 100%"></iframe>
		        </div>
	            ##还款跟踪
	            <div class="layui-tab-item" style="width: 100%; height: 100%">##listBtNetChalkCancel
	            	<iframe id="repayFollow" name='repayFollow' src="${basePath}/cms/provide/loanrepay/listOnlineRepayFollow" frameborder="0" style="width: 100%; height: 100%"></iframe>
				</div>
			</div>
		</div>
	</div> 
#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
	bt.use(['element', 'form','layedit','btdate'], function(){
		//注意：选项卡 依赖 element 模块，否则无法进行功能性操作
		var $ = bt.jquery,form = bt.form();
		var element = layui.element();
	});
</script>
</html>

            line-height: 0.16rem;
        }
        
        .cho-content-item {
            background: rgba(255, 255, 255, 1);
            border-top: 1px solid #EDEDED;
        }

        .cho-content-item .cho-content-item-title-left {
            display: inline-block;
            font-size: 0.14rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(51, 51, 51, 1);

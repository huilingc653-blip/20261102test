        }

        .cho-content-item .cho-content-item-btn-left {
            display: inline-block;
            background: rgba(229, 230, 255, 1);
            border-radius: 2px;
            height: 0.20rem;
            padding: 0 0.05rem;
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(27, 29, 117, 1);
            line-height: 0.20rem;
            margin-left: 0.18rem;
        }

        .cho-content-item-btn-left span {
            line-height: 0.08rem;
        }

        .cho-content-item .cho-content-item-money-left {
            font-size: 0.24rem;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(228, 70, 29, 1);
            line-height: 0.28rem;
            padding: 0.09rem 0.24rem;
        }

        .cho-content-item-font-left {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(153, 153, 153, 1);
            line-height: 0.18rem;
            padding: 0.06rem 0.24rem;
        }

        .cho-content-item .cho-content-item-money-right {
            font-size: 0.18rem;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(51, 51, 51, 1);
            line-height: 0.47rem;
            padding-bottom: 0;
        }

        .cho-content-item-font-right {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(153, 153, 153, 1);
            padding: 0.06rem 0.06rem;
            line-height: 0.18rem;
        }

        .cho-content-item-acc-right span {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.17rem;
            padding: 0.10rem 1rem;
            padding-right: 0rem;
        }

        .cho-tab-title {
            height: 0.44rem;
            background-color: #fff;
            padding-left: 0.15rem;
        }

        .cho-tab-title span {
            display: inline-block;
            height: 0.24rem;
            border-radius: 0.12rem;
            margin: 0.06rem;
            margin-top: 0.1rem;
            color: #333;
            padding: 0 0.1rem;
            font-size: 0.14rem;
            font-family: PingFangSC-Regular, PingFang SC;
            margin-left: 0;
        }

        .cho-tab-title span:nth-child(3) {
            margin-right: 0;
        }

        .cho-tab-title .active {
            background-color: #1B1D75;
            color: #fff !important;
        }

        .cho-date-item-bottom {
            height: 0.6rem;
            padding-top: 0.06rem;
            padding-bottom: 0.08rem;
            padding: 0 0.12rem;
        }

        .cho-date-item-bottom > div > div {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.22rem;
            height: 0.22rem;
        }
        .ui-container-content{
		 	padding-top:0.01rem;
		 	    padding-bottom: 0.12rem
		 }
        .ui-container-title{
		 	margin-top:0.16rem;
		 }
		 
		 .ui-container-content{
		 	padding-top:0.01rem;
		 }
		 
		  .cho-panel-item-content{
            background: #ffffff;
            border-radius: 0.1rem;
            height: 100%rem;
			margin: 0.12rem 0.1rem;
            padding: 0 0.1rem;
            margin-bottom: 0;
            background-repeat: no-repeat;
            background-size: contain;
        }
        .cho-panel-item-content table .tr1 {
                width: 1.2rem;
                font-size: 0.14rem;
	            font-family: PingFangSC-Regular, PingFang SC;
	            margin-left:0.1rem;
	            font-weight: 400;
	            color: #999999;
        }
          .cho-panel-item-content table .tr2{
           		height: 0.35rem;
          }
         .cho-panel-item-content table .tr2 > td{
                width: 1.2rem;
                font-size: 0.14rem;
                margin-left:0.1rem;
	            font-family: DIN Alternate Bold;
	            color: #333333;
        }
		 
		.cho-panel-item-content .cho-panel-item-money {
            font-size: 0.14rem;
            font-family: DIN Alternate Bold;
            color:#333333;
        }
        
         .cho-panel-item-content-bottom {
            font-size: 0.12rem;
            font-family: DIN Alternate Bold;
            font-weight: 400;
            color: #333333;
/*             padding: 0.10rem; */
            padding-left: 0;
            line-height: 0.15rem;
        }
        
		.cho-panel-item-content-bottom table tbody .tr1 >td{
            font-size: 0.12rem;
            font-family: 苹方-简 常规体;
            color: #999999;
            padding-top: 0.05rem;
        }
        .cho-panel-item-content-bottom table tbody .tr1 >td span{
            font-size: 0.12rem;
            font-family: 苹方-简 常规体;
            color: #999999;
            padding-top: 0.05rem;
        }
      .sp-tab-switch {
	        width:1.421rem;
			height:0.3rem;
			border-radius:0.15rem;
			border:1px solid rgba(151,151,151,1);
			display:inline-block;
			text-align:center;
			margin:0 auto;
        }
	.sp-rat-tab {
		width:0.7rem;
		height:0.3rem;
		border-radius:0.15rem;
		border:none;
		font-size:0.14rem;
		font-family:PingFangSC-Regular,PingFang SC;
		font-weight:400;
		color:rgba(102,102,102,1);
		line-height:0.3rem;
		display:inline-block;
		float:left;
	}
	 .sp-rat-tab.active {
		background:rgba(105,164,255,1);
		border:1px solid rgba(105,164,255,1);
		color:#fff;
         }
  </style>
</head>
<body> 
  <section id="tab" class="ui-container">
    <div>
        <div class="ui-tab ">
            <ul class="ui-tab-content" style="width:100%">
            <li class="bt-show">
            <section class="cho-body ui-container-title ui-border-b">
			    <section id="tab">
			        <div class="cho-rat-item" align="center">
		               <div class="sp-tab-switch" align="center">
							<span id="resetBtn" class="sp-rat-tab active" data-name="yes">已还</span>
							<span class="sp-rat-tab sp-rat-tab2" data-name="no">未还</span>
						</div>
		        	  </div>
			        </div>
			    </section>
			 </section>
			<section class="cho-body ui-container-content ui-border-b cho-content-model">
				<section id="tab">
					<div id="y-pay">
					<!-- 已还 --> 
					#if($yRepayList)
						#foreach($interest in $yRepayList)
						<div class="cho-panel-item-content">
							<table width="100%">
									<tbody class="sp_tab_tbody">
										<tr class="tr1">
											<td>本金</td>
											<td>￥$number.formatNumeric($!{interest.loanMoney})</td>
										</tr>
										<tr class="tr1">
											<td>归还金额</td>
											<td>￥$number.formatNumeric($!{interest.repayMoney})</td>
										</tr>
										
										<tr class="tr1">
											<td>剩余本金</td>
											<td>￥$number.formatNumeric($!{interest.leftMoney})</td>
										</tr>
										
										<tr class="tr1">
											<td>归还利息</td>
											<td>￥$number.formatNumeric($!{interest.interest})</td>
										</tr>
										
										<tr class="tr1">
											<td>支付利息</td>
											<td>￥$number.formatNumeric($!{interest.payInterest})</td>
										</tr>
										
										<tr class="tr1">
											<td>实际利息</td>
											<td>￥$number.formatNumeric($!{interest.realInterest})</td>
										</tr>
										
										<tr class="tr1">
											<td>还款日期</td>
											<td>$!date.format('yyyy-MM-dd',$!{interest.signRepayDate})</td>
										</tr>
										
										<tr class="tr1">
											<td>起息日期</td>
											<td>$!date.format('yyyy-MM-dd',$!{interest.interestStartDate})</td>
										</tr>
										
										<tr class="tr1">
											<td>结束日期</td>
											<td>$!date.format('yyyy-MM-dd',$!{interest.blnInstDate})</td>
										</tr>
										
										<tr class="tr1">
											<td>计息天数</td>
											<td>$!{interest.days}</td>
										</tr>
										
										<tr class="tr1">
											<td>计息利率</td>
											#set($interestRate =$!{interest.interestRate}*100)
											<td>$!number.formatDoubles($!interestRate,4)%</td>
										</tr>
									</tbody>
								</table>
							</div>
						#end
					#else
						sdsds
					#end
					</div>
					
					<div id="n-pay" style="display: none;">
					<!-- 未还 --> 
					#foreach($interest in $nRepayList)
					<div class="cho-panel-item-content">
						<table width="100%">
								<tbody class="sp_tab_tbody">
									<tr class="tr1">
										<td>本金</td>
										<td>￥$number.formatNumeric($!{interest.loanMoney})</td>
									</tr>
									<tr class="tr1">
										<td>归还金额</td>
										<td>￥$number.formatNumeric($!{interest.repayMoney})</td>
									</tr>
									
									<tr class="tr1">
										<td>剩余本金</td>
										<td>￥$number.formatNumeric($!{interest.leftMoney})</td>
									</tr>
									
									<tr class="tr1">
										<td>归还利息</td>
										<td>￥$number.formatNumeric($!{interest.interest})</td>
									</tr>
									
									<tr class="tr1">
										<td>支付利息</td>
										<td>￥$number.formatNumeric($!{interest.payInterest})</td>
									</tr>
									
									<tr class="tr1">
										<td>实际利息</td>
										<td>￥$number.formatNumeric($!{interest.realInterest})</td>
									</tr>
									
									<tr class="tr1">
										<td>还款日期</td>
										<td>$!date.format('yyyy-MM-dd',$!{interest.signRepayDate})</td>
									</tr>
									
									<tr class="tr1">
										<td>起息日期</td>
										<td>$!date.format('yyyy-MM-dd',$!{interest.interestStartDate})</td>
									</tr>
									
									<tr class="tr1">
										<td>结束日期</td>
										<td>$!date.format('yyyy-MM-dd',$!{interest.blnInstDate})</td>
									</tr>
									
									<tr class="tr1">
										<td>计息天数</td>
										<td>$!{interest.days}</td>
									</tr>
									
									<tr class="tr1">
										<td>计息利率</td>
										#set($interestRate =$!{interest.interestRate}*100)
										<td>$!number.formatDoubles($!interestRate,4)%</td>
									</tr>
								</tbody>
							</table>
						</div>
					#end
					</div>
						
						
				</section>
			</section>
                </li>
            </ul>
        </div>
    </div>
</section>

</body>
<script src="${basePath}/static/modules/bill/accebill/lib/zepto.min.js?_btv=${resourceVersion}"></script>
<script>
(function (doc, win) {
	//切换
    $('.sp-tab-switch > span').on('click',function(){
	   	  $(this).addClass('active').siblings('span').removeClass('active');
	   	  var name = $(this).data('name');  
	   	  if(name=="yes"){
	   	    $('#y-pay').show();
	   	    $('#n-pay').hide();
	   	  }else{
	   		 $('#y-pay').hide();
		   	 $('#n-pay').show();
	   	  }
    });
	
})(document, window);
</script>

<script>
 
</script>
</html>
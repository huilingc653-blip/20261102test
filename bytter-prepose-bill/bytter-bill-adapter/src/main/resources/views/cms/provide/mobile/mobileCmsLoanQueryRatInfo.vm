        }
        
        .cho-body {
            background-color: #F5F5F5;
        }

        .cho-border {
            border-top: 1px solid #EDEDED;
            padding: 0.1rem 0;
        }
        .cho-rat-item {
            background: #ffffff;
            border-radius: 0.1rem;
            width:100%;
         	height: 0.38rem;
/*             margin: 0.14rem 0.2rem; */

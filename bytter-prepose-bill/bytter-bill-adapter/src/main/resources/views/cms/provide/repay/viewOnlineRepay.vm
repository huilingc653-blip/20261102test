<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 12px; 
	text-align: center;
	border-left: 0px;
	border-right: 0px;
	background-color: #d2d2d2;
}
</style> 
<body>
	<table class="layui-table">
		<tr class="dark-table-header">
			<td colspan="4" class="voucher-title">#springMessage('cms.loan.loanRepayInfo')</td>
		</tr>
		<tr>
			##单位信息
			<td class="textRight">
				#springMessage('table.cmsProvideLoanInfo.corpId')
			</td>
			<td>
				$!{repay.corpName}
			</td>
			##收款帐号
			<td class="textRight">
				#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc')
			</td>
			<td>
				$!{repay.onlinePaymentAcc}
			</td>
		</tr>
		<tr>
			##收款帐号名称
			<td class="textRight">
				#springMessage('table.cmsProvideLoanRepay.onlinePaymentAccName')
			</td>
			<td>
				$!{repay.onlineAccName}
			</td>
			##收款开户行名称
			<td class="textRight">
				#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc.bankName')
			</td>
			<td>
				$!{repay.onlineBankName}
			</td>
		</tr>
		<tr>
			##还款金额
			<td class="textRight">
				#springMessage('table.cmsProvideLoanRepay.repayMoney')
			</td>
			<td>
				$!number.formatNumeric($!{repay.repayMoney})
			</td>
			##还款利息 
			<td class="textRight">
				#springMessage('table.cmsProvideLoanRepay.repayAccrual')
			</td>
			<td>
				$!number.formatNumeric($!{repay.repayAccrual})
			</td>
		</tr>
		<tr>
			##实付利息
			<td class="textRight">
				#springMessage('table.cmsProvideLoanRepay.onlineInterest')
			</td>
			<td>
				$!number.formatNumeric($!{repay.onlineRealityInterest})
			</td>
			##金额
			<td class="textRight">
				#springMessage('table.cmsProvideLoanRepay.onlineMoney')
			</td>
			<td>
				$!number.formatNumeric($!{repay.onlineMoney})
			</td>
		</tr>
		
		<tr class="dark-table-header">
			<td colspan="4" class="voucher-title">#springMessage('cms.loan.loanRepayInfoDetail')</td>
		</tr>
		<tr>
			##借款单号
			<td class="textRight">
				#springMessage('table.cmsProvideLoanInfo.billCode')
			</td>
			<td>
				$!{repay.infoBillCode}
			</td>
			##发放单号
			<td class="textRight">
				#springMessage('table.cmsProvideLoanSend.billCode')
			</td>
			<td>
				$!{repay.sendCode}
			</td>
		</tr>
		<tr>
			<td colspan="4">
				<table id="appTable" class="layui-table layui-form" style="width:100%;">
				    <thead>
					    <tr>
					    	<th>#springMessage('cms.provide.deferred.repayDate')</th>##还款日期
					    	<th>#springMessage('table.fcCompareAcc.interestStartDate')</th>##起息日期
					    	<th>#springMessage('table.cmsPrecativeLoanInfo.endDate')</th>##结束日期
					    	<th>#springMessage('table.provide.interestDay')</th>##计息天数
					    	<th>#springMessage('table.provide.interestRate')</th>##计息利率
					    	<th>#springMessage('cms.loan.repay.principal')</th>##本金
					    	<th>#springMessage('cms.loan.repay.repayPrincipal')</th>##归还本金
					    	<th>#springMessage('table.createRepayPlan.surplusMoney')</th>##剩余本金
					    	<th>#springMessage('cms.loan.repay.principalInterest')</th>##归还本金利息
					    	<th>#springMessage('cms.loan.repay.payInterest')</th>##支付利息
					    </tr>
				    </thead>
				    <tbody>
				    	#set ($signRepayDate = "" )
				    	#set ($rowsNum = 0 ) ##合并次数
				    	#foreach($interest in $list)
				    	<tr>
				    		#if("$!{signRepayDate}" != $!date.format('yyyy-MM-dd',$!{interest.signRepayDate}))
					    		#set ($rowsNum = 0 )
					    	#else
					    		#set ($rowsNum = $rowsNum + 1 )
					    	#end
					    	
					    	#if($!{rowsNum} == 0)
				    			<td rowspan="$!{list.size()}">$!date.format('yyyy-MM-dd',$!{interest.signRepayDate})</td>
				    		#end
				    		<td>$!date.format('yyyy-MM-dd',$!{interest.interestStartDate})</td>
					    	<td>$!date.format('yyyy-MM-dd',$!{interest.blnInstDate})</td>
					    	<td>$!{interest.days}</td>
					    	<td>$number.formatDoubleWithSix($!{interest.interestRate})</td>
					    	<td class="textRight">$number.formatNumeric($!{interest.loanMoney})</td>
					    	<td class="textRight">$number.formatNumeric($!{interest.repayMoney})</td>
					    	<td class="textRight">$number.formatNumeric($!{interest.leftMoney})</td>
					    	<td class="textRight">$number.formatNumeric($!{interest.interest})</td>
					    	<td class="textRight">$number.formatNumeric($!{interest.payInterest})</td>
					    	#set ($signRepayDate = $!date.format('yyyy-MM-dd',$!{interest.signRepayDate}) )
				    	</tr>
				    	#end
				    </tbody>
			    </table>
			</td>
		</tr>
	</table>
	
    <div style="width: 100%;text-align: center;">
		<button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>	
	</div>
	
    #parse("views/common/footer.vm")
</body>

</html>
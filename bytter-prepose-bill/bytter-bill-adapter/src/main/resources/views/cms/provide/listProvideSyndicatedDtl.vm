<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="rowNum" name="rowNum" type="hidden" value="$!{provideSyndicatedDtlVo.rowNum}">
    <input id="myBillNo" name="myBillNo" type="hidden" value="$!{provideSyndicatedDtlVo.billNo}">
    <input id="myBillId" name="myBillId" type="hidden" value="$!{provideSyndicatedDtlVo.billId}">

    <table id="syndicatedDtlDataTable" class="layui-table">
        <thead>
        <tr>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
            <th><input type="text" data-name="sumMoney" data-biz-name="sumMoney" style="width: 148px" data-minus="true"
                       class="layui-input bt-biz-moneyType" autocomplete="off" readonly="readonly"
                       placeholder="#springMessage('ttpay.sumMoney')">
            </th>
            <th></th>
        </tr>
        <tr>
            <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.cmsLoanInfo.leadingBank')</th>
            <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.cmsLoanInfo.bankCode')</th>
            <th>#springMessage('table.cmsLoanInfo.bankName')</th>
            <th>#springMessage('table.cmsLoanInfo.surplusMoney')</th>
            <th><span class="pl"><span class="required-icon">*</span></span>#springMessage( 'table.cmsLoanInfo.repaymentMoney')</th>
            <th>#springMessage('table.cmsLoanInfo.repaymentMoneyShare')</th>
            <th>#springMessage('table.cmsLoanInfo.repaymentIst')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button class="layui-btn" type="button" id="saveSyndicatedDtl">#springMessage(
                'common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage(
                'common.button.reset')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/provide/syndicatedDtl.common.js?_btv=${resourceVersion}"></script>
</html>

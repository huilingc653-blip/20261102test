            resource:'cms:provide:info:query'
        });
        uni.postMessage({
            data: data
        });
    },100);
}

function openDatePickerPage() {
   var data = BTAppBridge.openDatePickerPage && BTAppBridge.openDatePickerPage('searchActionCallback');
    uni.postMessage({
        data: data
    });
}

function openEndDatePickerPage() {
   var data = BTAppBridge.openDatePickerPage && BTAppBridge.openDatePickerPage('searchEndActionCallback');
    uni.postMessage({
        data: data
    });
}

//时间处理方法
function timestampToTime(timestamp) {
    var date = new Date(timestamp);//时间戳为10位需*1000，时间戳为13位的话不需乘1000
    Y = date.getFullYear() + '-';
    M = (date.getMonth() + 1 < 10 ? '0' + (date.getMonth() + 1) : date.getMonth() + 1) + '-';
    var D = (date.getDate() < 10 ? '0' + date.getDate() : date.getDate());
    return Y + M + D;//时分秒可以根据自己的需求加上
}

function loadMore() {
    if ($(".provide-sum-item-hidden").hasClass('show')) {//展开状态,点击后收起
        $(".provide-sum-item-hidden").hide();
        $(".provide-sum-item-hidden").removeClass("show");
        $("#innerMore").html("更多");
    } else {
        $(".provide-sum-item-hidden").show();
        $(".provide-sum-item-hidden").show();
        $(".provide-sum-item-hidden").addClass("show");
        $("#innerMore").html("收起");
    }
}


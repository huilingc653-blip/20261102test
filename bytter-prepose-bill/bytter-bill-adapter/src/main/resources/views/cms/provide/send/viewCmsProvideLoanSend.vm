<!DOCTYPE html>
<html lang="en" style="height: 100%;">
<head>
    #parse("views/common/head.vm")
</head>
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 12px; 
	text-align: center;
	border-left: 0px;
	border-right: 0px;
	background-color: #d2d2d2;
}
</style>  
<body style="padding: 0px;height: 100%;" >
	<div>
		<iframe src="${basePath}/cms/provide/loaninfo/viewLoanInfo/$!{billCode}" id="sendIframe" frameborder="0" scrolling="no" style="width: 100%;"></iframe>
		<script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
	</div>
	#if("$!sendList" != "" && $sendList.size() != 0)
	<div>
	    <table class="layui-table  breakRow">
	    	<tbody>
	    		<tr class="dark-table-header">
	    			<td colspan="8" class="voucher-title">#springMessage('cms.provide.send.detail')</td>
	    		</tr>
	    		<tr>
	    			<th>#springMessage('table.cmsProvideLoanSend.billCode')</th><!-- 借款单号 -->
	    			<th>#springMessage('table.cmsProvideLoanSend.contractCode')</th><!-- 发放合同 -->
	    			<th>#springMessage('table.cmsProvideLoanSend.money')</th><!-- 发放金额 -->
	    			<th>#springMessage('table.cmsProvideLoanSend.sendDate')</th><!-- 借款发放日期 -->
	    			<th>#springMessage('table.cmsProvideLoanSend.repayDate')</th><!-- 借款到期日期 -->
	    			<th>#springMessage('table.cmsProvideLoanSend.plRate')</th><!-- 发放利率 -->
	    			<th>#springMessage('table.cmsProvideLoanInfo.plTerm')</th><!-- 期限 -->
	    			<th>#springMessage('table.cmsProvideLoanSend.status')</th><!-- 状态 -->
	    		</tr>
	    		#foreach($send in $sendList)
	   			<tr>
	   				<td>$!{send.billCode}</td>
	   				<td>$!{send.contractCode}</td>
	   				<td>$number.formatNumeric($!{send.money})</td>
	   				<td>$!date.format('yyyy-MM-dd',$!send.sendDate)</td>
	   				<td>$!date.format('yyyy-MM-dd',$!send.repayDate)</td>
	   				<td>
	   					##set($plRate = $!{send.plRate} * 100) 
	   					$rateTag.show($!{send.plRate})
	   				</td>
	   				<td>
	   					$number.formatNumericNull($!{send.plTerm})
	   					$!{send.ternUnitName}
	   				</td>
	   				<td>$!{send.bizStatusName}</td>
	   			</tr>
	    		#end
	    	</tbody>
	    </table>
	</div>
    #end
    #parse("views/common/footer.vm")
</body>
</html>
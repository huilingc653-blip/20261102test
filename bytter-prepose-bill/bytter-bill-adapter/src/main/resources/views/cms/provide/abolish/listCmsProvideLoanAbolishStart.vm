<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="relateCon" value="$!{relateCon}">##参数设置是否对接合同管理
  <table class="layui-table">
    <tbody>
       <tr>
			##借款单号
			<td class="textRight"  width="15%">#springMessage('table.cmsProvideLoanInfo.billCode'):</td>
			<td width="35%"><input type="text" name="likes_billCode" class="layui-input"></td>

			##单位
			<td class="textRight"  width="15%">#springMessage('table.nisBillhead.corpId'):</td>
			<td  width="35%">
				<div class="layui-input-inline">
					<div class="bt-biz-corp" data-biz-type="corp" data-type="selectTree" data-name="eqs_corpId" data-resource="cms:provide:abolish:handle:query" data-scope="all"></div>
				</div>
			</td>
		</tr>


		<tr>
			##借款日期
			<td class="textRight">#springMessage('table.cmsProvideLoanInfo.plDate'):</td>
			<td>
				<div class="layui-form-item">
					<div class="layui-inline">
    					<input name="ged_plDate" class="layui-input bt-input-inline bt-biz-dateType" data-endId="led_plDate"  type="text">
   	 					<span class="date-mid">~</span>
    					<input id="led_plDate" name="led_plDate" class="layui-input bt-input-inline bt-biz-dateType"  type="text">
					</div>
				</div>
			</td>

			##到期日期
			<td class="textRight">#springMessage('table.fcAcc.deadlineDate'):</td>
			<td>
				<div class="layui-form-item">
					<div class="layui-inline">
    					<input name="ged_repayDate" class="layui-input bt-input-inline bt-biz-dateType" data-endId="led_repayDate"  type="text">
   	 					<span class="date-mid">~</span>
    					<input id="led_repayDate" name="led_repayDate" class="layui-input bt-input-inline bt-biz-dateType"  type="text">
					</div>
				</div>
			</td>
		</tr>

		<tr>
			##作废申请日期
			<td class="textRight">#springMessage('table.fcAccbookExtHis.invalidOpTime'):</td>
			<td>
				<div class="layui-form-item">
					<div class="layui-inline">
    					<input name="ged_abolishedDate" class="layui-input bt-input-inline bt-biz-dateType" data-endId="led_abolishedDate" type="text">
   	 					<span class="date-mid">~</span>
    					<input id="led_abolishedDate" class="layui-input bt-input-inline bt-biz-dateType"  type="text" data-callback="formatDate">
    					<input id="date" type="hidden" name="led_abolishedDate">
					</div>
				</div>
			</td>

			##借款金额
			<td class="textRight">#springMessage('table.cmsProvideLoanInfo.plMoney'):</td>
			<td  width="25%">
				<div class="layui-form-item">
    				<div class="layui-inline">
      	  				<input data-name="geg_plMoney" class="layui-input bt-input-inline  bt-biz-moneyType" data-moneyendid="t2" type="text">
       					<span class="date-mid">~</span>
       					<input data-name="leg_plMoney" class="layui-input bt-input-inline  bt-biz-moneyType" id="t2"  type="text">
   					</div>
				</div>
			</td>
		</tr>

		<tr>
			##状态
			<td class="textRight">#springMessage('table.btBankAcc.status'):</td>
			<td>
				<div class="layui-form">
    				<div class="bt-biz-dict" data-type="select" data-group="cms.bizStatus.abolish"  data-name="eqs_bizStatus"  data-width="120px"></div>
				</div>
			</td>
			<td></td>
			<td></td>
		</tr>

		<tr>
##			#if($shiro.hasPermission("cms:provide:abolish:handle:query"))
			<td colspan="6" style="text-align: center;">
				<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
		        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</td>
##			#end
		</tr>
</tbody>
</table>
</form>


<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
    	<th>#springMessage('table.abBillTransfer.applyCorp')</th>
    	<th>#springMessage('table.cmsProvideLoanInfo.bankId')</th>
    	<th>#springMessage('table.cmsProvideLoanInfo.billCode')</th>
    	<th>#springMessage('table.fcAcc.contractNo')</th>
    	<th>#springMessage('table.cmsProvideLoanInfo.plMoney')</th>
    	<th>#springMessage('table.btBankAccCur.cur')</th>
    	<!-- <th>#springMessage('table.cmsProvideLoanAbolish.send.money')</th>
    	<th>#springMessage('table.cmsProvideLoanAbolish.send.cur')</th> -->
    	<th>#springMessage('table.cmsProvideLoanInfo.plDate')</th>
    	<th>#springMessage('table.fcAcc.deadlineDate')</th>
    	<th>#springMessage('table.cmsProvideLoanInfo.plTerm')</th>
    	<th>#springMessage('table.fcAccbookExtHis.invalidOpTime')</th>
    	<th>#springMessage('table.btBankAcc.status')</th>
    	<th>#springMessage('common.table.thead.operation')</th>



    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/provide/cmsProvideLoanAbolishStart.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input id="tempOrSubmitSign" name="tempOrSubmitSign" value="0" type="hidden">
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位代码
            <td class="textRight" width="25%">#springMessage('table.cmsProvideLoanInfo.corpId')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-type="selectTree" data-name="eqs_corpId"
                         placeholder="#springMessage('table.cmsProvideLoanInfo.corpId')"
                         data-resource="cms:provide:repqy:query" data-scope="all"></div>
                </div>
            </td>
            ##借款单号
            <td class="textRight" width="25%">#springMessage('table.cmsProvideLoanInfo.billCode')</td>
            <td width="25%">
                <input name="likes_infoBillCode" class="layui-input"
                       placeholder="#springMessage('table.cmsProvideLoanInfo.billCode')">
            </td>
        </tr>
        <tr>
            ##借款合同号
            <td class="textRight" width="25%">#springMessage('table.cmsProvideLoanInfo.contractNo')</td>
            <td width="25%">
                <input name="likes_contractCode" class="layui-input"
                       placeholder="#springMessage('table.cmsProvideLoanInfo.contractNo')">
            </td>
            ##到期日期
            <td class="textRight" width="25%">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td width="25%" class="input100">
                <div class="layui-inline">
                    <input id="ged_sendDueDatae" name="ged_sendDueData" data-endid="led_sendDueData"
                           placeholder="#springMessage('table.cmsProvideLoanSend.repayDate')"
                           class="layui-input bt-biz-dateType" data-type="date" type="text">
                </div>
                <div class="layui-inline">
                    ~
                </div>
                <div class="layui-inline">
                    <input id="led_sendDueData" name="led_sendDueData" class="layui-input bt-biz-dateType"
                           placeholder="#springMessage('table.cmsProvideLoanSend.repayDate')"
                           data-type="date" type="text">
                </div>
            </td>
        </tr>
        <tr>
        ##				借款银行
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.bankId')</td>
            <td>
                <input type="text" name="likes_bankName" id="bankName" class="layui-input"
                       placeholder="#springMessage('table.cmsProvideLoanInfo.bankId')" >
            </td>
            ##				创建人
            <td class="textRight">#springMessage('table.sysAttachment.createBy')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="likes_createName" id="userName" class="layui-input"
                           placeholder="#springMessage('table.sysAttachment.createBy')" >
                </div>
            </td>
        </tr>
        <tr>
##            #if($shiro.hasPermission("cms:provide:repqy:query"))
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                        'common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
                </td>
##            #end
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsProvideLoanInfo.corpId')</th><!-- 申请单位 -->
        <th>#springMessage('table.cmsProvideLoanInfo.billCode')</th><!-- 借款单号 -->
        <th>#springMessage('table.cmsProvideLoanInfo.contractNo')</th><!-- 借款合同号 -->
        <th>#springMessage('table.cmsProvideLoanInfo.bankId')</th><!-- 借款银行 -->
        <th>#springMessage('table.cmsProvideLoanSend.billCode')</th><!-- 发放单号 -->
        <!-- <th>#springMessage('table.cmsProvideLoanInfo.plAccount')</th>借款账号 -->
        <th>#springMessage('table.fcAccbook.enrolTime')</th><!-- 录入日期 -->
        <th>#springMessage('table.cmsProvideLoanInfo.curId')</th><!-- 币别 -->
        <th>#springMessage('table.cmsProvideLoanSend.money')</th><!-- 发放金额 -->
        <th>#springMessage('table.cmsProvideLoanRepay.plBalance')</th><!-- 借款余额 -->
        <th>#springMessage('table.cmsProvideLoanSend.sendDate')</th><!-- 发放日期 -->
        <th>#springMessage('table.cmsProvideLoanSend.repayDate')</th><!-- 到期日期 -->
        <th>#springMessage('table.cmsProvideLoanSend.repayType')</th><!-- 还款方式 -->
        <th>#springMessage('预计还款日期')</th><!-- 还款日期 -->
        <th>#springMessage('预计还款本金')</th><!-- 还款本金 -->
        <th>#springMessage('预计还款利息')</th><!-- 还款利息 -->
        <th>#springMessage('table.cmsProvideLoanInfo.plClass')</th><!-- 借款种类 -->
        #if($!{gua}=="1")
            <th>#springMessage('table.cmsProvideLoanInfo.plType')</th><!-- 担保方式 -->
        #end
        <th>#springMessage('table.cmsProvideLoanInfo.plTerm')</th><!-- 借款期限 -->
        <th>#springMessage('table.cmsLoanSend.deferredReplayDate')</th><!-- 展期到期日期 -->
        <th>#springMessage('table.sysAttachment.createBy')</th><!-- 创建人 -->
        <th>#springMessage('table.cmsProvideLoanInfo.status')</th><!-- 状态 -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
<form class="layui-form" id="budgetForm">
    <!-- 预算 -->
    <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
    <input id="repayItem" name="repayItem" type="hidden" value="$!{repayItem}">
    <input id="defItemCode" name="defItemCode" type="hidden" value="$!{defItemCode}">
    <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
    <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
    <!-- 资金计划 -->
    <div id="tagItemDetail"></div>
</form>

    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    // debugger;
    var repayPlan = "$!{repayPlan}";
    var showSign;
    var dataUrl;
    var dateTypes;
    var moneyType;
    var form;
    var selectType;
    var thisbuttons = [
        {
            extend: "colvis",
            text: bt.lang('common.button.theadHide'),
            columns: ':not(:first):not(:last)'
        }
    ];
    var isBudgetValue = '1';
    var noBudgetCount = 0;

    switch (repayPlan) {
        case "1":
            dataUrl = basePath + "/cms/provide/loanrepay/dataRepayPlanable";
            showSign = true;
            break;
        case "2":
            dataUrl = basePath + "/cms/provide/loanrepay/dataInterestWayable";
            showSign = false;
            break;
        case "3":
            dataUrl = basePath + "/cms/provide/loanrepay/dataFolatingModeable";
            showSign = false;
            break;
        default:
            dataUrl = basePath + "/cms/provide/loanrepay/dataAppTable";
            showSign = false;
            thisbuttons = [
                {
                    hide: bt.isnotResource('cms:provide:repqy:edit'),
                    text: bt.lang('cms.button.loanRepayBatch'),
                    action: function (e, dt, node, config) {
                        var data = dt.rows('.selected').data();
                        loanRepayBatch(data);
                    }
                },
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ];
    }
    bt.use(['form', 'datatable', 'corp', 'moneyType', 'dateType', 'itemType','dicts', 'selectType'], function () {
        $ = bt.jquery, form = bt.form();
        corps = bt.corp.init();
        moneyType = bt.moneyType.init();
        dataTypes = bt.dateType.init();
        itemType = bt.itemType.init();
        selectType = bt.selectType.init();

        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            checkbox: true,
            ajax: {
                'url': dataUrl
            },
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            buttons: thisbuttons ,
            fixedColumns: {
                rightColumns: 1//代表冻结右边一列
            }
            , columns: [
                {data: "corpName", bSortable: true},
                {data: "infoBillCode", bSortable: true},
                {data: "contractCode", bSortable: true},
                {data: "bankName", bSortable: true},
                {data: "sendCode", bSortable: true},
                /* {data:"loanAcc"}, */
                {data: "createDate", bSortable: true},
                {data: "curName"},
                {
                    data: "sendMoney",
                    bSortable: true,
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.sendMoney);
                    }
                },
                {
                    data: "plBalance",
                    bSortable: true,
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.plBalance);
                    }
                },
                {data: "sendData", bSortable: true},
                {data: "sendDueData", bSortable: true},
                {data: "repayTypeName"},
                {data: "repayDate", bSortable: false},
                {
                    data: "repayMoney",
                    bSortable: false,
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return full.repayDate ? bt.money.format(full.repayMoney) : "";
                    }
                },
                {
                    data: "revertAccrual",
                    bSortable: false,
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return full.repayDate ? bt.money.format(full.revertAccrual) : "";
                    }
                },
                {data: "plClassName"},
                #if($!{gua}=="1")
                    {data: "plTypeName"},
                #end
                {
                    data: "plTerm", bSortable: true, render: function (data, type, full, meta) {
                        var htm = ""
                        if (full.plTerm == null) {
                            htm += 0 + "";
                        } else {
                            htm += full.plTerm;
                        }
                        return htm + bt.dict('PrecativeLoanInfo.ternUnit',full.ternUnit);
                    }
                },
                {data: "deferredRepayDate", bSortable: true, className: "center", visible: showSign},
                {data: "createName", bSortable: true},
                {
                    data: "status",bSortable: false, render: function (data, type, full, meta) {
                        return bt.dict('cms.bizStatus', full.bizStatus);
                    }
                },
                {
                    data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
                        var html = "";
                        switch (repayPlan) {
                            case "1":
                                html = '<a class="" href="#" data-row="' + meta.row + '" onclick="editRepayPlan(this,repayPlan)">' + bt.lang("cms.loan.RepaymentPlanModify") + '</a>';
                                break;//修改还款计划
                            case "2":
                                html = '<a class="" href="#" data-row="' + meta.row + '" onclick="editRepayPlan(this,repayPlan)">' + bt.lang("cms.loan.InterestWayModify") + '</a>';
                                break;//修改计息方式
                            case "3":
                                html = '<a class="" href="#" data-row="' + meta.row + '" onclick="editRepayPlan(this,repayPlan)">' + bt.lang("cms.loan.FolatingModeModify") + '</a>';
                                break;//修改浮动方式
                            default:
                                html = '\<span class="text-explode">|</span>\<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a> ';
                                if (bt.isResource('cms:provide:repqy:edit')) {
                                    html += '\<span class="text-explode">|</span>\<a class="" href="#" data-row="' + meta.row + '" onclick="edit(this,\'0\')">' + bt.lang("cms.loanRepay.add") + '</a> ';
                                    html += '\<span class="text-explode">|</span>\<a class="" href="#" data-row="' + meta.row + '" onclick="edit(this,\'1\')">' + bt.lang("cms.loanRepay.addOnline") + '</a> ';
                                }
                        }
                        html += '\<span class="text-explode">|</span>\<a class="" href="#" data-row="' + meta.row + '" onclick="repayInterest(this)">' + bt.lang('cms.button.provideInterest') + '</a>';
                        html += '\<span class="text-explode">|</span>\<a class="" href="#" data-row="' + meta.row + '" onclick="listMsg(this)">' + bt.lang("common.button.logInfo") + '</a>';
                        return html;
                    }
                }
            ],
            btClickRowCallback: function (data) {
                if( repayPlan=="") {
                    //判断系统是否挂资金计划
                    var budgetSel = $("#budgetSel").val();
                    isBudgetValue = '1'
                    noBudgetCount = 0;
                    if (budgetSel == "1") {
                        //判断借款挂接资金计划科目是否为空，不为空则挂资金计划
                        var repayItem = $("#repayItem").val();
                        var selectData = bt.datatable.getSelectData("#appTable");
                        if (repayItem !== "" && selectData.length > 0) {
                            var corpId = []
                            var curId = '';
                            for (i = 0; i < selectData.length; i++) {
                                curId = selectData[0].curId;
                                if (curId != selectData[i].curId) {
                                    // 所选借款必须是同一种币种
                                    layer.alert(bt.lang('cms.message.loanrepay.currencySame'), {icon: 7});
                                } else {
                                    if (corpId.indexOf(selectData[i].corpId) === -1) {
                                        corpId.push(selectData[i].corpId)
                                    }
                                }
                                // 判断此单位是否挂资金计划
                                isBudget(selectData[i].corpId);
                            }
                            if (isBudgetValue == '1') {
                                    $genOtherHtml(corpId.join(','), curId);
                            } else if (noBudgetCount !== selectData.length) {
                                layer.alert(bt.lang('fbs.budget.process.message.corp.reportBudget'), {icon: 7});
                            }
                        } else {
                            $("#tagItemDetail").html("");
                        }
                    }
                }
            },

            summary: {
                pageSum: true,//小计功能开启
                selectSum: true,//已选汇总功能开启
                //groupColumn: 'curName',//分类汇总列参数
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '8', //汇总列序号
                        dataName: 'sendMoney' //汇总列发放金额
                    },
                    {
                        colNum: '9', //汇总列序号
                        dataName: 'plBalance' //汇总列发放金额
                    }
                ]
            }
        });
    });

    function edit(el, sign) {
        // debugger;
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        var tempOrSubmitSign = $("#tempOrSubmitSign").val();
        var url = basePath + "/cms/provide/loanrepay/edit?sendCode=" + data.sendCode + "&tempOrSubmitSign=" + tempOrSubmitSign + "&onlineSign=" + sign;
        if (parent.bt.navtab) {
            parent.bt.navtab.addNavtab(bt.lang('common.add.data'), url);
            return;
        }
        top.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: url,
            end: function () {
                datatable && datatable.draw();
            }
        });
    }

    function view(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (parent.bt.navtab) {
            parent.bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/provide/loanrepay/viewRepay?sendBillCode=" + data.sendCode + "&repayId=" + data.repayId + "&show=1");
            return;
        }
        top.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/provide/loanrepay/viewRepay?sendBillCode=" + data.sendCode + "&repayId=" + data.repayId + "&show=1"
        });
    }

    function editRepayPlan(el, repayPlan) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        var path = "";
        if (repayPlan == "1") {
            if (isNull(data.deferredRepayDate)) {
                path = basePath + "/cms/basedata/updaterepaymentschedule/toRepayPlanUpdate?" + "billCode=" + data.sendCode + "&type=0";
            } else {
                path = basePath + "/cms/basedata/updaterepaymentschedule/toRepayPlanUpdate?" + "billCode=" + data.sendCode + "&type=0" + "&deferredRepayDate=" + data.deferredRepayDate + "&zqRate=" + data.deferredRate;
            }
        } else if (repayPlan == "2") {
            path = basePath + "/cms/provide/cmsinterestway/list?" + "sendCode=" + data.sendCode + "&id=" + data.id;
        } else if (repayPlan == "3") {
            path = basePath + "/cms/provide/cmsFloatingMode/list?" + "billCode=" + data.sendCode + "&id=" + data.id;
        }

        if (data) {
            if (parent.bt.navtab) {
                parent.bt.navtab.addNavtab(bt.lang('common.button.add'), path);
                return;
            }
            top.layer.open({
                type: 2,
                area: ['850px', '530px'],
                maxmin: true,
                content: path,
                end: function () {
                    billTable.draw();
                }
            });
        }
    }

    /**
     * 判断是否为空 true：空 false:不为空
     * @param data
     */
    function isNull(data) {
        return (data == "" || data == undefined || data == null) ? true : false;
    }

    //日志列表
    function listMsg(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (data) {
            if (parent.bt.navtab) {
                parent.bt.navtab.addNavtab(bt.lang('common.button.logInfo'), basePath + "/cms/basedata/cmsprocessmsg/list?billCode=" + data.infoBillCode + "," + data.sendCode);

            }
        }
    }

    /**加载利息预计明细*/
    function repayInterest(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('cms.button.provideInterest'), basePath + "/cms/provide/cmsprovideinterest/list?sendBillCode=" + data.sendCode + "&showSign=0&repairSign=0");
        }
    }

    //根据单位ID和业务类型判断是否挂预算
    function isBudget(corpId) {
        $.ajax({
            type: 'POST',
            url: basePath + "/cms/provide/loanrepay/isBudget",
            data: {'corpId': corpId},
            async: false,
            dataType: 'json',
            success: function (result) {
                if (result.success) {
                    if (result.attributes.isBudget) {
                        if (isBudgetValue == '0') {
                            isBudgetValue = '0'
                            $("#tagItemDetail").html("");
                        } else {
                            isBudgetValue = '1'
                        }
                    } else {
                        if (result.attributes.isBudget === false) {
                            noBudgetCount++;
                        }
                        isBudgetValue = '0'
                        $("#tagItemDetail").html("");
                    }
                } else {
                    isBudgetValue = '0'
                    $("#tagItemDetail").html("");
                }
            }
        });
    }

    // 生成公共的属性
        $genOtherHtml = function (corpId, curId) {
        var $ = bt.jquery;
        var itemCode = $('input[name="repayItem"]').val();
        var param = {
            corpId: corpId,
            itemCode: itemCode,
            defItemCode: $("#defItemCode").val(),
            processDate: bt.date.format(new Date(), "yyyy-MM-dd"),
            curId: curId,
            type: 'select',
            date: (new Date()).getTime(),
            isMultiItem: '0'
        };
        $.ajax({
            type: 'post',
            url: basePath + "/budget/fbsBudgetProcess/getItemDetail",
            data: param,
            async: true,
            success: function (json) {
                $("#budgetDiv").show();
                $("#tagItemDetail").html("");
                $("#tagItemDetail").html(json);
                $("#tagItemDetail").show();
            },
        });
    };

    //批量线下还款
    function loanRepayBatch(data) {
        if (!bt.form().verifyFun('#budgetForm')) {
            return false;
        }
        var len = data.length;
        if (!len) {
            layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 7});
            return;
        }
        var repayMoney = 0;
        // 所选借款必须是同一种币种
        var curId = data[0].curId;
        for (var i = 0; i < data.length; i++) {
            if (curId != data[i].curId) {
                layer.alert(bt.lang('cms.message.loanrepay.currencySame'), {icon: 7});
                return;
            }
            var repayNum = data[i].repayMoney
            var revertAccrualNum = data[i].revertAccrual
            var money = repayNum - 0 + revertAccrualNum;

            repayMoney = repayMoney + money
        }
        var budgetSel = $("#budgetSel").val();
        var itemCode;
        var itemName;
        if (budgetSel == "1") {
            //资金计划数据
            var budgetList = [];
            //资金计划科目代码信息
            var itemCodeStr = "";
            if ($("input[name='sumMoney']").length) {
                //判断是否挂接资金计划
                var sumMoney = bt.moneyType.get("sumMoney").val();
                // 校验金额与资金计划总金额一致
                if (sumMoney && repayMoney != sumMoney) {
                    layer.alert(bt.lang("provide.loanrepay.message.budgetMoney"), {icon: 2});
                    return;
                }
                var trs = $("#budgetProcessDataTable").children("div[row]");
                if (trs && trs.length) {
                    $(trs).each(function (m, n) {
                        var i = $(n).attr("row");
                        var budgetObj = {};
                        budgetObj['itemCode'] = itemType.get("itemCode" + i).val();
                        budgetObj['itemName'] = $("#itemName" + i).val();
                        budgetObj['processMoney'] = moneyType.get("processMoney" + i).val();
                        // 获取资金计划数据
                        itemCode = itemType.get("itemCode" + i).val();
                        itemName = $("#itemName" + i).val();
                        if (itemCodeStr) {
                            itemCodeStr = itemCodeStr + ";" + budgetObj['itemCode'];
                        } else {
                            itemCodeStr = budgetObj['itemCode'];
                        }
                        budgetList.push(budgetObj);
                    })
                }
            }
        }
        // 确定将所选借款最近一期未还的还款计划进行归还吗？
        parent.layer.confirm(bt.lang('cms.message.loanrepay.batchSubmit'), function () {
            var loanRepayBatchObj = {};
            var loanRepayBatchList = [];

            var rowData = data.splice(0, len);
            for (var i = 0; i < rowData.length; i++) {
                var processMoney = rowData[i].repayMoney - 0 + rowData[i].revertAccrual;
                loanRepayBatchObj = {
                    corpId: rowData[i].corpId,
                    sendCode: rowData[i].sendCode,
                    createDate: rowData[i].createDate,
                    repayDate: rowData[i].repayDate,   //还款日期
                    repayMoney: rowData[i].repayMoney,  //还款金额
                    repayAccrual: rowData[i].revertAccrual,// 还款利息
                    provideInterestId: rowData[i].provideInterestId,  //借款利息预计明细ID
                    itemCode: [itemCode],
                    itemName: [itemName],
                    processMoney: [processMoney],
                };
                loanRepayBatchList.push(loanRepayBatchObj);
            }

            bt.loading.show();//显示加载中
            bt.jquery.ajax({
                type: 'post',
                contentType: 'application/json; charset=UTF-8',
                data: JSON.stringify({
                    "loanRepayBatchList": loanRepayBatchList
                }),
                asycn: false,
                url: basePath + "/cms/provide/loanrepay/batchSubmit",
                success: function (result) {
                    bt.loading.hide(); //关闭加载中
                    parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                    if (result.success) {
                        //刷新当前页面
                        bt.navtab.refreshCurrent();
                    }
                },
                dataType: 'json'
            });
        });
    }

</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<!-- 借款展期处理页面 -->
<body>
<iframe src="${basePath}/cms/provide/loansend/viewSend/$!{deferredvo.provideCode}" id="sendIframe" frameborder="0" scrolling="no" style="width: 100%;"></iframe>
<script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
<form class="layui-form" method="post">

	<input id="id" name="id" type="hidden" value="$!{deferredvo.id}">
	<input id="id" name="id" type="hidden" value="$!{provideLoanDeferred.id}">
	##借款利率
	<input type="hidden" name="plRate" id="plRate" value="$!{plRate}">
	<table class="layui-table">
	<tbody>
		<!-- <tr>
			##到期处理类型
			<td class="textRight" width="14%">#springMessage('cms.provide.deferred.expiryhandletype')</td>
			<td width="36%">
				<DIV class=layui-form>
					$dictTag.get("provide.deferredHandleType",$!provideLoanDeferred.expiryHandleType)
			</td>
			<td colspan="2"></td>
		</tr> -->
		<tr>
			##展期到期日期
			<td class="textRight" width="14%">#springMessage('table.fcAcc.delayDeadlineDate')</td>
			<td width="36%">
				$!date.format('yyyy-MM-dd',$!provideLoanDeferred.deferredRepayDate)
				<input value="$!date.format('yyyy-MM-dd',$!provideLoanDeferred.deferredRepayDate)" type="hidden" name="deferredRepayDate">
			</td>
			##展期期限
			<td class="textRight" width="14%">#springMessage('table.cmsProvideLoanDeferred.deferredLimt')</td>
			<td width="36%">
				$!{provideLoanDeferred.deferredLimt} $dictTag.get("PrecativeLoanInfo.ternUnit",$!provideLoanDeferred.ternUnit)
				<input value="$!{provideLoanDeferred.deferredLimt}" type="hidden" name="deferredLimt">
				<input value="$!{provideLoanDeferred.ternUnit}" type="hidden" name="ternUnit">
			</td>
		</tr>

		<tr>
			##展期利率
			<td class="textRight">#springMessage('table.fcAcc.delayRate')</td>
			<td>
				#if($!{isBankBaseRate} != "1")
					<div id="deferred" class="layui-inline">
						#springMessage('cms.loanInfo.deferredPoints')
						<div class="pl rateWrap layui-inline" style="width:104px;margin-right: 5px">
							<input class="layui-input bt-biz-moneyType input-inline textRight" id="deferredPoints"
								   name="deferredPoints"
								   data-max="100"
								   data-min="0"
								   value="$!{provideLoanDeferred.deferredPoints}"
								   data-biz-name="deferredPoints"
								   data-decimal="2" data-minus="true"
								   style="border: none; width: 80px;"
								   readonly="readonly"
							>
							<span name="percentsymbol" class="inputMark">BP</span>
						</div>
					</div>
				#else
				#end
				<div class="layui-inline">
					<input type="text" data-name="poundageRate" data-biz-name="poundageRate"
						   data-max="100" class="layui-input bt-biz-rateType"   style="float: left" readonly="readonly"
						   value="$!{provideLoanDeferred.deferredRate}">

					<input value="$!{provideLoanDeferred.deferredRate}"  type="hidden" name="deferredRate">
				</div>
			</td>

			##备注
			<td class="textRight">#springMessage('table.bvStorageBox.rmk')</td>
			<td>
				$!{provideLoanDeferred.rmk}
			</td>
		</tr>

		<tr>
			<td class="textRight">
				#springMessage('table.cmsPrecativeLoanDeferred.contractCode')
			</td>
			<td>
				$!{provideLoanDeferred.contractCode}
			</td>
			<td colspan="2"></td>
		</tr>

		<tr>
			<td colspan="6" style="text-align: center;">
				<button class="layui-btn" value="110" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
				<button class="layui-btn" value="-10"  lay-submit="" lay-filter="submit">#springMessage('common.button.back')</button>
				<button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>
			</td>
		</tr>
	</tbody>
	</table>
</form>
	#parse("views/common/footer.vm")
</body>

<script
	src="${basePath}/static/modules/cms/provide/provideLoanHandle.add.js?_btv=${resourceVersion}"></script>
</html>

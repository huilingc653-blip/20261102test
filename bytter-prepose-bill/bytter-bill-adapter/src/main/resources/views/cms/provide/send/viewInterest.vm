<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input type="hidden" value="$!{sendId}" id="sendId">
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>还款日期</th>
        <th>起息日期</th>
        <th>结束日期</th>
        <th>计息天数</th>
        <th>计息利率</th>
        <th>本金</th>
        <th>归还本金</th>
        <th>剩余本金</th>
        <th>归还本金利息</th>
        <th>支付利息</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form','moneyType','dateType','bttable'], function(){
        $ = bt.jquery,form = bt.form(),moneyFun = bt.moneyType.getFun();
        bt.moneyType.init();//金额
        bt.dateType.init();//日期
        //生成列表
        bt.bttable.init({
            elem: "#appTable",
            urldata: {sendId: $("#sendId").val()},
            url: basePath + "/cms/provide/loansend/getInterest",
            columns:[
                {data:"repayDate"},
                {data:"interestStartDate"},
                {data:"blnInstDate"},
                {data:"days"},
                {data:"interestRate"},
                {data:"loanMoney"},
                {data:"repayMoney"},
                {data:"leftMoney"},
                {data:"interest"},
                {data:"payInterest"}
            ]
        });
    });
</script>
</html>

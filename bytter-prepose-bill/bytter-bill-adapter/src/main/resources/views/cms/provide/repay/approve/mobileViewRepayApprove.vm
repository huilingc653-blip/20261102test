<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
	<ul class="mui-table-view" id="mulTable">
		##申请单位
		<li class="mui-table-view-cell">
        	#springMessage('table.cmsProvideLoanInfo.corpId')
	        <span class="mui-badge mui-badge-inverted">
	            $!{loanInfo.corpName}
	        </span>
    	</li>
    	##借款种类
    	<li class="mui-table-view-cell">
      		#springMessage('table.cmsProvideLoanInfo.plClass')
	        <span class="mui-badge mui-badge-inverted">
	            $!{loanInfo.plClassName}
	        </span>
    	</li>
    	##借款单号
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.billCode')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.billCode}
			</span>
		</li>
		##借款合同号
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.contractNo')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.contractNo}
			</span>
		</li>
		##借款银行
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.bankId')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.bankName}
			</span>
		</li>
		##借款银行账号
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.plAccount')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.plAccount}
			</span>
		</li>
		##借款币种
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.curId')
			<span class="mui-badge mui-badge-inverted">
				$!{loanInfo.curName}
			</span>
		</li>
		##发放金额
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.money')
			<span class="mui-badge mui-badge-inverted">
				$number.formatNumeric(${loanSend.money})
			</span>
		</li>
		##还款在途金额
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanRepay.repayPassage')
			<span class="mui-badge mui-badge-inverted">
				$number.formatNumeric(${repayPassage})
			</span>
		</li>
		##已还款金额
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanRepay.repayFinish')
			<span class="mui-badge mui-badge-inverted">
				$number.formatNumeric(${repayFinish})
			</span>
		</li>
		##发放单号
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.billCode')
			<span class="mui-badge mui-badge-inverted">
				$!{loanSend.billCode}
			</span>
		</li>
		##发放合同号
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.contractCode')
			<span class="mui-badge mui-badge-inverted">
				$!{loanSend.contractCode}
			</span>
		</li>
		##发放日期
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.sendDate')
			<span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!loanSend.sendDate)
			</span>
		</li>
		##到期日期
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.repayDate')
			<span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!loanSend.repayDate)
			</span>
		</li>
		##浮动方式
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.floatWay')
			<span class="mui-badge mui-badge-inverted">
				$!{loanSend.floatWayName}
			</span>
		</li>
		##利率调整生效日期
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.rateEntriesEffectDate')
			<span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!loanSend.rateEntriesEffectDate)
			</span>
		</li>
		##计息方式
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.interestWay')
			<span class="mui-badge mui-badge-inverted">
				$!{loanSend.interestWayName}
			</span>
		</li>
		##浮动利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.floatRate')(#springMessage('table.cmsLoanType.type'))
			<span class="mui-badge mui-badge-inverted">
				##基准利率类型
				$!{loanSend.referenceRateTypeName}
			</span>
		</li>
		##浮动利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.floatRate')(#springMessage('table.cmsLoanInfo.ternUnit'))
			<span class="mui-badge mui-badge-inverted">
				##贷款周期
				$!{loanSend.repayCycleName}
			</span>
		</li>
		##浮动利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.floatRate')(#springMessage('table.cmsLoanInfo.pointsProportionSelect'))
			<span class="mui-badge mui-badge-inverted">
				##点数或者浮动比例选择与文本
				$!{loanSend.pointsProportionSelectName} $number.formatNumeric($!{loanSend.pointsProportionText})
			</span>
		</li>
		##借款利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanInfo.plRate')
			<span class="mui-badge mui-badge-inverted">
				$rateTag.show($!{loanSend.plRate})
			</span>
		</li>
		##逾期利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.overdueRate')
			<span class="mui-badge mui-badge-inverted">
				$rateTag.show($!{loanSend.overdueRate})
			</span>
		</li>
		##展期利率
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanSend.deferredRate')
			<span class="mui-badge mui-badge-inverted">
				$rateTag.show($!{loanSend.deferredRate})
			</span>
		</li>
		
		<li class="mui-table-view-divider">
       		#springMessage('cms.repayment.info')
    	</li>
    	##还款日期
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanRepay.repayDate')
			<span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!repay.repayDate)
			</span>
		</li>
		##还款金额
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanRepay.repayMoney')
			<span class="mui-badge mui-badge-inverted">
				$number.formatNumeric(${repay.repayMoney})
			</span>
		</li>

		#if("$!{repay.onlineSign}" == "1" && "$!{downSign}" != "0")
		##线上还款
			##备注
            <li class="mui-table-view-cell">
				#springMessage('table.cmsProvideLoanRepay.rmk')
                <span class="mui-badge mui-badge-inverted">
					$!{repay.rmk}
				</span>
            </li>
			##还款利息
        	<li class="mui-table-view-cell">
				#springMessage('table.cmsProvideLoanRepay.repayAccrual')
       			<span class="mui-badge mui-badge-inverted">
					$!{repay.repayAccrual}
				</span>
			</li>


			##实付利息
       		<li class="mui-table-view-cell">
				#springMessage('table.cmsProvideLoanRepay.onlineInterest')</td>
				<span class="mui-badge mui-badge-inverted">
					$!{repay.onlineRealityInterest}
				</span>
			</li>

			##金额
        	<li class="mui-table-view-cell">
				#springMessage('table.cmsProvideLoanRepay.onlineMoney')
                <span class="mui-badge mui-badge-inverted">
					$!{repay.onlineMoney}
				</span>
			</li>

			##收款帐号
        	<li class="mui-table-view-cell">
				#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc')</td>
                <span class="mui-badge mui-badge-inverted">
					$!{repay.onlinePaymentAcc}
				</span>
			</li>

			##收款帐号名称
        	<li class="mui-table-view-cell">
				#springMessage('table.cmsProvideLoanRepay.onlinePaymentAccName')
                <span class="mui-badge mui-badge-inverted">
					$!{repay.onlineAccName}
				</span>
			</li>

			##收款开户行名称
        	<li class="mui-table-view-cell">
				#springMessage('table.cmsProvideLoanRepay.onlinePaymentAcc.bankName')
                <span class="mui-badge mui-badge-inverted">
					$!{repay.onlineBankName}
				</span>
			</li>

			##用途
        	<li class="mui-table-view-cell">
				#springMessage('table.cmsProvideLoanRepay.onlinePurpose')
                <span class="mui-badge mui-badge-inverted">
					$!{repay.onlinePurpose}
				</span>
			</li>

		#elseif("$!{repay.onlineSign}" == "0" || "$!{downSign}" == "0")
		##线下还款
			##备注
            <li class="mui-table-view-cell">
				#springMessage('table.cmsProvideLoanRepay.rmk')
                <span class="mui-badge mui-badge-inverted">
					$!{repay.rmk}
				</span>
			</li>

			##还款利息
            <li class="mui-table-view-cell">
				#springMessage('table.cmsProvideLoanRepay.repayAccrual')
                <span class="mui-badge mui-badge-inverted">
					$!{repay.repayAccrual}
				</span>
			</li>


		<!-- ##归还利息
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanRepay.repayAccrual')
			<span class="mui-badge mui-badge-inverted">
				$number.formatNumeric(${repay.repayAccrual})
			</span>
		</li> -->
		##跳过还款补录
		<li class="mui-table-view-cell" >
			#springMessage('table.cmsProvideLoanRepay.acrossRepair')
			<span class="mui-badge mui-badge-inverted">
				$dictTag.get("sf_yn",$!repay.acrossRepair)
			</span>
		</li>
		#end

		## 是否提前还款
		<li class="mui-table-view-cell" >
			#springMessage('table.cmsProvideLoanRepay.isAdvancedRepay')
			<span class="mui-badge mui-badge-inverted">
				$dictTag.get("cms.repay.isAdvancedRepay",$!repay.isAdvancedRepay)
			</span>
		</li>
		## 创建人
		<li class="mui-table-view-cell" >
			#springMessage('table.sysAttachment.createBy')
			<span class="mui-badge mui-badge-inverted">
				$!{repay.createName}
			</span>
		</li>
	#*#if("$!{repay.bizStatus}" == "51" || "$!{repay.acrossRepair}" == "1")
		<li class="mui-table-view-divider">
       		#springMessage("cms.loan.loanRepayInfo")
    	</li>
    	##还款利息
		<li class="mui-table-view-cell">
			#springMessage('table.cmsProvideLoanRepay.repayAccrual')
			<span class="mui-badge mui-badge-inverted">
				$number.formatNumeric($!{repay.repayAccrual})
			</span>
		</li>
	#end*#

     #if($!{budgetSel} == "1")
			 #set($fbsBudgetItemDetail = $fbsBudgetTag.getViewItemDetailMobile($!{repay.billCode}, "", $!{businessName}, $!{processSysname},$!{repay.corpId}, $!{ProcessDate}))
			 #parse("views/budget/fbsbudget.vm")
	 #end


	</ul>
	#parse("views/common/wapfooter.vm")
</body>
</html>

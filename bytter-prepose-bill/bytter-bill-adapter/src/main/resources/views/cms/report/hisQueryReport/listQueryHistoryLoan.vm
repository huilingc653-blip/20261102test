<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <input type="hidden" id="relateCon" value="$!{relateCon}">##参数设置是否对接合同管理
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.cmsLoanInfo.reportDate')</td>
            <td>
            <div class="layui-inline">
                <input id= "eqd_reportDate" name="eqd_reportDate" value="$!date.format('yyyy-MM-dd',$!{reportDate})" class="layui-input bt-biz-dateType"
                       data-name="eqd_reportDate"
                       type="text" lay-verify="required" data-biz-name="eqd_reportDate" data-max="$!date.format('yyyy-MM-dd',$!{maxDate})">
            </div>
            </td>
        </tr>
        <tr>
            ##单位
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.corpId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="cms:provide:info:query"
                         data-scope="all"
                         data-tree-type="check">
                    </div>
                </div>
            </td>
            ##币别
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.curId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_curId" data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-textfield="curName" data-defaultvalue=""></div>
                </div>
            </td>
            <!-- 	##借款银行账号
				<td class="textRight">#springMessage('table.cmsProvideLoanInfo.plAccount')</td>
				<td>
					<input type="text" name="likes_plAccount" value=""  class="layui-input" placeholder="#springMessage('table.cmsProvideLoanInfo.plAccount')" />
				</td> -->

            ##借款单号
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.billCode')</td>
            <td>
                <input type="text" name="likes_infoBillCode" value=""  class="layui-input" placeholder="#springMessage('table.cmsProvideLoanInfo.billCode')" />
            </td>
        </tr>
        <tr>
            ##借款发放日期
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.sendDate')</td>
            <td>
                <div class="layui-inline">
                    <input name="ged_sendDate" data-endid="endSendDate" class="layui-input bt-biz-dateType" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input name="led_sendDate" id="endSendDate" class="layui-input bt-biz-dateType" type="text">
                </div>
            </td>
            ##借款到期日期
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td>
                <div class="layui-inline">
                    <input name="ged_repayDate" data-endid="endRepayDate" class="layui-input bt-biz-dateType" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input name="led_repayDate" id="endRepayDate" class="layui-input bt-biz-dateType" type="text">
                </div>
            </td>

            ##还款金额
            <td class="textRight">#springMessage('table.cmsProvideLoanRepay.repayFinish')</td>
            <td>
                <div class="layui-inline">
                    <input data-name="geg_sumRepayMoney" data-moneyendid="endSumRepayMoney" class="layui-input bt-biz-moneyType" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input id="endSumRepayMoney" data-name="leg_sumRepayMoney" class="layui-input bt-biz-moneyType" type="text">
                </div>
            </td>
        </tr>
        <tr>
            ##借款发放编码
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.contractCode')</td>
            <td>
                <input type="text" name="likes_contractCode" value=""  class="layui-input" placeholder="#springMessage('table.cmsProvideLoanSend.contractCode')" />
            </td>
            ##借款金额
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plMoney')</td>
            <td>
                <div class="layui-inline">
                    <input data-name="geg_plMoney" data-moneyendid="endPlMoney" class="layui-input bt-biz-moneyType" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input id="endPlMoney" data-name="leg_plMoney" class="layui-input bt-biz-moneyType" type="text">
                </div>
            </td>
            ##				创建人
            <td class="textRight">#springMessage('table.sysAttachment.createBy')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="likes_createName" id="userName" class="layui-input" >
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.bankId')</td>
            <td>
                <input type="text" name="likes_bankName" id="bankName" class="layui-input" >
            </td>
            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.plClass')</td>
            <td>
                <div class="bt-biz-selectType" data-name="eqs_plClass"
                     data-url="${basePath}/cms/provide/loaninfo/queryLoanTypeList" data-valuefield="code"
                     data-textfield="name"></div>
            </td>
            <td class="textRight">#springMessage('common.table.status')</td>
            <td>
                #*					暂存
                                    待审批
                                    审批打回
                                    待发放
                                    发放中
                                    还款中
                                    还款完成
                                    已作废
                                    删除*#
                <div class="bt-biz-dict" data-type="mulselect" data-group="cms.bizStatus"
                     data-beforeInit="statusCallback"
                     data-name="status" data-biz-name="status" ></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsProvideLoanInfo.bankId')</th><!-- 银行名称 -->
        <th>#springMessage('table.cmsProvideLoanInfo.corpId')</th><!-- 单位名称 -->
        <th>#springMessage('table.cmsProvideLoanInfo.plClass')</th><!-- 单位名称 -->
        <th>#springMessage('table.cmsProvideLoanInfo.billCode')</th><!-- 申请单号 -->
        <th>#springMessage('table.cmsProvideLoanSend.billCode')</th><!-- 发放单号 -->
        <!-- <th>#springMessage('table.cmsProvideLoanInfo.plAccount')</th>借款账号 -->
        <th>#springMessage('table.cmsProvideLoanSend.contractCode')</th><!-- 发放编码 -->
        <th>#springMessage('table.cmsProvideLoanSend.createDate')</th><!-- 录入日期-->
        <th>#springMessage('table.cmsProvideLoanInfo.curId')</th><!-- 币别-->
        <th>#springMessage('table.cmsProvideLoanInfo.plMoney')</th><!-- 借款金额-->
        <th>#springMessage('table.cmsProvideLoanSend.money')</th><!-- 本次发放金额-->
        <th>#springMessage('table.cmsProvideLoanRepay.moneyFinish')</th><!-- 已还金额(本金))-->
        <th>#springMessage('table.cmsProvideLoanRepay.moneyPassage')</th><!-- 还款在途(本金)) -->
        <th>#springMessage('table.cmsProvideLoanRepay.plBalance')</th><!-- 借款余额 -->
        <th>#springMessage('table.cmsProvideLoanInfo.plRate')</th><!-- 借款利率 -->
        <th>#springMessage('table.cmsProvideLoanSend.sendDate')</th><!-- 借款发放日期 -->
        <th>#springMessage('table.cmsProvideLoanSend.repayDate')</th><!-- 借款到期日期 -->
        <!-- <th>#springMessage('table.cmsProvideLoanRepay.repayDate')</th>还款日
    	<th>#springMessage('table.cmsProvideLoanSend.repayType')</th>还款方式
    	<th>#springMessage('table.cmsProvideLoanInfo.plClass')</th>借款种类
    	<th>#springMessage('table.cmsProvideLoanInfo.plTerm')</th>期限
    	<th>#springMessage('table.cmsProvideLoanInfo.consultantFee')</th>顾问费 -->
        <th>#springMessage('table.cmsLoanSend.deferredNum')</th>
        <th>#springMessage('table.cmsProvideLoanInfo.rmk')</th><!-- 备注 -->
        <th>#springMessage('table.sysAttachment.createBy')</th><!-- 备注 -->
        <th>#springMessage('table.cmsProvideLoanInfo.status')</th><!-- 状态 -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form','datatable','corp','moneyType','dateType','selectType','dicts'], function(){
        $ = bt.jquery,form = bt.form(),moneyFun = bt.moneyType.getFun();
        bt.corp.init();//单位
        bt.moneyType.init();//金额
        bt.dateType.init();//日期
        bt.selectType.init();//日期
        bt.dicts.init();//数据字典
        var relateCon=$("#relateCon").val();
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            searchForm:{
                formElem:"#searchForm",
                formFilter:"search"
            },
            fixedColumns: {
                leftColumns:3,//代表冻结左边两列
                rightColumns:0//代表冻结右边一列
            },
            checkbox:false,
            ajax: {
                'url': basePath+"/cms/provide/loaninfo/queryHistoryLoanDatatable"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            fixedColumns: {
                rightColumns:1//代表冻结右边一列
            },
            columns: [
                {data:"bankName",bSortable:true},
                {data:"corpName",bSortable:true},
                {data:"plClassName",bSortable:true},
                {data:"infoBillCode",bSortable:true},
                {data:"sendBillCode"},
                {data:"contractCode"},
                {data:"createDate"},
                {data:"curName",bSortable:true,render: function ( data, type, full, meta ){
                        return full.curName;
                    }},
                {data:"plMoney",bSortable:true,className:"textRight",render: function ( data, type, full, meta ){
                        return bt.money.format(full.plMoney);
                    }},
                {data:"sendMoney", className:"textRight",render: function ( data, type, full, meta ){
                            return  bt.money.format(full.sendMoney);
                    }},
                {data:"sumRepayMoney",className:"textRight",render: function ( data, type, full, meta ){
                            return bt.money.format(full.sumRepayMoney);
                    }},
                {data:"sumRepayPassageMoney",className:"textRight",render: function ( data, type, full, meta ){
                            return bt.money.format(full.sumRepayPassageMoney);
                    }},
                {data:"sendBalanceMoney",className:"textRight",render: function ( data, type, full, meta ){
                        return bt.money.format(full.sendBalanceMoney);
                    }},
                {data:"plRate",render: function ( data, type, full, meta ){
                        return moneyFun.format(full.plRate * 100, {decimal:4}) +" %";
                    }},
                {data:"sendDate"},
                {data:"repayDate"},
                {data:"deferredCount",render: function ( data, type, full, meta ){
                            return full.deferredCount;
                    }},
                {data:"rmk"},
                {data:"createName"},
                {data:"bizStatus",render: function ( data, type, full, meta ){
                            return full.bizStatusName;
                    }},
                {
                    data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
                        var html = '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a>';
                        html += ' \<span class="text-explode">|</span>\ <a class="" href="#" data-row="' + meta.row + '" onclick="repayInterest(this)">' + bt.lang('cms.button.provideInterest') + '</a>';
                        html += ' \<span class="text-explode">|</span>\ <a class="" href="#" data-row="' + meta.row + '" onclick="listMsg(this)">' + bt.lang("common.button.logInfo") + '</a>';
                        if (relateCon == "1" && !bt.empty(full.conId)) {//参数设置对接合同管理选择是
                            html += '</a><span class="text-explode">|</span><a  href="#" data-row="' + meta.row + '" onclick="conView(this)">' + bt.lang("common.button.conInfo");
                        }
                        return html;
                    }
                }
            ],
            btDrawCallback:function(){
                var reportDate = $("#eqd_reportDate").val();
                if ($("#reportDateTitle").text()){
                    $('#reportDateTitle').text(bt.lang('table.cmsLoanInfo.reportDate')+"：" + reportDate)
                }else{
                    $('#appTable_wrapper .dt-buttons .layui-form').after('<div id="reportDateTitle" class="fr" style="height:28px;padding-right:16px;line-height:28px">'+bt.lang('table.cmsLoanInfo.reportDate')+'：' + reportDate + '</div>')
                }
            },
            summary:{
                pageSum:true,//小计功能开启cms/report/ratBkStaticHis/excel
                groupColumn:'curName',//分类汇总列参数
                sumList:[
                    {
                        colNum:'7',//汇总列序号
                        dataName:'plMoney',//汇总列数据
                    },
                    {
                        colNum:'8',//汇总列序号
                        dataName:'sendMoney',//汇总列数据
                    },
                    {
                        colNum:'9',//汇总列序号
                        dataName:'sumRepayMoney',//汇总列数据
                    },
                    {
                        colNum:'10',//汇总列序号
                        dataName:'sumRepayPassageMoney',//汇总列数据
                    },
                    {
                        colNum:'11',//汇总列序号
                        dataName:'sendBalanceMoney',//汇总列数据
                    },
                ]
            }
        });

        /**判断字符串是否为空*/
        bt.empty = function(ms){
            if(typeof(ms) == "undefined" || ms == null || ms == "" || ms == "null"){
                return true;
            }
            return false;
        }
    });

    function view(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/provide/loaninfo/viewPerfectlyLoanInfo?infoBillCode=" + data.infoBillCode + "&sendBillCode=" + data.sendBillCode + "&show=1" + "&enableUpload=0");
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/provide/loaninfo/viewPerfectlyLoanInfo?infoBillCode=" + data.loanCode+"&sendBillCode=" + data.billCode + "&show=1"
        });
    }

    function sendRepayView(sendBillCode){
        if(bt.empty(sendBillCode)){
            return ;
        }
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('cms.repayment.info'),basePath + "/cms/provide/loanrepay/viewRepayList?sendBillCode=" + sendBillCode + "&passageSign=");
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/provide/loanrepay/viewRepayList?sendBillCode=" + sendBillCode + "&passageSign="
        });
    }

    function repayView(sendBillCode){
        if(bt.empty(sendBillCode)){
            return ;
        }
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('cms.repayment.info'),basePath + "/cms/provide/loanrepay/viewRepayList?sendBillCode=" + sendBillCode + "&passageSign=2");
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "//cms/provide/loanrepay/viewRepayList?sendBillCode=" + sendBillCode + "&passageSign=2"
        });
    }

    function repayPassageView(sendBillCode){
        if(bt.empty(sendBillCode)){
            return ;
        }
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('cms.repayment.info'),basePath + "/cms/provide/loanrepay/viewRepayList?sendBillCode=" + sendBillCode + "&passageSign=1");
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "//cms/provide/loanrepay/viewRepayList?sendBillCode=" + sendBillCode + "&passageSign=1"
        });
    }

    /**加载利息预计明细*/
    function repayInterest(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('cms.button.provideInterest'),basePath + "/cms/provide/cmsprovideinterest/list?sendBillCode="+data.sendBillCode+"&showSign=0&repairSign=0");
        }
    }

    //展期次数
    function sendInfolist(billCode){
        if(billCode){
            if(bt.navtab){
                bt.navtab.addNavtab(bt.lang('common.view.data'),basePath+"/cms/provide/provideloandeferred/deferredInfolist?liCode="+billCode);
                return;
            }
        }
    }

    //日志列表
    function listMsg(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(data){
            if(bt.navtab){
                var billCode = "";
                if (data.sendBillCode != null) {
                    billCode += data.infoBillCode + "," + data.sendBillCode
                } else {
                    billCode += data.infoBillCode;
                }
                bt.navtab.addNavtab(bt.lang('common.button.logInfo'),basePath + "/cms/basedata/cmsprocessmsg/list?billCode=" + billCode);
                return;
            }
        }
    }

    /**
     * 查看合同信息
     * @param el
     */
    function conView(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        var conId = data.conId;
        parent.layer.open({
            type: 2,
            area: ['1080px', '720px'],
            maxmin: true,
            content: basePath + "/contract/conCommon/conView?id=" + conId
        });
    }

    /**
     *状态回调
     */
    function statusCallback(data) {
        var status = "10,15,17,21,31,32,33,42,48,85,-2";
        var statusArr = [];
        if (data.length > 0) {
            $.each(data, function (index,item) {
                if (status.lastIndexOf(item.value) >= 0) {
                    statusArr.push(item);
                }
            });
        }
        return statusArr;
    }
</script>
</html>

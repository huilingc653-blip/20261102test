<!DOCTYPE html>
<html lang="en">
<head>
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no"/>
	<meta charset="UTF-8">
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
	<title>$dictTag.get("Loan.Sign",${loanSign})融资明细</title>
	<link rel="stylesheet" href="${basePath}/static/mobile/plugins/fixedTable/table.min.css"/>
	<style>
		.dtl-title{
			font-size:2rem ;
		}
        .t_r_content table tbody td:nth-child(even) {
            color: #333333!important;
        }
        .data-table .t_l {
            width: 100px;
        }
	</style>
</head>
<script src="${basePath}/static/plugins/jquery/jquery.min.js?_btv=${resourceVersion}"></script>

<body>
    #*<header >##style="width: 100%"
        <div class="dtl-title">
            <div  style="text-align: center"><span>$dictTag.get("Loan.Sign",${loanSign})融资明细</span></div>
        </div>
    </header>*#
    <div class="data-table" >
        <!--1.0 冻列 -->
        <div class="t_l">
            <!--1.1 冻结列表头-->
            <table>
                <tbody>
                    <tr>
                       #* <th style="width: 200px;">#springMessage('table.report.corpId')</th>*#
                           <th style="width: 130px;">#springMessage('cms.report.loanContract')</th>
                    </tr>
                </tbody>
            </table>
            <!--1.2 冻结列表体-->
            <div class="t_l_freeze" >
                <table width="100%">
                    <tbody>
                        #foreach($loan in $!{list})
                            <tr>
                               #* <td style="width: 200px;">$!{loan.corpCode}&nbsp;$!{loan.corpName}</td>*#
                                   <td style="width: 130px;">$!{loan.infoCode}</td>

                            </tr>
                        #end
                    </tbody>
                </table>
            </div>
        </div>
        <!--2.0 表格-->
        <div class="t_r">
            <!--2.1　冻结行表头-->
            <div class="t_r_t">
                <table>
                    <tbody>
                        <tr>
                         #*   <th style="width: 78px;">#springMessage('cms.report.loanType')</th>
                            <th>#springMessage('cms.report.cur')</th>*#
                            <th style="width: 85px;">#springMessage('cms.report.loanMoney')</th>
                            <th style="width: 87px;">#springMessage('table.fbsBudgetPeriod.beginDate')</th>
                            <th style="width: 87px;">#springMessage('table.fbsBudgetPeriod.endDate')</th>
                            <th style="width: 85px;">#springMessage('cms.report.sendMoney')</th>
                            <th style="width: 87px;">#springMessage('cms.report.sendDate')</th>
                            <th style="width: 85px;">#springMessage('cms.report.repayMoney')</th>
                            <th style="width: 87px;">#springMessage('cms.report.repayDate')</th>
                            <th style="width: 85px;">#springMessage('cms.report.sendBalance')</th>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!--2.2 表格中心内容区域-->
            <div class="t_r_content">
                <table width="100%" >
                    <tbody>
                        #foreach($loan in $!{list})
                            <tr>
                              #*  <td style="width: 78px;">$!{loan.loanSignName}</td>
                                <td>$!{loan.curName}</td>*#
                                <td style="text-align: right;width: 85px;">$!number.formatNumeric($!{loan.plMoney})</td>
                                <td style="width: 87px;">$!{loan.plStartDate}</td>
                                <td style="width: 87px;">$!{loan.plEndDate}</td>
                                <td style="text-align: right;width: 85px;">$!number.formatNumeric($!{loan.sendMoney})</td>
                                <td style="width: 87px;">$!{loan.sendDate}</td>
                                <td style="text-align: right; width: 85px;">$!number.formatNumeric($!{loan.repayMoney})</td>
                                <td style="width: 87px;">$!{loan.repayDate}</td>
                                <td style="text-align: right;width: 85px;">
                                    #if($!{loan.sendBalance})
                                        $!number.formatNumeric($!{loan.sendBalance})
                                    #else
                                        0.00
                                    #end
                                </td>
                            </tr>
                        #end
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>

<script src="${basePath}/static/js/iscroll-probe.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/mobile/plugins/fixedTable/table.min.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="corpId" value="$!{corpId}">
    <input type="hidden" name="loanType" value="$!{loanType}">
    <input type="hidden" name="remainTermId" value="$!{remainTermId}">
    <input type="hidden" name="curId" value="$!{curId}">
</form>
<div id="showDataTable">
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.cmsProvideLoanInfo.bankId')</th><!--借款银行  -->
            <th>#springMessage('table.abBillTransfer.applyCorp')</th><!--申请单位  -->
            <th>#springMessage('cms.report.loan.applicationNo')</th><!--借款申请单编号  -->
            <th>#springMessage('table.cmsProvideLoanInfo.contractNo')</th><!--借款申请单编号  -->
            <th>#springMessage('cms.report.loan.sendAppNo')</th><!--发放申请编号  -->
            <th>#springMessage('ttpay.currency')</th><!--币种  -->
            <th>#springMessage('table.cmsProvideLoanInfo.plMoney')</th><!--借款金额  -->
            <th>#springMessage('table.cmsProvideLoanInfo.plDate')</th><!--借款日期  -->
            <th>#springMessage('table.cmsLoanDeferred.matureDate')</th><!--还款日期  -->
            <th>#springMessage('table.cmsProvideLoanInfo.contractTerm')</th><!--合同期限  -->
            <th>#springMessage('table.cmsProvideLoanSend.money')</th><!--发放金额  -->
            <th>#springMessage('table.cmsProvideLoanRepay.repayPassage')</th><!--还款在途金额  -->
            <th>#springMessage('cms.report.repayMoney')</th><!--已还款金额  -->
            <th>#springMessage('table.accountDTO.balance')</th><!--余额  -->
        </tr>
        </thead>
    </table>
</div>
<div class="layui-form-item" style="width: 100%">
    <div class="layui-inline" style="text-align: center;width: 100%">
        <button class="layui-btn" type="button" onclick="doClose()">#springMessage('common.button.close')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
<script>
    bt.use(["jquery", "form", "datatable", "moneyType","dicts"], function () {
        $ = bt.jquery;
        form = bt.form();
        moneyType = bt.moneyType.init();
        moneyfun = moneyType.getFun();
        dicts = bt.dicts.init();
        bt.datatable.init({
            elem: "#appTable",
            ajax: {
                url: basePath + "/cms/report/cmsExpireAnalysis/getCmsLoanDtlData",
            },
            searchForm:{
                formElem:"#searchForm",
                formFilter:"search"
            },
            checkbox:true,
            columns: [
                {
                    data: "bankName",
                    className: "center"
                }, {
                    data: "corpName",
                    className: "center"
                },
                {
                    data: "billCode",
                    className: "center"
                },
                {
                    data: "contractNo",
                    className: "center"
                },
                {
                    data: "sendBillCode",
                    className: "center"
                },
                {
                    data: "curName",
                    className: "center"
                },
                {
                    data: "money",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                },
                {
                    data: "plDate",
                    className: "center"
                },
                {
                    data: "repayDate",
                    className: "center"
                },
                {
                    data: "contractTerm",
                    className: "center",
                    render:function (data, type, row, meta) {
                        return bt.dict("Provide.ContractTerm", data);
                    }
                },
                {
                    data: "sendMoney",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                },
                {
                    data: "repayingMoney",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                },
                {
                    data: "repayMoney",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                },
                {
                    data: "leftMoney",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                }
            ],
            summary: {
                pageSum: true,//小计功能开启
                selectSum: true,//已选汇总功能开启
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '7',//汇总列序号
                        dataName: 'money',//汇总列数据
                    },
                    {
                        colNum: '11',//汇总列序号
                        dataName: 'sendMoney',//汇总列数据
                    },
                    {
                        colNum: '13',//汇总列序号
                        dataName: 'repayMoney',//汇总列数据
                    },
                    {
                        colNum: '14',//汇总列序号
                        dataName: 'leftMoney',//汇总列数据
                    }
                ]
            }
        });
        //这里填写新的js代码，请参考前端文档
    });

    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }
</script>
</body>
</html>

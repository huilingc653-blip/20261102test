<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            #if($!{netFlag}=="1")##银行类型属于结算中心
                <th rowspan="2">#springMessage('table.report.corpName')</th><!-- 单位名称 -->
            #else
                <th rowspan="2">#springMessage('table.report.bankName')</th><!-- 银行名称 -->
            #end
            <th colspan="3" class="d">#springMessage('cms.report.end')$!{searchEndDate}#springMessage("cms.loan.ternUnit.day")</th><!--截止**（查询截止日期）日  -->
            <th colspan="3" class="m">#springMessage("statisticsReport.IntegratedQuery.befMonthEnd")</th>##较上月末
            <th colspan="3" class="s">#springMessage("statisticsReport.IntegratedQuery.befQuarterEnd")</th>##较上季度末
            <th colspan="3" class="l">#springMessage("statisticsReport.IntegratedQuery.befYear")</th>##较去年同期
            <th colspan="3" class="y">#springMessage("statisticsReport.IntegratedQuery.yearEarly")</th>##较年初
        </tr>
        <tr>
            <!--截止**（查询截止日期）日  -->
            <th class="d">#springMessage("table.report.totalDeposits")</th>##存款合计
            <th class="d">#springMessage("table.report.totalLoans")</th>##贷款合计
            <th class="d">#springMessage("table.report.depositLoanRate")</th>##存贷比

            ##较上月末
            <th class="m">#springMessage("table.report.totalDeposits")</th>##存款合计
            <th class="m">#springMessage("table.report.totalLoans")</th>##贷款合计
            <th class="m">#springMessage("table.report.depositLoanRate")</th>##存贷比

            ##较上季度末
            <th class="s">#springMessage("table.report.totalDeposits")</th>##存款合计
            <th class="s">#springMessage("table.report.totalLoans")</th>##贷款合计
            <th class="s">#springMessage("table.report.depositLoanRate")</th>##存贷比

            ##较去年同期
            <th class="l">#springMessage("table.report.totalDeposits")</th>##存款合计
            <th class="l">#springMessage("table.report.totalLoans")</th>##贷款合计
            <th class="l">#springMessage("table.report.depositLoanRate")</th>##存贷比

            ##较年初
            <th class="y">#springMessage("table.report.totalDeposits")</th>##存款合计
            <th class="y">#springMessage("table.report.totalLoans")</th>##贷款合计
            <th class="y">#springMessage("table.report.depositLoanRate")</th>##存贷比
        </tr>
        </thead>
        <tbody>
            #foreach($voDtl in $!{voList})
            <tr>
                <td align="center">$!{voDtl.bankName}</td>
                <td align="right">$!number.formatNumeric($!{voDtl.totalDepositsD})</td>
                <td align="right">$!number.formatNumeric($!{voDtl.totalLoansD})</td>
                #if($!{voDtl.totalDepositsD}==0)
                    <td align="center">0</td>
                #elseif($!{voDtl.totalLoansD}==0)
                    <td align="center">--</td>
                #else
                    <td align="center">$!rateTag.show($!{voDtl.depositLoanRateD},2)</td>
                #end
                <td align="right">$!number.formatNumeric($!{voDtl.totalDepositsM})</td>
                <td align="right">$!number.formatNumeric($!{voDtl.totalLoansM})</td>
                #if($!{voDtl.totalDepositsM}==0)
                    <td align="center">0</td>
                #elseif($!{voDtl.totalLoansM}==0)
                    <td align="center">--</td>
                #else
                    <td align="center">$!rateTag.show($!{voDtl.depositLoanRateM},2)</td>
                #end
                <td align="right">$!number.formatNumeric($!{voDtl.totalDepositsS})</td>
                <td align="right">$!number.formatNumeric($!{voDtl.totalLoansS})</td>
                #if($!{voDtl.totalDepositsS}==0)
                    <td align="center">0</td>
                #elseif($!{voDtl.totalLoansS}==0)
                    <td align="center">--</td>
                #else
                    <td align="center">$!rateTag.show($!{voDtl.depositLoanRateS},2)</td>
                #end
                <td align="right">$!number.formatNumeric($!{voDtl.totalDepositsL})</td>
                <td align="right">$!number.formatNumeric($!{voDtl.totalLoansL})</td>
                #if($!{voDtl.totalDepositsL}==0)
                    <td align="center">0</td>
                #elseif($!{voDtl.totalLoansL}==0)
                    <td align="center">--</td>
                #else
                    <td align="center">$!rateTag.show($!{voDtl.depositLoanRateL},2)</td>
                #end
                <td align="right">$!number.formatNumeric($!{voDtl.totalDepositsY})</td>
                <td align="right">$!number.formatNumeric($!{voDtl.totalLoansY})</td>
                #if($!{voDtl.totalDepositsY}==0)
                    <td align="center">0</td>
                #elseif($!{voDtl.totalLoansY}==0)
                    <td align="center">--</td>
                #else
                    <td align="center">$!rateTag.show($!{voDtl.depositLoanRateY},2)</td>
                #end
            </tr>

    #end
        </tbody>
    </table>

#parse("views/common/footer.vm")
</body>
</html>
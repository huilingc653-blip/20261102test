<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
		#page .wrapper {
			margin-right: 20px;
		}
	</style>
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="optType" id="optType" value="1">
        <table class="layui-table">
                <tr> 
                	##单位
                    <td class="textRight">#springMessage('table.report.corpId')</td>
	        		<td class="rCode">
	       				<div class="layui-input-inline">
	                   		<div class="bt-biz-corp" data-biz-type="corp" data-type="selectTree" data-resource="cms:report:amount:query"
	                   		data-tree-type="check" data-checkkboxtype='{"Y":"s","N":"s"}'
	                   		data-name="corpId" data-scope="all" data-biz-name="corpId" data-defaultvalue="$!{corpId}"></div>
	           			</div>
	           		</td>
            		##银行类别
                    <td class="textRight">#springMessage('table.btBankAcc.bankTypeId')</td>
            		<td class="rCode">
            		<div class="layui-input-inline">
    					<div class="bt-biz-mulselectType" data-name="bankTypeId" data-url="${basePath}/basic/business/btbanktype/json" data-biz-name="bankTypeId"
                             data-valuefield="id" data-textfield="typeName" data-defaultvalue="$!{bankTypeId}" data-method="get"></div>
                    </div>
    				</td>
					<td class="textRight">#springMessage("table.ratBkration.ratMode")</td>
					<td class="rCode">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="RatBkration.RatMode" data-defaultvalue="$!{ratMode}"
                                 data-name="ratMode" data-biz-name="ratMode" data-value="">
                            </div>
						</div>
					</td>
                </tr>
                <tr>
                	##币别
        			<td class="textRight">
        				#springMessage('table.fcBusinessRuleDefine.curCode')
	        		</td> 
	                <td class="rCode">
	                <div class="layui-input-inline">
						<div class="bt-biz-selectType" data-biz-name="curCode" data-url="${basePath}/basic/business/btcurrency/json" 
						data-valuefield="id" data-textfield="curName" data-name="curCode" data-defaultvalue="$!{curCode}"></div>
						</div>
	                </td>
	           		##金额单位
                    <td class="textRight">#springMessage('common.moneyType')</td>
                    <td >
                        <div class="layui-input-inline">
                        	<div class="bt-biz-dict" data-type="select" data-group="common.MoneyType" data-defaultvalue="1" data-required="true"
								data-name="moneyType" data-biz-name="moneyType" data-value="$!{moneyType}" data-selecttext="false">
                            </div>
                        </div>
                    </td>
					##估计授信日期
#*                        <td class="textRight">#springMessage('table.ratBkration.ratDate')</td>
                        <td class="rCode">
                            <div class="layui-inline">
                                <input type="text" data-type="date" data-biz-name="ratDate" data-today="true"
                                       class="layui-input bt-biz-dateType" value="$!{ratDate}">
                            </div>
                        </td>*#
                    <td colspan="2"></td>
                </tr>
            <tr>
                <td class="textRight">#springMessage('table.ratBkration.begindate')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" name="beginDate" class="layui-input bt-biz-dateType"
                               id="beginDate"
                               data-endid="endDate" value="$!{beginDate}"
                               data-type="date" data-biz-name="beginDate">
                    </div>
                    <div class="layui-inline">
                        <span class="date-mid">~</span>
                    </div>
                    <div class="layui-inline">
                        <input type="text" name="endDate" class="layui-input bt-biz-dateType" id="endDate"
                               data-type="date" data-biz-name="endDate" value="$!{endDate}">
                    </div>
                </td>
                <td class="textRight">#springMessage('table.ratBkration.enddate')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" name="beginDate2" class="layui-input bt-biz-dateType"
                               data-endid="endDate2"
                               id="beginDate2"
                               data-type="date" data-biz-name="beginDate2" value="$!{beginDate2}">
                    </div>
                    <div class="layui-inline">
                        <span class="date-mid">~</span>
                    </div>
                    <div class="layui-inline">
                        <input type="text" name="endDate2" class="layui-input bt-biz-dateType" id="endDate2"
                               data-type="date" data-biz-name="endDate2" value="$!{endDate2}">
                    </div>
                </td>
                <td colspan="2"></td>
            </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="button" class="layui-btn layui-btn-primary" onClick="resetCode()">#springMessage('common.button.reset')</button>
                        <button class="layui-btn" lay-submit="" lay-filter="excel"  type="button">#springMessage('common.button.exports')</button>
                    </td>
                </tr>
        </table>
    </form>
<div id="tbl" style="width:100%;overflow:auto" >
<table width="100%" align="center" id="search">
		<tr>
            <td align="right" width="10%">#springMessage('table.cmsRatInfo.reportDate')：</td>
            <td width="23%" align="left">$!{reportDate}</td>
            <td align="right" width="10%">#springMessage("common.moneyType")：</td>
            <td width="23%" align="left">$dictTag.get('common.MoneyType',$!{moneyType})</td>
            <td align="right" width="10%">#springMessage('table.cmsRatInfo.TabPerson')：</td>
            <td width="23%" align="left">$!{userName}</td>
		</tr>
	</table>
<table id="appTable" class="layui-table layui-form dark-layui-table" style="width:100%;">
    <thead>
    ##需要新增表头字段的同事请将相应字段加入RatBkStatisticsDataExp.xls文件中，以便使导出表格和页面显示信息一致
    <tr>
        <th width="15%">#springMessage("table.ratBkration.corpId")</th>
        <th width="15%">#springMessage("table.ratBkration.bankName")</th>
        <th width="8%">#springMessage("table.ratBkration.ratMode")</th>
        <th width="8%">#springMessage("table.ratBkrationDis.distributeWay")</th>
    	<th width="10%">#springMessage('table.ratBkration.validDate')</th>
        <th width="8%">#springMessage("table.ratBkration.curName")</th>
        <th width="10%">#springMessage("table.ratBkration.money")</th>
        <th width="10%">#springMessage('table.ratBkrationDisDetail.superProcessMoney')</th>
        <th width="10%">#springMessage('table.ratBkrationDisDetail.checkProcessMoney')</th>
        <th width="10%">#springMessage('table.ratBkrationDisDetail.overPlusMoney')</th>
        <th width="10%">#springMessage('table.ratBkrationDisDetail.leftDisMoney')</th>
    </tr>
    </thead> 
    <tbody>
    	#if($list)
    		#foreach($ratBean in $!{list})
    			<tr>
    				#if($!{ratBean.flagSign} == "total")
    				<td align="right" colspan="6">$!{ratBean.corpName}</td>
					##授信总额
                   	<td align="center">$number.formatNumeric($!{ratBean.money})</td>
					<td align="right">$number.formatNumeric($!{ratBean.useMoney})</td>
                    <td align="right">$number.formatNumeric($!{ratBean.approveMoney})</td>
					#else
    				<td align="center">$!{ratBean.corpName}</td>
    				<td align="center">$!{ratBean.bankName}</td>
    				<td align="center">$!{ratBean.ratModeName}</td>
    				<td align="center">$!{ratBean.disWayName}</td>
					<td align="center">$!{ratBean.rationDateStr} </td>
    				<td align="center">$!{ratBean.curName}</td>
					##授信总额
					<td align="center"><a href="javascript:viewItemRatio('$!{ratBean.curCode}','$!{ratBean.corpId}','$!{ratBean.ratCode}','$!{ratBean.bankCode}','$!{ratBean.beginDate}','$!{ratBean.endDate}','')">$!{ratBean.moneyStr}</td>
                    <td align="right"><a href="javascript:viewRatioUse('$!{ratBean.curCode}','$!{ratBean.corpId}','$!{ratBean.ratCode}','','$!{ratBean.beginDate}','$!{ratBean.endDate}','')">$number.formatNumeric($!{ratBean.useMoney})</td>
                    <td align="right"><a href="javascript:viewApproveRatio('$!{ratBean.curCode}','$!{ratBean.corpId}','$!{ratBean.ratCode}','$!{ratBean.bankCode}','$!{ratBean.beginDate}','$!{ratBean.endDate}')">$number.formatNumeric($!{ratBean.approveMoney})</td>
					#end
    				<td align="right">$number.formatNumeric($!{ratBean.overPlusMoney})</td>
    				<td align="right">$number.formatNumeric($!{ratBean.leftMoney})</td>
    			</tr>
    		#end
    	#end
    </tbody>
</table>
</div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/rat/bkration/ratBkStatics.list.js?_btv=${resourceVersion}"></script>
</html>
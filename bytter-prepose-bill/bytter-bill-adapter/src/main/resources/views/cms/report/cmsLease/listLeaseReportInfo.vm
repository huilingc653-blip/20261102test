<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##融资租赁类型
            <td class="textRight">#springMessage('cms:lease:sub:mater:leaseType')</td>

            <td>
                <div class="bt-biz-dict" data-type="select" data-group="cms.financing.lease.info.leaseType"
                     data-name="eqs_leaseType" data-biz-name="leaseType"></div>
            </td>

            ##承租人
            <td class="textRight">#springMessage('cms:lease:sub:mater:lessee')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-type="selectTree" data-name="eqs_corpId"
                         data-resource="cms:lease:financing:apply:query" data-scope="all"></div>
                </div>
            </td>
            ##出租人
            <td class="textRight">#springMessage('cms:lease:sub:mater:lessor')</td>
            <td width="25%">
                <input type="text" name="likes_lessor" autocomplete="off"
                       class="layui-input"/>
            </td>
        </tr>
        <tr>
            ##起租日
            <td class="textRight">#springMessage('cms:lease:sub:mater:commencementDate')</td>
            <td>
                <input type="text" name="ged_beginDate" data-biz-name="ged_beginDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_beginDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_beginDate" data-biz-name="led_beginDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" id="led_beginDate">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>

        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('cms:lease:sub:mater:leaseType')</th>
        <th>#springMessage('cms:lease:sub:mater:lessee')</th>
        <th>#springMessage('cms:lease:sub:mater:lessor')</th>
        <th>#springMessage('cms:lease:sub:mater:supplier')</th>
        <th>#springMessage('cms:lease:sub:mater:itemCode')</th>
        <th>#springMessage('cms:lease:sub:mater:commencementDate')</th>
        <th>#springMessage('cms.common.deadlineDate')</th>
        <th>#springMessage('ttpay.currency')</th>
        <th>#springMessage('table.cmsLease.oriMoney')</th>
        <th>#springMessage('table.cmsLease.rmbMoney')</th>
        <th>#springMessage('cms.lease.rentpaid')</th>
        <th>#springMessage('cms.lease.principalRepaid')</th>
        <th>#springMessage('cms.inl.info.repayInterest')</th>
        <th>#springMessage('cms.lease.reimbursedExpenses')</th>
        <th>#springMessage('cms.lease.notRentPaid')</th>
        <th>#springMessage('cms.lease.notPrincipalRepaid')</th>
        <th>#springMessage('cms.lease.notRepayInterest')</th>
        <th>#springMessage('cms.lease.outerExpenses')</th>
        <th>#springMessage('table.fcFreeze.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/cms/lease/leaseReportInfo.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form" method="post">
        <input type="hidden" name="standardCurId" lay-verify="isNatualCur" value="$!{standardCurId}">
	    <table class="layui-table">
	    	<tbody>
	    	<tr>
	    		<td class="textRight" width="25%">#springMessage('table.report.corpId')</td>##单位
	    		<td width="25%">
	    			<div class="bt-biz-corp"
	    				 data-name="corpId"
        				 data-type="selectTree"
        				 data-tree-type="check"
        				 data-checkkboxtype="{'Y':'ps','N':'s'}"
                         data-resource="cms:report:loan:statement:query"
        				 data-scope="all">
        			</div>
	    		</td>
                <td class="textRight" width="25%">#springMessage('table.report.searchDate')</td>##查询截止日期
                <td width="25%">
                    <div class="layui-inline">
                        <input type="text" name="endDate" data-biz-name = "endDate" class="layui-input bt-input-inline bt-biz-dateType" id="t3" data-type="month" data-today="true" data-required="true">
                    </div>
                </td>
	    	</tr>
			<tr>

                <td class="textRight" width="25%">#springMessage('cms.report.cur')</td>##币别
                <td width="25%">
##                    <input type="hidden" name="curCode" id="curCode" value="$!{standardCurId}">
                    <div class="bt-biz-selectType"
                         data-name="curId"
                         data-biz-name="curId"
                         data-url="${basePath}/basic/business/btcurrency/json"
                         data-valuefield="id"
                         data-textfield="curName"
                         data-required="true"
                         data-callback="changeCur"
                    >
                    </div>
                </td>
                <td class="textRight" width="25%">#springMessage('common.moneyType')</td>##金额单位
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="cms.MoneyType"
                         data-defaultvalue="1" data-value="$!{moneyUnit}"
                         data-name="moneyUnit" data-biz-name="moneyUnit" data-selecttext="false"></div>
                </td>
			</tr>
	    	<tr>
	    		<td class="textRight" width="25%">#springMessage('cms.report.loanType')</td>##融资种类
	    		<td width="25%">
	    			<div class="bt-biz-dict" 
	    				 data-name="loanSign" 
	    				 data-type="select"
	    				 data-group="Loan.Sign">
	    			</div>
	    		</td>
	    	</tr>

            <tr>
                <td class="textRight" width="25%">#springMessage('common.isConvert.currency')</td>##是否折合币种
                <td width="25%">
                    <div class="layui-form">
                        <div class="bt-biz-dict is_not_render" data-type="radio" data-group="sf_yn" data-defaultvalue="0"
                             data-name="isConvertStandCur" data-biz-name="isConvertStandCur" data-callback="changeCurSelect"></div>
                    </div>
                </td>
                <td class="textRight" width="25%">#springMessage('cms.report.cur')</td>##折合币种
                <td width="25%">
                    <div class="bt-biz-selectType"
                         data-name="convertCurId"
                         data-biz-name="convertCurId"
                         data-url="${basePath}/basic/business/btcurrency/json"
                         data-valuefield="id"
                         data-textfield="curName"
                         data-disabled="true"
                         data-callback="checkConvertCurCallBack"
                    >
                    </div>
                </td>
            </tr>
	    	<tr>
	    		<td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary" >#springMessage('common.button.reset')</button>
	    		</td>
	    	</tr>
	    	</tbody>
	    </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th rowspan="2">#springMessage('table.report.corpId')</th><!-- 单位 -->
            <th rowspan="2">#springMessage('cms.report.loanType')</th><!--融资方式  -->
##            <th rowspan="2">#springMessage('币别')</th><!--币别  -->
            <th colspan="5">#springMessage('cms.report.toDateBalance')</th><!--截止本期金额  -->
            <th colspan="5">#springMessage('cms.report.toLastYearBalance')</th><!--截止去年同期  -->
            <th colspan="2">#springMessage('cms.report.increaseRate')</th><!--增长率  -->
        </tr>
        <tr>
            <th>#springMessage('cms.report.contractMoney')</th><!--截止本期合同金额  -->
            <th>#springMessage('cms.report.sendMoney')</th><!--截止本期发放金额  -->
            <th>#springMessage('cms.report.repayMoney')</th><!--截止本期还款金额  -->
            <th>#springMessage('cms.report.loanRate')</th><!--截止本期放款占比  -->
            <th>#springMessage('cms.report.repayRate')</th><!--截止本期还款占比  -->
            <th>#springMessage('cms.report.contractMoney')</th><!--截止去年同期合同金额  -->
            <th>#springMessage('cms.report.sendMoney')</th><!--截止去年同期发放金额  -->
            <th>#springMessage('cms.report.repayMoney')</th><!--截止去年同期还款金额  -->
            <th>#springMessage('cms.report.loanRate')</th><!--截止去年同期放款占比  -->
            <th>#springMessage('cms.report.repayRate')</th><!--截止去年同期还款占比  -->
            <th>#springMessage('cms.report.loanGrowthRate')</th><!--放款增长率  -->
            <th>#springMessage('cms.report.repayGrowthRate')</th><!--还款增长率  -->
        </tr>
        </thead>
    </table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/loan/cmsLoanStatement.list.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('df.securities.reportDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" id="eqd_reportDate" name="eqd_reportDate" class="layui-input bt-biz-dateType" data-name="eqd_reportDate"
                           value="$!{reportDate}" lay-verify="required" data-biz-name="eqd_reportDate"/>
                </div>
            </td>
        </tr>
        <tr>
        ##            证券代码
            <td width="10%" class="textRight">#springMessage('df.securities.code')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_stockCode" class="layui-input" >
                </div>
            </td>
        ##            证券名称
            <td width="10%" class="textRight">#springMessage('df.securities.name')</td>
            <td width="23%">
                <div class="layui-inline">
                    <input type="text" name="likes_stockName" class="layui-input" >
                </div>
            </td>
        ##            直融类别
            <td width="10%" class="textRight">#springMessage('df.business.type')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-biz-name="dfBusinessTypeId" data-url="${basePath}/cms/dfBusinessType/getValidBusinessTypes" data-valuefield="id" data-textfield="businessName" data-name="eqs_dfBusinessTypeId"></div>
                </div>
            </td>
        </tr>

        <tr>
        ##            金额
            <td width="10%" class="textRight">#springMessage('df.surplus.money')</td>
            <td >
                <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text" data-name="geg_surplusMoney"
                       data-moneyendid="leg_surplusMoney" />
                <span class="date-mid">~</span>
                <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_surplusMoney" type="text"
                       data-name="leg_surplusMoney" />
            </td>

        ##            审批状态
            <td width="10%" class="textRight">#springMessage('df.approve.status')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-filterData="-2" data-group="df.directfinance.approve.status" data-name="eqi_status" data-biz-name="status"></div>
                </div>
            </td>
        ##            还款状态
            <td width="10%" class="textRight">#springMessage('df.repay.biz.status')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="df.directfinance.biz.status" data-name="eqi_repayBizStatus" data-biz-name="repayBizStatus"></div>
                </div>
            </td>
        </tr>

        <tr>
            </td>
        ##            是否已到期
            <td width="10%" class="textRight">#springMessage('df.report.ExpiredOrNot')</td>
            <td width="23%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="df.report.expiredOrNot" data-name="eqs_expiredOrNot" data-biz-name="expiredOrNot" data-callback="setToday"></div>
                    <input type="hidden" data-biz-name="today" name="" class="layui-input bt-biz-dateType" data-today="true" data-type="date">
                </div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
                <button type="button" class="layui-btn layui-btn-primary layui-btn-small" onclick="resetForm()">#springMessage("common.button.reset")</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
        <th>#springMessage('table.choBankFinance.billNo')</th>#*登记单号*#
        <th>#springMessage('df.securities.name')</th>#*证券名称*#
        <th>#springMessage('df.securities.code')</th>#*证券代码*#
        <th>#springMessage('df.business.type')</th>#*直融类别*#
        <th>#springMessage('df.issue.date')</th>#*发行日期*#
        <th>#springMessage('table.cmsProvideLoanSend.repayDate')</th>#*到期日期*#
        <th>#springMessage('df.issuing.period')</th>#*发行期限*#
        <th>#springMessage('df.surplus.money')(#springMessage('config.choBank.moneyUnit'))</th>#*金额*#
        <th>#springMessage('df.repaid.money')(#springMessage('config.choBank.moneyUnit'))</th>#*已还本金*#
        <th>#springMessage('df.odd.money')(#springMessage('config.choBank.moneyUnit'))</th>#*剩余本金*#
        <th>#springMessage('df.bond.rating')</th>#*债券评级*#
        <th>#springMessage('df.main.rating')</th>#*主体评级*#
        <th>#springMessage('df.issue.amount')(#springMessage('config.choBank.moneyUnit'))</th>#*发行规模*#
        <th>#springMessage('df.approve.status')</th>#*审批状态*#
        <th>#springMessage('df.repay.biz.status')</th>#*状态*#
        <th>#springMessage('common.table.thead.operation')</th>#*操作*#
    </tr>
    </thead>
</table>
<!-- 这里填写新HTML的代码 -->
    #parse("views/common/footer.vm")
<script>
    var form, moneyFun, dicts, dateType;
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts","dateType"], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        dateType = bt.dateType.init();
        bt.selectType.init();
        bt.moneyType.init();
        moneyFun = bt.moneyType.getFun();
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: "Brtlip",
            colReorder: true,
            ordering: false,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            btDrawCallback: function () {
                var reportDate = $("#eqd_reportDate").val();
                if ($("#reportDateTitle").text()) {
                    $('#reportDateTitle').text(bt.lang('table.cmsLoanInfo.reportDate')+"：" + reportDate)
                } else {
                    $('#appTable_wrapper .dt-buttons .layui-form').after('<div id="reportDateTitle" class="fr" style="height:28px;padding-right:16px;line-height:28px">'+bt.lang('table.cmsLoanInfo.reportDate')+'：' + reportDate + '</div>')
                }
            },
            ajax: {
                "url": basePath + "/cms/dfDirectFinanceInfo/report/listDfDirectHisReportData"
            }
            , columns: [
                {
                    data: "billCode",
                    className: "center"
                }, {
                    data: "stockName",
                    className: "center"
                }, {
                    data: "stockCode",
                    className: "center"
                }, {
                    data: "businessName",
                    className: "center"
                }, {
                    data: "startDate",
                    className: "center"
                }, {
                    data: "endDate",
                    className: "center"
                }, {
                    data: "peroid",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return data + bt.dict("choBankFinance.dateUnit", full.unit);
                    }
                }, {
                    data: "surplusMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                },
                {
                    data: "repayMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                },
                {
                    data: "oddMoney",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                },
                {
                    data: "bondRating",
                    className: "center"
                }, {
                    data: "bondMainRating",
                    className: "center"
                },
                {
                    data: "money",
                    className: "textRight",
                    render: function (data, type, full, meta) {
                        return moneyFun.format(data);
                    }
                },
                {
                    data: "status",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("df.directfinance.approve.status", data);
                    }
                }, {
                    data: "repayBizStatus",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("df.directfinance.biz.status", data);
                    }
                }, {
                    data: null,
                    className: 'center',
                    render: function (data, type, full, meta) {
                        var html = "";
                        html += "<a href=\"#\" onclick=\"view('" + full.dfDirectFinanceId + "')\">" + bt.lang("common.button.view") + "</a>";
                        return html;
                    }
                }
            ]
        });
        //这里填写新的js代码，请参考前端文档
    });

    /**
     * 查询时间设置
     * @param data
     * @param text
     * @param selectedData
     */
    function setToday(data,text,selectedData) {
        if (null == selectedData) {
            dateType.get("today").attr("name", "");
        }else {
            if (1 == selectedData.value) {
                // 已到期
                dateType.get("today").attr("name","ltd_endDate");
            }else if (2 == selectedData.value) {
                // 未到期
                dateType.get("today").attr("name", "ged_endDate");
            }
        }

    }
    
    function view(id) {
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/cms/dfDirectFinanceInfo/view?id=" + id + "&flag=" + 1);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/dfDirectFinanceInfo/view?id=" + "&flag=" + 1,
            end:function(){
                datatable && datatable.draw();
            }
        });
    }

    function resetForm() {
        $("form")[0].reset();
        dateType.get("today").attr("name", "");
    }

</script>
</body>
</html>

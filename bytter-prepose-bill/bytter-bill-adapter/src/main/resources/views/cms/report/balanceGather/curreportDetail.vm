<!DOCTYPE html>
<html lang="en" style="height: 100%">
<head>
    #parse("views/common/head.vm")
</head>
<body style="height: 100%">
	<div id="chartPie" style="width:100%;height:50%;text-align: center;"></div>
	<div id="chartPie" style="width:100%;height:50%;text-align: center;">
		<table id="balanceTable" class="layui-table" style="width:100%;">
		    <thead>
		    <tr>
		        <th>#springMessage('table.cmsProvideLoanInfo.corpId')</th>
		        <th>#springMessage('cms.report.cur')</th>
		        <th>#springMessage('cms.report.loanType')</th>
		        <th>#springMessage('cms.report.beformMoney')</th>
				<th>#springMessage('cms.report.earningMoney')</th>
		        <th>#springMessage('cms.report.defrayMoney')</th>
		        <th>#springMessage('cms.report.afterBalance')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($map in $list)
		    		<tr>
		    			<td rowspan="$!{map.size}">$!{map.corpCode} $!{map.corpName}</td>
		    			#set ($curCount = 1 )
		    			#foreach($cur in $map.curList)
		   					#if($curCount != 1)<!-- 币别第二次或以后的 -->
		    					<tr><!-- 从新开头 -->
							#end
		    				<td rowspan="$!{cur.dataList.size()}">
		    					${cur.curName}
		    				</td>
		    				#set ($balCount = 1 )
		    				#foreach($bal in $cur.dataList)
			    				#if($balCount != 1)<!-- 第二次或以后的 -->
			    					<tr><!-- 从新开头 -->
			    				#end
			    				<td>$!{bal.loanSignName}</td>
			    				<td align="right">$number.formatNumeric(${bal.beformMoney})</td>
			    				<td align="right">$number.formatNumeric(${bal.earningMoney})</td>
			    				<td align="right">$number.formatNumeric(${bal.defrayMoney})</td>
			    				#set ($afterBalance =$!bal.earningMoney - $!bal.defrayMoney )
			   					<td align="right">$number.formatNumeric(${afterBalance})</td>
			    				#if($balCount != 1)<!-- 第二次或以后的 -->
			    					</tr><!-- 结尾 -->
			    				#end
			    				#set ($balCount = $balCount + 1 ) <!-- 数据循环下标+1 -->
			    				
			    				#if($curCount == 1)<!-- 循环第一次 -->
			    					</tr><!-- 结尾第一行 -->
								#end
								#set ($curCount = $curCount + 1 ) <!-- 币别循环下标+1 -->
		    				#end
		    			#end
		    	#end
		    </tbody>
		</table>
	</div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
<script>
bt.use(['form','moneyType'], function(){
    $ = bt.jquery;
    moneyFun = bt.moneyType.getFun();
    initPie('$!{vo.corpId}','${vo.curId}');
});

function initPie(corpId,curId) {
	var myChartPie = echarts.init(document.getElementById('chartPie'));
    myChartPie.showLoading();
    //通过Ajax获取数据
    var url = basePath + "/cms/report/cmsbalancegather/gatherPieList";
    $.ajax({
        type: "post",
        async: false, //同步执行
        url: url,
        data: {"corpId":corpId,"curId":curId},
        dataType: "json", //返回数据形式为json
        success: function (result) {
            var option = initChartPie(result.legend,  result.series ,result.title);
            myChartPie.hideLoading();
            myChartPie.setOption(option, true);

           /*  function open(param) {
                // 获取跳转的参数
                var corpIndex = Math.ceil((param.dataIndex + 1) / 4);
                var keyParam = result.xAxisData2[corpIndex - 1] + param.name + param.seriesName;
                var openParam = (result.openParams)[keyParam].split(",");
                var openUrl = basePath + "/report/allocation/open?corpId=" + openParam[0] + "&voucherFrom=" + openParam[1] + "&curId=" + openParam[2];
                if (bt.navtab) {
                    bt.navtab.addNavtab(bt.lang('table.nisAllocationReport.list'), openUrl);
                    return;
                }
            } 
            myChartPie.on('click', open);*/
        }
    });
}

function loadCorpCurData(corpId,curId){
	initPie(corpId,curId);//默认进来加载汇总的折合人民币
}

function initChartPie(legend,  series ,title) {
	option = {
		 	title: title,
            tooltip: {
                trigger: 'item',
                formatter: function(params,ticket,callback){//"{b} : {c} ({d}%)"
                	var result = params.name + " : " + moneyFun.format(params.value,{separator: ",",decimal: 2}) + " ( "+ params.percent +"% )";
                	return result;
                },
                axisPointer: {            // 坐标轴指示器，坐标轴触发有效
                    type: 'shadow'        // 默认为直线，可选为：'line' | 'shadow'
                }
            },
            legend: {
                data: legend,
                bottom: 10,
                left: 'center',
            },
		    toolbox: {
		        show : true,
		        feature : {
		            mark : {show: true},
		            dataView : {show: true, readOnly: false},
		            restore : {show: true},
		            saveAsImage : {show: true}
		        }
		    },
	    	calculable : false,
	    	series: JSON.parse(series)
	   	};
	return option;
}


</script>

</html>
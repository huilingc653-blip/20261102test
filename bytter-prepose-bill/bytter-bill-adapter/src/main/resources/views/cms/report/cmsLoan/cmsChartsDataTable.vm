<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        //这里填写新的样式代码
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="isInclude" value="$!{isInclude}">
    <input type="hidden" name="curId" value="$!{curId}">
    <input type="hidden" name="moneyType" value="$!{moneyType}">
    <input type="hidden" name="isConvert" value="$!{isConvert}">
    <input type="hidden" name="convertCurId" value="$!{convertCurId}">
    <input type="hidden" id="corpIds" name="corpIds">
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('cms.report.loan.RemainingPeriod')</th><!--剩余期限  -->
        <th>#springMessage('cms.report.loan')</th><!--内部贷款  -->
        <th>#springMessage('cms.loan.precative')</th><!--委托贷款  -->
        <th>#springMessage('cms.report.loan.provide')</th><!--银行借款  -->
        <th>#springMessage('table.onlineledger.total')</th><!--总计  -->
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script>
    bt.use(["jquery", "form", "datatable", "moneyType"], function () {
        $ = bt.jquery;
        form = bt.form();
        moneyType = bt.moneyType.init();
        moneyfun = moneyType.getFun();
        $("#corpIds").val(window.parent.getCorpIds());
        bt.datatable.init({
            elem: "#appTable",
            ajax: {
                url: basePath + "/cms/report/cmsExpireAnalysis/getchartsDataTable",
            },
            searchForm:{
                formElem:"#searchForm",
                formFilter:"search"
            },
            buttonsLayout: false,
            paging: false,
            columns: [
                {
                    data: "remainTermName",
                    className: "textRight"
                },
                {
                    data: "loanData",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                },
                {
                    data: "precativeData",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                },
                {
                    data: "privodeData",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                },
                {
                    data: "totalData",
                    className: "textRight",
                    render: function (data, type, row, meta) {
                        return moneyfun.format(data);
                    }
                }
            ],
            summary: {
                pageSum: true,//小计功能开启
                selectSum: true,//已选汇总功能开启
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '2',//汇总列序号
                        dataName: 'loanData',//汇总列数据
                    },
                    {
                        colNum: '3',//汇总列序号
                        dataName: 'precativeData',//汇总列数据
                    },
                    {
                        colNum: '4',//汇总列序号
                        dataName: 'privodeData',//汇总列数据
                    },
                    {
                        colNum: '5',//汇总列序号
                        dataName: 'totalData',//汇总列数据
                    }
                ]
            }
        });
        //这里填写新的js代码，请参考前端文档
    });
</script>
</body>
</html>

        postData = function (result) {
            var proBeforHtml = '';
            var proSeasonHtml = '';
            var proYearHtml = '';
            var proBeforYearHtml = '';

            var preBeforHtml = '';
            var preSeasonHtml = '';
            var preYearHtml = '';
            var preBeforYearHtml = '';

            var loanBeforHtml = '';
            var loanSeasonHtml = '';
            var loanYearHtml = '';
            var loanBeforYearHtml = '';

            //操作成功，且有值做拼接操作
            if(result.provideList.length > 0){
                for(var i=0;i<result.provideList.length;i++){
                    var obj = result.provideList[i];
                    proBeforHtml += appHtml(obj,obj.balanceM,obj.differenceM,obj.scaleM);
                    proSeasonHtml += appHtml(obj,obj.balanceS,obj.differenceS,obj.scaleS);
                    proYearHtml += appHtml(obj,obj.balanceY,obj.differenceY,obj.scaleY);
                    proBeforYearHtml += appHtml(obj,obj.balanceL,obj.differenceL,obj.scaleL);
                }
            }

            if(result.precativeList.length > 0){
                for(var i=0;i<result.precativeList.length;i++){
                    var obj = result.precativeList[i];
                    preBeforHtml += appHtml(obj,obj.balanceM,obj.differenceM,obj.scaleM);
                    preSeasonHtml += appHtml(obj,obj.balanceS,obj.differenceS,obj.scaleS);
                    preYearHtml += appHtml(obj,obj.balanceY,obj.differenceY,obj.scaleY);
                    preBeforYearHtml += appHtml(obj,obj.balanceL,obj.differenceL,obj.scaleL);
                }
            }

            if(result.loanList.length > 0){
                for(var i=0;i<result.loanList.length;i++){
                    var obj = result.loanList[i];
                    loanBeforHtml += appHtml(obj,obj.balanceM,obj.differenceM,obj.scaleM);
                    loanSeasonHtml += appHtml(obj,obj.balanceS,obj.differenceS,obj.scaleS);
                    loanYearHtml += appHtml(obj,obj.balanceY,obj.differenceY,obj.scaleY);
                    loanBeforYearHtml += appHtml(obj,obj.balanceL,obj.differenceL,obj.scaleL);
                }
            }

            if("preBefor" == cycleType || null == cycleType){
                if("precativeDtl" == cmsName || null == cycleType) {
                    $('#dtl-content').html(preBeforHtml);
                }else if("provideDtl" == cmsName){
                    $('#dtl-content').html(proBeforHtml);
                }else if("loanDtl" == cmsName){
                    $('#dtl-content').html(loanBeforHtml);
                }
            }
            if("preSeason" == cycleType ){
                if("precativeDtl" == cmsName) {
                    $('#dtl-content').html(preSeasonHtml);
                }else if("provideDtl" == cmsName){
                    $('#dtl-content').html(proSeasonHtml);
                }else if("loanDtl" == cmsName){
                    $('#dtl-content').html(loanSeasonHtml);
                }
            }
            if("preYear" == cycleType ){
                if("precativeDtl" == cmsName) {
                    $('#dtl-content').html(preYearHtml);
                }else if("provideDtl" == cmsName){
                    $('#dtl-content').html(proYearHtml);
                }else if("loanDtl" == cmsName){
                    $('#dtl-content').html(loanYearHtml);
                }
            }
            if("preBeforYear" == cycleType ){
                if("precativeDtl" == cmsName) {
                    $('#dtl-content').html(preBeforYearHtml);
                }else if("provideDtl" == cmsName){
                    $('#dtl-content').html(proBeforYearHtml);
                }else if("loanDtl" == cmsName){
                    $('#dtl-content').html(loanBeforYearHtml);
                }
            }
        }

        function appHtml(obj,balance,difference,scale) {
            var appendContent='';
            appendContent += '      <div class="cms-detail-item">';
            appendContent +=  '        <div class="cms-detail-header">'+obj.corpName +'</div>';
            appendContent +=  '        <div class="cms-detail-total">' + bt.money.format(obj.currentBalance) +'</div>';
            appendContent +=  '        <div class="cms-detail-remark">本期余额 ('+obj.curName+'）</div>';
            appendContent +=  '        <section class="cms-detail-money">';
            appendContent +=  '             <div class="ui-row-flex">';
            appendContent +=  '                 <div class="ui-col ui-col cms-detail-info">';
            appendContent +=  '                     <div class="cms-detail-title">余额</div>';
            appendContent +=  '                     <div class="cms-detail-number">' + bt.money.format(balance) +'</div>';
            appendContent +=  '                 </div>';
            appendContent +=  '                 <div class="ui-col ui-col cms-detail-info">';
            appendContent +=  '                     <div class="cms-detail-title">差额</div>';
            appendContent +=  '                     <div class="cms-detail-number">' + bt.money.format(difference) +'</div>';
            appendContent +=  '                 </div>';
            appendContent +=  '                 <div class="ui-col ui-col cms-detail-info">';
            appendContent +=  '                     <div class="cms-detail-title">比例</div>';
            appendContent +=  '                     <div class="cms-detail-number">' + bt.money.format(scale) +'%</div>';
            appendContent +=  '                 </div>';
            appendContent +=  '             </div>';
            appendContent +=  '         </section>';
            appendContent +=  '     </div>';
            return appendContent;
        }
        var chart = null;
        //设置图表Div
        function setBalChartDiv(res) {
            console.log('res'+ res[0])
            //alert("进入绘图数据设置")
            var params = [];
            var originDates = [];
            var maxValue = 0;
            for(var i=0;i<res.length;i++){
             /*   alert("进入循环方法")
                alert("实体:"+res[i].name);*/
                var obj = res[i];
                var val = obj.data-0;
                params.push({name:obj.name,xname:obj.xList,value:val});
                if(originDates.indexOf(obj.xList) == -1 && originDates.length < 3) {
                    originDates.push(obj.xList);
                }
                if(val > maxValue){
                    maxValue = val;
                }
            }
            var data = JSON.stringify(params);
            var  dataArray=JSON.parse(data);
            //alert("data"+data)

            // Step 1: 创建 Chart 对象
            if(!chart){
                chart = new F2.Chart({
                    id: 'myChart',
                    pixelRatio: window.devicePixelRatio, // 指定分辨率
                });
            }else {
                chart.clear()
            }
            // Step 2: 载入数据源
            maxValue = Math.ceil(maxValue);
            chart.source(dataArray,{ //1、立即更新数据chart.changeData(data);　2、
                'xname': {
                    type: 'cat',
                    tickCount: 3,
                    values: originDates
                },
                steps: {
                    tickCount:3
                },
                'value':{//设置纵轴刻度
                    tickCount:5,
                    min:0,
                    max:maxValue
                }
            });

            var getAxisXText = function(text){
                for(var i =0;i < dataArray.length;i++){
                    if(dataArray[i].xname === text){
                        return text;
                    }
                }
                return text
            }


            //设置横坐标样式
            chart.axis('xname', { // 横坐标样式
                tickLine: { // 横坐标名字上面那个突出的小线段
                    length: 0,
                    stroke: '#EFEFEF' //小线段的颜色
                },
                label: function (text, index, total) {  //横坐标文字设置
                    return {
                        text:getAxisXText(text),//内容
                        fill: '#666666' //字体颜色
                    }
                },
                line: {
                    top: true
                }
            });

//设置纵坐标样式
            chart.axis('value', {
                position: 'left', // 纵坐标位置
                label: function label(text) {
                    return {
                        text: text,
                        fill: '#666666'
                    };
                },
                tickCount: 5,
                grid: { //网格线
                    stroke: '#EFEFEF',
                    border:'line'
                }
            });

// Step 3：创建图形语法，绘制柱状图，由 month 和 value 两个属性决定图形位置，month 映射至 x 轴，value 映射至 y 轴
            chart.legend({
                align: 'center',
            }) // 是否显示图例
            chart
                    .interval()
                    .position('xname*value')
                    .size(6)　//设置柱状大小
                    .color('name')
                    .adjust({
                        type: 'dodge',
                        marginRatio: 0.2 // 设置分组间柱子的间距
                    })
                    .style('type',{
                        radius:function radius() {　//设置柱状图圆角
                            return [3,3,3,3]
                        }
                    });

            chart.interaction("pan");
            chart.scrollBar({
                xStyle: {
                    backgroundColor: "#e8e8e8",
                    fillerColor: "#808080",
                    offsetY: -2
                }
            });

            // Step 4: 渲染图表
            chart.render();

            /*chart.interaction('interval-select', {
              startEvent:'tap',
              cancelable:true,
              defaultSelected: { name: '机器之血', percent: 0.18, a: '1' },
              onStart:function(){
              },
              onEnd:function(obj){
                console.log(obj);
                if(obj.data){
                    console.log(obj.data)
                    $("#xName").html(obj.shapeInfo._origin.xname);
                    $("#textValue").html(obj.shapeInfo._origin.value);
                    $("#textName").html(obj.shapeInfo._origin.name);
                }
              }
            });*/
        }
    })(document, window);

</script>
</html>

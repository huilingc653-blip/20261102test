<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="natureIdHidden" value=""/>
    <input type="hidden" id="selectCycle" value=""/>
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight">#springMessage("table.btBankAcc.corpId")</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-name="corpId" data-biz-type="corp" data-type="selectTree" data-biz-name="corpId"
                         data-tree-type="check"
                         data-checkkboxtype='{"Y":"s","N":"s"}'
                         data-resource="cms:report:loan:analysis:query"
                         data-afterInit="bt.initValue"
                         data-required="true"
                    ></div>
                </div>
            </td>
            
            ##是否折合币种
            <td class="textRight">#springMessage("common.isConvert.currency")</td>
            <td>
                <div class="layui-form">
                    <div class="bt-biz-dict" data-type="radio" data-defaultvalue="0" data-callback="callToCurr" data-biz-name="isToCurr"  data-name="isToCurr" data-group="sf_yn" ></div>
                </div>
            </td>
        </tr>

        <tr>
        ##币别
            <td class="textRight">#springMessage("table.btBankAccCur.cur")</td>
            <td>
                <div class="bt-biz-selectType"
                     data-biz-name="curId"
                     data-url="${basePath}/basic/business/btcurrency/json"
                     data-valuefield="id"
                     data-textfield="curName"
                     data-name="curId"
                     data-search="true"
                     data-defaultvalue="$!{curId}"
                     data-required="true"
                     data-callback="checkConvertCurCallBack"
                ></div>
            </td>

        ##折合币种
            <td class="textRight">#springMessage("commom.converted.into.currency")</td>
            <td>
                <div class="bt-biz-selectType"
                     data-biz-name="convertCurId"
                     data-url="${basePath}/basic/business/btcurrency/json"
                     data-valuefield="id"
                     data-textfield="curName"
                     data-name="convertCurId"
                     data-search="true"
                     data-defaultvalue="$!{convertCurId}"
                     data-disabled = "true"
                     data-callback="checkConvertCurCallBack"
                ></div>
            </td>
        </tr>

        <tr>
        ##对比周期
            <td class="textRight">#springMessage("statisticsReport.IntegratedQuery.comparedCycle")</td>
            <td>
                <div class="layui-form" autocomplete="off">
                    <div class="bt-biz-dict" data-type="mulselect" data-biz-name="cycle" data-name="cycle" data-group="Compare.the.cycle"></div>
                </div>
            </td>

        ##金额单位
            <td class="textRight">#springMessage("common.moneyType")</td>
            <td>
                <div class="layui-form" autocomplete="off">
                    <div class="bt-biz-dict" data-type="select" data-biz-name="moneyType" data-name="moneyType" data-group="cms.MoneyType" data-defaultvalue="1"></div>
                </div>
            </td>
            
        </tr>
        
        <tr>
        ##统计月份
            <td class="textRight">#springMessage("common.statistical.time")</td>
            <td>
                <input type="text" class="layui-input bt-biz-dateType" data-max="maxDate" data-type="month" data-today="true" id="statDate" name="monthDate" data-biz-name="statDate" data-callback="checkConvertCurCallBack" lay-verify="required">
            </td>
            

            <td class="textRight">#springMessage("common.display.mode")</td>
            <td>
                <div class="layui-form" autocomplete="off">
                    <div class="bt-biz-dict" data-type="radio" data-biz-name="displayMode" data-name="displayMode" data-group="display.mode" data-defaultvalue="1"></div>
                </div>
            </td>
        </tr>
        
        <tr>
            ##是否包含在途金额
            <td class="textRight">#springMessage("common.is.included")</td>
            <td>
                <div class="layui-form">
                    <div class="bt-biz-dict" data-type="radio" data-defaultvalue="0" data-biz-name="isContain"  data-name="isContain" data-group="sf_yn" ></div>
                </div>
            </td>

            ##统计维护
                <td class="textRight">#springMessage("balance.query.Statistical.dimension")</td>
                <td>
                    <div class="layui-form" autocomplete="off">
                        <div class="bt-biz-dict" data-type="select" data-biz-name="typesOfStatistics"  data-required="true" data-name="typesOfStatistics" data-group="Types.of.statistics" required="true"></div>
                    </div>
                </td>
        </tr>
        
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search1" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary" >#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>

    </table>
</form>

<div id="chartSum" style="width:100%;height:500px;display: none;"></div>

<div id="typeTable">
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th rowspan="2">#springMessage("table.fbsBudget.corpId")</th>##单位
            <th rowspan="2">#springMessage("common.Types.of.financing")</th>##融资种类
            <th rowspan="2">#springMessage("common.current.balance")</th>##本期余额
            <th colspan="3">#springMessage("statisticsReport.IntegratedQuery.befMonthEnd")</th>##较上月末
            <th colspan="3">#springMessage("statisticsReport.IntegratedQuery.befQuarterEnd")</th>##较上季度末
            <th colspan="3">#springMessage("statisticsReport.IntegratedQuery.befYear")</th>##较去年同期
            <th colspan="3">#springMessage("statisticsReport.IntegratedQuery.yearEarly")</th>##较年初
        </tr>
    
        <tr>
            <th>#springMessage("table.accountDTO.balance")</th>##余额
            <th>#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>##差额
            <th>#springMessage("table.bisGatherPolicy.scale")</th>##比例
            
            <th>#springMessage("table.accountDTO.balance")</th>##余额
            <th>#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>##差额
            <th>#springMessage("table.bisGatherPolicy.scale")</th>##比例
            
            <th>#springMessage("table.accountDTO.balance")</th>##余额
            <th>#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>##差额
            <th>#springMessage("table.bisGatherPolicy.scale")</th>##比例
           
            <th>#springMessage("table.accountDTO.balance")</th>##余额
            <th>#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>##差额
            <th>#springMessage("table.bisGatherPolicy.scale")</th>##比例
        </tr>
    </thead>
</table>
</div>

<div id="timeTable" style="display: none;">
    <table id="appTable2" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th rowspan="2">#springMessage("table.fbsBudget.corpId")</th>##单位
            <th rowspan="2">#springMessage("common.Types.of.financing")</th>##融资种类
            <th rowspan="2">#springMessage("table.cms.financing.period")</th>##融资期限
            <th rowspan="2">#springMessage("common.current.balance")</th>##本期余额
            <th colspan="3" class="M">#springMessage("statisticsReport.IntegratedQuery.befMonthEnd")</th>##较上月末
            <th colspan="3" class="S">#springMessage("statisticsReport.IntegratedQuery.befQuarterEnd")</th>##较上季度末
            <th colspan="3" class="L">#springMessage("statisticsReport.IntegratedQuery.befYear")</th>##较去年同期
            <th colspan="3" class="Y">#springMessage("statisticsReport.IntegratedQuery.yearEarly")</th>##较年初
        </tr>

        <tr>
            <th class="M">#springMessage("table.accountDTO.balance")</th>##余额
            <th class="M">#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>##差额
            <th class="M">#springMessage("table.bisGatherPolicy.scale")</th>##比例

            <th class="S">#springMessage("table.accountDTO.balance")</th>##余额
            <th class="S">#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>##差额
            <th class="S">#springMessage("table.bisGatherPolicy.scale")</th>##比例

            <th class="L">#springMessage("table.accountDTO.balance")</th>##余额
            <th class="L">#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>##差额
            <th class="L">#springMessage("table.bisGatherPolicy.scale")</th>##比例

            <th class="Y">#springMessage("table.accountDTO.balance")</th>##余额
            <th class="Y">#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>##差额
            <th class="Y">#springMessage("table.bisGatherPolicy.scale")</th>##比例
        </tr>
        </thead>
    </table>
</div>

<div id="typeChart" style="display: none;">     
    <table id="appTable1" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr class="draw">
                <th>#springMessage("table.fbsBudget.corpId")</th>##单位
                <th>#springMessage("common.Types.of.financing")</th>##融资种类
                <th>#springMessage("table.btBankAccCur.cur")</th>##币别
                <th>#springMessage("common.current.balance")</th>##本期余额
                <th>#springMessage("table.last.month.balance")</th>##上月末余额
                <th>#springMessage("table.last.season.balance")</th>##上季末余额
                <th>#springMessage("table.last.year.balance")</th>##去年同期余额
                <th>#springMessage("table.fcInitAcc.yearBalance")</th>##年初余额
            </tr>
        </thead>
    </table>
</div>

<div id="timeChart" style="display: none;">
    <table id="appTable3" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr class="draw">
            <th>#springMessage("table.fbsBudget.corpId")</th>##单位
            <th>#springMessage("common.Types.of.financing")</th>##融资种类
            <th>#springMessage("table.cms.financing.period")</th>##融资期限
            <th>#springMessage("table.btBankAccCur.cur")</th>##币别
            <th>#springMessage("common.current.balance")</th>##本期余额
            <th>#springMessage("table.last.month.balance")</th>##上月末余额
            <th>#springMessage("table.last.season.balance")</th>##上季末余额
            <th>#springMessage("table.last.year.balance")</th>##去年同期余额

</div>

#parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
<script>
    var corp;
    var selectType;
    var appTable = {"isInit": true}; 
    var appTable1 = {"isInit": false};
    var appTable2 = {"isInit": false};
    var appTable3 = {"isInit": false};
    var moneyFun;
    var dicts;
    var dateType;
    var selectCycle=new Array();//用于存放之前选择的对比周期
    cycles = "";
    bt.use(['form', 'datatable', 'dateType', 'selectType',  'dicts', 'corp','mulselect','moneyType','date'], function () {
        $ = bt.jquery, form = bt.form();
        bt.mulselect.init();
        dicts = bt.dicts.init();
        dateType = bt.dateType.init();
        var moneyType = bt.moneyType.init();
        moneyFun = moneyType.getFun();

        initTable("#appTable", appTable.columns,appTable.summary,appTable.html1);
        
        appTable.isInit = true;
        
        selectType = bt.selectType.init();
        corp = bt.corp.init();
        
    });


    // 设置可选的日期
    function maxDate() {
        var now = new Date();
        return now.getFullYear() + "-" + (now.getMonth() + 1) + "-" + now.getDate();
    }
//------------------------------------------------------------------------------------------
    function initTable(id,columns,summary,html){
        bt.datatable.init({
            elem: id,
            colReorder: true,
            //order: [2, 'desc'],
            ajax: {
                'url': basePath + "/cms/report/loanBalanceAnalysis/datatable"
            },
            exportFile:{
                customPrint:{
                    header:function(visible,dt){
                        var printHtml ;
                        if(visible.length == 16){
                            printHtml = thml2(visible); 
                        }else {
                            printHtml = thml1(visible);
                        }
                        
                        return printHtml;
                    },
                },
            },
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search1",
                customizeFormSearchFunction:function (data) {
                    cycles = data.field.cycle.toString();
                    $.each(data,function(i){
                        selectCycle[i]=data[i].cycle;
                    });
                    
                    var mode = data.field.displayMode;
                    if (mode == "1") { 
                        if(dicts.get("typesOfStatistics").val() == "2"){//融资期限
                            $("#typeChart").hide();
                            $("#typeTable").hide();
                            $("#chartSum").hide();
                            $("#timeChart").hide();
                            $("#timeTable").show();
                            id = "appTable2";
                        }else {
                            $("#typeChart").hide();
                            $("#timeChart").hide();
                            $("#chartSum").hide();
                            $("#timeTable").hide();
                            $("#typeTable").show();
                            id = "appTable";
                        }
                        
                    } else {
                        if(dicts.get("typesOfStatistics").val() == "2") {//融资期限
                            $("#typeTable").hide();
                            $("#timeTable").hide();
                            $("#typeChart").hide();
                            $("#chartSum").show();
                            $("#timeChart").show();//期限
                            id = "appTable3";
                        }else {
                            $("#typeTable").hide();
                            $("#timeTable").hide();
                            $("#timeChart").hide();//期限
                            $("#typeChart").show();
                            $("#chartSum").show();
                            id = "appTable1";
                        }
                    }
                    initTableSet(id);
                    
                    return false;
                }
            },
            columns: columns,
            summary:summary,
            btInitComplete: function (settings, data) {
                //$(".count").removeAttr("data-money");
                //initBar();
            },
            btDrawCallback:function(setting){
                if(dicts.get("displayMode").val() == "2"){//图表
                    var api = new $.fn.dataTable.Api(setting);
                    var list = api.rows( {page:'current'} ).data();
                    var data = list.splice(0,list.length);
                    var types = dicts.get("typesOfStatistics").val();
                    if(types == "3"){
                        var corpIds = corp.get("corpId").val();
                        data[0].corpIds = corpIds;
                    }
                    data[0].typesOfStatistics = types;
                    initBar(data);
                }
            }
        });
    }

    /**
     * 初始化设置
     * @param layId
     */
    function initTableSet(layId){
        var  tableId = "#" + layId;
        var columns = null;
        var obj = null;
        var summary = null;
        var printHtml = '';
        var file = {}
        var colShow = null;
        if ("appTable" == layId) {
            obj = appTable;
            colShow = setColShow(selectCycle,1);
            columns = appTable.columns;
            summary = appTable.summary;
            printHtml = appTable.html1;
        }else if("appTable1" == layId){
            obj = appTable1;
            colShow = setColShow(selectCycle,2);
            columns = appTable1.columns;
            summary = appTable1.summary;
        }else if("appTable2" == layId){
            obj = appTable2;
            colShow = setColShow(selectCycle,3);
            columns = appTable2.columns;
            summary = appTable2.summary;
            printHtml = appTable2.html2;
        }else{
            obj = appTable3;
            colShow = setColShow(selectCycle,4);
            columns = appTable3.columns;
            summary = appTable3.summary;
        }

        if ( !obj.isInit ) {
            bt.each(colShow.hide,function (i,col) {
                columns[col].visible = false
            })
            initTable(tableId, columns,summary,printHtml);
            obj.isInit = true;
        } else {
            bt.each(colShow.visible,function (index,col) {
                setColumnShow($.fn.dataTable.Api(tableId),col,true)
            })
            bt.each(colShow.hide,function (index,col) {
                setColumnShow($.fn.dataTable.Api(tableId),col,false)
            })
            $.fn.dataTable.Api(tableId).draw();
        }
    }

  function setColShow(cycle,sign) {
        var obj = {
            visible:[],
            hide:[]
        }
        if(1== sign) {
            if (cycle.field.indexOf("M") != -1 || cycle.field == "") {//较上月
                obj.visible.push([3,4,5]);
            } else {
                obj.hide.push([3,4,5]);
            }

            if (cycle.field.indexOf("S") != -1 || cycle.field == "") {//较上季末
                obj.visible.push([6,7,8]);
            } else {
                obj.hide.push([6,7,8]);
            }

            if (cycle.field.indexOf("L") != -1 || cycle.field == "") {//较去年同期
                obj.visible.push([9,10,11]);
            } else {
                obj.hide.push([9,10,11]);
            }

            if (cycle.field.indexOf("Y") != -1 || cycle.field == "") {//较去年同期
                obj.visible.push([12,13,14]);
            } else {
                obj.hide.push([12,13,14]);
            }
        }
        
        if(2 == sign || 4 ==sign){
            
            if (cycle.field.indexOf("M") != -1 || cycle.field == "") {//较上月
                if(2 == sign) {
                    obj.visible.push(4);
                }else {
                    obj.visible.push(5);
                }
            } else {
                if(2 == sign) {
                    obj.hide.push(4);
                }else {
                    obj.hide.push(5);
                }
            }
            
            
            if (cycle.field.indexOf("S") != -1 || cycle.field == "") {//较上季末
                if(2 == sign) {
                    obj.visible.push(5);
                }else {
                    obj.visible.push(6);
                }
            } else {
                if(2 == sign) {
                    obj.hide.push(5);
                }else {
                    obj.hide.push(6);
                }
            }

            if (cycle.field.indexOf("L") != -1 || cycle.field == "") {//较去年同期
                if(2 == sign) {
                    obj.visible.push(6);
                }else {
                    obj.visible.push(7);
                }
            } else {
                if(2 == sign) {
                    obj.hide.push(6);
                }else {
                    obj.hide.push(7);
                }
            }

            if (cycle.field.indexOf("Y") != -1 || cycle.field == "") {//较去年同期
                if(2 == sign) {
                    obj.visible.push(7);
                }else {
                    obj.visible.push(8);
                }
            } else {
                if(2 == sign) {
                    obj.hide.push(7);
                }else {
                    obj.hide.push(8);
                }
            }
        }

      if(3 == sign) {
          if (cycle.field.indexOf("M") != -1 || cycle.field == "") {//较上月
              obj.visible.push([4,5,6]);
          } else {
              obj.hide.push([4,5,6]);
          }

          if (cycle.field.indexOf("S") != -1 || cycle.field == "") {//较上季末
              obj.visible.push([7,8,9]);
          } else {
              obj.hide.push([7,8,9]);
          }

          if (cycle.field.indexOf("L") != -1 || cycle.field == "") {//较去年同期
              obj.visible.push([10,11,12]);
          } else {
              obj.hide.push([10,11,12]);
          }

          if (cycle.field.indexOf("Y") != -1 || cycle.field == "") {//较去年同期
              obj.visible.push([13,14,15]);
          } else {
              obj.hide.push([13,14,15]);
          }
      }
        
        return obj;
    }


    function setColumnShow(table,index,flag) {
        var column = table.columns( index );
        column.visible( flag );
    }
    
    appTable.columns = [
        {data: "corpName", bSortable: false,className:"center"},
        {data: "loanSignName", bSortable: false,className:"center"},
        {data: "currentBalance", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                var corpId = full.corpId;
                var loanSign = full.loanSign;
                var curId =  full.curId;
                return '<a class="" href="#" data-row="'+meta.row+'" onclick="view(\''+corpId+'\',\''+loanSign+'\',\''+curId+'\')">'+moneyFun.format(full.currentBalance,{separator: ","})+'</a> ';
            }
        },
        {data: "balanceM", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                return moneyFun.format(full.balanceM, {separator: ","});
            }
        },
        {data: "differenceM", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                return moneyFun.format(full.differenceM,{separator: ","});
            }
        },
        {data: "scaleM", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                if(full.currentBalance == 0.00 || full.currentBalance == null) {
                    return "-";
                }else {
                    return moneyFun.format(full.scaleM, {separator: ",", decimal: 2}) + "%";
                }
            }
        },
        {data: "balanceS", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                return moneyFun.format(full.balanceS, {separator: ","});
            }
        },
        {data: "differenceS", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                return moneyFun.format(full.differenceS, {separator: ","});
            }
        },
        {data: "scaleS", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                if(full.currentBalance == 0 || full.currentBalance == null) {
                    return "-";
                }else{
                    return moneyFun.format(full.scaleS, {separator: ",", decimal: 2}) + "%";
                }
            }
        },
        {data: "balanceL", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                return moneyFun.format(full.balanceL, {separator: ","});
            }
        },
        {data: "differenceL", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                return moneyFun.format(full.differenceL, {separator: ","});
            }
        },
        {data: "scaleL", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                if(full.currentBalance == 0 || full.currentBalance == null) {
                    return "-";
                }else{
                    return moneyFun.format(full.scaleL, {separator: ","}) + "%";
                }
            }
        },
        {data: "balanceY", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                return moneyFun.format(full.balanceY, {separator: ","});
            }
        },
        {data: "differenceY", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                return moneyFun.format(full.differenceY, {separator: ","});
            }
        },
        {data: "scaleY", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
                if(full.currentBalance == 0 || full.currentBalance == null) {
                    return "-";
                }else{
                    return moneyFun.format(full.scaleY, {separator: ","}) + "%";
                }
            }
        }
    ];

    appTable2.columns = [
        {data: "corpName", bSortable: false,className:"center"},
        {data: "loanSignName", bSortable: false,className:"center"},
        {data: "periodName", bSortable: false,className:"center"},
        {data: "currentBalance", bSortable: false,className:"textRight",
            render: function (data, type, full, meta) {
               // return moneyFun.format(full.currentBalance,{separator: ","});

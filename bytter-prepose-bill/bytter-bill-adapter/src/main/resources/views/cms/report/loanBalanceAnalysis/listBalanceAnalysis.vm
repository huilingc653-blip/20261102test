   var flag = false,myChartSum;
    function initBar(data){
        data[0].cycle = cycles;
        var url = basePath + "/cms/report/loanBalanceAnalysis/getBal";
        if(!flag){
            myChartSum= echarts.init(document.getElementById('chartSum'));
            flag = true;
        }
        var displayMode = displayMode = dicts.get("displayMode").val();
        $.ajax({
            type: "post",
            async: false, //同步执行
            url: url,
            contentType:"application/json",
            data:JSON.stringify(data),
            dataType: "json", //返回数据形式为json
            success: function (result) {
                result = $.parseJSON(result);
                var option = initChartSum(result);
                myChartSum.hideLoading();
                myChartSum.setOption(option, true);
                window.onresize = myChartSum.resize;
            }
        });
    }

    function initChartSum(result) {
        var option = result;
        return option;
    }
    
    function callToCurr(data){
        if(data.value =="1"){
            selectType.get("convertCurId").attr({'data-disabled':false,'data-required':true});
            selectType.get("curId").attr({'data-disabled':true,'data-required':false});
        }else {
            selectType.get("convertCurId").val("");
            selectType.get("convertCurId").attr({'data-disabled':true,'data-required':false});
            selectType.get("curId").attr({'data-disabled':false,'data-required':true});
        }
        form.renderIcon();
        checkConvertCurCallBack();
    }
    
function view(corpId,loanSign,curId,repayCycle) {
    var monthDate = $("#statDate").val();
    var isContain = dicts.get("isContain").val();
    if(bt.navtab){
        bt.navtab.addNavtab(bt.lang('common.view.data'), 
                basePath + "/cms/report/loanBalanceAnalysis/viewLoanInfo?corpId="+corpId+"&curId="+curId+"&loanSign="+loanSign+"&monthDate="+monthDate+"&isContain="+isContain+"&repayCycle="+repayCycle);
        return;
    }
    parent.layer.open({
        type: 2,
        area: ['850px', '530px'],
        maxmin: true,
        content: basePath + "/cms/report/loanBalanceAnalysis/viewLoanInfo?corpId="+corpId+"&curId="+curId+"&loanSign="+loanSign+"&monthDate="+monthDate+"&isContain="+isContain
    });
}


    /**
     * 币种转换校验
     */
    function checkConvertCurCallBack() {
        var origCur = selectType.get("curId").val();
        var convertCurId = selectType.get("convertCurId").val();
        var date = dateType.get("statDate").val();
        if (isNotEmpty(convertCurId)) {
            $.ajax({
                url: basePath + "/cms/report/loanBalanceAnalysis/checkConvertCurId",
                type:"post",
                data:{
                    "origCurId": origCur,
                    "convertCurId": convertCurId,
                    "date": date + "-01"
                },
                dataType: "json",
                success:function (data) {
                    if (!data.success) {
                        parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                        selectType.get("convertCurId").val("");
                    }
                }
            });
        }
    }

    /**
     * 为空判断
     * @param stringData
     * @returns {boolean}
     */
    function isEmpty(stringData) {
        if (null == stringData || stringData == "" || stringData == undefined || stringData == " " || stringData == "null") {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 非空判断
     * @param stringData
     * @returns {boolean}
     */
    function isNotEmpty(stringData) {
        return !isEmpty(stringData)
    }


<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

</head>
<body>
<form action="" style="padding: 0px 20px;" class="layui-form layui-form-pane">

    <table class="layui-table ">
        <tbody>
            <tr>
                <td class="textRight" width="20%">#springMessage('config.common.paramName')</td>
                <td width="80%">#springMessage('config.common.paramValue')</td>
            </tr>

            ##即将到期提醒天数
            <tr id="conConfig">
                <td class="textRight">#springMessage('bond.param.config.remind.day')</td>
                <td>
                    <div class="layui-inline">
                        <input title="#springMessage("bond.param.config.remind.day")" lay-verify="number" name="bond.expire_remind_day" value="$!{config.bond.expire_remind_day}" class="layui-input" type="text" onkeyup="value=zhzs(this.value)">
                    </div>
                    <span>#springMessage('config.nis.day')</span>
                </td>
            </tr>
        </tbody>
    </table>

    <br/><br/>
    <!-- 按钮 -->
    <div style="text-align: center;">
        <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage(
            'common.button.submit')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    </div>


</form>
    #parse("views/common/footer.vm")
<script>
    var ck,ck1,ck2;
    bt.use(['form', 'jquery', 'moneyType','dicts','checkboxs'], function () {
        var form = bt.form(), $ = bt.jquery;
        bt.moneyType.init();
        bt.dicts.init();
        //监听提交
        form.on('submit(configSubmit)', function (data) {
            bt.loading.show();
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                bt.loading.hide();
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, "JSON");
            return false;
        });
    });


    //只能输入数字
    function zhzs(value) {
        value = value.replace(/[^\d]/g, '');
        return value;
    }
</script>


</body>
</html>
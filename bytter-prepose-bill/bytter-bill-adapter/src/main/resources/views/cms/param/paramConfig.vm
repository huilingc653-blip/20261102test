</form>
    #parse("views/common/footer.vm")
<script>
    var ck,ck1,ck2;
    bt.use(['form', 'jquery', 'moneyType','dicts','checkboxs'], function () {
        var form = bt.form(), $ = bt.jquery;
        bt.moneyType.init();
        bt.dicts.init();

        //监听提交
        form.on('submit(configSubmit)', function (data) {
            bt.loading.show();
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                bt.loading.hide();
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, "JSON");
            return false;
        });

        ck = bt.checkboxs.init({//委托贷款
            elem : "#preCks",
            name : "cms.pre_relate_con_segment",
            checkAll : false,
            valueField:"value",
            textField:"textField",
            data:[{
                "value": "0",
                "textField": bt.lang("cms.config.makeLoans")
            },{
                "value": "1",
                "textField": bt.lang("cms.config.repayMents")
            }],
            checkedvalue: $("#preConSegment").val()
        });

        ck1 = bt.checkboxs.init({//银行借款
            elem : "#bankCks",
            name : "cms.bank_relate_con_segment",
            checkAll : false,
            valueField:"value",
            textField:"textField",
            data:[{
                "value": "0",
                "textField": bt.lang("cms.config.makeLoans")
            },{
                "value": "1",
                "textField": bt.lang("cms.config.repayMents")
            }],
            checkedvalue: $("#bankConSegment").val()
        });

        ck2 = bt.checkboxs.init({//内部贷款
            elem : "#loanCks",
            name : "cms.loan_relate_con_segment",
            checkAll : false,
            valueField:"value",
            textField:"textField",
            data:[{
                "value": "0",
                "textField": bt.lang("cms.config.makeLoans")
            },{
                "value": "1",
                "textField": bt.lang("cms.config.repayMents")
            }],
            checkedvalue: $("#loanConSegment").val()
        });

        var bankCon=$("#bankCon").val();
        if (bankCon == "1") {
            $(".unableRadio").removeAttr("disabled", false);
            $("input[name='cms.bank_relate_con_segment']").removeAttr("disabled");
        } else {
            $(".unableRadio").attr("disabled", true);
            $("input[name='cms.bank_relate_con_segment']").attr("disabled", true);
        }

        var relateRat=$("#relateRat").val();
        var relateBond=$("#relateBond").val();
        if (relateRat == "1"&&relateBond=="1") {//挂接授信且挂接保证金的情况下可以选择是否启用敞口授信
            $(".isRatOpen").removeAttr("disabled", false);
        } else {
            $(".isRatOpen").attr("disabled", true);
        }

        var preCon=$("#preCon").val();
        if (preCon== "1") {
            $("input[name='cms.pre_relate_con_type']").removeAttr("disabled");
            $("input[name='cms.pre_relate_con_segment']").removeAttr("disabled");
        } else {
            $("input[name='cms.pre_relate_con_type']").attr("disabled", true);
            $("input[name='cms.pre_relate_con_segment']").attr("disabled", true);
        }

        var loanCon=$("#loanCon").val();
        if (loanCon== "1") {
            $("input[name='cms.loan_relate_con_type']").removeAttr("disabled");
            $("input[name='cms.loan_relate_con_segment']").removeAttr("disabled");
        } else {
            $("input[name='cms.loan_relate_con_type']").attr("disabled", true);
            $("input[name='cms.loan_relate_con_segment']").attr("disabled", true);
        }
        form.render();

        //银行借款参数控制
        form.on('radio(relate_rat)', function (data) {
            relateRat=data.value;
            if (data.value == "1"&&relateBond=="1") {
                $(".isRatOpen").removeAttr("disabled", false);
            } else {
                $(".isRatOpen").attr("disabled", true);
            }
            form.render();
        });

        form.on('radio(isBond)', function (data) {
            relateBond=data.value;
            if (data.value == "1"&&relateRat=="1") {
                $(".isRatOpen").removeAttr("disabled", false);
            } else {
                $(".isRatOpen").attr("disabled", true);
            }
            form.render();
        });
        form.on('radio(bank_relate_con)', function (data) {
            if (data.value == "1") {
                $(".unableRadio").removeAttr("disabled", false);
                $("input[name='cms.bank_relate_con_segment']").removeAttr("disabled");
            } else {
                $(".unableRadio").attr("disabled", true);
                $("input[name='cms.bank_relate_con_segment']").attr("disabled", true);
            }
            form.render();
        });

    //委托贷款
    form.on('radio(pre_relate_con)', function (data) {
        if (data.value == "1") {
            $("input[name='cms.pre_relate_con_type']").removeAttr("disabled");
            $("input[name='cms.pre_relate_con_segment']").removeAttr("disabled");
        } else {
            $("input[name='cms.pre_relate_con_type']").attr("disabled", true);
            $("input[name='cms.pre_relate_con_segment']").attr("disabled", true);
        }
        form.render();
        return false;
    });
    // 内部贷款
    form.on('radio(loan_relate_con)', function (data) {
        if (data.value == "1") {
            $("input[name='cms.loan_relate_con_type']").removeAttr("disabled");
            $("input[name='cms.loan_relate_con_segment']").removeAttr("disabled");
        } else {
            $("input[name='cms.loan_relate_con_type']").attr("disabled", true);
            $("input[name='cms.loan_relate_con_segment']").attr("disabled", true);
        }
        form.render();
        return false;
    });
});
</script>


</body>
</html>

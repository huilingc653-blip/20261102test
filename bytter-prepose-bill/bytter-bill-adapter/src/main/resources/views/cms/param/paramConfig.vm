            </td>
        </tr>
        <tr>
        ##直融业务登记挂接资金计划科目
            <td class="textRight">#springMessage('df.select.directfinance.info.budget')</td>
            <td>
                <div class="layui-input-inline">
                    #if($!{config.cms.df_info_budget} == "")
                        <input type="text" class="layui-input" name="cms.df_info_budget" value=""/>
                    #else
                        <input type="text" class="layui-input" name="cms.df_info_budget"
                               value="$!{config.cms.df_info_budget}"/>

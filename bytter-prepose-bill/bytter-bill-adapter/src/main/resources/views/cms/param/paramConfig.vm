                    #if($!{config.cms.df_repay_budget} == "")
                        <input type="text" class="layui-input" name="cms.df_repay_budget" value=""/>
                    #else
                        <input type="text" class="layui-input" name="cms.df_repay_budget"
                               value="$!{config.cms.df_repay_budget}"/>

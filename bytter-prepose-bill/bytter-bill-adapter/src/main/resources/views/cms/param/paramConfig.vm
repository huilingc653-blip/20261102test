                <input title="#springMessage('abBillPledgeApply.interiorApply.yes')" name="cms.is_df_budget" value="1"
                       #if($config.cms.is_df_budget == 1)checked#end type="radio">
                <div class="layui-unselect layui-form-radio layui-form-radioed">
                    <i class="layui-anim layui-icon"> </i>
                    <span>#springMessage('abBillPledgeApply.interiorApply.yes')</span>

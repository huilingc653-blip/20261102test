<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

</head>
<body>
<input type="hidden" id="equityId" name="equityId" value="$!{equityId}">

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsEquity.equityCode')</th>##融资编号
        <th>#springMessage('table.cmsEquity.financingWay')</th>##融资方式
        <th>#springMessage('table.cmsEquity.investor')</th>##出资人
        <th>#springMessage('table.cmsEquity.invWay')</th>##出资方式
        <th>#springMessage('table.cmsEquity.invMoney')</th>##出资金额
        <th>#springMessage('table.cmsEquity.rmk')</th>##备注
        <th>#springMessage('table.fcFreeze.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
<div class="layui-form-item layui-form-submit" id="buttonDiv">
    <div class="layui-input-block">
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/cms/equity/equityRepoPlan.update.js?_btv=${resourceVersion}"></script>
</html>

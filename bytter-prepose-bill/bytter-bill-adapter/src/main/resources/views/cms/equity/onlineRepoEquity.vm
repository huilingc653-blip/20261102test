<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

</head>
<body>


<form class="layui-form" method="post">
    <input type="hidden" id="corpId" name="corpId" value="$!{corpId}">
    <input type="hidden" id="curId" value="$!{curId}">
    <input type="hidden" id="onlineSign" name="onlineSign" value="$!{repoVO.onlineSign}">
    <input type="hidden" id="id" name="id" value="$!{repoVO.id}">
    <input type="hidden" id="repoPlanId" name="repoPlanId" value="$!{repoVO.repoPlanId}">
    <input type="hidden" id="repoPlanDetailId" name="repoPlanDetailId" value="$!{repoVO.repoPlanDetailId}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.equityCode')</td>
            <td>
                <input type="hidden" id="equityCode" name="equityCode" value="$!{repoVO.equityCode}">
                <div>$!{repoVO.equityCode}</div>
            </td>
            ##融资方式
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.financingWay')</td>
            <td style="width: 35%">
                <input type="hidden" id="financingWay" name="financingWay" value="$!{repoVO.financingWay}">
                <div>$dictTag.get("cms.equity.financingWay",$!{repoVO.financingWay})</div>
            </td>
        </tr>
        <tr>
            ##出资人
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.investor')</td>
            <td style="width: 35%">
                <input name="investor" type="hidden" id="investor" value="$!{repoVO.investor}">
                <div>$!{repoVO.investor}</div>
            </td>
            ##出资方式
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.invWay')</td>
            <td style="width: 35%">
                <input name="invWay" type="hidden" id="invWay" value="$!{repoVO.invWay}">
                <div>$dictTag.get("cms.equity.invWay",$!{repoVO.invWay})</div>
            </td>
        </tr>
        <tr>
            ##出资金额
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.invMoney')</td>
            <td>
                <input name="invMoney" type="hidden" id="invMoney" value="$!{repoVO.invMoney}">
                <div> $number.formatNumeric($!{repoVO.invMoney})</div>
            </td>
            ##回购金额
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.repoMoney')</td>
            <td>
                <input name="repoMoney" type="hidden" id="repoMoney" value="$!{repoVO.repoMoney}">
                <div>$number.formatNumeric($!{repoVO.repoMoney})</div>
            </td>
        </tr>

        <tr>
            ##剩余回购金额
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.reRepoMoney')</td>
            <td>
                <input name="reRepoMoney" type="hidden" id="reRepoMoney" value="$!{repoVO.reRepoMoney}">
                <div>$number.formatNumeric($!{repoVO.reRepoMoney})</div>
            </td>
            ##回购日期
            <td class="textRight">#springMessage('table.cmsEquity.repoDate')</td>
            <td>
                <div class="layui-inline">
                    <input id="repoDate" name="repoDate" value="$!date.format('yyyy-MM-dd',$!repoVO.repoDate)"
                           data-biz-name="repoDate" data-type="date" lay-verify="required"
                        #if($!{repoVO.repoPlanDetailId} && $!{repoVO.repoPlanDetailId} != "")
                           readonly="readonly"
                        #end
                           class="layui-input bt-biz-dateType">
                </div>
                <div class="layui-inline">
                    ##                   选择对应计划
                    <button class="layui-btn" type="button" onclick="equityPlans()">#springMessage(
                        'common.button.selectPlan')</button>
                </div>
            </td>
        </tr>
        <tr>
            ##本次回购金额
            <td class="textRight">#springMessage('table.cmsEquity.thisRepoMoney')</td>
            <td>
                <input class="layui-input bt-biz-moneyType" data-maxlength="20" data-name="thisRepoMoney"
                       lay-verify="required|strlength" data-biz-name="thisRepoMoney" value="$!{repoVO.thisRepoMoney}"
                    #if($!{repoVO.repoPlanDetailId} && $!{repoVO.repoPlanDetailId} != "")
                       readonly="readonly"
                    #end
                       data-decimal="2" data-minus="false" type="text"
                >
            </td>
            ##收款人
            <td class="textRight">#springMessage('table.cmsEquity.payer')</td>
            <td>
                <input type="text" name="payer" id="payer" value="$!{repoVO.payer}" class="layui-input">
            </td>
        </tr>

        <tr>
            ##收款账号
            <td class="textRight">#springMessage('table.cmsEquity.onlinePaymentAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input lay-verify="required" name="onlinePaymentAcc" type="text" id="onlinePaymentAcc"
                           class="layui-input" value="$!{repoVO.onlinePaymentAcc}">
                    <div class="bt-div-search">
                        <button class="bt-biz-externalCorpBankAcc" id="selBeneficiary" type="button"
                                data-beforeClick="bt.externalCorpBankAccParams"
                                data-callback="externalCorpCallback">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
            ##收款账号名称
            <td class="textRight">#springMessage('table.cmsEquity.onlineAccName')</td>
            <td>
                <input lay-verify="required" name="onlineAccName" type="text" id="onlineAccName" class="layui-input"
                       value="$!{repoVO.onlineAccName}">
            </td>
        </tr>

        <tr>
            ##收款开户行名称
            <td class="textRight">#springMessage('table.cmsEquity.onlineBankName')</td>
            <td>
                <input lay-verify="required" name="onlineBankName" type="text" id="onlineBankName" class="layui-input"
                       value="$!{repoVO.onlineBankName}">
            </td>
            ##用途
            <td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
            <td>
                <input type="text" lay-verify="required" name="purpose" id="purpose" value="$!{repoVO.purpose}"
                       class="layui-input">
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.cmsEquity.rmk')</td>
            <td>
                <input type="text" name="rmk" id="rmk" value="$!{repoVO.rmk}" class="layui-input">
            </td>
        </tr>
        <tr>
            <td style="text-align: center;" colspan="4">
                <button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" id="temp">#springMessage('common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>

        </tbody>
    </table>


</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/cms/equity/equityRepoOnline.add.js?_btv=${resourceVersion}"></script>
</html>

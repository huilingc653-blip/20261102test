<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

</head>
<body>


<form class="layui-form" method="post">

    ##股权融资主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsEquity.mainMessage')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##股权融资类型
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.equityTypeCode')</td>
                        <td style="width: 35%">
                            $!{cmsEquityInfo.equityTypeName}
                        </td>
                        ##境内境外
                        <td class="textRight">#springMessage('table.cmsEquity.isDomestic')</td>
                        <td>
                            $!dictTag.get("btBankAcc.isDomesticBank",$!{cmsEquityInfo.isDomestic})
                        </td>
                    </tr>
                    <tr>
                        ##融资单位
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.corpId')</td>
                        <td style="width: 35%"  colspan="3">
                            $!{cmsEquityInfo.corpName}
                        </td>
                    </tr>
                    <tr>
                        ##币种
                        <td class="textRight">#springMessage('table.cmsEquity.curId')</td>
                        <td>
                            $!{cmsEquityInfo.curName}
                        </td>
                        ##融资金额
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.money')</td>
                        <td>
                            $!number.formatNumeric($!{cmsEquityInfo.money})
                        </td>
                    </tr>

                    <tr>
                        ##验资账号
                        <td class="textRight">#springMessage('table.cmsEquity.account')</td>
                        <td>
                            $!{cmsEquityInfo.account}
                        </td>
                        ##账户名称
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.accName')</td>
                        <td>
                            $!{cmsEquityInfo.accName}
                        </td>
                    </tr>

                    <tr>
                        ##开户行名称
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.bankName')</td>
                        <td>
                            $!{cmsEquityInfo.bankName}
                        </td>
                        ##融资日期
                        <td class="textRight">#springMessage('table.cmsEquity.financingDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!cmsEquityInfo.financingDate)
                        </td>
                    </tr>
                    <tr>
                        ##交割日期
                        <td class="textRight">#springMessage('table.cmsEquity.deliveryDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!cmsEquityInfo.deliveryDate)
                        </td>
                        ##融资用途
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.financingUse')</td>
                        <td>
                            $!{cmsEquityInfo.financingUse}
                        </td>
                    </tr>
                        ##备注
                    <tr>
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                        <td colspan="3">
                            $!{cmsEquityInfo.rmk}
                        </td>
                    </tr>
                    </tbody>
                </table>
                </table>
            </div>
        </div>
    </div>
    <input type="hidden" name="ids" id="ids" value="$!{ids}">
    ##股权融资明细信息

    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsEquity.detail')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <br>
                <table id="appTable" class="layui-table layui-form" style="width:100%;">
                    <thead>
                    <tr>
                        <th>#springMessage('table.cmsEquity.equityCode')</th>
                        <th>#springMessage('table.cmsEquity.financingWay')</th>
                        <th>#springMessage('table.cmsEquity.investor')</th>
                        <th>#springMessage('table.cmsEquity.invWay')</th>
                        <th>#springMessage('table.cmsEquity.invMoney')</th>
                        <th>#springMessage('table.cmsEquity.equityProUn')</th>
                        <th>#springMessage('table.cmsEquity.assetName')</th>
                        <th>#springMessage('table.fcFreeze.status')</th>##状态
                        <th>#springMessage('table.cmsEquity.rmk')</th>
                    </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    ##第三方费用信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.chargeMessage')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">

                    <tr>
                        <td colspan="4" align="center" width="80">
                            <table id="dataTable" class="layui-table">
                                <thead>
                                <th width="25%">#springMessage('table.fcChargeRule.fcChargeType')</th>##费用类型
                                <th width="25%"> #springMessage('table.guaGuarantee.handleRate')</th>##费率
                                <th width="25%">#springMessage('table.cms.projected.expemditure')</th>##预计费用
                                </thead>
                                <tbody>
                                    #if($costVOS.size() > 0)
                                        #foreach($detail in $!{costVOS})
                                            #set($vcount = $velocityCount - 1)
                                            #set($velocityCount = $costVOS.size() - 1)
                                        <tr>
                                            <td align="center">
                                                <input type="text" style="text-align: center;" value="$!{detail.costName}" disabled="true" class="layui-input">
                                            </td>

                                            <td align="center">##费率
                                                <input type="text" style="text-align: right;" value="$!rateTag.show($!{detail.rate})" disabled="true" class="layui-input">
                                            </td>

                                            <td align="center">##预计费用
                                                <input type="text" style="text-align: right;"  value="$!number.formatNumeric($!{detail.advanceFees})" disabled="true" class="layui-input">
                                            </td>

                                        </tr>
                                        #end
                                    #end
                                </tbody>
                            </table>
                        </td>
                </table>
            </div>
        </div>
    </div>
    ##其他业务挂接信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.otherBusMessage')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td class="textRight">#springMessage('cms.loan.attachment')</td>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input id="annexName" name="uploadId" type="hidden" value="$!{cmsEquityInfo.uploadId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>

</form>
    #parse("views/common/footer.vm")
</body>

<script type="text/javascript">
    bt.use(['form', 'datatable', 'corp', 'moneyType', 'btUpload', 'dicts', 'jquery','selectType','rateType','bttable'], function () {
        $ = bt.jquery, form = bt.form();
        bt.moneyType.init();
        bt.selectType.init();
        bt.rateType.init();

        var gid = $("#annexName").val();
        bt.btUpload.init({
            elem: "#uploader",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gid
        });

        /**
         * 生成列表
         */
        bttable = bt.bttable.init({
            elem: "#appTable",
            mulselect:false,
            checkbox: false,
            'url': basePath + "/cms/equity/info/detailDatatable?ids="+$("#ids").val(),
            fixedColumns: {
                rightColumns: 2//代表冻结右边一列
            },
            columns: [
                {data:"equityCode",className:"center",render:function(data, row){
                        return data.equityCode;
                    }},
                {data:"financingWay",className:"center",render:function(data, row){
                        return bt.dict("cms.equity.financingWay", data.financingWay);
                    }},
                {data:"investor",className:"center",render:function(data, row){
                        return data.investor;
                    }},
                {data:"invWay",className:"center",render:function(data, row){
                        return bt.dict("cms.equity.invWay", data.invWay);
                    }},
                {data:"invMoney",className:"textRight",render: function ( data ){
                        return bt.money.format(data.invMoney);
                    }},
                {data:"equityPro",className:"center",render:function(data, row){
                        return data.equityPro*100;
                    }},
                {data:"assetName",className:"center",render:function(data, row){
                        return data.assetName;
                    }},
                {data:"bizStatus",className:"center",render:function(data, row){
                        return bt.dict("cms.equity.detail.bizStatus", data.bizStatus);
                    }},
                {data:"rmk",className:"center",render:function(data, row){
                        return data.rmk;
                    }}

            ]
        });

    })
</script>
</html>

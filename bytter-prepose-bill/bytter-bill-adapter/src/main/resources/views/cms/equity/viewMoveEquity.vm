<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

</head>
<body>


<form class="layui-form" method="post">

    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.equityCode')</td>
            <td>
            $!{payTheVO.equityCode}
            </td>
            ##融资方式
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.financingWay')</td>
            <td style="width: 35%">
               $dictTag.get("cms.equity.financingWay",$!{payTheVO.financingWay})
            </td>
        </tr>
        <tr>
            ##出资人
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.investor')</td>
            <td style="width: 35%">
               $!{payTheVO.investor}
            </td>
            ##出资方式
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.invWay')</td>
            <td style="width: 35%">
                $dictTag.get("cms.equity.invWay",$!{payTheVO.invWay})
            </td>
        </tr>
        <tr>
            ##出资金额
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.invMoney')</td>
            <td>
                $number.formatNumeric($!{payTheVO.invMoney})
            </td>
            ##资产名称
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.assetName')</td>
            <td>
                $!{payTheVO.assName}
            </td>

        </tr>
        <tr>
            ##过户日期
            <td class="textRight">#springMessage('table.cmsEquity.moveDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!payTheVO.payDate)
            </td>
            ##备注
            <td class="textRight" style="width: 15%">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
            <td style="width: 35%">
                <input type="text" name="rmk" id="rmk" class="layui-input" value="$!{payTheVO.rmk}" >
            </td>
        </tr>
        </tbody>
    </table>


</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/cms/equity/equityMove.add.js?_btv=${resourceVersion}"></script>
</html>

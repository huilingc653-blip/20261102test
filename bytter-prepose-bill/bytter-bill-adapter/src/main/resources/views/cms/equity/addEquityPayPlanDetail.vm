<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

    <style>
        #collaTable .layui-input {
            width: 100%;
        }
        #collaTable2 .layui-input {
            width: 60%;
        }
        #collaTable2 td {
            border: none;
        }
        #collaTable2 .layui-input,.rateWrap,td
        {
            border: none;
        }

        #collaTable2 .inputMark {
            right: 15px !important;
            top: 2px !important;
        }

        #collaTable2 .accountedSum {
            padding-right: 0px !important;
        }
    </style>

</head>
<body>

<div class="layui-collapse">
<form class="layui-form" method="post">
    <input type="hidden" id="equityCode" name="equityCode" value="$!{infoDetail.equityCode}">
    <input type="hidden" id="financingWay" name="financingWay" value="$!{infoDetail.financingWay}">
    <input type="hidden" id="investor" name="investor" value="$!{infoDetail.investor}">
    <input type="hidden" id="invWay" name="invWay" value="$!{infoDetail.invWay}">
    <input type="hidden" id="invMoney" name="invMoney" value="$!{infoDetail.invMoney}">
    <input type="hidden" id="id" name="id" value="$!{payPlanVO.id}">
    <input type="hidden" id="infoDetailId" name="infoDetailId" value="$!{infoDetail.id}">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsEquity.detail')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody >
                    <tr>
                        ##融资编号
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.equityCode')</td>
                        <td style="width: 35%">
                            $!{infoDetail.equityCode}
                        </td>
                        ##融资方式
                        <td class="textRight">#springMessage('table.cmsEquity.financingWay')</td>
                        <td>
                            $dictTag.get("cms.equity.financingWay",$!{infoDetail.financingWay})
                        </td>
                    </tr>
                    <tr>
                        ##出资人
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.investor')</td>
                        <td style="width: 35%">
                            $!{infoDetail.investor}
                        </td>
                        ##出资方式
                        <td class="textRight">#springMessage('table.cmsEquity.invWay')</td>
                        <td>
                            $dictTag.get("cms.equity.invWay",$!{infoDetail.invWay})
                        </td>
                    </tr>
                    <tr>
                        ##出资金额
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.invMoney')</td>
                        <td style="width: 35%">
                            $!number.formatNumeric($!{infoDetail.invMoney})
                        </td>
                        ##持股比例
                        <td class="textRight">#springMessage('table.cmsEquity.equityProUn')</td>
                        <td>
                            $number.formatNumeric($math.mul($!{infoDetail.equityPro},100),"0.00")%
                        </td>
                    </tr>
                    <tr>
                        ##资产名称
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.assetName')</td>
                        <td style="width: 35%">
                            $!{infoDetail.assetName}
                        </td>
                        ##备注
                        <td class="textRight">#springMessage('table.cmsEquity.rmk')</td>
                        <td>
                            $!{infoDetail.rmk}
                        </td>
                    </tr>
                    </tbody>
                </table>
                </table>
            </div>
        </div>
    </div>

    ##计划明细
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('cms.equity.planDetail')</h2>
            <div class="layui-colla-content  layui-show" >
                <table class="layui-table self-adaption" id="planDetailTB" style="width:100%; margin-bottom:8px;margin-top: 8px;">
                    <thead>
                    <tr>
                        <th >#springMessage('table.cmsEquity.equityCode')</th>##融资编号
                        <th ><span class="pl"><span class="required-icon" style="top: 0">*</span></span>#springMessage('cms.equity.payDate')</th>##缴付日期/过户日期
                        <th >#springMessage('cms.equity.payMoney')</th>##本次缴付金额
                        <th >#springMessage('cms.equity.rePayMoney')</th>##剩余缴付金额
                        <th >#springMessage('cms.equity.accounted')</th>##本次占比
                        <th ><span class="pl"><span class="required-icon" style="top: 0">*</span></span>#springMessage('cms.equity.assName')</th>##资产名称
                        <th >#springMessage('cms.equity.isPay')</th>##是否已缴付/过户
                        <th >#springMessage('cms.equity.rmk')</th>##备注
                        <th >#springMessage('common.table.thead.operation')</th>##操作
                    </tr>
                    </thead>
                    <tbody id="collaTable">
                    </tbody>
                    <tfoot>
                    ##合计行
                    <tr id="collaTable2" >
                        <td align="center">#springMessage('table.interet.sum')</td>
                        <td></td>
                        <td align="right">##本次缴付金额合计
                            <input type="text" id="payMoneySum" data-name="payMoneySum" data-biz-name="payMoneySum" readonly="readonly" data-decimal="2"
                                   autocomplete="off" class="layui-input bt-biz-moneyType">
                        </td>
                        <td align="right">##剩余缴付金额合计
                        </td>
                        <td align="center">##本次占比%合计
                            <input type="text"  id="accountedSum" data-name="accountedSum"  data-biz-name="accountedSum" readonly="readonly"
                                   autocomplete="off"  class="layui-input bt-biz-rateType accountedSum"/>
                        </td>
                        <td >&nbsp;</td>
                        <td >&nbsp;</td>
                        <td >&nbsp;</td>
                        <td >&nbsp;</td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn layui-btn-small" lay-submit="" lay-filter="save">#springMessage('common.button.save')</button>
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
</div>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/cms/equity/CommonPayPlanFunction.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/equity/equityPayPlanDetail.add.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

</head>
<body>


<form class="layui-form" method="post">
    <input type="hidden" id="id" name="id" value="$!{cmsEquityInfo.id}">
    <input type="hidden" id="corpId1" value="$!{cmsEquityInfo.corpId}">
    <input type="hidden" id="curId1" value="$!{cmsEquityInfo.curId}">
    ##股权融资主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsEquity.mainMessage')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##股权融资类型
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.equityTypeCode')</td>
                        <td style="width: 35%">
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="equityTypeCode"
                                     data-url="${basePath}/cms/equity/type/listCmsEquityType" data-valuefield="typeCode"
                                     data-textfield="typeName" data-value="$!{cmsEquityInfo.equityTypeCode}"
                                     data-required="true" data-biz-name="equityTypeCode"></div>
                            </div>
                        </td>
                        ##境内境外
                        <td class="textRight">#springMessage('table.cmsEquity.isDomestic')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="btBankAcc.isDomesticBank" data-required="true"
                                 data-defaultvalue="1" data-name="isDomestic" data-biz-name="isDomestic" data-value="$!{cmsEquityInfo.isDomestic}"></div>
                        </td>
                    </tr>
                    <tr>
                        ##融资单位
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.corpId')</td>
                        <td style="width: 35%"  colspan="3">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-name="corpId"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="corpId"
                                     data-defaultvalue="$!{cmsEquityInfo.corpId}"
                                     data-resource="cms:equity:info:query"
                                     data-required="true"
                                     data-callback="BankAccTable"
                                     style="width: 350px"
                                ></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##币种
                        <td class="textRight">#springMessage('table.cmsEquity.curId')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="curId" id="curId" data-required="true"
                                     data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                                     data-textfield="curName"   data-value="$!{cmsEquityInfo.curId}"
                                      data-biz-name="curId"></div>
                            </div>
                        </td>
                        ##融资金额
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.money')</td>
                        <td>
                            <input class="layui-input bt-biz-moneyType" data-maxlength="20" data-name="money"
                                   lay-verify="strlength|required" data-biz-name="money"  value="$!{cmsEquityInfo.money}"
                                   data-decimal="2" data-minus="false" type="text"
                            >
                        </td>
                    </tr>

                    <tr>
                        ##验资账号
                        <td class="textRight">#springMessage('table.cmsEquity.account')</td>
                        <td>
                            <input type="text" name="account" id="account" class="layui-input account" value="$!{cmsEquityInfo.account}"
                                   data-biz-name="account" lay-verify="required" >
                        </td>
                        ##账户名称
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.accName')</td>
                        <td>
                            <input type="text" name="accName" id="accName" class="layui-input"  lay-verify="required" value="$!{cmsEquityInfo.accName}">
                        </td>
                    </tr>

                    <tr>
                        ##开户行名称
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.bankName')</td>
                        <td>
                            <input type="text" name="bankName" id="bankName" class="layui-input" lay-verify="required"  value="$!{cmsEquityInfo.bankName}">
                        </td>
                        ##融资日期
                        <td class="textRight">#springMessage('table.cmsEquity.financingDate')</td>
                        <td>
                            <input id="financingDate" name="financingDate"  value="$!date.format('yyyy-MM-dd',$!cmsEquityInfo.financingDate)"
                                   data-biz-name="financingDate"  data-type="date"
                                   class="layui-input bt-biz-dateType" ></input>
                        </td>
                    </tr>
                    <tr>
                        ##交割日期
                        <td class="textRight">#springMessage('table.cmsEquity.deliveryDate')</td>
                        <td>
                            <input id="deliveryDate" name="deliveryDate"  value="$!date.format('yyyy-MM-dd',$!cmsEquityInfo.deliveryDate)"
                                   data-biz-name="deliveryDate"  data-type="date"
                                   class="layui-input bt-biz-dateType" ></input>
                        </td>

                        ##融资用途
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.financingUse')</td>
                        <td>
                            <input type="text" name="financingUse" id="financingUse" class="layui-input"  value="$!{cmsEquityInfo.financingUse}">
                        </td>
                    </tr>
                        ##备注
                    <tr>
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                        <td colspan="3">
                        <textarea type="text" id="rmk" name="rmk" class="layui-textarea"
                                  placeholder="#springMessage('table.cmsProvideLoanInfo.rmk')">$!{cmsEquityInfo.rmk}</textarea>
                        </td>
                    </tr>
                    </tbody>
                </table>
                </table>
            </div>
        </div>
    </div>
    <input type="hidden" name="ids" id="ids" value="$!{ids}">
    ##股权融资明细信息

    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsEquity.detail')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <br>
                <table id="appTable" class="layui-table layui-form" style="width:100%;">
                    <thead>
                    <tr>
                        <th>#springMessage('table.cmsEquity.equityCode')</th>
                        <th>#springMessage('table.cmsEquity.financingWay')</th>
                        <th>#springMessage('table.cmsEquity.investor')</th>
                        <th>#springMessage('table.cmsEquity.invWay')</th>
                        <th>#springMessage('table.cmsEquity.invMoney')</th>
                        <th>#springMessage('table.cmsEquity.equityProUn')</th>
                        <th>#springMessage('table.cmsEquity.assetName')</th>
                        <th>#springMessage('table.cmsEquity.rmk')</th>
                        <th>#springMessage('common.table.thead.operation')</th>
                    </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

    ##第三方费用信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.chargeMessage')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <tr>
                        <td align="center" width="80">
                            ##新加的
                            <table id="dataTable" class="layui-table">
                                <thead>
                                <th width="25%">#springMessage('table.fcChargeRule.fcChargeType')</th>##费用类型
                                <th width="25%"> #springMessage('table.guaGuarantee.handleRate')</th>##费率
                                <th width="25%">#springMessage('table.cms.projected.expemditure')</th>##预计费用
                                <th width="25%">#springMessage('common.table.thead.operation')</th>##操作
                                </thead>
                                <tbody>
                                    #if($costVOS.size() > 0)
                                        #foreach($detail in $!{costVOS})
                                            #set($vcount = $velocityCount - 1)
                                            #set($velocityCount = $costVOS.size() - 1)

                                        <tr data-row="${vcount}">

                                            <td width="20%" align="center">
                                                <div class="layui-inline">##类型
                                                    <div class="bt-biz-selectType"
                                                         data-biz-name="costTypeDtl[${vcount}]costCode"
                                                         data-url="${basePath}/cms/dfCostType/getValidDfCostType"
                                                         id="costCode${vcount}"
                                                         data-valuefield="id" data-textfield="costName"
                                                         data-name="costTypeDtl[${vcount}].costTypeId"
                                                         data-search="true"
                                                         data-link="true" data-callback="setItemCode"
                                                         data-value="$!{detail.costTypeId}">
                                                    </div>
                                                </div>
                                            </td>

                                            <td width="15%" align="center">##费率
                                                <input type="text" id="rate${vcount}"
                                                       data-name="costTypeDtl[${vcount}].rate" value="$!{detail.rate}"
                                                       data-biz-name="costTypeDtl[${vcount}]rate"
                                                       data-callback="setInterestFee1"
                                                       class="layui-input bt-biz-rateType"/>
                                            </td>

                                            <td width="15%" align="center">##预计费用
                                                <input type="text" id="advanceFees${vcount}"
                                                       data-name="costTypeDtl[${vcount}].advanceFees"
                                                       value="$!{detail.advanceFees}"
                                                       data-biz-name="costTypeDtl[${vcount}]advanceFees"
                                                       data-callback="setInterestFee4"
                                                       class="layui-input bt-biz-moneyType"/>
                                            </td>


                                            <td width="10%" align="center">
                                                #if($vcount == 0)
                                                    <a href="javascript:void(0);" title="#springMessage('common.addTr')"
                                                       onClick="addTr()"><i class="layui-icon">&#xe654;</i></a>
                                                #else
                                                    <a href="javascript:void(0);" title="#springMessage("common.delTr")"
                                                       onClick="remoTr(this.parentElement.parentElement.rowIndex)"><i
                                                            class="layui-icon">&#xe640;</i></a>
                                                #end

                                            </td>

                                        </tr>
                                        #end
                                    #else
                                    <tr data-row="0">
                                        <td width="20%" align="center">
                                            <div class="layui-inline">
                                                <div class="bt-biz-selectType" data-biz-name="costTypeDtl[0]costCode"
                                                     id="costCode0"
                                                     data-url="${basePath}/cms/dfCostType/getValidDfCostType"
                                                     data-valuefield="id" data-textfield="costName" id="costCode0"
                                                     data-name="costTypeDtl[0].costTypeId" data-search="true"
                                                     data-link="true" data-callback="setItemCode">
                                                </div>
                                            </div>
                                        </td>

                                        <td width="15%" align="center">##费率
                                            <input type="text" id="rate0" data-name="costTypeDtl[0].rate"
                                                   data-biz-name="costTypeDtl[0]rate" data-callback="setInterestFee1"
                                                   autocomplete="off" class="layui-input bt-biz-rateType">
                                        </td>

                                        <td width="15%" align="center">##预计费用
                                            <input type="text" id="advanceFees0" data-name="costTypeDtl[0].advanceFees"
                                                   data-biz-name="costTypeDtl[0]advanceFees"
                                                   data-callback="setInterestFee4" autocomplete="off"
                                                   class="layui-input bt-biz-moneyType">
                                        </td>

                                        <td width="10%" align="center">
                                            <a href="#" title="#springMessage('common.addTr')" onClick="addTr()"><i
                                                    class="layui-icon">&#xe654;</i></a>
                                        </td>
                                    </tr>
                                    #end
                                </tbody>
                            </table>
                        </td>

                    </tr>

                </table>
            </div>
        </div>
    </div>
    ##其他业务挂接信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.cmsProvideLoan.otherBusMessage')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input id="annexName" name="uploadId" type="hidden" value="$!{cmsEquityInfo.uploadId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: center;" colspan="4">
                            <button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
                            <button class="layui-btn" lay-submit="" id="temp">#springMessage('common.button.temp')</button>
                            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/cms/equity/equityInfo.add.js?_btv=${resourceVersion}"></script>
</html>

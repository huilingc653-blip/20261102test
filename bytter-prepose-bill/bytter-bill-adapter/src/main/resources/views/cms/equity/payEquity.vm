<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

</head>
<body>


<form class="layui-form" method="post">
    <input type="hidden" id="corpId" name="corpId" value="$!{corpId}">
    <input type="hidden" id="curId" value="$!{curId}">
    <input type="hidden" id="planId" name="planId" value="$!{payTheVO.planId}">
    <input type="hidden" id="planDetailId" name="planDetailId" value="$!{payTheVO.planDetailId}">
    <input type="hidden" id="id" name="id" value="$!{payTheVO.id}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.equityCode')</td>
            <td>
                <input type="hidden" id="equityCode" name="equityCode" value="$!{payTheVO.equityCode}">
                <div>$!{payTheVO.equityCode}</div>
            </td>
            ##融资方式
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.financingWay')</td>
            <td style="width: 35%">
                <input type="hidden" id="financingWay" name="financingWay" value="$!{payTheVO.financingWay}">
                <div>$dictTag.get("cms.equity.financingWay",$!{payTheVO.financingWay})</div>
            </td>
        </tr>
        <tr>
            ##出资人
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.investor')</td>
            <td style="width: 35%">
                <input  name="investor" type="hidden" id="investor" value="$!{payTheVO.investor}">
                <div>$!{payTheVO.investor}</div>
            </td>
            ##出资方式
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.invWay')</td>
            <td style="width: 35%">
                <input  name="invWay" type="hidden" id="invWay" value="$!{payTheVO.invWay}">
                <div>$dictTag.get("cms.equity.invWay",$!{payTheVO.invWay})</div>
            </td>
        </tr>
        <tr>
            ##出资金额
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.invMoney')</td>
            <td>
                <input  name="invMoney" type="hidden" id="invMoney" value="$!{payTheVO.invMoney}">
                <div> $number.formatNumeric($!{payTheVO.invMoney})</div>
            </td>
            ##剩余缴付金额
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.rePayMoney')</td>
            <td>
                <input  name="rePayMoney" type="hidden" id="rePayMoney" value="$!{payTheVO.rePayMoney}">
                <div>$number.formatNumeric($!{payTheVO.rePayMoney})</div>
            </td>
        </tr>
            ##验资账号
        <tr>
            <td class="textRight">#springMessage('table.cmsEquity.account')</td>
            <td>
                <input lay-verify="required" name="account" type="text" id="account"  class="layui-input" value="$!{payTheVO.account}">
            </td>
            ##账户名称
            <td class="textRight">#springMessage('table.cmsEquity.accName')</td>
            <td >
                <input lay-verify="required" name="accName" type="text" id="accName"  class="layui-input" value="$!{payTheVO.accName}">
            </td>
        </tr>
            ##开户行行号
        <tr>
            <td class="textRight">#springMessage('table.btBankAccApp.bankCode')</td>
            <td>
                <input lay-verify="required" name="bankNo" type="text" id="bankNo"  class="layui-input" value="$!{payTheVO.bankNo}">
            </td>
            ##开户行名称
            <td class="textRight">#springMessage('table.cmsEquity.bankName')</td>
            <td >
                <input lay-verify="required" name="bankName" type="text" id="bankName"  class="layui-input" value="$!{payTheVO.bankName}">
            </td>
        </tr>
        <tr>
            ##缴付日期
            <td class="textRight">#springMessage('table.cmsEquity.payDate')</td>
            <td><div class="layui-inline">
                <input id="payDate" name="payDate" value="$!date.format('yyyy-MM-dd',$!payTheVO.payDate)"
                       data-biz-name="payDate"  data-type="date"  data-callback="changeCur" lay-verify="required"
                       class="layui-input bt-biz-dateType" >
            </div>
                <div class="layui-inline">
                    ##                   选择对应计划
                    <button class="layui-btn" type="button" onclick="equityPlans()">#springMessage('common.button.selectPlan')</button>
                </div>
            </td>
            ##缴付币种
            <td class="textRight">#springMessage('table.cmsEquity.payCurId')</td>
            <td >
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="payCurId" id="payCurId"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-required="true"
                         data-textfield="curName" data-value="$!{payTheVO.payCurId}" data-callback="changeCur"
                         data-biz-name="payCurId"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##本次缴付金额
            <td class="textRight">#springMessage('table.cmsEquity.payMoney')</td>
            <td>
                <input class="layui-input bt-biz-moneyType" data-maxlength="20" data-name="payMoney" lay-verify="required"
                       lay-verify="strlength" data-biz-name="payMoney"  value="$!{payTheVO.payMoney}"
                       data-decimal="2" data-minus="false" type="text" data-callback="changeCur"
                >
            </td>
            ##汇率
            <td class="textRight">#springMessage('table.cmsEquity.rate')</td>
            <td >
                <input  name="rate" type="hidden" id="rate" value="$!{payTheVO.rate}">
                <div id="rate1" >$!{payTheVO.rate}</div>
            </td>
        </tr>
        <tr>
            ##折合本位币金额
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.rmbMoney')</td>
            <td style="width: 35%">
                <input  name="rmbMoney" type="hidden" id="rmbMoney" value="$!{payTheVO.rmbMoney}">
                <div id="rmbMoney1" >
                    #if($!{payTheVO.rmbMoney})
                    $number.formatNumeric($!{payTheVO.rmbMoney})
                    #end
                </div>
            </td>
            ##本次应缴付金额
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.needPayMoney')</td>
            <td style="width: 35%">
                <input  name="needPayMoney" type="hidden" id="needPayMoney" value="$!{payTheVO.needPayMoney}">
                <div id="needPayMoney1" >
                    #if($!{payTheVO.needPayMoney})
                     $number.formatNumeric($!{payTheVO.needPayMoney})
                    #end
                </div>
            </td>
        </tr>
        <tr>
            ##汇总损益
            <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.profitAndLoss')</td>
            <td style="width: 35%">
                <input  name="profitAndLoss" type="hidden" id="profitAndLoss" value="$!{payTheVO.profitAndLoss}">
                <div id="profitAndLoss1" >
                    #if($!{payTheVO.profitAndLoss})
                     $number.formatNumeric($!{payTheVO.profitAndLoss})
                    #end
                </div>
            </td>
            ##备注
            <td class="textRight" style="width: 15%">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
            <td style="width: 35%">
                <input type="text" name="rmk" id="rmk" class="layui-input" value="$!{payTheVO.rmk}" >
            </td>
        </tr>
        <tr>
            <td style="text-align: center;" colspan="4">
                <button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" id="temp">#springMessage('common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>

        </tbody>
    </table>


</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/cms/equity/equityPay.add.js?_btv=${resourceVersion}"></script>
</html>

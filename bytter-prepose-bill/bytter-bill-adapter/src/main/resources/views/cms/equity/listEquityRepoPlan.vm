<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<div class="layui-collapse">
<form id="searchForm" class="layui-form input150-container">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ## 股权融资类型
                        <td class="textRight" width="8%">#springMessage('table.cmsEquity.equityTypeCode')</td>
                        <td width="25%">
                            <div class="bt-biz-selectType" data-name="eqs_equityTypeCode"
                                 data-url="${basePath}/cms/equity/type/listCmsEquityType" data-valuefield="typeCode"
                                 data-textfield="typeName"
                                 data-biz-name="eqs_equityTypeCode"></div>
                        </td>
                        ## 融资单位
                        <td class="textRight" width="8%">#springMessage('table.cmsEquity.corpId')</td>
                        <td width="25%">
                            <div class="layui-inline">
                                <div class="bt-biz-corp"
                                     data-biz-name="corpId"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_corpId"
                                     data-resource="cms:equity:repoPlan:query"
                                     data-scope="all"
                                />
                            </div>
                        </td>
                        ## 融资用途
                        <td class="textRight" width="8%">#springMessage('table.cmsEquity.financingUse')</td>
                        <td width="25%">
                            <div class="layui-inline">
                                <input type="text"  name="likes_financingUse" autocomplete="off"
                                       class="layui-input"/>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##融资日期
                        <td class="textRight">#springMessage('table.cmsEquity.financingDate')</td>
                        <td width="25%">
                            <input type="text" name="ged_financingDate" data-biz-name="ged_financingDate" data-type="date"
                                   class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_financingDate" >
                            <span class="date-mid">~</span>
                            <input type="text" name="led_financingDate" data-biz-name="led_financingDate" data-type="date"
                                   class="layui-input bt-input-inline bt-biz-dateType" id="led_financingDate" >
                        </td>
                        ##币种
                        <td class="textRight">#springMessage('table.cmsEquity.curId')</td>
                        <td width="25%">
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="eqs_curId" data-biz-name="eqs_curId" data-inputValue="false"
                                     data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                                     data-textfield="curName"></div>
                            </div>
                        </td>
                        ##融资金额
                        <td class="textRight">#springMessage('table.cmsEquity.money')</td>
                        <td width="25%">
                            <div class="layui-inline">
                                <input type="text" name="geg_money"
                                       autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                                       style="text-align:right" data-moneyendid="t20"
                                       placeholder="#springMessage('table.cmsEquity.money')">
                                <span class="date-mid">~</span>
                                <input type="text" name="leg_money"
                                       autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                                       style="text-align:right" id="t20" placeholder="#springMessage('table.cmsEquity.money')">
                            </div>
                        </td>
                    </tr>
##                        #if($shiro.hasPermission("cms:equity:repoPlan:query"))
                        <tr>
                            <td colspan="6" style="text-align: center;">
                                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                            </td>
                        </tr>
##                        #end
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsEquity.equityTypeCode')</th>
        <th>#springMessage('table.cmsEquity.corpId')</th>
        <th>#springMessage('table.cmsEquity.financingDate')</th>
        <th>#springMessage('table.cmsEquity.financingUse')</th>
        <th>#springMessage('table.cmsEquity.curId')</th>
        <th>#springMessage('table.cmsEquity.money')</th>
        <th>#springMessage('table.cmsEquity.rmk')</th>
        <th>#springMessage('table.fcFreeze.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/blackWhite/blackWhiteBase.check.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/equity/equityRepoPlan.list.js?_btv=${resourceVersion}"></script>

</html>

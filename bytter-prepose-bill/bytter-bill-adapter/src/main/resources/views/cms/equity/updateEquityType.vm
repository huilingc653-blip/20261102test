<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="myform">
        <input  id="id" type="hidden" name="id" value="$!{cmsEquityType.id}">
        <input  id="id" type="hidden" name="status" value="$!{cmsEquityType.status}">
        <input  id="id" type="hidden" name="createDate" value="$date.format('yyyy-MM-dd',$!{cmsEquityType.createDate})">
        <input  id="id" type="hidden" name="createBy" value="$!{cmsEquityType.createBy}">
    <table id="appTable" class="layui-table layui-form">
        <tr>
        ##类别编码
            <td class="textRight" style="width: 50%">#springMessage('table.cmsLease.typeCode')</td>
            <td style="width: 50%">
                <div class="layui-input-inline">
                    <input type="text" id="typeCode" name="typeCode" lay-verify="required" maxlength="4" onblur="checkNO(this)" class="layui-input" value="$!{cmsEquityType.typeCode}">
                </div>
            </td>
        </tr>
        <tr>
        ##类别名称
            <td class="textRight">#springMessage('table.cmsLease.typeName')</td>
            <td>
                <input type="text" name="typeName" lay-verify="required" class="layui-input" value="$!{cmsEquityType.typeName}">
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.cmsLoanRepay.rmk')</td>
            <td>
                <input type="text" name="rmk" class="layui-input" value="$!{cmsEquityType.rmk}">
            </td>
        </tr>
        <tr>
            <td colspan="2"style="text-align: center">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    var dicts,form;
    bt.use(["jquery","dicts"], function () {
        $ = bt.jquery;
        form = bt.form();
        dicts = bt.dicts.init();

        //监听提交
        form.on("submit(submit)", function(data){
            console.log(data.field);
            var action = "/cms/equity/type/modify";
            bt.loading.show();
            $.post(basePath + action,data.field,function(data){
                parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                if (data.success) {
                    if (!bt.navtab) {
                        bt.navtab.refreshParentTable();
                    } else {
                        bt.navtab.closeCurrent();
                        bt.navtab.refreshCurrent();
                    }
                } else {
                    bt.loading.hide();
                }
            },'JSON');
            return false;
        });
    });
    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }

    /**
     * 检查不允许输入汉字及特殊字符
     * @param obj
     */
    function checkNO(obj) {
        var regx =/[\u4e00-\u9fa5]/,//汉字
                regEn = /[`~!@#$%^&*()_+<>?:"{},.\/;'[\]]/im,//英文特殊字符
                regCn = /[·！#￥（——）：；“”‘、，|《。》？、【】[\]]/im;//中文特殊字符
        if (regx.test(obj.value)||regEn.test(obj.value)||regCn.test(obj.value)) {
            obj.value = "";
        }
    }
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
            <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
            ## 股权融资类型
            <td class="textRight" width="8%">#springMessage('table.cmsEquity.equityTypeCode')</td>
            <td width="25%">
                <div class="bt-biz-selectType" data-name="eqs_equityTypeCode"
                     data-url="${basePath}/cms/equity/type/listCmsEquityType" data-valuefield="typeCode"
                     data-textfield="typeName"
                     data-biz-name="eqs_equityTypeCode"></div>
            </td>
            ## 融资单位
            <td class="textRight" width="8%">#springMessage('table.cmsEquity.corpId')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="corpId"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="cms:equity:payPlan:query"
                         data-scope="all"
                    />
                </div>
            </td>
            ## 融资用途
            <td class="textRight" width="8%">#springMessage('table.cmsEquity.financingUse')</td>
            <td width="25%">
                <div class="layui-inline">
                    <input type="text"  name="likes_financingUse" autocomplete="off"
                           class="layui-input"/>
                </div>
            </td>
        </tr>
        <tr>
            ##融资日期
            <td class="textRight">#springMessage('table.cmsEquity.financingDate')</td>
            <td width="25%">
                <input type="text" name="ged_financingDate" data-biz-name="ged_financingDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_financingDate" >
                <span class="date-mid">~</span>
                <input type="text" name="led_financingDate" data-biz-name="led_financingDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" id="led_financingDate" >
            </td>
            ##币种
            <td class="textRight">#springMessage('table.cmsEquity.curId')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_curId" data-biz-name="eqs_curId" data-inputValue="false"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                         data-textfield="curName"></div>
                </div>
            </td>
            ##融资金额
            <td class="textRight">#springMessage('table.cmsEquity.money')</td>
            <td width="25%">
                <div class="layui-inline">
                    <input type="text" name="geg_money"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20"
                           placeholder="#springMessage('table.cmsEquity.money')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_money"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" id="t20" placeholder="#springMessage('table.cmsEquity.money')">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsEquity.equityTypeCode')</th>
        <th>#springMessage('table.cmsEquity.corpId')</th>
        <th>#springMessage('table.cmsEquity.financingDate')</th>
        <th>#springMessage('table.cmsEquity.curId')</th>
        <th>#springMessage('table.cmsEquity.money')</th>
        <th>#springMessage('table.cmsEquity.rmk')</th>
        <th>#springMessage('table.fcFreeze.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
</body>
<script>
    bt.use(["jquery", "datatable", "form", "moneyType", "selectType", "dicts", "corp","dateType"], function () {
        $ = bt.jquery;
        form = bt.form()
        dicts = bt.dicts.init();
        selectType = bt.selectType.init();
        bt.dateType.init();//日期时间
        bt.moneyType.init();
        corp = bt.corp.init();//单位

        /**
         * 生成列表
         */
        datatable = bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            checkbox: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search",
                isInitData:"false"
            },
            ajax: {
                'url': basePath + "/cms/equity/info/datatableApprove"
            },
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            fixedColumns: {
                rightColumns: 2//代表冻结右边一列
            },
            columns: [
                {data:"equityTypeName", bSortable: false},
                {data:"corpName",bSortable:true},
                {data:"financingDate",bSortable:true},
                {data:"curName",bSortable:false},
                {data:"money",className:"textRight",render: function ( data, type, full, meta ){
                        return bt.money.format(full.money);
                    }},
                {data:"rmk",bSortable:false},
                {
                    data: "status", bSortable: false, className: 'center',
                    render: function (data, type, full, meta) {
                        return bt.dict("nisExpenseDetail.status", full.status);
                    }
                },
                {data:null,bSortable:false,className:'center',
                    render: function (data, type, full, meta) {
                        var html='';
                        if($("#flowStatus").val()=='todo'){
                            html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
                        }
                        if($("#flowStatus").val() == 'pass'){
                            html += '<a class="" href="#" data-row="'+meta.row+'" onclick="view(this)">'+bt.lang("common.button.view")+'</a><span class="text-explode">|</span>';
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }else {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }
                        return html;
                    }
                },
            ]
        });
    });

    function view(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'),basePath + "/cms/equity/info/view/" + data.id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/equity/info/view/" + data.id
        });
    }
    /*审核*/
    function approve(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.approve') ,basePath + "/cms/equity/info/infoApprove?id="+data.id + "&taskId=" + data.taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/cms/equity/info/infoApprove?id="+data.id + "&taskId=" + data.taskId
        });
    }

</script>

</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

</head>
<body>


<form class="layui-form" method="post">
    <input type="hidden" id="update" name="update" value="0">

                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.equityCode')</td>
                        <td>
                            <input type="hidden" id="equityCode" name="equityCode" value="$!{equityCode}">
                            $!{equityCode}
                        </td>
                        ##融资方式
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.financingWay')</td>
                        <td style="width: 35%">
                            <div class="bt-biz-dict" data-name="financingWay" data-type="select" data-biz-name="financingWay"
                                 data-group="cms.equity.financingWay"  data-required="true"
                                 data-defaultvalue=""></div>
                        </td>
                    </tr>
                    <tr>
                        ##出资人
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.investor')</td>
                        <td style="width: 35%">
                            <input lay-verify="required" name="investor" type="text" id="investor"  class="layui-input">
                        </td>
                        ##出资方式
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.invWay')</td>
                        <td style="width: 35%">
                            <div class="bt-biz-dict" data-name="invWay" data-type="select" data-biz-name="invWay"
                                 data-group="cms.equity.invWay"  data-required="true" data-callback="changeInvWay"
                                 data-defaultvalue=""></div>
                        </td>
                    </tr>
                    <tr>
                        ##出资金额
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.invMoney')</td>
                        <td>
                            <input class="layui-input bt-biz-moneyType" data-maxlength="20" data-name="invMoney"
                                   lay-verify="required|strlength" data-biz-name="invMoney"
                                   data-decimal="2" data-minus="false" type="text"
                            >
                        </td>
                        ##持股比例
                        <td class="textRight" style="width: 15%">#springMessage('table.cmsEquity.equityPro')</td>
                        <td>
                            <input type="text" data-name="equityPro" class="layui-input bt-biz-rateType"  >
                        </td>
                    </tr>
                    ##资产名称
                    <tr>
                        <td class="textRight">#springMessage('table.cmsEquity.assetName')</td>
                        <td colspan="3">
                             <textarea type="text" id="assetName" name="assetName" class="layui-textarea" lay-verify="required"
                                       placeholder="#springMessage('资产名称')"></textarea>
                        </td>
                    </tr>
                        ##备注
                    <tr>
                        <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                        <td colspan="3">
                        <textarea type="text" id="rmk" name="rmk" class="layui-textarea"
                                  placeholder="#springMessage('table.cmsProvideLoanInfo.rmk')"></textarea>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: center;" colspan="4">
                            <button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
                            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                        </td>
                    </tr>

                    </tbody>
                </table>


</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/cms/equity/equityInfoDetail.add.js?_btv=${resourceVersion}"></script>
</html>

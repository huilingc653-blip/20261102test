<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div>
    <input type="hidden" id="billMoney" value="$!{abReceiveBillPage.billMoney}"></input>
    <h2 class="layui-colla-title">#springMessage('bill.accebill.billInfo.title')</h2>
    <table class="layui-table">
        <tbody>
        <tr>
            ##票据号码
            <td class="textRight" colspan="2">#springMessage('table.abVoucherinfo.origNo')</td>
            <td>
                $!{abReceiveBillPage.origNo}
            </td>
            ##不得转让标记/能否转让
            <td class="textRight" colspan="2">#springMessage('table.abVoucherinfo.banendrsmtmk')</td>
            <td>
                #if($!{abReceiveBillPage.banendrsmtmkName})
                    $!{abReceiveBillPage.banendrsmtmkName}
                #else
                    $!{abReceiveBillPage.bankendrsmtmkName}
                #end
            </td>
        </tr>
        <tr>
            ##子票区间开始序号
            <td class="textRight" colspan="2">#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</td>
            <td>$!{abReceiveBillPage.sbbllRngStrtSn}</td>

            ##子票区间结束序号
            <td class="textRight" colspan="2">#springMessage('table.abVoucherinfo.sbbllRngEndSn')</td>
            <td>$!{abReceiveBillPage.sbbllRngEndSn}</td>
        </tr>
        <tr>
            ##票据金额
            <td class="textRight" colspan="2">#springMessage('table.abVoucherinfo.billMoney')</td>
            <td>
                $number.formatNumeric($!{abReceiveBillPage.billMoney})
            </td>
            ##人民币大写
            <td class="textRight" colspan="2">#springMessage('table.abVoucherinfo.billMoneyUp')</td>
            <td>
                <div id="moneyUp"></div>
            </td>
        </tr>
        <tr>
            ##出票日期
            <td class="textRight" colspan="2">#springMessage('table.abVoucherinfo.startDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{abReceiveBillPage.startDate})
            </td>
            ##到期日期
            <td class="textRight" colspan="2">#springMessage('table.abVoucherinfo.endDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{abReceiveBillPage.endDate})
            </td>
        </tr>
        <tr>
            ##票据类型
            <td class="textRight" colspan="2">#springMessage('table.abVoucherinfo.billType')</td>
            <td>
                $!{abReceiveBillPage.billTypeName}
            </td>
            ##流通介质
            <td class="textRight" colspan="2">#springMessage('table.abVoucherinfo.billFlag')</td>
            <td width="35%">
                $!{abReceiveBillPage.billFlagName}
            </td>
        </tr>
        </tbody>
    </table>

    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="origNo" value="$!{abReceiveBillPage.origNo}">
    <input type="hidden" name="sbbllRngStrtSn" value="$!{abReceiveBillPage.sbbllRngStrtSn}">
    <input type="hidden" name="sbbllRngEndSn" value="$!{abReceiveBillPage.sbbllRngEndSn}">
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('bill.accebill.endorseDate')</th>
        <th>#springMessage('bill.accebill.endorsorName')</th>
        <th>#springMessage('bill.accebill.endorseeName')</th>
        <th>#springMessage('table.abAccrecords.banendrsmtmk')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/bill/accebill/endorsementCountDtl.list.js?_btv=${resourceVersion}"></script>

<script type="text/javascript">
    bt.use(['moneyType'], function () {
        var billMoney = $("#billMoney").val();
        $("#moneyUp").text(bt.moneyType.getFun().toChinese(billMoney));

    });
</script>
</html>
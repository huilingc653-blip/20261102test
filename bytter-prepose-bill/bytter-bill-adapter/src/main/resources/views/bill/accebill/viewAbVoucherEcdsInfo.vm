        for(i = 0; i < trs.length; i++){
            trs[i].style.display = "none";
        }
		//LODOP.SET_PRINT_PAGESIZE(2);
		LODOP.SET_PRINT_MODE("PRINT_PAGE_PERCENT","Full-Width");
		LODOP.ADD_PRINT_HTML(0,0,"100%","100%",getBillInfoPrintHtml());
		//LODOP.ADD_PRINT_HTM(40,0,"100%","100%",getBillInfoPrintHtml());
		document.getElementById('pageDiv').style.display = 'none';
		document.getElementById('front').style.display = 'none';
		document.getElementById('back').style.display = 'none';
		document.getElementById(printId).style.display = '';
		document.getElementById('buttonDiv').style.display = '';
		var trs = $("#back tr[isNull='1']");
        for(i = 0; i < trs.length; i++){
            trs[i].style.display = "";
        }
		printView(LODOP);
    }

	function printView(LODOP){
		if (LODOP.CVERSION){
			CLODOP.On_Return=function(TaskID,Value){
				if(Value>0){
				}
                bt.loading.hide();
			};
            LODOP.SET_PREVIEW_WINDOW(1,0,0,900,600,"");
        	bt.loading.show();
            LODOP.PREVIEW();
		}else{
            LODOP.SET_PREVIEW_WINDOW(1,0,0,900,600,"");
        	bt.loading.show();
			var Value=LODOP.PREVIEW();
            bt.loading.hide();
			if(Value>0){
			}
		}
	}
	</script>

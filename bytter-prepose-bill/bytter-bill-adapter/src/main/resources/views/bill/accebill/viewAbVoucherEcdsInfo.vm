	<script type="text/javascript">
	var printId='front';
	function getBillInfoPrintHtml(){
		printHtml=document.documentElement.innerHTML;
		printHtml=printHtml.substring(0,printHtml.indexOf("<object id='LODOP_OB'"))+"</body></html>";
		$("#asdf").text(printHtml);
		return printHtml;
	}
	function doubleToString(){
		var v_money = '$number.formatNumeric($!{info.billMoney})';
		v_money=deleDot(v_money);
		if(v_money.indexOf('.') == -1){
			v_money += '.00';
		}else{
			while(v_money.length - v_money.indexOf('.') < 3){
				v_money += '0';
			}
		}
		v_money = v_money.replace('.','');
		for(i=1;i<=v_money.length;i++){
			var v_temp = v_money.substr(i-1,1);
			document.getElementById("b"+(12-v_money.length+i)).innerText = v_temp;
		}
		document.getElementById("b"+(12-v_money.length)).innerText = '￥';
	}
	function deleDot(str){
	     var newStr = "";
	     for(var i=0; i <str.length; i++){
	         if(str.charAt(i) != ","){
	           	newStr += str.charAt(i);
	         }
	     }
	     return newStr;
	}
	function showinfo( v ) {
    	if(v == 'front') {
    		document.getElementById('front').style.display = '';
    		document.getElementById('back').style.display = 'none';
    		document.getElementById('printNoNullBack').style.display = 'none';
			document.getElementById('additional').style.display = 'none';
    	} else if(v == 'back') {
    		document.getElementById('front').style.display = 'none';
    		document.getElementById('back').style.display = '';
    		document.getElementById('printNoNullBack').style.display = '';
			document.getElementById('additional').style.display = 'none';
    	}else if(v == 'additional') {
			document.getElementById('front').style.display = 'none';
			document.getElementById('back').style.display = 'none';
			document.getElementById('printNoNullBack').style.display = 'none';
			document.getElementById('additional').style.display = '';
		}
		printId=v;
    }

    //正反面查询信息查询
	function bankSyncro(){

		var isFront ='03';
		if( document.getElementById('front').style.display=='none') {
			isFront='02';
		}
		$.ajax({
			url:basePath+'/bill/accebill/abbillreceivebiz/fastCredit?recId=$!{recId}&billCode=$!{info.origNo}&acId=$!{acId}&acctId=$!{reqAccId}&msgType='+isFront,
			dataType: 'json',
			type: "post",
			success:function(result){
				if(result.success==true){
					parent.layer.alert(bt.lang(result.attributes.MSG_INFO), {icon: 6});
				}else{
					parent.layer.alert(bt.lang(result.attributes.MSG_INFO), {icon: 2});
				}
		}});
	}



	function printNoNullBack() {
        bt.loading.show();
		var LODOP=getLodop();
		//document.getElementById('dateDiv'+printId).style.display = 'none';
		document.getElementById('buttonDiv').style.display = 'none';
		var trs = $("#back tr[isNull='1']");
        for(i = 0; i < trs.length; i++){
            trs[i].style.display = "none";
        }
		LODOP.SET_PRINT_MODE("PRINT_PAGE_PERCENT","Full-Width");
		LODOP.ADD_PRINT_HTML(0,0,"100%","100%",getBillInfoPrintHtml());
		//document.getElementById('dateDiv'+printId).style.display = '';
		document.getElementById('buttonDiv').style.display = '';
		for(i = 0; i < trs.length; i++){
            trs[i].style.display = "";
        }
		printView(LODOP);
    }

	function print() {
        bt.loading.show();
		var LODOP=getLodop();
		//document.getElementById('dateDiv'+printId).style.display = 'none';
		document.getElementById('buttonDiv').style.display = 'none';
		LODOP.SET_PRINT_MODE("PRINT_PAGE_PERCENT","Full-Width");
		LODOP.ADD_PRINT_HTML(0,0,"100%","100%",getBillInfoPrintHtml());
		//document.getElementById('dateDiv'+printId).style.display = '';
		document.getElementById('buttonDiv').style.display = '';
		printView(LODOP);
    }
	function printFrontBack() {
        bt.loading.show();
		var LODOP=getLodop();
		//document.getElementById('dateDivfront').style.display = 'none';
		//document.getElementById('dateDivback').style.display = 'none';
		document.getElementById('buttonDiv').style.display = 'none';
		document.getElementById('pageDiv').style.display = '';
		document.getElementById('front').style.display = '';
		document.getElementById('back').style.display = '';
		LODOP.SET_PRINT_MODE("PRINT_PAGE_PERCENT","Full-Width");
		LODOP.ADD_PRINT_HTML(0,0,"100%","100%",getBillInfoPrintHtml());

		document.getElementById('pageDiv').style.display = 'none';
		//document.getElementById('dateDivfront').style.display = '';
		//document.getElementById('dateDivback').style.display = '';
		document.getElementById('front').style.display = 'none';
		document.getElementById('back').style.display = 'none';
		document.getElementById(printId).style.display = '';
		document.getElementById('buttonDiv').style.display = '';
		printView(LODOP);
    }



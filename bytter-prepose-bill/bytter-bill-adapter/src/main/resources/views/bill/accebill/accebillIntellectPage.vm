                                     data-search="true" ></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##跨单位选票
                     #*   <td class="textRight" >#springMessage('bill.intellect.crossCropSelect')</td>
                        <td >
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0"
                                 data-name="crossCropSelect" data-biz-name="crossCropSelect" data-callback="crossCropSelectCallBack" id="crossCropSelect"></div>
                        </td>*#
                        ##单位名称
                        <td class="textRight" >#springMessage('table.abVoucherinfoVice.corpId')</td>

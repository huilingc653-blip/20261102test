<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="corpId" name="corpId" value="$!{infoParams.corpId}" />
    <input type="hidden" id="endDate" name="beginDate" value="$!date.format('yyyy-MM-dd',$!{infoParams.beginDate})" />
    <input type="hidden" id="endDate" name="endDate" value="$!date.format('yyyy-MM-dd',$!{infoParams.endDate})" />
    <input type="hidden" id="busType" name="busType" value="$!{infoParams.busType}" />
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                    ##票据金额
                        <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                        <td>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text" data-name="geg_billMoney"
                                   data-moneyendid="leg_billMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')" />
                            <span class="date-mid">~</span>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_billMoney" type="text"
                                   data-name="leg_billMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')" />
                        </td>
                    ##票据号码
                        <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                        <td width="20%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_origNo"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
                            </div>
                        </td>
                    ##票据类型
                        <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                        <td width="20%">
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="select" data-name="ini_billType"  data-group="AB_BILL_TYPE">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                    ##申请日期
                        <td class="textRight">#springMessage('bill.accebill.applyDate')</td>
                        <td >
                            <div class="layui-inline">
                                <div id="applyDate" ></div>
                            </div>
                        </td>
                    ##业务来源
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.billSource')</td>
                        <td width="25%">
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="select" data-name="ins_sourceName"  data-group="AB_BILL_SOURCE_QUERY">
                                </div>
                            </div>
                        </td>
                    ##流通介质
                        <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
                        <td width="20%">
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="select" data-name="ini_billFlag"  data-group="AB_BILL_FLAG">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <input type="hidden" id="ged_businessDate" value="">
                        <input type="hidden" id="led_businessDate" value="$!{infoParams.endDate}">
                    ##业务归属日期
                        <td class="textRight">#springMessage('table.abAccrecords.businessDate')</td>
                        <td >
                            <div class="layui-inline">
                                <div id="businessDate" ></div>
                            </div>
                        </td>
                    ##在线离线标志
                        <td class="textRight">#springMessage('bill.accebill.billSendSign')</td>
                        <td >
                            <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_SEND_SIGN" data-name="eqs_sendSign" ></div>
                        </td>
                    ##申请人
                        <td class="textRight">#springMessage('bill.accebill.applyName')</td>
                        <td width="20%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_applyName"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.applyName')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                    ##到期日期
                        <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                        <td >
                            <div class="layui-inline">
                                <input type="text" name="ged_endDate" data-name="ged_endDate" class="layui-input bt-biz-dateType" data-endid="queryEndDate" data-type="date"/>
                            </div>

                            <div class="layui-inline">
                                <input type="text" name="led_endDate"　data-name="led_endDate" class="layui-input bt-biz-dateType" id="queryEndDate" data-type="date"/>
                            </div>
                        </td>
                    ##所属账户
                        <td class="textRight">#springMessage('bill.accebill.theBankAcc')</td>
                        <td width="20%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_bankAcc"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.theBankAcc')">
                            </div>
                        </td>
                    ##收票人
                        <td class="textRight">
                            #springMessage('table.abVoucherinfo.payee')
                        </td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" id="payee" name="likes_payee" autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payee')" lay-verify=""  data-maxlength="50">
                                <div class="bt-div-search">
                                    <button  class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button" data-callback="bt.bailPayeeCallback" opType="payeeExternalClick" title="#springMessage('common.button.select')">
                                        <i class="layui-icon">&#xe615;</i>
                                    </button>
                                </div>
                            </div>
                        </td>

                    </tr>
                    <tr>
                    ##出票日期
                        <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" name="ged_startDate" data-name="ged_startDate" class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date"/>
                            </div>
                            ~
                            <div class="layui-inline">
                                <input type="text" name="led_startDate"　data-name="led_startDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date"/>
                            </div>
                        </td>
                    ##所属账户银行类别
                        <td class="textRight">#springMessage('bill.accebill.bankType')</td>
                        <td >
                            <div class="layui-input-inline">
                                <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json" data-method="get"
                                     data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId" data-inputvalue="inputvalue" data-search="true"></div>
                            </div>
                        </td>
                    ##前手
                        <td class="textRight">#springMessage('bill.accebill.cnAccrecords')</td>
                        <td >
                            <div class="layui-input-inline">
                                <input type="text" id="cnAccrecords" name="likes_cnAccrecords" autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.cnAccrecords')" lay-verify="" data-maxlength="50">
                                <div class="bt-div-search">
                                    <button  class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button" data-callback="bt.bailCnAccrecordsCallback" opType="cnAccrecordsExternalClick" title="#springMessage('common.button.select')">
                                        <i class="layui-icon">&#xe615;</i>
                                    </button>
                                </div>
                            </div>
                        </td>

                    </tr>
                    <tr>
                    ##业务状态
                        <td class="textRight">#springMessage('bill.accebill.busStatus')</td>
                        <td>
                            <div class="bt-biz-dict" data-group="AB_BILL_BUSSTATUS" data-name="eqs_busStatusName" data-type="select"></div>
                        </td>

                    ##指令状态
                        <td class="textRight">#springMessage('bill.accebill.InstructionStatus')</td>
                        <td>
                            <div class="bt-biz-dict" data-group="AB_BILL_INSOPTSTATUS" data-name="eqs_instructStatusName" data-type="select"></div>
                        </td>
                    ##票据状态
                        <td class="textRight">#springMessage('table.abVoucherinfo.billFlag_11')#springMessage('common.table.status')</td>
                        <td><div class="bt-biz-dict" data-group="AB_BILL_STATUS" data-name="eqs_billStatusName" data-type="select"></div></td>
                        <td class="textRight"></td>
                        <td></td>
                    </tr>
                    <tr>
                    ##票据池
                        <td class="textRight">#springMessage('billPool.bail.bp')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-billPool"
                                     data-tree-type="check"
                                     data-biz-type="billPool"
                                     data-biz-name="ins_bpId"
                                     data-type="selectTree"
                                     data-name="ins_bpId"
                                     data-placeholder="">
                                </div>
                            </div>
                        </td>
                    ##票据池状态
                        <td class="textRight">#springMessage('billPool.sign.status')</td>
                        <td><div class="bt-biz-dict" data-group="AB_BILL_COUNT_POOL_STATUS" data-defaultvalue="$!{infoParams.countIsPool}" data-name="eqs_countPoolStatus" data-type="select"></div></td>
                        ##出票标志
                        <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##票据是否允许分包
                        <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND" data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="6" style="text-align: center;">
                            <div class="layui-inline">
                                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('bill.accebill.corpId')</th>
        <th>#springMessage('bill.accebill.theBankAcc')</th>
        <th>#springMessage('bill.accebill.bankType')</th>
        <th>#springMessage('bill.accebill.origNo')</th>

        <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
        <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
        <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>

        <th>#springMessage('bill.accebill.bustype')</th>
        <th>#springMessage('table.abVoucherinfoVice.billSource')</th>
        <th>#springMessage('table.abVoucherinfo.billFlag')</th>
        <th>#springMessage('table.abVoucherinfo.billType')</th>
        <th>#springMessage('bill.accebill.billMoney')</th>
        <th>#springMessage('billPool.bail.bp')</th>
        <th>#springMessage('billPool.sign.status')</th>
        <th>#springMessage('bill.accebill.applyName')</th>
        <th>#springMessage('bill.accebill.applyDate')</th>
		<th>#springMessage('table.abAccrecords.businessDate')</th>
        <th>#springMessage('table.abVoucherinfo.startDate')</th>
        <th>#springMessage('table.abVoucherinfo.endDate')</th>
        <th>#springMessage('table.abDiscount.interestRates')</th>
        <th>#springMessage('table.abDiscount.interest')</th>
        <th>#springMessage('table.abVoucherinfo.payer')</th>
        <th>#springMessage('table.abVoucherinfo.payee')</th>
        <th>#springMessage('table.abVoucherinfo.acceptor')</th>
        <th>#springMessage('bill.accebill.cnAccrecords')</th>
        <th>#springMessage('bill.accebill.rearAccrecords')</th>
		<th>#springMessage('bill.accebill.billSendSign')</th>
        <th>#springMessage('bill.accebill.busStatus')</th>
        <th>#springMessage('table.abVoucherinfo.billFlag_11')#springMessage('common.table.status')</th>
        <th>#springMessage('bill.accebill.inoptStatus')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/billUnitLstatisticsDtl.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>

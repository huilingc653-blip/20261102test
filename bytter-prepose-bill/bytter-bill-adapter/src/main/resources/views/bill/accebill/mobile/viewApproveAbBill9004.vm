#* 
根据应付/应收显示对应的信息
*#
#if($!type eq '1')
	<li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.receivebackinfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('table.abVoucherinfo.Business.Brief.Id')
                <span class="mui-badge mui-badge-inverted">
                    $!{info.briefIdName}
    		    </span>
            </li>
            <li class="mui-table-view-cell">
				#springMessage('table.abAccrecords.applyDate')
                <span class="mui-badge mui-badge-inverted">
					$!date.format('yyyy-MM-dd',$!{info.applyDate})
    		    </span>
            </li>
            <li class="mui-table-view-cell">
				#springMessage('table.abAccrecords.businessDate')
                <span class="mui-badge mui-badge-inverted">
					$!date.format('yyyy-MM-dd',$!{info.businessDate})
    		    </span>
            </li>
		</ul>
    </li>
#else
<li class="mui-table-view-cell mui-collapse mui-active">
    <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.billBuInfo.title')</a>
    <ul class="mui-table-view H-theme-background-color-white">
        <li class="mui-table-view-cell">
            #springMessage('table.abVoucherinfo.Business.Brief.Id')
            <span class="mui-badge mui-badge-inverted">
                $!{abEmitBillVo.briefIdName}
    		</span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('bill.accebill.bussdt')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{abEmitBillVo.applyDate})
    		</span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.abAccrecords.businessDate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{abEmitBillVo.businessDate})
    		</span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('bill.accebill.op')
            <span class="mui-badge mui-badge-inverted">
				($!{abEmitBillVo.createBy})$!{abEmitBillVo.createName}
    		</span>
        </li>
    </ul>
</li>
#end



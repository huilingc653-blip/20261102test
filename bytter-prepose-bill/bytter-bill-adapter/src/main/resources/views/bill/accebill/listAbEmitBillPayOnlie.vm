<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <input type="hidden" name="id" value="$!{abEmitBillVo.aid}">
    <input type="hidden" name="ids" value="$!{abEmitBillVo.aid}">
    <input type="hidden" name="vids" value="$!{abEmitBillVo.vid}">
    <input type="hidden" name="vvids" value="$!{abEmitBillVo.vvid}">
    <input type="hidden" name="corpId" value="$!{abEmitBillVo.corpId}">
    <input type="hidden" id="payUse" value="$!{abEmitBillVo.payUse}">
    <input type="hidden" id="insideSing" value="$!{abEmitBillVo.insideSing}">
    <input type="hidden" name="iframeId" id="iframeId" value="$!{iframeId}">
    <input type="hidden" name="emitSttlmmk" value="1">##线上兑付
    <h2 class="layui-colla-title">#springMessage('bill.accebill.billPayInfo.title')</h2>
    <table class="layui-table" width="100%">
        <tbody>
        <tr>
        ##单位
            <td colspan="2" class="textRight" width="15%">#springMessage('table.fbsBudget.corpId')</td>
            <td width="35%">
                <input type="hidden" name="payCorpId" value="$!{abEmitBillVo.corpId}" >
                $!{abEmitBillVo.corpName}
            </td>
        ##金额
            <td colspan="2" class="textRight" width="15%">#springMessage('table.fcUnionAccbook.sendMoney')</td>
            <td>
            ##按票面金额确定兑付金额
                #if($!{edit} && $!{edit} ne "")
                    <input type="hidden" name="payMoney" id="payMoney" value="$!{abEmitBillVo.payMoney}">
                    $number.formatNumeric($!{abEmitBillVo.payMoney})
                #else
                    <input type="hidden" name="payMoney" id="payMoney" value="$!{abEmitBillVo.billMoney}">
                    $number.formatNumeric($!{abEmitBillVo.billMoney})
                #end
            </td>
        </tr>
        <tr>
        ##收款账号
            <td colspan="2" class="textRight" width="15%"><span style="color:red;font-size: 14px;font-weight:bold;vertical-align: middle;">*</span>#springMessage('table.fbsBudgetDetail.payeeAcc')</td>
            <td width="35%">
                ##客商账号--客商
                <div class="layui-input-inline" id="pledgeeAccDiv">
                    <input type="text" id="payPayeeacc" name="payPayeeacc" lay-verify="strlength" value="$!{abEmitBillVo.payPayeeacc}"
                           data-maxlength="50" autocomplete="off" class="bank layui-input" placeholder="#springMessage('table.fbsBudgetDetail.payeeAcc')">
                ##客商账号--成员单位
                ##<input type="hidden" id="payPayeeaccCorp" data-name="payPayeeaccCorp" data-biz-name="payPayeeaccCorp"
                ##       data-defaultcorp = "xx" electricBill="1"
                ##       class="bank layui-input bt-biz-accountTable" data-callback="bt.payPayeeaccCorpCallBack" >
                    <div class="bt-div-search">
                        <button class="bt-biz-externalCorpBankAcc" type="button" data-callback="bt.payPayeeaccCallback"
                                data-beforeClick="bt.externalCorpBankAccParams">
                            <i class="layui-icon">&#xe615;</i></button>
                    </div>
                </div>
            </td>
        ##收款账号名称
            <td colspan="2" class="textRight" width="15%">#springMessage('table.fbsBudgetDetail.payeeAccName')</td>
            <td width="35%">
                <input type="text" id="payPayeeName" name="payPayeeName" lay-verify="required|strlength" value="$!{abEmitBillVo.payPayeeName}"
                       data-maxlength="100" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsBudgetDetail.payeeAccName')">
            </td>
        </tr>
        <tr>
        ##收款开户行行号
            <td colspan="2" class="textRight" width="15%">#springMessage('table.nisBillhead.payeeBankCode')</td>
            <td width="35%">
                <div class="layui-input-inline" id="acceptoraccCustomerDiv">
                    <input type="text" id="payPayeeBankNo" name="payPayeeBankNo" lay-verify="required" value="$!{abEmitBillVo.payPayeeBankNo}"
                           lay-verify="strlength" data-maxlength="100"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payeeBankCode')">
                    <div class="bt-div-search" id="acceptorBankButtonDiv">
                        <button class="bt-biz-bankInfo" type="button" data-callback="bt.payPayeeBankNoCallback"><i class="layui-icon">&#xe615;</i></button>
                    </div>
                </div>
            </td>
        ##收款开户行名称
            <td colspan="2" class="textRight" width="15%">#springMessage('table.nisBillhead.payeeBank')</td>
            <td width="35%">
                <input type="text" id="payPayeeBankName" name="payPayeeBankName" lay-verify="required|strlength" value="$!{abEmitBillVo.payPayeeBankName}"
                       data-maxlength="100"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payeeBank')">
            </td>
        </tr>
        <tr>
        ##所在省
            <td colspan="2" class="textRight" width="15%">#springMessage('table.nisBillhead.prov')</td>
            <td width="35%">
                <div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="prov" data-change="city"
                     data-defaultvalue="$!{abEmitBillVo.prov}" data-required="true" data-callback="bt.provCallback"></div>
            </td>
        ##收款账号所在市
            <td colspan="2" class="textRight" width="15%">#springMessage('table.nisBillhead.city')</td>
            <td width="35%">
                <div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="city" data-defaultvalue="$!{abEmitBillVo.city}" data-required="true" data-callback="bt.cityCallback"></div>
            </td>
        </tr>
        <tr>
        ##用途
            <td colspan="2" class="textRight" width="15%">#springMessage('table.fbsBudgetDetail.purpose')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="hidden" id="purposeDef" value="$!{abEmitBillVo.payUse}">
                    <select name="payUse" id="purpose" lay-verify="required" lay-search="" data-defaultvalue="$!{abEmitBillVo.payUse}" data-inputvalue="true">
                        <option value=" "></option>
                        <option value="inputText"></option>
                    </select>
                </div>
            </td>
        ##备注
            <td colspan="2" class="textRight" width="15%">#springMessage('table.settlement.rmk')</td>
            <td width="35%">
                <input type="text" id="payAbs" name="payAbs" value="$!{abEmitBillVo.payAbs}" lay-verify="strlength" data-maxlength="200"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.settlement.rmk')">
            </td>
        </tr>
        </tbody>
    </table>
    #parse("views/common/footer.vm")
    #parse("views/bill/accebill/viewAbEmitBill.vm")
    <div class="layui-form-item layui-form-submit" id="buttonDiv2">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" type="button" lay-filter="submit">#springMessage('common.button.submit')</button>
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
</body>
<script>
    bt.use(['form','bank','moneyType','externalCorpBankAcc','bankInfo','jquery','region','bank','accountTable'], function(){
        var $ = bt.jquery,form = bt.form();
        bt.moneyType.init();
        bt.accountTable.init({urldata:{accountType:'2,3'}});
        bt.bankInfo.init();
        bt.bank.init({
            elem:'.bank'
        });

        var externalCorpBankAcc = bt.externalCorpBankAcc.init();
        bt.externalCorpBankAccParams = function () {
            //if($("#insideSing").val() == 1){
            //   //对内
            //    externalCorpBankAcc.set({"corpId": $("#corpId").val(),"type":"1"});
            //}else{
                externalCorpBankAcc.set({"corpId": $("#corpId").val()});
            //}
            return true;
        }

        var region = bt.region.init();
        var money = document.getElementById("billMoney").value;
        document.getElementById("moneyUp").innerText = bt.moneyType.getFun().toChinese(money);
        //收票人选择客商回调函数
        bt.payPayeeaccCallback = function(data,dom){
            $("#payPayeeName").val(data.name);//收款账号名称
            if(data.bank){
                $("#payPayeeacc").val(data.externalAcc);//收款账号
                $("#payPayeeBankNo").val(data.bankSourceCode);//收款开户行行号
                $("#payPayeeBankName").val(data.bank);//收款开户行名称
                $("#payPayeeacc").attr("name","payPayeeacc");
                $("#payPayeeacc").attr("type","text");
                $("#payPayeeaccCorp").removeAttr("name");
                $("#payPayeeaccCorp").attr("type","hidden");
                $("#payPayeeacc").attr("lay-verify","required");
                $("#payPayeeaccCorp").removeAttr("lay-verify");
            }else{
                $("#payPayeeacc").val("");//收款账号
                $("#payPayeeBankNo").val("");//收款开户行行号
                $("#payPayeeBankName").val("");//收款开户行名称
                $("#payPayeeacc").removeAttr("name");
                $("#payPayeeacc").attr("type","hidden");
                $("#payPayeeaccCorp").attr("name","payPayeeacc");
                $("#payPayeeaccCorp").attr("type","text");
                $("#payPayeeacc").removeAttr("lay-verify");
                $("#payPayeeaccCorp").attr("lay-verify","required");
                bt.accountTable.get("payPayeeaccCorp").initCorp(data.id,"1");
            }
			//设置省市组的值
            region.get('payeeAddr').set([{
                name: 'prov',
                defaultValue: data.accProvince
            }, {
                name: 'city',
                defaultValue: data.accCity
            }]);
            $('#payeeProv').val(data.accProvince);
            $('#payeeCity').val(data.accCity);
        }
        //选择银行回调函数
        bt.payPayeeBankNoCallback = function(data,dom){
            $("#payPayeeBankNo").val(data.bankCode);//承兑人开户行号
            $("#payPayeeBankName").val(data.bankName);//承兑人开户行名称
            //设置省市组的值
            region.get('payeeAddr').set([{
                name:'prov',
                defaultValue:data.prov
            },{
                name:'city',
                defaultValue:data.city
            }]);
            $('#payeeProv').val(data.prov);
            $('#payeeCity').val(data.city);
        }
        //收款账号回调方法
        bt.payPayeeaccCorpCallBack = function (data,dom) {
            $("#payPayeeaccCorp").val(data.bankAcc);//收款账号
            $("#payPayeeBankNo").val(data.bankCode);//收款开户行行号
            $("#payPayeeBankName").val(data.bankName);//收款开户行名称
			//设置省市组的值
            region.get('payeeAddr').set([{
                name: 'prov',
                defaultValue: data.accProvince
            }, {
                name: 'city',
                defaultValue: data.accCity
            }]);
            $('#payeeProv').val(data.accProvince);
            $('#payeeCity').val(data.accCity);
        }
        //监听新增提交
        form.on('submit(submit)', function(data){
            bt.loading.show();
            var action = "/bill/accebill/abemitbillpay/cashingConfirmation";
            // $.post(basePath + action,$('#inputForm').serialize(),function(result){
            //     parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            //     if(result.success){
            //         if(!bt.navtab){
            //             parent.layer?parent.layer.closeAll():layer.closeAll();
            //         }
            //         refresh();
            //         closeForms();//关闭当前页面并返回到父页面
            //     }
            //     bt.loading.hide();
            // },'JSON');
            // return false;

            var formData = {};
            $('#inputForm').serializeArray().forEach(function(item) {
                formData[item.name] = item.value;
            });
            $.ajax({
                url: basePath + action,
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(result) {
                    parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
                    if(result.success){
                        if(!bt.navtab){
                            parent.layer?parent.layer.closeAll():layer.closeAll();
                        }
                        refresh();
                        closeForms();//关闭当前页面并返回到父页面
                    }
                    bt.loading.hide();
                }
            });
            return false;
        });

        //刷新兑付申请列表
        function refresh(){
            var select = parent?$(parent.document): $(document);
            var items = select.find('.layui-tab-content .layui-tab-item');
            bt.each(items,function () {
                var iframe = $(this).find('iframe')[0];
                if(iframe){
                    var fname = iframe.name;
					/**
                    if( fname == '兑付确认' ){
                        var iframeDom = top.frames[fname];
                        var innerIframe = iframeDom.$('#applyiframe')[0];
                        if(innerIframe){
                            var name = innerIframe.name;
                            var applyiframe = iframeDom.frames[name];
                            applyiframe.$.fn.dataTable.tables( { visible: true, api: true, ie:true } ).ajax.reload(null, false);//null false代表页码不重置
                            return;
                        }
                    }**/
					if( fname == bt.lang('cashing.Confirmation') ){
                        var iframeDom = top.frames[fname];
                        var innerIframe = iframeDom.$('#'+$("#iframeId").val())[0];
                        if(innerIframe){
                            var name = innerIframe.name;
                            var applyiframe = iframeDom.frames[name];
                            applyiframe.$.fn.dataTable.tables( { visible: true, api: true, ie:true } ).ajax.reload(null, false);//null false代表页码不重置
                            return;
                        }
                    }
                }
            })
        }

        //获取单位用途
        $.ajax({
            url: basePath+"/basic/business/btpurpose?getPurpose",
            method: 'POST',
            data: {corpId: $("#corpId").val(),sysBusType:1},
            dataType: 'json',
            success: function(data){
                $("#purpose").empty();
                $("#purpose").append("<option value=' '></option><option value='inputText'></option>");
                $("#purpose").append("<option selected='selected' value="+$("#purposeDef").val()+">"+$("#purposeDef").val()+"</option>");
                if(data  && data.obj && data.obj.length>0){
                    $.each(data.obj,function(index,item){
                        $("#purpose").append("<option value="+item.purpose+">"+item.purpose+"</option>");
                        $("select[name='purpose']").val($("#purposeDef").val());
                    });
                }
                form.render();
            }
        });

    });
</script>
</html>










#*
*6204 票据下拨
*#
##下拨单号: table.abBillTransfer.allocatedCode.down
##下拨金额: table.abBillTransfer.downMoney
<tr>
    <td class="textRight" colspan="2">#springMessage('table.abBillTransfer.allocatedCode.down')</td>
    <td>$!{abReceiveBillPage.allocatedCode}</td>
    <td class="textRight" colspan="2">#springMessage('table.abBillTransfer.downMoney')</td>
    <td>$number.formatNumeric($!{abReceiveBillPage.allocationMoney})</td>
</tr>
##下拨原因table.abBillTransfer.downReason
##选票票号table.abBillTransfer.billNo

<tr>
    <td class="textRight" colspan="2">#springMessage('table.abBillTransfer.downReason')</td>
    <td>$!{abReceiveBillPage.allocationReason}</td>
    <td class="textRight" colspan="2">#springMessage('table.abBillTransfer.billNo')</td>
    <td>$!{abReceiveBillPage.billNo}</td>
</tr>
##下拨中心bill.accebill.transferdownmanage.corpCenter
##下拨中心账号table.abBillTransfer.recordBankAcc
<tr>
    <td class="textRight" colspan="2">#springMessage('bill.accebill.transferdownmanage.corpCenter')</td>
    <td>$!{abReceiveBillPage.recordCorpName}</td>
    <td class="textRight" colspan="2">#springMessage('table.abBillTransfer.recordBankAcc')</td>
    <td>$!{abReceiveBillPage.recordBankacc}</td>

</tr>
##收票单位table.abBillTransfer.recevieCorpId
##收票单位账号table.abBillTransfer.recevieBankAcc
<tr>
    <td class="textRight" colspan="2">#springMessage('table.abBillTransfer.recevieCorpId')</td>
    <td>$!{abReceiveBillPage.recevieCorpName}</td>
    <td class="textRight" colspan="2">#springMessage('table.abBillTransfer.recevieBankAcc')</td>
    <td>$!{abReceiveBillPage.recevieBankacc}</td>
</tr>
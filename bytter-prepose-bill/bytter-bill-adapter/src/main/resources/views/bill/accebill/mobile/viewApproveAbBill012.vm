#* 
*012 贴现赎回申请
*#
	<li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.abbilldiscountransom.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">

            <li class="mui-table-view-cell">
				#springMessage('bill.accebill.rearAccrecords')
                <span class="mui-badge mui-badge-inverted">
					$!{info.frontHand}
    		</span>
            </li>

            <li class="mui-table-view-cell">
				#springMessage('bill.accebill.rearAccrecordsAcc')
                <span class="mui-badge mui-badge-inverted">
					$!{info.frontHandAcc}
    		</span>
            </li>

            <li class="mui-table-view-cell">
				#springMessage('table.abDiscount.daynum')
                <span class="mui-badge mui-badge-inverted">
					$!{info.daynum}
    		</span>
            </li>

            <li class="mui-table-view-cell">
				#springMessage('table.abDiscount.paydate')
                <span class="mui-badge mui-badge-inverted">
					$!{info.paydate}
    		</span>
            </li>

            <li class="mui-table-view-cell">
				#springMessage('table.abDiscount.deferdate')
                <span class="mui-badge mui-badge-inverted">
					$!{info.deferdate}
    		</span>
            </li>

            <li class="mui-table-view-cell">
				#springMessage('table.abDiscount.interestRates')
                <span class="mui-badge mui-badge-inverted">
					$rateTag.show($!{info.interestRates})
    		</span>
            </li>

            <li class="mui-table-view-cell">
				#springMessage('table.abDiscount.rpdopendt')
                <span class="mui-badge mui-badge-inverted">
					$!date.format('yyyy-MM-dd',$!{info.rpdopendt})
    		</span>
            </li>

            <li class="mui-table-view-cell">
				#springMessage('table.abDiscount.rpdduedt')
                <span class="mui-badge mui-badge-inverted">
					$!date.format('yyyy-MM-dd',$!{info.rpdduedt})
    		</span>
            </li>

            <li class="mui-table-view-cell">
				#springMessage('table.abVoucherinfoVice.corpId')
                <span class="mui-badge mui-badge-inverted">
					$!{info.corpName}
    		</span>
            </li>

            <li class="mui-table-view-cell">
				#springMessage('table.abVoucherinfoVice.bankAcc')
                <span class="mui-badge mui-badge-inverted">
					$!{info.bankAcc}
    		</span>
            </li>


            <li class="mui-table-view-cell">
				#springMessage('table.abVoucherinfoVice.bankName')
                <span class="mui-badge mui-badge-inverted">
					$!{info.bankName}
    		</span>
            </li>

            <li class="mui-table-view-cell">
				#springMessage('table.abVoucherinfoVice.enterStock')
                <span class="mui-badge mui-badge-inverted">
					$!{info.enterStockName}
    		</span>
            </li>


            <li class="mui-table-view-cell">
				#springMessage('table.abDiscount.interest')
                <span class="mui-badge mui-badge-inverted">
					$number.formatNumeric($!{info.interest})
    		</span>
            </li>

            <li class="mui-table-view-cell">
				#springMessage('table.abDiscount.returnInterest')
                <span class="mui-badge mui-badge-inverted">
					$number.formatNumeric($!{info.returnInterest})
    		</span>
            </li>

        </ul>
    </li>
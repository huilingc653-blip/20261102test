#* 
*6202 票据归集
*#
	<li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.transfercollection.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
				##归集单位
				#springMessage('bill.accebill.transfercollection.transferupcorp')
                <span class="mui-badge mui-badge-inverted">
					$!{info.corpName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##归集单位开户银行
				#springMessage('bill.accebill.transfercollection.transferupbank')
                <span class="mui-badge mui-badge-inverted">
					$!{info.corpBankName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##归集银行账号
				#springMessage('bill.accebill.transfercollection.transferupbankacc')
                <span class="mui-badge mui-badge-inverted">
					$!{info.reqAcctId}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##归集银行行号
				#springMessage('bill.accebill.transfercollection.transferupbankno')
                <span class="mui-badge mui-badge-inverted">
					$!{info.reqAcctsvcr}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##中心单位
				#springMessage('bill.accebill.transferupapply.centercorp')
                <span class="mui-badge mui-badge-inverted">
					$!{info.netCorpName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				## 中心单位开户银行
				#springMessage('bill.accebill.transferupapply.centerbank')
                <span class="mui-badge mui-badge-inverted">
					$!{info.netBankName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				## 中心银行账号
				#springMessage('bill.accebill.transferupapply.centerbankacc')
                <span class="mui-badge mui-badge-inverted">
					$!{info.recAcctId}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				## 中心银行行号
				#springMessage('bill.accebill.transferupapply.centerbankno')
                <span class="mui-badge mui-badge-inverted">
					$!{info.recAcctsvcr}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##业务办理日期
				#springMessage('table.abVoucherinfo.Business.date')
                <span class="mui-badge mui-badge-inverted">
					$!date.format('yyyy-MM-dd',$!{info.businessDate})
    			</span>
            </li>
		</ul>
    </li>

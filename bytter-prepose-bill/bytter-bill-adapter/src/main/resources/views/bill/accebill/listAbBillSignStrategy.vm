<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
    <table class="layui-table">
        <tbody>
        <tr>
        ## 所属单位
            <td class="textRight" width="8%">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-scope="all"
                         data-resource="bill:accebill:sign:query"
                         data-placeholder="#springMessage('table.abVoucherinfoVice.corpId')">
                    </div>
                </div>
            </td>
        ## 签收类型
            <td class="textRight">#springMessage('bill.accebill.signerType')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="mulselect" data-group="AB_BILL_SIGNERTYPE" data-name="likes_signType" ></div>
                </div>
            </td>
        ##策略名称
            <td class="textRight">#springMessage('table.btwarnstrategy.name')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_name" autocomplete="off" class="layui-input" placeholder="#springMessage('table.btwarnstrategy.name')">
                </div>
            </td>
        </tr>
        <tr>
        ##票据类型
            <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
            <td> 
                <div class="bt-biz-dict" data-displayData="10,11" data-type="select" data-group="AB_BILL_TYPE" data-name="eqs_billType"></div>
            </td>
        ##
            <td class="textRight"></td>
            <td width="25%">
            </td>
        ##
            <td class="textRight"></td>
            <td>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
            </div>
        </div>
    </div>
</form>

    #if($shiro.hasPermission("bill:accebill:sign:query"))
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.abVoucherinfoVice.corpId')</th>
            <th>#springMessage('table.btwarnstrategy.code')</th>
            <th>#springMessage('table.btwarnstrategy.name')</th>
            <th>#springMessage('table.abVoucherinfo.billType')</th>
            <th>#springMessage('bill.accebill.signerType')</th>
            <th>#springMessage('table.bvVoucherType.validSign')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #end

    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillSignStrategy.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>

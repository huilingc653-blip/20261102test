#* 
*开票审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<style>
	#mulTable .view-cell-left {
		display: inline-block;
		width:50%;
		padding: 11px 15px 11px 0px;
		box-sizing: border-box;
	}
	#mulTable .mui-badge {
		max-width: 50%!important;
		right: 0!important;
		padding-right: 15px;
		box-sizing: border-box;
	}
</style>
<script src="${basePath}/static/plugins/jquery/jquery.min.js?_btv=${resourceVersion}"></script>
<body>
<ul class="mui-table-view" id="mulTable">
	#if($!{abEmitBillVo.emitSttlmmk}==1)
    <li class="mui-table-view-cell mui-collapse">
		##线上兑付信息
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.billPayInfo.title')</a>
		<ul class="mui-table-view H-theme-background-color-white">
			##单位
			<li class="mui-table-view-cell">
				#springMessage('table.fbsBudget.corpId')
				<span class="mui-badge mui-badge-inverted">
					$!{abEmitBillVo.corpName}
				</span>
			</li>
			##金额
			<li class="mui-table-view-cell">
				#springMessage('table.fcUnionAccbook.sendMoney')
				<span class="mui-badge mui-badge-inverted">
					$number.formatNumeric($!{abEmitBillVo.payMoney})
				</span>
			</li>
			##收款账号
			<li class="mui-table-view-cell">
				#springMessage('table.fbsBudgetDetail.payeeAcc')
				<span class="mui-badge mui-badge-inverted">
					$!{abEmitBillVo.payPayeeacc}
				</span>
			</li>
			##收款账号名称
			<li class="mui-table-view-cell">
				<div class="view-cell-left">
					#springMessage('table.fbsBudgetDetail.payeeAccName')
				</div>
				<span class="mui-badge mui-badge-inverted">
					$!{abEmitBillVo.payPayeeName}
				</span>
			</li>
			##收款开户行行号
			<li class="mui-table-view-cell">
				#springMessage('table.nisBillhead.payeeBankCode')
				<span class="mui-badge mui-badge-inverted">
					$!{abEmitBillVo.payPayeeBankNo}
				</span>
			</li>
			##收款开户行名称
			<li class="mui-table-view-cell">
				<div class="view-cell-left">
					#springMessage('table.nisBillhead.payeeBank')
				</div>
				<span class="mui-badge mui-badge-inverted">
					$!{abEmitBillVo.payPayeeBankName}
				</span>
			</li>
			##所在省
			<li class="mui-table-view-cell">
				#springMessage('table.nisBillhead.prov')
				<span class="mui-badge mui-badge-inverted">
					$!{abEmitBillVo.provName}
			</span>
			</li>
			##所在市
			<li class="mui-table-view-cell">
				#springMessage('table.nisBillhead.city')
				<span class="mui-badge mui-badge-inverted">
					$!{abEmitBillVo.cityName}
			</span>
			</li>
			##用途
			<li class="mui-table-view-cell">
				#springMessage('table.fbsBudgetDetail.purpose')
				<span class="mui-badge mui-badge-inverted">
					$!{abEmitBillVo.payUse}
				</span>
			</li>
			##备注
			<li class="mui-table-view-cell">
				#springMessage('table.fbsBudgetPeriod.rmk')
				<span class="mui-badge mui-badge-inverted">
					$!{abEmitBillVo.payAbs}
				</span>
			</li>
		</ul>
	</li>
	#end
    <li class="mui-table-view-cell mui-collapse">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.billAppInfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
		#if($!{abEmitBillVo.batchNo})
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.batchNo')
			<span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.batchNo}
			</span>
		</li>
		#end
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfoVice.appNo')
			<span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.appNo}
			</span>
		</li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfoVice.corpId')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.corpName}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.source')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.sourceName}
    		</span>
        </li>
        </ul>
    </li>
    <li class="mui-table-view-cell mui-collapse">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.billInfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.origNo')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.origNo}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.banendrsmtmk')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.banendrsmtmkName}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.billMoney')
            <span class="mui-badge mui-badge-inverted">
				$number.formatNumeric($!{abEmitBillVo.billMoney})
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.billMoneyUp')
            <span class="mui-badge mui-badge-inverted">
				$string.chineseMoney($!{abEmitBillVo.billMoney})
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.startDate')
            <span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!{abEmitBillVo.startDate})
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.endDate')
            <span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!{abEmitBillVo.endDate})
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.billType')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.billTypeName}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.billFlag')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.billFlagName}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.payer')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.payer}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.payeracc')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.payeracc}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			<div class="view-cell-left">
				#springMessage('table.abVoucherinfo.payerBankName')
			</div>
			<span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.payerBankName}
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.payee')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.payee}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.payeeacc')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.payeeacc}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			<div class="view-cell-left">
				#springMessage('table.abVoucherinfo.payeeBankName')
			</div>
			<span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.payeeBankName}
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.acceptor')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.acceptor}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			<div class="view-cell-left">
				#springMessage('table.abVoucherinfo.acceptorbankno')
			</div>
			<span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.acceptorbankno}
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.acceptoracc')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.acceptoracc}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			<div class="view-cell-left">
				#springMessage('table.abVoucherinfo.acceptorBankName')
			</div>
			<span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.acceptorBankName}
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.aContractNo')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.acontractNo}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.aInvcnb')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.ainvcnb}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abAccrecords.abs')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.abs}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abAccrecords.rmk')
            <span class="mui-badge mui-badge-inverted">
				$!{abEmitBillVo.rmk}
    		</span>
        </li>
        </ul>
    </li>
	#set($vmPage = "views/bill/accebill/mobile/viewApproveAbBill"+$!{abEmitBillVo.briefId}+".vm")
	#parse($vmPage)
</ul>
#parse("views/common/wapfooter.vm")
</body>
</html>

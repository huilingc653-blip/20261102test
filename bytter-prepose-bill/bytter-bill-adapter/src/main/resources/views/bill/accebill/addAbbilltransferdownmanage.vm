<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <table class="layui-table">
			<tbody>
        	<tr>
				##下拨单号
				<td class="textRight">#springMessage('table.abBillTransfer.allocatedCode.down')</td>
				<input name="allocatedCode" type="hidden" id="allocatedCode" value="$!{allocatedCode}">
				<td width="40%" id="allocatedCodeName">
                        $!{allocatedCode}
				</td>
				##录入日期
				<td class="textRight">#springMessage('table.abBillTransfer.recordDate')</td>
				<td width="40%">
					<input type="hidden" name="recordDate" data-name="recordDate" class="layui-input bt-biz-dateType" data-today="true"
							readonly="true"	data-type="date" value="$!{recordDate}">
					$!{recordDate}
				</td>
			</tr>
			
			<tr>	
        		##下拨中心  input参数用于刷新进行查询时的条件
				<input type="hidden" id="netId" name="eqs_netId"  value="$!{netId}" readonly="true">
				<td class="textRight">#springMessage('bill.accebill.transferdownmanage.corpCenter')</td>
				<td width="25%">
					<div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-name="recordCorpId"
                             data-biz-name="netId"
                             data-biz-type="net"
                             data-type="select"
                             data-scope="net"
                             data-required="true"
                             data-scope="net"
                             data-callback="netCallback"
                             data-resource="ab:bill:resource:transferdownmanage:query"
						></div>

                    </div>
                </td>
				##下拨中心账号
				<td class="textRight">#springMessage('table.abBillTransfer.recordBankAcc')</td>
				<td>
					<div class="layui-input-inline">
						<input type="text" id="recordBankacc" name="recordBankacc" data-name="recordBankacc" data-biz-name="recordBankacc"
							data-resource="ab:bill:resource:transferdownmanage:query" lay-verify="strlength"
						    data-defaultcorp = "xx" electricBill="1" data-maxlength="30"
							class="bank layui-input bt-biz-accountTable" data-callback="recordBankaccCallBack" >
					</div>
				</td>
			</tr>
			
        	<tr>	
        		##收票单位
				<td class="textRight">#springMessage('table.abBillTransfer.recevieCorpId')</td>
				<td >
					<input id="recevieCorpName" name="recevieCorpName" type="hidden">
					<div id="corpId"></div>
				</td>
				##收票单位账号
				<td class="textRight">#springMessage('table.abBillTransfer.recevieBankAcc')</td>
				<td>
					<div class="layui-input-inline">
						<input type="text" id="recevieBankacc" name="recevieBankacc" data-name="recevieBankacc" data-biz-name="recevieBankacc"
                               data-resource="bill:accebill:abemitbill:query"
							lay-verify="strlength" data-defaultcorp = "xx" electricBill="1" data-maxlength="30"
							class="bank layui-input bt-biz-accountTable" data-callback="recevieBankaccCallBack" >
					</div>
				</td>
			</tr>
			
        	<tr>
				##下拨票据
				<td class="textRight">#springMessage('table.abBillTransfer.downBill')</td>
				<td >
					<button class="layui-btn bt-biz-accebillInfoReceive" id="accebillInfoBut" type="button" data-beforeClick="bt.accebillInfoParams"
						data-callback="bt.accebillInfoCallback">#springMessage('common.button.selectBill')</button>
					<button class="layui-btn bt-biz-accebillView" id="accebillViewBut" type="button" data-beforeClick="bt.accebillViewParams" 
						data-callback="bt.accebillViewParams">#springMessage('common.button.viewBill')</button>
					&nbsp;&nbsp;&nbsp;
                    <span style="color:red">
						##注意:收票单位账号为空时只能下拨纸票
						(#springMessage('bill.accebill.transferdownmanage.selectbill'))
					</span>
                </td>
				##选票票号
				<td class="textRight">#springMessage('table.abBillTransfer.billNo')</td>
				<input name="billAid" type="hidden" id="billAid">
				<input name="billNo" id="billNo" type="hidden">
				<input name="billBalance" id="billBalance" type="hidden">
				<input name="oldIds" id="oldIds" type="hidden">
				<td id="billNoName">
                </td>
			</tr>
			
        	<tr>
				##下拨金额
				<td class="textRight">#springMessage('table.abBillTransfer.downMoney')</td>
				<input name="allocationMoney" id="allocationMoney" type="hidden" value="$!{vo.allocationMoney}">
				<td id="allocationMoneyName">
				</td>
				##剩余金额
				#*<td class="textRight">#springMessage('table.abBillTransfer.surplusMoney')</td>*#
				<td class="textRight"></td>
				<td></td>
			</tr>
			
        	<tr>
        		##票据币别
				<td class="textRight">#springMessage('table.abBillTransfer.billCurrency')</td>
				<td >
					<div class="layui-inline">
                        <input type="hidden" name="billCurrency" id="billCurrencyDefault" value="$!{billCurrencyDefault}" >
						##票据不开放其它币别
                        <input type="text" class="layui-input" readonly="true" value="#springMessage('table.curName.rmb')" >
                        #*<input type="hidden" id="billCurrencyDefault" value="$!{billCurrencyDefault}" >
                        <div type="list" field="billCurrency" name = "billCurrency" fieldHref="${basePath}/basic/business/btcurrency/json" dictField="id" dictText="curName" ></div>*#
                    </div>
                </td>
				##业务归属日期
				<td class="textRight">#springMessage('table.abVoucherinfo.Business.date')</td>
				<td >
					<input type="text" name="businessDate" data-name="businessDate" class="layui-input bt-biz-dateType"  data-type="date"
							    data-biz-name="businessDate" placeholder="$!{table.abVoucherinfo.Business.date}" data-today="true">
                </td>
			</tr>
        	<tr>
        		##下拨原因
				<td class="textRight">#springMessage('table.abBillTransfer.downReason')</td>
				<td colspan="3">
						<textarea name="allocationReason" required placeholder="#springMessage('table.abBillTransfer.downReason')"
                                  lay-verify="strlength" data-maxlength="240" class="layui-textarea"></textarea>
                </td>
			</tr>
        	
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" type="button" lay-filter="save">#springMessage('common.button.temp')</button>
						<button class="layui-btn" lay-submit="" type="button" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>

    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abbilltransferdownmanage.add.js?_btv=${resourceVersion}"></script>
</html>
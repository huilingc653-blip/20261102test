<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
		<div class="layui-collapse" lay-filter="collapse">
			<form id="searchForm" class="layui-form input150-container">
			<input type="hidden" id="curId" name="curCode" value="$!{curId}" />
			##<input type="hidden" id="ids" name="ids" value="$!{curId}" />
			<input type="hidden" id="isSelectBill" name="isSelectBill" value="$!{isSelectBill}" />
			<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('common.query.title')</h2>
			<div class="layui-colla-content layui-show">
			<table class="layui-table">
				<tbody>
					<tr>
						## 申请单位
						<td class="textRight">#springMessage('bill.accebill.applyCorp')</td>
						<td width="25%">
							<div class="layui-input-inline">
								<div class="bt-biz-corp"
									 data-tree-type="check"
									 data-biz-type="corp"
									 data-type="selectTree"
									 data-name="ins_applyCorpId"
									 data-scope="all"
									 data-resource="bill:accebill:abbillendorse:query"
									 data-callback="applyCorpCallback"
								>
								</div>
							</div>
						</td>
						## 票据单位
						<td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
						<td width="25%">
							<div class="layui-input-inline">
								<div class="bt-biz-corp"
									 data-biz-name="corpIdQuery"
									 data-tree-type="check"
									 data-biz-type="corp"
									 data-type="selectTree"
									 data-name="ins_corpId"
									 data-resource="bill:accebill:abbillendorse:query"
									 data-scope="all"
								>
								</div>
							</div>
						</td>
						## 业务单位
						<td class="textRight" >#springMessage('bill.accebill.busCorp')</td>
						<td width="25%">
							<div class="layui-input-inline">
								<div class="bt-biz-corp"
									 data-tree-type="check"
									 data-biz-type="corp"
									 data-type="selectTree"
									 data-name="ins_busCorpId"
									 data-scope="all"
									 data-resource="bill:accebill:abbillendorse:query"
								>
								</div>
							</div>
						</td>
					</tr>
					<tr>
						##票据号码
						<td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
						<td >
							<div class="layui-input-inline">
								<input type="text" name="likes_origNo"
									   autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
							</div>
						</td>
						##出票日期
						<td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
						<td >
							<div class="layui-inline">
								<div id="startDate" ></div>
							</div>
						</td>
						##业务人员
						<td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
						<td >
							<div class="layui-input-inline">
								<input type="text" name="likes_busPersonnel"
									   autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
							</div>
						</td>
					</tr>

					<tr>
						 ##流通介质
						<td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
						<td width="20%">
						<div class=layui-form>
							<div class=bt-biz-dict data-type="select" data-name="eqi_billFlag"  data-group="AB_BILL_FLAG">
							</div>
						</div>
						</td>
						##到期日期
						<td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
						<td >
						<div class="layui-inline">
							<div id="endDate" ></div>
						</div>
						</td>
						 ##出票人
						 <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
						 <td >
							 <div class="layui-input-inline">
								 <input type="text" name="likes_payer"
										autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payer')">
							 </div>
						 </td>
					</tr>

					<tr>
						##票据类型
						<td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
						<td width="20%">
							<div class=layui-form>
								<div class=bt-biz-dict data-type="select" data-name="eqi_billType"  data-group="AB_BILL_TYPE">
								</div>
							</div>
						</td>
						##票据金额
						<td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
						<td>
							<input class="layui-input bt-input-inline  bt-biz-moneyType" type="text" data-name="geg_billMoney"
								data-moneyendid="leg_billMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')" />
							<span class="date-mid">~</span>
							<input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_billMoney" type="text"
								data-name="leg_billMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')" />
						</td>
						##承兑人
						<td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
						<td >
							<div class="layui-input-inline">
								<input type="text" name="likes_acceptor"
										autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptor')">
							</div>
						</td>

					</tr>

					 <tr>
						 ##业务处理状态
						 <td class="textRight">#springMessage('table.abAccrecords.status')</td>
						 <td >
							 <div class=layui-form>
								 <div class=bt-biz-dict data-type="select" data-name="eqi_status" data-biz-name="demo-dict"
									  data-group="AB_BILL_BUSSTATUS" data-displayData="0,11,95,-1"></div>
							 </div>
						 </td>
						##入库库存
						<td class="textRight">#springMessage('table.abVoucherinfoVice.enterStock')</td>
						<td >
							<div class="layui-input-inline">
								<div class="bt-biz-dict" data-type="select" data-group="AB_ENTER_STOCK" data-defaultvalue="$!{abReceiveBillPage.enterStock}" data-name="eqs_enterStock" data-filterData="12" ></div>
							</div>
						</td>
						##在线离线标志
						<td class="textRight">#springMessage('bill.accebill.billSendSign')</td>
						<td >
							<div class="bt-biz-dict" data-type="select" data-group="AB_BILL_SEND_SIGN" data-name="eqs_sendSign" ></div>
						</td>
					</tr>
					<tr>
						##银行类别
						<td class="textRight">#springMessage('table.btBankAcc.bankTypeId')</td>
						<td width="24%">
							 <div class="layui-input-inline">
								<div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json" data-method="get"
									 data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId" data-inputvalue="inputvalue" data-search="true"></div>
							 </div>
						 </td>
						 ##银行账号
						 <td class="textRight">#springMessage('table.foreign.bankAcc')</td>
						 <td width="24%">
							   <input type="text" name="likes_bankAcc"
									autocomplete="off" class="layui-input" placeholder="#springMessage('table.foreign.bankAcc')">
						 </td>

					</tr>
					<tr>
						<td colspan="8" style="text-align: center;">
							#if($shiro.hasPermission("bill:accebill:abbillendorse:query"))
							<button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
							<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
							#end
						</td>
					</tr>
				</tbody>
			</table>
			</div>
			</div>
			</form>
		</div>
##if($shiro.hasPermission("bill:accebill:endorseResponse:query"))
<table id="appTable" class="layui-table layui-form" style="width:100%;" style="display:none" data-btns="colvis">
    <thead>
    <tr>
		<th>#springMessage('table.abVoucherinfo.billType')</th>
		<th>#springMessage('table.abVoucherinfo.billFlag')</th>
		<th>#springMessage('table.abVoucherinfoVice.enterStock')</th>
		<th>#springMessage('bill.accebill.applyCorp')</th>
		<th>#springMessage('table.abVoucherinfoVo.corpId')</th>
		<th>#springMessage('bill.accebill.busCorp')</th>
		<th>#springMessage('bill.accebill.busPersonnel')</th>
		<th>#springMessage('bill.accebill.endorseeName')</th>
		<th>#springMessage('table.abVoucherinfo.payer')</th>
		<th>#springMessage('table.abVoucherinfo.acceptor')</th>
        <th>#springMessage('table.abVoucherinfo.origNo')</th>
		<th>#springMessage('table.abVoucherinfo.billMoney')</th>
		<th>#springMessage('table.abVoucherinfo.startDate')</th>
		<th>#springMessage('table.abVoucherinfo.endDate')</th>
		<th>#springMessage('table.abVoucherinfo.payee')</th>
		<th>#springMessage('table.abAccrecords.cnAccrecords')</th>
        <th>#springMessage('table.abVoucherinfo.Business.Brief.Id')</th>
		<th>#springMessage('bill.accebill.billSendSign')</th>
		<th>#springMessage('table.btBankAcc.bankTypeId')</th>
		<th>#springMessage('table.foreign.bankAcc')</th>
		<th>#springMessage('table.abAccrecords.status')</th>
		<th>#springMessage('bill.accebill.attachment')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
<form class="layui-form" id="dataForm">
	<table class="layui-table">
		<tbody>
		<tr>
			<td class="textRight" width="8%">
				<label> #springMessage('table.endorseResponse.consentRmk')</label>
			</td>
			<td >
				<div class="layui-inline">
					<input type="text" id="rmk" autocomplete="off" class="layui-input"
						   data-maxlength="100" placeholder="#springMessage('table.endorseResponse.consentRmk')">
				</div>
			</td>
		</tr>
		</tbody>
	</table>
</form>

##end

#parse("views/common/footer.vm")
#caDataHidden()
#caDataScript()
</body>
<script src="${basePath}/static/modules/sys/blackWhite/blackWhiteBase.check.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abBillEndorseResponse.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>

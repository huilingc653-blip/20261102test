	<li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.consentpayinfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
    	<li class="mui-table-view-cell">
			#springMessage('table.abAccrecords.rcrsType')
            <span class="mui-badge mui-badge-inverted">
    			$!{info.rcrsTpName}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abAccrecords.rcrsrsncd')
            <span class="mui-badge mui-badge-inverted">
    			$!{info.rcrsrsncdName}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.consentpayMoney')
            <span class="mui-badge mui-badge-inverted">
    			$number.formatNumeric($!{info.rcrsokmoney})
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.searchForMoney')
            <span class="mui-badge mui-badge-inverted">
    			$number.formatNumeric($!{info.reqamt})
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abAccrecords.applyDate')
            <span class="mui-badge mui-badge-inverted">
    			$!date.format('yyyy-MM-dd',$!{info.applyDate})
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abBackbillinfo.appldt')
            <span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!{info.appldt})
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.op')
            <span class="mui-badge mui-badge-inverted">
				($!{info.createBy})$!{info.createName}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.consentpayRmk')
            <span class="mui-badge mui-badge-inverted">
				$!{info.rmk}
    		</span>
        </li>
        </ul>
    </li>

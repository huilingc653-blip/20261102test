<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
            <table class="layui-table">
                <tbody>
                <tr>
                ##统计方式
                    <td class="textRight">#springMessage('accebill.statistical')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="radio" data-group="AB_BILL_STATISTICAL"  data-name="eqi_statistical"
                                #if($!{statistical} && $!{statistical} ne "") data-defaultvalue="$!{statistical}" #else data-defaultvalue="0"  #end
                                 data-biz-name="statistical" data-callback="resetDate" data-required="true"></div>
                        </div>
                    </td>
                ##持票单位
                    <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 data-biz-name="corpId"
                                #if($!{corpId})
                                 data-defaultvalue="$!{corpId}"
                                #end
                                 data-placeholder="#springMessage('table.abVoucherinfoVice.corpId')"
                                 data-scope="all"
                                 data-resource="ab:bill:discountaccountcount:query:corpop">
                            </div>
                        </div>
                    </td>
                ##票据类型
                    <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE" data-defaultvalue="$!billType" data-name="eqi_billType" data-biz-name="billType"></div>
                        </div>
                    </td>
                </tr>
                <tr>
                </tr>
                <tr>
                ##到账日期
                    <td class="textRight">
						<span class="pl"><span class="required-icon">*</span></span>
						#springMessage('accebill.accountCount.date')</td>
                    <td width="24%">
                        <div id="dateDiv" >
                            #*<input type="text" name="ged_businessDate" data-required="true" date-type="month" class="layui-input bt-input-inline  bt-biz-dateType" id="gbusinessDate" value="$!gbusinessDate"  data-endid="lbusinessDate" data-biz-name="gbusinessDate" placeholder="#springMessage('accebill.accountCount.date')">
                            <span class="date-mid">~</span>
                            <input type="text" name="led_businessDate" date-type="month" class="layui-input bt-input-inline  bt-biz-dateType" id="lbusinessDate" value="$!lbusinessDate" data-biz-name="lbusinessDate" placeholder="#springMessage('accebill.accountCount.date')">*#
                        </div>
                    </td>
                ##贴入人
                    <td class="textRight">#springMessage('accbill.discountaccountcount.discoutRec')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" id="recNm" name="likes_recNm" autocomplete="off" class="layui-input" value="$!recNm" placeholder="#springMessage('accbill.discountaccountcount.discoutRec')">
                        </div>
                    </td>
                ##流通介质
                    <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select"   data-group="AB_BILL_FLAG" data-defaultvalue="$!billFlag" data-name="eqi_billFlag" data-biz-name="billFlag"></div>
                        </div>
                    </td>
                </tr>
                <tr>
                ##统计维度
                    <td class="textRight">
                        <span class="pl"><span class="required-icon">*</span></span>
                        #springMessage('bill.discountAccountCount.statisticalDimension')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="radio" data-group="BILL_DISCOUNT_DIMENSION"  data-name="dimensions"
                                #if($!{dimensions} && $!{dimensions} ne "") data-defaultvalue="$!{dimensions}" #else data-defaultvalue="0"  #end
                                 data-biz-name="dimensions"  data-required="true"></div>
                        </div>
                    </td>
                    <td class="textRight"></td>
                    <td width="24%"></td>
                    <td class="textRight"></td>
                    <td width="24%"></td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit=""  onclick="selectData()" type="button">#springMessage('common.button.search')</button>
                        <button type="button" class="layui-btn layui-btn-primary" onclick="resetQuery()">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
                </tbody>
        </table>
   </form>
#if($shiro.hasPermission("ab:bill:discountaccountcount:query:corpop"))
#if($!isQuery eq "1")
<table id="appTable" class="layui-table" style="width:100%;">
    <thead>
    <tr>
        #if($!dimensions eq "0")
            <th>#springMessage('accbill.discountaccountcount.discoutRec')</th>
        #else
            <th>#springMessage('table.abVoucherinfoVice.corpId')</th>
        #end
        #*循环遍历表头数据*#
      #if($!dateList)
            #foreach($date in $dateList)
                 <th>#springMessage($date)</th>
            #end
        #end
       <th>#springMessage('table.datatable.subtotal')</th>
    </tr>
    </thead>
</table>
#end
#end
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillDiscountAccountCount.list.js?_btv=${resourceVersion}"></script>
<script language="javascript" type="text/javascript">
    var datatable={},corp,dicts,moneyType,dateType;
    bt.use(['form','datatable','moneyType','dateType','corp','select','dicts'], function(){
        $ = bt.jquery,form = bt.form();
        corp=bt.corp.init();
        dicts=bt.dicts.init();
        moneyType=bt.moneyType.init();
        dateType=bt.dateType.init();


        //初始化加载日期控件
        setTimeout(function(){
            var statistical = dicts.get("statistical").val();
            $('#dateDiv').html("");
            var html="";
            if(statistical=="0"){
                html = '<div class="layui-inline">'
                        +'<input type="text" data-required="true" id="gbusinessDate" name="ged_businessDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="lbusinessDate"'
                        +'  data-type="month" data-biz-name="gbusinessDate"  value="$!{gbusinessDate}"/>'
                        +'<span class="date-mid">~</span>'
                        +'<input type="text" name="led_businessDate" class="layui-input bt-input-inline bt-biz-dateType" id="lbusinessDate"'
                        + ' data-type="month" data-biz-name="lbusinessDate" value="$!{lbusinessDate}" />'
                        +'</div>';
            }else{
                html = '<div class="layui-inline">'
                        +'<input type="text" data-required="true" id="gbusinessDate" name="ged_businessDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="lbusinessDate"'
                        +'  data-type="date" data-biz-name="gbusinessDate"  value="$!{gbusinessDate}"/>'
                        +'<span class="date-mid">~</span>'
                        +'<input type="text" name="led_businessDate" class="layui-input bt-input-inline bt-biz-dateType" id="lbusinessDate"'
                        +'  data-type="date" data-biz-name="lbusinessDate"  value="$!{lbusinessDate}"/>'
                        +'</div>';
            }
            $('#dateDiv').html(html);
            bt.dateType.init();
        },100);

        //延迟加载
    #if($!isQuery eq "1")
    setTimeout(function() {
    var corpId = #if($!{corpId}) "$!{corpId}" #else "" #end;
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            colReorder: true,
            //checkbox:true,
            paging: false,
            order: [1, 'desc'],
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath + "/bill/accebill/abbilldiscountaccountCount/datatable?corpId="+corpId
            },
            buttons: [
                {
                    extend: "colvis",
                    columns: ':not(:first):not(:last)',
                    text: bt.lang('common.button.theadHide'),
                }
            ]
            , columns: [
                {data: "recNm", bSortable: true},
                #if($!dateList)
                    #foreach($date in $dateList)
                        {
                            data: "$date",
                            bSortable: false,
                            className: 'textRight',
                            render: function (data, type, full, meta) {
                                return bt.money.format(data);
                            }
                        },
                    #end
                #end
                {
                    data: "realMoneySum",bSortable: false,className: 'textRight', render: function (data, type, full, meta) {
                    return bt.money.format(data);
                }
                }
            ],
            fixedColumns: {
                rightColumns: 1,
                leftColumns: 1
            },
            summary: {
                pageSum: true,
                //   selectSum:true,
                sumList: [
                    #if($!dateList)
                        #foreach($date in $dateList)
                            #set($colNum=$!{velocityCount} + 1)
                            {
                                colNum: '$!{velocityCount}',
                                dataName: '$!date'
                            },
                        #end
                        {
                            colNum: '$!{colNum}',
                            dataName: 'realMoneySum'
                        }
                    #end]
            }
        });
    },100);
    #end
    });
</script>
</html>

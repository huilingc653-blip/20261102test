<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="nisBusTypeForm">
	<input id="id" name="id" type="hidden" value="$!{abBillRuleBillDtlRmkPage.id}">
	<input type="hidden" id="bankTypeName" name="bankTypeName" value="$!{abBillRuleBillDtlRmkPage.bankTypeName}"/>
	<table class="layui-table">
		<tbody>
		<tr>
			##银行类别
			<td class="textRight">#springMessage('table.bisAccBal.bifCode')</td>
			<td>
				<div class="bt-biz-selectType"
					 data-url="${basePath}/basic/business/btbanktype/listFilter"
					 data-name ="bankTypeId"
					 data-biz-name ="bankTypeId"
					 data-valueField="id"
					 data-required="true"
					 data-textField="typeName"
					 data-callback="bankinfoCallback"
					 data-defaultvalue="$!{abBillRuleBillDtlRmkPage.bankTypeId}"
				></div>
			</td>
		</tr>
		<tr>
			##业务类型
			<td class="textRight">#springMessage('table.abAccrecords.briefId')</td>
			<td>
				<div class="bt-biz-dict"
					 data-type="select"
					 data-group="accebill_billNo_insbriefid"
					 data-required="true"
					 data-name="bustype"
					 data-defaultvalue="$!{abBillRuleBillDtlRmkPage.bustype}"
				></div>
			</td>
		</tr>
		<tr>
			##状态
			<td class="textRight">#springMessage('table.bisAccDtl.status')</td>
			<td>
				<div class="bt-biz-dict"
					 data-type="select"
					 data-group="valid_sign"
					 data-required="true"
					 data-name="status"
					 data-defaultvalue="$!{abBillRuleBillDtlRmkPage.status}"
				></div>
			</td>
		</tr>

		<tr id="matchContentTr">
			##匹配规则
			<td colspan="2">
				<table class="layui-table layui-table-border" width="100%" id="matchContentTable">
					<tr style="background:#c6c6c6;">
						<td colspan="7">#springMessage('table.netbank.nisproject.matchContent')</td>
					</tr>
					<tr>
						<td class="textCenter" width="20%">#springMessage('table.bvPrintMatchRule.matchRule')</td>
						<td class="textCenter" width="5%">#springMessage('table.symbol.brackets')</td>
						<td class="textCenter" width="20%">#springMessage('table.netbank.nisproject.matchAttr')</td>
						<td class="textCenter" width="20%">#springMessage('table.netbank.nisproject.matchRelation')</td>
						<td class="textCenter" width="20%">#springMessage('table.netbank.nisproject.matchContent')</td>
						<td class="textCenter" width="5%">#springMessage('table.symbol.brackets')</td>
						<td class="textCenter" width="20%">#springMessage('common.table.thead.operation')</td>
					</tr>
					#if(${length} > 0)
						#foreach($abBillRuleBillDtlRmkDtlVO in $!{abBillRuleBillDtlRmkDtlVOList})
							#set($row = $!{velocityCount})
							#if($!{velocityCount} == 1)
								<tr row="$row">
									<td class="textCenter">
										<input type="hidden" name="matchRule" value=" "/>
									</td>
									<td class="textCenter">
										<div class="layui-input-inline">
											<select name="leftParenthesis"   data-search="false" data-inputvalue="true" data-value="$!{abBillRuleBillDtlRmkDtlVO.leftParenthesis}">
												<option value=" ">#springMessage('common.placeholder.select')</option>
												#if($!{abBillRuleBillDtlRmkDtlVO.leftParenthesis} =="(")
													<option value="(" selected>(</option>
												#else if
													<option value="(">(</option>
												#end
											</select>
										</div>
									</td>
									<td class="textCenter">
										<div class="bt-biz-dict" data-type="select" data-group="billClaimRule.matchElements"  data-name="matchElements" data-biz-name="matchElements$row" data-defaultvalue="$!{abBillRuleBillDtlRmkDtlVO.matchElements}" data-callback="onchangeMatchElements"></div>
									</td>
									<td class="textCenter">
										<div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchRelations"  data-name="matchRelations" data-biz-name="matchRelations$row" data-defaultvalue="$!{abBillRuleBillDtlRmkDtlVO.matchRelations}" data-callback="onchangeMatchRelations"
											 #if($!{abBillRuleBillDtlRmkDtlVO.matchElements} != "amt"))
											 data-filterData="5,6,7,8,9,10"
											 #end
										></div>
									</td>
									<td class="textCenter">
										<input type="text" name="matchContent" id="matchContent$row"  placeholder="#springMessage('table.netbank.nisproject.matchContent')" autocomplete="off" class="layui-input" value="$!{abBillRuleBillDtlRmkDtlVO.matchContent}"
											   lay-verify="strlength" data-maxlength="100"
											#if($!{abBillRuleBillDtlRmkDtlVO.matchElements} == "amt"
											&& ($!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "1" || $!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "2"
											|| $!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "3" || $!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "4"))
											   style="display: none;"#end>
										<div class="layui-input-inline" id="number$row"
											#if($!{abBillRuleBillDtlRmkDtlVO.matchElements} != "amt" || ($!{abBillRuleBillDtlRmkDtlVO.matchElements} == "amt"
											&& ($!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "5" || $!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "6"
											|| $!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "7" || $!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "8")))
											 style="display: none;"#end>
											<select  lay-search="" data-inputvalue="true" >
												<option value="1" #if($!{abBillRuleBillDtlRmkDtlVO.matchContent} == "奇数") selected #end>#springMessage('table.number.odd')</option>
												<option value="2" #if($!{abBillRuleBillDtlRmkDtlVO.matchContent} == "偶数") selected #end>#springMessage('table.number.even')</option>
											</select>
										</div>
									</td>
									<td class="textCenter">
										<div class="layui-input-inline">
											<select name="rightParenthesis"   data-search="false" data-inputvalue="true" data-value="$!{abBillRuleBillDtlRmkDtlVO.rightParenthesis}">
												<option value=" ">#springMessage('common.placeholder.select')</option>
												#if($!{abBillRuleBillDtlRmkDtlVO.rightParenthesis} ==")")
													<option value=")" selected>)</option>
												#else if
													<option value=")">)</option>
												#end
											</select>
										</div>
									</td>
									<td class="textCenter">
										<button class="layui-btn" onclick="addTr();" type="button">#springMessage('common.addTr')</button>
									</td>
								</tr>
							#else
								<tr row="$row">
									<td class="textCenter">
										<div class="bt-biz-dict" data-type="select" data-group="FUNDWARN_NUM_OPERATOR"  data-name="matchRule"  data-defaultvalue="$!{abBillRuleBillDtlRmkDtlVO.matchRule}"></div>
									</td>
									<td class="textCenter">
										<div class="layui-input-inline">
											<select name="leftParenthesis"   data-search="false" data-inputvalue="true" data-value="$!{abBillRuleBillDtlRmkDtlVO.leftParenthesis}">
												<option value=" ">#springMessage('common.placeholder.select')</option>
												#if($!{abBillRuleBillDtlRmkDtlVO.leftParenthesis} =="(")
													<option value="(" selected>(</option>
												#else if
													<option value="(">(</option>
												#end
											</select>
										</div>
									</td>
									<td class="textCenter">
										<div class="bt-biz-dict" data-type="select" data-group="billClaimRule.matchElements"  data-name="matchElements"  data-biz-name="matchElements$row" data-defaultvalue="$!{abBillRuleBillDtlRmkDtlVO.matchElements}" data-callback="onchangeMatchElements"
										></div>
									</td>
									<td class="textCenter">
										<div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchRelations"  data-name="matchRelations"  data-biz-name="matchRelations$row" data-defaultvalue="$!{abBillRuleBillDtlRmkDtlVO.matchRelations}" data-callback="onchangeMatchRelations"
											 #if($!{abBillRuleBillDtlRmkDtlVO.matchElements} != "amt"))
											 data-filterData="5,6,7,8,9,10"
											 #end></div>
									</td>
									<td class="textCenter">
										<input type="text" name="matchContent" id="matchContent$row"  placeholder="#springMessage('table.netbank.nisproject.matchContent')" autocomplete="off" class="layui-input" value="$!{abBillRuleBillDtlRmkDtlVO.matchContent}"
											#if($!{abBillRuleBillDtlRmkDtlVO.matchElements} == "amt"
											&& ($!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "1" || $!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "2"
											|| $!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "3" || $!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "4"))
											   style="display: none;"#end>
										<div class="layui-input-inline" id="number$row"
											#if($!{abBillRuleBillDtlRmkDtlVO.matchElements} != "amt" || ($!{abBillRuleBillDtlRmkDtlVO.matchElements} == "amt"
											&& ($!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "5" || $!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "6"
											|| $!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "7" || $!{abBillRuleBillDtlRmkDtlVO.matchRelations} == "8")))
											 style="display: none;"#end>
											<select  lay-search="" data-inputvalue="true" >
												<option value="1" #if($!{abBillRuleBillDtlRmkDtlVO.matchContent} == "奇数") selected #end>#springMessage('table.number.odd')</option>
												<option value="2" #if($!{abBillRuleBillDtlRmkDtlVO.matchContent} == "偶数") selected #end>#springMessage('table.number.even')</option>
											</select>
										</div>
									</td>
									<td class="textCenter">
										<div class="layui-input-inline">
											<select name="rightParenthesis"   data-search="false" data-inputvalue="true" >
												<option value=" ">#springMessage('common.placeholder.select')</option>
												#if($!{abBillRuleBillDtlRmkDtlVO.rightParenthesis} ==")")
													<option value=")" selected>)</option>
												#else if
													<option value=")">)</option>
												#end
											</select>
										</div>
									</td>
									<td class="textCenter">
										<a href="javascript:void (0)" onclick="deleteDtl(this)">#springMessage("common.button.delete") </a>
									</td>
								</tr>
							#end
						#end
					#else
						<tr>
							<td class="textCenter">
								<input type="hidden" name="matchRule" value=" "/>
							</td>
							<td class="textCenter">
								<div class="layui-input-inline">
									<select name="rightParenthesis"   data-search="false" data-inputvalue="true">
										<option value=" ">#springMessage('common.placeholder.select')</option>
										<option value="(">(</option>
									</select>
								</div>
							</td>
							<td class="textCenter">
								<div class="bt-biz-dict" data-type="select" data-group="billClaimRule.matchElements"  data-name="matchElements"  ></div>
							</td>
							<td class="textCenter">
								<div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchRelations"  data-name="matchRelations"  ></div>
							</td>
							<td class="textCenter">
								<input type="text" name="matchContent" id="matchContent1"  placeholder="#springMessage('table.netbank.nisproject.matchContent')" autocomplete="off" class="layui-input">
								<div class="layui-input-inline" id="number1" style="display: none;">
									<select  lay-search="" data-inputvalue="true" >
										<option value="1">#springMessage('table.number.odd')</option>
										<option value="2">#springMessage('table.number.even')</option>
									</select>
								</div>
							</td>
							<td class="textCenter">
								<div class="layui-input-inline">
									<select name="rightParenthesis"   data-search="false" data-inputvalue="true">
										<option value=" ">#springMessage('common.placeholder.select')</option>
										<option value=")">)</option>
									</select>
								</div>
							</td>
							<td class="textCenter">
								<button class="layui-btn" onclick="addTr();" type="button">#springMessage('common.addTr')</button>
							</td>
						</tr>
					#end
				</table>
			</td>
		</tr>


		</tbody>
	</table>
	<table class="layui-table border0">
		<tbody>
		<tr>
			<td width="30%"></td>
			<td>
				<button class="layui-btn" lay-submit="" lay-filter="save">#springMessage('common.button.submit')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</td>
		</tr>
		</tbody>
	</table>
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/ruleBillDtlRmk.edit.js?_btv=${resourceVersion}"></script>
</html>

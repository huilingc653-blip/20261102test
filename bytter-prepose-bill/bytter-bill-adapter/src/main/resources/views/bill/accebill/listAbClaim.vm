<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        html,body,form,iframe,.layui-tab,.layui-tab-content,.layui-tab-item {
            height: 100%;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post" >
    <div class="layui-tab layui-tab-brief" lay-filter="billExc">
        <ul class="layui-tab-title">
            <li class="layui-this">#springMessage('bill.accebill.waitManualClaim')</li>
            <li>#springMessage('bill.accebill.toBeConfirmed')</li>
            <li>#springMessage('bill.accebill.confirmed')</li>
			
        </ul>
        <div class="layui-tab-content">
            <div class="layui-tab-item layui-show">
                ##待人工认领
                <iframe id="claimIframe" src="" frameborder="0" style="width: 100%;" name="claim" ></iframe>
            </div>
            <div class="layui-tab-item">
                ##待确认
                <iframe id="toBeConfirmedIframe" src="" frameborder="0" style="width: 100%;" name="toBeConfirmed"></iframe>
            </div>
            <div class="layui-tab-item">
                ##已确认
                <iframe id="confirmedIframe" src="" frameborder="0" style="width: 100%;" name="confirmed"></iframe>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abClaim.list.js?_btv=${resourceVersion}"></script>
</html>









<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
		<div class="layui-collapse" lay-filter="collapse">
		<div class="layui-colla-item">
		<h2 class="layui-colla-title"></h2>
		<div class="layui-colla-content layui-show">
		<table class="layui-table">
		<tbody>
        <tr>
            ## 申请单位
            <td width="8%" class="textRight">#springMessage('bill.accebill.applyCorp')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_applyCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:abBillSearchforApply:query"
                         data-callback="applyCorpCallback"
                    >
                    </div>
                </div>
            </td>
            ## 票据单位
            <td  width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="corpId"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="bill:accebill:abBillSearchforApply:query"
                         data-scope="all"
                    >
                    </div>
                </div>
            </td>
            ## 业务单位
            <td  width="8%" class="textRight" >#springMessage('bill.accebill.busCorp')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_busCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:abBillSearchforApply:query"
                    >
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##业务人员
            <td  width="8%" class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_busPersonnel"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
                </div>
            </td>
        <td width="8%" class="textRight">#springMessage('bill.accebill.origNo')</td>
        <td width="25%">
                        <input type="text" name="likes_origNo"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.origNo')">
		</td>
        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
        <td width="25%">
                        <input type="text" name="likes_payer"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payer')">
		</td>
		</tr>
		<tr>
        <td width="8%" class="textRight">#springMessage('bill.accebill.billMoney')</td>
        <td width="25%">
            <input class="layui-input bt-input-inline bt-biz-moneyType" type="text" data-name="geg_billMoney" data-moneyendid="leg_billMoney">
            <span class="date-mid">~</span>
            <input class="layui-input bt-input-inline bt-biz-moneyType" id="leg_billMoney" type="text" data-name="leg_billMoney" >
        </td>
        <td width="8%" class="textRight">#springMessage('bill.accebill.billType')</td>
        <td width="25%">
                        <div class="bt-biz-dict" data-group="AB_BILL_TYPE" data-name="eqs_billTypeName" data-type="select" ></div>
		</td>
        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
        <td width="25%">
                        <input type="text" name="likes_acceptor"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptor')">
		</td>
		</tr>
		<tr>
        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
        <td width="25%">
				<div id="startDate" ></div>
		</td>
        <td width="8%" class="textRight">#springMessage('table.abAccrecords.rcrsType')</td>
        <td width="25%">
                        <div class="bt-biz-dict" data-group="AB_RCRS_TP" data-name="eqs_rcrsTpName" data-type="select" ></div>
		</td>
        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.payee')</td>
        <td width="25%">
                        <input type="text" name="likes_payee"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payee')">
		</td>
		</tr>
		<tr>
        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
        <td width="25%">
				<div id="endDate" ></div>
		</td>
        <td width="8%" class="textRight">#springMessage('table.abAccrecords.status')</td>
        <td width="25%">
                        <div class="bt-biz-dict" data-group="AB_BILL_SEARCHFOR_STATUS" data-name="eqs_statusName" data-type="select" ></div>
		</td>
            ##出票标志
            <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
                </div>
            </td>
		</tr>
        <tr>
            ##票据是否允许分包
            <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND" data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
                </div>
            </td>
            <td width="8%" class="textRight">#springMessage('table.bill.bankType.holderBankType')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                         data-method="get"
                         data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
            <td class="textRight"></td>
            <td width="24%">
                <div class="layui-input-inline">
                </div>
            </td>
        </tr>
		<tr>
            <td colspan="6" style="text-align: center;">
        		#if($shiro.hasPermission("bill:accebill:abBillSearchforApply:query"))
                <div class="layui-inline">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </div>
        		#end
            </td>
        </tr>
		</tbody>
        </table>
		</div>
  		</div>
  		</div>
    </form>
#if($shiro.hasPermission("bill:accebill:abBillSearchforApply:query"))
<form id="dataForm" class="layui-form">
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('bill.accebill.applyCorp')</th>
        <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
        <th>#springMessage('bill.accebill.busCorp')</th>
        <th>#springMessage('bill.accebill.busPersonnel')</th>
        <th>#springMessage('bill.accebill.theBankAcc')</th>
        <th>#springMessage('bill.accebill.origNo')</th>
        <th>#springMessage('bill.accebill.billType')</th>
        <th>#springMessage('bill.accebill.billMoney')</th>
        <th>#springMessage('bill.accebill.searchForMoney')</th>
        <th>#springMessage('table.abVoucherinfo.startDate')</th>
        <th>#springMessage('table.abVoucherinfo.endDate')</th>
        <th>#springMessage('table.abVoucherinfo.payer')</th>
        <th>#springMessage('table.abVoucherinfo.acceptor')</th>
        <th>#springMessage('table.abVoucherinfo.payee')</th>
        <th>#springMessage('table.abAccrecords.cnAccrecords')</th>
        <th>#springMessage('table.abAccrecords.rcrsType')</th>
        <th>#springMessage('table.abAccrecords.status')</th>
        <th>#springMessage('table.abVoucherinfo.Business.Brief.Id')</th>
        <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
        <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
<table class="layui-table">
<tbody>
<tr>
<td width="8%" class="textRight"><span style="color:red;display:none" id="rcrsrsncdSpan">*</span>#springMessage('table.abAccrecords.rcrsrsncd')</td>
<td width="25%">
	<div class="bt-biz-dict" data-group="AB_RCRSRSNCD" data-name="rcrsrsncd" data-biz-name="rcrsrsncd" data-type="select" data-required="true" ></div>
</td>
<td width="8%" class="textRight"><span style="color:red">*</span>#springMessage('bill.accebill.bSearchForPersonName')</td>
<td width="25%">
	<div class="layui-inline">
		<input type="text" id="recNm" autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="60"
			placeholder="#springMessage('bill.accebill.bSearchForPersonName')">
    </div>
	<div class="layui-input-inline">
		<button class="layui-btn bt-biz-externalCorpBankAcc" type="button" data-callback="bt.bailCorpCallback">#springMessage('common.button.external')</button>
		<button class="layui-btn bt-biz-bankInfo" type="button" data-callback="bt.bailBankInfoCallback">#springMessage('common.button.bank')</button>
    </div>
</td>
<td width="8%" class="textRight"><span style="color:red">*</span>#springMessage('bill.accebill.bSearchForPersonCmonid')</td>
<td width="25%">
    ## 被追索人机构号
	<div class="layui-inline">
		<input type="text" id="recCmonid" autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="30"
			placeholder="#springMessage('bill.accebill.bSearchForPersonCmonid')">
    </div>
</td>
</tr>
<tr>
<td width="8%" class="textRight"><span style="color:red">*</span>#springMessage('bill.accebill.bSearchForPersonAcc')</td>
<td width="25%">
    <div class="layui-inline">
		<input type="text" id="recAcctId" autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="30"
			placeholder="#springMessage('bill.accebill.bSearchForPersonAcc')">
    </div>
</td>
<td width="8%" class="textRight"><span style="color:red">*</span>#springMessage('bill.accebill.bSearchForPersonBank')</td>
<td width="25%">
	<div class="layui-inline">
		<input type="text" id="recAcctsvcr" autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="12"
			placeholder="#springMessage('table.btBankAcc.bankCode')">
		<div class="bt-div-search">
			<button class="bt-biz-bankInfo" type="button" data-callback="bt.bankinfoCallback"><i class="layui-icon">&#xe615;</i></button>
		</div>
    </div>
    <div class="layui-inline">
		<input type="text" id="recAcctsvcrName" autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="100"
			placeholder="#springMessage('table.btBankAcc.bankName')">
    </div>

</td>
<td width="8%" class="textRight">#springMessage('table.abAccrecords.rmk')</td>
<td width="25%">
    <div class="layui-inline">
		<input type="text" id="rmk" autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="100"
			placeholder="#springMessage('table.abAccrecords.rmk')">
    </div>
</td>
</tr>
</tbody>
</table>
</form>
#end
#parse("views/common/footer.vm")
#caDataHidden()
#caDataScript()
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillSearchforApply.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>

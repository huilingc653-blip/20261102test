<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
     ## 只显示有效的规则
    <input hidden name="eqs_validSign" value="1">
    <table class="layui-table">
        <tr>
            ## 选票规则编码
            <td class="textRight">#springMessage('bill.intellect.rule.ruleCode')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="likes_ruleCode">
                </div>
            </td>
            ## 选票规则名称
            <td class="textRight">#springMessage('bill.intellect.rule.ruleName')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="likes_ruleName">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <div style="width: 100%;text-align: center">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </div>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table">
    <thead>
    <tr>
        <th>#springMessage('bill.intellect.rule.ruleCode')</th>
        <th>#springMessage('bill.intellect.rule.ruleName')</th>
        <th>#springMessage('bisAccAttribute.rmk')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    var datatable;
    bt.use(['form','element', 'datatable'], function () {
        $ = bt.jquery, form = bt.form();

        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            colReorder: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ignoreButtons: ['colvis', 'output', 'print', 'state'],
            checkbox: true,
            mulselect: true,
            ajax: {
                'url': basePath + "/bill/intellect/rule/datatable"
            }
            , columns: [
                {data: "ruleCode"},
                {data: "ruleName"},
                {data: "rmk"},
                {
                    data: null, className: "center", render: function (data, type, full, meta) {
                        return '<a class="" href="#" data-row="' + meta.row + '" onclick="view(\'' + data.id + '\')">' + bt.lang("common.button.view") + '</a>';
                    }
                }
            ]
        });
    });

    /**
     * 返回选中数据
     * @returns {*}
     */
    function getSelectData() {
        return bt.datatable.getSelectData();
    }

    /**
     * 选票规则详情页
     */
    function view(id) {
        if (bt.navtab){
            bt.navtab.addNavtab(bt.lang("common.button.view"), basePath + "/bill/intellect/rule/view/" + id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ["850px", "530px"],
            maxmin: true,
            content: basePath + "/bill/intellect/rule/view/" + id,
            end: function () {
                table && table.draw();
            }
        });
    }

</script>
</html>
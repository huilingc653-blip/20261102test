<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" value="$!{element.id}" name="id">
    <table class="layui-table">
        <tr>
            <td style="width: 20%" class="textRight">
                #springMessage('选票要素编码')
            </td>
            <td style="width: 30%">
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="elementCode" value="$!{element.elementCode}" disabled>
                </div>
            </td>
            <td style="width: 20%" class="textRight">
                #springMessage('选票要素名称')
            </td>
            <td style="width: 30%">
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="elementName" value="$!{element.elementName}" disabled>
                </div>
            </td>
        </tr>

        <tr id="sourceTypeTr">
            <td class="textRight">
                #springMessage('来源类型')
            </td>
            <td>
                <div class="layui-inline" id="sourceType1">
                    <div class="bt-biz-dict" data-type="select" data-value="$!{element.sourceType}"
                         data-callback="sourceTypeCallBack" data-disabled="true"
                         data-group="bill.intellect.element.sourceType"
                         data-name="sourceType" data-biz-name="sourceType">
                    </div>
                </div>
            </td>
            <td class="textRight dictTd">
                #if($!{element.sourceType} == "1")
                #springMessage('字典组')
                #elseif($!{element.sourceType} == "2")
                    #springMessage('来源名称')
                #elseif($!{element.sourceType} == "3")
                    #springMessage('计算方式')
                #elseif($!{element.sourceType} == "4")
                    #springMessage('系统常量')
                #end
            </td>
            <td class="dictTd">
                #if($!{element.sourceType} == "1")
                    <div class="layui-inline dict">
                        <div class="layui-input-inline">
                            <input type="text" class="layui-input" id="dictGroupName" value="$!{element.dictGroupName}" disabled>
                            <input type="hidden" class="layui-input" id="dictGroup" value="$!{element.dictGroup}" name="dictGroup">
                        </div>
##                        <div class="layui-input-inline">
##                            <button type="button" onclick="selectDictGoup()" class="layui-btn">选择</button>
##                        </div>
                    </div>
                #elseif($!{element.sourceType} == "2")
                    <div class="layui-inline field">
                        <input type="text" class="layui-input" name="sourceName" value="$!{element.sourceName}" disabled>
                    </div>
                #elseif($!{element.sourceType} == "3")
                    <div class="layui-inline computeMode">
                        <div class="bt-biz-dict" data-type="select" data-disabled="true" data-value="$!{element.computeMode}"
                             data-group="bill.intellect.element.computeMode" data-callback="computeModeCallBack"
                             data-name="computeMode" data-biz-name="computeMode">
                        </div>
                    </div>
                #elseif($!{element.sourceType} == "4")
                    <div class="bt-biz-dict" data-type="select" data-disabled="true"
                         data-group="bill.intellect.element.sysConstant" data-defaultvalue="$!{element.sysConstant}"
                         data-name="sysConstant" data-biz-name="sysConstant">
                    </div>
                #end
            </td>
        </tr>
        #if($!{element.sourceType} == "2")
            <tr class="field">
                <td class="textRight">
                    #springMessage('表名')
                </td>
                <td>
                    <div class="layui-inline">
                        <input type="text" class="layui-input" name="tableName" value="$!{element.tableName}" disabled>
                    </div>
                </td>
                <td class="textRight">
                    #springMessage('字段名')
                </td>
                <td>
                    <div class="layui-inline">
                        <input type="text" class="layui-input" value="$!{element.fieldName}" name="fieldName" disabled>
                    </div>
                </td>
            </tr>
        #elseif($!{element.sourceType} == "3")
            <tr class="computeMode">
                #if($!{element.computeMode} == "add" || $!{element.computeMode} == "sub")
                    #if($!{element.computeMode} == "add")
                        <td class="textRight">
                            #springMessage('来源要素名称(加数)')
                        </td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="sourceElementName1" data-biz-name="sourceElementName1"
                                     data-value="$!{element.sourceElementName1}" data-filterData="$!{element.id}"
                                     data-url="$basePath/bill/intellect/element/listElement\" data-method="post" data-disabled="true"
                                     data-valuefield="id" data-textfield="elementName"></div>
                            </div>
                        </td>
                        <td class="textRight">
                            #springMessage('来源要素名称(加数)')
                        </td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="sourceElementName2" data-biz-name="sourceElementName2"
                                     data-value="$!{element.sourceElementName2}" data-filterData="$!{element.id}"
                                     data-url="$basePath/bill/intellect/element/listElement\" data-method="post" data-disabled="true"
                                     data-valuefield="id" data-textfield="elementName"></div>
                            </div>
                        </td>
                    #else
                        <td class="textRight">
                            #springMessage('来源要素名称(减数)')
                        </td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="sourceElementName1" data-biz-name="sourceElementName1"
                                     data-value="$!{element.sourceElementName1}" data-filterData="$!{element.id}"
                                     data-url="$basePath/bill/intellect/element/listElement\" data-method="post" data-disabled="true"
                                     data-valuefield="id" data-textfield="elementName"></div>
                            </div>
                        </td>
                        <td class="textRight">
                            #springMessage('来源要素名称(被减数)')
                        </td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-name="sourceElementName2" data-biz-name="sourceElementName2"
                                     data-value="$!{element.sourceElementName2}" data-filterData="$!{element.id}"
                                     data-url="$basePath/bill/intellect/element/listElement\" data-method="post" data-disabled="true"
                                     data-valuefield="id" data-textfield="elementName"></div>
                            </div>
                        </td>
                    #end
                #else
                    <td class="textRight">
                        #springMessage('来源要素名称')
                    </td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" data-name="sourceElementName1" data-biz-name="sourceElementName1"
                                 data-value="$!{element.sourceElementName1}" data-filterData="$!{element.id}"
                                 data-url="$basePath/bill/intellect/element/listElement\" data-method="post" data-disabled="true"
                                 data-valuefield="id" data-textfield="elementName"></div>
                        </div>
                    </td>
                    <td class="textRight"></td>
                    <td></td>
                #end
            </tr>
        #end

        <tr>
            <td class="textRight">#springMessage('备注')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="rmk" disabled value="$!{element.rmk}">
                </div>
            </td>
            <td class="textRight"></td>
            <td>
                <div class="layui-inline">

                </div>
            </td>
        </tr>

        <tr>
            <td class="textRight">#springMessage('数据类型')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-disabled="true"
                         data-group="bill.intellect.element.dataType" data-value="$!{element.dataType}"
                         data-name="dataType" data-biz-name="dataType">
                    </div>
                </div>
            </td>
            <td class="textRight">#springMessage('有效标志')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="radio" data-defaultvalue="1" data-group="sf_yn" data-disabled="true" data-value="$!{element.validSign}" data-name="validSign" data-biz-name="validSign">
                    </div>
                </div>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/intellect/element/element.view.js?_btv=${resourceVersion}"></script>
</html>
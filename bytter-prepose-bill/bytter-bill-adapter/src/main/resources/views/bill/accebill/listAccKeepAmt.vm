<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ## 单位
            <td class="textRight">#springMessage('单位')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-tree-type="check"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-scope="all"
                         data-biz-name="corpId"
                         data-resource="bill:accebill:accKeepAmt:controls"
                         data-defaultvalue=""></div>
                </div>
            </td>

            ## 状态
            <td class="textRight">银行类型</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                         data-method="get"
                         data-valuefield="id" data-textfield="typeName" data-name="ins_bankType"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>

            ## 银行账号
            <td class="textRight">银行账号</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_bankAcc"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('银行账号')">
                </div>
            </td>

            ## 状态
            <td class="textRight">状态</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="status_yn"  data-name="eqs_status" ></div>
            </td>

        </tr>
        <tr>
            <td colspan="8" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('单位名称')</th>
        <th>#springMessage('银行账号')</th>
        <th>#springMessage('银行类型')</th>
        <th>#springMessage('开户行')</th>
        <th>#springMessage('留底金额')</th>
        <th>#springMessage('状态')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/accKeepAmt.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="customPrintVal" >
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                    ##所属单位
                        <td width="13%" class="textRight">#springMessage('bill.accebill.corpId')</td>
                        <td width="20%">
                            <div class="layui-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_corpId"
                                     data-placeholder="#springMessage('table.abVoucherinfoVice.corpId')"
                                     data-scope="all"
                                     data-resource="bill:accebill:corpbal:query:corpop"
                                >
                                </div>
                            </div>
                        </td>
						##余额日期
                        <td width="13%" class="textRight">#springMessage('table.abBillAccBal.balDate')</td>
                        <td width="20%">
                            <div class="layui-input-inline">
                                <input type="text" name="ged_balDate" class="layui-input bt-input-inline  bt-biz-dateType" id="start_balDate" data-endid="end_balDate" placeholder="#springMessage('table.abBillAccBal.balDate')" />
                                <span class="date-mid">~</span>
                                <input type="text" name="led_balDate" class="layui-input bt-input-inline  bt-biz-dateType" id="end_balDate" placeholder="#springMessage('table.abBillAccBal.balDate')" data-today="true"/>
                            </div>
                        </td>
                        <td width="13%"></td>
                        <td width="20%"></td>
                    </tr>
                    <tr>
                    ##余额
                        <td class="textRight" width="8%">#springMessage('table.abBillAccBal.bal')</td>
                        <td >
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text" data-name="geg_bal"
                                   data-moneyendid="leg_bal" placeholder="#springMessage('table.abBillAccBal.bal')" data-minus="true"/>
                            <span class="date-mid">~</span>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_bal" type="text"
                                   data-name="leg_bal" placeholder="#springMessage('table.abBillAccBal.bal')" data-minus="true"/>
                        </td>
                    ##可用余额
                        <td class="textRight">#springMessage('table.abBillAccBal.availBal')</td>
                        <td >
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text"
                                   data-name="geg_availBal"
                                   data-moneyendid="leg_availBal"
                                   placeholder="#springMessage('table.abBillAccBal.availBal')" data-minus="true"/>
                            <span class="date-mid">~</span>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_availBal" type="text"
                                   data-name="leg_availBal"
                                   placeholder="#springMessage('table.abBillAccBal.availBal')" data-minus="true"/>
                        </td>
                    ##占用余额
                        <td class="textRight">#springMessage('table.abBillAccBal.tiedupBal')</td>
                        <td >
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text"
                                   data-name="geg_tiedupBal"
                                   data-moneyendid="leg_tiedupBal"
                                   placeholder="#springMessage('table.abBillAccBal.tiedupBal')" data-minus="true"/>
                            <span class="date-mid">~</span>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_tiedupBal" type="text"
                                   data-name="leg_tiedupBal"
                                   placeholder="#springMessage('table.abBillAccBal.tiedupBal')" data-minus="true"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            #if($shiro.hasPermission("bill:accebill:accbal:query:corpop"))
                                <div class="layui-inline">
                                    <button class="layui-btn" lay-submit lay-filter="search">
                                        #springMessage('common.button.search')
                                    </button>
                                    <button type="reset" class="layui-btn layui-btn-primary" onclick="setReset()">
                                        #springMessage('common.button.reset')
                                    </button>
                                </div>
                            #end
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead id="theadId" >
    <tr>
        <th rowspan="2">#springMessage('bill.accebill.corpId')</th>
        <th rowspan="2">#springMessage('table.abBillAccBal.curId')</th>
        <th rowspan="2">#springMessage('table.abBillAccBal.balDate')</th>
        <th colspan="3">#springMessage('bill.accebill.merchbill')</th>
        <th colspan="3">#springMessage('bill.accebill.bankbill')</th>
        <th colspan="3">#springMessage('table.datatable.total')</th>
    </tr>
    <tr>
        <th>#springMessage('table.abBillAccBal.bal')</th>
        <th>#springMessage('table.abBillAccBal.availBal')</th>
        <th>#springMessage('table.abBillAccBal.tiedupBal')</th>
        <th>#springMessage('table.abBillAccBal.bal')</th>
        <th>#springMessage('table.abBillAccBal.availBal')</th>
        <th>#springMessage('table.abBillAccBal.tiedupBal')</th>
        <th>#springMessage('table.abBillAccBal.bal')</th>
        <th>#springMessage('table.abBillAccBal.availBal')</th>
        <th>#springMessage('table.abBillAccBal.tiedupBal')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillCorpBal.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>

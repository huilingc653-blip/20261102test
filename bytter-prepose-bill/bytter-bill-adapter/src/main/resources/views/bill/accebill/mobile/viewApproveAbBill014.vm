#* 
*014背书请求应答
*#
	<li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.endorseinfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.banendrsmtmk')
            <span class="mui-badge mui-badge-inverted">
    			$!{info.bankendrSmtmkName}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			是否同意背书
			<span class="mui-badge mui-badge-inverted">
				#if($!{info.isEndorse}=="1")同意#else拒绝#end
			</span>
		</li>
		<li class="mui-table-view-cell">
			#springMessage('table.abAccrecords.applyDate')
            <span class="mui-badge mui-badge-inverted">
    			$!date.format('yyyy-MM-dd',$!{info.applyDate})
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abAccrecords.businessDate')
            <span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!{info.businessDate})
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.endorsorRmk')
			<span class="mui-badge mui-badge-inverted">
				$!{info.rmk}
			</span>
		</li>
        </ul>
    </li>
	<li class="mui-table-view-cell mui-collapse">
		<a class="mui-navigate-right" href="#">#springMessage('bill.accebill.endorsorinfo.title')</a>
		<ul class="mui-table-view H-theme-background-color-white">
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.role')
				<span class="mui-badge mui-badge-inverted">
					$!{info.reqRoleName}
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.name')
				<span class="mui-badge mui-badge-inverted">
					$!{info.reqNm}
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.cmonid')
				<span class="mui-badge mui-badge-inverted">
					$!{info.reqCmonid}
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.bankacc')
				<span class="mui-badge mui-badge-inverted">
					$!{info.reqAcctId}
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.bankno')
				<span class="mui-badge mui-badge-inverted">
					$!{info.reqAcctsvcr}
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.acctsvcrAg')
				<span class="mui-badge mui-badge-inverted">
					$!{info.reqAcctsvcrAg}
				</span>
			</li>
		</ul>
	</li>
	<li class="mui-table-view-cell mui-collapse">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.endorseeinfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
    	<li class="mui-table-view-cell">
			#springMessage('bill.accebill.name')
            <span class="mui-badge mui-badge-inverted">
    			$!{info.recNm}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.bankacc')
            <span class="mui-badge mui-badge-inverted">
    			$!{info.recAcctId}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.bankno')
            <span class="mui-badge mui-badge-inverted">
    			$!{info.recAcctsvcr}
    		</span>
        </li>
        </ul>
    </li>

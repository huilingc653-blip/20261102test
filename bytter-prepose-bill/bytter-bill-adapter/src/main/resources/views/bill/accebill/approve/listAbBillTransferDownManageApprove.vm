<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
		<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
        <table class="layui-table">
            <tbody>
                <tr>
					##下拨中心
					<td class="textRight">#springMessage('bill.accebill.transferdownmanage.corpCenter')</td>
					<td width="25%">
						<div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 ##此处data-name提交有问题，提交名称见netId input，如果重置了，则后台取此处的值
                                 data-name="eqs_recordCorpId"
                                 data-biz-type="net"
                                 data-type="selectTree"
                                 data-callbackData="netCallback"
                                 data-defaultvalue="$!{netId}"
                                 data-resource="sys:flow:query:corpop"
                                 data-scope="net">
                            </div>
                        </div>
                    </td>
                    ##申请单位/收票单位
					<td class="textRight">#springMessage('table.abBillTransfer.applyCorp')/#springMessage('table.abBillTransfer.recevieCorpId')</td>
					<td width="25%">
						<div class="layui-input-inline">
							<div id="corpId"></div>
                        </div>
                    </td>
                    ##下拨金额
                    <td class="textRight">#springMessage('table.abBillTransfer.downMoney')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="geg_allocationMoney" data-moneyendid="endMoney"
                                   autocomplete="off" class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                            <span class="date-mid">~</span>
                            <input type="text" name="leg_allocationMoney" id="endMoney"
                                   autocomplete="off" class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
            </tbody>
        </table>
    </form>
    
    <table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
        <thead>
        <tr>
            <th>#springMessage('table.abBillTransfer.allocatedCode.down')</th>
    		<th>#springMessage('table.abBillTransfer.allocatedCode.apply')</th>
    		<th>#springMessage('table.abBillTransfer.recordCorpId')</th>
    		<th>#springMessage('table.abBillTransfer.recevieCorpId')</th>
    		#*<th>#springMessage('table.abBillTransfer.billNo')</th>*#
    		<th>#springMessage('table.abBillTransfer.recevieBankAcc')</th>
    		<th>#springMessage('table.abBillTransfer.applyMoney')</th>
    		<th>#springMessage('table.abBillTransfer.downMoney')</th>
    		<th>#springMessage('table.abBillTransfer.applyReason')</th>
    		<th>#springMessage('table.abBillTransfer.downReason')</th>
    		#*<th>#springMessage('table.abBillTransfer.status')</th>*#
    		<th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
	#workFlowHtml()
    #parse("views/common/footer.vm")
	#workFlowScript()
<script src="${basePath}/static/modules/bill/accebill/approve/abilltransferdownmanageApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

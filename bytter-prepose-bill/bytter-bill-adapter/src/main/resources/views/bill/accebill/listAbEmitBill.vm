<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="payImport" name="payImport" value="$!{payImport}">
    <input type="hidden" id="payOrigNo" name="payImportOrigNo" value="">
    <div class="layui-collapse" lay-filter="collapse">
    <div class="layui-colla-item">
    <h2 class="layui-colla-title"></h2>
    <div class="layui-colla-content layui-show">
    <table class="layui-table">
        <tbody>
        <tr>
            ## 申请单位
            <td class="textRight" width="8%">#springMessage('bill.accebill.applyCorp')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_applyCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:abemitbill:query"
                         data-callback="applyCorpCallback"
                    >
                    </div>
                </div>
            </td>
            ## 票据单位
            <td class="textRight" width="8%">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="corpId"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="bill:accebill:abemitbill:query"
                         data-scope="all"
                    >
                    </div>
                </div>
            </td>
            ## 业务单位
            <td class="textRight" width="8%">#springMessage('bill.accebill.busCorp')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_busCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:abemitbill:query"
                        ##data-callback="corpCallback"
                    >
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##业务人员
            <td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_busPersonnel"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
                </div>
            </td>
        ##票据号码
            <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_origNo"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
                </div>
            </td>
        ##票据类型
            <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE" data-name="eqs_billTypeName"></div>
            </td>
        </tr>
        <tr>
        ##流通介质
            <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_FLAG" data-name="eqs_billFlagName"></div>
            </td>
        ##票据金额
            <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_billMoney" data-moneyendid="endMoney" autocomplete="off"
                           class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_billMoney" id="endMoney" autocomplete="off"
                           class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                </div>
            </td>
        ##开出方式
            <td class="textRight">#springMessage('table.abVoucherinfoVo.openWay')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_OPENWAY" data-name="eqs_insideSingName"></div>
            </td>
        </tr>

        <tr>
        ##承兑人
            <td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" name="likes_acceptor"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptor')">
                </div>
            </td>
        ##出票日期
            <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
            <td >
                <div class="layui-inline">
                <input type="text" name="ged_startDate" data-name="ged_startDate" class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date">
                </div>
                ~
                <div class="layui-inline">
                <input type="text" name="led_startDate"　data-name="led_startDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date">
                </div>
            </td>
        ##出票人
            <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" name="likes_payer"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payer')">
                </div>
            </td>
        </tr>
        <tr>
        ##收票人全称
            <td class="textRight">#springMessage('table.abVoucherinfo.payee')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" name="likes_payee"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payee')">
                </div>
            </td>
        ##到期日期
            <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
            <td >
                <div class="layui-inline">
                <input type="text" name="ged_endDate" data-name="ged_endDate" class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                </div>
                ~
                <div class="layui-inline">
                <input type="text" name="led_endDate"　data-name="led_endDate" class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                </div>
            </td>
        ##业务处理状态
            <td class="textRight">#springMessage('table.abAccrecords.status')</td>
            <td >
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_EMITBILL_STATUS" data-name="eqs_statusName" data-filterData="-2"></div>
            </td>
        </tr>
        <tr>
            ##开票申请单号
            <td class="textRight">#springMessage('table.abVoucherinfoVice.appNo')</td>
            <td >
                <input type="text" class="layui-input" name="likes_appNo">
            </td>
        ##开票数据来源
            <td class="textRight">#springMessage('table.abVoucherinfo.source')</td>
            <td >
                <div class="bt-biz-dict" data-type="select" data-group="AB_EMITBILL_SOURCE" data-name="eqs_sourceName" ></div>
            </td>
        ##在线离线标志
            <td class="textRight">#springMessage('bill.accebill.billSendSign')</td>
            <td >
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_SEND_SIGN" data-name="eqs_sendSign" ></div>
            </td>
        </tr>
        <tr>
            ##开票批次号
            <td class="textRight">#springMessage('bill.accebill.batchNo')</td>
            <td >
                <input type="text" class="layui-input" name="likes_batchNo">
            </td>
            ##开票方式
            <td class="textRight">#springMessage('bill.accebill.emitType')</td>
            <td>
                <div class="bt-biz-dict" data-type="mulselect" id="emitType" data-group="ACCEBILL_EMIT_TYPE" data-name="ins_emitTypeName" data-biz-name="emitType">
                </div>
            </td>
            ##承兑协议编号
            <td class="textRight">#springMessage('table.abVoucherinfo.accptncagrmtnb')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_accptncagrmtnb"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.accptncagrmtnb')">
                </div>
            </td>
        </tr>

        <tr>
            ##出票标志
            <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
                </div>
            </td>
            ##票据是否允许分包
            <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND" data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
                </div>
            </td>
            <td width="8%" class="textRight">#springMessage('table.bill.bankType.payerBankType')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                         data-method="get"
                         data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##保证金比例
            <td class="textRight">#springMessage('table.abVoucherinfoVice.bailPercent')(%)</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_bailpercent" data-biz-name="geg_bailpercent" autocomplete="off" data-decimal="2" data-min="0" data-max="100"  data-callback="compareBailpercent"
                           class="layui-input bt-input-inline  bt-biz-rateType" placeholder="#springMessage('table.abVoucherinfoVice.bailPercent')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_bailpercent" data-biz-name="leg_bailpercent" autocomplete="off" data-decimal="2" data-min="0" data-max="100" data-callback="compareBailpercent"
                           class="layui-input bt-input-inline  bt-biz-rateType" placeholder="#springMessage('table.abVoucherinfoVice.bailPercent')">
                </div>
            </td>
            ##保证金利率
            <td class="textRight">#springMessage('table.abVoucherinfoVice.bailRate')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_bailrate" data-biz-name="geg_bailrate" autocomplete="off"  data-decimal="2" data-min="0" data-max="100"  data-callback="compareBailrate"
                           class="layui-input bt-input-inline  bt-biz-rateType" placeholder="#springMessage('table.abVoucherinfoVice.bailRate')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_bailrate" data-biz-name="leg_bailrate" autocomplete="off" data-decimal="2"  data-min="0" data-max="100" data-callback="compareBailrate"
                           class="layui-input bt-input-inline  bt-biz-rateType" placeholder="#springMessage('table.abVoucherinfoVice.bailRate')">
                </div>
            </td>
            ##授信合同编码
            <td class="textRight">#springMessage('table.abVoucherinfoVice.ratContractCode')</td>
            <td >
                <input type="text" class="layui-input" name="likes_contractNo">
            </td>
        </tr>
        <tr>
            ##保证金账户
            <td class="textRight">#springMessage('table.abVoucherinfoVice.bailAcc')</td>
            <td >
                <input type="text" class="layui-input" name="likes_bailAcc">
            </td>
            ##票据单位账号
            <td class="textRight">#springMessage('table.abVoucherinfoVice.bankAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="bankAcc" name="likes_bankAcc"
                           autocomplete="off" class="layui-input bt-biz-accountTable" data-biz-name="bankAcc" data-name="bankAcc" data-callback="bankAccCallBack" placeholder="#springMessage('table.abVoucherinfoVice.bankAcc')">
                </div>
            </td>
            ##备注
            <td class="textRight">#springMessage('table.abAccrecords.rmk')</td>
            <td >
                <input type="text" name="likes_rmk"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.abAccrecords.rmk')">
            </td>
        </tr>
            #if($shiro.hasPermission("bill:accebill:abemitbill:query"))
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            #end
        </tbody>
    </table>
    </div>
    </div>
    </div>
</form>

    #if($shiro.hasPermission("bill:accebill:abemitbill:query"))
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.abVoucherinfoVice.appNo')</th>
            <th>#springMessage('bill.accebill.batchNo')</th>
            <th>#springMessage('table.abVoucherinfo.billType')</th>
            <th>#springMessage('table.abVoucherinfo.billFlag')</th>
            <th>#springMessage('table.abVoucherinfoVo.openWay')</th>
            <th>#springMessage('bill.accebill.emitType')</th>
            <th>#springMessage('bill.accebill.applyCorp')</th>
            <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
            <th>#springMessage('table.abVoucherinfoVice.bankAcc')</th>
            <th>#springMessage('bill.accebill.busCorp')</th>
            <th>#springMessage('bill.accebill.busPersonnel')</th>
            <th>#springMessage('table.abVoucherinfo.payer')</th>
            <th>出票人开户行号</th>
            <th>出票人开户银行</th>
            <th>#springMessage('table.abVoucherinfo.acceptor')</th>
            <th>承兑人行号</th>
            <th>#springMessage('bill.accebill.emitGuandisSign')</th>
            <th>#springMessage('table.abVoucherinfo.origNo')</th>
            <th>#springMessage('table.abVoucherinfo.billMoney')</th>
            <th>#springMessage('table.abVoucherinfo.startDate')</th>
            <th>#springMessage('table.abVoucherinfo.endDate')</th>
            <th>#springMessage('table.abVoucherinfo.payee')</th>
            <th>#springMessage('table.abVoucherinfo.payeeacc')</th>
            <th>#springMessage('table.abVoucherinfo.payeeBankName')</th>
            <th>#springMessage('table.abVoucherinfo.source')</th>
            <th>#springMessage('bill.accebill.billSendSign')</th>
            <th>#springMessage('table.abAccrecords.status')</th>
            <th>#springMessage('bill.accebill.isEnsure')</th>
            <th>#springMessage('table.nisBillhead.billNo')</th>
            <th>#springMessage('bill.accebill.attachment')</th>

            <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
            <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
            <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>
            <th>#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')</th>
            #*<th>承兑人#springMessage('table.externalCorp.accIdentificationType')</th>
            <th>收票人#springMessage('table.externalCorp.accIdentificationType')</th>*#
            <th>#springMessage('table.abVoucherinfoVice.bailPercent')</th>
            <th>#springMessage('table.fcBond.bondmoney')</th>
            <th>#springMessage('table.abVoucherinfoVice.bailRate')</th>
            <th>#springMessage('table.abVoucherinfoVice.bailAcc')</th>
            <th>#springMessage('table.abVoucherinfoVice.ratContractCode')</th>
            <th>#springMessage('table.ratBkrationDetail.itemCode')</th>
            <th>#springMessage('table.abVoucherinfoVice.isOpenSign')</th>
            <th>#springMessage('table.abAccrecords.rmk')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #end


<form class="layui-form" id="dataForm">
    <table class="layui-table">
        <tbody>
        <tr>
            <td width="8%" class="textRight">
                #springMessage('abemitbill.delete.reason')
            </td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="reason" name="reason" lay-verify="strlength" data-maxlength="150"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('abemitbill.delete.reason')">
                </div>
                <span style="color:red">
                    ##注意:应付款生成的暂存票据需要编辑后才能提交
                    (#springMessage('bill.accebill.abemitbill.messageinfo'))
                </span>
            </td>
        </tr>
        </tbody>
    </table>
    <br>
</form>

#parse("views/common/footer.vm")
#caDataHidden()
#caDataScript()
</body>
<script src="${basePath}/static/modules/sys/blackWhite/blackWhiteBase.check.js?_btv=${resourceVersion}"></script>

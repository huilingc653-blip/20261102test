<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
	<style>
		body{
			font-size:14px;
			padding-bottom: 60px;
		}
		.layui-form-label{
			width: 180px;
		}
		.layui-input-block{
			margin-left: 220px;
		}
	</style>
</head>
<body>

<form class="layui-form" action="">
	<div class="layui-collapse">
		<div class="layui-colla-item">
			<!-- 面板标题 -->
			<h2 class="layui-colla-title">#springMessage('config.claimParam.title')</h2>
			<div class="layui-colla-content layui-show">
				<table class="layui-table breakRow">
					<thead>
					<tr>
						<td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
						<td width="80%">#springMessage('config.fbs.paramValue')</td>
					</tr>
					</thead>
					<tbody>
					<tr>
						<td width="20%" class="textRight">#springMessage('config.accebill.ruleBillNo')</td>
						<td width="80%">
							<div class="layui-input-inline">
								<div class="bt-biz-dict"
									 data-type="radio"
									#if(!$!{config.accebill.ruleBillNo})
									 data-defaultvalue="0"
									#else
									 data-defaultvalue="$!{config.accebill.ruleBillNo}"
									#end
									 data-name="accebill.ruleBillNo"
									 data-biz-name="ruleBillNo"
									 data-group="claim_param"></div>
							</div>
						</td>
					</tr>
					<tr>
						<td width="20%" class="textRight">#springMessage('config.accebill.sameDateMoneyAcc')</td>
						<td width="80%">
							<div class="layui-input-inline">
								<div class="bt-biz-dict"
									 data-type="radio"
									#if(!$!{config.accebill.sameDateMoneyAcc})
									 data-defaultvalue="0"
									#else
									 data-defaultvalue="$!{config.accebill.sameDateMoneyAcc}"
									#end
									 data-name="accebill.sameDateMoneyAcc"
									 data-biz-name="sameDateMoneyAcc"
									 data-group="claim_param"></div>
							</div>
						</td>
					</tr>
					<tr>
						<td width="20%" class="textRight">#springMessage('config.accebill.sameDateMoney')</td>
						<td width="80%">
							<div class="layui-input-inline">
								<div class="bt-biz-dict"
									 data-type="radio"
									#if(!$!{config.accebill.sameDateMoney})
									 data-defaultvalue="0"
									#else
									 data-defaultvalue="$!{config.accebill.sameDateMoney}"
									#end
									 data-name="accebill.sameDateMoney"
									 data-biz-name="sameDateMoney"
									 data-group="claim_param"></div>
							</div>
						</td>
					</tr>
					<tr>
						<td width="20%" class="textRight">#springMessage('config.accebill.sameDateAcc')</td>
						<td width="80%">
							<div class="layui-input-inline">
								<div class="bt-biz-dict"
									 data-type="radio"
									#if(!$!{config.accebill.sameDateAcc})
									 data-defaultvalue="0"
									#else
									 data-defaultvalue="$!{config.accebill.sameDateAcc}"
									#end
									 data-name="accebill.sameDateAcc"
									 data-biz-name="sameDateAcc"
									 data-group="claim_param"></div>
							</div>
						</td>
					</tr>
					<tr>
						<td width="20%" class="textRight">#springMessage('config.accebill.sameMoneyAcc')</td>
						<td width="80%">
							<div class="layui-input-inline">
								<div class="bt-biz-dict"
									 data-type="radio"
									 #if(!$!{config.accebill.sameMoneyAcc})
									 data-defaultvalue="0"
									 #else
									 data-defaultvalue="$!{config.accebill.sameMoneyAcc}"
									 #end
									 data-name="accebill.sameMoneyAcc"
									 data-biz-name="sameMoneyAcc"
									 data-group="claim_param"></div>
							</div>
						</td>
					</tr>
					<tr>
						<td class="textRight">#springMessage('config.accebill.claimStartDate')</td>
						<td>
							<div class="layui-inline">
								<input type="text" id="claimStartDate" name="accebill.claimStartDate" data-biz-name="claimStartDate" class="layui-input bt-biz-dateType"
									   #if(!$!{config.accebill.claimStartDate} || $!{config.accebill.claimStartDate} == '') value="1999-01-01"
									   #else value="$!{config.accebill.claimStartDate}" #end
									   data-type="date" data-max="$!{dataToday}">
							</div>
							<span style="font-size:12px; color:#ff0000">#springMessage('config.accebill.claimStartDate.desc')</span>
						</td>
					</tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>
	<table class="layui-table border0">
		<tbody>
		<tr>
			<td width="20%"></td>
			<td>
				<button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</td>
		</tr>
		</tbody>
	</table>
</form>
	#parse("views/common/footer.vm")
<script>
	var form ={};
	var dicts={};
	var date;
	bt.use(['form','jquery','element','dicts','dateType'], function(){
		form = bt.form(),$  = bt.jquery;
		date = bt.dateType.init();
		//监听提交
		form.on('submit(configSubmit)', function(data){
			$.post(basePath + "/sys/config/save",data.field,function(result){
				parent.layer.alert(result.msg, {icon: result.success?1:2});
				if (result.success) {
					location.reload();//重载当前页面
				}
			},"JSON");
			return false;
		});
		dicts=bt.dicts.init();
	});
</script>
</body>
</html>

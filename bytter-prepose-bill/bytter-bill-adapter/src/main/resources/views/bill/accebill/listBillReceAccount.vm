<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="excelExport">
    <input type="hidden" name="dataTablesInput" id="dataTablesInput">
</form>
<form id="searchForm" class="layui-form input150-container">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ## 申请单位
                        <td width="8%" class="textRight">#springMessage('bill.accebill.applyCorp')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_applyCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:billbus:query:rececorp"
                                     data-callback="applyCorpCallback"
                                >
                                </div>
                            </div>
                        </td>
                        ## 票据单位
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-name="corpId"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_corpId"
                                     data-resource="bill:accebill:billbus:query:rececorp"
                                     data-scope="all"
                                >
                                </div>
                            </div>
                        </td>
                        ## 业务单位
                        <td width="8%" class="textRight">#springMessage('bill.accebill.busCorp')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_busCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:billbus:query:rececorp"
                                >
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##业务人员
                        <td width="8%" class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_busPersonnel"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('bill.accebill.busPersonnel')">
                            </div>
                        </td>
                        ##收票日期
                        <td width="10%" class="textRight">#springMessage('bill.accebill.receDate')</td>
                        <td width="20%">
                            <div class="layui-inline">
                                <input type="text" name="ged_receDate" data-biz-name="ged_receDate"
                                       class="layui-input bt-biz-dateType" data-endid="receDate" data-type="date"
                                       value="$!{receDate}">
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" name="led_receDate" lay-verify="required" data-today="true"
                                       　data-name="led_receDate" class="layui-input bt-biz-dateType" id="receDate"
                                       data-type="date">
                            </div>
                        </td>
                        ##流通介质
                        <td class="textRight" width="10%">#springMessage('table.abVoucherinfo.billFlag')</td>
                        <td width="20%">
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="mulselect" data-defaultvalue="11,10"
                                     data-required="true"
                                     data-name="ini_billFlag" data-group="AB_BILL_FLAG" data-biz-name="billFlag">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                    </tr>
                    <tr>
                        ##票据号码
                        <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="likes_origNo"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.origNo')">
                            </div>
                        </td>
                        ##出票日期
                        <td class="textRight" width="10%">#springMessage('table.abVoucherinfo.startDate')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" name="ged_startDate" data-biz-name="ged_startDate"
                                       class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date">
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" name="led_startDate" data-name="led_startDate"
                                       class="layui-input bt-biz-dateType" id="startDate" data-type="date">
                            </div>
                        </td>
                        ##票据类型
                        <td width="10%" class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                        <td>
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="mulselect" data-defaultvalue="10,11"
                                     data-required="true"
                                     data-name="ini_billType" data-group="AB_BILL_TYPE" data-biz-name="billType">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##转让方式
                        <td class="textRight">#springMessage('bill.accebill.transferWay')</td>
                        <td>
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="mulselect" data-name="ins_transferWay"
                                     data-group="AB_BILL_TRANSFERWAY"></div>
                            </div>
                        </td>
                        ##到期日期
                        <td class="textRight" width="10%">#springMessage('table.abVoucherinfo.endDate')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" name="ged_endDate" data-biz-name="ged_endDate"
                                       class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" name="led_endDate" data-name="led_endDate"
                                       class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                            </div>
                        </td>
                        ##银行类别
                        <td class="textRight">#springMessage('table.btBankAcc.bankTypeId')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                                     data-method="get" data-callback="bankTypeCallBack"
                                     data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                                     data-inputvalue="inputvalue" data-search="true"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight" width="12%">#springMessage('bill.accebill.payerNo')</td>
                        <td><input type="text" name="likes_payerBankName"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('bill.accebill.payerNo')">
                        </td>
                        ##票据金额
                        <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                        <td>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text"
                                   data-name="geg_billMoney"
                                   data-moneyendid="leg_billMoney"
                                   placeholder="#springMessage('table.abVoucherinfo.billMoney')"/>
                            <span class="date-mid">~</span>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_billMoney" type="text"
                                   data-name="leg_billMoney"
                                   placeholder="#springMessage('table.abVoucherinfo.billMoney')"/>
                        </td>
                        ##转让日期
                        <td class="textRight" width="10%">#springMessage('ab.accebill.transferDate')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" name="ged_transferDate" data-biz-name="ged_transferDate"
                                       class="layui-input bt-biz-dateType" data-endid="transferDate" data-type="date">
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" name="led_transferDate" data-name="led_transferDate"
                                       class="layui-input bt-biz-dateType" id="transferDate" data-type="date">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##后手
                        <td class="textRight" width="12%">#springMessage('bill.accebill.rearAccrecords')</td>
                        <td><input type="text" name="likes_rearAccrecords"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('bill.accebill.rearAccrecords')">
                        </td>
                        ##票据单位账号
                        <td class="textRight">#springMessage('table.abVoucherinfoVice.bankAcc')</td>
                        <td width="10%">
                            <div class="layui-input-inline">
                                <input type="text" id="likes_bankAcc" name="likes_bankAcc" data-name="likes_bankAcc" data-biz-name="likes_bankAcc" accountType="2,3"
                                       autocomplete="off"
                                       class="layui-input bt-biz-accountTable" data-callback="accountCallBack"/>
                            </div>
                        </td>
                        ##后手
                        <td class="textRight" width="12%">#springMessage('bill.accebill.cnAccrecords')</td>
                        <td><input type="text" name="likes_cnAccrecords"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('bill.accebill.cnAccrecords')">
                        </td>
                    </tr>
                    <tr>
                        ##是否对内
                        <td class="textRight">#springMessage('bill.accebill.intenal')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class=bt-biz-dict data-type="select" data-name="eqs_insideSing"
                                     data-group="sf_yn"></div>
                            </div>
                        </td>
                        ##出票标志
                        <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
                            </div>
                        </td>
                        ##票据是否允许分包
                        <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND" data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##子票区间号码
                        <td class="textRight">#springMessage('bill.accebill.sti')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" name="likes_sbbllRngStrtSn"
                                       autocomplete="off" class="layui-input" maxlength="12"
                                       placeholder="#springMessage('table.abVoucherinfo.sbbllRngStrtSn')">
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" name="likes_sbbllRngEndSn"
                                       autocomplete="off" class="layui-input" maxlength="12"
                                       placeholder="#springMessage('table.abVoucherinfo.sbbllRngEndSn')">
                            </div>
                        </td>
                        ##备注
                        <td class="textRight">#springMessage('common.message.remark')</td>
                        <td>
                            <input type="text" class="layui-input" id="rmk" name="likes_rmk"/>
                        </td>
                        ##付款单号
                        <td class="textRight">#springMessage('table.nisBillhead.billNo')</td>
                        <td>
                            <input type="text" name="likes_payNo"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.nisBillhead.billNo')">
                        </td>
                    </tr>
                    <tr>
                        <td width="10%" class="textRight">票据状态</td>
                        <td>
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="mulselect"
                                     data-name="ins_billStatus" data-group="AB_BILL_STATUS" data-biz-name="billStatus">
                                </div>
                            </div>
                        </td>
                        <td width="10%" class="textRight">票据流通标志</td>
                        <td>
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="mulselect"
                                     data-name="ins_ebillBlCrclIndc" data-group="AB_BILL_CRCL_INDCD" data-biz-name="ebillBlCrclIndc">
                                </div>
                            </div>
                        </td>
                        <td class="textRight" width="10%">业务发起日期</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" name="ged_applyDate" data-biz-name="ged_applyDate"
                                       class="layui-input bt-biz-dateType" data-endid="applyDate" data-type="date">
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" name="led_applyDate" data-name="led_applyDate"
                                       class="layui-input bt-biz-dateType" id="applyDate" data-type="date">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##业务状态
                        <td class="textRight">#springMessage('bill.accebill.busStatus')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="mulselect" data-group="AB_BILL_BUSSTATUS"
                                 data-name="ins_status"></div>
                        </td>

                        ##指令状态
                        <td class="textRight">#springMessage('bill.accebill.InstructionStatus')</td>
                        <td width="20%">
                            <div class="bt-biz-dict" data-group="AB_BILL_INSOPTSTATUS" data-name="ins_optStatus"
                                 data-type="mulselect"></div>
                        </td>

                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            <div class="layui-inline">
                                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                                    'common.button.search')</button>
                                <button type="reset" class="layui-btn layui-btn-primary"
                                        data-callback="clearData">#springMessage('common.button.reset')</button>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('bill.accebill.applyCorp')</th>
        <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
        <th>#springMessage('bill.accebill.busCorp')</th>
        <th>#springMessage('bill.accebill.busPersonnel')</th>
        <th>#springMessage('table.abVoucherinfo.billFlag')</th>
        <th>#springMessage('table.abVoucherinfo.billType')</th>
        <th>#springMessage('table.abVoucherinfo.origNo')</th>
        <th>票据状态</th>
        <th>票据流通标志</th>
        <th>#springMessage('table.abVoucherinfoVice.bankAcc')</th>
        <th>#springMessage('table.abVoucherinfo.payer')</th>
        <th>#springMessage('bill.accebill.payerNo')</th>
        <th>#springMessage('table.abVoucherinfo.payeracc')</th>
        <th>#springMessage('table.abVoucherinfo.acceptor')</th>
        <th>#springMessage('bill.accebill.receDate')</th>
        <th>#springMessage('table.abVoucherinfo.startDate')</th>
        <th>#springMessage('table.abVoucherinfo.endDate')</th>
        <th>#springMessage('bill.accebill.backOrRec')</th>
        <th>#springMessage('bill.accebill.backOrRec.acc')</th>
        <th>#springMessage('bill.accebill.backOrRec.bankName')</th>
        <th>背书人（前手）行号</th>
        <th>#springMessage('bill.accebill.money')</th>
        <th>#springMessage('bill.accebill.transferWay')</th>
        <th>#springMessage('bill.accebill.endorsementTransfers')</th>
        <th>业务发起日期</th>
        <th>#springMessage('ab.accebill.transferDate')</th>
        <th>后手名称</th>
        <th>后手账号</th>
        <th>后手行号</th>
        <th>后手开户行</th>
        <th>#springMessage('table.abBackbillinfo.intrstrate')</th>
        <th>#springMessage('bill.accebill.interest')</th>
        <th>#springMessage('bill.accebill.netAvails')</th>
        <th>#springMessage('bill.accebill.localBank')</th>
        <th>#springMessage('bill.accebill.billAnomalies')</th>
        <th>#springMessage('bill.accebill.bustype')</th>
        <th>#springMessage('bill.accebill.billSendSign')</th>
        <th>#springMessage('table.nisBillhead.billNo')</th>
        <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
        <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
        <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>
        <th>#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')</th>
        <th>#springMessage('common.message.remark')</th>
        <th>#springMessage('bill.accebill.busStatus')</th>
        <th>#springMessage('bill.accebill.inoptStatus')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/billReceAccount.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" id="balFrom">
       <table class="layui-table">
			<tbody>
                <tr>
                    <td width="20%" class="textRight">#springMessage('bill.accebill.beginDate')</td>
                    <td width="30%">
                        <div class="layui-inline">
							<input type="text" data-biz-name="beginDate" id="beginDate" class="layui-input bt-biz-dateType" data-today="true" data-type="date" data-max="$!{dataToday}">
                        </div>
                    </td>
				</tr>
				<tr>
                ##所属单位
                    <td width="20%" class="textRight">#springMessage('bill.accebill.corpId')</td>
                    <td width="30%">
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="corpIds"
								 data-biz-name="corpId"
                                 data-scope="all"
								 data-required="true"
                                 data-resource="bill:accebill:accbal:reset:corpop"
                            >
                            </div>
                        </div>
                    </td>
				</tr>
				<tr>
					<td colspan="2" style="text-align: center;">
						<button type="button" class="layui-btn" onclick="resetAccBillBal()">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					 </td>
				</tr>
			</tbody>
		</table>
	</form>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillAccBal.reset.js?_btv=${resourceVersion}"></script>
</html>

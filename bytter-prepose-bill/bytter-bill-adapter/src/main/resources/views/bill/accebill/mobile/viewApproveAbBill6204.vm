#* 
*6204 票据下拨
*#
<!DOCTYPE html>
<html>
<head>
	#parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
    #if($!{applyInfo})
    <li class="mui-table-view-cell mui-collapse">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.transferdownapply.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
            ##申请单号
                #springMessage('table.abBillTransfer.allocatedCode.apply')
                <span class="mui-badge mui-badge-inverted">
                    $!{applyInfo.allocatedCode}
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##申请单位
                #springMessage('table.abBillTransfer.applyCorp')
                <span class="mui-badge mui-badge-inverted">
                    $!{applyInfo.recordCorpName}
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##申请单位账号
                #springMessage('table.abBillTransfer.applyBankAcc')
                <span class="mui-badge mui-badge-inverted">
                    $!{applyInfo.recevieBankacc}
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##申请金额
                #springMessage('table.abBillTransfer.applyMoney')
                <span class="mui-badge mui-badge-inverted">
                    $number.formatNumeric($!{applyInfo.allocationMoney})
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##申请原因
                #springMessage('table.abBillTransfer.applyReason')
                <span class="mui-badge mui-badge-inverted">
                    $!{applyInfo.allocationReason}
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##业务办理日期
                #springMessage('table.abVoucherinfo.Business.date')
                <span class="mui-badge mui-badge-inverted">
                    $!date.format('yyyy-MM-dd',$!{applyDate})
    		    </span>
            </li>
        </ul>
    </li>
    #end
    <li class="mui-table-view-cell mui-collapse">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.transferdownmanageinfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
            ##下拨单号
                #springMessage('table.abBillTransfer.allocatedCode.down')
                <span class="mui-badge mui-badge-inverted">
                    $!{info.allocatedCode}
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##选票票号
                #springMessage('table.abBillTransfer.billNo')
                <span class="mui-badge mui-badge-inverted">
                    $!{info.billNo}
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##下拨金额
                #springMessage('table.abBillTransfer.downMoney')
                <span class="mui-badge mui-badge-inverted">
                    #if($!{info.allocationMoney})$number.formatNumeric($!{info.allocationMoney})#end
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##下拨原因
                #springMessage('table.abBillTransfer.downReason')
                <span class="mui-badge mui-badge-inverted">
                    $!{info.allocationReason}
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##下拨中心
                #springMessage('bill.accebill.transferdownmanage.corpCenter')
                <span class="mui-badge mui-badge-inverted">
                    $!{info.recordCorpName}
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##收票单位
                #springMessage('table.abBillTransfer.recevieCorpId')
                <span class="mui-badge mui-badge-inverted">
                    $!{info.recevieCorpName}
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##下拨中心账号
                #springMessage('table.abBillTransfer.recordBankAcc')
                <span class="mui-badge mui-badge-inverted">
                    $!{info.recordBankacc}
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##收票单位账号
                #springMessage('table.abBillTransfer.recevieBankAcc')
                <span class="mui-badge mui-badge-inverted">
                    $!{info.recevieBankacc}
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##录入日期
                #springMessage('table.abBillTransfer.recordDate')
                <span class="mui-badge mui-badge-inverted">
                    $!date.format('yyyy-MM-dd',$!{info.recordDate})
    		    </span>
            </li>
            <li class="mui-table-view-cell">
            ##业务办理日期
                #springMessage('table.abAccrecords.businessDate')
                <span class="mui-badge mui-badge-inverted">
                    $!date.format('yyyy-MM-dd',$!{info.businessDate})
    		    </span>
            </li>
        </ul>
    </li>
</ul>
	#parse("views/common/wapfooter.vm")
</body>
</html>

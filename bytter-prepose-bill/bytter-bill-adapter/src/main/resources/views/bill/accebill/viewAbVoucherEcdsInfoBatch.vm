		</div>
	</div>
		#parse("views/common/footer.vm")
	<script type="text/javascript">
		var billShowType='$!{billShowType}';
		var accIds='$!{accIds}';
		var printId='front';
		var  style ='<link rel="stylesheet" href="' + basePath + '/static/plugins/layui/css/layui.css" media="all">';
		//添加公共样式，解决不换行的问题
		style +='<link rel="stylesheet" href="' + basePath + '/static/css/common.css" media="all">'
		var currentCss = $("#currentCss").text();
		style +='<style>'+currentCss+'</style>';
		function getBillInfoPrintHtml(){
			printHtml=document.documentElement.innerHTML;
			printHtml=printHtml.substring(0,printHtml.indexOf("<object id='LODOP_OB'"))+"</body></html>";
			$("#asdf").text(printHtml);
			return printHtml;
		}
		var listSize=$!{list.size()};
		function doubleToString(){
			for(var j=1;j<=listSize;j++){
				var v_money = $("#billMoney"+j).val();
				v_money=deleDot(v_money);
				if(v_money.indexOf('.') == -1){
					v_money += '.00';
				}else{
					while(v_money.length - v_money.indexOf('.') < 3){
						v_money += '0';
					}
				}
				v_money = v_money.replace('.','');
				for(i=1;i<=v_money.length;i++){
					var v_temp = v_money.substr(i-1,1);
					document.getElementById(j+"b"+(12-v_money.length+i)).innerText = v_temp;
				}
				document.getElementById(j+"b"+(12-v_money.length)).innerText = '￥';
			}
		}
		function deleDot(str){
			var newStr = "";
			for(var i=0; i <str.length; i++){
				if(str.charAt(i) != ","){
					newStr += str.charAt(i);
				}
			}
			return newStr;
		}

		//正反面查询信息查询
		function bankSyncro(){
			var isFront ='03';
			if( document.getElementById('front1').style.display=='none') {
				isFront='02';
			}
			$.ajax({
				url:basePath+'/bill/accebill/abbillreceivebiz/fastCredit?acId=$!{accIds}&msgType='+isFront,
				dataType: 'json',
				type: "post",
				success:function(result){
					if(result.success==true){
						parent.layer.alert(bt.lang(result.attributes.MSG_INFO), {icon: 6});
					}else{
						parent.layer.alert(bt.lang(result.attributes.MSG_INFO), {icon: 2});
					}
				}});
		}

		function showinfo( v ) {
			if(v == 'front') {
				for(var j=1;j<=listSize;j++){
					document.getElementById('front'+j).style.display = '';
					document.getElementById('back'+j).style.display = 'none';
					if(document.getElementById('additional'+j)){
						document.getElementById('additional'+j).style.display = 'none';
					}
				}
				document.getElementById('printNoNullBack').style.display = 'none';
			} else if(v == 'back') {
				for(var j=1;j<=listSize;j++){
					document.getElementById('front'+j).style.display = 'none';
					document.getElementById('back'+j).style.display = '';
					if(document.getElementById('additional'+j)){
						document.getElementById('additional'+j).style.display = 'none';
					}
				}
				document.getElementById('printNoNullBack').style.display = '';
			}else if(v == 'additional'){
				for(var j=1;j<=listSize;j++){
					document.getElementById('front'+j).style.display = 'none';
					document.getElementById('back'+j).style.display = 'none';
					if(document.getElementById('additional'+j)){
						document.getElementById('additional'+j).style.display = '';
					}
				}
				document.getElementById('printNoNullBack').style.display = 'none';
			}else if(v == 'all'){
				for(var j=1;j<=listSize;j++){
					document.getElementById('front'+j).style.display = '';
					document.getElementById('back'+j).style.display = '';
					if(document.getElementById('additional'+j)){
						document.getElementById('additional'+j).style.display = '';
					}
				}
			}
			printId=v;
		}

		function printNoNullBack() {
			var trs = $("tr[isNull='1']");
			for(i = 0; i < trs.length; i++){
				trs[i].style.display = "none";
			}
			// 执行打印
			doPrint();
			for(i = 0; i < trs.length; i++){
				trs[i].style.display = "";
			}
			// printView(LODOP);
		}

		function winPrint() {
			// 执行打印
			doPrint();
		}
		function println() {
			// 执行打印
			doPrint(true);
		}
		function printFrontBack() {

			for(var j=1;j<=listSize;j++){
				document.getElementById('pageDiv'+j).style.display = '';
				document.getElementById('front'+j).style.display = '';
				document.getElementById('back'+j).style.display = '';
			}
			// LODOP.SET_PRINT_MODE("PRINT_PAGE_PERCENT","Full-Width");
			// 执行打印
			doPrint();
			for(var j=1;j<=listSize;j++){
				document.getElementById('pageDiv'+j).style.display = 'none';
				document.getElementById('front'+j).style.display = 'none';
				document.getElementById('back'+j).style.display = 'none';
				document.getElementById(printId+j).style.display = '';
			}
		}


		function printFrontNoNullBack() {

			for(var j=1;j<=listSize;j++){
				document.getElementById('pageDiv'+j).style.display = '';
				document.getElementById('front'+j).style.display = '';
				document.getElementById('back'+j).style.display = '';
			}
			var trs = $("tr[isNull='1']");
			for(i = 0; i < trs.length; i++){
				trs[i].style.display = "none";
			}
			// 执行打印
			doPrint();
			// window.print();

			for(var j=1;j<=listSize;j++){
				document.getElementById('pageDiv'+j).style.display = 'none';
				document.getElementById('front'+j).style.display = 'none';
				document.getElementById('back'+j).style.display = 'none';
				document.getElementById(printId+j).style.display = '';
			}

			for(i = 0; i < trs.length; i++){
				trs[i].style.display = "";
			}
		}

		// 执行打印程序
		function doPrint(isPrintln){
			var printContent = $('div[name="print_doc"]');
			var printPageNumber = printContent.length;
			if(!printPageNumber){
				return
			}

			var LODOP=getLodop();
			if(LODOP) {
				// 访止重复多次点击
				$('#buttonDiv').addClass('layui-hide');
				LODOP.SET_PRINT_MODE("PRINT_PAGE_PERCENT", "Full-Width");
				//  {time: isPrintln?1 * 1000:10 * 1000}

				if(isPrintln){
                    var layerIndex  = bt.layer.load(1,{time: 1000})
					LODOP.ADD_PRINT_HTML(40,10,"100%","94%",getBillInfoPrintHtml());
				}else{
                    var layerIndex  = bt.layer.load(1);
					printContent.each(function (i) {
						var html = '<!DOCTYPE html><html lang="en"><head>' + style + '</head><body>' + $(this).html() + '</body></html>';
						LODOP.ADD_PRINT_HTM(40, 10, "100%", "94%", html);
						LODOP.NewPageA();
						// 采用分组打印
						if (i > 0 && i > 98 && i % 99 == 0) {
							LODOP.PRINT();
						}
					})
					//  小于10或者尾数是10以内的，在此开启打印
					if (printPageNumber % 100 != 0) {
						if(printPageNumber > 99){
							LODOP.PRINT();
						}else{
						    if(99 > printPageNumber > 10){
                                LODOP.PRINT();
                            }else{
                                // 如果总条数小于等10条，将启动打印预览功能
                                LODOP.SET_PREVIEW_WINDOW(1,0,0,900,600,"");
                                LODOP.PREVIEW();
                            }
						}
					}

                    if (LODOP.CVERSION){
                    	CLODOP.On_Return=function(TaskID,Value){
                            bt.layer.close(layerIndex)
                            $('#buttonDiv').removeClass('layui-hide');
                    	};

                    }else{
                       setTimeout(function(){
                           bt.layer.close(layerIndex)
                       },1000)
                    }
				}
			}
		}

		function printView(LODOP){
			// if (LODOP.CVERSION){
			// 	CLODOP.On_Return=function(TaskID,Value){
			// 		if(Value>0){
			// 		}
			//         bt.loading.hide();
			// 	};
			//     LODOP.SET_PREVIEW_WINDOW(1,0,0,900,600,"");
			//     LODOP.PREVIEW();
			// }else{
			//     LODOP.SET_PREVIEW_WINDOW(1,0,0,900,600,"");
			// 	var Value=LODOP.PREVIEW();
			//     bt.loading.hide();
			// 	if(Value>0){
			// 	}
			// }
		}
		if(billShowType){
			showinfo(billShowType);
			document.getElementById('buttonDiv').style.display = 'none';
		}

		$(function(){
            $("#printBox").removeClass("layui-hide");
            $("#loadingDiv").remove();
		})
	</script>
	</body>

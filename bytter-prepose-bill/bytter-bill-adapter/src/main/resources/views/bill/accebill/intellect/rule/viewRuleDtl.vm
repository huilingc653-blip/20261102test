<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    ##选票规则明细查看
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('bill.intellect.rule.ruleDtlView')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <input type="hidden" id="applyNo" name="applyNo" value="$!{rule.applyNo}">
                    <input type="hidden" name="id" value="$!{rule.id}">
                    <input type="hidden" name="serialNo" value="$!{rule.serialNo}">
                    <input type="hidden" id="screenTypeVal" value="$!{rule.screenType}">
                    <input type="hidden" id="scopeModeVal" value="$!{rule.scopeMode}">
                    <input type="hidden" id="valueVal" value="$!{rule.value}">
                    <input type="hidden" id="dataType" value="$!{rule.dataType}">
                    <input type="hidden" id="elementNameVal" value="$!{rule.elementName}">
                    <input type="hidden" id="elementId" name="elementId" value="$!{rule.elementId}">
                    <input type="hidden" id="parentId" name="parentId" value="$!{rule.parentId}">
                    <input type="hidden" id="startValueVal" value="$!{rule.startValue}">
                    <input type="hidden" id="endValueVal" value="$!{rule.endValue}">

                    <input type="hidden" name="ruleCode" value="$!{rule.ruleCode}">
                    <input type="hidden" id="screenTypeVal" value="$!{rule.screenType}">
                    <input type="hidden" id="sortOrderVal" value="$!{rule.sortOrder}">
                    <input type="hidden" id="scopeModeVal" value="$!{rule.scopeMode}">
                    <input type="hidden" id="startRelationVal" value="$!{rule.startRelation}">
                    <input type="hidden" id="endRelationVal" value="$!{rule.endRelation}">
                    <input type="hidden" id="relationVal" value="$!{rule.relation}">
                    <input type="hidden" id="valueIsElementVal" value="$!{rule.valueIsElement}">
                    <input type="hidden" id="sourceTypeVal" value="$!{rule.sourceType}">
                    <input type="hidden" id="dictGroupVal" value="$!{rule.dictGroup}">

                    <tr>
                        ## 要素名称
                        <td style="width: 20%" class="textRight">
                            #springMessage('bill.intellect.ruleDtl.elementName')
                        </td>
                        <td style="width: 30%">
                            <div class="bt-biz-selectType" data-url="${basePath}/bill/intellect/element/listElement" data-callback="elementNameCallback"
                                 data-method ="post"  data-disabled="true" data-name ="elementName" data-biz-name = "elementName" data-defaultvalue="$!{rule.elementName}"
                                 data-valueField="elementName" data-textField="elementName" ></div>
                        </td>
                        ## 上级要素名称
                        <td style="width: 20%" class="textRight">
                            #springMessage('bill.intellect.ruleDtl.parentName')
                        </td>
                        <td style="width: 30%">
                            <div class="bt-biz-selectType" data-url="${basePath}/bill/intellect/element/listElement" data-method ="post" data-defaultvalue="$!{rule.parentName}"
                                 data-callback="parentNameCallback" data-disabled="true" data-name ="parentName" data-biz-name ="parentName"  data-valueField="elementName" data-textField="elementName"></div>
                        </td>
                    </tr>
                    <tr>
                        ## 筛选类型
                        <td class="textRight">#springMessage('bill.intellect.ruleDtl.screenType')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="screen.type" data-name="screenType" data-defaultvalue="$!{rule.screenType}"
                                     data-disabled="true" data-biz-name="screenType" data-selecttext="false" data-callback="screenTypeCallback">
                                </div>
                            </div>
                        </td>
                        ## 备注
                        <td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" class="layui-input" name="rmk" value="$!{rule.rmk}" disabled>
                            </div>
                        </td>
                    </tr>

                    <tr id="showSort">
                    </tr>
                    <tr id="showVal">
                    </tr>
                    <tr id="showVal2">
                    </tr>
                    <tr id="showValSco">
                    </tr>
                    <tr id="showValSco2">
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/intellect/rule/ruleDtl.view.js?_btv=${resourceVersion}"></script>

</html>
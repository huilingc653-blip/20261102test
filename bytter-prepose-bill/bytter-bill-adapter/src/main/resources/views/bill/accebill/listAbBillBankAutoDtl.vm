<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
	<tbody>
		<tr>
            <td width="15%" class="textRight">#springMessage("table.bisBifInit.bifCode")</td>
            <td width="35%">
                <div class="layui-inline">
                    <input type="text" name="likes_bifCode" lay-verify="langKey"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBifInit.bifCode')">
                </div>
            </td>
            <td width="15%" class="textRight">#springMessage("table.bisBifInit.name")</td>
            <td width="35%">
                <div class="bt-biz-bankType" data-name="eqs_bifId" data-biz-name="bankInfo-bank"></div>
            </td>
		</tr>
		<tr>
			<td class="textRight">#springMessage("btBankType.bankType")</td>
			<td>
				<div class="layui-inline">
                        <input type="text" name="likes_bankType" lay-verify="langKey"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('btBankType.bankType')">
                    </div>
			</td>
			<td class="textRight">#springMessage("btBankType.typeName")</td>
			<td >
                <div class="bt-biz-bankType" data-name="eqs_bankTypeId" data-biz-name="bankInfo-bankType"></div>
			</td>
		</tr>
		<tr>
            <td colspan="4" style="text-align: center;">
				<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
	</tbody>
</table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.bisBifInit.bifCode')</th>
        <th>#springMessage('table.bisBifInit.name')</th>
        <th>#springMessage('btBankType.bankType')</th>
        <th>#springMessage('btBankType.typeName')</th>
        <th>#springMessage('abBillBankAutoDtl.autoAccept')</th>
        <th>#springMessage('abBillBankAutoDtl.autoInvoice')</th>
        <th>#springMessage('abBillBankAutoDtl.autoPay')</th>
        <th>#springMessage('abBillBankAutoDtl.poolEndorse')</th>
        <th>#springMessage('abBillBankAutoDtl.poolEmitBill')</th>
        <th>#springMessage('btBankType.validSign')</th>
        <th>#springMessage('table.bankbillbusi.newbillflg')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillBankAutoDtl.list.js?_btv=${resourceVersion}"></script>
</html>
<script type="text/javascript">
	var selectTypes;
	bt.use(['moneyType','form','selectType'], function() {
		var $ = bt.jquery,form = bt.form();
		selectTypes = bt.selectType.init();//下拉框
		var money = document.getElementById("billMoney").value;
		//console.log(bt.moneyType.getFun().toChinese(money));
		document.getElementById("moneyUp").innerText = bt.moneyType.getFun().toChinese(money);

		/**
		 * 生成公共的属性
		 * @return
		 */
			$genOtherHtml=function(corpId,processDate){
			var url = basePath + "/budget/fbsBudgetProcess/getViewItemDetail";
			var param = {
				corpId: corpId,
				itemCode: $("#payItem").val(),
				billId: $("#vvid").val(),
				businessName: $("#businessName").val(),
				processSysname: $("#processSysname").val(),
				processDate: processDate,
				type: 'select',
				date: (new Date()).getTime()
			};
			$.ajax({
				url: url, method: 'POST', data: param, success: function (json) {
					$("#tagItemDetail").html("");
					$("#tagItemDetail").html(json);
					form.render();
				}
			});
		};

		/**
		 * 资金计划挂接
		 */
			$renderBudget = function(corpId,processDate){
			//判断付款方式是否挂资金计划   1、票据模块配置开启挂接资金计划(控制层判断) 2、预算科目维护不为空  3、对外票据  4、当前单位是否要挂预算
			$.ajax({
				type: 'POST',
				url: basePath+"/bill/accebill/abvoucherinfoVice/isBudget",
				data:{'corpId':corpId,'briefId':'001'},
				dataType:'json',
				success: function(result){
					if(result.success){
						if(payItem && result.attributes.isBudget){
								$genOtherHtml(corpId,processDate);
						}else{
							$("#budgetDiv").hide();
							$("#tagItemDetail").html("");
						}
					}else{
						$("#budgetDiv").hide();
						$("#tagItemDetail").html("");
					}
				}});
		}

		//初始化资金计划组件
		if($("#corpId").val()&&$("#businessDate").val()){
				$renderBudget($("#corpId").val(),$("#businessDate").val());
		}

	});

	/**
	 *var closeForms=function(){
	 *	var index = parent.layer.getFrameIndex(window.name); //先得到当前iframe层的索引
	 *	parent.layer.close(index); //再执行关闭

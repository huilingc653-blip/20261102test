<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{info.id}" >
    <table class="layui-table">
        <tbody >
        <tr >
            ##单位
            <td class="textRight" width="15%">#springMessage('table.nisBillhead.corpId')</td>
            <td width="35%">
                $!{info.corpName}
            </td>
        </tr>
        <tr>
            ##年份
            <td width="10%" class="textRight">#springMessage('table.emitBill.billTargetProportion.year')</td>
            <td width="20%">
                $!{info.currentYear}
            </td>
        </tr>
        <tr>
            ##目标
            <td class="textRight">#springMessage('table.emitBill.billTargetProportion.target')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="targetProportion" id="targetProportion"
                           class="layui-input bt-biz-ratioType"
                           data-biz-name="targetProportion"
                           data-ratetype="percent" data-decimal="2" data-required="true" value="$!{info.targetProportion}"
                           placeholder="#springMessage('table.emitBill.billTargetProportion.target')(%)">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abEmitBillTargetProportionInfo.edit.js?_btv=${resourceVersion}"></script>
</html>

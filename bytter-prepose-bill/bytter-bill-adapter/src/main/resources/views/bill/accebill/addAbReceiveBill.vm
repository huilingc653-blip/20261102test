                                <div class="bt-div-search">
                                    <button class="bt-biz-bankInfo" type="button"
                                            data-callback="bt.bailBankInfoCallback" opType="acceptorBankClick"><i
                                            class="layui-icon">&#xe615;</i></button>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##承兑人账号
                        <td class="textRight">#springMessage('table.abVoucherinfo.acceptoracc')</td>
                        <td>
                            <input type="text" id="acceptoracc" name="acceptoracc" autocomplete="off"
                                   class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptoracc')"
                                   lay-verify="required|strlength" data-maxlength="30">
                        </td>
                        ##承兑人开户行行号
                        <td class="textRight">#springMessage('table.abVoucherinfo.acceptorbankno')</td>
                        <td>
                            <input type="text" id="acceptorbankno" name="acceptorbankno" autocomplete="off"
                                   class="layui-input"
                                   placeholder="#springMessage('table.abVoucherinfo.acceptorbankno')"
                                   lay-verify="required|strlength" data-maxlength="30">
                        </td>
                    </tr>
                    <tr style="display:none" class="drawBillShow">
                        ##承兑人统一信用代码
                        <td class="textRight">#springMessage('table.abVoucherinfo.blAcptrUnnIdNo')</td>
                        <td>
                            <input type="text" id="blAcptrUnnIdNo" name="blAcptrUnnIdNo" autocomplete="off"
                                   class="layui-input"
                                   lay-verify="strlength" data-maxlength="32"
                                   placeholder="#springMessage('table.abVoucherinfo.blAcptrUnnIdNo')">
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item ignore-required-hide" id="discountDiv" style="display:none">
            <h2 class="layui-colla-title">#springMessage('bill.accebill.discountinfo.title')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td class="textRight" width="15%">#springMessage('table.abDiscount.rpdmk')</td>
                        <td width="35%">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_DISCOUNT_RPDMK"
                                 data-defaultvalue="RM00" data-name="rpdmk" id="rpdmk" data-biz-name="rpdmk"
                                 data-placeholder="" data-required="true" data-callback="clickRpdmk"></div>
                        </td>
                        <td class="textRight" width="15%">#springMessage('table.abDiscount.sttlmmk')</td>
                        <td width="35%">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_STTLMMK" data-defaultvalue="SM01"
                                 data-name="sttlmmk" id="sttlmmk" data-placeholder="" data-required="true"></div>
                        </td>
                    </tr>
                    <tr id="rpddtTr" style="display:none">
                        <td class="textRight" width="15%">#springMessage('table.abDiscount.rpdopendt')</td>
                        <td width="35%"><input type="text" name="rpdopendt" class="layui-input bt-biz-dateType"
                                               id="rpdopendt" data-endid="rpdduedt" data-biz-name="rpdopendt"
                                               placeholder="#springMessage('table.abDiscount.rpdopendt')"
                                               data-required="true"></td>
                        <td class="textRight" width="15%">#springMessage('table.abDiscount.rpdduedt')</td>
                        <td width="35%"><input type="text" name="rpdduedt" class="layui-input bt-biz-dateType"
                                               id="rpdduedt" data-biz-name="rpdduedt"
                                               placeholder="#springMessage('table.abDiscount.rpdduedt')"
                                               data-required="true"></td>
                    </tr>
                    <tr>
                        <td class="textRight" width="15%">#springMessage('table.abDiscount.discountDate')</td>
                        <td width="35%"><input type="text" name="discountDate" class="layui-input bt-biz-dateType"
                                               id="discountDate" data-today="true"
                                               placeholder="#springMessage('table.abDiscount.discountDate')"
                                               lay-verify="required"/></td>
                        <td class="textRight" width="15%">#springMessage('table.abDiscount.interestRates')</td>
                        <td width="35%"><input type="text" name="interestRates" class="layui-input bt-biz-rateType"
                                               id="interestRates"
                                               placeholder="#springMessage('table.abDiscount.interestRates')"
                                               lay-verify="required"/></td>
                    </tr>
                    <tr>
                        <td class="textRight" width="15%">#springMessage('table.abDiscount.daynum')</td>
                        <td width="35%"><input type="text" id="daynum" name="daynum" autocomplete="off"
                                               class="layui-input"
                                               placeholder="#springMessage('table.abDiscount.daynum')"
                                               lay-verify="required|strlength" data-maxlength="10"></td>
                        <td class="textRight" width="15%">#springMessage('table.abDiscount.interest')</td>
                        <td width="35%"><input type="text" id="interest" name="interest" autocomplete="off"
                                               class="layui-input bt-biz-moneyType" data-decimal="2"
                                               lay-verify="required"
                                               placeholder="#springMessage('table.abDiscount.interest')"
                                               data-biz-name="interest"></td>
                    </tr>
                    <tr>
                        <td class="textRight" width="15%">#springMessage('table.abDiscount.paydate')</td>
                        <td width="35%">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_PAY_DATE" data-defaultvalue="0"
                                 data-name="paydate" id="paydate" data-biz-name="paydate" data-placeholder=""
                                 data-required="true"></div>
                        </td>
                        <td colspan="2"></td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('bill.accebill.creditRating.title')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##开票信用等级
                        <td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payerCdtRatgs')</td>
                        <td width="35%">
                            <input type="text" id="payerCdtRatgs" name="payerCdtRatgs" lay-verify="strlength"
                                   data-maxlength="3"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.abVoucherinfo.payerCdtRatgs')">
                        </td>
                        ##开票评级机构
                        <td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payerCdtRatgGgcy')</td>
                        <td width="35%">
                            <input type="text" id="payerCdtRatgGgcy" name="payerCdtRatgGgcy" lay-verify="strlength"
                                   data-maxlength="50"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.abVoucherinfo.payerCdtRatgGgcy')">
                        </td>
                    </tr>
                    <tr>
                        ##开票评级到期日
                        <td class="textRight">#springMessage('table.abVoucherinfo.payerCdtRatgDuedt')</td>
                        <td>
                            <input type="text" name="payerCdtRatgDuedt" data-name="payerCdtRatgDuedt"
                                   class="layui-input bt-biz-dateType" data-type="date"
                                   data-biz-name="payerCdtRatgDuedt"
                                   placeholder="$!{table.abVoucherinfo.payerCdtRatgDuedt}">
                        </td>
                        <td class="textRight"></td>
                        <td width="35%"></td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('bill.accebill.other.title')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##手续费
                        <td class="textRight">#springMessage('table.abAccrecords.feemoney')</td>
                        <td>
                            <input type="text" data-name="feemoney" class="layui-input bt-biz-moneyType"
                                   data-biz-name="feemoney" placeholder="#springMessage('table.abAccrecords.feemoney')">
                        </td>
                        ##交票人
                        <td class="textRight" width="15%">#springMessage('table.abAccrecords.receiveTrader')</td>
                        <td width="35%">
                            <input type="text" id="trader" name="trader" autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.abAccrecords.receiveTrader')"
                                   lay-verify="strlength" data-maxlength="50">
                        </td>
                    </tr>
                    <tr>
                        ##承兑合同号/交易合同号
                        <td class="textRight" width="15%">#springMessage('table.abVoucherinfo.aContractNo')</td>
                        <td width="35%">
                            <input type="text" id="acontractNo" name="acontractNo" autocomplete="off"
                                   class="layui-input" placeholder="#springMessage('table.abVoucherinfo.aContractNo')"
                                   lay-verify="strlength" data-maxlength="250">
                        </td>
                        ##发票号
                        <td class="textRight" width="15%">#springMessage('table.abVoucherinfo.aInvcnb')</td>
                        <td width="35%">
                            <input type="text" id="ainvcnb" name="ainvcnb" autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.abVoucherinfo.aInvcnb')" lay-verify="strlength"
                                   data-maxlength="250">
                        </td>
                    </tr>
                    <tr>
                        ##摘要
                        <td class="textRight">#springMessage('table.abAccrecords.abs')</td>
                        <td>
                            <input type="text" id="abs" name="abs" autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.abVoucherinfoVice.abs')" lay-verify="strlength"
                                   data-maxlength="100">
                        </td>
                        ##备注
                        <td class="textRight">#springMessage('table.abAccrecords.rmk')</td>
                        <td>
                            <input type="text" id="rmk" name="rmk" autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.abVoucherinfoVice.rmk')" lay-verify="strlength"
                                   data-maxlength="100">
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="layui-colla-item ignore-required-hide" id="budgetDiv" style="display:none">
            <h2 class="layui-colla-title">#springMessage('table.fbsbudgetprocess.title')</h2>
            <div class="layui-colla-content layui-show">
                <!-- 资金计划 -->
                <div id="tagItemDetail"></div>
            </div>
        </div>
    </div>
    <!-- 附件上传 -->
    <div id="uploader" class="layui-input-inline" style="width:100%"></div>
    <br>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="save">#springMessage(
                'common.button.temp')</button>
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="submit">#springMessage(
                'common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary" onclick="resetForm()">#springMessage(
                'common.button.reset')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/blackWhite/blackWhiteBase.check.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abReceiveBill.add.js?_btv=${resourceVersion}"></script>
</html>
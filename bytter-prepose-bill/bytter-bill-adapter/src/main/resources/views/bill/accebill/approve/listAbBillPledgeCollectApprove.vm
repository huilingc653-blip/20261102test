<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
		<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
    	<div class="layui-collapse" lay-filter="collapse">
    	<div class="layui-colla-item">
		<h2 class="layui-colla-title"></h2>
		<div class="layui-colla-content layui-show">
        <table class="layui-table">
            <tbody>
                <tr>
                	##入库库存
                    <td width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.enterStock')</td>
                    <td width="25%">
					 	<div class="layui-input-inline">
                     		<div class="bt-biz-dict"  data-type="select" data-group="AB_ENTER_STOCK"  data-name="eqs_enterStock" data-biz-name="enterStock"  ></div>
                     	</div>
                    </td>
					##票据金额
                    <td  width="8%" class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                    <td  width="25%">
                        <input type="text"  class="layui-input bt-input-inline bt-biz-moneyType" id="geg_billMoney" data-name="geg_billMoney" data-moneyendid="leg_billMoney"  placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                        <span class="date-mid">~</span>
                        <input type="text"  class="layui-input bt-input-inline bt-biz-moneyType" id="leg_billMoney"  data-name="leg_billMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                    </td>
                    ##票据类型
                    <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                    <td width="25%">
						<div class="layui-input-inline">
					 		<div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE" data-defaultvalue="$!{abReceiveBillPage.billType}" data-name="eqi_billType"></div>
                    	</div>
                    </td>
				</tr>			
				<tr>
					##票据号码
                    <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_origNo" autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
                        </div>
                    </td>
                    ##出票日期
                    <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                    <td width="25%">
                        <div id="startDate" ></div>
                    </td>
                    ##出票人
                    <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_payer" autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payer')">
                        </div>
                    </td>
				</tr>
                <tr>
                    ## 申请单位
                    <td class="textRight">#springMessage('bill.accebill.applyCorp')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_applyCorpId"
                                 data-scope="all"
                                 data-resource="sys:flow:query:corpop"
                                 data-callback="applyCorpCallback"
                            >
                            </div>
                        </div>
                    </td>
                    ## 票据单位
                    <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-name="corpId"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 data-resource="sys:flow:query:corpop"
                                 data-scope="all"
                            >
                            </div>
                        </div>
                    </td>
                    ## 业务单位
                    <td class="textRight" >#springMessage('bill.accebill.busCorp')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_busCorpId"
                                 data-scope="all"
                                 data-resource="sys:flow:query:corpop"
                            >
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##业务人员
                    <td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_busPersonnel"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
                        </div>
                    </td>
                    ##到期日期
                    <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                    <td width="25%">
                        <div id="endDate" ></div>
                    </td>
					##承兑人
                    <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_acceptor" autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptor')">
                        </div>
                    </td>
                </tr>
                <tr>
                 	##流通介质
                    <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
                    <td width="25%">
                    	<div class="layui-input-inline">
					 		<div class="bt-biz-dict" data-type="select" data-group="AB_BILL_FLAG" data-defaultvalue="$!{abReceiveBillPage.billFlag}" data-name="eqi_billFlag"></div>
                    	</div>
                    </td>
                	##票据来源
					<td width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.billSource')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
							<div class="bt-biz-dict" data-type="select" data-group="AB_BILL_SOURCE" data-defaultvalue="$!{abReceiveBillPage.billSource}" data-name="eqi_billSource"></div>
                        </div>
                    </td>
					<td width="8%" class="textRight"></td>
                    <td width="25%">
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                     	<div class="layui-inline">
                        	<button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                        </div>
                    </td>
				</tr>
            </tbody>
        </table>
        </div>
  		</div>
        </div>
    </form>
    
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.abVoucherinfo.billType')</th>
        <th>#springMessage('table.abVoucherinfo.billFlag')</th>
        <th>#springMessage('bill.accebill.applyCorp')</th>
        <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
        <th>#springMessage('bill.accebill.busCorp')</th>
        <th>#springMessage('bill.accebill.busPersonnel')</th>
        <th>#springMessage('table.abVoucherinfo.payer')</th>
        <th>#springMessage('table.abVoucherinfo.acceptor')</th>
        <th>#springMessage('table.abVoucherinfo.origNo')</th>
		<th>#springMessage('table.abVoucherinfo.billMoney')</th>
		<th>#springMessage('table.abVoucherinfo.startDate')</th>
		<th>#springMessage('table.abVoucherinfo.endDate')</th>
		<th>#springMessage('table.abVoucherinfo.payee')</th>
		<th>#springMessage('table.abVoucherinfoVice.enterStock')</th>
		<th>#springMessage('table.abVoucherinfoVice.billSource')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#workFlowHtml()
#parse("views/common/footer.vm")
#workFlowScript()
<script src="${basePath}/static/modules/bill/accebill/approve/abBillPledgeCollectApprove.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##申请单位
					<td class="textRight">#springMessage('table.abBillTransfer.applyCorp')</td>
					<td width="25%">
						<div class="layui-input-inline">
							<div class="bt-biz-corp"
                                data-biz-type="corp"
                                data-biz-name="corpId"
                                data-type="selectTree"
                                data-name="eqs_recordCorpId"
                                data-scope="all"
								data-resource="ab:bill:resource:transferdownapply:query">
        					</div>
                        </div>
                    </td>
                    ##申请金额
                    <td class="textRight">#springMessage('table.abBillTransfer.applyMoney')</td>
                    <td width="25%">
						<div class="layui-input-inline">
                            <input type="text" name="geg_allocationMoney" data-moneyendid="endMoney"
                                    autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                        </div>
                        ~
                        <div class="layui-input-inline">
                            <input type="text" name="leg_allocationMoney" id="endMoney"
                                    autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                        </div>
                    </td>
                    ##业务处理状态
                    <td class="textRight">#springMessage('table.abAccrecords.status')</td>
                    <td width="25%">
                        #*<div class="layui-input-inline">
                        #set ($mymap = {"field":"eqs_statusName","type":"","typeGroupCode":"AB_BILL_TRANSFERDOWNAPPLY_STATUS","title":"table.abVoucherinfo.billStatus"})
                        #set ($formB = $dictSelect.instance($mymap))
                        ${formB.html()}
                        </div>*#
                        <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TRANSFERDOWNAPPLY_STATUS" data-name="eqs_statusName"></div>
                    </td>
                </tr>
                <tr>
                    ##申请单号
                    <td class="textRight">#springMessage('table.abBillTransfer.allocatedCode.apply')</td>
                    <td width="25%">
                        <input type="text" class="layui-input" name="likes_allocatedCode">
                    </td>
                    <td width="8%" class="textRight">#springMessage('table.bill.bankType.holderBankType')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                                 data-method="get"
                                 data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                                 data-inputvalue="inputvalue" data-search="true"></div>
                        </div>
                    </td>
                    <td class="textRight"></td>
                    <td width="25%"></td>
                </tr>
				#if($shiro.hasPermission("ab:bill:resource:transferdownapply:query"))
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
				#end
            </tbody>
        </table>
    </form>

#if($shiro.hasPermission("ab:bill:resource:transferdownapply:query"))
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>		
        <th>#springMessage('table.abBillTransfer.allocatedCode.apply')</th>
		<th>#springMessage('table.abBillTransfer.applyCorpId')</th>
		<th>#springMessage('table.abBillTransfer.applyBankAcc')</th>
		<th>#springMessage('table.abBillTransfer.applyMoney')</th>
        <th>#springMessage('table.abBillTransfer.applyReason')</th>
		<th>#springMessage('table.abBillTransfer.status')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#end

##<form class="layui-form">
##	<div class=layui-inline>
##		<div class=date-single></div>
##	</div>
##</form>
    <table class="layui-table">
        <tbody>
        <tr>
            <td width="9%" class="textRight">
                #springMessage('table.abVoucherinfo.Business.date')
            </td>
            <td width="25%">
                <div class=layui-inline>
                    <div class=date-single></div>
                </div>
            </td>
            <td width="9%" class="textRight">
            </td>
            <td width="25%">
            </td>
            <td class="textRight">
            </td>
            <td width="25%">
            </td>
        </tr>
        </tbody>
    </table>
    <br>

#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abbilltransferdownapply.list.js?_btv=${resourceVersion}"></script>
</html>

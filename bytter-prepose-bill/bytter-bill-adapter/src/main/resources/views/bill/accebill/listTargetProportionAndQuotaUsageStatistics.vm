<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="defaultYm" value="$!{defaultYm}">
    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            ##日期
            <td class="textRight">#springMessage('bill.accebill.query.date')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-dateType" name="ym" data-biz-name="ym"
                           data-type="month" value="$!{form.ym}" lay-verify="required">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button type="button" class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="button" class="layui-btn layui-btn-primary" onclick="resetAcUsageRatioStatistics()">#springMessage(
                    'common.button.reset')</button>
                <button type="button" class="layui-btn" lay-submit="" lay-filter="excel">#springMessage(
                    'common.button.exports')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form layui-table-border" style="width:100%;" data-btns="print">
    <thead>
    <tr>
        <th rowspan="2" class="style">序号</th>
        <th rowspan="2" class="style">#springMessage('bill.accebill.query.region')</th>
        <th rowspan="2" class="style">#springMessage('bill.accebill.query.warehouse')</th>
        <th colspan="4" class="style">#springMessage('targetProportionAndQuotaUsage.targetProportion')</th>
        <th colspan="3" class="style">#springMessage('targetProportionAndQuotaUsage.bankCredit')</th>
        <th colspan="3" class="style">#springMessage('targetProportionAndQuotaUsage.openBill')</th>
    </tr>
    <tr>
        <th>#springMessage('table.emitBill.billTargetProportion.target')</th>
        <th>#springMessage('targetProportionAndQuotaUsage.actual')</th>
        <th>#springMessage('targetProportionAndQuotaUsage.difference')</th>
        <th>#springMessage('targetProportionAndQuotaUsage.increaseRatio')</th>
        <th>#springMessage('targetProportionAndQuotaUsage.bankCreditLimit')</th>
        <th>#springMessage('bill.accebill.leftQuota')</th>
        <th>#springMessage('bill.accebill.unexpiredBillMoney')</th>
        <th>#springMessage('targetProportionAndQuotaUsage.totalPay')</th>
        <th>#springMessage('targetProportionAndQuotaUsage.eBankPay')</th>
        <th>#springMessage('targetProportionAndQuotaUsage.openBillPay')</th>
    </tr>
    </thead>
    <tbody>
        #if($!{resultList} && $!resultList.size() > 0)
            #foreach($result in $!resultList)
                #if($!{result.corpId} == '-1')
                <tr style="font-weight: 700">
                    <td></td>
                    ##区域：二级单位
                    <td align="center">$!{result.secondLevCorpName}</td>
                    ##仓库名称
                    <td align="center">$!{result.unitStoreMaintenanceName}</td>
                    ##目标
                    <td align="right">
                        #if($!{result.targetProportion})
                            $rateTag.show($!{result.targetProportion}, 2)
                        #end
                    </td>
                    ##实际
                    <td align="right">
                        #if($!{result.actual})
                            $rateTag.show($!{result.actual}, 2)
                        #end
                    </td>
                    ##差异
                    <td align="right">
                        #if($!{result.difference})
                            $rateTag.show($!{result.difference}, 2)
                        #end
                    </td>
                    ##对比上期提升比例
                    <td align="right">
                        #if($!{result.increaseProportion})
                            $rateTag.show($!{result.increaseProportion}, 2)
                        #end
                    </td>
                    ##银行额度
                    <td align="right">$number.formatNumeric($!{result.bankCredit})</td>
                    ##本月末授信剩余额度
                    <td align="right">$number.formatNumeric($!{result.leftQuota})</td>
                    ##本月止未到期开票金额
                    <td align="right">$number.formatNumeric($!{result.unexpiredBillMoney})</td>
                    ##本月货款支付总额
                    <td align="right">$number.formatNumeric($!{result.totalPay})</td>
                    ##本月货款电汇金额
                    <td align="right">$number.formatNumeric($!{result.eBankPay})</td>
                    ##本月总开票金额
                    <td align="right">$number.formatNumeric($!{result.openBillPay})</td>
                </tr>
                #else
                <tr>
                    ##序号
                    <td align="center">$!{result.serialNum}</td>
                    ##区域：单位名称
                    <td align="center">$!{result.corpName}</td>
                    ##仓库名称
                    <td align="center">$!{result.unitStoreMaintenanceName}</td>
                    ##目标
                    <td align="right">
                        #if($!{result.targetProportion})
                            $rateTag.show($!{result.targetProportion}, 2)
                        #end
                    </td>
                    ##实际
                    <td align="right">
                        #if($!{result.actual})
                            $rateTag.show($!{result.actual}, 2)
                        #end
                    </td>
                    ##差异
                    <td align="right">
                        #if($!{result.difference})
                            $rateTag.show($!{result.difference}, 2)
                        #end
                    </td>
                    ##对比上期提升比例
                    <td align="right">
                        #if($!{result.increaseProportion})
                            $rateTag.show($!{result.increaseProportion}, 2)
                        #end
                    </td>
                    ##银行额度
                    <td align="right">$number.formatNumeric($!{result.bankCredit})</td>
                    ##本月末授信剩余额度
                    <td align="right">$number.formatNumeric($!{result.leftQuota})</td>
                    ##本月止未到期开票金额
                    <td align="right">$number.formatNumeric($!{result.unexpiredBillMoney})</td>
                    ##本月货款支付总额
                    <td align="right">$number.formatNumeric($!{result.totalPay})</td>
                    ##本月货款电汇金额
                    <td align="right">$number.formatNumeric($!{result.eBankPay})</td>
                    ##本月总开票金额
                    <td align="right">$number.formatNumeric($!{result.openBillPay})</td>
                </tr>
                #end
            #end
        #else
        <tr>
            <td colspan="13" align="center">暂无数据</td>
        </tr>
        #end
    </tbody>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/listTargetProportionAndQuotaUsageStatistics.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                ## 申请单位
            <td width="8%" class="textRight">#springMessage('bill.accebill.applyCorp')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_applyCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:billbus:query:rececorp"
                    >
                    </div>
                </div>
            </td>
                ## 票据单位
            <td width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="corpId"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="bill:accebill:billbus:query:rececorp"
                         data-scope="all"
                    >
                    </div>
                </div>
            </td>
                ## 业务单位
            <td width="8%" class="textRight">#springMessage('bill.accebill.busCorp')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_busCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:billbus:query:rececorp"
                    >
                    </div>
                </div>
            </td>
            </tr>

            <tr>
                ##票据号码
                <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="likes_origNo"
                               autocomplete="off" class="layui-input"
                               placeholder="#springMessage('table.abVoucherinfo.origNo')">
                    </div>
                </td>
                ##出票日期
                <td class="textRight" width="10%">#springMessage('table.abVoucherinfo.startDate')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" name="ged_startDate" data-biz-name="ged_startDate"
                               class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date" >
                    </div>
                    <span class="date-mid">~</span>
                    <div class="layui-inline">
                        <input type="text" name="led_startDate" data-name="led_startDate"
                               class="layui-input bt-biz-dateType" id="startDate" data-type="date" value="$!{startDate}">
                    </div>
                </td>
                ##到期日期
                <td class="textRight" width="10%">#springMessage('table.abVoucherinfo.endDate')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" name="ged_endDate" data-biz-name="ged_endDate"
                               class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date" value="$!{endDate}">
                    </div>
                    <span class="date-mid">~</span>
                    <div class="layui-inline">
                        <input type="text" name="led_endDate" data-name="led_endDate"
                               class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                    </div>
                </td>
            </tr>

            <tr>
                ##出票人
                <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="likes_payer"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payer')">
                    </div>
                </td>
                ##收票人
                <td class="textRight">#springMessage('table.abVoucherinfo.payee')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="likes_payee"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payee')">
                    </div>
                </td>
                ##票据单位账号
                <td class="textRight">#springMessage('table.abVoucherinfoVice.bankAcc')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="likes_billBankAcc"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfoVice.bankAcc')">
                    </div>
                </td>
            </tr>
            <tr>
                ##票据收付款标记
                <td class="textRight">#springMessage('bill.accebill.billpayerpayeetype')</td>
                <td>
                    <div class="bt-biz-dict" data-group="BILL_PAYERPAYEE_TYPE" data-name="eqs_billSort" data-type="select" ></div>
                </td>
                ##银行类别
                <td class="textRight">#springMessage('table.btBankAcc.bankTypeId')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json" data-method="get"
                             data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId" data-inputvalue="inputvalue" data-search="true"></div>
                    </div>
                </td>
                ##业务类型
                <td class="textRight">#springMessage('bill.accebill.bustype')</td>
                <td>
                    <div class=layui-form>
                        <div class="bt-biz-dict" data-type="mulselect" data-name="ins_claimType"
                             data-group="AB_BILL_CLAIM_CONDITION_TYPE"></div>
                    </div>
                </td>
            </tr>

##                #if($shiro.hasPermission("bill:accebill:claim:query"))
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
##                #end
            </tbody>
        </table>
    </form>

##    #if($shiro.hasPermission("bill:accebill:claim:query"))
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.abVoucherinfo.origNo')</th>
            <th>#springMessage('table.abVoucherinfo.startDate')</th>
            <th>#springMessage('table.abVoucherinfo.endDate')</th>
            <th>#springMessage('table.abVoucherinfoVice.bankAcc')</th>
            <th>#springMessage('bill.accebill.bustype')</th>
            <th>#springMessage('bill.accebill.billpayerpayeetype')</th>
            <th>#springMessage('bill.accebill.query.date')</th>
            <th>#springMessage('table.abVoucherinfo.billMoney')</th>
            <th>#springMessage('table.abVoucherinfoVice.bailPercent')</th>
            <th>#springMessage('table.abVoucherinfoVice.bailMoney')</th>
            <th>到期解付金额</th>
            <th>#springMessage('bill.accebill.applyCorp')</th>
            <th>#springMessage('bill.accebill.busCorp')</th>
            <th>#springMessage('table.abVoucherinfoVice.corpId')</th>
            <th>#springMessage('bill.accebill.bankacc')</th>
            <th>#springMessage('table.eBankBill.bankType')</th>
            <th>#springMessage('bill.accebill.claimSequence')</th>
            <th>#springMessage('bill.accebill.claimStatus')</th>
            <th>#springMessage('bill.accebill.claimPerson')</th>
            <th>#springMessage('bill.accebill.claimTime')</th>
            <th>#springMessage('table.abVoucherinfo.billFlag')</th>
            <th>#springMessage('bill.accebill.billType')</th>
            <th>#springMessage('bill.accebill.payer')</th>
            <th>#springMessage('bill.accebill.payerNo')</th>
            <th>#springMessage('table.abVoucherinfo.payee')</th>
##            <th>#springMessage('bill.accebill.cnAccrecords')</th>
##            <th>#springMessage('bill.accebill.rearAccrecords')</th>
            <th>#springMessage('bill.accebill.billSendSign')</th>
            <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
        </tr>
        </thead>
    </table>
##    #end

    <form id="searchAccForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
            <input type="hidden" name="claimStatus" value="95" />
            <tr>
                ##持票单位
                <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                <td width="25%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-tree-type="check"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-name="ins_corpId"
                             data-biz-name="corpId"
                             data-scope="all"
                            ##data-callback="corpCallback"
                             data-resource="bill:accebill:claim:query"
                        >
                        </div>
                    </div>
                </td>
                ##借贷标志
                <td class="textRight">#springMessage('table.btBankAccDtl.cdSign')</td>
                <td width="20%">
                    <div class=layui-form>
                        <div class=bt-biz-dict data-type="select" data-name="eqi_cdSign" data-biz-name="eqi_cdSign"  data-group="btBankAccDtl.cdSign">
                        </div>
                    </div>
                </td>
                ##银行类型
                <td class="textRight">#springMessage('table.eBankBill.bankType')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json" data-method="get"
                             data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId" data-biz-name="bankTypeId" data-inputvalue="inputvalue" data-search="true"></div>
                    </div>
                </td>
            </tr>
            <tr>
                ##金额
                <td class="textRight">#springMessage('table.fcAccbook.money')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <input type="text" name="geg_amt" class="layui-input bt-input-inline  bt-biz-moneyType" data-moneyendid="endMoney" data-biz-name="startMoney" placeholder="#springMessage('table.fcAccbook.money')">
                        <span class="date-mid">~</span>
                        <input type="text" name="leg_amt" class="layui-input bt-input-inline  bt-biz-moneyType" id="endMoney" data-biz-name="endMoney" placeholder="#springMessage('table.fcAccbook.money')">
                    </div>
                </td>
                ##日期
                <td class="textRight">#springMessage('table.fcAccuBalance.date')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <input type="text" name="ged_transTime" class="layui-input bt-input-inline  bt-biz-dateType" data-biz-name="startDate"  data-endid="endDate2" placeholder="#springMessage('table.fcAccuBalance.date')">
                        <span class="date-mid">~</span>
                        <input type="text" name="led_transTime" class="layui-input bt-input-inline  bt-biz-dateType" data-biz-name="endDate" id="endDate2" placeholder="#springMessage('table.fcAccuBalance.date')">
                    </div>
                </td>
                ##账号
                <td class="textRight">#springMessage('table.fcFreeze.blnctrAcc')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <input type="text" name="likes_bankAcc" id="bankAcc" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcFreeze.blnctrAcc')">
                    </div>
                </td>
            </tr>
            <tr>
                ##用途
                <td class="textRight">#springMessage('table.nisExpenseDetail.purpose')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <input type="text" name="likes_uses" id="uses" autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisExpenseDetail.purpose')">
                    </div>
                </td>
                ##附言
                <td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <input type="text" name="likes_postscript" id="postscript" autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.addWord')">
                    </div>
                </td>
                ##摘要
                <td class="textRight">#springMessage('table.btBankAccDtl.remark')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <input type="text" name="likes_remark" id="remark" autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.remark')">
                    </div>
                </td>
                <input type="hidden" id="claimId" name="ins_claimId" autocomplete="off" class="layui-input">
            </tr>

##                #if($shiro.hasPermission("bill:accebill:claim:query"))
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="searchAcc" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
##                #end
            </tbody>
        </table>
    </form>
##        #if($shiro.hasPermission("bill:accebill:claim:query"))
        <table id="appAccTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('table.fcAccuBalance.date')</th>
                <th>#springMessage('table.btBankAccDtl.amt')</th>
                <th>#springMessage('table.btBankAccDtl.corp')</th>
                <th>#springMessage('table.abVoucherinfo.origNo')</th>
                <th>#springMessage('table.fcFreeze.blnctrAcc')</th>
                <th>#springMessage('table.nisExpenseDetail.accName')</th>
                <th>#springMessage('table.nisAllocationReq.bankName')</th>
                <th>#springMessage('table.eBankBill.bankType')</th>
                <th>#springMessage('table.btBankAccDtl.cdSign')</th>
                <th>#springMessage('bill.accebill.claimSequence')</th>
                <th>#springMessage('bill.accebill.claimRmk')</th>
                <th>#springMessage('table.btBankAccDtl.remark')</th>
                <th>#springMessage('table.nisExpenseDetail.purpose')</th>
                <th>#springMessage('table.nisBillhead.addWord')</th>
                <th>#springMessage('table.bisAccDtl.curName')</th>
                <th>#springMessage('table.btBankAccDtl.bal')</th>
                <th>#springMessage('table.bisExc.bankSerialNo')</th>
                <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
                <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
                <th>#springMessage('table.btBankAccDtl.oppAccBank')</th>
            </tr>
            </thead>
        </table>
##        #end
    <br>

    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abConfirmedClaim.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body {
            font-size: 14px;
            padding-bottom: 60px;
        }

        .layui-form-label {
            width: 180px;
        }

        .layui-input-block {
            margin-left: 220px;
        }
    </style>
</head>
<body>
    ##到期兑付
<input type="hidden" id="accountByCashingInfo" value="$!{config.accebill.accountByCashing}">

<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <!-- 面板标题 -->
            <h2 class="layui-colla-title">#springMessage('config.accebill.accountConfig.title')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                        ##贴现到账
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.accebill.accountByDiscount')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="checkbox" name="accebill.accountByDiscount" value="1" lay-skin="primary"
                                       #if($config.accebill.accountByDiscount == 1)checked#end
                                       title="#springMessage('config.accebill.billDiscount.bankAcc')">
                            </div>
                        </td>
                    </tr>
                        ##托收到账
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.accebill.accountByCollection')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="checkbox" name="accebill.accountByCollection" value="1" lay-skin="primary"
                                       #if($config.accebill.accountByCollection == 1)checked#end
                                       title="#springMessage('table.abVoucherinfoVice.bankAcc')">
                            </div>
                        </td>
                    </tr>
                        ##到期兑付
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.accebill.accountByCashing')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="checkbox" name="accebill.accountByCashing" id="dateByCashing1" value="1"
                                       lay-skin="primary"
                                       #if($config.accebill.accountByCashing == 1)checked#end
                                       title="#springMessage('config.accebill.billCashing.bankToAcc')">
                                <input type="checkbox" name="accebill.accountByCashing2" id="dateByCashing2" value="1"
                                       lay-skin="primary"
                                       #if($config.accebill.accountByCashing2 == 1)checked#end
                                       title="#springMessage('config.accebill.billCashing.businessToAcc')">
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="20%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>

    ##	表格
    <div>
        <table id="appTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('bill.accebill.corpId')</th>
                <th>#springMessage('bill.accebill.bankacc')</th>
                <th>#springMessage('table.bisAccBal.bifCode')</th>
                <th>#springMessage('bill.accebill.bustype')</th>
                <th>#springMessage('bill.accebill.validSign')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
        </table>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/accebillAccountConfig.list.js?_btv=${resourceVersion}"></script>
</html>

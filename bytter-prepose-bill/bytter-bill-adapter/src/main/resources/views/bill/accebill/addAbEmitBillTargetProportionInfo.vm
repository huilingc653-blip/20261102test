<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="corpCode" name="corpCode" type="hidden">
    <input id="corpName" name="corpName" type="hidden">
    <table class="layui-table">
        <tbody >
        <tr >
            ##单位
            <td class="textRight" width="15%">#springMessage('table.nisBillhead.corpId')</td>
            <td width="35%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="corpId"
                         data-scope="all"
                         data-required="true"
                         data-resource="bill:accebill:abemitbill:billTargetProportion:query"
                         data-callbackData="corpCallback" data-required="true"
                         placeholder="#springMessage('table.nisBillhead.corpId')">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##月份
            <td width="10%" class="textRight">#springMessage('table.emitBill.billTargetProportion.year')</td>
            <td width="20%">
                <div class="layui-inline">
                    <input type="text" name="currentYear" data-biz-name="currentYear" id="currentYear" lay-verify="required"
                           class="layui-input bt-biz-dateType" data-type="year">
                </div>
            </td>
        </tr>
        <tr>
            ##目标
            <td class="textRight">#springMessage('table.emitBill.billTargetProportion.target')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="targetProportion" id="targetProportion"
                           class="layui-input bt-biz-ratioType"
                           data-biz-name="targetProportion"
                           data-ratetype="percent" data-decimal="2" data-required="true"
                           placeholder="#springMessage('table.emitBill.billTargetProportion.target')(%)">
                </div>
            </td>
        </tr>
        <tr >
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abEmitBillTargetProportionInfo.add.js?_btv=${resourceVersion}"></script>
</html>

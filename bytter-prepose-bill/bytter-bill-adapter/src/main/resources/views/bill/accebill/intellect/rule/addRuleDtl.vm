<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    ##选票规则明细新增
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('bill.intellect.rule.ruleDtlAdd')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <input type="hidden" id="applyNo" name="applyNo" value="$!{applyNo}">
                    <input type="hidden" name="id" value="">
                    <input type="hidden" id="screenTypeVal" value="sort">
                    <input type="hidden" id="scopeModeVal" value="series">
                    <input type="hidden" id="valueVal" value="">
                    <input type="hidden" id="dataType" value="">
                    <input type="hidden" id="elementNameVal" value="">
                    <input type="hidden" id="elementId" name="elementId" value="">
                    <input type="hidden" id="parentId" name="parentId" value="">
                    <input type="hidden" id="endValueVal" value="">
                    <input type="hidden" id="startValueVal" value="">
                    <input type="hidden" id="sourceTypeVal" value="">
                    <input type="hidden" id="dictGroupVal" value="">
                    <tr>
                        ## 要素名称
                        <td style="width: 20%" class="textRight">
                            #springMessage('bill.intellect.ruleDtl.elementName')
                        </td>
                        <td style="width: 30%">
                            <div class="bt-biz-selectType" data-url="${basePath}/bill/intellect/element/listElement" data-callback="elementNameCallback"
                                 data-method ="post"  data-required="true" data-name ="elementName" data-biz-name = "elementName"
                                 data-valueField="elementName" data-textField="elementName" ></div>
                        </td>
                        ## 上级要素名称
                        <td style="width: 20%" class="textRight">
                            #springMessage('bill.intellect.ruleDtl.parentName')
                        </td>
                        <td style="width: 30%">
                            <div class="bt-biz-selectType" data-url="${basePath}/bill/intellect/element/listElement" data-method ="post"
                                 data-name ="parentName" data-biz-name ="parentName"  data-valueField="elementName" data-textField="elementName"></div>
                        </td>
                    </tr>
                    <tr>
                        ## 筛选类型
                        <td class="textRight">#springMessage('bill.intellect.ruleDtl.screenType')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="screen.type" data-name="screenType"
                                     data-required="true" data-biz-name="screenType" data-selecttext="false" data-callback="screenTypeCallback">
                                </div>
                            </div>
                        </td>
                        ## 备注
                        <td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" class="layui-input" name="rmk">
                            </div>
                        </td>
                    </tr>

                    <tr id="showSort">
                    </tr>
                    <tr id="showVal">
                    </tr>
                    <tr id="showVal2">
                    </tr>
                    <tr id="showValSco">
                    </tr>
                    <tr id="showValSco2">
                    </tr>
                    <tr>
                        <td colspan="4">
                            <div style="text-align: center;width: 100%">
                                <button class="layui-btn" lay-submit lay-filter="submit" type="button">#springMessage('common.button.submit')</button>
                                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/intellect/rule/ruleDtl.add.js?_btv=${resourceVersion}"></script>

</html>
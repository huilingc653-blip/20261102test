<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
		<div class="layui-collapse" lay-filter="collapse">
			<form id="searchForm" class="layui-form input150-container">
			<input type="hidden" id="curId" name="curCode" value="$!{curId}" />
			##<input type="hidden" id="ids" name="ids" value="$!{curId}" />
			<input type="hidden" id="isSelectBill" name="isSelectBill" value="$!{isSelectBill}" />
			<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('common.query.title')</h2>
			<div class="layui-colla-content layui-show">
			<div class="layui-inline">
				<label class="layui-form-label"> #springMessage('accebill.bill.isSelectBill')</label>
				<div class="layui-input-inline">
				<div class="bt-biz-dict"
					  data-group="sf_yn"
					  data-biz-name="isSelectBill"
					  data-name="isSelectBillName"
					  data-value="$!{isSelectBill}"
					  data-selecttext="false"
					  data-type="radio"
					  data-callback="bt.selectBillFun"></div>
				</div>
				#if($!{isSelectBill} eq '1')
					<input type="hidden" id="billAccids" name="billAccids" value="" />
					<button class="layui-btn bt-biz-accebillInfo" id="accebillInfoBut" type="button" data-beforeClick="bt.accebillInfoParams" data-callback="bt.accebillInfoCallback">#springMessage('common.button.select')</button>
	##				<button class="layui-btn bt-biz-accebillView" id="accebillViewBut" type="button" data-beforeClick="bt.accebillViewParams" data-callback="bt.accebillViewParams">#springMessage('common.button.view')</button>
				#end

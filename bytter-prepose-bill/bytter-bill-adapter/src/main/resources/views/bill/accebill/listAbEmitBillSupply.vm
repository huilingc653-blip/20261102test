<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
            ## 申请单位
            <td class="textRight" width="8%">#springMessage('bill.accebill.applyCorp')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_applyCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:abemitbillsupply:query"
                         data-callback="applyCorpCallback"
                    >
                    </div>
                </div>
            </td>
        ##票据单位
            <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="corpId"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-scope="all"
                         data-resource="bill:accebill:abemitbillsupply:query"
                    ##data-callback="corpCallback"
                    >
                    </div>
                </div>
            </td>
            ## 业务单位
            <td class="textRight" width="8%">#springMessage('bill.accebill.busCorp')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_busCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:abemitbillsupply:query"
                    >
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##业务人员
            <td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_busPersonnel"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
                </div>
            </td>
            ##票据号码
            <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_origNo"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
                </div>
            </td>
            ##票据类型
            <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE" data-name="eqs_billTypeName"></div>
            </td>
        </tr>
        <tr>
        ##流通介质
            <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_FLAG" data-name="eqs_billFlagName"></div>
            </td>
        ##票据金额
            <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_billMoney" data-moneyendid="endMoney"
                           autocomplete="off" class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_billMoney" id="endMoney"
                           autocomplete="off" class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                </div>
            </td>
        ##开出方式
            <td class="textRight">#springMessage('table.abVoucherinfoVo.openWay')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_OPENWAY" data-name="eqs_insideSingName"></div>
            </td>
        </tr>

        <tr>
        ##承兑人
            <td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" name="likes_acceptor"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptor')">
                </div>
            </td>
        ##出票日期
            <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
            <td >
                <div class="layui-inline"">
                <input type="text" name="ged_startDate" data-name="ged_startDate" class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date">
                </div>
                ~
                <div class="layui-inline"">
                <input type="text" name="led_startDate"　data-name="led_startDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date">
                </div>
            </td>
        ##出票人
            <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" name="likes_payer"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payer')">
                </div>
            </td>
        </tr>
        <tr>
        ##收票人全称
            <td class="textRight">#springMessage('table.abVoucherinfo.payee')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" name="likes_payee"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payee')">
                </div>
            </td>
        ##到期日期
            <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
            <td >
                <div class="layui-inline">
                <input type="text" name="ged_endDate" data-name="ged_endDate" class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                </div>
                ~
                <div class="layui-inline">
                <input type="text" name="led_endDate"　data-name="led_endDate" class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                </div>
            </td>
        ##业务处理状态
            <td class="textRight">#springMessage('table.abAccrecords.status')</td>
            <td >
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_ABEMITBILLSUPPLY_STATUS" data-name="eqs_statusName"></div>
            </td>
        </tr>
        <tr>
        ##开票申请单号
            <td class="textRight">#springMessage('table.abVoucherinfoVice.appNo')</td>
            <td >
                <input type="text" class="layui-input" name="likes_appNo">
            </td>
        ##在线离线标志
            <td class="textRight">#springMessage('bill.accebill.billSendSign')</td>
            <td >
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_SEND_SIGN" data-name="eqs_sendSign" ></div>
            </td>
        ##出票标志
            <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-name="eqs_newStmIssuofpprInd" ></div>
            </td>
        </tr>
        <tr>
        ##是否允许分包
            <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
            <td >
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND" data-name="eqs_blgrdbagcrclPrmtInd" ></div>
            </td>
        ##是否协议出票
            <td class="textRight">#springMessage('table.abVoucherinfo.agreeBillFlg')</td>
            <td >
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_AGREE_BILL_FLG" data-name="likes_agreeBillFlg" data-callback="agreeBillFlgTypeCallback"></div>
                #*<div class="layui-inline">
                    <select lay-filter="agreeBillFlgType" name="agreeBillFlg" >
                        <option value="">#springMessage("common.placeholder.select")</option>
                        #foreach($dict in $dictTag.list("AB_BILL_AGREE_BILL_FLG"))
                                <option value="$dict.code">$dict.name</option>
                        #end

                    </select>
                </div>*#
            </td>
            <td width="8%" class="textRight">#springMessage('table.bill.bankType.payerBankType')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                         data-method="get"
                         data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##票据承兑协议编号
            <td class="textRight accptncagrmtnbClass" style="display:none;">#springMessage('table.abVoucherinfo.accptncagrmtnb')</td>
            <td class="accptncagrmtnbClass" style="display:none;">
                <div class="layui-input-inline">
                    <input type="text" name="likes_accptncagrmtnb" id="agreeBillFlg"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.accptncagrmtnb')">
                </div>
            </td>
        </tr>
            #if($shiro.hasPermission("bill:accebill:abemitbillsupply:query"))
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            #end
        </tbody>
    </table>
</form>

    #if($shiro.hasPermission("bill:accebill:abemitbillsupply:query"))
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.abVoucherinfoVice.appNo')</th>
            <th>#springMessage('table.abVoucherinfo.billType')</th>
            <th>#springMessage('table.abVoucherinfo.billFlag')</th>
            <th>#springMessage('table.abVoucherinfoVo.openWay')</th>
            <th>#springMessage('bill.accebill.applyCorp')</th>
            <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
            <th>#springMessage('bill.accebill.busCorp')</th>
            <th>#springMessage('bill.accebill.busPersonnel')</th>
            <th>#springMessage('table.abVoucherinfo.payer')</th>
            <th>#springMessage('table.abVoucherinfo.acceptor')</th>
            <th>#springMessage('table.abVoucherinfo.origNo')</th>
            <th>#springMessage('table.abVoucherinfo.billMoney')</th>
            <th>#springMessage('table.abVoucherinfo.startDate')</th>
            <th>#springMessage('table.abVoucherinfo.endDate')</th>
            <th>#springMessage('table.abVoucherinfo.payee')</th>
            <th>#springMessage('bill.accebill.billSendSign')</th>
            <th>#springMessage('bill.accebill.emitType')</th>
            <th>#springMessage('bill.accebill.emitGuandisSign')</th>
            <th>#springMessage('table.abAccrecords.status')</th>
            <th>#springMessage('table.abVoucherinfo.Business.Brief.Id')</th>
            <th>#springMessage('bill.accebill.attachment')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #end

    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abEmitBillSupply.list.js?_btv=${resourceVersion}"></script>
</html>

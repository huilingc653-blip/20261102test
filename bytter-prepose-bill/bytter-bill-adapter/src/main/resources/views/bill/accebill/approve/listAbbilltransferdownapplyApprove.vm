<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
		<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
        <table class="layui-table">
            <tbody>
                <tr>
                    ##申请单位
					<td class="textRight">#springMessage('table.abBillTransfer.applyCorp')</td>
					<td width="20%">
						<div class="layui-input-inline">
							<div class="bt-biz-corp"
                                data-biz-type="corp"
                                data-biz-name="corpId"
                                data-type="selectTree"
                                data-name="eqs_recordCorpId"
                                data-scope="all"
								data-resource="sys:flow:query:corpop">
        					</div>
                        </div>
                    </td>
                    ##申请金额
                    <td class="textRight">#springMessage('table.abBillTransfer.applyMoney')</td>
                    <td width="20%">
						<div class="layui-input-inline">
                            <input type="text" name="geg_allocationMoney" data-moneyendid="endMoney"
                                    autocomplete="off" class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                            <span class="date-mid">~</span>
                            <input type="text" name="leg_allocationMoney" id="endMoney"
                                   autocomplete="off" class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                        </div>
                    </td>
					<td width="43%"></td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
            </tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
        <thead>
        <tr>
            <th>#springMessage('table.abBillTransfer.allocatedCode.apply')</th>
    		<th>#springMessage('table.abBillTransfer.applyCorpId')</th>
    		<th>#springMessage('table.abBillTransfer.applyBankAcc')</th>
    		<th>#springMessage('table.abBillTransfer.applyMoney')</th>
            <th>#springMessage('table.abBillTransfer.applyReason')</th>
    		#*<th>#springMessage('table.abBillTransfer.status')</th>*#
    		<th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
	#workFlowHtml()
    #parse("views/common/footer.vm")
	#workFlowScript()
<script src="${basePath}/static/modules/bill/accebill/approve/abBillTransferDownApplyApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

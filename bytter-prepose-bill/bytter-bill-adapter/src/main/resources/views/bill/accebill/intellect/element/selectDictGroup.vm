<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('字典组名称')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="likes_groupName">
                </div>
            </td>
            <td class="textRight">#springMessage('字典组代码')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="likes_groupCode">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <div style="width: 100%;text-align: center">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </div>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table">
    <thead>
    <tr>
        <th>#springMessage('字典组名称')</th>
        <th>#springMessage('字典组代码')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    var datatable;
    bt.use(['form','element', 'datatable'], function () {
        $ = bt.jquery, form = bt.form();

        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            colReorder: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ignoreButtons: ['colvis', 'output', 'print', 'state'],
            checkbox: true,
            mulselect: false,
            ajax: {
                'url': basePath + "/sys/dict/datatableDictGroup.json"
            }
            , columns: [
                {data: "groupName"},
                {data: "groupCode"}
            ]
        });
    });

    /**
     * 返回选中数据
     * @returns {*}
     */
    function getSelectData() {
        return bt.datatable.getSelectData()[0];
    }
</script>
</html>
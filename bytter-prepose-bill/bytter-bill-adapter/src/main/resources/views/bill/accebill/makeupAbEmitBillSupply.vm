<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")

	<style>
		.layui-table {
			margin: 0px 0;
		}
	</style>
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
	<!-- 系统参数 -->
	<input type="hidden" id="isRelateRat" value="$!{isRelateRat}" />
	<input type="hidden" id="ratIsHangGua" value="$!{urationDTO.ratIsHangGua}">
	<input type="hidden" id="isBail" value="$!{isBail}" />
	<input type="hidden" id="bailBankControlType" value="$!{bailBankControlType}" />
	<input type="hidden" id="mouthRat" value="$!{mouthRat}" />
	<input type="hidden" id="curId" name="curCode" value="$!{curId}" />
	<input type="hidden" id="bondId" name="bondId" value="$!{bondId}">
	<input type="hidden" id="isBailModel" name="isBailModel" value="$!{bailmodel}">
	<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
	<input id="defItemCode" name="defItemCode" type="hidden" value="">
	<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
	<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
	<input id="nisBillheadNoBudget" type="hidden" value="$!{nisBillheadNoBudget}">
	<input type="hidden"  name="voucherId" id="voucherId" value="$!{abEmitBillSupplyVo.voucherId}">

	<input type="hidden" name="billStatus" value="$!{abEmitBillSupplyVo.billStatus}">
	<input type="hidden" id="billType" name="billType" value="$!{abEmitBillSupplyVo.billType}">
	<input type="hidden" name="boxStatus" value="$!{abEmitBillSupplyVo.boxStatus}">
	<input type="hidden" name="cnAccrecords" value="$!{abEmitBillSupplyVo.cnAccrecords}">
	<input type="hidden" id="corpId" name="corpId" value="$!{abEmitBillSupplyVo.corpId}">
	<input type="hidden" id="applyCorpId" name="applyCorpId" value="$!{abEmitBillSupplyVo.applyCorpId}">
	<input type="hidden" id="busCorpId" name="busCorpId" value="$!{abEmitBillSupplyVo.busCorpId}">
	<input type="hidden" id="payeeCorpId" value="$!{payeeCorpId}">
	<input type="hidden" id="insideSing" name="insideSing" value="$!{abEmitBillSupplyVo.insideSing}">
	<input type="hidden" name="optStatus" value="$!{abEmitBillSupplyVo.optStatus}">
	<input type="hidden" name="status" value="$!{abEmitBillSupplyVo.status}">
	<input type="hidden" name="applyDate" value="$!{abEmitBillSupplyVo.applyDate}">
	<input type="hidden" id="payeraccOld" value="$!{abEmitBillSupplyVo.payeracc}">
	<input type="hidden" id="payeeaccOld" value="$!{abEmitBillSupplyVo.payeeacc}">
	<input type="hidden" name="vid" value="$!{abEmitBillSupplyVo.vid}">
	<input type="hidden" id="vvid" name="vvid" value="$!{abEmitBillSupplyVo.vvid}">
	<input type="hidden" name="aid" value="$!{abEmitBillSupplyVo.aid}">
	<input type="hidden" id="billFlag" name="billFlag" value="$!{abEmitBillSupplyVo.billFlag}">
	<input type="hidden" id="isOnline" value="$!{isOnline}">
	<input type="hidden" id="sendSign" value="$!{abEmitBillSupplyVo.sendSign}">
	<input type="hidden" id="newStmIssuofpprInd" value="$!{abEmitBillSupplyVo.newStmIssuofpprInd}">

	<input type="hidden" id="isOpenCpRat" value="$!{isOpenCpRat}">
	<input type="hidden" id="curOpenCpRat" value="$!{curOpenCpRat}">
	<input type="hidden" id="acceptProvince" name="acceptProvince">
	<input type="hidden" id="acceptCity" name="acceptCity">
	<input type="hidden" id="acceptBankTypeId" name="acceptBankTypeId">
	<div class="layui-collapse">
		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('bill.accebill.billInfo.title')</h2>
			<div class="layui-colla-content layui-show">
				<table class="layui-table">
					<tbody>
					<tr>
					##开票登记单号
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfoVice.appNo')</td>
						<td width="35%">
							<input type="hidden" name="appNo" id="appNo" value="$!{abEmitBillSupplyVo.appNo}">
							$!{abEmitBillSupplyVo.appNo}
						</td>
						##开票数据来源
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.source')</td>
						<td width="35%">
							$!{abEmitBillSupplyVo.sourceName}
						</td>
					</tr>
					<tr>
						##申请单位
						<td class="textRight">#springMessage('bill.accebill.applyCorp')</td>
						<td>
							($!{abEmitBillSupplyVo.applyCorpCode})$!{abEmitBillSupplyVo.applyCorpName}
						</td>
						##票据单位
						<td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
						<td width="35%">
							($!{abEmitBillSupplyVo.corpCode})$!{abEmitBillSupplyVo.corpName}
						</td>

					</tr>
					<tr>
						##业务单位
						<td class="textRight">#springMessage('bill.accebill.busCorp')</td>
						<td>
							$!{abEmitBillSupplyVo.busCorpName}
						</td>
						##业务人员
						<td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
						<td width="35%">
							<div class="layui-input-inline">
								<input type="text" id="busPersonnel" name="busPersonnel" lay-verify="strlength" data-maxlength="200" value="$!{abEmitBillSupplyVo.busPersonnel}"
									   autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
							</div>
						</td>

					</tr>
					<tr>
						##不得转让标记/能否转让
						<td class="textRight">#springMessage('table.abVoucherinfo.banendrsmtmk')</td>
						<td width="35%">
							<div class="layui-inline">
								<div class="bt-biz-dict" data-type="select" data-group="AB_BANEM" data-name="banendrsmtmk" data-defaultvalue="$!{abEmitBillSupplyVo.banendrsmtmk}" data-placeholder="" data-disabled="true"></div>
							</div>
						</td>
					##流通介质
						<td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
						<td width="35%">
							$!{abEmitBillSupplyVo.billFlagName}
						</td>
					</tr>
					<tr>
					##业务归属日期
						<td class="textRight">#springMessage('table.abAccrecords.businessDate')</td>
						<td >
							<input type="text" name="businessDate" data-name="businessDate" class="layui-input bt-biz-dateType"
								   data-biz-name="businessDate" data-callback="businessDateCallback" data-type="date"
								#if($!{abEmitBillSupplyVo.businessDate} && $!{abEmitBillSupplyVo.businessDate} ne "") value="$!date.format('yyyy-MM-dd',$!{abEmitBillSupplyVo.businessDate})" #else data-today="true" #end>
						</td>
					##票据类型
						<td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
						<td>
							$!{abEmitBillSupplyVo.billTypeName}
						</td>
					</tr>
					<tr>
					##开票方式
						<td class="textRight">#springMessage('bill.accebill.emitType')</td>
						<td>
							<div class="bt-biz-dict" data-type="select" id="emitType" name="emitType"  data-defaultvalue="$!{abEmitBillSupplyVo.emitType}" data-group="ACCEBILL_EMIT_TYPE" data-name="emitType"></div>
						</td>
					##是否开票保贴
						<td class="textRight"><div id="emitGuandisSignText" >#springMessage('bill.accebill.emitGuandisSign')</div></td>
						<td>
							<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-callback="resetBankDiv" id="emitGuandisSign" data-defaultvalue="$!{abEmitBillSupplyVo.emitGuandisSign}" name="emitGuandisSign" data-name="emitGuandisSign" data-biz-name="emitGuandisSign" ></div>
						</td>
					</tr>
					<tr>
					##出票日期
						<td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
						<td >
							<input type="text" id="startDate" name="startDate" data-name="startDate" class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date" lay-verify="required"
								   data-biz-name="startDate" data-callback="checkDate" value="$!date.format('yyyy-MM-dd',$!{abEmitBillSupplyVo.startDate})"
								   placeholder="$!{abEmitBillSupplyVo.startDate}" #if($abEmitBillSupplyVo.billFlag == 11 && ${isOnline} == 1)readonly#end>
						</td>
					##开出方式
						<td class="textRight">#springMessage('table.abVoucherinfoVo.openWay')</td>
						<td>
							$!{abEmitBillSupplyVo.insideSingName}
						</td>
					</tr>
					<tr>
					##到期日期
						<td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
						<td >
							<input type="text" name="endDate" data-name="endDate" class="layui-input bt-biz-dateType" id="endDate" data-type="date" lay-verify="required"
								   data-biz-name="endDate" data-callback="checkDate" value="$!date.format('yyyy-MM-dd',$!{abEmitBillSupplyVo.endDate})"
								   placeholder="$!{abEmitBillSupplyVo.endDate}" #if($abEmitBillSupplyVo.billFlag == 11 && ${isOnline} == 1)readonly#end>
						</td>
					##票据号码
						<td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
						<td>
							<input type="text" id="origNo" name="origNo" lay-verify="required|strlength" data-maxlength="40"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')" value="$!{abEmitBillSupplyVo.origNo}">
						</td>
					</tr>
					<tr>
					##票据金额
						<td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
						<td>
							<input type="text" id="billMoney" name="billMoney" data-id="billMoney" readonly="readonly" data-toup="moneyUp"
								   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')" value="$!{abEmitBillSupplyVo.billMoney}">
						</td>
					##人民币大写
						<td class="textRight">#springMessage('table.abVoucherinfo.billMoneyUp')</td>
						<td>
							<div class="layui-input-inline layui-input" id="moneyUp"></div>
						</td>
					</tr>
					<tr>
					##出票标志
						<td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
						<td>
							<div class="layui-inline">
								<div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-name="newStmIssuofpprInd" data-defaultvalue="$!{abEmitBillSupplyVo.newStmIssuofpprInd}" data-placeholder="" data-disabled="true"></div>
							</div>
						</td>
					##是否允许分包
						<td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
						<td>
							<div class="bt-biz-dict" data-type="radio" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND" data-callback="resetBankDiv" id="blgrdbagcrclPrmtInd" data-defaultvalue="$!{abEmitBillSupplyVo.blgrdbagcrclPrmtInd}" name="blgrdbagcrclPrmtInd" data-name="blgrdbagcrclPrmtInd" data-biz-name="blgrdbagcrclPrmtInd" ></div>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>

	<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.accebill.payer.title')</h2>
		<div class="layui-colla-content layui-show">
			<table class="layui-table">
				<tbody>
				<tr>
				##出票人账号
					<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payeracc')</td>
					<td width="35%">
						#if($abEmitBillSupplyVo.billFlag == 11 && ${isOnline} == 1 )
							<input type="text" name="payeracc" readonly="readonly" autocomplete="off" class="layui-input" value="$!{abEmitBillSupplyVo.payeracc}">
						#else
							<div class="layui-input-inline">
								<input type="text" id="payeracc" name="payeracc" data-name="payeracc" data-biz-name="payeracc" data-maxlength="30"
								##纸票或第三方票据类型的出票人账号可以选填否则必填
									#if($!{abEmitBillSupplyVo.billFlag} == "10" || $!{abEmitBillSupplyVo.isBillTypeTP}=="1" )
									   lay-verify="strlength"
									#else
									   lay-verify="strlength|required"
									#end
									   data-resource="bill:accebill:abemitbill:query" data-defaultcorp = "$!{abEmitBillSupplyVo.corpId}" electricBill="1" value="$!{abEmitBillSupplyVo.payeracc}"
									   class="bank layui-input bt-biz-accountTable" data-callback="accountPayerCallBack" />
							</div>
						#end
					</td>
				##出票人
					<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payer')</td>
					<td width="35%" id="payerName">
						<input type="text" id="payer" name="payer" class="layui-input" value="$!{abEmitBillSupplyVo.payer}"
							   readonly="readonly" lay-verify="required" >
					</td>
				</tr>
				<tr>
				##出票人开户银行名称
					<td class="textRight">#springMessage('table.abVoucherinfo.payerBankName')</td>
					<td >
						<input type="text" name="payerBankName" id="payerBankName" class="layui-input" value="$!{abEmitBillSupplyVo.payerBankName}"
							   lay-verify="strlength" data-maxlength="240"
							#if($!{abEmitBillSupplyVo.billFlag} == "11" && ${isOnline} == 1) readonly="readonly" #end >
					</td>
				##出票人开户银行行号
					<td class="textRight">#springMessage('table.abVoucherinfo.payerbankno')</td>
					<td >
						<input type="text" name="payerbankno" id="payerbankno" class="layui-input" value="$!{abEmitBillSupplyVo.payerbankno}"
							   lay-verify="strlength" data-maxlength="30"
							#if($!{abEmitBillSupplyVo.billFlag} == "11" && ${isOnline} == 1) readonly="readonly" #end >
					</td>
				</tr>
				<tr>
				##出票人统一识别号码
					<td class="textRight">#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')</td>
					<td >
						<input type="text" name="blRmtrUnnIdNo" id="blRmtrUnnIdNo" class="layui-input" value="$!{abEmitBillSupplyVo.blRmtrUnnIdNo}"
							   lay-verify="strlength" data-maxlength="240" readonly="readonly">
					</td>
					<td class="textRight"></td>
					<td >
					</td>
				</tr>
				</tbody>
			</table>
		</div>
	</div>

	<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.accebill.payee.title')</h2>
		<div class="layui-colla-content layui-show">
			<table class="layui-table">
				<tbody>
					#if(($!{abEmitBillSupplyVo.billFlag}==10 || $!{abEmitBillSupplyVo.isBillTypeTP}=="1") && $!{abEmitBillSupplyVo.insideSing}==1)
					##纸票或第三方票据时且对内时收票人账号可编辑
					<tr id="corpPayee">
					##收票人单位
						<td class="textRight" width="15%">#springMessage('table.abBillTransfer.recevieCorpId')</td>
						<td width="35%">
						##收票人全称--成员单位
                            $!{abEmitBillSupplyVo.payee}
						</td>
						<td width="15%"></td>
						<td width="35%"></td>
					</tr>
					<tr>
					##收票人
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payee')</td>
						<td width="35%">
							<input type="hidden" name="payee" value="$!{abEmitBillSupplyVo.payee}" readonly="readonly" >
							$!{abEmitBillSupplyVo.payee}
						</td>
					##收票人账号--成员单位
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payeeacc')</td>
						<td width="35%">
							<input type="text" id="payeeacc" name="payeeacc" data-name="payeeacc" data-biz-name="payeeacc"
								   data-maxlength="30" class="bank layui-input bt-biz-accountTable"
								   data-callback="onChangePayeeacc" data-defaultcorp = "$!{payeeCorpId}" electricBill="1"
								#if($!{abEmitBillSupplyVo.billFlag}=="10" || $!{abEmitBillSupplyVo.isBillTypeTP}=="1")
								   lay-verify="strlength"
								#else
								   lay-verify="required|strlength"
								#end
							/>
						</td>
					</tr>
					<tr>
					##收票人开户银行名称
						<td class="textRight">#springMessage('table.abVoucherinfo.payeeBankName')</td>
						<td >
							<input type="text" class="layui-input" id="payeeBankName" name="payeeBankName"
								   value="$!{abEmitBillSupplyVo.payeeBankName}"
								   lay-verify="strlength" data-maxlength="240"
								#if($!{abEmitBillSupplyVo.billFlag} == "11" && $!{abEmitBillSupplyVo.isBillTypeTP}=="0") readonly="readonly" #end >
						</td>
					##收票人开户银行行号
						<td class="textRight">#springMessage('table.abVoucherinfo.payeebankno')</td>
						<td >
							<input type="text" class="layui-input" id="payeebankno" name="payeebankno"
								   value="$!{abEmitBillSupplyVo.payeebankno}"
								   lay-verify="strlength" data-maxlength="30"
								#if($!{abEmitBillSupplyVo.billFlag} == "11" && $!{abEmitBillSupplyVo.isBillTypeTP}=="0") readonly="readonly" #end >
						</td>
					</tr>
					#else
					<tr>
					##收票人全称
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payee')</td>
						<td width="35%">
							<input type="hidden" name="payee" value="$!{abEmitBillSupplyVo.payee}">
							$!{abEmitBillSupplyVo.payee}
						</td>
					##收票人账号
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payeeacc')</td>
						<td width="35%">
							<input type="hidden" name="payeeacc" value="$!{abEmitBillSupplyVo.payeeacc}">
							$!{abEmitBillSupplyVo.payeeacc}
						</td>
					</tr>
					<tr>
					##收票人开户银行名称
						<td class="textRight">#springMessage('table.abVoucherinfo.payeeBankName')</td>
						<td >
							<input type="hidden" name="payeeBankName" value="$!{abEmitBillSupplyVo.payeeBankName}">
							$!{abEmitBillSupplyVo.payeeBankName}
						</td>
					##收票人开户银行行号
						<td class="textRight">#springMessage('table.abVoucherinfo.payeebankno')</td>
						<td >
							<input type="hidden" name="payeebankno" value="$!{abEmitBillSupplyVo.payeebankno}">
							$!{abEmitBillSupplyVo.payeebankno}
						</td>
					</tr>
					#end
				</tbody>
			</table>
		</div>
	</div>

	<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.accebill.acceptor.title')</h2>
		<div class="layui-colla-content layui-show">
			<table class="layui-table">
				<tbody>
				<tr>
					<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.acceptor')</td>
					<td width="35%">
					##承兑人
						<div class="layui-input-inline">
							<input type="text" id="acceptor" name="acceptor" lay-verify="required|strlength" value="$!{abEmitBillSupplyVo.acceptor}"
								   data-maxlength="240"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptor')" readonly="readonly">
							#if($abEmitBillSupplyVo.billFlag == 10 || $!{abEmitBillSupplyVo.isBillTypeTP}=="1" || ${isOnline} == 0 )##纸票
								#if($abEmitBillSupplyVo.billType == 10)##银票
									<div class="bt-div-search" id="acceptorBankButtonDiv">
									##银票按钮
										<button class="bt-biz-bankInfo" type="button" data-callback="bt.bailBankInfoCallback"><i class="layui-icon">&#xe615;</i></button>
									</div>
								#else
								##商票按钮
									<div class="bt-div-search" id="acceptorCustomerButtonDiv">
										<button class="bt-biz-externalCorpBankAcc" type="button" data-callback="bt.acceptorCorpCallback"
												data-beforeClick="bt.externalCorpBankAccParams">
											<i class="layui-icon">&#xe615;</i></button>
									</div>
								#end
							#end
						</div>
					</td>
				##承兑人账号
					<td class="textRight">#springMessage('table.abVoucherinfo.acceptoracc')</td>
					<td width="35%">
					##承兑人账号--客商或银行
						<input type="text" id="acceptoracc" name="acceptoracc" value="$!{abEmitBillSupplyVo.acceptoracc}" data-maxlength="30"
							   autocomplete="off" class="bank layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptoracc')"
						##纸票或第三方票据时的商票时承兑人账号可以选填否则必填
							#if($!{abEmitBillSupplyVo.billFlag} == "10" || $!{abEmitBillSupplyVo.isBillTypeTP}=="1")
							   lay-verify="strlength"
							#else
							   lay-verify="strlength|required"
							#end
							#if($!{abEmitBillSupplyVo.billFlag} == "11" && ${isOnline} == 1 ) readonly="readonly" #end >
						<div class="bt-div-search" id="acceptoraccCorpDiv" style="display:none">
						##承兑人账号--成员单位
							<input type="hidden" id="acceptoraccCorp" data-name="acceptoraccCorp" data-biz-name="acceptoraccCorp"
								   data-defaultcorp = "xx" electricBill="1"
								   class="bank layui-input bt-biz-accountTable" data-callback="accountAcceptorCallBack"
							##纸票的商票时承兑人账号可以选填否则必填

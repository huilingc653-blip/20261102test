<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('bill.intellect.ruleGroup.name')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="likes_ruleGroupName">
                </div>
            </td>
            <td class="textRight">#springMessage('bisAccAttribute.validSign')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-name="eqs_validSign" data-biz-name="validSign">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4">
                <div style="width: 100%;text-align: center">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </div>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table">
    <thead>
    <tr>
        <th>#springMessage('bill.intellect.ruleGroup.code')</th>
        <th>#springMessage('bill.intellect.ruleGroup.name')</th>
        <th>#springMessage('bisAccAttribute.rmk')</th>
        <th>#springMessage('bisAccAttribute.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/intellect/ruleGroup/ruleGroup.list.js?_btv=${resourceVersion}"></script>

</html>
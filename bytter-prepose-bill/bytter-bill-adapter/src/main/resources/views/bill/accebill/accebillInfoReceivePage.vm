<script type="text/javascript">
var billTable={};
var moneyType={};
var dicts={};
var users={};
var corp={};
var idsValArray=[];
var balanceValArray=[];
var objValArray=[];
bt.use(['form','jquery','select','element','datatable','dicts','corp','dateType','moneyType','users','moneyType','btImport'], function(){
    $ = bt.jquery,form = bt.form();
    moneyType = bt.moneyType.init();
	var element = bt.element();
	bt.dateType.init();
    corp=bt.corp.init();
    dicts=bt.dicts.init();
    users=bt.users.init();
	//生成列表
    billTable = bt.datatable.init({
        elem: "#appTable",
        dom: 'Brtlip',
        colReorder: true,
        checkbox: true,
        mulselect: #if($!{params.batchPay} eq '1') false #else true  #end,
        order: [3,'desc'],
        searchForm: {
            formElem: "#searchForm",
            formFilter: "search"
        },
        ajax: {
            'url': basePath+"/bill/accebill/abvoucherinfoVice/accebillInfoDatatable"
        },
        buttons: [
            {
                text:bt.lang('common.button.select'),
                action: function ( e, dt, node, config ) {
                    bt.selectOp();
                }
            },{
                text: bt.lang('common.button.importsSelect'),
                sort:'51',
                action: function ( e, dt, node, config ) {
                    importExcel();
                }
            }
        ]
        ,columns: [
            {data:"corpName",bSortable:true},
            {data:"bankAcc",bSortable:true},
            {data:"origNo",bSortable:true},
            {data:"billMoney",bSortable:true,className:'textRight',
                render: function ( data, type, full, meta ) {
                    return bt.money.format(full.billMoney);
                }
            },
            {data:"availableMoney",bSortable:true,className:'textRight',
                render: function ( data, type, full, meta ) {
                    return bt.money.format(full.availableMoney);
                }
            },
            {data:"billTypeName",bSortable:true},
            {data:"billFlagName",bSortable:true},
            {data:"startDate",bSortable:true},
            {data:"endDate",bSortable:true},
            {data:"expireDays",bSortable:true},
            {data:"payer",bSortable:true},
            {data:"acceptor",bSortable:true},
            {data:"payee",bSortable:true},
            #if($!{params.isPayed} eq '1')
                {data:"recNm",bSortable:true},
            #end
            {data:"briefIdName",bSortable:true},
            {data:"bpName",bSortable:true},
            {data:"inoutTypeName",bSortable:true},
            {data:"poolStatusName",bSortable:true},
            {data:"sourceName",bSortable:true},
            {data:"blRmtrUnnIdNo",bSortable:true},
            {data:"newStmIssuofpprIndName",bSortable:true},
            {data:"blgrdbagcrclPrmtIndName",bSortable:true},
            {data:"sbbllRngStrtSn",bSortable:true},
            {data:"sbbllRngEndSn",bSortable:true},
            {data:"blStdAmt",bSortable:true,className:'textRight',
                render: function ( data, type, full, meta ) {
                    return bt.money.format(full.blStdAmt);
                }
            },
            {data:"banendrsmtmkName",bSortable:true},
            {data:"onlineHandleName",bSortable:true},
            {data:"oldSelectSign",bSortable:true},
            #if($!{params.isPayed} eq '1')
                {data:"balance",bSortable:true,className:'textRight',
                    render: function ( data, type, full, meta ) {
                        if(full.balance == null || full.balance == undefined){
                            full.balance = full.billMoney;
                        }
                        var maxMn=full.balance;
                        var mn=getBalanceValById(full.id,full.balance);
                        if(mn!=full.balance){
                            full.balance=mn
                        }
                        return '<input lay-verify="required" style="width: 100px" class="layui-input bt-input-inline bt-biz-moneyType trans-money-input" readonly="readonly" ' +
                                'value="'+bt.money.format(mn)+'" type="text" data-decimal="2" data-max="' + maxMn + '"' +
                                'data-id="balance_'+full.vid+'" data-name="balance_'+full.vid+'" data-key="'+full.vid+'" data-biz-name="balance_'+full.vid+'" />';
                    }
                },
            #else
                {data:"balance",bSortable:true,className:'textRight',width: 120,
                    render: function ( data, type, full, meta ) {
                        if(full.balance == null || full.balance == undefined){
                            full.balance = full.billMoney;
                        }
                        var maxMn=full.balance;
                        var mn=getBalanceValById(full.id,full.balance);
                        if($("#batchPay").val()=='1'){
                            mn=$("#batchPayMoney").val()
                        }
                        if(mn!=full.balance){
                            full.balance=mn
                        }
                        if (full.newStmIssuofpprInd === '1' && full.blgrdbagcrclPrmtInd === '1' && $("#batchPay").val()!='1') {
                            return '<input lay-verify="required" style="width: 100px" class="layui-input bt-input-inline bt-biz-moneyType trans-money-input" readonly="readonly" ' +
                                    'value="'+bt.money.format(mn)+'" type="text" data-decimal="2" data-min="0.01" data-max="' + maxMn + '"' +
                                    'data-id="balance_'+full.vid+'" data-name="balance_'+full.vid+'" data-key="'+full.vid+'" data-biz-name="balance_'+full.vid+'" />';
                        }
                        return  bt.money.format(mn)+'<input lay-verify="required" type="hidden" style="width: 100px" class="layui-input bt-input-inline bt-biz-moneyType trans-money-input" ' +
                                'value="'+bt.money.format(mn)+'" type="text" data-decimal="2" data-max="' + maxMn + '"' +
                                'data-id="balance_'+full.vid+'" readonly="readonly" data-name="balance_'+full.vid+'" data-key="'+full.vid+'" data-biz-name="balance_'+full.vid+'" />';
                    }
                }
            #end
        ],
        btClickRowCallback:function(data){
            for(var i = 0; i<data.length; i++){
                if(data[i].newStmIssuofpprInd === '1'){
                    // 交易金额字段赋值
                    data[i].balance = $("#balance_" + data[i].vid).val();
                }
            }
            opIdsValArray(data);
        },
        btInitComplete:function(setting, json){
            resetSumMoney();
        },
        btDrawCallback:function(setting){
            bt.moneyType.init();
            //idsValArray = []
            if(idsValArray.length>0) {
                bt.datatable.onCheckRow("appTable", {
                    "key": "id",
                    "value": idsValArray,
                    "checked": true
                });
            }
            /*balanceValArray = []
            objValArray = []
            sumMoney = 0;
            var showHTML=bt.lang("sys.common.isSelectSize",[idsValArray.length])+","+bt.lang("sys.common.isSelectMoney",[bt.money.format(sumMoney)]);
            $('#appTable_info').append('<span id="sumMoneyBillSpan" style="color: red">'+showHTML+'</span>');*/
            resetSumMoney();
        },
        fixedColumns: {
            rightColumns: 1
        },
		summary:{
			pageSum:true,
            selectSum:true,
            //outerData: true,
            sumList:[
                {
                    colNum:'4',
                    dataName:'billMoney'
                },
                {
                    colNum:'5',
                    dataName:'availableMoney'
                },
                {
                    colNum:'10',
                    dataName:'balance'
                }
            ]
		}
    });

// 表格输入框离开事件，更新表格汇总功能
    var timeId = null
    $("#appTable").on("blur",".trans-money-input",function () {
        var that = this
        if(timeId){
            clearTimeout(timeId);
            timeId = null
        }
        timeId = setTimeout(function () {
            var key = $(that).data("key");
            var tableData = $("#appTable").DataTable().rows().data()
            if(key && tableData && tableData.length){
                for (var i = 0; i < tableData.length; i++) {
                    if(tableData[i].vid === key && tableData[i].balance!=$("#balance_"+key).val()){
                        tableData[i].balance = $("#balance_"+key).val();
                        var index=idsValArray.indexOf(tableData[i].id);
                        if(index!=-1){
                            balanceValArray[index]=tableData[i].balance;
                            objValArray[index].balance=tableData[i].balance;
                            resetSumMoney();
                            bt.datatable.updateSummary("#appTable");
                        }
                        break
                    }
                }
            }
        },50)

    })

	bt.selectOp = function(){
        var datas=objValArray;
		var len = datas.length;
        if(!len){
            layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 7});
        	return;
        }
        // 挂接付款金额不能为空
        for(var i=0;i<balanceValArray.length;i++){
            if (balanceValArray[i] != 0 && !balanceValArray[i]) {
                layer.alert(bt.lang('table.abVoucherinfo.balance.not.null'), {icon: 2})
                return;
            }
        }
		var sumMoney=0;
        var isSelectNewBill = "0";
		var ids=idsValArray.join(",");
        var balances=balanceValArray.join(",");
		for(var i=0;i<len;i++){
			sumMoney=bt.moneyType.getFun().add(sumMoney,datas[i].balance);
            // 是否选择了新系统票据
            if (datas[i].newStmIssuofpprInd === '1') {
                isSelectNewBill = "1";
            }
		}
        var currentParentIframe = top.$('.layui-tab-content > .layui-show').find('iframe')[0]['name'];
        var func = top.frames[currentParentIframe].window.btSelectCallBack['bt-biz-accebillInfoReceive']['callback'];
        if(func){
			var data={"sumMoney":sumMoney,"ids":ids,"balances":balances,"isSelectNewBill":isSelectNewBill,"data":datas};
            func(data);
        }
	}
    //导入已选数据
    var importExcel = function () {
        bt.btImport.init({
            code: "512880455c5dcd90015c5d0abillpage",
            // hideDownTempBtn: true,
            isShowData: false,
            height: '200px',//弹出框高度
            titleRows: 1,
            headRows: 1,
            success: function (head,data,select) {
                if(data && data.length >0){
                    var origNos="";
                    for(var i=0;i<data.length;i++){
                        if(data[i].origNo){
                            if(origNos){
                                origNos+=","+data[i].origNo;
                            }else{
                                origNos=data[i].origNo;
                            }
                        }
                    }
                    $("#origNo").val(origNos);
                    idsValArray=[];
                    objValArray=[];
                    initCacheObjInfo(null,origNos);
                    $("#ids").val(idsValArray.join(","));
                }
                billTable.draw();
            }
        });
    };
});
var closeForms=function(){
	parent.layer?parent.layer.closeAll():layer.closeAll();
}

var bifCodes = $("#bifCodes").val().split(',');

var initIdVal=function (){
    var idsVal=$("#ids").val();
    if(idsVal){
        var billBalanceVal=$("#billBalance").val();
        if(billBalanceVal){
            var idsVals=idsVal.split(',');
            var billBalanceVals=billBalanceVal.split(',');
            idsValArray=idsVals;
            balanceValArray=billBalanceVals;
        }
        initCacheObjInfo(idsVal,null);
    }
}

var initCacheObjInfo=function(idsVal,origNos){
    var formdata={};
    formdata.resource=$("#resource").val();
    if(!formdata.resource&&$("#corpId").val()){
        formdata.ins_corpId=$("#corpId").val();
    }
    formdata.payId=$("#payId").val();
    formdata.oldIds=$("#oldIds").val();
    formdata.isEmitBill=$("#isEmitBill").val();
    formdata.isPayed=$("#isPayed").val();
    if(idsVal){
        formdata.selectIds=idsVal;
    }else if(origNos){
        formdata.origNo=origNos;
    }else{
        return;
    }
    formdata.isCatchData='1';
    // 异步获取已选默认值数据缓存
    $.ajax({
        url:basePath+"/bill/accebill/abvoucherinfoVice/accebillInfoDatatable",
        type: 'post',
        data: JSON.stringify({"formdata" : formdata,"length":1000,"start": 0}),
        contentType: 'application/json',
        async: false,
        dataType:'json',
        success:function (result) {
            if(result && result.data) {
                if (balanceValArray
                        && balanceValArray.length>0) {
                    for(var i=0;i<idsValArray.length;i++){
                        var idIsNot=true;
                        for (var j = 0; j < result.data.length; j++) {
                            if(result.data[j].id==idsValArray[i]){
                                if(result.data[j].balance == null || result.data[j].balance == undefined){
                                    result.data[j].balance=result.data[j].billMoney;
                                }
                                if(result.data[j].balance!=balanceValArray[i]){
                                    result.data[j].balance=balanceValArray[i];
                                }
                                objValArray.push(result.data[j]);
                                idIsNot=false;
                                break;
                            }
                        }
                        if(idIsNot){
                            objArrayRemove(idsValArray,i);
                            objArrayRemove(balanceValArray,i);
                            i--;
                        }
                    }
                } else {
                    for (var i = 0; i < result.data.length; i++) {
                        idsValArray.push(result.data[i].id);
                        objValArray.push(result.data[i]);
                        if(result.data[i].balance == null || result.data[i].balance == undefined){
                            result.data[i].balance=result.data[i].billMoney;
                        }
                        balanceValArray.push(result.data[i].balance);
                    }
                }
                resetSumMoney();
            }
        }
    });
}

var resetSumMoney = function(){
    var sumMoney = 0;
    if(balanceValArray&&balanceValArray.length>0){
        for (var i = 0; i < balanceValArray.length; i++) {
            sumMoney = bt.money.add(sumMoney, balanceValArray[i]);
        }
    }
    setSumMoney(sumMoney);
}

var setSumMoney = function (sumMoney){
    var nisBillHeadPayMoney=$("#nisBillHeadPayMoney").val();
    var showHTML;
    if(nisBillHeadPayMoney){
        showHTML=bt.lang("sys.common.currentPayMoney",[bt.money.format(nisBillHeadPayMoney)])+","+bt.lang("sys.common.isSelectSize",[idsValArray.length])+","+bt.lang("sys.common.isSelectMoney",[bt.money.format(sumMoney)]);
    }else{
        showHTML=bt.lang("sys.common.isSelectSize",[idsValArray.length])+","+bt.lang("sys.common.isSelectMoney",[bt.money.format(sumMoney)]);
    }
    if($("#sumMoneyBillSpan").text()!=''){
        $("#sumMoneyBillSpan").text(showHTML);
    }else{
        $('#appTable_info').append('<span id="sumMoneyBillSpan" style="color: red">'+showHTML+'</span>');
    }
}

var setBalanceValById = function (id,mn){
    if(idsValArray&&idsValArray.length>0){
        var index=idsValArray.indexOf(id);
        if(index!=-1 && balanceValArray
                && balanceValArray.length==idsValArray.length){
            balanceValArray[index]=mn;
        }
    }
}

var getBalanceValById = function (id,mn){
    if(idsValArray&&idsValArray.length>0){
        var index=idsValArray.indexOf(id);
        if(index!=-1 && balanceValArray && balanceValArray.length==idsValArray.length){
            return balanceValArray[index];
        }
    }
    return mn;
}

// 查找指定的元素在数组中的位置
Array.prototype.indexOf = function(val) {
    for (var i = 0; i < this.length; i++) {
        if (this[i] == val) {
            return i;
        }
    }
    return -1;
}

var objArrayRemove = function(obj,index){
    if (index > -1) {
        obj.splice(index, 1);
    }
};

var opIdsValArray = function(datas){
    if(datas&&datas.length>0){
        for(i=0;i<datas.length;i++){
            if(datas[i].isSelect){
                if(datas[i].poolStatus==1){
                    if(bifCodes.indexOf(datas[i].bifCode)<0){
                        bt.datatable.onCheckRow("appTable", {
                            "key": "id",
                            "value": [datas[i].id],
                            "checked": false
                        });
                        layer.alert(bt.lang("请先将票据出池后再处理！"), {icon: 3});
                        return;
                    }else{
                        if(idsValArray.indexOf(datas[i].id)<0){
                            idsValArray.push(datas[i].id);
                            balanceValArray.push(datas[i].balance);
                            objValArray.push(datas[i]);
                        }
                    }
                }else{
                    if($("#batchPay").val()=='1'){
                        idsValArray=[];
                        balanceValArray=[];
                        objValArray=[];
                    }
                    var index=idsValArray.indexOf(datas[i].id);
                    if(index<0){
                        idsValArray.push(datas[i].id);
                        if (datas[i].balance === 0){
                            balanceValArray.push(0.00);
                        } else {
                            balanceValArray.push(datas[i].balance);
                        }
                        objValArray.push(datas[i]);
                    }
                }
            }else{
                var index=idsValArray.indexOf(datas[i].id);
                if(index > -1){
                    objArrayRemove(objValArray,index);
                    objArrayRemove(idsValArray,index);
                    objArrayRemove(balanceValArray,index);
                }
            }
        }
        $("#ids").val(idsValArray.join(","));
        resetSumMoney();
    }
};

//弹框处理中文乱码赋值
var getQueryReceiveParams=function(data){
    if(data){
        if(data.payee&&data.isEmitBill==1){
            $("#payeeId").val(data.payee);
        }
        if(data.endorse&&data.isPayed==1){
            $("#endorseId").val(data.endorse);
        }
        if(data.resource){
            $("#resource").val(data.resource);
        }
        if(data.ids){
            $("#ids").val(data.ids);
        }
        if(data.payId){
            $("#payId").val(data.payId);
        }
        if(data.billBalance){
            $("#billBalance").val(data.billBalance);
        }
        if(data.oldIds){
            $("#oldIds").val(data.oldIds);
        }
        if(data.oldBillBalance){
            $("#oldBillBalance").val(data.oldBillBalance);
        }
        initIdVal();
    }
};
</script>
</body>
</html>

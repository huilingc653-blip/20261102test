
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	.layui-table {
            margin: 0px 0;
		}
    </style>
</head>
<body>
	#if(${info.briefId} eq '023')
	#parse("views/bill/accebill/approve/viewApproveAbBillBase.vm")
	#else
	#parse("views/bill/accebill/viewBusOpAbBillReceivebizBase.vm")
	#end
	
	<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
    <legend>#springMessage('bill.logInfo.title')</legend>
    </fieldset>
	<div>
	<table class="layui-table layui-form dark-layui-table" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.abLog.logType')</th>
			<th>#springMessage('table.abLog.briefId')</th>
            <th>#springMessage('table.abLog.msg')</th>
            <th>#springMessage('table.abLog.createName')</th>
            <th>#springMessage('table.abLog.createBy')</th>
            <th>#springMessage('table.abLog.createDate')</th>
        </tr>
        </thead>
	   <body>
			#if($!abLogPage)
			#foreach($abLog in $abLogPage)
			<tr>
            <td>$!{abLog.logTypeName}</td>
			<td>$!{abLog.briefIdName}</td>
            <td>#springMessage($!{abLog.msg})</td>
            <td>$!{abLog.createName}</td>
            <td>$!{abLog.createBy}</td>
            <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{abLog.createDate})</td>
			</tr>
            #end
            #end
        </body>
	</table>
    </div>
<div class="layui-form-item layui-form-submit" id="buttonDiv">
	<div class="layui-input-block">
		<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{info.acid}')">#springMessage('common.button.trackFlow')</button>
		<button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
	</div>
</div>
</body>
</html>
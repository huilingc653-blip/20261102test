<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        html,body,form,iframe,.layui-tab,.layui-tab-content,.layui-tab-item {
            height: 100%;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post" >
    <div class="layui-tab layui-tab-brief" lay-filter="billPay">
        <ul class="layui-tab-title">
            <li class="layui-this" data-id="applyiframe">#springMessage('common.button.cashing')</li>
            <li data-id="trackiframe">#springMessage('common.button.track')</li>
        </ul>
        <div class="layui-tab-content">
            ##兑付申请列表信息
            <div class="layui-tab-item layui-show">
                ##申请列表信息
                <iframe id="applyiframe" src="${basePath}/bill/accebill/abemitbillpay/adEmitBillPayApplyList" frameborder="0" style="min-height:1100px;width: 100%;" name="applyiframe" ></iframe>
            </div>
            <div class="layui-tab-item" id="trackiframeBox">
                ##跟踪列表信息
               ## <iframe id="trackiframe" src="" frameborder="0" style="width: 100%;" name="trackiframe"></iframe>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abEmitBillPay.list.js?_btv=${resourceVersion}"></script>
#if(${pageContent} eq 'abEmitBillPayApply')
##<script src="${basePath}/static/modules/bill/accebill/abEmitBillPayApply.list.js?_btv=${resourceVersion}"></script>
#else
##<script src="${basePath}/static/modules/bill/accebill/abEmitBillPayTrack.list.js?_btv=${resourceVersion}"></script>
#end
</html>









<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ## 申请单位
                        <td width="8%" class="textRight">#springMessage('bill.accebill.applyCorp')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_applyCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:abBillInstruction:query"
                                     data-callback="applyCorpCallback"
                                >
                                </div>
                            </div>
                        </td>
                        ## 票据单位
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-name="corpId"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_corpId"
                                     data-resource="bill:accebill:abBillInstruction:query"
                                     data-scope="all"
                                >
                                </div>
                            </div>
                        </td>
                        ## 业务单位
                        <td width="8%" class="textRight" >#springMessage('bill.accebill.busCorp')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_busCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:abBillInstruction:query"
                                >
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##业务人员
                        <td width="8%" class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_busPersonnel"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
                            </div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.billMoney')</td>
                        <td width="25%">
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text"
                                   data-name="geg_billMoney" data-moneyendid="leg_billMoney">
                            <span class="date-mid">~</span>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_billMoney" type="text"
                                   data-name="leg_billMoney">
                        </td>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.business.recNm')</td>
                        <td width="25%">
                            <input type="text" name="likes_recNm"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('bill.accebill.business.recNm')">
                        </td>
                    </tr>
                    <tr>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.origNo')</td>
                        <td width="25%">
                            <input type="text" name="likes_origNo"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('bill.accebill.origNo')">
                        </td>
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                        <td width="25%">
                            <div id="startDate"></div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.business.recAcctId')</td>
                        <td width="25%">
                            <input type="text" name="likes_recAcctId"
                                   autocomplete="off" class="bank layui-input"
                                   placeholder="#springMessage('bill.accebill.business.recAcctId')">
                        </td>
                    </tr>
                    <tr>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.billType')</td>
                        <td width="25%">
                            <div class="bt-biz-dict" data-group="AB_BILL_TYPE" data-name="eqs_billTypeName"
                                 data-type="select"></div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                        <td width="25%">
                            <div id="endDate"></div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.InstructionStatus')</td>
                        <td width="25%">
                            <div class="bt-biz-dict" data-group="AB_BILL_INSOPTSTATUS" data-name="ins_optStatusName"
                                 data-type="mulselect"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="8%" class="textRight">#springMessage('table.abAccrecords.briefId')</td>
                        <td width="25%">
                            <div class="bt-biz-dict" data-group="AB_BILL_INSBRIEFID" data-name="ins_briefIdName"
                                 data-type="mulselect"></div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.bussdt')</td>
                        <td width="25%">
                            <div id="applyDate"></div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.billpayerpayeetype')</td>
                        <td width="25%">
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="select" data-name="eqs_type"
                                     data-group="BILL_PAYERPAYEE_TYPE"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##出票标志
                        <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
                            </div>
                        </td>
                        ##票据是否允许分包
                        <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND" data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
                            </div>
                        </td>
                        ##开票批次号
                        <td class="textRight">#springMessage('bill.accebill.batchNo')</td>
                        <td >
                            <input type="text" class="layui-input" name="likes_batchNo">
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('table.bill.bankType.holderBankType')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                                     data-method="get"
                                     data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                                     data-inputvalue="inputvalue" data-search="true"></div>
                            </div>
                        </td>
                        ##子票区间号码
                        <td class="textRight">#springMessage('bill.accebill.sti')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" name="likes_sbbllRngStrtSn"
                                       autocomplete="off" class="layui-input" maxlength="12"
                                       placeholder="#springMessage('table.abVoucherinfo.sbbllRngStrtSn')">
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" name="likes_sbbllRngEndSn"
                                       autocomplete="off" class="layui-input" maxlength="12"
                                       placeholder="#springMessage('table.abVoucherinfo.sbbllRngEndSn')">
                            </div>
                        </td>
                        ##票据单位账号
                        <td class="textRight">#springMessage('table.abVoucherinfoVice.bankAcc')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" id="bankAcc" name="likes_bankAcc"
                                       autocomplete="off" class="layui-input bt-biz-accountTable" data-biz-name="bankAcc" data-name="bankAcc" data-callback="bankAccCallBack" placeholder="#springMessage('table.abVoucherinfoVice.bankAcc')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            #if($shiro.hasPermission("bill:accebill:abBillInstruction:query"))
                                <div class="layui-inline">
                                    <button class="layui-btn" lay-submit lay-filter="search"
                                            type="button">#springMessage('common.button.search')</button>
                                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                        'common.button.reset')</button>
                                </div>
                            #end
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>

    #if($shiro.hasPermission("bill:accebill:abBillInstruction:query"))
    <table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
        <thead>
        <tr>
            <th>#springMessage('bill.accebill.applyCorp')</th>
            <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
            <th>#springMessage('table.abVoucherinfoVice.bankAcc')</th>
            <th>#springMessage('bill.accebill.busCorp')</th>
            <th>#springMessage('bill.accebill.busPersonnel')</th>
            <th>#springMessage('bill.accebill.origNo')</th>
            <th>#springMessage('bill.accebill.billType')</th>
            <th>#springMessage('table.abAccrecords.briefId')</th>

            #*<th>#springMessage('bill.accebill.isneedmerge')
                <div class="layui-input-inline">
                    <i id="isneedmerge-desc" class="layui-icon">&#xe60b;</i>
                </div>
            </th>*#

            <th>#springMessage('bill.accebill.billTransferType')</th>
            <th>#springMessage('bill.accebill.bussdt')</th>
            <th>#springMessage('bill.accebill.billMoney')</th>
            <th>#springMessage('table.abVoucherinfo.payer')</th>
            <th>#springMessage('table.abVoucherinfo.acceptor')</th>
            <th>#springMessage('table.abAccrecords.cnAccrecords')</th>
            <th>#springMessage('table.abVoucherinfo.startDate')</th>
            <th>#springMessage('table.abVoucherinfo.endDate')</th>
            <th>#springMessage('bill.accebill.business.reqNm')</th>
            <th>#springMessage('bill.accebill.business.recNm')</th>
            <th>#springMessage('bill.accebill.business.recAcctId')</th>
            <th>#springMessage('bill.accebill.signUpFlag')</th>
            <th>#springMessage('bill.accebill.InstructionStatus')</th>
            <th>#springMessage('table.abAccrecords.returnCode')</th>
            <th>#springMessage('table.abAccrecords.returnMsg')</th>

            <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
            <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
            <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>
            <th>#springMessage('table.abVoucherinfoVice.socCode')</th>
            <th>#springMessage('bill.accebill.batchNo')</th>

            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #end
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillInstructionManage.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>

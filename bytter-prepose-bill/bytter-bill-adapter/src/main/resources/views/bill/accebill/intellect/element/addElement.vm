<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            <td style="width: 20%" class="textRight">
                #springMessage('选票要素编码')
            </td>
            <td style="width: 30%">
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="elementCode" lay-verify="required">
                </div>
            </td>
            <td style="width: 20%" class="textRight">
                #springMessage('选票要素名称')
            </td>
            <td style="width: 30%">
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="elementName" lay-verify="required">
                </div>
            </td>
        </tr>
        <tr id="sourceTypeTr">
            <td class="textRight">
                #springMessage('来源类型')
            </td>
            <td>
                <div class="layui-inline" id="sourceType1">
                    <div class="bt-biz-dict" data-type="select"
                         data-callback="sourceTypeCallBack" data-required="true"
                         data-group="bill.intellect.element.sourceType"
                         data-name="sourceType" data-biz-name="sourceType">
                    </div>
                </div>
            </td>
            <td class="textRight dictTd">
            </td>
            <td class="dictTd">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('备注')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input" name="rmk">
                </div>
            </td>
            <td class="textRight"></td>
            <td>
                <div class="layui-inline">

                </div>
            </td>
        </tr>

        <tr>
            <td class="textRight">#springMessage('数据类型')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-required="true"
                         data-group="bill.intellect.element.dataType"
                         data-name="dataType" data-biz-name="dataType">
                    </div>
                </div>
            </td>
            <td class="textRight">#springMessage('有效标志')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="radio" data-defaultvalue="1" data-group="sf_yn" data-name="validSign" data-biz-name="validSign">
                    </div>
                </div>
            </td>
        </tr>

        <tr>
            <td colspan="4">
                <div style="text-align: center;width: 100%">
                    <button class="layui-btn" lay-submit lay-filter="submit" type="button">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </div>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/intellect/element/element.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        html,body,form,iframe,.layui-tab,.layui-tab-content,.layui-tab-item {
            height: 100%;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post" >
    <div class="layui-tab layui-tab-brief" lay-filter="billExc">
        <ul class="layui-tab-title">
            <li class="layui-this">#springMessage('bill.dp.exc')</li>
##			#set($isBillPool=$licenseTag.isModuleAuth("billPool"))
##	    	#if($!{isBillPool})
            <li>#springMessage('billPool.bail.exc')</li>
            <li>#springMessage('billPool.limit.exc')</li>
            <li>#springMessage('billPool.con.exc')</li>
##			#end
			
        </ul>
        <div class="layui-tab-content">
            <div class="layui-tab-item layui-show">
                ##电票指令
                <iframe id="billIframe" src="" frameborder="0" style="width: 100%;" name="bill" ></iframe>
            </div>
            <div class="layui-tab-item">
                ##票据池保证金指令
                <iframe id="poolBailIframe" src="" frameborder="0" style="width: 100%;" name="poolBail"></iframe>
            </div>
            <div class="layui-tab-item">
                ##票据池额度申请指令
                <iframe id="poolLimitIframe" src="" frameborder="0" style="width: 100%;" name="poolLimit"></iframe>
            </div>
            <div class="layui-tab-item">
                ##票据池融资申请合同指令
                <iframe id="poolConIframe" src="" frameborder="0" style="width: 100%;" name="poolCon"></iframe>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillInstructionManageTest.list.js?_btv=${resourceVersion}"></script>
</html>









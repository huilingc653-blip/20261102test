<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{abBillBankAutoDtlPage.id}">
		<table class="layui-table">
			<tbody>
				<tr>
					##接口代码
                    <td class="textRight" width="50%">#springMessage('table.btBankAcc.bifCode')</td>
                    <td width="50%">
                        <div type="list" field="bifCode" fieldHref="${basePath}/basic/business/bisbifinit/json" data-required="true" dictField="id" dictText="name" defaultVal="$!{abBillBankAutoDtlPage.bifCode}"></div>
                    </td>
				</tr>
				<tr>
					<td class="textRight" width="50%">#springMessage("abBillBankAutoDtl.autoAccept")</td>
					<td width="50%">
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="autoAccept" data-biz-name="autoAccept"  ></div>
                        </div>
					</td>
				</tr>
				<tr>
					<td class="textRight" width="50%">#springMessage("abBillBankAutoDtl.autoInvoice")</td>
					<td width="50%">
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="autoInvoice" data-biz-name="autoInvoice"  ></div>
                        </div>
					</td>
				</tr>
				<tr>
					<td class="textRight" width="50%">#springMessage("abBillBankAutoDtl.autoPay")</td>
					<td width="50%">
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="autoPay" data-biz-name="autoPay"  ></div>
                        </div>
					</td>
				</tr>
                ##票据池背书
                <tr>
                    <td class="textRight" width="50%">#springMessage("abBillBankAutoDtl.poolEndorse")</td>
                    <td width="50%">
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="poolEndorse" data-biz-name="poolEndorse"  ></div>
                        </div>
                    </td>
                </tr>
                ##票据池开票
                <tr>
                    <td class="textRight" width="50%">#springMessage("abBillBankAutoDtl.poolEmitBill")</td>
                    <td width="50%">
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="poolEmitBill" data-biz-name="poolEmitBill"  ></div>
                        </div>
                    </td>
                </tr>
				<tr>
					<td class="textRight" width="50%">#springMessage("btBankType.validSign")</td>
					<td width="50%">
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="validSign" data-biz-name="validSign"  ></div>
                        </div>
					</td>
				</tr>
                    ##是否支持新票据
                <tr>
                    <td class="textRight" width="50%">#springMessage("table.bankbillbusi.newbillflg")</td>
                    <td width="50%">
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="radio" data-group="BANKBILLBUSI_NEW_BILL_FLG" data-defaultvalue="1" data-name="newBillFlg" data-biz-name="newBillFlg"  ></div>
                        </div>
                    </td>
                </tr>
				<tr>
					<td colspan="2" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					 </td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','layedit','dicts','select'], function(){
		var $ = bt.jquery,form = bt.form();
        var dicts = bt.dicts.init();
		//下拉框
        $.each($("div[type='list']"),function(i,item){
            bt.select.init({
                elem: "[field='"+$(item).attr("field")+"']",
                name: $(item).attr("field"),
                defaultVal: $(item).attr("defaultVal"),
                valueField: $(item).attr("dictField"),
                textField: $(item).attr("dictText"),
                required: $(item).attr("data-required"),
                change:$(item).attr("data-callback"),
                initCallBack:$(item).attr("initCallBack"),
                search: true,
                disabled: false,
                url: $(item).attr("fieldhref")
            });
        });
		//监听提交
        form.on('submit(submit)', function(data){
            var action = "/bill/accebill/abbillbankautodtl/save";
            $.post(basePath + action,data.field,function(result){
                parent.layer.alert(result.msg, {icon: result.success?1:2});
                if(bt.navtab) {
                    bt.navtab.refreshParent();
                    bt.navtab.refreshCurrent()
                }else {
                    parent.layer ? parent.layer.closeAll() : layer.closeAll();
                }
            },'JSON');
            return false;
        });

	});
</script>
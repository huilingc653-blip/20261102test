<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
            ##票据单位
            <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="corpId"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-scope="all"
                         data-resource="bill:accebill:abemitbill:bailInterestInfo:query"
                    >
                    </div>
                </div>
            </td>
            ##银行类型
            <td width="8%" class="textRight">#springMessage('bill.accebill.bankTypeName')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                         data-method="get"
                         data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
            ##月份
            <td width="10%" class="textRight">#springMessage('table.btBankAccDtl.months')</td>
            <td width="20%">
                <div class="layui-inline">
                    <input type="text" name="eqs_currentMonth" data-biz-name="eqs_currentMonth" id="eqs_currentMonth"
                           class="layui-input bt-biz-dateType" data-type="month">
                </div>
            </td>
        </tr>
        <tr>
            ##票据单位账号
            <td class="textRight">#springMessage('table.abVoucherinfoVice.bankAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="bankAcc" name="likes_bankAcc"
                           autocomplete="off" class="layui-input bt-biz-accountTable" data-biz-name="bankAcc" data-name="bankAcc" data-callback="bankAccCallBack" placeholder="#springMessage('table.abVoucherinfoVice.bankAcc')">
                </div>
            </td>
            ##状态
            <td class="textRight">#springMessage('table.abAccrecords.status')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_EMIT_BILL_BAIL_INTEREST_STATUS" data-defaultvalue="" data-name="eqs_status"></div>
                </div>
            </td>
            ##推送状态
            <td class="textRight">#springMessage('table.bill.sendStatus')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_EMIT_BILL_BAIL_INTEREST_PUSH_STATUS" data-defaultvalue="" data-name="eqs_pushStatus"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.emitBill.bailInterest.id')</th>
            <th>#springMessage('table.emitBill.bailInterest.corpName')</th>
            <th>#springMessage('table.abVoucherinfo.billBankAcc')</th>
            <th>#springMessage('bill.accebill.bankTypeName')</th>
            <th>#springMessage('table.btBankAccDtl.months')</th>
            <th>#springMessage('bill.accebill.billMoney')</th>
            <th>#springMessage('table.fcBond.bondmoney')</th>
            <th>#springMessage('table.emitBill.bailInterest.dueSettlementAmount')</th>
            <th>#springMessage('table.emitBill.bailInterest.actualSettlementAmount')</th>
            <th>#springMessage('table.emitBill.bailInterest.interest.margin')</th>
            <th>#springMessage('table.emitBill.bailInterest.lastOperator')</th>
            <th>#springMessage('table.abAccrecords.status')</th>
            <th>#springMessage('table.bill.sendStatus')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>

    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abEmitBailInterestInfo.list.js?_btv=${resourceVersion}"></script>
</html>

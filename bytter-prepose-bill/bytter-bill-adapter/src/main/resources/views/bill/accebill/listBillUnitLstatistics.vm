	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/report/export.js?_btv=${resourceVersion}"></script>
<script language="javascript" type="text/javascript">
	var corp={};
	var dicts={};
	var dateType={};
	var fromObj={};
	var selectTreeDefaultValue = '$!infoParams.corpId'
	bt.use(['form','dicts','dateType','moneyType','corp','printType'], function(){
		$ = bt.jquery,fromObj = bt.form();
		dicts=bt.dicts.init();
		corp=bt.corp.init();
		dateType=bt.dateType.init();
		//打印初始化
		bt.printType.init();
	});

	function resetValue() {
		$("#endDate").val('');
		$("#beginDate").val('');
		bt.corp.get("bizCorpId").val('')
		bt.corp.get("bizCorpId").val(selectTreeDefaultValue)
	}
	/**
	 * 导出功能
	 */
	exports = function () {
		var url = basePath+"/bill/accebill/abbillQuery/exportUnitCountExcel";
		var formData = {
			corpId: corp.get("bizCorpId").val(),
			type: dicts.get("type").val(),
			endDate: dateType.get("endDate").val(),
			countIsPool: dicts.get("countIsPool").val()
		}
		DownLoadFile({url:url,data:formData,method:'post'});
	};

	var check=function(obj){
		return fromObj.verifyFun('#queryForm');
	}
	var toDtlInfo=function(busType){
		var corpId=corp.get("bizCorpId").val();
		var endDate=dateType.get("endDate").val();
		var beginDate=dateType.get("beginDate").val();
		var firstTime="$!{info.zmoney}";
		var countIsPool = dicts.get("countIsPool").val()
		var params="busType="+busType+"&corpId="+corpId+"&firstTime="+firstTime+"&countIsPool="+countIsPool;
		if(beginDate != "" || typeof(beginDate) == "undefined" || beginDate != null ){
			params += "&beginDate="+beginDate;
		}
		if(endDate != "" || typeof(endDate) == "undefined" || endDate != null ){
			params += "&endDate="+endDate;
		}else{
			//默认给当前日期
			endDate = new Date().format('yyyy-MM-dd');
		}
		if(bt.navtab){
			bt.navtab.addNavtab(bt.lang('common.button.dtl.view') ,
					basePath + "/bill/accebill/abbillQuery/billUnitLstatisticsDtl?" + params);
			return;
		}
		parent.layer.open({
			type: 2,
			area: ['900px', '700px'],
			maxmin: true,
			content: basePath + "/bill/accebill/abbillQuery/billUnitLstatisticsDtl?" + params
		});
	}
</script>
</html>

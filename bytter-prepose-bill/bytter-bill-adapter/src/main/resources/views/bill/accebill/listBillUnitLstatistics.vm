<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form id="queryForm" action="${basePath}/bill/accebill/abbillQuery/billUnitLstatistics"
	  class="layui-form input150-container" onsubmit="return check(this)">
	<table class="layui-table">
		<tbody>
		<tr>
			<td width="8%" class="textRight">#springMessage('bill.accebill.isCorp')</td>
			<td width="25%">
				<div class="layui-inline">
					<div class="bt-biz-corp"
						 data-tree-type="check"
						 data-biz-type="corp"
						 data-biz-name="bizCorpId"
						 data-type="selectTree"
						 data-name="corpId"
						 data-scope="all"
						 data-required="true"
						 data-defaultvalue="$!{infoParams.corpId}"
						 data-resource="bill:accebill:billUnitLstatistics:query:corpop"
					>
					</div>
				</div>
			</td>
		##收付标记
			<td width="8%" class="textRight">#springMessage('bill.accebill.billpayerpayeetype')</td>
			<td width="25%">
				<div class=layui-form>
					<div class="bt-biz-dict" data-type="select" data-name="type"  data-biz-name="type"  data-group="BILL_PAYERPAYEE_TYPE"
						 data-defaultvalue="$!{infoParams.type}" ></div>
				</div>
			</td>
		</tr>
		<tr>
			##开始日期
			<td width="8%" class="textRight">#springMessage('bill.accebill.beginDate')</td>
			<td width="25%">
				<div class="layui-inline">
					<input type="text" id="beginDate" name="beginDate" data-name="beginDate" class="layui-input bt-biz-dateType"
						   data-biz-name="beginDate" value="$!{beginDate}" data-type="date" >
				</div>
			</td>
		##截止日期
			<td width="8%" class="textRight">#springMessage('bill.accebill.endDate')</td>
			<td width="25%">
				<div class="layui-inline">
					<input type="text" id="endDate" name="endDate" data-name="endDate" class="layui-input bt-biz-dateType"
						   data-biz-name="endDate" data-type="date"  value="$!{endDate}" data-today="true">
				</div>
			</td>
		</tr>
		<tr>
			## 是否统计在池和非在池
			<td class="textRight">#springMessage('bill.accebill.countIspool')</td>
			<td >
				<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="countIsPool" data-biz-name="countIsPool" data-defaultvalue="$!{infoParams.countIsPool}"></div>
			</td>

			<input type=hidden id="firstTime" name="firstTime" data-name="firstTime" class="layui-input"
				   data-biz-name="firstTime" value="$!{firstTime}" data-defaultvalue=true>
		</tr>
		<tr>
			<td colspan="6" style="text-align: center;">
				<div class="layui-inline">
					<button class="layui-btn" type="submit" >#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn layui-btn-primary" data-callBack="resetValue">#springMessage('common.button.reset')</button>
				</div>
			</td>
		</tr>
		</tbody>
	</table>
</form>

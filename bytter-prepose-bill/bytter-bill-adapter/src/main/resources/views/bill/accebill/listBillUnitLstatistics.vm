							#end
							<td align="center">$billTypeInfo.name</td>
							<td align="right" >$number.formatNumeric($!{billtypemoney})</td>
							#if($!countIsPool)
								<td align="right" >$number.formatNumeric($!{billtypezcmoney})</td>
								<td align="right" >$number.formatNumeric($!{billtypefzcmoney})</td>
							#end
							<td align="center">$!{billtypecount}</td>
							#if($!countIsPool)
								<td align="center">$!{billtypezccount}</td>

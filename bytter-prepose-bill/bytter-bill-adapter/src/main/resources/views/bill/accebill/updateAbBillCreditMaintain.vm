<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form">
    <input type="hidden" name="id" value="$!{creditInfoPage.id}">
    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            <td class="textRight" width="15%">单位</td>
            <td width="40%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-biz-name="corpId"
                         data-scope="all"
                         data-required="true"
                         data-defaultvalue="$!{creditInfoPage.corpId}"
                         data-resource="bill:accebill:credit:maintain:query"></div>
                </div>
            </td>
            <td class="textRight">银行名称</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType"
                         data-url="${basePath}/basic/business/btbanktype/json"
                         data-method="get"
                         data-valuefield="id"
                         data-textfield="typeName"
                         data-name="bankTypeId"
                         data-biz-name="bankTypeId"
                         data-required="true"
                         data-defaultvalue="$!{creditInfoPage.bankTypeId}"
                         data-inputvalue="inputvalue"
                         data-search="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">授信类型</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="bill:accebill.creditType"
                         data-name="creditType" data-biz-name="creditType" data-defaultvalue="$!{creditInfoPage.creditType}" data-required="true"></div>
                </div>
            </td>
            <td class="textRight">保证金比例</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" class="layui-input bt-biz-rateType" id="bondRatio" style="text-align:right" value="$!{creditInfoPage.bondRatio}"
                           data-name="bondRatio" data-biz-name="bondRatio" autocomplete="off">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">开票手续费</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" class="layui-input bt-biz-rateType" id="openBillRate" style="text-align:right" value="$!{creditInfoPage.openBillRate}"
                           data-name="openBillRate" data-biz-name="openBillRate" autocomplete="off">
                </div>
            </td>
            <td class="textRight">是否能正常使用</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-defaultvalue="$!{creditInfoPage.isUsed}"
                         data-name="isUsed" data-biz-name="isUsed"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">保证金利率</td>
            <td colspan="3">
                <div class="layui-input-inline">
                    <input type="text" class="layui-input" name="bondRate" value="$!{creditInfoPage.bondRate}" lay-verify="strlength" data-maxlength="200"
                           style="width: 665px">
                </div>
            </td>
        </tr>
        </tbody>
    </table>
    <div style="text-align: center; padding-top: 10px;">
        <button type="button" class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
            'common.button.submit')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillCreditMaintain.edit.js?_btv=${resourceVersion}"></script>
</html>
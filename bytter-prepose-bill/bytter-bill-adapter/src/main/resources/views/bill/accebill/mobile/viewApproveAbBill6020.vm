#* 
*6020 票据托收到账
*#
	<li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.abbillcollectionCorpInfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
				##所属单位
				#springMessage('bill.accebill.corpId')
                <span class="mui-badge mui-badge-inverted">
					$!{info.corpName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##所属单位账号
				#springMessage('bill.accebill.corpBankAcc')
                <span class="mui-badge mui-badge-inverted">
					$!{info.bankAcc}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##所属单位银行
				#springMessage('bill.accebill.corpBankName')
                <span class="mui-badge mui-badge-inverted">
					$!{bankInfo.bankName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##所属单位银行行号
				#springMessage('bill.accebill.corpBankCode')
                <span class="mui-badge mui-badge-inverted">
					$!{bankInfo.bankCode}
    			</span>
            </li>
        </ul>
    </li>

	<li class="mui-table-view-cell mui-collapse mui-active">
		<a class="mui-navigate-right" href="#">#springMessage('bill.accebill.abbillcollectionaccount.title')</a>
		<ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
				##收款人
				#springMessage('bisBifRule.payeeName')
                <span class="mui-badge mui-badge-inverted">
					$!{info.signerok}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##业务办理日期
				#springMessage('table.abAccrecords.businessDate')
                <span class="mui-badge mui-badge-inverted">
					$!date.format('yyyy-MM-dd',$!{info.businessDate})
    			</span>
            </li>
		</ul>
    </li>

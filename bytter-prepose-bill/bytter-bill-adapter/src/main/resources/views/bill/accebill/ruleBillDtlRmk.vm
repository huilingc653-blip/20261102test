<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##银行类型
            <td class="textRight">#springMessage('table.bisAccBal.bifCode')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/listFilter"
                     data-name ="eqs_bankTypeId" data-biz-name ="eqs_bankTypeId"  data-valueField="id" data-textField="typeName" ></div>
            </td>
            ##业务类别
            <td class="textRight">#springMessage('bill.accebill.bustype')</td>
            <td>
                <div class="bt-biz-dict" data-type="select"
                     data-group="accebill_billNo_insbriefid" data-name="eqs_bustype"></div>
            </td>
        </tr>
        <tr>
            <td align="center" colspan="6">
##                #if($shiro.hasPermission("netbank:bankAcc:btBankAccRev:query"))
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
##                #end
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.bisAccBal.bifCode')</th>
        <th>#springMessage('bill.accebill.bustype')</th>
        <th>#springMessage('table.bisAccDtl.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/bill/accebill/abBillRuleBillDtlRmk.list.js?_btv=${resourceVersion}"></script>

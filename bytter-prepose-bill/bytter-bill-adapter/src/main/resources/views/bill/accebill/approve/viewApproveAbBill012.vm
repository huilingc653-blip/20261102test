#* 
*012 票据贴现赎回申请
*#
	<div class="layui-colla-item">
	<h2 class="layui-colla-title">#springMessage('bill.accebill.abbilldiscountransom.title')</h2>
	<div class="layui-colla-content layui-show">
		<table class="layui-table">
		<tbody>
			##后手          bill.accebill.rearAccrecords
			##后手账号      bill.accebill.rearAccrecordsAcc
            <tr>
    			<td width="20%" class="textRight">#springMessage('bill.accebill.rearAccrecords')</td>
    			<td width="30%">$!{info.frontHand}</td>
    			<td width="20%" class="textRight">#springMessage('bill.accebill.rearAccrecordsAcc')</td>
    			<td width="30%">$!{info.frontHandAcc}</td>
			</tr>                        
			##贴现天数         table.abDiscount.daynum
			##划款天数        table.abDiscount.paydate
			<tr>
    			<td width="20%" class="textRight">#springMessage('table.abDiscount.daynum')</td>
    			<td width="30%">$!{info.daynum}</td>
    			<td width="20%" class="textRight">#springMessage('table.abDiscount.paydate')</td>
    			<td width="30%">$!{info.paydate}</td>
			</tr> 
            ##假期顺延天数  table.abDiscount.deferdate
			##贴现利率          table.abDiscount.interestRates
			<tr>
    			<td width="20%" class="textRight">#springMessage('table.abDiscount.deferdate')</td>
    			<td width="30%">$!{info.deferdate}</td>
    			<td width="20%" class="textRight">#springMessage('table.abDiscount.interestRates')</td>
    			<td width="30%">$rateTag.show($!{info.interestRates})</td>
			</tr> 
            ##赎回开放日  table.abDiscount.rpdopendt
			##赎回截止日  table.abDiscount.rpdduedt
			<tr>
    			<td width="20%" class="textRight">#springMessage('table.abDiscount.rpdopendt')</td>
    			<td width="30%">$!date.format('yyyy-MM-dd',$!{info.rpdopendt})</td>
				<td width="20%" class="textRight">#springMessage('table.abDiscount.rpdduedt')</td>
    			<td width="30%">$!date.format('yyyy-MM-dd',$!{info.rpdduedt})</td>
			</tr>
		    ##所属单位         table.abVoucherinfoVice.corpId
			##票据所属账号     table.abVoucherinfoVice.bankAcc
			<tr>
    			<td width="20%" class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
    			<td width="30%">$!{info.corpName}</td>
    			<td width="20%" class="textRight">#springMessage('table.abVoucherinfoVice.bankAcc')</td>
    			<td width="30%">$!{info.bankAcc}</td>
			</tr> 
            ##持票单位银行名称  table.abVoucherinfoVice.bankName
			##所属单位库存   table.abVoucherinfoVice.enterStock
            <tr>
    			<td width="20%" class="textRight">#springMessage('table.abVoucherinfoVice.bankName')</td>
    			<td width="30%">$!{info.bankName}</td>
    			<td width="20%" class="textRight">#springMessage('table.abVoucherinfoVice.enterStock')</td>
    			<td width="30%">$!{info.enterStockName}</td>
			</tr>                       
            ##贴现利息    table.abDiscount.interest
			##返还利息    table.abDiscount.returnInterest
			<tr>
    			<td width="20%" class="textRight">#springMessage('table.abDiscount.interest')</td>
    			<td width="30%">$number.formatNumeric($!{info.interest})</td>
    			<td width="20%" class="textRight">#springMessage('table.abDiscount.returnInterest')</td>
    			<td width="30%">$number.formatNumeric($!{info.returnInterest})</td>
			</tr>
        </tbody>
        </table>
    </div>

	##贴出人
	<h2 class="layui-colla-title">#springMessage('bill.accebill.discountReq.title')</h2>
	<div class="layui-colla-content layui-show">
		<table class="layui-table">
			<tbody>
            <tr>
                <td width="20%" class="textRight">#springMessage('bill.accebill.role')</td>
                <td width="30%">$!{info.recRoleName}</td>
                <td width="20%" class="textRight">#springMessage('bill.accebill.name')</td>
                <td width="30%">$!{info.recNm}</td>
            </tr>
            <tr>
                <td width="20%" class="textRight">#springMessage('bill.accebill.cmonid')</td>
                <td width="30%">$!{info.recCmonid}</td>
                <td width="20%" class="textRight">#springMessage('bill.accebill.bankacc')</td>
                <td width="30%">$!{info.recAcctId}</td>
            </tr>
            <tr>
                <td width="20%" class="textRight">#springMessage('bill.accebill.bankno')</td>
                <td width="30%">$!{info.recAcctsvcr}</td>
                <td width="20%" class="textRight">#springMessage('bill.accebill.acctsvcrAg')</td>
                <td width="30%">$!{info.recAcctsvcrAg}</td>
            </tr>
			</tbody>
		</table>
	</div>
	##贴入人
	<h2 class="layui-colla-title">#springMessage('bill.accebill.discountRec.title')</h2>
	<div class="layui-colla-content layui-show">
		<table class="layui-table">
			<tbody>
            <tr>
                <td width="20%" class="textRight">#springMessage('bill.accebill.name')</td>
                <td>$!{info.reqNm}</td>
                <td width="20%" class="textRight">#springMessage('bill.accebill.bankacc')</td>
                <td>$!{info.reqAcctId}</td>
            </tr>
            <tr>
                <td width="20%" class="textRight">#springMessage('bill.accebill.bankno')</td>
                <td width="30%">$!{info.reqAcctsvcr}</td>
                <td width="20%" class="textRight"></td>
                <td width="30%"></td>
            </tr>
			</tbody>
		</table>
	</div>
	</div>
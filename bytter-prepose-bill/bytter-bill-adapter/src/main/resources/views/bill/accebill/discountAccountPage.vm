<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="eqs_corpId" id="corpId" value="$!{billInfo.corpId}"/>
    <input type="hidden"  id="row" value="$!{row}"/>
    <table class="layui-table">
        <tbody>
        <tr>
        ##持票单位
            <td width="18%" class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td width="32%">
                <div class="layui-input-inline">
                    $!{billInfo.corpName}
                </div>
            </td>
        ##流通介质
            <td width="18%" class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
            <td width="32%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_FLAG" data-name="eqi_billFlag"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##票据类型
            <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE" data-name="eqi_billType"></div>
                </div>
            </td>
        ##出票日期
            <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_startDate" class="layui-input bt-input-inline  bt-biz-dateType" data-endid="startDate" placeholder="#springMessage('table.abVoucherinfo.startDate')">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_startDate" class="layui-input bt-input-inline  bt-biz-dateType" id="startDate" placeholder="#springMessage('table.abVoucherinfo.startDate')">
                </div>
            </td>
        </tr>
        <tr>
        ##票据号码
            <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_origNo" autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
                </div>
            </td>
        ##入库库存
            <td class="textRight">#springMessage('table.abVoucherinfoVice.enterStock')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_ENTER_STOCK" data-name="eqs_enterStock"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##到期日期
            <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_endDate" class="layui-input bt-input-inline  bt-biz-dateType" data-endid="endDate" placeholder="#springMessage('table.abVoucherinfo.endDate')">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_endDate" class="layui-input bt-input-inline  bt-biz-dateType" id="endDate" placeholder="#springMessage('table.abVoucherinfo.endDate')">
                </div>
            </td>
        ##出票人
            <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_payer" autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payer')">
                </div>
            </td>
        </tr>
        <tr>
        ##承兑人
            <td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_acceptor" autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptor')">
                </div>
            </td>
        ##票据金额
            <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_billMoney" class="layui-input bt-input-inline  bt-biz-moneyType" data-moneyendid="endMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_billMoney" class="layui-input bt-input-inline  bt-biz-moneyType" id="endMoney"
                           value="$!{billMoney}" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                </div>
            </td>
        </tr>
        <tr>
        ##业务日期
            <td class="textRight">#springMessage('table.btwarnstrategy.warnDate')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_businessDate" class="layui-input bt-input-inline  bt-biz-dateType" data-endid="businessDate" placeholder="#springMessage('table.btwarnstrategy.warnDate')">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_businessDate" class="layui-input bt-input-inline  bt-biz-dateType" id="businessDate"
                           value="$!{businessDate}" placeholder="#springMessage('table.btwarnstrategy.warnDate')">
                </div>
            </td>
            ##出票标志
            <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-name="eqs_newStmIssuofpprInd"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #if($shiro.hasPermission("bill:accebill:abBillDiscountAccount:query"))
    <table id="appTable" class="layui-table" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.abVoucherinfo.billType')</th>
            <th>#springMessage('table.abVoucherinfo.billFlag')</th>
            <th>#springMessage('table.abVoucherinfoVice.corpId')</th>
            <th>#springMessage('table.abVoucherinfoVice.socCode')</th>
            <th>#springMessage('table.abVoucherinfo.payer')</th>
            <th>#springMessage('table.abVoucherinfo.acceptor')</th>
            <th>#springMessage('table.abVoucherinfo.origNo')</th>
            <th>#springMessage('table.abVoucherinfo.billMoney')</th>
            <th>#springMessage('table.abDiscount.realMoney')</th>
            <th>#springMessage('table.abVoucherinfo.startDate')</th>
            <th>#springMessage('table.abVoucherinfo.endDate')</th>
            <th>#springMessage('table.btwarnstrategy.warnDate')</th>
            <th>#springMessage('table.abAccrecords.briefId')</th>
            <th>#springMessage('table.abVoucherinfoVice.enterStock')</th>
            <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
            <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
            <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>
            <th>#springMessage('table.abVoucherinfo.banendrsmtmk')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #end
<br />
<br />
<div class="layui-form-item layui-form-submit" id="buttonDiv">
    <div class="layui-input-block">
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>

    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/discountAccountPage.list.js?_btv=${resourceVersion}"></script>
</html>

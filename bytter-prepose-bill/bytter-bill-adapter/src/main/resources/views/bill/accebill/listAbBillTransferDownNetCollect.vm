<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
        <tbody>
        <tr>
            ##成员单位
            <td width="15%" class="textRight">#springMessage('common.query.corpInfo')</td>
            <td width="35%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-scope="all"
                         data-resource="bill:accebill:abbillTransferDown:netCollect:query:corpop"
                    >
                    </div>
                </div>
            </td>
            ##日期区间
            <td width="15%" class="textRight">#springMessage('bill.accebill.query.date')</td>
            <td width="35%">
                <input type="text" name="beginDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="endDate" data-biz-name="beginDate" >
                <span class="date-mid">~</span>
                <input type="text" name="endDate" class="layui-input bt-input-inline bt-biz-dateType" id="endDate" data-biz-name="endDate">
            </td>
##            ##调拨类型
##            <td class="textRight">
####                #springMessage('bill.accebill.TransferDown.BusType')
##            </td>
##            <td width="25%">
####                <div class="bt-biz-dict" data-type="select" data-group="TransferDown_BusType" data-name="eqs_briefId"></div>
##            </td>
		</tr>
		<tr>
##            <td colspan="6" style="text-align: center;">
            <td colspan="4" style="text-align: center;">
                <div class="layui-inline">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </div>
            </td>
        </tr>
		</tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('common.query.corpInfo')</th>
        <th>#springMessage('common.query.netInfo')</th>
        <th>#springMessage('bill.accebill.TransferDown.upMoney')</th>
        <th>#springMessage('bill.accebill.TransferDown.gjMoney')</th>
        <th>#springMessage('bill.accebill.TransferDown.downMoney')</th>
        <th>#springMessage('bill.accebill.TransferDown.netBalMoney')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillTransferDownNetCollect.list.js?_btv=${resourceVersion}"></script>
</html>

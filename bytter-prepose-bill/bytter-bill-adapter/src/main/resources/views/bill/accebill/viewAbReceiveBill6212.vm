#*
*6212 贴现收回
*#
            ##贴现入账银行名称  abbilldiscountcollect.info.bankName
            ##贴现入账银行行号  abbilldiscountcollect.info.bankCode
            <tr>
                <td class="textRight" colspan="2">#springMessage('abbilldiscountcollect.info.bankName')</td>
                <td>$!{abReceiveBillPage.aoaccninfName}</td>
                <td class="textRight" colspan="2">#springMessage('abbilldiscountcollect.info.bankCode')</td>
                <td>$!{abReceiveBillPage.aoaccninfAc}</td>
            </tr>
            ##贴现天数        table.abDiscount.daynum
            ##划款天数        table.abDiscount.paydate
            <tr>
                <td class="textRight" colspan="2">#springMessage('table.abDiscount.daynum')</td>
                <td>$!{abReceiveBillPage.daynum}</td>
                <td class="textRight" colspan="2">#springMessage('table.abDiscount.paydate')</td>
                <td>$!{abReceiveBillPage.paydate}</td>
            </tr>
            ##假期顺延天数  table.abDiscount.deferdate
            ##贴现利率      table.abDiscount.interestRates
            <tr>
                <td class="textRight" colspan="2">#springMessage('table.abDiscount.deferdate')</td>
                <td>$!{abReceiveBillPage.deferdate}</td>
                <td class="textRight" colspan="2">#springMessage('table.abDiscount.interestRates')</td>
                <td>$rateTag.show($!{abReceiveBillPage.interestRates})</td>
            </tr>
            ##赎回开放日  table.abDiscount.rpdopendt
            ##赎回截止日  table.abDiscount.rpdduedt
            <tr>
                <td class="textRight" colspan="2">#springMessage('table.abDiscount.rpdopendt')</td>
                <td>$!date.format('yyyy-MM-dd',$!{abReceiveBillPage.rpdopendt})</td>
                <td class="textRight" colspan="2">#springMessage('table.abDiscount.rpdduedt')</td>
                <td>$!date.format('yyyy-MM-dd',$!{abReceiveBillPage.rpdduedt})</td>
            </tr>
            ##持票单位银行名称  table.abVoucherinfoVice.bankName
            ##所属单位库存   table.abVoucherinfoVice.enterStock
            <tr>
                <td class="textRight" colspan="2">#springMessage('table.abVoucherinfoVice.bankName')</td>
                <td>$!{abReceiveBillPage.bankName}</td>
                <td class="textRight" colspan="2">#springMessage('table.abVoucherinfoVice.enterStock')</td>
                <td>$!{abReceiveBillPage.enterStockName}</td>
            </tr>
            ##贴现利息    table.abDiscount.interest
            ##返还利息    table.abDiscount.returnInterest
            <tr>
                <td class="textRight" colspan="2">#springMessage('table.abDiscount.interest')</td>
                <td>$number.formatNumeric($!{abReceiveBillPage.interest})</td>
                <td class="textRight" colspan="2">#springMessage('table.abDiscount.returnInterest')</td>
                <td>$number.formatNumeric($!{abReceiveBillPage.returnInterest})</td>
            </tr>
            ##前手
            ##前手账号
            <tr>
                <td class="textRight" colspan="2">#springMessage('table.abAccrecords.cnAccrecords')</td>
                <td>$!{abReceiveBillPage.reqNm}</td>
                <td class="textRight" colspan="2">#springMessage('bill.accebill.cnAccrecordsAcc')</td>
                <td>$!{abReceiveBillPage.reqAcctId}</td>
            </tr>

##贴出人信息
<tr>
    <td rowspan="3">#springMessage('bill.accebill.discountReq.title')</td>
    <td class="textRight" >#springMessage('bill.accebill.role')</td>
    <td>$!{abReceiveBillPage.reqRoleName}</td>
    <td class="textRight" colspan="2">#springMessage('bill.accebill.name')</td>
    <td>$!{abReceiveBillPage.reqNm}</td>
</tr>
<tr>
    <td class="textRight" >#springMessage('bill.accebill.cmonid')</td>
    <td>$!{abReceiveBillPage.reqCmonid}</td>
    <td class="textRight" colspan="2">#springMessage('bill.accebill.bankacc')</td>
    <td>$!{abReceiveBillPage.reqAcctId}</td>
</tr>
<tr>
    <td class="textRight" >#springMessage('bill.accebill.bankno')</td>
    <td>$!{abReceiveBillPage.reqAcctsvcr}</td>
    <td class="textRight" colspan="2">#springMessage('bill.accebill.acctsvcrAg')</td>
    <td>$!{abReceiveBillPage.reqAcctsvcrAg}</td>
</tr>

##贴入人信息
<tr>
    <td rowspan="2">#springMessage('bill.accebill.discountRec.title')</td>
    <td class="textRight" >#springMessage('bill.accebill.name')</td>
    <td>$!{abReceiveBillPage.recNm}</td>
    <td class="textRight" colspan="2">#springMessage('bill.accebill.bankacc')</td>
    <td>$!{abReceiveBillPage.recAcctId}</td>
</tr>
<tr>
    <td class="textRight" >#springMessage('bill.accebill.bankno')</td>
    <td>$!{abReceiveBillPage.recAcctsvcr}</td>
    <td class="textRight" colspan="2"></td>
    <td></td>
</tr>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
    <style>
        #itemCodeValue > div div, #itemCodeValue > div input {
            width: 100%;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="isDisCountCredit" value="$!{isDisCountCredit}"/>
    <input type="hidden" id="isDisThirdBillCredit" value="$!{isDisThirdBillCredit}"/>
    <input type="hidden" id="isCredit" value="$!{isCredit}"/>
    <input type="hidden" id="isNotDiscountApply" value="$!{isNotDiscountApply}"/>
    <table class="layui-table">
        <tbody>
        <tr>
            ## 申请单位
            <td class="textRight">#springMessage('bill.accebill.applyCorp')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_applyCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:abBillDiscountManager:query"
                         data-callback="applyCorpCallback"
                    >
                    </div>
                </div>
            </td>
            ## 票据单位
            <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="corpId"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="bill:accebill:abBillDiscountManager:query"
                         data-scope="all"
                    >
                    </div>
                </div>
            </td>
            ## 业务单位
            <td class="textRight">#springMessage('bill.accebill.busCorp')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_busCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:abBillDiscountManager:query"
                    >
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##入库库存
            <td class="textRight">#springMessage('table.abVoucherinfoVice.enterStock')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_ENTER_STOCK" data-name="eqs_enterStock"
                         data-biz-name="enterStock" id="enterStock" #if(${isNotDiscountApply})
                         data-callback="enterStockCall" data-defaultvalue="10" data-placeholder="" #end></div>
                </div>
            </td>
            ##业务人员
            <td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_busPersonnel"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('bill.accebill.busPersonnel')">
                </div>
            </td>
            ##流通介质
            <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_FLAG" data-name="eqi_billFlag"
                         data-biz-name="billFlag" id="billFlag"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##出票日期
            <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_startDate" class="layui-input bt-input-inline  bt-biz-dateType"
                           data-endid="startDate" placeholder="#springMessage('table.abVoucherinfo.startDate')">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_startDate" class="layui-input bt-input-inline  bt-biz-dateType"
                           id="startDate" placeholder="#springMessage('table.abVoucherinfo.startDate')">
                </div>
            </td>
            ##票据号码
            <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_origNo" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.abVoucherinfo.origNo')">
                </div>
            </td>
            ##票据类型
            <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE"
                         data-defaultvalue="$!{abReceiveBillPage.billType}" data-name="eqi_billType"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##到期日期
            <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_endDate" class="layui-input bt-input-inline  bt-biz-dateType"
                           data-endid="endDate" placeholder="#springMessage('table.abVoucherinfo.endDate')">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_endDate" class="layui-input bt-input-inline  bt-biz-dateType"
                           id="endDate" placeholder="#springMessage('table.abVoucherinfo.endDate')">
                </div>
            </td>
            ##出票人
            <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_payer" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.abVoucherinfo.payer')">
                </div>
            </td>
            ##承兑人
            <td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_acceptor" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.abVoucherinfo.acceptor')">
                </div>
            </td>
        </tr>
        <tr>
            ##票据金额
            <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_billMoney" class="layui-input bt-input-inline  bt-biz-moneyType"
                           data-moneyendid="endMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_billMoney" class="layui-input bt-input-inline  bt-biz-moneyType"
                           id="endMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                </div>
            </td>
            ##票据状态
            <td class="textRight">#springMessage('table.abAccrecords.status')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_ABBILLDISCOUNT_STATUS"
                         data-defaultvalue="$!{abReceiveBillPage.status}" data-name="eqi_status"></div>
                </div>
            </td>
            ##在线离线标志
            <td class="textRight">#springMessage('bill.accebill.billSendSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_SEND_SIGN"
                     data-name="eqs_sendSign"></div>
            </td>
        </tr>
        <tr>
            ##出票标志
            <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND"
                         data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
                </div>
            </td>
            ##票据是否允许分包
            <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND"
                         data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
                </div>
            </td>

            <td width="8%" class="textRight">#springMessage('table.bill.bankType.holderBankType')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                         data-method="get"
                         data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##票据单位账号
            <td class="textRight">#springMessage('table.abVoucherinfoVice.bankAcc')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_bankAcc"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.abVoucherinfoVice.bankAcc')">
                </div>
            </td>
            ##子票区间号码
            <td class="textRight">#springMessage('bill.accebill.sti')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="likes_sbbllRngStrtSn"
                           autocomplete="off" class="layui-input" maxlength="12"
                           placeholder="#springMessage('table.abVoucherinfo.sbbllRngStrtSn')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" name="likes_sbbllRngEndSn"
                           autocomplete="off" class="layui-input" maxlength="12"
                           placeholder="#springMessage('table.abVoucherinfo.sbbllRngEndSn')">
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" id="searchBtn" onclick="clickSearch()"
                        type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary" #if(${isNotDiscountApply})
                        onclick="resetSet()" #end>#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #if($shiro.hasPermission("bill:accebill:abBillDiscountManager:query"))
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.abVoucherinfo.billType')</th>
            <th>#springMessage('table.abVoucherinfo.billFlag')</th>##1
            <th>#springMessage('bill.accebill.applyCorp')</th>
            <th>#springMessage('table.abVoucherinfoVo.corpId')</th>##2
            <th>#springMessage('table.abVoucherinfoVice.bankAcc')</th>##2
            <th>#springMessage('bill.accebill.busCorp')</th>
            <th>#springMessage('table.btBankAcc.bankTypeId')</th>
            <th>#springMessage('bill.accebill.busPersonnel')</th>##3
            <th>#springMessage('table.abVoucherinfo.payer')</th>
            <th>#springMessage('table.abVoucherinfo.acceptor')</th>##4
            <th>#springMessage('table.abAccrecords.cnAccrecords')</th>
            <th>#springMessage('table.abVoucherinfo.origNo')</th>##5
            <th>#springMessage('table.abVoucherinfo.billMoney')</th>
            <th>#springMessage('table.abVoucherinfo.startDate')</th>##6
            <th>#springMessage('table.abVoucherinfo.endDate')</th>
            <th>#springMessage('table.abDiscount.rpdmk')</th>##7
            <th>#springMessage('table.abDiscount.discountDate')</th>
            <th>#springMessage('table.abDiscount.paydate')</th>
            <th>#springMessage('table.abDiscount.deferdate')</th>##9
            <th>#springMessage('table.abDiscount.daynum')</th> ## 贴现天数
            <th>#springMessage('table.abDiscount.interest')</th>##10 贴现利息
            <th>#springMessage('table.abDiscount.interestRates')</th>
            <th>#springMessage('table.abDiscount.rpdintrstrate')</th>##11
            <th>#springMessage('table.abDiscount.buyerinterestMoney')</th>
            <th>#springMessage('table.abDiscount.realMoney')</th>##12 实付金额
            <th>#springMessage('table.abDiscount.rpdopendt')</th>
            <th>#springMessage('table.abDiscount.rpdduedt')</th>##13
            <th>#springMessage('table.abAccrecords.banendrsmtmk')</th>
            <th>#springMessage('table.abDiscount.aoaccninfAc')</th>##14
            <th>#springMessage('table.abDiscount.aoaccninfId')</th>
            <th>#springMessage('table.abDiscount.aoaccninfIdName')</th>
            <th>#springMessage('table.abDiscount.invcNb')</th>##15
            <th>#springMessage('table.abDiscount.txlCtrctNb')</th>
            <th>#springMessage('table.abDiscount.sttlmmk')</th>##16
            <th>#springMessage('bill.accebill.billSendSign')</th>
            <th>#springMessage('table.abAccrecords.status')</th>##17
            <th>#springMessage('table.abAccrecords.briefId')</th>
            <th>#springMessage('table.abVoucherinfoVice.enterStock')</th>##18
            <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
            <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>##19
            <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>##20
            <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>
            <th>#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')</th>##21
            <th>#springMessage('table.abAccrecords.rmk')</th>##22
            <th>#springMessage('table.abVoucherinfoVice.transMoney')</th>
            <th>#springMessage('bill.accebill.attachment')</th>
            <th>#springMessage('common.table.thead.operation')</th>##23
        </tr>
        </thead>
    </table>
    #end
<form class="layui-form" id="dataForm">
    <input type="hidden" id="budgetSel" name="budgetSel" value="$!{budgetSel}">
    <input type="hidden" id="curCode" name="curCode" value="$!{curId}"/>
    <input id="discountItem" name="discountItem" type="hidden" value="$!{discountItem}">
    <input id="defItemCode" name="defItemCode" type="hidden" value="$!{defItemCode}">
<table class="layui-table">
    ##贴现申请要素、不启用贴现申请功能直接贴现办理
    #if(${isNotDiscountApply})
        <tr>
            <td class="textRight" width="8%">#springMessage('ab.bill.abbilldiscount.RecType')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-type="radio" data-group="AB_ABBILLDISCOUNT_RECTYPE" data-defaultvalue="0"
                     data-name="recType" data-biz-name="recType" data-callback="selectRecType" id="recType"></div>
            </td>
            <td class="textRight" width="8%"></td>
            <td width="25%"></td>
            <td class="textRight" width="8%">
                    <div id="netTd1" style="display:none">#springMessage('bill.accebill.abBillDiscountApply.discountNet')</div>
            </td>
            <td width="25%">
                <div id="netTd2" style="display:none">
                    <input name="center" id="center" readonly="true" class="layui-input"
                           placeholder="#springMessage('bill.accebill.abBillDiscountApply.discountNet')"></input>
                    <input type="hidden" id="recCorpId" name="recCorpId"></input>
                </div>
            </td>
        </tr>
        <tr id="netTr2" style="display:none" class="ignore-required-hide">
            <td class="textRight" width="8%">#springMessage('bill.accebill.abBillDiscountApply.discountRecAcctId')</td>
            <td width="25%">
                <input type="text" id="recAcctId1" name="recAcctId" data-name="recAcctId1" data-biz-name="recAcctId1"
                       class="bank layui-input bt-biz-accountTable" data-callback="recAcctIdClick"
                       placeholder="#springMessage('bill.accebill.abBillDiscountApply.discountRecAcctId')"
                       lay-verify="strlength" data-maxlength="32"/>
            </td>
            <td class="textRight" width="8%">#springMessage(
                'bill.accebill.abBillDiscountApply.discountRecAcctsvcr')</td>
            <td width="25%"><input type="text" name="recAcctsvcr" class="layui-input" id="recAcctsvcr1"
                                   placeholder="#springMessage('bill.accebill.abBillDiscountApply.discountRecAcctsvcr')"
                                   lay-verify="strlength" data-maxlength="12"></td>
            <td class="textRight" width="8%">#springMessage('bill.accebill.abBillDiscountApply.discountRecNm')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="recNm" class="layui-input" id="recNm1"
                           placeholder="#springMessage('bill.accebill.abBillDiscountApply.discountRecNm')"
                           lay-verify="required|strlength" data-maxlength="240"/>
                </div>
            </td>
        </tr>
        <tr id="bankTr1" class="ignore-required-hide">
            <td class="textRight" width="8%">#springMessage('bill.accebill.update.attachBank')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="recNm" class="layui-input" id="recNm2"
                           placeholder="#springMessage('bill.accebill.abBillDiscountApply.discountBankRecNm')"
                           lay-verify="required|strlength" data-maxlength="240"/>
                    <div class="bt-div-search" id="bankBtn">
                        <button class="bt-biz-bankInfo" type="button" data-callback="bt.bailBankInfoCallback"><i
                                class="layui-icon">&#xe615;</i></button>
                    </div>
                </div>
                <div class="layui-inline">
                    <input type="text" name="recAcctsvcr2" class="layui-input" id="recAcctsvcr2"
                           placeholder="#springMessage('bill.accebill.abBillDiscountApply.discountBankRecAcctsvcr')"
                           lay-verify="required|strlength" data-maxlength="12">
                </div>
            </td>
            <td class="textRight" width="8%">#springMessage(
                'bill.accebill.abBillDiscountApply.discountBankRecAcctId')</td>
            <td width="25%">
                <input type="text" id="recAcctId2" name="recAcctId" data-name="recAcctId2" class="layui-input"
                       placeholder="#springMessage('bill.accebill.abBillDiscountApply.discountBankRecAcctId')"
                       lay-verify="required|strlength" data-maxlength="32"/>
            </td>
            <td class="textRight" width="8%"></td>
            <td width="25%">

            </td>
        </tr>
    #end
    <tr>
        ##划款天数
        <td class="textRight" width="9%">#springMessage('table.abDiscount.paydate')</td>
        <td width="15%">
            <div class="bt-biz-dict" data-type="select" data-group="AB_PAY_DATE" data-defaultvalue="0" data-name="paydate" id="paydate" data-biz-name="paydate" data-placeholder="" data-callback="batchSetCol"></div>
           #* <button  class="layui-btn" type="button"  onclick="batchSetCol()">#springMessage('common.button.batchSet')</button>*#
        </td>
        ##	贴现种类
        <td class="textRight" width="10%">#springMessage('table.abDiscount.rpdmk')</td>
        <td width="24%">
            <div class="bt-biz-dict" data-type="select" data-defaultvalue="RM00" data-group="AB_DISCOUNT_RPDMK" data-name="rpdmk"
                 data-biz-name="rpdmk" id="rpdmk" data-callback="setRpdmk"
                #if(${isNotDiscountApply}) data-placeholder="" data-defaultvalue="RM00"
                #end></div>
        </td>
        ##	清算方式
        <td class="textRight" width="9%">#springMessage('table.abDiscount.sttlmmk')</td>
        <td width="24%">
            <div class="bt-biz-dict" data-type="select" data-group="AB_STTLMMK" data-name="sttlmmk"
                 data-biz-name="sttlmmk" id="sttlmmk" data-callback="setDiscountData"
                #if(${isNotDiscountApply}) data-placeholder="" data-defaultvalue="SM01" #end>
            </div>
        </td>
    </tr>
    <tr>
        ##	转让标记
    <td class="textRight" width="9%">#springMessage('table.abAccrecords.banendrsmtmk')</td>
    <td width="15%">
        <div class="bt-biz-dict" data-type="select" data-group="AB_BANEM" data-defaultvalue="EM00" data-name="bankendrsmtmk"
             data-biz-name="bankendrsmtmk" id="bankendrsmtmk" data-biz-name="bankendrsmtmk" data-placeholder="" data-callback="batchSetCol">
        </div>
        ##批量设置
       #* <button class="layui-btn" type="button" onclick="batchSetCol()">#springMessage('common.button.batchSet')</button>*#
    </td>
    ##	赎回开放日
    <td class="textRight" width="10%">#springMessage('table.abDiscount.rpdopendt')</td>
    <td width="24%">
        <input type="text" name="rpdopendt" class="layui-input bt-biz-dateType" id="rpdopendt" data-endid="rpdduedt"
               data-biz-name="rpdopendt"  readonly="true">
    </td>
        ##	赎回截止日
    <td class="textRight" width="9%">#springMessage('table.abDiscount.rpdduedt')</td>
    <td width="24%"><input type="text" name="rpdduedt" class="layui-input bt-biz-dateType" id="rpdduedt" data-biz-name="rpdduedt" data-callback="changeFn"  readonly="true"></td>
    </tr>

    <tr>
        ##发票号码
        <td class="textRight"  width="9%">#springMessage('table.abDiscount.invcNb')</td>
        <td width="15%">
            <div class="layui-input-inline">
                <input class="layui-input changeClass" name="invcNb" id="invcNb" />
            </div>
           #* <div class="layui-input-inline">
               *##* <button class="layui-btn" type="button" onclick="batchSetCol()">#springMessage('common.button.batchSet')</button>*##*
            </div>*#
        </td>
        ##贴现日期
        <td class="textRight" width="10%">#springMessage('table.abDiscount.discountDate')</td>
        <td width="24%">
            <input type="text" name="discountDate" class="layui-input bt-biz-dateType" id="discountDate"  data-callback="changeFn"
                #if(${isNotDiscountApply}) data-today="true" lay-verify="required" #end>
        </td>
        ##贴现利率
        <td class="textRight" width="9%">#springMessage('table.abDiscount.interestRates')</td>
        <td width="24%">
            <div class="layui-input-inline"><input type="text" data-name="interestRates"
                                                   class="layui-input bt-biz-rateType" data-biz-name="interestRates"
                                                   id="interestRates" data-callback="changeFn"
                                                   data-ratetype="percent" data-superMin="0" #if(${isNotDiscountApply})
                                                   lay-verify="required" #end/></div>
        </td>
    </tr>
    <tr>
        ##	交易合同号
        <td class="textRight" width="9%">#springMessage('table.abDiscount.txlCtrctNb')</td>
        <td width="15%">
            <div class="layui-input-inline">
                <input class="layui-input changeClass" name="txlCtrctNb" id="txlCtrctNb"/>
            </div>
            #*<div class="layui-input-inline">

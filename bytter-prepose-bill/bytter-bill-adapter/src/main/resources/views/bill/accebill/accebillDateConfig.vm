<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body {
            font-size: 14px;
            padding-bottom: 60px;
        }

        .layui-form-label {
            width: 180px;
        }

        .layui-input-block {
            margin-left: 220px;
        }
    </style>
</head>
<body>
    ##贴现到账
<input type="hidden" id="dateByDiscountInfo" value="$!{config.accebill.dateByDiscount}">
<input type="hidden" id="isDateByDiscountDayInfo" value="$!{config.accebill.isDateByDiscountDay}">
<input type="hidden" id="dateByDiscountDayNumInfo" value="$!{config.accebill.dateByDiscountDayNum}">
    ##托收到账
<input type="hidden" id="dateByCollectionInfo" value="$!{config.accebill.dateByCollection}">
<input type="hidden" id="isDateByCollectionDayInfo" value="$!{config.accebill.isDateByCollectionDay}">
<input type="hidden" id="dateByCollectionDayNumInfo" value="$!{config.accebill.dateByCollectionDayNum}">
    ##到期兑付
<input type="hidden" id="dateByCashingInfo" value="$!{config.accebill.dateByCashing}">
<input type="hidden" id="isDateByCashingDayInfo" value="$!{config.accebill.isDateByCashingDay}">
<input type="hidden" id="dateByCashingDayNumInfo" value="$!{config.accebill.dateByCashingDayNum}">

<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <!-- 面板标题 -->
            <h2 class="layui-colla-title">#springMessage('config.accebill.dateConfig.title')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                        ##贴现到账
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.accebill.dateByDiscount')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="checkbox" id="dateByDiscount" name="accebill.dateByDiscount" value="1"
                                       lay-skin="primary"
                                       #if($config.accebill.dateByDiscount == 1)checked#end
                                       title="#springMessage('config.accebill.discountDate')"
                                       lay-filter="dateByDiscount">
                                <span class="bill-dateByDiscount-container">
                                <input type="checkbox" id="isDateByDiscountDay" name="accebill.isDateByDiscountDay" value="1"
                                       lay-skin="primary" lay-filter="isDateByDiscountDay"
                                       #if($config.accebill.isDateByDiscountDay == 1)checked#end
                                       title="#springMessage('config.accebill.delayDate')">
                                </span>
                            </div>
                            <span class="bill-dateByDiscount-container">
                            <div class="layui-input-inline">
                                <input type="text" id="dateByDiscountDayNum" name="accebill.dateByDiscountDayNum"
                                       autocomplete="off"
                                       data-biz-name="dateByDiscountDayNum" data-decimal="0"
                                       class="bt-biz-moneyType layui-input"
                                       value="$!{config.accebill.dateByDiscountDayNum}">
                            </div>
                            <div class="layui-input-inline">#springMessage('common.unit.day')</div>
                            </span>
                        </td>
                    </tr>
                        ##托收到账
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.accebill.dateByCollection')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="checkbox" id="dateByCollection" name="accebill.dateByCollection" value="1"
                                       lay-skin="primary"
                                       #if($config.accebill.dateByCollection == 1)checked#end
                                       title="#springMessage('table.abVoucherinfo.endDate')" lay-filter="dateByCollection">
                                <span class="bill-dateByCollection-container">
                                <input type="checkbox" id="isDateByCollectionDay" name="accebill.isDateByCollectionDay"
                                       #if($config.accebill.isDateByCollectionDay == 1)checked#end
                                       value="1" lay-skin="primary" lay-filter="isDateByCollectionDay"
                                       title="#springMessage('config.accebill.delayDate')">
                                </span>
                            </div>
                            <span class="bill-dateByCollection-container">
                            <div class="layui-input-inline">
                                <input type="text" id="dateByCollection2" name="accebill.dateByCollectionDayNum"
                                       autocomplete="off"
                                       data-biz-name="dateByCollectionDayNum" data-decimal="0"
                                       class="bt-biz-moneyType layui-input"
                                       value="$!{config.accebill.dateByCollectionDayNum}">
                            </div>
                            <div class="layui-input-inline">#springMessage('common.unit.day')</div>
                            </span>
                        </td>
                    </tr>
                        ##到期兑付
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.accebill.dateByCashing')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="checkbox" id="dateByCashing" name="accebill.dateByCashing" value="1"
                                       lay-skin="primary"
                                       #if($config.accebill.dateByCashing == 1)checked#end
                                       title="#springMessage('table.abVoucherinfo.endDate')" lay-filter="dateByCashing">
                                <span class="bill-dateByCashing-container">
                                <input type="checkbox" id="isDateByCashingDay" name="accebill.isDateByCashingDay" value="1"
                                       #if($config.accebill.isDateByCashingDay == 1)checked#end
                                       lay-skin="primary" lay-filter="isDateByCashingDay"
                                       title="#springMessage('config.accebill.delayDate')">
                                </span>
                            </div>
                            <span class="bill-dateByCashing-container">
                            <div class="layui-input-inline">
                                <input type="text" id="dateByCashingDayNum" name="accebill.dateByCashingDayNum"
                                       autocomplete="off"
                                       data-biz-name="dateByCashingDayNum" data-decimal="0"
                                       class="bt-biz-moneyType layui-input"
                                       value="$!{config.accebill.dateByCashingDayNum}"
                                       >
                            </div>
                            <div class="layui-input-inline">#springMessage('common.unit.day')</div>
                            </span>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="20%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary" onclick="resetConfig()">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    var form = {};
    var dicts = {};
    var moneyType;
    bt.use(['form', 'jquery', 'element', 'dicts', 'moneyType'], function () {
        $ = bt.jquery;
        moneyType = bt.moneyType.init();
        dicts = bt.dicts.init();
        form = bt.form()
        // 对所有日期设置最长为五个数字
        moneyType.get('dateByDiscountDayNum').attr('maxlength', 5);
        moneyType.get('dateByCollectionDayNum').attr('maxlength', 5);
        moneyType.get('dateByCashingDayNum').attr('maxlength', 5);

        if (!$('#dateByDiscount').attr('checked')) {
            $('.bill-dateByDiscount-container').hide()
        }

        if (!$('#dateByCollection').attr('checked')) {
            $('.bill-dateByCollection-container').hide()
        }

        if (!$('#dateByCashing').attr('checked')) {
            $('.bill-dateByCashing-container').hide()
        }

        if (!$('#isDateByDiscountDay').attr('checked')) {
            bt.moneyType.get('dateByDiscountDayNum').val(2)
            moneyType.get('dateByDiscountDayNum').attr("disabled", true)
        }

        if (!$('#isDateByCollectionDay').attr('checked')) {
            moneyType.get('dateByCollectionDayNum').val(2)
            moneyType.get('dateByCollectionDayNum').attr("disabled", true)
        }

        if (!$('#isDateByCashingDay').attr('checked')) {
            moneyType.get('dateByCashingDayNum').val(2)
            moneyType.get('dateByCashingDayNum').attr("disabled", true)
        }

        //监听提交
        form.on('submit(configSubmit)', function (data) {
            data.field['accebill.dateByDiscount'] = data.field['accebill.dateByDiscount'] === '' ? 0 : 1
            data.field['accebill.isDateByDiscountDay'] = data.field['accebill.isDateByDiscountDay'] === '' ? 0 : 1
            // 贴现到账组装
            if (data.field['accebill.dateByDiscount'] == 1 && data.field['accebill.isDateByDiscountDay'] == 1) {
                if (data.field['accebill.dateByDiscountDayNum'] == 0 || data.field['accebill.dateByDiscountDayNum'] == '') {
                    layer.alert('贴现到账延期日期不能为空', {icon: 7});
                    return false;
                }
            }
            data.field['accebill.dateByCollection'] = data.field['accebill.dateByCollection'] === '' ? 0 : 1
            data.field['accebill.isDateByCollectionDay'] = data.field['accebill.isDateByCollectionDay'] === '' ? 0 : 1
            // 托收到账组装
            if (data.field['accebill.dateByCollection'] == 1 && data.field['accebill.isDateByCollectionDay'] == 1) {
                if (data.field['accebill.dateByCollectionDayNum'] == 0 || data.field['accebill.dateByCollectionDayNum'] == '') {
                    layer.alert('托收到账延期日期不能为空', {icon: 7});
                    return false;
                }
            }
            data.field['accebill.dateByCashing'] = data.field['accebill.dateByCashing'] === '' ? 0 : 1
            data.field['accebill.isDateByCashingDay'] = data.field['accebill.isDateByCashingDay'] === '' ? 0 : 1
            // 到期兑付组装
            if (data.field['accebill.dateByCashing'] == 1 && data.field['accebill.isDateByCashingDay'] == 1) {
                if (data.field['accebill.dateByCashingDayNum'] == 0 || data.field['accebill.dateByCashingDayNum'] == '') {
                    layer.alert('到期兑付延期日期不能为空', {icon: 7});
                    return false;
                }
            }
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                if (result.success) {
                    location.reload();//重载当前页面
                }
            }, "JSON");
            return false;
        });

        //贴现到账选择
        form.on('checkbox(dateByDiscount)', function (data) {
            var dateByDiscountValue = data.elem.checked
            if (dateByDiscountValue) {
                $('.bill-dateByDiscount-container').show()
            } else {
                $('#isDateByDiscountDay').attr('checked', false)
                moneyType.get('dateByDiscountDayNum').val(2)
                form.render('checkbox')
                $('.bill-dateByDiscount-container').hide()
            }
        })

        //贴现到账延期日期选择
        form.on('checkbox(isDateByDiscountDay)', function (data) {
            if (data.elem.checked) {
                moneyType.get('dateByDiscountDayNum').attr("disabled", false)
            } else {
                moneyType.get('dateByDiscountDayNum').val(2)
                moneyType.get('dateByDiscountDayNum').attr("disabled", true)
            }
        })

        //托收到账选择
        form.on('checkbox(dateByCollection)', function (data) {
            var dateByCollectionValue = data.elem.checked
            if (dateByCollectionValue) {
                $('.bill-dateByCollection-container').show()
            } else {
                $('#isDateByCollectionDay').attr("checked", false)
                moneyType.get('dateByCollectionDayNum').val(2)
                form.render('checkbox')
                $('.bill-dateByCollection-container').hide()
            }
        })

        form.on('checkbox(isDateByCollectionDay)', function (data) {
            if (data.elem.checked) {
                moneyType.get('dateByCollectionDayNum').attr("disabled", false)
            } else {
                moneyType.get('dateByCollectionDayNum').val(2)
                moneyType.get('dateByCollectionDayNum').attr("disabled", true)
            }
        })

        //到期兑付选择
        form.on('checkbox(dateByCashing)', function (data) {
            var dateByCashingValue = data.elem.checked
            if (dateByCashingValue) {
                $('.bill-dateByCashing-container').show()
            } else {
                $('#isDateByCashingDay').attr("checked", false)
                moneyType.get('dateByCashingDayNum').val(2)
                form.render('checkbox')
                $('.bill-dateByCashing-container').hide()
            }
        })

        form.on('checkbox(isDateByCashingDay)', function (data) {
            if (data.elem.checked) {
                moneyType.get('dateByCashingDayNum').attr("disabled", false)
            } else {
                moneyType.get('dateByCashingDayNum').val(2)
                moneyType.get('dateByCashingDayNum').attr("disabled", true)
            }
        })

    });

// 重置页面
function resetConfig() {
    if (!$('#dateByDiscount').attr('checked')) {
        $('.bill-dateByDiscount-container').hide()
    } else {
        if ($('#isDateByDiscountDayInfo').val() == 1) {
            $('#isDateByDiscountDay').attr('checked', true)
            moneyType.get('dateByDiscountDayNum').attr("disabled", false)
        }
        $('.bill-dateByDiscount-container').show()
    }
    if (!$('#dateByCollection').attr('checked')) {
        $('.bill-dateByCollection-container').hide()
    } else {
        if ($('#isDateByCollectionDayInfo').val() == 1) {
            $('#isDateByCollectionDay').attr('checked', true)
            moneyType.get('dateByCollectionDayNum').attr("disabled", false)
        }
        $('.bill-dateByCollection-container').show()
    }
    if (!$('#dateByCashing').attr('checked')) {
        $('.bill-dateByCashing-container').hide()
    } else {
        if ($('#dateByCashingDayNumInfo').val() == 1) {
            $('#dateByCashingDayNum').attr('checked', true)
            moneyType.get('dateByCashingDayNum').attr("disabled", false)
        }
        $('.bill-dateByCashing-container').show()
    }
}
</script>
</body>
</html>

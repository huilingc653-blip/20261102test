<!DOCTYPE html>
<html lang="en">
<input type="hidden" id="caType" value="10"/>
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container dark-layui-table layui-table-border">
        <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
        <div class="layui-collapse" lay-filter="collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title"></h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table">
                        <tbody>
                        <tr>
                            ## 申请单位
                            <td width="8%" class="textRight">#springMessage('bill.accebill.applyCorp')</td>
                            <td width="25%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-corp"
                                         data-tree-type="check"
                                         data-biz-type="corp"
                                         data-type="selectTree"
                                         data-name="ins_applyCorpId"
                                         data-scope="all"
                                         data-resource="sys:flow:query:corpop"
                                         data-callback="applyCorpCallback"></div>
                                </div>
                            </td>
                            ## 票据单位
                            <td width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                            <td width="25%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-corp"
                                         data-biz-name="corpId"
                                         data-tree-type="check"
                                         data-biz-type="corp"
                                         data-type="selectTree"
                                         data-name="ins_corpId"
                                         data-resource="sys:flow:query:corpop"
                                         data-scope="all"></div>
                                </div>
                            </td>
                            ## 业务单位
                            <td width="8%" class="textRight">#springMessage('bill.accebill.busCorp')</td>
                            <td width="25%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-corp"
                                         data-tree-type="check"
                                         data-biz-type="corp"
                                         data-type="selectTree"
                                         data-name="ins_busCorpId"
                                         data-scope="all"
                                         data-resource="sys:flow:query:corpop"></div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##业务人员
                            <td width="8%" class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                            <td width="25%">
                                <div class="layui-input-inline">
                                    <input type="text" name="likes_busPersonnel"
                                           autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('bill.accebill.busPersonnel')">
                                </div>
                            </td>
                            ##收票日期
                            <td width="10%" class="textRight">#springMessage('bill.accebill.receDate')</td>
                            <td width="20%">
                                <div class="layui-inline">
                                    <input type="text" name="ged_receDate" data-biz-name="ged_receDate"
                                           class="layui-input bt-biz-dateType" data-endid="receDate" data-type="date"
                                           value="$!{receDate}">
                                </div>
                                <span class="date-mid">~</span>
                                <div class="layui-inline">
                                    <input type="text" name="led_receDate" lay-verify="required" data-today="true"
                                           　data-name="led_receDate" class="layui-input bt-biz-dateType" id="receDate"
                                           data-type="date">
                                </div>
                            </td>
                            ##流通介质
                            <td class="textRight" width="10%">#springMessage('table.abVoucherinfo.billFlag')</td>
                            <td width="20%">
                                <div class=layui-form>
                                    <div class="bt-biz-dict" data-type="mulselect" data-defaultvalue="11,10"
                                         data-required="true"
                                         data-name="ini_billFlag" data-group="AB_BILL_FLAG" data-biz-name="billFlag">
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##票据号码
                            <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" name="likes_origNo"
                                           autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('table.abVoucherinfo.origNo')">
                                </div>
                            </td>
                            ##出票日期
                            <td class="textRight" width="10%">#springMessage('table.abVoucherinfo.startDate')</td>
                            <td>
                                ##                            <div class="layui-input-inline">
                                ##                                <input type="text" name="ged_startDate" class="layui-input bt-input-inline  bt-biz-dateType" data-endid="startDate" placeholder="#springMessage('table.abVoucherinfo.startDate')">
                                ##                                <span class="date-mid">~</span>
                                ##                                <input type="text" name="led_startDate" class="layui-input bt-input-inline  bt-biz-dateType" id="startDate" placeholder="#springMessage('table.abVoucherinfo.startDate')">
                                ##                            </div>
                                <div class="layui-inline">
                                    <div id="startDate"></div>
                                </div>
                            </td>
                            ##票据类型
                            <td width="10%" class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                            <td>
                                <div class=layui-form>
                                    <div class="bt-biz-dict" data-type="mulselect" data-defaultvalue="10,11"
                                         data-required="true"
                                         data-name="ini_billType" data-group="AB_BILL_TYPE" data-biz-name="billType">
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##到期日期
                            <td class="textRight" width="10%">#springMessage('table.abVoucherinfo.endDate')</td>
                            <td>
                                ##                            <div class="layui-inline">
                                ##                                <input type="text" name="ged_endDate" data-biz-name="ged_endDate"
                                ##                                       class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                                ##                            </div>
                                ##                            <span class="date-mid">~</span>
                                ##                            <div class="layui-inline">
                                ##                                <input type="text" name="led_endDate" data-name="led_endDate"
                                ##                                       class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                                ##                            </div>
                                <div class="layui-inline">
                                    <div id="endDate"></div>
                                </div>
                            </td>
                            ##银行类别
                            <td class="textRight">#springMessage('table.btBankAcc.bankTypeId')</td>
                            <td width="24%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                                         data-method="get"
                                         data-valuefield="id" data-textfield="typeName" data-name="bankTypeId"
                                         data-inputvalue="inputvalue" data-search="true"></div>
                                </div>
                            </td>
                            ##出票行
                            <td class="textRight" width="12%">#springMessage('bill.accebill.payerNo')</td>
                            <td><input type="text" name="likes_payerBankName"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('bill.accebill.payerNo')">
                            </td>
                        </tr>
                        <tr>
                            ##票据金额
                            <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                            <td>
                                <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text"
                                       data-name="geg_billMoney"
                                       data-moneyendid="leg_billMoney"
                                       placeholder="#springMessage('table.abVoucherinfo.billMoney')"/>
                                <span class="date-mid">~</span>
                                <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_billMoney" type="text"
                                       data-name="leg_billMoney"
                                       placeholder="#springMessage('table.abVoucherinfo.billMoney')"/>
                            </td>
                            ##转让日期
                            <td class="textRight" width="10%">#springMessage('ab.accebill.transferDate')</td>
                            <td>
                                <div class="layui-inline">
                                    <input type="text" name="ged_transferDate"
                                           data-biz-name="ged_transferDate"
                                           class="layui-input bt-biz-dateType"
                                           data-endid="transferDate" data-type="date">
                                </div>
                                <span class="date-mid">~</span>
                                <div class="layui-inline">
                                    <input type="text" name="led_transferDate"
                                           data-name="led_transferDate"
                                           class="layui-input bt-biz-dateType"
                                           id="transferDate" data-type="date">
                                </div>
                            </td>
                            ##出票标志
                            <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
                            <td width="24%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND"
                                         data-defaultvalue="$!{abReceiveBillPage.newStmIssuofpprInd}"
                                         data-name="eqs_newStmIssuofpnewStmIssuofpprIndprInd"></div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##票据是否允许分包
                            <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
                            <td width="24%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND"
                                         data-defaultvalue="$!{abReceiveBillPage.blgrdbagcrclPrmtInd}"
                                         data-name="eqs_blgrdbagcrclPrmtInd"></div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="6" style="text-align: center;">
                                <div class="layui-inline">
                                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                                        'common.button.search')</button>
                                    <button type="reset" class="layui-btn layui-btn-primary"
                                            data-callback="clearData">#springMessage('common.button.reset')</button>
                                </div>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;" style="display:none" data-btns="colvis">
        <thead>
        <tr>
            <th>#springMessage('bill.accebill.applyCorp')</th>##申请单位
            <th>#springMessage('table.abVoucherinfoVo.corpId')</th>##票据单位1
            <th>#springMessage('bill.accebill.busCorp')</th>##业务单位
            <th>#springMessage('bill.accebill.busPersonnel')</th>##业务人员2
            <th>#springMessage('table.abVoucherinfo.billFlag')</th>##流通介质
            <th>#springMessage('table.abVoucherinfo.billType')</th>##票据类型3
            <th>#springMessage('table.abVoucherinfo.origNo')</th>##票据号码
            <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>##子票区间开始序号4
            <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>##子票区间结束序号
            <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>##标准金额5
            <th>#springMessage('table.abVoucherinfo.billMoney')</th>##票据（包）金额
            <th>#springMessage('table.abVoucherinfo.payer')</th>##出票人6
            <th>#springMessage('table.abVoucherinfo.acceptor')</th>##承兑人
            <th>#springMessage('table.abVoucherinfo.startDate')</th>##出票日期7
            <th>#springMessage('table.abVoucherinfo.endDate')</th>##到期日期
            <th>#springMessage('bill.accebill.backOrRec')</th>##	背书人（前手）8
            <th>#springMessage('bill.accebill.billSendSign')</th>##线上线下标志
            <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>##票据是否允许分包流转9
            <th>#springMessage('table.abVoucherinfoVice.socCode')</th>##票据单位统一识别号码
            <th>#springMessage('common.table.thead.operation')</th>##操作
        </tr>
        </thead>
    </table>
        #workFlowHtml()
        #parse("views/common/footer.vm")
        #caDataHidden()
        #caDataScript()
        #workFlowScript()
    <script src="${basePath}/static/modules/bill/accebill/approve/abBillNonassignableCancelApprove.list.js?_btv=${resourceVersion}"></script>
    <script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</body>
</html>

#* 
*002提示承兑签收
*#
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.accebill.acceptinfo.title')</h2>
		<div class="layui-colla-content layui-show">
			<table class="layui-table">
			<tbody>
			<tr>
				<td width="20%" class="textRight">#springMessage('table.abBackbillinfo.ucondlconsgnmtmrk')</td>
				<td width="30%">$!{info.ucondlprmsmrkName}</td>
				<td width="20%" class="textRight">#springMessage('table.abVoucherinfo.accptncagrmtnb')</td>
				<td width="30%">
					#if(!$isApprove&&!$isShow)
					<input type="text" id="accptncagrmtnb" name="accptncagrmtnb" value="$!{info.accptncagrmtnb}" lay-verify="strlength" data-maxlength="30" 
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.accptncagrmtnb')"/>
					#else
						$!{info.accptncagrmtnb}
					#end
				</td>
			</tr>
			#if($isApprove||$isShow)
			<tr>
				##业务标记
				<td width="20%" class="textRight">#springMessage('table.abVoucherinfo.Business.Brief.Id')</td>
				<td width="30%">
					$!{info.briefIdName}
				</td>
				<td width="20%" class="textRight">#springMessage('bill.accebill.op')</td>
				<td width="30%">
					#if($info.createBy)
					($!{info.createBy})
					#end
					$!{info.createName}
				</td>
			</tr>
			#end
			<tr>
				<td width="20%" class="textRight">#springMessage('table.abAccrecords.applyDate')</td>
				<td width="30%">$!date.format('yyyy-MM-dd',$!{info.bussdt})</td>
				<td width="20%" class="textRight">#springMessage('bill.accebill.signDate')</td>
				<td width="30%">$!date.format('yyyy-MM-dd',$!{info.replyDt})</td>
            </tr>
			<tr>
				<td width="20%" class="textRight">#springMessage('table.abBackbillinfo.txlctrctnb')</td>
				<td width="30%">$!{info.txlctrctnb}</td>
				<td width="20%" class="textRight">#springMessage('table.abVoucherinfo.aInvcnb')</td>
				<td width="30%">$!{info.invcnb}</td>
            </tr>
			<tr>
				<td width="20%" class="textRight">#springMessage('table.abBackbillinfo.cdtratgs')</td>
				<td width="30%">
					#if(!$isApprove&&!$isShow)
					<input type="text" id="cdtratgs" name="cdtratgs" value="$!{info.cdtratgs}" lay-verify="strlength" data-maxlength="3"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.abBackbillinfo.cdtratgs')"/>
					#else
						$!{info.cdtratgs}
					#end
				</td>
				<td width="20%" class="textRight">#springMessage('table.abBackbillinfo.cdtratgagcy')</td>
				<td width="30%">
					#if(!$isApprove&&!$isShow)
					<input type="text" id="cdtratgagcy" name="cdtratgagcy" value="$!{info.cdtratgagcy}" lay-verify="strlength" data-maxlength="50"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.abBackbillinfo.cdtratgagcy')"/>
					#else
						$!{info.cdtratgagcy}
					#end		
				</td>
            </tr>
			<tr>
				<td width="20%" class="textRight">#springMessage('table.abBackbillinfo.cdtratgduedt')</td>
				<td width="30%">
					#if(!$isApprove&&!$isShow)
					<div class="layui-input-inline">
                        <input name="cdtratgduedt" class="layui-input bt-biz-dateType" value="$!{info.cdtratgduedt}"
							type="text" data-type="date" data-biz-name="cdtratgduedt">
                    </div>
					#else
						$!date.format('yyyy-MM-dd',$!{info.cdtratgduedt})
					#end
				</td>
				<td width="20%" class="textRight"></td>
				<td width="30%"></td>
            </tr>
			<tr>
				<td width="20%" class="textRight">#springMessage('bill.accebill.payerRmk')</td>
				<td width="30%">$!{info.rmk}</td>
				<td width="20%" class="textRight"></td>
				<td width="30%"></td>
            </tr>
            </tbody>
            </table>
        </div>
        </div>
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.accebill.drawerinfo.title')</h2>
		<div class="layui-colla-content layui-show">
			<table class="layui-table">

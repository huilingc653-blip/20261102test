				<td width="20%" class="textRight">#springMessage('bill.accebill.acctsvcrAg')</td>
				<td width="30%">$!{info.reqAcctsvcrAg}</td>
            </tr>
            </tbody>
            </table>
        </div>
        </div>
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.accebill.acceptorinfo.title')</h2>
		<div class="layui-colla-content layui-show">
			<table class="layui-table">
			<tbody>
			<tr>
				<td width="20%" class="textRight">#springMessage('bill.accebill.name')</td>
				<td width="30%">$!{info.recNm}</td>
				<td width="20%" class="textRight">#springMessage('bill.accebill.bankacc')</td>
				<td width="30%">$!{info.recAcctId}</td>
            </tr>
			<tr>
				<td width="20%" class="textRight">#springMessage('bill.accebill.bankno')</td>
				<td width="30%">$!{info.recAcctsvcr}</td>
				<td width="20%" class="textRight"></td>
				<td width="30%"></td>
            </tr>
            </tbody>
            </table>
        </div>
        </div>

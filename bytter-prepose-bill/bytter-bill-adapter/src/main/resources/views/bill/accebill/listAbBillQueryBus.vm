<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ## 申请单位
                        <td width="8%" class="textRight">#springMessage('bill.accebill.applyCorp')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_applyCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:billbus:query:corpop"
                                     data-callback="applyCorpCallback"
                                >
                                </div>
                            </div>
                        </td>
                        ## 票据单位
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-name="corpId"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_corpId"
                                     data-resource="bill:accebill:billbus:query:corpop"
                                     data-scope="all"
                                >
                                </div>
                            </div>
                        </td>
                        ## 业务单位
                        <td width="8%" class="textRight">#springMessage('bill.accebill.busCorp')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_busCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:billbus:query:corpop"
                                >
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##业务人员
                        <td width="8%" class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_busPersonnel"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('bill.accebill.busPersonnel')">
                            </div>
                        </td>
                        ##票据号码
                        <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                        <td width="20%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_origNo"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.origNo')">
                            </div>
                        </td>
                        ##业务类型
                        <td class="textRight">#springMessage('table.abAccrecords.briefId')</td>
                        <td width="20%">
                            ##<div class="layui-input-inline">
                            ##<div class="bt-biz-mulselectType"
                            ##	data-url="${basePath}/bill/accebill/abbillQuery/listBusType"
                            ##	data-valuefield="status"
                            ##	data-textfield="statusname"
                            ##	data-name="ins_briefId" ></div>
                            ##</div>
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="mulselect" data-name="ins_briefId"
                                     data-filterData="6203,8018,8818,8019" data-group="AB_BRIEF_STATUS">
                                </div>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        ##票据金额
                        <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                        <td>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text"
                                   data-name="geg_billMoney"
                                   data-moneyendid="leg_billMoney"
                                   placeholder="#springMessage('table.abVoucherinfo.billMoney')"/>
                            <span class="date-mid">~</span>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_billMoney" type="text"
                                   data-name="leg_billMoney"
                                   placeholder="#springMessage('table.abVoucherinfo.billMoney')"/>
                        </td>
                        ##流通介质
                        <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
                        <td width="20%">
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="select" data-name="ini_billFlag"
                                     data-group="AB_BILL_FLAG">
                                </div>
                            </div>
                        </td>
                        ##票据类型
                        <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                        <td width="20%">
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="select" data-name="ini_billType"
                                     data-group="AB_BILL_TYPE">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##申请日期
                        <td class="textRight">#springMessage('bill.accebill.applyDate')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" name="ged_applyDate" data-name="ged_applyDate"
                                       class="layui-input bt-biz-dateType" data-endid="applyDate" data-type="date">
                            </div>
                            ~
                            <div class="layui-inline"
                            ">
                            <input type="text" name="led_applyDate" 　data-name="led_applyDate"
                                   class="layui-input bt-biz-dateType" id="applyDate" data-type="date">
            </div>
            </td>
            ##业务来源
            <td width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.billSource')</td>
            <td width="25%">
                <div class=layui-form>
                    <div class="bt-biz-dict" data-type="mulselect" data-name="ins_sourceName"
                         data-group="AB_BILL_SOURCE_QUERY">
                    </div>
                </div>
            </td>
            ##所属库存
            <td width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.enterStock')</td>
            <td width="25%">
                <div class=layui-form>
                    <div class="bt-biz-dict" data-type="mulselect" data-name="ins_enterStockName"
                         data-group="AB_ENTER_STOCK">
                    </div>
                </div>
            </td>
            </tr>
            <tr>
                ##业务归属日期
                <td class="textRight">#springMessage('table.abAccrecords.businessDate')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" name="ged_businessDate" data-name="ged_businessDate"
                               class="layui-input bt-biz-dateType" data-endid="businessDate" data-type="date">
                    </div>
                    ~
                    <div class="layui-inline"
                    ">
                    <input type="text" name="led_businessDate" 　data-name="led_businessDate"
                           class="layui-input bt-biz-dateType" id="businessDate" data-type="date">
        </div>
        </td>
        ##申请人
        <td class="textRight">#springMessage('bill.accebill.applyName')</td>
        <td width="20%">
            <div class="layui-input-inline">
                <input type="text" name="likes_applyName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.applyName')">
            </div>
        </td>
        ##在线离线标志
        <td class="textRight">#springMessage('bill.accebill.billSendSign')</td>
        <td>
            <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_SEND_SIGN" data-name="eqs_sendSign"></div>
        </td>
        </tr>
        <tr>
            ##出票日期
            <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
            <td>
                <div class="layui-inline"
                ">
                <input type="text" name="ged_startDate" data-name="ged_startDate" class="layui-input bt-biz-dateType"
                       data-endid="startDate" data-type="date"/>
    </div>
    ~
    <div class="layui-inline"
    ">
    <input type="text" name="led_startDate" 　data-name="led_startDate" class="layui-input bt-biz-dateType"
           id="startDate" data-type="date"/>
    </div>
    </td>

    <td class="textRight">#springMessage('bill.accebill.payerNo')</td>
    <td><input type="text" name="likes_payerBankName"
               autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.payerNo')">
    </td>

    ##收票人
    <td class="textRight">
        #springMessage('table.abVoucherinfo.payee')
    </td>
    <td>
        <div class="layui-input-inline">
            <input type="text" id="payee" name="likes_payee" autocomplete="off" class="layui-input"
                   placeholder="#springMessage('table.abVoucherinfo.payee')" lay-verify="" data-maxlength="50">
            <div class="bt-div-search">
                <button class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button"
                        data-callback="bt.bailPayeeCallback" opType="payeeExternalClick"
                        title="#springMessage('common.button.select')">
                    <i class="layui-icon">&#xe615;</i>
                </button>
            </div>
        </div>
    </td>
    </tr>
    <tr>
        ##到期日期
        <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
        <td>
            <div class="layui-inline"
            ">
            <input type="text" name="ged_endDate" data-name="ged_endDate" class="layui-input bt-biz-dateType"
                   data-endid="endDate" data-type="date"/>
            </div>
            ~
            <div class="layui-inline"
            ">
            <input type="text" name="led_endDate" 　data-name="led_endDate" class="layui-input bt-biz-dateType"
                   id="endDate" data-type="date"/>
            </div>
        </td>
        ##前手
        <td class="textRight">
            #springMessage('bill.accebill.cnAccrecords')
        </td>
        <td>
            <div class="layui-input-inline">
                <input type="text" id="cnAccrecords" name="likes_cnAccrecords" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('bill.accebill.cnAccrecords')" lay-verify="" data-maxlength="50">
                <div class="bt-div-search">
                    <button class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button"
                            data-callback="bt.bailCnAccrecordsCallback" opType="cnAccrecordsExternalClick"
                            title="#springMessage('common.button.select')">
                        <i class="layui-icon">&#xe615;</i>
                    </button>
                </div>
            </div>
        </td>
        ##所属账户
        <td class="textRight">#springMessage('bill.accebill.theBankAcc')</td>
        <td width="20%">
            <div class="layui-input-inline">
                <input type="text" name="likes_bankAcc"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.theBankAcc')">
            </div>
        </td>

    </tr>
    <tr>
        ##业务状态
        <td class="textRight">#springMessage('bill.accebill.busStatus')</td>
        <td>
            <div class="bt-biz-dict" data-type="mulselect" data-group="AB_BILL_BUSSTATUS"
                 data-name="ini_busStatus"></div>
        </td>
        ##指令状态
        <td class="textRight">#springMessage('bill.accebill.InstructionStatus')</td>
        <td width="20%">
            <div class="bt-biz-dict" data-group="AB_BILL_INSOPTSTATUS" data-name="ins_instructStatusName"
                 data-type="mulselect"></div>
        </td>
        ##所属账户银行类别
        <td class="textRight">#springMessage('bill.accebill.bankType')</td>
        <td width="20%">
            <div class="layui-input-inline">
                <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                     data-method="get"
                     data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                     data-inputvalue="inputvalue" data-search="true"></div>
            </div>
        </td>

    </tr>
    <tr>
        <td class="textRight">#springMessage('bill.accebill.isAutosign')</td>
        <td>
            <div class="bt-biz-dict" data-type="mulselect" data-name="ins_isAutosignName" data-group="sf_yn">
            </div>
        </td>
        ##收付标记
        <td class="textRight">#springMessage('bill.accebill.billpayerpayeetype')</td>
        <td>
            <div class=layui-form>
                <div class="bt-biz-dict" data-type="select" data-name="ins_type"
                     data-group="BILL_PAYERPAYEE_TYPE"></div>
            </div>
        </td>
        ##后手
        <td class="textRight" width="12%">#springMessage('bill.accebill.rearAccrecords')</td>
        <td><input type="text" name="likes_rearAccrecords"
                   autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.rearAccrecords')">
        </td>
    </tr>
    <tr>
        ##承兑人
        <td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
        <td>
            <div class="layui-input-inline">
                <input type="text" name="likes_acceptor"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.abVoucherinfo.acceptor')">
            </div>
        </td>
        ##是否对内
        <td class="textRight">#springMessage('bill.accebill.intenal')</td>
        <td>
            <div class="layui-input-inline">
                <div class=bt-biz-dict data-type="select" data-name="eqs_insideSing" data-group="sf_yn"></div>
            </div>
        </td>
        ##出票标志
        <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
        <td width="24%">
            <div class="layui-input-inline">
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND"
                     data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
            </div>
        </td>
    </tr>
    <tr>
        ##票据是否允许分包
        <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
        <td width="24%">
            <div class="layui-input-inline">
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND"
                     data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
            </div>
        </td>
        ##开票批次号
        <td class="textRight">#springMessage('bill.accebill.batchNo')</td>
        <td>
            <input type="text" class="layui-input" name="likes_batchNo">
        </td>
            ##子票区间号码
            <td class="textRight">#springMessage('bill.accebill.sti')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="likes_sbbllRngStrtSn"
                           autocomplete="off" class="layui-input" maxlength="12"
                           placeholder="#springMessage('table.abVoucherinfo.sbbllRngStrtSn')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" name="likes_sbbllRngEndSn"
                           autocomplete="off" class="layui-input" maxlength="12"
                           placeholder="#springMessage('table.abVoucherinfo.sbbllRngEndSn')">
                </div>
            </td>
    </tr>
    <tr>
        ##付款单号
        <td class="textRight">#springMessage('table.nisBillhead.billNo')</td>
        <td>
            <input type="text" name="likes_payNo"
                   autocomplete="off" class="layui-input"
                   placeholder="#springMessage('table.nisBillhead.billNo')">
        </td>
        <td class="textRight">#springMessage('table.abAccrecords.rmk')</td>
        <td>
            <div class="layui-input-inline">
                <input type="text" name="likes_rmk"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.abAccrecords.rmk')">
            </div>
        </td>
        <td></td>
        <td></td>
    </tr>
    <tr>
        <td colspan="6" style="text-align: center;">
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </div>
        </td>
    </tr>
    </tbody>
    </table>
    </div>
    </div>
    </div>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('bill.accebill.applyCorp')</th>
        <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
        <th>#springMessage('bill.accebill.busCorp')</th>
        <th>#springMessage('bill.accebill.busPersonnel')</th>
        <th>#springMessage('bill.accebill.theBankAcc')</th>
        <th>#springMessage('bill.accebill.bankType')</th>
        <th>#springMessage('table.bvVoucherType.validSign')</th>
        <th>#springMessage('bill.accebill.origNo')</th>
        <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
        <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
        <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>
        <th>#springMessage('table.nisBillhead.billNo')</th>
        <th>#springMessage('table.abVoucherinfoVice.socCode')</th>
        <th>#springMessage('bill.accebill.batchNo')</th>
        <th>#springMessage('table.abAccrecords.briefId')</th>
        <th>#springMessage('table.abVoucherinfoVice.billSource')</th>
        <th>#springMessage('table.abVoucherinfoVice.enterStock')</th>
        <th>#springMessage('table.abVoucherinfo.billFlag')</th>
        <th>#springMessage('table.abVoucherinfo.billType')</th>
        <th>#springMessage('bill.accebill.billMoney')</th>
        <th>#springMessage('bill.accebill.applyName')</th>
        <th>#springMessage('bill.accebill.applyDate')</th>
        <th>#springMessage('table.abAccrecords.businessDate')</th>
        <th>#springMessage('table.abVoucherinfo.startDate')</th>
        <th>#springMessage('table.abVoucherinfo.endDate')</th>
        <th>#springMessage('table.abDiscount.interestRates')</th>
        <th>#springMessage('table.abDiscount.interest')</th>
        <th>#springMessage('table.abVoucherinfo.payer')</th>
        <th>#springMessage('bill.accebill.payerNo')</th>
        <th>#springMessage('table.abVoucherinfo.payee')</th>
        <th>#springMessage('table.abVoucherinfo.acceptor')</th>
        <th>#springMessage('bill.accebill.cnAccrecords')</th>
        <th>#springMessage('bill.accebill.rearAccrecords')</th>
        <th>#springMessage('bill.accebill.billSendSign')</th>
        <th>#springMessage('bill.accebill.busStatus')</th>
        <th>#springMessage('bill.accebill.inoptStatus')</th>
        <th>#springMessage('table.abAccrecords.returnCode')</th>
        <th>#springMessage('table.abAccrecords.returnMsg')</th>
        <th>#springMessage('table.abAccrecords.abs')</th>
        <th>#springMessage('table.abAccrecords.rmk')</th>
        <th>#springMessage('bill.accebill.abbillcollectionapply.isOverdueRmk')</th>
        <th>#springMessage('table.abAccrecords.receiveTrader')</th>
        <th>#springMessage('table.abAccrecords.endorseTrader')</th>
        <th>#springMessage('bill.accebill.isAutosign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillQueryBus.list.js?_btv=${resourceVersion}"></script>

				<span class="mui-badge mui-badge-inverted">
					$!{info.bankCode}
				</span>
			</li>
		</ul>
	</li>
	<li class="mui-table-view-cell mui-collapse">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.pledgeRecinfo.title')</a>

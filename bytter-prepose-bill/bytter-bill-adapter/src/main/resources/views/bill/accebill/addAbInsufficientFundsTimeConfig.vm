<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="bankTypeName" name="bankTypeName" type="hidden">
    <table class="layui-table">
        <tbody >
        <tr>
            ##银行名称
            <td class="textRight" width="15%">#springMessage('btBankType.typeName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="/basic/business/btbanktype/listFilter"
                     data-name ="bankTypeId" data-biz-name ="bankTypeId"  data-valueField="id" data-required="true" data-textField="typeName"
                     data-callback="bankinfoCallback"
                ></div>
            </td>
        </tr>
        <tr>
            ##时间
            <td width="10%" class="textRight">#springMessage('table.bytterTest.createTime')</td>
            <td width="20%">
                <div class="layui-inline">
                    <input type="text" name="time" data-biz-name="time" id="time" lay-verify="required"
                           class="layui-input bt-biz-dateType" data-type="time">
                </div>
            </td>
        </tr>
        <tr >
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abInsufficientFundsTimeConfig.add.js?_btv=${resourceVersion}"></script>
</html>

#* 
*6201 票据上划
*#
	<li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.transferupapply.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
				##上划单位
				#springMessage('bill.accebill.transferupapply.transferupcorp')
                <span class="mui-badge mui-badge-inverted">
					$!{info.corpName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##上划单位开户银行
				#springMessage('bill.accebill.transferupapply.transferupbank')
                <span class="mui-badge mui-badge-inverted">
					$!{info.corpBankName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##上划银行账号
				#springMessage('bill.accebill.transferupapply.transferupbankacc')
                <span class="mui-badge mui-badge-inverted">
					$!{info.reqAcctId}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##上划银行行号
				#springMessage('bill.accebill.transferupapply.transferupbankno')
                <span class="mui-badge mui-badge-inverted">
					$!{info.reqAcctsvcr}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##中心单位
				#springMessage('bill.accebill.transferupapply.centercorp')
                <span class="mui-badge mui-badge-inverted">
					$!{info.netCorpName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				## 中心单位开户银行
				#springMessage('bill.accebill.transferupapply.centerbank')
                <span class="mui-badge mui-badge-inverted">
					$!{info.netBankName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				## 中心银行账号
				#springMessage('bill.accebill.transferupapply.centerbankacc')
                <span class="mui-badge mui-badge-inverted">
					$!{info.recAcctId}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				## 中心银行行号
				#springMessage('bill.accebill.transferupapply.centerbankno')
                <span class="mui-badge mui-badge-inverted">
					$!{info.recAcctsvcr}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##业务办理日期
				#springMessage('table.abVoucherinfo.Business.date')
                <span class="mui-badge mui-badge-inverted">
					$!date.format('yyyy-MM-dd',$!{info.businessDate})
    			</span>
            </li>
		</ul>
    </li>

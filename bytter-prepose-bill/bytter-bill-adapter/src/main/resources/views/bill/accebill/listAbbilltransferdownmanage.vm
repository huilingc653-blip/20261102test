<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
					##下拨中心
					<input type="hidden" id="netId" name="eqs_netId"  value="$!{netId}" readonly="true">
					<td class="textRight">#springMessage('bill.accebill.transferdownmanage.corpCenter')</td>
					<td width="25%">
						<div class="layui-input-inline">
							<div class="bt-biz-corp" 
								 ##此处data-name提交有问题，提交名称见netId input，如果重置了，则后台取此处的值 
								 data-name="snetId" 
								 data-biz-type="net" 
								 data-type="selectTree"
								 data-required="true"
								 data-callbackData="netCallback"
								 data-defaultvalue="$!{netId}"
                                 data-scope="net"
								 data-resource="ab:bill:resource:transferdownmanage:query">
							</div>
                        </div>
                    </td>
                    ##申请单位
					<td class="textRight">#springMessage('table.abBillTransfer.applyCorp')</td>
					<td width="25%">
						<div class="layui-input-inline">
							<div id="corpId"></div>
                        </div>
                    </td>
					##业务处理状态
					<td class="textRight">#springMessage('table.abAccrecords.status')</td>
					<td width="25%">
						<div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TRANSFERDOWNAPPLY_STATUS" data-name="eqs_statusName"></div>
					</td>
                </tr>
				<tr>
					##下拨金额
                    <td class="textRight">#springMessage('table.abBillTransfer.downMoney')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="geg_allocationMoney" data-moneyendid="endMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                        </div>
                        ~
                        <div class="layui-input-inline">
                            <input type="text" name="leg_allocationMoney" id="endMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                        </div>
                    </td>
					##下拨单号
					<td class="textRight">#springMessage('table.abBillTransfer.allocatedCode.down')</td>
					<td width="25%">
						<input type="text" class="layui-input" name="likes_allocatedCode">
					</td>
					##申请单号
					<td class="textRight">#springMessage('table.abBillTransfer.allocatedCode.apply')</td>
					<td width="25%">
						<input type="text" class="layui-input" name="likes_applyCode">
					</td>
				</tr>
				<tr>
					<td width="8%" class="textRight">#springMessage('table.bill.bankType.holderBankType')</td>
					<td width="25%">
						<div class="layui-input-inline">
							<div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
								 data-method="get"
								 data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
								 data-inputvalue="inputvalue" data-search="true"></div>
						</div>
					</td>
				</tr>
				#if($shiro.hasPermission("ab:bill:resource:transferdownmanage:query"))
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
				#end
            </tbody>
        </table>
    </form>

#if($shiro.hasPermission("ab:bill:resource:transferdownmanage:query"))
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>		
        <th>#springMessage('table.abBillTransfer.allocatedCode.down')</th>
		<th>#springMessage('table.abBillTransfer.allocatedCode.apply')</th>
		<th>#springMessage('table.abBillTransfer.recordCorpId')</th>
		<th>#springMessage('table.abBillTransfer.recevieCorpId')</th>
		#*<th>#springMessage('table.abBillTransfer.billNo')</th>*#
		<th>#springMessage('table.abBillTransfer.recevieBankAcc')</th>
		<th>#springMessage('table.abBillTransfer.applyMoney')</th>
		<th>#springMessage('table.abBillTransfer.downMoney')</th>
		<th>#springMessage('table.abBillTransfer.applyReason')</th>
		<th>#springMessage('table.abBillTransfer.downReason')</th>
		<th>#springMessage('table.abBillTransfer.status')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#end

##<form class="layui-form">
##	<div class=layui-inline>
##		<idv class=date-single></div>
##	</div>
##</form>
	<table class="layui-table">
		<tbody>
		<tr>
			<td width="8%" class="textRight">
				#springMessage('table.abVoucherinfo.Business.date')
			</td>
			<td width="25%">
				<div class=layui-inline>
					<idv class=date-single></div>
				</div>
			</td>
			<td width="8%" class="textRight">
			</td>
			<td width="25%">
			</td>
			<td width="8%" class="textRight">
			</td>
			<td width="25%">
			</td>
		</tr>
		</tbody>
	</table>
	<br>

#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abbilltransferdownmanage.list.js?_btv=${resourceVersion}"></script>
</html>

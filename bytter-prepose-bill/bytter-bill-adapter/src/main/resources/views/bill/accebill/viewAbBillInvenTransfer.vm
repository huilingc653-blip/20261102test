
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<div class="layui-collapse">
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.accebill.billInfo.title')</h2>
		<div class="layui-colla-content layui-show">
        <table class="layui-table">
			<tbody>
			<tr>
        		##持票单位
				<td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
				<td width="40%">$!{abReceiveBillPage.corpName}</td>
				##流通介质
				<td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
				<td width="40%">$!{abReceiveBillPage.billFlagName}</td>
			</tr>				
			<tr>
			##持票单位账号
				<td class="textRight">#springMessage('table.abVoucherinfoVice.bankAcc')</td>
				<td width="40%">$!{abReceiveBillPage.bankAcc}</td>
				<td class="textRight">#springMessage('table.abVoucherinfoVice.bankCode')</td>
				<td width="40%">$!{abReceiveBillPage.bankCode}</td>					
            </tr>
			<tr>
				##申请日期/业务办理日期
				<td class="textRight">#springMessage('table.abAccrecords.applyDate')</td>
				<td width="40%">$!{abReceiveBillPage.applyDate}</td>
				##票据类型
				<td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
				<td width="40%">$!{abReceiveBillPage.billTypeName}</td>
            </tr>			
			<tr>
			 <td class="textRight">#springMessage('table.abVoucherinfoVice.enterStock')</td>
             <td width="40%">$!{abReceiveBillPage.enterStockName}</td>
			 <td class="textRight">#springMessage('table.abVoucherinfoVice.billSource')</td>
             <td width="40%">$!{abReceiveBillPage.billSourceName}</td>	
            </tr>		
			<tr>
			<td class="textRight">#springMessage('table.abVoucherinfo.banendrsmtmk')</td>
            <td width="40%">$!{abReceiveBillPage.banendrsmtmkName}</td>
			<td class="textRight"></td>
			<td width="40%"></td>
            </tr>
			<tr>
				##出票日期
				<td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
				<td width="40%">$!{abReceiveBillPage.startDate}</td>
				##票据号码
				<td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
				<td width="40%">$!{abReceiveBillPage.origNo}</td>
            </tr>
        	<tr>
				##到期日期
				<td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
				<td width="40%">$!{abReceiveBillPage.endDate}</td>
        		##前手
				<td class="textRight">#springMessage('bill.accebill.cnAccrecords')</td>
				<td width="40%">$!{abReceiveBillPage.cnAccrecords}</td>
			</tr>							
			<tr>
				##票据金额
                <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                <td width="40%">$!{abReceiveBillPage.billMoney}</td>
				##人民币大写
				<td class="textRight">#springMessage('table.abVoucherinfo.billMoneyUp')</td>
                <td width="40%">		
				</td>
			</tr>
		       </tbody>
			   </table>
			</div>
		</div>
		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('bill.accebill.payer.title')</h2>
			<div class="layui-colla-content layui-show">
			<table class="layui-table">
        	<tbody>
			<tr>
        		##出票人
				<td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
				<td width="40%">$!{abReceiveBillPage.payer}</td>
				##出票人开户银行名称
				<td class="textRight">#springMessage('table.abVoucherinfo.payerBankName')</td>
				<td width="40%">$!{abReceiveBillPage.payerBankName}</td>
			</tr>
            <tr>
				##出票人账号
				<td class="textRight">#springMessage('table.abVoucherinfo.payeracc')</td>
				<td width="40%">$!{abReceiveBillPage.payeracc}</td>
				##出票人开户银行行号
				<td class="textRight">#springMessage('table.abVoucherinfo.payerbankno')</td>
				<td width="40%">$!{abReceiveBillPage.payerbankno}</td>
			 </tr>
			</tbody>
			</table>
			</div>
		</div>	
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.accebill.payee.title')</h2>
		<div class="layui-colla-content layui-show">
			<table class="layui-table">
        	<tbody>	
			<tr>
        		##收票人
				<td class="textRight">#springMessage('table.abVoucherinfo.payee')</td>
                <td width="40%">$!{abReceiveBillPage.payee}</td>
				##收票人开户银行名称
				<td class="textRight">#springMessage('table.abVoucherinfo.payeeBankName')</td>
				<td width="40%">$!{abReceiveBillPage.payeeBankName}</td>
			</tr>
			<tr>
        		##收票人账号
                <td class="textRight">#springMessage('table.abVoucherinfo.payeeacc')</td>
                <td width="40%">$!{abReceiveBillPage.payeeacc}</td>
        		##收票人开户银行行号
				<td class="textRight">#springMessage('table.abVoucherinfo.payeebankno')</td>
				<td width="40%">$!{abReceiveBillPage.payeebankno}</td>
			</tr>
			</tbody>
			</table>
			</div>
		</div>	
		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('bill.accebill.acceptor.title')</h2>
			<div class="layui-colla-content layui-show">
				<table class="layui-table">
        		<tbody>
				<tr>
        		##承兑人
				<td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
				<td width="40%">$!{abReceiveBillPage.acceptor}</td>
				##承兑人开户行名称
				<td class="textRight">#springMessage('table.abVoucherinfo.acceptorBankName')</td>
				<td width="40%">$!{abReceiveBillPage.acceptorBankName}</td>
			</tr>
			<tr>
        		##承兑人账号
				<td class="textRight">#springMessage('table.abVoucherinfo.acceptoracc')</td>
				<td width="40%">$!{abReceiveBillPage.acceptoracc}</td>
        		##承兑人开户行行号
				<td class="textRight">#springMessage('table.abVoucherinfo.acceptorbankno')</td>
				<td width="40%">$!{abReceiveBillPage.acceptorbankno}</td>
			</tr>
			<tr>
        		##承兑合同号/交易合同号
				<td class="textRight">#springMessage('table.abVoucherinfo.aContractNo')</td>
				<td width="40%">$!{abReceiveBillPage.acontractNo}</td>
				##发票号
				<td class="textRight">#springMessage('table.abVoucherinfo.aInvcnb')</td>
				<td width="40%">$!{abReceiveBillPage.ainvcnb}</td>
			</tr>
		       </tbody>
				</table>
			</div>
		</div>	
			<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('bill.accebill.other.title')</h2>
			<div class="layui-colla-content layui-show">
			<table class="layui-table">
        	<tbody>
			<tr>
				##摘要
				<td class="textRight">#springMessage('table.abAccrecords.abs')</td>
				<td width="40%">$!{abReceiveBillPage.abs}</td>
				##备注
				<td class="textRight">#springMessage('table.abAccrecords.rmk')</td>
				<td width="40%">$!{abReceiveBillPage.rmk}</td>
			</tr>
		</tbody>
		</table>
    	</div>
  	</div>
    </div>
	  <br>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
#* 
*6020 票据托收到账
*#
	<div class="layui-colla-item">
	##票据所属单位信息   bill.accebill.abbillcollectionCorpInfo.title
	<h2 class="layui-colla-title">#springMessage('bill.accebill.abbillcollectionCorpInfo.title')</h2>
	<div class="layui-colla-content layui-show">
		<table class="layui-table">
		<tbody>
			##所属单位                   bill.accebill.corpId
            ##所属单位账号           bill.accebill.corpBankAcc
		<tr>
			<td width="20%" class="textRight">#springMessage('bill.accebill.corpId')</td>
			<td width="30%">$!{info.corpName}</td>
			<td width="20%" class="textRight">#springMessage('bill.accebill.corpBankAcc')</td>
			<td width="30%">$!{info.bankAcc}</td>
        </tr>
			##所属单位银行           bill.accebill.corpBankName
            ##所属单位银行行号   bill.accebill.corpBankCode
		<tr>
			<td width="20%" class="textRight">#springMessage('bill.accebill.corpBankName')</td>
			<td width="30%">$!{bankInfo.bankName}</td>
			<td width="20%" class="textRight">#springMessage('bill.accebill.corpBankCode')</td>
			<td width="30%">$!{bankInfo.bankCode}</td>
        </tr>
        </tbody>
        </table>
    </div>
	<h2 class="layui-colla-title">#springMessage('bill.accebill.abbillcollectionaccount.title')</h2>
	<div class="layui-colla-content layui-show">
		<table class="layui-table">
		<tbody>

			##收款人         bisBifRule.payeeName 
			##业务办理日期      table.abAccrecords.businessDate  
		<tr>
			<td width="20%" class="textRight">#springMessage('bisBifRule.payeeName')</td>
			<td width="30%">$!{info.signerok}</td>
			<td width="20%" class="textRight">#springMessage('table.abAccrecords.businessDate')</td>
			<td width="30%">$!date.format('yyyy-MM-dd',$!{info.businessDate})</td>
        </tr>
        </tbody>
        </table>
    </div>
    </div>

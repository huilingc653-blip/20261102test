<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ## 票据单位
                        <td width="8%" class="textRight">公司名称</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-name="corpId"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_corpId"
                                     data-resource="bill:accebill:billbus:query:corpop"
                                     data-scope="all"
                                     id="corpId"
                                >
                                </div>
                            </div>
                        </td>
                        ## 营运区
                        <td class="textRight">#springMessage('bill.accebill.operatingArea')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="hidden" name="operationAreaCode" id="operationAreaCode">
                                <input type="text"  readonly="readonly" autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.operatingArea')" id="operationAreaName" />
                                <div class="bt-div-search">
                                    ## class="bt-biz-inputOperationarea" data-callback="bt.inputOperationAreaCallback"
                                    <button  type="button" title="选择" id="inputOperationareaBtn">
                                        <span class="iconfont byicon_box_search"></span>
                                    </button>
                                </div>
                            </div>
                        </td>
                        ## 股权
                        <td class="textRight">#springMessage('bill.accebill.equity')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-url="${basePath}/sys/equityMaintenance/json" data-biz-name="ins_equityCode"
                                     data-name="ins_equityCode" data-valueField="equityCode" data-textField="equityName"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##所属账户银行类别
                        <td class="textRight">#springMessage('bill.accebill.bankType')</td>
                        <td width="20%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                                     data-method="get"
                                     data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId" data-biz-name="ins_bankTypeId"
                                     data-inputvalue="inputvalue" data-search="true"></div>
                            </div>
                        </td>
                        ##所属账户
                        <td class="textRight">#springMessage('bill.accebill.theBankAcc')</td>
                        <td width="20%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_bankAcc" id="bankAcc"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.theBankAcc')">
                            </div>
                        </td>
                        ##到期日期
                        <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                        <td>
                         <div class="layui-inline">
                            <input type="text" name="ged_endDate" data-biz-name="ged_endDate" data-name="ged_endDate" class="layui-input bt-biz-dateType" value="$!{beginDate}"
                                   data-endid="endDate" data-type="date"/>
                        </div>
                        ~
                        <div class="layui-inline">
                            <input type="text" name="led_endDate" data-biz-name="led_endDate"　data-name="led_endDate" class="layui-input bt-biz-dateType" value="$!{endDate}"
                            id="endDate" data-type="date"/>
                        </div>
                        </td>
                    </tr>
                    <tr>
                        ##保证金比例
                        <td class="textRight">#springMessage('table.abVoucherinfoVice.bailPercent')(%)</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="geg_bailPercent" data-biz-name="geg_bailPercent" autocomplete="off" data-decimal="2" data-min="0" data-max="100"  data-callback="compareBailpercent"
                                       class="layui-input bt-input-inline  bt-biz-rateType" placeholder="#springMessage('table.abVoucherinfoVice.bailPercent')">
                                <span class="date-mid">~</span>
                                <input type="text" name="leg_bailPercent" data-biz-name="leg_bailPercent" autocomplete="off" data-decimal="2" data-min="0" data-max="100" data-callback="compareBailpercent"
                                       class="layui-input bt-input-inline  bt-biz-rateType" placeholder="#springMessage('table.abVoucherinfoVice.bailPercent')">
                            </div>
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
    <tr>
        <td colspan="6" style="text-align: center;">
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button class="layui-btn" type="reset"  data-callback="resetFrom">#springMessage('common.button.reset')</button>
            </div>
        </td>
    </tr>
    </tbody>
    </table>
    </div>
    </div>
    </div>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('bill.accebill.region')</th>
        <th>省区</th>
        <th>#springMessage('bill.accebill.operatingArea')</th>
        <th>公司名称</th>
        <th>#springMessage('bill.accebill.equity')</th>
        <th>#springMessage('bill.accebill.bankTypeName')</th>
        <th>开户行</th>
        <th>#springMessage('table.fcBankBill.bankAcc')</th>
        <th>#springMessage('bill.accebill.billMoney')</th>
        <th>#springMessage('table.fcBond.bondmoney')</th>
        <th>#springMessage('table.abVoucherinfo.endDate')</th>
        <th>#springMessage('bill.accebill.applyRepayMoney')</th>
        <th>结算金额（需还银承）</th>
        <th>#springMessage('table.abVoucherinfoVice.bailPercent')</th>
        <th style="hidden"></th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillBabByMonth.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>

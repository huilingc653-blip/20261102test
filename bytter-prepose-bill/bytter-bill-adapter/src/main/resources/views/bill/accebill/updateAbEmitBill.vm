<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
	#parse("views/common/caData.vm")
	<style>
		.layui-table {
			margin: 0px 0;
		}
	</style>
</head>
<body>
<div class="layui-collapse">
<form class="layui-form" method="post" id="inputForm">
	<input type="hidden" id="acceptorBankType" value="$!{acceptorBankType}"/>

	<!-- 系统参数  -->
	#set($isBillPool=$licenseTag.isModuleAuth("billPool"))
	<input type="hidden" id="isBillPool" value="$!{isBillPool}" />
	<input type="hidden" id="isRelateRat" value="$!{isRelateRat}" />
	<input type="hidden" name="ratIsHangGua" id="ratIsHangGua"  value="$!{urationDTO.ratIsHangGua}">
	<input type="hidden" id="mouthRat" value="$!{mouthRat}" />
	<input type="hidden" id="isBail" value="$!{isBail}" />
	<input type="hidden" id="bailBankControlType" value="$!{bailBankControlType}" />
	<input type="hidden" id="curId" name="curCode" value="$!{curId}" />
	<input type="hidden" id="availMoney" value="$!{availMoney}" />
	<input type="hidden" id="bondId" name="bondId" value="$!{bondId}">
	<input type="hidden" id="isBailModel" name="isBailModel" value="$!{bailmodel}">
	<input type="hidden" id="isEmitMake" value="$!{isEmitMake}" />
	<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
	<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
	<input id="defItemCode" name="defItemCode" type="hidden" value="">
	<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
	<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
	<input id="nisBillheadNoBudget" type="hidden" value="$!{nisBillheadNoBudget}">
	<input type="hidden"  name="VoucherId" id="VoucherId" value="$!{abEmitBillVo.VoucherId}">
	<input type="hidden" id="payeeaccOld" value="$!{abEmitBillVo.payeeacc}">
	<input type="hidden" id="billFlag" value="$!{abEmitBillVo.billFlag}">
	<input type="hidden" id="insideSing" value="$!{abEmitBillVo.insideSing}">
	<input type="hidden" id="billType" value="$!{abEmitBillVo.billType}">
	<input type="hidden" id="isRelateRat" value="$!{isRelateRat}">
	<input type="hidden" name="payeeCorpId" id="payeeCorpIdOld" value="$!{abEmitBillVo.payeeCorpId}">
	<input type="hidden" id="corpIdOld" value="$!{abEmitBillVo.corpId}">
	<input type="hidden" id="applyCorpIdOld" value="$!{abEmitBillVo.applyCorpId}">
	<input type="hidden" id="payeraccOld" value="$!{abEmitBillVo.payeracc}">
	<input type="hidden" id="acceptoraccOld" value="$!{abEmitBillVo.acceptoracc}">
	<input type="hidden" id="source" name="source" value="$!{abEmitBillVo.source}">
	<input type="hidden" id="acceptProvince" name="acceptProvince">
	<input type="hidden" id="acceptCity" name="acceptCity">
	<input type="hidden" id="acceptBankTypeId" name="acceptBankTypeId">
	<input type="hidden" id="isOnline" name="isOnline" value="$!{abEmitBillVo.sendSign}">
	<input type="hidden" id="maxBillMoney" value="$!{maxBillMoney}">
	<input type="hidden" id="isOpenCpRat" value="$!{isOpenCpRat}">
	<input type="hidden" id="isGuarantee" value="$!{isGuarantee}">
	<input type="hidden" id="curOpenCpRat" value="$!{curOpenCpRat}">
	<input type="hidden" id="newBillFlg" value="$!{newBillFlg}">
	<input type="hidden" id="isBatchBill" name="isBatchBill" value="$!{isBatchBill}">
	##<input type="hidden" id="fbsbudgetprocessCorp" value="$!{fbsbudgetprocessCorp}">
		#if($!{isBatchBill} eq '1')
			<div style="text-align:center;border: 0px;font-size: 18px;">
				<input type="hidden" id="batchNo" name="batchNo" value="$!{batchNo}">
				#springMessage('bill.accebill.batchNo'):$!{batchNo}
			</div>
		#else
			<input type="hidden" name="vid" value="$!{abEmitBillVo.vid}">
			<input type="hidden" id="vvid" name="vvid" value="$!{abEmitBillVo.vvid}">
			<input type="hidden" name="aid" value="$!{abEmitBillVo.aid}">
		#end
		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('bill.accebill.billInfo.title')</h2>
			<div class="layui-colla-content layui-show">
				<table class="layui-table">
					<tbody>
					#if($!{isBatchBill} eq '1')
					<tr>
					##开票登记单号
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfoVice.appNo')</td>
						<td  width="35%">
							<input type="hidden" id="appNo" name="appNo" value="$!{appNo}">
							<label id="appNoLabel" class="layui-form-label">$!{appNo}</label>

						</td>
						<td class="textRight" width="15%"></td>
						<td width="35%">
						</td>
					</tr>
					#else
					<tr>
						##开票登记单号
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfoVice.appNo')</td>
						<td  width="35%">
							<input type="hidden" id="appNo" name="appNo" value="$!{abEmitBillVo.appNo}">
							$!{abEmitBillVo.appNo}
						</td>
						##开票数据来源
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.source')</td>
						<td width="35%">
							$!{abEmitBillVo.sourceName}
						</td>
					</tr>
					#end
					<tr>
						##出票标志
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
						<td width="35%">
							<div class="bt-biz-dict" id="newStmIssuofpprInd" value="$!{abEmitBillVo.newStmIssuofpprInd}" data-callback="newStmIssuofpprIndChange" data-biz-name="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-type="select" data-required="true" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-defaultvalue="$!{abEmitBillVo.newStmIssuofpprInd}" data-name="newStmIssuofpprInd"></div>
						</td>
						##是否允许分包
						<td class="textRight drawBillShow">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
						<td class="drawBillShow">
							<div class="bt-biz-dict" data-type="radio" value="$!{abEmitBillVo.blgrdbagcrclPrmtInd}" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND"  data-defaultvalue="$!{abEmitBillVo.blgrdbagcrclPrmtInd}" id="blgrdbagcrclPrmtInd" data-name="blgrdbagcrclPrmtInd" data-biz-name="blgrdbagcrclPrmtInd"></div>
						</td>
					</tr>
					<tr>
					##申请单位
						<td class="textRight" width="15%">#springMessage('bill.accebill.applyCorp')</td>
						<td width="35%">
							#if($!{abEmitBillVo.source} == "10")
								<input name="applyCorpId" id="applyCorpId"  type="hidden" value="$!{abEmitBillVo.applyCorpId}">
								<input name="applyCorpName" id="applyCorpName"  type="hidden" value="$!{abEmitBillVo.applyCorpName}">
								($!{abEmitBillVo.applyCorpCode})$!{abEmitBillVo.applyCorpName}
							#else
								<div class="layui-input-inline" id="applyCorpId">
									<div class="bt-biz-corp"
										 data-biz-type="corp"
										 data-biz-name="applyCorpId"
										 data-type="selectTree"
										 data-name="applyCorpId"
										 data-scope="all"
										 data-required="true"
										 data-resource="bill:accebill:abemitbill:query"
										 data-callbackData="applyCorpCallback"
										 data-defaultvalue="$!{abEmitBillVo.applyCorpId}"
										 placeholder="#springMessage('bill.accebill.applyCorp')">
									</div>
								</div>
							#end
						</td>
						##票据单位
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfoVice.corpId')</td>
						<td width="35%">
							<input id="corpIdDef" type="hidden" value="$!{abEmitBillVo.corpId}">
							#if($!{abEmitBillVo.source} == "10")
                                <div class="layui-input-inline" id="corpId">
                                    <div class="bt-biz-corp"
                                         data-biz-type="corp"
                                         data-biz-name="corpId"
                                         data-type="selectTree"
                                         data-name="corpId"
                                         data-scope="all"
                                         data-required="true"
                                         data-callbackData="corpCallback"
										 data-resource="bill:accebill:abemitbill:query"
                                         ## data-disabled="true"
                                         data-defaultvalue="$!{abEmitBillVo.corpId}"
                                         placeholder="#springMessage('table.abVoucherinfoVice.corpId')">
                                    </div>
                                </div>
							#else
								<div class="layui-input-inline" id="corpId">
									<div class="bt-biz-corp"
										 data-biz-type="corp"
										 data-biz-name="corpId"
										 data-type="selectTree"
										 data-name="corpId"
										 data-scope="all"
										 data-required="true"
										 data-callbackData="corpCallback"
										 data-resource="bill:accebill:abemitbill:query"
										 data-defaultvalue="$!{abEmitBillVo.corpId}"
										 placeholder="#springMessage('table.abVoucherinfoVice.corpId')">
									</div>
								</div>
							#end
						</td>
					</tr>
					<tr>
						##业务单位
						<td class="textRight" width="15%">#springMessage('bill.accebill.busCorp')</td>
						<td width="35%">
							#if($!{abEmitBillVo.source} == "10")
                                <div class="layui-input-inline" id="busCorpId">
                                    <div class="bt-biz-corp"
                                         data-biz-type="corp"
                                         data-biz-name="busCorpId"
                                         data-type="selectTree"
                                         data-name="busCorpId"
                                         data-scope="all"
                                         data-disabled="true"
                                         data-resource="bill:accebill:abemitbill:query"
                                         data-defaultvalue="$!{abEmitBillVo.busCorpId}"
                                         placeholder="#springMessage('bill.accebill.busCorp')">
                                    </div>
                                </div>
							#else
								<div class="layui-input-inline" id="busCorpId">
									<div class="bt-biz-corp"
										 data-biz-type="corp"
										 data-biz-name="busCorpId"
										 data-type="selectTree"
										 data-name="busCorpId"
										 data-scope="all"
										 data-resource="bill:accebill:abemitbill:query"
										 data-defaultvalue="$!{abEmitBillVo.busCorpId}"
										 placeholder="#springMessage('bill.accebill.busCorp')">
									</div>
								</div>
							#end
						</td>
						##业务人员
						<td class="textRight" width="15%">#springMessage('bill.accebill.busPersonnel')</td>
						<td width="35%">
							<div class="layui-input-inline">
								<input type="text" id="busPersonnel" name="busPersonnel" lay-verify="strlength" data-maxlength="200" value="$!{abEmitBillVo.busPersonnel}"
									   autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
							</div>
						</td>
					</tr>
					<tr>
						##不得转让标记/能否转让
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.banendrsmtmk')</td>
						<td width="35%">
							<div class="bt-biz-dict" data-type="select" data-group="AB_BANEM" data-name="banendrsmtmk" data-defaultvalue="$!{abEmitBillVo.banendrsmtmk}" data-placeholder=""></div>
						</td>
						##流通介质
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.billFlag')</td>
						<td width="35%">
							<div class="bt-biz-dict" data-type="radio" data-group="AB_BILL_FLAG" data-defaultvalue="$!{abEmitBillVo.billFlag}" data-name="billFlag" data-biz-name="billFlag" data-required="true"
								#if($!{ismdf} && $!{ismdf.billFlag})
								 data-displayData="$!{abEmitBillVo.billFlag}" data-placeholder=""
								#end></div>
						</td>
					</tr>
					<tr>
					##业务归属日期
						<td class="textRight">#springMessage('table.abAccrecords.businessDate')</td>
						<td >
							<input type="text" name="businessDate" data-name="businessDate" class="layui-input bt-biz-dateType"
								   data-biz-name="businessDate" data-callback="businessDateCallback" data-type="date"
								#if($!{abEmitBillVo.businessDate} && $!{abEmitBillVo.businessDate} ne "") value="$!{abEmitBillVo.businessDate}" #else data-today="true" #end>
						</td>
					##票据类型
						<td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
						<td>
							<div class="bt-biz-dict" data-type="radio" data-group="AB_BILL_TYPE" data-defaultvalue="$!{abEmitBillVo.billType}" data-name="billType" data-biz-name="billType" data-required="true"
								#if($!{ismdf} && $!{ismdf.billType})
								  data-displayData="$!{abEmitBillVo.billType}" data-placeholder=""
								#end></div>
						</td>
					</tr>
					<tr>
					##开票方式
						<td class="textRight">#springMessage('bill.accebill.emitType')</td>
						<td>
							<div class="bt-biz-dict" data-type="select" id="emitType" name="emitType" data-callback="getLimitInfo" data-defaultvalue="$!{abEmitBillVo.emitType}" data-group="ACCEBILL_EMIT_TYPE" data-name="emitType" data-callback="getLimitInfo" data-biz-name="emitType"></div>
						</td>
					##是否开票保贴
						<td class="textRight"><div id="emitGuandisSignText" hidden>#springMessage('bill.accebill.emitGuandisSign')</div></td>
						<td>
							<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-callback="resetBankDiv" id="emitGuandisSign"  data-defaultvalue="$!{abEmitBillVo.emitGuandisSign}" name="emitGuandisSign" data-name="emitGuandisSign" data-biz-name="emitGuandisSign" hidden></div>
						</td>
					</tr>
					<tr id="poolListId" style="display:none">
						<td class="textRight">#springMessage('billPool.limit.poolMoney')</td>
						<td id="poolLimitMoney"></td>
						<td class="textRight">
							#springMessage('billPool.limit.validMoney')
							<input type="hidden" id="poolLimitValidMoneyVal" value="false"/>
						</td>
						<td id="poolLimitValidMoney"></td>
					</tr>
					<tr>
					##出票日期
						<td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
						<td >
							<input type="text" name="startDate" data-name="startDate" class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date"
								   data-biz-name="startDate" data-callback="checkDate" value="$!{abEmitBillVo.startDate}" placeholder="$!{abEmitBillVo.startDate}"
								   lay-verify="required" >
						</td>
					##开出方式
						<td class="textRight">#springMessage('table.abVoucherinfoVo.openWay')</td>
						<td>
							<div class="bt-biz-dict" data-type="radio" data-group="AB_BILL_OPENWAY" data-defaultvalue="$!{abEmitBillVo.insideSing}" data-name="insideSing"
								 data-biz-name="insideSing" data-required="true" value="$!{abEmitBillVo.businessDate}">
							</div>
						</td>
					</tr>
					<tr>
					##到期日期
						<td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
						<td >
							<div class="layui-inline">
							<input type="text" name="endDate" data-name="endDate" class="layui-input bt-biz-dateType" id="endDate" data-type="date"
								   data-biz-name="endDate" data-callback="checkDate" value="$!{abEmitBillVo.endDate}" placeholder="$!{abEmitBillVo.endDate}"
								   lay-verify="required" >
							</div>
							<div class="layui-inline">
								#if($!{billSectionThreeButton} == 1)
									<button class="layui-btn" type="button" onClick="changeEndDate(3)">#springMessage(
                                    'table.abVoucherinfo.endDate.threeMonth')</button>
								#end
								#if($!{billSectionSixButton} == 1)
									<button class="layui-btn" type="button" onClick="changeEndDate(6)">#springMessage(
                                    'table.abVoucherinfo.endDate.sixMonth')</button>
								#end
							</div>
						</td>
					##票据（包）号码
						<td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
						<td>
							<input type="text" id="origNo" name="origNo" lay-verify="strlength" data-maxlength="40"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')" value="$!{abEmitBillVo.origNo}">
						</td>
					</tr>
					<tr>
					##票据金额
						<td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
						<td>
							<input type="text" data-name="billMoney" class="layui-input bt-biz-moneyType" data-toup="moneyUp" lay-verify="required" data-min="0.01"
								#if($!{abEmitBillVo.source} == '10') readonly="readonly" #end	data-callback="getBail"
								   placeholder="#springMessage('table.abVoucherinfo.billMoney')" data-biz-name="test" id="billMoney" value="$!{abEmitBillVo.billMoney}">
						</td>
					##人民币大写
						<td class="textRight">#springMessage('table.abVoucherinfo.billMoneyUp')</td>
						<td>
							<div class="layui-input-inline layui-input" id="moneyUp"></div>
						</td>
					</tr>
					<tr style="display: none">
						##是否保证
						<td class="textRight">#springMessage('bill.accebill.isEnsure')</td>
						<td>
							<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0"
								 data-name="isEnsure" data-biz-name="isEnsure" ></div>
						</td>
						<td></td>
						<td></td>
					</tr>
					</tbody>
				</table>
			</div>
		</div>

		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('bill.accebill.payer.title')</h2>
			<div class="layui-colla-content layui-show">
				<table class="layui-table">
					<tbody>
					<tr>
					##出票人账号
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payeracc')</td>
						<td width="35%">
							<div class="layui-input-inline">
								<input type="text" id="payeracc" name="payeracc" data-name="payeracc" data-biz-name="payeracc"
									#if($!{externalCorpNum} eq '1' ) readonly="readonly" #end
									   data-resource="bill:accebill:abemitbill:query" lay-verify="required"
									   data-defaultcorp = "$!{abEmitBillVo.corpId}" value="$!{abEmitBillVo.payeracc}"
									   class="bank layui-input bt-biz-accountTable" data-callback="accountPayeeCallBack" />
							</div>
						</td>
					##出票人
						<td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payer')</td>
						<td width="35%">
							<input type="text" id="payer" name="payer" value="$!{abEmitBillVo.payer}" lay-verify="strlength|required" data-maxlength="240" readonly="readonly"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payer')">
						</td>
					</tr>
					<tr>
					##出票人开户银行名称
						<td class="textRight">#springMessage('table.abVoucherinfo.payerBankName')</td>
						<td >
							<input type="text" id="payerBankName" name="payerBankName" value="$!{abEmitBillVo.payerBankName}" lay-verify="required|strlength" data-maxlength="240"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payerBankName')"
								#if($!{abEmitBillVo.billFlag} == "11" && $!{abEmitBillVo.isBillTypeTP}=="0") readonly="readonly" #end >
						</td>
					##出票人开户银行行号
						<td class="textRight">#springMessage('table.abVoucherinfo.payerbankno')</td>
						<td >
							<input type="text" id="payerbankno" name="payerbankno" value="$!{abEmitBillVo.payerbankno}" lay-verify="required|strlength" data-maxlength="30"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payerbankno')"
								#if($!{abEmitBillVo.billFlag} == "11" && $!{abEmitBillVo.isBillTypeTP}=="0") readonly="readonly" #end >
						</td>
					</tr>
					<tr>
						##出票人统一信用代码
						<td class="textRight" class="textRight drawBillShow">#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')</td>
						<td>
							<input type="text" id="blRmtrUnnIdNo" value="$!{abEmitBillVo.blRmtrUnnIdNo}" name="blRmtrUnnIdNo" autocomplete="off" class="layui-input"
								   readonly="true" placeholder="#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')">
						</td>
						##
						<td class="textRight"></td>
						<td >
						</td>
					</tr>
					</tbody>
				</table>
			</div>
		</div>

		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('bill.accebill.payee.title')</h2>
			<div class="layui-colla-content layui-show">
				<table class="layui-table">
					<tbody>
					<tr id="corpPayee">
					##收票人单位
						<td class="textRight" width="15%">
							<div class="layui-input-inline" id="payeeSpanDiv" style="display:none">
								<span style="color:red;font-size: 14px;font-weight:bold;vertical-align: middle;">*</span>
							</div>
							#springMessage('table.abBillTransfer.recevieCorpId')</td>
						<td width="35%">
						##收票人全称--成员单位
							<div class="layui-input-inline">
								<div class="bt-biz-corp"
									 data-biz-type="corp"
									 data-biz-name="payeeCorpId"
									 data-type="selectTree"
									 data-name="payee1"
									 data-scope="all"
									 data-defaultvalue="$!{abEmitBillVo.payeeCorpId}"
								##data-resource="bill:accebill:abemitbill:query"
									 data-callbackData="payeeCorpCallback"
									 placeholder="#springMessage('table.abVoucherinfo.payee')">
								</div>
							</div>
						</td>
						<td width="15%"></td>
						<td width="35%"></td>
					</tr>
						#if($!{abEmitBillVo.source} == '10')

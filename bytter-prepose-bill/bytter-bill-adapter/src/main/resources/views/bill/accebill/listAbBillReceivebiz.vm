<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
    <style type="text/css">
        .col-error{
            color: red;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input id="isBudgetPlan" name="isBudgetPlan" type="hidden" value="$!{isBudgetPlan}">
    <input id="curId" name="curId" type="hidden" value="$!{curId}">
    <input id="signItem" name="signItem" type="hidden" value="$!{signItem}">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.corpId')</td>
                        <td width="25%">
                            <div class="layui-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_recCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:abBillReceivebiz:merch:query,bill:accebill:abBillReceivebiz:bank:query,bill:accebill:abBillReceivebiz:other:query"
                                >
                                </div>
                            </div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.bussdt')</td>
                        <td width="25%">
                            <div class="layui-inline">
                                <div id="bussdt"></div>
                            </div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.business.reqNm')</td>
                        <td width="25%">
                            <input type="text" name="likes_reqNm"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('bill.accebill.business.reqNm')">
                        </td>
                    </tr>
                    <tr>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.origNo')</td>
                        <td width="25%">
                            <input type="text" name="likes_origNo"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('bill.accebill.origNo')">
                        </td>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.billMoney')</td>
                        <td width="25%">
                            <div class="layui-inline">
                                <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text"
                                       data-name="geg_billMoney" data-moneyendid="leg_billMoney"/>
                                <span class="date-mid">~</span>
                                <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_billMoney"
                                       type="text" data-name="leg_billMoney"/>
                            </div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.business.recNm')</td>
                        <td width="25%">
                            <input type="text" name="likes_recNm"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('bill.accebill.business.recNm')">
                        </td>
                    </tr>
                    <tr>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.billType')</td>
                        <td width="25%">
                            <div class="bt-biz-dict" data-group="AB_BILL_TYPE" data-name="ins_billTypeName"
                                 data-biz-name = "billType" data-type="mulselect"
                                #if($shiro.hasPermission("bill:accebill:abBillReceivebiz:other:query"))
                                    #set($billTypeFilter = "")
                                    #if($shiro.lacksPermission("bill:accebill:abBillReceivebiz:merch:query"))
                                        #set($billTypeFilter = "11")
                                    #end
                                    #if($shiro.lacksPermission("bill:accebill:abBillReceivebiz:bank:query"))
                                        #set($billTypeFilter = $billTypeFilter+",10")
                                    #end
                                 data-filterData="$!{billTypeFilter}"
                                #else
                                    #set($billTypeDisplay = "")
                                    #if($shiro.hasPermission("bill:accebill:abBillReceivebiz:merch:query"))
                                        #set($billTypeDisplay = "11")
                                    #end
                                    #if($shiro.hasPermission("bill:accebill:abBillReceivebiz:bank:query"))
                                        #set($billTypeDisplay = $billTypeDisplay+",10")
                                    #end
                                 data-displayData="$!{billTypeDisplay}"
                                #end
                            ></div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                        <td width="25%">
                            <div class="layui-inline">
                                <div id="startDate"></div>
                            </div>
                        </td>
                        <td width="8%" class="textRight" class="textRight">#springMessage(
                            'bill.accebill.business.recAcctId')</td>
                        <td width="25%">
                            <input type="text" name="likes_recAcctId"
                                   autocomplete="off" class="bank layui-input"
                                   placeholder="#springMessage('bill.accebill.business.recAcctId')">
                        </td>
                    </tr>
                    <tr>
                        ##签收类型
                        <td width="8%" class="textRight">#springMessage('bill.accebill.signerType')</td>
                        <td width="25%">
                            <div class="bt-biz-dict" data-group="AB_BILL_SIGNERTYPE" data-name="ins_signerType" data-biz-name = "signType"
                                 data-type="mulselect"></div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                        <td width="25%">
                            <div class="layui-inline">
                                <div id="endDate"></div>
                            </div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('table.ab.recipient.account.type.of.bank')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                                     data-method="get"
                                     data-valuefield="typeName" data-textfield="typeName" data-name="ins_recBankTypeId"
                                     data-inputvalue="inputvalue" data-search="true"></div>
                            </div>
                        </td>

                    </tr>
                    <tr>
                        <td width="8%" class="textRight">#springMessage('table.abAccrecords.status')</td>
                        <td width="25%">
                            <div class="bt-biz-dict" data-group="AB_BILL_RECEIVEBIZ_STATUS" data-name="eqs_statusName"
                                 data-type="select"></div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.banendrsmtmk')</td>
                        <td width="25%">
                            <div class="bt-biz-dict" data-group="AB_BANEM" data-name="eqs_bankendrsmtmk"
                                 data-type="select"></div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('bill.accebill.billpayerpayeetype')</td>
                        <td width="25%">
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="select" data-name="type"
                                     data-group="BILL_PAYERPAYEE_TYPE"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##	出票行
                        <td width="8%" class="textRight">#springMessage('bill.accebill.payerNo')</td>
                        <td width="25%">
                            <input type="text" name="likes_payerbankName"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('bill.accebill.payerNo')">
                        </td>
                        ##承兑行
                        <td width="8%" class="textRight">#springMessage('bill.accebill.acceptorbank')</td>
                        <td width="25%">
                            <input type="text" name="likes_acceptorbankName"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('bill.accebill.acceptorbank')">
                        </td>
                        ##出票标志
                        <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##票据是否允许分包
                        <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND" data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
                            </div>
                        </td>
                        ##收票人
                        <td class="textRight">#springMessage('table.abVoucherinfo.payee')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_payee"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.payee')">
                            </div>
                        </td>
                        ##票据账号
                        <td class="textRight" width="8%">#springMessage('table.abVoucherinfo.billBankAcc')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" id="recAcctId2" name="recAcctId2" data-name="recAcctId2"
                                       data-resource="bill:accebill:abemitbill:query"
                                       data-biz-name="recAcctId2" circulationMode="1" class="bank layui-input bt-biz-accountTable" data-callback="clickCallback"  lay-verify="strlength" data-maxlength="30"/>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            #if($shiro.hasPermission(
                                "bill:accebill:abBillReceivebiz:merch:query")||$shiro.hasPermission(
                                "bill:accebill:abBillReceivebiz:bank:query")||$shiro.hasPermission(
                                "bill:accebill:abBillReceivebiz:other:query"))
                                <div class="layui-inline">
                                    <button class="layui-btn" lay-submit lay-filter="search"
                                            type="button">#springMessage('common.button.search')</button>
                                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                        'common.button.reset')</button>
                                    <button class="layui-btn button" type="button" onclick="sendCommand()">#springMessage('table.abVoucherinfo.sendCommand')</button>
                                </div>
                            #end
                        </td>
                    </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</form>

    #if($shiro.hasPermission("bill:accebill:abBillReceivebiz:merch:query")||$shiro.hasPermission(
        "bill:accebill:abBillReceivebiz:bank:query")||$shiro.hasPermission(
        "bill:accebill:abBillReceivebiz:other:query"))
    <table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
        <thead>
        <tr>
            <th>#springMessage('bill.accebill.applyCorp')</th>
            <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
            <th>#springMessage('bill.accebill.busCorp')</th>
            <th>#springMessage('bill.accebill.busPersonnel')</th>
            <th>#springMessage('bill.accebill.billType')</th>
            <th>#springMessage('bill.accebill.signerType')</th>
            <th>#springMessage('bill.accebill.origNo')</th>
            <th>#springMessage('table.abVoucherinfo.banendrsmtmk')</th>
            <th>#springMessage('bill.accebill.endorsementTransfers')</th>
            <th>#springMessage('bill.accebill.bussdt')</th>
            <th>#springMessage('bill.accebill.billMoney')</th>
            <th>#springMessage('table.abVoucherinfo.payer')</th>
            <th>#springMessage('table.abVoucherinfo.payee')</th>
            <th>#springMessage('table.abVoucherinfo.acceptor')</th>
            <th>#springMessage('table.abAccrecords.cnAccrecords')</th>
            <th>#springMessage('table.abVoucherinfo.startDate')</th>
            <th>#springMessage('table.abVoucherinfo.endDate')</th>
            <th>#springMessage('bill.accebill.payerNo')</th>
            <th>#springMessage('bill.accebill.acceptorbank')</th>
            <th>#springMessage('bill.accebill.business.reqNm')</th>
            <th>#springMessage('bill.accebill.business.recNm')</th>
            <th>#springMessage('bill.accebill.business.recAcctId')</th>
            <th>#springMessage('table.ab.recipient.account.type.of.bank')</th>
            <th>#springMessage('table.abBackbillinfo.sttlmmk')</th>
            <th>#springMessage('table.abAccrecords.status')</th>
            <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
            <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
            <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>
            <th>#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    <form class="layui-form" id="dataForm">
        <table class="layui-table">
            <tbody>
            <tr>
                <td width="8%" class="textRight">
                    <label> #springMessage('bill.accebill.dshnr')</label>
                </td>
                <td width="25%">
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-group="AB_BILL_DSHNRCD" data-id="dshnrcd" data-name="dshnrcd"
                             data-type="select"></div>
                    </div>
                </td>

                <td width="8%" class="textRight">
                    <label> 新一代票据#springMessage('bill.accebill.dshnr')</label>
                </td>
                <td width="25%">
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-group="AB_BILL_NEW_DSHNRCD" data-id="newDshnrcd" data-name="newDshnrcd"
                             data-type="select"></div>
                    </div>
                </td>

                <td class="textRight" width="8%">
                    <label> #springMessage('bill.accebill.dshnrrsn')</label>
                </td>
                <td>
                    <div class="layui-inline">
                        <input type="text" id="dshnrrsn" autocomplete="off" class="layui-input" lay-verify="strlength"
                               data-maxlength="100" placeholder="#springMessage('bill.accebill.dshnrrsn')">
                    </div>
                    <span style="color:red">
                                (#springMessage('bill.accebill.dshnrInfo'))
                            </span>
                </td>
            </tr>
            </tbody>
        </table>
        <br>
        <!-- 资金计划 -->
        <div class="layui-colla-item ignore-required-hide" id="budgetDiv" style="display:none">
            <h2 class="layui-colla-title">#springMessage('table.fbsbudgetprocess.title')</h2>
            <div class="layui-colla-content layui-show">
                <!-- 资金计划 -->
                <div id="tagItemDetail"></div>
            </div>
        </div>
    </form>
    #end

    #parse("views/common/footer.vm")
    #caDataHidden()
    #caDataScript()
</body>
<script src="${basePath}/static/modules/sys/blackWhite/blackWhiteBase.check.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abBillReceivebiz.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>
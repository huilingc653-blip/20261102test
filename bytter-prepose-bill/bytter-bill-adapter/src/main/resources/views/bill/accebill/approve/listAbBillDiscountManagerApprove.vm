<!DOCTYPE html>
<html lang="en">
<input type="hidden" id="caType"  value="10"/>
<head>
     #parse("views/common/head.vm")
     #parse("views/common/caData.vm")
     #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
		<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
        <table class="layui-table">
            <tbody>
            <tr>
                ##入库库存
                <td class="textRight">#springMessage('table.abVoucherinfoVice.enterStock')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="select" data-group="AB_ENTER_STOCK" data-defaultvalue="$!{abReceiveBillPage.enterStock}" data-name="eqs_enterStock"></div>
                    </div>
                </td>
                ## 申请单位
                <td class="textRight">#springMessage('bill.accebill.applyCorp')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-tree-type="check"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-name="ins_applyCorpId"
                             data-scope="all"
                             data-resource="sys:flow:query:corpop"
                             data-callback="applyCorpCallback"
                        >
                        </div>
                    </div>
                </td>
                ## 票据单位
                <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                <td width="24%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-biz-name="corpId"
                             data-tree-type="check"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-name="ins_corpId"
                             data-resource="sys:flow:query:corpop"
                             data-scope="all"
                        >
                        </div>
                    </div>
                </td>
            </tr>
                <tr>
                    ##票据类型
                    <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE" data-defaultvalue="$!{abReceiveBillPage.billType}" data-name="eqi_billType"></div>
                        </div>
                    </td>
                    ## 业务单位
                    <td class="textRight" >#springMessage('bill.accebill.busCorp')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_busCorpId"
                                 data-scope="all"
                                 data-resource="sys:flow:query:corpop"
                            >
                            </div>
                        </div>
                    </td>
                    ##业务人员
                    <td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_busPersonnel"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
                        </div>
                    </td>
				</tr>			
				<tr>
					##票据号码
                    <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_origNo" autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
                        </div>
                    </td>
                    ##子票区间号码
                    <td class="textRight">#springMessage('bill.accebill.sti')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" name="likes_sbbllRngStrtSn"
                                   autocomplete="off" class="layui-input" maxlength="12"
                                   placeholder="#springMessage('table.abVoucherinfo.sbbllRngStrtSn')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" name="likes_sbbllRngEndSn"
                                   autocomplete="off" class="layui-input" maxlength="12"
                                   placeholder="#springMessage('table.abVoucherinfo.sbbllRngEndSn')">
                        </div>
                    </td>
                    ##票据金额
                    <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="geg_billMoney" class="layui-input bt-input-inline  bt-biz-moneyType" data-moneyendid="endMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                            <span class="date-mid">~</span>
                            <input type="text" name="leg_billMoney" class="layui-input bt-input-inline  bt-biz-moneyType" id="endMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                        </div>
                    </td>
				</tr>
                <tr>
                    ##出票人
                    <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_payer" autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payer')">
                        </div>
                    </td>
                    ##出票日期
                    <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="ged_startDate" class="layui-input bt-input-inline  bt-biz-dateType" data-endid="startDate" placeholder="#springMessage('table.abVoucherinfo.startDate')">
                            <span class="date-mid">~</span>
                            <input type="text" name="led_startDate" class="layui-input bt-input-inline  bt-biz-dateType" id="startDate" placeholder="#springMessage('table.abVoucherinfo.startDate')">
                        </div>
                    </td>
					##到期日期
                    <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                    <td width="24%">
				     <div class="layui-input-inline">
                     <input type="text" name="ged_endDate" class="layui-input bt-input-inline  bt-biz-dateType" data-endid="endDate" placeholder="#springMessage('table.abVoucherinfo.endDate')">
                     <span class="date-mid">~</span>
                     <input type="text" name="led_endDate" class="layui-input bt-input-inline  bt-biz-dateType" id="endDate" placeholder="#springMessage('table.abVoucherinfo.endDate')">
                     </div>
					 </td>
                </tr>
				<tr>
                    ##承兑人
                    <td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_acceptor" autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptor')">
                        </div>
                    </td>
                    ##流通介质
                    <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_FLAG"  data-name="eqi_billFlag" data-biz-name="billFlag" id="billFlag" searchType="electric"></div>
                        </div>
                    </td>

					<td colspan="2"></td>
				</tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" onclick="isSetAoaccninf()" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
            </tbody>
        </table>
   </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('table.abVoucherinfo.billType')</th>
		<th>#springMessage('table.abVoucherinfo.billFlag')</th>
        <th>#springMessage('bill.accebill.applyCorp')</th>
        <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
        <th>#springMessage('bill.accebill.busCorp')</th>
        <th>#springMessage('bill.accebill.busPersonnel')</th>
		<th>#springMessage('table.abVoucherinfo.payer')</th>
		<th>#springMessage('table.abVoucherinfo.acceptor')</th>
        <th>#springMessage('table.abVoucherinfo.origNo')</th>
		<th>#springMessage('table.abVoucherinfo.billMoney')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
		<th>#springMessage('table.abVoucherinfo.startDate')</th>
		<th>#springMessage('table.abVoucherinfo.endDate')</th>
		<th>#springMessage('bill.accebill.abBillDiscountApply.discountRecNm')</th>
		<th>#springMessage('table.abDiscount.paydate')</th>
		<th>#springMessage('table.abDiscount.deferdate')</th>
		<th>#springMessage('table.abDiscount.daynum')</th>
		<th>#springMessage('table.abDiscount.interest')</th>
		<th>#springMessage('table.abDiscount.buyerinterestMoney')</th>
		<th>#springMessage('table.abDiscount.realMoney')</th>
		<th>#springMessage('table.abAccrecords.banendrsmtmk')</th>
		<th>#springMessage('table.abDiscount.invcNb')</th>
		<th>#springMessage('table.abDiscount.txlCtrctNb')</th>
		<th>#springMessage('table.abAccrecords.briefId')</th>
		<th>#springMessage('table.abVoucherinfoVice.enterStock')</th>
		<th>#springMessage('table.abAccrecords.rmk')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#workFlowHtml()
#parse("views/common/footer.vm")
#caDataHidden()
#caDataScript()
#workFlowScript()
</body>
<script src="${basePath}/static/modules/bill/accebill/approve/abBillDiscountManagerApprove.list.js?_btv=${resourceVersion}"></script>
</html>

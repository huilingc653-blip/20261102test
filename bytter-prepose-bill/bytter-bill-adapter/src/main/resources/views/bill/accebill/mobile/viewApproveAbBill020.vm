#* 
*020 托收申请
*#
	<li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.abbillcollectionCorpInfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
				##所属单位
				#springMessage('bill.accebill.corpId')
                <span class="mui-badge mui-badge-inverted">
					$!{info.corpName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##所属单位账号
				#springMessage('bill.accebill.corpBankAcc')
                <span class="mui-badge mui-badge-inverted">
					$!{info.bankAcc}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##所属单位银行
				#springMessage('bill.accebill.corpBankName')
                <span class="mui-badge mui-badge-inverted">
					$!{bankInfo.bankName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##所属单位银行行号
				#springMessage('bill.accebill.corpBankCode')
                <span class="mui-badge mui-badge-inverted">
					$!{bankInfo.bankCode}
    			</span>
            </li>
        </ul>
    </li>
	##托收申请信息
	<li class="mui-table-view-cell mui-collapse mui-active">
		<a class="mui-navigate-right" href="#">#springMessage('bill.accebill.abbillcollectionapply.title')</a>
		<ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
				##是否逾期
				#springMessage('accebill.abbillcollectionapply.isOverdue')
                <span class="mui-badge mui-badge-inverted">
					$!{info.isOverdueName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##逾期原因
				#springMessage('bill.accebill.abbillcollectionapply.isOverdueRmk')
                <span class="mui-badge mui-badge-inverted">
					$!{info.rsn}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##清算方式
				#springMessage('table.abDiscount.sttlmmk')
                <span class="mui-badge mui-badge-inverted">
					$!{info.sttlmmkName}
    			</span>
            </li>
            <li class="mui-table-view-cell">
				##业务办理日期
				#springMessage('table.abAccrecords.businessDate')
                <span class="mui-badge mui-badge-inverted">
					$!date.format('yyyy-MM-dd',$!{info.businessDate})
    			</span>
            </li>
            <li class="mui-table-view-cell">
			##备注
				#springMessage('bill.accebill.abbillcollectionapply.rmk')
                <span class="mui-badge mui-badge-inverted">
					$!{info.rmk}
    			</span>
            </li>
		</ul>
    </li>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body {
            font-size: 14px;
            padding-bottom: 60px;
        }

        .layui-form-label {
            width: 180px;
        }

        .layui-input-block {
            margin-left: 220px;
        }
    </style>
</head>
<body>
    ##兑付申请线上兑付收款人
<input type="hidden" id="isCashingOnlinePayeeInfo" value="$!{config.accebill.isCashingOnlinePayee}">

<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <!-- 面板标题 -->
            <h2 class="layui-colla-title">#springMessage('config.accebill.title.usually')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ##开票是否补录
                        <td width="20%" class="textRight">#springMessage('config.accebill.isEmitMake')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict"
                                     data-type="radio"
                                     data-defaultvalue="$!{config.accebill.isEmitMake}"
                                     data-name="accebill.isEmitMake"
                                     data-biz-name="isEmitMake"
                                     data-group="sf_yn"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##承兑汇票纸票最大额度
                        <td class="textRight">#springMessage('config.accebill.billFlag10.maxBillMoney')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" id="maxBillMoney" name="accebill.maxBillMoney"
                                       style="text-align:right" lay-verify="required|number2"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" data-max="1000000000"
                                       value="$!{config.accebill.maxBillMoney}">
                            </div>
                            <div class="layui-input-inline">
                                <i id="maxBillMoney-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##是否允许重复背书
                        <td width="20%" class="textRight">#springMessage('config.accebill.isRepeatEndorse')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict"
                                     data-type="radio"
                                     data-defaultvalue="$!{config.accebill.isRepeatEndorse}"
                                     data-name="accebill.isRepeatEndorse"
                                     data-biz-name="isRepeatEndorse"
                                     data-group="BILL_REPEATENDORSE">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##是否支持同名跨行背书
                        <td width="20%" class="textRight">#springMessage('config.accebill.isCounterpartEndorse')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict"
                                     data-type="radio"
                                     data-defaultvalue="$!{config.accebill.isCounterpartEndorse}"
                                     data-name="accebill.isCounterpartEndorse"
                                     data-biz-name="isCounterpartEndorse"
                                     data-callback="isCounterpartEndorseFun"
                                     data-group="sf_yn"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##电票清算方式
                        <td width="20%" class="textRight">#springMessage('config.accebill.isEOnlinePay')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                #*<input type="radio" name="accebill.isEOnlinePay" value="1"
                                       #if($config.accebill.isEOnlinePay eq 1)checked#end
                                       title="#springMessage('common.sc_yn.yes')">
                                <input type="radio" name="accebill.isEOnlinePay" value="0"
                                       #if($config.accebill.isEOnlinePay ne 1)checked#end
                                       title="#springMessage('common.sc_yn.no')">*#
                                <div class="bt-biz-dict"
                                     data-type="radio"
                                     data-defaultvalue="$!{config.accebill.isEOnlinePay}"
                                     data-name="accebill.isEOnlinePay"
                                     data-biz-name="isEOnlinePay"
                                     data-group="AB_BILL_SEND_SIGN"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 电票指令发送模式
                        <td width="20%" class="textRight">#springMessage('config.accebill.isEAutoInstruct')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict"
                                     data-type="radio"
                                     data-defaultvalue="$!{config.accebill.isEAutoInstruct}"
                                     data-name="accebill.isEAutoInstruct"
                                     data-biz-name="isEAutoInstruct"
                                     data-group="bisExc.cmdType"></div>
                                #if($config.accebill.isEAutoInstruct ne 1)
                                    #set($overDayNumclass ="layui-disabled")
                                #end
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##票据背面信息显示顺序
                        <td width="20%" class="textRight">#springMessage('config.accebill.billBackDesc')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="accebill.billBackDesc" value="0"
                                       #if($config.accebill.billBackDesc ne 1)checked#end
                                       title="#springMessage('config.accebill.billBackDesc.asc')">
                                <input type="radio" name="accebill.billBackDesc" value="1"
                                       #if($config.accebill.billBackDesc eq 1)checked#end
                                       title="#springMessage('config.accebill.billBackDesc.desc')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##是否贴现到账确认
                        <td width="20%" class="textRight">#springMessage('config.accebill.isDiscountConfirm')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="accebill.isDiscountConfirm" value="1"
                                       #if($config.accebill.isDiscountConfirm ne 0)checked#end
                                       title="#springMessage('common.sc_yn.yes')">
                                <input type="radio" name="accebill.isDiscountConfirm" value="0"
                                       #if($config.accebill.isDiscountConfirm eq 0)checked#end
                                       title="#springMessage('common.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##是否托收到账确认
                        <td width="20%" class="textRight">#springMessage(
                            'config.accebill.isCollectionApplyConfirm')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="accebill.isCollectionApplyConfirm" value="1"
                                       #if($config.accebill.isCollectionApplyConfirm ne 0)checked#end
                                       title="#springMessage('common.sc_yn.yes')">
                                <input type="radio" name="accebill.isCollectionApplyConfirm" value="0"
                                       #if($config.accebill.isCollectionApplyConfirm eq 0)checked#end
                                       title="#springMessage('common.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##不启用贴现申请功能直接贴现办理
                        <td width="20%" class="textRight">#springMessage(
                            'config.accebill.isNotDiscountApplyConfirm')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="accebill.isNotDiscountApply" value="1"
                                       #if($config.accebill.isNotDiscountApply ne 0)checked#end
                                       title="#springMessage('common.sc_yn.yes')">
                                <input type="radio" name="accebill.isNotDiscountApply" value="0"
                                       #if($config.accebill.isNotDiscountApply eq 0)checked#end
                                       title="#springMessage('common.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##是否按票据账户控制
                        <td width="20%" class="textRight">#springMessage('config.accebill.isElectricBill')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="accebill.isElectricBill" value="1"
                                       #if($config.accebill.isElectricBill ne 0)checked#end
                                       title="#springMessage('common.sc_yn.yes')">
                                <input type="radio" name="accebill.isElectricBill" value="0"
                                       #if($config.accebill.isElectricBill eq 0)checked#end
                                       title="#springMessage('common.sc_yn.no')">
                            </div>
                            <div class="layui-input-inline">
                                <i id="isElectricBill-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##兑付申请线上兑付收款人
                        <td width="20%" class="textRight">#springMessage('config.accebill.isCashingOnlinePayee')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="checkbox" name="isCashingOnlinePayee1" id="isCashingOnlinePayee1" value="1"
                                       #if($config.accebill.isCashingOnlinePayee.indexOf("1") > -1)checked#end
                                       lay-skin="primary"
                                       title="#springMessage('config.accebill.cashingOnlinePayee.bankToAcc')">
                                <input type="checkbox" name="isCashingOnlinePayee2" id="isCashingOnlinePayee2" value="2"
                                       lay-skin="primary"
                                       #if($config.accebill.isCashingOnlinePayee.indexOf("2") > -1)checked#end
                                       title="#springMessage('config.accebill.cashingOnlinePayee.businessToAcc')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 电票自动提示承兑
                        <td width="20%" class="textRight">#springMessage('config.accebill.isEAutoAccept')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="accebill.isEAutoAccept" value="1"
                                       #if($config.accebill.isEAutoAccept eq 1)checked#end
                                       title="#springMessage('common.sc_yn.yes')">
                                <input type="radio" name="accebill.isEAutoAccept" value="0"
                                       #if($config.accebill.isEAutoAccept ne 1)checked#end
                                       title="#springMessage('common.sc_yn.no')">
                            </div>
                            <div class="layui-input-inline">
                                <i id="isEAutoAccept-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 电票自动提示收票
                        <td width="20%" class="textRight">#springMessage('config.accebill.isEAutoInvoice')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="accebill.isEAutoInvoice" value="1"
                                       #if($config.accebill.isEAutoInvoice eq 1)checked#end
                                       title="#springMessage('common.sc_yn.yes')">
                                <input type="radio" name="accebill.isEAutoInvoice" value="0"
                                       #if($config.accebill.isEAutoInvoice ne 1)checked#end
                                       title="#springMessage('common.sc_yn.no')">
                            </div>
                            <div class="layui-input-inline">
                                <i id="isEAutoInvoice-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 电票自动提示付款
                        <td width="20%" class="textRight">#springMessage('config.accebill.isEAutoPay')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict"
                                     data-type="radio"
                                     data-defaultvalue="$!{config.accebill.isEAutoPay}"
                                     data-callback="isEAutoPayFun"
                                     data-name="accebill.isEAutoPay"
                                     data-biz-name="isEAutoPay"
                                     data-group="sf_yn"></div>
                                #if($config.accebill.isEAutoPay ne 1)
                                    #set($PayDayNumclass =" layui-disabled")
                                #end
                            </div>
                            <div class="layui-input-inline">
                                <i id="isEAutoPay-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr id="sttlmmkTr">
                        ##自动提示付款清算方式(银票)
                        <td width="20%" class="textRight">#springMessage('table.auto.abDiscount.bank.sttlmmk')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_STTLMMK"
                                     data-name="accebill.isEAutoPaySttlmmk"
                                     data-defaultvalue="$!{config.accebill.isEAutoPaySttlmmk}"
                                     data-placeholder=""></div>
                            </div>
                            <div class="layui-input-inline">
                                <i id="bankSttlmmk-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr id="sttlmmkMerchTr">
                        ##自动提示付款清算方式(商票)
                        <td width="20%" class="textRight">#springMessage('table.auto.abDiscount.merch.sttlmmk')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_STTLMMK"
                                     data-name="accebill.isEAutoPaySttlmmkMerch"
                                     data-defaultvalue="$!{config.accebill.isEAutoPaySttlmmkMerch}"
                                     data-placeholder=""></div>
                            </div>
                            <div class="layui-input-inline">
                                <i id="merchSttlmmk-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##电票提示付款结果查询跳过节假日
                        <td width="20%" class="textRight">#springMessage('config.accebill.isPaySkipHoliday')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="accebill.isPaySkipHoliday" value="1"
                                       #if($config.accebill.isPaySkipHoliday ne 0)checked#end
                                       title="#springMessage('common.sc_yn.yes')">
                                <input type="radio" name="accebill.isPaySkipHoliday" value="0"
                                       #if($config.accebill.isPaySkipHoliday eq 0)checked#end
                                       title="#springMessage('common.sc_yn.no')">
                            </div>
                            <div class="layui-input-inline">
                                <i id="isPaySkipHoliday-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 第三方票据自动托收申请
                        <td width="20%" class="textRight">#springMessage('config.accebill.isThirdBillAutoCollect')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="accebill.isThirdBillAutoCollect" value="1"
                                       #if($config.accebill.isThirdBillAutoCollect ne 0)checked#end
                                       title="#springMessage('common.sc_yn.yes')">
                                <input type="radio" name="accebill.isThirdBillAutoCollect" value="0"
                                       #if($config.accebill.isThirdBillAutoCollect eq 0)checked#end
                                       title="#springMessage('common.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 是否开启智能选票
                        <td width="20%" class="textRight">#springMessage('config.accebill.isAccebillIntellect')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="accebill.isAccebillIntellect" value="1"
                                       #if($config.accebill.isAccebillIntellect ne 0)checked#end
                                       title="#springMessage('common.sc_yn.yes')">
                                <input type="radio" name="accebill.isAccebillIntellect" value="0"
                                       #if($config.accebill.isAccebillIntellect eq 0)checked#end
                                       title="#springMessage('common.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <!-- 面板标题 -->
            <h2 class="layui-colla-title">#springMessage('config.accebill.title.budget')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                        #set($isBudget=$licenseTag.isModuleAuth("fbs"))
##                        #if($!{isBudget})
                        <tr>
                            ##是否挂资金计划
                            <td width="20%" class="textRight">#springMessage('config.accebill.isBudget')</td>
                            <td width="80%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-dict"
                                         data-type="radio"
                                         data-defaultvalue="$!{config.accebill.isBudget}"
                                         data-callback="isBudgetFun"
                                         data-name="accebill.isBudget"
                                         data-biz-name="isBudget"
                                         data-group="sf_yn"></div>
                                    #if($config.accebill.isBudget ne 1)
                                        #set($BudgetItemclass =" layui-disabled")
                                    #end
                                </div>
                                <div class="layui-input-inline">
                                    <i id="isBudget-desc" class="layui-icon">&#xe60b;</i>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##开票挂接资金计划科目
                            <td class="textRight">#springMessage('config.accebill.emitItem')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="emitItem" name="accebill.emitItem" autocomplete="off"
                                           class="layui-input$!{BudgetItemclass}" value="$!{config.accebill.emitItem}"
                                           #if($config.accebill.isBudget ne 1)disabled#end>
                                </div>
                                ## <span style="font-size:12px; color:red">#springMessage('config.accebill.emitItem.desc')</span>
                                <div class="layui-input-inline">
                                    <i id="emitItem-desc" class="layui-icon">&#xe60b;</i>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##收票挂接资金计划科目
                            <td class="textRight">#springMessage('config.accebill.recItem')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="recItem" name="accebill.recItem" autocomplete="off"
                                           class="layui-input$!{BudgetItemclass}" value="$!{config.accebill.recItem}"
                                           #if($config.accebill.isBudget ne 1)disabled#end>
                                </div>
                                ## <span style="font-size:12px; color:red">#springMessage('config.accebill.recItem.desc')</span>
                                <div class="layui-input-inline">
                                    <i id="recItem-desc" class="layui-icon">&#xe60b;</i>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##背书挂接资金计划科目
                            <td class="textRight">#springMessage('config.accebill.endorseItem')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="endorseItem" name="accebill.endorseItem" autocomplete="off"
                                           class="layui-input$!{BudgetItemclass}"
                                           value="$!{config.accebill.endorseItem}"
                                           #if($config.accebill.isBudget ne 1)disabled#end>
                                </div>
                                ## <span style="font-size:12px; color:red">#springMessage('config.accebill.endorseItem.desc')</span>
                                <div class="layui-input-inline">
                                    <i id="endorseItem-desc" class="layui-icon">&#xe60b;</i>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##贴现挂接资金计划科目
                            <td class="textRight">#springMessage('config.accebill.discountItem')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="discountItem" name="accebill.discountItem" autocomplete="off"
                                           class="layui-input$!{BudgetItemclass}"
                                           value="$!{config.accebill.discountItem}"
                                           #if($config.accebill.isBudget ne 1)disabled#end>
                                </div>
                                ## <span style="font-size:12px; color:red">#springMessage('config.accebill.discountItem.desc')</span>
                                <div class="layui-input-inline">
                                    <i id="discountItem-desc" class="layui-icon">&#xe60b;</i>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##托收挂接资金计划科目
                            <td class="textRight">#springMessage('config.accebill.collectionItem')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="collectionItem" name="accebill.collectionItem"
                                           autocomplete="off" class="layui-input$!{BudgetItemclass}"
                                           value="$!{config.accebill.collectionItem}"
                                           #if($config.accebill.isBudget ne 1)disabled#end>
                                </div>
                                ## <span style="font-size:12px; color:red">#springMessage('config.accebill.collectionItem.desc')</span>
                                <div class="layui-input-inline">
                                    <i id="collectionItem-desc" class="layui-icon">&#xe60b;</i>
                                </div>
                            </td>
                        </tr>
##                        #end
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <!-- 面板标题 -->
            <h2 class="layui-colla-title">#springMessage('config.accebill.title.check')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                        #set($isAccbook=$licenseTag.isModuleAuth("fcl"))
##                        #if($!{isAccbook})
                        <tr>
                            ## 是否记账
                            <td width="20%" class="textRight">#springMessage('config.accebill.isAccbook')</td>
                            <td width="80%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-dict"
                                         data-type="radio"
                                         data-defaultvalue="$!{config.accebill.isAccbook}"
                                         data-callback="isAccbookFun"
                                         data-name="accebill.isAccbook"
                                         data-biz-name="isAccbook"
                                         data-group="sf_yn"></div>
                                    #if($config.accebill.isAccbook ne 1)
                                        #set($isAutoAccbookVal ="0,1")
                                    #end
                                </div>
                                <div class="layui-input-inline">
                                    <i id="isAccbook-desc" class="layui-icon">&#xe60b;</i>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td width="20%" class="textRight">#springMessage('config.accebill.isAutoAccbook')</td>
                            <td width="80%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-dict"
                                         data-type="radio"
                                         data-defaultvalue="$!{config.accebill.isAutoAccbook}"
                                         data-name="accebill.isAutoAccbook"
                                         data-biz-name="isAutoAccbook"
                                         data-disabledValue="$!{isAutoAccbookVal}"
                                         data-group="sf_yn"></div>
                                </div>
                                <div class="layui-input-inline">
                                    <i id="isAutoAccbook-desc" class="layui-icon">&#xe60b;</i>
                                </div>

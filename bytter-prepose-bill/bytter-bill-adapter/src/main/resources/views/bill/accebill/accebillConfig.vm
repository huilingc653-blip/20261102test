    var moneyType;
    bt.use(['form', 'jquery', 'element', 'dicts', 'moneyType'], function () {
        form = bt.form(), $ = bt.jquery;
        moneyType = bt.moneyType.init();
        // 对所有日期设置最长为五个数字
        moneyType.get('isEAutoPayDayNum').attr('maxlength', 5);
        moneyType.get('eBankOverDayNum').attr('maxlength', 5);
        moneyType.get('eTradeOverDayNum').attr('maxlength', 5);
        moneyType.get('emitWarnDayNum').attr('maxlength', 5);
        moneyType.get('reserveWarnDayNum').attr('maxlength', 5);
        //监听提交
        form.on('submit(configSubmit)', function (data) {
            console.log(data.field['isCashingOnlinePayee1'])
            console.log(data.field['isCashingOnlinePayee2'])
            console.log(data.field['accebill.isAccebillIntellect'])
            var isCashingOnlinePayee;
            if (data.field['isCashingOnlinePayee1'] == 1) {
                isCashingOnlinePayee = data.field['isCashingOnlinePayee1'];
            } else {
                isCashingOnlinePayee = 0;
            }
            if (data.field['isCashingOnlinePayee2'] == 2) {
                isCashingOnlinePayee = isCashingOnlinePayee + "," + data.field['isCashingOnlinePayee2']
            } else {
                isCashingOnlinePayee = isCashingOnlinePayee + "," + 0;
            }
            data.field['accebill.isCashingOnlinePayee'] = isCashingOnlinePayee
            console.log(data)
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, "JSON");
            return false;
        });
        dicts = bt.dicts.init();

        // 说明显示隐藏
        showDesc();
    });

    isBudgetFun = function () {
        if ($('input:radio[name="accebill.isBudget"]:checked').val() == "0") {
            $("#emitItem").attr("disabled", true).addClass("layui-disabled");
            $("#recItem").attr("disabled", true).addClass("layui-disabled");
            $("#endorseItem").attr("disabled", true).addClass("layui-disabled");
            $("#discountItem").attr("disabled", true).addClass("layui-disabled");
            $("#collectionItem").attr("disabled", true).addClass("layui-disabled");
        } else {
            $("#emitItem").removeAttr("disabled").removeClass("layui-disabled");
            $("#recItem").removeAttr("disabled").removeClass("layui-disabled");
            $("#endorseItem").removeAttr("disabled").removeClass("layui-disabled");
            $("#discountItem").removeAttr("disabled").removeClass("layui-disabled");
            $("#collectionItem").removeAttr("disabled").removeClass("layui-disabled");
        }
    }

    isCreditFun = function () {
        if ($('input:radio[name="accebill.o"]:checked').val() == "0") {
            $("#tradeBillCredit0").attr("disabled", true);
            $("#tradeBillCredit1").attr("disabled", true);
        } else {
            $("#tradeBillCredit0").removeAttr("disabled");
            $("#tradeBillCredit1").removeAttr("disabled");
        }
        form.render('radio');
    }
    isCreditControlFun = function () {
        if ($('input:radio[name="accebill.isCredit"]:checked').val() == "0") {
            dicts.get('isDisCountCredit').attr({
                'data-disabledValue': '0,1'
            });
            dicts.get('isOpenRat').attr({
                'data-disabledValue': '0,1'
            });
            dicts.get('isDisThirdBillCredit').attr({
                'data-disabledValue': '0,1'
            });

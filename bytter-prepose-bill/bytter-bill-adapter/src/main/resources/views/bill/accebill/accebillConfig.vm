            $('input[type=radio][name="accebill.isDisCountCredit"][value="0"]').prop("checked", 'true');
            $('input[type=radio][name="accebill.isOpenRat"][value="0"]').prop("checked", 'true');
            $('input[type=radio][name="accebill.isDisThirdBillCredit"][value="0"]').prop("checked", 'true');
            form.render();
        } else {
            dicts.get('isDisCountCredit').attr({
                'data-disabledValue': ''
            });
            dicts.get('isOpenRat').attr({
                'data-disabledValue': ''
            });
            dicts.get('isDisThirdBillCredit').attr({
                'data-disabledValue': ''
            });
            ##dicts.get('isBail').attr({
            ##    'data-disabledValue':'0,1'
            ##});

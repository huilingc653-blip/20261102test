<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    ##选票规则组主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('bill.intellect.ruleGroup.mainMsg')</h2>
            <div class="layui-colla-content  layui-show">
                ## 申请单号
                <input type="hidden" id="applyNo" name="applyNo" value="$!{ruleGroup.applyNo}">
                <input type="hidden" name="eqs_applyNo" value="$!{ruleGroup.applyNo}">
                <input type="hidden" name="id" value="$!{ruleGroup.id}">
                <table class="layui-table">
                    <tr>
                        ## 规则组编码
                        <td style="width: 20%" class="textRight">
                            #springMessage('bill.intellect.ruleGroup.code')
                        </td>
                        <td style="width: 30%">
                            <div class="layui-inline">
                                <input type="text" class="layui-input" name="ruleGroupCode" disabled  value="$!{ruleGroup.ruleGroupCode}">
                            </div>
                        </td>
                        ## 规则组名称
                        <td style="width: 20%" class="textRight">
                            #springMessage('bill.intellect.ruleGroup.name')
                        </td>
                        <td style="width: 30%">
                            <div class="layui-inline">
                                <input type="text" class="layui-input" name="ruleGroupName" disabled  value="$!{ruleGroup.ruleGroupName}">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 备注
                        <td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" class="layui-input" name="rmk" disabled value="$!{ruleGroup.rmk}">
                            </div>
                        </td>
                        ## 明细规则（组）关系：
                        <td class="textRight">明细规则关系</td>
                        <td>
                            <div class="bt-biz-dict" data-type="select" data-defaultvalue="$!{ruleGroup.relation}" data-group="ruleGroup.relation"
                                 data-name="relation" data-biz-name="relation" data-disabled="true">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 筛选数量
                        <td class="textRight">#springMessage('bill.intellect.rule.screenNum')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" id="screenNum"  name="screenNum" style="text-align:right" data-name="screenNum" data-biz-name="screenNum" data-decimal="0"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" disabled value="$!{ruleGroup.screenNum}" data-min="0">
                            </div>
                        </td>
                        ## 有效标志
                        <td class="textRight">#springMessage('bisAccAttribute.validSign')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-dict" data-type="radio" data-defaultvalue="$!{ruleGroup.validSign}" data-group="sf_yn"
                                     data-name="validSign" data-biz-name="validSign" data-disabled="true">
                                </div>
                            </div>
                        </td>
                    </tr>

                </table>
            </div>
        </div>
    </div>

    ##选票规则组明细
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('bill.intellect.ruleGroup.ruleDtl')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <table id="appTable" class="layui-table">
                        <thead>
                        <tr>
                            <th>#springMessage('bill.intellect.ruleDtl.serialNo')</th>
                            ##                            <th>#springMessage('bill.intellect.ruleGroup.dtlGroupCode')</th>
                            <th>#springMessage('bill.intellect.rule.ruleName')</th>
                            <th>#springMessage('bill.intellect.ruleGroup.rmk')</th>
                            <th>#springMessage('common.table.thead.operation')</th>
                        </tr>
                        </thead>
                    </table>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/intellect/ruleGroup/ruleGroup.view.js?_btv=${resourceVersion}"></script>

</html>
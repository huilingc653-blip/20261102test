<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="inputForm" class="layui-form input150-container">
    <input type="hidden" id="isOnline" value="">
    <input type="hidden" id="id" name="id" value="">
    <input type="hidden" id="onlineType" value="">
    <input type="hidden" id="payerIds" name="payerIds" value="">
    <input type="hidden" id="payerExternalIds" name="payerExternalIds" value="">
    <input type="hidden" id="acceptorIds" name="acceptorIds" value="">
    <input type="hidden" id="acceptorExternalIds" name="acceptorExternalIds"/>
    <input type="hidden" id="reqIds" name="reqIds" value="">
    <input type="hidden" id="reqExternalIds" name="reqExternalIds" value="">
    <table class="layui-table">
        <tbody>
        <tr>
        ##所属单位
            <td class="textRight" width="16%">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td width="34%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="radio"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="corpId"
                         data-required="true"
                         data-resource="bill:accebill:sign:query"
                         data-placeholder="#springMessage('table.abVoucherinfoVice.corpId')">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
        	##策略名称
            <td class="textRight" width="16%">#springMessage('table.btwarnstrategy.name')</td>
            <td width="34%">
                <input type="text" id="name" name="name" lay-verify="required|strlength"  data-maxlength="500"
                       autocomplete="off" class="layui-input"  placeholder="#springMessage('table.btwarnstrategy.name')">
            </td>
            ##策略代码
            <td class="textRight" width="16%"><font color="red">*</font>#springMessage('table.btwarnstrategy.code')</td>
            <td width="34%">
                <input type="text" value="$!{autoSignNo}" disabled id="code" name="code" autocomplete="off" class="layui-input" disabled="true">
            </td>
       </tr>
        <tr>
        ##票据类型
            <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
            <td>
           		<div class="bt-biz-dict" data-required="true" data-defaultvalue="10" data-type="select" data-callback="switchBillType"
           		 data-group="AB_BILL_TYPE" data-placeholder="" data-name="billType" data-displayData="10,11"></div>
            </td>
        ##签收类型
            <td class="textRight">#springMessage('bill.accebill.signerType')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="mulselect" data-group="AB_BILL_SIGNERTYPE" data-name="signType"
                         data-biz-name="signType" data-required="true"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##出票人
            <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
            <td>
                <div>
					<button class="layui-btn bt-biz-externalCorp" data-name="btnPayer" type="button" data-callback="bt.externalCorpCallback" data-beforeClick="bt.externalCorpParams" data-value="01">选择</button>
					<button class="layui-btn bt-biz-externalCorp" data-name="viewPayer" style="display: none" type="button" data-callback="bt.externalCorpCallback" data-beforeClick="bt.externalCorpViewParams" data-value="01">查看</button>
				</div>
            </td>
        ##承兑人
            <td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
            <td>
	           	<div class="layui-input-inline" id="acceptorBankButtonDiv">
                   <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json" data-method="get"
                        data-valuefield="id" data-textfield="typeName" data-name="typeName" data-inputvalue="inputvalue" data-callback="switchAcceptor" data-search="true"></div>
				</div>
				<div class="layui-input-inline" id="acceptorCustomerButtonDiv" style="display:none;">
					<button class="layui-btn bt-biz-externalCorp" id="btnAcceptor" data-name="btnAcceptor" type="button" data-callback="bt.externalCorpCallback" data-beforeClick="bt.externalCorpParams" data-value="02">选择</button>
					<button class="layui-btn bt-biz-externalCorp" data-name="viewAcceptor" style="display: none" type="button" data-callback="bt.externalCorpCallback" data-beforeClick="bt.externalCorpViewParams" data-value="02">查看</button>
				</div>
			##承兑人选择单位id
               <input type="hidden" id="acceptoracc" name="acceptoracc"/>
            </td>
        </tr>
        <tr>
        ##转让标记
            <td class="textRight">#springMessage('table.abVoucherinfo.banendrsmtmk')</td>
            <td >
                <div class="bt-biz-dict" data-type="select" data-group="AB_BANEM" data-name="bankendrsmtmk"></div>
            </td>
        ##业务发起人
            <td class="textRight">#springMessage('bpm.model.business')#springMessage('bpm.model.owner')</td>
            <td>
				<div>
					<button class="layui-btn bt-biz-externalCorp" data-name="btnReq" type="button" data-callback="bt.externalCorpCallback" data-beforeClick="bt.externalCorpParams" data-value="03">选择</button>
					<button class="layui-btn bt-biz-externalCorp" style="display: none" data-name="viewReq" type="button" data-callback="bt.externalCorpCallback" data-beforeClick="bt.externalCorpViewParams" data-value="03">查看</button>
				</div>
			</td>
        </tr>
        <tr>
        ##票面金额
            <td class="textRight">#springMessage('bill.accebill.billMoney')</td>
            <td class="textLeft" width="30%">
                <div class="bt-biz-dict" data-type="select" data-width="70px" data-group="FUNDWARN_OPERATOR" data-defaultvalue="10" data-inputvalue="false"
                           data-name="beginOperator" id="beginOperator" data-biz-name="beginOperator" data-placeholder=""
                ></div>
                <div class="layui-input-inline">
                    <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text" id="beginNum" name="beginNum" style="width: 120px;"  autocomplete="off"  placeholder=""  data-maxlength="18">
                </div>
                <div class="bt-biz-dict" data-type="select" data-width="70px"   data-group="FUNDWARN_NUM_OPERATOR" data-inputvalue="false" data-defaultvalue="02"
                     data-name="numOperator" id="numOperator" data-biz-name="numOperator" data-placeholder=""
                     data-callback=""></div>
                <div class="bt-biz-dict" data-type="select" data-width="80px" data-group="FUNDWARN_OPERATOR" data-defaultvalue="20" data-inputvalue="false"
                     data-name="endOperator" id="endOperator" data-biz-name="endOperator" data-placeholder=""
                     data-callback=""></div>
                <div class="layui-input-inline">
                    <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text" id="endNum" name="endNum" style="width: 120px;" autocomplete="off" class="layui-input" placeholder=""  data-maxlength="18">
                </div>
            </td>
        ##有效标记
            <td class="textRight">#springMessage('table.bvVoucherType.validSign')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="validSign" data-biz-name="validSign" data-required="true"></div>
                </div>
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" type="button" lay-filter="save">#springMessage('common.button.save')</button>
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillSignStrategy.add.js?_btv=${resourceVersion}"></script>
</html>

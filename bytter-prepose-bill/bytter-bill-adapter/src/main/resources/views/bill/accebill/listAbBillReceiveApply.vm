            </td>
        </tr>
        </tbody>
    </table>
    <br>
</form>

#end
#parse("views/common/footer.vm")
#caDataHidden()
#caDataScript()
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillReceiveApply.list.js?_btv=${resourceVersion}"></script>

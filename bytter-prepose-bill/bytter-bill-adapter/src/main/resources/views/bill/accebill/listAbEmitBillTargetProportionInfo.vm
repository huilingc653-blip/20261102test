<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位
            <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="corpId"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-scope="all"
                         data-resource="bill:accebill:abemitbill:billTargetProportion:query"
                    >
                    </div>
                </div>
            </td>
            ##年份
            <td class="textRight">#springMessage('table.emitBill.billTargetProportion.year')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="eqs_currentYear" data-biz-name="eqs_currentYear" id="eqs_currentYear"
                           class="layui-input bt-biz-dateType" data-type="year">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.emitBill.billTargetProportion.companyName')</th>
            <th>#springMessage('table.emitBill.billTargetProportion.year')</th>
            <th>#springMessage('table.emitBill.billTargetProportion.target')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>

    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abEmitBillTargetProportionInfo.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
		<div class="layui-collapse" lay-filter="collapse">
		<div class="layui-colla-item">
		<h2 class="layui-colla-title"></h2>
		<div class="layui-colla-content layui-show">
        <table class="layui-table">
            <tbody>
                <tr>
                    ## 申请单位
                    <td width="8%" class="textRight">#springMessage('bill.accebill.applyCorp')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_applyCorpId"
                                 data-scope="all"
                                 data-resource="bill:accebill:delete:query"
                                 data-callback="applyCorpCallback"
                            >
                            </div>
                        </div>
                    </td>
                    ## 票据单位
                    <td  width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-name="corpId"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 data-resource="bill:accebill:delete:query"
                                 data-scope="all"
                            >
                            </div>
                        </div>
                    </td>
                    ## 业务单位
                    <td  width="8%" class="textRight" >#springMessage('bill.accebill.busCorp')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_busCorpId"
                                 data-scope="all"
                                 data-resource="bill:accebill:delete:query"
                            >
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##业务人员
                    <td  width="8%" class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_busPersonnel"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
                        </div>
                    </td>

					##票据号码
                    <td class="textRight" width="8%">#springMessage('table.abVoucherinfo.origNo')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_origNo"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
                        </div>
                    </td>
                    ##票据类型
                    <td class="textRight" width="8%">#springMessage('table.abVoucherinfo.billType')</td>
                    <td width="25%">
				    <div class=layui-form>
						<div class=bt-biz-dict data-type="select" data-name="eqi_billType"  data-group="AB_BILL_TYPE">
						</div>
					</div>
                    </td>
				</tr>
				<tr>
					 ##流通介质
                    <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
                    <td width="20%">
				    <div class=layui-form>
						<div class=bt-biz-dict data-type="select" data-name="eqi_billFlag"  data-group="AB_BILL_FLAG">
						</div>
					</div>
                    </td>
                     ##出票日期
                     <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                     <td >
                         <div class="layui-inline">
                             <div id="startDate" ></div>
                         </div>
                     </td>
                     ##到期日期
                     <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                     <td >
                         <div class="layui-inline">
                             <div id="endDate" ></div>
                         </div>
                     </td>
				</tr>
                <tr>
                ##出票标志
                    <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
                    <td width="20%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND"
                                 data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
                        </div>
                    </td>
                ##业务批次号
                    <td class="textRight">#springMessage('bill.business.batchNo')</td>
                    <td >
                        <input type="text" name="likes_batchNo"
                               autocomplete="off" class="layui-input"
                               placeholder="#springMessage('bill.business.batchNo')">
                    </td>
                ##票据是否允许分包
                    <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
                    <td >
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND"
                                 data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td width="8%" class="textRight">#springMessage('table.bill.bankType.holderBankType')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                                 data-method="get"
                                 data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                                 data-inputvalue="inputvalue" data-search="true"></div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="8" style="text-align: center;">
##						#if($shiro.hasPermission("bill:accebill:delete:query"))
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
##						#end
                    </td>
				</tr>
            </tbody>
        </table>
		</div>
		</div>
		</div>
    </form>
###if($shiro.hasPermission("bill:accebill:delete:query"))
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('bill.accebill.applyCorp')</th>
        <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
        <th>#springMessage('bill.accebill.busCorp')</th>
        <th>#springMessage('bill.accebill.busPersonnel')</th>
        <th>#springMessage('table.abVoucherinfo.origNo')</th>
		<th>#springMessage('table.abVoucherinfo.billType')</th>
		<th>#springMessage('table.abVoucherinfo.billFlag')</th>
		<th>#springMessage('table.abVoucherinfoVo.openWay')</th>
		<th>#springMessage('table.abVoucherinfo.payer')</th>
		<th>#springMessage('table.abVoucherinfo.acceptor')</th>
		<th>#springMessage('table.abVoucherinfo.billMoney')</th>
		<th>#springMessage('table.abVoucherinfo.startDate')</th>
		<th>#springMessage('table.abVoucherinfo.endDate')</th>
		<th>#springMessage('table.abVoucherinfo.payee')</th>
        <th>#springMessage('table.abAccrecords.cnAccrecords')</th>
		<th>#springMessage('table.abVoucherinfo.Business.Brief.Id')</th>
		<th>#springMessage('bill.accebill.billSendSign')</th>
		<th>#springMessage('table.abAccrecords.status')</th>
        <th>#springMessage('bill.business.batchNo')</th>
        <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
        <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
        <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>
        <th>#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
###end
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillDelete.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>

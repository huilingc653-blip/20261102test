<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="bankTypeId" name="bankTypeId" type="hidden">
    <input id="bankTypeName" name="bankTypeName" type="hidden">
    <input id="corpName" name="corpName" type="hidden">
    <table class="layui-table">
        <tbody >
        <tr >
            ##票据单位
            <td class="textRight" width="15%">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td width="35%">
                <div class="layui-input-inline" id="corpId">
                    <div class="bt-biz-corp"
                         data-biz-type="accCorp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="corpId"
                         data-scope="all"
                         data-required="true"
                         data-resource="bill:accebill:abemitbill:bailInterestInfo:query"
                         data-callbackData="corpCallback"
                         placeholder="#springMessage('table.abVoucherinfoVice.corpId')">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##票据账号
            <td class="textRight" width="15%">#springMessage('table.abVoucherinfoVice.bankAcc')</td>
            <td width="35%">
                <div class="layui-input-inline">
                    <input type="text" id="bankAcc" name="bankAcc" data-name="bankAcc"
                           data-biz-name="bankAcc"
                           data-resource="bill:accebill:abemitbill:bailInterestInfo:query" lay-verify="required"
                           data-defaultcorp="xx" electricBill="1"
                           class="bank layui-input bt-biz-accountTable" data-callback="accountCallBack"
                           data-biz-name="bankAcc">
                </div>
            </td>
        </tr>
        <tr>
            ##月份
            <td width="10%" class="textRight">#springMessage('table.btBankAccDtl.months')</td>
            <td width="20%">
                <div class="layui-inline">
                    <input type="text" name="currentMonth" data-biz-name="currentMonth" id="currentMonth" lay-verify="required"
                           class="layui-input bt-biz-dateType" data-type="month">
                </div>
            </td>
        </tr>
        <tr>
            ##利息差额
            <td class="textRight">#springMessage('table.emitBill.bailInterest.interest.margin')</td>
            <td>
                <input type="text" data-name="interestMargin" class="layui-input bt-biz-moneyType"
                       lay-verify="required"
                       placeholder="#springMessage('table.emitBill.bailInterest.interest.margin')" data-biz-name="interestMargin" name="interestMargin"
                       id="interestMargin" data-minus="true">
            </td>
        </tr>
        <tr >
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abEmitBailInterestInfo.add.js?_btv=${resourceVersion}"></script>
</html>

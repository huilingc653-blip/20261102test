<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ## 单位
                        <td width="8%" class="textRight">#springMessage('table.btBankAccDtl.corp')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-name="corpId"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_corpId"
                                     data-resource="bill:accebill:bankaccBalCompare:query:corpop"
                                     data-scope="all"
                                     id="corpId"
                                >
                                </div>
                            </div>
                        </td>
                        ##帐号
                        <td class="textRight">#springMessage('bill.accebill.bankacc')</td>
                        <td width="20%">
##                            <div class="layui-input-inline">
##                                <input type="text" name="likes_bankAcc" id="bankAcc"
##                                       autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.bankacc')">
##                            </div>0
                            <div class="layui-input-inline">
                                <input type="text" id="likes_bankAcc" name="likes_bankAcc" data-name="likes_bankAcc" data-biz-name="likes_bankAcc" accountType="2,3"
                                       autocomplete="off" placeholder="#springMessage('bill.accebill.bankacc')"
                                       class="layui-input bt-biz-accountTable" data-callback="accountCallBack"/>
                            </div>
                        </td>
                        ##到期日期
                        <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" name="ged_endDate" data-biz-name="ged_endDate" data-name="ged_endDate" data-endid="endDate" class="layui-input bt-biz-dateType" data-today="true" lay-verify="required"
                                       data-type="date"  data-callback="endDateCallback"/>
                            </div>
                            ~
                            <div class="layui-inline">
                                <input type="text" name="led_endDate" data-biz-name="led_endDate"　data-name="led_endDate" class="layui-input bt-biz-dateType" data-today="true" lay-verify="required"
                                       id="endDate" data-type="date"/>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 公司类型
                        <td class="textRight">#springMessage('bill.accebill.corpType')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-url="${basePath}/sys/equityMaintenance/json" data-biz-name="ins_equityCode"
                                     data-name="ins_equityCode" data-valueField="equityCode" data-textField="equityName"></div>
                            </div>
                        </td>
                        ##所属账户银行类别
                        <td class="textRight">#springMessage('table.bisAccBal.bankName')</td>
                        <td width="20%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                                     data-method="get"
                                     data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId" data-biz-name="ins_bankTypeId"
                                     data-inputvalue="inputvalue" data-search="true"></div>
                            </div>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>
    <tr>
        <td colspan="6" style="text-align: center;">
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </div>
        </td>
    </tr>
    </tbody>
    </table>
    </div>
    </div>
    </div>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('bill.accebill.region')</th>
        <th>#springMessage('bill.accebill.operatingArea')</th>
        <th>#springMessage('bill.accebill.corpName')</th>
        <th>#springMessage('bill.accebill.corpType')</th>
        <th>#springMessage('table.bisAccBal.bankName')</th>
        <th>#springMessage('table.btBankAcc.bankAcc')</th>
        <th>#springMessage('table.cmsLoanInfo.loanMoney')</th>
        <th>#springMessage('table.cmsLoanInfo.loan.reapyInterest')</th>
        <th>#springMessage('bill.accebill.acceptBillMoney')</th>
        <th>#springMessage('bill.accebill.preDayBal')</th>
        <th>#springMessage('bill.accebill.discrepancy')</th>
        <th>#springMessage('table.abAccrecords.bailpercent')</th>
        <th>#springMessage('table.abAccrecords.bailmoney')</th>
        <th>#springMessage('table.cmsLease.endDate')</th>
        <th>#springMessage('bill.accebill.applyRepayMoney')</th>
        <th>#springMessage('bill.accebill.applyName')</th>
        <th>#springMessage('bill.accebill.rmk')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/bankAccBalCompare.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>

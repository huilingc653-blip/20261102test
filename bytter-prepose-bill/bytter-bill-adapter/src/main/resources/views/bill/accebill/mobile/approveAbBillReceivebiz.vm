<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<script src="${basePath}/static/plugins/jquery/jquery.min.js?_btv=${resourceVersion}"></script>
<body>
 <ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.sign.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
		<li class="mui-table-view-cell">
    		#springMessage('bill.accebill.signerType')
            <span class="mui-badge mui-badge-inverted">
    			$!{info.signerType}
    		</span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('bill.accebill.signUpFlag')
            <span class="mui-badge mui-badge-inverted">$!{info.sgnupmkName}</span>
        </li>
		#if(((${info.msgtype} eq '020') or (${info.msgtype} eq '021')) and ${info.sgnupmk} eq 'SU01')
		<li class="mui-table-view-cell">
            #springMessage('bill.accebill.dshnr')
            <span class="mui-badge mui-badge-inverted">
				$!{info.dshnrcdName}
			</span>
        </li>	
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.dshnrrsn')
            <span class="mui-badge mui-badge-inverted">
				$!{info.dshnrrsn}
			</span>
        </li>
		#end
    	<li class="mui-table-view-cell">
			#springMessage('bill.accebill.signDate')
            <span class="mui-badge mui-badge-inverted">
    			$!date.format('yyyy-MM-dd',$!{info.replyDt})
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.op')
            <span class="mui-badge mui-badge-inverted">
				($!{info.createBy})$!{info.createName}
    		</span>
        </li>
        </ul>
    </li>
    <li class="mui-table-view-cell mui-collapse">
        <a class="mui-navigate-right" href="#">#springMessage('bill.accebill.billInfo.title')</a>
        <ul class="mui-table-view H-theme-background-color-white">
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.origNo')
            <span class="mui-badge mui-badge-inverted">
				$!{info.origNo}
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.billMoney')
            <span class="mui-badge mui-badge-inverted">
				$number.formatNumeric($!{info.billMoney})
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.billType')
            <span class="mui-badge mui-badge-inverted">
				$!{info.billTypeName}
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.startDate')
            <span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!{info.startDate})
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.endDate')
            <span class="mui-badge mui-badge-inverted">
				$!date.format('yyyy-MM-dd',$!{info.endDate})
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.payer')
            <span class="mui-badge mui-badge-inverted">
				$!{info.payer}
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.payeracc')
            <span class="mui-badge mui-badge-inverted">
				$!{info.payeracc}
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.acceptor')
            <span class="mui-badge mui-badge-inverted">
				$!{info.acceptor}
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.acceptoracc')
            <span class="mui-badge mui-badge-inverted">
				$!{info.acceptoracc}
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.payee')
            <span class="mui-badge mui-badge-inverted">
				$!{info.payee}
			</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('table.abVoucherinfo.payeeacc')
            <span class="mui-badge mui-badge-inverted">
				$!{info.payeeacc}
			</span>
        </li>
        </ul>
    </li>
	
	#set($vmPage = "views/bill/accebill/mobile/approveAbBillReceivebiz"+${info.msgtype}+".vm")
	#parse($vmPage)
</ul>
#parse("views/common/wapfooter.vm")
</body>
</html>
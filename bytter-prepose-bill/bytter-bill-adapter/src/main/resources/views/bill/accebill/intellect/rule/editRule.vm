<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    ##选票规则主信息
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('bill.intellect.rule.mainMessage')</h2>
            <div class="layui-colla-content  layui-show">
                ## 申请单号
                <input type="hidden" id="applyNo" name="applyNo" value="$!{rule.applyNo}">
                <input type="hidden" name="eqs_applyNo" value="$!{rule.applyNo}">
                <input type="hidden" name="id" value="$!{rule.id}">
                <input type="hidden" name="createBy" value="$!{rule.createBy}">
                <table class="layui-table">
                    <tr>
                        ## 规则编码
                        <td style="width: 20%" class="textRight">
                            #springMessage('bill.intellect.rule.ruleCode')
                        </td>
                        <td style="width: 30%">
                            <div class="layui-inline">
                                <input type="text" class="layui-input" name="ruleCode" lay-verify="required" value="$!{rule.ruleCode}">
                            </div>
                        </td>
                        ## 规则名称
                        <td style="width: 20%" class="textRight">
                            #springMessage('bill.intellect.rule.ruleName')
                        </td>
                        <td style="width: 30%">
                            <div class="layui-inline">
                                <input type="text" class="layui-input" name="ruleName" lay-verify="required" value="$!{rule.ruleName}">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 备注
                        <td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" class="layui-input" name="rmk" value="$!{rule.rmk}">
                            </div>
                        </td>
                        <td class="textRight"></td>
                        <td>
                            <div class="layui-inline">

                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 筛选数量
                        <td class="textRight">#springMessage('bill.intellect.rule.screenNum')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" id="screenNum"  name="screenNum" style="text-align:right" data-name="screenNum" data-biz-name="screenNum" data-decimal="0"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{rule.screenNum}" data-min="0">
                            </div>
                        </td>
                        ## 有效标志
                        <td class="textRight">#springMessage('bisAccAttribute.validSign')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-dict" data-type="radio" data-defaultvalue="$!{rule.validSign}" data-group="sf_yn"
                                     data-name="validSign" data-biz-name="validSign">
                                </div>
                            </div>
                        </td>
                    </tr>

                </table>
            </div>
        </div>
    </div>

    ##选票规则明细
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('bill.intellect.rule.ruleDtl')</h2>
            <div class="layui-colla-content  layui-show">
                <table class="layui-table">
                    <table id="appTable" class="layui-table">
                        <thead>
                        <tr>
                            <th>#springMessage('bill.intellect.ruleDtl.serialNo')</th>
                            <th>#springMessage('bill.intellect.ruleDtl.parentName')</th>
                            <th>#springMessage('bill.intellect.ruleDtl.elementName')</th>
                            <th>#springMessage('bisAccAttribute.rmk')</th>
                            <th>#springMessage('common.table.thead.operation')</th>
                        </tr>
                        </thead>
                    </table>
                    <tr>
                        <td colspan="4">
                            <div style="text-align: center;width: 100%">
                                <button class="layui-btn" lay-submit lay-filter="submit" type="button">#springMessage('common.button.submit')</button>
                                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/intellect/rule/rule.edit.js?_btv=${resourceVersion}"></script>

</html>
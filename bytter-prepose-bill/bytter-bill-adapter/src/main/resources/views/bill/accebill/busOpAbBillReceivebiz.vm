
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
    <style>
    	.layui-table {
            margin: 0px 0;
		}
    </style>
</head>
<body>
	<form class="layui-form layui-form-pane" id="fromVerify">
		<input type="hidden" id="curId" name="curCode" value="$!{curId}" />
		#set($vmReBasePage = "views/bill/accebill/busOpAbBillReceivebizBase.vm")
		#parse($vmReBasePage)
		<br>
		<br>
		<div class="layui-form-item layui-form-submit ">
			##if((${info.msgtype} eq '020') or (${info.msgtype} eq '021'))
			<div class="layui-inline">
				<label>新一代票据#springMessage('bill.accebill.dshnr')</label>
				<div class="layui-inline">
					<div class="bt-biz-dict" data-group="AB_BILL_NEW_DSHNRCD" data-id="newDshnrcd" data-name="newDshnrcd" data-type="select" ></div>
				</div>
			</div>
			<div class="layui-inline">
                <label>#springMessage('bill.accebill.dshnr')</label>
                <div class="layui-inline">
            		<div class="bt-biz-dict" data-group="AB_BILL_DSHNRCD" data-id="dshnrcd" data-name="dshnrcd" data-type="select" ></div>
                </div>
            </div>
            <div class="layui-inline">
                <label>#springMessage('bill.accebill.dshnrrsn')</label>
                <div class="layui-inline">
            		<input type="text" id="dshnrrsn" autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="100" 
						placeholder="#springMessage('bill.accebill.dshnrrsn')">
                </div>
            </div>
			
			<br>
			##end
			<div class="layui-input-block">
				#if((${info.billType} eq '10' && $shiro.hasPermission("bill:accebill:abBillReceivebiz:bank:sign"))
				||(${info.billType} eq '11' && $shiro.hasPermission("bill:accebill:abBillReceivebiz:merch:sign"))
				||(${info.billType} ne '10' && ${info.billType} ne '11' && $shiro.hasPermission("bill:accebill:abBillReceivebiz:other:sign")))
				<button type="button" class="layui-btn" onclick="sign('$!{info.id}','$!{info.msgtype}',0)">#springMessage('common.button.consent')</button>
				<button type="button" class="layui-btn" onclick="sign('$!{info.id}','$!{info.msgtype}',1)">#springMessage('common.button.noConsent')</button>
				#end
				<button type="button" class="layui-btn layui-btn-primary" onclick="closeForms()">#springMessage('common.button.revert')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
	#caDataHidden()
	#caDataScript()
	<script src="${basePath}/static/modules/sys/blackWhite/blackWhiteBase.check.js?_btv=${resourceVersion}"></script>
	<script src="${basePath}/static/modules/bill/accebill/abBillReceivebiz.busOp.js?_btv=${resourceVersion}"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
						<div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.abVoucherinfo.origNo')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{abEmitBillBackPage.origNo}
                    </label>
                </div>
            </div>
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.abVoucherinfo.billType')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{abEmitBillBackPage.billType}
                    </label>
                </div>
            </div>
				</div>
				<div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.abVoucherinfo.boxStatus')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{abEmitBillBackPage.boxStatus}
                    </label>
                </div>
            </div>
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.abVoucherinfo.billStatus')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{abEmitBillBackPage.billStatus}
                    </label>
                </div>
            </div>
				</div>
				<div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.abVoucherinfo.billFlag')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{abEmitBillBackPage.billFlag}
                    </label>
                </div>
            </div>
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.abVoucherinfo.billMoney')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{abEmitBillBackPage.billMoney}
                    </label>
                </div>
            </div>
				</div>
				<div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.abVoucherinfo.startDate')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!date.format('yyyy-MM-dd',$!{abEmitBillBackPage.startDate})
                    </label>
                </div>
            </div>
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.abVoucherinfo.endDate')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!date.format('yyyy-MM-dd',$!{abEmitBillBackPage.endDate})
                    </label>
                </div>
            </div>
				</div>
				<div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.abVoucherinfo.payer')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{abEmitBillBackPage.payer}
                    </label>
                </div>
            </div>
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.abVoucherinfo.payee')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{abEmitBillBackPage.payee}
                    </label>
                </div>
            </div>
				</div>
				<div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.abVoucherinfo.acceptor')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{abEmitBillBackPage.acceptor}
                    </label>
                </div>
            </div>
				</div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
#* 
*6201 票据上划
*#
	<div class="layui-colla-item">
	<h2 class="layui-colla-title">#springMessage('bill.accebill.transferupapply.title')</h2>
	<div class="layui-colla-content layui-show">
		<table class="layui-table">
		<tbody>
			##上划单位        bill.accebill.transferupapply.transferupcorp  
			##上划单位开户银行 bill.accebill.transferupapply.transferupbank  
		<tr>
			<td width="20%" class="textRight">#springMessage('bill.accebill.transferupapply.transferupcorp')</td>
			<td width="30%">$!{info.corpName}</td>
			<td width="20%" class="textRight">#springMessage('bill.accebill.transferupapply.transferupbank')</td>
			<td width="30%">$!{info.corpBankName}</td>
        </tr>
			##上划银行账号       bill.accebill.transferupapply.transferupbankacc
			##上划银行行号       bill.accebill.transferupapply.transferupbankno
		<tr>
			<td width="20%" class="textRight">#springMessage('bill.accebill.transferupapply.transferupbankacc')</td>
			<td width="30%">$!{info.reqAcctId}</td>
			<td width="20%" class="textRight">#springMessage('bill.accebill.transferupapply.transferupbankno')</td>
			<td width="30%">$!{info.reqAcctsvcr}</td>
        </tr>
			##中心单位       bill.accebill.transferupapply.centercorp
			## 中心单位开户银行  bill.accebill.transferupapply.centerbank
		<tr>
			<td width="20%" class="textRight">#springMessage('bill.accebill.transferupapply.centercorp')</td>
			<td width="30%">$!{info.netCorpName}</td>
			<td width="20%" class="textRight">#springMessage('bill.accebill.transferupapply.centerbank')</td>
			<td width="30%">$!{info.netBankName}</td>
        </tr>
			## 中心银行账号   bill.accebill.transferupapply.centerbankacc
			## 中心银行行号   bill.accebill.transferupapply.centerbankno
		<tr>
			<td width="20%" class="textRight">#springMessage('bill.accebill.transferupapply.centerbankacc')</td>
			<td width="30%">$!{info.recAcctId}</td>
			<td width="20%" class="textRight">#springMessage('bill.accebill.transferupapply.centerbankno')</td>
			<td width="30%">$!{info.recAcctsvcr}</td>
        </tr>
			##业务办理日期  table.abVoucherinfo.Business.date
		<tr>
			<td width="20%" class="textRight">#springMessage('table.abVoucherinfo.Business.date')</td>
			<td width="30%">$!date.format('yyyy-MM-dd',$!{info.businessDate})</td>
			<td width="20%" class="textRight"></td>
			<td width="30%"></td>
        </tr>
        </tbody>
        </table>
    </div>
    </div>

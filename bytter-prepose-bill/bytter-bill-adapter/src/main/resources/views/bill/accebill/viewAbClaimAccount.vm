<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<input id="createBy" name="createBy" type="hidden" value="$!{abClaimAccountVo.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{abClaimAccountVo.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{abClaimAccountVo.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{abClaimAccountVo.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{abClaimAccountVo.id}">
		<table class="layui-table">
			<tbody>
				<tr>
    				<td width="20%" class="textRight">#springMessage('bill.accebill.corpId')</td>
					<td width="30%">
						$!{abClaimAccountVo.corpName}
					</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('bill.accebill.bankacc')</td>
					<td>
						$!{abClaimAccountVo.bankAcc}
					</td>
    				<td class="textRight">#springMessage('bill.accebill.bankTypeName')</td>
					<td>
						$!{abClaimAccountVo.bankTypeName}
					</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('bill.accebill.bustype')</td>
					<td>
##						$!{abClaimAccountVo.busTypeName}
						$dictTag.get("AB_CLAIM_ACCOUNTCONFIG",$!{abClaimAccountVo.busType})
					</td>
    				<td class="textRight">#springMessage('bill.accebill.validSign')</td>
					<td>
						$dictTag.get("valid_sign",$!{abClaimAccountVo.validSign})
					</td>
				</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
<script>

</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{info.id}" >
    <table class="layui-table">
        <tbody >
        <tr >
            ##票据单位
            <td class="textRight" width="15%">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td width="35%">
                $!{info.corpName}
            </td>
        </tr>
        <tr>
            ##票据账号
            <td class="textRight" width="15%">#springMessage('table.abVoucherinfoVice.bankAcc')</td>
            <td width="35%">
                $!{info.bankAcc}
            </td>
        </tr>
        <tr>
            ##月份
            <td width="10%" class="textRight">#springMessage('table.btBankAccDtl.months')</td>
            <td width="20%">
                $!{info.currentMonth}
            </td>
        </tr>
        <tr>
            ##记录来源
            <td class="textRight">#springMessage('table.bill.recordSource')</td>
            <td width="24%">
                #if($!{info.recordSource} == '0')
                    自动生成
                #else
                    手动增加
                #end
            </td>
        </tr>
        #if($!{info.recordSource} == '0')
            <tr>
                ##票据金额
                <td class="textRight">#springMessage('bill.accebill.billMoney')</td>
                <td>
                    $number.formatNumeric($!{info.billMoney})
                </td>
            </tr>
            <tr>
                ##保证金额
                <td class="textRight">#springMessage('table.fcBond.bondmoney')</td>
                <td>
                    <input type="text" data-name="bailMoney" class="layui-input bt-biz-moneyType"
                           lay-verify="required"
                           placeholder="#springMessage('table.fcBond.bondmoney')" data-biz-name="bailMoney" name="bailMoney"
                           id="bailMoney" data-min="0" value="$!{info.bailMoney}">
                </td>
            </tr>
            <tr>
                ##实际结算金额
                <td class="textRight">#springMessage('table.emitBill.bailInterest.actualSettlementAmount')</td>
                <td>
                    <input type="text" data-name="actualSettlementAmount" class="layui-input bt-biz-moneyType"
                           lay-verify="required"
                           placeholder="#springMessage('table.emitBill.bailInterest.actualSettlementAmount')" data-biz-name="actualSettlementAmount" name="actualSettlementAmount"
                           id="actualSettlementAmount" data-min="0" value="$!{info.actualSettlementAmount}">
                </td>
            </tr>
            <tr>
                ##利息差额
                <td class="textRight">#springMessage('table.emitBill.bailInterest.interest.margin')</td>
                <td>
                    $number.formatNumeric($!{info.interestMargin})
                </td>
            </tr>
        #else
            <tr>
                ##利息差额
                <td class="textRight">#springMessage('table.emitBill.bailInterest.interest.margin')</td>
                <td>
                    <input type="text" data-name="interestMargin" class="layui-input bt-biz-moneyType"
                           lay-verify="required"
                           placeholder="#springMessage('table.emitBill.bailInterest.interest.margin')" data-biz-name="interestMargin" name="interestMargin"
                           id="interestMargin" data-minus="true" value="$!{info.interestMargin}">
                </td>
            </tr>
        #end
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abEmitBailInterestInfo.edit.js?_btv=${resourceVersion}"></script>
</html>

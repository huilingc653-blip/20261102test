<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            ##单位
            <td class="textRight">#springMessage('table.btBankAcc.corpId')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="ins_corpId"
                         data-scope="all"
                         data-resource="bill:accebill:planamt:maintain:query"></div>
                </div>
            </td>
            ##银行名称
            <td class="textRight">银行名称</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                         data-method="get"
                         data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
            ##授信类型
            <td class="textRight">授信类型</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class=bt-biz-dict data-type="select" data-group="bill:accebill.creditType"
                         data-name="eqs_creditType"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td align="center" colspan="6">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form layui-table-border" style="width:100%;">
    <thead>
    <tr>
        <th>单位名称</th>
        <th>银行名称</th>
        <th>授信类型</th>
        <th>周开始日</th>
        <th>周结束日</th>
        <th>本周计划开票金额</th>
        <th>下周计划开票金额</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillPlanAmtMaintain.list.js?_btv=${resourceVersion}"></script>
</html>

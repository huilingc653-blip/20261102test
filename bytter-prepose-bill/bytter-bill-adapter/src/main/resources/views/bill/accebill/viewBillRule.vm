<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	<input id="id" name="id" type="hidden" value="$!{abBillNoPage.id}">
	<h2 class="layui-colla-title">#springMessage('bill.accebill.billNoInfo.title')</h2>
	<table class="layui-table">
		<tbody>
		<tr>
			<td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
			<td> <div>$!{abBillNoPage.bankTypeName}</div></td>
			##业务类型
			<td width="8%" class="textRight">#springMessage('table.abAccrecords.briefId')</td>
			<td>$dictTag.get("accebill_billNo_insbriefid","$!{abBillNoPage.busType}")</td>
		</tr>
		<tr>
			##是否汇总认领流水
			<td width="8%" class="textRight">#springMessage('bill.accebill.isSummaryClaimBill')</td>
			<td width="25%">
				$dictTag.get("sf_yn","$!{abBillNoPage.isSummaryClaimBill}")
			</td>
			<td></td>
			<td></td>
		</tr>
		<tr>
			##票号字段
			<td width="8%" class="textRight">#springMessage('bill.accebill.billNumField')</td>
			<td>$dictTag.get("accebill_billNo_billNumField","$!{abBillNoPage.billNumField}")</td>
			##匹配关系
			<td width="8%" class="textRight">#springMessage('table.netbank.nisproject.matchRelation')</td>
			<td>$dictTag.get("accebill_billNo_matchRelation","$!{abBillNoPage.relation}")</td>
		</tr>
		<tr>
			##票号分隔符
			<td width="8%" class="textRight">#springMessage('bill.accebill.billNoSep')</td>
			<td>$!{abBillNoPage.separated}</td>
			##有效标志
			<td width="8%" class="textRight">#springMessage('bill.accebill.validSign')</td>
			<td>$dictTag.get("valid_sign","$!{abBillNoPage.mark}")</td>
		</tr>
		</tbody>
	</table>
	<table class="layui-table border0">
		<tbody>
		<tr>
			<td width="30%"></td>
			<td>
				<button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
			</td>
		</tr>
		</tbody>
	</table>
</form>
	#parse("views/common/footer.vm")
</body>
</html>
<script>
	bt.use(['form','dicts','selectType','bank'], function(){
		var $ = bt.jquery,form = bt.form();
		bt.dicts.init();
		bt.selectType.init();
		form.renderIcon();
		bt.bank.init({
			elem: '.bank',
		});
	});
</script>

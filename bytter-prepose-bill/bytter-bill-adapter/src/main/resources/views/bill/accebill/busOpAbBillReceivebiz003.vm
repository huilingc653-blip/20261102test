#* 
*003提示收票
*#
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.accebill.payeeBillinfo.title')</h2>
		<div class="layui-colla-content layui-show">
			<table class="layui-table">
			<tbody>
			#if($isApprove||$isShow)
			<tr>
				##业务标记
				<td width="20%" class="textRight">#springMessage('table.abVoucherinfo.Business.Brief.Id')</td>
				<td width="30%">
					$!{info.briefIdName}
				</td>
				<td width="20%" class="textRight">#springMessage('bill.accebill.op')</td>
				<td width="30%">
					#if($info.createBy)
					($!{info.createBy})
					#end
					$!{info.createName}
				</td>
			</tr>
			#end
			<tr>
				<td width="20%" class="textRight">#springMessage('table.abAccrecords.applyDate')</td>
				<td width="30%">$!date.format('yyyy-MM-dd',$!{info.bussdt})</td>
				<td width="20%" class="textRight">#springMessage('bill.accebill.signDate')</td>
				<td width="30%">$!date.format('yyyy-MM-dd',$!{info.replyDt})</td>
            </tr>
			<tr>
				<td width="20%" class="textRight">#springMessage('bill.accebill.drawerRmk')</td>
				<td width="30%">$!{info.rmk}</td>
                <td width="20%" class="textRight">#springMessage('bill.accebill.abreceive.insideSing')</td>
                <td width="30%">
					#if($isApprove||$isShow)
					$!{info.insideSingName}
					#else
					<div class="bt-biz-dict" data-type="radio" data-group="ACCEBILL_ABRECEIVE_INSIDESING" data-defaultvalue="$!{info.insideSing}"  data-name="insideSing"  data-biz-name="insideSing"></div>
					#end
                </td>

            </tr>
            </tbody>
            </table>
        </div>
        </div>
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.accebill.drawerinfo.title')</h2>
		<div class="layui-colla-content layui-show">
			<table class="layui-table">
			<tbody>
			<tr>
				<td width="20%" class="textRight">#springMessage('bill.accebill.role')</td>
				<td width="30%">$dictTag.get("AB_BILL_ROLE",$!{info.reqRole})</td>
				<td width="20%" class="textRight">#springMessage('bill.accebill.name')</td>
				<td width="30%">$!{info.reqNm}</td>
			</tr>
			<tr>
				<td width="20%" class="textRight">#springMessage('bill.accebill.cmonid')</td>
				<td width="30%">$!{info.reqCmonid}</td>
				<td width="20%" class="textRight">#springMessage('bill.accebill.bankacc')</td>
				<td width="30%">$!{info.reqAcctId}</td>
            </tr>
			<tr>
				<td width="20%" class="textRight">#springMessage('bill.accebill.bankno')</td>
				<td width="30%">$!{info.reqAcctsvcr}</td>
				<td width="20%" class="textRight">#springMessage('bill.accebill.acctsvcrAg')</td>
				<td width="30%">$!{info.reqAcctsvcrAg}</td>
            </tr>
            </tbody>
            </table>
        </div>
        </div>
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.accebill.checkTakerinfo.title')</h2>
		<div class="layui-colla-content layui-show">
			<table class="layui-table">
			<tbody>
			<tr>
				<td width="20%" class="textRight">#springMessage('bill.accebill.name')</td>
				<td width="30%">$!{info.recNm}</td>
				<td width="20%" class="textRight">#springMessage('bill.accebill.bankacc')</td>
				<td width="30%">$!{info.recAcctId}</td>
            </tr>
			<tr>
				<td width="20%" class="textRight">#springMessage('bill.accebill.bankno')</td>
				<td width="30%">$!{info.recAcctsvcr}</td>
				<td width="20%" class="textRight"></td>
				<td width="30%"></td>
            </tr>
            </tbody>
            </table>
        </div>
        </div>

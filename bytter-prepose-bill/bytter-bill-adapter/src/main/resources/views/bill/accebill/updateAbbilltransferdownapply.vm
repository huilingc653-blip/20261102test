<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <input id="trid" name="trid" type="hidden" value="$!{abBillTransferDownApplyVo.trid}">
    <input id="aid" name="aid" type="hidden" value="$!{abBillTransferDownApplyVo.aid}">
    <input id="billCurrencyOld" type="hidden" value="$!{abBillTransferDownApplyVo.billCurrency}">
    <input id="recordCorpIdOld" type="hidden" value="$!{abBillTransferDownApplyVo.recordCorpId}">
    <input id="recevieBankaccOld" type="hidden" value="$!{abBillTransferDownApplyVo.recevieBankacc}">
    <table class="layui-table">
        <tbody>
        <tr>
		##申请单号
            <td class="textRight">#springMessage('table.abBillTransfer.allocatedCode.apply')</td>
            <input name="allocatedCode" type="hidden" value="$!{abBillTransferDownApplyVo.allocatedCode}">
            <td width="40%">
				$!{abBillTransferDownApplyVo.allocatedCode}
            </td>
		##录入日期
            <td class="textRight">#springMessage('table.abBillTransfer.recordDate')</td>
            <td width="40%">
                <input type="hidden" name="recordDate" data-name="recordDate" class="layui-input bt-biz-dateType" data-today="true"
                       readonly="true"	data-type="date" defaultVal="$!date.format('yyyy-MM-dd',$!{abBillTransferDownApplyVo.recordDate})">
                $!date.format('yyyy-MM-dd',$!{abBillTransferDownApplyVo.recordDate})
            </td>
        </tr>
        <tr>
		##申请单位
            <td class="textRight">#springMessage('table.abBillTransfer.applyCorpId')</td>
            <td >
                <input id="recordCorpName" name="recordCorpName" type="hidden" value="$!{abBillTransferDownApplyVo.recordCorpName}">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-biz-name="recordCorpId"
                         data-name="recordCorpId"
                         data-scope="all"
                         data-required="true"
                         data-defaultvalue="$!{abBillTransferDownApplyVo.recordCorpId}"
                         data-resource="ab:bill:resource:transferdownapply:query"
                         data-callbackData="corpCallback">
                    </div>
                </div>
            </td>
		##申请单位账号
            <td class="textRight">#springMessage('table.abBillTransfer.applyBankAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="recevieBankacc" name="recevieBankacc" data-name="recevieBankacc" data-biz-name="recevieBankacc"
                           data-resource="ab:bill:resource:transferdownapply:query" lay-verify="strlength"  value="$!{abBillTransferDownApplyVo.recevieBankacc}"
                           data-maxlength="30" class="bank layui-input bt-biz-accountTable" data-callback="recevieBankaccCallBack" >
                </div>
            </td>
        </tr>
        <tr>
		##申请金额 allocationMoney
            <td class="textRight">#springMessage('table.abBillTransfer.applyMoney')</td>
            <td>
                <input type="text" id="allocationMoney" data-name="allocationMoney"  class="layui-input bt-biz-moneyType" data-decimal="2"
                       placeholder="#springMessage('table.abBillTransfer.applyMoney')" value="$!{abBillTransferDownApplyVo.allocationMoney}" lay-verify="required">
            </td>
		##票据币别
            <td class="textRight">#springMessage('table.abBillTransfer.billCurrency')</td>
            <td >
                <div class="layui-inline">
                    ##票据不开放其它币别##
                    <input type="hidden" name="billCurrency" value="$!{abBillTransferDownApplyVo.billCurrency}" >
                    <input type="text" class="layui-input" readonly="true" value="#springMessage('table.curName.rmb')" >
                    #*<div type="list" field="billCurrency" name = "billCurrency" fieldHref="${basePath}/basic/business/btcurrency/json"
                         dictField="id" dictText="curName"></div>*#
                </div>
            </td>
        </tr>
        <tr>
		##申请原因
            <td class="textRight">#springMessage('table.abBillTransfer.applyReason')</td>
            <td colspan="3">
                <textarea name="allocationReason" required placeholder="#springMessage('table.abBillTransfer.applyReason')"
                          lay-verify="strlength" data-maxlength="240" class="layui-textarea">$!{abBillTransferDownApplyVo.allocationReason}</textarea>
            </td>
        </tr>
        <br>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="save">#springMessage('common.button.temp')</button>
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <input id="attachmentId" name="attachmentId" type="hidden"  value="$!{abBillTransferDownApplyVo.enclosure}" >
    <div id="uploader" class="layui-input-inline" style="width:100%"></div>
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abbilltransferdownapply.edit.js?_btv=${resourceVersion}"></script>
</html>
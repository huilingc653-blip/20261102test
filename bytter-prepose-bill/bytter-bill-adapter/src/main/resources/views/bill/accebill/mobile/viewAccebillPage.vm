#if($!billInfoList && $billInfoList.size()>0)
	<li class="mui-table-view-cell">
		#springMessage('common.button.billinfo')
	</li>
#end
#foreach($info in $billInfoList)
	<li class="mui-table-view-cell  mui-collapse keep-unfold">
		<a class="mui-navigate-right" href="#">
			#springMessage('bill.accebill.origNo')
			<span class="mui-badge mui-badge-inverted">
				$!{info.origNo}
        </span>
		</a>
		<ul class="mui-table-view H-theme-background-color-white">
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.billType')
				<span class="mui-badge mui-badge-inverted">
					$!{info.billTypeName}
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('table.abVoucherinfo.billFlag')
				<span class="mui-badge mui-badge-inverted">
					$!{info.billFlagName}
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.billSendSign')
				<span class="mui-badge mui-badge-inverted">
					$!{info.sendSignName}
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.billMoney')
				<span class="mui-badge mui-badge-inverted">
					$number.formatNumeric($!{info.billMoney})
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('table.abVoucherinfo.startDate')
				<span class="mui-badge mui-badge-inverted">
					$!{info.startDate}
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('table.abVoucherinfo.endDate')
				<span class="mui-badge mui-badge-inverted">
					$!{info.endDate}
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.rearAccrecords')
				<span class="mui-badge mui-badge-inverted">
					#if($!{info.busTypeBriefId}!="6001")
					$!{info.recNm}
					#end
				</span>
			</li>
	#if($!{info.busTypeBriefId}=="6001")
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.bustype')
			<span class="mui-badge mui-badge-inverted">
				$!{info.briefIdName}
			</span>
		</li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.busStatus')
			<span class="mui-badge mui-badge-inverted">
				#springMessage('bill.accebill.receiveNextEndrose')
			</span>
		</li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.inoptStatus')
			<span class="mui-badge mui-badge-inverted">
			</span>
		</li>
	##应收票据背书状态设置
	#elseif($!{info.briefId}=="010")
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.bustype')
			<span class="mui-badge mui-badge-inverted">
				$!{info.briefIdName}
			</span>
		</li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.busStatus')
			<span class="mui-badge mui-badge-inverted">
				$!{info.busStatusName}
			</span>
		</li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.inoptStatus')
			<span class="mui-badge mui-badge-inverted">
				#if($!{info.sendSign}=="1"&&$!{info.busStatus}==95)
        			$!{info.instructStatusName}
				#end
			</span>
		</li>
	##线下电票设置显示状态信息
	#elseif($!{info.billFlag}==11&&$!{info.sendSign}=="0")
		##开票最终完成设置：应付开票业务完成
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.bustype')
			<span class="mui-badge mui-badge-inverted">
				#if($!{info.busStatus}==95)
					#springMessage('bill.accebill.emitOpenOK')
				#else
					$!{info.briefIdName}
				#end
			</span>
		</li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.busStatus')
			<span class="mui-badge mui-badge-inverted">
				#if($!{info.busStatus}==95)
				#else
					$!{info.busStatusName}
				#end
			</span>
		</li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.inoptStatus')
			<span class="mui-badge mui-badge-inverted">
			</span>
		</li>
	##纸票电票设置显示状态信息
	#elseif($!{info.billFlag}==10||!$!{info.billFlag})
		##退票设置状态信息
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.bustype')
			<span class="mui-badge mui-badge-inverted">
				##退票设置状态信息
					#if($!{info.tpBriefId})
						$!{info.tpBriefIdName}
					#else
					##开票最终完成设置：应付开票业务完成
						#if($!{info.busStatus}==95)
							#springMessage('bill.accebill.emitOpenOK')
						#else
							$!{info.briefIdName}
						#end
					#end
			</span>
		</li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.busStatus')
			<span class="mui-badge mui-badge-inverted">
				##退票设置状态信息
					#if($!{info.tpBriefId})
						$!{info.tpBusStatusName}
					#else
					##开票最终完成设置：应付开票业务完成
						#if($!{info.busStatus}==95)
						#else
							$!{info.busStatusName}
						#end
					#end
			</span>
		</li>
		<li class="mui-table-view-cell">
			#springMessage('bill.accebill.inoptStatus')
			<span class="mui-badge mui-badge-inverted">
			</span>
		</li>
	##线上电票设置显示状态信息
	#else
	##退票设置状态信息
		#if($!{info.tpBriefId})
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.bustype')
				<span class="mui-badge mui-badge-inverted">
					$!{info.tpBriefIdName}
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.busStatus')
				<span class="mui-badge mui-badge-inverted">
					$!{info.tpBusStatusName}
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.inoptStatus')
				<span class="mui-badge mui-badge-inverted">
					#if($!{info.tpBusStatus}==95)
					$!{info.tpInstructStatusName}
        		#end
				</span>
			</li>
		##提示收票设置状态信息
		#elseif($!{info.tsBriefId})
		##提示收票最终完成状态：应付开票业务完成
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.bustype')
				<span class="mui-badge mui-badge-inverted">
					#if($!{info.tsInoptStatus}=="19")
						#springMessage('bill.accebill.emitOpenOK')
					#else
						$!{info.tsBriefIdName}
					#end
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.busStatus')
				<span class="mui-badge mui-badge-inverted">
					#if($!{info.tsInoptStatus}=="19")
					#else
						$!{info.tsBusStatusName}
					#end
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.inoptStatus')
				<span class="mui-badge mui-badge-inverted">
					#if($!{info.tsInoptStatus}=="19")
					#else
						#if($!{info.tsBusStatus}==95)
							$!{info.tsInstructStatusName}
            			#end
					#end
				</span>
			</li>
		##提示承兑设置状态信息
		#elseif($!{info.tcBriefId})
		##提示承兑完成设置：应付承兑完成待提示收票
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.bustype')
				<span class="mui-badge mui-badge-inverted">
					#if($!{info.tcInoptStatus}=="19")
						#springMessage('bill.accebill.emitOpenNextTp')
					#else
						$!{info.tcBriefIdName}
					#end
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.busStatus')
				<span class="mui-badge mui-badge-inverted">
					#if($!{info.tcInoptStatus}=="19")
					#else
					$!{info.tcBusStatusName}
					#end
				</span>
			</li>
			<li class="mui-table-view-cell">
				#springMessage('bill.accebill.inoptStatus')
				<span class="mui-badge mui-badge-inverted">
					#if($!{info.tcInoptStatus}=="19")
					#else
						#if($!{info.tcBusStatus}==95)
							$!{info.tcInstructStatusName}
            			#end
					#end
				</span>
			</li>
		##开票登记设置状态信息
		#else
		##开票登记完成设置：应付开票登记完成待提示承兑
			#if($!{info.inoptStatus}=="19" && $!{info.isEmitBill}=="1")
				<li class="mui-table-view-cell">
					#springMessage('bill.accebill.bustype')
					<span class="mui-badge mui-badge-inverted">
						#springMessage('bill.accebill.emitOpenNextTc')
					</span>
				</li>
				<li class="mui-table-view-cell">
					#springMessage('bill.accebill.busStatus')
					<span class="mui-badge mui-badge-inverted">
					</span>
				</li>
				<li class="mui-table-view-cell">
					#springMessage('bill.accebill.inoptStatus')
					<span class="mui-badge mui-badge-inverted">
					</span>
				</li>
			#else
				<li class="mui-table-view-cell">
					#springMessage('bill.accebill.bustype')
					<span class="mui-badge mui-badge-inverted">
						$!{info.briefIdName}
					</span>
				</li>
				<li class="mui-table-view-cell">
					#springMessage('bill.accebill.busStatus')
					<span class="mui-badge mui-badge-inverted">
						$!{info.busStatusName}
					</span>
				</li>
				<li class="mui-table-view-cell">
					#springMessage('bill.accebill.inoptStatus')
					<span class="mui-badge mui-badge-inverted">
						#if($!{info.busStatus}==95)
            				$!{info.instructStatusName}
            			#end
					</span>
				</li>
			#end
		#end
	#end
		</ul>
	</li>
#end
<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	<table class="layui-table">
		<tr>
			##信用详细信息
			<td colspan="2" align="center">#springMessage('table.config.credit.msg')</td>
		</tr>

		#if(!$!{paymentCredit.billCode})
			<tr>
				##没有查询到支付信用信息，请点击&ldquo;获取最新信息&rdquo;，获取支付信用信息。
				<td colspan="2" align="center"><font color="red" align="center">#springMessage('table.config.credit.head.msg')</font></td>
		<tr>
		#else
			<tr>
				<td class="textRight" width="45%">#springMessage('票据号码')</td>
				<td>$!{paymentCredit.billCode}</td>
			</tr>
			<tr>
				<td class="textRight" >#springMessage('报文返回时间')</td>
				<td>$!{paymentCredit.credtTm}</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('机构名称')</td>
				<td>$!{paymentCredit.nm}</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('组机构代码')</td>
				<td>$!{paymentCredit.cmonid}</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('承兑票据总金额')</td>
				<td>$number.formatNumeric($!{paymentCredit.accptdAmt})</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('结清票据总笔数')</td>
				<td>$!{paymentCredit.pydQty}</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('结清票据总金额')</td>
				<td>$number.formatNumeric($!{paymentCredit.pydAmt})</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('未结清票据总笔数')</td>
				<td>$!{paymentCredit.pdgQty}</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('未结清票据总金额')</td>
				<td>$number.formatNumeric($!{paymentCredit.pdgAmt})</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('拒付票据总笔数')</td>
				<td>$!{paymentCredit.dshnrQty}</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('拒付票据总金额')</td>
				<td>$number.formatNumeric($!{paymentCredit.dshnrAmt})</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('今年拒付总笔数')</td>
				<td>$!{paymentCredit.dshnrQtySncthsyr}</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('今年拒付总金额')</td>
				<td>$number.formatNumeric($!{paymentCredit.dshnrAmtSncthsyr})</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('去年拒付总笔数')</td>
				<td>$!{paymentCredit.dshnrQtySnclastyr}</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('去年拒付总金额')</td>
				<td>$number.formatNumeric($!{paymentCredit.dshnrAmtSnclastyr})</td>
			</tr>
		#end
		<tr>
			<div class="layui-form-item layui-form-submit">
				##支付信用按钮
				<td colspan="2" align="center"><button class="layui-btn" lay-submit="" type="button" onclick="ajaxQuery()" lay-filter="sumbit">#springMessage('table.config.credit.Newmsg')</button>
					<button class="layui-btn layui-btn-primary" onclick="closeForms()">#springMessage('common.button.close')</button></td>
			</div>
		</tr>
	</table>
</form>
	#parse("views/common/footer.vm")
</body>
<script type="text/javascript">

	function ajaxQuery(){
		$.ajax({
			url:basePath+'/bill/accebill/abbillreceivebiz/fastCredit?billCode=$!{billCode}&acctId=$!{acctId}&recId=$!{recId}&msgType=$!{msgType}',
			dataType: 'json',
			type: "post",
			success:function(result){
				if(result.success==true){
					parent.layer.alert(bt.lang(result.attributes.MSG_INFO), {icon: 6});
				}else{
					parent.layer.alert(bt.lang(result.attributes.MSG_INFO), {icon: 2});
				}
			}});


	}

	var closeForms=function(){
		var index = parent.layer.getFrameIndex(window.name); //先得到当前iframe层的索引
		parent.layer.close(index); //再执行关闭 
	}

</script>
</html>

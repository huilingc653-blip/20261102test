<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body style="padding: 0;">
<form id="searchForm" class="layui-form input150-container">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ## 申请单位
                        <td class="textRight" width="8%">#springMessage('bill.accebill.applyCorp')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_applyCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:abemitbillpay:query"
                                     data-callback="applyCorpCallback"
                                >
                                </div>
                            </div>
                        </td>
                        ##票据单位
                        <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-name="corpId"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_corpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:abemitbillpay:query"
                                >
                                </div>
                            </div>
                        </td>
                        ## 业务单位
                        <td class="textRight" width="8%">#springMessage('bill.accebill.busCorp')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_busCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:abemitbillpay:query"
                                >
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##业务人员
                        <td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_busPersonnel"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
                            </div>
                        </td>
                        ##票据号码
                        <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                        <td width="20%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_origNo"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.origNo')">
                            </div>
                        </td>
                        ##票据类型
                        <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                        <td width="20%">
                            <div class=layui-form>
                                <div class=bt-biz-dict data-type="select" data-name="eqi_billType"
                                     data-group="AB_BILL_TYPE">
                                </div>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        ##流通介质
                        <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
                        <td width="20%">
                            <div class=layui-form>
                                <div class=bt-biz-dict data-type="select" data-name="eqi_billFlag"
                                     data-group="AB_BILL_FLAG">
                                </div>
                            </div>
                        </td>
                        ##票据金额
                        <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                        <td>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text"
                                   data-name="geg_billMoney"
                                   data-moneyendid="leg_billMoney"
                                   placeholder="#springMessage('table.abVoucherinfo.billMoney')"/>
                            <span class="date-mid">~</span>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_billMoney" type="text"
                                   data-name="leg_billMoney"
                                   placeholder="#springMessage('table.abVoucherinfo.billMoney')"/>
                        </td>
                        ##开出方式
                        <td class="textRight">#springMessage('table.abVoucherinfoVo.openWay')</td>
                        <td>
                            <div class=layui-form>
                                <div class=bt-biz-dict data-type="select" data-name="eqi_insideSing"
                                     data-group="AB_BILL_OPENWAY">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##承兑人
                        <td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="likes_acceptor"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.acceptor')">
                            </div>
                        </td>
                        ##出票日期
                        <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                        <td>
                            <div class="layui-inline">
                                <div id="startDate"></div>
                            </div>
                        </td>
                        ##出票人
                        <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="likes_payer"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.payer')">
                            </div>
                        </td>

                    </tr>

                    <tr>
                        ##收票人全称
                        <td class="textRight">#springMessage('table.abVoucherinfo.payee')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="likes_payee"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.payee')">
                            </div>
                        </td>
                        ##到期日期
                        <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                        <td>
                            <div class="layui-inline">
                                <div id="endDate"></div>
                            </div>
                        </td>
                        ##业务处理状态
                        <td class="textRight">#springMessage('table.abAccrecords.status')</td>
                        <td>
                            <div class=layui-form>
                                <div class=bt-biz-dict data-type="select" data-name="eqi_status"
                                     data-filterData="96,100" data-group="AB_BILL_AbEmitBillPay_STATUS"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##出票人账号
                        <td class="textRight">#springMessage('table.abVoucherinfo.payeracc')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="likes_payeracc"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.payeracc')">
                            </div>
                        </td>
                        ##出票标志
                        <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND"
                                     data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
                            </div>
                        </td>
                        ##业务批次号
                        <td class="textRight">#springMessage('bill.business.batchNo')</td>
                        <td width="24%">
                            <input type="text" name="likes_batchNo"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('bill.business.batchNo')">
                        </td>
                    </tr>
                    <tr>
                    ##是否允许分包
                        <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND"
                                     data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
                            </div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('table.bill.bankType.payerBankType')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                                     data-method="get"
                                     data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                                     data-inputvalue="inputvalue" data-search="true"></div>
                            </div>
                        </td>
                        <td class="textRight"></td>
                        <td width="24%">

                        </td>
                    </tr>
                    <tr>
                        <td colspan="8" style="text-align: center;">
                            #if($shiro.hasPermission("bill:accebill:abemitbillpay:query"))
                                <button class="layui-btn" lay-submit="" lay-filter="search"
                                        type="button">#springMessage('common.button.search')</button>
                                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                    'common.button.reset')</button>
                            #end
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
<form class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td width="12%" class="textRight">
                #springMessage('table.abVoucherinfo.Business.date')  ## 业务办理日期
            </td>
            <td width="25%">
                <div class=layui-inline>
                    <div class="date-apply"></div>
                </div>
            </td>
            <td width="12%" class="textRight">
            </td>
            <td width="20%">
            </td>
            <td width="12%" class="textRight">
            </td>
            <td width="20%">
            </td>
        </tr>
        <tr>
            <td class="textRight" width="9%">#springMessage('table.fbsBudgetDetail.purpose')</td>
            <td width="15%">
                <div class="layui-input-inline">
                    <input class="layui-input" lay-verify="required" name="payUse" id="payUse" placeholder="#springMessage('table.fbsBudgetDetail.purpose')"/>
                </div>
                <div class="layui-input-inline">
                    <button class="layui-btn" type="button" onclick="batchSetCol('payUse')">#springMessage(
                        'common.button.batchSet')</button>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.settlement.rmk')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input class="layui-input" name="payAbs" id="payAbs" placeholder="#springMessage('table.settlement.rmk')"/>
                </div>
                <div class="layui-input-inline">
                    <button class="layui-btn" type="button" onclick="batchSetCol('payAbs')">#springMessage(
                        'common.button.batchSet')</button>
                </div>
            </td>
            <td width="12%" class="textRight">
            </td>
            <td width="20%">
            </td>
        </tr>
        </tbody>
    </table>
    <br>
</form>
    #if($shiro.hasPermission("bill:accebill:abemitbillpay:query"))
    <table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
        <thead>
        <tr>
            <th>#springMessage('table.abVoucherinfo.billType')</th>
            <th>#springMessage('table.abVoucherinfo.billFlag')</th>
            <th>#springMessage('table.abVoucherinfoVo.openWay')</th>
            <th>#springMessage('bill.accebill.applyCorp')</th>
            <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
            <th>#springMessage('bill.accebill.busCorp')</th>
            <th>#springMessage('bill.accebill.busPersonnel')</th>
            <th>#springMessage('table.abVoucherinfo.payer')</th>
            <th>#springMessage('table.abVoucherinfo.payeracc')</th>
            <th>#springMessage('table.abVoucherinfo.acceptor')</th>
            <th>#springMessage('table.abVoucherinfo.origNo')</th>
            <th>#springMessage('table.abVoucherinfo.billMoney')</th>
            <th>#springMessage('table.abVoucherinfoVice.bailPercent')</th>
            <th>#springMessage('table.abVoucherinfoVice.bailMoney')</th>
            <th>到期解付金额</th>
            <th>#springMessage('table.abVoucherinfo.startDate')</th>
            <th>#springMessage('table.abVoucherinfo.endDate')</th>
            <th>#springMessage('table.abVoucherinfo.payee')</th>
            <th>#springMessage('table.abAccrecords.status')</th>
            <th>#springMessage('table.abVoucherinfo.Business.Brief.Id')</th>
            <th>#springMessage('table.fbsBudgetDetail.payeeAcc')</th>
            <th>#springMessage('table.fbsBudgetDetail.payeeAccName')</th>
            <th>#springMessage('table.nisBillhead.payeeBankCode')</th>
            <th>#springMessage('table.nisBillhead.payeeBank')</th>
            <th>#springMessage('table.nisBillhead.prov')</th>
            <th>#springMessage('table.nisBillhead.city')</th>
            <th>#springMessage('table.fbsBudgetDetail.purpose')</th>
            <th>#springMessage('table.settlement.rmk')</th>
            <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
            <th>#springMessage('bill.business.batchNo')</th>
            <th>#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #end
    #*<div class=layui-form>
        <div class=layui-form-item>
            <div class=layui-inline>
                <div class="date-apply"></div>
            </div>
        </div>
    </div>*#


    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abEmitBillPayApply.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>

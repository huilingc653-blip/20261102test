<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body {
            font-size: 14px;
            padding-bottom: 60px;
        }

        .layui-form-label {
            width: 180px;
        }

        .layui-input-block {
            margin-left: 220px;
        }
    </style>
</head>
<body>
    ##贴现到账
<input type="hidden" id="moneyByDiscountInfo" value="$!{config.accebill.moneyByDiscount}">
<input type="hidden" id="moneyByDiscount1Info" value="$!{config.accebill.moneyByDiscount1}">
<input type="hidden" id="ratesFloatPer1Info" value="$!{config.accebill.ratesFloatPer1}">
<input type="hidden" id="ratesFloatPer2Info" value="$!{config.accebill.ratesFloatPer2}">
    ##到期兑付
<input type="hidden" id="moneyByCashingInfo" value="$!{config.accebill.moneyByCashing}">
<input type="hidden" id="moneyByCashing1Info" value="$!{config.accebill.moneyByCashing1}">
<input type="hidden" id="ratesFloatPer3Info" value="$!{config.accebill.ratesFloatPer3}">
<input type="hidden" id="ratesFloatPer4Info" value="$!{config.accebill.ratesFloatPer4}">

<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <!-- 面板标题 -->
            <h2 class="layui-colla-title">#springMessage('config.accebill.moneyConfig.title')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                        ##贴现到账
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.accebill.moneyByDiscount')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="checkbox" id="moneyByDiscount" name="accebill.moneyByDiscount" value="1"
                                       lay-skin="primary"  #if($config.accebill.moneyByDiscount == 1)checked#end
                                       title="#springMessage('table.abVoucherinfo.billMoney')"
                                       lay-filter="moneyByDiscount">
                                <span class="bill-moneyByDiscount-container">
                                <input type="checkbox" name="accebill.moneyByDiscount1" value="1" lay-skin="primary"
                                       #if($config.accebill.moneyByDiscount1 == 1)checked#end
                                       title="#springMessage('config.accebill.moneyConfig.bankDown')"
                                       id="moneyByDiscount1" lay-filter="moneyByDiscount1">
                                </span>
                            </div>
                            <span class="bill-moneyByDiscount-container">
                            <div class="layui-input-inline">
                                <input type="text" data-name="accebill.ratesFloatPer1" data-biz-name="ratesFloatPer1"
                                       class="layui-input bt-biz-ratioType"
                                       placeholder="#springMessage('table.btBankAcc.ratesFloatPer')"
                                       value="$!{config.accebill.ratesFloatPer1}" id="ratesFloatPer1">
                            </div>
                            <div class="layui-input-inline">#springMessage(
                                'config.accebill.moneyConfig.businessDown')</div>
                            <div class="layui-input-inline">
                                <input type="text" data-name="accebill.ratesFloatPer2" data-biz-name="ratesFloatPer2"
                                       class="layui-input bt-biz-ratioType"
                                       placeholder="#springMessage('table.btBankAcc.ratesFloatPer')"
                                       value="$!{config.accebill.ratesFloatPer2}" id="ratesFloatPer2">
                            </div>
                            </span>
                        </td>
                    </tr>
                        ##托收到账
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.accebill.moneyByCollection')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="checkbox" name="accebill.moneyByCollection" value="1" lay-skin="primary"
                                       #if($config.accebill.moneyByCollection == 1)checked#end
                                       title="#springMessage('table.abVoucherinfo.billMoney')">
                            </div>
                        </td>
                    </tr>
                        ##到期兑付
                    <tr>
                        <td width="20%" class="textRight" rowspan="2">#springMessage('config.accebill.moneyByCashing')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="checkbox" id="moneyByCashing" name="accebill.moneyByCashing" value="1"
                                       lay-skin="primary"
                                       #if($config.accebill.moneyByCashing == 1)checked#end
                                       title="#springMessage('table.abVoucherinfo.billMoney')"
                                       lay-filter="moneyByCashing">
                                <span class="bill-moneyByCashing-container">
                                    <input type="checkbox" name="accebill.moneyByCashing1" value="1" lay-skin="primary"
                                           #if($config.accebill.moneyByCashing1 == 1)checked#end
                                           title="#springMessage('config.accebill.moneyConfig.bankOn')"
                                           id="moneyByCashing1" lay-filter="moneyByCashing1">
                                </span>
                            </div>
                            <span class="bill-moneyByCashing-container">
                                <div class="layui-input-inline">
                                    <input type="text" data-name="accebill.ratesFloatPer3" data-biz-name="ratesFloatPer3"
                                           class="layui-input bt-biz-ratioType"
                                           placeholder="#springMessage('table.btBankAcc.ratesFloatPer')"
                                           value="$!{config.accebill.ratesFloatPer3}" id="ratesFloatPer3">
                                </div>
                                <div class="layui-input-inline ">#springMessage(
                                    'config.accebill.moneyConfig.businessOn')</div>
                                <div class="layui-input-inline">
                                    <input type="text" data-name="accebill.ratesFloatPer4" data-biz-name="ratesFloatPer4"
                                           class="layui-input bt-biz-ratioType"
                                           placeholder="#springMessage('table.btBankAcc.ratesFloatPer')"
                                           value="$!{config.accebill.ratesFloatPer4}" id="ratesFloatPer4">
                                </div>
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="layui-input-inline">
                                <input type="checkbox" id="moneyByPayCashing" name="accebill.moneyByPayCashing" value="1"
                                       lay-skin="primary"
                                       #if($config.accebill.moneyByPayCashing == 1)checked#end
                                       title="#springMessage('票据解付金额')"
                                       lay-filter="moneyByPayCashing">
                            </div>
                            <span class="bill-moneyByPayCashing-container">
                                <div class="layui-input-inline ">#springMessage('config.accebill.upMoney')</div>
                                <div class="layui-input-inline">
##                                    <input type="text" data-name="accebill.ratesFloatPer5" data-biz-name="ratesFloatPer5"
##                                           class="layui-input bt-biz-ratioType"
##                                           placeholder="#springMessage('table.btBankAcc.ratesFloatPer')"
##                                           value="$!{config.accebill.ratesFloatPer5}" id="ratesFloatPer5">
                                     <input type="text" data-name="accebill.upMoney" data-biz-name="upMoney" class="layui-input bt-biz-moneyType"
                                            placeholder="#springMessage('config.accebill.upMoney')" data-biz-name="test"  value="$!{config.accebill.upMoney}"
                                            id="upMoney" data-min="0.01">
                                </div>
                                 <div class="layui-input-inline ">#springMessage('config.accebill.downMoney')</div>
                                <div class="layui-input-inline">
##
                                    <input type="text" data-name="accebill.downMoney" data-biz-name="downMoney" class="layui-input bt-biz-moneyType"
                                           placeholder="#springMessage('config.accebill.downMoney')" data-biz-name="test"  value="$!{config.accebill.downMoney}"
                                           id="downMoney" data-min="0.01">
                                </div>
                            </span>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="20%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage(
                    'common.button.submit')</button>
                <button type="button" class="layui-btn layui-btn-primary" onclick="resetMoneyConfig()">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    var form = {};
    var dicts = {};
    var moneyType, ratioTypeObj;

    bt.use(['form', 'jquery', 'element', 'dicts', 'ratioType','moneyType'], function () {
        $ = bt.jquery;
        ratioType = bt.ratioType.init()
        moneyType = bt.moneyType.init();
        dicts = bt.dicts.init();
        form = bt.form()

        if (!$("#moneyByDiscount").attr('checked')) {
            $('.bill-moneyByDiscount-container').hide()
        }
        if (!$("#moneyByCashing").attr('checked')) {
            $('.bill-moneyByCashing-container').hide()
        }
        if (!$("#moneyByDiscount1").attr('checked')) {
            ratioType.get('ratesFloatPer1').attr('disabled', true)
            ratioType.get('ratesFloatPer2').attr('disabled', true)
        }
        if (!$("#moneyByCashing1").attr('checked')) {
            ratioType.get('ratesFloatPer3').attr('disabled', true)
            ratioType.get('ratesFloatPer4').attr('disabled', true)
        }
        if (!$("#moneyByPayCashing").attr('checked')) {
            $('.bill-moneyByPayCashing-container').hide()
        }

        form.on('submit(configSubmit)', function (data) {
            // 贴现到账组装
            if (data.field['accebill.moneyByDiscount'] == 1 && data.field['accebill.moneyByDiscount1'] == 1) {
                if (data.field['accebill.ratesFloatPer1'] == 0 || data.field['accebill.ratesFloatPer2'] == 0) {
                    layer.alert('银票下浮比率和商票下浮比率不能为空', {icon: 7});
                    return false
                }
            }
            // 到期兑付组装
            if (data.field['accebill.moneyByCashing'] == 1 && data.field['accebill.moneyByCashing1'] == 1) {
                if (data.field['accebill.ratesFloatPer3'] == 0 || data.field['accebill.ratesFloatPer4'] == 0) {
                    layer.alert('银票上浮比率和商票上浮比率不能为空', {icon: 7});
                    return false
                }
            }
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                if (result.success) {
                    location.reload();//重载当前页面
                }
            }, "JSON");
            return false;
        });

        //贴现到账选择
        form.on('checkbox(moneyByDiscount)', function (data) {
            var moneyByDiscountValue = data.elem.checked
            if (moneyByDiscountValue) {
                $('.bill-moneyByDiscount-container').show()
                ratioType.get('ratesFloatPer1').attr('disabled', true)
                ratioType.get('ratesFloatPer2').attr('disabled', true)
            } else {
                $('#moneyByDiscount1').attr('checked', false)
                ratioType.get('ratesFloatPer1').val('')
                ratioType.get('ratesFloatPer2').val('')
                form.render('checkbox')
                $('.bill-moneyByDiscount-container').hide()
            }
        })

        form.on('checkbox(moneyByDiscount1)', function (data) {
            if (data.elem.checked) {
                ratioType.get('ratesFloatPer1').attr('disabled', false)
                ratioType.get('ratesFloatPer2').attr('disabled', false)
            } else {
                ratioType.get('ratesFloatPer1').val('')
                ratioType.get('ratesFloatPer2').val('')
                ratioType.get('ratesFloatPer1').attr('disabled', true)
                ratioType.get('ratesFloatPer2').attr('disabled', true)
            }
        })

        //到期兑付选择
        form.on('checkbox(moneyByCashing)', function (data) {
            var moneyByCashingValue = data.elem.checked
            if (moneyByCashingValue) {
                $('.bill-moneyByCashing-container').show()
                ratioType.get('ratesFloatPer3').attr('disabled', true)
                ratioType.get('ratesFloatPer4').attr('disabled', true)
            } else {
                $('#moneyByCashing1').attr('checked', false)
                ratioType.get('ratesFloatPer3').val('')
                ratioType.get('ratesFloatPer4').val('')
                form.render('checkbox')
                $('.bill-moneyByCashing-container').hide()
            }
        })

        //到期解付金额选择
        form.on('checkbox(moneyByPayCashing)', function (data) {
            var moneyByCashingValue = data.elem.checked
            if (moneyByCashingValue) {
                $('.bill-moneyByPayCashing-container').show()
            } else {
                moneyType.get('upMoney').val('')
                moneyType.get('downMoney').val('')
                form.render('checkbox')
                $('.bill-moneyByPayCashing-container').hide()
            }
        })

        form.on('checkbox(moneyByCashing1)', function (data) {
            if (data.elem.checked) {
                ratioType.get('ratesFloatPer3').attr('disabled', false)
                ratioType.get('ratesFloatPer4').attr('disabled', false)
            } else {
                ratioType.get('ratesFloatPer3').val('')
                ratioType.get('ratesFloatPer4').val('')
                ratioType.get('ratesFloatPer3').attr('disabled', true)
                ratioType.get('ratesFloatPer4').attr('disabled', true)
            }
        })
    });


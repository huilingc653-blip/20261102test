        postBalChartData = function (result) {
            //var data = JSON.parse(result.series);
            setBalChartDiv(result);
        }

        //设置图表Div
        function setBalChartDiv(data) {
            var balChartDivHtml ='';
            var monthDate = $('#monthDate').val().split("-");
            var setDate = monthDate[0]+'.'+monthDate[1];
            for(var i=0;i<data.length;i++){
                //单位名称
                balChartDivHtml += '<div class="fl bt-chart-title-left" id=""style="margin-left: 0.15rem;font-size:0.14rem;color:#333333">';
                balChartDivHtml += data[i].corpName;
                balChartDivHtml += '</div><div  id=""style="margin-right:0.2rem;font-size:0.12rem;color:#999999;float:right">单位:万元</div>';
                balChartDivHtml += '<div class="fl bt-chart-title-left" id=""style="margin-right: 0.6rem;font-size:0.12rem;color:#999999;float:right">'+setDate+'</div>';

                //单位图表数据
                balChartDivHtml += '<canvas id="container'+data[i].corpId+'" style="width:3.7rem;height:2.6rem;margin-bottom: 0.15rem"></canvas>';

            }
            var balChartDiv = document.getElementById("balChartDiv");
            balChartDiv.innerHTML = balChartDivHtml;
            setBalChartData(data);
            seachType=""
        }
        //设置图表数据 根据查询条件动态加载
        function setBalChartData(data) {
            //对比周期（多选）
            var comparedCycle = '';
            $("input[name='comparedCycle']:checked").each(function(i) {
                if(comparedCycle == ''){
                    comparedCycle=$(this).val();
                }else{
                    comparedCycle+=","+$(this).val();
                }
            })
            var params = [];
            for(var i=0;i<data.length;i++){
                params = [];
                //余额
                var object = {};
                if(comparedCycle.indexOf("1") != -1 || comparedCycle==''){
                    object['time'] = '较上月末';
                    object['value'] = data[i].befMonthBal;
                    object['type'] = '余额';
                    params.push(object);
                }
                if(comparedCycle.indexOf("2") != -1 || comparedCycle==''){
                    object = {};
                    object['time'] = '较上季度末';
                    object['value'] = data[i].befQuarterBal;
                    object['type'] = '余额';
                    params.push(object);
                }
                if(comparedCycle.indexOf("3") != -1 || comparedCycle==''){
                    object = {};
                    object['time'] = '较三个月前';
                    object['value'] = data[i].befThreeMonthBal;
                    object['type'] = '余额';
                    params.push(object);
                }
                if(comparedCycle.indexOf("4") != -1 || comparedCycle==''){
                    object = {};
                    object['time'] = '较上年同期';
                    object['value'] = data[i].befYearBal;
                    object['type'] = '余额';
                    params.push(object);
                }
                if(comparedCycle.indexOf("5") != -1 || comparedCycle==''){
                    object = {};
                    object['time'] = '较年初';
                    object['value'] = data[i].yearEarlyBal;
                    object['type'] = '余额';
                    params.push(object);
                }
                //差额
                if(comparedCycle.indexOf("1") != -1 || comparedCycle==''){
                    object = {};
                    object['time'] = '较上月末';
                    object['value'] = data[i].befMonthDifBal;
                    object['type'] = '差额';
                    params.push(object);
                }
                if(comparedCycle.indexOf("2") != -1 || comparedCycle==''){
                    object = {};
                    object['time'] = '较上季度末';
                    object['value'] = data[i].befQuarterDifBal;
                    object['type'] = '差额';
                    params.push(object);
                }
                if(comparedCycle.indexOf("3") != -1 || comparedCycle==''){
                    object = {};
                    object['time'] = '较三个月前';
                    object['value'] = data[i].befThreeMDifBal;
                    object['type'] = '差额';
                    params.push(object);
                }
                if(comparedCycle.indexOf("4") != -1 || comparedCycle==''){
                    object = {};
                    object['time'] = '较上年同期';
                    object['value'] = data[i].befYearDifBal;
                    object['type'] = '差额';
                    params.push(object);
                }
                if(comparedCycle.indexOf("5") != -1 || comparedCycle==''){
                    object = {};
                    object['time'] = '较年初';
                    object['value'] = data[i].yearEarlyDifBal;
                    object['type'] = '差额';
                    params.push(object);
                }
                var datajson = JSON.stringify(params);//JSON.stringify() 方法用于将 JavaScript 值转换为 JSON 字符串。
                var id = 'container'+data[i].corpId;
                //图表对象
                const chart = new F2.Chart({
                    id: id,
                    pixelRatio: window.devicePixelRatio
                });
                //json转换为对象
                const dataArray=JSON.parse(datajson);
                //x轴分类
                var num = 5;
                if(comparedCycle!=''){
                    num=comparedCycle.split(",").length;
                }
                //图表写入
                chart.source(dataArray, {
                    time: {
                        type: 'cat',
                        tickCount: num,
                        range: [ 0, 1 ]
                    },
//                     value: {
//                         tickCount: 5,
//                         formatter: function (ivalue) {
//                             return ivalue + '';
//                         }
//                     }
                });
                chart.axis('time', {
                    line: null,
                    label: function label(text, index, total) {
                        const textCfg = {};
                        if (index === 0) {
                            textCfg.textAlign = 'left';
                        } else if (index === total - 1) {
                            textCfg.textAlign = 'right';
                        }
                        return textCfg;
                    }
                });
                chart.axis('tem', {
                    grid: function grid(text) {
                        if (text === '0%') {
                            return {
                                lineDash: null,
                                lineWidth: 1
                            };
                        }
                    }
                });
                chart.legend({
                    position: 'bottom',
                    offsetY: -5
                });
                chart.line()
                        .position('time*value')
                        .color('type')
                        .shape('smooth');

                chart.render();
            }
        }
        //金额格式化
        function moneyFormat(val){
            if(val=='' || val==null){
                return 0.00;
            }
            //金额转换 元 保留2位小数 并每隔3位用逗号分开 1,234.56
            var str = val.toFixed(2) + '';
            var intSum = str.substring(0,str.indexOf(".")).replace( /\B(?=(?:\d{3})+$)/g, ',' );//取到整数部分
            var dot = str.substring(str.length,str.indexOf("."))//取到小数部分搜索
            var ret = intSum + dot;
            return ret;
        }

        initDate();
        initBal();

    })(document, window);
</script>

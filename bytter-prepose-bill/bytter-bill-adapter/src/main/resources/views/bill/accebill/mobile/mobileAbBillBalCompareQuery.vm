        //初始化图表表数据
        function initBalChart() {

            var billFlag,statisticsMonth,comparedCycle;
            billFlag= $('#billFlag').val();
            statisticsMonth=getDate();
            $("input[name='comparedCycle']:checked").each(function(i) {
                if(comparedCycle == ''){

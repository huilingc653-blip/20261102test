	                                     <div class="ui-col ui-col">
	                                         <div class="bt-card-item" data-value="2">较上季度
	                                         	<input type="checkbox" class="bt-check-over" name="comparedCycle" value="2" data-value="2"/>
	                                         </div>
	                                     </div>
	                                     <div class="ui-col ui-col">
	                                         <div class="bt-card-item" data-value="3">较三个月前
	                                         	<input type="checkbox" class="bt-check-over" name="comparedCycle" value="3" data-value="3"/>
	                                         </div>
	                                     </div>
                                    </div>
						    		<div class="ui-row-flex ui-whitespace">
	                                    <div class="ui-col ui-col">

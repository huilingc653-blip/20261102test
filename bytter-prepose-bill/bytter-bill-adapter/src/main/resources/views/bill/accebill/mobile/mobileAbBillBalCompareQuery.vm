<script src="${basePath}/static/plugins/web-view/webView.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/mobile/js/webViewScriptBridage.js?_btv=${resourceVersion}"></script>
<script>

    var seachType = ""
    window.getBalCompareApp = (data)=>{
        console.log(seachType+"seachType")

        postBalData(data)
        postBalChartData(data)
    }

    window.getBalCompareApSeach = (data)=>{
        seachType = "seach"
        console.log("搜索")
        searchActionCallback(JSON.parse(data))
    }
    (function (doc, win) {
    	F2.track(false);

        $('.ui-tab-nav > li').on('click', function () {
            $(this).addClass('current').siblings('li').removeClass('current');
            $('.ui-tab-content>li').removeClass('bt-show');
            $('.ui-tab-content li').eq($(this).index()).addClass('bt-show');
        });

        //搜索框点击
        $('.ui-searchbar').on('click', function () {
            $('.ui-searchbar-wrap').addClass('focus');
            $('.ui-searchbar-input input').focus();
        });
        $('.ui-searchbar-cancel').on('click', function () {
            $('.ui-searchbar-wrap').removeClass('focus');
        });

        var month = bt.calendar.init({
            elem:'#monthContainer', //组件容器
            value:$('#monthDate').val(),//默认值
            min:'1980', // 最小值，默认为2000
            max:'2030', // 最大值，默认为当前年
            change:function(value){ //点击提交按钮回调方法
            	$('#monthDate').val(value);
            	initBalData();
            }
        })


        //图标tab切换 列表和图表切换
        $('.sp-tab-switch > span').on('click', function () {
            var name = $(this).data('name');
            $(this).addClass('active').siblings('span').removeClass('active');
            if (name == 'list') {
                //列表显示
                $("#dataList").show();
                $("#balDiv").show();
                //图表隐藏
                $("#dataChart").hide();
                $("#balChartDiv").hide();
            } else {
                //列表隐藏
                $("#dataList").hide();
                $("#balDiv").hide();
                //图表显示
                $("#dataChart").show();
                $("#balChartDiv").show();
            }
            //加载数据
            initBalData();
        });

        //弹框选择显示和隐藏
        function showPopup($this, id) {
            if ( $this.parent().hasClass('active')) {
                hidePopup($this);
                return
            }
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
            $this.parent().addClass('active');
            $(id).addClass('show');
        }
        //票据类型
        $("#btn1").click(function () {
            showPopup($(this), '#actionsheet1');
        });
        //统计月份
        $("#btn2").click(function () {
            showPopup($(this), '#actionsheet2');
        });
        //对比周期
        $("#btn3").click(function () {
            showPopup($(this), '#actionsheet3');
        });
        //单位选择
        $("#corpDiv").click(function () {
            openCorpSelectionPage();
        });
        //统计月份 选项确定
        $("#monthDateSubmit").click(function () {
            hidePopup($('#btn2'));
            initBalData();
        });
        //对比周期 选项确定
        $("#submitValue").click(function () {
            hidePopup($('#btn3'));
            initBalData();
        });
        //对比周期 选项清空
        $("#clearValue").click(function () {
            //hidePopup($('#btn3'));
            $("input[name='comparedCycle']").prop("checked",false);
            //initBalData();
        });

        //查询条件下拉框点选项或者点确定时
        $('.popup-block').on('click', '.bt-popup-item', function () {
            var linkId = $(this).parents('.ui-actionsheet').data('link');
            hidePopup($('#' + linkId));
            $('.bt-popup-item').removeClass('active');//清除原来选中的样式
            $(this).addClass('active');//添加文字选中样式
            if(linkId=="btn1"){
                $('#' + linkId).val($(this).text());
                if($(this).text()=="全部"){
                    $('#billFlag').val("");
                }else if($(this).text()=="商票"){
                    $('#billFlag').val("11");
                }else if($(this).text()=="银票"){
                    $('#billFlag').val("10");
                }
            }
            initBalData();
        })

        //弹框隐藏
        function hidePopup($this) {
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
            $this.parent().removeClass('active');
        }

        // 用于记录页面的查询参数
        const searchParams = {
            corpIds: [],
            corpNames: [],
            datePickData: {
                startDate: null,
                endDate: null,
            }
        };

        //单位搜索组件
        function openCorpSelectionPage() {
            setTimeout(function(){
            var data = BTAppBridge.openCorpSelectionPage && BTAppBridge.openCorpSelectionPage('searchActionCallback',{
            		resource: "${balcompareReson}"
                });
            uni.postMessage({
                data:data
            })
            },100);

        }

        /**
         * 搜索回调方法
         * @param data
         */
        window.searchActionCallback = function (data) {
            // 根据data参数，查询数据
            if (data.corpNames && data.corpNames.length > 0) {
               /* let msg = "选择的成员单位名称：" + JSON.stringify(data.corpNames);
                msg = msg + ", 成员单位ID：" + JSON.stringify(data.corpIds)*/
                searchParams.corpNames = data.corpNames;
                $("#corpId").val(data.corpNames);
            }else{
                $("#corpId").val('');
            }
            if (data.corpIds) {
                searchParams.corpIds = data.corpIds;
            }
            initBalData();
        }

        //初始化列表或图表数据
        function initBalData(){

            //判断列表div是否隐藏
            if($("#balDiv").css("display")!="none"){
                initBal();
            }else{
                initBalChart();
            }
        }

        //票据类型选中
        $('#m-t-vt >div .bt-card-item').on('click',function(){
       		$('#m-t-vt >div .bt-card-item').removeClass('active');
          	$(this).addClass('active');
         });

        //对比周期选中
        $('#m-t-ct >div .bt-card-item').on('click',function(){
        	if($(this).hasClass('active')){
        		$(this).children("input[name='comparedCycle']").prop("checked",false);
        	 	$(this).removeClass('active');
        	}else{
        		$(this).children("input[name='comparedCycle']").prop("checked",true);
           	   	$(this).addClass('active');
        	}
         });

         $("#typeRest").click(function () {
         	$('#m-t-vt >div .bt-card-item').removeClass('active');
         	$('#billFlag').val('');
         });

         $("#comparedRest").click(function () {
         	$('#m-t-ct >div .bt-card-item').removeClass('active');
	       	$("input[name='comparedCycle']").prop("checked",false);
			$("input[name='comparedCycle']").val('');
         });

         $("#submitTypeValue").click(function () {
    	   	 $('.ui-actionsheet').removeClass('show');
    		 $('.bt-select-popup').removeClass('active');
    		 $('#billFlag').val($('#m-t-vt >div .bt-card-item.active').data('value'));
    		 initBalData();
         });

         $("#submitComparedValue").click(function () {
    	   	 $('.ui-actionsheet').removeClass('show');
    		 $('.bt-select-popup').removeClass('active');
    		 initBalData();
         });

        /**
         * 初始化日期
         */
        function initDate() {
            //得到当前时间
            var date = new Date();
            //得到当前年份
            var year = date.getFullYear();
            //得到当前月份
            //注：
            //  1：js中获取Date中的month时，会比当前月份少一个月，所以这里需要先加一
            //  2: 判断当前月份是否小于10，如果小于，那么就在月份的前面加一个 '0' ， 如果大于，就显示当前月份
            var month = date.getMonth() + 1 < 10 ? "0" + (date.getMonth() + 1) : (date.getMonth() + 1);
            //得到当前日子（多少号）
            var day = date.getDate() < 10 ? "0" + date.getDate() : date.getDate();
            $('#monthDate').val(year + "-" + month);
            //$('#startDate').val(year+"-01-01");
            //设置input标签的max属性
            $("#monthDate").attr("max", year + "-" + month);
        }

        //获取日期的
        function getDate(){
            var date = new Date();
            var year = date.getFullYear()
            var month = date.getMonth()+1;
            var toDay = date.getDate();
            var setDate;
            var setYear;
            var setMonth;
            if($('#monthDate').val()==null || $('#monthDate').val()==""){
                setYear = year;
                setMonth = month;
            }else{
                setDate = $('#monthDate').val().split("-");
                setYear = setDate[0];
                setMonth = setDate[1];
            }
            var toDate;
            //当前月份，设值为当天
            if(setYear == year && setMonth == month){
                if (month >= 1 && month <= 9) {
                    month = "0" + month;
                }
                if (toDay >= 1 && toDay <= 9) {
                    toDay = "0" + toDay;
                }
                toDate = year +"-"+ month + "-" + toDay;
                $('#monthDate').val(year + "-" + month);
            }else{
                //选择月份，设值最后一天
                var day = new Date(setYear,setMonth,0);
                var endDay = day.getDate();
                toDate = setYear +"-"+ setMonth + "-" + endDay;
            }
            return toDate;
        }



        //初始化列表数据
        function initBal() {
            var billFlag,statisticsMonth,comparedCycle;
            billFlag= $('#billFlag').val();
            statisticsMonth=getDate();
            $("input[name='comparedCycle']:checked").each(function(i) {
                if(comparedCycle == ''){
                    comparedCycle=$(this).val();
                }else{
                    comparedCycle+=","+$(this).val();
                }
            })
            //通过Ajax获取数据
            var url = "/bill/accebill/balCompare/getBalCompareList";

//             $.ajax({
//             	 url:url,//请求地址
//                  type: "POST",
//                  data:'comparedCycle='+comparedCycle+'&billFlag='+billFlag+'&corpId='+searchParams.corpIds+"&statisticsMonth="+statisticsMonth,
//                  dataType: "json",
//                  success: function(result) {
//                 	  setBalDataDiv(result);
//                  }
//             })

            setTimeout(function () {
                var data = BTAppBridge.post(url,{"comparedCycle":comparedCycle,"billFlag":billFlag,"corpId":searchParams.corpIds,"statisticsMonth":statisticsMonth},'postBalData');
             	uni.postMessage({
                    data:data
                })
                },100);
        	postBalData = function (result) {

	            //var data = JSON.parse(result.series);
	            setBalDataDiv(result);
	        }
    }

        //设置列表数据
        function setBalDataDiv(data) {
            if(seachType && seachType != 'seach'){
                return
            }
            //对比周期（多选）
            var comparedCycle = '';
            $("input[name='comparedCycle']:checked").each(function(i) {
                if(comparedCycle == ''){
                    comparedCycle=$(this).val();
                }else{
                    comparedCycle+=","+$(this).val();
                }
            })
            var balDivHtml ='';
            var monthDate = $('#monthDate').val().split("-");
            var setDate = monthDate[0]+'.'+monthDate[1];
            for(var i=0;i<data.length;i++){
                //单位名称
                balDivHtml += '<div class="fl bt-chart-title-left" id=""style="margin-left: 0.15rem;font-size:0.14rem;color:#333333">';
                balDivHtml += data[i].corpName;
                balDivHtml += '</div><div  id=""style="margin-right:0.2rem;font-size:0.12rem;color:#999999;float:right">单位:万元</div>';
                balDivHtml += '<div class="fl bt-chart-title-left" id=""style="margin-right: 0.6rem;font-size:0.12rem;color:#999999;float:right">'+setDate+'</div>';
                //单位表格数据
                balDivHtml += '<table style="font-size:0.14rem;border-collapse: collapse;border-spacing: 0; width: 92%; text-align: center;margin-left: 0.15rem;text-align: center;margin-right: 0.15rem;">';
                //列表头标题
                balDivHtml += '<thead>';
                balDivHtml += '<tr style="width:100%; background: #FFFBDF;color:#333333;height: 0.35rem">';
                //  对比周期
                balDivHtml += '<th style="width:0.92rem;margin-left: 0.15rem;text-align:left">#springMessage('statisticsReport.IntegratedQuery.comparedCycle')</th>';
                //  余额
                balDivHtml += '<th style="width:1.15rem;text-align:right">#springMessage('statisticsReport.IntegratedQuery.balance')</th>';
                //  差额
                balDivHtml += '<th style="width:1.15rem;text-align:right">#springMessage('statisticsReport.IntegratedQuery.differenceBal')</th>';
                //  比例
                balDivHtml += '<th style="width:0.7rem;text-align:right">#springMessage('statisticsReport.IntegratedQuery.proportion')</th>';
                balDivHtml += '</tr>';
                balDivHtml += '</thead>';
                //  列表内容
                balDivHtml += '<tbody style="background: #fff;color:#666666;font-size:0.11rem;">';
                //      较上月末
                if(comparedCycle.indexOf("1") != -1 || comparedCycle==''){
                    balDivHtml += '<tr>' +
                            '<td align="left" class="td">'+'较上月末' +'</td>'+
                            '<td align="right" class="td">'+moneyFormat(data[i].befMonthBal)+'</td>'+
                            '<td align="right" class="td">'+moneyFormat(data[i].befMonthDifBal)+'</td>'+
                            '<td align="right" class="td"> <span class="td"';
                    if(data[i].befMonthProportion>0){
                        balDivHtml += 'style="color:#F96037;">+';
                    }else if(data[i].befMonthProportion<0){
                        balDivHtml += ' style="color:#28DB8D;">';
                    }else{
                        balDivHtml += '>';
                    }
                    balDivHtml += ''+data[i].befMonthProportion+'%  </span></td>';

                }else{
                    comparedCycle+=","+$(this).val();
                }
            })
            //通过Ajax获取数据
            var url = "/bill/accebill/balCompare/getBalCompareList";
             setTimeout(function () {
                var data = BTAppBridge.post(url,{"comparedCycle":comparedCycle,"billFlag":billFlag,"corpId":searchParams.corpIds,"statisticsMonth":statisticsMonth},'postBalChartData');
                uni.postMessage({
                    data:data
                })

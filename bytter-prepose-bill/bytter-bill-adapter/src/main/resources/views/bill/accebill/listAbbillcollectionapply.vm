<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
                    ## 申请单位
                    <td class="textRight">#springMessage('bill.accebill.applyCorp')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_applyCorpId"
                                 data-scope="all"
                                 data-resource="bill:accebill:collectionapply:query"
                                 data-callback="applyCorpCallback"
                            >
                            </div>
                        </div>
                    </td>
                    ## 票据单位
                    <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-name="corpId"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 data-resource="bill:accebill:collectionapply:query"
                                 data-scope="all"
                            >
                            </div>
                        </div>
                    </td>
                    ## 业务单位
                    <td class="textRight" >#springMessage('bill.accebill.busCorp')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_busCorpId"
                                 data-scope="all"
                                 data-resource="bill:accebill:collectionapply:query"
                            >
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##业务人员
                    <td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_busPersonnel"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('bill.accebill.busPersonnel')">
                        </div>
                    </td>
                    ##票据金额
                    <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="geg_billMoney"
                                   autocomplete="off" class="layui-input bt-input-inline  bt-biz-moneyType"
                                   data-moneyendid="endMoney"
                                   placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                            <span class="date-mid">~</span>
                            <input type="text" name="leg_billMoney"
                                   autocomplete="off" class="layui-input bt-input-inline  bt-biz-moneyType"
                                   id="endMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                        </div>
                    </td>
                    ##票据类型
                    <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                    <td width="25%">
                        <div class="bt-biz-dict" data-group="AB_BILL_TYPE" data-name="eqs_billTypeName"
                             data-type="select"></div>
                    </td>
                </tr>
				<tr>
					##流通介质
                    <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
                    <td>
						<div class="bt-biz-dict" data-group="AB_BILL_FLAG" data-name="eqs_billFlagName" data-type="select" ></div>
                    </td>
                    ##出票日期
                    <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                    <td >
                        <div class="layui-inline">
							<input type="text" name="ged_startDate" data-name="ged_startDate" class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date">
                        </div>
						~
                        <div class="layui-inline">
							<input type="text" name="led_startDate"　data-name="led_startDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date">
                        </div>
                    </td>
					##入库库存
                    <td class="textRight">#springMessage('table.abVoucherinfoVice.enterStock')</td>
                    <td >
						<div class="bt-biz-dict" data-group="AB_ENTER_STOCK" data-name="eqs_enterStockName" data-type="select" ></div>
                    </td>
				</tr>

                <tr>
					##票据号码
                    <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_origNo"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
                        </div>
                    </td>
					##到期日期
                    <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                    <td >
						<div class="layui-inline">
							<input type="text" name="ged_endDate" data-name="ged_endDate" class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                        </div>
						~
						<div class="layui-inline">
							<input type="text" name="led_endDate"　data-name="led_endDate" class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                        </div>
					</td>
					##开票人
                    <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
                    <td >
                        <div class="layui-input-inline">
                            <input type="text" name="likes_payer"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payer')">
                        </div>
                    </td>
				</tr>

                <tr>
					##承兑人
                    <td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
                    <td >
                        <div class="layui-input-inline">
                            <input type="text" name="likes_acceptor"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.acceptor')">
                        </div>
                    </td>
					##业务处理状态
                    <td class="textRight">#springMessage('table.abAccrecords.status')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="ABBILL_COLLECTIONAPPLY_STATUS" data-name="eqs_statusName"></div>
                        </div>
                    </td>
					##在线离线标志
                    <td class="textRight">#springMessage('bill.accebill.billSendSign')</td>
                    <td >
                        <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_SEND_SIGN" data-name="eqs_sendSign" ></div>
                    </td>
                </tr>
                <tr>
                    ##出票标志
                    <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
                        </div>
                    </td>
                    ##票据是否允许分包
                    <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND" data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
                        </div>
                    </td>

                    <td width="8%" class="textRight">#springMessage('table.bill.bankType.holderBankType')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                                 data-method="get"
                                 data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                                 data-inputvalue="inputvalue" data-search="true"></div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('table.abVoucherinfo.billType')</th>
		<th>#springMessage('table.abVoucherinfo.billFlag')</th>
        <th>#springMessage('bill.accebill.applyCorp')</th>
        <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
        <th>#springMessage('bill.accebill.busCorp')</th>
        <th>#springMessage('table.btBankAcc.bankTypeId')</th>
        <th>#springMessage('bill.accebill.busPersonnel')</th>
		<th>#springMessage('table.abVoucherinfo.payer')</th>
		<th>#springMessage('table.abVoucherinfo.acceptor')</th>
        <th>#springMessage('table.abAccrecords.cnAccrecords')</th>
        <th>#springMessage('table.abVoucherinfo.origNo')</th>
		<th>#springMessage('table.abVoucherinfo.billMoney')</th>
		<th>#springMessage('table.abVoucherinfo.startDate')</th>
		<th>#springMessage('table.abVoucherinfo.endDate')</th>
		<th>#springMessage('table.abVoucherinfoVice.enterStock')</th>
		<th>#springMessage('accebill.abbillcollectionapply.isOverdue')</th>
		<th>#springMessage('bill.accebill.billSendSign')</th>
        <th>#springMessage('table.abAccrecords.status')</th>
        <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
        <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
        <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>
        <th>#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')</th>
        <th>#springMessage('bill.accebill.attachment')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>

<form id="dataForm" class="layui-form">
    <input type="hidden" id="budgetSel" name="budgetSel" value="$!{budgetSel}">
    <input type="hidden" id="curCode" name="curCode" value="$!{curId}" />
    <input id="collectionItem" name="collectionItem" type="hidden" value="$!{collectionItem}">
    <input id="defItemCode" name="defItemCode" type="hidden" value="$!{defItemCode}">
	##托收说明

                    <div class=layui-inline>
                        <div class=date-single></div>
                    </div>
                </td>
            ##清算方式 SM00线上清算 SM01线下清算
                <td width="8%" class="textRight">#springMessage('table.abDiscount.sttlmmk')</td>
                <td width="25%">
                    <DIV class=layui-inline>
                        <div class="bt-biz-dict" data-group="AB_STTLMMK" data-biz-name="sttlmmk" data-defaultvalue="SM00" data-placeholder="" data-name="sttlmmk" data-type="select" ></div>

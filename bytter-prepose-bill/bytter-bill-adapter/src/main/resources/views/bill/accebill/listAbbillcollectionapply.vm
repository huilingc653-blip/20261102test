            ##逾期原因
                <td width="8%" class="textRight">#springMessage('bill.accebill.abbillcollectionapply.isOverdueRmk')</td>
                <td width="25%">
                    <div class=layui-inline>
                        <input type="text" name="isOverdueRmk" id="isOverdueRmk" autocomplete="off" class="layui-input"
                               lay-verify="strlength" data-maxlength="100" placeholder="#springMessage('bill.accebill.abbillcollectionapply.isOverdueRmk')">
                    </div>
                </td>
            </tr>
            <tr>
                <td class="textRight" width="8%">#springMessage('table.fcSubjectDay.optDate')</td>
                <td width="25%">
                    <div class=layui-inline>
                        <div class=date-single></div>
                    </div>
                </td>
                ##备注
                <td class="textRight">#springMessage('bill.accebill.abbillcollectionapply.rmk')</td>
                <td width="25%">
                    <input type="text" name="rmk" id="rmk" autocomplete="off" class="layui-input"

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
        <tbody>
        <tr>
            ##录入单位
            <td class="textRight">#springMessage('table.abBillTransfer.recordCorpId')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_recordCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:transferdown:query:corpop"
                    >
                    </div>
                </div>
            </td>
            ##下拨金额
            <td class="textRight">#springMessage('table.abBillTransfer.downMoney')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_allocationMoney" data-moneyendid="endMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                </div>
                ~
                <div class="layui-input-inline">
                    <input type="text" name="leg_allocationMoney" id="endMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                </div>
            </td>
            ##业务处理状态
            <td class="textRight">#springMessage('table.abAccrecords.status')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TRANSFERDOWNAPPLY_STATUS" data-name="eqs_statusName"></div>
            </td>
		</tr>
        <tr>
            ##下拨单号
            <td class="textRight">#springMessage('table.abBillTransfer.allocatedCode.down')</td>
            <td width="25%">
                <input type="text" class="layui-input" name="likes_allocatedCode">
            </td>
            ##申请单号
            <td class="textRight">#springMessage('table.abBillTransfer.allocatedCode.apply')</td>
            <td width="25%">
                <input type="text" class="layui-input" name="likes_applyCode">
            </td>
            <td class="textRight"></td>
            <td width="25%"></td>
        </tr>
		<tr>
            <td colspan="6" style="text-align: center;">
				#if($shiro.hasPermission("bill:accebill:abBillRecall:query"))
                <div class="layui-inline">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </div>
        		#end
            </td>
        </tr>
		</tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('table.abAccrecords.businessDate')</th>
        <th>#springMessage('bill.accebill.bustype')</th>
        <th>#springMessage('table.abBillTransfer.allocatedCode.down')</th>
        <th>#springMessage('table.abBillTransfer.allocatedCode.apply')</th>
        <th>#springMessage('table.abBillTransfer.recordCorpId')</th>
        <th>#springMessage('table.abBillTransfer.recevieCorpId')</th>
        #*<th>#springMessage('table.abBillTransfer.billNo')</th>*#
        <th>#springMessage('table.abBillTransfer.recordBankAcc')</th>
        <th>#springMessage('table.abBillTransfer.recevieBankAcc')</th>
        <th>#springMessage('table.abBillTransfer.applyMoney')</th>
        <th>#springMessage('table.abBillTransfer.downMoney')</th>
        <th>#springMessage('table.abBillTransfer.applyReason')</th>
        <th>#springMessage('table.abBillTransfer.downReason')</th>
        <th>#springMessage('table.abBillTransfer.recordDate')</th>
        <th>#springMessage('table.abBillTransfer.billCurrency')</th>
        <th>#springMessage('bill.accebill.busStatus')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillTransferDownQueryDtl.list.js?_btv=${resourceVersion}"></script>
</html>

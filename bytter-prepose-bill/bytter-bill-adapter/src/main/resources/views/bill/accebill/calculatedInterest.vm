                    <input type="text" name="currentMonth" data-biz-name="currentMonth" id="currentMonth" lay-verify="required"
                           class="layui-input bt-biz-dateType" data-type="month">
                </div>
            </td>
        </tr>
        <tr >
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('table.emitBill.bailInterest.calculatedInterest')</button>
                <button type="button" class="layui-btn" onClick="closeWindow();">#springMessage('common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/calculatedInterest.add.js?_btv=${resourceVersion}"></script>
</html>

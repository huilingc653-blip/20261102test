<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody >
        <tr>
            ##月份
            <td width="10%" class="textRight">#springMessage('table.btBankAccDtl.months')</td>
            <td width="20%">

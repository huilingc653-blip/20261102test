<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input name="eqg_bailPercent" data-biz-name="eqg_bailPercent" type="hidden"  value="$!{bailPercent}">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ## 申请单位
                        <td width="8%" class="textRight">#springMessage('bill.accebill.applyCorp')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_applyCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:billbus:query:paycorp"
                                     data-callback="applyCorpCallback"
                                >
                                </div>
                            </div>
                        </td>
                        ## 票据单位
                        <td  width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-name="corpId"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_corpId"
                                     data-resource="bill:accebill:billbus:query:paycorp"
                                     data-scope="all"
                                     data-defaultvalue="$!{corpId}">
                                >
                                </div>
                            </div>
                        </td>
                        ## 业务单位
                        <td  width="8%" class="textRight" >#springMessage('bill.accebill.busCorp')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_busCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:billbus:query:paycorp"
                                >
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##业务人员
                        <td  width="8%" class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_busPersonnel"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
                            </div>
                        </td>
                        ##出票日期
                        <td class="textRight" width="10%">#springMessage('table.abVoucherinfo.startDate')</td>
                        #if($!{corpId} && $!{endDate} && $!{bailPercent} )
                        <td >
                             <div class="layui-inline">
                                 <input type="text" name="ged_startDate" data-biz-name="ged_startDate"  class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date">
                             </div>
                             <span class="date-mid">~</span>
                             <div class="layui-inline">
                                 <input type="text" name="led_startDate" data-name="led_startDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date">
                             </div>
                        </td>
                        #else
                        <td >
                            <div class="layui-inline">
                                <input type="text" name="ged_startDate" data-biz-name="ged_startDate"  class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date" data-today="true">
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" name="led_startDate" data-today="true" data-name="led_startDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date">
                            </div>
                        </td >
                        #end
                    ##票据类型
                        <td width="10%" class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                        <td >
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="mulselect" data-name="ini_billType" data-biz-name="billType"
                                     data-defaultvalue="10,11" data-required="true" data-group="AB_BILL_TYPE">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##票据号码
                        <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="likes_origNo"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
                            </div>
                        </td>
                        ##到期日期
                        <td class="textRight" width="12%">#springMessage('table.abVoucherinfo.endDate')</td>
                        <td >
                            <div class="layui-inline">
                            <input type="text" name="ged_endDate" data-biz-name="ged_endDate"  class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date" value="$!{endDate}">
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                            <input type="text" name="led_endDate" data-name="led_endDate" class="layui-input bt-biz-dateType" id="endDate" data-type="date" value="$!{endDate}">
                            </div>
                        </td>
                        ##流通介质
                        <td  class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
                        <td >
                            <div class=layui-form>
                                <div class="bt-biz-dict" data-type="mulselect" data-name="ini_billFlag" data-biz-name="billFlag"
                                     data-defaultvalue="11,10" data-required="true" data-group="AB_BILL_FLAG">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##是否已付款
                        <td class="textRight">#springMessage('bill.accebill.isPay')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class=bt-biz-dict data-type="select" data-name="eqs_isPay"  data-group="sf_yn"></div>
                            </div>
                        </td>
                        ##付款日期
                        <td class="textRight" width="10%">#springMessage('bill.accbill.payDate')</td>
                        <td >
                            <div class="layui-inline">
                                <input type="text" name="ged_payDate" data-biz-name="ged_payDate"  class="layui-input bt-biz-dateType" data-endid="payDate" data-type="date" >
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" name="led_payDate"  data-name="led_payDate" class="layui-input bt-biz-dateType" id="payDate" data-type="date">
                            </div>
                        </td>
                        ##票据金额
                        <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                        <td>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" type="text" data-name="geg_billMoney"
                                   data-moneyendid="leg_billMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')" />
                            <span class="date-mid">~</span>
                            <input class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_billMoney" type="text"
                                   data-name="leg_billMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')" />
                        </td>
                    </tr>
                    <tr>
                        ##开票完成
                        <td class="textRight">#springMessage('bill.accebill.emitOpenOk')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class=bt-biz-dict data-type="select" data-name="eqs_emitOpenOk"  data-group="sf_yn"></div>
                            </div>
                        </td>
                        ##开票完成日期
                        <td class="textRight" width="10%">#springMessage('bill.accebill.emitOpenDate')</td>
                        <td >
                            <div class="layui-inline">
                                <input type="text" name="ged_emitOpenDate" data-biz-name="ged_emitOpenDate"  class="layui-input bt-biz-dateType" data-endid="emitOpenDate" data-type="date" >
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" name="led_emitOpenDate"  data-name="led_emitOpenDate" class="layui-input bt-biz-dateType" id="emitOpenDate" data-type="date">
                            </div>
                        </td>
                        ##开票方式
                        <td class="textRight">#springMessage('bill.accebill.emitType')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="mulselect" id="emitType" data-group="ACCEBILL_EMIT_TYPE" data-name="ins_emitTypeName" data-biz-name="emitType">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##出票人
                        <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="likes_payer"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payer')">
                            </div>
                        </td>
                        ##收票人
                        <td class="textRight">#springMessage('table.abVoucherinfo.payee')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="likes_payee"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payee')">
                            </div>
                        </td>
                        ##票据异常情况
                            <td class="textRight">#springMessage('bill.accebill.billAnomalies')</td>
                            <td width="24%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-dict" data-type="select" data-group="ACCEBILL_ANOMALIES_TYPE" data-defaultvalue="$!{accebill.billAnomalies}" data-name="ins_billAnomalies" data-filterData="1"></div>
                                </div>
                            </td>
                    </tr>
                    <tr>
                        ##银行类别
                        <td class="textRight">#springMessage('table.btBankAcc.bankTypeId')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json" data-method="get"
                                     data-valuefield="id" data-textfield="typeName" data-callback="bankTypeCallBack" data-name="ins_bankTypeId" data-inputvalue="inputvalue" data-search="true"></div>
                            </div>
                        </td>
                        ##票据单位账号
                        <td class="textRight">#springMessage('table.abVoucherinfoVice.bankAcc')</td>
                        <td width="10%">
                            <div class="layui-input-inline">
                                <input type="text" id="likes_bankAcc" name="likes_bankAcc" data-name="likes_bankAcc" data-biz-name="likes_bankAcc" accountType="2,3"
                                        autocomplete="off"  value="$!{bankAcc}"
                                       class="layui-input bt-biz-accountTable" data-callback="accountCallBack"/>
                            </div>
                        </td>
                        ##是否对内
                        <td class="textRight">#springMessage('bill.accebill.intenal')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class=bt-biz-dict data-type="select" data-name="eqs_insideSing"  data-group="sf_yn"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##出票标志
                        <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
                            </div>
                        </td>
                        ##票据是否允许分包
                        <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND" data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
                            </div>
                        </td>
                        ##子票区间号码
                        <td class="textRight">#springMessage('bill.accebill.sti')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" name="likes_sbbllRngStrtSn"
                                       autocomplete="off" class="layui-input" maxlength="12"
                                       placeholder="#springMessage('table.abVoucherinfo.sbbllRngStrtSn')">
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" name="likes_sbbllRngEndSn"
                                       autocomplete="off" class="layui-input" maxlength="12"
                                       placeholder="#springMessage('table.abVoucherinfo.sbbllRngEndSn')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##收票人账户
                        <td class="textRight">#springMessage('table.abVoucherinfo.payeeacc')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="likes_payeeacc"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.payeeacc')">
                            </div>
                        </td>
                        ##收票银行
                        <td class="textRight">收票银行</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="likes_payeeBankName"
                                       autocomplete="off" class="layui-input" placeholder="收票银行">
                            </div>
                        </td>
                        <td class="textRight">#springMessage('table.abAccrecords.rmk')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="likes_rmk"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.abAccrecords.rmk')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##业务类型
                        <td class="textRight">#springMessage('table.abAccrecords.briefId')</td>
                        <td>
                            ##<div class="layui-input-inline">
                            ##<div class="bt-biz-mulselectType"
                            ##	data-url="${basePath}/bill/accebill/abbillQuery/listBusType"
                            ##	data-valuefield="status"
                            ##	data-textfield="statusname"
                            ##	data-name="ins_briefId" ></div>
                            ##</div>
                            <div class="layui-input-inline">
                                <div class="layui-input-inline bt-biz-dict" data-type="mulselect" data-name="ins_briefId"
                                     data-filterData="6203,8018,8818,8019" data-group="AB_BRIEF_STATUS">
                                </div>
                            </div>
                        </td>
                            ##票据状态
                        <td class="textRight">票据状态</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="layui-input-inline bt-biz-dict" data-type="mulselect" data-name="ins_billStatus"
                                     data-group="AB_BILL_STATUS">
                                </div>
                            </div>
                        </td>
                            ##流通状态
                        <td class="textRight">流通状态</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="layui-input-inline bt-biz-dict" data-type="mulselect" data-name="ins_ebillBlCrclIndc"
                                     data-group="AB_BILL_CRCL_INDCD">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##在线离线标志
                        <td class="textRight">#springMessage('bill.accebill.billSendSign')</td>
                        <td >
                            <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_SEND_SIGN" data-name="eqs_sendSign" ></div>
                        </td>
                        ##付款单号
                        <td class="textRight">#springMessage('table.nisBillhead.billNo')</td>
                        <td>
                            <input type="text" name="likes_payNo"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.nisBillhead.billNo')">
                        </td>
                        ##申请人
                        <td class="textRight">#springMessage('bill.accebill.applyName')</td>
                        <td width="20%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_applyName"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.applyName')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##保证金比例
                        <td class="textRight">#springMessage('table.abVoucherinfoVice.bailPercent')(%)</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="geg_bailPercent" data-biz-name="geg_bailPercent" autocomplete="off" data-decimal="2" data-supermin="0" data-supermax="1"  data-callback="compareBailpercent"
                                       class="layui-input bt-input-inline  bt-biz-rateType" placeholder="#springMessage('table.abVoucherinfoVice.bailPercent')" value="$!{bailPercent}">
                                <span class="date-mid">~</span>
                                <input type="text" name="leg_bailPercent" data-biz-name="leg_bailPercent" autocomplete="off" data-decimal="2" data-supermin="0" data-supermax="1" data-callback="compareBailpercent"
                                       class="layui-input bt-input-inline  bt-biz-rateType" placeholder="#springMessage('table.abVoucherinfoVice.bailPercent')" value="$!{bailPercent}">
                            </div>
                        </td>

                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            <div class="layui-inline">
                                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                                <button type="reset" class="layui-btn layui-btn-primary" data-callback="clearData">#springMessage('common.button.reset')</button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    </div>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('bill.accebill.applyCorp')</th>
        <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
        <th>#springMessage('bill.accebill.busCorp')</th>
        <th>#springMessage('bill.accebill.busPersonnel')</th>
        <th>#springMessage('table.nisBillhead.billNo')</th>
        <th>#springMessage('table.abVoucherinfo.origNo')</th>
        <th>#springMessage('table.abVoucherinfoVice.bankAcc')</th>
        <th>#springMessage('table.abVoucherinfo.billFlag')</th>
        <th>#springMessage('bill.accebill.billType')</th>
        <th>#springMessage('table.abVoucherinfo.payer')</th>
        <th>#springMessage('bill.accebill.payBank')</th>
        <th>#springMessage('bill.accebill.emitType')</th>
        <th>#springMessage('bill.accebill.emitGuandisSign')</th>
        #*<th>#springMessage('table.abVoucherinfo.startOrSignDate')</th>*#
        <th>#springMessage('出票日期')</th>
        <th>#springMessage('table.abVoucherinfo.endDate')</th>
        <th>#springMessage('table.abVoucherinfo.payee')</th>
        <th>#springMessage('table.abVoucherinfo.payeeacc')</th>
        <th>收票行号</th>
        <th>收票银行</th>
        <th>#springMessage('bill.accebill.applyName')</th>
        <th>#springMessage('bill.accebill.money')</th>
        <th>#springMessage('table.abVoucherinfoVice.bailPercent')</th>
        <th>#springMessage('table.abVoucherinfoVice.bailMoney')</th>
        <th>到期解付金额</th>
        <th>#springMessage('bill.accebill.isPay')</th>
        <th>#springMessage('bill.accbill.payDate')</th>
        <th>#springMessage('bill.accebill.localBank')</th>
        <th>#springMessage('bill.accebill.billAnomalies')</th>
        <th>#springMessage('bill.accebill.dueRemind')</th>
        <th>#springMessage('bill.accebill.emitOpenOk')</th>
        #*<th>#springMessage('bill.accebill.emitOpenDate')</th>*#
        <th>#springMessage('开票完成日期(票据签收日期)')</th>
        <th>#springMessage('table.abVoucherinfo.billStatus')</th>
        <th>#springMessage('流通状态')</th>
        <th>#springMessage('bill.accebill.bustype')</th>
        <th>#springMessage('bill.accebill.billSendSign')</th>
        <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
        <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
        <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
        <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>
        <th>#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')</th>
        <th>#springMessage('table.abAccrecords.rmk')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/billPayAccount.list.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="isCredit" value="$!{isCredit}"/>
    <input type="hidden" id="isDisCountCredit" value="$!{isDisCountCredit}"/>
    <table class="layui-table">
        <tbody>
        <tr>
            ## 申请单位
            <td class="textRight">#springMessage('bill.accebill.applyCorp')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_applyCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:abBillDiscountRelease:query"
                         data-callback="applyCorpCallback"
                    >
                    </div>
                </div>
            </td>
            ## 票据单位
            <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-name="corpId"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="bill:accebill:abBillDiscountRelease:query"
                         data-scope="all"
                    >
                    </div>
                </div>
            </td>
            ## 业务单位
            <td class="textRight">#springMessage('bill.accebill.busCorp')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_busCorpId"
                         data-scope="all"
                         data-resource="bill:accebill:abBillDiscountRelease:query"
                    >
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##业务人员
            <td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_busPersonnel"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('bill.accebill.busPersonnel')">
                </div>
            </td>
            ##票据号码
            <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_origNo" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.abVoucherinfo.origNo')">
                </div>
            </td>
            ##票据类型
            <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE" data-defaultvalue="11"
                         data-name="eqi_billType" disabled="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##流通介质
            <td class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_FLAG"
                         data-defaultvalue="$!{abReceiveBillPage.billFlag}" data-name="eqi_billFlag"></div>
                </div>
            </td>
            ##票据金额
            <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_billMoney" class="layui-input bt-input-inline  bt-biz-moneyType"
                           data-moneyendid="endMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_billMoney" class="layui-input bt-input-inline  bt-biz-moneyType"
                           id="endMoney" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                </div>
            </td>
            ##状态
            <td class="textRight">#springMessage('table.abAccrecords.status')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" id="releaseState" name="releaseState" data-type="select"
                         data-group="AB_ABBILLDISCOUNT_RELEASE_STATUS" data-defaultvalue="$!{abReceiveBillPage.status}"
                         data-name="releaseState"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##承兑人
            <td class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_acceptor" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.abVoucherinfo.acceptor')">
                </div>
            </td>
            ##出票日期
            <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_startDate" class="layui-input bt-input-inline  bt-biz-dateType"
                           data-endid="startDate" placeholder="#springMessage('table.abVoucherinfo.startDate')">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_startDate" class="layui-input bt-input-inline  bt-biz-dateType"
                           id="startDate" placeholder="#springMessage('table.abVoucherinfo.startDate')">
                </div>
            </td>
            ##出票人
            <td class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_payer" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.abVoucherinfo.payer')">
                </div>
            </td>
        </tr>
        <tr>
            ##收票人
            <td class="textRight">#springMessage('table.abVoucherinfo.payee')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_signerok"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.abVoucherinfo.payee')">
                </div>
            </td>
            ##到期日期
            <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_endDate" class="layui-input bt-input-inline  bt-biz-dateType"
                           data-endid="endDate" placeholder="#springMessage('table.abVoucherinfo.endDate')">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_endDate" class="layui-input bt-input-inline  bt-biz-dateType"
                           id="endDate" placeholder="#springMessage('table.abVoucherinfo.endDate')">
                </div>
            </td>
            ##出票标志
            <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND"
                         data-defaultvalue="" data-name="eqs_newStmIssuofpprInd"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##票据是否允许分包
            <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND"
                         data-defaultvalue="" data-name="eqs_blgrdbagcrclPrmtInd"></div>
                </div>
            </td>
            <td width="8%" class="textRight">#springMessage('table.bill.bankType.holderBankType')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                         data-method="get"
                         data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #if($shiro.hasPermission("bill:accebill:abBillDiscountRelease:query"))
    <table id="appTable" class="layui-table" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.abVoucherinfo.billType')</th>
            <th>#springMessage('table.abVoucherinfo.billFlag')</th>
            <th>#springMessage('bill.accebill.applyCorp')</th>
            <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
            <th>#springMessage('bill.accebill.busCorp')</th>
            <th>#springMessage('bill.accebill.busPersonnel')</th>
            <th>#springMessage('table.abVoucherinfo.payer')</th>
            <th>#springMessage('table.abVoucherinfo.acceptor')</th>
            <th>#springMessage('table.abAccrecords.cnAccrecords')</th>
            <th>#springMessage('table.abVoucherinfo.origNo')</th>
            <th>#springMessage('table.abVoucherinfo.billMoney')</th>
            <th>#springMessage('table.abVoucherinfo.startDate')</th>
            <th>#springMessage('table.abVoucherinfo.endDate')</th>
            <th>#springMessage('table.abDiscount.discountDate')</th>
            <th>#springMessage('ab.bill.abbilldiscount.RecType')</th>
            <th>#springMessage('table.ratBkrationDisDetail.superProcessMoney')</th>
            <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>
            <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
            <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
            <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>
            <th>#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')</th>
            <th>#springMessage('table.abAccrecords.status')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #end
<form id="dataForm" class="layui-form">
    <div class="layui-inline">

    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillDiscountRelease.list.js?_btv=${resourceVersion}"></script>
</html>

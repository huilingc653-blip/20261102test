<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##入库库存
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.enterStock')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-placeholder="" data-type="select"
                                     data-group="AB_ENTER_STOCK" data-name="eqs_enterStock" data-biz-name="enterStock"
                                     data-defaultvalue="10" data-callback="change"></div>
                            </div>
                        </td>
                        ##票据金额
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                        <td width="25%">
                            <input type="text" class="layui-input bt-input-inline bt-biz-moneyType" id="geg_billMoney"
                                   data-name="geg_billMoney" data-moneyendid="leg_billMoney"
                                   placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                            <span class="date-mid">~</span>
                            <input type="text" class="layui-input bt-input-inline bt-biz-moneyType" id="leg_billMoney"
                                   data-name="leg_billMoney"
                                   placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                        </td>
                        ##票据类型
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE"
                                     data-defaultvalue="$!{abReceiveBillPage.billType}" data-name="eqi_billType"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 申请单位
                        <td class="textRight">#springMessage('bill.accebill.applyCorp')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_applyCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:abbillpledgeapply:query"
                                     data-callback="applyCorpCallback">
                                </div>
                            </div>
                        </td>
                        ## 票据单位
                        <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-name="corpId"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_corpId"
                                     data-resource="bill:accebill:abbillpledgeapply:query"
                                     data-scope="all"
                                >
                                </div>
                            </div>
                        </td>
                        ## 业务单位
                        <td class="textRight" >#springMessage('bill.accebill.busCorp')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_busCorpId"
                                     data-scope="all"
                                     data-resource="bill:accebill:abbillpledgeapply:query"
                                >
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##票据号码
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_origNo" autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.origNo')">
                            </div>
                        </td>
                        ##出票日期
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                        <td width="25%">
                            <div id="startDate"></div>
                        </td>
                        ##出票人
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.payer')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_payer" autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.payer')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##业务人员
                        <td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_busPersonnel"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.busPersonnel')">
                            </div>
                        </td>
                        ##到期日期
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                        <td width="25%">
                            <div id="endDate"></div>
                        </td>
                        ##承兑人
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.acceptor')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_acceptor" autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.acceptor')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##流通介质
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfo.billFlag')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_FLAG"
                                     data-defaultvalue="$!{abReceiveBillPage.billFlag}" data-name="eqi_billFlag"></div>
                            </div>
                        </td>
                        ##票据状态
                        <td width="8%" class="textRight">#springMessage('table.abAccrecords.status')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select"
                                     data-group="AB_BILL_ACCRECORDS_PLEDGEAPPLY_STATUS"
                                     data-defaultvalue="$!{abReceiveBillPage.status}" data-name="eqi_status"></div>
                            </div>
                        </td>
                        ##票据来源
                        <td width="8%" class="textRight">#springMessage('table.abVoucherinfoVice.billSource')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_SOURCE"
                                     data-defaultvalue="$!{abReceiveBillPage.billSource}"
                                     data-name="eqi_billSource"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##出票标志
                        <td class="textRight">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND"
                                     data-defaultvalue="$!{abReceiveBillPage.newStmIssuofpprInd}"
                                     data-name="eqs_newStmIssuofpprInd"></div>
                            </div>
                        </td>
                        ##票据是否允许分包
                        <td class="textRight">#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
                        <td width="24%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND"
                                     data-defaultvalue="$!{abReceiveBillPage.blgrdbagcrclPrmtInd}"
                                     data-name="eqs_blgrdbagcrclPrmtInd"></div>
                            </div>
                        </td>
                        <td width="8%" class="textRight">#springMessage('table.bill.bankType.holderBankType')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                                     data-method="get"
                                     data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                                     data-inputvalue="inputvalue" data-search="true"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##子票区间号码
                        <td class="textRight">#springMessage('bill.accebill.sti')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" name="likes_sbbllRngStrtSn"
                                       autocomplete="off" class="layui-input" maxlength="12"
                                       placeholder="#springMessage('table.abVoucherinfo.sbbllRngStrtSn')">
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" name="likes_sbbllRngEndSn"
                                       autocomplete="off" class="layui-input" maxlength="12"
                                       placeholder="#springMessage('table.abVoucherinfo.sbbllRngEndSn')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            #if($shiro.hasPermission("bill:accebill:abbillpledgeapply:query"))
                                <div class="layui-inline">
                                    <button class="layui-btn" lay-submit="" lay-filter="search"
                                            type="button">#springMessage('common.button.search')</button>
                                    <button type="reset" class="layui-btn layui-btn-primary"
                                            onclick="resetUpdate()">#springMessage('common.button.reset')</button>
                                </div>
                            #end
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
<div>
    #if($shiro.hasPermission("bill:accebill:abbillpledgeapply:query"))
        <table id="appTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('table.abVoucherinfo.billType')</th>
                <th>#springMessage('table.abVoucherinfo.billFlag')</th>
                <th>#springMessage('bill.accebill.applyCorp')</th>
                <th>#springMessage('table.abVoucherinfoVo.corpId')</th>
                <th>#springMessage('bill.accebill.busCorp')</th>
            <th>#springMessage('table.btBankAcc.bankTypeId')</th>
            <th>#springMessage('bill.accebill.busPersonnel')</th>
                <th>#springMessage('table.abVoucherinfo.payer')</th>
                <th>#springMessage('table.abVoucherinfo.acceptor')</th>
                <th>#springMessage('table.abVoucherinfo.origNo')</th>
                <th>#springMessage('table.abVoucherinfo.billMoney')</th>##票据金额
                <th>#springMessage('table.abVoucherinfo.startDate')</th>
                <th>#springMessage('table.abVoucherinfo.endDate')</th>
                <th>#springMessage('table.abVoucherinfo.payee')</th>
                <th>#springMessage('table.abAccrecords.cnAccrecords')</th>
                <th>#springMessage('table.abAccrecords.status')</th>
                <th>#springMessage('table.abVoucherinfoVice.enterStock')</th>
                <th>#springMessage('table.abVoucherinfo.Business.Brief.Id')</th>
                <th>#springMessage('table.abVoucherinfoVice.billSource')</th>
                <th>#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</th>##出票标志
                <th>#springMessage('table.abVoucherinfo.blgrdbagcrclPrmtInd')</th>##是否允许分包
                <th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>##子票区间开始序号
                <th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>##子票区间结束序号
                <th>#springMessage('table.abVoucherinfo.blStdAmt')</th>##标准金额
                <th>#springMessage('table.abVoucherinfoVice.socCode')</th>##票据单位统一识别号码
                <th>#springMessage('table.abVoucherinfoVice.transMoney')</th>##交易金额
                <th>#springMessage('bill.accebill.attachment')</th>##附件
                <th>#springMessage('common.table.thead.operation')</th>##操作
            </tr>
            </thead>
        </table>
    #end


<form class="layui-form" id="saveForm">
    <table class="layui-table">
        <tbody>
        <tr>
            ##是否内部质押
            <td width="10%" class="textRight">#springMessage('bill.abBillPledgeApply.interiorApply')</td>
            <td width="23%" align="left">
                <div class="bt-biz-dict" data-type="radio" data-group="AB_ABBILLPLEDGEAPPLY_INTERIORAPPLY"
                     data-defaultvalue="1" data-name="interiorApply" data-biz-name="interiorApply"
                     data-callback="selectInteriorApplyType" id="interiorApply"></div>
                #*	<input type="radio" name="interiorApply" checked="checked" title="#springMessage('abBillPledgeApply.interiorApply.yes')" value="1" lay-filter = "interiorApply">
                    <input type="radio" name="interiorApply"  title="#springMessage('abBillPledgeApply.interiorApply.no')" value="0" lay-filter = "interiorApply"  />*#
            </td>
            ##质权人单位
            <td width="10%" class="textRight" id="corpDiv">
                <div class="layui-input-inline">
                    <span id="spanCorpId" style="color:red">*</span>
                    #springMessage('bill.abBillPledgeApply.pledgeeCorp')
                </div>
            </td>
            ##质权人单位
            <td width="23%" id="pledgeeCorpid">
                <input type="hidden" name="pledgeeCorpid"/>
                <div class="layui-input-inline" id="corpId">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="corpId"
                         data-scope="all"
                         data-placeholder="#springMessage('bill.abBillPledgeApply.pledgeeCorp')"
                         data-callbackData="corpCallback">
                    </div>
                </div>
            </td>
            ##质权人识别类型
            <td width="10%" class="textRight">#springMessage('bill.abBillPledgeApply.pledgeeType')</td>
            <td width="25%">
                <div class="layui-input-inline" id="pledgeeType">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_BL_ID_TPCD"
                         data-defaultvalue="DT02" data-name="eqi_pledgeeType"></div>
                </div>
            </td>
            <td width="10%" class="textRight" id="corp1" hidden></td>
            <td width="23%" id="corp2" hidden>
            </td>
        </tr>
        <tr>
            ##质权人账号
            <td width="10%" class="textRight"><span id="spanAcc" style="color:red">*</span>#springMessage(
                'bill.abBillPledgeApply.pledgeeAcc')</td>
            <td width="23%">
                <div class="layui-input-inline" id="pledgeeAccDiv">
                    <input type="text" id="pledgeeAcc" name="pledgeeAcc" data-name="pledgeeAcc"
                           data-biz-name="pledgeeAcc"
                           class="bank layui-input bt-biz-accountTable" data-callback="accountPayeeCallBack"
                           placeholder="#springMessage('bill.abBillPledgeApply.pledgeeAcc')">
                </div>
                <div class="layui-input-inline" id="payeeAccDiv" style="display:none">
                    <input type="text" id="payeeAcc" name="payeeAcc"
                           class="bank layui-input" placeholder="#springMessage('bill.abBillPledgeApply.pledgeeAcc')">
                </div>
                <div class="layui-input-inline" id="pledgeeNameDiv" style="display:none">
                    <button class="layui-btn bt-biz-externalCorpBankAcc" type="button" id="bt-biz-externalCorpBankAcc"
                            data-callback="bt.bailCorpCallback">#springMessage('common.button.external')</button>
                    <button class="layui-btn bt-biz-bankInfo" type="button"
                            data-callback="bt.bailBankInfoCallback">#springMessage('common.button.bank')</button>
                </div>
            </td>
            ##质权人
            <td width="10%" class="textRight"><span id="spanName" style="color:red">*</span>#springMessage(
                'bill.abBillPledgeApply.pledgeeName')</td>
            <td width="23%">
                <div class="layui-input-inline" id="pledgeeDiv">
                    <input type="text" id="pledgeeName" name="pledgeeName" readonly="true" lay-verify="strlength"
                           data-maxlength="240"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('bill.abBillPledgeApply.pledgeeName')">
                </div>
                <div class="layui-input-inline" id="payeeAccNameDiv" style="display:none">
                    <input type="text" id="payeeAccName" name="payeeAccName" lay-verify="strlength" data-maxlength="240"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('bill.abBillPledgeApply.pledgeeName')">
                </div>
            </td>
            ##质权人开户行行号
            <td width="10%" class="textRight"><span id="spanBankNo" style="color:red">*</span>#springMessage(
                'bill.accebill.update.bank')</td>
            <td width="23%">
                <div class="layui-input-inline" id="pledgeeBankNoDiv">
                    <input type="text" id="pledgeeBankNo" name="pledgeeBankNo" lay-verify="strlength"
                           data-maxlength="12" autocomplete="off" readonly="true" class="layui-input"
                           placeholder="#springMessage('bill.abBillPledgeApply.pledgeeBankAcc')">
                </div>
                <div class="layui-input-inline" id="payeeBankCodeDiv" style="display:none">
                    <input type="text" id="payeeBankCode" name="payeeBankCode" readonly="true" lay-verify="strlength"
                           data-maxlength="12"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('bill.abBillPledgeApply.pledgeeBankAcc')">
                    <div class="bt-div-search" id="selPayeeBankButDiv" style="display:none">
                        <button class="bt-biz-bankInfo" type="button" data-callback="bt.bankinfoCallback"><i
                                class="layui-icon">&#xe615;</i></button>
                    </div>
                </div>
                ##<div class="layui-input-inline" id="selPayeeBankButDiv" style="display:none">
                ##	<button class="layui-btn bt-biz-bankInfo" type="button" data-callback="bt.bankinfoCallback">#springMessage('common.button.select')</button>
                ##</div>
                ##								</td>
                ##							##质权人开户行行名
                ##								<td width="10%" class="textRight"><span id="spanBankName" style="color:red">*</span>#springMessage('bill.abBillPledgeApply.pledgeeBankName')</td>
                ##								<td width="23%">
                <div class="layui-input-inline" id="pledgeeBankNameDiv">
                    <input type="text" id="pledgeeBankName" name="pledgeeBankName" readonly="true" autocomplete="off"
                           class="layui-input" lay-verify="strlength" data-maxlength="150"
                           placeholder="#springMessage('bill.abBillPledgeApply.pledgeeBankName')">
                </div>
                <div class="layui-input-inline" id="payeeBankDiv" style="display:none">
                    <input type="text" id="payeeBank" name="payeeBank" lay-verify="strlength" data-maxlength="150"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('bill.abBillPledgeApply.pledgeeBankName')">
                </div>
            </td>
        </tr>
        <tr>
            ##备注
            <td width="10%" class="textRight">#springMessage('table.abAccrecords.rmk')</td>
            <td width="23%"><input type="text" id="rmk" name="rmk" lay-verify="strlength" data-maxlength="100"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.abAccrecords.rmk')">
            </td>
            ##业务办理日期
            <td width="10%" class="textRight">#springMessage('table.abAccrecords.businessDate')</td>
            <td width="23%">
                <div class="layui-input-inline">
                    <input type="text" name="businessDate" data-name="businessDate" class="layui-input bt-biz-dateType"
                           data-today="true"
                           data-type="date" value="$!{abBillPledgeApplyVo.businessDate}">
                </div>
            </td>
            <td width="10%" class="textRight"></td>
            <td width="23%">
            </td>
            <td width="10%" class="textRight"></td>
            <td width="23%">
            </td>
        </tr>
        </tbody>
    </table>
    <br>
</form>
</div>
    #parse("views/common/footer.vm")
    #caDataHidden()
    #caDataScript()
</body>
<script src="${basePath}/static/modules/sys/blackWhite/blackWhiteBase.check.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abBillPledgeApply.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>

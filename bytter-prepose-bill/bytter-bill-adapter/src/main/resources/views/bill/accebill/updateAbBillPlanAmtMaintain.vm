<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form">
    <input type="hidden" name="id" value="$!{planAmtPage.id}">
    <input type="hidden" id="showAllMonday" value="$!{showAllMonday}"/>
    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            <td class="textRight" width="15%">单位</td>
            <td width="40%" colspan="3">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-biz-name="corpId"
                         data-scope="all"
                         data-required="true"
                         data-defaultvalue="$!{planAmtPage.corpId}"
                         data-resource="bill:accebill:credit:maintain:query"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">银行名称</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType"
                         data-url="${basePath}/basic/business/btbanktype/json"
                         data-method="get"
                         data-valuefield="id"
                         data-textfield="typeName"
                         data-name="bankTypeId"
                         data-biz-name="bankTypeId"
                         data-required="true"
                         data-defaultvalue="$!{planAmtPage.bankTypeId}"
                         data-inputvalue="inputvalue"
                         data-search="true"></div>
                </div>
            </td>
            <td class="textRight">授信类型</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="bill:accebill.creditType"
                         data-name="creditType" data-biz-name="creditType"
                         data-defaultvalue="$!{planAmtPage.creditType}" data-required="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">周开始日</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" class="layui-input" name="weekStartDay" id="weekStartDayId" lay-verify="required"
                           value="$!date.format('yyyy-MM-dd',$!{planAmtPage.weekStartDay})">
                </div>
            </td>
            <td class="textRight">周结束日</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" class="layui-input" name="weekEndDay" id="weekEndDayId" lay-verify="required"
                           value="$!date.format('yyyy-MM-dd',$!{planAmtPage.weekEndDay})" readonly="readonly">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">本周计划开票金额</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text"
                           class="layui-input bt-biz-moneyType"
                           lay-verify="required|number2"
                           data-name="currWeekBillMoney"
                           data-biz-name="currWeekBillMoney"
                           data-min="0"
                           data-minus="true"
                           value="$!{planAmtPage.currWeekBillMoney}"
                           autocomplete="off">
                </div>
            </td>
            <td class="textRight">下周计划开票金额</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text"
                           class="layui-input bt-biz-moneyType"
                           lay-verify="required|number2"
                           data-name="nextWeekBillMoney"
                           data-biz-name="nextWeekBillMoney"
                           data-min="0"
                           data-minus="true"
                           value="$!{planAmtPage.nextWeekBillMoney}"
                           autocomplete="off">
                </div>
            </td>
        </tr>
        </tbody>
    </table>
    <div style="text-align: center; padding-top: 10px;">
        <button type="button" class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
            'common.button.submit')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/accebill/abBillPlanAmtMaintain.edit.js?_btv=${resourceVersion}"></script>
</html>
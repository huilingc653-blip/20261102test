#* 
*6204 票据下拨
*#
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<div class="layui-collapse">
		#if($!{applyInfo})
		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('bill.accebill.transferdownapply.title')</h2>
			<div class="layui-colla-content layui-show">
				<table class="layui-table">
					<tbody>
					##申请单号          table.abBillTransfer.allocatedCode.apply
					##申请单位          table.abBillTransfer.applyCorp
					<tr>
						<td width="20%" class="textRight">#springMessage('table.abBillTransfer.allocatedCode.apply')</td>
						<td width="30%">$!{applyInfo.allocatedCode}</td>
						<td width="20%" class="textRight">#springMessage('table.abBillTransfer.applyCorp')</td>
						<td width="30%">$!{applyInfo.recordCorpName}</td>
					</tr>
					##申请单位账号  table.abBillTransfer.applyBankAcc
					##申请金额      table.abBillTransfer.applyMoney
					<tr>
						<td width="20%" class="textRight">#springMessage('table.abBillTransfer.applyBankAcc')</td>
						<td width="30%">$!{applyInfo.recevieBankacc}</td>
						<td width="20%" class="textRight">#springMessage('table.abBillTransfer.applyMoney')</td>
						<td width="30%">
							$number.formatNumeric($!{applyInfo.allocationMoney})
						</td>
					</tr>
					##申请原因          table.abBillTransfer.applyReason
					##业务办理日期  table.abVoucherinfo.Business.date
					<tr>
						<td width="20%" class="textRight">#springMessage('table.abBillTransfer.allocationReason')</td>
						<td width="30%">$!{applyInfo.allocationReason}</td>
						<td width="20%" class="textRight">#springMessage('table.abVoucherinfo.Business.date')</td>
						<td width="30%">$!date.format('yyyy-MM-dd',$!{applyDate})</td>
					</tr>
					##上级中心单位   table.abBillTransfer.applyReason
					#*<tr>
						<td width="20%" class="textRight">#springMessage('table.abBillTransfer.netCorpName')</td>
						<td width="30%">$!{applyInfo.recevieCorpName}</td>
						<td width="20%" class="textRight"></td>
						<td width="30%"></td>
					</tr>*#
				</table>
			</div>
		</div>
		#end
    	<div class="layui-colla-item">
    	<h2 class="layui-colla-title">#springMessage('bill.accebill.transferdownmanageinfo.title')</h2>
    	<div class="layui-colla-content layui-show">
			#if($!{info.allocatedCode})
    		<table class="layui-table">
				##下拨单号 table.abBillTransfer.allocatedCode.down
				##选票票号    table.abBillTransfer.billNo
				<tr>
					<td width="20%" class="textRight">#springMessage('table.abBillTransfer.allocatedCode.down')</td>
					<td width="30%">$!{info.allocatedCode}</td>
                    <td width="20%" class="textRight">#springMessage('table.abBillTransfer.billNo')</td>
                    <td width="30%">$!{info.billNo}</td>
                </tr>
				<tr>
				##下拨金额 table.abBillTransfer.downMoney
				##下拨原因  table.abBillTransfer.downReason
					<td width="20%" class="textRight">#springMessage('table.abBillTransfer.downMoney')</td>
					<td width="30%">#if($!{info.allocationMoney})$number.formatNumeric($!{info.allocationMoney})#else 0.00 #end</td>
					<td width="20%" class="textRight">#springMessage('table.abBillTransfer.downReason')</td>
					<td width="30%">$!{info.allocationReason}</td>
				</tr>
				##下拨中心  bill.accebill.transferdownmanage.corpCenter
				##收票单位  table.abBillTransfer.recevieCorpId
				<tr>
					<td width="20%" class="textRight">#springMessage('bill.accebill.transferdownmanage.corpCenter')</td>
					<td width="30%">$!{info.recordCorpName}</td>
					<td width="20%" class="textRight">#springMessage('table.abBillTransfer.recevieCorpId')</td>
					<td width="30%">$!{info.recevieCorpName}</td>
				</tr>
				##下拨中心账号 	table.abBillTransfer.recordBankAcc
				##收票单位账号 	table.abBillTransfer.recevieBankAcc
				<tr>
					<td width="20%" class="textRight">#springMessage('table.abBillTransfer.recordBankAcc')</td>
					<td width="30%">$!{info.recordBankacc}</td>
					<td width="20%" class="textRight">#springMessage('table.abBillTransfer.recevieBankAcc')</td>
                    <td width="30%">$!{info.recevieBankacc}</td>
				</tr>
			    ##录入日期      table.abBillTransfer.recordDate
				##业务办理日期     table.abAccrecords.businessDate
				<tr>
					<td width="20%" class="textRight">#springMessage('table.abBillTransfer.recordDate')</td>
                    <td width="30%">$!date.format('yyyy-MM-dd',$!{info.recordDate})</td>
                    <td width="20%" class="textRight">#springMessage('table.abAccrecords.businessDate')</td>
                    <td width="30%">$!date.format('yyyy-MM-dd',$!{info.businessDate})</td>
				</tr>
				##附件  table.abBillTransfer.enclosure
				#*<tr>
					<td width="20%" class="textRight">#springMessage('table.abBillTransfer.enclosure')</td>
					<td width="30%">#if($!{info.briefId} eq '6204') $!{info.enclosure} #end</td>
					<td width="20%" class="textRight"></td>
					<td width="30%"></td>
				</tr>*#
            </tbody>
            </table>
			#end
			#if($!{applyInfo})
				#set($vmPage = "views/bill/accebill/attachmentInfo.vm")
				#parse($vmPage)
			#end
        </div>
        </div>
		<div class="layui-colla-item">
		##下拨选票信息##
    	<h2 class="layui-colla-title">#springMessage('bill.accebill.transferdownmanage.title')</h2>
    	<div class="layui-colla-content layui-show">
    		<table class="layui-table layui-form" style="width: 100%;">
            <thead>				
            <tr>
                <th>#springMessage('table.abVoucherinfo.billType')</th>
        		<th>#springMessage('table.abVoucherinfo.billFlag')</th>
        		<th>#springMessage('table.abVoucherinfoVo.corpId')</th>
        		<th>#springMessage('table.abVoucherinfo.payer')</th>
        		<th>#springMessage('table.abVoucherinfo.acceptor')</th>
                <th>#springMessage('table.abVoucherinfo.origNo')</th>
				<th>#springMessage('table.abVoucherinfo.sbbllRngStrtSn')</th>
				<th>#springMessage('table.abVoucherinfo.sbbllRngEndSn')</th>
				<th>#springMessage('table.abVoucherinfoVice.transMoney')</th>
        		<th>#springMessage('table.abVoucherinfo.billMoney')</th>
        		<th>#springMessage('table.abVoucherinfo.startDate')</th>
        		<th>#springMessage('table.abVoucherinfo.endDate')</th>
        		<th>#springMessage('table.abVoucherinfo.payee')</th>
            </tr>
            </thead>
		   <body>
				#if($!abEmitBillVoList)
				#foreach($abbillInfo in $abEmitBillVoList)				
				<tr>
                <td>$!{abbillInfo.billTypeName}</td>
                <td>$!{abbillInfo.billFlagName}</td>
				<td>$!{abbillInfo.corpName}</td>
                <td>$!{abbillInfo.payer}</td>
                <td>$!{abbillInfo.acceptor}</td>
##				<td><a class="" href="#" style="color:blue" onclick="billInfo('$!{abbillInfo.aid}','$!{abbillInfo.origNo}','front')">$!{abbillInfo.origNo}</a></td>
				<td><a class="" href="#" style="color:blue" onclick="billInfo('$!{abbillInfo.vid}','$!{abbillInfo.vvid}','$!{abbillInfo.aid}','front')">$!{abbillInfo.origNo}</a></td>
				<td>$!{abbillInfo.sbbllRngStrtSn}</td>
				<td>$!{abbillInfo.sbbllRngEndSn}</td>
				<td style="text-align: right">$number.formatNumeric($!{abbillInfo.transMoney})</td>
                <td style="text-align: right">$number.formatNumeric($!{abbillInfo.billMoney})</td>
				<td>$!date.format('yyyy-MM-dd',$!{abbillInfo.startDate})</td>
                <td>$!date.format('yyyy-MM-dd',$!{abbillInfo.endDate})</td>
				<td>$!{abbillInfo.payee}</td>
				</tr>
                #end
                #end
            </body>
    	</table>
        </div>
		<div>
			#if(!$isApprove)
            <h2 class="layui-colla-title">#springMessage('bill.logInfo.title')</h2>
            <table class="layui-table layui-form dark-layui-table" style="width: 100%;">
                <thead>
                <tr>
                    <th>#springMessage('table.abLog.createDate')</th>
                    <th>#springMessage('table.abLog.createBy')</th>
                    <th>#springMessage('table.abLog.createName')</th>
                    <th>#springMessage('table.abBackbillinfo.origNo')</th>
                    <th>#springMessage('table.abLog.logType')</th>
                    <th>#springMessage('table.abLog.briefId')</th>
                    <th>#springMessage('table.abLog.msg')</th>
                </tr>
                </thead>
                <body>
					#if($!abLogList)
						#foreach($logInfo in $abLogList)
                        <tr>
                            <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.createDate})</td>
                            <td>$!{logInfo.createBy}</td>
                            <td>$!{logInfo.createName}</td>
                            <td>$!{abEmitBillVo.origNo}</td>
                            <td>$!{logInfo.logTypeName}</td>
                            <td>$!{logInfo.briefIdName}</td>
                            <td>#springMessage($!{logInfo.msg})</td>
                        </tr>
						#end
					#end
                </body>
            </table>
		#end
		</div>
        </div>
		</div>
	</form>
	#if(!$!isApprove)
<br />
<br />
<div class="layui-form-item layui-form-submit" id="buttonDiv">
	<div class="layui-input-block">
	<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{info.aid}')">#springMessage('common.button.trackFlow')</button>
	<button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
	#end
	    #parse("views/common/footer.vm")
		<script>	
            bt.use(['jquery','element','btUpload'], function(){
            	$ = bt.jquery;
                var uploader = bt.btUpload.init({
                    elem: "#uploader",
                    auto: false,
                    hasDelete: false,
                    hasUpload: false,
                    gid: $("#attachmentId").val()
                });
            });
            /**
             * 进行票据信息查看
             * @param id 签收表ID
             * @param type front正面，back背面
             */
//            var billInfo=function(id,origNo,opType){
             var billInfo=function(vid,vvid,accId){
            	var $ = bt.jquery;
                parent.layer.open({
                	title:bt.lang('common.button.billinfo'),
                    type: 2,
                    area: ['1080px', '720px'],
                    maxmin: true,
                    //content: basePath + "/bill/accebill/abvoucherinfo/billEcdsInfoView?recId=" + id +"&origNo="+ origNo
                    content: basePath + "/bill/accebill/abreceivebill/view?isApprove=true&vouId="+vid+"&viceId="+vvid+"&accId="+accId
                });
            }
        </script>
	</body>
</html>

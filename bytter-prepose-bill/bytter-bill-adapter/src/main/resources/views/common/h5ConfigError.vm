#set($basePath=$springMacroRequestContext.contextPath)
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>移动端配置错误</title>
    <link rel="stylesheet" href="${basePath}/static/css/error.page.css">
</head>
<body>
<section class="page-error">
    <div class="page500"></div>
    <div class="text500">
        #if($message)
            <h3>$!{message}</h3>
        #else
            <h3>移动端配置有误，请联系管理员！</h3>
        #end
    </div>
</section>
</body>
</html>

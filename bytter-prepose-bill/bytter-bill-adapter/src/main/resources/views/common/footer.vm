<script type="text/javascript">
    getUserCorpResourceByMenuId(location.href);
    $(function () {
        //设置了自适应按钮时，调用下面方法设置按钮的相对位置
        if($('.layui-form-submit-adaptive')[0]){
            $(window).resize(function () {
                bt.use(['form'], function(){
                    bt.form().renderButton();
                })
            })
        }
        //关闭chrome 浏览器缩放页面功能功能
        $('body').css('zoom', 'reset');

        $(document).keydown(function (event) {
            //event.metaKey mac的command键
            if ((event.ctrlKey === true || event.metaKey === true)&& (event.which === 61 || event.which === 107 || event.which === 173 || event.which === 109 || event.which === 187  || event.which === 189)){
                event.preventDefault();
            }
        });
        $(window).bind('mousewheel DOMMouseScroll', function (event) {
            if (event.ctrlKey === true || event.metaKey) {
                event.preventDefault();
            }
        });
		initScreenTimer($!configTag.getConfig('sys','screenTime'));

        //统一处理底部有固定定位容器 .layui-form-submit-adaptive,.layui-form-submit 摭挡内容
        var fixedElem = $('.layui-form-submit-adaptive')[0] || $('.layui-form-submit')[0];
        if(fixedElem){
            var fixedheight =  $(fixedElem).outerHeight();
            $('body').css('padding-bottom',fixedheight+'px'); //给body设置padding-bottom值
        }

        // 统一处理 输入框不充许输入中文特殊符号 liuyj 2019-04-26

        // $(document).on('input propertychange','input:not(".no_check")',function () {
        //     var val = $(this).val();
        //     val = val.replace(/[\~\！\·\#\￥\%\……\—\*\（\）\——\+\？]/g,"")
        //
        //     $(this).val(val)
        // })

    })
    $('.date-mid').parents('td').addClass('input100');//统一处理区域范围的样式
</script>

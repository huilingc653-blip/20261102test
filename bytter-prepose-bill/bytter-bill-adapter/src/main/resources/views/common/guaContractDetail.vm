<table class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.guaContract.contractCode')</th>##合同编号
        <th>#springMessage('table.guaContract.guaNo')</th>##担保编号
        <th>#springMessage('table.ratBkration.guaCorpId')</th>##担保单位
        <th>#springMessage('table.guaContract.guaType')</th>##担保方式
        <th>#springMessage('table.guaContract.startDate')</th>##担保开始日期
        <th>#springMessage('table.guaContract.endDate')</th>##担保结束日期
        <th>#springMessage('table.guaContract.curId')</th>##币别
        <th>#springMessage('table.guaContract.guaMoney')</th>##担保额度
        <th>#springMessage('cms.guarantee.rmk')</th>##担保备注
        <th>#springMessage('common.table.status')</th>##状态
    </tr>
    </thead>
    <tbody>
    #foreach($!{guaContract} in $!{guaContractUseDTO.contracts})
        <tr>
            <td align="center">$!{guaContract.contractCode}</td>
            <td align="center">$!{guaContract.guaNo}</td>
            <td align="center">$!{guaContract.guaPerson}</td>
            <td align="center">$!{guaContract.guaTypeName}</td>
            <td align="center">$!date.format('yyyy-MM-dd',$!{guaContract.startDate})</td>
            <td align="center">$!date.format('yyyy-MM-dd',$!{guaContract.endDate})</td>
            <td align="center">$!{guaContract.curName}</td>
            <td align="right">$!number.formatNumeric($!{guaContract.guaMoney})</td>
            <td align="center">$!{guaContractUseDTO.guaRmk}</td>
            <td align="center">$dictTag.get("Contract.UseStatus",$!{guaContract.status})</td>
        </tr>
    #end
    </tbody>
</table>

##挂接担保合同公共页面
<input type="hidden" id="isGuarantee" value="$!{isGuarantee}"><!-- 业务模块是否挂担保参数设置-->
<input type="hidden" id="isHangGuarantee" value="$!{isHangGuarantee}"><!-- 业务模块是否挂担保-->
<input type="hidden" id="contractIds" name="guaContract" value="$!{contractIds}"><!-- 挂接担保合同id-->
<input type="hidden" id="viewFlag" value="$!{viewFlag}"><!-- 查看标志；1—为查看页面-->

#if($!{viewFlag}!="1")
<tr>
##是否挂担保
    <td width="15%" class="textRight">#springMessage('rat.Is.bkration.gua')</td>
    <td width="35%">
        <div class="layui-form" id="isHangGuaranteeDiv">
            <div class="bt-biz-dict is_not_render" data-type="radio" data-group="sf_yn"
                #if($!{isHangGuarantee})
                 data-defaultvalue="$!{isHangGuarantee}"
                #else
                 data-defaultvalue=1
                #end
                data-name="isHangGuarantee" data-biz-name="isHangGuarantee"
                 data-callback="bt.setGuaInfo"></div>##是否挂接担保选择按钮
        </div>
    </td>
    <td width="15%"></td>
    <td width="35%"></td>
</tr>
#end
<tr class="isHangGua" style="display: none">
##担保合同
    <td width="15%" class="textRight">#springMessage('table.ratBkration.guaContract')</td>
    <span id="guaContractSpan">
        #foreach( $!{contractId} in $!{idList})##担保合同id集合
            #set($vcount = $velocityCount - 1)
           <input type="hidden" name="contractIds[$vcount]"  value="$!{contractId}">
        #end
    </span>
    <td width="35%">
        <div class="layui-inline">
            <input id="guaContractCodes" name="guaContractCodes" type="text" readonly="true" value="$!{contractCode}"
                   class="layui-input">##担保合同号显示框
        </div>
        #if($!{viewFlag}!="1")
            <div class="layui-inline">
                <button class="layui-btn" type="button" onclick="addGuaContract()">#springMessage(
								'common.button.select')</button>##选择担保合同按钮
            </div>
        #end
        <div class="layui-input-inline">
            <div style="display: none" id="guaBtn">
                <button type="button" onclick="viewGuaContract()" class="layui-btn">#springMessage(
									'common.button.view')</button>##查看担保合同按钮
            </div>
        </div>
    </td>
    <td width="15%" class="textRight">#springMessage('table.guaContract.guaType')</td>
    <td width="35%">
        <input id="guaWayNames" name="guaWayNames" type="text" readonly="true" value="$!{guaWayNames}" ##担保方式名称，中间以逗号隔开
               class="layui-input">
        <input type="hidden" id="guaWay" name="guaWay" type="text" readonly="true"  value="$!{guaWay}" ##担保方式code，中间以逗号隔开
               class="layui-input">
    </td>

</tr>
<tr class="isHangGua" style="display: none">
##担保备注
    <td width="15%" class="textRight">#springMessage('cms.guarantee.rmk')</td>
    <td width="85%" colspan="3">
        <input type="text"  id="guaranteeRmk" name="guaranteeRmk" style="width: 35%" value="$!{guaranteeRmk}"
               autocomplete="off" class="layui-input"
               placeholder="#springMessage('cms.guarantee.rmk')">
    </td>
</tr>
#set($basePath=$springMacroRequestContext.contextPath)
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>500</title>
    <link rel="stylesheet" href="${basePath}/static/css/error.page.css">
</head>
<body>
<section class="page-error">
    <div class="page500"></div>
    <div class="text500">
        #if($message)
            <h3>$!{message}</h3>
        #else
            <h3>抱歉,服务器出错了！</h3>
        #end

        <p>We could not find the page you were looking for. Meanwhile, you may return to dashboard or try using the search form.</p>
        <h4><a href="${basePath}/index" target="_top">返回到主页</a></h4>
    </div>
</section>
</body>
</html>


#set($basePath=$springMacroRequestContext.contextPath)
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>parameterError</title>
    <link rel="stylesheet" href="${basePath}/static/css/error.page.css">
</head>
<body>
<section class="page-error">
    <div class="text500">
        #if($message)
            <h3>$!{message}</h3>
        #else
            <h3>抱歉,参数有误了！</h3>
        #end
        <h4><a href="${basePath}/index" target="_top">返回到主页</a></h4>
    </div>
    <div class="parameter-error"></div>
</section>
</body>
</html>

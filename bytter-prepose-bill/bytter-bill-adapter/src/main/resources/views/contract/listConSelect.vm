<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
	<input type="hidden" name="opResource" value="$!{params.opResource}">
	<input type="hidden" name="isOutSystem" value="$!{isOutSystem}">
        <table class="layui-table">
            <tbody>
                <tr>
					## 合同名称
					<td width="15%" class="textRight">#springMessage('contract.corpId')</td>
					<td width="35%">
                        #if($!isOutSystem eq '1')
							#if($!corpInfo)
						<input type="hidden" name="corpId" value="$!{params.corpId}">
						$!{corpInfo.name}
							#end
						#else
						<div class="bt-biz-corp"
                        data-tree-type="check"
                        data-biz-type="corp"
						data-biz-name="corpId"
                        data-type="selectTree"
                        data-name="corpId"
                        data-callbackData="corpCallback"
                        data-resource="$!{params.opResource}"
                        placeholder="#springMessage('contract.corpId')">
                    </div>
						#end
                    </td>
					##合同类型
                    <td width="15%" class="textRight">#springMessage('contract.conType')</td>
                    <td width="35%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-conType" id="typeName" data-name="ins_typeName"
                                 data-biz-name="typeName" data-resource="$!{params.opResource}"> </div>
                        </div>
                    </td>
				</tr>
				<tr>
                    ## 合同编号
                    <td width="15%" class="textRight">#springMessage('contract.conNo')</td>
                    <td width="35%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_conNo"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('contract.conNo')">
                        </div>
                    </td>
                    ## 合同名称
                    <td width="15%" class="textRight">#springMessage('contract.conName')</td>
                    <td width="35%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_conName"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('contract.conName')">
                        </div>
                    </td>
				</tr>
				<tr>
					##合同生效日期
                    <td width="15%" class="textRight">#springMessage('contract.beginDate')</td>
                    <td width="35%">
                        <div class="layui-input-inline">
                            <input type="text" name="ged_beginDate" class="layui-input bt-input-inline bt-biz-dateType" id="beginDateStart" data-endid="beginDateEnd" value="" >
                            <span class="date-mid">~</span>
                            <input type="text" name="led_beginDate" class="layui-input bt-input-inline bt-biz-dateType" id="beginDateEnd" value="">
                        </div>	
                    </td>
					##合同结束日期
                    <td width="15%" class="textRight">#springMessage('contract.endDate')</td>
                    <td width="35%">
                        <div class="layui-input-inline">
                            <input type="text" name="ged_endDate" class="layui-input bt-input-inline bt-biz-dateType" id="endDateStart" data-endid="endDateEnd" value="" >
                            <span class="date-mid">~</span>
                            <input type="text" name="led_endDate" class="layui-input bt-input-inline bt-biz-dateType" id="endDateEnd" value="">
                        </div>
                    </td>
				</tr>
				
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
						<button type="button" class="layui-btn layui-btn-primary" onclick="closeForms()">#springMessage('common.button.revert')</button>
                    </td>
				</tr>
            </tbody>
        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis" >
        <thead>
        <tr>
    		<th>#springMessage('common.table.thead.operation')</th>
            <th>#springMessage('contract.corpId')</th>
    		<th>#springMessage('contract.conType')</th>
            <th>#springMessage('contract.conName')</th>
    		<th>#springMessage('contract.conNo')</th>
    		<th>#springMessage('contract.signType')</th>
    		<th>#springMessage('contract.draftDate')</th>
    		<th>#springMessage('contract.signDate')</th>
    		<th>#springMessage('contract.beginDate')</th>
    		<th>#springMessage('contract.endDate')</th>
    		<th>#springMessage('contract.status')</th>
        </tr>
        </thead>
    </table>
#parse("views/common/footer.vm")
<script src="${basePath}/static/modules/contract/conSelect.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
#parse("views/flow/flow.vm")
</head>
<body>
<div>
    <input type="hidden" id="mid" value="$!{conDraftVO.mid}"/>
    <input type="hidden" id="rid" value="$!{conDraftVO.rid}"/>
    <h2 class="layui-colla-title">#springMessage('contract.conInfo')</h2>
    <table class="layui-table" width="100%">
        <tbody>
        <tr>
        ##合同名称
            <td class="textRight" width="15%">#springMessage('contract.conName')</td>
            <td width="35%">
                $!{conDraftVO.conName}
            </td>
        ##合同发起方
            <td class="textRight" width="15%">#springMessage('contract.corpId')</td>
            <td width="35%">
                ($!{conDraftVO.corpCode})$!{conDraftVO.corpName}
            </td>
        </tr>
        <tr>
        ##签署方式
            <td class="textRight" width="15%">#springMessage('contract.signType')</td>
            <td width="35%">
                $!{conDraftVO.signTypeName}
            </td>
        ##合同类型
            <td class="textRight" width="15%">#springMessage('contract.conType')</td>
            <td width="35%">
                $!{conDraftVO.typeName}
            </td>
        </tr>
        <tr>
        ##纸质合同附件
            <td class="textRight" width="15%"><span><font
                    style="color: red;font-size: 16px">*&nbsp;</font></span>#springMessage('contract.conAttachmen')</td>
            <td width="35%">
                <input id="attachmentId" name="attachmentId" type="hidden" value="$!{conDraftVO.attachmentId}">
                <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
            </td>
        ##合同编号
            <td class="textRight" width="15%">#springMessage('contract.conNo')</td>
            <td width="35%">
                $!{conDraftVO.conNo}
            </td>
            </td>
        </tr>
        <tr>
        ##合同生效日期
            <td class="textRight" width="15%">#springMessage('contract.beginDate')</td>
            <td width="35%">
                $!date.format('yyyy-MM-dd',$!{conDraftVO.beginDate})
            </td>
        ##合同失效日期
            <td class="textRight" width="15%">#springMessage('contract.endDate')</td>
            <td width="35%">
                $!date.format('yyyy-MM-dd',$!{conDraftVO.endDate})
            </td>
        </tr>
        </tbody>
    </table>
    <h2 class="layui-colla-title">#springMessage('contract.conBusinessInfo')</h2>
    <table class="layui-table" width="100%">
        <tbody>
            #if($!conDraftVO.busdtlList)
                #set($name = "num")
                #set($num = 0)
                #foreach($vtDaField in $conDraftVO.busdtlList)
                    #set($num = $num + 1)
                    #if($num%2 eq 1)
                    <tr >
                    #end
                    <td width="15%" class="textRight">#springMessage("$!{vtDaField.name}")</td>
                    #if($!vtDaField.fieldType eq "02")
                        <td width="35%" >$!number.formatNumeric($!number.formatNumeric($!{vtDaField.val}))</td>
                    #elseif($!vtDaField.fieldType eq "05")
    						#set($valNum = $!number.formatNumeric(${vtDaField.val}) * 100)
    						<td width="35%" >$!number.formatNumeric($!valNum,'#,##0.0000')%</td>
					   #else
                        <td width="35%">$!{vtDaField.val}</td>
                    #end
                    #if($num%2 eq 0)
                    </tr>
                    #end
                #end
                #if($num%2 eq 1)
                <td width="15%"></td>
                <td width="35%"></td>
                </tr>
                #end
            #end
        </tbody>
    </table>
<table class="layui-table" width="100%">
      <tbody>
      	  <tr>
             <td class="textRight" width="15%">#springMessage('contract.terminateMsg')</td>
             <td td width="35%" >
                 $!{contractSuspend.opMsg}
             </td>
             <td class="textRight" width="15%">#springMessage('contract.suspend.date')</td>
             <td width="35%" >
				$!date.format('yyyy-MM-dd',$!{contractSuspend.opDate})
             </td>
         </tr>
         <tr>
             <td class="textRight" width="15%">#springMessage('contract.suspend.applyno')</td>
             <td width="35%" >
                $!{contractSuspend.opNo}
             </td>
         </tr>
         <tr >
         	 <td class="textRight"  width="15%"></td>
             <td  width="35%" colspan="3">
                <input id="reAttachmentIde" name="reAttachmentIde" type="hidden" value="$!{conDraftVO.reAttachmentIde}">
                <div id="reUploader" class="layui-input-inline" style="width: 100%"></div>
             </td>
         </tr>
      </tbody>
</table>
#*#if(!$isApprove)
    <br>
    <br>
    <h2 class="layui-colla-title">#springMessage('bill.logInfo.title')</h2>
    <table class="layui-table layui-form" style="width: 100%;">
        <thead>
        <tr>
            <th>#springMessage('table.abLog.createDate')</th>
            <th>#springMessage('table.abLog.createBy')</th>
            <th>#springMessage('table.abLog.createName')</th>
            <th>#springMessage('table.abBackbillinfo.origNo')</th>
            <th>#springMessage('table.abLog.logType')</th>
            <th>#springMessage('table.abLog.briefId')</th>
            <th>#springMessage('table.abLog.msg')</th>
        </tr>
        </thead>
        <body>
            #if($!abLogList)
                #foreach($logInfo in $abLogList)
                <tr>
                    <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.createDate})</td>
                    <td>$!{logInfo.createBy}</td>
                    <td>$!{logInfo.createName}</td>
                    <td>$!{abEmitBillVo.origNo}</td>
                    <td>$!{logInfo.logTypeName}</td>
                    <td>$!{logInfo.briefIdName}</td>
                    <td>#springMessage($!{logInfo.msg})</td>
                </tr>
                #end
            #end
        </body>
    </table>
#end*#
    <br/>
    <br/>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn"
                    onclick="bt.trackFlowByBusinessId('$!{conDraftVO.rid}')">#springMessage(
                'common.button.trackFlow')</button>
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage(
                'common.button.revert')</button>
        </div>
    </div>
</div>
    #parse("views/common/footer.vm")
    #workFlowHtml()
    #workFlowScript()
<script type="text/javascript">
    bt.use(['form', 'btUpload'], function () {
        var $ = bt.jquery, form = bt.form();
        var up = bt.btUpload.init({
            elem: "#uploader",
            auto: false,
            hasDelete: false,
            hasUpload: false,
            isExpand: true,
            gid: $("#attachmentId").val()
        });
        
        var reUploader = bt.btUpload.init({
            elem: "#reUploader",
            auto: false,
            hasDelete: false,
            hasUpload: false,
            isExpand: true,
            gid: $("#reAttachmentIde").val()
        });
    });

</script>
</body>
</html>
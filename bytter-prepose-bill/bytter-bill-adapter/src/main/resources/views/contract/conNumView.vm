<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	#if($!conInfo)
	#if($!conInfo.recordList)
	#set($changeNum = 0)
	#set($performanceNum = 0)
	#set($terminateNum = 0)
	#set($busType = "")
    <table class="layui-table layui-form" style="width:100%;" >
	#foreach($recordInfo in $conInfo.recordList)
	#if($busType ne $recordInfo.busType )
		#if($busType ne "" )
        </tbody>
	</table>
	<table class="layui-table layui-form" style="width:100%;" >		
		#end
		#set($busType = $recordInfo.busType)
		<thead >
			#if($busType eq "04"  && $opt == "change")
			<tr >
			<td colspan="5">
				#springMessage('contract.changeInfo')
			</td>
			</tr>
			<tr >
			<td>#springMessage('contract.changeDate')</td>
			<td>#springMessage('contract.changeMsg')</td>
			<td>#springMessage('contract.changeAttachmen')</td>
			<td>#springMessage('contract.status')</td>
			<td>#springMessage('contract.type.rmk')</td>
			</tr>
			#elseif($busType eq "05" && $opt == "perfor")
			<tr >
			<td colspan="7">
			#springMessage('contract.performanceInfo')
			</td>
			</tr>
			<tr >
			<td>#springMessage('contract.performanceDate')</td>
			<td>#springMessage('contract.performanceMsg')</td>
			<td>#springMessage('contract.performanceNo')</td>
			<td>#springMessage('contract.performanceMoney')</td>
			<td>#springMessage('contract.performanceAttachmen')</td>
			<td>#springMessage('contract.status')</td>
			<td>#springMessage('contract.type.rmk')</td>
			</tr>
			#end
        </thead>	
		<tbody >
	#end
    	#if($conInfo.recordId && $conInfo.recordId eq $recordInfo.id )
    		<tr bgcolor="#f7ffb2">
    	#else
    		<tr>
    	#end
			#if($busType eq "04" && $opt == "change")
				<td width="10%">$!dateTag.format($!{recordInfo.opDate},"yyyy-MM-dd")</td>
				<td width="20%">$!{recordInfo.opMsg}</td>
				<td width="45%">
				#if($!recordInfo.attachmentId)
				#set($changeNum = $changeNum + 1)
				<div id="changeAttachmen-$!{changeNum}" attachmentId="$!{recordInfo.attachmentId}" class="layui-input-inline" style="width:100%"></div>
				#end
				</td>
				<td width="10%">$!{recordInfo.statusName}</td>
				<td width="15%">$!{recordInfo.rmk}</td>
			#elseif($busType eq "05" && $opt == "perfor")
				<td width="8%">$!dateTag.format($!{recordInfo.opDate},"yyyy-MM-dd")</td>
				<td width="13%">$!{recordInfo.opMsg}</td>
				<td width="10%">$!{recordInfo.opNo}</td>
				<td width="8%">$!number.formatNumeric($!{recordInfo.opMoney})</td>
				<td width="45%">
				#if($!recordInfo.attachmentId)
				#set($performanceNum = $performanceNum + 1)
				<div id="performanceAttachmen-$!{performanceNum}" attachmentId="$!{recordInfo.attachmentId}" class="layui-input-inline" style="width:100%"></div>
				#end
				</td>
				<td width="8%">$!{recordInfo.statusName}</td>
				<td width="10%">$!{recordInfo.rmk}</td>
			#end
            </tr>
	#end
        </tbody>
    </table>
	<input type="hidden" id="changeNum" value="$!{changeNum}"/>
	<input type="hidden" id="performanceNum" value="$!{performanceNum}"/>
	<input type="hidden" id="terminateNum" value="$!{terminateNum}"/>
	#end
	
	#end
	<br />
    <br />
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
    	<div class="layui-input-block">
    	<button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
#parse("views/common/footer.vm")
<script src="${basePath}/static/modules/contract/conBase.view.js?_btv=${resourceVersion}"></script>
</body>
</html>

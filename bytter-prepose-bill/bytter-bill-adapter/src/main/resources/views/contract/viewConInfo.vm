	#if($!conInfo)
		<div>
    <table class="layui-table layui-form dark-layui-table" style="width:100%;" >
		<thead >
			<tr ><td colspan="4">#springMessage('contract.conInfo')</td></tr>
        </thead>
		<tbody >
			<tr >
				<td class="textRight" width="15%">#springMessage('contract.corpId')</td>
				<td width="35%">$!{conInfo.corpName}</td>
				<td class="textRight" width="15%">#springMessage('contract.conType')</td>
				<td width="35%">$!{conInfo.typeName}</td>
            </tr>
			<tr >
				<td class="textRight" width="15%">#springMessage('contract.conNo')</td>
				<td width="35%">$!{conInfo.conNo}</td>
				<td class="textRight" width="15%">#springMessage('contract.conName')</td>
				<td width="35%">$!{conInfo.conName}</td>
            </tr>
			<tr >
				<td class="textRight" width="15%">#springMessage('contract.signType')</td>
				<td width="35%">$dictTag.get("CON_SIGN_TYPE",$!conInfo.signType)</td>
				<td class="textRight" width="15%">#springMessage('contract.conStatus')</td>
				<td width="35%">$!{conInfo.statusName}</td>
            </tr>
			<tr >
				<td class="textRight" width="15%">#springMessage('contract.beginDate')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{conInfo.beginDate})</td>
				<td class="textRight" width="15%">#springMessage('contract.endDate')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{conInfo.endDate})</td>
            </tr>
			#if($conInfo.draftDate)
			<tr >
				<td class="textRight" width="15%">#springMessage('contract.draftDate')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{conInfo.draftDate})</td>
				#if($conInfo.signDate)
				<td class="textRight" width="15%">#springMessage('contract.signDate')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{conInfo.signDate})</td>
				#else
                    <td ></td>
                    <td ></td>
				#end
            </tr>
			#end

			<tr >
				<td class="textRight" width="15%">#springMessage('contract.conAttachmen')</td>
				<td width="85%" colspan="3">
				<div id="conAttachmen" attachmentId="$!{conInfo.attachmentId}" class="layui-input-inline" style="width:100%"></div>
				</td>
            </tr>
        </tbody>
    </table>
	<table class="layui-table layui-form dark-layui-table" style="width:100%;" >
		<thead >
			<tr ><td colspan="4">#springMessage('contract.conBusinessInfo')</td></tr>
        </thead>
		<tbody >
			<tbody >
				#if($!conInfo.busdtlList)
					#set($name = "num")
					#set($num = 0)
        		#foreach($vtDaField in $conInfo.busdtlList)
					#set($num = $num + 1)
					#if($num%2 eq 1)
						<tr >
					#end
					<td width="15%" class="textRight">#springMessage("$!{vtDaField.name}")</td>
						<td width="35%" >
					#if(${vtDaField.val})
					#if($!vtDaField.fieldType eq "02")
						$!number.formatNumeric($!number.formatNumeric($!{vtDaField.val}))
					#elseif($!vtDaField.fieldType eq "05")
						#set($valNum = $!number.formatNumeric(${vtDaField.val}) * 100)
						$!number.formatNumeric($!valNum,'#,##0.0000')%
					#else
						$!{vtDaField.val}
					#end
					#end
						</td>
					#if($num%2 eq 0)
						</tr>
					#end
				#end
					#if($num%2 eq 1)
						<td width="15%"></td>
						<td width="35%"></td>
						</tr>
					#end
        		#end
            </tbody>
        </tbody>
    </table>
	</div>
	#end
#parse("views/common/footer.vm")
<script src="${basePath}/static/modules/contract/conBase.view.js?_btv=${resourceVersion}"></script>

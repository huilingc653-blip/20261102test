<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
    <style>
        .layui-textarea {
            line-height: 20px;
            min-width: 120px;
            min-height: 50px;
        }
        .hide {
            display: none;
        }
    </style>
</head>
<body style="padding-bottom: 60px;">
<form class="layui-form" action="">
    <div class="layui-fluid" style="padding: 0">
        <div class="layui-row">
            <div class="layui-col-xs12">
                <input id="isCommonValue" name="isCommonValue" type="hidden" value="$!{isCommon}">
                <input id=currPower name="currPower" type="hidden" value="$!{currPower}">
                <table class="layui-table">
                    <thead>
                    <tr>
                        <td colspan="4">#springMessage('contract.type.basicInfo')</td>
                    </tr>
                    </thead>
                    <tr>
                        <td class="text-right">#springMessage('contract.type.code')</td>
                        <td>
                            <input type="text" name="typeCode" autocomplete="off" class="layui-input" lay-verify="required|strlength"
                                   data-maxlength="10" value=""/>
                        </td>
                        <td class="text-right">#springMessage('contract.type.name')</td>
                        <td>
                           	 <input type="text" name="typeName" autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="100" value=""/>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">#springMessage('contract.type.isCommon')
                        	</td>
                        <td>
                            <input type="checkbox"  name="shareSign" lay-skin="switch" lay-filter="checkCorp" lay-text="#springMessage("common.sc_yn.yes")|#springMessage("common.sc_yn.no")">
                        </td>
                        <td class="text-right">#springMessage('contract.iseffective')</td>
                        <td>
                            <input type="checkbox" checked name="validSign" lay-skin="switch" lay-text="#springMessage("common.sc_yn.yes")|#springMessage("common.sc_yn.no")">
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right celRow">#springMessage('contract.type.corpName')</td>
                        <td id="inputCorp" class="celRow">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-tree-type="radio"
                                 data-type="selectTree"
                                 data-name="corpId"
                                 data-biz-name="corpId"
                                 data-resource="contract:type:manage:fst:corp"
                                 data-scope="all"
                                 data-defaultvalue=""></div>
                        </td>
                        <td class="text-right celRow"></td>
                        <td class="celRow">
                        	
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">#springMessage("contract.type.rmk")</td>
                        <td colspan="3">
                            <textarea class="layui-textarea" name="rmk" data-maxlength="500" lay-verify="strlength"></textarea></td>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="submitEvent" type="button">#springMessage('common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
       		<button class="layui-btn layui-btn-primary" id="cancel">#springMessage('common.button.revert')</button>
        </div>
    </div>
    <fieldset class="layui-elem-field">
        <legend>#springMessage('contract.services.entity')</legend>
        <div class="layui-field-box ignore-required-icon">
            <table id="bankAcc" style="width:100%">
                <thead>
                <tr id="bankAccY" class="is_city">
                  	<th>#springMessage('contract.element.name')<span style="color:red;">(#springMessage('contract.type.tips.msg'))</span></th>
                    <th>#springMessage('contract.type.rmk')</th>
                    <th>#springMessage('contract.type.isnotnull')</th>
                    <th>#springMessage('contract.field.type')</th>
                    <th>#springMessage('contract.iseffective')</th>
                    <th>#springMessage('contract.sort')</th>
                    <th>#springMessage('common.table.thead.operation')</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </fieldset>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/contract/js/contractManage.add.js?_btv=${resourceVersion}"></script>
</body>
</html>
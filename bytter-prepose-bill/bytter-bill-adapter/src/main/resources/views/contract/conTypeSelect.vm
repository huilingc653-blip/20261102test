<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
	#springMessage('contract.conType'):
    <div class="layui-input-inline">
        <div class="bt-biz-conType" 
			 id="conType"  data-name="conType"
             data-biz-name="conType" 
			 data-corpid="$!{params.corpId}" 
			 data-pdcode="$!{params.pdCode}"> 
		</div>
    </div>
    </form>
#parse("views/common/footer.vm")
<script type="text/javascript">
var conType;
bt.use(['form','conType'], function(){
	conType=bt.conType.init();
});

var callbackdata = function () {
   var conTypeId = bt.conType.get("conType").val();
   return conTypeId.trim();
}

</script>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab layui-tab-brief" lay-filter="externalCorpTabBrief">
    <ul class="layui-tab-title">
        <li data-status="1" class="layui-this tab-type">#springMessage("contract.type.share")</li>
        <li data-status="0">#springMessage("contract.type.corp")</li>
    </ul>
    <div class="layui-tab-content">
        <form class="layui-form" id="searchForm">
            <input type="hidden" name="isCommon" value="${isCommon}">
            <table class="layui-table">
                <tbody>
                <tr>
                    <td class="textRight">#springMessage('contract.type.code')</td>
                    <td>
                        <input type="text" id="likes_typeCode" name="likes_typeCode"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('contract.type.code')"/>
                    </td>
                    <td class="textRight">#springMessage('contract.type.name')</td>
                    <td>
                        <input type="text" id="likes_typeName" name="likes_typeName"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('contract.type.name')"/>
                    </td>
                </tr>
                <tr>
                    <td class="textRight inlineCorp">#springMessage('sys.user.corpContain.show')</td>
                    <td class="inlineCorp">
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="ins_corpId"
                                 data-callbackData="bt.netChange"
                                 data-resource="contract:type:manage:fst:corp"
                                 data-scope="all"
                                 data-biz-name="corpId"
                                 data-placeholder="#springMessage('common.placeholder.select')">
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
                </tbody>
            </table>
        </form>
        <table id="externalCorpTable" class="layui-table layui-form">
            <thead>
            <tr>
            	<th>#springMessage('contract.type.code')</th>
                <th>#springMessage('contract.type.name')</th>
                <th>#springMessage("contract.type.rmk")</th>
                <th>#springMessage('contract.iseffective')</th>
 				<th>#springMessage('contract.type.isCommon')</th>
                <th>#springMessage('contract.type.corpName')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
        </table>
    </div>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/contract/js/contractManage.list.js?_btv=${resourceVersion}"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-table {
            margin: 0px 0;
        }

        body {
            margin-bottom: 30px;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post" id="inputForm">

    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('contract.conInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                    ##合同名称
                        <td class="textRight" width="15%">#springMessage('contract.conName')</td>
                        <td>
                            <input type="hidden" id="mid" name="mid" value="" />
                            <input type="hidden" id="rid" name="rid" value="" />
                            <div class="layui-inline">
                                <div  id="conName" ></div>
                            </div>
                        ##合同选择按钮
                            <div class="layui-inline">
                                <button type="button" class="layui-btn bt-biz-conSelect" data-beforeClick="bt.conSelectParams"
                                        data-callback="bt.conSelectCallback" >#springMessage('common.button.select')</button>
                            </div>

                        </td>
                    ##合同发起方
                        <td class="textRight" width="15%">#springMessage('contract.corpId')</td>
                        <td width="35%">
                            <div  id="corpName" ></div>
                        </td>

                    </tr>
                    <tr>
                    ##签署方式
                        <td class="textRight" width="15%">#springMessage('contract.signType')</td>
                        <td width="35%">
                            <div  id="signType" ></div>
                        </td>
                    ##合同类型
                        <td class="textRight" width="15%">#springMessage('contract.conType')</td>
                        <td width="35%">
                            <div  id="typeName" ></div>
                        </td>
                    </tr>
                    <tr>
                    ##纸质合同附件
                        <td class="textRight" width="15%">#springMessage(
                            'contract.conAttachmen')</td>
                        <td width="35%">
                            <div id="conAttachmen"  class="layui-input-inline" style="width:100%"></div>
                        </td>
                    ##合同编号
                        <td class="textRight" width="15%">#springMessage('contract.conNo')</td>
                        <td width="35%">
                            <div  id="conNo" ></div>
                        </td>
                    </tr>
                    <tr>
                    ##合同生效日期
                        <td class="textRight" width="15%">#springMessage('contract.beginDate')</td>
                        <td width="35%">
                            <div  id="beginDate" ></div>
                        </td>
                    ##合同失效日期
                        <td class="textRight" width="15%">#springMessage('contract.endDate')</td>
                        <td width="35%">
                            <div  id="endDate" ></div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('contract.conBusinessInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table id="businessInfoTable" class="layui-table layui-form" style="width:100%;">
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('contract.changeInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table  class="layui-table layui-form" style="width:100%;">
                    <tbody>
                    <tr>
                    ##变更时间
                        <td class="textRight" width="15%">#springMessage('contract.changeDate')</td>
                        <td width="35%">
                            <input type="text" name="opDate" data-name="opDate" class="layui-input bt-biz-dateType"
                                   data-type="date" data-biz-name="opDate" lay-verify="required">
                        </td>
                    ##变更原因
                        <td class="textRight" width="15%">#springMessage('contract.changeMsg')</td>
                        <td width="35%">
                            <input type="text" id="opMsg" name="opMsg" lay-verify="required|strlength"
                                   data-maxlength="200" autocomplete="off" class="layui-input" placeholder="#springMessage('contract.changeMsg')">
                        </td>
                    </tr>
                    <tr>
                    ##备注
                        <td class="textRight"  width="15%">#springMessage('contract.type.rmk')</td>
                        <td colspan="3">
                            <input type="text" id="rmk" name="rmk" lay-verify="strlength"
                                   data-maxlength="500" autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('contract.type.rmk')">
                        </td>
                    </tr>
                    <tr>
                    ##变更合同附件
                        <td class="textRight" width="15%">#springMessage(
                            'contract.conAttachmen')</td>
                        <td width="35%" >
                            <input id="attachmentId" name="attachmentId" type="hidden">
                            <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <br>
    <br>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" type="button" lay-filter="save">#springMessage('common.button.temp')</button>
            <button class="layui-btn" lay-submit="" type="button" lay-filter="submit">#springMessage('common.button.submit')</button>
            <button class="layui-btn layui-btn-primary" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/contract/conChange.add.js?_btv=${resourceVersion}"></script>

</html>
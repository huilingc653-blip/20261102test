<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-textarea {
            line-height: 20px;
        }
    </style>
</head>
<body style="padding-bottom: 60px;">
<div class="layui-fluid" style="padding: 0">
    <div class="layui-row">
        <div class="layui-col-xs12">
            <table class="layui-table">
                <thead>
                <tr>
                    <td colspan="4">#springMessage('table.externalCorp.basicInfo')</td>
                </tr>
                </thead>
                <tr>
                    <td class="text-right">#springMessage('contract.type.code')</td>
                    <td width="35%">$!{conTypeInfo.typeCode}</td>
                    <td class="text-right">#springMessage('contract.type.name')</td>
                    <td width="35%">$!{conTypeInfo.name}</td>
                </tr>
                <tr>
                    <td class="text-right">#springMessage('contract.type.isCommon')</td>
                    <td>
                        $dictTag.get("sf_yn",$!conTypeInfo.shareSign)
                    </td>
                    #if($!{conTypeInfo.shareSign}=="0")
                        <td class="text-right">#springMessage('contract.type.corpName')</td>
                        <td>
                            $!{conTypeInfo.corpName}
                        </td>
                    #end
                </tr>
                <tr>
                    <td class="text-right">#springMessage('contract.type.satus')</td>
                    <td width="35%">
                        $dictTag.get("sf_yn",$!conTypeInfo.validSign)
                    </td>
                    <td class="text-right"></td>
                    <td width="35%">
                    </td>
                </tr>
                <tr>
                    <td class="text-right">#springMessage("contract.type.rmk")</td>
                    <td colspan="3">
                        <textarea class="layui-textarea" name="rmk" data-maxlength="500" lay-verify="strlength"
                                  disabled="disabled">$!{conTypeInfo.rmk}</textarea></td>
                    </td>
                </tr>

            </table>
        </div>

    </div>
</div>
<fieldset class="layui-elem-field">
    <legend>#springMessage('contract.services.entity')</legend>
    <div class="layui-field-box">
        <table id="bankAcc" style="width:100%" class="layui-table layui-form">
            <thead>
            <tr>
                <th>#springMessage('contract.element.name')</th>
                <th>#springMessage('contract.type.rmk')</th>
                <th>#springMessage('contract.type.isnotnull')</th>
                <th>#springMessage('contract.field.type')</th>
                <th>#springMessage('contract.iseffective')</th>
                <th>#springMessage('contract.sort')</th>
            </tr>
            </thead>
            <tbody>
                #if($!conTypeInfo.conTypeFieldVO)
                    #foreach($vo in $conTypeInfo.conTypeFieldVO)
                    <tr>
                        <td style="text-align: center;">#springMessage($!{vo.fieldName})</td>
                        <td style="text-align: center;">$!{vo.rmk}</td>
                        <td style="text-align: center;">$dictTag.get("sf_yn",$!{vo.requiredSign})</td>
                        <td style="text-align: center;">$dictTag.get("CON_TYPE_FIELD_TYPE",$!{vo.fieldType})</td>
                        <td style="text-align: center;">$dictTag.get("sf_yn",$!{vo.validSign})</td>
                        <td style="text-align: center;">$!{velocityCount}</td>
                    <tr>
                    #end
                #end
            </tbody>

        </table>
    </div>
</fieldset>
    #parse("views/common/footer.vm")
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
        ## 产品类型
            <td width="15%" class="textRight">#springMessage('contract.conPdMap.pdType')</td>
            <td width="35%">
                <div class="bt-biz-dict" data-type="select" data-group="CON_PRODUCT_TYPE" data-defaultvalue="" data-name="eqs_pdCode" data-biz-name="pdCode"></div>
            </td>
        ## 合同类型
            <td width="15%" class="textRight">#springMessage('contract.conType')</td>
            <td width="35%">
                <div class="layui-inline">
                    <div class="bt-biz-conType" id="typeId" data-name="eqs_typeId"
                         data-biz-name="typeId"> </div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis" >
    <thead>
    <tr>
        <th>#springMessage('contract.conPdMap.pdType')</th>
        <th>#springMessage('contract.pdType.code')</th>
        <th>#springMessage('contract.conType')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")<script src="${basePath}/static/modules/contract/conPdMap.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form ignore-required-icon" method="post" id="inputForm">
    <div class="layui-colla-item">
    <h2 class="layui-colla-title">#springMessage('contract.conWarnRules')</h2>
        <div class="layui-colla-content layui-show" >
        <table id="conWarnRules" class="layui-table" style="width:100%;">
            <thead>
            <tr>
                <th style="padding-left: 10px;width: 100px"><button  class="layui-btn layui-btn-sm" type="button" onclick="addConWarnRules()" ><i class="layui-icon">&#xe654;</i></button></th>
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('contract.conType')</th>
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('contract.conWarnRules.beforDay')</th>
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('contract.conWarnRules.intervalDay')</th>
                <th>#springMessage('contract.conWarnRules.validSign')</th>
            </tr>
            </thead>
            <tbody>
                #foreach($info in $listConWarnRulesVO)
                <tr>
                    <td class="textCenter"><button class="layui-btn layui-btn-sm" type="button" onclick="deleteTr(this)" ><i class="layui-icon">&#xe640;</i></button></td>
                    <td><div class="layui-input-inline"><div class="bt-biz-selectType" data-biz-name="conTypeIds" data-url="${basePath}/contract/contractType/getAllConType" data-search="true"
                             data-defaultvalue="$!{info.conTypeId}" data-callback="checkData" data-required=true data-valuefield="id" data-textfield="typeName" data-name="conTypeIds"></div></div></td>
                    <td id="endDays$!{velocityCount}"><div class="layui-input-inline"><input class="layui-input bt-biz-moneyType" lay-verify="required"  data-name="intervalDays$!{velocityCount}" data-biz-name="intervalDays"
                             placeholder="#springMessage('contract.conWarnRules.intervalDay')" type="text" value="$!{info.intervalDay}" onblur="checkDay(this)" data-decimal="0" data-moneyendid="endId$!{velocityCount}"></div></td>
                    <td id="startDays$!{velocityCount}"><div class="layui-input-inline"><input class="layui-input bt-biz-moneyType" data-name="beforDays$!{velocityCount}" lay-verify="required" data-biz-name="beforDays"
                             placeholder="#springMessage('contract.conWarnRules.beforDay')" type="text" value="$!{info.beforDay}" onblur="checkDay(this)" data-decimal="0" id="endId$!{velocityCount}"></div></td>
                    <td><div class="layui-input-inline"><div class="bt-biz-dict" data-type="radio" data-defaultvalue="$!{info.validSign}"
                             data-name="validSigns$!{velocityCount}" data-biz-name="validSigns" data-group="CON_WARNRULES_VALIDSIGN"></div></div></td>
                </tr>
                #end
            </tbody>
        </table>
    </div>
        <div style="margin-right: 10px;margin-left: 10px">
            <table class="layui-table" style="width:100%;">
                <tfoot>
                <tr>
                ##合同预警规则
                    <td class="textRight">#springMessage('contract.conWarnRules.warn')</td>
                    <td>
                    <p style="margin-top: 15px">
                        #springMessage('contract.conWarnRules.warn1')<br>
                        #springMessage('contract.conWarnRules.warn2')
                    </p>
                    </td>
                </tr>
                </tfoot>
            </table>
        </div>
        <div class="layui-form-submit-adaptive">
            <div style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="save" value="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button class="layui-btn layui-btn-primary" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script>

    function conWarnRulesHtml(index) {
        var conWarnRulesHtml = '<tr>';
        conWarnRulesHtml += '<td class="textCenter"><button class="layui-btn layui-btn-sm" type="button" onclick="deleteTr(this)" ><i class="layui-icon">&#xe640;</i></button></td>';
        conWarnRulesHtml += '<td><div class="layui-input-inline"><div class="bt-biz-selectType" data-biz-name="conTypeIds" data-url="${basePath}/contract/contractType/getAllConType" ';
        conWarnRulesHtml += ' data-valuefield="id" data-textfield="typeName" data-callback="checkData" data-search="true" data-required=true data-name="conTypeIds"></div></td>';
        conWarnRulesHtml += '<td id="endDays'+index+'"><div class="layui-input-inline"><input class="layui-input bt-biz-moneyType" type="text" lay-verify="required" data-decimal="0" ' +
                'data-name="intervalDays'+index+'" onblur="checkDay(this)" placeholder="' + bt.lang('contract.conWarnRules.intervalDay') + '" value="0" data-moneyendid="endId'+index+'"></div></td>';
        conWarnRulesHtml += '<td id="startDays'+index+'"><div class="layui-input-inline"><input class="layui-input bt-biz-moneyType" type="text" lay-verify="required" data-decimal="0" ' +
                'data-name="beforDays'+index+'" onblur="checkDay(this)" placeholder="' + bt.lang('contract.conWarnRules.beforDay') + '" value="0" id="endId'+index+'"></div></td>';
        conWarnRulesHtml += '<td><div class="layui-input-inline"><div class="bt-biz-dict" data-type="radio" data-defaultvalue="1" data-name="validSigns'+index+'" ' +
                'data-biz-name="validSigns" data-group="CON_WARNRULES_VALIDSIGN"></div></div></td>';
        conWarnRulesHtml += '</tr>';
        return conWarnRulesHtml;
    }

    var index=$('tbody tr').length;

    function addConWarnRules(){
        index += 1;
        $("#conWarnRules tbody").append(conWarnRulesHtml(index));
        bt.dicts.render();
        selectType.render();
        moneyType.render();
        $('#endDays'+index).before($("#startDays"+index));
    }

    function deleteTr(obj){
        $(obj).parents("tr").remove();
    }

</script>
<script src="${basePath}/static/modules/contract/conWarnRules.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	.layui-table {
            margin: 0px 0;
		}
		body {
			margin-bottom:30px;
		}
    </style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
        <input type="hidden" id="mid" name="mid" value="$!{performanceVO.mid}" />
        <input type="hidden" id="rid" name="rid" value="$!{performanceVO.rid}" />
		<div class="layui-collapse">
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('contract.conInfo')</h2>
		<div class="layui-colla-content layui-show">
		<table class="layui-table">
			<tbody>
					<tr>
						##合同名称
                        <td class="textRight" width="15%">#springMessage('contract.conName')</td>
                        <td>
                           $!{performanceVO.conName}
                        </td>
                		##合同发起方
        				<td class="textRight" width="15%">#springMessage('contract.corpId')</td>
        				<td width="35%">
                            $!{performanceVO.corpName}
        				</td>

        			</tr>
					<tr>
						##签署方式
                        <td class="textRight"  width="15%">#springMessage('contract.signType')</td>
                        <td  width="35%">
                            $dictTag.get("CON_SIGN_TYPE",$!performanceVO.signType)
                        </td>
						##合同类型
						<td class="textRight"  width="15%">#springMessage('contract.conType')</td>
						<td width="35%">
                           $!{performanceVO.typeName}
						</td>
					</tr>
					<tr>
					##纸质合同附件
                        <td class="textRight"  width="15%">#springMessage('contract.conAttachmen')</td>
                        <td  width="35%">
                            <input id="conAttachmentId" name="conAttachmentId" type="hidden"  value="$!{performanceVO.conAttachmentId}">
                            <div id="conAttachmen"  class="layui-input-inline" style="width:100%"></div>
                        </td>
					##合同编号
                        <td class="textRight"  width="15%">#springMessage('contract.conNo')</td>
                        <td width="35%">
                            $!{performanceVO.conNo}
                        </td>
					</tr>
        			<tr>
						##合同生效日期
        				<td class="textRight" width="15%">#springMessage('contract.beginDate')</td>
        				<td width="35%">
                            $!{performanceVO.beginDate}
        				</td>
						##合同失效日期
						<td class="textRight" width="15%">#springMessage('contract.endDate')</td>
						<td width="35%">
                           $!{performanceVO.endDate}
						</td>
                    </tr>

				</tbody>
				</table>
			</div>
		</div>

		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('contract.conBusinessInfo')</h2>
			<div class="layui-colla-content layui-show">
				<table id="businessInfoTable" class="layui-table layui-form" style="width:100%;">
                    <tbody>
					</tbody>
				</table>
			</div>
		</div>

		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('contract.changeInfo')</h2>
			<div class="layui-colla-content layui-show">
				<table  class="layui-table layui-form" style="width:100%;">
					<tbody>
					<tr>
					##履约时间
                        <td class="textRight" width="15%">#springMessage('contract.performanceDate')</td>
                        <td width="35%">
                            <input type="text" name="opDate" data-name="opDate" class="layui-input bt-biz-dateType"
                                   data-type="date" data-biz-name="opDate" lay-verify="required" value="$!{performanceVO.opDate}">
                        </td>
					##履约原因
                        <td class="textRight" width="15%">#springMessage('contract.performanceMsg')</td>
                        <td width="35%">
                            <input type="text" id="opMsg" name="opMsg" lay-verify="required|strlength" value="$!{performanceVO.opMsg}"
                                   data-maxlength="200" autocomplete="off" class="layui-input" placeholder="#springMessage('contract.performanceMsg')">
                        </td>
					</tr>
                    <tr>
					##履约申请单号
                        <td class="textRight"  width="15%">#springMessage('contract.performanceNo')</td>
                        <td width="35%">
                            <input type="text" id="opNo" name="opNo" lay-verify="strlength" value="$!{performanceVO.opNo}"
                                   data-maxlength="50" autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('contract.performanceNo')">
                        </td>
					##履约金额
                        <td class="textRight"  width="15%">#springMessage('contract.performanceMoney')</td>
                        <td width="35%">
                            <input type="text" data-name="opMoney" class="layui-input bt-biz-moneyType" value="$!{performanceVO.opMoney}"
                                   placeholder="#springMessage('contract.performanceMoney')"  id="opMoney" >
                        </td>
                    </tr>
                    <tr>
					##履约附件
                        <td class="textRight" width="15%">#springMessage(
							'contract.performanceAttachmen')</td>
                        <td width="35%" >
                            <input id="attachmentId" name="attachmentId" type="hidden"  value="$!{performanceVO.attachmentId}">
                            <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
                        </td>
						<td></td>
                        <td></td>
                    </tr>
					</tbody>
				</table>
			</div>
		</div>

  		</div>
		<br>
		<br>

		<div class="layui-form-item layui-form-submit">
			<div class="layui-input-block">
				<button class="layui-btn" lay-submit="" type="button" lay-filter="save">#springMessage('common.button.temp')</button>
				<button class="layui-btn" lay-submit="" type="button" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn layui-btn-primary" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/contract/conPerformance.edit.js?_btv=${resourceVersion}"></script>

</html>

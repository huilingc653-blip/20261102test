<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
     <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
					## 合同状态
					<td class="textRight">#springMessage('contract.conStatus')</td>
					<td width="25%">
                        <div class="bt-biz-dict" data-type="select" data-group="CON_INFO_STATUS" data-name="eqs_ciStatusName" data-filterData="-99"></div>
                    </td>
					##合同类型
                    <td class="textRight">#springMessage('contract.conType')</td>
                   	<td width="25%">
                        <div class="layui-inline">
                               <div class="bt-biz-conType" id="typeName" data-name="ins_typeName"
                                    data-biz-name="typeName" data-resource="contract:overview:query:opt"> </div>
                        </div>
                    </td>
                    ## 合同编号
                    <td class="textRight">#springMessage('contract.conNo')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_conNo"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('contract.conNo')">
                        </div>
                    </td>
				</tr>
				<tr>
					##签署方式
                    <td class="textRight">#springMessage('contract.signType')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="CON_SIGN_TYPE" data-name="eqs_signType"></div>
                    </td>
					##合同业务类型
                    <td class="textRight">#springMessage('contract.corpId')</td>
                    <td width="25%">
								<div class="layui-input-inline" id="corpId">
            					<div class="bt-biz-corp"
			                         data-biz-type="corp"
			                         data-biz-name="corpId"
			                         data-type="selectTree"
			                         data-name="eqs_corpId"
			                         data-scope="all"
									data-resource="contract:overview:query:opt"
                                    data-callbackData="corpCallback"
									placeholder="#springMessage('contract.corpId')">
            					</div>
                            </div>
                   </td>
                    <td class="textRight">#springMessage('contract.complete.date')</td>
                    <td>
                      <div class="layui-inline">
                    	<input type="text" name="ged_transDate" class="layui-input bt-biz-dateType" data-endid="led_transDate" data-today="false">
                	  </div>
	                	<span class="date-mid">~</span>
	                	<div class="layui-inline">
	                    	<input type="text" name="led_transDate" class="layui-input bt-biz-dateType" id="led_transDate" data-today="false">
	               		 </div>
                    </td>
				</tr>

##				#if($shiro.hasPermission("contract:overview:query:opt"))
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
##				#end
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('contract.corpId')</th>
        <th>#springMessage('contract.conName')</th>
		<th>#springMessage('contract.conType')</th>
		<th>#springMessage('contract.conNo')</th>
		<th>#springMessage('contract.signType')</th>
		<th>#springMessage('contract.draftDate')</th>
		<th>#springMessage('contract.complete.date')</th>
		<th>#springMessage('contract.beginDate')</th>
		<th>#springMessage('contract.endDate')</th>
		<th>#springMessage('contract.suspend.date')</th>
		<th>#springMessage('contract.status')</th>
		<th>#springMessage('contract.performance.count')</th>
		<th>#springMessage('contract.change.count')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/contract/js/contractQuery.list.js?_btv=${resourceVersion}"></script>
</html>

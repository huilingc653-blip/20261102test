#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
#if($!conInfo)
    <li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('contract.conInfo')</a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('contract.corpId')
                <span class="mui-badge mui-badge-inverted">
                    $!{conInfo.corpName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('contract.conType')
                <span class="mui-badge mui-badge-inverted">
                    $!{conInfo.typeName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('contract.conNo')
                <span class="mui-badge mui-badge-inverted">
                   $!{conInfo.conNo}
                </span>
            </li>
            <li class="mui-table-view-cell">
               #springMessage('contract.conName')
                <span class="mui-badge mui-badge-inverted">
                  $!{conInfo.conName}
                </span>
            </li>
             <li class="mui-table-view-cell">
               #springMessage('contract.signType')
                <span class="mui-badge mui-badge-inverted">
                $!{conInfo.signTypeName}
                </span>
            </li>
             <li class="mui-table-view-cell">
              #springMessage('contract.conStatus')
                <span class="mui-badge mui-badge-inverted">
                $!{conInfo.statusName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('contract.beginDate')
                <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{conInfo.beginDate})
                </span>
            </li>
             <li class="mui-table-view-cell">
                #springMessage('contract.endDate')
                <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{conInfo.endDate})
                </span>
            </li>
        </ul>
    </li>

    #if($!conInfo.busdtlList)
    <li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('contract.conBusinessInfo')</a>
        <ul class="mui-table-view H-theme-background-color-white">
      	  #foreach($vtDaField in $conInfo.busdtlList)
			 <li class="mui-table-view-cell">
		        #springMessage("$!{vtDaField.name}")
		        <span class="mui-badge mui-badge-inverted">
		        	#if(${vtDaField.val})
					#if($!vtDaField.fieldType eq "02")
						$!number.formatNumeric($!number.formatNumeric($!{vtDaField.val}))
					#elseif($!vtDaField.fieldType eq "05")
						#set($valNum = $!number.formatNumeric(${vtDaField.val}) * 100)
						$!number.formatNumeric($!valNum,'#,##0.0000')%
					#else
						$!{vtDaField.val}
					#end
					#end
       			 </span>
    		</li>	
		  #end
        </ul>
    </li>
    #end
    
    #if($!conInfo.ciStatus==80 || $!conInfo.ciStatus==90)
    <li class="mui-table-view-divider">#springMessage('contract.conBusinessInfo')</li>
    <li class="mui-table-view-cell">
        #springMessage('contract.suspend.reason')
        <span class="mui-badge mui-badge-inverted">
        $!{conInfo.opMsg}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('contract.suspend.date')
        <span class="mui-badge mui-badge-inverted">
        $!date.format('yyyy-MM-dd',$!{conInfo.opDate})
        </span>
    </li>
     <li class="mui-table-view-cell">
        #springMessage('contract.suspend.applyno')
        <span class="mui-badge mui-badge-inverted">
        $!date.format('yyyy-MM-dd',$!{conInfo.opNo})
        </span>
    </li>
    #end
#end

#if($!conBusiness)
    #set($vmPage = "views/contract/mobile/approve"+${conBusiness}+".vm")
    #parse($vmPage)
#end

    #parse("views/common/wapfooter.vm")
</body>
</html>

#*
*合同履约
*#
<li class="mui-table-view-cell mui-collapse mui-active">
    <a class="mui-navigate-right" href="#">#springMessage('contract.performanceInfo')</a>
    <ul class="mui-table-view H-theme-background-color-white">
        #if($!performanceVO)
        ##履约时间
            <li class="mui-table-view-cell">
                #springMessage('contract.performanceDate')
                <span class="mui-badge mui-badge-inverted">
                    $!date.format('yyyy-MM-dd',$!{performanceVO.opDate})
                </span>
            </li>
        ##履约原因
            <li class="mui-table-view-cell">
                #springMessage('contract.performanceMsg')
                <span class="mui-badge mui-badge-inverted">
                    $!{performanceVO.opMsg}
                </span>
            </li>
        ##履约申请单号
            <li class="mui-table-view-cell">
                #springMessage('contract.performanceNo')
                <span class="mui-badge mui-badge-inverted">
                    $!{performanceVO.opNo}
                </span>
            </li>
        ##履约金额
            <li class="mui-table-view-cell">
                #springMessage('contract.performanceMoney')
                <span class="mui-badge mui-badge-inverted">
                #if($!{performanceVO.opMoney})
                    $number.formatNumeric($!{performanceVO.opMoney})
                #else
                    $number.formatNumeric("0.00")
                #end
                </span>
            </li>
        #end
    </ul>
</li>

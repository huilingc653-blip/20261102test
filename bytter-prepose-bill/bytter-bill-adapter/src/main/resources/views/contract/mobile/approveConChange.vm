#* 
*合同变更
*#
    <li class="mui-table-view-cell mui-collapse mui-active">
        <a class="mui-navigate-right" href="#">#springMessage('contract.changeInfo')</a>
        <ul class="mui-table-view H-theme-background-color-white">
	#if($!conChangeVO)
		<li class="mui-table-view-cell">
			#springMessage('contract.changeDate')
            <span class="mui-badge mui-badge-inverted">
				$!{conChangeVO.opDate}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('contract.changeMsg')
            <span class="mui-badge mui-badge-inverted">
				$!{conChangeVO.opMsg}
    		</span>
        </li>
		<li class="mui-table-view-cell">
			#springMessage('contract.type.rmk')
            <span class="mui-badge mui-badge-inverted">
				$!{conChangeVO.rmk}
    		</span>
        </li>
	#end
        </ul>
    </li>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body style="padding-bottom: 60px;">
<form class="layui-form" id="inputForm">
    <div class="layui-fluid" style="padding: 0">
        <div class="layui-row">
            <div class="layui-col-xs12">
                <table class="layui-table">
                    <thead>
                    <tr>
                        <th colspan="4" style="text-align: left"><h2>#springMessage('contract.type.basicInfo')</h2></th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                    #if($isAdd)
                    ## 产品类型
                        <td width="15%" class="textRight">#springMessage('contract.conPdMap.pdType')</td>
                        <td width="35%">
                            <div class="bt-biz-dict" data-type="select" data-group="CON_PRODUCT_TYPE" data-required="true" id="pdCode"
                                 data-callback="selectDict" data-name="pdCode" data-biz-name="pdCode"></div>
                        </td>
                    ## 合同类型
                        <td width="15%" class="textRight">#springMessage('contract.conType')</td>
                        <td width="35%">
                            <div class="layui-inline">
                                <div class="bt-biz-conType" id="typeId" data-name="typeId" data-callback="selectField"
                                     data-biz-name="typeName" data-required="true" > </div>
                            </div>
                        </td>
                    #end
                    #if($isUpdate)
                        <input name="typeId" type="hidden" value="$!{conPdMapVO.typeId}">
                        <input name="pdCode" type="hidden" value="$!{conPdMapVO.pdCode}">
                    ## 产品类型
                        <td width="15%" class="textRight">#springMessage('contract.conPdMap.pdType')</td>
                        <td width="35%">
                            $!dictTag.get("CON_PRODUCT_TYPE",$!{pdCode})
                        </td>
                    ## 合同类型
                        <td width="15%" class="textRight">#springMessage('contract.conType')</td>
                        <td width="35%">
                            $!{typeName}
                        </td>
                    #end
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
            <table class="layui-table" id="pdTable">
                <thead>
                <tr>
                    <th colspan="4" style="text-align: left"><h2>#springMessage('contract.services.entity')</h2></th>
                </tr>
                <tr>
                    <th style="width: 380px">#springMessage('contract.element.name')</th>
                    <th style="width: 380px">#springMessage('contract.conPdMap.fieldName')</th>
                </tr>
                </thead>
                <tbody id="fieldNameTab">
                    #foreach($data in $pdDtlList)
                    <tr>
                        <td style="text-align: center">
                            <input type="hidden" value="$!{data.conTypeDtlId}" name="conTypeDtlIds"/>
                            #springMessage($!{data.fieldName})
                        </td>
                        <td>
                            <div class="bt-biz-dict" data-group="$!{pdCode}" data-type="select" data-name="pdDtlCodes" #if($!{data.requiredSign} == "1")data-required="true"#end
                                 data-defaultvalue="$!{data.pdDtlCode}" data-name="pdDtlCodes"></div>
                        </td>
                    </tr>
                    #end
                </tbody>
            </table>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" lay-filter="save" type="button">#springMessage('common.button.save')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            <button class="layui-btn layui-btn-primary" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/contract/conPdMap.add.js?_btv=${resourceVersion}"></script>
</body>
</html>
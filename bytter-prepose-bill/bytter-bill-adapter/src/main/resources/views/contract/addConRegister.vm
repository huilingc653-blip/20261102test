<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	.layui-table {
            margin: 0px 0;
		}
		body {
			margin-bottom:30px;
		}
    </style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">

		<div class="layui-collapse">
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('contract.conInfo')</h2>
		<div class="layui-colla-content layui-show">
		<table class="layui-table">
			<tbody>
					<tr>
						##合同名称
                        <td class="textRight" width="15%">#springMessage('contract.conName')</td>
                        <td>
                            <input type="text" id="conName" name="conName"  lay-verify="required|strlength" data-maxlength="100"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('contract.conName')">
                        </td>
                		##合同发起方
        				<td class="textRight" width="15%">#springMessage('contract.corpId')</td>
        				<td width="35%">
        					<div class="layui-input-inline" id="corpId">
            					<div class="bt-biz-corp"
                                    data-biz-type="corp"
                                    data-biz-name="corpId"
                                    data-type="selectTree"
                                    data-name="corpId"
                                    data-scope="all"
            						data-required="true"
									data-resource="con:conregister:resource:op"
                                     data-callbackData="corpCallback"
									placeholder="#springMessage('contract.corpId')">
            					</div>
                            </div>
        				</td>

        			</tr>
					<tr>
						##签署方式
                        <td class="textRight"  width="15%">#springMessage('contract.signType')</td>
                        <td  width="35%">
                            <div class="bt-biz-dict" data-type="select" data-group="CON_SIGN_TYPE" data-defaultvalue="0" data-placeholder="" data-name="signType" ></div>
                        </td>
						##合同类型
						<td class="textRight"  width="15%">#springMessage('contract.conType')</td>
						<td width="35%">
                            <div class="layui-inline">
                                <div class="bt-biz-conType" id="typeId" data-name="typeId" data-required="true"
                                     data-biz-name="typeId" data-resource="con:conregister:resource:op" data-callback="bt.conTypeCallback" > </div>
                            </div>
						</td>
					</tr>
					<tr>
					##纸质合同附件
                        <td class="textRight"  width="15%"><span><font style="color: red;font-size: 16px">*&nbsp;</font></span>#springMessage('contract.conAttachmen')</td>
                        <td  width="35%">
                            <input id="attachmentId" name="attachmentId" type="hidden" >
                            <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
                        </td>
					##合同编号
                        <td class="textRight"  width="15%">#springMessage('contract.conNo')</td>
                        <td width="35%">
                            <input type="text" id="conNo" name="conNo"  lay-verify="required|strlength" data-maxlength="50"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('contract.conNo')">
                        </td>
					</tr>
        			<tr>
						##合同生效日期
        				<td class="textRight" width="15%">#springMessage('contract.beginDate')</td>
        				<td width="35%">
							<input type="text" name="beginDate" data-name="beginDate" class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date"
                                       data-biz-name="beginDate"  lay-verify="required" >
        				</td>
						##合同失效日期
						<td class="textRight" width="15%">#springMessage('contract.endDate')</td>
						<td width="35%">
                            <input type="text" name="endDate" data-name="endDate" class="layui-input bt-biz-dateType" id="endDate" data-type="date"
                                   data-biz-name="endDate"  lay-verify="required" >
						</td>
                    </tr>

				</tbody>
				</table>
			</div>
		</div>

		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('contract.conBusinessInfo')</h2>
			<div class="layui-colla-content layui-show">
				<table id="businessInfoTable" class="layui-table layui-form" style="width:100%;">
                    <tbody>
					</tbody>
				</table>
			</div>
		</div>
  		</div>
		<br>
		<br>

		<div class="layui-form-item layui-form-submit">
			<div class="layui-input-block">
				<button class="layui-btn" lay-submit="" type="button" lay-filter="save">#springMessage('common.button.temp')</button>
				<button class="layui-btn" lay-submit="" type="button" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn layui-btn-primary" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/contract/conRegister.add.js?_btv=${resourceVersion}"></script>

</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
     <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
					## 合同名称
					<td class="textRight">#springMessage('contract.conName')</td>
					<td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_conName"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('contract.conName')">
                        </div>
                    </td>
					##合同类型
                    <td class="textRight">#springMessage('contract.conType')</td>
                   	<td width="25%">
                        <div class="layui-inline">
                               <div class="bt-biz-conType" id="typeName" data-name="ins_typeName"
                                    data-biz-name="typeName" data-resource="contract:overview:query:opt"> </div>
                        </div>
                    </td>
                    ## 合同编号
                    <td class="textRight">#springMessage('contract.conNo')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_conNo"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('contract.conNo')">
                        </div>
                    </td>
				</tr>
				<tr>
					##签署方式
                    <td class="textRight">#springMessage('contract.signType')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="CON_SIGN_TYPE" data-name="eqs_signType"></div>
                    </td>
					##合同终止审批状态
                    <td class="textRight">#springMessage('contract.status')</td>
                    <td width="25%">
                        <div class="bt-biz-dict" data-type="select" data-group="CON_TERMINATE_STATUS" data-name="eqs_apprveStatusName" data-filterData="-99"></div>
                    </td>
                    <td class="textRight"></td>
                    <td>
                    </td>
				</tr>

##				#if($shiro.hasPermission("contract:overview:query:opt"))
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
##				#end
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('contract.corpId')</th>
        <th>#springMessage('contract.conName')</th>
		<th>#springMessage('contract.conType')</th>
		<th>#springMessage('contract.conNo')</th>
		<th>#springMessage('contract.signType')</th>
		<th>#springMessage('contract.draftDate')</th>
		<th>#springMessage('contract.beginDate')</th>
		<th>#springMessage('contract.endDate')</th>
		<th>#springMessage('contract.status')</th>
		<th>#springMessage('contract.terminateMsg')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/contract/js/contractSuspend.list.js?_btv=${resourceVersion}"></script>
</html>

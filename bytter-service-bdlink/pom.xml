<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.bytter</groupId>
        <artifactId>bytter-parent</artifactId>
        <version>2.0.0.RELEASE</version>
    </parent>

    <artifactId>bytter-service-bdlink</artifactId>
    <version>2.0.0.RELEASE</version>
    <packaging>pom</packaging>
    <name>bytter-service-bdlink</name>
    <description>bytter-service-bdlink</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <modules>
        <module>bytter-bdlink-adapter</module>
        <module>bytter-bdlink-client</module>
        <module>bytter-bdlink-domain</module>
        <module>bytter-bdlink-start</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.bytter</groupId>
                <artifactId>bytter-bdlink-adapter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.bytter</groupId>
                <artifactId>bytter-bdlink-client</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.bytter</groupId>
                <artifactId>bytter-bdlink-domain</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bytter</groupId>
            <artifactId>bytter-framework</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bytter</groupId>
            <artifactId>bytter-velocity</artifactId>
            <version>${revision}</version>
        </dependency>

        <!--    com.sun.tools.javac.code.Symbol$CompletionFailure: 找不到javax.interceptor.InterceptorBinding的类文件    -->
        <dependency>
            <groupId>javax.interceptor</groupId>
            <artifactId>javax.interceptor-api</artifactId>
            <version>1.2</version>
        </dependency>
    </dependencies>
</project>

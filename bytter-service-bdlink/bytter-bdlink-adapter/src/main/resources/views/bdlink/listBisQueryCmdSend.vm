<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<input id="opType" name="opType" type="hidden" value="listQuerySend">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##单位ID
                    <td class="textRight">#springMessage('table.bisExc.corpId')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="ins_corpId"
                                 data-scope="all" data-resource="netbank:bdLink:bisQueryCmd:query"></div>
                        </div>
                    </td>
                    ##接口代码
                    <td class="textRight">#springMessage('table.bisExc.bifCode')</td>
                    <td >
                        <div data-name="eqs_bifCode" class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/listFilter" data-valueField="id" data-textField="name"
                             data-search="true" data-defaultval="$!{bisQueryCmdPage.bifCode}"></div>
                    </td>
                    ##交易类型
                    <td class="textRight">#springMessage('table.bisQueryCmd.transId')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="bisQueryCmd.transId" data-name="eqs_transId"></div>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##账号
                    <td class="textRight">#springMessage('table.bisQueryCmd.bankAcc')</td>
                    <td >
                        <input type="text" name="likes_bankAcc"
                               autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.bisQueryCmd.bankAcc')">
                    </td>
                    ##账户名称
                    <td class="textRight">#springMessage('table.bisQueryCmd.accName')</td>
                    <td >
                        <input type="text" name="likes_accName"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisQueryCmd.accName')">
                    </td>
                    ##交易状态
                    <td class="textRight">#springMessage('table.bisExc.voucherStat')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="bisExc.voucherStat" data-name="eqs_cmdStat" data-displayData="1,2,3"></div>
                    </td>
                </tr>
                <tr>
                    ##发送时间
                    <td class="textRight">#springMessage('table.bisQueryCmd.sendTime')</td>
                    <td colspan="5">
                        <input type="text" name="ged_sendTime" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_sendTime" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_sendTime" class="layui-input bt-input-inline bt-biz-dateType" id="led_sendTime">
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('table.bisExc.voucherNo')</th>
		<th>#springMessage('table.bisExc.bifCode')</th>
        <th>#springMessage('table.nisBillhead.corpId')</th>
		<th>#springMessage('table.bisQueryCmd.bankAcc')</th>
		<th>#springMessage('table.bisQueryCmd.accName')</th>
		<th>#springMessage('table.bisQueryCmd.bankName')</th>
		<th>#springMessage('table.bisExc.curId')</th>
        <th>#springMessage('table.bisQueryCmd.transId')</th>
        <th>#springMessage('table.bisQueryCmd.startTime')</th>
		<th>#springMessage('table.bisQueryCmd.endTime')</th>
		<th>#springMessage('table.bisQueryCmd.sendTime')</th>
        <th>#springMessage('table.bisExc.returnTime')</th>
        <th>#springMessage('table.bisExc.firstReturnMsg')</th>
		<th>#springMessage('table.bisExc.nextReturnMsg')</th>
		<th>#springMessage('table.bisExc.cmdType')</th>
		<th>#springMessage('table.bisGatherCmd.cmdStat')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bdlink/bisQueryCmd.listSend.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form id="searchForm" class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{bisQueryCmdPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{bisQueryCmdPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{bisQueryCmdPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{bisQueryCmdPage.updateDate}">
		<input id="cmdStat" name="cmdStat" type="hidden" value="3">
        <table class="layui-table">
			<tbody>
    			<tr>
					##单位ID
					<td class="textRight">#springMessage('table.bisExc.corpId')</td>
					<td>
						<div class="layui-input-inline">
							<div class="bt-biz-corp"
								 data-biz-type="corp"
								 data-type="selectTree"
								 data-tree-type="check"
								 data-name="ins_corpId"
								 data-callback="bt.corpCallback"
								 data-scope="all" data-resource="netbank:bdLink:bisQueryCmd:sendQuery"></div>
						</div>
					</td>
            		##接口代码
                    <td class="textRight">#springMessage('table.bisExc.bifCode')</td>
                    <td >
						<div data-name="likes_bifCode" class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/json" data-valueField="id" data-textField="name"
    							data-required="true" data-search="true" data-callback="bt.bifCodeCallback"></div>
                    </td>
    			</tr>
				<tr>
				##银行账号
                    <td class="textRight">#springMessage('table.btBankAccApp.bankAcc')</td>
                    <td>
                        <input type="text" name="likes_bankAcc"
                               autocomplete="off" class="bank layui-input" placeholder="#springMessage('table.btBankAccApp.bankAcc')" onchange="accCallback()">
                    </td>
					##交易类型
					<td class="textRight">#springMessage('table.bisQueryCmd.transId')</td>
					<td>
						<div class="layui-input-inline">
							<div class="bt-biz-dict" data-type="select" data-group="bisQueryCmd.transId" data-name="transId" data-required="true" data-callback="bt.transIdCallback"></div>
						</div>
					</td>
				</tr>
				<tr style="display:none" id="dateTr">
            		##开始日期
                    <td class="textRight">#springMessage('table.bisQueryCmd.startTime')</td>
                    <td >
						<div class="layui-input-inline">
							<input type="text" name="startTime" lay-verify="required" class="layui-input bt-biz-dateType" data-endid="endTime" 
                                   data-today="true" data-type="date" data-name="startTime" data-biz-name="startTime" value="$!{startTime}">
						</div>
                    </td>
                    ##结束日期
                    <td class="textRight">#springMessage('table.bisQueryCmd.endTime')</td>
                    <td>
                        <div class="layui-input-inline">
							<input type="text" name="endTime" lay-verify="required" class="layui-input bt-biz-dateType"
                                   data-today="true" data-type="date" data-name="endTime" data-biz-name="endTime" id="endTime">
						</div>
                    </td>
    			</tr>
            	<tr>
    				##备注
    				<td class="textRight">#springMessage('table.bisQueryCmd.rmk')</td>
    				<td colspan="3">
						<textarea placeholder="#springMessage('table.bisQueryCmd.rmk')" class="layui-textarea" style="width:100%" id="rmk" name="rmk" ></textarea>
    				</td>
    			</tr>
				<tr>
    				<td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
    					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
    					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
        	</tbody>
        </table>
	</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.btBankAccApp.bankAcc')</th>
            <th>#springMessage('table.btBankAccApp.accName')</th>
            <th>#springMessage('table.btBankAccApp.corpId')</th>
            <th>#springMessage('table.btBankAccApp.curId')</th>
            <th>#springMessage('table.btBankAccApp.accType')</th>
            <th>#springMessage('table.btBankAccApp.attributeId')</th>
            <th>#springMessage('table.btBankAccApp.natureId')</th>
            <th>#springMessage('table.bisExc.bifCode')</th>
            <th>#springMessage('table.btBankAccApp.bankName')</th>
			<th>#springMessage('table.btBankAcc.parentSign')</th>
        </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
    <script src="${basePath}/static/modules/bdlink/bisQueryCmd.add.js?_btv=${resourceVersion}"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form id="searchForm" class="layui-form">
		<table class="layui-table">
            <tbody>
            	<tr>
                    <td class="textRight">#springMessage("table.btBankAcc.corpId")</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="eqs_corpId"
                                 data-scope="all"
                                 data-resource="netbank:bankAcc:bisAccDtlCheck:apply"></div>
                        </div>
                    </td>
                	<td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json"
                             data-name ="eqs_bankTypeId" data-biz-name ="eqs_bankTypeId"  data-valueField="id" data-textField="typeName"></div>
                    </td>
                    <td class="textRight">#springMessage('table.btBankAcc.bankName')</td>
                    <td>
                        <input type="text" id="likes_bankName" name="likes_bankName" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankName')"/>
                    </td>
                </tr>
                <tr>
                    <td class="textRight">#springMessage('table.btBankAcc.bankAcc')</td>
                    <td>
                    	<input type="text" id="likes_bankAcc" name="likes_bankAcc" value="$!{btBankAcc.bankAcc}" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankAcc')"/>
                    </td>
                    <td class="textRight">#springMessage('table.btBankAcc.isOnlineView')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select"
                             data-group="sf_yn" data-name="eqs_isOnline" ></div>
                    </td>
                    <td class="textRight">#springMessage('table.bisAccDtlCheck.isCheck')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select"
                             data-group="sf_yn" data-name="eqs_isCheck" ></div>
                    </td>
                </tr>
                <tr>
                	<td align="center" colspan="6">
                        <button class="layui-btn" lay-submit lay-filter="search" id="send">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.btBankAcc.bankAcc')</th>
                <th>#springMessage('table.bisAccDtlCheck.isCheck')</th>
                <th>#springMessage('table.btBankAcc.accName')</th>
                <th>#springMessage('table.btBankAccCur.cur')</th>
                <th>#springMessage('table.btBankAcc.bankName')</th>
                <th>#springMessage('table.btBankAcc.corpId')</th>
                <th>#springMessage('table.btBankAccApp.bankTypeId')</th>
                <th>#springMessage('table.fcAcc.accState')</th>
                <th>#springMessage('table.btBankAcc.isValidSign')</th>
                <th>#springMessage('table.btBankAcc.isOnlineView')</th>
            </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/setCheckBankAcc.js?_btv=${resourceVersion}"></script>
</html>
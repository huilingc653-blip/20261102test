<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody >
        <tr>
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.corp')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="ins_corpId"
                         data-scope="all" data-resource="netbank:bankAcc:bisAccDtlCheck:apply"
                         data-callback="corpCallback"></div>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.bankAcc')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" id="likes_bankAcc" name="likes_bankAcc" data-name="likes_bankAcc" data-biz-name="likes_bankAcc" accountType="2,3" autocomplete="off" containDelBankAcc="true"
                           data-resource="netbank:bankAcc:bisAccDtlCheck:apply"  class="layui-input bt-biz-accountTable" data-callback="accountCallBack" permission="D"/>
                </div>
            </td>
        </tr>
        <tr>
            ##状态
            <td class="textRight">#springMessage('table.btBankAcc.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="bisAccDtlCheck.status" data-name="eqs_status"
                     data-biz-name="eqs_status" data-defaultvalue="0"></div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.bisAccDtlCheck.checkDate')</td>
            <td width="30%">
                <input type="text" name="ged_checkDate" data-type="date" data-biz-name="ged_checkDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_checkDate" value="$!{gedCheckDate}">
                <span class="date-mid">~</span>
                <input type="text" name="led_checkDate" data-type="date" data-biz-name="led_checkDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_checkDate" data-today="true">
            </td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btBankAcc.status')</th>
        <th>#springMessage('table.bisAccDtlCheck.checkDate')</th>
        <th>#springMessage('table.btBankAccDtl.corp')</th>
        <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
        <th>#springMessage('table.btBankAccDtl.accName')</th>
        <th>#springMessage('table.btBankAccApp.curId')</th>
        <th>#springMessage('table.btBankAccDtl.bankName')</th>
        <th>#springMessage('table.btBankAccDtl.bal')</th>
        <th>#springMessage('table.bisAccDtlCheck.checkBal')</th>
        <th>#springMessage('table.bisAccDtlCheck.diffBal')</th>
        <th>#springMessage('table.btBankAcc.createDate')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisAccDtlCheck.list.js?_btv=${resourceVersion}"></script>
</html>

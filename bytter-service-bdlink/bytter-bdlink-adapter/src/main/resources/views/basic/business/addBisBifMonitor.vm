<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
	<table class="layui-table">
		<tbody>
		<tr>
			<td class="textRight" width="40%">#springMessage('btBankType.typeName')</td>
			<td width="60%">
				<div class="layui-input-inline">
					<div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/bisbifinit/getDisConnectionAlert" data-method="get" data-required="true" data-filterData="$!{filterBisBifIds}"
						 data-valuefield="id" data-textfield="name" data-name="bisBifId" data-biz-name="bisBifId" data-inputvalue="inputvalue" data-search="true"></div>
				</div>
			</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage("table.sysTask.type")</td>
			<td>
				<div class="bt-biz-dict" data-group="bisBifMonitor.taskType" data-name="taskType" data-biz-name="taskType" data-type="select"
					 data-defaultvalue="0" data-required="true"></div>
			</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage("table.bisBifMonitor.monitorHz")</td>
			<td>
				<div class="layui-input-inline">
					<input type="text" name="monitorHz" data-biz-name="'monitorHz" autocomplete="off" lay-verify="required|number2"
						   class="layui-input bt-biz-moneyType" data-decimal="0" data-separator="">
				</div>
				<div class="layui-input-inline">#springMessage('common.unit.minute')</div>
			</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage('table.bisBifMonitor.roleIds')</td>
			<td>
				<div class="layui-input-inline">
					<div class="bt-biz-mulselectType" data-url="${basePath}/sys/role/json" data-method="get" data-required="true"
						 data-valuefield="id" data-textfield="name" data-name="roleIds" data-biz-name="roleIds" data-inputvalue="inputvalue" data-search="true"></div>
				</div>
			</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage('table.fcFreeze.status')</td>
			<td>
				<div class="bt-biz-dict" data-type="radio" data-group="fcCorpPool.status" data-defaultvalue="1"
					 data-name="status" data-biz-name="status" data-required="true"></div>
			</td>
		</tr>
		<tr>
			<td colspan="2" style="text-align: center;">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</td>
		</tr>
		</tbody>
	</table>
</form>
	#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/basic/business/bisBifMonitor.add.js?_btv=${resourceVersion}"></script>
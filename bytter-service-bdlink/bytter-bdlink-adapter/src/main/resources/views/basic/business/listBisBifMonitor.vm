<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('btBankType.typeName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/bisbifinit/json" data-method="get"
                         data-valuefield="id" data-textfield="name" data-name="ins_bisBifId" data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.bisBifMonitor.roleIds')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/sys/role/json" data-method="get"
                         data-valuefield="id" data-textfield="name" data-name="ins_roleIds" data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.fcFreeze.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="fcCorpPool.status" data-name="eqs_status" ></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('btBankType.typeName')</th>
        <th>#springMessage('table.sysTask.type')</th>
        <th>#springMessage('table.bisBifMonitor.monitorHz')(#springMessage('common.unit.minute'))</th>
        <th>#springMessage('table.bisBifMonitor.roleIds')</th>
        <th>#springMessage('table.fcFreeze.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/bisBifMonitor.list.js?_btv=${resourceVersion}"></script>
</html>

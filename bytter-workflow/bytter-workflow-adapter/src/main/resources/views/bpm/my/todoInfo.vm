#if($!{configTag.getConfig('sys','uiStyle')} == "1")

<div class="content-information-container layui-show" id="pendingInformation">
    <div class="content-information-item content-information-item1" href-url="/bpm/my/todoPage">
        <div>
            <span class="iconfont bywait_a"></span>
            <span class="text" title="#springMessage("bpm.message.beApprove")">#springMessage("bpm.message.beApprove")</span>
            <span class="count">
                #if($!data.todoCount > 999)
                    999+
                #else
                    $!{data.todoCount}
                #end
            </span>
        </div>
    </div>
    <div class="content-information-item content-information-item2" href-url="/bpm/my/trackPage">
        <div>
            <span class="iconfont bywait_b"></span>
            <span class="text" title="#springMessage("bpm.message.trace")">#springMessage("bpm.message.trace")</span>
            <span class="count">
                #if($!data.startCount > 999)
                    999+
                #else
                    $!{data.startCount}
                #end
            </span>
        </div>
    </div>
    <div class="content-information-item content-information-item3" href-url="/sys/notification/todoPage">
        <div>
            <span class="iconfont bywait_c"></span>
            <span class="text" title="#springMessage("sys.notification.todo")">#springMessage("sys.notification.todo")</span>
            <span class="count">
                #if($!data.notificationCount > 999)
                    999+
                #else
                    $!{data.notificationCount}
                #end
            </span>
        </div>
    </div>
</div>
<div class="content-information-container" id="finishedInformation">
    <div class="content-information-item content-information-item1" href-url="/bpm/my/approvedPage">
        <div>
            <span class="iconfont bywait_a"></span>
            <span class="text" title="#springMessage("sys.notification.todo")">#springMessage("common.field.approved")</span>
            <span class="count">
                #if($!data.finishedCount > 999)
                               999+
                #else
                    $!{data.finishedCount}
                #end
            </span>
        </div>
    </div>
</div>

#else

<div class="content-information layui-row layui-col-space20 layui-show" id="pendingInformation" style="display: none">
    <div class="layui-col-lg4 layui-col-sm4">
        <div class="content-information-item" href-url="/bpm/my/todoPage">
               <span class="layui-clear">
                   <span class="font_family icon-daishenpi information-font-first"></span>
                   <span class="information-text">
                        <div class="content-boby-number">
                            #if($!data.todoCount > 999)
                                999+
                            #else
                                $!{data.todoCount}
                            #end
                        </div>
                       ##                        待审批
                        <div class="content-boby-name" title="#springMessage("bpm.message.beApprove")">#springMessage("bpm.message.beApprove")</div>
                    </span>
               </span>
        </div>
    </div>
    <div class="layui-col-lg4 layui-col-sm4">
        <div class="content-information-item" href-url="/bpm/my/trackPage">
                <span class="layui-clear">
                    <span class="font_family icon-liuchenggenzong information-font-first"></span>
                    <span class="information-text">
                       <div class="content-boby-number">
                           #if($!data.startCount > 999)
                        999+
                           #else
                               $!{data.startCount}
                           #end
                       </div>
                        ##                        流程跟踪
                       <div class="content-boby-name" title="#springMessage("bpm.message.trace")">#springMessage("bpm.message.trace")</div>
                   </span>
                </span>
        </div>
    </div>
    <div class="layui-col-lg4 layui-col-sm4">
        <div class="content-information-item" href-url="/sys/notification/todoPage">
                <span class="layui-clear">
                    <span class="font_family icon-daichuli information-font-first"></span>
                    <span class="information-text">
                       <div class="content-boby-number">
                           #if($!data.notificationCount > 999)
                               999+
                           #else
                               $!{data.notificationCount}
                           #end
                       </div>
                        ##                        待处理
                       <div class="content-boby-name" title="#springMessage("sys.notification.todo")">#springMessage("sys.notification.todo")</div>
                   </span>
                </span>
        </div>
    </div>
</div>
<div class="content-information layui-row layui-col-space20" id="finishedInformation" style="display: none">
    <div class="layui-col-lg4 layui-col-sm4">
        <div class="content-information-item" href-url="/bpm/my/approvedPage">
            <span class="layui-clear">
##                <img src="${basePath}/static/v3.2/images/index/approval.png" class="information-img">
                <img src="" class="information-img" id="approvalImg">
                ##                 <span class="font_family icon-liuchenggenzong information-font-first"></span>
                <span class="information-text">
                   <div class="content-boby-number" id="approvedCount" style="color: #51CD9C;">
                       #if($!data.finishedCount > 999)
                               999+
                       #else
                           $!{data.finishedCount}
                       #end
                   </div>
                    ## 已审批
                   <div class="content-boby-name">#springMessage("common.field.approved")</div>
               </span>
            </span>
        </div>
    </div>
</div>
#end
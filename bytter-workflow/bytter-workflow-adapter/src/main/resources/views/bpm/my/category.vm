<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .categoryTable .category-link{
            float: left;
            margin: 5px 10px;
        }
    </style>
</head>
<body>
<table class="layui-table categoryTable" lay-even>
    #foreach($category in $categoryList)
        <tr>
            <td width="100">$!{category.name}</td>
            <td>
                #if($category.children && $category.children.size()>0)
                    #foreach($categoryA in $category.children)
                        #if($categoryA.isLeaf)
                            <div class="category-link"><a href="javascript:void(0);" data-url="$!{categoryB.url}">$!{categoryA.name}(0)</a></div>
                        #else
                            #if($categoryA.children && $categoryA.children.size()>0)
                                #foreach($categoryB in $categoryA.children)
                                    <div class="category-link"><a href="javascript:void(0);" data-url="$!{categoryB.url}">$!{categoryB.name}(0)</a></div>
                                #end
                            #end
                        #end
                    #end
                #end
            </td>
        </tr>
    #end
</table>
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery'], function(){
        var $ = bt.jquery;
        $(".category-link a").click(function(){
            var url = basePath + $(this).data("url");
            if(!url){
                return;
            }
            var title = $(this).text();
            title = title.substring(0,title.indexOf("("))
            if(bt.navtab){
                bt.navtab.addNavtab(title,url);
            }
        });

    });
</script>
</body>
</html>
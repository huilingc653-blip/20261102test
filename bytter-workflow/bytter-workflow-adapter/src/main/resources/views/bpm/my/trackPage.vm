<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .categoryTable .category-link{
            float: left;
            margin: 5px 10px;
        }
        .layui-badge {
            background-color:#526DD9;
        }
    </style>
</head>
<body>
#if($categoryList.size()>0)
    <div>
        <table class="layui-table categoryTable dark-layui-table" lay-even>
            #foreach($category in $categoryList)
                #if($category.children && $category.children.size()>0)
                    <tr>
                        <td width="100">$!{category.name}</td>
                        <td>
                            #foreach($categoryA in $category.children)
                                #foreach($todo in $todoCounts)
                                    #if($categoryA.cateKey == $todo.cateKey)
                                        <div class="category-link"><a href="javascript:void(0);" data-url="$!{categoryA.url}">$!{categoryA.name}</a>&nbsp;<span class="layui-badge">$!{todo.num}</span></div>
                                    #end
                                #end
                            #end
                        </td>
                    </tr>
                #end
            #end
        </table>
    </div>

#else
<div class="layui-container">
    <div class="layui-row">
        <div class="layui-col-md6 layui-col-md-offset3">
            <h1 class="text-center" style="margin-top: 50px;">#springMessage("common.msg.temporarily_no_data")</h1>
        </div>
    </div>
</div>
#end

    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery'], function(){
        var $ = bt.jquery;
        $(".category-link a").click(function(){
            var url = basePath + $(this).data("url")+'?flowStatus=track';
            if(!url){
                return;
            }
            var title = $(this).text();
            if(bt.navtab){
                bt.navtab.addNavtab(bt.lang('bpm.message.trace')+'-'+title,url);
            }
        });

    });
</script>
</body>
</html>

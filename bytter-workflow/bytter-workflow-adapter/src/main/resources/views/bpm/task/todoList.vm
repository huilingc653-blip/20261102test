<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.netId')：</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="net"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-callbackData="bt.netChange"
                         data-scope="net"
                         data-placeholder="#springMessage('common.placeholder.select')"></div>
                </div>
            </td>
            <td class="textRight">登录名称：</td>
            <td>
                <input type="text" name="likes_loginName" class="layui-input">
            </td>
            <td class="textRight">用户名：</td>
            <td>
                <input type="text" name="likes_username" class="layui-input">
            </td>
        </tr>
        <tr>
            <td colspan="6" class="text-center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="processInstanceTable" class="layui-table" style="width:100%">
    <thead>
    <tr>
        <th>ID</th>
        <th>发起者</th>
        <th>节点名称</th>
        <th>启动时间</th>
        <th>操作</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script>
    bt.use(['datatable', 'jquery'], function () {
        var layer = parent ? parent.bt.layer : bt.layer;
        var dataform = bt.dataform;
        var $ = bt.jquery;
        var table = bt.datatable.init({
            elem: "#processInstanceTable",
            ajax: {
                url: basePath + "/bpm/task/todoListDataTable",
            },
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            columns: [
                {data: "taskVO.id", orderable: false},
                {data: "username", orderable: false},
                {data: "taskVO.name", orderable: false},
                {data: "startTime"},
                {data: null, orderable: false, render: function (data, type, full, meta) {
                    var html = '';
                    if(full.taskVO.assignee){
                        html+='<a href="javascript:void(0);" data-row="' + meta.row + '" class="complete-task">办理</a>'

                    }else{
                        html+='<a href="javascript:void(0);" data-row="' + meta.row + '" class="claim-task">签收</a>';
                    }

                    html += '<span class="text-explode">|</span>';
                    html+='<a href="javascript:void(0);" data-row="' + meta.row + '" class="watch-task">查看节点</a>';

                    html += '<span class="text-explode">|</span>';
                    html+='<a href="javascript:void(0);" data-row="' + meta.row + '" class="watch-detail">查看明细</a>';
                    return html;
                }},

            ]
        });

        //签收任务
        table.on('click', '.claim-task', function (event) {
            var data = table.row($(this).data('row')).data();
            $.get(basePath + "/bpm/task/claim/" + data.taskVO.id, function (result) {
                table.draw();

            }, 'JSON');
            event.stopPropagation();
        });

        //反签收
        table.on('click', '.claim-task', function (event) {
            var data = table.row($(this).data('row')).data();
            $.get(basePath + "/bpm/task/claim/" + data.taskVO.id, function (result) {
                table.draw();

            }, 'JSON');
            event.stopPropagation();
        });

        //处理任务
        table.on('click', '.complete-task', function (event) {
            var data = table.row($(this).data('row')).data();
            $.get(basePath + "/bpm/task/complete/" + data.taskVO.id, function (result) {
                table.draw();
                layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, 'JSON');
            event.stopPropagation();
        });
        table.on('click', '.watch-task', function (event) {
            var data = table.row($(this).data('row')).data();
            parent.layer.open({
                type: 2,
                area: ['850px', '330px'],
                content: basePath + "/bpm/processInstance/trace/" + data.id,
            });
            event.stopPropagation();
        });

        table.on('click', '.watch-detail', function (event) {
            var data = table.row($(this).data('row')).data();
            parent.layer.open({
                type: 2,
                area: ['850px', '330px'],
                content: basePath + "/bpm/processInstance/detail/" + data.id,
            });
            event.stopPropagation();
        });


    });
</script>
</body>
</html>
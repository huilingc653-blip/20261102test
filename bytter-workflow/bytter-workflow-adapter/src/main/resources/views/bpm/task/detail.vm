<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<img src="${basePath}/bpm/processInstance/trace/$!{processInstanceId}" />
    #set($comments =  $flowTag.listComments($processInstanceId))
    #if($comments && $comments.size() > 0 )
    <table class="layui-table">
        <tr>
            <th>节点名称</th>
            <th>处理人</th>
            <th>处理时间</th>
            <th>批注</th>
        </tr>
        #foreach( $comment in $comments)
            <tr>
                <td>$!{comment.taskName}</td>
                <td>$!{comment.author}</td>
                <td>$!date.format('yyyy-MM-dd HH:mm:ss ',$!comment.time)</td>
                <td>$!{comment.fullMessage}</td>
            </tr>
        #end
    </table>
    #end

    #parse("views/common/footer.vm")
<script>

</script>
</body>
</html>
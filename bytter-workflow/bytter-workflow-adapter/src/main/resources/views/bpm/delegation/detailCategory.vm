<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body {
            min-width: 300px;
        }
    </style>
</head>
<body>
<input type="hidden" id="flowCategoryIdList" value="$!{flowCategoryIdList}">
<form class="layui-form" action="">
    <div class="layui-form-item">
        <label class="layui-form-label">#springMessage('common.table.thead.operation')</label>
        <div class="layui-input-inline" style="width:50%;line-height: 29px;">
            <div style="float:left;">
                <a href="javascript:void(0)" style="margin-left:10px;color:blue;float:left;" id="expand-all">#springMessage('common.open.all')</a>
                <a href="javascript:void(0)" style="margin-left:10px;color:blue;float:left;" id="close-all">#springMessage('common.close.all')</a>
            </div>
        </div>
    </div>
    <div class="layui-form-item">
        <label class="layui-form-label">#springMessage('bpm.flow.category')</label>
        <div class="layui-input-inline" style="width:auto">
            <ul id="categoryTree" class="ztree"></ul>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" id="closeWindow">#springMessage('common.button.close')</button>
        </div>
    </div>
</form>

    #parse("views/common/footer.vm")

<script>
    bt.use(['form', 'jquery', 'ztree', 'ztreeCheck'], function () {
        var form = bt.form(), $ = bt.jquery;

        //下拉树
        var zTreeObj;
        var setting = {
            check: {enable: true, chkStyle: "checkbox", chkboxType: {"Y": "s", "N": "s"}, chkDisable: true},
            data: {simpleData: {enable: true, idKey: "id", pIdKey: "pId"}},
            callback: {
                onClick: "",
                beforeCheck: () => false
            }
        };

        var zNodes;
        var treeObj
        $.get(basePath + "/bpm/flowCategory/tree", function (result) {
            zNodes = result;
            zTreeObj = $.fn.zTree.init($("#categoryTree"), setting, zNodes);
            //已经存在指定流程的网点禁用复选
            treeObj = $.fn.zTree.getZTreeObj("categoryTree");
            var nodes = treeObj.transformToArray(treeObj.getNodes());
            var alreadyChooseNodes = $("#flowCategoryIdList").val().split(",");
            for (j in alreadyChooseNodes) {
                for (i in nodes) {
                    if (nodes[i].id == alreadyChooseNodes[j]) {
                        treeObj.checkNode(nodes[i], true, true);
                        continue;
                    }
                }
            }
            zTreeObj.expandAll(true);
            //移除下拉树的鼠标事件，阻止前端鼠标移动到复选框上造成半选效果
            $("#categoryTree").off('mouseout');
            $("#categoryTree").off('mouseover');
        }, 'JSON');

        function zTreeOnClick(event, treeId, treeNode) {
            treeObj.checkNode(treeNode);
            // removeHalfCheck(null, treeId, treeNode);
        };


        //监听提交
        form.on('submit(modelSubmit)', function (data) {
            var nodes = zTreeObj.getCheckedNodes(true);

            var nodesArr = new Array();
            if (nodes.length < 1) {
                parent.layer.alert(bt.lang("bpm.delegation.please.select.flow.category"), {icon: 2});
                return false;
            }
            for (var j = 0; j < nodes.length; j++) {
                var node = nodes[j];
                //如果不是最下级的分类，则不传入
                if (node.children) {
                    continue;
                }
                nodesArr.push(node.id);
            }
            if (nodesArr.length < 1) {
                parent.layer.alert(bt.lang("bpm.delegation.please.select.flow.category"), {icon: 2});
                return false;
            }
            parent.$("#flowCategoryIdList").val(nodesArr); //先得到当前iframe层的索引
            var index = parent.layer.getFrameIndex(window.name); //先得到当前iframe层的索引
            parent.layer.close(index); //再执行关闭
            return false;
        });
        //重置下拉树
        $("#reset").on('click', function () {
            zTreeObj.checkAllNodes(false);
        });
        //全选
        $("#select-all").on('click', function () {
            zTreeObj.checkAllNodes(true);
        });
        $("#unselect-all").on('click', function () {
            zTreeObj.checkAllNodes(false);
        });
        $("#expand-all").on('click', function () {
            zTreeObj.expandAll(true);
        });
        $("#close-all").on('click', function () {
            zTreeObj.expandAll(false);
        });

        //关闭按钮
        $('#closeWindow').click(function () {
            var index = parent.layer.getFrameIndex(window.name); //先得到当前iframe层的索引
            parent.layer.close(index); //再执行关闭
        });
    });
</script>
</body>
</html>
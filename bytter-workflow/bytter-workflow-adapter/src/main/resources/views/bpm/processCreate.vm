<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body style="min-width: 570px;">
	<form class="layui-form" method="post">
        <input name="modelType" type="hidden" value="0">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##名称
				<td class="textRight">#springMessage('table.actDeModel.name')</td>
				<td width="40%">
                        <input type="text" id="name" name="name" lay-verify="required"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.actDeModel.name')">
				</td>
        		##modelKey
				<td class="textRight">#springMessage('table.actDeModel.modelKey')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="key" name="key" lay-verify="required"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.actDeModel.modelKey')">
				</td>
			</tr>
        	<tr>
        		##描述
				<td class="textRight">#springMessage('table.actDeModel.description')</td>
				<td colspan="3">
					<textarea placeholder="description" class="layui-textarea" id="description" name="description" ></textarea>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use('form', function(){
        $ = bt.jquery,form = bt.form();
        $.fn.serializeObject = function() {
            var o = {};
            var a = this.serializeArray();
            $.each(a, function() {
                if (o[this.name] !== undefined) {
                    if (!o[this.name].push) {
                        o[this.name] = [o[this.name]];
                    }
                    o[this.name].push(this.value || '');
                } else {
                    o[this.name] = this.value || '';
                }
            });
            return o;
        };

        formData = function(){
            if (!$("input[name=name]").val() || $("input[name=name]").val().length == 0 ||
                    !$("input[name=key]").val() || $("input[name=key]").val().length == 0) {
                return false;
            }
            return $("form").serializeObject();
        };
	});
</script>
</html>
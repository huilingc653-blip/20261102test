<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            min-width: 300px;
        }
        .ztree.select-tree-list{
            height: 300px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-form-item">
##        所属分类
        <label class="layui-form-label">#springMessage("bpm.flow.category")</label>
        <div class="layui-input-inline">
            <div style="line-height: 24px;">$!{name}</div>
            <input type="hidden" name="modelId" value="$!{modelId}">
        </div>
    </div>
    <div class="layui-form-item">
##        所属单位
        <label class="layui-form-label">#springMessage("sys.user.corpContain.show")</label>
        <div class="layui-input-inline">
            <div style="line-height: 24px;">($!{corpCode})&nbsp;$!{corpName}</div>
        </div>
    </div>

    <div class="layui-form-item">
##        是否允许撤回
        <label class="layui-form-label">#springMessage("work.flow.allow.revoke")</label>
        <div class="layui-input-inline"  style="width: 214px;">
                <div class="bt-biz-dict" data-group="sf_yn" data-name="revokeAble" data-type="radio"
                     data-defaultvalue="0" data-value="$!{revokeAble}"
                ></div>
        </div>
    </div>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="modelSubmit">#springMessage("common.button.submit")</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage("common.button.reset")</button>
        </div>
    </div>
</form>

    #parse("views/common/footer.vm")

<script>
    bt.use(['form','jquery','corp','dicts'], function(){
        var form = bt.form(),$  = bt.jquery;
        bt.dicts.init();
        bt.corp.init();
        //监听提交
        form.on('submit(modelSubmit)', function(data){
            $.post(basePath + "/bpm/model/update",data.field,function(result){
                if(result.success){
                    parent.layer.closeAll();
                }
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },'JSON');
            return false;
        });
    });
</script>
</body>
</html>
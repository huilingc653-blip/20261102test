<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            min-width: 300px;
        }
        .ztree.select-tree-list{
            height: 300px;
        }

        .row-wrap-title{
            /*这里两个属性搭配在一起实现文字换行显示，但写在class上不生效，因而写在style*/
            /*white-space: pre-wrap;word-break: break-word;*/
            white-space: pre-wrap;
            word-break: break-word;
        }
        #corpInput .bt-selectTree-close {
            top:4px!important;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-form-item">
##        所属分类
        <label style="white-space: pre-wrap;word-break: break-word;" class="layui-form-label">#springMessage("bpm.flow.category")</label>
        <div class="layui-input-inline">
            <div style="line-height: 24px;">$!{flowCategory.name}</div>
            <input type="hidden" name="flowCategoryId" value="$!{flowCategory.Id}">
            <input type="hidden" name="flowCategoryName" value="$!{flowCategory.name}">
        </div>
    </div>
    <div class="layui-form-item">
##        所属单位
        <label style="white-space: pre-wrap;word-break: break-word;"  class="layui-form-label">#springMessage("sys.user.corpContain.show")</label>
        <div class="layui-input-inline" style="width: 214px;" id="corpInput">
            <div class="bt-biz-corp"
                 data-biz-type="corp"
                 data-type="selectTree"
                 data-name="corpId"
                 data-required="true"
                 data-resource="bpm:mode:op"
                 data-biz-name="corpTree"
                 data-scope="all"></div>
        </div>
    </div>

    <div class="layui-form-item">
    ##        是否允许撤回
        <label style="white-space: pre-wrap;word-break: break-word;" class="layui-form-label ">#springMessage("work.flow.allow.revoke")</label>
        <div class="layui-input-inline"  style="width: 214px;">
                <div class="bt-biz-dict" data-group="sf_yn" data-name="revokeAble" data-type="radio"
                     data-defaultvalue="0"
                ></div>
        </div>
    </div>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="modelSubmit">#springMessage("common.button.submit")</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage("common.button.reset")</button>
        </div>
    </div>
</form>

    #parse("views/common/footer.vm")

<script>
    bt.use(['form','jquery','corp','dicts'], function(){
        var form = bt.form(),$  = bt.jquery;
        bt.dicts.init();
        var corp = bt.corp.init();
        var submitFlag = false;
        //监听提交
        form.on('submit(modelSubmit)', function(data){
            var corpData = corp.get("corpTree").data();
            if(submitFlag){
              return
            }
            submitFlag = true;
            if (corpData && corpData.length > 0) {
                console.log(corpData[0].code)
                data.field.corpName = corpData[0].corpName;
                data.field.corpCode = corpData[0].code
            }
            $.post(basePath + "/bpm/model/create",data.field,function(result){
                if(result.success){
                    parent.layer.closeAll();
                }
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },'JSON').complete(function () {
                submitFlag = false
            });
            return false;
        });
    });
</script>
</body>
</html>

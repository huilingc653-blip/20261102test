#set($basePath=$springMacroRequestContext.contextPath)
#set($resourceVersion=$resourceVersion.get())
<!DOCTYPE html>
<html>
<head>
    <title>流程配置</title>
    <link rel="stylesheet" href="${basePath}/static/plugins/layui/css/layui.css" media="all">
    <link rel="stylesheet" href="${basePath}/flowDesign/editor-app/libs/ztree/metroStyle.css">
    <script>var basePath = "${basePath}"</script>
    <style type="text/css">@charset "UTF-8";[ng\:cloak],[ng-cloak],[data-ng-cloak],[x-ng-cloak],.ng-cloak,.x-ng-cloak,.ng-hide{display:none !important;}ng\:form{display:block;}.ng-animate-block-transitions{transition:0s all!important;-webkit-transition:0s all!important;}</style>
    <style>
        body {
            padding: 0px;
            margin: 0px;
            height: 100%;
        }
        body.dark-skin {
            color: #d3d3d3;
        }
        ::-webkit-scrollbar {
            /*width:10px;*/
            width:6px;
            /*height:10px*/
            height: 6px;
        }

        ::-webkit-scrollbar-button {
            width: 0;
            height: 0
        }

        ::-webkit-scrollbar-button:end:increment,::-webkit-scrollbar-button:start:decrement {
            display: block
        }

        ::-webkit-scrollbar-button:vertical:end:decrement,::-webkit-scrollbar-button:vertical:start:increment {
            display: none
        }

        ::-webkit-scrollbar-thumb:horizontal,::-webkit-scrollbar-thumb:vertical,::-webkit-scrollbar-track:horizontal,::-webkit-scrollbar-track:vertical {
            border-color: transparent;
            border-style: solid
        }

        ::-webkit-scrollbar-track:vertical::-webkit-scrollbar-track:horizontal {
            /*background-color: #fff;*/
            -webkit-background-clip: padding-box;
            background-clip: padding-box
        }

        ::-webkit-scrollbar-thumb {
            min-height: 28px;
            /*background-color: #D8DFED;*/
            background: rgbA(148, 151, 172,0.3);
            -webkit-background-clip: padding-box;
            background-clip: padding-box;
            border-radius: 15px;
            /*-webkit-box-shadow: inset 1px 1px 0 rgba(0,0,0,.1),inset 0 -1px 0 rgba(0,0,0,.07)*/
        }

        ::-webkit-scrollbar-thumb:hover {
            /*background-color: #D8DFED;*/
            background: rgbA(148, 151, 172,0.3);
            /*-webkit-box-shadow: inset 1px 1px 1px rgba(0,0,0,.25)*/
        }

        ::-webkit-scrollbar-thumb:active {
            /*background-color: #D8DFED;*/
            background: rgbA(148, 151, 172,0.3);
            /*-webkit-box-shadow: inset 1px 1px 3px rgba(0,0,0,.25)*/
        }

        ::-webkit-scrollbar-thumb:horizontal,::-webkit-scrollbar-thumb:vertical,::-webkit-scrollbar-track:horizontal,::-webkit-scrollbar-track:vertical {
            border-width: 0
        }

        ::-webkit-scrollbar-track:hover {
            /*background-color:#F5F7FC;*/
            /*-webkit-box-shadow: inset 1px 0 0 rgba(0,0,0,.1)*/
        }

        ::-webkit-scrollbar-track:active {
            /*background-color: rgba(0,0,0,.05);*/
            background: rgbA(148, 151, 172,0.3);
            /*-webkit-box-shadow: inset 10px 0 0 rgba(245,247,252,1),inset -1px -1px 0 rgba(0,0,0,.07)*/
        }
        ::-webkit-scrollbar-track {

        }
        .dark-skin .task-type-header {
            color: rgb(211, 211, 211);
        }
        .task-left {
            /*position: fixed;*/
            /*left: 0;*/
            /*height: 100%;*/
            height: calc(100vh - 58px);
            border-right: 1px solid #d3d3d3;
            padding: 0 10px;
        }

        .task-left a {
            color: #303343 !important;
        }
        .dark-skin .task-left a {
            color: #d3d3d3 !important;
        }
        .task-left .ztree{
            height: 85%;overflow: auto;
        }
        .task-left .title{
            padding: 5px;
            font-size: 15px;
            border-left: 4px solid #526DD9;
        }

        .task-left-header {
            height: 60px;
            line-height: 60px;
            border-bottom: 1px solid #d3d3d3;
        }

        .task-right {
            /*position: fixed;*/
            /*right: 0;*/
            height: 100%;
            padding: 15px;
        }

        .task-right .layui-tab {
            margin: 0;
        }

        .layui-tab-title .layui-this:after {

        }

        .layui-nav-bar {
            display: none;
        }

        .task-type-header {
            height: 60px;
            line-height: 60px;
            border-bottom: 1px solid #d3d3d3;
        }
        .layui-tab-content{
            /*height: 95%;*/
            height: 90%;
            overflow: auto;
        }
        .content-body{
            height: 90%;
            overflow:auto;
            min-width: 1020px;
        }
        .content-body .layui-form-item{
            border-bottom: 1px dashed #ddd;
            padding-bottom: 5px;
        }
        .content-body .layui-form-item:last-child{
            border-bottom: none;
        }
        .text-explode {
            color: #CCC !important;
            font-weight: normal !important;
            margin: 0 4px !important;
        }
        .no-data-tips{
            text-align: center;
            font-size: 18px;
            border: 2px dashed #e2e2e2;
            padding: 20px 0;
            display: block;
            color: #afafaf;
        }
        .layui-btn {
            color: #303343;
        }
        .layui-form,.layui-tab-item{
            height: 100%;
        }
        .dark-skin .layui-tab-card {
            background-color: #25262B;
            border: none;
        }
        .dark-skin .layui-tab-card > .layui-tab-title {
            background-color: #25262B;
            border-bottom: 1px solid #2E2F34;
        }
        .layui-tab-card > .layui-tab-title .layui-this {
            color: #4E6DEC;
        }
        .dark-skin .layui-tab-card > .layui-tab-title .layui-this {
            background-color: #25262B;
        }
        .dark-skin .layui-form-item button {
            background-color: #D2D4D9;
        }
        .dark-skin .layui-form-item button:hover {
            color:#4E6DEC!important;
        }
        .layui-tab-title .layui-this:after {
            border: none;
        }
        .dark-skin .layui-input, .dark-skin .layui-textarea, .dark-skin .layui-select, .dark-skin .capNubmer {
            background: #25262B;
            color: inherit;
        }
        .dark-skin input {
            border: 1px solid #2E2F34!important;
            color: #D3D3D3!important;
        }
        .dark-skin .layui-form-select dl {
            background-color: #25262B;
            border: 1px solid #25262B;
            color: #D3D3D3;
        }
        .layui-form-select dl dd.layui-this, .layui-nav .layui-nav-child dd.layui-this a, .layui-nav-child dd.layui-this {
            background: rgba(78, 109, 236, 0.05);
            color: #4E6DEC;
        }
        .dark-skin .layui-form-select dl dd:hover {
            background-color: #262936;
        }
        .dark-skin .task-left {
            border-right: 1px solid #2E2F34;
        }
        .layui-btn-normal {
            background-color: #4E6DEC;
        }
        .ztree li a.curSelectedNode {
            color: #4E6DEC!important;
        }
        .dark-skin .layui-tab-content {
            background: #1B1C21;
        }
        .ztree li a span {
            height: 19px;
            line-height: 19px;
        }
        .layui-quote-nm {
            border-color: #2E2F34;
            /*border-left-color: #4E6DEC;*/
        }
        .dark-skin .layui-textarea {
            border: 1px solid #2E2F34!important;
        }
    </style>

</head>
<body ng-app="flowOption">
<div class="layui-row" ng-controller="optionCtrl">
    <div class="layui-col-xs3 task-left">
        <div class="task-type-header">
            <span class="title">#springMessage("bpm.flow.category")</span>
        </div>
        <div class="line margin-top margin-bottom">
            <a href="javascript:void(0);" id="corpExpandAll">#springMessage("common.open.all")</a>
            <span class="text-explode">|</span>
            <a href="javascript:void(0);" id="corpCollapseAll">#springMessage("common.close.all")</a>
        </div>
        <ul tree class="ztree ztree1"></ul>
    </div>
    <div class="layui-col-xs9 task-right">
        <div class="layui-tab layui-tab-card" lay-filter="demo"  style="height: 93%;">
            <ul class="layui-tab-title">
                <li class="layui-this">#springMessage("bpm.option.conditions")</li>
                <li>#springMessage("bpm.option.usertask")</li>
                <li>#springMessage("bpm.option.messagetemplate")</li>
                <li>#springMessage("bpm.option.extendparams")</li>
            </ul>
            <div class="layui-tab-content" ng-cloak>
                <div class="layui-tab-item layui-show">
                    <form class="layui-form">
                        <div class="layui-form-item">
                            <button class="layui-btn layui-btn-primary layui-btn-small" ng-click="addFlow()">#springMessage("bpm.option.btn.add.conditions")</button>
                        </div>

                        <div style="color: grey;">#springMessage("bpm.option.conditions.function.description")</div>
                        <br>

                        <div class="layui-form-item content-body">
                            <div class="layui-form-item" ng-repeat="flow in flowList" ng-if="flowList.length>0">
                                <div class="layui-inline">
                                    <label class="layui-form-label">#springMessage("bpm.option.conditions.name")</label>
                                    <div class="layui-input-inline" style="width: 200px;">
                                        <input type="text" class="layui-input" ng-model="flow.name">
                                    </div>
                                </div>
                                <div class="layui-inline">
                                    <label class="layui-form-label">#springMessage("bpm.option.conditions.fieldname")</label>
                                    <div class="layui-input-inline" style="width: 200px;">
                                        <input type="text" class="layui-input" ng-model="flow.fieldName">
                                    </div>
                                </div>
                                <div class="layui-inline">
                                    <label class="layui-form-label">#springMessage("bpm.option.conditions.type")</label>
                                    <div class="layui-input-inline" style="width: 100px;">
                                        <select lay-filter="selectType" index="{{$index}}">
                                            <option value=""></option>
                                            <option ng-repeat="st in selectType" value="{{st.value}}" ng-selected="st.value==flow.selectType">{{st.label}}</option>
                                        </select>
                                    </div>
                                    <div class="layui-input-inline" style="width: 150px;" ng-if="flow.selectType==2" >
                                        <select lay-filter="dictGroup" index="{{$index}}" lay-search>
                                            <option value=""></option>
                                            <option ng-repeat="dict in dicts" value="{{dict.groupCode}}" ng-selected="dict.groupCode==flow.dictGroup">{{dict.groupName}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="layui-inline">
                                    <button class="layui-btn layui-btn-small layui-btn-warm" ng-click="removeFlow($index,flow)">
                                        <i class="layui-icon">&#xe640;</i>
                                    </button>
                                </div>
                            </div>

                            <div ng-if="category == null">
                                <div class="no-data-tips">#springMessage("bpm.option.please.select.category"){{category}}</div>
                            </div>
                            <div ng-show="category && flowList.length==0">
                                <div class="no-data-tips"><span ng-bind="currentFlowName"></span>#springMessage("bpm.option.no.conditions.are.set")</div>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="layui-tab-item">
                    <form class="layui-form">
                        <div class="layui-form-item" ng-show="category">
                            <button class="layui-btn layui-btn-primary layui-btn-small" ng-click="addUsertask()">#springMessage("bpm.option.btn.add.usertask")</button>
                        </div>
                        <div class="layui-form-item content-body">
                            <div class="layui-form-item" ng-repeat="usertask in usertaskList" ng-if="usertaskList.length>0">
                                <div class="layui-inline">
                                    <label class="layui-form-label">#springMessage("bpm.option.usertask.name")</label>
                                    <div class="layui-input-inline" style="width: 200px;">
                                        <input type="text" class="layui-input" ng-model="usertask.name">
                                    </div>
                                </div>
                                <div class="layui-inline">
                                    <label class="layui-form-label" style="width: 90px;">#springMessage("bpm.option.usertask.event")</label>
                                    <div class="layui-input-inline" style="width: 200px;">
                                        <input type="text" class="layui-input" ng-model="usertask.event">
                                    </div>
                                </div>
                                <div class="layui-inline">
                                    <button class="layui-btn layui-btn-small layui-btn-warm" ng-click="removeUsertask($index,usertask)">
                                        <i class="layui-icon">&#xe640;</i>
                                    </button>
                                </div>
                            </div>
                            <div ng-show="category == null">
                                <div class="no-data-tips">#springMessage("bpm.option.please.select.category")</div>
                            </div>
                            <div ng-show="category && usertaskList.length==0">
                                <div class="no-data-tips"><span ng-bind="currentFlowName"></span>#springMessage("bpm.option.no.usertask.are.set")</div>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="layui-tab-item">
                    <div ng-show="category == null">
                        <div class="no-data-tips">#springMessage("bpm.option.please.select.category")</div>
                    </div>
                    <form class="layui-form" ng-show="category">

                        <div style="color: grey;">
                            #springMessage("bpm.option.messagetemplate.function.description")
                        </div>
                        <br>

                        <div class="layui-form-item">
                            <blockquote class="layui-elem-quote layui-quote-nm">#springMessage("bpm.option.messagetemplate.btn.insert.placeholder")</blockquote>
                        </div>
                        <div class="layui-form-item">
                            <span ng-repeat="flow in flowList">
                                <button class="layui-btn layui-btn-normal layui-btn-small" ng-click="copyData(flow)">{{flow.name}}</button>
                            </span>
                        </div>
                        <div class="layui-form-item">
                            <textarea name="messageTemplate" placeholder="#springMessage("bpm.option.messagetemplate.phone.template.content")" class="layui-textarea" ng-model="messageTemplate.msgTpl"></textarea>
                        </div>
                    </form>
                </div>

                ##审批列表的自定义显示字段
                <div class="layui-tab-item">
                    <form class="layui-form">
                        <div class="layui-form-item">
                            <button class="layui-btn layui-btn-primary layui-btn-small" ng-click="addExtendParam()">#springMessage("bpm.option.btn.add.extendparams")</button>
                        </div>

                        <div style="color: grey;">
                            #springMessage("bpm.option.extendparams.function.description")
                        </div>
                        <br>

                        <div ng-if="extendParamsList.length > 1">
                            <div style="color: grey;">#springMessage("bpm.option.extendparams.operational.tips")</div>
                            <br>
                        </div>
                        <div class="layui-form-item content-body">

                            <div>
                                <div ui-sortable="sortableOptions" ng-model="extendParamsList">
                                    <div ng-repeat="extendParam in extendParamsList" ng-if="extendParamsList.length>0">
                                        <blockquote class="layui-elem-quote layui-quote-nm">
                                            <div class="layui-inline">
                                                <label class="layui-form-label">#springMessage("bpm.option.extendparams.name")</label>
                                                <div class="layui-input-inline" style="width: 200px;">
##                                                    <input type="text" class="layui-input" ng-model="extendParam.name" ng-disabled="extendParam.isStableField == 1">
                                                    <input type="text" class="layui-input" ng-model="extendParam.name">
                                                </div>
                                            </div>
                                            <div class="layui-inline">
                                                <label class="layui-form-label">#springMessage("bpm.option.extendparams.fieldname")</label>
                                                <div class="layui-input-inline" style="width: 200px;">
##                                                    <input type="text" class="layui-input" ng-model="extendParam.fieldName" ng-disabled="extendParam.isStableField == 1">
                                                    <input type="text" class="layui-input" ng-model="extendParam.fieldName">
                                                </div>
                                            </div>
                                            <div class="layui-inline">
                                                <label class="layui-form-label">#springMessage("bpm.option.extendparams.visible")</label>
                                                <div class="layui-input-inline" style="width: 100px;">
                                                    <select lay-filter="selectVisible" index="{{$index}}">
                                                        <option value=""></option>
                                                        <option ng-repeat="sv in selectVisible" value="{{sv.value}}" ng-selected="sv.value==extendParam.visible">{{sv.label}}</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="layui-inline" ng-hide="extendParam.isStableField == 1 || extendParam.isStableField == 2">
                                                <button class="layui-btn layui-btn-small layui-btn-warm" ng-click="removeExtendParam($index,extendParam)">
                                                    <i class="layui-icon">&#xe640;</i>
                                                </button>
                                            </div>
                                        </blockquote>
                                    </div>
                                </div>

                            </div>

                            <div ng-if="category == null">
                                <div class="no-data-tips">#springMessage("bpm.option.please.select.category"){{category}}</div>
                            </div>
                            <div ng-show="category && extendParamsList.length==0">
                                <div class="no-data-tips"><span ng-bind="currentFlowName"></span>#springMessage("bpm.option.no.extendparams.are.set")</div>
                            </div>

                        </div>
                    </form>
                </div>


            </div>
        </div>

        <div class="line margin-top text-center" style="margin-top: 5px;">
            <button class="layui-btn layui-btn-normal layui-btn-lg" ng-click="save()">#springMessage("common.button.save")</button>
        </div>

    </div>
</div>
##    #parse("views/common/footer.vm")
<script src="${basePath}/static/plugins/layui/lay/dest/layui.all.js" charset="utf-8"></script>
<script src="${basePath}/flowDesign/editor-app/libs/jquery_1.11.0/jquery.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/flowDesign/editor-app/libs/ztree/jquery.ztree.core.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/flowDesign/editor-app/libs/angular_1.2.13/angular.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bpm/options.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/plugins/jquery-ui/jquery-ui1.js" charset="utf-8"></script>
<script src="${basePath}/static/plugins/ui-sortable/sortable.js" charset="utf-8"></script>

<script>
    window.bt = window.layui;
</script>
<script type="text/javascript" src="${basePath}/static/plugins/store/store.legacy.min.js?_btv=${resourceVersion}" charset="utf-8"></script>
<script type="text/javascript" src="${basePath}/static/plugins/bytter/oprate.js?_btv=${resourceVersion}" charset="utf-8"></script>
</body>
</html>

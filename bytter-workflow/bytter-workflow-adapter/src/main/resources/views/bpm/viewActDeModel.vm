<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
						<div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.actDeModel.name')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{actDeModelPage.name}
                    </label>
                </div>
            </div>
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.actDeModel.modelKey')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{actDeModelPage.modelKey}
                    </label>
                </div>
            </div>
				</div>
				<div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.actDeModel.description')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{actDeModelPage.description}
                    </label>
                </div>
            </div>
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.actDeModel.modelComment')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{actDeModelPage.modelComment}
                    </label>
                </div>
            </div>
				</div>
				<div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.actDeModel.created')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!date.format('yyyy-MM-dd',$!{actDeModelPage.created})
                    </label>
                </div>
            </div>
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.actDeModel.createdBy')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{actDeModelPage.createdBy}
                    </label>
                </div>
            </div>
				</div>
				<div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.actDeModel.version')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{actDeModelPage.version}
                    </label>
                </div>
            </div>
				</div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.netId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="net"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-callbackData="bt.netChange"
                         data-scope="net"
                         data-placeholder="#springMessage('common.placeholder.select')"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('bpm.history.loginname')</td>
            <td>
                <input type="text" name="likes_loginName" class="layui-input">
            </td>
            <td class="textRight">#springMessage('bpm.history.username')</td>
            <td>
                <input type="text" name="likes_username" class="layui-input">
            </td>
        </tr>
        <tr>
            <td colspan="6" class="text-center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="processInstanceTable" class="layui-table" style="width:100%">
    <thead>
    <tr>
        <th>ID</th>
        <th>#springMessage('bpm.model.businessCode')</th>
        <th>#springMessage('bpm.history.redeployed.id')</th>
        <th>#springMessage('bpm.delegation.starttime')</th>
        <th>#springMessage('bpm.delegation.endtime')</th>
        <th>#springMessage('bpm.history.start.user')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script>
    bt.use(['datatable', 'jquery'], function () {
        var layer = parent ? parent.bt.layer : bt.layer;
        var dataform = bt.dataform;
        var $ = bt.jquery;
        var table = bt.datatable.init({
            elem: "#processInstanceTable",
            ajax: {
                url: basePath + "/bpm/history/historicProcessInstanceDataTable",
            },
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            columns: [
                {data: "id", orderable: false},
                {data: "businessKey", orderable: false},
                {data: "processDefinitionId", orderable: false},
                {data: "startTime", orderable: false},
                {data: "endTime"},
                {data: "startUserId", orderable: false},
                {
                    data: null, orderable: false, render: function (data, type, full, meta) {
                        console.log(full.assignee);
                        var html = '';
                        if (full.assignee) {
                            html += '<a href="javascript:void(0);" data-row="' + meta.row + '" class="assign-role">' + bt.lang("common.button.handle") + '</a>';
                        } else {
                            html += '<a href="javascript:void(0);" data-row="' + meta.row + '" class="assign-role">' + bt.lang("common.button.sign") +  '</a>';
                        }
                        return html;
                    }
                },

            ]
        });


    });
</script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<fieldset class="layui-elem-field layui-field-title">
    <legend>Records</legend>
</fieldset>
<table class="layui-table">
    <tr>
        <th>Event</th>
        <th>ID</th>
        <th>Name</th>
        <th>Assign</th>
##        开始时间
        <th>#springMessage("common.table.createTime")</th>
##        结束时间
        <th>#springMessage("bpm.model.endTime")</th>
##        耗时
        <th>#springMessage("bpm.model.durationTime")</th>
    </tr>
    #foreach($hai in $historicActivityInstanceList)
        <tr>
            <td>
                #if($hai.activityType == "userTask")
                    userTask
                #elseif($hai.activityType == "startEvent")
                    start
                #elseif($hai.activityType == "endEvent")
                    end
                #end
            </td>
            <td>$!{hai.taskId}</td>
            <td>$!{hai.activityName}</td>
            <td>$!{hai.username}</td>
            <td>$!date.format('yyyy-MM-dd HH:mm:ss ',$!hai.startTime)</td>
            <td>$!date.format('yyyy-MM-dd HH:mm:ss ',$!hai.endTime)</td>
            <td>$!{hai.durationInMillis}</td>
        </tr>
    #end
</table>
#if($historicVariableInstanceList)
<fieldset class="layui-elem-field layui-field-title">
    <legend>Variable</legend>
</fieldset>
<table class="layui-table">
    <tr>
        <th>Name</th>
        <th>Param Name</th>
        <th>Param Value</th>
    </tr>
    #foreach($hvi in $historicVariableInstanceList)
        <tr>
            <td>$!{hvi.name}</td>
            <td>$!{hvi.variableTypeName}</td>
            <td>$!{hvi.textValue}</td>
        </tr>
    #end
</table>
#end
</body>
</html>
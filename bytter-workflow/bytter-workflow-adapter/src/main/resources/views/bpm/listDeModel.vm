<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##名称
                    <td class="textRight">#springMessage('table.actDeModel.name')</td>
                    <td width="40%">
                        <div class="layui-input-inline">
                            <input type="text" name="filterText"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.actDeModel.name')">
                        </div>
                    </td>
                    <td>
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.actDeModel.name')</th>
        <th>#springMessage('table.actDeModel.modelKey')</th>
        <th>#springMessage('table.actDeModel.description')</th>
        <th>#springMessage('table.actDeModel.lastUpdated')</th>
        <th>#springMessage('table.actDeModel.version')</th>
        <th>#springMessage('table.actDeModel.createdBy')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bpm/actDeModel.list.js?_btv=${resourceVersion}"></script>
</html>

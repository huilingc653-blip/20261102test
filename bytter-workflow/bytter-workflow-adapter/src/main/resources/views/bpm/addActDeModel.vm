<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{actDeModelPage.id}">
		<input id="lastUpdated" name="lastUpdated" type="hidden" value="$!{actDeModelPage.lastUpdated}">
		<input id="lastUpdatedBy" name="lastUpdatedBy" type="hidden" value="$!{actDeModelPage.lastUpdatedBy}">
		<input id="modelEditorJson" name="modelEditorJson" type="hidden" value="$!{actDeModelPage.modelEditorJson}">
		<input id="thumbnail" name="thumbnail" type="hidden" value="$!{actDeModelPage.thumbnail}">
		<input id="modelType" name="modelType" type="hidden" value="$!{actDeModelPage.modelType}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##名称
				<td class="textRight">#springMessage('table.actDeModel.name')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="name" name="name" lay-verify="required"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.actDeModel.name')">
										</td>
        		##modelKey
				<td class="textRight">#springMessage('table.actDeModel.modelKey')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="modelKey" name="modelKey" lay-verify="required"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.actDeModel.modelKey')">
										</td>
			</tr>
        	<tr>
        		##描述
				<td class="textRight">#springMessage('table.actDeModel.description')</td>
				<td >
						                        <textarea placeholder="description" class="layui-textarea" id="description" name="description" ></textarea>
				</td>
        		##评论
				<td class="textRight">#springMessage('table.actDeModel.modelComment')</td>
				<td >
						                        <textarea placeholder="modelComment" class="layui-textarea" id="modelComment" name="modelComment" ></textarea>
				</td>
			</tr>
        	<tr>
        		##创建时间
				<td class="textRight">#springMessage('table.actDeModel.created')</td>
				<td >
						                        <div type="date" field="created" defaultVal="$!{actDeModelPage.created}"></div>
				</td>
        		##创建人
				<td class="textRight">#springMessage('table.actDeModel.createdBy')</td>
				<td >
						<!--number-->
                        <input type="text" id="createdBy" name="createdBy" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.actDeModel.createdBy')">
										</td>
			</tr>
        	<tr>
        		##版本
				<td class="textRight">#springMessage('table.actDeModel.version')</td>
				<td >
						<!--number-->
                        <input type="text" id="version" name="version" 
							   decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('table.actDeModel.version')">
										</td>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bpm/actDeModel.add.js?_btv=${resourceVersion}"></script>
</html>
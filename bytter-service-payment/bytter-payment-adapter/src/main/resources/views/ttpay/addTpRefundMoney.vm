<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="id" id="id" value="$!{tpPayBillDtlVO.id}"/>
    <input type="hidden" name="trandMoney" id="trandMoney" value="$!{tpPayBillDtlVO.trandMoney}"/>
    <input type="hidden" name="payType" id="payType" value="$!{tpPayBillDtlVO.payType}"/>
    <input type="hidden" name="corpId" id="corpId" value="$!{tpPayBillDtlVO.corpId}"/>
    <input type="hidden" name="refundedMoney" id="refundedMoney" value="$!{tpPayBillDtlVO.refundedMoney}"/>
    <table class="layui-table">
        <tbody>
        <tr>
        ##输入退款金额
            <td class="textRight" width="25%">#springMessage('ttpay.refundManage.inputRefundMoney')</td>
            <td width="75%">
                <div class="layui-input-inline">
                    <input type="text" id="backMoney" name="backMoney"  lay-verify="required" data-biz-name="backMoney" data-max="$!{tpPayBillDtlVO.trandMoney}"
                           autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('ttpay.refundManage.inputRefundMoney')">
                </div>
            ##全部金额
                <div class="layui-input-inline">
                    <button type="button" onclick="chooseAllMoney()" class="layui-btn">#springMessage('ttpay.refundApply.allMoney')</button>
                </div>
                <font color="red">#springMessage('ttpay.refundManage.refundMoneyInfo')</font>
            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight" width="25%">#springMessage('ttpay.rmk')</td>
            <td width="75%">
                <textarea style="width : 70%" type="text" name="rmk" class="layui-textarea" lay-verify="rmk" placeholder="#springMessage('ttpay.rmk')"></textarea>
                <font color="red">#springMessage('ttpay.refundManage.refundRmkInfo')</font>
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="submit">#springMessage('common.button.confirm')</button>
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.cancel')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ttpay/tpRefundMoney.add.js?_btv=${resourceVersion}"></script>
</html>

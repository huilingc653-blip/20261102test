<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
        ##退款来源
            <td class="textRight" width="10%">#springMessage('ttpay.refund.source')</td>
            <td width="23%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="mulselect" data-name="ins_retSource" data-biz-name="retSource" data-group="ttpay.refund.retSource"></div>
                </div>
            </td>
        ##退款方式
            <td class="textRight" width="10%">#springMessage('ttpay.refund.type')</td>
            <td width="23%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="mulselect" data-name="ins_payTypeName" data-biz-name="payType" data-group="TTPAY_PAY_TYPE"></div>
                </div>
            </td>
        ##所属单位
            <td class="textRight" width="10%">#springMessage('sys.user.corpContain.show')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="ttpay:refundcheck:op"
                         data-placeholder="#springMessage('sys.user.corpContain.show')">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
        ##商户号
            <td class="textRight" width="10%">#springMessage('ttpay.merchantNo')</td>
            <td width="23%">
                <div class="layui-input-inline"><div class="merchantNo-selectTree-checkbox"></div></div>
            </td>
        ##门店名称
            <td class="textRight" width="10%">#springMessage('ttpay.refund.shopName')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_shopName" id="shopName" value=""
                           autocomplete="off" class="layui-input" placeholder="#springMessage('ttpay.refund.shopName')">
                </div>
            </td>
        ##退款申请号
            <td class="textRight" width="10%">#springMessage('ttpay.refund.backNo')</td>
            <td width="23%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_backNo" id="backNo" value=""
                           autocomplete="off" class="layui-input" placeholder="#springMessage('ttpay.refund.backNo')">
                </div>
            </td>
        </tr>
        <tr>
        ##退款申请日期
            <td class="textRight" width="10%">#springMessage('ttpay.refund.applyDate')</td>
            <td width="23%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_backDate" class="layui-input bt-input-inline bt-biz-dateType" id="backDateStart" data-endid="backDateEnd"
                           placeholder="#springMessage('ttpay.refund.applyDate')" value="$!{backDateStart}" >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_backDate" class="layui-input bt-input-inline bt-biz-dateType" id="backDateEnd"
                           placeholder="#springMessage('ttpay.refund.applyDate')" value="$!{backDateEnd}">
                </div>
            </td>
        ##退款金额范围
            <td class="textRight" width="10%">#springMessage('ttpay.refund.MoneyScope')</td>
            <td width="24%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_backMoney" data-moneyendid="endBackMoney" autocomplete="off"
                           class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('ttpay.refund.money')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_backMoney" id="endBackMoney" autocomplete="off"
                           class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('ttpay.refund.money')">
                </div>
            </td>
            <td class="textRight" width="10%"></td>
            <td width="23%">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" type="button" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary" >#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" >
    <thead>
    <tr>
        <th>#springMessage('ttpay.refund.source')</th>
        <th>#springMessage('ttpay.refund.type')</th>
        <th>#springMessage('ttpay.refund.backNo')</th>
        <th>#springMessage('sys.user.corpContain.show')</th>
        <th>#springMessage('ttpay.merchantNo')</th>
        <th>#springMessage('ttpay.trandNo')</th>
        <th>#springMessage('ttpay.refund.shopName')</th>
        <th>#springMessage('ttpay.refund.customerName')</th>
        <th>#springMessage('ttpay.refund.applyTime')</th>
        <th>#springMessage('ttpay.trandMoney')</th>
        <th>#springMessage('ttpay.refund.money')</th>
        <th>#springMessage('ttpay.refund.ableMoney')</th>
        <th>#springMessage('ttpay.refund.status')</th>
        <th>#springMessage('ttpay.currency')</th>
        <th>#springMessage('ttpay.rmk')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ttpay/tpRefundOrderCheck.list.js?_btv=${resourceVersion}"></script>
</html>

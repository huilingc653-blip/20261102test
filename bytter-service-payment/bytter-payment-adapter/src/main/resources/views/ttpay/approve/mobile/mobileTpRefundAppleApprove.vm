<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
        ##所属单位
            <li class="mui-table-view-cell">
                #springMessage('sys.user.corpContain.show')
                <span class="mui-badge mui-badge-inverted">
                    $!{tpRefundOrderVO.corpName}
                </span>
            </li>
        ##商户号
            <li class="mui-table-view-cell">
                #springMessage('ttpay.merchantNo')
                <span class="mui-badge mui-badge-inverted">
                    $!{tpRefundOrderVO.mchId}
                </span>
            </li>
        ##退款来源
            <li class="mui-table-view-cell">
                #springMessage('ttpay.refund.source')
                <span class="mui-badge mui-badge-inverted">
                    $dictTag.get("ttpay.refund.retSource",$!{tpRefundOrderVO.retSource})
                </span>
            </li>
        ##退款申请时间
            <li class="mui-table-view-cell">
                #springMessage('ttpay.refund.applyTime')
                <span class="mui-badge mui-badge-inverted">
                    $!date.format('yyyy-MM-dd HH:mm:ss',$!{tpRefundOrderVO.backDate})
                </span>
            </li>
        ##退款申请单号
            <li class="mui-table-view-cell">
                #springMessage('ttpay.refund.backNo')
                <span class="mui-badge mui-badge-inverted">
                    $!{tpRefundOrderVO.backNo}
                </span>
            </li>
        ##退款金额
            <li class="mui-table-view-cell">
                #springMessage('ttpay.refund.money')
                <span class="mui-badge mui-badge-inverted">
                    $!number.formatNumeric($!{tpRefundOrderVO.backMoney})
                </span>
            </li>
        ##可退款金额
            <li class="mui-table-view-cell">
                #springMessage('ttpay.refund.ableMoney')
                <span class="mui-badge mui-badge-inverted">
                    $!number.formatNumeric($!{tpRefundOrderVO.refundableAmount})
                </span>
            </li>
        ##交易流水号
            <li class="mui-table-view-cell">
                #springMessage('ttpay.serialNo')
                <span class="mui-badge mui-badge-inverted">
                    $!{tpRefundOrderVO.serialNo}
                </span>
            </li>
        ##订单号
            <li class="mui-table-view-cell">
                #springMessage('ttpay.trandNo')
                <span class="mui-badge mui-badge-inverted">
                    $!{tpRefundOrderVO.trandNo}
                </span>
            </li>
        ##订单交易日期
            <li class="mui-table-view-cell">
                #springMessage('ttpay.trandTime')
                <span class="mui-badge mui-badge-inverted">
                    $!date.format('yyyy-MM-dd',$!{tpRefundOrderVO.orderDate})
                </span>
            </li>
        ##订单金额
            <li class="mui-table-view-cell">
                #springMessage('ttpay.trandMoney')
                <span class="mui-badge mui-badge-inverted">
                    $!number.formatNumeric($!{tpRefundOrderVO.trandMoney})
                </span>
            </li>
        ##已收金额
            <li class="mui-table-view-cell">
                #springMessage('table.rasBackOp.recMoney')
                <span class="mui-badge mui-badge-inverted">
                    $!number.formatNumeric($!{tpRefundOrderVO.recMoney})
                </span>
            </li>
        ##退款方式
            <li class="mui-table-view-cell">
                #springMessage('ttpay.refund.type')
                <span class="mui-badge mui-badge-inverted">
                    $!{tpRefundOrderVO.payTypeName}
                </span>
            </li>
        ##客户名称
            <li class="mui-table-view-cell">
                #springMessage('ttpay.refund.customerName')
                <span class="mui-badge mui-badge-inverted">
                    $!{tpRefundOrderVO.custName}
                </span>
            </li>
        ##客户账号
            <li class="mui-table-view-cell">
                #springMessage('table.rasBackOp.custAcc')
                <span class="mui-badge mui-badge-inverted">
                    $!{tpRefundOrderVO.custAcc}
                </span>
            </li>
        ##备注
            <li class="mui-table-view-cell">
                #springMessage('ttpay.rmk')
                <span class="mui-badge mui-badge-inverted">
                    $!{tpRefundOrderVO.rmk}
                </span>
            </li>
        ##申请人名称
            <li class="mui-table-view-cell">
                #springMessage('ttpay.refund.apply')
                <span class="mui-badge mui-badge-inverted">
                    $!{tpRefundOrderVO.createName}
                </span>
            </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>
<body>
	<form class="layui-form" method="post" id="inputForm" enctype="mutipart/form-data">
		<div class="layui-colla-item">
			<div class="layui-colla-content layui-show" >
			<table class="layui-table">
			<tbody>
	        <tr>
	        	##单位
				<td class="textRight" width="15%">#springMessage('sys.user.corpContain.show')</td>
				<td width="35%"> 
    				<div class="bt-biz-corp"
                        data-biz-type="corp"
                        data-biz-name="corpId"
                        data-type="selectTree"
                        data-name="corpId"
                        data-scope="all"
						data-required="true"
                        data-resource="ttpay:merchant:op"
						placeholder="#springMessage('sys.user.corpContain.show')">
                    </div>
				</td>  
               ##商户号	
				<td class="textRight" width="15%">#springMessage('ttpay.merchantNo')</td>   
				<td width="35%">
    				<div class="layui-input-inline">
                    	<input type="text" name="merchantNo" class="layui-input" lay-verify="required|strlength" data-maxlength="200"  placeholder="#springMessage('ttpay.merchantNo')" value="" >
    				</div>
                </td>
			 </tr>
			 <tr>
	        	##支付方式
				<td class="textRight" width="15%">#springMessage('ttpay.payType')</td>
				<td width="35%"> 
    				<div class="layui-input-inline">
                    	<div class="bt-biz-dict" data-type="select" data-name="payType" data-biz-name="payType" data-group="TTPAY_PAY_TYPE" data-required="true" ></div>
    				</div>
                </td>
                ##启用标志
				<td class="textRight" width="15%">#springMessage('ttpay.isOnline')</td>
				<td width="35%">  
    				<div class="layui-input-inline">
                    	<div class="bt-biz-dict" data-type="radio" data-name="isOnline" data-biz-name="isOnline" data-group="sf_yn" data-value="1"></div>
    				</div>
                </td>  
              </tr>		
            <tr>
	        	##备注
				<td class="textRight" width="15%">#springMessage('ttpay.rmk')</td>
				<td colspan="3">
    				<div class="layui-input-inline">
                    	<input type="text" name="rmk" class="layui-input" lay-verify="strlength" data-maxlength="200"  placeholder="#springMessage('ttpay.rmk')" value="" >
    				</div>
                </td>  
              </tr>	
				</tbody>
             </table>	
  			</div>
			
			<h2 class="layui-colla-title">#springMessage('ttpay.title.sonMerchant')</h2>
			<button class="layui-btn" type="button" onclick="addSonMerchant()" >#springMessage('common.button.add')</button><br>
			<div class="layui-colla-content layui-show" >
			<table class="layui-table" id="sonMerchantTable">

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm" enctype="mutipart/form-data">
    <input id="id" name="id" value="$!{tpBussiness.id}" type="hidden"/>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('contract.type.basicInfo')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##编号
                        <td class="textRight">#springMessage('table.nisWageDetail.wageDtlNo')</td>
                        <td>
                            <input type="text" name="code" id="code"  lay-verify="required|strlength" value="$!{tpBussiness.code}" onblur="checkNO(this)"
                                   data-maxlength="20" autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisWageDetail.wageDtlNo')">
                        </td>
                        ##商户类型
                        <td class="textRight">#springMessage('ttpay.shopType.type')</td>
                        <td>
                            <div class=layui-inline>
                                <div class=bt-biz-selectType
                                     data-name="shopType"
                                     data-textField="shopType"
                                     data-valueField="id"
                                     data-defaultvalue="$!{tpBussiness.shopType}"
                                     data-biz-name="shopType"
                                     data-url="${basePath}/ttpay/shopType/getTypeName"
                                     data-inputvalue="true"
                                     data-search="true"
                                     data-required="true"></div>
                            </div>
##                            <div class="bt-biz-dict" data-type="select"
##                                 data-group="external.type" data-required="true"
##                                 data-name="shopType" data-defaultvalue="$!{tpBussiness.shopType}"></div>
##                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##商户名称
                        <td class="textRight">#springMessage('table.rasShop.shopName')</td>
                        <td>
                            <input type="text" name="shopName" id="shopName" value="$!{tpBussiness.shopName}" lay-verify="required|strlength"
                                   data-maxlength="20"  autocomplete="off" class="layui-input" placeholder="#springMessage('table.rasShop.shopName')">
                        </td>
                        ##有效标志
                        <td class="textRight">#springMessage('table.btCurrency.validSign')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="valid_sign"
                                 data-defaultvalue="$!{tpBussiness.isFlag}" data-name="isFlag" data-required = "true"></div>
                        </td>
                    </tr>
                    <tr>
                        ##使用单位
                        <td class="textRight">#springMessage('ttpay.bussiness.useCorp')</td>
                        <td style="width: 35%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-type="selectTree"
                                     data-defaultvalue="$!{tpBussiness.corpId}"
                                     data-resource="ttpay:shop:bussniss:edit"
                                     data-name="corpId"
                                     data-tree-type="check"
                                     data-checkkboxtype='{"Y":"s","N":"s"}'
                                     data-biz-name="corpId"
                                     data-scope="all"
                                     data-required="true">
                                </div>
                            </div>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>
                    </tbody>
                </table>
                </table>
            </div>
        </div>
    </div>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.externalCorp.contactInfo')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##所在省市
                        <td class="textRight">#springMessage('table.fcAccbook.prov')</td>
                        <td>
                            <input type="text" name="province" id="province" value="$!{tpBussiness.province}"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbook.prov')">
                        </td>
                        ##地址
                        <td class="textRight">#springMessage('table.fexForeign.addr')</td>
                        <td>
                            <input type="text" name="address" id="address" value="$!{tpBussiness.address}"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeign.addr')">
                        </td>
                    </tr>
                    <tr>
                        ##联系人
                        <td class="textRight">#springMessage('table.externalCorp.linkMan')</td>
                        <td>
                            <input type="text" name="contactMan" id="contactMan" value="$!{tpBussiness.contactMan}"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.externalCorp.linkMan')">
                        </td>
                        ##联系电话
                        <td class="textRight">#springMessage('sys.user.phone.show')</td>
                        <td>
                            <input lay-verify="strlength" type="text" name="tel" id="tel" value="$!{tpBussiness.tel}" data-maxlength="11"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('sys.user.phone.show')">
                        </td>
                    </tr>
                    </tbody>
                </table>
                </table>
            </div>
        </div>
    </div>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.externalCorp.accountInfo')</h2>
            <div class="layui-colla-content layui-show ignore-required-icon" style="margin-bottom: 10px;">
                <table class="layui-table" id="relevanceTB">
                    <thead>
                    <tr>
                        <th style="width: 15%"><span class="pl"><span class="required-icon">*</span></span>#springMessage('ttpay.payType')</th> ##支付方式
                        <th style="width: 15%"><span class="pl"><span class="required-icon">*</span></span>#springMessage('ttpay.bussiness.payType')</th>	##支付类型
                        <th style="width: 15%">#springMessage('ttpay.bussiness.loginNo')</th> ##登录号
                        <th style="width: 15%">#springMessage('bis.check.mobileNo')</th>	##手机号
                        <th style="width: 20%">#springMessage('ttpay.mail')</th> ##邮箱
                        <th style="width: 15%">#springMessage('table.bvStorageBox.rmk')</th>	##备注
                        <th style="width: 5%">#springMessage('table.createRepayPlan.operation')</th>	##操作
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
                </table>
            </div>
        </div>
    </div>
    <div align="center">
        <button class="layui-btn layui-btn-small" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
        <button type="reset" class="layui-btn layui-btn-primary lay	ui-btn-small">#springMessage("common.button.reset")</button>
    </div>
</form>
    #parse("views/common/footer.vm")

<script src="${basePath}/static/modules/ttpay/bussiness.update.js?_btv=${resourceVersion}"></script>
</body>
</html>
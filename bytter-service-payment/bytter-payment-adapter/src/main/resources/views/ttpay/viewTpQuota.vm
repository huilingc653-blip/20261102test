<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{inqPublishPage.id}">
    <input id="createBy" name="createBy" type="hidden" value="$!{inqPublishPage.createBy}">
    <input id="createDate" name="createDate" type="hidden" value="$!{inqPublishPage.createDate}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{inqPublishPage.updateBy}">
    <input id="updateDate" name="updateDate" type="hidden" value="$!{inqPublishPage.updateDate}">
    <table class="layui-table layui-table-border">
        <thead>
        <tr>
            <td colspan="10">#springMessage('table.query.message')</td>
        </tr>
        </thead>
        <tbody>
        <tr>
            ##所属单位
            <td class="textRight" width="30%">#springMessage('sys.user.corpContain.show')</td>
            <td>$!{tpQuotaInfo.corpName}</td>
        </tr>
        <tr>
            ##商户类别
            <td class="textRight">#springMessage('ttpay.payType')</td>
            <td>$!dictTag.get("TTPAY_PAY_TYPE",$!{tpQuotaInfo.payWay})</td>
        </tr>
        <tr>
            ##商户号
            <td class="textRight" width="30%">#springMessage('ttpay.merchantNo')</td>
            <td>$!{tpQuotaInfo.merchantNo}</td>
        </tr>
        <tr>
            ##有效标志
            <td class="textRight">#springMessage('table.btCurrency.validSign')</td>
            <td>$!dictTag.get("valid_sign",$!{tpQuotaInfo.validSign})</td>
        </tr>
        <tr>
            ##生效日期
            <td class="textRight">#springMessage('table.ttpay.effectDate')</td>
            <td>$!date.format('yyyy-MM-dd',$!tpQuotaInfo.effectDate) </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('ttpay.rmk')</td>
            <td>$!{tpQuotaInfo.rmk}</td>
        </tr>
        </tbody>
    </table>
    <table class="layui-table layui-table-border" style="margin-bottom:8px">
        <thead>
        <tr>
            <td colspan="10">#springMessage('table.fexCorpPool.limit')</td>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td rowspan="2" colspan="2" align="center">#springMessage('ttpay.quota.daysingle')</td>
            <td colspan="4" align="center">#springMessage('ttpay.quota.dayTotal')</td>
            <td colspan="4" align="center">#springMessage('ttpay.quota.monthTotal')</td>
        </tr>
        <tr>
            <td colspan="2" align="center">#springMessage('ttpay.quota.availableMoney')</td>
            <td colspan="2" align="center">#springMessage('ttpay.quota.configMoney')</td>
            <td colspan="2" align="center">#springMessage('ttpay.quota.availableMoney')</td>
            <td colspan="2" align="center">#springMessage('ttpay.quota.configMoney')</td>
        </tr>
        <tr>
            <td colspan="2" align="right">
                #if($!{tpQuotaInfo.daySingle})
                    $number.formatNumeric($!{tpQuotaInfo.daySingle})
                #end
            </td>
            <td colspan="2" align="right">
                #if($!{tpQuotaInfo.dayTotalAvail})
                    $number.formatNumeric($!{tpQuotaInfo.dayTotalAvail})
                #end
            </td>
            <td colspan="2" align="right">
                #if($!{tpQuotaInfo.dayTotal})
                    $number.formatNumeric($!{tpQuotaInfo.dayTotal})
                #end
            </td>
            <td colspan="2" align="right">
                #if($!{tpQuotaInfo.monthTotalAvail})
                    $number.formatNumeric($!{tpQuotaInfo.monthTotalAvail})
                #end
            </td>
            <td colspan="2" align="right">
                #if($!{tpQuotaInfo.monthTotal})
                    $number.formatNumeric($!{tpQuotaInfo.monthTotal})
                #end
            </td>
        </tr>
        </tbody>
    </table>

    <div align="center">
        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
        #*  <button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>*#
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ttpay/tpQuota.add.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
            ##所属单位
            <td class="textRight" width="10%">#springMessage('sys.user.corpContain.show')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                        data-tree-type="check"
                        data-biz-type="corp"
						data-biz-name="corpId"
                        data-type="selectTree"
                        data-name="corpId"
                        data-scope="all"
                        data-resource="ttpay:merchant:op"
						data-defaultvalue="$!{queryVO.corpId}"
                        placeholder="#springMessage('sys.user.corpContain.show')">
                    </div>
                </div>
            </td>
			<td class="textRight" width="10%">#springMessage('ttpay.payType')</td>
			<td width="20%">
				<div class="layui-input-inline">
                	<div class="bt-biz-dict" data-type="mulselect" data-name="payType" data-biz-name="payType" data-group="TTPAY_PAY_TYPE" data-value="$!{queryVO.payType}"></div>
				</div>
			</td>
			<td class="textRight" width="10%">#springMessage('ttpay.merchantNo')</td>
			<td width="30%">
                <div class="layui-input-inline">
                    <input type="text" name="merchantNo" id="merchantNo" value="$!{queryVO.merchantNo}"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('ttpay.merchantNo')">
                </div>
			</td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" type="button" onclick="searchForm()">#springMessage('common.button.search')</button>
                <button class="layui-btn" type="button" onclick="resetClick()">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    	</tbody>
    </table>
<div style="padding-top: 10px;">
    <button class="layui-btn" type="button" onclick="addMerchant()" >#springMessage('common.button.add')</button>
    <button class="layui-btn" type="button" onclick="importExcel()" >#springMessage('common.button.imports')</button>
</div>
<div style="width: 100%;margin-bottom: 10px;">
	<table id="appTable" class="layui-table" style="width:100%;">
        <thead>
        <tr>
            <th></th>
            <th>#springMessage('ttpay.merchantNo')</th>
            <th>#springMessage('sys.user.corpContain.show')</th>
            <th>#springMessage('ttpay.payType')</th>
            <th>#springMessage('ttpay.rmk')</th>
            <th>#springMessage('ttpay.isOnline')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
		<tbody>
    	#foreach($info in $listInfo)
    		<tr data-tt-id="$!{info.id}" data-tt-parent-id="$!{info.parentId}" >
				<td>$!{velocityCount}</td>
				<td>$!{info.merchantNo}</td>
				<td >
				#if($info.corpCode)
					($!{info.corpCode})$!{info.corpName}
				#end
				</td>
				<td >$dictTag.get("TTPAY_PAY_TYPE",$!{info.payType})</td>
				<td >$!{info.rmk}</td>
				<td >
				#if(!$info.parentId)
					#set($isOnlineName = $info.isOnlineName)
					<input type="checkbox" lay-filter="isOnlineFilter" 
						#if($info.isOnline eq '1') checked #end 
						dataId="$!{info.id}" lay-skin="switch" lay-text='#springMessage("sys.user.yesOrNo")'>
				#else
					$!{isOnlineName}
				#end
				</td>
				<td >
				#if(!$info.parentId)
					<a class="" href="#" onclick="updateMerchant('$!{info.id}')">#springMessage("common.button.edit")</a>
					<span class="text-explode">|</span>
					<a class="" href="#" onclick="deleteMerchant('$!{info.id}')">#springMessage("common.button.delete")</a>
				#end	
				</td>
            </tr>
		#end
    </table>
</div>
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ttpay/tpMerchant.list.js?_btv=${resourceVersion}"></script>
</html>

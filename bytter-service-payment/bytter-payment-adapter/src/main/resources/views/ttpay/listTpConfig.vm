<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.ttpay.titile')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.nis.budgetSel')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="tp.budgetSel" value="1" #if($config.tp.budgetSel == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                                <input type="radio" name="tp.budgetSel" value="0" #if($config.tp.budgetSel == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.ttpay.plan.subject.out')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="text" name="tp.payItem" autocomplete="off" class="layui-input" value="$!{config.tp.payItem}">
                            </div>
                            <div class="layui-input-inline" style="color:red">#springMessage('config.ttpay.plan.subject.defaultFour')</div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.ttpay.plan.subject.in')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="text" name="tp.incItem" autocomplete="off" class="layui-input" value="$!{config.tp.incItem}">
                            </div>
                            <div class="layui-input-inline" style="color:red">#springMessage('config.ttpay.plan.subject.defaultTwo')</div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.ttpay.accountOver')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="tp.bankaccOver" value="0" #if($config.tp.bankaccOver == 0)checked#end title="#springMessage('config.nis.noprompt')">
                                <input type="radio" name="tp.bankaccOver" value="1" #if($config.tp.bankaccOver == 1)checked#end title="#springMessage('config.nis.promptnocontrol')">
                                <input type="radio" name="tp.bankaccOver" value="2" #if($config.tp.bankaccOver == 2)checked#end title="#springMessage('config.nis.control')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.ttpay.accountOver.approve')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="tp.bankaccOverApprove" value="0" #if($config.tp.bankaccOverApprove == 0)checked#end title="#springMessage('config.nis.noprompt')">
                                <input type="radio" name="tp.bankaccOverApprove" value="1" #if($config.tp.bankaccOverApprove == 1)checked#end title="#springMessage('config.nis.promptnocontrol')">
                                <input type="radio" name="tp.bankaccOverApprove" value="2" #if($config.tp.bankaccOverApprove == 2)checked#end title="#springMessage('config.nis.control')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.nis.requiredBusiness')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="tp.payType" value="1" #if($config.tp.payType == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                                <input type="radio" name="tp.payType" value="0" #if($config.tp.payType == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="20%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form','jquery','rateType','moneyType','element'], function(){
        var form = bt.form(),$  = bt.jquery;
        bt.element();
        var rateTye = bt.rateType.init();
        bt.moneyType.init();
        bt.element();
        //监听提交
        form.on('submit(configSubmit)', function(data){
            $.post(basePath + "/sys/config/save",data.field,function(result){
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },"JSON");
            return false;
        });
    });
</script>
</body>
</html>
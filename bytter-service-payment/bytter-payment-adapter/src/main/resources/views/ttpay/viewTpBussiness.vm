<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm" enctype="mutipart/form-data">
    <input id="id" name="id" value="$!{tpBussiness.id}" type="hidden"/>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('contract.type.basicInfo')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table breakRow">
                    <tbody>
                    <tr>
                        ##编号
                        <td class="textRight" style="width: 20%">#springMessage('table.nisWageDetail.wageDtlNo')</td>
                        <td style="width: 50%">
                            $!{tpBussiness.code}
                        </td>
                        ##商户类型
                        <td class="textRight" style="width: 10%">#springMessage('ttpay.shopType.type')</td>
                        <td style="width: 20%">
                            $!{tpBussiness.shoptypeName}
                        </td>
                    </tr>
                    <tr>
                        ##商户名称
                        <td class="textRight">#springMessage('table.rasShop.shopName')</td>
                        <td>
                            $!{tpBussiness.shopName}
                        </td>
                        ##有效标志
                        <td class="textRight">#springMessage('table.btCurrency.validSign')</td>
                        <td>
                            $dictTag.get("valid_sign",$!{tpBussiness.isFlag})
                        </td>
                    </tr>
                    <tr>
                        ##使用单位
                        <td class="textRight">#springMessage('ttpay.bussiness.useCorp')</td>
                        <td style="width: 35%">
                            $!{tpBussiness.corpName}
                        </td>
                        <td></td>
                        <td></td>
                    </tr>
                    </tbody>
                </table>
                </table>
            </div>
        </div>
    </div>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.externalCorp.contactInfo')</h2>
            <div class="layui-colla-content layui-show" style="margin-bottom: 10px;">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##所在省市
                        <td class="textRight" style="width: 20%">#springMessage('table.fcAccbook.prov')</td>
                        <td style="width: 50%">
                            $!{tpBussiness.province}
                        </td>
                        ##地址
                        <td class="textRight" style="width: 10%">#springMessage('table.fexForeign.addr')</td>
                        <td style="width: 20%">
                            $!{tpBussiness.address}
                        </td>
                    </tr>
                    <tr>
                        ##联系人
                        <td class="textRight">#springMessage('table.externalCorp.linkMan')</td>
                        <td>
                            $!{tpBussiness.contactMan}
                        </td>
                        ##联系电话
                        <td class="textRight">#springMessage('sys.user.phone.show')</td>
                        <td>
                            $!{tpBussiness.tel}
                        </td>
                    </tr>
                    </tbody>
                </table>
                </table>
            </div>
        </div>
    </div>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.externalCorp.accountInfo')</h2>
            <div class="layui-colla-content layui-show ignore-required-icon" style="margin-bottom: 10px;">
                <table class="layui-table" id="relevanceTB">
                    <thead>
                    <tr>
                        <th style="width: 15%">#springMessage('ttpay.payType')</th> ##支付方式
                        <th style="width: 15%">#springMessage('ttpay.bussiness.payType')</th>	##支付类型
                        <th style="width: 15%">#springMessage('ttpay.bussiness.loginNo')</th> ##登录号
                        <th style="width: 15%">#springMessage('bis.check.mobileNo')</th>	##手机号
                        <th style="width: 20%">#springMessage('ttpay.mail')</th> ##邮箱
                        <th style="width: 15%">#springMessage('table.bvStorageBox.rmk')</th>	##备注
                    </tr>
                    </thead>
                    <tbody>
                        #if($!tpBussinessTextVO)
                            #foreach($tpBussinessText in $tpBussinessTextVO)
                            <tr>
                                <td>$dictTag.get("TTPAY_PAY_TYPE",$!{tpBussinessText.payType})</td>
                                <td>$dictTag.get("ttpay.payeeMode",$!{tpBussinessText.payeeMode})</td>
                                <td>$!{tpBussinessText.loginNo}</td>
                                <td>$!{tpBussinessText.phone}</td>
                                <td>$!{tpBussinessText.email}</td>
                                <td>$!{tpBussinessText.rmk}</td>
                            </tr>
                            #end
                        #end
                    </tbody>
                </table>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")

</body>
</html>

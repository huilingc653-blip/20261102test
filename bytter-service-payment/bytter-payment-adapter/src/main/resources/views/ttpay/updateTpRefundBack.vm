<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="id" id="id" value="$!{id}"/>
    <input type="hidden" name="type" id="type" value="$!{type}"/>
    <table class="layui-table">
        <tbody>
        <tr>
        ##退款金额
            <td class="textRight" width="25%">#springMessage('ttpay.refund.backMoney')</td>
            <td width="75%">
                $!number.formatNumeric($!{backMoney})
            </td>
        </tr>
        <tr>
        ##请输入打回原因
            <td class="textRight" width="25%">#springMessage('ttpay.refund.inputMsg')</td>
            <td width="75%">
                <textarea style="width : 70%" type="text" name="msg" class="layui-textarea" placeholder="#springMessage('ttpay.refund.backMsg')" lay-verify="required|msg"></textarea>
                <font color="red">#springMessage('ttpay.refundManage.refundRmkInfo')</font>
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="submit">#springMessage('common.button.confirm')</button>
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.cancel')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ttpay/tpRefundBack.edit.js?_btv=${resourceVersion}"></script>
</html>
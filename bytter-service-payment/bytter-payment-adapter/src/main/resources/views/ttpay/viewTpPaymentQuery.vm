<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <!-- 系统参数 -->
    <input id="id" name="id" type="hidden" value="$!{tpPaymentPage.id}">
    <input id="billNo" name="billNo" type="hidden" value="$!{tpPaymentPage.billNo}">
    <input id="corpId" name="corpId" type="hidden" value="$!{tpPaymentPage.corpId}">
    <input id="wishPayday" name="wishPayday" type="hidden" value="$!date.format('yyyy-MM-dd',$!{tpPaymentPage.wishPayday})">
    <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
    <input id="isBudget" name="isBudget" type="hidden" value="$!{isBudget}">
    <input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
    <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
    <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
    <input id="busType" name="busType" type="hidden" value="$!{busType}">
    <input id="billFrom" name="billFrom" type="hidden" value="$!{tpPaymentPage.billFrom}">
    <input id="expFbsin" name="expFbsin" type="hidden" value="$!{expFbsin}">
    <input id="showIsPayed" name="showIsPayed" type="hidden" value="$!{showIsPayed}">
    <input id="showIsOpenBill" name="showIsOpenBill" type="hidden" value="$!{tpPaymentPage.isOpenBill}">
    <input id="billId" name="billId" type="hidden" value="$!{tpPaymentPage.billId}">

    <!-- 资金计划参数 明细项控制模式-->
    <input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
    <input id="settlType" name="settlType" type="hidden" value="$!{tpPaymentPage.settlType}">
    <input id="sysVoucherCode" name="sysVoucherCode" type="hidden" value="$!{tpPaymentPage.sysVoucherCode}">
    <input id="curId" name="curId" type="hidden" value="$!{tpPaymentPage.curId}">
    <input id="payeeAccName" name="payeeAccName" type="hidden" value="$!{tpPaymentPage.payeeAccName}">
    <input id="payerAcc" name="payerAcc" type="hidden" value="$!{tpPaymentPage.payerAcc}">
    <input id="payeeAcc" name="payeeAcc" type="hidden" value="$!{tpPaymentPage.payeeAcc}">
    <input id="payeeBank" name="payeeBank" type="hidden" value="$!{tpPaymentPage.payeeBank}">
    <input id="purpose" name="purpose" type="hidden" value="$!{tpPaymentPage.purpose}">
    <div id="print">
        <div class="layui-collapse">
            <h2 class="layui-colla-title" style="text-align: center">#springMessage('table.nisBillhead.viewTitle')</h2>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.nisBillhead.titleInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table layui-table-border">
                        <tbody>
                        <tr>
                            ##付款单号
                            <td class="textRight" colspan="2" width="20%" >#springMessage('table.nisBillhead.billNo')</td>
                            <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{tpPaymentPage.billNo}</div></td>
                            <td class="textRight" colspan="2" width="20%">#springMessage('table.nisAllocationReq.createDate')</td>
                            <td width="30%">$!date.format('yyyy-MM-dd',$!{tpPaymentPage.createDate})</td>
                        </tr>
                        <tr>
                            <td rowspan="4" width="5%" align="center"  style="padding: 0;">
                                <div style="height: 100%;width: 100%;display:table;">
                                    <div style="display:table-cell; vertical-align:middle;">
                                        #springMessage('table.nisAllocationReq.payerInfo')
                                    </div>
                                </div>
                            </td>
                            ##单位
                            <td class="textRight"  width="20%">#springMessage('table.nisBillhead.corpId')</td>
                            <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{tpPaymentPage.corpName}</div></td>
                            <td rowspan="4" width="5%" align="center"  style="padding: 0;">
                                <div style="height: 100%;width: 100%;display:table;">
                                    <div style="display:table-cell; vertical-align:middle;">
                                        #springMessage('table.nisAllocationReq.payeeInfo')
                                    </div>
                                </div>
                            </td>
                            ##付款方式
                            <td class="textRight"  width="20%">#springMessage('ttpay.payType')</td>
                            <td width="30%">$!{tpPaymentPage.payTypeName}</td>
                        </tr>
                            <tr>
                                ##付款商户号
                                <td class="textRight" >#springMessage('ttpay.payerMerchantNo')</td>
                                <td width="20%"><div style="white-space: normal; word-break: break-all;">$!{tpPaymentPage.payerAcc}</div></td>
                                ##收款商户号
                                <td class="textRight" >#springMessage('table.nisBillhead.payeeAcc')</td>
                                <td width="20%"><div style="white-space: normal; word-break: break-all;">$!{tpPaymentPage.payeeAcc}（$!{tpPaymentPage.payeeModeName}）</div></td>
                            </tr>
                            <tr>
                                ##币别
                                <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
                                <td width="20%">$!{tpPaymentPage.curName}</td>
                                ##收款商户名称
                                <td class="textRight">#springMessage('ttpay.payeeMerchantName')</td>
                                <td width="20%"><div style="white-space: normal; word-break: break-all;">$!{tpPaymentPage.payeeAccName}</div></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.nisBillhead.payInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table layui-table-border" >
                        <tbody>
                        <tr>
                            ##业务标题
                            <td class="textRight">#springMessage('ttpay.busTitle')</td>
                            <td>$!{tpPaymentPage.busTitle}</td>
                            ##是否对私付款
                            <td class="textRight">#springMessage('table.nisBillhead.isForindividual')</td>
                            <td>$dictTag.get("sf_yn",$!{tpPaymentPage.isForindividual})</td>
                        </tr>
                        <tr>
                            ##金额
                            <td class="textRight" width="20%">#springMessage('table.nisBillhead.payMoney.lower')</td>
                            <td width="30%">
                                $!number.formatNumeric($!{tpPaymentPage.payMoney})
                                <input type="hidden" data-name="payMoney" data-toUp="payMoneyUp" autocomplete="off"
                                       class="layui-input bt-biz-moneyType" value="$!{tpPaymentPage.payMoney}">
                            </td>
                            <td class="textRight" width="20%">#springMessage('table.nisBillhead.payMoney.upper')</td>
                            <td width="30%" style="padding-left:0px"><div id="payMoneyUp" style="line-height: 24px; white-space: normal; word-break: break-all;"></div></td>
                        </tr>
                        <tr>
                            ##期望支付日期
                            <td class="textRight">#springMessage('table.nisBillhead.wishPayday')</td>
                            <td>$!date.format('yyyy-MM-dd',$!{tpPaymentPage.wishPayday})</td>
                            ##业务类别
                            <td class="textRight">#springMessage('table.nisBillhead.busType')</td>
                            <td>$!{tpPaymentPage.busTypeName}</td>
                        </tr>
                        <tr>
                            ##用途
                            <td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
                            <td width="20%">$!{tpPaymentPage.purpose}</td>
                            ##附言
                            <td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
                            <td width="20%"><div style="white-space: normal; word-break: break-all;">$!{tpPaymentPage.addWork}</div></td>
                        </tr>
                        <tr>
                            ##备注说明
                            <td class="textRight"  width="20%">#springMessage('table.settlement.rmk')</td>
                            <td width="100%" colspan="4">
                                <div class="layui-input-inline">
                                    <textarea class="layui-textarea" style="resize:none" cols="140" rows="2" disabled="true">$!{tpPaymentPage.rmk}</textarea>
                                </div>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.nisBillhead.bisExc')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table layui-table-border">
                        <tbody>
                            <tr>
                                ##商户订单号（交易唯一标识）
                                <td class="textRight">#springMessage('ttpay.trandNo')</td>
                                <td width="20%">$!{tpPaymentPage.trandNo}</td>
                                ##交易状态
                                <td class="textRight">#springMessage('table.bisExc.voucherStat')</td>
                                <td width="20%">$dictTag.get("bisExc.voucherStat",$!{tpPaymentPage.voucherStat})</td>
                            </tr>
                            <tr>
                                ##银行交易订单号
                                <td class="textRight">#springMessage('table.ttpay.bankOrderNo')</td>
                                <td width="20%">$!{tpPaymentPage.bankOrderNo}</td>
                                ##银行交易付款流水号
                                <td class="textRight">#springMessage('table.ttpay.bankPayNo')</td>
                                <td width="20%"><div style="white-space: normal; word-break: break-all;">$!{tpPaymentPage.bankPayNo}</div></td>
                            </tr>
                            <tr>
                                ##交易时间
                                <td class="textRight">#springMessage('table.bisExc.transTime')</td>
                                <td width="20%">$!date.format('yyyy-MM-dd',$!{tpPaymentPage.transTime})</td>
                                ##银行返回时间
                                <td class="textRight">#springMessage('table.bisExc.returnTime')</td>
                                <td width="20%"><div style="white-space: normal; word-break: break-all;">$!date.format('yyyy-MM-dd',$!{tpPaymentPage.returnTime})</div></td>
                            </tr>
                            <tr>
                                ##返回消息
                                <td class="textRight">#springMessage('table.abAccrecords.returnMsg')</td>
                                <td colspan="3">$!{tpPaymentPage.returnMsg}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- 资金计划 -->
        <div id="tagItemDetail"></div>
        <div style="overflow: auto">
        </div>
    </div>
    <!-- 附件上传 -->
    <input id="attachmentId" name="attachmentId" type="hidden" value="$!{tpPaymentPage.attachmentId}">
    <div id="uploader" class="layui-input-inline" style="width:100%"></div>
    <p>
        <!-- 日志 -->
    <div id="tagMsg"></div>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{tpPaymentPage.id}')">#springMessage('common.button.trackFlow')</button>
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/ttpay/tpPaymentQuery.view.js?_btv=${resourceVersion}"></script>
</body>
</html>

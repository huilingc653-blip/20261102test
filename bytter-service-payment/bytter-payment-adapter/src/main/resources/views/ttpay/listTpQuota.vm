<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##所属单位
            <td class="textRight" width="10%">#springMessage('sys.user.corpContain.show')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="likes_corpId"
                         data-resource="ttpay:quota:query"
                         data-scope="all"
                         data-callback="bt.corpCallback"></div>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('ttpay.payType')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="mulselect" data-name="ins_payWay" data-biz-name="payWay"
                         data-group="TTPAY_PAY_TYPE"></div>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('ttpay.merchantNo')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_merchantNo" id="merchantNo" value="$!{queryVO.merchantNo}"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('ttpay.merchantNo')">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="8" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                    'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('ttpay.merchantNo')</th>
        <th>#springMessage('sys.user.corpContain.show')</th>
        <th>#springMessage('ttpay.payType')</th>
        <th>#springMessage('sys.organtype.effective')</th>
        <th>#springMessage('ttpay.quota.daysingle')</th>
        <th>#springMessage('ttpay.quota.dayTotal')</th>
        <th>#springMessage('ttpay.quota.monthTotal')</th>
        <th>#springMessage('sys.cell.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ttpay/tpQuota.list.js?_btv=${resourceVersion}"></script>
</html>

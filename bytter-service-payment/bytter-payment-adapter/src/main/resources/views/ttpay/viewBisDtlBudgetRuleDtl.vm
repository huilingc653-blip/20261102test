<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <input id="id" name="id" type="hidden" value="$!{tPpBisdtlclaimVO.id}">
    <input id="billNo" name="billNo" type="hidden" value="$!{tPpBisdtlclaimVO.trandNo}">
    <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
    <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
    <input id="processDate" name="processDate" type="hidden" value="$!{tPpBisdtlclaimVO.processDate}">
    <input id="corpId" name="corpId" type="hidden" value="$!{tPpBisdtlclaimVO.corpId}">
    <input id="wishPayday" name="wishPayday" type="hidden" value="$!{tPpBisdtlclaimVO.processDate}">
    <input id="curId" name="curId" type="hidden" value="$!{tPpBisdtlclaimVO.curId}">
    <input id="payeeAcc" name="payeeAcc" type="hidden" value="$!{tPpBisdtlclaimVO.payAcc}">
<table class="layui-table">
    <thead>
    <tr>
        <th colspan="4" style="text-align:center"><h5>
            <strong>
                $!{tPpBisdtlclaimVO.payTypeName}
        </strong></h5></th>
    </tr>
    </thead>
    <tbody>
    <tr>
        ##单位名称
        <td class="textRight" width="20%">#springMessage('table.bisAccDtl.corpName')</td>
        <td width="30%">$!{tPpBisdtlclaimVO.corpName}</td>
        ##交易时间
        <td class="textRight" width="20%">#springMessage('table.bisAccDtl.transTime')</td>
        <td width="30%">$!date.format('yyyy-MM-dd HH:mm:ss',$!{tPpBisdtlclaimVO.trandTime})</td>
    </tr>
    <tr>
        ##对方账号
        <td class="textRight">#springMessage('table.btNetChalk.oppAccNo')</td>
        <td>$!{tPpBisdtlclaimVO.payAcc}</td>
        ##币别
        <td class="textRight">#springMessage('table.fbsBudgetDetail.curId')</td>
        <td>$!{tPpBisdtlclaimVO.curName}</td>
    </tr>
    <tr>
        ##金额
        <td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
        <td>$!number.formatNumeric($!{tPpBisdtlclaimVO.trandMoney})
            <input type="hidden" data-name="amt" data-toUp="amtUp" autocomplete="off"
                   class="layui-input bt-biz-moneyType" value="$!{tPpBisdtlclaimVO.trandMoney}">
        </td>
        <td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
        <td style="padding-left:0px"><div id="amtUp"></div></td>
    </tr>
    <tr>
        ##业务类别
        <td class="textRight">#springMessage('table.nisBillhead.busType')</td>
        <td>$!{tPpBisdtlclaimVO.busTypeName}</td>
        ##订单号
        <td class="textRight">#springMessage('ttpay.trandNo')</td>
        <td>$!{tPpBisdtlclaimVO.trandNo}</td>
    </tr>
    </tbody>
</table>

    <!-- 资金计划 -->
    <div id="tagItemDetail"></div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/ttpay/bisDtlBudgetRuleDtl.view.js?_btv=${resourceVersion}"></script>
</html>

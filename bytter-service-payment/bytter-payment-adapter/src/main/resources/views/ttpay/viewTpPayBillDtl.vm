<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		
		<h2 class="layui-colla-title">#springMessage("$!{payTypeTitle}")</h2>
		<table class="layui-table layui-form" style="width: 100%;">
			<tbody >
				#if($!fieldList&&$!dataInfo)
					#set($name = "num")
					#set($num = 0)
        		#foreach($vtDaField in $fieldList)
					#set($num = $num + 1)
					#if($num%2 eq 1)
						<tr >
					#end
					<td width="15%" class="textRight">#springMessage("$!{vtDaField.fieldName}")</td>
                    
					#if($!vtDaField.dataType eq "money")
						<td width="35%" class="">$!number.formatNumeric($!{dataInfo.get($vtDaField.dataKey)})</td>
					#elseif($!vtDaField.dataType eq "date")
						<td width="35%">$!dateTag.format($!{dataInfo.get($vtDaField.dataKey)},"yyyy-MM-dd")</td>
					#elseif($!vtDaField.dataType eq "time")
						<td width="35%">$!dateTag.format($!{dataInfo.get($vtDaField.dataKey)},"yyyy-MM-dd HH:mm:ss")</td>
					#elseif($!vtDaField.dictType)
						<td width="35%">$!dictTag.get($!{vtDaField.dictType},$!{dataInfo.get($vtDaField.dataKey)})</td>
					#else
						<td width="35%">$!{dataInfo.get($vtDaField.dataKey)}</td>
					#end
					#if($num%2 eq 0)
						</tr>
					#end
				#end
					#if($num%2 eq 1)
						<td width="15%" class="textRight"></td>
						<td width="35%"></td>
						</tr>
					#end
        		#end
            </tbody>
        </table>
        </div>

		## 显示退款信息
		#if($isRefund)
			<h2 class="layui-colla-title">#springMessage('ttpay.refund.applyDtl')</h2>
			<table class="layui-table">
				<thead>
				<tr>
				##退款申请单号
					<th>#springMessage('ttpay.refund.applyNo')</th>
				##退款申请时间
					<th>#springMessage('ttpay.refund.applyTime')</th>
				##退款金额
					<th>#springMessage('ttpay.refund.money')</th>
				##退款状态
					<th>#springMessage('ttpay.refund.voucherStat')</th>
				##申请人名称
					<th>#springMessage('ttpay.refund.apply')</th>
				##打回原因
					<th>#springMessage('ttpay.refund.backMsg')</th>
				##备注
					<th>#springMessage('ttpay.rmk')</th>
				</tr>
				</thead>
				<body>
					#foreach($refundInfo in $refundInfoList)
					<tr>
						<td class="textCenter">
							$!{refundInfo.backNo}
						</td>
						<td class="textCenter">
							$!date.format('yyyy-MM-dd HH:mm:ss',$!{refundInfo.backDate})
						</td>
						<td class="textCenter">
							$!number.formatNumeric($!{refundInfo.backMoney})
						</td>
						<td class="textCenter">
							$dictTag.get("ttpay.refund.voucherStat",$!{refundInfo.voucherStat})
						</td>
						<td class="textCenter">
							$!{refundInfo.createByAndName}
						</td>
						<td class="textCenter">
							$!{refundInfo.msg}
						</td>
						<td class="textCenter">
							$!{refundInfo.rmk}
						</td>
					</tr>
					#end
				</body>
			</table>
		#end
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
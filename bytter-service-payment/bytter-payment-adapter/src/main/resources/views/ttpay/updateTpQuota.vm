<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{info.id}">
    <input id="dayTotalUse" name="dayTotalUse" type="hidden" value="$!{info.dayTotalUse}">
    <input id="monthTotalUse" name="monthTotalUse" type="hidden" value="$!{info.monthTotalUse}">
    <input id="createBy" name="createBy" type="hidden" value="$!{info.createBy}">
    <input id="createDate" name="createDate" type="hidden" value="$!{info.createDate}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{info.updateBy}">
    <input id="updateDate" name="updateDate" type="hidden" value="$!{info.updateDate}">
    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            ##所属单位
            <td class="textRight" width="30%">#springMessage('sys.user.corpContain.show')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="corpId"
                         data-scope="all"
                         data-required="true"
                         data-defaultvalue="$!{info.corpId}"
                         data-disabled="true"
                         data-resource="ttpay:merchant:op">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##支付方式
            <td class="textRight">#springMessage('ttpay.payType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="TTPAY_PAY_TYPE" data-required="true"
                     data-name="payWay" data-biz-name="payWay" data-disabled="true"
                     data-defaultvalue="$!{info.payWay}"></div>
            </td>
        </tr>
        <tr>
            ##商户号
            <td class="textRight" width="30%">#springMessage('ttpay.merchantNo')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType"
                         data-url="${basePath}/ttpay/merchant/getByList?corpId=${info.corpId}&payType=${info.payWay}"
                         data-defaultvalue="$!{info.merchantId}" data-name="merchantId" data-biz-name="merchantId"
                         data-disabled="true"
                         data-valuefield="id" data-textfield="merchantNo" data-search="true" data-required="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##有效标志
            <td class="textRight">#springMessage('table.btCurrency.validSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="valid_sign"
                     data-name="validSign" data-defaultvalue="$!{info.validSign}"></div>
            </td>
        </tr>
        <tr>
            ##生效日期
            <td class="textRight">#springMessage('table.ttpay.effectDate')</td>
            <td>
                <input type="text" name="effectDate" class="layui-input bt-biz-dateType" autocomplete="off"
                       value="$!date.format('yyyy-MM-dd',$!{info.effectDate})" readonly="true"
                       placeholder="#springMessage('table.ttpay.effectDateExample')">
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('ttpay.rmk')</td>
            <td>
                <input type="text" id="rmk" name="rmk" lay-verify="strlength" data-maxlength="50"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('ttpay.rmk')"
                       value="$!{info.rmk}">
            </td>
        </tr>
        </tbody>
    </table>

    <table class="layui-table layui-table-border" style="margin-bottom:8px">
        <thead>
        <tr>
            <td colspan="10">#springMessage('table.fexCorpPool.limit')</td>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td rowspan="2" colspan="2" align="center">#springMessage('ttpay.quota.daysingle')</td>
            <td colspan="4" align="center">#springMessage('ttpay.quota.dayTotal')</td>
            <td colspan="4" align="center">#springMessage('ttpay.quota.monthTotal')</td>
        </tr>
        <tr>
            <td colspan="2" align="center">#springMessage('ttpay.quota.availableMoney')</td>
            <td colspan="2" align="center">#springMessage('ttpay.quota.configMoney')</td>
            <td colspan="2" align="center">#springMessage('ttpay.quota.availableMoney')</td>
            <td colspan="2" align="center">#springMessage('ttpay.quota.configMoney')</td>
        </tr>
        <tr>
            <td colspan="2" align="center">
                <input type="text" id="daySingle" name="daySingle" style="text-align:right" lay-verify="number2"
                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{info.daySingle}">
            </td>
            <td colspan="2" align="right">
                <div id="dayTotalAvail">
                    #if($!{info.dayTotalAvail})
                        $number.formatNumeric($!{info.dayTotalAvail})
                    #end
                </div>
            </td>
            <td colspan="2" align="center">
                <input type="text" id="dayTotal" name="dayTotal" style="text-align:right" lay-verify="number2"
                       data-callback="dayTotalBack"
                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{info.dayTotal}">
            </td>
            <td colspan="2" align="right">
                <div id="monthTotalAvail">
                    #if($!{info.monthTotalAvail})
                        $number.formatNumeric($!{info.monthTotalAvail})
                    #end
                </div>
            </td>
            <td colspan="2" align="center">
                <input type="text" id="monthTotal" name="monthTotal" style="text-align:right" lay-verify="number2"
                       data-callback="monthTotalBack"
                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{info.monthTotal}">
            </td>
        </tr>
        </tbody>
    </table>

    <div align="center">
        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
        #*  <button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>*#
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ttpay/tpQuota.update.js?_btv=${resourceVersion}"></script>
</html>

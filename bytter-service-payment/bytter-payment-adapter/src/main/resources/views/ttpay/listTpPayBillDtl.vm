<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
            ##所属单位
            <td class="textRight" width="10%">#springMessage('sys.user.corpContain.show')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                        data-tree-type="check"
                        data-biz-type="corp"
						data-biz-name="corpId"
                        data-type="selectTree"
                        data-name="ins_corpId"
                        data-resource="ttpay:paydtl:op"
						data-callback="initMerchantNoTree"
                        placeholder="#springMessage('sys.user.corpContain.show')">
                    </div>
                </div>
            </td>
			<td class="textRight" width="10%">#springMessage('ttpay.payType')</td>
			<td width="20%">
				<div class="layui-input-inline">
                	<div class="bt-biz-dict" data-type="mulselect" data-name="ins_payTypeName" data-biz-name="payType" data-group="TTPAY_PAY_TYPE" data-value="" data-callback="initMerchantNoTree"></div>
				</div>
			</td>
			<td class="textRight" width="10%">#springMessage('ttpay.merchantNo')</td>
			<td width="30%">
                <div class="layui-input-inline"><div class="merchantNo-selectTree-checkbox"></div></div>
			</td>
        </tr>
        <tr>
            ##交易日期
            <td class="textRight" width="10%">#springMessage('ttpay.trandTime')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_trandTime" class="layui-input bt-input-inline bt-biz-dateType" id="trandTimeStart" data-endid="trandTimeEnd" value="$!{trandTimeStart}" >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_trandTime" class="layui-input bt-input-inline bt-biz-dateType" id="trandTimeEnd" value="$!{trandTimeEnd}">
                </div>
            </td>
            ##交易金额
            <td class="textRight" width="10%">#springMessage('ttpay.trandMoney')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_trandMoney" data-moneyendid="endTrandMoney" autocomplete="off"
                           class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('ttpay.trandMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_trandMoney" id="endTrandMoney" autocomplete="off"
                           class="layui-input bt-input-inline bt-biz-moneyType" placeholder="#springMessage('ttpay.trandMoney')">
                </div>
            </td>
			<td class="textRight" width="10%">#springMessage('ttpay.trandNo')</td>
			<td width="30%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_trandNo" id="trandNo" value=""
                            autocomplete="off" class="layui-input" placeholder="#springMessage('ttpay.trandNo')">
                </div>
			</td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" type="button" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary" >#springMessage('common.button.reset')</button>
            </td>
        </tr>
    	</tbody>
    </table>
</form>
    <table id="appTable" class="layui-table layui-form" >
        <thead>
        <tr>
            <th>#springMessage('sys.user.corpContain.show')</th>
            <th>#springMessage('ttpay.payType')</th>
            <th>#springMessage('ttpay.merchantNo')/#springMessage('ttpay.appId')</th>
            <th>#springMessage('ttpay.serialNo')</th>
            <th>#springMessage('ttpay.trandNo')</th>
            <th>#springMessage('ttpay.payAcc')</th>
            <th>#springMessage('ttpay.trandTime')</th>
            <th>#springMessage('ttpay.trandMoney')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ttpay/tpPayBillDtl.list.js?_btv=${resourceVersion}"></script>
</html>

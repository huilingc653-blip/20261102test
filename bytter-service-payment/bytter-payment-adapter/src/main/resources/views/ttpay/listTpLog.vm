#parse("views/common/head.vm")
<table class="layui-table layui-form breakRow  dark-layui-table layui-table-border" width="100%">
    <thead>
    <tr>
        <th>#springMessage('table.abLog.logType')</th>
        <th>#springMessage('table.abLog.msg')</th>
        <th>#springMessage('table.abLog.createName')</th>
        <th>#springMessage('table.abLog.createBy')</th>
        <th>#springMessage('table.abLog.createDate')</th>
    </tr>
    </thead>
    <body>
        #if($!tpLogList)
            #foreach($tpLog in $tpLogList)
            <tr>
                <td>$!{tpLog.logTypeName}</td>
                <td>#springMessage($!{tpLog.msg})</td>
                <td>$!{tpLog.createName}</td>
                <td>$!{tpLog.createBy}</td>
                <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{tpLog.createDate})</td>
            </tr>
            #end
        #end
    </body>
</table>

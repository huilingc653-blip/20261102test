<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form">
    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            <td class="textRight" width="30%">月份</td>
            <td width="40%">
                <div class="bt-biz-dict"
                     data-type="select"
                     data-group="btBankAccDtl.months"
                     data-name="month"
                     data-biz-name="month"
                     data-required="true">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">浮动比率</td>
            <td>
                <div class="layui-input-inline">
                    <input class="layui-input bt-biz-rateType"
                           type="text"
                           data-name="floatRate"
                           data-biz-name="floatRate"
                           data-decimal="2"
                           data-supermin="-100"
                           lay-verify="required">
                </div>
            </td>
        </tr>
        </tbody>
    </table>
    <div style="text-align: center; padding-top: 10px;">
        <button type="button" class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
            'common.button.submit')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/wage/wageFloatRatioConfig.add.js?_btv=${resourceVersion}"></script>
</html>
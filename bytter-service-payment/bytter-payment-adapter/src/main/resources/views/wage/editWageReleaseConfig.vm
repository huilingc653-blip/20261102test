<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" >
        <input type="hidden" name="id" id="id" value="$!{id}">
		<table class="layui-table"  >
		<tbody>
            <tr>
                ##下拨金额
                <td class="textRight type-label">下拨金额</td>
                <td class="type-input">
                    <input type="text" data-name="releaseAmount" lay-verify="required" value="$!{releaseAmount}"
                           autocomplete="off" class="layui-input bt-biz-moneyType" data-minus="false" placeholder="下拨金额">
                </td>

            </tr>

            <tr>
                <td style="text-align: center;" colspan="4">
                    <button class="layui-btn" lay-submit="" value="11" lay-filter="submit">#springMessage('common.button.save')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/wage/wageReleaseConfig.edit.js?_btv=${resourceVersion}"></script>
</html>

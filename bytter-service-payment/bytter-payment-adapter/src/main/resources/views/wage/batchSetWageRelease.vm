<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" >
        <input type="hidden" name="ids" id="ids" value="$!{ids}">
		<table class="layui-table"  >
		<tbody>

            <tr>
                ##批量设置类型
                <td class="textRight">批量设置类型</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-dict" id="radio" data-type="radio" data-group="nis.wage.release.type"
                             data-defaultvalue="0" data-name="type" data-biz-name="type" data-callback="typeCallback">
                        </div>
                    </div>
                </td>

                ##批量设置金额
                <td class="textRight type-label">批量设置金额</td>
                <td class="type-input">
                    <input type="text" data-name="amount" lay-verify="required"
                           autocomplete="off" class="layui-input bt-biz-moneyType" data-minus="true" placeholder="增加/减少的金额">
                </td>

            </tr>

			<tr>
				<td style="text-align: center;" colspan="4">
                    <button class="layui-btn" lay-submit="" value="11" lay-filter="submit">#springMessage('common.button.save')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/wage/batchNisWageRelease.set.js?_btv=${resourceVersion}"></script>
</html>

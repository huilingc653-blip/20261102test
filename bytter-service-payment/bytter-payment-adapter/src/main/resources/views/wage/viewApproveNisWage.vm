<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view">
		<!-- 系统参数 -->
		<input id="id" name="id" type="hidden" value="$!{nisWagePage.id}">
##工资单号
    <li class="mui-table-view-cell">
		#springMessage('table.nisWage.wageNo')
        <span class="mui-badge mui-badge-inverted">
			$!{nisWagePage.wageNo}
        </span>
    </li>
##单位
    <li class="mui-table-view-cell">
		#springMessage('table.nisWage.corpId')
        <span class="mui-badge mui-badge-inverted">
			$!{nisWagePage.corpName}
        </span>
    </li>
##付款账号
    <li class="mui-table-view-cell">
		#springMessage('table.nisWage.payerAcc')
        <span class="mui-badge mui-badge-inverted">
			$!{nisWagePage.payerAcc}
        </span>
    </li>
##付款账号名称
    <li class="mui-table-view-cell">
		#springMessage('table.nisWage.payerAccName')
        <span class="mui-badge mui-badge-inverted">
			$!{nisWagePage.payerAccName}
        </span>
    </li>
##付款开户行
    <li class="mui-table-view-cell">
		#springMessage('table.nisWage.payerBank')
        <span class="mui-badge mui-badge-inverted">
			$!{nisWagePage.payerBank}
        </span>
    </li>
##币别
    <li class="mui-table-view-cell">
		#springMessage('table.nisWage.curId')
        <span class="mui-badge mui-badge-inverted">
			$!{nisWagePage.curName}
        </span>
    </li>
##金额
    <li class="mui-table-view-cell">
		#springMessage('table.nisWage.wages.lower')
        <span class="mui-badge mui-badge-inverted">
			$!number.formatNumeric($!{nisWagePage.wages})
        </span>
    </li>
##工资发放日期
    <li class="mui-table-view-cell">
        #springMessage('table.nisWage.wageDay')
        <span class="mui-badge mui-badge-inverted">
			$!date.format('yyyy-MM-dd',$!{nisWagePage.wageDay})
        </span>
    </li>
##期望支付日期
    <li class="mui-table-view-cell">
		#springMessage('table.nisWage.wishPayday')
        <span class="mui-badge mui-badge-inverted">
			$!date.format('yyyy-MM-dd',$!{nisWagePage.wishPayday})
        </span>
    </li>
##附言
    <li class="mui-table-view-cell">
		#springMessage('table.nisWage.addWord')
        <span class="mui-badge mui-badge-inverted">
			$!{nisWagePage.addWord}
        </span>
    </li>
</ul>

		#parse("views/common/wapfooter.vm")
</body>
</html>
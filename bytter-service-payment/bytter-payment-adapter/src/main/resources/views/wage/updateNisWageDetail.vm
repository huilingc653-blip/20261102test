<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<!-- 系统参数 -->
		<input id="id" name="id" type="hidden" value="$!{nisWageDetailPage.id}">
		<input id="wageDtlNo" name="wageDtlNo" type="hidden" value="$!{nisWageDetailPage.wageDtlNo}">
		<input id="wagesVerify" name="wagesVerify" type="hidden" value="$!{nisWageDetailPage.wagesVerify}">
		<input id="createBy" name="createBy" type="hidden" value="$!{nisWageDetailPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{nisWageDetailPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{nisWageDetailPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{nisWageDetailPage.updateDate}">
		<input id="voucherStat" name="voucherStat" type="hidden" value="$!{nisWageDetailPage.voucherStat}">
		<input id="returnTime" name="returnTime" type="hidden" value="$!{nisWageDetailPage.returnTime}">
		<input id="firstReturnMsg" name="firstReturnMsg" type="hidden" value="$!{nisWageDetailPage.firstReturnMsg}">
		<input id="nextReturnMsg" name="nextReturnMsg" type="hidden" value="$!{nisWageDetailPage.nextReturnMsg}">
		<!-- 付款方信息 -->
		<input id="payerBankCode" name="payerBankCode" type="hidden" value="$!{nisWagePage.payerBankCode}">
		<input id="bankNamePrefix" name="bankNamePrefix" type="hidden" value="$!{nisWagePage.bankNamePrefix}">
		<input id="payerProv" name="payerProv" type="hidden" value="$!{nisWagePage.payerProv}">
		<input id="payerCity" name="payerCity" type="hidden" value="$!{nisWagePage.payerCity}">
		<input id="payeeProv" name="payeeProv" type="hidden" value="$!{nisWageDetailPage.prov}">
		<input id="payeeCity" name="payeeCity" type="hidden" value="$!{nisWageDetailPage.city}">
		<input id="isMustCode" name="isMustCode" type="hidden" value="$!{isMustCode}">
		<table class="layui-table">
			<tbody>
			<tr>
        		##明细单号
				<td class="textRight">#springMessage('table.nisWageDetail.wageDtlNo')</td>
				<td width="35%">$!{nisWageDetailPage.wageDtlNo}</td>
        	#*</tr>
			<tr>
				##姓名
				<td class="textRight">#springMessage('table.nisWageDetail.userName')</td>
				<td width="35%">
					<input type="text" id="userName" name="userName" lay-verify="required" value="$!{nisWageDetailPage.userName}"
						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisWageDetail.userName')">
				 </td>*#
        		##工号
				<td class="textRight">#springMessage('table.nisWageDetail.workNo')</td>
				<td width="35%">
					<input type="text" id="userName" name="workNo" value="$!{nisWageDetailPage.workNo}"
						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisWageDetail.workNo')">
				 </td>
        	</tr>
			<tr>
				##银行账号
				<td class="textRight">#springMessage('table.nisWageDetail.bankAcc')</td>
				<td width="35%">
					<input type="text" id="bankAcc" name="bankAcc"  lay-verify="required" value="$!{nisWageDetailPage.bankAcc}"
						autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisWageDetail.bankAcc')">
				</td>
        		##账户名
				<td class="textRight">#springMessage('table.nisWageDetail.accName')</td>
				<td width="35%">
	        		<input type="text" id="accName" name="accName"  lay-verify="required" value="$!{nisWageDetailPage.accName}"
						autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisWageDetail.accName')">
				</td>
        	</tr>
			<tr>
        		##开户行
				<td class="textRight">#springMessage('table.nisWageDetail.bankCode')</td>
				<td colspan="3">
					<div class="layui-input-inline">
						<input type="text" id="bankCode" name="bankCode" #if($!{nisWageDetailPage.difBank}=="1" || ($!{nisWageDetailPage.difBank}=="0" && $!{isMustCode} == "1"))lay-verify="required"#end  readonly="readonly"
    						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisWageDetail.bankCode')" value="$!{nisWageDetailPage.bankCode}">
                        <div class="bt-div-search">
                            <button class="bt-biz-bankInfo" id="selPayeeBankBut" type="button"  data-callback="bt.bankinfoCallback" title="#springMessage('common.button.select')">
                                <i class="layui-icon">&#xe615;</i>
                            </button>
                        </div>
                    </div>
                    <div class="layui-input-inline">
    					<input type="text" id="bankName" name="bankName" #if($!{nisWageDetailPage.difBank}=="1")lay-verify="required"#end  readonly="readonly"
    					 	autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisWageDetail.bankName')" value="$!{nisWageDetailPage.bankName}">
                    </div>
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.nisWageDetail.idType')</td>
				<td>
					<div class="bt-biz-dict" data-type="select" data-defaultvalue="$!{nisWageDetailPage.idType}"
						 data-group="idType" data-name="idType"></div>
				</td>
				<td class="textRight">#springMessage('table.nisWageDetail.idNo')</td>
				<td>
					<input type="text" id="idNo" name="idNo" autocomplete="off" class="layui-input"
						   placeholder="#springMessage('table.nisWageDetail.idNo')" value="$!{nisWageDetailPage.idNo}">
				</td>
			</tr>
			<tr style="display: none">
				##省市
				<td class="textRight">#springMessage('table.nisBillhead.payeeAddr')</td>
				<td colspan="3">
					<div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="prov" data-change="city" data-defaultvalue="$!{nisWageDetailPage.prov}" data-callback="bt.provCallback"></div>
					<div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="city" data-defaultvalue="$!{nisWageDetailPage.city}" data-callback="bt.cityCallback"></div>
    			</td>				
        	</tr>
			<tr>
        		##跨行标志
				<td class="textRight">#springMessage('table.nisBillhead.difBank')</td>
				<td>
					<div class="layui-input-inline">
						<div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.difBank" data-defaultvalue="$!{nisWageDetailPage.difBank}" data-name="difBank" data-biz-name="difBank" data-required = "true" data-callback="bt.difBankCallback"></div>
                    </div>
				</td>
				##地域标志
				<td class="textRight">#springMessage('table.nisBillhead.areaSign')</td>
				<td>
					<div class="layui-input-inline">
						<div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.areaSign" data-defaultvalue="$!{nisWageDetailPage.areaSign}" data-name="areaSign" data-biz-name="areaSign"></div>
                    </div>
				</td>				
        	</tr>
			<tr>
				##工资用途
				<td class="textRight">#springMessage('table.nisWageDetail.purpose')</td>
				<td width="35%" colspan="3">
					<input type="text" id="purpose" name="purpose"  lay-verify="required" value="$!{nisWageDetailPage.purpose}"
						autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisWageDetail.purpose')">
				</td>				
        	</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
	<script src="${basePath}/static/modules/wage/nisWageDetail.edit.js?_btv=${resourceVersion}"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            ##月份
            <td class="textRight">月份</td>
            <td>
                <div class="bt-biz-dict"
                     data-type="select"
                     data-group="btBankAccDtl.months"
                     data-name="eqs_month"
                     data-biz-name="eqs_month">
                </div>
            </td>
        </tr>
        <tr>
            <td align="center" colspan="6">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form layui-table-border" style="width:100%;">
    <thead>
    <tr>
        <th>月份</th>
        <th>浮动比率%</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/wage/wageFloatRatioConfig.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
	<form id="searchForm" class="layui-form layui-form-pane">
		<input id="opType" name="opType" type="hidden" value="list">
		<input name="operationType" type="hidden" value="listDeal">
		<!-- 系统参数 -->
		<input id="id" name="id" type="hidden" value="$!{nisWagePage.id}">
		<input id="wageNo" name="wageNo" type="hidden" value="$!{nisWagePage.wageNo}">
		<input type="hidden" name="eqs_wageId" autocomplete="off" class="layui-input" value="$!{nisWagePage.id}">
		<input type="hidden" id="corpId" name="corpId" value="$!{nisWagePage.corpId}">
		<input type="hidden" id="bifCode" name="bifCode" value="$!{nisWagePage.bifCode}">
		<input id="status" name="status" type="hidden" value="$!{nisWagePage.status}">
		<input id="createBy" name="createBy" type="hidden" value="$!{nisWagePage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{nisWagePage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{nisWagePage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{nisWagePage.updateDate}">
		<!-- 资金计划挂接 -->	
		<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
		<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
		<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
		<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
		<input id="wagesVerify" name="wagesVerify" type="hidden" value="$!{configTag.getConfig('wage','wagesVerify')}">
		<input id="creator" name="creator" type="hidden" value="$!{configTag.getConfig('wage','creator')}">
		<input id="user" name="user" type="hidden" value="$!{user}">
		<input id="isOpenLimit" name="isOpenLimit" type="hidden" value="$!{isOpenLimit}">
		<input id="bankaccOver" name="bankaccOver" type="hidden" value="$!{bankaccOver}">
		<input type="hidden" id="balance" name="balance" style="text-align:right" readonly="readonly" data-name="balance" data-biz-name="balance"
			   autocomplete="off" class="layui-input bt-biz-moneyType"  value="$!{nisWagePage.balance}">
		<table class="layui-table">
			<thead>
            <tr>
                <th colspan="4" style="text-align:center">$!{nisWagePage.wageTitle}</th>
			</tr>
			</thead>
			<tbody>
			<tr>
        		##工资单号
				<td class="textRight">#springMessage('table.nisWage.wageNo')</td>
				<td width="35%">$!{nisWagePage.wageNo}</td>
				##单位
				<td class="textRight">#springMessage('table.nisWage.corpId')</td>
				<td width="35%">$!{nisWagePage.corpName}</td>			
        	</tr>
			<tr>
				##付款账号
				<td class="textRight">#springMessage('table.nisWage.payerAcc')</td>
				<td>
					<div class="layui-input-inline">
						<input type="text" id="payerAcc" name="payerAcc" lay-verify="required|tableData" value="$!{nisWagePage.payerAcc}" data-biz-name="payerAcc"
        					 autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisWage.payerAcc')">
        			    <table id="payerAccTable" class="hide">
        			        <thead>
        			            <tr>
        			                <th>#springMessage('table.nisBillhead.payerAcc')</th>
        			                <th>#springMessage('table.nisBillhead.payerAccName')</th>
        			                <th>#springMessage('table.nisBillhead.payerBank')</th>
									<th>#springMessage('table.nisBillhead.curId')</th>
        			            </tr>
        			        </thead>
        			    </table>
                    </div>
				</td>
				##付款账号名称
				<td class="textRight">#springMessage('table.nisWage.payerAccName')</td>
				<td width="35%">
					<div id="payerAccNameDiv" name="payerAccNameDiv">$!{nisWagePage.payerAccName}</div>
	        		<input type="hidden" id="payerAccName" name="payerAccName" value="$!{nisWagePage.payerAccName}">
				</td>				
        	</tr>
			<tr>
        		##付款开户行
				<td class="textRight">#springMessage('table.nisWage.payerBank')</td>
				<td width="35%">
					<div id="payerBankDiv" name="payerBankDiv">$!{nisWagePage.payerBank}</div>
	        		<input type="hidden" id="payerBank" name="payerBank" value="$!{nisWagePage.payerBank}">
				</td>
				##币别
				<td class="textRight">#springMessage('table.nisWage.curId')</td>
				<td width="35%">
					<div id="curDiv" name="curDiv">$!{nisWagePage.curName}</div>
					<input type="hidden" id="curId" name="curId" value="$!{nisWagePage.curId}">
				</td>				
        	</tr>
			<tr>
        		##金额
				<td class="textRight">#springMessage('table.nisWage.wages.lower')</td>
                <td width="35%">
					$!number.formatNumeric($!{nisWagePage.wages})
					<input type="hidden" data-name="wages" data-toUp="wagesUp" autocomplete="off" data-biz-name="wages" 
						class="layui-input bt-biz-moneyType" value="$!{nisWagePage.wages}">
				</td>
				<td class="textRight">#springMessage('table.nisWage.wages.upper')</td>
				<td width="35%" style="padding-left:0px"><div id="wagesUp"></div></td>
        	</tr>
			<tr>
        		##工资发放日期
				<td class="textRight">#springMessage('table.nisWage.wageDay')</td>
				<td width="35%">
					<div class="layui-input-inline">
						<input type="text" name="wageDay" lay-verify="required" class="layui-input bt-biz-dateType"
                               value="$!{nisWagePage.wageDay}" data-type="date" data-min="$!{wishPayday}" data-name="wageDay" data-biz-name="wageDay">
                    </div>
				</td>
				##期望支付日期
				<td class="textRight">#springMessage('table.nisWage.wishPayday')</td>
				<td width="35%">
					<div class="layui-input-inline">
						<input type="text" name="wishPayday" lay-verify="required" class="layui-input bt-biz-dateType" data-callback="dateCallBack"
                               value="$!{nisWagePage.wishPayday}" data-type="date" data-min="$!{wishPayday}" data-name="wishPayday" data-biz-name="wishPayday">
                    </div>
				</td>
			</tr>
			<tr>
				##附言
				<td class="textRight">#springMessage('table.nisWage.addWord')</td>
				<td width="35%">
					<input type="text" id="addWord" name="addWord"
						   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.addWord')" value="$!{nisWagePage.addWord}">
				</td>
                    <td class="textRight">#springMessage('table.nisBillhead.busType')</td>
				##业务类别
				<td>
					<input type="hidden" id="busTypeDef" name="busTypeDef" value="$!{nisWagePage.busType}">
					<div class="layui-input-inline">
						<div class="bt-biz-selectType" data-url="${basePath}/netbank/niscorpbus/listNisCorpBusVOByCorpIdAndCdSign?cdSign=&corpId=${nisWagePage.corpId}"
							 data-name="busType" data-biz-name="busType" data-defaultvalue="$!{nisWagePage.busType}"
							 data-valuefield="busId" data-textfield="busTypeName" data-inputvalue="inputvalue" data-search="true"></div>
					</div>
				</td>
        	</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
    	            <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                    <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage('common.button.reset')</button>
				</td>
			</tr>
			</tbody>
        </table>
		<!-- 资金计划 -->
		<div id="tagItemDetail"></div>
		<!-- 附件上传 -->
		<input id="attachmentId" name="attachmentId" type="hidden" value="$!{nisWagePage.attachmentId}">
		<div id="uploader" class="layui-input-inline" style="width:100%"></div>
		<table id="appTable" class="layui-table layui-form" style="width:100%;">
            <thead>
                <tr>
                    <th>#springMessage('table.nisWageDetail.wageDtlNo')</th>
        			#*<th>#springMessage('table.nisWageDetail.userName')</th>*#
                    <th>#springMessage('table.nisWageDetail.workNo')</th>
					<th>#springMessage('table.nisWageDetail.idType')</th>
					<th>#springMessage('table.nisWageDetail.idNo')</th>
                    <th>#springMessage('table.nisWageDetail.bankAcc')</th>
                    <th>#springMessage('table.nisWageDetail.accName')</th>
                    <th>#springMessage('table.nisWageDetail.bankCode')</th>
                    <th>#springMessage('table.nisWageDetail.bankName')</th>
					<th>#springMessage('table.nisWageDetail.wagesVerify')</th>
					#*<th>#springMessage('table.nisWageDetail.prov')</th>
                    <th>#springMessage('table.nisWageDetail.city')</th>*#
					<th>#springMessage('table.nisBillhead.difBank')</th>
					<th>#springMessage('table.nisBillhead.areaSign')</th>
                    <th>#springMessage('table.nisWageDetail.purpose')</th>
					<th>#springMessage('table.bisExc.voucherStat')</th>
					<th>#springMessage('table.bisExc.returnTime')</th>
                    <th>#springMessage('table.bisExc.firstReturnMsg')</th>
                    <th>#springMessage('table.bisExc.nextReturnMsg')</th>
					<th>#springMessage('common.table.thead.operation')</th>
                </tr>
            </thead>
        </table>
	</form>
    #parse("views/common/footer.vm")
		#caDataHidden()
		#caDataScript()
	<script src="${basePath}/static/js/paymentLimitAlert.js?_btv=${resourceVersion}"></script>
	<script src="${basePath}/static/modules/wage/nisWage.edit.js?_btv=${resourceVersion}"></script>
</body>
</html>

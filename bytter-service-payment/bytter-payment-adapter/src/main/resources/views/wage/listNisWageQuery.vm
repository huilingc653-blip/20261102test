<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        .col-error{
            color: red;
        }
    </style>
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input id="opType" name="opType" type="hidden" value="query">
        <input id="loginName" name="loginName" type="hidden" value="$shiro.getPrincipal().loginName">
		<table class="layui-table">
            <tbody>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage('table.nisWage.corpId')</td>
                    <td>
                        <div class="layui-inline">
                        	<div class="bt-biz-corp"
                                data-biz-type="corp"
                                data-type="selectTree"
                                 data-tree-type="check"
                                data-name="ins_corpId"
								data-resource="netbank:wage:nisWage:query"
                                data-scope="all"></div>
                        </div>
                    </td>
					##工资单号
                    <td class="textRight">#springMessage('table.nisWage.wageNo')</td>
                    <td>
                        <input type="text" name="likes_wageNo"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisWage.wageNo')">
                    </td>
                    ##金额
                    <td class="textRight">#springMessage('table.nisWage.wages')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_wages"
								autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.nisWage.wages')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_wages"
                                    autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.nisWage.wages')">
                        </div>
                    </td>
                </tr>
				<tr>
    				##付款账号
                    <td class="textRight">#springMessage('table.nisWage.payerAcc')</td>
                    <td>
                        <input type="text" name="likes_payerAcc"
                                autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.nisWage.payerAcc')">
                    </td>
    				##状态
                    <td class="textRight">#springMessage('table.nisBillhead.status')</td>
                    <td>
						<div class="bt-biz-dict" data-type="mulselect"
							data-group="nisBillhead.status" data-name="ini_status" data-displayData="0,-1,11,95,-2"></div>
                    </td>
                    ##工资发放日期
                    <td class="textRight">#springMessage('table.nisWage.wageDay')</td>
                    <td>
                        <input type="text" name="ged_wageDay" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_wageDay" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_wageDay" class="layui-input bt-input-inline bt-biz-dateType" id="led_wageDay">
                    </td>
                </tr>
				<tr>
    				##工资册标题
                    <td class="textRight">#springMessage('table.nisWage.wageTitle')</td>
                    <td>
                        <input type="text" name="likes_wageTitle"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisWage.wageTitle')">
                    </td>
    				##交易状态
                    <td class="textRight">#springMessage('table.bisExc.voucherStat')</td>
                    <td>
						<div class="bt-biz-dict" data-type="mulselect" data-group="bisExc.voucherStat" data-name="voucherStat" data-displayData="0,1,2,3,7,9,B"></div>
                    </td>
                    ##期望支付日期
                    <td class="textRight">#springMessage('table.nisWage.wishPayday')</td>
                    <td>
                        <input type="text" name="ged_wishPayday" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_wishPayday" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_wishPayday" class="layui-input bt-input-inline bt-biz-dateType" id="led_wishPayday">
                    </td>
                </tr>
                <tr>
                    <td class="textRight">#springMessage('table.nisWage.payerAccName')</td>
                    <td>
                        <input type="text" name="likes_payerAccName"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisWage.payerAccName')">
                    </td>
                    ##银行类型
                    <td class="textRight">#springMessage('btBankType.typeName')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/listFilter" data-method="get"
                                 data-valuefield="id" data-textfield="typeName" data-name="eqs_bankTypeId" data-inputvalue="inputvalue" data-search="true"></div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.nisWage.wageNo')</th>
			<th>#springMessage('table.nisWage.wageTitle')</th>
            <th>#springMessage('table.nisWage.corpId')</th>
            <th>#springMessage('table.nisWage.payerAcc')</th>
            <th>#springMessage('table.nisWage.payerAccName')</th>
            <th>#springMessage('btBankType.typeName')</th>
            <th>#springMessage('table.nisWage.curId')</th>
            <th>#springMessage('table.nisWage.wages')</th>
            <th>#springMessage('table.nisWage.wageDay')</th>
            <th>#springMessage('table.nisWage.wishPayday')</th>
            <th>#springMessage('table.nisWage.addWord')</th>
            <th>#springMessage('table.nisBillhead.status')</th>
            <th>#springMessage('table.enterpriseLimit.landingResult')</th>
            <th>#springMessage('table.nisWage.successNum')</th>
            <th>成功金额</th>
            <th>#springMessage('table.nisWage.failNum')</th>
            <th>失败金额</th>
            <th>#springMessage('table.nisWage.waitNum')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/js/paymentLimitAlert.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/wage/nisWage.listQuery.js?_btv=${resourceVersion}"></script>

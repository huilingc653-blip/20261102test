<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
            <tr>
                ##单位
                <td class="textRight">单位名称</td>
                <td >
                    <div class="layui-inline">
                        <div class="bt-biz-corp"
                             data-type="selectTree"
                             data-tree-type="check"
                             data-name="ins_corpId"
                             data-scope="all"
                             data-placeholder="#springMessage('common.placeholder.select')"
                             data-resource="wage:release:config:query">
                        </div>
                    </div>
                </td>

                ##月份
                <td class="textRight">月份</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" name="eqs_releaseDate" class="layui-input bt-input-inline bt-biz-dateType"
                               data-type="month" value="$!{releaseDate}">
                    </div>
                </td>

            </tr>

            <tr>
                ##银行账号
                <td class="textRight">银行账号</td>

                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="bankAcc" name="bankAcc" data-biz-name="bankAcc" data-name="bankAcc"
                               data-callback="accountCallBack"
                               class="layui-input bt-biz-accountTable" data-resource="wage:release:config:query"/>
                    </div>
                </td>

                ##状态
                <td class="textRight">状态</td>
                <td id="status">
                    <div class="bt-biz-dict" data-biz-name="status" data-type="mulselect"
                         data-group="nis.wage.release.status" data-name="ins_status"></div>
                </td>
            </tr>

            <tr>

                ##申请金额
                <td class="textRight">金额</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" name="geg_releaseAmount"
                               autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right">
                    </div>
                    <span class="date-mid">#springMessage('table.guaContract.range')</span>
                    <div class="layui-inline">
                        <input type="text" name="leg_releaseAmount"
                               autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right">
                    </div>
                </td>
            </tr>


            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>单位编码</th>
            <th>单位名称</th>
            <th>银行账号</th>
            <th>银行账号名称</th>
            <th>银行账号开户行</th>

            <th>上月金额</th>
            <th>本月金额</th>
            <th>状态</th>
            <th>确认人</th>
            <th>确认时间</th>

            <th>是否已生成需求清单</th>
            <th>需求清单生成时间</th>
            <th>本月单据累计下拨金额</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<div id="editHtml" class="layui-hide">
    ##批量设置金额
    <div>
        <input type="text" data-name="amount" lay-verify="required"
               autocomplete="off" class="layui-input bt-biz-moneyType" data-minus="false" placeholder="下拨金额">
    </div>
</div>
<script src="${basePath}/static/modules/wage/nisWageReleaseConfig.list.js?_btv=${resourceVersion}"></script>
</html>

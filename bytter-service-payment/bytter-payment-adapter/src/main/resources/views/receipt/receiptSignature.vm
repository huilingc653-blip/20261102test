<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
		<table  class="layui-table">
			<thead>

			</thead>
			<tbody>
				<tr>
					<td width="15%" class="textRight">#springMessage('table.fcAcc.netId')</td>
					<td width="25%" >
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="net"
                                 data-type="selectTree"
                                 data-name="netId"
                                 data-required="true"
                                 data-callback="bt.setSignatureDate"
                                 data-resource="netbank:receipt:signature"
                                 data-scope="net"></div>
                        </div>
					</td>
					<td width="15%" class="textRight">#springMessage('netbank.receipt.date')</td>
					<td width="45%">
						<div class="layui-inline">
							<input name="beginDate" class="layui-input bt-input-inline bt-biz-dateType" type="text" data-endid="endDate" data-biz-name="beginDate" lay-verify="required">
							<span class="date-mid">~</span>
							<input name="endDate" class="layui-input bt-input-inline bt-biz-dateType" id="endDate" type="text" data-biz-name="endDate" lay-verify="required">
						</div>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.eVisaType.type')</td>
					<td>
						<div class="layui-inline">
							<div class="bt-biz-dict" data-type="mulselect" data-biz-name="signType"
								 data-name="signType" data-group="eVisaType.type"></div>
						</div>
					</td>
					<td></td>
					<td></td>
				</tr>
				<tr>
					<td colspan="4" align="center"  >
                        <div class="layui-inline">
                            <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                        </div>

					</td>

				</tr>
			</tbody>
		</table>

		</div>
	</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/receipt/receiptSignature.js?_btv=${resourceVersion}"></script>
</html>

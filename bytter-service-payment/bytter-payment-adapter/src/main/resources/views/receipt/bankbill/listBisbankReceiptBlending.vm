<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

    <style>
        .select-column {
            overflow: visible!important;
        }

    </style>
</head>
<body>
<form id="receiptSearchForm" class="layui-form">
    <input type="hidden" name="eqs_id"  id="receipt_Id" value="$!{receiptId}"/>
    <table class="layui-table">
        <tbody >
        <tr>
        ##单位
            <td class="textRight" width="10%">#springMessage('table.bisAccBal.corp')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="ins_corpId"
                         data-scope="all" data-resource="netbank:receipt:bisbankreceiptBlending:query"
                         data-callback="receiptCorpCallback"></div>
                </div>
            </td>
        ##付款账号
            <td class="textRight" width="10%">#springMessage('table.nisBillhead.payerAcc')</td>
            <td width="30%">
                <input type="text" id="receipt_payAccNo" name="likes_payAccNo" lay-verify="strlength" data-maxlength="30"
                       autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.nisBillhead.payerAcc')">
            </td>
        ##付款方户名
            <td class="textRight" width="10%">#springMessage('table.eBankBill.payerAccName')</td>
            <td width="30%">
                <input type="text" id="receipt_payAccName" name="likes_payAccName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.eBankBill.payerAccName')">
            </td>
        </tr>
        <tr>
        ##收款账号
            <td class="textRight" width="10%">#springMessage('table.nisBillhead.payeeAcc')</td>
            <td width="30%">
                <input type="text" id="receipt_payeeAccNo" name="likes_payeeAccNo" lay-verify="strlength" data-maxlength="30"
                       autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.nisBillhead.payeeAcc')">
            </td>
        ##收款方户名
            <td class="textRight" width="10%">#springMessage('table.eBankBill.payeeAccName')</td>
            <td width="30%">
                <input type="text" id="receipt_payeeAccName" name="likes_payeeAccName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.eBankBill.payeeAccName')">
            </td>
        ##收支属性
            <td class="textRight">#springMessage("table.eBankBill.incomeAndExpense")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="btBankAccDtl.cdSign"  data-name="eqs_cdSign"
                     data-biz-name="receipt_cdSign" id="receipt_cdSign" ></div>
            </td>
        </tr>
        <tr>
        ##交易金额
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.amt')</td>
            <td width="30%">
                <div class="layui-inline">
                    <input type="text" name="geg_transAmt" autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="receipt_endAmt" placeholder="#springMessage('table.btBankAccDtl.amt')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_transAmt" autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" id="receipt_endAmt" placeholder="#springMessage('table.btBankAccDtl.amt')">
                </div>
            </td>
        ##交易时间
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.transTime')</td>
            <td width="30%">
                <input type="text" name="ged_charageDate" data-type="date" id="receipt_startDate" data-biz-name="ged_charageDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="receipt_endDate" >
                <span class="date-mid">~</span>
                <input type="text" name="led_charageDate" data-type="date" id="receipt_endDate" data-biz-name="led_charageDate" class="layui-input bt-input-inline bt-biz-dateType" >
            </td>
        ##状态
            <td class="textRight" width="10%">#springMessage('table.fbsBudget.status')</td>
            <td width="30%">
                <div class="bt-biz-dict" data-type="select" data-group="paymentblending_status" data-name="eqs_blendSign" data-biz-name="receipt_blendSign"
                     data-defaultvalue="" data-displayData="0,1,4"></div>
            </td>
        </tr>
        <tr>
        ##币别
            <td class="textRight">#springMessage('table.btBankAccDtl.curName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name ="eqs_curId" data-biz-name ="receipt_curId"  data-valueField="id" data-textField="curName"></div>
            </td>
        ##银行类型
            <td class="textRight">#springMessage('table.eBankBill.bankType')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/json"
                     data-valuefield="id" data-textfield="name" data-name="eqs_bifCode"></div>
            </td>
        </tr>
        ##查询
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit lay-filter="receiptSearch" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        <tr>
            <td class="textRight" width="10%">#springMessage('table.bvPrintMatchRule.matchRule')</td>
            <td colspan="5">
                <div class="bt-biz-dict" data-type="checkbox" data-group="paymentblending_matching_rule" data-name="eqs_matchingRule" data-biz-name="matchingRule"
                     data-defaultvalue="1,2,3,4,5" onclick="getDtl();"></div>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTableReceipt" class="layui-table layui-form" style="width:100%;" data-biz-name="appTableReceipt">
    <thead>
    <tr>
        <th>#springMessage('table.listPaymentBlending.blendSign')</th>
        <th>勾对时间</th>
        <th>#springMessage('table.bisAccBal.corp')</th>
        <th>#springMessage('table.btNetChalk.transTime')</th>
        <th>#springMessage('table.btBankAccDtl.amt')</th>
        <th>#springMessage('table.nisBillhead.payerAcc')</th>
        <th>#springMessage('table.eBankBill.payerAccName')</th>
        <th>#springMessage('table.eBankBill.payerBank')</th>
        <th>#springMessage('table.btBankAccDtl.curName')</th>
        <th>#springMessage('table.eBankBill.incomeAndExpense')</th>
        <th>#springMessage('table.nisBillhead.payeeAcc')</th>
        <th>#springMessage('table.eBankBill.payeeAccName')</th>
        <th>#springMessage('table.eBankBill.payeeBank')</th>
        <th>#springMessage('table.eAccrualBill.validateCode')</th>
        <th>#springMessage('table.eBankBill.billNo')</th>
        <th>#springMessage('table.btBankAccDtl.uses')</th>
    </tr>
    </thead>
</table>
<form id="searchFormDtl" class="layui-form">
    <input type="hidden" name="eqs_id" id="eqs_id"/>
    <table class="layui-table">
        <tbody >
        <tr>
        ##单位
            <td class="textRight" width="10%">#springMessage('table.bisAccBal.corp')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="ins_corpId"
                         data-scope="all" data-resource="netbank:receipt:bisbankreceiptBlending:query"
                         data-callback="dtlCorpCallback"></div>
                </div>
            </td>
        ##本方账号
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.bankAcc')</td>
            <td width="30%">
                <input type="text" id="dtl_bankAcc" name="likes_bankAcc" lay-verify="strlength" data-maxlength="30"
                       autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.btBankAccDtl.bankAcc')">
            </td>
        ##本方账户名
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.accName')</td>
            <td width="30%">
                <input type="text" id="dtl_accName" name="likes_accName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.accName')">
            </td>
        </tr>
        <tr>
        ##对方账号
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.oppAccNo')</td>
            <td width="30%">
                <input type="text" id="dtl_oppAccNo" name="likes_oppAccNo" lay-verify="strlength" data-maxlength="30"
                       autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.btBankAccDtl.oppAccNo')">
            </td>
        ##对方
            <td class="textRight" width="10%">#springMessage('table.eBankBill.payeeAccName')</td>
            <td width="30%">
                <input type="text" id="dtl_payeeAccName" name="likes_payeeAccName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.eBankBill.payeeAccName')">
            </td>
        ##借贷标志
            <td class="textRight">#springMessage("table.btBankAccDtl.cdSign")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="btBankAccDtl.cdSign" data-defaultvalue="0" data-name="cdSign"
                     data-biz-name="dtl_cdSign" id="dtl_cdSign" data-disabled="true"></div>
                <input type="hidden" name="eqs_cdSign" id="eqs_cdSign"/>
            </td>
        </tr>
        <tr>
        ##交易金额
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.amt')</td>
            <td width="30%">
                <div class="layui-inline">
                    <input type="text" name="geg_amt" autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" data-biz-name="dtl_startAmt"
                           style="text-align:right" id="dtl_startAmt" data-moneyendid="dtl_endAmt" placeholder="#springMessage('table.btBankAccDtl.amt')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_amt" autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" data-biz-name="dtl_endAmt"
                           style="text-align:right" id="dtl_endAmt" placeholder="#springMessage('table.btBankAccDtl.amt')">
                </div>
            </td>
        ##交易时间
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.transTime')</td>
            <td width="30%">
                <input type="text" name="ged_transTime" data-type="date" id="dtl_startDate" data-biz-name="dtl_startDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="dtl_endDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_transTime" data-type="date" id="dtl_endDate" data-biz-name="dtl_endDate" class="layui-input bt-input-inline bt-biz-dateType">
            </td>
        ##币别
            <td class="textRight">#springMessage('table.btBankAccDtl.curName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name ="eqs_curId" data-biz-name ="dtl_curId"  data-valueField="id" data-textField="curName"></div>
            </td>
        </tr>
        ##查询
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit lay-filter="dtlSearch" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTableDtl" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisPersonnelDetail.corpId')</th>
        <th>#springMessage('table.bisAccDtl.transTime')</th>
        <th>#springMessage('table.btBankAccDtl.amt')</th>
        <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
        <th>#springMessage('table.btBankAccDtl.accName')</th>
        <th>#springMessage('table.btBankAccDtl.curName')</th>
        <th>#springMessage('table.btBankAccDtl.cdSign')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
        <th>#springMessage('table.btBankAccDtl.remark')</th>
        <th>#springMessage('table.btBankAccDtl.uses')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/receipt/bankbill/bisbankReceiptBlending.list.js?_btv=${resourceVersion}"></script>
</html>

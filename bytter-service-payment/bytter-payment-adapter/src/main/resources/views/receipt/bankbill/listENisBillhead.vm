<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisBillhead.billNo')</th>
        <th>#springMessage('table.nisBillhead.payerAcc')</th>
        <th>#springMessage('table.nisBillhead.payerAccName')</th>
        <th>#springMessage('table.nisBillhead.voucerType')</th>
        <th>#springMessage('table.nisBillhead.payMoney')</th>
        <th>#springMessage('table.btBankAccDtl.curName')</th>
        <th>#springMessage('table.nisBillhead.payeeAcc')</th>
        <th>#springMessage('table.nisBillhead.payeeAccName')</th>
        <th>#springMessage('table.nisBillhead.wishPayday')</th>
        <th>#springMessage('table.nisBillhead.purpose')</th>
        <th>#springMessage('table.nisBillhead.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
    <tbody>
        #foreach($msg in $list)
        <tr>
            <td>$!{msg.billNo}</td>
            <td>$!{msg.payerAcc}</td>
            <td>$!{msg.payerAccName}</td>
            <td>$!{msg.voucherName}</td>
            <td style="text-align:right; padding: 10px">$!number.formatNumeric($!{msg.payMoney},'#,##0.00')</td>
            <td>$!{msg.curName}</td>
            <td>$!{msg.payeeAcc}</td>
            <td>$!{msg.payeeAccName}</td>
            <td>$!date.format('yyyy-MM-dd',$!{msg.wishPayday})</td>
            <td>$!{msg.purpose}</td>
            <td>$dictTag.get('nisBillhead.status',$!{msg.status})</td>
            <td><a class="" href="#" id="aview" vfrom="$!{msg.isFrom}" vid="$!{msg.id}" >#springMessage('common.button.view')</a></td>
        </tr>
        #end
    </tbody>
</table>
    #parse("views/common/footer.vm")
</body>
<script>
    $(document).on('click','#aview',function(){
        if($(this).attr("vfrom")=="nis_billhead") {
            billview($(this).attr("vid"))
        }else  if($(this).attr("vfrom")=="nis_wage"){
            wageview($(this).attr("vid"))
        }else if($(this).attr("vfrom")=="fex_cash_flow"){
            flowview($(this).attr("vid"))
        }
    })
    function billview(id) {
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/netbank/nisbillhead/view/" + id
        });
    }
    function wageview(id) {
        parent.layer.open({
            type: 2,
            area: ['950px', '530px'],
            maxmin: true,
            content: basePath + "/wage/niswage/view/" + id
        });
    }
    function flowview(id) {
        parent.layer.open({
            type: 2,
            area: ['950px', '530px'],
            maxmin: true,
            content: basePath + "/foreign/fexcashflow/view/" + id
        });
    }
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<table id="appTable" class="layui-table layui-form ignore-required-icon" style="width:100%;">

    <thead>
    <tr>
        <th>#springMessage('table.fcAcc.corpId')</th>
        <th>#springMessage('table.eBankBill.transTime')</th>
        <th>#springMessage('table.eBankBill.curName')</th>
        <th>#springMessage('table.eBankBill.validateCode')</th>
        <th>#springMessage('table.eBankBill.billNo')</th>
        <th>#springMessage('table.eBankBill.payMoney')</th>
        <th>#springMessage('table.eBankBill.incomeAndExpense')</th>
        <th>#springMessage('table.eBankBill.payerAcc')</th>
        <th>#springMessage('table.eBankBill.payerAccName')</th>
        <th>#springMessage('table.eBankBill.payerBank')</th>
        <th>#springMessage('table.eBankBill.payeeAcc')</th>
        <th>#springMessage('table.eBankBill.payeeAccName')</th>
        <th>#springMessage('table.eBankBill.payeeBank')</th>
        <th>#springMessage('table.eBankBill.purpose')</th>
    </tr>
    </thead>
    <tbody>
 #foreach($bisBankReceiptDtlPage in $listDtl)
    <input type="hidden"  name="id" value="$!{bisBankReceiptDtlPage.id}">
    <input type="hidden"  name="bifCode" value="$!{bisBankReceiptDtlPage.bifCode}">
    <input type="hidden"  name="abs" value="$!{bisBankReceiptDtlPage.abs}">
    <input type="hidden"  name="remark" value="$!{bisBankReceiptDtlPage.remark}">
    <input type="hidden"  name="busType" value="$!{bisBankReceiptDtlPage.busType}">
    <input type="hidden"  name="busNo" value="$!{bisBankReceiptDtlPage.busNo}">
    <input type="hidden"  name="transSerialNo" value="$!{bisBankReceiptDtlPage.transSerialNo}">
    <input type="hidden"  name="netCode" value="$!{bisBankReceiptDtlPage.netCode}">
    <input type="hidden"  name="tellerNo" value="$!{bisBankReceiptDtlPage.tellerNo}">
    <input type="hidden"  name="ebillimg" value="$!{bisBankReceiptDtlPage.ebillimg}">
    <input type="hidden"  name="filetype" value="$!{bisBankReceiptDtlPage.filetype}">
    <input type="hidden"  name="pdfToImg" value="$!{bisBankReceiptDtlPage.pdfToImg}">
    <input type="hidden"  name="prints" value="$!{bisBankReceiptDtlPage.prints}">
    <input type="hidden"  name="isFrom" value="$!{bisBankReceiptDtlPage.isFrom}">
    <input type="hidden"  name="status" value="$!{bisBankReceiptDtlPage.status}">
    <tr>
        <td>
            $!{bisBankReceiptDtlPage.corpName}
        </td>
##        交易时间
        <td>
            <input style="display: inline;width:100px;height:30px;" type="text"  name="charageDate"
                   class="layui-input bt-input-inline bt-biz-dateType" data-type="date"
                    lay-key="1"
                    value="$!{bisBankReceiptDtlPage.charageDate}">
        </td>
##        币别
        <td>
            <div class="layui-input-inline">
                <div type="list"   data-name ="curId" name="curId" class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-valueField="id" data-textField="curName"
                     data-defaultvalue="$!{bisBankReceiptDtlPage.curId}" data-required="true" data-search="true" data-callback="bt.curCallback"></div>
            </div>
         </td>
##     验证码
        <td>
            <input type="text" style="width:100px;height:30px;" name="receiptCheckCode"  value="$!{bisBankReceiptDtlPage.receiptCheckCode}"
                   autocomplete="off" class="layui-input">
        </td>
##        回单编号
        <td>
            <input type="text" style="width:100px;height:30px;" name="receiptNo"  value="$!{bisBankReceiptDtlPage.receiptNo}"
                   autocomplete="off" class="layui-input">
        </td>
##        交易金额
        <td>
            <input type="text" style="width:100px;height:30px;" name="transAmt"  value="$!{bisBankReceiptDtlPage.transAmt}"
                   autocomplete="off" class="layui-input">
        </td>
##        收支标志
        <td>
            <div class="bt-biz-dict" data-type="select" data-group="btBankAccDtl.cdSign" data-defaultvalue="$!{bisBankReceiptDtlPage.cdSign}"
                 data-name="cdSign" name="cdSign" data-biz-name="cdSign"></div>
        </td>
##        付款账号
        <td>
            <input type="text" style="width:100px;height:30px;" name="payAccNo"  value="$!{bisBankReceiptDtlPage.payAccNo}"
                   autocomplete="off" class="layui-input">
        </td>
##        付款账户名
        <td>
            <input type="text" style="width:100px;height:30px;" name="payAccName"  value="$!{bisBankReceiptDtlPage.payAccName}"
                   autocomplete="off" class="layui-input">
        </td>
##        付款方开户行
        <td>
            <input type="text" style="width:100px;height:30px;" name="payBankName"  value="$!{bisBankReceiptDtlPage.payBankName}"
                   autocomplete="off" class="layui-input">
        </td>
##        收款账号
        <td>
            <input type="text" style="width:100px;height:30px;" name="payeeAccNo"  value="$!{bisBankReceiptDtlPage.payeeAccNo}"
                   autocomplete="off" class="layui-input">
        </td>
##        收款方户名
        <td>
            <input type="text" style="width:100px;height:30px;" name="payeeAccName"  value="$!{bisBankReceiptDtlPage.payeeAccName}"
                   autocomplete="off" class="layui-input">
        </td>
##        收款开户行
        <td>
            <input type="text" style="width:100px;height:30px;" name="payeeBankName"  value="$!{bisBankReceiptDtlPage.payeeBankName}"
                   autocomplete="off" class="layui-input">
        </td>
##        用途
        <td>
            <input type="text" style="width:100px;height:30px;" name="usefor"  value="$!{bisBankReceiptDtlPage.usefor}"
                   autocomplete="off" class="layui-input">
        </td>
    </tr>
    #end
    </tbody>
    <td colspan="14" style="text-align: center;">
        <button class="layui-btn" lay-submit="" value="W"  lay-filter="submit">#springMessage('common.button.submit')</button>
        <button id="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    </td>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/receipt/bankbill/eBankBill.edit.js?_btv=${resourceVersion}"></script>
</html>

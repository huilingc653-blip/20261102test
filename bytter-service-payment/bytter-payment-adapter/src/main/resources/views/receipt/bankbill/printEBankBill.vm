<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div id="content">
    <img src="${basePath}/receipt/bisbankreceiptdtl/initImg?id=$!{id}" border='0' width="100%" data-id="$!{id}">
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
</body>
<script>
    bt.use(['form'],function () {
        window.onload = function () {
            if (isIE()) {
                if (needCLodop()) {
                    parent.layer.open({
                        title: bt.lang('fbs.budget.input.message.info'), //不显示标题栏
                        closeBtn: 0,
                        content: bt.lang('common.msg.installPrintSoft')
                        , btn: [bt.lang('common.print.doInstalling'), 'common.button.cancel']
                        , yes: function () {
                            parent.layer ? parent.layer.closeAll() : layer.closeAll();
                            window.open('/download/resource?code=402880455c5dcd90015c5dcdda790L00','_self');
                        }
                    })
                } else {
                    parent.layer ? parent.layer.closeAll() : layer.closeAll();
                    var LODOP = getLodop();
                    LODOP.PRINT_INIT("");
                    LODOP.ADD_PRINT_IMAGE(0,0,800,"100%",'<img src="'+basePath+'/receipt/bisbankreceiptdtl/initImg?id='+$("img").data("id")+'" width="800">');
                    LODOP.SET_PRINT_STYLEA(0,"Stretch",2);//(不可变形)扩展缩放模式
                    LODOP.PREVIEW();
                }
            } else {
                parent.layer ? parent.layer.closeAll() : layer.closeAll();
                window.document.body.innerHTML = document.getElementById("content").innerHTML;
                window.print();
            }
        };
    });

    //判断是否IE浏览器
    function isIE() {
        return !!(window.ActiveXObject || "ActiveXObject" in window);
    }
</script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <input type="hidden" name="billId" id="billId" value="$!{billId}">
        <tbody >
        <tr>
            ##本方账号
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.bankAcc')</td>
            <td width="30%">
                <input type="text" id="likes_bankAcc" name="likes_bankAcc"
                       value="$!{bankAcc}" autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.accName')">
            </td>
            ##本方账户名
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.accName')</td>
            <td width="30%">
                <input type="text" id="likes_accName" name="likes_accName"
                       value="$!{accName}" autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.accName')">
            </td>
        </tr>
        <tr>
            ##对方账号
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.oppAccNo')</td>
            <td width="30%">
                <input type="text" id="likes_oppAccNo" name="likes_oppAccNo"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.oppAccNo')">
            </td>
            ##对方户名
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.oppAccName')</td>
            <td width="30%">
                <input type="text" id="likes_oppAccName" name="likes_oppAccName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.oppAccName')">
            </td>
        </tr>
        <tr>
            ##借贷标志
            <td class="textRight" width="13%">#springMessage('table.bisAccDtl.cdSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="btBankAccDtl.cdSign" data-name="eqs_cdSign"></div>
            </td>
            ##交易时间
            <td class="textRight" width="13%">#springMessage('table.btBankAccDtl.transTime')</td>
            <td width="25%">
                <input type="text" name="ged_transTime" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_transTime" value="">
                <span class="date-mid">~</span>
                <input type="text" name="led_transTime" class="layui-input bt-input-inline bt-biz-dateType"
                       id="led_transTime" value="">
            </td>
        </tr>
        <tr>
            ##币别
            <td class="textRight">#springMessage('table.btBankAccDtl.curName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name ="eqs_curId" data-biz-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
            </td>
            ##状态
##            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.status')</td>
##            <td width="30%">
##                <div class="bt-biz-dict" data-type="select" data-group="paymentblending_status" data-name="eqs_blendSign" data-biz-name="eqs_blendSign"
##                     data-defaultvalue="0" data-displayData="0,1"></div>
##            </td>
        </tr>
        <tr>
            ##金额
            <td class="textRight">#springMessage('table.btBankAccDtl.amt')</td>
            <td colspan="3">
                <div class="layui-inline">
                    <input type="text" name="geg_amt" autocomplete="off" data-minus="true" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.bisExc.payMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_amt" autocomplete="off" data-minus="true" class="layui-input bt-biz-moneyType bt-input-inline"
                           data-moneyendid="t20" style="text-align:right" id="t20" placeholder="#springMessage('table.bisExc.payMoney')">
                </div>
            </td>
        </tr>
            ##查询
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary" onclick="clearAll()">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <table id="appTable" class="layui-table layui-form" style="width:100%;" >
        <thead>
        <tr>
            <th>#springMessage('table.btBankAccDtl.corp')</th>
            <th>#springMessage('table.btBankAccDtl.transTime')</th>
            <th>#springMessage('table.btBankAccDtl.amt')</th>
            <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
            <th>#springMessage('table.btBankAccDtl.accName')</th>
            <th>#springMessage('table.btBankAccDtl.curName')</th>
            <th>#springMessage('table.btBankAccDtl.cdSign')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
            <th>#springMessage('table.btBankAccDtl.remark')</th>
            <th>#springMessage('table.btBankAccDtl.uses')</th>
        </tr>
        </thead>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/receipt/bankbill/importReceiptBlend.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="10%">#springMessage('table.fcAcc.corpId')</td>
            <td width="20%"><div class="layui-input-inline">
                <div class="bt-biz-corp"
                     data-biz-type="corp"
                     data-type="selectTree"
                     data-tree-type="check"
                     data-name="ins_corpId"
                     data-scope="all"
                     data-resource="netbank:receipt:bankbill:queryhis"></div>
            </div></td>
            <td class="textRight">#springMessage('table.eBankBill.incomeAndExpense')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="btBankAccDtl.cdSign"
                     data-name="eqs_cdSign"></div>
            </td>
            <td class="textRight">#springMessage('table.eBankBill.bankType')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/listFilter"
                     data-valuefield="id" data-textfield="name" data-name="eqs_bifCode"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight" width="10%">#springMessage('table.btNetChalk.bankAcc')</td>
            <td width="20%">
                <div id="likes_bankAccDiv" class="layui-input-inline">
                    <input type="text" id="likes_bankAcc" name="likes_bankAcc" autocomplete="off"
                           data-biz-name="likes_bankAcc"  data-name="likes_bankAcc" permission="D,T" accountType="2,3"
                           class="layui-input bt-biz-accountTable" data-resource="netbank:bankAcc:bisAccBal:managerQuery"
                           data-callback="accountCallBack" data-valuefromtable="true"
                    />
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.btNetChalk.accName')</td>
            <td width="20%">

                <input type="text" id="likes_accName" name="likes_accName" autocomplete="off"
                       class="layui-input"/>
            </td>
            <td class="textRight" width="10%">#springMessage('table.eBankBill.transTime')</td>
            <td width="30%">
                <input type="text" name="ged_charageDate" data-biz-name="ged_charageDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_charageDate" value="$!date.format('yyyy-MM-dd',$!{startDate})">
                <span class="date-mid">~</span>
                <input type="text" name="led_charageDate" data-biz-name="led_charageDate" data-type="date"
                       class="layui-input bt-input-inline bt-biz-dateType" id="led_charageDate" value="$!date.format('yyyy-MM-dd',$!{endDate})">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btNetChalk.oppAccNo')</td>
            <td>
                <div id="likes_oppAccNoNoDiv" class="layui-input-inline">
                    <input type="text" id="likes_oppAccNo" name="likes_oppAccNo" autocomplete="off"
                           data-biz-name="likes_oppAccNo"  data-name="likes_oppAccNo" permission="D,T" accountType="2,3"
                           class="layui-input bt-biz-accountTable" data-resource="netbank:bankAcc:bisAccBal:managerQuery"
                           data-callback="accountCallBack2" data-valuefromtable="true"
                    />
                </div>
            </td>
            <td class="textRight">#springMessage('table.btNetChalk.oppAccName')</td>
            <td>
                <input type="text" id="likes_oppAccName" name="likes_oppAccName" autocomplete="off"
                       class="layui-input"/>
            </td>
            <td class="textRight">#springMessage('table.eBankBill.payMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="geg_transAmt"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20"
                           placeholder="#springMessage('table.eBankBill.payMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_transAmt"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" id="t20" placeholder="#springMessage('table.eBankBill.payMoney')">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.eBankBill.purpose')</td>
            <td>
                <input type="text" id="likes_usefor" name="likes_usefor" autocomplete="off" class="layui-input"/>
            </td>
            <td class="textRight">#springMessage('table.eBankBill.isRelDtl')</td>
            <td >
                <div class="bt-biz-dict" data-type="select"
                     data-group="sf_yn" data-name="eqs_isRelDtl"></div>
            </td>
            <td class="textRight">#springMessage('table.eBankBill.isRelBill')</td>
            <td >
                <div class="bt-biz-dict" data-type="select"
                     data-group="sf_yn" data-name="eqs_isRelBill"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.eBankBill.billNo')</td>
            <td colspan="6">
                <input type="text" id="likes_receiptNo" name="likes_receiptNo" autocomplete="off" class="layui-input"/>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                        'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcAcc.corpId')</th>
        <th>#springMessage('table.eBankBill.transTime')</th>
        <th>#springMessage('table.eBankBill.curName')</th>
        <th>#springMessage('table.eBankBill.validateCode')</th>
        <th>#springMessage('table.eBankBill.billNo')</th>
        <th>#springMessage('table.eBankBill.payMoney')</th>
        <th>#springMessage('table.eBankBill.incomeAndExpense')</th>
        <th>#springMessage('table.eBankBill.bankType')</th>
        <th>#springMessage('table.btNetChalk.bankAcc')</th>
        <th>#springMessage('table.btNetChalk.accName')</th>
        <th>#springMessage('table.btNetChalk.bankName')</th>
        <th>#springMessage('table.btNetChalk.oppAccNo')</th>
        <th>#springMessage('table.btNetChalk.oppAccName')</th>
        <th>#springMessage('table.btNetChalk.oppBankName')</th>
##        <th>#springMessage('table.eBankBill.payerAcc')</th>
##        <th>#springMessage('table.eBankBill.payerAccName')</th>
##        <th>#springMessage('table.eBankBill.payerBank')</th>
##        <th>#springMessage('table.eBankBill.payeeAcc')</th>
##        <th>#springMessage('table.eBankBill.payeeAccName')</th>
##        <th>#springMessage('table.eBankBill.payeeBank')</th>
        <th>#springMessage('table.eBankBill.purpose')</th>
        <th>#springMessage('table.eBankBill.prints')</th>
        <th>#springMessage('table.bisAccDtl.orderNo')</th>
        <th>#springMessage('table.bisAccDtl.billNo')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/receipt/bankbill/eBankBillHis.list.js?_btv=${resourceVersion}"></script>
</html>

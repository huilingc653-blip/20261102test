<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <table id="inputTable" class="layui-table">
        <tbody >
        <tr>
            ##银行类型
            <td class="textRight">#springMessage('table.eBankBill.bankType')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/json"  data-callback="bifCodeCallback"
                     data-search="true" data-valuefield="id" data-textfield="name" data-name="bifCodeId" data-biz-name="bifCodeId" data-required="true"></div>
            </td>
            ##本方账号
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.bankAcc')</td>
            <td width="30%">
                <input type="text" id="bankAcc" name="bankAcc" lay-verify="required|strlength" data-maxlength="30"
                       autocomplete="off" accountType="2,3"
                       data-biz-name="bankAcc"  data-name="bankAcc" permission="B"
                       class="layui-input bt-biz-accountTable" data-resource="netbank:bankAcc:bisAccBal:query"
                       data-callback="accountCallBack" data-valuefromtable="true" >
                <input type="hidden" id="accBifCode">
            </td>
        </tr>
        </tbody>
    </table>
    <div style="text-align: center; padding-top: 10px;">
        <button class="layui-btn" lay-submit="" lay-filter="submit" value="" >#springMessage('common.button.save')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    </div>
    <!-- 附件上传 -->
    <input id="attachmentId" name="attachmentId" type="hidden">
    <div id="uploader" class="layui-input-inline" style="width:100%"></div>

</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/receipt/bankbill/bisBankReceiptImport.add.js?_btv=${resourceVersion}"></script>
</html>

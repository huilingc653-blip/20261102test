<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btBankAccDtl.transTime')</th>
        <th>#springMessage('table.eBankBill.validateCode')</th>
        <th>#springMessage('table.eBankBill.billNo')</th>
        <th>#springMessage('table.eBankBill.payMoney')</th>
        <th>#springMessage('table.eBankBill.incomeAndExpense')</th>
        <th>#springMessage('table.eBankBill.payerAcc')</th>
        <th>#springMessage('table.eBankBill.payerAccName')</th>
        <th>#springMessage('table.eBankBill.payerBank')</th>
        <th>#springMessage('table.eBankBill.payeeAcc')</th>
        <th>#springMessage('table.eBankBill.payeeAccName')</th>
        <th>#springMessage('table.eBankBill.payeeBank')</th>
        <th>#springMessage('table.eBankBill.purpose')</th>
        <th>#springMessage('table.eBankBill.prints')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
    <tbody>
        #foreach($msg in $list)
        <tr>
            <td>$!date.format('yyyy-MM-dd',$!{msg.charageDate})</td>
            <td>$!{msg.receiptCheckCode}</td>
            <td>$!{msg.receiptNo}</td>
            <td style="text-align:right; padding: 10px">$!number.formatNumeric($!{msg.transAmt},'#,##0.00')</td>
            <td>$!dictTag.get('btBankAccDtl.cdSign', $!{msg.cdSign})</td>
            <td>$!{msg.payAccNo}</td>
            <td>$!{msg.payAccName}</td>
            <td>$!{msg.payBankName}</td>
            <td>$!{msg.payeeAccNo}</td>
            <td>$!{msg.payeeAccName}</td>
            <td>$!{msg.payeeBankName}</td>
            <td>$!{msg.usefor}</td>
            <td>$!{msg.prints}</td>
            <td><a class="" href="#" id="aview"  vid="$!{msg.id}" >#springMessage('common.button.view')</a></td>
        </tr>
        #end
        #foreach($msg in $hislist)
        <tr>
            <td>$!date.format('yyyy-MM-dd',$!{msg.charageDate})</td>
            <td>$!{msg.receiptCheckCode}</td>
            <td>$!{msg.receiptNo}</td>
            <td style="text-align:right; padding: 10px">$!number.formatNumeric($!{msg.transAmt},'#,##0.00')</td>
            <td>$!dictTag.get('btBankAccDtl.cdSign', $!{msg.cdSign})</td>
            <td>$!{msg.payAccNo}</td>
            <td>$!{msg.payAccName}</td>
            <td>$!{msg.payBankName}</td>
            <td>$!{msg.payeeAccNo}</td>
            <td>$!{msg.payeeAccName}</td>
            <td>$!{msg.payeeBankName}</td>
            <td>$!{msg.usefor}</td>
            <td>$!{msg.prints}</td>
            <td><a class="" href="#" id="hisaview"  vid="$!{msg.id}" >#springMessage('common.button.view')</a></td>
        </tr>
        #end
    </tbody>
</table>
    #parse("views/common/footer.vm")
</body>
<script>
    $(document).on('click','#aview',function(){
       view($(this).attr("vid"))
    })
    $(document).on('click','#hisaview',function(){
        hisview($(this).attr("vid"))
    })
    function view(id) {
        parent.layer.open({
            title: false, //不显示标题栏
            type: 2,
            area: ['810px', '450px'],
            closeBtn :0,//不显示关闭按钮
            content: [basePath + "/netbank/nisbillhead/viewReceipt/" + id]
            , btn: [bt.lang('common.button.download'), bt.lang('common.button.print'), '<i class="layui-icon">&#x1006;</i> ']
            , yes: function () {
                window.location = basePath + "/receipt/bisbankreceiptdtl/download?id=" + id;
                parent.layer ? parent.layer.closeAll() : layer.closeAll();
            }
            ,btn2: function () {
                print(id);
            }
            , btn3: function () {
                parent.layer ? parent.layer.closeAll() : layer.closeAll();
            }
        });
    }
    function hisview(id) {
        parent.layer.open({
            title: false, //不显示标题栏
            type: 2,
            area: ['810px', '450px'],
            closeBtn :0,//不显示关闭按钮
            content: [basePath + "/netbank/nisbillhead/viewHisReceipt/" + id]
            , btn: [bt.lang('common.button.download'), bt.lang('common.button.print'), '<i class="layui-icon">&#x1006;</i> ']
            , yes: function () {
                window.location = basePath + "/receipt/bisbankreceiptdtlhis/download?id=" + id;
                parent.layer ? parent.layer.closeAll() : layer.closeAll();
            }
            ,btn2: function () {
                hisprint(id);
            }
            , btn3: function () {
                parent.layer ? parent.layer.closeAll() : layer.closeAll();
            }
        });
    }
    /**
     * 打印电子回单
     * @param id
     */
    function print(id) {
        parent.layer.open({
            type: 2,
            zIndex: -100,
            shade: 0,
            content: basePath + "/netbank/nisbillhead/print?id=" + id
        });
    }
    /**
     * 打印历史电子回单
     * @param id
     */
    function hisprint(id) {
        parent.layer.open({
            type: 2,
            zIndex: -100,
            shade: 0,
            content: basePath + "/netbank/nisbillhead/printHis?id=" + id
        });
    }
</script>
</html>

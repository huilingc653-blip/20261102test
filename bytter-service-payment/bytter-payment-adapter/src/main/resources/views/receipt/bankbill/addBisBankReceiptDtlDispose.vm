<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{bisBankReceiptDtlDisposePage.id}">
    <input id="createBy" name="createBy" type="hidden" value="$!{bisBankReceiptDtlDisposePage.createBy}">
    <input id="createDate" name="createDate" type="hidden" value="$!{bisBankReceiptDtlDisposePage.createDate}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{bisBankReceiptDtlDisposePage.updateBy}">
    <input id="updateDate" name="updateDate" type="hidden" value="$!{bisBankReceiptDtlDisposePage.updateDate}">
    <table class="layui-table">
        <tbody >
            ####银行类别
        <tr>
            <td class="textRight">#springMessage('table.bisBankReceiptDtlDispose.bankTypeName')</td>
            <td>
                <div data-name="bankTypeId" class="bt-biz-selectType"
                     data-url="${basePath}/basic/business/btbanktype/json"
                     data-valueField="id"
                     data-biz-name="bankTypeId"
                     data-textField="typeName"
                     data-required="true"
                     data-search="true" data-defaultvalue="$!{bisBankReceiptDtlDisposePage.bankTypeId}"
                     data-callback="bt.bankTypeCallback"
                ></div>
            </td>
        </tr>
            ####回单编号
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.receiptNo')</td>
            <td>
                <input type="text" id="receiptNo" name="receiptNo" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.receiptNo')">
            </td>
        </tr>
            ####交易时间
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.transTime')</td>
            <td>
                <input type="text" id="transTime" name="transTime" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.transTime')">
            </td>
        </tr>
            ####币别
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.curName')</td>
            <td>
                <input type="text" id="curId" name="curId" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.curName')">
            </td>
        </tr>
            ####验证码
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.checkCode')</td>
            <td>
                <input type="text" id="checkCode" name="checkCode" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.checkCode')">
            </td>
        </tr>
            ####收支属性
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.cdSign')</td>
            <td>
                <input type="text" id="cdSign" name="cdSign" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.cdSign')">
            </td>
        </tr>
            ####交易金额
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.transAmt')</td>
            <td>
                <input type="text" id="transAmt" name="transAmt" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.transAmt')">
            </td>
        </tr>
            ####付款账号
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.payAccNo')</td>
            <td>
                <input type="text" id="payAccNo" name="payAccNo" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.payAccNo')">
            </td>
        </tr>
            ####付款方户名
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.payAccName')</td>
            <td>
                <input type="text" id="payAccName" name="payAccName" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.payAccName')">
            </td>
        </tr>
            ####付款方开户行
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.payBranchName')</td>
            <td>
                <input type="text" id="payBranchName" name="payBranchName" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.payBranchName')">
            </td>
        </tr>
            ####收款账号
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.payeeAccNo')</td>
            <td>
                <input type="text" id="payeeAccNo" name="payeeAccNo" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.payeeAccNo')">
            </td>
        </tr>
            ####收款方户名
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.payeeAccName')</td>
            <td>
                <input type="text" id="payeeAccName" name="payeeAccName" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.payeeAccName')">
            </td>
        </tr>
            ####收款方开户行
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.payeeBranchName')</td>
            <td>
                <input type="text" id="payeeBracnName" name="payeeBracnName" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.payeeBranchName')">
            </td>
        </tr>
            ####用途
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.usefor')</td>
            <td>
                <input type="text" id="usefor" name="usefor" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.usefor')">
            </td>
        </tr>
            ####备注1
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.remark1')</td>
            <td>
                <input type="text" id="remark1" name="remark1" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.remark1')">
            </td>
        </tr>
            ####备注2
        <tr>
            <td width="40%" class="textRight">#springMessage('table.bisBankReceiptDtlDispose.remark2')</td>
            <td>
                <input type="text" id="remark2" name="remark2" lay-verify="strlength" data-maxlength="40"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBankReceiptDtlDispose.remark2')">
            </td>
        </tr>
        <tr >
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/receipt/bankbill/BisBankReceiptDtlDispose.add.js?_btv=${resourceVersion}"></script>
</html>
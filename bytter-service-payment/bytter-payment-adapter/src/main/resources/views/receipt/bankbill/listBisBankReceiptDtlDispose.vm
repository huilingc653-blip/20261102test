<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.bisBankReceiptDtlDispose.bankTypeName')</td>
            <td >
                <div class="bt-biz-selectType"  type="list" field="eqs_bankTypeId" name = "eqs_bankTypeId" fieldHref="${basePath}/basic/business/btbanktype/json" dictField="id" dictText="typeName" defaultVal="$!{btBankAccAppPage.bankTypeId}" ></div>
            </td>
        </tr>
        <tr >
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.bisBankReceiptDtlDispose.bankTypeName')</th>
        <th>#springMessage('table.bisBankReceiptDtlDispose.updateDate')</th>
         <th>#springMessage('sys.menu.isEnable')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/receipt/bankbill/BisBankReceiptDtlDispose.list.js?_btv=${resourceVersion}"></script>
</html>

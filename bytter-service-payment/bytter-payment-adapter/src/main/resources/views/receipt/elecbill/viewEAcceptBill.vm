<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input type="hidden" id="fileName" value="$!{eVisaTypePage.fileName}">
    <input type="hidden" id="corpId" value="$!{eAcceptBillPage.corpId}">
    <input type="hidden" id="billNo" value="$!{eAcceptBillPage.billNo}">
    <input type="hidden" id="opType" value="$!{opType}">
    <div id="print_doc1" class="print-list">
        ##凭证头部
        <div class="print-header">
        ##记账凭证
            <div style="text-align:center;">
                <div class="print-header-name">$!{eAcceptBillPage.netName}</div>
                <div class="print-header-title">$!{eAcceptBillPage.billTypeName}</div>
            </div>
        </div>
        ##凭证内容
        <div class="print-body">
            <table style="width: 100%; " class="print-body-header">
                <tr>
                    ##记账日期
                    <td width="33%">记账日期：$!date.format('yyyy-MM-dd',$!{eAcceptBillPage.tallyDate})</td>
                    ##起息日期
                    <td width="33%">起息日期：$!date.format('yyyy-MM-dd',$!{eAcceptBillPage.accrualDate})</td>
                    ##凭证号
                    <td width="33%">凭证号：$!{eAcceptBillPage.voucherNo}</td>
                </tr>
            </table>
            <table id="dataTable" style="width: 100%; " class="layui-table">
                <tr class="bodytext">
                    <td nowrap width="3%" rowspan="3" align="center" valign="middle">
                        借
                        <br>
                        <br>
                        <br>
                        方
                    </td>
                    <td nowrap colspan="1" valign="middle" align="right" width="6%">
                        户&nbsp;&nbsp;名：&nbsp;
                    </td>
                    <td nowrap colspan="4" width="27%" align="left" valign="middle" nowrap>
                        <span id="payeeName1">
                            $!{eAcceptBillPage.payeeName}</span>
                        &nbsp;
                    </td>
                    <td nowrap width="3%" rowspan="3" align="center" valign="middle">
                        贷
                        <br>
                        <br>
                        <br>
                        方
                    </td>
                    <td nowrap colspan="1" width="6%" align="right" valign="middle">
                        户&nbsp;&nbsp;名：&nbsp;
                    </td>
                    <td nowrap colspan="4" width="27%" align="left" valign="middle" nowrap>
                        <span id="payerName1">
                            $!{eAcceptBillPage.payerName}</span>
                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td nowrap colspan="1" valign="middle" align="right">
                        账&nbsp;&nbsp;号：&nbsp;
                    </td>
                    <td nowrap colspan="4" align="left" valign="middle">
                        <span id="payeeAcc1">
                            $!{eAcceptBillPage.payeeAcc}</span>
                        &nbsp;
                    </td>
                    <td nowrap colspan="1" align="right" valign="middle">
                        账&nbsp;&nbsp;号：&nbsp;
                    </td>
                    <td nowrap colspan="4" align="left" valign="middle">
                        <span id="payerAcc1">
                            $!{eAcceptBillPage.payerAcc}</span>
                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td nowrap colspan="1" align="right" valign="middle">
                        开户行：&nbsp;
                    </td>
                    <td nowrap colspan="4" align="left" valign="middle">
                        <span id="payeeBank1">
                            $!{eAcceptBillPage.payeeBank}</span>
                        &nbsp;
                    </td>
                    <td nowrap colspan="1" align="right" valign="middle">
                        开户行：&nbsp;
                    </td>
                    <td nowrap colspan="4" align="left" valign="middle">
                        <span id="payerBank1">
                            $!{eAcceptBillPage.payerBank}</span>
                        &nbsp;
                    </td>
                </tr>
                ##                <tr class="bodytext">
                ##                    <td nowrap colspan="2" align="right" valign="middle">
                ##                        金额：&nbsp;
                ##                    </td>
                ##                    <td nowrap colspan="10" align="left" valign="middle" nowrap>
                ##					<span id="currency1">
                ##                        $!{eAcceptBillPage.curName}       </span>
                ##                        (大写)：
                ##                        <span id="payMoneyBig1">
                ##						    <div id="moneyUp" name="moneyUp" readonly="true" data-name="moneyUp" autocomplete="off" class="layui-input">
                ##                                </div>
                ##                        </span>
                ##                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                ##                        小写：
                ##                        <span id="payMoney1">
                ##                         <input type="hidden" class="layui-input bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                ##                                autocomplete="off" value="$!{eAcceptBillPage.payMoney}"
                ##						￥$!{eAcceptBillPage.payMoney}</span>
                ##                        &nbsp;
                ##                    </td>
                ##
                ##                </tr>

                <tr class="bodytext">
                    <td nowrap height="18" colspan="2" align="right" valign="middle">
                        金额 (大写)：&nbsp;
                    </td>
                    <td nowrap colspan="10" align="left" valign="middle" colspan="10">
                        <span id="payMoneyBig1">
                              <div id="moneyUp" style="width: 350px;display: inline-block;min-height: 0px;" name="moneyUp"
                                   readonly="true"
                                   data-name="moneyUp"></div>
                            </span>
                        <input type="hidden" class="bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                               value="$!{eAcceptBillPage.payMoney}"/>
                    </td>
                </tr>

                <tr class="bodytext">
                    <td nowrap height="18" colspan="2" align="right" valign="middle">
                        金额 (小写)：&nbsp;
                    </td>
                    <td nowrap colspan="10" align="left" valign="middle" colspan="10">
                        &nbsp;
                        <span id="currency1">$!{eAcceptBillPage.curName}</span>
                        &nbsp;
                        <span id="payMoney1">
                                ￥$!number.formatNumeric($!{eAcceptBillPage.payMoney})
                        </span>
                        &nbsp;
                    </td>
                </tr>

                <tr class="bodytext">
                    <td nowrap colspan="2" align="right" valign="middle">
                        原凭证号码：&nbsp;
                    </td>
                    <td nowrap colspan="4" align="center" valign="middle">
                        <span id="oldVoucherNo1">
                            $!{eAcceptBillPage.oldVoucher}</span>
                        &nbsp;&nbsp;
                    </td>
                    <td nowrap colspan="2" align="right" valign="middle">
                        贴息：&nbsp;
                    </td>
                    <td nowrap colspan="2" align="right" valign="middle">
                          <span id="oldVoucherMoney1">
                              $!number.formatNumeric($!{eAcceptBillPage.accessory})</span>
                        &nbsp;&nbsp;
                    </td>
                </tr>

                <tr class="bodytext">
                    <td nowrap colspan="2" align="right" valign="middle">
                        结算方式：&nbsp;
                    </td>
                    <td nowrap colspan="4" align="left" valign="middle">
                        <span id="payType1">
                            $!{eAcceptBillPage.payTypeName}</span>
                        &nbsp;&nbsp;
                    </td>
                    <td nowrap colspan="6" rowspan="3" align="left" valign="top">
                        <p style=" margin:0px; ">借：
                            <span id="debitacc1"> $!{eAcceptBillPage.debit}
                            </span>
                        </p>
                        <p style=" margin:0px;">
                            $!{eAcceptBillPage.debit1}
                        </p>
                        <p style=" margin:0px;">
                            &nbsp; &nbsp; &nbsp; &nbsp;贷：
                            <span id="creditacc1">
                                $!{eAcceptBillPage.credit}</span>
                        </p>
                        <p style=" margin:0px;">
                            $!{eAcceptBillPage.credit1}
                        </p>
                        <p style=" margin:0px;">
                            记账 ：
                            <span id="tallyName1">
                                $!{eAcceptBillPage.tallierName}</span>
                            &nbsp; &nbsp;复核：
                            <span id="checkers1">
                                $!{eAcceptBillPage.checkerName}</span>
                            &nbsp; &nbsp;主管：
                            <span id="checkers1">
                                $!{eAcceptBillPage.dayOverOperatorUsername}</span>
                        </p>
                    </td>
                </tr>


                <tr class="bodytext">
                    <td nowrap colspan="2" align="right" valign="middle">
                        备注：
                    </td>
                    <td nowrap colspan="4" align="center" valign="middle">
                         <span id="remark1">$!{eAcceptBillPage.remark}
                         </span>&nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td nowrap colspan="2" align="right" valign="middle">
                        用途：
                    </td>
                    <td nowrap colspan="4" align="left" valign="middle">
                        <span id="purpose1">
                            $!{eAcceptBillPage.purpose}</span>
                    </td>
                </tr>

                <tr>
                    <td nowrap colspan="5" rowspan="2" align="center" valign="middle">
                        <table border="0" cellspacing="0" cellpadding="0" width='106'>
                            <tr>
                                <td nowrap valign="bottom" align="center">
                                    <br/>
                                    <div style="font-size:12px;">
                                            <span id="encryImg1">
                                                <img id="imger"
                                                     src="${basePath}/download/attachment?id=$!{eVisaTypePage.fileName}"
                                                     width="$!{eVisaTypePage.picWidth}px"
                                                     ;height="$!{eVisaTypePage.picHeight}px"/>
                                             </span>
                                    </div>
                                </td>
                            </tr>
                            <TR>
                                <td nowrap align="center" valign="top"><br/><font size="2">签章时间:
                                    <span id="encryDate1">
                                        $!date.format('yyyy-MM-dd',$!{eAcceptBillPage.encryDate})</span></font><br/></td>
                            </TR>
                        </table>
                    </td>
                    <td nowrap colspan="7" align="left" valign="middle">
                        电子回单编号：
                        <span id="billNo1">$!{eAcceptBillPage.billNo}</span>

                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td nowrap colspan="7" align="left" valign="middle">
                        签章人：
                        <span id="subscriber1">$!{eAcceptBillPage.subscriber}</span>
                        &nbsp;
                    </td>
                </tr>
                <tr align="left" class="bodytext">
                    <td nowrap colspan="12" valign="middle">
                        验证码：
                        <span id="validateCode1">$!{eAcceptBillPage.validateCode}
                        </span>
                    </td>
                </tr>
                <tr align="left" class="bodytext">
                    <td nowrap colspan="12" valign="middle">
                        本次打印时间：
                        <span id="printdate1">
                            $!date.format('yyyy-MM-dd HH:mm:ss',$!date.getSystemTime())</span>
                        &nbsp; 打印人：
                        <span id="username1">
                            $shiro.getPrincipal().username</span>
                        &nbsp;
                    </td>
                </tr>

            </table>
        </div>
    </div>

</form>
<object id="LODOP_OB" classid="clsid:2105C259-1E0C-4534-8141-A753534CB4CA" width=0 height=0>
    <embed id="LODOP_EM" type="application/x-print-lodop" width=0 height=0></embed>
</object>
<br/>
<br/>
<div class="layui-form-item layui-form-submit" id="buttonDiv">
    <div>
        <button type="button" class="layui-btn" onclick="prints()">#springMessage('common.button.print')</button>
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/receipt/elecbill/eImagerPrint.js?_btv=${resourceVersion}"></script>
<script>
    bt.use(['form'],function () {
        window.onload = function () {
            var opType = $("#opType").val();
            if(opType == "1") {
                prints();
            }
        };
    });
</script>
</html>

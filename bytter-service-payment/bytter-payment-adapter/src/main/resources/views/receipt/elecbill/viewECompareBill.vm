<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input type="hidden" id="fileName" value="$!{eVisaTypePage.fileName}">
    <input type="hidden" id="corpId" value="$!{ECompareBillVO.corpId}">
    <input type="hidden" id="billNo" value="$!{ECompareBillVO.billNo}">
    <input type="hidden" id="opType" value="$!{opType}">
    <div id="print_doc1" class="print-list">
        ##凭证头部
        <div class="print-header">
        ##记账凭证
            <div style="text-align:center;">
                <div class="print-header-name">$!{ECompareBillVO.netName}</div>
                <div class="print-header-title">$!{ECompareBillVO.billTypeName}</div>
            </div>
        </div>
        ##凭证内容
        <div class="print-body">
            <table style="width: 100%; " class="print-body-header">
                <tr>
                    ##账号
                    <td width="33%">账号：$!{ECompareBillVO.accNo}</td>
                    ##户名
                    <td width="33%">户名：$!{ECompareBillVO.accName}</td>
                    ##币别
                    <td width="33%">币别：$!{ECompareBillVO.curName}</td>
                </tr>
            </table>
            <table id="dataTable" style="width: 100%; " class="layui-table breakRow">
                <tr bgcolor="#ffffff">
                    <td colspan="2" align="center" valign="middle" nowrap>
                        记账日期
                    </td>
                    <td colspan="2" align="center" valign="middle" nowrap>
                        起息日期
                    </td>
                    <td colspan="2" align="center" valign="middle" nowrap>
                        凭证号
                    </td>
                    <td colspan="1" align="center" valign="middle">
                        摘要
                    </td>
                    <td colspan="2" align="center" valign="middle" nowrap>
                        借方发生额
                    </td>
                    <td colspan="2" align="center" valign="middle" nowrap>
                        贷方发生额
                    </td>
                    <td colspan="2" align="center" valign="middle" nowrap>
                        余额
                    </td>
                </tr>
                <tr bgcolor="#ffffff" class="bodytext">
                    <td colspan="2" align="center" valign="middle" nowrap>
                        期初余额 &nbsp;
                    </td>
                    <td colspan="12" align="right" valign="middle" nowrap>
                <span id="beginbalance1">
                    $!number.formatNumeric($!{ECompareBillVO.beginBalanceWay})</span>
                    </td>
                </tr>
                #foreach($!eCompareBillPage in $!list)
                    <tr bgcolor="#ffffff" class="bodytext">
                        <td colspan="2" align="center" valign="middle" nowrap>
                            <span id="tallydate10">    $!date.format('yyyy-MM-dd',$!{eCompareBillPage.tallyDate})</span>
                        </td>
                        <td colspan="2" align="center" valign="middle" nowrap>
                            <span id="stardate10">$!date.format('yyyy-MM-dd',$!{eCompareBillPage.interestStartDate})</span>
                        </td>
                        <td colspan="2" align="center" valign="middle" nowrap>
                            <span id="voucherno10">$!{eCompareBillPage.voucherNo}</span>
                        </td>
                        <td colspan="1" align="left" valign="middle" style="word-break:break-all;width: 120px;">
                            $!{eCompareBillPage.summaryComment}
                        </td>
                        <td colspan="2" align="right" valign="middle" nowrap>
                            <span id="debitmoney10">$!number.formatNumeric($!{eCompareBillPage.debitMoney})</span>
                        </td>
                        <td colspan="2" align="right" valign="middle" nowrap>
                            <span id="creditmoney10">$!number.formatNumeric($!{eCompareBillPage.creditMoney})</span>
                        </td>
                        <td colspan="2" height="30" align="right" valign="middle" nowrap>
                            <span id="bal10">$!number.formatNumeric($!{eCompareBillPage.balance})</span>
                        </td>
                    </tr>
                #end
                <tr bgcolor="#ffffff" class="bodytext" height="30">
                    <td colspan="7" align="center">
                        合计：
                    </td>
                    <td colspan="2" align="right" valign="middle">
                <span id="listSum11">
                    $!number.formatNumeric($!{sumDebitMoney})</span>
                    </td>
                    <td colspan="2" align="right" valign="middle">
                <span id="listSum21">
                    $!number.formatNumeric($!{sumCreditMoney})</span>
                    </td>
                    <td colspan="3" align="right" valign="middle">
                        ##			<span id="listSum31">
    ##                $!number.formatNumeric($!{sumBalance})</span>
                    </td>
                    <span id="vSize1" style="display: none;">
                    1</span>

                </tr>
                <tr class="bodytext">
                    <td nowrap colspan="5" rowspan="3" align="center" valign="middle"
                        height="100">
                        <table border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td nowrap valign="bottom" align="center">
                                    <span id="encryImg1">
                                           <img id="imger"
                                                src="${basePath}/download/attachment?id=$!{eVisaTypePage.fileName}"
                                                width="$!{eVisaTypePage.picWidth}px"
                                                ;height="$!{eVisaTypePage.picHeight}px"/>
                                    </span>
                                </td>
                            </tr>
                            <TR>
                                <td nowrap align="center" valign="top"><font size="2">签章时间:
                                    <span id="encryDate1">
                                        $!date.format('yyyy-MM-dd',$!{ECompareBillVO.encryDate})
                                    </span>
                                </font></td>
                            </TR>
                        </table>
                    </td>
                    <td height="15" colspan="8" align="left" valign="middle">
                        电子回单编号:
                        $!{ECompareBillVO.billNo}
                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td height="15" colspan="8" align="left" valign="middle">
                        验证码:
                        $!{ECompareBillVO.validateCode}
                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td height="15" colspan="8" align="left" valign="middle">
                        签章人:
                        $!{ECompareBillVO.subscriber}
                        &nbsp;
                    </td>
                </tr>
                <tr align="left" class="bodytext">

                    <td height="21" colspan="13" valign="middle">
                        本次打印时间:
                        $!date.format('yyyy-MM-dd HH:mm:ss',$!date.getSystemTime())
                        &nbsp; 打印人:
                        $shiro.getPrincipal().username
                        &nbsp;
                    </td>
                </tr>
            </table>
        </div>
    </div>

</form>
<object id="LODOP_OB" classid="clsid:2105C259-1E0C-4534-8141-A753534CB4CA" width=0 height=0>
    <embed id="LODOP_EM" type="application/x-print-lodop" width=0 height=0></embed>
</object>
<br/>
<br/>
<div class="layui-form-item layui-form-submit" id="buttonDiv">
    <div>
        <button type="button" class="layui-btn" onclick="prints()">#springMessage('common.button.print')</button>
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/receipt/elecbill/eImagerPrint.js?_btv=${resourceVersion}"></script>
<script>
    bt.use(['form'],function () {
        window.onload = function () {
            var opType = $("#opType").val();
            if(opType == "1") {
                prints();
            }
        };
    });
</script>
</html>

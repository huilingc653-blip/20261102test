<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div id="print_doc1">
    <form class="layui-form layui-form-pane">
        <input type="hidden" id="fileName" value="$!{eVisaTypePage.fileName}">
        <input type="hidden" id="corpId" value="$!{eLoanBillPage.corpId}">
        <input type="hidden" id="billNo" value="$!{eLoanBillPage.billNo}">
        <input type="hidden" id="opType" value="$!{opType}">
        <div id="print_doc1" class="print-list">
            ##凭证头部
            <div class="print-header">
            ##记账凭证
                <div style="text-align:center;">
                    <div class="print-header-name">$!{eLoanBillPage.netName}</div>
                    #if(${eLoanBillPage.loanType} == "2")
                        <div class="print-header-title">还款通知单</div>
                    #else
                        <div class="print-header-title">$!{eLoanBillPage.billTypeName}</div>
                    #end
                </div>
            </div>
            ##凭证内容
            <div class="print-body">
                <table style="width: 100%; " class="print-body-header">
                    <tr>
                    ##记账日期
                        <td width="33%">记账日期：$!date.format('yyyy-MM-dd',$!{eLoanBillPage.tallyDate})</td>
                    ##起息日期
                        <td width="33%">起息日期：$!date.format('yyyy-MM-dd',$!{eLoanBillPage.accrualDate})</td>
                    ##凭证号
                        <td width="33%">凭证号：$!{eLoanBillPage.voucherNo}</td>
                    </tr>
                </table>
                <table id="dataTable" style="width: 100%; " class="layui-table">
                    <tr>
                        <td height="18" colspan="2" align="center" valign="middle">
                            贷款单位
                        </td>
                        <td height="18" colspan="4" align="center" valign="middle">
                                <span id="loanCorp1">
                                    $!{eLoanBillPage.loanCorp}
                                </span>
                            &nbsp;
                        </td>
                        <td height="18" colspan="2" align="center" valign="middle">
                            贷款账号&nbsp;
                        </td>
                        <td height="18" colspan="4" align="center" valign="middle">
                                <span id="depositAcc1">
                                    $!{eLoanBillPage.depositAcc}
                                </span>
                            &nbsp;
                        </td>
                    </tr>


                    <tr>
                        <td height="18" colspan="2" align="center" valign="middle">
                            利率&nbsp;
                        </td>
                        <td height="18" colspan="4" align="center" valign="middle">
                                <span id="loanRate1">
    ##                                $!{eLoanBillPage.loanRate}
                                     $rateTag.show($!eLoanBillPage.loanRate)
                                </span>
                            &nbsp;
                        </td>
                        <td height="18" colspan="2" align="center" valign="middle">
                            合同号&nbsp;
                        </td>
                        <td height="18" colspan="4" align="center" valign="middle">
                                <span id="contractCode1">
                                    $!{eLoanBillPage.contractCode}
                                </span>
                            &nbsp;
                        </td>
                    </tr>

                    <tr>
                        <td height="18" colspan="2" align="center" valign="middle">
                            借&nbsp;
                        </td>
                        <td height="18" colspan="4" align="center" valign="middle">
                                <span id="contractCode1">
                                    $!{eLoanBillPage.debitAcc}
                                </span>
                            &nbsp;
                        </td>
                        <td height="18" colspan="2" align="center" valign="middle">
                            贷&nbsp;
                        </td>
                        <td height="18" colspan="4" align="center" valign="middle">
                                <span id="contractCode1">
                                    $!{eLoanBillPage.creditAcc}
                                </span>
                            &nbsp;
                        </td>
                    </tr>

                    <tr>
                        #if(${eLoanBillPage.loanType} == "2")
                            <td height="18" colspan="2" align="center" valign="middle">
                                还款日期&nbsp;
                            </td>
                            <td height="18" colspan="4" align="center" valign="middle">
                                <span id="loanDate1">
                                    $!date.format('yyyy-MM-dd',$!{eLoanBillPage.returnDate})
                                </span>
                                &nbsp;
                            </td>
                        #else
                        <td height="18" colspan="2" align="center" valign="middle">
                            贷款日期&nbsp;
                        </td>
                        <td height="18" colspan="4" align="center" valign="middle">
                                <span id="loanDate1">
                                    $!date.format('yyyy-MM-dd',$!{eLoanBillPage.loanDate})
                                </span>
                            &nbsp;
                        </td>
                        #end
                        <td height="18" colspan="2" align="center" valign="middle">
                        </td>
                        <td height="18" colspan="4" align="center" valign="middle">
                        </td>
                    </tr>

                    ##                <tr>
                    ##                    <td height="18" colspan="2" align="center" valign="middle">
                    ##                        金额&nbsp;
                    ##                    </td>
                    ##                    <td nowrap colspan="10" align="left" valign="middle" colspan="10">
                    ##                        <span id="currency1">$!{eLoanBillPage.curName}</span>
                    ##                        (大写)：<span id="payMoneyBig1">
                    ##						  <div id="moneyUp" style="width: 300px;display: inline-block;" name="moneyUp" readonly="true" data-name="moneyUp"></div>
                    ##						</span>
                    ##                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                    ##                        <input type="hidden" class="bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                    ##                               value="$!{eLoanBillPage.loanMoney}" />
                    ##                        小写：
                    ##                        <span id="payMoney1">
                    ##							￥ $!number.formatNumeric($!{eLoanBillPage.loanMoney})
                    ##						</span>
                    ##                        &nbsp;
                    ##                    </td>
                    ##                </tr>

                    <tr>
                        <td height="18" colspan="2" align="center" valign="middle">
                            金额(大写)&nbsp;
                        </td>
                        <td nowrap colspan="10" align="left" valign="middle" colspan="10">
                           <span id="payMoneyBig1">
                              <div id="moneyUp" style="width: 350px;display: inline-block;min-height: 0px;" name="moneyUp" readonly="true"
                                   data-name="moneyUp"></div>
                            </span>
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; #if(${eLoanBillPage.loanType} == "2")
                            <input type="hidden" class="bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                                   value="$!{eLoanBillPage.returnMoney}"/>
                            #else
                            <input type="hidden" class="bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                                   value="$!{eLoanBillPage.loanMoney}"/>
                            #end
                        </td>
                    </tr>

                    <tr>
                        <td height="18" colspan="2" align="center" valign="middle">
                            金额(小写)&nbsp;
                        </td>
                        <td nowrap colspan="10" align="left" valign="middle" colspan="10">
                            &nbsp;
                            <span id="currency1">$!{eLoanBillPage.curName}</span>
                            &nbsp;
                            <span id="payMoney1">
                            #if(${eLoanBillPage.loanType} == "2")
                                ￥ $!number.formatNumeric($!{eLoanBillPage.returnMoney})
                            #else
                                ￥ $!number.formatNumeric($!{eLoanBillPage.loanMoney})
                             #end
                            </span>
                            &nbsp;
                        </td>
                    </tr>

                    <tr>
                        <td colspan="5" rowspan="2" align="center" valign="middle" style="padding:1px;">

                            ##                        <img src="visa/1398044393210.png" width="95.0px" height="95.0px" />
                            <img id="imger" src="${basePath}/download/attachment?id=$!{eVisaTypePage.fileName}"
                                 width="$!{eVisaTypePage.picWidth}px" ;height="$!{eVisaTypePage.picHeight}px"/>
                            </br>
                            <font size="2">签章时间:$!date.format('yyyy-MM-dd',$!{eLoanBillPage.encryDate})
                            </font>
                        </td>
                        <td colspan="7" align="left" valign="middle">
                            电子回单编号：
                            <span id="billNo1">
                                $!{eLoanBillPage.billNo}
                            </span>
                            &nbsp;
                        </td>
                    </tr>
                    <tr class="bodytext">
                        <td colspan="7" align="left" valign="middle">
                            签章人:
                            <span id="subscriber1">
                                $!{eLoanBillPage.subscriber}
                            </span>
                            &nbsp;
                        </td>
                    </tr>
                    <tr align="left" class="bodytext">
                        <td height="21" colspan="12" valign="middle">
                            验证码:
                            <span id="validateCode1">
                                $!{eLoanBillPage.validateCode}
                            </span>
                            &nbsp;
                        </td>
                    </tr>
                    <tr align="left" class="bodytext">
                        <td height="21" colspan="12" valign="middle">
                            备注:
                            <span id="reverse51">
                                备注
                                    </span>
                            &nbsp;
                        </td>
                    </tr>
                    <tr align="left" class="bodytext">

                        <td height="21" colspan="12" valign="middle">
                            本次打印时间:
                            $!date.format('yyyy-MM-dd HH:mm:ss',$!date.getSystemTime())
                            &nbsp; 打印人:
                            $shiro.getPrincipal().username
                            &nbsp;
                        </td>
                    </tr>

                </table>
            </div>
        </div>

    </form>
</div>
<object id="LODOP_OB" classid="clsid:2105C259-1E0C-4534-8141-A753534CB4CA" width=0 height=0>
    <embed id="LODOP_EM" type="application/x-print-lodop" width=0 height=0></embed>
</object>
<br/>
<br/>
<div class="layui-form-item layui-form-submit" id="buttonDiv">
    <div>
        <button type="button" class="layui-btn" onclick="prints()">#springMessage('common.button.print')</button>
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/receipt/elecbill/eImagerPrint.js?_btv=${resourceVersion}"></script>
<script>
    bt.use(['form'],function () {
        window.onload = function () {
            var opType = $("#opType").val();
            if(opType == "1") {
                prints();
            }
        };
    });
</script>
</html>

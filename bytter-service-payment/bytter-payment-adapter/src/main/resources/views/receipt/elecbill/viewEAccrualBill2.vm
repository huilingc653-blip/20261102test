<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input type="hidden" id="fileName" value="$!{eVisaTypePage.fileName}">
    <input type="hidden" id="corpId" value="$!{eAccrualBillPage.corpId}">
    <input type="hidden" id="billNo" value="$!{eAccrualBillPage.billNo}">
    <input type="hidden" id="opType" value="$!{opType}">
    <div id="print_doc1" class="print-list">
        ##凭证头部
        <div class="print-header">
        ##记账凭证
            <div style="text-align:center;">
                <div class="print-header-name">$!{eAccrualBillPage.netName}</div>
                <div class="print-header-title">$!{eAccrualBillPage.billTypeName}</div>
            </div>
        </div>
        ##凭证内容
        <div class="print-body">
            <table style="width: 100%; " class="print-body-header">
                <tr>
                    <td width="33%">#springMessage('table.eAccrualBill.accNo')：$!{eAccrualBillPage.accNo}</td>
                    <td width="33%">#springMessage('table.eAccrualBill.accName')：$!{eAccrualBillPage.accName}</td>
                    <td width="33%">#springMessage('table.eAccrualBill.curId')：$!{eAccrualBillPage.curName}</td>
                </tr>
            </table>
            <table id="dataTable" style="width: 100%; " class="layui-table">
                <tr class="bodytext">
                    <td nowrap colspan="2" align="center" valign="middle">
                        起息日期&nbsp;
                    </td>
                    <td nowrap colspan="2" align="center" valign="middle">
                        终止日期&nbsp;
                    </td>
                    <td nowrap colspan="2" align="center" valign="middle">
                        天数&nbsp;
                    </td>
                    <td nowrap colspan="2" align="center" valign="middle">
                        积数&nbsp;
                    </td>
                    <td nowrap colspan="2" align="center" valign="middle">
                        利率&nbsp;
                    </td>
                    <td nowrap colspan="2" align="center" valign="middle">
                        利息&nbsp;
                    </td>
                </tr>
                #foreach($element in $!{dtlDTOList})
                    <tr class="bodytext">
                        <td nowrap colspan="2" align="center" valign="middle">
                                <span id="startDate1">
                                    $!date.format('yyyy-MM-dd',$!{element.interestStartDate})</span>
                            &nbsp;&nbsp;
                        </td>
                        <td nowrap colspan="2" align="center" valign="middle">
                                <span id="endDate1">
                                    $!date.format('yyyy-MM-dd',$!{element.blnInstDate})</span>
                            &nbsp;&nbsp;
                        </td>
                        <td nowrap  colspan="2" align="center" valign="middle">
                                <span id="days1">
                                    $!{element.days}</span>
                            &nbsp;&nbsp;
                        </td>
                        <td nowrap colspan="2" align="right" valign="middle">
                                <span id="cumu1">
                                    $number.formatNumeric($!{element.cumulation})</span>
                        </td>
                        <td nowrap colspan="2" align="center" valign="middle">
                                <span id="interest1">
                                    $rateTag.show($!element.interestRate)
                                </span>
                            &nbsp;&nbsp;
                        </td>
                        <td nowrap colspan="2" align="right" valign="middle">
                                <span id="accrual1">
                                    $number.formatNumeric($!{element.interest})</span>
                            &nbsp;&nbsp;
                        </td>
                    </tr>
                #end

                <tr class="bodytext">
                    <td colspan="6" align="center" valign="middle">

                        本金&nbsp;￥0.00&nbsp;
                    </td>
                    <td colspan="2" align="center" valign="middle">
                        利息总计&nbsp;
                    </td>
                    <td  colspan="2" align="right" valign="middle">
                                        <span id="accrual11">￥
                                        <b>
                                        636,525.00</span>
                        &nbsp;
                        </b>
                    </td>
                    <td colspan="4" align="right" valign="middle">
                        &nbsp;
                    </td>
                </tr>

                <tr class="bodytext">
                    <td colspan="6" align="center" valign="middle">	$!{eAccrualBillPage.money}&nbsp;</td>
                    <td  colspan="2" align="center" valign="middle">
                        利息总计&nbsp;
                    </td>
                    <td colspan="4" align="right" valign="middle">
                        <span id="accrual11">￥$!{eAccrualBillPage.nummoney}</span>
                        <input type="hidden" class="layui-input bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                               autocomplete="off" value="$!{eAccrualBillPage.nummoney}"
                               &nbsp;
                    </td>
                </tr>
                <tr>
                    <td colspan="6" align="center" valign="middle">
                                <span id="moneyStr1">
                                    本金 (大写)&nbsp;&nbsp;
                                    <div id="moneyUp" name="moneyUp" readonly="true" data-name="moneyUp" autocomplete="off" class="layui-input">
                                    </div>

                                    </span>
                    </td>
                    <td colspan="2" align="center" valign="middle">
                        利息总计(大写)&nbsp;
                    </td>
                    <td colspan="4" align="right" valign="middle">
                        <span id="accrualStr1">肆元壹角柒分</span>
                        &nbsp;
                    </td>
                </tr>

                <tr class="bodytext">
                    <td  colspan="8" align="center" valign="middle">
                        <span id="rmk1">$!{eAccrualBillPage.rmk}</span>
                        &nbsp;&nbsp;
                    </td>
                    <td colspan="1" align="center" valign="middle">会<br>计<br>分<br>录</td>
                    <td  colspan="3" align="left" valign="middle">
                        <span id="homeSubject1">$!{eAccrualBillPage.homeSubject}</span>
                        <br>
                        <br>
                        #springMessage('table.eAccrualBill.otherSubject')：
                        <span id="otherSubject1">$!{eAccrualBillPage.otherSubject}</span>
                        &nbsp;
                    </td>

                    <span id="voucherNo1" style="display :none">$!{eAccrualBillPage.voucherNo}</span>
                    <span id="checker1" style="display :none">$!{eAccrualBillPage.checkerCode}</span>
                </tr>

                <tr class="bodytext">
                    <td colspan="5" rowspan="2" align="center" valign="middle">
                        <table border="0" cellspacing="0" cellpadding="0" width='106'>
                            <tr>
                                <td nowrap align="center" valign="bottom" >
                                            <span id="encryImg1">
                                                <img id="imger" src="${basePath}/download/attachment?id=$!{eVisaTypePage.fileName}" width="$!{eVisaTypePage.picWidth}px";height="$!{eVisaTypePage.picHeight}px"/>
                                            </span>
                                </td>
                            </tr>
                            <TR sytle="margin-top: -15px;"><td nowrap align="center"><font size="2">签章时间:
                                <span id="encryDate1">
                                    $!date.format('yyyy-MM-dd',$!{eAccrualBillPage.encryDate})</span></font></td></TR>
                        </table>
                    </td>
                    <td  colspan="7" align="left" valign="middle">
                        #springMessage('table.eAccrualBill.billNo')：
                        <span id="billNo1">$!{eAccrualBillPage.billNo} </span>
                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td  colspan="7" align="left" valign="middle">
                        签章人：
                        <span id="subscriber1">
                            $!{eAccrualBillPage.subscriber}</span>
                        &nbsp;
                    </td>
                </tr>
                <tr align="left" class="bodytext">
                    <td  colspan="12" valign="middle">
                        验证码：
                        <span id="validateCode1">
                            $!{eAccrualBillPage.validateCode}</span>
                        &nbsp;
                    </td>
                </tr>
                <tr align="left" class="bodytext">
                    <td  colspan="12" valign="middle">
                        本次打印时间：
                        <span id="printdate1">
                            $!date.format('yyyy-MM-dd HH:mm:ss',$!date.getSystemTime())</span>
                        &nbsp; 打印人：
                        <span id="username1">
                            $shiro.getPrincipal().username</span>
                        &nbsp;
                    </td>
                </tr>
            </table>
        </div>
    </div>
</form>
<object  id="LODOP_OB" classid="clsid:2105C259-1E0C-4534-8141-A753534CB4CA" width=0 height=0>
    <embed id="LODOP_EM" type="application/x-print-lodop" width=0 height=0></embed>
</object>
<br />
<br />
<div class="layui-form-item layui-form-submit" id="buttonDiv">
    <div>
        <button type="button" class="layui-btn" onclick="prints()">#springMessage('common.button.print')</button>
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/receipt/elecbill/eImagerPrint.js?_btv=${resourceVersion}"></script>
<script>
    bt.use(['form'],function () {
        window.onload = function () {
            var opType = $("#opType").val();
            if(opType == "1") {
                prints();
            }
        };
    });
</script>
</html>

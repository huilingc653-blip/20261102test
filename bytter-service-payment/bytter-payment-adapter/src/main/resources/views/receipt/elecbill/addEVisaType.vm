<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			
<table class="layui-table">
	<tbody>
		<tr>
			##网点
			<td class="textRight">#springMessage('table.eVisaType.netId')</td>
			<td width="35%">
				<div class="layui-inline">
					<div class="bt-biz-corp"
						 data-biz-type="net"
						 data-type="selectTree"
						 data-name="netId"
						 data-resource="netbank:receipt:evisaType:op"
						 data-scope="net" data-required="true"></div>
				</div>
			</td>
			##回单类型
			<td class="textRight">#springMessage('table.eVisaType.billType')</td>
			<td width="40%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-biz-name="billType" data-url="${basePath}/receipt/eReceiptType/json"
                         data-valuefield="billType" data-textfield="billName" data-required="true"
                         data-name="billType" data-search="true"></div>
                </div>
			</td>
		</tr>
		<tr>
			##回单类型名称 
			<td class="textRight">#springMessage('table.eVisaType.billName')</td>
			<td width="35%">
			<div class="layui-input-inline">
				<input type="text" id="billName"  lay-verify="required|strlength" name="billName" autocomplete="off"
						data-maxlength="40" class="layui-input" >
			</div>
			</td>
			##状态
			<td class="textRight">#springMessage('table.eVisaType.validSign')</td>
			<td width="40%">
##				$dictTag.get("eVisaType.validSign",1)
				<div class="bt-biz-dict" data-type="select" data-group="eVisaType.validSign"
					 data-name="validSign" data-defaultvalue="1"></div>
			</td>
		</tr>
		<tr>
		##高度 
			<td class="textRight">#springMessage('table.eVisaType.picHeight')</td>
			<td width="40%">
				<div class="layui-input-inline">
					<input type="text" id="picHeight" lay-verify="required" name="picHeight"
						autocomplete="off" class="layui-input" value="90"
						placeholder="#springMessage('table.eVisaType.picHeight')">
				</div>
			</td>
			##宽度 
			<td class="textRight">#springMessage('table.eVisaType.picWidth')</td>
			<td width="35%">
			<div class="layui-input-inline">
				<input type="text" id="picWidth" lay-verify="required" name="picWidth" autocomplete="off"
						class="layui-input" value="120"
						placeholder="#springMessage('table.eVisaType.picWidth')">
			</div>
			</td>
			
		</tr>
		<tr>
		
			##签章图片
			<td class="textRight">#springMessage('table.eVisaType.fileName')</td>
			<td id="updiv" colspan="3">
				<img id="imger"/>
				<input type="file" lay-ext="jpg|png|gif" name="file" class="layui-upload-file">
				<input type="hidden" id="fileName" name="fileName">
				<input type="hidden" id="dir" name="dir">
				<font color=red>#springMessage('netbank.input.img.desc')</font>
			</td>
		</tr>
		
		<tr>
			<td colspan="4" style="text-align: center;">
				<button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
                   <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</td>
			</tr>
	</tbody>
</table>
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/receipt/elecbill/eVisaType.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head> 
<body>
	<form class="layui-form layui-form-pane">
	
	<table class="layui-table">
			<tbody>
			<tr>
	       		##网点
				<td class="textRight">#springMessage('table.eVisaType.netId')</td>
				<td width="35%">
					$!{eVisaTypePage.netName}
				</td>
				##回单类型
				<td class="textRight">#springMessage('table.eVisaType.billType')</td>
				<td width="35%">$!{eVisaTypePage.billTypeName}</td>
       		</tr>
       		<tr>
				##回单类型名称
				<td class="textRight">#springMessage('table.eVisaType.billName')</td>
				<td width="35%">$!{eVisaTypePage.billName}</td>
				##状态
				<td class="textRight">#springMessage('table.eVisaType.validSign')</td>
				<td width="35%">$!{eVisaTypePage.validSignName}</td>
       		</tr>
       		<tr>
	       		##宽度
				<td class="textRight">#springMessage('table.eVisaType.picWidth')</td>
				<td width="35%">$!{eVisaTypePage.picWidth}</td>
				##高度
				<td class="textRight">#springMessage('table.eVisaType.picHeight')</td>
				<td width="35%">$!{eVisaTypePage.picHeight}</td>				
       		</tr>
       		<tr>
	       		##签章图片名称
				<td class="textRight">#springMessage('table.eVisaType.fileName')</td>
				<td width="35%" colspan="3">
				<img id="imger" src="${basePath}/download/attachment?id=$!{eVisaTypePage.fileName}" width="$!{eVisaTypePage.picWidth}px";height="$!{eVisaTypePage.picHeight}px"/> 
				</td>		
       		</tr>
       		
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
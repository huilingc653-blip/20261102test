<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>

<form id="searchForm" class="layui-form">
##    <input type="hidden"  name="type" id="type" value="list"/>
    <table class="layui-table">
        <tbody>
        <tr>
		##单位
            <td class="textRight">#springMessage('sys.user.corpContain.show')</td>
			<td width="40%">
##				<div class="layui-inline">
##					<div class="bt-biz-corp" data-biz-type="corp" data-tree-type="check" data-required="true"
##						 data-type="selectTree" data-name="corpIds" data-checkkboxtype='{ "Y": "s", "N": "s" }'
##                         data-callback="corpChange"
##						 data-scope="all"></div>
##				</div>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-required="true"
                         data-biz-type="corp"
                         data-tree-type="check"
                         data-type="selectTree"
                         data-name="corpIds"
                         data-biz-name="corpIds"
                         data-callback="corpChange"
                         data-group="corpGroup"
                         data-resource="netbank:receipt:eleBill:query"
                         data-checkkboxtype='{ "Y": "s", "N": "s" }'
                         data-scope="all"></div>
                </div>
			</td>
		##打印状态
            <td class="textRight">#springMessage('table.print.status')</td>
            <td width="40%">
##                <div class="layui-inline">
##                    <input type="radio" lay-filter="printSign" name="printSign" value="" title="#springMessage('common.placeholder.all')" checked="checked">
##                    #foreach($dict in $dictTag.list("eleBill.print.sign"))
##                        <input type="radio" lay-filter="printSign" name="printSign" value="$dict.code" title="$dict.name" #if("N" == $dict.code)checked#end>
##                    #end
##                </div>
                <div class="layui-inline">
                <div class="bt-biz-dict" data-type="radio"
                     data-group="eleBill.print.sign" data-name="printSign"></div>
                </div>
            </td>
        </tr>
        <tr>
		##电子回单类型
            <td class="textRight">#springMessage('table.eLoanBill.billType')</td>
			<td >
                <div class="layui-input-inline">
##                    <div type="list" field="billType" fieldHref="${basePath}/receipt/eReceiptType/json" dictField="billType" dictText="billName"></div>
##                    <div class="layui-inline" style="width: ">
                        <select lay-filter="billType" name="billType" id="billType" style="width: auto"  lay-verify="required" >
                            <option value="">#springMessage("common.placeholder.select")</option>
                        </select>
##                    </div>
                </div>
			</td>

		##回单状态
            <td class="textRight">#springMessage('table.eVisaType.status')</td>
            <td >
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-defaultvalue="1"
                         data-group="eleBill.validSign" data-name="status"></div>
##                    <select lay-filter="status" lay-verify="required" name="status" >
##                        <option value="">#springMessage("common.placeholder.select")</option>
##                        #foreach($dict in $dictTag.list("eleBill.validSign"))
##                            <option value="$dict.code" #if("1" == $dict.code)selected#end>$dict.name</option>
##                        #end
##                    </select>
                </div>
            </td>
        </tr>
        <tr>
		##凭证流水号
            <td class="textRight">#springMessage('table.bvPrintVouOpinfo.vouNo')</td>
            <td >
                <div class="layui-inline">
                <input type="text" name="beginVouNo"
                       autocomplete="off" class="layui-input">
                </div>&nbsp;~ &nbsp;
                <div class="layui-inline">
                <input type="text" name="endVouNo"
                       autocomplete="off" class="layui-input">
                </div>
            </td>
        ##记账日期
            <td class="textRight">#springMessage('table.eConsignBill.tallyDate')</td>
            <td >
                <input type="text" name="beginDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="t2">
                <span class="date-mid">~</span>
                <input type="text" name="endDate" class="layui-input bt-input-inline bt-biz-dateType" id="t2">
            </td>
        </tr>
        <tr>
        ##金额
            <td class="textRight" id="moneyTd1">#springMessage('table.fcUnionAccbook.sendMoney')</td>
            <td id="moneyTd2">
                <div class="layui-inline">
                    <input type="text" name="beginMoney" class="layui-input bt-input-inline  bt-biz-moneyType" data-moneyendid="t5" >
                    <span class="date-mid">~</span>
                    <input type="text" name="endMoney" class="layui-input bt-input-inline  bt-biz-moneyType" id="t5" >
                </div>
            </td>
            <td class="textRight depositType" style="display: none">#springMessage("table.eTransBill.depositType")</td>
            <td class="depositType" width="35%" style="display: none">
                <div class=layui-inline>
                    <div class=bt-biz-selectType
                         data-name="depositRateType"
                         data-textField="name"
                         data-valueField="id"
                         data-biz-name="depositRateType"
                         data-url="${basePath}/receipt/eleBillQuery/rateTypeList"
                         data-inputvalue="true"
                         data-search="true"
                         data-method ="get"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" value="T"  lay-filter="submit">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<div id="tagBillQuery">

</div>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/receipt/elecbill/eleBillQuery.list.js?_btv=${resourceVersion}"></script>
</html>

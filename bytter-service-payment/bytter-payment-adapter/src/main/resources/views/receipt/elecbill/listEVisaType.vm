<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
	<form id="searchForm" class="layui-form">
	
	
	<table class="layui-table">
	<tbody>
		<tr>
		##网点
			<td class="textRight">#springMessage('table.eVisaType.netId')</td>
			<td width="20%">
				<div class="layui-inline">
					<div class="bt-biz-corp"
						 data-biz-type="net"
						 data-type="selectTree"
						 data-name="ins_netId"
                         data-tree-type="check"
						 data-resource="netbank:receipt:evisaType:op"
						 data-scope="net"></div>
				</div>
			</td>
			##回单类型
			<td class="textRight">#springMessage('table.eVisaType.billType')</td>
			<td width="20%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="mulselect" data-biz-name="billType"
						 data-name="ins_billType" data-group="eVisaType.billType"></div>
                </div>
			</td>
			##状态
			<td class="textRight">#springMessage('table.eVisaType.validSign')</td>
			<td width="20%">
				<div class="layui-input-inline">
					<div class="bt-biz-dict" data-type="select"
							data-group="eVisaType.validSign" data-name="eqs_validSign"></div>
				</div>
			</td>
		</tr>
		<tr>
            <td colspan="6" style="text-align: center;">
				<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
	</tbody>
</table>
</form>

	<table id="appTable" class="layui-table layui-form"
		style="width: 100%;">
		<thead>
			<tr>
				<th>#springMessage('table.eVisaType.netId')</th>
				<th>#springMessage('table.eVisaType.billType')</th>
				<th>#springMessage('table.eVisaType.billName')</th>
				<th>#springMessage('table.eVisaType.picWidth')</th>
				<th>#springMessage('table.eVisaType.picHeight')</th>
				<th>#springMessage('table.eVisaType.validSign')</th>
				<th>#springMessage('common.table.thead.operation')</th>
			</tr>
		</thead>
	</table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/receipt/elecbill/eVisaType.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input type="hidden" id="fileName" value="$!{eVisaTypePage.fileName}">
    <input type="hidden" id="corpId" value="$!{ePrecativeLoanBillPage.corpId}">
    <input type="hidden" id="billNo" value="$!{ePrecativeLoanBillPage.billNo}">
    <input type="hidden" id="opType" value="$!{opType}">
    <div id="print_doc1" class="print-list">
        ##凭证头部
        <div class="print-header">
            ##记账凭证
            <div style="text-align:center;">
                <div class="print-header-name">$!{ePrecativeLoanBillPage.netName}</div>
                <div class="print-header-title">$!{ePrecativeLoanBillPage.billTypeName}</div>
            </div>
        </div>
        ##凭证内容
        <div class="print-body">
            <table style="width: 100%; " class="print-body-header">
                <tr>
                    ##记账日期
                    <td width="33%">记账日期：$!date.format('yyyy-MM-dd',$!{ePrecativeLoanBillPage.tallyDate})</td>
                    ##起息日期
                    <td width="33%">起息日期：$!date.format('yyyy-MM-dd',$!{ePrecativeLoanBillPage.accrualDate})</td>
                    ##凭证号
                    <td width="33%">凭证号：$!{ePrecativeLoanBillPage.voucherNo}</td>
                </tr>
            </table>
            <table id="dataTable" style="width: 100%; " class="layui-table">
                <tr class="bodytext">
                    <td nowrap width="3%" rowspan="2" align="center" valign="middle">
                        委
                        <br>
                        托
                        <br>
                        方
                    </td>
                    <td nowrap colspan="1" valign="middle" align="right" width="6%">
                        委托人：&nbsp;
                    </td>
                    <td nowrap colspan="4" width="27%" align="left" valign="middle" nowrap>
                        <span id="payeeName1">
                            $!{ePrecativeLoanBillPage.precativeCorp}</span>
                        &nbsp;
                    </td>
                    <td nowrap width="3%" rowspan="2" align="center" valign="middle">
                        借
                        <br>
                        款
                        <br>
                        方
                    </td>
                    <td nowrap colspan="1" width="6%" align="right" valign="middle">
                        借款人：&nbsp;
                    </td>
                    <td nowrap colspan="4" width="27%" align="left" valign="middle" nowrap>
                        <span id="payerName1">
                            $!{ePrecativeLoanBillPage.loanCorp}</span>
                        &nbsp;
                    </td>
                </tr>

                <tr class="bodytext">
                    <td nowrap colspan="1" valign="middle" align="right">
                        账&nbsp;&nbsp;号：&nbsp;
                    </td>
                    <td nowrap colspan="4" align="left" valign="middle">
                        <span id="payeeAcc1">
                            $!{ePrecativeLoanBillPage.precativeAcc}</span>
                        &nbsp;
                    </td>
                    <td nowrap colspan="1" align="right" valign="middle">
                        账&nbsp;&nbsp;号：&nbsp;
                    </td>
                    <td nowrap colspan="4" align="left" valign="middle">
                        <span id="payerAcc1">
                            $!{ePrecativeLoanBillPage.loanAcc}</span>
                        &nbsp;
                    </td>
                </tr>
                ##               <tr class="bodytext">
                ##                    <td nowrap height="18" colspan="2" align="right" valign="middle">
                ##                        金额：&nbsp;
                ##                    </td>
                ##                    <td nowrap colspan="10" align="left" valign="middle" colspan="10">
                ##                        <span id="currency1">$!{ePrecativeLoanBillPage.curName}</span>
                ##                        (大写)：<span id="payMoneyBig1">
                ##						  <div id="moneyUp" style="width: 300px;display: inline-block;" name="moneyUp" readonly="true" data-name="moneyUp"></div>
                ##						</span>
                ##                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                ##                        <input type="hidden" class="bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                ##                               value="$!{ePrecativeLoanBillPage.loanMoney}" />
                ##                        小写：
                ##                        <span id="payMoney1">
                ##							￥$!number.formatNumeric($!{ePrecativeLoanBillPage.loanMoney})
                ##						</span>
                ##                        &nbsp;
                ##                    </td>
                ##
                ##                </tr>

                <tr class="bodytext">
                    <td nowrap height="18" colspan="2" align="right" valign="middle">
                        金额(大写)：&nbsp;
                    </td>
                    <td nowrap colspan="10" align="left" valign="middle" colspan="10">
                          <span id="payMoneyBig1">
                              <div id="moneyUp" style="width: 350px;display: inline-block;min-height: 0px;"
                                   name="moneyUp" readonly="true"
                                   data-name="moneyUp"></div>
                            </span>
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        <input type="hidden" class="bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                               value="$!{ePrecativeLoanBillPage.loanMoney}"/>
                    </td>
                </tr>

                <tr class="bodytext">
                    <td nowrap height="18" colspan="2" align="right" valign="middle">
                        金额 (小写)：&nbsp;
                    </td>
                    <td nowrap colspan="10" align="left" valign="middle" colspan="10">
                        &nbsp;
                        <span id="currency1">$!{ePrecativeLoanBillPage.curName}</span>
                        &nbsp;
                        <span id="payMoney1">
                                ￥$!number.formatNumeric($!{ePrecativeLoanBillPage.loanMoney})
                            </span>
                        &nbsp;
                    </td>

                </tr>

                <tr class="bodytext">
                    <td nowrap colspan="2" align="right" valign="middle">
                        受托人：&nbsp;
                    </td>
                    <td nowrap colspan="2" align="left" valign="middle">
                        <span id="payType1">
                            $!{ePrecativeLoanBillPage.corpName}</span>
                        &nbsp;&nbsp;
                    </td>
                    <td nowrap colspan="2" align="right" valign="middle">
                        合同号：&nbsp;
                    </td>
                    <td nowrap colspan="2" align="center" valign="middle">
                        <span id="contractCode1">
                            $!{ePrecativeLoanBillPage.contractCode}
                        </span>

                    <td nowrap colspan="2" align="right" valign="middle">
                        利率：&nbsp;
                    </td>
                    <td nowrap colspan="2" align="right" valign="middle">
                        <span id="loanRate1">
                            $rateTag.show($!ePrecativeLoanBillPage.loanRate)
                        </span>
                        &nbsp;&nbsp;
                    </td>

                </tr>
                <tr class="bodytext">
                    <td nowrap colspan="2" align="right" valign="middle">
                        贷款日期：
                    </td>
                    <td nowrap colspan="4" align="center" valign="middle">
                        <span id="loanDate1">
                            $!date.format('yyyy-MM-dd',$!{ePrecativeLoanBillPage.loanDate})
                        </span>
                    </td>

                    <td nowrap colspan="6" rowspan="2" align="left" valign="top">
                        #if($!{ePrecativeLoanBillPage.debitAcc} && $ePrecativeLoanBillPage.debitAcc)
                            #set($debitAcc = $ePrecativeLoanBillPage.debitAcc.split(";"))
                            #set($creditAcc = $ePrecativeLoanBillPage.creditAcc.split(";"))
                            #set($debit = $debitAcc[0])
                            &nbsp;借: $debit
                            <br>
                            #set($credit = $creditAcc[0])
                            &nbsp;&nbsp;&nbsp;&nbsp;贷: $credit
                            <br>
                            #set($debit = $debitAcc[1])
                            &nbsp;借: $debit
                            <br>
                            #set($credit = $creditAcc[1])
                            &nbsp;&nbsp;&nbsp;&nbsp;贷: $credit
                            <br>
                            ##					    #if($debitAcc[2])
                            ##                            #set($debitInterest = $debitAcc[2])
                            ##                            &nbsp;借: $debitInterest
                            ##                            <br>
                            ##                        #end
                            ##                        #if($creditAcc[2])
                            ##                            #set($creditInterest = $creditAcc[2])
                            ##                            &nbsp;贷: $creditInterest
                            ##                        #end
                            ##                        &nbsp;

                        #end
                        <p></p>
                        <p style=" margin:0px;">
                            记账 ：
                            <span id="tallyName1">
                                $!{ePrecativeLoanBillPage.tallyerCode}</span>
                            &nbsp;&nbsp;复核：
                            <span id="checkers1">
                                $!{ePrecativeLoanBillPage.checkerCode}</span>
                            &nbsp;&nbsp;主管：
                            <span id="supervisor">
                                $!{ePrecativeLoanBillPage.dayOverOperatorUsername}</span>
                        </p>
                    </td>

                </tr>
                <tr class="bodytext">
                    <td nowrap colspan="2" align="right" valign="middle">
                        到期日期：
                    </td>
                    <td nowrap colspan="4" align="center" valign="middle">
                        <span id="deadline_date1">
                            $!date.format('yyyy-MM-dd',$!{ePrecativeLoanBillPage.deadlineDate})
                        </span>
                    </td>
                </tr>

                <tr>
                    <td nowrap colspan="5" rowspan="3" align="center" valign="middle">
                        <table border="0" cellspacing="0" cellpadding="0" width='106'>
                            <tr>
                                <td nowrap valign="bottom" align="center">
                                    <br/>
                                    <div style="font-size:12px;">
                                            <span id="encryImg1">
                                                <img id="imger"
                                                     src="${basePath}/download/attachment?id=$!{eVisaTypePage.fileName}"
                                                     width="$!{eVisaTypePage.picWidth}px"
                                                     ;height="$!{eVisaTypePage.picHeight}px"/>
                                             </span>
                                    </div>
                                </td>
                            </tr>
                            <TR>
                                <td nowrap align="center" valign="top"><br/><font size="2">签章时间:
                                    <span id="encryDate1">
                                        $!date.format(
                                            'yyyy-MM-dd',$!{ePrecativeLoanBillPage.encryDate})</span></font><br/>
                                </td>
                            </TR>
                        </table>
                    </td>
                    <td nowrap colspan="7" align="left" valign="middle">
                        电子回单编号：
                        <span id="billNo1">$!{ePrecativeLoanBillPage.billNo}</span>

                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td nowrap colspan="7" align="left" valign="middle">
                        验证码：
                        <span id="validateCode1">$!{ePrecativeLoanBillPage.validateCode}
                        </span>
                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td nowrap colspan="7" align="left" valign="middle">
                        签章人：
                        <span id="subscriber1">$!{ePrecativeLoanBillPage.subscriber}</span>
                        &nbsp;
                    </td>
                </tr>
                <tr align="left" class="bodytext">
                    <td nowrap colspan="12" valign="middle">
                        本次打印时间：
                        <span id="printdate1">
                            $!date.format('yyyy-MM-dd HH:mm:ss',$!date.getSystemTime())</span>
                        &nbsp; 打印人：
                        <span id="username1">
                            $shiro.getPrincipal().username</span>
                        &nbsp;
                    </td>
                </tr>


            </table>
        </div>
    </div>
</form>
<object id="LODOP_OB" classid="clsid:2105C259-1E0C-4534-8141-A753534CB4CA" width=0 height=0>
    <embed id="LODOP_EM" type="application/x-print-lodop" width=0 height=0></embed>
</object>
<br/>
<br/>
<div class="layui-form-item layui-form-submit" id="buttonDiv">
    <div>
        <button type="button" class="layui-btn" onclick="prints()">#springMessage('common.button.print')</button>
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/receipt/elecbill/eImagerPrint.js?_btv=${resourceVersion}"></script>
<script>
    bt.use(['form'], function () {
        window.onload = function () {
            var opType = $("#opType").val();
            if (opType == "1") {
                prints();
            }
        };
    });
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div id="print_doc1">
    <form class="layui-form layui-form-pane">
        <input type="hidden" id="fileName" value="$!{eVisaTypePage.fileName}">
        <input type="hidden" id="corpId" value="$!{eNoticeBillPage.corpId}">
        <input type="hidden" id="billNo" value="$!{eNoticeBillPage.billNo}">
        <input type="hidden" id="opType" value="$!{opType}">
        <div class="print-list">
        ##凭证头部
        <div class="print-header">
        ##记账凭证
            <div style="text-align:center;">
                <div class="print-header-name">$!{eNoticeBillPage.netName}</div>
                <div class="print-header-title">$!{eNoticeBillPage.billTypeName}</div>
            </div>
        </div>
        ##凭证内容
        <div class="print-body">
            <table style="width: 100%; " class="print-body-header">
                <tr>
                    ##记账日期
                    <td width="33%">记账日期：$!date.format('yyyy-MM-dd',$!{eNoticeBillPage.tallyDate})</td>
                    ##起息日期
                    <td width="33%">起息日期：$!date.format('yyyy-MM-dd',$!{eNoticeBillPage.accrualDate})</td>
                    ##凭证号
                    <td width="33%">凭证号：$!{eNoticeBillPage.voucherNo}</td>
                </tr>
            </table>
            <table id="dataTable" style="width: 100%; " class="layui-table breakRow">
                <tr>
                    <td width="8%" rowspan="3" align="center" valign="middle">收<br/>款<br/>单<br/>位</td>
                    <td colspan="1" width="10%" valign="middle" align="right">
                        全&nbsp;&nbsp;称：
                    </td>
                    <td colspan="4" width="32%" align="left" valign="middle">
                            <span id="payeeName1">
                                $!{eNoticeBillPage.payeeName}
                            </span>
                        &nbsp;
                    </td>
                    <td width="8%" rowspan="3" align="center" valign="middle">付<br/>款<br/>单<br/>位</td>
                    <td colspan="1" width="80pt" align="right" valign="middle">
                        全&nbsp;&nbsp;称：
                    </td>
                    <td colspan="4" width="250pt" align="left" valign="middle">
                            <span id="payerName1">
                                $!{eNoticeBillPage.payerName}
                            </span>
                    </td>
                </tr>
                <tr>
                    <td height="18" colspan="1" valign="middle" align="right">
                        账&nbsp;&nbsp;号：
                    </td>
                    <td colspan="4" align="left" valign="middle">
                            <span id="payeeAcc1">
                                $!{eNoticeBillPage.payeeAcc}
                            </span>
                    </td>
                    <td colspan="1" align="right" valign="middle">
                        账&nbsp;&nbsp;号：
                    </td>
                    <td nowrap colspan="4" align="left" valign="middle">
                            <span id="payerAcc1">
                                $!{eNoticeBillPage.payerAcc}
                            </span>
                    </td>
                </tr>
                <tr>
                    <td nowrap height="18" colspan="1" align="right" valign="middle">
                        开户行：
                    </td>
                    <td colspan="4" align="left" valign="middle">
                            <span id="payeeBank1">
                                $!{eNoticeBillPage.payeeBank}
                            </span>
                    </td>
                    <td nowrap colspan="1" align="right" valign="middle">
                        开户行：
                    </td>
                    <td colspan="4" align="left" valign="middle">
                            <span id="payerBank1">
                                $!{eNoticeBillPage.payerBank}
                            </span>
                    </td>
                </tr>

                ##            <tr class="bodytext">
                ##                <td nowrap height="18" colspan="2" align="right" valign="middle">
                ##                    金额：&nbsp;
                ##                </td>
                ##                <td nowrap colspan="10" align="left" valign="middle" colspan="10">
                ##                    <span id="currency1">$!{eNoticeBillPage.curName}</span>
                ##                    (大写)：<span id="payMoneyBig1">
                ##            						  <div id="moneyUp" style="width: 300px;display: inline-block;" name="moneyUp"
                ##                                           readonly="true"
                ##                                           data-name="moneyUp"></div>
                ##            						</span>
                ##                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                ##                    <input type="hidden" class="bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                ##                           value="$!{eNoticeBillPage.payMoney}"/>
                ##                    小写：
                ##                    <span id="payMoney1">
                ##            							￥$!number.formatNumeric($!{eNoticeBillPage.payMoney})
                ##            						</span>
                ##                    &nbsp;
                ##                </td>
                ##            </tr>

                <tr class="bodytext">
                    <td nowrap colspan="2" align="right" valign="middle">
                        金额 (大写)：
                    </td>
                    <td nowrap colspan="10" align="left" valign="middle">
                        <span id="payMoneyBig1">
                            <div id="moneyUp" style="width: 350px;display: inline-block;min-height: 0px;" name="moneyUp" readonly="true" data-name="moneyUp"></div>
                        </span>
                        <input type="hidden" class="bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                               value="$!{eNoticeBillPage.payMoney}"/>
                    </td>
                </tr>

                <tr class="bodytext">
                    <td nowrap height="18" colspan="2" align="right" valign="middle">
                        金额 (小写)：
                    </td>
                    <td nowrap colspan="10" align="left" valign="middle">
                        &nbsp;
                        <span id="currency1">$!{eNoticeBillPage.curName}</span>
                        &nbsp;
                        <span id="payMoney1">￥$!number.formatNumeric($!{eNoticeBillPage.payMoney})</span>

                    </td>
                </tr>

                <tr class="bodytext">
                    <td nowrap height="18" colspan="2" align="right" valign="middle">
                        原凭证号码：
                    </td>
                    <td nowrap height="18" colspan="4" align="left" valign="middle">
                            <span id="oldVoucherNo1">
                                $!{eNoticeBillPage.oldVoucher}
                            </span>
                    </td>
                    <td nowrap height="18" colspan="2" align="right" valign="middle">
                        原凭证金额：
                    </td>
                    <td nowrap height="18" align="left" colspan="5" valign="middle">
                            <span id="oldVoucherMoney1">
                                $!number.formatNumeric($!{eNoticeBillPage.oldVoucherMoney})
                            </span>
                    </td>
                </tr>

                <tr class="bodytext">
                    <td nowrap colspan="2" align="right" valign="middle">
                        结算方式：
                    </td>
                    <td nowrap colspan="4" align="left" valign="middle">
                            <span id="payType1" style="color: #ff0000;">
                                $!{eNoticeBillPage.payTypeName}
                            </span>
                    </td>
                    <td nowrap colspan="6" rowspan="3" height="90" align="left" valign="top">
                        <p style="height:5px; margin:1px;">
                            借：
                            <span id="debitacc1">
                                $!{eNoticeBillPage.debit}
                            </span>
                        </p>
                        <br/>
                        <p style="height:5px; margin:1px;">
                            贷：
                            <span id="creditacc1">
                                $!{eNoticeBillPage.credit}
                            </span>
                        </p>
                        <br/>
                        <p></p>
                        <p style="height:5px; margin:1px;">
                            记账 ：
                            <span id="tallyName1">
                                $!{eNoticeBillPage.tallierName}
                            </span>
                            &nbsp;&nbsp;
                            复核：
                            <span id="checkers1">
                                $!{eNoticeBillPage.checkerName}
                            </span>
                            &nbsp;&nbsp;
                            主管：
                            <span id="supervisor">
                                #*$!{eNoticeBillPage.dayOverOperatorUsername}*#
                            </span>
                        </p>
                    </td>
                </tr>
                <tr>
                    <td nowrap colspan="2" align="right" valign="middle">
                        备注：
                    </td>
                    <td nowrap colspan="4" align="left" valign="middle">
                            <span id="remark1">
                                $!{eNoticeBillPage.purpose}
                            </span>
                    </td>
                </tr>
                <tr class="bodytext">
                    <td nowrap colspan="2" align="right" valign="middle">
                        用途：
                    </td>
                    <td colspan="4" align="left" valign="middle" style="word-break:break-all">
                            <span id="purpose1">
                                $!{eNoticeBillPage.purpose}
                            </span>
                    </td>
                </tr>

                <tr>
                    <td nowrap colspan="5" rowspan="2" align="center" valign="middle"
                        height="100">
                        <table border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td nowrap valign="bottom" align="center">
                                            <span id="encryImg1">
                                           <img id="imger"
                                                src="${basePath}/download/attachment?id=$!{eVisaTypePage.fileName}"
                                                width="$!{eVisaTypePage.picWidth}px"
                                                ;height="$!{eVisaTypePage.picHeight}px"/>
                                            </span>
                                </td>
                            </tr>
                            <TR>
                                <td nowrap align="center" valign="top"><font size="2">签章时间:
                                    <span id="encryDate1">
                                        $!date.format('yyyy-MM-dd',$!{eNoticeBillPage.encryDate})
                                    </span>
                                </font></td>
                            </TR>
                        </table>
                    </td>
                    <td nowrap colspan="7" align="left" valign="middle">
                        电子回单编号：
                        <span id="billNo1">
                            $!{eNoticeBillPage.billNo}
                        </span>

                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td nowrap colspan="7" align="left" valign="middle">
                        签章人：
                        <span id="subscriber1">
                            $!{eNoticeBillPage.subscriber}
                        </span>
                        &nbsp;
                    </td>
                </tr>
                <tr align="left">
                    <td style="word-break:break-all" colspan="12" align="left" valign="middle">
                        验证码：
                        <span id="validateCode1">
                            $!{eNoticeBillPage.validateCode}
                        </span>
                        &nbsp;
                    </td>
                </tr>
                <tr align="left">

                    <td nowrap height="18" colspan="12" valign="middle">
                        本次打印时间：
                        <span id="printTime1">
                            $!date.format('yyyy-MM-dd HH:mm:ss',$!date.getSystemTime())
                        </span>
                        &nbsp; 打印人：
                        <span id="userName1">
                            $shiro.getPrincipal().username
                        </span>
                        &nbsp;
                    </td>
                </tr>
            </table>
        </div>
        </div>
    </form>
</div>
<object id="LODOP_OB" classid="clsid:2105C259-1E0C-4534-8141-A753534CB4CA" width=0 height=0>
    <embed id="LODOP_EM" type="application/x-print-lodop" width=0 height=0></embed>
</object>
<br/>
<br/>
<div class="layui-form-item layui-form-submit" id="buttonDiv">
    <div>
        <button type="button" class="layui-btn" onclick="prints()">#springMessage('common.button.print')</button>
        ##            <button class="layui-btn bt-biz-printType" data-printareaid="print_doc1">打印</button>
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/receipt/elecbill/eImagerPrint.js?_btv=${resourceVersion}"></script>
<script>
    bt.use(['form'],function () {
        window.onload = function () {
            var opType = $("#opType").val();
            if(opType == "1") {
                prints();
            }
        };
    });
</script>
</html>

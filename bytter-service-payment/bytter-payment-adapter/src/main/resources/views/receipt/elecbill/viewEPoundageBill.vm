<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div id="print_doc1" class="print-list">
    <form class="layui-form layui-form-pane">
        <input type="hidden" id="fileName" value="$!{eVisaTypePage.fileName}">
        <input type="hidden" id="corpId" value="$!{ePoundageBillPage.corpId}">
        <input type="hidden" id="billNo" value="$!{ePoundageBillPage.billNo}">
        <input type="hidden" id="opType" value="$!{opType}">
        ##凭证头部
        <div class="print-header">
        ##记账凭证
            <div style="text-align:center;">
                <div class="print-header-name">$!{ePoundageBillPage.netName}</div>
                <div class="print-header-title">$!{ePoundageBillPage.billTypeName}</div>
            </div>
        </div>
        ##凭证内容
        <div class="print-body">
            <table style="width: 100%; " class="print-body-header">
                <tr>
                    ##记账日期
                    <td width="50%">记账日期：$!date.format('yyyy-MM-dd',$!{ePoundageBillPage.tallyDate})</td>
                    ##凭证号
                    <td width="50%">凭证号：$!{ePoundageBillPage.voucherNo}</td>
                </tr>
            </table>
            <table id="dataTable" style="width: 100%; " class="layui-table">
                <tr class="bodytext">
                    <td width="19" rowspan="3" align="center" valign="middle">
                        收款单位
                    </td>
                    <td height="24" colspan="1" align="center" valign="middle">
                        全&nbsp;&nbsp;称&nbsp;
                    </td>
                    <td colspan="4" align="left" valign="middle">
                        <font size="2">
                                    <SPAN id="payeeName1">
                                        $!{ePoundageBillPage.payeeName}
                                    </SPAN>
                            &nbsp;</font>
                    </td>
                    <td width="19" rowspan="3" align="center" valign="middle">
                        付款单位
                    </td>
                    <td colspan="1" align="center" valign="middle">
                        全&nbsp;&nbsp;称&nbsp;
                    </td>
                    <td colspan="4" align="left" valign="middle">
                                <SPAN id="payerName1">
                                    $!{ePoundageBillPage.payerName}
                                </SPAN>
                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td height="21" colspan="1" align="center" valign="middle">
                        账&nbsp;&nbsp;号&nbsp;
                    </td>
                    <td colspan="4" align="left" valign="middle">
                                <SPAN id="payeeAcc1">
                                    $!{ePoundageBillPage.payeeAcc}
                                </SPAN>
                        &nbsp;
                    </td>
                    <td colspan="1" align="center" valign="middle">
                        账&nbsp;&nbsp;号&nbsp;
                    </td>
                    <td colspan="4" align="left" valign="middle">
                                <SPAN id="payerAcc1">
                                    $!{ePoundageBillPage.payerAcc}
                                </SPAN>
                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td height="22" colspan="1" align="center" valign="middle">
                        单位名称&nbsp;
                    </td>
                    <td colspan="4" align="left" valign="middle">
                                <SPAN id="payeeBank1">
                                    $!{ePoundageBillPage.payeeBank}
                                </SPAN>
                        &nbsp;
                    </td>
                    <td colspan="1" align="center" valign="middle">
                        单位名称&nbsp;
                    </td>
                    <td colspan="4" align="left" valign="middle">
                                <SPAN id="payerBank1">
                                    $!{ePoundageBillPage.payerBank}
                                </SPAN>
                        &nbsp;
                    </td>
                </tr>
                ##                <tr class="bodytext">
                ##                    <td nowrap height="18" colspan="2" align="right" valign="middle">
                ##                        金额：&nbsp;
                ##                    </td>
                ##                    <td nowrap colspan="10" align="left" valign="middle" colspan="10">
                ##                        <span id="currency1">$!{ePoundageBillPage.curName}</span>
                ##                        (大写)：<span id="payMoneyBig1">
                ##						  <div id="moneyUp" style="width: 300px;display: inline-block;" name="moneyUp" readonly="true" data-name="moneyUp"></div>
                ##						</span>
                ##                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                ##                        <input type="hidden" class="bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                ##                               value="$!{ePoundageBillPage.payMoney}" />
                ##                        小写：
                ##                        <span id="payMoney1">
                ##							￥$!number.formatNumeric($!{ePoundageBillPage.payMoney})
                ##						</span>
                ##                        &nbsp;
                ##                    </td>
                ##                </tr>

                <tr class="bodytext">
                    <td nowrap height="18" colspan="2" align="right" valign="middle">
                        金额 (大写)：&nbsp;
                    </td>
                    <td nowrap colspan="10" align="left" valign="middle" colspan="10">
                            <span id="payMoneyBig1">
                              <div id="moneyUp" style="width: 350px;display: inline-block;min-height: 0px;" name="moneyUp" readonly="true"
                                   data-name="moneyUp"></div>
                            </span>
                        <input type="hidden" class="bt-biz-moneyType" data-minus="true" data-toUp="moneyUp"
                               value="$!{ePoundageBillPage.payMoney}"/>
                    </td>
                </tr>

                <tr class="bodytext">
                    <td nowrap height="18" colspan="2" align="right" valign="middle">
                        金额(小写)：&nbsp;
                    </td>
                    <td nowrap colspan="10" align="left" valign="middle" colspan="10">
                        &nbsp;
                        <span id="currency1">$!{ePoundageBillPage.curName}</span>
                        &nbsp;
                        <span id="payMoney1">
                                ￥$!number.formatNumeric($!{ePoundageBillPage.payMoney})
                            </span>
                        &nbsp;
                    </td>
                </tr>

                <tr class="bodytext">
                    <td height="25" colspan="2" align="center" valign="middle">
                        原凭证号码&nbsp;
                    </td>
                    <td height="25" colspan="4" align="center" valign="middle">
                                <span id="oldVoucherNo1">
                                    $!{ePoundageBillPage.oldVoucher}
                                </span>
                        &nbsp;
                    </td>

                    <td height="25" colspan="2" align="center" valign="middle">
                        原凭证金额&nbsp;
                    </td>
                    <td height="25" colspan="2" align="right" valign="middle">
                                <span id="oldVoucherMoney1">
                                    $!number.formatNumeric($!{ePoundageBillPage.oldVoucherMoney})
                                </span>
                        &nbsp;
                    </td>

                </tr>

                <tr class="bodytext">
                    <td height="25" colspan="2" align="center" valign="middle">
                        结算方式&nbsp;
                    </td>
                    <td height="25" colspan="4" align="center" valign="middle">
                                <span id="payType1">
                                    $!{ePoundageBillPage.payType}
                                </span>
                        &nbsp;
                    </td>
                    <td colspan="6" rowspan="3" align="left" height="90" valign="top">

                        借:
                        $!{ePoundageBillPage.debit}
                        <br>

                        &nbsp;&nbsp;&nbsp;&nbsp;贷:
                        $!{ePoundageBillPage.credit}
                        <br>
                        <br>
                        记账 :
                        <span id="tallyName1">
                            $!{ePoundageBillPage.tallierName}
                        </span>
                        &nbsp;&nbsp;复核:
                        <span id="checkers1">
                            $!{ePoundageBillPage.checkerName}
                        </span>
                        &nbsp;&nbsp;主管：
                        <span id="supervisor">
                            $!{ePoundageBillPage.dayOverOperatorUsername}
                        </span>
                    </td>
                </tr>

                <tr class="bodytext">
                    <td colspan="2" align="center" valign="middle">
                        备注&nbsp;
                    </td>
                    <td colspan="4" align="center" valign="middle">
                        &nbsp;    $!{ePoundageBillPage.purpose}
                    </td>
                </tr>

                <tr class="bodytext">
                    <td colspan="2" align="center" valign="middle">
                        转账原因&nbsp;
                    </td>
                    <td colspan="4" align="center" valign="middle">
                                <span id="purpose1">
                                    $!{ePoundageBillPage.purpose}
                                </span>
                        &nbsp;
                    </td>
                </tr>
                <tr>
                    <td nowrap colspan="5" rowspan="3" align="center" valign="middle"
                        height="100">
                        <table border="0" cellspacing="0" cellpadding="0">
                            <tr>
                                <td nowrap valign="bottom" align="center">
                                            <span id="encryImg1">
                                           <img id="imger"
                                                src="${basePath}/download/attachment?id=$!{eVisaTypePage.fileName}"
                                                width="$!{eVisaTypePage.picWidth}px"
                                                ;height="$!{eVisaTypePage.picHeight}px"/>
                                            </span>
                                </td>
                            </tr>
                            <TR>
                                <td nowrap align="center" valign="top"><font size="2">签章时间:
                                    <span id="encryDate1">
                                        $!date.format('yyyy-MM-dd',$!{ePoundageBillPage.encryDate})
                                    </span>
                                </font></td>
                            </TR>
                        </table>
                    </td>
                    <td nowrap colspan="7" align="left" valign="middle">
                        电子回单编号：
                        <span id="billNo1">
                            $!{ePoundageBillPage.billNo}
                        </span>

                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td style="word-break:break-all" colspan="7" align="left" valign="middle">
                        验证码：
                        <span id="validateCode1">
                            $!{ePoundageBillPage.validateCode}
                        </span>
                        &nbsp;
                    </td>
                </tr>
                <tr class="bodytext">
                    <td nowrap colspan="7" align="left" valign="middle">
                        签章人：
                        <span id="subscriber1">
                            $!{ePoundageBillPage.subscriber}
                        </span>
                        &nbsp;
                    </td>
                </tr>
                <tr align="left">

                    <td nowrap height="18" colspan="12" valign="middle">
                        本次打印时间：
                        <span id="printTime1">
                            $!date.format('yyyy-MM-dd HH:mm:ss',$!date.getSystemTime())
                        </span>
                        &nbsp; 打印人：
                        <span id="userName1">
                            $shiro.getPrincipal().username
                        </span>
                        &nbsp;
                    </td>
                </tr>
            </table>
        </div>
    </form>
</div>
<object id="LODOP_OB" classid="clsid:2105C259-1E0C-4534-8141-A753534CB4CA" width=0 height=0>
    <embed id="LODOP_EM" type="application/x-print-lodop" width=0 height=0></embed>
</object>
<br/>
<br/>
<div class="layui-form-item layui-form-submit" id="buttonDiv">
    <div>
        <button type="button" class="layui-btn" onclick="prints()">#springMessage('common.button.print')</button>
        ##            <button class="layui-btn bt-biz-printType" data-printareaid="print_doc1">打印</button>
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/receipt/elecbill/eImagerPrint.js?_btv=${resourceVersion}"></script>
<script>
    bt.use(['form'],function () {
        window.onload = function () {
            var opType = $("#opType").val();
            if(opType == "1") {
                prints();
            }
        };
    });
</script>
</html>

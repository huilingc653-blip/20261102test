#parse("views/common/headInclude.vm")
##</head>
##<body>
##定期取款单/通知取款单电子回单列表
<form id="commonForm">
    <input type="hidden" name="ins_corpId" value="$!{billQueryPage.corpIds}" >
    <input type="hidden" name="printSign" value="$!{billQueryPage.printSign}" >
    <input type="hidden" name="eqs_billType" value="$!{billQueryPage.billType}" >
    <input type="hidden" name="eqi_status" value="$!{billQueryPage.status}" >
    <input type="hidden" name="ges_voucherNo" value="$!{billQueryPage.beginVouNo}" >
    <input type="hidden" name="les_voucherNo" value="$!{billQueryPage.endVouNo}" >
    <input type="hidden" name="geg_money" value="$!{billQueryPage.beginMoney}" >
    <input type="hidden" name="leg_money" value="$!{billQueryPage.endMoney}" >
    <input type="hidden" name="ged_tallyDate" value="$!date.format('yyyy-MM-dd',$!{billQueryPage.beginDate})" >
    <input type="hidden" name="led_tallyDate" value="$!date.format('yyyy-MM-dd',$!{billQueryPage.endDate})" >
##    <input type="hidden" name="ged_encryDate" value="$!{billQueryPage.beginDate}" >
##    <input type="hidden" name="led_encryDate" value="$!{billQueryPage.endDate}" >
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.eTransBill.billNo')</th>##电子回单号
        <th>#springMessage('table.eTransBill.voucherNo')</th>##凭证号
        <th>#springMessage('table.eTransBill.oldVoucherNo')</th>##原始凭证号
        <th>#springMessage('table.eTransBill.billType')</th>##电子回单类型
        <th>#springMessage('table.eTransBill.corpName')</th>##成员单位
        <th>#springMessage('table.eTransBill.depositType')</th>##存款类型
        <th>#springMessage('table.eAccrualBill.depositAcc')</th>##存入账号
        <th>#springMessage('table.eAccrualBill.depositAccName')</th>##存入账户名称
        <th>#springMessage('table.eAccrualBill.saveAcc')</th>##存出账号
        <th>#springMessage('table.eAccrualBill.saveAccName')</th>##存出账户名称
        <th>#springMessage('table.eAccrualBill.rate')(%)</th>##利率
        <th>#springMessage('table.eTransBill.curId')</th>##币种
        <th>#springMessage('table.eTransBill.money')</th>##金额
        <th>#springMessage('table.eTransBill.content')</th>##摘要
        <th>#springMessage('table.eTransBill.tallyDate')</th>##记账日期
        <th>#springMessage('table.bvPrintVouOpinfo.isPrint')</th>##是否已打印
        <th>#springMessage('common.table.thead.operation')</th>##操作
    </tr>
    </thead>
</table>
###parse("views/common/footer.vm")
##</body>
<script src="${basePath}/static/modules/receipt/elecbill/eDrawMoneyBill.list.js?_btv=${resourceVersion}"></script>
##</html>

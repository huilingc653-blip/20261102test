<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="20%">#springMessage('table.fcAcc.corpId')</td>
            <td width="30%"><div class="layui-input-inline">
                <div class="bt-biz-corp"
                     data-biz-type="corp"
                     data-type="selectTree"
                     data-tree-type="check"
                     data-name="ins_corpId"
                     data-scope="all"
                     data-resource="netbank:bis:bisBankMonthStatementDtl:query"
                     data-callback="corpCallback"></div>
                </div>
            </td>
            <td class="textRight" width="20%">#springMessage('table.nisBillhead.bankAcc')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <input type="text" id="likes_customerAccount" name="likes_customerAccount" data-name="likes_customerAccount" data-biz-name="likes_customerAccount" accountType="2,3" autocomplete="off" containDelBankAcc="true"
                           data-resource="netbank:bis:bisBankMonthStatementDtl:query"  class="layui-input bt-biz-accountTable" data-callback="customerAccountCallBack" permission="D"/>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.eBankBill.bankType')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/listFilter"
                     data-valuefield="id" data-textfield="name" data-name="eqs_bifCodeId"></div>
            </td>
            <td class="textRight">#springMessage('table.bisBankMonthStatementDtl.billDate')</td>
            <td>
                <input type="text" name="billDate" class="layui-input bt-input-inline bt-biz-dateType">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                    'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btBankAccDtl.corp')</th>
        <th>#springMessage('table.nisBillhead.bankAcc')</th>
        <th>#springMessage('table.bisAccBal.accName')</th>
        <th>#springMessage('table.bisAccDtl.curName')</th>
        <th>#springMessage('table.bisBankMonthStatementDtl.billDate')</th>
        <th>#springMessage('table.eBankBill.bankType')</th>
        <th>#springMessage('table.bisBankMonthStatementDtl.closingBalance')</th>
        <th>#springMessage('table.bisBankMonthStatementDtl.totalNumber')</th>
        <th>#springMessage('table.bisBankMonthStatementDtl.totalDebitAmt')</th>
        <th>#springMessage('table.bisBankMonthStatementDtl.totalCreditAmt')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/reconcile/bisBankMonthStatementDtl.list.js?_btv=${resourceVersion}"></script>
</html>

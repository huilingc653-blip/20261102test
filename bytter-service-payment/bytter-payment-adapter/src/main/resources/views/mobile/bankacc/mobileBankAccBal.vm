<!DOCTYPE html>
<html>
<head>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="font-src *  data:">
    <meta name="viewport"
          content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0, user-scalable=no">
    <title>账户余额</title>
    <!-- 引入 FrozenUI -->
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css" media="all"/>
    <link rel="stylesheet" href="${basePath}/static/css/mobile/index.css" media="all"/>
    <!-- 注意：如果你直接复制所有代码到本地，上述js路径需要改成你本地的 -->
    <script src="${basePath}/static/mobile/plugins/zepto/zepto.min.js"></script>
    <script src="${basePath}/static/plugins/f2/f2.min.js"></script>
    <script src="${basePath}/static/js/mobile/date.js"></script>
    <style>
        .acc-bal{
            height: 2.55rem;
            background-color: #F5F5F5;
            padding-top:0.15rem;
            padding-bottom:0.15rem;
        }

        .acc-bal-box{
            border-radius: 0.1rem;
            height: 2.55rem;
            margin-left: 0.15rem;
            margin-right: 0.15rem;
            background-color: #ffffff;
        }

        .acc-bal-head{
            border-radius: 0.1rem;
            height: 1.02rem;
            background-color: #476CE9;
        }
        .acc-bal-body{
            border-bottom-left-radius: 0.1rem;
            border-bottom-right-radius: 0.1rem;
            height: 1.53rem;
            background-color: #ffffff;
        }
        .acc-bal-text{
            position: absolute;
            color:#FFFFFF;
            margin-top: 0.15rem;
            margin-left: 0.2rem;
            font-size: 0.14rem;
        }
        .acc-bal-money{
            position: absolute;
            color:#FFFFFF;
            margin-top: 0.51rem;
            margin-left: 0.2rem;
            font-size: 0.28rem;
        }
        .acc-bal-date{
            position: absolute;
            margin-top: 0.18rem;
            margin-left: 2.55rem;
            font-size: 0.12rem;
            color:#FFFFFF;
            font-family:PingFangSC-Regular,PingFang SC;
        }

        .content {
            height: 5.66rem;
            width: 100%;
        }

        .content-item{
            height: 0.38rem;
            margin-left: 0.16rem;
            margin-right: 0.16rem;
            border-bottom: 1px solid #EFEFEF;
        }
        .content-dtl1{
            display: inline-block;
            margin-top: 0.15rem;
            width:1rem;
        }
        .content-dtl2{
            display: inline-block;
            margin-top: 0.14rem;
            float: right;

            width: 55%;
            text-align: right;
            white-space:nowrap;
            overflow-x:auto;
        }

        .item-info{
            position: absolute;
            font-size:14px;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(102,102,102,1);
            line-height:20px;
            margin-left: 0.16rem;
        }
        .item-info-img1{
            position: absolute;
            left: 0;
            width:0.16rem;
            height:0.14rem;
            margin-top: 0.18rem;
            background-repeat: no-repeat;
            background-size: contain;
            background-image: url("${basePath}/static/modules/images/bankaccdtlac.png")
        }
        .item-info-img2{
            position: absolute;
            left: 0;
            width:0.16rem;
            height:0.14rem;
            margin-top: 0.13rem;
            background-repeat: no-repeat;
            background-size: contain;
            background-image: url("${basePath}/static/modules/images/bankaccdtlinf.png")
        }
        .item-info-img3{
            position: absolute;
            left: 0;
            width:0.16rem;
            height:0.14rem;
            margin-top: 0.13rem;
            background-repeat: no-repeat;
            background-size: contain;
            background-image: url("${basePath}/static/modules/images/bankaccdtlcm.png")
        }
        .item-info-img4{
            position: absolute;
            left: 0;
            width:0.16rem;
            height:0.14rem;
            margin-top: 0.13rem;
            background-repeat: no-repeat;
            background-size: contain;
            background-image: url("${basePath}/static/modules/images/bankaccdtlbk.png")
        }
        .item-info-acc{
            margin-top: 0.21rem;
            margin-left: 0.3rem;
        }
        .item-info-acc-child{
            margin-top: 0.13rem;
            margin-left: 0.3rem;
        }

        .item-info-bg{
            width:0.5rem;
            height:0.68rem;
            margin-top: 0.59rem;
            float: right;
            clear:both;
            background-repeat: no-repeat;
            background-size: contain;
            background-image: url("${basePath}/static/modules/images/bankaccbalbg.png")
        }
    </style>
</head>
<body  style="height: 100%">
    #if($!{bankAcc})
    <div class="acc-bal">
        <div class="acc-bal-box">
            <div class="acc-bal-head">
                <div class="acc-bal-text">余额(元)</div>
                <div class="acc-bal-money">$!number.formatNumeric($!{bal.bal})</div>
                <div class="acc-bal-date">$!date.format('yyyy-MM-dd',$!{bal.balDate})</div>
            </div>
            <div class="acc-bal-body">
                <div class="item-info">
                    <div class="item-info-img1"></div>
                    <div class="item-info-acc">$!{bankAcc.bankAcc}</div>
                    <div class="item-info-img2"></div>
                    <div class="item-info-acc-child">$!{bankAcc.attributeName}</div>
                    <div class="item-info-img3"></div>
                    <div class="item-info-acc-child">$!{bankAcc.corpName}</div>
                    <div class="item-info-img4"></div>
                    <div class="item-info-acc-child">$!{bankAcc.bankName}</div>
                </div>
                <div class="item-info-bg"></div>
            </div>
        </div>
    </div>
    <div class="content">
        <div class="content-item">
            <span class="content-dtl1">账户性质</span>
            <span class="content-dtl2">$!{bankAcc.natureName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">账户属性</span>
            <span class="content-dtl2">$!{bankAcc.attributeName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">账户类别</span>
            <span class="content-dtl2">$!{bankAcc.accTypeName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">余额日期</span>
            <span class="content-dtl2">$!date.format('yyyy-MM-dd',$!{bal.balDate})</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">余额</span>
            <span class="content-dtl2">$!number.formatNumeric($!{bal.bal})</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">可用余额</span>
            <span class="content-dtl2">$!number.formatNumeric($!{bal.availBal})</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">冻结余额</span>
            <span class="content-dtl2">$!number.formatNumeric($!{bal.frzBal})</span>
        </div>
    </div>
    #else
    <script>alert('暂无权限')</script>
    #end

</body>
</html>

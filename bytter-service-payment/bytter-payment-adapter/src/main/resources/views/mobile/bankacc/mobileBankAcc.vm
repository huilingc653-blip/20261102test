            // resetScrollContent();

        });
        $("#btn3").click(function () {
            $('#body').addClass('overflow-hide');
            addSheet($(this), '#actionsheet3')
            // resetScrollContent();
        });
        //点击确定
        $('.submitBtn').on('click', function () {
            var btn = $(this).parents('.ui-actionsheet').removeClass('show')
                    .data('link');
            $('#' + btn).removeClass('active');
            $('#body').removeClass('overflow-hide');
            $('.bt-select-popup').removeClass('active');
            resetScrollContent();

            //确认提交
            // submiteData(false);
        })





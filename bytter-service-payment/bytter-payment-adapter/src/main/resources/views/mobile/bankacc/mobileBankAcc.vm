<!DOCTYPE html>
<html>
<head>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="font-src *  data:">
    <meta name="viewport"
          content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0, user-scalable=no">
    <title>银行账户查询</title>
    <!-- 引入 FrozenUI -->
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no,minimum-scale=1.0,maximum-scale=1.0">
    <link rel="stylesheet" href="$!{basePath}/static/mobile/plugins/fixedTable/table.min.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="$!{basePath}/static/plugins/frozen/css/frozenui.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="$!{basePath}/static/mobile/plugins/dropload/dropload.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="$!{basePath}/static/css/mobile/index.css?_btv=${resourceVersion}">
    <style>
        #tab {
            background: rgba(255, 255, 255, 1);
        }
        .cho-panel-item {
            position: relative;
            border-radius: 0.1rem;
            margin: 0 auto;
            width:3.45rem;
            height:1.3rem;
            margin-bottom: 0.1rem;
        }
        .cho-panel-item-logo {
            position: absolute;
            border-radius: 50%;
            height: 0.48rem;
            width: 0.48rem;
            margin-top:0.23rem;
            margin-left:0.18rem;
            background-color: #FFFFFF;
        }
        .cho-panel-item-logo-head {
            position: absolute;
            border-radius: 50%;
            padding: 0.18rem;
            margin: 0.06rem;
            background-repeat: no-repeat;
            background-size: contain;
        }
        .cho-panel-item-title {
            position: absolute;
            height: 0.7rem;
            width: 2.2rem;
            margin-left:0.76rem;
            margin-top:0.18rem;
        }
        .cho-panel-item-button {
            position: absolute;
            color: #ffffff;
            margin-top:0.93rem;
            border: 1px solid #ffffff;
            border-radius: 0.05rem;
            padding: 0.05rem 0;
            text-align: center;
            width: 0.78rem;
            font-size: 0.12rem;
        }
        .button-dtl-left {
            margin-left: 0.2rem;
        }
        .button-dtl-right {
            margin-left: 2.47rem;
        }
        .button-dtl-center {
            margin-left: 1.34rem;
        }
        .cho-panel-item-title-font {
            font-size: 0.17rem;
            inline-size: 0.15rem;
            width: auto;
            font-weight: bold;
            font-family: PingFangSC-Regular, PingFang SC;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space:nowrap;
            color: #FFFFFF;
        }

        .cho-panel-item-dtl-font {
            font-size: 0.14rem;
            inline-size: 0.14rem;
            width: auto;
            font-family: PingFangSC-Regular, PingFang SC;
            color: #FFFFFF;
        }

        .cho-panel-item .cho-panel-item-money {
            font-size: 0.22rem;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(255, 255, 255, 1);
        }

        .cho-panel-item-bottom span {
            display: inline-block;
            height: 100%;
            font-size: 0.16rem;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(167, 168, 225, 1);
            line-height: 0.16rem;
        }

        .cho-content-item-acc-right span {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.17rem;
            padding: 0.10rem 1rem;
            padding-right: 0rem;
        }

        .cho-tab-title span {
            display: inline-block;
            height: 0.24rem;
            border-radius: 0.12rem;
            margin: 0.06rem;
            margin-top: 0.1rem;
            color: #333;
            padding: 0 0.1rem;
            font-size: 0.14rem;
            font-family: PingFangSC-Regular, PingFang SC;
            margin-left: 0;
            line-height: 0.25rem;
        }

        .cho-tab-title span:nth-child(3) {
            margin-right: 0;
        }

        .cho-tab-title .active {
            background-color: #1B1D75;
            color: #fff !important;
        }

        .cho-date-item-bottom > div > div {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.22rem;
            height: 0.22rem;
        }

        /* 弹框选择 */
        .bt-select-popup {
            position: relative;
            margin-right: 6px;
        }

        .ui-actionsheet {
            display: none
        }

        .ui-actionsheet .show {
            display: block;
        }

        .ui-actionsheet.show .ui-actionsheet-cnt {
            transition: none;
        }

        .ui-actionsheet .ui-actionsheet-cnt {
            transition: none;
        }

        .bt-select-popup input, .bt-select-popup select {
            border: none;
            width: 0.58rem;
            height: 0.32rem;
            background-color: #F5F5F5;
            border-radius: 0.16rem;
            padding: 0 0.15rem;
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 600;
            color: rgba(102, 102, 102, 1);
        }

        .bt-select-popup.active input {
            color: #2988FF;
            background-color: #E9F1FF;
        }

        .bt-select-popup.active:after {
            color: #2988FF;
        }

        .bt-select-popup:after {
            position: absolute;
            top: 49%;
            right: 0.15rem;
            margin-top: -4px;
            width: 0;
            height: 0;
            border-top: 6px solid;
            border-right: 5px solid transparent;
            border-left: 5px solid transparent;
            color: #a6a6a6;
            content: "";
            pointer-events: none;
        }

        .ui-btn-wrap {
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 500;
            color: rgba(51, 51, 51, 1);
            margin-left: 0;
            height: 0.3rem;
        }

        .bt-date-btn input {
            border: none;
            width: 0.58rem;
            height: 0.32rem;
            background-color: #F5F5F5;
            border-radius: 0.16rem;
            padding: 0 0.15rem;
            width: 0.36rem;
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 600;
            color: rgba(102, 102, 102, 1);
            padding-right: 0.04rem;
        }

        .popup-block * {
            font-size: 0.14rem;
        }

        .bt-card {
            background-color: #fff;
        }

        .bt-card .active {
            color: #2988FF;
            font-weight: 700;
        }

        .bt-card-header {
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 700;
            color: rgba(51, 51, 51, 1);
            line-height: 0.35rem;
            height: 0.35rem;
            padding-left: 0.1rem;
            text-align: left;
        }

        .bt-card-body {
            padding-bottom: 0.15rem;
        }

        .bt-card-item {
            height: 0.34rem;
            background: rgba(240, 240, 240, 1);
            border-radius: 0.18rem;
            line-height: 0.34rem;
            text-align: center;
            margin: 0.05rem 0.1rem 0.05rem 0;
            font-size: 0.14rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
        }
        .ui-sp-btn > select {
            height: 0.34rem;
            background: transparent;
            border: none;
            font-size: 0.14rem;
            color: rgba(102, 102, 102, 1);"
        }

        .bt-card-body .ui-col:nth-last-child(1) .bt-card-item {
            margin-right: 0;
        }

        .ui-sp-btn {
            background: #f3f3f3;
            border-radius: 0.16rem;
            width: 1.11rem;
            height: 0.3rem;
            line-height: 0.3rem;
        }

        .ui-sp-btn > input {
            font-size: 0.12rem;
            font-family: 苹方-简 常规体;
            font-weight: 400;
            color: #333333;
            width: 1.11rem;
        }

        .ui-form-item input {
            padding-left: 0.16rem;
        }

        .ui-row-flex .ui-col {
            text-align: center;
        }
        .ui-head{
            padding-top: 0.1rem;
            height: 0.5rem;
        }
        .overflow-hide {
            overflow: hidden!important;
        }
    </style>
</head>
<body id="body">
<section class="cho-body ui-container">
    <div id="tab" class="search-content">
        <div class="ui-row-flex ui-head">
            <!-- 搜索框 -->
            <div class="ui-col ui-col" id="corpDiv">
                <div class="ui-searchbar-wrap ui-border-b">
                    <div class="ui-searchbar ui-border-radius">
                        <i class="ui-icon-search"></i>
                        <div class="ui-searchbar-text">请选择单位</div>
                        <div class="ui-searchbar-input">
                            <input value="" id="corpId" name="corpId" type="text" placeholder="请选择单位"
                                   autocapitalize="off" readonly="readonly">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <div class="ui-btn-wrap">
                ##单位
                ##                <div class="ui-btn-corp">
                ##                    <button class="btn-corp" onclick="openCorpSelectionPage()">单位(<span id="cs">0</span>)</button>
                ##                </div>
                ##类别
                <div class="bt-select-popup">
                    <input type="text" id="btn1" readonly="readonly" placeholder="类别" value="类别"
                           style="width: 0.4rem">
                </div>
                ##属性
                <div class="bt-select-popup" style="margin: 0px 0.5rem">
                    <input type="text" id="btn2" readonly="readonly" placeholder="属性" value="属性"
                           style="width: 0.4rem;">
                </div>
                ##更多
                <div class="bt-select-popup">
                    <input type="text" id="btn3" readonly="readonly" placeholder="更多" value="更多"
                           style="width: 0.4rem;">
                </div>

                ##类别控制
                <div class="popup-block">
                    <div class="ui-actionsheet" id="actionsheet1" style="height:calc(100% - 1rem);top:1rem;"
                         data-link="btn1">
                        <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 1rem;">
                            <section class="bt-popup-container">
                            <div class="bt-card" id="accTypeName">
                                <div class="bt-card-header">
                                    类别选择
                                    <input type="hidden" id="accType" name="accTypeName" value="">
                                </div>
                            <div class="bt-card-body">
                                #foreach($type in $bankAccType)
                                    #set($vcount = $velocityCount - 1)
                                    #if($!{vcount}%3 == 0)
                                    <div class="ui-row-flex ui-whitespace">
                                    #end
                                    <div class="ui-col ui-col">
                                        <div class="bt-card-item"
                                             data-value="$!{type.code}">$!{type.name}</div>
                                    </div>
                                    #if($!{foreach.last})
                                        #if($velocityCount % 3 == 1)
                                            <div class="ui-col ui-col"></div>
                                            <div class="ui-col ui-col"></div>
                                        </div>
                                        #elseif($velocityCount % 3 == 2)
                                            <div class="ui-col ui-col"></div>
                                        </div>
                                        #end
                                    #else
                                        #if($velocityCount % 3 == 0)
                                        </div>
                                        #end
                                    #end
                                #end
                            </section>
                            <div class="bt-popup-bottom">
                                <button type="button" id="clearValue1" class="bt-popup-reset resetBtn">重置</button>
                                <button type="button" id="submitValue1" class="bt-popup-submit submitBtn">确定</button>
                            </div>
                        </div>
                    </div>
                </div>
                ##属性控制
                <div class="popup-block">
                    <div class="ui-actionsheet" id="actionsheet2" style="height:calc(100% - 1rem);top:1rem;"
                         data-link="btn2">
                        <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 1rem;">
                            <section class="bt-popup-container">
                            <div class="bt-card" id="attributeId">
                                <div class="bt-card-header">
                                    属性选择
                                    <input type="hidden" id="attribute" name="attributeId" value="">
                                </div>
                            <div class="bt-card-body">
                                #foreach($attr in $attribute)
                                    #set($vcount = $velocityCount - 1)
                                    #if($!{vcount}%3 == 0)
                                    <div class="ui-row-flex ui-whitespace">
                                    #end
                                    <div class="ui-col ui-col">
                                        <div class="bt-card-item"
                                             data-value="$!{attr.id}">$!{attr.attributeName}</div>
                                    </div>
                                    #if($!{foreach.last})
                                        #if($velocityCount % 3 == 1)
                                            <div class="ui-col ui-col"></div>
                                            <div class="ui-col ui-col"></div>
                                        </div>
                                        #elseif($velocityCount % 3 == 2)
                                            <div class="ui-col ui-col"></div>
                                        </div>
                                        #end
                                    #else
                                        #if($velocityCount % 3 == 0)
                                        </div>
                                        #end
                                    #end
                                #end
                            </section>
                            <div class="bt-popup-bottom">
                                <button type="button" id="clearValue2" class="bt-popup-reset resetBtn">重置</button>
                                <button type="button" id="submitValue2" class="bt-popup-submit submitBtn">确定</button>
                            </div>
                        </div>
                    </div>
                </div>
                ##更多控制
                <div class="popup-block">
                    <div class="ui-actionsheet" id="actionsheet3"
                         style="height:calc(100% - 1rem);top:1rem;" data-link="btn3">
                        <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 1rem;">
                            <section class="bt-popup-container">
                                <div class="bt-card" id="calEndDateCard">
                                    <div class="bt-card-header">
                                        账号
                                    </div>
                                    <div class="ui-form-item" style="height: 0.36rem;">
                                        <div class="ui-sp-btn" style="width: 80%">
                                            <input type="text" id="bankAcc" style="width: 80%" value=""/>
                                        </div>
                                    </div>
                                </div>


                                <div class="bt-card" id="validSign">
                                    <div class="bt-card-header">
                                        是否有效
                                        <input type="hidden" id="valid" name="validSign" value="">
                                    </div>
                                    <div class="bt-card-body">
                                        <div class="ui-row-flex ui-whitespace">
                                            <div class="ui-col ui-col">
                                                <div class="bt-card-item" data-value="1">有效</div>
                                            </div>
                                            <div class="ui-col ui-col">
                                                <div class="bt-card-item" data-value="0">无效</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                    <div class="bt-card" id="isOnline">
                                        <div class="bt-card-header">
                                            是否在线
                                            <input type="hidden" id="online" name="isOnline" value="">
                                        </div>
                                        <div class="bt-card-body">
                                            <div class="ui-row-flex ui-whitespace">
                                                <div class="ui-col ui-col">
                                                    <div class="bt-card-item" data-value="1">在线</div>
                                                </div>
                                                <div class="ui-col ui-col">
                                                    <div class="bt-card-item" data-value="0">离线</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                <div class="bt-card" id="calEndDateCard">
                                    <div class="bt-card-header">
                                        银行类别
                                    </div>
                                    <div class="ui-form-item" style="height: 0.36rem;">
                                        <div class="ui-sp-btn" style="width: 80%">
                                            <select id="bankTypeId" name="bankTypeId" style="width: 80%">
                                                <option value='' >全部</option>
                                                #foreach($bank in $bankType)
                                                    <option value='$!{bank.id}' >$!{bank.typeName}</option>
                                                #end
                                            </select>
                                        </div>
                                    </div>
                                </div>

                            </section>
                            <div class="bt-popup-bottom">
                                <button type="button" id="clearValue3" class="bt-popup-reset resetBtn">重置</button>
                                <button type="button" id="submitValue3" class="bt-popup-submit submitBtn">确定</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="search-result" style="padding-top:115px ">
        <section class="search-result-list"></section>
    </div>
</section>
</body>
<!-- 注意：如果你直接复制所有代码到本地，上述js路径需要改成你本地的 -->
<script src="$!{basePath}/static/modules/mobile/webViewAppScriptBridage.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/modules/mobile/webViewApp.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/mobile/plugins/zepto/zepto.min.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/mobile/plugins/dropload/dropload.min.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/mobile/plugins/f2/f2.min.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/mobile/js/popup.js?_btv=${resourceVersion}" id="tableJS"></script>
<script src="$!{basePath}/static/js/mobile/money.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/js/mobile/date.js"></script>
<script>
    var ACTIVE = 'active';
    var seachType = ''
    var time = null
    // 用于记录页面的查询参数
    const searchParams = {
        corpIds: [],
        corpNames: [],
        curId: null,
        corpId: null,
        accType: null,
        bankAcc:null,
        bankTypeId:null,
    };
    $('#bt-loading').show();

    window.getResultList = (data)=>{
        window.postData(data,'app')
    }

    window.getCorp = (data)=>{
        seachType = 'seach';
        searchActionCallback(data)
    }
    //单位搜索组件
    function openCorpSelectionPage() {
        setTimeout(function () {
            var data = BTAppBridge.openCorpSelectionPage && BTAppBridge.openCorpSelectionPage('searchActionCallback',{
                resource:'netbank:bankAcc:btBankAccQuery:query'
            });
            uni.postMessage({
                data: data
            });
        }, 200);

    }

    (function (doc, win) {

        F2.track(false);
        //初始化数据
        // submiteData(true);

        var pageSize  = 15,pageNumber = 1,dropObj = null;
        //滚动加载初始化 初始化数据
        resetScrollContent(true);
        //滚动加载初始化
        function resetScrollContent(init) {
            //  if(time){
            //      return;
            //  }
            // time = setTimeout(()=>{
            //     timer = null
            //  },1000)
            console.log('初始化',seachType)
            $('.search-result-list').html('');
            $('.dropload-down').remove();
            pageNumber = 1;
            pageSize = 15;
            dropObj = null;
            $('.search-result').dropload({
                scrollArea : window,
                loadDownFn : function(me){
                    me.noData();
                    dropObj = me;
                    submiteData(init)
                }
            });
        }

        /**
         * 搜索回调方法
         * @param data
         */
        window.searchActionCallback = function (data) {
            ## var dataDiv = document.getElementById("tab1");
            ## dataDiv.innerHTML = "<div id=\"bt-loading\" class=\"bt-loading\">\n" +
            ##         "            <center><img style=\"width:25px;\" src=\"${basePath}/static/mobile/icon/loadinggif.gif\"></center>\n" +
            ##         "        </div>";
            $('#bt-loading').show();
            pageNumber=1;
            // 根据data参数，查询数据
            if (data.corpNames && data.corpNames.length > 0) {
                searchParams.corpNames = data.corpNames;
                $("#corpId").val(data.corpNames);
            } else {
                $("#corpId").val('');
            }
            if (data.corpIds) {
                searchParams.corpIds = data.corpIds;
                searchParams.corpId = data.corpIds;
                setTimeout(function () {
                    resetScrollContent();
                    // BTAppBridge.post("/mobile/api/bankacc/getBankAccMoblieList", searchParams, 'postData');
                }, 100);
            }

            // $('#bt-loading').hide();
        }

        $('.ui-tab-nav > li').on('click', function () {
            $(this).addClass('current').siblings('li').removeClass('current');
            $('.ui-tab-content>li').removeClass('bt-show');
            $('.ui-tab-content li').eq($(this).index()).addClass('bt-show');
            initChart('pieChart' + $(this).index());
        })

        //搜索框点击
        $('.ui-searchbar').on('click', function () {
            $('.ui-searchbar-wrap').addClass('focus');
            $('.ui-searchbar-input input').focus();
        });
        $('.ui-searchbar-cancel').on('click', function () {
            $('.ui-searchbar-wrap').removeClass('focus');
        });

        //弹框选择
        function addSheet($this, id) {
            if ( $this.parent().hasClass('active')) {
                hideSheet($this);
                return
            }
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
                $this.parent().addClass('active');
            $(id).addClass('show');
        }

        //弹框选择
        function hideSheet($this) {
            $('.ui-actionsheet').removeClass('show');
                $this.parent().removeClass('active');
        }

        //单位选择
        $("#corpDiv").click(function () {
            openCorpSelectionPage();
        });

        //数据列表
        postData = function (data,type) {
            pageNumber  = data.pageNumber+1;
            setDataDiv(JSON.stringify(data.list),type);
        }

        //数据提交
        function submiteData(isInit) {
            ## var dataDiv = document.getElementById("tab1");
            ## dataDiv.innerHTML = "<div id=\"bt-loading\" class=\"bt-loading\">\n" +
            ##         "            <center><img style=\"width:25px;\" src=\"${basePath}/static/mobile/icon/loadinggif.gif\"></center>\n" +
            ##         "        </div>";
            ## $('#bt-loading').show();
            $('#bt-loading').show();
            searchParams.accType = $("#accType").val();
            searchParams.attributeId = $("#attribute").val();
            searchParams.validSign = $("#valid").val();
            searchParams.bankAcc = $("#bankAcc").val();
            searchParams.bankTypeId = $("#bankTypeId").val();
            if(isInit){
                searchParams.isOnline = '1';
            }else{
                searchParams.isOnline = $("#online").val();
            }
            searchParams.pageSize = pageSize;
            searchParams.pageNumber = pageNumber;
            setTimeout(function () {
                // BTAppBridge.post("/mobile/api/bankacc/getBankAccMobliePageList", searchParams, 'postData');
                var data = BTAppBridge.post("/mobile/api/bankacc/getBankAccMobliePageList", searchParams, 'postData');
                uni.postMessage({
                    data: data
                });
            }, 200);
            // $('#bt-loading').hide();
        }


        function setDataDiv(result,type) {
            console.log("加载" + type+seachType)
            var showHtml = '';
            var data = result;
            if (!data || JSON.parse(result).length==0){

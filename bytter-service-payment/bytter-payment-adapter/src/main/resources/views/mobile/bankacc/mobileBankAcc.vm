        function initCard(id, value, clickCallback, isNotInit) {
            if (!id) {
                return
            }
            var $card =
            $(id);
            var hiddenInput = $card.find('.bt-card-header input');
            var items = $card.find('.bt-card-item');
            items.removeClass(ACTIVE);
            hiddenInput.val('');
            //设置选中值
            if (value) {
                for (var i = 0; i < items.length; i++) {
                    if (value == $(items[i]).data('value')) {
                        $(items[i]).addClass(ACTIVE);
                        hiddenInput.val(value);
                        break
                    }
                }
            }
            if (isNotInit) {
                return;
            }

            $(id).on('click', '.bt-card-item', function () {
                var value = '';
                if ($(this).hasClass(ACTIVE)) { //如果当前被选中时，点击会取消选中
                    $(this).removeClass(ACTIVE);
                } else {
                        $card.find('.bt-card-item').removeClass(ACTIVE);
                    $(this).addClass(ACTIVE);
                    value = $(this).data('value');
                }
                hiddenInput.val(value);
                if (clickCallback) {
                    clickCallback(value);
                }
                return false;
            })
        }

        function getColor(flag){
            var rand = Math.floor(Math.random()*4);
            if(isEmpty(flag)){
                return 'background-image: linear-gradient(to right, #666D92 , #95A9D0)';
            }else if(rand === 0){
                return 'background-image: linear-gradient(to right, #F75E55 , #FE946E)';
            }else if(rand === 1){
                return 'background-image: linear-gradient(to right, #F89C51 , #F5B868)';
            }else if(rand === 2){
                return 'background-image: linear-gradient(to right, #028DAF , #00AA9B)';
            }else if(rand === 3){
                return 'background-image: linear-gradient(to right, #5276F6 , #74C3FF)';
            }
        }

        //初始化
        initCard('#accTypeName', '');
        initCard('#attributeId', '');
        initCard('#validSign', '');
        initCard('#isOnline', '1');
        //点击重置
        $('#clearValue1').on('click', function () {
            initCard('#accTypeName', '', '', true);
            resetScrollContent();
        })
        $('#clearValue2').on('click', function () {
            initCard('#attributeId', '', '', true);
            resetScrollContent();
        })
        $('#clearValue3').on('click', function () {
            $("#bankAcc").val("");
            $("#bankTypeId").val("");
            initCard('#validSign', '', '', true);
            initCard('#isOnline', '', '', true);
            resetScrollContent();
        })

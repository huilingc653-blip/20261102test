<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input id="opType" name="opType" type="hidden" value="rePage">
    <input type="hidden" name="eqs_corpId" value="$!{nisReceivablePage.corpId}">
    <input type="hidden" name="eqs_bankAcc" value="$!{nisReceivablePage.bankAcc}">
    <input type="hidden" name="eqs_oppAccNo" value="$!{nisReceivablePage.oppAccNo}">
    <input type="hidden" name="eqs_accName" value="$!{nisReceivablePage.accName}">
    <input type="hidden" name="eqs_curId" value="$!{nisReceivablePage.curId}">
    <input type="hidden" name="eqs_busType" value="$!{nisReceivablePage.busType}">
    <input type="hidden" id="amt" value="$!{nisReceivablePage.amt}">
    <input type="hidden" id="bankSerialNo" value="$!{nisReceivablePage.bankSerialNo}">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                    ##收款单号
                        <td class="textRight">#springMessage('table.nisReceivable.billNo')</td>
                        <td>
                            <input type="text" name="likes_billNo"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.nisReceivable.billNo')">
                        </td>
                        <td class="textRight">#springMessage('table.btNetChalk.transTime')</td>
                        <td>
                            <input type="text" name="ged_transTime" class="layui-input bt-input-inline bt-biz-dateType"
                                   data-endid="led_transTime">
                            <span class="date-mid">~</span>
                            <input type="text" name="led_transTime" class="layui-input bt-input-inline bt-biz-dateType"
                                   id="led_transTime">
                        </td>
                    ##金额
                        <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
                        <td>
                            $!number.formatNumeric($!{nisReceivablePage.amt})
                        </td>
                    </tr>
                    <tr>
                    ##本方账号
                        <td class="textRight">#springMessage('table.btBankAccDtl.bankAcc')</td>
                        <td>
                            $!{nisReceivablePage.bankAcc}
                        </td>
                    ##对方账号
##                        <td class="textRight">#springMessage('table.btBankAccDtl.oppAccNo')</td>
##                        <td>
##                            $!{nisReceivablePage.oppAccNo}
##                        </td>

                        <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.oppAccNo')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" id="likes_oppAccNo" name="likes_oppAccNo" class="layui-input bank" placeholder="#springMessage('table.btBankAccDtl.oppAccNo')">
                            </div>
                        </td>
                        
                    ##本方账号名称
                        <td class="textRight">#springMessage('table.btBankAccDtl.accName')</td>
                        <td>
                            $!{nisReceivablePage.accName}
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                            'common.button.search')</button>
                                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                            'common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis" >
    <thead>
    <tr>
        <th>#springMessage('table.nisReceivable.billNo')</th>
        <th>#springMessage('table.nisBillhead.corpId')</th>
        <th>#springMessage('table.nisBillhead.busType')</th>
        <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
        <th>#springMessage('table.btBankAccDtl.accName')</th>
        <th>#springMessage('table.btBankAccDtl.bankName')</th>
        <th>#springMessage('table.nisBillhead.curId')</th>
        <th>#springMessage('table.nisBillhead.payMoney')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
        <th>#springMessage('table.nisReceivable.oppBankCode')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccBank')</th>
        <th>#springMessage('table.btNetChalk.transTime')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/receivable/nisReceivablePage.list.js?_btv=${resourceVersion}"></script>

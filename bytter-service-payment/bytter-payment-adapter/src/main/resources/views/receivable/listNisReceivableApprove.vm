<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}"/>
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
            <td>
                <input type="hidden" id="corpIds" value="$!{corpIds}">
            ##付款人单位
                <div class="layui-input-inline">
                    <div class="demo-selectTree-normal"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisBillhead.busType')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType"
                         data-url="${basePath}/netbank/niscorpbus/listNisCorpBusVOByCorpIdAndCdSign?cdSign=0"
                         data-name="eqs_busType" data-biz-name="eqs_busType"
                         data-valuefield="busId" data-textfield="busTypeName" data-inputvalue="inputvalue"
                         data-search="true"></div>
                </div>
            </td>
        ##金额
            <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_amt"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_amt"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20"
                           placeholder="#springMessage('table.nisBillhead.payMoney')">
                </div>
            </td>
        </tr>
        <tr>
        ##本方账号
            <td class="textRight">#springMessage('table.btBankAccDtl.bankAcc')</td>
            <td>
                <input type="text" name="likes_bankAcc"
                       autocomplete="off" class="layui-input bank"
                       placeholder="#springMessage('table.btBankAccDtl.bankAcc')">
            </td>
        ##对方账号
            <td class="textRight">#springMessage('table.btBankAccDtl.oppAccNo')</td>
            <td>
                <input type="text" name="likes_oppAccNo"
                       autocomplete="off" class="layui-input bank"
                       placeholder="#springMessage('table.btBankAccDtl.oppAccNo')">
            </td>
        ##对方账号名称
            <td class="textRight">#springMessage('table.btBankAccDtl.oppAccName')</td>
            <td>
                <input type="text" name="likes_oppAccName"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.btBankAccDtl.oppAccName')">
            </td>
        </tr>
        <tr>
        ##交易日期
            <td class="textRight">#springMessage('table.btNetChalk.transTime')</td>
            <td>
                <input type="text" name="ged_transTime" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_transTime">
                <span class="date-mid">~</span>
                <input type="text" name="led_transTime" class="layui-input bt-input-inline bt-biz-dateType"
                       id="led_transTime">
            </td>
            #if($!{flowStatus} == "pass")
                ##状态
                <td class="textRight">#springMessage('table.nisBillhead.status')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select"
                         data-group="nisReceivable.status" data-name="eqi_status" ></div>
                </td>
                ##审批时间
                <td class="textRight">#springMessage('bpm.model.assignTime')</td>
                <td>
                    <input type="text" name="ged_approveDate"
                           class="layui-input bt-input-inline bt-biz-dateType"
                           data-endid="led_approveDate" value="">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_approveDate"
                           class="layui-input bt-input-inline bt-biz-dateType"
                           id="led_approveDate">
                </td>
                <td></td>
                <td></td>
            #else
                <td colspan="4"></td>
            #end
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisReceivable.billNo')</th>
        <th>#springMessage('table.nisBillhead.corpId')</th>
        <th>#springMessage('table.nisBillhead.busType')</th>
        <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
        <th>#springMessage('table.btBankAccDtl.accName')</th>
        <th>#springMessage('table.btBankAccDtl.bankName')</th>
        <th>#springMessage('table.nisBillhead.curId')</th>
        <th>#springMessage('table.nisBillhead.payMoney')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
        <th>#springMessage('table.nisReceivable.oppBankCode')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccBank')</th>
        <th>#springMessage('table.btNetChalk.transTime')</th>
        <th>#springMessage('table.nisBillhead.status')</th>
        <th>#springMessage('bpm.model.assignTime')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
    #paymentWorkFlowScript()
<script src="${basePath}/static/modules/receivable/nisReceivableApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <!-- 系统参数 -->
    <input id="id" name="id" type="hidden" value="$!{nisReceivablePage.id}">
    <input id="billNo" name="billNo" type="hidden" value="$!{nisReceivablePage.billNo}">
    <input id="corpId" name="corpId" type="hidden" value="$!{nisReceivablePage.corpId}">
    <input id="busType" name="busType" type="hidden" value="$!{busType}">
    <div id="print">
        <table class="layui-table">
            <thead>
            <tr>
                <th colspan="4" style="text-align:center">#springMessage('table.choBankFinance.viewTitle')</th>
            </tr>
            </thead>
            <tbody>
            <tr>
            ##收款单号
                <td class="textRight" width="20%">#springMessage('table.nisReceivable.billNo')</td>
                <td width="30%">$!{nisReceivablePage.billNo}</td>
                <td class="textRight" width="20%">#springMessage('table.nisAllocationReq.createDate')</td>
                <td width="30%">$!date.format('yyyy-MM-dd',$!{nisReceivablePage.createDate})</td>
            </tr>
            <tr>
            ##单位
                <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                <td>$!{nisReceivablePage.corpName}</td>
            ##业务类别
                <td class="textRight" width="20%">#springMessage('table.nisBillhead.busType')</td>
                <td width="30%">$!{nisReceivablePage.busTypeName}</td>
            </tr>
            <tr>
            ##本方账号
                <td class="textRight" width="20%">#springMessage('table.btBankAccDtl.bankAcc')</td>
                <td width="30%">$!{nisReceivablePage.bankAcc}</td>
            ##对方账号
                <td class="textRight" width="20%">#springMessage('table.btBankAccDtl.oppAccNo')</td>
                <td width="30%">$!{nisReceivablePage.oppAccNo}</td>
            </tr>
            <tr>
            ##本方账户名称
                <td class="textRight" width="20%">#springMessage('table.btBankAccDtl.accName')</td>
                <td width="30%">$!{nisReceivablePage.accName}</td>
            ##对方账户名称
                <td class="textRight">#springMessage('table.btBankAccDtl.oppAccName')</td>
                <td width="30%">$!{nisReceivablePage.oppAccName}</td>
            </tr>
            <tr>
            ##本方开户行
                <td class="textRight">#springMessage('table.btBankAccDtl.bankName')</td>
                <td width="30%">$!{nisReceivablePage.bankName}</td>
            ##对方开户行
                <td class="textRight">#springMessage('table.btBankAccDtl.oppAccBank')</td>
                <td width="30%">$!{nisReceivablePage.oppBankCode} $!{nisReceivablePage.oppAccBank}</td>
            </tr>
            <tr>
            ##币别
                <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
                <td width="30%">$!{nisReceivablePage.curName}</td>
            ##交易日期
                <td class="textRight">#springMessage('table.btNetChalk.transTime')</td>
                <td width="30%">$!date.format('yyyy-MM-dd',$!{nisReceivablePage.transTime})</td>
            </tr>
            <tr>
            ##金额
                <td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
                <td width="30%">
                    $!number.formatNumeric($!{nisReceivablePage.amt})
                    <input type="hidden" data-name="" data-toUp="amtUp" autocomplete="off"
                           class="layui-input bt-biz-moneyType" value="$!{nisReceivablePage.amt}">
                </td>
                <td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
                <td style="padding-left:0px"><div id="amtUp"></div></td>
            </tr>
            <tr>
            ##备注
                <td class="textRight">#springMessage('table.fcCorpPool.rmk')</td>
                <td  width="30%">
                    $!{nisReceivablePage.rmk}
                </td>
                <td class="textRight"></td>
                <td></td>
            </tr>
        </table>
    </div>
    <!-- 日志 -->
    <div id="tagMsg"></div>
    <!-- 附件上传 -->
    <input id="attachmentId" name="attachmentId" type="hidden" value="$!{nisReceivablePage.attachmentId}">
    <div id="uploader" class="layui-input-inline" style="width:100%"></div>
    <p>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{nisReceivablePage.id}')">#springMessage('common.button.trackFlow')</button>
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/receivable/nisReceivable.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
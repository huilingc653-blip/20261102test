<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
    	<input id="opType" name="opType" type="hidden" value="query">
    	<input id="loginName" name="loginName" type="hidden" value="$shiro.getPrincipal().loginName">
        <div class="layui-collapse" lay-filter="collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title"></h2>
                <div class="layui-colla-content layui-show">
            <table class="layui-table">
                <tbody>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="ins_corpId"
                                 data-resource="netbank:netBankQuery:nisReceivable:query"
                                 data-scope="all"
                                 data-callback="bt.corpCallback"></div>
                        </div>
                    </td>
                    ##业务类别
                    <td class="textRight">#springMessage('table.nisBillhead.busType')</td>
                    <td>
                        <div class="layui-input-inline">
                            <select name="eqs_busType" id="busType">
                                <option value=""></option>
                            </select>
                        </div>
                    </td>
                    ##金额
                    <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_amt"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_amt"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                        </div>
                    </td>
                </tr>
                <tr>
                ##本方账号
                    <td class="textRight">#springMessage('table.btBankAccDtl.bankAcc')</td>
                    <td>
                        <input type="text" name="likes_bankAcc"
                               autocomplete="off" class="layui-input bank"
                               placeholder="#springMessage('table.btBankAccDtl.bankAcc')">
                    </td>
                ##对方账号
                    <td class="textRight">#springMessage('table.btBankAccDtl.oppAccNo')</td>
                    <td>
                        <input type="text" name="likes_oppAccNo"
                               autocomplete="off" class="layui-input bank"
                               placeholder="#springMessage('table.btBankAccDtl.oppAccNo')">
                    </td>
                ##对方账号名称
                    <td class="textRight">#springMessage('table.btBankAccDtl.oppAccName')</td>
                    <td>
                        <input type="text" name="likes_oppAccName"
                               autocomplete="off" class="layui-input"
                               placeholder="#springMessage('table.btBankAccDtl.oppAccName')">
                    </td>
                </tr>
                <tr>
                ##交易日期
                    <td class="textRight">#springMessage('table.btNetChalk.transTime')</td>
                    <td>
                        <input type="text" name="ged_transTime" class="layui-input bt-input-inline bt-biz-dateType"
                               data-endid="led_transTime">
                        <span class="date-mid">~</span>
                        <input type="text" name="led_transTime" class="layui-input bt-input-inline bt-biz-dateType"
                               id="led_transTime">
                    </td>
                ##状态
                    <td class="textRight">#springMessage('table.nisBillhead.status')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select"
                             data-group="nisReceivable.status" data-name="eqi_status" ></div>
                    </td>
                ##单据来源
                    <td class="textRight">#springMessage('table.nisBillhead.billFrom')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="nisReceivable.billFrom"
                             data-name="eqs_billFrom"></div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
        </div>
        </div>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisReceivable.billNo')</th>
        <th>#springMessage('table.nisBillhead.corpId')</th>
        <th>#springMessage('table.nisBillhead.busType')</th>
        <th>#springMessage('table.choBankFinance.billNo')</th>
        <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
        <th>#springMessage('table.btBankAccDtl.accName')</th>
        <th>#springMessage('table.btBankAccDtl.bankName')</th>
        <th>#springMessage('table.nisBillhead.curId')</th>
        <th>#springMessage('table.nisBillhead.payMoney')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
        <th>#springMessage('table.nisReceivable.oppBankCode')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccBank')</th>
        <th>#springMessage('table.btNetChalk.transTime')</th>
        <th>#springMessage('table.nisBillhead.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/receivable/nisReceivable.query.js?_btv=${resourceVersion}"></script>

#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>

<input id="id" name="id" type="hidden" value="$!{nisReceivablePage.id}">
<input id="attachmentId" name="attachmentId" type="hidden" value="$!{nisReceivablePage.attachmentId}">
<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell">
        #springMessage('table.nisReceivable.billNo')
        <span class="mui-badge mui-badge-inverted">
            $!{nisReceivablePage.billNo}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{nisReceivablePage.corpName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.busType')
        <span class="mui-badge mui-badge-inverted">
            $!{nisReceivablePage.busTypeName}
        </span>
    </li>
    ##本方账户
    <li class="mui-table-view-cell  mui-collapse keep-unfold">
        <a class="mui-navigate-right" href="#">
            #springMessage('table.btBankAccDtl.bankAcc')
            <span class="mui-badge mui-badge-inverted">
                $!{nisReceivablePage.bankAcc}
            </span>
        </a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('table.btBankAccDtl.accName')
                <span class="mui-badge mui-badge-inverted">
                    $!{nisReceivablePage.accName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.btBankAccDtl.bankName')
                <span class="mui-badge mui-badge-inverted">
                    $!{nisReceivablePage.bankName}
                </span>
            </li>
        </ul>
    </li>
##    对方账户
    <li class="mui-table-view-cell  mui-collapse keep-unfold">
        <a class="mui-navigate-right" href="#">
            #springMessage('table.btBankAccDtl.oppAccNo')
            <span class="mui-badge mui-badge-inverted">
                $!{nisReceivablePage.oppAccNo}
        </span>
        </a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('table.btBankAccDtl.oppAccName')
                <span class="mui-badge mui-badge-inverted">
                    $!{nisReceivablePage.oppAccName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.btBankAccDtl.oppAccBank')
                <span class="mui-badge mui-badge-inverted">
                    $!{nisReceivablePage.oppBankCode} $!{nisReceivablePage.oppAccBank}
                </span>
            </li>
        </ul>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.curId')
        <span class="mui-badge mui-badge-inverted">
            $!{nisReceivablePage.curName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btNetChalk.transTime')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{nisReceivablePage.transTime})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.payMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{nisReceivablePage.amt})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fcCorpPool.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{nisReceivablePage.rmk}
        </span>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
<script>
    window.onload=function () {
        var attachmentId = $("#attachmentId").val();
        setTimeout(function () {
            BTAppBridge.initAttachmentByGroupId && BTAppBridge.initAttachmentByGroupId(attachmentId);
        },100);
    }
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
 <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('table.nisAllocationReport.corpName')</td>
                <td class="rCode">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-name="corpId"
                             data-biz-name="corpId"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-tree-type="check"
                             data-defaultvalue="$!{corpId}"
                             data-resource="netbank:bankAcc:statistics:query"></div>
                    </div>
                </td>
                <td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
                <td class="rCode">
                    <div class="layui-input-inline">
                        <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/listFilter" data-method="get" data-defaultvalue="$!{bankTypeId}"
                             data-valuefield="id" data-textfield="typeName" data-name="bankTypeId" data-biz-name="bankTypeId" data-inputvalue="inputvalue" data-search="true"></div>
                    </div>
                </td>
                <td class="textRight">#springMessage('table.btBankAccApp.bankAcc')</td>
                <td class="rCode">
                    <input type="text" name="bankAcc" value="$!{bankAcc}"
                           autocomplete="off" class="bank layui-input" placeholder="#springMessage('table.btBankAccApp.bankAcc')">
                </td>
            </tr>
            <tr>
                ##账户状态
                <td class="textRight">
                    #springMessage('table.fcAcc.accState')
                </td>
                <td class="rCode">
                    <div class="bt-biz-dict" data-type="select" data-defaultvalue="$!{status}"
                         data-group="btBankAcc.accStatus" data-name="status"></div>
                </td>
                <td class="textRight">第三方平台账号</td>
                <td class="rCode">
                    <input type="text" name="bindingBankAcc" value="$!{bindingBankAcc}"
                           autocomplete="off" class="bank layui-input" placeholder="第三方账号">
                </td>
                <td class="textRight"> #springMessage('是否绑定第三方账号')  </td>
                <td class="rCode">
                    <div class="bt-biz-dict" data-type="select" data-defaultvalue="$!{isBindThreeAcc}"
                         data-group="sf_yn" data-name="isBindThreeAcc"></div>
                </td>
            </tr>
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="search">#springMessage(
                        'common.button.search')</button>
                    <button type="button" class="layui-btn layui-btn-primary" onClick="resetCode()">#springMessage(
                        'common.button.reset')</button>
                    <button class="layui-btn" lay-submit="" lay-filter="excel"  type="button">#springMessage('common.button.exports')</button>
                </td>
            </tr>
            </tbody>
        </table>
</form>
 <div id="tbl" style="width:100%;overflow:auto" >
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>区域</th>
        <th>省区</th>
        <th>单位名称</th>
        <th>股权属性</th>
        <th>账户组</th>
        <th>户名</th>
        <th>银行名称</th>
        <th>开户行名称</th>
        <th>账号</th>
        <th>省</th>
        <th>市</th>
        <th>是否已上银企</th>
        <th>账号用途</th>
        <th>账号状态</th>
        <th>关联第三方平台</th>
        <th>第三方账户组</th>
        <th>第三方平台账号</th>
        <th>实时余额</th>
        <th>绑定人名称</th>
        <th>绑定人手机</th>
        <th>登录密码</th>
        <th>支付密码</th>
    </tr>
    </thead>
    <tbody>
        #if($list)
            #foreach($AccountManagementStatisticsVO in $!{list})
            <tr>
                <td align="center">$!{AccountManagementStatisticsVO.areaName}</td>
                <td align="center">$!{AccountManagementStatisticsVO.sysProvinceName}</td>
                <td align="center">$!{AccountManagementStatisticsVO.corpName}</td>
                <td align="center">$!{AccountManagementStatisticsVO.equityMaintenanceName}</td>
                <td align="center">$!{AccountManagementStatisticsVO.fcAccGroupName}</td>
                <td align="center">$!{AccountManagementStatisticsVO.accName}</td>
                <td align="center">$!{AccountManagementStatisticsVO.bankTypeName}</td>
                <td align="center">$!{AccountManagementStatisticsVO.bankName}</td>
                <td align="center">$!{AccountManagementStatisticsVO.bankAcc}</td>
                <td align="center">$!{AccountManagementStatisticsVO.provName}</td>
                <td align="center">$!{AccountManagementStatisticsVO.cityName}</td>
                <td align="center">$dictTag.get("sf_yn",$!{AccountManagementStatisticsVO.isOnline})</td>
                <td align="center">$!{AccountManagementStatisticsVO.accountPurpose}</td>
                #if($!{AccountManagementStatisticsVO.status}== -2)
                    <td align="center">已销户</td>
                #else
                    <td align="center">正常</td>
                #end
                <td align="center">$!{AccountManagementStatisticsVO.bindingNatureName}</td>
                <td align="center">$!{AccountManagementStatisticsVO.bindingAccGroupCode}</td>
                <td align="center">$!{AccountManagementStatisticsVO.bindingBankAcc}</td>
                #if($!{AccountManagementStatisticsVO.bindingBankAcc})
                    <td align="center">$number.formatNumeric($!{AccountManagementStatisticsVO.realTimeBal})</td>
                #else
                    <td align="center"></td>
                #end
                <td align="center">$!{AccountManagementStatisticsVO.bindingByName}</td>
                <td align="center">$!{AccountManagementStatisticsVO.bindingByMobile}</td>
                <td align="center">
                    #if($shiro.hasPermission("netbank:bankAcc:btBankAcc:binder"))
                        $!{AccountManagementStatisticsVO.loginPassword}
                    #else
                        #if($!{AccountManagementStatisticsVO.loginPassword})
                            ******
                        #end
                    #end
                </td>
                <td align="center">
                    #if($shiro.hasPermission("netbank:bankAcc:btBankAcc:binder"))
                        $!{AccountManagementStatisticsVO.payPassword}
                    #else
                        #if($!{AccountManagementStatisticsVO.payPassword})
                            ******
                        #end
                    #end
                </td>
            </tr>
            #end
        #end
    </tbody>
</table>
 </div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/accountManagementStatistics.list.js?_btv=${resourceVersion}"></script>
</html>

    function callToCurr(data){
        if(data.value =="1"){
            selectType.get("reducedCurId").attr({'data-disabled':false,'data-required':true});
            selectType.get("curId").attr({'data-disabled':true,'data-required':false});
        }else {
            selectType.get("reducedCurId").val("");
            selectType.get("reducedCurId").attr({'data-disabled':true,'data-required':false});
            selectType.get("curId").val("");
            selectType.get("curId").attr({'data-disabled':false,'data-required':true});
        }
        form.render();
        form.renderIcon();
        // checkConvertCurCallBack();
    }

    function clearCur(){
        selectType.get("reducedCurId").val("");
    }

    /**
     * 币种转换校验
     */
    function checkConvertCurCallBack() {
        // var origCur = selectType.get("curId").val();
        // if (isNotEmpty(origCur) && isNotEmpty(reducedCurId)) {
        var reducedCurId = selectType.get("reducedCurId").val();
        if (isNotEmpty(reducedCurId)) {
            $.ajax({
                url: basePath + "/report/deposit/balance/checkConvertCurId",
                type:"post",
                data:{
                    "isAllCur":"1",
                    // "origCurId": origCur,
                    "convertCurId": reducedCurId,
                    // "date": bt.date.format(new Date(), 'yyyy-mm-dd')
                    "date": $('input[name=date]').val(),
                },
                dataType: "json",
                success:function (data) {
                    if (!data.success) {
                        parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                        selectType.get("reducedCurId").val("");
                    }
                }
            });
        }
    }

    /**
     * 为空判断
     * @param stringData
     * @returns {boolean}
     */
    function isEmpty(stringData) {
        if (null == stringData || stringData == "" || stringData == undefined || stringData == " " || stringData == "null") {
            return true;
        } else {
            return false;
        }
    }
    /**
     * 非空判断
     * @param stringData
     * @returns {boolean}
     */
    function isNotEmpty(stringData) {
        return !isEmpty(stringData)
    }

    /** 选择对比周期时动态显示列表 begin*/
    function columnShow() {
        var one = 0, two = 0, three = 0, four = 0, five = 0;
        var selectCyclew = mulselect.get("contrastCycle").val();
        if (selectCyclew && selectCyclew[0].value) {
            for (var i = 0; i < selectCyclew.length; i++) {
                if (selectCyclew[i].value == '1') {
                    one = selectCyclew[i].value
                }
                if (selectCyclew[i].value == '2') {
                    two = selectCyclew[i].value
                }
                if (selectCyclew[i].value == '3') {
                    three = selectCyclew[i].value
                }
                if (selectCyclew[i].value == '4') {
                    four = selectCyclew[i].value
                }
                if (selectCyclew[i].value == '5') {
                    five = selectCyclew[i].value
                }
            }
        } else {
            one = 0;
            two = 0;
            three = 0;
            four = 0;
            five = 0;
        }
        showOrHidden(one, two, three, four, five);
    }

    function setColumnShow(index, flag) {
        var column = datatable.column(index);
        column.visible(flag);
    }

    function showOrHidden(one, two, three, four, five) {
        //上月末
        if (one > 0) {
            setColumnShow(2, true);//显示列
            setColumnShow(3, true);//显示列
            setColumnShow(4, true);//显示列
        } else {
            setColumnShow(2, false);//隐藏列
            setColumnShow(3, false);//隐藏列
            setColumnShow(4, false);//隐藏列
        }
        //上季度末
        if (two > 0) {
            setColumnShow(5, true);//显示列
            setColumnShow(6, true);//显示列
            setColumnShow(7, true);//显示列
        } else {
            setColumnShow(5, false);//隐藏列
            setColumnShow(6, false);//隐藏列
            setColumnShow(7, false);//隐藏列
        }
        //三个月前
        if (three > 0) {
            setColumnShow(8, true);//显示列
            setColumnShow(9, true);//显示列
            setColumnShow(10, true);//显示列
        } else {
            setColumnShow(8, false);//隐藏列
            setColumnShow(9, false);//隐藏列
            setColumnShow(10, false);//隐藏列
        }
        //上年同期
        if (four > 0) {
            setColumnShow(11, true);//显示列
            setColumnShow(12, true);//显示列
            setColumnShow(13, true);//显示列
        } else {
            setColumnShow(11, false);//隐藏列
            setColumnShow(12, false);//隐藏列
            setColumnShow(13, false);//隐藏列
        }
        //年初
        if (five > 0) {
            setColumnShow(14, true);//显示列
            setColumnShow(15, true);//显示列
            setColumnShow(16, true);//显示列
        } else {
            setColumnShow(14, false);//隐藏列
            setColumnShow(15, false);//隐藏列
            setColumnShow(16, false);//隐藏列
        }
    }

    /** 选择对比周期时动态显示列表 end*/
    function viewDtl(el) {
        var bankList = layui.jquery('#appTable').DataTable().row(layui.jquery(el).data('row')).data().bankLinkShow;
        var innerList = layui.jquery('#appTable').DataTable().row(layui.jquery(el).data('row')).data().innerLinkShow;
        let moneyUnit = $("select[name=moneyUnit]").val();
        let changeCur = dicts.get("changeCur").val();
        let curId = $("select[name=curId]").val();
        let date = $("#statDate").val();
        let reducedCurId = selectType.get("reducedCurId").val();
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + '/report/deposit/balance/detail?bankList=' + bankList + '&innerList=' + innerList +
                    '&moneyUnit=' + moneyUnit + '&changeCur=' + changeCur + '&curId=' + curId + '&date=' + date+ '&reducedCurId='+reducedCurId,
        });
    }
</script>
</html>
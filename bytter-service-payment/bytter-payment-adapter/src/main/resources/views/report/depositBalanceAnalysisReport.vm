                        money:true
                    },
                    {
                        colNum:'5',
                        dataName:'monthProportion',
                        expression:function(obj){ //自定义汇总内容 obj为各汇总列数据
                            if(obj['balance']==0 || obj['balance']==0.00){
                                return "0.00%";
                            }
                            return  ((moneyFun.toNumber(obj['monthDifferenceBalance'])/moneyFun.toNumber(obj['balance']))*100).toFixed(2)+"%";

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" lay-verify="isNatual" value="$!{cur}">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位名称
            <td class="textRight">#springMessage("table.choBankFinance.corpId")</td>
            <td class="corpName">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="corpId"
                         data-scope="all"
                         data-resource="deposit:balance:analysis:query"
                         data-required="true"></div>
                </div>
            </td>
            ##统计月份
            <td class="textRight">#springMessage("common.statistical.time")</td>
            <td>
                <input type="text" class="layui-input" id="statDate" name="date" lay-verify="required">
            </td>
            ##内部/银行存款
            <td class="textRight">#springMessage("table.eTransBill.depositType")</td>
            <td>
                <div class="layui-input-inline">
                    <select name="depositType" lay-filter="depositType">
                        <option value="0">#springMessage("common.placeholder.all")</option>
                        <option value="1" selected>#springMessage("table.capitalStock.balMoney")</option>
                        <option value="2">#springMessage("fundsBalanceStatistics.InternalDeposit")</option>
                    </select>
                </div>
            </td>
        </tr>
        <tr>
            ##币别
            <td class="textRight">#springMessage('table.ratBkrationRelief.curCode')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" id="selectTypeCurId" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name="curId" data-valueField="id" data-textField="curName" data-callback="clearCur"
                         data-required="true"  data-biz-name="curId"></div>
                </div>
            </td>
            ##是否折合币种
            <td class="textRight">#springMessage("common.isConvert.currency")</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="changeCur"
                     data-biz-name="changeCur" data-callback="callToCurr"
                     data-defaultvalue="0"></div>
            </td>
            ##维度统计
            <td class="textRight">#springMessage('table.report.statistical.dimensions')</td>
            <td>
                <div class="layui-input-inline">
                    <select name="statistical" lay-filter="changeStat">
                        <option value="0" selected>#springMessage('table.report.statistical.corp')</option>
                        <option value="1">#springMessage('table.report.statistical.banktype')</option>
                    </select>
                </div>
            </td>
        </tr>
        <tr>
            ##对比周期
            <td class="textRight">#springMessage("statisticsReport.IntegratedQuery.comparedCycle")</td>
            <td>
                <div class="layui-form" autocomplete="off">
                    <div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="mulselect" data-name="contrastCycle"
                             data-biz-name="contrastCycle" data-group="AB.COMPARED.CYCLE" data-defaultvalue="1,2,3,4,5"></div>
                    </div>
                </div>
            </td>
            ##金额单位
            <td class="textRight">#springMessage("table.choProductReq.moneyUnit")</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-required="true" data-type="select" data-group="cms.MoneyType"
                         data-biz-name="moneyUnit" data-name="moneyUnit" data-defaultvalue="1"></div>
                </div>
            </td>
            ##折合币种
            <td class="textRight">#springMessage("commom.converted.into.currency")</td>
            <td>
                <div class="bt-biz-selectType"
                     data-biz-name="reducedCurId"
                     data-url="${basePath}/basic/business/btcurrency/json"
                     data-valuefield="id"
                     data-textfield="curName"
                     data-name="reducedCurId"
                     data-search="true"
                     data-disabled = "true"
                     data-callback="checkConvertCurCallBack"
                ></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button" id="tips">#springMessage(
                                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                    'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
        <th rowspan="2" id="projectName">#springMessage("table.nisPersonnelDetail.corpId")</th>
        <th rowspan="2">#springMessage("table.accountDTO.balance")</th>
        <th colspan="3">#springMessage("statisticsReport.IntegratedQuery.befMonthEnd")</th>
        <th colspan="3">#springMessage("statisticsReport.IntegratedQuery.befQuarterEnd")</th>
        <th colspan="3">#springMessage("statisticsReport.IntegratedQuery.befThreeMonth")</th>
        <th colspan="3">#springMessage("statisticsReport.IntegratedQuery.befYear")</th>
        <th colspan="3">#springMessage("statisticsReport.IntegratedQuery.yearEarly")</th>
    </tr>
    <tr>
        <th>#springMessage("table.accountDTO.balance")</th>
        <th>#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>
        <th>#springMessage("table.bisGatherPolicy.scale")</th>
        <th>#springMessage("table.accountDTO.balance")</th>
        <th>#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>
        <th>#springMessage("table.bisGatherPolicy.scale")</th>
        <th>#springMessage("table.accountDTO.balance")</th>
        <th>#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>
        <th>#springMessage("table.bisGatherPolicy.scale")</th>
        <th>#springMessage("table.accountDTO.balance")</th>
        <th>#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>
        <th>#springMessage("table.bisGatherPolicy.scale")</th>
        <th>#springMessage("table.accountDTO.balance")</th>
        <th>#springMessage("statisticsReport.IntegratedQuery.differenceBal")</th>
        <th>#springMessage("table.bisGatherPolicy.scale")</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>

            //         }
            //         msg += bt.lang('table.btCurrency.curExrate');
            //         if(flag){
            //             layer.msg(msg)
            //         }
            //     }
            // },
            summary: {
                pageSum: true,
                allSum: false,
                selectSum: false,
                sumList: [
                    {
                        colNum: '2',
                        dataName: 'balance',
                        money:true
                    },
                    {
                        colNum: '3',
                        dataName: 'monthBalance',
                        money:true
                    },
                    {
                        colNum: '4',

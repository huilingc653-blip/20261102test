<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
  <form id="searchForm" class="layui-form"> 
	<input type="hidden" name="type" id="type" value="3">
	<input type="hidden"  id="beginDates" value="${monthFirstDay}">
  	<input type="hidden"  id="rmbCur" value="$!{rmbCur.id}">
    <table class="layui-table">
		<tbody >
			<tr>
				<td class="textRight">#springMessage("netbanck.reporter.checktime")</td>
				 <td>
                    <input type="text" name="beginDate" class="layui-input bt-input-inline bt-biz-dateType" lay-verify="required"
                           data-endid="endDate" value="${monthFirstDay}" data-biz-name="beginDate">
                    <span class="date-mid">~</span>
                    <input type="text" name="endDate" class="layui-input bt-input-inline bt-biz-dateType" lay-verify="required" 
                           id="endDate" data-today="true" data-biz-name="endDate">
                </td>
			
				 <td class="textRight">#springMessage('table.accountDTO.bankName')</td>
                    <td>
					<div id="xz">
        			 	<div class="layui-inline">
        					<input class="layui-input" id="bankName" name="bankName" type="text" readonly="readonly"/>
        				</div>
        				<div class="layui-inline">
        					<button type="button" class="layui-btn bt-biz-bankInfo" data-callback="bankinfoCallback">#springMessage('common.button.select')</button>
        				</div> 
        			</div>
                    </td>
				 <td class="textRight">#springMessage('table.nisAllocationReport.curName')</td>
                <td>
                    <div class="layui-form-item">
                        <div class="layui-inline">
                    <div class="selectDemo bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name="curId" data-biz-name="curId" data-valueField="id" data-textField="curName" data-method="get"></div>
                        </div>
                    </div>
                </td>
				
			</tr>
			<tr>
				##是否折合币种
				<td class="textRight">#springMessage("common.isConvert.currency")</td>
				<td>
					<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="changeCur"
						 data-biz-name="changeCur" data-callback="callToCurr"
						 data-defaultvalue="0"></div>
				</td>
				##折合币种
				<td class="textRight">#springMessage("commom.converted.into.currency")</td>
				<td>
					<div class="bt-biz-selectType"
						 data-biz-name="reducedCurId"
						 data-url="${basePath}/basic/business/btcurrency/json"
						 data-valuefield="id"
						 data-textfield="curName"
						 data-name="reducedCurId"
						 data-search="true"
						 data-disabled = "true"
						 data-callback="checkConvertCurCallBack"
					></div>
				</td>
				##折算汇率类型
				<td class="textRight">#springMessage('table.fexForeign.report.convert.rateType')</td>
				<td>
					<div type="list" data-name="rateType" class="bt-biz-selectType" data-disabled = "true" data-name="rateType" data-biz-name="rateType"
						 data-url="${basePath}/basic/business/btratetype/json" data-valueField="id" data-textField="typeName" data-callback="checkConvertCurCallBack"></div>
				</td>
			</tr>
			<tr>
				##汇率日期
				<td class="textRight">#springMessage('report.fcExcrateAdjust.preTime')</td>
				<td>
					<input type="text" name="rateDate"  class="layui-input bt-input-inline bt-biz-dateType" data-callback="checkConvertCurCallBack"
						   data-endid="rateDate" data-biz-name="rateDate" data-today="true" readonly="readonly">
				</td>
			</tr>
			<tr>
              <td colspan="6" style="text-align:center;">
               <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage("common.button.search")</button>
			   <button type="reset" class="layui-btn layui-btn-primary">#springMessage("common.button.reset")</button>
			  </td>
			</tr>
        </tbody>
	</table>
  </form>
  <table  id="appTable" class="layui-table layui-form" style="width:100%;">
	<thead>
	 <tr>
	   <th>#springMessage("table.accountDTO.bankName")</th>
	   <th>#springMessage("table.btBankAcc.bankTypeId")</th>
	   <th>#springMessage("table.ratBkrationRelief.curCode")</th>
	   <th>#springMessage("table.accountSummary.beginning_balance")</th>
	   <th>#springMessage("table.repayee.transaction.number")</th>
	   <th>#springMessage("table.repayer.transaction.number")</th>
	   <th>#springMessage("table.fcAccbookDtlHis.debitMoney")</th>
	   <th>#springMessage("table.fcAccbookDtlHis.creditMoney")</th>
	   <th>#springMessage("table.accbook.endMoney")</th>
	    <th>#springMessage("table.accbook.rate")</th>
	 </tr>
	 </thead>
  </table>
 #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/banklistCheckAllocation.list.js?_btv=${resourceVersion}"></script>
</html>
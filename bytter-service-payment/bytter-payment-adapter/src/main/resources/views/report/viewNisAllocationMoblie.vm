<!DOCTYPE html>
<html>
<head>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <meta charset="utf-8">
    <title>资金调拨明细详情</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no,minimum-scale=1.0,maximum-scale=1.0">
    <link rel="stylesheet" href="$!{basePath}/static/plugins/frozen/css/frozenui.css" media="all"/>
    <style>
        .nis-body {
            background-color: #F5F5F5;
        }

        #tab {
            background-color: #F5F5F5;
            margin-top: 0.04rem;
        }

        #tab .nis-content-item {
            height: 78px;
            background-image: url("$!{basePath}/static/modules/images/nisbg.png");
            border-radius: 0.1rem;
            margin: 0.14rem 0.2rem;
            padding: 0 0.1rem;
            margin-bottom: 0;
            background-repeat: no-repeat;
            background-size: contain;
        }

        .nis-content-item-cur {
            height: 14px;
            font-size: 14px;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(51, 51, 51, 1);
            line-height: 14px;
            padding: 0.14rem 0;
        }

        .nis-content-item-corp {
            height: 14px;
            font-size: 14px;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(51, 51, 51, 1);
            line-height: 14px;
            padding: 0.14rem 0;
            text-align: right;
        }

        .nis-content-item-money {
            font-size: 20px;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(41, 136, 255, 1);
            line-height: 18px;
            padding-top: 0.06rem;
        }

            ##付款信息样式
        #tab .nis-content-info {
            background: rgba(255, 255, 255, 1);
            border-radius: 6px;
            margin: 0.1rem 0.2rem;
            padding: 0.04rem 0;
            position: relative;
        }

        .nis-content-info .nis-content-info-left {
            font-size: 14px;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(153, 153, 153, 1);
            line-height: 14px;
            padding: 0.08rem 0.1rem;
        }

        .nis-content-info .nis-content-info-right {
            min-height: 0.14rem;
            font-size: 14px;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(51, 51, 51, 1);
            line-height: 14px;
            padding: 0.08rem 0.1rem;
        }
        .nis-content-info-left .pay{
            width:3px;
            height:11px;
            background:rgba(76,140,254,1);
            border-radius:2px;
        }

        .nis-line{
            width:1px;
            height:0.1rem;
            background:rgba(76,140,254,1);
            border-radius:0.02rem;
            border: 1px solid rgba(76,140,254,1);
            overflow: hidden;
            position: absolute;
            top:0.125rem;
            left: -0.01rem;
        }
        .nis-line-yellow {
            background:#FFB056;
            border: 1px solid #FFB056;
        }
        .nis-line-green {
            background:#42DEA2;
            border: 1px solid #42DEA2;
        }
    </style>

</head>
<body class="nis-body">
<section id="tab">
    <div class="nis-content-item">
        <ul class="ui-row">
            <li class="ui-col ui-col-33">
                <div class="nis-content-item-cur">
                    金额（$!{info.curName}）
                </div>
            </li>
            <li class="ui-col ui-col-67">
                <div class="nis-content-item-corp">$!{info.corpName}
                </div>
            </li>
            <li class="ui-col ui-col-100">
                <div class="nis-content-item-money">
                    $!{info.payMoneyStr}
                </div>
            </li>

        </ul>
    </div>
    <div class="nis-content-info">
        <span class="nis-line"></span>
        <ul class="ui-row">
            <li class="ui-col ui-col-33">

                <div class="nis-content-info-left">付款账号</div>
            </li>
            <li class="ui-col ui-col-67">
                <div class="nis-content-info-right">
                    $!{info.payerAcc}
                </div>
            </li>
            <li class="ui-col ui-col-33">
                <div class="nis-content-info-left">付款户名</div>
            </li>
            <li class="ui-col ui-col-67">
                <div class="nis-content-info-right">
                    $!{info.payerAccName}
                </div>
            </li>
            <li class="ui-col ui-col-33">
                <div class="nis-content-info-left">付款开户行</div>
            </li>
            <li class="ui-col ui-col-67">
                <div class="nis-content-info-right">
                    $!{info.payerBank}
                </div>
            </li>
        </ul>
    </div>
    <div class="nis-content-info">
        <span class="nis-line nis-line-yellow"></span>
        <ul class="ui-row">
            <li class="ui-col ui-col-33">
                <div class="nis-content-info-left">收款账号</div>
            </li>
            <li class="ui-col ui-col-67">
                <div class="nis-content-info-right">
                    $!{info.payeeAcc}
                </div>
            </li>
            <li class="ui-col ui-col-33">
                <div class="nis-content-info-left">收款户名</div>
            </li>
            <li class="ui-col ui-col-67">
                <div class="nis-content-info-right">
                    $!{info.payeeAccName}
                </div>
            </li>
            <li class="ui-col ui-col-33">
                <div class="nis-content-info-left">收款开户行</div>
            </li>
            <li class="ui-col ui-col-67">
                <div class="nis-content-info-right">
                    $!{info.payerBank}
                </div>
            </li>
        </ul>
    </div>
    <div class="nis-content-info">
        <span class="nis-line nis-line-green"></span>
        <ul class="ui-row">
            <li class="ui-col ui-col-33">
                <div class="nis-content-info-left">业务类型</div>
            </li>
            <li class="ui-col ui-col-67">
                <div class="nis-content-info-right">
                    $!{info.voucherFromName}
                </div>
            </li>
            <li class="ui-col ui-col-33">
                <div class="nis-content-info-left">用途</div>
            </li>
            <li class="ui-col ui-col-67">
                <div class="nis-content-info-right">
                    $!{info.purpose}
                </div>
            </li>
            <li class="ui-col ui-col-33">
                <div class="nis-content-info-left">制单日期</div>
            </li>
            <li class="ui-col ui-col-67">
                <div class="nis-content-info-right">
                    $!{info.reqDateStr}
                </div>
            </li>
        </ul>
    </div>
    ##    #end
</section>
<!-- 注意：如果你直接复制所有代码到本地，上述js路径需要改成你本地的 -->
<script src="$!{basePath}/static/modules/lib/zepto.min.js"></script>
<script src="$!{basePath}/static/plugins/f2/f2.min.js"></script>
<!-- 注意：如果你直接复制所有代码到本地，上述js路径需要改成你本地的 -->
<script>

</script>

</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form id="searchForm" class="layui-form">
    <input type="hidden" id="corpType" value="$!{corpType}">
    <input type="hidden" id="rate" value="$!{rate}">
    <table class="layui-table">
        <tbody>

            <tr #if($!{corpType} != "0") style="display: none" #end>
                <td class="textRight">#springMessage('table.nisAllocationReport.netName')</td>
                <td width="40%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp" data-name="ins_netId" data-biz-type="net" data-type="selectTree"
                             data-scope="net" data-biz-name="ins_netId"
                             data-tree-type="check"
                             data-checkkboxtype='{"Y":"s","N":"s"}'
                                                     data-group="corpGroup"
                                                     data-change="ins_corpId"
                             data-resource="netbank:report:allocationSum:query"></div>

                    </div>
                </td>
                <td class="textRight">#springMessage('table.nisAllocationReport.corpName')</td>
                <td width="40%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp" data-name="ins_corpId" data-biz-type="corp" data-type="selectTree"
                             data-tree-type="check" data-biz-name="ins_corpId"
                             data-checkkboxtype='{"Y":"s","N":"s"}'
                                                    data-group="corpGroup"
                             data-resource="netbank:report:allocationSum:query"
                             data-tips="#springMessage('common.placeholder.select')#springMessage(
                                 'table.fcAcc.netId')"></div>
                    </div>
                </td>
            </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReport.curName')</td>
            <td width="40%">
                <div class="layui-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name="ins_curId" data-biz-name="ins_curId" data-valueField="id" data-method="get"
                         data-textField="curName" data-callback="curCallBack"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReport.reqDate')</td>
            <td width="40%">
                <input type="text" class="layui-input bt-input-inline bt-biz-dateType" name="ged_reqDate"
                       data-biz-name="ged_reqDate" data-endid="led_reqDate"
                       value="$!date.format('yyyy-MM-dd',$!dateTag.getMonthStartTime())">
                <span class="date-mid">~</span>
                <input type="text" class="layui-input bt-input-inline bt-biz-dateType" name="led_reqDate"
                       data-biz-name="led_reqDate" id="led_reqDate"
                       value="$!date.format('yyyy-MM-dd',$!dateTag.getMonthEndTime())">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button type="button" class="layui-btn" lay-submit="" lay-filter="search">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form dark-layui-table" style="width:100%;">
    <thead>
    <tr>
        <th class="textRight">#springMessage('table.nisAllocationReport.reqDate')</th>
        <th id="reqDateText" colspan="4"></th>
        <th class="textLeft">#springMessage('table.choBankFinance.corpId'): #springMessage('config.choBank.moneyUnit')</th>
    </tr>
    <tr>
        <th>#springMessage('table.nisAllocationReport.corpName')</th>
        <th>#springMessage('table.nisAllocationReport.curName')</th>
        <th>#springMessage('table.nisAllocationReport.up')</th>
        <th>#springMessage('table.nisAllocationReport.down')</th>
        <th>#springMessage('table.nisAllocationReport.ask')</th>
        <th>#springMessage('table.nisAllocationReport.turn')</th>
    </tr>
    </thead>
</table>
<div id="chartSum" style="width:100%;height:500px;"></div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
##<script type="text/javascript" src="${basePath}/report/allocation/allocationBar.js" charset="utf-8"></script>
<script src="${basePath}/static/modules/allocation/nisAllocationBar.report.js?_btv=${resourceVersion}"></script>
</html>

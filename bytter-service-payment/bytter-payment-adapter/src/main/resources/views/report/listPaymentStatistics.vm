<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
 <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('table.nisAllocationReport.corpName')</td>
                <td class="rCode">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-name="corpId"
                             data-biz-name="corpId"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-tree-type="check"
                             data-defaultvalue="$!{corpId}"
                             data-resource="month:fund:allocation:collect:report:query"></div>
                    </div>
                </td>
                <td class="textRight">#springMessage('查询时间')</td>
                <td class="rCode">
                    <div class="layui-inline">
                        <input type="text" name="beginDate" class="layui-input bt-biz-dateType"
                               id="beginDate"
                               data-endid="endDate" value="$!{beginDate}"
                               data-type="month" data-biz-name="beginDate">
                    </div>
                    <div class="layui-inline">
                        <span class="date-mid">~</span>
                    </div>
                    <div class="layui-inline">
                        <input type="text" name="endDate" class="layui-input bt-biz-dateType" id="endDate"
                               data-type="month" data-biz-name="endDate" value="$!{endDate}">
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="search">#springMessage(
                        'common.button.search')</button>
                    <button type="button" class="layui-btn layui-btn-primary" onClick="resetCode()">#springMessage(
                        'common.button.reset')</button>
                    <button class="layui-btn" lay-submit="" lay-filter="excel"  type="button">#springMessage('common.button.exports')</button>
                </td>
            </tr>
            </tbody>
        </table>
</form>
 <div id="tbl" style="width:100%;overflow:auto" >
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        #if($list)
            #foreach($title in $!{titleList})
                <th>$title</th>
            #end
        #end
    </tr>
    </thead>
    <tbody>
        #if($list)
            #foreach($paymentStatisticsVO in $!{list})
            <tr #if($!{paymentStatisticsVO.isSum} == '1') style="background-color: skyblue" #end>
                <td align="center">$!{paymentStatisticsVO.areaName}</td>
                <td align="center">$!{paymentStatisticsVO.provinceName}</td>
                <td align="center">$!{paymentStatisticsVO.corpName}</td>
                #foreach($count in $!{paymentStatisticsVO.dataList})
                    <td align="center">$count</td>
                #end
            </tr>
            #end
        #end
    </tbody>
</table>
 </div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/paymentStatistics.list.js?_btv=${resourceVersion}"></script>
</html>
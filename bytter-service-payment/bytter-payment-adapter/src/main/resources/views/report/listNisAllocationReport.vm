<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
 <form id="searchForm" class="layui-form input150-container">
    #if($!{viewType} != "open")
        <table class="layui-table">
            <tbody>
            <tr>
            ##业务类型
                <td class="textRight">#springMessage('table.nisAllocationReport.voucherFrom')</td>
                <td>
                    #if($!{corpType} == "1")
                        <div class="bt-biz-dict" data-type="select" data-group="nisAllocationReport.voucherFrom"
                             data-displayData="3,4,6" data-name="eqs_voucherFrom"></div>
                    #else
                        <div class="bt-biz-dict" data-type="select" data-group="nisAllocationReport.voucherFrom"
                             data-filterData="1,9,10,11" data-name="eqs_voucherFrom"></div>
                    #end
                </td>
            ##申请日期
                <td class="textRight">#springMessage('table.nisAllocationReport.reqDate')</td>
                <td>
                    <input type="text" name="ged_reqDate" class="layui-input bt-input-inline bt-biz-dateType"
                           data-endid="led_reqDate">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_reqDate" class="layui-input bt-input-inline bt-biz-dateType"
                           id="led_reqDate">
                </td>
                <td class="textRight">#springMessage('table.nisAllocationReport.corpName')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp" data-name="ins_corpId" data-biz-type="corp" data-type="selectTree"
                             data-tree-type="check"
                             data-checkkboxtype='{"Y":"s","N":"s"}'
                             data-resource="netbank:report:allocation:query"></div>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.nisAllocationReport.curName')</td>
                <td>
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name="eqs_curId" data-valueField="id" data-textField="curName"></div>
                </td>
            ##金额
                <td class="textRight">#springMessage('table.nisAllocationReport.payMoney')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" name="geg_payMoney"
                               autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                               style="text-align:right" data-moneyendid="t20"
                               placeholder="#springMessage('table.bisExc.payMoney')">
                        <span class="date-mid">~</span>
                        <input type="text" name="leg_payMoney"
                               autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                               style="text-align:right" id="t20" placeholder="#springMessage('table.bisExc.payMoney')">
                    </div>
                </td>
                #if($!{corpType} == "0")
                    <td class="textRight">#springMessage('table.nisAllocationReport.oppCorpName')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp" data-name="ins_oppCorpId" data-biz-type="corp"
                                 data-type="selectTree" data-tree-type="check"
                                 data-checkkboxtype='{"Y":"s","N":"s"}'
                                 data-resource="netbank:report:allocation:query"></div>
                        </div>
                    </td>
                #else
                    <td colspan="2"></td>
                #end
            </tr>
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="search">#springMessage(
                        'common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
    #else
        <input type="hidden" name="eqs_corpId" value="$!{corpId}">
        <input type="hidden" name="ins_voucherFrom" value="$!{voucherFrom}">
        <input type="hidden" name="eqs_curId" value="$!{curId}">
        <input type="hidden" name="ged_reqDate" value="$!date.format('yyyy-MM-dd',$!{beginReqDate})">
        <input type="hidden" name="led_reqDate" value="$!date.format('yyyy-MM-dd',$!{endReqDate})">
    #end
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisAllocationReport.corpName')</th>
        <th>#springMessage('table.nisAllocationReport.voucherFrom')</th>
        <th>#springMessage('table.nisAllocationReport.reqDate')</th>
        <th>#springMessage('table.nisAllocationReport.curName')</th>
        <th>#springMessage('table.nisAllocationReport.payMoney')</th>
        <th>#springMessage('table.nisAllocationReport.purpose')</th>
        <th>#springMessage('table.nisAllocationReport.payerAcc')</th>
        <th>#springMessage('table.nisAllocationReport.payerAccName')</th>
        <th>#springMessage('table.nisAllocationReport.payerBank')</th>
        <th>#springMessage('table.nisAllocationReport.payeeAcc')</th>
        <th>#springMessage('table.nisAllocationReport.payeeAccName')</th>
        <th>#springMessage('table.nisAllocationReport.payeeBank')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/nisAllocation.report.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .row_bg_1 td{
            background: #cfd723!important;
        }
        .row_bg_2 td{
            background: #a4b0edfc!important;
        }
    </style>
</head>
<body>
 <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
                    <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-tree-type="check"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 data-scope="all"
                                 data-biz-name="corpId"
                                 data-resource="report.incomeAndExp.query"
                                 data-defaultvalue="$!{corpId}"></div>
                        </div>
                    </td>
                    <td class="textRight">#springMessage('查询时间')</td>
                    <td width="40%">
                        <input type="text" class="layui-input bt-input-inline bt-biz-dateType" name="ged_startDate"
                               data-biz-name="ged_startDate" data-endid="led_endDate"
                               value="$!date.format('yyyy-MM-dd',$!{startDate})">
                        <span class="date-mid">~</span>
                        <input type="text" class="layui-input bt-input-inline bt-biz-dateType" name="led_endDate"
                               data-biz-name="led_endDate" id="led_endDate"
                               value="$!date.format('yyyy-MM-dd',$!{endDate})">
                    </td>
                </tr>
                <tr>
                    <td class="textRight">显示方式</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="report.showType" data-name="showType"
                             data-biz-name="showType" data-defaultvalue="1"></div>
                    </td>
                    <td class="textRight">股权属性</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/sys/equityMaintenance/json" data-method="get"
                                 data-name="equityMaintenance" data-biz-name="equityMaintenance" data-valueField="equityCode" data-textField="equityName" ></div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" >#springMessage(
                        'common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
                       #* <button type="button" class="layui-btn" onclick="exportsExcel()">#springMessage(
                        'common.button.exports')</button>*#
                    </td>
                </tr>
            </tbody>
        </table>
</form>
 <div id="table-box">
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>区域</th>
        <th>法人公司(营运区)</th>
        <th>最高利率</th>
        <th>期初余额</th>
        <th>收入</th>
        <th>支出</th>
        <th>期末余额</th>
        <th>实际期末余额</th>
        <th>理财金额</th>
        <th>备注</th>
    </tr>
    </thead>
 #*   <tbody id="body">
        #foreach($vo in $list)
            <tr>
                <td style="text-align: center">$!{vo.regionName}</td>
                <td style="text-align: center">$!{vo.corpName}</td>
                #if($!{vo.level}==1||$!{vo.level}==2||$!{vo.level}==3||$!{vo.level}==4)
                    <td></td>
                #else
                    <td style="text-align: center">$!{vo.maxRate}%</td>
                #end
                <td style="text-align: center">$number.formatNumeric($!{vo.beginBal})</td>
                <td style="text-align: center">$number.formatNumeric($!{vo.income})</td>
                <td style="text-align: center">$number.formatNumeric($!{vo.expenditure})</td>
                <td style="text-align: center">$number.formatNumeric($!{vo.endBal})</td>
                <td style="text-align: center">$number.formatNumeric($!{vo.realEndBal})</td>
                <td style="text-align: center">$number.formatNumeric($!{vo.manageMoney})</td>
                <td style="text-align: center">$!{vo.remark}</td>
            </tr>
    #end
    </tbody>*#
</table>
 </div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/incomeAndExpenditureOfFunds.report.js?_btv=${resourceVersion}"></script>
</html>

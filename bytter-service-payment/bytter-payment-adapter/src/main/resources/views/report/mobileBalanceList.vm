<!DOCTYPE html>
#set($basePath=$springMacroRequestContext.contextPath)
<html style="height: 100%" lang="en">
<head>
	<meta name="viewport" content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0, user-scalable=no">
    <meta http-equiv="pragma" content="no-cache">
	<meta http-equiv="cache-control" content="no-cache">
	<meta http-equiv="expires" content="0">
    <title>#springMessage("fundsbalance.statistical.table")</title>##资金余额统计表
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css" />
    <link rel="stylesheet1" href="${basePath}/static/plugins/frozen/css/base.css" />
    <script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
    <script src="${basePath}/static/plugins/frozen/js/zepto.min.js"></script>
    <style>
        html,body{
            -webkit-overflow-scrolling : touch !important;
            overflow: auto !important;
            height: 100% !important;
        }
        .ui-select-group{
            position: absolute;
            right: 0;
        }
        .ui-dialog .ui-form-item{
            background: #fff;
            color: #000;
            border: none;
            font-size: 12px;
            line-height: 40px;
            height: 40px;
        }
        .ui-dialog .ui-form-item select{
            direction: rtl;
        }
        .bg {
            height:100px;
            background-color: #6a91f8;
            background-image: url("${basePath}/static/images/bg/bg_shade.png");
            background-position: bottom;
            background-repeat: no-repeat;
            background-size:auto;
        }
        .bg .ui-select:after{
            display: none;
        }
        #curId{
            border:1px solid #FFFFFF;
            border-radius:22px;
            width: 100px;
            color: #ffffff;
            font-size: 12px;
            height: 30px;
            direction: rtl;
            padding-right: 35px;
            appearance: none;
            -moz-appearance: none;
            -webkit-appearance: none;
        }
        .balanceEmpty{
            width: 100%;
            height: 20px;
            background-color: #dfe3ec;
        }
        .balanceSum{
            height:270px;
            width:100%;
        }
        .demo-item{
            width: 100%;
            height:290px;
            position: relative;
        }
        .no_data{
            width: 100%;
            height:270px;
            display: none;
            text-align: center;
            position:absolute;
            top:20px;
            left:0;
            background:#fff;
            z-index: 999;
        }
        .no_data img{
            margin-top: 40px;
        }
        .no_data label{
            display: block;
        }
    </style>
</head>
<body style="height: 100%;width:100%; margin: 0">
	<div class="ui-form">
        <input type="hidden" id="corpIdHidden" value="$!{corpId}">
		<form id="inputForm">
			<div class="bg">
                <div class="ui-form-item ui-flex-pack-center">
                    ##统计区间
                    <span><font size="2" color="white">#springMessage("table.statistical.date"):<span id="dateRange"></span></font></span><br/>
                </div>
       			<div class="ui-form-item">
                    <ul class="ui-row-flex">
                        <li class="ui-col ui-flex ui-flex-pack-center">
                            ##单位
                                <span><font size="2" color="white">#springMessage("table.fbsBudget.corpId")：</font> </span>
                                <span><font size="2" color="white" id="corpName"></font></span>
                        </li>
                        <li class="ui-col ui-flex ui-flex-pack-center">
                            <div class="ui-select">
                                <select id= "curId" name="curId">
                                    #foreach($curitem in ${curList})
                                        <option id="$curitem.id" value="$curitem.id">$curitem.curName</option>
                                    #end
                                </select>
                            </div>
                        </li>
                    </ul>
       			</div>
			</div>

            <div class="ui-dialog ui-dialog-function" id="dialog1">
                <div class="ui-dialog-cnt">
                    <div class="ui-dialog-bd">
                        <form action="">
                            <div class="ui-form-item ui-border-b">
                                <label>#springMessage("common.button.resetAcceptor")</label>##成员单位
                                <div class="ui-select-group">
                                    <div class="ui-select">
                                        <select id="corpId" name="corpId">
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="ui-form-item ui-border-b">
                                <label>#springMessage("table.fbsBudgetPeriod.beginDate")</label>##开始日期
                                <div class="ui-select-group">
                                    <input type="date" class="form-control" id="startDate" name="startDate" value="" max=""/>
                                </div>
                            </div>
                            <div class="ui-form-item">
                                <label>#springMessage("table.fbsBudgetPeriod.endDate")</label>##结束日期
                                <div class="ui-select-group">
                                    <input type="date" class="form-control" id="endDate" name="endDate" value="" max=""/>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="ui-dialog-ft">
                        <button type="button" id="buttonCancel">#springMessage("common.button.cancel")</button>##取消
                        <button type="button" id="buttonOK">#springMessage("table.bisAccBal.btn.confirm")</button>##确定
                    </div>
                </div>
            </div>
	</form>
	</div>

    <div class="demo-item">
        <div class="balanceEmpty"></div>
        <div id="chartPie" class="balanceSum">
        </div>
        <div id="chartPie_no_data" class="no_data">
            <img src="${basePath}/static/images/bg/no_data.png">
            <label>#springMessage("common.msg.temporarily_no_data")</label>##暂无数据
        </div>
    </div>
    <div class="demo-item">
        <div class="balanceEmpty"></div>
        <div id="chartPieBank" class="balanceSum">
        </div>
        <div id="chartPieBank_no_data" class="no_data">
            <img src="${basePath}/static/images/bg/no_data.png">
            <label>#springMessage("common.msg.temporarily_no_data")</label>##暂无数据
        </div>
    </div>
    <div class="demo-item">
        <div class="balanceEmpty"></div>
        <div id="chartBar" class="balanceSum">
        </div>
        <div id="chartBar_no_data" class="no_data">
            <img src="${basePath}/static/images/bg/no_data.png">
            <label>#springMessage("common.msg.temporarily_no_data")</label>##暂无数据
        </div>
    </div>
</body>
<script  type="text/javascript">

    var myChartPie = echarts.init(document.getElementById('chartPie'));
    var myChartPieBank = echarts.init(document.getElementById('chartPieBank'));
    var myChartBar= echarts.init(document.getElementById('chartBar'));

    $(function(){
        initCrop();
    	initDate();
    });

    $("#curId").change(function () {
        tu();
    });

    //弹框事件
    window.searchAction = function(){
        $("#dialog1").addClass("show");
    }
    //弹框确认按钮的点击事件
    $("#buttonOK").click(function(){
        $('.ui-dialog').removeClass("show");
        tu();
    });
    $('#buttonCancel').click(function(){
        $('.ui-dialog').removeClass("show");
    });

    /**
     * 初始化单位
     */
    function initCrop() {
        var url =  "/sys/corp/appTree";
        setTimeout(function () {
            BTAppBridge.post(url,{type:1},'postCallback');
        },100);
    };
    postCallback = function(data) {
        if (data){
            var html = '';
            var _corpId = $("#corpIdHidden").val();
            $.each(data,function (index, item) {
                if (item.id == _corpId) {
                    html += '<option value=' + item.id + ' selected>' + item.name + '</option>';
                }else{
                    html += '<option value=' + item.id + '>' + item.name + '</option>';
                }
            })
            $("#corpId").html(html);
        }
        tu();
    }

	function initDate() {
        //得到当前时间
        var date = new Date();
        //得到当前年份
        var sYear = date.getFullYear()-1;
        
        var eYear = date.getFullYear();
        
        //得到当前月份
        //注：
        //  1：js中获取Date中的month时，会比当前月份少一个月，所以这里需要先加一
        //  2: 判断当前月份是否小于10，如果小于，那么就在月份的前面加一个 '0' ， 如果大于，就显示当前月份
        var month = date.getMonth()+1 < 10 ? "0"+(date.getMonth()+1) : (date.getMonth()+1);
        //得到当前日子（多少号）
        var day = date.getDate() < 10 ? "0"+date.getDate() : date.getDate();
        $('#startDate').val(sYear+"-"+month+"-"+day);
        //设置input标签的max属性
        $("#startDate").attr("max",sYear+"-"+month+"-"+day);
        $("#endDate").val(eYear+"-"+month+"-"+day);
    }

    function tu(){
      
        var startDate = $("#startDate").val();
        var endDate = $("#endDate").val();
       
        var curId = $("#curId option").eq($("#curId").attr("selectedIndex")).val(); //获取选中的值
        var corpId = $("#corpId option").eq($("#corpId").attr("selectedIndex")).val(); //获取选中的值
        
        var corpName = $("#corpId option").eq($("#corpId").attr("selectedIndex")).text(); //获取选中的文本值
        
        var curName = $("#curId option").eq($("#curId").attr("selectedIndex")).text(); //获取选中的文本值
        
        var range = startDate + '~' + endDate;
        
       // $("#corpName").innerHtml(corpName);
        $("#corpName").html(corpName);
        $("#dateRange").html(range);
        initPie(curId,corpId,startDate,endDate,corpName,curName);
        initPieBank(curId,corpId,startDate,endDate,corpName);
        initBar(curId,corpId,startDate,endDate,corpName,curName);
    }

    function initPie(curId,corpId,startDate,endDate,corpName,curName) {
        myChartPie.showLoading();
        //通过Ajax获取数据
        var url =  "/report/fundsbalancestatistics/gatherPieList";
        setTimeout(function () {
            BTAppBridge.post(url,{"curId":curId,"corpId":corpId,"startDate":startDate,"endDate":endDate,"corpName":corpName,"curName":curName},'postPieData');
        },100);
    }
    postPieData = function (result) {
        var data = JSON.parse(result.series);
        showOrHideView(data[0].data,$("#chartPie"),$("#chartPie_no_data"));
        var option = initChartPie(result.legend,result.series,result.title);
        myChartPie.hideLoading();
        myChartPie.setOption(option, true);
        window.onresize = myChartPie.resize;
    }

    //根据请求返回结果,显示图标或者显示提示内容,data为图表数据,pic图表div的jquery对象,tip图表提示的jquery对象
    function showOrHideView(data,_pic,_tip) {
        if (!data){
            // _pic.hide();
            _tip.show();
        }else{
            if (data == '' || data == null){
                // _pic.hide();
                _tip.show();
            }else{
                // _pic.show();
                _tip.hide();
            }
        }
    }

    function initChartPie(legend,series,title) {
    	 option = {
    	            title: {
    	                // text: bt.lang('fundsBalanceStatistics.InternalDeposit'),//内部存款
    	                text: '内部存款',
                        subtext:title,
    	                x:'center',
                        show:true,
                        top:10,
                        textStyle:{
                            fontSize:14
                        }
    	            },
    	            tooltip : {
    	                trigger: 'item',
                        confine: true,
                        formatter:function(params) {
                            return params.seriesName + " <br/>" + params.name + " : " + mformat(params.data.value) + " (" + params.percent + "%)"},

                    },
    	            legend: {
    	                orient: 'vertical',
    	                right : '15%',
                        top: 'middle',
                        bottom:50,
    	                data: legend
    	            },
    	            series : JSON.parse(series),
    	 };
   		return option;
   }

    function initPieBank(curId,corpId,startDate,endDate,corpName) {
    	myChartPieBank.showLoading();
        //通过Ajax获取数据
        var url =  "/report/fundsbalancestatistics/gatherPieListBank";
        setTimeout(function () {
            BTAppBridge.post(url,{"curId":curId,"corpId":corpId,"startDate":startDate,"endDate":endDate,"corpName":corpName},'postPieBankData');
        },100);
    }
    postPieBankData = function (result) {
        // alert("result:" + JSON.stringify(result));
        var data = JSON.parse(result.series);
        showOrHideView(data[0].data,$("#chartPieBank"),$("#chartPieBank_no_data"));
        var option = initChartPieBank(result.legend,result.series,result.title);
        myChartPieBank.hideLoading();
        myChartPieBank.setOption(option, true);
        window.onresize = myChartPieBank.resize;
    }

    function initChartPieBank(legend,series,title) {
        option = {
            title: {
                // text:bt.lang('table.capitalStock.moeny'),//银行存款
                text: '银行存款',
                subtext:title,
                x:'center',
                top:10,
                textStyle:{
                    fontSize:14
                }
            },
            tooltip: {
                trigger: 'item',
                confine: true,
                formatter:function(params) {
                    return params.seriesName + " <br/>" + params.name + " : " + mformat(params.data.value) + " (" + params.percent + "%)"},

				axisPointer: {            // 坐标轴指示器，坐标轴触发有效
                       type: 'shadow'        // 默认为直线，可选为：'line' | 'shadow'
				},
            },
            legend: {
                data: legend,
                orient: 'vertical',
                right : '15%',
                bottom: '8%'
            },
             /* toolbox: {
                  show : true,
                  feature : {
                      mark : {show: true},
                      dataView : {show: true, readOnly: false},
                      restore : {show: true},
                      saveAsImage : {show: true}
                  }
              },*/
            calculable : false,
            series:  JSON.parse(series)
        };
        return option;
    }
    
     function initBar(curId,corpId,startDate,endDate,corpName,curName) {
    	 myChartBar.showLoading();
        //通过Ajax获取数据
        var url =  "/report/fundsbalancestatistics/gatherBarList";
         setTimeout(function () {
             BTAppBridge.post(url,{"curId":curId,"corpId":corpId,"startDate":startDate,"endDate":endDate,"corpName":corpName,"curName":curName},'postBarData');
         },100);
    }
    postBarData = function (result) {
        var data = JSON.parse(result.series);
        showOrHideView(data[0].data,$("#chartBar"),$("#chartBar_no_data"))
        var option = initChartBar(result.legend,result.series,result.title);
        myChartBar.hideLoading();
        myChartBar.setOption(option, true);
        window.onresize = myChartBar.resize;
    }
    
    function initChartBar(legend,series,title) {
    	option = {
        	color: ['#3398DB'],
       		tooltip : {
            trigger: 'axis',
            confine: true,
            axisPointer : {            // 坐标轴指示器，坐标轴触发有效
                type : 'shadow'        // 默认为直线，可选为：'line' | 'shadow'
            }
        },
        title: {
            // text: bt.lang('table.nisBillhead.billId'),//票据信息
            text: '票据信息',
            subtext:title,
            x:'center',
            top:10,
            textStyle:{
                fontSize:14
            }
        },
       	legend: {
            data: legend,
            top: 'middle',
            right : 'right',
            orient: 'horizontal'
        },
        grid: {
            left: '3%',
            right: '40%',
            bottom: '3%',
            containLabel: true
        },
        xAxis : [
            {
                type : 'category',
                data : ['票据'],
                axisTick: {
                    alignWithLabel: true
                }
            }
        ],
        yAxis : [
            {
                type : 'value'
            }
        ],
        series : JSON.parse(series)
    };
    	 return option;
   }

    var mformat = function(val){
        //金额转换 分->元 保留2位小数 并每隔3位用逗号分开 1,234.56
        var str = val.toFixed(2) + '';
        var intSum = str.substring(0,str.indexOf(".")).replace( /\B(?=(?:\d{3})+$)/g, ',' );//取到整数部分
        var dot = str.substring(str.length,str.indexOf("."))//取到小数部分搜索
        var ret = intSum + dot;
        return ret;


    };
</script>
</html>
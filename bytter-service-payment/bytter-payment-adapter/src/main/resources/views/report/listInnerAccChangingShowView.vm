<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<table id="appTable" class="layui-table layui-form" style="width:100%;">
  		<thead>
  			<tr>
  				<th colspan="12">#springMessage('更改')</th>
  			</tr>
   			<tr>
   				<th>#springMessage('table.innerAccChanging.acc')</th>##内部账户
        		<th>#springMessage('table.fbsBudget.net')</th>##网点
       			<th>#springMessage('table.fbsBudget.corpId')</th>##单位 				
        		<th>#springMessage('table.fbsBudgetDetail.curId')</th>##币别
       			<th>#springMessage('table.btBankAcc.accType')</th>##账户类别
       			<th>#springMessage('table.innerAccChanging.accName')</th>##内部账户名称
       			<th>#springMessage('table.fcAccuBalance.preSign')</th>##预提标志
       			<th>#springMessage('table.fcAcc.overdraftRate')</th>##透支利率
       			<th>#springMessage('table.fcAcc.accStartDate')</th>##账号启用日期
       			<th>#springMessage('table.fcInstrateAdjust.checkTime')</th>##复核通过日期
    		</tr>
  		</thead>
  		<br><br><br>
  		<tbody>
  		
  			#if($history && $history.size()>0)
  				#foreach($item in $history)	
  					<tr>
  						<td align="center">$!{item.blnctrAcc}</td>
  						<td align="center">$!{item.netName}</td>
  						<td align="center">$!{item.corpName}</td>
  						<td align="center">$!{item.curName}</td>
  						<td align="center">$dictTag.get("InnerAccount.AccType",$!{item.accType})</td>
  						<td align="center">$!{item.accName}</td>
  						<td align="center">$dictTag.get("Admin.PredrawSign",$!{item.predrawSign})</td>
  						<td align="right">$!{item.overdraftRate}%</td>
  						<td align="center">$!{item.accStartDate}</td>
  						<td align="center">$!{item.checkTime}</td>
  					</tr>
  				#end
  			#else
  				<tr>
					<td  colspan="12" align="center">暂无数据</td>
				</tr>
  			#end
  		</tbody>
  </table>
  
  <br> <br> <br> <br>
  
  
  <table id="appTable" class="layui-table layui-form" style="width:100%;">		
  		<thead>
  			<tr>
  				<th colspan="8">#springMessage('冻结/解冻')</th>
  			</tr>
   			<tr>
   				<th align="center">#springMessage('table.innerAccChanging.acc')</th>##内部账户##
        		<th align="center">#springMessage('table.choBankFinance.busType')</th>##业务类型
       			<th align="center">#springMessage('table.btBankAccFreeze.ufFlag')</th>##冻结(解冻)类型			
        		<th align="center">#springMessage('table.fcFreeze.freezeOrUnFreezeMoney')</th>##冻结/解冻金额
       			<th align="center">#springMessage('table.fcFreeze.beginDate')</th>##冻结开始时间
       			<th align="center">#springMessage('table.fcFreeze.endDate')</th>##冻结结束时间
       			<th align="center">#springMessage('table.fcFreeze.fwReason')</th>##冻结/解冻原因##
       			<th align="center">#springMessage('table.fcInstrateAdjust.checkTime')</th>##复核通过日期
       			
    		</tr>
  		</thead>
  		
  		<tbody>
  			#if($freeze && $freeze.size()>0)
  				#foreach($item in $freeze)	
  					<tr>
  						<td align="center">$!{item.blnctrAcc}</td>
  						<td align="center">$dictTag.get("innerAccount.freezeSign",$!{item.freezeSign})</td>
  						<td align="center">$dictTag.get("fcFreeze.freezeType",$!{item.freezeType})</td>
  						<td align="right">$number.formatNumeric($!{item.freezeMoney})</td>
  						<td align="center">$!{item.beginDate}</td>
  						<td align="center">$!{item.endDate}</td>
  						<td align="center">$!{item.freezeReason}</td>
  						<td align="center">$!{item.checkTime}</td>
  						
  					</tr>
  				#end
  			#else
  				<tr>
  					<td colspan="8" align="center">暂无数据</td>
  				</tr>
  			#end
  		</tbody>
	</table>

#parse("views/common/footer.vm")
</body>

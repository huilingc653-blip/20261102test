<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .row_bg_1 td{
            background: #cfd723!important;
        }
        .row_bg_2 td{
            background: #a4b0edfc!important;
        }
    </style>
</head>
<body>
 <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
                    <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-tree-type="check"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 data-scope="all"
                                 data-biz-name="corpId"
                                 data-resource="report.enterpriseBankGoOnline.query"
                                 data-defaultvalue="$!{corpId}"></div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search">#springMessage(
                        'common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('大区')</th>
        <th>#springMessage('营运区')</th>
        <th>#springMessage('合作银行数量(所有正在合作的银行)')</th>
        <th>#springMessage('总账户数')</th>
        <th>#springMessage('可上银企账户数量')</th>
        <th>#springMessage('已上银企账户数量')</th>
        <th>#springMessage('可上银企上线占比')</th>
        <th>#springMessage('银企上线进度')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/enterpriseBankGoOnline.report.js?_btv=${resourceVersion}"></script>
</html>

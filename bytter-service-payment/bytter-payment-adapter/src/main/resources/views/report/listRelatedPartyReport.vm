<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-tree-type="check"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-scope="all"
                         data-biz-name="ins_corpId"
                         data-resource="report:netbank:relatedParty:query"
                         ></div>
                </div>
            </td>
            <td class="textRight">#springMessage('本方账号')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="eqs_bankAcc" name="likes_bankAcc" lay-verify="tableData" data-biz-name="likes_bankAcc"
                           autocomplete="off" class="layui-input text" >
                    <table id="bankAccTable" class="hide">
                        <thead>
                        <tr>
                            <th>付款账号</th>
                            <th>付款账号名称</th>
                            <th>付款开户行名称</th>
                            <th>币别</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
            <td class="textRight">#springMessage('本方户名')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" class="layui-input bt-input-inline" name="likes_bankAccName"
                           data-biz-name="likes_bankAccName" >
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('对方账号')</td>
            <td>
                <input type="text" class="layui-input bt-input-inline" name="likes_oppAccNo"
                       data-biz-name="likes_oppAccNo" >
            </td>
            <td class="textRight">#springMessage('对方户名')</td>
            <td>
                <input type="text" class="layui-input bt-input-inline" name="likes_oppAccName"
                       data-biz-name="likes_oppAccName" >
            </td>
            <td class="textRight">#springMessage('银行类型')</td>
            <td>
                <div class="layui-inline">
                    <div class="selectDemo bt-biz-mulselectType" data-url="/basic/business/btbanktype/json"
                         data-name="ins_bankTypeId" data-valueField="id" data-textField="typeName" data-method="get"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('交易时间')</td>
            <td >
                <input type="text" class="layui-input bt-input-inline bt-biz-dateType" name="ged_transTime"
                       data-biz-name="ged_transTime" data-endid="endDate" value="$!{queryDate}">
                <span class="date-mid">~</span>
                <input type="text" class="layui-input bt-input-inline bt-biz-dateType" name="led_transTime"
                       data-biz-name="led_transTime" id="endDate" value="$!{queryDate}" >
            </td>

            <td class="textRight">#springMessage('金额')</td>
            <td >
                <div class="layui-inline">
                    <input type="text" name="geg_amt"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20" >
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_amt"
                           autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" id="t20"  >
                </div>
            </td>

            <td class="textRight">#springMessage('支付流程编号')</td>
            <td>
                <input type="text" class="layui-input bt-input-inline" name="likes_gxBillNo"
                       data-biz-name="likes_gxBillNo" >
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('摘要')</td>
            <td>
                <input type="text" class="layui-input bt-input-inline" name="likes_remark"
                       data-biz-name="likes_remark" >
            </td>
            <td class="textRight">#springMessage('用途')</td>
            <td>
                <input type="text" class="layui-input bt-input-inline" name="likes_purpose"
                       data-biz-name="likes_purpose" >
            </td>
            <td class="textRight">#springMessage('附言')</td>
            <td>
                <input type="text" class="layui-input bt-input-inline" name="likes_postscript"
                       data-biz-name="likes_postscript" >
            </td>

        </tr>
        <tr>
            <td class="textRight">#springMessage('流水ID')</td>
            <td>
                <input type="text" class="layui-input bt-input-inline" name="eqs_id"
                       data-biz-name="eqs_id" >
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" >#springMessage(
                        'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<div id="table-box">
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>序列</th>
            <th>单位名称</th>
            <th>本方账号</th>
            <th>本方户名</th>
            <th>本方账号开户行</th>
            <th>对方账号</th>
            <th>对方户名</th>
            <th>对方开户行</th>
            <th>交易时间</th>
            <th>收支方向</th>
            <th>金额</th>
            <th>支付流程编号</th>
            <th>发起员工姓名</th>
            <th>流水ID</th>
            <th>银行流水号</th>
            <th>摘要</th>
            <th>用途</th>
            <th>附言</th>
        </tr>
        </thead>
    </table>
</div>
    #parse("views/common/footer.vm")
</body>
<script >
    var datatable,corp,dateType,mulselect,dicts;
    bt.use(['form', 'datatable', 'dateType', 'mulselect' , 'selectType', 'moneyType', 'dicts', 'bank', 'corp','money','freezeTable','rateType','selectTable'], function () {
        $ = bt.jquery, form = bt.form();
        corp = bt.corp.init();
        bt.moneyType.init();
        dicts = bt.dicts.init();
        dateType = bt.dateType.init();
        bt.selectType.init();
        mulselect = bt.mulselect.init();

        var rateType = bt.rateType.getFun();

        var bankAccCol = [
            {data: "bankAcc",},
            {data: "accName",},
            {data: "bankName",},
            {data: "curName",}
        ];

        var bankAccInit = bt.selectTable.init({
            elem: "#bankAccTable",
            url: basePath + "/netbank/nisbillhead/getPayerAccQuery",
            urldata: {resource:'report:netbank:relatedParty:query'},
            scrollX: true,
            scrollY: "200px",
            searchInput: "#eqs_bankAcc",
            paging: true,
            columns: bankAccCol,
            clickCallback: function (data) {
                if (data) {
                    $('#eqs_bankAcc').val(data.bankAcc);
                } else {
                    $('input.text').val('');
                }
            }
        });

        var tableSummary = {
            pageSum: true,
            selectSum: true,
            groupColumn: 'cdSign',
            format: {
                decimal: 2
            },
            sumList: [
                {
                    colNum: '11',
                    dataName: 'amt'
                }
            ]
        };

        bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            checkbox: true,
            // paging:false,
            //ignoreButtons:['colvis','print','state'],// 忽略的表单默认按钮 state取消状态保存按钮
            buttons: [
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search",
            },
            ajax: {
                'url': basePath + "/netbank/relatedParty/reportDatatable"
            },
            columns: [
                {data: "indexNo", bSortable: false},
                {data: "corpName", bSortable: false},
                {data: "bankAcc", bSortable: true},
                {data: "bankAccName", bSortable: true},
                {data: "bankName", bSortable: false},
                {data: "oppAccNo", bSortable: true},
                {data: "oppAccName", bSortable: true},
                {data: "oppAccBank", bSortable: false},
                {data: "transTime", bSortable: false},
                {data: "cdSign", bSortable: false},
                {data: "amt", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.money.format(data);
                    }
                },
                {data: "gxBillNo", bSortable: false},
                {data: "createUserName", bSortable: false},
                {data: "id", bSortable: false},
                {data: "bankSerialNo", bSortable: false},
                {data: "remark", bSortable: false},
                {data: "purpose", bSortable: false},
                {data: "postscript", bSortable: false}
            ],
            summary: tableSummary
        });



    });


    function isEmpty(stringData) {
        if (null == stringData || stringData == "" || stringData == undefined || stringData == " " || stringData == "null") {
            return true;
        } else {
            return false;
        }
    }

</script>
</html>

        <input type="hidden" name="eqs_corpId" value="$!{dtlPage.corpId}">
        <input type="hidden" name="eqs_bankAcc" value="$!{dtlPage.bankAcc}">
        <input type="hidden" name="eqs_bankName" value="$!{dtlPage.bankName}">
        <input type="hidden" name="eqs_typeName" value="$!{dtlPage.typeName}">
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">

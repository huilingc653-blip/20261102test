<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <input type="hidden" name="bankList" id="bankList" value="$!{bankList}"/>
        <input type="hidden" name="innerList" id="innerList" value="$!{innerList}"/>
        <input type="hidden" name="moneyUnit" id="moneyUnit" value="$!{moneyUnit}"/>
        <input type="hidden" name="curId" id="curId" value="$!{curId}"/>
        <input type="hidden" name="changeCur" id="changeCur" value="$!{changeCur}"/>
        <input type="hidden" name="date" id="date" value="$!{date}"/>
        <input type="hidden" name="reducedCurId" id="reducedCurId" value="$!{reducedCurId}"/>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
        <th>#springMessage('table.fcOutAccbook.acc')</th>
        <th>#springMessage('table.choProduct.curId')</th>
        <th>#springMessage('table.accountDTO.balance')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form', 'datatable', 'corp', 'money', 'bank', 'selectType', 'rateType'], function () {
        $ = bt.jquery, form = bt.form();
        //生成列表
        bt.datatable.init({
            elem: "#appTable",
            checkbox: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath + '/report/deposit/balance/detailData',
            },
            columns: [
                {data: "corpName", bSortable: true, className: "center",},
                {data: "curName", bSortable: true, className: "center",},
                {
                    data: "balance", bSortable: true, className: "textRight",
                    render: function (data, type, row, meta) {
                        return bt.money.format(data);
                    }
                },
            ],
            summary: {
                pageSum: false,
                allSum: true,
                selectSum: true,
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '2',
                        dataName: 'balance'
                    },
                ]
            }
        });
    });
</script>
</html>

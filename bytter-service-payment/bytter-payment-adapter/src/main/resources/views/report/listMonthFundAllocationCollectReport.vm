<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
 <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('table.nisAllocationReport.corpName')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-name="ins_corpId"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-tree-type="check"
                             data-resource="month:fund:allocation:collect:report:query	"></div>
                    </div>
                </td>
                <td class="textRight">日期</td>
                <td width="20%">
                    <input type="text" name="queryDateBegin" class="layui-input bt-input-inline bt-biz-dateType"
                           data-endid="queryDateEnd" data-today="true">
                    <span class="date-mid">~</span>
                    <input type="text" name="queryDateEnd" class="layui-input bt-input-inline bt-biz-dateType"
                           id="queryDateEnd" data-today="true">
                </td>
            </tr>
            <tr>
                <td class="textRight">显示方式</td>
                <td>
                    <div class="bt-biz-dict" data-type="radio" data-group="report.showType" data-name="showType"
                         data-biz-name="showType" data-defaultvalue="1"></div>
                </td>
                <td class="textRight">股权属性</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-mulselectType" data-url="${basePath}/sys/equityMaintenance/json" data-method="get"
                             data-name="equityMaintenance" data-valueField="equityCode" data-textField="equityName" ></div>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="search">#springMessage(
                        'common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>区域</th>
        <th>营运区</th>
        <th>单位名称</th>
        <th>资金上划</th>
        <th>同比</th>
        <th>环比</th>
        <th>资金下拨</th>
        <th>同比</th>
        <th>环比</th>
        <th>资金留存</th>
        <th>留存率</th>
        <th>是否超额下拨</th>
        <th>账户收入</th>
        <th>账户支出</th>
        <th>备注</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/listMonthFundAllocationCollectReport.report.js?_btv=${resourceVersion}"></script>
</html>

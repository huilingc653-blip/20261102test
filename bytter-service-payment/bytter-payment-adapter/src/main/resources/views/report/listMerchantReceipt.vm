<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
  <form id="searchForm" class="layui-form"> 
##	<input type="hidden" name="type" id="type" value="2">
    <table class="layui-table">
		<tbody >
			<tr>
				<td class="textRight">#springMessage("table.fbsBudgetProcess.corpId")</td>
				<td >
				  <div class="layui-input-inline">
					 <div class="bt-biz-corp" data-name="ins_corpId" data-biz-type="corp" data-type="selectTree"
                             data-tree-type="check" data-biz-name="corpId"
                             data-checkkboxtype='{"Y":"s","N":"s"}'
							 data-resource="netbank:report:merchantreceipt:query"
                        ##                             data-group="corpGroup"
                            ></div>
				  
				  </div>
				</td>
				 <td class="textRight">#springMessage('table.reporter.merchant.name')</td>
                    <td>
				   <div class="layui-input-inline">
                      <input type="text"  name="likes_merchantName" id="merchantName"  class="layui-input"></div>
                      </div>
                    </td>
			</tr>
            <tr>
				<td class="textRight">#springMessage('table.nisAllocationReport.curName')</td>
				 <td>
					  <div class="layui-input-inline">
                    <div class="selectDemo bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name="ins_curId" data-biz-name="ins_curId"data-valueField="id" data-textField="curName" data-method="get"></div>
                      </div>
                </td>
			    <td class="textRight">#springMessage("table.fcAccuBalance.date")</td>
				 <td>
                    <input type="text" name="startDate" class="layui-input bt-input-inline bt-biz-dateType" data-biz-name="startDate"
                           data-endid="endDate" >
                    <span class="date-mid">~</span>
                    <input type="text" name="endDate" class="layui-input bt-input-inline bt-biz-dateType" data-biz-name="endDate"
                           id="endDate" >
                </td>
			</tr>
			<tr>
				##是否折合币种
				<td class="textRight">#springMessage("common.isConvert.currency")</td>
				<td>
					<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="changeCur"
						 data-biz-name="changeCur" data-callback="callToCurr"
						 data-defaultvalue="0"></div>
				</td>
				##折合币种
				<td class="textRight">#springMessage("commom.converted.into.currency")</td>
				<td>
					<div class="bt-biz-selectType"
						 data-biz-name="reducedCurId"
						 data-url="${basePath}/basic/business/btcurrency/json"
						 data-valuefield="id"
						 data-textfield="curName"
						 data-name="reducedCurId"
						 data-search="true"
						 data-disabled = "true"
						 data-callback="checkConvertCurCallBack"
					></div>
				</td>
			</tr>
			<tr>
				##折算汇率类型
				<td class="textRight">#springMessage('table.fexForeign.report.convert.rateType')</td>
				<td>
					<div type="list" data-name="rateType" class="bt-biz-selectType" data-disabled = "true" data-name="rateType" data-biz-name="rateType"
						 data-url="${basePath}/basic/business/btratetype/json" data-valueField="id" data-textField="typeName" data-callback="checkConvertCurCallBack"></div>
				</td>
				##汇率日期
				<td class="textRight">#springMessage('report.fcExcrateAdjust.preTime')</td>
				<td>
					<input type="text" name="rateDate"  class="layui-input bt-input-inline bt-biz-dateType" data-callback="checkConvertCurCallBack"
						   data-endid="rateDate" data-biz-name="rateDate" data-today="true" readonly="readonly">
				</td>
			</tr>
			<tr>
              <td colspan="6" style="text-align:center;">
               <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage("common.button.search")</button>
			   <button type="reset" class="layui-btn layui-btn-primary" id="reset">#springMessage("common.button.reset")</button>
			  </td>
			</tr>
        </tbody>
	</table>
  </form>
  <table  id="appTable" class="layui-table layui-form" style="width:100%;">
	<thead>
	 <tr>
	   <th>#springMessage("table.fbsBudgetProcess.corpId")</th>
	   <th>#springMessage("table.reporter.merchant.code")</th>
	   <th>#springMessage("table.reporter.merchant.name")</th>
	   <th>#springMessage("table.reporter.merchant.abbreviation")</th>
	   <th>#springMessage("table.nisAllocationReport.curName")</th>
	   <th>#springMessage("table.eBankBill.payMoney")</th>
	   <th>#springMessage("table.reporter.payNumber")</th>
	 </tr>
	 </thead>
  </table>
 #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/listMerchantReceipt.list.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="currentPage" value="1">
    <input type="hidden" id="count" value="1">
    <table class="layui-table">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-tree-type="check"
                             data-type="selectTree"
                             data-name="corpId"
                             data-scope="all"
                             data-biz-name="corpId"
                             data-defaultvalue="$!{corpId}"></div>
                    </div>
                </td>
            ##申请日期
                <td class="textRight">#springMessage('table.nisAllocationReq.createDate')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" name="gedApplyDate" data-type="date" data-biz-name="gedApplyDate"
                               class="layui-input bt-biz-dateType" data-endid="startDate" value="$!{gedApplyDate}">
                    </div>
                    <div class="layui-inline">~</div>
                    <div class="layui-inline">
                        <input type="text" name="ledApplyDate" data-type="date" data-biz-name="ledApplyDate"
                               class="layui-input bt-biz-dateType" id="startDate" value="$!{ledApplyDate}">
                    </div>
                </td>
            </tr>
            <tr>
            ##付款方式
                <td class="textRight">#springMessage('table.bisExc.voucherTypeId')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-biz-name="voucherType"
                         data-group="downAllocationAnalysis.voucherType" data-name="voucherType" data-defaultvalue="$!{voucherType}"></div>
                </td>
            ##金额区间
                <td class="textRight">#springMessage('table.accbookmoneySection')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" name="gegPayMoney"
                               autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                               style="text-align:right" data-moneyendid="t20"
                               data-biz-name="gegPayMoney"
                               placeholder="#springMessage('table.bisExc.payMoney')" value="$!{gegPayMoney}">
                        <span class="date-mid">~</span>
                        <input type="text" name="legPayMoney"
                               autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" data-biz-name="legPayMoney"
                               style="text-align:right" id="t20" placeholder="#springMessage('table.bisExc.payMoney')" value="$!{legPayMoney}">
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                        'common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
                    <button class="layui-btn" lay-submit lay-filter="excel">#springMessage('common.button.exports')</button>
                </td>
            </tr>
            </tbody>
        </table>
</form>
<table width="100%" align="center" id="search" class="layui-table">
    #*<tr id="bankTr">
    </tr>*#
</table>
<div id="tbl" style="width:100%;overflow:auto" >
<table width="100%" align="left" id="searchCorpId" style="margin-top: 15px;">
    <tr>
        <td align="right" width="5%">#springMessage('downAllocationAnalysis.corpName'):</td>
        <td align="left"><span id="downCorp" ></span></td>
    </tr>
</table>
</div>
<div style="overflow: auto;">
    <table id="appTable" class="layui-table layui-form dark-layui-table" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.bisGatherCmd.voucherNo')</th>
            <th>#springMessage('fcVoucherType.settlType')</th>
            <th>#springMessage('downAllocationAnalysis.corpName')</th>
            <th>#springMessage('table.nisAllocationReq.payerAcc')</th>
            <th>#springMessage('table.nisAllocationReq.payerInfo')</th>
            <th>#springMessage('table.nisAllocationReport.payerBank')</th>
            <th>#springMessage('table.nisAllocationReq.payeeAcc')</th>
            <th>#springMessage('table.nisAllocationReq.payeeInfo')</th>
            <th>#springMessage('table.nisAllocationReport.payeeBank')</th>
            <th>#springMessage('table.nisAllocationReport.curName')</th>
            <th>#springMessage('table.nisBillhead.payMoney')</th>
            <th>#springMessage('table.bisExc.cbsBillId')</th>
            <th>#springMessage('table.nisBillhead.purpose')</th>
            <th>#springMessage('table.nisBillhead.status')</th>
            <th>#springMessage('table.fcloanrepay.Info')</th>
        </tr>
        </thead>
        <tfoot>
        <tr id="sum">
            <td align="center">#springMessage('table.interet.sum')</td>
            <td colspan="9"></td>
            <td name="sumBalance" align="right"></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        </tfoot>
    </table>
    <div id="page" style="; bottom:0px;width:100%;margin-top: 1px;"></div>
</div>
    <table id="totalTable" class="layui-table layui-form" style="width:100%; margin-top: 6px">
        <tfoot>
        <tr id="total">
            <td align="right" width="40%">#springMessage('downAllocationAnalysis.total')</td>
            <td name="totalBal" align="left" width="60%"></td>
        </tr>
        </tfoot>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/downAllocationAnlysis.list.js?_btv=${resourceVersion}"></script>
</html>

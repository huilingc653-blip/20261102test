<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReport.corpName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-name="ins_corpId"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-resource="netbank:nisAllocationDaily:multiLeve:query"></div>
                </div>
            </td>
            <td class="textRight">日期</td>
            <td width="20%">
                <input type="text" name="queryDate" class="layui-input bt-input-inline bt-biz-dateType" data-biz-name="queryDate"
                       value="$!date.format('yyyy-MM-dd',$!queryDate)" lay-verify="required">
            </td>
        </tr>
        <tr>
            <td class="textRight">显示方式</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="report.showType" data-name="showType"
                     data-biz-name="showType" data-defaultvalue="1"></div>
            </td>
            <td class="textRight">股权属性</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/sys/equityMaintenance/json" data-method="get" data-valueField="equityCode" data-textField="equityName"
                         data-name="equityMaintenance" data-biz-name="equityMaintenance" data-displayData="0001,0002" ></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search">#springMessage(
                        'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>区域</th>
        <th>#springMessage('table.nisAllocationReport.corpName')</th>
        <th>最高利率</th>
        <th>最低利率</th>
        <th>平均利率</th>
        <th id="beforeDateBalance">$!date.format('MM',$!beforeDate)月$!date.format('dd',$!beforeDate)日银行余额</th>
        <th id="currentDateBalance">$!date.format('MM',$!queryDate)月$!date.format('dd',$!queryDate)日银行余额</th>
        <th id="currentUsableBalance">$!date.format('MM',$!queryDate)月$!date.format('dd',$!queryDate)日银行可用余额</th>
        <th id="currentFrozenBalance">$!date.format('MM',$!queryDate)月$!date.format('dd',$!queryDate)日银行冻结余额</th>
        <th>理财资金</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/multiLeveFundDailyReport.list.js?_btv=${resourceVersion}"></script>
</html>

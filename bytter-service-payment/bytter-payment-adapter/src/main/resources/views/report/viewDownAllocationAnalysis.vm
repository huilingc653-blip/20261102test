<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <table class="layui-table">
        <thead>
        <tr>
            <th colspan="6" style="text-align:center">#springMessage('downAllocationAnalysis.detailInformation')</th>
        </tr>
        <tr>
            <th colspan="6" style="text-align:center">#springMessage('table.nisAllocationReq.billNo')
                :$!{downAllocationAnalysisPage.billNo}</th>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td rowspan="4" width="10">#springMessage('table.nisAllocationReq.payeeInfo')</td>
            <td class="textRight">#springMessage('table.fcAcc.account')</td>
            <td>
            ##收款人账号
                    $!{downAllocationAnalysisPage.payeeAcc}
            </td>
            <td rowspan="4" width="10">#springMessage('table.nisAllocationReq.payerInfo')</td>
            <td class="textRight">#springMessage('table.fcAcc.account')</td>
            <td>
            ##付款人账号
                    $!{downAllocationAnalysisPage.payerAcc}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.payeeInfo')</td>
            <td>
            ##收款人
                    $!{downAllocationAnalysisPage.payeeAccName}
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReport.payerCorpId')</td>
            <td>
            ##付款人
                    $!{downAllocationAnalysisPage.payerAccName}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
            <td>
            ##收款人开户行
                     $!{downAllocationAnalysisPage.payeeBank}
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
            <td>
            ##付款人开户行
                     $!{downAllocationAnalysisPage.payerBank}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('fcVoucherType.settlType')</td>
            <td>
            ##结算类型
                    $!{downAllocationAnalysisPage.voucherName}
            </td>
            <td class="textRight">#springMessage('downAllocationAnalysis.corpName')</td>
            <td>
            ##下拨单位
                    $!{downAllocationAnalysisPage.corpName}
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.curId')</td>
            <td>
            ##币别
                    $!{downAllocationAnalysisPage.curName}
            </td>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.money')</td>
            <td>
            ##金额
                    $!number.formatNumeric($!{downAllocationAnalysisPage.payMoney})
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.purpose')</td>
            <td>
            ##用途
                    $!{downAllocationAnalysisPage.purpose}
            </td>
            <td class="textRight" colspan="2">#springMessage('table.nisBillhead.isQuick')</td>
            <td>
            ##是否加急
                    $dictTag.get("sf_yn",$!{downAllocationAnalysisPage.isQuick})
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisBillhead.wishPayday')</td>
            <td>
            ##期望支付日期
                    $!{downAllocationAnalysisPage.wishPayDay}
            </td>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.createDate')</td>
            <td>
            ##制单日期
                    $!date.format('yyyy-MM-dd',$!{downAllocationAnalysisPage.createDate})
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.createBy')</td>
            <td>
            ##制单人
                    $!{downAllocationAnalysisPage.createBy}
            </td>
            <td class="textRight" colspan="2"></td>
            <td>

            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
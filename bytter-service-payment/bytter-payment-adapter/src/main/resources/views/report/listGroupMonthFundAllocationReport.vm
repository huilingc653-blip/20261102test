<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
 <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('table.nisAllocationReport.corpName')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-name="ins_corpId"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-tree-type="check"
                             data-resource="group:month:fund:allocation:report:query"></div>
                    </div>
                </td>
                <td class="textRight">日期</td>
                <td width="20%">
                    <input type="text" name="queryDate" class="layui-input bt-input-inline bt-biz-dateType" data-biz-name="queryDate"
                    value="$!date.format('yyyy-MM',$!queryDate)" lay-verify="required" data-type="month">
                </td>
            </tr>
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="search">#springMessage(
                        'common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>划拨资金主体</th>
        <th>资金上划</th>
        <th>环比</th>
        <th>同比</th>
        <th>资金下拨</th>
        <th>环比</th>
        <th>同比</th>
        <th>留存</th>
        <th>环比</th>
        <th>同比</th>
        <th>留存率</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/listGroupMonthFundAllocationReport.report.js?_btv=${resourceVersion}"></script>
</html>

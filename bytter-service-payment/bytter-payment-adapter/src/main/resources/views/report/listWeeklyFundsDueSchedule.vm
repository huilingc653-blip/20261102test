<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ## 单位
                        <td width="8%" class="textRight">#springMessage('table.report.corpId')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-name="corpId"
                                     data-tree-type="check"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="ins_corpId"
                                     data-scope="all"
                                     id="corpId"
                                >
                                </div>
                            </div>
                        </td>
                        ##所属账户
                        <td class="textRight">#springMessage('table.fcBankBill.bankAcc')</td>
                        <td width="20%">
                            <div class="layui-input-inline">
                                <input type="text" id="likes_bankAcc" name="likes_bankAcc" data-name="likes_bankAcc" data-biz-name="likes_bankAcc" accountType="2,3"
                                       autocomplete="off"
                                       class="layui-input bt-biz-accountTable" data-callback="accountCallBack"/>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 公司类型
                        <td class="textRight">#springMessage('bill.accebill.corpType')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-selectType" data-url="${basePath}/sys/equityMaintenance/json" data-biz-name="ins_equityCode"
                                     data-name="ins_equityCode" data-valueField="equityCode" data-textField="equityName"></div>
                            </div>
                        </td>
                        ##到期日期
                        <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                        <td>
                         <div class="layui-inline">
                            <input type="text" name="ged_endDate" data-biz-name="ged_endDate" data-name="ged_endDate" class="layui-input bt-biz-dateType"
                                   data-endid="endDate" data-type="date" lay-verify="required" value="$!date.format('yyyy-MM-dd',$!{startDate})" />
                        </div>
                        ~
                        <div class="layui-inline">
                            <input type="text" name="led_endDate" data-biz-name="led_endDate"　data-name="led_endDate" class="layui-input bt-biz-dateType"
                            id="endDate" data-type="date" lay-verify="required" value="$!date.format('yyyy-MM-dd',$!{endDate})" />
                        </div>
                        </td>
                    </tr>
    <tr>
        <td colspan="4" style="text-align: center;">
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </div>
        </td>
    </tr>
    </tbody>
    </table>
    </div>
    </div>
    </div>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('bill.accebill.region')</th>
        <th>#springMessage('bill.accebill.province')</th>
        <th>#springMessage('bill.accebill.operatingArea')</th>
        <th>#springMessage('table.report.corpId')</th>
        <th>#springMessage('bill.accebill.corpType')</th>
        <th>#springMessage('table.accountDTO.bankName')</th>
        <th>#springMessage('table.fcBankBill.bankAcc')</th>
        <th>#springMessage('cms.report.loanMoney')</th>
        <th>#springMessage('bill.accebill.billMoney')</th>
        <th>#springMessage('table.abAccrecords.bailpercent')</th>
        <th>#springMessage('table.fcBond.bondmoney')</th>
        <th>#springMessage('table.abVoucherinfo.endDate')</th>
        <th>#springMessage('bill.accebill.applyRepayMoney')</th>
        <th>#springMessage('bill.accebill.fundsDisbursementDateOrAllocationDate')</th>
        <th>#springMessage('bill.accebill.applyName')</th>
        <th>#springMessage('common.message.remark')</th>
        <th style="hidden"></th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/listWeeklyFundDueSchedule.list.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/accebill/abCollapseElement.list.base.js?_btv=${resourceVersion}"></script>
</html>
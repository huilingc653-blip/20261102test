<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/fexTranApp/viewBreakStyle.vm")
</head>
<body>
    ##外汇买卖-----------资金收付

<form class="layui-form" method="post" id="myform">
    #if($!{tranDtlTmp.id})
        <input type="hidden" name="id" value="$!{tranDtlTmp.id}">
    #end
    ##    是否掉期交易
    <input type="hidden" name="isSwaptTran" id="isSwaptTran" value="$!{isSwaptTran}">
    ##    产品id
    <input type="hidden" name="proId" id="proId" value="$!{pro.id}">
    ##    单位id
    <input type="hidden" name="corpId" id="corpId" value="$!{corpId}">
    ##    外汇业务类型
    <input type="hidden" class="layui-input" name="fexBusType" id="fexBusType" value="$!{pro.fexBusType}">
    ##    外汇交易类型
    <input type="hidden" class="layui-input" name="fexTranType" id="fexTranType" value="$!{pro.fexTranType}">
    ##    交易类型
    <input type="hidden" class="layui-input" name="tranType" id="tranType" value="$!{tranType}">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            ##基础信息
            <h2 class="layui-colla-title">#springMessage('table.common.basicInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table view-break-table layui-form" style="margin: 0px;padding: 0px">
                    <tr>
                        ##外汇期权品种
                        <td class="textRight" width="20%">#springMessage('table.fexProduct.fexOption')</td>
                        <td width="30%">
                            <div class="layui-inline">
                                $dictTag.get("fexProduct.fexOption1",$!{pro.fexOption1})
                                $dictTag.get("fexProduct.fexOption2",$!{pro.fexOption2})&nbsp;
                                $dictTag.get("fexProduct.fexOption3",$!{pro.fexOption3})
                            </div>
                        </td>
                        ##外汇期权类型
                        <td class="textRight" width="20%">#springMessage('table.fexProduct.fexOptionType')</td>
                        <td width="30%">
                            $dictTag.get("fexProduct.fexOptionType",$!{pro.fexOptionType})
                        </td>
                    <tr>
                    <tr>
                        ##买卖方向
                        <td class="textRight">#springMessage('fex.tranApp2.businessDirection')</td>
                        <td>
                            $dictTag.get("fex.tranApp.busDirection",$!{tranDtl.busDirection})
                        </td>
                        ##涨跌方向
                        <td class="textRight">#springMessage('fex.tranApp2.upAndDownDirection')</td>
                        <td>
                            $dictTag.get("fex.tranApp2.updownDirection",$!{tranDtl.updownDirection})
                        </td>
                    </tr>
                    <tr>
                        ##交易日期
                        <td class="textRight">#springMessage('table.btNetChalk.transTime')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{tranDtl.tranDate})
                        </td>
                        ##到期日期
                        <td class="textRight">#springMessage('fex.tranApp.expirationDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{tranDtl.expiresDate})
                        </td>
                    </tr>
                    <tr>
                        ##结算日期
                        <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{tranDtl.settleDate})
                        </td>
                        <td></td>
                        <td></td>
                        ###自动计算买入金额
                        #*<td class="textRight"></td>
                        <td>
                            <input type="checkbox" name="autoCal" lay-filter = "autoCal" value="1"
                                #if(${tranDtlTmp} || $!{tranDtlTmp.autoCal})
                                   checked="checked"
                                #end
                                   title="#springMessage('fex.tranApp.autoCal')" lay-skin="primary">
                        </td>*#
                    </tr>
                    #if($!{pro.fexOption1} == 1)
                        #if($!{pro.fexOption2} == 1)
                            <tr>
                                ##平均期开始日期
                                <td class="textRight">#springMessage('fex.tranApp2.startDate')</td>
                                <td>
                                    #*<input type="text" name="avgBeginDate" class="layui-input bt-biz-dateType" data-type="date"
                                           value="$!{tranDtlTmp.avgBeginDate}" data-biz-name="avgBeginDate">*#
                                    $!{tranDtl.avgBeginDate}
                                </td>
                                ##            平均期结束日期
                                <td class="textRight">#springMessage('fex.tranApp2.endDate')</td>
                                <td>
                                    #*<input type="text" name="avgEndDate" class="layui-input bt-biz-dateType" data-type="date"
                                           value="$!{tranDtlTmp.avgEndDate}" data-biz-name="avgEndDate">*#
                                    $!{tranDtl.avgEndDate}
                                </td>
                            </tr>

                            <tr>
                                ##平均期天数
                                <td class="textRight">#springMessage('fex.tranApp2.avgDays')</td>
                                <td>
                                    #*<div class="layui-input-inline">
                                        <input type="text" data-name="avgDays" data-biz-name="avgDays" data-decimal="0"
                                               value="$!{tranDtlTmp.avgDays}" class="layui-input bt-biz-moneyType">
                                    </div>*#
                                    $!{tranDtl.avgDays}
                                </td>
                                <td class="textRight"></td>
                                <td>

                                </td>
                            </tr>
                        #else
                            <tr>
                                ##交易时障碍验证标准
                                <td class="textRight">#springMessage('table.fexProduct.validStandard')</td>
                                <td>
                                    #*<div class="bt-biz-dict" data-type="radio" data-group="fexProduct.validStandard"
                                        #if($!{tranDtlTmp.validStandard})
                                         data-defaultvalue="$!{tranDtlTmp.validStandard}"
                                        #else
                                         data-defaultvalue="$!{pro.validStandard}"
                                        #end
                                         data-name="validStandard" data-biz-name="validStandard"></div>*#
                                    $dictTag.get("fexProduct.validStandard",$!{tranDtl.validStandard})
                                </td>
                                #if($!{pro.fexOption2} == 2)
                                    ##期望障碍值
                                    <td class="textRight">#springMessage('fex.tranApp2.expectedVal')</td>
                                    <td>
                                        #*<input type="text" data-name="exceptLowVal" data-biz-name="exceptLowVal" data-decimal="4" lay-verify="number2|required"
                                               value="$!{tranDtlTmp.exceptLowVal}" class="layui-input bt-biz-moneyType">*#
                                        $!{tranDtl.exceptLowVal}
                                    </td>
                                #else
                                    <td></td>
                                    <td></td>
                                #end

                            </tr>

                            #if($!{pro.fexOption2} == 3)
                                <tr>
                                    ##期望低障碍值
                                    <td class="textRight">#springMessage('fex.tranApp2.expectedLow')</td>
                                    <td>
                                        #*<div class="layui-input-inline">
                                            <input type="text" data-name="exceptLowVal" data-biz-name="exceptLowVal" data-decimal="4" lay-verify="number2|required"
                                                   value="$!{tranDtlTmp.exceptLowVal}" class="layui-input bt-biz-moneyType">
                                        </div>*#
                                        $!{tranDtl.exceptLowVal}
                                    </td>
                                    ##期望高障碍值
                                    <td class="textRight">#springMessage('fex.tranApp2.expectedhigh')</td>
                                    <td>
                                        #*<input type="text" data-name="exceptHignVal" data-biz-name="exceptHignVal" data-decimal="4" lay-verify="number2|required"
                                               value="$!{tranDtlTmp.exceptHignVal}" class="layui-input bt-biz-moneyType">*#
                                        $!{tranDtl.exceptHignVal}
                                    </td>
                                </tr>
                            #end
                        #end
                    #end
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            ##交易金额信息
            <h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranAmountInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table view-break-table">
                    <tr>
                        ##交易货币对
                        <td class="textRight" width="20%">#springMessage('fex.tranApp.tranCurPair')</td>
                        <td width="30%">
                            #*<div class="layui-input-inline">
                                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrencypair/getValidCurrencyPair?" data-valuefield="id"
                                     data-textfield="currencyPair" data-required="true" data-name="tranCurId" data-biz-name="tranCurId"
                                    #if($!{tranDtlTmp.tranCurId})
                                     data-value="$!{tranDtlTmp.tranCurId}"
                                    #else
                                     data-value="$!{tranCurPair.id}"
                                    #end data-beforeInitResiveData="cacheCurrencyPairData"></div>
                            </div>*#
                            $!{tranDtl.currencyPair}
                        </td>
                        ##报价方式
                        <td class="textRight">#springMessage('fex.tranApp.quotationMethod')</td>
                        <td>
                            $!{tranDtl.currencyPair}
                            #*<input type="hidden" name="quotationMethod" id="quotationMethod">
                            <input class="layui-input" lay-verify="required" readonly name="quotationMethodName"></input>
                            <div class="layui-input-inline  layui-hide" id="quotationMethodMsg">交易货币对在外汇牌价查询的外汇牌价类型***中无报价，请先在外汇牌价查询中录入</div>*#
                           ## $!{tranDtl.quotationMethod1}/$!{tranDtl.quotationMethod2}
                        </td>
                    </tr>
                    <tr>
                        ##执行汇率
                        <td class="textRight">#springMessage('fex.tranApp.executeExchangeRate')</td>
                        <td>
                            #*<div class="layui-input-inline">
                                <input type="text" data-name="wishRate" style="display: inline" data-biz-name="wishRate" data-callback="calWishRate"
                                       value="$!{tranDtlTmp.wishRate}" lay-verify="required" data-decimal="6" class="layui-input bt-biz-moneyType">
                            </div>*#
                            $!{tranDtl.wishRate}
                        </td>
                        ##金额是否自动计算
                        <td class="textRight">#springMessage('fex.tranApp.isAutoCalculate')</td>
                        <td>
                            $dictTag.get("sf_yn",$!{tranDtl.isPaymentAmount})
                        </td>
                    </tr>
                    <tr>
                        ##买入币种
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.buyCurId')</td>
                        <td width="30%">
                            $!{tranDtl.buyCurEnCode}
                        </td>
                        ##卖出币种
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.sellCurId')</td>
                        <td width="30%">
                            $!{tranDtl.sellCurEnCode}
                        </td>
                    </tr>
                    <tr>
                        ##买入金额
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.buyMoney')</td>
                        <td width="30%">
                            #if($!{tranDtl.buyMoney})
                                $number.formatNumeric($!{tranDtl.buyMoney})
                            #end
                        </td>
                        ##卖出金额
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.sellMoney')</td>
                        <td width="30%">
                            #if($!{tranDtl.sellMoney})
                                $number.formatNumeric($!{tranDtl.sellMoney})
                            #end
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            ##期权费信息
            <h2 class="layui-colla-title">#springMessage('table.fexTranReq.premium.info')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table view-break-table">
                    <tr>
                        ##期权费点数
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.premiumPoint')</td>
                        <td>
                            #if($!{tranDtl.premiumPointMin})
                                $!{tranDtl.premiumPointMin}
                            #end
                            #if($!{tranDtl.premiumPointMax})
                                <span>~</span>
                                $!{tranDtl.premiumPointMax}
                            #end
                        </td>
                        ##期权费币种
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.premiumCur')</td>
                        <td width="30%">
                            $!{tranDtl.curEnCode}
                        </td>
                    </tr>
                    <tr>
                        ##期权费金额
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.premiumMoney')</td>
                        <td>
                            #if($!{tranDtl.premiumMoneyMin})
                                $number.formatNumeric($!{tranDtl.premiumMoneyMin})
                            #end
                            #if($!{tranDtl.premiumMoneyMax})
                                <span>~</span>
                                $number.formatNumeric($!{tranDtl.premiumMoneyMax})
                            #end
                        </td>
                        <td></td>
                        <td></td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            ##其他信息
            <h2 class="layui-colla-title">#springMessage('table.common.otherInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table view-break-table">
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
                        <td colspan="4">
                            #*<textarea lay-verify="strlength" name="rmk" data-maxlength = "50" class="layui-textarea">$!{tranDtlTmp.rmk}</textarea>*#
                            $!{tranDtl.rmk}
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('cms.loan.attachment')</td>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input type="hidden" name="attachmentId" id="gid" value="$!{tranDtlTmp.attachmentId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" style="text-align: center">
                            <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>
</body>
    #parse("views/common/footer.vm")
    <script>
        bt.use(["jquery", "form", "btUpload"], function () {
            $ = bt.jquery;
            form = bt.form();
            var gid = $("#gid").val();
            upload = bt.btUpload.init({
                elem: "#uploader",
                hasDelete: false,
                hasUpload: false,
                isExpand: true,
                auto: false,
                gid: gid
            });

            /**
             * 查看
             * @param id
             */
            view = function (id) {
                if (bt.navtab) {
                    bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/foreign/fextranreq/view/" + id);
                    return;
                }
                parent.layer.open({
                    type: 2,
                    area: ['850px', '530px'],
                    maxmin: true,
                    content: basePath + "/foreign/fextranreq/view/" + id
                });
            }
        });
        //关闭窗口
        function doClose() {
            if (bt.navtab) {
                bt.navtab.closeCurrent();
            }
        }
    </script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/fexTranApp/viewBreakStyle.vm")
</head>
<body>

##外汇买卖-----------掉期交易

<form class="layui-form" method="post" id="myform" style="margin: 0px;padding: 0px">
    <table class="layui-table view-break-table layui-form">
        <tr>
        ##                交易类型
            <td class="textRight" width="20%">#springMessage('table.foreign.tranType')</td>
            <td width="30%">
                <div class="layui-inline">
                    $dictTag.get("fex.tranApp.tranType",$!{tranDtl.tranType})
                </div>
            </td>
        ##                是否掉期交易
            <td class="textRight" width="20%"><div name="isSwaptTran" #if($!{tranDtl.tranType} == 4)style="display: none" #end>#springMessage('table.fexTranReq.isSwapTran')</div></td>
            <td width="30%">
                <div class="layui-inline" name="isSwaptTran" #if($!{tranDtl.tranType} == 4)style="display: none" #end>
                    $dictTag.get("sf_yn",$!{tranDtl.isSwaptTran})
                </div>
            </td>
        </tr>
        <tr>
        ##产品
            <td class="textRight">#springMessage('table.foreign.product')</td>
            <td>
                <div class="layui-inline">
                    $!{pro.proName}
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>
    </table>
    <div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
        <ul class="layui-tab-title">
        ##            近端交易
            <li class="layui-this">#springMessage('fex.tranApp.near')</li>
        ##    远端交易
            <li>#springMessage('fex.tranApp.remote')</li>
        </ul>
        <div class="layui-tab-content" style="height: 700px;">
            <div class="layui-tab-item layui-show" style="height: 100%">
            ##                近端交易
                <iframe id="swapIframe1"
                    #if($!{tranDtl.swapType} == 2)
                        src="$basePath/foreign/fexTranApp/viewSwap?id=$!{tranDtl.partnerId}"
                    #else
                        src="$basePath/foreign/fexTranApp/viewSwap?id=$!{tranDtl.id}"
                    #end
                        style="width: 100%;height: 100%;" frameborder="no" border="0" marginwidth="0" marginheight="0"></iframe>
            </div>
            <div class="layui-tab-item" style="height: 100%">
            ##                远端交易
                <iframe id="swapIframe2"
                    #if($!{tranDtl.swapType} == 1)
                        src="$basePath/foreign/fexTranApp/viewSwap?id=$!{tranDtl.partnerId}"
                    #else
                        src="$basePath/foreign/fexTranApp/viewSwap?id=$!{tranDtl.id}"
                    #end
                        style="width: 100%;height: 100%;" frameborder="no" border="0" marginwidth="0" marginheight="0"></iframe>
            </div>
        </div>
    </div>
    <div style="width: 100%;text-align: center">
        <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
    </div>
</form>
</body>
    #parse("views/common/footer.vm")
<script>
    var form, element;
    bt.use(["jquery", "form","element"], function () {
        $ = bt.jquery;
        form = bt.form();
        element = layui.element;
//监听提交
    });

    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }

</script>
</html>

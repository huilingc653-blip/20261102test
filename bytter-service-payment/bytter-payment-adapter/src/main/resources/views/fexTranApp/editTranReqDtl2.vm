<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body style="padding: 0;">

##外汇买卖-----------掉期交易

<form class="layui-form" method="post" id="myform" style="margin: 0px;padding: 0px">
    <div class="layui-tab layui-tab-brief" lay-filter="swap">
        <ul class="layui-tab-title">
##            近端交易
            <li class="layui-this" lay-id="1">#springMessage('fex.tranApp.near')</li>
##    远端交易
            <li lay-id="2">#springMessage('fex.tranApp.remote')</li>
        </ul>
        <div class="layui-tab-content" style="height: 780px;">
            <div class="layui-tab-item layui-show" style="height: 100%">
            ##                近端交易
                <iframe id="swapIframe1"
                    #if($!{tranDtl.swapType} == 1)
                        src="$basePath/foreign/fexTranApp/editSwap?swapType=1&tranType=$!{tranType}&proId=$!{pro.id}&corpId=$!{corpId}&isSwaptTran=$!{isSwaptTran}&id=$!{tranDtl.id}&appId=$!{appId}"
                    #else
                        src="$basePath/foreign/fexTranApp/editSwap?swapType=1&tranType=$!{tranType}&proId=$!{pro.id}&corpId=$!{corpId}&isSwaptTran=$!{isSwaptTran}&id=$!{tranDtl.partnerId}&appId=$!{appId}"
                    #end
                        style="width: 100%;height: 100%;" frameborder="no" border="0" marginwidth="0" marginheight="0"></iframe>
            </div>
            <div class="layui-tab-item" style="height: 100%">
            ##                远端交易
                <iframe id="swapIframe2"
                    #if($!{tranDtl.swapType} == 1)
                        src="$basePath/foreign/fexTranApp/editSwap?swapType=2&tranType=$!{tranType}&proId=$!{pro.id}&corpId=$!{corpId}&isSwaptTran=$!{isSwaptTran}&id=$!{tranDtl.partnerId}&appId=$!{appId}"
                    #else
                        src="$basePath/foreign/fexTranApp/editSwap?swapType=2&tranType=$!{tranType}&proId=$!{pro.id}&corpId=$!{corpId}&isSwaptTran=$!{isSwaptTran}&id=$!{tranDtl.id}&appId=$!{appId}"
                    #end
                        style="width: 100%;height: 100%;" frameborder="no" border="0" marginwidth="0" marginheight="0"></iframe>
            </div>
        </div>
    </div>
    <div style="width: 100%;text-align: center">
        <button class="layui-btn" lay-submit="" type="button" lay-filter="submit" value="11">#springMessage('保存')</button>
        <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
    </div>
</form>
</body>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/fexTranApp/editTranReqDtl2.js?_btv=${resourceVersion}"></script>
</html>

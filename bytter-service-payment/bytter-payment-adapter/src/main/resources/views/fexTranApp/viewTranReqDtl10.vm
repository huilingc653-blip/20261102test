<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/fexTranApp/viewBreakStyle.vm")
</head>
<body>
##外汇买卖-----------资金收付

<form class="layui-form" method="post" id="myform">
    <table class="layui-table view-break-table layui-form" style="margin: 0px;padding: 0px">
        <tr>
        ## 交易类型
            <td class="textRight"  width="20%" >#springMessage('table.foreign.tranType')</td>
            <td width="30%">
                $dictTag.get("fex.tranApp.tranType",$!{tranDtl.tranType})
            </td>
            ##模板
            <td class="textRight" width="20%"  >#springMessage('table.fexForeignReq.tranTemplate')</td>
            <td width="30%">
                <div class="layui-inline">
                    $!{tranDtl.templateName}
                </div>
            </td>
        <tr>
        <tr>

            ##交易号码
            <td class="textRight" width="20%"  >#springMessage('table.fexTranReq.billNo')</td>
            <td width="30%">
                <a class="" href="#" onclick="view('$!{tranDtl.tranReqId}')">$!{tranDtl.tranReqBillNo}</a>
            </td>
        </tr>
        <tr>
            ##收付方向
            <td class="textRight" width="20%"  >#springMessage('table.foreign.cdSign')</td>
            <td>
                <div class="layui-input-inline">
                    $dictTag.get("fexCorp.cdSign",$!{tranDtl.cdSign})
                </div>
            </td>
            ##汇款类型
            <td class="textRight" width="20%"  >#springMessage('table.fexForeignReq.remitType')</td>
            <td colspan="4">
                <div class="layui-input-inline">
                    $dictTag.get("fexForeignReq.remitType",$!{tranDtl.remitType})
                </div>
            </td>
        </tr>
        <tr>
            ##主体单位
            <td class="textRight" width="20%"  >#springMessage('nis.pool.fcCorpPool.poolCorp')</td>
            <td>$!{tranDtl.corpName}</td>
            ##交易对手
            <td class="textRight" width="20%">#springMessage('table.fexForeign.copt')</td>
            <td width="30%">$!{tranDtl.cotpName}</td>
        </tr>
        <tr>
            ##主体单位银行
            <td class="textRight"  width="20%"  >#springMessage('table.fexTranReq.corpBank')</td>
            <td width="30%">
                $!{tranDtl.corpBankName}
            </td>
            ##交易对手银行
            <td class="textRight"  >#springMessage('fex.tranApp.cotpBank')</td>
            <td>
                $!{tranDtl.fexCotpBankAccVO.bankName}
            </td>
        </tr>
        <tr>
            ##主体单位银行账户
            <td class="textRight"  width="20%">#springMessage('table.fexTranReq.corpBankAcc')</td>
              <td>     $!{tranDtl.corpBankAcc}</td>
            ##交易对手银行账户
            <td class="textRight" width="20%">#springMessage('table.fexForeign.cotpAcc')</td>
         <td>   $!{tranDtl.cotpBankAcc}</td>
        </tr>
        <tr>
            ##账户名称
            <td class="textRight">#springMessage('fex.mainCorpAccountName')</td>
            <td>
                $!{tranDtl.corpBankAccName}
            </td>
            ##交易对手(英文)
            <td class="textRight" width="20%">#springMessage('table.fexForeign.enCopt')</td>
            <td width="30%">
                $!{tranDtl.cotpNameEn}
            </td>
        </tr>
        <tr>
            ##主体单位账户币种
            <td class="textRight" width="20%">#springMessage('fex.mainCorpAccountBz')</td>
            <td width="30%">
                $!{tranDtl.corpAccEnglishCode}
            </td>
            ##交易对手账户币种
            <td class="textRight" width="20%">#springMessage('table.fexForeign.cotpCurNameTran')</td>
            <td width="30%">
                $!{tranDtl.cotpAccEnglishCode}
            </td>
        </tr>
        <tr>
            ## 支付类型
            <td class="textRight">#springMessage('ttpay.bussiness.payType')</td>
            <td>
                $!{tranDtl.bankPayType} #if($!{tranDtl.bankPayTypeName}) ($!{tranDtl.bankPayTypeName}) #end
            </td>

            ## 是否线下付款
            <td class="textRight">#springMessage('table.fexTranReq.isPayed')</td>
            <td>
                $dictTag.get("sf_yn",$!{tranDtl.isPayed})
            </td>
        </tr>

    </table>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table view-break-table">
                    <tr>
                        ##币种
                        <td class="textRight" width="20%" >#springMessage('table.ratBkrationRelief.curCode')</td>
                        <td width="30%">
                            $!{tranDtl.curEnCode}
                        </td>
                        ##金额
                        <td class="textRight" width="20%">#springMessage('table.fcUnionAccbook.sendMoney')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                $!number.formatNumeric($!{tranDtl.payMoney})
                            </div>
                        </td>

                    </tr>
                    <tr>
                        ##交易日期
                        <td class="textRight" width="20%">#springMessage('table.btNetChalk.transTime')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                $date.format("yyyy-MM-dd",$!{tranDtl.tranDate})
                            </div>
                        </td>
                        ##结算日期
                        <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                        <td>
                            <div class="layui-input-inline">
                                $date.format("yyyy-MM-dd",$!{tranDtl.settleDate})
                            </div>
                        </td>


                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
                        <td colspan="4">
                            $!{tranDtl.rmk}
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('cms.loan.attachment')</td>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input type="hidden" name="attachmentId" id="gid" value="$!{tranDtl.attachmentId}"/>
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" style="text-align: center">
                            <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
                        </td>
                    </tr>
                    </tr>
                </table>
            </div>
        </div>

    </div>
</form>
</body>
    #parse("views/common/footer.vm")
<script>

    bt.use(["jquery", "form", "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        var gid = $("#gid").val();
        upload = bt.btUpload.init({
            elem: "#uploader",
            hasDelete: false,
            hasUpload: false,
            isExpand: true,
            auto: false,
            gid: gid
        });

        /**
         * 查看
         * @param id
         */
        view = function (id) {
            if (bt.navtab) {
                bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/foreign/fextranreq/view/" + id);
                return;
            }
            parent.layer.open({
                type: 2,
                area: ['850px', '530px'],
                maxmin: true,
                content: basePath + "/foreign/fextranreq/view/" + id
            });
        }
    });
    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }
</script>
</html>

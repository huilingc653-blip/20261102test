<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-clear-template {
            position: absolute;
            right: -48px;
            top: 0;
        }
        .layui-clear-template .layui-btn {
            display: inline-block;
            height: 24px;
            border-radius: 0;
        }
    </style>
</head>
<body>
<form class="layui-form ignore-required-icon" method="post" id="myform">
    <input id="corpId" type="hidden" value="$!{corpId}">
    <input type="hidden" id="dtlTmpId" value="$!{tranDtlTmp.id}">
    <div style="padding: 0 10px;">
        <table class="layui-table layui-form">
            <tr>
                ##交易类型
                <td class="textRight" width="20%">
                    <span class="pl"><span class="required-icon">*</span></span>
                    #springMessage('table.fexBankAcc.tranType')
                </td>
                <td width="30%">
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-type="select" data-required="true"
                             data-group="fex.tranApp.tranType" data-displayData="4,7,8,9,2"
                             data-value="$!{tranDtlTmp.tranType}"
                             data-name="tranType" data-biz-name="tranType" data-callback="getPro"></div>
                    </div>
                </td>

                ##产品/配置模板（根据交易类型动态显示）
                <td class="textRight" width="20%">
                    <span id="proLabelpl" #if($!{tranDtlTmp.tranType}=='4') style="display: none;"#end>
                     <span class="pl"><span class="required-icon">*</span></span>
                     <span id="proLabel">#springMessage('table.fexBankAcc.proId')</span>
                    </span>
                    <span id="templateLabel" #if($!{tranDtlTmp.tranType}!='4') style="display: none;" #end>#springMessage('table.fexForeignReq.tranTemplate')</span>
                </td>
                <td width="30%">
                    <!-- 产品字段（默认显示） -->
                    <div id="proDiv"  #if($!{tranDtlTmp.tranType}=='4') style="display: none;"#end>
                        <div class="bt-biz-selectType" data-required="true" data-biz-name="proId"  data-valuefield="id" data-textfield="proName" data-name="proId"
                            #if($!{tranDtlTmp} && $!{tranDtlTmp.proId})
                             data-value="$!{tranDtlTmp.proId}"
                            #end
                             data-url="${basePath}/foreign/fexproduct/listProduct/$!{tranDtlTmp.tranType}"
                             data-callback="addTranDtl"></div>
                    </div>
                    <!-- 配置模板字段（收付交易时） -->
                    <div id="templateDiv"  #if($!{tranDtlTmp.tranType}!='4') style="display: none;" #end>

                        <div class="layui-input-inline">
                            <input type="text" id="templateName" lay-verify="required" readonly="readonly" class="layui-input"value=" $!{tranDtlTmp.templateName}">
                            <input type="hidden" id="templateId" name="templateId" value="$!{tranDtlTmp.templateId}">
                            <!-- 银行账户选择弹窗按钮 -->
                            <div class="bt-div-search" style="top:15%;right: 0;">
                                <button id="templateBtn" type="button" title="#springMessage('common.button.select')">
                                    <i class="layui-icon">&#xe615;</i>
                                </button>
                            </div>
                            <div class="layui-clear-template">
                                <button type="button" class="layui-btn">清空</button>
                            </div>
                        </div>
                    </div>
                </td>
            <tr>

        </table>
    </div>
    <iframe id="tranDtl"
        #if($!{tranDtlTmp})
            src="$basePath/foreign/fexTranApp/addTranDtl?tranType=$!{tranDtlTmp.tranType}&proId=$!{tranDtlTmp.proId}&corpId=$!{corpId}&isSwaptTran=$!{tranDtlTmp.isSwaptTran}&id=$!{tranDtlTmp.id}&templateId=$!{tranDtlTmp.templateId}"
        #end
            style="width: 100%;" frameborder="no" border="0" marginwidth="0" marginheight="0" scrolling="no" name="tranDtl"></iframe>
</form>
</body>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/fexTranApp/addTranAppDtl.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
</html>

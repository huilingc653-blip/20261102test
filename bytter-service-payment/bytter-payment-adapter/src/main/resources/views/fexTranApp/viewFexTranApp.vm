<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/fexTranApp/viewBreakStyle.vm")
</head>
<body>
<form class="layui-form" method="post" id="myform">
    <input type="hidden" name="eqs_appId" value="$!{fexTranAppVo.id}">
    <table class="layui-table view-break-table layui-form">
        <tr>
        ##                单位
            <td class="textRight" style="width: 20%">#springMessage('table.abBillTransfer.applyCorp')</td>
            <td>
                <div class="layui-inline">
                    $!{fexTranAppVo.corpName}
                </div>
            </td>
        <tr>
        <tr>
        ##交易需求描述
            <td class="textRight">#springMessage('fex.tranApp.reqRmk')</td>
            <td style="width: 50%">
                <div class="layui-input-inline">
                    $!{fexTranAppVo.rmk}
                </div>
            </td>
        </tr>
        <tr>
        ##申请日期
            <td class="textRight">#springMessage('bill.accebill.applyDate')</td>
            <td style="width: 50%">
                <div class="layui-input-inline">
                    $!date.format("yyyy-MM-dd",$!{fexTranAppVo.appDate})
                </div>
            </td>
        </tr>
    </table>
    <table id="appTable" class="layui-table view-break-table layui-form">
        <thead>
        <tr>
        ##                                    交易类型
            <th>#springMessage('table.fexBankAcc.tranType')</th>
        ##                                    产品
            <th>#springMessage('table.fexBankAcc.proId')</th>
        ##                                    交易对手
            <th>#springMessage('table.fexForeign.copt')</th>
        ##                                    交易日期
            <th>#springMessage('table.btNetChalk.transTime')</th>
        ##                                    结算日期
            <th>#springMessage('table.fcSubjectDay.optDate')</th>
        ##                                    操作
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #if($!{showClosBtn} == 1)
        <div style="width: 100%;text-align: center">
            #if($!{fexTranAppVo.status} == "-1")
                <button class="layui-btn" type="button" onClick="bt.trackFlowByBusinessId('$!{fexTranAppVo.id}')">#springMessage('common.button.trackFlow')</button>
            #end
            <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
        </div>
    #end
</form>
</body>
    #parse("views/common/footer.vm")
<script>
    var form, element, corp;
    bt.use(["jquery", "element", "form", "datatable", "corp"], function () {
        $ = bt.jquery;
        form = bt.form();
        element = layui.element;
        corp = bt.corp.init();//单位

//监听提交
        form.on("submit(submit)", function (data) {
            var action = "/foreign/fexCotp/save";
            bt.loading.show();
            data.field.status = this.value;
            $.post(basePath + action, data.field, function (data) {
                parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                if (data.success) {
                    if (!bt.navtab) {
                        bt.navtab.refreshParentTable();
                    } else {
                        bt.navtab.closeCurrent();
                    }
                } else {
                    bt.loading.hide();
                }
            }, 'JSON');
            return false;
        });
        datatable = bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            ordering: false,
            buttonsLayout: false,
            ajax: {
                "url": basePath + "/foreign/fexTranApp/getDtlDataTable"
            },
            searchForm: {
                formElem: "#myform",
                formFilter: "search"
            },
            columns: [
                {
                    data: "tranType",
                    className: "center",
                    render: function (data, type, row, meta) {
                        return bt.dict("fex.tranApp.tranType", data);
                    }
                },
                {
                    data: "proName",
                    className: "center"
                },
                {
                    data: "cotpName",
                    className: "center"
                },
                {
                    data: "tranDate",
                    className: "center"
                },
                {
                    data: "settleDate",
                    className: "center"
                },
                {
                    data: null,
                    className: 'center',
                    render: function (data, type, full, meta) {
                        var html = "";
                        var split = "<span class=\"text-explode\">|</span>"
                        html += "<a href=\"#\" onclick=\"view('" + full.id + "')\">" + bt.lang("common.button.view") + "</a>";
                        return html;
                    }
                }
            ]
        });

        //这里填写新的js代码，请参考前端文档
    });

    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }

    /**
     * 查看
     * @param id
     */
    function view(id) {
        var url = basePath + "/foreign/fexTranApp/viewDtl?id=" + id ;
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.button.view'), url);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: url,
            end: function () {
                datatable && datatable.draw();
            }
        });
    }
    
</script>
</html>

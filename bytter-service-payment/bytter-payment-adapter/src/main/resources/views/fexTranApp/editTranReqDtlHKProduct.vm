<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
##外汇买卖-----------资金收付

<form class="layui-form" method="post" id="myform">
    #if($!{tranDtlTmp.id})
        <input type="hidden" name="id" value="$!{tranDtlTmp.id}">
    #end
    ##    主表id
    <input type="hidden" name="appId" id="appId">
##    是否掉期交易
    <input type="hidden" name="isSwaptTran" id="isSwaptTran" value="$!{isSwaptTran}">
##    产品id
    <input type="hidden" name="proId" id="proId" value="$!{pro.id}">
##    单位id
    <input type="hidden" name="corpId" id="corpId" value="$!{corpId}">
##    外汇业务类型
    <input type="hidden" class="layui-input" name="fexBusType" id="fexBusType" value="$!{pro.fexBusType}">
##    外汇交易类型
    <input type="hidden" class="layui-input" name="fexTranType" id="fexTranType" value="$!{pro.fexTranType}">
##    交易类型
    <input type="hidden" class="layui-input" name="tranType" id="tranType" value="$!{tranType}">
    <input id="saveFields" name="saveFields" type="hidden">

    <input id="cdSign" name="cdSign" type="hidden" value="1">

    <table class="layui-table layui-form">
        <tr>
            <td></td>
            <td></td>
            ##是否线下付款
            <td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.isPayed')</td>
            <td width="30%">
                <div class="bt-biz-dict" data-type="radio" data-value="$!{tranDtlTmp.isPayed}" data-group="sf_yn" data-defaultvalue="0" data-name="isPayed" data-biz-name="isPayed" data-required = "true"></div>
            </td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            <td rowspan="18" width="5%" align="center">#springMessage('table.fexTranReq.cotpInfo')</td>
            ##交易对手
            <td class="textRight" width="15%">#springMessage('table.fexForeign.copt')</td>
            <td width="30%">
                <input type="hidden" name="oppId" id="oppId" value="$!{tranDtlTmp.oppId}">
                <input type="hidden" name="cotpId" id="cotpId" value="$!{tranDtlTmp.cotpId}"/>
                <div class="layui-inline" id="externalDiv">##客商组件
                    <input class="layui-input" id="cotpName" name="fexCotpVO.cotpName" lay-verify="required" readonly="readonly" type="text" value="$!{fexCotpVO.cotpName}"/>
                    <div class="bt-div-search">
                        ## 客商组件
                        <button type="button" class="bt-biz-allExternalBankAcc" data-beforeClick="bt.externalBankAccBeforeClick"  data-callback="externalBankAccCallback">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            ##交易对手(英文)
            <td class="textRight" width="15%">#springMessage('table.fexForeign.enCopt')</td>
            <td width="30%">
                <input type="text" name="cotpNameEn" id="cotpNameEn" class="layui-input" value="$!{tranDtlTmp.cotpNameEn}" readonly>
            </td>
        </tr>
        <tr>
            ##主体单位地址(英文)
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.corpAddrEn')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <input type="text" name="corpAddEn" class="layui-input" value="$!{corp.addressEn}">
                </div>
            </td>
            ##交易对手地址
            <td class="textRight" width="15%">#springMessage('fex.cotp')#springMessage('table.externalCorp.address')</td>
            <td width="30%">
                <input type="hidden" name="fexCotpVO.addressEn" id="cotpAddressEn" value="$!{fexCotpVO.addressEn}">
                <div id="cotpAdrrDiv" name="cotpAdrrDiv">$!{fexCotpVO.addressEn}</div>
            </td>
        </tr>
        <tr>
            ##主体单位银行
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.corpBank')</td>
            <td width="30%">
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/listFilter" data-name ="corpBank" data-biz-name ="corpBank"
                     data-value="$!{tranDtlTmp.corpBank}"
                     data-valueField="id" data-textField="typeName" data-required = "true" data-callback="corpBankCallBack"></div>
            </td>
            ##交易对手所在国家地区
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpCountry')&#springMessage('fex.cotp.place')</td>
            <td width="30%">
                <input type="hidden" name="fexCotpVO.CountryId" id="cotpCountry" value="$!{fexCotpVO.CountryId}">
                <div id="cotpCountryDiv">$!{fexCotpVO.countryName}</div>
            </td>
        </tr>
        <tr>
            ##主体单位银行账户
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.corpBankAcc')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <input type="hidden" id="payerCountryNameZh" name="payerCountryNameZh" value="$!{payerCountryNameZh}">
                    <input type="hidden" id="payerCountryId" name="payerCountryId" value="$!{payerCountryId}">
                    <input type="hidden" id="payerEnCode" name="payerEnCode" value="$!{payerEnCode}">
                    <input type="text" id="corpBankAcc" name="corpBankAcc" lay-verify="required|tableData" value="$!{tranDtlTmp.corpBankAcc}" data-biz-name="corpBankAcc" data-required = "true"
                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.corpBankAcc')">
                    <table id="corpBankAccTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.choBankFinance.acc')</th>
                            <th>#springMessage('table.btBankAccApp.accName')</th>
                            <th>#springMessage('table.btBankAcc.bankName')</th>
                            <th>#springMessage('table.nisBillhead.curId')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
            ##收款人类型
            <td class="textRight">#springMessage('table.fexForeignReq.payeeType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="fexForeignReq.payeeType" data-required = "true" data-defaultvalue="$!{tranDtlTmp.payeeType}"
                     data-name="payeeType" data-biz-name="payeeType" data-displayData="0,1,2,3,7" data-callback="bt.payeeTypeCallback"></div>
            </td>
        </tr>
        <tr>
            ##付款行Swift Code
            <td class="textRight" width="15%">#springMessage('bill.accebill.payBank')Swift Code</td>
            <td width="30%">
                <div id="payBankSwiftCodeDiv" name="payBankSwiftCodeDiv">$!{payerAcc.bankCode}</div>
            </td>
            ##FPS ID(SVID)
            <td class="textRight" width="15%">FPS ID(SVID)</td>
            <td>
                <div class="layui-inline" id="externalDiv">##客商组件
                    <input class="layui-input" id="fpsId" name="fexCotpVO.fpsId" readonly="readonly" type="text" value="$!{fexCotpVO.fpsId}"/>
                    <div class="bt-div-search">
                        ## 客商组件
                        <button type="button" class="bt-biz-allExternalBankAcc" data-beforeClick="bt.externalBankAccBeforeClick"  data-callback="externalBankAccCallback">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##主体银行本地清算号
            <td class="textRight">#springMessage('table.btswiftinfo.localClearNo')</td>
            <td><div id="payLocalClearNoDiv" name="payLocalClearNoDiv">$!{payerAcc.localClearNo}</div></td>
            ##邮箱(EMAL)
            <td class="textRight" width="15%">#springMessage('fex.cotp.email')</td>
            <td>
                <div class="layui-inline" id="externalDiv">##客商组件
                    <input class="layui-input" id="email" name="fexCotpVO.eMail" readonly="readonly" type="text" value="$!{fexCotpVO.eMail}"/>
                    <div class="bt-div-search">
                        ## 客商组件
                        <button type="button" class="bt-biz-allExternalBankAcc" data-beforeClick="bt.externalBankAccBeforeClick"  data-callback="externalBankAccCallback">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##账户类别
            <td class="textRight">#springMessage('table.btBankAcc.accType')</td>
            <td>
                <div id="accTypeDiv" name="accTypeDiv">$dictTag.get("btBankAcc.accType",$!{payerAcc.accType})</div>
                <input type="hidden" id="accType" name="accType" autocomplete="off" class="layui-input" value="$!{payerAcc.accType}">
            </td>
            ##电话号码(MOBN)
            <td class="textRight" width="15%">#springMessage('fex.cotp.phoneCode')(MOBN)</td>
            <td>
                <input class="layui-input" id="isdCode" name="fexCotpVO.isdCode" readonly="readonly" type="hidden" value="$!{fexCotpVO.isdCode}"/>
                <input class="layui-input" id="phoneCode" name="fexCotpVO.phoneCode" readonly="readonly" type="hidden" value="$!{fexCotpVO.phoneCode}"/>
                <div class="layui-inline" id="externalDiv">##客商组件
                    <input class="layui-input" id="phoneCodeDiv" readonly="readonly" type="text"
                        #if($!{fexCotpVO.isdCode} && $!{fexCotpVO.phoneCode})
                           value="$!{fexCotpVO.isdCode}-$!{fexCotpVO.phoneCode}"
                        #end/>
                    <div class="bt-div-search">
                        ## 客商组件
                        <button type="button" class="bt-biz-allExternalBankAcc" data-beforeClick="bt.externalBankAccBeforeClick"  data-callback="externalBankAccCallback">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##账户名称
            <td class="textRight" width="15%">#springMessage('table.btBankAccApp.accName')</td>
            <td width="30%">
                <input type="hidden" id="corpAccId" name="corpAccId" value="$!{payerAcc.id}">
                <input type="hidden" id="corpAccName" name="corpAccName" value="$!{payerAcc.accName}">
                <div id="corpAccNameDiv" name="corpAccNameDiv">$!{payerAcc.accName}</div>
            </td>
            ##信用卡号(AIIN)
            <td class="textRight" width="15%">#springMessage('fex.cotp.aiIn')(AIIN)</td>
            <td>
                <div class="layui-inline" id="externalDiv">##客商组件
                    <input class="layui-input" id="aiIn" name="fexCotpVO.aiIn" readonly="readonly" type="text" value="$!{fexCotpVO.aiIn}"/>
                    <div class="bt-div-search">
                        ## 客商组件
                        <button type="button" class="bt-biz-allExternalBankAcc" data-beforeClick="bt.externalBankAccBeforeClick"  data-callback="externalBankAccCallback">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##账户币种
            <td class="textRight" width="15%">#springMessage('table.fexForeign.cotpCurName')</td>
            <td width="30%">
                <input type="hidden" id="corpAccCurId" name="corpAccCurId" value="$!{tranDtlTmp.corpAccCurId}">
                <div id="corpAccCurNameDiv" name="corpAccCurNameDiv">$!{tranDtlTmp.corpAccEnglishCode}</div>
            </td>
            ##香港身份证号(HKID)
            <td class="textRight" width="15%">#springMessage('fex.cotp.hkId')(HKID)</td>
            <td>
                <div class="layui-inline" id="externalDiv">##客商组件
                    <input class="layui-input" id="hkId" name="fexCotpVO.hkId" readonly="readonly" type="text" value="$!{fexCotpVO.hkId}"/>
                    <div class="bt-div-search">
                        ## 客商组件
                        <button type="button" class="bt-biz-allExternalBankAcc" data-beforeClick="bt.externalBankAccBeforeClick"  data-callback="externalBankAccCallback">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##主体单位银行地址
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.payBankAdrr')</td>
            <td width="30%">
                <div id="payBankAdrrDiv" name="payBankAdrrDiv">$!{bankAdd}</div>
            </td>
            ##交易对手银行
            <td class="textRight" width="15%">#springMessage('fex.cotp')#springMessage('common.button.bank')</td>
            <td width="30%">
                <input type="hidden" name="fexCotpBankAccVO.bankName" id="cotpBankName" value="$!{tranDtlTmp.fexCotpBankAccVO.bankName}">
                <div id="cotpBankNameDiv" >$!{fexCotpBankAccVO.bankName}</div>
            </td>
        </tr>
        <tr>
            ##主体单位国家地区
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.payBankCountry')</td>
            <td width="30%">
                <div id="payNameBankDiv" name="payNameBankDiv">$!{payerCountryNameZh}</div>
            </td>
            ##交易对手银行账户
            <td class="textRight" width="15%">#springMessage('fex.cotp')#springMessage('table.fexForeign.bankAcc')</td>
            <td width="30%">
                <input type="hidden" name="cotpAccId" id="cotpAccId" value="$!{tranDtlTmp.cotpAccId}">
                <input type="hidden" name="fexCotpBankAccVO.accName" id="cotpAccName" value="$!{tranDtlTmp.fexCotpBankAccVO.accName}">
                <div class="layui-inline" id="externalDiv">##客商组件
                    <input class="layui-input" id="cotpBankAcc" name="cotpBankAcc" readonly="readonly" type="text" value="$!{tranDtlTmp.cotpBankAcc}"/>
                    <div class="bt-div-search">
                        ## 客商组件
                        <button type="button" class="bt-biz-allExternalBankAcc" data-beforeClick="bt.externalBankAccBeforeClick"  data-callback="externalBankAccCallback">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##加急标志
            <td class="textRight" width="15%">#springMessage('table.nisBillhead.isQuick')</td>
            <td width="30%">
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-value="$!{tranDtlTmp.isQuick}" data-name="isQuick" data-biz-name="isQuick"></div>
            </td>
            ##账户币种
            <td class="textRight" width="15%">#springMessage('table.fexForeign.cotpCurName')</td>
            <td width="30%">
                <input type="hidden" id="cotpAccCurId" name="cotpAccCurId" value="$!{tranDtlTmp.cotpAccCurId}">
                <div id="cotpAccCurNameDiv" name="cotpAccCurNameDiv">$!{tranDtlTmp.cotpAccEnglishCode}</div>
            </td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            ##交易对手银行Swift Code
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpSwiftCode')</td>
            <td width="30%">
                <input type="hidden" id="cotpBicCode" name="fexCotpBankAccVO.bicCode" value="$!{tranDtlTmp.fexCotpBankAccVO.bicCode}">
                <div id="cotpBicCodeDiv" name="cotpSwiftCodeDiv">$!{tranDtlTmp.fexCotpBankAccVO.bicCode}</div>
            </td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            ##本地清算号
            <td class="textRight">#springMessage('table.btswiftinfo.localClearNo')</td>
            <td>
                <input type="hidden" name="fexCotpVO.localClearNo" id="localClearNo" value="$!{fexCotpVO.localClearNo}">
                <div id="localClearNoDiv" name="localClearNoDiv">$!{fexCotpVO.localClearNo}</div>
            </td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            ##交易对手银行地址
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpBankAdrr')</td>
            <td width="30%">
                <input type="hidden" name="fexCotpBankAccVO.bankAddr" id="cotpBankAddr" value="$!{tranDtlTmp.fexCotpBankAccVO.bankAddr}">
                <div id="cotpBankAdrrDiv" name="cotpBankAdrrDiv">$!{tranDtlTmp.fexCotpBankAccVO.bankAddr}</div>
            </td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            ##交易对手银行所在国家地区
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpBankCountry')</td>
            <td width="30%">
                <input type="hidden" name="fexCotpBankAccVO.bankId" id="cotpBankCountry" value="$!{tranDtlTmp.fexCotpBankAccVO.bankId}">
                <input type="hidden" name="fexCotpBankAccVO.bankRmk" id="cotpBankCountryName" value="$!{tranDtlTmp.fexCotpBankAccVO.bankRmk}">
                <div id="cotpBankCountryDiv">$!{tranDtlTmp.fexCotpBankAccVO.bankRmk}</div>
            </td>
        </tr>
        <tr>
            ##支付类型
            <td class="textRight" width="15%" id="bankPayTypeTd"></td>
            <td width="30%">
                <div class="bankPayTypeDiv" class="layui-input-inline" style="display: none">
                    <div class="bt-biz-selectType" data-url="" data-name="bankPayType" data-biz-name="bankPayType" data-beforeinit="customBeforeInit"
                         data-value="$!{tranDtlTmp.bankPayType}" data-valuefield="customCode" data-textfield="customName" data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>
    </table>

    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        ##币种
                        <td class="textRight" width="20%">#springMessage('table.bisAccDtl.curName')</td>
                        <td width="30%">
                            <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="curId" data-biz-name ="curId"
                                 data-valueField="id" data-textField="englishCode" data-required = "true" data-callback="bt.curCallback"
                                 data-value="$!{tranDtlTmp.curId}" data-displayData="4028802e5c346968015c346c18850008,a52a1cdbf3fc40eb9fa547218b36526b"></div>
                        </td>
                        ##金额
                        <td class="textRight" width="20%">#springMessage('table.choBankFinance.payMoney')</td>
                        <td width="30%">
                            <input type="text" id="payMoney" name="payMoney" style="text-align:right" lay-verify="required|number2" data-name="payMoney" data-biz-name="payMoney"
                                   value="$!{tranDtlTmp.payMoney}" autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.choBankFinance.payMoney')" data-callback="bt.payMoneyCallback">
                        </td>
                    </tr>
                    <tr>
                        ##交易日期
                        <td class="textRight">#springMessage('table.revenue.transTime')</td>
                        <td >
                            <input type="text" name="tranDate" lay-verify="required" class="layui-input bt-biz-dateType"
                                   value="$!{tranDtlTmp.tranDate}" data-today="true"  data-type="date" data-name="tranDate" data-biz-name="tranDate">
                        </td>
                        ##结算日期
                        <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                        <td >
                            <input type="text" name="settleDate" lay-verify="required" class="layui-input bt-biz-dateType"
                                   value="$!{tranDtlTmp.settleDate}" data-today="true" data-type="date" data-name="settleDate" data-biz-name="settleDate" data-callback="settleDateCallback">
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.fexForeignReq.rmkEn')</td>
                        <td colspan="3">
                            <textarea placeholder="#springMessage('table.fexForeignReq.rmkEn')" class="layui-textarea" lay-verify="strlength" data-maxlength="200" style="width:100%" id="rmk" name="rmk" >$!{tranDtlTmp.rmk}
                            </textarea>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('cms.loan.OtherInfo')</h2>
            <div class="layui-colla-content layui-show" id="otherInfoDiv">
                <table class="layui-table">
                    <tr>
                        ##发票号
                        <td class="textRight" width="20%">#springMessage('table.fexForeignReq.invoiceNo')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" id="invoiceNo" name="invoiceNo" value="$!{tranDtlTmp.invoiceNo}"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.invoiceNo')">
                            </div>
                        </td>
                        ##发票总额
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.invoiceTotal')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" id="invoiceTotal" name="invoiceTotal" style="text-align:right" lay-verify="number2" data-name="invoiceTotal" data-biz-name="invoiceTotal"
                                       value="$!{tranDtlTmp.invoiceTotal}" autocomplete="off" class="layui-input bt-biz-moneyType" >
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##发票日期
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.invoiceDate')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" name="invoiceDate"  class="layui-input bt-biz-dateType"
                                       value="$!{tranDtlTmp.invoiceDate}" data-type="date" data-name="invoiceDate" data-biz-name="invoiceDate">
                            </div>
                        </td>
                        ##抵扣金额
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.deductionAmount')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" id="deductionAmount" name="deductionAmount" style="text-align:right" lay-verify="number2" data-name="deductionAmount" data-biz-name="deductionAmount"
                                       value="$!{tranDtlTmp.deductionAmount}"  autocomplete="off" class="layui-input bt-biz-moneyType" >
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                        ##发票净额
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.invoiceAmount')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" id="invoiceAmount" name="invoiceAmount" style="text-align:right" lay-verify="number2" data-name="invoiceAmount" data-biz-name="invoiceAmount"

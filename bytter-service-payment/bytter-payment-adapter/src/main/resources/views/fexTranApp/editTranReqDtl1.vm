<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body style="padding: 0;">
##外汇买卖-----------非掉期交易
<form class="layui-form" method="post" id="myform">
    #if($!{swapType})
    ##        近/远端  1-近端，2-远端
        <input type="hidden" id="swapType" name="swapType" value="$!{swapType}">
        <input type="hidden" id="partnerId" name="partnerId" value="$!{tranDtl.partnerId}">
    #end
    #if($!{tranDtl.id})
        <input type="hidden" id="id" name="id" value="$!{tranDtl.id}">
    #end
##    主表id
    <input type="hidden" name="appId" id="appId">
##    是否掉期交易
    <input type="hidden" name="isSwaptTran" id="isSwaptTran" value="$!{isSwaptTran}">
##    产品id
    <input type="hidden" name="proId" id="proId" value="$!{pro.id}">
##    单位id
    <input type="hidden" name="corpId" id="corpId">
##    外汇业务类型
    <input type="hidden" class="layui-input" name="fexBusType" id="fexBusType" value="$!{pro.fexBusType}">
##    外汇交易类型
    <input type="hidden" class="layui-input" name="fexTranType" id="fexTranType" value="$!{pro.fexTranType}">
##    交易类型
    <input type="hidden" class="layui-input" name="tranType" id="tranType" value="$!{tranType}">
##    交割类型
    <input type="hidden" class="layui-input" name="deliveryType" id="deliveryType" value="$!{pro.deliveryType}">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranProductInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table layui-form">
                    <tr>
                        ##外汇业务类型
                        <td class="textRight" width="20%">#springMessage('table.fexProduct.fexBusType')</td>
                        <td width="30%">
                            <div class="layui-inline">
                                <span>$dictTag.get("fexProduct.fexBusType",$!{pro.fexBusType})</span>
                            </div>
                        </td>
                        ##外汇交易类型
                        <td class="textRight" width="20%">#springMessage('table.fexProduct.fexTranType')</td>
                        <td width="30%">
                            <span>$dictTag.get("fexProduct.fexTranType",$!{pro.fexTranType})</span>
                        </td>
                    </tr>
                    <tr>
                        ##交割类型
                        <td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
                        <td>
                            <div class="layui-input-inline">
                                <span>$dictTag.get("fexProduct.deliveryType",$!{pro.deliveryType})</span>
                            </div>
                        </td>
                        #if($!{pro.deliveryType} == 1)
                            ##交割币种
                            <td class="textRight"><div name="deliveryCurIdDiv">#springMessage('fex.tranApp.deliveryCurId')</div></td>
                            <td>
                                <div class="layui-input-inline" name="deliveryCurIdDiv">
                                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-required="true"
                                        #if($!{tranDtl.deliveryCurId})
                                         data-value="$!{tranDtl.deliveryCurId}"
                                        #else
                                         data-value="$!{pro.deliveryCurId}"
                                        #end
                                         data-textfield="englishCode" data-name="deliveryCurId" data-biz-name="deliveryCurId"></div>
                                </div>
                            </td>
                        #else
                            <td></td>
                            <td></td>
                        #end
                    </tr>
                    #if($!{pro.fexBusType} == 1)
                    <tr>
                        ##结汇业务类型
                        <td class="textRight">
                            #springMessage('fex.tran.settleBusType')
                        </td>
                        <td>
                            <div class="bt-biz-dict" data-type="select" data-value="$!{tranDtl.settleBusType}"
                                 data-group="fex.tran.settleBusType" data-required="true" data-name="settleBusType" data-biz-name="settleBusType"></div>
                        </td>
                    </tr>
                    #end
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table layui-form">
                    <tr>
                        <td class="textRight" width="20%">#springMessage('fex.tranApp.FixedAmount')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-required="true" data-group="fex.tranApp.fixMoney"
                                    #if($!{tranDtl.fixedMoney})
                                     data-value="$!{tranDtl.fixedMoney}"
                                    #else
                                     data-value="1"
                                    #end
                                     data-name="fixedMoney" data-biz-name="fixedMoney"></div>
                            </div>
                        </td>
                        <td width="20%"></td>
                        <td width="30%">
                            <input type="checkbox" name="autoCal" lay-filter = "autoCal" value="1"
                                #if(${tranDtl} || $!{tranDtl.autoCal})
                                   checked="checked"
                                #end
                                   title="#springMessage('fex.tranApp.autoCal')" lay-skin="primary">
                        </td>
                    </tr>
                    <tr>
                        ##买入币种
                        <td class="textRight">#springMessage('table.fexTranReq.buyCurId')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                                     #if($!{tranDtl.buyCurId})
                                     data-value="$!{tranDtl.buyCurId}"
                                         #else
                                     data-value="$!{pro.buyCurId}"
                                     #end
                                     data-callback="calWishRate"
                                     data-textfield="englishCode" data-required="true" data-name="buyCurId" data-biz-name="buyCurId"></div>
                            </div>
                        </td>
                        ##买入金额
                        <td class="textRight">#springMessage('table.fexTranReq.buyMoney')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" class="layui-input bt-biz-moneyType" data-callback="calWishRate" data-callback="calWishRate"
                                       value="$!{tranDtl.buyMoney}" lay-verify="required" data-biz-name="buyMoney" data-name="buyMoney">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##卖出币种
                        <td class="textRight">#springMessage('table.fexTranReq.sellCurId')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-selectType"
                                     data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                                    #if($!{tranDtl.sellCurId})
                                     data-value="$!{tranDtl.sellCurId}"
                                    #else
                                     data-value="$!{pro.sellCurId}"
                                    #end
                                     data-callback="calWishRate"
                                     data-textfield="englishCode"  data-required="true" data-biz-name="sellCurId" data-name="sellCurId"></div>
                            </div>
                        </td>
                        ##卖出金额
                        <td class="textRight">#springMessage('table.fexTranReq.sellMoney')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" class="layui-input bt-biz-moneyType" data-callback="calWishRate"
                                       value="$!{tranDtl.sellMoney}" lay-verify="required" data-biz-name="sellMoney" data-name="sellMoney">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##期望汇率
                        <td class="textRight">#springMessage('fex.tranApp.wishRate')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" data-name="wishRate" style="display: inline"  data-biz-name="wishRate" data-callback="calWishRate"
                                       value="$!{tranDtl.wishRate}" lay-verify="required" data-decimal="6" class="layui-input bt-biz-moneyType">
                            </div>
                        </td>
                        ##钞汇标识
                        <td class="textRight">#springMessage('table.fexTranReq.bankNote')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-required="true" data-group="fex.tranApp.bankNote"
                                     #if($!{tranDtl.bankNote})
                                     data-value="$!{tranDtl.bankNote}"
                                         #else
                                     data-value="2"
                                     #end
                                     data-name="bankNote" data-biz-name="bankNote"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##交易日期
                        <td class="textRight">#springMessage('table.btNetChalk.transTime')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="tranDate" lay-verify="required" class="layui-input bt-biz-dateType" data-endid="settleDate" data-type="date"
                                       value="$!{tranDtl.tranDate}" data-callback = "calDeliveryDeadline"
                                       data-biz-name="tranDate">
                            </div>
                        </td>
                        ##结算日期
                        <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="settleDate" lay-verify="required" id="settleDate" class="layui-input bt-biz-dateType" data-type="date"
                                       value="$!{tranDtl.settleDate}"
                                       data-callback="calDeliveryDeadline" data-biz-name="settleDate">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##交割期限
                        <td class="textRight">#springMessage('table.fexTranReq.deliveryDeadline')</td>
                        <td colspan="3">
                            <div class="layui-input-inline">
                                <span id="deliveryDeadlineShow">
                                    #if($!{tranDtl.deliveryDeadline})
                                        T+$!{tranDtl.deliveryDeadline}
                                    #end
                                </span>
                                <input type="hidden" name="deliveryDeadline" id="deliveryDeadline" value="$!{tranDtl.deliveryDeadline}">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##汇款类型
                        <td class="textRight">#springMessage('table.fexForeignReq.remitType')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-value="$!{tranDtl.remitType}"
                                     data-group="fexForeignReq.remitType" data-required="true" data-name="remitType" data-biz-name="remitType"></div>
                            </div>
                        </td>
                        ##资金性质
                        <td class="textRight">#springMessage('table.fexTranReq.accNature')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="fexTranReq.accNature" data-value="$!{tranDtl.accNature}" data-required="true" data-name="accNature" data-biz-name="accNature"></div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranBoodInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table layui-form">
                        <tr>
                            ##保证方式
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.boodType')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-dict" data-type="select" data-value="$!{tranDtl.boodType}" data-group="fex.tranApp.boodType"
                                         #if($!{tranDtl} && $!{tranDtl.deliveryDeadline} != "0")
                                             data-required="true"
                                         #end
                                         data-name="boodType" data-biz-name="boodType" data-callback="boodTypecallBack"></div>
                                </div>
                            </td>
                            ##保证金账号
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.boodAcc')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    <input type="text" id="boodAcc" name="boodAcc" data-biz-name="boodAcc" class="layui-input text"
                                        #if($!{tranDtl} && $!{tranDtl.deliveryDeadline} != "0" && ($!{tranDtl.boodType} == "1" || $!{tranDtl.boodType} == "2"))
                                           lay-verify="required"
                                        #end
                                           value="$!{tranDtl.boodAcc}">
                                    <input type="hidden" id="boodAccId" name="boodAccId">
                                    <table id="boodAccTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.choBankFinance.acc')</th>
                                            <th>#springMessage('table.btBankAccApp.accName')</th>
                                            <th>#springMessage('table.btBankAcc.bankName')</th>
                                            <th>#springMessage('table.nisBillhead.curId')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##保证金比例
                            <td class="textRight">#springMessage('fex.tranApp.boodRatio')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" data-name="boodRatio" data-biz-name="boodRatio" value="$!{tranDtl.boodRatio}"
                                        #if($!{tranDtl} && $!{tranDtl.deliveryDeadline} != "0")
                                           lay-verify="required"
                                        #end
                                           class="layui-input bt-biz-ratioType">
                                </div>
                            </td>
                            ##保证金钞汇标识
                            <td class="textRight">#springMessage('fex.tranApp.bondBankNote')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <div class="bt-biz-dict" data-type="radio" data-group="fex.tranApp.bankNote"
                                         #if($!{tranDtl.boodBankNote})
                                         data-value="$!{tranDtl.boodBankNote}"
                                             #else
                                         data-value="2"
                                         #end
                                         data-name="boodBankNote" data-biz-name="boodBankNote"></div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##保证金币种
                            <td class="textRight">#springMessage('table.fexTranReq.bondCurId')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <div class="bt-biz-selectType" data-name="bondCurId" data-value="$!{tranDtl.bondCurId}"
                                        #if($!{tranDtl} && $!{tranDtl.deliveryDeadline} != "0" && ($!{tranDtl.boodType} == "1" || $!{tranDtl.boodType} == "2"))
                                         data-required="true"
                                        #end
                                         data-initCallback="setbondCurId"
                                         data-callback="bondCurIdCallBack"
                                         data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                                         data-textfield="englishCode" data-biz-name="bondCurId"></div>
                                </div>
                            </td>
                            ##额度
                            <td class="textRight">#springMessage('table.guaContract.trackMoney')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" data-name="payMoney" data-biz-name="payMoney" class="layui-input bt-biz-moneyType"
                                        #if($!{tranDtl} && $!{tranDtl.boodType} == 4)
                                           lay-verify="required"
                                        #end
                                           value="$!{tranDtl.payMoney}">
                                </div>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('fex.fexTranReqPay.reportInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table layui-form">
                        <tr>
                            ##合同号
                            <td class="textRight" width="20%">#springMessage('table.fbsBudgetDetail.contract')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    <input type="text" name="contractNo" id="contractNo" class="layui-input" value="$!{tranDtl.contractNo}">
                                </div>
                            </td>
                            ##外汇局批件号/备案表号/业务编号
                            <td class="textRight" width="20%">#springMessage('fex.tranApp.ApprovalNo')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    <input type="text" name="busNo" id="busNo" class="layui-input" value="$!{tranDtl.busNo}">
                                </div>
                            </td>
                        </tr>
                        #if($!{pro.fexBusType} == 1)
                            <tr>
                                ##结汇资金用途
                                <td class="textRight">#springMessage('table.fexTranReq.purpose')</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <div class="bt-biz-dict" data-type="select"  data-group="fex.tranApp.purpose" data-value="$!{tranDtl.purpose}" data-name="purpose" data-biz-name="purpose" data-inputValueMaxLength="60" data-callback="purposeCallBack"></div>
                                    </div>
                                </td>
                                ##结汇资金详细用途
                                <td class="textRight">#springMessage('table.fexTranReq.purposeDtl')</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <input type="text" name="purposeDtl" id="purposeDtl" value="$!{tranDtl.purposeDtl}" class="layui-input">
                                    </div>
                                </td>
                            </tr>
                        #end
                        <tr>
                            ##发票号
                            <td class="textRight">#springMessage('table.fexForeignReq.invoiceNo')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" name="invoiceNo" id="invoiceNo" class="layui-input" value="$!{tranDtl.invoiceNo}">
                                </div>
                            </td>
                            ##交易编码
                            <td class="textRight">#springMessage('table.fexTranInfo.tranCode')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="hidden" id="tranCode1" name="tranCode1" value="$!{tranDtl.tranCode1}"
                                           autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('table.fexForeignReq.tranCode1')">
                                    <input type="text" id="tranName1" name="tranName1"
                                           data-biz-name="tranName1" value="$!{tranDtl.tranCode1Name}"
                                           autocomplete="off" class="layui-input text tranName1"
                                           placeholder="#springMessage('table.fexForeignReq.tranCode1')">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##联系人
                            <td class="textRight">#springMessage('table.fexTranReq.corpContact')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" name="corpContact" id="corpContact" class="layui-input" value="$!{tranDtl.corpContact}">
                                </div>
                            </td>
                            ##联系电话
                            <td class="textRight">#springMessage('sys.user.phone.show')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" name="corpContactTel" id="corpContactTel" class="layui-input" value="$!{tranDtl.corpContactTel}">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##其他保证方式说明
                            <td class="textRight">#springMessage('fex.tranApp.otherBondRmk')</td>
                            <td colspan="3">
                                    <input lay-verify="strlength" type="text" name="boodRmk" data-maxlength = "50" id="boodRmk" class="layui-input" value="$!{tranDtl.boodRmk}"
                                           placeholder="#springMessage('table.fexTranReq.boodRmk')" style="width:100%">
                            </td>
                        </tr>
                        <tr>
                            ##申请人
                            <td class="textRight">#springMessage('bill.accebill.applyName')</td>
                            <td colspan="3">
                                <div class="layui-input-inline">
                                    $!{userName}
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight">#springMessage('cms.loan.attachment')</td>
                            <td style="text-align: center;" colspan="3">
                                <!-- 附件上传 -->
                                <input type="hidden" name="attachmentId" id="gid" value="$!{tranDtl.attachmentId}">
                                <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                            </td>
                        </tr>
                        #if($!{isSwaptTran} != 1)
                            <tr>
                                <td colspan="4" style="text-align: center">
                                    <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('保存')</button>
                                    <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage(
                                        'common.button.close')</button>
                                </td>
                            </tr>
                        #end
                    </table>
                </div>
            </div>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('cms.loan.OtherInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table layui-form">
                        <tr>
                            ##资金来源
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.fundsSource')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-dict" data-type="select" data-group="fex.tranApp.fundsSource" data-value="$!{tranDtl.fundsSource}" data-required="true" data-name="fundsSource" data-biz-name="fundsSource"></div>
                                </div>
                            </td>
                            ##结售汇属性
                            <td class="textRight" width="20%">
                                #if($!{pro.fexBusType} != 3)
                                    #springMessage('table.fexTranReq.fexProp')
                                #end
                            </td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    #if($!{pro.fexBusType} == 1)
                                        <div class="bt-biz-dict" data-type="select" data-group="fex.tranApp.fexProp" data-name="fexProp" data-value="$!{tranDtl.fexProp}" data-biz-name="fexProp"></div>
                                    #elseif($!{pro.fexBusType} == 2)
                                        <div class="bt-biz-dict" data-type="select" data-group="fex.tranApp.fexProp2" data-name="fexProp" data-value="$!{tranDtl.fexProp}" data-biz-name="fexProp"></div>
                                    #end
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
                            <td colspan="3">
                                <textarea name="rmk" id="rmk" class="layui-textarea">$!{tranDtl.rmk}</textarea>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
</form>
</body>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/fexTranApp/editTranReqDtl1.js?_btv=${resourceVersion}"></script>
</html>

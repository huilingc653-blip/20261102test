<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-clear-template {
            position: absolute;
            right: -48px;
            top: 0;
        }
        .layui-clear-template .layui-btn {
            display: inline-block;
            height: 24px;
            border-radius: 0;
        }
    </style>
</head>
<body>
<form class="layui-form ignore-required-icon" method="post" id="myform">
    <input id="corpId" type="hidden" value="$!{corpId}">
    <input id="appId" type="hidden" value="$!{appId}">
    <input type="hidden" id="dtlId" value="$!{tranDtl.id}">
    <div style="padding: 0 10px;">
        <table class="layui-table layui-form">
            <tr>
                ##                交易类型
                <td class="textRight" width="20%"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.foreign.tranType')</td>
                <td width="30%">
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-type="select" data-required="true"
                             data-group="fex.tranApp.tranType" data-displayData="4,7,8,9,2"
                             data-value="$!{tranDtl.tranType}"
                             data-name="tranType" data-biz-name="tranType" data-callback="getPro"></div>
                    </div>
                </td>
         #*       ##                是否掉期交易
                <td class="textRight" width="20%"><div name="isSwaptTran" #if($!{tranDtl.tranType} != 1)style="display: none" #end><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranReq.isSwapTran')</div></td>
                <td width="30%">
                    <div class="layui-inline" name="isSwaptTran" #if($!{tranDtl.tranType} != 1)style="display: none" #end>
                        <div class="bt-biz-dict" data-type="radio"
                            #if($!{tranDtl.isSwaptTran})
                             data-value="$!{tranDtl.isSwaptTran}"
                            #else
                             data-value="0"
                            #end
                             data-callback="tranDtlCallBack" data-required="true" data-group="sf_yn" data-name="isSwaptTran"
                             data-biz-name="isSwaptTran"></div>
                    </div>
                </td>
            <tr>
            <tr>*#

        <td width="20%" class="textRight template"  #if($!{tranDtl.tranType}!='4') style="display: none;"#end>#springMessage('table.fexForeignReq.tranTemplate')</td>
        <td class="template" #if($!{tranDtl.tranType}!='4') style="display: none;"#end>
            <div class="layui-input-inline">
                <input type="text" id="templateName" lay-verify="required" readonly="readonly" class="layui-input" value="$!{tranDtl.templateName}">
                <input type="hidden" id="templateId" name="templateId" value="$!{tranDtl.templateId}" >
                <!-- 银行账户选择弹窗按钮 -->
                <div class="bt-div-search" style="top:17%;right: 0;">
                    <button id="templateBtn" type="button" title="#springMessage('common.button.select')">
                        <i class="layui-icon">&#xe615;</i>
                    </button>
                </div>
                <div class="layui-clear-template">
                    <button type="button" class="layui-btn">清空</button>
                </div>
            </div>
        </td>



                    ##产品
                    <td width="20%" class="textRight pro" #if($!{tranDtl.tranType}=='4') style="display: none;"#end><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.foreign.product')</td>
                    <td class="pro" #if($!{tranDtl.tranType}=='4') style="display: none;"#end>
                        <div class="bt-biz-selectType" data-required="true" data-biz-name="proId"
                             data-valuefield="id" data-textfield="proName" data-name="proId"
                            #if($!{tranDtl.proId})
                             data-value="$!{tranDtl.proId}"
                             data-url="$basePath/foreign/fexproduct/listProduct/$!{tranDtl.tranType}"
                            #else
                             data-url=""
                            #end
                             data-callback="tranDtlCallBack"></div>
                    </td>






           #*     <td></td>
                <td></td>*#
            </tr>
        </table>
    </div>
    <iframe id="tranDtl"
        #if($!{tranDtl})
            src="$basePath/foreign/fexTranApp/editTranDtl?tranType=$!{tranDtl.tranType}&proId=$!{tranDtl.proId}&isSwaptTran=$!{tranDtl.isSwaptTran}&id=$!{tranDtl.id}&templateId=$!{tranDtl.templateId}"
        #end
            style="width: 100%;" frameborder="no" border="0" marginwidth="0" marginheight="0" scrolling="no" name="tranDtl"></iframe>
</form>
</body>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/fexTranApp/editTranAppDtl.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/cms/iframeAutoHeight.js?_btv=${resourceVersion}"></script>
</html>

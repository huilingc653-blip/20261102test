<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
##外汇买卖-----------资金收付

<form class="layui-form" method="post" id="myform">

    <table class="layui-table layui-form" style="margin: 0px;padding: 0px">
        <tr>
            ##产品
            <td class="textRight" width="20%" colspan="2">#springMessage('table.foreign.product')</td>
            <td width="30%">
                <div class="layui-inline">
                    $!{pro.proName}
                </div>
            </td>
            ##是否线下付款
            <td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.isPayed')</td>
            <td width="30%">
                $dictTag.get("sf_yn",$!{tranDtl.isPayed})
            </td>
        </tr>
        <tr>
            <td rowspan="17" width="5%" align="center">#springMessage('table.fexTranReq.corpInfo')</td>
            ##单位
            <td class="textRight" width="15%"></td>
            <td width="30%"></td>
            <td rowspan="17" width="5%" align="center">#springMessage('table.fexTranReq.cotpInfo')</td>
            ##交易对手
            <td class="textRight" width="15%">#springMessage('table.fexForeign.copt')</td>
            <td width="30%">
                $!{tranDtl.cotpName}
            </td>
        </tr>
        <tr>
            ##主体单位地址(英文)
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.corpAddrEn')</td>
            <td width="30%">
                $!{corp.addressEn}
            </td>
            ##交易对手地址
            <td class="textRight" width="15%">#springMessage('fex.cotp')#springMessage('table.externalCorp.address')</td>
            <td width="30%">
                $!{fexCotpVO.addressEn}
            </td>
        </tr>
        <tr>
            ##主体单位银行
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.corpBank')</td>
            <td width="30%">
                $!{tranDtl.corpBankName}
            </td>
            ##交易对手所在国家地区
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpCountry')&#springMessage('fex.cotp.place')</td>
            <td width="30%">
                <div id="cotpCountryDiv">$!{fexCotpVO.countryName}</div>
            </td>
        </tr>
        <tr>
            ##主体单位银行账户
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.corpBankAcc')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    $!{tranDtl.corpBankAcc}
                </div>
            </td>
            ##收款人类型
            <td class="textRight">#springMessage('table.fexForeignReq.payeeType')</td>
            <td>
                $dictTag.get("fexForeignReq.payeeType",$!{tranDtl.payeeType})
            </td>
        </tr>
        <tr>
            ##付款行Swift Code
            <td class="textRight" width="15%">#springMessage('bill.accebill.payBank')Swift Code</td>
            <td width="30%">
                $!{payerAcc.bankCode}
            </td>
            ##FPS ID(SVID)
            <td class="textRight" width="15%">FPS ID(SVID)</td>
            <td>
                <div class="layui-input-inline">
                    $!{fexCotpVO.fpsId}
                </div>
            </td>
        </tr>
        <tr>
            ##主体银行本地清算号
            <td class="textRight">#springMessage('table.btswiftinfo.localClearNo')</td>
            <td><div id="payLocalClearNoDiv" name="payLocalClearNoDiv">$!{payerAcc.localClearNo}</div></td>
            ##邮箱(EMAL)
            <td class="textRight" width="15%">#springMessage('fex.cotp.email')</td>
            <td>
                <div class="layui-input-inline">
                    $!{fexCotpVO.eMail}
                </div>
            </td>
        </tr>
        <tr>
            ##账户类别
            <td class="textRight">#springMessage('table.btBankAcc.accType')</td>
            <td>
                $dictTag.get("btBankAcc.accType",$!{payerAcc.accType})
            </td>
            ##电话号码(MOBN)
            <td class="textRight" width="15%">#springMessage('fex.cotp.phoneCode')(MOBN)</td>
            <td>
                #if($!{fexCotpVO.isdCode} && $!{fexCotpVO.phoneCode})
                    $!{fexCotpVO.isdCode}-$!{fexCotpVO.phoneCode}
                #end
            </td>
        </tr>
        <tr>
            ##账户名称
            <td class="textRight" width="15%">#springMessage('table.btBankAccApp.accName')</td>
            <td width="30%">
                $!{payerAcc.accName}
            </td>
            ##信用卡号(AIIN)
            <td class="textRight" width="15%">#springMessage('fex.cotp.aiIn')(AIIN)</td>
            <td>
                $!{fexCotpVO.aiIn}
            </td>
        </tr>
        <tr>
            ##账户币种
            <td class="textRight" width="15%">#springMessage('table.fexForeign.cotpCurName')</td>
            <td width="30%">
                $!{tranDtl.corpAccEnglishCode}
            </td>
            ##香港身份证号(HKID)
            <td class="textRight" width="15%">#springMessage('fex.cotp.hkId')(HKID)</td>
            <td>
                $!{fexCotpVO.hkId}
            </td>
        </tr>
        <tr>
            ##主体单位银行地址
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.payBankAdrr')</td>
            <td width="30%">
                <div id="payBankAdrrDiv" name="payBankAdrrDiv">$!{bankAdd}</div>
            </td>
            ##交易对手银行
            <td class="textRight" width="15%">#springMessage('fex.cotp')#springMessage('common.button.bank')</td>
            <td width="30%">
                $!{tranDtl.fexCotpBankAccVO.bankName}
            </td>
        </tr>
        <tr>
            ##主体单位国家地区
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.payBankCountry')</td>
            <td width="30%">
                <div id="payNameBankDiv" name="payNameBankDiv">$!{payerCountryNameZh}</div>
            </td>
            ##交易对手银行账户
            <td class="textRight" width="15%">#springMessage('fex.cotp')#springMessage('table.fexForeign.bankAcc')</td>
            <td width="30%">
                $!{tranDtl.cotpBankAcc}
            </td>
        </tr>
        <tr>
            ##加急标志
            <td class="textRight" width="15%">#springMessage('table.nisBillhead.isQuick')</td>
            <td width="30%">
                $dictTag.get("sf_yn",$!{tranDtl.isQuick})
            </td>
            ##账户币种
            <td class="textRight" width="15%">#springMessage('table.fexForeign.cotpCurName')</td>
            <td width="30%">
                $!{tranDtl.cotpAccEnglishCode}
            </td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            ##交易对手银行Swift Code
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpSwiftCode')</td>
            <td width="30%">
                <div id="cotpSwiftCodeDiv" name="cotpSwiftCodeDiv">$!{tranDtl.fexCotpBankAccVO.bicCode}</div>
            </td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            ##本地清算号
            <td class="textRight">#springMessage('table.btswiftinfo.localClearNo')</td>
            <td><div id="localClearNoDiv" name="localClearNoDiv">$!{fexCotpVO.localClearNo}</div></td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            ##交易对手银行地址
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpBankAdrr')</td>
            <td width="30%">
                <div id="cotpBankAdrrDiv" name="cotpBankAdrrDiv">$!{tranDtl.fexCotpBankAccVO.bankAddr}</div>
            </td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            ##交易对手银行所在国家地区
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpBankCountry')</td>
            <td width="30%">
                $!{tranDtl.fexCotpBankAccVO.bankRmk}
            </td>
        </tr>
    </table>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        ##币种
                        <td class="textRight" width="20%">#springMessage('table.bisAccDtl.curName')</td>
                        <td width="30%">
                            $!{tranDtl.curEnCode}
                        </td>
                        ##金额
                        <td class="textRight" width="20%">#springMessage('table.choBankFinance.payMoney')</td>
                        <td width="30%">
                            $!number.formatNumeric($!{tranDtl.payMoney})
                        </td>
                    </tr>
                    <tr>
                        ##交易日期
                        <td class="textRight">#springMessage('table.revenue.transTime')</td>
                        <td >
                            $!date.format('yyyy-MM-dd',$!{tranDtl.tranDate})
                        </td>
                        ##结算日期
                        <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                        <td >
                            $!date.format('yyyy-MM-dd',$!{tranDtl.settleDate})
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.fexForeignReq.rmkEn')</td>
                        <td colspan="3">
                            $!{tranDtl.rmk}
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('cms.loan.OtherInfo')</h2>
            <div class="layui-colla-content layui-show" id="otherInfoDiv">
                <table class="layui-table">
                    <tr>
                        ##发票号
                        <td class="textRight" width="20%">#springMessage('table.fexForeignReq.invoiceNo')</td>
                        <td width="30%">
                            $!{tranDtl.invoiceNo}
                        </td>
                        ##发票总额
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.invoiceTotal')</td>
                        <td width="30%">
                            $!number.formatNumeric($!{tranDtl.invoiceTotal})
                        </td>
                    </tr>
                    <tr>
                        ##发票日期
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.invoiceDate')</td>
                        <td width="30%">
                            $!date.format('yyyy-MM-dd',$!{tranDtl.invoiceDate})
                        </td>
                        ##抵扣金额
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.deductionAmount')</td>
                        <td width="30%">
                            $!number.formatNumeric($!{tranDtl.deductionAmount})
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                        ##发票净额
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.invoiceAmount')</td>
                        <td width="30%">
                            $!number.formatNumeric($!{tranDtl.invoiceAmount})
                        </td>
                    </tr>
            </table>
            </div>
        </div>
    </div>
</form>
</body>
    #parse("views/common/footer.vm")
<script>

    bt.use(["jquery", "form", "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        var gid = $("#gid").val();
        upload = bt.btUpload.init({
            elem: "#uploader",
            hasDelete: false,
            hasUpload: false,
            isExpand: true,
            auto: false,
            gid: gid
        });

        /**
         * 查看
         * @param id
         */
        view = function (id) {
            if (bt.navtab) {
                bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/foreign/fextranreq/view/" + id);
                return;
            }
            parent.layer.open({
                type: 2,
                area: ['850px', '530px'],
                maxmin: true,
                content: basePath + "/foreign/fextranreq/view/" + id
            });
        }
    });
    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }
</script>
</html>

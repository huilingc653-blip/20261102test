<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body style="padding: 0;">
##外汇买卖-----------资金收付

<form class="layui-form" method="post" id="myform">
    #if($!{tranDtlTmp.id})
        <input type="hidden" name="id" value="$!{tranDtlTmp.id}">
    #end
    <div id="multiIframes" style="display: none" data-flag="true"></div>
##    是否掉期交易
    <input type="hidden" name="isSwaptTran" id="isSwaptTran" value="$!{isSwaptTran}">
##    产品id
    <input type="hidden" name="proId" id="proId" value="$!{pro.id}">
    <input type="hidden" name="templateId" id="templateId" value="$!{template.id}">
    <input type="hidden" name="templateName" id="templateName" value="$!{tranDtlTmp.templateName}">
    <input type="hidden" name="templatePayType" id="templatePayType" value="">
    <input type="hidden" name="bifCode" id="bifCode" value="$!{template.bifId}">
    <input type="hidden" name="countryId" id="countryId" value="$!{template.countryId}">
    <input type="hidden" name="template" id="template" value="$!{template}">
##    单位id
    <input type="hidden" name="corpId" id="corpId" value="$!{corpId}">
##    外汇业务类型
    <input type="hidden" class="layui-input" name="fexBusType" id="fexBusType" value="$!{pro.fexBusType}">
##    外汇交易类型
    <input type="hidden" class="layui-input" name="fexTranType" id="fexTranType" value="$!{pro.fexTranType}">
##    交易类型
    <input type="hidden" class="layui-input" name="tranType" id="tranType" value="$!{tranType}">

    <table class="layui-table layui-form">
        <tr>
            ##收付方向
            <td class="textRight" width="20%" >#springMessage('table.foreign.cdSign')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="radio" data-group="fexCorp.cdSign"
                        #if($!{tranDtlTmp.cdSign})
                         data-value="$!{tranDtlTmp.cdSign}"
                        #else
                         data-value="1"
                        #end
                         data-required="true" data-name="cdSign" data-biz-name="cdSign" data-callback="costSignCallBack"></div>
                </div>
            </td>
            ##汇款类型
            <td class="textRight" width="20%" >#springMessage('table.fexForeignReq.remitType')</td>
            <td >
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-value="$!{tranDtlTmp.remitType}"
                         data-group="fexForeignReq.remitType"   data-defaultvalue="2" data-name="remitType" data-biz-name="remitType"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##主体单位
            <td class="textRight" width="20%"  >#springMessage('nis.pool.fcCorpPool.poolCorp')</td>
            <td>
                <input type="hidden" name="corpId" id="corpId" value="$!{corp.id}"/>
                <input class="layui-input" id="corpName" name="corpName"  readonly="readonly" type="text" value="$!{corp.name}"/>

            </td>
            ##交易对手
            <td class="textRight" width="15%">#springMessage('table.fexForeign.copt')</td>
            <td width="30%">
                <input type="hidden" name="cotpId" id="cotpId" value="$!{tranDtlTmp.cotpId}"/>
                <input class="layui-input" id="cotpName" name="cotpName"  readonly="readonly" type="text" value="$!{tranDtlTmp.cotpName}"/>

            </td>
        </tr>
        <tr>
            ##主体单位银行
            <td class="textRight"  width="20%"  >#springMessage('table.fexTranReq.corpBank')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-value="$!{tranDtlTmp.corpBank}"
                         data-biz-name="corpBank"   data-callback="corpBankCallBack"
                         data-url="${basePath}/basic/business/btbanktype/json" data-valuefield="id" data-textfield="typeName" data-name="corpBank" ></div>
                </div>
            </td>
            ##交易对手银行
            <td class="textRight"  >#springMessage('fex.tranApp.cotpBank')</td>
            <td>
                <input class="layui-input" id="cotpBankName" name="fexCotpBankAccVO.bankName"  readonly="readonly" type="text" value="$!{tranDtlTmp.fexCotpBankAccVO.bankName}"/>
            </td>
        </tr>
        <tr>
            ##主体单位银行账户
            <td class="textRight"  width="20%">#springMessage('table.fexTranReq.corpBankAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="hidden" id="corpAccId" name="corpAccId" value="$!{tranDtlTmp.corpAccId}">
                    <input type="text" id="corpBankAcc" name="corpBankAcc" value="$!{tranDtlTmp.corpBankAcc}"   data-biz-name="corpBankAcc"
                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.corpBankAcc')">
                    <table id="corpBankAccTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.choBankFinance.acc')</th>
                            <th>#springMessage('table.btBankAccApp.accName')</th>
                            <th>#springMessage('table.btBankAcc.bankName')</th>
                            <th>#springMessage('table.nisBillhead.curId')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
            ##交易对手银行账户
            <td class="textRight" width="20%">#springMessage('table.fexForeign.cotpAcc')</td>
            <td>
                ##交易对手地址
                <input type="hidden" name="cotpPostAddr" id="cotpPostAddr" value="$!{tranDtlTmp.cotpPostAddr}">
                ##交易对手所在国家地区
                <input type="hidden" name="cotpCountry" id="cotpCountry" value="$!{tranDtlTmp.cotpCountry}">
                ##交易对手银行Swift Code
                <input type="hidden" name="fexCotpBankAccVO.bicCode" id="bicCode" value="$!{tranDtlTmp.fexCotpBankAccVO.bicCode}">
                ##本地清算号
                <input type="hidden" id="localClearNo" name="localClearNo" value="$!{tranDtlTmp.localClearNo}">
                #*   ##交易对手银行国家地区
                   <input type="text" class="layui-input" name="fexCotpBankAccVO.bankCountryId" id="bankCountryId" value="$!{tranDtlTmp.fexCotpBankAccVO.bankCountryId}">*#
                ##交易对手银行地址
                <input type="hidden" class="layui-input" name="fexCotpBankAccVO.bankAddr" id="bankAddr" value="$!{tranDtlTmp.fexCotpBankAccVO.bankAddr}">
                ##交易对手代理行
                <input type="hidden" class="layui-input" name="fexCotpBankAccVO.tranBank" id="tranBank" value="$!{tranDtlTmp.fexCotpBankAccVO.tranBank}">
                ##交易对手代理行地址
                <input type="hidden" class="layui-input" name="fexCotpBankAccVO.tranBankAddr" id="tranBankAddr" value="$!{tranDtlTmp.fexCotpBankAccVO.tranBankAddr}">
                ##交易对手代理行账户
                <input type="hidden" class="layui-input" name="fexCotpBankAccVO.tranBankAcc" id="tranBankAcc" value="$!{tranDtlTmp.fexCotpBankAccVO.tranBankAcc}">



                <input type="hidden" name="cotpAccId" id="cotpAccId" value="$!{tranDtlTmp.cotpAccId}">
                <input type="hidden" name="oppId" id="oppId" value="$!{tranDtlTmp.oppId}">
                <div class="layui-inline" id="externalDiv">##客商组件
                    <input type="hidden" name="fexCotpBankAccVO.accName" id="cotpAccName" value="$!{tranDtlTmp.fexCotpBankAccVO.accName}">
                    <input class="layui-input" id="cotpBankAcc" name="cotpBankAcc" lay-verify="required" readonly="readonly" type="text" value="$!{tranDtlTmp.cotpBankAcc}"/>
                    <div class="bt-div-search">
                        ## 客商组件
                        <button type="button" class="bt-biz-allExternalBankAcc" data-beforeClick="bt.externalBankAccBeforeClick"  data-callback="externalBankAccCallback">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##账户名称
            <td class="textRight">#springMessage('fex.mainCorpAccountName')</td>
            <td>
                <div class="layui-input-inline">
                    <span id="corpAccName">
                        $!{tranDtlTmp.corpBankAccName}
                    </span>
                </div>
            </td>
            ##交易对手(英文)
              <td class="textRight" width="20%">#springMessage('table.fexForeign.enCopt')</td>
              <td width="30%">
                 <input type="text" name="cotpNameEn" id="cotpNameEn" class="layui-input" value="$!{tranDtlTmp.cotpNameEn}" readonly>
              </td>
        </tr>
        <tr>
            ##主体单位账户币种
            <td class="textRight" width="20%">#springMessage('fex.mainCorpAccountBz')</td>
            <td width="30%">
                <input type="hidden" id="corpAccCurId" name="corpAccCurId" value="$!{tranDtlTmp.corpAccCurId}">
                <div id="corpAccCurNameDiv" name="corpAccCurNameDiv">$!{tranDtlTmp.corpAccEnglishCode}</div>
            </td>
            ##交易对手账户币种
            <td class="textRight" width="20%">#springMessage('table.fexForeign.cotpCurNameTran')</td>
            <td width="30%">
                <input type="hidden" id="cotpAccCurId" name="cotpAccCurId" value="$!{tranDtlTmp.cotpAccCurId}">
                <div id="cotpAccCurNameDiv" name="cotpAccCurNameDiv" >$!{tranDtlTmp.cotpAccEnglishCode}</div>
            </td>
        </tr>


        <tr>
            ## 支付类型
            <td class="textRight">#springMessage('ttpay.bussiness.payType')</td>
            <td>
                <div class="bt-biz-selectType"
                     data-url="${basePath}/basic/business/btbanktype/listByCondition?bankType=$!{template.bankTypeId}&bifCode=$!{template.bifId}&countryId=$!{template.countryId}&payTypeId=$!{template.payTypeId}"
                     data-biz-name="payTypeId" data-name="payTypeId" data-valueField="id"
                     data-textField="bankPayTypeDisplay" data-value="$!{tranDtlTmp.bankPayTypeId}"
                     data-callback="payTypeCallback" data-initCallback="payTypeInitCallback"></div>
            </td>

            ## 是否线下付款
            <td class="textRight">#springMessage('table.fexTranReq.isPayed')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                        #if($!{tranDtlTmp.isPayed})
                         data-value="$!{tranDtlTmp.isPayed}"
                        #else
                         data-value="0"
                        #end
                          data-name="isPayed" data-biz-name="isQuick"></div>
                </div>
            </td>
        </tr>

    </table>

    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        ##币种
                           <td class="textRight" width="20%"  >#springMessage('table.ratBkrationRelief.curCode')</td>
                           <td width="30%">
                               <div class="bt-biz-selectType" data-name="curId" data-url="${basePath}/basic/business/btcurrency/json"
                                    data-value="$!{tranDtlTmp.curId}"
                                    data-valuefield="id" data-textfield="englishCode"  data-required="true" data-callback="curCallBack" data-biz-name="curId"></div>
                           </td>
                        ##金额
                        <td class="textRight" width="20%">#springMessage('table.fcUnionAccbook.sendMoney')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" data-name="payMoney" lay-verify="required" data-biz-name="payMoney"
                                       value="$!{tranDtlTmp.payMoney}" class="layui-input bt-biz-moneyType">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##交易日期
                        <td class="textRight" width="20%">#springMessage('table.btNetChalk.transTime')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" name="tranDate" value="$!{tranDtlTmp.tranDate}" lay-verify="required" class="layui-input bt-biz-dateType" data-endid="settleDate" data-type="date" data-biz-name="tranDate">
                            </div>
                        </td>
                        ##结算日期
                        <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="settleDate" value="$!{tranDtlTmp.settleDate}" lay-verify="required" id="settleDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="settleDate">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('remark.lang')</td>
                        <td colspan="4">
                            <textarea lay-verify="strlength" name="rmk" data-maxlength = "50" class="layui-textarea">$!{tranDtlTmp.rmk}</textarea>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('cms.loan.attachment')</td>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input type="hidden" name="attachmentId" id="gid" value="$!{tranDtlTmp.attachmentId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" style="text-align: center">
                            <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.save')</button>
                            <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage(
                                'common.button.close')</button>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>
</body>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/fexTranApp/addTranReqDtl10.js?_btv=${resourceVersion}"></script>
</html>

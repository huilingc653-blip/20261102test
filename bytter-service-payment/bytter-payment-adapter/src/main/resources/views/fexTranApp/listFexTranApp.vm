<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
        ##            申请编号
            <td width="10%" class="textRight">#springMessage('table.fcAgreedDeposit.billNo')</td>
            <td width="40%">
                <div class="layui-inline">
                    <input type="text" name="likes_billNo" class="layui-input" >
                </div>
            </td>
        ##            单位
            <td width="10%" class="textRight">#springMessage('table.fbsBudget.corpId')</td>
            <td width="40%">
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-biz-name="corpIds" data-name="corpIds" data-tree-type="check" data-resource="foreign:fex:tranApp:query"
                         data-biz-type="corp" data-type="selectTree"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##    申请日期
            <td width="10%" class="textRight">#springMessage('bill.accebill.applyDate')</td>
            <td width="40%">
                <div class="layui-inline">
                    <input type="text" name="eqd_appDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="createDate">
                </div>
            </td>
        ##    状态
            <td width="10%" class="textRight">#springMessage('table.fbsBudget.status')</td>
            <td width="40%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="fex.status" data-name="eqg_status" data-biz-name="status" data-filterData="-2,-3,11,95"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
    ##        申请编号
        <th>#springMessage('table.fcAgreedDeposit.billNo')</th>
    ##单位
        <th>#springMessage('table.fbsBudget.corpId')</th>
    ##申请日期
        <th>#springMessage('bill.accebill.applyDate')</th>
    ##状态
        <th>#springMessage('table.fbsBudget.status')</th>
    ##    操作
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
</body>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/fexTranApp/listFexTranApp.js?_btv=${resourceVersion}"></script>
</html>
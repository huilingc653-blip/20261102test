<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
##外汇买卖-----------资金收付

<form class="layui-form" method="post" id="myform">

    <table class="layui-table layui-form" style="margin: 0px;padding: 0px">
        <tr>
        ##                交易类型
            <td class="textRight"  width="20%" colspan="2">#springMessage('table.foreign.tranType')</td>
            <td width="30%" colspan="4">
                $dictTag.get("fex.tranApp.tranType",$!{tranDtl.tranType})
            </td>
        ##                是否掉期交易
#*            <td class="textRight" width="20%"><div name="isSwaptTran" #if($!{tranDtl.tranType} == 4)style="display: none" #end>#springMessage('table.fexTranReq.isSwapTran')</div></td>
            <td width="30%">
                <div class="layui-inline" name="isSwaptTran" #if($!{tranDtl.tranType} == 4)style="display: none" #end>
                    $dictTag.get("sf_yn",$!{tranDtl.isSwaptTran})
                </div>
            </td>*#
        <tr>
        <tr>
        ##产品
            <td class="textRight" width="20%" colspan="2">#springMessage('table.foreign.product')</td>
            <td width="30%">
                <div class="layui-inline">
                    $!{pro.proName}
                </div>
            </td>
            ##交易号码
            <td class="textRight" width="20%" colspan="2">#springMessage('table.fexTranReq.billNo')</td>
            <td width="30%">
                <a class="" href="#" onclick="view('$!{tranDtl.tranReqId}')">$!{tranDtl.tranReqBillNo}</a>
            </td>
        </tr>
        <tr>
            ##收付方向
            <td class="textRight" width="20%" colspan="2">#springMessage('table.foreign.cdSign')</td>
            <td>
                <div class="layui-input-inline">
                    $dictTag.get("fexCorp.cdSign",$!{tranDtl.cdSign})
                </div>
            </td>
            ##币种
            <td class="textRight" width="20%" colspan="2">#springMessage('table.ratBkrationRelief.curCode')</td>
            <td width="30%">
                $!{tranDtl.curEnCode}
            </td>
        </tr>
        <tr>
            ##汇款类型
            <td class="textRight" width="20%" colspan="2">#springMessage('table.fexForeignReq.remitType')</td>
            <td colspan="4">
                <div class="layui-input-inline">
                    $dictTag.get("fexForeignReq.remitType",$!{tranDtl.remitType})
                </div>
            </td>
        </tr>
        <tr>
            <td rowspan="11" width="5%" align="center">#springMessage('table.fexTranReq.corpInfo')</td>
            ##主体单位银行
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.corpBank')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    $!{tranDtl.corpBankName}
                </div>
            </td>
            <td rowspan="11" width="5%" align="center">#springMessage('table.fexTranReq.cotpInfo')</td>
            ##交易对手
            <td class="textRight" width="15%">#springMessage('table.fexForeign.copt')</td>
            <td width="30%">
                <div class="layui-inline">
                    $!{tranDtl.cotpName}
                </div>
            </td>
        </tr>
        <tr>
            ##主体单位银行账户
            <td class="textRight" width="15%">#springMessage('table.fexTranReq.corpBankAcc')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    $!{tranDtl.corpBankAcc}
                </div>
            </td>
            ##交易对手银行
            <td class="textRight" width="15%">#springMessage('fex.tranApp.cotpBank')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    $!{tranDtl.fexCotpBankAccVO.bankName}
                </div>
            </td>
        </tr>
        <tr>
            ##账户币种
            <td class="textRight" width="15%">#springMessage('table.fexForeign.cotpCurName')</td>
            <td width="30%">
                <div id="corpAccCurNameDiv" name="corpAccCurNameDiv">$!{tranDtl.corpAccEnglishCode}</div>
            </td>
            ##账户币种
            <td class="textRight" width="15%">#springMessage('table.fexForeign.cotpCurName')</td>
            <td width="30%">
                <div id="cotpAccCurNameDiv" name="cotpAccCurNameDiv">$!{tranDtl.cotpAccEnglishCode}</div>
            </td>
        </tr>
        <tr>
            ##账户名称
            <td class="textRight">#springMessage('table.btBankAccApp.accName')</td>
            <td>
                <div class="layui-input-inline">
                        <span id="corpAccName">
                            $!{tranDtl.corpBankAccName}
                        </span>
                </div>
            </td>
            ##交易对手银行账户
            <td class="textRight">#springMessage('table.fexForeign.cotpAcc')</td>
            <td>
                <div class="layui-input-inline">
                    $!{tranDtl.cotpBankAcc}
                </div>
            </td>
        </tr>
        <tr>
            ##主体单位名称(英文)
            <td class="textRight">#springMessage('table.fexTranReq.corpNameEn')</td>
            <td>
                <div class="layui-input-inline">
                    $!{tranDtl.corpNameEn}
                </div>
            </td>
            ##交易对手地址
            <td class="textRight">#springMessage('fex.tranApp.cotpAddr')</td>
            <td>
                <div class="layui-input-inline">
                    <span id="postAddr">
                        $!{tranDtl.cotpPostAddr}
                    </span>
                </div>
            </td>
        </tr>
        <tr>
            ##主体单位地址(英文)
            <td class="textRight">#springMessage('table.fexTranReq.corpAddrEn')</td>
            <td>
                <div class="layui-input-inline">
                    $!{tranDtl.corpAddEn}
                </div>
            </td>
            ##交易对手所在国家地区
            <td class="textRight">#springMessage('table.fexTranReq.cotpCountry')</td>
            <td>
                <div class="layui-input-inline">
                    <span id="country">$!{tranDtl.countryArea}</span>
                </div>
            </td>
        </tr>
        <tr>
            ##主体单位地址(中文)
            <td class="textRight">#springMessage('table.fexTranReq.corpAddr')</td>
            <td>
                <div class="layui-input-inline">
                    $!{tranDtl.corpAddr}
                </div>
            </td>
            ##交易对手银行Swift Code
            <td class="textRight">#springMessage('table.fexTranReq.cotpSwiftCode')</td>
            <td>
                <div class="layui-input-inline">
                    <span id="swiftCode">$!{tranDtl.cotpSwiftCode}</span>
                </div>
            </td>
        </tr>
        <tr>
            ##主体单位联系人
            <td class="textRight">#springMessage('table.fexTranReq.corpContact')</td>
            <td>
                <div class="layui-input-inline">
                    $!{tranDtl.corpContact}
                </div>
            </td>
            ##交易对手银行地址
            <td class="textRight">#springMessage('table.fexTranReq.cotpBankAdrr')</td>
            <td>
                <div class="layui-input-inline">
                    <span id="cotpbankAddr">$!{tranDtl.fexCotpBankAccVO.bankAddr}</span>
                </div>
            </td>
        </tr>
        <tr>
            ##主体单位联系电话
            <td class="textRight">#springMessage('fex.tranApp.mainCorpTel')</td>
            <td>
                <div class="layui-input-inline">
                    $!{tranDtl.corpContactTel}
                </div>
            </td>
            ##交易对手代理行
            <td class="textRight">#springMessage('fex.tranApp.cotpAgentBank')</td>
            <td>
                <div class="layui-input-inline">
                    <span id="agentBank">$!{tranDtl.fexCotpBankAccVO.tranBank}</span>
                </div>
            </td>
        </tr>
        <tr>
            ##被代收/代付单位
            <td class="textRight">#springMessage('table.fexTranReq.payCorpId')</td>
            <td>
                <div class="layui-input-inline">
                    $!{tranDtl.payCorpName}
                </div>
            </td>
            ##交易对手代理行地址
            <td class="textRight">#springMessage('table.fexTranReq.agentBankAddr')</td>
            <td>
                <div class="layui-input-inline">
                    <span id="agentBankAddr">$!{tranDtl.cotpTranBankAddr}</span>
                </div>
            </td>
        </tr>
        <tr>
            ##加急标识
            <td class="textRight">#springMessage('table.nisBillhead.isQuick')</td>
            <td>
                <div class="layui-input-inline">
                    $dictTag.get("sf_yn",$!{tranDtl.isQuick})
                </div>
            </td>
            ##交易对手代理行账户
            <td class="textRight">#springMessage('fex.tranApp.cotpAgentBankAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <span id="agentBankAcc">$!{tranDtl.cotpTranBankAcc}</span>
                </div>
            </td>
        </tr>
    </table>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        ##金额
                        <td class="textRight" width="20%">#springMessage('table.fcUnionAccbook.sendMoney')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                $!number.formatNumeric($!{tranDtl.payMoney})
                            </div>
                        </td>
                        ##交易日期
                        <td class="textRight" width="20%">#springMessage('table.btNetChalk.transTime')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                $date.format("yyyy-MM-dd",$!{tranDtl.tranDate})
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##结算日期
                        <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                        <td>
                            <div class="layui-input-inline">
                                $date.format("yyyy-MM-dd",$!{tranDtl.settleDate})
                            </div>
                        </td>
                        ##汇款类型
                        <td class="textRight">#springMessage('table.fexForeignReq.remitMethod')</td>
                        <td>
                            <div class="layui-input-inline">
                                $dictTag.get("fexForeignReq.remitMethod",$!{tranDtl.remitMethod})
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.fexTranReq.costInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        ##国内外费用承担
                        <td class="textRight" width="20%">#springMessage('table.fexForeignReq.costSign')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                $dictTag.get("fexForeignReq.costSign",$!{tranDtl.costSign})
                            </div>
                        </td>
                        ##费用支出账户
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.costAcc')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                $!{tranDtl.costAcc}
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('fex.fexTranReqPay.reportInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        ##最迟装运日期
                        <td class="textRight" width="20%">#springMessage('table.fexForeignReq.shipDate')</td>
                        <td colspan="3">
                            <div class="layui-input-inline">
                                $!date.format("yyyy-MM-dd",$!{tranDtl.shipDate})
                            </div>
                        </td>
                    </tr>
                    <tr>
                    ##是否为保税货物项付款
                        <td class="textRight">#springMessage('table.fexForeignReq.isBonded')</td>
                        <td>
                            <div class="layui-input-inline">
                                $dictTag.get("sf_yn",$!{tranDtl.isBonded})
                            </div>
                        </td>
                    ##外汇局批件号/备案表号/业务编号
                        <td class="textRight">#springMessage('fex.tranApp.ApprovalNo')</td>
                        <td>
                            <div class="layui-input-inline">
                                $!{tranDtl.busNo}
                            </div>
                        </td>
                    </tr>
                    <tr>
                    ##合同号
                        <td class="textRight">#springMessage('table.fbsBudgetDetail.contract')</td>
                        <td>
                            <div class="layui-input-inline">
                                $!{tranDtl.contractNo}
                            </div>
                        </td>
                    ##发票号
                        <td class="textRight">#springMessage('table.fexForeignReq.invoiceNo')</td>
                        <td>
                            <div class="layui-input-inline">
                                $!{tranDtl.invoiceNo}
                            </div>
                        </td>
                    </tr>
                    <tr>
                    ##交易编码1
                        <td class="textRight">#springMessage('table.fexForeignReq.tranCode1')</td>
                        <td>
                            <div class="layui-input-inline">
                                $!{tranDtl.tranCode1Name}
                            </div>
                        </td>
                    ##交易编码2
                        <td class="textRight">#springMessage('table.fexForeignReq.tranCode2')</td>
                        <td>
                            <div class="layui-input-inline">
                                $!{tranDtl.tranCode2Name}
                            </div>
                        </td>
                    </tr>
                    <tr>
                    ##相应金额1
                        <td class="textRight">#springMessage('table.fexForeignReq.tranAmt1')</td>
                        <td>
                            <div class="layui-input-inline">
                                $!number.formatNumeric($!{tranDtl.tranAmt1})
                            </div>
                        </td>
                    ##相应金额2
                        <td class="textRight">#springMessage('table.fexForeignReq.tranAmt2')</td>
                        <td>
                            <div class="layui-input-inline">
                                $!number.formatNumeric($!{tranDtl.tranAmt2})
                            </div>
                        </td>
                    </tr>
                    <tr>
                    ##相应币种1
                        <td class="textRight" width="20%">#springMessage('table.fexForeignReq.tranCurId1')</td>
                        <td width="30%">
                            $!{tranDtl.tranCurId1EnCode}
                        </td>
                    ##相应币种2
                        <td class="textRight" width="20%">#springMessage('table.fexForeignReq.tranCurId2')</td>
                        <td width="30%">
                            $!{tranDtl.tranCurId2EnCode}
                        </td>
                    </tr>
                    <tr>
                    ##交易附言1
                        <td class="textRight">#springMessage('table.fexForeignReq.tranAddWord1')</td>
                        <td>
                            <div class="layui-input-inline">
                                $!{tranDtl.tranAddWord1}
                            </div>
                        </td>
                    ##交易附言2
                        <td class="textRight">#springMessage('table.fexForeignReq.tranAddWord2')</td>
                        <td>
                            <div class="layui-input-inline">
                                $!{tranDtl.tranAddWord2}
                            </div>
                        </td>
                    </tr>
                    <tr>
                    ##备注
                        <td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
                        <td colspan="4">
                            $!{tranDtl.rmk}
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('cms.loan.attachment')</td>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input type="hidden" name="attachmentId" id="gid" value="$!{tranDtl.attachmentId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" style="text-align: center">
                            <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
                        </td>
                    </tr>
            </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('cms.loan.OtherInfo')</h2>
            <div class="layui-colla-content layui-show" id="otherInfoDiv">
                <table class="layui-table">
                    <tr>
                        ##付款类型
                        <td class="textRight" width="20%">#springMessage('table.fexForeignReq.payType')</td>
                        <td colspan="3">
                            <div class="layui-input-inline">
                                $dictTag.get("fexForeignReq.payType",$!{tranDtl.payType})
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>
</body>
    #parse("views/common/footer.vm")
<script>

    bt.use(["jquery", "form", "btUpload"], function () {
        $ = bt.jquery;
        form = bt.form();
        var gid = $("#gid").val();
        upload = bt.btUpload.init({
            elem: "#uploader",
            hasDelete: false,
            hasUpload: false,
            isExpand: true,
            auto: false,
            gid: gid
        });

        /**
         * 查看
         * @param id
         */
        view = function (id) {
            if (bt.navtab) {
                bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/foreign/fextranreq/view/" + id);
                return;
            }
            parent.layer.open({
                type: 2,
                area: ['850px', '530px'],
                maxmin: true,
                content: basePath + "/foreign/fextranreq/view/" + id
            });
        }
    });
    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }
</script>
</html>

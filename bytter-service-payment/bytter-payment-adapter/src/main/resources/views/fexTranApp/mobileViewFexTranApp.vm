<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view">
##                单位
    <li class="mui-table-view-cell">
        #springMessage('table.abBillTransfer.applyCorp')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranAppVo.corpName}
        </span>
    </li>
##                交易需求描述
    <li class="mui-table-view-cell">
        #springMessage('fex.tranApp.reqRmk')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranAppVo.rmk}
        </span>
    </li>

##                申请日期
    <li class="mui-table-view-cell">
        #springMessage('bill.accebill.applyDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format("yyyy-MM-dd",$!{fexTranAppVo.appDate})
        </span>
    </li>

    #foreach($tranDtl in $!{tranDtls})
        #if($!{tranDtl.tranType} == 1)
            #if($!{tranDtl.isSwaptTran} != 1)
                <ul class="mui-table-view">
                    <li class="mui-table-view-cell mui-collapse">
##                        外汇买卖
                        <a class="mui-navigate-right" href="#">$dictTag.get("fex.tranApp.tranType",$!{tranDtl.tranType})</a>
                        <div class="mui-collapse-content">
                            <ul class="mui-table-view">
                            ##                交易类型
                                <li class="mui-table-view-cell">
                                    #springMessage('table.foreign.tranType')
                                    <span class="mui-badge mui-badge-inverted">
                                        $dictTag.get("fex.tranApp.tranType",$!{tranDtl.tranType})
                                    </span>
                                </li>
                            ##                是否掉期交易
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranReq.isSwapTran')
                                    <span class="mui-badge mui-badge-inverted">
                                        $dictTag.get("sf_yn",$!{tranDtl.isSwaptTran})
                                    </span>
                                </li>
                            ##                产品
                                <li class="mui-table-view-cell">
                                    #springMessage('table.foreign.product')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.proName}
                                    </span>
                                </li>
                            ##                外汇业务类型
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexProduct.fexBusType')
                                    <span class="mui-badge mui-badge-inverted">
                                        $dictTag.get("fexProduct.fexBusType",$!{tranDtl.fexBusType})
                                    </span>
                                </li>
                            ##                外汇交易类型
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexProduct.fexTranType')
                                    <span class="mui-badge mui-badge-inverted">
                                        $dictTag.get("fexProduct.fexTranType",$!{tranDtl.fexTranType})
                                    </span>
                                </li>
                            ##                交割类型
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexProduct.deliveryType')
                                    <span class="mui-badge mui-badge-inverted">
                                        $dictTag.get("fexProduct.deliveryType",$!{tranDtl.deliveryType})
                                    </span>
                                </li>
                                #if($!{tranDtl.deliveryType} == 1)
                                ##                交割币种
                                    <li class="mui-table-view-cell">
                                        #springMessage('fex.tranApp.deliveryCurId')
                                        <span class="mui-badge mui-badge-inverted">
                                            $!{tranDtl.deliveryCurEnCode}
                                        </span>
                                    </li>
                                #end
                            ##                汇款类型
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexForeignReq.remitType')
                                    <span class="mui-badge mui-badge-inverted">
                                        $dictTag.get("fexForeignReq.remitType",$!{tranDtl.remitType})
                                    </span>
                                </li>
                            ##                固定金额
                                <li class="mui-table-view-cell">
                                    #springMessage('fex.tranApp.FixedAmount')
                                    <span class="mui-badge mui-badge-inverted">
                                        $dictTag.get("fex.tranApp.fixMoney",$!{tranDtl.fixedMoney})
                                    </span>
                                </li>

                            ##                是否自动计算买入金额
                                <li class="mui-table-view-cell mui-checkbox">
                                    <label>#springMessage('fex.tranApp.autoCal')</label>
                                    <input name="checkbox1" type="checkbox" #if($!{tranDtl.autoCal})
                                           checked
                                    #end
                                           disabled="disabled">
                                </li>
                            ##                买入币种
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranReq.buyCurId')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.buyCurEnCode}
                                    </span>
                                </li>
                            ##                买入金额
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranReq.buyMoney')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!number.formatNumeric($!{tranDtl.buyMoney})
                                    </span>
                                </li>
                            ##                卖出币种
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranReq.sellCurId')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.sellCurEnCode}
                                    </span>
                                </li>
                            ##                卖出金额
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranReq.sellMoney')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!number.formatNumeric($!{tranDtl.sellMoney})
                                    </span>
                                </li>
                            ##                期望汇率
                                <li class="mui-table-view-cell">
                                    #springMessage('fex.tranApp.wishRate')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!number.formatDoubles($!{tranDtl.wishRate},6)
                                    </span>
                                </li>
                            ##                交易编码
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranInfo.tranCode')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.tranCode1Name}
                                    </span>
                                </li>
                            ##                钞汇标识
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranReq.bankNote')
                                    <span class="mui-badge mui-badge-inverted">
                                        $dictTag.get("fex.tranApp.bankNote",$!{tranDtl.bankNote})
                                    </span>
                                </li>
                            ##                交易日期
                                <li class="mui-table-view-cell">
                                    #springMessage('table.btNetChalk.transTime')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!date.format("yyyy-MM-dd",$!{tranDtl.tranDate})
                                    </span>
                                </li>
                            ##                结算日期
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fcSubjectDay.optDate')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!date.format("yyyy-MM-dd",$!{tranDtl.settleDate})
                                    </span>
                                </li>
                            ##                交割期限
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranReq.deliveryDeadline')
                                    <span class="mui-badge mui-badge-inverted">
                                        #if($!{tranDtl.deliveryDeadline})
                                        T+$!{tranDtl.deliveryDeadline}
                                        #end
                                    </span>
                                </li>
                            ##                保证方式
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranReq.boodType')
                                    <span class="mui-badge mui-badge-inverted">
                                        $dictTag.get("fex.tranApp.boodType",$!{tranDtl.boodType})
                                    </span>
                                </li>

                            ##                保证金账号
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranReq.boodAcc')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.boodAcc}
                                    </span>
                                </li>
                            ##                保证金比例
                                <li class="mui-table-view-cell">
                                    #springMessage('fex.tranApp.boodRatio')
                                    <span class="mui-badge mui-badge-inverted">
                                        #if($!{tranDtl.boodRatio})
                                            $!number.formatNumeric($math.mul($!{tranDtl.boodRatio},100),"#0.00")%
                                        #end
                                    </span>
                                </li>
                            ##                保证金钞汇标识
                                <li class="mui-table-view-cell">
                                    #springMessage('fex.tranApp.bondBankNote')
                                    <span class="mui-badge mui-badge-inverted">
                                        $dictTag.get("fex.tranApp.bankNote",$!{tranDtl.boodBankNote})
                                    </span>
                                </li>
                            ##                保证金币种
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranReq.bondCurId')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.bondCurEnCode}
                                    </span>
                                </li>
                            ##                合同号
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fbsBudgetDetail.contract')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.contractNo}
                                    </span>
                                </li>
                            ##                额度
                                <li class="mui-table-view-cell">
                                    #springMessage('table.guaContract.trackMoney')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!number.formatNumeric($!{tranDtl.payMoney})
                                    </span>
                                </li>
                            ##                外汇局批件号/备案表号/业务编号
                                <li class="mui-table-view-cell">
                                    #springMessage('fex.tranApp.ApprovalNo')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.busNo}
                                    </span>
                                </li>
                                #if($!{tranDtl.fexBusType} == 1)
                                ##                结汇资金详细用途
                                    <li class="mui-table-view-cell">
                                        #springMessage('table.fexTranReq.purpose')
                                        <span class="mui-badge mui-badge-inverted">
                                            $dictTag.get("fex.tranApp.purpose",$!{tranDtl.purpose})
                                        </span>
                                    </li>
                                ##                结汇资金详细用途
                                    <li class="mui-table-view-cell">
                                        #springMessage('table.fexTranReq.purposeDtl')
                                        <span class="mui-badge mui-badge-inverted">
                                            $!{tranDtl.purposeDtl}
                                        </span>
                                    </li>
                                #end
                            ##                资金来源
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranReq.fundsSource')
                                    <span class="mui-badge mui-badge-inverted">
                                        $dictTag.get("fex.tranApp.fundsSource",$!{tranDtl.fundsSource})
                                    </span>
                                </li>
                            ##                发票号
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexForeignReq.invoiceNo')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.invoiceNo}
                                    </span>
                                </li>
                            ##                资金性质
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fexTranReq.accNature')
                                    <span class="mui-badge mui-badge-inverted">
                                        $dictTag.get("fexTranReq.accNature",$!{tranDtl.accNature})
                                    </span>
                                </li>
                                #if($!{tranDtl.fexBusType} != 3)
                                ##                结售汇属性
                                    <li class="mui-table-view-cell">
                                        #springMessage('table.fexTranReq.fexProp')
                                        <span class="mui-badge mui-badge-inverted">
                                            #if($!{tranDtl.fexBusType} == 1)
                                            $dictTag.get("fex.tranApp.fexProp",$!{tranDtl.fexProp})
                                            #elseif($!{tranDtl.fexBusType} == 2)
                                                $dictTag.get("fex.tranApp.fexProp2",$!{tranDtl.fexProp})
                                            #end
                                        </span>
                                    </li>
                                #end
                            ##                联系人
                                <li class="mui-table-view-cell">
                                    #springMessage('table.externalCorp.linkMan')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.corpContacts}
                                    </span>
                                </li>
                            ##                联系电话
                                <li class="mui-table-view-cell">
                                    #springMessage('sys.user.phone.show')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.corpContactsTel}
                                    </span>
                                </li>
                            ##                其他保证方式说明
                                <li class="mui-table-view-cell">
                                    #springMessage('fex.tranApp.otherBondRmk')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.boodRmk}
                                    </span>
                                </li>
                            ##                申请人
                                <li class="mui-table-view-cell">
                                    #springMessage('bill.accebill.applyName')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{fexTranAppVo.createUserName}
                                    </span>
                                </li>
                            ##                备注
                                <li class="mui-table-view-cell">
                                    #springMessage('table.fbsBudgetPeriod.rmk')
                                    <span class="mui-badge mui-badge-inverted">
                                        $!{tranDtl.rmk}
                                    </span>
                                </li>
                            </ul>
                        </div>
                    </li>
                </ul>
                #else
                    <ul class="mui-table-view">
                        <li class="mui-table-view-cell mui-collapse">
##                            外汇买卖掉期交易
                            <a class="mui-navigate-right" href="#">$dictTag.get("fex.tranApp.tranType",$!{tranDtl.tranType})</a>
                            <div class="mui-collapse-content">
                                <div class="mui-content">
                                    <div id="segmentedControl" class="mui-segmented-control">
                                        <a class="mui-control-item mui-active" href="#item1">
                                            #springMessage('fex.tranApp.near')
                                        </a>
                                        <a class="mui-control-item" href="#item2">
                                            #springMessage('fex.tranApp.remote')
                                        </a>
                                    </div>
                                    <div id="item1" class="mui-control-content mui-active">
                                        <ul class="mui-table-view">
                                        ##                交易类型
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.foreign.tranType')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $dictTag.get("fex.tranApp.tranType",$!{tranDtl.tranType})
                                                </span>
                                            </li>
                                        ##                是否掉期交易
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexTranReq.isSwapTran')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $dictTag.get("sf_yn",$!{tranDtl.isSwaptTran})
                                                </span>
                                            </li>
                                        ##                产品
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.foreign.product')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $!{tranDtl.proName}
                                                </span>
                                            </li>
                                        ##                外汇业务类型
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexProduct.fexBusType')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $dictTag.get("fexProduct.fexBusType",$!{tranDtl.fexBusType})
                                                </span>
                                            </li>
                                        ##                外汇交易类型
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexProduct.fexTranType')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $dictTag.get("fexProduct.fexTranType",$!{tranDtl.fexTranType})
                                                </span>
                                            </li>
                                        ##                交割类型
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexProduct.deliveryType')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $dictTag.get("fexProduct.deliveryType",$!{tranDtl.deliveryType})
                                                </span>
                                            </li>
                                            #if($!{tranDtl.deliveryType} == 1)
                                            ##                交割币种
                                                <li class="mui-table-view-cell">
                                                    #springMessage('fex.tranApp.deliveryCurId')
                                                    <span class="mui-badge mui-badge-inverted">
                                                        $!{tranDtl.deliveryCurEnCode}
                                                    </span>
                                                </li>
                                            #end
                                        ##                汇款类型
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexForeignReq.remitType')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $dictTag.get("fexForeignReq.remitType",$!{tranDtl.remitType})
                                                </span>
                                            </li>
                                        ##                固定金额
                                            <li class="mui-table-view-cell">
                                                #springMessage('fex.tranApp.FixedAmount')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $dictTag.get("fex.tranApp.fixMoney",$!{tranDtl.fixedMoney})
                                                </span>
                                            </li>
                                        ##                是否自动计算买入金额
                                            <li class="mui-table-view-cell mui-checkbox">
                                                <label>#springMessage('fex.tranApp.autoCal')</label>
                                                <input name="checkbox1" type="checkbox"
                                                    #if($!{tranDtl.autoCal})
                                                       checked
                                                    #end
                                                       disabled="disabled">
                                            </li>
                                        ##                买入币种
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexTranReq.buyCurId')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $!{tranDtl.buyCurEnCode}
                                                </span>
                                            </li>
                                        ##                买入金额
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexTranReq.buyMoney')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $!number.formatNumeric($!{tranDtl.buyMoney})
                                                </span>
                                            </li>
                                        ##                卖出币种
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexTranReq.sellCurId')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $!{tranDtl.sellCurEnCode}
                                                </span>
                                            </li>
                                        ##                卖出金额
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexTranReq.sellMoney')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $!number.formatNumeric($!{tranDtl.sellMoney})
                                                </span>
                                            </li>
                                        ##                期望汇率
                                            <li class="mui-table-view-cell">
                                                #springMessage('fex.tranApp.wishRate')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $!number.formatDoubles($!{tranDtl.wishRate},6)
                                                </span>
                                            </li>
                                        ##                交易编码
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexTranInfo.tranCode')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $!{tranDtl.tranCode1Name}
                                                </span>
                                            </li>
                                        ##                钞汇标识
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexTranReq.bankNote')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $dictTag.get("fex.tranApp.bankNote",$!{tranDtl.bankNote})
                                                </span>
                                            </li>
                                        ##                交易日期
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.btNetChalk.transTime')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $!date.format("yyyy-MM-dd",$!{tranDtl.tranDate})
                                                </span>
                                            </li>
                                        ##                结算日期
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fcSubjectDay.optDate')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $!date.format("yyyy-MM-dd",$!{tranDtl.settleDate})
                                                </span>
                                            </li>
                                        ##                交割期限
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexTranReq.deliveryDeadline')
                                                <span class="mui-badge mui-badge-inverted">
                                                    #if($!{tranDtl.deliveryDeadline})
                                        T+$!{tranDtl.deliveryDeadline}
                                                    #end
                                                </span>
                                            </li>
                                        ##                保证方式
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexTranReq.boodType')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $dictTag.get("fex.tranApp.boodType",$!{tranDtl.boodType})
                                                </span>
                                            </li>

                                        ##                保证金账号
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexTranReq.boodAcc')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $!{tranDtl.boodAcc}
                                                </span>
                                            </li>
                                        ##                保证金比例
                                            <li class="mui-table-view-cell">
                                                #springMessage('fex.tranApp.boodRatio')
                                                <span class="mui-badge mui-badge-inverted">
                                                    #if($!{tranDtl.boodRatio})
                                                        $!number.formatNumeric($math.mul($!{tranDtl.boodRatio},100),"#0.00")%
                                                    #end
                                                </span>
                                            </li>
                                        ##                保证金钞汇标识
                                            <li class="mui-table-view-cell">
                                                #springMessage('fex.tranApp.bondBankNote')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $dictTag.get("fex.tranApp.bankNote",$!{tranDtl.boodBankNote})
                                                </span>
                                            </li>
                                        ##                保证金币种
                                            <li class="mui-table-view-cell">
                                                #springMessage('table.fexTranReq.bondCurId')
                                                <span class="mui-badge mui-badge-inverted">
                                                    $!{tranDtl.bondCurEnCode}
                                                </span>

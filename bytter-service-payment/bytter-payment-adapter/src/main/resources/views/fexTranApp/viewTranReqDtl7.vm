<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/fexTranApp/viewBreakStyle.vm")
</head>
<body>
    ##外汇买卖-----------非掉期交易
<form class="layui-form" method="post" id="myform">
    #if($!{swapType})
        ##        近/远端  1-近端，2-远端
        <input type="hidden" id="swapType" name="swapType" value="$!{swapType}">
        <input type="hidden" id="partnerId" name="partnerId" value="$!{tranDtlTmp.partnerId}">
    #end
    #if($!{tranDtlTmp.id})
        <input type="hidden" id="id" name="id" value="$!{tranDtlTmp.id}">
    #end
    ##    产品id
    <input type="hidden" name="proId" id="proId" value="$!{pro.id}">
    ##    单位id
    <input type="hidden" name="corpId" id="corpId" value="$!{corpId}">
    ##    外汇业务类型
    <input type="hidden" class="layui-input" name="fexBusType" id="fexBusType" value="$!{pro.fexBusType}">
    ##    外汇交易类型
    <input type="hidden" class="layui-input" name="fexTranType" id="fexTranType" value="$!{pro.fexTranType}">
    ##    交易类型
    <input type="hidden" class="layui-input" name="tranType" id="tranType" value="$!{tranType}">
    ##    交割类型
    <input type="hidden" class="layui-input" name="deliveryType" id="deliveryType" value="$!{pro.deliveryType}">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranProductInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table view-break-table layui-form">
                    <tr>
                        ##外汇业务类型
                        <td class="textRight" width="20%">#springMessage('table.fexProduct.fexBusType')</td>
                        <td width="30%">
                            $dictTag.get("fex.tranApp.tranType",$!{tranDtl.tranType})
                        </td>
                        ##外汇交易类型
                        <td class="textRight" width="20%">#springMessage('table.fexProduct.fexTranType')</td>
                        <td width="30%">
                            $dictTag.get("fexProduct.fexTranType",$!{tranDtl.fexTranType})
                        </td>
                    </tr>
                    <tr>
                        ##交割类型
                        <td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
                        <td>
                            $dictTag.get("fexProduct.deliveryType",$!{tranDtl.deliveryType})
                        </td>
                        #if($!{pro.deliveryType} == 1)
                            ##交割币种
                            <td class="textRight"><div name="deliveryCurIdDiv">#springMessage('fex.tranApp.deliveryCurId')</div></td>
                            <td>
                                $!{tranDtl.deliveryCurName}
                            </td>
                        #else
                            <td></td>
                            <td></td>
                        #end
                    </tr>
                    ##结汇业务类型
                    #if($!{pro.fexBusType} == 1)
                        <tr>
                            <td class="textRight">
                                #springMessage('fex.tran.settleBusType')
                            </td>
                            <td colspan="3">
                                $dictTag.get("fex.tran.settleBusType",$!{tranDtl.settleBusType})
                            </td>
                        </tr>
                    #end
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table view-break-table layui-form">
                    <tr>
                        ##交易货币对
                        <td class="textRight" width="20%">#springMessage('fex.tranApp.tranCurPair')</td>
                        <td width="30%">
                            $!{tranDtl.currencyPair}
                        </td>
                        ##买卖方向
                        <td class="textRight" width="20%">#springMessage('fex.tranApp.busDirection')</td>
                        <td width="30%">
                            $dictTag.get("fex.tranApp.busDirection",$!{tranDtl.busDirection})
                        </td>
                    </tr>
                    ##固定买入金额
                    <tr>
                        <td class="textRight" width="20%">#springMessage('fex.tranApp.FixedAmount')</td>
                        <td width="30%">
                            $dictTag.get("fex.tranApp.fixMoney",$!{tranDtl.fixedMoney})
                        </td>
                        ##是否线下交易
                        <td class="textRight" width="20%">#springMessage('fex.tranApp.isPayed')</td>
                        <td width="30%">
                            $dictTag.get("sf_yn",$!{tranDtl.isPayed})
                        </td>
                    </tr>
                    <tr>
                        ##买入币种
                        <td class="textRight">#springMessage('table.fexTranReq.buyCurId')</td>
                        <td>
                            $!{tranDtl.buyCurEnCode}
                        </td>
                        ##卖出币种
                        <td class="textRight">#springMessage('table.fexTranReq.sellCurId')</td>
                        <td>
                            $!{tranDtl.sellCurEnCode}
                        </td>
                    </tr>
                    <tr>
                        ##买入金额
                        <td class="textRight">#springMessage('table.fexTranReq.buyMoney')</td>
                        <td>
                            #if($!{tranDtl.buyMoney})
                                $number.formatNumeric($!{tranDtl.buyMoney})
                            #end
                        </td>
                        ##卖出金额
                        <td class="textRight">#springMessage('table.fexTranReq.sellMoney')</td>
                        <td>
                            #if($!{tranDtl.sellMoney})
                                $number.formatNumeric($!{tranDtl.sellMoney})
                            #end
                        </td>
                    </tr>
                    <tr>
                        ##报价方式
                        <td class="textRight">#springMessage('fex.tranApp.quotationMethod')</td>
                        <td>  $!{tranDtl.currencyPair}
                           ## $!{tranDtl.quotationMethod1}/$!{tranDtl.quotationMethod2}
                        </td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                    <tr>
                        ##期望汇率
                        <td class="textRight">#springMessage('fex.tranApp.wishRate')</td>
                        <td>
                            #if($!{tranDtl.wishRate})
                                $!{tranDtl.wishRate}
                            #end
                            #if($!{tranDtl.endWishRate})
                                <span>~</span>
                                $!{tranDtl.endWishRate}
                            #end
                        </td>
                        ##钞汇标识
                        <td class="textRight">#springMessage('table.fexTranReq.bankNote')</td>
                        <td>
                            $dictTag.get("fex.tranApp.bankNote",$!{tranDtl.bankNote})
                        </td>
                    </tr>
                    <tr>
                        ##交易日期
                        <td class="textRight">#springMessage('table.btNetChalk.transTime')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{tranDtl.tranDate})
                        </td>
                        ##结算日期
                        <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                        <td>
                            $!date.format('yyyy-MM-dd',$!{tranDtl.settleDate})
                        </td>
                    </tr>
                    <tr>
                        ##交割期限
                        <td class="textRight">#springMessage('table.fexTranReq.deliveryDeadline')</td>
                        <td colspan="3">
                            T+$!{tranDtl.deliveryDeadline}
                        </td>
                    </tr>
                    <tr>
                        ##资金性质
                        <td class="textRight">#springMessage('table.fexTranReq.accNature')</td>
                        <td>
                             $dictTag.get("fexTranReq.accNature",$!{tranDtl.accNature})
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranBoodInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table view-break-table layui-form">
                    <tr>
                        ##保证方式
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.boodType')</td>
                        <td width="30%">
                            $dictTag.get("fex.tranApp.boodType",$!{tranDtl.boodType})
                        </td>
                        #if($!{tranDtl.boodType} !='5')
                            ##保证金账号
                            <td class="textRight bond_info" width="20%" >#springMessage('table.fexTranReq.boodAcc')</td>
                            <td width="30%" class="bond_info">
                                $!{tranDtl.boodAcc}
                            </td>
                        #end
                    </tr>
                    #if($!{tranDtl.boodType} !='5')
                        <tr>
                            ##保证比例
                            <td class="textRight bond_info">#springMessage('fex.tranApp.boodRatio')</td>
                            <td class="bond_info">
                                #if($!{tranDtl.boodRatio})
                                    $rateTag.show($!{tranDtl.boodRatio},6)
                                #end
                            </td>
                            ##保证金钞汇标识
                            <td class="textRight bond_info">#springMessage('fex.tranApp.bondBankNote')</td>
                            <td class="bond_info">
                                $dictTag.get("fex.tranApp.bankNote",$!{tranDtl.boodBankNote})
                            </td>
                        </tr>
                        <tr>
                            ##保证金币种
                            <td class="textRight bond_info">#springMessage('table.fexTranReq.bondCurId')</td>
                            <td class="bond_info">
                                $!{tranDtl.bondCurEnCode}
                            </td>
                            ##额度
                            <td class="textRight bond_info">#springMessage('table.guaContract.trackMoney')</td>
                            <td class="bond_info">

                                $!{tranDtl.payMoney}
                            </td>
                        </tr>
                    #end
                    <tr>
                        ##其他保证方式说明
                        <td class="textRight">#springMessage('fex.tranApp.otherBondRmk')</td>
                        <td colspan="3">
                            $!{tranDtl.boodRmk}
                        </td>
                    </tr>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            ##	申报信息
            <h2 class="layui-colla-title">#springMessage('fex.fexTranReqPay.reportInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table view-break-table layui-form">
                    <tr>
                        ##合同号
                        <td class="textRight" width="20%">#springMessage('table.fbsBudgetDetail.contract')</td>
                        <td width="30%">
                            $!{tranDtl.contractNo}
                        </td>
                        ##外汇局批件号/备案表号/业务编号
                        <td class="textRight" width="20%">#springMessage('fex.tranApp.ApprovalNo')</td>
                        <td width="30%">
                            $!{tranDtl.busNo}
                        </td>
                    </tr>
                    #if($!{pro.fexBusType} == 1)
                        <tr>
                            ##结汇资金用途
                            <td class="textRight">#springMessage('table.fexTranReq.purpose')</td>
                            <td>
                                $dictTag.get("fex.tranApp.purpose", $!{tranDtl.purpose})
                            </td>
                            ##结汇资金详细用途
                            <td class="textRight">#springMessage('table.fexTranReq.purposeDtl')</td>
                            <td>
                                $!{tranDtl.purposeDtl}
                            </td>
                        </tr>
                    #end
                    <tr>
                        ##发票号
                        <td class="textRight">#springMessage('table.fexForeignReq.invoiceNo')</td>
                        <td>
                            $!{tranDtl.invoiceNo}
                        </td>
                        ##交易编码
                        <td class="textRight">#springMessage('table.fexTranInfo.tranCode')</td>
                        <td>
                             $!{tranDtl.tranCode1Name}
                        </td>
                    </tr>
                    <tr>
                        ##联系人
                        <td class="textRight">#springMessage('table.externalCorp.linkMan')</td>
                        <td>
                            $!{tranDtl.corpContact}
                        </td>
                        ##联系电话
                        <td class="textRight">#springMessage('sys.user.phone.show')</td>
                        <td>
                            $!{tranDtl.corpContactTel}
                        </td>
                    </tr>
                    <tr>
                        ##申请人
                        <td class="textRight">#springMessage('bill.accebill.applyName')</td>
                        <td colspan="3">
                            <div class="layui-input-inline">
                                $!{tranDtl.createBy}
                            </div>
                        </td>
                    </tr>
                    <tr>
                    <tr>
                        <td class="textRight">#springMessage('cms.loan.attachment')</td>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input type="hidden" name="attachmentId" id="gid" value="$!{tranDtl.attachmentId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    </tr>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('cms.loan.OtherInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table view-break-table layui-form">
                    <tr>
                        ##资金来源
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.fundsSource')</td>
                        <td width="30%">
                            $dictTag.get("fex.tranApp.fundsSource",$!{tranDtl.fundsSource})
                        </td>
                        ##结售汇属性
                        <td class="textRight" width="20%">
                            #if($!{pro.fexBusType} != 3)
                                #springMessage('table.fexTranReq.fexProp')
                            #end
                        </td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                #if($!{pro.fexBusType} == 1)
                                     $dictTag.get("fex.tranApp.fexProp",$!{tranDtl.fexProp})
                                #elseif($!{pro.fexBusType} == 2)
                                    $dictTag.get("fex.tranApp.fexProp2",$!{tranDtl.fexProp})
                                #end
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
                        <td colspan="3">
                            $!{tranDtl.rmk}
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" style="text-align: center">
                            <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>
</body>
    #parse("views/common/footer.vm")
    <script>
        bt.use(["jquery", "form", "btUpload"], function () {
            $ = bt.jquery;
            form = bt.form();
            var gid = $("#gid").val();
            upload = bt.btUpload.init({
                elem: "#uploader",
                hasDelete: false,
                hasUpload: false,
                isExpand: true,
                auto: false,
                gid: gid
            });

            /**
             * 查看
             * @param id
             */
            view = function (id) {
                if (bt.navtab) {
                    bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/foreign/fextranreq/view/" + id);
                    return;
                }
                parent.layer.open({
                    type: 2,
                    area: ['850px', '530px'],
                    maxmin: true,
                    content: basePath + "/foreign/fextranreq/view/" + id
                });
            }
        });
        //关闭窗口
        function doClose() {
            if (bt.navtab) {
                bt.navtab.closeCurrent();
            }
        }
    </script>
</html>

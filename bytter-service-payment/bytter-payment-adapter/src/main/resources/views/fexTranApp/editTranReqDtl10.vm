<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body style="padding: 0;">
    ##外汇买卖-----------资金收付

<form class="layui-form" method="post" id="myform">
    #if($!{tranDtl.id})
        <input type="hidden" name="id" value="$!{tranDtl.id}">
    #end
    ##    主表id
    <input type="hidden" name="appId" id="appId">
    ##    是否掉期交易
    <input type="hidden" name="isSwaptTran" id="isSwaptTran" value="$!{isSwaptTran}">
    <input type="hidden" name="templateId" id="templateId" value="#if($!{template.id})$!{template.id}#else$!{tranDtl.templateId}#end">
    <input type="hidden" name="templateName" id="templateName" value="$!{tranDtl.templateName}">
    <input type="hidden" name="templatePayType" id="templatePayType" value="">
    <input type="hidden" name="bifCode" id="bifCode" value="$!{template.bifId}">
    <input type="hidden" name="countryId" id="countryId" value="$!{template.countryId}">
    <input type="hidden" name="template" id="template" value="$!{template}">
    ##    产品id
    <input type="hidden" name="proId" id="proId" value="$!{pro.id}">
    ##    单位id
    <input type="hidden" name="corpId" id="corpId">
    ##    外汇业务类型
    <input type="hidden" class="layui-input" name="fexBusType" id="fexBusType" value="$!{pro.fexBusType}">
    ##    外汇交易类型
    <input type="hidden" class="layui-input" name="fexTranType" id="fexTranType" value="$!{pro.fexTranType}">
    ##    交易类型
    <input type="hidden" class="layui-input" name="tranType" id="tranType" value="$!{tranType}">

    <table class="layui-table layui-form">
        <tr>
            ##收付方向
            <td class="textRight" width="20%">#springMessage('table.foreign.cdSign')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="radio" data-group="fexCorp.cdSign"
                        #if($!{tranDtl.cdSign})
                         data-value="$!{tranDtl.cdSign}"
                        #else
                         data-value="1"
                        #end
                       data-name="cdSign" data-biz-name="cdSign"
                         data-callback="costSignCallBack"></div>
                </div>
            </td>
            ##汇款类型
            <td class="textRight" width="20%">#springMessage('table.fexForeignReq.remitType')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-value="$!{tranDtl.remitType}"
                         data-group="fexForeignReq.remitType"   data-name="remitType"
                         data-biz-name="remitType"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##主体单位
            <td class="textRight" width="20%">#springMessage('nis.pool.fcCorpPool.poolCorp')</td>
            <td>
                <input class="layui-input" id="corpName" name="corpName" readonly="readonly" type="text"
                       value="$!{corp.name}"/>
            </td>
            ##交易对手
            <td class="textRight" width="20%">#springMessage('table.fexForeign.copt')</td>
            <td width="30%">
                <input type="hidden" name="cotpId" id="cotpId" value="$!{tranDtl.cotpId}"/>
                <input class="layui-input" id="cotpName" name="cotpName"   readonly="readonly"
                       type="text" value="$!{tranDtl.cotpName}"/>
            </td>
        </tr>
        <tr>
            ##主体单位银行
            <td class="textRight" width="20%">#springMessage('table.fexTranReq.corpBank')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-value="$!{tranDtl.corpBank}" data-biz-name="corpBank"
                           data-url="${basePath}/basic/business/btbanktype/json" data-valuefield="id"
                         data-textfield="typeName" data-name="corpBank" data-callback="corpBankCallBack"></div>
                </div>
            </td>

            ##交易对手银行
            <td class="textRight" width="20%">#springMessage('fex.tranApp.cotpBank')</td>
            <td>
                <input class="layui-input" id="cotpBankName" name="fexCotpBankAccVO.bankName"  readonly="readonly" type="text" value="$!{tranDtl.fexCotpBankAccVO.bankName}"/>
            </td>
        </tr>
        <tr>
            ##主体单位银行账户
            <td class="textRight" width="20%">#springMessage('table.fexTranReq.corpBankAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="hidden" id="corpAccId" name="corpAccId" value="$!{tranDtl.corpAccId}">
                    <input type="text" id="corpBankAcc" name="corpBankAcc" value="$!{tranDtl.corpBankAcc}"
                            data-biz-name="corpBankAcc"
                           autocomplete="off" class="layui-input text"
                           placeholder="#springMessage('table.fexTranReq.corpBankAcc')">
                    <table id="corpBankAccTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.choBankFinance.acc')</th>
                            <th>#springMessage('table.btBankAccApp.accName')</th>
                            <th>#springMessage('table.btBankAcc.bankName')</th>
                            <th>#springMessage('table.nisBillhead.curId')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
            ##交易对手银行账户
            <td class="textRight" width="20%">#springMessage('table.fexForeign.cotpAcc')</td>
            <td>
                ##交易对手地址
                <input type="hidden" name="cotpPostAddr" id="cotpPostAddr" value="$!{tranDtl.cotpPostAddr}">
                ##交易对手所在国家地区
                <input type="hidden" name="cotpCountry" id="cotpCountry" value="$!{tranDtl.cotpCountry}">
                ##交易对手银行Swift Code
                <input type="hidden" name="fexCotpBankAccVO.bicCode" id="bicCode" value="$!{tranDtl.fexCotpBankAccVO.bicCode}">
                ##本地清算号
                <input type="hidden" id="localClearNo" name="localClearNo" value="$!{tranDtl.localClearNo}">
                #*   ##交易对手银行国家地区
                   <input type="text" class="layui-input" name="fexCotpBankAccVO.bankCountryId" id="bankCountryId" value="$!{tranDtlTmp.fexCotpBankAccVO.bankCountryId}">*#
                ##交易对手银行地址
                <input type="hidden" class="layui-input" name="fexCotpBankAccVO.bankAddr" id="bankAddr" value="$!{tranDtl.fexCotpBankAccVO.bankAddr}">
                ##交易对手代理行
                <input type="hidden" class="layui-input" name="fexCotpBankAccVO.tranBank" id="tranBank" value="$!{tranDtl.fexCotpBankAccVO.tranBank}">
                ##交易对手代理行地址
                <input type="hidden" class="layui-input" name="fexCotpBankAccVO.tranBankAddr" id="tranBankAddr" value="$!{tranDtl.fexCotpBankAccVO.tranBankAddr}">
                ##交易对手代理行账户
                <input type="hidden" class="layui-input" name="fexCotpBankAccVO.tranBankAcc" id="tranBankAcc" value="$!{tranDtl.fexCotpBankAccVO.tranBankAcc}">




                <input type="hidden" name="cotpAccId" id="cotpAccId" value="$!{tranDtl.cotpAccId}">
                <input type="hidden" name="oppId" id="oppId" value="$!{tranDtl.oppId}">
                <div class="layui-inline" id="externalDiv">##客商组件
                    <input type="hidden" name="fexCotpBankAccVO.accName" id="cotpAccName"
                           value="$!{tranDtl.fexCotpBankAccVO.accName}">
                    <input class="layui-input" id="cotpBankAcc" name="cotpBankAcc" lay-verify="required"
                           readonly="readonly" type="text" value="$!{tranDtl.cotpBankAcc}"/>
                    <div class="bt-div-search">
                        ## 客商组件
                        <button type="button" class="bt-biz-allExternalBankAcc"
                                data-beforeClick="bt.externalBankAccBeforeClick"
                                data-callback="externalBankAccCallback">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##账户名称
            <td class="textRight" width="20%">#springMessage('table.btBankAccApp.accName')</td>
            <td>
                <div class="layui-input-inline">
                    <span id="corpAccName">
                        $!{tranDtl.corpBankAccName}
                    </span>
                </div>
            </td>

            ##交易对手(英文)
            <td class="textRight" width="20%">#springMessage('table.fexForeign.enCopt')</td>
            <td width="30%">
                <input type="text" name="cotpNameEn" id="cotpNameEn" class="layui-input" value="$!{tranDtl.cotpNameEn}"
                       readonly>
            </td>
        </tr>
        <tr>
            ##账户币种
            <td class="textRight" width="20%">#springMessage('fex.mainCorpAccountBz')</td>
            <td width="30%">
                <input type="hidden" id="corpAccCurId" name="corpAccCurId" value="$!{tranDtl.corpAccCurId}">
                <div id="corpAccCurNameDiv" name="corpAccCurNameDiv">$!{tranDtl.corpAccEnglishCode}</div>
            </td>
            ##账户币种
            <td class="textRight" width="20%">#springMessage('table.fexForeign.cotpCurNameTran')</td>
            <td width="30%">
                <input type="hidden" id="cotpAccCurId" name="cotpAccCurId" value="$!{tranDtl.cotpAccCurId}">
                <div id="cotpAccCurNameDiv" name="cotpAccCurNameDiv">$!{tranDtl.cotpAccEnglishCode}</div>
            </td>
        </tr>
        <tr>
            ## 支付类型
            <td class="textRight" width="20%">#springMessage('ttpay.bussiness.payType')</td>
            <td>
                <div class="bt-biz-selectType"
                     data-url="${basePath}/basic/business/btbanktype/listByCondition?bankType=$!{template.bankTypeId}&bifCode=$!{template.bifId}&countryId=$!{template.countryId}&payTypeId=$!{template.payTypeId}"
                     data-biz-name="payTypeId" data-name="payTypeId" data-valueField="id"
                     data-textField="bankPayTypeDisplay"
                     data-value="$!{tranDtl.bankPayTypeId}"
                     data-defaultvalue="$!{tranDtl.bankPayTypeId}"
                     data-callback="payTypeCallback" ></div>
            </td>
            ## 是否线下付款
            <td class="textRight" width="20%">#springMessage('table.fexTranReq.isPayed')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                        #if($!{tranDtl.isPayed})
                         data-value="$!{tranDtl.isPayed}"
                        #else
                         data-value="0"
                        #end
                         data-name="isPayed" data-biz-name="isQuick"></div>
                </div>
            </td>
        </tr>
    </table>

    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tr>
                        ##币种
                        <td class="textRight" width="20%">#springMessage('table.ratBkrationRelief.curCode')</td>
                        <td width="30%">
                            <div class="bt-biz-selectType" data-name="curId"
                                 data-url="${basePath}/basic/business/btcurrency/json"
                                 data-value="$!{tranDtl.curId}"
                                 data-valuefield="id" data-textfield="englishCode" data-required="true"
                                 data-callback="curCallBack" data-biz-name="curId"></div>
                        </td>
                        ##金额
                        <td class="textRight" width="20%">#springMessage('table.fcUnionAccbook.sendMoney')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" data-name="payMoney" lay-verify="required" data-biz-name="payMoney"
                                       value="$!{tranDtl.payMoney}" class="layui-input bt-biz-moneyType">
                            </div>
                        </td>

                    </tr>
                    <tr>
                        ##交易日期
                        <td class="textRight" width="20%">#springMessage('table.btNetChalk.transTime')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" name="tranDate" value="$!{tranDtl.tranDate}" lay-verify="required"
                                       class="layui-input bt-biz-dateType" data-endid="settleDate" data-type="date"
                                       data-biz-name="tranDate">
                            </div>
                        </td>
                        ##结算日期
                        <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="settleDate" value="$!{tranDtl.settleDate}"
                                       lay-verify="required" id="settleDate" class="layui-input bt-biz-dateType"
                                       data-type="date" data-biz-name="settleDate">
                            </div>
                        </td>

                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
                        <td colspan="4">
                            <textarea lay-verify="strlength" name="rmk" data-maxlength="100" class="layui-textarea">$!{tranDtl.rmk}</textarea>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('cms.loan.attachment')</td>
                        <td style="text-align: center;" colspan="3">
                            <!-- 附件上传 -->
                            <input type="hidden" name="attachmentId" id="gid" value="$!{tranDtl.attachmentId}">
                            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" style="text-align: center">
                            <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage(
                                '保存')</button>
                            <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage(
                                'common.button.close')</button>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</form>
</body>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/fexTranApp/editTranReqDtl10.js?_btv=${resourceVersion}"></script>
</html>

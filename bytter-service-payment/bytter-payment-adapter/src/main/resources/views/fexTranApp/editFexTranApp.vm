<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="myform">
    <input type="hidden" name="eqs_appId" value="$!{fexTranAppVo.id}">
    <input type="hidden" name="id" id="appId" value="$!{fexTranAppVo.id}">
    <table class="layui-table layui-form">
        <tr>
        ##                单位
            <td class="textRight" style="width: 20%">#springMessage('table.abBillTransfer.applyCorp')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp" data-defaultvalue="$!{fexTranAppVo.corpId}" data-biz-name="corpId"
                         data-resource="foreign:fex:tranApp:query"
                         data-name="corpId" data-biz-type="corp" data-type="selectTree" data-required="true"></div>
                </div>
            </td>
        <tr>
        <tr>
        ##交易需求描述
            <td class="textRight">#springMessage('fex.tranApp.reqRmk')</td>
            <td style="width: 50%">
                    <input type="text" id="rmk" data-maxlength = "25" lay-verify="required|strlength" style="width: 100%" name="rmk" value="$!{fexTranAppVo.rmk}" class="layui-input">
            </td>
        </tr>
        <tr>
        ##申请日期
            <td class="textRight">#springMessage('bill.accebill.applyDate')</td>
            <td style="width: 50%">
                <div class="layui-input-inline">
                    <input type="text" value="$!date.format("yyyy-MM-dd",$!{fexTranAppVo.appDate})" readonly="readonly" class="layui-input bt-biz-dateType">
                </div>
            </td>
        </tr>
    </table>

    <table id="appTable" class="layui-table layui-form">
        <thead>
        <tr>
        ##                                    交易类型
            <th>#springMessage('table.fexBankAcc.tranType')</th>
        ##                                    产品
            <th>#springMessage('table.fexBankAcc.proId')</th>
        ##                                    交易对手
            <th>#springMessage('table.fexForeign.copt')</th>
        ##                                    交易日期
            <th>#springMessage('table.btNetChalk.transTime')</th>
        ##                                    结算日期
            <th>#springMessage('table.fcSubjectDay.optDate')</th>
        ##                                    操作
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>

    <div style="width: 100%;text-align: center">
        <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
        <button class="layui-btn" type="button" lay-submit="submit" value="0" lay-filter="submit">#springMessage('common.button.temp')</button>
        <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
    </div>
</form>
</body>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/fexTranApp/editFexTranApp.js?_btv=${resourceVersion}"></script>
</html>

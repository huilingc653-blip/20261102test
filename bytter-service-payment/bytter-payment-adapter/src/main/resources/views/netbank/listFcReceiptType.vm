<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight">#springMessage('fcReceiptType.code')</td>
					<td>
                        <input type="text" name="likes_receiptCode" autocomplete="off" class="layui-input" placeholder="#springMessage('fcReceiptType.code')">
                    </td>
					<td class="textRight">#springMessage('fcReceiptType.name')</td>
					<td>
                        <input type="text" name="likes_receiptName" autocomplete="off" class="layui-input" placeholder="#springMessage('fcReceiptType.name')">
                    </td>
                    <td class="textRight">#springMessage('btPayType.validSign')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="valid_sign"  data-name="eqs_validSign" data-biz-name="eqs_validSign"></div>
                    </td>
                </tr>
    			<tr >
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('fcReceiptType.code')</th>
                <th>#springMessage('fcReceiptType.name')</th>
                <th>#springMessage('btPayType.rmk')</th>
                <th>#springMessage('btPayType.validSign')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/FcReceiptType.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight">#springMessage('btPayType.sysVoucherCode')</td>
					<td width="40%">
                        <input type="text" name="likes_sysVoucherCode"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('btPayType.sysVoucherCode')">
                    </td>
					<td class="textRight">#springMessage('btPayType.sysVoucherName')</td>
					<td width="40%">
                        <input type="text" name="likes_sysVoucherName"
							autocomplete="off" class="layui-input" placeholder="#springMessage('btPayType.sysVoucherName')">
                    </td>
                </tr>
    			<tr >
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('btPayType.sysVoucherCode')</th>
                <th>#springMessage('btPayType.sysVoucherName')</th>
                <th>#springMessage('btPayType.rmk')</th>
                <th>#springMessage('btPayType.validSign')</th>
            </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/btPayType.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" id="nisFlowRuleForm">
		<input id="id" name="id" type="hidden" value="$!{nisFlowRuleVO.id}">
		<table class="layui-table">
			<tbody>
				<tr>
					##调拨类型
					<td class="textRight">调拨类型</td>
					<td>
						<div class="bt-biz-dict" data-type="select" data-group="nisFlowRule.transferType"  data-name="transferType"
							 data-biz-name="transferType" data-required="true" data-defaultvalue="$!{nisFlowRuleVO.transferType}"></div>
					</td>
					##调拨方式
					<td class="textRight">调拨方式</td>
					<td>
						<div class="bt-biz-dict" data-type="select" data-group="nisFlowRule.transferMode"  data-name="transferMode"
							 data-biz-name="transferMode" data-required="true" data-callback="getTransferMode" data-defaultvalue="$!{nisFlowRuleVO.transferMode}"></div>
					</td>
					##状态
					<td class="textRight">状态</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="nisFlowRule.status" data-defaultvalue="1" data-name="status"
							 data-biz-name="status" data-defaultvalue="$!{nisFlowRuleVO.status}"></div>
					</td>
				</tr>
					<tr id="purposeTr" #if($!{nisFlowRuleVO.transferMode} == "2") style="display: none;"#end>
						##用途/摘要
						<td class="textRight">用途/摘要</td>
						<td>
							<input type="text" id="purpose" name="purpose" lay-verify="required"  autocomplete="off" class="layui-input"
								   placeholder="用途/摘要" value="$!{nisFlowRulePurpose.purpose}">
						</td>
					</tr>
			</tbody>
		</table>
		<div id="bankAutoTr" #if($!{nisFlowRuleVO.transferMode} != "2") style="display: none;"#end>
			<table class="layui-table layui-table-border" width="100%" id="bankAutoTable">
				<thead>
				<tr>
					<th class="textCenter" width="40%">
						<span class="pl"><span class="required-icon">*</span></span>银行类别
					</th>
					<th class="textCenter" width="40%">
						<span class="pl"><span class="required-icon">*</span></span>摘要/用途
					</th>
					<th class="textCenter" width="20%">#springMessage('common.table.thead.operation')</th>
				</tr>
				</thead>
				<tbody class="ignore-required-icon">
				#if($!{nisFlowRuleVO.transferMode} == "2")
					#foreach($nisFlowRulePurposes in $!{nisFlowRuleVO.nisFlowRulePurposes})
						#set($row = $!{velocityCount})
						#if($!{velocityCount} == 1)
							<tr row="$row">
								<td>
									<div class="bt-biz-selectType"
										 data-url="${basePath}/basic/business/btbanktype/json"
										 data-name="bankTypeId"
										 data-biz-name="bankInfo-bankType"
										 data-valuefield="id" data-textfield="typeName"
										 data-required="true"
										 data-value="$!{nisFlowRulePurposes.bankTypeId}"
										 data-verify="customVerify"
									></div>
								</td>
								<td>
									<input type="text" name="purpose1" autocomplete="off" class="layui-input" lay-verify="customVerify"
										   placeholder="用途/摘要" value="$!{nisFlowRulePurposes.purpose}">
								</td>
								<td>
									<button class="layui-btn" onclick="addTr();" type="button">#springMessage('common.addTr')</button>
								</td>
							</tr>
						#else
							<tr row="$row">
								<td>
									<div class="bt-biz-selectType"
										 data-url="${basePath}/basic/business/btbanktype/json"
										 data-name="bankTypeId"
										 data-biz-name="bankInfo-bankType"
										 data-valuefield="id" data-textfield="typeName"
										 data-required="true"
										 data-value="$!{nisFlowRulePurposes.bankTypeId}"
										 data-verify="customVerify"
									></div>
								</td>
								<td>
									<input type="text" name="purpose1" autocomplete="off" class="layui-input" lay-verify="customVerify"
										   placeholder="用途/摘要" value="$!{nisFlowRulePurposes.purpose}">
								</td>
								<td>
									<a href="javascript:void (0)" onclick="deleteDtl(this)">#springMessage("common.button.delete")</a>
								</td>
							</tr>
						#end
					#end
				#else
					<tr row="1">
						<td>
							<div class="bt-biz-selectType"
								 data-url="${basePath}/basic/business/btbanktype/json"
								 data-name="bankTypeId"
								 data-biz-name="bankInfo-bankType"
								 data-valuefield="id" data-textfield="typeName"
								 data-required="true"
								 data-verify="customVerify"
							></div>
						</td>
						<td>
							<input type="text" id="purpose1" name="purpose1" autocomplete="off" class="layui-input" lay-verify="customVerify"
								   placeholder="用途/摘要">
						</td>
						<td>
							<button class="layui-btn" onclick="addTr();" type="button">#springMessage('common.addTr')</button>
						</td>
					</tr>
				#end
				</tbody>
			</table>
		</div>
		<div style="text-align: center;">
			<button class="layui-btn" lay-submit="" lay-filter="submit" type="button">#springMessage('common.button.submit')</button>
			<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		</div>
	</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisFlowRule.edit.js?_btv=${resourceVersion}"></script>
</html>
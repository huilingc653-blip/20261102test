<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input id="id" name="id" type="hidden" value="">
        <input id="corpId" name="corpId" type="hidden" value="$!{corpId}">
		<table class="layui-table">
			<tbody>
				<tr>
					##上级单位
					<td class="textRight" width="20%" >上级单位</td>
					<td width="30%">
						<input id="superCorpId" name="superCorpId" type="hidden" value="">
						<div id="superCorpIdDiv"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">上级账号</td>
					<td>
						<div class="layui-input-inline">
							<input id="superBankAccId" name="superBankAccId" type="hidden" value="">
							<input type="text" id="superBankAcc" name="superBankAcc" lay-verify="required|tableData"
								   data-biz-name="superBankAcc"
								   autocomplete="off" class="layui-input text"
								   placeholder="上级账号">
							<table id="superBankAccTable" class="hide">
								<thead>
								<tr>
									<th>#springMessage('table.nisBillhead.payerAcc')</th>
									<th>#springMessage('table.nisBillhead.payerAccName')</th>
									<th>#springMessage('table.nisBillhead.payerBank')</th>
									<th>#springMessage('table.nisBillhead.curId')</th>
									<th>#springMessage('table.btBankAcc.isOnline')</th>
								</tr>
								</thead>
							</table>
						</div>
					</td>
				</tr>
				<tr>
					<td class="textRight">上级账号户名</td>
					<td>
						<input id="superAccName" name="superAccName" type="hidden" value="">
						<div id="superAccNameDiv"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">上级账号开户行</td>
					<td>
						<input id="superBankName" name="superBankName" type="hidden" value="">
						<div id="superBankNameDiv"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">上级账户当前余额</td>
					<td>
						<div id="superBalDiv"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">上级账户可用资金</td>
					<td>
						<div id="superAvailBalDiv"></div>
					</td>
				</tr>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.confirm')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/netbank/nisDemand.setSuperAcc.js?_btv=${resourceVersion}"></script>
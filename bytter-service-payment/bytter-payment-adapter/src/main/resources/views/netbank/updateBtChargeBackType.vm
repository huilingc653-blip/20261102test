<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{btChargeBackTypePage.id}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="30%">#springMessage('btChargeBackType.busType')</td>
            <td>
                <input type="text" name="busType" lay-verify="required|langKey|strlength" data-maxlength="10"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('btChargeBackType.busType')"
                       value="$!{btChargeBackTypePage.busType}">

            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('btChargeBackType.busTypeName')</td>
            <td>
                <div class="layui-inline">
                    <input style="display: inline;" name="busTypeName" lay-verify="required|strlength"
                           data-maxlength="30"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('btChargeBackType.busTypeName')"
                           value="$!{btChargeBackTypePage.busTypeName}">
                    <span data-toggle="i18n" data-key-id="$!{btChargeBackTypePage.id}"/>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('btChargeBackType.isDefault')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                     data-defaultvalue="$!{btChargeBackTypePage.isDefault}" data-name="isDefault"
                     data-biz-name="isDefault"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('btChargeBackType.validSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="valid_sign"
                     data-defaultvalue="$!{btChargeBackTypePage.validSign}" data-name="validSign"
                     data-biz-name="validSign"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('btChargeBackType.rmk')</td>
            <td>
                <textarea placeholder="#springMessage('btChargeBackType.rmk')" lay-verify="strlength"
                          class="layui-textarea" id="rmk" name="rmk"
                          data-maxlength="100">$!{btChargeBackTypePage.rmk}</textarea>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/btChargeBackType.edit.js?_btv=${resourceVersion}"></script>
</html>

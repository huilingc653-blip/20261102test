<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" name="id" value="${entity.id}">
    <table class="layui-table">
        <tbody>
            ##关联方编码
        <tr>
            <td class="textRight" width="40%">关联方编码</td>
            <td>$!{entity.relatedCode}</td>
        </tr>
            ##关联方名称
        <tr>
            <td class="textRight">关联方名称</td>
            <td>
                <input type="text" name="relatedName" lay-verify="required|strlength"
                       data-maxlength="200" autocomplete="off" class="layui-input"
                       placeholder="关联方名称" value="$!{entity.relatedName}">
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script >
    bt.use(['form', 'selectType', 'dicts'], function () {
        $ = bt.jquery;
        var form = bt.form();

        //监听提交
        form.on('submit(submit)', function (data) {
            bt.loading.show();
            var action = "/netbank/relatedParty/modify";
            $.post(basePath + action, data.field, function (result) {
                bt.loading.hide();
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}, function (index) {
                    if (result.success) {
                        parent.layer ? parent.layer.closeAll() : layer.closeAll();
                    } else {
                        parent.layer ? parent.layer.close(index) : layer.close(index);
                    }
                })
            }, 'JSON');
            return false;
        });

        form.renderIcon();//渲染必填
    });
</script>
</html>

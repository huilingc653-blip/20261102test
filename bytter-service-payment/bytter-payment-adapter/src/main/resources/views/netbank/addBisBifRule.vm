<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form inputVerify-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{bisBifRulePage.id}">
		<input id="bifName" name="bifName" type="hidden" value="$!{bisBifRulePage.bifName}">
		<table class="layui-table">
			<tbody >
				<tr>
					<td class="textRight" width="30%">#springMessage('bisBifRule.bifName')</td>
					<td>
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/json"
                             data-name="bifCode" data-biz-name="bifCode" data-valueField="bifCode" data-textField="name"
							 data-callback="bifCodeCallback"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.bifCode')</td>
					<td>
						<input type="text" id="bifCodeText" readonly="readonly" 
							decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('bisBifRule.bifCode')">
					</td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.payerName')</td>
					<td>
						<input type="text" id="payerName" name="payerName" value="150" lay-verify="required|number"
							decimal="0" autocomplete="off" class="layui-input inputVerify" placeholder="#springMessage('bisBifRule.payerName')">
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.payerAcc')</td>
					<td>
						<input type="text" id="payerAcc" name="payerAcc" value="30" lay-verify="required|number"
							decimal="0" autocomplete="off" class="layui-input inputVerify" placeholder="#springMessage('bisBifRule.payerAcc')">
					</td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.payerBank')</td>
					<td>
						<input type="text" id="payerBank" name="payerBank" value="150" lay-verify="required|number"
							decimal="0" autocomplete="off" class="layui-input inputVerify" placeholder="#springMessage('bisBifRule.payerBank')">
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.payeeName')</td>
					<td>
						<input type="text" id="payeeName" name="payeeName" value="150" lay-verify="required|number"
							decimal="0" autocomplete="off" class="layui-input inputVerify" placeholder="#springMessage('bisBifRule.payeeName')">
					</td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.payeeAcc')</td>
					<td>
						<input type="text" id="payeeAcc" name="payeeAcc" value="30" lay-verify="required|number"
							decimal="0" autocomplete="off" class="layui-input inputVerify" placeholder="#springMessage('bisBifRule.payeeAcc')">
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.payeeBank')</td>
					<td>
						<input type="text" id="payeeBank" name="payeeBank" value="150" lay-verify="required|number"
							decimal="0" autocomplete="off" class="layui-input inputVerify" placeholder="#springMessage('bisBifRule.payeeBank')">
					</td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.purpose')</td>
					<td>
						<input type="text" id="purpose" name="purpose" value="30" lay-verify="required|number"
							decimal="0" autocomplete="off" class="layui-input inputVerify" placeholder="#springMessage('bisBifRule.purpose')">
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.addWord')</td>
					<td>
						<input type="text" id="addWord" name="addWord" value="150" lay-verify="required|number"
							decimal="0" autocomplete="off" class="layui-input inputVerify" placeholder="#springMessage('bisBifRule.addWord')">
					</td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.isPurpose')</td>
					<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="isPurpose" data-biz-name="isPurpose"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.isAddBillNo')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isAddBillNo" data-biz-name="isAddBillNo"></div>
						<div class="layui-input-inline" style="color:red">#springMessage('bisBifRule.isAddBillNo.desc')</div>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.isBankOnline')</td>
					<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="isBankOnline" data-biz-name="isBankOnline"></div>
					</td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.sendNum')</td>
					<td>
						<input type="text" id="sendNum" name="sendNum" value="300" lay-verify="required|number"
							decimal="0" autocomplete="off" class="layui-input inputVerify" placeholder="#springMessage('bisBifRule.sendNum')">
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisBifRule.isMustBankCode')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isMustBankCode" data-biz-name="isMustBankCode"></div>
					</td>
				</tr>
    			<tr >
                    <td colspan="2" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/bisBifRule.add.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight" width="40%">#springMessage('fcReceiptType.code')</td>
					<td>
						$!{fcReceiptTypePage.receiptCode}
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('fcReceiptType.name')</td>
					<td>
						$!{fcReceiptTypePage.receiptName}
					</td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('btPayType.rmk')</td>
					<td>
						$!{fcReceiptTypePage.rmk}
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('btPayType.validSign')</td>
					<td>
						#if($!{fcReceiptTypePage.validSign}=="0")
							无效
						#else
							有效
						#end
					</td>
				</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body {
            font-size: 14px;
            padding-bottom: 60px;
        }

        .layui-form-label {
            width: 180px;
        }

        .layui-input-block {
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.pool.param.titile')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.pool.accAutoCheck')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-value="$!{config.pool.accAutoCheck}"
                                 data-name="pool.accAutoCheck" data-biz-name="pool.accAutoCheck"
                                 data-defaultvalue="0"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.pool.changeAutoCheck')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-value="$!{config.pool.changeAutoCheck}"
                                 data-name="pool.changeAutoCheck" data-biz-name="pool.changeAutoCheck"
                                 data-defaultvalue="0"></div>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('config.pool.thawAutoCheck')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-value="$!{config.pool.thawAutoCheck}"
                                 data-name="pool.thawAutoCheck" data-biz-name="pool.thawAutoCheck"
                                 data-defaultvalue="0"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fcs.accAccnoRule')</td>
                        <td width="80%">
                            <div>
                                <div class="bt-biz-dict" data-type="select" data-group="config.pool.poolAccnoRule"
                                     data-width="200px" data-defaultvalue="$!{config.pool.poolAccnoRule}"
                                     data-name="pool.poolAccnoRule" data-biz-name="pool.poolAccnoRule"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.pool.interestFrom')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="pool.interestFrom"
                                 data-name="pool.interestFrom"
                                 data-biz-name="pool.interestFrom" data-value="$!{config.pool.interestFrom}"
                                 data-defaultvalue="innerAcc"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.pool.agreeAutoCheck')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-name="pool.agreeAutoCheck"
                                 data-biz-name="pool.agreeAutoCheck" data-value="$!{config.pool.agreeAutoCheck}"
                                 data-defaultvalue="0"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.pool.agreeRegAutoCheck')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-name="pool.agreeRegAutoCheck"
                                 data-biz-name="pool.agreeRegAutoCheck" data-value="$!{config.pool.agreeRegAutoCheck}"
                                 data-defaultvalue="0"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.pool.agreeTermAutoCheck')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-name="pool.agreeTermAutoCheck"
                                 data-biz-name="pool.agreeTermAutoCheck" data-value="$!{config.pool.agreeTermAutoCheck}"
                                 data-defaultvalue="0"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.pool.poolAccRateAdjust')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-name="pool.poolAccRateAdjust"
                                 data-biz-name="pool.poolAccRateAdjust" data-value="$!{config.pool.poolAccRateAdjust}"
                                 data-defaultvalue="0"></div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="20%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form', 'jquery', 'dicts'], function () {
        var form = bt.form(), $ = bt.jquery;
        bt.dicts.init();
        //监听提交
        form.on('submit(configSubmit)', function (data) {
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, "JSON");
            return false;
        });
    });
</script>
</body>
</html>

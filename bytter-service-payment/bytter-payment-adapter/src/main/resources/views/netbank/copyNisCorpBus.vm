<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
    <style type="text/css">
        table tbody td, table thead th, table tfoot td {
            word-break: hyphenate;
            white-space: normal;
        }

    </style>
</head>
<body>
<form class="layui-form" method="post">
    <input id="createBy" name="createBy" type="hidden" value="$!{nisCorpBusPage.createBy}" class="hide-input">
    <input id="createDate" name="createDate" type="hidden" value="$!{nisCorpBusPage.createDate}" class="hide-input">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{nisCorpBusPage.updateBy}" class="hide-input">
    <input id="updateDate" name="updateDate" type="hidden" value="$!{nisCorpBusPage.updateDate}" class="hide-input">
    <input id="id" name="id" type="hidden" value="$!{nisCorpBusPage.id}" class="hide-input">
    <input id="copyedNisBusTypes" name="copyedNisBusTypes" type="hidden" value="$!{copyedNisBusTypes}">
    #foreach($corpId in $corps)
        <input id="${corpId}" name="${corpId}" type="hidden" value="${corpId}" title="${corpId}" class="hide-input"/>
    #end
    <table class="layui-table">
        <tr>
            <td class="textRight" width="10%">#springMessage('table.nis_corp_bus.corp_id')</td>
            <td colspan="5">
                <div class="layui-input-inline">
                    <div class="corpTree"></div>
                </div>
            </td>
        </tr>
    </table>
    <table class="layui-table layui-table-border" id="busTypeTable">
        <thead>
        <tr>
            <th width="26px" style="text-align:center;padding: 8px 6px 0 6px;">
                <input type="checkbox" lay-skin="primary" lay-filter="allChoose" lay-ignore id="allChoose"/>
            </th>
            <th>#springMessage('nisBusType.busType')</th>
            <th>#springMessage('nisBusType.busTypeName')</th>
            <th>#springMessage('nisBusType.itemCode')</th>
            <th>#springMessage('nisBusType.itemName')</th>
            <th>#springMessage('nisBusType.cdSign')</th>
        </tr>
        </thead>
        <tbody>
            #foreach($busId in $nisBusTypeList)
            <tr>
                <td style="text-align:center">
                    <input type="checkbox" name="busIds" lay-skin="primary" value="${busId.id}" id="${busId.busType}" lay-ignore/>
                </td>
                <td style="text-align:center">$!{busId.busType}</td>
                <td>$!{busId.busTypeName}</td>
                <td>$!{busId.itemCode}</td>
                <td>$!{busId.itemName}</td>
                <td style="text-align:center">$!{busId.cdSignStr}</td>
            </tr>
            #end
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit" id="submit" type="button">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisCorpBus.copy.js?_btv=${resourceVersion}"></script>
</html>

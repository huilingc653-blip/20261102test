<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
        <table class="layui-table">
			<tbody >
				<tr >
					<td class="textRight" width="40%">#springMessage('fcVoucherType.voucherType')</td>
					<td>
						$!{fcVoucherTypePage.voucherType}
                    </td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.voucherName')</td>
					<td>
						$!{fcVoucherTypePage.voucherName}
                    </td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.sysVoucherCode')</td>
					<td>
						$!{fcVoucherTypePage.sysVoucherName}
                    </td>
				</tr>
				#if($!{fcVoucherTypePage.sysVoucherCode} == "49")
				<td class="textRight">#springMessage('fcVoucherType.openBill.section.control')</td>
				<td>
					<div class="bt-biz-dict" data-type="radio" data-group="BILL_SECTION_CONTROL" id="billSectionControl" data-disabled="true" data-defaultvalue="$!{fcVoucherTypePage.billSectionControl}"
						 data-name="billSectionControl" data-biz-name="billSectionControl"></div>
				</td>
				#end
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.cashTransSign')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="cashTransSign"
							 data-defaultvalue="$!{fcVoucherTypePage.cashTransSign}" data-disabled="true"
							 data-name="cashTransSign" data-biz-name="cashTransSign"></div>
                    </td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.settlType')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="settlType"
							 data-defaultvalue="$!{fcVoucherTypePage.settlType}" data-disabled="true"
							 data-name="settlType" data-biz-name="settlType"></div>
                    </td>
				</tr>
				<tr style="display:none">
					<td class="textRight">#springMessage('fcVoucherType.isElectronPay')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
							 data-defaultvalue="$!{fcVoucherTypePage.isElectronPay}" data-disabled="true"
							 data-name="isElectronPay" data-biz-name="isElectronPay"></div>
                    </td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('fcVoucherType.isAccount')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
							 data-defaultvalue="$!{fcVoucherTypePage.isAccount}" data-disabled="true"
							 data-name="isAccount" data-biz-name="isAccount"></div>
                    </td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.isBudget')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
							 data-defaultvalue="$!{fcVoucherTypePage.isBudget}" data-disabled="true"
							 data-name="isBudget" data-biz-name="isBudget"></div>
					</td>
				</tr>
				#if($!{fcVoucherTypePage.sysVoucherCode} == "34" || $!{fcVoucherTypePage.sysVoucherCode} == "02" || $!{fcVoucherTypePage.sysVoucherCode} == "33")
				<tr>
					<td class="textRight">#springMessage('config.nis.bisExcAutoAccount')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="bisExc.sendMode"
							 data-defaultvalue="$!{fcVoucherTypePage.sendMode}" data-disabled="true"
							 data-name="sendMode" data-biz-name="sendMode"></div>
					</td>
				</tr>
				#end
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.validSign')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="valid_sign"
							 data-defaultvalue="$!{fcVoucherTypePage.validSign}" data-disabled="true"
							 data-name="validSign" data-biz-name="validSign"></div>
                    </td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
					<td>
						$!{fcVoucherTypePage.rmk}
                    </td>
				</tr>
            </tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
	<script>
		bt.use(['form','dicts','layedit','externalCorpView', 'bankAccView', 'moneyType'],function () {
			var moneyType = bt.moneyType.init();
			bt.dicts.init();
		})
	</script>
</body>
</html>
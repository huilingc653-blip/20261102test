<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input id="ids" name="ids" type="hidden" value="$!{ids}">
    <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
    <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
    <input id="busType" name="busType" type="hidden" value="$!{busType}">
#foreach($nisBillheadPage in $list)
    <!-- 系统参数 -->
    <input id="id_$!{nisBillheadPage.id}" name="id" type="hidden" value="$!{nisBillheadPage.id}">
    <input id="billNo_$!{nisBillheadPage.id}" name="billNo" type="hidden" value="$!{nisBillheadPage.billNo}">
    <input id="corpId_$!{nisBillheadPage.id}" name="corpId" type="hidden" value="$!{nisBillheadPage.corpId}">
    <input id="wishPayday_$!{nisBillheadPage.id}" name="wishPayday" type="hidden" value="$!date.format('yyyy-MM-dd',$!{nisBillheadPage.wishPayday})">
    <input id="isBudget_$!{nisBillheadPage.id}" name="isBudget" type="hidden" value="$!{nisBillheadPage.isBudget}">

    <input id="billFrom_$!{nisBillheadPage.id}" name="billFrom" type="hidden" value="$!{nisBillheadPage.billFrom}">
    <input id="showIsOpenBill_$!{nisBillheadPage.id}" name="showIsOpenBill" type="hidden" value="$!{nisBillheadPage.isOpenBill}">
    <input id="billId_$!{nisBillheadPage.id}" name="billId" type="hidden" value="$!{nisBillheadPage.billId}">

    <!-- 资金计划参数 明细项控制模式-->
    <input id="settlType_$!{nisBillheadPage.id}" name="settlType" type="hidden" value="$!{nisBillheadPage.settlType}">
    <input id="sysVoucherCode_$!{nisBillheadPage.id}" name="sysVoucherCode" type="hidden" value="$!{nisBillheadPage.sysVoucherCode}">
    <input id="curId_$!{nisBillheadPage.id}" name="curId" type="hidden" value="$!{nisBillheadPage.curId}">
    <input id="payeeAccName_$!{nisBillheadPage.id}" name="payeeAccName" type="hidden" value="$!{nisBillheadPage.payeeAccName}">
    <input id="payerAcc_$!{nisBillheadPage.id}" name="payerAcc" type="hidden" value="$!{nisBillheadPage.payerAcc}">
    <input id="payeeAcc_$!{nisBillheadPage.id}" name="payeeAcc" type="hidden" value="$!{nisBillheadPage.payeeAcc}">
    <input id="payeeBank_$!{nisBillheadPage.id}" name="payeeBank" type="hidden" value="$!{nisBillheadPage.payeeBank}">
    <input id="purpose_$!{nisBillheadPage.id}" name="purpose" type="hidden" value="$!{nisBillheadPage.purpose}">
    <div name="print_doc1">
        <div class="layui-collapse">
            <h2 class="layui-colla-title" style="text-align: center">#springMessage('table.nisBillhead.viewTitle')</h2>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.nisBillhead.titleInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table layui-table-border">
                        <tbody>
                        <tr>
                            ##付款单号
                            <td class="textRight" colspan="2" width="20%" >#springMessage('table.nisBillhead.billNo')</td>
                            <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.billNo}</div></td>
                            <td class="textRight" colspan="2" width="20%">#springMessage('table.nisAllocationReq.createDate')</td>
                            <td width="30%">$!date.format('yyyy-MM-dd',$!{nisBillheadPage.createDate})</td>
                        </tr>
                        <tr>
                            ##单位
                            <td class="textRight" colspan="2" width="20%">#springMessage('table.nisBillhead.corpId')</td>
                            <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.corpName}</div></td>
                            ##付款方式
                            <td class="textRight" colspan="2" width="20%">#springMessage('table.nisBillhead.voucherTypeId')</td>
                            <td width="30%">$!{nisBillheadPage.voucherName}</td>
                        </tr>
                            #if($!{nisBillheadPage.billFrom} == "2")
                            <tr>
                                ##付款账号
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.payerAcc')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payerAcc}</div></td>
                                ##付款账号名称
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.payerAccName')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payerAccName}</div></td>
                            </tr>
                            <tr>
                                ##付款开户行
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.payerBank')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payerBank}</div></td>
                                ##币别
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.curId')</td>
                                <td width="30%">$!{nisBillheadPage.curName}</td>
                            </tr>
                            #else
                            <tr>
                                <td rowspan="4" width="5%" align="center"  style="padding: 0;">
                                    <div style="height: 100%;width: 100%;display:table;">
                                        <div style="display:table-cell; vertical-align:middle;">
                                            #springMessage('table.nisAllocationReq.payerInfo')
                                        </div>
                                    </div>
                                </td>
                                ##付款账号
                                <td class="textRight" width="15%">#springMessage('table.nisBillhead.payerAcc')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payerAcc}</div></td>
                                <td rowspan="4" width="5%" align="center"  style="padding: 0;">
                                    <div style="height: 100%;width: 100%;display:table;">
                                        <div style="display:table-cell; vertical-align:middle;">
                                            #springMessage('table.nisAllocationReq.payeeInfo')
                                        </div>
                                    </div>
                                </td>
                                ##收款账号
                                <td class="textRight" width="15%">#springMessage('table.nisBillhead.payeeAcc')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payeeAcc}</div></td>
                            </tr>
                            <tr>
                                ##付款账号名称
                                <td class="textRight">#springMessage('table.nisBillhead.payerAccName')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payerAccName}</div></td>
                                ##收款账号名称
                                <td class="textRight">#springMessage('table.nisBillhead.payeeAccName')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payeeAccName}</div></td>
                            </tr>
                            <tr>
                                ##付款开户行
                                <td class="textRight">#springMessage('table.nisBillhead.payerBank')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payerBank}</div></td>
                                ##收款开户行
                                <td class="textRight">#springMessage('table.nisBillhead.payeeBank')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payeeBankCode} $!{nisBillheadPage.payeeBank}</div></td>
                            </tr>
                            <tr>
                                ##币别
                                <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
                                <td>$!{nisBillheadPage.curName}</td>
                                #if($!{nisBillheadPage.sysVoucherCode} != "05")
                                    ##省市
                                    <td class="textRight"><div id="payeeAddrDiv">#springMessage('table.nisBillhead.payeeAddr')</div></td>
                                    <td>$!{nisBillheadPage.provName} $!{nisBillheadPage.cityName}</td>
                                #else
                                    <td class="textRight"></td>
                                    <td></td>
                                #end
                            </tr>
                            #end
                            #if($!{nisBillheadPage.sysVoucherCode} == "02" && $!{nisBillheadPage.isAccount} == "1")
                            <tr id="downAccDiv">
                                ##下拨账号
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.bankAcc')</td>
                                <td>$!{nisBillheadPage.downAcc}</td>
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.bankAccName')</td>
                                <td>$!{nisBillheadPage.downAccName}</td>
                            </tr>
                            #end
                            #if($!{nisBillheadPage.directPayFlag} == "y" && $!{nisBillheadPage.billFrom} != "2")
                            <tr id="difBankDiv">
                                ##跨行标志
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.difBank')</td>
                                <td>$dictTag.get("nisBillhead.difBank",$!{nisBillheadPage.difBank})</td>
                                ##地域标志
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.areaSign')</td>
                                <td>$dictTag.get("nisBillhead.areaSign",$!{nisBillheadPage.areaSign})</td>
                            </tr>
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="layui-colla-item" id="billDiv"
                #if($!{nisBillheadPage.sysVoucherCode}!="49" && $!{nisBillheadPage.sysVoucherCode}!="50")
                 style="display: none"
                #end
            >
                <h2 class="layui-colla-title">#springMessage('table.nisBillhead.billInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table layui-table-border">
                        <tr>
                            ##票据类型
                            <td class="textRight" width="20%">#springMessage('table.abVoucherinfo.billType')</td>
                            <td width="30%">
                                $dictTag.get("AB_BILL_TYPE",$!{nisBillheadPage.billType})
                            </td>
                            ##票据流通介质
                            <td class="textRight" width="20%">#springMessage('table.erp.billFlag')</td>
                            <td width="30%">
                                $dictTag.get("AB_BILL_FLAG",$!{nisBillheadPage.billFlag})
                            </td>
                        </tr>
                        #if($!{nisBillheadPage.sysVoucherCode} == "49")
                            <tr>
                                <td class="textRight">#springMessage('table.nisBillhead.isOpenBill')</td>
                                <td colspan="3">$dictTag.get("sf_yn",$!{nisBillheadPage.isOpenBill})</td>
                            </tr>
                        #end
                        #if($!{nisBillheadPage.sysVoucherCode} == "49" && $!{nisBillheadPage.isOpenBill} ==  "0")
                            <tr>
                                <td class="textRight">#springMessage('bill.accebill.busCorp')</td>
                                <td>$!{nisBillheadPage.busCorpName}</td>
                                <td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                                <td>$!{nisBillheadPage.busPersonnel}</td>
                            </tr>
                        #end
                        #if($!{nisBillheadPage.sysVoucherCode} == "50"
                        || ($!{nisBillheadPage.sysVoucherCode} == "49" && $!{nisBillheadPage.isOpenBill} ==  "1"))
                            <tr>
                                ##票据金额
                                <td class="textRight" width="20%">#springMessage('table.nisBillhead.billMoney.lower')</td>
                                <td width="30%">
                                    $!number.formatNumeric($!{nisBillheadPage.billMoney})
                                    <input type="hidden" data-name="billMoney" data-toUp="billMoneyUp" autocomplete="off"
                                           class="layui-input bt-biz-moneyType" value="$!{nisBillheadPage.billMoney}">
                                </td>
                                <td class="textRight" width="20%">#springMessage('table.nisBillhead.billMoney.upper')</td>
                                <td width="30%" style="padding-left:0px"><div id="billMoneyUp" style="line-height: 24px; white-space: normal; word-break: break-all;"></div></td>
                            </tr>
                        #end
                    </table>
                    <!-- 票据信息 -->
                    #if($!nisBillheadPage.billId)
                        #set($billInfoList=$billTag.listAccebillInfoByIds(${nisBillheadPage.billId},${nisBillheadPage.id}))
                        #parse("views/bill/accebill/viewAccebillPage.vm")
                    #end
                </div>
            </div>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.nisBillhead.payInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table layui-table-border">
                        <tbody>
                        <tr>
                            ##金额
                            <td class="textRight" width="20%">#springMessage('table.nisBillhead.payMoney.lower')</td>
                            <td width="30%">
                                $!number.formatNumeric($!{nisBillheadPage.payMoney})
                                <input type="hidden" data-name="payMoney" data-toUp="payMoneyUp_$!{nisBillheadPage.id}" autocomplete="off"
                                       class="layui-input bt-biz-moneyType" value="$!{nisBillheadPage.payMoney}">
                            </td>
                            <td class="textRight" width="20%">#springMessage('table.nisBillhead.payMoney.upper')</td>
                            <td width="30%" style="padding-left:0px"><div id="payMoneyUp_$!{nisBillheadPage.id}" style="line-height: 24px; white-space: normal; word-break: break-all;"></div></td>
                        </tr>
                        <tr>
                            ##加急标志
                            <td class="textRight">#springMessage('table.nisBillhead.isQuick')</td>
                            <td>$dictTag.get("sf_yn",$!{nisBillheadPage.isQuick})</td>
                            ##期望支付日期
                            <td class="textRight">#springMessage('table.nisBillhead.wishPayday')</td>
                            <td>$!date.format('yyyy-MM-dd',$!{nisBillheadPage.wishPayday})</td>
                        </tr>
                        <tr>
                            ##会计凭证号
                            <td class="textRight">#springMessage('table.nisBillhead.bursarBillNo')</td>
                            <td>$!{nisBillheadPage.bursarBillNo}</td>
                            ##业务类别
                            <td class="textRight">#springMessage('table.nisBillhead.busType')</td>
                            <td>$!{nisBillheadPage.busTypeName}</td>
                        </tr>
                        <tr>
                            ##是否对私付款
                            <td class="textRight">#springMessage('table.nisBillhead.isForindividual')</td>
                            <td>$dictTag.get("sf_yn",$!{nisBillheadPage.isForindividual})</td>
                            ##是否已付款
                            <td class="textRight"><div style="display:none" id="isPayedTitle_$!{nisBillheadPage.id}">#springMessage('table.nisBillhead.isPayed')</div></td>
                            <td><div style="display:none" id="isPayed_$!{nisBillheadPage.id}">$dictTag.get("nisBillhead.isPayed",$!{nisBillheadPage.isPayed})</div></td>
                        </tr>
                        <tr>
                            ##用途
                            <td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
                            <td>$!{nisBillheadPage.purpose}</td>
                            ##附言
                            <td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
                            <td>$!{nisBillheadPage.addWord}</td>
                        </tr>
                        <tr>
                            ##备注说明
                            <td class="textRight"  width="20%">#springMessage('table.settlement.rmk')</td>
                            <td width="100%" colspan="4">$!{nisBillheadPage.rmk}</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- 日志 -->
        <div id="tagMsg_$!{nisBillheadPage.id}"></div>
    </div>
#end
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script>
    bt.use(['form', 'layer', 'moneyType'], function () {
        var $ = bt.jquery, form = bt.form();
        bt.moneyType.init();
        /**
         * 生成日志列表
         * @return
         */
        $genMsgHtml = function (id) {
            var url = basePath + "/netbank/nismessage/list/" + id + "/" + $("#busType").val() + "?timestamp=" + new Date().getTime();
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg_"+id).html("");
                    $("#tagMsg_"+id).html(json);
                    form.render();
                }
            });
        }
        var ids = $("#ids").val().split(',');
        for (var i=0;i<ids.length;i++) {
            $genMsgHtml(ids[i]);
        }

        var LODOP=getLodop();
        LODOP.SET_PRINT_MODE("PRINT_PAGE_PERCENT", "Auto-Width");
        var printHtmlPre = "<!DOCTYPE html>\n" +
                "<html lang=\"en\">\n" +
                "<head>";
        printHtmlPre += $('head').html();
        printHtmlPre += "</head>"
        var printDocLength = $('div[name="print_doc1"]').length;
        var printHtml = "";
        $('div[name="print_doc1"]').each(function (i) {
            /*var no = i + 1;
            if (no % 2 == 0) {
                printHtml = printHtml + $(this).html();
            } else {*/
                printHtml = $(this).html() + '</br></br></br>';
            /*}
            if (no % 2 == 0 || no == printDocLength) {*/
                //A4一页两份（纵向）
                LODOP.SET_PRINT_PAGESIZE(3, 0, 0, "A4");
                LODOP.ADD_PRINT_HTM(0, 10, "100%", "100%", printHtmlPre + printStyle + '<body>' + printHtml + '</body>');
                LODOP.NewPageA();
            /*}*/
        })
        LODOP.PREVIEW();
    });
</script>
</body>
</html>

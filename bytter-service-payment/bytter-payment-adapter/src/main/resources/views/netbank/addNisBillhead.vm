<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <input id="isAccebillIntellect" name="isAccebillIntellect" type="hidden" value="$!{isAccebillIntellect}">
    <input id="billNo" name="billNo" type="hidden" value="$!{nisBillheadPage.billNo}">
    <input id="caInfoId" name="caInfoId" type="hidden" value="$!{nisBillheadPage.caInfoId}">
    <input id="createBy" name="createBy" type="hidden" value="$!{nisBillheadPage.createBy}">
    ##		<input id="createDate" name="createDate" type="hidden" value="$!{nisBillheadPage.createDate}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{nisBillheadPage.updateBy}">
    ##		<input id="updateDate" name="updateDate" type="hidden" value="$!{nisBillheadPage.updateDate}">
    <input id="id" name="id" type="hidden" value="$!{nisBillheadPage.id}">
    <!-- 新增默认 -->
    <input id="billFrom" name="billFrom" type="hidden" value="1">
    <input id="directPayFlag" name="directPayFlag" type="hidden" value="y">
    <input id="status" name="status" type="hidden" value="0">
    <input id="isAutoPay" name="isAutoPay" type="hidden" value="0">
    <input id="timeStamp" name="timeStamp" type="hidden" value="">
    <!-- 所用账号单位代码 -->
    <input id="accCorpId" name="accCorpId" type="hidden" value="">
    <!-- 付款方式相关属性 -->
    <input id="sysVoucherCode" name="sysVoucherCode" type="hidden" value="">
    <input id="isAccount" name="isAccount" type="hidden" value="">
    <input id="isBudget" name="isBudget" type="hidden" value="">
    <!-- 付/收款账号相关属性 -->
    <input id="accId" name="accId" type="hidden" value="">
    <input id="bifCode" name="bifCode" type="hidden" value="">
    <input id="payerBankCode" name="payerBankCode" type="hidden" value="">
    <input id="bankNamePrefix" name="bankNamePrefix" type="hidden" value="">
    <input id="payerProv" name="payerProv" type="hidden" value="">
    <input id="payerCity" name="payerCity" type="hidden" value="">
    <input id="payerBankTypeId" name="payerBankTypeId" type="hidden" value="">
    <input id="payeeProv" name="payeeProv" type="hidden" value="">
    <input id="payeeCity" name="payeeCity" type="hidden" value="">
    <input id="bankTypeId" name="bankTypeId" type="hidden" value="">
    <input id="billCorpName" name="billCorpName" type="hidden" value="">
    <!-- 系统参数 -->
    <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
    <input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
    <input id="defItemCode" name="defItemCode" type="hidden" value="">
    <input id="accountOver" name="accountOver" type="hidden" value="$!{accountOver}">
    <input id="bankaccOver" name="bankaccOver" type="hidden" value="$!{bankaccOver}">
    <input id="balControlType" name="balControlType" type="hidden" value="$!{balControlType}">
    <input id="showIsPayed" name="showIsPayed" type="hidden" value="$!{showIsPayed}">
    <input id="externalCorp" name="externalCorp" type="hidden" value="$!{externalCorp}">
    <input id="isOpenLimit" name="isOpenLimit" type="hidden" value="$!{isOpenLimit}">
    <input id="allowDifferentBillMoney" name="allowDifferentBillMoney" type="hidden"
           value="$!{allowDifferentBillMoney}">
    <!-- 资金计划参数 明细项控制模式-->
    <input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
    <input id="settlType" name="settlType" type="hidden" value="">
    <!-- 人民币 -->
    <input id="natualCurId" name="natualCurId" type="hidden" value="$!{currencyTag.getRMBCurrency().id}">
    <input id="natualCurName" name="natualCurName" type="hidden" value="$!{currencyTag.getRMBCurrency().curName}">
    <input type="hidden" name="sysDate" lay-verify="required" class="layui-input bt-biz-dateType" data-type="date"
           data-today="true" data-name="sysDate" data-biz-name="sysDate">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.nisBillhead.titleInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##单位
                        <td class="textRight" width="20%" colspan="2">#springMessage('table.nisBillhead.corpId')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="corpId"
                                     data-biz-name="corpId"
                                     data-scope="all"
                                     data-resource="netbank:netBank:nisBillHead:add"
                                     data-required="true"
                                     data-callback="bt.corpCallback"></div>
                            </div>
                        </td>
                        ##付款方式
                        <td class="textRight" width="20%" colspan="2">#springMessage(
                            'table.nisBillhead.voucherTypeId')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <select name="voucherTypeId" id="voucherTypeId" lay-verify="required" lay-search=""
                                        lay-filter="voucherTypeId">
                                    <option value=""></option>
                                </select>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td rowspan="3" width="5%" align="center">#springMessage(
                            'table.nisAllocationReq.payerInfo')</td>
                        ##付款账号
                        <td class="textRight" width="15%">#springMessage('table.nisBillhead.payerAcc')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" id="payerAcc" name="payerAcc" lay-verify="required|tableData"
                                       data-biz-name="payerAcc"
                                       autocomplete="off" class="layui-input text"
                                       placeholder="#springMessage('table.nisBillhead.payerAcc')">
                                <table id="payerAccTable" class="hide">
                                    <thead>
                                    <tr>
                                        <th>#springMessage('table.nisBillhead.payerAcc')</th>
                                        <th>#springMessage('table.nisBillhead.payerAccName')</th>
                                        <th>#springMessage('table.nisBillhead.payerBank')</th>
                                        <th>#springMessage('table.nisBillhead.curId')</th>
                                        <th>#springMessage('table.btBankAcc.isOnline')</th>
                                    </tr>
                                    </thead>
                                </table>
                            </div>
                            <div class="layui-input-inline">
                                <input type="checkbox" name="isReserve" id="isReserve" lay-skin="primary"
                                       title="#springMessage('common.button.reserve')" value="1">
                            </div>
                        </td>
                        <td rowspan="3" width="5%" align="center">#springMessage(
                            'table.nisAllocationReq.payeeInfo')</td>
                        ##收款账号
                        <td class="textRight" width="15%">#springMessage('table.nisBillhead.payeeAcc')</td>
                        <td width="30%">
                            <div class="layui-input-inline" id="payeeAccDiv" style="width: 180px;">
                                #if("$!{externalCorp}" == "1")
                                    <input type="text" id="payeeAcc" name="payeeAcc" lay-verify="required"
                                           autocomplete="off" class="layui-input" style="width: 180px;"
                                           placeholder="#springMessage('table.nisBillhead.payeeAcc')">
                                #else
                                    <input type="text" id="payeeAcc" name="payeeAcc" lay-verify="required"
                                           width="180px;"
                                           autocomplete="off" class="layui-input" style="width: 180px;"
                                           placeholder="#springMessage('table.nisBillhead.payeeAcc')">
                                #end
                                <div class="bt-div-search">
                                    <button class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button"
                                            data-beforeClick="bt.externalCorpBankAccParams"
                                            data-callback="bt.externalCorpCallback"
                                            title="#springMessage('common.button.select')">
                                        ##											<i class="layui-icon">&#xe615;</i>
                                        <span class="iconfont byicon_box_search"></span>
                                    </button>
                                </div>
                            </div>
                            <div class="layui-input-inline" id="payeeAccTempDiv" style="display:none">
                                <input type="text" id="payeeAccTemp" name="payeeAccTemp" lay-verify="required|tableData"
                                       data-biz-name="payeeAccTemp"
                                       autocomplete="off" class="layui-input text"
                                       placeholder="#springMessage('table.nisBillhead.payeeAcc')">
                                <table id="payeeAccTable" class="hide">
                                    <thead>
                                    <tr>
                                        <th>#springMessage('table.nisBillhead.payeeAcc')</th>
                                        <th>#springMessage('table.nisBillhead.payeeAccName')</th>
                                        <th>#springMessage('table.nisBillhead.payeeBank')</th>
                                        <th>#springMessage('table.nisBillhead.curId')</th>
                                    </tr>
                                    </thead>
                                </table>
                            </div>
                            #if("$!{externalCorp}" == "0")
                                ##是否保存客商资料
                                <div class="layui-inline">
                                    <input type="checkbox" name="isExternalCorp" lay-skin="primary"
                                           title="#springMessage('common.button.save')" lay-filter="isCommon" value="1"
                                           checked>
                                </div>
                                ##是否共享
                                <div class="layui-inline" id="isCommonDiv">
                                    <div class="bt-biz-dict" data-type="radio" data-group="externalCorp.isCommon"
                                         data-name="isCommon" data-biz-name="isCommon" data-defaultvalue="1"></div>
                                </div>
                            #end
                        </td>
                    </tr>
                    <tr>
                        ##付款账号名称
                        <td class="textRight">#springMessage('table.nisBillhead.payerAccName')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" id="payerAccName" name="payerAccName" lay-verify="required"
                                        style="width:300px;"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.nisBillhead.payerAccName')">
                            </div>
                        </td>
                        ##收款账号名称
                        <td class="textRight">#springMessage('table.nisBillhead.payeeAccName')</td>
                        <td>
                            <div class="layui-input-inline" id="payeeAccNameDiv">
                                #if("$!{externalCorp}" == "1")
                                    <input type="text" id="payeeAccName"
                                           class="layui-input bt-biz-inputExternalCorpBankAcc" data-url=""
                                           name="payeeAccName" data-biz-name="payeeAccName"
                                           data-valuefield="inputExternalValue" data-textfield="inputExternalText"
                                           data-search="seachExternalCorpBankAcc" lay-verify="required"
                                           placeholder="#springMessage('table.nisBillhead.payeeAccName')"
                                           data-callback="inputExternalCorpCallback" style="width:321px;">
                                #else
                                    <input type="text" id="payeeAccName"
                                           class="layui-input bt-biz-inputExternalCorpBankAcc" data-url=""
                                           name="payeeAccName" data-biz-name="payeeAccName"
                                           data-valuefield="inputExternalValue" data-textfield="inputExternalText"
                                           data-search="seachExternalCorpBankAcc" lay-verify="required"
                                           placeholder="#springMessage('table.nisBillhead.payeeAccName')"
                                           data-callback="inputExternalCorpCallback" style="width:321px;">
                                #end
                            </div>
                            <div class="layui-input-inline" id="payeeAccNameTempDiv" style="display:none">
                                <input type="text" id="payeeAccNameTemp" name="payeeAccName" lay-verify="required"
                                       style="width:321px;"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.nisBillhead.payeeAccName')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##付款开户行
                        <td class="textRight">#springMessage('table.nisBillhead.payerBank')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" id="payerBank" name="payerBank" lay-verify="required"
                                       style="width:300px;" readonly="readonly"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.nisBillhead.payerBank')">
                            </div>
                        </td>
                        ##收款开户行
                        <td class="textRight">#springMessage('table.nisBillhead.payeeBank')</td>
                        <td>
                            <div class="layui-input-inline" id="payeeBankCodeDiv">
                                #if("$!{externalCorp}" == "1")
                                    <input type="text" id="payeeBankCode" name="payeeBankCode" lay-verify="required"
                                           readonly="readonly" style="width:130px;"
                                           autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('table.nisBillhead.payeeBankCode')">
                                #else
                                    <input type="text" id="payeeBankCode" name="payeeBankCode" lay-verify="required"
                                           readonly="readonly" style="width:130px;"
                                           autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('table.nisBillhead.payeeBankCode')">
                                    <div class="bt-div-search">
                                        <button class="bt-biz-bankInfo" id="selPayeeBankBut" type="button"
                                                data-callback="bt.bankinfoCallback"
                                                title="#springMessage('common.button.select')">
                                            ##												<i class="layui-icon">&#xe615;</i>
                                            <span class="iconfont byicon_box_search"></span>
                                        </button>
                                    </div>
                                #end
                            </div>
                            <div class="layui-input-inline">
                                <input type="text" id="payeeBank" name="payeeBank" lay-verify="required"
                                       style="width:300px;" readonly="readonly"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.nisBillhead.payeeBank')">
                            </div>
                        </td>
                    </tr>
                    <tr id="realPayerAccIdDiv" style="display:none">
                        ##结算中心实际付款账号
                        <td class="textRight" colspan="2">结算中心实际付款账号</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="hidden" id="realPayerAccId" name="realPayerAccId">
                                <input type="text" id="realPayerAcc" name="realPayerAcc" lay-verify="required|tableData"
                                       data-biz-name="realPayerAcc"
                                       autocomplete="off" class="layui-input text"
                                       placeholder="结算中心实际付款账号">
                                <table id="realPayerAccTable" class="hide">
                                    <thead>
                                    <tr>
                                        <th>#springMessage('table.btBankAcc.bankAcc')</th>
                                        <th>#springMessage('table.btBankAcc.accName')</th>
                                        <th>#springMessage('table.btBankAcc.bankName')</th>
                                        <th>#springMessage('table.nisBillhead.curId')</th>
                                    </tr>
                                    </thead>
                                </table>
                            </div>
                        </td>
                        ##付款账号余额
                        <td class="textRight" colspan="2">付款账号余额</td>
                        <td>
                            <div id="realPayerAccBalDiv" name="realPayerAccBalDiv"></div>
                        </td>
                    </tr>
                    <tr>
                        ##账户余额
                        <td class="textRight" colspan="2">#springMessage('table.nisBillhead.balance')</td>
                        <td>
                            <div id="balanceDiv" name="balanceDiv"></div>
                            <input type="hidden" id="balance" name="balance" style="text-align:right"
                                   readonly="readonly" data-name="balance" data-biz-name="balance"
                                   autocomplete="off" class="layui-input bt-biz-moneyType"
                                   placeholder="#springMessage('table.bisAccBal.availBal')">
                        </td>
                        ##收款单位统一社会信用代码
                        <td class="textRight" colspan="2">#springMessage('table.nisBillhead.socCode')</td>
                        <td>
                            <div class="layui-input-inline">
                                #if("$!{externalCorp}" == "1")
                                    <input type="text" id="blRcvpymtpsUnnIdNo" name="blRcvpymtpsUnnIdNo"
                                           readonly="readonly" style="width:300px;"
                                           autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('table.nisBillhead.socCode')">
                                #else
                                    <input type="text" id="blRcvpymtpsUnnIdNo" name="blRcvpymtpsUnnIdNo"
                                           style="width:300px;"
                                           autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('table.nisBillhead.socCode')">
                                #end
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##系统可用余额
                        <td class="textRight" colspan="2">系统可用余额</td>
                        <td>
                            <div id="availBalDiv" name="availBalDiv"></div>
                            <input type="hidden" id="availBal" name="availBal" style="text-align:right"
                                   readonly="readonly" data-name="availBal" data-biz-name="availBal"
                                   autocomplete="off" class="layui-input bt-biz-moneyType"
                                   placeholder="系统可用余额">
                        </td>
                        ##省市
                        <td class="textRight" colspan="2"><div id="payeeAddrDiv">#springMessage('table.nisBillhead.payeeAddr')</div></td>
                        <td>
                            <div class="layui-input-inline" id="payeeAddr">
                                <div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="prov"
                                     data-change="city" data-defaultvalue="" data-required="true"
                                     data-callback="bt.provCallback"></div>
                                <div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="city"
                                     data-defaultvalue="" data-required="true" data-callback="bt.cityCallback"></div>
                            </div>
                        </td>
                    </tr>
                    <tr id="downAccDiv" style="display:none">
                        ##下拨账号
                        <td class="textRight" colspan="2">#springMessage('table.nisBillhead.bankAcc')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="hidden" id="downAccId" name="downAccId">
                                <input type="text" id="downAcc" name="downAcc" lay-verify="required|tableData"
                                       data-biz-name="downAcc"
                                       autocomplete="off" class="layui-input text"
                                       placeholder="#springMessage('table.nisBillhead.bankAcc')">
                                <table id="downAccTable" class="hide">
                                    <thead>
                                    <tr>
                                        <th>#springMessage('table.btBankAcc.bankAcc')</th>
                                        <th>#springMessage('table.btBankAcc.accName')</th>
                                        <th>#springMessage('table.btBankAcc.bankName')</th>
                                        <th>#springMessage('table.nisBillhead.curId')</th>
                                    </tr>
                                    </thead>
                                </table>
                            </div>
                        </td>
                        ##下拨账号户名
                        <td class="textRight" colspan="2">#springMessage('table.nisBillhead.bankAccName')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" id="downAccName" name="downAccName" readonly="readonly"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.nisBillhead.bankAccName')">
                            </div>
                        </td>
                    </tr>
                    <tr id="difBankDiv" style="display:none">
                        ##跨行标志
                        <td class="textRight" colspan="2">#springMessage('table.nisBillhead.difBank')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.difBank"
                                 data-defaultvalue="0" data-name="difBank" data-biz-name="difBank"
                                 data-required="true"></div>
                        </td>
                        ##地域标志
                        <td class="textRight" colspan="2">#springMessage('table.nisBillhead.areaSign')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.areaSign"
                                 data-defaultvalue="0" data-name="areaSign" data-biz-name="areaSign"
                                 data-required="true"></div>
                        </td>
                    </tr>
                    <tr>
                        ##是否已付款
                        <td class="textRight" colspan="2">
                            <div style="display:none" id="isPayedTitle">#springMessage(
                                'table.nisBillhead.isPayed')</div>
                        </td>
                        <td>
                            <div style="display:none" id="isPayed">
                                <div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.isPayed"
                                     data-defaultvalue="0" data-name="isPayed" data-biz-name="isPayed"
                                     data-required="true" data-callback="isPayedCallBack"></div>
                            </div>
                        </td>
                        ##币别
                        <td class="textRight" colspan="2">#springMessage('table.nisBillhead.curId')</td>
                        <td>
                            <div id="curDiv" name="curDiv">$!{nisBillheadPage.curName}</div>
                            <input type="hidden" id="curId" name="curId" value="$!{nisBillheadPage.curId}">
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="layui-colla-item" id="billDiv" style="display: none">
            <h2 class="layui-colla-title">#springMessage('table.nisBillhead.billInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    #*<tr style="display:none" id="billTd2">
                        ##票据类型
                        <td class="textRight" width="20%">#springMessage('table.abVoucherinfo.billType')</td>
                        <td width="30%">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE"
                                 data-name="billType" data-biz-name="billType"></div>
                        </td>
                        ##票据流通介质
                        <td class="textRight" width="20%">#springMessage('table.erp.billFlag')</td>
                        <td width="30%">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_FLAG"
                                 data-name="billFlag" data-biz-name="billFlag"></div>
                        </td>
                    </tr>*#
                    <tr style="display:none" id="billTd">
                        ##票据信息
                        <td class="textRight" width="20%"><span class="pl"><span
                                class="required-icon">*</span></span>#springMessage('table.nisBillhead.billId')</td>
                        <td colspan="3">
                            <div class="layui-input-inline" data-required="true">
                                <input type="hidden" id="billId" name="billId" autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.billId')">
                                <input type="hidden" id="billBalance" name="billBalance" autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.billId')">
                                <input type="hidden" id="vvid" name="vvid" autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.billId')">
                                <input type="hidden" id="billPoolIds" name="billPoolIds" autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.billId')">
                            </div>
                            <div class="layui-input-inline">
                                <button class="layui-btn bt-biz-accebillInfoReceive" id="accebillInfoBut" type="button"
                                        data-beforeClick="bt.accebillInfoReceiveParams"
                                        data-callback="bt.accebillInfoCallback">#springMessage(
                                    'common.button.select')</button>
                                <button class="layui-btn bt-biz-accebillView" id="accebillViewBut" type="button"
                                        data-beforeClick="bt.accebillViewParams"
                                        data-callback="bt.accebillViewParams">#springMessage(
                                    'common.button.view')</button>
                                #if($!{isAccebillIntellect} eq '1')
                                    <button class="layui-btn bt-biz-accebillIntellect" id="accebillIntellectBut"
                                            type="button" data-beforeClick="bt.accebillIntellectParams"
                                            data-callback="bt.accebillIntellectCallback">#springMessage(
                                        'common.button.accebillIntellect')</button>
                                #end
                            </div>
                        </td>
                    </tr>
                    <tr style="display:none" id="billTd1">
                        ##是否已开票
                        <td class="textRight" width="20%">#springMessage('table.nisBillhead.isOpenBill')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-required="true"
                                 data-defaultvalue="0" data-name="isOpenBill" data-biz-name="isOpenBill"
                                 data-defaultvalue="$!{nisBillheadPage.isOpenBill}"
                                 data-callback="isOpenBillCallBack"></div>
                        </td>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <input id="id" name="id" type="hidden" value="$!{nisDemand.id}">
    <input id="billNo" name="billNo" type="hidden" value="$!{nisDemand.billNo}">
    <input id="status" name="status" type="hidden" value="$!{nisDemand.status}">
    <!-- 前端单据信息 -->
    <input id="payBillId" name="payBillId" type="hidden" value="$!{nisDemand.payBillId}">
    <input id="payBillNo" name="payBillNo" type="hidden" value="$!{nisDemand.payBillNo}">
    <input id="payBillDate" name="payBillDate" type="hidden" value="$!{nisDemand.payBillDate}">
    <!-- 下拨信息 -->
    <input id="allocationNo" name="allocationNo" type="hidden" value="$!{nisDemand.allocationNo}">
    <input id="allocationId" name="allocationId" type="hidden" value="$!{nisDemand.allocationId}">
    <input id="allocationDate" name="allocationDate" type="hidden" value="$!{nisDemand.allocationDate}">
    <input id="isSummary" name="isSummary" type="hidden" value="$!{nisDemand.isSummary}">

    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="20%">单位</td>
            <td width="30%">
                <input type="hidden" id="corpIdDef" value="$!{nisDemand.corpId}">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-biz-name="corpId"
                         data-scope="all"
                         data-resource="netbank:nisDemand:apply"
                         data-required="true"
                         data-defaultvalue="$!{nisDemand.corpId}"
                         data-callback="bt.corpCallback"></div>
                </div>
            </td>
            ##上级单位
            <td class="textRight" width="20%" >上级单位</td>
            <td width="30%">
                <input id="superCorpId" name="superCorpId" type="hidden" value="$!{nisDemand.superCorpId}">
                <div id="superCorpIdDiv">$!{nisDemand.superCorpName}</div>
            </td>
        </tr>
        <tr>
            <td class="textRight">需求账号</td>
            <td>
                <div class="layui-input-inline">
                    <input id="bankAccId" name="bankAccId" type="hidden" value="$!{nisDemand.bankAccId}">
                    <input type="text" id="bankAcc" name="bankAcc" lay-verify="required|tableData"
                           data-biz-name="bankAcc"
                           autocomplete="off" class="layui-input text"
                           value="$!{nisDemand.bankAcc}"
                           placeholder="#springMessage('table.nisBillhead.payerAcc')">
                    <table id="bankAccTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.nisBillhead.payerAcc')</th>
                            <th>#springMessage('table.nisBillhead.payerAccName')</th>
                            <th>#springMessage('table.nisBillhead.payerBank')</th>
                            <th>#springMessage('table.nisBillhead.curId')</th>
                            <th>#springMessage('table.btBankAcc.isOnline')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
            <td class="textRight">上级账号</td>
            <td>
                <div class="layui-input-inline">
                    <input id="superBankAccId" name="superBankAccId" type="hidden" value="$!{nisDemand.superBankAccId}">
                    <input type="text" id="superBankAcc" name="superBankAcc" lay-verify="required|tableData"
                           data-biz-name="superBankAcc"
                           value="$!{nisDemand.superBankAcc}"
                           autocomplete="off" class="layui-input text"
                           placeholder="上级账号">
                    <table id="superBankAccTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.nisBillhead.payerAcc')</th>
                            <th>#springMessage('table.nisBillhead.payerAccName')</th>
                            <th>#springMessage('table.nisBillhead.payerBank')</th>
                            <th>#springMessage('table.nisBillhead.curId')</th>
                            <th>#springMessage('table.btBankAcc.isOnline')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">户名</td>
            <td>
                <input id="accName" name="accName" type="hidden" value="$!{nisDemand.accName}">
                <div id="accNameDiv">$!{nisDemand.accName}</div>
            </td>
            <td class="textRight">上级账号户名</td>
            <td>
                <input id="superAccName" name="superAccName" type="hidden" value="$!{nisDemand.superAccName}">
                <div id="superAccNameDiv">$!{nisDemand.superAccName}</div>
            </td>
        </tr>
        <tr>
            <td class="textRight">开户银行</td>
            <td>
                <input id="bankName" name="bankName" type="hidden" value="$!{nisDemand.bankName}">
                <div id="bankNameDiv">$!{nisDemand.bankName}</div>
            </td>
            <td class="textRight">上级账号开户行</td>
            <td>
                <input id="superBankName" name="superBankName" type="hidden" value="$!{nisDemand.superBankName}">
                <div id="superBankNameDiv">$!{nisDemand.superBankName}</div>
            </td>
        </tr>
        <tr>
            <td class="textRight">账户当前余额</td>
            <td>
                <div id="balDiv">$!number.formatNumeric($!{nisDemand.bal})</div>
            </td>
            <td class="textRight">上级账户当前余额</td>
            <td>
                <div id="superBalDiv">$!number.formatNumeric($!{nisDemand.superBal})</div>
            </td>
        </tr>
        <tr>
            <td class="textRight">账户可用资金</td>
            <td>
                <div id="availBalDiv">$!number.formatNumeric($!{nisDemand.availBal})</div>
            </td>
            <td class="textRight">上级账户可用资金</td>
            <td>
                <div id="superAvailBalDiv">$!number.formatNumeric($!{nisDemand.superAvailBal})</div>
            </td>
        </tr>
        <tr>
            <td class="textRight">资金需求类型</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="nisDemand.demandType"
                     data-name="demandType" data-biz-name="demandType" data-required="true" data-defaultvalue="$!{nisDemand.demandType}"></div>
            </td>
            <td class="textRight">需求日期</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="demandDate" lay-verify="required"
                           class="layui-input bt-biz-dateType"
                           data-today="true"  data-type="date"
                           value="$!{nisDemand.demandDate}"
                           data-name="demandDate" data-biz-name="demandDate">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">需求金额</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="demandMoney" name="demandMoney" style="text-align:right"
                           lay-verify="required|number2" data-name="demandMoney"
                           data-biz-name="demandMoney" data-callback="demandMoneyCallBack"
                           autocomplete="off" class="layui-input bt-biz-moneyType"
                           value="$!{nisDemand.demandMoney}"
                           placeholder="需求金额">
                </div>
            </td>
            <td class="textRight">需求下拨金额</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="demandAllocationMoney" name="demandAllocationMoney" style="text-align:right"
                           lay-verify="required|number2" data-name="demandAllocationMoney"
                           data-biz-name="demandAllocationMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType"
                           value="$!{nisDemand.demandAllocationMoney}"
                           placeholder="需求下拨金额">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">前端单据编码</td>
            <td>
                <div>$!{nisDemand.payBillNo}</div>
            </td>
            <td class="textRight">业务日期</td>
            <td>
                <div>$!date.format('yyyy-MM-dd',$!{nisDemand.payBillDate})</div>
            </td>
        </tr>
        </tbody>
    </table>
    <div style="text-align: center; padding-top: 10px;">
        <button class="layui-btn" lay-submit="" lay-filter="submit" value="1">#springMessage(
            'common.button.submit')</button>
        <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage(
            'common.button.temp')</button>
        <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage(
            'common.button.reset')</button>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/netbank/nisDemand.edit.js?_btv=${resourceVersion}"></script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{bisFailReasonPage.id}">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight" width="30%">#springMessage('table.bisFailReason.failCode')</td>
					<td>
                        <input type="text" name="failCode" lay-verify="required|langKey|strlength" data-maxlength="12"
                        	autocomplete="off" class="layui-input" placeholder="#springMessage("table.bisFailReason.failCode")">
                    </td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.bisFailReason.failName')</td>
					<td>
                        <input type="text" name="failName" lay-verify="required|strlength" data-maxlength="50"
                        	autocomplete="off" class="layui-input" placeholder="#springMessage("table.bisFailReason.failName")">
                    </td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('table.bisExc.bifCode')</td>
					<td>
						<div class="layui-input-inline">
							<div data-name="bifCode" class="bt-biz-mulselectType"
								 data-url="${basePath}/basic/business/bisbifinit/json"
								 data-valueField="id"
								 data-biz-name="bifCode"
								 data-textField="name"
								 data-search="true"
								 data-method="get"></div>
						</div>
					</td>
				</tr>
                <tr>
                    <td class="textRight">#springMessage('table.bisFailReason.keyWords')</td>
                    <td>
                        <textarea placeholder="#springMessage('table.bisFailReason.keyWords')" lay-verify="required|strlength" class="layui-textarea" id="keyWords" name="keyWords" data-maxlength="200"></textarea>
						<div style="color: red">#springMessage('table.bisFailReason.keyWords.desc')</div>
                    </td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('table.bisFailReason.actionCode')</td>
					<td>
                        <div class="bt-biz-dict" data-type="select" data-group="bisFailReason.actionCode" data-required="required" data-defaultvalue="0" data-name="actionCode" data-biz-name="actionCode"></div>
                    </td>
				</tr>
    			<tr >
                    <td colspan="2" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/bisFailReason.add.js?_btv=${resourceVersion}"></script>
</html>

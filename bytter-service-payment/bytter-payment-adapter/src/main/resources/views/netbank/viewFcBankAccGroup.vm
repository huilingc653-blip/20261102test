<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight" width="40%">#springMessage('fcBankAccGroup.code')</td>
					<td>
						$!{fcBankAccGroupPage.accGroupCode}
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('fcBankAccGroup.name')</td>
					<td>
						$!{fcBankAccGroupPage.accGroupName}
					</td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('fcBankAccGroup.operation.area')</td>
					<td>
						$!{fcBankAccGroupPage.areaNames}
					</td>
				</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
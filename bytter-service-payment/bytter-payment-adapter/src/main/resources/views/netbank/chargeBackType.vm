<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            min-width: 400px;
        }
    </style>
</head>
<body>
    <div class=layui-form style="width: 400px;">
        <div class=layui-form-item style="width: 400px;">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.btChargeBackType.busType')</label>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/netbank/btchargebacktype/json"
                         data-name="eqs_chargeBackType" data-valueField="busType" data-inputvalue="inputvalue"
                         data-textField="busTypeName" data-defaultvalue="$!{chargeBackType}"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <input type="hidden" id="type" value="$!{type}">
            <button class="layui-btn"  type="button" onclick="toSubmit()">确认</button>
            <button class="layui-btn"  type="button" onclick="toCancel()">取消</button>
        </div>
    </div>
</body>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form', 'layer','selectType'], function () {
        var $ = bt.jquery, form = bt.form();
        bt.selectType.init();
    });
    function toSubmit() {
        var chargeBackType = $("select[name='eqs_chargeBackType']").val();
        if(chargeBackType.trim() == ""){
            layer.alert(bt.lang('common.message.not.chargeBackType'), {icon: 7});
            return;
        }
        var currentParentIframe = top.$('.layui-tab-content > .layui-show').find('iframe')[0]['name'];
        var type = $("#type").val();
        if(type == "batch") {
            top.frames[currentParentIframe].window.chargeBackTypeCallback(chargeBackType.trim());
        }else{
            top.frames[currentParentIframe].window.chargeCallback(chargeBackType.trim());
        }
    }
    function toCancel() {
        parent.layer?parent.layer.closeAll():layer.closeAll();
    }
</script>
</body>
</html>

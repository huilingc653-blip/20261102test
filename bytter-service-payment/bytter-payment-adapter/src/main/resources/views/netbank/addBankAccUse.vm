<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody >
        <tr>
            <td class="textRight" width="30%">#springMessage('用途编码')</td>
            <td >
                <input type="text" id="useCode" name="useCode" lay-verify="required|langKey|strlength" data-maxlength="32" autocomplete="off" class="layui-input" placeholder="#springMessage('用途编码')">
            </td>
        </tr>
        <tr >
            <td class="textRight">#springMessage('用途名称')</td>
            <td>
                <input type="text" id="useName" name="useName" lay-verify="required|strlength" data-maxlength="100" autocomplete="off" class="layui-input" placeholder="#springMessage('用途名称')">
            </td>
        </tr>
        <tr >
            <td class="textRight">#springMessage('备注')</td>
            <td>
                <textarea placeholder="#springMessage('备注')" lay-verify="strlength" data-maxlength="100" class="layui-textarea" id="useRmk" name="useRmk" ></textarea>
            </td>
        </tr>
        <tr >
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form', 'layedit', 'selectType', 'dicts'], function () {
        var $ = bt.jquery, form = bt.form();

        //监听提交
        form.on('submit(submit)', function (data) {
            var action = "/netbank/bankAccUse/save";
            $.post(basePath + action, data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                if (result.success){
                    parent.layer.closeAll();
                }
            }, 'JSON');
            return false;
        });
    });

</script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body {
            font-size: 14px;
            padding-bottom: 60px;
        }

        .layui-form-label {
            width: 180px;
        }

        .layui-input-block {
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.ele.param.titile.transfer')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## 历史电子回单迁移天数
                        <td class="textRight">#springMessage('config.ele.transferDays')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="ele.transferDays" autocomplete="off"
                                       class="layui-input bt-biz-moneyType" data-decimal="0" data-separator=""
                                       value="$!{config.ele.transferDays}">
                            </div>
                            <div class="layui-input-inline">
                                <i id="transferDays-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 历史电子回单单次迁移数量
                        <td class="textRight">#springMessage('config.ele.transferNumber')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="ele.transferNumber" autocomplete="off"
                                       class="layui-input bt-biz-moneyType" data-decimal="0" data-separator=""
                                       value="$!{config.ele.transferNumber}">
                            </div>
                            <div class="layui-input-inline">
                                <i id="transferNumber-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.ele.param.titile.rpa')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## rpa查询天数
                        <td class="textRight">#springMessage('config.ele.rpaDateNumber')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="ele.rpaDateNumber" autocomplete="off"
                                       class="layui-input bt-biz-moneyType" data-decimal="0" data-separator=""
                                       value="$!{config.ele.rpaDateNumber}">
                            </div>
                            <div class="layui-input-inline">
                                <i id="rpaDateNumber-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.ele.param.titile.Blending')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ##是否启用模糊匹配
                        <td class="textRight">#springMessage('config.ele.fuzzyMatching')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="ele.fuzzyMatching" value="1" #if($config.ele.fuzzyMatching == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                                <input type="radio" name="ele.fuzzyMatching" value="0" #if($config.ele.fuzzyMatching == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 后台任务每批次执行笔数
                        <td width="20%" class="textRight">后台任务每批次执行笔数</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="text" name="ele.autoCount" autocomplete="off" class="layui-input bt-biz-moneyType"
                                       data-decimal="0" data-separator="" value="$!{config.ele.autoCount}"
                                       data-min="1" >
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 电子回单勾对滚动匹配天数
                        <td width="20%" class="textRight">电子回单勾对滚动匹配天数</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="text" name="ele.rollMate" autocomplete="off" class="layui-input bt-biz-moneyType"
                                       data-decimal="0" data-separator="" value="$!{config.ele.rollMate}"
                                       data-min="1">
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="20%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form', 'jquery', 'dicts', 'moneyType', 'element'], function () {
        var form = bt.form(), $ = bt.jquery;
        bt.element();
        bt.dicts.init();
        bt.moneyType.init();
        //监听提交
        form.on('submit(configSubmit)', function (data) {
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, "JSON");
            return false;
        });

        // 说明显示隐藏
        showDesc();
    });

    function showDesc() {
        var tip_index1 = 0;
        $('#transferDays-desc').mouseenter(function () {
            tip_index1 = layer.tips(bt.lang('config.ele.transferDays.desc'), '#transferDays-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index1);
        });

        var tip_index2 = 0;
        $('#transferNumber-desc').mouseenter(function () {
            tip_index2 = layer.tips(bt.lang('config.ele.transferNumber.desc'), '#transferNumber-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index2);
        });

        var tip_index3 = 0;
        $('#rpaDateNumber-desc').mouseenter(function () {
            tip_index3 = layer.tips(bt.lang('config.ele.rpaDateNumber.desc'), '#rpaDateNumber-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index3);
        });
    }
</script>
</body>
</html>

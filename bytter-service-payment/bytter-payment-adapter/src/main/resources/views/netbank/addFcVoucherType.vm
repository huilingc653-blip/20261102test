<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcVoucherTypePage.id}">
		<input id="isSystem" name="isSystem" type="hidden" value="0">
        <table class="layui-table">
			<tbody >
				<tr >
					<td class="textRight" width="30%">#springMessage('fcVoucherType.voucherType')</td>
					<td >
						<input type="text" id="voucherType" name="voucherType" lay-verify="required|langKey|strlength" data-maxlength="2" data-minlength="2"
							autocomplete="off" class="layui-input" placeholder="#springMessage('fcVoucherType.voucherType')">
                    </td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.voucherName')</td>
					<td>
						<input type="text" id="voucherName" name="voucherName" lay-verify="required|strlength" data-maxlength="20"
							autocomplete="off" class="layui-input" placeholder="#springMessage('fcVoucherType.voucherName')">
                    </td>
                </tr>
				<tr >
					<td class="textRight">
						#springMessage('fcVoucherType.sysVoucherCode')
					</td>
					<td>
						<div class="bt-biz-selectType" data-url="${basePath}/netbank/btpaytype/json" data-valuefield="sysVoucherCode" data-textfield="sysVoucherName" data-verify="required"
							data-name="sysVoucherCode" data-value="$!{fcVoucherTypePage.sysVoucherCode}" data-callback="payTypeCallback"></div>
                    </td>
				</tr>
				<tr  id="billSectionControlTr" style="display: none">
					<td class="textRight">#springMessage('fcVoucherType.openBill.section.control')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="BILL_SECTION_CONTROL" id="billSectionControl"
							 data-name="billSectionControl" data-biz-name="billSectionControl"></div>
					</td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.cashTransSign')</td>
					<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="cashTransSign" data-defaultvalue="T"
                             data-name="cashTransSign" data-biz-name="cashTransSign"></div>
                    </td>
                </tr>
                <tr >
                    <td class="textRight">#springMessage('fcVoucherType.settlType')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="settlType" data-defaultvalue="0"
                             data-name="settlType" data-biz-name="settlType"></div>
                    </td>
				</tr>
				<tr style="display:none">
                    <td class="textRight">#springMessage('fcVoucherType.isElectronPay')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1"
							 data-name="isElectronPay" data-biz-name="isElectronPay"></div>
                    </td>
                </tr>
                <tr >
                    <td class="textRight">#springMessage('fcVoucherType.isAccount')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1"
							 data-name="isAccount" data-biz-name="isAccount"></div>
                    </td>
				</tr>
				<tr >
                    <td class="textRight">#springMessage('fcVoucherType.isBudget')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1"
							 data-name="isBudget" data-biz-name="isBudget"></div>
                    </td>
				</tr>
                <tr id="sendModeTr">
                    <td class="textRight">#springMessage('config.nis.bisExcAutoAccount')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="bisExc.sendMode" data-defaultvalue="0"
							 data-name="sendMode" data-biz-name="sendMode"></div>
                    </td>
                </tr>
                <tr >
					<td class="textRight">#springMessage('fcVoucherType.validSign')</td>
					<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="1"
							 data-name="validSign" data-biz-name="validSign"></div>
                    </td>
                </tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
					<td>
						<textarea placeholder="#springMessage('fcVoucherType.rmk')" lay-verify="strlength" data-maxlength="40" class="layui-textarea" id="rmk" name="rmk" ></textarea>
                    </td>
				</tr>
    			<tr >
                    <td colspan="2" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/fcVoucherType.add.js?_btv=${resourceVersion}"></script>
</html>

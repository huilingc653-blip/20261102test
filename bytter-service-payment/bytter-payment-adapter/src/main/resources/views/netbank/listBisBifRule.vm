<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody>
				<tr>
                   <td class="textRight" width="45%">#springMessage('bisBifRule.bifCode')</td>
                   <td width="55%">
                       <div class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/json"
                            data-name="eqs_bifCode" data-biz-name="eqs_bifCode" data-valueField="bifCode" data-textField="name"></div>
                    </td>
                </tr>
    			<tr >
                    <td colspan="2" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('bisBifRule.bifCode')</th>
            <th>#springMessage('bisBifRule.bifName')</th>
            <th>#springMessage('bisBifRule.payerName')</th>
            <th>#springMessage('bisBifRule.payerAcc')</th>
            <th>#springMessage('bisBifRule.payerBank')</th>
            <th>#springMessage('bisBifRule.payeeName')</th>
            <th>#springMessage('bisBifRule.payeeAcc')</th>
            <th>#springMessage('bisBifRule.payeeBank')</th>
            <th>#springMessage('bisBifRule.purpose')</th>
            <th>#springMessage('bisBifRule.addWord')</th>
            <th>#springMessage('bisBifRule.isPurpose')</th>
            <th>#springMessage('bisBifRule.isBankOnline')</th>
            <th>#springMessage('bisBifRule.sendNum')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/bisBifRule.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            <td class="textRight">关联方编码</td>
            <td width="40%">
                <input type="text" name="likes_relatedCode" autocomplete="off" class="layui-input"
                       placeholder="关联方编码">
            </td>
            <td class="textRight">关联方名称</td>
            <td width="40%">
                <input type="text" name="likes_relatedName" autocomplete="off" class="layui-input"
                       placeholder="关联方名称">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>关联方编码</th>
        <th>关联方名称</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisRelatedParty.list.js?_btv=${resourceVersion}"></script>
</html>

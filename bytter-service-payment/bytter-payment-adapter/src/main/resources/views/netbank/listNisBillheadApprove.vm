<!DOCTYPE html>
<html lang="en">
<input type="hidden" id="caType"  value="4"/>
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}"/>
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
    <input id="showIsPayed" name="showIsPayed" type="hidden" value="$!{showIsPayed}">
    <input id="loginName" name="loginName" type="hidden" value="$shiro.getPrincipal().loginName">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight" width="10%">#springMessage('table.nisBillhead.corpId')</td>
            <td width="23%">
                <input type="hidden" id="corpIds" value="$!{corpIds}">
            ##付款人单位
                <div class="layui-input-inline">
                    <div class="demo-selectTree-normal"></div>
                </div>
            </td>
        ##结算方式
            <td class="textRight" width="10%">#springMessage('table.nisBillhead.voucherTypeId')</td>
            <td width="23%">
                <div class="layui-input-inline">
##                    <div class="bt-biz-selectType" data-name="eqs_voucherTypeId" data-biz-name="eqs_voucherTypeId"
##                         data-valuefield="id" data-textfield="voucherName"
##                         data-url="${basePath}/netbank/fcvouchertype/json"></div>
                    <div class="bt-biz-mulselectType" data-url="${basePath}/netbank/fcvouchertype/json" data-method="get"
                         data-valuefield="id" data-textfield="voucherName" data-name="ins_voucherTypeId" data-biz-name="voucherName"
                         ></div>
                </div>
            </td>
        ##金额
            <td class="textRight" width="10%">#springMessage('table.nisBillhead.payMoney')</td>
            <td width="24%">
                <div class="layui-inline">
                    <input type="text" data-name="geg_payMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_payMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20"
                           placeholder="#springMessage('table.nisBillhead.payMoney')">
                </div>
            </td>
        </tr>
        <tr>
        ##收款账号
            <td class="textRight">#springMessage('table.nisBillhead.payeeAcc')</td>
            <td>
                <input type="text" name="likes_payeeAcc" autocomplete="off" class="layui-input bank"
                       placeholder="#springMessage('table.nisBillhead.payeeAcc')">
            </td>
        ##收款人
            <td class="textRight">#springMessage('table.nisBillhead.payeeAccName')</td>
            <td>
                <input type="text" name="likes_payeeAccName"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.nisBillhead.payeeAccName')">
            </td>
        ##期望支付日期
            <td class="textRight">#springMessage('table.nisBillhead.wishPayday')</td>
            <td>
                <input type="text" name="ged_wishPayday" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_wishPayday">
                <span class="date-mid">~</span>
                <input type="text" name="led_wishPayday" class="layui-input bt-input-inline bt-biz-dateType"
                       id="led_wishPayday">
            </td>
        </tr>
        <tr>
            ##会计凭证号
            <td class="textRight">#springMessage('table.nisBillhead.bursarBillNo')</td>
            <td>
                <input type="text" name="likes_bursarBillNo"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.bursarBillNo')">
            </td>
            ##币别
            <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
                </div>
            </td>
            ##付款账号
                <td class="textRight">#springMessage('table.nisBillhead.payerAcc')</td>
                <td width="40%">
                    <div class="layui-inline">
                        <div class="bt-biz-mulselectType" data-url="${basePath}/netbank/nisbillhead/json/$!{flowStatus}"
                             data-name="ins_payerAcc" data-biz-name="ins_payerAcc" data-valueField="payerAcc" data-method="get"
                             data-textField="payerAcc"></div>
                    </div>
                </td>
        </tr>
        <tr>
            ##单据来源
            <td class="textRight">#springMessage('table.nisBillhead.billFrom')</td>
            <td>
                <div class="bt-biz-dict" data-type="select"
                     data-group="nisBillhead.billFrom" data-name="eqs_billFrom"></div>
            </td>
            ##是否对私
            <td class="textRight">#springMessage('table.nisBillhead.isForindividual')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="nisBillhead.isPayed"
                     data-name="eqs_isForindividual"></div>
            </td>
            #if($!{showIsPayed} == "1")
                ##是否已付款
                    <td class="textRight">#springMessage('table.nisBillhead.isPayed')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="nisBillhead.isPayed"  data-name="eqs_isPayed" data-biz-name="isPayed" ></div>
                    </td>
            #else
                <td></td>
                <td></td>
            #end
        </tr>
        #if($!{flowStatus} == "pass")
        <tr>
            ##状态
            <td class="textRight">#springMessage('table.nisBillhead.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select"
                     data-group="nisBillhead.status" data-name="eqi_status"></div>
            </td>
            ##审批时间
            <td class="textRight">#springMessage('bpm.model.assignTime')</td>
            <td>
                <input type="text" name="ged_approveDate"
                       class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_approveDate" value="">
                <span class="date-mid">~</span>
                <input type="text" name="led_approveDate"
                       class="layui-input bt-input-inline bt-biz-dateType"
                       id="led_approveDate">
            </td>
            <td></td>
            <td></td>
        </tr>
        #end
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisBillhead.billNo')</th>
        <th>#springMessage('table.nisBillhead.corpId')</th>
        <th>#springMessage('table.nisBillhead.voucherTypeId')</th>
        <th>#springMessage('table.nisBillhead.payerAcc')</th>
        <th>#springMessage('table.nisBillhead.payerAccName')</th>
        <th>#springMessage('table.nisBillhead.payerBank')</th>
        <th>#springMessage('table.nisBillhead.isPayed')</th>
        <th>#springMessage('table.nisBillhead.curId')</th>
        <th>#springMessage('table.nisBillhead.payMoney')</th>
        <th>#springMessage('table.nisBillhead.payeeAcc')</th>
        <th>#springMessage('table.nisBillhead.payeeAccName')</th>
        <th>#springMessage('table.nisBillhead.payeeBankCode')</th>
        <th>#springMessage('table.nisBillhead.payeeBank')</th>
        <th>#springMessage('table.nisBillhead.wishPayday')</th>
        <th>#springMessage('table.nisBillhead.busType')</th>
        <th>#springMessage('table.nisBillhead.bursarBillNo')</th>
        <th>#springMessage('table.nisBillhead.purpose')</th>
        <th>#springMessage('table.nisBillhead.addWord')</th>
        <th>#springMessage('table.nisBillhead.billFrom')</th>
        <th>#springMessage('table.nisBillhead.status')</th>
        <th>#springMessage('bpm.model.assignTime')</th>
        <th>#springMessage('table.nisBillhead.isForindividual')</th>
        <th>#springMessage('table.nisBillhead.createDate')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
    #caDataHidden()
    #caDataScript()
    #paymentWorkFlowScript()
<script src="${basePath}/static/modules/netbank/nisBillheadApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

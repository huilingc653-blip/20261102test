#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
    <style>
        .rmk-css {
            font-size: 14px;
            float: right;
            right: 0;
            position: relative;
            display: inline-block;
            max-width: 170px;
            word-break: break-all;
        }
    </style>
</head>
<body>
<!-- 系统参数 -->
<input id="id" name="id" type="hidden" value="$!{nisBillheadPage.id}">
<input id="attachmentId" name="attachmentId" type="hidden" value="$!{nisBillheadPage.attachmentId}">
<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.billNo')
        <span class="mui-badge mui-badge-inverted">
            $!{nisBillheadPage.billNo}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{nisBillheadPage.corpName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.voucherTypeId')
        <span class="mui-badge mui-badge-inverted">
            $!{nisBillheadPage.voucherName}
        </span>
    </li>
##    付款账户
    <li class="mui-table-view-cell  mui-collapse keep-unfold">
        <a class="mui-navigate-right" href="#">
            #springMessage('table.nisBillhead.payerAcc')
            <span class="mui-badge mui-badge-inverted" style="display: block;word-break: break-all;padding:0;margin: 0;white-space:normal;">
                $!{nisBillheadPage.payerAcc}
            </span>
        </a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('table.nisBillhead.payerAccName')
                <span class="mui-badge mui-badge-inverted">
                    $!{nisBillheadPage.payerAccName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.nisBillhead.payerBank')
                <span class="mui-badge mui-badge-inverted">
                    $!{nisBillheadPage.payerBank}
                </span>
            </li>
        </ul>
    </li>
##    内部账户
    #if($!{nisBillheadPage.sysVoucherCode} == "02" && $!{nisBillheadPage.isAccount} == "1")
        <li class="mui-table-view-cell">
            #springMessage('table.nisBillhead.downAccId')
            <span class="mui-badge mui-badge-inverted">
                $!{nisBillheadPage.downAcc}
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.nisBillhead.downAccName')
            <span class="mui-badge mui-badge-inverted">
                $!{nisBillheadPage.downAccName}
            </span>
        </li>
    #end
##    收款账户
    #if($!{nisBillheadPage.billFrom} != "2")
        <li class="mui-table-view-cell  mui-collapse keep-unfold">
            <a class="mui-navigate-right" href="#">
                #springMessage('table.nisBillhead.payeeAcc')
                <span class="mui-badge mui-badge-inverted" style="display: block;word-break: break-all;padding:0;margin: 0;white-space:normal;">
                    $!{nisBillheadPage.payeeAcc}
            </span>
            </a>
            <ul class="mui-table-view H-theme-background-color-white">
                <li class="mui-table-view-cell">
                    #springMessage('table.nisBillhead.payeeAccName')
                    <span class="mui-badge mui-badge-inverted">
                        $!{nisBillheadPage.payeeAccName}
                    </span>
                </li>

                #if($!{nisBillheadPage.sysVoucherCode} != "05")
                    <li class="mui-table-view-cell">
                        #springMessage('table.nisBillhead.payeeBank')
                        <span class="mui-badge mui-badge-inverted">
                            $!{nisBillheadPage.payeeBank}
                        </span>
                    </li>
                    <li class="mui-table-view-cell">
                        #springMessage('table.nisBillhead.payeeAddr')
                        <span class="mui-badge mui-badge-inverted">
                            $!{nisBillheadPage.provName} $!{nisBillheadPage.cityName}
                        </span>
                    </li>
                #end
            </ul>
        </li>
    #end

    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.payMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{nisBillheadPage.payMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.isForindividual')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("sf_yn",$!{nisBillheadPage.isForindividual})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.wishPayday')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{nisBillheadPage.wishPayday})
        </span>
    </li>
    #if($!{nisBillheadPage.directPayFlag} == "y" && $!{nisBillheadPage.billFrom} != "2")
        <li class="mui-table-view-cell">
            #springMessage('table.nisBillhead.difBank')
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("nisBillhead.difBank",$!{nisBillheadPage.difBank})
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.nisBillhead.difBank')
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("nisBillhead.areaSign",$!{nisBillheadPage.areaSign})
            </span>
        </li>
    #end
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.isQuick')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("sf_yn",$!{nisBillheadPage.isQuick})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.busType')
        <span class="mui-badge mui-badge-inverted">
            $!{nisBillheadPage.busTypeName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.bursarBillNo')
        <span class="mui-badge mui-badge-inverted">
            $!{nisBillheadPage.bursarBillNo}
        </span>
    </li>
    #if($!{nisBillheadPage.sysVoucherCode} == "49" || $!{nisBillheadPage.sysVoucherCode} == "50")
        <li class="mui-table-view-cell">
            #springMessage('table.abVoucherinfo.billType')
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("AB_BILL_TYPE",$!{nisBillheadPage.billType})
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.erp.billFlag')
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("AB_BILL_FLAG",$!{nisBillheadPage.billFlag})
            </span>
        </li>
    #end
##票据信息  需提供接口

    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.purpose')
        <span class="mui-badge mui-badge-inverted">
            $!{nisBillheadPage.purpose}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.addWord')
        <span class="mui-badge mui-badge-inverted">
            $!{nisBillheadPage.addWord}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.settlement.rmk')
        <span class="mui-badge-inverted rmk-css">
            $!{nisBillheadPage.rmk}
        </span>
    </li>
    ## 对私付款明细
    #if($!{nisBillheadPage.billFrom} == "2")
        <li class="mui-table-view-cell" style="background-color: #f2f2f2">
            #springMessage('table.nisExpenseDetail.viewTitle')
            <span class="mui-badge mui-badge-inverted" style="display: block;word-break: break-all;padding:0;margin: 0;white-space:normal;">
            </span>
        </li>
        #foreach($nisExpenseDetail in $listNisExpenseDetail)
        <li class="mui-table-view-cell">
            #springMessage('table.nisBillhead.payeeAccName')
            <span class="mui-badge mui-badge-inverted">
                $!{nisExpenseDetail.accName}
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.nisBillhead.payeeAcc')
            <span class="mui-badge mui-badge-inverted">
                $!{nisExpenseDetail.bankAcc}
            </span>
        </li>
        #if($!{nisExpenseDetail.busType} != "04")
        <li class="mui-table-view-cell">
            #springMessage('table.nisBillhead.payMoney')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{nisExpenseDetail.expenseMoney})
            </span>
        </li>
        #end
        #end
    #end
    ## 挂接资金计划
    #if($!{budgetSel} == 1)
        #set($fbsBudgetItemDetail = $fbsBudgetTag.getViewItemDetailMobile($!{nisBillheadPage.billNo}, "", $!{businessName}, $!{processSysname},$!{nisBillheadPage.corpId}, $!{nisBillheadPage.wishPayday}))
        #parse("views/budget/fbsbudget.vm")
    #end
</ul>
    #parse("views/common/wapfooter.vm")
</body>
<script>
    window.onload=function () {
        var attachmentId = $("#attachmentId").val();
        setTimeout(function () {
            BTAppBridge.initAttachmentByGroupId && BTAppBridge.initAttachmentByGroupId(attachmentId);
        },100);
    }

</script>
</html>

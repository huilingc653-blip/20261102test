<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" name="eqs_corpId" value="$!{corp.id}">
        <table class="layui-table">
            <tr>
                <td width="20%" class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
                <td>
                    ($!{corp.code})$!{corp.name}
                </td>
            </tr>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('nisBusType.busType')</th>
            <th>#springMessage('nisBusType.busTypeName')</th>
            <th>#springMessage('nisBusType.cdSign')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisCorpBus.view.js?_btv=${resourceVersion}"></script>
</html>
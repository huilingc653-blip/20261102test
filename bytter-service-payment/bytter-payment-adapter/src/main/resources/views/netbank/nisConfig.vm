<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.nis.param.titile.usually')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
        <thead>
            <tr>
                <td width="25%" class="textRight">#springMessage('config.fbs.paramName')</td>
                <td width="75%">#springMessage('config.fbs.paramValue')</td>
            </tr>
            </thead>
            <tbody>
            <tr>
                ##业务类别必输
                <td class="textRight">#springMessage('config.nis.requiredBusiness')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="radio" name="nis.requiredBusiness" value="1" #if($config.nis.requiredBusiness == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                        <input type="radio" name="nis.requiredBusiness" value="0" #if($config.nis.requiredBusiness == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                    </div>
                    <div class="layui-input-inline">
                        <i id="requiredBusiness-desc" class="layui-icon">&#xe60b;</i>
                    </div>
                </td>
            </tr>
            <tr>
                ##是否启用拆分
                <td class="textRight">#springMessage('config.nis.isEnableSplit')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="radio" name="nis.isEnableSplit" value="1" #if($config.nis.isEnableSplit == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                        <input type="radio" name="nis.isEnableSplit" value="0" #if($config.nis.isEnableSplit == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                    </div>
                </td>
            </tr>
            <tr>
                ##是否启用合并
                <td class="textRight">#springMessage('config.nis.isEnableMerge')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="radio" name="nis.isEnableMerge" value="1" #if($config.nis.isEnableMerge == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                        <input type="radio" name="nis.isEnableMerge" value="0" #if($config.nis.isEnableMerge == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                    </div>
                </td>
            </tr>
            <tr>
                ##是否匹配交易失败原因
                <td class="textRight">#springMessage('config.nis.isMathcFailReason')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="radio" name="nis.isMathcFailReason" value="1" #if($config.nis.isMathcFailReason == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                        <input type="radio" name="nis.isMathcFailReason" value="0" #if($config.nis.isMathcFailReason == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                    </div>
                </td>
            </tr>
                ##退款勾对天数
            <tr>
                <td class="textRight">#springMessage('config.nis.refundBlendDays')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="nis.refundBlendDays" autocomplete="off" class="layui-input bt-biz-moneyType"
                               data-decimal="0" data-separator="" value="$!{nis.refundBlendDays}"
                               data-max="12" data-min="1" >
                    </div>
                    <div class="layui-input-inline">#springMessage('config.nis.day')</div>
                    <div class="layui-input-inline">
                        <i id="refundBlendDays-desc" class="layui-icon">&#xe60b;</i>
                    </div>
                </td>
            </tr>
                ##是否启用用户分配付款方式
            <tr>
                <td class="textRight">#springMessage('config.nis.isEnableUserAssign')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="radio" name="nis.isEnableUserAssign" value="1" #if($config.nis.isEnableUserAssign == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                        <input type="radio" name="nis.isEnableUserAssign" value="0" #if($config.nis.isEnableUserAssign == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                    </div>
                    <div class="layui-input-inline">
                        <i id="isEnableUserAssign-desc" class="layui-icon">&#xe60b;</i>
                    </div>
                </td>
            </tr>
                ##自动支付账号数量
            <tr>
                <td class="textRight">#springMessage('config.nis.autoPayerAccNum')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="nis.autoPayerAccNum" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" data-min="1" data-separator="" value="$!{config.nis.autoPayerAccNum}">
                    </div>
                    <div class="layui-input-inline">
                        <i id="autoPayerAccNum-desc" class="layui-icon">&#xe60b;</i>
                    </div>
                </td>
            </tr>
            <tr>
                ##允许付款金额与票据金额不一致
                <td class="textRight">#springMessage('config.nis.allowDifferentBillMoney')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="radio" name="nis.allowDifferentBillMoney" value="1" #if($config.nis.allowDifferentBillMoney == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                        <input type="radio" name="nis.allowDifferentBillMoney" value="0" #if($config.nis.allowDifferentBillMoney == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                    </div>
                    ## <div class="layui-input-inline" style="color:red">#springMessage('config.nis.allowDifferentBillMoney.desc')</div>
                    <div class="layui-input-inline">
                        <i id="allowDifferentBillMoney-desc" class="layui-icon">&#xe60b;</i>
                    </div>
                </td>
            </tr>
                ##跨行转付在下拨指令成功后延迟支付
            <tr>
                <td class="textRight">#springMessage('config.nis.delayTime')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="nis.delayTime" autocomplete="off" class="layui-input bt-biz-moneyType"
                               data-decimal="0" data-separator="" value="$!{config.nis.delayTime}">
                    </div>
                    <div class="layui-input-inline">
                        #springMessage('common.unit.minute')
                        #*<div class="bt-biz-dict" data-type="select" data-defaultvalue="$!{config.nis.delayTimeUnit}"
                             data-group="nis.delayTimeUnit" data-name="nis.delayTimeUnit"></div>*#
                    </div>
                </td>
            </tr>
            ##是否启用待付款池 enablePendingPaymentPool
            <tr>
                <td class="textRight">#springMessage('config.nis.enablePendingPaymentPool')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="radio" name="nis.enablePendingPaymentPool" value="1" #if($config.nis.enablePendingPaymentPool == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                        <input type="radio" name="nis.enablePendingPaymentPool" value="0" #if($config.nis.enablePendingPaymentPool == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                    </div>
                </td>
            </tr>
            ##未产生资金需求付款单付款控制
            <tr>
                <td class="textRight">未产生资金需求付款单付款控制</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="radio" name="nis.demandControl" value="0" #if($config.nis.demandControl == 0)checked#end title="#springMessage('config.nis.noprompt')">
                        <input type="radio" name="nis.demandControl" value="1" #if($config.nis.demandControl == 1)checked#end title="#springMessage('config.nis.promptnocontrol')">
                        <input type="radio" name="nis.demandControl" value="2" #if($config.nis.demandControl == 2)checked#end title="#springMessage('config.nis.control')">
                    </div>
                </td>
            </tr>
            ##冻结开始时间
            <tr>
                <td class="textRight">冻结开始时间</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" class="layui-input bt-biz-dateType" name="nis.freezeStartDate" data-biz-name="nis.freezeStartDate"
                               data-type="time" value="$!{config.nis.freezeStartDate}">
                    </div>
                </td>
            </tr>
            ##冻结结束时间
            <tr>
                <td class="textRight">冻结结束时间</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" class="layui-input bt-biz-dateType" name="nis.freezeEndDate" data-biz-name="nis.freezeEndDate"
                               data-type="time" value="$!{config.nis.freezeEndDate}">
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
        </div>
    </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.nis.param.titile.check')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="25%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="75%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr id="isAutoAccount">
                        ## 记账模式
                        <td class="textRight">#springMessage('config.nis.accountMode')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="nis.isAutoAccount" value="1" #if($config.nis.isAutoAccount == 1)checked#end title="#springMessage('config.nis.autoAccount')" lay-filter="isAutoAccount">
                                <input type="radio" name="nis.isAutoAccount" value="0" #if($config.nis.isAutoAccount == 0)checked#end title="#springMessage('config.nis.manualAccount')" lay-filter="isAutoAccount">
                            </div>
                        </td>
                    </tr>
                    <tr style="display:none" id="payAccount">
                        ## 记账顺序
                        <td class="textRight">#springMessage('config.nis.accountOrder')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="nis.payAccount" value="0" #if($config.nis.payAccount == 0)checked#end title="#springMessage('config.nis.accountPay')">
                                <input type="radio" name="nis.payAccount" value="1" #if($config.nis.payAccount == 1)checked#end title="#springMessage('config.nis.payAccount')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 是否允许中心修改下拨账号
                        <td class="textRight">#springMessage('config.nis.allowEditDownacc')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="nis.allowEditDownacc" value="1" #if($config.nis.allowEditDownacc == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                                <input type="radio" name="nis.allowEditDownacc" value="0" #if($config.nis.allowEditDownacc == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                            </div>
                            ## <div class="layui-input-inline" style="color:red">#springMessage('config.nis.allowEditDownacc.desc')</div>
                            <div class="layui-input-inline">
                                <i id="allowEditDownacc-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.nis.param.titile.budget')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="25%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="75%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## 是否挂接资金计划
                        <td width="25%" class="textRight">#springMessage('config.nis.budgetSel')</td>
                        <td width="75%">
                            <div class="layui-input-inline">
                                <input type="radio" name="nis.budgetSel" value="1" #if($config.nis.budgetSel == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                                <input type="radio" name="nis.budgetSel" value="0" #if($config.nis.budgetSel == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 付款方式默认走的计划科目
                        <td class="textRight">#springMessage('config.nis.payItem')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="nis.payItem" autocomplete="off" class="layui-input" data-decimal="0" data-separator="" value="$!{config.nis.payItem}">
                            </div>
                            ##  <div class="layui-input-inline" style="color:red">#springMessage('config.nis.payItem.desc')</div>
                            <div class="layui-input-inline">
                                <i id="payItem-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    #*<tr>
                        ## 收款方式默认走的计划科目
                        <td class="textRight">#springMessage('config.nis.incItem')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="nis.incItem" autocomplete="off" class="layui-input" data-decimal="0" data-separator="" value="$!{config.nis.incItem}">
                            </div>
                            ##  <div class="layui-input-inline" style="color:red">#springMessage('config.nis.incItem.desc')</div>
                            <div class="layui-input-inline">
                                <i id="incItem-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>*#
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('config.nis.param.titile.warnstrategy')</h2>
        <div class="layui-colla-content layui-show">
            <table class="layui-table breakRow">
                <thead>
                <tr>
                    <td width="25%" class="textRight">#springMessage('config.fbs.paramName')</td>
                    <td width="75%">#springMessage('config.fbs.paramValue')</td>
                </tr>
                </thead>
                <tbody>
                <tr>
                    ## 付款余额控制方式
                    <td class="textRight">#springMessage('config.nis.balControlType')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="radio" name="nis.balControlType" value="0" #if($config.nis.balControlType == 0)checked#end title="#springMessage('config.nis.balControlType.bal')">
                            <input type="radio" name="nis.balControlType" value="1" #if($config.nis.balControlType == 1)checked#end title="#springMessage('config.nis.balControlType.availBal')">
                        </div>
                        ##  <div class="layui-input-inline" style="color:red">#springMessage('config.nis.balControlType.desc')</div>
                        <div class="layui-input-inline">
                            <i id="balControlType-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </td>
                </tr>
                <tr>
                    ## 付款余额不足控制方式
                    <td class="textRight">#springMessage('config.nis.bankaccOverType')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="radio" name="nis.bankaccOver" value="0" #if($config.nis.bankaccOver == 0)checked#end title="#springMessage('config.nis.noprompt')">
                            <input type="radio" name="nis.bankaccOver" value="1" #if($config.nis.bankaccOver == 1)checked#end title="#springMessage('config.nis.promptnocontrol')">
                            <input type="radio" name="nis.bankaccOver" value="2" #if($config.nis.bankaccOver == 2)checked#end title="#springMessage('config.nis.control')">
                        </div>
                    </td>
                </tr>
                <tr>
                    ## 付款审批余额不足控制方式
                    <td class="textRight">#springMessage('config.nis.bankaccOverApproveType')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="radio" name="nis.bankaccOverApprove" value="0" #if($config.nis.bankaccOverApprove == 0)checked#end title="#springMessage('config.nis.noprompt')">
                            <input type="radio" name="nis.bankaccOverApprove" value="1" #if($config.nis.bankaccOverApprove == 1)checked#end title="#springMessage('config.nis.promptnocontrol')">
                            <input type="radio" name="nis.bankaccOverApprove" value="2" #if($config.nis.bankaccOverApprove == 2)checked#end title="#springMessage('config.nis.control')">
                        </div>
                    </td>
                </tr>
                <tr>
                    ## 内部付款余额不足控制方式
                    <td class="textRight">#springMessage('config.nis.accountOverType')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="radio" name="nis.accountOver" value="0" #if($config.nis.accountOver == 0)checked#end title="#springMessage('config.nis.noprompt')">
                            <input type="radio" name="nis.accountOver" value="1" #if($config.nis.accountOver == 1)checked#end title="#springMessage('config.nis.promptnocontrol')">
                            <input type="radio" name="nis.accountOver" value="2" #if($config.nis.accountOver == 2)checked#end title="#springMessage('config.nis.control')">
                        </div>
                    </td>
                </tr>
                <tr>
                    ## 重复制单提醒周期
                    <td class="textRight">#springMessage('config.nis.repayAlertDays')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="nis.repayAlertDays" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" data-separator="" value="$!{config.nis.repayAlertDays}">
                        </div>
                        <div class="layui-input-inline">#springMessage('config.nis.day')</div>
                    </td>
                </tr>
                <tr>
                    ##付款支付超时预警天数
                    <td class="textRight">#springMessage('config.nis.payOverTime')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="nis.payOverTime" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" data-min="1" data-separator="" value="$!{config.nis.payOverTime}">
                        </div>
                        <div class="layui-input-inline">
                            <i id="payOverTime-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##支付等待结果超时预警天数
                    <td class="textRight">#springMessage('config.nis.waitResultOverTime')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="nis.waitResultOverTime" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" data-min="1" data-separator="" value="$!{config.nis.waitResultOverTime}">
                        </div>
                        <div class="layui-input-inline">
                            <i id="waitResultOverTime-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##付款指令中间状态停留超时预警
                    <td class="textRight">#springMessage('config.nis.consumptionOverTime')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="nis.consumptionOverTime" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="1" data-min="1" data-separator="" value="$!{config.nis.consumptionOverTime}">
                        </div>
                        <div class="layui-input-inline">#springMessage('common.unit.hour')</div>
                        <div class="layui-input-inline">
                            <i id="consumptionOverTime-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </td>
                </tr>
                <tr style="display: none;">
                    ##是否记账
                    <td width="25%" class="textRight">#springMessage('config.allot.isAccount')</td>
                    <td width="75%">
                        <div class="layui-input-inline">
                            <input type="radio" name="nis.isAccount" value="1" #if($config.nis.isAccount == 1)checked#end title="#springMessage('nis.sc_yn.yes')" lay-filter="isAccount">
                            <input type="radio" name="nis.isAccount" value="0" #if($config.nis.isAccount == 0)checked#end title="#springMessage('nis.sc_yn.no')" lay-filter="isAccount">
                        </div>
                    </td>
                </tr>
                <tr>
                    ##显示已付款标识
                    <td class="textRight">#springMessage('config.nis.showIsPayed')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="radio" name="nis.showIsPayed" value="1" #if($config.nis.showIsPayed == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                            <input type="radio" name="nis.showIsPayed" value="0" #if($config.nis.showIsPayed == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                        </div>
                    </td>
                </tr>
                <tr style="display:none">
                    ##委托收款暂时屏蔽，先隐藏掉相关参数
                    ##手续费率
                    <td class="textRight">#springMessage('config.nis.chargeRate')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text"  name="nis.chargeRate"
                                   autocomplete="off" class="layui-input bt-biz-rateType" value="$!{config.nis.chargeRate}">
                        </div>
                    </td>
                </tr>
                <tr style="display:none">
                    ## 最多等待天数
                    <td class="textRight">#springMessage('config.nis.replyDays')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="nis.replyDays" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" data-separator="" value="$!{config.nis.replyDays}">
                        </div>
                        <span style="font-size:15px;">#springMessage('config.nis.day')</span>
                    </td>
                </tr>
                <tr style="display:none">
                    ## 无答复时
                    <td class="textRight">#springMessage('config.nis.noReplyAct')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="radio" name="nis.noReplyAct" value="1" #if($config.nis.noReplyAct == 1)checked#end title="#springMessage('config.nis.successpay')">
                            <input type="radio" name="nis.noReplyAct" value="0" #if($config.nis.noReplyAct == 0)checked#end title="#springMessage('config.nis.refusepay')">
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<table class="layui-table border0">
    <tbody>
    <tr>
        <td width="25%"></td>
        <td>
            <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
       	 	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </td>
    </tr>
    </tbody>
</table>
</form>
#parse("views/common/footer.vm")
<script>
    bt.use(['form','jquery','rateType','moneyType','element','dicts','dateType'], function(){
        var form = bt.form(),$  = bt.jquery;
		bt.element();
        var rateTye = bt.rateType.init();
        bt.moneyType.init();
        bt.dicts.init();
        bt.dateType.init();
        if($("input[name='nis.isAutoAccount']:checked").val() == '0'){
            $("#payAccount").show();
        }
        //监听提交
        form.on('submit(configSubmit)', function(data){
            $.post(basePath + "/sys/config/save",data.field,function(result){
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },"JSON");
            // 重置付款办理表格状态
            var tableKey = 'DataTables_appTable_/netbank/nisbillhead/list'
            $.ajax({
                url: basePath + '/sys/user/tableRecord/reset',
                dataType: 'json',
                type: "get",
                data: {tableKey: tableKey}
            });
            return false;
        });
        form.on('radio(isAutoAccount)', function(data){
            if(data.value == 0){
                $("#payAccount").show();
            }else{
                $("#payAccount").hide();
            }
        });

        // 说明显示隐藏
        showDesc();
    });


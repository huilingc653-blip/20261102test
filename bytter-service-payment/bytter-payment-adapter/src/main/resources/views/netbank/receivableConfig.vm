<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body {
            font-size: 14px;
            padding-bottom: 60px;
        }

        .layui-form-label {
            width: 180px;
        }

        .layui-input-block {
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.receivable.param.titile.usually')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ##是否启用拆分
                        <td class="textRight">#springMessage('config.nis.isEnableSplit')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="receivable.isEnableSplit" value="1"
                                       #if($config.receivable.isEnableSplit == 1)checked#end
                                       title="#springMessage('nis.sc_yn.yes')">
                                <input type="radio" name="receivable.isEnableSplit" value="0"
                                       #if($config.receivable.isEnableSplit == 0)checked#end
                                       title="#springMessage('nis.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##是否启用合并
                        <td class="textRight">#springMessage('config.nis.isEnableMerge')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="receivable.isEnableMerge" value="1"
                                       #if($config.receivable.isEnableMerge == 1)checked#end
                                       title="#springMessage('nis.sc_yn.yes')">
                                <input type="radio" name="receivable.isEnableMerge" value="0"
                                       #if($config.receivable.isEnableMerge == 0)checked#end
                                       title="#springMessage('nis.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##是否认领到业务类别
                        <td width="20%" class="textRight">#springMessage('config.receivable.isClaimBusType')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="receivable.isClaimBusType" value="1"
                                       #if($config.receivable.isClaimBusType == 1)checked#end
                                       title="#springMessage('nis.sc_yn.yes')">
                                <input type="radio" name="receivable.isClaimBusType" value="0"
                                       #if($config.receivable.isClaimBusType == 0)checked#end
                                       title="#springMessage('nis.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 收款流水认领天数
                        <td width="20%" class="textRight">收款流水认领天数</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="text" name="receivable.dayCount" autocomplete="off" class="layui-input bt-biz-moneyType"
                                       data-decimal="0" data-separator="" value="$!{config.receivable.dayCount}"
                                       data-min="1">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 后台任务每批次执行笔数
                        <td width="20%" class="textRight">后台任务每批次执行笔数</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="text" name="receivable.collectionAutoCount" autocomplete="off" class="layui-input bt-biz-moneyType"
                                       data-decimal="0" data-separator="" value="$!{config.receivable.collectionAutoCount}"
                                       data-min="1" >
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.receivable.param.titile.budget')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## 是否挂接资金计划
                        <td width="20%" class="textRight">#springMessage('config.nis.budgetSel')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="receivable.budgetSel" value="1"
                                       #if($config.receivable.budgetSel == 1)checked#end
                                       title="#springMessage('nis.sc_yn.yes')">
                                <input type="radio" name="receivable.budgetSel" value="0"
                                       #if($config.receivable.budgetSel == 0)checked#end
                                       title="#springMessage('nis.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.receivable.param.titile.refundblending')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                        ##退款勾对天数
                    <tr>
                        <td class="textRight">#springMessage('config.nis.refundBlendDays')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="receivable.refundBlendDays" autocomplete="off" class="layui-input bt-biz-moneyType"
                                       data-decimal="0" data-separator="" value="$!{config.receivable.refundBlendDays}"
                                       data-max="12" data-min="1" >
                            </div>
                            <div class="layui-input-inline">#springMessage('config.nis.day')</div>
                            <div class="layui-input-inline">
                                <i id="refundBlendDays-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                        ##退款勾对定时任务取数天数
                    <tr>
                        <td class="textRight">退款勾对定时任务取数天数</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="receivable.timedTasksDays" autocomplete="off" class="layui-input bt-biz-moneyType"
                                       data-decimal="0" data-separator="" value="$!{config.receivable.timedTasksDays}"
                                       data-min="1" >
                            </div>
                            <div class="layui-input-inline">#springMessage('config.nis.day')</div>
                        </td>
                    </tr>
                    <tr>
                        ## 自动勾对是否直接确认
                        <td width="20%" class="textRight">#springMessage('config.receivable.refundblending.autoTrue')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="receivable.autoTrue" value="1"
                                       #if($config.receivable.autoTrue == 1)checked#end
                                       title="#springMessage('nis.sc_yn.yes')">
                                <input type="radio" name="receivable.autoTrue" value="0"
                                       #if($config.receivable.autoTrue == 0)checked#end
                                       title="#springMessage('nis.sc_yn.no')">
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">付款明细勾对参数</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## 后台任务每批次执行笔数
                        <td width="20%" class="textRight">后台任务每批次执行笔数</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="text" name="receivable.autoCount" autocomplete="off" class="layui-input bt-biz-moneyType"
                                       data-decimal="0" data-separator="" value="$!{config.receivable.autoCount}"
                                       data-min="1" >
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 付款明细滚动匹配天数
                        <td width="20%" class="textRight">付款明细滚动匹配天数</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="text" name="receivable.rollMate" autocomplete="off" class="layui-input bt-biz-moneyType"
                                       data-decimal="0" data-separator="" value="$!{config.receivable.rollMate}"
                                       data-min="1">
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="20%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form', 'jquery', 'rateType', 'moneyType', 'element'], function () {
        var form = bt.form(), $ = bt.jquery;
        bt.element();
        var rateTye = bt.rateType.init();
        bt.moneyType.init();
        if ($("input[name='nis.isAutoAccount']:checked").val() == '0') {
            $("#payAccount").show();
        }
        //监听提交
        form.on('submit(configSubmit)', function (data) {
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, "JSON");
            return false;
        });
        form.on('radio(isAutoAccount)', function (data) {
            if (data.value == 0) {
                $("#payAccount").show();
            } else {
                $("#payAccount").hide();
            }
        });
        // 说明显示隐藏
        showDesc();
    });

    function showDesc() {
        var tip_index1 = 0;
        $('#refundBlendDays-desc').mouseenter(function () {
            tip_index1 = layer.tips("退款流水与付款单匹配允许交易日期相差天数范围。例如：参数填写为2，则退款流水的当前交易日期匹配付款单的交易日期2天内的都可进行匹配。", '#refundBlendDays-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index1);
        });

    }
</script>
</body>
</html>

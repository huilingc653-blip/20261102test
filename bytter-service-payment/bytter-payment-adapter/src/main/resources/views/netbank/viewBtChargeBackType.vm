<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight">#springMessage('btChargeBackType.busType')</td>
					<td width="40%">
                        $!{btChargeBackTypePage.busType}
                    </td>
					<td class="textRight">#springMessage('btChargeBackType.busTypeName')</td>
					<td width="40%">
						$!{btChargeBackTypePage.busTypeName}
                    </td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('btChargeBackType.isDefault')</td>
					<td>
						$dictTag.get("sf_yn",$!{btChargeBackTypePage.isDefault})
                    </td>
					<td class="textRight">#springMessage('btChargeBackType.validSign')</td>
					<td>
						$dictTag.get("valid_sign",$!{btChargeBackTypePage.validSign})
                    </td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('btChargeBackType.rmk')</td>
					<td colspan="3">
						$!{btChargeBackTypePage.rmk}
                    </td>
                </tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table layui-table-border">
			<tbody>
			<tr>
				##调拨类型
				<td class="textRight">调拨类型</td>
				<td>
					$!{nisFlowRuleVO.transferTypeName}
				</td>
				##调拨方式
				<td class="textRight">调拨方式</td>
				<td>
					$!{nisFlowRuleVO.transferModeName}
				</td>
				##状态
				<td class="textRight">状态</td>
				<td>
					$!{nisFlowRuleVO.statusName}
				</td>
			</tr>

			#if($nisFlowRuleVO.transferMode !="2")
			<tr>
				#foreach($nisFlowRulePurposes in $!{nisFlowRuleVO.nisFlowRulePurposes})
					<td class="textRight">用途/摘要</td>
					<td>
						$!{nisFlowRulePurposes.purpose}
					</td>
					<td></td>
					<td></td>
					<td></td>
					<td></td>
				</tr>
				#end
			#end
			</tbody>
		</table>
		#if($nisFlowRuleVO.transferMode =="2")
			<table class="layui-table layui-table-border" width="100%">
				<thead>
					<tr>
						<th class="textCenter">
							银行类别
						</th>
						<th class="textCenter">
							摘要/用途
						</th>
					</tr>
				</thead>
				<tbody>
					#foreach($nisFlowRulePurposes in $!{nisFlowRuleVO.nisFlowRulePurposes})
					<tr>
						<td class="textCenter">
							$!{nisFlowRulePurposes.bankName}
						</td>
						<td class="textCenter">
							$!{nisFlowRulePurposes.purpose}
						</td>
					</tr>
					#end
				</tbody>
			</table>
		#end
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
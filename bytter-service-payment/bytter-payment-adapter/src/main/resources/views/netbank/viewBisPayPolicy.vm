<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" type="hidden" value="$!{bisPayPolicyPage.id}">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.bisPayPolicy.title')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##有效标志
                        <td class="textRight" width="20%">#springMessage('table.bisPayPolicy.validSign')</td>
                        <td width="30%">$!{bisPayPolicyPage.validSign}</td>
                        ##单位
                        <td class="textRight" width="20%">#springMessage('table.nisBillhead.corpId')</td>
                        <td width="30%">$!{bisPayPolicyPage.corpName}</td>
                    </tr>
                    <tr>
                        ##策略代码
                        <td class="textRight">#springMessage('table.btwarnstrategy.code')</td>
                        <td width="40%">$!{bisPayPolicyPage.policyCode}</td>
                        ##策略名称
                        <td class="textRight">#springMessage('table.btwarnstrategy.name')</td>
                        <td width="40%">$!{bisPayPolicyPage.policyName}</td>
                    </tr>
                    <tr>
                        ##币种
                        <td class="textRight">#springMessage('ttpay.currency')</td>
                        <td width="40%">
                            <input type="hidden" id="curId" name="curId" autocomplete="off" class="layui-input"
                                   value="$!{bisPayPolicyPage.curId}">
                            $!{bisPayPolicyPage.curName}
                        </td>
                        <td class="textRight">#springMessage('是否智能跳过节假日')</td>
                        <td width="40%">$!{bisPayPolicyPage.isWorkDay}</td>
                    </tr>
                    <tr>
                        ##单笔支付金额
                        <td class="textRight">#springMessage('table.bisPayPolicy.range')</td>
                        <td colspan="3">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-width="70px" data-disabled="true"
                                     data-group="FUNDWARN_OPERATOR" data-defaultvalue="10" data-name="range1"
                                     data-value="$!{bisPayPolicyPage.range1}"></div>
                            </div>
                            <div class="layui-input-inline">
                                $!{bisPayPolicyPage.rangeVal1}
                            </div>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-width="70px" data-disabled="true"
                                     data-group="FUNDWARN_NUM_OPERATOR" data-defaultvalue="02" data-name="rangeJoin"
                                     data-value="$!{bisPayPolicyPage.rangeJoin}"></div>
                            </div>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-width="70px" data-disabled="true"
                                     data-group="FUNDWARN_OPERATOR" data-defaultvalue="20" data-name="range2"
                                     data-value="$!{bisPayPolicyPage.range2}"></div>
                            </div>
                            <div class="layui-input-inline">
                                $!{bisPayPolicyPage.rangeVal2}
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##当日支付总额
                        <td class="textRight">#springMessage('table.bisPayPolicy.payTotal')</td>
                        <td>$!number.formatNumeric($!{bisPayPolicyPage.payTotal})</td>
                          ##业务类别
                                                <td class="textRight">#springMessage('table.nisBillhead.busType')</td>
                                          <td>$!{bisPayPolicyPage.busTypeName}</td>

                    </tr>
                    <tr>

                         ##支付收款人
                                                <td class="textRight">支付收款人</td>
                                                <td>
                                                    <div class="layui-input-inline">
                                                        <input type="hidden" id="payeeId" name="payeeId" autocomplete="off" class="layui-input"
                                                               value="$!{bisPayPolicyPage.payeeId}">
                                                        <button class="layui-btn bt-biz-externalCorpView" id="externalCorpViewBut" type="button"
                                                                data-beforeClick="bt.externalCorpViewParams"
                                                                data-callback="bt.externalCorpViewParams">#springMessage(
                                                            'common.button.view')</button>
                                                    </div>
                                                </td>

                        ##支付账号
                        <td class="textRight">#springMessage('table.bisPayPolicy.payerAcc')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="hidden" id="payerAccId" name="payerAccId" autocomplete="off"
                                       class="layui-input" value="$!{bisPayPolicyPage.payerAccId}">
                                <button class="layui-btn bt-biz-bankAccView" id="bankAccViewBut" type="button"
                                        data-beforeClick="bt.bankAccViewParams"
                                        data-callback="bt.bankAccViewParams">#springMessage(
                                    'common.button.view')</button>
                            </div>
                        </td>
                    </tr>

                    </tbody>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.bisPayPolicy.sortTitle')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##优先支付策略
                        <td class="textRight" width="20%">#springMessage('table.bisPayPolicy.sort')</td>
                        <td colspan="3">
                            <div class="layui-input-inline" style="padding: 10px">
                                #foreach($data in $sort)
                                    <div class="layui-input-inline" id="sortDiv$velocityCount"
                                        #if($!{data.sort} == 0)
                                         style="display: none"
                                        #end>
                                        <input type="text" id="sort$velocityCount" data-name="sort"
                                               data-biz-name="sort$velocityCount" lay-verify="number2" data-decimal="0"
                                               data-separator="" data-min="1" data-max="5"
                                            #if($!{data.sort} != 0)
                                               value="$!{data.sort}"
                                            #end
                                               autocomplete="off" class="layui-input bt-biz-moneyType"
                                               style="width: 100px"
                                               placeholder="#springMessage('table.fbsBudgetYear.number')"
                                               disabled="true">
                                    </div>
                                    <div class="layui-input-inline">
                                        <input type="checkbox" lay-skin="primary" id="policyType$velocityCount"
                                               name="policyType" disabled="true"
                                            #if($!{data.sort} != 0)
                                               checked="checked"
                                            #end
                                               value="$!{data.policyType}"
                                               lay-filter="policyType">&nbsp;$!{data.policyTypeName}
                                    </div>
                                    <br>
                                #end
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script>
    var $, form;
    var noPayeeParams = {};// 不支付收款人参数
    bt.use(['form', 'dicts', 'layedit', 'externalCorpView', 'bankAccView', 'moneyType'], function () {
        $ = bt.jquery;
        form = bt.form();
        var moneyType = bt.moneyType.init();
        bt.dicts.init();

        //供应商选择
        var externalCorpView = bt.externalCorpView.init();

        bt.externalCorpViewParams = function () {
            externalCorpView.set({"id": $("#payeeId").val()});
            return true;
        }

        //支付账号选择
        var bankAccView = bt.bankAccView.init();
        bt.bankAccViewParams = function () {
            bankAccView.set({
                "id": $("#payerAccId").val(),
                "curId": $("#curId").val()
            });
            return true;
        }
    })

    // 不支付收款人查看
    function viewNoPayee() {
        var params = "";
        if (Object.keys(noPayeeParams).length !== 0) {
            // 将对象转成字符串。如 {a:'aaa',b:'bbb'}转成 "a='aaa'&b='bbb'"
            params = Object.keys(noPayeeParams).map(function (key) {
                return encodeURIComponent(key) + '=' + encodeURIComponent(noPayeeParams[key]);
            }).join('&')
        }
        var url;
        if (params === "") {
            url = basePath + "/netbank/bispaypolicy/viewNoPayee?id=" + $("#id").val();
        } else {
            url = basePath + "/netbank/bispaypolicy/viewNoPayee?id=" + $("#id").val() + "&" + params;
        }
        parent.layer.open({
            type: 2,
            title: "不支付收款人",
            area: ['1000px', '600px'],
            maxmin: true,
            content: url,
            end: function () {
            }
        });
    }
</script>
</body>
</html>

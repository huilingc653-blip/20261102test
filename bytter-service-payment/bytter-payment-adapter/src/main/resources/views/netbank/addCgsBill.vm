<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{cgsBillPage.id}">
		<input id="payerAccName" name="payerAccName" type="hidden" value="$!{cgsBillPage.payerAccName}">
		<input id="payeeAccName" name="payeeAccName" type="hidden">
		<input id="caInfoId" name="caInfoId" type="hidden" value="$!{cgsBillPage.caInfoId}">
		<input id="gatherNextAuditors" name="gatherNextAuditors" type="hidden" value="$!{cgsBillPage.gatherNextAuditors}">
		<input id="gatherAuditStep" name="gatherAuditStep" type="hidden" value="$!{cgsBillPage.gatherAuditStep}">
		<input id="gatherAuditState" name="gatherAuditState" type="hidden" value="$!{cgsBillPage.gatherAuditState}">
		<input id="gatherAuditDate" name="gatherAuditDate" type="hidden" value="$!{cgsBillPage.gatherAuditDate}">
		<input id="gatherAuditors" name="gatherAuditors" type="hidden" value="$!{cgsBillPage.gatherAuditors}">
		<input id="judgeResult" name="judgeResult" type="hidden" value="$!{cgsBillPage.judgeResult}">
		<input id="judgeNarrate" name="judgeNarrate" type="hidden" value="$!{cgsBillPage.judgeNarrate}">
		<input id="judgerCode" name="judgerCode" type="hidden" value="$!{cgsBillPage.judgerCode}">
		<input id="judgerName" name="judgerName" type="hidden" value="$!{cgsBillPage.judgerName}">
		<input id="judgeDate" name="judgeDate" type="hidden" value="$!{cgsBillPage.judgeDate}">
		<input id="signFlag" name="signFlag" type="hidden" value="$!{cgsBillPage.signFlag}">
		<input id="signDate" name="signDate" type="hidden" value="$!{cgsBillPage.signDate}">
		<input id="signerCode" name="signerCode" type="hidden" value="$!{cgsBillPage.signerCode}">
		<input id="signerName" name="signerName" type="hidden" value="$!{cgsBillPage.signerName}">
		<input id="confirmNextAuditors" name="confirmNextAuditors" type="hidden" value="$!{cgsBillPage.confirmNextAuditors}">
		<input id="confirmAuditStep" name="confirmAuditStep" type="hidden" value="$!{cgsBillPage.confirmAuditStep}">
		<input id="confirmAuditState" name="confirmAuditState" type="hidden" value="$!{cgsBillPage.confirmAuditState}">
		<input id="confirmAuditDate" name="confirmAuditDate" type="hidden" value="$!{cgsBillPage.confirmAuditDate}">
		<input id="confirmAuditors" name="confirmAuditors" type="hidden" value="$!{cgsBillPage.confirmAuditors}">
		<input id="tallyFlag" name="tallyFlag" type="hidden" value="$!{cgsBillPage.tallyFlag}">
		<input id="tallyNarrate" name="tallyNarrate" type="hidden" value="$!{cgsBillPage.tallyNarrate}">
		<input id="tallierCode" name="tallierCode" type="hidden" value="$!{cgsBillPage.tallierCode}">
		<input id="tallierName" name="tallierName" type="hidden" value="$!{cgsBillPage.tallierName}">
		<input id="tallyDate" name="tallyDate" type="hidden" value="$!{cgsBillPage.tallyDate}">
		<input id="checkDate" name="checkDate" type="hidden" value="$!{cgsBillPage.checkDate}">
		<input id="checkCode" name="checkCode" type="hidden" value="$!{cgsBillPage.checkCode}">
		<input id="voucherNo" name="voucherNo" type="hidden" value="$!{cgsBillPage.voucherNo}">
		<input id="finishFlag" name="finishFlag" type="hidden" value="$!{cgsBillPage.finishFlag}">
		<input id="finishNarrate" name="finishNarrate" type="hidden" value="$!{cgsBillPage.finishNarrate}">
		<input id="netAcc" name="netAcc" type="hidden" value="$!{cgsBillPage.netAcc}">
		<input id="status" name="status" type="hidden" value="0">
		<input id="orderNo" name="orderNo" type="hidden" value="$!{cgsBillPage.orderNo}">
		<input id="approves" name="approves" type="hidden" value="$!{cgsBillPage.approves}">
		<input id="createBy" name="createBy" type="hidden" value="$!{cgsBillPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{cgsBillPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{cgsBillPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{cgsBillPage.updateDate}">
		<input id="payeeCorpId" name="payeeCorpId" type="hidden" value="$!{cgsBillPage.payeeCorpId}">
        <table class="layui-table">
        	<tbody>
        		<tr>
        			##委托日期
        			<td class="textRight">#springMessage('table.cgsBill.consignDate')</td>
        			<td width="40%">
    					##<div type="date" field="consignDate" defaultVal="$!{cgsBillPage.consignDate}"></div>
    					<input name="consignDate" class="layui-input bt-biz-dateType" data-today="true" lay-verify="required"
							data-type="date" data-biz-name="consignDate" type="text">
        			</td>
        			<td class="textRight">#springMessage('table.cgsBill.consignCode')</td>
        			<td width="40%">
    					<input type="text" id="consignCode" name="consignCode" lay-verify="required"  readonly="readonly" value="$!{consignCode}"
    						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.cgsBill.consignCode')">
        			</td>
        		</tr>
        		<tr>
        			##收款单位
        			<td class="textRight">#springMessage('table.cgsBill.payeeCorpId')</td>
        			<td>
        				<div class="layui-input-inline">
        					<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-name="payeeCorpId"
                            data-scope="all"
							data-required ="true"
                            data-biz-name="payeeId" data-resource="netbank:netBank:cgsBill:apply"></div>
        				</div>
        			</td>
        			##收款账号
        			<td class="textRight">#springMessage('table.cgsBill.payeeAcc')</td>
        			<td>
        				<div class="layui-input-inline">
        					<input type="text" id="payeeAcc" name="payeeAcc" lay-verify="required"
        						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.cgsBill.payeeAcc')">
                            <div class="bt-div-search">
                                <button  class="bt-biz-accInFoByCorp" id="selPayeeAccBut" type="button" data-beforeClick="bt.checkBefore" data-callback="bt.payeeCorpCallback" title="#springMessage('common.button.select')">
                                    <i class="layui-icon">&#xe615;</i>
                                </button>
                            </div>
        				</div>
        			</td>
        		</tr>
        		<tr>
        			##付款单位
        			<td class="textRight">#springMessage('table.cgsBill.payerCorpId')</td>
        			<td>
            			<div class="layui-input-inline">
            				<div class="bt-biz-corp"
                                data-biz-type="corp"
                                data-type="selectTree"
                                data-name="payerCorpId"
                                data-scope=""
    							data-required ="true">
            				</div>
            			</div>
        			</td>
        			##付款账号
        			<td class="textRight">#springMessage('table.cgsBill.payerAcc')</td>
        			<td>
    					<input type="text" id="payerAcc" name="payerAcc" lay-verify="required" readonly="readonly" 
    						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.cgsBill.payerAcc')">
        			</td>
        		</tr>
        		<tr>
        			##合同号
        			<td class="textRight">#springMessage('table.cgsBill.pactCode')</td>
        			<td>
        				<div class="layui-input-inline">
        					<input type="text" id="pactCode" name="pactCode"
        						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.cgsBill.pactCode')">
        				</div>
        			</td>
        			##发票号
        			<td class="textRight">#springMessage('table.cgsBill.invoiceCode')</td>
        			<td>
        				<div class="layui-input-inline">
        					<input type="text" id="invoiceCode" name="invoiceCode"
        						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.cgsBill.invoiceCode')">
        				</div>
        			</td>
        		</tr>
        		<tr>
        			##金额
        			<td class="textRight">#springMessage('table.cgsBill.money.lower')</td>
        			<td>
						##金额（小写）
						<input type="text" lay-verify="required|langKey|strlength"  data-maxlength="20" data-name="money" data-biz-name="money"
							class="layui-input bt-biz-moneyType" style="text-align:right" data-minus="true" data-toUp="moneyUp" data-callback="moneyCallBack"
							autocomplete="off" placeholder="#springMessage('table.cgsBill.money.lower')">
        			</td>
        			##金额(大写)
        			<td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
        			<td style="padding-left:0px">
                        <div id="moneyUp"></div>
        			</td>
        		</tr>
        		<tr>
        			##手续费率
        			<td class="textRight">#springMessage('table.cgsBill.chargeRate')</td>
        			<td>
        				<div class="layui-input-inline">
##        					<div id="chargeRate" name="chargeRate" class="layui-input"></div>
    						<div><input data-name="chargeRate" class="layui-input bt-biz-rateType" readonly="readonly" data-biz-name="chargeRate" type="text"></div>
        				</div>
        			</td>
        			##手续费
        			<td class="textRight">#springMessage('table.cgsBill.chargeMoney')</td>
        			<td>
        				<div class="layui-input-inline">
        					<input type="text" id="chargeMoney" name="chargeMoney" readonly="readonly"
        						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.cgsBill.chargeMoney')">
        				</div>
        			</td>
        		</tr>
        		<tr>
        			##摘要
        			<td class="textRight">#springMessage('table.cgsBill.abs')</td>
        			<td>
        				<div class="layui-input-inline">
        					<input type="text" id="abs" name="abs"
        						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.cgsBill.abs')">
        				</div>
        			</td>
        			<td class="textRight"></td>
        			<td></td>
        		</tr>
        		<tr>
        			<td colspan="4" style="text-align: center;">
        				<button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
           	            <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                           <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        			</td>
        			</tr>

        	</tbody>
        </table>
        <input id="attachmentId" name="attachmentId" type="hidden">
        <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
    </form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/cgsBill.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">

                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##单位
                        <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-corp"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-tree-type="check"
                                     data-name="ins_corpId"
                                     data-callback="bt.corpCallback"
                                     data-resource="netbank:nisDemand:query"
                                     data-scope="all"></div>
                            </div>
                        </td>
                        ##需求账号
                        <td class="textRight">#springMessage('sys.common.require.account')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" id="eqs_bankAcc" name="eqs_bankAcc" lay-verify="tableData" data-biz-name="bankAcc"
                                       autocomplete="off" class="layui-input text" placeholder="需求账号">
                                <table id="bankAccTable" class="hide">
                                    <thead>
                                    <tr>
                                        <th>#springMessage('table.nisBillhead.payerAcc')</th>
                                        <th>#springMessage('table.nisBillhead.payerAccName')</th>
                                        <th>#springMessage('table.nisBillhead.payerBank')</th>
                                        <th>#springMessage('table.nisBillhead.curId')</th>
                                    </tr>
                                    </thead>
                                </table>
                            </div>
                        </td>
                        ##需求日期
                        <td class="textRight">#springMessage('nis.payment.requireDate')</td>
                        <td>
                            <input type="text" name="ged_demandDate" class="layui-input bt-input-inline bt-biz-dateType"
                                   data-endid="led_demandDate" value="">
                            <span class="date-mid">~</span>
                            <input type="text" name="led_demandDate" class="layui-input bt-input-inline bt-biz-dateType"
                                   id="led_demandDate" value="">
                        </td>
                    </tr>
                    <tr>
                        ##上级单位
                        <td class="textRight">#springMessage('sys.organtype.corpSup')</td>
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-corp"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-tree-type="check"
                                     data-name="ins_superCorpId"
                                     data-callback="bt.superiorCorpCallback"
                                     data-resource="netbank:nisDemand:query"
                                     data-scope="all"></div>
                            </div>
                        </td>
                        ##上级账号
                        <td class="textRight">#springMessage('sys.common.super.account')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" id="eqs_superBankAcc" name="eqs_superBankAcc" lay-verify="tableData" data-biz-name="superBankAcc"
                                       autocomplete="off" class="layui-input text" placeholder="上级账号">
                                <table id="superBankAccTable" class="hide">
                                    <thead>
                                    <tr>
                                        <th>#springMessage('table.nisBillhead.payerAcc')</th>
                                        <th>#springMessage('table.nisBillhead.payerAccName')</th>
                                        <th>#springMessage('table.nisBillhead.payerBank')</th>
                                        <th>#springMessage('table.nisBillhead.curId')</th>
                                    </tr>
                                    </thead>
                                </table>
                            </div>
                        </td>
                        ##需求类型
                        <td class="textRight">#springMessage('nis.payment.require.type')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="mulselect"
                                 data-group="nisDemand.demandType" data-name="ins_demandType" ></div>
                        </td>
                    </tr>
                    <tr>
                        ##前端单据编码
                        <td class="textRight">#springMessage('sys.common.front.billCode')</td>
                        <td>
                            <input type="text" name="likes_payBillNo"
                                   autocomplete="off" class="layui-input"
                                   placeholder="前端单据编码">
                        </td>
                        ##状态
                        <td class="textRight">#springMessage('contract.status')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="select"
                                 data-group="nisDemand.status" data-name="eqi_status" data-displayData="0,1"></div>
                        </td>
                        ##需求金额
                        <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" data-name="geg_demandMoney"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                       data-moneyendid="t20" placeholder="需求金额">
                            </div>
                            <span class="date-mid">~</span>
                            <div class="layui-inline">
                                <input type="text" data-name="leg_demandMoney"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                       id="t20" placeholder="需求金额">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('nis.payment.isSummary')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="select"
                                 data-group="sf_yn" data-name="eqs_isConverge" ></div>
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                                'common.button.search')</button>
                            <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                'common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisDemand.billNo')</th>
        <th>#springMessage('table.nisDemand.bankAcc')</th>
        <th>#springMessage('table.nisDemand.corpId')</th>
        <th>#springMessage('table.nisDemand.accName')</th>
        <th>#springMessage('table.nisDemand.bankName')</th>
        <th>#springMessage('table.nisDemand.demandType')</th>
        <th>#springMessage('table.nisDemand.demandDate')</th>
        <th>#springMessage('table.nisDemand.demandMoney')</th>
        <th>#springMessage('table.nisDemand.payBillNo')</th>
        <th>#springMessage('table.nisDemand.payBillDate')</th>
        <th>#springMessage('table.nisDemand.superCorpId')</th>
        <th>#springMessage('table.nisDemand.superBankAcc')</th>
        <th>#springMessage('table.nisDemand.superAccName')</th>
        <th>#springMessage('table.nisDemand.superBankName')</th>
        <th>#springMessage('table.nisDemand.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/netbank/nisDemand.list.js?_btv=${resourceVersion}"></script>

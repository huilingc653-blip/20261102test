<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="likes_corpId"
                                 data-resource="netbank:netBank:bisPayPolicy:query"
                                 data-scope="all"
                                 data-callback="bt.corpCallback"></div>
                        </div>
                    </td>
                    ##支付收款人
                    <td class="textRight">支付收款人</td>
                    <td>
                        <input type="text" name="likes_payeeName" class="layui-input" autocomplete="off" placeholder="支付收款人">
                    </td>
				</tr>
                <tr>
                    ##币种
                    <td class="textRight">#springMessage('ttpay.currency')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                                 data-name="eqs_curId" data-valueField="id" data-textField="curName"></div>
                        </div>
                    </td>
                    ##业务类别
                    <td class="textRight">#springMessage('table.nisBillhead.busType')</td>
                    <td>
                        <input type="text" name="likes_busTypeName" class="layui-input" autocomplete="off" placeholder="#springMessage('table.nisBillhead.busType')">
                    </td>

                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisBillhead.corpId')</th>
        <th>#springMessage('table.btwarnstrategy.code')</th>
        <th>#springMessage('table.btwarnstrategy.name')</th>
		<th>支付收款人</th>
        <th>#springMessage('table.nisBillhead.busType')</th>
        <th>#springMessage('ttpay.currency')</th>
        <th>#springMessage('table.bisPayPolicy.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/bisPayPolicy.list.js?_btv=${resourceVersion}"></script>
</html>

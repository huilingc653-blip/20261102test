<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<input id="id" name="name" type="hidden" value="$!{cgsBillPage.id}">
        <input id="busType" name="busType" type="hidden" value="$!{busType}">
        <div id="print">
		<table class="layui-table">
			<tbody>
			<tr>
	       		##委托日期
				<td class="textRight">#springMessage('table.cgsBill.consignDate')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{cgsBillPage.consignDate})</td>
				<td class="textRight">#springMessage('table.cgsBill.consignCode')</td>
				<td width="35%">$!{cgsBillPage.consignCode}</td>
       		</tr>
       		<tr>
				##收款单位
				<td class="textRight">#springMessage('table.cgsBill.payeeCorpId')</td>
				<td width="35%">$!{cgsBillPage.payeeCorpName}</td>
				##收款账号
				<td class="textRight">#springMessage('table.cgsBill.payeeAcc')</td>
				<td width="35%">$!{cgsBillPage.payeeAcc}</td>					
       		</tr>
       		<tr>
	       		##付款单位
				<td class="textRight">#springMessage('table.cgsBill.payerCorpId')</td>
				<td width="35%">$!{cgsBillPage.payerCorpName}</td>
				##付款账号
				<td class="textRight">#springMessage('table.cgsBill.payerAcc')</td>
				<td width="35%">$!{cgsBillPage.payerAcc}</td>				
       		</tr>
       		<tr>
	       		##合同号
				<td class="textRight">#springMessage('table.cgsBill.pactCode')</td>
				<td width="35%">$!{cgsBillPage.pactCode}</td>
				##发票号
				<td class="textRight">#springMessage('table.cgsBill.invoiceCode')</td>
				<td width="35%">$!{cgsBillPage.invoiceCode}</td>				
       		</tr>
       		<tr>
	       		##金额
				<td class="textRight">#springMessage('table.cgsBill.money')</td>
				<td width="35%"><span id="lower">$!{cgsBillPage.money}</span></td>
				##金额(大写)
				<td class="textRight">#springMessage('table.cmsProvideLoanInfo.plMoneyUpper')</td>
				<td width="35%"><span id="upper"></span></td>				
       		</tr>
       		<tr>
	       		##手续费率
				<td class="textRight">#springMessage('table.cgsBill.chargeRate')</td>
				<td width="35%">
					<div class="layui-input-inline">
						<div id="chargeRate" name="chargeRate"></div>
					</div>
				</td>
				##手续费
				<td class="textRight">#springMessage('table.cgsBill.chargeMoney')</td>
				<td width="35%">$!{cgsBillPage.chargeMoney}</td>				
       		</tr>
       		<tr>
	       		##摘要
				<td class="textRight">#springMessage('table.cgsBill.abs')</td>
				<td width="35%">$!{cgsBillPage.abs}</td>
				<td class="textRight"></td>
				<td width="35%"></td>				
       		</tr>
       		<tr>
	       		##状态
				<td class="textRight">#springMessage('table.cgsBill.status')</td>
				<td width="35%">$!{cgsBillPage.statusName}</td>
				##操作人 
				<td class="textRight">#springMessage('table.cgsBill.createBy')</td>
				<td width="35%">$!{cgsBillPage.createBy}</td>				
       		</tr>
			</tbody>
		</table>
		</div>
		<!-- 日志 -->
		<div id="tagMsg"></div>
		<!-- 附件上传 -->
        <input id="attachmentId" name="attachmentId" type="hidden" value="$!{cgsBillPage.attachmentId}">
        <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
		<p>
        <div class="layui-form-item layui-form-submit" id="buttonDiv">
    		<div class="layui-input-block">
                <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
    		</div>
		</div>
	</form>
#parse("views/common/footer.vm")
<script src="${basePath}/static/modules/netbank/cgsBill.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
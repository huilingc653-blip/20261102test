<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" id="nisPaySchedulingElementsForm">
		<input id="id" name="id" type="hidden" value="$!{nisPaySchedulingElements.id}">
		<input id="createBy" name="createBy" type="hidden" value="$!{nisPaySchedulingElements.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{nisPaySchedulingElements.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{nisPaySchedulingElements.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{nisPaySchedulingElements.updateDate}">
		<table class="layui-table">
			<tbody>
			<tr>
				##名称
				<td class="textRight" width="50%">#springMessage('table.nisPaySchedulingElements.schedulingElements')</td>
				<td>
					<input type="text" id="name" name="name" lay-verify="required|strlength" data-maxlength="100" autocomplete="off" class="layui-input"
						   placeholder="#springMessage('table.nisPaySchedulingElements.schedulingElements')" value="$!{nisPaySchedulingElements.name}">
				</td>
			</tr>
			<tr>
				##有效标志
				<td class="textRight" width="50%">#springMessage('nisBusType.validSign')</td>
				<td>
					<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="$!{nisPaySchedulingElements.validSign}" data-name="validSign" data-biz-name="validSign" ></div>
				</td>
			</tr>
			<tr>
				<tr>
				<td colspan="2" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="save">#springMessage('common.button.save')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
			</tbody>
		</table>
	</form>
	#parse("views/common/footer.vm")
</body>
<script>
	bt.use(['form', 'layedit', 'dicts', 'selectTree'], function () {
		var $ = bt.jquery;
		dicts = bt.dicts.init();
		form = bt.form();
		//监听提交
		form.on('submit(save)', function (data) {
			var action = "/netbank/nispayschedulingelements/modify";
			$.post(basePath + action, $('#nisPaySchedulingElementsForm').serialize(), function (result) {
				parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}, function () {
					parent.layer.closeAll();
					if (result.success) {
						if (bt.navtab) {
							bt.navtab.refreshParent();
							bt.navtab.closeCurrent();
						} else {
							parent.layer ? parent.layer.closeAll() : layer.closeAll();
						}
					}
				})
			}, 'JSON');
			return false;
		});
	});
</script>
</html>
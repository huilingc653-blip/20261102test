<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight">#springMessage('btChargeBackType.busType')</td>
					<td width="40%">
                        <input type="text" name="likes_busType"
                        	autocomplete="off" class="layui-input" placeholder="#springMessage("btChargeBackType.busType")">
                    </td>
					<td class="textRight">#springMessage('btChargeBackType.busTypeName')</td>
					<td width="40%">
                        <input type="text" name="likes_busTypeName"
                        	autocomplete="off" class="layui-input" placeholder="#springMessage("btChargeBackType.busTypeName")">
                    </td>
                </tr>
    			<tr >
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('btChargeBackType.busType')</th>
            <th>#springMessage('btChargeBackType.busTypeName')</th>
            <th>#springMessage('btChargeBackType.isDefault')</th>
            <th>#springMessage('btChargeBackType.validSign')</th>
            <th>#springMessage('btChargeBackType.rmk')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/btChargeBackType.list.js?_btv=${resourceVersion}"></script>
</html>

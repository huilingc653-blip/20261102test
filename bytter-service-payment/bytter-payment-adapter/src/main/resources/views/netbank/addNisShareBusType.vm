<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
            ##共享业务类型编码
        <tr>
            <td class="textRight" width="40%">共享业务类型编码</td>
            <td>
                <input type="text" id="shareBusType" name="shareBusType" lay-verify="required|strlength"
                       data-maxlength="10" autocomplete="off" class="layui-input"
                       placeholder="共享业务类型编码">
            </td>
        </tr>
            ##共享业务类型名称
        <tr>
            <td class="textRight">共享业务类型名称</td>
            <td>
                <input type="text" id="shareBusTypeName" name="shareBusTypeName" lay-verify="required|strlength"
                       data-maxlength="200" autocomplete="off" class="layui-input"
                       placeholder="共享业务类型名称">
            </td>
        </tr>
            ##关联业务类别
        <tr>
            <td class="textRight">关联业务类别</td>
            <td>
                <div class="bt-biz-selectType" data-name="busTypeId" data-biz-name="busTypeId"
                     data-url="${basePath}/netbank/nissharebustype/listValidBusTypeByCdSign?cdSign=1"
                     data-valuefield="id" data-textfield="busTypeNameShow" data-search="true" data-required="true">
                </div>
            </td>
        </tr>
            ##状态
        <tr>
            <td class="textRight">状态</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="status_yn" data-defaultvalue="1"
                     data-name="status" data-biz-name="status" data-required="true"></div>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisShareBusType.add.js?_btv=${resourceVersion}"></script>
</html>
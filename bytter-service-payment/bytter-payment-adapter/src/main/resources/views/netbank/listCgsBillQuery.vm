<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input id="opType" name="opType" type="hidden" value="query">
    	<table class="layui-table">
    		<tbody>
    			<tr>
    				##付款单位
    				<td class="textRight">#springMessage('table.cgsBill.payerCorpId')</td>
    				<td>
                        <div class="layui-inline">
                        	<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
							data-tree-type="check"
                            data-name="ins_payerCorpId"
                            data-resource="netbank:netBank:cgsBill:query"
                            data-scope="all"></div>
                        </div>
    				</td>
    				##收款单位
    				<td class="textRight">#springMessage('table.cgsBill.payeeCorpId')</td>
    				<td>
                        <div class="layui-inline">
                        	<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
							data-tree-type="check"
                            data-name="ins_payeeCorpId"
                            data-resource="netbank:netBank:cgsBill:query"
                            data-scope="all"></div>
                        </div>
    				</td>
    				##合同号
    				<td class="textRight">#springMessage('table.cgsBill.pactCode')</td>
    				<td>
						<input type="text" name="likes_pactCode" autocomplete="off" class="layui-input"
    						placeholder="#springMessage('table.cgsBill.pactCode')">
    				</td>
    			</tr>
    			<tr>
    				##金额
    				<td class="textRight">#springMessage('table.cgsBill.money')</td>
    				<td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_money"
								autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.cgsBill.money')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_money"
                                    autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.cgsBill.money')">
                        </div>
    				</td>
    				##委托日期
    				<td class="textRight">#springMessage('table.cgsBill.consignDate')</td>
    				<td>
                        <input type="text" name="ged_consignDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_consignDate" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_consignDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_consignDate">
    				</td>
    				##状态
    				<td class="textRight">#springMessage('table.cgsBill.status')</td>
    				<td>
						<div class="bt-biz-dict" data-type="select" data-group="cgsBill.status" data-name="eqi_status"></div>
    				</td>
    			</tr>
    			<tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
    		</tbody>
    	</table>
    </form>

	<table id="appTable" class="layui-table layui-form"
		style="width: 100%;">
		<thead>
			<tr>
				<th>#springMessage('table.cgsBill.consignDate')</th>
				<th>#springMessage('table.cgsBill.consignCode')</th>
				<th>#springMessage('table.cgsBill.payerCorpId')</th>
				<th>#springMessage('table.cgsBill.payeeCorpId')</th>
				<th>#springMessage('table.cgsBill.payeeAcc')</th>
				<th>#springMessage('table.cgsBill.money')</th>
				<th>#springMessage('table.cgsBill.pactCode')</th>
				<th>#springMessage('table.cgsBill.abs')</th>
				<th>#springMessage('table.cgsBill.status')</th>
				<th>#springMessage('common.table.thead.operation')</th>
			</tr>
		</thead>
	</table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/cgsBill.query.js?_btv=${resourceVersion}"></script>
</html>

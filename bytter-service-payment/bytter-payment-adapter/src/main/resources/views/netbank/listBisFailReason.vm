<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight" width="10%">#springMessage('table.bisFailReason.failCode')</td>
					<td width="23%">
                        <input type="text" name="likes_failCode"
                        	autocomplete="off" class="layui-input" placeholder="#springMessage("table.bisFailReason.failCode")">
                    </td>
					<td class="textRight" width="10%">#springMessage('table.bisFailReason.failName')</td>
					<td width="23%">
                        <input type="text" name="likes_failName"
                        	autocomplete="off" class="layui-input" placeholder="#springMessage("table.bisFailReason.failName")">
                    </td>
                    <td class="textRight" width="10%">#springMessage('table.bisExc.bifCode')</td>
                    <td width="24%">
                        <div class="layui-input-inline">
                            <div data-name="bifCode" class="bt-biz-mulselectType"
                                 data-url="${basePath}/basic/business/bisbifinit/json"
                                 data-valueField="id"
                                 data-biz-name="ins_bifCode"
                                 data-textField="name"
                                 data-search="true"
                                 data-method="get"></div>
                        </div>
                    </td>
                </tr>
    			<tr >
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.bisFailReason.failCode')</th>
            <th>#springMessage('table.bisFailReason.failName')</th>
            <th>#springMessage('table.bisExc.bifCode')</th>
            <th>#springMessage('table.bisFailReason.keyWords')</th>
            <th>#springMessage('table.bisFailReason.actionCode')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/bisFailReason.list.js?_btv=${resourceVersion}"></script>
</html>

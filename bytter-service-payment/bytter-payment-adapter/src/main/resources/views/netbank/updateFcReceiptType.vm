<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcReceiptTypePage.id}">
        <table class="layui-table">
			<tbody >
				<tr >
					<td class="textRight" width="30%">#springMessage('fcReceiptType.code')</td>
					<td>
						<input type="text" id="receiptCode" name="receiptCode" lay-verify="required|langKey|strlength" autocomplete="off" readonly
							   class="layui-input" value="$!{fcReceiptTypePage.receiptCode}">
                    </td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcReceiptType.name')</td>
					<td>
						<input type="text" id="receiptName" name="receiptName" lay-verify="required|strlength" data-maxlength="20" autocomplete="off"
							   class="layui-input" value="$!{fcReceiptTypePage.receiptName}">
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('btPayType.validSign')</td>
					<td width="40%">
						<div class="bt-biz-dict" data-type="select" data-group="valid_sign" data-defaultvalue="$!{fcReceiptTypePage.validSign}" data-name="validSign" data-biz-name="validSign"></div>
					</td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
					<td>
						<textarea placeholder="#springMessage('fcVoucherType.rmk')" lay-verify="strlength" data-maxlength="40"  class="layui-textarea" id="rmk" name="rmk" >$!{fcReceiptTypePage.rmk}</textarea>
                    </td>
				</tr>
    			<tr >
                    <td colspan="2" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
	bt.use(['form', 'layedit', 'selectType', 'dicts'], function () {
		var $ = bt.jquery, form = bt.form();
		var dicts = bt.dicts.init();

		//监听提交
		form.on('submit(submit)', function (data) {
			var action = "/netbank/receipttype/modify";
			$.post(basePath + action, data.field, function (result) {
				parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}, function () {
					parent.layer.closeAll();
					// if (result.success) {
					// 	if (bt.navtab) {
					// 		bt.navtab.closeCurrent();
					// 	} else {
					// 		parent.layer ? parent.layer.closeAll() : layer.closeAll();
					// 	}
					// }
				})
			}, 'JSON');
			return false;
		});

	});


</script>

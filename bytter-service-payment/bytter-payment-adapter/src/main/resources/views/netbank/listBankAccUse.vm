<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('用途编码')</td>
            <td>
                <input type="text" name="likes_useCode" autocomplete="off" class="layui-input" placeholder="#springMessage('用途编码')">
            </td>
            <td class="textRight">#springMessage('用途名称')</td>
            <td>
                <input type="text" name="likes_useName" autocomplete="off" class="layui-input" placeholder="#springMessage('用途名称')">
            </td>
        </tr>
        <tr >
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('用途编码')</th>
        <th>#springMessage('用途名称')</th>
        <th>#springMessage('btPayType.rmk')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/bankAccUse.list.js?_btv=${resourceVersion}"></script>
</html>

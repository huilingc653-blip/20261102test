<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }

    </style>
</head>
<body>
<form class="layui-form" action="">
<div class="layui-collapse">
<div class="layui-colla-item">
<h2 class="layui-colla-title">#springMessage('config.fbs.param.titile')</h2>
<div class="layui-colla-content layui-show">
<table class="layui-table breakRow">
    <thead>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
            <td width="80%">#springMessage('config.fbs.paramValue')</td>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.fcs.accAutoCheck')</td>
            <td width="80%">
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{config.fcs.accAutoCheck}"
                     data-name="fcs.accAutoCheck" data-biz-name="fcs.accAutoCheck"></div>
            </td>
        </tr>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.fcs.changeAutoCheck')</td>
            <td width="80%">
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{config.fcs.changeAutoCheck}"
                     data-name="fcs.changeAutoCheck" data-biz-name="fcs.changeAutoCheck"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('config.fcs.freezeAutoCheck')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{config.fcs.freezeAutoCheck}"
                     data-name="fcs.freezeAutoCheck" data-biz-name="fcs.freezeAutoCheck"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('config.fcs.logoutAutoCheck')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{config.fcs.logoutAutoCheck}"
                     data-name="fcs.logoutAutoCheck" data-biz-name="fcs.logoutAutoCheck"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('config.fcs.thawAutoCheck')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{config.fcs.thawAutoCheck}"
                     data-name="fcs.thawAutoCheck" data-biz-name="fcs.thawAutoCheck"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('config.fcs.accAccnoRule')</td>
            <td>
                <div>
                <div class="bt-biz-dict" data-type="select" data-group="config.fcs.accAccnoRule" data-width="200px" data-defaultvalue="$!{config.fcs.accAccnoRule}"
                     data-name="fcs.accAccnoRule" data-biz-name="fcs.accAccnoRule"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('config.fcs.freezeUnitAlertDays')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="fcs.freezeUnitAlertDays" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" data-separator="" value="$!{config.fcs.freezeUnitAlertDays}">
                </div>
                <div class="layui-input-inline">#springMessage('config.nis.day')</div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('config.fcs.bankAccEndDateAlertDays')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="fcs.bankAccEndDateAlertDays" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" data-separator="" value="$!{config.fcs.bankAccEndDateAlertDays}">
                </div>
                <div class="layui-input-inline">#springMessage('config.nis.day')</div>
            </td>
        </tr>
        ##        账户年检到期提醒提前天数
        <tr>
            <td class="textRight">#springMessage('config.fcs.checkExpireDateAlertDays')</td>
            <td>
                <div class="layui-input-inline">
                     <input type="text" name="fcs.checkExpireDateAlertDays" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" data-separator="" value="$!{config.fcs.checkExpireDateAlertDays}" >
                </div>
                <div class="layui-input-inline">#springMessage('config.nis.day')</div>
            </td>
        </tr>
        <tr>
        <tr>
            <td class="textRight">#springMessage('config.fcs.bankAccDesc')</td>
            <td>
                <textarea placeholder="#springMessage('config.fcs.bankAccDesc')" lay-verify="strlength" data-maxlength="200"
                          class="layui-textarea" id="fcs.bankAccDesc" name="fcs.bankAccDesc">$!{config.fcs.bankAccDesc}</textarea>
            </td>
        </tr>
    </tbody>
</table>
</div>
</div>
</div>
<table class="layui-table border0">
    <tbody>
    <tr>
        <td width="20%"></td>
        <td>
            <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
       	 	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </td>
    </tr>
    </tbody>
</table>
</form>
    #parse("views/common/footer.vm")
    <script>
        bt.use(['form','jquery','dicts','moneyType','element'], function(){
            var form = bt.form(),$  = bt.jquery;
			bt.element();
            bt.dicts.init();
            bt.moneyType.init();
            //监听提交
            form.on('submit(configSubmit)', function(data){
                $.post(basePath + "/sys/config/save",data.field,function(result){
                    parent.layer.alert(result.msg, {icon: result.success?1:2});
                },"JSON");
                return false;
            });
        });
    </script>
</body>
</html>
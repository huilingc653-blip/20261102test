<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{bisPayPolicyPage.id}">
    <input id="autoPayerAccNum" name="autoPayerAccNum" type="hidden" value="$!{autoPayerAccNum}">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.bisPayPolicy.title')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##有效标志
                        <td class="textRight" width="20%">#springMessage('table.bisPayPolicy.validSign')</td>
                        <td width="30%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1"
                                 data-name="validSign"></div>
                        </td>
                        ##单位
                        <td class="textRight" width="20%">#springMessage('table.nisBillhead.corpId')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-tree-type="check"
                                     data-name="corpId"
                                     data-biz-name="corpId"
                                     data-scope="all"
                                     data-resource="netbank:netbank:bisPayPolicy:apply"
                                     data-required="true"
                                     data-callback="bt.corpCallback"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##策略代码
                        <td class="textRight" width="20%">#springMessage('table.btwarnstrategy.code')</td>
                        <td width="30%">
                            <input type="text" id="policyCode" name="policyCode" lay-verify="required|langKey|strlength"
                                   data-maxlength="4" data-minlength="4"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.btwarnstrategy.code')">
                        </td>
                        ##策略名称
                        <td class="textRight" width="20%">#springMessage('table.btwarnstrategy.name')</td>
                        <td width="30%">
                            <input type="text" id="policyName" name="policyName" lay-verify="required"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.btwarnstrategy.name')">
                        </td>
                    </tr>
                    <tr>
                        ##币种
                        <td class="textRight" width="20%">#springMessage('ttpay.currency')</td>
                        <td width="30%">
                            <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                                 data-required="true"
                                 data-name="curId" data-biz-name="curId" data-valueField="id" data-textField="curName"
                                 data-callback="bt.curCallback"></div>
                        </td>
                        ## 是否智能跳过节假日
                        <td class="textRight" width="20%">#springMessage('是否智能跳过节假日')</td>
                        <td width="30%">
                            <div class="layui-inline">
                                <div class="bt-biz-dict" id="radio" data-type="radio" data-group="sf_yn"
                                     data-defaultvalue="0" data-required="true"
                                     data-name="isWorkDay" data-biz-name="isWorkDay">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##单笔支付金额
                        <td class="textRight">#springMessage('table.bisPayPolicy.range')</td>
                        <td colspan="3">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-width="70px"
                                     data-group="FUNDWARN_OPERATOR" data-defaultvalue="10" data-name="range1"></div>
                            </div>
                            <div class="layui-input-inline">
                                <input type="text" id="rangeVal1" name="rangeVal1" data-name="rangeVal1"
                                       data-biz-name="rangeVal1" autocomplete="off" class="layui-input bt-biz-moneyType"
                                       style="text-align:right;width: 120px" data-min="0">
                            </div>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-width="70px"
                                     data-group="FUNDWARN_NUM_OPERATOR" data-defaultvalue="02"
                                     data-name="rangeJoin"></div>
                            </div>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-width="70px"
                                     data-group="FUNDWARN_OPERATOR" data-defaultvalue="20" data-name="range2"></div>
                            </div>
                            <div class="layui-input-inline">
                                <input type="text" id="rangeVal2" name="rangeVal2" data-name="rangeVal2"
                                       data-biz-name="rangeVal2" autocomplete="off" class="layui-input bt-biz-moneyType"
                                       style="text-align:right;width: 120px" data-min="0">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##当日支付总额
                        <td class="textRight">#springMessage('table.bisPayPolicy.payTotal')</td>
                        <td>
                            <input type="text" id="payTotal" name="payTotal" lay-verify="number2" data-name="payTotal"
                                   data-biz-name="payTotal"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                   placeholder="#springMessage('table.bisPayPolicy.payTotal')">
                        </td>
   ##业务类别
                        <td class="textRight">#springMessage('table.nisBillhead.busType')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-mulselectType"
                                     data-method="get"
                                     data-url="${basePath}/netbank/niscorpbus/listNisCorpBusVOByCorpIdAndCdSign?cdSign=1&corpId=-1"
                                     data-name="busTypeId" data-biz-name="busTypeId"
                                     data-valuefield="busId" data-textfield="busTypeName"
                                     data-beforeinit="busBefore"
                                     data-callback="bt.busTypeCallback"
                                     data-search="true"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>

                        ##支付收款人
                        <td class="textRight">支付收款人</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="hidden" id="payeeId" name="payeeId" autocomplete="off" class="layui-input">
                                <button class="layui-btn bt-biz-externalCorpInfo" id="externalCorpBut" type="button"
                                        data-beforeClick="bt.externalCorpInfoParams"
                                        data-callback="bt.externalCorpInfoCallback">#springMessage(
                                    'common.button.select')</button>
                                <button class="layui-btn bt-biz-externalCorpView" id="externalCorpViewBut" type="button"
                                        data-beforeClick="bt.externalCorpViewParams"
                                        data-callback="bt.externalCorpViewParams">#springMessage(
                                    'common.button.view')</button>
                            </div>
                        </td>


                     ##支付账号
                                            <td class="textRight">#springMessage('table.bisPayPolicy.payerAcc')</td>
                                            <td>
                                                <div class="layui-input-inline">
                                                    <input type="hidden" id="payerAccId" name="payerAccId" autocomplete="off" class="layui-input">
                                                    <button class="layui-btn bt-biz-bankAccInfo" id="bankAccBut" type="button"
                                                            data-beforeClick="bt.bankAccInfoParams"
                                                            data-callback="bt.bankAccInfoCallback">#springMessage(
                                                        'common.button.select')</button>
                                                    <button class="layui-btn bt-biz-bankAccView" id="bankAccViewBut" type="button"
                                                            data-beforeClick="bt.bankAccViewParams"
                                                            data-callback="bt.bankAccViewParams">#springMessage(
                                                        'common.button.view')</button>
                                                </div>
                                            </td>
                    </tr>

                    </tbody>
                </table>
            </div>
        </div>
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.bisPayPolicy.sortTitle')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##优先支付策略
                        <td class="textRight" width="20%">#springMessage('table.bisPayPolicy.sort')</td>
                        <td colspan="3">
                            <div class="layui-input-inline" style="padding: 10px">
                                #foreach($data in $sort)
                                    <div class="layui-input-inline" id="sortDiv$velocityCount" style="display: none">
                                        <input type="text" id="sort$velocityCount" data-name="sort"
                                               data-biz-name="sort$velocityCount" lay-verify="number2" data-decimal="0"
                                               data-separator="" data-min="1" data-max="5"
                                               autocomplete="off" class="layui-input bt-biz-moneyType"
                                               style="width: 100px"
                                               placeholder="#springMessage('table.fbsBudgetYear.number')">
                                    </div>
                                    <div class="layui-input-inline">
                                        <input type="checkbox" lay-skin="primary" id="policyType$velocityCount"
                                               name="policyType" value="$!{data.policyType}" lay-filter="policyType">&nbsp;$!{data.policyTypeName}
                                    </div>
                                    <br>
                                #end
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div style="text-align: center; padding-top: 10px;">
        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/bisPayPolicy.add.js?_btv=${resourceVersion}"></script>
</html>

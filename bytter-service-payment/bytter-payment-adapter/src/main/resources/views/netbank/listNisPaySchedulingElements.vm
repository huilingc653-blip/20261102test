<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tr>
                <td class="textRight">#springMessage('table.nisPaySchedulingElements.schedulingElements')</td>
                <td width="40%">
                    <input type="text" name="likes_name" autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisPaySchedulingElements.schedulingElements')">
                </td>
                <td class="textRight">#springMessage('nisBusType.validSign')</td>
                <td width="40%">
                    <div class="bt-biz-dict" data-type="select" data-group="valid_sign" data-name="eqs_validSign" data-biz-name="validSign"></div>
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.nisPaySchedulingElements.schedulingElements')</th>
            <th>#springMessage('nisBusType.validSign')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisPaySchedulingElements.list.js?_btv=${resourceVersion}"></script>
</html>
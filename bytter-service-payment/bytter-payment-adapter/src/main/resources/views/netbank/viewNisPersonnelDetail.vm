<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
        <input id="id" name="id" type="hidden" value="$!{nisPersonnelDetailPage.id}">
        <input id="status" name="status" type="hidden" value="$!{nisPersonnelDetailPage.status}">
		<table class="layui-table">
			<tbody >
				<tr>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.workNo')</td>
                    <td width="40%">
						$!{nisPersonnelDetailPage.workNo}
					</td>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.userName')</td>
                    <td width="40%">
						$!{nisPersonnelDetailPage.userName}
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.sex')</td>
                    <td>
                        $dictTag.get("sex",$!{nisPersonnelDetailPage.sex})
					</td>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.idcard')</td>
                    <td>
					   $!{nisPersonnelDetailPage.idcard}
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.mobile')</td>
                    <td>
                        $!{nisPersonnelDetailPage.mobile}
					</td>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.corpId')</td>
                    <td>
                        $!{nisPersonnelDetailPage.corpName}
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.deptName')</td>
                    <td>
						$!{nisPersonnelDetailPage.deptName}
					</td>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.cardType')</td>
                    <td>
						$dictTag.get("nisPersonnelDetail.cardType", $!{nisPersonnelDetailPage.cardType})
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.bankAcc')</td>
                    <td>
						$!{nisPersonnelDetailPage.bankAcc}
					</td>
					<td class="textRight">#springMessage('table.btBankAcc.bankCode')</td>
					<td>
						$!{nisPersonnelDetailPage.bankCode}
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.accName')</td>
                    <td>
						$!{nisPersonnelDetailPage.accName}
					</td>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.bankName')</td>
					<td>
						$!{nisPersonnelDetailPage.bankName}
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.bifCode')</td>
					<td>
						$!{nisPersonnelDetailPage.bifName}
					</td>
					<td class="textRight"></td>
					<td>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.prov')</td>
                    <td>
						$!{nisPersonnelDetailPage.provName}
					</td>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.city')</td>
                    <td>
						$!{nisPersonnelDetailPage.cityName}
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.rmk')</td>
                    <td colspan="3">
						$!{nisPersonnelDetailPage.rmk}
					</td>
				</tr>
            </tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
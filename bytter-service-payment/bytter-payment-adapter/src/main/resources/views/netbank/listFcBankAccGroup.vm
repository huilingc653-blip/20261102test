<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight">#springMessage('fcBankAccGroup.code')</td>
					<td>
                        <input type="text" name="likes_accGroupCode" autocomplete="off" class="layui-input" placeholder="#springMessage('fcBankAccGroup.code')">
                    </td>
					<td class="textRight">#springMessage('fcBankAccGroup.name')</td>
					<td>
                        <input type="text" name="likes_accGroupName" autocomplete="off" class="layui-input" placeholder="#springMessage('fcBankAccGroup.name')">
                    </td>
                    <td class="textRight">#springMessage('fcBankAccGroup.operation.area')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="hidden" name="likes_areaCodes" id="areaCodes">
                            <input type="text" name="areaNames" readonly="readonly" autocomplete="off" class="layui-input" placeholder="营运区" id="areaNames"/>
                            <div class="bt-div-search">
                                <button  type="button" title="选择" id="inputOperationareaBtn">
                                    <span class="iconfont byicon_box_search"></span>
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
    			<tr >
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('fcBankAccGroup.code')</th>
                <th>#springMessage('fcBankAccGroup.name')</th>
                <th>#springMessage('fcBankAccGroup.operation.area')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','datatable','dicts', 'btImport'], function(){
        var $ = bt.jquery,form = bt.form();
        // var inputOperationarea = bt.inputOperationarea.init();
        bt.dicts.init();
        var inputOperationareaSearchLayerIndex = null;
        $("#inputOperationareaBtn").click(function (){
            inputOperationareaSearchLayerIndex = parent.layer.open({
                type: 2,
                area: ['850px', '620px'],
                maxmin: true,
                content: basePath + "/sys/operationArea/selectPage",
            })
        })

        //生成列表
        bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            query: "search",
            checkbox:false,
            order: [[0,'asc']],
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath+"/netbank/bankAccGroup/datatable"
            },
            buttons: [
                {
                    text: bt.lang('common.button.add'),
                    action: function ( e, dt, node, config ) {
                        add();
                    }
                },{
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                },{
                    text: bt.lang('common.button.imports'),
                    hide:bt.isnotResource('netbank:bankaccgroup:apply'),
                    action: function ( e, dt, node, config ) {
                        importExcel();
                    }
                }
            ]
            ,columns: [
                {data:"accGroupCode",bSortable:true,className:"center"},
                {data:"accGroupName",bSortable:true},
                {data:"areaNames",bSortable:true},
                {
                    data: null, bSortable: false, className: 'center',
                    render: function (data, type, full, meta) {
                        var html = '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a>';
                        html += '<span class="text-explode">|</span>';
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="update(this)">' + bt.lang("common.button.edit") + '</a>';
                        html += '<span class="text-explode">|</span><a class="" href="#" data-row="' + meta.row + '" onclick="del(this)">' + bt.lang("common.button.delete") + '</a>';
                        return html;
                    }
                }
            ]
        });

        function add(){
            // parent.layer.open({
            //     type: 2,
            //     area: ['850px', '500px'],
            //     maxmin: true,
            //     content: basePath + "/netbank/bankAccGroup/add",
            //     end:function(){
            //         bt.navtab.refreshCurrentTable();
            //     }
            // });

            bt.navtab.addNavtab('银行账户组新增',basePath + "/netbank/bankAccGroup/add")
        }

        view = function (el) {
            var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
            parent.layer.open({
                type: 2,
                area: ['850px', '530px'],
                maxmin: true,
                content: basePath + "/netbank/bankAccGroup/view/" + data.id
            });
        }

        update = function (el){
            var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();


            bt.navtab.addNavtab('银行账户组修改',basePath + "/netbank/bankAccGroup/update/"  + data.id)


            // parent.layer.open({
            //     type: 2,
            //     area: ['850px', '500px'],
            //     maxmin: true,
            //     content: basePath + "/netbank/bankAccGroup/update/"  + data.id,
            //     end:function(){
            //         bt.navtab.refreshCurrentTable();
            //     }
            // });
        }

        del = function (el){
            var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
            parent.layer.confirm(bt.lang('common.message.confirm.delete'), function () {
                $.post(basePath + "/netbank/bankAccGroup/delete/" + data.id, function (result) {
                    parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}, function () {
                        parent.layer ? parent.layer.closeAll() : layer.closeAll();
                        if (result.success) {
                            bt.datatable.refreshCurrentPage();
                        }
                    });
                }, 'JSON');
            });
        }

        /**
         * 导入功能
         */
        importExcel = function () {
            up = bt.btImport.init({
                code: "10000086",
                titleRows: 0,
                width: "100%",
                height: "100%",
                headRows: 1,
                success: function (head, data, select) {
                    $.ajax({
                        type: "POST",
                        url: basePath + "/netbank/bankAccGroup/saveImport",
                        dataType: "json",
                        contentType: "application/json",
                        data: JSON.stringify(up.getSelectData()),
                        success: function (result) {
                            bt.datatable.refreshCurrentPage();
                            parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                        }
                    });
                }
            });
        };

        inputOperationAreaCallback = function (selectedData) {
            console.log(selectedData);
            var codes = ''
            var names = ''
            bt.each(selectedData,function (i,item){
                codes += item.operationAreaCode
                names += item.operationAreaName
                if(i < (selectedData.length -1)){
                    codes += ',';
                    names += ','
                }
            })
            $("#areaCodes").val(codes)
            $("#areaNames").val(names)
            inputOperationareaSearchLayerIndex && parent.layer.close(inputOperationareaSearchLayerIndex)
        }
    });
</script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<input id="opType" name="opType" type="hidden" value="listExecute">
		<table class="layui-table">
            <tbody>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                    <td>
                        <div class="layui-inline">
                        	<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-tree-type="check"
                            data-name="ins_corpId"
                            data-scope="all"
							data-resource="netbank:netBank:nisBillHead:executeQuery"></div>
                        </div>
                    </td>
    				##付款单号
                    <td class="textRight">#springMessage('table.nisBillhead.billNo')</td>
                    <td>
                        <input type="text" name="likes_billNo"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.billNo')">
                    </td>
                    ##金额
                    <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="geg_payMoney"
								autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-input-inline">
                            <input type="text" name="leg_payMoney"
                                autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                        </div>
                    </td>
                </tr>
				<tr>
    				##收款账号
                    <td class="textRight">#springMessage('table.nisBillhead.payeeAcc')</td>
                    <td>
                        <input type="text" name="likes_payeeAcc"
                            autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.nisBillhead.payeeAcc')">
                    </td>
					##收款人
                    <td class="textRight">#springMessage('table.nisBillhead.payeeAccName')</td>
                    <td>
                        <input type="text" name="likes_payeeAccName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payeeAccName')">
                    </td>
                    ##期望支付日期
                    <td class="textRight">#springMessage('table.nisBillhead.wishPayday')</td>
                    <td>
                        <input type="text" name="ged_wishPayday" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_wishPayday" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_wishPayday" class="layui-input bt-input-inline bt-biz-dateType" id="led_wishPayday">
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisBillhead.billNo')</th>
        <th>#springMessage('table.nisBillhead.corpId')</th>
        <th>#springMessage('table.nisBillhead.voucherTypeId')</th>
        <th>#springMessage('table.nisBillhead.payerAcc')</th>
        <th>#springMessage('table.nisBillhead.payerAccName')</th>
        <th>#springMessage('table.nisBillhead.payerBank')</th>
        <th>#springMessage('table.nisBillhead.curId')</th>
        <th>#springMessage('table.nisBillhead.payMoney')</th>
        <th>#springMessage('table.nisBillhead.bankAcc')</th>
        <th>#springMessage('table.nisBillhead.bankAccName')</th>
        <th>#springMessage('table.nisBillhead.downBankAcc')</th>
        <th>#springMessage('table.nisBillhead.downAccName')</th>
        <th>#springMessage('table.nisBillhead.payeeAcc')</th>
        <th>#springMessage('table.nisBillhead.payeeAccName')</th>
        <th>#springMessage('table.nisBillhead.payeeBankCode')</th>
        <th>#springMessage('table.nisBillhead.payeeBank')</th>
        <th>#springMessage('table.nisBillhead.wishPayday')</th>
        <th>#springMessage('table.nisBillhead.busType')</th>
        <th>#springMessage('table.nisBillhead.bursarBillNo')</th>
        <th>#springMessage('table.nisBillhead.purpose')</th>
        <th>#springMessage('table.nisBillhead.addWord')</th>
        <th>#springMessage('table.nisBillhead.billFrom')</th>
        <th>#springMessage('table.nisBillhead.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/netbank/nisBillhead.listExecute.js?_btv=${resourceVersion}"></script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="refundStrategyForm">
    ##电子回单唯一标识
    <input type="hidden" name="receiptOnlyId" id="receiptOnlyId" value="BIS_EBILL_NO"/>
    ##付款单唯一标识
    <input type="hidden" name="billOnlyId" id="billOnlyId" value="BIS_DTL_NO"/>
    ##银行流水唯一标识
    <input type="hidden" name="dtlOnlyId" id="dtlOnlyId" value=""/>
    ##银行流水唯一标识
    <input type="hidden" name="type" id="type" value="2"/>
    <table class="layui-table breakRow">
        <tbody>
        <tr>
            ##银行类型
            <td class="textRight" width="15%">#springMessage('table.eBankBill.bankType')</td>
            <td width="28%">
                <div class="layui-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json" data-method="get"
                         data-valuefield="id" data-textfield="typeName" data-required="true"
                         data-name="bankTypeId" data-inputvalue="inputvalue"
                         data-search="true"
                         data-biz-name="bankTypeId"></div>
                </div>
            </td>
            ##策略类型
            <td class="textRight" width="15%">#springMessage('table.btwarnstrategy.name')</td>
            <td width="42%">
                #springMessage('table.bisBankExecution.refund')
            </td>
        </tr>

            <tr>
                ##是否存在唯一标识
                <td class="textRight" >#springMessage('table.bisBankExecutionStrategy.unique')</td>
                <td>
                    <div class="bt-biz-dict"
                         data-type="radio"
                         data-group="sf_yn"
                         data-defaultvalue="0"
                         data-name="isExistId"
                         data-biz-name="isExistId"
                         data-disabled="true">
                    </div>
                </td>
                ##优先执行排序
                <td class="textRight">#springMessage('table.receipt.execute.sort')</td>
                <td >
                    <input type="text"
                           id="executeSort"
                           lay-verify="required|number"
                           name="executeSort"
                           data-min="1"
                           data-maxlength="40"
                           data-decimal="0"
                           autocomplete="off"
                           class="layui-input bt-biz-moneyType"
                    >
                </td>
            </tr>
        <tr  id="rulesa">
            ##执行规则
            <td  class="textRight">#springMessage('table.receipt.rules')</td>
            <td style="text-align: left;" colspan="3">
                <div class="bt-biz-dict"
                     data-type="checkbox"
                     data-group="btPurpose.receiptRules"
                     data-name="rules"
                     data-biz-name="rules"
                     data-defaultvalue="$!{btPurpose.rules}"
                     data-displayData="corpId,amt,bankAcc,oppAccNo,accName,oppAccName,transTime,curId"
                     >
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('日期范围')</td>
            <td>
                <input type="text" id="transDays" name="transDays" style="text-align:right" data-decimal='0'
                       class="layui-input bt-biz-moneyType"   data-minus='false' data-maxlength='10'>
            </td>
            ##启用标志
            <td class="textRight">#springMessage('table.fcCompareCheckType.validSign')</td>
            <td >
                <div class="bt-biz-dict "
                     data-required="true"
                     data-type="radio"
                     data-group="fcCorpPool.status"
                     data-defaultvalue="1"
                     data-name="isEnable"
                     data-biz-name="isEnable">
                </div>
            </td>
        </tr>

        <tr >
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>

        </tbody>
    </table>
    <table class="layui-table layui-table-border"  id="matchContentTable">
        <tr style="background:#c6c6c6;">
            <td colspan="7">#springMessage('table.netbank.nisproject.matchContent')</td>
        </tr>
        <tr>
            <td class="textCenter" width="10%">#springMessage('table.bvPrintMatchRule.matchRule')</td>
            <td class="textCenter" width="5%">#springMessage('table.symbol.brackets')</td>
            <td class="textCenter" width="10%">#springMessage('table.netbank.nisproject.matchAttr')</td>
            <td class="textCenter" width="10%">#springMessage('table.netbank.nisproject.matchRelation')</td>
            <td class="textCenter" width="10%">#springMessage('table.netbank.nisproject.matchContent')</td>
            <td class="textCenter" width="5%">#springMessage('table.symbol.brackets')</td>
            <td class="textCenter" width="10%">#springMessage('common.table.thead.operation')</td>
        </tr>
        <tr row="1">
            <td class="textCenter">
                <input type="hidden" name="matchRule" value=" "/>
            </td>
            <td class="textCenter">
                <div class="layui-input-inline">
                    <select name="leftParenthesis"   data-search="false" data-inputvalue="true">
                        <option value=" ">#springMessage('common.placeholder.select')</option>
                        <option value="(">(</option>
                    </select>
                </div>
            </td>
            <td class="textCenter">
                <div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchElements"  data-name="matchElements" data-biz-name="matchElements1" data-filterData="bankAcc,accName,oppAccNo,oppAccName,curId,corpId,postscript,amt"  data-callback="onchangeMatchElements"></div>
            </td>
            <td class="textCenter">
                <div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchRelations"  data-name="matchRelations"  data-biz-name="matchRelations1" data-filterData="5,6,7,8,9,10" data-callback="onchangeMatchRelations"></div>
            </td>
            <td class="textCenter">
                <input type="text" name="matchContent" id="matchContent1"  placeholder="#springMessage('table.netbank.nisproject.matchContent')" autocomplete="off" class="layui-input"
                       lay-verify="strlength" data-maxlength="100">
                <div class="layui-input-inline" id="number1" style="display: none;">
                    <select  lay-search="" data-inputvalue="true" >
                        <option value="1">#springMessage('table.number.odd')</option>
                        <option value="2">#springMessage('table.number.even')</option>
                    </select>
                </div>
            </td>
            <td class="textCenter">
                <div class="layui-input-inline">
                    <select name="rightParenthesis"   data-search="false" data-inputvalue="true">
                        <option value=" ">#springMessage('common.placeholder.select')</option>
                        <option value=")">)</option>
                    </select>
                </div>
            </td>
            <td class="textCenter">
                <button class="layui-btn" onclick="addTr();" type="button">#springMessage('common.addTr')</button>
            </td>
        </tr>
    </table>
    <div>
        <span id="point" >
            <p style="color:#ff0000">#springMessage('table.bisBankExecutionStrategy.point')</p>
            <span style="color:red">#springMessage('table.bisBankExecutionStrategy.refund.point')</span><br>
        </span>
    </div>
</form>

    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/refundStrategy.add.js?_btv=${resourceVersion}"></script>
</html>

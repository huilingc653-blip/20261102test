<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body {
            font-size: 14px;
            padding-bottom: 60px;
        }

        .layui-form-label {
            width: 180px;
        }

        .layui-input-block {
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.wage.param.titile.usually')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## 制单人显示
                        <td class="textRight">#springMessage('config.nis.creator')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="wage.creator"
                                     data-biz-name="wage.creator" data-value="$!{config.wage.creator}"
                                     data-defaultvalue="1"></div>
                            </div>
                            <div class="layui-input-inline">
                                <i id="creator-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 是否显示明细金额
                        <td class="textRight">#springMessage('config.nis.wagesVerify')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                     data-name="wage.wagesVerify"
                                     data-biz-name="wage.wagesVerify" data-value="$!{config.wage.wagesVerify}"
                                     data-defaultvalue="0" data-callback="wagesVerifyCallBack"></div>
                            </div>
                            <div class="layui-input-inline">
                                <i id="wagesVerify-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('工资生成需求清单日')</td>
                        <td>
                            <input type="text"  name="wage.demandDate" value="15" lay-verify="required|langKey|strlength" data-maxlength="2" autocomplete="off" class="layui-input" >
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.wage.param.titile.budget')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## 是否挂接资金计划
                        <td width="20%" class="textRight">#springMessage('config.nis.budgetSel')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="wage.budgetSel"
                                 data-biz-name="wage.budgetSel" data-value="$!{config.wage.budgetSel}"
                                 data-defaultvalue="0"></div>
                        </td>
                    </tr>
                    <tr>
                        ## 默认计划科目
                        <td class="textRight">#springMessage('config.exp.payItem')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="wage.payItem" autocomplete="off" class="layui-input"
                                       value="$!{config.wage.payItem}">
                            </div>
                            ## <div class="layui-input-inline" style="color:red">#springMessage('config.nis.payItem.desc')</div>
                            <div class="layui-input-inline">
                                <i id="payItem-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.wage.param.titile.warnstrategy')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## 银行账户余额不足提醒(支付)
                        <td class="textRight">#springMessage('config.wage.bankaccOver')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="wage.bankaccOver" value="0" #if($config.wage.bankaccOver == 0)checked#end title="#springMessage('config.nis.noprompt')">
                                <input type="radio" name="wage.bankaccOver" value="1" #if($config.wage.bankaccOver == 1)checked#end title="#springMessage('config.nis.promptnocontrol')">
                                <input type="radio" name="wage.bankaccOver" value="2" #if($config.wage.bankaccOver == 2)checked#end title="#springMessage('config.nis.control')">
                            </div>
                            <div class="layui-input-inline">
                                <i id="bankaccOver-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 银行账户余额不足提醒(审批)
                        <td class="textRight">#springMessage('config.wage.bankaccOverApprove')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="wage.bankaccOverApprove" value="0" #if($config.wage.bankaccOverApprove == 0)checked#end title="#springMessage('config.nis.noprompt')">
                                <input type="radio" name="wage.bankaccOverApprove" value="1" #if($config.wage.bankaccOverApprove == 1)checked#end title="#springMessage('config.nis.promptnocontrol')">
                                <input type="radio" name="wage.bankaccOverApprove" value="2" #if($config.wage.bankaccOverApprove == 2)checked#end title="#springMessage('config.nis.control')">
                            </div>
                            <div class="layui-input-inline">
                                <i id="bankaccOverApprove-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="20%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form', 'jquery', 'dicts', 'element'], function () {
        var form = bt.form(), $ = bt.jquery;
        bt.element();
        //监听提交
        form.on('submit(configSubmit)', function (data) {
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, "JSON");
            return false;
        });
        wagesVerifyCallBack = function (data) {
            wagesVerifyCallBackView();
        };
        var dicts = bt.dicts.init();

        function wagesVerifyCallBackView() {
            var wagesVerify = dicts.get("wage.wagesVerify").val();
            if (wagesVerify == 1) {
                dicts.get("wage.creator").attr({
                    'data-disabledValue': '0',
                    'value': '1',
                });
            } else {
                dicts.get("wage.creator").attr({
                    'data-disabledValue': ''
                });
            }
            dicts.render();
        }

        // 说明显示隐藏
        showDesc();
    });

    function showDesc() {
        var tip_index1 = 0;
        $('#creator-desc').mouseenter(function () {
            tip_index1 = layer.tips(bt.lang('config.nis.creator.desc'), '#creator-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index1);
        });

        var tip_index2 = 0;
        $('#wagesVerify-desc').mouseenter(function () {
            tip_index2 = layer.tips(bt.lang('config.nis.wagesVerify.desc'), '#wagesVerify-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index2);
        });

        var tip_index3 = 0;
        $('#payItem-desc').mouseenter(function () {
            tip_index3 = layer.tips(bt.lang('config.nis.payItemBudgetSel.desc'), '#payItem-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index3);
        });

        var tip_index4 = 0;
        $('#bankaccOver-desc').mouseenter(function () {
            tip_index4 = layer.tips(bt.lang('config.wage.bankaccOver.desc'), '#bankaccOver-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index4);
        });

        var tip_index5 = 0;
        $('#bankaccOverApprove-desc').mouseenter(function () {
            tip_index5 = layer.tips(bt.lang('config.wage.bankaccOverApprove.desc'), '#bankaccOverApprove-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index5);
        });
    }
</script>
</body>
</html>

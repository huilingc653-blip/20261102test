<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">

    <input id="id" name="id"  type = "hidden" value="$!{bisBankExecutionStrategy.id}">
    <input id="createDate" name="createDate" type = "hidden" value="$!{bisBankExecutionStrategy.createDate}">
    <input id="createBy" name="createBy" type = "hidden" value="$!{bisBankExecutionStrategy.createBy}">
    ##电子回单唯一标识
    <input type="hidden" name="receiptOnlyId" id="receiptOnlyId" value="$!{bisBankExecutionStrategy.receiptOnlyId}"/>
    ##付款单唯一标识
    <input type="hidden" name="billOnlyId" id="billOnlyId" value="$!{bisBankExecutionStrategy.billOnlyId}"/>
    ##银行流水唯一标识
    <input type="hidden" name="dtlOnlyId" id="dtlOnlyId" value="$!{bisBankExecutionStrategy.dtlOnlyId}"/>
    <table class="layui-table breakRow">
        <tbody>
        <tr>
            ##银行类型
            <td class="textRight" width="15%">#springMessage('table.eBankBill.bankType')</td>
            <td width="30%">
                <input id="bankTypeId" name="bankTypeId"  type = "hidden" value="$!{bisBankExecutionStrategy.bankTypeId}">
                $!{bisBankExecutionStrategy.bankTypeName}
            </td>
            ##策略类型
            <td class="textRight" width="15%">策略类型</td>
            <td width="40%">
                <input id="type" name="type"  type = "hidden" value="$!{bisBankExecutionStrategy.type}">
                $dictTag.get('bank.strategy',$!{bisBankExecutionStrategy.type})
            </td>
        </tr>

        <tr>
            ##是否存在唯一标识
            <td class="textRight" >#springMessage('table.bisBankExecutionStrategy.unique')</td>
            <td>
                <input type="hidden" id="isExistId" value="$!{bisBankExecutionStrategy.isExistId}"/>
                <div class="bt-biz-dict"
                     data-required="true"
                     data-type="radio"
                     data-group="sf_yn"
                     data-defaultvalue="$!{bisBankExecutionStrategy.isExistId}"
                     data-name="isExistId"
                     data-callback="toRegular"
                     data-biz-name="isExistId">

                </div>
            </td>
            ##策略执行优先级
            <td class="textRight">#springMessage('table.receipt.execute.sort')</td>
            <td >
                <input type="text"
                       id="executeSort"
                       lay-verify="required|number"
                       name="executeSort"
                       data-min="1"
                       data-decimal="0"
                       data-maxlength="40"
                       autocomplete="off"
                       value="$!{bisBankExecutionStrategy.executeSort}"
                       class="layui-input"
                >
            </td>
        </tr>
        <tr style="display: none" id="bisDtlNo">
            ##付款单唯一标识
            <td class="textRight">#springMessage('table.receipt.payUnique')</td>
            <td>
                <div class="bt-biz-dict "
                     data-required="true"
                     data-type="select"
                     data-group="bisBankExecutionStrategy.payUnique"
                     data-defaultvalue="$!{bisBankExecutionStrategy.billOnlyId}"
                     data-name="billOnlyIdSel"
                     data-biz-name="billOnlyIdSel">
                </div>
            </td>
            ##银行流水唯一标识
            <td class="textRight">#springMessage('table.receipt.bankUnique')</td>
            <td>
                <div class="bt-biz-dict "
                     data-required="true"
                     data-type="select"
                     data-group="bisBankExecutionStrategy.bankUnique"
                     data-defaultvalue="$!{bisBankExecutionStrategy.dtlOnlyId}"
                     data-name="dtlOnlyIdSel" data-filterData="BIS_EBILL_NO"
                     data-biz-name="dtlOnlyIdSel">
                </div>
            </td>
        </tr>
        <tr style="display: none" id="bisEbillNo">
            ##电子回单唯一标识
            <td class="textRight">#springMessage('table.bisBankExecutionStrategy.eReceiptUnique')</td>
            <td>
                <div class="bt-biz-dict "
                     data-required="true"
                     data-type="select"
                     data-group="bisBankExecutionStrategy.eReceiptUnique"
                     data-defaultvalue="$!{bisBankExecutionStrategy.receiptOnlyId}"
                     data-name="receiptOnlyIdSel"
                     data-biz-name="receiptOnlyIdSel">
                </div>
            </td>
            ##银行流水唯一标识
            <td class="textRight">#springMessage('table.receipt.bankUnique')</td>
            <td>
                <div class="bt-biz-dict "
                     data-required="true"
                     data-type="select"
                     data-group="bisBankExecutionStrategy.bankUnique"
                     data-defaultvalue="$!{bisBankExecutionStrategy.dtlOnlyId}"
                     data-name="dtlOnlyIdReceiptSel" data-filterData="BIS_DTL_NO"
                     data-biz-name="dtlOnlyIdReceiptSel">
                </div>
            </td>
        </tr>
        <tr >
            ##执行规则
            <td class="textRight" style="display: #if($!{bisBankExecutionStrategy.isExistId} == 1) none #end;" id="rulesa">#springMessage('table.receipt.rules')</td>
            <td style="display: #if($!{bisBankExecutionStrategy.isExistId} == 1) none #end;" id="rules" colspan="3" style="text-align: left;">
                <div class="bt-biz-dict"
                     data-type="checkbox"
                     data-group="btPurpose.receiptRules"
                     data-name="rules"
                     data-biz-name="rules"
                     data-required="#if($!{bisBankExecutionStrategy.isExistId} == 0)true#end"
                     data-defaultvalue="$!{bisBankExecutionStrategy.rules}"
                     data-callback="rulesCallback">
                </div>
                <input type="hidden" id="rulesDef" name="rulesDef" value="$!{bisBankExecutionStrategy.rules}">
            </td>
        </tr>
            #if($!{bisBankExecutionStrategy.rules.indexOf("transTime")} != -1)
            <tr id="transTimeRuleTr">
            #else
            <tr id="transTimeRuleTr" style="display: none">
            #end
            ##交易日期规则
            <td class="textRight">#springMessage('table.revenue.transTime')#springMessage('table.bvPrintMatchRule.matchRule')</td>
            <td colspan="3">
                <div class="layui-inline">
                    <div class="bt-biz-dict "
                         data-required="true"
                         data-type="radio"
                         data-group="bisBankExecutionStrategy.transTimeRule"
                         data-name="transTimeRule"
                         data-biz-name="transTimeRule"
                         data-callback="transTimeRuleCallback"
                        #if($!{bisBankExecutionStrategy.transDays})
                         data-defaultvalue="1"
                        #else
                         data-defaultvalue="0"
                        #end>
                    </div>
                </div>
                <div class="layui-inline" id="tranDaysDiv" #if(!$!{bisBankExecutionStrategy.transDays})style="display: none"#end>
                    <div class="layui-inline">
                        相差天数<font color="red">(<=)</font>
                    </div>
                    <div class="layui-inline">
                        <input type="text" name="transDays" data-name="transDays" data-biz-name="transDays" autocomplete="off" class="layui-input bt-biz-moneyType"
                               data-decimal="0" data-separator="" data-min="0" value="$!{bisBankExecutionStrategy.transDays}">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##启用标志
            <td class="textRight">#springMessage('table.fcCompareCheckType.validSign')</td>
            <td >
                <div class="bt-biz-dict "
                     data-required="true"
                     data-type="radio"
                     data-group="fcCorpPool.status"
                     data-defaultvalue="$!{bisBankExecutionStrategy.isEnable}"
                     data-name="isEnable"
                     data-biz-name="isEnable">

                </div>
            </td>
        </tr>
        <tr >
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <div>
      <span id="point" style="display: #if($!{bisBankExecutionStrategy.isExistId} == 0) none #end;">
        <p style="color:red">#springMessage('table.bisBankExecutionStrategy.point')</p>
        <span style="color:red">#springMessage('table.bisBankExecutionStrategy.pointtwo')</span><br>
        <span style="color:red">#springMessage('table.bisBankExecutionStrategy.pointThre')</span><br>
        <span style="color:red">#springMessage('table.bisBankExecutionStrategy.pointFour')</span>
      </span>
    </div>
</form>
<div>

</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/bisBankExecutionStrategy.update.js?_btv=${resourceVersion}"></script>
</html>

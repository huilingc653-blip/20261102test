<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input id="id" name="id" type="hidden" value="">
        <input id="corpId" name="corpId" type="hidden" value="$!{corpId}">
        <input id="voucherTypeId" name="voucherTypeId" type="hidden" value="$!{voucherType.id}">
		<!-- 付款方式相关属性 -->
		<input id="sysVoucherCode" name="sysVoucherCode" type="hidden" value="$!{voucherType.sysVoucherCode}">
		<input id="isAccount" name="isAccount" type="hidden" value="$!{voucherType.isAccount}">
		<!-- 付/收款账号相关属性 -->
		<input id="accId" name="accId" type="hidden" value="">
        <input id="curId" name="curId" type="hidden" value="">
		<input id="bifCode" name="bifCode" type="hidden" value="">
		<input id="payerBankCode" name="payerBankCode" type="hidden" value="">
		<input id="payerProv" name="payerProv" type="hidden" value="">
		<input id="payerCity" name="payerCity" type="hidden" value="">
		<table class="layui-table">
			<tbody>
				<tr>
					##付款账号
					<td class="textRight" width="40%">#springMessage('table.nisBillhead.payerAcc')</td>
					<td width="60%">
						<div class="layui-input-inline">
							<input type="text" id="payerAcc" name="payerAcc" lay-verify="required|tableData" data-biz-name="payerAcc"
								 autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.payerAcc')">
							<table id="payerAccTable" class="hide">
								<thead>
									<tr>
										<th>#springMessage('table.nisBillhead.payerAcc')</th>
										<th>#springMessage('table.nisBillhead.payerAccName')</th>
										<th>#springMessage('table.nisBillhead.payerBank')</th>
										<th>#springMessage('table.nisBillhead.curId')</th>
                                        <th>#springMessage('table.btBankAcc.isOnline')</th>
									</tr>
								</thead>
							</table>
						</div>
					</td>
				</tr>
                <tr>
                	##付款账号名称
                    <td class="textRight">#springMessage('table.nisBillhead.payerAccName')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" id="payerAccName" name="payerAccName" lay-verify="required" readonly="readonly" style="width:300px;"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payerAccName')">
                        </div>
                    </td>
                </tr>
				<tr>
					##付款开户行
					<td class="textRight">#springMessage('table.nisBillhead.payerBank')</td>
					<td>
						<div class="layui-input-inline">
							<input type="text" id="payerBank" name="payerBank" lay-verify="required" readonly="readonly" style="width:300px;"
								 autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payerBank')">
						</div>
					</td>
				</tr>
                <tr>
					##账户余额
                    <td class="textRight">#springMessage('table.nisBillhead.balance')</td>
                    <td>
                        <div id="balanceDiv" name="balanceDiv"></div>
                        <input type="hidden" id="balance" name="balance" style="text-align:right" readonly="readonly" data-name="balance" data-biz-name="balance"
                               autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.nisBillhead.balance')">
                    </td>
                </tr>
                <tr id="downAccDiv" style="display:none">
					##下拨账号
                    <td class="textRight">#springMessage('table.nisBillhead.bankAcc')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="hidden" id="downAccId" name="downAccId">
                            <input type="text" id="downAcc" name="downAcc" lay-verify="required|tableData" data-biz-name="downAcc"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.bankAcc')" >
                            <table id="downAccTable" class="hide">
                                <thead>
                                <tr>
                                    <th>#springMessage('table.btBankAcc.bankAcc')</th>
                                    <th>#springMessage('table.btBankAcc.accName')</th>
                                    <th>#springMessage('table.btBankAcc.bankName')</th>
                                    <th>#springMessage('table.nisBillhead.curId')</th>
                                </tr>
                                </thead>
                            </table>
                        </div>
                    </td>
                </tr>
                <tr id="downAccNameDiv" style="display:none">
					##下拨账号户名
                    <td class="textRight">#springMessage('table.nisBillhead.bankAccName')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" id="downAccName" name="downAccName" readonly="readonly" style="width:300px;"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.bankAccName')">
                        </div>
                    </td>
                </tr>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.confirm')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/netbank/nisBillheadPool.setPayerAcc.js?_btv=${resourceVersion}"></script>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcVoucherTypePage.id}">
		<input id="isSystem" name="isSystem" type="hidden" value="$!{fcVoucherTypePage.isSystem}">
        <table class="layui-table">
			<tbody >
				<tr >
					<td class="textRight" width="30%">#springMessage('fcVoucherType.voucherType')</td>
					<td>
						<input type="text" id="voucherType" name="voucherType" lay-verify="required|langKey|strlength" data-maxlength="2" data-minlength="2" readonly="readonly"
							autocomplete="off" class="layui-input" placeholder="#springMessage('fcVoucherType.voucherType')" value="$!{fcVoucherTypePage.voucherType}">
                    </td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.voucherName')</td>
					<td>
                        <div class="layui-inline">
							<input style="display: inline;" type="text" id="voucherName" name="voucherName" lay-verify="required|strlength" data-maxlength="20"
								autocomplete="off" class="layui-input" placeholder="#springMessage('fcVoucherType.voucherName')" value="$!{fcVoucherTypePage.voucherName}">
							<span data-toggle="i18n" data-key-id="$!{fcVoucherTypePage.id}"/>
						</div>
                    </td>
                </tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.sysVoucherCode')</td>
					<td >
						<input id="sysVoucherCodeDef" name="sysVoucherCodeDef" type="hidden" value="$!{fcVoucherTypePage.sysVoucherCode}">
						<div class="bt-biz-selectType" data-url="${basePath}/netbank/btpaytype/json" data-valuefield="sysVoucherCode" data-textfield="sysVoucherName"
							data-name="sysVoucherCode" data-value="$!{fcVoucherTypePage.sysVoucherCode}" data-callback="payTypeCallback"></div>
                    </td>
				</tr>
				#if($!{fcVoucherTypePage.sysVoucherCode} == "49")
				<tr  id="billSectionControlTr">
				#else
				<tr  id="billSectionControlTr" style="display: none">
				#end
					<td class="textRight">#springMessage('fcVoucherType.openBill.section.control')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="BILL_SECTION_CONTROL" id="billSectionControl"
							#if($!{fcVoucherTypePage.sysVoucherCode} == "49")
							 data-required="true"
							#end
							 data-defaultvalue="$!{fcVoucherTypePage.billSectionControl}"
							 data-name="billSectionControl" data-biz-name="billSectionControl"></div>
					</td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.cashTransSign')</td>
					<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="cashTransSign" data-defaultvalue="$!{fcVoucherTypePage.cashTransSign}"
                             data-name="cashTransSign" data-biz-name="cashTransSign"></div>
                    </td>
                </tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.settlType')</td>
					<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="settlType" data-defaultvalue="$!{fcVoucherTypePage.settlType}"
                             data-name="settlType" data-biz-name="settlType"></div>
                    </td>
				</tr>
				<tr style="display:none">
					<td class="textRight">#springMessage('fcVoucherType.isElectronPay')</td>
					<td>
						#if($!{fcVoucherTypePage.sysVoucherCode} == "34" || $!{fcVoucherTypePage.sysVoucherCode} == "05" || $!{fcVoucherTypePage.sysVoucherCode} == "04" 
							|| $!{fcVoucherTypePage.sysVoucherCode} == "49" || $!{fcVoucherTypePage.sysVoucherCode} == "50" || $!{fcVoucherTypePage.sysVoucherCode} == "06"
						|| $!{fcVoucherTypePage.sysVoucherCode} == "62" || $!{fcVoucherTypePage.sysVoucherCode} == "63")
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{fcVoucherTypePage.isElectronPay}"
							 data-name="isElectronPay" data-biz-name="isElectronPay" data-disabled="true"></div>
						#else
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{fcVoucherTypePage.isElectronPay}"
							 data-name="isElectronPay" data-biz-name="isElectronPay"></div>
						#end
                    </td>
                </tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.isAccount')</td>
					<td>
						#if($!{fcVoucherTypePage.sysVoucherCode} == "34" || $!{fcVoucherTypePage.sysVoucherCode} == "05" || $!{fcVoucherTypePage.sysVoucherCode} == "48"
							|| $!{fcVoucherTypePage.sysVoucherCode} == "49" || $!{fcVoucherTypePage.sysVoucherCode} == "50" || $!{fcVoucherTypePage.sysVoucherCode} == "06"
						|| $!{fcVoucherTypePage.sysVoucherCode} == "62" || $!{fcVoucherTypePage.sysVoucherCode} == "63")
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{fcVoucherTypePage.isAccount}"
							 data-name="isAccount" data-biz-name="isAccount" data-disabled="true"></div>
						#else
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{fcVoucherTypePage.isAccount}"
							 data-name="isAccount" data-biz-name="isAccount"></div>
						#end
                    </td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.isBudget')</td>
					<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{fcVoucherTypePage.isBudget}"
							 data-name="isBudget" data-biz-name="isBudget"></div>
                    </td>
                </tr>
				#if($!{fcVoucherTypePage.sysVoucherCode} == "34" || $!{fcVoucherTypePage.sysVoucherCode} == "02" || $!{fcVoucherTypePage.sysVoucherCode} == "33")
				<tr id="sendModeTr">
				#else
				<tr id="sendModeTr" style="display: none">
				#end
                    <td class="textRight">#springMessage('config.nis.bisExcAutoAccount')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="bisExc.sendMode" data-defaultvalue="$!{fcVoucherTypePage.sendMode}"
							 data-name="sendMode" data-biz-name="sendMode"></div>
                    </td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('fcVoucherType.validSign')</td>
					<td>
        				<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="$!{fcVoucherTypePage.validSign}"
							 data-name="validSign" data-biz-name="validSign"></div>
                    </td>
                </tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
					<td>
						<textarea placeholder="#springMessage('fcVoucherType.rmk')" lay-verify="strlength" data-maxlength="40"  class="layui-textarea" id="rmk" name="rmk" >$!{fcVoucherTypePage.rmk}</textarea>
                    </td>
				</tr>
    			<tr >
                    <td colspan="2" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/fcVoucherType.edit.js?_btv=${resourceVersion}"></script>
</html>

#parse("views/common/head.vm")
<table id="appTable" class="layui-table layui-form breakRow  dark-layui-table layui-table-border" style="width:100%;">
    <thead>
    <tr>
        <th width="120px" align="center">#springMessage('table.nisMessage.enrolDate')</th>
        <th  width="120px">#springMessage('table.nisMessage.op')</th>
        <th  width="120px">#springMessage('table.nisMessage.opName')</th>
        <th  width="120px">#springMessage('table.nisMessage.messageType')</th>
        <th>#springMessage('table.nisMessage.message')</th>
    </tr>
	</thead>
	#foreach($msg in $list)
	<tr>
		<td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{msg.enrolDate})</td>
		<td>
            #if($!{msg.messageType}!="37")
                $!{msg.op}
            #end
        </td>
		<td>
            #if($!{msg.messageType}!="37")
                $!{msg.opName}
            #end
        </td>
		<td>$dictTag.get("nisMessage.messageType",$!{msg.messageType})</td>
        <td>
            #if($!{msg.message} && $!{msg.message}!="")
                #springMessage($!{msg.message})
            #end
        </td>
	</tr>
	#end
</table>

<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{nisProjectPage.id}">
		<table class="layui-table">
			<tbody>
			<tr>
				##项目代码
				<td class="textRight" width="30%">#springMessage("table.netbank.nisproject.code")</td>
				<td>
					<input type="text" id="projectCode" name="projectCode" lay-verify="required|strlength|numberOrletter"
						   data-maxlength="10" autocomplete="off" class="layui-input">
				</td>
			</tr>
			<tr>
				##项目名称
				<td class="textRight">#springMessage("table.netbank.nisproject.name")</td>
				<td>
					<input type="text" id="projectName" name="projectName" lay-verify="required|strlength" data-maxlength="60"
						autocomplete="off" class="layui-input">
				</td>
			</tr>
			<tr>
				##收支标志
				<td class="textRight">#springMessage("table.netbank.nisproject.cdSign")</td>
				<td>
					<div class="bt-biz-dict" data-type="radio" data-group="btBankAccDtl.cdSign" data-defaultvalue="0" data-name="projectCdSign"
						  data-biz-name="projectCdSign" id="projectCdSign" data-callback="bt.projectCdSignCallback"></div>
				</td>
			</tr>
			<tr>
				##匹配要素
				<td class="textRight">#springMessage("table.netbank.nisproject.matchAttr")</td>
				<td>
                    <div class="bt-biz-dict" data-type="select" data-group="nisProject.matchAttr" data-default=" " data-name='matchAttr'
                          data-biz-name="matchAttr" id="matchAttr" data-required="true"></div>
				</td>
			</tr>
			<tr>
				##匹配内容
				<td class="textRight">#springMessage("table.netbank.nisproject.matchContent")</td>
				<td>
                    <textarea placeholder="#springMessage('table.netbank.nisproject.matchContent')" class="layui-textarea" rows=3 cols=20 lay-verify="strlength" data-maxlength="100"  id="matchContent" name="matchContent" ></textarea>
				</td>
			</tr>
            <tr>
			##匹配关系
                <td class="textRight">#springMessage("table.netbank.nisproject.matchRelation")</td>
                <td>
                    <div class="bt-biz-dict" data-type="radio" data-group="nisProject.matchRelation" data-defaultvalue="0" data-name="matchRelation"
                         data-biz-name="matchRelation" id="matchRelation"></div>
                </td>
            </tr>
			##排序
			<tr>
				<td class="textRight">#springMessage("common.message.sort")</td>
				<td>
                    <input type="text" id="projectSort" name="projectSort" lay-verify="required|strlength|number" data-maxlength="10"
                           autocomplete="off" class="layui-input" value="0">
				</td>
			</tr>
			##备注
			<tr>
				<td class="textRight">#springMessage("table.netbank.nisproject.rmk")</td>
                <td>
                    <textarea placeholder="#springMessage('table.erpDataType.rmk')" class="layui-textarea" rows=3 cols=20 lay-verify="strlength" data-maxlength="100"  id="rmk" name="rmk" ></textarea>
                </td>
			</tr>
			<tr>
				<td colspan="2" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallback">#springMessage('common.button.reset')</button>
				</td>
			</tr>
			</tbody>
		</table>
	</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisProject.add.js?_btv=${resourceVersion}"></script>
</html>
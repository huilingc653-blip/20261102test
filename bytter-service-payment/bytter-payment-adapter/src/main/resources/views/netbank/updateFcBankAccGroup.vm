<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcBankAccGroupPage.id}">
        <table class="layui-table">
			<tbody >
				<tr >
					<td class="textRight" width="30%">#springMessage('fcBankAccGroup.code')</td>
					<td>
						<input type="text" id="accGroupCode" name="accGroupCode" readonly autocomplete="off" class="layui-input" value="$!{fcBankAccGroupPage.accGroupCode}">
                    </td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcBankAccGroup.name')</td>
					<td>
						<input type="text"  id="accGroupName" name="accGroupName" autocomplete="off" class="layui-input" value="$!{fcBankAccGroupPage.accGroupName}">
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('fcBankAccGroup.operation.area')</td>
					<td>
						<div class="layui-input-inline">
							<input type="hidden" name="areaCodes" id="update_areaCodes">
							<input type="text" name="areaNames" readonly="readonly" autocomplete="off" class="layui-input" placeholder="营运区" id="update_areaNames" value="$!{fcBankAccGroupPage.areaNames}"/>
							<div class="bt-div-search">
								<button  type="button" title="选择" id="inputOperationareaBtn">
									<span class="iconfont byicon_box_search"></span>
								</button>
							</div>
						</div>
					</td>
				</tr>
    			<tr >
                    <td colspan="2" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
	bt.use(['form', 'layedit', 'selectType', 'dicts'], function () {
		var $ = bt.jquery, form = bt.form();

		var inputOperationareaSearchLayerIndex = null;
		$("#inputOperationareaBtn").click(function (){
			inputOperationareaSearchLayerIndex = parent.layer.open({
				type: 2,
				area: ['850px', '620px'],
				maxmin: true,
				content: basePath + "/sys/operationArea/selectPage",
			})
		})

		inputOperationAreaCallback = function (selectedData) {
			var codes = ''
			var names = ''
			bt.each(selectedData,function (i,item){
				codes += item.operationAreaCode
				names += item.operationAreaName
				if(i < (selectedData.length -1)){
					codes += ',';
					names += ','
				}
			})
			$("#update_areaCodes").val(codes)
			$("#update_areaNames").val(names)
		}

		//监听提交
		form.on('submit(submit)', function (data) {
			var action = "/netbank/bankAccGroup/modify";
			$.post(basePath + action, data.field, function (result) {
				parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}, function () {
					parent.layer.closeAll();
					// if (result.success) {
					// 	if (bt.navtab) {
					// 		bt.navtab.closeCurrent();
					// 	} else {
					// 		parent.layer ? parent.layer.closeAll() : layer.closeAll();
					// 	}
					// }
				})
			}, 'JSON');
			return false;
		});

	});


</script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tr>
                <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-tree-type="check"
                             data-type="selectTree"
                             data-name="ins_corpId"
                             data-scope="all"
                             data-biz-name="corpId"
                             data-resource="netbank:basicdata:niscorpbus:apply"
                             data-defaultvalue="$!{corpId}"></div>
                    </div>
                </td>
                <td class="textRight">#springMessage('nisBusType.busTypeName')</td>
                <td width="40%">
                    <input type="text" name="likes_busTypeName" autocomplete="off" class="layui-input" placeholder="#springMessage('nisBusType.busTypeName')">
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.nis_corp_bus.corp_id')</th>
            <th style="width: 90%">#springMessage('nisBusType.busTypeName')</th>
            <th style="width: 10%">#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisCorpBus.list.js?_btv=${resourceVersion}"></script>
</html>

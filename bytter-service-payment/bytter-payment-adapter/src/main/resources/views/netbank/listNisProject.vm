<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tr>
                <td class="textRight">#springMessage("table.netbank.nisproject.code")</td>
                <td width="40%">
                    <input type="text" name="likes_projectCode" autocomplete="off" class="layui-input">
                </td>
                <td class="textRight">#springMessage("table.netbank.nisproject.name")</td>
                <td width="40%">
                    <input type="text" name="likes_projectName" autocomplete="off" class="layui-input">
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage("table.netbank.nisproject.cdSign")</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="btBankAccDtl.cdSign" data-default="" data-name="likes_projectCdSign"></div>
                </td>
                <td class="textRight">#springMessage("table.netbank.nisproject.matchContent")</td>
                <td>
                    <input type="text" name="likes_matchContent" autocomplete="off" class="layui-input">
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width: 100%;">
        <thead>
        <tr>
            <th>#springMessage("table.netbank.nisproject.code")</th>
            <th>#springMessage("table.netbank.nisproject.name")</th>
            <th>#springMessage("table.netbank.nisproject.cdSign")</th>
            <th>#springMessage("table.netbank.nisproject.matchAttr")</th>
            <th>#springMessage("table.netbank.nisproject.matchContent")</th>
            <th>#springMessage("table.netbank.nisproject.matchRelation")</th>
            <th>#springMessage("common.message.sort")</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisProject.list.js?_btv=${resourceVersion}"></script>
</html>
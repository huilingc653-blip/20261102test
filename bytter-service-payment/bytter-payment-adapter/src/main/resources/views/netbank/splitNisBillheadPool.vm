<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane ignore-required-icon">
		<input id="id" name="id" type="hidden" value="$!{nisBillheadPage.id}">
		<input id="payerAcc" name="payerAcc" type="hidden" value="$!{nisBillheadPage.payerAcc}">
		<input id="payerAccName" name="payerAccName" type="hidden" value="$!{nisBillheadPage.payerAccName}">
		<input id="voucherName" name="voucherName" type="hidden" value="$!{nisBillheadPage.voucherName}">
		<input id="curName" name="curName" type="hidden" value="$!{nisBillheadPage.curName}">
		<input id="payeeAcc" name="payeeAcc" type="hidden" value="$!{nisBillheadPage.payeeAcc}">
		<input id="payeeAccName" name="payeeAccName" type="hidden" value="$!{nisBillheadPage.payeeAccName}">
		<input id="purpose" name="purpose" type="hidden" value="$!{nisBillheadPage.purpose}">
		<input id="curId" name="curId" type="hidden" value="$!{nisBillheadPage.curId}">
		<input id="settlType" name="settlType" type="hidden" value="$!{settlType}">
		<input id="payeeBank" name="payeeBank" type="hidden" value="$!{nisBillheadPage.payeeBank}">
		<!-- 系统参数 -->
		<input id="billNo" name="billNo" type="hidden" value="$!{nisBillheadPage.billNo}">
		<input id="corpId" name="corpId" type="hidden" value="$!{nisBillheadPage.corpId}">
		<input id="wishPayday" name="wishPayday" type="hidden" value="$!date.format('yyyy-MM-dd',$!{nisBillheadPage.wishPayday})">
		<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
		<input id="isBudget" name="isBudget" type="hidden" value="$!{isBudget}">
		<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
		<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
		<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
		<input id="busType" name="busType" type="hidden" value="$!{busType}">
		<input id="reportBudget" name="reportBudget" type="hidden" value="$!{reportBudget}">
		<table class="layui-table">
			<tbody>
			<tr>
        		##付款单号
				<td class="textRight">#springMessage('table.nisBillhead.billNo')</td>
				<td>$!{nisBillheadPage.billNo}</td>
				<td class="textRight"></td>
				<td>
					<div class="layui-input-inline">
                    </div>
				</td>				
        	</tr>
        	<tr>
        		##单位
				<td class="textRight" width="15%">#springMessage('table.nisBillhead.corpId')</td>
				<td width="30%">$!{nisBillheadPage.corpName}</td>
				##付款方式
				<td class="textRight" width="15%">#springMessage('table.nisBillhead.voucherTypeId')</td>
				<td width="40%">$!{nisBillheadPage.voucherName}</td>
        	</tr>
			<tr>
        		##付款账号
				<td class="textRight">#springMessage('table.nisBillhead.payerAcc')</td>
				<td>$!{nisBillheadPage.payerAcc}</td>
                ##收款账号
                <td class="textRight">#springMessage('table.nisBillhead.payeeAcc')</td>
                <td>$!{nisBillheadPage.payeeAcc}</td>
        	</tr>
            <tr>
            ##付款账号名称
                <td class="textRight">#springMessage('table.nisBillhead.payerAccName')</td>
                <td>$!{nisBillheadPage.payerAccName}</td>
            ##收款账号名称
                <td class="textRight">#springMessage('table.nisBillhead.payeeAccName')</td>
                <td>$!{nisBillheadPage.payeeAccName}</td>
            </tr>
			<tr>
        		##付款开户行
				<td class="textRight">#springMessage('table.nisBillhead.payerBank')</td>
				<td>$!{nisBillheadPage.payerBank}</td>
                ##收款开户行
                <td class="textRight">#springMessage('table.nisBillhead.payeeBank')</td>
                <td>$!{nisBillheadPage.payeeBankCode} $!{nisBillheadPage.payeeBank}</td>
        	</tr>
            <tr>
            ##币别
                <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
                <td>$!{nisBillheadPage.curName}</td>
            ##省市
                <td class="textRight"><div id="payeeAddrDiv">#springMessage('table.nisBillhead.payeeAddr')</div></td>
                <td>$!{nisBillheadPage.provName} $!{nisBillheadPage.cityName}</td>
            </tr>
			<tr id="downAccDiv" style="display:none">
        		##下拨账号
				<td class="textRight">#springMessage('table.nisBillhead.downAccId')</td>
				<td>$!{nisBillheadPage.downAccId}</td>
				<td class="textRight"></td>
				<td>
					<div class="layui-input-inline">
                    </div>
				</td>				
        	</tr>
			<tr>
        		##金额
				<td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
				<td>$!number.formatNumeric($!{nisBillheadPage.payMoney})</td>
				<td class="textRight"></td>
				<td></td>				
        	</tr>
			<tr>
        		##是否对私付款
				<td class="textRight">#springMessage('table.nisBillhead.isForindividual')</td>
				<td>$dictTag.get("sf_yn",$!{nisBillheadPage.isForindividual})</td>
				##期望支付日期
				<td class="textRight">#springMessage('table.nisBillhead.wishPayday')</td>
				<td>$!date.format('yyyy-MM-dd',$!{nisBillheadPage.wishPayday})</td>				
        	</tr>
			<tr id="difBankDiv">
        		##跨行标志
				<td class="textRight">#springMessage('table.nisBillhead.difBank')</td>
				<td>$dictTag.get("nisBillhead.difBank",$!{nisBillheadPage.difBank})</td>
				##地域标志
				<td class="textRight">#springMessage('table.nisBillhead.areaSign')</td>
				<td>$dictTag.get("nisBillhead.areaSign",$!{nisBillheadPage.areaSign})</td>				
        	</tr>
			<tr>
        		##加急标志
				<td class="textRight">#springMessage('table.nisBillhead.isQuick')</td>
				<td>$dictTag.get("sf_yn",$!{nisBillheadPage.isQuick})</td>
				##业务类别
				<td class="textRight">#springMessage('table.nisBillhead.busType')</td>
				<td>$!{nisBillheadPage.busTypeName}</td>				
        	</tr>
			<tr>
        		##会计凭证号
				<td class="textRight">#springMessage('table.nisBillhead.bursarBillNo')</td>
				<td>$!{nisBillheadPage.bursarBillNo}</td>
				##是否已开票
				#if($!{nisBillheadPage.sysVoucherCode} == "49")
					<td class="textRight">#springMessage('table.nisBillhead.isOpenBill')</td>
					<td>$dictTag.get("sf_yn",$!{nisBillheadPage.isOpenBill})</td>
				#else
					<td class="textRight"></td>
					<td></td>
				#end
        	</tr>
			<tr>
        		##用途
				<td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
				<td>$!{nisBillheadPage.purpose}</td>
				##附言
				<td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
				<td>$!{nisBillheadPage.addWord}</td>				
        	</tr>
			</tbody>
        </table>
		<!-- 资金计划 -->
		<div id="tagItemDetail"></div>
		<!-- 日志 -->
		<div id="tagMsg"></div>
		<!-- 附件上传 -->
		<input id="attachmentId" name="attachmentId" type="hidden" value="$!{nisBillheadPage.attachmentId}">
		<div id="uploader" class="layui-input-inline" style="width:100%"></div>
		<p>
		<table id="dataTable" class="layui-table layui-form table-border" style="width:100%;" >
			<thead>
				<tr>
					<th>#springMessage('table.nisBillhead.payerAcc')</th>
					<th>#springMessage('table.nisBillhead.payerAccName')</th>
					<th>#springMessage('table.nisBillhead.voucherTypeId')</th>
					<th>#springMessage('table.nisBillhead.curId')</th>
					<th>#springMessage('table.nisBillhead.payMoney')</th>
					<th>#springMessage('table.nisBillhead.payeeAcc')</th>
					<th>#springMessage('table.nisBillhead.payeeAccName')</th>
					<th>#springMessage('common.table.thead.operation')</th>
				</tr>
			</thead>
			<tbody>
				<tr row="0">
					<td>$!{nisBillheadPage.payerAcc}</td>
					<td>$!{nisBillheadPage.payerAccName}</td>
					<td>$!{nisBillheadPage.voucherName}</td>
					<td>$!{nisBillheadPage.curName}</td>
					<td align="center">
                        <input type="hidden" id="budget0" name="budget">
						<div class="layui-input-inline">
							#if($!{isBudget} == 1 && $!{budgetSel} == 1)
    						<input type="text" id="payMoney0" name="payMoney" lay-verify="required|number2" data-name="payMoney" onclick="$genOtherHtmlOpen('0')" value="0.00"
    						 autocomplete="off" class="layui-input bt-biz-moneyType" data-biz-name="payMoney0" data-callback="calItemMoney" readonly="readonly">
							#else
                                <input type="text" id="payMoney0" name="payMoney" lay-verify="required|number2" data-name="payMoney" onclick="$genOtherHtmlOpen('0')" value="0.00"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" data-biz-name="payMoney0" data-callback="calItemMoney">
							#end
						 </div>
					</td>
					<td>$!{nisBillheadPage.payeeAcc}</td>
					<td>$!{nisBillheadPage.payeeAccName}</td>
					<td></td>
				</tr>
				<tr row="1">
					<td>$!{nisBillheadPage.payerAcc}</td>
					<td>$!{nisBillheadPage.payerAccName}</td>
					<td>$!{nisBillheadPage.voucherName}</td>
					<td>$!{nisBillheadPage.curName}</td>
					<td align="center">
                        <input type="hidden" id="budget1" name="budget">
						<div class="layui-input-inline">
							<input type="text" id="payMoney1" name="payMoney" lay-verify="required|number2" data-name="payMoney" onclick="$genOtherHtmlOpen('1')" value="0.00"
							   autocomplete="off" class="layui-input bt-biz-moneyType" data-biz-name="payMoney1" data-callback="calItemMoney" >
						</div>
					</td>
					<td>$!{nisBillheadPage.payeeAcc}</td>
					<td>$!{nisBillheadPage.payeeAccName}</td>
					<td></td>
				</tr>
				<tr id="sumTr">
					<td colspan="4" align="right">#springMessage('table.datatable.total')</td>
                    <td><div id="sumPayMoney">0.00</div></td>
					<td colspan="3"></td>
				</tr>
			</tbody>
		</table>
		</div>
        <div class="layui-form-item layui-form-submit" id="buttonDiv">
            <div class="layui-input-block">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
				<button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage('common.button.reset')</button>
			</div>
		</div>	
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/netbank/nisBillheadPool.split.js?_btv=${resourceVersion}"></script>
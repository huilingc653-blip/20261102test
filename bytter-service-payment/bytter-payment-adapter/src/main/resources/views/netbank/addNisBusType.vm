<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" id="nisBusTypeForm">
		<input id="id" name="id" type="hidden" value="$!{nisBusTypePage.id}">
		<table class="layui-table">
			<tbody>
				<tr>
					##业务种类编码
					<td class="textRight" width="30%">#springMessage('nisBusType.busType')</td>
					<td>
						<input type="text" id="busType" name="busType" lay-verify="required|strlength" data-maxlength="80" autocomplete="off" class="layui-input"
							placeholder="#springMessage('nisBusType.busType')">
					</td>
				</tr>
				<tr>
					##业务种类名称
					<td class="textRight">#springMessage('nisBusType.busTypeName')</td>
					<td>
						<input type="text" id="busTypeName" name="busTypeName" lay-verify="required|strlength" data-maxlength="200" autocomplete="off" class="layui-input"
							placeholder="#springMessage('nisBusType.busTypeName')">
					</td>
				</tr>
				<tr>
					##收付款标志
					<td class="textRight" width="15%">#springMessage('nisBusType.cdSign')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="nisBusType.cdSign" data-defaultvalue="0" data-name="cdSign" data-biz-name="cdSign-dict" data-callback="getCdSign"></div>
					</td>
				</tr>
				<tr id="sysBusTypeTr">
					##对应系统业务类别
					<td class="textRight" width="15%">#springMessage('nisBusType.sysBusType')</td>
					<td>
						<div class="bt-biz-dict" data-type="select" data-group="SYS_BUS_TYPE"  data-name="sysBusType" data-biz-name="sysBusType" data-callback="getSysBusType"
							 data-filterData="1,2,3,15"></div>
					</td>
				</tr>
				<tr>
					##计划科目
					<td class="textRight" width="15%">#springMessage('nisBusType.itemCode')</td>
					<td>
						<div class="layui-input-inline">
							<div class="item-selectTree-normal"></div>
						</div>
					</td>
				</tr>
				<tr id="settleTypeTr">
					##结算类型
					<td class="textRight" width="15%">#springMessage('table.fbsBudgetProcess.settlType')</td>
					<td>
						<div class="bt-biz-dict" data-type="select" data-group="settlType"  data-name="settleType" data-biz-name="settleType" ></div>
					</td>
				</tr>
				<tr>
					<td class="textRight" width="15%">#springMessage('table.nisBusType.corpId')</td>
					<td>
						<div class="layui-inline">
							<div class="bt-biz-corp"
								 data-biz-type="corp"
								 data-tree-type="check"
								 data-type="selectTree"
								 data-name="corpId"
								 data-biz-name="corpId"
								 data-scope="all"
								 data-defaultvalue="$!{corpId}"
								 data-resource="netbank:basicdata:nisbustype:apply"
							></div>
						</div>
					</td>
				</tr>
				<tr>
					##有效标志
					<td class="textRight" width="15%">#springMessage('nisBusType.validSign')</td>
					<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="1" data-name="validSign" data-biz-name="validSign" ></div>
					</td>
				</tr>
				<tr id="matchContentTr" >
					##匹配规则
					<td colspan="2">
						<table class="layui-table layui-table-border" width="100%" id="matchContentTable">
							<tr style="background:#c6c6c6;">
								<td colspan="7">#springMessage('table.netbank.nisproject.matchContent')</td>
							</tr>
							<tr>
								<td class="textCenter" width="20%">#springMessage('table.bvPrintMatchRule.matchRule')</td>
								<td class="textCenter" width="5%">#springMessage('table.symbol.brackets')</td>
								<td class="textCenter" width="20%">#springMessage('table.netbank.nisproject.matchAttr')</td>
								<td class="textCenter" width="20%">#springMessage('table.netbank.nisproject.matchRelation')</td>
								<td class="textCenter" width="20%">#springMessage('table.netbank.nisproject.matchContent')</td>
								<td class="textCenter" width="5%">#springMessage('table.symbol.brackets')</td>
								<td class="textCenter" width="20%">#springMessage('common.table.thead.operation')</td>
							</tr>
							<tr row="1">
								<td class="textCenter">
									<input type="hidden" name="matchRule" value=" "/>
								</td>
								<td class="textCenter">
									<div class="layui-input-inline">
										<select name="leftParenthesis"   data-search="false" data-inputvalue="true">
											<option value=" ">#springMessage('common.placeholder.select')</option>
											<option value="(">(</option>
										</select>
									</div>
								</td>
								<td class="textCenter">
									<div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchElements"  data-name="matchElements" data-biz-name="matchElements1"  data-callback="onchangeMatchElements"></div>
								</td>
								<td class="textCenter">
									<div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchRelations"  data-name="matchRelations"  data-biz-name="matchRelations1" data-filterData="5,6,7,8" data-callback="onchangeMatchRelations"></div>
								</td>
								<td class="textCenter">
									<input type="text" name="matchContent" id="matchContent1"  placeholder="#springMessage('table.netbank.nisproject.matchContent')" autocomplete="off" class="layui-input"
										   lay-verify="strlength" data-maxlength="100">
									<div class="layui-input-inline" id="number1" style="display: none;">
										<select  lay-search="" data-inputvalue="true" >
											<option value="1">#springMessage('table.number.odd')</option>
											<option value="2">#springMessage('table.number.even')</option>
										</select>
									</div>
								</td>
								<td class="textCenter">
									<div class="layui-input-inline">
										<select name="rightParenthesis"   data-search="false" data-inputvalue="true">
											<option value=" ">#springMessage('common.placeholder.select')</option>
											<option value=")">)</option>
										</select>
									</div>
								</td>
								<td class="textCenter">
									<button class="layui-btn" onclick="addTr();" type="button">#springMessage('common.addTr')</button>
								</td>
							</tr>
						</table>
					</td>
				</tr>
				<tr>
					<td colspan="2" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisBusType.add.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
<div class="layui-collapse">
    <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('config.exp.param.titile.budget')</h2>
        <div class="layui-colla-content layui-show">
            <table class="layui-table breakRow">
                <thead>
                <tr>
                    <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                    <td width="80%">#springMessage('config.fbs.paramValue')</td>
                </tr>
                </thead>
                <tbody>
                <tr>
                    ## 是否挂接资金计划
                    <td width="20%" class="textRight">#springMessage('config.nis.budgetSel')</td>
                    <td width="80%">
                      <div class="layui-input-inline">
                            <input type="radio" name="exp.budgetSel" value="1" #if($config.exp.budgetSel == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                            <input type="radio" name="exp.budgetSel" value="0" #if($config.exp.budgetSel == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                       </div>
                        ## <div class="layui-input-inline" style="color:red">#springMessage('config.nis.ctl.expFbsin')</div>
                    </td>
                </tr>
                <tr>
                    ## 费用报销默认资金计划科目
                    <td width="20%" class="textRight">#springMessage('config.exp.payItemBudgetSel')</td>
                    <td width="80%">
                        <div class="layui-input-inline">
                            <input type="text" name="exp.payItem" autocomplete="off" class="layui-input" value="$!{config.exp.payItem}">
                        </div>
                        ## <div class="layui-input-inline" style="color:red">#springMessage('config.nis.payItem.desc')</div>
                        <div class="layui-input-inline">
                            <i id="payItem-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </td>
                </tr>
                <tr>
                    ## 报销计划挂接环节
                    <td width="20%" class="textRight">#springMessage('config.nis.expFbsin')</td>
                    <td width="80%">
                      <div class="layui-input-inline">
                        <input type="radio" name="exp.expFbsin" value="1" #if($config.exp.expFbsin == 1)checked#end title="#springMessage('config.nis.expFbsin.pool')">
                        <input type="radio" name="exp.expFbsin" value="0" #if($config.exp.expFbsin == 0)checked#end title="#springMessage('config.nis.expFbsin.enter')">
                      </div>
                        <div class="layui-input-inline">
                            <i id="expFbsin-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </td>
                </tr>
                <tr style="display:none">
                    <td width="20%" class="textRight">#springMessage('config.nis.payAccount')</td>
                    <td width="80%">
                      <div class="layui-input-inline">
                            <input type="radio" name="exp.payAccount" value="1" #if($config.exp.payAccount == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                            <input type="radio" name="exp.payAccount" value="0" #if($config.exp.payAccount == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                       </div>
                    </td>
                </tr>
                <tr style="display:none">
                    <td width="20%" class="textRight">#springMessage('config.nis.isAutoAccount')</td>
                    <td width="80%">
                      <div class="layui-input-inline">
                            <input type="radio" name="exp.isAutoAccount" value="1" #if($config.exp.isAutoAccount == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                            <input type="radio" name="exp.isAutoAccount" value="0" #if($config.exp.isAutoAccount == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                       </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('config.exp.param.titile.warnstrategy')</h2>
        <div class="layui-colla-content layui-show">
            <table class="layui-table breakRow">
                <thead>
                <tr>
                    <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                    <td width="80%">#springMessage('config.fbs.paramValue')</td>
                </tr>
                </thead>
                <tbody>
                <tr>
                    ## 银行账户余额不足提醒
                    <td width="20%" class="textRight">#springMessage('config.nis.bankaccOverType')</td>
                    <td width="80%">
                        <div class="layui-input-inline">
                            <input type="radio" name="exp.bankaccOver" value="0" #if($config.exp.bankaccOver == 0)checked#end title="#springMessage('config.nis.noprompt')">
                            <input type="radio" name="exp.bankaccOver" value="1" #if($config.exp.bankaccOver == 1)checked#end title="#springMessage('config.nis.promptnocontrol')">
                            <input type="radio" name="exp.bankaccOver" value="2" #if($config.exp.bankaccOver == 2)checked#end title="#springMessage('config.nis.control')">
                        </div>
                    </td>
                </tr>
                <tr>
                    ## 内部账户余额不足提醒
                    <td width="20%" class="textRight">#springMessage('config.nis.accountOverType')</td>
                    <td width="80%">
                        <div class="layui-input-inline">
                            <input type="radio" name="exp.accountOver" value="0" #if($config.exp.accountOver == 0)checked#end title="#springMessage('config.nis.noprompt')">
                            <input type="radio" name="exp.accountOver" value="1" #if($config.exp.accountOver == 1)checked#end title="#springMessage('config.nis.promptnocontrol')">
                            <input type="radio" name="exp.accountOver" value="2" #if($config.exp.accountOver == 2)checked#end title="#springMessage('config.nis.control')">
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<table class="layui-table border0">
    <tbody>
    <tr>
        <td width="20%"></td>
        <td>
            <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
       	 	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </td>
    </tr>
    </tbody>
</table>
</form>
#parse("views/common/footer.vm")
<script>
    bt.use(['form','jquery','element'], function(){
        var form = bt.form(),$  = bt.jquery;
		bt.element();
        //监听提交
        form.on('submit(configSubmit)', function(data){
            $.post(basePath + "/sys/config/save",data.field,function(result){
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },"JSON");
            return false;
        });

        // 说明显示隐藏
        showDesc();
    });

    function showDesc() {
        var tip_index1 = 0;
        $('#payItem-desc').mouseenter(function () {
            tip_index1 = layer.tips(bt.lang('config.nis.payItemBudgetSel.desc'), '#payItem-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index1);
        });

        var tip_index2 = 0;
        $('#expFbsin-desc').mouseenter(function () {
            tip_index2 = layer.tips(bt.lang('config.nis.expFbsin.desc'), '#expFbsin-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index2);
        });
    }
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight">#springMessage('fcVoucherType.voucherType')</td>
					<td width="40%">
                        <input type="text" name="likes_voucherType"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('fcVoucherType.voucherType')">
                    </td>
					<td class="textRight">#springMessage('fcVoucherType.voucherName')</td>
					<td width="40%">
                        <input type="text" name="likes_voucherName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('fcVoucherType.voucherName')">
                    </td>
                </tr>
    			<tr >
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('fcVoucherType.voucherType')</th>
            <th>#springMessage('fcVoucherType.voucherName')</th>
            <th>#springMessage('fcVoucherType.sysVoucherCode')</th>
            <th>#springMessage('fcVoucherType.cashTransSign')</th>
            <th>#springMessage('fcVoucherType.settlType')</th>
            <!--<th>#springMessage('fcVoucherType.isElectronPay')</th>-->
            <th>#springMessage('fcVoucherType.isAccount')</th>
            <th>#springMessage('fcVoucherType.isBudget')</th>
            <th>#springMessage('config.nis.bisExcAutoAccount')</th>
            <th>#springMessage('fcVoucherType.rmk')</th>
            <th>#springMessage('fcVoucherType.validSign')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/fcVoucherType.list.js?_btv=${resourceVersion}"></script>
</html>
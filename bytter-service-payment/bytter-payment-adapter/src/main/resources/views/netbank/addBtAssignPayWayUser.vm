<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab layui-tab-brief" lay-filter="paymentblending">
	<ul class="layui-tab-title" id="intTab">
		<li lay-id="inner1"  class="layui-this" onclick="pushTable('appTable')">#springMessage('table.fbsBudget.corpId')</li>
		<li lay-id="inner2" onclick="pushTable('userTable')">#springMessage('table.netbank.user')</li>
	</ul>
	<div class="layui-tab-content">
		<div class="layui-tab-item layui-show">
			<form class="layui-form" method="post" id="corpForm">
				<input type="hidden" id="id" name="id" value="$!{btAssignPayWayPage.id}">
				<input type="hidden" id="createBy" name="createBy" value="$!{btAssignPayWayPage.createBy}">
				<input type="hidden" id="createDate" name="createDate" value="$!{btAssignPayWayPage.createDate}">
				<input type="hidden" id="updateBy" name="updateBy" value="$!{btAssignPayWayPage.updateBy}">
				<input type="hidden" id="updateDate" name="updateDate" value="$!{btAssignPayWayPage.updateDate}">
				#foreach($corp in $corps.entrySet())
					<input type="hidden" id="${corp.value}" name="${corp.value}" value="${corp.value}" title="${corp.value}"/>
				#end
				<table class="layui-table breakRow">
					<tbody>
					<tr>
						<td class="textRight" width="20%"><span class="pl"><span class="required-icon">*</span></span>#springMessage('btAssignPayWay.corpId')</td>
						<td width="80%">
							<div class="layui-input-inline">
								<div class="bt-biz-corp"
									 data-biz-type="corp"
									 data-type="selectTree"
									 data-tree-type="check"
									 data-name="corpId"
									 data-scope="all" data-resource="netbank:basicdata:btassignpayway:apply"
									 data-defaultvalue="$!{corpId}"
									 data-callback="corpCallback"></div>
							</div>
						</td>
					</tr>
					<tr>
						<td class="textRight" width="20%">#springMessage('btAssignPayWay.voucherCode')</td>
						<td width="80%">
							<div class="layui-input-inline" style="padding-top: 10px;padding-bottom: 10px">
								<input type="checkbox" lay-skin="primary" title="#springMessage('common.check.all')" lay-filter="allChoose" />
								#foreach($type in $voucherTypes)
									<input type="checkbox" name="voucherCodes" lay-skin="primary" value="${type.id}" title="${type.voucherName}"/>
								#end
							</div>
						</td>
					</tr>
					<tr>
						<td class="textRight" width="20%">#springMessage('btAssignPayWay.defVoucherCode')</td>
						<td width="80%">
							<div class="layui-input-inline">
								<div class="bt-biz-selectType" data-url="${basePath}/netbank/fcvouchertype/json" data-biz-name="defVoucherCode"
									 data-valuefield="id" data-textfield="voucherName" data-name="defVoucherCode" data-search="true" defaultVal="$!{btAssignPayWayPage.defVoucherCode}"></div>
							</div>
						</td>
					</tr>
					<tr >
						<td colspan="4" style="text-align: center;">
							<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
							<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
						</td>
					</tr>
					</tbody>
				</table>
			</form>
			<table id="appTable" class="layui-table layui-form" style="width:100%;">
				<thead>
				<tr>
					<th>#springMessage('btAssignPayWay.corpId')</th>
					<th>#springMessage('btAssignPayWay.voucherCode')</th>
					<th>#springMessage('btAssignPayWay.defVoucherCode')</th>
				</tr>
				</thead>
			</table>
		</div>
		<div class="layui-tab-item">
			<form class="layui-form" method="post" id="userForm">
##				<input type="hidden" name="id" value="$!{btAssignPayWayPage.id}">
				<table class="layui-table breakRow">
					<tbody>
					<tr>
						<td class="textRight" width="20%">#springMessage('table.netbank.user')</td>
						<td width="80%">
							<div class="layui-inline">
								<div class="bt-biz-mulselectType" data-biz-name="userId" data-url="${basePath}/netbank/btassignpayway/getUserDTO" data-search="true"
									 data-valuefield="id" data-textfield="loginName" data-name="userId" data-callback="userIdcallback" data-required="true"></div>
							</div>
						</td>
					</tr>
					<tr>
						<td class="textRight">#springMessage('btAssignPayWay.voucherCode')</td>
						<td >
							<div class="layui-input-inline" style="padding-top: 10px;padding-bottom: 10px">
								<input type="checkbox" lay-skin="primary" title="#springMessage('common.check.all')" lay-filter="allChooseUser" />
								#foreach($type in $voucherTypes)
									<input type="checkbox" name="voucherCodesUser" lay-skin="primary" value="${type.id}" title="${type.voucherName}"/>
								#end
							</div>
						</td>
					</tr>
					<tr >
						<td colspan="4" style="text-align: center;">
							<button class="layui-btn" lay-submit="" lay-filter="submitUser" >#springMessage('common.button.save')</button>
							<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
						</td>
					</tr>
					</tbody>
				</table>
			</form>
			<table id="userTable" class="layui-table layui-form" style="width:100%;">
				<thead>
				<tr>
					<th>#springMessage('table.netbank.user')</th>
					<th>#springMessage('btAssignPayWay.voucherCode')</th>
				</tr>
				</thead>
			</table>
		</div>
	</div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/btAssignPayWayUser.add.js?_btv=${resourceVersion}"></script>
</html>

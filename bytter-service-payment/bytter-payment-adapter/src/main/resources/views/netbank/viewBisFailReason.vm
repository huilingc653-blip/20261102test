<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight" width="30%">#springMessage('table.bisFailReason.failCode')</td>
					<td>
						$!{bisFailReasonPage.failCode}
                    </td>
                </tr>
				<tr>
                    <td class="textRight">#springMessage('table.bisFailReason.failName')</td>
                    <td>
						$!{bisFailReasonPage.failName}
                    </td>
				</tr>
                <tr>
                    <td class="textRight">#springMessage('table.bisExc.bifCode')</td>
                    <td>
                        $!{bisFailReasonPage.bifName}
                    </td>
                </tr>
                <tr>
                    <td class="textRight">#springMessage('table.bisFailReason.keyWords')</td>
                    <td>
						$!{bisFailReasonPage.keyWords}
                    </td>
                </tr>
				<tr>
                    <td class="textRight">#springMessage('table.bisFailReason.actionCode')</td>
                    <td>
						$dictTag.get("bisFailReason.actionCode",$!{bisFailReasonPage.actionCode})
                    </td>
				</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
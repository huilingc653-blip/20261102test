<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="refundStrategyForm">

    <input id="id" name="id"  type = "hidden" value="$!{bisBankExecutionStrategy.id}">
    <input id="createDate" name="createDate" type = "hidden" value="$!{bisBankExecutionStrategy.createDate}">
    <input id="createBy" name="createBy" type = "hidden" value="$!{bisBankExecutionStrategy.createBy}">
    ##电子回单唯一标识
    <input type="hidden" name="receiptOnlyId" id="receiptOnlyId" value="$!{bisBankExecutionStrategy.receiptOnlyId}"/>
    ##付款单唯一标识
    <input type="hidden" name="billOnlyId" id="billOnlyId" value="$!{bisBankExecutionStrategy.billOnlyId}"/>
    ##银行流水唯一标识
    <input type="hidden" name="dtlOnlyId" id="dtlOnlyId" value="$!{bisBankExecutionStrategy.dtlOnlyId}"/>
    <input type="hidden" name="type" id="type" value="2"/>
    <table class="layui-table breakRow">
        <tbody>
        <tr>
            ##银行类型
            <td class="textRight" width="15%">#springMessage('table.eBankBill.bankType')</td>
            <td width="30%">
                <input id="bankTypeId" name="bankTypeId"  type = "hidden" value="$!{bisBankExecutionStrategy.bankTypeId}">
                $!{bisBankExecutionStrategy.bankTypeName}
            </td>
            ##策略类型
            <td class="textRight" width="15%">#springMessage('table.btwarnstrategy.name')</td>
            <td width="40%">
                #springMessage('table.bisBankExecution.refund')
            </td>
        </tr>

        <tr>
            ##是否存在唯一标识
            <td class="textRight" >#springMessage('table.bisBankExecutionStrategy.unique')</td>
            <td>
                <div class="bt-biz-dict"
                     data-type="radio"
                     data-group="sf_yn"
                     data-defaultvalue="$!{bisBankExecutionStrategy.isExistId}"
                     data-name="isExistId"
                     data-biz-name="isExistId"
                     data-disabled="true">

                </div>
            </td>
            ##策略执行优先级
            <td class="textRight">#springMessage('table.receipt.execute.sort')</td>
            <td >
                <input type="text"
                       id="executeSort"
                       lay-verify="required|number"
                       name="executeSort"
                       data-min="1"
                       data-decimal="0"
                       data-maxlength="40"
                       autocomplete="off"
                       value="$!{bisBankExecutionStrategy.executeSort}"
                       class="layui-input"
                >
            </td>
        </tr>
        <tr >
            ##执行规则
            <td class="textRight" style="display: #if($!{bisBankExecutionStrategy.isExistId} == 1) none #end;" id="rulesa">#springMessage('table.receipt.rules')</td>
            <td style="display: #if($!{bisBankExecutionStrategy.isExistId} == 1) none #end;" id="rules" colspan="3" style="text-align: left;">
                <div class="bt-biz-dict"
                     data-type="checkbox"
                     data-group="btPurpose.receiptRules"
                     data-name="rules"
                     data-biz-name="rules"
                     data-required="#if($!{bisBankExecutionStrategy.isExistId} == 0)true#end"
                     data-defaultvalue="$!{bisBankExecutionStrategy.rules}"
                     data-displayData="corpId,amt,bankAcc,oppAccNo,accName,oppAccName,transTime,curId"
                     >
                </div>
                <input type="hidden" id="rulesDef" name="rulesDef" value="$!{bisBankExecutionStrategy.rules}">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('日期范围')</td>
            <td>
                <input type="text" id="transDays" name="transDays" style="text-align:right" data-decimal='0'
                       class="layui-input bt-biz-moneyType" value="$!{bisBankExecutionStrategy.transDays}"   data-minus='false' data-maxlength='10'>
            </td>
            ##启用标志
            <td class="textRight">#springMessage('table.fcCompareCheckType.validSign')</td>
            <td >
                <div class="bt-biz-dict "
                     data-required="true"
                     data-type="radio"
                     data-group="fcCorpPool.status"
                     data-defaultvalue="$!{bisBankExecutionStrategy.isEnable}"
                     data-name="isEnable"
                     data-biz-name="isEnable">

                </div>
            </td>
        </tr>
        <tr >
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <table class="layui-table layui-table-border" width="100%" id="matchContentTable">
        <tr style="background:#c6c6c6;">
            <td colspan="7">#springMessage('table.netbank.nisproject.matchContent')</td>
        </tr>
        <tr>
            <td class="textCenter" width="20%">#springMessage('table.bvPrintMatchRule.matchRule')</td>
            <td class="textCenter" width="5%">#springMessage('table.symbol.brackets')</td>
            <td class="textCenter" width="20%">#springMessage('table.netbank.nisproject.matchAttr')</td>
            <td class="textCenter" width="20%">#springMessage('table.netbank.nisproject.matchRelation')</td>
            <td class="textCenter" width="20%">#springMessage('table.netbank.nisproject.matchContent')</td>
            <td class="textCenter" width="5%">#springMessage('table.symbol.brackets')</td>
            <td class="textCenter" width="20%">#springMessage('common.table.thead.operation')</td>
        </tr>
        #if(${length} > 0)
            #foreach($nisBusTypeRuleVO in $!{nisBusTypeRuleVOList})
                #set($row = $!{velocityCount})
                #if($!{velocityCount} == 1)
                    <tr row="$row">
                        <td class="textCenter">
                            <input type="hidden" name="matchRule" value=" "/>
                        </td>
                        <td class="textCenter">
                            <div class="layui-input-inline">
                                <select name="leftParenthesis"   data-search="false" data-inputvalue="true" data-value="$!{nisBusTypeRuleVO.leftParenthesis}">
                                    <option value=" ">#springMessage('common.placeholder.select')</option>
                                    #if($!{nisBusTypeRuleVO.leftParenthesis} =="(")
                                        <option value="(" selected>(</option>
                                    #else if
                                        <option value="(">(</option>
                                    #end
                                </select>
                            </div>
                        </td>
                        <td class="textCenter">
                            <div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchElements"  data-name="matchElements" data-biz-name="matchElements$row" data-defaultvalue="$!{nisBusTypeRuleVO.matchElements}" data-callback="onchangeMatchElements"></div>
                        </td>
                        <td class="textCenter">
                            <div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchRelations"  data-name="matchRelations" data-biz-name="matchRelations$row" data-defaultvalue="$!{nisBusTypeRuleVO.matchRelations}" data-callback="onchangeMatchRelations"
                                 #if($!{nisBusTypeRuleVO.matchElements} != "amt"))
                                 data-filterData="5,6,7,8,9,10"
                                 #end
                            ></div>
                        </td>
                        <td class="textCenter">
                            <input type="text" name="matchContent" id="matchContent$row"  placeholder="#springMessage('table.netbank.nisproject.matchContent')" autocomplete="off" class="layui-input" value="$!{nisBusTypeRuleVO.matchContent}"
                                   lay-verify="strlength" data-maxlength="100"
                                #if($!{nisBusTypeRuleVO.matchElements} == "amt"
                                && ($!{nisBusTypeRuleVO.matchRelations} == "1" || $!{nisBusTypeRuleVO.matchRelations} == "2"
                                || $!{nisBusTypeRuleVO.matchRelations} == "3" || $!{nisBusTypeRuleVO.matchRelations} == "4"))
                                   style="display: none;"#end>
                            <div class="layui-input-inline" id="number$row"
                                #if($!{nisBusTypeRuleVO.matchElements} != "amt" || ($!{nisBusTypeRuleVO.matchElements} == "amt"
                                && ($!{nisBusTypeRuleVO.matchRelations} == "5" || $!{nisBusTypeRuleVO.matchRelations} == "6"
                                || $!{nisBusTypeRuleVO.matchRelations} == "7" || $!{nisBusTypeRuleVO.matchRelations} == "8")))
                                 style="display: none;"#end>
                                <select  lay-search="" data-inputvalue="true" >
                                    <option value="1" #if($!{nisBusTypeRuleVO.matchContent} == "奇数") selected #end>#springMessage('table.number.odd')</option>
                                    <option value="2" #if($!{nisBusTypeRuleVO.matchContent} == "偶数") selected #end>#springMessage('table.number.even')</option>
                                </select>
                            </div>
                        </td>
                        <td class="textCenter">
                            <div class="layui-input-inline">
                                <select name="rightParenthesis"   data-search="false" data-inputvalue="true" data-value="$!{nisBusTypeRuleVO.rightParenthesis}">
                                    <option value=" ">#springMessage('common.placeholder.select')</option>
                                    #if($!{nisBusTypeRuleVO.rightParenthesis} ==")")
                                        <option value=")" selected>)</option>
                                    #else if
                                        <option value=")">)</option>
                                    #end
                                </select>
                            </div>
                        </td>
                        <td class="textCenter">
                            <button class="layui-btn" onclick="addTr();" type="button">#springMessage('common.addTr')</button>
                        </td>
                    </tr>
                #else
                    <tr row="$row">
                        <td class="textCenter">
                            <div class="bt-biz-dict" data-type="select" data-group="FUNDWARN_NUM_OPERATOR"  data-name="matchRule"  data-defaultvalue="$!{nisBusTypeRuleVO.matchRule}"></div>
                        </td>
                        <td class="textCenter">
                            <div class="layui-input-inline">
                                <select name="leftParenthesis"   data-search="false" data-inputvalue="true" data-value="$!{nisBusTypeRuleVO.leftParenthesis}">
                                    <option value=" ">#springMessage('common.placeholder.select')</option>
                                    #if($!{nisBusTypeRuleVO.leftParenthesis} =="(")
                                        <option value="(" selected>(</option>
                                    #else if
                                        <option value="(">(</option>
                                    #end
                                </select>
                            </div>
                        </td>
                        <td class="textCenter">
                            <div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchElements"  data-name="matchElements"  data-biz-name="matchElements$row" data-defaultvalue="$!{nisBusTypeRuleVO.matchElements}" data-callback="onchangeMatchElements"
                                 #if($!{nisBusTypeRuleVO.matchElements} != "amt"))
                                 data-filterData="5,6,7,8"
                                 #end
                            ></div>
                        </td>
                        <td class="textCenter">
                            <div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchRelations" data-filterData="5,6,7,8,9,10" data-name="matchRelations"  data-biz-name="matchRelations$row" data-defaultvalue="$!{nisBusTypeRuleVO.matchRelations}" data-callback="onchangeMatchRelations"></div>
                        </td>
                        <td class="textCenter">
                            <input type="text" name="matchContent" id="matchContent$row"  placeholder="#springMessage('table.netbank.nisproject.matchContent')" autocomplete="off" class="layui-input" value="$!{nisBusTypeRuleVO.matchContent}"
                                #if($!{nisBusTypeRuleVO.matchElements} == "amt"
                                && ($!{nisBusTypeRuleVO.matchRelations} == "1" || $!{nisBusTypeRuleVO.matchRelations} == "2"
                                || $!{nisBusTypeRuleVO.matchRelations} == "3" || $!{nisBusTypeRuleVO.matchRelations} == "4"))
                                   style="display: none;"#end>
                            <div class="layui-input-inline" id="number$row"
                                #if($!{nisBusTypeRuleVO.matchElements} != "amt" || ($!{nisBusTypeRuleVO.matchElements} == "amt"
                                && ($!{nisBusTypeRuleVO.matchRelations} == "5" || $!{nisBusTypeRuleVO.matchRelations} == "6"
                                || $!{nisBusTypeRuleVO.matchRelations} == "7" || $!{nisBusTypeRuleVO.matchRelations} == "8")))
                                 style="display: none;"#end>
                                <select  lay-search="" data-inputvalue="true" >
                                    <option value="1" #if($!{nisBusTypeRuleVO.matchContent} == "奇数") selected #end>#springMessage('table.number.odd')</option>
                                    <option value="2" #if($!{nisBusTypeRuleVO.matchContent} == "偶数") selected #end>#springMessage('table.number.even')</option>
                                </select>
                            </div>
                        </td>
                        <td class="textCenter">
                            <div class="layui-input-inline">
                                <select name="rightParenthesis"   data-search="false" data-inputvalue="true" >
                                    <option value=" ">#springMessage('common.placeholder.select')</option>
                                    #if($!{nisBusTypeRuleVO.rightParenthesis} ==")")
                                        <option value=")" selected>)</option>
                                    #else if
                                        <option value=")">)</option>
                                    #end
                                </select>
                            </div>
                        </td>
                        <td class="textCenter">
                            <a href="javascript:void (0)" onclick="deleteDtl(this)">#springMessage("common.button.delete") </a>
                        </td>
                    </tr>
                #end
            #end
        #else
            <tr>
                <td class="textCenter">
                    <input type="hidden" name="matchRule" value=" "/>
                </td>
                <td class="textCenter">
                    <div class="layui-input-inline">
                        <select name="rightParenthesis"   data-search="false" data-inputvalue="true">
                            <option value=" ">#springMessage('common.placeholder.select')</option>
                            <option value="(">(</option>
                        </select>
                    </div>
                </td>
                <td class="textCenter">
                    <div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchElements"  data-name="matchElements"  ></div>
                </td>
                <td class="textCenter">
                    <div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchRelations" data-filterData="5,6,7,8,9,10" data-name="matchRelations"  ></div>
                </td>
                <td class="textCenter">
                    <input type="text" name="matchContent" id="matchContent1"  placeholder="#springMessage('table.netbank.nisproject.matchContent')" autocomplete="off" class="layui-input">
                    <div class="layui-input-inline" id="number1" style="display: none;">
                        <select  lay-search="" data-inputvalue="true" >
                            <option value="1">#springMessage('table.number.odd')</option>
                            <option value="2">#springMessage('table.number.even')</option>
                        </select>
                    </div>
                </td>
                <td class="textCenter">
                    <div class="layui-input-inline">
                        <select name="rightParenthesis"   data-search="false" data-inputvalue="true">
                            <option value=" ">#springMessage('common.placeholder.select')</option>
                            <option value=")">)</option>
                        </select>
                    </div>
                </td>
                <td class="textCenter">
                    <button class="layui-btn" onclick="addTr();" type="button">#springMessage('common.addTr')</button>
                </td>
            </tr>
        #end
    </table>

    <div>
      <span id="point">
        <p style="color:red">#springMessage('table.bisBankExecutionStrategy.point')</p>
        <span style="color:red">#springMessage('table.bisBankExecutionStrategy.refund.point')</span><br>
      </span>
    </div>
</form>
<div>

</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/refundStrategy.update.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcVoucherTypePage.id}">
		<input id="isSystem" name="isSystem" type="hidden" value="0">
        <table class="layui-table">
			<tbody >
				<tr>
					<td class="textRight" width="30%">#springMessage('fcReceiptType.code')</td>
					<td >
						<input type="text" id="receiptCode" name="receiptCode" lay-verify="required|langKey|strlength" autocomplete="off" class="layui-input" placeholder="#springMessage('fcReceiptType.code')">
##						data-maxlength="2" data-minlength="2"
                    </td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('fcReceiptType.name')</td>
					<td>
						<input type="text" id="receiptName" name="receiptName" lay-verify="required|strlength" data-maxlength="20" autocomplete="off" class="layui-input" placeholder="#springMessage('fcReceiptType.name')">
                    </td>
                </tr>
				<tr >
					<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
					<td>
						<textarea placeholder="#springMessage('fcVoucherType.rmk')" lay-verify="strlength" data-maxlength="40" class="layui-textarea" id="rmk" name="rmk" ></textarea>
                    </td>
				</tr>
    			<tr >
                    <td colspan="2" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
	bt.use(['form', 'layedit', 'selectType', 'dicts'], function () {
		var $ = bt.jquery, form = bt.form();

		//监听提交
		form.on('submit(submit)', function (data) {
			var action = "/netbank/receipttype/save";
			$.post(basePath + action, data.field, function (result) {
				parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}, function () {
					parent.layer.closeAll();
					// if (result.success) {
					// 	if (bt.navtab) {
					// 		bt.navtab.refreshParent();
					// 		bt.navtab.refreshCurrent()
					// 	} else {
					// 		parent.layer ? parent.layer.closeAll() : layer.closeAll();
					// 	}
					// }
				})
			}, 'JSON');
			return false;
		});
	});

</script>

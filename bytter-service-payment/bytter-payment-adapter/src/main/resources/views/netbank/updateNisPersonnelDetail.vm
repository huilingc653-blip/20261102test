<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	
    <form class="layui-form" method="post">
        <input id="id" name="id" type="hidden" value="$!{nisPersonnelDetailPage.id}">
        <input id="status" name="status" type="hidden" value="$!{nisPersonnelDetailPage.status}">
		<table class="layui-table">
			<tbody >
				<tr >
					<td class="textRight">#springMessage('table.nisPersonnelDetail.workNo')</td>
                    <td width="40%">
						<input type="text" id="workNo" name="workNo" lay-verify="required|langKey|strlength" data-maxlength="30"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisPersonnelDetail.workNo')" value="$!{nisPersonnelDetailPage.workNo}">
					</td>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.userName')</td>
                    <td width="40%">
						<input type="text" id="userName" name="userName" lay-verify="required|strlength" data-maxlength="40"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisPersonnelDetail.userName')" value="$!{nisPersonnelDetailPage.userName}">
					</td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('table.nisPersonnelDetail.sex')</td>
                    <td>
						<div class="bt-biz-dict" data-type="radio" data-group="sex" data-required="true"
							data-defaultvalue = "$!{nisPersonnelDetailPage.sex}" data-name="sex" data-biz-name="sex"></div>
					</td>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.idcard')</td>
                    <td>
						<input type="text" id="idcard" name="idcard" lay-verify="identity1"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisPersonnelDetail.idcard')" value="$!{nisPersonnelDetailPage.idcard}">
					</td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('table.nisPersonnelDetail.mobile')</td>
                    <td>
                        <input type="text" id="mobile" name="mobile" lay-verify="phone1"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisPersonnelDetail.mobile')" value="$!{nisPersonnelDetailPage.mobile}">
					</td>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.corpId')</td>
                    <td>
						<div class="layui-input-inline">
                            <div class="bt-biz-corp" data-required="true"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="corpId"
                                 data-scope="all"
                                 data-resource="netbank:nispersonneldetail:query"
                                 data-defaultvalue="$!{nisPersonnelDetailPage.corpId}"></div>
						</div>
					</td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('table.nisPersonnelDetail.deptName')</td>
                    <td>
                        <input type="text" id="deptName" name="deptName" lay-verify="required|strlength" data-maxlength="30"
                             autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisPersonnelDetail.deptName')" value="$!{nisPersonnelDetailPage.deptName}">
					</td>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.cardType')</td>
                    <td>
						<div class="bt-biz-dict" data-type="select" data-group="nisPersonnelDetail.cardType" data-required="true"
							data-defaultvalue="$!{nisPersonnelDetailPage.cardType}" data-name="cardType" data-biz-name="cardType"></div>
					</td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('table.nisPersonnelDetail.bankAcc')</td>
                    <td>
                        <input type="text" id="bankAcc" name="bankAcc" lay-verify="required"
                             autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.nisPersonnelDetail.bankAcc')" value="$!{nisPersonnelDetailPage.bankAcc}">
					</td>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.bankName')</td>
                    <td>
                        <div class="layui-input-inline" >
                            <input type="text" id="bankCode" name="bankCode" lay-verify="required" readonly="readonly" value="$!{nisPersonnelDetailPage.bankCode}"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisPersonnelDetail.bankCode')">
                            <div class="bt-div-search">
                                <button   class="bt-biz-bankInfo" id="selPayeeBankBut" type="button"  data-callback="bt.bankinfoCallback" title="#springMessage('common.button.select')">
                                    <i class="layui-icon">&#xe615;</i>
                                </button>
                            </div>
                        </div>
                        <div class="layui-input-inline">
                            <input type="text" id="bankName" name="bankName" lay-verify="required" readonly="readonly" value="$!{nisPersonnelDetailPage.bankName}"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisPersonnelDetail.bankName')">
                        </div>
					</td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('table.nisPersonnelDetail.accName')</td>
                    <td>
                        <input type="text" id="accName" name="accName" lay-verify="required|strlength" data-maxlength="150"
                             autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisPersonnelDetail.accName')" value="$!{nisPersonnelDetailPage.accName}">
					</td>
					<td class="textRight">#springMessage('table.nisPersonnelDetail.bifCode')</td>
                    <td>
						<div class="layui-input-inline">
							<div class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/json" 
								data-valuefield="id" data-textfield="name" data-name="bifCode" data-defaultvalue="$!{nisPersonnelDetailPage.bifCode}"></div>
						</div>
					</td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('table.nisPersonnelDetail.prov')</td>
					<td colspan="3">
                        <div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="prov" data-change="city" data-defaultvalue="$!{nisPersonnelDetailPage.prov}" data-required="true"></div>
    					<div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="city" data-defaultvalue="$!{nisPersonnelDetailPage.city}" data-required="true"></div>
					</td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('table.nisPersonnelDetail.rmk')</td>
                    <td colspan="3">$!{nisPersonnelDetailPage.rmk}
						<textarea name="rmk" id="rmk" autocomplete="off" class="layui-textarea" lay-verify="strlength" data-maxlength="100"
                                  placeholder="#springMessage('table.nisPersonnelDetail.rmk')">$!{nisPersonnelDetailPage.rmk}</textarea>
					</td>
				</tr>
				<tr >
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
    </form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisPersonnelDetail.edit.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tr>
                <td class="textRight">调拨类型</td>
                <td width="40%">
                    <div class="bt-biz-dict" data-type="select" data-group="nisFlowRule.transferType" data-name="eqs_transferType" data-biz-name="transferType"></div>
                </td>
                <td class="textRight">调拨方式</td>
                <td width="40%">
                    <div class="bt-biz-dict" data-type="select" data-group="nisFlowRule.transferMode" data-name="eqs_transferMode" data-biz-name="transferMode"></div>
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>调拨类型</th>
            <th>调拨方式</th>
            <th>用途/摘要</th>
            <th>状态</th>
            <th>操作</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisFlowRule.list.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>

<form class="layui-form" method="post" id="inputForm">
	<input id="billNo" name="billNo" type="hidden" value="$!{nisBillheadPage.billNo}">
	<input id="caInfoId" name="caInfoId" type="hidden" value="$!{nisBillheadPage.caInfoId}">
	<input id="tallyDate" name="tallyDate" type="hidden" value="$!{nisBillheadPage.tallyDate}">
	<input id="orderNo" name="orderNo" type="hidden" value="$!{nisBillheadPage.orderNo}">
	<input id="voucherNo" name="voucherNo" type="hidden" value="$!{nisBillheadPage.voucherNo}">
	<input id="erpId" name="erpId" type="hidden" value="$!{nisBillheadPage.erpId}">
	<input id="billFrom" name="billFrom" type="hidden" value="$!{nisBillheadPage.billFrom}">
	<input id="directPayFlag" name="directPayFlag" type="hidden" value="$!{nisBillheadPage.directPayFlag}">
	<input id="splitId" name="splitId" type="hidden" value="$!{nisBillheadPage.splitId}">
	<input id="mergeId" name="mergeId" type="hidden" value="$!{nisBillheadPage.mergeId}">
	<input id="status" name="status" type="hidden" value="$!{nisBillheadPage.status}">
	<input id="statusTemp"  type="hidden" value="$!{nisBillheadPage.status}">
	<input id="createBy" name="createBy" type="hidden" value="$!{nisBillheadPage.createBy}">
	<input id="createDate" name="createDate" type="hidden" value="$!{nisBillheadPage.createDate}">
	<input id="updateBy" name="updateBy" type="hidden" value="$!{nisBillheadPage.updateBy}">
	<input id="updateDate" name="updateDate" type="hidden" value="$!{nisBillheadPage.updateDate}">
	<input id="id" name="id" type="hidden" value="$!{nisBillheadPage.id}">
	<input id="isAutoPay" name="isAutoPay" type="hidden" value="$!{nisBillheadPage.isAutoPay}">
	<!-- 付款方式相关属性 -->
	<input id="sysVoucherCode" name="sysVoucherCode" type="hidden" value="$!{nisBillheadPage.sysVoucherCode}">
	<input id="isAccount" name="isAccount" type="hidden" value="">
	<input id="isBudget" name="isBudget" type="hidden" value="">
	<!-- 所用账号单位代码 -->
	<input id="accCorpId" name="accCorpId" type="hidden" value="$!{corp.userAccountCode}">
	<!-- 付/收款账号相关属性 -->
	<input id="accId" name="accId" type="hidden" value="$!{nisBillheadPage.accId}">
	<input id="bifCode" name="bifCode" type="hidden" value="$!{nisBillheadPage.bifCode}">
	<input id="payerBankCode" name="payerBankCode" type="hidden" value="$!{payerBankAcc.bankCode}">
	<input id="bankNamePrefix" name="bankNamePrefix" type="hidden" value="$!{payerBankAcc.bankNamePrefix}">
	<input id="payerProv" name="payerProv" type="hidden" value="$!{payerBankAcc.prov}">
	<input id="payerCity" name="payerCity" type="hidden" value="$!{payerBankAcc.city}">
	<input id="payerBankTypeId" name="payerBankTypeId" type="hidden" value="$!{payerBankAcc.bankTypeId}">
	<input id="payeeProv" name="payeeProv" type="hidden" value="$!{nisBillheadPage.prov}">
	<input id="payeeCity" name="payeeCity" type="hidden" value="$!{nisBillheadPage.city}">
	<input id="bankTypeId" name="bankTypeId" type="hidden" value="$!{nisBillheadPage.bankTypeId}">
	<input id="billCorpName" name="billCorpName" type="hidden" value="">
	<!-- 系统参数 -->
	<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
	<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
	<input id="defItemCode" name="defItemCode" type="hidden" value="">
	<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
	<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
	<input id="accountOver" name="accountOver" type="hidden" value="$!{accountOver}">
	<input id="bankaccOver" name="bankaccOver" type="hidden" value="$!{bankaccOver}">
	<input id="balControlType" name="balControlType" type="hidden" value="$!{balControlType}">
	<input id="showIsPayed" name="showIsPayed" type="hidden" value="$!{showIsPayed}">
	<input id="showIsAdvance" name="showIsAdvance" type="hidden" value="$!{nisBillheadPage.isAdvance}">
	<input id="externalCorp" name="externalCorp" type="hidden" value="$!{externalCorp}">
	<input id="isOpenLimit" name="isOpenLimit" type="hidden" value="$!{isOpenLimit}">
	<input id="allowDifferentBillMoney" name="allowDifferentBillMoney" type="hidden" value="$!{allowDifferentBillMoney}">
	<input id="demandControl" type="hidden" value="$!{demandControl}">
	<!-- 金额是否允许修改 -->
	<input id="editPayMoney" name="editPayMoney" type="hidden" value="$!{editPayMoney}">
	<input id="editVoucherTypeId" name="editVoucherTypeId" type="hidden" value="$!{editVoucherTypeId}">
	<!-- 资金计划参数 明细项控制模式-->
	<input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
	<input id="settlType" name="settlType" type="hidden" value="">
	<!-- 人民币 -->
	<input id="natualCurId" name="natualCurId" type="hidden" value="$!{currencyTag.getRMBCurrency().id}">
	<input id="natualCurName" name="natualCurName" type="hidden" value="$!{currencyTag.getRMBCurrency().curName}">
	<input type="hidden" name="sysDate" lay-verify="required" class="layui-input bt-biz-dateType" data-type="date" data-today="true" data-name="sysDate" data-biz-name="sysDate">
	<input id="billBalance" name="billBalance" type="hidden" value="$!{billBalance}">
	<div class="layui-collapse">
		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('table.nisBillhead.titleInfo')</h2>
			<div class="layui-colla-content layui-show">
			<table class="layui-table">
				<tbody>
				<tr>
				##单位
					<td class="textRight" width="15%" colspan="2">#springMessage('table.nisBillhead.corpId')</td>
					<td width="30%">
						<input type="hidden" id="corpIdDef" value="$!{nisBillheadPage.corpId}">
						$!{nisBillheadPage.corpName}
						<div class="layui-input-inline" style="display: none;">
							<div class="bt-biz-corp"
								 data-biz-type="corp"
								 data-type="selectTree"
								 data-name="corpId"
								 data-biz-name="corpId"
								 data-scope="all"
								 data-required="true"
								 data-callback="bt.corpCallback"
								 data-defaultvalue="$!{nisBillheadPage.corpId}"
								 data-resource="netbank:netBank:nisBillHead:update"></div>
						</div>
					</td>
				##付款方式
					<td class="textRight" width="15%" colspan="2">#springMessage('table.nisBillhead.voucherTypeId')</td>
					<td width="30%">
						<input type="hidden" id="voucherTypeIdDef" value="$!{nisBillheadPage.voucherTypeId}">
						#if("$!{editVoucherTypeId}" == "0")
							<input type="text" id="voucherTypeIdShow" name="voucherTypeIdShow" value="$!{nisBillheadPage.voucherName}" readonly="readonly" autocomplete="off" class="layui-input text">
							<div class="layui-input-inline" style="display: none">
								<select name="voucherTypeId" id="voucherTypeId" lay-verify="required" lay-search="" lay-filter="voucherTypeId">
									<option value=""></option>
								</select>
							</div>
						#else
							<div class="layui-input-inline">
								<select name="voucherTypeId" id="voucherTypeId" lay-verify="required" lay-search="" lay-filter="voucherTypeId">
									<option value=""></option>
								</select>
							</div>
						#end

					</td>
				</tr>
				<tr>
					<td rowspan="3" width="2%" align="center">#springMessage('table.nisAllocationReq.payerInfo')</td>
				##付款账号
					<td class="textRight" width="18%">#springMessage('table.nisBillhead.payerAcc')</td>
					<td width="30%">
						<div class="layui-input-inline">
							#if("$!{editPayerAcc}" == "0")
								<input type="text" id="payerAccShow" name="payerAccShow" value="$!{nisBillheadPage.payerAcc}" readonly="readonly" autocomplete="off" class="layui-input text">
								<input type="text" id="payerAcc" name="payerAcc" lay-verify="required|tableData" value="$!{nisBillheadPage.payerAcc}" data-biz-name="payerAcc" style="display: none" data-close="false"
									   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.payerAcc')">
								<table id="payerAccTable" class="hide">
									<thead>
									<tr>
										<th>#springMessage('table.nisBillhead.payerAcc')</th>
										<th>#springMessage('table.nisBillhead.payerAccName')</th>
										<th>#springMessage('table.nisBillhead.payerBank')</th>
										<th>#springMessage('table.nisBillhead.curId')</th>
										<th>#springMessage('table.btBankAcc.isOnline')</th>
									</tr>
									</thead>
								</table>
							#else
								<input type="text" id="payerAcc" name="payerAcc" lay-verify="required|tableData" value="$!{nisBillheadPage.payerAcc}" data-biz-name="payerAcc"
									   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.payerAcc')">
								<table id="payerAccTable" class="hide">
									<thead>
									<tr>
										<th>#springMessage('table.nisBillhead.payerAcc')</th>
										<th>#springMessage('table.nisBillhead.payerAccName')</th>
										<th>#springMessage('table.nisBillhead.payerBank')</th>
										<th>#springMessage('table.nisBillhead.curId')</th>
										<th>#springMessage('table.btBankAcc.isOnline')</th>
									</tr>
									</thead>
								</table>
							#end
						</div>
					</td>
					<td rowspan="3" width="2%" align="center">#springMessage('table.nisAllocationReq.payeeInfo')</td>
				##收款账号
					<td class="textRight" width="18%">#springMessage('table.nisBillhead.payeeAcc')</td>
					<td width="30%">
						<div class="layui-input-inline" id="payeeAccDiv" style="width: 180px;">
							#if("$!{externalCorp}" == "1" || "$!{editPayeeAcc}" == "0")
								<input type="text" id="payeeAcc" name="payeeAcc" lay-verify="required" value="$!{nisBillheadPage.payeeAcc}" readonly="readonly"
									   autocomplete="off" class="layui-input" style="width: 180px;" placeholder="#springMessage('table.nisBillhead.payeeAcc')">
							#else
								<input type="text" id="payeeAcc" name="payeeAcc" lay-verify="required" value="$!{nisBillheadPage.payeeAcc}"
									   autocomplete="off" class="layui-input" style="width: 180px;" placeholder="#springMessage('table.nisBillhead.payeeAcc')">
							#end
							#if("$!{editPayeeAcc}" == "1")
								<div class="bt-div-search">
									<button  class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button" data-beforeClick="bt.externalCorpBankAccParams" data-callback="bt.externalCorpCallback" title="#springMessage('common.button.select')">
										<i class="layui-icon">&#xe615;</i>
									</button>
								</div>
							#end
						</div>
						<div class="layui-input-inline" id="payeeAccTempDiv" style="display:none">
							<input type="text" id="payeeAccTemp" name="payeeAccTemp" lay-verify="required" value="$!{nisBillheadPage.payeeAcc}" data-biz-name="payeeAccTemp"
								   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.payeeAcc')">
							<table id="payeeAccTable" class="hide">
								<thead>
								<tr>
									<th>#springMessage('table.nisBillhead.payeeAcc')</th>
									<th>#springMessage('table.nisBillhead.payeeAccName')</th>
									<th>#springMessage('table.nisBillhead.payeeBank')</th>
									<th>#springMessage('table.nisBillhead.curId')</th>
								</tr>
								</thead>
							</table>
						</div>
						#if("$!{externalCorp}" == "0")
							##是否保存客商资料
							<div class="layui-inline" >
								<input type="checkbox" name="isExternalCorp" lay-skin="primary" title="#springMessage('common.button.save')" lay-filter="isCommon" value="1" checked>
							</div>
							##是否共享
							<div class="layui-inline"  id="isCommonDiv">
								<div class="bt-biz-dict" data-type="radio" data-group="externalCorp.isCommon"
									 data-name="isCommon" data-biz-name="isCommon" data-defaultvalue="1"></div>
							</div>
						#end
					</td>
				</tr>
				<tr>
				##付款账号名称
					<td class="textRight">#springMessage('table.nisBillhead.payerAccName')</td>
					<td>
						<div class="layui-input-inline">
							<input type="text" id="payerAccName" name="payerAccName" lay-verify="required" style="width:300px;" readonly="readonly"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payerAccName')" value="$!{nisBillheadPage.payerAccName}">
						</div>
					</td>
				##收款账号名称
					<td class="textRight">#springMessage('table.nisBillhead.payeeAccName')</td>
					<td>
						<div class="layui-input-inline" id="payeeAccNameDiv">
							#if("$!{externalCorp}" == "1" || "$!{editPayeeAccName}" == "0")
								<input type="text" id="payeeAccName" class="layui-input bt-biz-inputExternalCorpBankAcc" data-url="" name="payeeAccName" data-biz-name="payeeAccName" readonly="readonly"
									   data-valuefield="inputExternalValue" data-textfield="inputExternalText" data-search="seachExternalCorpBankAcc" lay-verify="required"
									   data-callback="inputExternalCorpCallback" value="$!{nisBillheadPage.payeeAccName}" style="width:321px;"
									   placeholder="#springMessage('table.nisBillhead.payeeAccName')" >
							#else
								<input type="text" id="payeeAccName" class="layui-input bt-biz-inputExternalCorpBankAcc" data-url="" name="payeeAccName" data-biz-name="payeeAccName"
									   data-valuefield="inputExternalValue" data-textfield="inputExternalText" data-search="seachExternalCorpBankAcc" lay-verify="required"
									   data-callback="inputExternalCorpCallback" value="$!{nisBillheadPage.payeeAccName}" style="width:321px;"
									   placeholder="#springMessage('table.nisBillhead.payeeAccName')" >
							#end
						</div>
						<div class="layui-input-inline" id="payeeAccNameTempDiv" style="display:none">
							<input type="text" id="payeeAccNameTemp" name="payeeAccName" lay-verify="required" value="$!{nisBillheadPage.payeeAccName}"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payeeAccName')" style="width:321px;">
						</div>
					</td>
				</tr>
				<tr>
				##付款开户行
					<td class="textRight">#springMessage('table.nisBillhead.payerBank')</td>
					<td>
						<div class="layui-input-inline">
							<input type="text" id="payerBank" name="payerBank" lay-verify="required" style="width:300px;" readonly="readonly"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payerBank')" value="$!{nisBillheadPage.payerBank}">
						</div>
					</td>
				##收款开户行
					<td class="textRight">#springMessage('table.nisBillhead.payeeBank')</td>
					<td>
						<div class="layui-input-inline" id="payeeBankCodeDiv">
							#if("$!{externalCorp}" == "1" || "$!{editPayeeBank}" == "0")
								<input type="text" id="payeeBankCode" name="payeeBankCode" lay-verify="required" readonly="readonly" value="$!{nisBillheadPage.payeeBankCode}" readonly="readonly"
									   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payeeBankCode')" style="width:130px;">
							#else
								<input type="text" id="payeeBankCode" name="payeeBankCode" lay-verify="required" readonly="readonly" value="$!{nisBillheadPage.payeeBankCode}"
									   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payeeBankCode')" style="width:130px;">
								<div class="bt-div-search">
									<button   class="bt-biz-bankInfo" id="selPayeeBankBut" type="button"  data-callback="bt.bankinfoCallback" title="#springMessage('common.button.select')">
										<i class="layui-icon">&#xe615;</i>
									</button>
								</div>
							#end
						</div>
						<div class="layui-input-inline">
							<input type="text" id="payeeBank" name="payeeBank" lay-verify="required" style="width:300px;" readonly="readonly" value="$!{nisBillheadPage.payeeBank}"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payeeBank')">
						</div>
					</td>
				</tr>
				<tr id="realPayerAccIdDiv" style="display:none">
					##结算中心实际付款账号
					<td class="textRight" colspan="2">结算中心实际付款账号</td>
					<td>
						<div class="layui-input-inline">
							<input type="hidden" id="realPayerAccId" name="realPayerAccId" value="$!{nisBillheadPage.realPayerAccId}">
							<input type="text" id="realPayerAcc" name="realPayerAcc" lay-verify="required|tableData"
								   data-biz-name="realPayerAcc" value="$!{nisBillheadPage.realPayerAcc}"
								   autocomplete="off" class="layui-input text"
								   placeholder="结算中心实际付款账号">
							<table id="realPayerAccTable" class="hide">
								<thead>
								<tr>
									<th>#springMessage('table.btBankAcc.bankAcc')</th>
									<th>#springMessage('table.btBankAcc.accName')</th>
									<th>#springMessage('table.btBankAcc.bankName')</th>
									<th>#springMessage('table.nisBillhead.curId')</th>
								</tr>
								</thead>
							</table>
						</div>
					</td>
					##付款账号余额
					<td class="textRight" colspan="2">付款账号余额</td>
					<td>
						<div id="realPayerAccBalDiv" name="realPayerAccBalDiv">$!number.formatNumeric($!{nisBillheadPage.realPayerAccBal})</div>
					</td>
				</tr>
				<tr>
				##付款账户余额
					<td class="textRight" colspan="2">#springMessage('table.nisBillhead.balance')</td>
					<td>
						<div id="balanceDiv" name="balanceDiv">$!number.formatNumeric($!{nisBillheadPage.balance})</div>
						<input type="hidden" id="balance" name="balance" style="text-align:right" readonly="readonly" data-name="balance" data-biz-name="balance"
							   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.nisBillhead.balance')" value="$!{nisBillheadPage.balance}">
					</td>
				##省市
					<td class="textRight" colspan="2"><div id="payeeAddrDiv" style="display:none">#springMessage('table.nisBillhead.payeeAddr')</div></td>
					<td>
						<div class="layui-input-inline" id="payeeAddr" style="display:none">
							<div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="prov" data-change="city" data-defaultvalue="$!{nisBillheadPage.prov}" data-required="true" data-callback="bt.provCallback"></div>
							<div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="city" data-defaultvalue="$!{nisBillheadPage.city}" data-required="true" data-callback="bt.cityCallback"></div>
						</div>
					</td>
				</tr>
				<tr>
					##系统可用余额
					<td class="textRight" colspan="2">系统可用余额</td>
					<td>
						<div id="availBalDiv" name="availBalDiv">$!number.formatNumeric($!{nisBillheadPage.availBal})</div>
						<input type="hidden" id="availBal" name="availBal" style="text-align:right" readonly="readonly" data-name="availBal" data-biz-name="availBal"
							   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="系统可用余额" value="$!{nisBillheadPage.availBal}">
					</td>
					##币别
					<td class="textRight" colspan="2">#springMessage('table.nisBillhead.curId')</td>
					<td>
						<div id="curDiv" name="curDiv">$!{nisBillheadPage.curName}</div>
						<input type="hidden" id="curId" name="curId" value="$!{nisBillheadPage.curId}">
					</td>
				</tr>
				<tr id="downAccDiv" style="display:none">
				##下拨账号
					<td class="textRight" colspan="2">#springMessage('table.nisBillhead.bankAcc')</td>
					<td>
						<div class="layui-input-inline">
							<input type="hidden" id="downAccId" name="downAccId" value="$!{nisBillheadPage.downAccId}">
							<input type="text" id="downAcc" name="downAcc" lay-verify="required|tableData" data-biz-name="downAcc"
								   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.bankAcc')" value="$!{nisBillheadPage.downAcc}" >
							<table id="downAccTable" class="hide">
								<thead>
								<tr>
									<th>#springMessage('table.btBankAcc.bankAcc')</th>
									<th>#springMessage('table.btBankAcc.accName')</th>
									<th>#springMessage('table.btBankAcc.bankName')</th>
									<th>#springMessage('table.nisBillhead.curId')</th>
								</tr>
								</thead>
							</table>
						</div>
					</td>
				##下拨账号户名
					<td class="textRight" colspan="2">#springMessage('table.nisBillhead.bankAccName')</td>
					<td>
						<div class="layui-input-inline">
							<input type="text" id="downAccName" name="downAccName" readonly="readonly" value="$!{nisBillheadPage.downAccName}"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.bankAccName')">
						</div>
					</td>
				</tr>
				<tr id="difBankDiv" style="display:none">
				##跨行标志
					<td class="textRight" colspan="2">#springMessage('table.nisBillhead.difBank')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.difBank" data-defaultvalue="$!{nisBillheadPage.difBank}" data-name="difBank" data-biz-name="difBank" data-required = "true"></div>
					</td>
				##地域标志
					<td class="textRight" colspan="2">#springMessage('table.nisBillhead.areaSign')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.areaSign" data-defaultvalue="$!{nisBillheadPage.areaSign}" data-name="areaSign" data-biz-name="areaSign" data-required = "true"></div>
					</td>
				</tr>
				<tr>
					##是否已付款
					<td class="textRight" colspan="2"><div style="display:none" id="isPayedTitle">#springMessage('table.nisBillhead.isPayed')</div></td>
					<td>
						<div style="display:none" id="isPayed"><div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.isPayed" data-defaultvalue="$!{nisBillheadPage.isPayed}"
																	 data-name="isPayed" data-biz-name="isPayed" data-required = "true" data-callback="isPayedCallBack"></div></div>
					</td>
				</tr>
				</tbody>

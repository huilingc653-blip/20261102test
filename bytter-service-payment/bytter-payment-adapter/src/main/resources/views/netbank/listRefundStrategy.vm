<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

    <style>
        .select-column {
            overflow: visible!important;
        }

    </style>
</head>
<body>
<form id="searchFormDtl" class="layui-form">
    <input type="hidden" name="eqs_id" id="eqs_id"/>
    <table class="layui-table">
        <tbody >
        <tr>
            ##银行类型
            <td class="textRight" width="15%">#springMessage('table.eBankBill.bankType')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json"
                     data-name ="eqs_bankTypeId" data-biz-name ="eqs_bankTypeId"  data-valueField="id" data-textField="typeName"></div>
            </td>
            ##策略执行规则
            <td class="textRight" width="10%">#springMessage('table.receipt.rules')</td>
            <td width="30%">
                <input type="text" data-biz-name="likes_rulesName" name="likes_rulesName" lay-verify="strlength" data-maxlength="30"
                       autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.receipt.rules')">
            </td>
        </tr>
            ##查询
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTableDtl" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.receipt.execute.sort')</th>
        <th>#springMessage('table.btwarnstrategy.name')</th>
        <th>#springMessage('table.eBankBill.bankType')</th>
        <th style="width: 300px">#springMessage('table.receipt.rules')</th>
        <th>#springMessage('table.fcCompareCheckType.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/refundStrategy.list.js?_btv=${resourceVersion}"></script>
</html>

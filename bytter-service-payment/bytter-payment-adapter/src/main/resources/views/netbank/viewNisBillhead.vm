<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <!-- 系统参数 -->
    <input id="id" name="id" type="hidden" value="$!{nisBillheadPage.id}">
    <input id="billNo" name="billNo" type="hidden" value="$!{nisBillheadPage.billNo}">
    <input id="corpId" name="corpId" type="hidden" value="$!{nisBillheadPage.corpId}">
    <input id="wishPayday" name="wishPayday" type="hidden" value="$!date.format('yyyy-MM-dd',$!{nisBillheadPage.wishPayday})">
    <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
    <input id="isBudget" name="isBudget" type="hidden" value="$!{isBudget}">
    <input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
    <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
    <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
    <input id="busType" name="busType" type="hidden" value="$!{busType}">
    <input id="billFrom" name="billFrom" type="hidden" value="$!{nisBillheadPage.billFrom}">
    <input id="expFbsin" name="expFbsin" type="hidden" value="$!{expFbsin}">
    <input id="showIsPayed" name="showIsPayed" type="hidden" value="$!{showIsPayed}">
    <input id="showIsOpenBill" name="showIsOpenBill" type="hidden" value="$!{nisBillheadPage.isOpenBill}">
    <input id="billId" name="billId" type="hidden" value="$!{nisBillheadPage.billId}">

    <!-- 资金计划参数 明细项控制模式-->
    <input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
    <input id="settlType" name="settlType" type="hidden" value="$!{nisBillheadPage.settlType}">
    <input id="sysVoucherCode" name="sysVoucherCode" type="hidden" value="$!{nisBillheadPage.sysVoucherCode}">
    <input id="curId" name="curId" type="hidden" value="$!{nisBillheadPage.curId}">
    <input id="payeeAccName" name="payeeAccName" type="hidden" value="$!{nisBillheadPage.payeeAccName}">
    <input id="payerAcc" name="payerAcc" type="hidden" value="$!{nisBillheadPage.payerAcc}">
    <input id="payeeAcc" name="payeeAcc" type="hidden" value="$!{nisBillheadPage.payeeAcc}">
    <input id="payeeBank" name="payeeBank" type="hidden" value="$!{nisBillheadPage.payeeBank}">
    <input id="purpose" name="purpose" type="hidden" value="$!{nisBillheadPage.purpose}">
    <div id="print">
        <div class="layui-collapse">
            <h2 class="layui-colla-title" style="text-align: center">#springMessage('table.nisBillhead.viewTitle')</h2>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.nisBillhead.titleInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table layui-table-border">
                        <tbody>
                        <tr>
                            ##付款单号
                            <td class="textRight" colspan="2" width="20%" >#springMessage('table.nisBillhead.billNo')</td>
                            <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.billNo}</div></td>
                            <td class="textRight" colspan="2" width="20%">#springMessage('table.nisAllocationReq.createDate')</td>
                            <td width="30%">$!date.format('yyyy-MM-dd',$!{nisBillheadPage.createDate})</td>
                        </tr>
                        <tr>
                            ##单位
                            <td class="textRight" colspan="2" width="20%">#springMessage('table.nisBillhead.corpId')</td>
                            <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.corpName}</div></td>
                            ##付款方式
                            <td class="textRight" colspan="2" width="20%">#springMessage('table.nisBillhead.voucherTypeId')</td>
                            <td width="30%">$!{nisBillheadPage.voucherName}</td>
                        </tr>
                            #if($!{nisBillheadPage.billFrom} == "2")
                            <tr>
                                ##付款账号
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.payerAcc')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payerAcc}</div></td>
                                ##付款账号名称
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.payerAccName')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payerAccName}</div></td>
                            </tr>
                            <tr>
                                ##付款开户行
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.payerBank')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payerBank}</div></td>
                                ##币别
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.curId')</td>
                                <td width="30%">$!{nisBillheadPage.curName}</td>
                            </tr>
                            #else
                            <tr>
                                <td rowspan="4" width="5%" align="center"  style="padding: 0;">
                                    <div style="height: 100%;width: 100%;display:table;">
                                        <div style="display:table-cell; vertical-align:middle;">
                                            #springMessage('table.nisAllocationReq.payerInfo')
                                        </div>
                                    </div>
                                </td>
                                ##付款账号
                                <td class="textRight" width="15%">#springMessage('table.nisBillhead.payerAcc')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payerAcc}</div></td>
                                <td rowspan="4" width="5%" align="center"  style="padding: 0;">
                                    <div style="height: 100%;width: 100%;display:table;">
                                        <div style="display:table-cell; vertical-align:middle;">
                                            #springMessage('table.nisAllocationReq.payeeInfo')
                                        </div>
                                    </div>
                                </td>
                                ##收款账号
                                <td class="textRight" width="15%">#springMessage('table.nisBillhead.payeeAcc')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payeeAcc}</div></td>
                            </tr>
                            <tr>
                                ##付款账号名称
                                <td class="textRight">#springMessage('table.nisBillhead.payerAccName')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payerAccName}</div></td>
                                ##收款账号名称
                                <td class="textRight">#springMessage('table.nisBillhead.payeeAccName')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payeeAccName}</div></td>
                            </tr>
                            <tr>
                                ##付款开户行
                                <td class="textRight">#springMessage('table.nisBillhead.payerBank')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payerBank}</div></td>
                                ##收款开户行
                                <td class="textRight">#springMessage('table.nisBillhead.payeeBank')</td>
                                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{nisBillheadPage.payeeBankCode} $!{nisBillheadPage.payeeBank}</div></td>
                            </tr>
                            <tr>
                                ##币别
                                <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
                                <td>$!{nisBillheadPage.curName}</td>
                                ##收款单位统一社会信用代码
                                <td class="textRight">#springMessage('table.nisBillhead.socCode')</td>
                                <td>$!{nisBillheadPage.blRcvpymtpsUnnIdNo}</td>
##                                #if($!{nisBillheadPage.sysVoucherCode} != "05")
##                                    ##省市
##                                    <td class="textRight"><div id="payeeAddrDiv">#springMessage('table.nisBillhead.payeeAddr')</div></td>
##                                    <td>$!{nisBillheadPage.provName} $!{nisBillheadPage.cityName}</td>
##                                #else
##                                    <td class="textRight"></td>
##                                    <td></td>
##                                #end
                            </tr>
                            <tr>
                                <td class="textRight" colspan="3"></td>
                                <td></td>
                                #if($!{nisBillheadPage.sysVoucherCode} != "05")
                                    ##省市
                                    <td class="textRight"><div id="payeeAddrDiv">#springMessage('table.nisBillhead.payeeAddr')</div></td>
                                    <td>$!{nisBillheadPage.provName} $!{nisBillheadPage.cityName}</td>
                                #else
                                    <td class="textRight"></td>
                                    <td></td>
                                #end
                            </tr>
                            #end
                            #if($!{nisBillheadPage.sysVoucherCode} == "02" && $!{nisBillheadPage.isAccount} == "1")
                            <tr id="downAccDiv">
                                ##下拨账号
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.bankAcc')</td>
                                <td>$!{nisBillheadPage.downAcc}</td>
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.bankAccName')</td>
                                <td>$!{nisBillheadPage.downAccName}</td>
                            </tr>
                            #end
                            #if($!{nisBillheadPage.directPayFlag} == "y" && $!{nisBillheadPage.billFrom} != "2")
                            <tr id="difBankDiv">
                                ##跨行标志
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.difBank')</td>
                                <td>$dictTag.get("nisBillhead.difBank",$!{nisBillheadPage.difBank})</td>
                                ##地域标志
                                <td class="textRight" colspan="2">#springMessage('table.nisBillhead.areaSign')</td>
                                <td>$dictTag.get("nisBillhead.areaSign",$!{nisBillheadPage.areaSign})</td>
                            </tr>
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="layui-colla-item" id="billDiv"
                #if($!{nisBillheadPage.sysVoucherCode}!="49" && $!{nisBillheadPage.sysVoucherCode}!="50")
                 style="display: none"
                #end
            >
                <h2 class="layui-colla-title">#springMessage('table.nisBillhead.billInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table layui-table-border">
                        <tr>
                            ##票据类型
                            <td class="textRight" width="20%">#springMessage('table.abVoucherinfo.billType')</td>
                            <td width="30%">
                                $dictTag.get("AB_BILL_TYPE",$!{nisBillheadPage.billType})
                            </td>
                            ##票据流通介质
                            <td class="textRight" width="20%">#springMessage('table.erp.billFlag')</td>
                            <td width="30%">
                                $dictTag.get("AB_BILL_FLAG",$!{nisBillheadPage.billFlag})
                            </td>
                        </tr>
                        #if($!{nisBillheadPage.sysVoucherCode} == "49")
                            <tr>
                                <td class="textRight">#springMessage('table.nisBillhead.isOpenBill')</td>
                                <td colspan="3">$dictTag.get("sf_yn",$!{nisBillheadPage.isOpenBill})</td>
                            </tr>
                        #end
                        #if($!{nisBillheadPage.sysVoucherCode} == "49" && $!{nisBillheadPage.isOpenBill} ==  "0")
                            <tr>
                                <td class="textRight">#springMessage('bill.accebill.busCorp')</td>
                                <td>$!{nisBillheadPage.busCorpName}</td>
                                <td class="textRight">#springMessage('bill.accebill.busPersonnel')</td>
                                <td>$!{nisBillheadPage.busPersonnel}</td>
                            </tr>
                        #end
                        #if($!{nisBillheadPage.sysVoucherCode} == "50"
                        || ($!{nisBillheadPage.sysVoucherCode} == "49" && $!{nisBillheadPage.isOpenBill} ==  "1"))
                            <tr>
                                ##票据金额
                                <td class="textRight" width="20%">#springMessage('table.nisBillhead.billMoney.lower')</td>
                                <td width="30%">
                                    $!number.formatNumeric($!{nisBillheadPage.billMoney})
                                    <input type="hidden" data-name="billMoney" data-toUp="billMoneyUp" autocomplete="off"
                                           class="layui-input bt-biz-moneyType" value="$!{nisBillheadPage.billMoney}">
                                </td>
                                <td class="textRight" width="20%">#springMessage('table.nisBillhead.billMoney.upper')</td>
                                <td width="30%" style="padding-left:0px"><div id="billMoneyUp" style="line-height: 24px; white-space: normal; word-break: break-all;"></div></td>
                            </tr>
                        #end
                    </table>
                    <!-- 票据信息 -->
                    #if($!nisBillheadPage.billId)
##                        #set($billIdAndPayId = $!{nisBillheadPage.billId} + "&" + $!{nisBillheadPage.id})
                        #set($billInfoList=$billTag.listAccebillInfoByIds($!{nisBillheadPage.billId},$!{nisBillheadPage.id}))
                        #set($sysVoucherCode=$!{nisBillheadPage.sysVoucherCode})
                        #parse("views/bill/accebill/viewAccebillPage.vm")
                    #end
                </div>
            </div>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.nisBillhead.payInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table layui-table-border">
                        <tbody>
                        <tr>
                            ##金额
                            <td class="textRight" width="20%">#springMessage('table.nisBillhead.payMoney.lower')</td>
                            <td width="30%">
                                $!number.formatNumeric($!{nisBillheadPage.payMoney})
                                <input type="hidden" data-name="payMoney" data-toUp="payMoneyUp" autocomplete="off"
                                       class="layui-input bt-biz-moneyType" value="$!{nisBillheadPage.payMoney}">
                            </td>
                            <td class="textRight" width="20%">#springMessage('table.nisBillhead.payMoney.upper')</td>
                            <td width="30%" style="padding-left:0px"><div id="payMoneyUp" style="line-height: 24px; white-space: normal; word-break: break-all;"></div></td>
                        </tr>
                        <tr>
                            ##加急标志
                            <td class="textRight">#springMessage('table.nisBillhead.isQuick')</td>
                            <td>$dictTag.get("sf_yn",$!{nisBillheadPage.isQuick})</td>
                            ##期望支付日期
                            <td class="textRight">#springMessage('table.nisBillhead.wishPayday')</td>
                            <td>$!date.format('yyyy-MM-dd',$!{nisBillheadPage.wishPayday})</td>
                        </tr>
                        <tr>
                            ##会计凭证号
                            <td class="textRight">#springMessage('table.nisAllocationReq.bursarBillNo')</td>
                            <td>$!{nisBillheadPage.bursarBillNo}</td>
                            ##源单计划付款日期
##                            <td class="textRight">源单计划付款日期</td>
##                            <td>$!date.format('yyyy-MM-dd',$!{nisBillheadPage.sharingDate})</td>
                        </tr>
                        <tr>
                            ##是否对私付款
                            <td class="textRight">#springMessage('table.nisBillhead.isForindividual')</td>
                            <td>$dictTag.get("sf_yn",$!{nisBillheadPage.isForindividual})</td>
                            ##是否已付款
                            <td class="textRight"><div style="display:none" id="isPayedTitle">#springMessage('table.nisBillhead.isPayed')</div></td>
                            <td><div style="display:none" id="isPayed">$dictTag.get("nisBillhead.isPayed",$!{nisBillheadPage.isPayed})</div></td>
                        </tr>
                        <tr>
                            ##用途
                            <td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
                            <td>$!{nisBillheadPage.purpose}</td>
                            ##附言
                            <td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
                            <td>$!{nisBillheadPage.addWord}</td>
                        </tr>
                        <tr>
                            ##排期要素
                            <td class="textRight">#springMessage('table.nisPaySchedulingElements.schedulingElements')</td>
                            <td>$!{nisBillheadPage.schedulingElementsName}</td>
                            ##排期日期
                            <td class="textRight">#springMessage('table.nisPaySchedulingElements.schedulingDate')</td>
                            <td>$!date.format('yyyy-MM-dd',$!{nisBillheadPage.schedulingDate})</td>
                        </tr>
                        <tr>
                            ##备注说明
                            <td class="textRight"  width="20%">#springMessage('table.settlement.rmk')</td>
                            <td width="100%" colspan="4">$!{nisBillheadPage.rmk}</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- 资金计划 -->
        <div id="tagItemDetail"></div>
        #if($!{nisBillheadPage.isForindividual} == "1")
        <div class="noprint" style="overflow: auto">
            <table id="appTable" class="layui-table layui-form  table-border" style="width:100%;">
                <thead>
                <tr>
                    <th>#springMessage('table.nisExpenseDetail.expenseId')</th>
                    <th>#springMessage('table.nisExpenseDetail.expenseDate')</th>
                    <th>#springMessage('table.nisExpenseDetail.expenseMoney')</th>
                    <th>#springMessage('table.nisExpenseDetail.accName')</th>
                    <th>#springMessage('table.nisExpenseDetail.bankAcc')</th>
                    <th>#springMessage('table.nisExpenseDetail.bankName')</th>
                    <th>#springMessage('table.nisExpenseDetail.bankCode')</th>
                    <th>#springMessage('table.nisExpenseDetail.prov')</th>
                    <th>#springMessage('table.nisExpenseDetail.city')</th>
                    #if($!{nisBillheadPage.isAccount} == "0")
                        <th>#springMessage('table.nisExpenseDetail.difBank')</th>
                        <th>#springMessage('table.nisExpenseDetail.areaSign')</th>
                    #end
                    <th>#springMessage('table.nisExpenseDetail.busType')</th>
                    <th>#springMessage('table.nisExpenseDetail.opType')</th>
                    <th>#springMessage('table.nisExpenseDetail.purpose')</th>
                    <th>#springMessage('table.bisExc.voucherStat')</th>
                    <th>#springMessage('table.bisExc.returnTime')</th>
                    <th>#springMessage('table.bisExc.firstReturnMsg')</th>
                    <th>#springMessage('table.bisExc.nextReturnMsg')</th>
                </tr>
                </thead>
                <tbody>
                    #foreach($nisExpenseDetail in $listNisExpenseDetail)
                    <tr>
                        <td>$!{nisExpenseDetail.expenseId}<input id="expenseId_$!{nisExpenseDetail.id}" name="expenseId" type="hidden" value="$!{nisExpenseDetail.id}"></td>
                        <td>$!date.format('yyyy-MM-dd',$!{nisExpenseDetail.expenseDate})</td>
                        #if($!{nisExpenseDetail.busType} == "04")
                            <td name="expenseMoneyTd" class="textRight">****</td>
                        #else
                            <td name="expenseMoneyTd" class="textRight bt-biz-moneyType">$!{nisExpenseDetail.expenseMoney}</td>
                        #end
                        <td>$!{nisExpenseDetail.accName}</td>
                        <td>$!{nisExpenseDetail.bankAcc}</td>
                        <td>$!{nisExpenseDetail.bankName}</td>
                        <td>$!{nisExpenseDetail.bankCode}</td>
                        <td>$!{nisExpenseDetail.provName}</td>
                        <td>$!{nisExpenseDetail.cityName}</td>
                        #if($!{nisBillheadPage.isAccount} == "0")
                            <td>$dictTag.get("nisBillhead.difBank",$!{nisExpenseDetail.difBank})</td>
                            <td>$dictTag.get("nisBillhead.areaSign",$!{nisExpenseDetail.areaSign})</td>
                        #end
                        <td>$!{nisExpenseDetail.busTypeName}</td>
                        <td>$!{nisExpenseDetail.opTypeName}</td>
                        <td>$!{nisExpenseDetail.purpose}</td>
                        <!-- 避免误导：如果费用报销明细交易状态是3-准备发送且状态为100-已汇总前（如0-暂存/-1-打回/-2删除/11-待审批/95-审批通过），则不显示交易状态 -->
                        #if(($!{nisExpenseDetail.status} < 100 && $!{nisExpenseDetail.voucherStat} == "3") || !$!{nisExpenseDetail.voucherNo})
                            <td></td>
                        #else
                            <td>$dictTag.get("bisExc.voucherStat",$!{nisExpenseDetail.voucherStat})</td>
                        #end
                        <td>$!date.format('yyyy-MM-dd',$!{nisExpenseDetail.returnTime})</td>
                        <td>$!{nisExpenseDetail.firstReturnMsg}</td>
                        <td>$!{nisExpenseDetail.nextReturnMsg}</td>
                    </tr>
                    #end
                </tbody>
            </table>
        </div>
        #end
        #if($!{isSplitOrMerge} == "1")
        <div class="noprint" style="overflow: auto">
            <table id="appTable" class="layui-table layui-form" style="width:100%;">
                <thead>
                <tr>
                    <th>#springMessage('table.nisBillhead.billNo')</th>
                    <th>#springMessage('table.nisBillhead.payerAcc')</th>
                    <th>#springMessage('table.nisBillhead.payerAccName')</th>
                    <th>#springMessage('table.nisBillhead.curId')</th>
                    <th>#springMessage('table.nisBillhead.payMoney')</th>
                    <th>#springMessage('table.nisBillhead.payeeAcc')</th>
                    <th>#springMessage('table.nisBillhead.payeeAccName')</th>
                    <th>#springMessage('table.nisBillhead.wishPayday')</th>
                    <th>#springMessage('table.nisBillhead.busType')</th>
                    <th>#springMessage('table.nisBillhead.purpose')</th>
                    <th>#springMessage('table.nisBillhead.addWord')</th>
                    <th>#springMessage('table.nisBillhead.billFrom')</th>
                    <th>#springMessage('common.table.thead.operation')</th>
                </tr>
                </thead>
                #foreach($date in $listMerge)
                    <tr>
                        <td align="center">$!{date.billNo}</td>
                        <td>$!{date.payerAcc}</td>
                        <td>$!{date.payerAccName}</td>
                        <td>$!{date.curName}</td>
                        <td class="textRight">$!number.formatNumeric($!{date.payMoney})</td>
                        <td>$!{date.payeeAcc}</td>
                        <td>$!{date.payeeAccName}</td>
                        <td align="center">$!{date.wishPayday}</td>
                        <td>$!{date.busTypeName}</td>
                        <td>$!{date.purpose}</td>
                        <td>$!{date.addWord}</td>
                        <td>$dictTag.get("nisBillhead.billFrom",$!{date.billFrom})</td>
                        <td><a class="" href="#" onclick="view('$!{date.id}')">#springMessage('common.button.view')</a></td>
                    </tr>
                #end
            </table>
        </div>
        #end
        <div class="noprint">
            <!-- 附件上传 -->
            <input id="attachmentId" name="attachmentId" type="hidden" value="$!{nisBillheadPage.attachmentId}">
            <div id="uploader" class="layui-input-inline" style="width:100%"></div>
        </div>
        <!-- 日志 -->
        <div id="tagMsg"></div>
    </div>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{nisBillheadPage.id}')">#springMessage('common.button.trackFlow')</button>
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/netbank/nisBillhead.view.js?_btv=${resourceVersion}"></script>
</body>
</html>

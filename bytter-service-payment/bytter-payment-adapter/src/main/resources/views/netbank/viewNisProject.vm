<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form class="layui-form layui-form-pane">
        <table class="layui-table">
            <tbody>
            <tr>
                ##项目代码
                <td class="textRight">#springMessage("table.netbank.nisproject.code")</td>
                <td width="35%">$!{nisProjectPage.projectCode}</td>
                ##项目名称
                <td class="textRight">#springMessage("table.netbank.nisproject.name")</td>
                <td width="35%">$!{nisProjectPage.projectName}</td>
            </tr>
            <tr>
            ##收支标志
                <td class="textRight">#springMessage("table.netbank.nisproject.cdSign")</td>
                <td width="35%">$dictTag.get("btBankAccDtl.cdSign",$!{nisProjectPage.projectCdSign})</td>
            ##匹配要素
                <td class="textRight">#springMessage("table.netbank.nisproject.matchAttr")</td>
                <td width="35%">$dictTag.get("nisProject.matchAttr",$!{nisProjectPage.matchAttr})</td>
            </tr>
            <tr>
            ##匹配关系
                <td class="textRight">#springMessage("table.netbank.nisproject.matchRelation")</td>
                <td width="35%" colspan="3">$dictTag.get("nisProject.matchRelation",$!{nisProjectPage.matchRelation})</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage("table.netbank.nisproject.matchContent")</td>
                <td colspan="3">
                    <textarea class="layui-textarea" disabled="true">$!{nisProjectPage.matchContent}</textarea>
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage("table.netbank.nisproject.rmk")</td>
                <td colspan="3">
                    <textarea class="layui-textarea" disabled="true">$!{nisProjectPage.rmk}</textarea>
                </td>
            </tr>
            </tbody>
        </table>
    </form>
    #parse("views/common/footer.vm")
</body>
</html>
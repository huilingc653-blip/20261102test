<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<input id="id" name="id" type="hidden" value="$!{nisBillheadPage.id}">
		<input id="sysVoucherCode" name="sysVoucherCode" type="hidden" value="$!{nisBillheadPage.sysVoucherCode}">
		#if($!{nisBillheadPage.sysVoucherCode} == "02")
			<input id="accId" name="accId" type="hidden" value="$!{nisBillheadPage.downAccId}">
		#else
			<input id="accId" name="accId" type="hidden" value="$!{nisBillheadPage.realPayerAccId}">
		#end
		<input id="bifCode" name="bifCode" type="hidden" value="$!{nisBillheadPage.bifCode}">
		<input id="payerBank" name="payerBank" type="hidden" value="$!{nisBillheadPage.payerBank}">
		<!-- 银行账号选择过滤条件 -->
		<input id="corpId" name="corpId" type="hidden" value="$!{nisBillheadPage.corpId}">
		<input id="payerAccOld" name="payerAccOld" type="hidden" value="$!{nisBillheadPage.payerAcc}">
		<input id="voucherTypeId" name="voucherTypeId" type="hidden" value="$!{nisBillheadPage.voucherTypeId}">
		<input id="curId" name="curId" type="hidden" value="$!{nisBillheadPage.curId}">
		<!-- 付款信息 -->
		<input id="bankNamePrefix" name="bankNamePrefix" type="hidden" value="">
		<input id="payerBankCode" name="payerBankCode" type="hidden" value="">
		<input id="payerProv" name="payerProv" type="hidden" value="">
		<input id="payerCity" name="payerCity" type="hidden" value="">
		<!-- 收款信息 -->
		<input id="payeeBank" name="payeeBank" type="hidden" value="$!{nisBillheadPage.payeeBank}">
		<input id="payeeBankCode" name="payeeBankCode" type="hidden" value="$!{nisBillheadPage.payeeBankCode}">
		<input id="payeeProv" name="payeeProv" type="hidden" value="$!{nisBillheadPage.prov}">
		<input id="payeeCity" name="payeeCity" type="hidden" value="$!{nisBillheadPage.city}">
		<!-- 是否允许中心修改下拨账号 -->
		<input id="allowEditDownacc" name="allowEditDownacc" type="hidden" value="$!{allowEditDownacc}">
		<div class="layui-collapse">
			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('table.nisBillhead.titleInfo')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
						<tr>
							##付款单号
							<td class="textRight" width="20%" colspan="2">#springMessage('table.nisBillhead.billNo')</td>
							<td width="30%">$!{nisBillheadPage.billNo}</td>
							<td class="textRight" width="20%" colspan="2">#springMessage('table.nisAllocationReq.createDate')</td>
							<td width="30%">$!date.format('yyyy-MM-dd',$!{nisBillheadPage.createDate})</td>
						</tr>
						<tr>
							##单位
							<td class="textRight" width="20%" colspan="2">#springMessage('table.nisBillhead.corpId')</td>
							<td width="30%">$!{nisBillheadPage.corpName}</td>
							##付款方式
							<td class="textRight" width="20%" colspan="2">#springMessage('table.nisBillhead.voucherTypeId')</td>
							<td width="30%">$!{nisBillheadPage.voucherName}</td>
						</tr>
						<tr>
							<td rowspan="4" width="5%" align="center">#springMessage('table.nisAllocationReq.payerInfo')</td>
							##付款账号
							<td class="textRight" width="15%">#springMessage('table.nisBillhead.payerAcc')</td>
							<td width="30%">$!{nisBillheadPage.payerAcc}</td>
							<td rowspan="4" width="5%" align="center">#springMessage('table.nisAllocationReq.payeeInfo')</td>
							##收款账号
							<td class="textRight" width="15%">#springMessage('table.nisBillhead.payeeAcc')</td>
							<td width="30%">$!{nisBillheadPage.payeeAcc}</td>
						</tr>
						<tr>
							##付款账号名称
							<td class="textRight">#springMessage('table.nisBillhead.payerAccName')</td>
							<td>$!{nisBillheadPage.payerAccName}</td>
							##收款账号名称
							<td class="textRight">#springMessage('table.nisBillhead.payeeAccName')</td>
							<td>$!{nisBillheadPage.payeeAccName}</td>
						</tr>
						<tr>
							##付款开户行
							<td class="textRight">#springMessage('table.nisBillhead.payerBank')</td>
							<td>$!{nisBillheadPage.payerBank}</td>
							##收款开户行
							<td class="textRight">#springMessage('table.nisBillhead.payeeBank')</td>
							<td>$!{nisBillheadPage.payeeBankCode} $!{nisBillheadPage.payeeBank}</td>
						</tr>
						<tr>
							##币别
							<td class="textRight">#springMessage('table.nisBillhead.curId')</td>
							<td>$!{nisBillheadPage.curName}</td>
							##省市
							<td class="textRight"><div id="payeeAddrDiv">#springMessage('table.nisBillhead.payeeAddr')</div></td>
							<td>$!{nisBillheadPage.provName} $!{nisBillheadPage.cityName}</td>
						</tr>
						<tr id="difBankDiv">
							##跨行标志
							<td class="textRight" colspan="2">#springMessage('table.nisBillhead.difBank')</td>
							<td>
								<div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.difBank" data-defaultvalue="$!{nisBillheadPage.difBank}" data-name="difBank" data-biz-name="difBank"></div>
							</td>
							##地域标志
							<td class="textRight" colspan="2">#springMessage('table.nisBillhead.areaSign')</td>
							<td>
								<div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.areaSign" data-defaultvalue="$!{nisBillheadPage.areaSign}" data-name="areaSign" data-biz-name="areaSign"></div>
							</td>
						</tr>
						</tbody>
					</table>
				</div>
			</div>
			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('table.nisBillhead.payInfo')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
						<tr>
							##银行账号
							<td class="textRight" width="20%">#springMessage('table.nisBillhead.bankAcc')</td>
							<td width="30%">
								<div class="layui-input-inline">
									#if($!{allowEditDownacc} == "0")
										<input type="hidden" id="payerAcc" name="payerAcc" data-biz-name="payerAcc" lay-verify="required" value="$!{bankAcc}"
											   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.bankAcc')">
										<input type="text" id="payerAccShow" name="payerAccShow" data-biz-name="payerAccShow" lay-verify="required" value="$!{bankAcc}" readonly="readonly"
											   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.bankAcc')">
									#else
										<input type="text" id="payerAcc" name="payerAcc" data-biz-name="payerAcc" lay-verify="required" value="$!{bankAcc}"
											   autocomplete="off" class="layui-input text"  placeholder="#springMessage('table.nisBillhead.bankAcc')">
									#end
									<table id="payerAccTable" class="hide">
										<thead>
										<tr>
											<th>#springMessage('table.nisBillhead.payerAcc')</th>
											<th>#springMessage('table.nisBillhead.payerAccName')</th>
											<th>#springMessage('table.nisBillhead.payerBank')</th>
											<th>#springMessage('table.nisBillhead.curId')</th>
										</tr>
										</thead>
									</table>
								</div>
							</td>
							##银行账号名称
							<td class="textRight" width="20%">#springMessage('table.nisBillhead.bankAccName')</td>
							<td width="30%">
								<div class="layui-input-inline">
									<input type="text" id="payerAccName" name="payerAccName" lay-verify="required" readonly="readonly" value="$!{accName}"
										   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.bankAccName')">
								</div>
							</td>
						</tr>
						#if($!{nisBillheadPage.sysVoucherCode} == "02")
						<tr id="downAccDiv">
							##下拨账号
							<td class="textRight">#springMessage('table.nisBillhead.downAccId')</td>
							<td>
								<input type="text" id="bankAcc" name="bankAcc" lay-verify="required" readonly="readonly" value="$!{prentAcc.bankAcc}"
									   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.downAccId')">
							</td>
							<td class="textRight">#springMessage('table.nisBillhead.downAccName')</td>
							<td>
								<input type="text" id="bankAccName" name="bankAccName" lay-verify="required" readonly="readonly" value="$!{prentAcc.accName}"
									   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.downAccName')">
							</td>
						</tr>
						#end
						<tr>
							##金额
							<td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
							<td>
								$!number.formatNumeric($!{nisBillheadPage.payMoney})
								<input type="hidden" data-name="payMoney" data-toUp="payMoneyUp" autocomplete="off"
									class="layui-input bt-biz-moneyType" value="$!{nisBillheadPage.payMoney}">
							</td>
							<td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
							<td style="padding-left:0px"><div id="payMoneyUp"></div></td>
						</tr>
						<tr>
							##加急标志
							<td class="textRight">#springMessage('table.nisBillhead.isQuick')</td>
							<td>$dictTag.get("sf_yn",$!{nisBillheadPage.isQuick})</td>
							##期望支付日期
							<td class="textRight">#springMessage('table.nisBillhead.wishPayday')</td>
							<td>$!date.format('yyyy-MM-dd',$!{nisBillheadPage.wishPayday})</td>
						</tr>
						<tr>
							##会计凭证号
							<td class="textRight">#springMessage('table.nisBillhead.bursarBillNo')</td>
							<td>$!{nisBillheadPage.bursarBillNo}</td>
							##业务类别
							<td class="textRight">#springMessage('table.nisBillhead.busType')</td>
							<td>$!{nisBillheadPage.busTypeName}</td>
						</tr>
						<tr>
							##是否对私付款
							<td class="textRight">#springMessage('table.nisBillhead.isForindividual')</td>
							<td>$dictTag.get("sf_yn",$!{nisBillheadPage.isForindividual})</td>
							#if($!{showIsPayed} == "1")
								##是否已付款
								<td class="textRight">#springMessage('table.nisBillhead.isPayed')</td>
								<td>$dictTag.get("nisBillhead.isPayed",$!{nisBillheadPage.isPayed})</td>
							#else
								<td colspan="2"></td>
								<td></td>
							#end
						</tr>
						<tr>
							##是否垫支
							<td class="textRight">#springMessage('table.nisBillhead.isAdvance')</td>
							<td colspan="3">$dictTag.get("nisBillhead.isPayed",$!{nisBillheadPage.isAdvance})</td>
						</tr>
						#if($!{nisBillheadPage.isAdvance} == "1")
						<tr id="isAdvanceTr">
							##营运资金比例
							<td class="textRight">#springMessage('table.nisBillhead.workCapitalRatio')</td>
							<td>$!rateTag.show($!{nisBillheadPage.workCapitalRatio})</td>
							##预计收回日期
							<td class="textRight">#springMessage('table.nisBillhead.takeBackDate')</td>
							<td>$!date.format('yyyy-MM-dd',$!{nisBillheadPage.takeBackDate})</td>
						</tr>
						#end
						<tr>
							##用途
							<td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
							<td>$!{nisBillheadPage.purpose}</td>
							##附言
							<td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
							<td>$!{nisBillheadPage.addWord}</td>
						</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<div style="text-align: center; padding-top: 10px;">
			<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
			<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		</div>
	</form>
    #parse("views/common/footer.vm")
	#caDataHidden()
	#caDataScript()
</body>
</html>
<script src="${basePath}/static/modules/netbank/nisBillhead.execute.js?_btv=${resourceVersion}"></script>
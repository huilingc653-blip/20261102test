<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body {
            font-size: 14px;
            padding-bottom: 60px;
        }

        .layui-form-label {
            width: 180px;
        }

        .layui-input-block {
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.allot.param.titile.usually')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## 指令发送模式
                        <td class="textRight">#springMessage('config.nis.bisExcAutoAccount')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="allot.bisExcAutoAccount" value="1"
                                       #if($config.allot.bisExcAutoAccount == 1)checked#end
                                       title="#springMessage('config.nis.autoBisExcAccount')">
                                <input type="radio" name="allot.bisExcAutoAccount" value="0"
                                       #if($config.allot.bisExcAutoAccount == 0)checked#end
                                       title="#springMessage('config.nis.manualBisExcAccount')">
                            </div>
                            <div class="layui-input-inline">
                                <i id="bisExcAutoAccount-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 请款审批时是否允许修改金额
                        <td class="textRight">#springMessage('config.allot.askAllowEditMoney')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-name="allot.askAllowEditMoney"
                                 data-biz-name="allot.askAllowEditMoney" data-value="$config.allot.askAllowEditMoney"
                                 data-defaultvalue="0"></div>
                        </td>
                    </tr>
                    <tr>
                        ##请款指令发送权限：1-付款方/0-收款方
                        <td class="textRight">#springMessage('config.allot.askExcSendGrant')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-group="askExcSendGrant"
                                     data-name="allot.askExcSendGrant"
                                     data-biz-name="allot.askExcSendGrant" data-value="$config.allot.askExcSendGrant"
                                     data-defaultvalue="0"></div>
                            </div>
                            <div class="layui-input-inline">
                                <i id="askExcSendGrant-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##手动调拨单是否要与付款明细勾对
                        <td class="textRight">#springMessage('config.allot.allocationAllowBlending')</td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                     data-name="allot.allocationAllowBlending"
                                     data-biz-name="allot.allocationAllowBlending" data-value="$config.allot.allocationAllowBlending"
                                     data-defaultvalue="0"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##营收账号数量
                        <td class="textRight">营收账号数量</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="text" name="allot.revenueAccountsNumber" data-min="0" data-max="99999999" data-type="int" autocomplete="off" class="layui-input bt-money"
                                       value="$!{config.allot.revenueAccountsNumber}">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##需求清单是否自动提交头寸调拨
                        <td class="textRight">需求清单是否自动提交头寸调拨</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                     data-name="allot.aotuSubmitPos"
                                     data-biz-name="allot.aotuSubmitPos" data-value="$config.allot.aotuSubmitPos"
                                     data-defaultvalue="0"></div>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.allot.param.titile.check')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## 是否记账
                        <td width="20%" class="textRight">#springMessage('config.allot.isAccount')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                     data-name="allot.isAccount"
                                     data-biz-name="allot.isAccount" data-value="$config.allot.isAccount"
                                     data-defaultvalue="0"></div>
                            </div>
                            ## <div class="layui-input-inline" style="color:red">#springMessage('config.nis.isAccount.desc')</div>
                            <div class="layui-input-inline">
                                <i id="isAccount-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 头寸调拨是否记账
                        <td width="20%" class="textRight">#springMessage('nis.position.of.allocation')#springMessage(
                            'config.allot.isAccount')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                     data-name="allot.isAccountPos"
                                     data-biz-name="allot.isAccountPos" data-value="$config.allot.isAccountPos"
                                     data-defaultvalue="0"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 记账模式
                        <td class="textRight">#springMessage('config.nis.accountMode')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="allot.isAutoAccount" value="1"
                                       #if($config.allot.isAutoAccount == 1)checked#end
                                       title="#springMessage('config.nis.autoAccount')" lay-filter="isAutoAccount">
                                <input type="radio" name="allot.isAutoAccount" value="0"
                                       #if($config.allot.isAutoAccount == 0)checked#end
                                       title="#springMessage('config.nis.manualAccount')" lay-filter="isAutoAccount">
                            </div>
                            <div class="layui-input-inline">
                                <i id="accountMode-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr style="display:none" id="payAccountTr">
                        ## 记账顺序
                        <td class="textRight">#springMessage('config.nis.accountOrder')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="allot.payAccount" value="0"
                                       #if($config.allot.payAccount == 0)checked#end
                                       title="#springMessage('config.nis.accountPay')">
                                <input type="radio" name="allot.payAccount" value="1"
                                       #if($config.allot.payAccount == 1)checked#end
                                       title="#springMessage('config.nis.payAccount')">
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.allot.param.titile.budget')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## 是否挂接资金计划
                        <td width="20%" class="textRight">#springMessage('config.nis.budgetSel')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                     data-name="allot.budgetSel"
                                     data-biz-name="allot.budgetSel" data-value="$config.allot.budgetSel"
                                     data-defaultvalue="0"></div>
                            </div>
                        </td>
                    </tr>
                    <!-- zuoy 2018-05-31 下拨暂存不挂计划
                <tr>
                    <td width="20%" class="textRight">#springMessage('config.allot.downItem')</td>
                    <td width="80%">
                      <div class="layui-input-inline">
                            <input type="text" name="allot.downItem" autocomplete="off" class="layui-input" value="$!{config.allot.downItem}">
                     </div>
                    <div class="layui-input-inline" style="color:red">#springMessage('config.nis.payItem.desc')</div>
                    </td>
                </tr>
                -->
                    <tr>
                        ## 请款默认计划科目
                        <td width="20%" class="textRight">#springMessage('config.allot.askItem')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="text" name="allot.askItem" autocomplete="off" class="layui-input"
                                       value="$!{config.allot.askItem}">
                            </div>
                            ## <div class="layui-input-inline" style="color:red">#springMessage('config.nis.incItem.desc')</div>
                            <div class="layui-input-inline">
                                <i id="askItem-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.allot.param.titile.warnstrategy')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## 内部账户余额不足
                        <td width="20%" class="textRight">#springMessage('config.nis.accountOverType')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="allot.accountOver" value="0"
                                       #if($config.allot.accountOver == 0)checked#end
                                       title="#springMessage('config.nis.noprompt')">
                                <input type="radio" name="allot.accountOver" value="1"
                                       #if($config.allot.accountOver == 1)checked#end
                                       title="#springMessage('config.nis.promptnocontrol')">
                                <input type="radio" name="allot.accountOver" value="2"
                                       #if($config.allot.accountOver == 2)checked#end
                                       title="#springMessage('config.nis.control')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 银行账户余额不足
                        <td width="20%" class="textRight">#springMessage('config.nis.bankaccOverType')</td>
                        <td width="80%">
                            <div class="layui-input-inline">
                                <input type="radio" name="allot.bankaccOver" value="0"
                                       #if($config.allot.bankaccOver == 0)checked#end
                                       title="#springMessage('config.nis.noprompt')">
                                <input type="radio" name="allot.bankaccOver" value="1"
                                       #if($config.allot.bankaccOver == 1)checked#end
                                       title="#springMessage('config.nis.promptnocontrol')">
                                <input type="radio" name="allot.bankaccOver" value="2"
                                       #if($config.allot.bankaccOver == 2)checked#end
                                       title="#springMessage('config.nis.control')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 审批时银行账户余额不足
                        <td class="textRight">#springMessage('config.nis.bankaccOverApproveType')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="allot.bankaccOverApprove" value="0"
                                       #if($config.allot.bankaccOverApprove == 0)checked#end
                                       title="#springMessage('config.nis.noprompt')">
                                <input type="radio" name="allot.bankaccOverApprove" value="1"
                                       #if($config.allot.bankaccOverApprove == 1)checked#end
                                       title="#springMessage('config.nis.promptnocontrol')">
                                <input type="radio" name="allot.bankaccOverApprove" value="2"
                                       #if($config.allot.bankaccOverApprove == 2)checked#end
                                       title="#springMessage('config.nis.control')">
                            </div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="20%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form', 'jquery', 'element', 'dicts'], function () {
        var form = bt.form(), $ = bt.jquery;
        var dicts = bt.dicts.init();
        bt.element();
        form.on('radio(isAutoAccount)', function (data) {
            if (data.value == 0) {
                $("#payAccountTr").show();
            } else {
                $("#payAccountTr").hide();
            }
        });

        //监听提交
        form.on('submit(configSubmit)', function (data) {
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, "JSON");
            return false;
        });

        if ($("input[name='allot.isAutoAccount']:checked").val() == '0') {
            $("#payAccountTr").show();
        }

        // 说明显示隐藏
        showDesc();
    });

    function showDesc() {
        var tip_index1 = 0;
        $('#bisExcAutoAccount-desc').mouseenter(function () {
            tip_index1 = layer.tips(bt.lang('config.allot.bisExcAutoAccount.desc'), '#bisExcAutoAccount-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index1);
        });

        var tip_index2 = 0;
        $('#askExcSendGrant-desc').mouseenter(function () {
            tip_index2 = layer.tips(bt.lang('config.allot.askExcSendGrant.desc'), '#askExcSendGrant-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index2);
        });

        var tip_index3 = 0;
        $('#isAccount-desc').mouseenter(function () {
            tip_index3 = layer.tips(bt.lang('config.allot.isAccount.desc'), '#isAccount-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index3);
        });

        var tip_index4 = 0;
        $('#accountMode-desc').mouseenter(function () {
            tip_index4 = layer.tips(bt.lang('config.allot.accountMode.desc'), '#accountMode-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index4);
        });

        var tip_index5 = 0;
        $('#askItem-desc').mouseenter(function () {
            tip_index5 = layer.tips(bt.lang('config.nis.incItemBudgetSel.desc'), '#askItem-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index5);
        });
    }
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input id="ini_status" name="ini_status" type="hidden" value="0,-1">
        <input id="opType" name="opType" type="hidden" value="touchQuery">##制单查询
        <input type="hidden" id="budgetSel" value="$!configTag.getConfig('exp','budgetSel')">##是否挂计划
        <input type="hidden" id="expFbsin" value="$!configTag.getConfig('exp','expFbsin')">##报销计划挂接环节
		<table class="layui-table">
            <tbody>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                    <td>
                        <div class="layui-inline">
                        	<div class="bt-biz-corp"
                                data-biz-type="corp"
                                data-type="selectTree"
                                data-name="likes_corpId"
                                data-resource="netbank:expense:nisExpenseDetail:touchQuery"
                                data-scope="all"></div>
                        </div>
                    </td>
					##银行账号
                    <td class="textRight">#springMessage('table.nisExpenseDetail.bankAcc')</td>
                    <td>
                        <input type="text" name="likes_bankAcc"
                            autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.nisExpenseDetail.bankAcc')">
                    </td>
    				##报账日期
                    <td class="textRight">#springMessage('table.nisExpenseDetail.expenseDate')</td>
                    <td>
                        <input type="text" name="ged_expenseDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_expenseDate" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_expenseDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_expenseDate">
                    </td>
                </tr>
				<tr>
                ##业务类型
                    <td class="textRight">#springMessage('table.nisExpenseDetail.busType')</td>
                    <td >
                        <div class="bt-biz-selectType" data-url="${basePath}/expense/nisbusinesstype/json" data-callback="busTypeCallBack"
                             data-name="eqs_busType" data-valueField="busType" id="busType" data-textField="busTypeName" data-biz-name="busType" ></div>
                    </td>
                ##操作类型
                    <td class="textRight">#springMessage('table.nisExpenseDetail.opType')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/expense/nisbusinesstype/getOpType?busType=02"
                             data-name="eqs_opType" data-valueField="opType" data-textField="opTypeName" data-biz-name="opType"  data-callback="opTypeCallBack"></div>
                    </td>
					##金额
                    <td class="textRight">#springMessage('table.nisExpenseDetail.expenseMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" name="geg_expenseMoney" id="geg_expenseMoney"
                                    autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="leg_expenseMoney" placeholder="#springMessage('table.nisExpenseDetail.expenseMoney')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" name="leg_expenseMoney" id="leg_expenseMoney"
                                    autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" placeholder="#springMessage('table.nisExpenseDetail.expenseMoney')">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary" data-callback="resetSelect">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>	
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.nisExpenseDetail.expenseId')</th>
                <th>#springMessage('table.nisExpenseDetail.corpId')</th>
                <th>#springMessage('table.nisExpenseDetail.expenseDate')</th>
                <th>#springMessage('table.nisExpenseDetail.expenseMoney')</th>
                <th>#springMessage('table.nisExpenseDetail.accName')</th>
                <th>#springMessage('table.nisExpenseDetail.bankAcc')</th>
                <th>#springMessage('table.nisExpenseDetail.bankName')</th>
                <th>#springMessage('table.nisExpenseDetail.bankCode')</th>
                <th>#springMessage('table.nisExpenseDetail.busType')</th>
                <th>#springMessage('table.nisExpenseDetail.opType')</th>
                <th>#springMessage('table.nisExpenseDetail.purpose')</th>
                <th>#springMessage('table.nisExpenseDetail.status')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/js/paymentLimitAlert.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/expense/nisExpenseDetail.list.js?_btv=${resourceVersion}"></script>
</html>

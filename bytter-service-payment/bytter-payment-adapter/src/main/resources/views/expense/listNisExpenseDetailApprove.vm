<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
    <table class="layui-table">
        <tbody>
        <tr>
        ##银行账号
            <td class="textRight">#springMessage('table.nisExpenseDetail.bankAcc')</td>
            <td>
                <input type="text" name="likes_bankAcc"
                       autocomplete="off" class="layui-input bank"
                       placeholder="#springMessage('table.nisExpenseDetail.bankAcc')">
            </td>
        ##报账日期
            <td class="textRight">#springMessage('table.nisExpenseDetail.expenseDate')</td>
            <td>
                <input type="text" name="ged_expenseDate" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_expenseDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_expenseDate" class="layui-input bt-input-inline bt-biz-dateType"
                       id="led_expenseDate">
            </td>
        ##业务类型
            <td class="textRight">#springMessage('table.nisExpenseDetail.busType')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/expense/nisbusinesstype/json"
                     data-name="eqs_busType" data-valueField="busType" data-textField="busTypeName"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                    'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisExpenseDetail.expenseId')</th>
        <th>#springMessage('table.nisExpenseDetail.corpId')</th>
        <th>#springMessage('table.nisExpenseDetail.expenseDate')</th>
        <th>#springMessage('table.nisExpenseDetail.expenseMoney')</th>
        <th>#springMessage('table.nisExpenseDetail.accName')</th>
        <th>#springMessage('table.nisExpenseDetail.bankAcc')</th>
        <th>#springMessage('table.nisExpenseDetail.bankName')</th>
        <th>#springMessage('table.nisExpenseDetail.bankCode')</th>
        <th>#springMessage('table.nisExpenseDetail.busType')</th>
        <th>#springMessage('table.nisExpenseDetail.opType')</th>
        <th>#springMessage('table.nisExpenseDetail.purpose')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
    #paymentWorkFlowScript()
<script src="${basePath}/static/modules/expense/nisExpenseDetailApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

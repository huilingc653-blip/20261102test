<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input id="billId" name="billId" type="hidden" value="$!{nisExpenseDetailPage.billId}">
		<input id="voucherStat" name="voucherStat" type="hidden" value="3">
		<input id="returnMsg" name="returnMsg" type="hidden" value="$!{nisExpenseDetailPage.returnMsg}">
		<input id="returnTime" name="returnTime" type="hidden" value="$!{nisExpenseDetailPage.returnTime}">
		<input id="billFrom" name="billFrom" type="hidden" value="0">
		<input id="erpId" name="erpId" type="hidden" value="$!{nisExpenseDetailPage.erpId}">
		<input id="status" name="status" type="hidden" value="$!{nisExpenseDetailPage.status}">
		<input id="createBy" name="createBy" type="hidden" value="$!{nisExpenseDetailPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{nisExpenseDetailPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{nisExpenseDetailPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{nisExpenseDetailPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{nisExpenseDetailPage.id}">
		<input id="expenseId" name="expenseId" type="hidden" value="$!{nisExpenseDetailPage.expenseId}">
		<input id="workId" name="workId" type="hidden" value="$!{nisExpenseDetailPage.workId}">
		<!-- 系统参数 -->
		<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
		<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
		<input id="expFbsin" name="expFbsin" type="hidden" value="$!{expFbsin}">
		<table class="layui-table">
			<tbody>
            	<tr>
            		##单位
    				<td class="textRight">#springMessage('table.nisExpenseDetail.corpId')</td>
    				<td width="40%">
    					<div class="layui-input-inline">
                			<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-name="corpId"
                            data-scope="all"
            				data-required="true"
							data-resource="netbank:expense:nisExpenseDetail:touchApply"
                        	data-callback="bt.corpCallback"></div>
                        </div>
    				</td>
    				##报账日期
    				<td class="textRight">#springMessage('table.nisExpenseDetail.expenseDate')</td>
    				<td width="40%">
    					<div class="layui-input-inline">
							<input type="text" name="expenseDate" lay-verify="required" class="layui-input bt-biz-dateType"
								data-today="true" data-type="date" data-name="expenseDate" data-biz-name="expenseDate" data-callback="dateCallBack">
                        </div>
    				</td>				
            	</tr>
    			<tr>
            		##业务类型
    				<td class="textRight">#springMessage('table.nisExpenseDetail.busType')</td>
    				<td width="40%">
                        <div class="bt-biz-selectType" data-url="${basePath}/expense/nisbusinesstype/json" data-callback="busTypeCallBack"
                             data-name="busType" data-valueField="busType" data-textField="busTypeName" data-biz-name="busType"  data-required="true" data-defaultvalue="02" ></div>
    				</td>
    				##操作类型
    				<td class="textRight">#springMessage('table.nisExpenseDetail.opType')</td>
    				<td width="40%">
                        <div class="bt-biz-selectType" data-url="${basePath}/expense/nisbusinesstype/getOpType?busType=02"
                             data-name="opType" data-valueField="opType" data-textField="opTypeName" data-biz-name="opType" data-required="true" data-selecttext="false" ></div>
    				</td>
            	</tr>
    			<tr>
            		##职工姓名
    				<td class="textRight">#springMessage('table.nisExpenseDetail.userName')</td>
    				<td width="40%">
    					<div class="layui-input-inline">
                			<input type="text" id="userName" name="userName" lay-verify="required"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisExpenseDetail.userName')">
                            <div class="bt-div-search">
                                <button class="bt-biz-personnelDetail" id="selPersonnelDetailBut" type="button"  data-callback="bt.personnelDetailCallback" title="#springMessage('common.button.select')">
                                    <i class="layui-icon">&#xe615;</i>
                                </button>
                            </div>
                        </div>
    				</td>
    				##部门名称
    				<td class="textRight">#springMessage('table.nisExpenseDetail.deptName')</td>
    				<td width="40%">
    					<div class="layui-input-inline">
        	        		<input type="text" id="deptName" name="deptName"
    	                     autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisExpenseDetail.deptName')">
                        </div>
    				</td>				
            	</tr>
    			<tr>
            		##接口代码
    				<td class="textRight">#springMessage('table.nisExpenseDetail.bifName')</td>
    				<td width="40%">
						<div class="layui-inline">
    						<div class="bt-biz-selectType" data-name="bifCode" data-biz-name="bifCode" data-url="${basePath}/basic/business/bisbifinit/json"
    							data-valuefield="id" data-textfield="name" ></div>
                        </div>
    				</td>
    				##开户银行名称
    				<td class="textRight">#springMessage('table.nisExpenseDetail.bankName')</td>
    				<td width="40%">
    					<div class="layui-input-inline">
        	        		<input type="text" id="bankCode" name="bankCode" readonly="readonly"
    							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisExpenseDetail.bankCode')">
                            <div class="bt-div-search">
                                <button class="bt-biz-bankInfo" id="selPayeeBankBut" type="button"  data-callback="bt.bankinfoCallback" title="#springMessage('common.button.select')">
                                    <i class="layui-icon">&#xe615;</i>
                                </button>
                            </div>
                        </div>
    					<div class="layui-input-inline">
        	        		<input type="text" id="bankName" name="bankName" readonly="readonly" style="width:300px;"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisExpenseDetail.bankName')">
                        </div>
    				</td>
            	</tr>
    			<tr>
            		##银行卡类型
    				<td class="textRight">#springMessage('table.nisExpenseDetail.cardType')</td>
    				<td width="40%">
						<div class="bt-biz-dict" data-type="select" data-group="nisPersonnelDetail.cardType" data-required="true"
							 data-name="cardType" data-biz-name="cardType"></div>
    				</td>
    				##所在省
    				<td class="textRight">#springMessage('table.nisExpenseDetail.addr')</td>
    				<td width="40%">
                        <div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="prov" data-change="city" data-defaultvalue="" data-required="true"></div>
    					<div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="city" data-defaultvalue="" data-required="true"></div>
					
    				</td>				
            	</tr>
    			<tr>
            		##银行账号
    				<td class="textRight">#springMessage('table.nisExpenseDetail.bankAcc')</td>
    				<td width="40%">
    					<div class="layui-input-inline">
    						<input type="text" id="bankAcc" name="bankAcc"  lay-verify="required"
    							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisExpenseDetail.bankAcc')">
                        </div>
    				</td>
    				##账户名
    				<td class="textRight">#springMessage('table.nisExpenseDetail.accName')</td>
    				<td width="40%">
    					<div class="layui-input-inline">
        	        		<input type="text" id="accName" name="accName"  lay-verify="required"
    							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisExpenseDetail.accName')">
                        </div>
    				</td>				
            	</tr>
    			<tr>
            		##报账金额
    				<td class="textRight">#springMessage('table.nisExpenseDetail.expenseMoney.lower')</td>
    				<td width="40%">
						<input type="text"  data-name="expenseMoney" data-biz-name="expenseMoney" lay-verify="required|number2"
							class="layui-input bt-biz-moneyType" style="text-align:right" data-minus="true" data-toUp="moneyUp"
							autocomplete="off" placeholder="#springMessage('table.nisExpenseDetail.expenseMoney.lower')">
    				</td>
    				<td class="textRight">#springMessage('table.nisExpenseDetail.expenseMoney.upper')</td>
    				<td style="padding-left:0px">
                        <div id="moneyUp"></div>
        			</td>				
            	</tr>
    			<tr>
            		##用途
    				<td class="textRight">#springMessage('table.nisExpenseDetail.purpose')</td>
    				<td width="40%">
                        <div class="bt-biz-selectType" data-url="" data-name="purpose" data-biz-name="purpose"
                             data-valuefield="purpose" data-textfield="purpose" data-inputvalue="inputvalue" data-search="true" data-required="true"></div>
    				</td>
    				##说明
    				<td class="textRight">#springMessage('table.nisExpenseDetail.rmk')</td>
    				<td width="40%">
    					<div class="layui-input-inline">
    						<input type="text" id="rmk" name="rmk" 
    							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisExpenseDetail.rmk')">
                        </div>
    				</td>				
            	</tr>
    			<tr>
    				<td colspan="6" style="text-align: center;">
    					<button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
        	            <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                        <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetSelect">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
			</tbody>
        </table>
		<!-- 资金计划 -->
		<div id="tagItemDetail"></div>
		<!-- 附件上传 -->
		<input id="attachmentId" name="attachmentId" type="hidden">
		<div id="uploader" class="layui-input-inline" style="width:100%"></div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/js/paymentLimitAlert.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/expense/nisExpenseDetail.add.js?_btv=${resourceVersion}"></script>
</html>

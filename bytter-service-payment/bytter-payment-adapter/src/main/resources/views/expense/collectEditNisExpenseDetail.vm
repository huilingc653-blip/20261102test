<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input id="billNo" name="billNo" type="hidden" value="$!{nisBillheadPage.billNo}">
		<input id="caInfoId" name="caInfoId" type="hidden" value="$!{nisBillheadPage.caInfoId}">
		<input id="tallyDate" name="tallyDate" type="hidden" value="$!{nisBillheadPage.tallyDate}">
		<input id="orderNo" name="orderNo" type="hidden" value="$!{nisBillheadPage.orderNo}">
		<input id="voucherNo" name="voucherNo" type="hidden" value="$!{nisBillheadPage.voucherNo}">
		<input id="erpId" name="erpId" type="hidden" value="$!{nisBillheadPage.erpId}">
		<input id="billFrom" name="billFrom" type="hidden" value="$!{nisBillheadPage.billFrom}">
		<input id="splitId" name="splitId" type="hidden" value="$!{nisBillheadPage.splitId}">
		<input id="mergeId" name="mergeId" type="hidden" value="$!{nisBillheadPage.mergeId}">
		<input id="status" name="status" type="hidden" value="$!{nisBillheadPage.status}">
		<input id="createBy" name="createBy" type="hidden" value="$!{nisBillheadPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{nisBillheadPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{nisBillheadPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{nisBillheadPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{nisBillheadPage.id}">
        <input id="isAdvance" name="isAdvance" type="hidden" value="$!{nisBillheadPage.isAdvance}">
		<!-- 付款方式相关属性 -->
		<input id="sysVoucherCode" name="sysVoucherCode" type="hidden" value="">
		<input id="isAccount" name="isAccount" type="hidden" value="">
		<input id="isBudget" name="isBudget" type="hidden" value="">
		<!-- 付/收款账号相关属性 -->
		<input id="accId" name="accId" type="hidden" value="$!{nisBillheadPage.accId}">
		<input id="bifId" name="bifId" type="hidden" value="$!{nisBillheadPage.bifId}">
		<input id="bifCode" name="bifCode" type="hidden" value="$!{nisBillheadPage.bifCode}">
		<input id="payerBankCode" name="payerBankCode" type="hidden" value="">
		<input id="bankNamePrefix" name="bankNamePrefix" type="hidden" value="">
		<input id="payerProv" name="payerProv" type="hidden" value="">
		<input id="payerCity" name="payerCity" type="hidden" value="">
		<input id="bankTypeId" name="bankTypeId" type="hidden" value="$!{nisBillheadPage.bankTypeId}">
		<input id="payeeAcc" name="payeeAcc" type="hidden" value="$!{nisBillheadPage.payeeAcc}">
		<input id="payeeAccName" name="payeeAccName" type="hidden" value="$!{nisBillheadPage.payeeAccName}">
		<!-- 系统参数 -->
		<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
		<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
		<input id="expFbsin" name="expFbsin" type="hidden" value="$!{expFbsin}">
		<input id="defItemCode" name="defItemCode" type="hidden" value="">
		<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
		<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
		<input id="accountOver" name="accountOver" type="hidden" value="$!{accountOver}">
		<input id="bankaccOver" name="bankaccOver" type="hidden" value="$!{bankaccOver}">
		<input id="balControlType" name="balControlType" type="hidden" value="$!{balControlType}">
		<input id="isOpenLimit" name="isOpenLimit" type="hidden" value="$!{isOpenLimit}">
		#foreach($data in $listNisExpenseDetail)
			<input id="dtlId_$!{data.id}" name="dtlId" type="hidden" value="$!{data.id}">
			<input id="dtlDifBank_$!{data.id}" name="dtlDifBank" type="hidden" value="$!{data.difBank}">
			<input id="dtlAreaSign_$!{data.id}" name="dtlAreaSign" type="hidden" value="$!{data.areaSign}">
			<input id="dtlBankCode_$!{data.id}" name="dtlBankCode" type="hidden" value="$!{data.bankCode}">
			<input id="dtlBankName_$!{data.id}" name="dtlBankName" type="hidden" value="$!{data.bankName}">
			<input id="dtlPayeeProv_$!{data.id}" name="dtlPayeeProv" type="hidden" value="$!{data.payeeProv}">
			<input id="dtlPayeeCity_$!{data.id}" name="dtlPayeeCity" type="hidden" value="$!{data.payeeCity}">
		#end
		<table class="layui-table">
			<tbody>
        	<tr>
        		##单位
				<td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
				<td width="40%">
					<input type="hidden" id="corpId" name="corpId" value="$!{nisBillheadPage.corpId}">
					$!{corp.name}
				</td>
				##付款方式
				<td class="textRight">#springMessage('table.nisBillhead.voucherTypeId')</td>
				<td width="40%">
					<div class="layui-input-inline">
    	        		<input type="hidden" id="voucherTypeIdDef" value="$!{nisBillheadPage.voucherTypeId}">
    	        		<select name="voucherTypeId" id="voucherTypeId" lay-verify="required" lay-search="" lay-filter="voucherTypeId">
    		            	<option value=" "></option>
    		            </select>
                    </div>
				</td>				
        	</tr>
			<tr>
        		##付款账号
				<td class="textRight">#springMessage('table.nisBillhead.payerAcc')</td>
				<td width="40%">
					<div class="layui-input-inline">
						<input type="text" id="payerAcc" name="payerAcc" data-biz-name="payerAcc" lay-verify="required|tableData"
							autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.payerAcc')" value="$!{nisBillheadPage.payerAcc}">
                        <table id="payerAccTable" class="hide">
        			        <thead>
        			            <tr>
        			                <th>#springMessage('table.nisBillhead.payerAcc')</th>
        			                <th>#springMessage('table.nisBillhead.payerAccName')</th>
        			                <th>#springMessage('table.nisBillhead.payerBank')</th>
									<th>#springMessage('table.nisBillhead.curId')</th>
                                    <th>#springMessage('table.btBankAcc.isOnline')</th>
        			            </tr>
        			        </thead>
        			    </table>
					</div>
				</td>
				##付款账号名称
				<td class="textRight">#springMessage('table.nisBillhead.payerAccName')</td>
				<td width="40%">
					<div class="layui-input-inline">
    	        		<input type="text" id="payerAccName" name="payerAccName" lay-verify="required" 
						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payerAccName')" value="$!{nisBillheadPage.payerAccName}">
                    </div>
				</td>				
        	</tr>
			<tr>
        		##付款开户行
				<td class="textRight">#springMessage('table.nisBillhead.payerBank')</td>
				<td width="40%">
					<div class="layui-input-inline">
                		<input type="text" id="payerBank" name="payerBank" lay-verify="required" 
						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payerBank')" value="$!{nisBillheadPage.payerBank}">
                    </div>
				</td>
				##币别
				<td class="textRight">#springMessage('table.nisBillhead.curId')</td>
				<td>
					<div id="curDiv" name="curDiv">$!{nisBillheadPage.curName}</div>
					<input type="hidden" id="curId" name="curId" value="$!{nisBillheadPage.curId}">
				</td>
			</tr>
			<tr>
				##账户余额
				<td class="textRight">#springMessage('table.nisBillhead.balance')</td>
				<td width="40%">
					<div id="balanceDiv" name="balanceDiv">$!number.formatNumeric($!{nisBillheadPage.balance})</div>
					<input type="hidden" id="balance" name="balance" style="text-align:right" readonly="readonly" data-name="balance" data-biz-name="balance"
				 autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.nisBillhead.balance')" value="$!{nisBillheadPage.balance}">
				</td>
				##可用余额
				<td class="textRight">#springMessage('config.nis.balControlType.availBal')</td>
				<td>
					<div id="availBalDiv" name="availBalDiv">$!number.formatNumeric($!{nisBillheadPage.availBal})</div>
					<input type="hidden" id="availBal" name="availBal" style="text-align:right" readonly="readonly" data-name="availBal" data-biz-name="availBal"
						   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('config.nis.balControlType.availBal')" value="$!{nisBillheadPage.availBal}">
				</td>
        	</tr>
			<tr id="downAccDiv" style="display:none">
        		##下拨账号
				<td class="textRight">#springMessage('table.nisBillhead.bankAcc')</td>
				<td width="40%">
					<div class="layui-input-inline">
						<input type="hidden" id="downAccId" name="downAccId" value="$!{nisBillheadPage.downAccId}">
                		<input type="text" id="downAcc" name="downAcc" data-biz-name="downAcc" value="$!{nisBillheadPage.downAcc}"
						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.bankAcc')" value="$!{nisBillheadPage.downAcc}">
						 <table id="downAccTable" class="hide">
        			        <thead>
        			            <tr>
        			                <th>#springMessage('table.btBankAcc.bankAcc')</th>
        			                <th>#springMessage('table.btBankAcc.accName')</th>
        			                <th>#springMessage('table.btBankAcc.bankName')</th>
									<th>#springMessage('table.nisBillhead.curId')</th>
        			            </tr>
        			        </thead>
        			    </table>
                    </div>
				</td>
				##下拨账号户名
				<td class="textRight">#springMessage('table.nisBillhead.bankAccName')</td>
				<td width="40%">
					<div class="layui-input-inline">
						<input type="text" id="downAccName" name="downAccName" readonly="readonly"
						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.bankAccName')" value="$!{nisBillheadPage.downAccName}">
                    </div>
				</td>			
        	</tr>
			<tr>
        		##金额
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
				<td width="40%">
					<div class="layui-input-inline">
                		<input type="text" id="payMoney" name="payMoney" lay-verify="required|number2" data-name="payMoney" data-toUp="payMoneyUp" data-biz-name="payMoney" readonly="readonly"
						 autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" placeholder="#springMessage('table.nisBillhead.payMoney.lower')" value="$!{nisBillheadPage.payMoney}">
                    </div>
				</td>
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
				<td width="40%">
					<div class="layui-input-inline">
						<div id="payMoneyUp" name="payMoneyUp" data-name="payMoneyUp"
					 placeholder="#springMessage('table.nisBillhead.payMoney.upper')">
                    </div>
					</div>
				</td>				
        	</tr>
			<tr>
        		##是否对私付款
				<td class="textRight">#springMessage('table.nisBillhead.isForindividual')</td>
				<td width="40%" colspan="3">
                    <input id="isForindividual" name="isForindividual" type="hidden" value="$!{nisBillheadPage.isForindividual}">
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{nisBillheadPage.isForindividual}" data-name="isForindividualShow" data-biz-name="isForindividualShow" data-required = "true" data-disabled="true"></div>
				</td>
        	</tr>
			<tr>
        		##加急标志
				<td class="textRight">#springMessage('table.nisBillhead.isQuick')</td>
				<td width="40%">
					<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{nisBillheadPage.isQuick}" data-name="isQuick" data-biz-name="isQuick"data-required = "true"></div>
				</td>
				##期望支付日期
				<td class="textRight">#springMessage('table.nisBillhead.wishPayday')</td>
				<td width="40%">
					<div class="layui-input-inline">
						<input type="text" name="wishPayday" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{nisBillheadPage.wishPayday}" 
							data-type="date" data-min="$!{wishPayday}" data-name="wishPayday" data-biz-name="wishPayday" data-callback="dateCallBack">
                    </div>
				</td>
        	</tr>
			<tr>
        		##会计凭证号
				<td class="textRight">#springMessage('table.nisBillhead.bursarBillNo')</td>
				<td width="40%">
					<div class="layui-input-inline">
                		<input type="text" id="bursarBillNo" name="bursarBillNo"
						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.bursarBillNo')" value="$!{nisBillheadPage.bursarBillNo}">
                    </div>
				</td>
				##业务类别
				<td class="textRight">#springMessage('table.nisBillhead.busType')</td>
				<td width="40%">
                    <input type="hidden" id="busTypeDef" name="busTypeDef" value="$!{nisBillheadPage.busType}">
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-url="${basePath}/netbank/niscorpbus/listNisCorpBusVOByCorpIdAndCdSign?cdSign=1&corpId=${nisBillheadPage.corpId}"
                             data-name="busType" data-biz-name="busType" data-callback="busTypeCallback" data-defaultvalue="$!{nisBillheadPage.busType}"
                             data-valuefield="busId" data-textfield="busTypeName" data-search="true"></div>
                    </div>
				</td>				
        	</tr>
			<tr>
        		##用途
				<td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
				<td width="40%">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btpurpose?getByListSort&sysBusType=1&busDtl=1&corpId=${nisBillheadPage.corpId}"
                         data-name="purpose" data-biz-name="purpose" data-defaultvalue="$!{nisBillheadPage.purpose}" data-extraData="true"
                         data-valuefield="purpose" data-textfield="purpose" data-inputvalue="inputvalue" data-search="true" data-required="true"></div>
				</td>
				##附言
				<td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
				<td width="40%">
					<div class="layui-input-inline">
						<input type="text" id="addWord" name="addWord"
						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.addWord')" value="$!{nisBillheadPage.addWord}">
                    </div>
				</td>				
        	</tr>
			#if($!{showIsPayed} == 1)
			<tr>
			#else
			<tr style="display: none">
			#end
				##是否已付款
                <td class="textRight">#springMessage('table.nisBillhead.isPayed')</td>
                <td colspan="3">
                    <div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.isPayed" data-defaultvalue="$!{nisBillheadPage.isPayed}" data-name="isPayed" data-biz-name="isPayed" data-required = "true"></div>
                </td>
            </tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
    	            <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                    <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage('common.button.reset')</button>
				</td>
			</tr>
			</tbody>
        </table>
		<!-- 资金计划 -->
		<div id="tagItemDetail"></div>
		<!-- 附件上传 -->
		<input id="attachmentId" name="attachmentId" type="hidden" value="$!{nisBillheadPage.attachmentId}">
		<div id="uploader" class="layui-input-inline" style="width:100%"></div>
	</form>
	<form id="searchForm">
		<input type="hidden" name="collectId" id="collectId">
		<input type="hidden" name="eqs_billId" value="$!{nisBillheadPage.id}">
		<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
			<tr>
				<th>#springMessage('table.nisExpenseDetail.expenseId')</th>
				<th>#springMessage('table.nisExpenseDetail.expenseDate')</th>
				<th>#springMessage('table.nisExpenseDetail.expenseMoney')</th>
				<th>#springMessage('table.nisExpenseDetail.accName')</th>
				<th>#springMessage('table.nisExpenseDetail.bankAcc')</th>
				<th>#springMessage('table.nisExpenseDetail.bankName')</th>
				<th>#springMessage('table.nisExpenseDetail.bankCode')</th>
				<th>#springMessage('table.nisExpenseDetail.prov')</th>
				<th>#springMessage('table.nisExpenseDetail.city')</th>
				<th class="keep-all">#springMessage('table.nisExpenseDetail.difBank')</th>
				<th class="keep-all">#springMessage('table.nisExpenseDetail.areaSign')</th>
				<th>#springMessage('table.nisExpenseDetail.busType')</th>
				<th>#springMessage('table.nisExpenseDetail.opType')</th>
				<th>#springMessage('table.nisExpenseDetail.purpose')</th>
			</tr>
			</thead>
			<tbody>
			</tbody>
		</table>
		#caDataHidden()
	</form>
    #parse("views/common/footer.vm")
	#caDataScript()
</body>
</html>
<script src="${basePath}/static/js/paymentLimitAlert.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/expense/nisExpenseDetail.collectEdit.js?_btv=${resourceVersion}"></script>

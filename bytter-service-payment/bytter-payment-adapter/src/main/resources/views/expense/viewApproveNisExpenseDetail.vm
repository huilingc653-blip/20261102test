#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<input id="id" name="id" type="hidden" value="$!{nisExpenseDetailPage.id}">
<input id="expenseId" name="expenseId" type="hidden" value="$!{nisExpenseDetailPage.expenseId}">
<input id="corpId" name="corpId" type="hidden" value="$!{nisExpenseDetailPage.corpId}">
<input id="expenseDate" name="expenseDate" type="hidden" value="$!{nisExpenseDetailPage.expenseDate}">
<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
<input id="expFbsin" name="expFbsin" type="hidden" value="$!{expFbsin}">
<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
<input id="attachmentId" name="attachmentId" type="hidden" value="$!{nisExpenseDetailPage.attachmentId}">

<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell">
        #springMessage('table.nisExpenseDetail.expenseId')
        <span class="mui-badge mui-badge-inverted">
            $!{nisExpenseDetailPage.expenseId}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{nisExpenseDetailPage.corpName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisExpenseDetail.expenseDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{nisExpenseDetailPage.expenseDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisExpenseDetail.busType')
        <span class="mui-badge mui-badge-inverted">
            $!{nisExpenseDetailPage.busTypeName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisExpenseDetail.opType')
        <span class="mui-badge mui-badge-inverted">
            $!{nisExpenseDetailPage.opTypeName}
        </span>
    </li>
    <li class="mui-table-view-cell  mui-collapse keep-unfold">
        <a class="mui-navigate-right" href="#">
            #springMessage('table.nisExpenseDetail.userName')
            <span class="mui-badge mui-badge-inverted">
                $!{nisExpenseDetailPage.userName}
            </span>
        </a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('table.nisExpenseDetail.deptName')
                <span class="mui-badge mui-badge-inverted">
                    $!{nisExpenseDetailPage.deptName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.nisExpenseDetail.bankAcc')
                <span class="mui-badge mui-badge-inverted">
                    $!{nisExpenseDetailPage.bankAcc}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.nisExpenseDetail.accName')
                <span class="mui-badge mui-badge-inverted">
                    $!{nisExpenseDetailPage.accName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.nisExpenseDetail.bankName')
                <span class="mui-badge mui-badge-inverted">
                    $!{nisExpenseDetailPage.bankCode} $!{nisExpenseDetailPage.bankName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.nisExpenseDetail.bifName')
                <span class="mui-badge mui-badge-inverted">
                    $!{nisExpenseDetailPage.bifName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.nisExpenseDetail.cardType')
                <span class="mui-badge mui-badge-inverted">
                    $dictTag.get("nisPersonnelDetail.cardType",$!{nisExpenseDetailPage.cardType})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.nisExpenseDetail.addr')
                <span class="mui-badge mui-badge-inverted">
                    $!{nisExpenseDetailPage.provName} $!{nisExpenseDetailPage.cityName}
                </span>
            </li>
        </ul>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisExpenseDetail.expenseMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{nisExpenseDetailPage.expenseMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisExpenseDetail.purpose')
        <span class="mui-badge mui-badge-inverted">
            $!{nisExpenseDetailPage.purpose}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisExpenseDetail.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{nisExpenseDetailPage.rmk}
        </span>
    </li>
    ## 挂接资金计划
    #if($!{budgetSel} == 1)
        #set($fbsBudgetItemDetail = $fbsBudgetTag.getViewItemDetailMobile($!{nisExpenseDetailPage.expenseId}, "", $!{businessName}, $!{processSysname},$!{nisExpenseDetailPage.corpId}, $!{nisExpenseDetailPage.expenseDate}))
        #parse("views/budget/fbsbudget.vm")
    #end
</ul>
    #parse("views/common/wapfooter.vm")
</body>
<script>
    window.onload=function () {
        var attachmentId = $("#attachmentId").val();
        setTimeout(function () {
            BTAppBridge.initAttachmentByGroupId && BTAppBridge.initAttachmentByGroupId(attachmentId);
        },100);
    }
</script>
</html>

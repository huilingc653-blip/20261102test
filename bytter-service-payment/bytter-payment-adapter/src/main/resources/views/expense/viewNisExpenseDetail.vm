<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<!-- 系统参数 -->
		<input id="id" name="id" type="hidden" value="$!{nisExpenseDetailPage.id}">
		<input id="expenseId" name="expenseId" type="hidden" value="$!{nisExpenseDetailPage.expenseId}">
		<input id="corpId" name="corpId" type="hidden" value="$!{nisExpenseDetailPage.corpId}">
		<input id="expenseDate" name="expenseDate" type="hidden" value="$!{nisExpenseDetailPage.expenseDate}">
		<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
		<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
		<input id="expFbsin" name="expFbsin" type="hidden" value="$!{expFbsin}">
		<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
		<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
		<input id="busType" name="busType" type="hidden" value="$!{busType}">
		<div id="print">
		<table class="layui-table">
			<thead>
            <tr>
                <th colspan="4" style="text-align:center">#springMessage('table.nisExpenseDetail.viewTitle')</th>
			</tr>
			</thead>
			<tbody>
			<tr>
        		##报销单号
				<td class="textRight">#springMessage('table.nisExpenseDetail.expenseId')</td>
				<td width="35%">$!{nisExpenseDetailPage.expenseId}</td>
				<td class="textRight">#springMessage('table.nisBillhead.createDate')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{nisExpenseDetailPage.createDate})</td>			
        	</tr>
        	<tr>
        		##单位
				<td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
				<td width="35%">$!{nisExpenseDetailPage.corpName}</td>
				##报账日期
				<td class="textRight">#springMessage('table.nisExpenseDetail.expenseDate')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{nisExpenseDetailPage.expenseDate})</td>				
        	</tr>
			<tr>
        		##业务类型
				<td class="textRight">#springMessage('table.nisExpenseDetail.busType')</td>
				<td width="35%">$!{nisExpenseDetailPage.busTypeName}</td>
				##操作类型
				<td class="textRight">#springMessage('table.nisExpenseDetail.opType')</td>
				<td width="35%">$!{nisExpenseDetailPage.opTypeName}</td>				
        	</tr>
			<tr>
        		##职工姓名
				<td class="textRight">#springMessage('table.nisExpenseDetail.userName')</td>
				<td width="35%">$!{nisExpenseDetailPage.userName}</td>
				##部门名称
				<td class="textRight">#springMessage('table.nisExpenseDetail.deptName')</td>
				<td width="35%">$!{nisExpenseDetailPage.deptName}</td>				
        	</tr>
			<tr>
        		##接口代码
				<td class="textRight">#springMessage('table.nisExpenseDetail.bifName')</td>
				<td width="35%">$!{nisExpenseDetailPage.bifName}</td>
        		##银行卡类型
				<td class="textRight">#springMessage('table.nisExpenseDetail.cardType')</td>
				<td width="35%">$dictTag.get("nisPersonnelDetail.cardType",$!{nisExpenseDetailPage.cardType})</td>
        	</tr>
			<tr>
				##开户银行名称
				<td class="textRight">#springMessage('table.nisExpenseDetail.bankName')</td>
				<td width="35%">$!{nisExpenseDetailPage.bankCode} $!{nisExpenseDetailPage.bankName}</td>				
				##所在省
				<td class="textRight">#springMessage('table.nisExpenseDetail.addr')</td>
				<td width="35%">$!{nisExpenseDetailPage.provName} $!{nisExpenseDetailPage.cityName}</td>			
        	</tr>
			<tr>
        		##银行账号
				<td class="textRight">#springMessage('table.nisExpenseDetail.bankAcc')</td>
				<td width="35%">$!{nisExpenseDetailPage.bankAcc}</td>
				##账户名
				<td class="textRight">#springMessage('table.nisExpenseDetail.accName')</td>
				<td width="35%">$!{nisExpenseDetailPage.accName}</td>				
        	</tr>
			<tr>
        		##报账金额
				<td class="textRight">#springMessage('table.nisExpenseDetail.expenseMoney.lower')</td>
				<td width="35%">
					#if($!{nisExpenseDetailPage.busType} == "04")
						****
					#else
						$!number.formatNumeric($!{nisExpenseDetailPage.expenseMoney})
						<input type="hidden" data-name="expenseMoney" data-toUp="moneyUp" autocomplete="off" 
						class="layui-input bt-biz-moneyType" value="$!{nisExpenseDetailPage.expenseMoney}">
					#end
				</td>
        		##报账金额
				<td class="textRight">#springMessage('table.nisExpenseDetail.expenseMoney.upper')</td>
				<td style="padding-left:0px">
                    <div id="moneyUp"></div>
    			</td>	
        	</tr>
			<tr>
        		##用途
				<td class="textRight">#springMessage('table.nisExpenseDetail.purpose')</td>
				<td width="35%">$!{nisExpenseDetailPage.purpose}</td>
				##说明
				<td class="textRight">#springMessage('table.nisExpenseDetail.rmk')</td>
				<td width="35%">$!{nisExpenseDetailPage.rmk}</td>				
        	</tr>
			</tbody>
        </table>
		<!-- 资金计划 -->
		<div id="tagItemDetail"></div>
		</div>
		<!-- 日志 -->
		<div id="tagMsg"></div>
		<!-- 附件上传 -->
		<input id="attachmentId" name="attachmentId" type="hidden" value="$!{nisExpenseDetailPage.attachmentId}">
		<div id="uploader" class="layui-input-inline" style="width:100%"></div>
		<p>
		<div class="layui-form-item layui-form-submit" id="buttonDiv">
			<div class="layui-input-block">
				<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{nisExpenseDetailPage.id}')">#springMessage('common.button.trackFlow')</button>
				<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
			</div>
        </div>
	</form>
    #parse("views/common/footer.vm")
	<script src="${basePath}/static/modules/expense/nisExpenseDetail.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
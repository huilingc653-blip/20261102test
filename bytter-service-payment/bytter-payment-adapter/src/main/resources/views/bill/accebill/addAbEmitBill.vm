<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
    <style>
        .layui-table {
            margin: 0px 0;
        }

        body {
            margin-bottom: 30px;
        }
    </style>
</head>
<body>
<div class="layui-collapse">
    <form class="layui-form" method="post" id="inputForm">
        <!-- 系统参数  -->
        #set($isBillPool=$licenseTag.isModuleAuth("billPool"))
        <input type="hidden" id="isBillPool" value="$!{isBillPool}"/>
        <input type="hidden" id="isRelateRat" value="$!{isRelateRat}"/>
        <input type="hidden" name="ratIsHangGua" id="ratIsHangGua">
        <input type="hidden" id="mouthRat" value="$!{mouthRat}"/>
        <input type="hidden" id="isOpenCpRat" value="$!{isOpenCpRat}"/>
        <input type="hidden" id="isGuarantee" value="$!{isGuarantee}"/>
        <input type="hidden" id="isEmitMake" value="$!{isEmitMake}"/>
        <input type="hidden" id="curId" name="curCode" value="$!{curId}"/>
        <input type="hidden" id="isBail" value="$!{isBail}"/>
        <input type="hidden" id="bailBankControlType" value="$!{bailBankControlType}"/>
        <input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
        <input id="defItemCode" name="defItemCode" type="hidden" value="">
        <input name="source" type="hidden" value="11">
        <input type="hidden" id="bondId" name="bondId">
        <input type="hidden" id="ratBillMoney" name="ratBillMoney"/>
        <input type="hidden" id="acceptProvince" name="acceptProvince">
        <input type="hidden" id="acceptCity" name="acceptCity">
        <input type="hidden" id="acceptBankTypeId" name="acceptBankTypeId">
        <input type="hidden" id="payeeCorpId" name="payeeCorpId">
        <input type="hidden" id="isOnline" value="">
        <input type="hidden" id="isBatchBill" name="isBatchBill" value="$!{isBatchBill}">
        <input type="hidden" id="voucherId" name="voucherId" value="$!{voucherId}">
        <input type="hidden" id="payeraccPayBill" value="$!{payeracc}">
        <input type="hidden" id="bifCode" value="$!{bifCode}">
        <input type="hidden" id="circulationMode" value="$!{circulationMode}">
        #*是否是付款办理弹窗开票*#
        <input type="hidden" name="isPayFlg" value="$!{isPayFlg}" id="isPayFlg">
        <input type="hidden"  value="$!{allowDifferentBillMoney}" id="allowDifferentBillMoney">
        #if($!{isBatchBill} eq '1')
            <div style="text-align:center;border: 0px;font-size: 18px;">
                <input type="hidden" id="batchNo" name="batchNo" value="$!{batchNo}">
                #springMessage('bill.accebill.batchNo'):$!{batchNo}
            </div>
        #end
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('bill.accebill.billInfo.title')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##开票登记单号
                        <td class="textRight">#springMessage('table.abVoucherinfoVice.appNo')</td>
                        <td>
                            <input type="hidden" id="appNo" name="appNo" value="$!{appNo}">
                            <label id="appNoLabel" class="layui-form-label">$!{appNo}</label>
                        </td>

                    </tr>
                    <tr>
                        ##出票标志
                        <td class="textRight" width="15%">#springMessage('table.abVoucherinfo.newStmIssuofpprInd')</td>
                        <td width="35%">
                            <div class="bt-biz-dict" id="newStmIssuofpprInd" data-callback="newStmIssuofpprIndChange"
                                 data-biz-name="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-type="select" data-required="true"
                                 data-group="AB_BILL_NEW_STM_ISSUOFPPR_IND" data-defaultvalue="1"
                                 data-name="newStmIssuofpprInd"></div>
                        </td>
                        ##是否允许分包
                        <td class="textRight drawBillShow">#springMessage(
                            'table.abVoucherinfo.blgrdbagcrclPrmtInd')</td>
                        <td class="drawBillShow">
                            <div class="bt-biz-dict" data-type="radio" data-group="AB_BILL_BLGRDBAGCRCL_PRMT_IND"
                                 data-defaultvalue="1" id="blgrdbagcrclPrmtInd" data-name="blgrdbagcrclPrmtInd"
                                 data-biz-name="blgrdbagcrclPrmtInd"></div>
                        </td>
                    </tr>
                    <tr>
                        ##申请单位
                        <td class="textRight" width="15%">#springMessage('bill.accebill.applyCorp')</td>
                        <input type="hidden" id="applyCorpIdInput" value="$!{applyCorpId}">
                        <td width="35%">
                            <div class="layui-input-inline" id="applyCorpId">
                                <div class="bt-biz-corp"
                                     data-biz-type="corp"
                                     data-biz-name="applyCorpId"
                                     data-type="selectTree"
                                     data-name="applyCorpId"
                                     data-defaultvalue="$!{applyCorpId}"
                                     data-scope="all"
                                    #if($!{applyCorpId} && $!{applyCorpId} != "")
                                     data-disabled="true"
                                    #end
                                     data-required="true"
                                    ##data-beforeInit="applyCorpBeforeInit"
                                     data-afterInit="applyCorpAfterInit"
                                     data-resource="bill:accebill:abemitbill:query"
                                     data-callbackData="applyCorpCallback"
                                     placeholder="#springMessage('bill.accebill.applyCorp')">
                                </div>
                            </div>
                        </td>
                        ##票据单位
                        <td class="textRight" width="15%">#springMessage('table.abVoucherinfoVice.corpId')</td>
                        <input type="hidden" id="corpIdInput" value="$!{corpId}">
                        <td width="35%">
                            <div class="layui-input-inline" id="corpId">
                                <div class="bt-biz-corp"
                                     data-biz-type="accCorp"
                                     data-biz-name="corpId"
                                     data-type="selectTree"
                                     data-name="corpId"
                                    #if($!{corpId} && $!{corpId} != "")
                                     data-disabled="true"
                                    #end
                                     data-scope="all"
                                     data-required="true"
                                     data-defaultvalue="$!{corpId}"
                                     data-resource="bill:accebill:abemitbill:query"
                                     data-callbackData="corpCallback"
                                     placeholder="#springMessage('table.abVoucherinfoVice.corpId')">
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##业务单位
                        <td class="textRight" width="15%">#springMessage('bill.accebill.busCorp')</td>
                        <td width="35%">
                            <div class="layui-input-inline" id="busCorpId">
                                <div class="bt-biz-corp"
                                     data-biz-type="corp"
                                     data-biz-name="busCorpId"
                                     data-type="selectTree"
                                     data-name="busCorpId"
                                     data-defaultvalue="$!{corpId}"
                                     data-scope="all"
                                     data-resource="bill:accebill:abemitbill:query"
                                     placeholder="#springMessage('bill.accebill.busCorp')">
                                </div>
                            </div>
                        </td>
                        ##业务人员
                        <td class="textRight" width="15%">#springMessage('bill.accebill.busPersonnel')</td>
                        <td width="35%">
                            <div class="layui-input-inline">
                                <input type="text" id="busPersonnel" name="busPersonnel" lay-verify="strlength"
                                       data-maxlength="200"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('bill.accebill.busPersonnel')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##不得转让标记/能否转让
                        <td class="textRight" width="15%">#springMessage('table.abVoucherinfo.banendrsmtmk')</td>
                        <td width="35%">
                            <div class="bt-biz-dict" data-type="select" data-group="AB_BANEM" data-name="banendrsmtmk"
                                 data-defaultvalue="1" data-placeholder=""></div>
                        </td>
                        ##流通介质
                        <td class="textRight" width="15%">#springMessage('table.abVoucherinfo.billFlag')</td>
                        <td width="35%">
                            <div class="bt-biz-dict billFlagClass" id="billFlagId" data-type="radio"
                                 data-group="AB_BILL_FLAG" data-defaultvalue="11" data-name="billFlag"
                                 data-biz-name="billFlag" data-required="true"></div>
                        </td>
                    </tr>
                    <tr>
                        ##业务归属日期
                        <td class="textRight">#springMessage('table.abAccrecords.businessDate')</td>
                        <td>
                            <input type="text" name="businessDate" data-name="businessDate"
                                   class="layui-input bt-biz-dateType" data-today="true"
                                   data-biz-name="businessDate" data-callback="businessDateCallback" data-type="date"
                                   value="$!{abEmitBillSupplyVo.businessDate}">
                        </td>
                        ##票据类型
                        <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="AB_BILL_TYPE" data-defaultvalue="10"
                                 data-name="billType" data-biz-name="billType" data-required="true"></div>
                        </td>
                    </tr>
                    <tr>
                        ##开票方式
                        <td class="textRight">#springMessage('bill.accebill.emitType')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="select" id="emitType" name="emitType"
                                 data-group="ACCEBILL_EMIT_TYPE" data-callback="getLimitInfo" data-name="emitType"
                                 data-biz-name="emitType">
                            </div>
                        </td>
                        ##是否开票保贴
                        <td class="textRight">
                            <div id="emitGuandisSignText" hidden>#springMessage('bill.accebill.emitGuandisSign')</div>
                        </td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-callback="resetBankDiv"
                                 id="emitGuandisSign"
                                 name="emitGuandisSign" data-name="emitGuandisSign" data-biz-name="emitGuandisSign"
                                 hidden></div>
                        </td>
                    </tr>
                    <tr id="poolListId" style="display:none">
                        <td class="textRight">#springMessage('billPool.limit.poolMoney')</td>
                        <td id="poolLimitMoney"></td>
                        <td class="textRight">
                            #springMessage('billPool.limit.validMoney')
                            <input type="hidden" id="poolLimitValidMoneyVal" value="false"/>
                        </td>
                        <td id="poolLimitValidMoney"></td>
                    </tr>
                    <tr>
                        ##出票日期
                        <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                        <td>
                            <input type="text" name="startDate" data-name="startDate"
                                   class="layui-input bt-biz-dateType" data-today="true" data-endid="endDate" data-type="date"
                                   data-biz-name="startDate" data-callback="checkDate" lay-verify="required">
                        </td>
                        ##开出方式
                        <td class="textRight">#springMessage('table.abVoucherinfoVo.openWay')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="AB_BILL_OPENWAY"
                                 data-defaultvalue="0" data-name="insideSing" data-disabled="true" data-biz-name="insideSing"
                                 data-required="true"></div>
                        </td>
                    </tr>
                    <tr>
                        ##到期日期
                        <td class="textRight">#springMessage('table.abVoucherinfo.endDate')</td>
                        <td>
                            <div class="layui-inline">
                                <input type="text" name="endDate" data-name="endDate"
                                       class="layui-input bt-biz-dateType" id="endDate" data-type="date"
                                       data-biz-name="endDate" data-callback="checkDate" lay-verify="required">
                            </div>
                            <div class="layui-inline">
                                #if($!{billSectionThreeButton} == 1)
                                    <button class="layui-btn" type="button" onClick="changeEndDate(3)">#springMessage(
                                    'table.abVoucherinfo.endDate.threeMonth')</button>
                                #end
                                #if($!{billSectionSixButton} == 1)
                                    <button class="layui-btn" type="button" onClick="changeEndDate(6)">#springMessage(
                                    'table.abVoucherinfo.endDate.sixMonth')</button>
                                #end
                            </div>

                        </td>
                        #if(!$!{voucherId})
                            ##票据号码
                            <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                            <td>
                                <input type="text" id="origNo" name="origNo" lay-verify="strlength" data-maxlength="40"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.origNo')">
                            </td>
                        #end
                    </tr>
                    <tr>
                        #if($!{voucherId})
                            <td class="textRight">总开票金额</td>
                        #else
                            ##票据金额
                            <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                        #end
                        <td>

                            <input type="text" data-name="billMoney" data-biz-name="billMoney" class="layui-input bt-biz-moneyType"
                                   #if(!$!{voucherId})lay-verify="required" #end
                                   #if($!{voucherId})readonly="readonly" #end
                                   data-toup="moneyUp" data-callback="getBail"
                                #if($!{isPayFlg} == '1' && $!{allowDifferentBillMoney} == '0')
                                   readonly="readonly"
                                #end
                                   placeholder="#springMessage('table.abVoucherinfo.billMoney')" data-biz-name="test"
                                   id="billMoney"
                                #if($!{payMoney})
                                   value="$!{payMoney}"
                                #end
                                   data-min="0.01">
                        <input type="hidden" class="layui-input bt-biz-moneyType"  data-biz-name="test">
                        </td>
                        ##人民币大写
                        <td class="textRight">#springMessage('table.abVoucherinfo.billMoneyUp')</td>
                        <td>
                            <div class="layui-input-inline layui-input" id="moneyUp"></div>
                        </td>
                    </tr>
                    <tr style="display: none">
                        ##是否保证
                        <td class="textRight">#springMessage('bill.accebill.isEnsure')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0"
                                 data-name="isEnsure" data-biz-name="isEnsure"></div>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('bill.accebill.payer.title')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ##出票人账号
                        <td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payeracc')</td>
                        <td width="35%">
                            <div class="layui-input-inline">
                                <input type="text" id="payeracc" name="payeracc" value="$!{payeracc}" data-name="payeracc"
                                       data-biz-name="payeracc"
                                    #if($!{externalCorpNum} eq '1' ) readonly="readonly" #end
                                       data-resource="bill:accebill:abemitbill:query" lay-verify="required"
                                       data-defaultcorp="$!{corpId}" electricBill="1"
                                       class="bank layui-input bt-biz-accountTable" data-callback="accountPayeeCallBack"
                                       data-biz-name="payeracc">
                            </div>
                        </td>
                        ##出票人
                        <td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payer')</td>
                        <td width="35%">
                            <input type="text" id="payer" value="$!{payer}" name="payer" lay-verify="strlength|required"
                                   data-maxlength="240" readonly="readonly"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.abVoucherinfo.payer')">
                        </td>
                    </tr>
                    <tr>
                        ##出票人开户银行名称
                        <td class="textRight">#springMessage('table.abVoucherinfo.payerBankName')</td>
                        <td>
                            <input type="text" id="payerBankName" value="$!{payerBankName}" name="payerBankName" readonly="true"
                                   lay-verify="required|strlength" data-maxlength="240"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.abVoucherinfo.payerBankName')">
                        </td>
                        ##出票人开户银行行号
                        <td class="textRight">#springMessage('table.abVoucherinfo.payerbankno')</td>
                        <td>
                            <input type="text" id="payerbankno" value="$!{payerbankno}" name="payerbankno" readonly="true"
                                   lay-verify="required|strlength" data-maxlength="30"
                                   autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.abVoucherinfo.payerbankno')">
                        </td>
                    </tr>
                    <tr>
                        ##出票人统一信用代码
                        <td class="textRight" class="textRight drawBillShow">#springMessage(
                            'table.abVoucherinfo.blRmtrUnnIdNo')</td>
                        <td>
                            <input type="text" id="blRmtrUnnIdNo" name="blRmtrUnnIdNo" autocomplete="off"
                                   class="layui-input"
                                   readonly="true" placeholder="#springMessage('table.abVoucherinfo.blRmtrUnnIdNo')">
                        </td>
                        ##
                        <td class="textRight"></td>
                        <td>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>

        #if(!$!{voucherId})
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('bill.accebill.payee.title')</h2> ## 	收票人信息
                <div class="layui-colla-content layui-show">
                    <table class="layui-table">
                        <tbody>
                        <tr id="corpPayee">
                            ##收票人单位
                            <td class="textRight" width="15%">
                                <div class="layui-input-inline" style="display:none">
                                    <span style="color:red;font-size: 14px;font-weight:bold;vertical-align: middle;">*</span>
                                </div>
                                #springMessage('table.abBillTransfer.recevieCorpId')</td>
                            <td width="35%">
                                ##收票人全称--成员单位
                                <div class="layui-input-inline">
                                    <div class="bt-biz-corp"
                                         data-biz-type="corp"
                                         data-biz-name="payeeCorpId"
                                         data-type="selectTree"
                                         data-name="payee1"
                                         id="payee1"
                                         data-scope="all"
                                        ##data-resource="bill:accebill:abemitbill:query"
                                         data-callbackData="payeeCorpCallback"
                                         placeholder="#springMessage('table.abVoucherinfo.payee')">
                                    </div>
                                </div>
                            </td>
                            <td width="15%"></td>
                            <td width="35%"></td>
                        </tr>
                        <tr>
                            ##收票人账号
                            <td class="textRight" width="15%">
                                <div class="layui-input-inline" id="pledgeeAccSpanDiv">
                                    <span style="color:red;font-size: 14px;font-weight:bold;vertical-align: middle;">*</span>
                                </div>
                                #springMessage('table.abVoucherinfo.payeeacc')
                            </td>
                            <td width="35%">
                                <div class="layui-input-inline" id="payeeAccDiv" style="display:none">
                                    ##收票人账号--成员单位
                                    <input type="text" name="payeeacc1" data-name="payeeacc1"
                                           data-biz-name="payeeacc1"
                                           readonly="readonly" value="$!{payeeacc}"
                                        ##data-resource="bill:accebill:abemitbill:query"
                                           data-defaultcorp="xx" electricBill="1" lay-verify="strlength" data-maxlength="30"
                                           class="bank layui-input bt-biz-accountTable" data-callback="onChangePayeeacc"
                                           data-biz-name="payeeacc1"/>
                                </div>
                                <div class="layui-input-inline" id="pledgeeAccDiv">
                                    ##收票人账号--客商
                                    <input type="text" name="payeeacc" lay-verify="strlength"
                                           data-maxlength="30"
                                           readonly="readonly"
                                           value="$!{payeeacc}"
                                           autocomplete="off" class="bank layui-input"
                                           placeholder="#springMessage('table.abVoucherinfo.payeeacc')">
                                    #*<div class="bt-div-search" id="pledgeeNameDiv" style="display:none">
                                        <button class="bt-biz-externalCorpBankAcc" type="button"
                                                data-callback="bt.payeeCorpCallback"
                                                data-beforeClick="bt.externalCorpBankAccParams">
                                            <i class="layui-icon">&#xe615;</i></button>
                                    </div>*#
                                </div>
                            </td>
                            ##收票人全称
                            <td class="textRight" width="15%">#springMessage('table.abVoucherinfo.payee')</td>
                            <td width="35%">
                                ##收票人全称--客商
                                <div class="layui-input-inline" id="payeeAccNameDiv">
                                    <input type="text" name="payee" id="payeeAccName"
                                           readonly="readonly" lay-verify="required|strlength" data-maxlength="240"
                                           autocomplete="off" class="layui-input" value="$!{payeeAccName}"
                                           placeholder="#springMessage('table.abVoucherinfo.payee')">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##收票人开户银行名称
                            <td class="textRight">#springMessage('table.abVoucherinfo.payeeBankName')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" name="payeeBankName" lay-verify="strlength"
                                           data-maxlength="240" value="$!{payeeBankName}"
                                           id="payeeBankName"
                                           autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('table.abVoucherinfo.payeeBankName')">
                                    <div class="bt-div-search" id="payeeBankBtDiv">
                                        <button class="bt-biz-bankInfo" type="button"
                                                data-callback="bt.bailBankInfoCallback" opType="payeeBankClick"><i
                                                class="layui-icon">&#xe615;</i></button>
                                    </div>
                                </div>
                            </td>
                            ##收票人开户银行行号
                            <td class="textRight">#springMessage('table.abVoucherinfo.payeebankno')</td>
                            <td>
                                <input type="text" name="payeebankno" lay-verify="strlength"
                                       data-maxlength="30" value="$!{payeebankno}"
                                       autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('table.abVoucherinfo.payeebankno')">
                            </td>
                        </tr>
                        <tr>
                            ##收票人账户类型
                            #*<td class="textRight">#springMessage('table.externalCorp.accIdentificationType')</td>
                            <td >
                                <div class="bt-biz-dict" hidden="hidden" id = "blRcvpymtpsIdTpcd" data-type="select" data-group="AB_BILL_BL_ID_TPCD" data-name="blRcvpymtpsIdTpcd"
                                     data-label=bt.lang("common.placeholder.select") data-defaultvalue = "DT02"></div>
                                *##*<div class="layui-input-inline">
                                    <input type="text" id="rrr" name="rrr"
                                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.externalCorp.accIdentificationType')">
                                </div>*##*
                            </td>*#
                            ##收票人统一信用代码
                            <td class="textRight" class="textRight drawBillShow">#springMessage(
                            'table.abVoucherinfo.blRcvpymtpsUnnIdNo')</td>
                            <td>
                                <input type="text" name="blRcvpymtpsUnnIdNo" autocomplete="off"
                                       class="layui-input" value="$!{blRcvpymtpsUnnIdNo}"
                                       readonly="true"
                                       placeholder="#springMessage('table.abVoucherinfo.blRcvpymtpsUnnIdNo')">
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        #end

        <div class="layui-colla-item">

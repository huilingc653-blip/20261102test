<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <input type="hidden" id="rowIndex" value="0">
		##业务类型：0主体单位，1交易对手
		<input type="hidden" name="busType" value="1">
		<table class="layui-table">
			<thead>
				<tr>
					<th class="textLeft" colspan="6" >#springMessage("table.fexBankAcc.rule")</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					##交易类型
					<td class="textRight">#springMessage("table.fexBankAcc.tranType")</td>
					<td>
						<div class="layui-inline">
							<div class="bt-biz-dict" data-type="select" data-name="tranType" data-biz-name="tranType" data-required = "true"
								 data-group="fexCorp.tranType" data-callback="tranTypeCallback" data-displayData="4"
								 data-defaultvalue="4"></div>
						</div>
					</td>
					##产品
					<td class="textRight">#springMessage("table.fexBankAcc.proId")</td>
					<td>
						<div class="layui-input-inline">
							<div class="bt-biz-selectType" data-biz-name="proId" data-url="${basePath}/foreign/fexproduct/getInitProductDate" data-method="get"
								 data-name="proId" data-valueField="id" data-textField="proName" data-callback="proIdCallback"></div>##data-beforeInitResiveData="beforeInitPro"
						</div>
					</td>
					##交易对手
					<td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage("table.fexForeign.copt")</td>
					<td>
						<input type="hidden" name="oppId" id="oppId">##数据源id
						<input type="hidden" id="corpName" name="corpName">##对手名称
						<input type="hidden" id="cotpNameEn" name="cotpNameEn">##对手英文名称
						<div class="layui-inline" id="oppCorpNameDiv" style="display: none">##无选择时候展示
							<input class="layui-input"  onclick="oppCorpNameClick()" readonly="readonly" type="text"/>
						</div>
						<div class="layui-inline" id="externalDiv">##客商组件
							<input class="layui-input" id="eOppCorpName" readonly="readonly" type="text"/>
							<div class="bt-div-search">
								## 客商组件
								<button type="button" class="bt-biz-allExternalCorp" data-beforeClick="bt.cotpExternalBeforeClick"  data-callback="cotpExternalCallback">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>
						</div>
						<div class="layui-inline" id="corpDiv" style="display: none">##单位下拉树
							<div class="bt-biz-corp"
								 data-biz-type="corp"
								 data-type="selectTree"
								 data-name="cOppCorpName"
								 data-biz-name="cOppCorpName"
								 data-scope="all"
								 data-callbackData="oppCorpTreeCallback"
							></div>
						</div>
						<div class="layui-inline" id="bankDiv" style="display: none">##银行组件
							<input class="layui-input" id="bOppCorpName" readonly="readonly" type="text"/>
							<div class="bt-div-search">
								## 客商组件
								<button type="button" class="bt-biz-allBankInfo"  data-callback="bankCallback">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>
						</div>
##						<div class="bt-biz-selectType" data-name="corpId" data-url="${basePath}/foreign/fexCotp/listCotp" data-valuefield="id" data-textfield="cotpName"
##							 data-biz-name="corpId" data-callback="bt.corpCallback"></div>##data-beforeInitResiveData="beforeInitCotp"
					</td>
				</tr>
				<tr>
					##单位
					<td class="textRight">#springMessage("table.fexForeign.corpId")</td>
					<td>
						<div class="layui-inline">
							<div class="bt-biz-corp"
								 data-biz-type="corp"
								 data-type="selectTree"
								 data-name="oppCorpId"
								 data-biz-name="oppCorpId"
								 data-scope="all"
								 data-callback="bt.oppCorpIdCallback"
								 data-resource="foreign:fex:cotp:defaultacc:apply"
								 placeholder="#springMessage('common.placeholder.select')"></div>
						</div>
					</td>
					##收付方向
					<td class="textRight">#springMessage("table.fexBankAcc.cdSign")</td>
					<td>
						<div class="layui-inline">
							<div class="bt-biz-dict" data-type="select" data-name="cdSign" data-biz-name="cdSign"
								 data-group="fexCorp.cdSign" ></div>
						</div>
					</td>
					##现金流类型
					<td class="textRight">#springMessage("table.fexBankAcc.cashFlowType")</td>
					<td>
						<div class="layui-inline">
							<div class="bt-biz-dict" data-type="select" data-name="cashFlowType" data-biz-name="cashFlowType"
								 data-group="fexCorp.cashFlowType"></div>
						</div>
					</td>
				</tr>
				<tr>
					##币种
					<td class="textRight">#springMessage('table.fexForeign.curId')</td>
					<td>
						<div class="layui-inline">
							<div class="bt-biz-selectType" data-name="curId" data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-textfield="englishCode"
								 data-callback="curCallback"  data-biz-name="curId" ></div>
						</div>
					</td>
					<td></td>
					<td></td>
					<td></td>
					<td></td>
				</tr>
			</tbody>
		</table>
        <table class="layui-table ignore-required-icon isDown" id="editTable" width="100%">
        	<thead>
				<tr>
					<th colspan="7">
						<span style="float: left">#springMessage("table.fexBankAcc.defaultAcc")</span>
						<span style="float: right">
							 <button type="button" class="layui-btn" lay-filter="add" id="add">#springMessage('common.addTr')</button>
						</span>
					</th>
				</tr>
		   		<tr>
					<th  width="15%"><span class="pl"><span class="required-icon">*</span></span>#springMessage("table.fexBankAcc.effectDate")</th>
					<th  width="15%"><span class="pl"><span class="required-icon">*</span></span>#springMessage("table.fexForeign.bankAcc")</th>
					<th  width="15%">#springMessage("table.fexForeign.cotpAccName")</th>
					<th  width="15%">#springMessage("table.fexForeign.curId")</th>
                    <th  width="15%">#springMessage("common.table.thead.operation")</th>
				</tr>
		    </thead>
            <tbody>
            </tbody>
        </table>
		<table class="layui-table ignore-required-icon isDown" style="display: none" id="fpsEditTable" width="100%">
			<thead>
			<tr>
				<th colspan="7">
					<span style="float: left">#springMessage("table.fexBankAcc.defaultAcc")</span>
					<span style="float: right">
							 <button type="button" class="layui-btn" lay-filter="add" id="fpsAdd">#springMessage('common.addTr')</button>
						</span>
				</th>
			</tr>
			<tr>
				<th  width="15%"><span class="pl"><span class="required-icon">*</span></span>#springMessage("table.fexBankAcc.effectDate")</th>
				<th  width="15%"><span class="pl"><span class="required-icon">*</span></span>#springMessage("ttpay.payeeMode")</th>
				<th  width="15%"><span class="pl"><span class="required-icon">*</span></span>#springMessage("fex.cotp.quickPayment")</th>
				<th  width="15%">#springMessage("common.table.thead.operation")</th>
			</tr>
			</thead>
			<tbody>
			</tbody>
		</table>
        <div class="layui-form-item">
			<div class="layui-input-block" style="text-align: center;">
				<button class="layui-btn" lay-submit="" id="submit" value="11">#springMessage('common.button.submit')</button>
				<button class="layui-btn" lay-submit="" id="temp" value="0">#springMessage('common.button.temp')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexBankAcc/fexCotpDefaultAcc.add.js?_btv=${resourceVersion}"></script>
</html>

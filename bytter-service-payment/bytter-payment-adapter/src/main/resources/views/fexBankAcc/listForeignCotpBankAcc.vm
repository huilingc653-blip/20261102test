<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<input id="opType" name="opType" type="hidden" value="list">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##交易对手
                    <td class="textRight">#springMessage('table.fexForeign.copt')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_cotpName" autocomplete="off" class="layui-input">
                        </div>
                    </td>
                    ##银行账户
                    <td class="textRight">#springMessage('table.fexForeign.bankAcc')</td>
                    <td>
                        <input type="text" name="likes_bankAcc"
                               autocomplete="off" class="layui-input bank"/>
                    </td>
                    ##币种
                    <td class="textRight">#springMessage('table.fexForeign.curId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" data-name="eqs_curId" data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-textfield="englishCode"  data-biz-name="eqs_curId"></div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                    #if($shiro.hasPermission("foreign:fex:cotp:bankacc:query"))
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    #end
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('table.fexForeign.copt')</th> ##交易对手
        ##<th>#springMessage('table.fexForeign.corpId')</th>##单位
		<th>#springMessage('table.fexForeign.bankAcc')</th> ##银行账户
        <th>#springMessage('table.fcAcc.accName')</th> ##账户名称
        <th>#springMessage('table.fexForeign.curId')</th> ##币种
		<th>#springMessage('table.fexForeign.bank')</th> ##银行
        <th>#springMessage('table.fexForeign.status')</th> ##数据状态
        <th>#springMessage('common.table.thead.operation')</th> ##操作
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexBankAcc/fexCotpBankAcc.list.js?_btv=${resourceVersion}"></script>
</html>

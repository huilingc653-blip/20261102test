<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage('table.fexForeign.corpId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="eqs_corpId"
                                 data-tree-type="check"
                                 ##data-beforeInit="beforeInitCorp"
                                 data-resource="foreign:fex:corp:bankacc:query"
                                 placeholder="#springMessage('common.placeholder.select')"></div>
                        </div>
                    </td>
                    ##交易类型
                    <td class="textRight">#springMessage('table.fexBankAcc.tranType')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="select" data-name="eqs_tranType" data-biz-name="eqs_tranType"
                                 data-group="fexCorp.tranType" data-callback="tranTypeCallback" data-displayData="7,8,9,2,4"></div>
                        </div>
                    </td>
                    ##产品
                    <td class="textRight">#springMessage('table.fexBankAcc.proId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" data-biz-name="eqs_proId" data-url="${basePath}/foreign/fexproduct/listProduct/-1"
                                 data-name="eqs_proId" data-valueField="id" data-textField="proName" data-defaultvalue=""></div>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##交易对手
                    <td class="textRight">#springMessage('table.fexForeign.copt')</td>
                    <td>
                        <input type="text" name="likes_oppCorpName" value=""  class="layui-input" placeholder="#springMessage('table.fexForeign.copt')" >
                    </td>
                    ##
                    <td class="textRight">#springMessage('table.fexBankAcc.cdSign')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="select" data-name="eqs_cdSign" data-biz-name="eqs_cdSign"
                                 data-group="fexCorp.cdSign" ></div>
                        </div>
                    </td>
                    ##状态
                    <td class="textRight">#springMessage('table.fexForeign.status')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="select" data-name="eqi_status" data-biz-name="eqi_status"
                                 data-group="fex.status" data-displayData="0,11,95,-1,-3"></div>
                        </div>
                    </td>

                </tr>
                <tr>
                    ##现金流类型
                    <td class="textRight">#springMessage('table.fexBankAcc.cashFlowType')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="select" data-name="eqs_cashFlowType" data-biz-name="eqs_cashFlowType"
                                 data-group="fexCorp.cashFlowType" ></div>
                        </div>
                    </td>
                    ##币种
                    <td class="textRight">#springMessage('table.fexForeign.curId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" data-name="eqs_curId" data-url="${basePath}/basic/business/btcurrency/json"
                                 data-valuefield="id" data-textfield="englishCode"  data-biz-name="eqs_curId" ></div>##data-beforeInitResiveData="beforeInitCur"
                        </div>
                    </td>

                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                    #if($shiro.hasPermission("foreign:fex:corp:bankacc:query"))
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    #end
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('table.fexForeign.corpId')</th> ##单位
		<th>#springMessage('table.fexBankAcc.tranType')</th> ##交易类型
        <th>#springMessage('table.fexBankAcc.proId')</th> ##产品
        <th>#springMessage('table.fexForeign.copt')</th> ##交易对手
		<th>#springMessage('table.fexBankAcc.cashFlowType')</th> ##现金流类型
        <th>#springMessage('table.fexForeign.curId')</th> ##币种
        <th>#springMessage('table.fexBankAcc.cdSign')</th> ##收付方向
        <th>#springMessage('table.fexForeign.status')</th> ##状态
        <th>#springMessage('common.table.thead.operation')</th> ##操作
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexBankAcc/fexCorpBankAcc.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab-content">
    <input id="id" name="id" type="hidden" value="$!{vo.id}">
    <input id="busType" name="busType" type="hidden" value="$!{busType}">
    <form class="layui-form" method="post" id="inputForm">
        <table class="layui-table">
            <tbody>
#*            <tr>
                ##单位
                <td class="textRight" width="40%">#springMessage('table.fexForeign.corpId')</td>
                <td  width="60%">
                    $!{vo.corpName}
                </td>
            </tr>*#
            <tr>
                ##交易对手名称
                <td class="textRight" width="40%">#springMessage('table.fexForeign.coptName')</td>
                <td  width="60%">
                    $!{vo.cotpName}
                </td>
            </tr>
            <tr>
                ##交易对手银行账户
                <td class="textRight" width="40%">#springMessage('table.fexForeign.cotpAcc')</td>
                <td width="60%">
                    $!{vo.bankAcc}
                </td>
            </tr>
            <tr>
                ##IBAN号
                <td class="textRight" width="40%">#springMessage('table.fexForeign.cotpIbanCode')</td>
                <td width="60%">
                    $!{vo.iBanCode}
                </td>
            </tr>
            <tr>
                ##账户名称
                <td class="textRight" width="40%">#springMessage('table.fexForeign.cotpAccName')</td>
                <td width="60%">
                    $!{vo.accName}
                </td>
            </tr>
            <tr>
                ##账户币种
                <td class="textRight" width="40%">#springMessage('table.fexForeign.cotpCurName')</td>
                <td width="60%">
                    $!{vo.curName}
                </td>
            </tr>
            <tr>
                ##备注
                <td class="textRight" width="40%">#springMessage('fcVoucherType.rmk')</td>
                <td width="60%">
                    $!{vo.rmk}
                </td>
            </tr>
            </tbody>
        </table>
        <table class="layui-table">
            <thead>
            <tr>
                <th colspan="2">#springMessage('table.fexForeign.cotpBankInfo')</th> ##银行详细信息
                <th colspan="2">#springMessage('table.fexForeign.cotpTranBankInfo')</th> ##中转行信息
            </tr>
            </thead>
            <tbody>
            <tr>
                ##银行
                <td class="textRight" width="20%">#springMessage('table.fexForeign.bank')</td>
                <td width="30%">
                    $!{vo.bankName}
                </td>
                ##中转行
                <td class="textRight" width="20%">#springMessage('table.fexForeign.cotpTranBank')</td>
                <td width="30%">
                    $!{vo.tranBankName}
                </td>
            </tr>
            <tr>
                ##BIC Code
                <td class="textRight" width="20%">#springMessage('table.fexForeign.bicCode')</td>
                <td width="30%">
                    $!{vo.bicCode}
                </td>
                ##中转行BIC Code
                <td class="textRight" width="20%">#springMessage('table.fexForeign.bicCode')</td>
                <td width="30%">
                    $!{vo.tranBicCode}
                </td>
            </tr>
            <tr>
                ##本地清算号
                <td class="textRight">#springMessage('table.btswiftinfo.localClearNo')</td>
                <td>
                    $!{vo.localClearNo}
                </td>
                ##中转行地址
                <td class="textRight" width="20%">#springMessage('table.fexForeign.addr')</td>
                <td width="30%">
                    $!{vo.tranBankAddr}
                </td>
            </tr>
            <tr>
                ##支付类型
                <td class="textRight" width="20%">#springMessage('table.fexForeign.payType')</td>
                <td width="30%">
                    $dictTag.get("fexCotp.payType",${vo.payType})
                </td>
                <td class="textRight" width="20%"></td>
                <td width="30%"></td>
            </tr>
            <tr>
                ##在中转行的银行账户
                <td class="textRight" width="20%">#springMessage('table.fexForeign.tranBankAcc')</td>
                <td width="30%">
                    $!{vo.tranBankAcc}
                </td>
                <td class="textRight" width="20%"></td>
                <td width="30%"></td>
            </tr>
            <tr>
                ##地址
                <td class="textRight" width="20%">#springMessage('table.fexForeign.addr')</td>
                <td width="30%">
                    $!{vo.bankAddr}
                </td>
                <td class="textRight" width="20%"></td>
                <td width="30%"></td>
            </tr>
            <tr>
                ##银行信息备注
                <td class="textRight" width="20%">#springMessage('table.fexForeign.bankRmk')</td>
                <td width="30%">
                    $!{vo.bankRmk}
                </td>
                <td class="textRight" width="20%"></td>
                <td width="30%"></td>
            </tr>
            </tbody>
        </table>
        #if(!$taskId)
            <div style="width: 100%;text-align: center;">
                <button class="layui-btn" type="button" onClick="closecurrent()">#springMessage('common.button.close')</button>
            </div>
        #end
    </form>
    <!-- 日志 -->
    <div id="tagMsg"></div>
</div>
#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['form','datatable','corp','dicts','jquery'], function(){
        var $ = bt.jquery, form = bt.form();
        /**
         * 生成日志列表
         * @return
         */
            $genMsgHtml = function () {
            var url = basePath + "/foreign/fexmessage/list/" + $('#id').val() + "/" + $("#busType").val() + "?timestamp=" + new Date().getTime();
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                    form.render();
                }
            });
        }
            $genMsgHtml();
    });
    function closecurrent() {
        parent.layer ? parent.layer.closeAll() : layer.closeAll();
        return false;
    }
</script>
</html>

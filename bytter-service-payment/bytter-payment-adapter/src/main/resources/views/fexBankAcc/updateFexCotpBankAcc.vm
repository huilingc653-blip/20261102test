<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab-content">
    <form class="layui-form" method="post" id="inputForm">
        <input type="hidden" name="id" value="$!{vo.id}" />
        <input type="hidden" name="createBy" value="$!{vo.createBy}" />
        <input type="hidden" name="createDate" value="$!{vo.createDate}" />
        <table class="layui-table">
            <tbody>
##            <tr>
##                ##单位
##                <td class="textRight" width="40%">#springMessage('table.fexForeign.corpId')</td>
##                <td  width="60%">
##                    <div class="layui-inline">
##                        <div class="bt-biz-corp"
##                             data-biz-type="corp"
##                             data-type="selectTree"
##                             data-name="corpId"
##                             data-biz-name="corpId"
##                             data-scope="all"
##                             data-callback="bt.corpCallback"
##                             data-resource="foreign:fex:cotp:bankacc:apply"
##                             data-required="true"
##                             data-defaultvalue="$!{vo.corpId}"
##                             placeholder="#springMessage('common.placeholder.select')"></div>
##                    </div>
##                </td>
##            </tr>
            <tr>
                ##交易对手名称
                <td class="textRight" width="40%">#springMessage('table.fexForeign.coptName')</td>
                <td  width="60%">
                    #if($!{vo.status} == "95")
                        $!{vo.cotpName}
                    <div class="layui-inline" style="display: none">
                    #else
                    <div class="layui-inline">
                    #end
                        <div class="bt-biz-selectType" data-name="cotpId" data-url="${basePath}/foreign/fexCotp/listBankCotp" data-valuefield="id" data-textfield="cotpName"
                             data-biz-name="cotpId" data-required="true" data-defaultvalue="$!{vo.cotpId}"></div>
                    </div>
                </td>
            </tr>
            <tr>
                ##交易对手银行账户
                <td class="textRight" width="40%">#springMessage('table.fexForeign.cotpAcc')</td>
                <td width="60%">
                    #if($!{vo.status} == "95")
                        $!{vo.bankAcc}
                        <input type="hidden" name="bankAcc" lay-verify="required" class="layui-input bank" value="$!{vo.bankAcc}"/>
                    #else
                        <input type="text" name="bankAcc" lay-verify="required" class="layui-input bank" value="$!{vo.bankAcc}"/>
                    #end
                </td>
            </tr>
            <tr>
                ##IBAN号
                <td class="textRight" width="40%">#springMessage('table.fexForeign.cotpIbanCode')</td>
                <td width="60%">
                    <input type="text" name="iBanCode" class="layui-input" value="$!{vo.iBanCode}"/>
                </td>
            </tr>
            <tr>
                ##账户名称
                <td class="textRight" width="40%">#springMessage('table.fexForeign.cotpAccName')</td>
                <td width="60%">
                    <input type="text" name="accName" lay-verify="required" class="layui-input" value="$!{vo.accName}"/>
                </td>
            </tr>
            <tr>
                ##账户币种
                <td class="textRight" width="40%">#springMessage('table.fexForeign.cotpCurName')</td>
                <td width="60%">
                    #if($!{vo.status} == "95")
                        $!{vo.curName}
                    <div class="layui-inline" style="display: none">
                    #else
                    <div class="layui-inline">
                    #end
                        <div class="bt-biz-mulselectType" data-name="curId" data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-method="get"
                             data-textfield="englishCode"  data-required="true" data-biz-name="curId" data-defaultvalue="$!{vo.curId}"></div>
                    </div>
                </td>
            </tr>
            <tr>
                ##备注
                <td class="textRight" width="40%">#springMessage('fcVoucherType.rmk')</td>
                <td width="60%">
                        <textarea lay-verify="strlength" type="text" id="rmk" name="rmk" data-maxlength="100" class="layui-textarea"
                                  placeholder="#springMessage('table.cmsProvideLoanInfo.rmk')">$!{vo.rmk}</textarea>
                </td>
            </tr>
            </tbody>
        </table>
        <table class="layui-table">
            <thead>
            <tr>
                <th colspan="2">#springMessage('table.fexForeign.cotpBankInfo')</th> ##银行详细信息
                <th colspan="2">#springMessage('table.fexForeign.cotpTranBankInfo')</th> ##中转行信息
            </tr>
            </thead>
            <tbody>
            <tr>
                ##银行
                <td class="textRight" width="20%">#springMessage('table.fexForeign.bank')</td>
                <td width="30%">
                    <div class="bt-biz-selectType" data-name="bankId" data-url="${basePath}/foreign/fexCotp/listBankCotp?cotpType=05" data-valuefield="id" data-textfield="cotpName"
                         data-callback="bankCallback"  data-biz-name="bankId" data-required="true" data-defaultvalue="$!{vo.bankId}"></div>
                </td>
                ##中转行
                <td class="textRight" width="20%">#springMessage('table.fexForeign.cotpTranBank')</td>
                <td width="30%">
                    <div class="bt-biz-selectType" data-name="tranBank" data-url="${basePath}/foreign/fexCotp/listBankCotp?cotpType=05" data-valuefield="id" data-textfield="cotpName"
                         data-callback="tranBankCallback"  data-biz-name="tranBank" data-defaultvalue="$!{vo.tranBank}"></div>
                </td>
            </tr>
            <tr>
                ##BIC Code
                <td class="textRight" width="20%">#springMessage('table.fexForeign.bicCode')</td>
                <td width="30%">
                    <input type="text" id="bicCode" name="bicCode" class="layui-input" value="$!{vo.bicCode}"/>
                </td>
                ##中转行BIC Code
                <td class="textRight" width="20%">#springMessage('table.fexForeign.bicCode')</td>
                <td width="30%">
                    <input type="text" id="tranBicCode" name="tranBicCode" class="layui-input" value="$!{vo.tranBicCode}"/>
                </td>
            </tr>
            <tr>
                ##本地清算号
                <td class="textRight">#springMessage('table.btswiftinfo.localClearNo')</td>
                <td>
                    <input type="text" id="localClearNo" name="localClearNo" lay-verify="strlength"
                           data-maxlength="30" readonly="readonly" value="$!{vo.localClearNo}"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.btswiftinfo.localClearNo')">
                </td>
                ##中转行地址
                <td class="textRight" width="20%">#springMessage('table.fexForeign.addr')</td>
                <td width="30%">
                    <input type="text" id="tranBankAddr" name="tranBankAddr" class="layui-input" value="$!{vo.tranBankAddr}"/>
                </td>
            </tr>
            <tr>
                ##支付类型
                <td class="textRight" width="20%">#springMessage('table.fexForeign.payType')</td>
                <td width="30%">
                    <div class="bt-biz-dict" data-type="select" data-group="fexCotp.payType"
                         data-name="payType" data-biz-name="payType" data-defaultvalue="$!{vo.payType}"></div>
                </td>
                <td class="textRight" width="20%"></td>
                <td width="30%"></td>
            </tr>
            <tr>
                ##在中转行的银行账户
                <td class="textRight" width="20%">#springMessage('table.fexForeign.tranBankAcc')</td>
                <td width="30%">
                    <input type="text" name="tranBankAcc" class="layui-input" value="$!{vo.tranBankAcc}"/>
                </td>
                <td class="textRight" width="20%"></td>
                <td width="30%"></td>
            </tr>
            <tr>
                ##地址
                <td class="textRight" width="20%">#springMessage('table.fexForeign.addr')</td>
                <td width="30%">
                    <input type="text" id="bankAddr" name="bankAddr" class="layui-input" value="$!{vo.bankAddr}"/>
                </td>
                <td class="textRight" width="20%"></td>
                <td width="30%"></td>
            </tr>
            <tr>
                ##银行信息备注
                <td class="textRight" width="20%">#springMessage('table.fexForeign.bankRmk')</td>
                <td width="30%">
                    <input type="text" name="bankRmk" class="layui-input" value="$!{vo.bankRmk}"/>
                </td>
                <td class="textRight" width="20%"></td>
                <td width="30%"></td>
            </tr>
            </tbody>
        </table>
        <div class="layui-form-item">
            <div class="layui-input-block" style="text-align: center;">
                <button class="layui-btn" lay-submit="" id="submit" value="11">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" id="temp" value="0">#springMessage('common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </div>
        </div>
    </form>
</div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexBankAcc/fexCotpBankAcc.add.js?_btv=${resourceVersion}"></script>
</html>

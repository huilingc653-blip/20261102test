#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##交易对手名称
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeign.coptName')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.cotpName}
        </span>
    </li>
##交易对手银行账户
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeign.cotpAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.bankAcc}
        </span>
    </li>
##账户币种
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeign.cotpCurName')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.curName}
        </span>
    </li>
    ##账户名称
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeign.cotpAccName')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.accName}
        </span>
    </li>
    ##银行
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeign.bank')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.bankName}
        </span>
    </li>
    ##中转银行
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeign.cotpTranBank')
        <span class="mui-badge mui-badge-inverted">
            $!{vo.tranBankName}
        </span>
    </li>
    #parse("views/common/wapfooter.vm")
</body>
</html>

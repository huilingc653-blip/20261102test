<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		##业务类型：0主体单位，1交易对手
		<input type="hidden" name="busType" value="1">
		<input type="hidden" name="id" value="$!{vo.id}" />
		<input type="hidden" name="sort" value="$!{vo.sort}" />
		<input type="hidden" name="createBy" value="$!{vo.createBy}" />
		<input type="hidden" name="createDate" value="$!{vo.createDate}" />
		<input type="hidden" id="rowIndex" value="$!{vo.fexCorpBankAccDtl.size()}">
		<table class="layui-table">
			<thead>
				<tr>
					<th class="textLeft" colspan="6" >#springMessage("table.fexBankAcc.rule")</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					##交易类型
					<td class="textRight">#springMessage("table.fexBankAcc.tranType")</td>
					<td>
						<div class="layui-inline">
							<div class="bt-biz-dict" data-type="select" data-name="tranType" data-biz-name="tranType" data-displayData="4"
								 data-group="fexCorp.tranType" data-defaultvalue="$!{vo.tranType}" data-callback="tranTypeCallback"></div>
						</div>
					</td>
					##产品
					<td class="textRight">#springMessage("table.fexBankAcc.proId")</td>
					<td>
						<div class="layui-input-inline">
							<div class="bt-biz-selectType" data-biz-name="proId" data-name="proId"
								 data-url="${basePath}/foreign/fexproduct/getInitProductDate" data-method="get"
								 data-valueField="id" data-textField="proName" data-callback="proIdCallback"
								 data-defaultvalue="$!{vo.proId}" ></div>
						</div>
					</td>
					##交易对手
					<td class="textRight">#springMessage("table.fexForeign.copt")</td>
					<td>
						<input type="hidden" name="oppId" id="oppId" value="$!{vo.oppId}">##数据源id
						<input type="hidden" id="corpName" name="corpName" value="$!{vo.corpName}">##对手名称
						<input type="hidden" id="corpId" name="corpId" value="$!{vo.corpId}">
						<input type="hidden" id="cotpNameEn" name="cotpNameEn" value="$!{vo.cotpNameEn}">##对手英文名称

						<div class="layui-inline" id="oppCorpNameDiv" #if($!{vo.tranType}) style="display: none" #end>##无选择时候展示
							<input class="layui-input"  onclick="oppCorpNameClick()" readonly="readonly" type="text"/>
						</div>

						<div class="layui-inline" id="externalDiv" #if($!{vo.tranType}!="4") style="display: none" #end>##客商组件
							<input class="layui-input" id="eOppCorpName" readonly="readonly" type="text" #if($!{vo.tranType}=="4") value="$!{vo.corpName}" #end/>
							<div class="bt-div-search">
								## 客商组件
								<button type="button" class="bt-biz-allExternalCorp" data-beforeClick="bt.cotpExternalBeforeClick"  data-callback="cotpExternalCallback">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>
						</div>
						<div class="layui-inline" id="corpDiv" #if($!{vo.tranType}!="3") style="display: none" #end>##单位下拉树
							<div class="bt-biz-corp"
								 data-biz-type="corp"
								 data-type="selectTree"
								 data-name="cOppCorpName"
								 data-biz-name="cOppCorpName"
								 data-scope="all"
								#if($!{vo.tranType}=="3") data-defaultvalue="$!{vo.oppId}" #end
								 data-callbackData="oppCorpTreeCallback"
							></div>
						</div>
						<div class="layui-inline" id="bankDiv" #if($!{vo.tranType}!="1" && $!{vo.tranType}!="2") style="display: none" #end>##银行组件
							<input class="layui-input" id="bOppCorpName" readonly="readonly" type="text" #if($!{vo.tranType}=="1" || $!{vo.tranType}=="2") value="$!{vo.corpName}" #end />
							<div class="bt-div-search">
								## 客商组件
								<button type="button" class="bt-biz-allBankInfo"  data-callback="bankCallback">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>
						</div>
					</td>
				</tr>
				<tr>
					##单位
					<td class="textRight">#springMessage("table.fexForeign.corpId")</td>
					<td>
						<div class="layui-inline">
							<div class="bt-biz-corp"
								 data-biz-type="corp"
								 data-type="selectTree"
								 data-name="oppCorpId"
								 data-biz-name="oppCorpId"
								 data-scope="all"
								 data-callback="bt.oppCorpIdCallback"
								 data-resource="foreign:fex:cotp:defaultacc:apply"
								 data-defaultvalue="$!{vo.oppCorpId}"
								 placeholder="#springMessage('common.placeholder.select')"></div>
						</div>
					</td>
					##收付方向
					<td class="textRight">#springMessage("table.fexBankAcc.cdSign")</td>
					<td>
						<div class="layui-inline">
							<div class="bt-biz-dict" data-type="select" data-name="cdSign" data-biz-name="cdSign"
								 data-group="fexCorp.cdSign" data-defaultvalue="$!{vo.cdSign}" ></div>
						</div>
					</td>
					##现金流类型
					<td class="textRight">#springMessage("table.fexBankAcc.cashFlowType")</td>
					<td>
						<div class="layui-inline">
							<div class="bt-biz-dict" data-type="select" data-name="cashFlowType" data-biz-name="cashFlowType"
								 data-group="fexCorp.cashFlowType" data-defaultvalue="$!{vo.cashFlowType}" ></div>
						</div>
					</td>
				</tr>
				<tr>
					##币种
					<td class="textRight">#springMessage('table.fexForeign.curId')</td>
					<td>
						<div class="layui-inline">
							<div class="bt-biz-selectType" data-name="curId" data-url="${basePath}/basic/business/btcurrency/json" data-defaultvalue="$!{vo.curId}"
								 data-valuefield="id" data-textfield="englishCode" data-callback="curCallback"  data-biz-name="curId"
							></div>
						</div>
					</td>
					<td></td>
					<td></td>
					<td></td>
					<td></td>
				</tr>
			</tbody>
		</table>
        <table class="layui-table ignore-required-icon isDown" #if($!{vo.tranType}==4 && $!{isQuickPayProduct})
			style="display: none" #end id="editTable" width="100%">##传统账号列表显示
        	<thead>
				<tr>
					<th colspan="5">
						<span style="float: left">#springMessage("table.fexBankAcc.defaultAcc")</span>
						<span style="float: right">
							 <button type="button" class="layui-btn" lay-filter="add" id="add">#springMessage('common.addTr')</button>
						</span>
					</th>
				</tr>
		   		<tr>
					<th><span class="pl"><span class="required-icon">*</span></span>#springMessage("table.fexBankAcc.effectDate")</th>
					<th><span class="pl"><span class="required-icon">*</span></span>#springMessage("table.fexForeign.bankAcc")</th>
					<th>#springMessage("table.fexForeign.cotpAccName")</th>
					<th>#springMessage("table.fexForeign.curId")</th>
                    <th>#springMessage("common.table.thead.operation")</th>
				</tr>
		    </thead>
            <tbody>
					#if(!$!{isQuickPayProduct})

				#foreach($dtl in $!{vo.fexCorpBankAccDtl})
					#set($vcount = $velocityCount - 1)
				<tr data-row="$vcount">
					##生效日期
					<td class="center">
						<div class="layui-inline">
							<input type="text" data-biz-name="${vcount}effectDate"  name="fexCorpBankAccDtl[$vcount].effectDate" class="layui-input bt-input-inline bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!{dtl.effectDate})" lay-verify="required" data-callback="changeDate">
						</div>
					</td>
					#if($!{vo.tranType}=="1" || $!{vo.tranType}=="2")
						##输入框账号
						<td class="center"><div class="layui-inline"><input type="text" class="layui-input" lay-verify="required"  name="fexCorpBankAccDtl[$vcount].bankAcc" id="bankAcc$vcount" value="$!{dtl.bankAcc}"> </div></td>
					    ##账户名称
						<td class="center"><div class="layui-inline">
						<input type="text" name="fexCorpBankAccDtl[$vcount].accName" id="accName$vcount" class="layui-input"  value="$!{dtl.accName}"/>
						</div></td>
						##币种
						<td class="center"><div class="layui-inline">
						<div class="bt-biz-selectType" data-name="fexCorpBankAccDtl[$vcount].curId"  data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-textfield="englishCode"
						 data-biz-name="fexCorpBankAccDtl[$vcount].curId" data-value="$!{dtl.curId}"
						#if($!{vo.curId})
						 data-disabled="true"
						 #end></div>
						</div>
						</td>

						#elseif(!$!{isQuickPayProduct})
					##账号选择
					<td class="center"><div class="layui-inline">
						<input class="layui-input" name="fexCorpBankAccDtl[$vcount].bankAcc" id="bankAcc$vcount" lay-verify="required" value="$!{dtl.bankAcc}" readonly="readonly" type="text"/>
					    <div class="bt-div-search">
						<button type="button" class="bt-biz-allExternalBankAcc" id="externalBankAcc$vcount" onclick="bankAccClick(this)" data-callback="externalBankAccCallback">
						<i class="layui-icon">&#xe615;</i></button>
						</div></div></td>
					##账户名称
					<td class="center"><div class="layui-inline">
						<input type="text" name="fexCorpBankAccDtl[$vcount].accName" id="accName$vcount" class="layui-input" value="$!{dtl.accName}"  readonly="true"/>
					</div></td>
						##币种
					<td class="center"><div class="layui-inline">
						<input type="text" name="fexCorpBankAccDtl[$vcount].curName" id="curName$vcount" readonly="true"  value="$!{dtl.curName}" class="layui-input"/>
						<input type="hidden" name="fexCorpBankAccDtl[$vcount].curId" id="curId$vcount" value="$!{dtl.curId}" /></div></td>
					#end
					##删除按钮
					<td class="center">
						<button data-type="del" type="button" class="layui-btn layui-btn-mini">#springMessage("common.button.delete")</button>
					</td>
				</tr>
				#end
				#end
            </tbody>
        </table>
		<table class="layui-table ignore-required-icon isDown"
			   #if(!$!{isQuickPayProduct})
			   style="display: none"
			   #end
			    id="fpsEditTable" width="100%">
			<thead>
			<tr>
				<th colspan="7">
					<span style="float: left">#springMessage("table.fexBankAcc.defaultAcc")</span>
					<span style="float: right">
							 <button type="button" class="layui-btn" lay-filter="add" id="fpsAdd">#springMessage('common.addTr')</button>
						</span>
				</th>
			</tr>
			<tr>
				<th  width="15%"><span class="pl"><span class="required-icon">*</span></span>#springMessage("table.fexBankAcc.effectDate")</th>
				<th  width="15%"><span class="pl"><span class="required-icon">*</span></span>#springMessage("ttpay.payeeMode")</th>
				<th  width="15%"><span class="pl"><span class="required-icon">*</span></span>#springMessage("fex.cotp.quickPayment")</th>
				<th  width="15%">#springMessage("common.table.thead.operation")</th>
			</tr>
			</thead>
			<tbody>
					#if($!{isQuickPayProduct})

			#foreach($dtl in $!{vo.fexCorpBankAccDtl})
			#set($vcount = $velocityCount - 1)
				<tr data-row="$vcount">
					##生效日期
					<td class="center">
						<div class="layui-inline">
							<input type="text" data-biz-name="${vcount}effectDate"  name="fexCorpBankAccDtl[$vcount].effectDate" class="layui-input bt-input-inline bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!{dtl.effectDate})" lay-verify="required" data-callback="changeDate">
						</div>
					</td>
					<td class="center">
						<div class="layui-inline">
							<div class="bt-biz-dict" data-type="select" data-name="fexCorpBankAccDtl[$vcount].payModel" data-required="true" data-group="fex.tpay.paymodel"
								 #if($!{isPayPalProduct})
								  data-displayData="EMAIL,MOBN"
								 #end
								 data-biz-name="fexCorpBankAccDtl[$vcount].payModel" data-callback="payModelCallBack" data-value="$!{dtl.payModel}"></div>
						</div>
					</td>
					<td class="center">
						<div class="layui-inline payValue">
						#if($!{dtl.payModel}=="SVID")
						<div class="bt-biz-selectType"  data-name="fexCorpBankAccDtl[$vcount].payValue" data-required="true" data-url="${basePath}/sys/externalCorp/fexPayPayModelList?externalId=$!{vo.oppId}&proId=$!{vo.proId}"
							 data-valuefield="fpsId" data-textfield="fpsId" data-biz-name="fexCorpBankAccDtl[$vcount].payValue" data-value="$!{dtl.payValue}"></div>
						#elseif($!{dtl.payModel}=="EMAIL")
							<div class="bt-biz-selectType"  data-name="fexCorpBankAccDtl[$vcount].payValue" data-required="true" data-url="${basePath}/sys/externalCorp/fexPayPayModelList?externalId=$!{vo.oppId}&proId=$!{vo.proId}"
								 data-valuefield="email" data-textfield="email" data-biz-name="fexCorpBankAccDtl[$vcount].payValue" data-value="$!{dtl.payValue}"></div>
						#elseif($!{dtl.payModel}=="MOBN")
							<div class="bt-biz-selectType"  data-name="fexCorpBankAccDtl[$vcount].payValue" data-required="true" data-url="${basePath}/sys/externalCorp/fexPayPayModelList?externalId=$!{vo.oppId}&proId=$!{vo.proId}"
								 data-valuefield="phone" data-textfield="phone" data-biz-name="fexCorpBankAccDtl[$vcount].payValue" data-value="$!{dtl.payValue}"></div>
						#elseif($!{dtl.payModel}=="AIIN")
							<div class="bt-biz-selectType"  data-name="fexCorpBankAccDtl[$vcount].payValue" data-required="true" data-url="${basePath}/sys/externalCorp/fexPayPayModelList?externalId=$!{vo.oppId}&proId=$!{vo.proId}"
								 data-valuefield="creditCard" data-textfield="creditCard" data-biz-name="fexCorpBankAccDtl[$vcount].payValue" data-value="$!{dtl.payValue}"></div>
						#elseif($!{dtl.payModel}=="HKID")
							<div class="bt-biz-selectType"  data-name="fexCorpBankAccDtl[$vcount].payValue" data-required="true" data-url="${basePath}/sys/externalCorp/fexPayPayModelList?externalId=$!{vo.oppId}&proId=$!{vo.proId}"
								 data-valuefield="hkId" data-textfield="hkId" data-biz-name="fexCorpBankAccDtl[$vcount].payValue" data-value="$!{dtl.payValue}"></div>
						#elseif($!{dtl.payModel}=="ACC")
							<div class="bt-biz-selectType"  data-name="fexCorpBankAccDtl[$vcount].payValue" data-required="true" data-url="${basePath}/sys/externalCorp/fexPayPayModelAccList?externalId=$!{vo.oppId}"
								 data-valuefield="externalAcc" data-textfield="externalAcc" data-biz-name="fexCorpBankAccDtl[$vcount].payValue" data-value="$!{dtl.payValue}"></div>
						#end
						</div></td>
					##删除按钮
					<td class="center">
						<button data-type="del" type="button" class="layui-btn layui-btn-mini">#springMessage("common.button.delete")</button>
					</td>
				</tr>
			#end
				#end
			</tbody>
		</table>
        <div class="layui-form-item">
			<div class="layui-input-block" style="text-align: center;">
				<button class="layui-btn" lay-submit="" id="submit" value="11">#springMessage('common.button.submit')</button>
				<button class="layui-btn" lay-submit="" id="temp" value="0">#springMessage('common.button.temp')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexBankAcc/fexCotpDefaultAcc.add.js?_btv=${resourceVersion}"></script>
</html>

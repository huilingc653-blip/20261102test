#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
    ##交易对手名称
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeign.copt')
        <span class="mui-badge mui-badge-inverted">
            #if($!{vo.corpId})
					$!{vo.corpName}
				#else
                #springMessage("common.placeholder.all")
            #end
        </span>
    </li>
    ##交易类型
    <li class="mui-table-view-cell">
        #springMessage('table.fexBankAcc.tranType')
        <span class="mui-badge mui-badge-inverted">
            #if($!{vo.tranType})
					$dictTag.get("fexCorp.tranType",$!{vo.tranType})
					#else
                #springMessage("common.placeholder.all")
            #end
        </span>
    </li>
    ##产品
    <li class="mui-table-view-cell">
        #springMessage('table.fexBankAcc.proId')
        <span class="mui-badge mui-badge-inverted">
            #if($!{vo.proId})
					$!{vo.proName}
				#else
                #springMessage("common.placeholder.all")
            #end
        </span>
    </li>
    ##单位
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeign.corpId')
        <span class="mui-badge mui-badge-inverted">
            #if($!{vo.oppCorpId})
						$!{vo.oppCorpName}
					#else
                #springMessage("common.placeholder.all")
            #end
        </span>
    </li>
    ##收付方向
    <li class="mui-table-view-cell">
        #springMessage('table.fexBankAcc.cdSign')
        <span class="mui-badge mui-badge-inverted">
            #if($!{vo.cdSign})
						$dictTag.get("fexCorp.cdSign",$!{vo.cdSign})
						#else
                #springMessage("common.placeholder.all")
            #end
        </span>
    </li>
    ##现金流类型
    <li class="mui-table-view-cell">
        #springMessage('table.fexBankAcc.cashFlowType')
        <span class="mui-badge mui-badge-inverted">
            #if($!{vo.cashFlowType})
						$dictTag.get("fexCorp.cashFlowType",$!{vo.cashFlowType})
					#else
                #springMessage("common.placeholder.all")
            #end
        </span>
    </li>
    ##币种
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeign.curId')
        <span class="mui-badge mui-badge-inverted">
            #if($!{vo.curId})
						$!{vo.curName}
					#else
                #springMessage("common.placeholder.all")
            #end
        </span>
    </li>
    ##默认账户
    <li class="mui-table-view-divider">#springMessage("table.fexBankAcc.defaultAcc")</li>
    <li class="ui-border-t">
        <div class="ui-list-info">
            <ul class="ui-row"
                style="border-width: 1px; text-align: center;">
                <li class="ui-col ui-col-50" style="background: #C4E1FF;"
                    style="border-width: 1px; width: 100%;">
                    <table style="border-collapse: collapse;border-spacing: 0; width: 100%; text-align: center;">
                        <thead>
                        <tr>
                            <th>#springMessage("table.fexBankAcc.effectDate")</th>
                            <th>#springMessage("table.fexForeign.bankAcc")</th>
                            <th>#springMessage("table.fexForeign.cotpAccName")</th>
                            <th>#springMessage("table.fexForeign.curId")</th>
                        </tr>
                        </thead>
                        <tbody style="background: #fff;">
                            #foreach($dtl in $!{vo.fexCorpBankAccDtl})
                            <tr>
                                ##生效日期
                                <td class="center">
                                    $!{dtl.effectDate}
                                </td>
                                ##银行账号
                                <td class="center">
                                    $!{dtl.bankAcc}
                                </td>
                                ##账户名称
                                <td class="center">
                                    $!{dtl.accName}
                                </td>
                                ##币种
                                <td class="center">
                                    $!{dtl.curName}
                                </td>
                            </tr>
                            #end
                        </tbody>
                    </table>
                </li>
            </ul>
        </div>
    </li>
        <div style="height:80px"></div>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

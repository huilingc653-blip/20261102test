<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
    <table class="layui-table">
        <tbody>
        <tr>
            ##交易对手
            <td class="textRight">#springMessage('table.fexForeign.copt')</td>
            <td>
                <input type="text" name="likes_corpName" value=""  class="layui-input" placeholder="#springMessage('table.fexForeign.copt')" >
            </td>
            ##交易类型
            <td class="textRight">#springMessage('table.fexBankAcc.tranType')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-name="eqs_tranType" data-biz-name="eqs_tranType"
                         data-group="fexCorp.tranType" data-callback="tranTypeCallback" data-displayData="7,8,9,2,3,4"></div>
                </div>
            </td>
            ##产品
            <td class="textRight">#springMessage('table.fexBankAcc.proId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-biz-name="eqs_proId" data-url="${basePath}/foreign/fexproduct/listProductAndGroup"
                         data-name="eqs_proId" data-valueField="id" data-textField="proName" data-beforeInitResiveData="beforeInitPro"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##单位
            <td class="textRight">#springMessage('table.fexForeign.corpId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="eqs_oppCorpId"
                         data-tree-type="check"
                         #*data-beforeInit="beforeInitCorp"*#
                         data-resource="foreign:fex:cotp:defaultacc:query"
                         placeholder="#springMessage('common.placeholder.select')"></div>
                </div>
            </td>
            ##收付方向
            <td class="textRight">#springMessage('table.fexBankAcc.cdSign')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-name="eqs_cdSign" data-biz-name="eqs_cdSign"
                         data-group="fexCorp.cdSign"></div>
                </div>
            </td>
            ##现金流类型
            <td class="textRight">#springMessage('table.fexBankAcc.cashFlowType')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-name="eqs_cashFlowType" data-biz-name="eqs_cashFlowType"
                         data-group="fexCorp.cashFlowType"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##币种
            <td class="textRight">#springMessage('table.fexForeign.curId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-name="eqs_curId" data-url="${basePath}/basic/business/btcurrency/json"
                         data-valuefield="id" data-textfield="englishCode"  data-biz-name="eqs_curId" data-beforeInitResiveData="beforeInitCur"></div>
                </div>
            </td>
            <td class="textRight"></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fexForeign.copt')</th> ##交易对手
        <th>#springMessage('table.fexBankAcc.tranType')</th> ##交易类型
        <th>#springMessage('table.fexBankAcc.proId')</th> ##产品
        <th>#springMessage('table.fexForeign.corpId')</th> ##单位
        <th>#springMessage('table.fexBankAcc.cashFlowType')</th> ##现金流类型
        <th>#springMessage('table.fexForeign.curId')</th> ##币种
        <th>#springMessage('table.fexBankAcc.cdSign')</th> ##收付方向
        <th>#springMessage('common.table.thead.operation')</th> ##操作
    </tr>
    </thead>
</table>
	#paymentWorkFlowHtml()
	#parse("views/common/footer.vm")
	#paymentWorkFlowScript()
</body>
<script src="${basePath}/static/modules/foreign/fexBankAcc/fexCotpDefaultAccApprove.list.js?_btv=${resourceVersion}"></script>
</html>

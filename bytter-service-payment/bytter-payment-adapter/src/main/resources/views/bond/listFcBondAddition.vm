<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
            <tbody>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage('table.fcBond.corpId')</td>
                    <td>
                        <div class="layui-inline">
                        	<div class="bt-biz-corp"
                                data-biz-type="corp"
                                data-type="selectTree"
                                data-name="likes_corpId"
                                data-scope="all"
								data-resource="netbank:fcBond:depositOut:apply"
								placeholder="#springMessage('common.placeholder.select')"></div>
                        </div>
                    </td>
					##存入银行
                    <td class="textRight">#springMessage('table.fcBond.bankName')</td>
                    <td>
                        <input type="text" name="likes_bankName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcBond.bankName')">
                    </td>
					##存入账户
					 <td class="textRight">#springMessage('table.fcBond.depositaccount')</td>
                    <td>
                        <input type="text" name="likes_bankAcc"
                            autocomplete="off" class="layui-input bank" >
                    </td>
                </tr>
				<tr>
                    ##账户名称
                    <td class="textRight">#springMessage('table.fcBond.accountname')</td>
                    <td>
                        <input type="text" name="likes_accName"
                            autocomplete="off" class="layui-input">
                    </td>
					##存入日期
					<td class="textRight">#springMessage('table.fcBond.depositdate')</td>
                    <td>
                        <input type="text" name="ged_createDate"  class="layui-input bt-input-inline bt-biz-dateType" data-endid="createDate" >
                        <span class="date-mid">#springMessage('table.fcBond.rangeofdate')</span>
                        <input type="text" name="led_createDate" class="layui-input bt-input-inline bt-biz-dateType" id="createDate">
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>	
    </form>  

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.fcBond.appNo')</th>
                <th>#springMessage('table.fcBond.corpName')</th>
                <th>#springMessage('table.fcBond.bankName')</th>
                <th>#springMessage('table.fcBond.depositaccount')</th>
                <th>#springMessage('table.fcBond.accountname')</th>
                <th>#springMessage('table.fcBond.curCode')</th>
                <th>#springMessage('table.fcBond.bondmoney')</th>
				<th>#springMessage('table.fcBond.addBondMoney')</th>
                <th>#springMessage('table.fcBond.depositdate')</th>
				##<th>#springMessage('table.fcBond.ispayed')</th>
                <th>#springMessage('table.fcBond.status')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/fcbond/fcBondAddition.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcBondTypePage.id}">
		<table class="layui-table">
			<tr>
			##保证金类型代码
				<td class="textRight" width="15%">#springMessage('fcbond.typecode')</td>
				<td width="35%">
					<input type="text" name="bondTypeCode" autocomplete="off" lay-verify="required" class="layui-input" value="$!{fcBondTypePage.bondTypeCode}">
				</td>

			##保证金类型名称
				<td class="textRight" width="15%">#springMessage('fcbond.typename')</td>
				<td width="35%">
					<input type="text" name="bondTypeName" autocomplete="off" lay-verify="required" class="layui-input" value="$!{fcBondTypePage.bondTypeName}">
				</td>
			</tr>

			<tr>
			##有效标志
				<td class="textRight">#springMessage('table.bvStorageBox.validSign')</td>
				<td>
					<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="$!{fcBondTypePage.validSign}" data-name="validSign" data-biz-name="validSign"></div>
				</td>

			##备注
				<td class="textRight">#springMessage('table.ratItemCustom.remark')</td>
				<td>
					<input type="text" name="rmk" autocomplete="off"  class="layui-input" value="$!{fcBondTypePage.rmk}">
				</td>
			</tr>

            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
    	</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','layedit','select','btdate','rateType','selectType','dicts','dateType'], function(){
		var $ = bt.jquery,form = bt.form();
		bt.dateType.init();
		var rate = bt.rateType.init();
		bt.selectType.init();
		bt.dicts.init();

		//监听提交
        form.on('submit(submit)', function(data){
            var action = "/bond/fcbondtype/modify";
            $.post(basePath + action,data.field,function(result){
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
                if(result.success){
                	if(!bt.navtab){
                        parent.layer?parent.layer.closeAll():layer.closeAll();
                    } else {
                    	bt.navtab.closeCurrent();
                    }
                }
            },'JSON');
            return false;
        });

	});
</script>
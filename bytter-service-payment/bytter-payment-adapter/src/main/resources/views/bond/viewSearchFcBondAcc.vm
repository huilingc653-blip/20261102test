        </th>
    </tr>
    </thead>
	#foreach($obj in $listFcBondApply)
	<tr>
		<td style="text-align:center">$velocityCount</td>
		<td style="text-align:center">$!{obj.itemNo}</td>
		<td style="text-align:center">$dictTag.get("fcBond.itemType",$!{obj.itemType})</td>
		<td style="text-align:center">$!date.format('yyyy-MM-dd',$!{obj.startDate})</td>
		<td style="text-align:center">$!date.format('yyyy-MM-dd',$!{obj.endDate})</td>
		<td style="text-align:right">$number.formatNumeric($!{obj.applyMoney})</td>
        <td style="text-align:center">$dictTag.get("fcBond.status",$!{obj.status})</td>
		<td style="text-align:center">
	    <a onclick="link('$!{obj.id}')">#springMessage('common.button.view')</a></td>
	</tr>
	#end
  </table>*#
  ##账户金额追加明细
	<table  class="layui-table layui-form" style="width:100%;">
    <thead>
	<tr>
         <td class="textLeft" colspan="4">#springMessage('table.fcBond.addHisDetail')</td>
	</tr>
    <tr>
        <table id="appTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('table.fcBond.orderNo')</th>
                <th>#springMessage('table.fcBond.addOpName')</th>
                <th>#springMessage('table.fcBond.addDate')</th>
                <th>#springMessage('table.fcBond.addBondMoney')</th>
            </tr>
            </thead>
        </table>
    </tr>
    </thead>
##	#foreach($ad in $listFcBondAdd)
##	<tr>
##        <td style="text-align:center">$velocityCount</td>
##		<td style="text-align:center">$!{ad.createByName}</td>
##        <td style="text-align:center">$!date.format('yyyy-MM-dd',$!{ad.createDate})</td>
##        <td style="text-align:right">$number.formatNumeric($!{ad.addMoney})</td>
##    </tr>
##	#end
        </tbody>
    </table>
  ##转回历史记录
	<table  class="layui-table layui-form" style="width:100%;">
    <thead>
	<tr>
         <td class="textLeft" colspan="5">#springMessage('table.fcBond.backRecord')</td>
	</tr>
    <tr>
        <th>#springMessage('table.fcBond.orderNo')</th>
        <th>#springMessage('table.fcBond.backOperator')</th>
        <th>#springMessage('table.fcBond.backDate')</th>
        <th>#springMessage('table.fcBond.backMoney')</th>
		<th>#springMessage('table.fcBond.interestIncom')</th>
    </tr>
    </thead>
	#foreach($re in $listFcBondBack)
	<tr>
        <td style="text-align:center">$velocityCount</td>
		<td style="text-align:center">$!{re.createByName}</td>
        <td style="text-align:center">$!date.format('yyyy-MM-dd HH:mm:ss',$!{re.backDate})</td>
        <td style="text-align:right">$number.formatNumeric($!{re.backMoney})</td>
		<td style="text-align:right">$number.formatNumeric($!{re.backInterest})</td>
    </tr>
	#end
        <tr>
            <td colspan="6" style="text-align: center;">
                <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
            </td>
            </tr>
        </tbody>
    </table>
</form>
</body>
#parse("views/common/footer.vm")
<script >
bt.use(['form','dicts','datatable','date','money'], function(){
    $ = bt.jquery,form = bt.form();
    toRegular();

    //生成列表
    var datatable = bt.datatable.init({
        elem: "#appTable",
        colReorder: true,
        checkbox:false,
        order: [[2,'desc']],
        searchForm: {
            formElem: "#searchForm",
            formFilter: "search"
        },
        ajax: {
            'url': basePath+"/bond/fcbondInfo/getFcBondAdds"
        },
        // 暂时注释导出全部回调
        // customExportAll: function (params, processing, data) {
        //     console.log(555666)
        //     var exportUrl = basePath + "/bond/fcbondInfo/excelBondAdd";
        //     params.bondId = $("#bondId").val()
        //     openExportExcel(exportUrl,params, data);
        //     processing(false);
        // },
        ignoreButtons:['output'],
        buttons:[
            {
                text: "导出",
                action: function (e, dt, node, config) {
                    console.log("dt===",dt)
                    console.log("dt.order===",dt.order()[0][1])
                    console.log("e===",e)
                    console.log("node===",node)
                    console.log("config===",config)
                    var exportUrl = basePath + "/bond/fcbondInfo/excelBondAdd";
                    // $.post(exportUrl,{bondId:$("#bondId").val()},function(data){
                    //
                    // },'JSON');
                    // 创建一个新的XMLHttpRequest对象
                    var xhr = new XMLHttpRequest();

                    // 设置响应类型为blob，用于处理二进制数据（假设这里是用于下载文件等操作）
                    xhr.responseType = 'blob';

                    // 设置请求方法为POST，并指定请求的URL
                    xhr.open('POST', exportUrl, true);

                    // 当请求加载完成时的回调函数
                    xhr.onload = function() {
                        if (xhr.status === 200) {
                            // 获取接收到的blob数据
                            var blob = xhr.response;

                            // 创建一个用于下载的链接元素
                            var link = document.createElement('a');
                            link.href = window.URL.createObjectURL(blob);
                            link.download = '保证金账户历史追加明细.xls';

                            // 将链接元素添加到文档主体中
                            document.body.appendChild(link);

                            // 模拟点击链接，触发下载
                            link.click();

                            // 从文档主体中移除链接元素
                            document.body.removeChild(link);

                            // 释放创建的URL对象资源
                            window.URL.revokeObjectURL(link.href);
                        } else {
                            console.log('请求失败，状态码：', xhr.status);
                        }
                    };

                    // 设置请求头（如果需要的话，这里示例设置Content-Type为application/json，可根据实际情况调整）
                    xhr.setRequestHeader('Content-Type', 'application/json');
                    // 准备要发送的数据（这里示例是一个简单的JSON对象，可根据实际情况调整）
                    var dataToSend = {
                        bondId: $("#bondId").val(),
                        order: dt.order()[0][1]
                    };

                    // 将数据转换为JSON字符串并发送请求
                    xhr.send(JSON.stringify(dataToSend));

                    // $.ajax({
                    //     type: "POST",
                    //     //定义响应类型为 blob
                    //     xhrFields: {
                    //         responseType: 'blob'
                    //     },
                    //     async: true,
                    //     data: {bondId:$("#bondId").val()},
                    //     url: exportUrl,
                    //     success: function (data, status, xhr) {
                    //         console.log(4444)
                    //         // 错误示例，不应该这样做，因为responseType是blob
                    //         var textData = xhr.responseText;
                    //         var blob = new Blob([data], { type: 'application/vnd.ms-excel' });
                    //         var link = document.createElement('a');
                    //         link.href = window.URL.createObjectURL(blob);
                    //         link.download = 'example.xlsx';
                    //         document.body.appendChild(link);
                    //         link.click();
                    //         document.body.removeChild(link);
                    //         window.URL.revokeObjectURL(link.href);
                    //         console.log(8889999)
                    //     },
                    //     error: function (data, status, xhr) {
                    //         console.log(3333)
                    //         console.log('下载失败：', error);
                    //     }
                    // });

                     //openExportExcel(exportUrl, {bondId:$("#bondId").val()},dt);
                    // processing(false);
                }
            }
        ],
        columns: [
            {data:"billNo",bSortable:false,className:'textCenter'},
            {data:"createByName",bSortable:false,false:'textCenter'},
            {data:"addDate",bSortable:true,className:'textCenter',render: function ( data, type, full, meta ){
                return bt.date.format(full.addDate,'yyyy-MM-dd');
                }},
            {data:"addMoney",bSortable:false,className:'textCenter',render:function ( data, type, full, meta ) {
                    return bt.money.format(full.addMoney);
                }}
        ]
    });
});



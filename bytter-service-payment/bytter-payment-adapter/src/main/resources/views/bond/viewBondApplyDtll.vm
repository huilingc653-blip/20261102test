<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="bondId" id="bondId" value="$!{bondId}">
    <input type="hidden" name="param" id="param" value="$!{param}">
    <table class="layui-table">
        <tr>
            <td class="textRight">状态</td>
            <td>
                <div class=layui-form>
                    <div class=bt-biz-dict data-type="select" data-name="status" data-width="120px" data-biz-name="status"
                         data-group="fcBond.status" data-displayData="2,95" data-defaultvalue="${status}"></div>
                </div>
            </td>
            <td class="textRight">付款单号</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="payBillNo" id="payBillNo"
                           autocomplete="off" class="layui-input" placeholder="付款单号" value="$!{payBillNo}">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">共享单号</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="bursarBillNo" id="bursarBillNo"
                           autocomplete="off" class="layui-input" placeholder="共享单号" value="$!{bursarBillNo}">
                </div>
            </td>
            <td class="textRight">票据号码</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="origNo" id="origNo"
                           autocomplete="off" class="layui-input" placeholder="票据号码" value="$!{origNo}">
                </div>
            </td>
        </tr>
        <tr>
            ##到期日期
            <td class="textRight">项目开始日期</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="startDate" data-biz-name="startDate" data-name="startDate" data-endid="endDate" class="layui-input bt-biz-dateType"
                           data-type="date"  value="$!{startDate}"/>
                </div>
            </td>
            <td class="textRight">项目到期日期</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="endDate" data-biz-name="endDate"　data-name="endDate" class="layui-input bt-biz-dateType"
                           id="endDate" data-type="date"  value="$!{endDate}"/>
                </div>
            </td>
        </tr>
        <tr>
            <td  colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button class="layui-btn" lay-submit="" lay-filter="excel"  type="button">#springMessage('common.button.exports')</button>
            </td>
        </tr>
    </table>
</form>
<form class="layui-form" action="" id="inputForm">
    ##账户项目信息
        <table  class="layui-table layui-form" style="width:100%;" id="appTable">
            <thead>
            <tr>
                <td class="textLeft" colspan="16">#springMessage('table.fcBond.itemInfo')</td>
            </tr>
            <tr>
                <th>#springMessage('table.fcBond.orderNo')</th>
                <th>#springMessage('table.fcBond.billNo')</th>
                <th>#springMessage('table.fcBond.itemType')</th>


                <th>#springMessage('table.fcBond.itemStartDate')</th>
                <th>#springMessage('table.fcBond.itemEndDate')</th>
                <th>#springMessage('table.fcBond.applyMoney')</th>
                <th>#springMessage('table.fcBond.status')</th>##状态
                <th>释放日期 </th>
                <th>#springMessage('common.table.thead.operation')</th>
                </th>
            </tr>
            </thead>
            #foreach($obj in $listFcBondApply)
                <tr>
                    #if($!{obj.id})
                        <td style="text-align:center">$velocityCount</td>
                    #else
                        <td style="text-align:center"></td>
                    #end
                    <td style="text-align:center">$!{obj.itemNo}</td>
                    <td style="text-align:center">$dictTag.get("fcBond.itemType",$!{obj.itemType})</td>


                    <td style="text-align:center">$!date.format('yyyy-MM-dd',$!{obj.startDate})</td>
                    <td style="text-align:center">$!date.format('yyyy-MM-dd',$!{obj.endDate})</td>
                    <td style="text-align:right">$number.formatNumeric($!{obj.applyMoney})</td>
                    <td style="text-align:center">$dictTag.get("fcBond.status",$!{obj.status})</td>
                    <td style="text-align:center">$!date.format('yyyy-MM-dd',$!{obj.releaseDate})</td>
                    #if($!{obj.id})
                        <td style="text-align:center">
                            <a onclick="link('$!{obj.id}')">#springMessage('common.button.view')</a></td>
                    #else
                        <td style="text-align:center"></td>
                    #end
                </tr>
            #end
        </table>
</form>
</body>

#parse("views/common/footer.vm")

<script src="${basePath}/static/modules/fcbond/bondApplyDtl.view.js?_btv=${resourceVersion}"></script>
</html>
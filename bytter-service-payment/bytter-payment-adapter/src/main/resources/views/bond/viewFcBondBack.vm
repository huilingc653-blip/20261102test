<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="" id="inputForm">
	<input id="corpId" name="corpId" type="hidden" value="$!{fcBondBackVO.corpId}">
	<input id="corpName" name="corpName" type = "hidden" value="$!{fcBondBackVO.corpName}">
	<input id="bondId" name="bondId" type = "hidden" value="$!{fcBondBackVO.bondId}">
	<input id="bankAcc" name="bankAcc" type="hidden" value="$!{fcBondBackVO.bankAcc}">
	<input id="accName" name="accName" type = "hidden" value="$!{fcBondBackVO.accName}">
	<input id="bankName" name="bankName" type = "hidden" value="$!{fcBondBackVO.bankName}">
	<input id="bondBal"  name="bondBal" type = "hidden" value="$!{fcBondBackVO.balMoney}">
	<input id="applyMoney" name="applyMoney" type = "hidden" value="$!{fcBondBackVO.applyMoney}">
	<input   data-name="availMoney" data-biz-name="availMoney" class="bt-biz-moneyType" type="hidden" value="$!{fcBondBackVO.availMoney}">
	<input   data-name="backInterest" data-biz-name="backInterest" class="bt-biz-moneyType" type="hidden" value="$!{fcBondBackVO.backInterest}">
	##保证金账户信息
 <table class="layui-table">
        <thead>
		##保证金账户信息
        <tr>
            <td class="textLeft" colspan="4">#springMessage('table.fcBond.fcBondInfo')</td>
		</tr>
        </thead>
		<tbody>
        <tr>
			##单位名称
            <td class="textRight" width="25%">#springMessage('table.fcBond.corpName')</td>
            <td width="25%" class="textLeft">$!{fcBondBackVO.corpName}</td>
			##存入账户
			<td width="25%" class="textRight">#springMessage('table.fcBond.depositaccount')</td>
			<td width="25%" class="textLeft">$!{fcBondBackVO.bankAcc}</td>
        </tr>
		<tr>
			##账户名称
            <td class="textRight" width="25%">#springMessage('table.fcBond.accountname')</td>
            <td width="25%" class="textLeft">$!{fcBondBackVO.accName}</td>
			##银行名称
			<td width="25%" class="textRight">#springMessage('table.fcBondBack.bankName')</td>
			<td width="25%" class="textLeft">$!{fcBondBackVO.bankName}</td>
        </tr>
		<tr>
			##当前账户余额
            <td class="textRight" width="25%">#springMessage('table.fcBond.accBal')</td>
            <td width="25%" class="textLeft">$number.formatNumeric($!{fcBondBackVO.balMoney})</td>
			##占用金额
			<td width="25%" class="textRight">#springMessage('table.fcBond.occupyMoney')</td>
			<td width="25%" class="textLeft">$number.formatNumeric($!{fcBondBackVO.applyMoney})</td>
        </tr>
		<tr>
			##可用金额
            <td class="textRight" width="25%">#springMessage('table.fcBond.availableMoney')</td>
            <td width="25%" class="textLeft">$number.formatNumeric($!{fcBondBackVO.availMoney})</td>
             ##币别
            <td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.curCode')</td>
            <td >$!{fcBondBackVO.curName}</td>
        </tr>

        <tr>
        ##保证金类型
            <td class="textRight">#springMessage('fcbond.type')</td>
            <td >$!{fcBondBackVO.bondTypeName}</td>

        ##存入日期
            <td class="textRight">#springMessage('table.fcBond.depositdate')</td>
            <td>
                <input id="startDate" type="hidden" value="$!{fcBondBackVO.startDate}">
                <input id="endDate" type="hidden" value="$!{fcBondBackVO.endDate}">
                $!date.format('yyyy-MM-dd',$!{fcBondBackVO.startDate})
            </td>
        </tr>

        <tr>
        ##是否存入定期
            <td class="textRight">#springMessage('fcbond.is.to.regular')</td>
            <td >
                <input type="hidden" id="isRegular" value="$!{fcBondBackVO.isRegular}">
                $dictTag.get("sf_yn",$!{fcBondBackVO.isRegular})
            </td>

        ##利率
            <td class="textRight">#springMessage('table.choBankFinance.interestRate')</td>
            <td>
                <input id="rate" type="hidden" value="$!{fcBondBackVO.interestRate}">
                $rateTag.show($!{fcBondBackVO.interestRate})
            </td>
        </tr>

        <tr class="toRegular" style="display: none">
        ##到期日期
            <div>
                <td class="textRight">#springMessage('table.choBankFinance.deadlineDate')</td>
                <td>
                    $!date.format('yyyy-MM-dd',$!{fcBondBackVO.endDate})
                </td>
            </div>
        ##期限：3个月、6个月、1年、2年、3年、5年
            <td class="textRight">#springMessage('table.choBankFinance.dayLimit')</td>
            <td>$!{fcBondBackVO.dayLimit}#springMessage('config.nis.day')
                <input id="dayLimi" type="hidden" value="$!{fcBondBackVO.dayLimit}">
            </td>
        </tr>

		<tr>
			##转回保证金
            <td width="25%" class="textRight">#springMessage('table.fcBond.backfcBond')</td>
			<td width="25%">
				$number.formatNumeric($!{fcBondBackVO.backMoney})
			</td>
        ##利息收入
            <td width="25%" class="textRight">#springMessage('table.fcBond.interestIncom')</td>
            <td width="25%" class="textLeft">$number.formatNumeric($!{fcBondBackVO.backInterest})</td>
        </tr>
        <tr>
            <td colspan="7" style="text-align: center;">
                <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
                <button class="layui-btn" lay-submit="" lay-filter="excel"  type="button">#springMessage('common.button.exports')</button>
            </td>
        </tr>
	 </tbody>
	</table>
</form>
	##账户项目信息
    <form id="searchForm" class="layui-form">
    <input type="hidden" name="eqs_bondId" value="$!{bondId}"/>
	<table  class="layui-table layui-form" style="width:100%;" id="appTable">
    <thead>
	<tr>
         <td class="textLeft" colspan="6">#springMessage('table.fcBond.itemInfo')</td>
	</tr>
    <tr>
        <th>#springMessage('table.fcBond.orderNo')</th>
        <th>#springMessage('table.fcBond.billNo')</th>
        <th>#springMessage('table.fcBond.itemType')</th>
        <th>#springMessage('table.fcBond.itemStartDate')</th>
		<th>#springMessage('table.fcBond.itemEndDate')</th>
		<th>#springMessage('table.fcBond.applyMoney')</th>
    </tr>
    </thead>
##	#foreach($obj in $listFcBondApply)
##	<tr>
##		<td style="text-align:center">$velocityCount</td>
##		<td style="text-align:center">$!{obj.billNo}</td>
##		<td style="text-align:center">$dictTag.get("fcBond.itemType",$!{obj.itemType})</td>
##		<td style="text-align:center">$!date.format('yyyy-MM-dd',$!{obj.startDate})</td>
##		<td style="text-align:center">$!date.format('yyyy-MM-dd',$!{obj.endDate})</td>
##		<td style="text-align:center">$!{obj.applyMoney}</td>
##	</tr>
##	#end
  </table>
    </form>
  ##转回历史记录
	<table  class="layui-table layui-form" style="width:100%;">
    <thead>
	<tr>
         <td class="textLeft" colspan="7">#springMessage('table.fcBond.backRecord')</td>
	</tr>
    <tr>
        <th>#springMessage('table.fcBond.orderNo')</th>
        <th>#springMessage('table.fcBond.backOperator')</th>
        <th>#springMessage('table.fcBond.backDate')</th>
        <th>#springMessage('table.fcBond.backMoney')</th>
		<th>#springMessage('table.fcBond.interestIncom')</th>
        <th>#springMessage('fcBondBack.outBankAcc')</th>
        <th>#springMessage('table.choBankFinance.purpose')</th>
    </tr>
    </thead>
	#foreach($re in $listFcBondBack)
	<tr>
        <td style="text-align:center">$velocityCount</td>
		<td style="text-align:center">$!{re.createByName}</td>
        <td style="text-align:center">$!date.format('yyyy-MM-dd HH:mm:ss',$!{re.backDate})</td>
        <td style="text-align:right">$number.formatNumeric($!{re.backMoney})</td>
		<td style="text-align:right">$number.formatNumeric($!{re.backInterest})</td>
        <td style="text-align:center">$!{re.outBankAcc}</td>
        <td style="text-align:center">$!{re.purpose}</td>
    </tr>
	#end
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/fcbond/fcBondBackDetail.js?_btv=${resourceVersion}"></script>
</html>
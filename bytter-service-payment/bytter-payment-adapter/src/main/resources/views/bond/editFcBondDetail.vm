<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	#rateInfo input {
    		text-align:right;
    	}
    	#rateInfo .bt-biz-rateType {
    		width:128px;
    	}
    
    </style>
</head>
<body>
	<form class="layui-form" method="post">
		<input id="accCorpId" name="accCorpId" type="hidden"value="$!{fcBond.corpId}">
		<input id="bankAccId" name="bankAccId" type = "hidden" value="$!{fcBond.bankAccId}">
		<input id="corpName" name="corpName" type = "hidden" value="$!{fcBond.corpName}">
		<input id="createBy" name="createBy" type = "hidden" value="$!{fcBond.createBy}">
		<input id="billNo" name="billNo" type = "hidden" value="$!{fcBond.billNo}">
		<input id="id" name="id" type=hidden value="$!{fcBond.id}">
		<input  id="status"  name="status" type="hidden" value="">
		<input id="reId" type="hidden" value="$!{fcBond.bankAccId}">
		<input id = "status" name="status" type="hidden">
##		<input id="updateDate" name="updateDate" type = "hidden" value="$!{fcBond.updateDate}">
		<input id="updateBy" name="updateBy" type = "hidden" value="$!{fcBond.updateBy}">
##		<input id="createDate" name="createDate" type = "hidden" value="$!{fcBond.createDate}">
		<input id="updateBy" name="updateBy" type = "hidden" value="$!{fcBond.updateBy}">
		<input id="isRegular" type="hidden" value="$!{fcBond.isRegular}">
		<input id="isOnline" type="hidden" value="$!{fcBond.isOnline}">
		<input id="outBankAccMoney" type="hidden" value="$!{fcBond.outBankAccMoney}">
		## 存出账号是否是在线账号
		<input type="hidden" id="outBankAccountIsOnline" value="$!{outBankAccountIsOnline}"/>
		<table class="layui-table">
		<tbody>
			<tr>
				<td colspan="4" style="text-align: center;">
					<label><b>#springMessage('table.fcBond.inputdate')</b></label>
					<div class="layui-input-inline"> 
						<input id="inputDate" name="createDate" value="$!date.format('yyyy-MM-dd',$!{fcBond.createDate})" readonly="readonly" autocomplete="off" class="layui-input">
					</div>
				</td>
			</tr>
        	<tr>
        		##单位名称
				<td class="textRight" width="14%">#springMessage('table.fcBond.corpName')</td>
				<td width="36%">
					<div class="layui-input-inline">
						<div class="bt-biz-corp" 
							data-biz-type="corp"
							data-type="selectTree"
							data-name="corpId"
							data-biz-name="corpId"
							data-scope="all"
							data-required="true"
							data-callback="bt.corpCallback"
							data-resource="netbank:fcBond:depositOut:apply"
							data-defaultvalue="$!{fcBond.corpId}">
						</div>
					</div>
				</td>
	
        		##存入银行
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.bankName')</td>
				<td colspan="3">
					<div class="layui-inline">
##						<input class="layui-input" id="bankName" name="bankName" readonly="readonly" type="text"
##							   lay-verify="required"
##							   style="width: 280px" placeholder="#springMessage('table.fcBond.bankName')"
##							   value="$!{fcBond.bankName}"/>
						<span id="bankName">$!{fcBond.bankName}</span>
					</div>
				</td>
			</tr>
           <tr>
		  ##存入账号
           <td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.depositaccount')</td>
					<td>
						<div class="layui-input-inline">
							<input type="text" id="bankAcc" name="bankAcc" lay-verify="required|tableData" data-biz-name="bankAcc" lay-verify="required"
								 autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fcBond.depositaccount')"
								 value="$!{fcBond.bankAcc}">
							<table id="bankAccTable" class="hide">
								<thead>
									<tr>
										<th>#springMessage('table.fcBond.depositaccount')</th>
										<th>#springMessage('table.fcBond.depositaccountName')</th>
										<th>#springMessage('table.fcBond.depositBank')</th>
                                        <th>#springMessage('table.fcBond.curCode')</th>
									</tr>
								</thead>
							</table>
						</div>
				</td>
			##账户名称
			   <td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.accountname')</td>
			   <td>
				   <div class="layui-input-inline">
##					   <input type="text" id="accName" name="accName" lay-verify="required" readonly="readonly"
##							  lay-verify="required"
##							  style="width:300px;" autocomplete="off" class="layui-input"
##							  placeholder="#springMessage('table.fcBond.accountname')" value="$!{fcBond.accName}">
					   <span id="accName">$!{fcBond.accName}</span>
				   </div>
			   </td>
		   </tr>
        	<tr>
			##币别
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.curCode')</td>
				<td >
					<input id="curId" name="curId" type="hidden" value="$!{fcBond.curId}" />
					<input id="curName" name="curName"  type="text" readonly="readonly"  class="layui-input" value="$!{fcBond.curName}" />
				</td>

			##存入日期
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.depositdate')</td>
				<td >
					<input id="startDate" name="startDate"  data-biz-name="repayDate"  lay-verify="required" data-callback="endDateCallback"
					data-type="date" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!{fcBond.startDate})" data-endid="endDate"></input>
				</td> ##$!date.format('yyyy-MM-dd',$!{bvVouInputPage.inputDate})
			</tr>

			<tr>
			##存出账号
				<td class="textRight">#springMessage('table.eAccrualBill.saveAcc')</td>
				<td>
					<div class="layui-input-inline">
						<input type="text" id="outBankAcc" name="outBankAcc" lay-verify="tableData" data-biz-name="outBankAcc"
							   autocomplete="off" class="layui-input" value="$!{fcBond.outBankAcc}">
						<table id="outBankAccTable" class="hide">
							<thead>
							<tr>
								<th>#springMessage('table.nisBillhead.payerAcc')</th>
								<th>#springMessage('table.nisBillhead.payerAccName')</th>
								<th>#springMessage('table.nisBillhead.payerBank')</th>
								<th>#springMessage('table.fcBond.curCode')</th>
								<th>#springMessage('table.btBankAcc.isOnline')</th>
							</tr>
							</thead>
						</table>
					</div>
				</td>

			##账户余额
				<td class="textRight">#springMessage('table.nisBillhead.balance')</td>
				<td>
					<span id="accBalance">$!{fcBond.outBankAccMoney}</span>
				</td>
			</tr>

			<tr>
			##保证金类型
				<td class="textRight">#springMessage('fcbond.type')</td>
				<td>
					<div class="bt-biz-selectType layui-inline"
						 data-biz-name="bondTypeId"
						 data-url="${basePath}/bond/fcbondtype/getBondType"
						 data-valuefield="id"
						 data-textfield="bondTypeName"
						 data-name="bondTypeId"
						 data-search="true"
						 data-value="$!{fcBond.bondTypeId}"
					></div>
				</td>
				<td></td>
				<td></td>
			</tr>

            <tr>
			##保证金金额
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.bondmoney')</td>
				<td >
					<input type="text" id="bondMoney" name="bondMoney" data-decimal="2" lay-verify="required"
						   class="layui-input bt-biz-moneyType" data-biz-name="bailmoney"  data-toUp="payMoneyUp"
						   placeholder="#springMessage('table.cmsProvideLoanInfo.bailmoney')" value="$!{fcBond.bondMoney}">
				</td>
			##保证金金额(大写)
				<td class="textRight">#springMessage('table.fcBond.bondmoney.big')</td>
				<td>
					<div id="payMoneyUp"></div>
				</td>
            </tr>

			<tr>
			###是否存入定期
				<td class="textRight"><span style="color: red">*</span>#springMessage('fcbond.is.to.regular')</td>
				<td>
					<div class="bt-biz-dict"
						 data-type="radio"
						 data-group="sf_yn"
						 data-name="isRegular"
						 data-biz-name="isRegular"
						 data-callback="toRegular"
						 data-defaultvalue="$!{fcBond.isRegular}"
					></div>
				</td>

			##利率
				<td class="textRight">#springMessage('table.choBankFinance.interestRate')</td>
				<td >
					<input type="text" id="interestRate" name="interestRate" data-biz-name="interestRate" value="$!{fcBond.interestRate}" autocomplete="off" class="layui-input bt-biz-rateType">
				</td>
			</tr>

			<tr class="toRegular" style="display: none">
			##到期日期
				<div>
					<td class="textRight">#springMessage('table.choBankFinance.deadlineDate')</td>
					<td>
						<div class="layui-input-inline">
							<input type="text"
								   id="endDate"
								   name="endDate"
								   data-name="endDate"
								   data-biz-name="endDate"
								   class="layui-input bt-biz-dateType"
								   data-type="date"
								   value="$!{fcBond.endDate}"
								   data-callback="endDateCallback">
						</div>
					</td>
				</div>
			##期限：3个月、6个月、1年、2年、3年、5年
				<td class="textRight">#springMessage('table.choBankFinance.dayLimit')</td>
				<td>
					<div class="layui-input-inline">
						<input type="text" name="dayLimit" data-biz-name="dayLimit" autocomplete="off" class="layui-input bt-biz-moneyType"
							   data-decimal="0" data-separator="" readonly="readonly" value="$!{fcBond.dayLimit}">
					</div>
					<div class="layui-input-inline">#springMessage('config.nis.day')</div>
				</td>
			</tr>

            <tr>
			##是否已付款
				<td class="textRight">
					<div class="isPay" style="display: none">
						<span style="color: red">*</span>#springMessage('table.fcBond.ispayed')
					</div>
				</td>
				<td>
					<div class="bt-biz-dict isPay" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{fcBond.isPayed}"
						data-name="isPayed" data-biz-name="isPayed" />
				</td>
			##用途
				<td class="textRight">#springMessage('table.choBankFinance.purpose')</td>
				<td>
					<div class="layui-input-inline">
						<input type="hidden" id="purposeDef" value="$!{fcBond.purpose}">
						<div class="bt-biz-selectType" data-name ="purpose" data-extraData="true" data-biz-name ="purpose" data-valueField="purpose" data-textField="purpose"
							 data-defaultvalue="$!{fcBond.purpose}" data-inputvalue="inputvalue" data-search="true" data-required="true"
							 data-url="${basePath}/basic/business/btpurpose?getByList&sysBusType=4&corpId=$!{fcBond.corpId}"></div>
					</div>
				</td>
			</tr>
				
			##备注
			<tr>
				<td class="textRight">#springMessage('table.fcBond.rmk')</td>
				<td colspan="3">
                	<textarea lay-verify="strlength" type="text" id="remark" name="remark" class="layui-textarea" data-maxlength="100"
                    placeholder="#springMessage('table.cmsProvideLoanInfo.rmk')">$!{fcBond.remark}</textarea>
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('cms.loan.attachment')</td>
				<td style="text-align: center;" colspan="3">
					<!-- 附件上传 -->
					<input id="annexName" name="uploadId" type="hidden" value="$!{fcBond.attachmentId}">
			        <div id="uploader" class="layui-input-inline" style="width:100%"></div>
				</td>
			</tr>
			<tr>
				<td style="text-align: center;" colspan="4">
					<button class="layui-btn" lay-submit="" id="submit" value="11">#springMessage('common.button.submit')</button>
					<button class="layui-btn" lay-submit="" id="temp" value="0">#springMessage('common.button.temp')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/fcbond/fcBond.edit.js?_btv=${resourceVersion}"></script>
</html>
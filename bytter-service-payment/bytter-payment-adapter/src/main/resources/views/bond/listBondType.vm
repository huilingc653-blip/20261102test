<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    <td class="textRight">#springMessage('fcbond.typecode')</td>
                    <td >
                        <div class="layui-inline">
                             <input type="text" name="likes_bondTypeCode" autocomplete="off" class="layui-input">
                        </div>
                    </td>

                    <td class="textRight">#springMessage('fcbond.typename')</td>
                    <td >
                        <div class="layui-inline">
                            <input type="text" name="likes_bondTypeName" autocomplete="off" class="layui-input">
                        </div>
                    </td>
                </tr>

                <tr>
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
    
            </tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('fcbond.typecode')</th>
                <th>#springMessage('fcbond.typename')</th>
                <th>#springMessage('table.bvStorageBox.validSign')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>

    #parse("views/common/footer.vm")
</body>
</html>
<script>
bt.use(['form','datatable','dicts'], function(){
    $ = bt.jquery,form = bt.form();
    bt.dicts.init();

    //生成列表
    bt.datatable.init({
        elem: "#appTable",
        dom: 'Brtlip',
        colReorder: true,
        searchForm: {
            formElem: "#searchForm",
            formFilter: "search"
        },
        ajax: {
            'url': basePath+"/bond/fcbondtype/datatable"
        },
        buttons: [
            {
                text: bt.lang('common.button.add'),
                action: function ( e, dt, node, config ) {
                    add();
                }
            },{
                extend: "colvis",
                text: bt.lang('common.button.theadHide'),
            }
        ],
        columns: [
            {data:"bondTypeCode",bSortable:true,className:'center'},
            {data:"bondTypeName",bSortable:true,className:'center'},
            {data:"validSign",bSortable:true,className:'center',
                render: function ( data, type, full, meta ) {
                    return bt.dict("valid_sign",full.validSign);
                }
            },
            {data:null,bSortable:false,className:'center',render: function (data, type, full, meta) {
                var html = '<a class="" href="#" data-row="'+meta.row+'" onclick="view(this)">'+bt.lang("common.button.view")+'</a>';
                    html += ' <a class="" href="#" data-row="'+meta.row+'" onclick="update(this)">'+bt.lang("common.button.edit")+'</a>';
                    html += ' <a class="" href="#" data-row="'+meta.row+'" onclick="del(this)">'+bt.lang("common.button.delete")+'</a>';
                return html;
            }}
        ]
    });
});

function add(){
    if(bt.navtab){
        bt.navtab.addNavtab(bt.lang('common.add.data'),basePath + "/bond/fcbondtype/add");
        bt.navtab.refreshCurrentTable();
        return;
    }
    parent.layer.open({
        type: 2,
        area: ['850px', '530px'],
        maxmin: true,
        content: basePath + "/bond/fcbondtype/add",
        end:function(){
           bt.navtab.refreshCurrentTable();
        }
    });
}
function view(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    if(bt.navtab){
        bt.navtab.addNavtab(bt.lang('common.view.data'),basePath + "/bond/fcbondtype/view/" + data.id);
        return;
    }
    parent.layer.open({
        type: 2,
        area: ['850px', '530px'],
        maxmin: true,
        content: basePath + "/bond/fcbondtype/view/" + data.id
    });
}
function update(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    if(bt.navtab){
        bt.navtab.addNavtab(bt.lang('common.update.data'),basePath + "/bond/fcbondtype/update?id=" + data.id);
        bt.navtab.refreshCurrentTable();
        return;
    }
    parent.layer.open({
        type: 2,
        area: ['850px', '530px'],
        maxmin: true,
        content: basePath + "/bond/fcbondtype/update?id=" + data.id,
        end:function(){
            bt.navtab.refreshCurrentTable();
        }
    });
}
function del(el){
    var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    parent.layer.confirm("#springMessage('common.message.confirm.delete')",function(){
        $.post(basePath + "/bond/fcbondtype/delete/" + data.id, function(result){
            bt.navtab.refreshCurrentTable();
            parent.layer.alert(result.msg, {icon: result.success?1:2});
        },'JSON');
    });
}
</script>
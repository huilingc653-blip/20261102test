<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
            <tbody>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage('table.fcBond.corpId')</td>
                    <td>
                        <div class="layui-inline">
                        	<div class="bt-biz-corp"
                                data-biz-type="corp"
                                data-type="selectTree"
                                data-name="likes_corpId"
                                data-scope="all" 
								data-resource="netbank:bond:fcbondInfo:apply"
								placeholder="#springMessage('common.placeholder.select')"></div>
                        </div>
                    </td>
					##项目类型
                    <td class="textRight">#springMessage('table.fcBond.itemType')</td>
                    <td>
                        <div class="layui-inline">
							<select lay-filter="itemType" name="eqs_itemType" >
								<option value=" ">#springMessage('common.placeholder.select')</option>
								#foreach($dict in $dictTag.list("fcBond.itemType"))
								<option value="$dict.code">$dict.name</option>
								#end
							</select>
						</div>
                    </td>
					##存入账户
					 <td class="textRight">#springMessage('table.fcBond.depositaccount')</td>
                    <td>
                        <input type="text" name="likes_bankAcc" autocomplete="off" class="layui-input bank" >
                    </td>
                </tr>
				<tr>
                    ##账户名称
                    <td class="textRight">#springMessage('table.fcBond.accountname')</td>
                    <td>
                        <input type="text" name="likes_accName"  autocomplete="off" class="layui-input">
                    </td>
					##存入银行
                    <td class="textRight">#springMessage('table.fcBond.bankName')</td>
                    <td>
                        <input type="text" name="likes_bankName"  autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcBond.bankName')">
                    </td>
    				##项目到期日期
                    <td class="textRight">#springMessage('table.fcBond.itemEndDate')</td>
                    <td>
                        <input type="text" name="ged_endDate"  data-name="ged_endDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="endDate" >
                        <span class="date-mid">#springMessage('table.fcBond.rangeofdate')</span>
                        <input type="text" name="led_endDate" data-name="led_endDate" class="layui-input bt-input-inline bt-biz-dateType" id="endDate">
                    </td>
					</tr>
					<tr>
					##录入日期
                    <td class="textRight">#springMessage('table.fcBond.inputdate')</td>
                    <td>
                        <div class="layui-inline">
							<input type="text" name="ged_createDate" data-name="ged_createDate" class="layui-input bt-biz-dateType" data-endid="createDate" data-type="date">
                		</div>
						<span class="date-mid">#springMessage('table.fcBond.rangeofdate')</span>
						<div class="layui-inline"">
							<input type="text" name="led_createDate"　data-name="led_createDate" class="layui-input bt-biz-dateType" id="createDate" data-type="date">
                		</div>
                    </td>
					##项目单号
                    ##<td class="textRight">#springMessage('table.fcBond.billNo')</td>
                    ##<td>
                     ##   <input type="text" name="likes_itemNo"  autocomplete="off" class="layui-input bank">
                    ##</td>
					<td class="textRight" colspan="4"></td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>	
    </form>  

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.fcBond.corpName')</th>
                <th>#springMessage('table.fcBond.billNo')</th>
                <th>#springMessage('table.fcBond.itemType')</th>
                <th>#springMessage('table.fcBond.itemStartDate')</th>
                <th>#springMessage('table.fcBond.itemEndDate')</th>
                <th>#springMessage('table.fcBond.depositaccount')</th>
                <th>#springMessage('table.fcBond.accountname')</th>
				<th>#springMessage('table.fcBond.bankName')</th>
                <th>#springMessage('table.fcBond.curCode')</th>##币别
                <th>#springMessage('table.fcBond.accBal')</th>
				<th>#springMessage('table.fcBond.occupyMoney')</th>
				<th>#springMessage('table.fcBond.inputdate')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/fcbond/searchFcBondItem.list.js?_btv=${resourceVersion}"></script>
</html>

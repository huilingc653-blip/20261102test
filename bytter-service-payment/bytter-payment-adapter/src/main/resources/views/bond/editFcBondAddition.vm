	<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 12px; 
	text-align: center;
	border-left: 0px;
	border-right: 0px;
	background-color: #d2d2d2;
}
</style>  
<!-- 完整info信息的View -->
<body  style="padding: 0px;">
 <form class="layui-form" method="post" id="inputForm">
	<input type="hidden" id="corpId" name="corpId" value="$!{fcBond.corpId}"/>
    <input type="hidden" id="bondId" name="bondId" value="$!{fcBond.id}"/>
	<input type="hidden" id="addOrUpdateFlag" name="addOrUpdateFlag" value="6"/>
	<input type="hidden" id="id" name="id" value="$!{fcbondAddDTO.id}"/>
	<input type="hidden"  class="layui-input bt-biz-dateType" id="createDate" name="createDate" value="$!date.format('yyyy-MM-dd',$!{fcbondAddDTO.createDate})"/>
	<input type="hidden" id="createBy" name="createBy" value="$!{fcbondAddDTO.createBy}"/>
	<input type="hidden" id="saveType" name="saveType" />
	<input type="hidden" id="billNo" name="billNo" value="$!{fcbondAddDTO.billNo}"/>
	<input type="hidden" id="isPayedValue" name="isPayedValue" value="$!{fcbondAddDTO.isPayed}"/>
	 <input id="isOnline" type="hidden" value="$!{fcbondAddDTO.isOnline}">
	 <input id="outBankAccMoney" type="hidden" value="$!{fcbondAddDTO.outBankAccMoney}">
	<div style="margin-bottom: 10px">
    <table class="layui-table">
    	<tbody>
	    <tr>
	    	##申请单号
			<td class="textRight" width="20%">#springMessage('table.fcBond.appNo')</td>
			<td width="30%">$!{fcBond.billNo}</td>
			##录入日期
			<td class="textRight" width="20%">#springMessage('table.fcBond.inputdate')</td>
			<td width="30%">$!date.format('yyyy-MM-dd',$!{fcBond.createDate})</td>
		</tr>
		 <tr>
	    	##单位名称
			<td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.corpName')</td>
			<td >$!{fcBond.corpName}</td>
			##存入银行
			<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.bankName')</td>
			<td >$!{fcBond.bankName}</td>		
		</tr>
		<tr>
	    	##存入账号
			<td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.depositaccount')</td>
			<td >$!{fcBond.bankAcc}</td>
			##账户名称
			<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.accountname')</td>
			<td >$!{fcBond.accName}</td>		
		</tr>
		<tr>
	    	##保证金金额
			<td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.bondmoney')</td>
			<td >$number.formatNumeric($!{fcBond.bondMoney})</td>
			##存入日期
			<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.depositdate')</td>
			<td >$!date.format('yyyy-MM-dd',$!{fcBond.startDate})</td>
		</tr>
        <tr>
		##保证金账户余额
            <td class="textRight" width="25%">#springMessage('table.fcBond.accBal')</td>
            <td>$number.formatNumeric($!{fcBond.balMoney})</td>
		##可用金额
            <td class="textRight" width="25%">#springMessage('table.fcBond.availableMoney')</td>
            <td>$number.formatNumeric($!{fcBond.availMoney})</td>
        </tr>
		<tr>
		    ##币别
            <td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.curCode')</td>
            <td >
                <input id="curId" name="curId" type="hidden" value="$!{fcBond.curId}" />
               $!{fcBond.curName}
            </td>
			##历史追加金额总和
			<td class="textRight">#springMessage('table.fcBond.addBondMoney')</td>
			<td >$number.formatNumeric($!{fcbondAddDTO.sumAddMoney})</td>
	    	##是否已付款
			##<td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.ispayed')</td>
			##<td >$!{fcBond.isPayedName}</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage('fcbond.type')</td>
			<td >$!{fcBond.bondTypeName}</td>
			<td></td>
			<td></td>
		</tr>
		<tr>
			<td class="textRight">#springMessage('fcbond.is.to.regular')</td>
			<td >$dictTag.get("sf_yn",$!{fcBond.isRegular})</td>
			<td></td>
			<td></td>
		</tr>
		<tr>
	    	##备注
			<td class="textRight" >#springMessage('table.fcBond.rmk')</td>
			<td colspan="3">$!{fcBond.remark}</td>
		</tr>
		<tr>
    	    ##附件
		    <td class="textRight">#springMessage('netbank.common.attachment')</td>
      	    <td colspan="3">
      		<!-- 附件上传 -->
			<input id="annexNameInfo" name="annexNameInfo" type="hidden" value="$!{fcBond.attachmentId}">
	        <div id="uploaderInfo" class="layui-input-inline" style="width:100%"></div>
      	    </td>
	    </tr>

		<tr>
		##存出账号
			<td class="textRight">#springMessage('table.eAccrualBill.saveAcc')</td>
			<td>
				<div class="layui-input-inline">
					<input type="text" id="outBankAcc" name="outBankAcc" lay-verify="tableData" data-biz-name="outBankAcc"
						   autocomplete="off" class="layui-input" value="$!{fcbondAddDTO.outBankAcc}">
					<table id="outBankAccTable" class="hide">
						<thead>
						<tr>
							<th>#springMessage('table.nisBillhead.payerAcc')</th>
							<th>#springMessage('table.nisBillhead.payerAccName')</th>
							<th>#springMessage('table.nisBillhead.payerBank')</th>
							<th>#springMessage('table.fcBond.curCode')</th>
							<th>#springMessage('table.btBankAcc.isOnline')</th>
						</tr>
						</thead>
					</table>
				</div>
			</td>

		##账户余额
			<td class="textRight">#springMessage('table.nisBillhead.balance')</td>
			<td>
				<input type="hidden" id="accMoney">
				<span id="accBalance">$!{fcbondAddDTO.outBankAccMoney}</span>
			</td>
		</tr>


		<tr>
	    	##新追加金额
			<td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.newAddMoney')</td>
			<td >
               <input type="text" id="addMoney" name="addMoney" value="$!{fcbondAddDTO.addMoney}" data-decimal="2"
				class="layui-input bt-biz-moneyType" data-biz-name="addMoney"  
				placeholder="#springMessage('table.cmsProvideLoanInfo.bailmoney')">
			</td>

			##用途
			<td class="textRight">#springMessage('table.choBankFinance.purpose')</td>
			<td>
				<div class="layui-input-inline">
					<input type="hidden" id="purposeDef" value="$!{fcbondAddDTO.purpose}">
					<div class="bt-biz-selectType" data-name ="purpose" data-biz-name ="purpose" data-extraData="true" data-valueField="purpose" data-textField="purpose"
						 data-defaultvalue="$!{fcbondAddDTO.purpose}" data-inputvalue="inputvalue" data-search="true" data-required="true"
						 data-url="${basePath}/basic/business/btpurpose?getByList&sysBusType=4&corpId=$!{fcBond.corpId}"></div>
				</div>
			</td>
		</tr>

		<tr>
		##是否已付款
			<td class="textRight">
				<div class="isPay" style="display: none">
					<span style="color: red">*</span>#springMessage('table.fcBond.ispayed')
				</div>
			</td>
			<td>
				<div class="bt-biz-dict isPay" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{fcbondAddDTO.isPayed}"
					 id="isPayed" name="isPayed" data-name="isPayed" data-biz-name="isPayed" data-callback="bt.isPayedCallback" />
			</td>
		</tr>
		
		<tr>
	    	##追加备注
			<td class="textRight" >#springMessage('table.fcBond.addRmk')</td>
			<td colspan="3">
                	<textarea lay-verify="strlength" type="text" id="remark" name="remark" class="layui-textarea" data-maxlength="100"
						placeholder="#springMessage('table.fcBond.addRmk')">$!{fcbondAddDTO.remark}</textarea>
			</td>
		</tr>
		</tbody>
    </table>
    </div>
	    <div style="width: 100%;text-align: center;">
			<button class="layui-btn" lay-submit="" id="submit">#springMessage('common.button.submit')</button>
			<button class="layui-btn" lay-submit="" id="temp">#springMessage('common.button.temp')</button>
			<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		</div>
 </form>
 <form id="searchForm" class="layui-form">
	 <input type="hidden" name="eqs_bondId" value="$!{fcBond.id}"/>
	 <table id="appTable" class="layui-table" style="margin: 0 0;border:0px solid #e2e2e2 !important;">
		 <thead>
		 <tr>
			 <th colspan="6" style="text-align:left;">#springMessage('table.fcBond.addHisDetail')</th>
		 </tr>
		 <tr>
			 <th>#springMessage('table.fcBond.orderNo')</th>##序号
			 <th>#springMessage('table.fcBond.addOpName')</th>##追加操作人
			 <th>#springMessage('table.choBankFinance.payerAcc')</th>##转出账号
			 <th>#springMessage('table.fcBond.addDate')</th>##追加日期
			 <th>#springMessage('table.fcBond.hasAddMoney')</th>##已追加金额
			 <th>#springMessage('table.fcBond.status')</th>##状态
		 </tr>
		 </thead>
	 </table>
 </form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/fcbond/fcBondAddition.edit.js?_btv=${resourceVersion}"></script>
</html>
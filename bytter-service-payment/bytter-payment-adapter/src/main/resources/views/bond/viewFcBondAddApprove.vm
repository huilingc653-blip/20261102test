<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<style type="text/css">
    .voucher-title {
        font-weight: bold;
        font-size: 12px;
        text-align: center;
        border-left: 0px;
        border-right: 0px;
        background-color: #d2d2d2;
    }
</style>
<!-- 完整info信息的View -->
<body  style="padding: 0px;">
<input type="hidden" id="taskId" name="taskId" value="$!{taskId}" />
<input type="hidden" id="corpId" name="corpId" value="$!{fcBond.corpId}"/>
<div>
    <table class="layui-table">
        <tbody>
        <tr>
		##申请单号
            <td class="textRight" width="20%">#springMessage('table.fcBond.appNo')</td>
            <td width="30%">$!{fcBond.billNo}</td>
		##录入日期
            <td class="textRight" width="20%">#springMessage('table.fcBond.inputdate')</td>
            <td width="30%">$!date.format('yyyy-MM-dd',$!{fcBond.createDate})</td>
        </tr>
        <tr>
		##单位名称
            <td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.corpName')</td>
            <td >$!{fcBond.corpName}</td>
		##存入银行
            <td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.bankName')</td>
            <td >$!{fcBond.bankName}</td>
        </tr>
        <tr>
		##存入账号
            <td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.depositaccount')</td>
            <td >$!{fcBond.bankAcc}</td>
		##账户名称
            <td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.accountname')</td>
            <td >$!{fcBond.accName}</td>
        </tr>
        <tr>
		##保证金金额
            <td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.bondmoney')</td>
            <td >$number.formatNumeric($!{fcBond.bondMoney})</td>
		##存入日期
            <td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.depositdate')</td>
            <td >$!date.format('yyyy-MM-dd',$!{fcBond.startDate})</td>
        </tr>
        <tr>
		##是否已付款
		##<td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.ispayed')</td>
		##<td >$!{fcBond.isPayedName}</td>
        ##币别
            <td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.curCode')</td>
            <td >$!{fcBond.curName}</td>
		##历史追加金额
            <td class="textRight">#springMessage('table.fcBond.addBondMoney')</td>
            <td >$number.formatNumeric($!{fcbondAddDTO.sumAddMoney})</td>
        </tr>
        <tr>
		##备注
            <td class="textRight" >#springMessage('table.fcBond.rmk')</td>
            <td colspan="3">$!{fcBond.remark}</td>
        </tr>
        <tr>
		##附件
            <td class="textRight">#springMessage('netbank.common.attachment')</td>
            <td colspan="3">
                <!-- 附件上传 -->
                <input id="annexNameInfo" name="annexNameInfo" type="hidden" value="$!{fcBond.attachmentId}">
                <div id="uploaderInfo" class="layui-input-inline" style="width:100%"></div>
            </td>
        </tr>
        <tr>
		##新追加金额
            <td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.newAddMoney')</td>
            <td colspan="3">$number.formatNumeric($!{fcbondAddDTO.addMoney})</td>
        </tr>

        <tr>
		##追加备注
            <td class="textRight" >#springMessage('table.fcBond.addRmk')</td>
            <td colspan="3">
				$!{fcbondAddDTO.remark}
            </td>
        </tr>
        </tbody>
    </table>
</div>
<table id="appTable" class="layui-table" style="margin: 0 0;border:0px solid #e2e2e2 !important;">
    <thead>
    <tr>
        <th colspan="5" style="text-align:left;">#springMessage('table.fcBond.addHisDetail')</th>
    </tr>
    <tr>
        <th>#springMessage('table.fcBond.orderNo')</th>##序号
        <th>#springMessage('table.fcBond.addOpName')</th>##追加操作人
        <th>#springMessage('table.fcBond.addDate')</th>##追加日期
        <th>#springMessage('table.fcBond.hasAddMoney')</th>##已追加金额
    </tr>
    </thead>
    <tbody>
		#foreach($addHis in $addHisList)
        <tr>
            <td style="text-align:center">$velocityCount</td>
            <td style="text-align:center">$!{addHis.createByName}</td>
            <td style="text-align:center">$!{addHis.addDate}</td>
            <td style="text-align:right">$number.formatNumeric($!{addHis.addMoney})</td>
        </tr>
		#end
    </tbody>
</table>
	#parse("views/common/footer.vm")
	#paymentWorkFlowHtml()
	#paymentWorkFlowScript()
</body>
<script type="text/javascript">
    var billNo;
    bt.use(['form','datatable','corp','moneyType','btUpload','dicts','jquery'], function(){
        $ = bt.jquery,form = bt.form();
        bt.moneyType.init();
        var gInfoId = $("#annexNameInfo").val();
        bt.btUpload.init({
            elem: "#uploaderInfo",
            hasUpload: false,
            hasDelete: false,
            isExpand: true,
            gid: gInfoId
        });
    });
</script>
</html>
#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<input id="attachmentId" name="attachmentId" type="hidden" value="$!{fcBond.attachmentId}">
<ul class="mui-table-view" id="mulTable">
    ##申请单号
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.appNo')
            <span class="mui-badge mui-badge-inverted">
                $!{fcBond.billNo}
            </span>
        </li>
    ##录入日期
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.inputdate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{fcBond.createDate})
            </span>
        </li>
    ##单位名称
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.corpName')
            <span class="mui-badge mui-badge-inverted">
                $!{fcBond.corpName}
            </span>
        </li>
    ##存入银行
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.bankName')
            <span class="mui-badge mui-badge-inverted">
                $!{fcBond.bankName}
            </span>
        </li>
    ##存入账户
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.depositaccount')
            <span class="mui-badge mui-badge-inverted">
                $!{fcBond.bankAcc}
            </span>
        </li>
    ##账户名称
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.accountname')
            <span class="mui-badge mui-badge-inverted">
                $!{fcBond.accName}
            </span>
        </li>
    ##保证金金额
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.bondmoney')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{fcBond.bondMoney})
            </span>
        </li>
    ##存入日期
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.depositdate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{fcBond.startDate})
            </span>
        </li>
    ##币别
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.curCode')
            <span class="mui-badge mui-badge-inverted">
                $!{fcBond.curName}
            </span>
        </li>
    ##历史总追加金额
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.addBondMoney')
            <span class="mui-badge mui-badge-inverted">
                $number.formatNumeric($!{fcbondAddDTO.sumAddMoney})
            </span>
        </li>
    ##新追加金额
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.newAddMoney')
            <span class="mui-badge mui-badge-inverted">
                $number.formatNumeric($!{fcbondAddDTO.addMoney})
            </span>
        </li>
    ##备注
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.rmk')
            <textarea rows="3" class="layui-textarea" readonly="readonly">$!{fcBond.remark}</textarea>
        </li>
    ##追加备注
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.addRmk')
            <textarea rows="3" class="layui-textarea" readonly="readonly">$!{fcbondAddDTO.remark}</textarea>
        </li>
    ##历史追加明细
        #if($!{addHisList})
            <li class="mui-table-view-divider">#springMessage('table.fcBond.addHisDetail')</li>
            <li class="ui-border-t">
                <div class="ui-list-info">
                    <ul class="ui-row"
                        style="border-width: 1px; text-align: center;">
                        <li class="ui-col ui-col-50" style="background: #C4E1FF;"
                            style="border-width: 1px; width: 100%;">
                            <table style="border-collapse: collapse;border-spacing: 0; width: 100%; text-align: center;">
                                <thead>
                                <tr>
                                    <th>#springMessage('table.fcBond.orderNo')</th>##序号
                                    <th>#springMessage('table.fcBond.addOpName')</th>##追加操作人
                                    <th>#springMessage('table.fcBond.addDate')</th>##追加日期
                                    <th>#springMessage('table.fcBond.hasAddMoney')</th>##已追加金额
                                </tr>
                                </thead>
                                <tbody style="background: #fff;">
                                    #foreach($addHis in $addHisList)
                                    <tr>
                                        <td style="text-align:center">$velocityCount</td>
                                        <td style="text-align:center">$!{addHis.createByName}</td>
                                        <td style="text-align:center">$!{addHis.addDateStr}</td>
                                        <td style="text-align:center">$number.formatNumeric($!{addHis.addMoney})</td>
                                    </tr>
                                    #end
                                </tbody>
                            </table>
                        </li>
                    </ul>
                </div>
            </li>
        #end
</ul>
    #parse("views/common/wapfooter.vm")
</body>
<script>
    window.onload=function () {
        var attachmentId = $("#attachmentId").val();
        setTimeout(function () {
            BTAppBridge.initAttachmentByGroupId && BTAppBridge.initAttachmentByGroupId(attachmentId);
        },100);
    }
</script>
</html>

<!DOCTYPE html> 
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
<input type="hidden" name="changeType" id="changeType" value="${changeType}">
</form>
<div>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcBond.depositaccount')</th>##存入账号
        <th>#springMessage('table.fcBond.accountname')</th>##账户名称
        <th>#springMessage('table.fcBond.corpName')</th>##单位名称
        <th>#springMessage('table.fcBond.accBal')</th>##账户余额
        <th>#springMessage('table.fcBond.curCode')</th>##币别
        <th>#springMessage('table.fcBond.itemType')</th>##项目类型
        <th>#springMessage('table.fcBond.billNo')</th>##项目单号
        <th>#springMessage('table.fcBond.bankName')</th>##存入银行
        <th>#springMessage('table.fcBond.bondmoney')</th>##保证金金额
        <th>#springMessage('table.fcBond.itemStartDate')</th>##保证金开始日期
		<th>#springMessage('table.fcBond.itemEndDate')</th>##保证金结束日期
        <th>#springMessage('table.fcBond.bondRate')</th>##保证金账户利率
    </tr>
    </thead>
  <tr>
    <td align="center" >$!{info.bankAcc}</td>
    <td align="center" >$!{info.accName}</td>
    <td align="center" >$!{info.corpName}</td>
    <td align="right" >
		#if($!{info.availMoney})
			$number.formatNumeric($!{info.availMoney})
		#end
	</td>
    <td align="center" >$!{info.curName}</td>
    <td align="center" >$dictTag.get("fcBond.itemType", $!{info.itemType})</td>
    <td align="center" >$!{info.itemNo}</td>
    <td align="center" >$!{info.bankName}</td>
    <td align="center" >
		#if($!{info.applyMoney})
			$number.formatNumeric($!{info.applyMoney})
		#end
	</td>
    <td align="center" >$!date.format('yyyy-MM-dd',$!{info.startDate})</td>
    <td align="center" >$!date.format('yyyy-MM-dd',$!{info.endDate})</td>
      #set($bondRate=$!{info.bondRate}*100)
    <td align="center" >$number.formatNumeric($!bondRate,2)%</td>
  </tr>
</table>
</div>
#parse("views/common/footer.vm")
</body>
</html>
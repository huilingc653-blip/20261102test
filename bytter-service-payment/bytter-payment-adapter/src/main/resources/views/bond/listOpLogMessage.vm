#parse("views/common/head.vm")
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcBond.opTime')</th>
        <th>#springMessage('table.fcBond.operNum')</th>
        <th>#springMessage('table.fcBond.opName')</th>
        <th>#springMessage('table.fcBond.opType')</th>
        <th>#springMessage('table.fcBond.opMessage')</th>
    </tr>
	</thead>
	#foreach($msg in $list)
	<tr>
		<td style="text-align:center;">$!date.format('yyyy-MM-dd',$!{msg.createDate})</td>
		<td style="text-align:center;">$!{msg.createBy}</td>
		<td style="text-align:center;">$!{msg.createByName}</td>
		<td style="text-align:center;">$dictTag.get("fcBond.messageType",$!{msg.msgType})</td>
        <td style="text-align:center;">$dictTag.get("cms.messageType",$!{msg.message})</td>
	</tr>
	#end
</table>

#*
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<input id="attachmentId" name="attachmentId" type="hidden" value="$!{fcBondPreserveVO.attachmentId}">
<ul class="mui-table-view" id="mulTable">
    ##项目信息
    <li class="mui-table-view-divider">#springMessage('table.fcBond.itemMsg')</li>
    ##项目单号
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.billNo')
            <span class="mui-badge mui-badge-inverted">
                $!{fcBondPreserveVO.billNo}
            </span>
        </li>
    ##单位名称
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.corpName')
            <span class="mui-badge mui-badge-inverted">
                $!{fcBondPreserveVO.corpName}
            </span>
        </li>
    ##存入银行
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.bankName')
            <span class="mui-badge mui-badge-inverted">
                $!{fcBondPreserveVO.bankName}
            </span>
        </li>
    ##币别
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.curCode')
            <span class="mui-badge mui-badge-inverted">
                $!{fcBondPreserveVO.curName}
            </span>
        </li>
    ##项目金额
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.itemMoney')
            <span class="mui-badge mui-badge-inverted">
                $number.formatNumeric($!{fcBondPreserveVO.itemMoney})
            </span>
        </li>
    ##项目期限
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.itemUnit')
            <span class="mui-badge mui-badge-inverted">
               $!{fcBondPreserveVO.itemUnit}<label >#springMessage('table.fcBond.month')
            </span>
        </li>
    ##项目开始日期
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.itemStartDate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{fcBondPreserveVO.startDate})
            </span>
        </li>
    ##项目结束日期
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.itemEndDate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{fcBondPreserveVO.endDate})
            </span>
        </li>
    ##保证金信息
    <li class="mui-table-view-divider">#springMessage('table.fcBond.BondMsg')</li>
    ##存入账户
    <li class="mui-table-view-cell">
        #springMessage('table.fcBond.depositaccount')
        <span class="mui-badge mui-badge-inverted">
            $!{fcBondPreserveVO.bankAcc}
        </span>
    </li>
    ##账号名称
    <li class="mui-table-view-cell">
        #springMessage('table.fcBond.accountname')
        <span class="mui-badge mui-badge-inverted">
            $!{fcBondPreserveVO.accName}
        </span>
    </li>
    ##存入银行
    <li class="mui-table-view-cell">
        #springMessage('table.fcBond.bankName')
        <span class="mui-badge mui-badge-inverted">
            $!{fcBondPreserveVO.bankName}
        </span>
    </li>
    ##存入时间
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.depositdate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{fcBondPreserveVO.bondDate})
            </span>
        </li>
    ##保证金账户余额
    <li class="mui-table-view-cell">
        #springMessage('table.fcBond.accBalance')
        <span class="mui-badge mui-badge-inverted">
            $number.formatNumeric($!{fcBondPreserveVO.accBalance})
        </span>
    </li>
##项目合同
    <li class="mui-table-view-cell">
        #springMessage('table.fcBond.contractNum')
        <span class="mui-badge mui-badge-inverted">
            $!{fcBondPreserveVO.bondContract}
        </span>
    </li>
    ##账户当前可用金额
    <li class="mui-table-view-cell">
        #springMessage('table.fcBond.availableMoney')
        <span class="mui-badge mui-badge-inverted">
            $number.formatNumeric($!{fcBondPreserveVO.availMoney})
        </span>
    </li>
    ##占用金额
    <li class="mui-table-view-cell">
        #springMessage('table.fcBond.occupyMoney')
        <span class="mui-badge mui-badge-inverted">
            $number.formatNumeric($!{fcBondPreserveVO.applyMoney})
        </span>
    </li>
    ##备注
        <li class="mui-table-view-cell">
            #springMessage('table.fcBond.rmk')
            <textarea rows="3" class="layui-textarea" readonly="readonly">$!{fcBondPreserveVO.remark}</textarea>
        </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
<script>
    window.onload=function () {
        var attachmentId = $("#attachmentId").val();
        setTimeout(function () {
            BTAppBridge.initAttachmentByGroupId && BTAppBridge.initAttachmentByGroupId(attachmentId);
        },100);
    }
</script>
</html>

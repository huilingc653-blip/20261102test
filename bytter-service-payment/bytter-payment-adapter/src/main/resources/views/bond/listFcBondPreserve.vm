<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
            <tbody>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage('table.fcBond.corpName')</td>
                    <td>
                        <div class="layui-inline">
                        	<div class="bt-biz-corp"
                                data-biz-type="corp"
                                data-type="selectTree"
                                data-name="likes_corpId"
                                data-scope="all"
								data-resource="netbank:fcBond:depositOut:apply"
								placeholder="#springMessage('common.placeholder.select')"></div>
                        </div>
                    </td>
					##项目单号
					<td class="textRight">#springMessage('table.fcBond.billNo')</td>
                    <td>
                        <input type="text" name="likes_itemNo"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcBond.billNo')">
                    </td>
					##存入账户
					 <td class="textRight">#springMessage('table.fcBond.depositaccount')</td>
                    <td>
                        <input type="text" name="likes_bankAcc"
                            autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.fcBond.depositaccount')">
                    </td>
                </tr>
				<tr>
                    ##账户名称
                    <td class="textRight">#springMessage('table.fcBond.accountname')</td>
                    <td>
                        <input type="text" name="likes_accName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcBond.accountname')">
                    </td>
					##存入银行
                    <td class="textRight">#springMessage('table.fcBond.bankName')</td>
                    <td>
                        <input type="text" name="likes_bankName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcBond.bankName')">
                    </td>
    				##项目到期日期
                    <td class="textRight">#springMessage('table.fcBond.itemEndDate')</td>
                    <td>
                        <div class="layui-inline">
							<input type="text" name="ged_endDate" data-name="ged_endDate" class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                		</div>
						<span class="date-mid">#springMessage('table.fcBond.rangeofdate')</span>
						<div class="layui-inline">
							<input type="text" name="led_endDate"　data-name="led_endDate" class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                		</div>
                    </td>
                </tr>
				<tr>
				    ##录入日期
                    <td class="textRight">#springMessage('table.fcBond.inputdate')</td>
                    <td>
                        <div class="layui-inline">
							<input type="text" name="ged_inputDate" data-name="ged_inputDate" class="layui-input bt-biz-dateType" data-endid="inputDate" data-type="date">
                		</div>
						<span class="date-mid">#springMessage('table.fcBond.rangeofdate')</span>
						<div class="layui-inline"">
							<input type="text" name="led_inputDate"　data-name="led_inputDate" class="layui-input bt-biz-dateType"  id="inputDate"  data-type="date">
                		</div>
                    </td>
					##状态
					<td class="textRight">#springMessage('table.fcBond.status')</td>
					<td>
                     <div class="layui-inline">
                      <select lay-filter="status" name="eqi_status" >
                        <option value=" ">#springMessage('common.placeholder.select')</option>
                        #foreach($dict in $dictTag.list("fcBond.status"))
                            <option value="$dict.code">$dict.name</option>
                        #end
                      </select>
                    </div>
                     </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>	
    </form>  

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.fcBond.orderNo')</th>##序号
                <th>#springMessage('table.fcBond.corpName')</th>##单位名称
			    <th>#springMessage('table.fcBond.billNo')</th>##项目单号
			    <th>#springMessage('table.fcBond.itemStartDate')</th>##项目开始日期
				<th>#springMessage('table.fcBond.itemEndDate')</th>##项目结束日期
			    <th>#springMessage('table.fcBond.depositaccount')</th>##存入账号
			    <th>#springMessage('table.fcBond.accountname')</th>##账户名称
                <th>#springMessage('table.fcBond.bankName')</th>##存入银行
                <th>#springMessage('table.fcBond.curCode')</th>##币别
			    <th>#springMessage('table.fcBond.accBalance')</th>##账户余额
                <th>#springMessage('table.fcBond.occupyMoney')</th>##占用金额
				<th>#springMessage('table.fcBond.inputdate')</th>##录入日期
                <th>#springMessage('table.fcBond.status')</th>##状态
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/fcbond/fcBondPreserve.list.js?_btv=${resourceVersion}"></script>
</html>

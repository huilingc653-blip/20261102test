<!DOCTYPE html>
<html lang="en">
<body>
<div>
    <table class="layui-table layui-form dark-layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.fcBond.bondAcc')</td>
            <td  width="36%">$!{fcBondApplyDTO.bankAcc}</td>
            <td class="textRight" >#springMessage('table.fcBond.accountname')</td>
            <td  width="36%">$!{fcBondApplyDTO.accName}</td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcBondBack.bankName')</td>
            <td width="36%">$!{fcBondApplyDTO.bankName}</td>
            <td class="textRight">#springMessage('table.fcBond.corpName')</td>
            <td width="36%">$!{fcBondApplyDTO.corpName}</td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcBond.contractNum')</td>
            <td width="36%">$!{fcBondApplyDTO.bondContract}</td>
            <td class="textRight">#springMessage('table.fcBond.curCode')</td>
            <td width="36%">$!{fcBondApplyDTO.curName}</td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcBond.bondmoney')</td>
            <td width="36%">$!number.formatNumeric($!{fcBondApplyDTO.applyMoney})</td>
            <td class="textRight">#springMessage('table.fcBond.bondPercent')</td>
            #set($bondPercent=$!{fcBondApplyDTO.bondPercent}*100)
            <td width="36%">$!number.formatDoubles($!bondPercent,2)%</td>
        </tr>
        <tr>##保证金利率，需在挂接保证金的业务模块传入名称为“fcBondRate”的值
            <td class="textRight" >#springMessage('table.fcBond.bondRate')</td>
            #set($bondRate=$!{fcBondRate}*100)
            <td width="36%">$number.formatNumeric($!bondRate,"0.0000")%</td>

            ##保证金类型
            #if($!{fromType}=='lease')
            #else
            <td class="textRight" >#springMessage('fcbond.type')</td>
            <td width="36%">$!{fcBondApplyDTO.bailTypeName}</td>
            #end
        </tr>
        </tbody>
    </table>
</div>
</body>
</html>

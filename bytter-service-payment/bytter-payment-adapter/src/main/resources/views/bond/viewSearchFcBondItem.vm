<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="" id="inputForm">
	##保证金账户信息
 <table class="layui-table">
		<td class="textRight" width="25%"></td>
		<td class="textRight" width="25%">#springMessage('table.fcBond.inputdate')</td>
		<td>$!date.format('yyyy-MM-dd',$!{fcBondApplyVO.createDate})</td>
		<td class="textRight" width="25%"></td>
        <thead>
		##项目信息
        <tr>
            <td class="textLeft" colspan="4">#springMessage('table.fcBond.itemMsg')</td>
		</tr>
        </thead>
		<tbody>
        <tr>
			##项目单号
            <td class="textRight" width="25%">#springMessage('table.fcBond.billNo')</td>
            <td width="25%" class="textLeft">$!{fcBondApplyVO.itemNo}</td>
			##单位名称
			<td width="25%" class="textRight">#springMessage('table.fcBond.corpName')</td>
			<td width="25%" class="textLeft">$!{fcBondApplyVO.corpName}</td>
        </tr>
		<tr>
			##银行名称
            <td class="textRight" width="25%">#springMessage('table.fcBondBack.bankName')</td>
            <td width="25%" class="textLeft">$!{fcBondApplyVO.bankName}</td>
			##项目类型
			<td width="25%" class="textRight">#springMessage('table.fcBond.itemType')</td>
			<td width="25%" class="textLeft">$dictTag.get("fcBond.itemType",$!{fcBondApplyVO.itemType})</td>
        </tr>
		<tr>
			##项目金额
            <td class="textRight" width="25%">#springMessage('table.fcBond.itemMoney')</td>
            <td width="25%" class="textLeft">$number.formatNumeric($!{fcBondApplyVO.itemMoney})</td>
			##项目期限
			<td width="25%" class="textRight">#springMessage('table.fcBond.itemUnit')</td>
			<td width="25%" class="textLeft">$!{fcBondApplyVO.itemUnit}<label >#springMessage('table.fcBond.month')</label></td>
        </tr>
		<tr>
			##项目开始日期
            <td class="textRight" width="25%">#springMessage('table.fcBond.itemStartDate')</td>
            <td width="25%" class="textLeft">$!date.format('yyyy-MM-dd',$!{fcBondApplyVO.startDate})</td>
			##项目到期日期
			<td width="25%" class="textRight">#springMessage('table.fcBond.itemEndDate')</td>
			<td width="25%" class="textLeft">$!date.format('yyyy-MM-dd',$!{fcBondApplyVO.endDate})</td>
        </tr>
	 </tbody>
	 <thead>
		##保证金信息
        <tr>
            <td class="textLeft" colspan="4">#springMessage('table.fcBond.BondMsg')</td>
		</tr>
        </thead>
		<tbody>
        <tr>
			##存入账户
			<td width="25%" class="textRight">#springMessage('table.fcBond.depositaccount')</td>
			<td width="25%" class="textLeft">$!{fcBondApplyVO.bankAcc}</td>
			##账户名称
            <td class="textRight" width="25%">#springMessage('table.fcBond.accountname')</td>
            <td width="25%" class="textLeft">$!{fcBondApplyVO.accName}</td>
        </tr>
		<tr>
			##存入银行
			<td width="25%" class="textRight">#springMessage('table.fcBond.bankName')</td>
			<td width="25%" class="textLeft">$!{fcBondApplyVO.bankName}</td>
			##存入日期
            <td class="textRight" width="25%">#springMessage('table.fcBond.depositdate')</td>
            <td width="25%" class="textLeft">$!date.format('yyyy-MM-dd',$!{fcBondApplyVO.bondDate})</td>
        </tr>
		<tr>
			##保证金账户余额
            <td class="textRight" width="25%">#springMessage('table.fcBond.accBal')</td>
            <td width="25%" class="textLeft">$number.formatNumeric($!{fcBondApplyVO.balMoney}) </td>  
			##保证金合同
			<td width="25%" class="textRight">#springMessage('table.fcBond.contractNum')</td>
			<td width="25%" class="textLeft">$!{fcBondApplyVO.bondContract}</td>
        </tr>
		<tr>
			##可用金额
            <td class="textRight" width="25%">#springMessage('table.fcBond.availableMoney')</td>
            <td width="25%" class="textLeft">$number.formatNumeric($!{fcBondApplyVO.availMoney})</td>
			##占用金额
			<td width="25%" class="textRight">#springMessage('table.fcBond.occupyMoney')</td>
			<td width="25%" class="textLeft">$number.formatNumeric($!{fcBondApplyVO.applyMoney})</td>
        </tr>
        <tr>
        ##币别
            <td class="textRight">#springMessage('table.fcBond.curCode')</td>
            <td> $!{fcBondApplyVO.curName}</td>
            <td></td>
            <td></td>
        </tr>
	 </tbody>
	 <tr>
			##备注
            <td class="textRight" width="25%">#springMessage('table.fcBond.rmk')</td>
            <td width="25%" class="textLeft">$!{fcBondApplyVO.remark}</td>
			<td width="25%" class="textRight"></td>
			<td width="25%" class="textLeft"></td>
        </tr>
		<tr>
            <td colspan="6" style="text-align: center;">
                <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
            </td>
           </tr>
	</table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
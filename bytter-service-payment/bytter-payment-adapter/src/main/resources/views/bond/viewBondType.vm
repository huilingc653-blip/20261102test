<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tr>
			##保证金类型代码
				<td class="textRight" width="15%">#springMessage('fcbond.typecode')</td>
				<td width="35%">
					$!{fcBondTypePage.bondTypeCode}
				</td>

			##保证金类型名称
				<td class="textRight" width="15%">#springMessage('fcbond.typename')</td>
				<td width="35%">
					$!{fcBondTypePage.bondTypeName}
				</td>
			</tr>

			<tr>
			##有效标志
				<td class="textRight">#springMessage('table.bvStorageBox.validSign')</td>
				<td>$!{fcBondTypePage.validSignName}</td>

			##备注
				<td class="textRight">#springMessage('table.ratItemCustom.remark')</td>
				<td>
					$!{fcBondTypePage.rmk}
				</td>
			</tr>

		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>


<!DOCTYPE html>
<html lang="en">
  <head>
    #parse("views/common/head.vm")
  </head>
 <body >
 <form class="layui-form" method="post">
	<input type="hidden" id="taskId" name="taskId" value="$!{taskId}" />
	<input type="hidden" id="corpId" name="corpId" value="$!{fcBondPreserveVO.corpId}"/>
	<table class="layui-table">
		<tbody >
			<tr>
				<td colspan="4" style="text-align: center;">
					<label><b>#springMessage('table.fcBond.inputdate')</b></label>
					<div class="layui-input-inline"> 
						<input id="inputDate" name="createDate" value="$!date.format('yyyy-MM-dd',$!{fcBondPreserveVO.inputDate})" readonly="readonly" autocomplete="off" class="layui-input">
					</div>
				</td>
			</tr>
	</table>
	<table class="layui-table">
            <thead>
			  <tr>
                <th colspan="4" style="text-align:left">#springMessage('table.fcBond.itemMsg')</th>
			  </tr>
			</thead>
			<tr>
				##项目单号
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.billNo')</td>
                <td>$!{fcBondPreserveVO.billNo}</td>
				##单位名称
				<td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.corpName')</td>
			    <td >$!{fcBondPreserveVO.corpName}</td>
            </tr>
            <tr>
				##银行名称
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBondBack.bankName')</td>
                <td>$!{fcBondPreserveVO.bankName}</td>
				##币别
                 <td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.curCode')</td>
                 <td >$!{fcBondPreserveVO.curName}</td>
			</tr>
			 <tr>
				##项目金额
				<td class="textRight">#springMessage('table.fcBond.itemMoney')</td>
                <td>$number.formatNumeric($!{fcBondPreserveVO.itemMoney})</td>
				##项目期限
				<td class="textRight">#springMessage('table.fcBond.itemUnit')</td>
			    <td>$!{fcBondPreserveVO.itemUnit}<label >#springMessage('table.fcBond.month')</label></td>
			</tr>
			<tr>
        		##项目开始日期
				<td class="textRight">#springMessage('table.fcBond.itemStartDate')</td>
				<td >$!date.format('yyyy-MM-dd',$!{fcBondPreserveVO.startDate})</td>
				##项目结束日期
				<td class="textRight">#springMessage('table.fcBond.itemEndDate')</td>
				<td >$!date.format('yyyy-MM-dd',$!{fcBondPreserveVO.endDate})</td>
			</tr>
        </tbody>
    </table>
	<table class="layui-table">
            <thead>
			  <tr>
                <th colspan="4" style="text-align:left">#springMessage('table.fcBond.BondMsg')</th>
			  </tr>
			</thead>
			<tr>
				##存入账户
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.depositaccount')</td>
				<td>$!{fcBondPreserveVO.bankAcc}</td>
				##账号名称
				<td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.accountname')</td>
			    <td >$!{fcBondPreserveVO.accName}</td>
            </tr>
            <tr>
				##存入银行
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.bankName')</td>
                <td>$!{fcBondPreserveVO.bankName}</td>
				##存入时间
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.depositdate')</td>
                <td >$!date.format('yyyy-MM-dd',$!{fcBondPreserveVO.bondDate})</td>
			</tr>
			 <tr>
				##保证金账户余额
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.accBalance')</td>
                <td>$number.formatNumeric($!{fcBondPreserveVO.accBalance})</td>
				##项目合同
			    <td class="textRight">#springMessage('table.fcBond.contractNum')</td>
                <td>$!{fcBondPreserveVO.bondContract}</td>
			</tr>
			<tr>
        		##账户当前可用金额
				<td class="textRight">#springMessage('table.fcBond.availableMoney')</td>
			    <td>$number.formatNumeric($!{fcBondPreserveVO.availMoney})</td>
				##占用金额
			    <td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.occupyMoney')</td>
			    <td>$number.formatNumeric($!{fcBondPreserveVO.applyMoney})</td>
			</tr>
			##备注
			<tr>
				<td class="textRight">#springMessage('table.fcBond.rmk')</td>
				<td colspan="3">
                	<textarea type="text" id="remark" readon="true" name="remark" class="layui-textarea" placeholder="#springMessage('table.cmsProvideLoanInfo.rmk')">$!{fcBondPreserveVO.remark}</textarea>
				</td>
			</tr>
        </tbody>
    </table>
 </form>
	#parse("views/common/footer.vm")
	#paymentWorkFlowHtml()
	#paymentWorkFlowScript()
 </body>
 
 <script type="text/javascript">
var billNo;
bt.use(['form','moneyType','dicts','jquery'], function(){
	$ = bt.jquery,form = bt.form();
	bt.moneyType.init();
	bt.workFlow.beforeSubmit = function(submitData){
				var taskIds = [];
				taskIds.push($("#taskId").val());
				bt.workFlow.taskList = taskIds;
				return true;
			}
	bt.workFlow.afterSubmit = function(){
				parent.layer?parent.layer.closeAll():layer.closeAll();
			}
});
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<input type="hidden" id="taskId" name= "taskId" value="$!{taskId}">
	</form>
	<input type="hidden" id="corpId" name="corpId" value="$!{fcBond.corpId}"/>
	<input type="hidden" id="id" name="id" value="$!{fcBond.id}">
	<input id="isRegular" type="hidden" value="$!{fcBond.isRegular}">
	<input id="isOnline" type="hidden" value="$!{fcBond.isOnline}">
	<div>
		<table class="layui-table  breakRow"  >
			<tbody>
			<thead>
			<tr>
				<th colspan="4" style="text-align:center">#springMessage('table.fcBondDetail.viewTitle')</th>
			</tr>
			</thead>
			<tr>
			##申请单号
				<td class="textRight" width="20%">#springMessage('table.fcBond.appNo')</td>
				<td width="30%">$!{fcBond.billNo}</td>
			##录入日期
				<td class="textRight" width="20%">#springMessage('table.fcBond.inputdate')</td>
				<td width="30%">$!date.format('yyyy-MM-dd',$!{fcBond.createDate})</td>
			</tr>
			<tr>
			##单位名称
				<td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.corpName')</td>
				<td >$!{fcBond.corpName}</td>
			##存入银行
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.bankName')</td>
				<td >$!{fcBond.bankName}</td>
			</tr>
			<tr>
			##存入账号
				<td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.depositaccount')</td>
				<td >$!{fcBond.bankAcc}</td>
			##账户名称
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.accountname')</td>
				<td >$!{fcBond.accName}</td>
			</tr>
			<tr>
			##币别
				<td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.curCode')</td>
				<td >$!{fcBond.curName}</td>
			##存入日期
				<td class="textRight"><font color="red">*</font>#springMessage('table.fcBond.depositdate')</td>
				<td >$!date.format('yyyy-MM-dd',$!{fcBond.startDate})</td>
			</tr>

			<tr>
			##存出账号
				<td class="textRight">#springMessage('table.eAccrualBill.saveAcc')</td>
				<td>$!{fcBond.outBankAcc}</td>

			##账户余额
				<td class="textRight">#springMessage('table.nisBillhead.balance')</td>
				<td>$!number.formatNumeric($!{fcBond.outBankAccMoney})</td>
			</tr>

			<tr>
			##保证金类型
				<td class="textRight">#springMessage('fcbond.type')</td>
				<td>$!{fcBond.bondTypeName}</td>
				<td></td>
				<td></td>
			</tr>

			<tr>
			##保证金金额
				<td class="textRight" ><font color="red">*</font>#springMessage('table.fcBond.bondmoney')</td>
				<td >
					$number.formatNumeric($!{fcBond.bondMoney})
					<input type="hidden" value="$!{fcBond.bondMoney}" class="bt-biz-moneyType"  data-toUp="payMoneyUp">
				</td>
			##保证金金额(大写)
				<td class="textRight">#springMessage('table.fcBond.bondmoney.big')</td>
				<td>
					<div id="payMoneyUp"></div>
				</td>
			</tr>

			<tr>
			###是否存入定期
				<td class="textRight"><span style="color: red">*</span>#springMessage('fcbond.is.to.regular')</td>
				<td>
					$dictTag.get("sf_yn",$!{fcBond.isRegular})
				</td>
			##利率
				<td class="textRight">#springMessage('table.choBankFinance.interestRate')</td>
				<td>
					$rateTag.show($!{fcBond.interestRate})
				</td>
			</tr>

			<tr class="toRegular" style="display: none">
			##到期日期
				<div>
					<td class="textRight">#springMessage('table.choBankFinance.deadlineDate')</td>
					<td>
						$!date.format('yyyy-MM-dd',$!{fcBond.endDate})
					</td>
				</div>
			##期限：3个月、6个月、1年、2年、3年、5年
				<td class="textRight">#springMessage('table.choBankFinance.dayLimit')</td>
				<td>
					$!{fcBond.dayLimit} 天
				</td>
			</tr>

			<tr>
			##是否已付款
				<td class="textRight">
					<div class="isPay" style="display: none">
						#springMessage('table.fcBond.ispayed')
					</div>
				</td>
				<td>
					<div class="isPay" style="display: none">
						$dictTag.get("sf_yn",$!{fcBond.isPayed})
					</div>
				</td>

			##用途
				<td class="textRight">#springMessage('table.choBankFinance.purpose')</td>
				<td>
					$!{fcBond.purpose}
				</td>
			</tr>

			<tr>
			##备注
				<td class="textRight" >#springMessage('table.fcBond.rmk')</td>
				<td  colspan="3">$!{fcBond.remark}</td>
			</tr>

			<tr>
			##附件
				<td class="textRight">#springMessage('netbank.common.attachment')</td>
				<td colspan="3">
					<!-- 附件上传 -->
					<input id="annexNameInfo" name="annexNameInfo" type="hidden" value="$!{fcBond.attachmentId}">
					<div id="uploaderInfo" class="layui-input-inline" style="width:100%"></div>
				</td>
			</tr>
			</tbody>
		</table>
  <!-- 日志 -->
  <div id="tagMsg"></div>
 </div>
    #parse("views/common/footer.vm")
	#paymentWorkFlowHtml()
	#paymentWorkFlowScript()
	<script>
		bt.use(['form','datatable','corp','moneyType','btUpload','dicts','jquery'], function(){
			$ = bt.jquery,form = bt.form();
			bt.workFlow.beforeSubmit = function(submitData){
					var taskIds = [];
					taskIds.push($("#taskId").val());
					bt.workFlow.taskList = taskIds;
					return true;
				}
				bt.workFlow.afterSubmit = function(){
					parent.layer?parent.layer.closeAll():layer.closeAll();
				}
			bt.moneyType.init();
			var gInfoId = $("#annexNameInfo").val();
			var gSendId = $("#annexNameSend").val();
			bt.btUpload.init({
				elem: "#uploaderInfo",
				hasUpload: false,
				hasDelete: false,
				isExpand: true,
				gid: gInfoId
			});
    
			bt.btUpload.init({
				elem: "#uploaderSend",
				hasUpload: false,
				hasDelete: false,
				isExpand: true,
				gid: gSendId
			});
	
			 /**
			 * 生成日志列表
			 * @return
			 */
			$genMsgHtml = function () {
				var url = basePath + "/bond/fcbondlog/listopmessage/" + $('#id').val();
				$.ajax({
					url: url,
					method: 'GET',
					async: false,
					success: function (json) {
						$("#tagMsg").html("");
						$("#tagMsg").html(json);
						form.render();
					}
				});
			}
			$genMsgHtml();

			toRegular();
			isPayCall();
		});

		/**是否存入定期*/
		function toRegular() {
			var isRegular = $("#isRegular").val();
			if(isRegular == "1"){
				$(".toRegular").show();
			}else {
				$(".toRegular").hide();
			}
		}

		function isPayCall() {
			var isOnline = $("#isOnline").val();
			if(isOnline == "1"){
				$(".isPay").show();
			}else {
				$(".isPay").hide();
			}
		}
	</script>
</body>
</html>
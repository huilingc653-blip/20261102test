<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##                名称
    <li class="mui-table-view-cell">
        #springMessage('table.tbCreditPeriod.designation')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCotpVO.cotpName}
        </span>
    </li>

##                所属组
    <li class="mui-table-view-cell">
        #springMessage('fex.cotp.subordinateGroup')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCotpVO.parentName}
        </span>
    </li>

##                备注
    <li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetPeriod.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCotpVO.rmk}
        </span>
    </li>

    <ul class="mui-table-view">
        <li class="mui-table-view-cell mui-collapse">
##            组成员
            <a class="mui-navigate-right" href="#">#springMessage('fex.cotp.groupMembers')</a>
            <div class="mui-collapse-content">
                <table id="appTable" class="layui-table layui-form" style="border: 1px solid">
                    <thead>
                    <tr style="border: 1px solid">
                    ##                                    名称
                        <th style="border: 1px solid">#springMessage('table.tbCreditPeriod.designation')</th>
                    ##                                  层级
                        <th style="border: 1px solid">#springMessage('fex.cotp.hierarchy')</th>
                    ##                                  短名称
                        <th style="border: 1px solid">#springMessage('fex.cotp.shortName')</th>
                    ##                                  正式名称
                        <th style="border: 1px solid">#springMessage('fex.cotp.officialName')</th>
                    </tr>
                    </thead>
                    #foreach($element in $!{ChildrenData})
                        <tr style="border: 1px solid">
                            <td style="border: 1px solid">$!{element.cotpName}</td>
                            <td style="border: 1px solid">$dictTag.get("fex.cotp.level",$!{element.cotpLevel})</td>
                            <td style="border: 1px solid">$!{element.shortName}</td>
                            <td style="border: 1px solid">$!{element.officialName}</td>
                        </tr>
                    #end
                </table>
            </div>
        </li>
    </ul>


    <ul class="mui-table-view">
        <li class="mui-table-view-cell mui-collapse">
        ##            自定义信息
            <a class="mui-navigate-right" href="#">#springMessage("fex.cotp.customInformation")</a>
            <div class="mui-collapse-content">
                <ul class="mui-table-view">
                    #foreach($element in $custFieldS)
                        #if($velocityCount % 2 == 0)
                            <li class="mui-table-view-cell">
                                $!{element.fieldName}
                                <span class="mui-badge mui-badge-inverted">
                                    $!{element.fieldVal}
                                </span>
                            </li>
                        #else
                            <li class="mui-table-view-cell">
                                $!{element.fieldName}
                                <span class="mui-badge mui-badge-inverted">
                                    $!{element.fieldVal}
                                </span>
                            </li>
                        #end
                    #end
                </ul>
            </div>
        </li>
    </ul>
</ul>
</body>
    #parse("views/common/wapfooter.vm")
</html>

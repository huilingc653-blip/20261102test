<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="myform">
    <input type="hidden" name="cotpLevel" value="1">
    <input id="busType" name="busType" type="hidden" value="$!{busType}">
    <input id="id" name="id" type="hidden" value="$!{fexCotpVO.id}">
    <input type="hidden" id="cotpType" value="$!{fexCotpVO.cotpType}">
    <table id="appTable" class="layui-table layui-form">
        <tr>
        ##交易对手名称
            <td class="textRight" style="width: 40%">#springMessage('fex.cotp.name')</td>
            <td style="width: 60%">
                <div class="layui-input-inline">
                    $!{fexCotpVO.cotpName}
                </div>
            </td>
        </tr>
#*        <tr>
##            单位
            <td class="textRight">#springMessage('table.abBillTransfer.applyCorp')</td>
            <td>
                <div class="layui-inline">
                    $!{fexCotpVO.corpName}
                </div>
            </td>
        </tr>*#
        <tr>
        ##短名称
            <td class="textRight">#springMessage('fex.cotp.shortName')</td>
            <td>
                <div class="layui-input-inline">
                    $!{fexCotpVO.shortName}
                </div>
            </td>
        </tr>
        <tr>
        ##正式名称
            <td class="textRight">#springMessage('fex.cotp.officialName')</td>
            <td>
                <div class="layui-input-inline">
                    $!{fexCotpVO.officialName}
                </div>
            </td>
        </tr>
        <tr>
        ##所属组
            <td class="textRight">#springMessage('fex.cotp.subordinateGroup')</td>
            <td>
                <div class="layui-input-inline">
                    $!{fexCotpVO.parentName}
                </div>
            </td>
        </tr>
        <tr>
            ##交易对手名称(英文)
            <td class="textRight" style="width: 40%">#springMessage('fex.cotp.nameEn')</td>
            <td style="width: 60%">
                <div class="layui-input-inline">
                    $!{fexCotpVO.cotpNameEn}
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
                    <ul class="layui-tab-title">
##                        交易对手类别
                        <li class="layui-this">#springMessage('fex.cotp.counterpartyCategory')</li>
##                      地址信息
                        <li>#springMessage('fex.cotp.addressInformation')</li>
##                      交易相关信息
                        <li>#springMessage('fex.cotp.ransactionRelatedInformation')</li>
##                      识别码信息
                        <li>#springMessage('fex.cotp.IDInformation')</li>
##                      自定义信息
                        <li>#springMessage('fex.cotp.customInformation')</li>
                        ##快捷支付信息
                        <li>#springMessage('fex.cotp.quickPayment')</li>
                    </ul>
                    <div class="layui-tab-content">
                        <div class="layui-tab-item layui-show">
                            <table class="layui-table layui-form">
                                <tr>
                                    <td>
##                                        内部银行
                                        <input type="checkbox" name="cotpTypes" value="01" title="#springMessage('fex.cotp.internalBank')" disabled="disabled" lay-skin="primary">
                                    </td>
                                    <td>
##                                        外部交易方
                                        <input type="checkbox" name="cotpTypes" value="02" title="#springMessage('fex.cotp.externalCounterparties')" disabled="disabled" lay-skin="primary">
                                    </td>
                                    <td>
##                                        托管人
                                        <input type="checkbox" name="cotpTypes" value="03" title="#springMessage('fex.cotp.custodian')" disabled="disabled" lay-skin="primary">
                                    </td>
                                    <td>
##                                        结算银行
                                        <input type="checkbox" name="cotpTypes" value="04" title="#springMessage('fex.cotp.settlementBank')" disabled="disabled" lay-skin="primary">
                                    </td>
                                </tr>
                                <tr>
                                    <td>
##                                        外部银行
                                        <input type="checkbox" name="cotpTypes" value="05" title="#springMessage('fex.cotp.externalBank')" disabled="disabled" lay-skin="primary">
                                    </td>
                                    <td>
##                                        交易所
                                        <input type="checkbox" name="cotpTypes" value="06" title="#springMessage('fex.cotp.exchange')" disabled="disabled" lay-skin="primary">
                                    </td>
                                    <td>
##                                        经纪人
                                        <input type="checkbox" name="cotpTypes" value="07" title="#springMessage('fex.cotp.agent')" disabled="disabled" lay-skin="primary">
                                    </td>
                                    <td>
##                                        基金管理人
                                        <input type="checkbox" name="cotpTypes" value="08" title="#springMessage('fex.cotp.fundManager')" disabled="disabled" lay-skin="primary">
                                    </td>
                                </tr>
                                <tr>
                                    <td>
##                                        发行或支行代理人
                                        <input type="checkbox" name="cotpTypes" value="09" title="#springMessage('fex.cotp.issuingOrPayingAgent')" disabled="disabled" lay-skin="primary">
                                    </td>
                                    <td>
##                                        借记防/贷记方
                                        <input type="checkbox" name="cotpTypes" value="10" title="#springMessage('fex.cotp.debitCreditParty')" disabled="disabled" lay-skin="primary">
                                    </td>
                                    <td>
##                                        清算经济人
                                        <input type="checkbox" name="cotpTypes" value="11" title="#springMessage('fex.cotp.clearingAgent')" disabled="disabled" lay-skin="primary">
                                    </td>
                                    <td>
##                                        清算所
                                        <input type="checkbox" name="cotpTypes" value="12" title="#springMessage('fex.cotp.clearingHouse')" disabled="disabled" lay-skin="primary">
                                    </td>
                                </tr>
                                <tr>
                                    <td>
##                                        内部交易方
                                        <input type="checkbox" name="cotpTypes" value="13" title="#springMessage('fex.cotp.insider')" disabled="disabled" lay-skin="primary">
                                    </td>
                                    <td>
##                                        发行人/承兑人
                                        <input type="checkbox" name="cotpTypes" value="14" title="#springMessage('fex.cotp.issuerAcceptor')" disabled="disabled" lay-skin="primary">
                                    </td>
                                    <td>
##                                        税务机关
                                        <input type="checkbox" name="cotpTypes" value="15" title="#springMessage('fex.cotp.taxAuthority')" disabled="disabled" lay-skin="primary">
                                    </td>
                                    <td>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="layui-tab-item">
                            <table class="layui-table layui-form">
                                <tr>
##                                    邮政地址(邮编)
                                    <td class="text-right">#springMessage("table.sysCorp.postCode")</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            $!{fexCotpVO.postAddr}
                                        </div>
                                    </td>
                                </tr>
                                <tr>
##                                    街道地址（地址1）
                                    <td class="text-right">#springMessage('table.sysCorp.address1')</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            $!{fexCotpVO.streetAddr}
                                        </div>
                                    </td>
                                </tr>
##                                   楼栋编号(地址2)
                                <td class="text-right">#springMessage("table.sysCorp.address2")</td>
                                <td>
                                    <div class="layui-input-inline">
                                        $!{fexCotpVO.buildingNumber}
                                    </div>
                                </td>
                                </tr>
                                <tr>
##                                    电话/电报/传真号码
                                    <td class="textRight">#springMessage('fex.cotp.tel')</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            $!{fexCotpVO.tel}
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    ##地址（英文）
                                    <td class="textRight">#springMessage('fex.cotp.addressEn')</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            $!{fexCotpVO.addressEn}
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="layui-tab-item">
                            <table class="layui-table layui-form">
                                <tr>
##                                    国家/地区
                                    <td class="textRight" style="width: 20%">#springMessage('fex.cotp.countryRegion')</td>
                                    <td style="width: 30%">
                                        <div class="layui-input-inline">
                                            $!{fexCotpVO.countryName}
                                        </div>
                                    </td>
##                                  地点
                                    <td class="textRight" style="width: 20%">#springMessage('fex.cotp.place')</td>
                                    <td style="width: 30%">
                                        <div class="layui-input-inline">
                                            #if($!{fexCotpVO.countryName} == "中国")
                                                $!{fexCotpVO.provName}$!{fexCotpVO.cityName}
                                            #else
                                                $!{fexCotpVO.addressName}
                                            #end
                                        </div>
                                    </td>
                                </tr>
                                <tr id="stateTr" #if($!{fexCotpVO.countryName} == "中国")style="display: none"#end>
                                    ##省/州
                                    <td class="text-right">#springMessage("table.sysCorp.state")</td>
                                    <td colspan="3">$!{fexCotpVO.state}</td>
                                </tr>
                            </table>
                        </div>
                        <div class="layui-tab-item">
                            <table class="layui-table layui-form">
                                <tr>
                                <td class="textRight" style="width: 20%">#springMessage('table.fexForeign.bicCode')</td>
                                <td style="width: 30%">
                                    <div class="layui-input-inline">
                                        $!{fexCotpVO.BicCode}
                                    </div>
                                </td>
                                <td class="textRight" style="width: 20%">#springMessage('table.fcBankBillTemp.lineNo')</td>
                                <td style="width: 30%">
                                    <div class="layui-input-inline">
                                        $!{fexCotpVO.bankCode}
                                    </div>
                                </td>
                                </tr>
                                <tr>
                                    <td class="textRight">#springMessage('table.btswiftinfo.localClearNo')</td>
                                    <td>$!{fexCotpVO.localClearNo}</td>
                                    <td class="textRight">#springMessage('table.btswiftinfo.clsFlag')</td>
                                    <td>
                                        $dictTag.get("clsFlag",$!{fexCotpVO.clsFlag})
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="layui-tab-item">
                            <table class="layui-table layui-form">
                                #foreach($element in $custFieldS)
                                    #if($velocityCount % 2 == 0)
                                        <td class="textRight" style="width: 20%">
                                            $!{element.fieldName}
                                        </td>
                                        <td style="width: 30%">
                                            <div class="layui-input-inline">
                                                $!{element.fieldVal}
                                            </div>
                                        </td>
                                        </tr>
                                    #else
                                    <tr>
                                        <td class="textRight" style="width: 20%">
                                            $!{element.fieldName}
                                        </td>
                                        <td style="width: 30%">
                                            <div class="layui-input-inline">
                                                $!{element.fieldVal}
                                            </div>
                                        </td>
                                        #if($foreach.last)
                                            <td style="width: 20%"></td>
                                            <td style="width: 30%"></td>
                                        </tr>
                                        #end
                                    #end
                                #end
                            </table>
                        </div>
                        <div class="layui-tab-item">
                            <table class="layui-table">
                                <tr>
                                    ##支付产品
                                    <td class="textRight">#springMessage('fex.cotp.product')</td>
                                    <td>
                                        $!{proName}
                                    </td>
                                </tr>
                                <tr id="fpsIdTr" #if($!{fexCotpVO.productId} != "53f8408e666b42b9abbe2dcf8372bc76") style="display: none;" #end>
                                    ##FPS ID(SVID)
                                    <td class="textRight">FPS ID(SVID)</td>
                                    <td>
                                        $!{fexCotpVO.fpsId}
                                    </td>
                                </tr>
                                <tr>
                                    ##邮箱
                                    <td class="textRight">#springMessage('fex.cotp.email')</td>
                                    <td>
                                        $!{fexCotpVO.eMail}
                                    </td>
                                </tr>
                                <tr>
                                    ##电话号码
                                    <td class="textRight">#springMessage('fex.cotp.phoneCode')(MOBN)</td>
                                    <td>
                                        $!{fexCotpVO.isdCode}&nbsp;$!{fexCotpVO.phoneCode}
                                    </td>
                                </tr>
                                <tr id="aiInTr" #if($!{fexCotpVO.productId} != "53f8408e666b42b9abbe2dcf8372bc76") style="display: none;" #end>
                                    ##信用卡号
                                    <td class="textRight">#springMessage('fex.cotp.aiIn')(AIIN)</td>
                                    <td>
                                        $!{fexCotpVO.aiIn}
                                    </td>
                                </tr>
                                <tr id="hkIdTr" #if($!{fexCotpVO.productId} != "53f8408e666b42b9abbe2dcf8372bc76") style="display: none;" #end>
                                    ##香港身份证号
                                    <td class="textRight">#springMessage('fex.cotp.hkId')(HKID)</td>
                                    <td>
                                        $!{fexCotpVO.hkId}
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
    #if($!{showClosBtn} == 1)
        <tr>
            <td colspan="2"style="text-align: center">
                #if($!{fexCotpVO.status} == "-1")
                    <button class="layui-btn" type="button" onClick="bt.trackFlowByBusinessId('$!{fexCotpVO.id}')">#springMessage('common.button.trackFlow')</button>
                #end
                <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
            </td>
        </tr>
    #end
    </table>
    <!-- 日志 -->
    <div id="tagMsg"></div>
</form>
</body>
    #parse("views/common/footer.vm")
<script>
    var form, element;
    bt.use(["jquery", "element", "form", "bttable"], function () {
        var $ = bt.jquery;
        form = bt.form();
        element = layui.element;
        /**
         * 生成日志列表
         * @return
         */
            $genMsgHtml = function () {
            var url = basePath + "/foreign/fexmessage/list/" + $('#id').val() + "/" + $("#busType").val() + "?timestamp=" + new Date().getTime();
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                    form.render();
                }
            });
        }
            $genMsgHtml();
        onloadHandel();
    });


    /**
     * 页面加载完成后数据处理
     */
    function onloadHandel() {
        var cotpType = $("#cotpType").val();
        $.each(cotpType.split(","),function (index,item) {
            $.each($("input[name = 'cotpTypes']"),function (index1,item1) {
                if (item == item1.value) {
                    $(this).attr("checked", "checked");
                }
            });
        })
        form.render();
    }

    //关闭窗口
    function doClose() {
        if (bt.navtab) {
            bt.navtab.closeCurrent();
        }
    }
</script>
</html>

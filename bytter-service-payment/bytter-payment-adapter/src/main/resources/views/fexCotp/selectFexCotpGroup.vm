<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
##            组名
            <td width="10%" class="textRight">#springMessage('table.tbCreditPeriod.designation')</td>
            <td width="40%">
                <div class="layui-inline">
                    <input type="text" name="likes_cotpName" class="layui-input" >
                </div>
            </td>
            <td>
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
##        组名
        <th>#springMessage('table.tbCreditPeriod.designation')</th>
##        所属组
        <th>#springMessage('fex.cotp.subordinateGroup')</th>
    </tr>
    </thead>
</table>
</body>
    #parse("views/common/footer.vm")
<script>
    bt.use(["jquery", "datatable"], function () {
        $ = bt.jquery;
        form = bt.form();

        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: "Brtlip",
            colReorder: true,
            ordering: false,
            checkbox: true,
            mulselect: false,
            buttonsLayout: false,
            ajax: {
                "url": basePath + "/foreign/fexCotp/getCotpGroupDataTable"
            },
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            columns: [
                {
                    data: "cotpName",
                    className: "center"
                },
                {
                    data: "parentName",
                    className: "center"
                }
            ]
        });

        //这里填写新的js代码，请参考前端文档
    });

    function getSelectDate() {
        var data = bt.datatable.getSelectData("#appTable");
        return data[0];
    }

</script>
</html>
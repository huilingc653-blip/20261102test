<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<ul class="mui-table-view" id="mulTable">
##                交易对手名称
    <li class="mui-table-view-cell">
        #springMessage('fex.cotp.name')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCotpVO.cotpName}
        </span>
    </li>

##                短名称
    <li class="mui-table-view-cell">
        #springMessage('fex.cotp.shortName')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCotpVO.shortName}
        </span>
    </li>

##                正式名称
    <li class="mui-table-view-cell">
        #springMessage('fex.cotp.officialName')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCotpVO.officialName}
        </span>
    </li>

##                所属组
    <li class="mui-table-view-cell">
        #springMessage('fex.cotp.subordinateGroup')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCotpVO.parentName}
        </span>
    </li>


##                交易对手名称(英文)
    <li class="mui-table-view-cell">
        #springMessage('fex.cotp.nameEn')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCotpVO.cotpNameEn}
        </span>
    </li>
##                所属组
#*    <li class="mui-table-view-divider">
        交易对手类别
    </li>*#

    <li class="mui-table-view-cell mui-collapse">
    ##        交易对手类别
        <a class="mui-navigate-right" href="#">#springMessage('fex.cotp.counterpartyCategory')</a>
        <div class="mui-collapse-content">
            <p>
            <div class="mui-input-row mui-checkbox">
            ##                            内部银行
                <label>#springMessage('fex.cotp.internalBank')</label>
                <input name="cotpTypes" value="01" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("01")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            外部交易方
                <label>#springMessage('fex.cotp.externalCounterparties')</label>
                <input name="cotpTypes" value="02" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("02")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            托管人
                <label>#springMessage('fex.cotp.custodian')</label>
                <input name="cotpTypes" value="03" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("03")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            结算银行
                <label>#springMessage('fex.cotp.settlementBank')</label>
                <input name="cotpTypes" value="04" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("04")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            外部银行
                <label>#springMessage('fex.cotp.externalBank')</label>
                <input name="cotpTypes" value="05" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("05")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            交易所
                <label>#springMessage('fex.cotp.exchange')</label>
                <input name="cotpTypes" value="06" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("06")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            经纪人
                <label>#springMessage('fex.cotp.agent')</label>
                <input name="cotpTypes" value="07" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("07")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            基金管理人
                <label>#springMessage('fex.cotp.fundManager')</label>
                <input name="cotpTypes" value="08" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("08")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            发行或支付代理人
                <label>#springMessage('fex.cotp.issuingOrPayingAgent')</label>
                <input name="cotpTypes" value="09" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("09")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            借记方/贷记方
                <label>#springMessage('fex.cotp.debitCreditParty')</label>
                <input name="cotpTypes" value="10" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("10")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            清算经济人
                <label>#springMessage('fex.cotp.clearingAgent')</label>
                <input name="cotpTypes" value="11" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("11")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            清算所
                <label>#springMessage('fex.cotp.clearingHouse')</label>
                <input name="cotpTypes" value="12" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("12")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            内部交易方
                <label>#springMessage('fex.cotp.insider')</label>
                <input name="cotpTypes" value="13" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("13")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            发行人/承兑人
                <label>#springMessage('fex.cotp.issuerAcceptor')</label>
                <input name="cotpTypes" value="14" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("14")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>

            <div class="mui-input-row mui-checkbox">
            ##                            税务机关
                <label>#springMessage('fex.cotp.taxAuthority')</label>
                <input name="cotpTypes" value="15" type="checkbox"
                    #if($!{fexCotpVO.cotpType.indexOf("15")} >= 0)
                       checked
                    #end
                       disabled="disabled">
            </div>
            </p>
        </div>
    </li>

    <li class="mui-table-view-cell mui-collapse">
    ##            地址相关信息
        <a class="mui-navigate-right" href="#">#springMessage('fex.cotp.addressInformation')</a>
        <div class="mui-collapse-content">
            <ul class="mui-table-view">
            ##                                    邮政地址
                <li class="mui-table-view-cell">
                    #springMessage('fex.cotp.postalAddress')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexCotpVO.postAddr}
                    </span>
                </li>

            ##                                  街道地址
                <li class="mui-table-view-cell">
                    #springMessage('fex.cotp.streetAddress')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexCotpVO.streetAddr}
                    </span>
                </li>

            ##                                  电话/电报/传真号码
                <li class="mui-table-view-cell">
                    #springMessage('fex.cotp.tel')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexCotpVO.tel}
                    </span>
                </li>

            ##                                  地址（英文）
                <li class="mui-table-view-cell">
                    #springMessage('fex.cotp.addressEn')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexCotpVO.addressEn}
                    </span>
                </li>
            </ul>
        </div>
    </li>

    <li class="mui-table-view-cell mui-collapse">
    ##            交易相关信息
        <a class="mui-navigate-right" href="#">#springMessage('fex.cotp.ransactionRelatedInformation')</a>
        <div class="mui-collapse-content">
            <ul class="mui-table-view">
            ##                                    国家/地区
                <li class="mui-table-view-cell">
                    #springMessage('fex.cotp.countryRegion')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexCotpVO.countryName}
                    </span>
                </li>

            ##                                  地点
                <li class="mui-table-view-cell">
                    #springMessage('fex.cotp.place')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexCotpVO.addressName}
                    </span>
                </li>
            </ul>
        </div>
    </li>


    <li class="mui-table-view-cell mui-collapse">
    ##            识别码信息
        <a class="mui-navigate-right" href="#">#springMessage('fex.cotp.IDInformation')</a>
        <div class="mui-collapse-content">
            <ul class="mui-table-view">
            ##                                    BIC Code
                <li class="mui-table-view-cell">
                    #springMessage('BIC Code')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexCotpVO.BicCode}
                    </span>
                </li>

            ##                                  行号
                <li class="mui-table-view-cell">
                    #springMessage('table.fcBankBillTemp.lineNo')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexCotpVO.bankCode}
                    </span>
                </li>
            </ul>
        </div>
    </li>

    <li class="mui-table-view-cell mui-collapse">
    ##            自定义信息
        <a class="mui-navigate-right" href="#">#springMessage('fex.cotp.customInformation')</a>
        <div class="mui-collapse-content">
            <ul class="mui-table-view">
                #foreach($element in $custFieldS)
                    #if($velocityCount % 2 == 0)
                        <li class="mui-table-view-cell">
                            $!{element.fieldName}
                            <span class="mui-badge mui-badge-inverted">
                                $!{element.fieldVal}
                            </span>
                        </li>
                    #else
                        <li class="mui-table-view-cell">
                            $!{element.fieldName}
                            <span class="mui-badge mui-badge-inverted">
                                $!{element.fieldVal}
                            </span>
                        </li>
                    #end
                #end
            </ul>
        </div>
    </li>
<div style="height: 80px"></div>
</ul>
</body>
    #parse("views/common/wapfooter.vm")
</html>

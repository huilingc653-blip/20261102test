<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="myform">
    <input type="hidden" name="cotpLevel" value="1">
    <table id="appTable" class="layui-table layui-form">
        <tr>
        ##交易对手名称
            <td class="textRight" style="width: 40%">#springMessage('fex.cotp.name')</td>
            <td style="width: 60%">
                <div class="layui-input-inline">
                    <input type="text" id="cotpName" name="cotpName" lay-verify="required" onblur="checkName(this)" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
        ##短名称
            <td class="textRight">#springMessage('fex.cotp.shortName')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="shortName" name="shortName" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
        ##正式名称
            <td class="textRight">#springMessage('fex.cotp.officialName')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="officialName" name="officialName" lay-verify="required" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
        ##所属组
            <td class="textRight">#springMessage('fex.cotp.subordinateGroup')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="parentName" name="parentName" class="layui-input" readonly="readonly">
                    <div class="bt-div-search" >
                        <button class="bt-biz-bankInfo" type="button" onclick="selectCotpGroup()">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                    <input type="hidden" id="parentId" name="parentId">
                </div>
            </td>
        </tr>
        <tr>
            ##交易对手名称(英文)
            <td class="textRight" style="width: 40%">#springMessage('fex.cotp.nameEn')</td>
            <td style="width: 60%">
                <div class="layui-input-inline">
                    <input type="text" id="cotpNameEn" name="cotpNameEn" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
                    <ul class="layui-tab-title">
##                        交易对手类别
                        <li class="layui-this">#springMessage('fex.cotp.counterpartyCategory')</li>
##                        地址信息
                        <li>#springMessage('fex.cotp.addressInformation')</li>
##                        交易相关信息
                        <li>#springMessage('fex.cotp.ransactionRelatedInformation')</li>
##                            识别码信息
                        <li>#springMessage('fex.cotp.IDInformation')</li>
##                            自定义信息
                        <li>#springMessage('fex.cotp.customInformation')</li>
                        ##快捷支付信息
                        <li>#springMessage('fex.cotp.quickPayment')</li>
                    </ul>
                    <div class="layui-tab-content">
                        <div class="layui-tab-item layui-show">
                            <table class="layui-table layui-form">
                                <tr>
                                    <td>
##                                        内部银行
                                        <input type="checkbox" name="cotpTypes" value="01" title="#springMessage('fex.cotp.internalBank')" lay-skin="primary">
                                    </td>
                                    <td>
##                                        外部交易方
                                        <input type="checkbox" name="cotpTypes" value="02" title="#springMessage('fex.cotp.externalCounterparties')" lay-skin="primary">
                                    </td>
                                    <td>
##                                        托管人
                                        <input type="checkbox" name="cotpTypes" value="03" title="#springMessage('fex.cotp.custodian')" lay-skin="primary">
                                    </td>
                                    <td>
##                                        结算银行
                                        <input type="checkbox" name="cotpTypes" value="04" title="#springMessage('fex.cotp.settlementBank')" lay-skin="primary">
                                    </td>
                                </tr>
                                <tr>
                                    <td>
##                                        外部银行
                                        <input type="checkbox" name="cotpTypes" value="05" title="#springMessage('fex.cotp.externalBank')" lay-skin="primary">
                                    </td>
                                    <td>
##                                        交易所
                                        <input type="checkbox" name="cotpTypes" value="06" title="#springMessage('fex.cotp.exchange')" lay-skin="primary">
                                    </td>
                                    <td>
##                                        经纪人
                                        <input type="checkbox" name="cotpTypes" value="07" title="#springMessage('fex.cotp.agent')" lay-skin="primary">
                                    </td>
                                    <td>
##                                        基金管理人
                                        <input type="checkbox" name="cotpTypes" value="08" title="#springMessage('fex.cotp.fundManager')" lay-skin="primary">
                                    </td>
                                </tr>
                                <tr>
                                    <td>
##                                        发行或支行代理人
                                        <input type="checkbox" name="cotpTypes" value="09" title="#springMessage('fex.cotp.issuingOrPayingAgent')" lay-skin="primary">
                                    </td>
                                    <td>
##                                        借记防/贷记方
                                        <input type="checkbox" name="cotpTypes" value="10" title="#springMessage('fex.cotp.debitCreditParty')" lay-skin="primary">
                                    </td>
                                    <td>
##                                        清算经济人
                                        <input type="checkbox" name="cotpTypes" value="11" title="#springMessage('fex.cotp.clearingAgent')" lay-skin="primary">
                                    </td>
                                    <td>
##                                        清算所
                                        <input type="checkbox" name="cotpTypes" value="12" title="#springMessage('fex.cotp.clearingHouse')" lay-skin="primary">
                                    </td>
                                </tr>
                                <tr>
                                    <td>
##                                        内部交易方
                                        <input type="checkbox" name="cotpTypes" value="13" title="#springMessage('fex.cotp.insider')" lay-skin="primary">
                                    </td>
                                    <td>
##                                        发行人/承兑人
                                        <input type="checkbox" name="cotpTypes" value="14" title="#springMessage('fex.cotp.issuerAcceptor')" lay-skin="primary">
                                    </td>
                                    <td>
##                                        税务机关
                                        <input type="checkbox" name="cotpTypes" value="15" title="#springMessage('fex.cotp.taxAuthority')" lay-skin="primary">
                                    </td>
                                    <td>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="layui-tab-item">
                            <table class="layui-table layui-form">
                                <tr>
##                                    邮政地址(邮编)
                                    <td class="text-right">#springMessage("table.sysCorp.postCode")</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            <input type="text" id="postAddr" name="postAddr" placeholder="#springMessage("table.sysCorp.postCode")" class="layui-input">
                                        </div>
                                    </td>
                                </tr>
                                <tr>
##                                  街道地址（地址1）
##                                    <td class="text-right">#springMessage('table.sysCorp.address1')</td>
                                    <td class="text-right">街道地址</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            <input type="text" id="streetAddr" name="streetAddr" placeholder="街道地址" class="layui-input">
                                        </div>
                                    </td>
                                </tr>
                                <tr>
##                                   楼栋编号(地址2)
##                                    <td class="text-right">#springMessage("table.sysCorp.address2")</td>
                                    <td class="text-right">楼栋编号</td>

                                    <td>
                                        <div class="layui-input-inline">
                                            <input type="text" id="buildingNumber" name="buildingNumber" placeholder="楼栋编号" class="layui-input">
                                        </div>
                                    </td>
                                </tr>
                                <tr>
##                                    电话/电报/传真号码
                                    <td class="textRight">#springMessage('fex.cotp.tel')</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            <input type="text" id="tel" name="tel" placeholder="#springMessage("fex.cotp.tel")" class="layui-input">
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    ##地址（英文）
                                    <td class="textRight">#springMessage('fex.cotp.addressEn')</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            <input type="text" id="addressEn" name="addressEn" placeholder="#springMessage("fex.cotp.addressEn")" class="layui-input">
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="layui-tab-item">
                            <table class="layui-table layui-form">
                                <tr>
                                    ##国家/地区
                                    <td class="textRight" style="width: 20%">#springMessage('fex.cotp.countryRegion')</td>
                                    <td style="width: 30%">
                                        <div class="layui-input-inline">
                                            <div class="bt-biz-selectType" data-required="true" data-callback="setArea" data-biz-name="countryId" data-url="${basePath}/basic/business/syscountrycust/listSysCountryCust" data-valuefield="id" data-textfield="nameZh" data-name="countryId"></div>
                                        </div>
                                    </td>
                                    ##地点
                                    <td class="textRight" style="width: 20%">#springMessage('fex.cotp.place')</td>
                                    <td style="width: 30%">
                                        <div class="layui-input-inline" id="addressDiv">
                                            <div class="bt-biz-selectType" data-required="true" data-biz-name="address" data-url="" data-valuefield="id" data-textfield="nameZh" data-name="address"></div>
                                        </div>
                                        <div class="layui-input-inline" id="addrDiv" style="display: none">
                                            <div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="prov" data-biz-name="prov" data-change="city" data-defaultvalue="" data-required="true" data-callback="bt.provCallback"></div>
                                            <div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="city" data-biz-name="city" data-defaultvalue="" data-required="true" data-callback="bt.cityCallback"></div>
                                        </div>
                                    </td>
                                </tr>
                                <tr id="stateTr" style="display: none">
                                    ##省/州
                                    <td class="text-right">#springMessage("table.sysCorp.state")</td>
                                    <td colspan="3">
                                        <input type="text" name="state" autocomplete="off" placeholder="#springMessage("table.sysCorp.state")" class="layui-input" value="$!{corp.state}">
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="layui-tab-item">
                            <table class="layui-table layui-form">
                                <tr>
                                <td class="textRight" style="width: 20%">#springMessage('table.fexForeign.bicCode')</td>
                                <td style="width: 30%">
                                    <div class="layui-input-inline">
                                        <input type="text" id="BicCode" name="BicCode" class="layui-input">
                                    </div>
                                </td>
                                <td class="textRight" style="width: 20%">#springMessage('table.fcBankBillTemp.lineNo')</td>
                                <td style="width: 30%">
                                    <div class="layui-input-inline">
                                        <input type="text" id="bankCode" name="bankCode" class="layui-input" readonly="readonly" placeholder="#springMessage('table.fcBankBillTemp.lineNo')">
                                        <div class="bt-div-search">
                                            <button class="bt-biz-bankInfo" id="selPayeeBankBut" type="button"  data-callback="bt.bankinfoCallback" title="#springMessage('common.button.select')">
                                                <i class="layui-icon">&#xe615;</i>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                                </tr>
                                <tr>
                                    <td class="textRight">#springMessage('table.btswiftinfo.localClearNo')</td>
                                    <td>
                                        <input type="text" id="localClearNo" name="localClearNo" lay-verify="strlength"
                                               data-maxlength="30"
                                               autocomplete="off" class="layui-input"
                                               placeholder="#springMessage('table.btswiftinfo.localClearNo')">
                                    </td>
                                    <td class="textRight">#springMessage('table.btswiftinfo.clsFlag')</td>
                                    <td>
                                        <div class="bt-biz-dict" data-type="select" data-group="clsFlag"
                                             data-name="clsFlag" data-biz-name="clsFlag"></div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="layui-tab-item">
                            <table class="layui-table" id="custFields">
                            </table>
                        </div>
                        <div class="layui-tab-item">
                            <table class="layui-table">
                                <tr>
                                    ##支付产品
                                    <td class="textRight">#springMessage('fex.cotp.product')</td>
                                    <td>
                                        <div class="layui-inline">
                                            <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexCotp/json" data-valuefield="id"
                                                 data-textfield="proName"  data-defaultvalue = "53f8408e666b42b9abbe2dcf8372bc76"
                                                 data-displayData="53f8408e666b42b9abbe2dcf8372bc76,4c182f17455f4614a79d66bdfd755c8d"
                                                 data-callback="productCallback"
                                                 data-name="productId" data-biz-name="productId" data-search="true"></div>
                                        </div>
                                    </td>
                                </tr>
                                <tr id="fpsIdTr">
                                    ##FPS ID(SVID)
                                    <td class="textRight">FPS ID(SVID)</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            <input type="text" id="fpsId" name="fpsId" class="layui-input" lay-verify="strlength" data-maxlength="1000">
                                        </div>
                                        <div class="layui-input-inline">
                                            <span style="color: red">
                                                #springMessage('fex.cotp.remark')
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    ##邮箱
                                    <td class="textRight">#springMessage('fex.cotp.email')</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            <input type="text" name="eMail" autocomplete="off" placeholder="EMAIL" class="layui-input"
                                                   lay-verify="emailFex|strlength" data-maxlength="1000">
                                        </div>
                                        <div class="layui-input-inline">
                                            <span style="color: red">
                                                #springMessage('fex.cotp.remark')
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    ##电话号码
                                    <td class="textRight">#springMessage('fex.cotp.phoneCode')(MOBN)</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            <input type="text" id="isdCode" name="isdCode" class="layui-input"
                                                   placeholder="#springMessage('fex.cotp.isdCode')（ISD code）" lay-verify="strlength" data-maxlength="1000">
                                        </div>
                                        <div class="layui-input-inline">
                                            <input type="text" id="phoneCode" name="phoneCode" class="layui-input"
                                                   placeholder="#springMessage('fex.cotp.phoneCode')" lay-verify="strlength" data-maxlength="1000">
                                        </div>
                                        <div class="layui-input-inline">
                                            <span style="color: red">
                                            #springMessage('fex.cotp.remark')
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                                <tr id="aiInTr">
                                    ##信用卡号
                                    <td class="textRight">#springMessage('fex.cotp.aiIn')(AIIN)</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            <input type="text" id="aiIn" name="aiIn" class="layui-input" lay-verify="strlength" data-maxlength="1000">
                                        </div>
                                        <div class="layui-input-inline">
                                            <span style="color: red">
                                                #springMessage('fex.cotp.remark')
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                                <tr id="hkIdTr">
                                    ##香港身份证号
                                    <td class="textRight">#springMessage('fex.cotp.hkId')(HKID)</td>
                                    <td>
                                        <div class="layui-input-inline">
                                            <input type="text" id="hkId" name="hkId" class="layui-input" lay-verify="strlength" data-maxlength="1000">
                                        </div>
                                        <div class="layui-input-inline">
                                            <span style="color: red">
                                                #springMessage('fex.cotp.remark')
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2"style="text-align: center">
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
                <button class="layui-btn" type="button" lay-submit="submit" value="0" lay-filter="submit">#springMessage('common.button.temp')</button>
                <button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
</body>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/fexCotp/fexCotp.add.js?_btv=${resourceVersion}"></script>
</html>

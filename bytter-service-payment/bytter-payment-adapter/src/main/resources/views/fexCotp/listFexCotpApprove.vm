<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}">
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
    <table class="layui-table">
        <tr>
##            名称
            <td width="10%" class="textRight">#springMessage('table.tbCreditPeriod.designation')</td>
            <td width="40%">
                <div class="layui-inline">
                    <input type="text" name="likes_cotpName" class="layui-input" >
                </div>
            </td>
##            层级
            <td width="10%" class="textRight">#springMessage('fex.cotp.hierarchy')</td>
            <td width="40%">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-name="eqs_cotpLevel" data-biz-name="eqs_cotpLevel" data-group="fex.cotp.level"></div>
                </div>
            </td>
##            所属组
            <td width="10%" class="textRight">#springMessage('fex.cotp.subordinateGroup')</td>
            <td width="40%">
                <div class="layui-inline">
                    <input type="text" name="likes_parentName" class="layui-input" >
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
    ##        名称
        <th>#springMessage('table.tbCreditPeriod.designation')</th>
    ##    所属组
        <th>#springMessage('fex.cotp.subordinateGroup')</th>
    ##    层级
        <th>#springMessage('fex.cotp.hierarchy')</th>
    ##短名称
        <th>#springMessage('fex.cotp.shortName')</th>
    ##正式名称
        <th>#springMessage('fex.cotp.officialName')</th>
    ##状态
        <th>#springMessage('table.fbsBudget.status')</th>
    ##    操作
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
    #paymentWorkFlowScript()
<script>
    var form, dicts;
    bt.use(["jquery", "datatable", "dicts"], function () {
        $ = bt.jquery;
        form = bt.form();
        dicts = bt.dicts.init();

        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: "Brtlip",
            colReorder: true,
            ordering: false,
            checkbox: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                "url": basePath + "/foreign/fexCotp/dataTableApprove"
            }, columns: [
                {
                    data: "cotpName",
                    className: "center"
                },
                {
                    data: "parentName",
                    className: "center"
                },
                {
                    data: "cotpLevel",
                    className: "center",
                    render: function (data, type, full, meta) {
                        return bt.dict("fex.cotp.level", data);
                    }
                },
                {
                    data: "shortName",
                    className: "center"
                },
                {
                    data: "officialName",
                    className: "center"
                },
                {
                    data: "status",
                    className: "center",
                    render: function (data, type, full, met) {
                        return bt.dict("fex.status", data);
                    }
                },
                {
                    data: null,
                    className: 'center',
                    render: function (data, type, full, meta) {
                        var html = "";
                        var split = "<span class=\"text-explode\">|</span>"
                        if ($("#flowStatus").val() == "todo") {
                            html += "<a class=\"\" href=\"#\" data-row=\"" + meta.row + "\" onclick=\"view('" + full.id + "','" + full.taskId + "')\">" + bt.lang("common.button.approve") + "</a>" + split;
                        }
                        html += "<a class=\"\" href=\"#\" data-row=\"" + meta.row + "\" onclick=\"bt.workFlow.trackFlow('" + full.processInstanceId + "')\">" + bt.lang("common.button.trackFlow") + "</a>";
                        return html;
                    }
                }
            ]
        });
        //这里填写新的js代码，请参考前端文档
    });

    /**
     * 查看
     * @param id
     * @param taskId
     */
    function view(id, taskId) {
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('fex.cotp'), basePath + "/foreign/fexCotp/viewApprove?id=" + id + "&taskId=" + taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/foreign/fexCotp/viewApprove?id=" + id + "&taskId=" + taskId,
            end: function () {
                datatable && datatable.draw();
            }
        });
    }
</script>
</body>
</html>
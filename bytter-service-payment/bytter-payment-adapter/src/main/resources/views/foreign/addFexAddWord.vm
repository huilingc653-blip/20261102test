<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fexAddWordPage.id}">
		<input id="createBy" name="createBy" type="hidden" value="$!{fexAddWordPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{fexAddWordPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fexAddWordPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{fexAddWordPage.updateDate}">
        <table class="layui-table">
			<tbody >
				<tr>
					##模板名称
					<td class="textRight" width="20%">#springMessage('table.fexTranInfo.tranCode')</td>
					<td width="30%">
						<div class="layui-input-inline">
							<input type="text" id="tranCode" name="tranCode" lay-verify="required|tableData|strlength" data-maxlength="30" data-biz-name="tranCode"
								   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranInfo.tranCode')">
							<table id="tranCodeTable" class="hide">
								<thead>
								<tr>
									<th>#springMessage('table.fexTranInfo.tranCode')</th>
									<th>#springMessage('table.fexTranInfo.tranName')</th>
								</tr>
								</thead>
							</table>
						</div>
                    </td>
					<td class="textRight" width="20%">#springMessage('bill.accebill.name')</td>
					<td width="30%">
						<input type="text" id="tranName" name="tranName" lay-verify="required" data-biz-name="tranName" readonly="readonly"
							   autocomplete="off" class="layui-input text" placeholder="#springMessage('bill.accebill.name')">
					</td>
                </tr>
				<tr>
					##收支方向 0 收汇 1 付汇
					<td class="textRight" width="20%">#springMessage('table.foreign.cdSign')</td>
					<td width="30%">
						<div class="bt-biz-dict" data-type="radio" data-group="fexAddWord.cdSign" data-defaultvalue="0" data-required="true"
							 data-name="cdSign" data-biz-name="cdSign"></div>
					</td>
					##有效标志 0 无效 1 有效
					<td class="textRight" width="20%">#springMessage('fcVoucherType.validSign')</td>
					<td width="30%">
						<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="1" data-required="true"
							 data-name="validSign" data-biz-name="validSign"></div>
					</td>
				</tr>
				<tr >
					<td class="textRight">#springMessage('table.fexForeignReq.tranAddWord')</td>
					<td colspan="3">
						<textarea placeholder="#springMessage('table.fexForeignReq.tranAddWord')" lay-verify="required|strlength" data-maxlength="100" class="layui-textarea" id="addWord" name="addWord" ></textarea>
					</td>
				</tr>
    			<tr >
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexAddWord.add.js?_btv=${resourceVersion}"></script>
</html>

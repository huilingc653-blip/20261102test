<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" action="">
    <input id="accCorpId" name="accCorpId" type="hidden" value="$!{ruleVO.corpId}">
    <input id="accCurId" name="accCurId" type="hidden" value="$!{ruleVO.curId}">
    <input id="accId" name="accId" type = "hidden" value="$!{ruleVO.accId}">
    <input type="hidden" id="id" name="id" value="$!{ruleVO.id}">
    <input type="hidden" id="addSize" value="$!{addSize}">
    <div class="layui-fluid" style="padding: 0">
        <div class="layui-row">
            <div class="layui-col-xs12">
                <table class="layui-table">
                    <thead>
                    <tr>
                        <td colspan="4">#springMessage('table.foreign.ruleCondition')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                    ##单位
                        <td class="textRight" width="14%">#springMessage('table.nisBillhead.corpId')</td>
                        <td width="36%">
                            #if($!{ruleVO.corpName})
                            $!{ruleVO.corpName}
                                #else
                                #springMessage('common.placeholder.all')
                            #end
                        </td>
                    ##现金流形式
                        <td class="textRight" width="14%">#springMessage('table.foreign.cashFlowType')</td>
                        <td width="36%">
                            #if($!{ruleVO.cashFlowMethod})
                            $dictTag.get("cashFlow.type",$!{ruleVO.cashFlowMethod})
                                #else
                                    #springMessage('common.placeholder.all')
                            #end
                        </td>
                    </tr>
                    <tr>
                    ##交易类型
                        <td class="textRight">#springMessage('ttpay.tradeType')</td>
                        <td>
                            #if($!{ruleVO.tranType})
                                $dictTag.get("foreign.tranGroupRule.tranType",$!{ruleVO.tranType})
                            #else
                                #springMessage('common.placeholder.all')
                            #end
                        </td>
                    ##产品
                        <td class="textRight">#springMessage('table.foreign.product')</td>
                        <td>
                            #if($!{ruleVO.proName})
                                $!{ruleVO.proName}
                            #else
                                #springMessage('common.placeholder.all')
                            #end
                        </td>
                    </tr>
                    <tr>
                    ##币种
                        <td class="textRight">#springMessage('table.foreign.currency')</td>
                        <td>
                            #if($!{ruleVO.curName})
                                $!{ruleVO.curName}
                            #else
                                #springMessage('common.placeholder.all')
                            #end
                        </td>
                    ##支付方式
                        <td class="textRight">#springMessage('table.foreign.voucherType')</td>
                        <td>
                            #if($!{ruleVO.voucherName})
                                $!{ruleVO.voucherName}
                            #else
                                #springMessage('common.placeholder.all')
                            #end
                        </td>
                    </tr>
                    <tr>
                    ##交易对手
                        <td class="textRight" >#springMessage('table.foreign.counterparty')</td>
                        <td >
                            #if($!{ruleVO.cotpName})
                                 $!{ruleVO.cotpName}
                            #else
                                #springMessage('common.placeholder.all')
                            #end
                        </td>
                    ##交易对手国家/地区
                        <td class="textRight" >#springMessage('table.foreign.counterparty')#springMessage('table.foreign.countryOrArea')</td>
                        <td>
                            #if($!{ruleVO.countryName})
                                $!{ruleVO.countryName}
                            #else
                                #springMessage('common.placeholder.all')
                            #end
                        </td>
                    </tr>
                    <tr>
                    ##收付方向
                        <td class="textRight">#springMessage('table.foreign.cdSign')</td>
                        <td >
                            #if($!{ruleVO.cdSign})
                                $dictTag.get("receiptAndPayment.direction",$!{ruleVO.cdSign})
                            #else
                                #springMessage('common.placeholder.all')
                            #end
                        </td>
                    ##银行账号
                        <td class="textRight">#springMessage('table.foreign.bankAcc')</td>
                        <td>
                            #if($!{ruleVO.bankCode})
                                $!{ruleVO.bankCode}
                            #else
                                #springMessage('common.placeholder.all')
                            #end
                        </td>
                    </tr>

                    <tr>
                    ##有效标志
                        <td class="textRight">#springMessage('fcVoucherType.validSign')</td>
                        <td>
                            #if($!{ruleVO.validSign})
                                $dictTag.get("valid_sign",$!{ruleVO.validSign})
                            #else
                                #springMessage('common.placeholder.all')
                            #end
                        </td>
                        <td></td>
                        <td></td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <div class="layui-col-xs12">
                <table class="layui-table">
                    <thead>
                    <tr>
                        <th colspan="4" style="text-align:left">#springMessage('table.foreign.fieldsAdd')</th>
                    </tr>
                    </thead>
                </table>
                <table class="layui-table">
                    <thead>
                    <tr>
                        <th>#springMessage('table.foreign.orderNumber')</th>##序号
                        <th>#springMessage('table.foreign.fieldName')</th>
                        <th>#springMessage('table.foreign.fieldVal')</th>
                    </tr>
                    </thead>
                    <tbody>
                        #foreach($ruleAdd in $ruleVO.ruleAddList)
                            #set($vcount = $velocityCount - 1)
                        <tr row="$!vcount">
                            <td style="text-align: center;">$!velocityCount</td>
                            <td style="text-align: center;">$!{ruleAdd.fieldName}</td>
                            <td style="text-align: center;">$!{ruleAdd.fieldVal}</td>
                        </tr>
                        #end
                    </tbody>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            <button class="layui-btn" type="button" onClick="closecurrent()">#springMessage('common.button.close')</button>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    function closecurrent(){
        if(!bt.navtab){
            parent.layer?parent.layer.closeAll():layer.closeAll();
        } else {
            bt.navtab.closeCurrent();
        }
    }
</script>
</html>
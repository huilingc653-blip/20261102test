<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="poolId" name="poolId" type="hidden" value="$!{fexCorpPoolTranPage.poolId}">
    <input id="bankaccId" name="bankaccId" type="hidden" value="$!{fexCorpPoolTranPage.bankaccId}">
    <input id="curId" name="curId" type="hidden" value="$!{fexCorpPoolTranPage.curId}">
    <input id="id" name="id" type="hidden" value="$!{fexCorpPoolTranPage.id}">
    <table class="layui-table">
        <tbody>
        <tr>
        ##资金池
            <td class="textRight">#springMessage('nis.pool.fcCorpPool.pool')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexcorppool/getFexCorpPools"
                         data-name="poolId" data-biz-name="poolId"
                         data-valuefield="id" data-textfield="showName" data-search="true"
                         data-callback="poolCallBack" data-defaultvalue="$!{fexCorpPoolTranPage.poolId}"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##资金池性质
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.poolNature')</td>
            <td>
                <div id="poolNature">$dictTag.get("fexCorpPool.poolNature",$!{fexCorpPoolTranPage.poolNature})</div>
            </td>
        </tr>
        <tr>
        ##银行账号
            <td class="textRight" width="30%">#springMessage('table.bisAccBal.bankAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexcorppool/getFexCorpPoolChilds?poolId=$!{fexCorpPoolTranPage.poolId}" data-name="bankaccId" data-biz-name="bankAcc"
                         data-callback="accountCallBack"
                         data-valuefield="id" data-textfield="bankAcc" data-search="true"
                         data-required="required" data-defaultvalue="$!{fexCorpPoolTranPage.bankaccId}" data-extraData="false"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##资金池主账号银行
            <td class="textRight" width="30%">
                #springMessage('nis.pool.fcCorpPool.pool')#springMessage('table.fexCorpPool.mainAccount')#springMessage(
                'common.button.bank')
            </td>
            <td>
                <div id="bankName">$!{fexCorpPoolTranPage.bankName}</div>
            </td>
        </tr>
        <tr>
        ##资金池主账号币种
            <td class="textRight" width="30%">
                #springMessage('nis.pool.fcCorpPool.pool')#springMessage('table.fexCorpPool.mainAccount')#springMessage(
                'contract.currency')
            </td>
            <td>
                <div id="englishCode">$!{fexCorpPoolTranPage.englishCode}</div>
            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight" width="30%">#springMessage('table.fcCorpPool.rmk')</td>
            <td>
                <textarea type="text" id="rmk" name="rmk" class="layui-textarea" readonly
                          placeholder="#springMessage('table.fcCorpPool.rmk')">$!{fexCorpPoolTranPage.poolRmk}</textarea>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
##借入外债交易
    <div class="layui-colla-item ignore-required-icon layui-form">
        <h2 class="layui-colla-title">#springMessage('table.fexCorpPoolTran.borrowing')</h2>##借入外债交易
        <div class="layui-colla-content layui-show">
            <table id="dataTable1" style="width:100%;">
                <thead>
                <tr>
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexBankAcc.tranType')</th>##交易类型
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexCorpPoolTran.product')</th>##产品
                    <th>#springMessage('common.table.thead.operation')</th>
                </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
##对外放款交易
    <div class="layui-colla-item ignore-required-icon layui-form">
        <h2 class="layui-colla-title">#springMessage('table.fexCorpPoolTran.Loan')</h2>##对外放款交易
        <div class="layui-colla-content layui-show">
            <table id="dataTable2" style="width:100%;">
                <thead>
                <tr>
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexBankAcc.tranType')</th>##交易类型
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexCorpPoolTran.product')</th>##产品
                    <th>#springMessage('common.table.thead.operation')</th>
                </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexCorpPoolTran.edit.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
	<ul class="layui-tab-title">
		<li class="layui-this">#springMessage('table.rasBackQuery.msg')</li>
		<li>#springMessage('table.fexTranReq.cashFlow')</li>
		<li>#springMessage('fex.cotp.customInformation')</li>
	</ul>
	<div class="layui-tab-content">
		<div class="layui-tab-item layui-show">
			<div id="print">
			<form class="layui-form" method="post">
				<!-- 系统参数 -->
				<input id="id" name="id" type="hidden" value="$!{fexTranReqPage.id}">
				<input id="billNo" name="billNo" type="hidden" value="$!{fexTranReqPage.billNo}">
				<input id="corpId" name="corpId" type="hidden" value="$!{fexTranReqPage.corpId}">
				<input id="settleDate" name="settleDate" type="hidden" value="$!{fexTranReqPage.settleDate}">
				<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
				<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
				<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
				<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
				<input id="busType" name="busType" type="hidden" value="$!{busType}">

				<!-- 资金计划参数 明细项控制模式-->
				<input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
				<input id="curId" name="curId" type="hidden" value="$!{fexTranReqPage.curId}">
				<input id="targetAccCurId" name="targetAccCurId" type="hidden" value="$!{fexTranReqPage.targetAccCurId}">
				<input id="srcBankAcc" name="srcBankAcc" type="hidden" value="$!{fexTranReqPage.srcBankAcc}">
				<input id="targetAccName" name="targetAccName" type="hidden" value="$!{fexTranReqPage.targetAccName}">
				<input id="targetAcc" name="targetAcc" type="hidden" value="$!{fexTranReqPage.targetAcc}">
				<table class="layui-table">
					<tbody>
					<tr>
						##交易号码
						<td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
						<td colspan="3">$!{fexTranReqPage.billNo}</td>
					</tr>
					</tbody>
				</table>
				<div class="layui-collapse">
				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##产品
								<td class="textRight" width="20%">#springMessage('table.foreign.product')</td>
								<td width="30%">$!{fexTranReqPage.proName}</td>
								##汇款类型
								<td class="textRight" width="20%">#springMessage('table.fexForeignReq.remitType')</td>
								<td width="30%">$dictTag.get("fexForeignReq.remitType",$!{fexTranReqPage.remitType})</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>

				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.fexTranReq.srcBankInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								<td rowspan="14" width="3%" align="center">#springMessage('table.nisAllocationReq.payerInfo')</td>
								##付款方-单位
								<td class="textRight" width="17%">#springMessage('table.fbsBudget.corpId')</td>
								<td width="30%">$!{fexTranReqPage.corpName}</td>
								<td rowspan="14" width="3%" align="center">#springMessage('table.nisAllocationReq.payeeInfo')</td>
								##收款方-单位
								<td class="textRight" width="17%">#springMessage('table.fbsBudget.corpId')</td>
								<td width="30%">$!{fexTranReqPage.targetCorpName}</td>
							</tr>
							<tr>
								##付款方-银行账户
								<td class="textRight" width="17%">#springMessage('table.fexForeign.bankAcc')</td>
								<td width="30%">$!{fexTranReqPage.srcBankAcc}</td>
								##收款方-银行账户
								<td class="textRight" width="17%">#springMessage('table.fexForeign.bankAcc')</td>
								<td width="30%">$!{fexTranReqPage.targetBankAcc}</td>
							</tr>
							<tr>
								##付款方-账户名称
								<td class="textRight">#springMessage('table.btBankAccApp.accName')</td>
								<td>$!{fexTranReqPage.srcAccName}</td>
								##收款方-账户名称
								<td class="textRight">#springMessage('table.btBankAccApp.accName')</td>
								<td>$!{fexTranReqPage.targetAccName}</td>
							</tr>
							<tr>
								##付款方-账户币种
								<td class="textRight">#springMessage('table.fexForeign.cotpCurName')</td>
								<td>$!{fexTranReqPage.englishCode}</td>
								##收款方-账户币种
								<td class="textRight">#springMessage('table.fexForeign.cotpCurName')</td>
								<td>$!{fexTranReqPage.targetAccEnglishCode}</td>
							</tr>
							<tr>
								##付款方-银行
								<td class="textRight" width="17%">#springMessage('common.button.bank')</td>
								<td width="30%">$!{fexTranReqPage.srcBankName}</td>
								##收款金额
								<td class="textRight" width="17%">#springMessage('table.internation.proceeds.money')</td>
								<td width="30%">$!number.formatNumeric($!{fexTranReqPage.payMoney})</td>
							</tr>
							<tr>
								##汇款方式
								<td class="textRight">#springMessage('table.fexForeignReq.remitMethod')</td>
								<td>$dictTag.get("fexForeignReq.remitMethod",$!{fexTranReqPage.remitMethod})</td>
								##收款人地址
								<td class="textRight">#springMessage('table.fexForeignReq.payeeAdd')</td>
								<td>$!{fexTranReqPage.targetAddr}</td>
							</tr>
							<tr>
								##交易日期
								<td class="textRight">#springMessage('table.revenue.transTime')</td>
								<td >$!date.format('yyyy-MM-dd',$!{fexTranReqPage.tranDate})</td>
								##收款人所在国家地区&地点
								<td class="textRight" width="15%">#springMessage('table.fexTranReq.payeeCountry')&#springMessage('fex.cotp.place')</td>
								<td width="30%">
									$!{fexTranReqPage.cotpCountryName}
									#if($!{fexTranReqPage.cotpCountryName} == "中国")
										$!{fexTranReqPage.cotpProvName} $!{fexTranReqPage.cotpCityName}
									#else
										$!{fexTranReqPage.cotpAddressName}
									#end
								</td>
							</tr>
							<tr>
								##结算日期
								<td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
								<td >$!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})</td>
								##收款人类型
								#*<td class="textRight">#springMessage('table.fexForeignReq.payeeType')</td>
								<td>$dictTag.get("fexForeignReq.payeeType",$!{fexTranReqPage.payeeType})</td>*#
								#if($!{bankType.isSetPayeeType} == "1" && $!{bankType.applayScopePayeeType.indexOf("2")} != -1)
									##收款人类型
									<td class="textRight">#springMessage('table.fexForeignReq.payeeType')</td>
									<td>
										#if($!{bankType.isSetPayeeType} == "1" && $!{bankType.applayScopePayeeType.indexOf("2")} != -1 && $!{payeeType.customCode} && $!{payeeType.customCode} != "")
											($!{payeeType.customCode})$!{payeeType.customName}
										#end
									</td>
								#else
									<td></td>
									<td></td>
								#end
							</tr>
							<tr>
								##跨行标志
								<td class="textRight">#springMessage('table.nisBillhead.difBank')</td>
								<td>$dictTag.get("nisBillhead.difBank",$!{fexTranReqPage.difBank})</td>
								##收款方-银行
								<td class="textRight" width="17%">#springMessage('common.button.bank')</td>
								<td width="30%">$!{fexTranReqPage.targetBankName}</td>
							</tr>
							<tr>
								##是否线下付款
								<td class="textRight">#springMessage('table.fexTranReq.isPayed')</td>
								<td>$dictTag.get("sf_yn",$!{fexTranReqPage.isPayed})</td>
								##收款方银行SWIFT CODE
								<td class="textRight">#springMessage('table.fexTranReq.payeeBankSwiftCode')</td>
								<td>
									<div id="targetBankCodeDiv" name="targetBankCodeDiv">$!{fexTranReqPage.targetBankCode}</div>
								</td>
							</tr>
							<tr>
								##支付类型
								<td class="textRight" id="bankPayTypeTd">
									#if($!{bankType.isSetBankPayType} == "1" && $!{bankType.applayScopeBankPayType.indexOf("2")} != -1)#springMessage('table.nisBillhead.bankPayType')#end
								</td>
								<td>
									#if($!{bankType.isSetBankPayType} == "1" && $!{bankType.applayScopeBankPayType.indexOf("2")} != -1 && $!{bankPayType.customCode} && $!{bankPayType.customCode} != "")
										($!{bankPayType.customCode})$!{bankPayType.customName}
									#end
								</td>
								##本地清算号
								<td class="textRight">#springMessage('table.btswiftinfo.localClearNo')</td>
								<td>$!{fexTranReqPage.localClearNo}</td>
							</tr>
							<tr>
								<td></td>
								<td></td>
								##代理行
								<td class="textRight">#springMessage('table.fexTranReq.agentBank')</td>
								<td>$!{fexTranReqPage.cotpBank}</td>
							</tr>
							<tr>
								<td></td>
								<td></td>
								##收款人常驻国家或者地区
								<td class="textRight">#springMessage('table.fexTranReq.countryId')</td>
								<td>$!{fexTranReqPage.nameZh}</td>
							</tr>
							<tr>
								<td></td>
								<td></td>
								##开户行在代理行账户
								<td class="textRight">#springMessage('table.fexTranReq.agentBankAcc')</td>
								<td>$!{fexTranReqPage.agentBankAcc}</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>
				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.fexTranReq.costInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##国内外费用承担标志 1-汇款人 OUR  2-收款人 BEN  3-共同 SHA
								<td class="textRight" width="20%">#springMessage('table.fexForeignReq.costSign')</td>
								<td width="80%" colspan="3">$dictTag.get("fexForeignReq.costSign",$!{fexTranReqPage.costSign})</td>
							</tr>
							<tr>
								##费用支出账户
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.costAcc')</td>
								<td width="30%">$!{fexTranReqPage.costAcc}</td>
								<td colspan="2">$!{fexTranReqPage.costAcc2}</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>
				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('fex.fexTranReqPay.reportInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##加急标志
								<td class="textRight">#springMessage('table.nisBillhead.isQuick')</td>
								<td>$dictTag.get("sf_yn",$!{fexTranReqPage.isQuick})</td>
								##交易地点
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAddr')</td>
								<td width="30%">$!{fexTranReqPage.tranAddr}</td>
							</tr>
							<tr>
								##交易组
								<td class="textRight">#springMessage('table.fexTranReq.tranGroup')</td>
								<td>$!{fexTranReqPage.tranGroupName}</td>
								##资金性质
								<td class="textRight">#springMessage('table.fexTranReq.accNature')</td>
								<td>$dictTag.get("fexTranReq.accNature",$!{fexTranReqPage.accNature})</td>
							</tr>
							<tr>
								##交易员
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.dealer')</td>
								<td width="30%">$!{dealer}</td>
								##申请日期
								<td class="textRight" width="20%">#springMessage('table.bisFinanceExc.reqDate')</td>
								<td width="30%">$!{sysDate}</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>
				<div class="layui-colla-item" #if($!{bankType.isSetOtherCustom} != "1") style="display: none" #end>
					<h2 class="layui-colla-title">#springMessage('cms.loan.OtherInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##资金用途
								<td class="textRight" width="20%">
									#if($!{otherCustom.needField.indexOf("capitalUse")} != -1)
										#springMessage('table.fexTranReq.capitalUse')
									#end
								</td>
								<td width="30%">
									#if($!{otherCustom.needField.indexOf("capitalUse")} != -1)
										$!{fexTranReqPage.capitalUse}
									#end
								</td>
								##附言
								<td class="textRight" width="20%">
									#if($!{otherCustom.needField.indexOf("addWord")} != -1)
										#springMessage('table.nisBillhead.addWord')
									#end
								</td>
								<td width="30%">
									#if($!{otherCustom.needField.indexOf("addWord")} != -1)
										$!{fexTranReqPage.addWord}
									#end
								</td>
							</tr>
							<tr #if($!{otherCustom.needField.indexOf("rmk")} == -1) style="display: none" #end>
								##备注（英文）
								<td class="textRight" width="20%">#springMessage('bisAccAttribute.rmk')</td>
								<td colspan="3">$!{fexTranReqPage.rmk}</td>
							</tr>
							<tr #if($!{otherCustom.needField.indexOf("rmkLocal")} == -1) style="display: none" #end>
								##备注（本地语言）
								<td class="textRight" width="20%">#springMessage('table.fexForeignReq.rmkLocal')</td>
								<td colspan="3">$!{fexTranReqPage.rmkLocal}</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>
				</div>
				<!-- 资金计划 -->
				<div id="tagItemDetail"></div>
				<!-- 日志 -->
				<div id="tagMsg"></div>
			</form>
			</div>
			<div class="layui-form-item layui-form-submit" id="buttonDiv">
				<div class="layui-input-block">
					<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{fexTranReqPage.id}')">#springMessage('common.button.trackFlow')</button>
					<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
				</div>
			</div>
		</div>
		<div class="layui-tab-item">
			<table id="appTable" class="layui-table layui-form" style="width:100%;">
				<thead>
				<tr>
					#if($!{fexTranReqPage.status} == "95")
						<th>#springMessage('table.fexCashFlow.billNo')</th>
					#end
					<th>#springMessage('table.fexTranReq.cashFlowDate')</th>
					<th>#springMessage('table.fcSubjectDay.optDate')</th>
					<th>#springMessage('table.fexBankAcc.cashFlowType')</th>
					<th>#springMessage('table.bisAccDtl.curName')</th>
					<th>#springMessage('table.choBankFinance.payMoney')</th>
					<th>#springMessage('table.nisBillhead.corpId')</th>
					<th>#springMessage('common.button.bank')</th>
					<th>#springMessage('table.btBankAccApp.accName')</th>
					<th>#springMessage('table.foreign.bankAcc')</th>
					<th>#springMessage('fex.cotp')</th>
					<th>#springMessage('table.fexTranReq.cotpBank')</th>
					<th>#springMessage('table.fexTranReq.cotpAccName')</th>
					<th>#springMessage('table.fexForeign.cotpAcc')</th>
					<th>#springMessage('table.fexForeign.cotpCur')</th>
					<th>#springMessage('table.foreign.voucherType')</th>
				</tr>
				</thead>
				#if($!{fexTranReqPage.status} == "95")
					#foreach($data in $cashFlowList)
						<tr>
							<td align="center">$!{data.billNo}</td>
							<td align="center">$!date.format('yyyy-MM-dd',$!{data.cashFlowDate})</td>
							<td align="center">$!date.format('yyyy-MM-dd',$!{data.settleDate})</td>
							<td align="center">$dictTag.get("fexCorp.cashFlowType",$!{data.cashFlowType})</td>
							<td align="center">$!{data.englishCode}</td>
							<td align="right">
								#if($!{data.cdSign}=="1")
									-$!number.formatNumeric($!{data.payMoney})
								#else
									$!number.formatNumeric($!{data.payMoney})
								#end
							</td>
							<td align="center">$!{data.corpName}</td>
							<td align="center">$!{data.corpBankName}</td>
							<td align="center">$!{data.corpAccName}</td>
							<td align="center">$!{data.corpBankAcc}</td>
							<td align="center">$!{data.allocatCotpName}</td>
							<td align="center">$!{data.allocatCotpBankName}</td>
							<td align="center">$!{data.cotpAccName}</td>
							<td align="center">$!{data.cotpBankAcc}</td>
							##交易对手币种
							<td align="center">$!{data.payeeEnglishCode}</td>
							<td align="center">$!{data.voucherTypeName}</td>
						</tr>
					#end
				#else
					#if($!{fexTranReqPage.curId} == $!{fexTranReqPage.targetAccCurId})
					<tr id="srcTr">
					#else
					<tr id="srcTr" style="display: none">
					#end
						##现金流日期
						<td align="center">$!{sysDate}</td>
						##结算日期
						<td align="center"><div id="srcSettleDateTd">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})</div></td>
						##现金流类型
						<td align="center"><div id="srcCashFlowTypeTd">$dictTag.get("fexCorp.cashFlowType","0")</div></td>
						##币种
						<td align="center"><div id="srcCurTd">$!{fexTranReqPage.englishCode}</div></td>
						##金额
						<td align="right"><div id="srcPayMoneyTd">-$!number.formatNumeric($!{fexTranReqPage.payMoney})</div></td>
						##单位
						<td align="center"><div id="srcCorpTd">$!{fexTranReqPage.corpName}</div></td>
						##银行
						<td align="center"><div id="srcBankTd">$!{fexTranReqPage.srcBankName}</div></td>
						##账户名称
						<td align="center"><div id="srcAccNameTd">$!{fexTranReqPage.srcAccName}</div></td>
						##银行账户
						<td align="center"><div id="srcBankAccTd">$!{fexTranReqPage.srcBankAcc}</div></td>
						##交易对手
						<td align="center"><div id="srcCotpTd">$!{fexTranReqPage.targetCorpName}</div></td>
						##交易对手银行
						<td align="center"><div id="srcCotpBankTd">$!{fexTranReqPage.targetBankName}</div></td>
						##交易对手账户名称
						<td align="center"><div id="srcCotpAccNameTd">$!{fexTranReqPage.targetAccName}</div></td>
						##交易对手银行账户
						<td align="center"><div id="srcCotpBankAccTd">$!{fexTranReqPage.targetBankAcc}</div></td>
						##交易对手币种
						<td align="center"><div id="srcCotpCurTd">$!{fexTranReqPage.targetAccEnglishCode}</div></td>
						##支付方式
						<td align="center"><div id="srcPayTypeTd">$!{fexTranReqPage.voucherTypeName}</div></td>
					</tr>
					<tr id="targetTr">
						<td align="center">$!{sysDate}</td>
						<td align="center"><div id="targetSettleDateTd">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})</div></td>
						<td align="center"><div id="targetCashFlowTypeTd">$dictTag.get("fexCorp.cashFlowType","0")</div></td>
						<td align="center">
							<div id="targetCurTd">
								#if($!{fexTranReqPage.curId} == $!{fexTranReqPage.targetAccCurId})
									$!{fexTranReqPage.englishCode}
								#else
									$!{fexTranReqPage.targetAccEnglishCode}
								#end
							</div>
						</td>
						<td align="right"><div id="targetPayMoneyTd">$!number.formatNumeric($!{fexTranReqPage.payMoney})</div></td>
						<td align="center"><div id="targetCorpTd">$!{fexTranReqPage.targetCorpName}</div></td>

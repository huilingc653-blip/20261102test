<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input id="tranType" name="tranType" type="hidden" value="1">
    <input id="isSwpTran" name="isSwpTran" type="hidden" value="1">
    <input id="opType" name="opType" type="hidden" value="list">
    <input id="fexTranType" name="fexTranType" type="hidden" value="1">
    <input id="fexTranTypeCode" name="fexTranTypeCode" type="hidden" value="swap">

    <input id="flowStatus" name="flowStatus" type="hidden" value="$!{flowStatus}">
    <input id="cycleTime" name="cycleTime" type="hidden" value="$!{cycleTime}">
    <table class="layui-table">
        <tbody>
        <tr>
            ##交易号码
            <td class="textRight">#springMessage('table.fexTranReq.billNo')</td>
            <td>
                <input type="text" name="likes_billNo"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.billNo')">
            </td>
            ##产品
            <td class="textRight">#springMessage('table.fexBankAcc.proId')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/json?tranType=9" data-name ="eqs_proId" data-biz-name ="eqs_proId"
                     data-valueField="id" data-textField="proName" data-method="post"></div>
            </td>
            ##单位
            <td class="textRight">#springMessage('table.fbsBudget.corpId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="ins_corpId"
                         data-resource="foreign:fextranreq:foreign:query"
                         data-scope="all"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##买入币种
            <td class="textRight">#springMessage('table.fexTranReq.buyCurId')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_buyCurId" data-biz-name ="eqs_buyCurId"
                     data-valueField="id" data-textField="englishCode"></div>
            </td>
            ##卖出币种
            <td class="textRight">#springMessage('table.fexTranReq.sellCurId')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_sellCurId" data-biz-name ="eqs_sellCurId"
                     data-valueField="id" data-textField="englishCode"></div>
            </td>
            ##状态
            <td class="textRight">#springMessage('table.choBankFinance.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" #*data-displayData="-3,-1,0,11,95,110,112,113,114,115,120"*#
                     data-group="RECONCILIATION_STATUS" data-name="eqi_status"></div>
            </td>
        </tr>
        <tr>
            ##申请日期
            <td class="textRight">#springMessage('table.bisFinanceExc.reqDate')</td>
            <td>
                <input type="text" name="ged_createDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_createDate" >
                <span class="date-mid">~</span>
                <input type="text" name="led_createDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_createDate">
            </td>
            ##结算日期
            <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
            <td>
                <input type="text" name="ged_settleDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_settleDate" >
                <span class="date-mid">~</span>
                <input type="text" name="led_settleDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_settleDate">
            </td>
            ##交易对手
            <td class="textRight">#springMessage('table.fexTranReq.cotpBank')</td>
            <td>
                ##                        <div class="layui-input-inline">
                ##                            <div class="bt-biz-mulselectType" data-url="${basePath}/foreign/fexCotp/listBankCotp" data-name ="ins_cotpId" data-biz-name ="ins_cotpId"
                ##                                 data-valueField="id" data-textField="cotpName" data-method="get"></div>
                ##                        </div>
                <div class="layui-input-inline">
                    <input type="text" id="cotpName" name="likes_cotpName" readonly="readonly" class="layui-input">
                    <div class="bt-div-search">
                        <button class="bt-biz-allBankInfo" id="selCoptBankBut" type="button" data-callback="bt.cotpBankCallback" title="#springMessage('common.button.select')">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>

        </tr>
        <tr>
            ##外汇业务类型
            <td class="textRight">#springMessage('table.fexProduct.fexBusType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="fexProduct.fexBusType" data-name="eqs_fexBusType"></div>
            </td>
            ##外汇交易类型
            <td class="textRight">#springMessage('table.fexProduct.fexTranType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="fexProduct.fexTranType" data-name="eqs_fexTranType"></div>
            </td>
            ##资金性质
            <td class="textRight">#springMessage('table.fexTranReq.accNature')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="fexTranReq.accNature" data-name="eqs_accNature"></div>
            </td>
        </tr>
        <tr>
            ##买入金额
            <td class="textRight">#springMessage('table.fexTranReq.buyMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_buyMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           data-moneyendid="leg_buyMoney" placeholder="#springMessage('table.fexTranReq.buyMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_buyMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           id="leg_buyMoney" placeholder="#springMessage('table.fexTranReq.buyMoney')">
                </div>
            </td>
            ##卖出金额
            <td class="textRight">#springMessage('table.fexTranReq.sellMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_sellMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           data-moneyendid="leg_sellMoney" placeholder="#springMessage('table.fexTranReq.sellMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_sellMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           id="leg_sellMoney" placeholder="#springMessage('table.fexTranReq.sellMoney')">
                </div>
            </td>
            ##单据来源
            <td class="textRight">#springMessage('table.nisBillhead.billFrom')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-displayData="0,1,2,4"
                     data-group="foreign.billFrom" data-name="eqs_billFrom"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fexTranReq.billNo')</th>
        <th>#springMessage('table.fexTranReq.swapFexTranType')</th>
        <th>#springMessage('table.fexBankAcc.proId')</th>
        <th>#springMessage('table.fexProduct.fexBusType')</th>
        <th>#springMessage('table.fexProduct.fexTranType')</th>
        <th>#springMessage('table.fbsBudget.corpId')</th>
        <th>#springMessage('table.fexTranReq.buyCurId')</th>
        <th>#springMessage('table.fexTranReq.buyMoney')</th>
        <th>#springMessage('table.fexTranReq.sellCurId')</th>
        <th>#springMessage('table.fexTranReq.sellMoney')</th>
        <th>#springMessage('table.fexTranReq.contractRate')</th>
        <th>#springMessage('table.fexTranReq.cotpBank')</th>
        <th>#springMessage('table.bisFinanceExc.reqDate')</th>
        <th>#springMessage('table.btNetChalk.transTime')</th>
        <th>#springMessage('table.fcSubjectDay.optDate')</th>
        <th>#springMessage('table.fexTranReq.accNature')</th>
        <th>#springMessage('table.choBankFinance.status')</th>
        <th>#springMessage('table.nisBillhead.billFrom')</th>
        <th>#springMessage('table.fexTranReq.relBillNo')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
    #caDataHidden()
    #caDataScript()
    #paymentWorkFlowScript()
</body>
</html>
<script src="${basePath}/static/modules/foreign/foreignTranReq/swap.approve.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/foreign/foreignTranReq/listApprove.js?_btv=${resourceVersion}"></script>

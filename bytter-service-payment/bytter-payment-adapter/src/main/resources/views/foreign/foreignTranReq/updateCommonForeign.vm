<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
	<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
		<ul class="layui-tab-title">
			<li class="layui-this">#springMessage('table.rasBackQuery.msg')</li>
			<li>#springMessage('table.fexTranReq.cashFlow')</li>
			<li>#springMessage('fex.cotp.customInformation')</li>
		</ul>
		<div class="layui-tab-content">
			<div class="layui-tab-item layui-show">
				<input id="createBy" name="createBy" type="hidden" value="$!{fexTranReqPage.createBy}">
				##                <input id="createDate" name="createDate" type="hidden" value="$!{fexTranReqPage.createDate}">
				<input id="updateBy" name="updateBy" type="hidden" value="$!{fexTranReqPage.updateBy}">
				<input id="updateDate" name="updateDate" type="hidden" value="$!{fexTranReqPage.updateDate}">
				<input id="id" name="id" type="hidden" value="$!{fexTranReqPage.id}">
				<input id="tranType" name="tranType" type="hidden" value="$!{fexTranReqPage.tranType}">
				<input id="swapType" name="swapType" type="hidden" value="$!{fexTranReqPage.swapType}">
				<input id="type" name="type" type="hidden" value="$!{type}">
				<input id="status" name="status" type="hidden" value="0">
				<input id="originStatus" type="hidden" value="$!{fexTranReqPage.status}">
				<input id="billNo" name="billNo" type="hidden" value="$!{fexTranReqPage.billNo}">
				<input id="tranAppDtlId" name="tranAppDtlId" type="hidden" value="$!{fexTranReqPage.tranAppDtlId}">
				<input id="tranAppDtlNo" name="tranAppDtlNo" type="hidden" value="$!{fexTranReqPage.tranAppDtlNo}">
				<!--固定金额 1-买入金额 2-卖出金额-->
				<input id="fixedMoneyApp" type="hidden" value="$!{fexTranReqPage.fixedMoney}">
				<!-- 系统参数 -->
				<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
				<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
				<input type="hidden" class="layui-input" id="rateTypeId" value="$!{rateTypeId}">
				<input type="hidden" class="layui-input" id="defProfitAndLossCur" value="$!{defProfitAndLossCur}">
				<input type="hidden" class="layui-input" id="corpBaseCur" value="$!{corpBaseCur}">
				<!-- 资金计划参数 明细项控制模式-->
				<input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
				<input id="settlType" name="settlType" type="hidden" value="0">
				<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
				<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
				<!--买入方账户信息-->
				<!-- 主体单位账户信息 -->
				<input type="hidden" id="corpBank" name="corpBank" value="$!{fexTranReqPage.corpBank}">
				<input type="hidden" id="corpAccId" name="corpAccId" value="$!{fexTranReqPage.corpAccId}">
				#*<input type="hidden" id="corpBankAcc" name="corpBankAcc" value="$!{fexTranReqPage.corpBankAcc}">*#
				<input type="hidden" id="corpAccName" name="corpAccName" value="$!{fexTranReqPage.corpAccName}">
				<!-- 交易对手账户信息 -->
				<input type="hidden" id="cotpBank" name="cotpBank" value="$!{fexTranReqPage.cotpBank}">
				<input type="hidden" id="cotpAccId" name="cotpAccId" value="$!{fexTranReqPage.cotpAccId}">
				<input type="hidden" id="cotpBankAcc" name="cotpBankAcc" value="$!{fexTranReqPage.cotpBankAcc}">
				<input type="hidden" id="cotpAccName" name="cotpAccName" value="$!{fexTranReqPage.cotpAccName}">
				<!--卖出方账户信息-->
				<input type="hidden" id="srcBank" name="srcBank" value="$!{fexTranReqPage.srcBank}">
				<input type="hidden" id="srcAccId" name="srcAccId" value="$!{fexTranReqPage.srcAccId}">
				#*<input type="hidden" id="srcBankAcc" name="srcBankAcc" value="$!{fexTranReqPage.srcBankAcc}">*#
				<input type="hidden" id="srcAccName" name="srcAccName" value="$!{fexTranReqPage.srcAccName}">
				<input type="hidden" id="targetBank" name="targetBank" value="$!{fexTranReqPage.targetBank}">
				<input type="hidden" id="targetAccId" name="targetAccId" value="$!{fexTranReqPage.targetAccId}">
				<input type="hidden" id="targetBankAcc" name="targetBankAcc" value="$!{fexTranReqPage.targetBankAcc}">
				<input type="hidden" id="targetAccName" name="targetAccName" value="$!{fexTranReqPage.targetAccName}">
				<input id="cloneFlag" name="cloneFlag" type="hidden" value="$!{fexTranReqPage.cloneFlag}">
				<input id="isAsk" name="isAsk" type="hidden" value="$!{fexTranReqPage.isAsk}">
				<input id="isSwapTran" name="isSwapTran" type="hidden" value="$!{fexTranReqPage.isSwapTran}">
				<input id="exposureBusType" name="exposureBusType" type="hidden" #if($!{fexTranReqPage.fexTranType}=="0") value="1" #else value="2" #end>
				##汇款类型
				<input type="hidden" name="remitType" value="0">
				##跨行标志
				<input type="hidden" name="difBank" value="0">

				<input id="isProfitAndLoss" name="isProfitAndLoss" type="hidden" value="$!{isProfitAndLoss}">
				<input id="isSpotAutoDelivery" name="isSpotAutoDelivery" type="hidden" value="$!{isSpotAutoDelivery}">
				<input id="isShowConvert"  type="hidden" #if ($!{showConvert}=="0") value="N" #else value="Y" #end>
				<input id="billFrom" name = "billFrom"  type="hidden" value="$!{fexTranReqPage.billFrom}">

				<input id="showProfitLoss"   type="hidden" value="$!{showProfitLoss}">

				#if($!{fexTranReqPage.cloneFlag} != "1")
					<table class="layui-table">
						<tbody>
						<tr>
							##交易号码
							<td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
							<td width="30%">
								$!{fexTranReqPage.billNo}
							#*	<input type="text" id="billNo" name="billNo"
									   value="$!{fexTranReqPage.billNo}"
									   autocomplete="off" class="layui-input"
									   placeholder="#springMessage('table.fexForeignReq.billNo')">*#
							</td>
							##交易需求编号
							<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAppDtlNo')</td>
							<td width="30%">$!{fexTranReqPage.tranAppDtlNo}</td>
						</tr>
						</tbody>
					</table>
				#end
				<div class="layui-collapse">
					<div class="layui-colla-item">
						<h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranMainInfo')</h2>
						<div class="layui-colla-content layui-show">
							<table class="layui-table">
								<tbody>
								<tr>
									##单位
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.corpId')</td>
									<td width="30%">
										<input type="hidden" id="corpIdDef" value="$!{fexTranReqPage.corpId}">
										#if($!{fexTranReqPage.tranAppDtlId}||$!{fexTranReqPage.type}=="3")
											$!{fexTranReqPage.corpName}
											<div class="layui-input-inline ignore-required-icon" style="display: none">
										#else
											<div class="layui-input-inline">
										#end
												<div class="bt-biz-corp"
													 data-biz-type="corp"
													 data-type="selectTree"
													 data-name="corpId"
													 data-biz-name="corpId"
													 data-scope="all"
													#if($!{type}=="spot")
													 data-resource="foreign:fextranreq:foreign:spot:apply"
													#elseif($!{type}=="forward")
													 data-resource="foreign:fextranreq:foreign:forward:apply"
													#elseif($!{type}=="swap")
													 data-resource="foreign:fextranreq:foreign:swap:apply"
													#end
													 data-required="true"
													 data-callback="bt.corpCallback"
													 data-defaultvalue="$!{fexTranReqPage.corpId}">
												</div>
											</div>
									</td>
									##产品
									<td class="textRight" width="20%">#springMessage('table.foreign.product')</td>
									<td width="30%">
										<input type="hidden" id="proIdDef" value="$!{fexTranReqPage.proId}">
										<input type="hidden" id="fexTranType1" value="$!{type}">
										#if($!{fexTranReqPage.billFrom}=="1")
											$!{fexTranReqPage.proName}
											<div class="layui-input-inline ignore-required-icon" style="display: none">
										#else
										<div class="layui-input-inline">
										#end
											<div class="bt-biz-selectType"
												#if($!{type}=="spot")
												 data-url="${basePath}/foreign/fexproduct/json?tranType=7&fexTranType=0"
												#elseif($!{type}=="forward")
												 data-url="${basePath}/foreign/fexproduct/json?tranType=8&fexTranType=1"
												#elseif($!{type}=="swap")
												 data-url="${basePath}/foreign/fexproduct/json?tranType=9&fexTranType=2"
												#end
												 data-name="proId" data-biz-name="proId" data-method="post"
												 data-valueField="id" data-textField="proName" data-required="true"
												 data-callback="bt.proCallback" data-value="$!{fexTranReqPage.proId}">
											</div>
										</div>
									</td>
								</tr>
								</tbody>
							</table>
						</div>
					</div>
					<div class="layui-colla-item">
						<h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranProductInfo')</h2>
						<div class="layui-colla-content layui-show">
							<table class="layui-table">
								<tbody>
								<tr>
									##外汇交易类型
									<td class="textRight" width="20%">#springMessage('table.fexProduct.fexTranType')</td>
									<td width="30%">
										<input type="hidden" id="fexTranType" name="fexTranType" value="$!{fexTranReqPage.fexTranType}">
										<div id="fexTranTypeDiv" name="fexTranTypeDiv">$dictTag.get("fexProduct.fexTranType",$!{fexTranReqPage.fexTranType})</div>
									</td>
									##外汇业务类型
									<td class="textRight" width="20%">#springMessage('table.fexProduct.fexBusType')</td>
									<td width="30%">
										<input type="hidden" id="fexBusType" name="fexBusType"
											   value="$!{fexTranReqPage.fexBusType}">
										<div id="fexBusTypeDiv" name="fexBusTypeDiv">$dictTag.get(
											"fexProduct.fexBusType",$!{fexTranReqPage.fexBusType})</div>
									</td>
								</tr>
								<tr>
									##结汇业务类型
									#if($!{fexTranReqPage.fexBusType}=="1")
										<td class="textRight" id="settleBusTypeTd" width="20%">#springMessage('fex.tran.settleBusType')</td>
										<td width="30%" id="settleBusTypeDiv">
											<div >
												<div class="bt-biz-dict" data-type="select" data-group="fex.tran.settleBusType"
													 data-name="settleBusType" data-biz-name="settleBusType"
													 data-value="$!{fexTranReqPage.settleBusType}"></div>
											</div>
										</td>
									#end
									##交割类型
									<td class="textRight" width="20%">#springMessage('table.fexProduct.deliveryType')</td>
									<td width="30%">
										<input type="hidden" id="deliveryType" name="deliveryType"
											   value="$!{fexTranReqPage.deliveryType}">
										<div id="deliveryTypeDiv" name="deliveryTypeDiv">$dictTag.get("fexProduct.deliveryType",$!{fexTranReqPage.deliveryType})</div>
									</td>
								</tr>
								</tbody>
							</table>
						</div>
					</div>
					<div class="layui-colla-item">
						<h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
						<div class="layui-colla-content layui-show">
							<table class="layui-table">
								<tbody>
								<tr>
									##交易对手
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.cotpBank')</td>
									<td width="30%">
										<div class="layui-input-inline">
											<input type="hidden" id="oppId" name="oppId" value="$!{fexTranReqPage.oppId}" autocomplete="off" class="layui-input">
											<input type="hidden" id="cotpId" name="cotpId" value="$!{fexTranReqPage.cotpId}" autocomplete="off" class="layui-input">
											<input type="text" id="cotpName" name="cotpName" lay-verify="required" readonly="readonly" value="$!{fexTranReqPage.cotpName}" class="layui-input">
											##交易对手银行
											<div class="bt-div-search">
												<button class="bt-biz-allBankInfo" id="selCoptBankBut" type="button" data-callback="bt.cotpBankCallback" title="#springMessage('common.button.select')">
													<i class="layui-icon">&#xe615;</i>
												</button>
											</div>
										</div>
									</td>
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.cotpBank')#springMessage('table.btswiftinfo.swiftCode')</td>
									<td width="30%">
										<div id="cotpBicCodeDiv" name="cotpBicCodeDiv">$!{fexTranReqPage.cotpBicCode}</div>
										<input type="hidden" id="cotpBicCode" name="cotpBicCode" value="$!{fexTranReqPage.cotpBicCode}">
									</td>
								</tr>
								<tr>
									##交易货币对
									<td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.currencyPairs')</td>
									<td width="30%">
										#if($!{fexTranReqPage.billFrom}=="1")
											$!{fexTranReqPage.tranCurPairIdName}
											<div class="layui-input-inline" style="display: none">
												<div class="bt-biz-selectType" data-biz-name="tranCurPairId"
													 data-url="${basePath}/basic/business/btcurrencypair/json"
													 data-valuefield="id" data-textfield="pairCode"
													 data-name="tranCurPairId"
													 data-callback="bt.currencyPairCallback"
													 data-defaultvalue="$!{fexTranReqPage.tranCurPairId}"
													 data-disabled="true"></div>
											</div>
										#else
											<div class="layui-input-inline">
												<div class="bt-biz-selectType" data-biz-name="tranCurPairId"
													 data-url="${basePath}/basic/business/btcurrencypair/json"
													 data-valuefield="id" data-textfield="pairCode"
													 data-name="tranCurPairId"
													 data-required="true"
													 data-callback="bt.currencyPairCallback"
													 data-defaultvalue="$!{fexTranReqPage.tranCurPairId}"></div>
											</div>
										#end
										<input type="hidden" name="tranCurPairBaseId" id="tranCurPairBaseId" value="$!{fexTranReqPage.tranCurPairBaseId}">
										<input type="hidden" name="tranCurPairReferId" id="tranCurPairReferId" value="$!{fexTranReqPage.tranCurPairReferId}">
									</td>
									##买卖方向
									<td class="textRight" colspan="2" width="20%">#springMessage(
                                        'fex.tranApp2.businessDirection')</td>
									<td width="30%">
										#if($!{fexTranReqPage.tranAppDtlId}||$!{fexTranReqPage.type}=="3"||$!{fexTranReqPage.status}==-1||$!{fexTranReqPage.status}=="-1")
											$dictTag.get("fexTranDeal.deliverySign",$!{fexTranReqPage.busDirection})
										#end
											## disabled 的 radio 不会随表单提交，需用隐藏域保留买卖方向
										<div class="layui-input-inline"
											#if($!{fexTranReqPage.tranAppDtlId}||$!{fexTranReqPage.type}=="3"||$!{fexTranReqPage.status}==-1||$!{fexTranReqPage.status}=="-1")
											 	style="display:none;"
											#end
											 >
											<div class="bt-biz-dict" data-type="radio"
												 data-defaultvalue="$!{fexTranReqPage.busDirection}"
												 data-group="fexTranDeal.deliverySign"
												 data-name="busDirection" data-callback="bt.busDirectionCallback"
												 data-biz-name="busDirection" data-disabled="true"></div>
										</div>
									</td>
								</tr>
								<tr>
									##报价方式
									<td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.quotationMethod')</td>
									<td width="30%">
										<div class="layui-input-inline">
											<input type="text" id="quotationMethod" name="quotationMethod"
												   value="$!{fexTranReqPage.quotationMethod}" class="layui-input"
												   readonly/>
										</div>
										<div class="layui-input-inline" id="quotationMethodDesc"
											 style="color: red;display: none">
											交易货币对在外汇牌价查询的外汇牌价类型$!{rateTypeName}中无报价，请先在外汇牌价查询中录入
										</div>
										<input type="hidden" name="quotationCurId" id="quotationCurId" value="$!{fexTranReqPage.quotationCurId}">
										<input type="hidden" name="quotationReferCurId" id="quotationReferCurId" value="$!{fexTranReqPage.quotationReferCurId}">
									</td>
									#if($!{fexTranReqPage.tranAppDtlId})
										##  金额是否自动计算
										<td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.isAutoCalculate')</td>
										<td width="30%">
											<div class="bt-biz-dict" data-type="radio"
												 data-group="fexTranDeal.isAutoCalculate" data-required="true" data-name="isPaymentAmount"
												 data-biz-name="isPaymentAmount" data-defaultvalue="1"></div>
										</td>
									#else
										##  金额是否自动计算
										<td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.isAutoCalculate')</td>
										<td width="30%">
											<div class="bt-biz-dict" data-type="radio"
												 data-group="fexTranDeal.isAutoCalculate" data-required="true" data-name="isPaymentAmount"
												 data-biz-name="isPaymentAmount" data-defaultvalue="$!{fexTranReqPage.isPaymentAmount}"></div>
										</td>
									#end
								</tr>
								<tr>
									##固定金额
									<td class="textRight" colspan="2" width="20%"><div>#springMessage('fex.tranApp.FixedAmount')</div></td>
									<td width="30%">
										<div class="fixedMoneyDiv">
											<div class="bt-biz-dict" data-type="radio"  data-group="fex.tranApp.fixMoney" data-required="true"
												 data-name="fixedMoney" data-biz-name="fixedMoney" data-callback="bt.fixMoneyCallback" id="fixedMoney"
												 #if($!{type} == 'spot' && $!{swiftCodeInfo.bankTypeName} && $!{swiftCodeInfo.nameZh} && $!{swiftCodeInfo.bankTypeName.indexOf("工商银行")} != -1 && $!{swiftCodeInfo.nameZh.indexOf("越南")} != -1)
												 data-disabledValue="1"
												 #end
												 data-defaultvalue="$!{fexTranReqPage.fixedMoney}"></div>
										</div>
									</td>
									#if($!{fexTranReqPage.tranAppDtlId})
										## 交易汇率类型
										<td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.transExchangeRateType')</td>
										<td width="30%">
											<div class="bt-biz-dict" data-type="select" data-group="fexTranReq.transExchangeRateType"
												 data-name="tranRateType" data-biz-name="tranRateType" data-required = "true"
												 data-defaultvalue="$!{fexTranReqPage.tranRateType}" data-callback="bt.transExchangeRateType"></div>
										</td>
									#else
										## 交易汇率类型
										<td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.transExchangeRateType')</td>
										<td width="30%">
											<div class="bt-biz-dict" data-type="select" data-group="fexTranReq.transExchangeRateType"
												 data-name="tranRateType" data-biz-name="tranRateType" data-required = "true"
												 data-defaultvalue="$!{fexTranReqPage.tranRateType}" data-callback="bt.transExchangeRateType"></div>
										</td>
									#end

								</tr>
								<tr>
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.contractRate')</td>
									<td>
										<input type="text" data-name="contractRate" data-biz-name="contractRate" data-decimal="6"
											#if($!{fexTranReqPage.tranRateType}=="2") lay-verify="required" #end data-callback="bt.contractRateCallback"
											   id="contractRate" autocomplete="off" class="layui-input bt-biz-moneyType"
											   value="$!{fexTranReqPage.contractRate}" data-callback="bt.contractRateCallback">
									</td>
									##即期汇率
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranDeal.wishRate')</td>
									<td>
										<input type="text" data-name="spotRate" data-biz-name="spotRate" data-decimal="6"
											   id="spotRate" autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="bt.spotRateCallback"
											#if($!{fexTranReqPage.tranRateType}=="2") lay-verify="required" #end  value="$!{fexTranReqPage.spotRate}">
									</td>
								</tr>
								<tr>
									<td rowspan="5" width="5%" align="center">#springMessage('table.fexTranReq.tranBuyInfo')</td>
									##买入币种
									<td class="textRight" width="15%">#springMessage('table.fexTranReq.buyCurId')</td>
									<td width="30%">
										<input type="hidden" name="buyCurId" value="$!{fexTranReqPage.buyCurId}"
											   id="buyCurId">
										<input type="text" class="layui-input" value="$!{fexTranReqPage.buyEnglishCode}"
											   id="buyCurName" readonly>
									</td>
									<td rowspan="5" width="5%" align="center">#springMessage(
                                        'table.fexTranReq.tranSellInfo')</td>
									##卖出币种

											   value="$!{fexTranReqPage.purposeDtl}"
											   data-maxlength="50"
											#if($!{fexTranReqPage.purpose}=="005" || $!{fexTranReqPage.purpose}==
												"006" || $!{fexTranReqPage.purpose}=="099")
											   lay-verify="required|strlength"
											#else
											   lay-verify="strlength"
											#end
											   autocomplete="off" class="layui-input"
											   placeholder="#springMessage('table.fexTranReq.purposeDtl')">
									</td>
								</tr>
								<tr>
									##发票号
									<td class="textRight">#springMessage('table.fexForeignReq.invoiceNo')</td>
									<td>
										<div class="layui-input-inline">
											<input type="text" id="invoiceNo" name="invoiceNo"
												   value="$!{fexTranReqPage.invoiceNo}"
												   lay-verify="strlength" data-maxlength="60"
												   autocomplete="off" class="layui-input"
												   placeholder="#springMessage('table.fexForeignReq.invoiceNo')">
										</div>
									</td>
									##交易编码
									<td class="textRight">#springMessage('table.fexTranInfo.tranCode')</td>
									<td>
										<div class="layui-input-inline">
											<input type="hidden" id="tranCode1" name="tranCode1"
												   value="$!{fexTranReqPage.tranCode1}"
												   autocomplete="off" class="layui-input"
												   placeholder="#springMessage('table.fexTranInfo.tranCode')">
											<input type="text" id="tranName1" name="tranName1" lay-verify="tableData"
												   data-biz-name="tranName1" value="$!{fexTranReqPage.tranName1}"
												   autocomplete="off" class="layui-input text"
												   placeholder="#springMessage('table.fexTranInfo.tranCode')">
											<table id="tranCodeTable1" class="hide">
												<thead>
												<tr>
													<th>#springMessage('table.fexTranInfo.tranCode')</th>
													<th>#springMessage('table.fexTranInfo.tranName')</th>
												</tr>
												</thead>
											</table>
										</div>
									</td>
								</tr>
								<tr>
									##联系人
									<td class="textRight" width="20%">#springMessage('table.externalCorp.linkMan')</td>
									<td width="30%">
										<div class="layui-input-inline">
											<input type="text" id="corpContact" name="corpContact"
												   data-biz-name="corpContact" value="$!{fexTranReqPage.corpContact}"
												   autocomplete="off" class="layui-input text" lay-verify="required|strlength" data-maxlength="100"
												   placeholder="#springMessage('table.externalCorp.linkMan')">
											<table id="corpContactTable" class="hide">
												<thead>
												<tr>
													<th>#springMessage('table.externalCorp.linkMan')</th>
													<th>#springMessage('table.externalCorp.tel')</th>
												</tr>
												</thead>
											</table>
										</div>
									</td>
									##电话
									<td class="textRight" width="20%">#springMessage('table.externalCorp.tel')</td>
									<td width="30%">
										<input type="text" id="corpContactTel" name="corpContactTel"
											   value="$!{fexTranReqPage.corpContactTel}"
											   lay-verify="strlength" data-maxlength="50"
											   autocomplete="off" class="layui-input"
											   placeholder="#springMessage('table.externalCorp.tel')">
									</td>
								</tr>
								<tr>
									##交易员
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.dealer')</td>
									<td width="30%">
										<input type="text" id="dealer" name="dealer" data-required="true"
											   value="$!{dealer}" readonly="readonly"
											   autocomplete="off" class="layui-input"
											   placeholder="#springMessage('table.fexTranReq.dealer')">
									</td>
									##交易对手业务编号
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.cotpNo')</td>
									<td width="30%">
										<input type="text" id="cotpNo" name="cotpNo" value="$!{fexTranReqPage.cotpNo}"
											   lay-verify="strlength" data-maxlength="32"
											   autocomplete="off" class="layui-input"
											   placeholder="#springMessage('table.fexTranReq.cotpNo')">
									</td>
								</tr>
								<tr>
									##交易地点
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAddr')</td>
									<td width="30%">
										<div class="layui-input-inline">
											<input id="tranAddrId" name="tranAddrId" type="hidden"
												   value="$!{fexTranReqPage.tranAddrId}">
											<input type="text" id="tranAddr" name="tranAddr" lay-verify="tableData"
												   data-biz-name="tranAddr"
												   autocomplete="off" class="layui-input text"
												   placeholder="#springMessage('table.fexTranReq.tranAddr')"
												   value="$!{fexTranReqPage.tranAddr}">
											<table id="tranAddrTable" class="hide">
												<thead>
												<tr>
													<th>#springMessage('table.tbCreditPeriod.code')</th>
													<th>#springMessage('table.btswiftinfo.namezh')</th>
													<th>#springMessage('table.btswiftinfo.nameen')</th>
												</tr>
												</thead>
											</table>
										</div>
									</td>
									##交易组
									<td class="textRight">#springMessage('table.fexTranReq.tranGroup')</td>
									<td colspan="3">
										<div class="bt-biz-selectType"
											 data-url="${basePath}/foreign/fextrangroup/listTranGroup?tranType=$!{fexTranReqPage.tranType}"
											 data-name="tranGroup" data-biz-name="tranGroup"
											 data-valueField="id" data-textField="groupName"
											 data-value="$!{fexTranReqPage.tranGroup}"></div>
									</td>
								</tr>
								</tbody>
							</table>
						</div>
					</div>
					<div class="layui-colla-item">
						<h2 class="layui-colla-title">#springMessage('cms.loan.OtherInfo')</h2>
						<div class="layui-colla-content layui-show" id="otherInfoDiv">
							<table class="layui-table">
								<tbody>
								<tr>
									##资金来源
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.fundsSource')</td>
									<td width="30%">
										<div class="bt-biz-dict" data-type="select" data-group="fex.tranApp.fundsSource"
											 data-defaultvalue="$!{fexTranReqPage.fundsSource}" data-name="fundsSource"></div>
									</td>
									##结售汇属性
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.fexProp')</td>
									<td width="30%">
										<div class="bt-biz-dict" data-type="select"
											#if($!{fexTranReqPage.fexBusType} == "2")
											 data-group="fex.tranApp.fexProp"
											#else
											 data-group="fex.tranApp.fexProp"
											#end
											 data-defaultvalue="$!{fexTranReqPage.fexProp}" data-name="fexProp"></div>
									</td>
								</tr>
								<tr>
									##附言
									<td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
									<td colspan="3">
										<div class="layui-input-inline">
											<input type="text" id="addWord" name="addWord"
												   value="$!{fexTranReqPage.addWord}"
												   lay-verify="strlength" data-maxlength="100"
												   autocomplete="off" class="layui-input"
												   placeholder="#springMessage('table.nisBillhead.addWord')">
										</div>
									</td>
								</tr>
								<tr>
									##备注
									<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
									<td colspan="3">
                                        <textarea placeholder="#springMessage('bisAccAttribute.rmk')"
												  class="layui-textarea" lay-verify="strlength" data-maxlength="200"
												  style="width:100%" id="rmk"
												  name="rmk">$!{fexTranReqPage.rmk}</textarea>
									</td>
								</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
				<div style="text-align: center; padding-top: 10px;">
					<button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage(
                        'common.button.submit')</button>
					#if($!{isChange}!="1")
						<button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage(
                        'common.button.temp')</button>
					#end
					<button type="reset" class="layui-btn layui-btn-primary"
							data-callback="resetCallBack">#springMessage('common.button.reset')</button>
				</div>
				<!-- 资金计划 -->
				<div id="tagItemDetail"></div>
				<!-- 附件上传 -->
				<input id="attachmentId" name="attachmentId" type="hidden" value="$!{fexTranReqPage.attachmentId}">
				<div id="uploader" class="layui-input-inline" style="width:100%"></div>
			</div>
			<div class="layui-tab-item">
				<table id="appTable" class="layui-table layui-form" style="width:100%;">
					<thead>
					<tr>
						<th>#springMessage('table.fexTranReq.cashFlowDate')</th>
						<th>#springMessage('table.fcSubjectDay.optDate')</th>
						<th>#springMessage('table.fexBankAcc.cashFlowType')</th>
						<th>#springMessage('table.bisAccDtl.curName')</th>
						<th>#springMessage('table.choBankFinance.payMoney')</th>
						<th>#springMessage('table.nisBillhead.corpId')</th>
						<th>#springMessage('common.button.bank')</th>
						<th>#springMessage('table.btBankAccApp.accName')</th>
						<th>#springMessage('table.foreign.bankAcc')</th>
						<th>#springMessage('fex.cotp')</th>
						<th>#springMessage('table.fexTranReq.cotpBank')</th>
						<th>#springMessage('table.fexTranReq.cotpAccName')</th>
						<th>#springMessage('table.fexForeign.cotpAcc')</th>
						<th>#springMessage('table.foreign.voucherType')</th>
					</tr>
					</thead>
					#if(${fexTranReqPage.tranRateType} == "2" || ${fexTranReqPage.fixedMoney.indexOf("1")} > -1)
					<tr id="srcTr">
					#else
					<tr id="srcTr" style="display: none">
					#end
					##现金流日期
					<td align="center">$!{sysDate}</td>
					##结算日期
					<td align="center">
						<div id="srcSettleDateTd">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})</div>
					</td>
					##现金流类型
					<td align="center">
						<div id="srcCashFlowTypeTd">$dictTag.get("fexCorp.cashFlowType","0")</div>
					</td>
					##币种
					<td align="center">
						<div id="srcCurTd">$!{fexTranReqPage.buyEnglishCode}</div>
					</td>
					##金额
					<td align="right">
						<div id="srcPayMoneyTd">$!number.formatNumeric($!{fexTranReqPage.buyMoney})</div>
					</td>
					##单位
					<td align="center">
						<div id="srcCorpTd">$!{fexTranReqPage.corpName}</div>
					</td>
					##银行
					<td align="center">
						<div id="srcBankTd">$!{fexTranReqPage.corpBankName}</div>
					</td>
					##账户名称
					<td align="center">
						<div id="srcAccNameTd">$!{fexTranReqPage.corpAccName}</div>
					</td>
					##银行账户
					<td align="center">
						<div id="srcBankAccTd">$!{fexTranReqPage.corpBankAcc}</div>
					</td>
					##交易对手
					<td align="center">
						<div id="srcCotpTd">$!{fexTranReqPage.cotpName}</div>
					</td>
					##交易对手银行
					<td align="center">
						<div id="srcCotpBankTd">$!{fexTranReqPage.cotpBankName}</div>
					</td>
					##交易对手账户名称
					<td align="center"></td>
					##交易对手银行账户
					<td align="center"></td>
					##支付方式
					<td align="center"></td>
				</tr>
					#if(${fexTranReqPage.tranRateType} == "2" || ${fexTranReqPage.fixedMoney.indexOf("2")} > -1)
					<tr id="targetTr">
					#else
					<tr id="targetTr" style="display: none">
					#end
					<td align="center">$!{sysDate}</td>
					<td align="center">
						<div id="targetSettleDateTd">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})</div>
					</td>
					<td align="center">
						<div id="targetCashFlowTypeTd">$dictTag.get("fexCorp.cashFlowType","0")</div>
					</td>
					<td align="center">
						<div id="targetCurTd">$!{fexTranReqPage.sellEnglishCode}</div>
					</td>
					<td align="right">
						<div id="targetPayMoneyTd">-$!number.formatNumeric($!{fexTranReqPage.sellMoney})</div>
					</td>
					<td align="center">
						<div id="targetCorpTd">$!{fexTranReqPage.corpName}</div>
					</td>
					<td align="center">
						<div id="targetBankTd">$!{fexTranReqPage.srcBankName}</div>
					</td>
					<td align="center">
						<div id="targetAccNameTd">$!{fexTranReqPage.srcAccName}</div>
					</td>
					<td align="center">
						<div id="targetBankAccTd">$!{fexTranReqPage.srcBankAcc}</div>
					</td>
					<td align="center">
						<div id="targetCotpTd">$!{fexTranReqPage.cotpName}</div>
					</td>
					<td align="center">
						<div id="targetCotpBankTd">$!{fexTranReqPage.cotpBankName}</div>
					</td>
					##交易对手账户名称
					<td align="center"></td>
					##交易对手银行账户
					<td align="center"></td>
					##支付方式
					<td align="center"></td>
				</tr>
				</table>
			</div>
			<div class="layui-tab-item">
				<!-- 自定义信息 -->
				<div id="custMsg"></div>
			</div>
		</div>
	</div>
	#caDataHidden()
</form>
	#parse("views/common/footer.vm")
	#caDataScript()
</body>
</html>

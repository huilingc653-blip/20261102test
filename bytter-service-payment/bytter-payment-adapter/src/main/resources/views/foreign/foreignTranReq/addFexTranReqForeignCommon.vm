#parse("views/common/head.vm")
<style>
    .boodDiv{
        display: none;
    }
</style>
<!--买入方账户信息-->
<!-- 主体单位账户信息 -->
<input type="hidden" id="corpBank$!{swapType}" name="corpBank$!{swapType}" value="">
<input type="hidden" id="corpAccId$!{swapType}" name="corpAccId$!{swapType}" value="">
#*<input type="hidden" id="corpBankAcc$!{swapType}" name="corpBankAcc$!{swapType}" value="">*#
<input type="hidden" id="corpAccName$!{swapType}" name="corpAccName$!{swapType}" value="">
<!-- 交易对手账户信息 -->
<input type="hidden" id="cotpBank$!{swapType}" name="cotpBank$!{swapType}" value="">
<input type="hidden" id="cotpAccId$!{swapType}" name="cotpAccId$!{swapType}" value="">
<input type="hidden" id="cotpBankAcc$!{swapType}" name="cotpBankAcc$!{swapType}" value="">
<input type="hidden" id="cotpAccName$!{swapType}" name="cotpAccName$!{swapType}" value="">
<!--卖出方账户信息-->
<input type="hidden" id="srcBank$!{swapType}" name="srcBank$!{swapType}" value="">
<input type="hidden" id="srcAccId$!{swapType}" name="srcAccId$!{swapType}" value="">
#*<input type="hidden" id="srcBankAcc$!{swapType}" name="srcBankAcc$!{swapType}" value="">*#
<input type="hidden" id="srcAccName$!{swapType}" name="srcAccName$!{swapType}" value="">
<input type="hidden" id="targetBank$!{swapType}" name="targetBank$!{swapType}" value="">
<input type="hidden" id="targetAccId$!{swapType}" name="targetAccId$!{swapType}" value="">
<input type="hidden" id="targetBankAcc$!{swapType}" name="targetBankAcc$!{swapType}" value="">
<input type="hidden" id="targetAccName$!{swapType}" name="targetAccName$!{swapType}" value="">

<input type="hidden" id="swapType$!{swapType}" name="swapType$!{swapType}" value="$!{swapType}">
<input type="hidden" id="isAsk$!{swapType}" name="isAsk$!{swapType}" value="0">
##汇款类型
<input type="hidden" name="remitType$!{swapType}" value="0">
##跨行标志
<input type="hidden" name="difBank$!{swapType}" value="0">

<input id="exposureBusType$!{swapType}" name="exposureBusType$!{swapType}" type="hidden" value="">

<div class="layui-collapse">
    <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranProductInfo')</h2>
        <div class="layui-colla-content layui-show">
            <table class="layui-table">
                <tbody>
                <tr>
                    ##外汇交易类型
                    <td class="textRight" width="20%">#springMessage('table.fexProduct.fexTranType')</td>
                    #if($!{type}=="swap")
                        <td width="30%">
                            <input id="fexTranType$!{swapType}" name="fexTranType$!{swapType}" type="hidden"
                                #if($!{swapType}=="1") value="0" #else value="1"  #end" />
                            <div class="bt-biz-dict" data-type="radio"
                                #if($!{swapType}=="1") data-defaultvalue="0" #else data-defaultvalue="1"  #end
                                data-group="fexTranDeal.swapFexTranType" data-required="true" data-name="swapFexTranType$!{swapType}"
                                data-biz-name="swapFexTranType$!{swapType}" data-callback="bt.swapFexTranTypeCallback$!{swapType}"></div>
                        </td>
                    #else
                        <td width="30%">
                            <input id="fexTranType$!{swapType}" name="fexTranType$!{swapType}" type="hidden" value="">
                            <div class="fexTranTypeDiv$!{swapType}"></div>
                        </td>
                    #end

                    ##外汇业务类型
                    <td class="textRight" width="20%">#springMessage('table.fexProduct.fexBusType')</td>
                    <td width="30%">
                        <input type="hidden" id="fexBusType$!{swapType}" name="fexBusType$!{swapType}" value="">
                        <div id="fexBusTypeDiv$!{swapType}" name="fexBusTypeDiv$!{swapType}"></div>
                    </td>
                </tr>
                <tr>
                    ##结汇业务类型
                    <td class="textRight" width="20%" id="settleBusTypeTd$!{swapType}" >#springMessage('fex.tran.settleBusType')</td>
                    <td width="30%" id="settleBusTypeDiv$!{swapType}">
                        <div >
                            <div class="bt-biz-dict" data-type="select" data-group="fex.tran.settleBusType" data-name="settleBusType$!{swapType}" data-biz-name="settleBusType$!{swapType}"></div>
                        </div>
                    </td>
                    ##交割类型
                    <td class="textRight" width="20%">#springMessage('table.fexProduct.deliveryType')</td>
                    <td width="30%">
                        <input type="hidden" id="deliveryType$!{swapType}" name="deliveryType$!{swapType}" value="0">
                        <div id="deliveryTypeDiv$!{swapType}" name="deliveryTypeDiv$!{swapType}"></div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
        <div class="layui-colla-content layui-show">
            <table class="layui-table">
                <tbody>
                    <tr>
                        ##交易对手银行
                        <td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.cotpBank')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="hidden" id="cotpId$!{swapType}" name="cotpId$!{swapType}" autocomplete="off" class="layui-input">
                                <input type="text" id="cotpName$!{swapType}" name="cotpName$!{swapType}" lay-verify="required" readonly="readonly" class="layui-input">
                                ##交易对手银行
                                <div class="bt-div-search">
                                    <button class="bt-biz-allBankInfo" id="selCoptBankBut" type="button" data-callback="bt.cotpBankCallback$!{swapType}" title="#springMessage('common.button.select')">
                                        <i class="layui-icon">&#xe615;</i>
                                    </button>
                                </div>
                            </div>
                        </td>
                        ##交易对手SWIFT Code
                        <td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.cotpBank')#springMessage('table.btswiftinfo.swiftCode')</td>
                        <td>
                            <div id="cotpBicCodeDiv$!{swapType}" name="cotpBicCodeDiv$!{swapType}"></div>
                            <input type="hidden" id="cotpBicCode$!{swapType}" name="cotpBicCode$!{swapType}" value="">
                        </td>
                    </tr>
                    <tr>
                        ##交易货币对
                        <td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.currencyPairs')</td>
                        <td width="30%">
                            #if($!{swapType}=="2")
                                <div class="layui-input-inline">
                                    <div class="bt-biz-selectType" data-biz-name="tranCurPairId$!{swapType}"
                                         data-url="${basePath}/basic/business/btcurrencypair/json"
                                         data-valuefield="id" data-textfield="pairCode"
                                         data-name="tranCurPairId$!{swapType}"
                                         data-required="true"
                                         data-defaultvalue=""></div>
                                </div>
                            #else
                                <div class="layui-input-inline">
                                    <div class="bt-biz-selectType" data-biz-name="tranCurPairId$!{swapType}"
                                         data-url="${basePath}/basic/business/btcurrencypair/json"
                                         data-valuefield="id" data-textfield="pairCode"
                                         data-name="tranCurPairId$!{swapType}"
                                         data-required="true"
                                         data-callback="bt.currencyPairCallback"
                                         data-defaultvalue=""></div>
                                </div>
                            #end
                            <input type="hidden" name="tranCurPairBaseId$!{swapType}" id="tranCurPairBaseId$!{swapType}" value="">
                            <input type="hidden" name="tranCurPairReferId$!{swapType}" id="tranCurPairReferId$!{swapType}" value="">
                        </td>
                        ##买卖方向
                        <td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp2.businessDirection')</td>
                        <td width="30%">
                            #if($!{swapType}=="2")
                                <div class="layui-input-inline">
                                    <div class="bt-biz-dict" data-type="radio" data-defaultvalue="" data-disabled="true"
                                         data-group="fexTranDeal.deliverySign" data-required="true" data-name="busDirection$!{swapType}"
                                         data-biz-name="busDirection$!{swapType}"></div>
                                </div>
                            #else
                                <div class="layui-input-inline">
                                    <div class="bt-biz-dict" data-type="radio" data-defaultvalue=""
                                         data-group="fexTranDeal.deliverySign" data-required="true"
                                         data-name="busDirection$!{swapType}" data-callback="bt.busDirectionCallback$!{swapType}"
                                         data-biz-name="busDirection$!{swapType}"></div>
                                </div>
                            #end
                        </td>
                    </tr>
                    <tr>
                        ##报价方式
                        <td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.quotationMethod')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" id="quotationMethod$!{swapType}" name="quotationMethod$!{swapType}"
                                       value="" class="layui-input"
                                       readonly/>
                            </div>
                            <input type="hidden" name="quotationCurId$!{swapType}" id="quotationCurId$!{swapType}" value="">
                            <input type="hidden" name="quotationReferCurId$!{swapType}" id="quotationReferCurId$!{swapType}" value="">
                            <div class="layui-input-inline" id="quotationMethodDesc$!{swapType}"
                                 style="color: red;display: none;width: 200px">
                                交易货币对在外汇牌价查询的外汇牌价类型$!{rateTypeName}中无报价，请先在外汇牌价查询中录入
                            </div>
                        </td>
                        ##  金额是否自动计算
                        <td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.isAutoCalculate')</td>
                        <td width="30%">
                            <div class="bt-biz-dict" data-type="radio"
                                 data-group="fexTranDeal.isAutoCalculate" data-required="true" data-name="isPaymentAmount$!{swapType}"
                                 data-biz-name="isPaymentAmount$!{swapType}" data-callback="bt.isAutoCalculateCallBack$!{swapType}" data-defaultvalue="1"></div>
                        </td>
                    </tr>
                    <tr>
                        ##固定金额
                        <td class="textRight" colspan="2" width="20%"><div>#springMessage('fex.tranApp.FixedAmount')</div></td>
                        <td width="30%">
                            #if($!{swapType}=="2")
                                <div class="fixedMoneyDiv$!{swapType}">
                                    <div class="bt-biz-dict" data-type="radio" readonly="true"  data-group="fex.tranApp.fixMoney" data-required="true"
                                         data-name="fixedMoney$!{swapType}" data-biz-name="fixedMoney$!{swapType}" data-disabled="true"
                                         id="fixedMoney$!{swapType}"></div>
                                </div>
                            #else
                                <div class="fixedMoneyDiv$!{swapType}">
                                    <div class="bt-biz-dict" data-type="radio"  data-group="fex.tranApp.fixMoney" data-required="true"
                                         data-name="fixedMoney$!{swapType}" data-biz-name="fixedMoney$!{swapType}"
                                         data-callback="bt.fixMoneyCallback$!{swapType}" id="fixedMoney$!{swapType}"></div>
                                </div>
                            #end

                        </td>
                        ## 交易汇率类型cotpId
                        <td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.transExchangeRateType')</td>
                        <td width="30%">
                            <div class="bt-biz-dict" data-type="select" data-group="fexTranReq.transExchangeRateType" data-defaultvalue="2"
                                 data-name="tranRateType$!{swapType}"
                                #if($!{swapType}=="2") data-disabled="true" #end
                                 data-biz-name="tranRateType$!{swapType}" data-required = "true"
                                 data-callback="bt.transExchangeRateType$!{swapType}"></div>
                        </td>
                    </tr>
                    <tr>
                        ##合同汇率
                        <td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.contractRate')</td>
                        <td>
                            <input type="text" data-name="contractRate$!{swapType}" data-biz-name="contractRate$!{swapType}"
                                   data-decimal="6" lay-verify="required" data-callback="bt.contractRateCallback$!{swapType}"
                                   id="contractRate$!{swapType}" autocomplete="off" class="layui-input bt-biz-moneyType"
                                   data-callback="bt.contractRateCallback$!{swapType}">
                        </td>
                        ##即期汇率
                        <td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranDeal.wishRate')</td>
                        <td>
                            #if($!{type}=="spot")
                                <input type="text" data-name="spotRate$!{swapType}" data-biz-name="spotRate$!{swapType}" data-decimal="6"
                                       lay-verify="required" id="spotRate$!{swapType}" autocomplete="off" class="layui-input bt-biz-moneyType"
                                       placeholder="#springMessage('table.fexTranDeal.wishRate')" data-callback="bt.spotRateCallback$!{swapType}">
                            #else
                                <input type="text" data-name="spotRate$!{swapType}" data-biz-name="spotRate$!{swapType}" data-decimal="6"
                                       id="spotRate$!{swapType}" autocomplete="off" class="layui-input bt-biz-moneyType"
                                       placeholder="#springMessage('table.fexTranDeal.wishRate')">
                            #end

                        </td>
                    </tr>
                    <tr>
                        <td rowspan="5" width="5%" align="center">#springMessage('table.fexTranReq.tranBuyInfo')</td>
                        ##买入币种
                        <td class="textRight" width="15%">#springMessage('table.fexTranReq.buyCurId')</td>
                        <td width="30%">
                            <input type="hidden" name="buyCurId$!{swapType}" value="" id="buyCurId$!{swapType}">
                            <input type="text" class="layui-input" value="" id="buyCurName$!{swapType}" readonly>
                        </td>
                        <td rowspan="5" width="5%" align="center">#springMessage('table.fexTranReq.tranSellInfo')</td>
                        ##卖出币种
                        <td class="textRight" width="15%">#springMessage('table.fexTranReq.sellCurId')</td>
                        <td width="30%">
                            <input type="hidden" name="sellCurId$!{swapType}" value="" id="sellCurId$!{swapType}">
                            <input type="text" class="layui-input" value="" id="sellCurName$!{swapType}" readonly>
                        </td>
                    </tr>
                    <tr>
                        ##买入金额
                        <td class="textRight" width="15%">#springMessage('table.fexTranReq.buyMoney')</td>
                        <td width="30%">
                            <input type="text" id="buyMoney$!{swapType}" name="buyMoney$!{swapType}" style="text-align:right" data-name="buyMoney$!{swapType}" data-biz-name="buyMoney$!{swapType}"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.buyMoney')"
                                   lay-verify="required" data-callback="bt.buyMoneyCallback$!{swapType}">
                        </td>
                        ##卖出金额
                        <td class="textRight" width="15%">#springMessage('table.fexTranReq.sellMoney')</td>
                        <td width="30%">
                            <input type="hidden" id="budget$!{swapType}" name="budget$!{swapType}">
                            <input type="text" id="sellMoney$!{swapType}" name="sellMoney$!{swapType}" style="text-align:right" data-name="sellMoney$!{swapType}" data-biz-name="sellMoney$!{swapType}"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.sellMoney')"
                                   lay-verify="required" data-callback="bt.sellMoneyCallback$!{swapType}">
                        </td>
                    </tr>
                    <tr>
                        ##收款账号
                        <td class="textRight" width="15%">#springMessage('table.nisBillhead.payeeAcc')</td>
                        <td width="30%">
                            <input type="text" id="corpBankAcc$!{swapType}" name="corpBankAcc$!{swapType}" lay-verify="required|tableData" data-biz-name="corpBankAcc$!{swapType}"
                                   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.payeeAcc')" data-swapType="$!{swapType}">
                            <table id="corpBankAccTable$!{swapType}" class="hide">
                                <thead>
                                <tr>
                                    <th>#springMessage('table.choBankFinance.acc')</th>
                                    <th>#springMessage('table.btBankAccApp.accName')</th>
                                    <th>#springMessage('table.btBankAcc.bankName')</th>
                                    <th>#springMessage('table.nisBillhead.curId')</th>
                                </tr>
                                </thead>
                            </table>
                        </td>
                        ##付款账号
                        <td class="textRight" width="15%">#springMessage('table.nisBillhead.payerAcc')</td>
                        <td width="30%">
                            <input type="text" id="srcBankAcc$!{swapType}" name="srcBankAcc$!{swapType}" lay-verify="required|tableData" data-biz-name="srcBankAcc$!{swapType}"
                                   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.payerAcc')" data-swapType="$!{swapType}">
                            <table id="srcBankAccTable$!{swapType}" class="hide">
                                <thead>
                                <tr>
                                    <th>#springMessage('table.choBankFinance.acc')</th>
                                    <th>#springMessage('table.btBankAccApp.accName')</th>
                                    <th>#springMessage('table.btBankAcc.bankName')</th>
                                    <th>#springMessage('table.nisBillhead.curId')</th>
                                </tr>
                                </thead>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        ##收款账户银行
                        <td class="textRight" width="15%">#springMessage('table.fexTranReq.payeeAccBank')</td>
                        <td width="30%">
                            <div id="corpBankNameDiv$!{swapType}" name="corpBankNameDiv$!{swapType}"></div>
                        </td>
                        ##付款账户银行
                        <td class="textRight" width="15%">#springMessage('table.fexTranReq.payerAccBank')</td>
                        <td width="30%">
                            <div id="srcBankNameDiv$!{swapType}" name="srcBankNameDiv$!{swapType}"></div>
                        </td>
                    </tr>
                        ##swiftCode
                    <tr>
                        ##收款账户银行SWIFT CODE
                        <td class="textRight" width="15%">#springMessage('table.fexTranReq.payeeAccBank')#springMessage('table.btswiftinfo.swiftCode')</td>
                        <td width="30%">
                            <div id="corpBankAccSwiftCodeDiv$!{swapType}" name="corpBankAccSwiftCodeDiv$!{swapType}"></div>
                        </td>
                        ##付款账户银行SWIFT CODE
                        <td class="textRight" width="15%">#springMessage('table.fexTranReq.payerAccBank')#springMessage('table.btswiftinfo.swiftCode')</td>
                        <td width="30%">
                            <div id="srcBankAccSwiftCodeDiv$!{swapType}" name="srcBankAccSwiftCodeDiv$!{swapType}"></div>
                        </td>
                    </tr>
                    <tr>
                        #if($!{type}=="spot")
                            ##钞汇标识
                            <td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.bankNote')</td>
                            <td>
                                <div class="bt-biz-dict" data-type="radio" data-group="fex.tranApp.bankNote" data-defaultvalue="2"
                                     data-name="bankNote$!{swapType}" data-biz-name="bankNote$!{swapType}"
                                     data-required = "true" data-callback="bt.bankNoteCallback$!{swapType}"></div>
                            </td>
                        #end
                        ##交易日期
                        <td class="textRight" colspan="2" width="20%">#springMessage('table.revenue.transTime')</td>
                        <td >
                            <input type="text" name="tranDate$!{swapType}" lay-verify="required" class="layui-input bt-biz-dateType"
                                   data-endid="settleDate$!{swapType}" data-today="true"  data-type="date"
                                   data-name="tranDate$!{swapType}" data-biz-name="tranDate$!{swapType}" data-callback="bt.tranDateCallback$!{swapType}">
                        </td>
                    </tr>
                    <tr>
                        ##结算日期
                        <td class="textRight" colspan="2" width="20%">#springMessage('table.fcSubjectDay.optDate')</td>
                        <td >
                            <input type="text" id="settleDate$!{swapType}" name="settleDate$!{swapType}" lay-verify="required" class="layui-input bt-biz-dateType"
                                   data-today="true" data-type="date" data-name="settleDate$!{swapType}" data-biz-name="settleDate$!{swapType}" data-callback="settleDateCallback$!{swapType}">
                        </td>
                        ##交割期限
                        <td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.deliveryDeadline')</td>
                        <td>
                            <input type="hidden" id="deliveryDeadline$!{swapType}" name="deliveryDeadline$!{swapType}" value="0">
                            <div id="deliveryDeadlineDiv$!{swapType}" name="deliveryDeadlineDiv$!{swapType}">T+0</div>
                        </td>
                    </tr>
                    <tr>
                        ##申请日期
                        <td class="textRight" colspan="2" width="20%">#springMessage('table.bisFinanceExc.reqDate')</td>
                        <td width="30%">$!{sysDate}</td>
                        ##资金性质
                        <td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.accNature')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="select" data-group="fexTranReq.accNature" data-defaultvalue="1" data-name="accNature$!{swapType}" data-biz-name="accNature$!{swapType}" data-required = "true" data-callback="bt.accNatureCallback$!{swapType}"></div>
                        </td>
                    </tr>
                    <tr>
                        #if($!{type} != "swap")
                            ##是否线下付款
                            <td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.isPayed')</td>
                            <td width="30%">
                                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isPayed$!{swapType}" data-biz-name="isPayed$!{swapType}"data-required = "true"></div>
                            </td>
                        #end
                        ##持仓金额
                        <td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.positionMoney')</td>
                        <td width="30%">
                            <input type="text" id="positionMoney$!{swapType}" name="positionMoney$!{swapType}" style="text-align:right"
                                   readonly data-name="positionMoney$!{swapType}" data-biz-name="positionMoney$!{swapType}"
                                   autocomplete="off" class="layui-input bt-biz-moneyType">
                        </td>
                    </tr>
                    <tr id="bankPayTypeTr$!{swapType}" style="display: none">
                        ##支付类型
                        <td class="textRight" colspan="2" width="20%" id="bankPayTypeTd$!{swapType}">#springMessage('table.nisBillhead.bankPayType')</td>
                        <td width="30%">
                            <div class="bankPayTypeDiv$!{swapType}" class="layui-input-inline">
                                <div class="bt-biz-selectType" data-url="" data-name="bankPayType$!{swapType}" data-biz-name="bankPayType$!{swapType}" data-beforeinit="customBeforeInit"
                                     data-valuefield="customCode" data-textfield="customName" data-inputvalue="inputvalue" data-search="true"  data-callback="bt.bankPayTypeCallback$!{swapType}"></div>
                            </div>
                        </td>
                        <td class="textRight"  width="20%"></td>
                        <td width="30%"></td>
                    </tr>
                    #if($!{type}=="spot")
                        <tr id = "profitLossTr" style="display: none">
                            ##损益币种
                            <td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.profitLossCur')</td>
                            <td width="30%">
                                <div class="bt-biz-selectType"
                                     data-url="${basePath}/basic/business/btcurrency/json"
                                    data-defaultvalue="$!{fexTranReqPage.profitLossCur}" data-callback="bt.profitLossCurCallback$!{swapType}"

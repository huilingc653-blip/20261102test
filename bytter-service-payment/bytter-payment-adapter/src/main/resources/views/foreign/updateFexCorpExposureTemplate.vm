<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	<style>
		.timeType .layui-input {
			width: 100%;
		}
	</style>
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fexCorpExposureTemplatePage.id}">
		<input id="createBy" name="createBy" type="hidden" value="$!{fexCorpExposureTemplatePage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{fexCorpExposureTemplatePage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fexCorpExposureTemplatePage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{fexCorpExposureTemplatePage.updateDate}">
        <table class="layui-table">
			<tbody >
				<tr>
					##单位
					<td class="textRight" width="20%">#springMessage('table.nisBillhead.corpId')</td>
					<td width="30%">
						<div class="layui-input-inline">
							<div class="bt-biz-corp"
								 data-biz-type="corp"
								 data-type="selectTree"
								 data-name="corpId"
								 data-biz-name="corpId"
								 data-scope="all"
								 data-resource="foreign:fexcorpexposuretemplate:apply"
								 data-defaultvalue="$!{fexCorpExposureTemplatePage.corpId}"
								 data-required="true"></div>
						</div>
					</td>
					##币种
					<td class="textRight" width="20%">#springMessage('table.nisBillhead.curId')</td>
					<td width="30%">
						<div class="layui-input-inline">
						<div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrency/json" data-method="get" data-name ="curId" data-biz-name ="curId"
							 data-valueField="id" data-textField="englishCode" data-inputvalue="inputvalue" data-search="true" data-required = "true"
							 data-defaultvalue="$!{fexCorpExposureTemplatePage.curId}"></div>
						</div>
					</td>
                </tr>
                <tr>
					##敞口模板
					<td class="textRight">#springMessage('table.fexExposureTemplate.templateInfo')</td>
					<td>
						<input type="hidden" id="templateIdDef" value="$!{fexCorpExposureTemplatePage.templateId}">
						<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexExposureTemplate/json" data-name ="templateId" data-biz-name ="templateId"
							 data-valueField="id" data-textField="templateName" data-required = "true" data-callback="bt.templateCallback" data-beforeInit="templateBeforeInit"
							 data-defaultvalue="$!{fexCorpExposureTemplatePage.templateId}"></div>
					</td>
					##有效标志 0 无效 1 有效
					<td class="textRight">#springMessage('fcVoucherType.validSign')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="$!{fexCorpExposureTemplatePage.validSign}" data-required="true"
							 data-name="validSign" data-biz-name="validSign"></div>
                    </td>
                </tr>
    			<tr >
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>

		<!-- 敞口模板 -->
		<div id="tagTemplate"></div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexCorpExposureTemplate.edit.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
<form class="layui-form" method="post">
<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
	<ul class="layui-tab-title">
		<li class="layui-this">#springMessage('table.rasBackQuery.msg')</li>
		<li>#springMessage('table.fexTranReq.cashFlow')</li>
		<li>#springMessage('fex.cotp.customInformation')</li>
	</ul>
	<div class="layui-tab-content">
		<div class="layui-tab-item layui-show">
			<input id="createBy" name="createBy" type="hidden" value="$!{fexTranReqPage.createBy}">
			<input id="createDate" name="createDate" type="hidden" value="$!{fexTranReqPage.createDate}">
			<input id="updateBy" name="updateBy" type="hidden" value="$!{fexTranReqPage.updateBy}">
			<input id="updateDate" name="updateDate" type="hidden" value="$!{fexTranReqPage.updateDate}">
			<input id="id" name="id" type="hidden" value="$!{fexTranReqPage.id}">
			<input id="tranType" name="tranType" type="hidden" value="$!{fexTranReqPage.tranType}">
			<input id="status" name="status" type="hidden" value="$!{fexTranReqPage.status}">
			<input id="billNo" name="billNo" type="hidden" value="$!{fexTranReqPage.billNo}">
			<input id="billFrom" name="billFrom" type="hidden" value="$!{fexTranReqPage.billFrom}">
			<!-- 系统参数 -->
			<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
			<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
			<!-- 资金计划参数 明细项控制模式-->
			<input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
			<input id="settlType" name="settlType" type="hidden" value="0">
			<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
			<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
			<input id="cloneFlag" name="cloneFlag" type="hidden" value="$!{fexTranReqPage.cloneFlag}">
			#if($!{fexTranReqPage.cloneFlag} != "1")
            <table class="layui-table">
                <tbody>
                <tr>
                	##交易号码
                    <td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
                    <td colspan="3">$!{fexTranReqPage.billNo}</td>
                </tr>
                </tbody>
            </table>
			#end
			<div class="layui-collapse">
			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
						<tr>
							##产品
							<td class="textRight" width="20%">#springMessage('table.foreign.product')</td>
							<td width="30%">
								<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProduct/$!{fexTranReqPage.tranType}" data-name ="proId" data-biz-name ="proId"
									 data-valueField="id" data-textField="proName" data-required = "true" data-value="$!{fexTranReqPage.proId}" data-callback="bt.proCallback"></div>
							</td>
							##汇款类型
							<td class="textRight" width="20%">#springMessage('table.fexForeignReq.remitType')</td>
							<td width="30%">
								<div class="bt-biz-dict" data-type="select" data-group="fexForeignReq.remitType" data-defaultvalue="$!{fexTranReqPage.remitType}" data-name="remitType" data-biz-name="remitType" data-required = "true" data-callback="bt.remitTypeCallback"></div>
							</td>
						</tr>
						</tbody>
					</table>
				</div>
			</div>

			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranMainInfo')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
                        <tr>
                            <td rowspan="14" width="3%" align="center">#springMessage('table.nisAllocationReq.payerInfo')</td>
                            ##付款方-单位
                            <td class="textRight" width="17%">#springMessage('table.fbsBudget.corpId')</td>
                            <td width="30%">
                                <input type="hidden" id="corpIdDef" value="$!{fexTranReqPage.corpId}">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-corp"
                                         data-biz-type="corp"
                                         data-type="selectTree"
                                         data-name="corpId"
                                         data-biz-name="corpId"
                                         data-scope="all"
                                         data-resource="foreign:fextranreq:allocation:apply"
                                         data-required="true"
                                         data-callback="bt.corpCallback"
                                         data-defaultvalue="$!{fexTranReqPage.corpId}"></div>
                                </div>
                            </td>
                            <td rowspan="14" width="3%" align="center">#springMessage('table.nisAllocationReq.payeeInfo')</td>
                            ##收款方-单位
                            <td class="textRight" width="17%">#springMessage('table.fbsBudget.corpId')</td>
                            <td width="30%">
                                <input type="hidden" id="targetCorpDef" value="$!{fexTranReqPage.targetCorp}">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-corp"
                                         data-biz-type="corp"
                                         data-type="selectTree"
                                         data-name="targetCorp"
                                         data-biz-name="targetCorp"
                                         data-scope="all"
                                         data-required="true"
                                         data-callback="bt.targetCorpCallback"
                                         data-defaultvalue="$!{fexTranReqPage.targetCorp}"></div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##付款方-银行账户
                            <td class="textRight" width="17%">#springMessage('table.fexForeign.bankAcc')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    <input type="text" id="srcBankAcc" name="srcBankAcc" lay-verify="required|tableData" data-biz-name="srcBankAcc"
                                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexForeign.bankAcc')" value="$!{fexTranReqPage.srcBankAcc}">
                                    <table id="srcBankAccTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.choBankFinance.acc')</th>
                                            <th>#springMessage('table.btBankAccApp.accName')</th>
                                            <th>#springMessage('table.btBankAcc.bankName')</th>
                                            <th>#springMessage('table.nisBillhead.curId')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </div>
                            </td>
                            ##收款方-银行账户
                            <td class="textRight" width="17%">#springMessage('table.fexForeign.bankAcc')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    <input type="text" id="targetBankAcc" name="targetBankAcc" lay-verify="required|tableData" data-biz-name="targetBankAcc"
                                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexForeign.bankAcc')" value="$!{fexTranReqPage.targetBankAcc}">
                                    <table id="targetBankAccTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.choBankFinance.acc')</th>
                                            <th>#springMessage('table.btBankAccApp.accName')</th>
                                            <th>#springMessage('table.btBankAcc.bankName')</th>
                                            <th>#springMessage('table.nisBillhead.curId')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##付款方-账户名称
                            <td class="textRight" width="17%">#springMessage('table.btBankAccApp.accName')</td>
                            <td>
                                <input type="hidden" id="srcAccId" name="srcAccId" value="$!{fexTranReqPage.srcAccId}">
                                <input type="hidden" id="srcAccName" name="srcAccName" value="$!{fexTranReqPage.srcAccName}">
                                <div id="srcAccNameDiv" name="srcAccNameDiv">$!{fexTranReqPage.srcAccName}</div>
                            </td>
                            ##收款方-账户名称
                            <td class="textRight" width="17%">#springMessage('table.btBankAccApp.accName')</td>
                            <td>
                                <input type="hidden" id="targetAccId" name="targetAccId" value="$!{fexTranReqPage.targetAccId}">
                                <input type="hidden" id="targetAccName" name="targetAccName" value="$!{fexTranReqPage.targetAccName}">
                                <div id="targetAccNameDiv" name="targetAccNameDiv">$!{fexTranReqPage.targetAccName}</div>
                            </td>
                        </tr>
						<tr>
							##付款方-账户币种
							<td class="textRight">#springMessage('table.fexForeign.cotpCurName')</td>
							<td>
								<input type="hidden" id="curId" name="curId" value="$!{fexTranReqPage.curId}">
								<div id="curNameDiv" name="curNameDiv">$!{fexTranReqPage.englishCode}</div>
							</td>
							##收款方-账户币种
							<td class="textRight">#springMessage('table.fexForeign.cotpCurName')</td>
							<td>
								<input type="hidden" id="targetAccCurId" name="targetAccCurId" value="$!{fexTranReqPage.targetAccCurId}">
								<div id="targetAccCurNameDiv" name="targetAccCurNameDiv">$!{fexTranReqPage.targetAccEnglishCode}</div>
							</td>
						</tr>
						<tr>
							##付款方-银行
							<td class="textRight" width="17%">#springMessage('common.button.bank')</td>
							<td width="30%">
                                <input type="hidden" id="srcBank" name="srcBank" value="$!{fexTranReqPage.srcBank}">
								<input type="hidden" id="srcIsDomesticBank" name="srcIsDomesticBank" value="$!{payerAcc.isDomesticBank}">
								<input type="hidden" id="srcCountryId" name="srcCountryId" value="$!{payerAcc.prov}">
								<input type="hidden" id="srcBifCode" name="srcBifCode" value="$!{payerAcc.bifCode}">
								<div id="srcBankNameDiv" name="srcBankNameDiv">$!{fexTranReqPage.srcBankName}</div>
							</td>
							##收款人地址
							<td class="textRight">#springMessage('table.fexForeignReq.payeeAdd')</td>
							<td>
								<div id="targetAddrDiv" name="targetAddrDiv">$!{fexTranReqPage.targetAddr}</div>
							</td>
						</tr>
						<tr>
							##汇款方式
							<td class="textRight">#springMessage('table.fexForeignReq.remitMethod')</td>
							<td>
								<div class="bt-biz-dict" data-type="select" data-group="fexForeignReq.remitMethod" data-defaultvalue="$!{fexTranReqPage.remitMethod}" data-name="remitMethod" data-biz-name="remitMethod" data-required = "true"></div>
							</td>
							##收款人所在国家地区&地点
							<td class="textRight" width="15%">#springMessage('table.fexTranReq.payeeCountry')&#springMessage('fex.cotp.place')</td>
							<td width="30%">
								#*<div id="nameZhDiv" name="nameZhDiv">$!{fexTranReqPage.cotpCountry}</div>*#
								<div class="layui-input-inline">
									<div class="bt-biz-selectType"
										#if($!{fexTranReqPage.srcBankName} == "中国银行" && $!{fexTranReqPage.remitMethod} == "2")
										 data-required="true"
										#end
										 data-callback="bt.cotpCountryCallBack" data-biz-name="cotpCountry" data-value="$!{fexTranReqPage.cotpCountry}" data-url="${basePath}/basic/business/syscountrycust/listSysCountryCust" data-valuefield="id" data-textfield="nameZh" data-name="cotpCountry"></div>
								</div>
								<div class="layui-input-inline" id="addressDiv" #if($!{fexTranReqPage.cotpCountryName} == "中国")style="display: none"#end>
									<div class="bt-biz-selectType"
										#if($!{fexTranReqPage.srcBankName} == "中国银行" && $!{fexTranReqPage.remitMethod} == "2" && $!{fexTranReqPage.cotpCountryName} != "中国")
										 data-required="true"
										#end
										 data-biz-name="cotpAddress" data-value="$!{fexTranReqPage.cotpAddress}"
										#if($!{fexTranReqPage.cotpCountry})
										 	data-url="${basePath}/basic/business/syscountrycust/listSysCountryArea/$!{fexTranReqPage.cotpCountry}"
										 #end
										 data-valuefield="id" data-textfield="nameZh" data-name="cotpAddress"></div>
								</div>
								<div class="layui-input-inline" id="addrDiv" #if($!{fexTranReqPage.cotpCountryName} != "中国")style="display: none"#end>
									<div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="cotpProv" data-biz-name="cotpProv" data-change="cotpCity" data-defaultvalue="$!{fexTranReqPage.cotpProv}"
										#if($!{fexTranReqPage.srcBankName} == "中国银行" && $!{fexTranReqPage.remitMethod} == "2" && $!{fexTranReqPage.cotpCountryName} == "中国")
										 data-required="true"
										#end
										 data-callback="bt.provCallback"></div>
									<div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="cotpCity" data-biz-name="cotpCity" data-defaultvalue="$!{fexTranReqPage.cotpCity}"
										#if($!{fexTranReqPage.srcBankName} == "中国银行" && $!{fexTranReqPage.remitMethod} == "2" && $!{fexTranReqPage.cotpCountryName} == "中国")
										 data-required="true"
										#end
										 data-callback="bt.cityCallback"></div>
								</div>
							</td>
						</tr>
						<tr>
							##交易日期
							<td class="textRight">#springMessage('table.revenue.transTime')</td>
							<td >
								<input type="text" name="tranDate" lay-verify="required" class="layui-input bt-biz-dateType"
									   data-today="true"  data-type="date" data-name="tranDate" data-biz-name="tranDate" value="$!{fexTranReqPage.tranDate}">
							</td>
							##收款人类型
							<td class="textRight">
								#if($!{bankType.isSetPayeeType} == "1" && $!{bankType.applayScopePayeeType.indexOf("2")} != -1)#springMessage('table.fexForeignReq.payeeType')#end
							</td>
							<td>
								#*<div class="bt-biz-dict" data-type="select" data-group="fexForeignReq.payeeType" data-defaultvalue="$!{fexTranReqPage.payeeType}"
									 data-name="payeeType" data-biz-name="payeeType" data-displayData="0,1,2,3,7"></div>*#
								<div class="payeeTypeDiv" class="layui-input-inline" #if($!{bankType.isSetPayeeType} != "1" || $!{bankType.applayScopePayeeType.indexOf("2")} == -1)style="display: none"#end>
									<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/listBankTypeCustom?bankType=$!{bankType.id}&bifCode=$!{payerAcc.bifCode}&countryId=$!{countryId}&bankPayType=$!{fexTranReqPage.bankPayType}&customType=payeeType" data-name="payeeType" data-biz-name="payeeType" data-beforeinit="customBeforeInit"
										 data-valuefield="customCode" data-textfield="customName" data-inputvalue="inputvalue" data-search="true"
										 data-value="$!{fexTranReqPage.payeeType}"#if($!{bankType.requiredPayeeType} == "1" && $!{bankType.applayScopePayeeType.indexOf("4")} != -1) data-required = "true"#end></div>
								</div>
							</td>
						</tr>
						<tr>
							##结算日期
							<td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
							<td >
								<input type="text" name="settleDate" lay-verify="required" class="layui-input bt-biz-dateType"  data-callback="settleDateCallback"
									   data-today="true" data-type="date" data-name="settleDate" data-biz-name="settleDate" value="$!{fexTranReqPage.settleDate}">
							</td>
							##金额
							<td class="textRight" width="17%">#springMessage('table.internation.proceeds.money')</td>
							<td width="30%">
								<input type="text" id="payMoney" name="payMoney" style="text-align:right" lay-verify="required|number2" data-name="payMoney" data-biz-name="payMoney" data-callback="bt.payMoneyCallback"
									   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.internation.proceeds.money')" value="$!{fexTranReqPage.payMoney}">
							</td>
                        </tr>
                        <tr>
							##跨行标志
							<td class="textRight">#springMessage('table.nisBillhead.difBank')</td>
							<td>
								<div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.difBank" data-name="difBank" data-defaultvalue="$!{fexTranReqPage.difBank}" data-required = "true"></div>
							</td>
							##收款方-银行
							<td class="textRight" width="17%">#springMessage('common.button.bank')</td>
							<td width="30%">
								<input type="hidden" id="targetBank" name="targetBank" value="$!{fexTranReqPage.targetBank}">
								<div id="targetBankNameDiv" name="targetBankNameDiv">$!{fexTranReqPage.targetBankName}</div>
							</td>
						</tr>
                        <tr>
							##是否线下付款
							<td class="textRight">#springMessage('table.fexTranReq.isPayed')</td>
							<td>
								<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isPayed" data-value="$!{fexTranReqPage.isPayed}" data-biz-name="isPayed" data-required = "true"></div>
							</td>
							##收款方银行SWIFT CODE
							<td class="textRight">#springMessage('table.fexTranReq.payeeBankSwiftCode')</td>
							<td>
								<div id="targetBankCodeDiv" name="targetBankCodeDiv">$!{fexTranReqPage.targetBankCode}</div>
							</td>
						</tr>
						<tr>
							##支付类型
							<td class="textRight" id="bankPayTypeTd">
								#if($!{bankType.isSetBankPayType} == "1" && $!{bankType.applayScopeBankPayType.indexOf("2")} != -1)#springMessage('table.nisBillhead.bankPayType')#end
							</td>
							<td>
								<div class="bankPayTypeDiv" class="layui-input-inline" #if($!{bankType.isSetBankPayType} != "1" || $!{bankType.applayScopeBankPayType.indexOf("2")} == -1)style="display: none"#end>
									<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/listBankTypeCustom?bankType=$!{bankType.id}&bifCode=$!{payerAcc.bifCode}&countryId=$!{countryId}&customType=bankPayType" data-name="bankPayType" data-biz-name="bankPayType" data-beforeinit="customBeforeInit"
										 data-valuefield="customCode" data-textfield="customName" data-inputvalue="inputvalue" data-search="true" data-callback="bt.bankPayTypeCallback"
										 data-value="$!{fexTranReqPage.bankPayType}"#if($!{bankType.requiredBankPayType} == "1" && $!{bankType.applayScopeBankPayType.indexOf("2")} != -1) data-required = "true"#end></div>
								</div>
							</td>
							##本地清算号
							<td class="textRight">#springMessage('table.btswiftinfo.localClearNo')</td>
							<td><div id="localClearNoDiv" name="localClearNoDiv">$!{fexTranReqPage.localClearNo}</div></td>
                        </tr>
						<tr>
							<td></td>
							<td></td>
							##收款人常驻国家或者地区
							<td class="textRight">#springMessage('table.fexTranReq.countryId')</td>
							<td colspan="3">
								<div class="layui-input-inline">
									<input type="hidden" id="countryId" name="countryId" value="$!{fexTranReqPage.countryId}">
									<input type="text" id="nameZh" name="nameZh" lay-verify="required|tableData" data-biz-name="nameZh"
										   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.countryId')" value="$!{fexTranReqPage.nameZh}">
									<table id="countryTable" class="hide">
										<thead>
										<tr>
											<th>#springMessage('table.tbCreditPeriod.code')</th>
											<th>#springMessage('table.btswiftinfo.namezh')</th>
											<th>#springMessage('table.btswiftinfo.nameen')</th>
										</tr>
										</thead>
									</table>
								</div>
							</td>
						</tr>
						<tr>
							<td></td>
							<td></td>
							##代理行
							<td class="textRight">#springMessage('table.fexTranReq.agentBank')</td>
							<td>
##								<div class="bt-biz-selectType" data-biz-name="cotpBank" data-value="$!{fexTranReqPage.cotpBank}"
##									 data-url="${basePath}/foreign/fexCotp/listBankCotp?cotpType=05" data-valuefield="id" data-textfield="cotpName" data-name="cotpBank"></div>
								<div class="layui-input-inline">
									<input type="text" id="cotpBank" name="cotpBank" readonly="readonly" value="$!{fexTranReqPage.cotpBank}" class="layui-input">
								##交易对手银行
									<div class="bt-div-search">
										<button class="bt-biz-allBankInfo" id="selCoptBankBut" type="button" data-callback="bt.cotpBankCallback" data-beforeClick="bt.cotpBankBeforeClick" title="#springMessage('common.button.select')">
											<i class="layui-icon">&#xe615;</i>
										</button>
									</div>
								</div>
							</td>
						</tr>
						<tr>
							<td></td>
							<td></td>
							##开户行在代理行账户
							<td class="textRight">#springMessage('table.fexTranReq.agentBankAcc')</td>
							<td>
								<input type="text" id="agentBankAcc" name="agentBankAcc" value="$!{fexTranReqPage.agentBankAcc}"
									   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.agentBankAcc')">
							</td>
						</tr>
						</tbody>
					</table>
				</div>
			</div>
			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('table.fexTranReq.costInfo')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
						<tr>
							##国内外费用承担标志 1-汇款人 OUR  2-收款人 BEN  3-共同 SHA
							<td class="textRight" width="20%">#springMessage('table.fexForeignReq.costSign')</td>
							<td colspan="3">
								<input type="hidden" id="costSignDef" name="costSignDef" value="$!{fexTranReqPage.costSign}">
								<div class="bt-biz-dict" data-type="radio" data-group="fexForeignReq.costSign" data-name="costSign" data-biz-name="costSign" data-required = "true" data-callback="bt.costSignCallback"

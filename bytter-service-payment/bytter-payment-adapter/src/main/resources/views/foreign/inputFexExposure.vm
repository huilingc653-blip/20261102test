<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body style="padding: 0 10px">
	<form class="layui-form" method="post" id="inputForm">
		<input id="status" name="status" type="hidden" value="0">
		<input type="hidden" name="enrolDate" data-biz-name="enrolDate" class="layui-input bt-input-inline bt-biz-dateType" data-today="true">
		<table class="layui-table">
			<tbody>
			<tr>
				##单位
				<td class="textRight" width="20%">#springMessage('table.nisBillhead.corpId')</td>
				<td width="30%">
					<div class="layui-input-inline">
						<div class="bt-biz-corp"
							 data-biz-type="corp"
							 data-type="selectTree"
							 data-name="corpId"
							 data-biz-name="corpId"
							 data-scope="all"
							 data-resource="foreign:fexexposureinfo:apply"
							 data-required="true"
							 data-callback="bt.corpCallback"></div>
					</div>
				</td>
				##敞口模板
				<td class="textRight" width="20%">#springMessage('table.fexExposureTemplate.templateInfo')</td>
				<td width="30%">
					<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexCorpExposureTemplate/json?corpId=-1" data-name ="templateId" data-biz-name ="templateId"
						 data-valueField="templateId" data-textField="templateName" data-required = "true" data-callback="bt.templateIdCallback" data-beforeInit="templateBeforeInit"></div>
				</td>
			</tr>
			</tbody>
		</table>
		<!-- 敞口模板 -->
		<div id="tagTemplate"></div>
		<!-- 敞口上报 -->
		<div id="tagExposure"></div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexExposure.input.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{fexTranGroupPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{fexTranGroupPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fexTranGroupPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{fexTranGroupPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{fexTranGroupPage.id}">
		<table class="layui-table">
			<tbody>
				<tr>
    				<td class="textRight" width="40%">#springMessage('table.fexProduct.name')</td>
                    <td width="60%">
						<input type="text" id="groupName" name="groupName" lay-verify="required|strlength" data-maxlength="100"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexProduct.name')">
    				</td>
				</tr>
				<tr>
					<td class="textRight" width="40%">#springMessage('sys.role.description')</td>
					<td width="60%">
						<input type="text" id="groupDesc" name="groupDesc" lay-verify="strlength" data-maxlength="200"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('sys.role.description')">
					</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.fexTranGroup.proId')</td>
                    <td>
						<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProduct/0" data-name ="proId" data-biz-name ="proId"
							 data-valueField="id" data-textField="proName" data-required = "true" data-callback="bt.changeProId"></div>
    				</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.fexProduct.trangroupRuleId')</td>
					<td>
						<div class="bt-biz-selectType" data-url="${basePath}/foreign/fextrangrouprule/json" data-name ="ruleId" data-disabled="true" data-biz-name ="ruleId"
							 data-valueField="id" data-textField="ruleName" data-required = "true"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.fexTranGroup.mainInfo')</td>
					<td>
						<input type="text" id="mainInfo" name="mainInfo" lay-verify="strlength" data-maxlength="200"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranGroup.mainInfo')">
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="1" data-name="validSign" data-required = "true"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
					<td >
						<textarea placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" style="width:100%" id="rmk" name="rmk" lay-verify="strlength" data-maxlength="200"></textarea>
					</td>
				</tr>
				<tr>
					<td colspan="2" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexTranGroup.add.js?_btv=${resourceVersion}"></script>
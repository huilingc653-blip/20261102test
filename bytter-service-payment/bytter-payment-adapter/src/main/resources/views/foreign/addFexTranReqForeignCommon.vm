<script>
    bt.use(['form','layedit','dicts', 'selectType', 'moneyType', 'rateType','ratioType','element', 'selectTable','dateType','corp', 'btUpload','checkboxs'], function(){
        var $ = bt.jquery,form = bt.form();
        var dateType = bt.dateType.init();
        var dateFun = bt.dateType.getFun();

        //银行自定义配置初始化前回调
        customBeforeInit = function (data,arguments) {
            var show = "("+arguments.customCode+")" + arguments.customName;
            return show;
        }
        var selectType = bt.selectType.init();
        var moneyType = bt.moneyType.init();
        var moneyFun = bt.moneyType.getFun();
        bt.rateType.init();
        bt.ratioType.init();
        bt.dicts.init();
        form.renderIcon();
        //1-近端 2-远端
        var swapType = 1;
        if(!$.isEmptyObject(selectTableObj["boodAccTable1"])){
            swapType = 2;
        }

        selectTableObj["up"+swapType] = bt.btUpload.init({
            elem: "#uploader"+swapType,
            auto: false,
            gid: ''
        });

        //付款账户信息
        selectTableObj["srcBankAccTable"+swapType] = bt.selectTable.init({
            elem: "#srcBankAccTable"+swapType,
            url: basePath+"/foreign/fextranreq/getBoodBankAcc",
            urldata: {curId: bt.selectType.get('sellCurId'+swapType).val(), corpId: $('input[name="corpId"]').val()},
            scrollX: true,
            scrollY:"200px",
            searchInput:"#srcBankAcc"+swapType,
            paging:true,
            columns: [
                {data:"bankAcc",},
                {data:"accName",},
                {data:"bankName",},
                {data:"curName",}
            ],
            clickCallback:function(data, row, inputElem){
                if(data){
                    inputElem.val(data.bankAcc);
                    $('#srcAccId'+inputElem.data('swaptype')).val(data.id);
                    selectType.get('sellCurId'+inputElem.data('swaptype')).val(data.curId);
                    $('#srcBank'+inputElem.data('swaptype')).val(data.bankTypeId);
                    $('#srcBankAcc'+inputElem.data('swaptype')).val(data.bankAcc);
                    $('#srcAccName'+inputElem.data('swaptype')).val(data.accName);
                    if (data.bankAcc) {
                        $("#srcBankNameDiv" + inputElem.data('swaptype')).text(data.bankTypeName);
                    }else{
                        $("#srcBankNameDiv" + inputElem.data('swaptype')).text("");
                    }
                    if (data.swiftCode) {
                        $("#srcBankAccSwiftCodeDiv" + inputElem.data('swaptype')).text(data.swiftCode);
                    } else {
                        $("#srcBankAccSwiftCodeDiv" + inputElem.data('swaptype')).text("");
                    }
                    //自动判断跨行标志
                    setDifBank(inputElem.data('swaptype'));
                    //现金流信息
                    if (inputElem.data('swaptype') == "1") {
                        $("#targetAccNameNearTd").text(data.accName);
                        $("#targetBankAccNearTd").text(data.bankAcc);
                        $("#targetBankNearTd").text(data.bankTypeName);
                        $("#targetCurNearTd").text(data.curEnglishCode);
                        var isSwapTran = bt.dicts.get("isSwapTran").val();
                        if (isSwapTran == "1") {
                            //近端付款账号写入远端收款账号
                            $('#corpAccId2').val(data.id);
                            selectType.get('buyCurId2').val(data.curId);
                            $('#corpBank2').val(data.bankTypeId);
                            $('#corpBankAcc2').val(data.bankAcc);
                            $('#corpAccName2').val(data.accName);
                            if (data.bankAcc) {
                                $("#corpBankNameDiv2").text(data.bankName);
                            }else{
                                $("#corpBankNameDiv").text("");
                            }
                            $("#srcBankRemoteTd").text(data.bankTypeName);
                            $("#srcAccNameRemoteTd").text(data.accName);
                            $("#srcBankAccRemoteTd").text(data.bankAcc);
                            $("#srcCurRemoteTd").text(data.curEnglishCode);
                        }
                    }else{
                        $("#targetAccNameRemoteTd").text(data.accName);
                        $("#targetBankAccRemoteTd").text(data.bankAcc);
                        $("#targetBankRemoteTd").text(data.bankTypeName);
                        $("#targetCurRemoteTd").text(data.curEnglishCode);

                        var isSwapTran = bt.dicts.get("isSwapTran").val();
                        if (isSwapTran == "1") {
                            //远端付款账号写入近端收款账号
                            $('#corpAccId1').val(data.id);
                            selectType.get('buyCurId1').val(data.curId);
                            $('#corpBank1').val(data.bankTypeId);
                            $('#corpBankAcc1').val(data.bankAcc);
                            $('#corpAccName1').val(data.accName);
                            if (data.bankAcc) {
                                $("#corpBankNameDiv1").text(data.bankName);
                            }else{
                                $("#corpBankNameDiv1").text("");
                            }
                            $("#srcBankNearTd").text(data.bankTypeName);
                            $("#srcAccNameNearTd").text(data.accName);
                            $("#srcBankAccNearTd").text(data.bankAcc);
                            $("#srcCurNearTd").text(data.curEnglishCode);
                        }
                    }
                }else{
                    $('input.text').val('');
                }
            }
        });

        //自动判断跨行标志
        function setDifBank(swaptype){
            //自动校验跨行标志
            var corpBank = $('#corpBank'+swaptype).val();
            var srcBank = $('#srcBank'+swaptype).val();
            if(corpBank == srcBank){
                bt.dicts.get('difBank'+swaptype).val('0');
            } else {
                bt.dicts.get('difBank'+swaptype).val('1');
            }
        }

        /**
         * 设置银行自定义信息
         * @param bankType 银行类型
         * @param bifCode 接口代码
         * @param countryId 国家地区
         * @param bankPayType 支付类型
         * @param remitType 汇款类型
         * @param initCustomType 初始化标识 默认-初始化全部 payeeType-只初始化收款人类型 other-只初始化其他信息
         */
        setBankTypeCustom = function(bankType, bifCode, countryId, bankPayType, remitType, initCustomType, swaptype) {
            // 重新支付类型
            var bankPayTypeUrl = basePath + "/basic/business/btbanktype/listBankTypeCustom?bankType=" + bankType + "&bifCode=" + bifCode + "&countryId=" + countryId + "&customType=bankPayType";
            //获取银行类型信息
            $.ajax({
                url: basePath + "/basic/business/btbanktype/getBankType",
                method: 'POST',
                data: {bankTypeId: bankType},
                dataType: 'json',
                success: function (data) {
                    if (data) {
                        if (initCustomType != "other") {
                            // 是否配置支付类型 为 1-是；支付类型应用范围 包含 1-外汇买卖交易
                            if (data.isSetBankPayType == "1" && data.applayScopeBankPayType.indexOf("1") != -1) {
                                if (data.requiredBankPayType == "1") {
                                    selectType.get('bankPayType' + swaptype).attr({
                                        "data-url": bankPayTypeUrl,
                                        "data-required": true
                                    });
                                } else {
                                    selectType.get('bankPayType' + swaptype).attr({
                                        "data-url": bankPayTypeUrl,
                                        "data-required": false
                                    });
                                }
                                $("#bankPayTypeTr" + swaptype).show();
                            } else {
                                selectType.get('bankPayType' + swaptype).attr({
                                    "data-url": bankPayTypeUrl,
                                    "data-required": false
                                });
                                $("#bankPayTypeTr" + swaptype).hide();
                            }
                        }

                        // 是否配置其他信息模块  为 1-是；适用页面 包含 2-资金调拨交易
                        if (data.isSetOtherCustom == "1") {
                            $.ajax({
                                url: basePath + "/basic/business/btbanktype/getBankTypeOtherCustom",
                                method: 'POST',
                                data: {
                                    bankType: bankType,
                                    bifCode: bifCode,
                                    countryId: countryId,
                                    remitType: remitType,
                                    applayScope: "1"
                                },
                                dataType: 'json',
                                success: function (data) {
                                    if (data) {
                                        $("#otherInfoDiv" + swaptype).addClass("layui-show");
                                        $("#otherInfoDiv" + swaptype).removeClass("ignore-verify");
                                        $("#otherInfoItemDiv" + swaptype).show();
                                        //所需字段包含“fundsSource-资金来源”“fexProp-结售汇属性”“rmk-备注”“addWord-附言”
                                        if (data.needField && data.needField.indexOf("fundsSource") != -1) {
                                            $("#fundsSourceTd" + swaptype).html(bt.lang('table.fexTranReq.fundsSource'));
                                            $("#fundsSourceDiv" + swaptype).show();
                                            if (data.requiredField && data.requiredField.indexOf("fundsSource") != -1) {
                                                bt.dicts.get('fundsSource' + swaptype).attr({'data-required': true});
                                            } else {
                                                bt.dicts.get('fundsSource' + swaptype).attr({'data-required': false});
                                            }
                                        } else {
                                            $("#fundsSourceTd" + swaptype).html('');
                                            $("#fundsSourceDiv" + swaptype).hide();
                                            bt.dicts.get('fundsSource' + swaptype).attr({'data-required': false});
                                        }
                                        if (data.needField && data.needField.indexOf("fexProp") != -1) {
                                            $("#fexPropTd" + swaptype).html(bt.lang('table.fexTranReq.fexProp'));
                                            $("#fexPropDiv" + swaptype).show();
                                            if (data.requiredField && data.requiredField.indexOf("fundsSource") != -1) {
                                                bt.dicts.get('fexProp' + swaptype).attr({'data-required': true});
                                            } else {
                                                bt.dicts.get('fexProp' + swaptype).attr({'data-required': false});
                                            }
                                        } else {
                                            $("#fexPropTd" + swaptype).html('');
                                            $("#fexPropDiv" + swaptype).hide();
                                            bt.dicts.get('fexProp' + swaptype).attr({'data-required': false});
                                        }
                                        if (data.needField && data.needField.indexOf("addWord") != -1) {
                                            $("#addWordTr" + swaptype).show();
                                            if (data.requiredField && data.requiredField.indexOf("addWord") != -1) {
                                                $("#addWord" + swaptype).attr("lay-verify", "required");
                                            } else {
                                                $("#addWord" + swaptype).removeAttr("lay-verify");
                                            }
                                        } else {
                                            $("#addWordTr" + swaptype).hide();
                                            $("#addWord" + swaptype).removeAttr("lay-verify");
                                        }
                                        if (data.needField && data.needField.indexOf("rmk") != -1) {
                                            $("#rmkTr" + swaptype).show();
                                            if (data.requiredField && data.requiredField.indexOf("rmk") != -1) {
                                                $("#rmk" + swaptype).attr("lay-verify", "required");
                                            } else {
                                                $("#rmk" + swaptype).removeAttr("lay-verify");
                                            }
                                        } else {
                                            $("#rmkTr" + swaptype).hide();
                                            $("#rmk" + swaptype).removeAttr("lay-verify");
                                        }
                                        if (data.needField && data.needField.indexOf("rmkLocal") != -1) {
                                            $("#rmkLocalTr" + swaptype).show();
                                            if (data.requiredField && data.requiredField.indexOf("rmkLocal") != -1) {
                                                $("#rmkLocal" + swaptype).attr("lay-verify", "required");
                                            } else {
                                                $("#rmkLocal" + swaptype).removeAttr("lay-verify");
                                            }
                                        } else {
                                            $("#rmkLocalTr" + swaptype).hide();
                                            $("#rmkLocal" + swaptype).removeAttr("lay-verify");
                                        }
                                        form.renderIcon();
                                    } else {
                                        $("#otherInfoDiv" + swaptype).removeClass("layui-show");

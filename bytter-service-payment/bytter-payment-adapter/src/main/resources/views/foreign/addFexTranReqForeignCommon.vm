    function budgetProcessCallback(sumMoney, datas, rowNum) {
        var $ = bt.jquery, form = bt.form();
        bt.moneyType.get("sellMoney" + rowNum).val(sumMoney);
        $("#budget" + rowNum).val(datas);
        calContractRate(rowNum);

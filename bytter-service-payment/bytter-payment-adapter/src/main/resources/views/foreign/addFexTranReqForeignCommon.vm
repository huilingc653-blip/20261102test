        /**
         * 重新组装参数
         * @param param
         * @param key
         * @returns {string}
         */
        var parseParam = function (param, key) {
            var paramStr = "";
            if (param instanceof String || param instanceof Number || param instanceof Boolean) {
                paramStr += "&" + key + "=" + encodeURIComponent(param);
            } else {
                $.each(param, function (i) {
                    var k = key == null ? i : key + (param instanceof Array ? "[" + i + "]" : "." + i);
                    paramStr += '&' + parseParam(this, k);
                });
            }
            return paramStr.substr(1);
        };

        /**
         * 弹出资金计划页面
         * @return
         */
        $genOtherHtmlOpen = function (rowNum) {
            //判断支付结算是否挂接资金计划
            var budgetSel = $("#budgetSel").val();
            var corpId = $('input[name="corpId"]').val();
            //外汇交易类型 0-即期、1-远期
            var fexTranType = $("#fexTranType"+rowNum).val();
            //固定金额 1-买入金额 2-卖出金额
            var fixedMoney = (bt.dicts.get('fixedMoney'+rowNum).val()).toString();
            var flag = true;
            if(fexTranType == "0" && (fixedMoney == "" || fixedMoney.indexOf("2") == -1)){
                flag = false;
            }
            if (budgetSel == "1" && corpId && flag) {
                $.ajax({
                    url: basePath + "/budget/fbsBudgetProcess.do?getReportBudgetByCorpId",
                    method: 'POST',
                    data: {corpId: corpId},
                    dataType: 'json',
                    async: true,
                    success: function (data) {
                        if (data.obj) {
                            var itemCode = $('input[name="payItem"]').val();
                            var processDate = dateType.get("settleDate"+rowNum).val();
                            var curId = selectType.get("sellCurId"+rowNum).val();
                            var param = {
                                corpId: corpId,
                                itemCode: itemCode ? itemCode : "400",
                                processDate: processDate,
                                type: 'open',
                                date: (new Date()).getTime(),
                                budget: $("#budget" + rowNum).val(),
                                rowNum: rowNum,
                                detailControl: true,
                                curId: curId ? curId : "",
                                wishPayday: processDate ?processDate : "",
                            };
                            var url = basePath + "/budget/fbsBudgetProcess/getOpenItemDetail";
                            parent.layer.open({
                                type: 2,
                                area: ['1000px', '530px'],
                                maxmin: true,
                                content: url + "?" + parseParam(param),
                                end: function () {
                                }
                            });
                        }
                    }
                });
            }
        };
    });

    /**

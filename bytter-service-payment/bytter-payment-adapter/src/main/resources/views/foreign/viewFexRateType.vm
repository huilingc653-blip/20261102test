<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>

<form class="layui-form layui-form-pane">
	<table class="layui-table">
		<tbody>
		<tr>
			<td class="textRight" width="40%">
				#springMessage('bill.accebill.name')
			</td>
			<td>$!{fexRateType.typeName}</td>
		</tr>

		<tr>
			<td class="textRight">#springMessage('fex.rate.interface.typename')</td>
			<td>$dictTag.get("fex.rate.interface.type",$!{fexRateType.rateInterfaceType})</td>
		</tr>

		<tr>
			<td class="textRight">#springMessage('table.type.interface')</td>
			<td>$!{fexRateType.bifCodeName}</td>
		</tr>
		<tr #if($!{fexRateType.rateInterfaceType} == "2")
				style="display: none"
		#end>
			<td class="textRight">#springMessage('table.inquire.standard.currency')</td>
			<td>$dictTag.get("sf_yn",$!{fexRateType.isNeedQueryCur})</td>
		</tr>

		<tr>
			<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
			<td>$dictTag.get("valid_sign",$!{fexRateType.validSign})</td>
		</tr>

		<tr>
			<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
			<td>$!{fexRateType.rmk}</td>
		</tr>
		</tbody>
	</table>
</form>
	#parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight" width="40%">#springMessage('table.fexTranGroup.billNo')</td>
					<td>$!{fexTranGroupPage.billNo}</td>
				</tr>
				<tr>
					<td class="textRight" width="40%">#springMessage('table.fexTranGroup.groupName')</td>
					<td>$!{fexTranGroupPage.proName}</td>
                </tr>
				<tr>
					<td class="textRight" width="40%">#springMessage('sys.role.description')</td>
					<td>$!{fexTranGroupPage.groupDesc}</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.fexTranGroup.proId')</td>
					<td>$!{fexTranGroupPage.proName}</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.fexProduct.trangroupRuleId')</td>
					<td>$!{fexTranGroupPage.ruleName}</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.fexTranGroup.mainInfo')</td>
					<td>$!{fexTranGroupPage.mainInfo}</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.validSign')</td>
					<td>$dictTag.get("valid_sign",$!{fexTranGroupPage.validSign})</td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
					<td>$!{fexTranGroupPage.rmk}</td>
				</tr>
            </tbody>
		</table>

		<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
			<tr>
				<th colspan="7">#springMessage('table.rasBackQuery.msg')</th>
			<tr>
			<tr>
				<th>#springMessage('table.fbsBudgetYear.number')</th>
				<th>#springMessage('table.fexTranReq.billNo')</th>
				<th>#springMessage('table.foreign.product')</th>
				<th>#springMessage('table.fbsBudget.corpId')</th>
				<th>#springMessage('table.btNetChalk.transTime')</th>
				<th>#springMessage('table.fbsBudget.status')</th>
				<th>#springMessage('common.table.thead.operation')</th>
			</tr>
			</thead>
			#foreach($data in $listTran)
				<tr>
					<td align="center">$!{velocityCount}</td>
                    <td align="center">
                        <input type="hidden" id="tranId" name="tranId" value="$!{data.id}" class="tranid">
                        $!{data.billNo}
                    </td>
					<td>$!{data.proName}</td>
					<td>$!{data.corpName}</td>
					<td align="center">$!{data.tranDate}</td>
					<td align="center">$dictTag.get("choBankFinance.status",$!{data.status})</td>
					<td align="center">
						<a class="operate-button" href="#" data-type="view">#springMessage('common.button.view')</a>
					</td>
				</tr>
			#end
		</table>
	</form>
    #parse("views/common/footer.vm")
    <script>
        bt.use(['moneyType'],function () {
            $('#appTable').on('click','.operate-button',function () {
                var type = $(this).data('type');
                var tranId = $(this).closest('tr').find('.tranid').val();
                if (type=='view'){
                    if (bt.navtab) {
                        bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/foreign/fextranreq/view/" + tranId);
                        return;
                    }
                    parent.layer.open({
                        type: 2,
                        area: ['950px', '530px'],
                        maxmin: true,
                        content: basePath + "/foreign/fextranreq/view/" + tranId
                    });
                }
            })
        })
    </script>
</body>
</html>
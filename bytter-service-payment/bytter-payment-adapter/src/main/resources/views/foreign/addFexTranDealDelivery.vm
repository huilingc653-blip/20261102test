<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
	<style>
		.layui-input{
			width: 120px!important;
		}
	</style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input id="tranReqId" name="tranReqId" type="hidden" value="$!{fexTranDealPage.tranReqId}">
		<input id="corpId" name="corpId" type="hidden" value="$!{fexTranDealPage.corpId}">
		<input id="opType" name="opType" type="hidden" value="$!{fexTranDealPage.opType}">
		<input id="dataSize" name="dataSize" type="hidden" value="$!{dataSize}">
		<input id="tranBal" name="tranBal" type="hidden" value="$!{tranBal}">
		<input id="id" name="id" type="hidden" value="$!{fexTranDealPage.id}">
		<input id="status" name="status" type="hidden" value="$!{fexTranDealPage.status}">
		<table class="layui-table" id="dataTable">
			<thead>
			<tr>
				<th><span class="pl">#springMessage('table.fexTranDeal.deliverySign')</th>
				<th>#springMessage('table.fexTranDeal.oldSettleDate')</th>
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranDeal.newSettleDate')</th>
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranDeal.settleMoney')</th>
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranDeal.settleRate')</th>
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranDeal.wishRate')</th>
				<th>#springMessage('table.accountDTO.balance')</th>
				<th>#springMessage('fcVoucherType.rmk')</th>
			</tr>
			</thead>
			<tbody class="ignore-required-icon layui-form">
				#foreach($data in $list)
					#set($rowMR=$math.sub($velocityCount,1))
					#if($!{data.status}=="0" || $!{data.status}=="-1")
					<tr>
						<td align="center">
							<div class="layui-input-inline" style="display: none">
								<div class="bt-biz-dict" data-type="radio" data-group="fexTranDeal.deliverySign" data-name="deliverySign" data-biz-name="deliverySign"
									 data-required = "true" data-defaultvalue="$!{data.deliverySign}" data-callback="bt.balCallback"></div>
							</div>
							$dictTag.get("fexTranDeal.deliverySign",$!{data.deliverySign})
						</td>
						<td align="center">
							<input type="text" name="oldSettleDate" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{data.oldSettleDate}" readonly="readonly"
								   data-type="date" data-name="oldSettleDate" data-biz-name="oldSettleDate">
						</td>
						<td align="center">
							<input type="text" id="newSettleDate" name="newSettleDate" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{data.newSettleDate}"
								   data-type="date" data-name="newSettleDate" data-biz-name="newSettleDate">
						</td>
						<td align="center">
							<input type="text" id="settleMoney" name="settleMoney" style="text-align:right" lay-verify="required|number2" data-name="settleMoney" data-biz-name="settleMoney"
								   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranDeal.settleMoney')" value="$!{data.settleMoney}" data-callback="bt.balCallback">
						</td>
						<td align="center">
							<input type="text" data-name="settleRate" data-biz-name="settleRate" data-decimal="6" lay-verify="required" value="$!{data.settleRate}"
								   id="settleRate" autocomplete="off" class="layui-input bt-biz-moneyType"  placeholder="#springMessage('table.fexTranDeal.settleRate')">
						</td>
						<td align="center">
							<input type="text" data-name="wishRate" data-biz-name="wishRate" data-decimal="6" lay-verify="required" value="$!{data.wishRate}"
								   id="wishRate" autocomplete="off" class="layui-input bt-biz-moneyType"  placeholder="#springMessage('table.fexTranDeal.wishRate')">
						</td>
						<td align="center">
							<input type="text" id="bal" name="bal" style="text-align:right" data-name="bal" data-biz-name="bal" readonly="readonly"
								   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.accountDTO.balance')" value="$!{data.bal}">
						</td>
						<td align="center">
							<input type="text" id="rmk" name="rmk" value="$!{data.rmk}"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('fcVoucherType.rmk')">
						</td>
					</tr>
					#else
					<tr>
						<td align="center" style="word-break: keep-all;">
							$dictTag.get("fexTranDeal.deliverySign",$!{data.deliverySign})
						</td>
						<td align="center">
							$!date.format('yyyy-MM-dd',$!{data.oldSettleDate})
						</td>
						<td align="center">
							$!date.format('yyyy-MM-dd',$!{data.newSettleDate})
						</td>
						<td align="right">
							$!number.formatNumeric($!{data.settleMoney})
						</td>
						<td align="right">
							$!number.formatDoubles($!{data.settleRate}, 6)
						</td>
						<td align="right">
							$!number.formatDoubles($!{data.wishRate}, 6)
						</td>
						<td align="right">
							$!number.formatNumeric($!{data.bal})
						</td>
						<td>$!{data.rmk}</td>
					</tr>
					#end
				#end
        	</tbody>
        </table>
		<div style="text-align: center; padding-top: 10px;">
			#if($!{fexTranDealPage.status}=="0" || $!{fexTranDealPage.status}=="-1")
				<button class="layui-btn" lay-submit="" lay-filter="submit" value="11" >#springMessage('common.button.submit')</button>
				<button class="layui-btn" lay-submit="" lay-filter="submit" value="0" >#springMessage('common.button.temp')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			#end
			#if($!{fexTranDealPage.id} && ($!{fexTranDealPage.status}=="0" || $!{fexTranDealPage.status}=="-1"))
				<button class="layui-btn" lay-submit="" type="button" onclick="delTranDeal()" >#springMessage('common.button.delete')</button>
			#end
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexTranDealDelivery.add.js?_btv=${resourceVersion}"></script>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input id="eqi_opType" name="eqi_opType" type="hidden" value="$!{opType}">
        <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
        <table class="layui-table">
            <tbody>
                <tr>
                    ##交易号码
                    <td class="textRight">#springMessage('table.fexTranReq.billNo')</td>
                    <td>
                        <input type="text" name="likes_tranReqNo"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.billNo')">
                    </td>
                    ##单位
                    <td class="textRight" width="20%">#springMessage('table.nisBillhead.corpId')</td>
                    <td width="30%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="corpId"
                                 data-biz-name="corpId"
                                 data-scope="all"></div>
                        </div>
                    </td>
                    ##交割方向
                    <td class="textRight">#springMessage('table.fexTranDeal.deliverySign')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="fexTranDeal.deliverySign"
                             data-name="deliverySign" data-biz-name="deliverySign"></div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.fexTranReq.billNo')</th>
            <th>#springMessage('table.nisBillhead.corpId')</th>
            <th>#springMessage('table.fexTranDeal.deliverySign')</th>
            <th>#springMessage('table.fexTranDeal.oldSettleDate')</th>
            <th>#springMessage('table.fexTranDeal.newSettleDate')</th>
            <th>#springMessage('table.fexTranDeal.settleMoney')</th>
            <th>#springMessage('table.fexTranDeal.settleRate')</th>
            <th>#springMessage('table.fexTranDeal.wishRate')</th>
            <th>#springMessage('table.accountDTO.balance')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
    #paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
    #paymentWorkFlowScript()
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexTranDealDelivery.listApprove.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/foreign/fexTranDeal.listApprove.js?_btv=${resourceVersion}"></script>

                    <div class="bankPayTypeDiv" class="layui-input-inline" #if($!{bankType.isSetPayeeType} != "1" || $!{bankType.applayScopePayeeType.indexOf("4")} == -1)style="display: none"#end>
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/listBankTypeCustom?bankType=$!{bankType.id}&bifCode=$!{payerAcc.bifCode}&countryId=$!{countryId}&bankPayType=$!{fexForeignReqPage.bankPayType}&customType=payeeType" data-name="payeeType" data-biz-name="payeeType" data-beforeinit="customBeforeInit"
                             data-valuefield="customCode" data-textfield="customName" data-inputvalue="inputvalue" data-search="true" data-callback="bt.bankPayTypeCallback"

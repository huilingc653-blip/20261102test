<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
</head>
<body>
<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
    <ul class="layui-tab-title">
        #if($!{fexForeignReqPage.remitType} == "1")
            <li>$dictTag.get("fexForeignReq.remitType","0")</li>
            <li class="layui-this">$dictTag.get("fexForeignReq.remitType","1")</li>
        #else
            <li class="layui-this">$dictTag.get("fexForeignReq.remitType","0")</li>
            <li>$dictTag.get("fexForeignReq.remitType","1")</li>
        #end
    </ul>
</div>
<div class="layui-tab-content" id="targtRemitType">
    <form class="layui-form" method="post" id="inputForm">
        <input id="billNo" name="billNo" type="hidden" value="$!{fexForeignReqPage.billNo}">
        <input id="createBy" name="createBy" type="hidden" value="$!{fexForeignReqPage.createBy}">
        <input id="createDate" name="createDate" type="hidden" value="$!{fexForeignReqPage.createDate}">
        <input id="updateBy" name="updateBy" type="hidden" value="$!{fexForeignReqPage.updateBy}">
        <input id="updateDate" name="updateDate" type="hidden" value="$!{fexForeignReqPage.updateDate}">
        <input id="id" name="id" type="hidden" value="$!{fexForeignReqPage.id}">
        <input id="remitType" name="remitType" type="hidden" value="$!{fexForeignReqPage.remitType}">
        <!-- 新增默认 -->
        <input id="status" name="status" type="hidden" value="$!{fexForeignReqPage.status}">
        <!-- 所用账号单位代码 -->
        <input id="accCorpId" name="accCorpId" type="hidden" value="$!{accCorpId}">
        <!-- 付/收款账号相关属性 -->
        <input id="accId" name="accId" type="hidden" value="$!{fexForeignReqPage.accId}">
        <input id="isOnline" name="isOnline" type="hidden" value="$!{fexForeignReqPage.isOnline}">
        <!-- 系统参数 -->
        <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
        <input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
        <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
        <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
        <!-- 资金计划参数 明细项控制模式-->
        <input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
        <input id="settlType" name="settlType" type="hidden" value="0">
        <!-- 人民币 -->
        <input id="natualCurId" name="natualCurId" type="hidden" value="$!{currencyTag.getRMBCurrency().id}">
        <input id="natualCurName" name="natualCurName" type="hidden" value="$!{currencyTag.getRMBCurrency().curName}">
        <!-- 单据来源，默认0-外汇申请 -->
        <input id="billFrom" name="billFrom" type="hidden" value="$!{fexForeignReqPage.billFrom}">
        <table class="layui-table">
            <thead>
            <tr>
                <th colspan="4">#springMessage('table.fexForeignReq.mainInfo')</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                ##单位
                <td class="textRight" width="15%">#springMessage('table.nisBillhead.corpId')</td>
                <td width="35%">
                    <input type="hidden" id="corpIdDef" value="$!{fexForeignReqPage.corpId}">
                    $!{fexForeignReqPage.corpName}
                    <div class="layui-input-inline" style="display: none;">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-name="corpId"
                             data-biz-name="corpId"
                             data-scope="all"
                             data-resource="foreign:foreign:fexForeignReq:apply"
                             data-required="true"
                             data-defaultvalue="$!{fexForeignReqPage.corpId}"></div>
                    </div>
                </td>
                ##跨行标志
                <td class="textRight" width="15%">#springMessage('table.nisBillhead.difBank')</td>
                <td width="35%">
                    <div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.difBank" data-value="$!{fexForeignReqPage.difBank}" data-name="difBank" data-required = "true"></div>
                </td>
            </tr>
            <tr>
                ##汇款日期
                <td class="textRight" width="15%">#springMessage('table.fexForeignReq.payDate')</td>
                <td width="35%">
                    <div class="layui-input-inline">
                        <input type="text" name="payDate" lay-verify="required" class="layui-input bt-biz-dateType"
                               data-today="true" data-type="date" data-name="payDate" data-biz-name="payDate" readonly="readonly">
                    </div>
                </td>
                ##收款账号
                <td class="textRight" width="15%">#springMessage('table.fexForeignReq.payeeAcc')</td>
                <td width="35%">
                    <div class="layui-input-inline" id="payeeAccDiv">
                        #if("$!{externalCorp}" == "1")
                            <input type="text" id="payeeAcc" name="payeeAcc" lay-verify="required" readonly="readonly" value="$!{fexForeignReqPage.payeeAcc}"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeAcc')">
                        #else
                            <input type="text" id="payeeAcc" name="payeeAcc" lay-verify="required" value="$!{fexForeignReqPage.payeeAcc}"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeAcc')">
                        #end
                        <div class="bt-div-search">
                            <button  class="bt-biz-externalCorpBankAccFex" id="selPayeeAccBut" type="button" data-beforeClick="bt.externalCorpBankAccFexParams" data-callback="bt.externalCorpCallback" title="#springMessage('common.button.select')">
                                <i class="layui-icon">&#xe615;</i>
                            </button>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                ##汇款币种
                <td class="textRight">#springMessage('table.fexForeignReq.curId')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="hidden" id="curIdDef" value="$!{fexForeignReqPage.curId}">
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="curId" data-biz-name ="curId" data-value="$!{fexForeignReqPage.curId}"
                             data-valueField="id" data-textField="curName" data-required = "true" data-callback="bt.curIdCallback"></div>
                    </div>
                </td>
                ##收款人名称
                <td class="textRight">#springMessage('table.fexForeignReq.payeeAccNameEn')</td>
                <td>
                    #if("$!{externalCorp}" == "1")
                        <input type="text" id="payeeAccName" class="layui-input bt-biz-inputExternalCorpBankAcc" data-url="" name="payeeAccName" data-biz-name="payeeAccName" readonly="readonly"
                               data-valuefield="inputExternalValue" data-textfield="inputExternalText" data-search="seachExternalCorpBankAcc"
                           #if($!{fexForeignReqPage.bankTypeName} == "兴业银行" && $!{fexForeignReqPage.remitType} == "1")
                               lay-verify="required|langKey"
                           #else
                               lay-verify="required"
                           #end
                               value="$!{fexForeignReqPage.payeeAccName}"
                               placeholder="#springMessage('table.fexForeignReq.payeeAccName')" data-callback="inputExternalCorpCallback" style="width:300px;">
                    #else
                        <input type="text" id="payeeAccName" class="layui-input bt-biz-inputExternalCorpBankAcc" data-url="" name="payeeAccName" data-biz-name="payeeAccName"
                               data-valuefield="inputExternalValue" data-textfield="inputExternalText" data-search="seachExternalCorpBankAcc"
                            #if($!{fexForeignReqPage.bankTypeName} == "兴业银行" && $!{fexForeignReqPage.remitType} == "1")
                               lay-verify="required|langKey"
                            #else
                               lay-verify="required"
                            #end
                               value="$!{fexForeignReqPage.payeeAccName}"
                               placeholder="#springMessage('table.fexForeignReq.payeeAccName')" data-callback="inputExternalCorpCallback" style="width:300px;">
                    #end
                </td>
            </tr>
            <tr>
                ##银行类别
                <td class="textRight">#springMessage('table.bisBifInit.bankType')</td>
                <td>
                    <input type="hidden" name="bankTypeName" id="bankTypeName" value="$!{fexForeignReqPage.bankTypeName}"/>
                    <input type="hidden" id="bankTypeIdDef" value="$!{fexForeignReqPage.bankTypeId}">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json" data-name ="bankTypeId" data-biz-name ="bankTypeId" data-value="$!{fexForeignReqPage.bankTypeId}"
                         data-valueField="id" data-textField="typeName" data-required = "true" data-callback="bt.bankTypeCallback"></div>
                </td>
                ##收款人地址
                <td class="textRight">#springMessage('table.fexForeignReq.payeeAdd')</td>
                <td>
                    #if("$!{externalCorp}" == "1")
                        <input type="text" id="payeeAdd" name="payeeAdd" style="width:300px;" readonly="readonly" value="$!{fexForeignReqPage.payeeAdd}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeAdd')">
                    #else
                        <input type="text" id="payeeAdd" name="payeeAdd" style="width:300px;" value="$!{fexForeignReqPage.payeeAdd}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeAdd')">
                    #end
                </td>
            </tr>
            <tr>
                ##汇款账号
                <td class="textRight">#springMessage('table.fexForeignReq.payerAcc')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="hidden" id="payerCountryNameZh" name="payerCountryNameZh" value="$!{payerCountryNameZh}">
                        <input type="hidden" id="payerCountryId" name="payerCountryId" value="$!{payerCountryId}">
                        <input type="hidden" id="payerEnCode" name="payerEnCode" value="$!{payerEnCode}">
                        <input type="hidden" id="payerBifCode" name="payerBifCode" value="$!{payerAcc.bifCode}">
                        <input type="hidden" id="payerIsDomesticBank" name="payerIsDomesticBank" value="$!{payerAcc.isDomesticBank}">
                        <input type="text" id="payerAcc" name="payerAcc" lay-verify="required|tableData" data-biz-name="payerAcc" value="$!{fexForeignReqPage.payerAcc}"
                               autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexForeignReq.payerAcc')">
                        <table id="payerAccTable" class="hide">
                            <thead>
                            <tr>
                                <th>#springMessage('table.nisBillhead.payerAcc')</th>
                                <th>#springMessage('table.nisBillhead.payerAccName')</th>
                                <th>#springMessage('table.nisBillhead.payerBank')</th>
                                <th>#springMessage('table.nisBillhead.curId')</th>
                                <th>#springMessage('table.btBankAcc.isOnline')</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </td>
                ##收款开户行swift code
                <td class="textRight">#springMessage('table.fexForeignReq.payeeSwiftCode')</td>
                <td>
                    <div class="layui-input-inline" id="payeeBankCodeDiv">
                        #if("$!{externalCorp}" == "1")
                            <input type="text" id="payeeSwiftCode" name="payeeSwiftCode" lay-verify="required" readonly="readonly" style="width:300px;" value="$!{fexForeignReqPage.payeeSwiftCode}"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeSwiftCode')">
                        #else
                            <input type="text" id="payeeSwiftCode" name="payeeSwiftCode" lay-verify="required" readonly="readonly" style="width:300px;" value="$!{fexForeignReqPage.payeeSwiftCode}"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeSwiftCode')">
                            <div class="bt-div-search">
                                <button class="bt-biz-swiftInfo" id="selPayeeBankBut" type="button"  data-callback="bt.swiftInfoCallback" title="#springMessage('common.button.select')">
                                    <i class="layui-icon">&#xe615;</i>
                                </button>
                            </div>
                        #end
                    </div>
                </td>
            </tr>
            <tr>
                ##汇款账号名称
                <td class="textRight">#springMessage('table.fexForeignReq.payerAccName')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="payerAccName" name="payerAccName"
                               lay-verify="required"
                               readonly="readonly" style="width:300px;" value="$!{fexForeignReqPage.payerAccName}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payerAccName')">
                    </div>
                </td>
                ##收款开户行名称
                <td class="textRight">#springMessage('table.fexForeignReq.payeeBankEn')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="payeeBank" name="payeeBank"
                            #if($!{fexForeignReqPage.bankTypeName} == "兴业银行" && $!{fexForeignReqPage.remitType} == "1")
                               lay-verify="required|langKey"
                            #else
                               lay-verify="required"
                            #end
                               style="width:300px;" readonly="readonly" value="$!{fexForeignReqPage.payeeBank}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeBankEn')">
                    </div>
                </td>
            </tr>
            <tr>
                ##汇款开户行名称
                <td class="textRight">#springMessage('table.fexForeignReq.payerBank')</td>
                <td>
                    <div class="layui-input-inline" id="payerBankDiv"
                        #if($!{fexForeignReqPage.bankTypeName} == "民生银行")
                            style="display: none"
                    #end>
                        <input type="text" id="payerBank" name="payerBank" lay-verify="required" style="width:300px;" readonly="readonly" value="$!{fexForeignReqPage.payerBank}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payerBank')">
                    </div>
                    <div class="layui-input-inline" id="branchDiv"
                        #if($!{fexForeignReqPage.bankTypeName} != "民生银行")
                         style="display: none"
                        #end>
                        <div class="layui-input-inline">
                            <input type="text" id="branchCode" name="branchCode"
                                   #if($!{fexForeignReqPage.bankTypeName} == "民生银行")lay-verify="required"#end
                                   data-biz-name="branchCode" readonly="readonly" value="$!{fexForeignReqPage.branchCode}"
                                   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.bisBankBranch.branchCode')">
                            <table id="branchCodeTable" class="hide">
                                <thead>
                                <tr>
                                    <th>#springMessage('table.bisBankBranch.branchCode')</th>
                                    <th>#springMessage('table.bisBankBranch.branchName')</th>
                                </tr>
                                </thead>
                            </table>
                        </div>
                        <div class="layui-input-inline">
                            <input type="text" id="branchName" name="branchName" value="$!{fexForeignReqPage.branchName}"
                                   data-biz-name="branchName" readonly="readonly" width="180px;"
                                   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.bisBankBranch.branchName')">
                        </div>
                    </div>
                </td>
                ##收款开户行地址
                <td class="textRight">#springMessage('table.fexForeignReq.payeeBankAdd')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="payeeBankAdd" name="payeeBankAdd" style="width:300px;" readonly="readonly" value="$!{fexForeignReqPage.payeeBankAdd}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeBankAdd')">
                    </div>
                </td>
            </tr>
            <tr>
                ##汇款方联系人姓名
                <td class="textRight">#springMessage('table.fexForeignReq.payerName')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="payerName" name="payerName" lay-verify="required" data-biz-name="payerName" value="$!{fexForeignReqPage.payerName}"
                               autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexForeignReq.payerName')">
                        <table id="payerNameTable" class="hide">
                            <thead>
                            <tr>
                                <th>#springMessage('table.fexForeignReq.payerName')</th>
                                <th>#springMessage('table.fexForeignReq.payerTel')</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </td>
                ##收款方国别
                <td class="textRight">#springMessage('table.fexForeignReq.payeeCountryCode')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="hidden" id="payeeCountryCode" name="payeeCountryCode" lay-verify="required" value="$!{fexForeignReqPage.payeeCountryCode}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeCountryCode')">
                        <input type="text" id="payeeCountryName" name="payeeCountryName" lay-verify="required|tableData" data-biz-name="payeeCountryName" value="$!{fexForeignReqPage.payeeCountryName}"
                               autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexForeignReq.payeeCountryCode')">
                        <table id="payeeCountryCodeTable" class="hide">
                            <thead>
                            <tr>
                                <th>#springMessage('table.tbCreditPeriod.code')</th>
                                <th>#springMessage('table.btswiftinfo.namezh')</th>
                                <th>#springMessage('table.btswiftinfo.nameen')</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </td>
            </tr>
            <tr>
                ##汇款方联系人电话
                <td class="textRight">#springMessage('table.fexForeignReq.payerTel')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="payerTel" name="payerTel" lay-verify="required" value="$!{fexForeignReqPage.payerTel}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payerTel')">
                    </div>
                </td>
                ##收款银行之代理行SwifitCode
                <td class="textRight">#springMessage('table.fexForeignReq.payeeAgentSwiftCode')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="payeeAgentSwiftCode" name="payeeAgentSwiftCode" readonly="readonly" style="width:300px;" value="$!{fexForeignReqPage.payeeAgentSwiftCode}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeAgentSwiftCode')">
                        <div class="bt-div-search">
                            <button class="bt-biz-swiftInfo" id="selPayeeAgentBankBut" type="button"  data-callback="bt.payeeAgentSwiftInfoCallback" title="#springMessage('common.button.select')">
                                <i class="layui-icon">&#xe615;</i>
                            </button>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                ##汇款人名称（英文）
                <td class="textRight"><div id="payerNameEnTd1" >#springMessage('table.fexForeignReq.payerNameEn')</div></td>
                <td>
                    <div id="payerNameEnTd2" >
                        <input type="text" id="payerNameEn" name="payerNameEn"
                            #if($!{fexForeignReqPage.bankTypeName} == "兴业银行" && $!{fexForeignReqPage.remitType} == "1")
                               lay-verify="required|langKey"
                            #else
                               lay-verify="required"
                            #end
                               value="$!{fexForeignReqPage.payerNameEn}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payerNameEn')">
                    </div>
                </td>
                ##收款银行之代理行名称
                <td class="textRight">#springMessage('table.fexForeignReq.payeeAgentBank')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="payeeAgentBank" name="payeeAgentBank"  style="width:300px;" value="$!{fexForeignReqPage.payeeAgentBank}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeAgentBank')">
                    </div>
                </td>
            </tr>
            <tr>
                ##汇款人地址（英文）
                <td class="textRight"><div id="payerAddEnTd1" >#springMessage('table.fexForeignReq.payerAddEn')</div></td>
                <td>
                    <div id="payerAddEnTd2" >
                        <input type="text" id="payerAddEn" name="payerAddEn" style="width:300px;" value="$!{fexForeignReqPage.payerAddEn}"
                            #if($!{fexForeignReqPage.bankTypeName} == "兴业银行")
                               lay-verify="required|langKey"
                            #end
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payerAddEn')">
                    </div>
                </td>
                ##收款银行之代理行地址
                <td class="textRight">#springMessage('table.fexForeignReq.payeeAgentBankAdd')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="payeeAgentBankAdd" name="payeeAgentBankAdd" style="width:300px;" value="$!{fexForeignReqPage.payeeAgentBankAdd}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeAgentBankAdd')">
                    </div>
                </td>
            </tr>
            <tr>
                ##账户类别
                <td class="textRight">#springMessage('table.btBankAcc.accType')</td>
                <td>
                    <div id="accTypeDiv" name="accTypeDiv">$dictTag.get("btBankAcc.accType",$!{fexForeignReqPage.accType})</div>
                    <input type="hidden" id="accType" name="accType" autocomplete="off" class="layui-input" value="$!{fexForeignReqPage.accType}">
                </td>
                ##收款人开户行银行在其代理行账号
                <td class="textRight">#springMessage('table.fexForeignReq.payeeAgentAcc')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="payeeAgentAcc" name="payeeAgentAcc" style="width:300px;" value="$!{fexForeignReqPage.payeeAgentAcc}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.payeeAgentAcc')">
                    </div>
                </td>
            </tr>
            <tr>
                ##账户余额
                <td class="textRight">#springMessage('table.nisBillhead.balance')</td>
                <td>
                    <div id="balanceDiv" name="balanceDiv">$!{fexForeignReqPage.balance}</div>
                    <input type="hidden" id="balance" name="balance" style="text-align:right" readonly="readonly" data-name="balance" data-biz-name="balance" value="$!{fexForeignReqPage.balance}"
                           autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.nisBillhead.balance')">
                </td>
                ##资金性质
                <td class="textRight">#springMessage('table.fexTranReq.accNature')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="fexTranReq.accNature" data-defaultvalue="$!{fexForeignReqPage.accNature}" data-name="accNature" data-required = "true"></div>
                </td>
            </tr>
            <tr>
                ##汇款金额
                <td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="payMoney" name="payMoney" style="text-align:right" lay-verify="required|number2" data-name="payMoney" data-toUp="payMoneyUp" data-biz-name="payMoney" data-callback="payMoneyCallBack"
                               autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.nisBillhead.payMoney.lower')" value="$!{fexForeignReqPage.payMoney}">
                    </div>
                </td>
                <td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
                <td style="padding-left:0px">
                    <div id="payMoneyUp"></div>
                </td>
            </tr>
            <tr id="foreignMoneyTr" style="display-inside: none">

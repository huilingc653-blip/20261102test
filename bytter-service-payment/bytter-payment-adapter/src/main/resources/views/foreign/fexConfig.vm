<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
<div class="layui-collapse">
    <div class="layui-colla-item">
    <h2 class="layui-colla-title">#springMessage('config.fex.param.titile.usually')</h2>
    <div class="layui-colla-content layui-show">
        <table class="layui-table breakRow">
            <thead>
                <tr>
                    <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                    <td width="80%">#springMessage('config.fbs.paramValue')</td>
                </tr>
                </thead>
                <tbody>
                <tr>
                    ## 指令发送模式
                    <td class="textRight">#springMessage('config.nis.bisExcAutoAccount')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="radio" name="fex.bisExcAutoAccount" value="1" #if($config.fex.bisExcAutoAccount == 1)checked#end title="#springMessage('config.nis.autoBisExcAccount')">
                            <input type="radio" name="fex.bisExcAutoAccount" value="0" #if($config.fex.bisExcAutoAccount == 0)checked#end title="#springMessage('config.nis.manualBisExcAccount')">
                        </div>
                        <div class="layui-input-inline">
                            <i id="bisExcAutoAccount-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##是否跳过结算执行
                    <td width="20%" class="textRight">#springMessage('config.fex.isSkipSettle')</td>
                    <td width="80%">
                        <div class="layui-input-inline">
                            <input type="radio" name="fex.isSkipSettle" value="1" #if($config.fex.isSkipSettle == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                            <input type="radio" name="fex.isSkipSettle" value="0" #if($config.fex.isSkipSettle == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                        </div>
                        <div class="layui-input-inline">
                            <i id="isSkipSettle-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##交易的默认外汇牌价类型
                    <td width="20%" class="textRight">#springMessage('config.fex.tranRateTypeDefault')</td>
                    <td width="80%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexratetype/listFexRateTypeAll"
                                 data-name ="fex.tranRateTypeDefault" data-biz-name ="fex.tranRateTypeDefault" data-valueField="id" data-textField="typeName"
                                 data-defaultvalue="$!{config.fex.tranRateTypeDefault}" data-required="required"></div>
                        </div>
                        <div class="layui-input-inline">
                            <i id="tranRateTypeDefault-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    </div>

    <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('config.fex.param.titile.budget')</h2>
        <div class="layui-colla-content layui-show">
            <table class="layui-table breakRow">
                <thead>
                <tr>
                    <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                    <td width="80%">#springMessage('config.fbs.paramValue')</td>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td width="20%" class="textRight">#springMessage('config.nis.budgetSel')</td>
                    <td width="80%">
                        <div class="layui-input-inline">
                            <input type="radio" name="fex.budgetSel" value="1" #if($config.fex.budgetSel == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                            <input type="radio" name="fex.budgetSel" value="0" #if($config.fex.budgetSel == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                        </div>
                        <div class="layui-input-inline">
                            <i id="budgetSel-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="textRight">#springMessage('config.exp.payItem')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="fex.payItem" autocomplete="off" class="layui-input" data-decimal="0" data-separator="" value="$!{config.fex.payItem}">
                        </div>
                        ## <div class="layui-input-inline" style="color:red">#springMessage('config.nis.payItem.desc')</div>
                        <div class="layui-input-inline">
                            <i id="payItem-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('config.fex.param.titile.warnstrategy')</h2>
        <div class="layui-colla-content layui-show">
            <table class="layui-table breakRow">
                <thead>
                <tr>
                    <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                    <td width="80%">#springMessage('config.fbs.paramValue')</td>
                </tr>
                </thead>
                <tbody>
                <tr>
                    ##汇款支付超时预警天数
                    <td class="textRight">#springMessage('config.fex.payOverTime')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="fex.payOverTime" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" data-min="1" data-separator="" value="$!{config.fex.payOverTime}">
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('config.fex.profitLossParam')</h2>
        <div class="layui-colla-content layui-show">
            <table class="layui-table breakRow">
                <thead>
                <tr>
                    <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                    <td width="80%">#springMessage('config.fbs.paramValue')</td>
                </tr>
                </thead>
                <tbody>
                <tr>
                    ##默认损益币种
                    <td class="textRight">#springMessage('config.fex.profitLossCurDefault')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="radio" name="fex.profitLossCur" value="1" #if($config.fex.profitLossCur == 1)checked#end title="#springMessage('config.fex.standardCurrency')">
                            <input type="radio" name="fex.profitLossCur" value="2" #if($config.fex.profitLossCur == 2)checked#end title="#springMessage('config.fex.quotationCurrency')">
                        </div>
                    </td>
                </tr>
                <tr>
                    ##估值的默认外汇牌价类型
                    <td class="textRight">#springMessage('config.fex.valuationRateTypeDefault')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexratetype/listFexRateTypeAll"
                                 data-name ="fex.valuationRateTypeDefault" data-biz-name ="fex.valuationRateTypeDefault" data-valueField="id" data-textField="typeName"
                                 data-defaultvalue="$!{config.fex.valuationRateTypeDefault}" data-required="required"></div>
                        </div>
                        <div class="layui-input-inline">
                            <i id="valuationRateTypeDefault-desc" class="layui-icon">&#xe60b;</i>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##估值汇率取
                    <td class="textRight">#springMessage('config.fex.valuationExchangeRate')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="radio" name="fex.valuationExchangeRate" value="1" #if($config.fex.valuationExchangeRate == 1)checked#end title="#springMessage('config.fex.middlePrice')">
                            <input type="radio" name="fex.valuationExchangeRate" value="2" #if($config.fex.valuationExchangeRate == 2)checked#end title="#springMessage('config.fex.buySellPrice')">
                        </div>
                    </td>
                </tr>
                <tr>
                    ##外汇即期是否计算损益
                    <td class="textRight">#springMessage('config.fex.calculatedProfitLoss')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="radio" name="fex.calculatedProfitLoss" value="1" #if($config.fex.calculatedProfitLoss == 1)checked#end title="#springMessage('nis.sc_yn.yes')">
                            <input type="radio" name="fex.calculatedProfitLoss" value="0" #if($config.fex.calculatedProfitLoss == 0)checked#end title="#springMessage('nis.sc_yn.no')">
                        </div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<table class="layui-table border0">
    <tbody>
    <tr>
        <td width="20%"></td>
        <td>
            <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
       	 	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </td>
    </tr>
    </tbody>
</table>
</form>
#parse("views/common/footer.vm")
<script>
    bt.use(['form','jquery','element','selectType','dicts'], function(){
        var form = bt.form(),$  = bt.jquery;
        var selectType = bt.selectType.init();
        var dict = bt.dicts.init();
		bt.element();
        //监听提交
        form.on('submit(configSubmit)', function(data){
            $.post(basePath + "/sys/config/save",data.field,function(result){
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },"JSON");
            return false;
        });

        // 说明显示隐藏
        showDesc();
    });

    function showDesc() {
        var tip_index1 = 0;
        $('#bisExcAutoAccount-desc').mouseenter(function () {
            tip_index1 = layer.tips(bt.lang('config.fex.transferDays.desc'), '#bisExcAutoAccount-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index1);
        });

        var tip_index2 = 0;
        $('#isSkipSettle-desc').mouseenter(function () {
            tip_index2 = layer.tips(bt.lang('config.fex.isSkipSettle.desc'), '#isSkipSettle-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index2);
        });

        var tip_index3 = 0;
        $('#budgetSel-desc').mouseenter(function () {
            tip_index3 = layer.tips(bt.lang('config.fex.budgetSel.desc'), '#budgetSel-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index3);
        });

        var tip_index4 = 0;
        $('#payItem-desc').mouseenter(function () {
            tip_index4 = layer.tips(bt.lang('config.fex.payItem.desc'), '#payItem-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index4);
        });

        var tip_index5 = 0;
        $('#tranRateTypeDefault-desc').mouseenter(function () {
            tip_index5 = layer.tips(bt.lang('config.fex.tranRateTypeDefault.desc'), '#tranRateTypeDefault-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index5);
        });

        var tip_index6 = 0;
        $('#valuationRateTypeDefault-desc').mouseenter(function () {
            tip_index6 = layer.tips(bt.lang('config.fex.valuationRateTypeDefault.desc'), '#valuationRateTypeDefault-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index6);
        });
    }
</script>
</body>
</html>

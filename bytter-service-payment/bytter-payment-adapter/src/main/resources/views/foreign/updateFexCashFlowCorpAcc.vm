<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fexCashFlowPage.id}">
		<input id="opType" name="opType" type="hidden" value="$!{fexCashFlowPage.opType}">
		<input id="corpId" name="corpId" type="hidden" value="$!{fexCashFlowPage.corpId}">
		<input id="curId" name="curId" type="hidden" value="$!{fexCashFlowPage.curId}">
		<input id="tranType" name="tranType" type="hidden" value="$!{fexCashFlowPage.tranType}">

		<input id="corpAccBankTypeId"  type="hidden" value="$!{corpAcc.bankTypeId}">
		<input id="corpAccCountryId"  type="hidden" value="$!{corpAcc.countryId}">
		<input id="corpAccBifCode"  type="hidden" value="$!{corpAcc.bifCode}">
		<table class="layui-table">
			<tbody>
				<tr>
					##主体单位名称
    				<td class="textRight" width="40%">#springMessage('table.nisBillhead.corpId')</td>
                    <td width="60%">$!{fexCashFlowPage.corpName}</td>
				</tr>
				<tr>
					##币种
					<td class="textRight" width="40%">#springMessage('table.bisAccDtl.curName')</td>
					<td width="60%">$!{fexCashFlowPage.englishCode}</td>
				</tr>
				<tr>
					##银行账号
    				<td class="textRight">#springMessage('table.foreign.bankAcc')</td>
                    <td>
						<div class="layui-input-inline">
							<input type="text" id="corpBankAcc" name="corpBankAcc" lay-verify="required|tableData" data-biz-name="corpBankAcc" data-required = "true" value="$!{fexCashFlowPage.corpBankAcc}"
								   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.corpBankAcc')">
							<table id="corpBankAccTable" class="hide">
								<thead>
								<tr>
									<th>#springMessage('table.choBankFinance.acc')</th>
									<th>#springMessage('table.btBankAccApp.accName')</th>
									<th>#springMessage('table.btBankAcc.bankName')</th>
									<th>#springMessage('table.nisBillhead.curId')</th>
								</tr>
								</thead>
							</table>
						</div>
					</td>
				</tr>
				<tr>
					##银行
					<td class="textRight">#springMessage('common.button.bank')</td>
					<td>
						<input type="hidden" id="corpBank" name="corpBank" value="$!{fexCashFlowPage.corpBank}">
						<div id="corpBankNameDiv" name="corpBankNameDiv">$!{fexCashFlowPage.corpBankName}</div>
					</td>
				</tr>
				<tr>
					##账户名称
					<td class="textRight" width="40%">#springMessage('table.btBankAccApp.accName')</td>
					<td width="60%">
						<input type="hidden" id="corpAccId" name="corpAccId" value="$!{fexCashFlowPage.corpAccId}">
						<input type="hidden" id="corpAccName" name="corpAccName" value="$!{fexCashFlowPage.corpAccName}">
						<div id="corpAccNameDiv" name="corpAccNameDiv">$!{fexCashFlowPage.corpAccName}</div>
					</td>
				</tr>
				<tr>
					##支付方式
					<td class="textRight">#springMessage('table.foreign.voucherType')</td>
					<td>
						<div type="list" data-name ="voucherTypeId" class="bt-biz-selectType" data-url="${basePath}/netbank/fcvouchertype/getFcVoucherTypeForForeign"
							 data-valueField="id" data-textField="voucherName"  data-biz-name="voucherTypeId" data-required = "true" data-value="$!{fexCashFlowPage.voucherTypeId}"></div>
					</td>
				</tr>
				<tr>
					##备注
					<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
					<td >
						<textarea lay-verify="strlength" placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" style="width:100%" id="rmk" name="rmk"  data-maxlength="200">$!{fexCashFlowPage.rmk}</textarea>
					</td>
				</tr>
				<tr>
					<td colspan="2" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexCashFlow.edit.js?_btv=${resourceVersion}"></script>
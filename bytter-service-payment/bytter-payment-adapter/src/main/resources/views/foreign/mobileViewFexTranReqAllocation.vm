<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<!-- 调拨交易 -->

<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-divider">交易信息</li>

    <li class="mui-table-view-cell">
    ##        交易编码
        #springMessage('table.fexTranReq.billNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.billNo}
        </span>
    </li>
    <li class="mui-table-view-cell">
##        产品
        #springMessage('table.foreign.product')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.proName}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        汇款类型
    #springMessage('table.fexForeignReq.remitType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.remitType",$!{fexTranReqPage.remitType})
        </span>
    </li>

    <li class="mui-table-view-cell">
##        币种(收款方)
    #springMessage('table.bisAccDtl.curName')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.targetAccEnglishCode}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        金额
    #springMessage('table.choBankFinance.payMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexTranReqPage.payMoney})
        </span>
    </li>

    <li class="mui-table-view-cell">
##        交易日期
    #springMessage('table.revenue.transTime')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexTranReqPage.tranDate})
        </span>
    </li>

    <li class="mui-table-view-cell">
##        结算日期
    #springMessage('table.fcSubjectDay.optDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
    ##        跨行标志
        #springMessage('table.nisBillhead.difBank')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("nisBillhead.difBank",$!{fexTranReqPage.difBank})
        </span>
    </li>
    <li class="mui-table-view-cell">
##        加急标志
    #springMessage('table.nisBillhead.isQuick')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("sf_yn",$!{fexTranReqPage.isQuick})
        </span>
    </li>

    <li class="mui-table-view-cell">
##        资金性质
    #springMessage('table.fexTranReq.accNature')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexTranReq.accNature",$!{fexTranReqPage.accNature})
        </span>
    </li>
    <li class="mui-table-view-cell">
##        汇款方式
    #springMessage('table.fexForeignReq.remitMethod')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.remitMethod",$!{fexTranReqPage.remitMethod})
        </span>
    </li>

##    源账户信息
    <li class="mui-table-view-divider">#springMessage('table.fexTranReq.srcBankInfo')</li>

    <li class="mui-table-view-cell">
##        银行
    #springMessage('common.button.bank')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.srcBankName}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        银行账户
    #springMessage('table.fexForeign.bankAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.srcBankAcc}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        账户名称
    #springMessage('table.btBankAccApp.accName')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.srcAccName}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        单位
    #springMessage('table.fbsBudget.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.corpName}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        资金用途
    #springMessage('table.fexTranReq.capitalUse')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.capitalUse}
        </span>
    </li>

##    目标账户信息
    <li class="mui-table-view-divider">#springMessage('table.fexTranReq.targetBankInfo')</li>

    <li class="mui-table-view-cell">
##        银行
    #springMessage('common.button.bank')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.targetBankName}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        银行账户
    #springMessage('table.fexForeign.bankAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.targetBankAcc}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        账户名称
    #springMessage('table.btBankAccApp.accName')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.targetAccName}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        单位
    #springMessage('table.fbsBudget.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.targetCorpName}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        代理行
    #springMessage('table.fexTranReq.agentBank')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.cotpBankName}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        开户行在代理行账户
    #springMessage('table.fexTranReq.agentBankAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.agentBankAcc}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        收款人常驻国家或者地区
    #springMessage('table.fexTranReq.countryId')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.nameZh}
        </span>
    </li>

##    费用
    <li class="mui-table-view-divider">#springMessage('table.fexTranReq.costInfo')</li>

    <li class="mui-table-view-cell">
##        国内外费用承担标志
    #springMessage('table.fexForeignReq.costSign')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.costSign",$!{fexTranReqPage.costSign})
        </span>
    </li>

    <li class="mui-table-view-cell">
##        费用支出账户
    #springMessage('table.fexTranReq.costAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.costAcc}
        </span>
    </li>

##    备注
    <li class="mui-table-view-divider">#springMessage('fcVoucherType.rmk')</li>

    <li class="mui-table-view-cell">
##        备注
    #springMessage('bisAccAttribute.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.rmk}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        交易员
    #springMessage('table.fexTranReq.dealer')
        <span class="mui-badge mui-badge-inverted">
            $!{dealer}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        交易地点
    #springMessage('table.fexTranReq.tranAddr')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranAddr}
        </span>
    </li>

    <li class="mui-table-view-cell">
##    交易组
    #springMessage('table.fexTranReq.tranGroup')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranGroupName}
        </span>
    </li>

</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

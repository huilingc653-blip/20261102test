<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<table class="layui-table layui-form dark-layui-table" style="width:100%;" >
    <thead>
    <tr>
        <th>#springMessage('table.fexProduct.name')</th>
        <th>#springMessage('table.fexProduct.proId')</th>
        <th>#springMessage('table.fexProduct.proLevel')</th>
        <th>#springMessage('bisAccAttribute.validSign')</th>
    </tr>
    </thead>
    <tbody >
        #if($!list)
            #foreach($data in $list)
            <tr>
                <td>$!{data.proName}</td>
                <td>$!{data.parentProName}</td>
                <td>$dictTag.get("fexProduct.proLevel",$!{data.proLevel})</td>
                <td align="center">$dictTag.get("valid_sign",$!{data.validSign})</td>
            </tr>
            #end
        #end
    </tbody>
</table>
<br />
<br />
<div class="layui-form-item layui-form-submit" id="buttonDiv">
    <div class="layui-input-block">
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
</html>

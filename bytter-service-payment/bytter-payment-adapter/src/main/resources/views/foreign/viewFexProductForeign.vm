<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	<table class="layui-table">
		<tbody>
			##产品名称
		<tr>
			<td class="textRight" width="40%">#springMessage('table.fexProduct.proName')</td>
			<td width="60%">
				$!{fexProductPage.proName}
			</td>
		</tr>
			##产品描述
		<tr>
			<td class="textRight" width="40%">#springMessage('table.fexProduct.proDesc')</td>
			<td width="60%">
				$!{fexProductPage.proDesc}
			</td>
		</tr>
			##所属产品组
		<tr>
			<td class="textRight">#springMessage('table.fexProduct.proId')</td>
			<td>
				$!{fexProductPage.parentProName}
			</td>
		</tr>
			##外汇交易类型
		<tr>
			<td class="textRight">#springMessage('table.fexProduct.fexTranType')</td>
			<td>
				$dictTag.get("fexProduct.fexTranType",$!{fexProductPage.fexTranType})
			</td>
		</tr>
			##外汇业务类型
		<tr>
			<td class="textRight">
				<span class="original #if($!{fexProductPage.fexTranType} == 2) layui-hide #end">#springMessage('table.fexProduct.fexBusType')</span>
				<span class="jinduan #if($!{fexProductPage.fexTranType} != 2) layui-hide #end">#springMessage('table.fexProduct.fexBusType.nearEnd')</span>
			</td>
			<td>
				$dictTag.get("fexProduct.fexBusType",$!{fexProductPage.fexBusType})
			</td>
		</tr>
			##即期是否自动交割
		<tr id="isAutoDeliveryTr" #if($!{fexProductPage.fexTranType} != 0) style="display: none;" #end>
			<td class="textRight">#springMessage('table.fexProduct.isAutoDelivery')</td>
			<td>
				$dictTag.get("sf_yn",$!{fexProductPage.isAutoDelivery})
			</td>
		</tr>
			##交割类型
		<tr>
			<td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
			<td>
				$dictTag.get("fexProduct.deliveryType",$!{fexProductPage.deliveryType})
			</td>
		</tr>
			##默认交割币种
			#if($!{fexProductPage.deliveryType}=="1")
			<tr id="deliveryCurTR">
			#else
			<tr id="deliveryCurTR" style="display: none">
			#end
			<td class="textRight">#springMessage('table.fexProduct.deliveryCurId')</td>
			<td>
				#if($!{fexProductPage.deliveryEnglishCode})
					$!{fexProductPage.deliveryEnglishCode}
				#end
			</td>
		</tr>
			##是否允许多次交割
		#*<tr>
			<td class="textRight">#springMessage('table.fexProduct.isAllowedDelivery')</td>
			<td>
				$dictTag.get("sf_yn",$!{fexProductPage.isAllowedDelivery})
			</td>
		</tr>*#
			##非工作日是否允许结算
		<tr>
			<td class="textRight">#springMessage('table.fexProduct.isAllowedSettle')</td>
			<td>
				$dictTag.get("sf_yn",$!{fexProductPage.isAllowedSettle})
			</td>
		</tr>
			##默认买入币种
		<tr>
			<td class="textRight">
				<span class="original #if($!{fexProductPage.fexTranType} == 2) layui-hide #end">#springMessage('table.fexProduct.buyCurId')</span>
				<span class="jinduan #if($!{fexProductPage.fexTranType} != 2) layui-hide #end">#springMessage('table.fexProduct.buyCurId.nearEnd')</span>
			</td>
			<td>
				#if($!{fexProductPage.buyEnglishCode})
					$!{fexProductPage.buyEnglishCode}
				#end
			</td>
		</tr>
			##默认卖出币种
		<tr>
			<td class="textRight">
				<span class="original #if($!{fexProductPage.fexTranType} == 2) layui-hide #end">#springMessage('table.fexProduct.sellCurId')</span>
				<span class="jinduan #if($!{fexProductPage.fexTranType} != 2) layui-hide #end">#springMessage('table.fexProduct.sellCurId.nearEnd')</span>
			</td>
			<td>
				#if($!{fexProductPage.sellEnglishCode})
					$!{fexProductPage.sellEnglishCode}
				#end
			</td>
		</tr>
			##有效标志
		<tr>
			<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
			<td>
				$dictTag.get("valid_sign",$!{fexProductPage.validSign})
			</td>
		</tr>
			##备注
		<tr>
			<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
			<td >
				$!{fexProductPage.rmk}
			</td>
		</tr>
		<tr>
			<td colspan="2" style="text-align: center">
				<button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
			</td>
		</tr>
		</tbody>
	</table>
</form>
</body>
	#parse("views/common/footer.vm")
	<script>
		bt.use(["jquery", "form", "btUpload"], function () {
			$ = bt.jquery;
			form = bt.form();
			var gid = $("#gid").val();
			upload = bt.btUpload.init({
				elem: "#uploader",
				hasDelete: false,
				hasUpload: false,
				isExpand: true,
				auto: false,
				gid: gid
			});

			/**
			 * 查看
			 * @param id
			 */
			view = function (id) {
				if (bt.navtab) {
					bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/foreign/fextranreq/view/" + id);
					return;
				}
				parent.layer.open({
					type: 2,
					area: ['850px', '530px'],
					maxmin: true,
					content: basePath + "/foreign/fextranreq/view/" + id
				});
			}
		});
		//关闭窗口
		function doClose() {
			if (bt.navtab) {
				bt.navtab.closeCurrent();
			}
		}
	</script>
</html>

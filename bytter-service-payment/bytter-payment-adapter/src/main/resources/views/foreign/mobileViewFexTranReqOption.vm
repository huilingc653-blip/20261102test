<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<!-- 外汇期权 -->
<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell">
        ##交易类型
        #springMessage('table.foreign.tranType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexCorp.tranType",$!{fexTranReqPage.tranType})
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##产品
        #springMessage('table.foreign.product')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.proName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##外汇期权品种
        #springMessage('table.fexProduct.fexOption')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexProduct.fexOption1",$!{fexTranReqPage.fexOption1})&nbsp;
            $dictTag.get("fexProduct.fexOption2",$!{fexTranReqPage.fexOption2})&nbsp;
            $dictTag.get("fexProduct.fexOption3",$!{fexTranReqPage.fexOption3})
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##外汇期权类型
        #springMessage('table.fexProduct.fexOptionType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexProduct.fexOptionType",$!{fexTranReqPage.fexOptionType})
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##买卖方向
        #springMessage('fex.tranApp2.businessDirection')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexTranDeal.deliverySign",$!{fexTranReqPage.busDirection})
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##涨跌方向
        #springMessage('fex.tranApp2.upAndDownDirection')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fex.tranApp2.updownDirection",$!{fexTranReqPage.updownDirection})
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##协定汇率
        #springMessage('table.fexTranReq.agreeRate')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatDoubles($!{fexTranReqPage.contractRate}, 6)
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##交易日期
        #springMessage('table.revenue.transTime')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexTranReqPage.tranDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##到期日期
        #springMessage('table.fcAcc.deadlineDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd HH:mm:ss',$!{fexTranReqPage.expiresDate})
        </span>
    </li>
    #if($!{fexTranReqPage.fexOption2}=="2" || $!{fexTranReqPage.fexOption2}=="3")
        <li class="mui-table-view-cell">
            ##障碍值/低障碍值
            #if($!{fexTranReqPage.fexOption2}=="2")
                #springMessage('table.fexTranReq.exceptVal')
            #else
                #springMessage('table.fexTranReq.exceptLowVal')
            #end
            <span class="mui-badge mui-badge-inverted">
                $!number.formatDoubles($!{fexTranReqPage.exceptLowVal},4)
            </span>
        </li>
        #if($!{fexTranReqPage.fexOption2}=="3")
        <li class="mui-table-view-cell">
            ##高障碍值
            #springMessage('table.fexTranReq.exceptHignVal')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatDoubles($!{fexTranReqPage.exceptHignVal},4)
            </span>
        </li>
        #end
    #end
    <li class="mui-table-view-cell">
        ##买权币种
        #springMessage('table.fexTranReq.buyCurIdOption')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.buyEnglishCode}
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##买权金额
        #springMessage('table.fexTranReq.buyMoneyOption')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexTranReqPage.buyMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##卖权币种
        #springMessage('table.fexTranReq.sellCurIdOption')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.sellEnglishCode}
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##卖权金额
        #springMessage('table.fexTranReq.sellMoneyOption')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexTranReqPage.sellMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##结算日期
        #springMessage('table.fcSubjectDay.optDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##结算币种
        #springMessage('table.fexTranDeal.settleCurId')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.englishCode}
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##期权费币种
        #springMessage('table.fexTranReq.premiumCur')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.premiumEnglishCode}
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##期权费金额
        #springMessage('table.fexTranReq.premiumMoney.settleCur')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexTranReqPage.premiumMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        ##备注
        #springMessage('fcVoucherType.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.rmk}
        </span>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

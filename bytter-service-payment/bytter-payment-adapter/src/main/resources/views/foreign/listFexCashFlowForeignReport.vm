<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
            <tr>
                ##单位
                <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-tree-type="check"
                             data-name="ins_corpId"
                             data-resource="foreign:fextranreq:cashflow:report:query"
                             data-scope="all"></div>
                    </div>
                </td>
                ##交易号码
                <td class="textRight">#springMessage('table.fexTranReq.billNo')</td>
                <td>
                    <input type="text" name="likes_tranBillNo"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.billNo')">
                </td>
                ##币种
                <td class="textRight">#springMessage('table.bisAccDtl.curName')</td>
                <td>
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_curId" data-biz-name ="eqs_curId"
                         data-valueField="id" data-textField="englishCode"></div>
                </td>
            </tr>
            </tr>
            <tr>
                ##产品
                <td class="textRight">#springMessage('table.choProduct.productName')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProduct/1" data-name ="eqs_proId" data-biz-name ="eqs_proId"
                             data-valueField="id" data-textField="proName"></div>
                    </div>
                </td>
                ##交易对手
                <td class="textRight">#springMessage('table.fexForeign.copt')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-mulselectType" data-url="${basePath}/foreign/fexCotp/listBankCotp" data-name ="ins_cotpId" data-biz-name ="ins_cotpId"
                             data-valueField="id" data-textField="cotpName" data-method="get"></div>
                    </div>
                </td>
                ##结算日期
                <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                <td>
                    <input type="text" name="ged_settleDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_settleDate" data-today="true" >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_settleDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_settleDate" data-today="true">
                </td>
            </tr>
            <tr>
                ##现金流类型
                <td class="textRight">#springMessage('table.fexBankAcc.cashFlowType')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="fexCorp.cashFlowType" data-name="eqi_cashFlowType"></div>
                </td>
                ##交易组号码
                <td class="textRight">#springMessage('table.fexTranGroup.billNo')</td>
                <td>
                    <input type="text" name="likes_tranGroupBillNo"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranGroup.billNo')">
                </td>
                ##交易日期
                <td class="textRight">#springMessage('table.revenue.transTime')</td>
                <td>
                    <input type="text" name="ged_tranDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_tranDate" data-today="true" >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_tranDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_tranDate" data-today="true">
                </td>
            </tr>
            #if($shiro.hasPermission("foreign:fextranreq:cashflow:report:query"))
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            #end
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.nisBillhead.corpId')</th>
            <th>#springMessage('table.fexBankAcc.proId')</th>
            <th>#springMessage('table.fexTranReq.billNo')</th>
            <th>#springMessage('table.fexTranGroup.billNo')</th>
            <th>#springMessage('fex.cotp')</th>
            <th>#springMessage('table.fexBankAcc.cashFlowType')</th>
            <th>#springMessage('table.bisAccDtl.curName')</th>
            <th>#springMessage('table.revenue.transTime')</th>
            <th>#springMessage('table.fcSubjectDay.optDate')</th>
            <th>#springMessage('common.button.bank')</th>
            <th>#springMessage('table.foreign.bankAcc')</th>
            <th>#springMessage('table.choBankFinance.payMoney')</th>
            <th>#springMessage('table.fexTranReq.contractRate')</th>
        </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexCashFlowForeign.report.js?_btv=${resourceVersion}"></script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form ignore-required-icon" method="post">
		<input id="id" name="id" type="hidden" value="$!{fexCustFieldRulePage.id}">
        <input id="rule1" type="hidden" value="$!{fexCustFieldRulePage.rule1}">
        <input id="fieldType" type="hidden" value="$!{fexCustFieldRulePage.fieldType}">
        <input id="appRange1" type="hidden" value="$!{fexCustFieldRulePage.appRange1}">

		<table class="layui-table">
            <tbody>
            <tr>
				<td class="textRight"><span style="color:red">*</span>#springMessage('table.field.name')</td>
				<td style="width: 35%">
                    <input type="text" id="fieldName" name="fieldName" autocomplete="off" class="layui-input" value="$!{fexCustFieldRulePage.fieldName}" lay-verify="required|strlength" data-maxlength="50">
				</td>

				<td class="textRight"><span style="color:red">*</span>#springMessage('table.fex.fieldDesc')</td>
				 <td style="width: 35%">
                     <input type="text" id="fieldDesc" name="fieldDesc"  autocomplete="off" class="layui-input" value="$!{fexCustFieldRulePage.fieldDesc}" lay-verify="required|strlength" data-maxlength="50">
                 </td>
			</tr>

			<tr>
				<td class="textRight"><span style="color:red">*</span>#springMessage('table.fex.appRange1')</td>
        		<td>
        			<div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="select" data-required="true" data-group="application.scope" data-name="appRange1"  data-callback="editScope" data-defaultvalue="$!{fexCustFieldRulePage.appRange1}"></div>
                        <div class="bt-biz-dict"
                             id="appRange2"
                             data-required="true"
                             data-type="select"
                             data-group="application.scope2"
                             data-name="appRange2"
                             data-biz-name="appRange2"
                             data-displayData="1,2,3,4"
                             data-defaultvalue="$!{fexCustFieldRulePage.appRange2}"
                             style="display:none;"></div>
                        <div class="bt-biz-selectType"
                             id="cotpGroup"
                             data-biz-name="cotpGroup"
                             data-url="${basePath}/foreign/fexCotp/listCotpGroup"
                             data-valuefield="id"
                             data-textfield="cotpName"
                             data-name="cotpGroup"
                             data-extraData="false"
                             data-defaultvalue="$!{fexCustFieldRulePage.appRange2}"
                             style="display:none;"></div>
					</div>
        		</td>

        		<td class="textRight"><span style="color:red">*</span>#springMessage('contract.field.type')</td>
                <td>
               		<div class="layui-input-inline">
                    	<div class="bt-biz-dict"  data-type="select" data-required="true" data-group="field.type" data-name="fieldType"
                             data-biz-name="fieldType"
                             data-displayData="1,2,3,4,5"
                             data-callback="editNum" data-value="$!{fexCustFieldRulePage.fieldType}"></div>
					</div>
                </td>
			</tr>

			<tr>
				<td class="textRight">#springMessage('table.fex.controlRule')</td>
				<td colspan="3">
                    <table class="layui-table" style="width: 100%">
                        <tr>
                            <td>##使用预设值
                                <input type="checkbox" lay-skin="primary" id="" name="controlRule" value="1"
                                       lay-filter="test" #if("$!{fexCustFieldRulePage.rule1}" == "1") checked="checked" #end > #springMessage("table.fex.Use.preset.values")
                            </td>
                            <td></td>
                            <td></td>


                        </tr>
                        <tr class="change1" style="display:none;">
                            <td></td>
                            <td>##允许录入非预设值
                                <input type="checkbox" lay-skin="primary" id="" name="controlRule" value="2"
                                    #if("$!{fexCustFieldRulePage.rule2}" == "2") checked="checked" #end  > #springMessage('table.fex.Allow.to.enter.non.default.value')
                            </td>

                            <td>##录入非预设值时给予提现
                                <input type="checkbox" lay-skin="primary" id="" name="controlRule" value="3"
                                    #if("$!{fexCustFieldRulePage.rule3}" == "3") checked="checked" #end > #springMessage('table.fex.Withdraw.when.entering.non.default.value')
                            </td>
                        </tr>
                        <tr>
                            <td>##此字段为比录项
                                <input type="checkbox" lay-skin="primary" id="" name="controlRule" value="4"
                                    #if("$!{fexCustFieldRulePage.rule4}" == "4") checked="checked" #end > #springMessage('table.fex.This.field.is.comparative.entry')
                            </td>
                            <td></td>
                            <td></td>
                        </tr>
                    </table>
        		</td>
			</tr>

			<tr class="change1" style="display:none;">
                <td class="textRight">#springMessage('table.fex.presetVal')</td>
				<td colspan="3" width="86%">
                    <textarea id="presetVal" style="min-height:70px" class="layui-textarea" name="presetVal" lay-verify="strlength" data-maxlength="200">$!{fexCustFieldRulePage.presetVal}</textarea>
                    <div style="font-size: 12px; color: red;word-break: break-all;white-space: normal;">#springMessage('table.fex.note')</div>
                </td>
			</tr>

            <tr class="change" style="display:none;">
                <td class="textRight"><span style="color:red">*</span>#springMessage('table.fex.decimalDigit')</td>
                <td colspan="3">
                    <input name="decimalDigit" data-id="decimalDigit" type="text" class="layui-input bt-biz-moneyType" data-min="0" data-decimal="0" value="$!{fexCustFieldRulePage.decimalDigit}">
                </td>
            </tr>

            <tr class="change" style="display:none;">
                <td class="textRight">#springMessage('table.fex.Numerical.range')</td>
                <td colspan="3">
                    <div class="layui-inline">
                        <input type="text" data-name="minVal" class="layui-input bt-biz-moneyType textRight" value="$!{fexCustFieldRulePage.minVal}"
                               data-moneyendid="maxtVal" autocomplete="off" >
                    </div>
                    <span class="date-mid">#springMessage('table.depositRate.range')</span>
                    <div class="layui-inline">
                        <input type="text" id="maxtVal" data-name="maxtVal" class="layui-input bt-biz-moneyType textRight" value="$!{fexCustFieldRulePage.maxtVal}"
                               autocomplete="off" >
                    </div>
                </td>
            </tr>

            <tr class="change" style="display:none;">
                <td class="textRight">#springMessage('table.ratBkrationRelief.curCode')</td>
                <td colspan="3">
                    <div class="bt-biz-selectType"
                         data-biz-name="curId"
                         data-url="${basePath}/basic/business/btcurrency/json"
                         data-valuefield="id"
                         data-textfield="englishCode"
                         data-name="curId"
                         data-value="$!{fexCustFieldRulePage.curId}"></div>
                </td>
            </tr>
            </div>

            <tr>
                <td class="textRight">#springMessage('table.fbsItem.validSign')</td>
                <td colspan="3">
                    <div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="radio" data-biz-name="validSign" data-required="true"
                             data-group="valid_sign" data-name="validSign" data-defaultvalue="$!{fexCustFieldRulePage.validSign}"></div>
                    </div>
                </td>
            </tr>
            </tbody>
			</table>

            <div class="layui-form-item" style="text-align: center">
                <div>
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </div>
            </div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>

var dict;
var selectType;
bt.use(['form','layedit','selectTree','select','btdate','corp','moneyType','selectType','dicts'], function(){
	var $ = bt.jquery, form = bt.form();
    bt.corp.init();
    selectType = bt.selectType.init();
    dict = bt.dicts.init();
    bt.moneyType.init();
    bt.moneyType.init({elem:$('[data-type="int"]'),decimal:0,minus:true});

    editChange();

    //监听提交
    form.on('submit(submit)', function(data){
        var action = "/foreign/fexcustfieldrule/modify";
        var controlRules = [];
        $('input[name="controlRule"]:checked').each(function () {
            controlRules.push($(this).val());
        });
        data.field.controlRule = controlRules.join(',');
        if ($("#rule1").val() == "1") {
            data.field.fieldType = $('select[name="fieldType"]').val() || $("#fieldType").val();
            data.field.presetVal = $("#presetVal").val();
        }
        if(data.field.appRange1 =="0"){
            data.field.appRange2 = selectType.get('cotpGroup').val();
        }
        $.post(basePath + action,data.field,function(result){
        	parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            if(result.success){
            	if(!bt.navtab){
                	parent.layer?parent.layer.closeAll():layer.closeAll();
            	}else{
                	bt.navtab.closeCurrent();
            	}
            }
        },'JSON');
        return false;
    });

    form.on('checkbox(test)', function(data){
        if(data.elem.checked){
            $(".change1").show();
        }else {
            $(".change1").hide();
        }
    });

});


function editScope(data){
    var val = data.value;
    if(val=="0"){
       $("#appRange2").hide();
       $("#cotpGroup").show();
    }else {
        $("#appRange2").show();
        $("#cotpGroup").hide();
    }
}



function editNum(data) {
    var val = data.value;
    var $decimalDigit = $("input[name='decimalDigit'], input[data-id='decimalDigit']");
    if(val=="2") {
        $(".change").show();
        $decimalDigit.attr("lay-verify", "required");
    }else {
        $(".change").hide();
        $decimalDigit.removeAttr("lay-verify");
    }
}

function lockPresetRuleFields() {
    dict.get('fieldType').attr({'data-disabled': true});
    $('input[name="controlRule"]').attr('disabled', true);
    bt.form().render('checkbox');
    $('#presetVal').attr('readonly', true);
}

function editChange() {
    var rule1 = $("#rule1").val();
    var fieldType = $("#fieldType").val();
    var appRange1 = $("#appRange1").val();

    if(rule1 == "1"){
        $(".change1").show();
        lockPresetRuleFields();
    }

    editNum({value: fieldType});

    if(appRange1 == "0"){
        $("#cotpGroup").show();
    }else {
        $("#appRange2").show();
    }
}

</script>

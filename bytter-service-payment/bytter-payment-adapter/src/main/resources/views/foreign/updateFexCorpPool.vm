<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{fexCorpPoolPage.id}">
    <input id="poolId" name="poolId" type="hidden" value="$!{fexCorpPoolPage.poolId}">
    <input id="corpId" name="corpId" type="hidden" value="$!{fexCorpPoolPage.corpId}">
    <input id="curId" name="curId" type="hidden" value="$!{fexCorpPoolPage.curId}">
    <input id="corpName" name="corpName" type="hidden" value="$!{fexCorpPoolPage.corpName}">
    <input id="englishCode" name="englishCode" type="hidden" value="$!{fexCorpPoolPage.englishCode}">
    <input id="parentSign" name="parentSign" type="hidden" value="$!{fexCorpPoolPage.parentSign}">
    <table class="layui-table">
        <tbody>
        <tr>
            ##资金池主体单位
            <td class="textRight" width="30%">
                #springMessage('nis.pool.fcCorpPool.pool')
            </td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexcorppool/getUserCorpPools"
                         data-name="netId" data-biz-name="netId" data-callback="netIdCallback"
                         data-valuefield="id" data-textfield="showName" data-search="true"
                         data-defaultValue="$!{fexCorpPoolPage.poolId}"
                         data-required="required"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##资金池性质
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.poolNature')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="fexCorpPool.poolNature" data-name="poolNature"
                     data-required="true" data-defaultValue="$!{fexCorpPoolPage.poolNature}"></div>
            </td>
        </tr>
        <tr>
            ##是否限额管控
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.isLimitControl')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="isLimitControl"
                     data-required="true"
                     data-defaultValue="$!{fexCorpPoolPage.isLimitControl}" data-callback="isLimitCallBack"></div>
            </td>
        </tr>
        <tr>
            ##限额折算币种
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.curId')</td>
            <td>
                #if($!{fexCorpPoolPage.isLimitControl} == "1")
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name="curId" data-biz-name="curId" data-valueField="id" data-textField="englishCode"
                         data-callback="curCallBack" data-required="true"
                         data-defaultValue="$!{fexCorpPoolPage.curId}"></div>
                #else
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name="curId" data-biz-name="curId" data-valueField="id" data-textField="englishCode"
                         data-callback="curCallBack"
                         data-defaultValue="$!{fexCorpPoolPage.curId}"></div>
                #end
            </td>
        </tr>
        <tr>
            ##限额折算汇率类型
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.rateType')</td>
            <td>
                #if($!{fexCorpPoolPage.isLimitControl} == "1")
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btratetype/json"
                         data-name="rateType" data-biz-name="rateType" data-valueField="id" data-textField="typeName" data-required="true" data-defaultValue="$!{fexCorpPoolPage.rateType}"></div>
                #else
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btratetype/json"
                         data-name="rateType" data-biz-name="rateType" data-valueField="id"
                         data-textField="typeName" data-defaultValue="$!{fexCorpPoolPage.rateType}"></div>
                #end
            </td>
        </tr>
        <tr>
            ##限额设置
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.limit')</td>
            <td>
                #if($!{fexCorpPoolPage.isLimitControl} == "1")
                    <div class="bt-biz-dict" data-type="checkbox" data-group="fexCorpPoolLimit.limitType"
                         data-name="limitTypes" data-biz-name="limitTypes"
                         id="limitTypes" data-callback="typeCallBack" data-required="true"
                         data-defaultValue="$!{fexCorpPoolPage.limitType}"></div>
                #else
                    <div class="bt-biz-dict" data-type="checkbox" data-group="fexCorpPoolLimit.limitType"
                         data-name="limitTypes" data-biz-name="limitTypes"
                         id="limitTypes" data-callback="typeCallBack"
                         data-defaultValue="$!{fexCorpPoolPage.limitType}"></div>
                #end
            </td>
        </tr>
        <tr>
            ##限额金额
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.limitMoney')</td>
            <td>
                <div class="layui-input-inline" style="width:100%">
                    #if($!{fexCorpPoolPage.limitMoney1})
                        <input type="text" id="limitMoney1" data-biz-name="limitMoney1" data-name="limitMoney1"
                               style="display: inline-block;"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               placeholder="#springMessage('table.fexCorpPool.externalDebtBalance')"
                               value="$!{fexCorpPoolPage.limitMoney1}" lay-verify="required">
                    #else
                        <input type="text" id="limitMoney1" data-biz-name="limitMoney1" data-name="limitMoney1"
                               style="display: inline-block;"
                               value="$!{fexCorpPoolPage.limitMoney1}"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               placeholder="#springMessage('table.fexCorpPool.externalDebtBalance')"
                               readonly="readonly">
                    #end

                    #if($!{fexCorpPoolPage.limitMoney2})
                        <input type="text" id="limitMoney2" data-biz-name="limitMoney2" data-name="limitMoney2"
                               style="display: inline-block;"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               placeholder="#springMessage('table.fexCorpPool.externalLoan')"
                               value="$!{fexCorpPoolPage.limitMoney2}" lay-verify="required">
                    #else
                        <input type="text" id="limitMoney2" data-biz-name="limitMoney2" data-name="limitMoney2"
                               style="display: inline-block;"
                               value="$!{fexCorpPoolPage.limitMoney2}"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               placeholder="#springMessage('table.fexCorpPool.externalLoan')"
                               readonly="readonly">
                    #end
                    #if($!{fexCorpPoolPage.limitMoney3})
                        <input type="text" id="limitMoney3" data-biz-name="limitMoney3" data-name="limitMoney3"
                               style="display: inline-block;"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               placeholder="#springMessage('table.fexCorpPool.NetInflow')"
                               value="$!{fexCorpPoolPage.limitMoney3}" lay-verify="required">
                    #else
                        <input type="text" id="limitMoney3" data-biz-name="limitMoney3" data-name="limitMoney3"
                               style="display: inline-block;"
                               value="$!{fexCorpPoolPage.limitMoney3}"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               placeholder="#springMessage('table.fexCorpPool.NetInflow')"
                               readonly="readonly">
                    #end

                </div>
            </td>
        </tr>
        <tr>
            ##有效标志
            <td class="textRight" width="30%">#springMessage('table.btCurrency.validSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="1"
                     data-name="validSign" data-required="true" data-defaultValue="$!{fexCorpPoolPage.validSign}"></div>
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight" width="30%">#springMessage('table.fcCorpPool.rmk')</td>
            <td>
                <textarea type="text" id="rmk" name="rmk" class="layui-textarea" maxlength="40"
                          placeholder="#springMessage('table.fcCorpPool.rmk')">$!{fexCorpPoolPage.rmk}</textarea>
            </td>
        </tr>

        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-colla-item ignore-required-icon layui-form">
        <table id="dataTable" style="width:100%;">
            <thead>
            <tr>
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                    'table.fexCorpPool.mainAccount')</th>##主账号
                <th>#springMessage('table.nisBillhead.corpId')</th>##单位
                <th>#springMessage('contract.currency')</th>##币种
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                    'table.fexCorpPool.accNature')</th>##账户资金性质
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexCorpPool.edit.js?_btv=${resourceVersion}"></script>
</html>

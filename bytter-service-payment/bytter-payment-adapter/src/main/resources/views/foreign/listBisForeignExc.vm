<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        .col-error{
            color: red;
        }
    </style>
</head>
<body>
    <form id="searchForm" class="layui-form">
		<input id="opType" name="opType" type="hidden" value="list">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##单位ID
                    <td class="textRight">#springMessage('table.bisExc.corpId')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="ins_corpId"
                                 data-scope="all"
                                 data-resource="foreign:foreignExc:bisForeignExc:query"></div>
                        </div>
                    </td>
                    ##汇款账号
                    <td class="textRight">#springMessage('table.fexForeignReq.payerAcc')</td>
                    <td>
                        <input type="text" name="likes_payerAcc"
                               autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.fexForeignReq.payerAcc')">
                    </td>
                    ##汇款金额
                    <td class="textRight">#springMessage('table.fexForeignReq.payMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_payMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.fexForeignReq.payMoney')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_payMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.fexForeignReq.payMoney')">
                        </div>
                    </td>
                </tr>
                <tr>
                    ##指令编号
                    <td class="textRight">#springMessage('table.bisExc.voucherNo')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_voucherNo"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.voucherNo')">
                        </div>
                    </td>
                    ##申请日期
                    <td class="textRight">#springMessage('table.bisExc.reqDate')</td>
                    <td>
                        <input type="text" name="ged_reqDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_reqDate" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_reqDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_reqDate">
                    </td>
                    ##交易状态
                    <td class="textRight">#springMessage('table.bisExc.voucherStat')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="mulselect" data-group="bisExc.voucherStat" data-name="ins_voucherStat" data-filterData="w,p,8,R"></div>
                    </td>

                </tr>
                <tr>
                    ##银行类别
                    <td class="textRight">#springMessage('table.bisBifInit.bankType')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json" data-name ="eqs_bankTypeId" data-valueField="id" data-textField="typeName" ></div>
                        </div>
                    </td>
                    ##业务单号
                    <td class="textRight">#springMessage('table.bisExc.cbsBillId')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_cbsBillNo"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.cbsBillId')">
                        </div>
                    </td>
                    ##收款账号
                    <td class="textRight">#springMessage('table.fexForeignReq.payeeAcc')</td>
                    <td>
                        <input type="text" name="likes_payeeAcc"
                               autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.fexForeignReq.payeeAcc')">
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                    #if($shiro.hasPermission("foreign:foreignExc:bisForeignExc:query"))
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    #end
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('table.bisExc.voucherNo')</th>
		<th>#springMessage('table.bisBifInit.bankType')</th>
        <th>#springMessage('table.fexForeignReq.curId')</th>
        <th>#springMessage('table.fexForeignReq.remitType')</th>
		<th>#springMessage('table.fexForeignReq.payerAcc')</th>
        <th>#springMessage('table.fexForeignReq.payerAccName')</th>
        <th>#springMessage('table.fexForeignReq.payerBank')</th>
		<th>#springMessage('table.fexForeignReq.payMoney')</th>
		<th>#springMessage('table.fexForeignReq.payeeAcc')</th>
        <th>#springMessage('table.fexForeignReq.payeeAccName')</th>
        <th>#springMessage('table.fexForeignReq.payeeBank')</th>
		<th>#springMessage('table.bisExc.reqDate')</th>
		<th>#springMessage('table.bisExc.cbsBillId')</th>
		<th>#springMessage('table.bisExc.cmdType')</th>
        <th>#springMessage('table.bisExc.voucherStat')</th>
        <th>#springMessage('table.bisExc.returnTime')</th>
        <th>#springMessage('table.bisExc.firstReturnMsg')</th>
        <th>#springMessage('table.bisExc.nextReturnMsg')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/bisForeignExc.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane ignore-required-icon">
		<input id="id" name="id" type="hidden" value="$!{ids}">
		<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
			<tr>
				<td colspan="19">#springMessage('table.fexCashFlow.cashFlow')</td>
			</tr>
			<tr>
				<th>#springMessage('table.fexCashFlow.billNo')</th>
				<th>#springMessage('table.fexTranReq.billNo')</th>
				<th>#springMessage('fcVoucherType.settlType')</th>
				<th>#springMessage('table.fexBankAcc.proId')</th>
				<th>#springMessage('table.fexTranReq.cashFlowDate')</th>
				<th>#springMessage('table.fcSubjectDay.optDate')</th>
				<th>#springMessage('table.fexBankAcc.cashFlowType')</th>
				<th>#springMessage('table.bisAccDtl.curName')</th>
				<th>#springMessage('table.foreign.cdSign')</th>
				<th>#springMessage('table.choBankFinance.payMoney')</th>
				<th>#springMessage('table.nisBillhead.corpId')</th>
				<th>#springMessage('common.button.bank')</th>
				<th>#springMessage('table.btBankAccApp.accName')</th>
				<th>#springMessage('table.foreign.bankAcc')</th>
				<th>#springMessage('fex.cotp')</th>
				<th>#springMessage('table.fexTranReq.cotpBank')</th>
				<th>#springMessage('table.fexTranReq.cotpAccName')</th>
				<th>#springMessage('table.fexForeign.cotpAcc')</th>
				<th>#springMessage('table.foreign.voucherType')</th>
			</tr>
			</thead>
			<tr>
				<td align="center">$!{fexCashFlowPage.billNo}</td>
				<td align="center">$!{fexCashFlowPage.tranBillNo}</td>
				<td align="center">$dictTag.get("fexCashFlow.settleType",$!{fexCashFlowPage.settleType})</td>
				<td>$!{fexCashFlowPage.proName}</td>
				<td align="center">$!date.format('yyyy-MM-dd',$!{fexCashFlowPage.cashFlowDate})</td>
				<td align="center">$!date.format('yyyy-MM-dd',$!{fexCashFlowPage.settleDate})</td>
				<td align="center">$dictTag.get("fexCorp.cashFlowType",$!{fexCashFlowPage.cashFlowType})</td>
				<td align="center">$!{fexCashFlowPage.englishCode}</td>
				<td align="center">$dictTag.get("nisBusType.cdSign",$!{fexCashFlowPage.cdSign})</td>
				<td align="right">$!number.formatNumeric($!{fexCashFlowPage.payMoney})</td>
				<td>$!{fexCashFlowPage.corpName}</td>
				<td>$!{fexCashFlowPage.corpBankName}</td>
				<td>$!{fexCashFlowPage.corpAccName}</td>
				<td>$!{fexCashFlowPage.corpBankAcc}</td>
				<td>
					#if($!{fexCashFlowPage.tranType} == "3")
						$!{fexCashFlowPage.allocatCotpName}
					#else
						$!{fexCashFlowPage.cotpName}
					#end
				</td>
				<td>
					#if($!{fexCashFlowPage.tranType} == "3")
						$!{fexCashFlowPage.allocatCotpBankName}
					#else
						$!{fexCashFlowPage.cotpBankName}
					#end
				</td>
				<td>$!{fexCashFlowPage.cotpAccName}</td>
				<td>$!{fexCashFlowPage.cotpBankAcc}</td>
				<td align="center">$!{fexCashFlowPage.voucherTypeName}</td>
			</tr>
		</table>

		<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
			<tr>
				<td colspan="19">#springMessage('table.fexCashFlow.cashFlowDtl')</td>
			</tr>
			<tr>
				<th>#springMessage('table.fexCashFlow.billNo')</th>
				<th>#springMessage('table.fexTranReq.billNo')</th>
				<th>#springMessage('fcVoucherType.settlType')</th>
				<th>#springMessage('table.fexBankAcc.proId')</th>
				<th>#springMessage('table.fexTranReq.cashFlowDate')</th>
				<th>#springMessage('table.fcSubjectDay.optDate')</th>
				<th>#springMessage('table.fexBankAcc.cashFlowType')</th>
				<th>#springMessage('table.bisAccDtl.curName')</th>
				<th>#springMessage('table.foreign.cdSign')</th>
				<th>#springMessage('table.choBankFinance.payMoney')</th>
				<th>#springMessage('table.nisBillhead.corpId')</th>
				<th>#springMessage('common.button.bank')</th>
				<th>#springMessage('table.btBankAccApp.accName')</th>
				<th>#springMessage('table.foreign.bankAcc')</th>
				<th>#springMessage('fex.cotp')</th>
				<th>#springMessage('table.fexTranReq.cotpBank')</th>
				<th>#springMessage('table.fexTranReq.cotpAccName')</th>
				<th>#springMessage('table.fexForeign.cotpAcc')</th>
				<th>#springMessage('table.foreign.voucherType')</th>
			</tr>
			</thead>
			#foreach($data in $dtlList)
			<tr>
				<td align="center">$!{data.billNo}</td>
				<td align="center">$!{data.tranBillNo}</td>
				<td align="center">$dictTag.get("fexCashFlow.settleType",$!{data.settleType})</td>
				<td>$!{data.proName}</td>
				<td align="center">$!date.format('yyyy-MM-dd',$!{data.cashFlowDate})</td>
				<td align="center">$!date.format('yyyy-MM-dd',$!{data.settleDate})</td>
				<td align="center">$dictTag.get("fexCorp.cashFlowType",$!{data.cashFlowType})</td>
				<td align="center">$!{data.englishCode}</td>
				<td align="center">$dictTag.get("nisBusType.cdSign",$!{data.cdSign})</td>
				<td align="right">$!number.formatNumeric($!{data.payMoney})</td>
				<td>$!{data.corpName}</td>
				<td>$!{data.corpBankName}</td>
				<td>$!{data.corpAccName}</td>
				<td>$!{data.corpBankAcc}</td>
				<td>
					#if($!{data.tranType} == "3")
						$!{data.allocatCotpName}
					#else
						$!{data.cotpName}
					#end
				</td>
				<td>
					#if($!{data.tranType} == "3")
						$!{data.allocatCotpBankName}
					#else
						$!{data.cotpBankName}
					#end
				</td>
				<td>$!{data.cotpAccName}</td>
				<td>$!{data.cotpBankAcc}</td>
				<td align="center">$!{data.voucherTypeName}</td>
			</tr>
			#end
		</table>
		<div class="layui-form-item layui-form-submit" id="buttonDiv">
			<div class="layui-input-block">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexCashFlow.merge.js?_btv=${resourceVersion}"></script>
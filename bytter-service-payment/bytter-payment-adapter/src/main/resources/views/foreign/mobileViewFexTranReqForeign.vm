<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<!-- 外汇买卖 -->
<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell">
    ##交易号码
        #springMessage('table.fexTranReq.billNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.billNo}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        交易需求编号
    #springMessage('table.fexTranReq.tranAppDtlNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranAppDtlNo}
        </span>
    </li>
    <li class="mui-table-view-cell">
    ##汇款类型
        #springMessage('table.fexForeignReq.remitType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.remitType",$!{fexTranReqPage.remitType})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##是否掉期交易
        #springMessage('table.fexTranReq.isSwapTran')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("sf_yn",$!{fexTranReqPage.isSwapTran})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##申请日期
        #springMessage('table.bisFinanceExc.reqDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexTranReqPage.createDate})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##产品
        #springMessage('table.foreign.product')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.proName}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易对手
        #springMessage('table.fexForeign.copt')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.cotpName}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##外汇业务类型
        #springMessage('table.fexProduct.fexBusType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexProduct.fexBusType",$!{fexTranReqPage.fexBusType})
        </span>
    </li>
#if($!{fexTranReqPage.fexBusType}=="1")
    <li class="mui-table-view-cell">
    ##结汇业务类型
        #springMessage('fex.tran.settleBusType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fex.tran.settleBusType",$!{fexTranReqPage.settleBusType})
        </span>
    </li>
#end
    <li class="mui-table-view-cell">
    ##交割类型
        #springMessage('table.fexProduct.deliveryType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexProduct.deliveryType",$!{fexTranReqPage.deliveryType})
        </span>
    </li>
#if($!{fexTranReqPage.deliveryType}=="1")
    <li class="mui-table-view-cell">
    ##交割币种
        #springMessage('fex.tranApp.deliveryCurId')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.deliveryEnglishCode}
        </span>
    </li>
#end
    <li class="mui-table-view-cell">
    ##外汇交易类型
        #springMessage('table.fexProduct.fexTranType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexProduct.fexTranType",$!{fexTranReqPage.fexTranType})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##买入币种
        #springMessage('table.fexTranReq.buyCurId')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.buyEnglishCode}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##买入金额
        #springMessage('table.fexTranReq.buyMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexTranReqPage.buyMoney})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##卖出币种
        #springMessage('table.fexTranReq.sellCurId')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.sellEnglishCode}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##卖出金额
        #springMessage('table.fexTranReq.sellMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexTranReqPage.sellMoney})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##合同汇率
        #springMessage('table.fexTranReq.contractRate')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatDoubles($!{fexTranReqPage.contractRate}, 6)
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##远期汇率
        #springMessage('table.fexTranDeal.wishRate')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatDoubles($!{fexTranReqPage.spotRate}, 6)
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##远期点数
        #springMessage('table.fexTranReq.forwardPoints')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexTranReqPage.forwardPoints})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易编码
        #springMessage('table.fexTranInfo.tranCode')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranName1}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##钞汇标识
        #springMessage('table.fexTranReq.bankNote')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fex.tranApp.bankNote",$!{fexTranReqPage.bankNote})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易日期
        #springMessage('table.revenue.transTime')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexTranReqPage.tranDate})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##结算日期
        #springMessage('table.fcSubjectDay.optDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交割期限
        #springMessage('table.fexTranReq.deliveryDeadline')
        <span class="mui-badge mui-badge-inverted">
            T+$!{fexTranReqPage.deliveryDeadline}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##保证方式
        #springMessage('table.fexTranReq.boodType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fex.tranApp.boodType",$!{fexTranReqPage.boodType})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##保证金账号
        #springMessage('table.fexTranReq.boodAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.boodAcc}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##保证金比例
        #springMessage('table.fexTranReq.boodRatio')
        <span class="mui-badge mui-badge-inverted">
            $!rateTag.show($!{fexTranReqPage.boodRatio},2)
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##保证金钞汇标识
        #springMessage('table.fexForeignReq.boodBankNote')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fex.tranApp.bankNote",$!{fexTranReqPage.boodBankNote})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##保证金币种
        #springMessage('table.fexTranReq.bondCurId')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.bondEnglishCode}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##合同号
        #springMessage('table.fexForeignReq.contractNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.contractNo}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##额度
        #springMessage('table.guaContract.trackMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexTranReqPage.payMoney})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##外汇局批件/备案表号/业务编号
        #springMessage('table.fexForeignReq.busNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.busNo}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##结汇资金用途
        #springMessage('table.fexTranReq.purpose')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fex.tranApp.purpose",$!{fexTranReqPage.purpose})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##结汇资金详细用途
        #springMessage('table.fexTranReq.purposeDtl')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.purposeDtl}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##资金来源
        #springMessage('table.fexTranReq.fundsSource')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fex.tranApp.fundsSource",$!{fexTranReqPage.fundsSource})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##发票号
        #springMessage('table.fexForeignReq.invoiceNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.invoiceNo}
        </span>
    </li>
    <li class="mui-table-view-cell">
    ##资金性质
        #springMessage('table.fexTranReq.accNature')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexTranReq.accNature",$!{fexTranReqPage.accNature})
        </span>
    </li>
    <li class="mui-table-view-cell">
    ##        汇款类型
        #springMessage('table.fexForeignReq.remitType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.remitType",$!{fexTranReqPage.remitType})
        </span>
    </li>
    <li class="mui-table-view-cell">
    ##        跨行标志
        #springMessage('table.nisBillhead.difBank')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("nisBillhead.difBank",$!{fexTranReqPage.difBank})
        </span>
    </li>
    <li class="mui-table-view-cell">
    ##结售汇属性
        #springMessage('table.fexTranReq.fexProp')
        <span class="mui-badge mui-badge-inverted">
            #if($!{fexTranReqPage.fexBusType} == "2")
                $dictTag.get("fex.tranApp.fexProp2",$!{fexTranReqPage.fexProp})
            #else
                $dictTag.get("fex.tranApp.fexProp",$!{fexTranReqPage.fexProp})
            #end
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##联系人
        #springMessage('table.externalCorp.linkMan')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.corpContact}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##电话
        #springMessage('table.externalCorp.tel')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.corpContactTel}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##其它保证方式说明
        #springMessage('table.fexTranReq.boodRmk')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.boodRmk}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##备注
        #springMessage('fcVoucherType.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.rmk}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易员
        #springMessage('table.fexTranReq.dealer')
        <span class="mui-badge mui-badge-inverted">
            $!{dealer}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易地点
        #springMessage('table.fexTranReq.tranAddr')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranAddr}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易组
        #springMessage('table.fexTranReq.tranGroup')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranGroupName}
        </span>
    </li>
#if($!{opType})
    #if($!{opType} == "1")
        ##展期/提前交割
        <li class="mui-table-view-cell  mui-collapse keep-unfold">
            <a class="mui-navigate-right" href="#">
                #springMessage('fextranreq.button.delivery')
                <span class="mui-badge mui-badge-inverted"></span>
            </a>
            <ul class="mui-table-view H-theme-background-color-white">
                ##交割方向
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.deliverySign')
                    <span class="mui-badge mui-badge-inverted">
                        $dictTag.get("fexTranDeal.deliverySign",$!{fexTranDealPage.deliverySign})
                    </span>
                </li>
                ##原结算日期
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.oldSettleDate')
                    <span class="mui-badge mui-badge-inverted">
                        $!date.format('yyyy-MM-dd',$!{fexTranDealPage.oldSettleDate})
                    </span>
                </li>
                ##新结算日期
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.newSettleDate')
                    <span class="mui-badge mui-badge-inverted">
                        $!date.format('yyyy-MM-dd',$!{fexTranDealPage.newSettleDate})
                    </span>
                </li>
                ##结算金额
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.settleMoney')
                    <span class="mui-badge mui-badge-inverted">
                        $!number.formatNumeric($!{fexTranDealPage.settleMoney})
                    </span>
                </li>
                ##结算汇率
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.settleRate')
                    <span class="mui-badge mui-badge-inverted">
                        $!excRateTag.getConvert($!{fexTranDealPage.settleRate})
                    </span>
                </li>
                ##即期汇率
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.wishRate')
                    <span class="mui-badge mui-badge-inverted">
                        $!excRateTag.getConvert($!{fexTranDealPage.wishRate})
                    </span>
                </li>
                ##余额
                <li class="mui-table-view-cell">
                    #springMessage('table.accountDTO.balance')
                    <span class="mui-badge mui-badge-inverted">
                        $!number.formatNumeric($!{fexTranDealPage.bal})
                    </span>
                </li>
                ##备注
                <li class="mui-table-view-cell">
                    #springMessage('fcVoucherType.rmk')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexTranDealPage.rmk}
                    </span>
                </li>
            </ul>
        </li>
    #elseif($!{opType} == "2")
        ##违约
        <li class="mui-table-view-cell  mui-collapse keep-unfold">
            <a class="mui-navigate-right" href="#">
                #springMessage('fextranreq.button.default')
                <span class="mui-badge mui-badge-inverted"></span>
            </a>
            <ul class="mui-table-view H-theme-background-color-white">
                ##违约日期
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.defaultDate')
                    <span class="mui-badge mui-badge-inverted">
                        $!date.format('yyyy-MM-dd',$!{fexTranDealPage.defaultDate})
                    </span>
                </li>
                ##违约金币种
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.defaultCurId')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexTranDealPage.englishCode}
                    </span>
                </li>
                ##违约金
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.defaultMoney')
                    <span class="mui-badge mui-badge-inverted">
                        $!number.formatNumeric($!{fexTranDealPage.defaultMoney})
                    </span>
                </li>
                ##结算日期
                <li class="mui-table-view-cell">
                    #springMessage('table.fcSubjectDay.optDate')
                    <span class="mui-badge mui-badge-inverted">
                        $!date.format('yyyy-MM-dd',$!{fexTranDealPage.newSettleDate})
                    </span>
                </li>
                ##结算金额
                #*<li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.settleMoney')
                    <span class="mui-badge mui-badge-inverted">
                        $!number.formatNumeric($!{fexTranDealPage.settleMoney})
                    </span>
                </li>*#
                ##即期汇率
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.defaultRate')
                    <span class="mui-badge mui-badge-inverted">
                        $!excRateTag.getConvert($!{fexTranDealPage.wishRate})
                    </span>
                </li>
                ##备注
                <li class="mui-table-view-cell">
                    #springMessage('fcVoucherType.rmk')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexTranDealPage.rmk}
                    </span>
                </li>
            </ul>
        </li>
    #else
        ##NDF交割
        <li class="mui-table-view-cell  mui-collapse keep-unfold">
            <a class="mui-navigate-right" href="#">
                #springMessage('fextranreq.button.ndfdelivery')
                <span class="mui-badge mui-badge-inverted"></span>
            </a>
            <ul class="mui-table-view H-theme-background-color-white">
                ##交割汇率
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.deliveryRate')
                    <span class="mui-badge mui-badge-inverted">
                        $!excRateTag.getConvert($!{fexTranDealPage.deliveryRate})
                    </span>
                </li>
                ##结算币种
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.settleCurId')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexTranDealPage.englishCode}
                    </span>
                </li>
                ##结算金额
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.settleMoney')
                    <span class="mui-badge mui-badge-inverted">
                        $!number.formatNumeric($!{fexTranDealPage.settleMoney})
                    </span>
                </li>
                ##交割确定日期
                <li class="mui-table-view-cell">
                    #springMessage('table.fexTranDeal.deliveryDate')
                    <span class="mui-badge mui-badge-inverted">
                        $!date.format('yyyy-MM-dd',$!{fexTranDealPage.deliveryDate})
                    </span>
                </li>
                ##结算日期
                <li class="mui-table-view-cell">
                    #springMessage('table.fcSubjectDay.optDate')
                    <span class="mui-badge mui-badge-inverted">
                        $!date.format('yyyy-MM-dd',$!{fexTranDealPage.newSettleDate})
                    </span>
                </li>
                ##备注
                <li class="mui-table-view-cell">
                    #springMessage('fcVoucherType.rmk')
                    <span class="mui-badge mui-badge-inverted">
                        $!{fexTranDealPage.rmk}
                    </span>
                </li>
            </ul>
        </li>
    #end
#end
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

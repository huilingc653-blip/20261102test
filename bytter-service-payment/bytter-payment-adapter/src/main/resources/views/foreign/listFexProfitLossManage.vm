<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input type="hidden" id="rateDecimalPlaces" value="$!{rateDecimalPlaces}">
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##交易号码
            <td class="textRight">#springMessage('table.fexTranReq.billNo')</td>
            <td>
                <input type="text" name="likes_billNo" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.billNo')">
            </td>
            ##    交易类型
            <td class="textRight">#springMessage('table.foreign.tranType')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="fex.tranApp.tranType" data-name="eqg_tranType" data-biz-name="tranType" data-displayData="2,7,8,9"></div>
                </div>
            </td>
            ##单位
            <td class="textRight">#springMessage('bi.money.map.corp')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="foreign:fexProFitLossManage:op"
                         data-scope="all"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##交易货币对
            <td class="textRight">#springMessage('fex.tranApp.tranCurPair')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrencypair/getValidCurrencyPair?" data-valuefield="id"
                         data-textfield="currencyPair" data-name="eqs_tranCurPairId" data-biz-name="tranCurPairId"
                        ></div>
                </div>
            </td>
            ##买卖方向
            <td class="textRight">#springMessage('fex.tranApp.busDirection')</td>
            <td >
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="fex.tranApp.busDirection"
                         data-name="eqs_busDirection" data-biz-name="eqs_busDirection"></div>
                </div>
            </td>
            ##报价时间
            <td class="textRight">#springMessage('table.fexProfit.quotationDate')</td>
            <td>
                <input type="text" name="ged_quotationDate" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_quotationDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_quotationDate" class="layui-input bt-input-inline bt-biz-dateType"
                       id="led_quotationDate">
            </td>
        </tr>

        <tr>
            ##结算日期
            <td class="textRight">#springMessage('ras.channelBill.Conf.billDate')</td>
            <td>
                <input type="text" name="ged_settleDate" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_settleDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_settleDate" class="layui-input bt-input-inline bt-biz-dateType"
                       id="led_settleDate">
            </td>
            ##持仓金额
            <td class="textRight" width="10%">#springMessage('table.fexTranReq.positionMoney')</td>
            <td width="30%">
                <div class="layui-inline">
                    <input type="text" name="geg_positionMoney" autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.fexTranReq.positionMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_positionMoney" autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" id="t20" placeholder="#springMessage('table.fexTranReq.positionMoney')">
                </div>
            </td>
            ##损益币种
            <td class="textRight">#springMessage('table.fexTranReq.profitLossCur')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-mulselectType" data-name="ins_curId" data-biz-name="curId"
                         data-url="${basePath}/basic/business/btcurrency/json" data-method="get"
                         data-valuefield="id" data-textfield="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fexTranReq.billNo')</th>##交易号码
        <th>#springMessage('table.foreign.tranType')</th>##产品类型
        <th>#springMessage('bi.money.map.corp')</th>##单位
        <th>#springMessage('fex.tranApp.tranCurPair')</th>##交易货币对
        <th>#springMessage('fex.tranApp.busDirection')</th>##买卖方向
        <th>#springMessage('fex.tranApp2.upAndDownDirection')</th>##涨跌方向
        <th>#springMessage('table.fexProfit.quotationDate')</th>##报价时间
        <th>#springMessage('table.fcSubjectDay.optDate')</th>##结算日期
        <th>#springMessage('table.fexTranReq.positionMoney')</th>##持仓金额
        <th>#springMessage('table.fexTranReq.contractRate')</th>##合同汇率
        <th>#springMessage('table.fexProfit.valuationRate')</th>##估值汇率
        <th>#springMessage('table.fexTranReq.profitLossCur')</th>##损益币种
        <th>#springMessage('table.fexProfit.floatMoney')</th>##浮动损益
        <th>#springMessage('table.fexProfit.convertFloatMoney')</th>##折本位币浮动损益
        <th>#springMessage('table.fexProfit.realMoneyTotal')</th>##已实现损益
        <th>#springMessage('table.fexProfit.convertRealMoneyTotal')</th>##折本位币已实现损益
        <th>#springMessage('table.common.operation')</th>##操作
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexProfitLossManage.list.js?_btv=${resourceVersion}"></script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
            <td >
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-biz-name="corpId"
                         data-scope="all"
                         data-resource="foreign:fex:settleFill:rule:query"
                         ></div>
                </div>
            </td>
        ##交易类型
            <td class="textRight">#springMessage('ttpay.tradeType')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="foreign.tranGroupRule.tranType"
                         data-displayData="7,8,9,2,3,4"
                         data-biz-name="tranType" data-name="tranType" data-value="0" data-callback="changeTranType"></div>
                </div>
            </td>
        ##产品
            <td class="textRight">#springMessage('table.foreign.product')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProduct/-1" data-biz-name="eqs_proId" data-name="eqs_proId" data-valueField="id" data-textField="proName" data-defaultvalue=""></div>
                </div>
            </td>
        </tr>
        <tr>
        ##交易对手
            <td class="textRight">#springMessage('table.foreign.counterparty')</td>
            <td >
                <input type="text" name="likes_cotpName" value=""  class="layui-input" placeholder="#springMessage('table.foreign.counterparty')" >
            </td>
        ##交易对手国家/地区
            <td class="textRight" >#springMessage('table.foreign.counterparty')#springMessage('table.foreign.countryOrArea')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType"  data-url="${basePath}/basic/business/syscountrycust/listSysCountryCust" data-name ="eqs_countryId" data-valueField="id" data-textField="nameZh"></div>
                </div>
            </td>
        ##币种
            <td class="textRight">#springMessage('table.foreign.currency')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_curId" data-biz-name ="curId"
                         data-valueField="id" data-textField="englishCode" ></div>
                </div>
            </td>

        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
        <th>#springMessage('table.nisBillhead.corpId')</th>##单位
        <th>#springMessage('table.foreign.cashFlowType')</th>##现金流形式
        <th>#springMessage('table.foreign.tranType')</th>##交易类型
        <th>#springMessage('table.foreign.product')</th>##产品
        <th>#springMessage('table.foreign.counterparty')</th>##交易对手
        <th>#springMessage('table.foreign.counterparty')#springMessage('table.foreign.countryOrArea')</th>##交易对手国家/地区
        <th>#springMessage('table.foreign.currency')</th>##币种
        <th>#springMessage('table.foreign.voucherType')</th>##支付方式
        <th>#springMessage('table.foreign.cdSign')</th>##收付方向
        <th>#springMessage('bisAccAttribute.validSign')</th>##有效标志
        <th>#springMessage('common.table.thead.operation')</th>##操作
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexSettleFillRule.list.js?_btv=${resourceVersion}"></script>
</html>

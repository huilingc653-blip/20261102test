## #parse("views/common/head.vm")
<div class="layui-collapse">
	<h2 class="layui-colla-title" style="text-align: center">#springMessage('table.fexExposureTemplate.templateView')</h2>
	<div class="layui-colla-item">
	<input type="hidden" name="curIds" id="curIds" value="$!{fexCorpExposureTemplatePage.curId}">
	<table class="layui-table layui-table-border">
		<tbody >
			<tr>
				##总填报周期
				<td class="textRight" width="20%">#springMessage('table.fexExposureTemplate.totalFillPeriod')</td>
				<td width="25%">$!{fexExposureTemplatePage.totalFillPeriod}$dictTag.get("fexExposureTemplate.timeType",$!{fexExposureTemplatePage.totalFillUnit})</td>
				##前面按周期填报，后续是否按年度填报 0-否 1-是
				<td class="textRight" width="25%">#springMessage('table.fexExposureTemplate.isYearFill')</td>
				<td width="30%">$dictTag.get("sf_yn",$!{fexExposureTemplatePage.isYearFill})</td>
			</tr>
			<tr>
				##滚动总周期
				<td class="textRight">#springMessage('table.fexExposureTemplate.scrollFillPeriod')</td>
				<td>$!{fexExposureTemplatePage.scrollFillPeriod}$dictTag.get("fexExposureTemplate.timeType",$!{fexExposureTemplatePage.scrollFillUnit})</td>
				##前面按周期填报，后续是否按总额填报 0-否 1-是
				<td class="textRight">#springMessage('table.fexExposureTemplate.isTotalFill')</td>
				<td>$dictTag.get("sf_yn",$!{fexExposureTemplatePage.isTotalFill})</td>
			</tr>
			<tr>
				##滚动分解子周期
				<td class="textRight">#springMessage('table.fexExposureTemplate.scrollResolvePeriod')</td>
				<td>$!{fexExposureTemplatePage.scrollResolvePeriod}$dictTag.get("fexExposureTemplate.timeType",$!{fexExposureTemplatePage.scrollResolveUnit})</td>
				##币种
				<td class="textRight">#springMessage('table.nisBillhead.curId')</td>
				<td>
					<div class="layui-input-inline">
					<div class="bt-biz-mulselectType" data-method="get" data-name ="curId" data-biz-name ="curId"
						 data-valueField="id" data-textField="englishCode" data-inputvalue="inputvalue" data-search="true"
						 data-callback="bt.curIdCallback" data-defaultvalue="$!{fexCorpExposureTemplatePage.curId}"
						 data-filterData="$!{filterCur}"></div>
					</div>
				</td>
			</tr>
		</tbody>
	</table>
	</div>
</div>
<script type="text/javascript">
	bt.use(['form', 'layedit', 'treeTable', 'mulselect'], function () {
		$('.bt-biz-mulselectType').data('url',basePath+'/basic/business/btcurrency/json')
		bt.mulselect.init();
	});
</script>
</html>

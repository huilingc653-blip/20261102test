<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{fexTranGroupPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{fexTranGroupPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fexTranGroupPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{fexTranGroupPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{fexTranGroupPage.id}">
		<table class="layui-table">
			<tbody>
				<tr>
    				<td class="textRight" width="40%">#springMessage('table.fexProduct.name')</td>
                    <td width="60%">
						<input type="text" id="groupName" name="groupName" lay-verify="required|strlength" data-maxlength="100" value="$!{fexTranGroupPage.groupName}"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexProduct.name')">
    				</td>
				</tr>
				<tr>
					<td class="textRight" width="40%">#springMessage('sys.role.description')</td>
					<td width="60%">
						<input type="text" id="groupDesc" name="groupDesc" lay-verify="strlength" data-maxlength="200" value="$!{fexTranGroupPage.groupDesc}"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('sys.role.description')">
					</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.fexTranGroup.proId')</td>
                    <td>
						<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProduct/0" data-name ="proId" data-biz-name ="proId"
							 data-valueField="id" data-textField="proName" data-required = "true" data-callback="bt.changeProId" data-initCallback="bt.changeProId" data-value="$!{fexTranGroupPage.proId}"></div>
    				</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.fexProduct.trangroupRuleId')</td>
					<td>
						<div class="bt-biz-selectType" data-url="${basePath}/foreign/fextrangrouprule/json" data-name ="ruleId" data-biz-name ="ruleId"
							 data-valueField="id" data-textField="ruleName" data-required = "true" data-value="$!{fexTranGroupPage.ruleId}"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight" width="40%">#springMessage('table.fexTranGroup.mainInfo')</td>
					<td width="60%">
						<input type="text" id="mainInfo" name="mainInfo" lay-verify="strlength" data-maxlength="200" value="$!{fexTranGroupPage.mainInfo}"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranGroup.mainInfo')">
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="$!{fexTranGroupPage.validSign}" data-name="validSign" data-required = "true"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
					<td >
						<textarea placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" style="width:100%" id="rmk" name="rmk" lay-verify="strlength" data-maxlength="200">$!{fexTranGroupPage.rmk}</textarea>
					</td>
				</tr>
				<tr>
					<td colspan="2" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>

		<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
			<tr>
				<th colspan="7">#springMessage('table.rasBackQuery.msg')</th>
			<tr>
			<tr>
				<th>#springMessage('table.fbsBudgetYear.number')</th>
				<th>#springMessage('table.fexTranReq.billNo')</th>
				<th>#springMessage('table.foreign.product')</th>
				<th>#springMessage('table.fbsBudget.corpId')</th>
				<th>#springMessage('table.btNetChalk.transTime')</th>
				<th>#springMessage('table.fbsBudget.status')</th>
				<th>#springMessage('common.table.thead.operation')</th>
			</tr>
			</thead>
			#foreach($data in $listTran)
				<tr>
					<td align="center">$!{velocityCount}</td>
					<td align="center">
						<input type="hidden" id="tranId" name="tranId" value="$!{data.id}" class="tranid">
						$!{data.billNo}
					</td>
					<td>$!{data.proName}</td>
					<td>$!{data.corpName}</td>
					<td align="center">$!{data.tranDate}</td>
					<td align="center">$dictTag.get("choBankFinance.status",$!{data.status})</td>
					<td align="center">
						<a class="operate-button" href="#" data-type="delete">#springMessage('common.button.delete')</a><span class="text-explode">|</span>
						<a class="operate-button" href="#" data-type="view">#springMessage('common.button.view')</a>
					</td>
				</tr>
			#end
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexTranGroup.edit.js?_btv=${resourceVersion}"></script>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{fexProductPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{fexProductPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fexProductPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{fexProductPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{fexProductPage.id}">
		<input id="proLevel" name="proLevel" type="hidden" value="$!{fexProductPage.proLevel}">
		<input id="tranType" name="tranType" type="hidden" value="$!{fexProductPage.tranType}">
		<table class="layui-table">
			<tbody>
				<tr>
    				<td class="textRight" width="40%">#springMessage('table.fexProduct.proName')</td>
                    <td width="60%">
						#if($!{fexProductPage.isAllowedDel} == 1)
							<input type="text" id="proName" name="proName" lay-verify="required|strlength" value="$!{fexProductPage.proName}" data-maxlength="60"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexProduct.proName')">
						#else
							<input type="text" id="proName" name="proName" lay-verify="required" value="$!{fexProductPage.proName}" readonly="readonly"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexProduct.proName')">
						#end

    				</td>
				</tr>
				<tr>
					<td class="textRight" width="40%">#springMessage('table.fexProduct.proDesc')</td>
					<td width="60%">
						<input lay-verify="strlength" type="text" id="proDesc" name="proDesc" value="$!{fexProductPage.proDesc}"  data-maxlength="100"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexProduct.proDesc')">
					</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.fexProduct.proId')</td>
                    <td>
						<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProductGroup/$!{fexProductPage.tranType}" data-name ="proId" data-biz-name ="proId"
							 data-valueField="id" data-textField="proName" data-value="$!{fexProductPage.proId}"></div>
    				</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.fexProduct.nonWorkdayRule')</td>
					<td>
						<div class="bt-biz-dict" data-type="checkbox" data-group="fexProduct.nonWorkdayRule" data-name="nonWorkdayRule" data-defaultvalue="$!{fexProductPage.nonWorkdayRule}" data-required = "true"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="$!{fexProductPage.validSign}" data-name="validSign" data-required = "true"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
					<td >
						<textarea lay-verify="strlength" placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" style="width:100%" id="rmk" name="rmk"  data-maxlength="100">$!{fexProductPage.rmk}</textarea>
					</td>
				</tr>
				<tr>
					<td colspan="2" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexProduct.edit.js?_btv=${resourceVersion}"></script>
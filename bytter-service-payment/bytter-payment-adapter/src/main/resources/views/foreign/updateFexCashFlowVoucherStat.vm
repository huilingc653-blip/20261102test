<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	<input id="id" name="id" type="hidden" value="$!{fexCashFlowPage.id}">
	<input id="opType" name="opType" type="hidden" value="$!{fexCashFlowPage.opType}">
	<table class="layui-table">
		<tbody>
		<tr>
			##主体单位名称
			<td class="textRight" width="40%">#springMessage('table.nisBillhead.corpId')</td>
			<td width="60%">$!{fexCashFlowPage.corpName}</td>
		</tr>
		<tr>
			##币种
			<td class="textRight" width="40%">#springMessage('table.bisAccDtl.curName')</td>
			<td width="60%">$!{fexCashFlowPage.englishCode}</td>
		</tr>
		<tr>
			##银行账号
			<td class="textRight">#springMessage('table.foreign.bankAcc')</td>
			<td>$!{fexCashFlowPage.corpBankAcc}</td>
		</tr>
		<tr>
			##银行
			<td class="textRight">#springMessage('common.button.bank')</td>
			<td>$!{fexCashFlowPage.corpBankName}</td>
		</tr>
		<tr>
			##账户名称
			<td class="textRight" width="40%">#springMessage('table.btBankAccApp.accName')</td>
			<td width="60%">$!{fexCashFlowPage.corpAccName}</td>
		</tr>
		<tr>
			##金额
			<td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
			<td>
				$!number.formatNumeric($!{fexCashFlowPage.payMoney})
			</td>
		</tr>
		<tr>
			##交易对手
			<td class="textRight" width="40%">#springMessage('table.fexForeign.copt')</td>
			<td width="60%">
				#if($!{fexCashFlowPage.tranType} == "3")
					$!{fexCashFlowPage.allocatCotpName}
				#else
					$!{fexCashFlowPage.cotpName}
				#end
			</td>
		</tr>
		<tr>
			##交易对手银行账户
			<td class="textRight" width="40%">#springMessage('table.fexForeign.copt')#springMessage('table.foreign.bankAcc')</td>
			<td width="60%">$!{fexCashFlowPage.cotpBankAcc}</td>
		</tr>
		<tr>
			##支付方式
			<td class="textRight">#springMessage('table.foreign.voucherType')</td>
			<td>$!{fexCashFlowPage.voucherTypeName}</td>
		</tr>
		<tr>
			##支付状态
			<td class="textRight">#springMessage('table.fexCashFlow.payStatus')</td>
			<td>
				<div class="bt-biz-dict" data-type="select" data-group="fexCashFlow.payStatus" data-defaultvalue="$!{fexCashFlowPage.payStatus}" data-name="payStatus" data-required = "true"></div>
			</td>
		</tr>
		<tr>
			##备注
			<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
			<td >
				<textarea lay-verify="strlength" placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" style="width:100%" id="rmk" name="rmk" data-maxlength="200">$!{fexCashFlowPage.rmk}</textarea>
			</td>
		</tr>
		<tr>
			<td colspan="2" style="text-align: center;">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</td>
		</tr>
		</tbody>
	</table>
</form>
	#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexCashFlow.edit.js?_btv=${resourceVersion}"></script>
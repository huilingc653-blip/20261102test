<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
	<ul class="layui-tab-title">
		<li class="layui-this">#springMessage('table.rasBackQuery.msg')</li>
		<li>#springMessage('table.fexTranReq.cashFlow')</li>
		<li>#springMessage('fex.cotp.customInformation')</li>
	</ul>
	<div class="layui-tab-content">
		<div class="layui-tab-item layui-show">
			<form class="layui-form" method="post">
				<!-- 系统参数 -->
				<input id="id" name="id" type="hidden" value="$!{fexTranReqPage.id}">
				<input id="billNo" name="billNo" type="hidden" value="$!{fexTranReqPage.billNo}">
				<input id="corpId" name="corpId" type="hidden" value="$!{fexTranReqPage.corpId}">
				<input id="settleDate" name="settleDate" type="hidden" value="$!{fexTranReqPage.settleDate}">
				<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
				<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
				<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
				<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
				<input id="busType" name="busType" type="hidden" value="$!{busType}">

				<!-- 资金计划参数 明细项控制模式-->
				<input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
				<input id="sellCurId" name="sellCurId" type="hidden" value="$!{fexTranReqPage.sellCurId}">
				<div id="print">
				<table class="layui-table">
					<tbody>
					<tr>
						##交易号码
						<td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
						<td width="30%">$!{fexTranReqPage.billNo}</td>
						##交易需求编号
						<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAppDtlNo')</td>
						<td width="30%">$!{fexTranReqPage.tranAppDtlNo}</td>
					</tr>
					</tbody>
				</table>

				<div class="layui-collapse">
					<div class="layui-colla-item">
						<h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranMainInfo')</h2>
						<div class="layui-colla-content layui-show">
							<table class="layui-table">
								<tbody>
								<tr>
									##单位
									<td class="textRight" width="20%">#springMessage('table.nisBillhead.corpId')</td>
									<td width="30%">$!{fexTranReqPage.corpName}</td>
									##是否掉期交易
									#*<td class="textRight" width="20%">#springMessage('table.fexTranReq.isSwapTran')</td>
									<td width="30%">$dictTag.get("sf_yn",$!{fexTranReqPage.isSwapTran})</td>*#
									<td></td>
									<td></td>
								</tr>
								</tbody>
							</table>
						</div>
					</div>
					<div class="layui-colla-item">
						<h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranProductInfo')</h2>
						<div class="layui-colla-content layui-show">
							<table class="layui-table">
								<tbody>
								<tr>
									##产品
									<td class="textRight" width="20%">#springMessage('table.foreign.product')</td>
									<td width="30%">$!{fexTranReqPage.proName}</td>
									##外汇交易类型
									<td class="textRight" width="20%">#springMessage('table.fexProduct.fexTranType')</td>
									<td width="30%">$dictTag.get("fexProduct.fexTranType",$!{fexTranReqPage.fexTranType})</td>
								</tr>
								<tr>
									##外汇业务类型
									<td class="textRight" width="20%">#springMessage('table.fexProduct.fexBusType')</td>
									<td width="30%">$dictTag.get("fexProduct.fexBusType",$!{fexTranReqPage.fexBusType})</td>
									#if($!{fexTranReqPage.fexBusType}=="1")
										##结汇业务类型
										<td class="textRight" width="20%">#springMessage('fex.tran.settleBusType')</td>
										<td width="30%">$dictTag.get("fex.tran.settleBusType",$!{fexTranReqPage.settleBusType})</td>
									#else
										<td width="20%"></td>
										<td width="30%"></td>
									#end
								</tr>
								<tr>
									##交割类型
									<td class="textRight" width="20%">#springMessage('table.fexProduct.deliveryType')</td>
									<td width="30%">$dictTag.get("fexProduct.deliveryType",$!{fexTranReqPage.deliveryType})</td>
									#if($!{fexTranReqPage.deliveryType}=="1")
										##交割币种
										<td class="textRight" width="20%">#springMessage('fex.tranApp.deliveryCurId')</td>
										<td width="30%">$!{fexTranReqPage.deliveryEnglishCode}</td>
									#else
										<td width="20%"></td>
										<td width="30%"></td>
									#end
								</tr>
								</tbody>
							</table>
						</div>
					</div>
					<div class="layui-colla-item">
						<h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
						<div class="layui-colla-content layui-show">
							<table class="layui-table">
								<tbody>
								<tr>
									##交易对手
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.cotpBank')</td>
									<td width="30%">$!{fexTranReqPage.cotpName}</td>
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.cotpBank')#springMessage('table.btswiftinfo.swiftCode')</td>
									<td width="30%">$!{fexTranReqPage.cotpBicCode}</td>
								</tr>
								<tr>
									##固定金额
									<td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.FixedAmount')</td>
									<td>
										#if(${fexTranReqPage.fixedMoney.indexOf("1")} > -1)
											$dictTag.get("fex.tranApp.fixMoney","1")
										#end
										#if(${fexTranReqPage.fixedMoney.indexOf("2")} > -1)
											$dictTag.get("fex.tranApp.fixMoney","2")
										#end
									</td>
									#*<td colspan="2" width="20%">#springMessage('fex.tranApp.isAutoCal')</td>
									<td width="30%">
										$dictTag.get("fex.tranApp.fixMoney",${fexTranReqPage.autoCal})
										*##*<input type="checkbox" name="autoCal" lay-filter = "autoCal" value="1" disabled="disabled"
											#if(${fexTranReqPage.autoCal})
											   checked="checked"
											#end
											   title="#springMessage('fex.tranApp.autoCal')" lay-skin="primary">*##*
									</td>*#
									<td></td>
									<td></td>
								</tr>
								<tr>
									##合同汇率
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.contractRate')</td>
									<td width="30%">
										$!number.formatDoubles($!{fexTranReqPage.contractRate},6)
									</td>
									##远期汇率
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranDeal.wishRate')</td>
									<td width="30%">
										$!number.formatDoubles($!{fexTranReqPage.spotRate},6)
									</td>
								</tr>
								#*<tr>
									##外汇合同号
									<td class="textRight" colspan="2">#springMessage('table.fexForeignReq.foreignContractNo')</td>
									<td>$!{fexTranReqPage.foreignContractNo}</td>
									<td class="textRight" colspan="2"></td>
									<td></td>
								</tr>*#
								<tr>
									<td rowspan="5" width="5%" align="center">#springMessage('table.fexTranReq.tranBuyInfo')</td>
									##买入币种
									<td class="textRight" width="15%">#springMessage('table.fexTranReq.buyCurId')</td>
									<td width="30%">$!{fexTranReqPage.buyEnglishCode}</td>
									<td rowspan="5" width="5%" align="center">#springMessage('table.fexTranReq.tranSellInfo')</td>
									##卖出币种
									<td class="textRight" width="15%">#springMessage('table.fexTranReq.sellCurId')</td>
									<td width="30%">$!{fexTranReqPage.sellEnglishCode}</td>
								</tr>
								<tr>
									##买入金额
									<td class="textRight" width="15%">#springMessage('table.fexTranReq.buyMoney')</td>
									<td width="30%">$!number.formatNumeric($!{fexTranReqPage.buyMoney})</td>
									##卖出金额
									<td class="textRight" width="15%">#springMessage('table.fexTranReq.sellMoney')</td>
									<td width="30%">$!number.formatNumeric($!{fexTranReqPage.sellMoney})</td>
								</tr>
								<tr>
									##收款账号
									<td class="textRight" width="15%">#springMessage('table.nisBillhead.payeeAcc')</td>
									<td width="30%">
										<div id="corpBankAccDiv" name="corpBankAccDiv">$!{fexTranReqPage.corpBankAcc}</div>
									</td>
									##付款账号
									<td class="textRight" width="15%">#springMessage('table.nisBillhead.payerAcc')</td>
									<td width="30%">
										<div id="srcBankAccDiv" name="srcBankAccDiv">$!{fexTranReqPage.srcBankAcc}</div>
									</td>
								</tr>
								<tr>
									##收款账户银行
									<td class="textRight" width="15%">#springMessage('table.fexTranReq.payeeAccBank')</td>
									<td width="30%">
										<div id="corpBankNameDiv" name="corpBankNameDiv">$!{fexTranReqPage.corpBankName}</div>
									</td>
									##付款账户银行
									<td class="textRight" width="15%">#springMessage('table.fexTranReq.payerAccBank')</td>
									<td width="30%">
										<div id="srcBankNameDiv" name="srcBankNameDiv">$!{fexTranReqPage.srcBankName}</div>
									</td>
								</tr>
								<tr>
									##收款账户银行SWIFT CODE
									<td class="textRight" width="15%">#springMessage('table.fexTranReq.payeeAccBank')#springMessage('table.btswiftinfo.swiftCode')</td>
									<td width="30%">
										<div id="corpBankNameDiv" name="corpBankNameDiv">$!{fexTranReqPage.corpBankAccSwiftCode}</div>
									</td>
									##付款账户银行SWIFT CODE
									<td class="textRight" width="15%">#springMessage('table.fexTranReq.payerAccBank')#springMessage('table.btswiftinfo.swiftCode')</td>
									<td width="30%">
										<div id="srcBankNameDiv" name="srcBankNameDiv">$!{fexTranReqPage.srcBankAccSwiftCode}</div>
									</td>
								</tr>
								<tr>
									#*##远期点数
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.forwardPoints')</td>
									<td width="30%">$!number.formatNumeric($!{fexTranReqPage.forwardPoints})</td>*#
									##钞汇标识
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.bankNote')</td>
									<td width="30%">$dictTag.get("fex.tranApp.bankNote",$!{fexTranReqPage.bankNote})</td>
									<td></td>
									<td></td>
								</tr>
								<tr>
									##交易日期
									<td class="textRight" colspan="2" width="20%">#springMessage('table.revenue.transTime')</td>
									<td width="30%">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.tranDate})</td>
									##结算日期
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fcSubjectDay.optDate')</td>
									<td width="30%">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})</td>
								</tr>
								<tr>
									##交割期限
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.deliveryDeadline')</td>
									<td width="30%">T+$!{fexTranReqPage.deliveryDeadline}</td>
									##申请日期
									<td class="textRight" colspan="2" width="20%">#springMessage('table.bisFinanceExc.reqDate')</td>
									<td width="30%">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.createDate})</td>
								</tr>
								<tr>
									##资金性质
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.accNature')</td>
									<td width="30%">$dictTag.get("fexTranReq.accNature",$!{fexTranReqPage.accNature})</td>
									##汇款类型
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexForeignReq.remitType')</td>
									<td width="30%">$dictTag.get("fexForeignReq.remitType",$!{fexTranReqPage.remitType})</td>
								</tr>
								<tr>
									##跨行标志
									<td class="textRight" colspan="2" width="20%">#springMessage('table.nisBillhead.difBank')</td>
									<td width="30%">$dictTag.get("nisBillhead.difBank",$!{fexTranReqPage.difBank})</td>
									##是否线下付款
									<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.isPayed')</td>
									<td width="30%">
										$dictTag.get("sf_yn",$!{fexTranReqPage.isPayed})
									</td>
								</tr>
								#if($!{bankType.isSetBankPayType} == "1" && $!{bankType.applayScopeBankPayType.indexOf("1")} != -1)
								<tr id="bankPayTypeTr">
									##支付类型
									<td class="textRight" colspan="2" width="20%" id="bankPayTypeTd">#springMessage('table.nisBillhead.bankPayType')</td>
									<td width="30%">
										#if($!{bankType.isSetBankPayType} == "1" && $!{bankType.applayScopeBankPayType.indexOf("1")} != -1 && $!{bankPayType.customCode} && $!{bankPayType.customCode} != "")
											($!{bankPayType.customCode})$!{bankPayType.customName}
										#end
									</td>
									<td class="textRight" colspan="2" width="20%"></td>
									<td width="30%"></td>
								</tr>
								#end
								</tbody>
							</table>
						</div>
					</div>
					<div class="layui-colla-item">
						<h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranBoodInfo')</h2>
						<div class="layui-colla-content layui-show">
							<table class="layui-table">
								<tbody>
								<tr>
									##保证方式
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.boodType')</td>
									<td width="30%">$dictTag.get("fex.tranApp.boodType",$!{fexTranReqPage.boodType})</td>
									##保证金账号
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.boodAcc')</td>
									<td width="30%">$!{fexTranReqPage.boodAcc}</td>
								</tr>
								<tr>
									##保证金比例
									<td class="textRight">#springMessage('table.fexTranReq.boodRatio')</td>
									<td>$!rateTag.show($!{fexTranReqPage.boodRatio},2)</td>
									</td>
									##保证金钞汇标识
									<td class="textRight">#springMessage('table.fexForeignReq.boodBankNote')</td>
									<td>$dictTag.get("fex.tranApp.bankNote",$!{fexTranReqPage.boodBankNote})</td>
								</tr>
								<tr>
									##保证金币种
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.bondCurId')</td>
									<td width="30%">$!{fexTranReqPage.bondEnglishCode}</td>
									##额度
									<td class="textRight" width="20%">#springMessage('table.guaContract.trackMoney')</td>
									<td width="30%">$!number.formatNumeric($!{fexTranReqPage.payMoney})</td>
								</tr>
								<tr>
									##其它保证方式说明
									<td class="textRight">#springMessage('table.fexTranReq.boodRmk')</td>
									<td colspan="3">$!{fexTranReqPage.boodRmk}</td>
								</tr>
								</tbody>
							</table>
						</div>
					</div>
					<div class="layui-colla-item" #if($!{fexTranReqPage.remitType} == "2") style="display: none" #end>
						<h2 class="layui-colla-title">#springMessage('fex.fexTranReqPay.reportInfo')</h2>
						<div class="layui-colla-content layui-show">
							<table class="layui-table">
								<tbody>
								<tr>
									##合同号
									<td class="textRight" width="20%">#springMessage('table.fexForeignReq.contractNo')</td>
									<td width="30%">$!{fexTranReqPage.contractNo}</td>
									##外汇局批件/备案表号/业务编号
									<td class="textRight" width="20%">#springMessage('table.fexForeignReq.busNo')</td>
									<td width="30%">$!{fexTranReqPage.busNo}</td>
								</tr>
								<tr>
									##结汇资金用途
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.purpose')</td>
									<td width="30%">$dictTag.get("fex.tranApp.purpose",$!{fexTranReqPage.purpose})</td>
									##结汇资金详细用途
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.purposeDtl')</td>
									<td width="30%">$!{fexTranReqPage.purposeDtl}</td>
								</tr>
								<tr>
									##发票号
									<td class="textRight">#springMessage('table.fexForeignReq.invoiceNo')</td>
									<td>$!{fexTranReqPage.invoiceNo}</td>
									##交易编码
									<td class="textRight">#springMessage('table.fexTranInfo.tranCode')</td>
									<td>$!{fexTranReqPage.tranName1}</td>
								</tr>
								<tr>
									##联系人
									<td class="textRight" width="20%">#springMessage('table.externalCorp.linkMan')</td>
									<td width="30%">$!{fexTranReqPage.corpContact}</td>
									##电话
									<td class="textRight" width="20%">#springMessage('table.externalCorp.tel')</td>
									<td width="30%">$!{fexTranReqPage.corpContactTel}</td>
								</tr>
								<tr>
									##交易员
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.dealer')</td>
									<td width="30%">$!{dealer}</td>
									##交易地点
									<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAddr')</td>
									<td width="30%">$!{fexTranReqPage.tranAddr}</td>
								</tr>
								<tr>
									##交易组
									<td class="textRight">#springMessage('table.fexTranReq.tranGroup')</td>
									<td>$!{fexTranReqPage.tranGroupName}</td>
									##关联交易号码
									<td class="textRight">#springMessage('table.fexTranReq.relBillNo')</td>
									<td>$!{fexTranReqPage.relBillNo}</td>
								</tr>
								</tbody>
							</table>
						</div>
					</div>
					<div class="layui-colla-item" #if($!{bankType.isSetOtherCustom} != "1") style="display: none" #end>
						<h2 class="layui-colla-title">#springMessage('cms.loan.OtherInfo')</h2>
						<div class="layui-colla-content layui-show">
							<table class="layui-table">
								<tbody>
								<tr>
									##资金来源
									<td class="textRight" width="20%">
										#if($!{otherCustom.needField.indexOf("fundsSource")} != -1)
											#springMessage('table.fexTranReq.fundsSource')
										#end
									</td>
									<td width="30%">
										#if($!{otherCustom.needField.indexOf("fundsSource")} != -1)
											$dictTag.get("fex.tranApp.fundsSource",$!{fexTranReqPage.fundsSource})
										#end
									</td>
									##结售汇属性
									<td class="textRight" width="20%">
										#if($!{otherCustom.needField.indexOf("fexProp")} != -1)
											#springMessage('table.fexTranReq.fexProp')
										#end
									</td>
									<td width="30%">
										#if($!{otherCustom.needField.indexOf("fexProp")} != -1)
											#if($!{fexTranReqPage.fexBusType} == "2")
												$dictTag.get("fex.tranApp.fexProp2",$!{fexTranReqPage.fexProp})
											#else
												$dictTag.get("fex.tranApp.fexProp",$!{fexTranReqPage.fexProp})
											#end
										#end
									</td>
								</tr>
								<tr>
									##附言
									<td class="textRight">
										#if($!{otherCustom.needField.indexOf("addWord")} != -1)
											#springMessage('table.nisBillhead.addWord')
										#end
									</td>
									<td colspan="3">
										#if($!{otherCustom.needField.indexOf("addWord")} != -1)
											$!{fexTranReqPage.addWord}
										#end
									</td>
								</tr>
								<tr #if($!{otherCustom.needField.indexOf("rmk")} == -1) style="display: none" #end>
									##备注（英文）
									<td class="textRight" width="20%">#springMessage('bisAccAttribute.rmk')</td>
									<td colspan="3">$!{fexTranReqPage.rmk}</td>
								</tr>
								<tr #if($!{otherCustom.needField.indexOf("rmkLocal")} == -1) style="display: none" #end>
									##备注（本地语言）
									<td class="textRight" width="20%">#springMessage('table.fexForeignReq.rmkLocal')</td>
									<td colspan="3">$!{fexTranReqPage.rmkLocal}</td>
								</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
				<!-- 资金计划 -->
				<div id="tagItemDetail"></div>
			</div>
			<!-- 附件上传 -->
			<input id="attachmentId" name="attachmentId" type="hidden" value="$!{fexTranReqPage.attachmentId}">
			<div id="uploader" class="layui-input-inline" style="width:100%"></div>
			<p>
			#if($!{opType})
				#if($!{opType} == "1")
					<!-- 展期/提前交割 -->
					<table class="layui-table">
						<thead>
						<tr>
							<th colspan="8">#springMessage('fextranreq.button.delivery')</th>
						<tr>
						<tr>
							<th>#springMessage('table.fexTranDeal.deliverySign')</th>
							<th>#springMessage('table.fexTranDeal.oldSettleDate')</th>
							<th>#springMessage('table.fexTranDeal.newSettleDate')</th>
							<th>#springMessage('table.fexTranDeal.settleMoney')</th>
							<th>#springMessage('table.fexTranDeal.settleRate')</th>
							<th>#springMessage('table.fexTranDeal.wishRate')</th>
							<th>#springMessage('table.accountDTO.balance')</th>
							<th>#springMessage('fcVoucherType.rmk')</th>
						</tr>
						</thead>
						<tbody>
						<tr>
							<td align="center">
								$dictTag.get("fexTranDeal.deliverySign",$!{fexTranDealPage.deliverySign})
							</td>
							<td align="center">
								$!date.format('yyyy-MM-dd',$!{fexTranDealPage.oldSettleDate})
							</td>
							<td align="center">
								$!date.format('yyyy-MM-dd',$!{fexTranDealPage.newSettleDate})
							</td>
							<td align="right">
								$!number.formatNumeric($!{fexTranDealPage.settleMoney})
							</td>
							<td align="right">
								$!number.formatDoubles($!{fexTranDealPage.settleRate}, 6)
							</td>
							<td align="right">
								$!number.formatDoubles($!{fexTranDealPage.wishRate}, 6)
							</td>
							<td align="right">
								$!number.formatNumeric($!{fexTranDealPage.bal})
							</td>
							<td align="right">$!{fexTranDealPage.rmk}</td>
						</tr>
						</tbody>
					</table>
				#elseif($!{opType} == "2")
					<!-- 违约 -->
					<table class="layui-table">
						<thead>
						<tr>
							<th colspan="6">#springMessage('fextranreq.button.default')</th>
						<tr>
						<tr>
							<th>#springMessage('table.fexTranDeal.defaultDate')</th>
							<th>#springMessage('table.fexTranDeal.defaultCurId')</th>
							<th>#springMessage('table.fexTranDeal.defaultMoney')</th>
							<th>#springMessage('table.fcSubjectDay.optDate')</th>
							#*<th>#springMessage('table.fexTranDeal.settleMoney')</th>*#
							<th>#springMessage('table.fexTranDeal.defaultRate')</th>
							<th>#springMessage('fcVoucherType.rmk')</th>
						</tr>
						</thead>
						<tbody>
						<tr>
							<td align="center">
								$!date.format('yyyy-MM-dd',$!{fexTranDealPage.defaultDate})
							</td>
							<td align="center">
								$!{fexTranDealPage.englishCode}
							</td>
							<td align="right">
								$!number.formatNumeric($!{fexTranDealPage.defaultMoney})
							</td>
							<td align="center">
								$!date.format('yyyy-MM-dd',$!{fexTranDealPage.newSettleDate})
							</td>
							#*<td align="right">
								$!number.formatNumeric($!{fexTranDealPage.settleMoney})
							</td>*#
							<td align="right">
								$!number.formatDoubles($!{fexTranDealPage.wishRate}, 6)
							</td>
							<td align="right">$!{fexTranDealPage.rmk}</td>
						</tr>
						</tbody>
					</table>
				#else
					<!-- NDF交割 -->
					<table class="layui-table">
						<thead>
						<tr>
							<th colspan="6">#springMessage('fextranreq.button.ndfdelivery')</th>
						<tr>
						<tr>
							<th>#springMessage('table.fexTranDeal.deliveryRate')</th>
							<th>#springMessage('table.fexTranDeal.settleCurId')</th>
							<th>#springMessage('table.fexTranDeal.settleMoney')</th>
							<th>#springMessage('table.fexTranDeal.deliveryDate')</th>
							<th>#springMessage('table.fcSubjectDay.optDate')</th>
							<th>#springMessage('fcVoucherType.rmk')</th>
						</tr>
						</thead>
						<tbody>
						<tr>
							<td align="right">
								$!number.formatDoubles($!{fexTranDealPage.deliveryRate}, 6)
							</td>
							<td align="center">
								$!{fexTranDealPage.englishCode}
							</td>
							<td align="right">
								$!number.formatNumeric($!{fexTranDealPage.settleMoney})
							</td>
							<td align="center">
								$!date.format('yyyy-MM-dd',$!{fexTranDealPage.deliveryDate})
							</td>
							<td align="center">
								$!date.format('yyyy-MM-dd',$!{fexTranDealPage.newSettleDate})
							</td>
							<td align="right">$!{fexTranDealPage.rmk}</td>
						</tr>
						</tbody>
					</table>
				#end
			#end
			<!-- 日志 -->
			<div id="tagMsg"></div>
			<div class="layui-form-item layui-form-submit" id="buttonDiv">
				<div class="layui-input-block">
					<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{fexTranReqPage.id}')">#springMessage('common.button.trackFlow')</button>
					<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
				</div>
			</div>
			</form>
		</div>
		<div class="layui-tab-item">
			<table id="appTable" class="layui-table layui-form" style="width:100%;">
				<thead>
				<tr>
					#if($!{fexTranReqPage.status} == "95")
						<th>#springMessage('table.fexCashFlow.billNo')</th>
					#end
					<th>#springMessage('table.fexTranReq.cashFlowDate')</th>
					<th>#springMessage('table.fcSubjectDay.optDate')</th>
					<th>#springMessage('table.fexBankAcc.cashFlowType')</th>
					<th>#springMessage('table.bisAccDtl.curName')</th>
					<th>#springMessage('table.choBankFinance.payMoney')</th>
					<th>#springMessage('table.nisBillhead.corpId')</th>
					<th>#springMessage('common.button.bank')</th>
					<th>#springMessage('table.btBankAccApp.accName')</th>
					<th>#springMessage('table.foreign.bankAcc')</th>
					<th>#springMessage('fex.cotp')</th>
					<th>#springMessage('table.fexTranReq.cotpBank')</th>
					<th>#springMessage('table.fexTranReq.cotpAccName')</th>
					<th>#springMessage('table.fexForeign.cotpAcc')</th>
					<th>#springMessage('table.foreign.voucherType')</th>
					<th>#springMessage('fcVoucherType.rmk')</th>
				</tr>
				</thead>
				#if($!{fexTranReqPage.status} == "95")
					#foreach($data in $cashFlowList)
					<tr>
						<td align="center">$!{data.billNo}</td>
						<td align="center">$!date.format('yyyy-MM-dd',$!{data.cashFlowDate})</td>
						<td align="center">$!date.format('yyyy-MM-dd',$!{data.settleDate})</td>
						<td align="center">$dictTag.get("fexCorp.cashFlowType",$!{data.cashFlowType})</td>
						<td align="center">$!{data.englishCode}</td>
						<td align="right">
							#if($!{data.cdSign}=="1")
								-$!number.formatNumeric($!{data.payMoney})
							#else
								$!number.formatNumeric($!{data.payMoney})
							#end
						</td>
						<td align="center">$!{data.corpName}</td>
						<td align="center">$!{data.corpBankName}</td>
						<td align="center">$!{data.corpAccName}</td>
						<td align="center">$!{data.corpBankAcc}</td>
						<td align="center">$!{data.cotpName}</td>
						<td align="center">$!{data.cotpBankName}</td>
						<td align="center">$!{data.cotpAccName}</td>
						<td align="center">$!{data.cotpBankAcc}</td>
						<td align="center">$!{data.voucherTypeName}</td>
						<td align="left">$!{data.rmk}</td>
					</tr>
					#end
				#else

				#if(${fexTranReqPage.fexTranType} == "1" || ${fexTranReqPage.fixedMoney.indexOf("1")} > -1)
				<tr id="srcTr">
				#else
				<tr id="srcTr" style="display: none">
				#end
					##现金流日期
					<td align="center">$!{sysDate}</td>
					##结算日期
					<td align="center"><div id="srcSettleDateTd">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})</div></td>
					##现金流类型
					<td align="center"><div id="srcCashFlowTypeTd">$dictTag.get("fexCorp.cashFlowType","0")</div></td>
					##币种
					<td align="center"><div id="srcCurTd">$!{fexTranReqPage.buyEnglishCode}</div></td>
					##金额
					<td align="right"><div id="srcPayMoneyTd">$!number.formatNumeric($!{fexTranReqPage.buyMoney})</div></td>
					##单位
					<td align="center"><div id="srcCorpTd">$!{fexTranReqPage.corpName}</div></td>
					##银行
					<td align="center"><div id="srcBankTd">$!{fexTranReqPage.corpBankName}</div></td>
					##账户名称
					<td align="center"><div id="srcAccNameTd">$!{fexTranReqPage.corpAccName}</div></td>
					##银行账户
					<td align="center"><div id="srcBankAccTd">$!{fexTranReqPage.corpBankAcc}</div></td>
					##交易对手
					<td align="center"><div id="srcCotpTd">$!{fexTranReqPage.cotpName}</div></td>
					##交易对手银行
					<td align="center"><div id="srcCotpBankTd">$!{fexTranReqPage.cotpBankName}</div></td>
					##交易对手账户名称
					<td align="center"><div id="srcCotpAccNameTd">$!{fexTranReqPage.cotpAccName}</div></td>
					##交易对手银行账户
					<td align="center"><div id="srcCotpBankAccTd">$!{fexTranReqPage.cotpBankAcc}</div></td>
					##支付方式
					<td align="center"><div id="srcPayTypeTd">$!{fexTranReqPage.voucherTypeName}</div></td>
					<td align="left"></td>
				</tr>
				#if(${fexTranReqPage.fexTranType} == "1" || ${fexTranReqPage.fixedMoney.indexOf("2")} > -1)
				<tr id="targetTr">
				#else
				<tr id="targetTr" style="display: none">
				#end
					<td align="center">$!{sysDate}</td>
					<td align="center"><div id="targetSettleDateTd">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})</div></td>
					<td align="center"><div id="targetCashFlowTypeTd">$dictTag.get("fexCorp.cashFlowType","0")</div></td>
					<td align="center"><div id="targetCurTd">$!{fexTranReqPage.sellEnglishCode}</div></td>
					<td align="right"><div id="targetPayMoneyTd">-$!number.formatNumeric($!{fexTranReqPage.sellMoney})</div></td>
					<td align="center"><div id="targetCorpTd">$!{fexTranReqPage.corpName}</div></td>
					<td align="center"><div id="targetBankTd">$!{fexTranReqPage.srcBankName}</div></td>
					<td align="center"><div id="targetAccNameTd">$!{fexTranReqPage.srcAccName}</div></td>
					<td align="center"><div id="targetBankAccTd">$!{fexTranReqPage.srcBankAcc}</div></td>
					<td align="center"><div id="targetCotpTd">$!{fexTranReqPage.cotpName}</div></td>
					<td align="center"><div id="targetCotpBankTd">$!{fexTranReqPage.cotpBankName}</div></td>
					<td align="center"><div id="targetCotpAccNameTd">$!{fexTranReqPage.targetAccName}</div></td>
					<td align="center"><div id="targetCotpBankAccTd">$!{fexTranReqPage.targetBankAcc}</div></td>
					<td align="center"><div id="targetPayTypeTd">$!{fexTranReqPage.voucherTypeName}</div></td>
					<td align="left"></td>
				</tr>
			#end
			</table>
		</div>
		<div class="layui-tab-item">
			<!-- 自定义信息 -->
			<div id="custMsg"></div>
		</div>
	</div>
	#parse("views/common/footer.vm")
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<input type="hidden" id="caType"  value="12"/>
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input id="eqi_tranType" name="eqi_tranType" type="hidden" value="$!{tranType}">
        <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
        <table class="layui-table">
            <tbody>
                <tr>
                    ##交易号码
                    <td class="textRight">#springMessage('table.fexTranReq.billNo')</td>
                    <td>
                        <input type="text" name="likes_billNo"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.billNo')">
                    </td>
                    ##单位
                    <td class="textRight">#springMessage('nis.pool.fcCorpPool.poolCorp')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="ins_corpId"
                                 data-scope="all"></div>
                        </div>
                    </td>
                    ##交易对手
                    <td class="textRight">#springMessage('table.fexForeign.copt')</td>
                    <td>
##                        <div class="layui-input-inline">
##                            <div class="bt-biz-mulselectType" data-url="${basePath}/foreign/fexCotp/listBankCotp" data-name ="ins_cotpId" data-biz-name ="ins_cotpId"
##                                 data-valueField="id" data-textField="cotpName" data-method="get"></div>
##                        </div>
                        <div class="layui-input-inline">
                            <input type="text" id="cotpName" name="eqs_cotpName" readonly="readonly" class="layui-input">
                            <input type="hidden" id="oppId" name="oppId" value="">
                            <div class="bt-div-search">
                                <button class="bt-biz-allExternalBankAcc" id="selCoptExternalAccBut" type="button" data-callback="bt.cotpExternalAccCallback" data-beforeClick="bt.cotpExternalAccBeforeClick" title="#springMessage('common.button.select')">
                                    <i class="layui-icon">&#xe615;</i>
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##币种
                    <td class="textRight">#springMessage('table.bisAccDtl.curName')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_curId" data-biz-name ="eqs_curId"
                             data-valueField="id" data-textField="englishCode"></div>
                    </td>
                    ##交易日期
                    <td class="textRight">#springMessage('table.btNetChalk.transTime')</td>
                    <td>
                        <input type="text" name="ged_tranDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_tranDate" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_tranDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_tranDate">
                    </td>
                    ##结算日期
                    <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                    <td>
                        <input type="text" name="ged_settleDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_settleDate" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_settleDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_settleDate">
                    </td>
                </tr>
                <tr>
                    ##产品
                    <td class="textRight">#springMessage('table.fexBankAcc.proId')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProduct/$!{tranType}" data-name ="eqs_proId" data-biz-name ="eqs_proId"
                             data-valueField="id" data-textField="proName"></div>
                    </td>
                    ##资金性质
                    <td class="textRight">#springMessage('table.fexTranReq.accNature')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="fexTranReq.accNature" data-name="eqs_accNature"></div>
                    </td>
                    ##单据来源
                    <td class="textRight">#springMessage('table.nisBillhead.billFrom')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-displayData="0,1,2,4,10,15"
                             data-group="foreign.billFrom" data-name="eqs_billFrom"></div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.fexTranReq.billNo')</th>
            <th>#springMessage('table.fexBankAcc.proId')</th>
            <th>#springMessage('table.nisBillhead.difBank')</th>
            <th>#springMessage('table.fexBankAcc.cdSign')</th>
            <th>#springMessage('table.fexForeignReq.remitType')</th>
            <th>#springMessage('table.fexTranReq.isPayed')</th>
            <th>#springMessage('nis.pool.fcCorpPool.poolCorp')</th>
            <th>#springMessage('table.fexTranReq.corpBank')</th>
            <th>#springMessage('table.fexTranReq.corpBankAcc')</th>
            <th>#springMessage('table.btBankAccApp.accName')</th>
            <th>#springMessage('table.fexForeign.copt')</th>
            <th>#springMessage('fex.cotp')#springMessage('common.button.bank')</th>
            <th>#springMessage('fex.cotp')#springMessage('table.fexForeign.bankAcc')</th>
            <th>#springMessage('table.bisAccDtl.curName')</th>
            <th>#springMessage('table.btNetChalk.transTime')</th>
            <th>#springMessage('table.fcSubjectDay.optDate')</th>
            <th>#springMessage('table.choBankFinance.payMoney')</th>
            <th>#springMessage('table.nisBillhead.bursarBillNo')</th>
            <th>#springMessage('table.fexTranReq.accNature')</th>
            <th>#springMessage('table.nisBillhead.billFrom')</th>
            <th>#springMessage('table.fexTranReq.relBillNo')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
    #paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
    #caDataHidden()
    #caDataScript()
    #paymentWorkFlowScript()
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexTranReqPay.listApprove.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/foreign/fexTranReq.listApprove.js?_btv=${resourceVersion}"></script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##交易组号码
                    <td class="textRight">#springMessage('table.fexTranGroup.billNo')</td>
                    <td>
                        <input type="text" name="likes_billNo"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranGroup.billNo')">
                    </td>
                    ##交易组名称
                    <td class="textRight">#springMessage('table.fexTranGroup.groupName')</td>
                    <td>
                        <input type="text" name="likes_groupName"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranGroup.groupName')">
                    </td>
                    ##产品
                    <td class="textRight">#springMessage('table.fexTranGroup.proId')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProduct/0" data-name ="eqs_proId" data-biz-name ="eqs_proId"
                             data-valueField="id" data-textField="proName"></div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.fexTranGroup.billNo')</th>
            <th>#springMessage('table.fexTranGroup.groupName')</th>
            <th>#springMessage('table.fexTranGroup.proId')</th>
            <th>#springMessage('table.fexProduct.trangroupRuleId')</th>
            <th>#springMessage('bisAccAttribute.validSign')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexTranGroup.list.js?_btv=${resourceVersion}"></script>

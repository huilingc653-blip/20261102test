<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="poolId" name="poolId" type="hidden" value="$!{fexCorpPoolPage.poolId}">
    <input id="corpId" name="corpId" type="hidden" value="$!{fexCorpPoolPage.corpId}">
    <input id="curId" name="curId" type="hidden" value="$!{fexCorpPoolPage.curId}">
    <table class="layui-table">
        <tbody>
        <tr>
        ##资金池主体
            <td class="textRight" width="30%">#springMessage('nis.pool.fcCorpPool.pool')</td>
            <td>
                $!{fexCorpPoolPage.poolName}
            </td>
        </tr>
        <tr>
        ##资金池性质
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.accNature')</td>
            <td>
                $dictTag.get("fexCorpPool.poolNature",$!{fexCorpPoolPage.poolNature})
            </td>
        </tr>
        <tr>
        ##是否限额管控
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.isLimitControl')</td>
            <td>
                $dictTag.get("sf_yn",$!{fexCorpPoolPage.isLimitControl})
            </td>
        </tr>
        <tr>
        ##限额折算币种
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.curId')</td>
            <td>
                $!{fexCorpPoolPage.englishCode}
            </td>
        </tr>
        <tr>
        ##限额折算汇率类型
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.rateType')</td>
            <td>
                $!{fexCorpPoolPage.typeName}
            </td>
        </tr>
        <tr>
        ##限额设置
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.limit')</td>
            <td>
                <div class="layui-input-inline" style="width:100%">
                    #foreach($limit in $!{fexCorpPoolPage.fexCorpPoolLimits})
                        $dictTag.get("fexCorpPoolLimit.limitType",$!{limit.limitType})
                        &nbsp;$!number.formatNumeric($!{limit.limitMoney})
                    #end
                </div>
            </td>
        </tr>
        <tr>
        ##有效标志
            <td class="textRight" width="30%">#springMessage('table.btCurrency.validSign')</td>
            <td>
                $dictTag.get("sf_yn",$!{fexCorpPoolPage.validSign})
            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight" width="30%">#springMessage('table.fcCorpPool.rmk')</td>
            <td>
                $!{fexCorpPoolPage.rmk}
            </td>
        </tr>
        </tbody>
    </table>
    <table id="dataTable" class="layui-table">
        <thead>
        <th>#springMessage('table.fexCorpPool.mainAccount')</th>##主账号
        <th>#springMessage('table.nisBillhead.corpId')</th>##单位
        <th>#springMessage('contract.currency')</th>##币种
        <th>#springMessage('table.fexCorpPool.accNature')</th>##账户资金性质
        </thead>
        <tbody>
            #foreach($acc in $!{fexCorpPoolPage.accList})
                #set($vcount = $velocityCount - 1)
            <tr data-row="${vcount}">
                <td class="center">
                    $!{acc.bankAcc}
                </td>
                <td class="center">
                    $!{acc.corpName}
                </td>
                <td class="center">
                    $!{acc.englishCode}
                </td>
                <td class="center">
                    $dictTag.get("fexCorpPoolBank.accNature",$!{acc.accNature})
                </td>
            </tr>
            #end
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form', 'layedit', 'moneyType', 'printType','selectType'], function () {
        var $ = bt.jquery, form = bt.form();
        var moneyType = bt.moneyType.init();
        var moneyFun = bt.moneyType.getFun();
        bt.printType.init();
        bt.selectType.init();
    });
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<body>
	<form class="layui-form layui-form-pane">
		<input type="hidden" id="taskId" name= "taskId" value="$!{taskId}">
		<input type="hidden" id="caType"  value="12"/>
	</form>
	#parse("views/foreign/viewFexForeignReq.vm")
	#parse("views/common/caData.vm")
	#paymentWorkFlowHtml()
	#caDataHidden()
	#caDataScript()
	#paymentWorkFlowScript()
	<script>
		bt.use(['form','jquery'], function(){
			var $ = bt.jquery,form = bt.form();
			bt.workFlow.beforeSubmit = function(submitData){
				var taskIds = [];
				taskIds.push($("#taskId").val());
				bt.workFlow.taskList = taskIds;
				return true;
			}
			bt.workFlow.afterSubmit = function(){
				parent.layer?parent.layer.closeAll():layer.closeAll();
			}
            /**
             * 审批后事件
             */
            bt.workFlow.afterSubmit = function () {
                bt.navtab.getParentDom().initCorp();
            }
		});
	</script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")

</head>
<body>

<div class="layui-fluid">
    <form class="layui-form" method="post" id="inputForm">
        <table class="layui-table">
            <tbody>
                <tr>
                    <td class="textRight" width="20%">#springMessage('table.fexForeignReq.tranTemplate')</td>
                    <td width="30%">
                        <div class="layui-input-inline">
                            <input type="text" id="templateName" lay-verify="required"  readonly="readonly" class="layui-input">
                            <input type="hidden" id="templateId" name="templateId" >
                            <input type="hidden" id="versionNo" name="versionNo">
                            <!-- 银行账户选择弹窗按钮 -->
                            <div class="bt-div-search" style="top:5px;right: 2px;">
                                <button id="templateBtn" type="button" title="#springMessage('common.button.select')">
                                    <i class="layui-icon">&#xe615;</i>
                                </button>
                            </div>
                        </div>
                    </td>
                    <td class="textRight" width="20%">#springMessage('replenish.CustomField')</td>
                    <td width="30%">
                        <div class="layui-input-inline">
                            <input type="text" id="custFieldName" lay-verify="required"  readonly="readonly" class="layui-input">
                            <input type="hidden" id="custFields" name="custFields" >
                            <!-- 银行账户选择弹窗按钮 -->
                            <div class="bt-div-search" style="top:5px;right: 2px;">
                                <button id="custFieldBtn" type="button" title="#springMessage('common.button.select')">
                                    <i class="layui-icon">&#xe615;</i>
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td colspan="2" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                        <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallback">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>

    </form>
</div>
    #caDataHidden()
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/foreignTranReqConfig/batchChooseCustFields.add.js?_btv=${resourceVersion}"></script>

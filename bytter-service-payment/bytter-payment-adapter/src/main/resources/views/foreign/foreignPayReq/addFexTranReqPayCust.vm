<!DOCTYPE html>
<html>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
    <style>
        /* 全局变量：严格对齐截图尺寸 */
        :root {
            --label-w: 200px;     /* 标签固定宽度，与上方统一 */
            --label-w2: 150px;
            --vertical-w: 50px;   /* 左侧垂直组件标题宽度 */
            --row-gap: 10px;      /* 行间距，匹配截图 */
        }
        .layui-colla-content {
            padding-top: 10px;
            padding-bottom: 10px;
        }
        /* 1. 前三行：栅格布局，每行左右各50%，删除自动前移 */
        .top-grid-row {
            display: flex;
            margin-bottom: var(--row-gap);
        }
        .top-col {
            width: 50%;
            display: flex;
            align-items: center;
        }

        /* 2. 下方整体：左右各50%两大独立组件容器，互不干扰 */
        .bottom-grid-wrap {
            display: flex;
        }
        .bottom-col {
            width: 50%;
            display: flex;
            align-items: flex-start;
        }

        /* 组件容器：垂直通栏标题 + 表单内容区 */
        .form-group {
            display: flex;
            width: 100%;
            height: 100%;
        }
        /* 垂直通栏标题：从上到下整列，不随单行变化 */
        .group-vertical {
            width: var(--vertical-w);
            writing-mode: vertical-rl;
            text-orientation: mixed;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-weight: 500;
            letter-spacing: 6px; /* 加大字体间距 */
            /*background: #f2f2f2;*/
        }
        /* 表单内容区：纵向独立排列，隐藏只影响自身 */
        .group-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            /*gap: var(--row-gap);*/
        }

        /* 表单项：标签固定右对齐，输入框自适应 */
        .form-line {
            display: flex;
            align-items: center;
            width: 100%;
            margin-bottom: var(--row-gap);
        }
        .form-label {
            width: var(--label-w);
            text-align: right;
            padding-right: 12px;
            flex-shrink: 0;
            white-space: nowrap;
        }
        .bottom-col  .form-label {
            width: var(--label-w2);
        }
        .form-input {
            flex: 1;
            min-width: 0;
        }
        .required {
            color: red;
            margin-right: 4px;
        }
        .layui-input, .layui-select {
            /*width: 100%;*/
        }
        .bt-div-search {
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
        }
        .hide {
            display: none !important;
        }
        /* 单行容器：自动换行 */
        .top-grid-row {
            display: flex !important;
            flex-wrap: wrap !important;
            width: 100% !important;
            margin: 0 !important;
            align-items: center;
        }

        /* 表单项列：默认 50% 宽度，间距统一 */
        .top-col {
            width: 50%;

            padding: 0;
        }

        /* 占满整行（用于备注） */
        .top-col-full {
            width: 100% !important;
        }

        /* 超长字段名：允许换行完整展示，避免文字溢出到输入框上被遮挡
           （如 海关特殊监管区域及保税监管场所进出境物流货物金额） */
        .top-col-long .form-label {
            white-space: normal;
            line-height: 16px;
            word-break: break-all;
        }
    </style>
</head>
<body>


<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
    <style>
        /* 全局变量：严格对齐截图尺寸 */
        :root {
            --label-w: 200px; /* 标签固定宽度，与上方统一 */
            --label-w2: 150px;
            --vertical-w: 50px; /* 左侧垂直组件标题宽度 */
            --row-gap: 10px; /* 行间距，匹配截图 */
        }

        .layui-colla-content {
            padding-top: 10px;
            padding-bottom: 10px;
        }

        /* 1. 前三行：栅格布局，每行左右各50%，删除自动前移 */
        .top-grid-row {
            display: flex;
            margin-bottom: var(--row-gap);
        }

        .top-col {
            width: 50%;
            display: flex;
            align-items: center;
        }

        /* 2. 下方整体：左右各50%两大独立组件容器，互不干扰 */
        .bottom-grid-wrap {
            display: flex;
        }

        .bottom-col {
            width: 50%;
            display: flex;
            align-items: flex-start;
        }

        /* 组件容器：垂直通栏标题 + 表单内容区 */
        .form-group {
            display: flex;
            width: 100%;
            height: 100%;
        }

        /* 垂直通栏标题：从上到下整列，不随单行变化 */
        .group-vertical {
            width: var(--vertical-w);
            writing-mode: vertical-rl;
            text-orientation: mixed;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-weight: 500;
            letter-spacing: 6px; /* 加大字体间距 */
            /*background: #f2f2f2;*/
        }

        /* 表单内容区：纵向独立排列，隐藏只影响自身 */
        .group-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            /*gap: var(--row-gap);*/
        }

        /* 表单项：标签固定右对齐，输入框自适应 */
        .form-line {
            display: flex;
            align-items: center;
            width: 100%;
            margin-bottom: var(--row-gap);
        }

        .form-label {
            width: var(--label-w);
            text-align: right;
            padding-right: 12px;
            flex-shrink: 0;
            white-space: nowrap;
        }

        .bottom-col .form-label {
            width: var(--label-w2);
        }

        .form-input {
            flex: 1;
            min-width: 0;
        }

        .required {
            color: red;
            margin-right: 4px;
        }

        .layui-input, .layui-select {
            /*width: 100%;*/
        }

        .bt-div-search {
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
        }

        .hide {
            display: none !important;
        }

        /* 单行容器：自动换行 */
        .top-grid-row {
            display: flex !important;
            flex-wrap: wrap !important;
            width: 100% !important;
            margin: 0 !important;
            align-items: center;
        }

        /* 表单项列：默认 50% 宽度，间距统一 */
        .top-col {
            width: 50%;
            padding: 0;
        }

        /* 占满整行（用于备注） */
        .top-col-full {
            width: 100% !important;
        }

        /* 超长字段名：允许换行完整展示，避免文字溢出到输入框上被遮挡
           （如 海关特殊监管区域及保税监管场所进出境物流货物金额） */
        .top-col-long .form-label {
            white-space: normal;
            line-height: 16px;
            word-break: break-all;
        }

        .form-label * {
            display: inline-block;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
        <ul class="layui-tab-title">
            <li class="layui-this">#springMessage('table.rasBackQuery.msg')</li>
            <li>#springMessage('table.fexTranReq.cashFlow')</li>
        </ul>
        <div class="layui-tab-content">
            <div class="layui-tab-item layui-show" id="rasBackQuery">
                <input id="cloneId" type="hidden" value="$!{cloneId}">
                <input type="hidden" id="templateCustFields" value='$!{templateCustFields}'>
                <input id="createBy" name="createBy" type="hidden" value="$!{fexTranReqPage.createBy}">
                <input id="createDate" name="createDate" type="hidden" value="$!{fexTranReqPage.createDate}">
                <input id="updateBy" name="updateBy" type="hidden" value="$!{fexTranReqPage.updateBy}">
                <input id="updateDate" name="updateDate" type="hidden" value="$!{fexTranReqPage.updateDate}">
                <input id="id" name="id" type="hidden" value="$!{fexTranReqPage.id}">
                <input id="tranType" name="tranType" type="hidden" value="$!{fexTranReqPage.tranType}">
                <input id="status" name="status" type="hidden" value="0">
                <input id="billNo" name="billNo" type="hidden" value="$!{fexTranReqPage.billNo}">
                <input id="tranAppDtlId" name="tranAppDtlId" type="hidden" value="$!{fexTranReqPage.tranAppDtlId}">
                <input id="tranAppDtlNo" name="tranAppDtlNo" type="hidden" value="$!{fexTranReqPage.tranAppDtlNo}">
                <input id="billFrom" name="billFrom" type="hidden" value="$!{fexTranReqPage.billFrom}">
                <!-- 系统参数 -->
                <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
                <input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
                <!-- 资金计划参数 明细项控制模式-->
                <input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
                <input id="settlType" name="settlType" type="hidden" value="0">
                <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
                <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
                <input id="cloneFlag" name="cloneFlag" type="hidden" value="$!{fexTranReqPage.cloneFlag}">
                <input id="editPayMoneyFlag" name="editPayMoneyFlag" type="hidden" value="$!{editPayMoneyFlag}">
                <input id="chinaId" name="chinaId" type="hidden" value="$!{chinaId}">
                <input id="relBillNo" name="relBillNo" type="hidden" value="$!{fexTranReqPage.relBillNo}">
                <input id="rmbId" name="rmbId" type="hidden" value="$!{rmbId}">
                <div class="layui-collapse">
                    <div class="layui-colla-item">
                        <h2 class="layui-colla-title">#springMessage('基础信息')</h2>
                        <div class="layui-colla-content layui-show" id="baseInfo1">
                            #if($!{fexTranReqPage.cloneFlag} != "1")
                                <div class="top-grid-row">
                                    ##交易号码
                                    <div class="top-col">
                                        <div class="form-line">
                                            <div class="form-label">#springMessage('table.fexTranReq.billNo')</div>
                                            <div class="form-input">$!{fexTranReqPage.billNo}</div>
                                        </div>
                                    </div>
                                    ##交易需求编号
                                    <div class="top-col">
                                        <div class="form-line">
                                            <div class="form-label">#springMessage('table.fexTranReq.tranAppDtlNo')</div>
                                            <div class="form-input">$!{fexTranReqPage.tranAppDtlNo}</div>
                                        </div>
                                    </div>
                                </div>
                            #end
                            <div class="top-grid-row" id="baseInfo">
                                <!-- 产品 | 跨行标识 -->
                                <div class="top-col">
                                    <div class="form-line" data-name="templateId">
                                        <div class="form-label"><span class="required">*</span>#springMessage('table.fexForeignReq.tranTemplate')
                                        </div>
                                        <div class="form-input">
                                            <div class="layui-input-inline">
                                                <input type="text" id="templateName" name="templateName" lay-verify="required" value="$!{fexTranReqPage.templateName}"
                                                       title="$!{fexTranReqPage.templateName}" readonly="readonly" class="layui-input">
                                                <input type="hidden" id="templateId" name="templateId" value="$!{fexTranReqPage.templateId}">
                                                <input type="hidden" id="versionNo" name="versionNo" value="$!{fexTranReqPage.versionNo}">
                                                <!-- 银行账户选择弹窗按钮 -->
                                                <div class="bt-div-search" style="top:54%;right: 2px;">
                                                    <button id="templateBtn" type="button"
                                                            title="#springMessage('common.button.select')">
                                                        <i class="layui-icon">&#xe615;</i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="top-col">
                                    <div class="form-line" data-name="difBank">
                                        <div class="form-label"><span class="required">*</span>#springMessage('table.nisBillhead.difBank')</div>
                                        <div class="form-input">
                                            <div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.difBank"
                                                 data-name="difBank" data-value="$!{fexTranReqPage.difBank}"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 收付方向 | 资金性质 -->
                                <div class="top-col">
                                    <div class="form-line" data-name="cdSign">
                                        <div class="form-label"><span class="required">*</span>#springMessage('table.fexBankAcc.cdSign')</div>
                                        <div class="form-input">
                                            <div class="layui-input-inline">
                                                <div class="bt-biz-dict" id="cdSignDef" data-type="radio" data-group="fexCorp.cdSign"
                                                     data-defaultvalue="1" data-name="cdSign" data-disabled="true" data-biz-name="cdSign"
                                                     data-callback="bt.costSignCallback"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="top-col">
                                    <div class="form-line" data-name="accNature">
                                        <div class="form-label"><span class="required">*</span>#springMessage('table.fexTranReq.accNature')</div>
                                        <div class="form-input">
                                            <div class="bt-biz-dict" data-type="select"
                                                 data-group="fexTranReq.accNature"
                                                 data-defaultvalue="$!{fexTranReqPage.accNature}" data-name="accNature"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 汇款类型 | 是否线下付款 -->
                                <div class="top-col">
                                    <div class="form-line" data-name="remitType">
                                        <div class="form-label"><span class="required">*</span>#springMessage(
                                            'table.fexForeignReq.remitType')</div>
                                        <div class="form-input">
                                            <div class="bt-biz-dict" data-type="select"
                                                 data-group="fexForeignReq.remitType"
                                                 data-defaultvalue="$!{fexTranReqPage.remitType}" data-name="remitType"
                                                 data-biz-name="remitType" data-required="true"
                                                 data-callback="bt.remitTypeCallback"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- 【左右 50% 分栏：主体单位信息 | 交易对手信息】 -->
                            <div class="bottom-grid-wrap">
                                <!-- 左侧：主体单位信息 corpInfo -->
                                <div class="bottom-col">
                                    <div class="form-group">
                                        <div class="group-vertical">#springMessage('table.fexTranReq.corpInfo')</div>
                                        <div class="group-content" id="corpInfo">
                                            <!-- 单位 -->
                                            <div class="form-line" data-name="corpId">
                                                <div class="form-label"><span class="required">*</span>#springMessage('table.nisBillhead.corpId')</div>
                                                <div class="form-input">
                                                    <input type="hidden" id="corpIdDef" value="$!{fexTranReqPage.corpId}">
                                                    #if($!{fexTranReqPage.tranAppDtlNo})
                                                        $!{fexTranReqPage.corpName}
                                                        <div class="layui-input-inline ignore-required-icon" style="display: none">
                                                    #else
                                                        <div class="layui-input-inline">
                                                    #end
                                                        <div class="bt-biz-corp"
                                                             data-biz-type="corp"
                                                             data-type="selectTree"
                                                             data-name="corpId"
                                                             data-biz-name="corpId"
                                                             data-scope="all"
                                                             data-resource="foreign:fextranreq:pay:apply"
                                                             data-required="true"
                                                             data-callback="bt.corpCallback"
                                                             data-defaultvalue="$!{fexTranReqPage.corpId}"></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- 主体单位银行 -->
                                            <div class="form-line" data-name="corpBank">
                                                <div class="form-label"><span class="required">*</span>#springMessage(
                                                    'table.fexTranReq.corpBank')</div>
                                                <div class="form-input">
                                                    <input type="hidden" id="corpBankDef" value="$!{fexTranReqPage.corpBank}">

                                                    <div class="layui-input-inline">
                                                        <div class="bt-biz-selectType"
                                                             data-url="${basePath}/basic/business/btbanktype/listFilter"
                                                             data-name="corpBank" data-biz-name="corpBank"
                                                             data-valueField="id" data-textField="typeName"
                                                             data-required="true" data-callback="bt.corpBankCallback"
                                                             data-value="$!{fexTranReqPage.corpBank}"></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- 主体单位银行账户 -->
                                            <div class="form-line" data-name="corpBankAcc">
                                                <div class="form-label"><span class="required">*</span>#springMessage('table.fexTranReq.corpBankAcc')</div>
                                                <div class="form-input">

                                                    <div class="layui-input-inline">
                                                        <input type="hidden" id="payerCountryNameZh"
                                                               name="payerCountryNameZh" value="$!{payerCountryNameZh}">
                                                        <input type="hidden" id="payerCountryId" name="payerCountryId"
                                                               value="$!{payerCountryId}">
                                                        <input type="hidden" id="payerBifCode" name="payerBifCode"
                                                               value="$!{payerAcc.bifCode}">
                                                        <input type="hidden" id="payerIsDomesticBank"
                                                               name="payerIsDomesticBank"
                                                               value="$!{payerAcc.isDomesticBank}">
                                                        <input type="hidden" id="payerEnCode" name="payerEnCode"
                                                               value="$!{payerEnCode}">


                                                        #if($!{editPayMoneyFlag} != '0')
                                                            <input type="text" id="corpBankAcc" name="corpBankAcc"
                                                                   lay-verify="required|tableData"
                                                                   data-biz-name="corpBankAcc" data-required="true"
                                                                   value="$!{fexTranReqPage.corpBankAcc}"
                                                                   autocomplete="off" class="layui-input text"
                                                                   placeholder="#springMessage('table.fexTranReq.corpBankAcc')"
                                                                   data-callback="bt.corpBankAccCallback">
                                                            <table id="corpBankAccTable" class="hide">
                                                                <thead>
                                                                <tr>
                                                                    <th>#springMessage('table.choBankFinance.acc')</th>
                                                                    <th>#springMessage('table.btBankAccApp.accName')</th>
                                                                    <th>#springMessage('table.btBankAcc.bankName')</th>
                                                                    <th>#springMessage('table.nisBillhead.curId')</th>
                                                                </tr>
                                                                </thead>
                                                            </table>
                                                        #else
                                                            $!{fexTranReqPage.corpBankAcc}
                                                            <input type="hidden" id="corpBankAcc" name="corpBankAcc" lay-verify="required"
                                                                   data-biz-name="corpBankAcc" data-required="true"
                                                                   value="$!{fexTranReqPage.corpBankAcc}"
                                                                   autocomplete="off">
                                                        #end
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- 交易办理机构 -->
                                            <div class="form-line #if($!{fexTranReqPage.corpBankName} !=
                                                "民生银行") layui-hide #end>" data-name="branchCode">
                                                <div class="form-label"><span id="payerBankSpan">#springMessage(
                                                    'table.fexTranReq.branchCode')</span></div>
                                                <div class="form-input">
                                                    <div class="layui-input-inline" id="branchDiv">
                                                        <div class="layui-input-inline">
                                                            <input type="text" id="branchCode" name="branchCode"
                                                                   data-biz-name="branchCode" readonly="readonly"
                                                                   value="$!{fexTranReqPage.branchName}"
                                                                   autocomplete="off" class="layui-input text"
                                                                   placeholder="#springMessage(
                                                                       'table.bisBankBranch.branchCode')">
                                                            <table id="branchCodeTable" class="hide">
                                                                <thead>
                                                                <tr>
                                                                    <th>#springMessage(
                                                                        'table.bisBankBranch.branchCode')</th>
                                                                    <th>#springMessage(
                                                                        'table.bisBankBranch.branchName')</th>
                                                                </tr>
                                                                </thead>
                                                            </table>
                                                        </div>
                                                        <div class="layui-input-inline">
                                                            <input type="text" id="branchName" name="branchName"
                                                                   data-biz-name="branchName" readonly="readonly"
                                                                   width="180px;" value="$!{fexTranReqPage.branchName}"
                                                                   autocomplete="off" class="layui-input text"
                                                                   placeholder="#springMessage(
                                                                       'table.bisBankBranch.branchName')">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- 账户名称 -->
                                            <div class="form-line" data-name="corpAccName">
                                                <div class="form-label">#springMessage('table.fexTranReq.corpAccName')</div>
                                                <div class="form-input">
                                                    <input type="hidden" id="corpAccId" name="corpAccId" value="$!{fexTranReqPage.corpAccId}">
                                                    <input type="hidden" id="corpAccName" name="corpAccName" value="$!{fexTranReqPage.corpAccName}">
                                                    <div id="corpAccNameDiv">$!{fexTranReqPage.corpAccName}</div>
                                                </div>
                                            </div>
                                            <!-- 账户币种 -->
                                            <div class="form-line" data-name="corpAccCurId">
                                                <div class="form-label">#springMessage(
                                                    'fex.mainCorpAccountBz')</div>
                                                <div class="form-input">
                                                    <input type="hidden" id="corpAccCurId" name="corpAccCurId"
                                                           value="$!{fexTranReqPage.corpAccCurId}">
                                                    <div id="corpAccCurNameDiv"
                                                         name="corpAccCurNameDiv">$!{fexTranReqPage.corpAccEnglishCode}</div>
                                                </div>
                                            </div>
                                            <!-- 账户类别 -->
                                            <div class="form-line" data-name="accType">
                                                <div class="form-label">#springMessage('table.fexTranReq.accType')</div>
                                                <div class="form-input">
                                                    <div id="accTypeDiv" name="accTypeDiv">
                                                        $dictTag.get("btBankAcc.accType",$!{fexTranReqPage.accType})
                                                    </div>
                                                    <input type="hidden" id="accType" name="accType" autocomplete="off"
                                                           class="layui-input" value="$!{fexTranReqPage.accType}">
                                                </div>
                                            </div>

                                            <!-- 主体单位名称(英文) -->
                                            <div class="form-line" data-name="corpNameEn">
                                                <div class="form-label">#springMessage('table.fexTranReq.corpNameEn')</div>
                                                <div class="form-input">
                                                    <div class="layui-input-inline">
                                                        <input type="text" id="corpNameEn" name="corpNameEn"
                                                               value="$!{fexTranReqPage.corpNameEn}" readonly="readonly"
                                                            #if(($!{fexTranReqPage.remitType} =="1"
                                                            || $!{fexTranReqPage.remitType} == "2") && $!{fexTranReqPage.corpBankName} && $!{fexTranReqPage.corpBankName.indexOf("工商银行")} != -1)
                                                               lay-verify="required"
                                                            #end
                                                               autocomplete="off" class="layui-input"
                                                               placeholder="#springMessage('table.fexTranReq.corpNameEn')">
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- 主体单位地址(英文) -->
                                            <div class="form-line" data-name="corpAddrEn">
                                                <div class="form-label">#springMessage('table.fexTranReq.corpAddrEn')</div>
                                                <div class="form-input">
                                                    <div class="layui-input-inline">
                                                        <input type="text" id="corpAddrEn" name="corpAddrEn"
                                                               value="$!{fexTranReqPage.corpAddrEn}" readonly="readonly"
                                                            #if($!{fexTranReqPage.corpBankName} == "兴业银行")
                                                               lay-verify="required"
                                                            #end
                                                               autocomplete="off" class="layui-input"
                                                               placeholder="#springMessage(
                                                                   'table.fexTranReq.corpAddrEn')">
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- 主体单位地址(中文) -->
                                            <div class="form-line" data-name="corpAddr">
                                                <div class="form-label">#springMessage('table.fexTranReq.corpAddr')</div>
                                                <div class="form-input">
                                                    <div class="layui-input-inline">
                                                        <input type="text" id="corpAddr" name="corpAddr"
                                                               value="$!{fexTranReqPage.corpAddr}" readonly="readonly"
                                                               autocomplete="off" class="layui-input"
                                                               placeholder="#springMessage(
                                                                   'table.fexTranReq.corpAddr')">
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- 付款清算号 -->
                                            <div class="form-line" data-name="payerLocalClearNoDiv">
                                                <div class="form-label">#springMessage(
                                                    'table.fexTranReq.payerLocalClearNo')</div>
                                                <div class="form-input">
                                                    <div id="payerLocalClearNoDiv"
                                                         name="payerLocalClearNoDiv">$!{fexTranReqPage.payerLocalClearNo}</div>
                                                </div>
                                            </div>

                                            <!-- 主体单位联系人 -->
                                            <div class="form-line" data-name="corpContact">
                                                <div class="form-label"><span class="required">*</span>#springMessage('table.fexTranReq.corpContact')</div>
                                                <div class="form-input">
                                                    <div class="layui-input-inline">
                                                    <input type="text" id="corpContact" name="corpContact"
                                                        data-biz-name="corpContact"
                                                        value="$!{fexTranReqPage.corpContact}"
                                                        autocomplete="off" class="layui-input text"
                                                        placeholder="#springMessage('table.fexTranReq.corpContact')">
                                                        <table id="corpContactTable" class="hide">
                                                            <thead>
                                                            <tr>
                                                                <th>#springMessage('table.fexTranReq.corpContact')</th>
                                                                <th>#springMessage('table.fexTranReq.corpContactTel')</th>
                                                            </tr>
                                                            </thead>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- 主体单位电话 -->
                                            <div class="form-line" data-name="corpContactTel">
                                                <div class="form-label"><span class="required">*</span>#springMessage('table.fexTranReq.corpContactTel1')</div>
                                                <div class="form-input">
                                                    <div class="layui-input-inline">
                                                    <input type="text" id="corpContactTel" name="corpContactTel"
                                                        value="$!{fexTranReqPage.corpContactTel}"
                                                        lay-verify="strlength" data-maxlength="50"
                                                        autocomplete="off" class="layui-input"
                                                        placeholder="#springMessage('table.fexTranReq.corpContactTel')">
                                                    </div>
                                                </div>
                                            </div>


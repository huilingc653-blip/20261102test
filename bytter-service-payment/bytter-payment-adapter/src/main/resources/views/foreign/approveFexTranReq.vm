<!DOCTYPE html>
<html lang="en">
<body>
	<form class="layui-form layui-form-pane">
		<input type="hidden" id="taskId" name= "taskId" value="$!{taskId}">
		<input type="hidden" id="caType"  value="12"/>
	</form>
	#if($!{fexTranReqPage.tranType} == "1")
		#parse("views/foreign/viewFexTranReqForeign.vm")
	#elseif($!{fexTranReqPage.tranType} == "2")
		#parse("views/foreign/viewFexTranReqOption.vm")
	#elseif($!{fexTranReqPage.tranType} == "3")
		#parse("views/foreign/viewFexTranReqAllocation.vm")
	#else
		#if($!{fexTranReqPage.proId} == "53f8408e666b42b9abbe2dcf8372bc76")
			#parse("views/foreign/viewFexTranReqPayHKProduct.vm")
		#elseif($!{fexTranReqPage.proId} == "4c182f17455f4614a79d66bdfd755c8d")
			#parse("views/foreign/viewFexTranReqPayPaypalProduct.vm")
		#else
			#parse("views/foreign/viewFexTranReqPay.vm")
		#end
	#end
	#parse("views/common/caData.vm")
	#paymentWorkFlowHtml()
	#caDataHidden()
	#caDataScript()
	#paymentWorkFlowScript()
	<script>
		bt.use(['form','jquery'], function(){
			var $ = bt.jquery,form = bt.form();
			bt.workFlow.beforeSubmit = function(submitData){
				var taskIds = [];
				taskIds.push($("#taskId").val());
				bt.workFlow.taskList = taskIds;
				return true;
			}
			bt.workFlow.afterSubmit = function(){
				parent.layer?parent.layer.closeAll():layer.closeAll();
			}
		});
	</script>
</body>
</html>
#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<!-- 系统参数 -->
<input id="id" name="id" type="hidden" value="$!{fexForeignReqPage.id}">

<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.billNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.billNo}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.corpName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.remitType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.remitType",$!{fexForeignReqPage.remitType})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.payDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexForeignReqPage.payDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.curId')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.curName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.bisBifInit.bankType')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.bankTypeName}
        </span>
    </li>
    ##汇款账户
    <li class="mui-table-view-cell  mui-collapse keep-unfold">
        <a class="mui-navigate-right" href="#">
            #springMessage('table.fexForeignReq.payerAcc')
            <span class="mui-badge mui-badge-inverted">
                $!{fexForeignReqPage.payerAcc}
            </span>
        </a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payerAccName')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payerAccName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payerBank')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payerBank}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payerName')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payerName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payerTel')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payerTel}
                </span>
            </li>
            #if($!{fexForeignReqPage.remitType} == "1")
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payerNameEn')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payerNameEn}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payerAddEn')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payerAddEn}
                </span>
            </li>
            #end
        </ul>
    </li>
    ##收款账户
    <li class="mui-table-view-cell  mui-collapse keep-unfold">
        <a class="mui-navigate-right" href="#">
            #springMessage('table.fexForeignReq.payeeAcc')
            <span class="mui-badge mui-badge-inverted">
                $!{fexForeignReqPage.payeeAcc}
        </span>
        </a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payeeAccName')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payeeAccName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payeeAdd')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payeeAdd}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payeeSwiftCode')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payeeSwiftCode}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payeeBank')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payeeBank}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payeeBankAdd')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payeeBankAdd}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payeeCountryCode')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payeeCountryName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payeeAgentBank')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payeeAgentBank}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payeeAgentBankAdd')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payeeAgentBankAdd}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fexForeignReq.payeeAgentAcc')
                <span class="mui-badge mui-badge-inverted">
                    $!{fexForeignReqPage.payeeAgentAcc}
                </span>
            </li>
        </ul>
    </li>

    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.payMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexForeignReqPage.payMoney})
        </span>
    </li>
    #if($!{fexForeignReqPage.isOnline} == "0")
        <li class="mui-table-view-cell">
            #springMessage('table.fexForeignReq.foreignExrate')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{fexForeignReqPage.foreignExrate})
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.fexForeignReq.foreignMoney')
            <span class="mui-badge mui-badge-inverted">
                $!rateTag.show($!{fexForeignReqPage.foreignMoney})
            </span>
        </li>
    #end
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.addWordEn')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.addWord}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('fcVoucherType.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.rmk}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.quickSign')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.quickSign",$!{fexForeignReqPage.quickSign})
        </span>
    </li>
    #if($!{fexForeignReqPage.remitType} == "0")
        <li class="mui-table-view-cell">
            #springMessage('table.fexForeignReq.remitNature')
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("fexForeignReq.remitNature",$!{fexForeignReqPage.remitNature})
        </span>
        </li>
    #end
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.remitMethod')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.remitMethod",$!{fexForeignReqPage.remitMethod})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.costSign')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.costSign",$!{fexForeignReqPage.costSign})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.payType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.payType",$!{fexForeignReqPage.payType})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.shipDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexForeignReqPage.shipDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.isBonded')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.payType",$!{fexForeignReqPage.isBonded})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.busNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.busNo}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.contractNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.contractNo}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.invoiceNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.invoiceNo}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.tranCode1')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.tranName1}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.tranAmt1')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexForeignReqPage.tranAmt1})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.tranCurId1')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.curName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.tranAddWord1')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.tranAddWord1}
        </span>
    </li>

    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.tranCode2')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.tranName2}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.tranAmt2')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexForeignReqPage.tranAmt2})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.tranCurId2')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.curName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeignReq.tranAddWord2')
        <span class="mui-badge mui-badge-inverted">
            $!{fexForeignReqPage.tranAddWord2}
        </span>
    </li>
    ## 挂接资金计划
    #if($!{budgetSel} == 1)
        #set($fbsBudgetItemDetail = $fbsBudgetTag.getViewItemDetailMobile($!{fexForeignReqPage.billNo}, "", $!{businessName}, $!{processSysname},$!{fexForeignReqPage.corpId}, $!{fexForeignReqPage.wishPayday}))
        #parse("views/budget/fbsbudget.vm")
    #end
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

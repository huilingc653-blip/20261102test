<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <!-- 银行流水 begin -->
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody >
            <tr>
                ##交易日期
                <td class="textRight" width="10%">#springMessage('table.btNetChalk.transTime')</td>
                <td width="24%">
                    <input type="text" name="ged_transTime" data-type="date" data-biz-name="ged_transTime" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_transTime"  value="$!date.format('yyyy-MM-dd',$!{startDate})">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_transTime" data-type="date" data-biz-name="led_transTime" class="layui-input bt-input-inline bt-biz-dateType" id="led_transTime" data-today="true">
                </td>
                ##单位
                <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.corp')</td>
                <td width="23%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-tree-type="check"
                             data-name="ins_corpId"
                             data-scope="all"
                             data-resource="foreign:refundCheck:query"
                             data-callback="corpCallback"></div>
                    </div>
                </td>
                ##本方账号
                <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.bankAcc')</td>
                <td width="23%">
                    <input type="text" id="likes_bankAcc" name="likes_bankAcc" lay-verify="strlength" data-maxlength="30"
                           data-resource="foreign:refundCheck:query" permission="D,T" accountType="2,3"
                           autocomplete="off" placeholder="#springMessage('table.btBankAccDtl.bankAcc')"
                           data-biz-name="likes_bankAcc"  data-name="likes_bankAcc"
                           class="layui-input bt-biz-accountTable" data-callback="accountCallBack">
                </td>
            </tr>
            <tr>
                ##币别
                <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                             data-name="eqs_curId" data-valueField="id" data-textField="curName"></div>
                    </div>
                </td>
                ##交易金额
                <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.amt')</td>
                <td width="23%">
                    <div class="layui-inline">
                        <input type="text" name="geg_amt" autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" data-minus="true"
                               style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.bisExc.payMoney')">
                        <span class="date-mid">~</span>
                        <input type="text" name="leg_amt" autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" data-minus="true"
                               style="text-align:right" id="t20" placeholder="#springMessage('table.bisExc.payMoney')">
                    </div>
                </td>
                ##勾兑标志
                <td class="textRight" width="10%">#springMessage('table.listPaymentBlending.blendSign')</td>
                <td width="24%">
                    <div class="bt-biz-dict" data-type="select" data-group="paymentblending_status" data-name="eqs_blendSign" data-biz-name="blendSign"></div>
                </td>

            </tr>
            <tr>
                ##对方账号
                <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.oppAccNo')</td>
                <td width="24%">
                    <input type="text" id="likes_oppAccNo" name="likes_oppAccNo"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.oppAccNo')">
                </td>
                ##对方户名
                <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.oppAccName')</td>
                <td width="23%">
                    <input type="text" id="likes_oppAccName" name="likes_oppAccName"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.oppAccName')">
                </td>
                ##用途
                <td class="textRight" width="10%">#springMessage('table.nisBillhead.purpose')</td>
                <td width="23%">
                    <input type="text" id="likes_uses" name="likes_uses"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.purpose')">
                </td>
            </tr>
            <tr>
                ##摘要
                <td class="textRight" width="10%">#springMessage('table.bisAccDtl.summary')</td>
                <td width="23%">
                    <input type="text" id="likes_remark" name="likes_remark"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisAccDtl.summary')">
##                </td>
                ##勾对时间
                <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.paymentBlendingDate')</td>
                <td width="23%">
                    <input type="text" name="ged_paymentBlendingDate" data-type="date" id="receipt_startPaymentBlendingDate" data-biz-name="ged_charageDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="receipt_endPaymentBlendingDate" >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_paymentBlendingDate" data-type="date" id="receipt_endPaymentBlendingDate" data-biz-name="led_charageDate" class="layui-input bt-input-inline bt-biz-dateType" >
                </td>
                <td></td>
                <td></td>
            </tr>
                ##查询
            <tr>
                <td colspan="6" class="center">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
        <table class="layui-table">
            <tbody >
            <tr>
                <td class="textRight" width="10%">#springMessage('table.bvPrintMatchRule.matchRule')</td>
                <td colspan="5">
                    <div class="bt-biz-dict" data-type="checkbox" data-group="foreign.refundCheckRule" data-name="eqs_refundCheckRule" data-biz-name="refundCheckRule"
                         data-defaultvalue="1,2,3,4,5"></div>
                </td>
            </tr>
            <tr>
                <td class="textRight" width="10%">#springMessage('table.refundblending.handle')</td>
                <td colspan="5">
                    <div class="layui-input-inline">
                        ##1-不处理、2-生成新结算执行单、3-生成新交易单
                        <div class="bt-biz-dict" data-type="select" data-group="foreign.refundCheckHandle" data-name="eqs_refundCheckHandle" data-biz-name="refundCheckHandle"
                             data-defaultvalue="1" data-required="true"></div>
                    </div>
                </td>
            </tr>
            </tbody>
        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.listPaymentBlending.blendSign')</th>
            <th>#springMessage('table.btNetChalk.transTime')</th>
            <th>#springMessage('table.btBankAccDtl.corp')</th>
            <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
            <th>#springMessage('table.btBankAccDtl.accName')</th>
            <th>#springMessage('table.btBankAccDtl.curName')</th>
            <th>#springMessage('table.btBankAccDtl.amt')</th>
            <th>#springMessage('table.bisAccDtl.summary')</th>
            <th>#springMessage('table.nisBillhead.purpose')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
            <th>#springMessage('table.bisAccDtl.refundBlendType')</th>
            <th>#springMessage('table.btBankAccDtl.paymentBlendingDate')</th>
            <th>#springMessage('table.fexCashFlow.billNo')</th>
            <th>#springMessage('table.fexTranReq.billNo')</th>
            <th>#springMessage('table.fcSubjectDay.optDate')</th>
            <th>#springMessage('table.choBankFinance.payMoney')</th>
            <th>#springMessage('table.btBankAccApp.accName')</th>
            <th>#springMessage('table.foreign.bankAcc')</th>
            <th>#springMessage('table.fexTranReq.cotpAccName')</th>
            <th>#springMessage('table.fexForeign.cotpAcc')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    <!-- 业务单据 end -->
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexRefundCheck.list.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<input type="hidden" id="billId" name="billId" autocomplete="off" class="layui-input" value="$!{fexProductPage.billId}">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight" width="40%">
						#if($!{fexProductPage.proLevel} == "0")
							#springMessage('table.fexProduct.name')
						#else
							#springMessage('table.fexProduct.proName')
						#end
					</td>
					<td>$!{fexProductPage.proName}</td>
                </tr>
				#if($!{fexProductPage.proLevel} == "1")
					<tr>
						<td class="textRight" width="40%">#springMessage('table.fexProduct.proDesc')</td>
						<td>$!{fexProductPage.proDesc}</td>
					</tr>
				#end
				<tr>
					<td class="textRight">#springMessage('table.fexProduct.proId')</td>
					<td>$!{fexProductPage.parentProName}</td>
				</tr>
				#if($!{fexProductPage.proLevel} == "0")
				<tr>
					<td class="textRight" width="40%">#springMessage('table.fexProduct.addPro')</td>
					<td>
						<div class="layui-input-inline">
							<button class="layui-btn bt-biz-fexProductView" id="fexProductViewBut" type="button" data-beforeClick="bt.fexProductViewParams" data-callback="bt.fexProductViewParams">#springMessage('common.button.view')</button>
						</div>
					</td>
				</tr>
				#end
				#if($!{fexProductPage.proLevel} == "1")
					#if($!{fexProductPage.tranType} == "1")
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.fexBusType')</td>
							<td>$dictTag.get("fexProduct.fexBusType",$!{fexProductPage.fexBusType})</td>
						</tr>
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.fexTranType')</td>
							<td>$dictTag.get("fexProduct.fexTranType",$!{fexProductPage.fexTranType})</td>
						</tr>
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
							<td>$dictTag.get("fexProduct.deliveryType",$!{fexProductPage.deliveryType})</td>
						</tr>
						#if($!{fexProductPage.deliveryType}=="1")
						<tr id="deliveryCurTR">
						#else
						<tr id="deliveryCurTR" style="display: none">
						#end
							<td class="textRight">#springMessage('table.fexProduct.deliveryCurId')</td>
							<td>$!{fexProductPage.deliveryEnglishCode}</td>
						</tr>
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.isAllowedDelivery')</td>
							<td>$dictTag.get("sf_yn",$!{fexProductPage.isAllowedDelivery})</td>
						</tr>
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.isAllowedSettle')</td>
							<td>$dictTag.get("sf_yn",$!{fexProductPage.isAllowedSettle})</td>
						</tr>
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.buyCurId')</td>
							<td>$!{fexProductPage.buyEnglishCode}</td>
						</tr>
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.sellCurId')</td>
							<td>$!{fexProductPage.sellEnglishCode}</td>
						</tr>
					#elseif($!{fexProductPage.tranType} == "2")
						##外汇期权品种
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.fexOption')</td>
							<td>
								$dictTag.get("fexProduct.fexOption1",$!{fexProductPage.fexOption1})&nbsp;&nbsp;
								#if($!{fexProductPage.fexOption1} == "1")
									$dictTag.get("fexProduct.fexOption2",$!{fexProductPage.fexOption2})&nbsp;&nbsp;

									#if($!{fexProductPage.fexOption2} == "2" || $!{fexProductPage.fexOption2} == "3")
										$dictTag.get("fexProduct.fexOption3",$!{fexProductPage.fexOption3})
									#end
								#end
							</td>
						</tr>
						##外汇期权类型 0-欧式、1-美式
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.fexOptionType')</td>
							<td>
								$dictTag.get("fexProduct.fexOptionType",$!{fexProductPage.fexOptionType})
							</td>
						</tr>
						##期权费汇率 0-使用协定汇率、1-使用即期汇率
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.fexOptionRate')</td>
							<td>
								$dictTag.get("fexProduct.fexOptionRate",$!{fexProductPage.fexOptionRate})
							</td>
						</tr>
						##退款支付时间 0-到期日、1-敲出日
						#if($!{fexProductPage.fexOption2} == '2' &&($!{fexProductPage.fexOption3} =='2' || $!{fexProductPage.fexOption3} =='3'))
							<tr>
								<td class="textRight">#springMessage('table.fexProduct.refundTime')</td>
								<td>
									$dictTag.get("fexProduct.refundTime",$!{fexProductPage.refundTime})
								</td>
							</tr>
						#end
                        #if($!{fexProductPage.fexOption2} == "1")
						##加权天数规则 0-按日历（不区分是否工作日）、1-仅工作日
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.daysRule')</td>
							<td>
								$dictTag.get("fexProduct.daysRule",$!{fexProductPage.daysRule})
							</td>
						</tr>
                        #end
                        #if($!{fexProductPage.fexOption2} == "2" || $!{fexProductPage.fexOption2} == "3")
						##交易时障碍验证标准 0-即期汇率、1-即期汇率对应的货币价值
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.validStandard')</td>
							<td>
								$dictTag.get("fexProduct.validStandard",$!{fexProductPage.validStandard})
							</td>
						</tr>
                        #end
##						##交易结算方式 0-现金、0-即期交易
##						<tr>
##							<td class="textRight">#springMessage('table.fexProduct.tranSettleMethod')</td>
##							<td>
##								$dictTag.get("fexProduct.tranSettleMethod",$!{fexProductPage.tranSettleMethod})
##							</td>
##						</tr>
						##交割类型 1-本金交割、2-无本金交割
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
							<td>
								$dictTag.get("fexProduct.deliveryType",$!{fexProductPage.deliveryType})
							</td>
						</tr>
						##在交易时展示经纪人 0-否、1-是
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.isShowAgent')</td>
							<td>
								$dictTag.get("sf_yn",$!{fexProductPage.isShowAgent})
							</td>
						</tr>
						##在交易时展示清算所 0-否、1-是
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.isShowClearHouse')</td>
							<td>
								$dictTag.get("sf_yn",$!{fexProductPage.isShowClearHouse})
							</td>
						</tr>
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.buyCurIdOption')</td>
							<td>$!{fexProductPage.buyEnglishCode}</td>
						</tr>
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.sellCurIdOption')</td>
							<td>$!{fexProductPage.sellEnglishCode}</td>
						</tr>
					#elseif($!{fexProductPage.tranType} == "3")
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.isAllowedSettle')</td>
							<td>$dictTag.get("sf_yn",$!{fexProductPage.isAllowedSettle})</td>
						</tr>
					#elseif($!{fexProductPage.tranType} == "4")
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.nonWorkdayRule')</td>
							<td>
								<input id="nonWorkdayRule" name="nonWorkdayRule" type="hidden" value="$!{fexProductPage.nonWorkdayRule}">
								<label id="nonWorkdayRuleText" ></label>
							</td>
						</tr>
					#else
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.trangroupRuleId')</td>
							<td>$!{fexProductPage.trangroupRuleName}</td>
						</tr>
						<tr>
							<td class="textRight">#springMessage('table.fexProduct.isAllowedChange')</td>
							<td>$dictTag.get("sf_yn",$!{fexProductPage.isAllowedChange})</td>
						</tr>
					#end
				#end

				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.validSign')</td>
					<td>$dictTag.get("valid_sign",$!{fexProductPage.validSign})</td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
					<td>$!{fexProductPage.rmk}</td>
				</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
	<script>
		bt.use(['form','layedit','fexProductView'],function () {
			if($("#nonWorkdayRule").val()) {
				//非工作日适用原则组装
				var nonWorkdayRules = $("#nonWorkdayRule").val().split(",");
				var nonWorkdayRule;
				$.each(nonWorkdayRules, function (i, rule) {
					if (null == nonWorkdayRule) {
						nonWorkdayRule = bt.dict("fexProduct.nonWorkdayRule", rule);
					} else {
						nonWorkdayRule += "," + bt.dict("fexProduct.nonWorkdayRule", rule);
					}
				});
				$("#nonWorkdayRuleText").html(nonWorkdayRule);
			}

			var fexProductView = bt.fexProductView.init();
			bt.fexProductViewParams = function () {
				fexProductView.set({"id": $("#billId").val()});
				return true;
			}
		})
	</script>
</body>
</html>
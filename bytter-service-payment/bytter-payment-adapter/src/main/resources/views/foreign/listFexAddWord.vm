<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight" width="20%">#springMessage('table.fexTranInfo.tranCode')</td>
					<td width="30%">
                        <input type="text" name="likes_tranCode"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranInfo.tranCode')">
                    </td>
					<td class="textRight" width="20%">#springMessage('bill.accebill.name')</td>
					<td width="30%">
                        <input type="text" name="likes_tranName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.name')">
                    </td>
                </tr>
                <tr>
                    <td class="textRight" width="20%">#springMessage('table.foreign.cdSign')</td>
                    <td width="30%">
                        <div class="bt-biz-dict" data-type="select"
                             data-group="fexAddWord.cdSign" data-name="eqi_cdSign"></div>
                    </td>
                    <td class="textRight" width="20%">#springMessage('table.fexForeignReq.tranAddWord')</td>
                    <td width="30%">
                        <input type="text" name="likes_addWord"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.tranAddWord')">
                    </td>
                </tr>
    			<tr >
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.fexTranInfo.tranCode')</th>
            <th>#springMessage('bill.accebill.name')</th>
            <th>#springMessage('table.foreign.cdSign')</th>
            <th>#springMessage('table.fexForeignReq.tranAddWord')</th>
            <th>#springMessage('fcVoucherType.validSign')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexAddWord.list.js?_btv=${resourceVersion}"></script>
</html>
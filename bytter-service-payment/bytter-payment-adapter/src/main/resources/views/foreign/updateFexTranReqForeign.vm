<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
	<ul class="layui-tab-title">
		<li class="layui-this">#springMessage('table.rasBackQuery.msg')</li>
		<li>#springMessage('table.fexTranReq.cashFlow')</li>
		<li>#springMessage('fex.cotp.customInformation')</li>
	</ul>
	<div class="layui-tab-content">
		<div class="layui-tab-item layui-show">
			<input id="createBy" name="createBy" type="hidden" value="$!{fexTranReqPage.createBy}">
			<input id="createDate" name="createDate" type="hidden" value="$!{fexTranReqPage.createDate}">
			<input id="updateBy" name="updateBy" type="hidden" value="$!{fexTranReqPage.updateBy}">
			<input id="updateDate" name="updateDate" type="hidden" value="$!{fexTranReqPage.updateDate}">
			<input id="id" name="id" type="hidden" value="$!{fexTranReqPage.id}">
			<input id="tranType" name="tranType" type="hidden" value="$!{fexTranReqPage.tranType}">
			<input id="status" name="status" type="hidden" value="0">
			<input id="billNo" name="billNo" type="hidden" value="$!{fexTranReqPage.billNo}">
			<input id="tranAppDtlId" name="tranAppDtlId" type="hidden" value="$!{fexTranReqPage.tranAppDtlId}">
            <input id="tranAppDtlNo" name="tranAppDtlNo" type="hidden" value="$!{fexTranReqPage.tranAppDtlNo}">
            <!--固定金额 1-买入金额 2-卖出金额-->
            <input id="fixedMoneyApp" type="hidden" value="$!{fexTranReqPage.fixedMoney}">
			<!-- 系统参数 -->
			<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
			<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
			<!-- 资金计划参数 明细项控制模式-->
			<input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
			<input id="settlType" name="settlType" type="hidden" value="0">
			<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
			<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
            <!--买入方账户信息-->
			<!-- 主体单位账户信息 -->
			<input type="hidden" id="corpBank" name="corpBank" value="$!{fexTranReqPage.corpBank}">
			<input type="hidden" id="corpAccId" name="corpAccId" value="$!{fexTranReqPage.corpAccId}">
			#*<input type="hidden" id="corpBankAcc" name="corpBankAcc" value="$!{fexTranReqPage.corpBankAcc}">*#
			<input type="hidden" id="corpAccName" name="corpAccName" value="$!{fexTranReqPage.corpAccName}">
			<input type="hidden" id="corpIsDomesticBank" name="corpIsDomesticBank" value="$!{payerAcc.isDomesticBank}">
			<input type="hidden" id="corpCountryId" name="corpCountryId" value="$!{payerAcc.prov}">
			<input type="hidden" id="corpBifCode" name="corpBifCode" value="$!{payerAcc.bifCode}">
			<!-- 交易对手账户信息 -->
			<input type="hidden" id="cotpBank" name="cotpBank" value="$!{fexTranReqPage.cotpBank}">
			<input type="hidden" id="cotpAccId" name="cotpAccId" value="$!{fexTranReqPage.cotpAccId}">
			<input type="hidden" id="cotpBankAcc" name="cotpBankAcc" value="$!{fexTranReqPage.cotpBankAcc}">
			<input type="hidden" id="cotpAccName" name="cotpAccName" value="$!{fexTranReqPage.cotpAccName}">
            <!--卖出方账户信息-->
            <input type="hidden" id="srcBank" name="srcBank" value="$!{fexTranReqPage.srcBank}">
            <input type="hidden" id="srcAccId" name="srcAccId" value="$!{fexTranReqPage.srcAccId}">
            #*<input type="hidden" id="srcBankAcc" name="srcBankAcc" value="$!{fexTranReqPage.srcBankAcc}">*#
            <input type="hidden" id="srcAccName" name="srcAccName" value="$!{fexTranReqPage.srcAccName}">
            <input type="hidden" id="targetBank" name="targetBank" value="$!{fexTranReqPage.targetBank}">
            <input type="hidden" id="targetAccId" name="targetAccId" value="$!{fexTranReqPage.targetAccId}">
            <input type="hidden" id="targetBankAcc" name="targetBankAcc" value="$!{fexTranReqPage.targetBankAcc}">
            <input type="hidden" id="targetAccName" name="targetAccName" value="$!{fexTranReqPage.targetAccName}">
			<input id="cloneFlag" name="cloneFlag" type="hidden" value="$!{fexTranReqPage.cloneFlag}">
			#if($!{fexTranReqPage.cloneFlag} != "1")
			<table class="layui-table">
				<tbody>
				<tr>
					##交易号码
					<td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
					<td width="30%">$!{fexTranReqPage.billNo}</td>
					##交易需求编号
					<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAppDtlNo')</td>
					<td width="30%">$!{fexTranReqPage.tranAppDtlNo}</td>
				</tr>
				</tbody>
			</table>
			#end
			<div class="layui-collapse">
				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranMainInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##单位
								<td class="textRight" width="20%">#springMessage('table.nisBillhead.corpId')</td>
								<td width="30%">
									<input type="hidden" id="corpIdDef" value="$!{fexTranReqPage.corpId}">
									#if($!{fexTranReqPage.tranAppDtlId})
										$!{fexTranReqPage.corpName}
									<div class="layui-input-inline ignore-required-icon" style="display: none">
									#else
									<div class="layui-input-inline">
									#end
									<div class="bt-biz-corp"
										 data-biz-type="corp"
										 data-type="selectTree"
										 data-name="corpId"
										 data-biz-name="corpId"
										 data-scope="all"
										 data-resource="foreign:fextranreq:foreign:apply"
										 data-required="true"
										 data-callback="bt.corpCallback"
										 data-defaultvalue="$!{fexTranReqPage.corpId}">
									</div>
								</td>
								##是否掉期交易
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.isSwapTran')</td>
								<td width="30%">
									$dictTag.get("sf_yn",$!{fexTranReqPage.isSwapTran})
									<input id="isSwapTran" name="isSwapTran" type="hidden" value="$!{fexTranReqPage.isSwapTran}">
								</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>
				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranProductInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##产品
								<td class="textRight" width="20%">#springMessage('table.foreign.product')</td>
								<td width="30%">
									<input type="hidden" id="proIdDef" value="$!{fexTranReqPage.proId}">
									#if($!{fexTranReqPage.tranAppDtlId})
										$!{fexTranReqPage.proName}
									<div class="layui-input-inline ignore-required-icon" style="display: none">
									#else
									<div class="layui-input-inline">
									#end
									<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProduct/$!{fexTranReqPage.tranType}" data-name ="proId" data-biz-name ="proId"
										 data-valueField="id" data-textField="proName" data-required = "true" data-callback="bt.proCallback" data-value="$!{fexTranReqPage.proId}"></div>
								</div>
								</td>
								##外汇交易类型
								<td class="textRight" width="20%">#springMessage('table.fexProduct.fexTranType')</td>
								<td width="30%">
									<input type="hidden" id="fexTranType" name="fexTranType" value="$!{fexTranReqPage.fexTranType}">
									<div id="fexTranTypeDiv" name="fexTranTypeDiv">$dictTag.get("fexProduct.fexTranType",$!{fexTranReqPage.fexTranType})</div>
								</td>
							</tr>
							<tr>
								##外汇业务类型
								<td class="textRight" width="20%">#springMessage('table.fexProduct.fexBusType')</td>
								<td width="30%">
									<input type="hidden" id="fexBusType" name="fexBusType" value="$!{fexTranReqPage.fexBusType}">
									<div id="fexBusTypeDiv" name="fexBusTypeDiv">$dictTag.get("fexProduct.fexBusType",$!{fexTranReqPage.fexBusType})</div>
								</td>
								##结汇业务类型
								#if($!{fexTranReqPage.fexBusType}=="1")
									<td id="settleBusTypeTdNull" style="display: none" width="20%"></td>
									<td class="textRight" id="settleBusTypeTd" width="20%">#springMessage('fex.tran.settleBusType')</td>
								#else
									<td id="settleBusTypeTdNull" width="20%"></td>
									<td class="textRight" id="settleBusTypeTd" style="display: none" width="20%">#springMessage('fex.tran.settleBusType')</td>
								#end
								<td width="30%">
									#if($!{fexTranReqPage.fexBusType}=="1")
									<div id="settleBusTypeDiv">
									#else
									<div id="settleBusTypeDiv" style="display: none">
									#end
									<div class="bt-biz-dict" data-type="select" data-group="fex.tran.settleBusType" data-defaultvalue="$!{fexTranReqPage.settleBusType}"
										 data-name="settleBusType" data-biz-name="settleBusType"
										#if(${fexTranReqPage.fexBusType}=="1")
										 data-required = "true"
										#end
									></div>
								</div>
								</td>
							</tr>
							<tr>
								##交割类型
								<td class="textRight" width="20%">#springMessage('table.fexProduct.deliveryType')</td>
								<td width="30%">
									<input type="hidden" id="deliveryType" name="deliveryType" value="$!{fexTranReqPage.deliveryType}">
									<div id="deliveryTypeDiv" name="deliveryTypeDiv">$dictTag.get("fexProduct.deliveryType",$!{fexTranReqPage.deliveryType})</div>
								</td>
								##交割币种
								#if($!{fexTranReqPage.deliveryType}=="1")
									<td id="deliveryCurTdNull" style="display: none" width="20%"></td>
									<td class="textRight" id="deliveryCurTd" width="20%">#springMessage('fex.tranApp.deliveryCurId')</td>
								#else
									<td id="deliveryCurTdNull" width="20%"></td>
									<td class="textRight" id="deliveryCurTd" style="display: none" width="20%">#springMessage('fex.tranApp.deliveryCurId')</td>
								#end
								<td width="30%">
									#if($!{fexTranReqPage.deliveryType}=="1")
									<div id="deliveryCurDiv">
									#else
									<div id="deliveryCurDiv" style="display: none">
									#end
									<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="deliveryCurId" data-biz-name ="deliveryCurId"
										 data-valueField="id" data-textField="englishCode" data-value="$!{fexTranReqPage.deliveryCurId}"></div>
								</div>
								</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>
				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##交易对手
								<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.cotpBank')</td>
								<td width="30%">
##									<input type="hidden" id="cotpIdDef" value="$!{fexTranReqPage.cotpId}">
##									<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexCotp/listBankCotp?cotpType=01,02,05,06,13" data-name ="cotpId" data-biz-name ="cotpId"
##										 data-valueField="id" data-textField="cotpName" data-required = "true" data-value="$!{fexTranReqPage.cotpId}" data-callback="bt.cotpCallback"></div>

									<div class="layui-input-inline">
										<input type="hidden" id="oppId" name="oppId" value="$!{fexTranReqPage.oppId}" autocomplete="off" class="layui-input">
										<input type="hidden" id="cotpId" name="cotpId" value="$!{fexTranReqPage.cotpId}" autocomplete="off" class="layui-input">
										<input type="text" id="cotpName" name="cotpName" lay-verify="required" readonly="readonly" value="$!{fexTranReqPage.cotpName}" class="layui-input">
									##交易对手银行
										<div class="bt-div-search">
											<button class="bt-biz-allBankInfo" id="selCoptBankBut" type="button" data-callback="bt.cotpBankCallback" title="#springMessage('common.button.select')">
												<i class="layui-icon">&#xe615;</i>
											</button>
										</div>
									</div>
								</td>
								<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.cotpBank')#springMessage('table.btswiftinfo.swiftCode')</td>
								<td width="30%">
									<div id="cotpBicCodeDiv" name="cotpBicCodeDiv">$!{fexTranReqPage.cotpBicCode}</div>
									<input type="hidden" id="cotpBicCode" name="cotpBicCode" value="$!{fexTranReqPage.cotpBicCode}">
								</td>
							</tr>
							<tr>
								##固定金额
								<td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.FixedAmount')</td>
								<td width="30%">
									<div class="layui-input-inline">
										#if($!{fexTranReqPage.fexTranType}=="1")
											<div class="bt-biz-dict" data-type="radio" data-required="true" data-group="fex.tranApp.fixMoney" id="fixedMoney"
												 data-name="fixedMoney" data-biz-name="fixedMoney" data-defaultvalue="$!{fexTranReqPage.fixedMoney}" data-callback="bt.fixMoneyCallback"></div>
										#else
											<div class="bt-biz-dict" data-type="checkbox" data-required="true" data-group="fex.tranApp.fixMoney" id="fixedMoney"
												 data-name="fixedMoney" data-biz-name="fixedMoney" data-defaultvalue="$!{fexTranReqPage.fixedMoney}" data-callback="bt.fixMoneyCallback"></div>
										#end
									</div>
								</td>
								<td class="textRight" colspan="2" width="20%">#springMessage('fex.tranApp.isAutoCal')</td>
								<td width="30%">
									#*<input type="checkbox" name="autoCal" lay-filter = "autoCal" value="1"
										#if(${fexTranReqPage.autoCal})
										   checked="checked"
										#end
										   title="#springMessage('fex.tranApp.autoCal')" lay-skin="primary">*#
									<div class="bt-biz-dict" data-type="radio" data-required="true" data-group="fex.tranApp.fixMoney"
										 data-name="autoCal" data-biz-name="autoCal" id="autoCal" data-defaultvalue="$!{fexTranReqPage.autoCal}"></div>
								</td>
							</tr>
							<tr>
								##合同汇率
								<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.contractRate')</td>
								<td width="30%">
									<input type="text" data-name="contractRate" data-biz-name="contractRate" data-decimal="6"
										  #if(($!{fexTranReqPage.fexTranType}=="0" && $!{fexTranReqPage.fixedMoney}=="1,2")
										  || $!{fexTranReqPage.fexTranType}!="0")
										   lay-verify="required"
										   #end
										    value="$!{fexTranReqPage.contractRate}" data-callback="bt.contractRateCallback"
										   id="contractRate" autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.contractRate')">
								</td>
								##远期汇率
								<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranDeal.wishRate')</td>
								<td width="30%">
									<input type="text" data-name="spotRate" data-biz-name="spotRate" data-decimal="6" #if($!{fexTranReqPage.fexTranType}=="1")lay-verify="required"
									#end value="$!{fexTranReqPage.spotRate}"
										   id="spotRate" autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranDeal.wishRate')">
								</td>
							</tr>
							<tr>
								##外汇合同号
								<td class="textRight" colspan="2">#springMessage('table.fexForeignReq.foreignContractNo')</td>
								<td>
									<input lay-verify="strlength" type="text" id="foreignContractNo" name="foreignContractNo" data-maxlength="50" value="$!{fexTranReqPage.foreignContractNo}"
										   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.foreignContractNo')">
								</td>
								<td class="textRight" colspan="2"></td>
								<td></td>
							</tr>
							<tr>
								<td rowspan="5" width="5%" align="center">#springMessage('table.fexTranReq.tranBuyInfo')</td>
								##买入币种
								<td class="textRight" width="15%">#springMessage('table.fexTranReq.buyCurId')</td>
								<td width="30%">
									<input type="hidden" id="buyCurIdDef" value="$!{fexTranReqPage.buyCurId}">
									#if($!{fexTranReqPage.tranAppDtlId})
										$!{fexTranReqPage.buyEnglishCode}
									<div class="layui-input-inline ignore-required-icon" style="display: none">
									#else
									<div class="layui-input-inline">
									#end
									<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="buyCurId" data-biz-name ="buyCurId"
										 data-valueField="id" data-textField="englishCode" data-required = "true" data-value="$!{fexTranReqPage.buyCurId}" data-callback="bt.buyCurCallback"></div>
								</div>
								</td>
								<td rowspan="5" width="5%" align="center">#springMessage('table.fexTranReq.tranSellInfo')</td>
								##卖出币种
								<td class="textRight" width="15%">#springMessage('table.fexTranReq.sellCurId')</td>
								<td width="30%">
									<input type="hidden" id="sellCurIdDef" value="$!{fexTranReqPage.sellCurId}">
									#if($!{fexTranReqPage.tranAppDtlId})
										$!{fexTranReqPage.sellEnglishCode}
									<div class="layui-input-inline ignore-required-icon" style="display: none">
									#else
									<div class="layui-input-inline">
									#end
									<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="sellCurId" data-biz-name ="sellCurId"
										 data-valueField="id" data-textField="englishCode" data-required = "true" data-value="$!{fexTranReqPage.sellCurId}" data-callback="bt.sellCurCallback"></div>
								</div>
								</td>
							</tr>
							<tr>
								##买入金额
								<td class="textRight" width="15%">#springMessage('table.fexTranReq.buyMoney')</td>
								<td width="30%">
									<input type="text" id="buyMoney" name="buyMoney" style="text-align:right" lay-verify="required|number2" data-name="buyMoney" data-biz-name="buyMoney" data-callback="bt.buyMoneyCallback"
										   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.buyMoney')" value="$!{fexTranReqPage.buyMoney}">
								</td>
								##卖出金额
								<td class="textRight" width="15%">#springMessage('table.fexTranReq.sellMoney')</td>
								<td width="30%">
									<input type="text" id="sellMoney" name="sellMoney" style="text-align:right" lay-verify="required|number2" data-name="sellMoney" data-biz-name="sellMoney" data-callback="bt.sellMoneyCallback"
										   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.sellMoney')" value="$!{fexTranReqPage.sellMoney}">
								</td>
							</tr>
							<tr>
								##收款账号
								<td class="textRight" width="15%">#springMessage('table.nisBillhead.payeeAcc')</td>
								<td width="30%">
									<input type="text" id="corpBankAcc" name="corpBankAcc" lay-verify="required|tableData" data-biz-name="corpBankAcc" value="$!{fexTranReqPage.corpBankAcc}"
										   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.payeeAcc')" data-swapType="">
									<table id="corpBankAccTable" class="hide">
										<thead>
										<tr>
											<th>#springMessage('table.choBankFinance.acc')</th>
											<th>#springMessage('table.btBankAccApp.accName')</th>
											<th>#springMessage('table.btBankAcc.bankName')</th>
											<th>#springMessage('table.nisBillhead.curId')</th>
										</tr>
										</thead>
									</table>
								</td>
								##付款账号
								<td class="textRight" width="15%">#springMessage('table.nisBillhead.payerAcc')</td>
								<td width="30%">
									<input type="text" id="srcBankAcc" name="srcBankAcc" lay-verify="required|tableData" data-biz-name="srcBankAcc" value="$!{fexTranReqPage.srcBankAcc}"
										   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.payerAcc')" data-swapType="">
									<table id="srcBankAccTable" class="hide">
										<thead>
										<tr>
											<th>#springMessage('table.choBankFinance.acc')</th>
											<th>#springMessage('table.btBankAccApp.accName')</th>
											<th>#springMessage('table.btBankAcc.bankName')</th>
											<th>#springMessage('table.nisBillhead.curId')</th>
										</tr>
										</thead>
									</table>
								</td>
							</tr>
							<tr>
								##收款账户银行
								<td class="textRight" width="15%">#springMessage('table.fexTranReq.payeeAccBank')</td>
								<td width="30%">

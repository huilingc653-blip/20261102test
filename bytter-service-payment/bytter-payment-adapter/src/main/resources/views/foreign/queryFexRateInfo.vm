<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##外汇牌价类型
                    <td class="textRight">#springMessage('table.fexRateInfo.rateType')</td>
                    <td>
                        <div class="layui-inline">
                        <div class="bt-biz-mulselectType" data-url="${basePath}/foreign/fexratetype/listFexRateTypeAll" data-method="get"
                             data-name ="ins_rateTypeId" data-biz-name ="rateTypeId" data-valueField="id" data-textField="typeName"></div>
                        </div></td>
                    ##标准币种
                    <td class="textRight">#springMessage('table.fcExcrateAdjust.cur')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrency/listCur" data-method="post"
                                 data-valuefield="id" data-textfield="curName" data-name="ins_cur" data-biz-name="ins_cur" data-search="true">
                            </div>
                        </div>
                    </td>
                    ##报价币种
                    <td class="textRight">#springMessage('table.fexRateInfo.referCur')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrency/listCur" data-method="post"
                                 data-valuefield="id" data-textfield="curName" data-name="ins_referCur" data-biz-name="ins_referCur" data-search="true">
                            </div>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##发布时间
                    <td class="textRight">#springMessage('bpm.model.releaseTime')</td>
                    <td>
                        <input type="text" name="ged_returnTime" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_returnTime" value="">
                        <span class="date-mid">~</span>
                        <input type="text" name="led_returnTime" class="layui-input bt-input-inline bt-biz-dateType" id="led_returnTime" value="">
                    </td>
                    ##期限
                    <td class="textRight">#springMessage('cho.productDetailed.dayLimit')</td>
                    <td>
                        <input type="text" id="likes_term" name="likes_term" class="layui-input" placeholder="#springMessage('cho.productDetailed.dayLimit')"/>

                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.fexRateInfo.rateType')</th>
                <th>#springMessage('table.fcExcrateAdjust.cur')</th>
                <th>#springMessage('table.fexRateInfo.referCur')</th>
                #if($!{rateInterfaceType} == "1")
                    <th>#springMessage('table.bisGatherCmd.returnTime')</th>
                #else
                    <th>#springMessage('bpm.model.releaseTime')</th>
                #end
                <th>#springMessage('cho.productDetailed.dayLimit')</th>
                <th>#springMessage('table.report.execRateDate')</th>
                <th>#springMessage('table.fcExcrateAdjust.foreignExchangePurchase')</th>
                <th>#springMessage('table.fcExcrateAdjust.foreignExchangeSell')</th>
                <th>#springMessage('table.fcExcrateAdjust.foreignExchangeMiddle')</th>
                <th>#springMessage('table.fexRateInfo.curUnit')</th>
                <th>#springMessage('btPayType.rmk')</th>
            </tr>
        </thead>
    </table>
    <div class="layui-input-inline" style="color: red">
        #springMessage('table.fexRateInfo.desc')
    </div>
#parse("views/common/footer.vm")
</body>
</html>
<script>
    var datatable;
    var moneyType;
    var moneyFun;
    bt.use(['form', 'datatable', 'select', 'dateType', 'corp', 'money', 'moneyType', 'dicts', 'btImport', 'bank', 'selectType','element', 'selectTable','mulselect'], function () {
        $ = bt.jquery, form = bt.form();
        bt.corp.init();
        moneyType = bt.moneyType.init();
        moneyFun = bt.moneyType.getFun();
        bt.mulselect.init();
        bt.dateType.init();
        bt.selectType.init();
        bt.dicts.init();

        // //外汇牌价类型回调函数
        // bt.rateTypeIdCallback = function (data) {
        //     $('#curName').val("");
        //     $('#cur').val("");
        //     //是否需要按标准币种查询
        //     if(data.rateinterfacetype == "1" && data.isneedquerycur == "1"){
        //         $('#curName').attr('lay-verify', 'required|tableData');
        //         $("#curTr").show();
        //     }else{
        //         $('#curName').attr('lay-verify', 'tableData');
        //         $("#curTr").hide();
        //     }
        //     form.renderIcon();
        // };
        // debugger;
        var sysCurTable=bt.selectTable.init({
            elem: "#sysCurTable",
            url: basePath + "/basic/business/btcurrency/listSysCur",
            searchInput: "#curName",
            scrollX: "500px",
            scrollY: "200px",
            columns: [
                {data: "englishCode",},
                {data: "curName",},
            ],
            clickCallback: function (data, $tr) {
                if(data) {
                    $("#cur").val(data.id);
                    $("#curName").val(data.curName);
                }else {
                    $("#cur").val("");
                    $("#curName").val("");
                }
            },
        });

        var referCurTable=bt.selectTable.init({
             elem: "#referCurTable",
             url: basePath + "/basic/business/btcurrency/listSysCur",
             searchInput: "#referCurName",
             scrollX: "500px",
             scrollY: "200px",
             columns: [
                 {data: "englishCode",},
                 {data: "curName",},
             ],
             clickCallback: function (data, $tr) {
                 if(data) {
                     $("#referCur").val(data.id);
                     $("#referCurName").val(data.curName);
                 } else {
                     $("#referCur").val("");
                     $("#referCurName").val("");
                 }
             },
         });

        importExcel = function () {
            up = bt.btImport.init({
                code: "1000000013",
                titleRows: 0,
                width: "100%",
                height: "100%",
                headRows: 1,
                success: function (head, data, select) { //点击确认后回调方法，这里导入组件写了success方法这里可以不用此方法
                    $.ajax({
                        type: "POST",
                        url: basePath + "/foreign/fexrateinfo/saveImport",
                        dataType: "json",
                        contentType: "application/json",
                        data: JSON.stringify(up.getSelectData()),
                        success: function (result) {
                            bt.datatable.refreshCurrentPage();
                            parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                        }
                    });
                }
            });
        }

        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            checkbox: false,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath + "/foreign/fexrateinfo/datatable"
            },
            buttons: [
                {
                    text: bt.lang('common.button.imports'),
                    action: function (e, dt, node, config) {
                        importExcel();
                    }
                },{
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            fixedColumns: {
                rightColumns: 1//代表冻结右边一列
            },
            columns: [
                {data: "rateTypeName", bSortable: true, className: 'center'},
                {data: "curName", bSortable: true, className: 'center',},
                {data: "referCurName", bSortable: true, className: 'center',},
                {data: "effectDate", bSortable: true, className: 'center',},
                {data: "term", bSortable: true, className: 'center'},
                {data: "exchangeRateDate", bSortable: true, className: 'center'},
                {
                    data: "purchaseRate", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        if(!full.purchaseRate){
                            return "";
                        }
                        var opt = {
                            separator: ",",
                            decimal: 6
                        }
                        return moneyFun.format(full.purchaseRate, opt);
                    }
                },
                {
                    data: "sellRate", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        if(!full.sellRate){
                            return "";
                        }
                        var opt = {
                            separator: ",",
                            decimal: 6
                        }
                        return moneyFun.format(full.sellRate, opt);
                    }
                },
                {
                    data: "middleRate", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        if(!full.middleRate){
                            return "";
                        }
                        var opt = {
                            separator: ",",
                            decimal: 6
                        }
                        return moneyFun.format(full.middleRate, opt);
                    }
                },
                {
                    data: "curUnit", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        if(!full.curUnit){
                            return "";
                        }
                        var opt = {
                            separator: ",",
                            decimal: 6
                        }
                        return moneyFun.format(full.curUnit, opt);
                    }
                },
                {data: "rmk", bSortable: true, className: 'center',}
            ],
        });

        //监听提交
        form.on('submit(submit)', function(data){
            var action = "/foreign/fexrateinfo/save";
            $.post(basePath + action, data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}, function () {
                    parent.layer.closeAll();
                    if (result.success) {
                        if (bt.navtab) {
                            datatable && datatable.draw();
                        } else {
                            parent.layer ? parent.layer.closeAll() : layer.closeAll();
                        }
                    }
                })
            }, 'JSON');
            return false;
        });
    });

</script>

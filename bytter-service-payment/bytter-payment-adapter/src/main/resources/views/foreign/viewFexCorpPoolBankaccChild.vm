<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    ##成员账号的父id是主账号id
    <input id="parentId" name="parentId" type="hidden" value="$!{fexCorpPoolPage.id}">
    <input id="poolId" name="poolId" type="hidden" value="$!{fexCorpPoolPage.poolId}">
    <input id="corpId" name="corpId" type="hidden" value="$!{fexCorpPoolPage.corpId}">
    <input id="curId" name="curId" type="hidden" value="$!{fexCorpPoolPage.curId}">
    <input id="accId" name="accId" type="hidden" value="$!{fexCorpPoolPage.accId}">
    <input id="corpName" name="corpName" type="hidden" value="$!{fexCorpPoolPage.corpName}">
    <input id="englishCode" name="englishCode" type="hidden" value="$!{fexCorpPoolPage.englishCode}">
    <table class="layui-table">
        <tbody>
        <tr>
            ##资金池主体单位
            <td class="textRight" width="30%">#springMessage('nis.pool.fcCorpPool.pool')</td>
            <td>
                $!{fexCorpPoolPage.poolName}
            </td>
        </tr>
        <tr>
            ##资金池性质
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.poolNature')</td>
            <td>
                $dictTag.get("fexCorpPool.poolNature",$!{fexCorpPoolPage.poolNature})
            </td>
        </tr>
        <tr>
            ##资金池主账号
            <td class="textRight" width="30%">
                #springMessage('nis.pool.fcCorpPool.pool')#springMessage('table.fexCorpPool.mainAccount')
            </td>
            <td>
                $!{fexCorpPoolPage.bankAcc}
            </td>
        </tr>
        <tr>
            ##资金池主账号银行
            <td class="textRight" width="30%">
                #springMessage('nis.pool.fcCorpPool.pool')#springMessage('table.fexCorpPool.mainAccount')#springMessage('common.button.bank')
            </td>
            <td>
                $!{fexCorpPoolPage.bankName}
            </td>
        </tr>
        <tr>
            ##资金池主账号币种
            <td class="textRight" width="30%">
                #springMessage('nis.pool.fcCorpPool.pool')#springMessage('table.fexCorpPool.mainAccount')#springMessage('contract.currency')
            </td>
            <td>
                $!{fexCorpPoolPage.englishCode}
            </td>
        </tr>
        </tbody>
    </table>
    <table id="dataTable" class="layui-table" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.fexCorpPool.memberAccount')</th>##成员账号
            <th>#springMessage('table.nisBillhead.corpId')</th>##单位
            <th>#springMessage('contract.currency')</th>##币种
            <th>#springMessage('table.fexCorpPool.accNature')</th>##账户资金性质
        </tr>
        </thead>
        <tbody>
        <tr>
            <td align="center">
                $!{fexCorpPoolBankAccPage.bankAcc}
            </td>
            <td align="center">
                $!{fexCorpPoolBankAccPage.corpName}
            </td>
            <td align="center">
                $!{fexCorpPoolBankAccPage.englishCode}
            </td>
            <td align="center">
                $dictTag.get("fexCorpPoolBank.accNature",$!{fexCorpPoolBankAccPage.accNature})
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form', 'layedit', 'moneyType', 'printType','selectType'], function () {
        var $ = bt.jquery, form = bt.form();
        var moneyType = bt.moneyType.init();
        var moneyFun = bt.moneyType.getFun();
        bt.printType.init();
        bt.selectType.init();
    });
</script>
</html>

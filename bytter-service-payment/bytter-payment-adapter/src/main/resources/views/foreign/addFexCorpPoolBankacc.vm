<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="poolId" name="poolId" type="hidden" value="$!{fexCorpPoolPage.poolId}">
    <input id="corpId" name="corpId" type="hidden" value="$!{fexCorpPoolPage.corpId}">
    <input id="curId" name="curId" type="hidden" value="$!{fexCorpPoolPage.curId}">
##主账号的父id是资金池主体id
    <input id="parentId" name="parentId" type="hidden" value="$!{fexCorpPoolPage.id}">
    <input id="parentSign" name="parentSign" type="hidden" value="$!{fexCorpPoolPage.parentSign}">
    <input id="accId" name="accId" type="hidden" value="$!{fexCorpPoolPage.accId}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="30%">
            ##资金池主体单位
                #springMessage('nis.pool.fcCorpPool.pool')
            </td>
            <td>
                $!{fexCorpPoolPage.poolName}
            </td>
        </tr>
        ##资金池主体单位名称
        <tr>
            <td class="textRight" width="30%">
                #springMessage('table.fcCorpPool.corpName')
            </td>
            <td>
                $!{fexCorpPoolPage.corpName}
            </td>
        </tr>
        <tr>
        ##币种
            <td class="textRight" width="30%">
                #springMessage('table.fexCorpPool.curId')
            </td>
            <td>
                $!{fexCorpPoolPage.englishCode}
            </td>
        </tr>
        ##银行账号
        <tr>
            <td class="textRight" width="30%">#springMessage('table.bisAccBal.bankAcc')</td>
            <td style="min-width: 200px;">
                <div class="layui-input-inline">
                    <input type="text" id="bankAcc" name="bankAcc" data-biz-name="bankAcc"
                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.accountDTO.bankAcc')" lay-verify="required">
                    <table id="bankAccTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.accountDTO.bankAcc')</th>
                            <th>#springMessage('table.accountDTO.accName')</th>
                            <th>#springMessage('table.accountDTO.bankName')</th>
                            <th>#springMessage('table.accountDTO.curName')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
        </tr>
        ##银行
        <tr>
            <td class="textRight" width="30%">
                #springMessage('common.button.bank')
            </td>
            <td>
                <div id="bankName"></div>
            </td>
        </tr>
        ##账户名称
        <tr>
            <td class="textRight" width="30%">
                #springMessage('table.btBankAccApp.accName')
            </td>
            <td>
                <div id="accName"></div>
            </td>
        </tr>
        ##账户资金性质
        <tr>
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.accNature')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-biz-name="accNature" data-required="true"
                     data-group="fexCorpPoolBank.accNature" data-name="accNature" data-defaultvalue="1"></div>
            </td>
        </tr>
        ##限额设置
        <tr>
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.limit')</td>
            <td>
                <div class="bt-biz-dict" data-type="checkbox" data-group="fexCorpPoolLimit.limitType"
                     data-name="limitTypes" data-biz-name="limitTypes"
                     id="limitTypes" data-callback="typeCallBack" data-required="true"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.limitMoney')</td>
            <td>
                <div class="layui-input-inline" style="width:100%">
                    <input type="text" id="limitMoney1" data-name="limitMoney1" style="display: inline-block;"
                           autocomplete="off" data-biz-name="limitMoney1" class="layui-input bt-biz-moneyType"
                           placeholder="#springMessage('table.fexCorpPool.externalDebtBalance')" readonly="readonly">
                    <input type="text" id="limitMoney2" data-name="limitMoney2" style="display: inline-block;"
                           autocomplete="off" data-biz-name="limitMoney2" class="layui-input bt-biz-moneyType"
                           placeholder="#springMessage('table.fexCorpPool.externalLoan')" readonly="readonly">
                    <input type="text" id="limitMoney3" data-name="limitMoney3" style="display: inline-block;"
                           autocomplete="off" data-biz-name="limitMoney3" class="layui-input bt-biz-moneyType"
                           placeholder="#springMessage('table.fexCorpPool.NetInflow')" readonly="readonly">
                </div>
            </td>
        </tr>
        ##备注
        <tr>
            <td class="textRight" width="30%">#springMessage('table.fcCorpPool.rmk')</td>
            <td>
                <textarea type="text" id="rmk" name="rmk" class="layui-textarea" maxlength="40"
                          placeholder="#springMessage('table.fcCorpPool.rmk')"></textarea>
            </td>
        </tr>

        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexCorpPoolBankacc.add.js?_btv=${resourceVersion}"></script>
</html>

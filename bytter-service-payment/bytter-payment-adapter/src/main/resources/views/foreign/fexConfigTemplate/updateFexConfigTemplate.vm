<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="templateId" name="templateId" value="$!{details.id}">
    <fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('table.cff.baseInfo')</legend>
    </fieldset>
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="15%">#springMessage('table.configTemplate.templateCode')</td>
            <td width="35%">
                <input type="text" id="templateCode" name="templateCode" lay-verify="required|checkCode|strlength"
                       data-maxlength="30" maxlength="30"  autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.configTemplate.templateCode')" value="$!{details.templateNo}">
            </td>
            <td class="textRight" width="15%">#springMessage('table.fexExposureTemplate.templateName')</td>
            <td width="35%">
                <input type="text" id="templateName" name="templateName" lay-verify="required|checkCode|strlength"
                       data-maxlength="30"  maxlength="30"  autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.fexExposureTemplate.templateName')"
                       value="$!{details.templateName}">
            </td>
        </tr>
        <tr>
            <td class="textRight" width="15%">#springMessage('table.fexExposureTemplate.templateDesc')</td>
            <td width="35%">
                <input type="text" id="templateDesc" name="templateDesc" data-maxlength="500" autocomplete="off"
                       class="layui-input"
                       placeholder="#springMessage('table.fexExposureTemplate.templateDesc')"
                       value="$!{details.templateDesc}">
            </td>
            <td class="textRight">#springMessage('table.bvVoucherType.validSign')</td>
            <td>
                <div class="bt-biz-dict" data-group="sf_yn" data-name="bvValidSign" data-type="radio"
                     data-required="true" data-defaultvalue="$!{details.validSign}"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.bvVoucherType.rmk')</td>
            <td>
                <input type="text" id="rmk" name="rmk" autocomplete="off" class="layui-input" lay-verify="strlength"
                       data-maxlength="100" placeholder="#springMessage('table.bvVoucherType.rmk')"
                       value="$!{details.remark}">
            </td>
        </tr>
        </tbody>
    </table>
    <div>
        <fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
            <legend>#springMessage('table.fexProfitLossManage.details')</legend>
        </fieldset>
        <table id="fieldDataTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                    'table.btswiftinfo.bankType')</th>
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                    'table.btBankAcc.bifCode')</th>
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                    'table.btswiftinfo.countryCode')</th>
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                    'table.fexForeign.payType')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
            <tbody class="ignore-required-icon layui-form">
                #foreach($data in $details.children)
                    #set($rowMR=$math.sub($velocityCount,1))
                <tr>
                    <td>
                        <input type="hidden" name="id" data-biz-name="id$!{rowMR}" autocomplete="off"
                               class="layui-input" value="$!{data.id}"/>
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json"
                             data-biz-name="bankTypeId$!{rowMR}" data-name="bankTypeId" data-valuefield="id"
                             data-textfield="typeName" data-callback="bankTypeIdCallBack"
                             data-defaultvalue="$!{data.bankTypeId}"></div>
                    </td>
                    <td>
                        <div class="bt-biz-selectType"
                             data-url="${basePath}/basic/business/bisbifinit/getByBankType/$!{data.bankTypeId}"
                             data-biz-name="bifId$!{rowMR}" data-name="bifId" data-valueField="id"
                             data-textField="bifCode" data-callback="bifIdCallBack"
                             data-defaultvalue="$!{data.bifId}"></div>
                    </td>
                    <td>
                        <div class="bt-biz-selectType"
                             data-url="${basePath}/basic/business/syscountrycust/listSysCountryCust"
                             data-biz-name="countryId$!{rowMR}" data-name="countryId" data-valuefield="id"
                             data-textfield="nameZh" data-callback="countryIdCallBack"
                             data-defaultvalue="$!{data.countryId}"></div>
                    </td>
                    <td>
                        <div class="bt-biz-selectType"
                             data-url="${basePath}/basic/business/btbanktype/listByBankTypeAndBifCodeAndCountryId?bankType=$!{data.bankTypeId}&bifCode=$!{data.bifId}&countryId=$!{data.countryId}"
                             data-biz-name="payTypeId$!{rowMR}" data-name="payTypeId" data-valueField="id"
                             data-textField="bankPayTypeDisplay" data-defaultvalue="$!{data.payTypeId}"></div>
                    </td>
                    <td>
                        #if($!{rowMR}>0)
                            <a href="#" data-type="del" class="">#springMessage(
                                'common.button.delete')</a>
                            <span class="text-explode">|</span>
                        #end
                        <a href="#"  class="cloneData">#springMessage(
                            'common.button.clone')</a>
                    </td>
                </tr>
                #end
            </tbody>
        </table>
    </div>
    <br>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary" id="reset">#springMessage(
                'common.button.reset')</button>
        </div>
    </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexConfigTemplate/updateFexConfigTemplate.js?_btv=${resourceVersion}"></script>
</html>
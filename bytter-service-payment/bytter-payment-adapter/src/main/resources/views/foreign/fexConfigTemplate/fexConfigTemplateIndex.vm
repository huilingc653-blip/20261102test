<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #treeEmpty {
            text-align: center;
            padding-top: 20px;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="customPrintVal">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>

                        ##模板编号
                        <td class="textRight">#springMessage('table.configTemplate.templateCode')</td>
                        <td>
                            <input type="text" name="templateNo" id="templateNo"
                                   autocomplete="off" class="layui-input bank"
                                   placeholder="#springMessage('table.configTemplate.templateCode')">
                        </td>

                        ##模板名称
                        <td class="textRight">#springMessage('table.transfer.templateName')</td>
                        <td>
                            <input type="text" name="templateName" id="templateName"
                                   autocomplete="off" class="layui-input bank"
                                   placeholder="#springMessage('table.transfer.templateName')">
                        </td>

                        ##银行类型
                        <td class="textRight">#springMessage('table.btswiftinfo.bankType')</td>
                        <td>
                            <div class="layui-inline">
                                <div data-name="bankTypeId" class="bt-biz-mulselectType"
                                     data-url="${basePath}/basic/business/btbanktype/json" data-method="get"
                                     data-valuefield="id"
                                     data-textfield="typeName"
                                     data-biz-name="bankTypeId"
                                     data-search="true"
                                     data-callback="bankTypeIdCallBack"
                                ></div>
                            </div>
                        </td>

                    </tr>
                    <tr>
                        ##接口代码
                        <td class="textRight">#springMessage('table.btBankAcc.bifCode')</td>
                        <td>
                            <div class="layui-inline">
                                <div id="bifId" data-name="bifId" class="bt-biz-mulselectType"
                                     data-url="${basePath}/basic/business/bisbifinit/getByBankType/0" data-method="get"
                                     data-valuefield="id"
                                     data-textfield="displayName"
                                     data-biz-name="bifId"
                                ></div>
                            </div>
                        </td>
                        ##国家地区
                        <td class="textRight">#springMessage('table.btswiftinfo.countryCode')</td>
                        <td>
                            <div class="layui-inline">
                                <div id="countryId" data-name="countryId" class="bt-biz-mulselectType"
                                     data-url="${basePath}/basic/business/syscountrycust/listSysCountryCust"
                                     data-method="get"
                                     data-valuefield="id"
                                     data-textfield="nameZh"
                                     data-biz-name="countryId"
                                ></div>
                            </div>
                        </td>


                        ##支付类型
                        <td class="textRight">#springMessage('table.fexForeign.payType')</td>
                        <td>
                            <input type="text" name="payTypeName" id="payTypeName"
                                   autocomplete="off" class="layui-input bank"
                                   placeholder="#springMessage('table.fexForeign.payType')">
                        </td>

                    </tr>
                    <tr>
                        ##有效标记
                        <td class="textRight">#springMessage('tp.ds.validSign')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="select" data-group="valid_sign" data-name="validSign"  data-biz-name="validSign" ></div>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: center;" colspan="6">
                            <button class="layui-btn" id="search" type="button">#springMessage(
                                'common.button.search')</button>
                            <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                                'common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
<div class="dt-buttons" style="display: block;padding: 10px 0px;">
    <button class="layui-btn" type="button" onclick="add()">#springMessage('common.button.add')</button>
    <button class="layui-btn" type="button" onclick="expandAll()">#springMessage('common.openorclose.all')</button>
    <button class="layui-btn" type="button" onclick="batchChooseCustFields()">#springMessage('table.fexForeign.addCustFields')</button>
   #* <button class="layui-btn" type="button" onclick="collapseAll()">#springMessage('common.close.all')</button>*#
</div>
<div style="width: 100%;margin-bottom: 10px;height: 500px;" id="treeTableBox">
    <div id="appTable"></div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexConfigTemplate/fexConfigTemplate.index.js?_btv=${resourceVersion}"></script>
</html>

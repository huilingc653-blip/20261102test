<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="id" name="id" value="$!{id}">
    <fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('table.cff.baseInfo')</legend>
    </fieldset>
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="15%">#springMessage('table.configTemplate.templateCode')</td>
            <td width="35%">
                <input type="text" id="templateCode" name="templateCode" lay-verify="required|checkCode|strlength"
                       data-maxlength="30" maxlength="30" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.configTemplate.templateCode')">
            </td>
            <td class="textRight" width="15%">#springMessage('table.fexExposureTemplate.templateName')</td>
            <td width="35%">
                <input type="text" id="templateName" name="templateName" lay-verify="required|strlength"
                       data-maxlength="30" maxlength="30" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.fexExposureTemplate.templateName')">
            </td>
        </tr>
        <tr>
            <td class="textRight" width="15%">#springMessage('table.fexExposureTemplate.templateDesc')</td>
            <td width="35%">
                <input type="text" id="templateDesc" name="templateDesc" data-maxlength="500"  lay-verify="required|strlength" autocomplete="off" maxlength="500"
                       class="layui-input"
                       placeholder="#springMessage('table.fexExposureTemplate.templateDesc')">
            </td>
            <td class="textRight">#springMessage('table.bvVoucherType.validSign')</td>
            <td>
                <div class="bt-biz-dict" data-group="sf_yn" data-name="bvValidSign" data-type="radio"
                     data-required="true" data-defaultvalue="1"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.bvVoucherType.rmk')</td>
            <td>
                <input type="text" id="rmk" name="rmk" autocomplete="off" class="layui-input" lay-verify="strlength"
                       data-maxlength="100" maxlength="100" placeholder="#springMessage('table.bvVoucherType.rmk')">
            </td>
        </tr>
        </tbody>
    </table>
    <div>
        <fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
            <legend>#springMessage('table.fexProfitLossManage.details')</legend>
        </fieldset>
        <table id="fieldDataTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                    'table.btswiftinfo.bankType')</th>
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                    'table.btBankAcc.bifCode')</th>
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                    'table.btswiftinfo.countryCode')</th>
                <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                    'table.fexForeign.payType')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
        </table>
    </div>
    <br>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary" id="reset">#springMessage(
                'common.button.reset')</button>
        </div>
    </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexConfigTemplate/addFexConfigTemplate.js?_btv=${resourceVersion}"></script>
</html>
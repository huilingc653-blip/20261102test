<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        /* 解决表格内容过长撑开排版的问题 */
        .layui-table td {
            word-break: break-word;      /* 单词内断行 */
            white-space: normal;         /* 允许换行 */
            word-wrap: break-word;       /* 长单词换行 */
            max-width: 250px;            /* 最大宽度限制 */
            vertical-align: top;         /* 顶部对齐 */
        }

        /* 针对不同列单独设置最大宽度 */
        .layui-table td:nth-child(1) { max-width: 120px; } /* 银行类型 */
        .layui-table td:nth-child(2) { max-width: 200px; } /* BIF Code */
        .layui-table td:nth-child(3) { max-width: 100px; } /* 国家代码 */
        .layui-table td:nth-child(4) { max-width: 100px; } /* 支付类型 */
    </style>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input type="hidden" id="templateId" name="templateId" value="$!{details.id}">
		<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('table.cff.baseInfo')</legend>
        </fieldset>
			<table class="layui-table">
			<tbody>
			<tr>
				<td class="textRight" width="15%">#springMessage('table.configTemplate.templateCode')</td>
				<td width="35%">
                    $!{details.templateNo}
                </td>
                <td class="textRight" width="15%">#springMessage('table.fexExposureTemplate.templateName')</td>
                <td width="35%">
                    $!{details.templateName}
                </td>
		   </tr>
            <tr>
                <td class="textRight" width="15%">#springMessage('table.fexExposureTemplate.templateDesc')</td>
                <td width="35%">
                    $!{details.templateDesc}
                </td>
                <td class="textRight">#springMessage('table.bvVoucherType.validSign')</td>
                <td>
                    $!{details.validSignName}
                </td>
            </tr>
        	<tr>
        		<td class="textRight">#springMessage('table.bvVoucherType.rmk')</td>
				<td width="35%">
                    $!{details.remark}
				</td>
				</tr>
				</tbody>
             </table>
		<div>
		<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('table.fexProfitLossManage.details')</legend>
        </fieldset>				
     <table id="fieldDataTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btswiftinfo.bankType')</th>
        <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAcc.bifCode')</th>
        <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btswiftinfo.countryCode')
        </th>
        <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexForeign.payType')</th>
    </tr>
    </thead>
         <tbody class="ignore-required-icon layui-form">
             #foreach($data in $details.children)
                 #set($rowMR=$math.sub($velocityCount,1))
             <tr>
                 <td>$!{data.bankTypeName}</td>
                 <td>$!{data.bifName}</td>
                 <td>$!{data.countryZhName}</td>
                 <td>$!{data.payTypeName}</td>
             </tr>
             #end
         </tbody>
     </table>
        </div>
        <br>

</form>
    #parse("views/common/footer.vm")
</body>
</html>
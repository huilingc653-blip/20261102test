<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="customPrintVal">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                        <tr>
                            ##模板编号
                            <td class="textRight">#springMessage('table.configTemplate.templateCode')</td>
                            <td>
                                <input type="text" name="templateNo" id="templateNo"
                                    autocomplete="off" class="layui-input bank"
                                    placeholder="#springMessage('table.configTemplate.templateCode')">
                            </td>

                            ##模板名称
                            <td class="textRight">#springMessage('table.transfer.templateName')</td>
                            <td>
                                <input type="text" name="templateName" id="templateName"
                                    autocomplete="off" class="layui-input bank"
                                    placeholder="#springMessage('table.transfer.templateName')">
                            </td>


                            ##银行类型
                            <td class="textRight">#springMessage('table.btswiftinfo.bankType')</td>
                            <td>
                                <div class="layui-inline">
                                    <div data-name="bankTypeId" class="bt-biz-mulselectType"
                                        data-url="${basePath}/basic/business/btbanktype/json" data-method="get"
                                        data-valuefield="id"
                                        data-textfield="typeName"
                                        data-biz-name="bankTypeId"
                                         data-search="true"
                                        data-callback="bankTypeIdCallBack"
                                    ></div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##接口代码
                            <td class="textRight">#springMessage('table.btBankAcc.bifCode')</td>
                            <td>
                                <div class="layui-inline">
                                    <div id="bifId" data-name="bifId" class="bt-biz-mulselectType"
                                        data-url="${basePath}/basic/business/bisbifinit/getByBankType/0" data-method="get"
                                        data-valuefield="id"
                                        data-textfield="displayName"
                                        data-biz-name="bifId"
                                    ></div>
                                </div>
                            </td>
                            ##国家地区
                            <td class="textRight">#springMessage('table.btswiftinfo.countryCode')</td>
                            <td>
                                <div class="layui-inline">
                                    <div id="countryId" data-name="countryId" class="bt-biz-mulselectType"
                                        data-url="${basePath}/basic/business/syscountrycust/listSysCountryCust"
                                        data-method="get"
                                        data-valuefield="id"
                                        data-textfield="nameZh"
                                        data-biz-name="countryId"
                                    ></div>
                                </div>
                            </td>


                            ##支付类型
                            <td class="textRight">#springMessage('table.fexForeign.payType')</td>
                            <td>
                                <input type="text" name="payTypeName" id="payTypeName"
                                    autocomplete="off" class="layui-input bank"
                                    placeholder="#springMessage('table.fexForeign.payType')">
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: center;" colspan="6">
                                <button class="layui-btn" lay-submit lay-filter="search" id="search" type="submit">#springMessage('common.button.search')</button>
                                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
<div>
    <table id="appTable" class="layui-table layui-form" style="width:100%;" data-biz-name="fexConfigTemplate">
        <thead>
            <tr>
                <th>#springMessage('table.configTemplate.templateCode')</th>
                <th>#springMessage('table.fexExposureTemplate.templateName')</th>
                <th>#springMessage('table.btswiftinfo.bankType')</th>
                <th>#springMessage('table.btBankAcc.bifCode')</th>
                <th>#springMessage('table.btswiftinfo.countryCode')</th>
                <th>#springMessage('table.fexForeign.payType')</th>
            </tr>
        </thead>
    </table>
</div>
    #parse("views/common/footer.vm")

    <script>
        bt.use(['form', 'datatable', 'dicts', 'mulselect'], function () {
            var $ = bt.jquery, form = bt.form();
            var dicts = bt.dicts.init();
            var idIndex = 1;
            bt.mulselect.init();
            
            // 获取URL参数中的已选中ID
            var selectedIds = getUrlParam('selectedIds') || '';
            var selectedIdArray = selectedIds ? selectedIds.split(',') : [];

            //生成列表
            var datatable = bt.datatable.init({
                elem: "#appTable",
                dom: 'Brtlip',
                colReorder: true,
                checkbox:true,
                clickRowSelected:true,
                mulselect:true,
                jumpPageSelect: true,//开启跨页选择
                ignoreButtons:['colvis','output','print','state'],// 忽略的表单默认按钮 state取消状态保存按钮
                searchForm: {
                    formElem: "#searchForm",
                    formFilter: "search"
                },
                ajax: {
                    'url': basePath + "/foreign/fexTranConfigTemplate/listOfParentPage"
                },
                buttons: [
                    {
                        text: bt.lang('选择'),
                        action: function (e, dt, node, config) {
                            add();
                        }
                    },
                ],
                columns: [
                    {data: "templateNo", bSortable: true, className: 'center'},
                    {data: "templateName", bSortable: true, className: 'center'},
                    {data: "bankTypeName", bSortable: true, className: 'center'},
                    {data: "bifName", bSortable: true, className: 'center'},
                    {data: "countryZhName", bSortable: true, className: 'center'},
                    {data: "payTypeName", bSortable: true, className: 'center'},

                ],
                btDrawCallback:function(setting){
                    // 根据选中ID回显勾选状态
                    if(selectedIdArray.length > 0){
                        bt.datatable.onCheckRow("appTable", {
                            "key": "id",
                            "value": selectedIdArray,
                            "checked": true
                        });
                    }
                },
            });
            function add() {
                var selectedData = bt.datatable.getJumpSelectedData('fexConfigTemplate');
                var currentTabWin = bt.navtab.getCurrentDom();
                if(currentTabWin){
                    currentTabWin.choosetemplateCallBack &&　currentTabWin.choosetemplateCallBack(selectedData)
                }
                parent.layer.closeAll();
            }
        })

        // 获取URL参数
        function getUrlParam(name) {
            var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)");
            var r = window.location.search.substr(1).match(reg);
            if (r != null) return decodeURIComponent(r[2]);
            return null;
        }

        //选择银行类型回调
        function bankTypeIdCallBack(selectedData) {
            // 获取选中的银行类型ID
            var bankTypeValue = bt.mulselect.get("bankTypeId").val();
            var bankTypeId = bankTypeValue && bankTypeValue.length > 0
                    ? bankTypeValue.map(function(item) { return item.id; }).join(',')
                    : null;
            var bifMulselect = bt.mulselect.get("bifId");
            if (bankTypeId && bankTypeId !== "0" && bankTypeId !== "") {

                var newUrl = basePath + "/basic/business/bisbifinit/getByBankType/" + bankTypeId;
                // 使用组件的 attr 方法修改 URL
                bifMulselect.attr({
                    "data-url": newUrl
                });
            }else {

                var newUrl = basePath + "/basic/business/bisbifinit/getByBankType/" + 0;
                // 使用组件的 attr 方法修改 URL
                bifMulselect.attr({
                    "data-url": newUrl
                });
            }
            // ：重置组件
            var $bifId = $("#bifId");
                $bifId.removeClass("init").empty();
            bt.mulselect.render('reset');

        }
    </script>
</body>
</html>


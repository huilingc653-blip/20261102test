<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	<table class="layui-table">
		<tbody >
		<tr>
			<td class="textRight" width="20%">#springMessage('table.fexTranInfo.tranCode')</td>
			<td width="30%">$!{fexAddWordPage.tranCode}</td>
			<td class="textRight" width="20%">#springMessage('bill.accebill.name')</td>
			<td width="30%">$!{fexAddWordPage.tranName}</td>
		</tr>
		<tr>
			##收支方向 0 收汇 1 付汇
			<td class="textRight" width="20%">#springMessage('table.foreign.cdSign')</td>
			<td width="30%">$dictTag.get("fexAddWord.cdSign",$!{fexAddWordPage.cdSign})</td>
			##有效标志 0 无效 1 有效
			<td class="textRight" width="20%">#springMessage('fcVoucherType.validSign')</td>
			<td width="30%">$dictTag.get("valid_sign",$!{fexAddWordPage.validSign})</td>
		</tr>
		<tr >
			<td class="textRight">#springMessage('table.fexForeignReq.tranAddWord')</td>
			<td colspan="3">$!{fexAddWordPage.addWord}</td>
		</tr>
		</tbody>
	</table>
</form>
	#parse("views/common/footer.vm")
</body>
</html>

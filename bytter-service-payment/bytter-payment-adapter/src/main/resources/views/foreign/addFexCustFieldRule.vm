<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form ignore-required-icon" method="post">
		<input id="id" name="id" type="hidden" value="">
		<table class="layui-table">
            <tbody>
            <tr>
				<td class="textRight"><span style="color:red">*</span>#springMessage('table.field.name')</td>
				<td style="width: 35%">
                    <input type="text" id="fieldName" name="fieldName" autocomplete="off" class="layui-input" lay-verify="required|strlength" value="$!{fexCustFieldRuleVO.fieldName}" data-maxlength="50" >
				</td>
				
				<td class="textRight"><span style="color:red">*</span>#springMessage('table.fex.fieldDesc')</td>
				 <td style="width: 35%">
                     <input type="text" id="fieldDesc" name="fieldDesc" autocomplete="off" class="layui-input" lay-verify="required|strlength" value="$!{fexCustFieldRuleVO.fieldDesc}" data-maxlength="50" >
                 </td>
			</tr>
			
			<tr>
				<td class="textRight"><span style="color:red">*</span>#springMessage('table.fex.appRange1')</td>
        		<td>
        			<div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="select" data-required="true" data-group="application.scope" data-name="appRange1" data-biz-name="appRange1" data-callback="editScope"></div>
                        <div class="bt-biz-dict"
                             id="appRange2"
                             data-type="select"
                             data-required="true"
                             data-defaultvalue="$!{fexCustFieldRuleVO.appRange2}"
                             data-group="application.scope2"
                             data-name="appRange2"
                             data-displayData="1,2,3,4"
                             style="display:none;"></div>
##                        <div class="bt-biz-selectType" id="cotpGroup"  data-biz-name="cotpGroup" data-url="${basePath}/foreign/fexCotp/listCotpGroup" data-valuefield="id" data-textfield="cotpName" data-name="cotpGroup" style="display:none;"></div>
					</div>
        		</td>
				
        		<td class="textRight"><span style="color:red">*</span>#springMessage('contract.field.type')</td>
                <td>
               		<div class="layui-input-inline">
                    	<div class="bt-biz-dict" id="fieldType" data-type="select" data-required="true" data-group="field.type"
                             data-displayData="1,2,3,4,5"
                             data-name="fieldType"  data-callback="editNum"></div>
					</div>
                </td>
			</tr>

			<tr>
				<td class="textRight">#springMessage('table.fex.controlRule')</td>
				<td colspan="3">
                    <table class="layui-table" style="width: 100%" cellspacing="0" cellpadding="0">
                        <tr>
                            <td>##使用预设值
                                <input type="checkbox" lay-skin="primary" id="" name="controlRule" value="1" lay-filter="test" > #springMessage("table.fex.Use.preset.values")
                            </td>
                            <td></td>
                            <td></td>
                
                
                        </tr>
                        <tr class="change1" style="display:none;">
                            <td></td>
                            <td>##允许录入非预设值
                                <input type="checkbox" lay-skin="primary" id="" name="controlRule" value="2" > #springMessage('table.fex.Allow.to.enter.non.default.value')
                            </td>
                
                            <td>##录入非预设值时给予提现
                                <input type="checkbox" lay-skin="primary" id="" name="controlRule" value="3" > #springMessage('table.fex.Withdraw.when.entering.non.default.value')
                            </td>
                        </tr>
                        <tr>
                            <td>##此字段为比录项
                                <input type="checkbox" lay-skin="primary" id="" name="controlRule" value="4" > #springMessage('table.fex.This.field.is.comparative.entry')
                            </td>
                            <td></td>
                            <td></td>
                        </tr>
                    </table>
        		</td>
			</tr>
			
			<tr class="change1" style="display:none;">
                <td class="textRight">#springMessage('table.fex.presetVal')</td>
				<td colspan="3" width="86%">
                    <textarea id="presetVal" style="min-height:70px" class="layui-textarea" name="presetVal" lay-verify="strlength" data-maxlength="200"></textarea>
                    <div style="font-size: 12px; color: red;word-break: break-all;white-space: normal;">#springMessage('table.explain.note')</div>
				</td>
			</tr>
            
            <tr class="change" style="display:none;">
                <td class="textRight"><span style="color:red">*</span>#springMessage('table.fex.decimalDigit')</td>
                <td colspan="3">
                    <input name="decimalDigit" data-id="decimalDigit" type="text" class="layui-input bt-biz-moneyType" data-min="0" data-decimal="0" value="2">
                </td>
            </tr>
            
            <tr class="change" style="display:none;">
                <td class="textRight">#springMessage('table.fex.Numerical.range')</td>
                <td colspan="3">
                    <div class="layui-inline">
                        <input type="text" data-name="minVal" class="layui-input bt-biz-moneyType textRight"
                               data-moneyendid="maxtVal" autocomplete="off" >
                    </div>
                    <span class="date-mid">#springMessage('table.depositRate.range')</span>
                    <div class="layui-inline">
                        <input type="text" id="maxtVal" data-name="maxtVal" class="layui-input bt-biz-moneyType textRight"
                               autocomplete="off" >
                    </div>
                </td>
            </tr>

            <tr class="change" style="display:none;">
                <td class="textRight">#springMessage('table.ratBkrationRelief.curCode')</td>
                <td colspan="3">
                    <div class="bt-biz-selectType"  data-biz-name="curId" data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-textfield="englishCode" data-name="curId" ></div>
                </td>
            </tr>
            </div>

            <tr>
                <td class="textRight">#springMessage('table.fbsItem.validSign')</td>
                <td colspan="3">
                    <div class="layui-input-inline">
                        <div class="bt-biz-dict" data-type="radio" data-biz-name="validSign" data-required="true"
                             data-group="valid_sign" data-name="validSign" data-defaultvalue="1"></div>
                    </div>
                </td>
            </tr>
            </tbody>
			</table>	
			
            <div class="layui-form-item" style="text-align: center">
                <div>
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </div>
            </div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    
var dict;
var selectType;
bt.use(['form','layedit','selectTree','select','btdate','corp','moneyType','selectType','dicts'], function(){
	var $ = bt.jquery, form = bt.form();
    bt.corp.init();
    selectType = bt.selectType.init();
    dict = bt.dicts.init();
    bt.moneyType.init();
    bt.moneyType.init({elem:$('[data-type="int"]'),decimal:0,minus:true});

     //禁用应用范围1
     var $appRange1Select = $("select[name='appRange1']");
         $appRange1Select.attr({"disabled": "disabled", "readonly": "readonly"});
     // 设置应用范围1为只读且固定为"交易"
     bt.dicts.get('appRange1').val('1');
     // 触发一次回调，显示"应用范围2"
     editScope({value: '1'});
    
    //监听提交
    form.on('submit(submit)', function(data){
        var action = "/foreign/fexcustfieldrule/save";
        var controlRule = data.field.controlRule.toString();
        data.field.controlRule = controlRule;
        if(data.field.appRange1 =="0"){
            data.field.appRange2 = selectType.get('cotpGroup').val();
        }
        $.post(basePath + action,data.field,function(result){
        	parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            if(result.success){
            	if(!bt.navtab){
                	parent.layer?parent.layer.closeAll():layer.closeAll();
            	}else{            		
                	bt.navtab.closeCurrent();
            	}
            }
        },'JSON');
        return false;
    });

    form.on('checkbox(test)', function(data){
        if(data.elem.checked){
            $(".change1").show();
        }else {
            $(".change1").hide();
        }
    });
    
});

	
function editScope(data){
    var val = data.value;
    if(val=="0"){
       $("#appRange2").hide();
       $("#cotpGroup").show();
    }else {
        $("#appRange2").show();
        $("#cotpGroup").hide();
    }
}


function editNum(data) {
    var val = data.value;
    var $decimalDigit = $("input[name='decimalDigit'], input[data-id='decimalDigit']");
    if(val=="2") {
        $(".change").show();
        $decimalDigit.attr("lay-verify", "required");
    }else {
        $(".change").hide();
        $decimalDigit.removeAttr("lay-verify");
    }
}
    
</script>
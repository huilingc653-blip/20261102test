								</td>
								##期权费百分比
								<td class="textRight">#springMessage('table.fexTranReq.premiumRatio')</td>
								<td >
									<div class="layui-input-inline">
										<input type="text" id="premiumRatio" name="premiumRatio" data-biz-name="premiumRatio"
											   autocomplete="off" class="layui-input bt-biz-ratioType" placeholder="#springMessage('table.fexTranReq.premiumRatio')" data-callback="premiumRatioCallback">
									</div>
								</td>
							</tr>
							<tr>
								##期权费金额(期权费币种)
								<td class="textRight">#springMessage('table.fexTranReq.premiumMoney.premiumCur')</td>
								<td>
									<input type="text" id="premiumMoneyOfPremiumCur" name="premiumMoneyOfPremiumCur" style="text-align:right" lay-verify="required|number2" data-name="premiumMoneyOfPremiumCur" data-biz-name="premiumMoneyOfPremiumCur"
										   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.premiumMoney.premiumCur')" data-callback="premiumMoneyOfPremiumCurCallback">
								</td>
								##结算币种
								<td class="textRight">#springMessage('table.fexTranDeal.settleCurId')</td>
								<td >
									<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="curId" data-biz-name ="curId"
										 data-valueField="id" data-textField="englishCode" data-required = "true" data-displayData="" data-callback="bt.curCallback"></div>
								</td>
							</tr>
							<tr>
								##期权费折算汇率
								<td class="textRight">#springMessage('table.fexTranReq.premiumRate')</td>
								<td >
									<div class="bt-biz-dict" data-type="radio" data-group="fexProduct.fexOptionRate" data-defaultvalue="0"
										 data-name="premiumRate" data-biz-name="premiumRate" data-required = "true" data-callback="premiumRateCallback"></div>
								</td>
								##期权费金额(结算币种)
								<td class="textRight">#springMessage('table.fexTranReq.premiumMoney.settleCur')</td>
								<td>
									<input type="text" id="premiumMoney" name="premiumMoney" style="text-align:right" lay-verify="required|number2" data-name="premiumMoney" data-biz-name="premiumMoney"
										   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.premiumMoney.settleCur')" data-callback="bt.premiumMoneyCallback">
								</td>
##								##现金流项目
##								<td class="textRight">#springMessage('finacial.common.cashFlow.item')</td>
##								<td>
##									<div class="layui-input-inline">
##										<div class="bt-biz-selectType" data-name="cashItem" data-url="${basePath}/finacial/paramconfig/cashItem/listAllFcCashItem"
##											 data-method="post" data-callback="bt.cashItemCallback"
##											 data-valuefield="id" data-textfield="itemName" data-biz-name="cashItem">
##										</div>
##									</div>
##								</td>
							</tr>
							<tr class = "baseConvertTr">
								##折本位币报价方式
								<td class="textRight">#springMessage('table.fexTranReq.convertQuotationMethod')</td>
								<td >
									<input type="hidden" name="convertCurId" id="convertCurId" value="">
									<input type="hidden" name="convertCurReferId" id="convertCurReferId" value="">
									<div class="layui-input-inline">
										<input type="text" id="convertCurType" name="convertCurType" value="" class="layui-input" readonly/>
									</div>
								</td>
								##折本位币汇率
								<td class="textRight">#springMessage('table.fexTranReq.convertBaseCurRate')</td>
								<td >
									<input type="text" data-id="convertRate" data-name="convertRate" data-biz-name="convertRate" data-decimal="6"
										   lay-verify="number2" value="" data-callback="convertRateCallback"
										   id="convertRate" autocomplete="off" class="layui-input bt-biz-moneyType" data-max="999999999999.999999" data-min="0.00000001">
								</td>
							</tr>
							<tr class = "baseConvertTr">
								##期权费金额(本位币币种)
								<td class="textRight">#springMessage('table.fexTranReq.premiumMoney.corpCur')</td>
								<td>
									<input type="text" id="convertMoney" name="convertMoney" style="text-align:right" lay-verify="required|number2" data-name="convertMoney" data-biz-name="convertMoney"
										   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.premiumMoney.corpCur')">
								</td>
								<td></td>
								<td></td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>


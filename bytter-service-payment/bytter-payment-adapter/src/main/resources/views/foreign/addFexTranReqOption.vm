					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##是否涉及退款
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.isRefund')</td>
								<td colspan="3">
									<div class="layui-input-inline">
										<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-value="0" data-name="isRefund" data-biz-name="isRefund" data-callback="changeRefundCallback"></div>
									</div>
								</td>
							</tr>
							<tr class="refundInfo layui-hide">
								##退款点数
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.refundPoint')</td>
								<td width="30%" >
									<input type="text" id="refundPoint" name="refundPoint" style="text-align:right" data-name="refundPoint" data-biz-name="refundPoint"
										   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.refundPoint')">
								</td>
								##退款百分比
								<td width="20%" class="textRight">#springMessage('table.fexTranReq.refundRatio')</td>
								<td width="30%" >
									<div class="layui-input-inline">
										<input type="text" id="refundRatio" name="refundRatio" data-biz-name="refundRatio"
											   autocomplete="off" class="layui-input bt-biz-ratioType" placeholder="#springMessage('table.fexTranReq.refundRatio')">
									</div>
								</td>
							</tr>
							<tr class="refundInfo layui-hide">
								##退款金额
								<td class="textRight">#springMessage('table.fexTranReq.refundMoney')</td>
								<td>
									<input type="text" id="refundMoney" name="refundMoney" style="text-align:right" lay-verify="number2" data-name="refundMoney" data-biz-name="refundMoney"
										   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.refundMoney')">
								</td>
								##退款支付时间
								<td class="textRight">#springMessage('table.fexProduct.refundTime')</td>
								<td >
									<div class="bt-biz-dict" data-type="radio" data-group="fexProduct.refundTime" data-defaultvalue="" data-name="refundTime" data-biz-name="refundTime"></div>
								</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>

				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.fexTranReq.otherInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
								##附言
							<td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
							<td colspan="3">
								<div class="layui-input-inline">
									<input type="text" id="addWord" name="addWord"
										   lay-verify="strlength" data-maxlength="100"
										   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.addWord')">
								</div>
							</td>
							<tr>
								##备注
								<td class="textRight" width="20%">#springMessage('fcVoucherType.rmk')</td>
								<td colspan="3">
									<textarea placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" lay-verify="strlength" data-maxlength="200" style="width:100%" id="rmk" name="rmk" ></textarea>
								</td>
							</tr>
							<tr>
								##交易员
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.dealer')</td>
								<td width="30%">
									<input type="text" id="dealer" name="dealer" data-required = "true" value="$!{dealer}" readonly="readonly"
										   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.dealer')">
								</td>
								##交易对手业务编号
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.cotpNo')</td>
								<td width="30%">
									<input lay-verify="strlength" type="text" id="cotpNo" name="cotpNo" data-maxlength="32"
										   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.cotpNo')">
								</td>
							</tr>
							<tr>
								##交易地点
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAddr')</td>

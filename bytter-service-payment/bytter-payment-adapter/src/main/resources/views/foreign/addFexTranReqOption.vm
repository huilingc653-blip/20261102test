<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
	#parse("views/common/caData.vm")
	<style>
		.layui-tab-content {
			padding:0!important; ;
		}
	</style>
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
	<ul class="layui-tab-title">
		<li class="layui-this">#springMessage('table.rasBackQuery.msg')</li>
		<li>#springMessage('table.fexTranReq.cashFlow')</li>
		<li>#springMessage('fex.cotp.customInformation')</li>
	</ul>
	<div class="layui-tab-content">
		<div class="layui-tab-item layui-show">
			<input id="createBy" name="createBy" type="hidden" value="$!{fexTranReqPage.createBy}">
			<input id="createDate" name="createDate" type="hidden" value="$!{fexTranReqPage.createDate}">
			<input id="updateBy" name="updateBy" type="hidden" value="$!{fexTranReqPage.updateBy}">
			<input id="updateDate" name="updateDate" type="hidden" value="$!{fexTranReqPage.updateDate}">
			<input id="id" name="id" type="hidden" value="$!{fexTranReqPage.id}">
			<input id="tranType" name="tranType" type="hidden" value="$!{tranType}">
			<input id="status" name="status" type="hidden" value="0">
			<input id="billNo" name="billNo" type="hidden" value="$!{fexTranReqPage.billNo}">
			<!-- 系统参数 -->
			<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
			<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
			<!-- 资金计划参数 明细项控制模式-->
			<input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
			<input id="settlType" name="settlType" type="hidden" value="0">

			<!-- 主体单位账户信息 -->
			<input type="hidden" id="corpBank" name="corpBank" value="">
			<input type="hidden" id="corpAccId" name="corpAccId" value="">
			#*<input type="hidden" id="corpBankAcc" name="corpBankAcc" value="">*#
			<input type="hidden" id="corpAccName" name="corpAccName" value="">
			<!-- 交易对手账户信息 -->
			<input type="hidden" id="cotpBank" name="cotpBank" value="">
			<input type="hidden" id="cotpAccId" name="cotpAccId" value="">
			#*<input type="hidden" id="cotpBankAcc" name="cotpBankAcc" value="">*#
			<input type="hidden" id="cotpAccName" name="cotpAccName" value="">
			<!--卖出方账户信息-->
			<input type="hidden" id="srcBank" name="srcBank" value="">
			<input type="hidden" id="srcAccId" name="srcAccId" value="">
			<input type="hidden" id="srcBankAcc" name="srcBankAcc" value="">
			<input type="hidden" id="srcAccName" name="srcAccName" value="">
			<input type="hidden" id="targetBank" name="targetBank" value="">
			<input type="hidden" id="targetAccId" name="targetAccId" value="">
			<input type="hidden" id="targetBankAcc" name="targetBankAcc" value="">
			<input type="hidden" id="targetAccName" name="targetAccName" value="">
			<input id="timeStamp" name="timeStamp" type="hidden" value="">
			<input id="rateTypeId" type="hidden" value="$!{rateTypeId}">
			<input id="productBuyCurId" type="hidden" value="">
			<div class="layui-collapse">
				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('cms.loan.oldInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##产品
								<td class="textRight" width="20%">#springMessage('table.foreign.product')</td>
								<td width="30%">
									<input type="hidden" id="proIdDef" value="$!{fexTranReqPage.proId}">
									<!--产品的买入币种-->
									<input id="buyCurId" value="" type="hidden"/>
									<!--产品的卖出币种-->
									<input id="sellCurId" value="" type="hidden"/>
									<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProduct/2" data-name ="proId" data-biz-name ="proId"
										 data-valueField="id" data-textField="proName" data-required = "true" data-callback="bt.proCallback"></div>
								</td>
								##单位
								<td class="textRight" width="20%">#springMessage('table.nisBillhead.corpId')</td>
								<td>
									<input type="hidden" id="corpCurId" value=""/>
									<div class="layui-input-inline">
										<div class="bt-biz-corp"
											 data-biz-type="corp"
											 data-type="selectTree"
											 data-name="corpId"
											 data-biz-name="corpId"
											 data-scope="all"
											 data-resource="foreign:fextranreq:option:apply"
											 data-required="true"
											 data-callback="bt.corpCallback"></div>
									</div>
								</td>
							</tr>
							<tr>
								##主体单位账号
								<td class="textRight" width="15%">#springMessage('table.fexTranReq.corpBankAcc')</td>
								<td width="30%">
									<input type="text" id="corpBankAcc" name="corpBankAcc" lay-verify="required|tableData" data-biz-name="corpBankAcc"
										   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.corpBankAcc')" data-swapType="">
									<table id="corpBankAccTable" class="hide">
										<thead>
										<tr>
											<th>#springMessage('table.choBankFinance.acc')</th>
											<th>#springMessage('table.btBankAccApp.accName')</th>
											<th>#springMessage('table.btBankAcc.bankName')</th>
											<th>#springMessage('table.nisBillhead.curId')</th>
										</tr>
										</thead>
									</table>
								</td>
								##主体单位银行
								<td class="textRight" width="15%">#springMessage('table.fexTranReq.corpBank')</td>
								<td width="30%">
									<div id="corpBankNameDiv" name="corpBankNameDiv"></div>
								</td>
							</tr>
							<tr>
								##交易对手银行 02外部交易方
								<td class="textRight" width="20%">#springMessage('fex.tranApp.cotpBank')</td>
								<td width="30%">
##									<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexCotp/listBankCotp?cotpType=02" data-name ="cotpId" data-biz-name ="cotpId"
##										 data-valueField="id" data-textField="cotpName" data-required = "true" data-callback="bt.cotpCallback"></div>
									<div class="layui-input-inline">
										<input type="hidden" id="oppId" name="oppId" autocomplete="off" class="layui-input">
										<input type="text" id="cotpName" name="cotpName" readonly="readonly" class="layui-input" lay-verify="required">
									##交易对手银行
										<div class="bt-div-search">
											<button class="bt-biz-allBankInfo" id="selCoptBankBut" type="button" data-callback="bt.cotpBankCallback" title="#springMessage('common.button.select')">
												<i class="layui-icon">&#xe615;</i>
											</button>
										</div>
									</div>
								</td>
								##波动率
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.volatility')</td>
								<td width="30%">
									<div class="layui-input-inline">
										<input type="text" id="volatility" name="volatility" data-biz-name="volatility"
											   autocomplete="off" class="layui-input bt-biz-ratioType" placeholder="#springMessage('table.fexTranReq.volatility')">
									</div>
								</td>
							</tr>
							<tr>
								##交易对手银行账户
								<td class="textRight" width="15%">#springMessage('fex.cotp')#springMessage('table.fexForeign.bankAcc')</td>
								<td width="30%">
									<input type="text" id="cotpBankAcc" name="cotpBankAcc"
										   lay-verify="strlength" data-maxlength="50"
										   autocomplete="off" class="layui-input"
										   placeholder="#springMessage('fex.cotp')#springMessage('table.fexForeign.bankAcc')">
##									<div class="bt-biz-selectType" data-biz-name="cotpBankAcc" data-name="cotpBankAcc" data-callback="bt.cotpBankAccCallback"
##										 data-url="${basePath}/foreign/fexcotpbankacc/select" data-required = "true" data-valuefield="bankAcc" data-textfield="bankAcc"></div>
								</td>
##								##交易对手银行
##								<td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpBank')</td>
##								<td width="30%">
##									<div id="cotpBankNameDiv" name="cotpBankNameDiv"></div>
##								</td>
								##外汇期权品种
								<td class="textRight">#springMessage('table.fexProduct.fexOption')</td>
								<td>
									<input type="hidden" id="fexOption1" name="fexOption1" value="">
									<input type="hidden" id="fexOption2" name="fexOption2" value="">
									<input type="hidden" id="fexOption3" name="fexOption3" value="">
									<div id="fexOptionDiv" name="fexOptionDiv"></div>
								</td>
							</tr>
							<tr>
								##外汇期权类型
								<td class="textRight">#springMessage('table.fexProduct.fexOptionType')</td>
								<td>
									<input type="hidden" id="fexOptionType" name="fexOptionType" value="">
									<div id="fexOptionTypeDiv" name="fexOptionTypeDiv"></div>
								</td>
								##交易货币对
								<td class="textRight">#springMessage('fex.tranApp.currencyPairs')</td>
								<td>
									<!--交易货币对左侧币种-->
									<input type="hidden" id="tranCurPairBaseId" name="tranCurPairBaseId" value="">
									<!--交易货币对右侧币种-->
									<input type="hidden" id="tranCurPairReferId" name="tranCurPairReferId" value="">
									<div class="layui-input-inline">
										<div class="bt-biz-selectType" data-biz-name="tranCurPairId"
											 data-url="${basePath}/basic/business/btcurrencypair/json"
											 data-valuefield="id" data-textfield="pairCode"
											 data-name="tranCurPairId"
											 data-required = "true"
											 data-callback="bt.currencyPairCallback"
											 data-defaultvalue=""></div>
									</div>
								</td>
							</tr>
							<tr>
								##报价方式
								<td class="textRight">#springMessage('fex.tranApp.quotationMethod')</td>
								<td>
									<input id="quotationCurId" name="quotationCurId" type="hidden"/>
									<input id="quotationReferCurId" name="quotationReferCurId" type="hidden">
									<input id="quotationMethod" name="quotationMethod" type="hidden">
									<div id="quotationMethodText"></div>
								</td>
								##持仓金额
								<td class="textRight">#springMessage('table.fexTranReq.positionMoney')</td>
								<td>
								<input type="text" id="positionMoney" name="positionMoney" style="text-align:right"  data-name="positionMoney" data-biz-name="positionMoney"
									   autocomplete="off" class="layui-input bt-biz-moneyType" readonly>
								</td>
							</tr>
							<tr>
								##买卖方向
								<td class="textRight">#springMessage('fex.tranApp2.businessDirection')</td>
								<td>
									<div class="bt-biz-dict" data-type="radio" data-group="fexTranDeal.deliverySign" data-defaultvalue="1" data-name="busDirection"
										 data-biz-name="busDirection" data-required = "true" data-callback="bt.busDirectionCallback"></div>
								</td>
								##跌涨方向
								<td class="textRight">#springMessage('fex.tranApp2.upAndDownDirection')</td>
								<td >
									<div class="bt-biz-dict" data-type="radio" data-group="fex.tranApp2.updownDirection" data-defaultvalue="0" data-name="updownDirection"
										 data-biz-name="updownDirection" data-required = "true" data-callback="bt.updownDirectionCallback"></div>
								</td>
							</tr>
							<tr>
								##交割类型 0-本金交割、1-无本金交割
								<td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
								<td>
									<div class="bt-biz-dict" data-type="radio" data-group="fexProduct.deliveryType" data-defaultvalue="" data-name="deliveryType" data-biz-name="deliveryType" data-required = "true"></div>
								</td>
								##障碍验证标准 0-即期汇率、1-即期汇率对应的货币价值
								<td class="textRight"><div id="validStandardTdDiv" style="display: none">#springMessage('table.fexTranReq.validStandard')</div></td>
								<td>
									<div class="layui-input-inline" id="validStandardDiv" style="display: none">
										<div class="bt-biz-dict" data-type="radio" data-group="fexProduct.validStandard" data-defaultvalue="" data-name="validStandard" data-biz-name="validStandard"></div>
									</div>
								</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>

				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranAmountInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
##							<tr>
##								<td></td>
##								<td colspan="3">
##									<input type="checkbox" name="autoCal" lay-filter = "autoCal" value="1" checked="checked"
##										   title="#springMessage('fex.tranApp.autoCal')" lay-skin="primary">
##								</td>
##							</tr>
							<tr>
								##执行汇率
								<td class="textRight" width="20%">#springMessage('fex.tranApp.executeExchangeRate')</td>
								<td>
									<input type="text" data-name="contractRate" data-biz-name="contractRate" data-decimal="6" lay-verify="required" data-callback="bt.contractRateCallback"
										   id="contractRate" autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('fex.tranApp.executeExchangeRate')">
								</td>
								##即期汇率
								<td class="textRight" width="20%">#springMessage('table.fexTranDeal.wishRate')</td>
								<td>
									<input type="text" data-name="spotRate" data-biz-name="spotRate" data-decimal="6"
										   id="spotRate" autocomplete="off" class="layui-input bt-biz-moneyType"  placeholder="#springMessage('table.fexTranDeal.wishRate')" data-callback="spotRateCallback">
								</td>
							</tr>
							<tr>
								##金额是否自动计算
								<td class="textRight" width="20%">#springMessage('fex.tranApp.isAutoCalculate')</td>
								<td>
									<div class="layui-inline">
										<input type="radio" lay-filter="isPaymentAmount" name="isPaymentAmount" value="1" title="#springMessage('common.yes')" checked>
										<input type="radio" lay-filter="isPaymentAmount" name="isPaymentAmount" value="0" title="#springMessage('common.no')"  >
									</div>
								</td>
							</tr>
							<tr>
								##买入币种
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.buyCurId')</td>
								<td width="30%">
									<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="buyCurId" data-biz-name ="buyCurId"
										 data-valueField="id" data-textField="englishCode" data-required = "true" data-callback="bt.buyCurCallback" data-disabled="true"></div>
								</td>
								##卖出币种
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.sellCurId')</td>
								<td width="30%">
									<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="sellCurId" data-biz-name ="sellCurId"
										 data-valueField="id" data-textField="englishCode" data-required = "true" data-callback="bt.sellCurCallback" data-disabled="true"></div>
								</td>
							</tr>
							<tr>
								##买入金额
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.buyMoney')</td>
								<td width="30%">
									<input type="text" id="buyMoney" name="buyMoney" style="text-align:right" lay-verify="required|number2" data-name="buyMoney" data-biz-name="buyMoney"
										   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.buyMoney')" data-callback="bt.buyMoneyCallback">
								</td>
								##卖出金额
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.sellMoney')</td>
								<td width="30%">
									<input type="text" id="sellMoney" name="sellMoney" style="text-align:right" lay-verify="required|number2" data-name="sellMoney" data-biz-name="sellMoney"
										   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.sellMoney')" data-callback="bt.sellMoneyCallback">
								</td>
							</tr>

							</tbody>
						</table>
					</div>
				</div>
				<div class="layui-colla-item" id="exceptInfoDiv" style="display: none">
					<h2 class="layui-colla-title">#springMessage('table.fexTranReq.exceptInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
								<tr id="exceptValTrDiv" style="display:none">
									##障碍值
									<td class="textRight" width="20%"><div id="exceptValTdDiv">#springMessage('table.fexTranReq.exceptVal')</div></td>
									<td width="30%">
										<input type="text" id="exceptVal" name="exceptVal" style="text-align:right" lay-verify="number2" data-name="exceptVal" data-biz-name="exceptVal"
											   autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="4" placeholder="#springMessage('table.fexTranReq.exceptVal')">
									</td>
									<td></td>
									<td></td>
								</tr>
								<tr id="exceptValDoubleTrDiv" style="display:none">
									##低障碍值
									<td class="textRight" width="20%"><div id="exceptLowValTdDiv">#springMessage('table.fexTranReq.exceptLowVal')</div></td>
									<td width="30%">
										<input type="text" id="exceptLowVal" name="exceptLowVal" style="text-align:right" lay-verify="number2" data-name="exceptLowVal" data-biz-name="exceptLowVal"
											   autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="4" placeholder="#springMessage('table.fexTranReq.exceptLowVal')" data-moneyendid="exceptHignVal">
									</td>
									##高障碍值
									<td class="textRight" width="20%"><div id="exceptHignValTdDiv">#springMessage('table.fexTranReq.exceptHignVal')</div></td>
									<td width="30%">
										<div id="exceptHignValDiv">
											<input type="text" id="exceptHignVal" name="exceptHignVal" style="text-align:right" lay-verify="number2" data-name="exceptHignVal" data-biz-name="exceptHignVal"
												   autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="4" placeholder="#springMessage('table.fexTranReq.exceptHignVal')">
										</div>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>

				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.fexTranReq.dateInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##交易日期
								<td class="textRight" width="20%">#springMessage('table.revenue.transTime')</td>
								<td width="30%" >
									<input type="text" name="tranDate" lay-verify="required" class="layui-input bt-biz-dateType" data-endid="settleDate"
										   data-today="true"  data-type="date" data-name="tranDate" data-biz-name="tranDate" data-endid="expiresDate">
								</td>
								##到期日期
								<td class="textRight" width="20%">#springMessage('table.fcAcc.deadlineDate')</td>
								<td width="30%" >
									<input type="text" id="expiresDate" name="expiresDate" lay-verify="required" class="layui-input bt-biz-dateType"
										   data-type="date" data-name="expiresDate" data-biz-name="expiresDate">
								</td>
							</tr>
							<tr>
								##结算日期
								<td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
								<td colspan="3">
									<input type="text" id="settleDate" name="settleDate" lay-verify="required" class="layui-input bt-biz-dateType"
										   data-today="true" data-type="date" data-name="settleDate" data-biz-name="settleDate" data-callback="settleDateCallback">
								</td>
							</tr>
							<tr id="avgDateTr" style="display: none">
								##平均期开始日期
								<td class="textRight">#springMessage('table.fexTranReq.avgBeginDate')</td>
								<td>
									<input type="text" name="avgBeginDate" class="layui-input bt-biz-dateType" data-endid="avgEndDate" id="avgBeginDate"
										    data-type="date" data-name="avgBeginDate" data-biz-name="avgBeginDate">
								</td>
								##平均期结束日期
								<td class="textRight">#springMessage('table.fexTranReq.avgEndDate')</td>
								<td>
									<input type="text" id="avgEndDate" name="avgEndDate" class="layui-input bt-biz-dateType"
										    data-type="date" data-name="avgEndDate" data-biz-name="avgEndDate">
								</td>
							</tr>
							<tr id="avgDaysTr" style="display: none">
								##平均期天数
								<td class="textRight">#springMessage('table.fexTranReq.avgDays')</td>
								<td colspan="3">
									<input type="text" id="avgDays" name="avgDays" data-decimal="0" data-separator="" style="text-align:right" lay-verify="number2" data-name="avgDays" data-biz-name="avgDays"
										   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.avgDays')">
								</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>

				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.fexTranReq.premiumInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##期权费结算日期
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.premiumSettleDate')</td>
								<td width="30%" >
									<input type="text" name="premiumDate" lay-verify="required" class="layui-input bt-biz-dateType" data-endid="premiumDate"
										   data-today="true"  data-type="date" data-name="premiumDate" data-biz-name="premiumDate"
										   data-callback="premiumDateCallback"
									>
								</td>
								##期权费币种,如果是交易需求的单,自动带出交易需求的数据，不可修改//TODO
								<td width="20%" class="textRight">#springMessage('table.fexTranReq.premiumCur')</td>
								<td width="30%" >
									<div class="layui-inline">
										<select name="premiumCur" lay-verify="required" lay-filter="premiumCur"></select>
									</div>
##									<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="premiumCur" data-biz-name ="premiumCur"
##										 data-valueField="id" data-textField="englishCode" data-required = "true" data-displayData="" data-callback="premiumCurCallback"></div>
								</td>
							</tr>
							<tr>
								##期权费点数
								<td class="textRight">#springMessage('table.fexTranReq.premiumPoint')</td>
								<td>
									<input type="text" id="premiumPoint" name="premiumPoint" style="text-align:right" lay-verify="number2" data-name="premiumPoint" data-biz-name="premiumPoint"

											   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.tranAddr')" data-swapType="">
										<table id="tranAddrTable" class="hide">
											<thead>
											<tr>
												<th>#springMessage('table.tbCreditPeriod.code')</th>
												<th>#springMessage('table.btswiftinfo.namezh')</th>
												<th>#springMessage('table.btswiftinfo.nameen')</th>
											</tr>
											</thead>
										</table>
									</div>
								</td>
								##交易组
								<td class="textRight">#springMessage('table.fexTranReq.tranGroup')</td>
								<td>
									<div class="bt-biz-selectType" data-url="${basePath}/foreign/fextrangroup/listTranGroup?tranType=$!{tranType}" data-name ="tranGroup" data-biz-name ="tranGroup"
										 data-valueField="id" data-textField="groupName"></div>
								</td>
							</tr>
							<tr>
								##经纪人
								<td class="textRight" width="20%" id="cotpAgentTitleTd">#springMessage('table.fexTranReq.cotpAgent')</td>
								<td width="30%" id="cotpAgentTd">
									<input type="text" id="cotpAgent" name="cotpAgent"
										   lay-verify="strlength" data-maxlength="32"
										   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.cotpAgent')">
									## 交易对手变更需更改取值
##									<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexCotp/listBankCotp?cotpType=07" data-name ="cotpAgent" data-biz-name ="cotpAgent"
##										 data-valueField="id" data-textField="cotpName"></div>
								</td>
								##清算所
								<td class="textRight" width="20%" id="cotpClearHouseTitleTd">#springMessage('table.fexForeign.cotpClearHouse')</td>
								<td width="30%" id="cotpClearHouseTd">
									<input type="text" id="cotpClearHouse" name="cotpClearHouse"
										   lay-verify="strlength" data-maxlength="32"
										   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeign.cotpClearHouse')">
##									<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexCotp/listBankCotp?cotpType=12" data-name ="cotpClearHouse" data-biz-name ="cotpClearHouse"
##										 data-valueField="id" data-textField="cotpName"></div>
								</td>
								<td id="blankTitleTd" style="display: none"></td>
								<td id="blankTd" style="display: none"></td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>

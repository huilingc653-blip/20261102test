<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##资金池
                    <td class="textRight">#springMessage('nis.pool.fcCorpPool.pool')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexcorppool/getFexCorpPoolsUniq" data-name="eqs_poolId" data-biz-name="poolId"
                                 data-valuefield="poolId" data-textfield="showName" data-search="true" data-callback="poolCallBack" ></div>
                        </div>
                    </td>
                    ##主账户
                    <td class="textRight">#springMessage('table.fexCorpPool.mainAccount')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" id="bankAcc" name="eqs_bankAcc" data-biz-name="bankAcc"
                                   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexCorpPool.mainAccount')">
                            <input type="hidden" id="curId" name="eqs_curId" value="">
                            <table id="mainAccountTable" class="hide">
                                <thead>
                                <tr>
                                    <th>#springMessage('table.fexCorpPool.mainAccount')</th>
                                    <th>#springMessage('table.nisBillhead.payerBank')</th>
                                    <th>#springMessage('table.nisBillhead.curId')</th>
                                    <th>#springMessage('table.btBankAcc.isOnline')</th>
                                </tr>
                                </thead>
                            </table>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        #*<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>*#
                        <button type="button" class="layui-btn layui-btn-primary" onClick="resetCode()">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('nis.pool.fcCorpPool.pool')</th>##资金池
		<th>#springMessage('table.fexCorpPool.mainAccount')</th>##主账号
        <th>#springMessage('contract.currency')</th>##币种
        <th>#springMessage('table.fexCorpPoolTran.classification')</th>##资金池交易分类
		<th>#springMessage('ttpay.tradeType')</th>##交易类型
        <th>#springMessage('table.fexCorpPoolTran.product')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexCorpPoolTran.list.js?_btv=${resourceVersion}"></script>
</html>

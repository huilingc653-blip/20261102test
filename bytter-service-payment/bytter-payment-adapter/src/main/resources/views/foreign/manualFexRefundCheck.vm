<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <!-- 银行流水 begin -->
        <input type="hidden" id="dtlId" name="dtlId" value="$!{bisAccDtlPage.id}">
        <!-- 操作类型：0-勾对  1-确认 -->
        <input type="hidden" id="opType" name="opType" value="$!{opType}">
        <table class="layui-table">
            <thead>
            <tr>
                <th colspan="4" style="text-align:center"><h5><strong>#springMessage('fexRefundCheck.title.bisAccDtl')</strong></h5></th>
            </tr>
            </thead>
            <tbody>
            <tr>
                ##交易时间
                <td class="textRight" width="20%">#springMessage('table.bisAccDtl.transTime')</td>
                <td width="30%">$!date.format('yyyy-MM-dd HH:mm:ss.SSS',$!{bisAccDtlPage.transTime})</td>
                ##单位名称
                <td class="textRight" width="20%">#springMessage('table.bisAccDtl.corpName')</td>
                <td width="30%">$!{bisAccDtlPage.corpName}</td>
            </tr>
            <tr>
                ##本方账号
                <td class="textRight">#springMessage('table.btBankAccDtl.bankAcc')</td>
                <td>$!{bisAccDtlPage.bankAcc}</td>
                ##本方账户名
                <td class="textRight">#springMessage('table.btBankAccDtl.accName')</td>
                <td>$!{bisAccDtlPage.accName}</td>
            </tr>
            <tr>
                ##币种
                <td class="textRight">#springMessage('table.bisAccDtl.curName')</td>
                <td>$!{bisAccDtlPage.curName}</td>
                ##交易额
                <td class="textRight">#springMessage('table.bisAccDtl.amt')</td>
                <td>
                    ##交易额(小写)
                    $!number.formatNumeric($!{bisAccDtlPage.amt})
                </td>
            </tr>
            <tr>
                ##对方账户
                <td class="textRight">#springMessage('table.btBankAccDtl.oppAccNo')</td>
                <td>$!{bisAccDtlPage.oppAccNo}</td>
                ##对方账户名
                <td class="textRight">#springMessage('table.btBankAccDtl.oppAccName')</td>
                <td>$!{bisAccDtlPage.oppAccName}</td>
            </tr>
            <tr>
                ##摘要
                <td class="textRight">#springMessage('table.bisAccDtl.summary')</td>
                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{bisAccDtlPage.remark}</div></td>
                ##用途
                <td class="textRight">#springMessage('table.btBankAccDtl.uses')</td>
                <td width="30%"><div style="white-space: normal; word-break: break-all;">$!{bisAccDtlPage.uses}</div></td>
            </tr>
            </tbody>
        </table>
        <table class="layui-table" #if($!{opType} == "1" || $!{opType} == "2") style="display: none" #end>
            <thead>
            <tr>
                <th colspan="4" style="text-align:center"><h5><strong>#springMessage('fexRefundCheck.title.fexCashFlow')</strong></h5></th>
            </tr>
            </thead>
            <tbody>
            <tr>
                ##银行账号
                <td class="textRight">#springMessage('table.foreign.bankAcc')</td>
                <td>
                    <input type="hidden" id="eqs_id" name="eqs_id" value="$!{billId}">
                    <input type="text" name="likes_corpBankAcc" #if($!{refundCheckRule.indexOf("2")} != -1) value="$!{bisAccDtlPage.bankAcc}" #end
                           autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.foreign.bankAcc')">
                </td>
                ##金额
                <td class="textRight">#springMessage('table.choBankFinance.payMoney')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" data-name="geg_payMoney" data-minus="true" #if($!{refundCheckRule.indexOf("1")} != -1) value="$!{bisAccDtlPage.amt}" #end
                               autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.choBankFinance.payMoney')">
                    </div>
                    <span class="date-mid">~</span>
                    <div class="layui-inline">
                        <input type="text" data-name="leg_payMoney" data-minus="true" #if($!{refundCheckRule.indexOf("1")} != -1) value="$!{bisAccDtlPage.amt}" #end
                               autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.choBankFinance.payMoney')">
                    </div>
                </td>
            </tr>
            <tr>
                ##交易对手账号
                <td class="textRight">#springMessage('table.fexForeign.cotpAcc')</td>
                <td>
                    <input type="text" name="likes_cotpBankAcc" #if($!{refundCheckRule.indexOf("3")} != -1) value="$!{bisAccDtlPage.oppAccNo}" #end
                           autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.fexForeign.cotpAcc')">
                </td>
                ##结算日期
                <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                <td>

                    <input type="text" name="ged_settleDate" data-type="date" data-biz-name="ged_settleDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_settleDate"
                           #if($!{refundCheckRule.indexOf("4")} != -1) value="$!date.format('yyyy-MM-dd',$!{settleDate})" #end>
                    <span class="date-mid">~</span>
                    <input type="text" name="led_settleDate" data-type="date" data-biz-name="led_settleDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_settleDate"
                        #if($!{refundCheckRule.indexOf("4")} != -1) value="$!date.format('yyyy-MM-dd',$!{settleDate})" #end>
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            <tr>
                <td class="textRight" width="20%">#springMessage('table.refundblending.handle')</td>
                <td colspan="3">
                    <div class="layui-input-inline">
                        ##1-不处理、2-生成新结算执行单、3-生成新交易单
                        <div class="bt-biz-dict" data-type="select" data-group="foreign.refundCheckHandle" data-name="eqs_refundCheckHandle" data-biz-name="refundCheckHandle"
                             data-defaultvalue="1" data-value="$!{bisAccDtlPage.refundBlendType}" data-required="true"></div>
                    </div>
                </td>
            </tr>
            </tbody>
        </table>
    </form>
    #if(($!{opType} == "0" || $!{opType} == "1") || $!{billId} != "")
    <table id="appTable" class="layui-table layui-form">
        <thead>
        <tr>
            <th>#springMessage('table.fexCashFlow.billNo')</th>
            <th>#springMessage('table.fexTranReq.billNo')</th>
            <th>#springMessage('table.nisBillhead.bursarBillNo')</th>
            <th>#springMessage('fcVoucherType.settlType')</th>
            <th>#springMessage('table.fexBankAcc.proId')</th>
            <th>#springMessage('table.fexCashFlow.settleNo')</th>
            <th>#springMessage('table.fexTranReq.cashFlowDate')</th>
            <th>#springMessage('table.fcSubjectDay.optDate')</th>
            <th>#springMessage('table.fexBankAcc.cashFlowType')</th>
            <th>#springMessage('table.bisAccDtl.curName')</th>
            <th>#springMessage('table.foreign.cdSign')</th>
            <th>#springMessage('table.choBankFinance.payMoney')</th>
            <th>#springMessage('table.nisBillhead.corpId')</th>
            <th>#springMessage('common.button.bank')</th>
            <th>#springMessage('table.btBankAccApp.accName')</th>
            <th>#springMessage('table.foreign.bankAcc')</th>
            <th>#springMessage('fex.cotp')</th>
            <th>#springMessage('table.fexTranReq.cotpBank')</th>
            <th>#springMessage('table.fexTranReq.cotpAccName')</th>
            <th>#springMessage('table.fexForeign.cotpAcc')</th>
            <th>#springMessage('table.foreign.voucherType')</th>
            <th>#springMessage('table.fexTranReq.isPayed')</th>
            <th>#springMessage('table.choBankFinance.status')</th>
            <th>#springMessage('table.fexCashFlow.payStatus')</th>
        </tr>
        </thead>
    </table>
    #end
    <!-- 业务单据 end -->
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/manualRefundCheck.list.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
        ##名称
            <td class="textRight">#springMessage('bpm.option.usertask.name')</td>
            <td>
                <input type="text" name="likes_ruleName"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('bpm.option.usertask.name')">
            </td>
        ##交易类型
            <td class="textRight">#springMessage('ttpay.tradeType')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-name="eqs_tranType" data-displayData="7,8,9,2,3,4"
                         data-group="fexCorp.tranType" data-callback="bt.changePro"></div>
                </div>
            </td>
        ##产品
            <td class="textRight">#springMessage('table.choProduct.productName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-biz-name="proId" data-type="select" data-url="${basePath}/foreign/fexproduct/listProduct/-1"
                         data-name="eqs_proId" data-valueField="id" data-textField="proName"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form">
    <thead>
    <tr>
        <th>#springMessage('bill.accebill.name')</th>
        <th>#springMessage('ttpay.tradeType')</th>
        <th>#springMessage('table.choProduct.productName')</th>
        <th>#springMessage('fcVoucherType.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexTranGroupRule.list.js?_btv=${resourceVersion}"></script>
</html>

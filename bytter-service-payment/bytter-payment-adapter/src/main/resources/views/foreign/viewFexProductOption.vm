<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	<table class="layui-table">
		<tbody>
		<tr>
			<td class="textRight" width="40%">#springMessage('table.fexProduct.proName')</td>
			<td width="60%">
				$!{fexProductPage.proName}
			</td>
		</tr>
		<tr>
			<td class="textRight" width="40%">#springMessage('table.fexProduct.proDesc')</td>
			<td width="60%">
				$!{fexProductPage.proDesc}
			</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage('table.fexProduct.proId')</td>
			<td>
				$!{fexProductPage.parentProName}
			</td>
		</tr>
			##外汇期权品种
		<tr>
			<td class="textRight">#springMessage('table.fexProduct.fexOption')</td>
			<td>
				#if($!{fexProductPage.fexOption1})
					$dictTag.get("fexProduct.fexOption1",$!{fexProductPage.fexOption1})
				#end
				#if($!{fexProductPage.fexOption2})
					$dictTag.get("fexProduct.fexOption2",$!{fexProductPage.fexOption2})
				#end
				#if($!{fexProductPage.fexOption3})
					$dictTag.get("fexProduct.fexOption3",$!{fexProductPage.fexOption3})
				#end
			</td>
		</tr>
			##外汇期权类型 0-欧式、1-美式
		<tr>
			<td class="textRight">#springMessage('table.fexProduct.fexOptionType')</td>
			<td>
				<div class="layui-inline" id="fexOptionTypeDiv">
					$dictTag.get("fexProduct.fexOptionType",$!{fexProductPage.fexOptionType})
				</div>
			</td>
		</tr>
			##期权费汇率 0-使用协定汇率、1-使用即期汇率
		<tr>
			<td class="textRight">#springMessage('table.fexProduct.fexOptionRate')</td>
			<td>
				$dictTag.get("fexProduct.fexOptionRate",$!{fexProductPage.fexOptionRate})
			</td>
		</tr>
			##退款支付时间 0-到期日、1-敲出日
		<tr id="refundTimeTr" #if(!$!{fexProductPage.refundTime})
			class ="layui-hide"
		#end>
			<td class="textRight">#springMessage('table.fexProduct.refundTime')</td>
			<td>
				##退款支付时间：2-上涨失效单障碍期权(Up & Out)、3-下跌失效单障碍期权(Down & Out) 必选
				$dictTag.get("fexProduct.refundTime",$!{fexProductPage.refundTime})
			</td>
		</tr>
			##加权天数规则 0-按日历（不区分是否工作日）、1-仅工作日
			#if($!{fexProductPage.fexOption2} == "1")
			<tr id="daysRuleDiv">
			#else
			<tr id="daysRuleDiv" style="display: none">
			#end
			<td class="textRight">#springMessage('table.fexProduct.daysRule')</td>
			<td>
				##加权天数规则：1-亚式期权时才显示且必选
				$dictTag.get("fexProduct.daysRule",$!{fexProductPage.daysRule})
			</td>
		</tr>
			##交易时障碍验证标准 0-即期汇率、1-即期汇率对应的货币价值
			##交易时障碍验证标准：2-单障碍期权和3-双障碍期权时才显示且必选
			#if($!{fexProductPage.fexOption2} == "2" || $!{fexProductPage.fexOption2} == "3")
			<tr id="validStandardDiv">
			#else
			<tr id="validStandardDiv" style="display: none">
			#end
			<td class="textRight">#springMessage('table.fexProduct.validStandard')</td>
			<td>
				$dictTag.get("fexProduct.validStandard",$!{fexProductPage.validStandard})
			</td>
		</tr>
		<td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
		<td>
			$dictTag.get("fexProduct.deliveryType",$!{fexProductPage.deliveryType})
		</td>
			##在交易时展示经纪人 0-否、1-是
		<tr>
			<td class="textRight">#springMessage('table.fexProduct.isShowAgent')</td>
			<td>
				$dictTag.get("sf_yn",$!{fexProductPage.isShowAgent})
			</td>
		</tr>
			##在交易时展示清算所 0-否、1-是
		<tr>
			<td class="textRight">#springMessage('table.fexProduct.isShowClearHouse')</td>
			<td>
				$dictTag.get("sf_yn",$!{fexProductPage.isShowClearHouse})
			</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage('table.fexProduct.buyCurId')</td>
			<td>
				#if($!{fexProductPage.buyEnglishCode})
					$!{fexProductPage.buyEnglishCode}
				#end
			</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage('table.fexProduct.sellCurId')</td>
			<td>
				#if($!{fexProductPage.sellEnglishCode})
					$!{fexProductPage.sellEnglishCode}
				#end
			</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
			<td>
				$dictTag.get("valid_sign",$!{fexProductPage.validSign})
			</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
			<td >
				$!{fexProductPage.rmk}
			</td>
		</tr>
		<tr>
			<td colspan="2" style="text-align: center">
				<button class="layui-btn" lay-submit="false" onClick="doClose()">#springMessage('common.button.close')</button>
			</td>
		</tr>
		</tbody>
	</table>
</form>
</body>
	#parse("views/common/footer.vm")
	<script>
		bt.use(["jquery", "form", "btUpload"], function () {
			$ = bt.jquery;
			form = bt.form();
			var gid = $("#gid").val();
			upload = bt.btUpload.init({
				elem: "#uploader",
				hasDelete: false,
				hasUpload: false,
				isExpand: true,
				auto: false,
				gid: gid
			});

			/**
			 * 查看
			 * @param id
			 */
			view = function (id) {
				if (bt.navtab) {
					bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/foreign/fextranreq/view/" + id);
					return;
				}
				parent.layer.open({
					type: 2,
					area: ['850px', '530px'],
					maxmin: true,
					content: basePath + "/foreign/fextranreq/view/" + id
				});
			}
		});
		//关闭窗口
		function doClose() {
			if (bt.navtab) {
				bt.navtab.closeCurrent();
			}
		}
	</script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<!-- 资金收付交易 -->
<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell">
##        交易编码
        #springMessage('table.fexTranReq.billNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.billNo}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        交易需求编码
        #springMessage('table.fexTranReq.tranAppDtlNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranAppDtlNo}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        申请日期
    #springMessage('table.bisFinanceExc.reqDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexTranReqPage.createDate})
        </span>
    </li>

    <li class="mui-table-view-cell">
##        产品
    #springMessage('table.foreign.product')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.proName}
        </span>
    </li>
    <li class="mui-table-view-cell">
##        跨行标志
        #springMessage('table.nisBillhead.difBank')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("nisBillhead.difBank",$!{fexTranReqPage.difBank})
        </span>
    </li>
    <li class="mui-table-view-cell">
##        汇款类型
    #springMessage('table.fexForeignReq.remitType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.remitType",$!{fexTranReqPage.remitType})
        </span>
    </li>
    <li class="mui-table-view-cell">
##        是否线下付款
        #springMessage('table.fexTranReq.isPayed')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("sf_yn",$!{fexTranReqPage.isPayed})
        </span>
    </li>
    <li class="mui-table-view-cell">
##        交易对手
    #springMessage('table.fexForeign.copt')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.cotpName}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        币种
    #springMessage('table.bisAccDtl.curName')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.englishCode}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        收付方向
    #springMessage('table.fexBankAcc.cdSign')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexCorp.cdSign",$!{fexTranReqPage.cdSign})
        </span>
    </li>
    <li class="mui-table-view-cell">
##        会计凭证号
        #springMessage('table.nisBillhead.bursarBillNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.bursarBillNo}
        </span>
    </li>
    #if($!{fexTranReqPage.remitType} == "2")
        <li class="mui-table-view-cell">
        ##被代收/代付单位
            #springMessage('table.fexTranReq.payCorpId')
            <span class="mui-badge mui-badge-inverted">
                $!{fexTranReqPage.payCorpName}
            </span>
        </li>
    #end

    <li class="mui-table-view-cell">
    ##金额
        #springMessage('table.choBankFinance.payMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexTranReqPage.payMoney})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易日期
        #springMessage('table.revenue.transTime')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexTranReqPage.tranDate})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##结算日期
        #springMessage('table.fcSubjectDay.optDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##加急标志
        #springMessage('table.nisBillhead.isQuick')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("sf_yn",$!{fexTranReqPage.isQuick})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##主体单位银行
        #springMessage('table.fexTranReq.corpBank')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.corpBankName}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##主体单位银行账户
        #springMessage('table.fexTranReq.corpBankAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.corpBankAcc}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##账户名称
        #springMessage('table.btBankAccApp.accName')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.corpAccName}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##汇款方式
        #springMessage('table.fexForeignReq.remitMethod')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.remitMethod",$!{fexTranReqPage.remitMethod})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##主体单位名称(英文)
        #springMessage('table.fexTranReq.corpNameEn')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.corpNameEn}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##主体单位地址(英文)
        #springMessage('table.fexTranReq.corpAddrEn')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.corpAddrEn}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##主体单位联系人
        #springMessage('table.fexTranReq.corpContact')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.corpContact}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##主体单位电话
        #springMessage('table.fexTranReq.corpContactTel')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.corpContactTel}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易对手银行
        #springMessage('fex.cotp')#springMessage('common.button.bank')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.cotpBankName}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易对手银行账户
        #springMessage('fex.cotp')#springMessage('table.fexForeign.bankAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.cotpBankAcc}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易对手地址
        #springMessage('fex.cotp')#springMessage('table.externalCorp.address')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.cotpAdrr}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易对手银行地址
        #springMessage('table.fexTranReq.cotpBankAdrr')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.cotpBankAdrr}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易对手银行Swift Code
        #springMessage('table.fexTranReq.cotpSwiftCode')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.cotpSwiftCode}
        </span>
    </li>

    <li class="mui-table-view-cell">
##        交易对手所在国家地区
    #springMessage('table.fexTranReq.cotpCountry')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.nameZh}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易对手代理行
        #springMessage('fex.cotp')#springMessage('table.fexTranReq.agentBank')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.cotpAgentBank}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易对手代理行地址
        #springMessage('table.fexTranReq.agentBankAddr')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.cotpAgentBankAddr}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易对手在代理行的账户
        #springMessage('table.fexTranReq.agentAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.cotpAgentBankAcc}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##资金性质
        #springMessage('table.fexTranReq.accNature')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexTranReq.accNature",$!{fexTranReqPage.accNature})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##国内外费用承担标志 1-汇款人 OUR  2-收款人 BEN  3-共同 SHA
        #springMessage('table.fexForeignReq.costSign')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.costSign",$!{fexTranReqPage.costSign})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##费用支出账户
        #springMessage('table.fexTranReq.costAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.costAcc}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##付款类型 1-预付货款 2-货到付款 3-退款 4-其他
        #springMessage('table.fexForeignReq.payType')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.payType",$!{fexTranReqPage.payType})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##最迟装运日期
        #springMessage('table.fexForeignReq.shipDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexTranReqPage.shipDate})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##是否为保税货物项下付款 0-否 1-是
        #springMessage('table.fexForeignReq.isBonded')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("sf_yn",$!{fexTranReqPage.isBonded})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##外汇局批件/备案表号/业务编号
        #springMessage('table.fexForeignReq.busNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.busNo}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##合同号
        #springMessage('table.fexForeignReq.contractNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.contractNo}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##发票号
        #springMessage('table.fexForeignReq.invoiceNo')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.invoiceNo}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易编码1
        #springMessage('table.fexForeignReq.tranCode1')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranName1}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易编码2
        #springMessage('table.fexForeignReq.tranCode2')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranName2}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##相应金额1
        #springMessage('table.fexForeignReq.tranAmt1')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexTranReqPage.tranAmt1})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##相应金额2
        #springMessage('table.fexForeignReq.tranAmt2')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexTranReqPage.tranAmt2})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##相应币种1
        #springMessage('table.fexForeignReq.tranCurId1')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranEnglishCode1}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##相应币种2
        #springMessage('table.fexForeignReq.tranCurId2')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranEnglishCode2}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易附言1
        #springMessage('table.fexForeignReq.tranAddWord1')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranAddWord1}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易附言2
        #springMessage('table.fexForeignReq.tranAddWord2')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranAddWord2}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##付汇性质 1-保税区 2-出口加工区 3-钻石交易所 4-其他特殊经济区域 5-深加工结转 6-离岸账户 7-其他
        #springMessage('table.fexForeignReq.remitNature')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("fexForeignReq.remitNature",$!{fexTranReqPage.remitNature})
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##备注
        #springMessage('fcVoucherType.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.rmk}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易员
        #springMessage('table.fexTranReq.dealer')
        <span class="mui-badge mui-badge-inverted">
            $!{dealer}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易地点
        #springMessage('table.fexTranReq.tranAddr')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranAddr}
        </span>
    </li>

    <li class="mui-table-view-cell">
    ##交易组
        #springMessage('table.fexTranReq.tranGroup')
        <span class="mui-badge mui-badge-inverted">
            $!{fexTranReqPage.tranGroupName}
        </span>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

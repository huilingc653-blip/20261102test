<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<input id="tranType" name="tranType" type="hidden" value="$!{tranType}">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##名称
                    <td class="textRight">#springMessage('table.fexProduct.name')</td>
                    <td>
                        <input type="text" name="likes_proName"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexProduct.name')">
                    </td>
                    ##层级
                    <td class="textRight">#springMessage('table.fexProduct.proLevel')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="fexProduct.proLevel" data-name="eqs_proLevel"></div>
                    </td>
                    ##有效标志
                    <td class="textRight">#springMessage('bisAccAttribute.validSign')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="valid_sign" data-name="eqs_validSign"></div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.fexProduct.name')</th>
            <th>#springMessage('table.fexProduct.proId')</th>
            <th>#springMessage('table.fexProduct.proLevel')</th>
            <th>#springMessage('bisAccAttribute.validSign')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexProductAllocation.list.js?_btv=${resourceVersion}"></script>

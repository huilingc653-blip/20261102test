#parse("views/common/head.vm")
<div class="layui-collapse">
	<h2 class="layui-colla-title" style="text-align: center">#springMessage('table.fexExposureTemplate.templateView')</h2>
	<div class="layui-colla-item">
	<table class="layui-table layui-table-border">
		<tbody >
		<tr>
			##模板名称
			<td class="textRight" width="20%">#springMessage('table.fexExposureTemplate.templateName')</td>
			<td width="30%">$!{fexExposureTemplatePage.templateName}</td>
			<td class="textRight" width="20%">#springMessage('fcVoucherType.validSign')</td>
			<td width="30%">$dictTag.get("valid_sign",$!{fexExposureTemplatePage.validSign})</td>
		</tr>
		<tr>
			##总填报周期
			<td class="textRight" width="20%">#springMessage('table.fexExposureTemplate.totalFillPeriod')</td>
			<td width="30%">$!{fexExposureTemplatePage.totalFillPeriod}$dictTag.get("fexExposureTemplate.timeType",$!{fexExposureTemplatePage.totalFillUnit})</td>
			##前面按周期填报，后续是否按年度填报 0-否 1-是
			<td class="textRight">#springMessage('table.fexExposureTemplate.isYearFill')</td>
			<td>$dictTag.get("sf_yn",$!{fexExposureTemplatePage.isYearFill})</td>
		</tr>
		<tr>
			##滚动总周期
			<td class="textRight">#springMessage('table.fexExposureTemplate.scrollFillPeriod')</td>
			<td>$!{fexExposureTemplatePage.scrollFillPeriod}$dictTag.get("fexExposureTemplate.timeType",$!{fexExposureTemplatePage.scrollFillUnit})</td>
			##前面按周期填报，后续是否按总额填报 0-否 1-是
			<td class="textRight">#springMessage('table.fexExposureTemplate.isTotalFill')</td>
			<td>$dictTag.get("sf_yn",$!{fexExposureTemplatePage.isTotalFill})</td>
		</tr>
		<tr>
			##滚动分解子周期
			<td class="textRight">#springMessage('table.fexExposureTemplate.scrollResolvePeriod')</td>
			<td colspan="3">$!{fexExposureTemplatePage.scrollResolvePeriod}$dictTag.get("fexExposureTemplate.timeType",$!{fexExposureTemplatePage.scrollResolveUnit})</td>
		</tr>
		<tr>
			##模板科目
			<td class="textLeft" style="width: 5%; text-align: right">#springMessage('table.fexExposureTemplate.itemCode')</td>
			<td style="width: 95%" id="innerTree" colspan="3">
				<table class="layui-table" id="itemTable">
					<tbody>
						#foreach($data in $listItem)
						<tr data-tt-id="$!{data.itemCode}" data-tt-parent-id="$!{data.superItemCode}" data-id="$!{data.id}" >
							<td width="10px" align="center">
								<input type="checkbox" name="itemCodes" class="itemCodes" disabled="disabled"
									#foreach($item in $listItemCheck)
										#if($item.itemCode == $data.itemCode)
									   checked="true"
										#end
									#end
									   lay-skin="primary" value="$!{data.itemCode}" lay-filter="itemCheck"/>&nbsp;&nbsp;&nbsp;&nbsp;
								<input type="hidden" name="itemName" id="itemName$!{data.itemCode}" value="$!{data.itemName}">
							</td>
							<td>    $!{data.itemName}&nbsp;&nbsp;($!{data.itemCode})</td>
						</tr>
						#end
					</tbody>
				</table>
				<div style="white-space: normal; word-break: break-all;">
					<span>#springMessage('table.fexExposureTemplate.checkItemInfo')</span>
					<span id="checkItemInfo"></span>
				</div>
			</td>
		</tr>
		</tbody>
	</table>
	</div>
</div>
<script type="text/javascript">
	bt.use(['form', 'layedit', 'treeTable'], function () {
		bt.treeTable.init({elem:"#itemTable",column:1});
		//设置已选科目
		function setCheckItemInfo() {
			var itemNames = "";
			$('form').find('input[name="itemCodes"]:checked').each(function(){
				if (itemNames == "") {
					itemNames = $('#itemName' + $(this).val()).val() + '(' + $(this).val() + ")";;
				} else {
					itemNames += '、'+$('#itemName' + $(this).val()).val() + '(' + $(this).val() + ")";;
				}
			});
			$("#checkItemInfo").text(itemNames);
		}
		setCheckItemInfo();
	});
</script>
</html>
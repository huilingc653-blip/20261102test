##parse("views/common/head.vm")
<table id="appTable" class="layui-table layui-form dark-layui-table layui-table-border" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisMessage.enrolDate')</th>
        <th>#springMessage('table.nisMessage.op')</th>
        <th>#springMessage('table.nisMessage.opName')</th>
        <th>#springMessage('table.nisMessage.messageType')</th>
        <th>#springMessage('table.nisMessage.message')</th>
    </tr>
	</thead>
	#foreach($msg in $list)
	<tr>
		<td align="center">$!date.format('yyyy-MM-dd HH:mm:ss',$!{msg.enrolDate})</td>
		<td>$!{msg.op}</td>
		<td>$!{msg.opName}</td>
		<td>$dictTag.get("nisMessage.messageType",$!{msg.messageType})</td>
        <td>
            #if($!{msg.message} && $!{msg.message}!="")
                #springMessage($!{msg.message})
            #end
        </td>
	</tr>
	#end
</table>

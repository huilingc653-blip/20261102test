<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{fexProductPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{fexProductPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fexProductPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{fexProductPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{fexProductPage.id}">
		<input id="proLevel" name="proLevel" type="hidden" value="1">
		<input id="tranType" name="tranType" type="hidden" value="$!{tranType}">
		<table class="layui-table">
			<tbody>
				##产品名称
				<tr>
    				<td class="textRight" width="40%">#springMessage('table.fexProduct.proName')</td>
                    <td width="60%">
						<input type="text" id="proName" name="proName" lay-verify="required|strlength" data-maxlength="60"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexProduct.proName')">
    				</td>
				</tr>
				##产品描述
				<tr>
					<td class="textRight" width="40%">#springMessage('table.fexProduct.proDesc')</td>
					<td width="60%">
						<input lay-verify="strlength" type="text" id="proDesc" name="proDesc" data-maxlength="100"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexProduct.proDesc')">
					</td>
				</tr>
				##所属产品组
				<tr>
    				<td class="textRight">#springMessage('table.fexProduct.proId')</td>
                    <td>
						<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProductGroup/$!{tranType}" data-name ="proId" data-biz-name ="proId"
							 data-valueField="id" data-textField="proName"></div>
    				</td>
				</tr>
				##外汇交易类型
				<tr id="fexTranTypeTr">
					<td class="textRight">#springMessage('table.fexProduct.fexTranType')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="fexProduct.fexTranType" data-defaultvalue="0" data-name="fexTranType" data-required = "true"
							 data-biz-name="fexTranType" data-callback="fexTranTypeCallBack"></div>
					</td>
				</tr>
				##外汇业务类型
				<tr>
					<td class="textRight original">
						<span class="original ">#springMessage('table.fexProduct.fexBusType')</span>
					</td>
					<td class="textRight jinduan layui-hide">
						<span class="">#springMessage('table.fexProduct.fexBusType.nearEnd')</span>
					</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="fexProduct.fexBusType" data-defaultvalue="1" data-name="fexBusType" data-required = "true"></div>
					</td>
				</tr>
				##即期是否自动交割
				<tr id="isAutoDeliveryTr">
					<td class="textRight">#springMessage('table.fexProduct.isAutoDelivery')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="isAutoDelivery"
							 data-biz-name="isAutoDelivery" data-defaultvalue="1" data-required = "true"></div>
					</td>
				</tr>
				##交割类型
				<tr>
					<td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="fexProduct.deliveryType" data-defaultvalue="0" data-name="deliveryType"
							 data-name="deliveryType" data-biz-name="deliveryType" data-required = "true" data-callback="deliveryTypeCallBack"></div>
					</td>
				</tr>
				##默认交割币种
				<tr id="deliveryCurTR" style="display: none">
					<td class="textRight">#springMessage('table.fexProduct.deliveryCurId')</td>
					<td>
						<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="deliveryCurId" data-biz-name ="deliveryCurId"
							 data-valueField="id" data-textField="englishCode"></div>
					</td>
				</tr>
				##是否允许多次交割
				#*<tr>
					<td class="textRight">#springMessage('table.fexProduct.isAllowedDelivery')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isAllowedDelivery" data-required = "true"></div>
					</td>
				</tr>*#
				##非工作日是否允许结算
				<tr>
					<td class="textRight">#springMessage('table.fexProduct.isAllowedSettle')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isAllowedSettle" data-required = "true"></div>
					</td>
				</tr>
				##默认买入币种
				<tr>
					<td class="textRight">
						<span class="original ">#springMessage('table.fexProduct.buyCurId')</span>
						<span class="jinduan layui-hide">#springMessage('table.fexProduct.buyCurId.nearEnd')</span>
					</td>
					<td>
						<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="buyCurId" data-biz-name ="buyCurId"
							 data-valueField="id" data-textField="englishCode"></div>
					</td>
				</tr>
				##默认卖出币种
				<tr>
					<td class="textRight">
						<span class="original ">#springMessage('table.fexProduct.sellCurId')</span>
						<span class="jinduan layui-hide">#springMessage('table.fexProduct.sellCurId.nearEnd')</span>
					</td>
					<td>
						<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="sellCurId" data-biz-name ="sellCurId"
							 data-valueField="id" data-textField="englishCode"></div>
					</td>
				</tr>
				##有效标志
				<tr>
					<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="1" data-name="validSign" data-required = "true"></div>
					</td>
				</tr>
				##备注
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
					<td >
						<textarea lay-verify="strlength" placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" style="width:100%" id="rmk" name="rmk"  data-maxlength="100" ></textarea>
					</td>
				</tr>
				<tr>
					<td colspan="2" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
						<button type="reset" class="layui-btn layui-btn-primary" onclick="clearAll()">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexProduct.add.js?_btv=${resourceVersion}"></script>
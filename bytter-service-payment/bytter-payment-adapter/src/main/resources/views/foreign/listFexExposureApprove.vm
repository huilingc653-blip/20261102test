<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}"/>
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
		<table class="layui-table">
			<tbody>
				<tr>
                    <td class="textRight" width="12%">#springMessage('table.nisBillhead.corpId')</td>
                    <td width="20%">
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 data-tree-type="check"
                                 data-scope="all"></div>
                        </div>
                    </td>
					<td class="textRight" width="12%">#springMessage('table.fexExposureTemplate.templateName')</td>
					<td width="20%">
                        <input type="text" name="likes_templateName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexExposureTemplate.templateName')">
                    </td>
                </tr>
                <tr>
                    <td class="textRight" width="13%">#springMessage('table.fexExposure.enrolDate')</td>
                    <td width="25%">
                        <input type="text" name="ged_enrolDate" class="layui-input bt-input-inline bt-biz-dateType"
                               data-endid="led_enrolDate" value="">
                        <span class="date-mid">~</span>
                        <input type="text" name="led_enrolDate" class="layui-input bt-input-inline bt-biz-dateType"
                               id="led_enrolDate" value="">
                    </td>
                    <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                                 data-name="likes_curId" data-valueField="id" data-textField="curName"></div>
                        </div>
                    </td>
                </tr>
    			<tr >
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.nisBillhead.corpId')</th>
            <th>#springMessage('table.fexCorpExposureTemplate.template')</th>
            <th>#springMessage('table.nisBillhead.curId')</th>
            <th>#springMessage('table.fexExposure.enrolDate')</th>
            <th>#springMessage('table.fbsBudget.status')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
#paymentWorkFlowHtml()
#parse("views/common/footer.vm")
#paymentWorkFlowScript()
</body>
<script src="${basePath}/static/modules/foreign/fexExposureApprove.list.js?_btv=${resourceVersion}"></script>
</html>
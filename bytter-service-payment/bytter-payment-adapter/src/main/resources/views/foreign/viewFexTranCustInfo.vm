<table class="layui-table layui-form">
    #foreach($element in $custFields)
        #if($velocityCount % 2 == 0)
            <td class="textRight" width="20%">
                $!{element.fieldName}
            </td>
            <td width="30%">
                <div class="layui-input-inline">
                #if($!{element.fieldType} == 2)
                    $!number.formatNumeric($!{element.fieldVal})
                #else
                    $!{element.fieldVal}
                #end
                </div>
            </td>
            </tr>
        #else
        <tr>
            <td class="textRight" width="20%">
                $!{element.fieldName}
            </td>
            <td width="30%">
                <div class="layui-input-inline">
                    #if($!{element.fieldType} == 2)
                        $!number.formatNumeric($!{element.fieldVal})
                    #else
                        $!{element.fieldVal}
                    #end
                </div>
            </td>
            #if($foreach.last)
                <td width="20%"></td>
                <td></td>
            </tr>
            #end
        #end
    #end
</table>
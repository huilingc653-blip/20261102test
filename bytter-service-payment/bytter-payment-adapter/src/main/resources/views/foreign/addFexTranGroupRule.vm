<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-fluid" style="padding: 0">
        <table class="layui-table">
            <thead>
            <tr>
                <td colspan="2">#springMessage('common.add.data')</td>
            </tr>
            </thead>
            <tbody>
                ##名称
            <tr>
                <td class="textRight">#springMessage('bpm.option.usertask.name')</td>
                <td>
                    <input type="text" name="ruleName" lay-verify="required|strlength"
                           data-maxlength="60"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('bpm.option.usertask.name')">
                </td>
            </tr>
                ##描述
            <tr>
                <td class="textRight">#springMessage('sys.role.description')</td>
                <td>
                    <input type="text" name="ruleDesc" lay-verify="strlength"
                           data-maxlength="100"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('sys.role.description')">
                </td>
            </tr>
                ##备注
            <tr>
                <td class="textRight">#springMessage('table.btCurrency.rmk')</td>
                <td>
                        <textarea name="rmk" class="layui-textarea" lay-verify="strlength"
                                  data-maxlength="200"></textarea>
                </td>
            </tr>
                ##有效标志
            <tr>
                <td class="textRight">#springMessage('fcVoucherType.validSign')</td>
                <td>
                    <div class="bt-biz-dict" data-group="sf_yn" data-name="validSign" data-type="radio"
                         data-defaultvalue="1"></div>
                </td>
            </tr>
            </tbody>
        </table>
        <table class="layui-table ignore-required-icon" id="ruleDtl">
                <thead>
                <tr>
                    <th colspan="7">
                        <span style="float: left">#springMessage("table.fexProduct.trangroupRuleId")</span>
                        <span style="float: right">
							 <button type="button" class="layui-btn" lay-filter="add" id="add">#springMessage(
                                 'common.addTr')</button>
						</span>
                    </th>
                </tr>
                <tr>
                    <th width="40%"><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                        'ttpay.tradeType')</th>
                    <th width="40%"><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                        'table.choProduct.productName')</th>
                    <th width="20%">#springMessage('common.table.thead.operation')</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
    </div>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="submitEvent" type="button">#springMessage(
                'common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/foreign/fexTranGroupRule.add.js?_btv=${resourceVersion}"></script>
</body>
</html>
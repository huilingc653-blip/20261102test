<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
        ##资金池
            <td class="textRight">#springMessage('nis.pool.fcCorpPool.pool')</td>
            <td>
                $!{fexCorpPoolTranPage.poolName}
            </td>
        </tr>
        <tr>
        ##资金池性质
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.poolNature')</td>
            <td>
                <div id="poolNature">$dictTag.get("fexCorpPool.poolNature",$!{fexCorpPoolTranPage.poolNature})</div>
            </td>
        </tr>
        <tr>
        ##银行账号
            <td class="textRight" width="30%">#springMessage('table.bisAccBal.bankAcc')</td>
            <td>
                $!{fexCorpPoolTranPage.bankAcc}
            </td>
        </tr>
        <tr>
        ##资金池主账号银行
            <td class="textRight" width="30%">
                #springMessage('nis.pool.fcCorpPool.pool')#springMessage('table.fexCorpPool.mainAccount')#springMessage(
                'common.button.bank')
            </td>
            <td>
                <div id="bankName">$!{fexCorpPoolTranPage.bankName}</div>
            </td>
        </tr>
        <tr>
        ##资金池主账号币种
            <td class="textRight" width="30%">
                #springMessage('nis.pool.fcCorpPool.pool')#springMessage('table.fexCorpPool.mainAccount')#springMessage(
                'contract.currency')
            </td>
            <td>
                <div id="englishCode">$!{fexCorpPoolTranPage.englishCode}</div>
            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight" width="30%">#springMessage('table.fcCorpPool.rmk')</td>
            <td>
                <textarea type="text" id="rmk" name="rmk" class="layui-textarea" readonly
                          placeholder="#springMessage(
                              'table.fcCorpPool.rmk')">$!{fexCorpPoolTranPage.poolRmk}</textarea>
            </td>
        </tr>
        </tbody>
    </table>
    ##借入外债交易
    <div class="layui-colla-item">
        <h2 class="layui-colla-title">#springMessage('table.fexCorpPoolTran.borrowing')</h2>##借入外债交易
        <div class="layui-colla-content layui-show">
            <table id="dataTable" class="layui-table" style="width:100%;">
                <thead>
                <tr>
                    <th>#springMessage('table.fexBankAcc.tranType')</th>##交易类型
                    <th>#springMessage('table.fexCorpPoolTran.product')</th>##产品
                </tr>
                </thead>
                <tbody>
                    #foreach($j in $fexCorpPoolTranPage.tranTypeJDtl)
                    <tr>
                        <td align="center">
                            <div class="layui-inline">
                                $dictTag.get("fexCorpPoolTran.tranType",$!{j.tranType})
                            </div>
                        </td>
                        <td align="center">
                            <div class="layui-inline">
                                $!{j.proName}
                            </div>
                        </td>
                    </tr>
                    #end
                </tbody>
            </table>
        </div>
        ##对外放款交易
        <div class="layui-colla-item">
            ##对外放款交易
            <h2 class="layui-colla-title">#springMessage('table.fexCorpPoolTran.Loan')</h2>##对外放款交易
            <div class="layui-colla-content layui-show">
                <table id="dataTable" class="layui-table" style="width:100%;">
                    <thead>
                    <tr>
                        <th>#springMessage('table.fexBankAcc.tranType')</th>##交易类型
                        <th>#springMessage('table.fexCorpPoolTran.product')</th>##产品
                    </tr>
                    </thead>
                    <tbody>
                        #foreach($w in $fexCorpPoolTranPage.tranTypeWDtl)
                        <tr>
                            <td align="center">
                                <div class="layui-inline">
                                    $dictTag.get("fexCorpPoolTran.tranType",$!{w.tranType})
                                </div>
                            </td>
                            <td align="center">
                                <div class="layui-inline">
                                    $!{w.proName}
                                </div>
                            </td>
                        </tr>
                        #end
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

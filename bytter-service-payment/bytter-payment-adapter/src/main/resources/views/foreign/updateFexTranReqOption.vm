								<td>
									<div class="bt-biz-selectType" data-url="${basePath}/foreign/fextrangroup/listTranGroup?tranType=$!{tranType}" data-name ="tranGroup" data-biz-name ="tranGroup"
										 data-valueField="id" data-textField="groupName" data-value="$!{fexTranReqPage.tranGroup}"></div>
								</td>
							</tr>
							<tr>
								##经纪人
								#if($!{fexTranReqPage.isShowAgent}=="1")
								<td class="textRight" width="20%" id="cotpAgentTitleTd">
								#else
								<td class="textRight" width="20%" id="cotpAgentTitleTd" style="display: none">
								#end
									#springMessage('table.fexTranReq.cotpAgent')
								</td>

								#if($!{fexTranReqPage.isShowAgent}=="1")
								<td width="20%" id="cotpAgentTd">
								#else
								<td width="20%" id="cotpAgentTd" style="display: none">
								#end
##									<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexCotp/listBankCotp?cotpType=07" data-name ="cotpAgent" data-biz-name ="cotpAgent"
##										 data-valueField="id" data-textField="cotpName" data-value="$!{fexTranReqPage.cotpAgent}"></div>
									<input type="text" id="cotpAgent" name="cotpAgent"
										   lay-verify="strlength" data-maxlength="32"
										   autocomplete="off" class="layui-input" value="$!{fexTranReqPage.cotpAgent}" placeholder="#springMessage('table.fexTranReq.cotpAgent')">
								</td>
								##清算所
								#if($!{fexTranReqPage.isShowClearHouse}=="1")
								<td class="textRight" width="20%" id="cotpClearHouseTitleTd">
								#else
								<td class="textRight" width="20%" id="cotpClearHouseTitleTd" style="display: none">
								#end
									#springMessage('table.fexForeign.cotpClearHouse')
								</td>
								#if($!{fexTranReqPage.isShowClearHouse}=="1")
								<td width="20%" id="cotpClearHouseTd">
								#else
								<td width="20%" id="cotpClearHouseTd" style="display: none">
								#end
##									<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexCotp/listBankCotp?cotpType=12" data-name ="cotpClearHouse" data-biz-name ="cotpClearHouse"
##										 data-valueField="id" data-textField="cotpName" data-value="$!{fexTranReqPage.cotpClearHouse}"></div>
									<input type="text" id="cotpClearHouse" name="cotpClearHouse"
										   lay-verify="strlength" data-maxlength="32"
										   autocomplete="off" class="layui-input" value="$!{fexTranReqPage.cotpClearHouse}" placeholder="#springMessage('table.fexForeign.cotpClearHouse')">
								</td>
								#if(($!{fexTranReqPage.isShowAgent}=="1" && $!{fexTranReqPage.isShowClearHouse}=="0")
								|| ($!{fexTranReqPage.isShowAgent}=="0" && $!{fexTranReqPage.isShowClearHouse}=="1"))
									<td id="blankTitleTd"></td>
									<td id="blankTd"></td>
								#else
									<td id="blankTitleTd" style="display: none"></td>
									<td id="blankTd" style="display: none"></td>
								#end
							</tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
			<div style="text-align: center; padding-top: 10px;">
				<button class="layui-btn" lay-submit="" lay-filter="submit" value="11" >#springMessage('common.button.submit')</button>
				<button class="layui-btn" lay-submit="" lay-filter="submit" value="0" >#springMessage('common.button.temp')</button>
				<button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage('common.button.reset')</button>
			</div>
			<!-- 资金计划 -->
			<div id="tagItemDetail"></div>
			<!-- 附件上传 -->
			<input id="attachmentId" name="attachmentId" type="hidden" value="$!{fexTranReqPage.attachmentId}">
			<div id="uploader" class="layui-input-inline" style="width:100%"></div>
		</div>
		<div class="layui-tab-item">
			<table id="appTable" class="layui-table layui-form" style="width:100%;">
				<thead>
				<tr>
					<th>#springMessage('table.fexTranReq.cashFlowDate')</th>
					<th>#springMessage('table.fcSubjectDay.optDate')</th>
					<th>#springMessage('table.fexBankAcc.cashFlowType')</th>
					<th>#springMessage('finacial.common.cashFlow.item')</th>
					<th>#springMessage('table.bisAccDtl.curName')</th>
					<th>#springMessage('table.choBankFinance.payMoney')</th>
					<th>#springMessage('table.nisBillhead.corpId')</th>
					<th>#springMessage('common.button.bank')</th>
					<th>#springMessage('table.btBankAccApp.accName')</th>
					<th>#springMessage('table.foreign.bankAcc')</th>
					<th>#springMessage('fex.cotp')</th>
					<th>#springMessage('table.fexTranReq.cotpBank')</th>
					<th>#springMessage('table.fexTranReq.cotpAccName')</th>
					<th>#springMessage('table.fexForeign.cotpAcc')</th>
					<th>#springMessage('table.foreign.voucherType')</th>
				</tr>
				</thead>
				<tr>
					##现金流日期
					<td align="center">$!{sysDate}</td>
					##结算日期
					<td align="center"><div id="srcSettleDateTd">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.premiumDate})</div></td>
					##现金流类型
					<td align="center"><div id="srcCashFlowTypeTd">$dictTag.get("fexCorp.cashFlowType","3")</div></td>
					##现金流项目
					<td align="center"><div id="srcCashItemTd">$!{fexTranReqPage.cashItemName}</div></td>
					##币种
					<td align="center"><div id="srcCurTd">$!{fexTranReqPage.englishCode}</div></td>
					##金额
					<td align="right">
						<div id="srcPayMoneyTd">
							#if($!{fexTranReqPage.premiumMoney})
								#if($!{fexTranReqPage.busDirection} == "1")
									-$!number.formatNumeric($!{fexTranReqPage.premiumMoney})
								#else
									$!number.formatNumeric($!{fexTranReqPage.premiumMoney})
								#end
							#end
						</div>
					</td>
					##单位
					<td align="center"><div id="srcCorpTd">$!{fexTranReqPage.corpName}</div></td>
					##银行
					<td align="center"><div id="srcBankTd">$!{fexTranReqPage.corpBankName}</div></td>
					##账户名称
					<td align="center"><div id="srcAccNameTd">$!{fexTranReqPage.corpAccName}</div></td>
					##银行账户
					<td align="center"><div id="srcBankAccTd">$!{fexTranReqPage.corpBankAcc}</div></td>
					##交易对手
					<td align="center"><div id="srcCotpTd">$!{fexTranReqPage.cotpName}</div></td>
					##交易对手银行
					<td align="center"><div id="srcCotpBankTd">$!{fexTranReqPage.cotpBankName}</div></td>
					##交易对手账户名称
					<td align="center"><div id="srcCotpAccNameTd">$!{fexTranReqPage.cotpAccName}</div></td>
					##交易对手银行账户
					<td align="center"><div id="srcCotpBankAccTd">$!{fexTranReqPage.cotpBankAcc}</div></td>
					##支付方式
					<td align="center"><div id="srcPayTypeTd">$!{fexTranReqPage.voucherTypeName}</div></td>
				</tr>
			</table>
		</div>
		<div class="layui-tab-item">
			<!-- 自定义信息 -->
			<div id="custMsg"></div>
		</div>
	</div>
</div>
#caDataHidden()
</form>
	#parse("views/common/footer.vm")
	#caDataScript()
</body>
</html>

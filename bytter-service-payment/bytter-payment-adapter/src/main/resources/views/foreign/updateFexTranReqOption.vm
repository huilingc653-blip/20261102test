<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
<input type="hidden" value="$!{fexTranReqPage.premiumCur}" id="defaulPremiumCur">
<form class="layui-form" method="post" id="inputForm">
<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
	<ul class="layui-tab-title">
		<li class="layui-this">#springMessage('table.rasBackQuery.msg')</li>
		<li>#springMessage('table.fexTranReq.cashFlow')</li>
		<li>#springMessage('fex.cotp.customInformation')</li>
	</ul>
	<div class="layui-tab-content">
		<div class="layui-tab-item layui-show">
			<input id="createBy" name="createBy" type="hidden" value="$!{fexTranReqPage.createBy}">
			<input id="createDate" name="createDate" type="hidden" value="$!{fexTranReqPage.createDate}">
			<input id="updateBy" name="updateBy" type="hidden" value="$!{fexTranReqPage.updateBy}">
			<input id="updateDate" name="updateDate" type="hidden" value="$!{fexTranReqPage.updateDate}">
			<input id="id" name="id" type="hidden" value="$!{fexTranReqPage.id}">
			<input id="custInfoBusId" type="hidden" value="$!{custInfoBusId}">
			<input id="tranType" name="tranType" type="hidden" value="$!{fexTranReqPage.tranType}">
			<input id="status" name="status" type="hidden" value="0">
			<input id="billNo" name="billNo" type="hidden" value="$!{fexTranReqPage.billNo}">
			<input id="tranAppDtlId" name="tranAppDtlId" type="hidden" value="$!{fexTranReqPage.tranAppDtlId}">
            <input id="tranAppDtlNo" name="tranAppDtlNo" type="hidden" value="$!{fexTranReqPage.tranAppDtlNo}">
			<input id="billFrom" name="billFrom" type="hidden" value="$!{fexTranReqPage.billFrom}"/>
            <!--固定金额 1-买入金额 2-卖出金额-->
            <input id="fixedMoney" name="fixedMoney" type="hidden" value="$!{fexTranReqPage.fixedMoney}">
			<!-- 系统参数 -->
			<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
			<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
			<!-- 资金计划参数 明细项控制模式-->
			<input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
			<input id="settlType" name="settlType" type="hidden" value="0">
			<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
			<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
            <!--买入方账户信息-->
			<!-- 主体单位账户信息 -->
			<input type="hidden" id="corpBank" name="corpBank" value="$!{fexTranReqPage.corpBank}">
			<input type="hidden" id="corpAccId" name="corpAccId" value="$!{fexTranReqPage.corpAccId}">
			#*<input type="hidden" id="corpBankAcc" name="corpBankAcc" value="$!{fexTranReqPage.corpBankAcc}">*#
			<input type="hidden" id="corpAccName" name="corpAccName" value="$!{fexTranReqPage.corpAccName}">
			<!-- 交易对手账户信息 -->
			<input type="hidden" id="cotpBank" name="cotpBank" value="$!{fexTranReqPage.cotpBank}">
			<input type="hidden" id="cotpAccId" name="cotpAccId" value="$!{fexTranReqPage.cotpAccId}">
			#*<input type="hidden" id="cotpBankAcc" name="cotpBankAcc" value="$!{fexTranReqPage.cotpBankAcc}">*#
			<input type="hidden" id="cotpAccName" name="cotpAccName" value="$!{fexTranReqPage.cotpAccName}">
            <!--卖出方账户信息-->
            <input type="hidden" id="srcBank" name="srcBank" value="$!{fexTranReqPage.srcBank}">
            <input type="hidden" id="srcAccId" name="srcAccId" value="$!{fexTranReqPage.srcAccId}">
            <input type="hidden" id="srcBankAcc" name="srcBankAcc" value="$!{fexTranReqPage.srcBankAcc}">
            <input type="hidden" id="srcAccName" name="srcAccName" value="$!{fexTranReqPage.srcAccName}">
            <input type="hidden" id="targetBank" name="targetBank" value="$!{fexTranReqPage.targetBank}">
            <input type="hidden" id="targetAccId" name="targetAccId" value="$!{fexTranReqPage.targetAccId}">
            <input type="hidden" id="targetBankAcc" name="targetBankAcc" value="$!{fexTranReqPage.targetBankAcc}">
            <input type="hidden" id="targetAccName" name="targetAccName" value="$!{fexTranReqPage.targetAccName}">
			<input id="cloneFlag" name="cloneFlag" type="hidden" value="$!{fexTranReqPage.cloneFlag}">
			<input id="rateTypeId" name="rateTypeId" type="hidden" value="$!{rateTypeId}">
			<input id="productBuyCurId" type="hidden" value="">
			#if($!{fexTranReqPage.cloneFlag} != "1")
			<table class="layui-table">
				<tbody>
				<tr>
					##交易号码
					<td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
					<td width="30%">$!{fexTranReqPage.billNo}</td>
					##交易需求编号
					<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAppDtlNo')</td>
					<td width="30%">$!{fexTranReqPage.tranAppDtlNo}</td>
				</tr>
				</tbody>
			</table>
			#end
			<div class="layui-collapse">
				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('cms.loan.oldInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##产品
								<td class="textRight" width="20%">#springMessage('table.foreign.product')</td>
								<td width="30%">
									<input type="hidden" id="proIdDef" value="$!{fexTranReqPage.proId}">
									#if($!{fexTranReqPage.tranAppDtlNo})
										$!{fexTranReqPage.proName}
										<div class="layui-input-inline ignore-required-icon" style="display: none">
									#else
										<div class="layui-input-inline">
									#end
										<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProduct/2" data-name ="proId" data-biz-name ="proId"
											 data-valueField="id" data-textField="proName" data-required = "true" data-callback="bt.proCallback" data-value="$!{fexTranReqPage.proId}">
										</div>
									</div>
								</td>
								##单位
								<td class="textRight" width="20%">#springMessage('table.nisBillhead.corpId')</td>
								<td>
									<input type="hidden" id="corpIdDef" name="corpIdDef" value="$!{fexTranReqPage.corpId}">
									<input type="hidden" id="corpCurId" value="$!{corpDTO.curId}"/>
									#if($!{fexTranReqPage.tranAppDtlNo})
										$!{fexTranReqPage.corpName}
									## <div class="layui-input-inline ignore-required-icon" style="display: none">
										<input type="hidden" id="corpId" name='corpId' value="$!{fexTranReqPage.corpId}" data-flag="readonly">
									#else
									<div class="layui-input-inline">
										<div class="bt-biz-corp"
											 data-biz-type="corp"
											 data-type="selectTree"
											 data-name="corpId"
											 data-biz-name="corpId"
											 data-scope="all"
											 data-resource="foreign:fextranreq:option:apply"
											 data-required="true"
											 data-callback="bt.corpCallback"
											 data-defaultvalue="$!{fexTranReqPage.corpId}"></div>
									</div>
									#end


								</td>
							</tr>
							<tr>
								##主体单位账号
								<td class="textRight" width="15%">#springMessage('table.fexTranReq.corpBankAcc')</td>
								<td width="30%">
									<input type="text" id="corpBankAcc" name="corpBankAcc" lay-verify="required|tableData" data-biz-name="corpBankAcc" value="$!{fexTranReqPage.corpBankAcc}"
										   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.corpBankAcc')" data-swapType="">
									<table id="corpBankAccTable" class="hide">
										<thead>
										<tr>
											<th>#springMessage('table.choBankFinance.acc')</th>
											<th>#springMessage('table.btBankAccApp.accName')</th>
											<th>#springMessage('table.btBankAcc.bankName')</th>
											<th>#springMessage('table.nisBillhead.curId')</th>
										</tr>
										</thead>
									</table>
								</td>
								##主体单位银行
								<td class="textRight" width="15%">#springMessage('table.fexTranReq.corpBank')</td>
								<td width="30%">
									<div id="corpBankNameDiv" name="corpBankNameDiv">$!{fexTranReqPage.corpBankName}</div>
								</td>
							</tr>
							<tr>
								##交易对手银行 02外部交易方
								<td class="textRight" width="20%">#springMessage('fex.tranApp.cotpBank')</td>
								<td width="30%">
##									<input type="hidden" id="cotpIdDef" name="cotpIdDef" value="$!{fexTranReqPage.cotpId}">
##									<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexCotp/listBankCotp?cotpType=02" data-name ="cotpId" data-biz-name ="cotpId"
##										 data-valueField="id" data-textField="cotpName" data-required = "true" data-callback="bt.cotpCallback" data-value="$!{fexTranReqPage.cotpId}"></div>
									<div class="layui-input-inline">
										<input type="hidden" id="oppId" name="oppId" value="$!{fexTranReqPage.oppId}" autocomplete="off" class="layui-input">
										<input type="hidden" id="cotpId" name="cotpId" value="$!{fexTranReqPage.cotpId}" autocomplete="off" class="layui-input">
										<input type="text" id="cotpName" name="cotpName" readonly="readonly" value="$!{fexTranReqPage.cotpName}" class="layui-input" lay-verify="required">
									##交易对手银行
										<div class="bt-div-search">
											<button class="bt-biz-allBankInfo" id="selCoptBankBut" type="button" data-callback="bt.cotpBankCallback" title="#springMessage('common.button.select')">
												<i class="layui-icon">&#xe615;</i>
											</button>
										</div>
									</div>
								</td>
								##波动率
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.volatility')</td>
								<td width="30%">
									<div class="layui-input-inline">
										<input type="text" id="volatility" name="volatility" data-biz-name="volatility" value="$!{fexTranReqPage.volatility}"
											   autocomplete="off" class="layui-input bt-biz-ratioType" placeholder="#springMessage('table.fexTranReq.volatility')">
									</div>
								</td>
							</tr>
							<tr>
								##交易对手银行账户
								<td class="textRight" width="15%">#springMessage('fex.cotp')#springMessage('table.fexForeign.bankAcc')</td>
								<td width="30%">
##									<div class="bt-biz-selectType" data-biz-name="cotpBankAcc" data-name="cotpBankAcc" data-callback="bt.cotpBankAccCallback"
##										 data-url="${basePath}/foreign/fexcotpbankacc/select?cotpId=$!{fexTranReqPage.cotpId}" data-required = "true" data-valuefield="bankAcc" data-textfield="bankAcc" data-value="$!{fexTranReqPage.cotpBankAcc}"></div>
									<input type="text" id="cotpBankAcc" name="cotpBankAcc"
										   lay-verify="strlength" data-maxlength="50"
										   autocomplete="off" class="layui-input" value="$!{fexTranReqPage.cotpBankAcc}"
										   placeholder="#springMessage('fex.cotp')#springMessage('table.fexForeign.bankAcc')">
								</td>
##								##交易对手银行
##								<td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpBank')</td>
##								<td width="30%">
##									<div id="cotpBankNameDiv" name="cotpBankNameDiv">$!{fexTranReqPage.cotpBankName}</div>
##								</td>
								##外汇期权品种
								<td class="textRight">#springMessage('table.fexProduct.fexOption')</td>
								<td>
									<input type="hidden" id="fexOption1" name="fexOption1" value="$!{fexTranReqPage.fexOption1}">
									<input type="hidden" id="fexOption2" name="fexOption2" value="$!{fexTranReqPage.fexOption2}">
									<input type="hidden" id="fexOption3" name="fexOption3" value="$!{fexTranReqPage.fexOption3}">
									<div id="fexOptionDiv" name="fexOptionDiv">
										$dictTag.get("fexProduct.fexOption1",$!{fexTranReqPage.fexOption1})&nbsp;
										$dictTag.get("fexProduct.fexOption2",$!{fexTranReqPage.fexOption2})&nbsp;
										$dictTag.get("fexProduct.fexOption3",$!{fexTranReqPage.fexOption3})
									</div>
								</td>
							</tr>
							<tr>
								##外汇期权类型
								<td class="textRight">#springMessage('table.fexProduct.fexOptionType')</td>
								<td>
									<input type="hidden" id="fexOptionType" name="fexOptionType" value="$!{fexTranReqPage.fexOptionType}">
									<div id="fexOptionTypeDiv" name="fexOptionTypeDiv">$dictTag.get("fexProduct.fexOptionType",$!{fexTranReqPage.fexOptionType})</div>
								</td>
								##交易货币对
								<td class="textRight">#springMessage('fex.tranApp.currencyPairs')</td>
								<td>
									<!--交易货币对左侧币种-->
									<input type="hidden" id="tranCurPairBaseId" name="tranCurPairBaseId" value="$!{fexTranReqPage.tranCurPairBaseId}">
									<!--交易货币对右侧币种-->
									<input type="hidden" id="tranCurPairReferId" name="tranCurPairReferId" value="$!{fexTranReqPage.tranCurPairReferId}">
									<div class="layui-input-inline">
										<div class="bt-biz-selectType" data-biz-name="tranCurPairId"
											 data-url="${basePath}/basic/business/btcurrencypair/json"
											 data-valuefield="id" data-textfield="pairCode"
											 data-name="tranCurPairId"
											 data-required = "true"
											 data-callback="bt.currencyPairCallback"
											 data-defaultvalue="$!{fexTranReqPage.tranCurPairId}"
											#if($!{fexTranReqPage.billFrom}=="1")
											 data-disabled="true"
											#end></div>
									</div>
								</td>
							</tr>
							<tr>
								##报价方式
								<td class="textRight">#springMessage('fex.tranApp.quotationMethod')</td>
								<td>
									<input id="quotationCurId" name="quotationCurId" type="hidden" value="$!{fexTranReqPage.quotationCurId}"/>
									<input id="quotationReferCurId" name="quotationReferCurId" type="hidden" value="$!{fexTranReqPage.quotationReferCurId}" }>
									<input id="quotationMethod" name="quotationMethod" type="hidden" value="$!{fexTranReqPage.quotationMethod}" }>
									<div id="quotationMethodText">$!{fexTranReqPage.quotationMethod}</div>
								</td>
								##持仓金额
								<td class="textRight">#springMessage('table.fexTranReq.positionMoney')</td>
								<td>
									<input type="text" id="positionMoney" name="positionMoney" style="text-align:right"  data-name="positionMoney" data-biz-name="positionMoney"
										   autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{fexTranReqPage.positionMoney}" readonly>
								</td>
							</tr>
							<tr>
								##买卖方向
								<td class="textRight">#springMessage('fex.tranApp2.businessDirection')</td>
								<td>
                                    <div class="layui-inline" id="busDirectionDiv">
										<input type="hidden" id="busDirectionDef" name="busDirectionDef" value="$!{fexTranReqPage.busDirection}">
									    <div class="bt-biz-dict" data-type="radio" data-group="fexTranDeal.deliverySign" data-defaultvalue="$!{fexTranReqPage.busDirection}"
											 data-name="busDirection" data-biz-name="busDirection" data-required = "true"
											 data-callback="bt.busDirectionCallback"
											#if($!{fexTranReqPage.billFrom}=="1")
											 data-disabled="true"
											#end></div>
                                    </div>
                                </td>
								##跌涨方向
								<td class="textRight">#springMessage('fex.tranApp2.upAndDownDirection')</td>
								<td >
                                    <div class="layui-inline" id="updownDirectionDiv">
									    <div class="bt-biz-dict" data-type="radio" data-group="fex.tranApp2.updownDirection"
											 data-defaultvalue="$!{fexTranReqPage.updownDirection}" data-name="updownDirection"
											 data-biz-name="updownDirection" data-required = "true"
											 data-callback="bt.updownDirectionCallback"
											#if($!{fexTranReqPage.billFrom}=="1")
											 data-disabled="true"
											#end></div>
                                    </div>
                                </td>
							</tr>
							<tr>
								##交割类型 0-现金、0-即期交易
								<td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
								<td>
									<div class="bt-biz-dict" data-type="radio" data-group="fexProduct.deliveryType" data-defaultvalue="$!{fexTranReqPage.deliveryType}" data-name="deliveryType" data-biz-name="deliveryType" data-required = "true"></div>
								</td>
								##障碍验证标准 0-即期汇率、1-即期汇率对应的货币价值
								<td class="textRight">
									#if($!{fexTranReqPage.fexOption2}=="2" || $!{fexTranReqPage.fexOption2}=="3")
									<div id="validStandardTdDiv">
									#else
									<div id="validStandardTdDiv" style="display: none">
									#end
										#springMessage('table.fexTranReq.validStandard')
									</div>
								</td>
								<td>
									#if($!{fexTranReqPage.fexOption2}=="2" || $!{fexTranReqPage.fexOption2}=="3")
									<div class="layui-input-inline" id="validStandardDiv">
									#else
									<div class="layui-input-inline" id="validStandardDiv" style="display: none">
									#end
										<div class="bt-biz-dict" data-type="radio" data-group="fexProduct.validStandard" data-defaultvalue="$!{fexTranReqPage.validStandard}" data-name="validStandard" data-biz-name="validStandard"
											#if($!{fexTranReqPage.fexOption2}=="2" || $!{fexTranReqPage.fexOption2}=="3")
											 data-required = "true"
											#end
										></div>
									</div>
								</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>

				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranAmountInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>

##							<tr>
##								<td></td>
##								<td colspan="3">
##									<input type="checkbox" name="autoCal" lay-filter = "autoCal" value="1"
##										#if(${fexTranReqPage.autoCal})
##										   checked="checked"
##										#end
##										   title="#springMessage('fex.tranApp.autoCal')" lay-skin="primary">
##								</td>
##							</tr>
							<tr>
								##执行汇率
								<td class="textRight" width="20%">#springMessage('fex.tranApp.executeExchangeRate')</td>
								<td>
									<input type="text" data-name="contractRate" data-biz-name="contractRate" data-decimal="6" lay-verify="required" data-callback="bt.contractRateCallback"
										   id="contractRate" autocomplete="off" value="$!{fexTranReqPage.contractRate}" class="layui-input bt-biz-moneyType"
										   placeholder="#springMessage('fex.tranApp.executeExchangeRate')"
										#if($!{fexTranReqPage.billFrom}=="1" && $!{fexTranReqPage.contractRate})
										   readonly="readonly"
										#end
									>
								</td>
								##即期汇率
								<td class="textRight" width="20%">#springMessage('table.fexTranDeal.wishRate')</td>
								<td>
									<input type="text" data-name="spotRate" data-biz-name="spotRate" data-decimal="6" value="$!{fexTranReqPage.spotRate}"
										   id="spotRate" autocomplete="off" class="layui-input bt-biz-moneyType"  placeholder="#springMessage('table.fexTranDeal.wishRate')" data-callback="spotRateCallback">
								</td>
							</tr>
							<tr>
								##金额是否自动计算
								<td class="textRight" width="20%">#springMessage('fex.tranApp.isAutoCalculate')</td>
								<td>
									<div class="layui-inline">
										<input type="radio" lay-filter="isPaymentAmount" name="isPaymentAmount" value="1" title="#springMessage('common.yes')" checked>
										<input type="radio" lay-filter="isPaymentAmount" name="isPaymentAmount" value="0" title="#springMessage('common.no')"  >
									</div>
								</td>
							</tr>
							<tr>
								##买入币种
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.buyCurId')</td>
								<td width="30%">
									<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="buyCurId" data-biz-name ="buyCurId"
										 data-valueField="id" data-textField="englishCode" data-required = "true" data-callback="bt.buyCurCallback" data-value="$!{fexTranReqPage.buyCurId}" data-disabled="true"></div>
								</td>
								##卖出币种
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.sellCurId')</td>
								<td width="30%">
									<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="sellCurId" data-biz-name ="sellCurId"
										 data-valueField="id" data-textField="englishCode" data-required = "true" data-callback="bt.sellCurCallback" data-value="$!{fexTranReqPage.sellCurId}" data-disabled="true"></div>
								</td>
							</tr>
							<tr>
								##买入金额
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.buyMoney')</td>
								<td width="30%">
									<input type="text" id="buyMoney" name="buyMoney" style="text-align:right" lay-verify="required|number2" data-name="buyMoney" data-biz-name="buyMoney" value="$!{fexTranReqPage.buyMoney}"

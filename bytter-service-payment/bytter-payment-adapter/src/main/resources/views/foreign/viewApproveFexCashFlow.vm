#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<!-- 系统参数 -->
<input id="id" name="id" type="hidden" value="$!{fexCashFlowPage.id}">

<ul class="mui-table-view" id="mulTable">
    ##现金流日期
    <li class="mui-table-view-cell">
        #springMessage('table.fexTranReq.cashFlowDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexCashFlowPage.cashFlowDate})
        </span>
    </li>
    ##交易类型
    <li class="mui-table-view-cell">
        #springMessage('ttpay.tradeType')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCashFlowPage.tranTypeName}
        </span>
    </li>
    ##产品
    <li class="mui-table-view-cell">
        #springMessage('table.fexBankAcc.proId')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCashFlowPage.proName}
        </span>
    </li>
    ##币种
    <li class="mui-table-view-cell">
        #springMessage('table.bisAccDtl.curName')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCashFlowPage.englishCode}
        </span>
    </li>
    ##金额
    <li class="mui-table-view-cell">
        #springMessage('table.choBankFinance.payMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{fexCashFlowPage.payMoney})
        </span>
    </li>
    ##结算日期
    <li class="mui-table-view-cell">
        #springMessage('table.fcSubjectDay.optDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fexCashFlowPage.settleDate})
        </span>
    </li>
    ##主体单位银行
    <li class="mui-table-view-cell">
        #springMessage('common.button.bank')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCashFlowPage.corpBankName}
        </span>
    </li>
    ##账户名称
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.accName')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCashFlowPage.corpAccName}
        </span>
    </li>
    ##主体单位银行账户
    <li class="mui-table-view-cell">
        #springMessage('table.foreign.bankAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCashFlowPage.corpBankAcc}
        </span>
    </li>
    ##交易对手
    <li class="mui-table-view-cell">
        #springMessage('fex.cotp')
        <span class="mui-badge mui-badge-inverted">
            #if($!{fexCashFlowPage.tranType} == "3")
                $!{fexCashFlowPage.allocatCotpName}
            #else
                $!{fexCashFlowPage.cotpName}
            #end
        </span>
    </li>
    ##交易对手银行
    <li class="mui-table-view-cell">
        #springMessage('table.fexTranReq.cotpBank')
        <span class="mui-badge mui-badge-inverted">
            #if($!{fexCashFlowPage.tranType} == "3")
                $!{fexCashFlowPage.allocatCotpBankName}
            #else
                $!{fexCashFlowPage.cotpBankName}
            #end
        </span>
    </li>
    ##交易对手账户名称
    <li class="mui-table-view-cell">
        #springMessage('table.fexTranReq.cotpAccName')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCashFlowPage.cotpAccName}
        </span>
    </li>
    ##交易对手银行账户
    <li class="mui-table-view-cell">
        #springMessage('table.fexForeign.cotpAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCashFlowPage.cotpBankAcc}
        </span>
    </li>
    ##现金流类型
    <li class="mui-table-view-cell">
        #springMessage('table.fexBankAcc.cashFlowType')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCashFlowPage.cashFlowTypeName}
        </span>
    </li>
    ##支付方式
    <li class="mui-table-view-cell">
        #springMessage('table.foreign.voucherType')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCashFlowPage.voucherTypeName}
        </span>
    </li>
    ##加急标志
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.isQuick')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCashFlowPage.isQuickName}
        </span>
    </li>
    ##备注
    <li class="mui-table-view-cell">
        #springMessage('bisAccAttribute.rmk')
        <span class="mui-badge mui-badge-inverted">
            $!{fexCashFlowPage.rmk}
        </span>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
<form class="layui-form" method="post">
<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
	<ul class="layui-tab-title">
		<li class="layui-this">#springMessage('table.rasBackQuery.msg')</li>
		<li>#springMessage('table.fexTranReq.cashFlow')</li>
		<li>#springMessage('fex.cotp.customInformation')</li>
	</ul>
	<div class="layui-tab-content">
		<div class="layui-tab-item layui-show">
			<input id="createBy" name="createBy" type="hidden" value="$!{fexTranReqPage.createBy}">
			<input id="createDate" name="createDate" type="hidden" value="$!{fexTranReqPage.createDate}">
			<input id="updateBy" name="updateBy" type="hidden" value="$!{fexTranReqPage.updateBy}">
			<input id="updateDate" name="updateDate" type="hidden" value="$!{fexTranReqPage.updateDate}">
			<input id="id" name="id" type="hidden" value="$!{fexTranReqPage.id}">
			<input id="tranType" name="tranType" type="hidden" value="$!{tranType}">
			<input id="status" name="status" type="hidden" value="0">
			<input id="billNo" name="billNo" type="hidden" value="$!{fexTranReqPage.billNo}">
			<!-- 系统参数 -->
			<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
			<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
			<!-- 资金计划参数 明细项控制模式-->
			<input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
			<input id="settlType" name="settlType" type="hidden" value="0">
			<input id="timeStamp" name="timeStamp" type="hidden" value="">
			<div class="layui-collapse">
			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
						<tr>
							##产品
							<td class="textRight" width="20%">#springMessage('table.foreign.product')</td>
							<td width="30%">
								<div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProduct/$!{tranType}" data-name ="proId" data-biz-name ="proId"
									 data-valueField="id" data-textField="proName" data-required = "true" data-callback="bt.proCallback"></div>
							</td>
							##汇款类型
							<td class="textRight" width="20%">#springMessage('table.fexForeignReq.remitType')</td>
							<td width="30%">
								<div class="bt-biz-dict" data-type="select" data-group="fexForeignReq.remitType" data-defaultvalue="" data-name="remitType" data-biz-name="remitType" data-required = "true" data-callback="bt.remitTypeCallback"></div>
							</td>
						</tr>
						</tbody>
					</table>
				</div>
			</div>

			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('table.fexTranReq.tranMainInfo')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
						<tr>
							<td rowspan="14" width="3%" align="center">#springMessage('table.nisAllocationReq.payerInfo')</td>
							##付款方-单位
							<td class="textRight" width="17%">#springMessage('table.fbsBudget.corpId')</td>
							<td width="30%">
								<div class="layui-input-inline">
									<div class="bt-biz-corp"
										 data-biz-type="corp"
										 data-type="selectTree"
										 data-name="corpId"
										 data-biz-name="corpId"
										 data-scope="all"
										 data-resource="foreign:fextranreq:allocation:apply"
										 data-required="true"
										 data-callback="bt.corpCallback"></div>
								</div>
							</td>
							<td rowspan="14" width="3%" align="center">#springMessage('table.nisAllocationReq.payeeInfo')</td>
							##收款方-单位
							<td class="textRight" width="17%">#springMessage('table.fbsBudget.corpId')</td>
							<td width="30%">
								<div class="layui-input-inline">
									<div class="bt-biz-corp"
										 data-biz-type="corp"
										 data-type="selectTree"
										 data-name="targetCorp"
										 data-biz-name="targetCorp"
										 data-scope="all"
										 data-required="true"
										 data-callback="bt.targetCorpCallback"></div>
								</div>
							</td>
						</tr>
						<tr>
							##付款方-银行账户
							<td class="textRight" width="17%">#springMessage('table.fexForeign.bankAcc')</td>
							<td width="30%">
								<div class="layui-input-inline">
									<input type="text" id="srcBankAcc" name="srcBankAcc" lay-verify="required|tableData" data-biz-name="srcBankAcc"
										   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexForeign.bankAcc')">
									<table id="srcBankAccTable" class="hide">
										<thead>
										<tr>
											<th>#springMessage('table.choBankFinance.acc')</th>
											<th>#springMessage('table.btBankAccApp.accName')</th>
											<th>#springMessage('table.btBankAcc.bankName')</th>
											<th>#springMessage('table.nisBillhead.curId')</th>
										</tr>
										</thead>
									</table>
								</div>
							</td>
							##收款方-银行账户
							<td class="textRight" width="17%">#springMessage('table.fexForeign.bankAcc')</td>
							<td width="30%">
								<div class="layui-input-inline">
									<input type="text" id="targetBankAcc" name="targetBankAcc" lay-verify="required|tableData" data-biz-name="targetBankAcc"
										   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexForeign.bankAcc')">
									<table id="targetBankAccTable" class="hide">
										<thead>
										<tr>
											<th>#springMessage('table.choBankFinance.acc')</th>
											<th>#springMessage('table.btBankAccApp.accName')</th>
											<th>#springMessage('table.btBankAcc.bankName')</th>
											<th>#springMessage('table.nisBillhead.curId')</th>
										</tr>
										</thead>
									</table>
								</div>
							</td>
						</tr>
						<tr>
							##付款方-账户名称
							<td class="textRight">#springMessage('table.btBankAccApp.accName')</td>
							<td>
								<input type="hidden" id="srcAccId" name="srcAccId" value="">
								<input type="hidden" id="srcAccName" name="srcAccName" value="">
								<div id="srcAccNameDiv" name="srcAccNameDiv"></div>
							</td>
							##收款方-账户名称
							<td class="textRight">#springMessage('table.btBankAccApp.accName')</td>
							<td>
								<input type="hidden" id="targetAccId" name="targetAccId" value="">
								<input type="hidden" id="targetAccName" name="targetAccName" value="">
								<div id="targetAccNameDiv" name="targetAccNameDiv"></div>
							</td>
						</tr>
						<tr>
							##付款方-账户币种
							<td class="textRight">#springMessage('table.fexForeign.cotpCurName')</td>
							<td>
								<input type="hidden" id="curId" name="curId" value="">
								<div id="curNameDiv" name="curNameDiv"></div>
							</td>
							##收款方-账户币种
							<td class="textRight">#springMessage('table.fexForeign.cotpCurName')</td>
							<td>
								<input type="hidden" id="targetAccCurId" name="targetAccCurId" value="">
								<div id="targetAccCurNameDiv" name="targetAccCurNameDiv"></div>
							</td>
						</tr>
                        <tr>
							##付款方-银行
							<td class="textRight" width="17%">#springMessage('common.button.bank')</td>
							<td width="30%">
								<input type="hidden" id="srcBank" name="srcBank" value="">
								<input type="hidden" id="srcIsDomesticBank" name="srcIsDomesticBank">
								<input type="hidden" id="srcCountryId" name="srcCountryId">
								<input type="hidden" id="srcBifCode" name="srcBifCode">
								<div id="srcBankNameDiv" name="srcBankNameDiv"></div>
							</td>
							##金额
							<td class="textRight" width="17%">#springMessage('table.internation.proceeds.money')</td>
							<td width="30%">
								<input type="text" id="payMoney" name="payMoney" style="text-align:right" lay-verify="required|number2" data-name="payMoney" data-biz-name="payMoney"
									   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.internation.proceeds.money')" data-callback="bt.payMoneyCallback">
							</td>
                        </tr>
						<tr>
							##汇款方式
							<td class="textRight">#springMessage('table.fexForeignReq.remitMethod')</td>
							<td>
								<div class="bt-biz-dict" data-type="select" data-group="fexForeignReq.remitMethod" data-defaultvalue="0" data-name="remitMethod" data-required = "true" data-callback="bt.remitTypeCallback"></div>
							</td>
							##收款人地址
							<td class="textRight">#springMessage('table.fexForeignReq.payeeAdd')</td>
							<td>
								<div id="targetAddrDiv" name="targetAddrDiv"></div>
							</td>
						<tr>
							##交易日期
							<td class="textRight">#springMessage('table.revenue.transTime')</td>
							<td >
								<input type="text" name="tranDate" lay-verify="required" class="layui-input bt-biz-dateType"
									   data-today="true"  data-type="date" data-name="tranDate" data-biz-name="tranDate">
							</td>
							##收款人所在国家地区&地点
							<td class="textRight" width="15%">#springMessage('table.fexTranReq.payeeCountry')&#springMessage('fex.cotp.place')</td>
							<td width="30%">
								<div class="layui-input-inline">
									<div class="bt-biz-selectType" data-callback="bt.cotpCountryCallBack" data-biz-name="cotpCountry" data-url="${basePath}/basic/business/syscountrycust/listSysCountryCust" data-valuefield="id" data-textfield="nameZh" data-name="cotpCountry"></div>
								</div>
								<div class="layui-input-inline" id="addressDiv">
									<div class="bt-biz-selectType" data-biz-name="cotpAddress" data-url="" data-valuefield="id" data-textfield="nameZh" data-name="cotpAddress"></div>
								</div>
								<div class="layui-input-inline" id="addrDiv" style="display: none">
									<div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="cotpProv" data-biz-name="cotpProv" data-change="cotpCity" data-defaultvalue="" data-callback="bt.provCallback"></div>
									<div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="cotpCity" data-biz-name="cotpCity" data-defaultvalue="" data-callback="bt.cityCallback"></div>
								</div>
							</td>
						</tr>
						<tr>
							##结算日期
							<td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
							<td >
								<input type="text" name="settleDate" lay-verify="required" class="layui-input bt-biz-dateType"
									   data-today="true" data-type="date" data-name="settleDate" data-biz-name="settleDate" data-callback="settleDateCallback">
							</td>
							##收款人类型
							<td class="textRight" id="payeeTypeTd"></td>
							<td>
								#*<div class="bt-biz-dict" data-type="select" data-group="fexForeignReq.payeeType"
									 data-name="payeeType" data-biz-name="payeeType" data-displayData="0,1,2,3,7"></div>*#
								<div class="payeeTypeDiv" class="layui-input-inline" style="display: none">
									<div class="bt-biz-selectType" data-url="" data-name="payeeType" data-biz-name="payeeType" data-beforeinit="customBeforeInit"
										 data-valuefield="customCode" data-textfield="customName" data-inputvalue="inputvalue" data-search="true"></div>
								</div>
							</td>
						</tr>
						<tr>
							##跨行标志
							<td class="textRight">#springMessage('table.nisBillhead.difBank')</td>
							<td>
								<div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.difBank" data-name="difBank" data-required = "true"></div>
							</td>
							##收款方-银行
							<td class="textRight" width="17%">#springMessage('common.button.bank')</td>
							<td width="30%">
								<input type="hidden" id="targetBank" name="targetBank" value="">
								<div id="targetBankNameDiv" name="targetBankNameDiv"></div>
							</td>
						</tr>
						<tr>
							##是否线下付款
							<td class="textRight">#springMessage('table.fexTranReq.isPayed')</td>
							<td>
								<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isPayed" data-biz-name="isPayed"data-required = "true"></div>
							</td>
							##收款方银行SWIFT CODE
							<td class="textRight">#springMessage('table.fexTranReq.payeeBankSwiftCode')</td>
							<td>
								<div id="targetBankCodeDiv" name="targetBankCodeDiv"></div>
							</td>
						</tr>
						<tr>
							##支付类型
							<td class="textRight" id="bankPayTypeTd"></td>
							<td>
								<div class="bankPayTypeDiv" class="layui-input-inline" style="display: none">
									<div class="bt-biz-selectType" data-url="" data-name="bankPayType" data-biz-name="bankPayType" data-beforeinit="customBeforeInit"
										 data-valuefield="customCode" data-textfield="customName" data-inputvalue="inputvalue" data-search="true" data-callback="bt.bankPayTypeCallback"></div>
								</div>
							</td>
							##本地清算号
							<td class="textRight">#springMessage('table.btswiftinfo.localClearNo')</td>
							<td><div id="localClearNoDiv" name="localClearNoDiv"></div></td>
						</tr>
						<tr>
							<td></td>
							<td></td>
							##代理行
							<td class="textRight">#springMessage('table.fexTranReq.agentBank')</td>
							<td>
##								<div class="bt-biz-selectType" data-biz-name="cotpBank"
##									 data-url="${basePath}/foreign/fexCotp/listBankCotp?cotpType=05" data-valuefield="id" data-textfield="cotpName" data-name="cotpBank"></div>
								<div class="layui-input-inline">
									<input type="text" id="cotpBank" name="cotpBank" readonly="readonly" class="layui-input">
								##交易对手银行
									<div class="bt-div-search">
										<button class="bt-biz-allBankInfo" id="selCoptBankBut" type="button" data-callback="bt.cotpBankCallback" data-beforeClick="bt.cotpBankBeforeClick" title="#springMessage('common.button.select')">
											<i class="layui-icon">&#xe615;</i>
										</button>
									</div>
								</div>
							</td>
						</tr>
						<tr>
							<td></td>
							<td></td>
							##收款人常驻国家或者地区
							<td class="textRight">#springMessage('table.fexTranReq.countryId')</td>
							<td>
								<div class="layui-input-inline">
									<input type="hidden" id="countryId" name="countryId" value="">
									<input type="text" id="nameZh" name="nameZh" lay-verify="required|tableData" data-biz-name="nameZh"
										   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.countryId')">
									<table id="countryTable" class="hide">
										<thead>
										<tr>
											<th>#springMessage('table.tbCreditPeriod.code')</th>
											<th>#springMessage('table.btswiftinfo.namezh')</th>
											<th>#springMessage('table.btswiftinfo.nameen')</th>
										</tr>
										</thead>
									</table>
								</div>
							</td>
						</tr>
						<tr>
							<td></td>
							<td></td>
							##开户行在代理行账户
							<td class="textRight">#springMessage('table.fexTranReq.agentBankAcc')</td>
							<td>
								<input type="text" id="agentBankAcc" name="agentBankAcc"
									   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.agentBankAcc')">
							</td>
						</tr>
						</tbody>
					</table>
				</div>
			</div>
			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('table.fexTranReq.costInfo')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
						<tr>
							##国内外费用承担标志 1-汇款人 OUR  2-收款人 BEN  3-共同 SHA
							<td class="textRight" width="20%">#springMessage('table.fexForeignReq.costSign')</td>
							<td colspan="3">
								<div class="bt-biz-dict" data-type="radio" data-group="fexForeignReq.costSign" data-name="costSign" data-biz-name="costSign" data-required = "true" data-callback="bt.costSignCallback"></div>
							</td>
						</tr>
						<tr>
							##费用支出账户
							<td class="textRight" width="20%">#springMessage('table.fexTranReq.costAcc')</td>
							<td width="30%">
								<div class="layui-input-inline">
									<input type="hidden" id="costAccId" name="costAccId" value="">
									<input type="text" id="costAcc" name="costAcc" lay-verify="required|tableData" data-biz-name="costAcc"
										   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.costAcc')">
									<table id="costAccTable" class="hide">
										<thead>
										<tr>
											<th>#springMessage('table.choBankFinance.acc')</th>
											<th>#springMessage('table.btBankAccApp.accName')</th>
											<th>#springMessage('table.btBankAcc.bankName')</th>
											<th>#springMessage('table.nisBillhead.curId')</th>
										</tr>
										</thead>
									</table>
								</div>
							</td>
							<td colspan="2">
								<div id="costAccDiv" style="display: none" class="ignore-required-icon">
									<div class="layui-input-inline">
										<input type="hidden" id="costAccId2" name="costAccId2" value="">
										<input type="text" id="costAcc2" name="costAcc2" lay-verify="tableData" data-biz-name="costAcc2"
											   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.costAcc')">
										<table id="costAcc2Table" class="hide">
											<thead>
											<tr>
												<th>#springMessage('table.choBankFinance.acc')</th>
												<th>#springMessage('table.btBankAccApp.accName')</th>
												<th>#springMessage('table.btBankAcc.bankName')</th>
												<th>#springMessage('table.nisBillhead.curId')</th>
											</tr>
											</thead>
										</table>
									</div>
								</div>
							</td>
						</tr>
						</tbody>
					</table>
				</div>
			</div>
			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('fex.fexTranReqPay.reportInfo')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
						<tr>
							##加急标志
							<td class="textRight">#springMessage('table.nisBillhead.isQuick')</td>
							<td>
								<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isQuick" data-biz-name="isQuick"data-required = "true"></div>
							</td>
							##交易地点
							<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAddr')</td>
							<td width="30%">
								<div class="layui-input-inline">
									<input id="tranAddrId" name="tranAddrId" type="hidden" value="">
									<input type="text" id="tranAddr" name="tranAddr" lay-verify="tableData" data-biz-name="tranAddr"
										   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.tranAddr')">
									<table id="tranAddrTable" class="hide">
										<thead>
										<tr>
											<th>#springMessage('table.tbCreditPeriod.code')</th>
											<th>#springMessage('table.btswiftinfo.namezh')</th>
											<th>#springMessage('table.btswiftinfo.nameen')</th>
										</tr>
										</thead>
									</table>
								</div>
							</td>
						</tr>
						<tr>
							##交易组
							<td class="textRight">#springMessage('table.fexTranReq.tranGroup')</td>
							<td>
								<div class="bt-biz-selectType" data-url="${basePath}/foreign/fextrangroup/listTranGroup?tranType=$!{tranType}" data-name ="tranGroup" data-biz-name ="tranGroup"
									 data-valueField="id" data-textField="groupName"></div>
							</td>
							##资金性质
							<td class="textRight">#springMessage('table.fexTranReq.accNature')</td>
							<td>
								<div class="bt-biz-dict" data-type="select" data-group="fexTranReq.accNature" data-defaultvalue="1" data-name="accNature" data-required = "true"></div>
							</td>
						</tr>
						<tr>
							##交易员
							<td class="textRight" width="20%">#springMessage('table.fexTranReq.dealer')</td>
							<td width="30%">
								<input type="text" id="dealer" name="dealer" data-required = "true" value="$!{dealer}" readonly="readonly"
									   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.dealer')">
							</td>
							##申请日期
							<td class="textRight" width="20%">#springMessage('table.bisFinanceExc.reqDate')</td>
							<td width="30%">$!{sysDate}</td>
						</tr>
						</tbody>
					</table>
				</div>
				<div class="layui-colla-item" id="otherInfoItemDiv" style="display: none">
					<h2 class="layui-colla-title">#springMessage('cms.loan.OtherInfo')</h2>
					<div class="layui-colla-content ignore-verify" id="otherInfoDiv">
						<table class="layui-table">
							<tbody>
							<tr>
								##资金用途
								<td class="textRight" width="20%" id="capitalUseTd">#springMessage('table.fexTranReq.capitalUse')</td>

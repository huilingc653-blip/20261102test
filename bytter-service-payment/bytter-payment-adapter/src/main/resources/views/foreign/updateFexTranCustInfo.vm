<table class="layui-table layui-form">
    #foreach($element in $custFields)
        #if($velocityCount % 2 == 0)
            <td class="textRight"  width="20%">
                $!{element.fieldName}
                <input type="hidden" name="fexTranCustInfos[$velocityCount].fieldId" value="$!{element.id}">
                <input type="hidden" name="fexTranCustInfos[$velocityCount].fieldName" value="$!{element.fieldName}">
            </td>
            <td width="30%">
                <div class="layui-input-inline">
                    #if($!{element.presetVal.indexOf(",")} > -1)
                        <select name="fexTranCustInfos[$velocityCount].fieldVal" lay-verify="required">
                            #foreach($option in $!{element.presetVal.split(",")})
                                <option value="$!{option}" #if($!{option} == $!{element.fieldVal}) selected="selected" #end>$!{option}</option>
                            #end
                        </select>
                    #else
                        #if($!{element.fieldType} == 1)
                        ##                                                        文本
                            <input type="text" class="layui-input" name="fexTranCustInfos[$velocityCount].fieldVal" style="display: inline" data-maxlength="500"
                                   value="$!{element.fieldVal}"
                                #if(${element.controlRule.indexOf("4")} > -1) lay-verify="required|strlength" #else lay-verify="strlength" #end
                                #if(${element.controlRule.indexOf("1")} > -1 && ${element.controlRule.indexOf("2")} < 0) readonly="readonly" #end
                                #if($!{element.controlRule.indexOf("3")} > -1) onblur="checkSrcVal(this)" #end
                            >
                        #elseif($!{element.fieldType} == 2)
                        ##                                                        数字
                            <input type="text" data-id="FexTranCustInfo$velocityCount" class="layui-input bt-biz-moneyType" name="fexTranCustInfos[$velocityCount].fieldVal" style="display: inline"
                                   value="$!{element.fieldVal}"
                                #if(${element.controlRule.indexOf("4")} > -1) lay-verify="required" #end
                                #if(${element.controlRule.indexOf("1")} > -1 && ${element.controlRule.indexOf("2")} < 0) readonly="readonly" #end
                                #if($!{element.controlRule.indexOf("3")} > -1) data-callback="checkNumSrcVal" #end
                                #if($!{element.minVal}) data-min="$!{element.minVal}" #end
                                #if($!{element.maxtVal}) data-max="$!{element.maxtVal}" #end
                                #if($!{element.decimalDigit}) data-decimal="$!{element.decimalDigit}" #end
                            >
                        #elseif($!{element.fieldType} == 3)
                        ##                                                        日期
                            <input type="text" class="layui-input bt-biz-dateType" data-id="FexTranCustInfo$velocityCount" data-type="date" name="fexTranCustInfos[$velocityCount].fieldVal" style="display: inline"
                                   value="$!{element.fieldVal}"
                                #if(${element.controlRule.indexOf("4")} > -1) lay-verify="required" #end
                                #if(${element.controlRule.indexOf("1")} > -1 && ${element.controlRule.indexOf("2")} < 0) readonly="readonly" #end
                                #if($!{element.controlRule.indexOf("3")} > -1) data-callback="checkDateSrcVal" #end
                            >
                        #elseif($!{element.fieldType} == 4)
                        ##                                                        时间
                            <input type="text" class="layui-input bt-biz-dateType" data-id="FexTranCustInfo$velocityCount" data-type="time" name="fexTranCustInfos[$velocityCount].fieldVal" style="display: inline"
                                   value="$!{element.fieldVal}"
                                #if(${element.controlRule.indexOf("4")} > -1) lay-verify="required" #end
                                #if(${element.controlRule.indexOf("1")} > -1 && ${element.controlRule.indexOf("2")} < 0) readonly="readonly" #end
                                #if($!{element.controlRule.indexOf("3")} > -1) data-callback="checkDateSrcVal" #end
                            >
                        #elseif($!{element.fieldType} == 5)
                        ##                                                        日期时间
                            <input type="text" class="layui-input bt-biz-dateType" data-id="FexTranCustInfo$velocityCount" data-type="datetime" name="fexTranCustInfos[$velocityCount].fieldVal" style="display: inline"
                                   value="$!{element.fieldVal}"
                                #if(${element.controlRule.indexOf("4")} > -1 ) lay-verify="required" #end
                                #if(${element.controlRule.indexOf("1")} > -1 && ${element.controlRule.indexOf("2")} < 0) readonly="readonly" #end
                                #if($!{element.controlRule.indexOf("3")} > -1) data-callback="checkDateSrcVal" #end
                            >
                        #end
                    #end
                    <span data-srcValue="$!{element.presetVal}" style="color: red;display: none">#springMessage('fex.cotp.custField.defaultValCkeck')</span>
                </div>
            </td>
            </tr>
        #else
        <tr>
            <td class="textRight" width="20%">
                $!{element.fieldName}
                <input type="hidden" name="fexTranCustInfos[$velocityCount].fieldId" value="$!{element.id}">
                <input type="hidden" name="fexTranCustInfos[$velocityCount].fieldName" value="$!{element.fieldName}">
            </td>
            <td width="30%">
                <div class="layui-input-inline">
                    #if($!{element.presetVal.indexOf(",")} > -1)
                        <select name="fexTranCustInfos[$velocityCount].fieldVal" lay-verify="required">
                            #foreach($option in $!{element.presetVal.split(",")})
                                <option value="$!{option}" #if($!{option} == $!{element.fieldVal}) selected="selected" #end>$!{option}</option>
                            #end
                        </select>
                    #else
                        #if($!{element.fieldType} == 1)
                        ##                                                        文本
                            <input type="text" class="layui-input" name="fexTranCustInfos[$velocityCount].fieldVal" style="display: inline" data-maxlength="500"
                                   value="$!{element.fieldVal}"
                                #if(${element.controlRule.indexOf("4")} > -1) lay-verify="required|strlength" #else lay-verify="strlength" #end
                                #if(${element.controlRule.indexOf("1")} > -1 && ${element.controlRule.indexOf("2")} < 0) readonly="readonly" #end
                                #if($!{element.controlRule.indexOf("3")} > -1) onblur="checkSrcVal(this)" #end
                            >
                        #elseif($!{element.fieldType} == 2)
                        ##                                                        数字
                            <input type="text" data-id="FexTranCustInfo$velocityCount" class="layui-input bt-biz-moneyType" name="fexTranCustInfos[$velocityCount].fieldVal" style="display: inline"
                                   value="$!{element.fieldVal}"
                                #if(${element.controlRule.indexOf("4")} > -1) lay-verify="required" #end
                                #if(${element.controlRule.indexOf("1")} > -1 && ${element.controlRule.indexOf("2")} < 0) readonly="readonly" #end
                                #if($!{element.controlRule.indexOf("3")} > -1) data-callback="checkNumSrcVal" #end
                                #if($!{element.minVal}) data-min="$!{element.minVal}" #end
                                #if($!{element.maxtVal}) data-max="$!{element.maxtVal}" #end
                                #if($!{element.decimalDigit}) data-decimal="$!{element.decimalDigit}" #end
                            >
                        #elseif($!{element.fieldType} == 3)
                        ##                                                        日期
                            <input type="text" class="layui-input bt-biz-dateType" data-id="FexTranCustInfo$velocityCount" data-type="date" name="fexTranCustInfos[$velocityCount].fieldVal" style="display: inline"
                                   value="$!{element.fieldVal}"
                                #if(${element.controlRule.indexOf("4")} > -1) lay-verify="required" #end
                                #if(${element.controlRule.indexOf("1")} > -1 && ${element.controlRule.indexOf("2")} < 0) readonly="readonly" #end
                                #if($!{element.controlRule.indexOf("3")} > -1) data-callback="checkDateSrcVal" #end
                            >
                        #elseif($!{element.fieldType} == 4)
                        ##                                                        时间
                            <input type="text" class="layui-input bt-biz-dateType" data-id="FexTranCustInfo$velocityCount" data-type="time" name="fexTranCustInfos[$velocityCount].fieldVal" style="display: inline"
                                   value="$!{element.fieldVal}"
                                #if(${element.controlRule.indexOf("4")} > -1) lay-verify="required" #end
                                #if(${element.controlRule.indexOf("1")} > -1 && ${element.controlRule.indexOf("2")} < 0) readonly="readonly" #end
                                #if($!{element.controlRule.indexOf("3")} > -1) data-callback="checkDateSrcVal" #end
                            >
                        #elseif($!{element.fieldType} == 5)
                        ##                                                        日期时间
                            <input type="text" class="layui-input bt-biz-dateType" data-id="FexTranCustInfo$velocityCount" data-type="datetime" name="fexTranCustInfos[$velocityCount].fieldVal" style="display: inline"
                                   value="$!{element.fieldVal}"
                                #if(${element.controlRule.indexOf("4")} > -1 ) lay-verify="required" #end
                                #if(${element.controlRule.indexOf("1")} > -1 && ${element.controlRule.indexOf("2")} < 0) readonly="readonly" #end
                                #if($!{element.controlRule.indexOf("3")} > -1) data-callback="checkDateSrcVal" #end
                            >
                        #end
                    #end
                    <span data-srcValue="$!{element.presetVal}" style="color: red;display: none">#springMessage('fex.cotp.custField.defaultValCkeck')</span>
                </div>
            </td>
            #if($foreach.last)
                <td></td>
                <td></td>
            </tr>
            #end
        #end
    #end
</table>
#if(!$!{hideCustInfoButtons})
    <div style="text-align: center; padding-top: 10px;">
        <button class="layui-btn" lay-submit="" lay-filter="submit" value="11" >#springMessage('common.button.submit')</button>
        <button class="layui-btn" lay-submit="" lay-filter="submit" value="0" >#springMessage('common.button.temp')</button>
        <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage('common.button.reset')</button>
    </div>
#end
<script>
    /**
     * 文本框非默认值检查
     * @param obj
     */
    function checkSrcVal(obj) {
        var span = $(obj).next("span");
        var val = span.attr("data-srcValue");
        if (obj.value != val) {
            span.css("display", "");
        } else {
            span.css("display", "none");
        }
    }

    /**
     * 数字非默认值检查
     * @param nextValue
     * @param elem
     * @param preValue
     */
    function checkNumSrcVal(nextValue , elem,preValue) {
        var span = elem.next("span");
        var val = span.attr("data-srcValue");
        if (nextValue != val) {
            span.css("display", "");
        } else {
            span.css("display", "none");
        }
    }

    /**
     * 日期非默认值检查
     * @param data
     * @param jqele
     */
    function checkDateSrcVal(data,ele) {
        var span = ele.next("span");
        var val = span.attr("data-srcValue");
        if (data != val) {
            span.css("display", "");
        } else {
            span.css("display", "none");
        }
    }
</script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	<style>
		.timeType .layui-input {
			width: 100%;
		}
	</style>
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fexExposureTemplatePage.id}">
		<input id="createBy" name="createBy" type="hidden" value="$!{fexExposureTemplatePage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{fexExposureTemplatePage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fexExposureTemplatePage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{fexExposureTemplatePage.updateDate}">
		<input id="templateCode" name="templateCode" type="hidden" value="$!{fexExposureTemplatePage.templateCode}">
		<table class="layui-table">
			<tbody >
			<tr>
				##模板名称
				<td class="textRight" width="20%">#springMessage('table.fexExposureTemplate.templateName')</td>
				<td width="30%">
					<input type="text" id="templateName" name="templateName" lay-verify="required|strlength" data-maxlength="100" value="$!{fexExposureTemplatePage.templateName}"
						   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexExposureTemplate.templateName')">
				</td>
				##有效标志 0 无效 1 有效
				<td class="textRight" width="20%">#springMessage('fcVoucherType.validSign')</td>
				<td width="30%">
					<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="$!{fexExposureTemplatePage.validSign}" data-required="true"
						 data-name="validSign" data-biz-name="validSign"></div>
				</td>
			</tr>
			<tr>
				##总填报周期
				<td class="textRight" width="20%">#springMessage('table.fexExposureTemplate.totalFillPeriod')</td>
				<td width="30%">
					<div class="layui-input-inline">
						<input type="text" style="width: 110px" name="totalFillPeriod" data-name="totalFillPeriod" data-biz-name="totalFillPeriod"lay-verify="required|number2"
							   autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" data-separator="" data-min="1"  data-max="99999" data-callback="bt.periodCallback" value="$!{fexExposureTemplatePage.totalFillPeriod}">
					</div>
					<div class="layui-input-inline">
						<div class="bt-biz-dict timeType" style="width: 100px" data-type="select" data-group="fexExposureTemplate.timeType" data-required="true"
							 data-name="totalFillUnit" data-biz-name="totalFillUnit" data-defaultvalue="$!{fexExposureTemplatePage.totalFillUnit}" data-callback="bt.totalFillUnitCallback"></div>
					</div>
				</td>
				##前面按周期填报，后续是否按年度填报 0-否 1-是
				<td class="textRight">#springMessage('table.fexExposureTemplate.isYearFill')</td>
				<td>
					<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{fexExposureTemplatePage.isYearFill}" data-required="true"
						 data-name="isYearFill" data-biz-name="isYearFill"></div>
				</td>
			</tr>
			<tr>
				##滚动总周期
				<td class="textRight">#springMessage('table.fexExposureTemplate.scrollFillPeriod')</td>
				<td>
					<div class="layui-input-inline">
						<input type="text" style="width: 110px" name="scrollFillPeriod" data-name="scrollFillPeriod" data-biz-name="scrollFillPeriod" lay-verify="required|number2"
							   autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0"  data-max="99999" data-separator="" data-callback="bt.periodCallback" value="$!{fexExposureTemplatePage.scrollFillPeriod}">
					</div>
					<div class="layui-input-inline">
						<div class="bt-biz-dict timeType" style="width: 100px" data-type="select" data-group="fexExposureTemplate.timeType" data-required="true"
						 data-name="scrollFillUnit" data-biz-name="scrollFillUnit" data-callback="bt.periodCallback" data-defaultvalue="$!{fexExposureTemplatePage.scrollFillUnit}"></div>
					</div>
				</td>
				##前面按周期填报，后续是否按总额填报 0-否 1-是
				<td class="textRight">#springMessage('table.fexExposureTemplate.isTotalFill')</td>
				<td>
					<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{fexExposureTemplatePage.isTotalFill}" data-required="true"
						 data-name="isTotalFill" data-biz-name="isTotalFill"></div>
				</td>
			</tr>
			<tr>
				##滚动分解子周期
				<td class="textRight">#springMessage('table.fexExposureTemplate.scrollResolvePeriod')</td>
				<td colspan="3">
					<div class="layui-input-inline">
					<input type="text" style="width: 110px" name="scrollResolvePeriod" data-name="scrollResolvePeriod" data-biz-name="scrollResolvePeriod" lay-verify="required|number2"
						   autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" data-max="99999" data-separator="" data-callback="bt.periodCallback" value="$!{fexExposureTemplatePage.scrollResolvePeriod}">
					</div>
					<div class="layui-input-inline">
						<div class="bt-biz-dict timeType" style="width: 100px" data-type="select" data-group="fexExposureTemplate.timeType" data-required="true"
						 data-name="scrollResolveUnit" data-biz-name="scrollResolveUnit" data-callback="bt.periodCallback" data-defaultvalue="$!{fexExposureTemplatePage.scrollResolveUnit}"></div>
					</div>
				</td>
			</tr>
			<tr>
				##模板科目
				<td class="textLeft" style="width: 5%; text-align: right">
					<span class="pl"><span class="required-icon">*</span></span>
					#springMessage('table.fexExposureTemplate.itemCode')
				</td>
				<td style="width: 95%" id="innerTree" colspan="3">
					<table class="layui-table" id="itemTable">
						<tbody>
							#foreach($data in $listItem)
							<tr data-tt-id="$!{data.itemCode}" data-tt-parent-id="$!{data.superItemCode}" data-id="$!{data.id}" >
								<td width="10px" align="center">
									<input type="checkbox" name="itemCodes" class="itemCodes"
										#foreach($item in $listItemCheck)
											#if($item.itemCode == $data.itemCode)
										   		checked="true"
											#end
										#end
										   lay-skin="primary" value="$!{data.itemCode}" lay-filter="itemCheck"/>&nbsp;&nbsp;&nbsp;&nbsp;
									<input type="hidden" name="itemId" id="itemId$!{data.itemCode}" value="$!{data.id}">
									<input type="hidden" name="itemName" id="itemName$!{data.itemCode}" value="$!{data.itemName}">
								</td>
								<td>    $!{data.itemName}&nbsp;&nbsp;($!{data.itemCode})</td>
							</tr>
							#end
						</tbody>
					</table>
					<div style="white-space: normal; word-break: break-all;">
						<span>#springMessage('table.fexExposureTemplate.checkItemInfo')</span>
						<span id="checkItemInfo"></span>
					</div>
				</td>
			</tr>
			<tr >
				<td colspan="4" style="text-align: center;">
					<button class="layui-btn all" lay-filter="checkall" type="button" id="checkAll">#springMessage('common.check.all')</button>
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexExposureTemplate.edit.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fexCashFlowPage.id}">
		<input id="opType" name="opType" type="hidden" value="$!{fexCashFlowPage.opType}">
		<input id="corpId" name="corpId" type="hidden" value="$!{fexCashFlowPage.corpId}">
		<input id="curId" name="curId" type="hidden" value="$!{fexCashFlowPage.curId}">
		<input id="cotpId" name="cotpId" type="hidden" value="$!{fexCashFlowPage.cotpId}">
		<input id="oppId" type="hidden" value="$!{fexCashFlowPage.oppId}">
		<input id="proId" type="hidden" value="$!{fexCashFlowPage.proId}">
		<input id="cotpAccId" name="cotpAccId" type="hidden" value="$!{cotpBankAcc.id}">
		<table class="layui-table">
			<tbody>
				<tr>
					##交易对手
    				<td class="textRight" width="40%">#springMessage('table.fexForeign.copt')</td>
                    <td width="60%">$!{fexCashFlowPage.cotpName}</td>
				</tr>
				<tr>
					##币种
					<td class="textRight" width="40%">#springMessage('table.bisAccDtl.curName')</td>
					<td width="60%">
						<input id="curId" name="curId" type="hidden" value="$!{fexCashFlowPage.curId}">
						$!{fexCashFlowPage.englishCode}
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.fexForeign.copt')#springMessage('table.foreign.bankAcc')</td>
					#*<td>
						<input type="hidden" id="cotpAccId" name="cotpAccId" value="$!{fexCashFlowPage.cotpAccId}">
						<input type="hidden" id="cotpAccName" name="cotpAccName" value="$!{fexCashFlowPage.cotpAccName}">
						<div class="bt-biz-selectType" data-biz-name="cotpBankAcc" data-name="cotpBankAcc" data-callback="bt.cotpBankAccCallback" data-value="$!{fexCashFlowPage.cotpBankAcc}"
							 data-url="${basePath}/foreign/fexcotpbankacc/select?cotpId=$!{fexCashFlowPage.cotpId}&curCode=$!{fexCashFlowPage.curId}" data-valuefield="bankAcc" data-textfield="bankAcc"
							#if($!{fexCashFlowPage.tranType} != "1")
							 data-required = "true"
							#end
						></div>
					</td>*#
					<td width="60%">
						<div class="layui-inline" id="externalDiv">## 交易对手银行组件
							#*<input type="hidden" id="cotpAccId" name="cotpAccId" value="$!{fexCashFlowPage.cotpAccId}">*#
							<input class="layui-input" id="cotpBankAcc" name="cotpBankAcc" readonly="readonly" type="text" value="$!{fexCashFlowPage.cotpBankAcc}"/>
							<div class="bt-div-search">
								<button type="button" class="bt-biz-allExternalBankAcc" data-beforeClick="bt.externalBankAccBeforeClick"  data-callback="externalBankAccCallback">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>
						</div>
					</td>
				</tr>
				<tr>
					##IBAN号
					<td class="textRight">#springMessage('common.button.bank')</td>
					<td>
						<input type="hidden" id="cotpBank" name="cotpBank" value="$!{fexCashFlowPage.cotpBank}">
						<div id="cotpBankNameDiv" name="cotpBankNameDiv">$!{fexCashFlowPage.cotpBankName}</div>
					</td>
				</tr>
				<tr>
					##账户名称
					<td class="textRight" width="40%">#springMessage('table.btBankAccApp.accName')</td>
					<td width="60%">
						<input type="hidden" id="cotpAccName" name="cotpAccName" value="$!{fexCashFlowPage.cotpAccName}">
						<div id="cotpAccNameDiv" name="cotpAccNameDiv">$!{fexCashFlowPage.cotpAccName}</div>
					</td>
				</tr>
				<tr>
					##备注
					<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
					<td >
						<textarea lay-verify="strlength" placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" style="width:100%" id="rmk" name="rmk" data-maxlength="200">$!{fexCashFlowPage.rmk}</textarea>
					</td>
				</tr>
				<tr>
					<td colspan="2" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
		<table class="layui-table">
			<thead>
			<tr>
				<th colspan="2">#springMessage('table.fexForeign.cotpBankInfo')</th> ##银行详细信息
				<th colspan="2">#springMessage('table.fexForeign.cotpTranBankInfo')</th> ##中转行信息
			</tr>
			</thead>
			<tbody>
			<tr>
				##银行
				<td class="textRight" width="20%">#springMessage('table.fexForeign.bank')</td>
				<td width="30%">
					<div id="bankIdDiv">$!{cotpBankAcc.bankName}</div>
					<input type="hidden" id="bankName" name="bankName">
				</td>
				##中转行
				<td class="textRight" width="20%">#springMessage('table.fexForeign.cotpTranBank')</td>
				<td width="30%">
					<div id="tranBankDiv">$!{cotpBankAcc.tranBank}</div>
					<input type="hidden" id="tranBank" name="tranBank">
				</td>
			</tr>
			<tr>
				##BIC Code
				<td class="textRight" width="20%">#springMessage('table.fexForeign.bicCode')</td>
				<td width="30%">
					<div id="bicCodeDiv">$!{cotpBankAcc.bicCode}</div>
					<input type="hidden" id="bicCode" name="bicCode">
				</td>
				##中转行BIC Code
				<td class="textRight" width="20%">#springMessage('table.fexForeign.bicCode')</td>
				<td width="30%">
					<div id="tranBicCodeDiv">$!{cotpBankAcc.tranBicCode}</div>
					<input type="hidden" id="tranBicCode" name="tranBicCode">
				</td>
			</tr>
			<tr>
				##支付类型
				<td class="textRight" width="20%">#springMessage('table.fexForeign.payType')</td>
				<td width="30%">
					<div id="payTypeDiv">$dictTag.get("fexCotp.payType",$!{cotpBankAcc.payType})</div>
					<input type="hidden" id="payType" name="payType">
				</td>
				##中转行地址
				<td class="textRight" width="20%">#springMessage('table.fexForeign.addr')</td>
				<td width="30%">
					<div id="tranBankAddrDiv">$!{cotpBankAcc.tranBankAddr}</div>
					<input type="hidden" id="tranBankAddr" name="tranBankAddr">
				</td>
			</tr>
			<tr>
				##在中转行的银行账户
				<td class="textRight" width="20%">#springMessage('table.fexForeign.tranBankAcc')</td>
				<td width="30%">
					<div id="tranBankAccDiv">$!{cotpBankAcc.tranBankAcc}</div>
					<input type="hidden" id="tranBankAcc" name="tranBankAcc">
				</td>
				<td class="textRight" width="20%"></td>
				<td width="30%"></td>
			</tr>
			<tr>
				##地址
				<td class="textRight" width="20%">#springMessage('table.fexForeign.addr')</td>
				<td width="30%">
					<div id="bankAddrDiv">$!{cotpBankAcc.bankAddr}</div>
					<input type="hidden" id="bankAddr" name="bankAddr">
				</td>
				<td class="textRight" width="20%"></td>
				<td width="30%"></td>
			</tr>
			<tr>
				##银行信息备注
				<td class="textRight" width="20%">#springMessage('table.fexForeign.bankRmk')</td>
				<td width="30%">
					<div id="bankRmkDiv">$!{cotpBankAcc.bankRmk}</div>
					<input type="hidden" id="bankRmk" name="bankRmk">
				</td>
				<td class="textRight" width="20%"></td>
				<td width="30%"></td>
			</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexCashFlow.edit.js?_btv=${resourceVersion}"></script>
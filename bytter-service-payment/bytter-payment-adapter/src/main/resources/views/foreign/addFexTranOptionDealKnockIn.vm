<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{fexTranOptionDealPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{fexTranOptionDealPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fexTranOptionDealPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{fexTranOptionDealPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{fexTranOptionDealPage.id}">
		<input id="tranReqId" name="tranReqId" type="hidden" value="$!{fexTranOptionDealPage.tranReqId}">
		<input id="corpId" name="corpId" type="hidden" value="$!{fexTranOptionDealPage.corpId}">
		<input id="opType" name="opType" type="hidden" value="$!{fexTranOptionDealPage.opType}">
		<input id="tranSettleMethod" name="tranSettleMethod" type="hidden" value="$!{fexTranOptionDealPage.tranSettleMethod}">
		<input id="curId" name="curId" type="hidden" value="$!{fexTranOptionDealPage.curId}">
		<table class="layui-table">
			<tbody>
				<tr>
					##敲入日期
					<td class="textRight">#springMessage('table.fexTranOptionDeal.knockInDate')</td>
					<td >
						#if($!{fexTranOptionDealPage.id}=="")
							<input type="text" id="opDate" name="opDate" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{fexTranOptionDealPage.opDate}"
								   data-today="true" data-type="date" data-name="opDate" data-biz-name="opDate">
						#else
							$!date.format('yyyy-MM-dd',$!{fexTranOptionDealPage.opDate})
						#end
					</td>
				</tr>
				<tr>
					##市场汇率
					<td class="textRight" width="40%">#springMessage('table.fexTranOptionDeal.marketRate')</td>
					<td colspan="3">
						#if($!{fexTranOptionDealPage.id}=="")
							<input type="text" data-name="marketRate" data-biz-name="marketRate" data-decimal="6" lay-verify="required" value="$!{fexTranOptionDealPage.marketRate}"
								   id="marketRate" autocomplete="off" class="layui-input bt-biz-moneyType"  placeholder="#springMessage('table.fexTranOptionDeal.marketRate')">
						#else
							$!number.formatDoubles($!{fexTranOptionDealPage.marketRate},6)
						#end
					</td>
				</tr>
				<tr>
					##交易员
					<td class="textRight" width="40%">#springMessage('table.fexTranReq.dealer')</td>
					<td width="60%">
						#if($!{fexTranOptionDealPage.id}=="")
							<input type="text" id="dealer" name="dealer" data-required = "true" value="$!{dealer}" readonly="readonly"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.dealer')">
						#else
							$!{dealer}
						#end
					</td>
				<tr>
					##备注
					<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
					<td>
						#if($!{fexTranOptionDealPage.id}=="")
							<textarea placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" style="width:100%" id="rmk" name="rmk" >$!{fexTranOptionDealPage.rmk}</textarea>
						#else
							$!{fexTranOptionDealPage.rmk}
						#end
					</td>
				</tr>
        	</tbody>
        </table>
		#if($!{fexTranOptionDealPage.id}=="")
			<div style="text-align: center; padding-top: 10px;">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</div>
		#end
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexTranOptionDeal.add.js?_btv=${resourceVersion}"></script>
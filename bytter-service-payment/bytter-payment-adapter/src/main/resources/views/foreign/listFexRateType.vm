<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##名称
                    <td class="textRight">#springMessage('bill.accebill.name')</td>
                    <td>
                        <input type="text" name="likes_typeName"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('bill.accebill.name')">
                    </td>
                </tr>
                <tr>
                    <td colspan="4" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('bill.accebill.name')</th>
            <th>#springMessage('table.type.interface.name')</th>
            <th>#springMessage('table.type.interface')</th>
            <th>#springMessage('table.bvStorageBox.validSign')</th>
            <th>#springMessage('bill.accebill.abbillcollectionapply.rmk')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
</html>
<script>
    var datatable;
    bt.use(['form', 'datatable', 'select', 'dateType', 'corp', 'money', 'moneyType', 'dicts', 'btImport', 'bank', 'selectType','element'], function () {
        $ = bt.jquery, form = bt.form();
        bt.corp.init();
        bt.moneyType.init();
        bt.dateType.init();
        bt.selectType.init();
        bt.dicts.init();

        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            checkbox: false,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath + "/foreign/fexratetype/datatable"
            },
            buttons: [
                {
                    hide: bt.isnotResource('foreign:fexratetype:apply'),
                    text: bt.lang('common.button.add'),
                    action: function (e, dt, node, config) {
                        add();
                    }
                }, {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ],
            fixedColumns: {
                rightColumns: 1//代表冻结右边一列
            },
            columns: [
                {data: "typeName", bSortable: true, className: 'center'},
                {data: "rateInterfaceType", bSortable: true, className: 'center',
                    render: function (data, type, full, meta) {
                        return bt.dict("fex.rate.interface.type", data);
                    }
                },
                {data: "bifCodeName", bSortable: true, className: 'center',},
                {data: "validSign", bSortable: true, className: 'center',
                    render: function (data, type, full, meta) {
                        return bt.dict("valid_sign", full.validSign);
                    }
                },
                {data: "rmk", bSortable: true, className: 'center'},
                {
                    data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
                        var html = '';
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="update(this)">' + bt.lang("common.button.edit") + '</a><span class="text-explode">|</span>';
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="deleteColumn(this)">' + bt.lang("common.button.delete") + '</a><span class="text-explode">|</span>';
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a>';
                        return html;
                    }
                }
            ],
        });
    });

    function add() {
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.add.data'), basePath + "/foreign/fexratetype/add");
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/foreign/fexforeignreq/add",
            end: function () {
                datatable && datatable.draw();
            }
        });
    }

    function view(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/foreign/fexratetype/view/" + data.id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['950px', '530px'],
            maxmin: true,
            content: basePath + "/foreign/fexforeignreq/view/" + data.id
        });
    }

    function update(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (data) {
            if (bt.navtab) {
                bt.navtab.addNavtab(bt.lang('common.update.data'), basePath + "/foreign/fexratetype/update?id=" + data.id);
                return;
            }
            parent.layer.open({
                type: 2,
                area: ['850px', '530px'],
                maxmin: true,
                content: basePath + "/foreign/fexratetype/update?id=" + data.id,
                end: function () {
                    datatable && datatable.draw();
                }
            });
        }
    }

    function deleteColumn(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        parent.layer.confirm(bt.lang('common.message.confirm.delete'), function () {
            $.post(basePath + "/foreign/fexratetype/delete/" + data.id, function (result) {
                datatable && datatable.draw();
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, 'JSON');
        });
    }
</script>

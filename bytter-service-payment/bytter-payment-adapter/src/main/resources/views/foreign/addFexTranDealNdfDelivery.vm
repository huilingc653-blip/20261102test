<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{fexTranDealPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{fexTranDealPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fexTranDealPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{fexTranDealPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{fexTranDealPage.id}">
		<input id="tranReqId" name="tranReqId" type="hidden" value="$!{fexTranDealPage.tranReqId}">
		<input id="corpId" name="corpId" type="hidden" value="$!{fexTranDealPage.corpId}">
		<input id="opType" name="opType" type="hidden" value="$!{fexTranDealPage.opType}">
		<input id="status" name="status" type="hidden" value="$!{fexTranDealPage.status}">
		<table class="layui-table">
			<tbody>
				<tr>
					##交割汇率
    				<td class="textRight" width="20%">#springMessage('table.fexTranDeal.deliveryRate')</td>
                    <td colspan="3">
					#if($!{fexTranDealPage.status}=="0" || $!{fexTranDealPage.status}=="-1")
						<input type="text" data-name="deliveryRate" data-biz-name="deliveryRate" data-decimal="6" lay-verify="required" value="$!{fexTranDealPage.deliveryRate}"
							   id="deliveryRate" autocomplete="off" class="layui-input bt-biz-moneyType"  placeholder="#springMessage('table.fexTranDeal.deliveryRate')">
					#else
						$!number.formatDoubles($!{fexTranDealPage.deliveryRate}, 6)
					#end
    				</td>
				</tr>
				<tr>
					##结算币种
					<td class="textRight" width="20%">#springMessage('table.fexTranDeal.settleCurId')</td>
					<td width="30%">
						<input type="hidden" id="curId" name="curId" value="$!{fexTranDealPage.curId}">$!{fexTranDealPage.englishCode}
					</td>
					##结算金额
					<td class="textRight" width="20%">#springMessage('table.fexTranDeal.settleMoney')</td>
					<td width="30%">
						#if($!{fexTranDealPage.status}=="0" || $!{fexTranDealPage.status}=="-1")
							<input type="text" id="settleMoney" name="settleMoney" style="text-align:right" lay-verify="required" data-name="settleMoney" data-biz-name="settleMoney" data-minus="true"
								   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranDeal.settleMoney')" value="$!{fexTranDealPage.settleMoney}">
						#else
							$!number.formatNumeric($!{fexTranDealPage.settleMoney})
						#end
					</td>
				</tr>
				<tr>
					##交割确定日期
					<td class="textRight">#springMessage('table.fexTranDeal.deliveryDate')</td>
					<td >
						#if($!{fexTranDealPage.status}=="0" || $!{fexTranDealPage.status}=="-1")
							<input type="text" name="deliveryDate" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{fexTranDealPage.deliveryDate}"
								   data-today="true" data-type="date" data-name="deliveryDate" data-biz-name="deliveryDate" data-endid="newSettleDate">
						#else
							$!date.format('yyyy-MM-dd',$!{fexTranDealPage.deliveryDate})
						#end
					</td>
					##结算日期
					<td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
					<td >
						#if($!{fexTranDealPage.status}=="0" || $!{fexTranDealPage.status}=="-1")
							<input type="text" id="newSettleDate" name="newSettleDate" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{fexTranDealPage.newSettleDate}"
								   data-today="true" data-type="date" data-name="newSettleDate" data-biz-name="newSettleDate">
						#else
							$!date.format('yyyy-MM-dd',$!{fexTranDealPage.newSettleDate})
						#end
					</td>
				</tr>
				<tr>
					##交易员
					<td class="textRight" width="20%">#springMessage('table.fexTranReq.dealer')</td>
					<td width="30%">
						#if($!{fexTranDealPage.status}=="0" || $!{fexTranDealPage.status}=="-1")
							<input type="text" id="dealer" name="dealer" data-required = "true" value="$!{dealer}" readonly="readonly"
								   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.dealer')">
						#else
							$!{dealer}
						#end
					</td>
					##交易地点
					<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAddr')</td>
					<td width="30%">
						#if($!{fexTranDealPage.status}=="0" || $!{fexTranDealPage.status}=="-1")
							<div class="layui-input-inline">
								<input id="tranAddrId" name="tranAddrId" type="hidden" value="$!{fexTranDealPage.tranAddrId}">
								<input type="text" id="tranAddr" name="tranAddr" lay-verify="tableData" data-biz-name="tranAddr" value="$!{fexTranDealPage.tranAddr}"
									   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.tranAddr')">
								<table id="tranAddrTable" class="hide">
									<thead>
									<tr>
										<th>#springMessage('table.tbCreditPeriod.code')</th>
										<th>#springMessage('table.btswiftinfo.namezh')</th>
										<th>#springMessage('table.btswiftinfo.nameen')</th>
									</tr>
									</thead>
								</table>
							</div>
						#else
							$!{fexTranDealPage.tranAddr}
						#end
					</td>
				</tr>
				<tr>
					##备注
					<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
					<td colspan="3">
						#if($!{fexTranDealPage.status}=="0" || $!{fexTranDealPage.status}=="-1")
							<textarea placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" style="width:100%" id="rmk" name="rmk" >$!{fexTranDealPage.rmk}</textarea>
						#else
							$!{fexTranDealPage.rmk}
						#end
					</td>
				</tr>
        	</tbody>
        </table>
		#if($!{fexTranDealPage.status}=="0" || $!{fexTranDealPage.status}=="-1")
			<div style="text-align: center; padding-top: 10px;">
				<button class="layui-btn" lay-submit="" lay-filter="submit" value="11" >#springMessage('common.button.submit')</button>
				<button class="layui-btn" lay-submit="" lay-filter="submit" value="0" >#springMessage('common.button.temp')</button>
				#if($!{fexTranDealPage.id})
					<button class="layui-btn" lay-submit="" type="button" onclick="delTranDeal()" >#springMessage('common.button.delete')</button>
				#end
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</div>
		#else
			<div class="layui-form-item layui-form-submit" id="buttonDiv">
				<div class="layui-input-block">
					<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{fexTranDealPage.id}')">#springMessage('common.button.trackFlow')</button>
					<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
				</div>
			</div>
		#end
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexTranDealNdfDelivery.add.js?_btv=${resourceVersion}"></script>
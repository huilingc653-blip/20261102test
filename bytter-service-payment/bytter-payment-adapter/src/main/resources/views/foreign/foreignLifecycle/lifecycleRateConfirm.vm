<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <input id="id" name="id" type="hidden" value="$!{vo.id}">
    <input type="hidden" name = "opType" value="12">
    <input id="corpId" name="corpId" type="hidden" value="$!{fexTranReq.corpId}">
    <input id="reqId" name="reqId" type="hidden" value="$!{fexTranReq.id}">
    <input id="status" type="hidden" value="0">
    <input id="fixedMoney" type="hidden" value="$!{fexTranReq.fixedMoney}">
    <input id="tranType"  type="hidden" value="$!{fexTranReq.tranType}">
    <input type="hidden" id ="fexTranType"  value="$!{fexTranReq.fexTranType}">
    <input type="hidden"  id="isSwapTran"  value="$!{fexTranReq.isSwapTran}">
    <input type="hidden" id="isSpotProfitAndLoss" value="$!{isProfitAndLoss}">
    <input type="hidden" id="isShowConvert" value="$!{isShowConvert}">
    <!-- 主体单位账户信息 -->
    <input type="hidden" id="corpBank" value="$!{fexTranReq.corpBank}">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.contractInfo')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                        <tr>
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
                            <td width="30%">
                                <a class="" href="#" onclick="viewBill('$!{fexTranReq.id}')">
                                    $!{fexTranReq.billNo}
                                </a>
                            </td>
                            <td class="textRight" width="20%">#springMessage('table.fcSubjectDay.optDate')</td>
                            <td>
                                $!date.format('yyyy-MM-dd',$!{fexTranReq.settleDate})
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight" width="20%">#springMessage('fex.tranApp.currencyPairs')</td>
                            <td width="30%">
                                $!{fexTranReq.tranCurPairIdName}
                                <input id="tranCurPairBaseId" name="tranCurPairBaseId" type="hidden" value="$!{fexTranReq.tranCurPairBaseId}">
                                <input id="tranCurPairReferId" name="tranCurPairReferId" type="hidden" value="$!{fexTranReq.tranCurPairReferId}">
                            </td>
                            <td class="textRight" width="20%">#springMessage('fex.tranApp2.businessDirection')</td>
                            <td width="30%">
                                $dictTag.get("fexTranDeal.deliverySign",${fexTranReq.busDirection})
                                <input type="hidden" id="busDirection" value="$!{fexTranReq.busDirection}">
                            </td>
                        </tr>
                        <tr>
                            ##报价方式
                            <td class="textRight" width="20%">#springMessage('fex.tranApp.quotationMethod')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    $!{fexTranReq.quotationMethod}
                                    <input type="hidden" id="quotationMethod" name="quotationMethod" value="$!{fexTranReq.quotationMethod}" />
                                    <input id="quotationCurId" name="quotationCurId" type="hidden" value="$!{fexTranReq.quotationCurId}">
                                    <input id="quotationReferCurId" name="quotationReferCurId" type="hidden" value="$!{fexTranReq.quotationReferCurId}">
                                </div>
                            </td>
                            ##持仓金额
                            #*<td class="textRight" width="20%">#springMessage('table.fexTranReq.positionMoney')</td>
                            <td width="30%">
                                <input class="layui-input bt-biz-moneyType" readonly name="positionMoney" data-biz-name="positionMoney" value="$!{vo.positionMoney}">
                            </td>*#
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.info')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.billNo')</td>
                        <td width="30%">
                            $!{vo.billNo}
                        </td>
                        <td class="textRight" width="20%">#springMessage('table.nisMessage.messageType')</td>
                        <td width="30%">
                            $dictTag.get("fexProduct.lifeCycle",${vo.opType})
                            <div class="layui-input-inline">
                                <input type="hidden" id="opType" name="opType" value="$!{vo.opType}"/>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight" width="20%">#springMessage('table.nisMessage.enrolDate')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" name="opDate" lay-verify="required" class="layui-input bt-biz-dateType"
                                       value="$!date.format('yyyy-MM-dd',$!{vo.opDate})" data-today="true"  data-type="date"
                                       data-name="opDate" data-biz-name="opDate" data-min="$!{fexTranReq.tranDate}" data-max="$!{fexTranReq.settleDate}">
                            </div>
                        </td>
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.contractRate')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" data-name="contractRate" data-biz-name="contractRate" data-decimal="6" lay-verify="required" data-callback="bt.contractRateCallback"
                                       id="contractRate" autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{fexTranReq.contractRate}">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##  金额是否自动计算
                        <td class="textRight" width="20%">#springMessage('fex.tranApp.isAutoCalculate')</td>
                        <td width="30%">
                            <div class="bt-biz-dict" data-type="radio"
                                 data-group="fexTranDeal.isAutoCalculate" data-required="true" data-name="isPaymentAmount"
                                 data-biz-name="isPaymentAmount" data-callback="bt.isAutoCalculateCallBack" data-defaultvalue="$!{fexTranReq.isPaymentAmount}"></div>
                        </td>
                        ##固定金额
                        <td class="textRight" width="20%"><div>#springMessage('fex.tranApp.FixedAmount')</div></td>
                        <td width="30%">
                            $dictTag.get("fex.tranApp.fixMoney",${fexTranReq.fixedMoney})
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.buyCurId')</td>
                        <td width="30%">
                            $!{fexTranReq.buyEnglishCode}
                            <input type="hidden" id="buyEnglishCode" value="$!{fexTranReq.buyEnglishCode}" />
                            <input type="hidden" id="buyCurId" name="buyCurId" value="$!{fexTranReq.buyCurId}"/>
                        </td>
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.sellCurId')</td>
                        <td width="30%">
                            $!{fexTranReq.sellEnglishCode}
                            <input type="hidden" id="sellEnglishCode" value="$!{fexTranReq.sellEnglishCode}"/>
                            <input type="hidden" id="sellCurId" name="sellCurId" value="$!{fexTranReq.sellCurId}"/>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.buyMoney')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" data-name="buyMoney" data-biz-name="buyMoney" lay-verify="required" data-callback="bt.buyMoneyCallback"
                                       id="buyMoney" autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{fexTranReq.buyMoney}"
                                    #if($!{fexTranReq.fixedMoney} == "1") readonly #end>
                            </div>
                        </td>
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.sellMoney')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" data-name="sellMoney" data-biz-name="sellMoney" lay-verify="required" data-callback="bt.sellMoneyCallback"
                                       id="sellMoney" autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{fexTranReq.sellMoney}"
                                    #if($!{fexTranReq.fixedMoney} == "2") readonly #end>
                            </div>
                        </td>
                    </tr>

                    #if("1" == $!{isProfitAndLoss})
                        <tr>
                            <td class="textRight" width="20%">#springMessage('table.fexTranDeal.wishRate')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    <input type="text" data-name="spotRate" data-biz-name="spotRate" data-decimal="6" lay-verify="required" data-callback="bt.spotRateCallback"
                                           id="spotRate" autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{vo.spotRate}">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.profitLossCur')</td>
                            <td width="30%">
                                <div class="bt-biz-selectType"
                                     data-url="${basePath}/basic/business/btcurrency/json"
                                     data-defaultvalue="$!{vo.profitLossCur}" data-disabled="true"
                                     data-name="profitLossCur" data-biz-name="profitLossCur" data-selectText="false"
                                     data-valueField="id" data-extraData="false" data-textField="englishCode"></div>
                            </td>
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.profitAndLoss')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    <input type="text" data-name="profitLossMoney" data-minus="true"  data-biz-name="profitLossMoney"  lay-verify="required" data-callback="bt.profitLossMoneyCallback"
                                           id="profitLossMoney" autocomplete="off" class="layui-input bt-biz-moneyType" data-minus="true" value="$!{vo.profitLossMoney}">
                                </div>
                            </td>
                        </tr>
                        #if("Y" == $!{isShowConvert})
                            <tr>
                                ##折本位币报价方式
                                <td class="textRight"  width="20%">#springMessage('table.fexTranReq.convertQuotationMethod')</td>
                                <td width="30%">
                                    <div class="layui-input-inline">
                                        <input type="text" id="convertCurType"
                                               name="convertCurType" value="$!{corpCurQuoMethod}"
                                               class="layui-input" readonly/>
                                    </div>
                                </td>
                                ##折本位币汇率
                                <td class="textRight"  width="20%">#springMessage('table.fexTranReq.convertBaseCurRate')</td>
                                <td width="30%">
                                    <input type="text" data-id="convertRate" data-name="convertRate" data-biz-name="convertRate" data-decimal="6"
                                           lay-verify="required" value="$!{convertRate}" data-callback="bt.convertRateCallback"
                                           id="convertRate" autocomplete="off" class="layui-input bt-biz-moneyType" data-max="999999999999.999999" data-min="0.00000001">
                                </td>
                            </tr>
                            <tr>
                                ## 折本位币损益
                                <td class="textRight" width="20%">#springMessage('table.fexTranReq.convertBasePAndL')</td>
                                <td width="30%">
                                    <input type="text" data-id="convertLossMoney" data-minus="true"  data-name="convertLossMoney" data-biz-name="convertLossMoney"
                                           lay-verify="required" value="$!{vo.convertLossMoney}"
                                           id="convertLossMoney" autocomplete="off" class="layui-input bt-biz-moneyType">
                                </td>
                            </tr>
                        #end
                    #end
                    <tr>
                        ##交易员
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.dealer')</td>
                        <td width="30%">
                            <input type="text" id="dealer" data-required = "true" value="$!{dealer}" readonly="readonly"
                                   autocomplete="off" class="layui-input" >
                        </td>
                        ##交易地点
                        <td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAddr')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input id="tranAddrId" name="tranAddrId" type="hidden" value="$!{fexTranReq.tranAddrId}">
                                <input type="text" id="tranAddr" name="tranAddr" #*lay-verify="tableData"*# data-biz-name="tranAddr"
                                       autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.tranAddr')" value="$!{fexTranReq.tranAddr}">
                                <table id="tranAddrTable" class="hide">
                                    <thead>
                                    <tr>
                                        <th>#springMessage('table.tbCreditPeriod.code')</th>
                                        <th>#springMessage('table.btswiftinfo.namezh')</th>
                                        <th>#springMessage('table.btswiftinfo.nameen')</th>
                                    </tr>
                                    </thead>
                                </table>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ##备注
                        <td class="textRight">#springMessage('fcVoucherType.rmk')</td>
                        <td colspan="3">
                                        <textarea placeholder="#springMessage('bisAccAttribute.rmk')"
                                                  class="layui-textarea" lay-verify="strlength" data-maxlength="200"
                                                  style="width:100%" id="rmk"
                                                  name="rmk"></textarea>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/foreignLifecycle/lifecycleRateConfirm.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/foreign/foreignLifecycle/viewBill.js?_btv=${resourceVersion}"></script>

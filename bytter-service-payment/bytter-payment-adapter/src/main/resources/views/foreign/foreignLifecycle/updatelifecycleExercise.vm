<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="web-body">
    <form class="layui-form" method="post" id="inputForm">
        <input type="hidden" name = "id" id = "id" value="$!{vo.id}"/>
        <input type="hidden" id="quotationCurId" value="$!{fexTranReq.quotationCurId}">
        <input type="hidden" id="quotationReferCurId" value="$!{fexTranReq.quotationReferCurId}">
        <input type="hidden" id="tranCurPairBaseId" value="$!{fexTranReq.tranCurPairBaseId}">
        <input type="hidden" id="tranCurPairReferId" value="$!{fexTranReq.tranCurPairReferId}">
        <input type="hidden" id="contractRate" value="$!{fexTranReq.contractRate}">
        <input type="hidden" id="busDirection" value="$!{fexTranReq.busDirection}">
        <input type="hidden" id="updownDirection" value="$!{fexTranReq.updownDirection}">
        <input type="hidden" id="positionMoney" value="$!{fexTranReq.positionMoney}"/>
        <input type="hidden" id="corpCurId" value="$!{corpCurId}"/>
        <input type="hidden" id="reqId" name= "reqId" value="$!{fexTranReq.id}">
        <input type="hidden" id="corpId" name= "corpId" value="$!{fexTranReq.corpId}">

        ## 付款账号
        <input type="hidden" id="srcBankAcc" value="$!{fexTranReq.srcBankAcc}">
        ## 收款账号
        <input type="hidden" id="corpBankAcc" value="$!{fexTranReq.corpBankAcc}">
        ## 产品ID
        <input type="hidden" id="proId"  value="$!{fexTranReq.proId}">
        ##交易货币对
        <input type="hidden" id = "tranCurPairIdName" value="$!{fexTranReq.tranCurPairIdName}"/>
        ##报价方式
        <input type="hidden" id = "quotationMethod" value="$!{vo.quotationMethod}"/>
        <input type="hidden" id="isShowConvert" #if($!{isShowBaseCurQuotation}) value="Y" #else value="N" #end>
        <input type="hidden" id ="buyCurId"  value="$!{fexTranReq.buyCurId}">
        <input type="hidden" id ="sellCurId"  value="$!{fexTranReq.sellCurId}">
        <input type="hidden" id ="fexTranType"  value="$!{fexTranReq.fexTranType}">
        <input type="hidden" id ="tranType"  value="$!{fexTranReq.tranType}">
        <input type="hidden" id = "settleCurId" value="$!{vo.curId}">
        <!-- 主体单位账户信息 -->
        <input type="hidden" id="corpBank" value="$!{fexTranReq.corpBank}">
        <div class="layui-collapse">
            <div class="layui-colla-item">
                ##合约信息
                <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.contractInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table breakRow">
                        <tbody>
                        <tr>
                            ##交易号码
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
                            <td width="30%">
                                <a class="" href="#" onclick="viewBill('$!{fexTranReq.id}')">
                                    $!{fexTranReq.billNo}
                                </a>
                            </td>
                            ##到期日期
                            <td class="textRight" width="20%">#springMessage('fex.tranApp.expirationDate')</td>
                            <td width="30%">$!date.format('yyyy-MM-dd',$!{fexTranReq.expiresDate})</td>
                        </tr>
                        <tr>
                            ##交割类型
                            <td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
                            <td>$dictTag.get("fexProduct.deliveryType",$!{fexTranReq.deliveryType})</td>
                            ##外汇期权品种
                            <td class="textRight">#springMessage('table.fexProduct.fexOption')</td>
                            <td>
                                $dictTag.get("fexProduct.fexOption1",$!{fexTranReq.fexOption1})&nbsp;
                                $dictTag.get("fexProduct.fexOption2",$!{fexTranReq.fexOption2})&nbsp;
                                $dictTag.get("fexProduct.fexOption3",$!{fexTranReq.fexOption3})
                            </td>
                        </tr>
                        <tr>
                            ##外汇期权类型
                            <td class="textRight">#springMessage('table.fexProduct.fexOptionType')</td>
                            <td>$dictTag.get("fexProduct.fexOptionType",$!{fexTranReq.fexOptionType})</td>
                            ##交易货币对
                            <td class="textRight">#springMessage('fex.tranApp.tranCurPair')</td>
                            <td>$!{fexTranReq.tranCurPairIdName}</td>
                        </tr>
                        <tr>
                            ##报价方式
                            <td class="textRight">#springMessage('fex.tranApp.quotationMethod')</td>
                            <td>$!{fexTranReq.quotationMethod}</td>
                            ##执行汇率
                            <td class="textRight">#springMessage('fex.tranApp.executeExchangeRate')</td>
                            <td>$!number.formatDoubles($!{fexTranReq.contractRate},6)</td>
                        </tr>
                        <tr>
                            ##买卖方向
                            <td class="textRight">#springMessage('fex.tranApp.busDirection')</td>
                            <td>$dictTag.get("fexTranDeal.deliverySign",$!{fexTranReq.busDirection})</td>
                            ##涨跌方向
                            <td class="textRight">#springMessage('fex.tranApp2.upAndDownDirection')</td>
                            <td>$dictTag.get("fex.tranApp2.updownDirection",$!{fexTranReq.updownDirection})</td>
                        </tr>
                        <tr>
                            ##持仓金额
                            <td class="textRight">#springMessage('table.fexTranReq.positionMoney')</td>
                            <td>$!number.formatNumeric($!{fexTranReq.positionMoney})</td>
                            ##
                            <td class="textRight"></td>
                            <td></td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            #if($!{fexTranReq.deliveryType} == '1')
                ##本金交割
                <div class="layui-colla-item">
                    <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.info')</h2>
                    <div class="layui-colla-content layui-show">
                        <table class="layui-table breakRow">
                            <tbody>
                            <tr>
                                ##生命周期号码
                                <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.billNo')</td>
                                <td width="30%"> $!{vo.billNo}</td>
                                ##操作类型
                                <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.opType')</td>
                                <td width="30%">
                                    $dictTag.get("fexProduct.options.lifeCycle",${vo.opType})
                                    <div class="layui-input-inline">
                                        <input type="hidden" id="opType" name="opType" value="$!{vo.opType}"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                ##操作日期
                                <td class="textRight">#springMessage('table.fexTranLifeCycle.opDate')</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <input type="text" name="opDate" lay-verify="required" class="layui-input bt-biz-dateType"
                                               value="$!date.format('yyyy-MM-dd',$!{vo.opDate})"
                                               data-type="date" data-endid="settleDate"
                                               data-name="opDate" data-biz-name="opDate" data-min="$!{fexTranReq.tranDate}" data-max="$!{fexTranReq.expiresDate}">
                                    </div>
                                </td>
                                ##结算日期
                                <td class="textRight">#springMessage('table.fexTran.settleDate')</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <input type="text" name="settleDate" lay-verify="required" class="layui-input bt-biz-dateType"
                                               value="$!date.format('yyyy-MM-dd',$!{vo.settleDate})"  data-type="date"
                                               data-name="settleDate" data-biz-name="settleDate" data-min="$!{fexTranReq.opDate}" id="settleDate">
                                    </div>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="layui-colla-item">
                    <h2 class="layui-colla-title">#springMessage('table.fexTranReq.amtDtl')</h2>
                    <div class="layui-colla-content layui-show">
                        <table class="layui-table breakRow">
                            <tbody>
                            <tr>
                                <td colspan="4">
                                    <table class="layui-table layui-table-border ignore-required-icon">
                                        <thead>
                                        <tr>
                                            <th width="15%">#springMessage('table.fexForeign.curId')</th>
                                            <th width="15%">#springMessage('table.fexTranLifeCycle.direction')</th>
                                            <th width="35%"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranLifeCycle.opMoney')</th>
                                            <th width="35%">#springMessage('table.fexTranLifeCycle.balance')</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        #if(($!{fexTranReq.busDirection}=="1" && $!{fexTranReq.updownDirection}=="0") ||
                                            ($!{fexTranReq.busDirection}=="2" && $!{fexTranReq.updownDirection}=="1"))
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="buyCurId" value="$!{fexTranReq.tranCurPairBaseCode}">
                                                    $!{fexTranReq.tranCurPairBaseCode}
                                                </td>##交易货币对左侧币种
                                                <td>#springMessage('table.fexTranReq.direction.buy')</td>
                                                <td><input type="text" id="firstMoney" data-name="buyMoney" data-biz-name="buyMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                           data-callback="bt.firstMoneyCallback"  data-max="$!{fexTranReq.positionMoney}" value="$!{vo.getBuyMoney()}" >
                                                </td>
                                                <td>
                                                    <input type="text" class="layui-input bt-biz-moneyType" id="firstBal" data-name="buyBal" data-biz-name="buyBal" autocomplete="off" value="0.0" readonly>
                                                </td>
                                                <input type="hidden" id="opMoney" name="opMoney" value="$!{vo.getBuyMoney()}">
                                            </tr>
                                            <tr>
                                                <td width="8%">
                                                    <input type="hidden" name="sellCurId" value="$!{fexTranReq.tranCurPairReferCode}">
                                                    $!{fexTranReq.tranCurPairReferCode}
                                                </td>##交易货币对右侧币种
                                                <td width="8%">#springMessage('table.fexTranReq.direction.sell')</td>
                                                <td width="42%">
                                                    <input type="text" id="secondMoney" data-name="sellMoney" data-biz-name="sellMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                           data-callback="bt.secondMoneyCallback" data-max="$!{secondOpMoneyMax}" value="$!{vo.getSellMoney()}" >
                                                </td>
                                                <td width="42%">
                                                    <input type="text" id="secondBal" data-name="sellBal" data-biz-name="sellBal" autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{vo.sellBal}" readonly>
                                                </td>
                                            </tr>
                                        #else
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="sellCurId" value="$!{fexTranReq.tranCurPairBaseCode}">
                                                    $!{fexTranReq.tranCurPairBaseCode}
                                                </td>##交易货币对左侧币种
                                                <td width="8%">#springMessage('table.fexTranReq.direction.sell')</td>
                                                <td><input type="text" id="firstMoney" data-name="sellMoney" data-biz-name="sellMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                           data-callback="bt.firstMoneyCallback"  data-max="$!{fexTranReq.positionMoney}"  value="$!{vo.getSellMoney()}" >
                                                </td>
                                                <td width="42%">
                                                    <input type="text" id="firstBal" data-name="sellBal" data-biz-name="sellBal" autocomplete="off" class="layui-input bt-biz-moneyType" value="0.0" readonly>
                                                </td>
                                                <input type="hidden" id="opMoney" name="opMoney" value="$!{vo.getSellMoney()}">
                                            </tr>
                                            <tr>
                                                <td width="8%">
                                                    <input type="hidden" name="buyCurId" value="$!{fexTranReq.tranCurPairReferCode}">
                                                    $!{fexTranReq.tranCurPairReferCode}
                                                </td>##交易货币对右侧币种
                                                <td>#springMessage('table.fexTranReq.direction.buy')</td>
                                                <td width="42%">
                                                    <input type="text" id="secondMoney" data-name="buyMoney" data-biz-name="buyMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                           data-callback="bt.secondMoneyCallback"data-max="$!{secondOpMoneyMax}" value="$!{vo.getBuyMoney()}">
                                                </td>
                                                <td width="42%">
                                                    <input type="text" id="secondBal" data-name="buyBal" data-biz-name="buyBal" autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{vo.buyBal}" readonly>
                                                </td>
                                            </tr>
                                         #end
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                ##即期汇率
                                <td class="textRight">#springMessage('table.fexTranDeal.wishRate')</td>
                                <td>
                                    <input type="text" name="spotRate" data-biz-name='spotRate' class="layui-input bt-biz-moneyType"
                                           data-decimal="6"  lay-verify="required" value="$!{vo.spotRate}" data-callback="bt.spotRateCallback">
                                </td>
                                ##结算币种
                                <td class="textRight">#springMessage('table.fexTranDeal.settleCurId')</td>
                                <td>
                                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="curId" data-biz-name ="curId" data-displayData="$!{fexTranReq.tranCurPairBaseId},$!{fexTranReq.tranCurPairReferId}"
                                         data-valueField="id" data-textField="englishCode" data-required="true" data-callback="bt.settleCurCallback" data-value="$!{vo.curId}"></div>
                                </td>
                            </tr>
                            <tr>
                                ##结算金额
                                <td class="textRight">#springMessage('table.fexTranDeal.settleMoney')</td>
                                <td>
                                    <input type="text" id = "settleMoney" data-minus="true" name="money" data-name="money" data-biz-name="money"
                                           class="layui-input bt-biz-moneyType" lay-verify="required" value="$!{vo.money}" data-callback="bt.settleMoneyCallback">
                                </td>
                                ##结算账号
                                <td class="textRight">#springMessage('table.fexTranDeal.settleBankAcc')</td>
                                <td>
                                    <input type="text" id="bankAcc" name="bankAcc"
                                           lay-verify="tableData|required" data-biz-name="bankAcc"
                                           value="$!{vo.bankAcc}"
                                           autocomplete="off" class="layui-input text"
                                           placeholder="#springMessage('table.nisBillhead.payerAcc')"
                                           data-swapType="">
                                    <table id="bankAccTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.choBankFinance.acc')</th>
                                            <th>#springMessage('table.btBankAccApp.accName')</th>
                                            <th>#springMessage('table.btBankAcc.bankName')</th>
                                            <th>#springMessage('table.nisBillhead.curId')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                ##操作日记账汇率
                                <td class="textRight">#springMessage('table.fexTranDeal.recordRate')</td>
                                <td>
                                    <input type="text" id ="recordRate" name="recordRate" data-name ="recordRate" data-biz-name="recordRate"
                                           class="layui-input bt-biz-moneyType" lay-verify="required" data-decimal="6"
                                           value="$!{vo.recordRate}" data-callback="bt.recordRateCallback" />
                                </td>
                                ##损益币种
                                <td class="textRight">#springMessage('table.fexTranReq.profitLossCur')</td>
                                <td>
                                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"  data-disabled="true"
                                         data-name ="profitLossCur" data-biz-name ="profitLossCur" data-defaultvalue="$!{vo.profitLossCur}"
                                         data-valueField="id" data-textField="englishCode" data-callback="bt.profitLossCurCallback" data-defaultvalue="$!{vo.profitLossCur}"></div>
                                </td>
                            </tr>
                            <tr>
                                ##损益
                                <td class="textRight">#springMessage('table.fexTranReq.profitAndLoss')</td>
                                <td>
                                    <input type="text" id = "profitLossMoney" data-minus="true" data-name="profitLossMoney" data-biz-name="profitLossMoney" class="layui-input bt-biz-moneyType"
                                           value="$!{vo.profitLossMoney}"  lay-verify="required" data-callback="bt.profitLossMoneyCallback">
                                </td>
                                ##申请人
                                <td class="textRight">#springMessage('table.fexTranReq.dealer')</td>
                                <td>$!{dealer}</td>
                            </tr>
                            #if($!{isShowBaseCurQuotation})
                                <tr class = "baseConvertTr"  class="layui-hide">
                                    ##折本位币报价方式
                                    <td class="textRight">#springMessage('table.fexTranReq.convertQuotationMethod')</td>
                                    <td >
                                        <div class="layui-input-inline">
                                            <input type="text" id="convertCurType" name="convertCurType" value="$!{vo.convertCurType}" class="layui-input" readonly/>
                                        </div>
                                    </td>
                                    ##折本位币汇率
                                    <td class="textRight">#springMessage('table.fexTranReq.convertBaseCurRate')</td>
                                    <td >
                                        <input type="text" data-id="convertRate" data-name="convertRate" data-biz-name="convertRate" data-decimal="6"
                                               value="$!{vo.convertRate}"  id="convertRate" autocomplete="off" class="layui-input bt-biz-moneyType" data-max="999999999999.999999" data-min="0.00000001" data-callback="bt.convertRateCallback">
                                    </td>
                                </tr>
                                <tr>
                                    ##折本位币损益
                                    <td class="textRight">#springMessage('table.fexTranReq.convertBasePAndL')</td>
                                    <td>
                                        <input type="text" id = "convertLossMoney" data-minus="true" data-name="convertLossMoney" data-biz-name="convertLossMoney"
                                               class="layui-input bt-biz-moneyType"
                                               lay-verify="required" value="$!{vo.convertLossMoney}">
                                    </td>
                                </tr>
                            #end
                            <tr>
                                ##备注
                                <td class="textRight">#springMessage('fcVoucherType.rmk')</td>
                                <td colspan="3">
                                        <textarea placeholder="#springMessage('bisAccAttribute.rmk')"
                                                  class="layui-textarea" lay-verify="strlength" data-maxlength="200"
                                                  style="width:100%" id="rmk"
                                                  name="rmk">$!{vo.rmk}</textarea>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            #else
                ##无本金交割
                <div class="layui-colla-item">
                    <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.info')</h2>
                    <div class="layui-colla-content layui-show">
                        <table class="layui-table breakRow">
                            <tbody>
                            <tr>
                                ##生命周期号码
                                <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.billNo')</td>
                                <td width="30%"> $!{vo.billNo}</td>
                                ##操作类型
                                <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.opType')</td>
                                <td width="30%">
                                    $dictTag.get("fexProduct.options.lifeCycle",${vo.opType})
                                    <div class="layui-input-inline">
                                        <input type="hidden" id="opType" name="opType" value="$!{vo.opType}"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                ##操作日期
                                <td class="textRight">#springMessage('table.fexTranLifeCycle.opDate')</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <input type="text" name="opDate" lay-verify="required" class="layui-input bt-biz-dateType"
                                               value="$!date.format('yyyy-MM-dd',$!{vo.opDate})"
                                               data-type="date" data-endid="settleDate"
                                               data-name="opDate" data-biz-name="opDate" data-min="$!{fexTranReq.tranDate}" data-max="$!{fexTranReq.expiresDate}">
                                    </div>
                                </td>
                                ##结算日期
                                <td class="textRight">#springMessage('table.fexTran.settleDate')</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <input type="text" name="settleDate" lay-verify="required" class="layui-input bt-biz-dateType"
                                               value="$!date.format('yyyy-MM-dd',$!{vo.settleDate})"   data-type="date"
                                               data-name="settleDate" data-biz-name="settleDate" data-min="$!{fexTranReq.opDate}" id="settleDate">
                                    </div>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.fexTranReq.amtDtl')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table breakRow">
                        <tbody>
                            <tr>
                                <td colspan="4">
                                    <table class="layui-table layui-table-border ignore-required-icon">
                                        <thead>
                                        <tr>
                                            <th width="15%">#springMessage('table.fexForeign.curId')</th>
                                            <th width="15%">#springMessage('table.fexTranLifeCycle.direction')</th>
                                            <th width="35%"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranLifeCycle.opMoney')</th>
                                            <th width="35%">#springMessage('table.fexTranLifeCycle.balance')</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        #if(($!{fexTranReq.busDirection}=="1" && $!{fexTranReq.updownDirection}=="0") ||
                                            ($!{fexTranReq.busDirection}=="2" && $!{fexTranReq.updownDirection}=="1"))
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="buyCurId" value="$!{fexTranReq.tranCurPairBaseCode}">
                                                    $!{fexTranReq.tranCurPairBaseCode}
                                                </td>##交易货币对左侧币种
                                                <td>#springMessage('table.fexTranReq.direction.buy')</td>
                                                <td><input type="text" id="firstMoney" data-name="buyMoney" data-biz-name="buyMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                           data-callback="bt.firstMoneyCallback"  data-max="$!{fexTranReq.positionMoney}" value="$!{vo.getBuyMoney()}">
                                                </td>
                                                <td>
                                                    <input type="text" class="layui-input bt-biz-moneyType" id="firstBal" data-name="buyBal" data-biz-name="buyBal" autocomplete="off" value="$!{vo.buyBal}" readonly>
                                                </td>
                                                <input type="hidden" id="opMoney" name="opMoney" value="$!{vo.getBuyMoney()}">
                                            </tr>
                                            <tr>
                                                <td width="8%">
                                                    <input type="hidden" name="sellCurId" value="$!{fexTranReq.tranCurPairReferCode}">
                                                    $!{fexTranReq.tranCurPairReferCode}
                                                </td>##交易货币对右侧币种
                                                <td width="8%">#springMessage('table.fexTranReq.direction.sell')</td>
                                                <td width="42%">
                                                    <input type="text" id="secondMoney" data-name="sellMoney" data-biz-name="sellMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                           data-callback="bt.secondMoneyCallback"data-max="$!{secondOpMoneyMax}" value="$!{vo.getSellMoney()}">
                                                </td>
                                                <td width="42%">
                                                    <input type="text" id="secondBal" data-name="sellBal" data-biz-name="sellBal" autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{vo.sellBal}" readonly>
                                                </td>
                                            </tr>
                                        #else
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="sellCurId" value="$!{fexTranReq.tranCurPairBaseCode}">
                                                    $!{fexTranReq.tranCurPairBaseCode}
                                                </td>##交易货币对左侧币种
                                                <td width="8%">#springMessage('table.fexTranReq.direction.sell')</td>
                                                <td><input type="text" id="firstMoney" data-name="sellMoney" data-biz-name="sellMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                           data-callback="bt.firstMoneyCallback"  data-max="$!{fexTranReq.positionMoney}" value="$!{vo.getSellMoney()}" >
                                                </td>
                                                <td width="42%">
                                                    <input type="text" id="firstBal" data-name="sellBal" data-biz-name="sellBal" autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{vo.sellBal}" readonly>
                                                </td>
                                                <input type="hidden" id="opMoney" name="opMoney" value="$!{vo.getSellMoney()}">
                                            </tr>
                                            <tr>
                                                <td width="8%">
                                                    <input type="hidden" name="buyCurId" value="$!{fexTranReq.tranCurPairReferCode}">
                                                    $!{fexTranReq.tranCurPairReferCode}
                                                </td>##交易货币对右侧币种
                                                <td>#springMessage('table.fexTranReq.direction.buy')</td>
                                                <td width="42%">
                                                    <input type="text" id="secondMoney" data-name="buyMoney" data-biz-name="buyMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                           data-callback="bt.secondMoneyCallback"data-max="$!{secondOpMoneyMax}" value="$!{vo.getBuyMoney()}">
                                                </td>
                                                <td width="42%">
                                                    <input type="text" id="secondBal" data-name="buyBal" data-biz-name="buyBal" autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{vo.buyBal}" readonly>
                                                </td>
                                            </tr>
                                        #end
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                ##即期汇率
                                <td class="textRight">#springMessage('table.fexTranDeal.wishRate')</td>
                                <td>
                                    <input type="text" name="spotRate" data-biz-name='spotRate' class="layui-input bt-biz-moneyType"
                                           data-decimal="6"  lay-verify="required" value="$!{vo.spotRate}" data-callback="bt.spotRateCallback">
                                </td>
                                ##损益币种
                                <td class="textRight">#springMessage('table.fexTranReq.profitLossCur')</td>
                                <td>
                                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-disabled="true"
                                         data-name ="profitLossCur" data-biz-name ="profitLossCur" data-defaultvalue="$!{vo.profitLossCur}" data-defaultvalue="$!{vo.profitLossCur}"
                                         data-valueField="id" data-textField="englishCode" data-callback="bt.settleCurCallback"></div>
                                </td>
                            </tr>
                            <tr>
                                ##收款账号
                                <td class="textRight">#springMessage('table.fexForeignReq.payeeAcc')</td>
                                <td>
                                    <input type="text" id="payeeAcc" name="payeeAcc"
                                           lay-verify="tableData|required" data-biz-name="payeeAcc"
                                           value="$!{vo.payeeAcc}"
                                           autocomplete="off" class="layui-input text"
                                           placeholder="#springMessage('table.nisBillhead.payeeAcc')"
                                           data-swapType="">
                                    <table id="payeeAccBankAccTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.choBankFinance.acc')</th>
                                            <th>#springMessage('table.btBankAccApp.accName')</th>
                                            <th>#springMessage('table.btBankAcc.bankName')</th>
                                            <th>#springMessage('table.nisBillhead.curId')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </td>
                                ##付款账号
                                <td class="textRight">#springMessage('table.fexForeignReq.payerAcc')</td>
                                <td>
                                    <input type="text" id="payerAcc" name="payerAcc"
                                           lay-verify="tableData|required" data-biz-name="payerAcc"
                                           value="$!{vo.payerAcc}"
                                           autocomplete="off" class="layui-input text"
                                           placeholder="#springMessage('table.nisBillhead.payerAcc')"
                                           data-swapType="">
                                    <table id="payerAccBankAccTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.choBankFinance.acc')</th>
                                            <th>#springMessage('table.btBankAccApp.accName')</th>
                                            <th>#springMessage('table.btBankAcc.bankName')</th>
                                            <th>#springMessage('table.nisBillhead.curId')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                ##损益
                                <td class="textRight">#springMessage('table.fexTranReq.profitAndLoss')</td>
                                <td>
                                    <input type="text" data-minus="true" data-name="profitLossMoney" data-biz-name="profitLossMoney" class="layui-input bt-biz-moneyType"
                                           lay-verify="required" value="$!{vo.profitLossMoney}" data-callback="bt.profitLossMoneyCallback">
                                </td>
                                ##申请人
                                <td class="textRight">#springMessage('table.fexTranReq.dealer')</td>
                                <td>$!{dealer}</td>
                            </tr>
                            #if($!{isShowBaseCurQuotation})
                                <tr class = "baseConvertTr"  class="layui-hide">
                                    ##折本位币报价方式
                                    <td class="textRight">#springMessage('table.fexTranReq.convertQuotationMethod')</td>
                                    <td >
                                        <div class="layui-input-inline">
                                            <input type="text" id="convertCurType" name="convertCurType" value="$!{vo.convertCurType}" class="layui-input" readonly/>
                                        </div>
                                    </td>
                                    ##折本位币汇率
                                    <td class="textRight">#springMessage('table.fexTranReq.convertBaseCurRate')</td>
                                    <td >
                                        <input type="text" data-id="convertRate" data-name="convertRate" data-biz-name="convertRate" data-decimal="6"
                                               lay-verify="number2" value="$!{vo.convertRate}" data-callback="bt.convertRateCallback"
                                               id="convertRate" autocomplete="off" class="layui-input bt-biz-moneyType" data-max="999999999999.999999" data-min="0.00000001">
                                    </td>
                                </tr>
                                <tr>
                                    ##折本位币损益
                                    <td class="textRight">#springMessage('table.fexTranReq.convertBasePAndL')</td>
                                    <td><input type="text" id = "convertLossMoney" data-minus="true" data-name="convertLossMoney" data-biz-name="convertLossMoney"
                                               class="layui-input bt-biz-moneyType"
                                               lay-verify="required" value="$!{vo.convertLossMoney}"></td>
                                </tr>
                            #end
                            <tr>
                                ##备注
                                <td class="textRight">#springMessage('fcVoucherType.rmk')</td>
                                <td colspan="3">
                                        <textarea placeholder="#springMessage('bisAccAttribute.rmk')"
                                                  class="layui-textarea" lay-verify="strlength" data-maxlength="200"
                                                  style="width:100%" id="rmk"
                                                  name="rmk">$!{vo.rmk}</textarea>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            #end

        </div>
        <div style="text-align: center; padding-top: 10px;">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="11" >#springMessage('common.button.submit')</button>
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="0" >#springMessage('common.button.temp')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </form>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/foreign/foreignLifecycle/foreignLifecycle.exercise.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/foreign/foreignLifecycle/viewBill.js?_btv=${resourceVersion}"></script>
</body>
</html>

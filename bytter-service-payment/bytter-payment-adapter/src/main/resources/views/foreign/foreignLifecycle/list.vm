<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <div class="web-body">
        <form id="searchForm" class="layui-form">
            <table class="layui-table form-table-expand-box">
                <tbody>
                <tr>
                    ##生命周期号码
                    <td class="textRight">#springMessage('table.fexTranLifeCycle.billNo')</td>
                    <td>
                        <input type="text" name="likes_billNo"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranLifeCycle.billNo')">
                    </td>
                    ##操作类型
                    <td class="textRight">#springMessage('table.fexTranLifeCycle.opType')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="mulselect" data-group="fexProduct.lifeCycle" data-name="ins_opType"></div>
                    </td>
                    ##交易号码
                    <td class="textRight">#springMessage('table.fexTranReq.billNo')</td>
                    <td>
                        <input type="text" name="likes_relBillNo"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.billNo')" value="${relBillNo}">
                    </td>
                </tr>
                <tr>
                    ##交易货币对
                    <td class="textRight">#springMessage('fex.tranApp.tranCurPair')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrencypair/json"
                                 data-name ="eqs_tranCurPairId" data-biz-name ="eqs_tranCurPairId" data-method="get"
                                 data-valuefield="pairId" data-textfield="pairCode"></div>
                        </div>
                    </td>
                    ##操作日期
                    <td class="textRight">#springMessage('table.fexTranLifeCycle.opDate')</td>
                    <td class="input100">
                        <input type="text" name="ged_opDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_opDate" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_opDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_opDate">
                    </td>
                    ##结算日期
                    <td class="textRight">#springMessage('table.fexTran.settleDate')</td>
                    <td class="input100">
                        <input type="text" name="ged_settleDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_settleDate" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_settleDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_settleDate">
                    </td>
                </tr>
                <tr>
                    ##操作金额
                    <td class="textRight">#springMessage('table.fexTranLifeCycle.opMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_opMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                   data-moneyendid="t20" placeholder="#springMessage('table.fexTranLifeCycle.opMoney')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_opMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                   id="t20" placeholder="#springMessage('table.fexTranLifeCycle.opMoney')">
                        </div>
                    </td>
                    ##损益金额
                    <td class="textRight">#springMessage('table.fexTranLifeCycle.lossMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_profitLossMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                   data-moneyendid="t21" placeholder="#springMessage('table.fexTranLifeCycle.lossMoney')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_profitLossMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                   id="t21" placeholder="#springMessage('table.fexTranLifeCycle.lossMoney')">
                        </div>
                    </td>
                    ##折本位币损益
                    <td class="textRight">#springMessage('table.fexTranReq.convertBasePAndL')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_convertLossMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                   data-moneyendid="t22" placeholder="#springMessage('table.fexTranReq.convertBasePAndL')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_convertLossMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                   id="t22" placeholder="#springMessage('table.fexTranReq.convertBasePAndL')">
                        </div>
                    </td>

                </tr>
                <tr>
                    ##损益币种
                    <td class="textRight">#springMessage('table.fexTranReq.profitLossCur')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="ins_profitLossCur" data-biz-name ="ins_profitLossCur"
                                 data-method="get" data-valueField="id" data-textField="englishCode"></div>
                        </div>
                    </td>
                    ##状态
                    <td class="textRight">#springMessage('table.common.status')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-displayData="0,-1,11,95"
                             data-group="choBankFinance.status" data-name="eqs_lifeStatus"></div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
                </tbody>
            </table>
        </form>
        <div>
            <table id="appTable" class="layui-table layui-form" style="width:100%;">
                <thead>
                <tr>
                    <th>#springMessage('table.fexTranLifeCycle.billNo')</th>
                    <th>#springMessage('table.fexTranLifeCycle.opType')</th>
                    <th>#springMessage('table.fexTranReq.billNo')</th>
                    <th>#springMessage('fex.tranApp.tranCurPair')</th>
                    <th>#springMessage('fex.tranApp.quotationMethod')</th>
                    <th>#springMessage('table.fexTranLifeCycle.opDate')</th>
                    <th>#springMessage('table.fexTran.settleDate')</th>
                    <th>#springMessage('table.fexTranLifeCycle.opMoney')</th>
                    <th>#springMessage('table.fexTranDeal.wishRate')</th>
                    <th>#springMessage('table.fexTranReq.profitLossCur')</th>
                    <th>#springMessage('table.fexTranReq.profitAndLoss')</th>
                    <th>#springMessage('table.fexTranReq.convertQuotationMethod')</th>
                    <th>#springMessage('table.fexTranReq.convertBaseCurRate')</th>
                    <th>#springMessage('table.fexTranReq.convertBasePAndL')</th>
                    <th>#springMessage('table.common.status')</th>
                    <th>#springMessage('common.table.thead.operation')</th>
                </tr>
                </thead>
            </table>
        </div>
    </div>
    #parse("views/common/footer.vm")
    <script src="${basePath}/static/modules/foreign/foreignLifecycle/foreignLifecycle.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

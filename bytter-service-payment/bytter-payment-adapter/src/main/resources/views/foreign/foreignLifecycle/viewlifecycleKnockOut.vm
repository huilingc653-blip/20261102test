<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="web-body">
    <form class="layui-form" method="post" id="inputForm">
        <input type="hidden" id ="tranType"  value="$!{fexTranReq.tranType}">
        <div class="layui-collapse">
            <div class="layui-colla-item">
                ##合约信息
                <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.contractInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table breakRow">
                        <tbody>
                        <tr>
                            ##交易号码
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
                            <td width="30%">
                                <a class="" href="#" onclick="viewBill('$!{fexTranReq.id}')">
                                    $!{fexTranReq.billNo}
                                </a>
                            </td>
                            ##到期日期
                            <td class="textRight" width="20%">#springMessage('fex.tranApp.expirationDate')</td>
                            <td width="30%">$!date.format('yyyy-MM-dd',$!{fexTranReq.expiresDate})</td>
                        </tr>
                        <tr>
                            ##交割类型
                            <td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
                            <td>$dictTag.get("fexProduct.deliveryType",${fexTranReq.deliveryType})</td>
                            ##外汇期权品种
                            <td class="textRight">#springMessage('table.fexProduct.fexOption')</td>
                            <td>
                                $dictTag.get("fexProduct.fexOption1",$!{fexTranReq.fexOption1})&nbsp;
                                $dictTag.get("fexProduct.fexOption2",$!{fexTranReq.fexOption2})&nbsp;
                                $dictTag.get("fexProduct.fexOption3",$!{fexTranReq.fexOption3})
                            </td>
                        </tr>
                        <tr>
                            ##外汇期权类型
                            <td class="textRight">#springMessage('table.fexProduct.fexOptionType')</td>
                            <td>$dictTag.get("fexProduct.fexOptionType",$!{fexTranReq.fexOptionType})</td>
                            ##交易货币对
                            <td class="textRight">#springMessage('fex.tranApp.tranCurPair')</td>
                            <td>$!{fexTranReq.tranCurPairIdName}</td>
                        </tr>
                        <tr>
                            ##报价方式
                            <td class="textRight">#springMessage('fex.tranApp.quotationMethod')</td>
                            <td>$!{fexTranReq.quotationMethod}</td>
                            ##执行汇率
                            <td class="textRight">#springMessage('fex.tranApp.executeExchangeRate')</td>
                            <td>
                                $!number.formatNumeric($!{fexTranReq.contractRate},"#0.000000")
                            </td>
                        </tr>
                        <tr>
                            ##买卖方向
                            <td class="textRight">#springMessage('fex.tranApp.busDirection')</td>
                            <td>$dictTag.get("fexTranDeal.deliverySign",$!{fexTranReq.busDirection})</td>
                            ##涨跌方向
                            <td class="textRight">#springMessage('fex.tranApp2.upAndDownDirection')</td>
                            <td>$dictTag.get("fex.tranApp2.updownDirection",$!{fexTranReq.updownDirection})</td>
                        </tr>
                        #if($!{fexTranReq.fexOption2}=="2")
                            <tr>
                                <td class="textRight" width="20%">
                                    #springMessage('table.fexTranReq.exceptVal')
                                </td>
                                <td width="30%">$!number.formatDoubles($!{fexTranReq.exceptVal},4)</td>
                                <td width="20%"></td>
                                <td width="30%"></td>
                            </tr>
                            #else
                            <tr>
                                ##障碍值/低障碍值
                                <td class="textRight" width="20%">
                                    #if($!{fexTranReq.fexOption2}=="2")
												#springMessage('table.fexTranReq.exceptVal')
											#else
                                        #springMessage('table.fexTranReq.exceptLowVal')
                                    #end
                                </td>
                                <td width="30%">$!number.formatDoubles($!{fexTranReq.exceptLowVal},4)</td>
                                #if($!{fexTranReq.fexOption2}=="3")
                                    ##高障碍值
                                    <td class="textRight" width="20%"><div id="exceptHignValTdDiv">#springMessage('table.fexTranReq.exceptHignVal')</div></td>
                                    <td width="30%">$!number.formatDoubles($!{fexTranReq.exceptHignVal},4)</td>
                                #else
                                    <td width="20%"></td>
                                    <td width="30%"></td>
                                #end
                            </tr>
                         #end
                        <tr>
                            ##持仓金额
                            <td class="textRight">#springMessage('table.fexTranReq.positionMoney')</td>
                            <td>$!number.formatNumeric($!{vo.positionMoney})</td>
                            ##是否涉及退款
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.isRefund')</td>
                            <td colspan="3">$dictTag.get("sf_yn",$!{fexTranReq.isRefund})</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            ##如果是否涉及退款 == 否 显示敲出1
            #if($!{fexTranReq.isRefund} == '0')
                <div class="layui-colla-item">
                    <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.info')</h2>
                    <div class="layui-colla-content layui-show">
                        <table class="layui-table breakRow">
                            <tbody>
                            <tr>
                                ##生命周期号码
                                <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.billNo')</td>
                                <td width="30%"> $!{vo.billNo}</td>
                                ##操作类型
                                <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.opType')</td>
                                <td width="30%">
                                    $dictTag.get("fexProduct.lifeCycle",${vo.opType})
                                </td>
                            </tr>
                            <tr>
                                ##操作日期
                                <td class="textRight">#springMessage('table.fexTranLifeCycle.opDate')</td>
                                <td>
                                    $!date.format('yyyy-MM-dd',$!{vo.opDate})
                                </td>
                                ##参考汇率
                                <td class="textRight">#springMessage('table.fexTranLifeCycle.referRate')</td>
                                <td>
                                    $!number.formatNumeric($!{vo.spotRate},"#0.000000")
                                </td>
                            </tr>
                            <tr>
                                ##申请人
                                <td class="textRight">#springMessage('table.fexTranReq.dealer')</td>
                                <td>
                                    $!{dealer}
                                </td>
                                <td></td>
                                <td></td>
                            </tr>
                            <tr>
                                ##备注
                                <td class="textRight">#springMessage('table.common.rmk')</td>
                                <td colspan="3">
                                    $!{vo.rmk}
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            #else
                ##如果是否涉及退款 == 是  显示敲出2
                <div class="layui-colla-item">
                    <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.info')</h2>
                    <div class="layui-colla-content layui-show">
                        <table class="layui-table breakRow">
                            <tbody>
                            <tr>
                                ##生命周期号码
                                <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.billNo')</td>
                                <td width="30%"> $!{vo.billNo}</td>
                                ##操作类型
                                <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.opType')</td>
                                <td width="30%">
                                    $dictTag.get("fexProduct.options.lifeCycle",${vo.opType})
                                </td>
                            </tr>
                            <tr>
                                ##操作日期
                                <td class="textRight">#springMessage('table.fexTranLifeCycle.opDate')</td>
                                <td>
                                    <div class="layui-input-inline">
                                        #if($!{vo.opDate} != '')
                                            $!date.format('yyyy-MM-dd',$!{vo.opDate})
                                        #else
                                            $!date.format('yyyy-MM-dd',$!{fexTranReq.expiresDate})
                                        #end
                                    </div>
                                </td>
                                ##结算日期
                                <td class="textRight">#springMessage('table.fexTran.settleDate')</td>
                                <td>
                                    $!date.format('yyyy-MM-dd',$!{vo.settleDate})
                                </td>
                            </tr>
                            <tr>
                                ##参考汇率
                                <td class="textRight">#springMessage('table.fexTranLifeCycle.referRate')</td>
                                <td>
                                    $!number.formatNumeric($!{vo.spotRate},"#0.000000")
                                </td>
                                ##结算币种
                                <td class="textRight">#springMessage('table.fexTranDeal.settleCurId')</td>
                                <td>
                                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                                         data-name ="curId" data-biz-name ="curId" data-disabled="true" data-defaultvalue="$!{vo.curId}"
                                         data-required="true" data-valueField="id" data-textField="englishCode"></div>
                                </td>
                            </tr>
                            <tr>
                                ##结算金额
                                <td class="textRight">#springMessage('table.fexTranDeal.settleMoney')</td>
                                <td>
                                    $!{vo.money}
                                </td>
                                ##结算账号
                                <td class="textRight">#springMessage('table.fexTranDeal.settleBankAcc')</td>
                                <td>
                                    $!{vo.bankAcc}
                                </td>
                            </tr>
                            <tr>
                                ##操作日记账汇率
                                <td class="textRight">#springMessage('table.fexTranDeal.recordRate')</td>
                                <td>
                                    $!number.formatNumeric($!{vo.recordRate},"#0.000000")
                                </td>
                                #if($!{vo.profitLossCur})
                                    ##损益币种
                                    <td class="textRight">#springMessage('table.fexTranReq.profitLossCur')</td>
                                    <td>
                                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="profitLossCurCode" data-biz-name ="profitLossCurCode"
                                             data-required="true" data-disabled="true"
                                             data-valueField="id" data-textField="englishCode" data-defaultvalue="$!{vo.profitLossCur}"></div>
                                    </td>
                                #end

                            </tr>
                            <tr>
                                #if($!{vo.profitLossCur})
                                    ##损益
                                    <td class="textRight">#springMessage('table.fexTranReq.profitAndLoss')</td>
                                    <td>
                                        $!{vo.profitLossMoney}
                                    </td>
                                #end
                                ##申请人
                                <td class="textRight">#springMessage('table.fexTranReq.dealer')</td>
                                <td>
                                    $!{dealer}
                                </td>
                            </tr>
                            <tr>
                                ##备注
                                <td class="textRight">#springMessage('table.common.rmk')</td>
                                <td colspan="3">
                                    $!{vo.rmk}
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            #end
        </div>
    </form>
</div>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form','datatable','select','corp','dicts','selectType','rateType','layer'], function(){
        $ = bt.jquery, form = bt.form();
        bt.dicts.init();
        bt.selectType.init();
        var layer = bt.layer;
        var rateType = bt.rateType.getFun();
        var tip_index9 = 0;
        $('#direction-desc').mouseenter(function () {
            tip_index9 = layer.tips(bt.lang('指原合约的方向'), '#direction-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index9);
        });
    });
</script>
<script src="${basePath}/static/modules/foreign/foreignLifecycle/viewBill.js?_btv=${resourceVersion}"></script>
</body>
</html>

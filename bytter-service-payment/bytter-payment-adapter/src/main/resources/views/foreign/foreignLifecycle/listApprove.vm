<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input id="flowStatus" name="flowStatus" type="hidden" value="$!{flowStatus}">
    <input id="cycleTime" name="cycleTime" type="hidden" value="$!{cycleTime}">
    <table class="layui-table">
        <tbody>
        <tr>
            ##生命周期号码
            <td class="textRight">#springMessage('table.fexTranLifeCycle.billNo')</td>
            <td>
                <input type="text" name="likes_billNo"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranLifeCycle.billNo')">
            </td>
            ##操作类型
            <td class="textRight">#springMessage('table.fexTranLifeCycle.opType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="fexProduct.lifeCycle" data-name="eqs_opType"></div>
            </td>
            ##交易号码
            <td class="textRight">#springMessage('table.fexTranReq.billNo')</td>
            <td>
                <input type="text" name="likes_relBillNo"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.billNo')">
            </td>
        </tr>
        <tr>
            ##交易货币对
            <td class="textRight">#springMessage('fex.tranApp.tranCurPair')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrencypair/json"
                         data-name ="eqs_tranCurPairId" data-biz-name ="eqs_tranCurPairId"
                         data-valuefield="pairId" data-textfield="pairCode"></div>
                </div>
            </td>
            ##操作日期
            <td class="textRight">#springMessage('table.fexTranLifeCycle.opDate')</td>
            <td class="input100">
                <input type="text" name="ged_opDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_opDate" >
                <span class="date-mid">~</span>
                <input type="text" name="led_opDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_opDate">
            </td>
            ##结算日期
            <td class="textRight">#springMessage('table.fexTran.settleDate')</td>
            <td class="input100">
                <input type="text" name="ged_settleDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_settleDate" >
                <span class="date-mid">~</span>
                <input type="text" name="led_settleDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_settleDate">
            </td>
        </tr>
        <tr>
            ##操作金额
            <td class="textRight">#springMessage('table.fexTranLifeCycle.opMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_opMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           data-moneyendid="t20" placeholder="#springMessage('table.fexTranLifeCycle.opMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_opMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           id="t20" placeholder="#springMessage('table.fexTranLifeCycle.opMoney')">
                </div>
            </td>
            ##损益金额
            <td class="textRight">#springMessage('table.fexTranLifeCycle.lossMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_money"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           data-moneyendid="t21" placeholder="#springMessage('table.fexTranLifeCycle.lossMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_money"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           id="t21" placeholder="#springMessage('table.fexTranLifeCycle.lossMoney')">
                </div>
            </td>
            ##折本位币损益
            <td class="textRight">#springMessage('table.fexTranReq.convertBasePAndL')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_convertLossMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           data-moneyendid="t22" placeholder="#springMessage('table.fexTranReq.convertBasePAndL')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_convertLossMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           id="t22" placeholder="#springMessage('table.fexTranReq.convertBasePAndL')">
                </div>
            </td>
        </tr>
        <tr>
            ##损益币种
            <td class="textRight">#springMessage('table.fexTranReq.profitLossCur')</td>
            <td>
                <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_profitLossCur" data-biz-name ="eqs_profitLossCur"
                     data-method="get" data-valueField="id" data-textField="englishCode"></div>
            </td>
            ##状态
            <td class="textRight">#springMessage('table.common.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-displayData="0,-1"
                     data-group="choBankFinance.status" data-name="eqs_lifeStatus"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                        'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fexTranLifeCycle.billNo')</th>
        <th>#springMessage('table.fexTranLifeCycle.opType')</th>
        <th>#springMessage('table.fexTranReq.billNo')</th>
        <th>#springMessage('fex.tranApp.tranCurPair')</th>
        <th>#springMessage('fex.tranApp.quotationMethod')</th>
        <th>#springMessage('table.fexTranLifeCycle.opDate')</th>
        <th>#springMessage('table.fexTran.settleDate')</th>
        <th>#springMessage('table.fexTranLifeCycle.opMoney')</th>
        <th>#springMessage('table.fexTranDeal.wishRate')</th>
        <th>#springMessage('table.fexTranReq.profitLossCur')</th>
        <th>#springMessage('table.fexTranReq.profitAndLoss')</th>
        <th>#springMessage('table.fexTranReq.convertQuotationMethod')</th>
        <th>#springMessage('table.fexTranReq.convertBaseCurRate')</th>
        <th>#springMessage('table.fexTranReq.convertBasePAndL')</th>
        <th>#springMessage('table.common.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
    #paymentWorkFlowScript()
</body>
</html>
<script>
    var datatable;
    bt.use(['form', 'datatable', 'select', 'dicts', 'selectType','mulselect','moneyType','dateType','corp','element'], function () {
        $ = bt.jquery, form = bt.form();
        bt.selectType.init();
        bt.mulselect.init();
        bt.moneyType.init();
        bt.dicts.init();
        bt.dateType.init();

        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            colReorder: true,
            checkbox: true,
            clickRowSelected:false,
            order: [[1, 'asc']],
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath + "/foreign/fexTradingLifecycle/dataTableApprove"
            },
            buttons: [],
            fixedColumns: {
                rightColumns: 1//代表冻结右边一列
            },
            columns: [
                {data: "billNo", bSortable: true, className: 'center'},
                {data: "opType", bSortable: true, className: 'center',
                    render: function (data, type, full, meta) {
                        return bt.dict("fexProduct.lifeCycle", full.opType);
                    }
                },
                {data: "relBillNo", bSortable: true},
                {data: "tranCurPairIdName", bSortable: true},
                {data: "quotationMethod", bSortable: true},
                {
                    data: "opDate", bSortable: true, className: 'center',
                    render: function (data, type, full, meta) {
                        if (data) {
                            return bt.date.format(data, "yyyy-MM-dd");
                        }
                        return '';
                    }
                },
                {
                    data: "settleDate", bSortable: true, className: 'center',
                    render: function (data, type, full, meta) {
                        if (data) {
                            return bt.date.format(data, "yyyy-MM-dd");
                        }
                        return '';
                    }
                },
                {
                    data: "opMoney", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.opMoney);
                    }
                },
                {
                    data: "spotRate", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.spotRate,{
                            separator:"",
                            decimal:'6'
                        });
                    }
                },
                {data: "profitLossCur", bSortable: true},
                {
                    data: "profitLossMoney", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.profitLossMoney);
                    }
                },
                {data: "convertCurType", bSortable: true, className: 'center'},
                {
                    data: "convertRate", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.convertRate,{
                            separator:"",
                            decimal:'6'
                        });
                    }
                },
                {
                    data: "convertLossMoney", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.convertLossMoney);
                    }
                },
                {data: "lifeStatus", bSortable: true, className: 'center',
                    render: function (data, type, full, meta) {
                        return bt.dict("choBankFinance.status", String(full.lifeStatus));
                    }
                },
                {
                    data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
                        var html = '';
                        if($("#flowStatus").val()=='todo'){
                            html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
                        }
                        if($("#flowStatus").val() == 'pass'){
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a><span class="text-explode">|</span>';
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }else {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }
                        return html;
                    }
                }
            ]
        });
        bt.workFlow.beforeSubmit = function(submitData){
            var data = bt.datatable.getSelectData("#appTable");
            if(data.length < 1){
                layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 2});
                return;
            }
            var ids = [];
            var taskIds = [];
            // 遍历行数据
            $.each(data,function(i, tr) {
                taskIds.push(tr.taskId);
            });
            bt.workFlow.taskList = taskIds;
            return true;
        }
    });


    function view(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        var id = data.id==null ?"":data.id;
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.view.data'), basePath + "/foreign/fexTradingLifecycle/view?id=" + id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['950px', '530px'],
            maxmin: true,
            content: basePath + "/foreign/fexTradingLifecycle/view?id=" + id
        });
    }
    function approve(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.button.approve'), basePath + "/foreign/fexTradingLifecycle/approve?id=" + data.id + "&taskId=" + data.taskId);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/foreign/fexTradingLifecycle/approve?id=" + data.id + "&taskId=" + data.taskId
        });
    }
</script>

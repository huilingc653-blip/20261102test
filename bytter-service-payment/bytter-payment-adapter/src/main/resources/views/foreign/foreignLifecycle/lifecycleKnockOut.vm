<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="web-body">
    <form class="layui-form" method="post" id="inputForm">
        <input type="hidden" id = "id" value="$!{vo.id}"/>
        <input type="hidden" id ="status" value="0">
        <input type="hidden" id ="reqId" name = "reqId" value="$!{fexTranReq.id}">
        <input type="hidden" id ="corpId" name = "corpId" value="$!{fexTranReq.corpId}">
        ## 付款账号
        <input type="hidden" id="srcBankAcc" value="$!{fexTranReq.srcBankAcc}">
        ## 收款账号
        <input type="hidden" id="corpBankAcc" value="$!{fexTranReq.corpBankAcc}">
        ## 产品ID
        <input type="hidden" id="proId"  value="$!{fexTranReq.proId}">
        ##交易货币对
        <input type="hidden" id = "tranCurPairIdName" value="$!{vo.tranCurPairIdName}"/>
        ##报价方式
        <input type="hidden" id = "quotationMethod" value="$!{vo.quotationMethod}"/>
        ##报价方式左侧币种
        <input type="hidden" id = "quotationCurId" value="$!{vo.quotationCurId}"/>
        <input type="hidden" id="isShowConvert" value="$!{isShowConvert}">
        <input type="hidden" id ="buyCurId"  value="$!{vo.buyCurId}">
        <input type="hidden" id ="sellCurId"  value="$!{vo.sellCurId}">
        <input type="hidden" id ="buyMoney"  value="$!{fexTranReq.buyMoney}">
        <input type="hidden" id ="sellMoney"  value="$!{fexTranReq.sellMoney}">
        <input type="hidden" id ="fexTranType"  value="$!{fexTranReq.fexTranType}">
        <input type="hidden" id ="tranType"  value="$!{fexTranReq.tranType}">
        <input type="hidden"  id="isSwapTran"  value="$!{fexTranReq.isSwapTran}">
        <input type="hidden" id="contractRate"  value="$!{fexTranReq.contractRate}">
        <input type="hidden" id="isRefund" name = "isRefund"  value="$!{fexTranReq.isRefund}">

        <!-- 主体单位账户信息 -->
        <input type="hidden" id="corpBank" value="$!{fexTranReq.corpBank}">
        <input type="hidden" id="updownDirection" value="$!{fexTranReq.updownDirection}">
        <div class="layui-collapse">
            <div class="layui-colla-item">
                ##合约信息
                <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.contractInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table breakRow">
                        <tbody>
                        <tr>
                            ##交易号码
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
                            <td width="30%">
                                <a class="" href="#" onclick="viewBill('$!{fexTranReq.id}')">
                                    $!{fexTranReq.billNo}
                                </a>
                            </td>
                            ##到期日期
                            <td class="textRight" width="20%">#springMessage('fex.tranApp.expirationDate')</td>
                            <td width="30%">$!date.format('yyyy-MM-dd',$!{fexTranReq.expiresDate})</td>
                        </tr>
                        <tr>
                            ##交割类型
                            <td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
                            <td>$dictTag.get("fexProduct.deliveryType",${fexTranReq.deliveryType})</td>
                            ##外汇期权品种
                            <td class="textRight">#springMessage('table.fexProduct.fexOption')</td>
                            <td>
                                $dictTag.get("fexProduct.fexOption1",$!{fexTranReq.fexOption1})
                                $dictTag.get("fexProduct.fexOption2",$!{fexTranReq.fexOption2})
                                $dictTag.get("fexProduct.fexOption3",$!{fexTranReq.fexOption3})
                            </td>
                        </tr>
                        <tr>
                            ##外汇期权类型
                            <td class="textRight">#springMessage('table.fexProduct.fexOptionType')</td>
                            <td>$dictTag.get("fexProduct.fexOptionType",$!{fexTranReq.fexOptionType})</td>
                            ##交易货币对
                            <td class="textRight">#springMessage('fex.tranApp.tranCurPair')</td>
                            <td>$!{fexTranReq.tranCurPairIdName}</td>
                        </tr>
                        <tr>
                            ##报价方式
                            <td class="textRight">#springMessage('fex.tranApp.quotationMethod')</td>
                            <td>$!{fexTranReq.quotationMethod}</td>
                            ##执行汇率
                            <td class="textRight">#springMessage('fex.tranApp.executeExchangeRate')</td>
                            <td>$!number.formatDoubles($!{fexTranReq.contractRate},6)</td>
                        </tr>
                        <tr>
                            ##买卖方向
                            <td class="textRight">#springMessage('fex.tranApp.busDirection')</td>
                            <td>$dictTag.get("fexTranDeal.deliverySign",$!{fexTranReq.busDirection})</td>
                            ##涨跌方向
                            <td class="textRight">#springMessage('fex.tranApp2.upAndDownDirection')</td>
                            <td>$dictTag.get("fex.tranApp2.updownDirection",$!{fexTranReq.updownDirection})</td>
                        </tr>
                        #if($!{fexTranReq.fexOption2}=="2")
                            <tr>
                                <td class="textRight" width="20%">
                                    #springMessage('table.fexTranReq.exceptVal')
                                </td>
                                <td width="30%">$!number.formatDoubles($!{fexTranReq.exceptVal},4)</td>
                                <td width="20%"></td>
                                <td width="30%"></td>
                            </tr>
                        #else
                            <tr>
                                ##障碍值/低障碍值
                                <td class="textRight" width="20%">
                                    #if($!{fexTranReq.fexOption2}=="2")
										#springMessage('table.fexTranReq.exceptVal')
									#else
                                        #springMessage('table.fexTranReq.exceptLowVal')
                                    #end
                                </td>
                                <td width="30%">$!number.formatDoubles($!{fexTranReq.exceptLowVal},4)</td>
                                #if($!{fexTranReq.fexOption2}=="3")
                                    ##高障碍值
                                    <td class="textRight" width="20%"><div id="exceptHignValTdDiv">#springMessage('table.fexTranReq.exceptHignVal')</div></td>
                                    <td width="30%">$!number.formatDoubles($!{fexTranReq.exceptHignVal},4)</td>
                                #else
                                    <td width="20%"></td>
                                    <td width="30%"></td>
                                #end
                            </tr>
                        #end
                        <tr>
                            ##持仓金额
                            <td class="textRight">#springMessage('table.fexTranReq.positionMoney')</td>
                            <td>$!number.formatNumeric($!{fexTranReq.positionMoney})</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            ##如果是否涉及退款 == 否 显示敲出1
            #if($!{fexTranReq.isRefund} == '0')
                <div class="layui-colla-item">
                    <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.info')</h2>
                    <div class="layui-colla-content layui-show">
                        <table class="layui-table breakRow">
                            <tbody>
                            <tr>
                                ##生命周期号码
                                <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.billNo')</td>
                                <td width="30%"> $!{vo.billNo}</td>
                                ##操作类型
                                <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.opType')</td>
                                <td width="30%">
                                    $dictTag.get("fexProduct.lifeCycle",${vo.opType})
                                    <div class="layui-input-inline">
                                        <input type="hidden" id="opType" name="opType" value="$!{vo.opType}"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                ##操作日期
                                <td class="textRight">#springMessage('table.fexTranLifeCycle.opDate')</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <input type="text" name="opDate" lay-verify="required" class="layui-input bt-biz-dateType"
                                               value="$!date.format('yyyy-MM-dd',$!{vo.opDate})"   data-type="date"
                                               data-name="opDate" data-biz-name="opDate" data-min="$!{fexTranReq.tranDate}"
                                               #if($!{fexTranReq.expiresDate})
                                               data-max="$!date.format('yyyy-MM-dd', $!{fexTranReq.expiresDate})"
                                               #end
                                        >
                                    </div>
                                </td>
                                ##参考汇率
                                <td class="textRight">#springMessage('table.fexTranLifeCycle.referRate')</td>
                                <td>
                                    <input type="text" data-id="spotRate" data-name="spotRate" data-biz-name="spotRate" data-decimal="6"
                                           lay-verify="required" value="$!{spotRateDefault}"
                                           id="spotRate" autocomplete="off" class="layui-input bt-biz-moneyType">
                                </td>
                            </tr>
                            <tr>
                                ##申请人
                                <td class="textRight">#springMessage('table.fexTranReq.dealer')</td>
                                <td>
                                    <input type="text" id="dealer"  data-required = "true" value="$!{dealer}" readonly="readonly"
                                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.dealer')">
                                </td>
                                <td></td>
                                <td></td>
                            </tr>
                            <tr>
                                ##备注
                                <td class="textRight">#springMessage('fcVoucherType.rmk')</td>
                                <td colspan="3">
                                    <textarea placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" lay-verify="strlength" data-maxlength="200" style="width:100%" id="rmk" name="rmk" ></textarea>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            #else
                ##如果是否涉及退款 == 是  显示敲出2
                <div class="layui-colla-item">
                    <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.info')</h2>
                    <div class="layui-colla-content layui-show">
                        <table class="layui-table breakRow">
                            <tbody>
                            <tr>
                                ##生命周期号码
                                <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.billNo')</td>
                                <td width="30%"> $!{vo.billNo}</td>
                                ##操作类型
                                <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.opType')</td>
                                <td width="30%">
                                    $dictTag.get("fexProduct.options.lifeCycle",${vo.opType})
                                    <div class="layui-input-inline">
                                        <input type="hidden" id="opType" name="opType" value="$!{vo.opType}"/>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                ##操作日期
                                <td class="textRight">#springMessage('table.fexTranLifeCycle.opDate')</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <input type="text" name="opDate" lay-verify="required" class="layui-input" id="opDate"
                                               value="$!date.format('yyyy-MM-dd',$!{vo.opDate})" data-type="date"
                                               data-name="opDate" data-biz-name="opDate" data-min="$!{fexTranReq.tranDate}"
                                                #if($!{fexTranReq.expiresDate})
                                                   data-max="$!date.format('yyyy-MM-dd', $!{fexTranReq.expiresDate})"
                                                #end
                                               >
                                    </div>
                                </td>
                                ##结算日期
                                <td class="textRight">#springMessage('table.fexTran.settleDate')</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <input type="text" name="settleDate" lay-verify="required" class="layui-input"
                                            #if($!{fexTranReq.refundTime} == '0')
                                                  value="$!date.format('yyyy-MM-dd',$!{fexTranReq.expiresDate})"
                                            #else
                                               data-today="true"
                                            #end
                                               data-type="date"
                                               data-name="settleDate" data-biz-name="settleDate" id="settleDate">
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                ##参考汇率
                                <td class="textRight">#springMessage('table.fexTranLifeCycle.referRate')</td>
                                <td>
                                    <input type="text" data-id="spotRate" data-name="spotRate" data-biz-name="spotRate" data-decimal="6"
                                           lay-verify="required" value="$!{spotRateDefault}"
                                           id="spotRate" autocomplete="off" class="layui-input bt-biz-moneyType">
                                </td>
                                ##结算币种
                                <td class="textRight">#springMessage('table.fexTranDeal.settleCurId')</td>
                                <td>
                                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="curId" data-biz-name ="curId"
                                         data-displayData="$!{fexTranReq.tranCurPairBaseId},$!{fexTranReq.tranCurPairReferId}"
                                         data-required="true" data-valueField="id" data-textField="englishCode" data-callback="bt.settleCurCallback"></div>
                                </td>
                            </tr>
                            <tr>
                                ##结算金额
                                <td class="textRight">#springMessage('table.fexTranDeal.settleMoney')</td>
                                <td>
                                    <input type="text" id = "settleMoney" data-minus="true" data-name="money" data-biz-name="money"
                                           class="layui-input bt-biz-moneyType" lay-verify="required"
                                           data-callback="bt.settleMoneyCallback" value="$!{fexTranReq.refundMoney}">
                                </td>
                                ##结算账号
                                <td class="textRight">#springMessage('table.fexTranDeal.settleBankAcc')</td>
                                <td>
                                    <input type="text" id="bankAcc" name="bankAcc"
                                           lay-verify="tableData|required" data-biz-name="bankAcc"
                                           autocomplete="off" class="layui-input text"
                                           placeholder="#springMessage('table.nisBillhead.payerAcc')"
                                           data-swapType="">
                                    <table id="bankAccTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.choBankFinance.acc')</th>
                                            <th>#springMessage('table.btBankAccApp.accName')</th>
                                            <th>#springMessage('table.btBankAcc.bankName')</th>
                                            <th>#springMessage('table.nisBillhead.curId')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                ##操作日记账汇率
                                <td class="textRight recordRateTd">#springMessage('table.fexTranDeal.recordRate')</td>
                                <td class="recordRateTd">
                                    <input type="text" id ="recordRate" name="recordRate" data-name="recordRate" data-biz-name="recordRate" data-decimal="6"
                                           class="layui-input bt-biz-moneyType" lay-verify="required" value="$!{spotRateDefault}" data-callback="bt.recordRateCallback" />
                                </td>
                                ##损益币种
                                <td class="textRight">#springMessage('table.fexTranReq.profitLossCur')</td>
                                <td>
                                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="profitLossCur" data-biz-name ="profitLossCur"
                                         data-required="true" data-disabled="true"
                                         data-valueField="id" data-textField="englishCode" data-defaultvalue="$!{fexTranReq.profitLossCur}"></div>
                                </td>
                            </tr>
                            <tr>
                                ##损益
                                <td class="textRight">#springMessage('table.fexTranReq.profitAndLoss')</td>
                                <td>
                                    <input type="text" id = "profitLossMoney" data-minus="true" data-name="profitLossMoney" data-biz-name="profitLossMoney"
                                           class="layui-input bt-biz-moneyType" lay-verify="required" data-callback="bt.profitLossMoneyCallback">
                                </td>
                                ##申请人
                                <td class="textRight">#springMessage('table.fexTranReq.dealer')</td>
                                <td>
                                    $!{dealer}
                                </td>
                            </tr>
                            #if("Y" == $!{isShowConvert})
                                <tr>
                                    ##折本位币报价方式
                                    <td class="textRight">#springMessage('table.fexTranReq.convertQuotationMethod')</td>
                                    <td><input type="text"  name="convertCurType" class="layui-input" lay-verify="required" value="$!{corpCurQuoMethod}"></td>
                                    ##折本位币汇率
                                    <td class="textRight">#springMessage('table.fexTranReq.convertBaseCurRate')</td>
                                    <td><input type="text" data-name="convertRate" data-biz-name="convertRate" class="layui-input bt-biz-moneyType"
                                               lay-verify="required" data-decimal="6" value="$!{convertRate}" data-callback="bt.convertRateCallback"></td>
                                </tr>
                                <tr>
                                    ##折本位币损益
                                    <td class="textRight">#springMessage('table.fexTranReq.convertBasePAndL')</td>
                                    <td>
                                        <input type="text" id = "convertLossMoney" data-minus="true" data-name="convertLossMoney" data-biz-name="convertLossMoney"
                                               class="layui-input bt-biz-moneyType" lay-verify="required" value="$!{vo.convertLossMoney}"></td>
                                </tr>
                            #end
                            <tr>
                                ##备注
                                <td class="textRight">#springMessage('table.common.rmk')</td>
                                <td colspan="3">
                                    <textarea class="layui-textarea" name="rmk" id="rmk" autocomplete="off" placeholder="#springMessage('table.common.rmk')" style="resize:none" cols="138" rows="2"></textarea>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            #end
        </div>
        <div style="text-align: center; padding-top: 10px;">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="11" >#springMessage('common.button.submit')</button>
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="0" >#springMessage('common.button.temp')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </form>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/foreign/foreignLifecycle/foreignLifecycle.knockout.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/foreign/foreignLifecycle/viewBill.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .amtDtl-table div.layui-input {
            text-align: right;
            padding-right: 4px;
        }
    </style>
</head>
<body>
<div class="web-body">
    <form class="layui-form" method="post" id="inputForm">
        <input type="hidden" id="id" name="id" value="$!{vo.id}"/>
        <input type="hidden" name="opType" value="8">
        <input type="hidden" id="status" value="0">
        <input type="hidden" id="reqId" name="reqId" value="$!{fexTranReq.id}">
        <input type="hidden" id="corpId" name="corpId" value="$!{fexTranReq.corpId}">
        ##报价方式左侧币种
        <input type="hidden" id="quotationCurId" value="$!{fexTranReq.quotationCurId}"/>
        <input type="hidden" id="isShowConvert" value="$!{isShowConvert}">
        <input type="hidden" id="buyCurId" name="buyCurId" value="$!{vo.buyCurId}">
        <input type="hidden" id="sellCurId" name="sellCurId" value="$!{vo.sellCurId}">
        <input type="hidden" id="tranAddrId" name="tranAddrId" value="$!{fexTranReq.tranAddrId}">
        <input type="hidden" id="fexTranType" name="fexTranType" value="$!{fexTranReq.fexTranType}">
        <input type="hidden" id="isSwapTran" name="isSwapTran" value="$!{fexTranReq.isSwapTran}">
        <div class="layui-collapse">
            <div class="layui-colla-item">
                ##合约信息
                <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.contractInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table breakRow">
                        <tbody>
                        <tr>
                            ##交易号码
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
                            <td width="30%">
                                <a class="" href="#" onclick="viewBill('$!{fexTranReq.id}')">
                                    $!{fexTranReq.billNo}
                                </a>
                            </td>
                            ##结算日期
                            <td class="textRight" width="20%">#springMessage('table.fcSubjectDay.optDate')</td>
                            <td width="30%">
                                $!date.format('yyyy-MM-dd',$!{vo.settleDate})
                            </td>
                        </tr>
                        <tr>
                            ##交割类型
                            <td class="textRight">#springMessage('table.fexTranReq.deliveryType')</td>
                            <td>
                                $dictTag.get("fexProduct.deliveryType",${fexTranReq.deliveryType})
                            </td>
                            #if($!{fexTranReq.tranType}=="1")
                                <td class="textRight" width="20%">#springMessage('fex.tranApp.currencyPairs')</td>
                                <td width="30%">
                                    $!{fexTranReq.tranCurPairIdName}
                                </td>
                            #elseif($!{fexTranReq.tranType}=="2")
                                <td class="textRight" width="20%">#springMessage(
                                    'table.fexTranReq.comparisionDate')</td>
                                <td>
                                    $!date.format('yyyy-MM-dd',$!{entity.expiresDate})
                                </td>
                            #end
                        </tr>
                        <tr>
                            <td class="textRight" width="20%">#springMessage('fex.tranApp2.businessDirection')</td>
                            <td width="30%">
                                $dictTag.get("fexTranDeal.deliverySign",${fexTranReq.busDirection})
                            </td>
                            ##报价方式
                            <td class="textRight" width="20%">#springMessage('fex.tranApp.quotationMethod')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    $!{fexTranReq.quotationMethod}
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.contractRate')</td>
                            <td width="30%">$!number.formatNumeric($!{vo.contractRate},"#0.000000")
                            </td>
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.positionMoney')</td>
                            <td width="30%">$!number.formatNumeric($!{vo.positionMoney})
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.info')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table breakRow">
                        <tbody>
                        <tr>
                            <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.billNo')</td>
                            <td width="30%">
                                $!{vo.billNo}
                            </td>
                            <td class="textRight" width="20%">#springMessage('table.nisMessage.messageType')</td>
                            <td width="30%">
                                $dictTag.get("fexProduct.lifeCycle",${vo.opType})
                            </td>
                        </tr>
                        <tr>
                            ##操作日期
                            <td class="textRight" width="20%">#springMessage('table.nisMessage.enrolDate')</td>
                            <td width="30%">
                                $!date.format('yyyy-MM-dd',$!{vo.opDate})
                            </td>
                            ##结算日期
                            <td class="textRight" width="20%">#springMessage('table.fcSubjectDay.optDate')</td>
                            <td width="30%">
                                $!date.format('yyyy-MM-dd',$!{vo.settleDate})
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.fexTranReq.amtDtl')</h2>
                <div class="layui-colla-content layui-show amtDtl-table">
                    <table class="layui-table breakRow">
                        <tbody>
                        <tr>
                            <td colspan="4">
                                <table class="layui-table layui-table-border">
                                    <thead>
                                    <tr>
                                        <th width="15%">#springMessage('table.foreign.currency')</th>
                                        <th width="15%">#springMessage('table.fcOutAccbook.direction')</th>
                                        <th width="35%">#springMessage('billPool.Limit.opMoney')</th>
                                        <th width="35%">#springMessage('table.bisAccBal.bal')</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                        #if($!{fexTranReq.busDirection}=="1")
                                        <tr>
                                            <td>$!{vo.buyCurCode}</td>
                                            <td>#springMessage('table.fexTranReq.direction.buy')</td>
                                            <td>
                                                <div class="layui-input">$!number.formatNumeric($!{vo.buyMoney})</div>
                                            </td>
                                            <td>
                                                <div class="layui-input">$!number.formatNumeric($!{vo.buyBal})</div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>$!{vo.sellCurCode}</td>
                                            <td>#springMessage('table.fexTranReq.direction.sell')</td>
                                            <td>
                                                <div class="layui-input">$!number.formatNumeric($!{vo.sellMoney})</div>
                                            </td>
                                            <td>
                                                <div class="layui-input">$!number.formatNumeric($!{vo.sellBal})</div>
                                            </td>
                                        </tr>
                                        #else
                                        <tr>
                                            <td>$!{vo.sellCurCode}</td>
                                            <td>#springMessage('table.fexTranReq.direction.sell')</td>
                                            <td>
                                                <div class="layui-input">$!number.formatNumeric($!{vo.sellMoney})</div>
                                            </td>
                                            <td>
                                                <div class="layui-input">$!number.formatNumeric($!{vo.sellBal})</div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>$!{vo.buyCurCode}</td>
                                            <td>#springMessage('table.fexTranReq.direction.buy')</td>
                                            <td>
                                                <div class="layui-input">$!number.formatNumeric($!{vo.buyMoney})</div>
                                            </td>
                                            <td>
                                                <div class="layui-input">$!number.formatNumeric($!{vo.buyBal})</div>
                                            </td>
                                        </tr>
                                        #end

                                    </tbody>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            ##提前交割方式
                            <td class="textRight">#springMessage('table.fexTranReq.earlySettlementType')</td>
                            <td>
                                $dictTag.get("fex.tranApp.earlySettlementType",${vo.earlySettlementType})
                            </td>
                            ##提前交割汇率
                            <td class="textRight">#springMessage('table.fexTranReq.earlySettlementRate')</td>
                            <td>$!number.formatNumeric($!{vo.earlySettlementRate},"#0.000000")</td>
                        </tr>
                        <tr>
                            ##  金额是否自动计算
                            <td class="textRight">#springMessage('fex.tranApp.isAutoCalculate')</td>
                            <td>
                                $dictTag.get("fexTranDeal.isAutoCalculate",${vo.isPaymentAmount})
                            </td>
                        </tr>
                        <tr>
                            ##买入金额
                            <td class="textRight">#springMessage('table.fexTranReq.buyMoney')</td>
                            <td>$!number.formatNumeric($!{vo.realBuyMoney})</td>
                            ##卖出金额
                            <td class="textRight">#springMessage('table.fexTranReq.sellMoney')</td>
                            <td>$!number.formatNumeric($!{vo.realSellMoney})</td>
                        </tr>
                        <tr>
                            ##即期汇率
                            <td class="textRight">#springMessage('table.fexTranDeal.wishRate')</td>
                            <td>$!number.formatNumeric($!{vo.spotRate},"#0.000000")</td>
                            ##损益币种
                            <td class="textRight">#springMessage('table.fexTranReq.profitLossCur')</td>
                            <td>
                                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                                     data-name="profitLossCur" data-biz-name="profitLossCur"
                                     data-valueField="id" data-textField="englishCode" data-disabled="true"
                                     data-defaultvalue="$!{vo.profitLossCur}"></div>
                            </td>
                        </tr>
                        <tr>
                            ##交割损益
                            <td class="textRight">#springMessage('table.fexTranReq.deliveryLossMoney')</td>
                            <td>$!number.formatNumeric($!{vo.deliveryLossMoney})</td>
                            ##收款账号
                            <td class="textRight">#springMessage('table.bisExc.payeeAcc')</td>
                            <td width="30%">
                                $!{fexTranReq.corpBankAcc}
                            </td>
                        </tr>
                        <tr>
                            ##付款账号
                            <td class="textRight">#springMessage('table.bisExc.payerAcc')</td>
                            <td width="30%">
                                $!{fexTranReq.srcBankAcc}
                            </td>
                        </tr>
                        #if("2" == ${vo.earlySettlementType})
                            <tr>
                                ##平仓结算日期
                                <td class="textRight">#springMessage('table.fexTranReq.closeSettleDate')</td>
                                <td>
                                    $!date.format('yyyy-MM-dd',$!{vo.opDate})
                                </td>
                                ##平仓远期汇率
                                <td class="textRight">#springMessage('table.fexTranReq.closeRate')</td>
                                <td>$!number.formatNumeric($!{vo.closeForwardRate},"#0.000000")</td>
                            </tr>
                            <tr>
                                ##结算币种
                                <td class="textRight">#springMessage('table.fexTranDeal.settleCurId')</td>
                                <td>
                                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                                         data-name="curId" data-biz-name="curId"
                                         data-valueField="id" data-textField="englishCode" data-defaultvalue="$!{vo.curId}"
                                         data-disabled="true"></div>
                                </td>
                                ##结算金额
                                <td class="textRight">#springMessage('table.fexTranDeal.settleMoney')</td>
                                <td>$!number.formatNumeric($!{vo.money})</td>
                            </tr>
                            <tr>
                                ##结算账号
                                <td class="textRight">#springMessage('table.fexTranDeal.settleBankAcc')</td>
                                <td>
                                    $!{vo.bankAcc}
                                </td>
                                ##操作日记账汇率
                                <td class="textRight">#springMessage('table.fexTranDeal.recordRate')</td>
                                <td>$!number.formatNumeric($!{vo.recordRate})</td>
                            </tr>
                            <tr>
                                ##平仓损益
                                <td class="textRight">#springMessage('table.fexTranDeal.closeLossMoney')</td>
                                <td>$!number.formatNumeric($!{vo.closeLossMoney})</td>
                                ##总损益
                                <td class="textRight">#springMessage('table.fexTranReq.allLossMoney')</td>
                                <td>$!number.formatNumeric($!{vo.allLossMoney})</td>
                            </tr>
                        #end
                        <tr>
                            ##申请人
                            <td class="textRight">#springMessage('table.fexTranReq.dealer')</td>
                            <td>
                                $!{dealer}
                            </td>
                            ##交易地点
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAddr')</td>
                            <td width="30%">
                                $!{vo.tranAddr}
                            </td>
                        </tr>
                        #if("Y" == $!{isShowConvert})
                            <tr>
                                ##折本位币报价方式
                                <td class="textRight">#springMessage('table.fexTranReq.convertQuotationMethod')</td>
                                <td>
                                    $!{vo.convertCurType}
                                </td>
                                ##折本位币汇率
                                <td class="textRight">#springMessage('table.fexTranReq.convertBaseCurRate')</td>
                                <td>$!number.formatNumeric($!{vo.convertRate},"#0.000000")</td>

                            </tr>
                            <tr>
                                ##折本位币损益
                                <td class="textRight">#springMessage('table.fexTranReq.convertBasePAndL')</td>
                                <td>$!number.formatNumeric($!{vo.convertLossMoney})</td>
                            </tr>
                        #end
                        <tr>
                            ##备注
                            <td class="textRight">#springMessage('table.common.rmk')</td>
                            <td colspan="3">
                                $!{vo.rmk}
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </form>
</div>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form', 'datatable', 'select', 'corp', 'dicts', 'selectType', 'rateType'], function () {
        $ = bt.jquery, form = bt.form();
        bt.dicts.init();
        bt.selectType.init();
        var rateType = bt.rateType.getFun();
    });
</script>
<script src="${basePath}/static/modules/foreign/foreignLifecycle/viewBill.js?_btv=${resourceVersion}"></script>
</body>
</html>

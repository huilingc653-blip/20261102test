<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="web-body">
    <form class="layui-form" method="post" id="inputForm">
        <input type="hidden" id="reqId" name= "reqId" value="$!{fexTranReq.id}">
        <input type="hidden" id="corpId" name= "corpId" value="$!{fexTranReq.corpId}">
        <input type="hidden" id="contractRate" value="$!{fexTranReq.contractRate}">
        <input type="hidden" id="tranCurPairIdName" value="$!{fexTranReq.tranCurPairIdName}"/>
        <input type="hidden" id="quotationMethod" value="$!{fexTranReq.quotationMethod}"/>
        <input type="hidden" id="busDirection" value="$!{fexTranReq.busDirection}">
        <input type="hidden" id="updownDirection" value="$!{fexTranReq.updownDirection}">
        <input type="hidden" id="positionMoney" value="$!{fexTranReq.positionMoney}"/>
        <input type="hidden" id ="tranType"  value="$!{fexTranReq.tranType}">
        <div class="layui-collapse">
            <div class="layui-colla-item">
                ##合约信息
                <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.contractInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table breakRow">
                        <tbody>
                        <tr>
                            ##交易号码
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
                            <td width="30%">
                                <a class="" href="#" onclick="viewBill('$!{fexTranReq.id}')">
                                    $!{fexTranReq.billNo}
                                </a>
                            </td>
                            ##到期日期
                            <td class="textRight" width="20%">#springMessage('fex.tranApp.expirationDate')</td>
                            <td width="30%">
                                $!date.format('yyyy-MM-dd',$!{fexTranReq.expiresDate})
                                <input type="hidden" name="expiresDate" value="$!date.format('yyyy-MM-dd',$!{fexTranReq.expiresDate})"/>
                            </td>
                        </tr>
                        <tr>
                            ##交割类型
                            <td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
                            <td>$dictTag.get("fexProduct.deliveryType",$!{fexTranReq.deliveryType})</td>
                            ##外汇期权品种
                            <td class="textRight">#springMessage('table.fexProduct.fexOption')</td>
                            <td>
                                $dictTag.get("fexProduct.fexOption1",$!{fexTranReq.fexOption1})&nbsp;
                                $dictTag.get("fexProduct.fexOption2",$!{fexTranReq.fexOption2})&nbsp;
                                $dictTag.get("fexProduct.fexOption3",$!{fexTranReq.fexOption3})
                            </td>
                        </tr>
                        <tr>
                            ##外汇期权类型
                            <td class="textRight">#springMessage('table.fexProduct.fexOptionType')</td>
                            <td>$dictTag.get("fexProduct.fexOptionType",$!{fexTranReq.fexOptionType})</td>
                            ##交易货币对
                            <td class="textRight">#springMessage('fex.tranApp.tranCurPair')</td>
                            <td>$!{fexTranReq.tranCurPairIdName}</td>
                        </tr>
                        <tr>
                            ##报价方式
                            <td class="textRight">#springMessage('fex.tranApp.quotationMethod')</td>
                            <td>$!{fexTranReq.quotationMethod}</td>
                            ##执行汇率
                            <td class="textRight">#springMessage('fex.tranApp.executeExchangeRate')</td>
                            <td>$!number.formatDoubles($!{fexTranReq.contractRate},6)</td>
                        </tr>
                        <tr>
                            ##买卖方向
                            <td class="textRight">#springMessage('fex.tranApp.busDirection')</td>
                            <td>$dictTag.get("fexTranDeal.deliverySign",$!{fexTranReq.busDirection})</td>
                            ##涨跌方向
                            <td class="textRight">#springMessage('fex.tranApp2.upAndDownDirection')</td>
                            <td>$dictTag.get("fex.tranApp2.updownDirection",$!{fexTranReq.updownDirection})</td>
                        </tr>
                        <tr>
                            ##持仓金额
                            <td class="textRight">#springMessage('table.fexTranReq.positionMoney')</td>
                            <td>$!number.formatNumeric($!{fexTranReq.positionMoney})</td>
                            ##
                            <td class="textRight"></td>
                            <td></td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.info')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table breakRow">
                        <tbody>
                        <tr>
                            ##生命周期号码
                            <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.billNo')</td>
                            <td width="30%"> $!{vo.billNo}</td>
                            ##操作类型
                            <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.opType')</td>
                            <td width="30%">
                                $dictTag.get("fexProduct.options.lifeCycle",${vo.opType})
                                <div class="layui-input-inline">
                                    <input type="hidden" id="opType" name="opType" value="$!{vo.opType}"/>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##操作日期
                            <td class="textRight">#springMessage('table.fexTranLifeCycle.opDate')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" name="opDate" lay-verify="required" class="layui-input bt-biz-dateType"
                                           value="$!date.format('yyyy-MM-dd',$!{fexTranReq.expiresDate})"  data-type="date"
                                           data-name="opDate" data-biz-name="opDate" data-min="$!{fexTranReq.tranDate}"
                                        #if($!{fexTranReq.expiresDate})
                                           data-max="$!date.format('yyyy-MM-dd', $!{fexTranReq.expiresDate})"
                                        #end>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight">#springMessage('table.fexTranReq.amtDtl')</td>
                            <td colspan="3">
                                <table class="layui-table layui-table-border ignore-required-icon">
                                    <thead>
                                    <tr>
                                        <th width="15%">#springMessage('table.fexForeign.curId')</th>
                                        <th width="15%">#springMessage('table.fexTranLifeCycle.direction')</th>
                                        <th width="35%"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranLifeCycle.opMoney')</th>
                                        <th width="35%">#springMessage('table.fexTranLifeCycle.balance')</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                     #if(($!{fexTranReq.busDirection}=="1" && $!{fexTranReq.updownDirection}=="0") ||
                                        ($!{fexTranReq.busDirection}=="2" && $!{fexTranReq.updownDirection}=="1"))
                                        <tr>
                                            <td>
                                                <input type="hidden" name="buyCurId" value="$!{fexTranReq.tranCurPairBaseCode}">
                                                $!{fexTranReq.tranCurPairBaseCode}
                                            </td>##交易货币对左侧币种
                                            <td>#springMessage('table.fexTranReq.direction.buy')</td>
                                            <td><input type="text" id="firstMoney" data-name="buyMoney" data-biz-name="buyMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                       data-callback="bt.firstMoneyCallback"  data-max="$!{fexTranReq.positionMoney}"
                                                       value="$!{vo.getBuyMoney()}" >
                                            </td>
                                            <td>
                                                <input type="text" class="layui-input bt-biz-moneyType" id="firstBal" data-name="buyBal" data-biz-name="buyBal" autocomplete="off" value="0.0" readonly>
                                            </td>
                                            <input type="hidden" id="opMoney" name="opMoney" value="$!{vo.getBuyMoney()}">
                                        </tr>
                                        <tr>
                                            <td width="8%">
                                                <input type="hidden" name="sellCurId" value="$!{fexTranReq.tranCurPairReferCode}">
                                                $!{fexTranReq.tranCurPairReferCode}
                                            </td>##交易货币对右侧币种
                                            <td width="8%">#springMessage('table.fexTranReq.direction.sell')</td>
                                            <td width="42%">
                                                <input type="text" id="secondMoney" data-name="sellMoney" data-biz-name="sellMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                       data-callback="bt.secondMoneyCallback" data-max="$!{secondOpMoneyMax}"
                                                       value="$!{vo.getSellMoney()}" >
                                            </td>
                                            <td width="42%">
                                                <input type="text" id="secondBal" data-name="sellBal" data-biz-name="sellBal" autocomplete="off" class="layui-input bt-biz-moneyType" value="0.0" readonly>
                                            </td>
                                        </tr>
                                     #else
                                        <tr>
                                            <td>
                                                <input type="hidden" name="sellCurId" value="$!{fexTranReq.tranCurPairBaseCode}">
                                                $!{fexTranReq.tranCurPairBaseCode}
                                            </td>##交易货币对左侧币种
                                            <td width="8%">#springMessage('table.fexTranReq.direction.sell')</td>
                                            <td><input type="text" id="firstMoney" data-name="sellMoney" data-biz-name="sellMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                       data-callback="bt.firstMoneyCallback"  data-max="$!{fexTranReq.positionMoney}"
                                                       value="$!{vo.getSellMoney()}" >
                                            </td>
                                            <td width="42%">
                                                <input type="text" id="firstBal" data-name="sellBal" data-biz-name="sellBal" autocomplete="off" class="layui-input bt-biz-moneyType" value="0.0" readonly>
                                            </td>
                                            <input type="hidden" id="opMoney" name="opMoney" value="$!{vo.getSellMoney()}">
                                        </tr>
                                        <tr>
                                            <td width="8%">
                                                <input type="hidden" name="buyCurId" value="$!{fexTranReq.tranCurPairReferCode}">
                                                $!{fexTranReq.tranCurPairReferCode}
                                            </td>##交易货币对右侧币种
                                            <td>#springMessage('table.fexTranReq.direction.buy')</td>
                                            <td width="42%">
                                                <input type="text" id="secondMoney" data-name="buyMoney" data-biz-name="buyMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                       data-callback="bt.secondMoneyCallback" data-max="$!{secondOpMoneyMax}"
                                                    #if($!{vo.getBuyMoney()} != '' || $!{vo.getBuyMoney()} != 'null')
                                                       value="$!{vo.getBuyMoney()}"
                                                    #else
                                                       value="$!{firstOpMoneyDefault}"
                                                    #end >
                                            </td>
                                            <td width="42%">
                                                <input type="text" id="secondBal" data-name="buyBal" data-biz-name="buyBal" autocomplete="off" class="layui-input bt-biz-moneyType" value="0.0" readonly>
                                            </td>
                                        </tr>
                                     #end
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            ##即期汇率
                            <td class="textRight">#springMessage('table.fexTranDeal.wishRate')</td>
                            <td>
                                <input type="text" name="spotRate" data-biz-name='spotRate' class="layui-input bt-biz-moneyType" lay-verify="required"
                                       data-decimal="6" value="$!{spotRateDefault}"></td>
                            ##申请人
                            <td class="textRight">#springMessage('table.fexTranReq.dealer')</td>
                            <td><input type="text" name="createBy" class="layui-input" lay-verify="required" value="$!{dealer}" readonly></td>
                        </tr>
                        <tr>
                            ##备注
                            <td class="textRight">#springMessage('fcVoucherType.rmk')</td>
                            <td colspan="3">
                                <textarea class="layui-textarea" name="rmk" id="rmk" data-maxlength="500" autocomplete="off" placeholder="#springMessage('table.common.rmk')" style="resize:none" cols="138" rows="2"></textarea>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div style="text-align: center; padding-top: 10px;">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="11" >#springMessage('common.button.submit')</button>
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="0" >#springMessage('common.button.temp')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </form>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/foreign/foreignLifecycle/foreignLifecycle.waive.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/foreign/foreignLifecycle/viewBill.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="web-body">
    <form class="layui-form" method="post" id="inputForm">
        <input type="hidden" id = "id" name = "id" value="$!{vo.id}"/>
        <input type="hidden" name = "opType" value="11">
        <input type="hidden" id ="corpId" name = "corpId" value="$!{fexTranReq.corpId}">
        <input type="hidden" id ="reqId" name = "reqId" value="$!{fexTranReq.id}">
        <input type="hidden" id ="status"  value="0">
        ## 付款账号
        <input type="hidden" id="srcBankAcc" value="$!{fexTranReq.srcBankAcc}">
        ## 收款账号
        <input type="hidden" id="corpBankAcc" value="$!{fexTranReq.corpBankAcc}">
        ## 产品ID
        <input type="hidden" id="proId"  value="$!{fexTranReq.proId}">
        ##交易货币对
        <input type="hidden" id = "tranCurPairIdName" value="$!{fexTranReq.tranCurPairIdName}"/>
        ##报价方式
        <input type="hidden" id = "quotationMethod" value="$!{fexTranReq.quotationMethod}"/>
        ##报价方式左侧币种
        <input type="hidden" id = "quotationCurId" value="$!{fexTranReq.quotationCurId}"/>
        <input type="hidden" id="isShowConvert" value="$!{isShowConvert}">
        <input type="hidden" id = "deliveryType" value="$!{fexTranReq.deliveryType}">
        <input type="hidden" id ="buyCurId" name = "buyCurId" value="$!{vo.buyCurId}">
        <input type="hidden" id ="sellCurId" name = "sellCurId" value="$!{vo.sellCurId}">
        <input id="rateTypeId" type="hidden" value="$!{rateTypeId}">
        <input type="hidden" id ="tranAddrId" value="$!{fexTranReq.tranAddrId}">
        <input type="hidden" id ="fexTranType"  value="$!{fexTranReq.fexTranType}">
        <input type="hidden" id ="tranType"  value="$!{fexTranReq.tranType}">
        <input type="hidden"  id="isSwapTran"  value="$!{fexTranReq.isSwapTran}">
        <!-- 主体单位账户信息 -->
        <input type="hidden" id="corpBank" value="$!{fexTranReq.corpBank}">
        <div class="layui-collapse">
            <div class="layui-colla-item">
                ##合约信息
                <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.contractInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table breakRow">
                        <tbody>
                        <tr>
                            ##交易号码
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
                            <td width="30%">
                                <a class="" href="#" onclick="viewBill('$!{fexTranReq.id}')">
                                    $!{fexTranReq.billNo}
                                </a>
                            </td>
                            ##结算日期
                            <td class="textRight" width="20%">#springMessage('table.fcSubjectDay.optDate')</td>
                            <td width="30%">
                                $!date.format('yyyy-MM-dd',$!{fexTranReq.settleDate})
                            </td>
                        </tr>
                        <tr>
                            ##交割类型
                            <td class="textRight">#springMessage('table.fexTranReq.deliveryType')</td>
                            <td>
                                $dictTag.get("fexProduct.deliveryType",${fexTranReq.deliveryType})
                            </td>
                            #if($!{fexTranReq.tranType}=="1")
                                <td class="textRight" width="20%">#springMessage('fex.tranApp.currencyPairs')</td>
                                <td width="30%">
                                    $!{fexTranReq.tranCurPairIdName}
                                    <input id="tranCurPairBaseId" name="tranCurPairBaseId" type="hidden" value="$!{fexTranReq.tranCurPairBaseId}">
                                    <input id="tranCurPairReferId" name="tranCurPairReferId" type="hidden" value="$!{fexTranReq.tranCurPairReferId}">
                                </td>
                            #elseif($!{fexTranReq.tranType}=="2")
                                <td class="textRight" width="20%">#springMessage('table.fexTranReq.comparisionDate')</td>
                                <td>
                                    <input type="text" class="layui-input" name="expiresDate" value="$!date.format('yyyy-MM-dd',$!{entity.expiresDate})" readonly>
                                </td>
                            #end
                        </tr>
                        <tr>
                            <td class="textRight" width="20%">#springMessage('fex.tranApp2.businessDirection')</td>
                            <td width="30%">
                                $dictTag.get("fexTranDeal.deliverySign",${fexTranReq.busDirection})
                                <input type="hidden" id = "busDirection" value="$!{fexTranReq.busDirection}">
                            </td>
                            ##报价方式
                            <td class="textRight" width="20%">#springMessage('fex.tranApp.quotationMethod')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    $!{fexTranReq.quotationMethod}
                                    <input type="hidden" id="quotationMethod" name="quotationMethod" value="$!{fexTranReq.quotationMethod}" />
                                    <input id="quotationCurId" name="quotationCurId" type="hidden" value="$!{fexTranReq.quotationCurId}">
                                    <input id="quotationReferCurId" name="quotationReferCurId" type="hidden" value="$!{fexTranReq.quotationReferCurId}">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.contractRate')</td>
                            <td width="30%">
                                $!number.formatNumeric($!{fexTranReq.contractRate},"#0.000000")
                                <input type="hidden" id="contractRate"  value="$!{fexTranReq.contractRate}">
                            </td>
                            <td class="textRight" width="20%">#springMessage('table.fexTranReq.positionMoney')</td>
                            <td width="30%">
                                $!number.formatNumeric($!{fexTranReq.positionMoney})
                                <input type="hidden" id="positionMoney"  value="$!{fexTranReq.positionMoney}">
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.fexTranLifeCycle.info')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table breakRow">
                        <tbody>
                        <tr>
                            <td class="textRight" width="20%">#springMessage('table.fexTranLifeCycle.billNo')</td>
                            <td width="30%">
                                $!{vo.billNo}
                            </td>
                            <td class="textRight" width="20%">#springMessage('table.nisMessage.messageType')</td>
                            <td width="30%">
                                $dictTag.get("fexProduct.lifeCycle",${vo.opType})
                                <div class="layui-input-inline">
                                    <input type="hidden" id="opType" name="opType" value="$!{vo.opType}"/>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##操作日期
                            <td class="textRight" width="20%">#springMessage('table.nisMessage.enrolDate')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    <input type="text" name="opDate" lay-verify="required" class="layui-input bt-biz-dateType"
                                           value="$!date.format('yyyy-MM-dd',$!{vo.opDate})" data-today="true"  data-type="date"
                                           data-name="opDate" data-biz-name="opDate" data-min="$!{fexTranReq.tranDate}" data-max="$!{fexTranReq.settleDate}">
                                </div>
                            </td>
                            ##结算日期
                            <td class="textRight" width="20%">#springMessage('table.fcSubjectDay.optDate')</td>
                            <td width="30%">
                                <div class="layui-input-inline">
                                    <input type="text" name="settleDate"  data-name="settleDate" data-biz-name="settleDate" value="$!date.format('yyyy-MM-dd',$!{fexTranReq.settleDate})"
                                           data-min="$!{vo.settleDate}" data-type="date" lay-verify="required" class="layui-input bt-biz-dateType" data-callback="bt.settleDateCallback">
                                </div>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.fexTranReq.amtDtl')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table breakRow">
                        <tbody>
                        <tr>
                            <td colspan="4">
                                <table class="layui-table layui-table-border">
                                    <thead>
                                    <tr>
                                        <th width="15%">#springMessage('table.foreign.currency')</th>
                                        <th width="15%">#springMessage('table.fcOutAccbook.direction')<div class="layui-input-inline" style="margin-left: 6px;">
                                            <i id="direction-desc" class="layui-icon">&#xe60b;</i>
                                        </div></th>
                                        <th width="35%"><span class="pl"><span class="required-icon">*</span></span>#springMessage('billPool.Limit.opMoney')</th>
                                        <th width="35%">#springMessage('table.bisAccBal.bal')</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                        #if($!{fexTranReq.busDirection}=="1")
                                            <tr>
                                                <td>$!{vo.buyCurCode}</td>
                                                <td>#springMessage('table.fexTranReq.direction.buy')</td>
                                                <td><input type="text" id="firstMoney" data-name="buyMoney" data-biz-name="buyMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                           lay-verify="required" data-callback="bt.firstMoneyCallback"  value="$!{vo.buyMoney}" data-max="$!{fexTranReq.positionMoney}"></td>
                                                <td>
                                                    <input type="text" id="firstBal" data-name="buyBal" data-biz-name="buyBal" autocomplete="off" value="0.0"
                                                           class="layui-input bt-biz-moneyType"  readonly>
                                                </td>
                                                <input type="hidden" id="opMoney" name="opMoney" value="$!{vo.buyMoney}">
                                            </tr>
                                            <tr>
                                                <td width="8%">$!{vo.sellCurCode}</td>
                                                <td width="8%">#springMessage('table.fexTranReq.direction.sell')</td>
                                                <td width="42%">
                                                    <input type="text" id="secondMoney" data-name="sellMoney" data-biz-name="sellMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                           lay-verify="required" data-callback="bt.secondMoneyCallback" value="$!{vo.sellMoney}" data-max="$!{maxOpMoney}">
                                                </td>
                                                <td width="42%">
                                                    <input type="text" id="secondBal" data-name="sellBal" data-biz-name="sellBal" autocomplete="off" class="layui-input bt-biz-moneyType" value="0.0" readonly>
                                                </td>
                                            </tr>
                                        #else
                                            <tr>
                                                <td width="8%">$!{vo.sellCurCode}</td>
                                                <td width="8%">#springMessage('table.fexTranReq.direction.sell')</td>
                                                <td width="42%">
                                                    <input type="text" id="firstMoney" data-name="sellMoney" data-biz-name="sellMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                           lay-verify="required" data-callback="bt.firstMoneyCallback" value="$!{vo.sellMoney}" data-max="$!{fexTranReq.positionMoney}">
                                                </td>
                                                <td width="42%">
                                                    <input type="text" id="firstBal" data-name="sellBal" data-biz-name="sellBal" autocomplete="off" class="layui-input bt-biz-moneyType" value="0.0" readonly>
                                                </td>
                                                <input type="hidden" id="opMoney" name="opMoney" value="$!{vo.sellMoney}">
                                            </tr>
                                            <tr>
                                                <td>$!{vo.buyCurCode}</td>
                                                <td>#springMessage('table.fexTranReq.direction.buy')</td>
                                                <td><input type="text" id="secondMoney" data-name="buyMoney" data-biz-name="buyMoney" autocomplete="off" class="layui-input bt-biz-moneyType"
                                                           lay-verify="required" data-callback="bt.secondMoneyCallback" value="$!{vo.buyMoney}" data-max="$!{maxOpMoney}"></td>
                                                <td>
                                                    <input type="text" id="secondBal" data-name="buyBal" data-biz-name="buyBal" autocomplete="off" class="layui-input bt-biz-moneyType" value="0.0" readonly>
                                                </td>
                                            </tr>
                                        #end
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                            #if($!{fexTranReq.deliveryType}=="0")
                                <tr>
                                    ##即期汇率
                                    <td class="textRight">#springMessage('table.fexTranDeal.wishRate')</td>
                                    <td>
                                        <input type="text" name="spotRate" data-name="spotRate" data-biz-name="spotRate" class="layui-input bt-biz-moneyType"
                                               lay-verify="required" data-decimal="6" value="$!{vo.spotRate}" data-callback="bt.spotRateCallback">
                                    </td>
                                </tr>
                                <tr>
                                    ##损益币种
                                    <td class="textRight">#springMessage('table.fexTranReq.profitLossCur')</td>
                                    <td>
                                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                                             data-name ="profitLossCur" data-biz-name ="profitLossCur" data-disabled="true"
                                             data-valueField="id" data-textField="englishCode" data-defaultvalue="$!{vo.profitLossCur}" ></div>
                                    </td>
                                    ##损益
                                    <td class="textRight">#springMessage('table.fexTranReq.profitAndLoss')</td>
                                    <td><input type="text" id = "profitLossMoney" data-minus="true" data-name="profitLossMoney"  data-biz-name="profitLossMoney" class="layui-input bt-biz-moneyType"
                                               lay-verify="required" value="$!{vo.profitLossMoney}" data-callback="bt.profitLossMoneyCallback"></td>
                                </tr>
                                <tr>
                                    ##收款账号
                                    <td class="textRight">#springMessage('table.bisExc.payeeAcc')</td>
                                    <td width="30%">
                                        <input type="text" id="payeeAcc" name="payeeAcc"
                                               lay-verify="tableData|required" data-biz-name="payeeAcc"
                                               value="$!{fexTranReq.corpBankAcc}"
                                               autocomplete="off" class="layui-input text"
                                               placeholder="#springMessage('table.nisBillhead.payeeAcc')"
                                               data-swapType="">
                                        <table id="payeeAccTable" class="hide">
                                            <thead>
                                            <tr>
                                                <th>#springMessage('table.choBankFinance.acc')</th>
                                                <th>#springMessage('table.btBankAccApp.accName')</th>
                                                <th>#springMessage('table.btBankAcc.bankName')</th>
                                                <th>#springMessage('table.nisBillhead.curId')</th>
                                            </tr>
                                            </thead>
                                        </table>
                                    </td>
                                    ##付款账号
                                    <td class="textRight">#springMessage('table.bisExc.payerAcc')</td>
                                    <td width="30%">
                                        <input type="text" id="payerAcc" name="payerAcc"
                                               lay-verify="tableData|required" data-biz-name="payerAcc"
                                               value="$!{fexTranReq.srcBankAcc}"
                                               autocomplete="off" class="layui-input text"
                                               placeholder="#springMessage('table.nisBillhead.payerAcc')"
                                               data-swapType="">
                                        <table id="payerAccTable" class="hide">
                                            <thead>
                                            <tr>
                                                <th>#springMessage('table.choBankFinance.acc')</th>
                                                <th>#springMessage('table.btBankAccApp.accName')</th>
                                                <th>#springMessage('table.btBankAcc.bankName')</th>
                                                <th>#springMessage('table.nisBillhead.curId')</th>
                                            </tr>
                                            </thead>
                                        </table>
                                    </td>
                                </tr>
                            #else
                                <tr>
                                    ##平仓远期汇率
                                    <td class="textRight">#springMessage('table.fexTranDeal.wishRate')</td>
                                    <td>
                                        <input type="text" data-name="spotRate" data-biz-name="spotRate" class="layui-input bt-biz-moneyType" lay-verify="required" value="$!{vo.spotRate}"
                                               data-decimal="6" data-callback="bt.spotRateCallback">
                                    </td>
                                    ##结算币种
                                    <td class="textRight">#springMessage('table.fexTranDeal.settleCurId')</td>
                                    <td>
                                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="curId" data-biz-name ="curId" data-displayData="$!{fexTranReq.tranCurPairBaseId},$!{fexTranReq.tranCurPairReferId}"
                                             data-required="true" data-valueField="id" data-textField="englishCode" data-callback="bt.settleCurCallback"></div>
                                    </td>
                                </tr>
                                <tr>
                                    ##结算金额
                                    <td class="textRight">#springMessage('table.fexTranDeal.settleMoney')</td>
                                    <td>
                                        <input type="text" id = "settleMoney" data-minus="true" data-name="money" data-biz-name="money"
                                               class="layui-input bt-biz-moneyType" lay-verify="required" value="$!{vo.money}" data-callback="bt.settleMoneyCallback">
                                    </td>
                                    ##结算账号
                                    <td class="textRight">#springMessage('table.fexTranDeal.settleBankAcc')</td>
                                    <td>
                                        <input type="text" id="bankAcc" name="bankAcc" data-name="bankAcc"
                                               lay-verify="tableData|required" data-biz-name="bankAcc"
                                               autocomplete="off" class="layui-input text"
                                               placeholder="#springMessage('table.fexTranDeal.settleBankAcc')"
                                               data-swapType="">
                                        <table id="bankAccTable" class="hide">
                                            <thead>
                                            <tr>
                                                <th>#springMessage('table.choBankFinance.acc')</th>
                                                <th>#springMessage('table.btBankAccApp.accName')</th>
                                                <th>#springMessage('table.btBankAcc.bankName')</th>
                                                <th>#springMessage('table.nisBillhead.curId')</th>
                                            </tr>
                                            </thead>
                                        </table>
                                    </td>
                                </tr>
                                <tr class="recordRateTr">
                                    ##操作日记账汇率
                                    <td class="textRight">#springMessage('table.fexTranDeal.recordRate')</td>
                                    <td>
                                        <input type="text" id ="recordRate" name="recordRate" data-name="recordRate" data-biz-name="recordRate" class="layui-input bt-biz-moneyType"
                                               data-decimal="6"  lay-verify="required" value="$!{vo.spotRate}" data-callback="bt.recordRateCallback" />
                                    </td>
                                </tr>
                                <tr>
                                    ##损益币种
                                    <td class="textRight">#springMessage('table.fexTranReq.profitLossCur')</td>
                                    <td>
                                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="profitLossCur" data-biz-name ="profitLossCur"
                                             data-valueField="id" data-textField="englishCode" data-defaultvalue="$!{fexTranReq.profitLossCur}" data-disabled="true"
                                             data-displayData="$!{fexTranReq.tranCurPairBaseId},$!{fexTranReq.tranCurPairReferId}"></div>
                                    </td>
                                    ##损益
                                    <td class="textRight">#springMessage('table.fexTranReq.profitAndLoss')</td>
                                    <td>
                                        <input type="text" id = "profitLossMoney" data-minus="true" data-name="profitLossMoney" data-biz-name="profitLossMoney" class="layui-input bt-biz-moneyType"
                                               lay-verify="required" value="$!{vo.profitLossMoney}" data-callback="bt.profitLossMoneyCallback">
                                    </td>
                                </tr>
                            #end
                            #if("Y" == $!{isShowConvert})
                                <tr>
                                    ##折本位币报价方式
                                    <td class="textRight">#springMessage('table.fexTranReq.convertQuotationMethod')</td>
                                    <td>
                                        <input type="text"  name="convertCurType" class="layui-input" lay-verify="required" value="$!{corpCurQuoMethod}" readonly>
                                    </td>
                                    ##折本位币汇率
                                    <td class="textRight">#springMessage('table.fexTranReq.convertBaseCurRate')</td>
                                    <td><input type="text" data-name="convertRate" data-biz-name="convertRate" class="layui-input bt-biz-moneyType"
                                               lay-verify="required" value="$!{convertRate}" data-callback="bt.convertRateCallback" data-decimal="6"></td>
                                </tr>
                                <tr>
                                    ##折本位币损益
                                    <td class="textRight">#springMessage('table.fexTranReq.convertBasePAndL')</td>
                                    <td>
                                        <input type="text" id = "convertLossMoney" data-minus="true" data-name="convertLossMoney" data-biz-name="convertLossMoney"
                                               class="layui-input bt-biz-moneyType" lay-verify="required" value="$!{vo.convertLossMoney}">
                                    </td>
                                </tr>
                            #end
                            <tr>
                                ##申请人
                                <td class="textRight">#springMessage('table.fexTranReq.dealer')</td>
                                <td>
                                    $!{dealer}
                                </td>
                                ##交易地点
                                <td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAddr')</td>
                                <td width="30%">
                                    <div class="layui-input-inline">
                                        <input id="tranAddrId" name="tranAddrId" type="hidden" value="$!{fexTranReq.tranAddrId}">
                                        <input type="text" id="tranAddr" name="tranAddr" #*lay-verify="tableData"*# data-biz-name="tranAddr"
                                               autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.tranAddr')" value="$!{fexTranReq.tranAddr}">
                                        <table id="tranAddrTable" class="hide">
                                            <thead>
                                            <tr>
                                                <th>#springMessage('table.tbCreditPeriod.code')</th>
                                                <th>#springMessage('table.btswiftinfo.namezh')</th>
                                                <th>#springMessage('table.btswiftinfo.nameen')</th>
                                            </tr>
                                            </thead>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                ##备注
                                <td class="textRight">#springMessage('fcVoucherType.rmk')</td>
                                <td colspan="3">
                                            <textarea placeholder="#springMessage('bisAccAttribute.rmk')"
                                                      class="layui-textarea" lay-verify="strlength" data-maxlength="200"
                                                      style="width:100%" id="rmk"
                                                      name="rmk"></textarea>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div style="text-align: center; padding-top: 10px;">
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
            <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </form>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/foreign/foreignLifecycle/foreignLifecycle.delivery.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/foreign/foreignLifecycle/viewBill.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
	<ul class="layui-tab-title">
		<li class="layui-this">#springMessage('table.rasBackQuery.msg')</li>
		<li>#springMessage('table.fexTranReq.cashFlow')</li>
		<li>#springMessage('fex.cotp.customInformation')</li>
	</ul>
	<div class="layui-tab-content">
		<div class="layui-tab-item layui-show">
			<form class="layui-form" method="post">
				<!-- 系统参数 -->
				<input id="id" name="id" type="hidden" value="$!{fexTranReqPage.id}">
				<input id="billNo" name="billNo" type="hidden" value="$!{fexTranReqPage.billNo}">
				<input id="corpId" name="corpId" type="hidden" value="$!{fexTranReqPage.corpId}">
				<input id="settleDate" name="settleDate" type="hidden" value="$!{fexTranReqPage.settleDate}">
				<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
				<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
				<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
				<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
				<input id="busType" name="busType" type="hidden" value="$!{busType}">
				<input id="busDirection" name="busDirection" type="hidden" value="$!{fexTranReqPage.busDirection}">

				<!-- 资金计划参数 明细项控制模式-->
				<input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
				<input id="curId" name="curId" type="hidden" value="$!{fexTranReqPage.curId}">
				<div id="print">
					<table class="layui-table">
						<tbody>
						<tr>
							##交易号码
							<td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
							<td width="30%">$!{fexTranReqPage.billNo}</td>
							##交易需求编号
							<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAppDtlNo')</td>
							<td width="30%">$!{fexTranReqPage.tranAppDtlNo}</td>
						</tr>
						</tbody>
					</table>
					<div class="layui-collapse">
						<div class="layui-colla-item">
							<h2 class="layui-colla-title">#springMessage('cms.loan.oldInfo')</h2>
							<div class="layui-colla-content layui-show">
								<table class="layui-table">
									<tbody>
									<tr>
										##产品
										<td class="textRight" width="20%">#springMessage('table.foreign.product')</td>
										<td width="30%">$!{fexTranReqPage.proName}</td>
										##单位
										<td class="textRight" width="20%">#springMessage('table.nisBillhead.corpId')</td>
										<td>$!{fexTranReqPage.corpName}</td>
									</tr>
									<tr>
										##主体单位账号
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.corpBankAcc')</td>
										<td width="30%">$!{fexTranReqPage.corpBankAcc}</td>
										##主体单位银行
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.corpBank')</td>
										<td>$!{fexTranReqPage.corpBankName}</td>
									</tr>
									<tr>
##										##交易对手 02外部交易方
##										<td class="textRight" width="20%">#springMessage('fex.tranApp.cotpBank')</td>
##										<td width="30%">$!{fexTranReqPage.cotpName}</td>
										##交易对手银行
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.cotpBank')</td>
										<td>$!{fexTranReqPage.cotpBankName}</td>
										##波动率
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.volatility')</td>
										<td width="30%">$!rateTag.show($!{fexTranReqPage.volatility},2)</td>
									</tr>
									<tr>
										##交易对手银行账户
										<td class="textRight" width="20%">#springMessage('fex.cotp')#springMessage('table.fexForeign.bankAcc')</td>
										<td width="30%">$!{fexTranReqPage.cotpBankAcc}</td>
										##交易货币对
										<td class="textRight">#springMessage('fex.tranApp.currencyPairs')</td>
										<td>$!{fexTranReqPage.tranCurPairIdName}</td>
									</tr>
									<tr>
										##报价方式
										<td class="textRight">#springMessage('fex.tranApp.quotationMethod')</td>
										<td>$!{fexTranReqPage.quotationMethod}</td>
										##持仓金额
										<td class="textRight">#springMessage('table.fexTranReq.positionMoney')</td>
										<td>$!number.formatNumeric($!{fexTranReqPage.positionMoney})</td>
									</tr>
									<tr>
										##外汇期权类型
										<td class="textRight">#springMessage('table.fexProduct.fexOptionType')</td>
										<td>$dictTag.get("fexProduct.fexOptionType",$!{fexTranReqPage.fexOptionType})</td>
										##外汇期权品种
										<td class="textRight">#springMessage('table.fexProduct.fexOption')</td>
										<td>
											$dictTag.get("fexProduct.fexOption1",$!{fexTranReqPage.fexOption1})&nbsp;
											$dictTag.get("fexProduct.fexOption2",$!{fexTranReqPage.fexOption2})&nbsp;
											$dictTag.get("fexProduct.fexOption3",$!{fexTranReqPage.fexOption3})
										</td>
									</tr>
									<tr>
										##买卖方向
										<td class="textRight">#springMessage('fex.tranApp2.businessDirection')</td>
										<td>$dictTag.get("fexTranDeal.deliverySign",$!{fexTranReqPage.busDirection})</td>
										##跌涨方向
										<td class="textRight">#springMessage('fex.tranApp2.upAndDownDirection')</td>
										<td >$dictTag.get("fex.tranApp2.updownDirection",$!{fexTranReqPage.updownDirection})</td>
									</tr>
									<tr>
										##交割类型 0-现金、0-即期交易
										<td class="textRight">#springMessage('table.fexProduct.deliveryType')</td>
										<td>$dictTag.get("fexProduct.deliveryType",$!{fexTranReqPage.deliveryType})</td>
										#if($!{fexTranReqPage.fexOption2}=="2" || $!{fexTranReqPage.fexOption2}=="3")
											##障碍验证标准 0-即期汇率、1-即期汇率对应的货币价值
											<td class="textRight">#springMessage('table.fexTranReq.validStandard')</td>
											<td>$dictTag.get("fexProduct.validStandard",$!{fexTranReqPage.validStandard})</td>
										#else
											<td></td>
											<td></td>
										#end
									</tr>
									</tbody>
								</table>
							</div>
						</div>

						<div class="layui-colla-item">
							<h2 class="layui-colla-title">#springMessage('fex.tranApp2.buyInfo')</h2>
							<div class="layui-colla-content layui-show">
								<table class="layui-table">
									<tbody>
									<tr>
										##执行汇率
										<td class="textRight" width="20%">#springMessage('fex.tranApp.executeExchangeRate')</td>
										<td>$!number.formatDoubles($!{fexTranReqPage.contractRate},6)</td>
										##即期汇率
										<td class="textRight" width="20%">#springMessage('table.fexTranDeal.wishRate')</td>
										<td>
											#if($!{fexTranReqPage.spotRate})
												$!number.formatDoubles($!{fexTranReqPage.spotRate},6)
											#end
										</td>
									</tr>
									<tr>
										##金额是否自动计算
										<td class="textRight" width="20%">#springMessage('fex.tranApp.isAutoCalculate')</td>
										<td>$dictTag.get("sf_yn",$!{fexTranReqPage.isPaymentAmount})</td>
									</tr>
									<tr>
										##买入币种
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.buyCurId')</td>
										<td width="30%">$!{fexTranReqPage.buyEnglishCode}</td>
										##卖出币种
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.sellCurId')</td>
										<td width="30%">$!{fexTranReqPage.sellEnglishCode}</td>

									</tr>
									<tr>
										##买出金额
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.buyMoney')</td>
										<td width="30%">$!number.formatNumeric($!{fexTranReqPage.buyMoney})</td>
										##卖出金额
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.sellMoney')</td>
										<td width="30%">$!number.formatNumeric($!{fexTranReqPage.sellMoney})</td>
									</tr>
									</tbody>
								</table>
							</div>
						</div>

##						<div class="layui-colla-item">
##							<h2 class="layui-colla-title">#springMessage('fex.tranApp2.sellInfo')</h2>
##							<div class="layui-colla-content layui-show">
##								<table class="layui-table">
##									<tbody>
##									<tr>
##
##
##									</tr>
##									</tbody>
##								</table>
##							</div>
##						</div>

						#if($!{fexTranReqPage.fexOption2}=="2" || $!{fexTranReqPage.fexOption2}=="3")
						<div class="layui-colla-item" id="exceptInfoDiv">
						#else
						<div class="layui-colla-item" id="exceptInfoDiv" style="display: none">
						#end
						<h2 class="layui-colla-title">#springMessage('table.fexTranReq.exceptInfo')</h2>
						<div class="layui-colla-content layui-show">
							<table class="layui-table">
								<tbody>
								#if($!{fexTranReqPage.fexOption2}=="2")
									<td class="textRight" width="20%">
										#springMessage('table.fexTranReq.exceptVal')
									</td>
									<td width="30%">$!number.formatDoubles($!{fexTranReqPage.exceptVal},4)</td>
									<td width="20%"></td>
									<td width="30%"></td>
								#else
									<tr>
										##障碍值/低障碍值
										<td class="textRight" width="20%">
											#if($!{fexTranReqPage.fexOption2}=="2")
												#springMessage('table.fexTranReq.exceptVal')
											#else
												#springMessage('table.fexTranReq.exceptLowVal')
											#end
										</td>
										<td width="30%">$!number.formatDoubles($!{fexTranReqPage.exceptLowVal},4)</td>
										#if($!{fexTranReqPage.fexOption2}=="3")
											##高障碍值
											<td class="textRight" width="20%"><div id="exceptHignValTdDiv">#springMessage('table.fexTranReq.exceptHignVal')</div></td>
											<td width="30%">$!number.formatDoubles($!{fexTranReqPage.exceptHignVal},4)</td>
										#else
											<td width="20%"></td>
											<td width="30%"></td>
										#end
									</tr>
								#end
								</tbody>
							</table>
						</div>
						</div>

						<div class="layui-colla-item">
							<h2 class="layui-colla-title">#springMessage('table.fexTranReq.dateInfo')</h2>
							<div class="layui-colla-content layui-show">
								<table class="layui-table">
									<tbody>
									<tr>
										##交易日期
										<td class="textRight" width="20%">#springMessage('table.revenue.transTime')</td>
										<td width="30%" >$!date.format('yyyy-MM-dd',$!{fexTranReqPage.tranDate})</td>
										##到期日期
										<td class="textRight" width="20%">#springMessage('table.fcAcc.deadlineDate')</td>
										<td width="30%" >$!date.format('yyyy-MM-dd',$!{fexTranReqPage.expiresDate})</td>
									</tr>
									<tr>
										##结算日期
										<td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
										<td colspan="3">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})</td>
									</tr>
									#if($!{fexTranReqPage.fexOption2} == "1")
									<tr id="avgDateTr">
										##平均期开始日期
										<td class="textRight">#springMessage('table.fexTranReq.avgBeginDate')</td>
										<td >$!date.format('yyyy-MM-dd',$!{fexTranReqPage.avgBeginDate})</td>
										##平均期结束日期
										<td class="textRight">#springMessage('table.fexTranReq.avgEndDate')</td>
										<td >$!date.format('yyyy-MM-dd',$!{fexTranReqPage.avgEndDate})</td>
									</tr>
									<tr id="avgDaysTr">
										##平均期天数
										<td class="textRight">#springMessage('table.fexTranReq.avgDays')</td>
										<td colspan="3">
											#if($!{fexTranReqPage.avgDays})
												$!number.formatNumeric($!{fexTranReqPage.avgDays},0)
											#end
										</td>
									</tr>
									#end
									</tbody>
								</table>
							</div>
						</div>

						<div class="layui-colla-item">
							<h2 class="layui-colla-title">#springMessage('table.fexTranReq.premiumInfo')</h2>
							<div class="layui-colla-content layui-show">
								<table class="layui-table">
									<tbody>
									<tr>
										##期权费结算日期
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.premiumSettleDate')</td>
										<td width="30%" >$!date.format('yyyy-MM-dd',$!{fexTranReqPage.premiumDate})</td>
										##期权费币种
										<td width="20%" class="textRight">#springMessage('table.fexTranReq.premiumCur')</td>
										<td width="30%" >$!{fexTranReqPage.premiumEnglishCode}</td>
									</tr>
									<tr>
										##期权费点数
										<td class="textRight">#springMessage('table.fexTranReq.premiumPoint')</td>
										<td>$!number.formatNumeric($!{fexTranReqPage.premiumPoint})</td>
										##期权费百分比
										<td class="textRight">#springMessage('table.fexTranReq.premiumRatio')</td>
										<td >
											<div class="layui-input-inline">$!rateTag.show($!{fexTranReqPage.premiumRatio},2)</div>
										</td>
									</tr>
									<tr>
										##期权费金额(期权费币种)
										<td class="textRight">#springMessage('table.fexTranReq.premiumMoney.premiumCur')</td>
										<td>$!number.formatNumeric($!{fexTranReqPage.premiumMoneyOfPremiumCur})</td>
										##结算币种
										<td class="textRight">#springMessage('table.fexTranDeal.settleCurId')</td>
										<td >$!{fexTranReqPage.englishCode}</td>
									</tr>
									<tr>
										##期权费折算汇率
										<td class="textRight">#springMessage('table.fexTranReq.premiumRate')</td>
										<td >$dictTag.get("fexProduct.fexOptionRate",$!{fexTranReqPage.premiumRateStr})</td>
										##期权费金额
										<td class="textRight">#springMessage('table.fexTranReq.premiumMoney.settleCur')</td>
										<td>$!number.formatNumeric($!{fexTranReqPage.premiumMoney})</td>
##										##现金流项目
##										<td class="textRight">#springMessage('finacial.common.cashFlow.item')</td>
##										<td>$!{fexTranReqPage.cashItemName}</td>
									</tr>
									#if($!{corpDTO.curId} != $!{fexTranReqPage.premiumCur})
									<tr  class = "baseConvertTr">
										##折本位币报价方式
										<td class="textRight">#springMessage('table.fexTranReq.convertQuotationMethod')</td>
										<td >
											$!{fexTranReqPage.convertCurType}
										</td>
										##折本位币汇率
										<td class="textRight">#springMessage('table.fexTranReq.convertBaseCurRate')</td>
										<td >
											#if($!{fexTranReqPage.convertRate})
												$!number.formatNumeric($!{fexTranReqPage.convertRate},6)
											#end
										</td>
									</tr>
									<tr class = "baseConvertTr" #if($!{corpDTO.curId}==$!{fexTranReqPage.premiumCur}) class="layui-hide" #end>
										##期权费金额(本位币币种)
										<td class="textRight">#springMessage('table.fexTranReq.premiumMoney.corpCur')</td>
										<td>
											$!number.formatNumeric($!{fexTranReqPage.convertMoney})
										</td>
										<td></td>
										<td></td>
									</tr>
									#end

									</tbody>
								</table>
							</div>
						</div>

						#if($!{fexTranReqPage.fexOption3}=="2" || $!{fexTranReqPage.fexOption3}=="3")
						<div class="layui-colla-item" id="refundInfoDiv">
						#else
						<div class="layui-colla-item" id="refundInfoDiv" style="display: none">
						#end
							<h2 class="layui-colla-title">#springMessage('table.fexTranReq.refundInfo')</h2>
							<div class="layui-colla-content layui-show">
								<table class="layui-table">
									<tbody>
									<tr>
										##是否涉及退款
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.isRefund')</td>
										<td colspan="3">$dictTag.get("sf_yn",$!{fexTranReqPage.isRefund})</td>
									</tr>
									#if($!{fexTranReqPage.isRefund} == '1')
									<tr>
										##退款点数
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.refundPoint')</td>
										<td width="30%" >$!number.formatNumeric($!{fexTranReqPage.refundPoint})</td>
										##退款百分比
										<td width="20%" class="textRight">#springMessage('table.fexTranReq.refundRatio')</td>
										<td width="30%" >$!rateTag.show($!{fexTranReqPage.refundRatio},2)</td>
									</tr>
									<tr>
										##退款金额
										<td class="textRight">#springMessage('table.fexTranReq.refundMoney')</td>
										<td>$!number.formatNumeric($!{fexTranReqPage.refundMoney})</td>
										##退款支付时间
										<td class="textRight">#springMessage('table.fexProduct.refundTime')</td>
										<td >$dictTag.get("fexProduct.refundTime",$!{fexTranReqPage.refundTime})</td>
									</tr>
									#end
									</tbody>
								</table>
							</div>
						</div>

						<div class="layui-colla-item">
							<h2 class="layui-colla-title">#springMessage('table.fexTranReq.otherInfo')</h2>
							<div class="layui-colla-content layui-show">
								<table class="layui-table">
									<tbody>
									<tr>
										##附言
										<td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
										<td>$!{fexTranReqPage.addWord}</td>
										##备注
										<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
										<td>$!{fexTranReqPage.rmk}</td>
									</tr>
									<tr>
										##交易员
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.dealer')</td>
										<td width="30%">$!{dealer}</td>
										##交易对手业务编号
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.cotpNo')</td>
										<td width="30%">$!{fexTranReqPage.cotpNo}</td>
									</tr>
									<tr>
										##交易地点
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAddr')</td>
										<td width="30%">$!{fexTranReqPage.tranAddr}</td>
										##交易组
										<td class="textRight">#springMessage('table.fexTranReq.tranGroup')</td>
										<td>$!{fexTranReqPage.tranGroupName}</td>
									</tr>
									<tr>
										##经纪人
										#if($!{fexTranReqPage.isShowAgent}=="1")
										<td class="textRight" width="20%">#springMessage('table.fexTranReq.cotpAgent')</td>
										<td width="30%">$!{fexTranReqPage.cotpAgent}</td>
										#end
										##清算所
										#if($!{fexTranReqPage.isShowClearHouse}=="1")
										<td class="textRight" width="20%">#springMessage('table.fexForeign.cotpClearHouse')</td>
										<td width="30%">$!{fexTranReqPage.cotpClearHouse}</td>
										#end
										#if(($!{fexTranReqPage.isShowAgent}=="1" && $!{fexTranReqPage.isShowClearHouse}=="0")
										|| ($!{fexTranReqPage.isShowAgent}=="0" && $!{fexTranReqPage.isShowClearHouse}=="1"))
											<td></td>
											<td></td>
										#end
									</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
					<!-- 资金计划 -->
					<div id="tagItemDetail"></div>
				</div>
				<!-- 附件上传 -->
				<input id="attachmentId" name="attachmentId" type="hidden" value="$!{fexTranReqPage.attachmentId}">
				<div id="uploader" class="layui-input-inline" style="width:100%"></div>
				<p>

				<!-- 日志 -->
				<div id="tagMsg"></div>
				<div class="layui-form-item layui-form-submit" id="buttonDiv">
					<div class="layui-input-block">
						<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{fexTranReqPage.id}')">#springMessage('common.button.trackFlow')</button>
						<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
					</div>
				</div>
			</form>
		</div>
		<div class="layui-tab-item">
			<table id="appTable" class="layui-table layui-form" style="width:100%;">
				<thead>
				<tr>
					#if($!{fexTranReqPage.status} >= 95)
						<th>#springMessage('table.fexCashFlow.billNo')</th>
					#end
					<th>#springMessage('table.fexTranReq.cashFlowDate')</th>
					<th>#springMessage('table.fcSubjectDay.optDate')</th>
					<th>#springMessage('table.fexBankAcc.cashFlowType')</th>
					<th>#springMessage('finacial.common.cashFlow.item')</th>
					<th>#springMessage('table.bisAccDtl.curName')</th>
					<th>#springMessage('table.choBankFinance.payMoney')</th>
					<th>#springMessage('table.nisBillhead.corpId')</th>
					<th>#springMessage('common.button.bank')</th>
					<th>#springMessage('table.btBankAccApp.accName')</th>
					<th>#springMessage('table.foreign.bankAcc')</th>
					<th>#springMessage('fex.cotp')</th>
					<th>#springMessage('table.fexTranReq.cotpBank')</th>
					<th>#springMessage('table.fexTranReq.cotpAccName')</th>
					<th>#springMessage('table.fexForeign.cotpAcc')</th>
					<th>#springMessage('table.foreign.voucherType')</th>
					<th>#springMessage('table.choBankFinance.flowClaim')</th>
				</tr>
				</thead>
				#if($!{fexTranReqPage.status} >= 95)
					#foreach($data in $cashFlowList)
					<tr>
						<td align="center">$!{data.billNo}</td>
						<td align="center">$!date.format('yyyy-MM-dd',$!{data.cashFlowDate})</td>
						<td align="center">$!date.format('yyyy-MM-dd',$!{data.settleDate})</td>
						<td align="center">$dictTag.get("fexCorp.cashFlowType",$!{data.cashFlowType})</td>
						##现金流项目
						<td align="center">$!{data.cashItemName}</td>
						<td align="center">$!{data.englishCode}</td>
						<td align="right">
							#if($!{data.cdSign}=="1")
								-$!number.formatNumeric($!{data.payMoney})
							#else
								$!number.formatNumeric($!{data.payMoney})
							#end
						</td>
						<td align="center">$!{data.corpName}</td>
						<td align="center">$!{data.corpBankName}</td>
						<td align="center">$!{data.corpAccName}</td>
						<td align="center">$!{data.corpBankAcc}</td>
						<td align="center">$!{data.cotpName}</td>
						<td align="center">$!{data.cotpBankName}</td>
						<td align="center">$!{data.cotpAccName}</td>
						<td align="center">$!{data.cotpBankAcc}</td>
						<td align="center">$!{data.voucherTypeName}</td>
						<td align="right">
							#if($!{data.bankFlowSign}=="1" || $!{data.blendSign}=="1")
								$dictTag.get("fexTranReq.blendSign","1")
							#else
								$dictTag.get("fexTranReq.blendSign","0")
							#end
						</td>
					</tr>
					#end
				#else
				<tr>
					##现金流日期
					<td align="center">$!{sysDate}</td>
					##结算日期
					<td align="center"><div id="srcSettleDateTd">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.premiumDate})</div></td>
					##现金流类型
					<td align="center"><div id="srcCashFlowTypeTd">$dictTag.get("fexCorp.cashFlowType","3")</div></td>
					##现金流项目
					<td align="center"><div id="srcCashItemTd">$!{fexTranReqPage.cashItemName}</div></td>
					##币种
					<td align="center"><div id="srcCurTd">$!{fexTranReqPage.englishCode}</div></td>
					##金额
					<td align="right">
						<div id="srcPayMoneyTd">
							#if($!{fexTranReqPage.premiumMoney})
								#if($!{fexTranReqPage.busDirection} == "1")
									-$!number.formatNumeric($!{fexTranReqPage.premiumMoney})
								#else
									$!number.formatNumeric($!{fexTranReqPage.premiumMoney})
								#end
							#end
						</div>
					</td>
					##单位
					<td align="center"><div id="srcCorpTd">$!{fexTranReqPage.corpName}</div></td>
					##银行
					<td align="center"><div id="srcBankTd">$!{fexTranReqPage.corpBankName}</div></td>
					##账户名称
					<td align="center"><div id="srcAccNameTd">$!{fexTranReqPage.corpAccName}</div></td>
					##银行账户
					<td align="center"><div id="srcBankAccTd">$!{fexTranReqPage.corpBankAcc}</div></td>
					##交易对手
					<td align="center"><div id="srcCotpTd">$!{fexTranReqPage.cotpName}</div></td>
					##交易对手银行
					<td align="center"><div id="srcCotpBankTd">$!{fexTranReqPage.cotpBankName}</div></td>
					##交易对手账户名称
					<td align="center"><div id="srcCotpAccNameTd">$!{fexTranReqPage.cotpAccName}</div></td>
					##交易对手银行账户
					<td align="center"><div id="srcCotpBankAccTd">$!{fexTranReqPage.cotpBankAcc}</div></td>
					##支付方式
					<td align="center"><div id="srcPayTypeTd">$!{fexTranReqPage.voucherTypeName}</div></td>
					<td align="center">
						$dictTag.get("fexTranReq.blendSign","0")
					</td>
				</tr>
			#end
			</table>
		</div>
		<div class="layui-tab-item">
			<!-- 自定义信息 -->
			<div id="custMsg"></div>
		</div>
	</div>
	#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexTranReqOption.view.js?_btv=${resourceVersion}"></script>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
        ##资金池
            <td class="textRight">#springMessage('nis.pool.fcCorpPool.pool')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexcorppool/getFexCorpPools"
                         data-name="poolId" data-biz-name="poolId"
                         data-valuefield="id" data-textfield="showName" data-search="true"
                         data-callback="poolCallBack" data-required="required"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##资金池性质
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.poolNature')</td>
            <td>
                <div id="poolNature"></div>
            </td>
        </tr>
        <tr>
        ##银行账号
            <td class="textRight" width="30%">#springMessage('table.bisAccBal.bankAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="" data-name="bankaccId" data-biz-name="bankAcc"
                         data-callback="accountCallBack"
                         data-valuefield="id" data-textfield="bankAcc" data-search="true"
                         data-required="required"></div>
                </div>
            </td>
            </td>
        </tr>
        <tr>
        ##资金池主账号银行
            <td class="textRight" width="30%">
                #springMessage('nis.pool.fcCorpPool.pool')#springMessage('table.fexCorpPool.mainAccount')#springMessage(
                'common.button.bank')
            </td>
            <td>
                <div id="bankName"></div>
            </td>
        </tr>
        <tr>
        ##资金池主账号币种
            <td class="textRight" width="30%">
                #springMessage('nis.pool.fcCorpPool.pool')#springMessage('table.fexCorpPool.mainAccount')#springMessage(
                'contract.currency')
            </td>
            <td>
                <div id="englishCode"></div>
            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight" width="30%">#springMessage('table.fcCorpPool.rmk')</td>
            <td>
                <textarea type="text" id="rmk" name="rmk" class="layui-textarea" readonly
                          placeholder="#springMessage('table.fcCorpPool.rmk')"></textarea>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
##借入外债交易
    <div class="layui-colla-item ignore-required-icon layui-form">
        <h2 class="layui-colla-title">#springMessage('table.fexCorpPoolTran.borrowing')</h2>##借入外债交易
        <div class="layui-colla-content layui-show">
            <table id="dataTable1" style="width:100%;">
                <thead>
                <tr>
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                        'table.fexBankAcc.tranType')</th>##交易类型
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                        'table.fexCorpPoolTran.product')</th>##产品
                    <th>#springMessage('common.table.thead.operation')</th>
                </tr>
                </thead>
                <tbody>
                <tr row="0">
                    <td align="center">
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="select" data-name="tranTypeJDtl[0].tranType"
                                 data-biz-name="tranTypeJDtl[0].tranType" data-group="fexCorpPoolTran.tranType"
                                 data-callback="bt.tranTypeJ" data-required="required" data-displayData="3"></div>
                        </div>
                    </td>
                    <td align="center">
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" data-url=""
                                 data-name="tranTypeJDtl[0].proId" data-biz-name="tranTypeJDtl[0].proId"
                                 data-valuefield="id" data-textfield="proName" data-search="true" data-required="required"></div>
                        </div>
                    </td>
                    <td align="center">
                        <a href="javascript:void(0)" data-type="del" class="tableElema">#springMessage(
                            'common.button.delete')</a>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
##对外放款交易
    <div class="layui-colla-item ignore-required-icon layui-form">
        <h2 class="layui-colla-title">#springMessage('table.fexCorpPoolTran.Loan')</h2>##对外放款交易
        <div class="layui-colla-content layui-show">
            <table id="dataTable2" style="width:100%;">
                <thead>
                <tr>
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                        'table.fexBankAcc.tranType')</th>##交易类型
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage(
                        'table.fexCorpPoolTran.product')</th>##产品
                    <th>#springMessage('common.table.thead.operation')</th>
                </tr>
                </thead>
                <tbody>
                <tr row="0">
                    <td align="center">
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="select" data-name="tranTypeWDtl[0].tranType"
                                 data-biz-name="tranTypeWDtl[0].tranType" data-group="fexCorpPoolTran.tranType"
                                 data-callback="bt.tranTypeW" data-required="required" data-displayData="3"></div>
                        </div>
                    </td>
                    <td align="center">
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" data-url=""
                                 data-name="tranTypeWDtl[0].proId" data-biz-name="tranTypeWDtl[0].proId"
                                 data-valuefield="id" data-textfield="proName" data-search="true" data-required="required"></div>
                        </div>
                    </td>
                    <td align="center">
                        <a href="javascript:void(0)" data-type="del" class="tableElema">#springMessage(
                    'common.button.delete')</a>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexCorpPoolTran.add.js?_btv=${resourceVersion}"></script>
</html>

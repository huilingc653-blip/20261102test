<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
	<style>
		.layui-input{
			width: 120px!important;
		}
	</style>
</head>
<body>
	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{fexTranDealPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{fexTranDealPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fexTranDealPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{fexTranDealPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{fexTranDealPage.id}">
		<input id="tranReqId" name="tranReqId" type="hidden" value="$!{fexTranDealPage.tranReqId}">
		<input id="corpId" name="corpId" type="hidden" value="$!{fexTranDealPage.corpId}">
		<input id="opType" name="opType" type="hidden" value="$!{fexTranDealPage.opType}">
		<input id="status" name="status" type="hidden" value="$!{fexTranDealPage.status}">
		<table class="layui-table">
			<thead>
			<tr>
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranDeal.defaultDate')</th>
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranDeal.defaultCurId')</th>
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranDeal.defaultMoney')</th>
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fcSubjectDay.optDate')</th>
				#*<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranDeal.settleMoney')</th>*#
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fexTranDeal.defaultRate')</th>
				<th>#springMessage('fcVoucherType.rmk')</th>
			</tr>
			</thead>
			<tbody class="ignore-required-icon layui-form">
			#if($!{fexTranDealPage.status}=="0" || $!{fexTranDealPage.status}=="-1")
				<tr>
					<td align="center">
						<input type="text" name="defaultDate" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{fexTranDealPage.defaultDate}"
							   data-today="true" data-type="date" data-name="defaultDate" data-biz-name="defaultDate">
					</td>
					<td align="center">
						<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="curId" data-biz-name ="curId"
							 data-valueField="id" data-textField="englishCode" data-required = "true" data-value="$!{fexTranDealPage.curId}"></div>
					</td>
					<td align="center">
						<input type="text" id="defaultMoney" name="defaultMoney" style="text-align:right" lay-verify="required|number2" data-name="defaultMoney" data-biz-name="defaultMoney"
							   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranDeal.defaultMoney')" value="$!{fexTranDealPage.defaultMoney}">
					</td>
					<td align="center">
						<input type="text" name="tranDate" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{fexTranReqPage.tranDate}" readonly="readonly"
							   data-type="date" data-name="tranDate" data-biz-name="tranDate" data-endid="newSettleDate" style="display: none">
						<input type="text" id="newSettleDate" name="newSettleDate" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{fexTranDealPage.newSettleDate}"
							   data-today="true" data-type="date" data-name="newSettleDate" data-biz-name="newSettleDate">
					</td>
					#*<td align="center">
						<input type="text" id="settleMoney" name="settleMoney" style="text-align:right" lay-verify="required|number2" data-name="settleMoney" data-biz-name="settleMoney"
							   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranDeal.settleMoney')" value="$!{fexTranDealPage.settleMoney}">
					</td>*#
					<td align="center">
						<input type="text" data-name="wishRate" data-biz-name="wishRate" data-decimal="6" lay-verify="required" value="$!{fexTranDealPage.wishRate}"
							   id="wishRate" autocomplete="off" class="layui-input bt-biz-moneyType"  placeholder="#springMessage('table.fexTranDeal.defaultRate')">
					</td>
					<td align="center">
						<input type="text" id="rmk" name="rmk" value="$!{fexTranDealPage.rmk}"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('fcVoucherType.rmk')">
					</td>
				</tr>
			#else
				<tr>
					<td align="center">
						$!date.format('yyyy-MM-dd',$!{fexTranDealPage.defaultDate})
					</td>
					<td align="center">
						$!{fexTranDealPage.englishCode}
					</td>
					<td align="right">
						$!number.formatNumeric($!{fexTranDealPage.defaultMoney})
					</td>
					<td align="center">
						$!date.format('yyyy-MM-dd',$!{fexTranDealPage.newSettleDate})
					</td>
					<td align="right">
						$!number.formatNumeric($!{fexTranDealPage.settleMoney})
					</td>
					<td align="right">
						$!number.formatDoubles($!{fexTranDealPage.wishRate}, 6)
					</td>
					<td>
						$!{fexTranDealPage.rmk}
					</td>
				</tr>
			#end
        	</tbody>
        </table>
		#if($!{fexTranDealPage.status}=="0" || $!{fexTranDealPage.status}=="-1")
			<div style="text-align: center; padding-top: 10px;">
				<button class="layui-btn" lay-submit="" lay-filter="submit" value="11" >#springMessage('common.button.submit')</button>
				<button class="layui-btn" lay-submit="" lay-filter="submit" value="0" >#springMessage('common.button.temp')</button>
				#if($!{fexTranDealPage.id})
				<button class="layui-btn" lay-submit="" type="button" onclick="delTranDeal()" >#springMessage('common.button.delete')</button>
				#end
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</div>
		#else
			<div class="layui-form-item layui-form-submit" id="buttonDiv">
				<div class="layui-input-block">
					<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{fexTranDealPage.id}')">#springMessage('common.button.trackFlow')</button>
					<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
				</div>
			</div>
		#end
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexTranDealDefault.add.js?_btv=${resourceVersion}"></script>
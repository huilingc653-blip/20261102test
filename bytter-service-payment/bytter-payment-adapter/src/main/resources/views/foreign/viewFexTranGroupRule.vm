<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" action="">
    <input type="hidden" name="id" id="id" value="$!{fexTranGroupRuleVO.id}">
    <div class="layui-fluid" style="padding: 0">
        <div class="layui-row">
            <div class="layui-col-xs12">
                <table class="layui-table">
                    <thead>
                    <tr>
                        <td colspan="2">#springMessage('table.externalCorp.basicInfo')</td>
                    </tr>
                    </thead>
                    <tbody>
                    ##名称
                    <tr>
                        <td class="textRight">#springMessage('bpm.option.usertask.name')</td>
                        <td>
                            $!{fexTranGroupRuleVO.ruleName}
                        </td>
                    </tr>
                    ##描述
                    <tr>
                        <td class="textRight">#springMessage('sys.role.description')</td>
                        <td>
                            $!{fexTranGroupRuleVO.ruleDesc}
                        </td>
                    </tr>
                    ##备注
                    <tr>
                        <td class="textRight">#springMessage('table.btCurrency.rmk')</td>
                        <td>
                            <textarea name="rmk" class="layui-textarea" readonly>$!{fexTranGroupRuleVO.rmk}</textarea>
                        </td>
                    </tr>
                    ##有效标志
                    <tr>
                        <td class="textRight">#springMessage('fcVoucherType.validSign')</td>
                        <td>
                            $dictTag.get("sf_yn",$!{fexTranGroupRuleVO.validSign})
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <div class="layui-col-xs12">
                <table id="ruleDtl">
                    <thead>
                    <tr>
                        <th>#springMessage('ttpay.tradeType')</th>
                        <th>#springMessage('table.choProduct.productName')</th>
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form', 'jquery','select','selectType', 'bttable', 'dicts'], function () {
        /**初始化单选框begin，组件:select */
        var form = bt.form(), $ = bt.jquery;
        /**初始化单选框end，组件:select */

        /**初始化表格begin*/
        bt.bttable.init({
            scrollX: true,
            scrollY: "400px",
            elem: "#ruleDtl",
            url: basePath + "/foreign/fextrangrouprule/detail/"+$('input[name="id"]').val(),
            columns:[
                {
                    data: 'tranType',className: 'center',
                    render: function (data, row) {
                        return ' <div class="bt-biz-dict" data-type="select" data-group="foreign.tranGroupRule.tranType" data-name="fexTranGroupRuleDtlVOList[' + (row+1) + '].tranType" data-value="'+data.tranType+'"></div>';
                    }
                },
                {
                    data: 'proId',className: 'center',
                    render: function (data, row) {
                        return '<div class="bt-biz-selectType" data-type="select" data-url="' + basePath + '/foreign/fexproduct/listProduct/'+data.tranType+'" data-name ="fexTranGroupRuleDtlVOList[' + (row+1)  + '].proId" data-valueField="id" data-textField="proName" data-defaultvalue="'+data.proId+'"></div>';
                    }
                }
            ],
            tableInitCallback: function (data) {
                bt.selectType.init();
                form.render();
                bt.dicts.init();
            }
        });
        /**初始化表格end*/
    });

    $(document).ready(function (){
        setTimeout(function () {
            $("input[type='text']").attr({"disabled":"true","style":"pointer-events: none;"}) //禁用
            $("i").hide();
        }, 500); //1s
    });
</script>
</html>
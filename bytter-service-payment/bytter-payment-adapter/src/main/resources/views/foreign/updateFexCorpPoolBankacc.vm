<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{fexCorpPoolBankAccPage.id}">
    <input id="poolId" name="poolId" type="hidden" value="$!{fexCorpPoolBankAccPage.poolId}">
    <input id="corpId" name="corpId" type="hidden" value="$!{fexCorpPoolBankAccPage.corpId}">
    <input id="curId" name="curId" type="hidden" value="$!{fexCorpPoolBankAccPage.curId}">
    <input id="accId" name="accId" type="hidden" value="$!{fexCorpPoolBankAccPage.accId}">
    <input id="parentId" name="parentId" type="hidden" value="$!{fexCorpPoolBankAccPage.parentId}">
    <input id="parentSign" name="parentSign" type="hidden" value="$!{fexCorpPoolBankAccPage.parentSign}">
    <table class="layui-table">
        <tbody>
        <tr>
        ##资金池主体单位
            <td class="textRight" width="30%">
                #springMessage('nis.pool.fcCorpPool.pool')
            </td>
            <td>
                $!{fexCorpPoolBankAccPage.poolName}
            </td>
        </tr>
        <tr>
        ##主体单位名称
            <td class="textRight" width="30%">
                #springMessage('table.fcCorpPool.corpName')
            </td>
            <td>
                $!{fexCorpPoolBankAccPage.corpName}
            </td>
        </tr>
        <tr>
        ##账户币种
            <td class="textRight" width="30%">
                #springMessage('contract.currency')
            </td>
            <td>
                $!{fexCorpPoolBankAccPage.englishCode}
            </td>
        </tr>
        <tr>
        ##银行账号
            <td class="textRight" width="30%">#springMessage('table.bisAccBal.bankAcc')</td>
            <td style="min-width: 200px;">
                <div class="layui-input-inline">
                    <input type="text" id="bankAcc" name="bankAcc" data-biz-name="bankAcc"
                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.accountDTO.bankAcc')" lay-verify="required" value="$!{fexCorpPoolBankAccPage.bankAcc}">
                    <table id="bankAccTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.accountDTO.bankAcc')</th>
                            <th>#springMessage('table.accountDTO.accName')</th>
                            <th>#springMessage('table.accountDTO.bankName')</th>
                            <th>#springMessage('table.accountDTO.curName')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
        </tr>
        <tr>
        ##银行
            <td class="textRight" width="30%">
                #springMessage('common.button.bank')
            </td>
            <td>
                <div id="bankName">$!{fexCorpPoolBankAccPage.bankName}</div>
            </td>
        </tr>
        <tr>
        ##账户名称
            <td class="textRight" width="30%">
                #springMessage('table.btBankAccApp.accName')
            </td>
            <td>
                <div id="accName">$!{fexCorpPoolBankAccPage.accName}</div>
            </td>
        </tr>
        <tr>
        ##账户资金性质
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.accNature')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-biz-name="accNature"
                     data-group="fexCorpPoolBank.accNature" data-name="accNature"
                     data-defaultvalue="$!{fexCorpPoolBankAccPage.accNature}"></div>
            </td>
        </tr>
        <tr>
        ##限额设置
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.limit')</td>
            <td>
                #if($!{fexCorpPoolBankAccPage.isLimitControl} == "1")
                    <div class="bt-biz-dict" data-type="checkbox" data-group="fexCorpPoolLimit.limitType"
                         data-name="limitTypes" data-biz-name="limitTypes"
                         id="limitTypes" data-callback="typeCallBack" data-required="true"
                         data-defaultValue="$!{fexCorpPoolBankAccPage.limitType}"></div>
                #else
                    <div class="bt-biz-dict" data-type="checkbox" data-group="fexCorpPoolLimit.limitType"
                         data-name="limitTypes" data-biz-name="limitTypes"
                         id="limitTypes" data-callback="typeCallBack"
                         data-defaultValue="$!{fexCorpPoolBankAccPage.limitType}"></div>
                #end
            </td>
        </tr>
        <tr>
        ##限额金额
            <td class="textRight" width="30%">#springMessage('table.fexCorpPool.limitMoney')</td>
            <td>
                <div class="layui-input-inline" style="width:100%">
                    #if($!{fexCorpPoolBankAccPage.limitMoney1})
                        <input type="text" id="limitMoney1" data-biz-name="limitMoney1" data-name="limitMoney1"
                               style="display: inline-block;"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               placeholder="#springMessage('table.fexCorpPool.externalDebtBalance')"
                               value="$!{fexCorpPoolBankAccPage.limitMoney1}" lay-verify="required">
                    #else
                        <input type="text" id="limitMoney1" data-biz-name="limitMoney1" data-name="limitMoney1"
                               style="display: inline-block;"
                               value="$!{fexCorpPoolBankAccPage.limitMoney1}"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               placeholder="#springMessage('table.fexCorpPool.externalDebtBalance')"
                               readonly="readonly">
                    #end

                    #if($!{fexCorpPoolBankAccPage.limitMoney2})
                        <input type="text" id="limitMoney2" data-biz-name="limitMoney2" data-name="limitMoney2"
                               style="display: inline-block;"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               placeholder="#springMessage('table.fexCorpPool.externalLoan')"
                               value="$!{fexCorpPoolBankAccPage.limitMoney2}" lay-verify="required">
                    #else
                        <input type="text" id="limitMoney2" data-biz-name="limitMoney2" data-name="limitMoney2"
                               style="display: inline-block;"
                               value="$!{fexCorpPoolBankAccPage.limitMoney2}"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               placeholder="#springMessage('table.fexCorpPool.externalLoan')"
                               readonly="readonly">
                    #end
                    #if($!{fexCorpPoolBankAccPage.limitMoney3})
                        <input type="text" id="limitMoney3" data-biz-name="limitMoney3" data-name="limitMoney3"
                               style="display: inline-block;"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               placeholder="#springMessage('table.fexCorpPool.NetInflow')"
                               value="$!{fexCorpPoolBankAccPage.limitMoney3}" lay-verify="required">
                    #else
                        <input type="text" id="limitMoney3" data-biz-name="limitMoney3" data-name="limitMoney3"
                               style="display: inline-block;"
                               value="$!{fexCorpPoolBankAccPage.limitMoney3}"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               placeholder="#springMessage('table.fexCorpPool.NetInflow')"
                               readonly="readonly">
                    #end

                </div>
            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight" width="30%">#springMessage('table.fcCorpPool.rmk')</td>
            <td>
                <textarea type="text" id="rmk" name="rmk" class="layui-textarea" maxlength="40"
                          placeholder="#springMessage('table.fcCorpPool.rmk')">$!{fexCorpPoolBankAccPage.rmk}</textarea>
            </td>
        </tr>

        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexCorpPoolBankacc.edit.js?_btv=${resourceVersion}"></script>
</html>

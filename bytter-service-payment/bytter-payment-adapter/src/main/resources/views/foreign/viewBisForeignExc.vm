<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<div id="print">
		<input id="id" name="id" type="hidden" value="$!{bisForeignExcPage.id}">
		<input id="busType" name="busType" type="hidden" value="$!{busType}">
		<table class="layui-table">
			<thead>
            <tr>
                <th colspan="4" style="text-align:center">#springMessage('table.bisForeignExc.viewTitle')</th>
			</tr>
			</thead>
			<tbody>
			<tr>
        		##指令编号
				<td class="textRight">#springMessage('table.bisExc.voucherNo')</td>
				<td width="35%">$!{bisForeignExcPage.voucherNo}</td>
				##申请日期
				<td class="textRight">#springMessage('table.bisExc.reqDate')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{bisForeignExcPage.reqDate})</td>		
        	</tr>
            <tr>
				##单位
                <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                <td>$!{bisForeignExcPage.corpName}</td>
				##汇款类型
                <td class="textRight">#springMessage('table.fexForeignReq.remitType')</td>
                <td>$dictTag.get("fexForeignReq.remitType",$!{bisForeignExcPage.remitType})</td>
            </tr>
            <tr>
				##汇款币种
                <td class="textRight">#springMessage('table.fexForeignReq.curId')</td>
                <td>$!{bisForeignExcPage.englishCode}</td>
				##银行类别
				<td class="textRight">#springMessage('table.bisBifInit.bankType')</td>
				<td>$!{bisForeignExcPage.bankTypeName}</td>
            </tr>
			<tr>
        		##付款账号
				<td class="textRight">#springMessage('table.fexForeignReq.payerAcc')</td>
				<td width="35%">$!{bisForeignExcPage.payerAcc}</td>
                ##收款账号
                <td class="textRight">#springMessage('table.fexForeignReq.payeeAcc')</td>
                <td width="35%">$!{bisForeignExcPage.payeeAcc}</td>
        	</tr>
            <tr>
            	##付款账号名称
                <td class="textRight">#springMessage('table.fexForeignReq.payerAccName')</td>
                <td width="35%">$!{bisForeignExcPage.payerAccName}</td>
            	##收款账号名称
                <td class="textRight">#springMessage('table.fexForeignReq.payeeAccName')</td>
                <td width="35%">$!{bisForeignExcPage.payeeAccName}</td>
            </tr>
			<tr>
        		##付款开户行
				<td class="textRight">#springMessage('table.fexForeignReq.payerBank')</td>
				<td width="35%">$!{bisForeignExcPage.payerBank}</td>
                ##收款开户行
                <td class="textRight">#springMessage('table.fexForeignReq.payeeBank')</td>
				<td width="35%"><div style="white-space: normal; word-break: break-all;">$!{bisForeignExcPage.payeeSwiftCode} $!{bisForeignExcPage.payeeBank}</div></td>
        	</tr>
			<tr>
        		##金额
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
				<td width="35%">
					$!number.formatNumeric($!{bisForeignExcPage.payMoney})
					<input type="hidden" data-name="payMoney" data-toUp="payMoneyUp" autocomplete="off" 
						class="layui-input bt-biz-moneyType" value="$!{bisForeignExcPage.payMoney}">
				</td>
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
				<td width="35%" style="padding-left:0px"><div id="payMoneyUp"></div></td>
        	</tr>
            <tr>
				##附言
                <td class="textRight">#springMessage('table.bisExc.addWord')</td>
                <td colspan="3">$!{bisForeignExcPage.addWord}</td>
            </tr>
            <tr>
				##银企接口
                <td class="textRight">#springMessage('table.bisExc.bifCode')</td>
                <td width="35%">$!{bisForeignExcPage.bifName}</td>
				##发电等级 0-普通 Normal  1-加急 Urgent
				<td class="textRight">#springMessage('table.fexForeignReq.quickSign')</td>
				<td width="35%">$dictTag.get("fexForeignReq.quickSign",$!{bisForeignExcPage.quickSign})</td>
        	</tr>
			<tr>
        		##交易状态
				<td class="textRight">#springMessage('table.bisExc.voucherStat')</td>
				<td width="35%">$dictTag.get("bisExc.voucherStat",$!{bisForeignExcPage.voucherStat})</td>
				##交易时间
				<td class="textRight">#springMessage('table.bisExc.transTime')</td>
				<td width="35%">$!date.format('yyyy-MM-dd HH:mm:ss',$!{bisForeignExcPage.transTime})</td>
        	</tr>
			<tr>
        		##银行返回时间
				<td class="textRight">#springMessage('table.bisExc.returnTime')</td>
				<td width="35%">$!date.format('yyyy-MM-dd HH:mm:ss',$!{bisForeignExcPage.returnTime})</td>
				##银行流水号
				<td class="textRight">#springMessage('table.bisExc.bankSerialNo')</td>
				<td width="35%">$!{bisForeignExcPage.bankSerialNo}</td>
        	</tr>
			<tr>
        		##返回信息
				<td class="textRight">#springMessage('table.bisExc.firstReturnMsg')</td>
				<td width="35%" colspan="4">$!{bisForeignExcPage.firstReturnMsg}</td>
        	</tr>
			<tr>
				##返回信息
				<td class="textRight">#springMessage('table.bisExc.nextReturnMsg')</td>
				<td width="35%" colspan="4">$!{bisForeignExcPage.nextReturnMsg}</td>
        	</tr>
			</tbody>
        </table>
		</div>
		<!-- 日志 -->
		<div id="tagMsg"></div>
        <p>
        <div class="layui-form-item layui-form-submit" id="buttonDiv">
			<div class="layui-input-block">
				<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
			</div>
        </div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script >
bt.use(['form','layedit','moneyType','printType'], function(){
    var $ = bt.jquery,form = bt.form();
    var moneyType = bt.moneyType.init();
    var moneyFun = bt.moneyType.getFun();
	bt.printType.init();
	
	/**
     * 生成日志列表
     * @return
     */
	$genMsgHtml= function() {
		var url=basePath + "/foreign/fexmessage/list/"+$('#id').val()+"/"+$("#busType").val();
        $.ajax({
            url:url,
            method: 'GET',
            async:false,
            success: function (json) {
                $("#tagMsg").html("");
                $("#tagMsg").html(json);
                form.render();
            }
        });
    }
	$genMsgHtml();
});
</script>
</html>
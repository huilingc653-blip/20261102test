<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
        ##资金池
            <td class="textRight" width="10%">#springMessage('nis.pool.fcCorpPool.pool')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexcorppool/getFexCorpPoolsUniq"
                         data-name="eqs_poolId" data-biz-name="poolId" data-callback="bt.poolCallback"
                         data-valuefield="poolId" data-textfield="showName" data-search="true"
                         data-defaultValue="$!{fexCorpPoolBankAccVOPage.poolId}"></div>
                </div>
            </td>
        ##主账号
            <td class="textRight" width="10%">#springMessage('table.fexCorpPool.mainAccount')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <input type="text" id="bankAcc" name="eqs_bankAcc" data-biz-name="bankAcc"
                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexCorpPool.mainAccount')">
                    <input type="hidden" id="curId" name="eqs_curId" value="">
                    <table id="mainAccountTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.fexCorpPool.mainAccount')</th>
                            <th>#springMessage('table.nisBillhead.payerBank')</th>
                            <th>#springMessage('table.nisBillhead.curId')</th>
                            <th>#springMessage('table.btBankAcc.isOnline')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
        ##日期
            <td class="textRight" width="10%">#springMessage('table.fcAccuBalance.date')</td>
            <td width="30%">
                <div class="layui-inline">
                    <input type="text" id="balDate" name="balDate" class="layui-input bt-input-inline bt-biz-dateType"
                           data-today="true" data-biz-name="balDate">
                </div>
            </td>
        </tr>
        <tr>
            <td align="center" colspan="6">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
##                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button type="button" class="layui-btn layui-btn-primary" onClick="resetCode()">#springMessage('common.button.reset')</button>

            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('nis.pool.fcCorpPool.pool')</th>##资金池
        <th>#springMessage('table.btBankAccApp.corpId')</th>##单位
        <th>#springMessage('table.accountDTO.bankAcc')</th>##账户
        <th>#springMessage('table.fexCorpPool.curId')</th>##限额折算币种
        <th>#springMessage('table.fexCorpPool.externalDebtBalance')</th>##外债余额
        <th>#springMessage('fexCorpPool.externalDebtLimit')</th>##外债限额
        <th>#springMessage('fexCorpPool.remainingForeignDebtQuota')</th>##剩余外债额度
        <th>#springMessage('fexCorpPool.externalLoanBalance')</th>##对外放款余额
        <th>#springMessage('fexCorpPool.foreignLendingLimit')</th>##对外放款限额
        <th>#springMessage('fexCorpPool.remainingExternalLendingAmount')</th>##剩余对外放款额度
        <th>#springMessage('fexCorpPool.inflowBalance')</th>##流入余额
        <th>#springMessage('fexCorpPool.outflowBalance')</th>##流出余额
        <th>#springMessage('table.fexCorpPool.NetInflow')</th>##净流入额
        <th>#springMessage('fexCorpPool.netInflowLimit')</th>##净流入限额
        <th>#springMessage('fexCorpPool.remainingNetInflow')</th>##剩余净流入额度
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexCorpPoolBankaccQuota.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<!-- 系统参数 -->
		<input id="id" name="id" type="hidden" value="$!{fexForeignReqPage.id}">
		<input id="billNo" name="billNo" type="hidden" value="$!{fexForeignReqPage.billNo}">
		<input id="corpId" name="corpId" type="hidden" value="$!{fexForeignReqPage.corpId}">
		<input id="payDate" name="payDate" type="hidden" value="$!{fexForeignReqPage.payDate}">
		<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
		<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
		<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
		<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
		<input id="busType" name="busType" type="hidden" value="$!{busType}">

        <!-- 资金计划参数 明细项控制模式-->
        <input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
        <input id="curId" name="curId" type="hidden" value="$!{fexForeignReqPage.curId}">
        <input id="payeeAccName" name="payeeAccName" type="hidden" value="$!{fexForeignReqPage.payeeAccName}">
        <input id="payerAcc" name="payerAcc" type="hidden" value="$!{fexForeignReqPage.payerAcc}">
        <input id="payeeAcc" name="payeeAcc" type="hidden" value="$!{fexForeignReqPage.payeeAcc}">
        <input id="payeeBank" name="payeeBank" type="hidden" value="$!{fexForeignReqPage.payeeBank}">
        <input id="purpose" name="purpose" type="hidden" value="$!{fexForeignReqPage.addWord}">
		<div id="print">
        <table class="layui-table">
            <thead>
                <tr>
                    <th colspan="4">#springMessage('table.fexForeignReq.mainInfo')</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    ##汇款单号
                    <td class="textRight" width="15%">#springMessage('table.fexForeignReq.billNo')</td>
                    <td width="35%">$!{fexForeignReqPage.billNo}</td>
                    ##汇款类型
                    <td class="textRight" width="15%">#springMessage('table.fexForeignReq.remitType')</td>
                    <td width="35%">$dictTag.get("fexForeignReq.remitType",$!{fexForeignReqPage.remitType})</td>
                </tr>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                    <td>$!{fexForeignReqPage.corpName}</td>
                    ##跨行标志
                    <td class="textRight">#springMessage('table.nisBillhead.difBank')</td>
                    <td>$dictTag.get("nisBillhead.difBank",$!{fexForeignReqPage.difBank})</td>
                </tr>
                <tr>
                    ##汇款日期
                    <td class="textRight">#springMessage('table.fexForeignReq.payDate')</td>
                    <td>$!date.format('yyyy-MM-dd',$!{fexForeignReqPage.payDate})</td>
                    ##收款账号
                    <td class="textRight">#springMessage('table.fexForeignReq.payeeAcc')</td>
                    <td>$!{fexForeignReqPage.payeeAcc}</td>
                </tr>
                <tr>
                    ##汇款币种
                    <td class="textRight">#springMessage('table.fexForeignReq.curId')
                    <td>$!{fexForeignReqPage.curName}</td>
                    ##收款人名称
                    <td class="textRight">#springMessage('table.fexForeignReq.payeeAccNameEn')</td>
                    <td>$!{fexForeignReqPage.payeeAccName}</td>
                </tr>
                <tr>
                    ##银行类别
                    <td class="textRight">#springMessage('table.bisBifInit.bankType')</td>
                    <td>$!{fexForeignReqPage.bankTypeName}</td>
                    ##收款人地址
                    <td class="textRight">#springMessage('table.fexForeignReq.payeeAdd')</td>
                    <td>$!{fexForeignReqPage.payeeAdd}</td>
                </tr>
                <tr>
                    ##汇款账号
                    <td class="textRight">#springMessage('table.fexForeignReq.payerAcc')</td>
                    <td>$!{fexForeignReqPage.payerAcc}</td>
                    ##收款开户行swift code
                    <td class="textRight">#springMessage('table.fexForeignReq.payeeSwiftCode')</td>
                    <td>$!{fexForeignReqPage.payeeSwiftCode}</td>
                </tr>
                <tr>
                    ##汇款账号名称
                    <td class="textRight">#springMessage('table.fexForeignReq.payerAccName')</td>
                    <td>$!{fexForeignReqPage.payerAccName}</td>
                    ##收款开户行名称
                    <td class="textRight">#springMessage('table.fexForeignReq.payeeBankEn')</td>
                    <td>$!{fexForeignReqPage.payeeBank}</td>
                </tr>
                <tr>
                    #if($!{fexForeignReqPage.bankTypeName} == "民生银行")
                        ##汇款办理机构
                        <td class="textRight">#springMessage('table.fexForeignReq.branchCode')</td>
                        <td>
                            <div style="white-space: normal; word-break: break-all;">
                                $!{fexForeignReqPage.branchCode} $!{fexForeignReqPage.branchName}
                            </div>
                        </td>
                    #else
                        ##汇款开户行名称
                        <td class="textRight">#springMessage('table.fexForeignReq.payerBank')</td>
                        <td>$!{fexForeignReqPage.payerBank}</td>
                    #end
                    ##收款开户行地址
                    <td class="textRight">#springMessage('table.fexForeignReq.payeeBankAdd')</td>
                    <td>$!{fexForeignReqPage.payeeBankAdd}</td>
                </tr>
                <tr>
                    ##汇款方联系人姓名
                    <td class="textRight">#springMessage('table.fexForeignReq.payerName')</td>
                    <td>$!{fexForeignReqPage.payerName}</td>
                    ##收款方国别
                    <td class="textRight">#springMessage('table.fexForeignReq.payeeCountryCode')</td>
                    <td>$!{fexForeignReqPage.payeeCountryName}</td>
                </tr>
                <tr>
                    ##汇款方联系人电话
                    <td class="textRight">#springMessage('table.fexForeignReq.payerTel')</td>
                    <td>$!{fexForeignReqPage.payerTel}</td>
                    ##收款银行之代理行SwifitCode
                    <td class="textRight">#springMessage('table.fexForeignReq.payeeAgentSwiftCode')</td>
                    <td>$!{fexForeignReqPage.payeeAgentSwiftCode}</td>
                </tr>
                <tr>
##                    #if($!{fexForeignReqPage.remitType} == "1")
                        ##汇款人名称（英文）
                        <td class="textRight">#springMessage('table.fexForeignReq.payerNameEn')</td>
                        <td>$!{fexForeignReqPage.payerNameEn}</td>
                    ##收款银行之代理行名称
                    <td class="textRight">#springMessage('table.fexForeignReq.payeeAgentBank')</td>
                    <td>$!{fexForeignReqPage.payeeAgentBank}</td>
                </tr>
                <tr>
##                    #if($!{fexForeignReqPage.remitType} == "1")
                        ##汇款人地址（英文）
                        <td class="textRight">#springMessage('table.fexForeignReq.payerAddEn')</td>
                        <td>$!{fexForeignReqPage.payerAddEn}</td>
                    ##收款银行之代理行地址
                    <td class="textRight">#springMessage('table.fexForeignReq.payeeAgentBankAdd')</td>
                    <td>$!{fexForeignReqPage.payeeAgentBankAdd}</td>
                </tr>
                <tr>
                    ##账户类别
                    <td class="textRight">#springMessage('table.btBankAcc.accType')</td>
                    <td>$dictTag.get("btBankAcc.accType",$!{fexForeignReqPage.accType})</td>
                    ##收款人开户行银行在其代理行账号
                    <td class="textRight">#springMessage('table.fexForeignReq.payeeAgentAcc')</td>
                    <td>$!{fexForeignReqPage.payeeAgentAcc}</td>
                </tr>
                <tr>
                    ##汇款金额
                    <td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
                    <td>
                        $!number.formatNumeric($!{fexForeignReqPage.payMoney})
                        <input type="hidden" data-name="payMoney" data-toUp="payMoneyUp" autocomplete="off"
                               class="layui-input bt-biz-moneyType" value="$!{fexForeignReqPage.payMoney}">
                    </td>
                    <td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
                    <td style="padding-left:0px"><div id="payMoneyUp" style="line-height: 24px; white-space: normal; word-break: break-all;"></div></td>
                </tr>
                <tr>
                    ##资金性质
                    <td class="textRight">#springMessage('table.fexTranReq.accNature')</td>
                    <td colspan="3">
                        $dictTag.get("fexTranReq.accNature",$!{fexForeignReqPage.accNature})
                    </td>
                </tr>
                #if($!{fexForeignReqPage.isOnline} == "0")
                <tr id="foreignMoneyTr">
                    ##购汇汇率
                    <td class="textRight">#springMessage('table.fexForeignReq.foreignExrate')</td>
                    <td><label id="foreignExrateText"></label><input type="hidden" id="foreignExrate" name="foreignExrate" value="$!{fexForeignReqPage.foreignExrate}"></td>
                    ##购汇金额
                    <td class="textRight">#springMessage('table.fexForeignReq.foreignMoney')</td>
                    <td>$!number.formatNumeric($!{fexForeignReqPage.foreignMoney})</td>
                </tr>
                #end
                <tr>
                    ##汇款附言
                    <td class="textRight">#springMessage('table.fexForeignReq.addWordEn')</td>
                    <td>$!{fexForeignReqPage.addWord}</td>
                    ##收款人类型
                    #*<td class="textRight">#springMessage('table.fexForeignReq.payeeType')</td>
                    <td>$dictTag.get("fexForeignReq.payeeType",$!{fexForeignReqPage.payeeType})</td>*#
                    #if($!{bankType.isSetPayeeType} == "1" && $!{bankType.applayScopePayeeType.indexOf("4")} != -1)
                        ##收款人类型
                        <td class="textRight">#springMessage('table.fexForeignReq.payeeType')</td>
                        <td>
                            #if($!{bankType.isSetPayeeType} == "1" && $!{bankType.applayScopePayeeType.indexOf("4")} != -1 && $!{payeeType.customCode} && $!{payeeType.customCode} != "")
                                ($!{payeeType.customCode})$!{payeeType.customName}
                            #end
                        </td>
                    #else
                        <td></td>
                        <td></td>
                    #end
                </tr>
                <tr>
                    ##现金流项目
                    <td class="textRight">#springMessage('finacial.common.cashFlow.item')</td>
                    <td>$!{fexForeignReqPage.cashItemName}</td>
                    ##是否线下付款
                    <td class="textRight">#springMessage('table.fexTranReq.isPayed')</td>
                    <td>$dictTag.get("sf_yn",$!{fexForeignReqPage.isPayed})</td>
                </tr>
                <tr>
                    ##备注
                    <td class="textRight">#springMessage('fcVoucherType.rmk')</td>
                    <td>$!{fexForeignReqPage.rmk}</td>
                    #if($!{bankType.isSetBankPayType} == "1" && $!{bankType.applayScopeBankPayType.indexOf("4")} != -1)
                        ##支付类型
                        <td class="textRight">#springMessage('table.nisBillhead.bankPayType')</td>
                        <td>
                            #if($!{bankType.isSetBankPayType} == "1" && $!{bankType.applayScopeBankPayType.indexOf("4")} != -1 && $!{bankPayType.customCode} && $!{bankPayType.customCode} != "")
                                ($!{bankPayType.customCode})$!{bankPayType.customName}
                            #end
                        </td>
                    #else
                        <td></td>
                        <td></td>
                    #end
                </tr>
            </tbody>
        </table>
        <table class="layui-table">
            <thead>
                <tr>
                    <th colspan="4">#springMessage('table.fexForeignReq.otherInfo')</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    ##发电等级 0-普通 Normal  1-加急 Urgent
                    <td class="textRight" width="20%">#springMessage('table.fexForeignReq.quickSign')</td>
                    <td width="30%">$dictTag.get("fexForeignReq.quickSign",$!{fexForeignReqPage.quickSign})</td>
                    ##付汇性质 1-保税区 2-出口加工区 3-钻石交易所 4-其他特殊经济区域 5-深加工结转 6-离岸账户 7-其他
                    <td class="textRight" width="20%"><div id="remitNatureTd1">#springMessage('table.fexForeignReq.remitNature')</div></td>
                    <td width="30%">$dictTag.get("fexForeignReq.remitNature",$!{fexForeignReqPage.remitNature})</td>
                </tr>
                <tr>
                    ##汇款方式 0-电汇 1-票汇
                    <td class="textRight">#springMessage('table.fexForeignReq.remitMethod')</td>
                    <td>$dictTag.get("fexForeignReq.remitMethod",$!{fexForeignReqPage.remitMethod})</td>
                    ##国内外费用承担标志 1-汇款人 OUR  2-收款人 BEN  3-共同 SHA
                    <td class="textRight">#springMessage('table.fexForeignReq.costSign')</td>
                    <td>$dictTag.get("fexForeignReq.costSign",$!{fexForeignReqPage.costSign})</td>
                </tr>
                <tr>
                    ##付款类型 1-预付货款 2-货到付款 3-退款 4-其他
                    <td class="textRight">#springMessage('table.fexForeignReq.payType')</td>
                    <td>$dictTag.get("fexForeignReq.payType",$!{fexForeignReqPage.payType})</td>
                    ##最迟装运日期
                    <td class="textRight">#springMessage('table.fexForeignReq.shipDate')</td>
                    <td>$!date.format('yyyy-MM-dd',$!{fexForeignReqPage.shipDate})</td>
                </tr>
                <tr>
                    ##是否为保税货物项下付款 0-否 1-是
                    <td class="textRight">#springMessage('table.fexForeignReq.isBonded')</td>
                    <td>$dictTag.get("sf_yn",$!{fexForeignReqPage.isBonded})</td>
                    ##外汇局批件/备案表号/业务编号
                    <td class="textRight">#springMessage('table.fexForeignReq.busNo')</td>
                    <td>$!{fexForeignReqPage.busNo}</td>
                </tr>
                    #if($!{fexForeignReqPage.bankTypeName} == "兴业银行")
                    <tr>
                        ##进口日期
                        <td class="textRight">#springMessage('table.fexForeignReq.arrivalDate')</td>
                        <td>$!date.format('yyyy-MM-dd',$!{fexTranReqPage.arrivalDate})</td>
                        ##报关单号
                        <td class="textRight">#springMessage('table.fexForeignReq.declareNo')</td>
                        <td>$!{fexTranReqPage.declareNo}</td>
                    </tr>
                    #end
                <tr>
                    ##合同号
                    <td class="textRight">#springMessage('table.fexForeignReq.contractNo')</td>
                    <td>$!{fexForeignReqPage.contractNo}</td>
                    ##发票号
                    <td class="textRight">#springMessage('table.fexForeignReq.invoiceNo')</td>
                    <td>$!{fexForeignReqPage.invoiceNo}</td>
                </tr>
                <tr>
                    ##交易编码1
                    <td class="textRight">#springMessage('table.fexForeignReq.tranCode1')</td>
                    <td>$!{fexForeignReqPage.tranName1}</td>
                    ##交易编码2
                    <td class="textRight">#springMessage('table.fexForeignReq.tranCode2')</td>
                    <td>$!{fexForeignReqPage.tranName2}</td>
                </tr>
                <tr>
                    ##相应金额1
                    <td class="textRight">#springMessage('table.fexForeignReq.tranAmt1')</td>
                    <td>$!number.formatNumeric($!{fexForeignReqPage.tranAmt1})</td>
                    ##相应金额2
                    <td class="textRight">#springMessage('table.fexForeignReq.tranAmt2')</td>
                    <td>$!number.formatNumeric($!{fexForeignReqPage.tranAmt2})</td>
                </tr>
                <tr>
                    ##相应币种1
                    <td class="textRight">#springMessage('table.fexForeignReq.tranCurId1')</td>
                    <td>$!{fexForeignReqPage.curName}</td>
                    ##相应币种2
                    <td class="textRight">#springMessage('table.fexForeignReq.tranCurId2')</td>
                    <td>$!{fexForeignReqPage.curName}</td>
                </tr>
                <tr>
                    ##交易附言1
                    <td class="textRight">#springMessage('table.fexForeignReq.tranAddWord1')</td>
                    <td>$!{fexForeignReqPage.tranAddWord1}</td>
                    ##交易附言2
                    <td class="textRight">#springMessage('table.fexForeignReq.tranAddWord2')</td>
                    <td>$!{fexForeignReqPage.tranAddWord2}</td>
                </tr>
                <tr>
                    ##汇款去向
                    <td class="textRight">#springMessage('table.fexForeignReq.remitRoute')</td>
                    <td>$dictTag.get("fexForeignReq.remitRoute",$!{fexForeignReqPage.remitRoute})</td>
                    ##汇款用途
                    <td class="textRight">#springMessage('table.fexForeignReq.remitUse')</td>
                    <td>$!{fexForeignReqPage.remitUse}</td>
                </tr>
            </tbody>
        </table>
		<!-- 资金计划 -->
		<div id="tagItemDetail"></div>
        </div>
        <!-- 附件上传 -->
        <input id="attachmentId" name="attachmentId" type="hidden" value="$!{fexForeignReqPage.attachmentId}">
        <div id="uploader" class="layui-input-inline" style="width:100%"></div>
        <p>
		<!-- 日志 -->
		<div id="tagMsg"></div>
        <div class="layui-form-item layui-form-submit" id="buttonDiv">
			<div class="layui-input-block">
				<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{fexForeignReqPage.id}')">#springMessage('common.button.trackFlow')</button>
				<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
			</div>
        </div>
	</form>
    #parse("views/common/footer.vm")
	<script src="${basePath}/static/modules/foreign/fexForeignReq.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
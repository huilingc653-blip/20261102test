<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{fexExposureItemPage.id}">
    <input type="hidden" id="superItemCode" name="superItemCode" value="$!{fexExposureItemPage.superItemCode}">
    <input type="hidden" id="isSubItem" name="isSubItem" value="$!{isSubItem}">
    <table class="layui-table">
        <tbody>
        <tr>
		    ##父科目
            <td class="textRight">#springMessage('table.fbsItem.superItemCode')</td>
            <td colspan="3">
                #if(${isSubItem} == "1")
                    ($!{fexExposureItemPage.superItemCode})$!{fexExposureItemPage.superItemName}
                #else
                    <div class="layui-input-inline">
                        <div class="parentIdTree"></div>
                    </div>
                #end
            </td>
        </tr>
        <tr>
		    ##科目名称
            <td class="textRight">#springMessage('table.fbsItem.itemName')</td>
            <td width="40%">
                <input type="text" id="itemName" name="itemName" lay-verify="required|strlength" data-maxlength="100"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsItem.itemName')" value="$!{fexExposureItemPage.itemName}">
            </td>
		    ##资金流向
            <td class="textRight">#springMessage('table.fbsItem.sign')</td>
            <td >
				#if(${isSubItem} == "1")
                    <div class="bt-biz-dict" data-type="radio" data-group="fbsItem.sign" data-name="sign" data-required="true"
                         data-defaultvalue="$!{fexExposureItemPage.sign}" data-biz-name="sign"></div>
				#else
                    <div class="bt-biz-dict" data-type="radio" data-group="fbsItem.sign" data-name="sign" data-required="true"
                         data-defaultvalue="1" data-biz-name="sign"></div>
				#end
            </td>
        </tr>
        <tr>
            ##科目内是否自然对冲 1-是 0-否
            <td class="textRight">#springMessage('foreign.fexExposureItem.isNaturalHedge')</td>
            <td >
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="isNaturalHedge" data-required="true"
                     data-defaultvalue="1" data-biz-name="isNaturalHedge"></div>
            </td>
            ##有效标志
            <td class="textRight">#springMessage('table.fbsItem.validSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-name="validSign" data-required="true"
                     data-defaultvalue="1" data-biz-name="validSign"></div>
            </td>
        </tr>
        <tr>
            ##备注
            <td class="textRight">#springMessage('table.fbsItem.rmk')</td>
            <td colspan="3">
                <input lay-verify="strlength" type="text" id="rmk" name="rmk" style="width: 100%" class="layui-input" data-maxlength="100"
                       autocomplete="off" placeholder="#springMessage('table.fbsItem.rmk')" value="$!{fexExposureItemPage.rmk}">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexExposureItem.add.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fexCashFlowPage.id}">
		<input id="opType" name="opType" type="hidden" value="$!{fexCashFlowPage.opType}">
		<div class="layui-collapse">
			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('table.fexCashFlow.title')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
						<tr>
							##现金流号码
							<td class="textRight" width="20%">#springMessage('table.fexCashFlow.billNo')</td>
							<td width="30%">$!{fexCashFlowPage.billNo}</td>
							##产品
							<td class="textRight" width="20%">#springMessage('table.foreign.product')</td>
							<td  width="30%">$!{fexCashFlowPage.proName}</td>
						</tr>
						<tr>
							##净额结算号
							<td class="textRight">#springMessage('table.fexCashFlow.settleNo')</td>
							<td>$!{fexCashFlowPage.settleNo}</td>
							##现金流日期
							<td class="textRight" width="20%">#springMessage('table.fexTranReq.cashFlowDate')</td>
							<td width="30%">$!date.format('yyyy-MM-dd',$!{fexCashFlowPage.cashFlowDate})</td>
						</tr>
						<tr>
							##结算日期
							<td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
							<td >$!date.format('yyyy-MM-dd',$!{fexCashFlowPage.settleDate})</td>
							##币种
							<td class="textRight" width="20%">#springMessage('table.bisAccDtl.curName')</td>
							<td width="30%">$!{fexCashFlowPage.englishCode}</td>
						</tr>
						<tr>
							##收付方向
							<td class="textRight">#springMessage('table.foreign.cdSign')</td>
							<td>$dictTag.get("nisBusType.cdSign",$!{fexCashFlowPage.cdSign})</td>
							##金额
							<td class="textRight" width="20%">#springMessage('table.choBankFinance.payMoney')</td>
							<td width="30%">$!number.formatNumeric($!{fexCashFlowPage.payMoney})</td>
						</tr>
						<tr>
							##单位
							<td class="textRight" width="20%">#springMessage('table.nisBillhead.corpId')</td>
							<td width="30%">$!{fexCashFlowPage.corpName}</td>
							##银行
							<td class="textRight" width="20%">#springMessage('common.button.bank')</td>
							<td width="30%">$!{fexCashFlowPage.corpBankName}</td>
						</tr>
						<tr>
							##账户名称
							<td class="textRight">#springMessage('table.btBankAccApp.accName')</td>
							<td>$!{fexCashFlowPage.corpAccName}</td>
							##银行账户
							<td class="textRight" width="20%">#springMessage('table.nisBillhead.bankAcc')</td>
							<td width="30%">$!{fexCashFlowPage.corpBankAcc}</td>
						</tr>
						<tr>
							##交易对手
							<td class="textRight">#springMessage('fex.cotp')</td>
							<td>
								#if($!{fexCashFlowPage.tranType} == "3")
									$!{fexCashFlowPage.allocatCotpName}
								#else
									$!{fexCashFlowPage.cotpName}
								#end
							</td>
							##交易对手银行
							<td class="textRight" width="20%">#springMessage('table.fexTranReq.cotpBank')</td>
							<td width="30%">
								#if($!{fexCashFlowPage.tranType} == "3")
									$!{fexCashFlowPage.allocatCotpBankName}
								#else
									$!{fexCashFlowPage.cotpBankName}
								#end
							</td>
						</tr>
						<tr>
							##交易对手账户名称
							<td class="textRight" width="20%">#springMessage('fex.cotp')#springMessage('table.btBankAccApp.accName')</td>
							<td width="30%">$!{fexCashFlowPage.cotpAccName}</td>
							##交易对手银行账户
							<td class="textRight" width="20%">#springMessage('fex.cotp')#springMessage('table.nisBillhead.bankAcc')</td>
							<td width="30%">$!{fexCashFlowPage.cotpBankAcc}</td>
						</tr>
						<tr>
							##结算类型
							<td class="textRight" width="20%">#springMessage('fcVoucherType.settlType')</td>
							<td width="30%">$dictTag.get("fexCashFlow.settleType",$!{fexCashFlowPage.settleType})</td>
							##支付方式
							<td class="textRight">#springMessage('table.foreign.voucherType')</td>
							<td width="30%">$!{fexCashFlowPage.voucherTypeName}</td>
						</tr>
						<tr>
							##现金流类型
							<td class="textRight" width="20%">#springMessage('table.fexBankAcc.cashFlowType')</td>
							<td colspan="3">$dictTag.get("fexCorp.cashFlowType",$!{fexCashFlowPage.cashFlowType})</td>
						</tr>
						</tbody>
					</table>
				</div>
			</div>

			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
							#if($!{fexCashFlowPage.tranType} == "1")
							<tr>
								##交易号码
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
								<td width="30%">$!{fexTranReqPage.billNo}</td>
								##合同汇率
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.contractRate')</td>
								<td width="30%">
									$!number.formatDoubles($!{fexTranReqPage.contractRate},6)
								</td>
							</tr>
							<tr>
								##钞汇标识
								<td class="textRight">#springMessage('table.fexTranReq.bankNote')</td>
								<td>$dictTag.get("fex.tranApp.bankNote",$!{fexTranReqPage.bankNote})</td>
								##交易日期
								<td class="textRight">#springMessage('table.revenue.transTime')</td>
								<td >$!date.format('yyyy-MM-dd',$!{fexTranReqPage.tranDate})</td>
							</tr>
							<tr>
								##交割期限
								<td class="textRight">#springMessage('table.fexTranReq.deliveryDeadline')</td>
								<td>T+$!{fexTranReqPage.deliveryDeadline}</td>
								##保证方式
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.boodType')</td>
								<td width="30%">$dictTag.get("fex.tranApp.boodType",$!{fexTranReqPage.boodType})</td>
							</tr>
							<tr>
								##保证金比例
								<td class="textRight">#springMessage('table.fexTranReq.boodRatio')</td>
								<td>$!rateTag.show($!{fexTranReqPage.boodRatio})</td>
								</td>
								##保证金账号
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.boodAcc')</td>
								<td width="30%">$!{fexTranReqPage.boodAcc}</td>
							</tr>
							<tr>
								##保证金币种
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.bondCurId')</td>
								<td width="30%">$!{fexTranReqPage.bondEnglishCode}</td>
								##其它保证方式说明
								<td class="textRight">#springMessage('table.fexTranReq.boodRmk')</td>
								<td>$!{fexTranReqPage.boodRmk}</td>
							</tr>
							<tr>
								##合同号
								<td class="textRight">#springMessage('table.fexForeignReq.contractNo')</td>
								<td>$!{fexTranReqPage.contractNo}</td>
								##发票号
								<td class="textRight">#springMessage('table.fexForeignReq.invoiceNo')</td>
								<td>$!{fexTranReqPage.invoiceNo}</td>
							</tr>
							<tr>
								##联系人
								<td class="textRight" width="20%">#springMessage('table.externalCorp.linkMan')</td>
								<td width="30%">$!{fexTranReqPage.corpContact}</td>
								##电话
								<td class="textRight" width="20%">#springMessage('table.externalCorp.tel')</td>
								<td width="30%">$!{fexTranReqPage.corpContactTel}</td>
							</tr>
							<tr>
								##额度
								<td class="textRight" width="20%">#springMessage('table.guaContract.trackMoney')</td>
								<td width="30%">$!number.formatNumeric($!{fexTranReqPage.payMoney})</td>
								##资金来源
								<td class="textRight">#springMessage('table.fexTranReq.fundsSource')</td>
								<td>$dictTag.get("fex.tranApp.fundsSource",$!{fexTranReqPage.fundsSource})</td>
							</tr>
							<tr>
								##资金性质
								<td class="textRight">#springMessage('table.fexTranReq.accNature')</td>
								<td>$dictTag.get("fexTranReq.accNature",$!{fexTranReqPage.accNature})</td>
								##外汇局批件/备案表号/业务编号
								<td class="textRight">#springMessage('table.fexForeignReq.busNo')</td>
								<td>$!{fexTranReqPage.busNo}</td>
							</tr>
							<tr>
								##备注
								<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
								<td colspan="3">$!{fexTranReqPage.rmk}</td>
							</tr>
							#elseif($!{fexCashFlowPage.tranType} == "2")
							<tr>
								##交易号码
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
								<td width="30%">$!{fexTranReqPage.billNo}</td>
								##交易日期
								<td class="textRight" width="20%">#springMessage('table.revenue.transTime')</td>
								<td width="30%">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.tranDate})</td>
							</tr>
							<tr>
								##外汇期权品种
								<td class="textRight">#springMessage('table.fexProduct.fexOption')</td>
								<td>
									$dictTag.get("fexProduct.fexOption1",$!{fexTranReqPage.fexOption1})&nbsp;
									$dictTag.get("fexProduct.fexOption2",$!{fexTranReqPage.fexOption2})&nbsp;
									$dictTag.get("fexProduct.fexOption3",$!{fexTranReqPage.fexOption3})
								</td>
								##外汇期权类型
								<td class="textRight">#springMessage('table.fexProduct.fexOptionType')</td>
								<td>$dictTag.get("fexProduct.fexOptionType",$!{fexTranReqPage.fexOptionType})</td>
							</tr>
							<tr>
								##买卖方向
								<td class="textRight">#springMessage('fex.tranApp2.businessDirection')</td>
								<td>$dictTag.get("fexTranDeal.deliverySign",$!{fexTranReqPage.busDirection})</td>
								##跌涨方向
								<td class="textRight">#springMessage('fex.tranApp2.upAndDownDirection')</td>
								<td >$dictTag.get("fex.tranApp2.updownDirection",$!{fexTranReqPage.updownDirection})</td>
							</tr>
							<tr>
								##买权币种
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.buyCurIdOption')</td>
								<td width="30%">$!{fexTranReqPage.buyEnglishCode}</td>
								##买权金额
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.buyMoneyOption')</td>
								<td width="30%">$!number.formatNumeric($!{fexTranReqPage.buyMoney})</td>
							</tr>
							<tr>
								##卖权币种
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.sellCurIdOption')</td>
								<td width="30%">$!{fexTranReqPage.sellEnglishCode}</td>
								##卖权金额
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.sellMoneyOption')</td>
								<td width="30%">$!number.formatNumeric($!{fexTranReqPage.sellMoney})</td>
							</tr>
							<tr>
								##协定汇率
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.agreeRate')</td>
								<td>$!number.formatDoubles($!{fexTranReqPage.contractRate},6)</td>
								##到期日期
								<td class="textRight" width="20%">#springMessage('table.fcAcc.deadlineDate')</td>
								<td width="30%" >$!date.format('yyyy-MM-dd HH:mm:ss',$!{fexTranReqPage.expiresDate})</td>
							</tr>
							<tr>
								##备注
								<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
								<td colspan="3">$!{fexTranReqPage.rmk}</td>
							</tr>
							#elseif($!{fexCashFlowPage.tranType} == "3")
							<tr>
								##交易号码
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
								<td width="30%">$!{fexTranReqPage.billNo}</td>
								##交易日期
								<td class="textRight" width="20%">#springMessage('table.revenue.transTime')</td>
								<td width="30%">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.tranDate})</td>
							</tr>
							<tr>
								##汇款类型
								<td class="textRight">#springMessage('table.fexForeignReq.remitMethod')</td>
								<td>$dictTag.get("fexForeignReq.remitMethod",$!{fexTranReqPage.remitMethod})</td>
								##资金性质
								<td class="textRight">#springMessage('table.fexTranReq.accNature')</td>
								<td>$dictTag.get("fexTranReq.accNature",$!{fexTranReqPage.accNature})</td>
							</tr>
							<tr>
								##资金用途
								<td class="textRight">#springMessage('table.fexTranReq.capitalUse')</td>
								<td colspan="3">$!{fexTranReqPage.capitalUse}
							</tr>
							<tr>
								##备注
								<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
								<td colspan="3">$!{fexTranReqPage.rmk}</td>
							</tr>
							#else
							<tr>
								##交易号码
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.billNo')</td>
								<td width="30%">$!{fexTranReqPage.billNo}</td>
								##交易日期
								<td class="textRight" width="20%">#springMessage('table.revenue.transTime')</td>
								<td width="30%">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.tranDate})</td>
							</tr>
							<tr>
								##汇款类型
								<td class="textRight">#springMessage('table.fexForeignReq.remitMethod')</td>
								<td>$dictTag.get("fexForeignReq.remitMethod",$!{fexTranReqPage.remitMethod})</td>
								#if($!{fexTranReqPage.remitType} == "2")
									<td></td>
									<td></td>
								#else
									##被代收/代付单位
									<td class="textRight">#springMessage('table.fexTranReq.payCorpId')</td>
									<td>$!{fexTranReqPage.payCorpName}</td>
								#end
							</tr>
							<tr>
								##资金性质
								<td class="textRight">#springMessage('table.fexTranReq.accNature')</td>
								<td>$dictTag.get("fexTranReq.accNature",$!{fexTranReqPage.accNature})</td>
								##付款类型 1-预付货款 2-货到付款 3-退款 4-其他
								<td class="textRight">#springMessage('table.fexForeignReq.payType')</td>
								<td>$dictTag.get("fexForeignReq.payType",$!{fexTranReqPage.payType})</td>
							</tr>
							<tr>
								##最迟装运日期
								<td class="textRight">#springMessage('table.fexForeignReq.shipDate')</td>
								<td >$!date.format('yyyy-MM-dd',$!{fexTranReqPage.shipDate})</td>
								##外汇局批件/备案表号/业务编号
								<td class="textRight">#springMessage('table.fexForeignReq.busNo')</td>
								<td>$!{fexTranReqPage.busNo}</td>
							</tr>
							<tr>
								##合同号
								<td class="textRight">#springMessage('table.fexForeignReq.contractNo')</td>
								<td>$!{fexTranReqPage.contractNo}</td>
								##发票号
								<td class="textRight">#springMessage('table.fexForeignReq.invoiceNo')</td>
								<td>$!{fexTranReqPage.invoiceNo}</td>
							</tr>
							<tr>
								##交易编码1
								<td class="textRight">#springMessage('table.fexForeignReq.tranCode1')</td>
								<td>$!{fexTranReqPage.tranName1}</td>
								##交易编码2
								<td class="textRight">#springMessage('table.fexForeignReq.tranCode2')</td>
								<td>$!{fexTranReqPage.tranName2}</td>
							</tr>
							<tr>
								##相应金额1
								<td class="textRight">#springMessage('table.fexForeignReq.tranAmt1')</td>
								<td>$!number.formatNumeric($!{fexTranReqPage.tranAmt1})</td>
								##相应金额2
								<td class="textRight">#springMessage('table.fexForeignReq.tranAmt2')</td>
								<td>$!number.formatNumeric($!{fexTranReqPage.tranAmt2})</td>
							</tr>
							<tr>
								##相应币种1
								<td class="textRight">#springMessage('table.fexForeignReq.tranCurId1')</td>
								<td>$!{fexTranReqPage.tranEnglishCode1}</td>
								##相应币种2
								<td class="textRight">#springMessage('table.fexForeignReq.tranCurId2')</td>
								<td>$!{fexTranReqPage.tranEnglishCode2}</td>
							</tr>
							<tr>
								##交易附言1
								<td class="textRight">#springMessage('table.fexForeignReq.tranAddWord1')</td>
								<td>$!{fexTranReqPage.tranAddWord1}</td>
								##交易附言2
								<td class="textRight">#springMessage('table.fexForeignReq.tranAddWord2')</td>
								<td>$!{fexTranReqPage.tranAddWord2}</td>
							</tr>
							<tr>
								##付汇性质 1-保税区 2-出口加工区 3-钻石交易所 4-其他特殊经济区域 5-深加工结转 6-离岸账户 7-其他
								<td class="textRight" width="20%">#springMessage('table.fexForeignReq.remitNature')</td>
								<td width="30%">
									$dictTag.get("fexForeignReq.remitNature",$!{fexTranReqPage.remitNature})
								</td>
								<td></td>
								<td></td>
							</tr>
							<tr>
								##备注
								<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
								<td colspan="3">$!{fexTranReqPage.rmk}</td>
							</tr>
							#end
						</tbody>
					</table>
					#if($!{fexCashFlowPage.tranType} == "1" || $!{fexCashFlowPage.tranType} == "2" || $!{fexCashFlowPage.tranType} == "4")
						<!-- 附件上传 -->
						<input id="tranAttachmentId" name="tranAttachmentId" type="hidden" value="$!{fexTranReqPage.attachmentId}">
						<div id="tranUploader" class="layui-input-inline" style="width:100%"></div>
					#end
				</div>
			</div>
			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('table.fexCashFlow.settleInfo')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
						<tr>
							##主体单位银行SWIFT CODE
							<td class="textRight" width="20%">#springMessage('table.fexCashFlow.corpSwiftCode')</td>
							<td width="30%">$!{corpBankAcc.bankCode}</td>
							##主体单位地址
							<td class="textRight" width="20%">#springMessage('table.fexCashFlow.corpAddr')</td>
							<td width="30%">$!{corp.address}</td>
						</tr>
						<tr>
							##主体单位名称(英文)
							<td class="textRight" width="20%">#springMessage('table.fexTranReq.corpNameEn')</td>
							<td width="30%">$!{fexTranReqPage.corpNameEn}</td>
							##主体单位地址(英文)
							<td class="textRight" width="20%">#springMessage('table.fexTranReq.corpAddrEn')</td>
							<td width="30%">$!{fexTranReqPage.corpAddrEn}</td>
						</tr>
						<tr>
							##交易对手银行Swift Code
							<td class="textRight">#springMessage('table.fexTranReq.cotpSwiftCode')</td>
							<td>$!{fexTranReqPage.cotpSwiftCode}</td>
							##交易对手地址
							<td class="textRight">#springMessage('fex.cotp')#springMessage('table.externalCorp.address')</td>
							<td>$!{fexTranReqPage.cotpAdrr}</td>
						</tr>
						<tr>
							##交易对手所在国家地区
							<td class="textRight">#springMessage('table.fexTranReq.cotpCountry')</td>
							<td>
								$!{fexTranReqPage.cotpCountryName}
									#if($!{fexTranReqPage.cotpCountryName} == "中国")
									$!{fexTranReqPage.cotpProvName} $!{fexTranReqPage.cotpCityName}
								#else
									$!{fexTranReqPage.cotpAddressName}
								#end
							</td>
							##交易对手银行地址
							<td class="textRight">#springMessage('table.fexTranReq.cotpBankAdrr')</td>
							<td>$!{fexTranReqPage.cotpBankAdrr}</td>
						</tr>
						<tr>
							##交易对手代理行
							<td class="textRight">#springMessage('fex.cotp')#springMessage('table.fexTranReq.agentBank')</td>
							<td>$!{fexTranReqPage.cotpAgentBank}</td>
							##交易对手代理行地址
							<td class="textRight">#springMessage('table.fexTranReq.agentBankAddr')</td>
							<td>$!{fexTranReqPage.cotpAgentBankAddr}</td>
						</tr>
						<tr>
							##交易对手在代理行的账户
							<td class="textRight">#springMessage('table.fexTranReq.agentAcc')</td>
							<td>$!{fexTranReqPage.cotpAgentBankAcc}</td>
							##加急标志
							<td class="textRight">#springMessage('table.nisBillhead.isQuick')</td>
							<td>$dictTag.get("sf_yn",$!{fexTranReqPage.isQuick})</td>
						</tr>
						<tr>
							##国内外费用承担标志 1-汇款人 OUR  2-收款人 BEN  3-共同 SHA
							<td class="textRight" width="20%">#springMessage('table.fexForeignReq.costSign')</td>
							<td width="30%">$dictTag.get("fexForeignReq.costSign",$!{fexTranReqPage.costSign})</td>
							##费用支出账户
							<td class="textRight" width="20%">#springMessage('table.fexTranReq.costAcc')</td>
							<td width="30%">$!{fexTranReqPage.costAcc}</td>
						</tr>
						</tbody>
					</table>
				</div>
			</div>
			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('fex.cotp.customInformation')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table layui-form">
						#foreach($element in $custFields)
							#if($velocityCount % 2 == 0)
								<td class="textRight" width="20%">
									$!{element.fieldName}
									<input type="hidden" name="fexCashFlowCustInfos[$velocityCount].fieldId" value="$!{element.id}">
								</td>
								<td width="30%">
									<div class="layui-input-inline">
										<input type="text" class="layui-input" name="fexCashFlowCustInfos[$velocityCount].fieldVal" style="display: inline"
											   value="$!{element.fieldVal}">
									</div>
								</td>
								</tr>
							#else
							<tr>
								<td class="textRight" width="20%">
									$!{element.fieldName}
									<input type="hidden" name="fexCashFlowCustInfos[$velocityCount].fieldId" value="$!{element.id}">
								</td>
								<td width="30%">
									<div class="layui-input-inline">
										<input type="text" class="layui-input" name="fexCashFlowCustInfos[$velocityCount].fieldVal" style="display: inline"
											   value="$!{element.fieldVal}">
									</div>
								</td>
								#if($foreach.last)
									<td></td>
									<td></td>
								</tr>
								#end
							#end
						#end
					</table>
				</div>
			</div>
			<div class="layui-colla-item">
				<h2 class="layui-colla-title">#springMessage('table.fexCashFlow.gatherInfo')</h2>
				<div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
						<tr>
							##实际收款金额
							<td class="textRight" width="20%">#springMessage('table.fexCashFlow.factsMoney')</td>
							<td width="30%">
								<input type="text" id="factsMoney" name="factsMoney" style="text-align:right" lay-verify="number2"
									   data-name="factsMoney" data-biz-name="factsMoney"
									   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexCashFlow.factsMoney')" value="$!{fexCashFlowPage.factsMoney}">
							</td>
							##实际收款日期
							<td class="textRight">#springMessage('table.fexCashFlow.factsDate')</td>
							<td >
								<input type="text" name="factsDate" class="layui-input bt-biz-dateType"
									   data-type="date" data-name="factsDate" data-biz-name="factsDate" value="$!{fexCashFlowPage.factsDate}">
							</td>
						</tr>
						<tr>
							##备注
							<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
							<td colspan="3">
								<textarea placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" lay-verify="strlength" data-maxlength="200" style="width:100%" id="rmk" name="rmk" >$!{fexCashFlowPage.rmk}</textarea>
							</td>
						</tr>
						<tr>
							<td colspan="4">
								<!-- 附件上传 -->
								<input id="attachmentId" name="attachmentId" type="hidden" value="$!{fexCashFlowPage.attachmentId}">
								<div id="uploader" class="layui-input-inline" style="width:100%"></div>
							</td>
						</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<div style="text-align: center; padding-top: 10px;">
			<button class="layui-btn" lay-submit="" lay-filter="submit" value="11" >#springMessage('common.button.submit')</button>
			<button class="layui-btn" lay-submit="" lay-filter="submit" value="0" >#springMessage('common.button.temp')</button>
			<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexCashFlow.edit.js?_btv=${resourceVersion}"></script>
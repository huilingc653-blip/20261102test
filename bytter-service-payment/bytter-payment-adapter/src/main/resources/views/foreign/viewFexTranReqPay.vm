<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
	<ul class="layui-tab-title">
		<li class="layui-this">#springMessage('table.rasBackQuery.msg')</li>
		<li>#springMessage('table.fexTranReq.cashFlow')</li>
		<li>#springMessage('fex.cotp.customInformation')</li>
	</ul>
	<div class="layui-tab-content">
		<div class="layui-tab-item layui-show">
			<div id="print">
			<form class="layui-form" method="post">
				<!-- 系统参数 -->
				<input id="id" name="id" type="hidden" value="$!{fexTranReqPage.id}">
				<input id="billNo" name="billNo" type="hidden" value="$!{fexTranReqPage.billNo}">
				<input id="corpId" name="corpId" type="hidden" value="$!{fexTranReqPage.corpId}">
				<input id="settleDate" name="settleDate" type="hidden" value="$!{fexTranReqPage.settleDate}">
				<input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
				<input id="payItem" name="payItem" type="hidden" value="$!{payItem}">
				<input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
				<input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
				<input id="busType" name="busType" type="hidden" value="$!{busType}">

				<!-- 资金计划参数 明细项控制模式-->
				<input id="dtlColSel" name="dtlColSel" type="hidden" value="$!{fbsBudgetTag.getDtlColSel()}">
				<input id="curId" name="curId" type="hidden" value="$!{fexTranReqPage.curId}">
				<input id="corpBankAcc" name="corpBankAcc" type="hidden" value="$!{fexTranReqPage.corpBankAcc}">
				<input id="cotpAccName" name="cotpAccName" type="hidden" value="$!{fexTranReqPage.cotpAccName}">
				<input id="cotpBankAcc" name="cotpBankAcc" type="hidden" value="$!{fexTranReqPage.cotpBankAcc}">
				<input id="cdSign" name="cdSign" type="hidden" value="$!{fexTranReqPage.cdSign}">
				<table class="layui-table">
					<tbody>
					<tr>
						##交易号码
						<td class="textRight" width="20%" colspan="2">#springMessage('table.fexTranReq.billNo')</td>
						<td width="30%">$!{fexTranReqPage.billNo}</td>
						##交易需求编号
						<td class="textRight" width="20%" colspan="2">#springMessage('table.fexTranReq.tranAppDtlNo')</td>
						<td width="30%">$!{fexTranReqPage.tranAppDtlNo}</td>
					</tr>
					<tr>
						##产品
						<td class="textRight" width="20%" colspan="2">#springMessage('table.foreign.product')</td>
						<td width="30%">$!{fexTranReqPage.proName}</td>
						##跨行标志
						<td class="textRight" colspan="2" width="20%">#springMessage('table.nisBillhead.difBank')</td>
						<td width="30%">$dictTag.get("nisBillhead.difBank",$!{fexTranReqPage.difBank})</td>
					</tr>
					<tr>
						##收付方向
						<td class="textRight" width="20%" colspan="2">#springMessage('table.fexBankAcc.cdSign')</td>
						<td width="30%">$dictTag.get("fexCorp.cdSign",$!{fexTranReqPage.cdSign})</td>
						##资金性质
						<td class="textRight" width="20%" colspan="2">#springMessage('table.fexTranReq.accNature')</td>
						<td width="30%">$dictTag.get("fexTranReq.accNature",$!{fexTranReqPage.accNature})</td>
					</tr>
					<tr>
						##汇款类型
						<td class="textRight" width="20%" colspan="2">#springMessage('table.fexForeignReq.remitType')</td>
						<td>$dictTag.get("fexForeignReq.remitType",$!{fexTranReqPage.remitType})</td>
						##是否线下付款
						<td class="textRight" colspan="2" width="20%">#springMessage('table.fexTranReq.isPayed')</td>
						<td width="30%">$dictTag.get("sf_yn",$!{fexTranReqPage.isPayed})</td>
					</tr>
					<tr>
						<td rowspan="16" width="5%" align="center">#springMessage('table.fexTranReq.corpInfo')</td>
						##单位
						<td class="textRight" width="15%">#springMessage('table.nisBillhead.corpId')</td>
						<td width="30%">$!{fexTranReqPage.corpName}</td>
						<td rowspan="15" width="5%" align="center">#springMessage('table.fexTranReq.cotpInfo')</td>
						##交易对手
						<td class="textRight" width="15%">#springMessage('table.fexForeign.copt')</td>
						<td width="30%">$!{fexTranReqPage.cotpName}</td>
					</tr>
					<tr>
						##主体单位银行
						<td class="textRight" width="15%">#springMessage('table.fexTranReq.corpBank')</td>
						<td width="30%">$!{fexTranReqPage.corpBankName}</td>
						##交易对手银行
						<td class="textRight" width="15%">#springMessage('fex.cotp')#springMessage('common.button.bank')</td>
						<td width="30%">$!{fexTranReqPage.cotpBankName}</td>
					</tr>
					<tr>
						##主体单位银行账户
						<td class="textRight" width="15%">#springMessage('table.fexTranReq.corpBankAcc')</td>
						<td width="30%">$!{fexTranReqPage.corpBankAcc}</td>
						##交易对手银行账户
						<td class="textRight" width="15%">#springMessage('fex.cotp')#springMessage('table.fexForeign.bankAcc')</td>
						<td width="30%">$!{fexTranReqPage.cotpBankAcc}</td>
					</tr>
					<tr>
						##交易办理机构
						<td class="textRight">
							#if($!{fexTranReqPage.corpBankName} == "民生银行")
								#springMessage('table.fexTranReq.branchCode')
							#end
						</td>
						<td>
							#if($!{fexTranReqPage.corpBankName} == "民生银行")
							<div style="white-space: normal; word-break: break-all;">
								$!{fexTranReqPage.branchCode} $!{fexTranReqPage.branchName}
							</div>
							#end
						</td>
						##收款人类型
						#*<td class="textRight">#springMessage('table.fexForeignReq.payeeType')</td>
						<td>$dictTag.get("fexForeignReq.payeeType",$!{fexTranReqPage.payeeType})</td>*#
						#if($!{bankType.isSetPayeeType} == "1" && $!{bankType.applayScopePayeeType.indexOf("3")} != -1)
							##收款人类型
							<td class="textRight">#springMessage('table.fexForeignReq.payeeType')</td>
							<td>
								#if($!{bankType.isSetPayeeType} == "1" && $!{bankType.applayScopePayeeType.indexOf("3")} != -1 && $!{payeeType.customCode} && $!{payeeType.customCode} != "")
									($!{payeeType.customCode})$!{payeeType.customName}
								#end
							</td>
						#else
							<td></td>
							<td></td>
						#end
					</tr>
					<tr>
						##账户币种
						<td class="textRight" width="15%">#springMessage('table.fexForeign.cotpCurName')</td>
						<td width="30%">
							<div id="corpAccCurNameDiv" name="corpAccCurNameDiv">$!{fexTranReqPage.corpAccEnglishCode}</div>
						</td>
						##账户币种
						<td class="textRight" width="15%">#springMessage('table.fexForeign.cotpCurName')</td>
						<td width="30%">
							<div id="cotpAccCurNameDiv" name="cotpAccCurNameDiv">$!{fexTranReqPage.cotpAccEnglishCode}</div>
						</td>
					</tr>
					<tr>
						##账户名称
						<td class="textRight" width="15%">#springMessage('table.btBankAccApp.accName')</td>
						<td width="30%">$!{fexTranReqPage.corpAccName}</td>
						##交易对手地址
						<td class="textRight" width="15%">#springMessage('fex.cotp')#springMessage('table.externalCorp.address')</td>
						<td width="30%">$!{fexTranReqPage.cotpAdrr}</td>
					</tr>
					<tr>
						##账户类别
						<td class="textRight">#springMessage('table.btBankAcc.accType')</td>
						<td>$dictTag.get("btBankAcc.accType",$!{fexTranReqPage.accType})</td>
						##交易对手所在国家地区
						<td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpCountry')&#springMessage('fex.cotp.place')</td>
						<td width="30%">
							$!{fexTranReqPage.cotpCountryName}
							#if($!{fexTranReqPage.cotpCountryName} == "China")
								$!{fexTranReqPage.cotpProvName} $!{fexTranReqPage.cotpCityName}
							#else
								$!{fexTranReqPage.cotpAddressName}
							#end
						</td>
					</tr>
					<tr>
						##主体单位名称(英文)
						<td class="textRight" width="15%">#springMessage('table.fexTranReq.corpNameEn')</td>
						<td width="30%">$!{fexTranReqPage.corpNameEn}</td>
						##交易对手银行所在国家地区
						<td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpBankCountry')</td>
						<td width="30%">$!{fexTranReqPage.nameZh}</td>
					</tr>
					<tr>
						##主体单位地址(英文)
						<td class="textRight" width="15%">#springMessage('table.fexTranReq.corpAddrEn')</td>
						<td width="30%">$!{fexTranReqPage.corpAddrEn}</td>
						##交易对手银行Swift Code
						<td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpSwiftCode')</td>
						<td width="30%">$!{fexTranReqPage.cotpSwiftCode}</td>
					</tr>
					<tr>
						##主体单位地址(中文)
						<td class="textRight" width="15%">#springMessage('table.fexTranReq.corpAddr')</td>
						<td width="30%">$!{fexTranReqPage.corpAddr}</td>
						##本地清算号
						<td class="textRight">#springMessage('table.btswiftinfo.localClearNo')</td>
						<td>$!{fexTranReqPage.localClearNo}</td>
					</tr>
					<tr>
						##付款清算号
						<td class="textRight">#springMessage('table.fexTranReq.payerLocalClearNo')</td>
						<td>$!{fexTranReqPage.payerLocalClearNo}</td>
						##交易对手银行地址
						<td class="textRight" width="15%">#springMessage('table.fexTranReq.cotpBankAdrr')</td>
						<td width="30%">$!{fexTranReqPage.cotpBankAdrr}</td>
					</tr>
					<tr>
						##主体单位联系人
						<td class="textRight" width="15%">#springMessage('table.fexTranReq.corpContact')</td>
						<td width="30%">$!{fexTranReqPage.corpContact}</td>
						##交易对手代理行
						<td class="textRight" width="15%">#springMessage('fex.cotp')#springMessage('table.fexTranReq.agentBank')</td>
						<td width="30%">$!{fexTranReqPage.cotpAgentBank}</td>
					</tr>
					<tr>
						##主体单位电话
						<td class="textRight" width="15%">#springMessage('table.fexTranReq.corpContactTel')</td>
						<td width="30%">$!{fexTranReqPage.corpContactTel}</td>
						##交易对手代理行地址
						<td class="textRight" width="15%">#springMessage('table.fexTranReq.agentBankAddr')</td>
						<td width="30%">$!{fexTranReqPage.cotpAgentBankAddr}</td>
					</tr>
					<tr>
						##会计凭证号
						<td class="textRight" width="15%">#springMessage('table.nisBillhead.bursarBillNo')</td>
						<td>$!{fexTranReqPage.bursarBillNo}</td>
						##交易对手在代理行的账户
						<td class="textRight">#springMessage('table.fexTranReq.agentAcc')</td>
						<td width="30%">$!{fexTranReqPage.cotpAgentBankAcc}</td>
					</tr>
					<tr>
						##支付类型
						<td class="textRight" id="bankPayTypeTd">
							#if($!{bankType.isSetBankPayType} == "1" && $!{bankType.applayScopeBankPayType.indexOf("3")} != -1)#springMessage('table.nisBillhead.bankPayType')#end
						</td>
						<td width="30%">
							#if($!{bankType.isSetBankPayType} == "1" && $!{bankType.applayScopeBankPayType.indexOf("3")} != -1 && $!{bankPayType.customCode} && $!{bankPayType.customCode} != "")
								($!{bankPayType.customCode})$!{bankPayType.customName}
							#end
						</td>
						#if($!{bankType.isSetBnfRelate} == "1" && $!{bankType.applayScopeBnfRelate.indexOf("3")} != -1)
							##受益人关联关系
							<td class="textRight">#springMessage('table.fexForeignReq.bnfRelate')</td>
							<td>
								#if($!{bankType.isSetBnfRelate} == "1" && $!{bankType.applayScopeBnfRelate.indexOf("3")} != -1 && $!{bnfRelate.customCode} && $!{bnfRelate.customCode} != "")
									($!{bnfRelate.customCode})$!{bnfRelate.customName}
								#end
							</td>
						#else
							<td></td>
							<td></td>
						#end
					</tr>
##					<tr #if($!{fexTranReqPage.remitType} == "2") style="display: none" #end>
##						##加急标志
##						<td class="textRight">#springMessage('table.nisBillhead.isQuick')</td>
##						<td width="30%">$dictTag.get("sf_yn",$!{fexTranReqPage.isQuick})</td>
##						##被代收/代付单位
##						<td class="textRight">#springMessage('table.fexTranReq.payCorpId')</td>
##						<td>$!{fexTranReqPage.payCorpName}</td>
##					</tr>
					</tbody>
				</table>
				<div class="layui-collapse">
				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.rasBackQuery.msg')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##币种
								<td class="textRight" width="20%">#springMessage('table.bisAccDtl.curName')</td>
								<td width="30%">$!{fexTranReqPage.englishCode}</td>
								##金额
								<td class="textRight" width="20%">#springMessage('table.choBankFinance.payMoney')</td>
								<td width="30%">$!number.formatNumeric($!{fexTranReqPage.payMoney})</td>
							</tr>
							<tr id="contractRateTr" #if($!{fexTranReqPage.cdSign}=="0")style="display: none"
							#end>
								##合同汇率
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.contractRate')</td>
								<td>
									$!number.formatNumeric($!{fexTranReqPage.contractRate}, 6)
								</td>
								##汇率折算金额
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.payMoneyConvert')</td>
								<td>
									$!number.formatNumeric($!{fexTranReqPage.payMoneyConvert})
								</td>
							</tr>
							<tr>
								##外汇合同号
								<td class="textRight">#springMessage('table.fexForeignReq.foreignContractNo')</td>
								<td>$!{fexTranReqPage.foreignContractNo}</td>
								<td class="textRight"></td>
								<td></td>
							</tr>
							<tr>
								##交易日期
								<td class="textRight">#springMessage('table.revenue.transTime')</td>
								<td >$!date.format('yyyy-MM-dd',$!{fexTranReqPage.tranDate})</td>
								##结算日期
								<td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
								<td >$!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})</td>
							</tr>
							<tr>
								##汇款方式
								<td class="textRight">#springMessage('table.fexForeignReq.remitMethod')</td>
								<td>$dictTag.get("fexForeignReq.remitMethod",$!{fexTranReqPage.remitMethod})</td>
								##现金流项目
								<td class="textRight">#springMessage('finacial.common.cashFlow.item')</td>
								<td>$!{fexTranReqPage.cashItemName}</td>
							</tr>
							<tr>
								##汇款用途
								<td class="textRight">#springMessage('table.fexForeignReq.remitUse')</td>
								<td>$!{fexTranReqPage.remitUse}</td>
								##附言
								<td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
								<td>$!{fexTranReqPage.addWord}</td>
							</tr>
							<tr>
							<tr>
								##备注（英文）
								<td class="textRight" width="20%">#springMessage('bisAccAttribute.rmk')</td>
								<td colspan="3">$!{fexTranReqPage.rmk}</td>
							</tr>
							<tr>
								##备注（本地语言）
								<td class="textRight" width="20%">#springMessage('table.fexForeignReq.rmkLocal')</td>
								<td colspan="3">$!{fexTranReqPage.rmkLocal}</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>
				<div class="layui-colla-item">
					<h2 class="layui-colla-title">#springMessage('table.fexTranReq.costInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##国内外费用承担标志 1-汇款人 OUR  2-收款人 BEN  3-共同 SHA
								<td class="textRight" width="20%">#springMessage('table.fexForeignReq.costSign')</td>
								<td width="30%">$dictTag.get("fexForeignReq.costSign",$!{fexTranReqPage.costSign})</td>
								##费用支出账户
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.costAcc')</td>
								<td width="30%">$!{fexTranReqPage.costAcc}</td>
							</tr>
							<tr>
								##费用币种
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.costCurId')</td>
								<td width="30%">$!{currencyTag.getCurName($!{fexTranReqPage.costCurId})}</td>
								##费用总额
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.costMoney')</td>
								<td width="30%">$!number.formatNumeric($!{fexTranReqPage.costMoney})</td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>
				<div class="layui-colla-item" #if($!{fexTranReqPage.remitType} == "2") style="display: none" #end>
					<h2 class="layui-colla-title">#springMessage('fex.fexTranReqPay.reportInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##汇款去向
								<td class="textRight">#springMessage('table.fexForeignReq.remitRoute')</td>
								<td>$dictTag.get("fexForeignReq.remitRoute",$!{fexTranReqPage.remitRoute})</td>
								##最迟装运日期
								<td class="textRight" width="20%">#springMessage('table.fexForeignReq.shipDate')</td>
								<td width="30%">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.shipDate})</td>
							</tr>
							<tr>
								##是否为保税货物项下付款 0-否 1-是
								<td class="textRight">#springMessage('table.fexForeignReq.isBonded')</td>
								<td>$dictTag.get("sf_yn",$!{fexTranReqPage.isBonded})</td>
								##外汇局批件/备案表号/业务编号
								<td class="textRight">#springMessage('table.fexForeignReq.busNo')</td>
								<td>$!{fexTranReqPage.busNo}</td>
							</tr>
							#if($!{fexTranReqPage.corpBankName} == "兴业银行")
							<tr>
								##进口日期
								<td class="textRight">#springMessage('table.fexForeignReq.arrivalDate')</td>
								<td>$!date.format('yyyy-MM-dd',$!{fexTranReqPage.arrivalDate})</td>
								##报关单号
								<td class="textRight">#springMessage('table.fexForeignReq.declareNo')</td>
								<td>$!{fexTranReqPage.declareNo}</td>
							</tr>
							#end
							<tr>
								##合同号
								<td class="textRight">#springMessage('table.fexForeignReq.contractNo')</td>
								<td>$!{fexTranReqPage.contractNo}</td>
								##发票号
								<td class="textRight">#springMessage('table.fexForeignReq.invoiceNo')</td>
								<td>$!{fexTranReqPage.invoiceNo}</td>
							</tr>
							<tr>
								##交易编码1
								<td class="textRight">#springMessage('table.fexForeignReq.tranCode1')</td>
								<td>$!{fexTranReqPage.tranName1}</td>
								##交易编码2
								<td class="textRight">#springMessage('table.fexForeignReq.tranCode2')</td>
								<td>$!{fexTranReqPage.tranName2}</td>
							</tr>
							<tr>
								##相应金额1
								<td class="textRight">#springMessage('table.fexForeignReq.tranAmt1')</td>
								<td>$!number.formatNumeric($!{fexTranReqPage.tranAmt1})</td>
								##相应金额2
								<td class="textRight">#springMessage('table.fexForeignReq.tranAmt2')</td>
								<td>$!number.formatNumeric($!{fexTranReqPage.tranAmt2})</td>
							</tr>
							<tr>
								##相应币种1
								<td class="textRight">#springMessage('table.fexForeignReq.tranCurId1')</td>
								<td>$!{fexTranReqPage.tranEnglishCode1}</td>
								##相应币种2
								<td class="textRight">#springMessage('table.fexForeignReq.tranCurId2')</td>
								<td>$!{fexTranReqPage.tranEnglishCode2}</td>
							</tr>
							<tr>
								##交易附言1
								<td class="textRight">#springMessage('table.fexForeignReq.tranAddWord1')</td>
								<td>$!{fexTranReqPage.tranAddWord1}</td>
								##交易附言2
								<td class="textRight">#springMessage('table.fexForeignReq.tranAddWord2')</td>
								<td>$!{fexTranReqPage.tranAddWord2}</td>
							</tr>
							<tr>
								##交易员
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.dealer')</td>
								<td width="30%">$!{dealer}</td>
								##申请日期
								<td class="textRight" width="20%">#springMessage('table.bisFinanceExc.reqDate')</td>
								<td width="30%">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.createDate})</td>
							</tr>
							<tr>
								##交易地点
								<td class="textRight" width="20%">#springMessage('table.fexTranReq.tranAddr')</td>
								<td width="30%">$!{fexTranReqPage.tranAddr}</td>
								##交易组
								<td class="textRight">#springMessage('table.fexTranReq.tranGroup')</td>
								<td colspan="3">$!{fexTranReqPage.tranGroupName}</td>
							</tr>
							<tr id="originCountryTr" #if($!{fexTranReqPage.corpBankName} != "兴业银行")style="display: none"#end>
								##起运国
								<td class="text-right">#springMessage('table.fexForeignReq.originCountry')</td>
								<td>$!{fexTranReqPage.originCountryName}</td>
								<td></td>
								<td></td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>
				<div class="layui-colla-item" #if($!{bankType.isSetOtherCustom} != "1") style="display: none" #end>
					<h2 class="layui-colla-title">#springMessage('cms.loan.OtherInfo')</h2>
					<div class="layui-colla-content layui-show">
						<table class="layui-table">
							<tbody>
							<tr>
								##付款类型 1-预付货款 2-货到付款 3-退款 4-其他
								<td class="textRight" width="20%">
									#if($!{otherCustom.needField.indexOf("payType")} != -1)
										#springMessage('table.fexForeignReq.payType')
									#end
								</td>
								<td width="30%">
									#if($!{otherCustom.needField.indexOf("payType")} != -1)
										$dictTag.get("fexForeignReq.payType",$!{fexTranReqPage.payType})
									#end
								</td>
								##付汇性质 1-保税区 2-出口加工区 3-钻石交易所 4-其他特殊经济区域 5-深加工结转 6-离岸账户 7-其他
								<td class="textRight" width="20%">
									#if($!{otherCustom.needField.indexOf("remitNature")} != -1)
										#springMessage('table.fexForeignReq.remitNature')
									#end
								</td>
								<td width="30%">
									#if($!{otherCustom.needField.indexOf("remitNature")} != -1)
										$dictTag.get("fexForeignReq.remitNature",$!{fexTranReqPage.remitNature})
									#end
								</td>
							</tr>
							<tr>
								##监管类型
								<td class="textRight" width="20%">
									#if($!{otherCustom.needField.indexOf("regulatoryType")} != -1)
										#springMessage('table.fexForeignReq.regulatoryType')
									#end
								</td>
								<td width="30%">
									#if($!{otherCustom.needField.indexOf("regulatoryType")} != -1)
										$dictTag.get("fexForeignReq.regulatoryType",$!{fexTranReqPage.regulatoryType})
									#end
								</td>
								<td></td>
								<td></td>
							</tr>
							</tbody>
						</table>
					</div>
				</div>
				</div>
				<!-- 资金计划 -->
				<div id="tagItemDetail"></div>
				#if($!{isSplitOrMerge} == "1")
					<div class="noprint" style="overflow: auto">
						<table id="appTable" class="layui-table layui-form" style="width:100%;">
							<thead>
							<tr>
								<th>#springMessage('table.fexTranReq.billNo')</th>
								<th>#springMessage('table.fexTranReq.corpBank')</th>
								<th>#springMessage('table.fexTranReq.corpBankAcc')</th>
								<th>#springMessage('table.btBankAccApp.accName')</th>
								<th>#springMessage('table.bisAccDtl.curName')</th>
								<th>#springMessage('table.choBankFinance.payMoney')</th>
								<th>#springMessage('table.fexForeign.bankAcc')</th>
								<th>#springMessage('table.fexForeign.copt')</th>
								<th>#springMessage('table.revenue.transTime')</th>
								<th>#springMessage('common.table.thead.operation')</th>
							</tr>
							</thead>
							#foreach($data in $listMerge)
								<tr>
									<td align="center">$!{data.billNo}</td>
									<td>$!{data.corpBankName}</td>
									<td>$!{data.corpBankAcc}</td>
									<td>$!{data.corpAccName}</td>
									<td>$!{data.curName}</td>
									<td class="textRight">$!number.formatNumeric($!{data.payMoney})</td>
									<td>$!{data.cotpBankAcc}</td>
									<td>$!{data.cotpName}</td>
									<td align="center">$!date.format('yyyy-MM-dd',$!{data.tranDate})</td>
									<td><a class="" href="#" onclick="view('$!{data.id}')">#springMessage('common.button.view')</a></td>
								</tr>
							#end
						</table>
					</div>
				#end
				<!-- 附件上传 -->
				<input id="attachmentId" name="attachmentId" type="hidden" value="$!{fexTranReqPage.attachmentId}">
				<div id="uploader" class="layui-input-inline" style="width:100%"></div>
				<!-- 日志 -->
				<div id="tagMsg"></div>
			</form>
			</div>
			<div class="layui-form-item layui-form-submit" id="buttonDiv">
				<div class="layui-input-block">
					<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{fexTranReqPage.id}')">#springMessage('common.button.trackFlow')</button>
					<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
				</div>
			</div>
		</div>
		<div class="layui-tab-item">
			<table id="appTable" class="layui-table layui-form" style="width:100%;">
				<thead>
				<tr>
					#if($!{fexTranReqPage.status} == "95")
						<th>#springMessage('table.fexCashFlow.billNo')</th>
					#end
					<th>#springMessage('table.fexTranReq.cashFlowDate')</th>
					<th>#springMessage('table.fcSubjectDay.optDate')</th>
					<th>#springMessage('table.fexBankAcc.cashFlowType')</th>
					<th>#springMessage('finacial.common.cashFlow.item')</th>
					<th>#springMessage('table.bisAccDtl.curName')</th>
					<th>#springMessage('table.choBankFinance.payMoney')</th>
					<th>#springMessage('table.nisBillhead.corpId')</th>
					<th>#springMessage('common.button.bank')</th>
					<th>#springMessage('table.btBankAccApp.accName')</th>
					<th>#springMessage('table.foreign.bankAcc')</th>
					<th>#springMessage('fex.cotp')</th>
					<th>#springMessage('table.fexTranReq.cotpBank')</th>
					<th>#springMessage('table.fexTranReq.cotpAccName')</th>
					<th>#springMessage('table.fexForeign.cotpAcc')</th>
					<th>#springMessage('table.foreign.voucherType')</th>
				</tr>
				</thead>
				#if($!{fexTranReqPage.status} == "95")
					#foreach($data in $cashFlowList)
						<tr>
							<td align="center">$!{data.billNo}</td>
							<td align="center">$!date.format('yyyy-MM-dd',$!{data.cashFlowDate})</td>
							<td align="center">$!date.format('yyyy-MM-dd',$!{data.settleDate})</td>
							<td align="center">$dictTag.get("fexCorp.cashFlowType",$!{data.cashFlowType})</td>
							##现金流项目
							<td align="center">$!{data.cashItemName}</td>
							<td align="center">$!{data.englishCode}</td>
							<td align="right">
								#if($!{data.cdSign}=="1")
									-$!number.formatNumeric($!{data.payMoney})
								#else
									$!number.formatNumeric($!{data.payMoney})
								#end
							</td>
							<td align="center">$!{data.corpName}</td>
							<td align="center">$!{data.corpBankName}</td>
							<td align="center">$!{data.corpAccName}</td>
							<td align="center">$!{data.corpBankAcc}</td>
							<td align="center">$!{data.cotpName}</td>
							<td align="center">$!{data.cotpBankName}</td>
							<td align="center">$!{data.cotpAccName}</td>
							<td align="center">$!{data.cotpBankAcc}</td>
							<td align="center">$!{data.voucherTypeName}</td>
						</tr>
					#end
				#else
				<tr>
					##现金流日期
					<td align="center">$!{sysDate}</td>
					##结算日期
					<td align="center"><div id="srcSettleDateTd">$!date.format('yyyy-MM-dd',$!{fexTranReqPage.settleDate})</div></td>
					##现金流类型
					<td align="center"><div id="srcCashFlowTypeTd">$dictTag.get("fexCorp.cashFlowType","0")</div></td>
					##现金流项目
					<td align="center"><div id="srcCashItemTd">$!{fexTranReqPage.cashItemName}</div></td>
					##币种
					<td align="center"><div id="srcCurTd">$!{fexTranReqPage.englishCode}</div></td>
					##金额
					<td align="right">
						<div id="srcPayMoneyTd">
							#if($!{fexTranReqPage.cdSign}=="0")
								$!number.formatNumeric($!{fexTranReqPage.payMoney})
							#else
								-$!number.formatNumeric($!{fexTranReqPage.payMoney})
							#end
						</div>
					</td>
					##单位
					<td align="center"><div id="srcCorpTd">$!{fexTranReqPage.corpName}</div></td>
					##银行
					<td align="center"><div id="srcBankTd">$!{fexTranReqPage.corpBankName}</div></td>
					##账户名称
					<td align="center"><div id="srcAccNameTd">$!{fexTranReqPage.corpAccName}</div></td>
					##银行账户
					<td align="center"><div id="srcBankAccTd">$!{fexTranReqPage.corpBankAcc}</div></td>
					##交易对手
					<td align="center"><div id="srcCotpTd">$!{fexTranReqPage.cotpName}</div></td>
					##交易对手银行
					<td align="center"><div id="srcCotpBankTd">$!{fexTranReqPage.cotpBankName}</div></td>
					##交易对手账户名称
					<td align="center"><div id="srcCotpAccNameTd">$!{fexTranReqPage.cotpAccName}</div></td>
					##交易对手银行账户
					<td align="center"><div id="srcCotpBankAccTd">$!{fexTranReqPage.cotpBankAcc}</div></td>
					##支付方式
					<td align="center"><div id="srcPayTypeTd">$!{fexTranReqPage.voucherTypeName}</div></td>
				</tr>
			#end
			</table>
		</div>
		<div class="layui-tab-item">
			<!-- 自定义信息 -->
			<div id="custMsg"></div>
		</div>
	</div>
    #parse("views/common/footer.vm")
</body>
</html>

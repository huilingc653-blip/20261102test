<!DOCTYPE html>
<html lang="en">
<input type="hidden" id="caType"  value="12"/>
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<input id="eqi_tranType" name="eqi_tranType" type="hidden" value="$!{tranType}">
        <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
        <table class="layui-table">
            <tbody>
                <tr>
                    ##交易号码
                    <td class="textRight">#springMessage('table.fexTranReq.billNo')</td>
                    <td>
                        <input type="text" name="likes_billNo"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.billNo')">
                    </td>
                    ##产品
                    <td class="textRight">#springMessage('table.fexBankAcc.proId')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/listProduct/$!{tranType}" data-name ="eqs_proId" data-biz-name ="eqs_proId"
                             data-valueField="id" data-textField="proName"></div>
                    </td>
                    ##单位
                    <td class="textRight">#springMessage('table.fbsBudget.corpId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="ins_corpId"
                                 data-resource="foreign:fextranreq:option:query"
                                 data-scope="all"></div>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##外汇期权品种
                    <td class="textRight">#springMessage('table.fexProduct.fexOption')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="fexProduct.fexOption1" data-name="eqs_fexOption1"></div>
                    </td>
                    ##外汇期权类型
                    <td class="textRight">#springMessage('table.fexProduct.fexOptionType')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="fexProduct.fexOptionType" data-name="eqs_fexOptionType"></div>
                        </div>
                    </td>
                    ##申请日期
                    <td class="textRight">#springMessage('table.bisFinanceExc.reqDate')</td>
                    <td>
                        <input type="text" name="ged_createDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_createDate" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_createDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_createDate">
                    </td>
                </tr>
                <tr>
                    ##交易货币对
                    <td class="textRight">#springMessage('fex.tranApp.currencyPairs')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-selectType" data-biz-name="tranCurPairId"
                                 data-url="${basePath}/basic/business/btcurrencypair/json"
                                 data-valuefield="id" data-textfield="pairCode"
                                 data-name="tranCurPairId"
                                 data-callback="bt.currencyPairCallback"
                                 data-defaultvalue=""></div>
                        </div>
                    </td>
                    ##到期日期
                    <td class="textRight">#springMessage('table.bisFinanceExc.reqDate')</td>
                    <td>
                        <input type="text" name="ged_deadlineDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_deadlineDate" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_deadlineDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_deadlineDate">
                    </td>
                    ##                    ##买权币种
                    ##                    <td class="textRight">#springMessage('table.fexTranReq.buyCurIdOption')</td>
                    ##                    <td>
                    ##                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_buyCurId" data-biz-name ="eqs_buyCurId"
                    ##                             data-valueField="id" data-textField="englishCode"></div>
                    ##                    </td>
                    ##                    ##卖权币种
                    ##                    <td class="textRight">#springMessage('table.fexTranReq.sellCurIdOption')</td>
                    ##                    <td>
                    ##                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_sellCurId" data-biz-name ="eqs_sellCurId"
                    ##                             data-valueField="id" data-textField="englishCode"></div>
                    ##                    </td>
                    ##状态
                    <td class="textRight">#springMessage('table.choBankFinance.status')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="RECONCILIATION_STATUS" data-name="eqi_status"></div>
                    </td>

                </tr>
                <tr>
                    <!--交易对手-->
                    <td class="textRight">#springMessage('fex.tranApp.cotpBank')</td>
                    <td>
                        <input type="text" name="likes_cotpName" autocomplete="off" class="layui-input">
                    </td>
                    <!--买卖方向-->
                    <td class="textRight">#springMessage('fex.tranApp.busDirection')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="fex.tranApp.busDirection" data-name="eqi_busDirection"></div>
                    </td>
                    <!--涨跌方向-->
                    <td class="textRight">#springMessage('fex.tranApp2.upAndDownDirection')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="fex.tranApp2.updownDirection" data-name="eqi_updownDirection"></div>
                    </td>
                    ##                    ##单据来源
                    ##                    <td class="textRight">#springMessage('table.nisBillhead.billFrom')</td>
                    ##                    <td>
                    ##                        <div class="bt-biz-dict" data-type="select" data-displayData="0,1,2,4"
                    ##                             data-group="foreign.billFrom" data-name="eqs_billFrom"></div>
                    ##                    </td>
                </tr>
                <tr>
                    ##持仓金额
                    <td class="textRight">#springMessage('table.fexTranReq.positionMoney')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <input type="text" name="geg_positionMoney" id="geg_positionMoney" data-name="geg_positionMoney" data-minus="true" data-moneyendid="leg_positionMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.positionMoney')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" name="leg_positionMoney" id="leg_positionMoney" data-name="leg_positionMoney" data-minus="true"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fexTranReq.positionMoney')">
                        </div>
                    </td>
                    ##流水勾对状态
                    <td class="textRight">#springMessage('table.choBankFinance.flowClaim')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="fexTranReq.blendSign" data-name="eqs_blendSign"></div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.fexTranReq.billNo')</th>
            <th>#springMessage('table.fexBankAcc.proId')</th>
            <th>#springMessage('table.fbsBudget.corpId')</th>
            <th>#springMessage('table.btNetChalk.transTime')</th>
            <th>#springMessage('table.fcAcc.deadlineDate')</th>
            <th>#springMessage('table.fexTran.settleDate')</th>
            <th>#springMessage('table.fexTranReq.positionMoney')</th>
            <th>#springMessage('table.fexTran.executePrice')</th>
            <th>#springMessage('fex.tranApp.tranCurPair')</th>
            <th>#springMessage('fex.tranApp.busDirection')</th>
            <th>#springMessage('fex.tranApp.busDirection')</th>
            <th>#springMessage('table.fexProduct.deliveryType')</th>
            <th>#springMessage('table.fexProduct.fexOption')</th>
            <th>#springMessage('table.fexProduct.fexOptionType')</th>
            <th>#springMessage('fex.tranApp.cotpBank')</th>
            <th>#springMessage('table.bisFinanceExc.reqDate')</th>
            <th>#springMessage('table.choBankFinance.status')</th>
            <th>#springMessage('table.choBankFinance.flowClaim')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
    #paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
    #caDataHidden()
    #caDataScript()
    #paymentWorkFlowScript()
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexTranReqOption.listApprove.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/foreign/fexTranReq.listApprove.js?_btv=${resourceVersion}"></script>

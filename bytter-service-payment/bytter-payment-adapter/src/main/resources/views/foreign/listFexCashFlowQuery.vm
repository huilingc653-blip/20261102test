<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        .col-error{
            color: red;
        }
    </style>
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input id="opType" name="opType" type="hidden" value="query">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##现金流号码
                    <td class="textRight">#springMessage('table.fexCashFlow.billNo')</td>
                    <td>
                        <input type="text" name="likes_billNo"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexCashFlow.billNo')">
                    </td>
                    ##交易类型
                    <td class="textRight">#springMessage('ttpay.tradeType')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-name="eqs_tranType" data-displayData="7,8,9,2,3,4"
                                 data-group="fexCorp.tranType" data-callback="bt.changePro"></div>
                        </div>
                    </td>
                    ##单位
                    <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="ins_corpId"
                                 data-resource="foreign:fexcashflow:all:query"
                                 data-scope="all"></div>
                        </div>
                    </td>

                </tr>
                <tr>
                    ##状态
                    <td class="textRight">#springMessage('table.choBankFinance.status')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-filterData="-2"
                             data-group="choBankFinance.status" data-name="eqi_status"></div>
                    </td>
                    ##支付状态
                    <td class="textRight">#springMessage('table.fexCashFlow.payStatus')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="fexCashFlow.payStatusSearch" data-name="eqs_payStatusSearch"></div>
                    </td>
                    ##结算日期
                    <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
                    <td>
                        <input type="text" name="ged_settleDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_settleDate" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_settleDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_settleDate">
                    </td>


                </tr>
                <tr>
                    ##交易号码
                    <td class="textRight">#springMessage('table.fexTranReq.billNo')</td>
                    <td>
                        <input type="text" name="likes_tranBillNo"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexTranReq.billNo')">
                    </td>

                    ##交易对手
                    <td class="textRight">#springMessage('table.fexForeign.copt')</td>
                    <td>
                        #*<div class="layui-input-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/foreign/fexCotp/listBankCotp" data-name ="ins_cotpId" data-biz-name ="ins_cotpId"
                                 data-valueField="id" data-textField="cotpName" data-method="get"></div>
                        </div>*#
                        <input type="text" name="likes_cotpName"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeign.copt')">
                    </td>
                    ##币种
                    <td class="textRight">#springMessage('table.bisAccDtl.curName')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_curId" data-biz-name ="eqs_curId"
                             data-valueField="id" data-textField="englishCode"></div>
                    </td>

                </tr>
                <tr>
                    ##结算类型
                    <td class="textRight">#springMessage('fcVoucherType.settlType')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="fexCashFlow.settleType" data-name="eqs_settleType"></div>
                    </td>
                    ##支付方式
                    <td class="textRight">#springMessage('table.foreign.voucherType')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/netbank/fcvouchertype/getFcVoucherTypeForForeign" data-name ="eqs_voucherTypeId" data-biz-name ="eqs_voucherTypeId"
                             data-valueField="id" data-textField="voucherName"></div>
                    </td>
                    ##收付方向
                    <td class="textRight">#springMessage('table.foreign.cdSign')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="nisBusType.cdSign" data-name="eqs_cdSign"></div>
                    </td>

                </tr>
                <tr>
                    ##会计凭证号
                    <td class="textRight">#springMessage('table.nisBillhead.bursarBillNo')</td>
                    <td>
                        <input type="text" name="likes_bursarBillNo"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.bursarBillNo')">
                    </td>

                    ##金额
                    <td class="textRight">#springMessage('table.choBankFinance.payMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_payMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.choBankFinance.payMoney')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_payMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.choBankFinance.payMoney')">
                        </div>
                    </td>
                    ##产品
                    <td class="textRight">#springMessage('table.fexBankAcc.proId')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-selectType" data-biz-name="eqs_proId" data-type="select" data-url="${basePath}/foreign/fexproduct/listProduct/-1"
                                 data-name="eqs_proId" data-valueField="id" data-textField="proName"></div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="textRight">#springMessage('table.fexTranReq.isPayed')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-name="eqs_isPayed"></div>
                    </td>
                    ##单据来源
                    <td class="textRight">#springMessage('table.nisBillhead.billFrom')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-displayData="3,4"
                             data-group="foreign.billFrom" data-name="eqs_billFrom"></div>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
                #if($shiro.hasPermission("foreign:fexcashflow:all:query"))
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                        </td>
                    </tr>
                #end
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.fexCashFlow.billNo')</th>
            <th>#springMessage('table.fexTranReq.billNo')</th>
            <th>#springMessage('table.nisBillhead.bursarBillNo')</th>
            <th>#springMessage('fcVoucherType.settlType')</th>
            <th>#springMessage('table.fexBankAcc.proId')</th>
            <th>#springMessage('table.fexCashFlow.settleNo')</th>
            <th>#springMessage('table.fexTranReq.cashFlowDate')</th>
            <th>#springMessage('table.fcSubjectDay.optDate')</th>
            <th>#springMessage('table.fexBankAcc.cashFlowType')</th>
            <th>#springMessage('table.bisAccDtl.curName')</th>
            <th>#springMessage('table.foreign.cdSign')</th>
            <th>#springMessage('table.choBankFinance.payMoney')</th>
            <th>#springMessage('table.nisBillhead.corpId')</th>
            <th>#springMessage('common.button.bank')</th>
            <th>#springMessage('table.btBankAccApp.accName')</th>
            <th>#springMessage('table.foreign.bankAcc')</th>
            <th>#springMessage('fex.cotp')</th>
            <th>#springMessage('table.fexTranReq.cotpBank')</th>
            <th>#springMessage('table.fexTranReq.cotpAccName')</th>
            <th>#springMessage('table.fexForeign.cotpAcc')</th>
            <th>#springMessage('table.foreign.voucherType')</th>
            <th>#springMessage('table.fexTranReq.isPayed')</th>
            <th>#springMessage('table.choBankFinance.status')</th>
            <th>#springMessage('table.enterpriseLimit.landingResult')</th>
            <th>#springMessage('table.fexCashFlow.payStatus')</th>
            <th>#springMessage('table.nisBillhead.billFrom')</th>
            <th>#springMessage('table.fexCashFlow.relBillNo')</th>
            <th>#springMessage('table.choBankFinance.flowClaim')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexCashFlow.listQuery.js?_btv=${resourceVersion}"></script>

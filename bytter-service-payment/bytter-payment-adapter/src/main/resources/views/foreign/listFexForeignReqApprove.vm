<!DOCTYPE html>
<html lang="en">
<input type="hidden" id="caType"  value="12"/>
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}"/>
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
        <div class="layui-collapse" lay-filter="collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title"></h2>
                <div class="layui-colla-content layui-show">

            <table class="layui-table">
            <tbody>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                    <td>
                        <input type="hidden" id="corpIds" value="$!{corpIds}">
                        <div class="layui-input-inline">
                            <div class="demo-selectTree-normal"></div>
                        </div>
                    </td>
                    ##汇款单号
                    <td class="textRight">#springMessage('table.fexForeignReq.billNo')</td>
                    <td>
                        <input type="text" name="likes_billNo"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexForeignReq.billNo')">
                    </td>
                    ##汇款账号
                    <td class="textRight">#springMessage('table.fexForeignReq.payerAcc')</td>
                    <td>
                        <input type="text" name="likes_payerAcc"
                               autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.fexForeignReq.payerAcc')">
                    </td>
                </tr>
				<tr>
                    ##汇款币种
                    <td class="textRight">#springMessage('table.fexForeignReq.curId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
                        </div>
                    </td>
    				##银行类别
                    <td class="textRight">#springMessage('table.bisBifInit.bankType')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json" data-name ="eqs_bankTypeId" data-valueField="id" data-textField="typeName" ></div>
                        </div>
                    </td>
                    ##汇款类型
                    <td class="textRight">#springMessage('table.fexForeignReq.remitType')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="fexForeignReq.remitType" data-name="eqs_remitType"></div>
                    </td>
                </tr>
				<tr>
                    ##汇款金额
                    <td class="textRight">#springMessage('table.fexForeignReq.payMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_payMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.fexForeignReq.payMoney')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_payMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.fexForeignReq.payMoney')">
                        </div>
                    </td>
                    ##汇款日期
                    <td class="textRight">#springMessage('table.fexForeignReq.payDate')</td>
                    <td>
                        <input type="text" name="ged_payDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_payDate">
                        <span class="date-mid">~</span>
                        <input type="text" name="led_payDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_payDate">
                    </td>
                    ##状态
                    <td class="textRight">#springMessage('table.nisBillhead.status')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select"
                             data-group="nisBillhead.status" data-name="eqi_status" data-displayData="0,-1"></div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>

        </div>
        </div>
        </div>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.fexForeignReq.billNo')</th>
            <th>#springMessage('table.nisBillhead.corpId')</th>
            <th>#springMessage('table.fexForeignReq.payerAcc')</th>
            <th>#springMessage('table.fexForeignReq.payerAccName')</th>
            <th>#springMessage('table.fexForeignReq.payerBank')</th>
            <th>#springMessage('table.fexForeignReq.curId')</th>
            <th>#springMessage('table.fexForeignReq.payMoney')</th>
            <th>#springMessage('table.fexForeignReq.payDate')</th>
            <th>#springMessage('table.fexForeignReq.payeeAcc')</th>
            <th>#springMessage('table.fexForeignReq.payeeAccName')</th>
            <th>#springMessage('table.fexForeignReq.payeeSwiftCode')</th>
            <th>#springMessage('table.fexForeignReq.payeeBank')</th>
            <th>#springMessage('table.fexForeignReq.payeeCountryCode')</th>
            <th>#springMessage('table.fexForeignReq.addWordEn')</th>
            <th>#springMessage('table.fexForeignReq.remitType')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
    #paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
    #caDataHidden()
    #caDataScript()
    #paymentWorkFlowScript()
<script src="${basePath}/static/modules/foreign/fexForeignReqApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>
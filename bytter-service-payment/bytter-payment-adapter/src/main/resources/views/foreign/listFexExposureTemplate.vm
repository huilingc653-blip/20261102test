<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight" width="20%">#springMessage('table.fexExposureTemplate.templateCode')</td>
					<td width="30%">
                        <input type="text" name="likes_templateCode"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexExposureTemplate.templateCode')">
                    </td>
					<td class="textRight" width="20%">#springMessage('table.fexExposureTemplate.templateName')</td>
					<td width="30%">
                        <input type="text" name="likes_templateName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.fexExposureTemplate.templateName')">
                    </td>
                </tr>
                <tr>
                    <td class="textRight" width="20%">#springMessage('fcVoucherType.validSign')</td>
                    <td width="30%">
                        <div class="bt-biz-dict" data-type="select"
                             data-group="valid_sign" data-name="eqi_validSign"></div>
                    </td>
                    <td class="textRight" width="20%">#springMessage('common.table.createTime')</td>
                    <td width="30%">
                        <input type="text" name="ged_createDate" class="layui-input bt-input-inline bt-biz-dateType"
                               data-endid="led_createDate" value="">
                        <span class="date-mid">~</span>
                        <input type="text" name="led_createDate" class="layui-input bt-input-inline bt-biz-dateType"
                               id="led_createDate" value="">
                    </td>
                </tr>
    			<tr >
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.fexExposureTemplate.templateCode')</th>
            <th>#springMessage('table.fexExposureTemplate.templateName')</th>
            <th>#springMessage('table.fexExposureTemplate.totalFillPeriod')</th>
            <th>#springMessage('common.table.createTime')</th>
            <th>#springMessage('common.table.updateTime')</th>
            <th>#springMessage('fcVoucherType.validSign')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/foreign/fexExposureTemplate.list.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	<style>
		.timeType .layui-input {
			width: 100%;
		}
	</style>
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fexCorpExposureTemplatePage.id}">
		<input id="templateId" name="templateId" type="hidden" value="$!{fexCorpExposureTemplatePage.templateId}">
        <table class="layui-table">
			<tbody >
				<tr>
					##单位
					<td class="textRight" width="20%">#springMessage('table.nisBillhead.corpId')</td>
					<td width="30%">$!{fexCorpExposureTemplatePage.corpName}</td>
					##币种
					<td class="textRight" width="20%">#springMessage('table.nisBillhead.curId')</td>
					<td width="30%">$!{fexCorpExposureTemplatePage.englishCode}</td>
                </tr>
                <tr>
					##敞口模板
					<td class="textRight">#springMessage('table.fexExposureTemplate.templateInfo')</td>
					<td>$!{fexCorpExposureTemplatePage.templateName}</td>
					##有效标志 0 无效 1 有效
					<td class="textRight">#springMessage('fcVoucherType.validSign')</td>
					<td>$dictTag.get("valid_sign",$!{fexCorpExposureTemplatePage.validSign})</td>
                </tr>
            </tbody>
		</table>
		<!-- 敞口模板 -->
		<div id="tagTemplate"></div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
	bt.use(['form', 'layedit'], function () {
		var $ = bt.jquery, form = bt.form();
		/**
		 * 生成敞口模板信息
		 * @return
		 */
		$genTemplateHtml = function (templateId) {
			var url = basePath + "/foreign/fexExposureTemplate/viewCommon/" + templateId + "?timestamp=" + new Date().getTime();
			$.ajax({
				url: url,
				method: 'GET',
				async: false,
				success: function (json) {
					$("#tagTemplate").html("");
					$("#tagTemplate").html(json);
					form.render();
				}
			});
		}
		var templateId = $("#templateId").val();
		$genTemplateHtml(templateId);
	});
</script>
</html>

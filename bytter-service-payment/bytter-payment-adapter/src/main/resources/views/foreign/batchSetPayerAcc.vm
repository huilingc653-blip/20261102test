<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input id="id" name="id" type="hidden" value="">
        <input id="corpId" name="corpId" type="hidden" value="$!{corpId}">
		<input id="tranType" name="tranType" type="hidden" value="$!{tranType}">
		<table class="layui-table">
			<tbody>
				<tr>
					##主体单位银行
					<td class="textRight" width="40%">#springMessage('table.fexTranReq.corpBank')</td>
					<td width="60%">
						<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/listFilter" data-name ="corpBank" data-biz-name ="corpBank"
							 data-valueField="id" data-textField="typeName" data-required = "true" data-callback="bt.corpBankCallback"></div>
					</td>
				</tr>
				<tr>
					##主体单位银行账户
					<td class="textRight" width="40%">#springMessage('table.fexTranReq.corpBankAcc')</td>
					<td width="60%">
						<div class="layui-input-inline">
							<input type="hidden" id="payerCountryNameZh" name="payerCountryNameZh">
							<input type="hidden" id="payerCountryId" name="payerCountryId">
							<input type="text" id="corpBankAcc" name="corpBankAcc" lay-verify="required|tableData" data-biz-name="corpBankAcc" data-required = "true"
								   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fexTranReq.corpBankAcc')" data-callback="bt.corpBankAccCallback">
							<table id="corpBankAccTable" class="hide">
								<thead>
								<tr>
									<th>#springMessage('table.choBankFinance.acc')</th>
									<th>#springMessage('table.btBankAccApp.accName')</th>
									<th>#springMessage('table.btBankAcc.bankName')</th>
									<th>#springMessage('table.nisBillhead.curId')</th>
								</tr>
								</thead>
							</table>
						</div>
					</td>
				</tr>
                <tr>
					##账户类别
					<td class="textRight">#springMessage('table.btBankAcc.accType')</td>
					<td>
						<div id="accTypeDiv" name="accTypeDiv"></div>
						<input type="hidden" id="accType" name="accType" autocomplete="off" class="layui-input">
					</td>
                </tr>
				<tr>
					##账户名称
					<td class="textRight" width="40%">#springMessage('table.btBankAccApp.accName')</td>
					<td width="30%">
						<input type="hidden" id="corpAccId" name="corpAccId" value="">
						<input type="hidden" id="corpAccName" name="corpAccName" value="">
						<div id="corpAccNameDiv" name="corpAccNameDiv"></div>
					</td>
				</tr>
                <tr>
					##账户币种
					<td class="textRight" width="40%">#springMessage('table.fexForeign.cotpCurName')</td>
					<td width="30%">
						<input type="hidden" id="corpAccCurId" name="corpAccCurId" value="">
						<div id="corpAccCurNameDiv" name="corpAccCurNameDiv"></div>
					</td>
                </tr>
				<tr>
					##账户余额
					<td class="textRight">#springMessage('table.nisBillhead.balance')</td>
					<td>
						<div id="balanceDiv" name="balanceDiv"></div>
						<input type="hidden" id="balance" name="balance" style="text-align:right" readonly="readonly" data-name="balance" data-biz-name="balance"
							   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.nisBillhead.balance')">
					</td>
				</tr>
				<tr>
					<td colspan="2" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.confirm')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/foreign/fexTranReq.setPayerAcc.js?_btv=${resourceVersion}"></script>
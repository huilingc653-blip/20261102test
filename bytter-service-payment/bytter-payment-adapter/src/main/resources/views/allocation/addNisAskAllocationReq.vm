<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <input type="hidden" id="id" name="id">
    <input type="hidden" id="payeeAccId" name="payeeAccId">
    <input type="hidden" id="payerAccId" name="payerAccId">
    <input type="hidden" id="status" name="status">
    <input type="hidden" id="billNo" name="billNo">
    <input type="hidden" id="createBy" name="createBy" value="$!{createBy}">
    <input type="hidden" id="updateBy" name="updateBy" value="$!{createBy}">
    <input type="hidden" id="createDate" name="createDate" value="$!date.format('yyyy-MM-dd',$!{createDate})">
    <input type="hidden" id="updateDate" name="updateDate" value="$!date.format('yyyy-MM-dd',$!{createDate})">
    <input type="hidden" id="type" name="type" value="12">
    <input type="hidden" id="curId" name="curId">
    <input id="timeStamp" name="timeStamp" type="hidden" value="">
    <!-- 资金计划系统参数 -->
    <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
    <input id="askItem" name="askItem" type="hidden" value="$!{askItem}">
    <input id="isBudget" name="isBudget" type="hidden" value="">
    <!-- 设置同行和地域标志-->
    <input type="hidden" id="areaSign" name="areaSign">
    <input type="hidden" id="payerProvCity">
    <input type="hidden" id="payeeProvCity">
    <input type="hidden" id="payerBankCode">
    <input type="hidden" id="payeeBankCode">
    <input type="hidden" id="payerBankTypeId">
    <input type="hidden" id="payeeBankTypeId">
    <!-- 系统参数-->
    <input type="hidden" id="bankaccOver" name="bankaccOver" value="$!{bankaccOver}">
    <input type="hidden" id="accountOver" name="accountOver" value="$!{accountOver}">
    <input type="hidden" id="isAccount" name="isAccount" value="$!{isAccount}">
    <input type="hidden" id="isAutoAccount" name="isAutoAccount" value="$!{isAutoAccount}">
    <input id="isOpenLimit" name="isOpenLimit" type="hidden" value="$!{isOpenLimit}">
    <!--余额-->
    <input type="hidden" id="balance" name="balance">
    <input type="hidden" id="fcAccBalance" name="fcAccBalance">
    <!-- 新增默认 -->
    <input type="hidden" id="billFrom" name="billFrom"  value="1">

    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            <td rowspan="4" width="10">
                <div>#springMessage('table.nisAllocationReq.payeeInfo')</div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
            <td>
            ##付款人单位
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-biz-name="corpId"
                         data-scope="all"
                         data-required="true"
                         data-resource="netbank:allocation:typeAsk:apply"
                         data-callback="corpCallback"></div>
                </div>
            </td>
            <td rowspan="4" width="10">#springMessage('table.nisAllocationReq.payerInfo')</td>
            <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
            <td>
            ##收款人单位
                <input type="text" id="payerCorpId" name="payerCorpId" lay-verify="required" readonly="readonly"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.nisAllocationReq.corp')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.acc')</td>
            <td>
            ##收款人账号
                <div class="layui-input-inline">
                    <input type="text" id="payeeAcc" name="payeeAcc" data-name="payeeAcc" data-biz-name="payeeAcc" lay-verify="required" accountType="2,3"
                           class="layui-input bt-biz-accountTable" data-callback="accountCallBack" data-resource="netbank:allocation:typeAsk:apply"
                           excludeBankTypeCode = "8500" excludeAccTypeCode = "04"
                           url="${basePath}/bankacc/btbankacc/getListBy"  containParent="true"/>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.acc')</td>
            <td>
            ##付款人账号
                <input type="text" id="payerAcc" name="payerAcc" lay-verify="required" readonly="readonly"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.nisAllocationReq.payerAcc')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
            <td>
            ##付款人开户行
                <input type="hidden" id="payeeBankCode">
                <input type="text" id="payeeBankName" name="payeeBankName" readonly="readonly"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.nisAllocationReq.payeeBankName')">
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
            <td>
            ##收款人开户行
                <input type="hidden" id="payerBankCode">
                <input type="text" id="payerBankName" name="payerBankName" readonly="readonly"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.nisAllocationReq.payerBankName')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.accName')</td>
            <td>
            ##付款人户名
                <input type="text" id="payeeAccName" name="payeeAccName" readonly="readonly"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.nisAllocationReq.payeeAccName')">
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.accName')</td>
            <td>
            ##收款人户名
                <input type="text" id="payerAccName" name="payerAccName" readonly="readonly"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.nisAllocationReq.payerAccName')">
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">账户可用余额</td>
            <td>
                <div id="availBalDiv"></div>
            </td>
            <td class="textRight" colspan="2"></td>
            <td></td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.curId')</td>
            <td>
            ##币别
                <input type="text" id="curName" name="curName" readonly="readonly"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.nisAllocationReq.curId')">
            </td>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.purpose')</td>
            <td>
            ##用途
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btpurpose?getByListSort&sysBusType=1&busDtl=2"
                         data-valuefield="purpose" data-textfield="purpose" data-name="purpose" data-biz-name="purpose"
                         data-inputvalue="inputvalue" data-search="true" data-required="true" data-value="" data-beforeInitResiveData="purposeBefore"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.money.lower')</td>
            <td>
            ##金额（小写）
                <input type="text" data-name="money" data-biz-name="money" lay-verify="required|number2"
                       class="layui-input bt-biz-moneyType" style="text-align:right" data-toUp="moneyUp"
                       autocomplete="off" placeholder="#springMessage('table.nisAllocationReq.money.lower')">
            </td>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.money.upper')</td>
            <td style="padding-left:0px">
                <div id="moneyUp"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.wishPayday')</td>
            <td>
            ##期望支付日期
                <div class="layui-input-inline">
                    <input type="text" name="wishPayday" class="layui-input bt-biz-dateType" data-type="date"
                           data-biz-name="wishPayday" data-min="$!date.format('yyyy-MM-dd',$!{date.getDate()})"
                           data-today="true" lay-verify="required|date" data-callback="dateCallBack">
                </div>
            </td>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.isQuick')</td>
            <td>
            ##是否加急
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isQuick"
                     data-biz-name="isQuick" data-required="true"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.difBank')</td>
            <td>
            ##是否同行
                <div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.difBank" data-defaultvalue="0"
                     data-name="difBank" data-biz-name="difBank"></div>
            </td>
            <td class="textRight" colspan="2"></td>
            <td>
            </td>
        </tr>
        <tr>
            ##备注说明
            <td class="textRight" colspan="2">备注说明</td>
            <td width="80%" colspan="5">
                <div class="layui-input-inline">
                    <textarea lay-verify="strlength" class="layui-textarea" name="rmk" id='rmk' autocomplete="off" placeholder="备注说明"  style="resize:none" cols="140" rows="2" data-maxlength="150"></textarea>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <!-- 收方内部账户信息 -->
    <table id="appTable" class="layui-table layui-form layui-table-border" style="width:100%;" data-btns="print">
        <thead>
        <tr>
            <th>
                #if($!{isAccount} == 1) <span class="pl"><span class="required-icon">*</span></span> #end
                #springMessage('fcAccBalanceQuery.account')
            </th>
            <th>#springMessage('fcAccBalanceQuery.accName')</th>
            <th>#springMessage('fcAccBalanceQuery.subjectId')</th>
            <th>#springMessage('fcAccBalanceQuery.curId')</th>
            <th>当前留存余额</th>
            <th>留存可用余额</th>
            <th>#springMessage('fcAccBalanceQuery.overdraftMoney')</th>
            <th>#springMessage('fcAccBalanceQuery.accOpenTime')</th>
            <th>#springMessage('fcAccBalanceQuery.deadlineDate')</th>
            <th>#springMessage('fcAccBalanceQuery.interestRate')</th>
        </tr>
        </thead>
        <tr>
            <td>
                <div class="layui-input-inline">
                    #if($!{payeeCounterAcc.account} == "--")
                        <input type="text" id="payeeCounterAcc" name="payeeCounterAcc" style="height: 20px" readonly="readonly"
                            #if($!{isAccount} == 1) lay-verify="required" #end>
                    #else
                        <input type="text" id="payeeCounterAcc" name="payeeCounterAcc" style="height: 20px" readonly="readonly" value="$!{payeeCounterAcc.account}"
                            #if($!{isAccount} == 1) lay-verify="required" #end>
                    #end
                    <div class="bt-div-search">
                        <button class="bt-biz-accountInfo" id="selAccountBut" type="button"
                                data-callback="bt.accountInfoCallback"
                                data-beforeClick="bt.accountInfoParams">
                            <span class="iconfont byicon_box_search"></span>
                        </button>
                    </div>
                </div>
            </td>
            <td><span id="payeeCounterAccName">$!{payeeCounterAcc.accName}</span></td>
            <td><span id="subjectName">$!{payeeCounterAcc.subjectName}</span></td>
            <td><span id="payeeCounterCurName">$!{payeeCounterAcc.curName}</span></td>
            <td class="textRight"><span id="checkBalance">$!number.formatNumeric($!{payeeCounterAcc.checkBalance})</span></td>
            <td class="textRight"><span id="availableBalance">$!number.formatNumeric($!{payeeCounterAcc.availableBalance})</span></td>
            <td class="textRight"><span id="overdraftMoney">$!number.formatNumeric($!{payeeCounterAcc.overdraftMoney})</span></td>
            <td><span id="accOpenTime">$!date.format('yyyy-MM-dd',$!{payeeCounterAcc.accOpenTime})</span></td>
            <td><span id="deadlineDate">$!date.format('yyyy-MM-dd',$!{payeeCounterAcc.deadlineDate})</span></td>
            <td class="textRight"><span id="interestRate">$!rateTag.show($!{payeeCounterAcc.interestRate})</span></td>
        </tr>
    </table>
    <!-- 资金计划 -->
    <div id="tagItemDetail"></div>
    <!-- 附件上传 -->
    <input id="attachmentId" name="attachmentId" type="hidden">
    <div id="uploader" class="layui-input-inline" style="width:100%"></div>
	#caDataHidden()
</form>
    #parse("views/common/footer.vm")
	#caDataScript()
</body>
<script src="${basePath}/static/modules/allocation/nisAllocationReq.common.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/allocation/nisAskAllocationReq.add.js?_btv=${resourceVersion}"></script>
</html>

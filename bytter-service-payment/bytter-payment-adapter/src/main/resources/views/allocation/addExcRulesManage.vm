<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form ignore-required-icon" method="post">
		<input id="id" name="id" type="hidden" value="$!{excRluesManage.id}">
		<input id="createBy" name="createBy" type="hidden" value="$!{excRluesManage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{excRluesManage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{excRluesManage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{excRluesManage.updateDate}">
		<input id="payeeAccId" name="payeeAccId" type="hidden" value=""/>
		<input id="curpId" name="curpId" type="hidden" value=""/>
		<input id="filterCode" name="filterCode" type="hidden" value="$!{filterCode}"/>
        <table class="layui-table">
        	<tr>
        		##规则名称
				<td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.excRulesManage.ruleName')</td>
				<td width="40%">
                    <input type="text" id="filterName" name="filterName" lay-verify="required" readonly="readonly"
    					autocomplete="off" class="layui-input" value="#springMessage('table.excRulesManage.filterName')">
				</td>
				##单位
				<td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fbsBudgetProcess.corpId')</td>
				<td width="40%">
					 <div class="layui-input-inline">
						<div class="bt-biz-corp"
						data-biz-type="corp"
						data-type="selectTree"
						data-name="corpId"
						data-scope="all"
						data-required="true"
						data-resource="netbank:allocation:excRulesManage:apply"
						data-callback="bt.corpCallback"></div>
					</div>
				</td>				
        	</tr>
			<tr>
				##收款账号
				<td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fbsBudgetDetail.payeeAcc')</td>
				<td >
					<div class="layui-input-inline">
						<input type="text" id="payeeAccNo" name="payeeAccNo" data-biz-name="payeeAccNo" lay-verify="required|tableData" data-link="balanceDiv"
							 autocomplete="off" class="layui-input text bank" placeholder="#springMessage('table.fbsBudgetDetail.payeeAcc')">
						<table id="payeeAccTable" class="hide">
							<thead>
								<tr>
									<th>#springMessage('table.choBankFinance.acc')</th>
									<th>#springMessage('table.choBankFinance.accName')</th>
									<th>#springMessage('table.choBankFinance.accBank')</th>
									<th>#springMessage('table.choBankFinance.curId')</th>
								</tr>
							</thead>
						</table>
					</div>
				</td>
				##有效标识
			      	<td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.bisGatherPolicy.validSign')</td>
				<td >
					<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="validSign" data-biz-name="validSign"></div>
				</td>
        	</tr>
			##付款账号
			<table id="printMRTable" class="layui-table">
			<thead>
				<tr colspan="6" style="text-align: center;">
					<th style="text-align: center;">#springMessage('table.fbsBudgetDetail.payerAcc')<span style="color:red">*</span></th>
					<th style="text-align: center;">#springMessage('table.createRepayPlan.operation')</th>
				</tr>
			</thead>
			  <tbody >
				<tr colspan="6" style="text-align: center;">
					<td ><input type="text" name="payerAccNos[0].payerAccNo" class="layui-input bank" data-maxlength="32" lay-verify="required|number|strlength" /></td>
                    <td></td>
				</tr>
              </tbody>
            </table>
			<div class="layui-form-item" style="text-align: center;">
				<div class="layui-input-block">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    <button type="button" class="layui-btn" id="addBookTr" >#springMessage('common.addTr')</button>
				</div>
			</div>
				
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/excRulesManage.add.js?_btv=${resourceVersion}"></script>
</html>
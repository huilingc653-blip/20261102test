	#elseif($nisAllocationReqPage.type eq '12')
		#if($!{askAllowEditMoney} eq '1')
			#parse("views/allocation/approveUpdateNisAskAllocationReq.vm")
		#else
			#parse("views/allocation/viewNisAskAllocationReq.vm")
		#end
	#elseif($nisAllocationReqPage.type eq '13')

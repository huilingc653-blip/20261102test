<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##规则名称
                    <td class="textRight">#springMessage('table.excRulesManage.ruleName')</td>
                    <td>
                        <input type="text" name="likes_filterName" readonly="readonly" id="filterName"
                            autocomplete="off" class="layui-input" value="#springMessage('table.excRulesManage.filterName')">
                    </td>
                    ##单位
                    <td class="textRight">#springMessage('table.fbsBudgetProcess.corpId')</td>
                      <td>
                    <div class="layui-inline">
                    	<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-name="likes_corpId"
                            data-scope="all"
							data-resource="netbank:allocation:excRulesManage:apply"
							data-callback="bt.corpCallback"></div>
                    </div>
                </td>
					##付款账号
                    <td class="textRight">#springMessage('table.fbsBudgetDetail.payerAcc')</td>
                    <td>
						  <input type="text" name="likes_payerAccNo" id="payerAccNo" autocomplete="off" class="layui-input bank" >
                    </td>
				</tr>
                <tr>
                    ##收款账号
                    <td class="textRight">#springMessage('table.fbsBudgetDetail.payeeAcc')</td>
                    <td >
						  <input type="text" name="likes_payeeAccNo" id="payeeAccNo" autocomplete="off" class="layui-input bank" >
                    </td>
					##有效标志
					<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.valid')</td>
                    <td >
						<div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-name="eqs_validSign"></div>
                    </td>
					<td colspan="2"></td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.excRulesManage.ruleName')</th>
        <th>#springMessage('table.excRulesManage.corpCode')</th>
		<th>#springMessage('table.nisPersonnelDetail.corpId')</th>
        <th>#springMessage('table.fbsBudgetDetail.payeeAcc')</th>
        <th>#springMessage('table.fbsBudgetDetail.payerAcc')</th>
        <th>#springMessage('finacial.paramConfig.fcSubject.valid')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/excRulesManage.list.js?_btv=${resourceVersion}"></script>
</html>

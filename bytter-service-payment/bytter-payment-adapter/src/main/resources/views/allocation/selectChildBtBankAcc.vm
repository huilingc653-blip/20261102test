<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form id="searchForm" class="layui-form">
		<input type="hidden" id="gatherPolicyId" name="gatherPolicyId" value="$!{gatherPolicyId}"/>
		<input type="hidden" id="prentAccId" name="eqs_prentAccId" value="$!{prentAccId}"/>
		<input type="hidden" id="parentSign" name="eqs_parentSign" value="$!{parentSign}"/>
        <input type="hidden" id="gatherType" name="gatherType" value="$!{gatherType}"/>
		<input type="hidden" id="curId" name="eqs_curId" value="$!{curId}"/>
		<table class="layui-table">
			<tbody>
				<tr>
                    <td align="right">#springMessage('table.btBankAcc.bankAcc')</td>
                    <td align="left">
                        <input  type="text" id="likes_bankAcc" name="likes_bankAcc" value="$!{btBankAcc.bankAcc}" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankAcc')"/>
                    </td>
                	<td class="textRight" align="right">#springMessage('table.btBankAccApp.bankTypeId')</td>
                    <td align="left">
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json"
                             data-name ="eqs_bankTypeId" data-biz-name ="eqs_bankTypeId"  data-valueField="id" data-textField="typeName" data-defaultvalue="$!{btBankAcc.bankTypeId}" ></div>
                    </td>
                </tr>
                <tr>
                	<td class="textRight" align="right">#springMessage('table.btBankAcc.attributeId')</td>
                    <td align="left">
                        <div class="bt-biz-selectType" data-url="${basePath}/bankacc/bisaccattribute/json" data-valuefield="id" data-textfield="attributeName" data-defaultvalue="$!{btBankAcc.attributeId}"
                             data-name="eqs_attributeId" data-inputvalue="inputvalue" data-search="true"></div>
                    </td>
                    <td align="right">#springMessage('table.btBankAcc.accName')</td>
                    <td align="left">
                        <input  type="text" id="likes_bankAcc" name="likes_accName" class="layui-input" placeholder="#springMessage('table.btBankAcc.accName')"/>
                    </td>
                </tr>
                <tr>
                	<td align="center" colspan="4">
                        <button class="layui-btn" lay-submit lay-filter="search" id="send">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
    		</tbody>
    	</table>
	</form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.btBankAcc.bankAcc')</th>
                <th>#springMessage('table.btBankAcc.accName')</th>
                <th>#springMessage('table.btBankAccCur.cur')</th>
                <th>#springMessage('table.btBankAcc.bankName')</th>
                <th>#springMessage('table.btBankAcc.corpId')</th>
                <th>#springMessage('table.btBankAcc.attributeId')</th>
                <th>#springMessage('table.btBankAcc.bifName')</th>
                <th>#springMessage('table.btBankAcc.natureId')</th>
    		</tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/selectChildBtBankAcc.list.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        .col-error{
            color: red;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="viewType" value="fund">
    <input type="hidden" name="eqs_erpId" value="$!{erpId}">
    <input id="loginName" name="loginName" type="hidden" value="$shiro.getPrincipal().loginName">
    <input id="isOpenLimit" name="isOpenLimit" type="hidden" value="$!{isOpenLimit}">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位
            <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="likes_corpId"
                         data-resource="netbank:allocation:typeFund:query"
                         data-scope="all"
                         data-callback="bt.corpCallback"></div>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.nisAllocationReq.billNo')</td>
            <td width="20%">
                <input type="text" class="layui-input" name="likes_billNo" autocomplete="off" placeholder="#springMessage('table.nisAllocationReq.billNo')">
            </td>
            <td class="textRight" width="10%">#springMessage('table.nisAllocationReq.wishPayday')</td>
            <td width="30%">
                <div class="layui-inline">
                    <input type="text" name="ged_wishPayday" class="layui-input bt-input-inline bt-biz-dateType"
                           data-endid="led_wishPayday">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_wishPayday" class="layui-input bt-input-inline bt-biz-dateType"
                           id="led_wishPayday">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.payerAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="likes_payerAcc" name="likes_payerAcc" data-name="likes_payerAcc"data-biz-name="likes_payerAcc"
                           data-resource="netbank:allocation:typeFund:query"  class="layui-input bt-biz-accountTable" data-callback="accountPayerCallBack"/>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.payeeAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="likes_payeeAcc" name="likes_payeeAcc" data-name="likes_payeeAcc" data-biz-name="likes_payeeAcc" accountType="2,3" url="${basePath}/bankacc/btbankacc/getListBy"
                           data-resource="netbank:allocation:typeFund:query"  class="layui-input bt-biz-accountTable" data-callback="accountPayeeCallBack"/>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.money')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_money" class="layui-input bt-biz-moneyType textRight"
                           data-moneyendid="leg_money" autocomplete="off" placeholder="#springMessage('table.nisAllocationReq.money')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" id="leg_money" data-name="leg_money" class="layui-input bt-biz-moneyType textRight"
                           autocomplete="off" placeholder="#springMessage('table.nisAllocationReq.money')">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.curId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="netbank.statusAll" data-name="eqi_status" data-filterData="-2"></div>
            </td>
            ##交易状态
            <td class="textRight">#springMessage('table.bisExc.voucherStat')</td>
            <td>
				<div class="bt-biz-dict" data-type="select" data-group="bisExc.voucherStat" data-name="eqs_voucherStat" data-filterData="w,R,p"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight" width="10%">#springMessage('table.nisAllocationReq.type')</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="select" data-group="nisAllocationReq.type" data-name="eqi_type"
                     data-defaultvalue="$!{queryType}"
                    ></div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.createBy')</td>
            <td>
                <input type="text" class="layui-input" name="likes_createByName" autocomplete="off" placeholder="#springMessage('table.nisAllocationReq.createBy')">
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.createDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="ged_createDate" class="layui-input bt-input-inline bt-biz-dateType"
                           data-endid="led_createDate">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_createDate" class="layui-input bt-input-inline bt-biz-dateType"
                           id="led_createDate">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.billFrom')</td>
            <td>
                <div class="bt-biz-dict" data-type="select"  data-group="nisAllocationReq.billFrom" data-name="eqs_billFrom"
                     data-defaultvalue="$!{billFrom}"
                    ></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr class="title">
        <th rowspan="2">#springMessage('table.nisAllocationReq.billNo')</th>
        <th rowspan="2">#springMessage('table.nisAllocationReq.type')</th>
        <th colspan="4">#springMessage('table.nisAllocationReq.payerAcc')</th>
        <th colspan="4">#springMessage('table.nisAllocationReq.payeeAcc')</th>
        <th rowspan="2">#springMessage('table.nisAllocationReq.curId')</th>
        <th rowspan="2">#springMessage('table.nisAllocationReq.wishPayday')</th>
        <th rowspan="2">#springMessage('table.nisAllocationReq.purpose')</th>
        <th rowspan="2">#springMessage('table.nisAllocationReq.money')</th>
        <th rowspan="2">#springMessage('table.nisAllocationReq.createBy')</th>
        <th rowspan="2">#springMessage('table.nisAllocationReq.createDate')</th>
        <th rowspan="2">#springMessage('table.nisAllocationReq.status')</th>
		<th rowspan="2">#springMessage('table.bisExc.voucherStat')</th>
        <th rowspan="2">#springMessage('table.nisAllocationReq.billFrom')</th>
        <th rowspan="2">#springMessage('common.table.thead.operation')</th>
    </tr>
    <tr class="title">
        <th>#springMessage('table.nisAllocationReq.acc')</th>
        <th>#springMessage('table.nisAllocationReq.corp')</th>
        <th>#springMessage('table.nisAllocationReq.accName')</th>
        <th>#springMessage('table.nisAllocationReq.bankName')</th>
        <th>#springMessage('table.nisAllocationReq.acc')</th>
        <th>#springMessage('table.nisAllocationReq.corp')</th>
        <th>#springMessage('table.nisAllocationReq.accName')</th>
        <th style="border-right: none;">#springMessage('table.nisAllocationReq.bankName')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/nisFundAllocationReq.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="eqi_type" value="12">
    <input type="hidden" name="ini_status" value="-1,0">
    <input id="isOpenLimit" name="isOpenLimit" type="hidden" value="$!{isOpenLimit}">
    <input type="hidden" id="bankaccOver" name="bankaccOver" value="$!{bankaccOver}">
    <input type="hidden" id="accountOver" name="accountOver" value="$!{accountOver}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
            <td width="40%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-name="eqs_corpId" data-biz-type="corp" data-type="selectTree"
                         data-resource="netbank:allocation:typeAsk:query" data-callback="corpCallback"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.payeeAcc')</td>
            <td width="40%">
                <div class="layui-input-inline">
                    <input type="text" id="likes_payeeAcc" name="likes_payeeAcc" data-name="likes_payeeAcc" data-biz-name="likes_payeeAcc" accountType="2,3" url="${basePath}/bankacc/btbankacc/getListBy"
                           data-resource="netbank:allocation:typeAsk:query"  class="layui-input bt-biz-accountTable" data-callback="accountCallBack"/>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.money')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_money" class="layui-input bt-biz-moneyType textRight"
                           data-moneyendid="tleg_money20" autocomplete="off" placeholder="#springMessage('table.nisAllocationReq.money')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" id="leg_money" data-name="leg_money" class="layui-input bt-biz-moneyType textRight"
                           autocomplete="off" placeholder="#springMessage('table.nisAllocationReq.money')">
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="netbank.status" data-name="eqi_status"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisAllocationReq.billNo')</th>
        <th>#springMessage('table.nisAllocationReq.payeeAcc')</th>
        <th>#springMessage('table.nisAllocationReq.accName')</th>
        <th>#springMessage('table.nisAllocationReq.bankName')</th>
        <th>#springMessage('table.nisAllocationReq.curId')</th>
        <th>#springMessage('table.nisAllocationReq.wishPayday')</th>
        <th>#springMessage('table.nisAllocationReq.purpose')</th>
        <th>#springMessage('table.nisAllocationReq.ask.money')</th>
        <th>#springMessage('table.nisAllocationReq.createBy')</th>
        <th>#springMessage('table.nisAllocationReq.createDate')</th>
        <th>#springMessage('table.nisAllocationReq.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
</body>
    #parse("views/common/footer.vm")
    #caDataHidden()
    #caDataScript()
<script src="${basePath}/static/modules/allocation/nisAskAllocationReq.list.js?_btv=${resourceVersion}"></script>
</html>

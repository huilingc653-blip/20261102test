<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <input type="hidden" id="id" name="id" value="$!{nisAllocationReqPage.id}">
        <input type="hidden" id="payeeAccId" name="payeeAccId" value="$!{nisAllocationReqPage.payeeAccId}">
        <input type="hidden" id="payerAccId" name="payerAccId" value="$!{nisAllocationReqPage.payerAccId}">
        <input type="hidden" id="status" name="status" value="$!{nisAllocationReqPage.status}">
        <input type="hidden" id="createBy" name="createBy" value="$!{nisAllocationReqPage.createBy}">
        <input type="hidden" id="updateBy" name="updateBy" value="$!{nisAllocationReqPage.updateBy}">
        <input type="hidden" id="updateDate" name="updateDate" value="$!{nisAllocationReqPage.updateDate}">
        <input type="hidden" id="type" name="type" value="$!{nisAllocationReqPage.type}">
        <input type="hidden" id="corpId" name="corpId" value="$!{nisAllocationReqPage.corpId}">
        <input type="hidden" id="money" name="money" value="$!{nisAllocationReqPage.money}">
        <input type="hidden" id="curId" name="curId" value="$!{nisAllocationReqPage.curId}">
        <input id="busType" name="busType" type="hidden" value="$!{busType}">
        <div id="print">
            <table class="layui-table layui-table-border">
                <tbody>
                    <tr>
                        <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.billNo')</td>
                        <td width="35%">
                            $!{nisAllocationReqPage.billNo}
                        </td>
                        <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.createDate')</td>
                        <td width="35%">
                           $!date.format('yyyy-MM-dd', $!{nisAllocationReqPage.createDate})
                        </td>
                    </tr>
                    <tr>
                        <td rowspan="7" width="10" style="padding: 0;">
                            <div style="height: 100%;width: 100%;display:table;">
                                <div style="display:table-cell; vertical-align:middle;padding: 0 4px">
                            #springMessage('table.nisAllocationReq.payerInfo')
                                </div>
                            </div>
                        </td>
                        <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
                        <td>
                            ##付款人单位
                            $!{nisAllocationReqPage.corpName}
                        </td>
                        <td rowspan="7" width="10" style="padding: 0;">
                            <div style="height: 100%;width: 100%;display:table;">
                                <div style="display:table-cell; vertical-align:middle;padding: 0 4px">
                                    #springMessage('table.nisAllocationReq.payeeInfo')
                                </div>
                            </div>
                        </td>
                        <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
                        <td>
                            ##收款人单位
                            $!{nisAllocationReqPage.corpName}
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('table.nisAllocationReq.acc')</td>
                        <td>
                            ##付款人账号
                            $!{nisAllocationReqPage.payerAcc}
                        </td>
                        <td class="textRight">#springMessage('table.nisAllocationReq.acc')</td>
                        <td>
                            ##收款人账号
                            $!{nisAllocationReqPage.payeeAcc}
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('table.nisAllocationReq.accBalance')</td>
                        <td>
                            ##付款人账户余额
                            $!number.formatNumeric($!{nisAllocationReqPage.payerAccBalance})
                        </td>
                        <td class="textRight">#springMessage('table.nisAllocationReq.accBalance')</td>
                        <td>
                            ##收款人账户余额
                            $!number.formatNumeric($!{nisAllocationReqPage.payeeAccBalance})
                            <div id="payeeAccBalance"></div>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('table.nisAllocationReq.fcAccBalance')</td>
                        <td>
                            ##付款人内部账户余额
                            <div id="payerFcAccBalance"></div>
                        </td>
                        <td class="textRight">#springMessage('table.nisAllocationReq.fcAccBalance')</td>
                        <td>
                            ##收款人内部账户余额
                            <div id="payeeFcAccBalance"></div>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('table.nisAllocationReq.accName')</td>
                        <td>
                            ##收款人户名
                            $!{nisAllocationReqPage.payerAccName}
                        </td>
                        <td class="textRight">#springMessage('table.nisAllocationReq.accName')</td>
                        <td>
                            ##付款人户名
                            $!{nisAllocationReqPage.payeeAccName}
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
                        <td>
                            ##收款人开户行
                            $!{nisAllocationReqPage.payerBankName}
                        </td>
                        <td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
                        <td>
                            ##付款人开户行
                            $!{nisAllocationReqPage.payeeBankName}
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('table.nisAllocationReq.provCity')</td>
                        <td>
                            ##付款人所在省市
                            <div id="payerProvCity"></div>
                        </td>
                        <td class="textRight">#springMessage('table.nisAllocationReq.provCity')</td>
                        <td>
                            ##收款人所在省市
                            <div id="payeeProvCity"></div>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.purpose')</td>
                        <td>
                            ##用途
                            $!{nisAllocationReqPage.purpose}
                        </td>
                        <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.wishPayday')</td>
                        <td>
                            ##期望支付日期
                            $!date.format('yyyy-MM-dd',$!{nisAllocationReqPage.wishPayday})
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.money.lower')</td>
                        <td>
                            ##金额（小写）
                            $!number.formatNumeric($!{nisAllocationReqPage.money})
                        </td>
                        <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.money.upper')</td>
                        <td style="padding-left:0px">
                            ##金额（大写）
                            <label id="moneyUp"></label>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.isQuick')</td>
                        <td>
                            ##是否加急
                            $dictTag.get("sf_yn",$!{nisAllocationReqPage.isQuick})
                        </td>
                        <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.areaSign')</td>
                        <td>
                            ##是否同城
                            $dictTag.get("nisBillhead.areaSign",$!{nisAllocationReqPage.areaSign})
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.difBank')</td>
                        <td>
                            ##是否同行
                            $dictTag.get("nisBillhead.difBank",$!{nisAllocationReqPage.difBank})
                        </td>
                        <td class="textRight" colspan="2"></td>
                        <td>
                        </td>
                    </tr>
                    <tr>
                        ##备注说明
                        <td class="textRight" colspan="2">#springMessage('table.settlement.rmk')</td>
                        <td width="80%" colspan="4">$!{nisAllocationReqPage.rmk}</td>
                    </tr>
                </tbody>
            </table>
            <!-- 日志 -->
            <div id="tagMsg"></div>
        </div>
        <!-- 附件上传 -->
        <input id="attachmentId" name="attachmentId" type="hidden" value="$!{nisAllocationReqPage.attachmentId}">
        <div id="uploader" class="layui-input-inline" style="width:100%"></div>
        <p>
        <div class="layui-form-item layui-form-submit" id="buttonDiv">
			<div class="layui-input-block">
				<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{nisAllocationReqPage.id}')">#springMessage('common.button.trackFlow')</button>
				<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
			</div>
        </div>
	</form>
    #parse("views/common/footer.vm")
    <script src="${basePath}/static/modules/allocation/nisPosAllocationReq.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <input id="id" name="id" type="hidden" value="$!{nisAllocationReqPage.id}">
        <input type="hidden" id="payeeAccId" name="payeeAccId" value="$!{nisAllocationReqPage.payeeAccId}">
        <input type="hidden" id="payerAccId" name="payerAccId" data-defaultvalue="$!{nisAllocationReqPage.payerAccId}" value="$!{nisAllocationReqPage.payerAccId}">
        <input type="hidden" id="status" name="status" value="$!{nisAllocationReqPage.status}">
        <input type="hidden" id="createDate" name="createDate" value="$!{nisAllocationReqPage.createDate}">
        <input type="hidden" id="updateBy" name="updateBy" value="$!{nisAllocationReqPage.updateBy}">
        <input type="hidden" id="updateDate" name="updateDate" value="$!{nisAllocationReqPage.updateDate}">
        <input type="hidden" id="type" name="type" value="10">
        <input type="hidden" id="difBank" name="difBank" value="$!{nisAllocationReqPage.difBank}">
        <input type="hidden" id="areaSign" name="areaSign" value="$!{nisAllocationReqPage.areaSign}">
        <input type="hidden" id="corpId" name="corpId" value="$!{nisAllocationReqPage.corpId}">
        <input type="hidden" id="curId" name="curId" data-defaultvalue="$!{nisAllocationReqPage.curId}" value="$!{nisAllocationReqPage.curId}">
		<input id="caInfoId" name="caInfoId" type="hidden" value="$!{nisAllocationReqPage.caInfoId}">
        <input type="hidden" id="billFrom" name="billFrom"  value="$!{nisAllocationReqPage.billFrom}">
		<!-- 系统参数 -->
        <input type="hidden" id="bankaccOver" name="bankaccOver" value="$!{bankaccOver}">
        <input type="hidden" id="accountOver" name="accountOver" value="$!{accountOver}">
        <input type="hidden" id="isAccount" name="isAccount" value="$!{isAccount}">
        <input id="isOpenLimit" name="isOpenLimit" type="hidden" value="$!{isOpenLimit}">

        <input type="hidden" id="balance" name="balance">
        <input type="hidden" id="fcAccBalance" name="fcAccBalance">
		<table class="layui-table">
			<tbody>
            <tr>
                <td rowspan="4" width="20">#springMessage('table.nisAllocationReq.payerInfo')</td>
                <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
                <td>
                    <input type="hidden" id="corpIdDef" value="$!{nisAllocationReqPage.corpId}">
                ##付款人单位
                    <div class="layui-input-inline">
                        <div class="demo-selectTree-normal" ></div>
                    </div>
                </td>
                <td rowspan="4" width="10">#springMessage('table.nisAllocationReq.payeeInfo')</td>
                <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
                <td>
                ##收款人单位
                    <input type="text" id="payeeCorpId" name="payeeCorpId" lay-verify="required" readonly="readonly"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.corp')" value="$!{nisAllocationReqPage.payeeCorpId}">
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.nisAllocationReq.acc')</td>
                <td>
                ##付款人账号
                    <div class="layui-input-inline">
                        <input type="text" id="payerAcc" name="payerAcc" lay-verify="required|tableData" data-biz-name="payerAcc"
                               data-resource="netbank:allocation:typeUp:apply" accountType="2,3"
                               autocomplete="off" class="layui-input" data-defaultvalue="$!{nisAllocationReqPage.payerAcc}" value="$!{nisAllocationReqPage.payerAcc}">
                        <table id="payerAccTable" class="hide">
                            <thead>
                            <tr>
                                <th>#springMessage('table.btBankAcc.bankAcc')</th>
                                <th>#springMessage('table.btBankAcc.accName')</th>
                                <th>#springMessage('table.btBankAcc.bankName')</th>
                                <th>#springMessage('table.nisBillhead.curId')</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </td>
                <td class="textRight">#springMessage('table.nisAllocationReq.acc')</td>
                <td>
                ##收款人账号
                    <input type="text" id="payeeAcc" name="payeeAcc" lay-verify="required" readonly="readonly"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.payeeAcc')" value="$!{nisAllocationReqPage.payeeAcc}">
                </td>
            </tr>
				<tr>
    				<td class="textRight">#springMessage('table.nisAllocationReq.accName')</td>
                    <td>
						##付款人户名
						<input type="text" id="payerAccName" name="payerAccName"  readonly="readonly"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.payerAccName')" value="$!{nisAllocationReqPage.payerAccName}">
                    </td>
    				<td class="textRight">#springMessage('table.nisAllocationReq.accName')</td>
                    <td>
						##收款人户名
						<input type="text" id="payeeAccName" name="payeeAccName" readonly="readonly"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.payeeAccName')" value="$!{nisAllocationReqPage.payeeAccName}" >
                    </td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
                    <td>
                        <input type="hidden" id="payerBankCode">
						##付款人开户行
						<input type="text" id="payerBankName" name="payerBankName" readonly="readonly"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.payerBankName')" value="$!{nisAllocationReqPage.payerBankName}">
                    </td>
    				<td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
                    <td>
                        <input type="hidden" id="payeeBankCode">
						##收款人开户行
						<input type="text" id="payeeBankName" name="payeeBankName" readonly="readonly"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.payeeBankName')" value="$!{nisAllocationReqPage.payeeBankName}">
                    </td>
				</tr>
				<tr>
    				<td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.curId')</td>
                    <td>
						##币别
                        <input type="text" id="curName" name="curName" readonly="readonly"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.curId')" value="$!{curName}">
                    </td>
    				<td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.purpose')</td>
                    <td>
                        ##用途
                        <div class="bt-biz-selectType" data-name ="purpose" data-biz-name ="purpose" data-valueField="purpose" data-textField="purpose"
                             data-defaultvalue="$!{nisAllocationReqPage.purpose}" data-inputvalue="inputvalue" data-extraData="true" data-search="true" data-required="true"
                             data-url="${basePath}/basic/business/btpurpose?getByListSort&sysBusType=1&busDtl=2&corpId=$!{nisAllocationReqPage.corpId}"></div>
                    </td>
				</tr>
				<tr>
    				<td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.money.lower')</td>
                    <td>
						##金额（小写）
						<input type="text" data-name="money" data-biz-name="money"  lay-verify="required|number2"
							class="layui-input bt-biz-moneyType" style="text-align:right" data-toUp="moneyUp"
							autocomplete="off" placeholder="#springMessage('table.nisAllocationReq.money.lower')" value="$!{nisAllocationReqPage.money}">
                    </td>
    				<td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.money.upper')</td>
                    <td>
						##金额（大写）
						<div id="moneyUp"></div>
                    </td>
				</tr>
				<tr>
    				<td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.wishPayday')</td>
                    <td>
						 ##期望支付日期
						  <div class="layui-input-inline">
                            <input type="text" name="wishPayday" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!{nisAllocationReqPage.wishPayday})"
                                   data-min="$!date.format('yyyy-MM-dd',$!{date.getDate()})" data-type="date" data-biz-name="wishPayday" lay-verify="required|date">
                        </div>
                    </td>
    				<td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.isQuick')</td>
                    <td>
						##是否加急
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{nisAllocationReqPage.isQuick}" data-name="isQuick" data-biz-name="isQuick" data-required="true"></div>
                    </td>
				</tr>
                <tr>
                    ##备注说明
                    <td class="textRight" colspan="2" width="20%">#springMessage('table.settlement.rmk')</td>
                    <td width="80%" colspan="5">
                        <div class="layui-input-inline">
                            <textarea class="layui-textarea" name="rmk" id="rmk" style="resize:none" cols="125" rows="2" >$!{nisAllocationReqPage.rmk}</textarea>
                        </div>
                    </td>
                </tr>
				<tr>
                    <td colspan="6" class="center">
                        <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
                        <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                        <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallback">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
		#caDataHidden()
	</form>
    #parse("views/common/footer.vm")
	#caDataScript()
</body>
<script src="${basePath}/static/modules/allocation/nisAllocationReq.common.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/allocation/nisUpAllocationReq.edit.js?_btv=${resourceVersion}"></script>
</html>
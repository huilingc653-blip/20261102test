<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{bisGatherPolicyPage.id}">
		<input id="createBy" name="createBy" type="hidden" value="$!{bisGatherPolicyPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{bisGatherPolicyPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{bisGatherPolicyPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{bisGatherPolicyPage.updateDate}">
        <table class="layui-table">
            <tbody>
				<tr>
					##调拨策略代码
					<td class="textRight" width="20%">#springMessage('table.bisGatherPolicy.gatherPolicyCode')</td>
    				<td width="30%">
						<input type="hidden" id="gatherPolicyCode" name="gatherPolicyCode" value="$!{bisGatherPolicyPage.gatherPolicyCode}">
						$!{bisGatherPolicyPage.gatherPolicyCode}
					</td>
					##调拨策略名称
					<td class="textRight" width="20%">#springMessage('table.bisGatherPolicy.gatherPolicyName')</td>
    				<td width="30%">
						<input type="text" id="gatherPolicyName" name="gatherPolicyName" lay-verify="required|strlength" data-maxlength="20"
						    autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisGatherPolicy.gatherPolicyName')" value="$!{bisGatherPolicyPage.gatherPolicyName}">
					</td>
				</tr>
				<tr>
    				##调拨类型
    				<td class="textRight">#springMessage('table.bisGatherPolicy.gatherType')</td>
    				<td >
    					<div class="layui-inline">
    						<input type="hidden" id="gatherType" name="gatherType" value="$!{bisGatherPolicyPage.gatherType}">
    						$dictTag.get("bisGatherPolicy.gatherType",$!{bisGatherPolicyPage.gatherType})
                        </div>
    				</td>
    				##策略模式
                    <td class="textRight"><div id="gatherModeSpanDiv">#springMessage('table.bisGatherPolicy.gatherMode')</div></td>
    				<td >
    					<div class="layui-inline" id="gatherModeDiv">
    						<input type="hidden" id="gatherMode" name="gatherMode" value="$!{bisGatherPolicyPage.gatherMode}">
    						$dictTag.get("bisGatherPolicy.gatherMode",$!{bisGatherPolicyPage.gatherMode})
    					</div>
    				</td>
    			</tr>
				<tr>
					##策略生效日期
    				<td class="textRight">#springMessage('table.bisGatherPolicy.defDate')</td>
    				<td>
                        <input type="text" name="defDate" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{bisGatherPolicyPage.defDate}" data-type="datetime">
                        <input type="hidden" id="launchTime" name="launchTime"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisGatherPolicy.launchTime')">
					</td>
            		##调拨周期
                    <td class="textRight"><div id="frqModeSpanDiv">#springMessage('table.bisGatherPolicy.frqMode')</div></td>
    				<td>
    					<div class="layui-inline ignore-required-hide" id="frqModeDiv">
    						<input type="hidden" id="frqMode" name="frqMode" value="$!{bisGatherPolicyPage.frqMode}">
    						<div class="layui-input-inline">$dictTag.get("bisGatherPolicy.frqMode",$!{bisGatherPolicyPage.frqMode})</div>
    						<div class="layui-inline ignore-required-hide" id="serialDayDiv">
        						  <div class="layui-input-inline">#springMessage('table.bisGatherPolicy.daySplit')$!{bisGatherPolicyPage.serialDay}</div>
    							  <div class="layui-input-inline"><input type="hidden" id="serialDay" name="serialDay" value="$!{bisGatherPolicyPage.serialDay}"
        							   decimal="0" autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-decimal="0" data-biz-name="serialDay"></div>
    							  <div class="layui-input-inline">#springMessage('table.bisGatherPolicy.day')</div>
    					    </div>
    						<div class="layui-inline ignore-required-hide" id="weekDiv" style="display:none">
    							#springMessage('table.bisGatherPolicy.week')$dictTag.get("bisGatherPolicy.week",$!{bisGatherPolicyPage.serialDay})
    						</div>
    						<div class="layui-inline ignore-required-hide" id="monthDiv" style="display:none">
    							#springMessage('table.bisGatherPolicy.month')$dictTag.get("bisGatherPolicy.month",$!{bisGatherPolicyPage.serialDay})
    						</div>
                        </div>
    				</td>
				</tr>
				<tr>
					##策略失效日期
					<td class="textRight">策略结束日期</td>
					<td>
						<input type="text" name="endDate" id='endDate' lay-verify="required" class="layui-input bt-biz-dateType" data-today="true" data-type="datetime"
							   value="$!{bisGatherPolicyPage.endDate}">
						<input type="hidden" id="endTime" name="endTime"
							   autocomplete="off" class="layui-input" placeholder="策略结束日期">
					</td>
				</tr>
				<tr id="amtTr">
    				<td class="textRight" id="gatherAmtSpanTd">#springMessage('table.bisGatherPolicy.gatherAmt')</td>
    				<td id="gatherAmtTd">
    					##调拨金额（留底资金金额/取整单位/留底资金金额/固定上划金额/账户固定余额）
    					<div id="gatherAmtDiv" class="layui-input-inline">
                            <input type="text" id="gatherAmt" name="gatherAmt" lay-verify="required|number2" value="$!{bisGatherPolicyPage.gatherAmt}"
								autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right">
    					</div>
    					##比例
    					<div id="differScaleDiv" class="layui-input-inline">
                            <input type="text" id="differScale" name="differScale" lay-verify="required|number2" value="$!{bisGatherPolicyPage.differScale}"
							   autocomplete="off" class="layui-input bt-biz-ratioType" data-max="100" style="text-align:right" placeholder="#springMessage('table.bisGatherPolicy.differScale')">
    					</div>

    					##取整单位
    					<div id="unitDiv" class="layui-input-inline">
                            <select lay-filter="unit" id="unit" name="unit">
                                <option value=""></option>
    							#foreach($dict in $dictTag.list("bisGatherPolicy.unit"))
    								#if("$dict.code" == "$!{bisGatherPolicyPage.gatherAmt}")
                                    <option value="$dict.code" selected >$dict.name</option>
    								#else
    								<option value="$dict.code">$dict.name</option>	
    								#end
    							#end
    						</select>
    					</div>
					</td>
    				<td class="textRight" id="downFixedAmtSpanTd">#springMessage('table.bisGatherPolicy.minAmt')</td>
    				<td  id="downFixedAmtTd">
    					##下拨固定额度（定时下拨，余额不足时固定额度下拨时，保存下拨固定额度）
    					<div id="downFixedAmtDiv" class="layui-input-inline">
                            <input type="text" id="downFixedAmt" name="downFixedAmt" lay-verify="required|number2" value="$!{bisGatherPolicyPage.downFixedAmt}"
							   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" placeholder="#springMessage('table.bisGatherPolicy.downFixedAmt')">
    					</div>
    					##金额下限(最小执行额度)
    					<div id="minAmtDiv" class="layui-input-inline">
                            <input type="text" id="minAmt" name="minAmt" lay-verify="required|number2" value="$!{bisGatherPolicyPage.minAmt}"
							   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" placeholder="#springMessage('table.bisGatherPolicy.minAmt')">
						</div>
						##取整单位（针对5-留底取整归集）
						<div id="unitSpeDiv" class="layui-input-inline">
							<select lay-filter="unitSpe" id="unitSpe" name="unitSpe">
								<option value=""></option>
								#foreach($dict in $dictTag.list("bisGatherPolicy.unit"))
									#if("$dict.code" == "$!{bisGatherPolicyPage.minAmt}")
										<option value="$dict.code" selected >$dict.name</option>
									#else
										<option value="$dict.code">$dict.name</option>
									#end
								#end
							</select>
						</div>
					</td>
    				<td id="addTd1"></td>
    				<td id="addTd2"></td>
            	</tr>
				<tr>
					##加急标志
					<td class="textRight">#springMessage('table.bisGatherPolicy.isQuick')</td>
    				<td >
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{bisGatherPolicyPage.isQuick}" data-name="isQuick" ></div>
					</td>
					##有效标志
					<td class="textRight">#springMessage('table.bisGatherPolicy.validSign')</td>
    				<td >
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{bisGatherPolicyPage.validSign}" data-name="validSign" ></div>
					</td>
				</tr>
                <tr>
                    <td class="textRight">#springMessage('table.bisGatherPolicy.curId')</td>
                    <td>
                        $!{currencyTag.getCurName($!{bisGatherPolicyPage.curId})}
                    </td>
					<td class="textRight">#springMessage('table.bisGatherPolicy.autoFilterHolidays')</td>
					<td >
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{bisGatherPolicyPage.autoFilterHolidays}" data-name="autoFilterHolidays" data-callback="bt.autoFilterHolidaysRule"></div>
					</td>
                </tr>
				<tr id="autoFilterHolidaysRuleTr" #if($!{bisGatherPolicyPage.autoFilterHolidays}=="0") class="hidden" #end >
					<td></td>
					<td></td>
					<td class="textRight">#springMessage('table.bisGatherPolicy.autoFilterHolidays.rule')</td>
					<td >
						<div class="bt-biz-dict" data-type="radio" data-group="autoFilterHolidaysRule"
							 data-required="true" data-defaultvalue="$!{bisGatherPolicyPage.autoFilterHolidaysRule}" data-name="autoFilterHolidaysRule" ></div>
					</td>
				</tr>
				<tr>
					##用途
					<td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
					<td>
						<input type="text" id="purpose" name="purpose"  value="$!{bisGatherPolicyPage.purpose}" lay-verify="required"
							   autocomplete="off" class="layui-input"  placeholder="#springMessage('table.nisBillhead.purpose')">

					</td>
					##附言
					<td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
					<td >
						<input type="text" id="addWord" name="addWord"  value="$!{bisGatherPolicyPage.addWord}" lay-verify="required"
							   autocomplete="off" class="layui-input"  placeholder="#springMessage('table.nisBillhead.addWord')">
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.bisGatherPolicy.failHandleMethod')</td>
					<td colspan="3">
						<div class="layui-input-inline">
							<div class="bt-biz-dict" data-type="radio" data-group="bisGatherPolicy.failHandleMethod" data-defaultvalue="$!{bisGatherPolicyPage.failHandleMethod}" data-name="failHandleMethod" ></div>
						</div>
						<div class="layui-input-inline">
							<div style="color: red">#springMessage('table.bisGatherPolicy.failHandleMethod.desc')</div>
						</div>
					</td>
				</tr>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/bisGatherPolicy.edit.js?_btv=${resourceVersion}"></script>
</html>
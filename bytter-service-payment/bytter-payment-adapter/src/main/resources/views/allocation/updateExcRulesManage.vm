<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{excRluesManage.id}">
		<input id="createBy" name="createBy" type="hidden" value="$!{excRluesManage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{excRluesManage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{excRluesManage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{excRluesManage.updateDate}">
		<input id="payeeAccId" name="payeeAccId" type="hidden" value="$!{excRluesManage.payeeAccId}"/>
		<input id="curpId" name="curpId" type="hidden" value="$!{excRluesManage.corpId}"/>
		<input id="filterCode" name="filterCode" type="hidden" value="$!{excRluesManage.filterCode}"/>
        <table class="layui-table">
            <tbody>
				<tr>
					##规则名称
					<td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.excRulesManage.ruleName')</td>
    				<td width="40%">
						<input type="hidden" id="filterName" name="filterName" value="$!{excRluesManage.filterName}">
						$!{excRluesManage.filterName}
					</td>
					##单位
					<td class="textRight">#springMessage('table.fbsBudgetProcess.corpId')</td>
    				<td width="40%">
						 <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-biz-name="corpId"
                                 data-type="selectTree"
                                 data-name="corpId"
                                 data-callback = "bt.corpCallback"
								 data-defaultvalue="$!{excRluesManage.corpId}"
                                 data-scope="all"   
								 data-resource="netbank:allocation:excRulesManage:apply"
                                 data-required="true"></div>
                        </div>
					</td>
				</tr>
				<tr>
    				##收款账号
    				<td class="textRight">#springMessage('table.fbsBudgetDetail.payeeAcc')</td>
    				<td >
    					<div class="layui-inline">
    						<input type="text" id="payeeAccNo" name="payeeAccNo" data-biz-name="payeeAccNo" lay-verify="required|tableData" data-link="balanceDiv"
							value="$!{excRluesManage.payeeAccNo}" autocomplete="off" class="layui-input text bank" placeholder="#springMessage('table.fbsBudgetDetail.payeeAcc')">
						<table id="payeeAccTable" class="hide">
							<thead>
								<tr>
									<th>#springMessage('table.choBankFinance.acc')</th>
									<th>#springMessage('table.choBankFinance.accName')</th>
									<th>#springMessage('table.choBankFinance.accBank')</th>
									<th>#springMessage('table.choBankFinance.curId')</th>
								</tr>
							</thead>
						</table>
                        </div>
    				</td>
    				##付款账号
                    <td class="textRight"><div id="gatherModeSpanDiv">#springMessage('table.fbsBudgetDetail.payerAcc')</div></td>
    				<td >
    					<div class="layui-inline" id="payerAccNo">
    						<input type="text" id="payerAccNo" name="payerAccNo" value="$!{excRluesManage.payerAccNo}" lay-verify="required|number" class="layui-input bank">
    					</div>
    				</td>
    			</tr>
				<tr>
					##有效标志
					<td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.bisGatherPolicy.validSign')</td>
    				<td >
						#set ($mymap = {"field":"validSign","type":"radio","typeGroupCode":"sf_yn","defaultVal":"$!{excRluesManage.validSign}","title":"table.bisGatherPolicy.validSign"})
						#set ($formB = $dictSelect.instance($mymap))
						${formB.html()}
					</td>
				</tr>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/excRulesManage.edit.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
    <input type="hidden" name="eqi_type" value="14">
    <input type="hidden" id="caType"  value="5"/>
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.payerAcc')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" id="likes_payerAcc" name="likes_payerAcc" data-name="likes_payerAcc"
                           data-resource="netbank:allocation:typeDown:query"  class="layui-input bt-biz-accountTable" data-callback="accountCallBack"/>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.money')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_money" class="layui-input bt-biz-moneyType textRight"
                           data-moneyendid="tleg_money20" autocomplete="off" placeholder="#springMessage('table.nisAllocationReq.money')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" id="leg_money" data-name="leg_money" class="layui-input bt-biz-moneyType textRight"
                           autocomplete="off" placeholder="#springMessage('table.nisAllocationReq.money')">
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.wishPayday')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="ged_wishPayday" class="layui-input bt-input-inline bt-biz-dateType"
                           data-endid="led_wishPayday">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_wishPayday" class="layui-input bt-input-inline bt-biz-dateType"
                           id="led_wishPayday">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisAllocationReq.billNo')</th>
        <th>#springMessage('table.nisAllocationReq.payeeAcc')</th>
        <th>#springMessage('table.nisAllocationReq.accName')</th>
        <th>#springMessage('table.nisAllocationReq.bankName')</th>
        <th>#springMessage('table.nisAllocationReq.curId')</th>
        <th>#springMessage('table.nisAllocationReq.wishPayday')</th>
        <th>#springMessage('table.nisAllocationReq.purpose')</th>
        <th>#springMessage('table.nisAllocationReq.money')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
    #caDataHidden()
    #caDataScript()
    #paymentWorkFlowScript()
<script>
    bt.use(['form', 'datatable', 'moneyType','accountTable'], function () {
        $ = bt.jquery, form = bt.form();
        bt.moneyType.init();
        accountCallBack = function (data) {
            $("#likes_payerAcc").val(data.bankAcc);
        }
        bt.accountTable.init();
        var table = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            colReorder: true,
            checkbox: true,
            order: [1, 'desc'],
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath + "/allocation/nisallocationreq/dataTableApprove"
            },
            buttons: [],
            fixedColumns: {
                rightColumns: 1//代表冻结右边一列
            },
            columns: [
                {data: "billNo", bSortable: true},
                {data: "payeeAcc", bSortable: true},
                {data: "payeeAccName", bSortable: true},
                {data: "payeeBankName", bSortable: false},
                {data: "curName", bSortable: true},
                {data: "wishPayday", bSortable: true},
                {data: "purpose", bSortable: true},
                {
                    data: "money", bSortable: true, className: "textRight",
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.money);
                    }
                },
                {data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
                    var html='';
                	if($("#flowStatus").val()=='todo'){
                		html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
                	}
                    if($("#flowStatus").val() == 'pass'){
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a><span class="text-explode">|</span>';
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                    }else {
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                    }
                	return html;
                }}
            ],
            summary: {
                pageSum: false,
                allSum: true,
                selectSum: true,
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '8',
                        dataName: 'money'
                    }
                ]
            }
        });
    });
</script>
<script src="${basePath}/static/modules/allocation/nisTurnAllocationReqApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

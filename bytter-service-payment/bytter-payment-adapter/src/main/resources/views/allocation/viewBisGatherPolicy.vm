<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
            <tbody>
				<tr>
					##调拨策略代码
					<td class="textRight">#springMessage('table.bisGatherPolicy.gatherPolicyCode')</td>
    				<td width="35%">$!{bisGatherPolicyPage.gatherPolicyCode}</td>
					##调拨策略名称
					<td class="textRight">#springMessage('table.bisGatherPolicy.gatherPolicyName')</td>
    				<td width="35%">$!{bisGatherPolicyPage.gatherPolicyName}</td>
				</tr>
				<tr>
    				##调拨类型
    				<td class="textRight">#springMessage('table.bisGatherPolicy.gatherType')</td>
    				<td >$dictTag.get("bisGatherPolicy.gatherType",$!{bisGatherPolicyPage.gatherType})</td>
					#if("$!{bisGatherPolicyPage.gatherType}" != "1")
    				##策略模式
                    <td class="textRight">
						<div id="gatherModeSpanDiv">
						#if($!{bisGatherPolicyPage.gatherType} == "0")
							#springMessage('table.bisGatherPolicy.gatherMode')
						#else
							#springMessage('table.bisGatherPolicy.downMode')
						#end
						</div>
					</td>
    				<td >$dictTag.get("bisGatherPolicy.gatherMode",$!{bisGatherPolicyPage.gatherMode})</td>
					#else
					<td></td>
					<td></td>
					#end
    			</tr>
				<tr>
					##策略生效日期
    				<td class="textRight">#springMessage('table.bisGatherPolicy.defDate')</td>
    				<td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{bisGatherPolicyPage.defDate})</td>
					#if("$!{bisGatherPolicyPage.gatherType}" != "1" && "$!{bisGatherPolicyPage.gatherMode}" != "0")
            		##调拨周期
                    <td class="textRight"><div id="frqModeSpanDiv">#springMessage('table.bisGatherPolicy.frqMode')</div></td>
    				<td>
						$dictTag.get("bisGatherPolicy.frqMode",$!{bisGatherPolicyPage.frqMode})
						##4-按日
						#if("$!{bisGatherPolicyPage.frqMode}" == "4")
							 #springMessage('table.bisGatherPolicy.daySplit')$!{bisGatherPolicyPage.serialDay}#springMessage('table.bisGatherPolicy.day')
						#end
						##8-按周
						#if("$!{bisGatherPolicyPage.frqMode}" == "8")
							#springMessage('table.bisGatherPolicy.week')$dictTag.get("bisGatherPolicy.week",$!{bisGatherPolicyPage.serialDay})
						#end
						##16-按月
						#if("$!{bisGatherPolicyPage.frqMode}" == "16")
							#springMessage('table.bisGatherPolicy.month')$dictTag.get("bisGatherPolicy.month",$!{bisGatherPolicyPage.serialDay})
						#end
					</td>
					#else
					<td></td>
					<td></td>
					#end
				</tr>

				##8-全额归集
				#if("$!{bisGatherPolicyPage.gatherType}" != "1" && "$!{bisGatherPolicyPage.gatherMode}" == "8")
				<tr>
					##最小执行额度
					<td class="textRight">#springMessage('table.bisGatherPolicy.minAmt')</td>
    				<td >$!number.formatNumeric($!{bisGatherPolicyPage.minAmt})</td>
					<td></td>
					<td></td>
				</tr>
				#end
				##6-取整归集
				#if("$!{bisGatherPolicyPage.gatherMode}" == "6")
				<tr>
					##取整单位
					<td class="textRight">#springMessage('table.bisGatherPolicy.unit')</td>
					<td> $dictTag.get("bisGatherPolicy.unit",$!{bisGatherPolicyPage.gatherAmt})</td>
					##最小执行额度
					<td class="textRight">#springMessage('table.bisGatherPolicy.minAmt')</td>
    				<td >$!number.formatNumeric($!{bisGatherPolicyPage.minAmt})</td>
				</tr>
				#end
				##1-留底资金归集
				#if("$!{bisGatherPolicyPage.gatherMode}" == "1")
				<tr>
					##留底资金金额
					<td class="textRight">#springMessage('table.bisGatherPolicy.purposeAmt')</td>
					<td>$!number.formatNumeric($!{bisGatherPolicyPage.gatherAmt})</td>
					##最小执行额度
					<td class="textRight">#springMessage('table.bisGatherPolicy.minAmt')</td>
    				<td >$!number.formatNumeric($!{bisGatherPolicyPage.minAmt})</td>
				</tr>
				#end
				##5-留底取整归集
				#if("$!{bisGatherPolicyPage.gatherMode}" == "5")
				<tr>
					##留底资金金额
					<td class="textRight">#springMessage('table.bisGatherPolicy.purposeAmt')</td>
					<td>$!number.formatNumeric($!{bisGatherPolicyPage.gatherAmt})</td>
					##取整单位
					<td class="textRight">#springMessage('table.bisGatherPolicy.unit')</td>
					<td> $dictTag.get("bisGatherPolicy.unit",$!{bisGatherPolicyPage.minAmt})</td>
				</tr>
				#end
				##9-固定金额归集
				#if("$!{bisGatherPolicyPage.gatherMode}" == "9")
				<tr>
					##固定上划金额
					<td class="textRight">#springMessage('table.bisGatherPolicy.fixUpAmt')</td>
    				<td >$!number.formatNumeric($!{bisGatherPolicyPage.gatherAmt})</td>
					<td></td>
					<td></td>
				</tr>
				#end
				##b-比例上划(交易额) 或 2-比例下拨(交易额)
				#if("$!{bisGatherPolicyPage.gatherMode}" == "b" || "$!{bisGatherPolicyPage.gatherMode}" == "2")
				<tr>
					##比例
					<td class="textRight">#springMessage('table.bisGatherPolicy.scale')</td>
    				<td >
                        $rateTag.show($!{bisGatherPolicyPage.differScale}, 2)
                    </td>
					<td></td>
					<td></td>
				</tr>
				#end
				##4-固定余额
				#if("$!{bisGatherPolicyPage.gatherMode}" == "4")
				<tr>
					##账户固定余额
					<td class="textRight">#springMessage('table.bisGatherPolicy.fixBalance')</td>
    				<td >$!number.formatNumeric($!{bisGatherPolicyPage.gatherAmt})</td>
					<td></td>
					<td></td>
				</tr>
				#end
				##3-固定额度
				#if("$!{bisGatherPolicyPage.gatherMode}" == "3")
				<tr>
					##下拨固定额度
					<td class="textRight">#springMessage('table.bisGatherPolicy.downFixedAmt')</td>
    				<td >$!number.formatNumeric($!{bisGatherPolicyPage.downFixedAmt})</td>
					<td></td>
					<td></td>
				</tr>
				#end
				##a-余额不足时固定额度下拨
				#if("$!{bisGatherPolicyPage.gatherMode}" == "a")
				<tr>
					##账户固定余额
					<td class="textRight">#springMessage('table.bisGatherPolicy.fixBalance')</td>
    				<td >$!number.formatNumeric($!{bisGatherPolicyPage.gatherAmt})</td>
					##下拨固定额度
					<td class="textRight">#springMessage('table.bisGatherPolicy.downFixedAmt')</td>
    				<td >$!number.formatNumeric($!{bisGatherPolicyPage.downFixedAmt})</td>
				</tr>
				#end
				<tr>
					##加急标志
					<td class="textRight">#springMessage('table.bisGatherPolicy.isQuick')</td>
    				<td >$dictTag.get("sf_yn",$!{bisGatherPolicyPage.isQuick})</td>
					##有效标志
					<td class="textRight">#springMessage('table.bisGatherPolicy.validSign')</td>
    				<td >$dictTag.get("sf_yn",$!{bisGatherPolicyPage.validSign})</td>
				</tr>
                <tr>
                    <td class="textRight">#springMessage('table.bisGatherPolicy.curId')</td>
                    <td>
                        $!{currencyTag.getCurName($!{bisGatherPolicyPage.curId})}
                    </td>
					<td class="textRight">#springMessage('table.bisGatherPolicy.autoFilterHolidays')</td>
					<td >
						$dictTag.get("sf_yn",$!{bisGatherPolicyPage.autoFilterHolidays})
					</td>
                </tr>
				<tr #if($!{bisGatherPolicyPage.autoFilterHolidays}=="0") class="hidden" #end>
					<td></td>
					<td>
					</td>
					<td class="textRight">#springMessage('table.bisGatherPolicy.autoFilterHolidays.rule')</td>
					<td >
						$dictTag.get("autoFilterHolidaysRule",$!{bisGatherPolicyPage.autoFilterHolidaysRule})
					</td>
				</tr>
				<tr>
					##用途
					<td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
					<td>
						$!{bisGatherPolicyPage.purpose}
					</td>
					##附言
					<td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
					<td >
						$!{bisGatherPolicyPage.addWord}
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.bisGatherPolicy.failHandleMethod')</td>
					<td colspan="3">$dictTag.get("bisGatherPolicy.failHandleMethod",$!{bisGatherPolicyPage.failHandleMethod})</td>
				</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
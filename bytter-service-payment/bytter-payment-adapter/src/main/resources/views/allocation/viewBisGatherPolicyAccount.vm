<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <table class="layui-table">
        <tbody>
        <tr>
            ##调拨策略代码
            <td class="textRight">#springMessage('银行账号')</td>
            <td width="35%">$!{policyAccountPage.bankAcc}</td>
            ##调拨策略名称
            <td class="textRight">#springMessage('优先级')</td>
            <td width="35%">$!{policyAccountPage.priority}</td>
        </tr>
        <tr>
            ##加急标志
            <td class="textRight">#springMessage('是否允许下拨')</td>
            <td >$dictTag.get("sf_yn",$!{policyAccountPage.isDown})</td>
            ##有效标志
            <td class="textRight">#springMessage('状态')</td>
            <td >$dictTag.get("status_yn",$!{policyAccountPage.status})</td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

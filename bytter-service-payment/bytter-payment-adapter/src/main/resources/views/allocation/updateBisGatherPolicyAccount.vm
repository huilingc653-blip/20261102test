<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="id" name="id" value="$!{policyAccountPage.id}">
    <table class="layui-table">
        <tbody>
        <tr>
            ## 银行账号
            <td class="textRight">#springMessage('银行账号')</td>
            <td>
                <input type="text" id="bankAcc" name="bankAcc" lay-verify="tableData|required" data-biz-name="bankAcc"
                       autocomplete="off" class="layui-input text" placeholder="#springMessage('银行账号')" value="$!{policyAccountPage.bankAcc}">
                <table id="bankAccTable" class="hide">
                    <thead>
                    <tr>
                        <th>#springMessage('table.nisBillhead.payerAcc')</th>
                        <th>#springMessage('table.nisBillhead.payerAccName')</th>
                        <th>#springMessage('table.nisBillhead.payerBank')</th>
                        <th>#springMessage('table.nisBillhead.curId')</th>
                    </tr>
                    </thead>
                </table>
            </td>
            ## 优先级
            <td class="textRight" >#springMessage('优先级')</td>
            <td >
                <input type="text" id="priority" name="priority" lay-verify="required" value="$!{policyAccountPage.priority}"
                       autocomplete="off" class="layui-input bt-biz-moneyType" data-min="1" data-decimal="0" placeholder="#springMessage('优先级')">
            </td>
        </tr>
        <tr>
            ## 是否允许下拨
            <td class="textRight">#springMessage('是否允许下拨')</td>
            <td >
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{policyAccountPage.isDown}" data-name="isDown" ></div>
            </td>
            ## 状态
            <td class="textRight">#springMessage('状态')</td>
            <td >
                <div class="bt-biz-dict" data-type="radio" data-group="status_yn" data-defaultvalue="$!{policyAccountPage.status}" data-name="status" ></div>
            </td>
        </tr>

        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/bisGatherPolicyAccount.update.js?_btv=${resourceVersion}"></script>
</html>

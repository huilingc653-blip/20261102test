<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="id" name="id" value="$!{nisAllocationReqPage.id}">
    <input type="hidden" id="corpId" name="corpId" value="$!{nisAllocationReqPage.corpId}">
    <input type="hidden" id="payerAccId" name="payerAccId" value="$!{nisAllocationReqPage.payerAccId}">
    <input type="hidden" id="status" name="status" value="$!{nisAllocationReqPage.status}">
    <input type="hidden" id="billNo" name="billNo" value="$!{nisAllocationReqPage.billNo}">
    <input type="hidden" id="type" name="type" value="11">
    <input type="hidden" id="createBy" name="createBy" value="$!{nisAllocationReqPage.createBy}">
    <input type="hidden" id="createDate" name="createDate" value="$!date.format('yyyy-MM-dd',$!{createDate})">
    <input type="hidden" id="updateBy" name="updateBy" value="$!{nisAllocationReqPage.updateBy}">
    <input type="hidden" id="updateDate" name="updateDate" value="$!date.format('yyyy-MM-dd',$!{createDate})">
    <input type="hidden" id="payerCurId" name="payerCurId" value="$!{nisAllocationReqPage.payerCurId}">
    <input id="timeStamp" name="timeStamp" type="hidden" value="">
    <!-- 系统参数 -->
    <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
    <input id="downItem" name="downItem" type="hidden" value="$!{downItem}">
    <input id="isBudget" name="isBudget" type="hidden" value="">
    <input type="hidden" id="bankaccOver" name="bankaccOver" value="$!{bankaccOver}">
    <input type="hidden" id="accountOver" name="accountOver" value="$!{accountOver}">
    <input type="hidden" id="isAccount" name="isAccount" value="$!{isAccount}">
    <input id="isOpenLimit" name="isOpenLimit" type="hidden" value="$!{isOpenLimit}">
    <!-- 新增默认 -->
    <input type="hidden" id="billFrom" name="billFrom"  value="1">

    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.payerAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="payerAcc" name="payerAcc" data-name="payerAcc" data-biz-name="payerAcc" lay-verify="required"
                           data-resource="netbank:allocation:typeDown:apply"
                           class="layui-input bt-biz-accountTable" data-callback="accountCallBack" accBal="true" existChilds="true" isOnline="1"/>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.accountName')</td>
            <td>
                <input type="text" id="payerAccName" name="payerAccName" readonly="readonly"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.nisAllocationReq.payerAccName')">
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.accBalance')</td>
            <td>
                <input type="hidden" id="fcAccBalance" name="fcAccBalance"></input>
                <input type="text" id="payerAccBalance" name="payerAccBalance" data-biz-name="payerAccBalance"
                       autocomplete="off" class="layui-input bt-biz-moneyType" readonly="readonly"
                       placeholder="#springMessage('table.nisAllocationReq.payerAccBalance')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.payeeCorp')</td>
            <td>
            ##付款人单位
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="payeeCorpId"
                         data-biz-name="payeeCorpId"
                         data-resource="netbank:allocation:typeDown:apply"
                         data-callback="corpCallBack"
                         data-scope="all"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.attributeId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/bankacc/bisaccattribute/json" data-valuefield="id"
                         data-textfield="attributeName" data-inputvalue="inputvalue"
                         data-name="attributeId" data-biz-name="attributeId" data-search="true"
                         data-callback="attributeCallBack"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.down.wishPayday')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="wishPayday" class="layui-input bt-biz-dateType" data-type="date"
                           data-callback="dateCallBack"
                           data-min="$!date.format('yyyy-MM-dd',$!{date.getDate()})" data-biz-name="wishPayday"
                           data-today="true" lay-verify="required|date">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
            <td>
                <div id="corpName"></div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.curId')</td>
            <td>
                <div id="curName"></div>
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.purpose')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btpurpose?getByListSort&sysBusType=1&busDtl=2"
                         data-valuefield="purpose" data-textfield="purpose" data-name="purpose" data-biz-name="purpose"
                         data-inputvalue="inputvalue" data-search="true" data-required="true" data-value="" data-beforeInitResiveData="purposeBefore"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.isQuick')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isQuick"
                     data-biz-name="isQuick" data-required="true"></div>
            </td>
            <td colspan="4"></td>
        </tr>
        <tr>
            ##备注说明
            <td class="textRight" colspan="1" width="20%">#springMessage('table.settlement.rmk')</td>
            <td width="120%" colspan="5">
                <div class="layui-input-inline">
                    <textarea class="layui-textarea" name="rmk" id='rmk' autocomplete="off" placeholder="#springMessage('table.settlement.rmk')"
                                      style="resize:none" cols="180" rows="2"></textarea>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6">
                <table id="payeeInfo" class="layui-table layui-form dark-layui-table" style="width:100%;">
                    <thead>
                    <tr class="title">
                        <th>#springMessage('table.nisAllocationReq.payeeAcc')</th>
                        <th>#springMessage('table.nisAllocationReq.corp')</td>
                        <th>#springMessage('table.nisAllocationReq.accountName')</th>
                        <th>#springMessage('table.nisAllocationReq.bankName')</th>
                        <th>#springMessage('table.nisAllocationReq.counterAccId')</th>
                        <th>#springMessage('table.nisAllocationReq.counterAccBalance')</th>
                        <th>#springMessage('table.nisAllocationReq.accBalance')</th>
                        <th>#springMessage('table.nisAllocationReq.down.money')</th>
                    </tr>
                    </thead>
                    <tfoot style="text-align: center;background-color:#ddd">
                    <tr id="sum">
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>#springMessage('table.datatable.total')</td>
                        <td name="money">0.00</td>
                    </tr>
                    </tfoot>
                </table>
            </td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallback">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <!-- 资金计划 -->
    <div id="tagItemDetail"></div>
    <!-- 附件上传 -->
    <input id="attachmentId" name="attachmentId" type="hidden">
    <div id="uploader" class="layui-input-inline" style="width:100%"></div>
    #caDataHidden()
</form>
    #parse("views/common/footer.vm")
    #caDataScript()
</body>
<script src="${basePath}/static/modules/allocation/nisAllocationReq.common.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/allocation/nisDownAllocationReq.add.js?_btv=${resourceVersion}"></script>
</html>

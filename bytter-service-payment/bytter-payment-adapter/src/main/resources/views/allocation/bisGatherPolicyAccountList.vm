<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ## 银行账号
            <td class="textRight">#springMessage('银行账号')</td>
            <td>
                <input type="text" name="likes_bankAcc"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('银行账号')">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('银行账号')</th>
        <th>#springMessage('单位名称')</th>
        <th>#springMessage('开户行')</th>
        <th>#springMessage('优先级')</th>
        <th>#springMessage('是否允许下拨')</th>
        <th>#springMessage('状态')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/bisGatherPolicyAccount.list.js?_btv=${resourceVersion}"></script>
</html>

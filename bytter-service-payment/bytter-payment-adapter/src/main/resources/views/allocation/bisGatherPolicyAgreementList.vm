<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ## 单位
            <td class="textRight">#springMessage('单位')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-tree-type="check"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-scope="all"
                         data-biz-name="corpId"
                         data-resource="allocation:bisgatherpolicy:agreement:query"
                         data-defaultvalue=""></div>
                </div>
            </td>

            ## 是否签订协议
            <td class="textRight">#springMessage('是否签订协议')</td>
            <td >
                <div class="bt-biz-dict" data-type="select" data-group="sf_yn"  data-name="eqs_isAgreement" ></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('单位名称')</th>
        <th>#springMessage('是否签订协议')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/bisGatherPolicyAgreement.list.js?_btv=${resourceVersion}"></script>
</html>

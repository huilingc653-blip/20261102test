<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##调拨策略代码
                    <td class="textRight">#springMessage('table.bisGatherPolicy.gatherPolicyCode')</td>
                    <td>
                        <input type="text" name="likes_gatherPolicyCode"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisGatherPolicy.gatherPolicyCode')">
                    </td>
                    ##调拨策略名称
                    <td class="textRight">#springMessage('table.bisGatherPolicy.gatherPolicyName')</td>
                    <td>
						<input type="text" name="likes_gatherPolicyName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisGatherPolicy.gatherPolicyName')">
                    </td>
					##调拨类型
                    <td class="textRight">#springMessage('table.bisGatherPolicy.gatherType')</td>
                    <td>
						<div class="bt-biz-dict" data-type="select" data-group="bisGatherPolicy.gatherType" data-name="eqs_gatherType"></div>
                    </td>
				</tr>
                <tr>
                    ##有效标志
                    <td class="textRight">#springMessage('table.bisGatherPolicy.validSign')</td>
                    <td >
						<div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-name="eqs_validSign"></div>
                    </td>
					<td colspan="4"></td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.bisGatherPolicy.gatherPolicyCode')</th>
        <th>#springMessage('table.bisGatherPolicy.gatherPolicyName')</th>
		<th>#springMessage('table.bisGatherPolicy.gatherType')</th>
        <th>#springMessage('table.bisGatherPolicy.defDate')</th>
        <th>#springMessage('table.bisGatherPolicy.frqMode')</th>
        <th>#springMessage('table.bisGatherPolicy.serialDay')</th>
        <th>#springMessage('table.bisGatherPolicy.failHandleMethod')</th>
        <th>#springMessage('table.bisGatherPolicy.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/allocation/bisGatherPolicy.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <input id="id" name="id" type="hidden" value="$!{nisAllocationReqPage.id}">
    <input type="hidden" id="billNo" name="billNo" value="$!{nisAllocationReqPage.billNo}">
    <input type="hidden" id="payeeAccId" name="payeeAccId" data-defaultvalue="$!{nisAllocationReqPage.payeeAccId}" value="$!{nisAllocationReqPage.payeeAccId}">
    <input type="hidden" id="payerAccId" name="payerAccId" value="$!{nisAllocationReqPage.payerAccId}">
    <input type="hidden" id="status" name="status" value="$!{nisAllocationReqPage.status}">
    <input type="hidden" id="createBy" name="createBy" value="$!{nisAllocationReqPage.createBy}">
    <input type="hidden" id="updateBy" name="updateBy" value="$!{nisAllocationReqPage.updateBy}">
    <input type="hidden" id="createDate" name="createDate" value="$!{nisAllocationReqPage.createDate}">
    <input type="hidden" id="updateDate" name="updateDate" value="$!{nisAllocationReqPage.updateDate}">
    <input type="hidden" id="type" name="type" value="12">
    <input type="hidden" id="curId" name="curId" data-defaultvalue="$!{nisAllocationReqPage.curId}" value="$!{nisAllocationReqPage.curId}">
    <input id="caInfoId" name="caInfoId" type="hidden" value="$!{nisAllocationReqPage.caInfoId}">
    <input type="hidden" id="billFrom" name="billFrom"  value="$!{nisAllocationReqPage.billFrom}">
    <!-- 系统参数 -->
    <input id="budgetSel" name="budgetSel" type="hidden" value="$!{budgetSel}">
    <input id="askItem" name="askItem" type="hidden" value="$!{askItem}">
    <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
    <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
    <input id="defItemCode" name="defItemCode" type="hidden" value="">
    <input id="isBudget" name="isBudget" type="hidden" value="">
    <input type="hidden" id="bankaccOver" name="bankaccOver" value="$!{bankaccOver}">
    <input type="hidden" id="accountOver" name="accountOver" value="$!{accountOver}">
    <input type="hidden" id="isAccount" name="isAccount" value="$!{isAccount}">
    <!-- 设置同行和地域标志-->
##    <input type="hidden" id="areaSign" name="areaSign" value="$!{nisAllocationReqPage.areaSign}">
    <input type="hidden" id="payerProvCity">
    <input type="hidden" id="payeeProvCity">
    <input type="hidden" id="payerBankCode" >
    <input type="hidden" id="payeeBankCode" value="$!{nisAllocationReqPage.payeeBankCode}">
    <input type="hidden" id="payerBankTypeId">
    <input type="hidden" id="payeeBankTypeId" value="$!{nisAllocationReqPage.payeeBankTypeId}">
    <!--余额-->
    <input type="hidden" id="balance" name="balance">
    <input type="hidden" id="fcAccBalance" name="fcAccBalance">
    <input id="busType" name="busType" type="hidden" value="$!{busType}">

    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.billNo')</td>
            <td width="35%">
                $!{nisAllocationReqPage.billNo}
            </td>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.createDate')</td>
            <td width="35%">
                $!date.format('yyyy-MM-dd',$!{nisAllocationReqPage.createDate})
            </td>
        </tr>
        <tr>
            <td rowspan="4" width="10">#springMessage('table.nisAllocationReq.payeeInfo')</td>
            <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
            <td>
                 ##付款人单位
                $!{nisAllocationReqPage.payeeCorpName}
                <input type="hidden" id="corpIdDef" value="$!{nisAllocationReqPage.corpId}">
            </td>
            <td rowspan="4" width="10">#springMessage('table.nisAllocationReq.payerInfo')</td>
            <td class="textRight">#springMessage('table.nisAllocationReq.corp')</td>
            <td>
                ##收款人单位
                $!{nisAllocationReqPage.payerCorpName}
                <input type="hidden" id="payerCorpId" value="$!{nisAllocationReqPage.payerCorpId}">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.acc')</td>
            <td>
                ##收款人账号
                $!{nisAllocationReqPage.payeeAcc}
                <input type="hidden" id="payeeAcc" value="$!{nisAllocationReqPage.payeeAcc}">
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.acc')</td>
            <td>
                ##付款人账号
##                $!{nisAllocationReqPage.payerAcc}
##                <input type="hidden" id="payerAcc" value="$!{nisAllocationReqPage.payerAcc}">
                <input type="text" id="payerAcc" name="payerAcc" data-name="payerAcc" data-biz-name="payerAcc" lay-verify="required"
                       class="layui-input bt-biz-accountTable" data-callback="accountCallBack" data-resource="netbank:allocation:typeAsk:apply"
                        value="$!{nisAllocationReqPage.payerAcc}"/>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
            <td>
                ##付款人开户行
                $!{nisAllocationReqPage.payeeBankName}
                <input type="hidden" id="payeeBankCode" >
                <input type="hidden" id="payeeBankName" name="payeeBankName"  readonly="readonly"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.payeeBankName')" value="$!{nisAllocationReqPage.payeeBankName}">
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="payerBankName"  lay-verify="required"
                           style="width:300px;" readonly="readonly"
                           autocomplete="off" class="layui-input"
                           placeholder="开户行" value="$!{nisAllocationReqPage.payerBankName}">
                </div>
##                ##收款人开户行
##                $!{nisAllocationReqPage.payerBankName}
##                <input type="hidden" id="payerBankCode" >
##                <input type="hidden" id="payerBankName" name="payerBankName"  readonly="readonly"
##                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.payerBankName')" value="$!{nisAllocationReqPage.payerBankName}">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.accName')</td>
            <td>
            ##付款人户名
                $!{nisAllocationReqPage.payeeAccName}
                <input type="hidden" id="payeeAccName" name="payeeAccName" readonly="readonly"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.payeeAccName')" value="$!{nisAllocationReqPage.payeeAccName}">
            </td>
            <td class="textRight">#springMessage('table.nisAllocationReq.accName')</td>
            <td>
##            ##收款人户名
##                $!{nisAllocationReqPage.payerAccName}
##                <input type="hidden" id="payerAccName" name="payerAccName" readonly="readonly"
##                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.payerAccName')" value="$!{nisAllocationReqPage.payerAccName}" >
                <div class="layui-input-inline">
                    <input type="text" id="payerAccName" name="payerAccName" lay-verify="required"
                           style="width:300px;" readonly="readonly"
                           autocomplete="off" class="layui-input"
                           placeholder="户名" value="$!{nisAllocationReqPage.payerAccName}">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">账户当前余额</td>
            <td>
                $!number.formatNumeric($!{payeeBal})
            </td>
            <td class="textRight" colspan="2">账户当前余额</td>
            <td>
                <div id="balDiv">
                    $!number.formatNumeric($!{bal})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">账户可用余额</td>
            <td>
                $!number.formatNumeric($!{payeeAvailbal})
            </td>
            <td class="textRight" colspan="2">账户可用余额</td>
            <td>
                <div id="availbalDiv">
                    $!number.formatNumeric($!{availbal})
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.curId')</td>
            <td>
            ##币别
                $!{nisAllocationReqPage.curName}
                <input type="hidden" id="curName" name="curName" readonly="readonly"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.curId')"  value="$!{curName}">
            </td>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.purpose')</td>
            <td>
                $!{nisAllocationReqPage.purpose}
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.money.lower')</td>
            <td>
            ##金额（小写）
                <input type="text"data-name="money" data-biz-name="money" lay-verify="required|number2" class="layui-input bt-biz-moneyType" style="text-align:right"
                       data-toUp="moneyUp" autocomplete="off" placeholder="#springMessage('table.nisAllocationReq.money.lower')" value="$!{nisAllocationReqPage.money}">
            </td>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.money.upper')</td>
            <td>
            ##金额（大写）
                <div id="moneyUp" name="moneyUp" readonly="readonly" data-name="moneyUp"
                     autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.money.upper')">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.wishPayday')</td>
            <td>
            ##期望支付日期
                $!date.format('yyyy-MM-dd',$!{nisAllocationReqPage.wishPayday})
                <div class="layui-input-inline">
                    <input type="hidden" name="wishPayday" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!{nisAllocationReqPage.wishPayday})"
                           data-type="date" data-min="$!date.format('yyyy-MM-dd',$!{date.getDate()})" data-biz-name="wishPayday" lay-verify="date" data-callback="dateCallBack">
                </div>
            </td>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.isQuick')</td>
            <td>
            ##是否加急
                $dictTag.get("sf_yn",$!{nisAllocationReqPage.isQuick})
            </td>
        </tr>
        <tr>
            <td class="textRight" colspan="2">#springMessage('table.nisAllocationReq.difBank')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.difBank"
                     data-defaultvalue="$!{nisAllocationReqPage.difBank}" data-name="difBank" data-biz-name="difBank"
                     data-required="true"></div>
            </td>
            <td class="textRight" colspan="2">#springMessage('table.nisBillhead.areaSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.areaSign"
                     data-defaultvalue="$!{nisAllocationReqPage.areaSign}" data-name="areaSign" data-biz-name="areaSign"
                     data-required="true"></div>
            </td>
        </tr>
            ##备注说明
            <td class="textRight" colspan="2">#springMessage('table.settlement.rmk')</td>
            <td width="20%" colspan="4">
                <div class="layui-input-inline">
                    <textarea class="layui-textarea" style="resize:none" cols="80" rows="2" disabled="true">$!{nisAllocationReqPage.rmk}</textarea>
                </div>
            </td>
        </tr>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="$!{nisAllocationReqPage.status}">#springMessage('common.button.submit')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <!-- 收方内部账户信息 -->
    <table id="appTable" class="layui-table layui-form layui-table-border" style="width:100%;" data-btns="print">
        <thead>
        <tr>
            <th>#springMessage('fcAccBalanceQuery.account')</th>
            <th>#springMessage('fcAccBalanceQuery.accName')</th>
            <th>#springMessage('fcAccBalanceQuery.subjectId')</th>
            <th>#springMessage('fcAccBalanceQuery.curId')</th>
            <th>当前留存余额</th>
            <th>留存可用余额</th>
            <th>#springMessage('fcAccBalanceQuery.overdraftMoney')</th>
            <th>#springMessage('fcAccBalanceQuery.accOpenTime')</th>
            <th>#springMessage('fcAccBalanceQuery.deadlineDate')</th>
            <th>#springMessage('fcAccBalanceQuery.interestRate')</th>
        </tr>
        </thead>
        <tr>
            <td>$!{payeeCounterAcc.account}</td>
            <td><span id="payeeCounterAccName">$!{payeeCounterAcc.accName}</span></td>
            <td><span id="subjectName">$!{payeeCounterAcc.subjectName}</span></td>
            <td><span id="payeeCounterCurName">$!{payeeCounterAcc.curName}</span></td>
            <td class="textRight"><span id="checkBalance">$!number.formatNumeric($!{payeeCounterAcc.checkBalance})</span></td>
            <td class="textRight"><span id="availableBalance">$!number.formatNumeric($!{payeeCounterAcc.availableBalance})</span></td>
            <td class="textRight"><span id="overdraftMoney">$!number.formatNumeric($!{payeeCounterAcc.overdraftMoney})</span></td>
            <td><span id="accOpenTime">$!date.format('yyyy-MM-dd',$!{payeeCounterAcc.accOpenTime})</span></td>
            <td><span id="deadlineDate">$!date.format('yyyy-MM-dd',$!{payeeCounterAcc.deadlineDate})</span></td>
            <td class="textRight"><span id="interestRate">$!rateTag.show($!{payeeCounterAcc.interestRate})</span></td>
        </tr>
    </table>
    <!-- 资金计划 -->
    <div id="tagItemDetail"></div>
    <!-- 日志 -->
    <div id="tagMsg"></div>
    <!-- 附件上传 -->
    <input id="attachmentId" name="attachmentId" type="hidden" value="$!{nisAllocationReqPage.attachmentId}">
    <div id="uploader" class="layui-input-inline" style="width:100%"></div>
    #caDataHidden()
</form>
    #parse("views/common/footer.vm")
    #caDataScript()
</body>
<script src="${basePath}/static/modules/allocation/nisAllocationReq.common.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/allocation/nisAskAllocationReq.approveEdit.js?_btv=${resourceVersion}"></script>
</html>
<li class="mui-table-view-cell  mui-collapse keep-unfold">
    <a class="mui-navigate-right" href="#">
        #springMessage('table.nisAllocationReq.payerAcc')
        <span class="mui-badge mui-badge-inverted" style="display: block;word-break: break-all;padding:0;margin: 0;white-space:normal;">
            $!{nisAllocationReqPage.payerAcc}
        </span>
    </a>
    <ul class="mui-table-view H-theme-background-color-white">
        <li class="mui-table-view-cell">
            #springMessage('table.nisAllocationReq.corp')
            <span class="mui-badge mui-badge-inverted">
                $!{nisAllocationReqPage.payerCorpName}
            </span>
        </li>
##        #if($!{nisAllocationReqPage.type} == 11)

##        #end
        #if($!{nisAllocationReqPage.type} == 13)
            <li class="mui-table-view-cell">
                #springMessage('table.nisAllocationReq.accBalance')
                <span class="mui-badge mui-badge-inverted">
                    $!number.formatNumeric($!{nisAllocationReqPage.payerAccBalance})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.nisAllocationReq.fcAccBalance')
                <span class="mui-badge mui-badge-inverted" id="payerFcAccBalance">
                    $!number.formatNumeric($!{nisAllocationReqPage.payerFcAccBalance})
            </span>
            </li>
        #end
        <li class="mui-table-view-cell">
            #springMessage('table.nisAllocationReq.bankName')
            <span class="mui-badge mui-badge-inverted">
                $!{nisAllocationReqPage.payerBankName}
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.nisAllocationReq.accName')
            <span class="mui-badge mui-badge-inverted">
                $!{nisAllocationReqPage.payerAccName}
            </span>
        </li>
        #if($!{nisAllocationReqPage.type} == 13)
            <li class="mui-table-view-cell">
                #springMessage('table.nisAllocationReq.provCity')
                <span class="mui-badge mui-badge-inverted" id="payerProvCity">
                    $!{nisAllocationReqPage.payerProvCity}
                </span>
            </li>
        #end
    </ul>
</li>

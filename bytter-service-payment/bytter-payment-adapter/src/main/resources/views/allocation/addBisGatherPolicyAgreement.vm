<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ## 单位
            <td class="textRight" >#springMessage('单位')</td>
            <td >
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-tree-type="check"
                         data-type="selectTree"
                         data-name="corpId"
                         data-scope="all"
                         data-biz-name="corpId"
                         data-resource="allocation:bisgatherpolicy:agreement:query"
                         data-defaultvalue=""></div>
                </div>
            </td>
            ## 是否签订协议
            <td class="textRight">#springMessage('是否签订协议')</td>
            <td >
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="isAgreement" ></div>
            </td>

        </tr>

        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script >
    bt.use(['form', 'layedit', 'dateType', 'selectTree', 'moneyType', 'corp', 'selectType', 'dicts','selectTable'], function () {
        var $ = bt.jquery, form = bt.form();
        bt.corp.init();
        bt.dicts.init();

        //监听提交
        form.on('submit(submit)', function (data) {
            var action = "/allocation/bisgatherpolicy/saveAgreement";
            $.post(basePath + action,data.field,function(result){
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                if (result.success){
                    parent.layer.closeAll();
                }
            },'JSON');
            return false;
        });


    });

</script>
</html>

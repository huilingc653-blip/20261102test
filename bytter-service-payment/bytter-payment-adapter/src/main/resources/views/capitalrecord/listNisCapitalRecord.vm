<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
        ##所属单位
            <td class="textRight">#springMessage("nis.capitalRecord.table.resetAcceptor")</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-resource="netbank:netBank:nisCapitalRecord:query"
                         data-biz-name="eqs_corpId"
                         data-scope="all">
                    </div>
                </div>
            </td>
        ##收款单位
            <td class="textRight">#springMessage("nis.capitalRecord.table.payeeAccName")</td>
            <td width="20%">
                <div class="layui-input-inline" id="payeeAccDiv">
                    <input type="text" id="eqs_payeeAccName" name="eqs_payeeAccName" data-name="eqs_payeeAccName" readonly
                           autocomplete="off" class="layui-input" placeholder="#springMessage('nis.capitalRecord.table.payeeAccName')">
                    <div class="bt-div-search">
                        <button  class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button" data-beforeClick="bt.externalCorpBankAccParams" data-callback="bt.externalCorpCallback" title="#springMessage('common.button.select')">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        ##金额
            <td class="textRight">#springMessage("nis.capitalRecord.table.payMoney")</td>
            <td width="20%">
                <div class="layui-inline">
                    <input type="text" data-name="geg_payMoney" name="geg_payMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('nis.capitalRecord.table.payMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_payMoney" name="leg_payMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('nis.capitalRecord.table.payMoney')">
                </div>
            </td>
        </tr>
        <tr>
        ##期望支付日期
            <td class="textRight">#springMessage("nis.capitalRecord.table.wishPayDay")</td>
            <td width="20%">
                <input type="text" name="ged_wishPayDay" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_wishPayDay">
                <span class="date-mid">~</span>
                <input type="text" name="led_wishPayDay" class="layui-input bt-input-inline bt-biz-dateType" id="led_wishPayDay">
            </td>
        ##付款方式
            <td class="textRight">#springMessage("nis.capitalRecord.table.voucherType")</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="select" data-group="capitalRecord.voucerType"
                     data-name="eqs_voucherType" data-biz-name="eqs_voucherType" id="eqs_voucherType"></div>
            </td>
        ##合同名称
            <td class="textRight">#springMessage("nis.capitalRecord.table.contractName")</td>
            <td width="20%">
                <input type="text" id="likes_contractName" name="likes_contractName" data-name="likes_contractName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage("nis.capitalRecord.table.contractName")">
            </td>
        </tr>
        <tr>
        ##合同编号
            <td class="textRight">#springMessage("nis.capitalRecord.table.contractCode")</td>
            <td width="20%">
                <input type="text" id="likes_contractCode" name="likes_contractCode" data-name="likes_contractCode"
                       autocomplete="off" class="layui-input" placeholder="#springMessage("nis.capitalRecord.table.contractCode")">
            </td>
        ##结算中心
            <td class="textRight">#springMessage("nis.capitalRecord.table.netName")</td>
            <td width="20%">
                <div class="bt-biz-corp"
                     data-name="eqs_netId"
                     data-biz-type="net"
                     data-type="select"
                     data-biz-name="eqs_netId"></div>
            </td>
        ##付款事由
            <td class="textRight">#springMessage("nis.capitalRecord.table.purpose")</td>
            <td width="20%">
                <input type="text" id="likes_purpose" name="likes_purpose" data-name="likes_purpose"
                       autocomplete="off" class="layui-input" placeholder="#springMessage("nis.capitalRecord.table.purpose")">
            </td>
        </tr>
        <tr>
        ##数据状态
            <td class="textRight">#springMessage("nis.capitalRecord.table.status")</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="select" data-group="capitalRecord.status"
                     data-name="eqs_statusStr" data-biz-name="eqs_statusStr" id="eqs_status"></div>
            </td>
        ##资金备案类别
            <td class="textRight">#springMessage("nis.capitalRecord.table.busType")</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="select" data-group="capitalRecord.busType"
                     data-name="likes_busType" data-biz-name="likes_busType" id="likes_busType"></div>
            </td>
        ##
            <td class="textRight"></td>
            <td width="20%">
            </td>
        </tr>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width: 100%;">
    <thead>
    <tr>
        <th>#springMessage("nis.capitalRecord.table.resetAcceptor")</th>
        <th>#springMessage("nis.capitalRecord.table.payeeAccName")</th>
        <th>#springMessage("nis.capitalRecord.table.busType")</th>
        <th>#springMessage("nis.capitalRecord.table.payMoney")</th>
        <th>#springMessage("nis.capitalRecord.table.wishPayDay")</th>
        <th>#springMessage("nis.capitalRecord.table.projectName")</th>
        <th>#springMessage("nis.capitalRecord.table.purpose")</th>
        <th>#springMessage("nis.capitalRecord.table.voucherType")</th>
        <th>#springMessage("nis.capitalRecord.table.netName")</th>
        <th>#springMessage("nis.capitalRecord.table.contractCode")</th>
        <th>#springMessage("nis.capitalRecord.table.contractName")</th>
        <th>#springMessage("nis.capitalRecord.table.contractType")</th>
        <th>#springMessage("nis.capitalRecord.table.commitDate")</th>
        <th>#springMessage("nis.capitalRecord.table.status")</th>
        <th>#springMessage("common.table.thead.operation")</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/specail/capitalrecord/capitalrecord.list.js?_btv=${resourceVersion}"></script>
</html>
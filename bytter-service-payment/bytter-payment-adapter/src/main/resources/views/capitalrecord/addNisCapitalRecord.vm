<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <table class="layui-table">
        <input id="status" name="status" type="hidden" value="0">
        <input id="corpIdHidden" name="corpIdHidden" type="hidden" value="${corpId}">
        <input id="payeeAcc" name="payeeAcc" type="hidden">
        <input id="payeeBankCode" name="payeeBankCode" type="hidden">
        <input id="payeeBank" name="payeeBank" type="hidden">
        <tbody>
        <tr>
        ##成员单位
            <td class="textRight" width="14%">#springMessage("nis.capitalRecord.table.resetAcceptor")</td>
            <td width="36%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-resource="netbank:netBank:nisCapitalRecord:query"
                         data-biz-name="corpId"
                         data-defaultvalue="${corpId}"
                         data-scope="all"
                         data-required="true">
                    </div>
                </div>
            </td>
        ##收款单位
            <td class="textRight">#springMessage("nis.capitalRecord.table.payeeAccName")</td>
            <td>
                <div class="layui-input-inline" id="payeeAccDiv">
                    <input type="text" id="payeeAccName" name="payeeAccName" lay-verify="required" data-name="payeeAccName" readonly
                           autocomplete="off" class="layui-input" placeholder="#springMessage('nis.capitalRecord.table.payeeAccName')">
                    <div class="bt-div-search">
                        <button  class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button" data-beforeClick="bt.externalCorpBankAccParams" data-callback="bt.externalCorpCallback" title="#springMessage('common.button.select')">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
        ##金额
            <td class="textRight">#springMessage("nis.capitalRecord.table.payMoney")</td>
            <td>
                <input type="text" id="payMoney" name="payMoney" style="text-align:right" lay-verify="required" data-name="payMoney" data-biz-name="payMoney"
                       autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage("nis.capitalRecord.table.payMoney")">
            </td>
        ##期望支付日期
            <td class="textRight" width="14%">#springMessage("nis.capitalRecord.table.wishPayDay")</td>
            <td width="36%">
                <input type="text" id="wishPayDay" name="wishPayDay" data-name="wishPayDay" data-biz-name="wishPayDay" lay-verify="required"
                       class="layui-input bt-biz-dateType" data-today="true" data-type="date">
            </td>
        </tr>
        <tr>
        ##结算中心
            <td class="textRight">#springMessage("nis.capitalRecord.table.netName")</td>
            <td>
                <div class="bt-biz-corp"
                     data-name="netId"
                     data-biz-type="net"
                     data-type="select"
                     data-required="true"
                     data-biz-name="netId"></div>
            </td>
        ##付款方式
            <td class="textRight">#springMessage("nis.capitalRecord.table.voucherType")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="capitalRecord.voucerType" data-defaultvalue="1"
                     data-name="voucherType" data-biz-name="voucherType" id="voucherType"></div>
            </td>
        </tr>
        <tr>
        ##资金备案类别
            <td class="textRight">#springMessage("nis.capitalRecord.table.busType")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="capitalRecord.busType" data-defaultvalue="1" data-required="true"
                     data-name="busType" data-biz-name="busType" id="busType"></div>
            </td>
        ##付款事由
            <td class="textRight">#springMessage("nis.capitalRecord.table.purpose")</td>
            <td>
                <input type="text" id="purpose" name="purpose" data-name="purpose"
                       autocomplete="off" class="layui-input" placeholder="#springMessage("nis.capitalRecord.table.purpose")">
            </td>
        </tr>
        <tr>
        ##项目名称
            <td class="textRight">#springMessage("nis.capitalRecord.table.projectName")</td>
            <td>
                <input type="text" id="projectName" name="projectName" data-name="projectName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage("nis.capitalRecord.table.projectName")">
            </td>
        ##合同编号
            <td class="textRight">#springMessage("nis.capitalRecord.table.contractCode")</td>
            <td>
                <input type="text" id="contractCode" name="contractCode" data-name="contractCode"
                       autocomplete="off" class="layui-input" placeholder="#springMessage("nis.capitalRecord.table.contractCode")">
            </td>
        </tr>
        <tr>
        ##合同名称
            <td class="textRight">#springMessage("nis.capitalRecord.table.contractName")</td>
            <td>
                <input type="text" id="contractName" name="contractName" data-name="contractName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage("nis.capitalRecord.table.contractName")">
            </td>
            <td class="textRight">#springMessage("nis.capitalRecord.table.contractType")</td>
            <td>
                <input type="text" id="contractType" name="contractType" data-name="contractType"
                       autocomplete="off" class="layui-input" placeholder="#springMessage("nis.capitalRecord.table.contractType")">
            </td>
        </tr>

        <tr>
        ##附件
            <td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage("table.choProductReq.attachmentId")</td>
            <td colspan="3">
                <input id="attachmentId" name="attachmentId" type="hidden" value="$!{choProductReqPage.attachmentId}">
                <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="1">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/specail/capitalrecord/capitalrecord.add.js?_btv=${resourceVersion}"></script>
</html>
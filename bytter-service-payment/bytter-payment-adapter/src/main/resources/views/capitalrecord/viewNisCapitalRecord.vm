<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <table class="layui-table">
        <thead>
        <tr>
            <th colspan="4" style="text-align:center">#springMessage("nis.capitalRecord.table.view")</th>
        </tr>
        </thead>
        <tbody>
        <tr>
        ##成员单位
            <td class="textRight" width="20%">#springMessage("nis.capitalRecord.table.resetAcceptor")</td>
            <td width="30%">$!{nisCapitalRecordPage.corpName}</td>
        ##收款单位
            <td class="textRight">#springMessage("nis.capitalRecord.table.payeeAccName")</td>
            <td>$!{nisCapitalRecordPage.payeeAccName}</td>
        </tr>
        <tr>
        ##金额
            <td class="textRight">#springMessage("nis.capitalRecord.table.payMoney")</td>
            <td>$!number.formatNumeric($!{nisCapitalRecordPage.payMoney})</td>
        ##期望支付日期
            <td class="textRight" width="14%">#springMessage("nis.capitalRecord.table.wishPayDay")</td>
            <td width="36%">$!{nisCapitalRecordPage.wishPayDay}</td>
        </tr>
        <tr>
        ##结算中心
            <td class="textRight">#springMessage("nis.capitalRecord.table.netName")</td>
            <td>$!{nisCapitalRecordPage.netName}</td>
        ##付款方式
            <td class="textRight">#springMessage("nis.capitalRecord.table.voucherType")</td>
            <td>$dictTag.get("capitalRecord.voucerType",$!{nisCapitalRecordPage.voucherType})</td>
        </tr>
        <tr>
        ##资金备案类别
            <td class="textRight">#springMessage("nis.capitalRecord.table.busType")</td>
            <td>$dictTag.get("capitalRecord.busType",$!{nisCapitalRecordPage.busType})</td>
        ##付款事由
            <td class="textRight">#springMessage("nis.capitalRecord.table.purpose")</td>
            <td>$!{nisCapitalRecordPage.purpose}</td>
        </tr>
        <tr>
        ##项目名称
            <td class="textRight">#springMessage("nis.capitalRecord.table.projectName")</td>
            <td>$!{nisCapitalRecordPage.projectName}</td>
        ##合同编号
            <td class="textRight">#springMessage("nis.capitalRecord.table.contractCode")</td>
            <td>$!{nisCapitalRecordPage.contractCode}</td>
        </tr>
        <tr>
        ##合同名称
            <td class="textRight">#springMessage("nis.capitalRecord.table.contractName")</td>
            <td>$!{nisCapitalRecordPage.contractName}</td>
            <td class="textRight">#springMessage("nis.capitalRecord.table.contractType")</td>
            <td>$!{nisCapitalRecordPage.contractType}</td>
        </tr>
        </tbody>
    </table>
    ##附件
    <input id="attachmentId" name="attachmentId" type="hidden" value="$!{nisCapitalRecordPage.attachmentId}">
    <div id="uploader" class="layui-input-inline" style="width:100%"></div>
</form>
    #parse("views/common/footer.vm")
</body>

<script>
    bt.use(['btUpload'], function () {
        var up = bt.btUpload.init({
            elem: "#uploader",
            auto: false,
            hasDelete: false,
            hasUpload: false,
            isExpand: true,
            gid: $("#attachmentId").val()
        });
    })
</script>
</html>
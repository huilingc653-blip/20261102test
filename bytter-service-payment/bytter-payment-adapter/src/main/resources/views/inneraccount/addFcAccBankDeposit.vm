<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.accInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td class="textRight" width="10%">#springMessage('table.fcAcc.accOpenTime')</td>
        <td width="40%">##开户日期
            <div class="layui-input-inline">
                <input type="text" name="accOpenTime"  readonly="readonly" data-today="true" class="layui-input bt-biz-dateType" >
            </div>
        </td>
        <td class="textRight" width="10%">#springMessage('table.fcAcc.accStartDate')</td>
        <td width="40%">##启用日期
            <div class="layui-input-inline">
                <input type="text" name="accStartDate" data-name="accStartDate" data-biz-name="accStartDate" lay-verify="required" data-endid="t2" data-min="$!{accStartDate}"
                       value="$!{accStartDate}" class="layui-input bt-biz-dateType"  data-callback="accStartDateCallback">
            </div>
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.relationAcc')</td>
        <td>##关联活期账号
            <div class="layui-inline">
                <select name="relationAcc" id="relationAcc">
                    <option></option>
                </select>
            </div>
        </td>
        <td></td>
        <td></td>
    </tr>
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.interestInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td class="textRight" width="10%">#springMessage('table.fcAcc.interestSign')</td>
        <td width="40%">##计息标志
            <div class="layui-inline">
                <input type="radio" lay-filter="interestSign" name="interestSign" value="1" title="#springMessage('table.fcAcc.interestSignOk')">
                <input type="radio" lay-filter="interestSign" name="interestSign" value="0" title="#springMessage('table.fcAcc.interestSignNo')" checked >
            </div>
        </td>
        <td class="textRight" width="10%">#springMessage('table.fcAcc.predrawSign')</td>
        <td width="40%">##预提标志
            <div class="layui-inline">
                <select lay-filter="predrawSign" name="predrawSign">
                    <option value=""></option>
                </select>
            </div>
        </td>
    </tr>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.notifyType')</td>
        <td width="40%">##通知类型
            <div class="layui-inline">
                <select lay-filter="notifyType" name="notifyType" lay-verify="required">
                    #foreach($dict in $dictTag.list("fcAcc.notifyType"))
                        <option value="$dict.code">$dict.name</option>
                    #end

                </select>
            </div>
        </td>
        ##起息日期
        <td class="textRight">#springMessage('table.fcAcc.interestStartDate')</td>
        <td>
            <div class="layui-input-inline">
                <input type="text" name="interestStartDate" lay-verify="required" id="t2"  class="layui-input bt-biz-dateType" >
            </div>
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.interestRate')</td>
        <td>##利率
            <input type="text" id="interestRate" name="interestRate" value="$!{interestRate}"

                       autocomplete="off" class="layui-input bt-biz-rateType" data-biz-name="interestRate" placeholder="#springMessage('table.fcAcc.interestRate')">
            </td>
            <td></td>
            <td></td>
       </tr>
        <tr id="showAcc" style="display: none">
	    ##应付利息账号
            <td class="textRight">#springMessage('table.fcAcc.interestPayAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="interestRecPay" name="interestRecPay" lay-verify="tableData" data-biz-name="interestRecPay"
                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fcAcc.interestPayAcc')">
                    <table id="interestRecPayTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.fcAcc.blnctrAcc')</th>##内部账号
                            <th>#springMessage('table.fcAcc.accName')</th>##账户名称
                            <th>#springMessage('table.fcAcc.subjectId')</th>##科目名称
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
            ##利息支出账号
            <td class="textRight">#springMessage('table.fcAcc.interestoutExp')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="interestInExp" name="interestInExp" lay-verify="tableData" data-biz-name="interestInExp"
                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fcAcc.interestoutExp')">
                    <table id="interestInExpTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.fcAcc.blnctrAcc')</th>##内部账号
                            <th>#springMessage('table.fcAcc.accName')</th>##账户名称
                            <th>#springMessage('table.fcAcc.subjectId')</th>##科目名称
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
        </tr>
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('cms.loan.OtherInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.overdraftRate.pre')</td>
        <td width="40%">##提前利率
            <input type="text" id="overdraftRate" name="overdraftRate"
                   autocomplete="off" class="layui-input bt-biz-rateType" data-biz-name="overdraftRate" placeholder="#springMessage('table.fcAcc.overdraftRate')">
        </td>
        ##备注
        <td class="textRight" width="10%">#springMessage('table.fcInitAcc.rmk')</td>
        <td width="40%">
            <input type="text" class="layui-input" id="rmk" name="rmk"/>
        </td>
    </tr>
    </tbody>
</table>

<script src="${basePath}/static/modules/inneraccount/fcAcc.common.dynamic.add.js?_btv=${resourceVersion}"></script>
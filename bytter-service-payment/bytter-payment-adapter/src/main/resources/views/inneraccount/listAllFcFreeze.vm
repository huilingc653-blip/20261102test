<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="opType" id="opType" value="S"/>
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.blnctrAcc')</td>
            <td width="25%">
                <div class="layui-inline">
                    <input type="text" name="likes_blnctrAcc"
                           autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.fcAcc.blnctrAcc')">
                </div>
            </td>
            <td class="textRight">#springMessage('table.fcAcc.netId')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="net"
                         data-type="selectTree"
                         data-name="eqs_netId"
                         data-group="corpGroup"
                         data-change="ins_corpId"
                         data-resource="netbank:innerAccount:fcFreeze:allQuery"
                         data-tree-type="radio"
                         data-scope="net"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-resource="netbank:innerAccount:fcFreeze:allQuery"
                         data-tree-type="check"
                         data-tips="#springMessage('common.placeholder.select')#springMessage('table.fcAcc.netId')"
                         data-group="corpGroup"
                         data-name="ins_corpId"
                         data-scope="all"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name="eqs_curId" data-biz-name="eqs_curId" data-valueField="id" data-textField="curName"></div>
            </td>
            <td class="textRight">#springMessage('table.fcFreeze.freezeSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="innerAccount.freezeSign" data-name="eqs_freezeSign"></div>
            </td>
            <td class="textRight">#springMessage('table.fcFreeze.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="fcfreeze.status" data-name="eqi_status" data-displayData="0,-1,11,95"></div>

            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
##                #if($shiro.hasPermission("netbank:innerAccount:fcFreeze:allQuery"))
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
##                #end
            </td>
        </tr>
        </tbody>
    </table>

</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcAcc.blnctrAcc')</th>
        <th>#springMessage('table.fcAcc.accName')</th>
        <th>#springMessage('table.fcAcc.netId')</th>
        <th>#springMessage('table.fcAcc.corpId')</th>
        <th>#springMessage('table.fcAcc.curId')</th>
        <th>#springMessage('table.fcFreeze.freezeNo')</th>
        <th>#springMessage('table.fcFreeze.oldFreezeNo')</th>
        <th>#springMessage('table.fcFreeze.freezeSign')</th>
        <th>#springMessage('table.fcFreeze.freezeType')</th>
        <th>#springMessage('table.fcFreeze.freezeOrUnFreezeMoney')</th>
        <th>#springMessage('table.fcFreeze.accuFreezeMoney')</th>
        <th>#springMessage('table.fcFreeze.operator')</th>
        <th>#springMessage('table.fcFreeze.checkerCode')</th>
        <th>#springMessage('table.fcFreeze.beginDate')</th>
        <th>#springMessage('table.fcFreeze.endDate')</th>
        <th>#springMessage('table.fcFreeze.operateTime')</th>
        <th>#springMessage('table.fcFreeze.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/inneraccount/fcFreeze.listAll.js?_btv=${resourceVersion}"></script>
</html>

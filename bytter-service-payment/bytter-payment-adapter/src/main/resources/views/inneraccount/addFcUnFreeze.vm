<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <input id="updateDate" name="updateDate" type="hidden" value="$!{fcFreezePage.updateDate}">
        <input id="id" name="id" type="hidden" value="$!{fcFreezePage.id}">
        <input id="unFreezeId" name="unFreezeId" type="hidden" value="$!{fcFreezePage.unFreezeId}">
        <input id="createBy" name="createBy" type="hidden" value="$!{fcFreezePage.createBy}">
        <input id="createDate" name="createDate" type="hidden" value="$!{fcFreezePage.createDate}">
        <input id="updateBy" name="updateBy" type="hidden" value="$!{fcFreezePage.updateBy}">
        <input id="freezeSign" name="freezeSign" type="hidden" value="T">
        <input id="accuFreezeMoney" name="accuFreezeMoney" type="hidden" value="0">
        <input id="opType" name="opType" type="hidden" value="A">
        <table class="layui-table">
			<tbody>
            <tr>
			##网点
                <td class="textRight">#springMessage('table.fcAcc.netId')</td>
                <td width="40%">
                    <div class="layui-inline">
                    	<div class="bt-biz-corp"
                         data-biz-type="net"
                         data-type="selectTree"
                         data-name="netId"
                         data-group="corpGroup"
                         data-change="corpId"
                         data-resource="netbank:innerAccount:fcFreeze:unApply"
                         data-callbackData="netChange"
                         data-scope="net"></div>
                    </div>
                </td>
			##单位
                <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
                <td width="40%">
                    <div class="layui-inline">
                   		 <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-tips="#springMessage('common.placeholder.select')#springMessage('table.fcAcc.netId')"
                         data-group="corpGroup"
                         data-resource="netbank:innerAccount:fcFreeze:unApply"
                         data-callbackData="corpChange"
                         data-scope="all"></div>
                    </div>
                </td>
            </tr>
        	<tr>
        		##账号
				<td class="textRight">#springMessage('table.fcFreeze.blnctrAcc')</td>
				<td>
                    <div class="layui-input-inline">
                        <input type="text" name="blnctrAcc" id="blnctrAcc" data-biz-name="blnctrAcc" class="layui-input text" autocomplete="off">
                        <table id="blnctrAccTable" class="hide">
                            <thead>
                            <tr>
                                <th>#springMessage('table.fcAcc.blnctrAcc')</th>
                                <th>#springMessage('table.fcFreeze.freezeType')</th>
                                <th>#springMessage('table.fcFreeze.freezeMoney')</th>
                                <th>#springMessage('table.fcFreeze.unFreezeMoney')</th>
                                <th>#springMessage('table.fcFreeze.beginDate')</th>
                                <th>#springMessage('table.fcFreeze.endDate')</th>
                                <th>#springMessage('table.fcFreeze.freezeNo')</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </td>
				##通知书编号
                    <td class="textRight">#springMessage('table.fcFreeze.freezeNo')</td>
                    <td >
                        <!--number-->
                        <input type="text" id="freezeNo" name="freezeNo"
                               autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="20" placeholder="#springMessage('table.fcFreeze.freezeNo')">
                    </td>


			</tr>
        	<tr>
        		##币别
				<td class="textRight">#springMessage('table.fcAcc.curId')</td>
				<td ><span id="curNameSpan"></span><input type="hidden" id="curName" data-name="curName" class="input-noborder" readonly="readonly"></td>
				<td class="textRight">#springMessage('table.fcAcc.accName')</td>
				<td ><span id="accNameSpan"></span><input type="hidden" id="accName" data-name="accName" class="input-noborder" readonly="readonly"></td>

            </tr>
        	<tr>
				##冻结类型
                <td class="textRight">#springMessage('table.fcFreeze.freezeType')</td>
                <td ><input type="hidden" id="freezeType" name="freezeType" >
                <span id="freezeTypeName"></span></td>


                <td class="textRight">#springMessage('table.fcFreeze.freezeMoney')</td>
                 <td>
                 ##可解冻金额
                    <input type="hidden" id="unFreezeMoney" name="unFreezeMoney">
                 ##冻结金额
                    <span id="freezeMoneyShow" name="freezeMoneyShow" ></span>
                 </td>

            </tr>
            <tr>
            ##冻结开始时间
                <td class="textRight">#springMessage('table.fcFreeze.beginDate')</td>
                <td >
                    <input type="text" name="beginDate" class="layui-input bt-biz-dateType" readonly="readonly" value="$!{fcFreezePage.beginDate}" data-type="date" data-biz-name="beginDate">
                </td>
            ##冻结结束时间
                <td class="textRight">#springMessage('table.fcFreeze.endDate')</td>
                <td >
                     <input type="text" name="endDate" class="layui-input bt-biz-dateType" readonly="readonly" value="$!{fcFreezePage.endDate}" data-type="date" data-biz-name="endDate">
                </td>
            </tr>
            <tr>
            ##解冻金额
                <td class="textRight">#springMessage('table.fcFreeze.unfreezeMoney.yes')</td>
                <td >
                    <!--number-->
                    <input type="text" id="freezeMoney" name="freezeMoney" lay-verify="required"
                           autocomplete="off" class="layui-input bt-biz-moneyType" data-biz-name="freezeMoney" data-min="0.01" placeholder="#springMessage('table.fcFreeze.unFreezeMoney')">
                </td>
            ##解冻机构
                <td class="textRight">#springMessage('table.fcFreeze.unfreezeOrg')</td>
                <td >
                    <!--number-->
                    <input type="text" id="freezeOrg" name="freezeOrg"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcFreeze.unfreezeOrg')">
                </td>
            </tr>

        	<tr>
        		##执行人公务证
				<td class="textRight">#springMessage('table.fcFreeze.execOfficialNo')</td>
				<td >
						<!--number-->
                        <input type="text" id="execOfficialNo" name="execOfficialNo" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcFreeze.execOfficialNo')">
										</td>
        		##执行人省份证
				<td class="textRight">#springMessage('table.fcFreeze.execCardNo')</td>
				<td >
						<!--number-->
                        <input type="text" id="execCardNo" name="execCardNo" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcFreeze.execCardNo')">
										</td>
            </tr>
        	<tr>
        		##解冻原因
				<td class="textRight">#springMessage('table.fcFreeze.unfreezeReason')</td>
				<td >
                    <textarea placeholder="#springMessage('table.fcFreeze.unfreezeReason')" rows=4 cols=64 class="layui-textarea" id="freezeReason" name="freezeReason"></textarea>

            </tr>
				<tr>
					<td colspan="6" style="text-align: center;">
                        <button class="layui-btn" type="button" lay-submit="" value="0" lay-filter="submit">#springMessage('common.button.temp')</button>
						<button class="layui-btn" type="button" lay-submit="" value="11" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
##    <div id="tagFcFreeze">
##        <table id ="dyncTable" width="100%" border="0" cellpadding="0" cellspacing="0" class="layui-table">
##            <thead>
##                <tr class="title">
##                    <td width="10%">#springMessage('table.fcFreeze.freezeNo')</td>
##                    <td width="10%">#springMessage('table.fcFreeze.beginDate')</td>
##                    <td width="10%">#springMessage('table.fcFreeze.endDate')</td>
##                    <td width="15%">#springMessage('table.fcFreeze.freezeMoney')</td>
##                    <td width="10%">#springMessage('table.fcFreeze.freezeType')</td>
##                    <td width="35%">#springMessage('table.fcFreeze.freezeReason')</td>
##                </tr>
##            </thead>
##            <tbody></tbody>
##	    </table>
##    </div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/inneraccount/fcUnFreeze.add.js?_btv=${resourceVersion}"></script>
</html>
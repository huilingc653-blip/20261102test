<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="poolSign" id="poolSign" value="$!{poolSign}"/>
    <table class="layui-table">
        <tbody>
        #if($!{poolSign} == "1")
        ##单位
        <td class="textRight">#springMessage('fcAccBalanceQuery.corpId')</td>
        <td width="40%">
            <div class="layui-inline">
                <div class="bt-biz-corp"
                     data-tree-type="check"
                     data-biz-type="corp"
                     data-type="selectTree"
                     data-name="ins_corpId"
                     data-resource="netbank:innerAccount:fcAccBalance:pool:query"
                     data-scope="corp"></div>
            </div>
        </td>
        ##科目
        <td class="textRight">#springMessage('fcAccBalanceQuery.subjectId')</td>
        <td width="40%">
            <div class="layui-inline">
                <div class="bt-biz-selectType" data-search="true" data-beforeinit="beforeInit"
                     data-name="eqs_subjectId" data-url="${basePath}/finacial/paramconfig/FcSubjectPool/jsonValidSubjectDate"
                     data-valueField="id" data-textField="subjectName"></div>
            </div>
        </td>
        </tr>
        #else
        <tr>
        ##单位
            <td class="textRight">#springMessage('fcAccBalanceQuery.corpId')</td>
            <td width="40%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-resource="netbank:innerAccount:fcAccBalance:query"
                         data-scope="all"></div>
                </div>
            </td>
        ##科目
            <td class="textRight">#springMessage('fcAccBalanceQuery.subjectId')</td>
            <td width="40%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-search="true" data-beforeinit="beforeInit"
                         data-name="eqs_subjectId" data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSubjectDate"
                         data-valueField="id" data-textField="subjectName"></div>
                </div>
            </td>
        </tr>
        #end
        <tr>
        ##账号
            <td class="textRight">#springMessage('fcAccBalanceQuery.account')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="likes_account" name="likes_account"
                           autocomplete="off" class="layui-input bank" placeholder="#springMessage('fcAccBalanceQuery.account')">
                </div>
            </td>
        ##币别
            <td class="textRight">#springMessage('fcAccBalanceQuery.curId')</td>
            <td>
                <div class="bt-biz-selectType" data-search="true" data-name="eqs_curId"
                     data-url="${basePath}/basic/business/btcurrency/json" data-valueField="id"
                     data-textField="curName"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                #if($shiro.hasPermission("netbank:innerAccount:fcAccBalance:query") || $shiro.hasPermission("netbank:innerAccount:fcAccBalance:pool:query"))
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                #end
            </td>
        </tr>
        </tbody>
    </table>

</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="print">
    <thead>
    <tr>
        <th>#springMessage('fcAccBalanceQuery.account')</th>
        <th>#springMessage('fcAccBalanceQuery.accName')</th>
        <th>#springMessage('fcAccBalanceQuery.subjectId')</th>
        <th>#springMessage('fcAccBalanceQuery.curId')</th>
        <th>#springMessage('fcAccBalanceQuery.onlineBalance')</th>
        <th>#springMessage('fcAccBalanceQuery.availableBalance')</th>
        <th>#springMessage('fcAccBalanceQuery.overdraftMoney')</th>
        <th>#springMessage('fcAccBalanceQuery.accOpenTime')</th>
        <th>#springMessage('fcAccBalanceQuery.deadlineDate')</th>
        <th>#springMessage('fcAccBalanceQuery.interestRate')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/inneraccount/fcAccBalanceQuery.list.js?_btv=${resourceVersion}"></script>
</html>

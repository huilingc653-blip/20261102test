<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{fcFreezePage.id}">
    <input id="unFreezeId" name="unFreezeId" type="hidden" value="$!{fcFreezePage.unFreezeId}">
    <input id="createBy" name="createBy" type="hidden" value="$!{fcFreezePage.createBy}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{fcFreezePage.updateBy}">
    <input id="freezeSign" name="freezeSign" type="hidden" value="C">
    <input id="freezeEndSign" name="freezeEndSign" type="hidden" value="0">
    <input id="opType" name="opType" type="hidden" value="M">
    <table class="layui-table">
        <tbody>
        <tr>
        ##网点
            <td class="textRight">#springMessage('table.fcAcc.netId')</td>
            <td >&nbsp;
                ($!{netCode})$!{fcFreezePage.netName}
            </td>

        ##单位
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            <td >&nbsp;($!{corpCode})$!{fcFreezePage.corpName}
            </td>

        </tr>
        <tr>
        ##账号
            <td class="textRight">#springMessage('table.fcFreeze.blnctrAcc')</td>
            <td width="40%">&nbsp;$!{fcFreezePage.blnctrAcc}
                <input type="hidden" name="blnctrAcc" id="blnctrAcc" value="$!{fcFreezePage.blnctrAcc}"/>
            </td>
		##通知书编号
            <td class="textRight">#springMessage('table.fcFreeze.freezeNo')</td>
            <td >
                <!--number-->
                <input type="text" id="freezeNo" lay-verify="required" name="freezeNo"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcFreeze.freezeNo')" value="$!{fcFreezePage.freezeNo}">
            </td>


        </tr>
        <tr>
		##币别
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td ><span id="curNameSpan">$!{fcFreezePage.curName}</span><input type="hidden" id="curName" data-name="curName" class="input-noborder" readonly="readonly" value="$!{fcFreezePage.curName}"></td>
            <td class="textRight">#springMessage('table.fcAcc.accName')</td>
            <td ><span id="accNameSpan">$!{fcFreezePage.accName}</span><input type="hidden" id="accName" data-name="accName" class="input-noborder" readonly="readonly" value="$!{fcFreezePage.accName}"></td>

        </tr>
        <tr>
		##可解冻金额
            <td class="textRight">#springMessage('table.btBankAccFreeze.avalBal')</td>
            <td width="40%"><span id="activeMoneySpan">$number.formatNumeric($!{fcFreezePage.activeMoney})</span><input type="hidden" id="activeMoney" data-name="activeMoney" class="input-noborder bt-biz-moneyType" readonly="readonly" value="$!{fcFreezePage.activeMoney}"></td>
		##累计冻结金额
            <td class="textRight">#springMessage('table.fcFreeze.accuFreezeMoney')</td>
            <td ><span id="accuFreezeMoneySpan">$number.formatNumeric($!{fcFreezePage.accuFreezeMoney})</span><input type="hidden" id="accuFreezeMoney" data-name="accuFreezeMoney" class="input-noborder bt-biz-moneyType" readonly="readonly" value="$!{fcFreezePage.accuFreezeMoney}"></td>

        </tr>
        <tr>
		##冻结类型
            <td class="textRight">#springMessage('table.fcFreeze.freezeType')</td>
            <td >
                <div class="layui-inline">
                <select lay-filter="freezeType" name="freezeType" lay-verify="required" >
                    <option value="">#springMessage('\common.placeholder.select')</option>
					#foreach($dict in $dictTag.list("fcFreeze.freezeType"))
                        <option value="$dict.code">$dict.name</option>
					#end

                </select>
                </div>
                <input type="hidden" name="freezeTypeHid" id="freezeTypeHid" value="$!{fcFreezePage.freezeType}"/>
            </td>
		##冻结金额
            <td class="textRight">#springMessage('table.fcFreeze.freezeMoney')</td>
            <td >
                <!--number-->
                <input type="text" id="freezeMoney" name="freezeMoney" lay-verify="required"
                       autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fcFreeze.freezeMoney')" value="$!{fcFreezePage.freezeMoney}">
            </td>
        </tr>
        <tr>
		##冻结开始时间
            <td class="textRight">#springMessage('table.fcFreeze.beginDate')</td>
            <td >
                <input type="text" name="beginDate" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{fcFreezePage.beginDate}" data-endid="tt" data-type="date">
            </td>
		##冻结结束时间
            <td class="textRight">#springMessage('table.fcFreeze.endDate')</td>
            <td >
                <input type="text" name="endDate" lay-verify="required" class="layui-input bt-biz-dateType"  value="$!{fcFreezePage.endDate}" id="tt" data-type="date">
            </td>
        </tr>
        <tr>


        </tr>

        <tr>
		##执行人公务证
            <td class="textRight">#springMessage('table.fcFreeze.execOfficialNo')</td>
            <td >
                <!--number-->
                <input type="text" id="execOfficialNo" name="execOfficialNo"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcFreeze.execOfficialNo')" value="$!{fcFreezePage.execOfficialNo}">
            </td>
		##执行人省份证
            <td class="textRight">#springMessage('table.fcFreeze.execCardNo')</td>
            <td >
                <!--number-->
                <input type="text" id="execCardNo" name="execCardNo"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcFreeze.execCardNo')" value="$!{fcFreezePage.execCardNo}">
            </td>
        </tr>
        <tr>
        ##打回原因
            <td class="textRight">#springMessage('table.fcFreeze.refuseWhy')</td>
            <td>
               $!{fcFreezePage.refuseWhy}
            </td>
			##冻结解冻机构
            <td class="textRight">#springMessage('table.fcFreeze.freezeOrg')</td>
            <td >
                <!--number-->
                <input type="text" id="freezeOrg" name="freezeOrg"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcFreeze.freezeOrg')" value="$!{fcFreezePage.freezeOrg}">
            </td>
        </tr>
        <tr>
        ##冻结解冻原因
            <td class="textRight">#springMessage('table.fcFreeze.freezeReason')</td>
            <td >
                <textarea placeholder="#springMessage('table.fcFreeze.freezeReason')" lay-verify="required"  rows=4 cols=64 class="layui-textarea" id="freezeReason" name="freezeReason">$!{fcFreezePage.freezeReason}</textarea>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" value="0" lay-filter="submit">#springMessage('common.button.temp')</button>
                <button class="layui-btn" lay-submit="" value="11" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<div id="tagFcFreeze">
    <table id ="dyncTable" width="100%" border="0" cellpadding="0" cellspacing="0" class="layui-table">
        <thead>
        <tr class="title">
            <td width="10%">#springMessage('table.fcFreeze.freezeNo')</td>
            <td width="10%">#springMessage('table.fcFreeze.beginDate')</td>
            <td width="10%">#springMessage('table.fcFreeze.endDate')</td>
            <td width="15%">#springMessage('table.fcFreeze.freezeMoney')</td>
            <td width="10%">#springMessage('table.fcFreeze.freezeType')</td>
            <td width="35%">#springMessage('table.fcFreeze.freezeReason')</td>
        </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/inneraccount/fcFreeze.edit.js?_btv=${resourceVersion}"></script>
</html>
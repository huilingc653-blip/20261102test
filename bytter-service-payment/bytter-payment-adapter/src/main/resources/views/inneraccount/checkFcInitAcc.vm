<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" id="searchForm" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="10%">#springMessage('table.fcAcc.netId')</td>
            <td width="40%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="net"
                         data-type="selectTree"
                         data-group="corpGroup"
                         data-change="ins_corpId"
                         data-resource="netbank:innerAccount:fcInitAcc:query"
                         data-name="eqs_netId"
                         data-scope="net"></div>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.fcAcc.corpId')</td>
            <td width="40%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-tips="#springMessage('common.placeholder.select')#springMessage('table.fcAcc.netId')"
                         data-group="corpGroup"
                         data-resource="netbank:innerAccount:fcInitAcc:query"
                         data-scope="all"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcInitAcc.account')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="account" name="likes_account"
                           autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.fcInitAcc.account')">
                </div>
            </td>
            <td class="textRight">#springMessage('table.btBankAccCur.cur')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name="eqs_curId" data-biz-name="eqs_curId" data-valueField="id" data-textField="curName"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <div class="layui-inline">
##                    #if($shiro.hasPermission("netbank:innerAccount:fcInitAcc:query"))
                        <button class="layui-btn" type="button" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
##                    #end
                </div>
            </td>
        </tr>
        </tbody>
    </table>

</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcInitAcc.account')</th>
        <th>#springMessage('table.fcInitAcc.accName')</th>
        <th>#springMessage('table.fcAcc.curId')</th>
        <th>#springMessage('table.fcAcc.netId')</th>
        <th>#springMessage('finacial.check.erpDataManager.debitMoney')</th>
        <th>#springMessage('finacial.check.erpDataManager.creditMoney')</th>
        <th>#springMessage('table.fcInitAcc.cumulation')</th>
        <th>#springMessage('table.fcInitAcc.yearBalance')</th>
        <th>#springMessage('table.fcInitAcc.yearTotal')</th>
        <th>#springMessage('table.fcAcc.accStartDate')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/inneraccount/fcInitAcc.check.js?_btv=${resourceVersion}"></script>
</html>

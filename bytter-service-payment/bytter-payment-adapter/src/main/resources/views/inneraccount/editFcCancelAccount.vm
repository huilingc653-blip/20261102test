
#parse("views/common/head.vm")
#if(${listCancelVOPage.fcAcc.accType} == "01")
<table class="layui-table">
    <tr>
        <td width="10%" class="textRight">#springMessage('table.nisBillhead.tallyDate')</td>
        <td width="40%" >
            <div class="layui-input-inline">
            <input type="text" name="tallyDate" id="tallyDate" lay-verify="required" value="$!{listCancelVOPage.fcAccbookVoucher.accbook.tallyDate}" class="layui-input bt-biz-dateType" >
            </div>
        </td>
        <td width="10%" class="textRight">#springMessage('table.bisFinanceExc.payeeAcc')</td>
        <td width="40%">
            <div class="layui-inline">
            <select name="transferAcc"  lay-filter="transferAcc" lay-verify="required"  id="transferAcc" onchange="tChange();">
                <option value="">#springMessage('common.placeholder.select')</option>
                #foreach($tfoa in $!{listCancelVOPage.transferOutAcc})
                    <option value="$!{tfoa.blnctrAcc}"  #if(${tfoa.blnctrAcc} == $!{listCancelVOPage.transferAcc}) selected #end  >$!{tfoa.blnctrAcc}</option>
                #end
            </select>
            </div>
        </td>

    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.interestStartDate')</td>
        <td nowrap>
            <div class="layui-input-inline">
                <input type="text" name="startDate" id="startDate" value="$!{listCancelVOPage.fcAccbookVoucher.accbook.interestStartDate}" lay-verify="required" class="layui-input bt-biz-dateType" >
            </div>
        </td>
        <td class="textRight"><span class="pl ignore-required-icon"><span class="required-icon">*</span></span>#springMessage('table.fcAccbook.voucherType')：</td>
    ##凭证种类
        <td>
        <div class="layui-input-inline">
            <div type="list" field="voucherType" defaultVal="$!{listCancelVOPage.fcAccbookVoucher.accbook.voucherType}" fieldHref="${basePath}/netbank/fcvouchertype/json"  dictField="id" dictText="voucherName" ></div>
        </div>
        </td>
    </tr>
    <input type="hidden" name="blnctrAcc"  value="$!{listCancelVOPage.fcAcc.blnctrAcc}"/>
</table>
#end
<table class="layui-table">
    #if($!{size} >0 )
    <thead>
    <tr>
        <td width="17%" height="25" align="center" nowrap><span style="color: #fa0202">* </span>#springMessage('table.fcAccbookDtl.summaryContent')</td>
        <td width="16%" align="center" nowrap>#springMessage('table.nisBillhead.accId')</td>
        ##        <td width="17%" align="center" nowrap>原始凭证号</td>
        <td width="16%" align="center" nowrap>#springMessage('table.fcloanrepay.debitMoney')</td>
        <td width="17%" align="center" nowrap>#springMessage('table.fcloanrepay.creditMoney')</td>
    </tr>
    </thead>
    #end
    <tbody>
    #foreach($list in $!{listCancelVOPage.fcAccbookVoucher.bookDtls})
        #set($vcount = $velocityCount - 1)
        <tr>
            <td>
                <input type="hidden" id="summary$vcount" value="${list.summary}">
                <div class="layui-inline">
                <select name="summaryContent" lay-verify="required" id="summaryContent$vcount" style="width:100%">
                    <option value="">#springMessage('common.placeholder.select')</option>
                    #foreach($listSummary in ${listCancelVOPage.listBtSummary})
                        <option value="$!{listSummary.id}" #if(${list.summaryContent} == ${listSummary.summaryContent}) selected #end >$!{listSummary.summaryContent}</option>
                    #end
                </select>
                </div>
            </td>
            <td>
                <span id="accountSpan#if(${list.creditMoney} >0)Show#end">$!{list.account}</span>
            </td>
            <td class="textRight">  $number.formatNumeric($!{list.debitMoney})</td>
            <td class="textRight">  $number.formatNumeric($!{list.creditMoney})</td>
        </tr>

        #if(${list.creditMoney} >0)
            <input type="hidden" name="account" id="accountShow" value="$!{list.account}"/>
        #else
            <input type="hidden" name="account" id="account$vcount" value="$!{list.account}"/>
        #end

        <input type="hidden" name="debitMoney" id="debitMoney$vcount" value="$!{list.debitMoney}"/>
        <input type="hidden" name="creditMoney" id="creditMoney$vcount" value="$!{list.creditMoney}"/>
    #end
##    <input type="text" value="$!{listCancelVOPage.isNeedBusRule}" id="isNeedBusRule" >
    <input type="hidden" value="$!{listCancelVOPage.isInterestAcc}" id="isInterestAcc" />
    <input type="hidden" value="$!{listCancelVOPage.fcAccbookVoucher.bookDtls.size()}" id="count"/>
    <input type="hidden" value="$!{listCancelVOPage.busGlobalId}" NAME="busGlobalId" id="busGlobalId" />
    </tbody>
</table>
<script src="${basePath}/static/modules/inneraccount/fcCancelAccount.js?_btv=${resourceVersion}"></script>
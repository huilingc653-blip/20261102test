<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
##<form class="layui-form layui-form-pane">
#foreach($infoMap in $!list)
    #foreach($info in $!infoMap.entrySet())
        <div name="print_doc1" align="center" >
##            <div style="page-break-after:always">
                <div class="print-list">
                    ##凭证头部
                    <div class="print-header">
                        <div style="text-align:center;">
                            #set($to = ${info.key.split(",")})##to为类型voucherTYpe和流水号orderNo组成
                            #if($to[0] == "10")##to[0]为voucherType类型
                                <div class="print-header-name">$!{info.value.get(1).getNetName()}</div>
                                <div class="print-header-title">#springMessage('summons.billhead')<span></span><span></span>（#springMessage('summons.f')）</div>##付款通知单(付)
                            #elseif($to[0] == "20")
                                <div class="print-header-name">$!{info.value.get(1).getNetName()}</div>
                                <div class="print-header-title">#springMessage('summons.creditNote')<span></span><span></span>（#springMessage('summons.s')）</div>##收款通知单(收)
                            #elseif($to[0] == "30")
                                <div class="print-header-name">$!{info.value.get(1).getNetName()}</div>
                                <div class="print-header-title">#springMessage('summons.inside')<span></span><span></span>（#springMessage('summons.z')）</div>##内部通知单(转)
                            #end
                        </div>
                    </div>
                    <div class="print-body">
                        <table style="width:100%; " class="print-body-header">
                            <tr>
                            ##记账日期
                                <td width="50%">#springMessage('table.nisBillhead.tallyDate')：$!date.format('yyyy-MM-dd',$!{info.value.get(0).getTallyDate()})</td>
                            ##附件张数
                                <td width="50%">#springMessage('table.fcAccbook.affixAmount')：$!{info.value.get(0).getAffixAmount()} &nbsp;&nbsp;#springMessage('summons.paper')</td>
                            </tr>
                            <tr>
                            ##流水号
                                <td>#springMessage('table.fcAccbook.orderNo')：$!{info.value.get(0).getOrderNo()}</td>
                            ##凭证号
                                <td>#springMessage('fcAccSummons.voucherNo')：$!{info.value.get(0).getVoucherNo()}</td>
                            </tr>
                        </table>
                        <table id="dataTable" style="width:100%;table-layout:fixed " class="layui-table breakRow">
                            ##单位
                            <tr>
                                <td rowspan="3" width="30px" align="center">
                                    <div>#springMessage('summons.s')</div>
##                                    <br>
                                    <div>#springMessage('summons.k')</div>
##                                    <br>
                                    <div>#springMessage('summons.d')</div>
##                                    <br>
                                    <div>#springMessage('summons.w')</div>
                                </td>##收款凭证单位
                                <td width="60px" align="center">#springMessage('summons.fullName')</td>##全称
                                <td colspan="2" width="230px" class="small">
                                    #if($to[0] == "10")##付款凭证
                                        $!{info.value.get(1).getExternalName()}
                                    #elseif($to[0] == "20")##收款凭证
                                        $!{info.value.get(1).getAccName()}
                                    #elseif($to[0] == "30")##内转凭证
                                        $!{info.value.get(1).getAccName()}
                                    #end
                                </td>
                                <td rowspan="3" width="30px" align="center">
                                    <div>#springMessage('summons.f')</div>
                                    <div>#springMessage('summons.k')</div>
                                    <div>#springMessage('summons.d')</div>
                                    <div>#springMessage('summons.w')</div>
                                </td>##付款凭证单位
                                <td width="60px" align="center">#springMessage('summons.fullName')</td>##全称
                                <td colspan="2" width="230px" class="small">
                                    #if($to[0] == "10")##付款凭证
                                        $!{info.value.get(0).getAccName()}
                                    #elseif($to[0] == "20")##收款凭证
                                        $!{info.value.get(1).getExternalName()}
                                    #elseif($to[0] == "30")##内转凭证
                                        $!{info.value.get(0).getAccName()}
                                    #end
                                </td>
                            </tr>
                            ##账号
                            <tr>
                                <td align="center">#springMessage('table.fcAcc.account')</td>
                                <td colspan="2" class="small">
                                    #if($to[0] == "10")##付款凭证
                                        $!{info.value.get(1).getExternalAcc()}
                                    #elseif($to[0] == "20")##收款凭证
                                        $!{info.value.get(1).getAccount()}
                                    #elseif($to[0] == "30")##内转凭证
                                        $!{info.value.get(1).getAccount()}
                                    #end
                                </td>
                                <td align="center">#springMessage('table.fcAcc.account')</td>
                                <td colspan="2" class="small">
                                    #if($to[0] == "10")##付款凭证
                                        $!{info.value.get(0).getAccount()}
                                    #elseif($to[0] == "20")##收款凭证
                                        $!{info.value.get(1).getExternalAcc()}
                                    #elseif($to[0] == "30")##内转凭证
                                        $!{info.value.get(0).getAccount()}
                                    #end
                                </td>
                            </tr>
                            ##开户行
                            <tr>
                                <td align="center">#springMessage('table.bisAccBal.bankName')</td>
                                <td colspan="2" class="small">
                                    #if($to[0] == "10")##付款凭证
                                        $!{info.value.get(1).getBank()}
                                    #elseif($to[0] == "20")##收款凭证
                                        $!{info.value.get(1).getNetName()}
                                    #elseif($to[0] == "30")##内转凭证
                                        $!{info.value.get(1).getNetName()}
                                    #end
                                </td>
                                <td align="center">#springMessage('table.bisAccBal.bankName')</td>
                                <td colspan="2" class="small">
                                    #if($to[0] == "10")##付款凭证
                                        $!{info.value.get(1).getNetName()}
                                    #elseif($to[0] == "20")##收款凭证
                                        $!{info.value.get(1).getBank()}
                                    #elseif($to[0] == "30")##内转凭证
                                        $!{info.value.get(1).getNetName()}
                                    #end
                                </td>
                            </tr>
                            ##币别
                            <tr>
                                <td align="center" colspan="2">#springMessage('table.bisAccBal.curId')</td>
                                <td colspan="2" class="small">
                                    #if($to[0] == "10")##付款凭证
                                        $!{info.value.get(1).getCurName()}
                                    #elseif($to[0] == "20")##收款凭证
                                        $!{info.value.get(0).getCurName()}
                                    #elseif($to[0] == "30")##内转凭证
                                        $!{info.value.get(0).getCurName()}
                                    #end
                                </td>
                                ##利率
                                <td align="center" colspan="2">#springMessage('table.eTransBill.rate')（%）</td>
                                <td colspan="2" class="small"></td>
                            </tr>
                            <tr>##金额(大写)
                                <td colspan="2" align="center">#springMessage('table.cgsBill.money.upper')</td>
                                <td colspan="6" class="small" style="padding-left:0px">
                                    <div id="moneyUp$!{info.value.get(0).getOrderNo()}" style="line-height: 24px; white-space: normal; word-break: break-all;width: 300px;display: inline-block;vertical-align: center" name="moneyUp$!{info.value.get(0).getOrderNo()}" readonly="true" data-name="moneyUp$!{info.value.get(0).getOrderNo()}"></div>
                                </td>
                            </tr>
                            <tr>##金额(小写)
                                <td colspan="2" align="center">#springMessage('table.cgsBill.money.lower')</td>
                                <td colspan="6" class="small">
                                    <input type="hidden" class="bt-biz-moneyType" data-minus="true" data-toUp="moneyUp$!{info.value.get(0).getOrderNo()}"
                                           value="$!{info.value.get(0).getDebitMoney()}" />
                                    <span id="lower" >￥$!number.formatNumeric($!{info.value.get(0).getDebitMoney()})</span>
                                </td>
                            </tr>
                            ##原始凭证
                            <tr>
                                <td colspan="2" align="center">#springMessage('summons.voucherName')</td>##原凭证名称
                                <td width="18%">$!{info.value.get(0).getVoucherName()}</td>
                                <td width="17%" align="center">#springMessage('summons.origVoucherNo')</td>##原凭证号码
                                <td colspan="2">$!{info.value.get(0).getOrigVoucherNo()}</td>
                                <td width="18%" align="center">#springMessage('summons.voucherMoney')</td>##原凭证金额
                                <td width="17%">￥$!number.formatNumeric($!{info.value.get(0).getDebitMoney()})</td>
                            </tr>
                            ##备注
                            <tr>
                                <td colspan="2" align="center">#springMessage('table.btBankAcc.rmk')</td>
                                <td colspan="2" class="small">
                                    #if($to[0] == "10")##付款凭证
                                        #springMessage('summons.payBank')：$!{info.value.get(1).getBankName()}<br>
                                    #elseif($to[0] == "20")##收款凭证
                                        #springMessage('summons.recBank')：$!{info.value.get(0).getBankName()}<br>
                                    #elseif($to[0] == "30")##内转凭证
                                    #end
                                    $!{info.value.get(0).getRmk()}
                                </td>
                                <td rowspan="2" colspan="4" class="normal">
                                    #springMessage('table.fcVoucherEntryDefine.debit'):&nbsp;&nbsp;$!{info.value.get(0).getSubjectName()}_$!{info.value.get(0).getAccount()}<br>##借方
                                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;#springMessage('table.fcVoucherEntryDefine.credit'):&nbsp;&nbsp;$!{info.value.get(1).getSubjectName()}_$!{info.value.get(1).getAccount()}<br>##贷方
                                    #springMessage('table.cgsBill.tallier'):&nbsp;&nbsp;$!{info.value.get(0).getOpName()}##记账员名称
                                    &nbsp;&nbsp;&nbsp;&nbsp;
                                    #springMessage('summons.checkName'):&nbsp;&nbsp;$!{info.value.get(0).getCheckName()}##复核
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" align="center">#springMessage('table.nisBillhead.purpose')</td>##用途
                                <td colspan="2" class="small">$!{info.value.get(0).getSummaryContent()}</td>##转账原因
                            </tr>
                            <tr>
                                <td colspan="2" align="center">#springMessage('table.fcFreeze.operator')</td>##经办人
                                <td class="small">$!{info.value.get(0).getCreateName()}</td>
                                <td align="center">#springMessage('bpm.model.assign')</td>##审批人
                                <td colspan="2" class="small">$!{info.value.get(0).getApproveName()}</td>
                                #if($!{info.value.get(0).getManageName()} != "" && $!{info.value.get(0).getManageName()} != "null")
                                    <td align="center">#springMessage('summons.director')</td>##主管
                                    <td class="small">$!{info.value.get(0).getManageName()}</td>
                                #else
                                    <td align="center"></td>
                                    <td class="small"></td>
                                #end
                            </tr>
                        </table>
                    </div>
                    ##凭证底部
                    <div class="print-footer">
                        <table style="width: 100%; " class="print-body-header">
                            <tr>
                                <td>#springMessage('fcAccDetail.interestStartDate')：$!date.format('yyyy-MM-dd',$!{info.value.get(0).getInterestStartDate()})</td>
                            </tr>
                        </table>
                    </div>
                </div>
##            </div>
        </div>
    #end
#end
##</form>
<object id="LODOP_OB" classid="clsid:2105C259-1E0C-4534-8141-A753534CB4CA" width=0 height=0>
    <embed id="LODOP_EM" type="application/x-print-lodop" width=0 height=0></embed>
</object>
<br/>
<br/>
<div class="layui-form-info layui-form-submit" id="buttonDiv">
    <div class="layui-input-block">
        <button type="button" class="layui-btn" onclick="prints()">#springMessage('common.button.print')</button>
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/inneraccount/summonsAllPrint.js?_btv=${resourceVersion}"></script>
</html>
#parse("views/common/headInclude.vm")
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.accInfo')</td>
    </tr>
    </thead>
    <tbody>
        <tr>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.accOpenTime')</td>
            <td width="40%">##开户日期
                <div class="layui-input-inline">
                    <input type="text" name="accOpenTime"  readonly="readonly" data-today="true" class="layui-input bt-biz-dateType" >
                </div>
            </td>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.accStartDate')</td>
            <td width="40%">##启用日期
                <div class="layui-input-inline">
                    <input type="text" name="accStartDate" data-name="accStartDate" data-biz-name="accStartDate"  lay-verify="required" data-endid="t2" data-min="$!{accStartDate}" value="$!{accStartDate}" class="layui-input bt-biz-dateType" >
                </div>
            </td>
        </tr>
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.interestInfo')</td>
    </tr>
    </thead>
    <tbody>
        <tr>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.interestSign')</td>
            <td width="40%">##计息标志
                <div class="layui-inline">
                    <input type="radio" lay-filter="interestSign" name="interestSign" value="1" title="#springMessage('table.fcAcc.interestSignOk')">
                    <input type="radio" lay-filter="interestSign" name="interestSign" value="0" title="#springMessage('table.fcAcc.interestSignNo')" checked >
                </div>
            </td>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.predrawSign')</td>
            <td width="40%">##预提标志
                <div class="layui-inline">
                    <select lay-filter="predrawSign" name="predrawSign">
                        <option value=""></option>
                    </select>
                </div>
            </td>
        </tr>
        <tr>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.interestStartDate')</td>
            <td width="40%">##起息日期
                <div class="layui-input-inline">
                    <input type="text" name="interestStartDate" data-biz-name="interestStartDate" data-callback="clickNotice" lay-verify="required" id="t2" class="layui-input bt-biz-dateType" >
                </div>
            </td>
            <td class="textRight">#springMessage('table.fcAcc.deadlineDate')</td>
            <td>##到期日期
                <div class="layui-input-inline">
                    <input type="text" name="deadlineDate" data-biz-name="deadlineDate" lay-verify="required" data-callback="clickNotice" class="layui-input bt-biz-dateType" >
                </div>
            </td>
        </tr>
        <tr>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.term')</td>
            <td width="40%">##期限
                <div class="layui-input-inline">
                    <input type="text" id="notifyType" name="notifyType"
                           decimal="0" autocomplete="off" class="layui-input" readonly="readonly" data-decimal="0"  placeholder="#springMessage('table.fcAcc.term')">
                </div>
                <div class="layui-inline">
                    <select data-width="70px" lay-filter="endUnit" name="endUnit">
                        #foreach($dict in $dictTag.list("fcAcc.endUnit"))
                            <option value="$dict.code">$dict.name</option>
                        #end
                    </select>
                </div>
            </td>
            <td class="textRight">#springMessage('table.fcAcc.interestRate')</td>
            <td>##利率
                <input type="text" id="interestRate" name="interestRate" value="$!{interestRate}"
                       autocomplete="off" class="layui-input bt-biz-rateType" data-type="percent" data-biz-name="interestRate" placeholder="#springMessage('table.fcAcc.interestRate')">
            </td>
        </tr>
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('cms.loan.OtherInfo')</td>
    </tr>
    </thead>
    <tbody>
        <tr>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.overdraftRate.pre')</td>
        ##提前利率
            <td width="40%">
                <input type="text" id="overdraftRate" name="overdraftRate"
                       autocomplete="off" class="layui-input bt-biz-rateType" data-type="percent" placeholder="#springMessage('table.fcAcc.overdraftRate')">
            </td>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.overdueRate.Pass')</td>
            <td width="40%">
            ##超期利率
                <input type="text" id="overdueRate" name="overdueRate"
                       autocomplete="off" class="layui-input bt-biz-rateType" data-biz-name="overdueRate" data-type="percent" placeholder="#springMessage('table.fcAcc.overdueRate')">
            </td>
        </tr>
    </tbody>
</table>
<script src="${basePath}/static/modules/inneraccount/fcAcc.common.dynamic.add.js?_btv=${resourceVersion}"></script>
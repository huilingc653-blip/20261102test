<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcFreezePage.id}">
		<input id="unFreezeId" name="unFreezeId" type="hidden" value="$!{fcFreezePage.unFreezeId}">
        <input id="freezeSign" name="freezeSign" type="hidden" value="C">
        <input id="freezeEndSign" name="freezeEndSign" type="hidden" value="0">
        <input id="opType" name="opType" type="hidden" value="A">
        <table class="layui-table">
			<tbody>
            <tr>
			##网点
                <td class="textRight">#springMessage('table.fcAcc.netId')</td>
                <td width="40%">
                    <div class="layui-inline">
                    	<div class="bt-biz-corp"
                         data-biz-type="net"
                         data-type="selectTree"
                         data-name="netId"
                         data-group="corpGroup"
                         data-change="corpId"
                         data-required="required"
                         data-callbackData="netIdChange"
                         data-resource="netbank:innerAccount:fcFreeze:apply"
                         data-scope="net">
                        </div>
                    </div>
                </td>
			##单位
                <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
                <td width="40%">
                    <div class="layui-inline">
                   		 <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-required="required"
                         data-resource="netbank:innerAccount:fcFreeze:apply"
                         data-name="corpId"
                         data-tips="#springMessage('common.placeholder.select')#springMessage('table.fcAcc.netId')"
                         data-group="corpGroup"
                         data-callbackData="corpChange"
                         data-scope="all"></div>
                    </div>
                </td>
            </tr>
        	<tr>
        		##账号
				<td class="textRight">#springMessage('table.fcFreeze.blnctrAcc')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="blnctrAcc" id="blnctrAcc" data-biz-name="blnctrAcc" lay-verify="required"  class="layui-input text" autocomplete="off">
                        <table id="blnctrAccTable" class="hide">
                            <thead>
                            <tr>
                                <th>#springMessage('table.fcAcc.blnctrAcc')</th>
                                <th>#springMessage('table.fcAcc.curId')</th>
                                <th>#springMessage('table.fcAcc.accName')</th>
                                <th>#springMessage('table.btBankAccFreeze.avalBal')</th>
                                <th>#springMessage('table.fcFreeze.accuFreezeMoney')</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </td>
				##通知书编号
                    <td class="textRight">#springMessage('table.fcFreeze.freezeNo')</td>
                    <td >
                        <input type="text" id="freezeNo" lay-verify="required|strlength" data-maxlength="20"  name="freezeNo"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcFreeze.freezeNo')">
                    </td>
			</tr>
        	<tr>
        		##币别
				<td class="textRight">#springMessage('table.fcAcc.curId')</td>
				<td ><span id="curNameSpan"></span>
                    <input type="hidden" id="curName" data-name="curName" class="input-noborder" readonly="readonly"></td>
				<td class="textRight">#springMessage('table.fcAcc.accName')</td>
				<td ><span id="accNameSpan"></span><input type="hidden" id="accName" data-name="accName" class="input-noborder" readonly="readonly"></td>

            </tr>
        	<tr>
				##可解冻金额
                <td class="textRight">#springMessage('table.btBankAccFreeze.avalBal')</td>
                <td width="40%"><span id="activeMoneySpan"></span>
                    <input type="hidden" id="activeMoney" data-name="activeMoney" data-biz-name="activeMoney" class="input-noborder bt-biz-moneyType" readonly="readonly"></td>
        		##累计冻结金额
				<td class="textRight">#springMessage('table.fcFreeze.accuFreezeMoney')</td>
					<td ><span id="accuFreezeMoneySpan"></span> <input type="hidden" id="accuFreezeMoney" data-name="accuFreezeMoney"  data-biz-name="accuFreezeMoney" class="input-noborder bt-biz-moneyType" readonly="readonly"></td>

            </tr>
        	<tr>
				##冻结类型
                <td class="textRight">#springMessage('table.fcFreeze.freezeType')</td>
                <td >
                    <div class="layui-inline">
                    <select lay-filter="freezeType" name="freezeType" lay-verify="required" >
                        <option value="">#springMessage('common.placeholder.select')</option>
						#foreach($dict in $dictTag.list("fcFreeze.freezeType"))
                            <option value="$dict.code">$dict.name</option>
						#end

                    </select>
                    </div>
                </td>
				##冻结金额
                <td class="textRight">#springMessage('table.fcFreeze.freezeMoney')</td>
                <td >
                    <!--number-->
                    <input type="text" id="freezeMoney" name="freezeMoney" lay-verify="required"
                           autocomplete="off" class="layui-input bt-biz-moneyType" data-biz-name="freezeMoney" placeholder="#springMessage('table.fcFreeze.freezeMoney')">
                </td>
            </tr>
            <tr>
            ##冻结开始时间
                <td class="textRight">#springMessage('table.fcFreeze.beginDate')</td>
                <td >
                    <input type="text" name="beginDate" lay-verify="required" class="layui-input bt-biz-dateType" data-endid="tt" data-type="date">
                </td>
            ##冻结结束时间
                <td class="textRight">#springMessage('table.fcFreeze.endDate')</td>
                <td >
                    <input type="text" name="endDate" lay-verify="required"  class="layui-input bt-biz-dateType" id="tt" data-type="date">
                </td>
            </tr>
            <tr>


            </tr>

        	<tr>
        		##执行人公务证
				<td class="textRight">#springMessage('table.fcFreeze.execOfficialNo')</td>
				<td >
						<!--number-->
                        <input type="text" id="execOfficialNo" name="execOfficialNo" lay-verify="strlength" data-maxlength="50"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcFreeze.execOfficialNo')">
										</td>
        		##执行人省份证
				<td class="textRight">#springMessage('table.fcFreeze.execCardNo')</td>
				<td >
						<!--number-->
                        <input type="text" id="execCardNo" name="execCardNo" lay-verify="strlength" data-maxlength="18"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcFreeze.execCardNo')">
										</td>
            </tr>
        	<tr>
        		##冻结解冻原因
				<td class="textRight">#springMessage('table.fcFreeze.freezeReason')</td>
				<td >
                    <textarea placeholder="#springMessage('table.fcFreeze.freezeReason')" lay-verify="required|strlength" data-maxlength="200" rows=4 cols=64 class="layui-textarea" id="freezeReason" name="freezeReason"></textarea>
                ##冻结解冻机构
                    <td class="textRight">#springMessage('table.fcFreeze.freezeOrg')</td>
                    <td >
                        <!--number-->
                        <input type="text" id="freezeOrg" name="freezeOrg"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcFreeze.freezeOrg')">
                    </td>
            </tr>
				<tr>
					<td colspan="6" style="text-align: center;">
                        <button class="layui-btn" type="button" lay-submit="" value="0" lay-filter="submit">#springMessage('common.button.temp')</button>
						<button class="layui-btn" type="button" lay-submit="" value="11" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary" data-callback="resetFields">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    <div id="tagFcFreeze">
        <table id ="dyncTable" width="100%" border="0" cellpadding="0" cellspacing="0" class="layui-table">
            <thead>
                <tr class="title">
                    <td width="10%">#springMessage('table.fcFreeze.freezeNo')</td>
                    <td width="10%">#springMessage('table.fcFreeze.beginDate')</td>
                    <td width="10%">#springMessage('table.fcFreeze.endDate')</td>
                    <td width="15%">#springMessage('table.fcFreeze.freezeMoney')</td>
                    <td width="10%">#springMessage('table.fcFreeze.freezeType')</td>
                    <td width="35%">#springMessage('table.fcFreeze.freezeReason')</td>
                </tr>
            </thead>
            <tbody></tbody>
	    </table>
    </div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/inneraccount/fcFreeze.add.js?_btv=${resourceVersion}"></script>
</html>

#parse("views/common/headInclude.vm")
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.accInfo')</td>
    </tr>
    </thead>
    <tbody>
        <tr>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.accOpenTime')</td>
            <td width="40%">##开户日期
                <div class="layui-input-inline">
                    <input type="text" name="accOpenTime"  readonly="readonly" data-today="true" class="layui-input bt-biz-dateType" >
                </div>
            </td>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.accStartDate')</td>
            <td width="40%">##启用日期
                <div class="layui-input-inline">
                    <input type="text" name="accStartDate" data-name="accStartDate" data-biz-name="accStartDate" lay-verify="required" data-endid="t2" data-min="$!{accStartDate}" value="$!{accStartDate}" class="layui-input bt-biz-dateType" >
                </div>
            </td>
        </tr>
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.interestInfo')</td>
    </tr>
    </thead>
    <tbody>
        <tr>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.interestSign')</td>
        ##计息标志
            <td width="40%">
                <div class="layui-inline">

                    <input type="radio" lay-filter="interestSign" name="interestSign" value="1" title="#springMessage('table.fcAcc.interestSignOk')">
                    <input type="radio" lay-filter="interestSign" name="interestSign" value="0" title="#springMessage('table.fcAcc.interestSignNo')" checked >
                </div>
            </td>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.predrawSign')</td>
            <td width="40%">##预提标志
                <div class="layui-inline">
                    <select lay-filter="predrawSign" name="predrawSign">
                        <option value=" "></option>
                    </select>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.interestStartDate')</td>
            <td>##起息日期
                <div class="layui-input-inline">
                    <input type="text" name="interestStartDate" data-biz-name="interestStartDate" data-callback="clickNotice" id="t2" lay-verify="required"  class="layui-input bt-biz-dateType" >
                </div>
            </td>
            <td class="textRight">#springMessage('table.fcAcc.deadlineDate')</td>
            <td>##到期日期
                <div class="layui-input-inline">
                    <input type="text" name="deadlineDate" data-biz-name="deadlineDate" lay-verify="required" data-callback="clickNotice" class="layui-input bt-biz-dateType" >
                </div>
            </td>
        </tr>
        <tr>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.term')</td>
            <td width="40%">##期限
                <div class="layui-input-inline">
                    <input type="text" id="notifyType" name="notifyType"
                           decimal="0" autocomplete="off" class="layui-input" readonly="readonly" data-decimal="0" placeholder="#springMessage('table.fcAcc.term')">
                </div>
                <div class="layui-inline">
                    <select data-width="70px" lay-filter="endUnit" name="endUnit">
                        #foreach($dict in $dictTag.list("fcAcc.endUnit"))
                            <option value="$dict.code">$dict.name</option>
                        #end
                    </select>
                </div>
            </td>
            <td class="textRight">#springMessage('table.fcAcc.interestRate')</td>
        ##利率
            <td>
                <input type="text" id="interestRate" name="interestRate" value="$!{interestRate}"
                       autocomplete="off" class="layui-input bt-biz-rateType"  data-biz-name="interestRate" placeholder="#springMessage('table.fcAcc.interestRate')">
            </td>
        </tr>
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('cms.loan.OtherInfo')</td>
    </tr>
    </thead>
    <tbody>
        <tr>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.contractNo')</td>
            <td width="40%">##合同编号
                <input type="text" id="contractNo" name="contractNo"
                       autocomplete="off" class="layui-input" lay-verify="required" placeholder="#springMessage('table.fcAcc.contractNo')">
            </td>
            <td width="10%" class="textRight">#springMessage('table.fcAcc.delayDeadlineDate')</td>
            <td width="40%">##展期到期日期
                <div class="layui-input-inline">
                    <input type="text" name="delayDeadlineDate" class="layui-input bt-biz-dateType" >
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.delayRate')</td>
            <td>##展期利率
                <input type="text" id="delayRate" name="delayRate"
                       autocomplete="off" class="layui-input bt-biz-rateType" data-biz-name="delayRate" placeholder="#springMessage('table.fcAcc.delayRate')">
            </td>
            <td class="textRight">#springMessage('table.fcAcc.overdueRate')</td>
            <td>##逾期利率
                <input type="text" id="overdueRate" name="overdueRate"
                       autocomplete="off" class="layui-input bt-biz-rateType"  data-biz-name="overdueRate"  data-biz-name="overdueRate" placeholder="#springMessage('table.fcAcc.overdueRate')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.precationCorp')</td>
            <td>##委托存款单位
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-type="selectTree"
                         data-name="precationCorp"
                         data-callbackData="precationCorpChange"
                         data-resource="netbank:innerAccount:fcAcc:query"
                         data-scope="all" data-required="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.fcAcc.precationAcc')</td>
            <td>##委托存款账号
                <div class="layui-input-inline">
                    <input type="text" name="precationAcc" id="precationAcc" lay-verify="required|tableData" class="layui-input precationAcc" data-biz-name="precationAcc">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.poundageRate')</td>
            <td>##手续费率
                <input type="text" id="poundageRate" name="poundageRate"
                       autocomplete="off" class="layui-input bt-biz-rateType" data-biz-name="poundageRate" placeholder="#springMessage('table.fcAcc.poundageRate')">
            </td>
            <td class="textRight">#springMessage('table.fcAcc.accForDeduct')</td>
            <td>##扣息活期账户
                <div class="layui-inline">
                    <select  id="accForDeduct" name="accForDeduct" >
                        <option></option>
                    </select>
                </div>
            </td>
        </tr>
    </tbody>
</table>
<script src="${basePath}/static/modules/inneraccount/fcAcc.common.dynamic.add.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/inneraccount/fcAccLoanByMandate.common.js?_btv=${resourceVersion}"></script>
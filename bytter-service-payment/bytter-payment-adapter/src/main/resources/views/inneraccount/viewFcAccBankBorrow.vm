
#parse("views/common/head.vm")
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.accInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.accOpenTime')</td>
        <td width="40%">##开户日期
            $!date.format('yyyy-MM-dd',$!{fcAccPage.accOpenTime})
        </td>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.accStartDate')</td>
        <td width="40%">##启用日期
             $!date.format('yyyy-MM-dd',$!{fcAccPage.accStartDate})
        </td>
    </tr>
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.interestInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.interestSign')</td>
        <td width="40%">##计息标志
            #if( $!{fcAccPage.interestSign}=='1' )
            #springMessage('table.fcAcc.interestSignOk')
        #else
            #springMessage('table.fcAcc.interestSignNo')
        #end
        </td>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.predrawSign')</td>
        <td width="40%">##预提标志
            $dictTag.get("Admin.PredrawSign","$!{fcAccPage.predrawSign}")
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.interestStartDate')</td>
        <td>##起息日期
            $!date.format('yyyy-MM-dd',$!{fcAccPage.interestStartDate})
        </td>
        <td class="textRight">#springMessage('table.fcAcc.deadlineDate')</td>
        <td>##到期日期
            $!date.format('yyyy-MM-dd',$!{fcAccPage.deadlineDate})
        </td>
    </tr>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.term')</td>
        <td width="40%">##期限
            $!{fcAccPage.notifyType}&nbsp;$dictTag.get("fcAcc.endUnit",$!{fcAccPage.endUnit})
        </td>
        <td class="textRight">#springMessage('table.fcAcc.interestRate')</td>
        <td>##利率
            $rateTag.show($fcAccPage.interestRate)
        </td>
    </tr>
        #if( $!{fcAccPage.interestSign}=='1' )
        <tr id="showAcc">
            ##应付利息账号
            <td class="textRight">#springMessage('table.fcAcc.interestPayAcc')</td>
            <td>
                $!{fcAccPage.interestRecPay}
            </td>
            ##利息支出账号
            <td class="textRight">#springMessage('table.fcAcc.interestoutExp')</td>
            <td>
                $!{fcAccPage.interestInExp}
            </td>
        </tr>
        #end
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('cms.loan.OtherInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.contractNo')</td>
        <td width="40%">##合同编号
            $!{fcAccPage.contractNo}
        </td>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.delayDeadlineDate')</td>
        <td width="40%">##展期到期日期
            $!date.format('yyyy-MM-dd',$!{fcAccPage.delayDeadlineDate})
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.delayRate')</td>
        <td>##展期利率
            $rateTag.show($fcAccPage.delayRate)
        </td>
        <td class="textRight">#springMessage('table.fcAcc.overdueRate')</td>
        <td>##逾期利率
            $rateTag.show($fcAccPage.overdueRate)
        </td>
    </tr>
    </tbody>
</table>
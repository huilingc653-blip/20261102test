
#parse("views/common/head.vm")
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.accInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.natureCodeId')</td>
        <td width="40%">##账户性质
            $!{fcAccPage.natureName}
        </td>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.attributeId')</td>
        <td width="40%">##账户属性
            $!{fcAccPage.attributeName}
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.accOpenTime')</td>
        <td>##开户日期
            $!date.format('yyyy-MM-dd',$!{fcAccPage.accOpenTime})
        </td>
        <td class="textRight">#springMessage('table.fcAcc.accStartDate')</td>
        <td>##启用日期
             $!date.format('yyyy-MM-dd',$!{fcAccPage.accStartDate})
        </td>
    </tr>
    <tr>

        <td class="textRight">#springMessage('table.fcAcc.relationAcc')</td>
        <td>##关联活期账号
            $!{fcAccPage.relationAcc}
        </td>
        <td></td>
        <td></td>
    </tr>
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.interestInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.interestRate')</td>
        <td width="40%">##利率
            $rateTag.show($fcAccPage.interestRate)
        </td>
        <td width="10%"></td>
        <td width="40%"></td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.interestSign')</td>
        <td>##计息标志
				#if( $!{fcAccPage.interestSign}=='1' )
            #springMessage('table.fcAcc.interestSignOk')
        #else
            #springMessage('table.fcAcc.interestSignNo')
        #end
        </td>
        <td class="textRight">#springMessage('table.fcAcc.predrawSign')</td>
        ##预提标志
        <td>$dictTag.get("Admin.PredrawSign","$!{fcAccPage.predrawSign}")</td>
    </tr>
        #if( $!{fcAccPage.interestSign}=='1' )
        <tr id="showAcc">
            ##应付利息账号
            <td class="textRight">#springMessage('table.fcAcc.interestPayAcc')</td>
            <td>
                $!{fcAccPage.interestRecPay}
            </td>
            ##利息支出账号
            <td class="textRight">#springMessage('table.fcAcc.interestoutExp')</td>
            <td>
                $!{fcAccPage.interestInExp}
            </td>
        </tr>
        #end
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('cms.loan.OtherInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        #if($!{poolSign} == "1")
            <td width="10%"></td>
            <td width="40%"></td>
        #else
            <td class="textRight" width="10%">#springMessage('table.fcAcc.chargeAcc')</td>
            <td width="40%">##手续费收取账号
                   $!{fcAccPage.chargeAcc}
            </td>
        #end
        <td class="textRight" width="10%">#springMessage('table.fcAcc.overdraftSign')</td>
        ##透支类型
        <td width="40%">
            $dictTag.get("fcAcc.overdraftSign",$!{fcAccPage.overdraftSign})
            </div>
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.overdraftRate')</td>
        ##透支利率
        <td>
            $rateTag.show(${fcAccPage.overdraftRate})
        </td>
        <td class="textRight">#springMessage('table.fcAcc.overdraftMoney')</td>
        ##透支金额
        <td>
            $!{fcAccPage.overdraftMoney}
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcInitAcc.rmk')</td>
        <td>
            $!{fcAccPage.rmk}
        </td>
        <td></td>
        <td></td>
    </tr>
    </tbody>
</table>

<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="updateDate" name="updateDate" type="hidden" value="$!{fcFreezePage.updateDate}">
    <input id="id" name="id" type="hidden" value="$!{fcFreezePage.id}">
    <input id="unFreezeId" name="unFreezeId" type="hidden" value="$!{fcFreezePage.unFreezeId}">
    <input id="createBy" name="createBy" type="hidden" value="$!{fcFreezePage.createBy}">
    <input id="createDate" name="createDate" type="hidden" value="$!{fcFreezePage.createDate}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{fcFreezePage.updateBy}">
    <input id="freezeSign" name="freezeSign" type="hidden" value="T">
    <input id="accuFreezeMoney" name="accuFreezeMoney" type="hidden" value="0">
    <input id="opType" name="opType" type="hidden" value="M">
    <table class="layui-table">
        <tbody>
        <tr>
        ##网点
            <td class="textRight">#springMessage('table.fcAcc.netId')</td>
            <td >&nbsp;
                ($!{netCode})$!{fcFreezePage.netName}
            </td>

        ##单位
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            <td >&nbsp;($!{corpCode})$!{fcFreezePage.corpName}
            </td>

        </tr>
        <tr>
        ##账号
            <td class="textRight">#springMessage('table.fcFreeze.blnctrAcc')</td>
            <td width="40%">&nbsp;$!{fcFreezePage.blnctrAcc}
                <input type="hidden" name="blnctrAcc" id="blnctrAcc" value="$!{fcFreezePage.blnctrAcc}"/>
            </td>
		##通知书编号
            <td class="textRight">#springMessage('table.fcFreeze.freezeNo')</td>
            <td >$!{fcFreezePage.freezeNo}</td>


        </tr>
        <tr>
		##币别
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td ><span id="curNameSpan">$!{fcFreezePage.curName}</span></td>
            <td class="textRight">#springMessage('table.fcAcc.accName')</td>
            <td ><span id="accNameSpan">$!{fcFreezePage.accName}</span></td>

        </tr>
        <tr>
		##冻结类型
            <td class="textRight">#springMessage('table.fcFreeze.freezeType')</td>
            <td >$!{fcFreezePage.freezeTypeName}
                <input type="hidden" name="freezeType" id="freezeType" value="$!{fcFreezePage.freezeType}"/>
            </td>
        ##冻结金额
            <td class="textRight">#springMessage('table.fcFreeze.freezeMoney')</td>
            <td > $number.formatNumeric($!{fcFreezePage.freezeMoney})
        </tr>
        <tr>
        ##冻结开始时间
            <td class="textRight">#springMessage('table.fcFreeze.beginDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{fcFreezePage.beginDate})

                <input type="hidden" name="beginDate" id="beginDate" value="$!{fcFreezePage.beginDate}"/>
            </td>
        ##冻结结束时间
            <td class="textRight">#springMessage('table.fcFreeze.endDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{fcFreezePage.endDate})

                <input type="hidden" name="endDate" id="endDate" value="$!{fcFreezePage.endDate}"/>
            </td>
        </tr>
        <tr>
        ##解冻金额
            <td class="textRight">#springMessage('table.fcFreeze.unfreezeMoney.yes')</td>
            <td >$number.formatNumeric($!{fcFreezePage.freezeMoney})
        ##解冻机构
            <td class="textRight">#springMessage('table.fcFreeze.unfreezeOrg')</td>
            <td >$!{fcFreezePage.freezeOrg}</td>
        </tr>

        <tr>
        ##执行人公务证
            <td class="textRight">#springMessage('table.fcFreeze.execOfficialNo')</td>
            <td >$!{fcFreezePage.execOfficialNo}</td>
        ##执行人省份证
            <td class="textRight">#springMessage('table.fcFreeze.execCardNo')</td>
            <td >$!{fcFreezePage.execCardNo}</td>
        </tr>
            #if( $!{fcFreezePage.status}=='-1' )
            <tr>
            ##打回原因
                <td class="textRight">#springMessage('table.fcFreeze.refuseWhy')</td>
                <td >$!{fcFreezePage.refuseWhy}</td>
                <td></td>
                <td></td>
            </tr>
            #end
        <tr>
        ##解冻原因
            <td class="textRight">#springMessage('table.fcFreeze.unfreezeReason')</td>
            <td colspan="3">$!{fcFreezePage.freezeReason}</td>

        </tr>
        <tr>
##            <td colspan="6" style="text-align: center;">
##                <button class="layui-btn" lay-submit="" value="0" lay-filter="submit">#springMessage('common.button.temp')</button>
##                <button class="layui-btn" lay-submit="" value="11" lay-filter="submit">#springMessage('common.button.submit')</button>
##                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
##            </td>
        </tr>
        </tbody>
    </table>
</form>
	#parse("views/common/footer.vm")
</body>
</html>
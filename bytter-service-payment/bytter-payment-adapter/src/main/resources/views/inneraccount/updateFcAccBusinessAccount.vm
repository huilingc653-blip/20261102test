##  银行定期	06
###set($basePath=$springMacroRequestContext.contextPath)
<input id="changeType" name="changeType" type="hidden" value="$!{opType}">
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.accInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.natureCodeId')</td>
        <td width="40%">##账户性质
            <div class="layui-inline">
                <div class="bt-biz-selectType" data-required="true" data-url="${basePath}/bankacc/btaccnature/json" data-valuefield="id" data-textfield="natureName" data-name="natureCodeId" data-defaultvalue="$!{fcAccPage.natureCodeId}">
                </div>
            </div>
        </td>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.attributeId')</td>
        <td width="40%">##账户属性
            <div class="layui-inline">
                <div class="bt-biz-selectType"  data-required="true" data-url="${basePath}/bankacc/bisaccattribute/json" data-valuefield="id" data-textfield="attributeName" data-name="attributeId" data-defaultvalue="$!{fcAccPage.attributeId}" >
                </div>
            </div>
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.accOpenTime')</td>
        <td>##开户日期
            <div class="layui-input-inline">
                <input type="text" name="accOpenTime" data-type="date" readonly="readonly" value="$!{fcAccPage.accOpenTime}" class="layui-input bt-biz-dateType" >
            </div>
        </td>
        <td class="textRight">#springMessage('table.fcAcc.accStartDate')</td>
        <td>##启用日期
            <div class="layui-input-inline">
                <input type="text" name="accStartDate" data-type="date" data-biz-name="accStartDate"  lay-verify="required" data-min="$!{accStartDate}"
                       value="$!{fcAccPage.accStartDate}" class="layui-input bt-biz-dateType" data-callback="accStartDateCallback" >
            </div>
        </td>
    </tr>
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.interestInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.interestSign')</td>
        <td width="40%">##计息标志
            <div class="layui-inline">
                #if( $!{fcAccPage.interestSign}=='1' )
                    <input type="radio" lay-filter="interestSign" name="interestSign" value="1" title="#springMessage('table.fcAcc.interestSignOk')" checked="">
                    <input type="radio" lay-filter="interestSign" name="interestSign" value="0" title="#springMessage('table.fcAcc.interestSignNo')"  >
                #else
                    <input type="radio" lay-filter="interestSign" name="interestSign" value="1" title="#springMessage('table.fcAcc.interestSignOk')" >
                    <input type="radio" lay-filter="interestSign" name="interestSign" value="0" title="#springMessage('table.fcAcc.interestSignNo')" checked="">
                #end
            </div>
        </td>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.predrawSign')</td>
        <td width="40%">##预提标志
            <div class="layui-inline">
                <select lay-filter="predrawSign" name="predrawSign">
                    <option value=""></option>
                </select>
                <input type="hidden" name="predrawSignHid" id="predrawSignHid" value="$!{fcAccPage.predrawSign}"/>
            </div>
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.tbLoanRateMaintence.rate')/#springMessage('table.depositRate.baseRate')</td>
        <td>
            <div class="layui-inline">##基准利率/基础利率
                #if( $!{fcAccPage.referenceRateType}=='1' )
                    <input type="radio" lay-filter="referenceRateType" name="referenceRateType" value="0" title="#springMessage('table.tbLoanRateMaintence.rate')">
                    <input type="radio" lay-filter="referenceRateType" name="referenceRateType" value="1" title="#springMessage('table.depositRate.baseRate')" checked>
                #else
                    <input type="radio" lay-filter="referenceRateType" name="referenceRateType" value="0" title="#springMessage('table.tbLoanRateMaintence.rate')" checked>
                    <input type="radio" lay-filter="referenceRateType" name="referenceRateType" value="1" title="#springMessage('table.depositRate.baseRate')">
                #end

            </div>
        </td>
        <td class="textRight">#springMessage('table.fcAcc.interestRate')</td>
        <td>##利率
            <input type="text" id="interestRate" name="interestRate"
                   autocomplete="off" class="layui-input bt-biz-rateType"  data-biz-name="interestRate" placeholder="#springMessage('table.fcAcc.interestRate')"  value="$!{fcAccPage.interestRate}">
        </td>
    </tr>
        ##应付利息账号
        #if( $!{fcAccPage.interestSign}=='1' )
            <tr id="showAcc">
        #else
            <tr id="showAcc" style="display: none">
        #end
            <td class="textRight">#springMessage('table.fcAcc.interestPayAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="interestRecPay" name="interestRecPay" value="$!{fcAccPage.interestRecPay}" lay-verify="tableData" data-biz-name="interestRecPay"
                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fcAcc.interestPayAcc')">
                    <table id="interestRecPayTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.fcAcc.blnctrAcc')</th>##内部账号
                            <th>#springMessage('table.fcAcc.accName')</th>##账户名称
                            <th>#springMessage('table.fcAcc.subjectId')</th>##科目名称
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
            ##利息支出账号
            <td class="textRight">#springMessage('table.fcAcc.interestoutExp')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="interestInExp" name="interestInExp" value="$!{fcAccPage.interestInExp}" lay-verify="tableData" data-biz-name="interestInExp"
                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fcAcc.interestoutExp')">
                    <table id="interestInExpTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.fcAcc.blnctrAcc')</th>##内部账号
                            <th>#springMessage('table.fcAcc.accName')</th>##账户名称
                            <th>#springMessage('table.fcAcc.subjectId')</th>##科目名称
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
        </tr>

    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('cms.loan.OtherInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.overdraftSign')</td>
        ##透支类型
        <td width="40%">
            <div class="layui-inline">
                <select lay-filter="overdraftSign" name="overdraftSign">
                    #foreach($dict in $dictTag.list("fcAcc.overdraftSign"))
                        <option value="$dict.code">$dict.name</option>
                    #end

                </select>
                <input type="hidden" name="overdraftSignHid" id="overdraftSignHid" value="$!{fcAccPage.overdraftSign}"/>
            </div>
        </td>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.overdraftRate')</td>
        ##透支利率
        <td width="40%">
            <input type="text" id="overdraftRate" name="overdraftRate"
                   autocomplete="off" class="layui-input bt-biz-rateType" data-biz-name="overdraftRate" placeholder="#springMessage('table.fcAcc.overdraftRate')" value="$!{fcAccPage.overdraftRate}">
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.overdraftMoney')</td>
        ##透支金额
        <td>
            <input type="text" id="overdraftMoney" name="overdraftMoney" style="text-align:right"
                   autocomplete="off" class="layui-input bt-biz-moneyType" data-biz-name="overdraftMoney" placeholder="#springMessage('table.fcAcc.overdraftMoney')" value="$!{fcAccPage.overdraftMoney}">
        </td>
        #if($!{fcAccPage.poolSign} == "1")
            <td></td>
            <td></td>
        #else
            <td class="textRight">#springMessage('table.fcAcc.chargeAcc')</td>
            <td>##手续费收取账号
                <div class="layui-inline">
                    <select id="chargeAcc" name="chargeAcc">
                        <option></option>
                    </select>
                </div>
                <input type="hidden" name="chargeAccHid" id="chargeAccHid" value="$!{fcAccPage.chargeAcc}"/>
            </td>
        #end
    </tr>
    </tbody>
</table>
<script src="${basePath}/static/modules/inneraccount/fcAcc.common.dynamic.edit.js?_btv=${resourceVersion}"></script>


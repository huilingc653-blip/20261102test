<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
            <tbody>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage('fcAccDetail.corpId')</td>
                    <td width="25%">
                         <div class="layui-inline">
                        	<div class="bt-biz-corp"
                                 data-tree-type="check"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 bt-biz-name="ins_corpId"
                                 data-resource="netbank:innerAccount:fcAccDetail:query"
                                 data-scope="all"></div>
                        </div>
                    </td>
    				##结算方式
                    <td class="textRight">#springMessage('fcAccDetail.voucherType')</td>
                    <td width="25%">
                        <div class="bt-biz-selectType" data-name="eqs_voucherType" data-biz-name="eqs_voucherType"
                             data-valuefield="id" data-textfield="voucherName" data-url="${basePath}/netbank/fcvouchertype/getFcVoucherTypeForReport"></div>

                    </td>
                    ##账号
                        <td class="textRight">#springMessage('fcAccDetail.blnctrAcc')</td>
                        <td>
                            <input type="text" name="likes_account"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('fcAccDetail.blnctrAcc')">
                        </td>
                </tr>
                <tr>
                	##币别
                	<td class="textRight">#springMessage('fcAccDetail.curId')</td>
                	<td>
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                             data-name="eqs_curId" data-biz-name="eqs_curId" data-valueField="id" data-textField="curName"></div>
                	</td>
                	##外单位名称
                	<td class="textRight">#springMessage('fcAccDetail.externalName')</td>
                	<td width="25%">
                        <div class="layui-inline">
                            <input type="text" name="likes_externalName"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('fcAccDetail.externalName')">
                        </div>
                    </td>
                    ##摘要
                	<td class="textRight">#springMessage('fcAccDetail.summaryContent')</td>
                	<td width="25%">
                        <div class="layui-inline">
                            <input type="text" name="likes_summaryContent"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('fcAccDetail.summaryContent')">
                        </div>
                    </td>
                </tr>
				<tr>
                    ##金额
                    <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <input type="text" name="geg_minMoney" id="leg_minMoney" data-name="leg_minMoney" data-minus="true"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.nisBillhead.payMoney')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" name="leg_maxMoney" id="leg_maxMoney" data-name="leg_maxMoney" data-minus="true"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.nisBillhead.payMoney')">
                        </div>
                    </td>
                    ##记账日期
                    <td class="textRight">#springMessage('fcAccDetail.tallyDate')</td>
                    <td width="25%">
                        <div class="layui-inline">
							<div type='date' field="tallyDate" class="tallyDate"></div>
						</div>
                    </td>
                    ##业务类别
                    <td class="textRight">#springMessage('table.fcAcc.accType')</td>
                    <td width="25%">
                        <div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType" data-name="eqs_accType" data-biz-name="eqs_accType" data-filterData="15"></div>
                    </td>
                   </tr>
                   <tr>
                    <td colspan="6" style="text-align: center;">
##                    #if($shiro.hasPermission("netbank:innerAccount:fcAccDetail:query"))
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary" data-callback="resetDate">#springMessage('common.button.reset')</button>
##                    #end
                    </td>
                </tr>
            </tbody>
        </table>

    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="print">
        <thead>
        <tr>
            <th>#springMessage('fcAccDetail.blnctrAcc')</th>
            <th>#springMessage('fcAccDetail.accName')</th>
            <th>#springMessage('fcAccDetail.curId')</th>
            <th>#springMessage('fcAccDetail.interestStartDate')</th>
            <th>#springMessage('fcAccDetail.tallyDate')</th>
            <th>#springMessage('fcAccDetail.voucherNo')</th>
            <th>#springMessage('fcAccDetail.summaryContent')</th>
            <th>#springMessage('table.fcAccbookDtl.debitMoney')</th>
            <th>#springMessage('table.fcAccbookDtl.creditMoney')</th>
            <th>#springMessage('fcAccDetail.voucherType')</th>
            <th>#springMessage('fcAccDetail.balance')</th>
            <th>#springMessage('fcAccDetail.externalName')</th>
            <th>#springMessage('fcAccDetail.externalAcc')</th>
            <th>#springMessage('fcAccDetail.origVoucherNo')</th>
        </tr>
        </thead>
    </table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/inneraccount/fcAccDetailQuery.list.js?_btv=${resourceVersion}"></script>
</html>

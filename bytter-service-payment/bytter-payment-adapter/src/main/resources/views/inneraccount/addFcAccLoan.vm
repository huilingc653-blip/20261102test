<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.accInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.accOpenTime')</td>
        <td width="40%">##开户日期
            <div class="layui-input-inline">
                <input type="text" name="accOpenTime"  readonly="readonly" data-today="true" class="layui-input bt-biz-dateType" >
            </div>
        </td>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.accStartDate')</td>
        <td width="40%">##启用日期
            <div class="layui-input-inline">
                <input type="text" name="accStartDate" data-name="accStartDate" data-biz-name="accStartDate" lay-verify="required" data-min="$!{accStartDate}" value="$!{accStartDate}" class="layui-input bt-biz-dateType" >
            </div>
        </td>
    </tr>
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('table.fcAgreedDeposit.interestInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.interestSign')</td>
        <td width="40%">##计息标志
            <div class="layui-inline">
                <input type="radio" lay-filter="interestSign" name="interestSign" value="1" title="#springMessage('table.fcAcc.interestSignOk')" checked >
                <input type="radio" lay-filter="interestSign" name="interestSign" value="0" title="#springMessage('table.fcAcc.interestSignNo')" >
            </div>
        </td>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.predrawSign')</td>
        <td width="40%">##预提标志
            <div class="layui-inline">
                <select lay-filter="predrawSign" name="predrawSign">
                    <option value=" "></option>
                </select>
            </div>
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.accForDeduct')</td>
        <td>##扣息活期账户
            <div class="layui-inline">
                <select  id="accForDeduct" name="accForDeduct" lay-verify="required" >
                    <option></option>
                </select>
            </div>
        </td>
        <td class="textRight">#springMessage('table.fcAcc.interestRate')</td>
        <td>##利率
            <input type="text" id="interestRate" name="interestRate" value="$!{interestRate}"
                   autocomplete="off"  lay-verify="required" class="layui-input bt-biz-rateType" data-biz-name="interestRate" placeholder="#springMessage('table.fcAcc.interestRate')">
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.interestStartDate')</td>
        <td>##起息日期
            <div class="layui-input-inline">
                <input type="text" name="interestStartDate" data-biz-name="interestStartDate" data-callback="clickNotice" lay-verify="required"   class="layui-input bt-biz-dateType" >
            </div>
        </td>
        <td class="textRight">#springMessage('table.fcAcc.deadlineDate')</td>
        <td>##到期日期
            <div class="layui-input-inline">
                <input type="text" name="deadlineDate" data-biz-name="deadlineDate" lay-verify="required" data-callback="clickNotice" class="layui-input bt-biz-dateType" >
            </div>
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.term')</td>
        <td >##期限
            <div class="layui-input-inline">
                <input type="text" id="notifyType" name="notifyType"
                       decimal="0" readonly="readonly" autocomplete="off" class="layui-input" data-decimal="0"  placeholder="#springMessage('table.fcAcc.term')">
            </div>
            <div class="layui-inline">
                <select data-width="70px" lay-filter="endUnit" name="endUnit">
                    #foreach($dict in $dictTag.list("fcAcc.endUnit"))
                        <option value="$dict.code">$dict.name</option>
                    #end
                </select>
            </div>
        </td>
        <td></td>
        <td></td>
    </tr>
    <tr id="showAcc" style="display: none">
        ##应收利息账号
        <td class="textRight">#springMessage('table.fcloanrepay.needInterestAcc')</td>
        <td>
            <div class="layui-input-inline">
                <input type="text" id="interestRecPay" name="interestRecPay" lay-verify="tableData" data-biz-name="interestRecPay"
                       autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fcloanrepay.needInterestAcc')">
                <table id="interestRecPayTable" class="hide">
                    <thead>
                    <tr>
                        <th>#springMessage('table.fcAcc.blnctrAcc')</th>##内部账号
                        <th>#springMessage('table.fcAcc.accName')</th>##账户名称
                        <th>#springMessage('table.fcAcc.subjectId')</th>##科目名称
                    </tr>
                    </thead>
                </table>
            </div>
        </td>
        ##利息收入账号
        <td class="textRight">#springMessage('table.fcAcc.interestInExp')</td>
        <td>
            <div class="layui-input-inline">
                <input type="text" id="interestInExp" name="interestInExp" lay-verify="tableData" data-biz-name="interestInExp"
                       autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fcAcc.interestInExp')">
                <table id="interestInExpTable" class="hide">
                    <thead>
                    <tr>
                        <th>#springMessage('table.fcAcc.blnctrAcc')</th>##内部账号
                        <th>#springMessage('table.fcAcc.accName')</th>##账户名称
                        <th>#springMessage('table.fcAcc.subjectId')</th>##科目名称
                    </tr>
                    </thead>
                </table>
            </div>
        </td>
    </tr>
    </tbody>
</table>
<table class="layui-table">
    <thead>
    <tr>
        <td colspan="4">#springMessage('cms.loan.OtherInfo')</td>
    </tr>
    </thead>
    <tbody>
    <tr>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.contractNo')</td>
        <td width="40%">##合同编号
            <input type="text" id="contractNo" name="contractNo"

                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAcc.contractNo')">
        </td>
        <td width="10%" class="textRight">#springMessage('table.fcAcc.delayDeadlineDate')</td>
        <td width="40%">##展期到期日期
            <div class="layui-input-inline">
                <input type="text" name="delayDeadlineDate" class="layui-input bt-biz-dateType" >
            </div>
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.delayRate')</td>
        <td>##展期利率
            <input type="text" id="delayRate" name="delayRate"
                   autocomplete="off" class="layui-input bt-biz-rateType" placeholder="#springMessage('table.fcAcc.delayRate')">
        </td>
        <td class="textRight">#springMessage('table.fcAcc.overdueRate')</td>
        <td>##逾期利率
            <input type="text" id="overdueRate" name="overdueRate"

                   autocomplete="off" lay-verify="required" class="layui-input bt-biz-rateType" data-biz-name="overdueRate" placeholder="#springMessage('table.fcAcc.overdueRate')">
        </td>
    </tr>
    </tbody>
</table>
<script src="${basePath}/static/modules/inneraccount/fcAcc.common.dynamic.add.js?_btv=${resourceVersion}"></script>
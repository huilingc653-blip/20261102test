<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{fcFreezePage.id}">
    <input id="unFreezeId" name="unFreezeId" type="hidden" value="$!{fcFreezePage.unFreezeId}">
    <input id="createBy" name="createBy" type="hidden" value="$!{fcFreezePage.createBy}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{fcFreezePage.updateBy}">
    <input id="freezeSign" name="freezeSign" type="hidden" value="C">
    <input id="freezeEndSign" name="freezeEndSign" type="hidden" value="0">
    <input id="opType" name="opType" type="hidden" value="C">
    <table class="layui-table">
        <tbody>
        <tr>
		##网点
            <td class="textRight">#springMessage('table.fcAcc.netId')</td>
            <td >&nbsp;
                ($!{netCode})$!{fcFreezePage.netName}
            </td>

		##单位
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            <td >&nbsp;($!{corpCode})$!{fcFreezePage.corpName}
                <input id="createBy" name="createBy" type="hidden" value="$!{fcFreezePage.corpId}">
            </td>

        </tr>
        <tr>
		##账号
            <td class="textRight">#springMessage('table.fcFreeze.blnctrAcc')</td>
            <td width="40%">&nbsp;$!{fcFreezePage.blnctrAcc}
            </td>
		##通知书编号
            <td class="textRight">#springMessage('table.fcFreeze.freezeNo')</td>
            <td >&nbsp;
              $!{fcFreezePage.freezeNo}
            </td>
        </tr>
        <tr>
		##币别
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td ><span id="curNameSpan">$!{fcFreezePage.curName}</span></td>
            <td class="textRight">#springMessage('table.fcAcc.accName')</td>
            <td ><span id="accNameSpan">$!{fcFreezePage.accName}</span></td>

        </tr>
        <tr>
		##可解冻金额
            <td class="textRight">#springMessage('table.btBankAccFreeze.avalBal')</td>
            <td width="40%"><span id="activeMoneySpan">$number.formatNumeric($!{fcFreezePage.activeMoney})</span></td>
		##累计冻结金额
            <td class="textRight">#springMessage('table.fcFreeze.accuFreezeMoney')</td>
            <td ><span id="accuFreezeMoneySpan">$number.formatNumeric($!{fcFreezePage.accuFreezeMoney})</span></td>
        </tr>
        <tr>
		##冻结类型
            <td class="textRight">#springMessage('table.fcFreeze.freezeType')</td>
            <td >&nbsp;
                 $dictTag.get("fcFreeze.freezeType",$!{fcFreezePage.freezeType})
            </td>
		##冻结金额
            <td class="textRight">#springMessage('table.fcFreeze.freezeMoney')</td>
            <td width="40%">$number.formatNumeric($!{fcFreezePage.freezeMoney})</td>
        </tr>
        <tr>
		##冻结开始时间
            <td class="textRight">#springMessage('table.fcFreeze.beginDate')</td>
            <td >$!date.format('yyyy-MM-dd',$!{fcFreezePage.beginDate})</td>
		##冻结结束时间
            <td class="textRight">#springMessage('table.fcFreeze.endDate')</td>
            <td >$!date.format('yyyy-MM-dd',$!{fcFreezePage.endDate})</td>
        </tr>

        <tr>
		##执行人公务证
            <td class="textRight">#springMessage('table.fcFreeze.execOfficialNo')</td>
            <td >$!{fcFreezePage.execOfficialNo}</td>

		##执行人省份证
            <td class="textRight">#springMessage('table.fcFreeze.execCardNo')</td>
            <td >$!{fcFreezePage.execCardNo}</td>

        </tr>
        <tr>
		##冻结解冻原因
            <td class="textRight">#springMessage('table.fcFreeze.freezeReason')</td>
            <td >$!{fcFreezePage.freezeReason}</td>
        ##冻结解冻机构
            <td class="textRight">#springMessage('table.fcFreeze.freezeOrg')</td>
            <td >$!{fcFreezePage.freezeOrg}</td>
        </tr>
        <tr>
        ##打回原因
            <td class="textRight">#springMessage('table.fcFreeze.refuseWhy')</td>
            <td>
                <textarea placeholder="#springMessage('table.fcFreeze.refuseWhy')" lay-verify="strlength" data-maxlength="150"  rows="4" cols="64" class="layui-textarea" id="refuseWhy" name="refuseWhy">$!{fcFreezePage.refuseWhy}</textarea>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" value="95" lay-filter="submit">#springMessage('common.button.check')</button>
                <button class="layui-btn" lay-submit="" type="button" value="-1" lay-filter="submit">#springMessage('common.button.back')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/inneraccount/fcFreeze.check.js?_btv=${resourceVersion}"></script>
</html>
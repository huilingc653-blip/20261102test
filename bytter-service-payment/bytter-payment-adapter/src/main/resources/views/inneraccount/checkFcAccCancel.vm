<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{fcAccPage.id}">
    <input id="createBy" name="createBy" type="hidden" value="$!{fcAccPage.createBy}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{fcAccPage.updateBy}">
    <input type="hidden"  name="accAccNoRule" id="accAccNoRule" value="$!{fcAccPage.accAccNoRule}"/>
    <input type="hidden"  name="isView" id="isView" value="$!{isView}"/>
    <input type="hidden"  name="busGlobalId" id="busGlobalId" value="$!{busGlobalId}"/>
    <input type="hidden" name="poolSign" id="poolSign" value="$!{fcAccPage.poolSign}"/>
    <table class="layui-table">
        <thead>
        <tr>
            <td colspan="4">#springMessage('table.externalCorp.basicInfo')</td>
        </tr>
        </thead>
        <tbody>
        <tr>
            ##网点
            #if($!{fcAccPage.poolSign} == "1")
                <td class="textRight" width="10%">#springMessage('nis.pool.fcCorpPool.pool')</td>
                <td width="40%" >
                    ($!{netCode})$!{fcAccPage.netPoolName}
                    <input type="hidden" name="netCode" id="netCode"/>
                    <input type="hidden" name="netId" value="$!{fcAccPage.netPoolId}"/>
                </td>
            #else
                <td width="10%" class="textRight">#springMessage('table.fcAcc.netId')</td>
                <td width="40%" >
                    ($!{netCode})$!{fcAccPage.netName}
                    <input type="hidden" name="netCode" id="netCode"/>
                    <input type="hidden" name="netId" value="$!{fcAccPage.netId}"/>
                </td>
            #end
            ##结算中心账号
            <td width="10%" class="textRight">#springMessage('table.fcAcc.blnctrAcc')</td>
            <td width="40%">$!{fcAccPage.blnctrAcc}
                <input type="hidden" name="blnctrAcc" id="blnctrAcc" value="$!{fcAccPage.blnctrAcc}"/>
                <input type="hidden" name="accAccNoRule" id="accAccNoRule" value="$!{fcAccPage.accAccNoRule}"/>
            </td>
        </tr>
        <tr>
            ##币别
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td>$!{fcAccPage.curName}</td>
            ##账户类别
            <td class="textRight">#springMessage('table.fcAcc.accType')</td>
            <td>$!{fcAccPage.accTypeName}
                ##                &nbsp;&nbsp;>>#springMessage("finacial.paramConfig.fcSubject.subjectName"): $!{fcAccPage.subjectName}
                ##科目代码
                <input type="hidden" name="sysSubjectCode" id="sysSubjectCode" value="$!{fcAccPage.sysSubjectCode}"/>
                <input type="hidden" name="accType" id="accType" value="$!{fcAccPage.accType}"/>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.seqNum')</td>
            ##顺序号
            <td><span id="seqNum"></span></td>
            <td class="textRight">#springMessage('table.fcAcc.shortcut')</td>
            ##助记码
            <td>$!{fcAccPage.shortcut}</td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            ##开户单位ID
            <td >&nbsp;
                ($!{corpCode})$!{fcAccPage.corpName}
            </td>
            <td class="textRight">#springMessage('table.fcAcc.accName')</td>
            ##账户名称
            <td>$!{fcAccPage.accName}</td>
        </tr>

        <tr class="bankClass">
            <td class="textRight">#springMessage('table.fcAcc.bankCode')</td>
            ##银行代码
            <td>$!{fcAccPage.bankCode}</td>
            <td class="textRight">#springMessage('table.fcCheckInit.bankAccName')</td>
            ##银行名称
            <td>
                <span id="bankAccName">$!{fcAccPage.bankName}</span>
            </td>
        </tr>
            #if($!{fcAccPage.poolSign} != "1")
            <tr>
                <td class="textRight">#springMessage('table.fcAcc.unionNet')</td>
                ##联行网点
                <td>    #if( $!{unionNetCode}!="" )
                    ($!{unionNetCode})$!{fcAccPage.unionNetName}
                #end

                </td>
                <td class="textRight">#springMessage('table.fcAcc.unionAcc')</td>
                ##联行账号
                <td>$!{fcAccPage.unionAcc}</td>
            </tr>
            #end
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.balanceWay')</td>
            ##余额方向
            <td>$dictTag.get("Admin.BalanceWay","$!{fcAccPage.balanceWay}")</td>
            <td class="textRight">#springMessage('table.fcAcc.ifCompare')</td>
            ##是否对账
            <td>
                $dictTag.get("sf_yn",$!{fcAccPage.ifCompare})
            </td>
        </tr>
            ##计息账号
            #if("07" == $!{fcAccPage.accType})
                ##2011-应付利息-企业活期,5212-利息支出-企业活期,2012-应付利息-企业定期,5211-利息支出-企业定期,2013-应付利息-通知存款,
                ##5213-利息支出-通知存款,2016-应付利息-企业协定,5216-利息支出-企业协定,1032-应收利息-银行活期存款,5012-利息收入-银行活期存款,
                ##2014-应付利息-银行借款,5214-利息支出-银行借款,1031-应收利息-企业放款,5011-利息收入-企业放款
                #if("2011" == $!{fcAccPage.sysSubjectCode} || "5212" == $!{fcAccPage.sysSubjectCode} || "2012" == $!{fcAccPage.sysSubjectCode} || "5211" == $!{fcAccPage.sysSubjectCode} || "2013" == $!{fcAccPage.sysSubjectCode} ||
                    "5213" == $!{fcAccPage.sysSubjectCode} || "2016" == $!{fcAccPage.sysSubjectCode} || "5216" == $!{fcAccPage.sysSubjectCode} || "1032" == $!{fcAccPage.sysSubjectCode} || "5012" == $!{fcAccPage.sysSubjectCode} ||
                    "2014" == $!{fcAccPage.sysSubjectCode} || "5214" == $!{fcAccPage.sysSubjectCode} || "1031" == $!{fcAccPage.sysSubjectCode} || "5011" == $!{fcAccPage.sysSubjectCode})
                <tr>
                    <td class="textRight">#springMessage('inneraccount.fcAcc.interestAcc')</td>
                    <td>
                        $!{fcAccPage.interestAcc}
                    </td>
                    <td></td>
                    <td></td>
                </tr>
                #end
            #end
        </tbody>
    </table>
    <div id="tagFcAcc"></div>
    <div id="tagFcCancelAccount" class="verify"></div>
    <table id="endTable" class="layui-table">
        <tr id="endTrCheckBackReason">
            <td width="10%" class="textRight" >#springMessage('table.fcAcc.checkBackReason')</td>
            <td colspan="6" >
                <div class="layui-input-inline">
                    <textarea placeholder="#springMessage('table.fcAcc.checkBackReason')" rows="4" cols="64" lay-verify="strlength" data-maxlength="150"  class="layui-textarea" id="checkBackReason" name="checkBackReason"></textarea>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" value="D"  lay-filter="submit">#springMessage('common.button.pass')</button>
                <button class="layui-btn" lay-submit="" type="button" value="Z"  lay-filter="submit">#springMessage('common.button.back')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/inneraccount/fcAcc.common.view.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/inneraccount/fcAcc.cancel.check.js?_btv=${resourceVersion}"></script>
</html>
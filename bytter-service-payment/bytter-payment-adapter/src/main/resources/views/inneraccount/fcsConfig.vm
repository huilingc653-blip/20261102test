<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body {
            font-size: 14px;
            padding-bottom: 60px;
        }

        .layui-form-label {
            width: 180px;
        }

        .layui-input-block {
            margin-left: 220px;
        }

    </style>
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.inneraccount.param.titile.fcsConfig')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td width="80%">#springMessage('config.fbs.paramValue')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        ## 账户开户自动复核
                        <td width="20%" class="textRight">#springMessage('config.fcs.accAutoCheck')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-defaultvalue="$!{config.fcs.accAutoCheck}"
                                 data-name="fcs.accAutoCheck" data-biz-name="fcs.accAutoCheck"></div>
                            <i id="accAutoCheck-desc" class="layui-icon">&#xe60b;</i>
                        </td>
                    </tr>
                    <tr>
                        ## 账户改户自动复核
                        <td width="20%" class="textRight">#springMessage('config.fcs.changeAutoCheck')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-defaultvalue="$!{config.fcs.changeAutoCheck}"
                                 data-name="fcs.changeAutoCheck" data-biz-name="fcs.changeAutoCheck"></div>
                            <i id="changeAutoCheck-desc" class="layui-icon">&#xe60b;</i>
                        </td>
                    </tr>
                    <tr>
                        ## 账户冻结自动复核
                        <td class="textRight">#springMessage('config.fcs.freezeAutoCheck')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-defaultvalue="$!{config.fcs.freezeAutoCheck}"
                                 data-name="fcs.freezeAutoCheck" data-biz-name="fcs.freezeAutoCheck"></div>
                            <i id="freezeAutoCheck-desc" class="layui-icon">&#xe60b;</i>
                        </td>
                    </tr>
                    <tr>
                        ## 账户解冻自动复核
                        <td class="textRight">#springMessage('config.fcs.logoutAutoCheck')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-defaultvalue="$!{config.fcs.logoutAutoCheck}"
                                 data-name="fcs.logoutAutoCheck" data-biz-name="fcs.logoutAutoCheck"></div>
                            <i id="logoutAutoCheck-desc" class="layui-icon">&#xe60b;</i>
                        </td>
                    </tr>
                    <tr>
                        ## 账户注销自动复核
                        <td class="textRight">#springMessage('config.fcs.thawAutoCheck')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                                 data-defaultvalue="$!{config.fcs.thawAutoCheck}"
                                 data-name="fcs.thawAutoCheck" data-biz-name="fcs.thawAutoCheck"></div>
                            <i id="thawAutoCheck-desc" class="layui-icon">&#xe60b;</i>
                        </td>
                    </tr>
                    <tr>
                        ## 账号生成规则
                        <td class="textRight">#springMessage('config.inneraccount.accAccnoRule')</td>
                        <td>
                            <div>
                                <div class="bt-biz-dict" data-type="select" data-group="config.fcs.accAccnoRule"
                                     data-width="200px" data-defaultvalue="$!{config.fcs.accAccnoRule}"
                                     data-name="fcs.accAccnoRule" data-biz-name="fcs.accAccnoRule"></div>
                                <i id="accAccnoRule-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 顺序号生成模式
                        <td class="textRight">#springMessage('fcAcc.seqGeneratingMode')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="radio" name="fcs.seqGeneratingMode" value="1"
                                       #if($config.fcs.seqGeneratingMode == 1)checked#end
                                       title="#springMessage('table.fbsBudgetPeriod.autoAenerate')">
                                <input type="radio" name="fcs.seqGeneratingMode" value="0"
                                       #if($config.fcs.seqGeneratingMode == 0)checked#end
                                       title="#springMessage('fcAcc.manuallyFillIn')">
                            </div>
                            <div class="layui-input-inline">
                                <i id="seqGeneratingMode-desc" class="layui-icon">&#xe60b;</i>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        ## 活期存款冻结到期提醒
                        <td class="textRight">#springMessage('config.inneraccount.freezeUnitAlertDays')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" name="fcs.freezeUnitAlertDays" autocomplete="off"
                                       class="layui-input bt-biz-moneyType" data-decimal="0" data-separator=""
                                       value="$!{config.fcs.freezeUnitAlertDays}">
                            </div>
                            <div class="layui-input-inline">#springMessage('config.nis.day')</div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="20%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form', 'jquery', 'dicts', 'moneyType', 'element'], function () {
        var form = bt.form(), $ = bt.jquery;
        bt.element();
        bt.dicts.init();
        bt.moneyType.init();
        //监听提交
        form.on('submit(configSubmit)', function (data) {
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, "JSON");
            return false;
        });

        // 说明显示隐藏
        showDesc();
    });

    function showDesc() {
        var tip_index1 = 0;
        $('#accAutoCheck-desc').mouseenter(function () {
            tip_index1 = layer.tips(bt.lang('config.fcs.accAutoCheck.desc'), '#accAutoCheck-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index1);
        });

        var tip_index2 = 0;
        $('#changeAutoCheck-desc').mouseenter(function () {
            tip_index2 = layer.tips(bt.lang('config.fcs.changeAutoCheck.desc'), '#changeAutoCheck-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index2);
        });

        var tip_index3 = 0;
        $('#freezeAutoCheck-desc').mouseenter(function () {
            tip_index3 = layer.tips(bt.lang('config.fcs.freezeAutoCheck.desc'), '#freezeAutoCheck-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index3);
        });

        var tip_index4 = 0;
        $('#logoutAutoCheck-desc').mouseenter(function () {
            tip_index4 = layer.tips(bt.lang('config.fcs.logoutAutoCheck.desc'), '#logoutAutoCheck-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index4);
        });

        var tip_index5 = 0;
        $('#thawAutoCheck-desc').mouseenter(function () {
            tip_index5 = layer.tips(bt.lang('config.fcs.thawAutoCheck.desc'), '#thawAutoCheck-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index5);
        });

        var tip_index6 = 0;
        $('#accAccnoRule-desc').mouseenter(function () {
            tip_index6 = layer.tips(bt.lang('config.fcs.accAccnoRule.desc'), '#accAccnoRule-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index6);
        });

        var tip_index7 = 0;
        $('#seqGeneratingMode-desc').mouseenter(function () {
            tip_index7 = layer.tips(bt.lang('config.fcs.seqGeneratingMode.desc'), '#seqGeneratingMode-desc', {time: 30000});
        }).mouseleave(function () {
            layer.close(tip_index7);
        });
    }
</script>
</body>
</html>

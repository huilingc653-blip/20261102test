<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="isCheck" id="isCheck" value="0"/>
    <input type="hidden" name="poolSign" id="poolSign" value="$!{poolSign}"/>
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.blnctrAcc')</td>
            <td width="25%">
                <input type="text" name="likes_blnctrAcc"
                       autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.fcAcc.blnctrAcc')">
            </td>
            #if($!{poolSign} == "1")
                <td class="textRight" width="10%">#springMessage('nis.pool.fcCorpPool.pool')</td>
                <td width="25%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-url="" data-name="eqs_netId" data-biz-name="eqs_netId" data-callback="netIdCallback"
                             data-valuefield="id" data-textfield="showName" data-search="true"></div>
                    </div>
                </td>
                <td class="textRight" width="10%">#springMessage('table.btBankAccApp.corpId')</td>
                <td width="25%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-url="" data-name="ins_corpId" data-biz-name="ins_corpId"
                             data-valuefield="corpId" data-textfield="showName" data-search="true"></div>
                    </div>
                </td>
            #else
            <td class="textRight">#springMessage('table.fcAcc.netId')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="net"
                         data-type="selectTree"
                         data-name="eqs_netId"
                         data-group="corpGroup"
                         data-change="ins_corpId"
                         data-resource="netbank:innerAccount:fcAcc:changeQuery"
                         data-scope="net"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-tips="#springMessage('common.placeholder.select')#springMessage('table.fcAcc.netId')"
                         data-group="corpGroup"
                         data-resource="netbank:innerAccount:fcAcc:changeQuery"
                         data-scope="all"></div>
                </div>
            </td>
            #end
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td width="25%">
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name="eqs_curId" data-biz-name="eqs_curId" data-valueField="id" data-textField="curName"></div>
            </td>
            <td class="textRight">#springMessage('table.fcAcc.accState')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-type="select" data-group="inneraccount.fcStatus" data-name="eqs_accState" data-displayData="N,G,F"></div>
            </td>
            <td class="textRight">#springMessage('table.fcAcc.accType')</td>
            <td>
                #if($!{poolSign} == "1")
                    <div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType" data-name="eqs_accType" data-biz-name="eqs_accType" data-displayData="01,02,07"></div>
                #else
                    <div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType" data-name="eqs_accType" data-biz-name="eqs_accType"></div>
                #end
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAcc.accName')</td>
            <td>
                <input type="text" name="likes_accName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.accName')">
            </td>
            ##透支类型
            <td class="textRight">#springMessage('table.fcAcc.overdraftSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="fcAcc.overdraftSign"
                     data-name="eqs_overdraftSign" data-biz-name="overdraftSign" ></div>
            </td>
            ##透支金额
            <td class="textRight">#springMessage('table.fcAcc.overdraftMoney')</td>
            <td>
                <div class="layui-inline">
                    <input data-name="geg_overdraftMoney" data-moneyendid="endOverdraftMoney" class="layui-input bt-biz-moneyType" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input id="endOverdraftMoney" data-name="leg_overdraftMoney" class="layui-input bt-biz-moneyType" type="text">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
               <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
               <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>

</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcAcc.blnctrAcc')</th>
        <th>#springMessage('table.fcAcc.accName')</th>
        #if($!{poolSign} == "1")
            <th>#springMessage('nis.pool.fcCorpPool.pool')</th>
        #else
            <th>#springMessage('table.fcAcc.netId')</th>
        #end
        <th>#springMessage('table.fcAcc.corpId')</th>
        <th>#springMessage('table.fcAcc.curId')</th>
        <th>#springMessage('table.fcAcc.subjectId')</th>
        <th>#springMessage('table.fcAcc.accType')</th>
        <th>#springMessage('table.fcAcc.balanceWay')</th>
        <th>#springMessage('table.fcAcc.accState')</th>
        <th>#springMessage('table.fcAcc.overdraftSign')</th>
        <th>#springMessage('table.fcAcc.overdraftMoney')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/inneraccount/fcAcc.list.change.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight">#springMessage('fcAccDetail.corpId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-checkkboxtype='{ "Y": "", "N": "" }'
                         data-resource="netbank:bank:fcaccsummons:apply"
                         data-scope="all"></div>
                </div>
            </td>
        ##种类
            <td class="textRight">#springMessage('fcAccSummons.subjectId')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="summons.voucherType"
                     data-name="likes_voucherType" data-biz-name="likes_voucherType"></div>
            </td>
        ##凭证号
            <td class="textRight">#springMessage('fcAccSummons.voucherNo')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="likes_voucherNo"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('fcAccSummons.voucherNo')">
                </div>
            </td>
        </tr>
        <tr>
        ##结算方式
            <td class="textRight">#springMessage('fcAccDetail.voucherType')</td>
            <td>
                <div class="bt-biz-selectType" data-name="eqs_voucherId" data-biz-name="eqs_voucherId"
                     data-valuefield="id" data-textfield="voucherName" data-url="${basePath}/netbank/fcvouchertype/json"></div>
            </td>
        ##记账日期
            <td class="textRight">#springMessage('fcAccDetail.tallyDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="ged_tallyDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_tallyDate">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_tallyDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_tallyDate">
                </div>
            </td>
        ##摘要
            <td class="textRight">#springMessage('fcAccDetail.summaryContent')</td>
            <td>
                <input type="text" name="likes_summaryContent"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('fcAccDetail.summaryContent')">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('fcAccSummons.voucherNo')</th>
        <th style="text-align: center">#springMessage('fcAccSummons.money')</th>
        <th>#springMessage('fcAccSummons.subjectId')</th>
        <th>#springMessage('fcAccSummons.voucherType')</th>
        <th>#springMessage('fcAccSummons.tallyDate')</th>
        <th>#springMessage('fcAccSummons.summaryContent')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/inneraccount/fcAccSummonsQuery.list.js?_btv=${resourceVersion}"></script>
</html>

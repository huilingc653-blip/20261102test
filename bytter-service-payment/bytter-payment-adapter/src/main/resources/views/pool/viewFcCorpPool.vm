<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tbody>
			#if($!{fcCorpPoolPage.poolId})
				<tr>
				##子单位代码
					<td class="textRight" width="20%">#springMessage('nis.pool.fcCorpPool.poolsubCorpCode')</td>
					<td width="30%">$!{fcCorpPoolPage.corpCode}</td>
				##子单位名称
					<td class="textRight" width="20%">#springMessage('nis.pool.fcCorpPool.poolsubCorpName')</td>
					<td width="30%">$!{fcCorpPoolPage.corpName}</td>
            	<tr>
				<tr>
				##所属资金池
					<td class="textRight" width="20%">#springMessage('nis.pool.fcCorpPool.pertainPool')</td>
					<td width="30%">$!{fcCorpPoolPage.poolName}</td>
				##资金池状态
					<td class="textRight" width="20%">#springMessage('table.fcCorpPool.status')</td>
					<td width="30%">$dictTag.get("fcCorpPool.status",$!{fcCorpPoolPage.status})</td>
				<tr>
				#else
				<tr>
				##资金池主体单位
					<td class="textRight" width="20%">#springMessage('table.fcCorpPool.corpId')</td>
					<td width="30%">$!{fcCorpPoolPage.corpCode}</td>
				##资金池主体单位名称
					<td class="textRight" width="20%">#springMessage('table.fcCorpPool.corpName')</td>
					<td width="30%">$!{fcCorpPoolPage.corpName}</td>
				</tr>
                <tr>
				##资金池代码
                    <td class="textRight" width="20%">#springMessage('table.fcCorpPool.poolCode')</td>
                    <td width="30%">$!{fcCorpPoolPage.poolCode}</td>
				##资金池名称
                    <td class="textRight" width="20%">#springMessage('table.fcCorpPool.poolName')</td>
                    <td width="30%">$!{fcCorpPoolPage.poolName}</td>
                </tr>
                <tr>
				##资金池状态
                    <td class="textRight" width="20%">#springMessage('table.fcCorpPool.status')</td>
                    <td >$dictTag.get("fcCorpPool.status",$!{fcCorpPoolPage.status})</td>
                    <td colspan="2"></td>
                </tr>
			#end
			<tr>
                <td class="textRight">#springMessage('table.fcCorpPool.rmk')</td>
                <td colspan="3">
                    <textarea type="text" id="rmk" name="rmk" class="layui-textarea" readonly="readonly" placeholder="#springMessage('table.fcCorpPool.rmk')">$!{fcCorpPoolPage.rmk}</textarea>
                </td>
			</tr>
            #*<tr >
                <td colspan="4" style="text-align: center;">
                    <button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>
                </td>
            </tr>*#
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/pool/fcCorpPool.view.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            ##资金池代码
            <td class="textRight">#springMessage('table.fcCorpPool.poolCode')</td>
            <td>
                <input type="text" id="poolCode" name="poolCode" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcCorpPool.poolCode')">
            </td>
            ##资金池名称
            <td class="textRight">#springMessage('table.fcCorpPool.poolName')</td>
            <td>
                <input type="text" id="poolName" name="poolName" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcCorpPool.poolName')">
            </td>
            ##资金池状态
            <td class="textRight">#springMessage('table.fcCorpPool.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="fcCorpPool.status" data-name="status" data-biz-name="status"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" id="search_btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>

<table id="corpTable"></table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/pool/fcCorpPool.list.js?_btv=${resourceVersion}"></script>
</html>
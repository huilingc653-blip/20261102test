<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcCorpPoolPage.id}">
		<input id="poolId" name="poolId" type="hidden" value="$!{fcCorpPoolPage.poolId}">
		<input id="corpId" name="corpId" type="hidden" value="$!{fcCorpPoolPage.corpId}">
		<input id="poolSign" name="poolSign" type="hidden" value="$!{fcCorpPoolPage.poolSign}">
        <table class="layui-table">
            <tbody>
            <tr>
			##资金池主体单位
                <td class="textRight" width="30%">
                    #if($!{fcCorpPoolPage.poolId})
                    ##子单位代码
                        #springMessage('nis.pool.fcCorpPool.poolsubCorpCode')
                    #else
                    ##资金池主体单位
                        #springMessage('table.fcCorpPool.corpId')
                    #end
                </td>
                <td>
                    <input type="text" id="corpCode" name="corpCode" lay-verify="required" readonly="readonly" autocomplete="off" class="layui-input" value="$!{fcCorpPoolPage.corpCode}">
                </td>
                <td class="textRight">
                    #if($!{fcCorpPoolPage.poolId})
                    ##子单位名称
                        #springMessage('nis.pool.fcCorpPool.poolsubCorpName')
                    #else
                    ##资金池主体单位名称
                        #springMessage('table.fcCorpPool.corpName')
                    #end
                </td>
                <td>
                    <input type="text" id="corpName" name="corpName" lay-verify="required" readonly="readonly" autocomplete="off" class="layui-input" value="$!{fcCorpPoolPage.corpName}">
                </td>
            </tr>
                #if($!{fcCorpPoolPage.poolId})
                <tr>
                ##所属资金池
                    <td class="textRight">#springMessage('nis.pool.fcCorpPool.pertainPool')</td>
                    <td>
                        <input type="text" id="poolName" lay-verify="required|strlength" data-maxlength="40" autocomplete="off" class="layui-input"
                               placeholder="#springMessage('nis.pool.fcCorpPool.pertainPool')" value="$!{fcCorpPoolPage.poolName}" readonly="readonly">
                    </td>
                ##状态
                    <td class="textRight">#springMessage('table.fcCorpPool.status')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="fcCorpPool.status" data-defaultvalue="$!{fcCorpPoolPage.status}" data-name="status" data-biz-name="status"></div>
                    </td>
                </tr>
                #else
                <tr>
                ##资金池代码
                    <td class="textRight" width="30%">#springMessage('table.fcCorpPool.poolCode')</td>
                    <td>
                        <input type="text" id="poolCode" name="poolCode" data-maxlength="20" lay-verify="required" autocomplete="off" class="layui-input"
                               placeholder="#springMessage('table.fcCorpPool.poolCode')" readonly="readonly" value="$!{fcCorpPoolPage.poolCode}">
                    </td>
                ##资金池名称
                    <td class="textRight">#springMessage('table.fcCorpPool.poolName')</td>
                    <td>
                        <input type="text" id="poolName" name="poolName" lay-verify="required|strlength" data-maxlength="40" autocomplete="off" class="layui-input"
                               placeholder="#springMessage('table.fcCorpPool.poolName')" value="$!{fcCorpPoolPage.poolName}">
                    </td>
                </tr>
                <tr>
                ##状态
                    <td class="textRight">#springMessage('table.fcCorpPool.status')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="fcCorpPool.status" data-defaultvalue="$!{fcCorpPoolPage.status}" data-name="status" data-biz-name="status" ></div>##data-callback="statusChange"
                    </td>
                    <td colspan="2"></td>
                </tr>
                #end
            <tr>
			##备注
                <td class="textRight">#springMessage('table.fcCorpPool.rmk')</td>
                <td colspan="3">
                    <textarea type="text" id="rmk" name="rmk" class="layui-textarea" lay-verify="strlength" data-maxlength="100" placeholder="#springMessage('table.fcCorpPool.rmk')">$!{fcCorpPoolPage.rmk}</textarea>
                </td>
            </tr>
            <tr >
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    #*<button type="button" onclick="closeTab()" class="layui-btn layui-btn-primary">#springMessage('common.button.close')</button>*#
                </td>
            </tr>
            </tbody>
        </table>
	</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/pool/fcCorpPool.edit.js?_btv=${resourceVersion}"></script>
</html>
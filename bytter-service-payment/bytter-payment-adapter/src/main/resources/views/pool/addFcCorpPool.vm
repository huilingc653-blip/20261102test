<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <input id="poolId" name="poolId" type="hidden" value="$!{fcCorpPoolPage.id}">
        <input id="poolCode" name="poolCode" type="hidden" value="$!{fcCorpPoolPage.poolCode}">
		<table class="layui-table">
			<tbody>
		        <tr>
                    #if($!{fcCorpPoolPage.id})
                        <td class="textRight" width="30%">
                            ##子单位编码
                            #springMessage('nis.pool.fcCorpPool.poolsubCorpCode')
                        </td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-biz-name="corpId"
                                     data-name="corpId"
                                     data-scope="corp"
                                     data-parentId="$!{fcCorpPoolPage.corpId}"
                                     data-resource="netbank:pool:fcCorpPool:apply"
                                     data-required="true"
                                     data-callback="poolCallback"
                                     data-tree-type="radio"
                                     data-beforeInit="corpBefore">
                                </div>
                            </div>
                            </div>
                        </td>
                    #else
                        <td class="textRight" width="30%">
                        ##资金池主体单位
                            #springMessage('table.fcCorpPool.corpId')
                        </td>
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-biz-name="corpId"
                                     data-name="corpId"
                                     data-resource="netbank:pool:fcCorpPool:apply"
                                     data-scope="corp"
                                     data-required="true"
                                     data-callback="poolCallback">
                                </div>
                            </div>
                            </div>
                        </td>
                    #end
                    <td class="textRight">
                        #if($!{fcCorpPoolPage.id})
                        ##子单位名称
                            #springMessage('nis.pool.fcCorpPool.poolsubCorpName')
                        #else
                        ##资金池主体单位名称
                            #springMessage('table.fcCorpPool.corpName')
                        #end
                    </td>
                    <td>
                        <input type="text" id="corpName" name="corpName" lay-verify="required" readonly="readonly" autocomplete="off" class="layui-input">
                    </td>
				</tr>
                    #if($!{fcCorpPoolPage.id})
                    <tr>
                    ##所属资金池
                        <td class="textRight">#springMessage('nis.pool.fcCorpPool.pertainPool')</td>
                        <td>
                            <input type="text"  class="layui-input" id="poolName" readonly="readonly" value="$!{fcCorpPoolPage.poolName}">
                        </td>
                    ##状态
                        <td class="textRight">#springMessage('table.fcCorpPool.status')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="fcCorpPool.status" data-defaultvalue="1" data-name="status" data-biz-name="status"></div>
                        </td>
                    </tr>
                    #else
                    <tr>
                    ##资金池代码
                        <td class="textRight" width="30%">#springMessage('table.fcCorpPool.poolCode')</td>
                        <td>
                            <input type="text" id="poolCode" name="poolCode" lay-verify="required|strlength" data-maxlength="20" autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.fcCorpPool.poolCode')">
                        </td>
                    ##资金池名称
                        <td class="textRight">#springMessage('table.fcCorpPool.poolName')</td>
                        <td>
                            <input type="text" id="poolName" name="poolName" lay-verify="required|strlength" data-maxlength="40" autocomplete="off" class="layui-input"
                                   placeholder="#springMessage('table.fcCorpPool.poolName')" >
                        </td>
                    </tr>
                    <tr>
                    ##状态
                        <td class="textRight">#springMessage('table.fcCorpPool.status')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="radio" data-group="fcCorpPool.status" data-defaultvalue="1" data-name="status" data-biz-name="status"></div>
                        </td>
                        <td colspan="2"></td>
                    </tr>
                    #end
                <tr>
                    <td class="textRight">#springMessage('table.fcCorpPool.rmk')</td>
                    <td colspan="3">
                        <textarea type="text" id="rmk" name="rmk" class="layui-textarea" lay-verify="strlength" data-maxlength="100" placeholder="#springMessage('table.fcCorpPool.rmk')"></textarea>
                    </td>
                </tr>
    			<tr >
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/pool/fcCorpPool.add.js?_btv=${resourceVersion}"></script>
</html>

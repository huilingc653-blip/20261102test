<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="id" name="id" value="$!{nisCorpCashierVO.id}">
    <input type="hidden" name="userIds" value="$!{nisCorpCashierVO.userIds}">
    <table class="layui-table">
        <tbody>
        <tr>
            ## 单位
            <td class="textRight">#springMessage('单位')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="cashierCorpId"
                         data-scope="all"
                         data-biz-name="cashierCorpId"
                         data-resource="netbank:corpCashier:query"
                         data-defaultvalue="$!{nisCorpCashierVO.corpId}"></div>
                </div>
            </td>
            <td colspan="2"></td>

        </tr>
        <tr>
            <td class="textRight">#springMessage('员工编码')</td>
            <td width="40%">
                <input type="text" name="loginName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('员工编码')">
            </td>
            <td class="textRight">#springMessage('员工姓名')</td>
            <td width="40%">
                <input type="text" name="username"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('员工姓名')">
            </td>
        </tr>

        <tr >
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('员工编码')</th>
        <th>#springMessage('员工姓名')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/netbank/nisCorpCashier.add.js?_btv=${resourceVersion}"></script>
</html>

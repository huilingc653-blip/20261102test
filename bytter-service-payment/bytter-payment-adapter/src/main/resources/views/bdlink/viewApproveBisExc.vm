#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<!-- 系统参数 -->
<input id="id" name="id" type="hidden" value="$!{bisExcPage.id}">
<input id="busType" name="busType" type="hidden" value="$!{busType}">
<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell">
        #springMessage('table.bisExc.voucherNo')
        <span class="mui-badge mui-badge-inverted">
            $!{bisExcPage.voucherNo}
        </span>
    </li>
	<li class="mui-table-view-cell">
        #springMessage('table.bisExc.reqDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{bisExcPage.reqDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.bisExc.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{bisExcPage.corpName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.bisExc.voucherTypeId')
        <span class="mui-badge mui-badge-inverted">
            $!{bisExcPage.voucherTypeName}
        </span>
    </li>
##    付款账户
    <li class="mui-table-view-cell  mui-collapse keep-unfold">
        <a class="mui-navigate-right" href="#">
            #springMessage('table.bisExc.payerAcc')
            <span class="mui-badge mui-badge-inverted">
                $!{bisExcPage.payerAcc}
            </span>
        </a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('table.bisExc.payerAccName')
                <span class="mui-badge mui-badge-inverted">
                    $!{bisExcPage.payerAccName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.bisExc.payerBank')
                <span class="mui-badge mui-badge-inverted">
                    $!{bisExcPage.payerBank}
                </span>
            </li>
			<li class="mui-table-view-cell">
                #springMessage('table.bisExc.payeeAddr')
                <span class="mui-badge mui-badge-inverted">
                    $!{bisExcPage.payerProvName} $!{bisExcPage.payerCityName}
                </span>
            </li>
        </ul>
    </li>
	#if($!{bisExcPage.payeeAcc} && $!{bisExcPage.payeeAcc} != "")
##    收款账户
    <li class="mui-table-view-cell  mui-collapse keep-unfold">
        <a class="mui-navigate-right" href="#">
            #springMessage('table.bisExc.payeeAcc')
            <span class="mui-badge mui-badge-inverted">
                $!{bisExcPage.payeeAcc}
        </span>
        </a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('table.bisExc.payeeAccName')
                <span class="mui-badge mui-badge-inverted">
                    $!{bisExcPage.payeeAccName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.bisExc.payeeBank')
                <span class="mui-badge mui-badge-inverted">
                    $!{bisExcPage.payeeBank}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.bisExc.payeeAddr')
                <span class="mui-badge mui-badge-inverted">
                    $!{bisExcPage.payeeProvName} $!{bisExcPage.payeeCityName}
                </span>
            </li>
        </ul>
    </li>
	#end
    <li class="mui-table-view-cell">
        #springMessage('table.bisExc.payMoney')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{bisExcPage.payMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.bisExc.bifCode')
        <span class="mui-badge mui-badge-inverted">
            $!{bisExcPage.bifName}
        </span>
    </li>
	<li class="mui-table-view-cell">
        #springMessage('table.bisExc.curId')
        <span class="mui-badge mui-badge-inverted">
            $!{bisExcPage.curName}
        </span>
    </li>
	<li class="mui-table-view-cell">
        #springMessage('table.bisExc.isQuick')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("sf_yn",$!{bisExcPage.isQuick})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.bisExc.wishPayday')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{bisExcPage.wishPayday})
        </span>
    </li>
	#if($!{bisExcPage.payeeAcc} && $!{bisExcPage.payeeAcc} != "")
    <li class="mui-table-view-cell">
        #springMessage('table.bisExc.difBank')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("nisBillhead.difBank",$!{bisExcPage.difBank})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.bisExc.difBank')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("nisBillhead.areaSign",$!{bisExcPage.areaSign})
        </span>
    </li>
	#end
    <li class="mui-table-view-cell">
        #springMessage('table.bisExc.purpose')
        <span class="mui-badge mui-badge-inverted">
            $!{bisExcPage.purpose}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.bisExc.addWord')
        <span class="mui-badge mui-badge-inverted">
            $!{bisExcPage.addWord}
        </span>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

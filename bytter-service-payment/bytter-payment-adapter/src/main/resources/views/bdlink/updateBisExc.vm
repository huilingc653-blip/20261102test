<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{bisExcPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{bisExcPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{bisExcPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{bisExcPage.updateDate}">
		<input id="status" name="status" type="hidden" value="$!{bisExcPage.status}">
		<input id="id" name="id" type="hidden" value="$!{bisExcPage.id}">
        <input id="voucherNo" name="voucherNo" type="hidden" value="$!{bisExcPage.voucherNo}">
		<input id="cbsBillId" name="cbsBillId" type="hidden" value="$!{bisExcPage.cbsBillId}">
		<input id="voucherStat" name="voucherStat" type="hidden" value="$!{bisExcPage.voucherStat}">
		<input id="transMode" name="transMode" type="hidden" value="$!{bisExcPage.transMode}">
		<input id="payerProvShow" name="payerProvShow" type="hidden" value="$!{bisExcPage.payerProv}">
		<input id="payerCityShow" name="payerCityShow" type="hidden" value="$!{bisExcPage.payerCity}">
		<input id="payeeProvShow" name="payeeProvShow" type="hidden" value="$!{bisExcPage.payeeProv}">
		<input id="payeeCityShow" name="payeeCityShow" type="hidden" value="$!{bisExcPage.payeeCity}">
		<input id="bankNamePrefix" name="bankNamePrefix" type="hidden" value="">
        <input type="hidden" id="corpIdDef" value="$!{bisExcPage.corpId}">
        <input type="hidden" id="curIdDef" value="$!{bisExcPage.curId}">
        <input type="hidden" id="bifCodeDef" value="$!{bisExcPage.bifCode}">
        <input type="hidden" id="voucherTypeIdDef" value="$!{bisExcPage.voucherTypeId}">

        <input type="hidden" id="sysVoucherCode" value="">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##单位
				<td class="textRight">#springMessage('table.bisExc.corpId')</td>
				<td width="40%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-tree-type="radio"
                             data-name="corpId"
                             data-biz-name="corpId"
                             data-scope="all"
                             data-required="true"
                             data-defaultvalue="$!{bisExcPage.corpId}"
                             data-resource="netbank:bdLink:bisExc:salePaymentApply"
                             data-beforeInit="beforeInitCorp"
                             data-callback="bt.corpCallback"></div>
                    </div>
				</td>
				##申请日期
				<td class="textRight">#springMessage('table.bisExc.reqDate')</td>
				<td width="40%">
					<div class="layui-input-inline">
						<input type="text" name="reqDate" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{bisExcPage.reqDate}" data-type="date">
                    </div>
				</td>		
			</tr>
			<tr>
        		##接口代码
                <td class="textRight">#springMessage('table.bisExc.bifCode')</td>
                <td >
                    <div class="layui-inline">
						<div type="list" data-name="bifCode" class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/json" data-valueField="id" data-textField="name"
							data-defaultvalue="$!{bisExcPage.bifCode}" data-required="true" data-search="true" data-callback="bt.bifCodeCallback"></div>
                    </div>
                </td>
        		##币别
				<td class="textRight">#springMessage('table.bisExc.curId')</td>
				<td width="40%">
					<div class="layui-input-inline">
						<div type="list" data-name ="curId" class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-valueField="id" data-textField="curName"
							data-defaultvalue="$!{bisExcPage.curId}" data-required="true" data-search="true" data-callback="bt.curCallback"></div>
                    </div>
				</td>	
			</tr>
        	<tr>
        		##付款方式
				<td class="textRight">#springMessage('table.bisExc.voucherTypeId')</td>
				<td width="40%">
					<div class="layui-input-inline">
						<div type="list" data-name ="voucherTypeId" class="bt-biz-selectType" data-url="${basePath}/netbank/fcvouchertype/specialVoucherType" data-valueField="id" data-textField="voucherName"
                             data-biz-name ="voucherTypeId" data-defaultvalue="$!{bisExcPage.voucherTypeId}" data-required="true" data-search="true" data-callback="bt.voucherTypeCallback"></div>
                    </div>
				</td>
        		##加急标志
				<td class="textRight">#springMessage('table.bisExc.isQuick')</td>
				<td width="40%">
					<div class="layui-input-inline">
                		#set ($mymap = {"field":"isQuick","type":"radio","typeGroupCode":"sf_yn","defaultVal":"$!{bisExcPage.isQuick}","title":"table.bisExc.isQuick"})
						#set ($formB = $dictSelect.instance($mymap))
						${formB.html()}
                    </div>
				</td>
			</tr>
        	<tr>
        		##付款账号
				<td class="textRight">#springMessage('table.bisExc.payerAcc')</td>
				<td >
					<div class="layui-input-inline">
                        <input type="text" id="payerAcc" name="payerAcc" lay-verify="required|tableData" value="$!{bisExcPage.payerAcc}" data-biz-name="payerAcc"
    						    autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.payerAcc')">
    					<table id="payerAccTable" class="hide">
        			        <thead>
        			            <tr>
        			                <th>#springMessage('table.bisExc.payerAcc')</th>
        			                <th>#springMessage('table.bisExc.payerAccName')</th>
        			                <th>#springMessage('table.bisExc.payerBank')</th>
									<th>#springMessage('table.bisExc.curId')</th>
        			            </tr>
        			        </thead>
        			    </table>
					</div>
				</td>
				##付款账号名称
				<td class="textRight">#springMessage('table.bisExc.payerAccName')</td>
				<td >
                    <input type="text" id="payerAccName" name="payerAccName" readonly="readonly" value="$!{bisExcPage.payerAccName}"
						    autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.payerAccName')">
				</td>
			</tr>
        	<tr>
        		##付款开户行名称
				<td class="textRight">#springMessage('table.bisExc.payerBank')</td>
				<td >
						<input id="payerBankCode" name="payerBankCode" type="hidden" value="">
                        <input type="text" id="payerBank" name="payerBank" readonly="readonly" value="$!{bisExcPage.payerBank}"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.payerBank')">
				</td>
				##省市
				<td class="textRight"><div id="payerAddrDiv">#springMessage('table.bisExc.payerAddr')</div></td>
				<td width="40%">
					<div class="layui-input-block" id="payerAddr">
            			<div class="layui-input-inline bt-biz-region" data-group="payerAddr" data-name="payerProv" data-change="payerCity" data-defaultvalue="$!{bisExcPage.payerProv}" data-required="true" data-callback="bt.payerProvCallback"></div>
						<div class="layui-input-inline bt-biz-region" data-group="payerAddr" data-name="payerCity" data-defaultvalue="$!{bisExcPage.payerCity}" data-required="true" data-callback="bt.payerCityCallback"></div>
                    </div>
				</td>	
			</tr>
			<tr>
        		##对应的内部账号
				<td class="textRight">#springMessage('table.bisExc.counterAcc')</td>
				<td width="40%">
					<div class="layui-input-inline">
                		<input type="text" id="counterAcc" name="counterAcc"  readonly="readonly" value="$!{bisExcPage.counterAcc}"
						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.counterAcc')">
                    </div>
				</td>
				##对应的内部账号户名
				<td class="textRight"><!--#springMessage('table.bisExc.counterAccName')--></td>
				<td width="40%">
					<div class="layui-input-inline">
						<!--<input type="text" id="counterAccName" name="counterAccName" readonly="readonly" value="$!{bisExcPage.counterAccName}"
						 autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.counterAccName')">-->
                    </div>
				</td>				
        	</tr>
        	<tr>
            ##收款账号
                <td class="textRight">#springMessage('table.bisExc.payeeAcc')</td>
                <td >
                    <div class="layui-input-inline" id="payeeAccDiv">
                        <input type="text" id="payeeAcc" name="payeeAcc" lay-verify="required" value="$!{bisExcPage.payeeAcc}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payeeAcc')">
                        <div class="bt-div-search">
                            <button  class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button" data-beforeClick="bt.externalCorpBankAccParams" data-callback="bt.externalCorpCallback" title="#springMessage('common.button.select')">
                                <i class="layui-icon">&#xe615;</i>
                            </button>
                        </div>
                    </div>
                    <div class="layui-input-inline" id="payeeAccTempDiv" style="display:none">
                        <input type="text" id="payeeAccTemp" name="payeeAcc" lay-verify="required|tableData" data-biz-name="payeeAccTemp" value="$!{bisExcPage.payeeAcc}"
                               autocomplete="off" class="layui-input text" placeholder="#springMessage('table.nisBillhead.payeeAcc')">
                        <table id="payeeAccTable" class="hide">
                            <thead>
                            <tr>
                                <th>#springMessage('table.bisExc.payeeAcc')</th>
                                <th>#springMessage('table.bisExc.payeeAccName')</th>
                                <th>#springMessage('table.bisExc.payeeBank')</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </td>
        		##收款账号名称
				<td class="textRight">#springMessage('table.bisExc.payeeAccName')</td>
				<td >
                    <input type="text" id="payeeAccName" name="payeeAccName" value="$!{bisExcPage.payeeAccName}"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.payeeAccName')">
				</td>
			</tr>
        	<tr>
        		##收款开户行名称
				<td class="textRight">#springMessage('table.bisExc.payeeBank')</td>
				<td >
					<div class="layui-input-inline">
						<input type="text" id="payeeBankCode" name="payeeBankCode" readonly="readonly" value="$!{bisExcPage.payeeBankCode}"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.payeeBankCode')">
                        <div class="bt-div-search">
                            <button class="bt-biz-bankInfo" id="selPayeeBankBut" type="button"  data-callback="bt.bankinfoCallback" title="#springMessage('common.button.select')">
                                <i class="layui-icon">&#xe615;</i>
                            </button>
                        </div>
                    </div>
					<div class="layui-input-inline">
						<input type="text" id="payeeBank" name="payeeBank" value="$!{bisExcPage.payeeBank}" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.payeeBank')">
					</div>
				</td>
        		##省市
				<td class="textRight"><div id="payeeAddrDiv">#springMessage('table.bisExc.payeeAddr')</div></td>
				<td width="40%">
					<div class="layui-input-inline" id="payeeAddr">
            			<div class="layui-input-inline bt-biz-region" data-group="payeeAddr" readonly="readonly" data-name="payeeProv" data-change="payeeCity" data-defaultvalue="$!{bisExcPage.payeeProv}" data-required="true" data-callback="bt.payeeProvCallback"></div>
						<div class="layui-input-inline bt-biz-region" data-group="payeeAddr" readonly="readonly" data-name="payeeCity" data-defaultvalue="$!{bisExcPage.payeeCity}" data-required="true" data-callback="bt.payeeCityCallback"></div>
                    </div>
				</td>	
			</tr>
        	<tr>
				##金额
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
				<td width="40%">
					<div class="layui-input-inline">
                		<input type="text" id="payMoney" name="payMoney" lay-verify="required|number2" data-name="payMoney" value="$!{bisExcPage.payMoney}"  data-toUp="payMoneyUp"
						 autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" placeholder="#springMessage('table.nisBillhead.payMoney.lower')">
                    </div>
				</td>
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
				<td width="40%" style="padding-left:0px">
					<div id="payMoneyUp"></div>
				</td>
			</tr>
        	<tr id="difBankDiv">
        		##跨行标志
				<td class="textRight">#springMessage('table.bisExc.difBank')</td>
				<td width="40%">
					<div class="layui-input-inline">
                		#set ($mymap = {"field":"difBank","type":"radio","typeGroupCode":"nisBillhead.difBank","defaultVal":"$!{bisExcPage.difBank}","title":"table.bisExc.difBank"})
						#set ($formB = $dictSelect.instance($mymap))
						${formB.html()}
                    </div>
				</td>
				##地域标志
				<td class="textRight">#springMessage('table.bisExc.areaSign')</td>
				<td width="40%">
					<div class="layui-input-inline">
						#set ($mymap = {"field":"areaSign","type":"radio","typeGroupCode":"nisBillhead.areaSign","defaultVal":"$!{bisExcPage.areaSign}","title":"table.bisExc.areaSign"})
						#set ($formB = $dictSelect.instance($mymap))
						${formB.html()}	
                    </div>
				</td>				
        	</tr>
        	<tr>
        		##用途
				<td class="textRight">#springMessage('table.bisExc.purpose')</td>
				<td >
					<div class="layui-input-inline">
						<input type="hidden" id="purposeDef" value="$!{bisExcPage.purpose}">
						<select name="purpose" id="purpose" lay-verify="required" lay-search="" data-inputvalue="true">
    		            	<option value=" "></option>
							<option value="inputText"></option>
    		            </select>
					</div>
				</td>
        		##附言
				<td class="textRight">#springMessage('table.bisExc.addWord')</td>
				<td >
					<!--number-->
                    <input type="text" id="addWord" name="addWord" value="$!{bisExcPage.addWord}"
						    autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.addWord')">
				</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
					<button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/blackWhite/blackWhiteBase.check.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bdlink/bisExc.edit.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/common/caData.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<div id="print">
		<input id="id" name="id" type="hidden" value="$!{bisExcPage.id}">
		<input id="busType" name="busType" type="hidden" value="$!{busType}">
		<input id="wishPayday" name="wishPayday" type="hidden" value="$!{bisExcPage.wishPayday}">
		<table class="layui-table">
			<thead>
            <tr>
                <th colspan="6" style="text-align:center">#springMessage('table.bisExc.viewTitle')</th>
			</tr>
			</thead>
			<tbody>
			<tr>
        		##指令编号
				<td class="textRight" colspan="2">#springMessage('table.bisExc.voucherNo')</td>
				<td width="35%">$!{bisExcPage.voucherNo}</td>
				##申请日期
				<td class="textRight" colspan="2">#springMessage('table.bisExc.reqDate')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{bisExcPage.reqDate})</td>		
        	</tr>
            <tr>
            ##单位
                <td class="textRight" colspan="2">#springMessage('table.bisExc.corpId')</td>
                <td width="35%">$!{bisExcPage.corpName}</td>
            ##付款方式
                <td class="textRight" colspan="2">#springMessage('table.bisExc.voucherTypeId')</td>
                <td width="35%">$!{bisExcPage.voucherTypeName}</td>
            </tr>
			<tr>
                <td rowspan="4" width="2%" align="center">#springMessage('table.nisAllocationReq.payerInfo')</td>
        		##付款账号
				<td class="textRight">#springMessage('table.bisExc.payerAcc')</td>
				<td width="35%">$!{bisExcPage.payerAcc}</td>
                <td rowspan="4" width="2%" align="center">#springMessage('table.nisAllocationReq.payeeInfo')</td>
                ##收款账号
                <td class="textRight">#springMessage('table.bisExc.payeeAcc')</td>
                <td width="35%">$!{bisExcPage.payeeAcc}</td>
        	</tr>
            <tr>
            ##付款账号名称
                <td class="textRight">#springMessage('table.bisExc.payerAccName')</td>
                <td width="35%">$!{bisExcPage.payerAccName}</td>
            ##收款账号名称
                <td class="textRight">#springMessage('table.bisExc.payeeAccName')</td>
                <td width="35%">$!{bisExcPage.payeeAccName}</td>
            </tr>
			<tr>
        		##付款开户行
				<td class="textRight">#springMessage('table.bisExc.payerBank')</td>
				<td width="35%">$!{bisExcPage.payerBank}</td>
                ##收款开户行
                <td class="textRight">#springMessage('table.bisExc.payeeBank')</td>
                <td width="35%">$!{bisExcPage.payeeBankCode} $!{bisExcPage.payeeBank}</td>
        	</tr>
			<tr>
                 ##付款方所在省市
                <td class="textRight">#springMessage('table.bisExc.payerAddr')</td>
                <td width="35%">$!{bisExcPage.payerProvName} $!{bisExcPage.payerCityName}</td>
				##收款方所在省市
				<td class="textRight"><div id="payeeAddrDiv">#springMessage('table.bisExc.payeeAddr')</div></td>
				<td width="35%">$!{bisExcPage.payeeProvName} $!{bisExcPage.payeeCityName}</td>				
        	</tr>
        	<tr>
        		##银企接口
				<td class="textRight" colspan="2">#springMessage('table.bisExc.bifCode')</td>
				<td width="35%">$!{bisExcPage.bifName}</td>
				##币别
				<td class="textRight" colspan="2">#springMessage('table.bisExc.curId')</td>
				<td width="35%">$!{bisExcPage.curName}</td>				
        	</tr>
			<tr>
        		##金额
				<td class="textRight" colspan="2">#springMessage('table.nisBillhead.payMoney.lower')</td>
				<td width="35%">
					$!number.formatNumeric($!{bisExcPage.payMoney})
					<input type="hidden" data-name="payMoney" data-toUp="payMoneyUp" autocomplete="off"
						class="layui-input bt-biz-moneyType" value="$!{bisExcPage.payMoney}">
				</td>
				<td class="textRight" colspan="2">#springMessage('table.nisBillhead.payMoney.upper')</td>
				<td width="35%" style="padding-left:0px"><div id="payMoneyUp"></div></td>
        	</tr>
			<tr>
        		##加急标志
				<td class="textRight" colspan="2">#springMessage('table.bisExc.isQuick')</td>
				<td width="35%">
					<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{bisExcPage.isQuick}" data-name="isQuick" data-biz-name="isQuick" data-required = "true"></div>
				</td>
				##期望支付日期
				<td class="textRight" colspan="2">#springMessage('table.bisExc.wishPayday')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{bisExcPage.wishPayday})</td>				
        	</tr>
			#if($!{bisExcPage.payeeAcc} && $!{bisExcPage.payeeAcc} != "")
			<tr id="difBankDiv">
        		##跨行标志
				<td class="textRight" colspan="2">#springMessage('table.bisExc.difBank')</td>
				<td width="35%">
##					$dictTag.get("nisBillhead.difBank",$!{bisExcPage.difBank})
					<div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.difBank" data-defaultvalue="$!{bisExcPage.difBank}" data-name="difBank" data-biz-name="difBank" data-required = "true"></div>
				</td>
				##地域标志
				<td class="textRight" colspan="2">#springMessage('table.bisExc.areaSign')</td>
				<td width="35%">
##					$dictTag.get("nisBillhead.areaSign",$!{bisExcPage.areaSign})
					<div class="bt-biz-dict" data-type="radio" data-group="nisBillhead.areaSign" data-defaultvalue="$!{bisExcPage.areaSign}" data-name="areaSign" data-biz-name="areaSign" data-required = "true"></div>
				</td>
        	</tr>
			#end
			<tr>
        		##用途
				<td class="textRight" colspan="2">#springMessage('table.bisExc.purpose')</td>
				<td width="35%">
##					$!{bisExcPage.purpose}
					<div class="layui-input-inline">
						<input type="text" id="purpose" name="purpose"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.addWord')" value="$!{bisExcPage.purpose}">
					</div>
				</td>
				##附言
				<td class="textRight" colspan="2">#springMessage('table.bisExc.addWord')</td>
				<td width="35%">
##					$!{bisExcPage.addWord}
					<div class="layui-input-inline">
						<input type="text" id="addWord" name="addWord"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.addWord')" value="$!{bisExcPage.addWord}">
					</div>
				</td>
        	</tr>
			<tr>
        		##交易状态
				<td class="textRight" colspan="2">#springMessage('table.bisExc.voucherStat')</td>
				<td width="35%">$dictTag.get("bisExc.voucherStat",$!{bisExcPage.voucherStat})</td>
				##交易时间
				<td class="textRight" colspan="2">#springMessage('table.bisExc.transTime')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{bisExcPage.transTime})</td>
        	</tr>
			<tr>
        		##银行返回时间
				<td class="textRight" colspan="2">#springMessage('table.bisExc.returnTime')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{bisExcPage.returnTime})</td>
				##银行流水号
				<td class="textRight" colspan="2">#springMessage('table.bisExc.bankSerialNo')</td>
				<td width="35%">$!{bisExcPage.bankSerialNo}</td>
        	</tr>
            <tr>
			##对公对私标志
                <td class="textRight" colspan="2">#springMessage('table.bisExc.transMode')</td>
                <td width="35%">$dictTag.get("bisexc.TransMode",$!{bisExcPage.transMode})</td>
			##
                <td class="textRight" colspan="2"></td>
                <td width="35%"></td>
            </tr>
			<tr>
        		##返回信息
				<td class="textRight" colspan="2">#springMessage('table.bisExc.firstReturnMsg')</td>
				<td width="35%" colspan="4">$!{bisExcPage.firstReturnMsg}</td>
        	</tr>
			<tr>
				##返回信息
				<td class="textRight" colspan="2">#springMessage('table.bisExc.nextReturnMsg')</td>
				<td width="35%" colspan="4">$!{bisExcPage.nextReturnMsg}</td>
        	</tr>
			</tbody>
        </table>
		</div>
		<!-- 日志 -->
		<div id="tagMsg"></div>
        <p>
        <div class="layui-form-item layui-form-submit" id="buttonDiv">
			<div class="layui-input-block">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.send')</button>
				<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{bisExcPage.id}')">#springMessage('common.button.trackFlow')</button>
				<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
			</div>
        </div>
	</form>
    #parse("views/common/footer.vm")
	#caDataHidden()
	#caDataScript()
</body>
<script >
bt.use(['form','layedit','printType','date','moneyType','dicts'], function(){
    var $ = bt.jquery,form = bt.form();
	bt.printType.init();
	bt.moneyType.init();
	bt.dicts.init();
	/**
     * 生成日志列表
     * @return
     */
	$genMsgHtml= function() {
		var url=basePath + "/netbank/nismessage/list/"+$('#id').val()+"/"+$("#busType").val();
        $.ajax({
            url:url,
            method: 'GET',
            async:false,
            success: function (json) {
                $("#tagMsg").html("");
                $("#tagMsg").html(json);
                form.render();
            }
        });
    }
	$genMsgHtml();
	//监听提交
	form.on('submit(submit)', function (data) {
		var id = $("#id").val();
		var isQuick = data.field.isQuick;
		var difBank = bt.dicts.get("difBank").val();
		var areaSign = bt.dicts.get("areaSign").val();
		var purpose = $("#purpose").val();
		var addWord = $("#addWord").val();
		//校验期望支付日期是否超过系统当前日期，给出相应的提示
		var msg = "common.message.confirm.send";
		var wishPayday = bt.date.format($("#wishPayday").val(), 'yyyy-MM-dd');
		var nowDate = bt.date.format(new Date(), 'yyyy-MM-dd');
		if (bt.date.compare(wishPayday, nowDate) > 0) {
			msg = "bdlink.message.wishpayday.send";
		}
		$.ajax({
			url: basePath + "/bdlink/bisexc?rePay",
			method: 'POST',
			async: false,
			data: {
				id: id
			},
			dataType: 'json',
			success: function (result) {
				if(result.success == true){
					msg = result.msg;
				}
			}
		});
		//证书签名
		var signDataMsg = signData("付款指令发送", 6);
		if (signDataMsg != "") {
			bt.loading.hide();
			layer.alert(bt.lang(signDataMsg), {icon: 2});
			return false;
		}
		parent.layer.confirm(bt.lang(msg), function () {
			bt.loading.show();
			$.post(basePath + "/bdlink/bisexc/sendAndUpdate/" + id+"/"+isQuick+"/"+difBank+"/"+areaSign
					+"/"+purpose+"/"+addWord, function (result) {
				bt.loading.hide();
				parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}, function () {
					parent.layer.closeAll();
					if (result.success) {
						if (bt.navtab) {
							bt.navtab.closeCurrent();
						} else {
							parent.layer ? parent.layer.closeAll() : layer.closeAll();
						}
					}
				});
			}, 'JSON');
		});
		return false;
	});
});
</script>
</html>
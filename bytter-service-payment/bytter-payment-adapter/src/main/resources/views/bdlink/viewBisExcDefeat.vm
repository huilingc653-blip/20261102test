<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<input id="id" name="id" type="hidden" value="$!{bisExcPage.id}">
		<table class="layui-table">
			<thead>
            <tr>
                <th colspan="2" style="text-align:center">#springMessage('table.bisExc.viewFailReasonTitle')</th>
			</tr>
			</thead>
			<tbody>
			<tr>
        		##指令编号
				<td class="textRight" width="35%">#springMessage('table.bisExc.voucherNo')</td>
				<td>$!{bisExcPage.voucherNo}</td>
        	</tr>
            <tr>
			<tr>
        		##付款账号
				<td class="textRight" width="35%">#springMessage('table.bisExc.payerAcc')</td>
				<td>$!{bisExcPage.payerAcc}</td>
        	</tr>
			<tr>
        		##金额
				<td class="textRight" width="35%">#springMessage('table.nisBillhead.payMoney.lower')</td>
				<td>
					$!number.formatNumeric($!{bisExcPage.payMoney})
				</td>
        	</tr>
			<tr>
        		##失败原因
				<td class="textRight" width="35%">#springMessage('table.bisExc.failReason')</td>
				<td>
                    <input type="text" id="failReason" name="failReason" value="$!{bisExcPage.failReason}"  lay-verify="required|strlength" data-maxlength="30"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.failReason')">
				</td>
        	</tr>
            <tr>
                <td colspan="2" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script >
bt.use(['form','layedit','moneyType'], function(){
    var $ = bt.jquery,form = bt.form();
    var moneyType = bt.moneyType.init();
    var moneyFun = bt.moneyType.getFun();

    //监听提交
    form.on('submit(submit)', function (data) {
        bt.loading.show();
        var action = "/bdlink/bisexc/saveFailReason";
        $.post(basePath + action, data.field, function (result) {
            bt.loading.hide();
            parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}, function () {
                parent.layer.closeAll();
                if (result.success) {
                    if (bt.navtab) {
                        bt.navtab.refreshParent();
                        bt.navtab.refreshCurrent();
                    } else {
                        parent.layer ? parent.layer.closeAll() : layer.closeAll();
                    }
                }
            })
        }, 'JSON');
        return false;
    });
});
</script>
</html>
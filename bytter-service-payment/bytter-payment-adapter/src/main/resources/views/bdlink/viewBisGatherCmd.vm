<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<div id="print">
		<input id="id" name="id" type="hidden" value="$!{bisGatherCmdPage.id}">
		<input id="busType" name="busType" type="hidden" value="$!{busType}">
		<table class="layui-table">
			<thead>
            <tr>
                <th colspan="4" style="text-align:center">#springMessage('table.bisGatherCmd.viewTitle')</th>
			</tr>
			</thead>
			<tbody>
			<tr>
        		##指令编号
				<td class="textRight">#springMessage('table.bisGatherCmd.voucherNo')</td>
				<td width="35%">$!{bisGatherCmdPage.voucherNo}</td>
				##申请日期
				<td class="textRight">#springMessage('table.bisGatherCmd.runTime')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{bisGatherCmdPage.runTime})</td>		
        	</tr>
			<tr>
            ##收款账号
                <td class="textRight">#springMessage('table.bisGatherCmd.parentAcc')</td>
                <td width="35%">$!{bisGatherCmdPage.parentAcc}</td>
        		##付款账号
                <td class="textRight">#springMessage('table.bisGatherCmd.childAcc')</td>
                <td width="35%">$!{bisGatherCmdPage.childAcc}</td>
        	</tr>
            <tr>
            ##收款账号名称
                <td class="textRight">#springMessage('table.bisGatherCmd.parentAccName')</td>
                <td width="35%">$!{bisGatherCmdPage.parentAccName}</td>
            ##付款账号名称
                <td class="textRight">#springMessage('table.bisGatherCmd.childAccName')</td>
                <td width="35%">$!{bisGatherCmdPage.childAccName}</td>
            </tr>
			<tr>
            ##收款开户行
                <td class="textRight">#springMessage('table.bisGatherCmd.parentBank')</td>
                <td width="35%">$!{bisGatherCmdPage.parentBank}</td>
        		##付款开户行
                <td class="textRight">#springMessage('table.bisGatherCmd.childBank')</td>
                <td width="35%">$!{bisGatherCmdPage.childBank}</td>
        	</tr>
			<tr>
				##收款方所在省市
                <td class="textRight">#springMessage('table.bisGatherCmd.payerAddr')</td>
                <td width="35%">$!{bisGatherCmdPage.parentProvName} $!{bisGatherCmdPage.parentCityName}</td>
                ##付款方所在省市
                <td class="textRight">#springMessage('table.bisGatherCmd.childAddr')</td>
                <td width="35%">$!{bisGatherCmdPage.childProvName} $!{bisGatherCmdPage.childCityName}</td>
        	</tr>
			<tr>
				##银企接口
				<td class="textRight">#springMessage('table.bisGatherCmd.bifCode')</td>
				<td width="35%">$!{bisGatherCmdPage.bifName}</td>	
				##币别
				<td class="textRight">#springMessage('table.bisGatherCmd.curId')</td>
				<td width="35%">$!{bisGatherCmdPage.curName}</td>
        	</tr>
			<tr>
				##金额
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
				<td width="35%">
                    $!number.formatNumeric($!{bisGatherCmdPage.gatherAmt})
					<input type="hidden" data-name="gatherAmt" data-toUp="gatherAmtUp" autocomplete="off" 
						class="layui-input bt-biz-moneyType" value="$!{bisGatherCmdPage.gatherAmt}">
				</td>
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
				<td width="35%" style="padding-left:0px"><div id="gatherAmtUp"></div></td>
        	</tr>
			<tr>
        		##加急标志
				<td class="textRight">#springMessage('table.bisGatherCmd.isQuick')</td>
				<td width="35%">$dictTag.get("sf_yn",$!{bisGatherCmdPage.isQuick})</td>
				##业务类型
				<td class="textRight">#springMessage('table.bisGatherCmd.busOriType')</td>
				<td width="35%">$dictTag.get("bisGatherCmd.busOriType",$!{bisGatherCmdPage.busOriType})</td>				
        	</tr>
			<tr id="difBankDiv">
        		##跨行标志
				<td class="textRight">#springMessage('table.bisGatherCmd.difBank')</td>
				<td width="35%">$dictTag.get("nisBillhead.difBank",$!{bisGatherCmdPage.difBank})</td>
				##地域标志
				<td class="textRight">#springMessage('table.bisGatherCmd.areaSign')</td>
				<td width="35%">$dictTag.get("nisBillhead.areaSign",$!{bisGatherCmdPage.areaSign})</td>				
        	</tr>
			<tr>
        		##用途
				<td class="textRight">#springMessage('table.bisGatherCmd.purpose')</td>
				<td width="35%">$!{bisGatherCmdPage.purpose}</td>
				##附言
				<td class="textRight">#springMessage('table.bisGatherCmd.addWord')</td>
				<td width="35%">$!{bisGatherCmdPage.addWord}</td>				
        	</tr>
			<tr>
				##备注说明
				<td class="textRight">#springMessage('table.settlement.rmk')</td>
				<td width="100%" colspan="5">$!{rmk}</td>
			</tr>
			<tr>
        		##交易状态
				<td class="textRight">#springMessage('table.bisExc.voucherStat')</td>
				<td width="35%">$dictTag.get("bisExc.voucherStat",$!{bisGatherCmdPage.cmdStat})</td>
				##交易时间
				<td class="textRight">#springMessage('table.bisGatherCmd.transTime')</td>
				<td width="35%">$!date.format('yyyy-MM-dd HH:mm:ss',$!{bisGatherCmdPage.transTime})</td>
        	</tr>
			<tr>
        		##银行返回时间
				<td class="textRight">#springMessage('table.bisGatherCmd.returnTime')</td>
				<td width="35%">$!date.format('yyyy-MM-dd HH:mm:ss',$!{bisGatherCmdPage.returnTime})</td>
				##银行流水号
				<td class="textRight">#springMessage('table.bisGatherCmd.bankSerialNo')</td>
				<td width="35%">$!{bisGatherCmdPage.bankSerialNo}</td>
        	</tr>
			<tr>
        		##返回信息
				<td class="textRight">#springMessage('table.bisGatherCmd.firstReturnMsg')</td>
				<td width="35%" colspan="3">$!{bisGatherCmdPage.firstReturnMsg}</td>
        	</tr>
			<tr>
				##返回信息
				<td class="textRight">#springMessage('table.bisGatherCmd.nextReturnMsg')</td>
				<td width="35%" colspan="3">$!{bisGatherCmdPage.nextReturnMsg}</td>
        	</tr>
			</tbody>
        </table>
		</div>
		<!-- 日志 -->
		<div id="tagMsg"></div>
		<p>
		<div class="layui-form-item layui-form-submit" id="buttonDiv">
    		<div class="layui-input-block">
                <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
    		</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script >
bt.use(['form','layedit','moneyType','printType'], function(){
    var $ = bt.jquery,form = bt.form();
    var moneyType = bt.moneyType.init();
    var moneyFun = bt.moneyType.getFun();
	bt.printType.init();
	
	/**
     * 生成日志列表
     * @return
     */
	$genMsgHtml= function() {
		var url=basePath + "/netbank/nismessage/list/"+$('#id').val()+"/"+$("#busType").val();
        $.ajax({
            url:url,
            method: 'GET',
            async:false,
            success: function (json) {
                $("#tagMsg").html("");
                $("#tagMsg").html(json);
                form.render();
            }
        });
    }
	$genMsgHtml();
});
</script>
</html>
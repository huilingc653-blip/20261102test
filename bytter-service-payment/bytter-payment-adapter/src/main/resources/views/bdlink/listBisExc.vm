<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        .col-error{
            color: red;
        }
    </style>
</head>
<body>
    <form id="searchForm" class="layui-form">
		<input id="opType" name="opType" type="hidden" value="list">
        <input id="loginName" name="loginName" type="hidden" value="$shiro.getPrincipal().loginName">
        <input id="isMathcFailReason" name="isMathcFailReason" type="hidden" value="$!{isMathcFailReason}">
        <table class="layui-table">
            <tbody>
                <tr>
                ##单位ID
                    <td class="textRight">#springMessage('table.bisExc.corpId')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="ins_corpId"
                                 data-callback="corpCallback"
                                 data-scope="all" data-resource="netbank:bdLink:bisExc:query"></div>
                        </div>
                    </td>
                ##接口代码
                    <td class="textRight">#springMessage('table.bisExc.bifCode')</td>
                    <td >
                        <div data-name="eqs_bifCode" class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/listFilter" data-valueField="id" data-textField="name"
                             data-search="true" data-defaultval="$!{bisExcPage.bifCode}"></div>
                    </td>
                    ##金额
                    <td class="textRight">#springMessage('table.bisExc.payMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" name="geg_payMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.bisExc.payMoney')">
                            <span class="date-mid">~</span>
                            <input type="text" name="leg_payMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" style="text-align:right" id="t20"  placeholder="#springMessage('table.bisExc.payMoney')">
                        </div>
                    </td>
                </tr>
				<tr>
                ##付款账号
                    <td class="textRight">#springMessage('table.bisExc.payerAcc')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" id="likes_payerAcc" name="likes_payerAcc" data-name="likes_payerAcc" data-biz-name="likes_payerAcc" url="${basePath}/bankacc/btbankacc/getListBy"
                                   class="layui-input bt-biz-accountTable" data-resource="netbank:bdLink:bisExc:query" data-callback="accountCallBack"/>
                        </div>
                    </td>
					##收款账号
                    <td class="textRight">#springMessage('table.bisExc.payeeAcc')</td>
                    <td>
                        <input type="text" name="likes_payeeAcc"
                            autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.bisExc.payeeAcc')">
                    </td>
					##收款账号名称
                    <td class="textRight">#springMessage('table.bisExc.payeeAccName')</td>
                    <td>
                        <input type="text" name="likes_payeeAccName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.payeeAccName')">
                    </td>
				</tr>
				<tr>
                ##附言
                    <td class="textRight">#springMessage('table.bisExc.addWord')</td>
                    <td>
                        <input type="text" name="likes_addWord"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.addWord')">
                    </td>
                    ##业务类型
                    <td class="textRight">#springMessage('table.bisExc.busOriType')</td>
                    <td>
						<div class="bt-biz-dict" data-type="select" data-group="bisExc.busOriType" data-name="eqi_busOriType"></div>
                    </td>
                ##申请日期
                    <td class="textRight">#springMessage('table.bisExc.reqDate')</td>
                    <td>
                        <input type="text" name="ged_reqDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_reqDate" data-today="true" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_reqDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_reqDate" data-today="true">
                    </td>
                </tr>
                <tr>
                ##指令编号
                    <td class="textRight">#springMessage('table.bisExc.voucherNo')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_voucherNo"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.voucherNo')">
                        </div>
                    </td>
                ##业务单号
                    <td class="textRight">#springMessage('table.bisExc.cbsBillId')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_cbsBillNo"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.cbsBillId')">
                        </div>
                    </td>
                    ##结算方式
                    <td class="textRight">#springMessage('table.nisBillhead.voucherTypeId')</td>
                    <td>
                        <div data-name="eqs_voucherTypeId" class="bt-biz-selectType"
                             data-url="${basePath}/netbank/fcvouchertype/getValidVoucherTypeForExc" data-valueField="id" data-textField="voucherName"
                             data-search="true"></div>
                    </td>
                </tr>
                <tr>
                    ##交易状态
                    <td class="textRight">#springMessage('table.bisExc.voucherStat')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="bisExc.voucherStat" data-name="eqs_voucherStat"></div>
                    </td>
                    ##指令来源
                    <td class="textRight">#springMessage('table.bisExc.voucherFrom')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="bisExc.voucherFrom" data-name="eqs_voucherFrom" data-filterData="5,6"></div>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('table.bisExc.voucherNo')</th>
		<th>#springMessage('table.bisExc.bifCode')</th>
		<th>#springMessage('table.bisExc.curId')</th>
		<th>#springMessage('table.bisExc.voucherTypeId')</th>
        <th>#springMessage('table.bisExc.failReason')</th>
        <th>#springMessage('table.nisBillhead.corpId')</th>
		<th>#springMessage('table.bisExc.payerAcc')</th>
        <th>#springMessage('table.bisExc.payerAccName')</th>
        <th>#springMessage('table.bisExc.payerBank')</th>
		<th>#springMessage('table.bisExc.payMoney')</th>
		<th>#springMessage('table.bisExc.payeeAcc')</th>
        <th>#springMessage('table.bisExc.payeeAccName')</th>
        <th>#springMessage('table.bisExc.payeeBank')</th>
		<th>#springMessage('table.bisExc.reqDate')</th>
		<th>#springMessage('table.bisExc.cbsBillId')</th>
		<th>#springMessage('table.bisExc.cmdType')</th>
		<th>#springMessage('table.bisExc.busOriType')</th>
        <th>#springMessage('table.bisExc.voucherFrom')</th>
        <th>#springMessage('table.bisExc.voucherStat')</th>
		<th>#springMessage('table.bisExc.returnTime')</th>
        <th>#springMessage('table.bisExc.firstReturnMsg')</th>
        <th>#springMessage('table.bisExc.nextReturnMsg')</th>
		<th>#springMessage('table.bisExc.purpose')</th>
        <th>#springMessage('table.bisExc.addWord')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bdlink/bisExc.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<input id="opType" name="opType" type="hidden" value="listSalePayment">
        <table class="layui-table">
            <tbody>
                <tr>
                ##单位ID
                    <td class="textRight">#springMessage('table.bisExc.corpId')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="ins_corpId"
                                 data-callback="corpCallback"
                                 data-scope="all" data-resource="netbank:bdLink:bisExc:salePaymentQuery"></div>
                        </div>
                    </td>
                    ##付款账号
                    <td class="textRight">#springMessage('table.bisExc.payerAcc')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" id="likes_payerAcc" name="likes_payerAcc" data-name="likes_payerAcc" data-biz-name="likes_payerAcc" url="${basePath}/bankacc/btbankacc/getListBy"
                                   class="layui-input bt-biz-accountTable" data-resource="netbank:bdLink:bisExc:salePaymentQuery" data-callback="accountCallBack"/>
                        </div>
                    </td>
                    ##金额
                    <td class="textRight">#springMessage('table.bisExc.payMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" name="geg_payMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.bisExc.payMoney')">
                            <span class="date-mid">~</span>
                            <input type="text" name="leg_payMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" style="text-align:right" id="t20"  placeholder="#springMessage('table.bisExc.payMoney')">
                        </div>
                    </td>
				</tr>
				<tr>
                ##接口代码
                    <td class="textRight">#springMessage('table.bisExc.bifCode')</td>
                    <td >
                        <div data-name="eqs_bifCode" class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/listFilter" data-valueField="id" data-textField="name"
                             data-search="true" data-defaultval="$!{bisExcPage.bifCode}"></div>
                    </td>
					##付款方式
                    <td class="textRight">#springMessage('table.bisExc.voucherTypeId')</td>
                    <td>
                        <div class="bt-biz-selectType" data-name="eqs_voucherTypeId" data-biz-name="eqs_voucherTypeId"
                             data-valuefield="id" data-textfield="voucherName"
                             data-url="${basePath}/netbank/fcvouchertype/json"></div>
                    </td>
					##申请日期
                    <td class="textRight">#springMessage('table.bisExc.reqDate')</td>
                    <td>
                        <input type="text" name="ged_reqDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_reqDate" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_reqDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_reqDate">
                    </td>
				</tr>
                <tr>
                ##状态
                    <td class="textRight">#springMessage('table.bisExc.status')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="bisExc.status" data-name="eqi_status"></div>
                    </td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('table.bisExc.voucherNo')</th>
		<th>#springMessage('table.bisExc.bifCode')</th>
		<th>#springMessage('table.bisExc.curId')</th>
		<th>#springMessage('table.bisExc.voucherTypeId')</th>
        <th>#springMessage('table.nisBillhead.corpId')</th>
		<th>#springMessage('table.bisExc.payerAcc')</th>
        <th>#springMessage('table.bisExc.payerAccName')</th>
        <th>#springMessage('table.bisExc.payerBank')</th>
		<th>#springMessage('table.bisExc.payMoney')</th>
		<th>#springMessage('table.bisExc.payeeAcc')</th>
        <th>#springMessage('table.bisExc.payeeAccName')</th>
        <th>#springMessage('table.bisExc.payeeBank')</th>
		<th>#springMessage('table.bisExc.reqDate')</th>
        <th>#springMessage('table.bisExc.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/blackWhite/blackWhiteBase.check.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bdlink/bisExc.listSalePayment.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        .col-error{
            color: red;
        }
    </style>
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##接口代码
                    <td class="textRight">#springMessage('table.bisGatherCmd.bifCode')</td>
                    <td>
                        <div data-name="eqs_bifCode" class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/listFilter" data-valueField="id" data-textField="name"
                             data-search="true" data-defaultval="$!{bisGatherCmdPage.bifCode}"></div>
                    </td>
					##父账号
                    <td class="textRight">#springMessage('table.bisGatherCmd.parentAcc')</td>
                    <td >
                        <input type="text" name="likes_parentAcc"
                            autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.bisGatherCmd.parentAcc')">
                    </td>
                    ##金额
                    <td class="textRight">#springMessage('table.bisGatherCmd.gatherAmt')</td>
                    <td >
                        <div class="layui-input-inline">
                            <input type="text" name="geg_gatherAmt"
                                    autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" placeholder="#springMessage('table.bisGatherCmd.gatherAmt')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-input-inline">
                            <input type="text" name="leg_gatherAmt"
                                    autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" placeholder="#springMessage('table.bisGatherCmd.gatherAmt')">
                        </div>
                    </td>
                </tr>
				<tr>
					##子账号
                    <td class="textRight">#springMessage('table.bisGatherCmd.childAcc')</td>
                    <td>
                        <input type="text" name="likes_childAcc"
                            autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.bisGatherCmd.childAcc')">
                    </td>
                    ##业务类型
                    <td class="textRight">#springMessage('table.bisGatherCmd.busOriType')</td>
                    <td>
						<div class="bt-biz-dict" data-type="select" data-group="bisGatherCmd.busOriType" data-name="eqi_busOriType"></div>
                    </td>
					##申请日期
                    <td class="textRight">#springMessage('table.bisGatherCmd.runTime')</td>
                    <td >
                        <input type="text" name="ged_runTime" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_runTime" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_runTime" class="layui-input bt-input-inline bt-biz-dateType" id="led_runTime">
                    </td>
                </tr>
				<tr>
                    ##指令编号
                    <td class="textRight">#springMessage('table.bisExc.voucherNo')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_voucherNo"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisGatherCmd.voucherNo')">
                        </div>
                    </td>
                    ##交易状态
                    <td class="textRight">#springMessage('table.bisGatherCmd.cmdStat')</td>
                    <td>
						<div class="bt-biz-dict" data-type="select" data-group="bisExc.voucherStat" data-name="eqs_cmdStat" data-filterData="w,p,8,R"></div>
                    </td>
                    ##交易日期
                        <td class="textRight">#springMessage('table.bisGatherCmd.transTime')</td>
                        <td>
                            <input type="text" name="ged_transTime" class="layui-input bt-input-inline bt-biz-dateType"
                                   data-endid="led_transTime">
                            <span class="date-mid">~</span>
                            <input type="text" name="led_transTime" class="layui-input bt-input-inline bt-biz-dateType"
                                   id="led_transTime">
                        </td>
                </tr>
                <tr>
                    ##指令来源
                    <td class="textRight">#springMessage('table.bisExc.voucherFrom')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="bisExc.voucherFrom" data-name="eqs_voucherFrom" data-displayData="5,6,7,8"></div>
                    </td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
				<tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.bisGatherCmd.voucherNo')</th>
        <th>#springMessage('table.bisGatherCmd.bifCode')</th>
		<th>#springMessage('table.bisGatherCmd.curId')</th>
		<th>#springMessage('table.bisGatherCmd.parentAcc')</th>
		<th>#springMessage('table.bisGatherCmd.parentAccName')</th>
		<th>#springMessage('table.bisGatherCmd.parentBank')</th>
		<th>#springMessage('table.bisGatherCmd.gatherAmt')</th>
        <th>#springMessage('table.bisGatherCmd.childAcc')</th>
        <th>#springMessage('table.bisGatherCmd.childAccName')</th>
        <th>#springMessage('table.bisGatherCmd.childBank')</th>
		<th>#springMessage('table.bisGatherCmd.runTime')</th>
        <th>#springMessage('table.bisGatherCmd.transTime')</th>
		<th>#springMessage('table.bisGatherCmd.cbsBillId')</th>
		<th>#springMessage('table.bisGatherCmd.cmdType')</th>
		<th>#springMessage('table.bisGatherCmd.busOriType')</th>
        <th>#springMessage('table.bisExc.voucherFrom')</th>
        <th>#springMessage('table.bisGatherCmd.cmdStat')</th>
        <th>#springMessage('table.bisGatherCmd.returnTime')</th>
        <th>#springMessage('table.bisGatherCmd.firstReturnMsg')</th>
        <th>#springMessage('table.bisGatherCmd.nextReturnMsg')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bdlink/bisGatherCmd.list.js?_btv=${resourceVersion}"></script>
</html>

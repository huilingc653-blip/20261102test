<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
        	<tbody>
                <tr>
                    <td class="textRight" width="20%">#springMessage('table.btBankAccApp.corpId')</td>
     				<td width="30%">
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="ins_corpId"
                                 data-resource="bankacc:biscorppoolbal:query"
                                 data-scope="all"></div>
                        </div>
                    </td>
                    <td class="textRight" width="20%">#springMessage('table.bisAccBal.balDate')</td>
                    <td width="30%">
                        <input type="text" name="ged_balDate" data-biz-name="ged_balDate"
                               class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_balDate">
                        <span class="date-mid">~</span>
                        <input type="text" name="led_balDate" data-biz-name="led_balDate"
                               class="layui-input bt-input-inline bt-biz-dateType" id="led_balDate">
                    </td>
                </tr>
                <tr>
                    ##币别ID
                    <td class="textRight">#springMessage('table.bisAccBal.curId')</td>
                    <td >
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                             data-name ="eqs_curId" data-biz-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
                    </td>
                    ##是否初始化余额
                    <td class="textRight">#springMessage('是否初始化余额')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="sf_yn"
                             data-name="eqs_initSign"></div>
                    </td>
                </tr>
                <tr>
                	<td align="center" colspan="4">
                    	<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
        	</tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.bisAccBal.corp')</th>
                <th>#springMessage('table.bisAccBal.balDate')</th>
                <th>#springMessage('table.bisAccBal.bal')</th>
                <th>#springMessage('table.fcAcc.overdraftMoney')</th>
                <th>#springMessage('table.nisAllocationReport.up')#springMessage('table.bisAccBal.availBal')</th>
                <th>#springMessage('table.bisAccBal.curId')</th>
                <th>#springMessage('table.bisAccBal.getDate')</th>
                <th>#springMessage('是否初始化余额')</th>
                <th>#springMessage('common.table.thead.operation')</th>
			</tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisCorpPoolBal.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
    <input type="hidden"  id="corpId" value="$!{btBankAccPage.corpId}"/>
    <input type="hidden"  id="flag" name="flag" value="$!{btBankAccPage.flag}"/>
    <input type="hidden" id="id" value="$!{btBankAccPage.id}"/>
    <input type="hidden"  name="eqs_curId" id="curId" value="$!{btBankAccPage.curId}"/>
    <input type="hidden" name="poolSign" id="poolSign" value="$!{btBankAccPage.poolSign}"/>
    <table class="layui-table">
    <tbody>
         <tr>
	        <td align="right">#springMessage('table.btBankAcc.accType')</td>
	        <td align="left">
                #if($!{btBankAccPage.poolSign} == "1")
                    <div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType" data-name="eqs_accType" data-biz-name="eqs_accType" data-displayData="01"></div>
                #else
				    <div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType" data-name="eqs_accType" data-biz-name="eqs_accType"></div>
                #end
	       	</td>
    		<td class="textRight" align="right">#springMessage('table.fcAcc.blnctrAcc')</td>
       		<td align="left">
       			<input type="text" id="blnctrAcc" name="likes_blnctrAcc"
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAcc.blnctrAcc')" >
        	</td>
       
        </tr>
        <tr>
        	<td align="center" colspan="4">
            <button class="layui-btn" lay-submit lay-filter="search" id="send">#springMessage('common.button.search')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </tbody>
    </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        #if($!{btBankAccPage.poolSign} == "1")
            <th>#springMessage('nis.pool.fcCorpPool.pool')</th>
        #else
            <th>#springMessage('table.fcAcc.netId')</th>
        #end
        <th>#springMessage('table.btBankAccApp.corpId')</th>
        <th>#springMessage('table.fcAcc.blnctrAcc')</th>
        <th>#springMessage('table.btBankAccApp.accName')</th>
        <th>#springMessage('table.btBankAccCur.cur')</th>
        <th>#springMessage('table.btBankAcc.regDate')</th>
        </tr>
    </thead>

</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/showCounterAcc.list.js?_btv=${resourceVersion}"></script>
</html>

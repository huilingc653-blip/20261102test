#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<input id="id" type="hidden" value="$!{freeze.id}">

<ul class="mui-table-view">
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.accId')
        <span class="mui-badge mui-badge-inverted">
            $!{accVO.bankAcc}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisAllocationReq.accName')
        <span class="mui-badge mui-badge-inverted">
            $!{accVO.accName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.nisAllocationReq.bankName')
        <span class="mui-badge mui-badge-inverted">
            $!{accVO.bankName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('btBankType.typeName')
        <span class="mui-badge mui-badge-inverted">
            $!{accVO.bankTypeName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.attributeId')
        <span class="mui-badge mui-badge-inverted">
            $!{accVO.attributeName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fcAcc.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{accVO.corpName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.accType')
        <span class="mui-badge mui-badge-inverted">
            $!{accVO.accTypeName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccCur.cur')
        <span class="mui-badge mui-badge-inverted">
            $!{accVO.curName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fcAcc.interestRate')
        <span class="mui-badge mui-badge-inverted">
            $!rateTag.show($!{accVO.rates})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btInnerAccApp.innerDate')
        <span class="mui-badge mui-badge-inverted">
            $!{accVO.regDateStr}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.natureId')
        <span class="mui-badge mui-badge-inverted">
            $!{accVO.natureName}
        </span>
    </li>

    <li class="mui-table-view-cell  mui-collapse keep-unfold">
        <a class="mui-navigate-right" href="#">
            #springMessage('table.btBankAccFreeze.info')
        </a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('table.nisAllocationReq.accBalance')
                <span class="mui-badge mui-badge-inverted">
                    $!number.formatNumeric($!{btBankAccFreezeVO.bal})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.bisAccBal.availBal')
                <span class="mui-badge mui-badge-inverted">
                    $!number.formatNumeric($!{btBankAccFreezeVO.avalBal})
            </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.btBankAccFreeze.freezeNum')
                <span class="mui-badge mui-badge-inverted">
                    $!{btBankAccFreezeVO.freezeCount}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.btBankAccFreeze.sumFreezeAtm')
                <span class="mui-badge mui-badge-inverted">
                    $!number.formatNumeric($!{btBankAccFreezeVO.freezeMoneySum})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.btBankAccFreeze.unfreezeNum')
                <span class="mui-badge mui-badge-inverted" id="payerProvCity">
                    $!{btBankAccFreezeVO.unfreezeCount}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.btBankAccFreeze.sumUnfreezeAtm')
                <span class="mui-badge mui-badge-inverted" id="payerProvCity">
                    $!number.formatNumeric($!{btBankAccFreezeVO.unFreezeMoneySum})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fcAccBalance.freezeMoney')
                <span class="mui-badge mui-badge-inverted">
                    $!number.formatNumeric($!{freezeMoney})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.fcFreeze.freezeReason')
                <span class="mui-badge mui-badge-inverted">
                    $!{freezeRession}
                    </span>
            </li>
        </ul>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>

</html>

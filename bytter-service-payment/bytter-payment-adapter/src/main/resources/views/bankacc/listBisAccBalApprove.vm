<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
    <table class="layui-table">
        <tbody >
        <tr>
            <td class="textRight" width="40%">#springMessage('table.bisAccBal.balDate')</td>
            <td>
                <input type="text" name="ged_balDate" data-biz-name="ged_balDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_balDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_balDate" data-biz-name="led_balDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_balDate">
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.bisAccBal.bankAcc')</th>
            <th>#springMessage('table.bisAccBal.accName')</th>
            <th>#springMessage('table.bisAccBal.bankName')</th>
            <th>#springMessage('table.bisAccBal.curId')</th>
            <th>#springMessage('table.bisAccBal.balDate')</th>
            <th>#springMessage('table.bisAccBal.bal')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
	#paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
	#paymentWorkFlowScript()
    <script src="${basePath}/static/modules/bankacc/bisAccBalApprove.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

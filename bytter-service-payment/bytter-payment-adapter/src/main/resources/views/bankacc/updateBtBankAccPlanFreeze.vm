<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<table class="layui-table">
    <tbody>
    <tr>
        <td colspan="4" style="text-align: center;font-weight: 700">#springMessage('table.fcFreeze.modify')</td>
    </tr>
    <tr>
        <td align="right">#springMessage('table.nisBillhead.accId')</td>
        <td>$!{accVO.bankAcc}</td>
        <td align="right">#springMessage('table.nisAllocationReq.accName')</td>
        <td>$!{accVO.accName}</td>
    </tr>
    <tr>
        <td align="right">#springMessage('table.nisAllocationReq.bankName')</td>
        <td>$!{accVO.bankName}</td>
        <td align="right">#springMessage('btBankType.typeName')</td>
        <td>$!{accVO.bankTypeName}</td>
    </tr>
    <tr>
        <td align="right">#springMessage('table.btBankAccApp.attributeId')</td>
        <td>$!{accVO.attributeName}</td>
        <td align="right">#springMessage('table.fcAcc.corpId')</td>
        <td>$!{accVO.corpName}</td>
    </tr>
    <tr>
        <td align="right">#springMessage('table.btBankAccApp.accType')</td>
        <td>$!{accVO.accTypeName}</td>
        <td></td>
        <td></td>
    </tr>
    <tr>
        <td align="right">#springMessage('table.btBankAccCur.cur')</td>
        <td>$!{accVO.curName}</td>
        <td align="right">#springMessage('table.fcAcc.interestRate')</td>
        <td>$!rateTag.show($!{accVO.rates})</td>
    </tr>
    <tr>
        <td align="right">#springMessage('table.btInnerAccApp.innerDate')</td>
        <td>$!date.format('yyyy-MM-dd',$!{accVO.regDate})</td>
        <td align="right">#springMessage('table.btBankAccApp.natureId')</td>
        <td>$!{accVO.natureName}</td>
    </tr>
    <tr>
        <td colspan="4" style="text-align: center;font-weight: 700">#springMessage('table.btBankAccFreeze.info')</td>
    </tr>
    <tr>
        <td align="right">#springMessage('table.nisAllocationReq.accBalance')</td>
        <td>
            <div name="money">$!{freezeVO.bal}</div>
        </td>
        <td align="right">#springMessage('table.bisAccBal.availBal')</td>
        <td>
            <div name="money">$!{freezeVO.availBal}</div>
        </td>
    </tr>
    <tr>
        <td align="right">#springMessage('table.btBankAccFreeze.freezeNum')</td>
        <td>$!{freezeVO.freezeCount}</td>
        <td align="right">#springMessage('table.btBankAccFreeze.sumFreezeAtm')</td>
        <td>
            <div name="money">$!{freezeVO.freezeMoneySum}</div>
        </td>
    </tr>
    <tr>
        <td align="right">#springMessage('table.btBankAccFreeze.unfreezeNum')</td>
        <td>$!{freezeVO.unfreezeCount}</td>
        <td align="right">#springMessage('table.btBankAccFreeze.sumUnfreezeAtm')</td>
        <td>
            <div name="money">$!{freezeVO.unFreezeMoneySum}</div>
        </td>
    </tr>
    </tbody>
</table>
<form class="layui-form" method="post">
    <input type="hidden" name="bal" id="bal" value="$!{freezeVO.bal}"/>
    <input type="hidden" name="availBal" id="availBal" value="$!{freezeVO.availBal}"/>
    <input type="hidden" name="bankAccId" id="bankAccId" value="$!{accVO.id}"/>
    <input type="hidden" name="bankAcc" id="bankAcc" value="$!{accVO.bankAcc}"/>
    <input type="hidden" name="corpId" id="corpId" value="$!{accVO.corpId}"/>
    <input type="hidden" name="curId" id="curId" value="$!{accVO.curId}"/>
    <input type="hidden" name="id" id="id" value="$!{freezeVO.id}"/>
    <input type="hidden" id="_applyFreezeMoney" value="$!{freezeVO.applyFreezeMoney}"/>
    <input type="hidden" id="_freezeStartDate" value="$!date.format('yyyy-MM-dd HH:mm:ss',$!{freezeVO.freezeStartDate})"/>
    <input type="hidden" id="_freezeEndDate" value="$!date.format('yyyy-MM-dd HH:mm:ss',$!{freezeVO.freezeEndDate})"/>
    <input type="hidden" id="_freezeRession" value="$!{freezeVO.freezeRession}"/>
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.fcAccBalance.freezeMoney')</td>
            <td colspan="3">
                <input type="text" class="layui-input bt-biz-moneyType" data-name="applyFreezeMoney" data-biz-name="applyFreezeMoney"
                       lay-verify="required" value="$!{freezeVO.applyFreezeMoney}">
            </td>
        </tr>
        <tr>
            <td class="textRight">冻结开始时间</td>
            <td colspan="3">
                <div class="layui-input-inline">
                    <input type="text" class="layui-input bt-biz-dateType" id="freezeStartDate" name="freezeStartDate" data-biz-name="freezeStartDate" data-endid="freezeEndDate"
                           lay-verify="required" data-type="datetime" value="$!{freezeVO.freezeStartDate}">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">冻结结束时间</td>
            <td colspan="3">
                <div class="layui-input-inline">
                    <input type="text" class="layui-input bt-biz-dateType" id="freezeEndDate" name="freezeEndDate" data-biz-name="freezeEndDate"
                           lay-verify="required" data-type="datetime" value="$!{freezeVO.freezeEndDate}">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcFreeze.freezeReason')</td>
            <td colspan="3">
                <textarea rows="5" cols="50" id="freezeRession" name="freezeRession" lay-verify="required|strlength"
                          data-maxlength="200">$!{freezeVO.freezeRession}</textarea>
            </td>
        </tr>
        <tr>
            <td colspan="4" align="center">
                <button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
                <button type="button" class="layui-btn layui-btn-primary" onclick="planFreezeReset()">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccPlanFreeze.edit.js?_btv=${resourceVersion}"></script>
</html>
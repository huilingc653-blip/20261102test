#parse("views/common/head.vm")
<table id="appTable" class="layui-table breakRow layui-form  dark-layui-table layui-table-border" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisMessage.enrolDate')</th>
        <th>#springMessage('table.nisMessage.op')</th>
        <th>#springMessage('table.nisMessage.opName')</th>
        <th>#springMessage('table.nisMessage.messageType')</th>
        <th>#springMessage('table.nisMessage.message')</th>
    </tr>
	</thead>
	<tbody class="breakRow">
		#foreach($msg in $list)
		<tr>
			<td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{msg.enrolDate})</td>
			<td>$!{msg.op}</td>
			<td>$!{msg.opName}</td>
			<td>$dictTag.get("btBankAccMessage.messageType",$!{msg.messageType})</td>
			<td>$!{msg.message}</td>
		</tr>
		#end
	</tbody>
</table>

<!DOCTYPE html>
<html>
<head>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="font-src *  data:">
    <meta name="viewport"
          content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0, user-scalable=no">
    <title>账户详情</title>
    <!-- 引入 FrozenUI -->
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css" media="all"/>
    <link rel="stylesheet" href="${basePath}/static/css/mobile/index.css" media="all"/>
    <!-- 注意：如果你直接复制所有代码到本地，上述js路径需要改成你本地的 -->
    <script src="${basePath}/static/mobile/plugins/zepto/zepto.min.js"></script>
    <script src="${basePath}/static/plugins/f2/f2.min.js"></script>
    <script src="${basePath}/static/js/mobile/date.js"></script>
    <style>
        .acc-bal{
            height: 1.29rem;
            background-color: #F5F5F5;
            padding-top:0.15rem;
            padding-bottom:0.15rem;
        }

        .acc-bal-head{
            border-radius: 0.1rem;
            height: 1.29rem;
            margin-left: 0.15rem;
            margin-right: 0.15rem;
            background-color: #476CE9;
        }
        .acc-bal-common{
            position: absolute;
            margin-left: 0.14rem;
            color:#FFFFFF;
        }
        .acc-bal-num{
            margin-top: 0.13rem;
            font-weight: bold;
            font-size: 0.26rem;
        }
        .acc-bal-attr{
            margin-top: 0.5rem;
            font-size: 0.14rem;
            font-weight: 100;
        }
        .acc-bal-corp{
            margin-top: 0.76rem;
            font-size: 0.12rem;
            color:#D6DFFF;
        }
        .acc-bal-bank{
            margin-top: 0.98rem;
            font-size: 0.12rem;
            color:#D6DFFF;
        }
        .acc-bal-image{
            background-image: url("${basePath}/static/modules/images/bankaccbg.png");
            height: 0.89rem;
            width: 0.83rem;
            float: right;
            clear:both;
            margin-top: 0.4rem;
            background-repeat: no-repeat;
            background-size: contain;
        }

        .content {
            height: 5.66rem;
            width: 100%;
        }

        .content-item{
            height: 0.38rem;
            margin-left: 0.16rem;
            margin-right: 0.16rem;
            border-bottom: 1px solid #EFEFEF;
        }
        .content-dtl1{
            display: inline-block;
            margin-top: 0.15rem;
            width:1rem;
        }
        .content-dtl2{
            display: inline-block;
            margin-top: 0.14rem;
            float: right;

            width: 55%;
            text-align: right;
            white-space:nowrap;
            overflow-x:auto;
        }
    </style>
</head>
<body>
    <div class="acc-bal">
        <div class="acc-bal-head">
            <div class="acc-bal-common acc-bal-num">$!{vo.bankAcc}</div>
            <div class="acc-bal-common acc-bal-attr">$!{vo.attributeName}</div>
            <div class="acc-bal-common acc-bal-corp">$!{vo.corpName}</div>
            <div class="acc-bal-common acc-bal-bank">$!{vo.bankName}</div>
            <div class="acc-bal-image"></div>
        </div>
    </div>
    <div class="content">
        <div class="content-item">
            <span class="content-dtl1">开户行行号</span>
            <span class="content-dtl2">$!{vo.bankCode}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">账户性质</span>
            <span class="content-dtl2">$!{vo.natureName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">银行类别</span>
            <span class="content-dtl2">$!{vo.bankTypeName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">账户属性</span>
            <span class="content-dtl2">$!{vo.attributeName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">接口代码</span>
            <span class="content-dtl2">$!{vo.bifName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">票据专户</span>
            <span class="content-dtl2">$!{vo.electricBillName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">币种</span>
            <span class="content-dtl2">$!{vo.curName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">利率</span>
            <span class="content-dtl2">$!{vo.rates}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">利率是否浮动</span>
            <span class="content-dtl2">$!{vo.ratesFloatName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">浮动百分比</span>
            <span class="content-dtl2">$!{vo.ratesFloatPerStr}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">本册笔号</span>
            <span class="content-dtl2">$!{vo.volumeNum}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">存册册号</span>
            <span class="content-dtl2">$!{vo.bankbookNum}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">开户日期</span>
            <span class="content-dtl2">$!{vo.regDateStr}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">对私编号</span>
            <span class="content-dtl2">$!{vo.privateNo}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">是否上线</span>
            <span class="content-dtl2">$!{vo.isOnlineStr}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">账户类别</span>
            <span class="content-dtl2">$!{vo.accTypeName}</span>
        </div>
    </div>
</body>
</html>

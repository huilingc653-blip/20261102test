<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input id="id" name="id" type="hidden" value="">
		<table class="layui-table">
			<tbody>
				<tr>
					##是否票据账户
					<td class="textRight" width="40%">#springMessage('table.btBankAcc.isElectricBillAcc')</td>
					<td width="60%">
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="electricBill"
							 data-biz-name="electricBill" data-defaultvalue="$!{electricBill}" data-required="true" data-callback="bt.calBill"></div>
					</td>
				</tr>
				#if($!{electricBill} == "0")
					<tr class="isShow" style="display:none;">
				#else
					<tr class="isShow">
				#end
					##流通方式
					<td class="textRight" width="40%">#springMessage('table.btBankAccApp.circulationMode')</td>
					<td width="60%">
						<div class="bt-biz-dict" data-type="radio" data-group="bankAcc.circulationMode" data-required="true" data-defaultvalue="$!{circulationMode}" data-name="circulationMode" data-biz-name="circulationMode"></div>
					</td>
				</tr>
				<tr>
					<td colspan="2" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.confirm')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/bankacc/btBankAcc.setBillInfo.js?_btv=${resourceVersion}"></script>
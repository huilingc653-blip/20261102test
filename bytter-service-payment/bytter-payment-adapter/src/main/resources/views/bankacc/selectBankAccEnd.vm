<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.bisAccBal.corp')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="corpId"
                         data-resource="netbank:bankAcc:bisAccBal:selectBankAccEnd"
                         data-scope="all"
                         data-callback="corpCallback"></div>
                </div>
            </td>
            ##银行账号
            <td class="textRight">#springMessage('table.bisAccBal.bankAcc')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" id="bankAcc" name="bankAcc" data-name="bankAcc" data-biz-name="bankAcc" accountType="3" autocomplete="off"
                           data-resource="netbank:bankAcc:btBankAccDtl:managerQuery"  class="layui-input bt-biz-accountTable" data-callback="accountCallBack" permission="D"/>
                </div>
            </td>
            <td class="textRight">#springMessage('table.bisAccBal.curId')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name="curId" data-biz-name="curId" data-valueField="id" data-textField="curName"></div>
            </td>
            <td class="textRight">#springMessage('table.bisAccBal.bifCode')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/listFilter"
                     data-name="bifCode" data-biz-name="bifCode" data-valueField="id" data-textField="name"></div>
            </td>
        </tr>
        <tr>
            <td colspan="8" style="text-align: center;">
##                #if($shiro.hasPermission("netbank:bankAcc:bisAccBal:selectBankAccEnd"))
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                        'common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
##                #end
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.bisAccBal.corp')</th>
        <th>#springMessage('table.bisAccBal.bankAcc')</th>
        <th>#springMessage('table.bisAccBal.accName')</th>
        <th>#springMessage('table.bisAccBal.bankName')</th>
        <th>#springMessage('table.bisAccBal.curId')</th>
        <th>#springMessage('table.bisAccBal.bifCode')</th>
        <th>#springMessage('table.bisAccBal.completeDate')</th>
    </tr>
    </thead>
</table>
<table class="layui-table">
    <tbody>
    <tr class="ignore-required-hide">
        <td class="textRight" style="width:50%">#springMessage('table.bisAccBal.completeDate')
            <div class="layui-inline">
                <input type="text" data-name="endDate" data-biz-name="endDate"
                       class="layui-input bt-input-inline bt-biz-dateType" data-today="true" data-type="datetime">
            </div>
        </td>
        <td style="width:50%">
            <button type="button" class="layui-btn" onclick="toComplete()">#springMessage(
                'table.bisAccBal.btn.confirm')</button>
        </td>
    </tr>
    </tbody>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bankAccEnd.list.js?_btv=${resourceVersion}"></script>
</html>

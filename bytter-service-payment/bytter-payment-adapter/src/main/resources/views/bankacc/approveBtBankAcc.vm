<!DOCTYPE html>
<html lang="en">
<body>
	<form class="layui-form layui-form-pane">
		<input type="hidden" id="taskId" name= "taskId" value="$!{taskId}">
	</form>
	#if($btBankAccAppPage.busType eq '1')
		#parse("views/bankacc/viewBtBankAccApp.vm")
	#elseif($btBankAccAppPage.busType eq '2')
		#parse("views/bankacc/viewBtBankAccRev.vm")
	#elseif($btBankAccAppPage.busType eq '3')
		#parse("views/bankacc/viewBtBankAccDel.vm")
	#end
    #set($btnPrependHtml = '<button type="button" class="layui-btn" id="showBankAccBtn" onclick="showOldBankAcc()">'+"#springMessage('table.btBankAccApp.btn.showbankacc')"+'</button>')
	#paymentWorkFlowHtml($!{btnPrependHtml})
	#paymentWorkFlowScript()

	<script>
		bt.use(['form','jquery'], function(){
			var $ = bt.jquery,form = bt.form();
			bt.workFlow.beforeSubmit = function(submitData){
				var taskIds = [];
				taskIds.push($("#taskId").val());
				bt.workFlow.taskList = taskIds;
				return true;
			}
			bt.workFlow.afterSubmit = function(){
				parent.layer?parent.layer.closeAll():layer.closeAll();
			}
		});
	</script>
</body>
</html>
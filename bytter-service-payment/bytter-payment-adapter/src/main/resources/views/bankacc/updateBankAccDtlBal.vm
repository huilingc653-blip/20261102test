<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <table class="layui-table" id="seachTable">
			<tbody>
            	<tr>
    				<td class="textRight">#springMessage('table.bisAccBal.corp')</td>
    				<td>
						<div class="layui-input-inline">
							##单位
							 <div class="bt-biz-corp"
								data-biz-type="corp"
								data-type="selectTree"
								data-name="corpId"
                                data-biz-name="corpId"
								data-scope="all"
                                data-resource="netbank:bankAcc:btBankAccDtl:apply"
								data-callback="corpCallback"></div>
                        </div>
                    </td>
            		##银行账号
    				<td class="textRight">#springMessage('table.bisAccBal.bankAcc')</td>
    				<td style="min-width: 200px;">
                        <div class="layui-input-inline">
                            <input type="text" id="bankAcc" name="bankAcc" data-name="bankAcc" data-biz-name="bankAcc" accountType="3" autocomplete="off" lay-verify="tableData"
                                   data-resource="netbank:bankAcc:bisAccBal:apply"  class="layui-input bt-biz-accountTable" data-callback="accountCallBack" permission="B"/>
                        </div>
    				</td>
                    <td class="textRight">#springMessage('table.bisAccBal.curId')</td>
                    <td >
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                             data-name ="curId" data-biz-name ="curId"  data-valueField="id" data-textField="curName"></div>
                    </td>
            		##接口代码
    				<td class="textRight">#springMessage('table.bisAccBal.bifCode')</td>
    				<td>
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/listFilter"
                             data-valuefield="id" data-textfield="typeName" data-name="bankType" data-biz-name="bankType" data-inputvalue="inputvalue" data-search="true"></div>
    				</td>
    			</tr>
				<tr>
					<td colspan="8" align="center">
        	            <button class="layui-btn" type="button" onclick="search()">#springMessage('common.button.search')</button>
        				<button type="reset" class="layui-btn layui-btn-primary"  data-callBack="resetCallBack">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
        	</tbody>
        </table>
        <table id="bankAccInfo" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr class="title">
                <th>#springMessage('table.bisAccBal.bankAcc')</th>
                <th>#springMessage('table.bisAccBal.accName')</th>
                <th>#springMessage('table.bisAccBal.bankName')</th>
                <th>#springMessage('table.bisAccBal.curId')</th>
            </tr>
            </thead>
        </table>
		<table class="layui-table">
			<tbody>
            	<tr class="ignore-required-hide">
    				<td class="textRight">#springMessage('table.bisAccBal.detailDate')</td>
                    <td >
						<div class="layui-inline">
                            <input type="text" data-name="beginDate" data-biz-name="beginDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="endDate">
                            <span class="date-mid">~</span>
                            <input type="text" data-name="endDate" data-biz-name="endDate" class="layui-input bt-input-inline bt-biz-dateType" id="endDate" data-max="$!{sysDate}" value="$!{sysDate}">
                        </div>
    				</td>
    				<td>
    					<button type="button"  class="layui-btn" onclick="toBuildBal()">#springMessage('bankacc.button.updateBal')</button>
    				</td>
    			</tr>
            </tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bankAccDtl.updateBal.js?_btv=${resourceVersion}"></script>
</html>
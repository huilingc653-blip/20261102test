<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input id="id" name="id" type="hidden" value="">
		<table class="layui-table">
			<tbody>
			<tr>
				<td class="textRight" width="40%">#springMessage('bpm.option.conditions.type')</td>
				<td width="60%">
					<div class="bt-biz-dict" data-type="select" data-group="bisCorpPoolDtl.poolType" data-name="poolType"
						 data-biz-name="poolType" data-required="true"></div>
				</td>
			</tr>
			<tr>
				<td colspan="4" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.confirm')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/bankacc/bisCorpPoolDtl.claim.js?_btv=${resourceVersion}"></script>
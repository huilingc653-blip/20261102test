<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="id" name="id" value="$!{bisAccBalPage.id}">
    <input type="hidden" id="accNo" name="accNo" value="$!{bisAccBalPage.accNo}">
    <input type="hidden" id="corpId" name="corpId" value="$!{bisAccBalPage.corpId}">
    <input type="hidden" id="bifCode" name="bifCode" value="$!{bisAccBalPage.bifCode}">
##    <input type="hidden" id="getDate" name="getDate" value="$!{bisAccBalPage.getDate}">
    <input type="hidden" id="getDateStr" name="getDateStr" value="$!{bisAccBalPage.getDateStr}">
    <input type="hidden" id="frzBal" name="frzBal" value="$!{bisAccBalPage.frzBal}">
    <input type="hidden" id="returnCode" name="returnCode" value="$!{bisAccBalPage.returnCode}">
    <input type="hidden" id="returnMsg" name="returnMsg" value="$!{bisAccBalPage.returnMsg}">
    <input type="hidden" id="returnCode" name="returnCode" value="$!{bisAccBalPage.returnCode}">
    <input type="hidden" id="status" name="status" value="$!{bisAccBalPage.status}">
    <input type="hidden" id="createBy" name="createBy" value="$!{bisAccBalPage.createBy}">
    <input type="hidden" id="createDate" name="createDate" value="$!{bisAccBalPage.createDate}">
    <input type="hidden" id="updateBy" name="updateBy" value="$!{bisAccBalPage.updateBy}">
    <input type="hidden" id="updateDate" name="updateDate" value="$!{bisAccBalPage.updateDate}">

    <table class="layui-table">
        <tbody>
        <tr>
        ##银行账号
            <td class="textRight">#springMessage('table.bisAccBal.bankAcc')</td>
            <td>
                <input type="text" id="bankAcc" name="bankAcc" lay-verify="required" readonly="readonly"
                       autocomplete="off" class="layui-input bank" value="$!{bisAccBalPage.bankAcc}">
            </td>
        </tr>
        <tr>
        ##余额日期
            <td class="textRight">#springMessage('table.bisAccBal.balDate')</td>
            <td>
                <input type="text" name="balDate" lay-verify="required" class="layui-input bt-biz-dateType"
                       readonly="readonly" value="$!{bisAccBalPage.balDate}" data-type="date">
            </td>
        </tr>
        <tr>
        ##余额
            <td class="textRight">#springMessage('table.bisAccBal.bal')</td>
            <td>
                <input type="text" data-name="bal" data-biz-name="bal" class="layui-input bt-input-inline  bt-biz-moneyType"
                       style="text-align:right" lay-verify="required" value="$!{bisAccBalPage.bal}" data-minus="true">
            </td>
        </tr>
        <tr>
        ##可用余额
            <td class="textRight">#springMessage('table.bisAccBal.availBal')</td>
            <td>
                <input type="text" data-name="availBal" data-biz-name="availBal" class="layui-input bt-input-inline bt-biz-moneyType"
                       style="text-align:right" lay-verify="required" value="$!{bisAccBalPage.availBal}" data-minus="true">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisAccBal.edit.js?_btv=${resourceVersion}"></script>
</html>
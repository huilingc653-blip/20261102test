<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
				<tr>
                    ##单位
                    <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="likes_corpId"
                                 data-resource="netbank:bankAcc:btBankAccFreeze:reportquery"
                                 data-scope="all"></div>
                        </div>
                    </td>
                    <td class="textRight">#springMessage('table.nisExpenseDetail.opType')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select"
                             data-group="bankAccApp.ufFlag" data-name="eqs_ufFlag"></div>
                    </td>
                    <td class="textRight">
                        #springMessage('table.innerAcc.freeze')/#springMessage('table.innerAcc.freeze.thaw')#springMessage('table.nisBillhead.payMoney')
                    </td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_freezeMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                   data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_freezeMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                                   id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                        </div>
                    </td>
    			</tr>
                <tr>
                    <td class="textRight">#springMessage('table.btBankAccApp.bankAcc')</td>
                    <td>
                        <input type="text" name="likes_bankAcc"
                               autocomplete="off" class="bank layui-input" placeholder="#springMessage('table.btBankAcc.bankAcc')">
                    </td>
                    <td class="textRight">#springMessage('table.nisBillhead.status')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-filterData="-2"
                             data-group="bisExc.status" data-name="eqi_status"></div>
                    </td>
                    <td class="textRight">
                        #springMessage('table.innerAcc.freeze')/#springMessage('table.innerAcc.freeze.thaw')#springMessage('table.fcAccuBalance.date')
                    </td>
                    <td>
                        <input type="text" name="ged_freezeDate" class="layui-input bt-input-inline bt-biz-dateType"
                               data-endid="led_freezeDate">
                        <span class="date-mid">~</span>
                        <input type="text" name="led_freezeDate" class="layui-input bt-input-inline bt-biz-dateType"
                               id="led_freezeDate">
                    </td>
                </tr>
				<tr>
                	<td align="center" colspan="6">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
    		</tbody>
    	</table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.btBankAccDtl.accNo')</th>
                <th>#springMessage('table.nisExpenseDetail.opType')</th>
                <th>#springMessage('table.btBankAccApp.corpId')</th>
                <th>#springMessage('table.btBankAccApp.bankAcc')</th>
                <th>#springMessage('table.btBankAccApp.accName')</th>
                <th>#springMessage('table.btBankAccApp.curId')</th>
                <th>#springMessage('table.innerAcc.freeze')/#springMessage('table.innerAcc.freeze.thaw')#springMessage('table.nisBillhead.payMoney')</th>
                <th>#springMessage('table.innerAcc.freeze')/#springMessage('table.innerAcc.freeze.thaw')#springMessage('table.fcAccuBalance.date')</th>
                <th>#springMessage('table.fcFreeze.status')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccFreeze.query.js?_btv=${resourceVersion}"></script>
</html>

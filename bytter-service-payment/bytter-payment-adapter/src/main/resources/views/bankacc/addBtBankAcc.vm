<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{btBankAccPage.id}">
		<input id="validSign" name="validSign" type="hidden" value="$!{btBankAccPage.validSign}">
		<input id="status" name="status" type="hidden" value="$!{btBankAccPage.status}">
		<input id="createBy" name="createBy" type="hidden" value="$!{btBankAccPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{btBankAccPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{btBankAccPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{btBankAccPage.updateDate}">
		<div class="layui-form-item">
			<div class="layui-inline">
				##银行账号
				<label class="layui-form-label">#springMessage('table.btBankAcc.bankAcc')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="bankAcc" name="bankAcc" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankAcc')">
									</div>
			</div>
			<div class="layui-inline">
				##账户名称
				<label class="layui-form-label">#springMessage('table.btBankAcc.accName')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="accName" name="accName" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.accName')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##结算中心账号
				<label class="layui-form-label">#springMessage('table.btBankAcc.counterAccId')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="counterAccId" name="counterAccId" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.counterAccId')">
									</div>
			</div>
			<div class="layui-inline">
				##父账号
				<label class="layui-form-label">#springMessage('table.btBankAcc.prentAccId')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="prentAccId" name="prentAccId" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.prentAccId')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##父账号标志
				<label class="layui-form-label">#springMessage('table.btBankAcc.parentSign')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="parentSign" name="parentSign" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.parentSign')">
									</div>
			</div>
			<div class="layui-inline">
				##单位ID
				<label class="layui-form-label">#springMessage('table.btBankAcc.corpId')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="corpId" name="corpId" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.corpId')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##账户类别
				<label class="layui-form-label">#springMessage('table.btBankAcc.accType')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="accType" name="accType" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.accType')">
									</div>
			</div>
			<div class="layui-inline">
				##账户属性
				<label class="layui-form-label">#springMessage('table.btBankAcc.attributeId')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="attributeId" name="attributeId" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.attributeId')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##账户性质
				<label class="layui-form-label">#springMessage('table.btBankAcc.natureId')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="natureId" name="natureId" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.natureId')">
									</div>
			</div>
			<div class="layui-inline">
				##银行类别
				<label class="layui-form-label">#springMessage('table.btBankAcc.bankTypeId')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="bankTypeId" name="bankTypeId" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankTypeId')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##开户行行号
				<label class="layui-form-label">#springMessage('table.btBankAcc.bankCode')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="bankCode" name="bankCode" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankCode')">
									</div>
			</div>
			<div class="layui-inline">
				##开户行名称
				<label class="layui-form-label">#springMessage('table.btBankAcc.bankName')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="bankName" name="bankName" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankName')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##所在省
				<label class="layui-form-label">#springMessage('table.btBankAcc.prov')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="prov" name="prov" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.prov')">
									</div>
			</div>
			<div class="layui-inline">
				##所在市
				<label class="layui-form-label">#springMessage('table.btBankAcc.city')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="city" name="city" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.city')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##接口代码
				<label class="layui-form-label">#springMessage('table.btBankAcc.bifCode')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="bifCode" name="bifCode" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bifCode')">
									</div>
			</div>
			<div class="layui-inline">
				##电票专户
				<label class="layui-form-label">#springMessage('table.btBankAcc.electricBill')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="electricBill" name="electricBill" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.electricBill')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##定期期限
				<label class="layui-form-label">#springMessage('table.btBankAcc.regulars')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="regulars" name="regulars" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.regulars')">
									</div>
			</div>
			<div class="layui-inline">
				##定期到期时间
				<label class="layui-form-label">#springMessage('table.btBankAcc.regularDate')</label>
				<div class="layui-input-inline">
										<div type="date" field="regularDate" defaultVal="$!{btBankAccPage.regularDate}"></div>
				</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##通知类型
				<label class="layui-form-label">#springMessage('table.btBankAcc.noticeType')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="noticeType" name="noticeType" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.noticeType')">
									</div>
			</div>
			<div class="layui-inline">
				##协定金额
				<label class="layui-form-label">#springMessage('table.btBankAcc.agrMoney')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="agrMoney" name="agrMoney" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.agrMoney')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##协定利率
				<label class="layui-form-label">#springMessage('table.btBankAcc.agrInterest')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="agrInterest" name="agrInterest" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.agrInterest')">
									</div>
			</div>
			<div class="layui-inline">
				##协定合同
				<label class="layui-form-label">#springMessage('table.btBankAcc.agrContract')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="agrContract" name="agrContract" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.agrContract')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##协定开始时间
				<label class="layui-form-label">#springMessage('table.btBankAcc.agrBeginDate')</label>
				<div class="layui-input-inline">
										<div type="date" field="agrBeginDate" defaultVal="$!{btBankAccPage.agrBeginDate}"></div>
				</div>
			</div>
			<div class="layui-inline">
				##协定结束时间
				<label class="layui-form-label">#springMessage('table.btBankAcc.agrEndDate')</label>
				<div class="layui-input-inline">
										<div type="date" field="agrEndDate" defaultVal="$!{btBankAccPage.agrEndDate}"></div>
				</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##利率
				<label class="layui-form-label">#springMessage('table.btBankAcc.rates')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="rates" name="rates" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.rates')">
									</div>
			</div>
			<div class="layui-inline">
				##利率是否浮动
				<label class="layui-form-label">#springMessage('table.btBankAcc.ratesFloat')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="ratesFloat" name="ratesFloat" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.ratesFloat')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##浮动百分比
				<label class="layui-form-label">#springMessage('table.btBankAcc.ratesFloatPer')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="ratesFloatPer" name="ratesFloatPer" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.ratesFloatPer')">
									</div>
			</div>
			<div class="layui-inline">
				##本册笔号
				<label class="layui-form-label">#springMessage('table.btBankAcc.volumeNum')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="volumeNum" name="volumeNum" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.volumeNum')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##存则册号
				<label class="layui-form-label">#springMessage('table.btBankAcc.bankbookNum')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="bankbookNum" name="bankbookNum" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankbookNum')">
									</div>
			</div>
			<div class="layui-inline">
				##计息周期
				<label class="layui-form-label">#springMessage('table.btBankAcc.interestCycle')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="interestCycle" name="interestCycle" 
					decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.interestCycle')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##计息日
				<label class="layui-form-label">#springMessage('table.btBankAcc.interestDate')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="interestDate" name="interestDate" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.interestDate')">
									</div>
			</div>
			<div class="layui-inline">
				##开户日期
				<label class="layui-form-label">#springMessage('table.btBankAcc.regDate')</label>
				<div class="layui-input-inline">
										<div type="date" field="regDate" defaultVal="$!{btBankAccPage.regDate}"></div>
				</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##对私编号
				<label class="layui-form-label">#springMessage('table.btBankAcc.privateNo')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="privateNo" name="privateNo" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.privateNo')">
									</div>
			</div>
			<div class="layui-inline">
				##是否上线
				<label class="layui-form-label">#springMessage('table.btBankAcc.isOnline')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="isOnline" name="isOnline" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.isOnline')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##是否查询余额或明细
				<label class="layui-form-label">#springMessage('table.btBankAcc.scanFlag')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="scanFlag" name="scanFlag" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.scanFlag')">
									</div>
			</div>
			<div class="layui-inline">
				##余额初始日期
				<label class="layui-form-label">#springMessage('table.btBankAcc.initBalanceDate')</label>
				<div class="layui-input-inline">
										<div type="date" field="initBalanceDate" defaultVal="$!{btBankAccPage.initBalanceDate}"></div>
				</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-inline">
				##初始余额
				<label class="layui-form-label">#springMessage('table.btBankAcc.initBalance')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="initBalance" name="initBalance" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.initBalance')">
									</div>
			</div>
			<div class="layui-inline">
				##备注
				<label class="layui-form-label">#springMessage('table.btBankAcc.rmk')</label>
				<div class="layui-input-inline">
					<!--number-->
					<input type="text" id="rmk" name="rmk" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.rmk')">
									</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-input-block">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAcc.add.js?_btv=${resourceVersion}"></script>
</html>
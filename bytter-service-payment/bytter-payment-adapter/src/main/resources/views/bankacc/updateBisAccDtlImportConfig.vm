<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{bisAccDtlImportConfigPage.id}">
		<input id="createBy" name="createBy" type="hidden" value="$!{bisAccDtlImportConfigPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{bisAccDtlImportConfigPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{bisAccDtlImportConfigPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{bisAccDtlImportConfigPage.updateDate}">

		<table class="layui-table">
			<tbody>
			<tr>
				<td class="textRight" width="20%">#springMessage('table.bisBifInit.bankType')</td>
				<td width="30%">
					<div class="layui-input-inline">
						<div data-name="bankTypeId" class="bt-biz-selectType"
							 data-url="${basePath}/basic/business/btbanktype/json"
							 data-valueField="id"
							 data-biz-name="bankTypeId"
							 data-textField="typeName"
							 data-required="true"
							 data-search="true"
							 data-value="$!{bisAccDtlImportConfigPage.bankTypeId}"></div>
					</div>
				</td>
				<td class="textRight" width="20%">#springMessage('common.table.filetype')</td>
				<td width="30%">
					<div class="bt-biz-dict" data-type="select" data-required="true" data-callback="bt.fileTypeCallback" data-defaultvalue="$!{bisAccDtlImportConfigPage.fileType}"
						 data-group="RAS_IMPORT_FILE_DICT" data-name="fileType" data-biz-name="fileType"></div>
				</td>
			</tr>
			<tr>
				<td class="textRight">
					<div id="dtlStartLineDiv">
						#if($!{bisAccDtlImportConfigPage.fileType} == "txt")
							#springMessage('ras.break.read.position')
						#else
							#springMessage('table.rasImportconf.begin.row')
						#end
					</div>
				</td>
				<td>
					<input type="text" id="dtlStartLine" name="dtlStartLine" lay-verify="required" data-decimal="0" data-separator="" value="$!{bisAccDtlImportConfigPage.dtlStartLine}"
						   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.rasImportconf.begin.row')">
				</td>
				<td class="textRight">
					<div id="readEndContentTitleDiv">
						#if($!{bisAccDtlImportConfigPage.fileType} == "txt")
							#springMessage('table.ras.received.import.separator')
						#else
							#springMessage('table.bisAccDtlImportConfig.readEndContent')
						#end
					</div>
				</td>
				<td>
					<div class="layui-input-inline" id="readEndContentDiv" #if($!{bisAccDtlImportConfigPage.fileType} == "txt") style="display: none" #end>
						<input type="text" id="readEndContent" name="readEndContent" value="$!{bisAccDtlImportConfigPage.readEndContent}"
							   autocomplete="off" class="layui-input">
					</div>
					<div class="layui-input-inline" id="dtlSeparatorDiv" #if($!{bisAccDtlImportConfigPage.fileType} != "txt") style="display: none" #end>
						<input type="text" id="dtlSeparator" name="dtlSeparator"  #if($!{bisAccDtlImportConfigPage.fileType} == "txt") lay-verify="required" #end value="$!{bisAccDtlImportConfigPage.dtlSeparator}"
							   autocomplete="off" class="layui-input">
					</div>
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.bisAccDtlBudgetRule.sign')</td>
				<td>
					<div class="bt-biz-dict" data-type="select" data-callback="bt.cdSignCallback" data-required="true" data-defaultvalue="$!{bisAccDtlImportConfigPage.cdSign}"
						 data-group="bisAccDtlImportConfig.cdSign" data-name="cdSign" data-biz-name="cdSign"></div>
				</td>
				<td class="textRight">#springMessage('table.bisAccDtlImportConfig.dateRow')</div></td>
				<td>
					<div class="bt-biz-dict" data-type="select" data-callback="bt.dateRowCallback" data-required="true" data-defaultvalue="$!{bisAccDtlImportConfigPage.dateRow}"
						 data-group="bisAccDtlImportConfig.dateRow" data-name="dateRow" data-biz-name="dateRow"></div>
				</td>
			</tr>
			</tbody>
		</table>
		#if($!headList)
			<table id="appTable" class="layui-table layui-form" style="width:100%;">
				<thead>
				<tr>
					<th></th>
					#foreach($headSera in $headList)
						#if(($!{bisAccDtlImportConfigPage.cdSign} == '0' && ($!{headSera.key} == 'cdSignStr' || $!{headSera.key} == 'transMoney'))
						|| ($!{bisAccDtlImportConfigPage.cdSign} == '1' && ($!{headSera.key} == 'payMoney' || $!{headSera.key} == 'incomeMoney'))
						|| ($!{bisAccDtlImportConfigPage.cdSign} == '2' && ($!{headSera.key} == 'cdSignStr' || $!{headSera.key} == 'payMoney' || $!{headSera.key} == 'incomeMoney'))
						|| ($!{bisAccDtlImportConfigPage.dateRow} == '1' && $!{headSera.key} == 'transDate'))
							<th style="display: none" id="$!{headSera.key}Th">#if(${headSera.required}==true)<span style="color:red;">*</span> #end #springMessage(${headSera.name})</th>
						#else
							<th id="$!{headSera.key}Th">#if(${headSera.required}==true)<span style="color:red;">*</span> #end #springMessage(${headSera.name})</th>
						#end
					#end
				</tr>
				</thead>
				<tbody class="ignore-required-icon layui-form">
					<tr>
						<td>
							<div id="itemTitle">
								#if(${pageDateVo.fileType}=='txt')
									##TXT格式才显示
									#springMessage('ras.break.read.position')
								#else
									#springMessage('ras.currer.row')
								#end
							</div>
						</td>
						#foreach($rasImportConfVO in $headList)
							#if(($!{bisAccDtlImportConfigPage.cdSign} == '0' && ($!{rasImportConfVO.key} == 'cdSignStr' || $!{rasImportConfVO.key} == 'transMoney'))
							|| ($!{bisAccDtlImportConfigPage.cdSign} == '1' && ($!{rasImportConfVO.key} == 'payMoney' || $!{rasImportConfVO.key} == 'incomeMoney'))
							|| ($!{bisAccDtlImportConfigPage.cdSign} == '2' && ($!{rasImportConfVO.key} == 'cdSignStr' || $!{rasImportConfVO.key} == 'payMoney' || $!{rasImportConfVO.key} == 'incomeMoney'))
							|| ($!{bisAccDtlImportConfigPage.dateRow} == '1' && $!{rasImportConfVO.key} == 'transDate'))
								<td style="display: none" id="$!{rasImportConfVO.key}Td">
									<input  type="hidden" name="dtlList[${velocityCount}].fieldKey" value="$!{rasImportConfVO.key}" autocomplete="off" class="layui-input" >
									<input  type="hidden" name="dtlList[${velocityCount}].id" value="$!{rasImportConfVO.id}" autocomplete="off" class="layui-input" >
									<input  type="text" name="dtlList[${velocityCount}].startVal" id="$!{rasImportConfVO.key}" data-fieldKey="$!{rasImportConfVO.key}" style="width:100px;" value="$!{rasImportConfVO.value}" autocomplete="off" class="layui-input" >
								</td>
							#else
								<td id="$!{rasImportConfVO.key}Td">
									<input  type="hidden" name="dtlList[${velocityCount}].fieldKey" value="$!{rasImportConfVO.key}" autocomplete="off" class="layui-input" >
									<input  type="hidden" name="dtlList[${velocityCount}].id" value="$!{rasImportConfVO.id}" autocomplete="off" class="layui-input" >
									<input  type="text" name="dtlList[${velocityCount}].startVal" id="$!{rasImportConfVO.key}" data-fieldKey="$!{rasImportConfVO.key}" #if(${rasImportConfVO.required}=='true') lay-verify="required" #end style="width:100px;" value="$!{rasImportConfVO.value}" autocomplete="off" class="layui-input" >
								</td>
							#end
						#end
					</tr>
				</tbody>
			</table>
			<div id="itemDesc" style="color:red;font-weight: bold; padding-top: 10px;">
				#if($!{bisAccDtlImportConfigPage.fileType} == "txt")
					#springMessage('ras.break.read.position.confrm.msg')
				#else
					#springMessage('ras.reven.confrm.msg')
				#end
			</div>
		#end
		<div style="text-align: center; padding-top: 10px;">
			<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
			<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisAccDtlImportConfig.edit.js?_btv=${resourceVersion}"></script>
</html>

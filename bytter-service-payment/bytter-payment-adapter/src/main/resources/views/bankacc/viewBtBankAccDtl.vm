<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="id" name="id" value="$!{btBankAccDtlPage.id}">
    <input type="hidden" id="accNo" name="accNo" value="$!{btBankAccDtlPage.accNo}">
    <input type="hidden" id="corpId" name="corpId" value="$!{btBankAccDtlPage.corpId}">
    <input type="hidden" id="curId" name="curId" value="$!{btBankAccDtlPage.curId}">
    <input type="hidden" id="createBy" name="createBy" value="$!{bisAccBalPage.createBy}">
    <input type="hidden" id="createDate" name="createDate" value="$!{bisAccBalPage.createDate}">
    <input type="hidden" id="updateBy" name="updateBy" value="$!{bisAccBalPage.updateBy}">
    <input type="hidden" id="updateDate" name="updateDate" value="$!{bisAccBalPage.updateDate}">
    <input type="hidden" id="status" name="status" value="$!{bisAccBalPage.status}">
    <input type="hidden" id="rbSign" name="rbSign" value="$!{bisAccBalPage.rbSign}">
    <input id="busType" type="hidden" value="$!{busType}">
    <div id="print">
        <table class="layui-table breakRow">
            <tbody>
            <tr>
            ##本方账号
                <td class="textRight" style="width: 60px">#springMessage('table.btBankAccDtl.bankAcc')</td>
                <td style="width: 190px">
                    $!{btBankAccDtlPage.bankAcc}
                </td>
            ##本方账户名
                <td class="textRight" style="width: 90px">#springMessage('table.btBankAccDtl.accName')</td>
                <td style="width: 190px">
                    $!{btBankAccDtlPage.accName}
                </td>
            ##本方账户开户行
                <td class="textRight" style="width: 110px">#springMessage('table.btBankAccDtl.bankName')</td>
                <td style="width: 190px">
                    $!{btBankAccDtlPage.bankName}
                </td>
            </tr>
            <tr>
            ##对方账号
                <td class="textRight">#springMessage('table.btBankAccDtl.oppAccNo')</td>
                <td>
                    $!{btBankAccDtlPage.oppAccNo}
                </td>
            ##对方账户名
                <td class="textRight">#springMessage('table.btBankAccDtl.oppAccName')</td>
                <td >
                    $!{btBankAccDtlPage.oppAccName}
                </td>
            ##对方账户开户行
                <td class="textRight">#springMessage('table.btBankAccDtl.oppAccBank')</td>
                <td>
                    $!{btBankAccDtlPage.oppAccBank}
                </td>
            </tr>
            <tr>
            ##借贷标志 0-收 1-支
                <td class="textRight">#springMessage('table.btBankAccDtl.cdSign')</td>
                <td>
                    $dictTag.get("btBankAccDtl.cdSign", $!{btBankAccDtlPage.cdSign})
                </td>
            ##币别ID
                <td class="textRight">#springMessage('table.btBankAccDtl.curName')</td>
                <td>
                    $!{btBankAccDtlPage.curName}
                </td>
            ##接口代码
                <td class="textRight">#springMessage('table.btBankAccDtl.bifCode')</td>
                <td>
                    $!{btBankAccDtlPage.bifName}
                </td>
            </tr>
            <tr>
            ##交易金额
                <td class="textRight">#springMessage('table.btBankAccDtl.amt')</td>
                <td>
                    $!number.formatNumeric($!{btBankAccDtlPage.amt})
                </td>
            ##余额
                <td class="textRight">#springMessage('table.btBankAccDtl.bal')</td>
                <td>
                    $!number.formatNumeric($!{btBankAccDtlPage.bal})
                </td>
            ##交易时间
                <td class="textRight">#springMessage('table.btBankAccDtl.transTime')</td>
                <td>
                    $!date.format('yyyy-MM-dd',$!{btBankAccDtlPage.transTime})
                </td>
            </tr>
            <tr>
            ##月份
                <td class="textRight">#springMessage('table.btBankAccDtl.months')</td>
                <td>
                    $!{btBankAccDtlPage.months}
                </td>
            ##用途
                <td class="textRight">#springMessage('table.btBankAccDtl.uses')</td>
                <td>
                    $!{btBankAccDtlPage.uses}
                </td>
            ##项目信息
                <td class="textRight">#springMessage('table.btBankAccDtl.projectRemark')</td>
                <td>
                    $!{btBankAccDtlPage.projectRemark}
                </td>
            </tr>
            <tr>
            ##摘要
                <td class="textRight">#springMessage('table.btBankAccDtl.remark')</td>
                <td colspan="5">
                    <textarea readonly style="width: 90%; min-height: 80px; border: 1px solid #e6e6e6; padding: 8px; resize: vertical;">$!{btBankAccDtlPage.remark}</textarea>
                </td>
            </tr>
            </tbody>
        </table>
	</div>
    <!-- 日志 -->
    <div id="tagMsg"></div>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
		<div class="layui-input-block">
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
		</div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['moneyType', 'printType'], function () {
        var $ = bt.jquery;
        bt.printType.init();
        /**
         * 生成日志列表
         * @return
         */
            $genMsgHtml= function () {
            var url = basePath + "/bankacc/message/list/" + $('#id').val() + "/" + $("#busType").val();
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                }
            });
        }
            $genMsgHtml();
    })
</script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<!--附件上传 -->
<input id="attachmentId" name="attachmentId" type="hidden" value="$!{attachmentId}">
<div id="uploader" class="layui-input-inline" style="width: 100%"></div>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['btUpload'], function () {
        var up = bt.btUpload.init({
            elem: "#uploader",
            auto: false,
            hasDelete: false,
            hasUpload: false,
            isExpand: true,
            gid: $("#attachmentId").val()
        });
    })
</script>
</html>



<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
    		<tbody>
    			<tr>

    				##单位ID
					<td class="textRight">#springMessage('table.btBankAcc.corpId')</td>
                    <td>
                		<div class="layui-input-inline">
                			<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-name="eqs_corpId"
                            data-scope="all"
                            data-defaultvalue="$!{corpId}"
                            data-afterInit="afterInitCorpComplete"
                            ##                            data-resource="netbank:bankAcc:btBankAccApp:query"
                        	></div>
                        </div>
            		</td>
					<td class="textRight">#springMessage('table.btBankAccApp.bankAcc')</td>
					<td>
                        <input type="text" name="likes_bankAcc"
                            autocomplete="off" class="bank layui-input" placeholder="#springMessage('table.btBankAccApp.bankAcc')">
                  	</td>
                    <td class="textRight">#springMessage('table.btBankAccApp.accType')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="btBankAcc.accType"
                             data-defaultvalue="$!{btBankAccAppPage.accType}" data-name="eqs_accType" data-biz-name="eqs_accType"></div>
                    </td>
        		</tr>
				<tr>
                    <td class="textRight">#springMessage('table.btBankAccApp.attributeId')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/bankacc/bisaccattribute/json"
                             data-valuefield="id" data-textfield="attributeName"  data-name="eqs_attributeId"
                             data-inputvalue="inputvalue" data-search="true"></div>
                    </td>
                    <td class="textRight">#springMessage('table.btBankAccApp.natureId')</td>
                    <td>
                        <div type="list" field="eqs_natureId" fieldHref="${basePath}/bankacc/btaccnature/json"
                             dictField="id" dictText="natureName"  defaultVal="$!{btBankAccAppPage.natureId}"></div>
                    </td>
                    <td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json" data-method="get"
                                 data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId" data-inputvalue="inputvalue" data-search="true"></div>
                        </div>
    				</td>
    			</tr>
				<tr>
					<td align="center" colspan="6">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
    	</table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.btBankAccApp.bankAcc')</th>
            <th>#springMessage('table.btBankAccApp.accName')</th>
            <th>#springMessage('table.btBankAccApp.corpId')</th>
            <th>#springMessage('table.btBankAccApp.curId')</th>
            <th>#springMessage('table.btBankAccApp.accType')</th>
            <th>#springMessage('table.btBankAccApp.attributeId')</th>
            <th>#springMessage('table.btBankAccApp.natureId')</th>
            <th>#springMessage('table.btBankAccApp.bankTypeId')</th>
            <th>#springMessage('table.btBankAccApp.bankName')</th>
            <th>#springMessage('table.btBankAcc.regDate')</th>
##            <th>#springMessage('table.btBankAcc.endDate')</th>
        </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccOld.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="font-src *  data:">
    <meta name="viewport"
          content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0, user-scalable=no">
    <title>账户流水详情</title>
    <!-- 引入 FrozenUI -->
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css" media="all"/>
    <link rel="stylesheet" href="${basePath}/static/css/mobile/index.css" media="all"/>
    <!-- 注意：如果你直接复制所有代码到本地，上述js路径需要改成你本地的 -->
    <script src="${basePath}/static/mobile/plugins/zepto/zepto.min.js"></script>
    <script src="${basePath}/static/plugins/f2/f2.min.js"></script>
    <script src="${basePath}/static/js/mobile/date.js"></script>
    <style>
        body{
            background-color: #f5f5f5;
        }

        .content {
            margin-top: 0.1rem;
            width: 100%;
            height: auto;
            background-color: #ffffff;
        }

        .content-item{
            height: 0.38rem;
            margin-right: 0.15rem;
            margin-left: 0.15rem ;
            border-bottom: 1px solid #EFEFEF;
        }
        .content-item-bottom{
            height: 0.38rem;
            margin-right: 0.15rem;
            margin-left: 0.15rem ;
        }
        .content-dtl1{
            color: #999999;
            display: inline-block;
            margin-top: 0.15rem;
            width:1rem;
            font-size: 0.12rem;

        }
        .content-dtl2{
            display: inline-block;
            margin-top: 0.15rem;
            float: right;
            font-size: 0.12rem;
            text-align: right;

            width: 55%;
            white-space:nowrap;
            overflow-x:auto;
        }

        .dtl-box{
            height: 1.38rem;
            background-color: #ffffff;
        }
        .dtl-head{
            position: absolute;
            width: 100%;
            margin-top: 0.21rem;
            text-align: center;
            font-size:0.16rem;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(51,51,51,1);
            line-height:0.16rem;
        }

        .dtl-add{
            position: absolute;
            margin-top: 0.17rem;
            font-size:0.14rem;
            font-family:PingFangSC-Regular,PingFang SC;
            color:#ffffff;
            line-height:0.16rem;
            width: 0.14rem;
            height: 0.14rem;
            padding-right: 0.06rem ;
            padding-left: 0.06rem ;
            padding-bottom: 0.07rem ;
            padding-top: 0.05rem ;
            border-radius: 50%;
            font-weight:600;
            background-color: #2988FF;
            margin-left: 1.23rem;
        }

        .dtl-pay{
            position: absolute;
            margin-top: 0.17rem;
            font-size:0.14rem;
            font-family:PingFangSC-Regular,PingFang SC;
            color:#ffffff;
            line-height:0.16rem;
            width: 0.14rem;
            height: 0.14rem;
            padding-right: 0.06rem ;
            padding-left: 0.06rem ;
            padding-bottom: 0.07rem ;
            padding-top: 0.05rem ;
            border-radius: 50%;
            font-weight:600;
            background-color: #FF5555;
            margin-left: 1.23rem;
        }

        .dtl-right{
            float: right;
            margin-top: 0.17rem;
            font-size:0.12rem;
            padding-right: 0.16rem ;
            padding-bottom: 0.07rem ;
            padding-top: 0.05rem ;
            color:#999999;
            line-height:0.16rem;
            width:0.72rem;
            height:0.12rem;
            font-weight:400;
        }

        .dtl-body{
            position: absolute;
            width: 100%;
            margin-top: 0.68rem;
            text-align: center;
            font-size:0.22rem;
            font-weight:bold;
            color:#333333;
            line-height:0.2rem;
        }

        .dtl-bottom{
            position: absolute;
            width: 100%;
            margin-top: 1.06rem;
            text-align: center;
            color:#333333;
            height:12px;
            font-size:0.12rem;
            font-weight:400;
            color:rgba(51,51,51,1);
            line-height:0.12rem;
        }
    </style>
</head>
<body>
<div class="dtl-box">
    #if($!{dtl.cdSign}==1)
        <div class="dtl-pay">付</div>
        <div class="dtl-head">付款回单</div>
    #else
        <div class="dtl-add">收</div>
        <div class="dtl-head">收款回单</div>
    #end
    <div class="dtl-right">币种: $!{dtl.curName}</div>

    #if($!{dtl.cdSign}==1)
        <div class="dtl-body">- $!number.formatNumeric($!{dtl.amt})</div>
    #else
        <div class="dtl-body">+ $!number.formatNumeric($!{dtl.amt})</div>
    #end
    <div class="dtl-bottom">大写：$!{chinese}</div>

</div>
<div class="content">
    <div class="content-item">
        <span class="content-dtl1">交易时间</span>
        <span class="content-dtl2">$!date.format('yyyy-MM-dd HH:mm:ss',$!{dtl.transTime})</span>
    </div>
    <div class="content-item">
        <span class="content-dtl1">单位名称</span>
        <span class="content-dtl2">$!{dtl.corpName}</span>
    </div>
    #if($!{dtl.cdSign}==1)
        <div class="content-item">
            <span class="content-dtl1">付款人账号</span>
            <span class="content-dtl2">$!{dtl.bankAcc}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">付款人名称</span>
            <span class="content-dtl2">$!{dtl.accName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">付款人开户行</span>
            <span class="content-dtl2">$!{dtl.bankName}</span>
        </div>
    #else
        <div class="content-item">
            <span class="content-dtl1">付款人账号</span>
            <span class="content-dtl2">$!{dtl.oppAccNo}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">付款人名称</span>
            <span class="content-dtl2">$!{dtl.oppAccName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">付款人开户行</span>
            <span class="content-dtl2">$!{dtl.oppAccBank}</span>
        </div>
    #end
    <div class="content-item">
        <span class="content-dtl1">摘要</span>
        <span class="content-dtl2">$!{dtl.remark}</span>
    </div>

    #if($!{dtl.cdSign}==1)
        <div class="content-item">
            <span class="content-dtl1">收款人账号</span>
            <span class="content-dtl2">$!{dtl.oppAccNo}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">收款人名称</span>
            <span class="content-dtl2">$!{dtl.oppAccName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">收款人开户行</span>
            <span class="content-dtl2">$!{dtl.oppAccBank}</span>
        </div>
    #else
        <div class="content-item">
            <span class="content-dtl1">收款人账号</span>
            <span class="content-dtl2">$!{dtl.bankAcc}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">收款人名称</span>
            <span class="content-dtl2">$!{dtl.accName}</span>
        </div>
        <div class="content-item">
            <span class="content-dtl1">收款人开户行</span>
            <span class="content-dtl2">$!{dtl.bankName}</span>
        </div>
    #end
    <div class="content-item-bottom">
        <span class="content-dtl1">项目信息</span>
        #if($!{dtl.projectRemark})
            <span class="content-dtl2">$!{dtl.projectRemark}</span>
        #else
            <span class="content-dtl2"></span>
        #end

    </div>
</div>
</body>
</html>

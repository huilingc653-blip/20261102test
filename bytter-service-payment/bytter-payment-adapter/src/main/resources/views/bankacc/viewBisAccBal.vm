<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">

    <input type="hidden" id="id" name="id" value="$!{bisAccBalPage.id}">
    <input type="hidden" id="accNo" name="accNo" value="$!{bisAccBalPage.accNo}">
    <input type="hidden" id="corpId" name="corpId" value="$!{bisAccBalPage.corpId}">
    <input type="hidden" id="bifCode" name="bifCode" value="$!{bisAccBalPage.bifCode}">
    <input type="hidden" id="getDate" name="getDate" value="$!{bisAccBalPage.getDate}">
    <input type="hidden" id="frzBal" name="frzBal" value="$!{bisAccBalPage.frzBal}">
    <input type="hidden" id="returnCode" name="returnCode" value="$!{bisAccBalPage.returnCode}">
    <input type="hidden" id="returnMsg" name="returnMsg" value="$!{bisAccBalPage.returnMsg}">
    <input type="hidden" id="returnCode" name="returnCode" value="$!{bisAccBalPage.returnCode}">
    <input type="hidden" id="status" name="status" value="$!{bisAccBalPage.status}">
    <input type="hidden" id="createBy" name="createBy" value="$!{bisAccBalPage.createBy}">
    <input type="hidden" id="createDate" name="createDate" value="$!{bisAccBalPage.createDate}">
    <input type="hidden" id="updateBy" name="updateBy" value="$!{bisAccBalPage.updateBy}">
    <input type="hidden" id="updateDate" name="updateDate" value="$!{bisAccBalPage.updateDate}">
    <input id="busType" type="hidden" value="$!{busType}">
    <div id="print">
        <table class="layui-table">
            <tbody>
            <tr>
            ##银行账号
                <td class="textRight">#springMessage('table.bisAccBal.accName')</td>
                <td>
                    $!{bisAccBalPage.accName}
                </td>
            </tr>
            <tr>
            ##开户行
                <td class="textRight">#springMessage('table.bisAccBal.bankName')</td>
                <td>
                    $!{bisAccBalPage.bankName}
                </td>
            </tr>
            <tr>
            ##银行账号
                <td class="textRight">#springMessage('table.bisAccBal.bankAcc')</td>
                <td>
                    $!{bisAccBalPage.bankAcc}
                </td>
            </tr>
            <tr>
            ##余额日期
                <td class="textRight">#springMessage('table.bisAccBal.balDate')</td>
                <td>
                    $!date.format('yyyy-MM-dd',$!{bisAccBalPage.balDate})
                </td>
            </tr>
            <tr>
            ##余额
                <td class="textRight">#springMessage('table.bisAccBal.bal')</td>
                <td>
                    $!number.formatNumeric($!{bisAccBalPage.bal})
                </td>
            </tr>
            <tr>
                ##可用余额
                <td class="textRight">#springMessage('table.bisAccBal.availBal')</td>
                <td>
                    $!number.formatNumeric($!{bisAccBalPage.availBal})
                </td>
            </tr>
            </tbody>
        </table>
	</div>
    <!-- 日志 -->
    <div id="tagMsg"></div>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
		<div class="layui-input-block">
            <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{bisAccBalPage.id}')">#springMessage('common.button.trackFlow')</button>
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
		</div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['moneyType', 'printType'], function () {
        var $ = bt.jquery;
        bt.printType.init();
        /**
         * 生成日志列表
         * @return
         */
            $genMsgHtml= function () {
            var url = basePath + "/bankacc/message/list/" + $('#id').val() + "/" + $("#busType").val();
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                }
            });
        }
            $genMsgHtml();
    })
</script>
</body>
</html>
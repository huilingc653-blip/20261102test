<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        table.layui-table
        {
            border:none !important;
            width: 100%;
            margin-left: auto;
            margin-right: auto;
        }
    </style>
</head>
<body>

    #if( $!{rules}=="shoudong" )
    <p style="color: #ff0000">#springMessage('table.bisAccDtl.rules')#springMessage('table.bisAccDtl.rules2')</p>
    #elseif($!{rules})
    <p style="color: #ff0000">#springMessage('table.bisAccDtl.rules')#springMessage('table.bisAccDtl.rules1'),$!{rules}</p>

    #end
    <table class="layui-table dark-layui-table">
        <thead>
        <tr>
            <th colspan="8" style="text-align:center"><h5><strong>$dictTag.get("eleBill.paySign", "$!{bisAccDtlPage.cdSign}")</strong></h5></th>
        </tr>
        </thead>
        <tbody>
            <tr>
                ##交易时间
                <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.transTime')：</td>
                <td colspan="2">$!date.format('yyyy-MM-dd HH:mm:ss.S',$!{bisAccDtlPage.transTime})</td>
                ##单位名称
                <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.corpName')：</td>
                <td colspan="2">$!{bisAccDtlPage.corpName}</td>
            </tr>
            #if($!{bisAccDtlPage.cdSign} == 1)
            ##支出
                <tr>
                    ##付款人账号
                    <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.payerAccNo')：</td>
                    <td colspan="2">$!{bisAccDtlPage.bankAcc}</td>
                    ##收款人账号
                    <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.payeeAccNo')：</td>
                    <td colspan="2">$!{bisAccDtlPage.oppAccNo}</td>
                </tr>
                <tr>
                ##付款人名称
                    <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.payerAccName')：</td>
                    <td colspan="2">$!{bisAccDtlPage.accName}</td>
                ##收款人名称
                    <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.payeeAccName')：</td>
                    <td colspan="2">$!{bisAccDtlPage.oppAccName}</td>
                </tr>
                <tr>
                ##付款人开户行
                    <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.payerBank')：</td>
                    <td colspan="2">$!{bisAccDtlPage.bankName}</td>
                ##收款人开户行
                    <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.payeeBank')：</td>
                    <td colspan="2">$!{bisAccDtlPage.oppAccBank}</td>
                </tr>
            #else
            ##收入
                <tr>
                    ##付款人账号
                    <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.payerAccNo')：</td>
                    <td colspan="2">$!{bisAccDtlPage.oppAccNo}</td>
                    ##收款人账号
                    <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.payeeAccNo')：</td>
                    <td colspan="2">$!{bisAccDtlPage.bankAcc}</td>
                </tr>
                <tr>
                ##付款人名称
                    <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.payerAccName')：</td>
                    <td colspan="2">$!{bisAccDtlPage.oppAccName}</td>
                ##收款人名称
                    <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.payeeAccName')：</td>
                    <td colspan="2">$!{bisAccDtlPage.accName}</td>
                </tr>
                <tr>
                ##付款人开户行
                    <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.payerBank')：</td>
                    <td colspan="2">$!{bisAccDtlPage.oppAccBank}</td>
                ##收款人开户行
                    <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.payeeBank')：</td>
                    <td colspan="2">$!{bisAccDtlPage.bankName}</td>
                </tr>
            #end
            <tr>
            ##币种
                <td class="textLeft" width="3%">#springMessage('table.bisAccDtl.curName')：</td>
                <td width="12%" class="textLeft">$!{bisAccDtlPage.curName}</td>
            ##交易额
                <td class="textLeft" width="5%" colspan="2">#springMessage('table.bisAccDtl.amt')：
                    ##交易额(小写)
                    $!number.formatNumeric($!{bisAccDtlPage.amt})
                    <div style="display: none;">
                        <input class="bt-biz-moneyType" data-name="plMoney" value="$!{bisAccDtlPage.amt}" data-toup="plMoneyUpper" data-biz-name="plMoney" data-decimal="2" data-minus="false">
                    </div>
                </td>
                <td width="20%" class="textLeft" colspan="4">
                    <span>#springMessage('table.bisAccDtl.moneyUpper')</span><span id="plMoneyUpper"></span>
                </td>
            </tr>
            <tr style="border-bottom: 1px solid #d2d2d2">
                <td colspan="8"></td>
            </tr>
            <tr>
                ##借贷标志
                <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.cdSign')：</td>
                <td width="30%" colspan="2">$dictTag.get("btBankAccDtl.cdSign",$!{bisAccDtlPage.cdSign})</td>
                ##摘要
                <td class="textLeft" colspan="2">#springMessage('table.bisAccDtl.summary')：</td>
                <td width="30%" colspan="2">$!{bisAccDtlPage.remark}</td>
            </tr>
            <tr>
            ##项目信息
                <td class="textLeft" colspan="2">#springMessage('table.btBankAccDtl.projectRemark')：</td>
                <td width="30%" colspan="2">$!{bisAccDtlPage.projectRemark}</td>
            ##用途
                <td class="textLeft" colspan="2">#springMessage('table.btBankAccDtl.uses')：</td>
                <td width="30%" colspan="2">$!{bisAccDtlPage.uses}</td>
            </tr>
        </tbody>
        <div class="layui-form-item layui-form-submit" id="buttonDiv">
            <div class="layui-input-block">
                <button type="button" class="layui-btn" onclick="prints()">#springMessage('common.button.print')</button>
                <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
            </div>
        </div>
    </table>
        #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bankacc/bisAccDtlPrint.js?_btv=${resourceVersion}"></script>
</html>

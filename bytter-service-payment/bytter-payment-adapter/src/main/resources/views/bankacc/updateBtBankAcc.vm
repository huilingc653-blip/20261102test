<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{btBankAccPage.id}">
		<input id="status" name="status" type="hidden" value="$!{btBankAccPage.status}">
		<input id="createBy" name="createBy" type="hidden" value="$!{btBankAccPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{btBankAccPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{btBankAccPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{btBankAccPage.updateDate}">
		<input id="prov" name="prov" type="hidden" value="$!{btBankAccPage.prov}">
		<input id="city" name="city" type="hidden" value="$!{btBankAccPage.city}">
        <input id="regulars" name="regulars" type="hidden" value="$!{btBankAccPage.regulars}">
        <input id="noticeType" name="noticeType" type="hidden" value="$!{btBankAccPage.noticeType}">
        <input id="agrMoney" name="agrMoney" type="hidden" value="$!{btBankAccPage.agrMoney}">
        <input id="agrContract" name="regulars" type="hidden" value="$!{btBankAccPage.agrContract}">
        <input id="agrInterest" name="noticeType" type="hidden" value="$!{btBankAccPage.agrInterest}">
        <input id="agrBeginDateTemp" name="agrBeginDateTemp" type="hidden" value="$!{btBankAccPage.agrBeginDate}">
        <input id="agrEndDateTemp" name="agrEndDateTemp" type="hidden" value="$!{btBankAccPage.agrEndDate}">
        <table class="layui-table breakRow" id="test">
            <tbody>
        		<tr>
    				##银行账号
                    <td class="textRight">#springMessage('table.btBankAcc.bankAcc')</td>
    				<td width="40%">
    					<input type="text" id="bankAcc" name="bankAcc" lay-verify="required"
							autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.btBankAcc.bankAcc')" value="$!{btBankAccPage.bankAcc}">
    				</td>
    				##账户名称
                    <td class="textRight">#springMessage('table.btBankAcc.accName')</td>
            		<td width="40%">
    					<input type="text" id="accName" name="accName" lay-verify="required"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.accName')" value="$!{btBankAccPage.accName}" readonly="readonly">
    				</td>
        		</tr>
        		<tr>
    				##单位ID
                    <td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAcc.corpId')</td>
                    <td>
##                		<div class="layui-input-inline">
##                			<div class="bt-biz-corp"
##                            data-biz-type="corp"
##                            data-type="selectTree"
##                            data-name="corpId"
##                            data-scope="all" data-resource="netbank:bankAcc:btBankAcc:apply"
##                        	data-required="true"
##                        	data-defaultvalue="$!{btBankAccPage.corpId}"/>
##                        </div>
						<input type="hidden" name="corpId" value="$!{btBankAccPage.corpId}"/>
                        $!{corpName}
					</td>
    				##开户行名称
					<td class="textRight">#springMessage('table.btBankAcc.bankName')</td>
					<td>
                        <div class="layui-input-inline">
    						<input type="text" id="bankName" name="bankName" lay-verify="required" readonly="readonly"
								autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankName')" value="$!{btBankAccPage.bankName}">
                        </div>
##						<button type="button" class="layui-btn bt-biz-bankInfo" data-callback="bt.bankinfoCallback">#springMessage('common.button.select')</button>
    				</td>
				</tr>
				<tr>
    				##开户行行号
                    <td class="textRight">#springMessage('table.btBankAcc.bankCode')</td>
            		<td>
    					<input type="text" id="bankCode" name="bankCode" lay-verify="required|number"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankCode')" value="$!{btBankAccPage.bankCode}" readonly="readonly">
    				</td>
    				##账户性质
                    <td class="textRight">#springMessage('table.btBankAcc.natureId')</td>
          			<td>
    					<div type="list" field="natureId" fieldHref="${basePath}/bankacc/btaccnature/json" dictField="id" dictText="natureName" data-required="true" defaultVal="$!{btBankAccPage.natureId}" disabled="true"></div>
    				</td>

                <tr>
                ##银行类别
                    <td class="textRight">#springMessage('table.btBankAcc.bankTypeId')</td>
                    <td>
                        <input type="hidden" id="bankTypeIdHid" value="$!{btBankAccPage.bankTypeId}"/>
                        <input type="hidden" id="bankPrefix" value=""/>
                        <div type="list" class="bankTypeId" field="bankTypeId" fieldHref="${basePath}/basic/business/btbanktype/json" data-biz-name="bankTypeId" disabled="true"
                             dictField="id" dictText="typeName" data-required="true" defaultVal="$!{btBankAccPage.bankTypeId}" data-callback="bt.bankTypeChange" initCallBack="bt.bankTypeInit"></div>
                    </td>
                ##账户属性
                    <td class="textRight">#springMessage('table.btBankAcc.attributeId')</td>
                    <td>
                        <div type="list" field="attributeId" fieldHref="${basePath}/bankacc/bisaccattribute/json" dictField="id" dictText="attributeName" data-required="true" defaultVal="$!{btBankAccPage.attributeId}" disabled="true"></div>
                    </td>
                </tr>
                <tr>
                ##接口代码
                    <td class="textRight">#springMessage('table.btBankAcc.bifCode')</td>
                    <td>
                        <div type="list" field="bifCode" data-required="true" fieldHref="${basePath}/basic/business/bisbifinit/json" dictField="id" dictText="name" defaultVal="$!{btBankAccPage.bifCode}"></div>
                    </td>
                ##电票专户
                    <td class="textRight">#springMessage('table.btBankAcc.electricBill')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{btBankAccPage.electricBill}" data-name="electricBill" data-biz-name="electricBill" data-disabled="true"></div>
                    </td>
                </tr>
				<tr>
    				##账户类别
                    <td class="textRight">#springMessage('table.btBankAcc.accType')</td>
					<td>
						<div class="bt-biz-dict" data-type="select" data-group="btBankAcc.accType" data-required="true"
							data-defaultvalue="$!{btBankAccPage.accType}" data-name="accType" data-biz-name="accType" data-callback="bt.chang" data-disabled="true"></div>
    				</td>
    				##利率
					<td class="textRight">#springMessage('table.btBankAcc.rates')</td>
					<td>
						<input type="text" data-name="rates" class="layui-input bt-biz-rateType" lay-verify="required"
							placeholder="#springMessage('table.btBankAcc.rates')" value="$!{btBankAccPage.rates}">
					</td>
				</tr>
				<tr class="tp">
					<td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAccApp.curId')</td>
					<td>
						<input type="hidden" value="$!{curId}" name="curId" id="curId" lay-verify="required" />
						<div class="cks" data-disabled="true"></div>
					</td>
                    <td align="right" class="type"></td>
                    <td class="typeText"></td>
				</tr>
				<tr>
    				##利率是否浮动
                    <td class="textRight">#springMessage('table.btBankAcc.ratesFloat')</td>
    				<td>
						<input type="radio" name="ratesFloat" checked="checked"  title="#springMessage('common.sc_yn.no')" value="0" lay-filter = "ratesFloat">
						<input type="radio" name="ratesFloat" title="#springMessage('common.sc_yn.yes')" value="1" lay-filter = "ratesFloat"/>
					</td>
    				##浮动百分比
                    <td class="textRight">#springMessage('table.btBankAcc.ratesFloatPer')</td>
					<td>
						<input type="text" data-name="ratesFloatPer" class="layui-input bt-biz-rateType" data-decimal="2" disabled
							placeholder="#springMessage('table.btBankAcc.ratesFloatPer')" value="$!{btBankAccPage.ratesFloatPer}">
					</td>
				</tr>
				<tr>
    				##本册笔号
                    <td class="textRight">#springMessage('table.btBankAcc.volumeNum')</td>
    				<td>
    					<input type="text" id="volumeNum" name="volumeNum"
    						autocomplete="off" class="layui-input inlineblock" placeholder="#springMessage('table.btBankAcc.volumeNum')" value="$!{btBankAccPage.volumeNum}">
                        <div class="inlineblock">(#springMessage("table.btBankAcc.bankbookNum.rmk"))</div>
					</td>
    				##存则册号
                    <td class="textRight">#springMessage('table.btBankAcc.bankbookNum')</td>
					<td>
    					<input type="text" id="bankbookNum" name="bankbookNum"
    						autocomplete="off" class="layui-input inlineblock" placeholder="#springMessage('table.btBankAcc.bankbookNum')" value="$!{btBankAccPage.bankbookNum}">
                        <div class="inlineblock">(#springMessage("table.btBankAcc.bankbookNum.rmk"))</div>
					</td>
				</tr>
				<tr>
    				##计息周期
                    <td class="textRight">#springMessage('table.btBankAcc.interestCycle')</td>
    				<td>
						<input type="radio" name="interestCycle" checked="checked" title="#springMessage('table.btBankAcc.interestCycle.month')" value="1" lay-filter = "interestCycle">
						<input type="radio" name="interestCycle"  title="#springMessage('table.btBankAcc.interestCycle.season')" value="0" lay-filter = "interestCycle"/>
					</td>
    				##计息日
                    <td class="textRight">#springMessage('table.btBankAcc.interestDate')</td>
    				<td>
                        <div class="layui-inline" id="interestDateDiv">
                            <div class="bt-biz-dict" data-type="select" data-group="btBankAcc.interestDate" data-defaultvalue="0" data-name="interestDate" data-biz-name="interestDate"></div>
                        </div>
					</td>
				</tr>
				<tr>
    				##开户日期
                    <td class="textRight">#springMessage('table.btBankAcc.regDate')</td>
            		<td>
    					##<div type="date" field="regDate" defaultVal="$!{btBankAccPage.regDate}"></div>
                        <input type="text" name="regDate" class="layui-input bt-biz-dateType" lay-verify="required" data-today="true" value="$!{btBankAccPage.regDate}" data-min="$!{todate}">
                    </td>
    				##对私编号
					<td class="textRight">#springMessage('table.btBankAcc.privateNo')</td>
            		<td>
    					<input type="text" id="privateNo" name="privateNo"
    						autocomplete="off" class="layui-input inlineblock" placeholder="#springMessage('table.btBankAcc.privateNo')" value="$!{btBankAccPage.privateNo}">
                        <div class="inlineblock">(#springMessage("table.btBankAcc.privateNo.rmk"))</div>
					</td>
				</tr>
				<tr>
    				##是否上线
                    <td class="textRight">#springMessage('table.btBankAcc.isOnline')</td>
    				<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isOnline" data-biz-name="isOnline" data-disabledValue="0,1"></div>
    				</td>
    				##是否查询余额或明细
                    <td class="textRight">#springMessage('table.btBankAcc.scanFlag')</td>
    				<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="scanFlag" data-biz-name="scanFlag"></div>
    				</td>
				</tr>
				<tr>
    				##余额初始日期
                    <td class="textRight">#springMessage('table.btBankAcc.initBalanceDate')</td>
            		<td>
    					##<div type="date" field="initBalanceDate" defaultVal="$!{btBankAccPage.initBalanceDate}"></div>
                        <input type="text" name="initBalanceDate" class="layui-input bt-biz-dateType" data-today="true" value="$!{btBankAccPage.initBalanceDate}" data-min="$!{todate}">
                    </td>
    				##初始余额
                    <td class="textRight">#springMessage('table.btBankAcc.initBalance')</td>
    				<td>
    					<input type="text" data-id="initBalance" name="initBalance"  decimal="2"style="text-align:right"
							autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.btBankAcc.initBalance')" value="$!{btBankAccPage.initBalance}">
    				</td>
				</tr>
				<tr>
    				##是否有效
                    <td class="textRight">#springMessage('table.btBankAcc.validSign')</td>
    				<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="validSign" data-biz-name="validSign"></div>
    				</td>
    				##备注
                    <td class="textRight">#springMessage('table.btBankAcc.rmk')</td>
            		<td>
						<input type="text" id="rmk" name="rmk" value="$!{btBankAccPage.rmk}"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.rmk')">
    				</td>
				</tr>
				<tr>
        			<td align="center" colspan="4">
        				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
        				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        			</td>
        	    </tr>
			</tbody>
		</table>
        <!-- 附件上传 -->
        <input id="attachmentId" name="attachmentId" type="hidden" value="$!{btBankAccPage.attachmentId}">
        <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAcc.edit.js?_btv=${resourceVersion}"></script>
</html>
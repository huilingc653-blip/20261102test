<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" name="poolSign" id="poolSign" value="$!{poolSign}"/>
        <table class="layui-table">
            <tbody>
            #if($!{poolSign} == "1")
            <tr>
                <td class="textRight" width="10%">#springMessage('nis.pool.fcCorpPool.pool')</td>
                <td width="25%">
                    <div class="layui-input-inline">
                        <!-- 控制在线 -->
                        <input type="hidden" name="eqs_isOnline" id="eqs_isOnline" value="1"/>
                        <div class="bt-biz-selectType" data-url="" data-name="netId" data-biz-name="netId" data-callback="netIdCallback"
                             data-valuefield="id" data-textfield="showName" data-search="true" data-defaultValue="$!{btBankAccPage.poolId}"></div>
                    </div>
                </td>
                <td class="textRight" width="10%">#springMessage('table.btBankAccApp.corpId')</td>
                <td width="25%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-url="" data-name="ins_corpId" data-biz-name="ins_corpId"
                             data-valuefield="corpId" data-textfield="showName" data-search="true" data-defaultValue="$!{btBankAccPage.corpId}"></div>
                    </div>
                </td>
                <td class="textRight">#springMessage('table.btBankAcc.bankTypeId')</td>
                <td>
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/listFilter"
                         data-name ="eqs_bankTypeId" data-biz-name ="eqs_bankTypeId"  data-valueField="id" data-textField="typeName" defaultVal="$!{btBankAccPage.bankTypeId}"></div>
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.btBankAcc.accType')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="btBankAcc.accType" data-name="eqs_accType" data-biz-name="eqs_accType"></div>
                </td>
                <td class="textRight">#springMessage('table.btBankAcc.bankAcc')</td>
                <td>
                    <input type="text" id="bankAcc" name="likes_bankAcc"
                           autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.btBankAcc.bankAcc')" value="$!{btBankAccPage.bankAcc}">
                </td>
                <td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
                <td>
                    <input type="text" id="bankName" name="likes_bankName"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.bankName')" value="$!{btBankAccPage.bankName}">
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.btBankAccCur.cur')</td>
                <td>
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name ="eqs_curId" data-biz-name ="eqs_curId"  data-valueField="id" data-textField="curName" defaultVal="$!{btBankAcc.curId}" ></div>
                </td>
                <td class="textRight">#springMessage('table.btBankAcc.isRelation')</td>
                <td colspan="3">
                    <div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-name="eqs_isRelation" data-biz-name="eqs_isRelation"></div>
                </td>
            </tr>
            #else
            	<tr>
               		<td class="textRight">#springMessage('table.btBankAccApp.corpId')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="hidden" id="corpIdHid" value="$!{btBankAccPage.corpId}"/>
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-name="ins_corpId"
                                 data-group="corpGroup"
                                 data-resource="netbank:bankAcc:btBankAccMaintain:query"
                                 data-scope="all"></div>
                        </div>
                    </td>
            		<td class="textRight">#springMessage('table.btBankAcc.bankTypeId')</td>
               		<td>
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/listFilter"
                             data-name ="eqs_bankTypeId" data-biz-name ="eqs_bankTypeId"  data-valueField="id" data-textField="typeName" defaultVal="$!{btBankAccPage.bankTypeId}"></div>
                	</td>
                    <td class="textRight">#springMessage('table.btBankAcc.accType')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="btBankAcc.accType" data-name="eqs_accType" data-biz-name="eqs_accType"></div>
                    </td>
                </tr>
                <tr>
               		 <td class="textRight">#springMessage('table.btBankAcc.bankAcc')</td>
               		 <td>
                		<input type="text" id="bankAcc" name="likes_bankAcc"
        					 autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.btBankAcc.bankAcc')" value="$!{btBankAccPage.bankAcc}">
                	 </td>
            		<td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
               		<td>
                		<input type="text" id="bankName" name="likes_bankName"
        					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisAllocationReq.bankName')" value="$!{btBankAccPage.bankName}">
                	</td>
               		 <td class="textRight">#springMessage('table.btBankAccCur.cur')</td>
                	 <td>
                         <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                              data-name ="eqs_curId" data-biz-name ="eqs_curId"  data-valueField="id" data-textField="curName" defaultVal="$!{btBankAcc.curId}" ></div>
                	</td>
                </tr>
                  <tr>
                    <td class="textRight">#springMessage('table.btBankAcc.isOnlineView')</td>
                    <td>
						<div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-name="eqs_isOnline" data-biz-name="eqs_isOnline"></div>
					</td>
            		<td class="textRight">#springMessage('table.btBankAcc.isRelation')</td>
               		<td colspan="3">
						<div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-name="eqs_isRelation" data-biz-name="eqs_isRelation"></div>
                	</td>
                </tr>
            #end
                <tr>
                	<td align="center" colspan="6">
                        <button class="layui-btn" lay-submit lay-filter="search" id="send">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btBankAcc.bankAcc')</th>
        <th>#springMessage('table.btBankAcc.counterAcc')</th>
        <th>#springMessage('table.btBankAcc.superCounterAcc')</th>
        <th>#springMessage('table.btBankAccCur.cur')</th>
        <th>#springMessage('table.btBankAcc.accName')</th>
        <th>#springMessage('table.btBankAcc.corpId')</th>
        <th>#springMessage('table.btBankAcc.bankName')</th>
        <th>#springMessage('table.btBankAcc.regDate')</th>
        <th>#springMessage('table.btBankAcc.natureId')</th>
        <th>#springMessage('table.btBankAcc.attributeId')</th>
        <th>#springMessage('table.btBankAcc.accType')</th>
        <th>#springMessage('table.btBankAcc.bankCode')</th>
        <th>#springMessage('table.btBankAcc.isOnline')</th>
        <th>#springMessage('table.btBankAcc.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>

</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccMaintain.list.js?_btv=${resourceVersion}"></script>
</html>

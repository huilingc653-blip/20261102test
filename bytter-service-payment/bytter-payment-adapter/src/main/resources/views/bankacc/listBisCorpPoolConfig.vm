<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
        	<tbody>
                <tr>
                    <td class="textRight">#springMessage('table.excRulesManage.ruleName')</td>
                    <td width="40%">
                        <input type="text" name="likes_configName" autocomplete="off" class="layui-input" placeholder="#springMessage('table.excRulesManage.ruleName')">
                    </td>
                    <td class="textRight">#springMessage('common.table.status')</td>
                    <td width="40%">
                        <div class="bt-biz-dict" data-type="select" data-group="valid_sign" data-name="eqs_validSign" data-biz-name="validSign"></div>
                    </td>
                </tr>
                <tr>
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
        	</tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('规则编码')</th>
                <th>#springMessage('类型')</th>
                <th>#springMessage('table.excRulesManage.ruleName')</th>
                <th>#springMessage('common.table.status')</th>
                <th>#springMessage('common.table.thead.operation')</th>
			</tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisCorpPoolConfig.list.js?_btv=${resourceVersion}"></script>
</html>

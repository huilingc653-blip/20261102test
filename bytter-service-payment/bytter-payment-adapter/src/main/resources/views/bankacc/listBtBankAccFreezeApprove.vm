<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" name="eqs_busType" value="$!{type}">
		<table class="layui-table">
			<tbody >
				<tr>
					<td class="textRight">#springMessage('table.freeze.freezeDate')</td>
                    <td>
						<div class="layui-inline">
                            <input type="text" name="ged_freezeDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_createDate" >
                            <span class="date-mid">~</span>
                            <input type="text" name="led_freezeDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_createDate">
                        </div>
                    </td>
                </tr>
				<tr>
                    <td colspan="2" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
            </tbody>
		</table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.Freeze.freezeNo')</th>
                <th>#springMessage('table.nisBillhead.accId')</th>
                <th>#springMessage('table.nisAllocationReq.accName')</th>
                <th>#springMessage('table.btBankAccCur.cur')</th>
                <th>#springMessage('table.accountDTO.bankName')</th>
                <th>#springMessage('table.fcFreeze.freezeMoney')</th>
                <th>#springMessage('table.freeze.freezeDate')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
	#paymentWorkFlowHtml()
    #parse("views/common/footer.vm")
	#paymentWorkFlowScript()
    <script>
        bt.use(['form','datatable','moneyType'], function(){
            bt.dateType.init();
            bt.datatable.init({
                elem: "#appTable",
                colReorder: true,
                checkbox:true,
                order: [1,'desc'],
                searchForm: {
                    formElem: "#searchForm",
                    formFilter: "search"
                },
                ajax: {
                    'url': basePath+"/bankacc/btbankaccfreeze/dataTableApprove"
                },
                buttons: [

                ],
                fixedColumns: {
                    rightColumns:1//代表冻结右边一列
                },
                columns: [
                    {data:"freezeNo",bSortable:true},
                    {data:"bankAcc",bSortable:true},
                    {data:"accName",bSortable:true},
                    {data:"curName",bSortable:true},
                    {data:"bankName",bSortable:true},
                    {data:"freezeMoney",
                        className:'textRight',
                        render: function ( data, type, full, meta ) {
                            return bt.money.format(full.freezeMoney);
                        }
                    },
                    {data:"freezeDate",bSortable:true},
                    {data:null,bSortable:false,className:'center',render: function (data, type, full, meta) {
                        var html='';
                    	if($("#flowStatus").val()=='todo'){
                    		html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
                    	}
                        if($("#flowStatus").val() == 'pass'){
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }else {
                            html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                        }
                    	return html;
                    }}
                ],
                summary: {
                    pageSum: false,
                    allSum: true,
                    selectSum: true,
                    format: {
                        decimal: 2
                    },
                    sumList: [
                        {
                            colNum: '6',
                            dataName: 'freezeMoney'
                        }
                    ]
                }
            });
        })
        bt.use(['form','dateType'], function(){
            $ = bt.jquery;
            bt.dateType.init();

            bt.workFlow.beforeSubmit = function(submitData){
                var data = bt.datatable.getSelectData("#appTable");
                if(data.length < 1){
                    layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 2});
                    return;
                }
                var ids = [];
                var taskIds = [];
                // 遍历行数据
                $.each(data,function(i, tr) {
                    taskIds.push(tr.taskId);
                });
                bt.workFlow.taskList = taskIds;
                return true;
            }

        });

        /*审核*/
        function approve(el){
            var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
            if(bt.navtab){
                bt.navtab.addNavtab(bt.lang('common.button.approve'), basePath + "/bankacc/btbankaccfreeze/approve?id=" + data.id + "&taskId=" + data.taskId);
                return;
            }
            parent.layer.open({
                type: 2,
                area: ['850px', '530px'],
                maxmin: true,
                content: basePath + "/bankacc/btbankaccfreeze/approve?id=" + data.id + "&taskId=" + data.taskId
            });
        }
    </script>
</body>
</html>

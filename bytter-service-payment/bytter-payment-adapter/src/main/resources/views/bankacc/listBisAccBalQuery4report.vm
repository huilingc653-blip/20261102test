<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="nei_status" name="nei_satus" value="-2">
    <input type="hidden" id="corpId" value="$!{corpId}">
    <input id="loginName" name="loginName" type="hidden" value="$shiro.getPrincipal().loginName">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="10%">#springMessage('table.bisAccBal.corp')</td>
            <td width="20%">
                $!{corpName}
                <input type="hidden" name="accGroup" value="$!{accGroup}"/>
                <div class="layui-input-inline" style="display: none">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="ins_corpId"
                         data-scope="all" data-resource="netbank:bankAcc:bisAccBal:query"
                         data-defaultvalue="$!{corpId}"
                         data-callback="corpCallback"></div>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.bisAccBal.bankAcc')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" id="likes_bankAcc" name="likes_bankAcc" data-name="likes_bankAcc"
                           data-biz-name="likes_bankAcc" accountType="2,3" containDelBankAcc="true"
                           data-resource="netbank:bankAcc:bisAccBal:query" class="layui-input bt-biz-accountTable"
                           data-callback="accountCallBack" permission="B"/>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.bisAccBal.balDate')</td>
            <td width="30%">
                <div class="layui-inline">
                    <input type="text" name="ged_balDate" class="layui-input bt-input-inline bt-biz-dateType"
                           data-endid="led_balDate"  #if($!{queryDate}) value="$!{queryDate}" #else data-today="true" #end >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_balDate" class="layui-input bt-input-inline bt-biz-dateType"
                           id="led_balDate" #if($!{queryDate}) value="$!{queryDate}" #else data-today="true" #end >
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.bisAccBal.bifCode')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/listFilter"
                         data-method="get"
                         data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
        ##币别ID
            <td class="textRight">#springMessage('table.bisAccBal.curId')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name="eqs_curId" data-biz-name="eqs_curId" data-valueField="id"
                     data-textField="curName"></div>
            </td>
            <td class="textRight">#springMessage('table.bisAccBal.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="netbank.statusAll" data-name="eqi_status"
                     data-filterData="96,97,98,100,-2"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAccApp.attributeId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/bankacc/bisaccattribute/json" data-method="get"
                         data-valuefield="id" data-textfield="attributeName" data-name="ins_attributeId"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.btBankAcc.natureId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/bankacc/btaccnature/json" data-method="get"
                         data-valuefield="id" data-textfield="natureName" data-name="ins_natureId"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.btBankAccApp.accType')</td>
            <td>
                <div class="bt-biz-dict" data-type="mulselect" data-group="btBankAcc.accType" data-name="ins_accType"
                     data-biz-name="accType"></div>
            </td>
        </tr>
        <tr>
            ##账户状态
            <td class="textRight">
                #springMessage('table.fcAcc.accState')
            </td>
            <td >
                <div class="bt-biz-dict" data-type="select"
                     data-group="btBankAcc.accStatus" data-name="accStatus"></div>
            </td>
            ##银行返回信息
            <td class="textRight">#springMessage('table.abAccrecords.returnMsg')</td>
            <td>
                <input type="text" name="likes_returnMsg"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.abAccrecords.returnMsg')">
            </td>
            ##银行返回状态
            <td class="textRight">
                #springMessage('table.fcAcc.returnCode')
            </td>
            <td >
                <div class="bt-biz-dict" data-type="select"
                     data-group="btBankAcc.returnCode" data-name="returnCode"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">
                #springMessage('是否直联')
            </td>
            <td colspan="5">
                <div class="bt-biz-dict" data-type="select"
                     data-group="sf_yn" data-name="eqs_isOnline" ></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.bisAccBal.balDate')</th>
        <th>#springMessage('table.bisAccBal.corp')</th>
        <th>#springMessage('table.bisAccBal.bankAcc')</th>
        <th>#springMessage('table.bisAccBal.accName')</th>
        <th>#springMessage('table.bisAccBal.bankName')</th>
        <th>#springMessage('是否直联')</th>
        <th>#springMessage('table.btBankAccApp.attributeId')</th>
        <th>#springMessage('table.btBankAcc.natureId')</th>
        <th>#springMessage('table.btBankAccApp.accType')</th>
        <th>#springMessage('table.bisAccBal.curId')</th>
        <th>#springMessage('table.accountSummary.beginning_balance')</th>
        <th>当前余额</th>
        <th>#springMessage('table.bisAccBal.availBal')</th>
        <th>#springMessage('table.bisAccBal.frzBal')</th>
        <th>#springMessage('table.bisAccBal.status')</th>
        <th>#springMessage('table.bisAccBal.getDate')</th>
        <th>#springMessage('table.abAccrecords.returnMsg')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisAccBalQuery.list.js?_btv=${resourceVersion}"></script>
</html>

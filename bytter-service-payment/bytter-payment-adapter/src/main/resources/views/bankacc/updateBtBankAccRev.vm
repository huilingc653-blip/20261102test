<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .cks {
            max-height: 60px;
            overflow-y: auto;
            transition: max-height 0.3s ease;
        }
        .cks.expanded {
            max-height: 500px;
        }
        .currency-expand-btn {
            text-align: left;
        }
        .currency-expand-btn a {
            color: #1E9FFF;
            font-size: 12px;
            cursor: pointer;
            user-select: none;
        }
        .currency-expand-btn a:hover {
            color: #007DDB;
        }
        .currency-expand-btn .layui-icon {
            font-size: 12px;
            margin-right: 3px;
            transition: transform 0.3s ease;
        }
        .currency-expand-btn.expanded .layui-icon {
            transform: rotate(180deg);
        }
        .cks .layui-form-checkbox {
            width: 15%!important;
            text-align: left!important;
        }
        .cks .layui-form-checkbox span{
            position: absolute;
            left: 16px;
        }
    </style>
</head>
<body>
	<form class="layui-form" method="post">
    	<input id="id" name="id" type="hidden" value="$!{btBankAccAppPage.id}">
    	<input id="accNo" name="accNo" type="hidden" value="$!{btBankAccAppPage.accNo}">
    	<input id="busType" name="busType" type="hidden" value="$!{btBankAccAppPage.busType}">

    	<input id="regularsTemp" name="regularsTemp" type="hidden" value="$!{btBankAccAppPage.regulars}">
    	<input id="regularDateTemp" name="regularDateTemp" type="hidden" value="$!{btBankAccAppPage.regularDate}">
    	<input id="noticeTypeTemp" name="noticeTypeTemp" type="hidden" value="$!{btBankAccAppPage.noticeType}">
    	<input id="agrMoneyTemp" name="agrMoneyTemp" type="hidden" value="$!{btBankAccAppPage.agrMoney}">
    	<input id="agrInterestTemp" name="agrInterestTemp" type="hidden" value="$!{btBankAccAppPage.agrInterest}">
    	<input id="agrContractTemp" name="agrContractTemp" type="hidden" value="$!{btBankAccAppPage.agrContract}">
    	<input id="agrBeginDateTemp" name="agrBeginDateTemp" type="hidden" value="$!{btBankAccAppPage.agrBeginDate}">
    	<input id="agrEndDateTemp" name="agrEndDateTemp" type="hidden" value="$!{btBankAccAppPage.agrEndDate}">
        <input id="circulationModeTemp"  type="hidden" value="$!{btBankAccAppPage.circulationMode}">

    	<input id="status" name="status" type="hidden" value="$!{btBankAccAppPage.status}">
    	<input id="createBy" name="createBy" type="hidden" value="$!{btBankAccAppPage.createBy}">
    	<input id="updateBy" name="updateBy" type="hidden" value="$!{btBankAccAppPage.updateBy}">
        <input id="electricBill" name="electricBill" type="hidden" value="$!{btBankAccAppPage.electricBill}">
        <input id="entityAccId"  type="hidden" value="$!{btBankAccAppPage.entityAccId}">
        <input id="prov" name="prov" type="hidden" value="$!{btBankAccAppPage.prov}">
        <input id="city" name="city" type="hidden" value="$!{btBankAccAppPage.city}">
        <input id="corpId" type="hidden" name="corpId" value="$!{btBankAccAppPage.corpId}">
        <input id="bankOrgCode" type="hidden" name="bankOrgCode" value="$!{btBankAccAppPage.bankOrgCode}">
        <input id="isFrom" type="hidden" name="isFrom" value="$!{isFrom}">

        <table class="layui-table breakRow">
			<tbody>
				<tr>
					##银行账号
					<td class="textRight">#springMessage('table.btBankAccApp.bankAcc')</td>
					<td widht="40%">
						<input type="text" id="bankAcc" name="bankAcc" value="$!{btBankAccAppPage.bankAcc}"
							   lay-verify="required" class="layui-input" readonly="readonly"/>
					</td>
					##账户名称
					<td class="textRight">#springMessage('table.btBankAccApp.accName')</td>
					<td widht="40%">
    					<input type="text" id="accName" name="accName" lay-verify="required"
    						autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccApp.accName')" value="$!{btBankAccAppPage.accName}">
					 </td>
				</tr>
                <tr>
					##币别
                    <td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAccApp.curId')</td>
                    <td colspan="3">
                        <input type="hidden" value="$!{curId}" name="curId" id="curId"/>
                        <div class="cks" data-biz-name="cur"></div>
                        <div class="currency-expand-btn" style="margin-top: 5px;">
                            <a href="javascript:void(0);" id="toggleCurrencyBtn" onclick="toggleCurrencyList()">
                                <i class="layui-icon layui-icon-down"></i>
                                <span id="toggleCurrencyText">查看更多</span>
                            </a>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##境内/境外账号
                    <td class="textRight">#springMessage('table.btBankAccApp.isDomesticBank')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="btBankAcc.isDomesticBank" data-required="true"
                             data-defaultvalue="$!{btBankAccAppPage.isDomesticBank}" data-name="isDomesticBank" data-biz-name="isDomesticBank"></div>
                    </td>
                    ##是否离岸账号
                    <td class="textRight">#springMessage('table.btBankAccApp.isOffshoreAccount')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                             data-defaultvalue="$!{btBankAccAppPage.isOffshoreAccount}" data-name="isOffshoreAccount" data-biz-name="isOffshoreAccount"></div>
                    </td>
                </tr>
				<tr>
					##单位
                    <td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAccApp.corpId')</td>
                    <td>
						$!{btBankAccAppPage.corpName}
                    </td>
                    ##银行类别
                    <td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
                    <td>
                        <div data-name="bankTypeId" class="bt-biz-selectType"
                             data-url="${basePath}/basic/business/btbanktype/json"
                             data-valueField="id"
                             data-biz-name="bankTypeId"
                             data-textField="typeName"
                             data-required="true"
                             data-search="true"
                             data-extraData="false"
                             data-defaultvalue="$!{btBankAccAppPage.bankTypeId}"
                             data-callback="bt.bankTypeCallback"></div>
                    </td>
                </tr>
                    ##开户行行号
                    <td class="textRight">#springMessage('table.btBankAcc.bankCode')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" id="bankCode" name="bankCode" lay-verify="required"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankCode')" value="$!{btBankAccAppPage.bankCode}" readonly="readonly">
                                #if($!{isDomesticBankType} == "1")
                                    ##境外
                                    <div class="bt-div-search isSwiftY" style="display:none">
                                        <button class="bt-biz-swiftInfo" id="selPayeeBankBut" type="button"  data-callback="bt.swiftInfoCallback" data-beforeClick="bt.bankInfoBeforeClick" title="#springMessage('common.button.select')">
                                            <i class="layui-icon">&#xe615;</i>
                                        </button>
                                    </div>
                                    ##境内
                                    <div class="bt-div-search isSwiftN">
                                        <button class="bt-biz-bankInfo" type="button"  data-callback="bt.bankinfoCallback" data-beforeClick="bt.bankInfoBeforeClick" title="#springMessage('common.button.bank')">
                                            <i class="layui-icon">&#xe615;</i>
                                        </button>
                                    </div>
                                #else
                                    ##境外
                                    <div class="bt-div-search isSwiftY">
                                        <button class="bt-biz-swiftInfo" id="selPayeeBankBut" type="button"  data-callback="bt.swiftInfoCallback" title="#springMessage('common.button.select')">
                                            <i class="layui-icon">&#xe615;</i>
                                        </button>
                                    </div>
                                    ##境内
                                    <div class="bt-div-search isSwiftN" style="display:none">
                                        <button class="bt-biz-bankInfo" type="button"  data-callback="bt.bankinfoCallback" data-beforeClick="bt.bankInfoBeforeClick" title="#springMessage('common.button.bank')">
                                            <i class="layui-icon">&#xe615;</i>
                                        </button>
                                    </div>
                                #end
                        </div>
                    </td>
                ##开户行名称
                    <td class="textRight">#springMessage('table.btBankAccApp.bankName')</td>
                    <td>
                        <input type="text" id="bankName" name="bankName" lay-verify="required" readonly="readonly"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccApp.bankName')" value="$!{btBankAccAppPage.bankName}">
                    </td>
                </tr>
                <tr>
				##账户性质
                    <td class="textRight">#springMessage('table.btBankAccApp.natureId')</td>
                    <td>
                        <div type="list" field="natureId" fieldHref="${basePath}/bankacc/btaccnature/json" dictField="id" dictText="natureName" data-required="true" defaultVal="$!{btBankAccAppPage.natureId}"></div>
                    </td>
				##账户属性
                    <td class="textRight">#springMessage('table.btBankAccApp.attributeId')</td>
                    <td>
                        <div type="list" field="attributeId" fieldHref="${basePath}/bankacc/bisaccattribute/json" dictField="id" dictText="attributeName" data-required="true" defaultVal="$!{btBankAccAppPage.attributeId}"></div>
                    </td>
                </tr>
			   <tr class="tp">
			       ##账户类别
                   <td class="textRight">#springMessage('table.btBankAccApp.accType')</td>
                   <td>
                       <div class="bt-biz-dict" data-type="select" data-group="btBankAcc.accType" data-required="true"
                            data-defaultvalue="$!{btBankAccAppPage.accType}" data-name="accType" data-biz-name="accType" data-callback="bt.chang"></div>
    			   </td>
				   ##增加列
                       <td align="right" class="type"></td>
                       <td class="typeText"></td>
			   </tr>
				<tr>
    				<td class="textRight">#springMessage('table.btBankAccApp.opRession.forRev')</td>
    				<td colspan="3">
            			<textarea rows="5" cols="80" id="opRession" name="opRession" lay-verify="required|strlength" data-maxlength="200" class="layui-textarea">$!{btBankAccAppPage.opRession}</textarea>
                    </td>
				</tr>
				<tr>
    			<td align="center" colspan="4">
               		<input type="hidden" id="flag" name="flag"/>
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
                    <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallback">#springMessage('common.button.reset')</button>
                </td>
				</tr>
        	</tbody>
        </table>
        <!-- 附件上传 -->
        <input id="attachmentId" name="attachmentId" type="hidden" value="$!{btBankAccAppPage.attachmentId}">
        <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/bankacc/btBankAccRev.edit.js?_btv=${resourceVersion}"></script>
#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<input type="hidden" id="id" name="id" value="$!{btBankAccDtlPage.id}">
<input type="hidden" id="accNo" name="accNo" value="$!{btBankAccDtlPage.accNo}">
<input type="hidden" id="corpId" name="corpId" value="$!{btBankAccDtlPage.corpId}">
<input type="hidden" id="curId" name="curId" value="$!{btBankAccDtlPage.curId}">
<input type="hidden" id="createBy" name="createBy" value="$!{bisAccBalPage.createBy}">
<input type="hidden" id="createDate" name="createDate" value="$!{bisAccBalPage.createDate}">
<input type="hidden" id="updateBy" name="updateBy" value="$!{bisAccBalPage.updateBy}">
<input type="hidden" id="updateDate" name="updateDate" value="$!{bisAccBalPage.updateDate}">
<input type="hidden" id="status" name="status" value="$!{bisAccBalPage.status}">

<ul class="mui-table-view">
    <li class="mui-table-view-cell  mui-collapse keep-unfold">
        <a class="mui-navigate-right" href="#">
            #springMessage('table.btBankAccDtl.bankAcc')
            <span class="mui-badge mui-badge-inverted">
                $!{btBankAccDtlPage.bankAcc}
            </span>
        </a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('table.btBankAccDtl.bankName')
                <span class="mui-badge mui-badge-inverted">
                    $!{btBankAccDtlPage.bankName}
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.btBankAccDtl.accName')
                <span class="mui-badge mui-badge-inverted">
                    $!{btBankAccDtlPage.accName}
                </span>
            </li>
        </ul>
    </li>
    <li class="mui-table-view-cell  mui-collapse keep-unfold">
        <a class="mui-navigate-right" href="#">
            #springMessage('table.btBankAccDtl.oppAccNo')
            <span class="mui-badge mui-badge-inverted">
                $!{btBankAccDtlPage.oppAccNo}
            </span>
        </a>
        <ul class="mui-table-view H-theme-background-color-white">
            <li class="mui-table-view-cell">
                #springMessage('table.btBankAccDtl.oppAccName')
                <span class="mui-badge mui-badge-inverted">
                    $!{btBankAccDtlPage.oppAccName}
            </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.btBankAccDtl.oppAccBank')
                <span class="mui-badge mui-badge-inverted">
                    $!{btBankAccDtlPage.oppAccBank}
            </span>
            </li>
        </ul>
    </li>

    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccDtl.cdSign')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("btBankAccDtl.cdSign", $!{btBankAccDtlPage.cdSign})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccDtl.rbSign')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("btBankAccDtl.rbSign", $!{btBankAccDtlPage.rbSign})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccDtl.curName')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAccDtlPage.curName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccDtl.amt')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{btBankAccDtlPage.amt})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccDtl.bal')
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{btBankAccDtlPage.bal})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccDtl.transTime')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{btBankAccDtlPage.transTime})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccDtl.months')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAccDtlPage.months}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccDtl.bifCode')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAccDtlPage.bifName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccDtl.uses')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAccDtlPage.uses}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccDtl.remark')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAccDtlPage.remark}
        </span>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>

</html>

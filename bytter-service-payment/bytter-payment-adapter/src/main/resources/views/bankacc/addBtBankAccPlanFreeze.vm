<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<table class="layui-table">
    <tbody>
        ##账户冻结申请
    <tr>
        <td colspan="4" style="text-align: center;font-weight: 700">#springMessage('table.fcFreeze.apply')</td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.nisBillhead.accId')</td>
        <td>$!{accVO.bankAcc}</td>
        <td class="textRight">#springMessage('table.nisAllocationReq.accName')</td>
        <td>$!{accVO.accName}</td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
        <td>$!{accVO.bankName}</td>
        <td class="textRight">#springMessage('btBankType.typeName')</td>
        <td>$!{accVO.bankTypeName}</td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.btBankAccApp.attributeId')</td>
        <td>$!{accVO.attributeName}</td>
        <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
        <td>$!{accVO.corpName}</td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.btBankAccApp.accType')</td>
        <td>$!{accVO.accTypeName}</td>
        <td></td>
        <td></td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.btBankAccCur.cur')</td>
        <td>$!{accVO.curName}</td>
        <td class="textRight">#springMessage('table.fcAcc.interestRate')</td>
        <td>$!rateTag.show($!{accVO.rates})</td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.btInnerAccApp.innerDate')</td>
        <td>$!date.format('yyyy-MM-dd',$!{accVO.regDate})</td>
        <td class="textRight">#springMessage('table.btBankAccApp.natureId')</td>
        <td>$!{accVO.natureName}</td>
    </tr>
        ##冻结信息
    <tr>
        <td colspan="4" style="text-align: center;font-weight: 700">#springMessage('table.btBankAccFreeze.info')</td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.nisAllocationReq.accBalance')</td>
        <td>
            <div name="money">$!{freezeVO.bal}</div>
        </td>
        <td class="textRight">#springMessage('table.bisAccBal.availBal')</td>
        <td>
            <div name="money">$!{freezeVO.availBal}</div>
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.btBankAccFreeze.freezeNum')</td>
        <td>$!{freezeVO.freezeCount}</td>
        <td class="textRight">#springMessage('table.btBankAccFreeze.sumFreezeAtm')</td>
        <td>
            <div name="money">$!{freezeVO.freezeMoneySum}</div>
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.btBankAccFreeze.unfreezeNum')</td>
        <td>$!{freezeVO.unfreezeCount}</td>
        <td class="textRight">#springMessage('table.btBankAccFreeze.sumUnfreezeAtm')</td>
        <td>
            <div name="money">$!{freezeVO.unFreezeMoneySum}</div>
        </td>
    </tr>
    </tbody>
</table>
<form class="layui-form" method="post">
    <input type="hidden" name="bal" id="bal" value="$!{freezeVO.bal}"/>
    <input type="hidden" name="availBal" id="availBal" value="$!{freezeVO.availBal}"/>
    <input type="hidden" name="bankAccId" id="bankAccId" value="$!{accVO.id}"/>
    <input type="hidden" name="bankAcc" id="bankAcc" value="$!{accVO.bankAcc}"/>
    <input type="hidden" name="corpId" id="corpId" value="$!{accVO.corpId}"/>
    <input type="hidden" name="curId" id="curId" value="$!{accVO.curId}"/>

    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.fcAccBalance.freezeMoney')</td>
            <td colspan="3">
                <input type="text" class="layui-input bt-biz-moneyType" data-name="applyFreezeMoney" data-biz-name="applyFreezeMoney" lay-verify="required">
            </td>
        </tr>
        <tr>
            <td class="textRight">冻结开始时间</td>
            <td colspan="3">
                <div class="layui-input-inline">
                    <input type="text" class="layui-input bt-biz-dateType" id="freezeStartDate" name="freezeStartDate" data-biz-name="freezeStartDate" data-endid="freezeEndDate"
                           lay-verify="required" data-type="datetime">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">冻结结束时间</td>
            <td colspan="3">
                <div class="layui-input-inline">
                    <input type="text" class="layui-input bt-biz-dateType" id="freezeEndDate" name="freezeEndDate" data-biz-name="freezeEndDate"
                           lay-verify="required" data-type="datetime">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcFreeze.freezeReason')</td>
            <td colspan="3">
                <textarea rows="5" cols="50" id="freezeRession" name="freezeRession" lay-verify="required|strlength"
                          data-maxlength="200"></textarea>
            </td>
        </tr>
        <tr>
            <td colspan="4" align="center">
                <button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
                <button type="button" class="layui-btn layui-btn-primary" onclick="planFreezeReset()">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<form class="layui-form" method="post">
    <table class="layui-table" id="freezeTemp">
        <thead>
        <tr align="center">
            <th>计划冻结单号</th>
            <th>冻结账号</th>
            <th>冻结开始时间</th>
            <th>冻结结束时间</th>
            <th>申请冻结金额</th>
            <th>实际已冻结金额</th>
            <th>冻结原因</th>
            <th>单据状态</th>
            <th>冻结状态</th>
            <th>是否冻结完成提醒</th>
            <th>是否解冻</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
        <tfoot style="text-align: center;background-color:#ddd">
        <tr id="sum">
            <td>&nbsp;</td>
            <td>#springMessage('table.datatable.total')</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td name="money" class="textRight">0.00</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
        </tr>
        </tfoot>
    </table>
    <table class="layui-table">
        <tr>
            <td align="center">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccPlanFreeze.add.js?_btv=${resourceVersion}"></script>
</html>

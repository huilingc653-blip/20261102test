<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<table class="layui-table">
			<tbody>
			<tr>
				<td class="textRight" width="40%">#springMessage('table.nisBillhead.corpId')</td>
				<td width="60%">
					<div class="layui-inline">
						<div class="bt-biz-corp"
							 data-biz-type="corp"
							 data-type="selectTree"
							 data-tree-type="check"
							 data-name="corpId"
							 data-required="true"
							 data-resource="bankacc:biscorppooldtl:apply"
							 data-scope="all"></div>
					</div>
				</td>
			</tr>
			<tr>
				<td class="textRight" width="45%">#springMessage('table.bisAccBal.balDate')</td>
				<td width="55%">
					<div class="layui-inline">
						<input type="text" name="balDateBegin" data-name="balDateBegin" data-biz-name="balDateBegin" class="layui-input bt-input-inline bt-biz-dateType"
							   lay-verify="required" data-endid="balDateEnd">
					</div>
					<span class="date-mid">~</span>
					<div class="layui-inline">
						<input type="text" name="balDateEnd" data-name="balDateEnd" data-biz-name="balDateEnd" class="layui-input bt-input-inline bt-biz-dateType"
							   lay-verify="required" data-today="true" data-max="$!{curDate}" id="balDateEnd">
					</div>
				</td>
			</tr>
			<tr>
				##币别
				<td class="textRight">#springMessage('table.fcAcc.curId')</td>
				<td>
					<div class="layui-input-inline">
						<div class="bt-biz-mulselectType" data-name="curId" data-url="${basePath}/basic/business/btcurrency/json" data-method="get"
							 data-valuefield="id" data-textfield="curName" data-biz-name="curId" data-required="true"
							 data-value="$!{natualCur.id}">
						</div>
					</div>
				</td>
			</tr>
			<tr>
				<td colspan="2" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.confirm')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/bankacc/bisCorpPoolDtl.genBal.js?_btv=${resourceVersion}"></script>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{btBankAccAppPage.id}">
		<input id="accNo" name="accNo" type="hidden" value="$!{btBankAccAppPage.accNo}">
		<input id="bankAcc" name="bankAcc" type="hidden" value="$!{btBankAccAppPage.bankAcc}">
		<input id="busType" name="busType" type="hidden" value="$!{btBankAccAppPage.busType}">
		<input id="bankCode" name="bankCode" type="hidden" value="$!{btBankAccAppPage.bankCode}">
		<input id="regulars" name="regulars" type="hidden" value="$!{btBankAccAppPage.regulars}">
		<input id="regularDate" name="regularDate" type="hidden" value="$!{btBankAccAppPage.regularDate}">
		<input id="noticeType" name="noticeType" type="hidden" value="$!{btBankAccAppPage.noticeType}">
		<input id="agrMoney" name="agrMoney" type="hidden" value="$!{btBankAccAppPage.agrMoney}">
		<input id="agrInterest" name="agrInterest" type="hidden" value="$!{btBankAccAppPage.agrInterest}">
		<input id="agrContract" name="agrContract" type="hidden" value="$!{btBankAccAppPage.agrContract}">
		<input id="agrBeginDate" name="agrBeginDate" type="hidden" value="$!date.format("yyyy-MM-dd HH:mm:ss",$!{btBankAccAppPage.agrBeginDate})">
		<input id="agrEndDate" name="agrEndDate" type="hidden" value="$!date.format("yyyy-MM-dd HH:mm:ss",$!{btBankAccAppPage.agrEndDate})">
		<input id="opRession" name="opRession" type="hidden" value="$!{btBankAccAppPage.opRession}">
		<input id="status" name="status" type="hidden" value="$!{btBankAccAppPage.status}">
		<input id="createBy" name="createBy" type="hidden" value="$!{btBankAccAppPage.createBy}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{btBankAccAppPage.updateBy}">
		<input id="accName" name="accName" type="hidden" value="$!{btBankAccAppPage.accName}">
		<input id="corpId" name="corpId" type="hidden" value="$!{btBankAccAppPage.corpId}">
		<input id="accType" name="accType" type="hidden" value="$!{btBankAccAppPage.accType}">
		<input id="attributeId" name="attributeId" type="hidden" value="$!{btBankAccAppPage.attributeId}">
		<input id="natureId" name="natureId" type="hidden" value="$!{btBankAccAppPage.natureId}">
		<input id="bankTypeId" name="bankTypeId" type="hidden" value="$!{btBankAccAppPage.bankTypeId}">
		<input id="bankName" name="bankName" type="hidden" value="$!{btBankAccAppPage.bankName}">
		<input id="prov" name="prov" type="hidden" value="$!{btBankAccAppPage.prov}">
		<input id="city" name="city" type="hidden" value="$!{btBankAccAppPage.city}">
		<input id="electricBill" name="electricBill" type="hidden" value="$!{btBankAccAppPage.electricBill}">
		<input id="isDomesticBank" name="isDomesticBank" type="hidden" value="$!{btBankAccAppPage.isDomesticBank}">
		<input id="isOffshoreAccount" name="isOffshoreAccount" type="hidden" value="$!{btBankAccAppPage.isOffshoreAccount}">
		<input id="curId" name="curId" type="hidden" value="$!{curId}">
        <table class="layui-table">
        <tbody>	
        	<tr>			
                <td class="textRight">#springMessage('table.btBankAccApp.bankAcc')</td>
        		<td width="35%">
					$!{btBankAccAppPage.bankAcc}
				</td>
                <td class="textRight">#springMessage('table.btBankAccApp.corpId')</td>
        		<td width="35%">
					$!{btBankAccAppPage.corpName}
                </td>
			</tr>
			<tr>
                <td class="textRight">#springMessage('table.btBankAccApp.curId')</td>
        		<td>
					$!{btBankAccAppPage.curName}
                </td>
                <td class="textRight">#springMessage('table.btBankAccApp.accType')</td>
                <td>$dictTag.get("btBankAcc.accType",$!{btBankAccAppPage.accType})</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.btBankAccApp.isDomesticBank')</td>
				<td>
					$dictTag.get("btBankAcc.isDomesticBank",$!{btBankAccAppPage.isDomesticBank})
				</td>
				##是否离岸账号
				<td class="textRight">#springMessage('table.btBankAccApp.isOffshoreAccount')</td>
				<td>$dictTag.get("sf_yn",${btBankAccAppPage.isOffshoreAccount})</td>
			</tr>
			<tr>
                <td class="textRight">#springMessage('table.btBankAccApp.attributeId')</td>
                <td>
					$!{btBankAccAppPage.attributeName}
                </td>
                <td class="textRight">#springMessage('table.btBankAccApp.natureId')</td>
        		<td>
					$!{btBankAccAppPage.natureName}
                </td>
			</tr>
			<tr>
                <td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
        		<td>
					$!{btBankAccAppPage.bankTypeName}
                </td>
                <td class="textRight">#springMessage('table.btBankAccApp.bankName')</td>
        		<td>
					$!{btBankAccAppPage.bankName}
                </td>
			</tr>
			#if($!{isDomesticBankType} == "1")
				<tr>
					<td class="textRight">#springMessage('table.btBankAccApp.prov')</td>
					<td>
						$!{btBankAccAppPage.provName}
					</td>
					<td class="textRight">#springMessage('table.btBankAccApp.city')</td>
					<td>
						$!{btBankAccAppPage.cityName}
					</td>
				</tr>
			#end
			<tr>
                <td class="textRight">#springMessage('table.btBankAccApp.electricBill')</td>
        		<td colspan="3">
					$!{btBankAccAppPage.electricBillName}
                </td>
			</tr>    
			<tr>
				<td class="textRight">#springMessage('table.btBankAccApp.opRession.forDel')</td>
				<td colspan="3">
					<textarea rows="5" cols="80" id="opRession" name="opRession" lay-verify="required|strlength" data-maxlength="200" class="layui-textarea">$!{btBankAccAppPage.opRession}</textarea>
				</td>
			</tr>     
			<tr>
               <td colspan="4" align="center">
               		<input type="hidden" id="flag" name="flag"/>
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
               </td>
			</tr>
		</tbody>
      </table>
        <!-- 附件上传 -->
        <input id="attachmentId" name="attachmentId" type="hidden" value="$!{btBankAccAppPage.attachmentId}">
        <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/bankacc/btBankAccDel.edit.js?_btv=${resourceVersion}"></script>
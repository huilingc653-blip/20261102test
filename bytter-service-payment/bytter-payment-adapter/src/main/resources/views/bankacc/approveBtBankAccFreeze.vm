<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<input type="hidden" id="taskId" name= "taskId" value="$!{taskId}">
	</form>
    <table class="layui-table">
        <tbody>
        <tr>
            <td colspan="4" style="text-align: center;font-weight: 700">#springMessage('table.fcFreeze.apply')</td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisBillhead.accId')</td>
            <td>$!{accVO.bankAcc}</td>
            <td class="textRight">#springMessage('table.nisAllocationReq.accName')</td>
            <td>$!{accVO.accName}</td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.bankName')</td>
            <td>$!{accVO.bankName}</td>
            <td class="textRight">#springMessage('btBankType.typeName')</td>
            <td>$!{accVO.bankTypeName}</td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAccApp.attributeId')</td>
            <td>$!{accVO.attributeName}</td>
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            <td>$!{accVO.corpName}</td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAccApp.accType')</td>
            <td>$!{accVO.accTypeName}</td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAccCur.cur')</td>
            <td>$!{accVO.curName}</td>
            <td class="textRight">#springMessage('table.fcAcc.interestRate')</td>
            <td>$!rateTag.show($!{accVO.rates})</td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btInnerAccApp.innerDate')</td>
            <td>$!date.format('yyyy-MM-dd',$!{accVO.regDate})</td>
            <td class="textRight">#springMessage('table.btBankAccApp.natureId')</td>
            <td>$!{accVO.natureName}</td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;font-weight: 700">#springMessage('table.btBankAccFreeze.info')</td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.nisAllocationReq.accBalance')</td>
            <td>
                <div name="money">
					$!{btBankAccFreezeVO.bal}
                </div>
            </td>
            <td class="textRight">#springMessage('table.bisAccBal.availBal')</td>
            <td>
                <div name="money">$!{btBankAccFreezeVO.avalBal}</div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAccFreeze.freezeNum')</td>
            <td>$!{btBankAccFreezeVO.freezeCount}</td>
            <td class="textRight">#springMessage('table.btBankAccFreeze.sumFreezeAtm')</td>
            <td>
                <div name="money">$!{btBankAccFreezeVO.freezeMoneySum}</div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAccFreeze.unfreezeNum')</td>
            <td>$!{btBankAccFreezeVO.unfreezeCount}</td>
            <td class="textRight">#springMessage('table.btBankAccFreeze.sumUnfreezeAtm')</td>
            <td>
                <div name="money">$!{btBankAccFreezeVO.unFreezeMoneySum}</div>
            </td>
        </tr>
        </tbody>
    </table>
        <input type="hidden" name="bal" id="bal" value="$!{btBankAccFreezeVO.bal}" />
        <input type="hidden" name="availBal" id="availBal" value="$!{btBankAccFreezeVO.avalBal}" />
        <input type="hidden" name="bankAccId" id="bankAccId" value="$!{accVO.id}" />
        <input type="hidden" name="bankAcc" id="bankAcc" value="$!{accVO.bankAcc}" />
        <input type="hidden" name="corpId" id="corpId" value="$!{accVO.corpId}" />
        <input type="hidden" name="curId" id="curId" value="$!{accVO.curId}" />
        <table class="layui-table" id="freeze">
            <thead>
            <tr align="center">
                <th>#springMessage('table.Freeze.freezeNo')</th>
                <th>#springMessage('table.fcFreeze.freezeMoney')</th>
                <th>#springMessage('table.freeze.freezeDate')</th>
                <th>#springMessage('table.freeze.ufFreezeMoney')</th>
                <th>#springMessage('table.freeze.ufavalBal')</th>
                <th width="600">#springMessage('table.fcFreeze.freezeReason')</th>
                <th>#springMessage('table.btBankAcc.status')</th>
            </tr>
            </thead>
        </table>

        <table class="layui-table">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('table.fcAccBalance.freezeMoney')</td>
                <td colspan="3">
                   	<div name="money">
						$!{freezeMoney}
					</div>
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.fcFreeze.freezeReason')</td>
                <td colspan="3">
                    <textarea readonly style="width: 90%; min-height: 80px; border: 1px solid #e6e6e6; padding: 8px; resize: vertical;">$!{freezeRession}</textarea>
                </td>
            </tr>
            </tbody>
        </table>
		#parse("views/common/footer.vm")
	#paymentWorkFlowHtml()
	#paymentWorkFlowScript()
	<script>
		bt.use(['form','jquery'], function(){
			var $ = bt.jquery,form = bt.form();
			bt.workFlow.beforeSubmit = function(submitData){
				var taskIds = [];
				taskIds.push($("#taskId").val());
				bt.workFlow.taskList = taskIds;
				return true;
			}
			bt.workFlow.afterSubmit = function(){
				parent.layer?parent.layer.closeAll():layer.closeAll();
			}

		});
	</script>
	<script>
        bt.use(['form','layedit','moneyType','bttable','money'], function(){
            var $ = bt.jquery,form = bt.form();
            var moneyType = bt.moneyType.init();
            var moneyFun = bt.moneyType.getFun();
            //格式化金额
            var bMoneyDiv = $('div[name="money"]');
            for(var i=0; i<bMoneyDiv.length; i++){
                $(bMoneyDiv[i]).text(moneyFun.format($(bMoneyDiv[i]).text()));
            }
            bt.bttable.init({
                elem:"#freeze",
                url:basePath+"/bankacc/btbankaccunfreeze/getUnFreeze?bankAccId="+$('#bankAccId').val()+"&curId="+$('#curId').val(),
                columns:[
                    {"data":"freezeNo",},
                    {"data":"freezeMoney",className:"textRight",render:function(data,id){
                        if(data.freezeMoney == null){
                            return 0;
                        }
                        return bt.money.format(data.freezeMoney);
                    }},
                    {"data":"freezeDateStr",render:function(data,id){
                        if(data.freezeDateStr == null){
                            return "--";
                        }
                        return data.freezeDateStr;
                    }},
                    {"data":"ufFreezeMoney",className:"textRight",render:function(data,id){
                        if(data.ufFreezeMoney == null){
                            return 0;
                        }
                        return bt.money.format(data.ufFreezeMoney);
                    }},
                    {"data":"ufavalBal",className:"textRight",render:function(data,id){
                        if(data.ufavalBal == null){
                            return 0;
                        }
                        return bt.money.format(data.ufavalBal);
                    }},
                    {"data":"freezeRession",width:"600",render:function(data,id){
                        if(!data.freezeRession){
                            return "";
                        }
                        var text = data.freezeRession;
                        if(text.length > 140){
                            return '<div style="max-width:600px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="'+text+'">'+text.substring(0,140)+'...</div>';
                        }
                        return '<div style="max-width:600px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="'+text+'">'+text+'</div>';
                    }},
                    {"data":"statusName",}
                ]
            })
        });
	</script>
</body>
</html>
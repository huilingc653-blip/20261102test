<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="ini_status" name="ini_status" value="0,-1">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="10%">#springMessage('table.bisAccBal.corp')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="likes_corpId"
                         data-resource="netbank:bankAcc:bisAccBal:managerQuery"
                         data-scope="all"
                         data-callback="corpCallback"></div>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.bisAccBal.bankAcc')</td>
            <td width="10%">
                <div class="layui-input-inline">
                    <input type="text" id="likes_bankAcc" name="likes_bankAcc" data-name="likes_bankAcc" data-biz-name="likes_bankAcc" accountType="3" permission="B"
                           data-resource="netbank:bankAcc:bisAccBal:managerQuery" autocomplete="off"
                           class="layui-input bt-biz-accountTable" data-callback="accountCallBack"/>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.bisAccBal.balDate')</td>
            <td width="30%">
                <input type="text" name="ged_balDate" data-biz-name="ged_balDate"
                       class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_balDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_balDate" data-biz-name="led_balDate"
                       class="layui-input bt-input-inline bt-biz-dateType" id="led_balDate">
            </td>
        </tr>
        <tr>
        ##币别ID
            <td class="textRight">#springMessage('table.bisAccBal.curId')</td>
            <td >
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name ="eqs_curId" data-biz-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
            </td>
            <td class="textRight">#springMessage('table.bisAccBal.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="nisAllocationReq.status"
                     data-name="eqi_status"></div>
            </td>
            <td colspan="2"></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
##                #if($shiro.hasPermission("netbank:bankAcc:bisAccBal:managerQuery"))
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                        'common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
##                #end
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.bisAccBal.bankAcc')</th>
        <th>#springMessage('table.bisAccBal.accName')</th>
        <th>#springMessage('table.bisAccBal.bankName')</th>
        <th>#springMessage('table.bisAccBal.corp')</th>
        <th>#springMessage('table.bisAccBal.curId')</th>
        <th>#springMessage('table.bisAccBal.balDate')</th>
        <th>#springMessage('table.bisAccBal.bal')</th>
        <th>#springMessage('table.bisAccBal.availBal')</th>
        <th>#springMessage('table.bisAccBal.frzBal')</th>
        <th>#springMessage('table.bisAccBal.status')</th>
        <th>#springMessage('table.bisAccBal.getDate')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisAccBal.list.js?_btv=${resourceVersion}"></script>
</html>

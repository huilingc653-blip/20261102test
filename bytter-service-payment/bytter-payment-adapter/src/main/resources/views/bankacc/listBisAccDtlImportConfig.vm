<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight">#springMessage('table.bisBifInit.bankType')</td>
					<td width="40%">
                        <div class="layui-input-inline">
                            <div data-name="eqs_bankTypeId" class="bt-biz-selectType"
                                 data-url="${basePath}/basic/business/btbanktype/json"
                                 data-valueField="id"
                                 data-biz-name="eqs_bankTypeId"
                                 data-textField="typeName"
                                 data-search="true"></div>
                        </div>
                    </td>
					<td class="textRight">#springMessage('common.table.filetype')</td>
					<td width="40%">
                        <div class="bt-biz-dict" data-type="select"
                             data-group="RAS_IMPORT_FILE_DICT" data-name="eqs_fileType" ></div>
                    </td>
                </tr>
    			<tr >
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.bisBifInit.bankType')</th>
            <th>#springMessage('common.table.filetype')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisAccDtlImportConfig.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="ins_id" name="ins_id" value="$!{btBankAccDtlVO.id}">
    <input type="hidden" id="eqd_transTime" name="eqd_transTime" value="$!date.format('yyyy-MM-dd HH:mm:ss',$!{btBankAccDtlVO.transTime})">
    <input type="hidden" id="id" name="id" value="$!{btBankAccDtlVO.id}">
    <input type="hidden" id="transTime" name="transTime" value="$!date.format('yyyy-MM-dd HH:mm:ss',$!{btBankAccDtlVO.transTime})">
    <table class="layui-table" id="btBankAccDtlInfo">
        <thead>
        <tr class="title">
            <th>#springMessage('table.btBankAccDtl.transTime')</th>
            <th>#springMessage('table.btBankAccDtl.amt')</th>
            <th>#springMessage('table.btBankAccDtl.bal')</th>
            <th>#springMessage('table.btBankAccDtl.cdSign')</th>
            <th>#springMessage('table.btBankAccDtl.rbSign')</th>
            <th>#springMessage('table.btBankAccDtl.curName')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccBank')</th>
            <th>#springMessage('table.btBankAccDtl.orderNo')</th>
        </tr>
        </thead>
    </table>
    <table class="layui-table">
        <tr>
            <td style="text-align: center;">
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button class="layui-btn" lay-submit="" lay-filter="adjust">#springMessage(
                    'common.button.adjust')</button>
            </td>
        </tr>
    </table>

</form>
</body>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/bankacc/btBankAccDtlAdjust.edit.js?_btv=${resourceVersion}"></script>
</html>
<script type="text/javascript">
    function checkPhone(obj){
        var phonePattern = /^1[3-9]\d{9}$/;
        var value = $(obj).val();
        if (!phonePattern.test(value)) {
            layer.alert(bt.lang("请输入正确的手机号码！"), {icon: 2});
            $(obj).val('');
        }
    }
    function clearInputField(event) {
        // Check if the input field is not already empty
        if (event.target.value !== '') {
            // Clear the input field
            event.target.value = '';
        }
        // Optionally, remove this listener so it only triggers once
        event.target.removeEventListener('focus', clearInputField);
    }

    window.onload = function() {
        // Attach the clearInputField function to the focus event of your input field
        document.getElementById('loginPassword').addEventListener('focus', clearInputField);
        document.getElementById('payPassword').addEventListener('focus', clearInputField);
    };
</script>

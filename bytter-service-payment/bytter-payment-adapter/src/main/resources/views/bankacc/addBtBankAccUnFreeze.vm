<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	<style>
		textarea {
			border: 1px solid #c2c2c2;
		}
	</style>
</head>
<body>
	<table class="layui-table">
		<tbody>
			<tr>
				<td colspan="4" style="text-align: center;font-weight: 700">#springMessage('table.unFreeze.apply')</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.nisBillhead.accId')</td>
				<td>$!{accVO.bankAcc}</td>
				<td align="right">#springMessage('table.nisAllocationReq.accName')</td>
				<td>$!{accVO.accName}</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.nisAllocationReq.bankName')</td>
				<td>$!{accVO.bankName}</td>
				<td align="right">#springMessage('btBankType.typeName')</td>
				<td>$!{accVO.bankTypeName}</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.btBankAccApp.attributeId')</td>
				<td>$!{accVO.attributeName}</td>
				<td align="right">#springMessage('table.fcAcc.corpId')</td>
				<td>$!{accVO.corpName}</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.btBankAccApp.accType')</td>
				<td>$!{accVO.accTypeName}</td>
				<td></td>
				<td></td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.btBankAccCur.cur')</td>
				<td>$!{accVO.curName}</td>
				<td align="right">#springMessage('table.fcAcc.interestRate')</td>
				<td>$!rateTag.show($!{accVO.rates})</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.btInnerAccApp.innerDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!{accVO.regDate})</td>
				<td align="right">#springMessage('table.btBankAccApp.natureId')</td>
				<td>$!{accVO.natureName}</td>
			</tr>
			<tr>
				<td colspan="4" style="text-align: center;font-weight: 700">#springMessage('table.btBankAccunFreeze.info')</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.nisAllocationReq.accBalance')</td>
				<td>
					<div name="money">$!{btBankAccFreezeVO.bal}</div>
				</td>
				<td align="right">#springMessage('table.bisAccBal.availBal')</td>
				<td>
					<div name="money">$!{btBankAccFreezeVO.avalBal}</div>
				</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.btBankAccFreeze.freezeNum')</td>
				<td>$!{btBankAccFreezeVO.freezeCount}</td>
				<td align="right">#springMessage('table.btBankAccFreeze.sumFreezeAtm')</td>
				<td>
					<div name="money">$!{btBankAccFreezeVO.freezeMoneySum}</div>
				</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.btBankAccFreeze.unfreezeNum')</td>
				<td>$!{btBankAccFreezeVO.unfreezeCount}</td>
				<td align="right">#springMessage('table.btBankAccFreeze.sumUnfreezeAtm')</td>
				<td>
					<div name="money">$!{btBankAccFreezeVO.unFreezeMoneySum}</div>
				</td>
			</tr>
		</tbody>
	</table>
	<form class="layui-form" method="post">
		<input type="hidden" name="bal" id="bal" value="$!{btBankAccFreezeVO.bal}" />
		<input type="hidden" name="availBal" id="availBal" value="$!{btBankAccFreezeVO.avalBal}" />
		<input type="hidden" name="bankAccId" id="bankAccId" value="$!{accVO.id}" />
		<input type="hidden" name="bankAcc" id="bankAcc" value="$!{accVO.bankAcc}" />
		<input type="hidden" name="corpId" id="corpId" value="$!{accVO.corpId}" />
		<input type="hidden" name="curId" id="curId" value="$!{accVO.curId}" />
		<input type="hidden" name="id" id="id" value="" />
		<table class="layui-table" id="freeze">
			<thead>
				<tr align="center">
					<th>#springMessage('table.Freeze.freezeNo')</th>
					<th>#springMessage('table.fcFreeze.freezeMoney')</th>
					<th>#springMessage('table.freeze.freezeDate')</th>
					<th>#springMessage('table.freeze.ufFreezeMoney')</th>
                    <th>#springMessage('table.freeze.ufWaitMoney')</th>
					<th>#springMessage('table.freeze.ufavalBal')</th>
					<th>#springMessage('table.fcFreeze.freezeReason')</th>
					<th>#springMessage('table.btBankAcc.status')</th>
				</tr>
			</thead>
			<tfoot style="text-align: center;background-color:#ddd">
			<tr id="freeSum">
				<td>&nbsp;</td>
				<td>#springMessage('table.datatable.total')</td>
				<td name="freeMoney" class="textRight">0.00</td>
				<td>&nbsp;</td>
				<td>&nbsp;</td>
				<td>&nbsp;</td>
				<td>&nbsp;</td>
				<td>&nbsp;</td>
				<td>&nbsp;</td>
			</tr>
			</tfoot>
		</table>
		<table class="layui-table">
			<tbody>
				<tr>
					<td align="right">
						<span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fcFreeze.unfreezeMoney.yes')
					</td>
					<td colspan="3">
						<input type="text" data-name="freezeMoney" lay-verify="required" class="layui-input bt-biz-moneyType"
						data-minus="true" data-biz-name="freezeMoney">
					</td>
				</tr>
				<tr>
					<td align="right">
						<span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fcFreeze.unfreezeReason')
					</td>
					<td colspan="3">
						<textarea rows="5" cols="50" id="freezeRession" name="freezeRession" lay-verify="required|strlength" data-maxlength="200"></textarea>
					</td>
				</tr>
				<tr>
					<td colspan="4" align="center">
						<button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
	<form class="layui-form" method="post">
		<table class="layui-table" id="unfreezeTemp">
			<thead>
				<tr align="center">
					<th>#springMessage('table.Freeze.unfreezeNo')</th>
                    <th>#springMessage('table.Freeze.freezeNo')</th>
					<th>#springMessage('table.fcFreeze.unfreezeMoney.yes')</th>
					<th>#springMessage('table.freeze.unfreezeDate')</th>
					<th>#springMessage('table.freeze.ufFreezeMoney')</th>
                    <th>#springMessage('table.freeze.ufWaitMoney')</th>
					<th>#springMessage('table.freeze.ufavalBal')</th>
					<th>#springMessage('table.fcFreeze.unfreezeReason')</th>
					<th>#springMessage('table.btBankAcc.status')</th>
					<th>#springMessage('common.table.thead.operation')</th>
				</tr>
			</thead>
			<tfoot style="text-align: center;background-color:#ddd">
			<tr id="sum">
				<td>&nbsp;</td>
				<td>#springMessage('table.datatable.total')</td>
				<td>&nbsp;</td>
				<td name="money" class="textRight">0.00</td>
				<td>&nbsp;</td>
				<td>&nbsp;</td>
				<td>&nbsp;</td>
				<td>&nbsp;</td>
				<td>&nbsp;</td>
				<td>&nbsp;</td>
				<td>&nbsp;</td>
			</tr>
			</tfoot>
		</table>
		<table class="layui-table">
			<tr>
				<td align="center">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
				</td>
			</tr>
		</table>
	</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccUnFreeze.add.js?_btv=${resourceVersion}"></script>
</html>

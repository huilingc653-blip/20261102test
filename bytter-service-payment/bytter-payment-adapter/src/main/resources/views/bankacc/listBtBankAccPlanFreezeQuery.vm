<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table layui-table-border">
        <tbody>
        <tr>
            ##单位
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.corp')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="ins_corpId"
                         data-scope="all"
                         data-resource="netbank:bankAcc:btBankAccPlanFreezeQuery:query"
                         data-callback="corpCallback" data-defaultvalue="$!{corpId}"></div>
                </div>
            </td>
            ##冻结账号
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.bankAcc')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" class="layui-input bt-biz-accountTable" id="likes_bankAcc" name="likes_bankAcc" data-name="likes_bankAcc"
                           data-biz-name="likes_bankAcc" accountType="2,3" autocomplete="off" containDelBankAcc="true"
                           data-resource="netbank:bankAcc:btBankAccPlanFreezeQuery:query"
                           data-callback="accountCallBack" permission="D"/>
                </div>
            </td>
            ##单据状态
            <td class="textRight" width="10%">单据状态</td>
            <td width="30%">
                <div class="bt-biz-dict" data-type="select" data-group="bisExc.status" data-name="eqi_status" data-biz-name="status"></div>
            </td>
        </tr>
        <tr>
            ##冻结金额
            <td class="textRight">#springMessage('table.fcAccBalance.freezeMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" class="layui-input bt-biz-moneyType bt-input-inline" name="geg_applyFreezeMoney" data-biz-name="geg_applyFreezeMoney" autocomplete="off" data-minus="true"
                           style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.fcAccBalance.freezeMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" class="layui-input bt-biz-moneyType bt-input-inline" name="leg_applyFreezeMoney" data-biz-name="leg_applyFreezeMoney" autocomplete="off" data-minus="true"
                           style="text-align:right" id="t20" placeholder="#springMessage('table.fcAccBalance.freezeMoney')">
                </div>
            </td>
            ##冻结开始时间
            <td class="textRight">冻结开始时间</td>
            <td>
                <input type="text" class="layui-input bt-input-inline bt-biz-dateType" data-type="date"
                       name="ged_freezeStartDate" data-biz-name="ged_freezeStartDate" data-endid="led_freezeStartDate"
                       placeholder="冻结开始时间">
                <span class="date-mid">~</span>
                <input type="text" class="layui-input bt-input-inline bt-biz-dateType" data-type="date"
                       name="led_freezeStartDate" data-biz-name="led_freezeStartDate" id="led_freezeStartDate"
                       placeholder="冻结开始时间">
            </td>
            ##冻结结束时间
            <td class="textRight">冻结结束时间</td>
            <td>
                <input type="text" class="layui-input bt-input-inline bt-biz-dateType" data-type="date"
                       name="ged_freezeEndDate" data-biz-name="ged_freezeEndDate" data-endid="led_freezeEndDate"
                       placeholder="冻结结束时间">
                <span class="date-mid">~</span>
                <input type="text" class="layui-input bt-input-inline bt-biz-dateType" data-type="date"
                       name="led_freezeEndDate" data-biz-name="led_freezeEndDate" id="led_freezeEndDate"
                       placeholder="冻结结束时间">
            </td>
        </tr>
        <tr>
            ##冻结状态
            <td class="textRight" width="10%">冻结状态</td>
            <td width="30%">
                <div class="bt-biz-dict" data-type="select" data-group="btBankAcc.planFreezeStatus" data-name="eqi_freezeStatus" data-biz-name="freezeStatus"></div>
            </td>
            ##是否冻结完成提醒
            <td class="textRight" width="10%">是否冻结完成提醒</td>
            <td width="30%">
                <div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-name="eqs_isFreezeComplete" data-biz-name="isFreezeComplete"></div>
            </td>
            ##是否解冻
            <td class="textRight" width="10%">是否解冻</td>
            <td width="30%">
                <div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-name="eqs_isUnfreeze" data-biz-name="isUnfreeze"></div>
            </td>
        </tr>
        <tr>
            ##创建日期
            <td class="textRight">创建日期</td>
            <td>
                <input type="text" class="layui-input bt-input-inline bt-biz-dateType" data-type="date"
                       name="ged_createDate" data-biz-name="ged_createDate" data-endid="led_createDate"
                       placeholder="创建日期">
                <span class="date-mid">~</span>
                <input type="text" class="layui-input bt-input-inline bt-biz-dateType" data-type="date"
                       name="led_createDate" data-biz-name="led_createDate" id="led_createDate"
                       placeholder="创建日期">
            </td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>计划冻结单号</th>
        <th>单位</th>
        <th>冻结账号</th>
        <th>账号名称</th>
        <th>账号开户行</th>
        <th>是否直连</th>
        <th>冻结开始时间</th>
        <th>冻结结束时间</th>
        <th>申请冻结金额</th>
        <th>冻结说明</th>
        <th>实际已冻结金额</th>
        <th>单据状态</th>
        <th>冻结状态</th>
        <th>是否冻结完成提醒</th>
        <th>是否解冻</th>
        <th>创建人</th>
        <th>创建日期</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccPlanFreezeQuery.list.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody >
				<tr>
                    <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.bankAcc')</td>
                    <td width="20%">
                        <div class="layui-input-inline">
                            <input type="text" id="likes_bankAcc" name="likes_bankAcc" data-name="likes_bankAcc" accountType="2,3" autocomplete="off"
                                   data-resource="netbank:bankAcc:bisAccBal:managerQuery"  class="layui-input bt-biz-accountTable" data-callback="accountCallBack"/>
                        </div>
                    </td>
                    <td class="textRight">#springMessage('table.btBankAccDtl.accName')</td>
                    <td>
                        <input type="text" id="likes_accName" name="likes_accName" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.accName')">
                    </td>
                    <td class="textRight">#springMessage('table.btBankAccDtl.bankName')</td>
                    <td>
                        <input type="text" id="likes_bankName" name="likes_bankName" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.bankName')">
                    </td>
                </tr>
                <tr>
                    <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.curName')</td>
                    <td width="30%">
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                             data-name ="eqs_curId" data-biz-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
                    </td>
                    <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.transTime')</td>
                    <td width="20%">
                        <input type="text" name="ged_transTime" data-type="date" data-biz-name="ged_transTime" class="layui-input bt-input-inline bt-biz-dateType" id="ged_transTime" data-endid="led_transTime" data-today="true">
                        <span class="date-mid">~</span>
                        <input type="text" name="led_transTime" data-type="date" data-biz-name="led_transTime" class="layui-input bt-input-inline bt-biz-dateType" id="led_transTime" data-today="true" data-callback="ledTransTimeCallback">
                    </td>
                    ##金额
                    <td class="textRight">#springMessage('table.btBankAccDtl.bal')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_bal"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.btBankAccDtl.bal')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_bal"
                                   autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.btBankAccDtl.bal')">
                        </div>
                    </td>
                </tr>
                    ##银行流水号
                <tr>
                    <td class="textRight">#springMessage('table.bisExc.bankSerialNo')</td>
                    <td>
                        <input type="text" id="likes_bankSerialNo" name="likes_bankSerialNo" class="bank layui-input" autocomplete="off"
                               placeholder="#springMessage('table.bisExc.bankSerialNo')">
                    </td>
                </tr>
				<tr>
                    <td colspan="6" style="text-align: center;">
                    #if($shiro.hasPermission("netbank:bankAcc:bisAccDtl:makeupQuery"))
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    #end
                    </td>
				</tr>
            </tbody>
		</table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
            <th>#springMessage('table.btBankAccDtl.accName')</th>
            <th>#springMessage('table.btBankAccDtl.bankName')</th>
            <th>#springMessage('table.btBankAccDtl.transTime')</th>
            <th>#springMessage('table.btBankAccDtl.amt')</th>
            <th>#springMessage('table.btBankAccDtl.bal')</th>
            <th>#springMessage('table.btBankAccDtl.cdSign')</th>
            <th>#springMessage('table.btBankAccDtl.curName')</th>
            <th>#springMessage('table.bisExc.bankSerialNo')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccBank')</th>
            <th>#springMessage('table.btBankAccDtl.projectRemark')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisAccDtlMakeup.list.js?_btv=${resourceVersion}"></script>
</html>

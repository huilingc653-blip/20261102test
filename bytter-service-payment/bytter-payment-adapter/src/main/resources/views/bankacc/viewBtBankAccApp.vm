<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
        <input id="id"  type="hidden" value="$!{btBankAccAppPage.id}">
        <input id="corpId"  type="hidden" value="$!{btBankAccAppPage.corpId}">
        <input id="busType" type="hidden" value="$!{busType}">
        <div id="print">
    	<table class="layui-table layui-table-border">
            <tbody>
        		<tr>
                    <td class="textRight">#springMessage('table.btBankAccApp.corpId')</td>
            		<td width="35%">
    					$!{btBankAccAppPage.corpName}
                    </td>
                    <td class="textRight">#springMessage('table.btBankAccApp.accName')</td>
            		<td width="35%">
    					$!{btBankAccAppPage.accName}
                    </td>
        		</tr>
        		<tr>
					<td class="textRight" >#springMessage('table.btBankAccApp.curId')</td>
            		<td colspan="3">
    					$!{btBankAccAppPage.curName}
                   	</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.btBankAccApp.isDomesticBank')</td>
					<td>
						$dictTag.get("btBankAcc.isDomesticBank",$!{btBankAccAppPage.isDomesticBank})
					</td>
					##是否离岸账号
					<td class="textRight">#springMessage('table.btBankAccApp.isOffshoreAccount')</td>
					<td>$dictTag.get("sf_yn",${btBankAccAppPage.isOffshoreAccount})</td>
				</tr>
        		<tr>
                    <td class="textRight">#springMessage('table.btBankAccApp.bankName')</td>
    				<td>$!{btBankAccAppPage.bankName}</td>
                    <td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
    				<td>$!{btBankAccAppPage.bankTypeName}</td>
				</tr>
        		<tr>
                   <td class="textRight">#springMessage('table.btBankAccApp.attributeId')</td>
            		<td>
    					$!{btBankAccAppPage.attributeName}
                    </td>
                     <td class="textRight">#springMessage('table.btBankAccApp.natureId')</td>
            		<td>
    					$!{btBankAccAppPage.natureName}
                    </td>
        		</tr>
				<tr>
                    <td class="textRight">#springMessage('table.btBankAccApp.accType')</td>
            		<td>
						$dictTag.get("btBankAcc.accType",$!{btBankAccAppPage.accType})
                    </td>
					#set($accType="$!{btBankAccAppPage.accType}")
					#if($accType=="02") ##定期
						<td class="textRight">#springMessage('table.btBankAccApp.regulars')</td>
						<td >$dictTag.get("btBankAcc.Term",${btBankAccAppPage.regulars})</td>
						</tr>
					#elseif($accType=="07")  ##协定
						<td class="textRight">#springMessage('table.btBankAcc.agrMoney')</td>
						<td>$number.formatNumeric($!{btBankAccAppPage.agrMoney})</td>
						</tr>
						<tr>
						<td class="textRight">#springMessage('table.btBankAcc.agrContract')</td>
						<td>$!{btBankAccAppPage.agrContract}</td>
						<td class="textRight">#springMessage('table.btBankAcc.agrInterest')</td>
						<td>$rateTag.show($!{btBankAccAppPage.agrInterest})</td>
                        </tr>
						<tr>
							<td class="textRight">#springMessage('table.btBankAcc.agrBeginDate')</td>
							<td>$!date.format('yyyy-MM-dd', $!{btBankAccAppPage.agrBeginDate})</td>
							<td class="textRight">#springMessage('table.btBankAcc.agrEndDate')</td>
							<td>$!date.format('yyyy-MM-dd', $!{btBankAccAppPage.agrEndDate})</td>
                        </tr>
					#elseif($accType=="06")  ##通知
                        <td class="textRight">#springMessage('table.btBankAccApp.noticeType')</td>
						<td>$dictTag.get("bankAcc.noticeType",$!{btBankAccAppPage.noticeType})</td>
						</tr>
					#elseif($accType=="09")  ##虚拟户
                        <td class="textRight">#springMessage('table.btBankAccApp.entityAcc')</td>
						<td>$!{btBankAcc.bankAcc}</td>
						</tr>
					#elseif($accType=="10")  ##票据专户
                    <td class="textRight">#springMessage('table.btBankAccApp.circulationMode')</td>
                    <td>$dictTag.get("bankAcc.circulationMode",$!{btBankAccAppPage.circulationMode})</td>
                    </tr>
					#else
						<td align="right" class="type"></td>
						<td class="typeText"></td>
						</tr>
					#end
				#if($!{isDomesticBankType} == "1")
				<tr>
                    <td class="textRight">#springMessage('table.btBankAccApp.prov')</td>
    				<td>$!{btBankAccAppPage.provName}</td>
                    <td class="textRight">#springMessage('table.btBankAccApp.city')</td>
    				<td>$!{btBankAccAppPage.cityName}</td>
				</tr>
				#end
                <tr>
                    <td class="textRight">#springMessage('table.btBankAccApp.opRession')</td>
					<td colspan="3">
						<textarea readonly style="width: 90%; min-height: 80px; border: 1px solid #e6e6e6; padding: 8px; resize: vertical;">$!{btBankAccAppPage.opRession}</textarea>
					</td>
				</tr>
			</tbody>
		</table>
		</div>
        <!-- 日志 -->
        <div id="tagMsg"></div>
		<!--附件上传 -->
        <input id="attachmentId" name="attachmentId" type="hidden" value="$!{btBankAccAppPage.attachmentId}">
        <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
        <p>
        <div class="layui-form-item layui-form-submit" id="buttonDiv">
			<div class="layui-input-block">
				<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{btBankAccAppPage.id}')">#springMessage('common.button.trackFlow')</button>
				<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
			</div>
        </div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['btUpload','printType'], function() {
        var up = bt.btUpload.init({
            elem: "#uploader",
            auto: false,
            hasDelete:false,
            hasUpload: false,
            gid: $("#attachmentId").val()
        });
        bt.printType.init();
        /**
         * 生成日志列表
         * @return
         */
        $genMsgHtml= function() {
            var url=basePath + "/bankacc/message/list/"+$('#id').val()+"/"+$("#busType").val();
            $.ajax({
                url:url,
                method: 'GET',
                async:false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                }
            });
        }
			$genMsgHtml();

        /**
         * 查看已开账户
         */
        showOldBankAcc = function (){
            parent.layer.open({
                type: 2,
                area: ['1020px', '530px'],
                maxmin: true,
                content: basePath + "/bankacc/btbankaccapp/showOldBankAcc/" + $('#corpId').val()
            });
        }
    });

</script>
</html>
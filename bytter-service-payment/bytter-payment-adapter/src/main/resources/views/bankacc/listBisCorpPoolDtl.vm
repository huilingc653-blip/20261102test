<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody >
        <tr>
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.corp')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="ins_corpId"
                         data-scope="all" data-resource="bankacc:biscorppooldtl:query"
                         data-callback="corpCallback"></div>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.bankAcc')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" id="likes_bankAcc" name="likes_bankAcc" data-name="likes_bankAcc" data-biz-name="likes_bankAcc" accountType="2,3" autocomplete="off" containDelBankAcc="true"
                           data-resource="bankacc:biscorppooldtl:query"  class="layui-input bt-biz-accountTable" data-callback="accountCallBack" permission="D"/>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.btNetChalk.accName')</td>
            <td width="30%">
                <input type="text" id="likes_accName" name="likes_accName" class="layui-input" autocomplete="off">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAccDtl.oppAccNo')</td>
            <td>
                <input type="text" id="likes_oppAccNo" name="likes_oppAccNo" class="layui-input bank" autocomplete="off">
            </td>
            <td class="textRight">#springMessage('table.btBankAccDtl.oppAccName')</td>
            <td>
                <input type="text" id="likes_oppAccName" name="likes_oppAccName" class="layui-input" autocomplete="off">
            </td>
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.transTime')</td>
            <td width="30%">
                <input type="text" name="ged_transTime" data-type="date" data-biz-name="ged_transTime" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_transTime" value="$!{beginDate}" data-today="true">
                <span class="date-mid">~</span>
                <input type="text" name="led_transTime" data-type="date" data-biz-name="led_transTime" class="layui-input bt-input-inline bt-biz-dateType" id="led_transTime" value="$!{endDate}" data-today="true">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAccDtl.bifCode')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/bisbifinit/listFilter" data-method="get"
                         data-valuefield="id" data-textfield="name" data-name="ins_bifCode" data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.btBankAccDtl.curName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-value="$!{curId}"
                     data-name ="eqs_curId" data-biz-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
            </td>
            ##金额
            <td class="textRight">#springMessage('table.btBankAccDtl.amt')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="geg_amt" autocomplete="off" data-minus="true" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.bisExc.payMoney')" onchange="changMoney(this)">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_amt" autocomplete="off" data-minus="true" class="layui-input bt-biz-moneyType bt-input-inline"
                           data-biz-name="leg_amt" data-moneyendid="t20" style="text-align:right" id="t20" placeholder="#springMessage('table.bisExc.payMoney')">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">流水方向</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="btBankAccDtl.cdSign" data-name="eqi_cdSign"
                     data-biz-name="eqi_cdSign"></div>
            </td>
            <td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
            <td>
                <input type="text" id="likes_postscript" name="likes_postscript" class="layui-input" />
            </td>
            <td class="textRight">#springMessage('table.btBankAccDtl.uses')</td>
            <td>
                <input type="text" id="likes_uses" name="likes_uses" class="layui-input" />
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('bpm.option.conditions.type')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="bisCorpPoolDtl.poolType" data-name="poolType"
                     data-biz-name="poolType"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btBankAccDtl.transTime')</th>
        <th>#springMessage('table.btBankAccDtl.corp')</th>
        <th>#springMessage('bis.bank.dtl.id')</th>
        <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
        <th>#springMessage('table.btBankAccDtl.accName')</th>
        <th>#springMessage('table.btBankAccDtl.bankName')</th>
        <th>#springMessage('table.btBankAccDtl.curName')</th>
        <th>#springMessage('table.btBankAccDtl.amtIn')</th>
        <th>#springMessage('table.btBankAccDtl.amtOut')</th>
        <th>#springMessage('table.bisExc.bankSerialNo')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccBank')</th>
        <th>#springMessage('table.btBankAccDtl.remark')</th>
        <th>#springMessage('table.nisBillhead.addWord')</th>
        <th>#springMessage('table.btBankAccDtl.uses')</th>
        <th>#springMessage('bpm.option.conditions.type')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisCorpPoolDtl.list.js?_btv=${resourceVersion}"></script>
</html>
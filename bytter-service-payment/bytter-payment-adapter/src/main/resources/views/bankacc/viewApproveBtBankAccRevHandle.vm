#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<input id="id" type="hidden" value="$!{btBankAcc.id}">
<input id="attachmentId" name="attachmentId" type="hidden" value="$!{btBankAcc.attachmentId}">
<ul class="mui-table-view">
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.accNo')
        <span class="mui-badge mui-badge-inverted">
            $!{app.accNo}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.bankAcc')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.bankAcc}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.accName')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.accName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.corpName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.curId')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.curName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.isDomesticBank')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.isDomesticBankName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.accType')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.accTypeName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.attributeId')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.attributeName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.natureId')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.natureName}
        </span>
    </li>
    #if($!{btBankAcc.accType}=="09")  ##虚拟户
        <li class="mui-table-view-cell">
            #springMessage('table.btBankAccApp.entityAcc')
            <span class="mui-badge mui-badge-inverted">
                $!{btBankAccPage.entityAcc}
        </span>
        </li>
    #end
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.bankTypeId')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.bankTypeName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.bankName')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.bankName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.prov')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.provName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.city')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.cityName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.electricBill')
        <span class="mui-badge mui-badge-inverted">
            $!{btBankAcc.electricBillName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.btBankAccApp.opRession.forRev')
        <span class="mui-badge mui-badge-inverted">
            $!{app.opRession}
        </span>
    </li>

</ul>
    #parse("views/common/wapfooter.vm")
</body>
<script>
    window.onload=function () {
        var attachmentId = $("#attachmentId").val();
        /*setTimeout(function () {
            BTAppBridge.initAttachmentByGroupId && BTAppBridge.initAttachmentByGroupId(attachmentId);
        },100);*/
    }
</script>
</html>

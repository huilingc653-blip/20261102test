<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <table class="layui-table layui-form">
        <thead>
        <tr>
            <th>#springMessage('table.nisBillhead.bankAcc')</th>
            <th>#springMessage('table.btBankAccApp.accName')</th>
            <th>#springMessage('table.accountDTO.bankName')</th>
            <th>#springMessage('table.fbsBudgetDetail.curId')</th>
        </tr>
        </thead>
		<tbody >
			#if($!infoList)
    		#foreach($info in $infoList)
			<tr>
				<td>$!{info.bankAcc}</td>
				<td>$!{info.accName}</td>
				<td>$!{info.bankName}</td>
				<td>$!{info.curName}</td>
			</tr>
            #end
            #end
        </tbody>
    </table>
#parse("views/common/footer.vm")
</body>
</html>

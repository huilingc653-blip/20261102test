	<div id="uploader" class="layui-input-inline" style="width: 100%"></div>
	<p>
	<div class="layui-form-item layui-form-submit" id="buttonDiv">
		<div class="layui-input-block">
			<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage(
            'common.button.print')</button>
		</div>
	</div>
		#parse("views/common/footer.vm")
	#paymentWorkFlowHtml($!{btnPrependHtml})
	#paymentWorkFlowScript()

	<script>
		bt.use(['form','jquery','btUpload','printType', 'dicts'], function(){
			var $ = bt.jquery,form = bt.form();
			bt.workFlow.beforeSubmit = function(submitData){
				var taskIds = [];
				taskIds.push($("#taskId").val());
				bt.workFlow.taskList = taskIds;
				return true;
			}
			bt.workFlow.afterSubmit = function(){
				parent.layer?parent.layer.closeAll():layer.closeAll();
			}
			var up = bt.btUpload.init({
				elem: "#uploader",
				auto: false,
				hasDelete: false,
				hasUpload: false,
				gid: $("#attachmentId").val()
			});
			bt.printType.init();
			/**
			 * 生成日志列表
			 * @return
			 */
				$genMsgHtml= function () {
				var url = basePath + "/bankacc/message/list/" + $('#id').val() + "/" + $("#busType").val();
				$.ajax({
					url: url,
					method: 'GET',
					async: false,
					success: function (json) {
						$("#tagMsg").html("");
						$("#tagMsg").html(json);
					}
				});
			}
				$genMsgHtml();

			$('#imger1,#imger2,#imger3').on('click', function (event) {
				showImg($(this));
			});

			var dicts = bt.dicts.init();
		});
		function showImg(imgData) {
			let imgSrc = imgData.attr("src");
			getImageWidth(imgSrc, function (width, height) {
				let winHeight = $(window).height() - 80;  // 浏览器可视部分高度
				let winWidth = $(window).width() - 100;  // 浏览器可视部分宽度
				// 如果图片高度或者宽度大于限定的高度或者宽度则进行等比例尺寸压缩
				if (height > winHeight || width > winWidth) {
					// 1.原图片宽高比例 大于等于 图片框宽高比例
					if (winWidth / winHeight < width / height) {
						height = winWidth * (height / width);
						width = winWidth;   //以框的宽度为标准
					} else {
						width = winHeight * (width / height);
						height = winHeight;   //以框的高度为标准
					}
				}
				var imgHtml = "<img src='" + imgSrc + "' width='" + width + "px' height='" + height + "px' />";
				layer.open({
					type: 1
					, title: false //不显示标题栏
					, offset: 'auto'
					, closeBtn: true
					, area: [width + 'px', height + 'px']
					, content: imgHtml,
				});
			});
		}

		function getImageWidth(url, callback) {
			var img = new Image();
			img.src = url;
			// 如果图片被缓存，则直接返回缓存数据
			if (img.complete) {
				callback(img.width, img.height);
			} else {
				// 完全加载完毕的事件
				img.onload = function () {
					callback(img.width, img.height);
				}
			}
		}


		$(document).ready(function () {
			setTimeout(function () {
				$("input[name='uKeyFunction']").attr({"disabled": "true", "readonly": "readonly"}) //禁用
			}, 1000); //1s
		});
	</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <div class="layui-collapse" lay-filter="collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title"></h2>
                <div class="layui-colla-content layui-show">
                <table class="layui-table">
                <tbody>
    			<tr>
    				##单位ID
					<td class="textRight">#springMessage('table.btBankAcc.corpId')</td>
                    <td>
                		<div class="layui-input-inline">
                			<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-tree-type="check"
                            data-name="ins_corpId"
                            data-scope="all"
                            data-resource="netbank:bankAcc:btBankAccQuery:query"></div>
                        </div>
            		</td>
					<td class="textRight">#springMessage('table.btBankAccApp.bankAcc')</td>
					<td>
                        <input type="text" name="likes_bankAcc"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccApp.bankAcc')">
                  	</td>
					<td class="textRight">#springMessage('table.btBankAcc.accName')</td>
					<td>
						<input type="text" name="likes_accName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.accName')">
                 	</td>
        		</tr>
				<tr>
                    <td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/listFilter" data-method="get"
                                 data-valuefield="id" data-textfield="typeName" data-name="ins_bankTypeId" data-inputvalue="inputvalue" data-search="true"></div>
                        </div>
    				</td>
                    <td class="textRight">#springMessage('table.btBankAcc.bankName')</td>
					<td >
						<input type="text" name="likes_bankName"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankName')">
                 	</td>
                    <td class="textRight">#springMessage('table.btBankAcc.validSign')</td>
                    <td >
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="eqs_validSign" data-defaultvalue="1"></div>
                    </td>
    			</tr>
				<tr>
                    <td class="textRight">#springMessage('table.btBankAccApp.attributeId')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/bankacc/bisaccattribute/json"
                             data-valuefield="id" data-textfield="attributeName"  data-name="eqs_attributeId"
                             data-inputvalue="inputvalue" data-search="true"></div>
    				</td>
##                    账户年检到期日
                    <td class="textRight" width="10%">#springMessage('table.btBankAcc.checkExpireDate')</td>
                    <td width="30%">
                        <input type="text" name="ged_checkExpireDate" data-biz-name="ged_balDate"
                               class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_checkExpireDate">
                        <span class="date-mid">~</span>
                        <input type="text" name="led_checkExpireDate" data-biz-name="led_balDate"
                               class="layui-input bt-input-inline bt-biz-dateType" id="led_checkExpireDate">
                    </td>
                    <td class="textRight">
                        #springMessage('是否直连')
                    </td>
                    <td  colspan="5">
                        <div class="bt-biz-dict" data-type="select"
                             data-group="sf_yn" data-name="eqs_isOnline" ></div>
                    </td>
    			</tr>
                <tr>
                    ##境内/境外账号
                    <td class="textRight">#springMessage('table.btBankAccApp.isDomesticBank')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="btBankAcc.isDomesticBank"
                             data-name="eqs_isDomesticBankName" data-biz-name="isDomesticBank"></div>
                    </td>
                    ##账户类别
                    <td class="textRight">
                        #springMessage('table.btBankAcc.accType')
                    </td>
                    <td>
                        <div class="bt-biz-dict" data-type="select"
                             data-group="btBankAcc.accType" data-name="eqs_accType" data-biz-name="accType"></div>
                    </td>
                    <td class="textRight">#springMessage('table.btBankAcc.isElectricBillAcc')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select"
                             data-group="sf_yn" data-name="eqs_electricBillName"></div>
                    </td>
                </tr>
                <tr>
                    ##账户状态
                    <td class="textRight">
                        #springMessage('table.fcAcc.accState')
                    </td>
                    <td>
                        <div class="bt-biz-dict" data-type="select"
                             data-group="btBankAcc.accStatus" data-name="accStatus"></div>
                    </td>
                    <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
                    <td>
                        <div class="layui-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrency/json"
                                 data-name="ins_curId" data-valueField="id" data-textField="curName" data-method="get"></div>
                        </div>
                    </td>
                    <td class="textRight">#springMessage('table.btBankAcc.rmk')</td>
                    <td >
                        <input type="text" name="likes_rmk"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.rmk')">
                    </td>
                </tr>
                <tr>
                    <td class="textRight">
                        是否存在附件
                    </td>
                    <td>
                        <div class="bt-biz-dict" data-type="select"
                             data-group="btBankAcc.attachmentSign" data-name="attachmentSign"></div>
                    </td>
##                    <td class="textRight">实体账号</td>
##                    <td>
##                        <input type="text" name="likes_bindingBankAcc"
##                               autocomplete="off" class="bank layui-input" placeholder="实体账号">
##                    </td>
##                    <td class="textRight">股权</td>
##                    <td>
##                        <div class="layui-inline">
##                            <div class="bt-biz-selectType" data-url="${basePath}/sys/equityMaintenance/json"
##                                 data-name="eqs_shareholding" data-valueField="equityCode" data-textField="equityName"></div>
##                        </div>
##                    </td>
                </tr>
				<tr>
					<td align="center" colspan="6">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>

        	    </tbody>
    	        </table>
                </div>
            </div>
        </div>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.btBankAccApp.bankAcc')</th>
##            <th>股权</th>
            <th>#springMessage('table.btBankAccApp.accName')</th>
            <th>#springMessage('table.btBankAccApp.corpId')</th>
            <th>#springMessage('table.btBankAccApp.curId')</th>
            <th>#springMessage('table.btBankAcc.isElectricBillAcc')</th>
            <th>#springMessage('table.btBankAccApp.circulationMode')</th>
            <th>#springMessage('table.btBankAccApp.isDomesticBank')</th>
            <th>#springMessage('table.btBankAccApp.accType')</th>
            <th>#springMessage('table.btBankAccApp.attributeId')</th>
            <th>#springMessage('table.btBankAccApp.natureId')</th>
            <th>#springMessage('table.btBankAccApp.bankTypeId')</th>
##            <th>#springMessage('账户组')</th>
            <th>#springMessage('table.btBankAccApp.bankName')</th>
            <th>#springMessage('table.btBankAccApp.prov')</th>
            <th>#springMessage('table.btBankAccApp.city')</th>
            <th>#springMessage('table.fc_instrate.interest_rate')%</th>
            <th>#springMessage('table.btBankAcc.regDate')</th>
            <th>#springMessage('table.btBankAccApp.closeDate')</th>
            <th>#springMessage('table.fcAcc.accState')</th>
            <th>#springMessage('table.btBankAcc.checkExpireDate')</th>
            <th>#springMessage('table.fcFreeze.operator')</th>
            <th>#springMessage('table.btBankAcc.isValidSign')</th>
            <th>#springMessage('是否直联')</th>
            <th>#springMessage('table.btBankAcc.isCapitalPool')</th>
            <th>#springMessage('table.btBankAcc.rmk')</th>
##            <th>#springMessage('大区')</th>
##            <th>#springMessage('营运区')</th>
##            <th>#springMessage('实时余额')</th>
##            <th>实体账号</th>
##            <th>实体账户单位</th>
##            <th>实体账户户名</th>
##            <th>实体账户开户行</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccQuery.list.js?_btv=${resourceVersion}"></script>
</html>

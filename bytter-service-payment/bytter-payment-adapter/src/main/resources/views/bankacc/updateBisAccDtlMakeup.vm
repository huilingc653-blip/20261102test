<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input type="hidden" id="id" name="id" value="$!{btBankAccDtlPage.id}">
		<input type="hidden" id="accNo" name="accNo" value="$!{btBankAccDtlPage.accNo}">
		<input type="hidden" id="corpId" name="corpId" value="$!{btBankAccDtlPage.corpId}">
		<input type="hidden" id="curId" name="curId" value="$!{btBankAccDtlPage.curId}">
        <input type="hidden" id="bifCode" name="bifCode" value="$!{btBankAccDtlPage.bifCode}">
		<input type="hidden" id="createBy" name="createBy" value="$!{btBankAccDtlPage.createBy}">
##		<input type="hidden" id="createDate" name="createDate" value="$!{btBankAccDtlPage.createDate}">
		<input type="hidden" id="updateBy" name="updateBy" value="$!{btBankAccDtlPage.updateBy}">
##		<input type="hidden" id="updateDate" name="updateDate" value="$!{btBankAccDtlPage.updateDate}">
		<input type="hidden" id="rbSign" name="rbSign" value="2">

        <table class="layui-table">
            <tbody>
				<tr>
					##本方账号
					<td class="textRight">#springMessage('table.btBankAccDtl.bankAcc')</td>
    				<td >
						<input type="text" id="bankAcc" name="bankAcc" readonly="readonly" 
						    autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.bankAcc')" value="$!{btBankAccDtlPage.bankAcc}">
					</td>
					##本方账户名
					<td class="textRight">#springMessage('table.btBankAccDtl.accName')</td>
    				<td >
						<input type="text" id="accName" name="accName"  readonly="readonly" 
						    autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.accName')" value="$!{btBankAccDtlPage.accName}">
					</td>
					##本方账户开户行
					<td class="textRight">#springMessage('table.btBankAccDtl.bankName')</td>
    				<td >
						<input type="text" id="bankName" name="bankName"  readonly="readonly" 
						    autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.bankName')" value="$!{btBankAccDtlPage.bankName}">
					</td>
        		</tr>
				<tr>
					##对方账号
					<td class="textRight">#springMessage('table.btBankAccDtl.oppAccNo')</td>
    				<td >
						<div class="layui-input-inline">
							<input type="text" id="oppAccNo" name="oppAccNo" lay-verify="required"
								autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.btBankAccDtl.oppAccNo')" value="$!{btBankAccDtlPage.oppAccNo}">
							<div class="bt-div-search">
								<button  class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button" data-beforeClick="bt.externalCorpBankAccParams" data-callback="bt.externalCorpCallback" title="#springMessage('common.button.select')">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>
						</div>
					</td>
					##对方账户名
					<td class="textRight">#springMessage('table.btBankAccDtl.oppAccName')</td>
    				<td >
						<input type="text" id="oppAccName" name="oppAccName" lay-verify="required"
						    autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.oppAccName')" value="$!{btBankAccDtlPage.oppAccName}">
					</td>
					##对方账户开户行
					<td class="textRight">#springMessage('table.btBankAccDtl.oppAccBank')</td>
    				<td >
						<input type="text" id="oppAccBank" name="oppAccBank" lay-verify="required"
						    autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.oppAccBank')" value="$!{btBankAccDtlPage.oppAccBank}">
					</td>
        		</tr>
				<tr>
					##借贷标志 0-收 1-支
					<td class="textRight">#springMessage('table.btBankAccDtl.cdSign')</td>
    				<td >
						<div class="layui-input-inline">
                            <input type="radio" name="cdSign" disabled value="0" #if($btBankAccDtlPage.cdSign == 0)checked#end title="#springMessage('table.btBankAccDtl.cdSign.in')" lay-filter = "cdSign">
                            <input type="radio" name="cdSign" disabled value="1" #if($btBankAccDtlPage.cdSign == 1)checked#end title="#springMessage('table.btBankAccDtl.cdSign.out')" lay-filter = "cdSign">
						</div>
					</td>
					##币别ID
					<td class="textRight">#springMessage('table.btBankAccDtl.curName')</td>
    				<td >
                        <input type="text" id="curName" name="curName" class="layui-input" value="$!{btBankAccDtlPage.curName}"  readonly="readonly" >
					</td>
                    ##接口代码
                        <td class="textRight">#springMessage('table.btBankAccDtl.bifCode')</td>
                        <td >
                            <input type="text" id="bifName" name="bifName" class="layui-input" value="$!{btBankAccDtlPage.bifName}"  readonly="readonly" >
                        </td>
        		</tr>
				<tr>
					##交易金额
					<td class="textRight">#springMessage('table.btBankAccDtl.amt')</td>
    				<td >
						<input type="hidden" id="oldAmt" name="oldAmt" value="$!{btBankAccDtlPage.amt}">
                        <input type="text" id="amt" name="amt" data-name="amt" class="layui-input bt-input-inline  bt-biz-moneyType"style="text-align:right"
							   value="$!{btBankAccDtlPage.amt}" readonly="readonly"  >
					</td>
					##余额
					<td class="textRight">#springMessage('table.btBankAccDtl.bal')</td>
    				<td >
                        <input type="text" id="bal" name="bal" data-name="bal" data-biz-name="bal"  readonly="readonly" data-minus="true"
                               class="layui-input bt-input-inline bt-biz-moneyType" value="$!{btBankAccDtlPage.bal}">
					</td>
					##交易时间
					<td class="textRight">#springMessage('table.btBankAccDtl.transTime')</td>
    				<td >
                        <input type="text" name="transTime" data-name="transTime" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd HH:mm:ss',$!{btBankAccDtlPage.transTime})"
                                data-type="datetime" data-biz-name="transTime" readonly="readonly">
					</td>
        		</tr>
				<tr>
					##用途
					<td class="textRight">#springMessage('table.btBankAccDtl.uses')</td>
    				<td >
						<input type="text" id="uses" name="uses"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.uses')" value="$!{btBankAccDtlPage.uses}">
					</td>
					##项目信息
					<td class="textRight">#springMessage('table.btBankAccDtl.projectRemark')</td>
    				<td >
						<input type="text" id="projectRemark" name="projectRemark"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.projectRemark')" value="$!{btBankAccDtlPage.projectRemark}">
					</td>
					##银行流水号
					<td class="textRight">#springMessage('table.bisExc.bankSerialNo')</td>
					<td >
						<input type="text" id="bankSerialNo" name="bankSerialNo"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.bankSerialNo')" value="$!{btBankAccDtlPage.bankSerialNo}">
					</td>
        		</tr>
				<tr>
					##摘要
					<td class="textRight">#springMessage('table.btBankAccDtl.remark')</td>
    				<td colspan="5">
					  <textarea name="remark" id="remark" class="layui-textarea" autocomplete="off" >$!{btBankAccDtlPage.remark}</textarea>  	
					</td>
        		</tr>
				<tr>
					<td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit" >#springMessage('common.button.makeup.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form', 'layedit', 'moneyType', 'dateType', 'bank', 'externalCorpBankAcc'], function () {
        var $ = bt.jquery, form = bt.form();
        bt.dateType.init();
        bt.bank.init({elem: ".bank"});
		var externalCorpBankAcc = bt.externalCorpBankAcc.init();
		bt.externalCorpBankAccParams = function () {
			externalCorpBankAcc.set({
				"corpId": $("#corpId").val() ? $("#corpId").val() : "0",
				type: "2"
			});
			return true;
		}
		//供应商选择
		bt.externalCorpCallback = function (data, dom) {
			if (typeof data.netId === "undefined") {
				$("#oppAccNo").val(data.externalAcc);
				$("#oppAccName").val(data.name);
				$("#oppAccBank").val(data.bank);
			}else{
				$("#oppAccNo").val(data.bankAcc);
				$("#oppAccName").val(data.accName);
				$("#oppAccBank").val(data.bankName);
			}
		};
		// console.log("111111111111111111111");

        //监听提交
        form.on('submit(submit)', function (data) {
			console.log(data);
            bt.loading.show();
            var action = "/bankacc/bisaccdtl/modifyMakeup";
            $.post(basePath + action, data.field, function (result) {
                bt.loading.hide();
                layer.alert(result.msg, {icon: result.success ? 1 : 2}, function () {
                    layer.closeAll();
                    if (result.success) {
                        if(bt.navtab) {
                            bt.navtab.closeCurrent();
                        }else {
                            parent.layer ? parent.layer.closeAll() : layer.closeAll();
                        }
                    }
                });
            }, 'JSON');
            return false;
        });

        bt.moneyType.init();
    });
</script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{btBankAccCurPage.id}">
		<div class="layui-form-item">
        	<div class="layui-inline">
				##账号Id
                <label class="layui-form-label">#springMessage('table.btBankAccCur.bankAccId')</label>
        		<div class="layui-input-inline">
				<!--number-->
					<input type="text" id="bankAccId" name="bankAccId"
						   lay-verify="required"
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccCur.bankAccId')" value="$!{btBankAccCurPage.bankAccId}">
				                </div>
            </div>
        	<div class="layui-inline">
				##币别
                <label class="layui-form-label">#springMessage('table.btBankAccCur.cur')</label>
        		<div class="layui-input-inline">
				<!--number-->
					<input type="text" id="cur" name="cur"
						   
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccCur.cur')" value="$!{btBankAccCurPage.cur}">
				                </div>
            </div>
		</div>
		<div class="layui-form-item">
			<div class="layui-input-block">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccCur.edit.js?_btv=${resourceVersion}"></script>
</html>
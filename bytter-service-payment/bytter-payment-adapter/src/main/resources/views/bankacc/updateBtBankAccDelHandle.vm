<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input id="id" name="id" type="hidden" value="$!{btBankAccAppPage.id}">
    <input id="corpId"  type="hidden" value="$!{btBankAccAppPage.corpId}">
    <input id="busType" type="hidden" value="$!{busType}">
    <div id="print">
        <table class="layui-table layui-table-border">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.bankAcc')</td>
                <td width="30%">
                    $!{btBankAccAppPage.bankAcc}
                </td>
                <td class="textRight">#springMessage('table.btBankAccApp.accName')</td>
                <td width="30%">
                    $!{btBankAccAppPage.accName}
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.curId')</td>
                <td colspan="3">
                    $!{btBankAccAppPage.curName}
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.isDomesticBank')</td>
                <td>
                    $dictTag.get("btBankAcc.isDomesticBank",$!{btBankAccAppPage.isDomesticBank})
                </td>
                ##是否离岸账号
                <td class="textRight">#springMessage('table.btBankAccApp.isOffshoreAccount')</td>
                <td>$dictTag.get("sf_yn",${btBankAccAppPage.isOffshoreAccount})</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.corpId')</td>
                <td width="30%">
                    $!{btBankAccAppPage.corpName}
                </td>
                <td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
                <td>$!{btBankAccAppPage.bankTypeName}</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.bankCode')</td>
                <td>$!{btBankAccAppPage.bankCode}</td>
                <td class="textRight">#springMessage('table.btBankAccApp.bankName')</td>
                <td>$!{btBankAccAppPage.bankName}</td>
            </tr>
            #if($!{isDomesticBankType} == "1")
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.prov')</td>
                <td>$!{btBankAccAppPage.provName}</td>
                <td class="textRight">#springMessage('table.btBankAccApp.city')</td>
                <td>$!{btBankAccAppPage.cityName}</td>
            </tr>
            #end
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.attributeId')</td>
                <td>
                    $!{btBankAccAppPage.attributeName}
                </td>
                <td class="textRight">#springMessage('table.btBankAccApp.natureId')</td>
                <td>
                    $!{btBankAccAppPage.natureName}
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.accType')</td>
                <td>$dictTag.get("btBankAcc.accType",$!{btBankAccAppPage.accType})</td>
                <td class="textRight">单据类型</td>
                <td>
                    $!{btBankAccAppPage.receiptName}
                </td>
            </tr>
            <!-- 协定 -->
            #if($!{btBankAccAppPage.accType}=="07")
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.agrMoney')</td>
                <td>$!number.formatNumeric($!{btBankAccAppPage.agrMoney})</td>
                <td class="textRight">#springMessage('table.btBankAccApp.agrInterest')</td>
                <td>$!rateTag.show($!{btBankAccAppPage.agrInterest})</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.agrContract')</td>
                <td colspan="3">$!{btBankAccAppPage.agrContract}</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.agrBeginDate')</td>
                <td>$!date.format('yyyy-MM-dd',$!{btBankAccAppPage.agrBeginDate})</td>
                <td class="textRight">#springMessage('table.btBankAccApp.agrEndDate')</td>
                <td>$!date.format('yyyy-MM-dd',$!{btBankAccAppPage.agrEndDate})</td>
            </tr>
            #end
            <!-- 定期 -->
            #if($!{btBankAccAppPage.accType}=="02")
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.regulars')</td>
                <td colspan="3">$dictTag.get("btBankAcc.Term",$!{btBankAccAppPage.regulars})</td>
            </tr>
            #end
            <!-- 通知 -->
            #if($!{btBankAccAppPage.accType}=="06")
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.noticeType')</td>
                <td colspan="3">$dictTag.get("bankAcc.noticeType",$!{btBankAccAppPage.noticeType})</td>
            </tr>
            #end
            <!-- 票据专户 -->
            #if($!{btBankAccAppPage.accType}=="10")
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.electricBill')</td>
                <td>$!{btBankAccAppPage.electricBillName}</td>
                <td class="textRight">#springMessage('table.btBankAccApp.circulationMode')</td>
                <td>
                    $dictTag.get("bankAcc.circulationMode",$!{btBankAccAppPage.circulationMode})
                </td>
            </tr>
            #end
            <!-- 虚拟户 -->
            #if($!{btBankAccAppPage.accType}=="09")
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.entityAcc')</td>
                <td colspan="3">$!{btBankAcc.bankAcc}</td>
            </tr>
            #end
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.closeDate')</td>
                <td colspan="3">
                    <div class="layui-input-inline">
                        <input type="text" name="closeDate" lay-verify="required" class="layui-input bt-biz-dateType"
                               data-today="true" data-type="date" data-name="closeDate" data-biz-name="closeDate">
                    </div>
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.btBankAccApp.opRession')</td>
                <td>$!{btBankAccAppPage.opRession}</td>
                <td class="textRight">#springMessage('账户组')</td>
                <td>
                    <input type="hidden" name="fcAccGroupCode" id="fcAccGroupCode" value="$!{btBankAccAppPage.fcAccGroupCode}">
                    $!{btBankAccAppPage.fcAccGroupName}
                </td>
            </tr>
            <tr >
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.handle')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
    </div>
    <!-- 日志 -->
    <div id="tagMsg"></div>
    <!--附件上传 -->
    <input id="attachmentId" name="attachmentId" type="hidden" value="$!{btBankAccAppPage.attachmentId}">
    <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
    <p>
</form>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['btUpload', 'printType','mulselect', 'fcAccGroup','dateType','selectType'], function () {
        var $ = bt.jquery, form = bt.form();
        var fcAccGroup = bt.fcAccGroup.init();
        var selectType = bt.selectType.init();
        var mulselectType=bt.mulselect.init();
        var up = bt.btUpload.init({
            elem: "#uploader",
            auto: false,
            gid: $("#attachmentId").val()
        });
        bt.printType.init();
        bt.dateType.init();
        /**
         * 生成日志列表
         * @return
         */
            $genMsgHtml= function () {
            var url = basePath + "/bankacc/message/list/" + $('#id').val() + "/" + $('#busType').val();
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                }
            });
        }
            $genMsgHtml();

        //监听提交
        form.on('submit(submit)', function (data) {
            data.field.attachmentId = up.getGroupId();
            var action = "/bankacc/btbankaccdelhandle/modify";
            $.post(basePath + action, data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}, function () {
                    parent.layer.closeAll();
                    if (result.success) {
                        if(bt.navtab) {
                            bt.navtab.refreshParent();
                            bt.navtab.closeCurrent();
                        }else {
                            parent.layer ? parent.layer.closeAll() : layer.closeAll();
                        }
                    }
                })
            }, 'JSON');
            return false;
        });
        /**
         * 账户组维护查询选择回调
         * @param data
         * @param dom
         */

        receiptTypeCallback = function(code){

        }
    });
  function fcAccGroupCallback(selectedData) {
        console.log(selectedData);
        var ids = ''
        var names = ''
        bt.each(selectedData,function (i,item){
            ids += item.accGroupCode
            names += item.accGroupName
            if(i < (selectedData.length -1)){
                ids += ',';
                names += ','
            }
        })
        $("#fcAccGroupCode").val(ids)
        $("#fcAccGroupName").val(names)
    }
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
	    table td dl dd {
	      text-align:left;
	    }
    </style>
</head>
<body>
	<form class="layui-form" method="post" id="addBtBankAccDtl">
		<input type="hidden" id="id" name="id" value="$!{btBankAccDtlPage.id}">
		<input type="hidden" id="accNo" name="accNo" value="$!{btBankAccDtlPage.accNo}">
		<input type="hidden" id="corpId" name="corpId" value="$!{btBankAccDtlPage.corpId}">
        <input type="hidden" id="accId" name="accId" value="$!{btBankAccDtlPage.id}">
		<input type="hidden" id="orderNo" name="orderNo" value="$!{btBankAccDtlPage.orderNo}">
		<input type="hidden" id="createBy" name="createBy" value="$!{btBankAccDtlPage.createBy}">
		<input type="hidden" id="createDate" name="createDate" value="$!{btBankAccDtlPage.createDate}">
		<input type="hidden" id="updateBy" name="updateBy" value="$!{btBankAccDtlPage.updateBy}">
		<input type="hidden" id="updateDate" name="updateDate" value="$!{btBankAccDtlPage.updateDate}">
		<input type="hidden" id="rbSign" name="rbSign" value="2">
        <input type="hidden" name="soucebankBal" id="soucebankBal"/>
        <input type="hidden" name="adjustTransTime" id="adjustTransTime"/>
        <input type="hidden" name="adjustIds" id="adjustIds"/>
        <table class="layui-table">
            <tbody>
                <tr align="center">
                    <td><span style="color: red;margin-right: 3px;font-size: 18px;vertical-align: middle;">*</span>#springMessage('table.btBankAccDtl.bankAcc')</td>
                    <td><span style="color: red;margin-right: 3px;font-size: 18px;vertical-align: middle;">*</span>#springMessage('table.btBankAccDtl.accName')</td>
                    <td>#springMessage('table.btBankAccDtl.bankName')</td>
                    <td>#springMessage('table.btBankAccDtl.curName')</td>
                    <td>#springMessage('table.btBankAccDtl.bifCode')</td>
                    <td>#springMessage('table.btBankAccDtl.months')</td>
                </tr>
                <tr align="center">
                    ##本方账号
                    <td style="display:none;">acc</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" id="bankAcc" name="bankAcc" lay-verify="required|tableData" data-biz-name="accId"
                                   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.btBankAccDtl.bankAcc')">
                            <table id="bankAccTable" class="hide">
                                <thead>
                                <tr>
                                    <th>#springMessage('table.accountDTO.bankAcc')</th>
                                    <th>#springMessage('table.accountDTO.accName')</th>
                                    <th>#springMessage('table.accountDTO.bankName')</th>
                                    <th>#springMessage('table.accountDTO.curName')</th>
                                </tr>
                                </thead>
                            </table>
                        </div>
                    </td>
                    ##本方账户名
                    <td width="16%">
                        <input type="text" id="accName" name="accName" disabled
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.accName')">
                    </td>
                    ##本方账户开户行
                    <td width="16%">
                        <input type="text" id="bankName" name="bankName" disabled
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.bankName')">
                    </td>
                    ##币别ID
                    <td style="display:none;">#springMessage('table.btBankAccDtl.curId')</td>
                    <td width="16%">
                        <input type="hidden" id="curId" name="curId"
                               autocomplete="off" class="layui-input">
                        <input type="text" id="curName" name="curName" disabled
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.curName')">
                    </td>
                    ##接口代码
                    <td width="16%">
                        <input type="hidden" id="bifCode" name="bifCode" />
                        <input type="text" id="bifName" name="bifName" disabled
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.bifCode')">
                    </td>
                    ##月份
                    <td style="display:none;">month</td>
                    <td width="16%">
                        <div class="bt-biz-dict" data-type="select" data-group="btBankAccDtl.months" data-defaultvalue="$!{month}" data-name="months" data-biz-name="months" data-callback="onChangeMonths" data-required="true"></div>
                    </td>
                </tr>
            </tbody>
        </table>
        <table class="layui-table">
            <tbody >
            <tr>
                <td colspan="5">
                    <span style="color:red;">#springMessage('table.btBankAccDtl.Reminder')</span>
                </td>
            </tr>
                <tr align="center">
                    <td><span style="color: red;margin-right: 3px;font-size: 18px;vertical-align: middle;">*</span>#springMessage('table.btBankAccDtl.transTime')</td>
                    <td>#springMessage('table.btBankAccDtl.cdSign')</td>
                    <td><span style="color: red;margin-right: 3px;font-size: 18px;vertical-align: middle;">*</span>#springMessage('table.btBankAccDtl.amt')</td>
                    <td>#springMessage('table.btBankAccDtl.bal')</td>
                    <td>#springMessage('table.btBankAccDtl.uses')</td>
                </tr>
                <tr align="center">
                    ##交易时间
                    <td>
                         <div class="layui-input-inline">
                            <input type="text" name="transTime" data-name="transTime" class="layui-input bt-biz-dateType" data-max="$!{sysDate}"
                                data-today="true" data-type="datetime" data-biz-name="transTime" data-callback="transTimeCallback" lay-verify="required">
                        </div>
                    </td>
                    ##借贷标志 0-收 1-支
                    <td>
                        <div class="layui-input-inline">
                            <input type="radio" name="cdSign" value="0" checked title="#springMessage('table.btBankAccDtl.cdSign.in')" lay-filter = "cdSign">
                            <input type="radio" name="cdSign" value="1" title="#springMessage('table.btBankAccDtl.cdSign.out')" lay-filter = "cdSign">
                        </div>
                    </td>
                    <td style="display:none;">amt</td>
                    ##交易金额
                    <td>
                        <input type="text" id="amt" data-name="amt" data-biz-name="amt" class="layui-input bt-input-inline bt-biz-moneyType"style="text-align:right" data-minus="true"
                               lay-verify="required" placeholder="#springMessage('table.btBankAccDtl.amt')"  data-callback="amtCallback">
                    </td>
                    ##余额
                    <td style="display:none;">bal</td>
                    <td>
                        <input type="text" id="bal" name="bal" data-name="bal" data-biz-name="bal" data-minus="true"
                               class="layui-input bt-input-inline bt-biz-moneyType" style="text-align:right" lay-verify="required" placeholder="#springMessage('table.btBankAccDtl.bal')">
                    </td>
                    ##用途
                    <td>
                        <input type="text" id="uses" name="uses"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.uses')">
                    </td>
                </tr>
            <tr align="center">
                <td>#springMessage('table.btBankAccDtl.oppAccNo')</td>
                <td>#springMessage('table.btBankAccDtl.oppAccName')</td>
                <td>#springMessage('table.btBankAccDtl.oppAccBank')</td>
                <td>#springMessage('table.btBankAccDtl.remark')</td>
                <td>#springMessage('table.btBankAccDtl.projectRemark')</td>
            </tr>
            <tr align="center">
                ##对方账号
                <td>
                    <input type="text" id="oppAccNo" name="oppAccNo" lay-verify="langKey"
                           autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.btBankAccDtl.oppAccNo')">
                </td>
                ##对方账户名
                <td>
                    <input type="text" id="oppAccName" name="oppAccName"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.oppAccName')">
                </td>
                ##对方账户开户行
                <td>
                    <input type="text" id="oppAccBank" name="oppAccBank"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.oppAccBank')">
                </td>
                ##摘要
                <td>
                    <input type="text" id="remark" name="remark"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.remark')">
                </td>
                ##项目信息
                <td>
                    <input type="text" id="projectRemark" name="projectRemark"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.projectRemark')">
                </td>
            </tr>
            <tr align="center">
                ##银行流水号
                <td>#springMessage('table.bisExc.bankSerialNo')</td>
                ##排序
                <td>#springMessage('common.message.sort')</td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr align="center">
                ##银行流水号
                <td>
                    <input type="text" id="bankSerialNo" name="bankSerialNo" lay-verify="langKey"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisExc.bankSerialNo')">
                </td>
                ##排序
                <td>
                    <input type="text" id="orderNo" name="orderNo"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('common.message.sort')">
                </td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td style="text-align: center;" colspan="5">
                    <button class="layui-btn" lay-submit="" lay-filter="temp" value="0">#springMessage('common.button.temp')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
##                    <button type="button" class="layui-btn " onclick="onAdjust()">#springMessage('common.button.adjust')</button>
                </td>
            </tr>
            </tbody>
        </table>
        <table class="layui-table" id="btBankAccDtlInfo">
            <thead >
                <tr class="title">
                    <th>#springMessage('common.table.thead.operation')</th>
                    <th>#springMessage('table.btBankAccDtl.orderNo')</th>
                    <th>#springMessage('table.btBankAccDtl.amt')</th>
                    <th>#springMessage('table.btBankAccDtl.bal')</th>
                    <th>#springMessage('table.btBankAccDtl.transTime')</th>
                    <th>#springMessage('table.btBankAccDtl.cdSign')</th>
                    <th>#springMessage('table.bisExc.bankSerialNo')</th>
                    <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
                    <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
                    <th>#springMessage('table.btBankAccDtl.oppAccBank')</th>
                    <th>#springMessage('table.btBankAccDtl.accNo')</th>
                </tr>
            </thead>
        </table>
        <table class="layui-table">
            <thead>
                <tr style="display:none;" id="submitButtonTR">
                    <td style="text-align: center;">
                        <button type="button" class="layui-btn" onclick="onSubmit()">#springMessage('common.button.submit')</button>
                        <button type="button" class="layui-btn" onclick="onCheckAll()">#springMessage('common.check.all')</button>
                        <button type="button" class="layui-btn" onclick="onUnCheckAll()">#springMessage('common.check.unAll')</button>
                    </td>
                </tr>
            </thead>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccDtl.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        .col-error{
            color: #ff0000;

        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="ids" value="$!{ids}">
    <table class="layui-table">
        <tbody>
        <tr>
            ##交易状态
            <td class="textRight">#springMessage('table.nisBillhead.updateMsg')</td>
            <td>
                <input type="text"  class="layui-input" id="updateMsg" name="updateMsg" value=""/>
            </td>
        </tr>
        </tbody>
    </table>
    <div style="text-align: center;height: 40px;position: absolute;bottom: 0;width: calc(100% - 20px)">
        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
        <button class="layui-btn" type="button" id="buttonCancel" onclick="doClose()">#springMessage("common.button.cancel")</button>##取消
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','dicts',], function(){
        var $ = bt.jquery,form = bt.form();
        form.on('submit(submit)', function(data){
            var ids = $("#ids").val();
            var updateMsg = $("#updateMsg").val();
            $.post(basePath + "/netbank/nisbillhead/updateReturnMsg", {
                ids: ids,updateMsg: updateMsg
            }, function (result) {
                bt.navtab.refreshCurrentTable();
                parent.layer ? parent.layer.closeAll() : layer.closeAll();
                parent.layer.msg(result.msg, {icon: result.success ? 1 : 2})
            }, 'JSON');
            return false;
        });
    });

    //关闭窗口
    function doClose() {
        parent.layer?parent.layer.closeAll():layer.closeAll();
    }
</script>

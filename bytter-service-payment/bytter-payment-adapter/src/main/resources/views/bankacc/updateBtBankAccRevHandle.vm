<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .cks {
            max-height: 60px;
            overflow-y: auto;
            transition: max-height 0.3s ease;
        }
        .cks.expanded {
            max-height: 500px;
        }
        .currency-expand-btn {
            text-align: left;
        }
        .currency-expand-btn a {
            color: #1E9FFF;
            font-size: 12px;
            cursor: pointer;
            user-select: none;
        }
        .currency-expand-btn a:hover {
            color: #007DDB;
        }
        .currency-expand-btn .layui-icon {
            font-size: 12px;
            margin-right: 3px;
            transition: transform 0.3s ease;
        }
        .currency-expand-btn.expanded .layui-icon {
            transform: rotate(180deg);
        }
        .cks .layui-form-checkbox {
            width: 15%!important;
            text-align: left!important;
        }
        .cks .layui-form-checkbox span{
            position: absolute;
            left: 16px;
        }
    </style>
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{btBankAccPage.id}">
		<input id="appId" name="appId" type="hidden" value="$!{appId}">
		<input id="status" name="status" type="hidden" value="$!{btBankAccPage.status}">
		<input id="createBy" name="createBy" type="hidden" value="$!{btBankAccPage.createBy}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{btBankAccPage.updateBy}">
		<input id="prov" name="prov" type="hidden" value="$!{btBankAccPage.prov}">
		<input id="city" name="city" type="hidden" value="$!{btBankAccPage.city}">
        <input id="regularsTemp" name="regularsTemp" type="hidden" value="$!{btBankAccPage.regulars}">
        <input id="noticeTypeTemp" name="noticeTypeTemp" type="hidden" value="$!{btBankAccPage.noticeType}">
        <input id="agrMoneyTemp" name="agrMoneyTemp" type="hidden" value="$!{btBankAccPage.agrMoney}">
        <input id="agrContractTemp" name="agrContractTemp" type="hidden" value="$!{btBankAccPage.agrContract}">
        <input id="agrInterestTemp" name="agrInterestTemp" type="hidden" value="$!{btBankAccPage.agrInterest}">
        <input id="agrBeginDateTemp" name="agrBeginDateTemp" type="hidden" value="$!{btBankAccPage.agrBeginDate}">
        <input id="agrEndDateTemp" name="agrEndDateTemp" type="hidden" value="$!{btBankAccPage.agrEndDate}">
        <input id="circulationModeTemp"  type="hidden" value="$!{btBankAccPage.circulationMode}">
        <input id="electricBill" name="electricBill" type="hidden" value="$!{btBankAccPage.electricBill}">
        <input id="entityAccId"  type="hidden" value="$!{btBankAccPage.entityAccId}">
        <input id="corpId" type="hidden" value="$!{btBankAccPage.corpId}">
    	<table class="layui-table breakRow">
            <tbody>
                <tr>
    				##银行账号
                    <td class="textRight">#springMessage('table.btBankAcc.bankAcc')</td>
            		<td width="40%">
            			<input type="text" id="bankAcc" name="bankAcc" lay-verify="required" readonly="readonly"
    					 	autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankAcc')" value="$!{btBankAccPage.bankAcc}">
    				</td>
    				##账户名称
                    <td class="textRight">#springMessage('table.btBankAcc.accName')</td>
            		<td width="40%">
    					<input type="text" id="accName" name="accName" lay-verify="required"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.accName')" value="$!{btBankAccPage.accName}">
    				</td>
    			</tr>
				##币别
                <tr>
                    <td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAccApp.curId')</td>
                    <td colspan="3">
                        <input type="hidden" name="curId" id="curId" data-required="true" value="$!{curId}"/>
                        <div class="cks" data-biz-name="cur"></div>
                        <div class="currency-expand-btn" style="margin-top: 5px;">
                            <a href="javascript:void(0);" id="toggleCurrencyBtn" onclick="toggleCurrencyList()">
                                <i class="layui-icon layui-icon-down"></i>
                                <span id="toggleCurrencyText">查看更多</span>
                            </a>
                        </div>
                    </td>
                </tr>
                <tr>
                    ##境内/境外账号
                    <td class="textRight">#springMessage('table.btBankAccApp.isDomesticBank')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="btBankAcc.isDomesticBank" data-required="true"
                             data-defaultvalue="$!{btBankAccPage.isDomesticBank}" data-name="isDomesticBank" data-biz-name="isDomesticBank"></div>
                    </td>
                    ##是否离岸账号
                    <td class="textRight">#springMessage('table.btBankAccApp.isOffshoreAccount')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                             data-defaultvalue="$!{btBankAccPage.isOffshoreAccount}" data-name="isOffshoreAccount" data-biz-name="isOffshoreAccount"></div>
                    </td>
                </tr>
    			<tr>
    				##单位ID
					<td class="textRight"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAcc.corpId')</td>
            		<td>
                		<div class="layui-input-inline">
                			<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-name="corpId"
                            data-scope="all" data-resource="netbank:bankAcc:btBankAccRevHandle:apply"
							data-required="true" data-biz-name="corpId" data-callback = "bt.corpCallback"
                        	data-defaultvalue="$!{btBankAccPage.corpId}"></div>
                        </div>
                    </td>
                    ##银行类别
                    <td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
                    <td>
                        <div data-name="bankTypeId" class="bt-biz-selectType"
                             data-url="${basePath}/basic/business/btbanktype/json"
                             data-valueField="id"
                             data-biz-name="bankTypeId"
                             data-textField="typeName"
                             data-required="true"
                             data-search="true"
                             data-extraData="false"
                             data-defaultvalue="$!{btBankAccPage.bankTypeId}"
                             data-callback="bt.bankTypeCallback"></div>
                    </td>
                </tr>
                <tr>
                    ##开户行行号
                    <td class="textRight">#springMessage('table.btBankAcc.bankCode')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" id="bankCode" name="bankCode" lay-verify="required"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankCode')" value="$!{btBankAccPage.bankCode}" readonly="readonly">
                            #if($!{isDomesticBankType} == "1")
                                ##境外
                                <div class="bt-div-search isSwiftY" style="display:none">
                                    <button class="bt-biz-swiftInfo" id="selPayeeBankBut" type="button"  data-callback="bt.swiftInfoCallback" data-beforeClick="bt.bankInfoBeforeClick" title="#springMessage('common.button.select')">
                                        <i class="layui-icon">&#xe615;</i>
                                    </button>
                                </div>
                                ##境内
                                <div class="bt-div-search isSwiftN">
                                    <button class="bt-biz-bankInfo" type="button"  data-callback="bt.bankinfoCallback" data-beforeClick="bt.bankInfoBeforeClick" title="#springMessage('common.button.bank')">
                                        <i class="layui-icon">&#xe615;</i>
                                    </button>
                                </div>
                            #else
                                ##境外
                                <div class="bt-div-search isSwiftY">
                                    <button class="bt-biz-swiftInfo" id="selPayeeBankBut" type="button"  data-callback="bt.swiftInfoCallback" title="#springMessage('common.button.select')">
                                        <i class="layui-icon">&#xe615;</i>
                                    </button>
                                </div>
                                ##境内
                                <div class="bt-div-search isSwiftN" style="display:none">
                                    <button class="bt-biz-bankInfo" type="button"  data-callback="bt.bankinfoCallback" data-beforeClick="bt.bankInfoBeforeClick" title="#springMessage('common.button.bank')">
                                        <i class="layui-icon">&#xe615;</i>
                                    </button>
                                </div>
                            #end
                        </div>
                    </td>
                ##开户行名称
                    <td class="textRight">#springMessage('table.btBankAcc.bankName')</td>
                    <td>
                            <input type="text" id="bankName" name="bankName" lay-verify="required" readonly="readonly"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankName')" value="$!{btBankAccPage.bankName}">
                    </td>
                </tr>
                <tr>
				##账户性质
                    <td class="textRight">#springMessage('table.btBankAcc.natureId')</td>
                    <td>
                        <div type="list" field="natureId" fieldHref="${basePath}/bankacc/btaccnature/json" dictField="id" dictText="natureName" data-required="true" defaultVal="$!{btBankAccPage.natureId}"></div>
                    </td>
				##账户属性
                    <td class="textRight">#springMessage('table.btBankAcc.attributeId')</td>
                    <td>
                        <div type="list" field="attributeId" fieldHref="${basePath}/bankacc/bisaccattribute/json" dictField="id" dictText="attributeName" data-required="true" defaultVal="$!{btBankAccPage.attributeId}"></div>
                    </td>
                </tr>
                <tr class="tp">
				##账户类别
                    <td class="textRight">#springMessage('table.btBankAcc.accType')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="btBankAcc.accType" data-required="true"
                             data-defaultvalue="$!{btBankAccPage.accType}" data-name="accType" data-biz-name="accType" data-callback="bt.chang"></div>
                    </td>
                    <td align="right" class="type"></td>
                    <td class="typeText"></td>
                </tr>
                <tr>
				##接口代码
                    <td class="textRight">#springMessage('table.btBankAcc.bifCode')</td>
                    <td>
                        <div data-name="bifCode" class="bt-biz-selectType"
                             data-url="${basePath}/basic/business/bisbifinit/getByBankType/$!{btBankAccPage.bankTypeId}"
                             data-valueField="id"
                             data-biz-name="bifCode"
                             data-textField="name"
                             data-required="true"
                             data-search="true"
                             data-extraData="false"
                             data-callback="bt.isOnlineHandleCallback"
                             data-defaultvalue="$!{btBankAccPage.bifCode}"></div>
                    </td>
				##是否资金池账号
                    <td class="textRight">#springMessage('table.btBankAcc.isCapitalPool')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{btBankAccPage.isCapitalPool}" data-name="isCapitalPool" data-biz-name="isCapitalPool"></div>
                    </td>
                </tr>
                <tr>
				##开户日期
                    <td class="textRight">#springMessage('table.btBankAcc.regDate')</td>
                    <td>
					##<div type="date" field="regDate" lay-verify="required" defaultVal="$!{btBankAccPage.regDate}"></div>
                        <input type="text" name="regDate" class="layui-input bt-biz-dateType" lay-verify="required"  value="$!date.format('yyyy-MM-dd',$!{btBankAccPage.regDate})" data-min="$!{todate}">
                    </td>
				##是否上线
                    <td class="textRight">#springMessage('table.btBankAcc.isOnline')</td>
                    <td>
					##                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{btBankAccPage.isOnline}" data-name="isOnline" data-biz-name="isOnline" lay-filter = "isOnline"></div>
                        <input type="radio" name="isOnline" value="1" #if($btBankAccPage.isOnline == 1)checked#end title="#springMessage('nis.sc_yn.yes')" lay-filter = "isOnline">
                        <input type="radio" name="isOnline" value="0" #if($btBankAccPage.isOnline == 0)checked#end title="#springMessage('nis.sc_yn.no')" lay-filter = "isOnline">
                    </td>
                </tr>
                <tr>
				##是否有效
                    <td class="textRight">#springMessage('table.btBankAcc.validSign')</td>
                    <td >
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{btBankAccPage.validSign}" data-name="validSign" data-biz-name="validSign"></div>
                    </td>
                ##到期日期
                    <td class="textRight">#springMessage('table.btBankAcc.endDate')</td>
                    <td>
                        <input type="text" name="endDate" class="layui-input bt-biz-dateType" autocomplete="off" value="$!date.format('yyyy-MM-dd',$!{btBankAccPage.endDate})">
                    </td>
                </tr>
                <tr>
				##备注
                    <td class="textRight">#springMessage('table.btBankAcc.rmk')</td>
                    <td colspan="3">
                        <input type="text" id="rmk" name="rmk" value="$!{btBankAccPage.rmk}"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.rmk')">
                    </td>
                </tr>
				##				<tr>
				##
				##    				##是否查询余额或明细
				##                    <td class="textRight">#springMessage('table.btBankAcc.scanFlag')</td>
				##    				<td>
				##                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{btBankAccPage.scanFlag}" data-name="scanFlag" data-biz-name="scanFlag"></div>
				##    				</td>
				##				</tr>
                <tr>
                    ##是否线上办理
                    <td class="textRight">#springMessage('table.btBankAcc.isOnlineHandle')</td>
                    <td>
                        <input id="dataListSize" name="dataListSize" type="hidden" value="$!{dataListSize}">
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{btBankAccPage.isOnlineHandle}"
                             data-callback="bt.isOnlineHandleCallback"
                             data-name="isOnlineHandle" data-biz-name="isOnlineHandle"></div>
                    </td>
                    <td></td>
                </tr>
                <tr>
                    <td class="textRight">账号用途</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-mulselectType" data-url="${basePath}/netbank/bankAccUse/json" data-method="get"
                                 data-valuefield="useCode" data-textfield="useName" data-inputvalue="inputvalue"
                                 data-name="accUseCode" data-biz-name="accUseCode"  data-search="true" data-defaultvalue="$!{btBankAccPage.accUseCode}"
                                 onfocusout="validateAccUseCode(this)" ></div>
                        </div>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
        </table>
        ##招行 虚拟户 线上办理
        #if($!{btBankAccPage.accType} == "09" && $!{btBankAccPage.isOnlineHandle} == "1" && $!{btBankAccPage.bifCode}=="402880385c20008b015c2025c382001d")
        <div id="virtualTag" class="layui-input-inline">
        #else
        <div id="virtualTag" class="layui-input-inline ignore-required-hide" style="display: none">
        #end
            <table id="virtualTable" class="layui-table layui-form table-border" style="width:100%;" >
                <thead>
                <tr>
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAccVirtual.virtualNo')</th>
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAccVirtual.virtualName')</th>
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAccVirtual.bankCode')</th>
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAccVirtual.overCtrl')</th>
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAccVirtual.closeType')</th>
                    <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btBankAccVirtual.backType')</th>
                    <th>#springMessage('common.table.thead.operation')</th>
                </tr>
                </thead>
                <tbody class="ignore-required-icon layui-form">
                    #foreach($virtual in $listVirtual)
                        #set($rowMR=$math.sub($velocityCount,1))
                    <tr row="$!{rowMR}">
                        <td>
                            $!{virtual.virtualNo}<input type="hidden" name="bankAccVirtual[$!{rowMR}].virtualNo" lay-verify="required|strlength" data-maxlength="10" value="$!{virtual.virtualNo}" readonly="readonly">
                        </td>
                        <td>
                            <input type="text" name="bankAccVirtual[$!{rowMR}].virtualName" lay-verify="required|strlength" data-maxlength="20" value="$!{virtual.virtualName}">
                        </td>
                        <td>
                            <div class="bt-biz-dict" data-type="select" data-group="btBankAccVirtual.bankCode" data-defaultvalue="$!{virtual.bankCode}" data-name="bankAccVirtual[$!{rowMR}].bankCode" data-biz-name="bankCode$!{rowMR}" data-required="true"></div>
                        </td>
                        <td>
                            <div class="bt-biz-dict" data-type="select" data-group="btBankAccVirtual.overCtrl" data-defaultvalue="$!{virtual.overCtrl}" data-name="bankAccVirtual[$!{rowMR}].overCtrl" data-biz-name="overCtrl$!{rowMR}" data-required="true"></div>
                        </td>
                        <td>
                            <div class="bt-biz-dict" data-type="select" data-group="btBankAccVirtual.closeType" data-defaultvalue="$!{virtual.closeType}" data-name="bankAccVirtual[$!{rowMR}].closeType" data-biz-name="closeType$!{rowMR}" data-required="true"></div>
                        </td>
                        <td>
                            <div class="bt-biz-dict" data-type="select" data-group="btBankAccVirtual.backType" data-defaultvalue="$!{virtual.backType}" data-name="bankAccVirtual[$!{rowMR}].backType" data-biz-name="backType$!{rowMR}" data-required="true"></div>
                        </td>
                        <td>
                            #if($rowMR > 0)
                                <a href="javascript:void(0)" data-type="del" class="tableElema">#springMessage('common.button.delete')</a>
                            #end
                        </td>
                    </tr>
                    #end
                <tr id="sumTr" style="display: none">
                    <td colspan="6"></td>
                </tr>
                </tbody>
            </table>
        </div>
        <div onclick="divclick();" style="text-align: center">
            <i class="layui-icon" style="margin-right: 10px" id="otherInfoIcon">&#xe602;</i>#springMessage('cms.loan.OtherInfo')
        </div>
        <div id="otherInfo" style="display: none">
            <table class="layui-table">
                <tbody>
                <tr>
				##利率
                    <td class="textRight" width="150">#springMessage('table.btBankAcc.rates')</td>
                    <td>
                        <input type="text" data-name="rates" class="layui-input bt-biz-rateType"
                               placeholder="#springMessage('table.btBankAcc.rates')" value="$!{btBankAccPage.rates}">
                    </td>
				##对私编号
                    <td class="textRight">#springMessage('table.btBankAcc.privateNo')</td>
                    <td>
                        <input type="text" id="privateNo" name="privateNo"
                               autocomplete="off" class="layui-input inlineblock" placeholder="#springMessage('table.btBankAcc.privateNo')" value="$!{btBankAccPage.privateNo}">
                        <div class="inlineblock">(#springMessage("table.btBankAcc.privateNo.rmk"))</div>
                    </td>
                </tr>
                <tr>
				##利率是否浮动
                    <td class="textRight">#springMessage('table.btBankAcc.ratesFloat')</td>
                    <td>
                        <input type="radio" name="ratesFloat" value="0" #if($btBankAccPage.ratesFloat == 0)checked#end title="#springMessage('common.sc_yn.no')" lay-filter = "ratesFloat">
                        <input type="radio" name="ratesFloat" value="1" #if($btBankAccPage.ratesFloat == 1)checked#end title="#springMessage('common.sc_yn.yes')" lay-filter = "ratesFloat">
                    </td>
				##浮动百分比
                    <td class="textRight">#springMessage('table.btBankAcc.ratesFloatPer')</td>
                    <td>
                        <input type="text" data-name="ratesFloatPer" data-biz-name="ratesFloatPer" class="layui-input bt-biz-rateType" data-decimal="2" disabled
                               placeholder="#springMessage('table.btBankAcc.ratesFloatPer')" value="$!{btBankAccPage.ratesFloatPer}">
                    </td>
                </tr>
                <tr>
				##计息周期
                    <td class="textRight">#springMessage('table.btBankAcc.interestCycle')</td>
                    <td>
                        <input type="radio" name="interestCycle" value="1" #if($btBankAccPage.interestCycle == 1)checked#end title="#springMessage('table.btBankAcc.interestCycle.month')" lay-filter = "interestCycle">
                        <input type="radio" name="interestCycle" value="0" #if($btBankAccPage.interestCycle == 0)checked#end title="#springMessage('table.btBankAcc.interestCycle.season')" lay-filter = "interestCycle">
                    </td>
				##计息日
                    <td class="textRight">#springMessage('table.btBankAcc.interestDate')</td>
                    <td>
                        <div class="layui-inline" id="interestDateDiv">
                            <div class="bt-biz-dict" data-type="select" data-group="btBankAcc.interestDate"
                                 data-defaultvalue="$!{btBankAccPage.interestDate}" data-name="interestDate" data-biz-name="interestDate">
                            </div>
                        </div>
                    </td>
                </tr>
                <tr style="display: none">
				##余额初始日期
                    <td class="textRight">#springMessage('table.btBankAcc.initBalanceDate')</td>
                    <td>
					##    					<div type="date" field="initBalanceDate" defaultVal="$!{btBankAccPage.initBalanceDate}"></div>
                        <input type="text" name="initBalanceDate" class="layui-input bt-biz-dateType"  value="$!date.format('yyyy-MM-dd',$!{btBankAccPage.initBalanceDate})" data-min="$!{todate}">
                    </td>
				##初始余额
                    <td class="textRight">#springMessage('table.btBankAcc.initBalance')</td>
                    <td>
                        <input type="text" data-id="initBalance" name="initBalance" decimal="2" style="text-align:right"
                               autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.btBankAcc.initBalance')" value="$!{btBankAccPage.initBalance}">
                    </td>
                </tr>
                <tr>
				##本册笔号
                    <td class="textRight">#springMessage('table.btBankAcc.volumeNum')</td>
                    <td>
                        <input type="text" id="volumeNum" name="volumeNum"
                               autocomplete="off" class="layui-input inlineblock" placeholder="#springMessage('table.btBankAcc.volumeNum')" value="$!{btBankAccPage.volumeNum}">
                        <div class="inlineblock">(#springMessage("table.btBankAcc.bankbookNum.rmk"))</div>
                    </td>
				##存则册号
                    <td class="textRight">#springMessage('table.btBankAcc.bankbookNum')</td>
                    <td>
                        <input type="text" id="bankbookNum" name="bankbookNum"
                               autocomplete="off" class="layui-input inlineblock" placeholder="#springMessage('table.btBankAcc.bankbookNum')" value="$!{btBankAccPage.bankbookNum}">
                        <div class="inlineblock">(#springMessage("table.btBankAcc.bankbookNum.rmk"))</div>
                    </td>
                </tr>
                <tr>
                ##银行组织机构代码
                    <td class="textRight">#springMessage('table.btBankAcc.bankOrgCode')</td>
                    <td>
                        <input type="text" id="bankOrgCode" name="bankOrgCode" lay-verify="strlength" data-maxlength="20"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankOrgCode')" value="$!{btBankAccPage.bankOrgCode}">
                    </td>
                    ## 是否启用限额管理
                    <td class="textRight">#springMessage('table.sysCorp.enable.limit')</td>
                    <td>
                        <input type="checkbox" #if($btBankAccPage.isLimitQuota==1) checked #end name="isLimitQuota" lay-filter="limit" lay-skin="switch" lay-text="YES|NO">
                    </td>
                </tr>
                <tr class="limit" #if($btBankAccPage.isLimitQuota!=1) style="display: none" #end >
                    ## 日累计支付限额
                    <td class="textRight">#springMessage('table.sysCorp.day.limit')</td>
                    <td>
                        <input type="text" name="dayLimitQuota" autocomplete="off" class="layui-input bt-biz-moneyType"
                               data-moneyendid="t20" placeholder="#springMessage('table.sysCorp.day.limit')" value="$!{btBankAccPage.dayLimitQuota}">
                    </td>
                    ## 月累计支付限额
                    <td class="textRight">#springMessage('table.sysCorp.month.limit')</td>
                    <td>
                        <input type="text" name="monthLimitQuota" autocomplete="off" class="layui-input bt-biz-moneyType"
                               data-moneyendid="t20" placeholder="#springMessage('table.sysCorp.month.limit')" value="$!{btBankAccPage.monthLimitQuota}">
                    </td>
                </tr>
                <tr class="limit" #if($btBankAccPage.isLimitQuota!=1) style="display: none" #end >
                    ## 单笔支付限额
                    <td class="textRight">#springMessage('table.sysCorp.pay.limit')</td>
                    <td>
                        <input type="text" name="payLimitQuota" autocomplete="off" class="layui-input bt-biz-moneyType"
                               data-moneyendid="t20" placeholder="#springMessage('table.sysCorp.pay.limit')" value="$!{btBankAccPage.payLimitQuota}">
                    </td>
                    <td></td>
                    <td></td>
                    ## 透支额度
##                    <td class="textRight">#springMessage('table.sysCorp.over.limit')</td>
##                    <td>
##                        <input type="text" name="overLimitQuota" autocomplete="off" class="layui-input bt-biz-moneyType"
##                               data-moneyendid="t20" placeholder="#springMessage('table.sysCorp.over.limit')" value="$!{btBankAccPage.overLimitQuota}">
##                    </td>
                </tr>
                <tr>
                    ##印鉴
                    <td class="textRight">#springMessage('table.btBankAcc.seal')</td>
                    <td id="updiv" colspan="3">
                        #foreach( $elem in $vo.sealDirectoryList)
                            #set( $num = $velocityCount - 1 )
                            #if($elem)
                                <img id="imger$velocityCount" style="width:100px;height:100px" src="$!{basePath}/download/attachment?id=$elem" />
                                <input id="sealDirectory$velocityCount" type="hidden" name="sealDirectoryList[$num]" value="$elem">
                            #else
                                <img id="imger$velocityCount" style="width:100px;height:100px" />
                                <input id="sealDirectory$velocityCount" type="hidden" name="sealDirectoryList[$num]">
                            #end
                            <input type="file" id="seal$velocityCount" lay-ext="jpg|png|gif" name="seal$velocityCount" class="layui-upload-file">
                            #if($velocityCount == 3)
                                <font color=red>#springMessage('netbank.input.img.desc')</font>
                            #end
                        #end
                    </td>
                </tr>
                <tr>
                    ##预留印鉴联系人
                    <td class="textRight">#springMessage('table.btBankAcc.seal.person')</td>
                    <td>
                        <input type="text" name="sealPerson" lay-verify="strlength" data-maxlength="30"
                               autocomplete="off" class="layui-input" value="$!{btBankAccPage.sealPerson}"
                               placeholder="#springMessage('table.btBankAcc.seal.person')">
                    </td>
                    <td class="textRight">#springMessage('table.btBankAcc.seal.phone')</td>
                    <td>
                        <input type="text" name="sealPhone" lay-verify="strlength" data-maxlength="30"
                               autocomplete="off" class="layui-input" value="$!{btBankAccPage.sealPhone}"
                               placeholder="#springMessage('table.btBankAcc.seal.phone')">
                    </td>
                </tr>
                <tr>
                    <td class="textRight">#springMessage('table.btBankAcc.seal.email')</td>
                    <td>
                        <input type="text" name="sealEmail" lay-verify="strlength|emailFormat"
                               autocomplete="off" class="layui-input" value="$!{btBankAccPage.sealEmail}"
                               placeholder="#springMessage('table.btBankAcc.seal.email')">
                    </td>
                    <td class="textRight">#springMessage('table.btBankAcc.account.management.department')</td>
                    <td>
                        <input type="text" name="mgtDepartment" lay-verify="strlength" data-maxlength="30"
                               autocomplete="off" class="layui-input" value="$!{btBankAccPage.mgtDepartment}"
                               placeholder="#springMessage('table.btBankAcc.account.management.department')">
                    </td>
                </tr>

                <tr>
                    ## 网银管理员
                    <td class="textRight">#springMessage('table.bankacc.ukey.uKeyAdmin')</td>
                    <td>
                        <input type="text" name="uKeyAdmin" autocomplete="off" class="layui-input" value="$!{btBankAccPage.uKeyAdmin}"
                               placeholder="#springMessage('table.bankacc.ukey.uKeyAdmin')">
                    </td>
                    ## 网银操作员
                    <td class="textRight">#springMessage('table.bankacc.ukey.uKeyOperator')</td>
                    <td>
                        <input type="text" name="uKeyOperator" autocomplete="off" class="layui-input" value="$!{btBankAccPage.uKeyOperator}"
                               placeholder="#springMessage('table.bankacc.ukey.uKeyOperator')">
                    </td>
                </tr>
                <tr>
                    ## 网银复核员1
                    <td class="textRight">#springMessage('table.bankacc.ukey.uKeyReviewers1')</td>
                    <td>
                        <input type="text" name="uKeyReviewers1" autocomplete="off" class="layui-input" value="$!{btBankAccPage.uKeyReviewers1}"
                               placeholder="#springMessage('table.bankacc.ukey.format')">
                    </td>
                    ## 网银复核员2
                    <td class="textRight">#springMessage('table.bankacc.ukey.uKeyReviewers2')</td>
                    <td>
                        <input type="text" name="uKeyReviewers2" autocomplete="off" class="layui-input" value="$!{btBankAccPage.uKeyReviewers2}"
                               placeholder="#springMessage('table.bankacc.ukey.format')">
                    </td>
                </tr>
                <tr>
                    ## 网银复核员3
                    <td class="textRight">#springMessage('table.bankacc.ukey.uKeyReviewers3')</td>
                    <td>
                        <input type="text" name="uKeyReviewers3" autocomplete="off" class="layui-input" value="$!{btBankAccPage.uKeyReviewers3}"
                               placeholder="#springMessage('table.bankacc.ukey.format')">
                    </td>
                    <td></td>
                    <td></td>
                </tr>
                    ##网银功能
                <tr>
                    <td class="textRight" rowspan="2">#springMessage('table.bankacc.ukey.uKeyFunction')</td>
                    <td colspan="4">
                        <div class="bt-biz-dict" data-type="checkbox" data-group="ukey.function"
                             data-name="uKeyFunction" data-biz-name="uKeyFunction" data-callback="ukeyFunc"
                             id="uKeyFunction" data-defaultvalue="$!{btBankAccPage.uKeyFunction}"></div>
                    </td>
                </tr>
                <tr>
                    <td><input style="display: none" type="text" name="uKeyFunctionOther" autocomplete="off" class="layui-input" value="$!{btBankAccPage.uKeyFunctionOther}"
                               placeholder="#springMessage('cms.loan.OtherInfo')"></td>
                    <td colspan="4"></td>
                </tr>
                    ##RPA功能
                <tr>
                    <td class="textRight">#springMessage('table.bankacc.ukey.rpaFunction')</td>
                    <td colspan="3">
                        <div class="bt-biz-dict cks123" data-type="checkbox" data-group="ukey.rpaFunction"
                             data-name="rpaFunction" data-biz-name="rpaFunction" data-required="false" data-callback="rpaFunctionCallback"
                             id="rpaFunction" data-defaultvalue="$!{btBankAccPage.rpaFunction}"></div>
                    </td>
                </tr>
                    ##是否代管账户
                    #if($!{btBankAccPage.rpaFunction} && $!{btBankAccPage.rpaFunction.indexOf("1")} != -1)
                    <tr id="isRpaEscrowTr">
                    #else
                    <tr id="isRpaEscrowTr" style="display: none">
                    #end
                    <td class="textRight">#springMessage('table.bankacc.ukey.isRpaEscrow')</td>
                    <td colspan="3">
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                             data-defaultvalue="$!{btBankAccPage.isRpaEscrow}" data-name="isRpaEscrow" data-biz-name="isRpaEscrow" data-callback="bt.isRpaEscrow"></div>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
        <table class="layui-table breakRow">
            <tr>
                <td align="center" colspan="4">
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                    <button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallback">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </table>
        <!-- 附件上传 -->
        <input id="attachmentId" name="attachmentId" type="hidden" value="$!{btBankAccPage.attachmentId}">
        <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccRevHandle.edit.js?_btv=${resourceVersion}"></script>
</html>

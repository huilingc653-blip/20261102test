<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{bisCorpPoolBalPage.id}">
    <input id="initSign" name="initSign" type="hidden" value="1">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位
            <td class="textRight" width="40%">#springMessage('table.nisBillhead.corpId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-biz-name="corpId"
                         data-scope="all"
                         data-resource="bankacc:biscorppoolbal:apply"
                         data-required="true"
                         data-callback="bt.corpCallback"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##余额日期
            <td class="textRight">#springMessage('table.bisAccBal.balDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="balDate" lay-verify="required"
                           class="layui-input bt-biz-dateType" data-type="date"
                           data-name="balDate" data-biz-name="balDate">
                </div>
            </td>
        </tr>
        <tr>
            ##余额
            <td class="textRight">#springMessage('table.bisAccBal.bal')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="bal" name="bal" style="text-align:right"
                           data-minus="true"
                           lay-verify="required|number2" data-name="bal" data-biz-name="bal"
                           autocomplete="off" class="layui-input bt-biz-moneyType"
                           placeholder="#springMessage('table.bisAccBal.bal')">
                </div>
            </td>
        </tr>
        <tr>
            ##币别
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-name="curId" data-url="${basePath}/basic/business/btcurrency/json"
                         data-valuefield="id" data-textfield="curName" data-biz-name="curId" data-required="true">
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisCorpPoolBal.add.js?_btv=${resourceVersion}"></script>
</html>

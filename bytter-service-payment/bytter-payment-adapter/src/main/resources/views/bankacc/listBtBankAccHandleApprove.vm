<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
        <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}" />
        <table class="layui-table">
    		<tbody>
    			<tr>
    				##单位ID
                    <td class="textRight">#springMessage('table.btBankAcc.corpId')</td>
                    <td>
                		<div class="layui-input-inline">
                			<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-name="eqs_corpId"
                            data-scope="all" data-resource="netbank:bankAcc:btBankAcc:query"
                        	data-callback=""></div>
                        </div>
            		</td>
                    <td class="textRight">#springMessage('table.btBankAccApp.bankAcc')</td>
                    <td>
                        <input type="text" name="likes_bankAcc"
							autocomplete="off" class="bank layui-input" placeholder="#springMessage('table.btBankAccApp.bankAcc')">
                    </td>
					<td class="textRight">#springMessage('table.btBankAcc.accName')</td>
					<td>
						<input type="text" name="likes_accName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.accName')">
                    </td>
                </tr>
                <tr>
                    <td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/listFilter"
                             data-name ="eqs_bankTypeId" data-biz-name ="eqs_bankTypeId"  data-valueField="id" data-textField="typeName" data-defaultvalue="$!{btBankAccAppPage.bankTypeId}" ></div>
    				</td>
                    <td class="textRight">#springMessage('table.btBankAcc.bankName')</td>
                    <td>
                        <input type="text" name="likes_bankName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankName')">
                    </td>
                    <td class="textRight">
                        #springMessage('table.btBankAcc.isValidSign')
                    </td>
                    <td>
                        <div class="bt-biz-dict" data-type="select"
                             data-group="sf_yn" data-name="eqs_validSign" ></div>
                    </td>
        		</tr>
                <tr>
                    <td class="textRight">
                        #springMessage('table.btBankAcc.isOnlineView')
                    </td>
                    <td>
                        <div class="bt-biz-dict" data-type="select"
                             data-group="sf_yn" data-name="eqs_isOnline" ></div>
                    </td>
                    <td class="textRight">#springMessage('table.btBankAccApp.isDomesticBank')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="btBankAcc.isDomesticBank"
                             data-name="eqs_isDomesticBankName" data-biz-name="isDomesticBank"></div>
                    </td>
                    <td class="textRight">#springMessage('table.btBankAcc.isElectricBillAcc')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select"
                             data-group="sf_yn" data-name="eqs_electricBillName"></div>
                    </td>
                </tr>
               <tr>
               	 <td align="center" colspan="6">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                 </td>
               </tr>
            </tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.btBankAccApp.bankAcc')</th>
                <th>#springMessage('table.btBankAccApp.accName')</th>
                <th>#springMessage('table.btBankAccApp.corpId')</th>
                <th>#springMessage('table.btBankAccApp.curId')</th>
                <th>#springMessage('table.btBankAcc.isElectricBillAcc')</th>
                <th>#springMessage('table.btBankAccApp.circulationMode')</th>
                <th>#springMessage('table.btBankAccApp.isDomesticBank')</th>
                <th>#springMessage('table.btBankAccApp.accType')</th>
                <th>#springMessage('table.btBankAccApp.attributeId')</th>
                <th>#springMessage('table.btBankAccApp.natureId')</th>
                <th>#springMessage('table.btBankAccApp.bankTypeId')</th>
                <th>#springMessage('table.btBankAccApp.bankName')</th>
                <th>#springMessage('table.abVoucherinfo.source')</th>
                <th>#springMessage('table.btBankAcc.isOnlineView')</th>
                <th>#springMessage('table.btBankAcc.isValidSign')</th>
                <th>#springMessage('table.btBankAcc.availableStatus')</th>
                <th>#springMessage('账号用途')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
        #paymentWorkFlowHtml()
        #parse("views/common/footer.vm")
        #paymentWorkFlowScript()
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccHandleApprove.list.js?_btv=${resourceVersion}"></script>
</html>

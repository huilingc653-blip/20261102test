<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	<style>
		textarea {
			border: 1px solid #c2c2c2;
		}
	</style>
</head>
<body>
	<table class="layui-table">
		<tbody>
			<tr>
				<td colspan="4" style="text-align: center;font-weight: 700">#springMessage('table.unFreeze.modify')</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.nisBillhead.accId')</td>
				<td>$!{accVO.bankAcc}</td>
				<td align="right">#springMessage('table.nisAllocationReq.accName')</td>
				<td>$!{accVO.accName}</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.nisAllocationReq.bankName')</td>
				<td>$!{accVO.bankName}</td>
				<td align="right">#springMessage('btBankType.typeName')</td>
				<td>$!{accVO.bankTypeName}</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.btBankAccApp.attributeId')</td>
				<td>$!{accVO.attributeName}</td>
				<td align="right">#springMessage('table.fcAcc.corpId')</td>
				<td>$!{accVO.corpName}</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.btBankAccApp.accType')</td>
				<td>$!{accVO.accTypeName}</td>
				<td></td>
				<td></td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.btBankAccCur.cur')</td>
				<td>$!{accVO.curName}</td>
				<td align="right">#springMessage('table.fcAcc.interestRate')</td>
				<td>$!rateTag.show($!{accVO.rates})</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.btInnerAccApp.innerDate')</td>
				<td>$!date.format('yyyy-MM-dd',$!{accVO.regDate})</td>
				<td align="right">#springMessage('table.btBankAccApp.natureId')</td>
				<td>$!{accVO.natureName}</td>
			</tr>
			<tr>
				<td colspan="4" style="text-align: center;font-weight: 700">#springMessage('table.btBankAccunFreeze.info')</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.nisAllocationReq.accBalance')</td>
				<td>
					<div name="money">$!{btBankAccFreezeVO.bal}</div>
				</td>
				<td align="right">#springMessage('table.bisAccBal.availBal')</td>
				<td>
					<div name="money">$!{btBankAccFreezeVO.avalBal}</div>
				</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.btBankAccFreeze.freezeNum')</td>
				<td>$!{btBankAccFreezeVO.freezeCount}</td>
				<td align="right">#springMessage('table.btBankAccFreeze.sumFreezeAtm')</td>
				<td>
					<div name="money">$!{btBankAccFreezeVO.freezeMoneySum}</div>
				</td>
			</tr>
			<tr>
				<td align="right">#springMessage('table.btBankAccFreeze.unfreezeNum')</td>
				<td>$!{btBankAccFreezeVO.unfreezeCount}</td>
				<td align="right">#springMessage('table.btBankAccFreeze.sumUnfreezeAtm')</td>
				<td>
					<div name="money">$!{btBankAccFreezeVO.unFreezeMoneySum}</div>
				</td>
			</tr>
            <tr>
                <td align="right">#springMessage('table.freeze.ufavalBal')</td>
                <td>
					<div name="money">$!{btBankAccFreezeVO.ufavalBal}</div>
				</td>
                <td align="right"></td>
                <td></td>
            </tr>
		</tbody>
	</table>
	<form class="layui-form" method="post">
		<input type="hidden" name="bal" id="bal" value="$!{btBankAccFreezeVO.bal}"/>
		<input type="hidden" name="availBal" id="availBal" value="$!{btBankAccFreezeVO.avalBal}"/>
		<input type="hidden" name="bankAccId" id="bankAccId" value="$!{accVO.id}"/>
		<input type="hidden" name="bankAcc" id="bankAcc" value="$!{accVO.bankAcc}"/>
		<input type="hidden" name="corpId" id="corpId" value="$!{accVO.corpId}"/>
		<input type="hidden" name="id" id="id" value="$!{btBankAccFreezeVO.id}"/>
        <input type="hidden"  id="ufavalBal" value="$!{btBankAccFreezeVO.ufavalBal}"/>
		<table class="layui-table">
			<tbody>
				<tr>
					<td align="right">
						<span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fcFreeze.unfreezeMoney.yes')
					</td>
					<td colspan="3">
						<input type="text" data-name="freezeMoney" lay-verify="required" class="layui-input bt-biz-moneyType" style="text-align:right" data-minus="true" data-biz-name="freezeMoney" value="$!{btBankAccFreezeVO.freezeMoney}">
					</td>
				</tr>
				<tr>
					<td align="right">
						<span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fcFreeze.unfreezeReason')
					</td>
					<td colspan="3">
						<textarea rows="5" cols="50" id="freezeRession" name="freezeRession" lay-verify="required|strlength" data-maxlength="200">$!{btBankAccFreezeVO.freezeRession}</textarea>
					</td>
				</tr>
				<tr>
					<td colspan="4" align="center">
					 	 <button class="layui-btn" lay-submit="" lay-filter="temp" >#springMessage('common.button.temp')</button>
        				 <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccUnFreeze.edit.js?_btv=${resourceVersion}"></script>
</html>
<script>
    var ACTIVE = 'active';
    // 用于记录页面的查询参数
    const searchParams = {
        corpIds: [],
        corpNames: [],
        curId: null,
        corpId: null,
        accType: null,
        bankAcc:null,
    };

    $('#bt-loading').show();
    window.bankAccDtlList = (data)=>{
        postData(data)
    }


    //单位搜索组件
    function openCorpSelectionPage() {
        setTimeout(function () {
           var data = BTAppBridge.openCorpSelectionPage && BTAppBridge.openCorpSelectionPage('searchActionCallback');
            uni.postMessage({
                data:data
            })
        }, 200);
    }

    (function (doc, win) {
        F2.track(false);
        //初始化数据
        // submiteData(true);

        var pageSize  = 15,pageNumber = 0,dropObj = null;
        win.resetScrollContent = function() {
            console.log('初始化')
            $('.search-result-list').html('');
            $('.dropload-down').remove();
            pageNumber = 0;
            pageSize = 15;
            dropObj = null;
            $('.search-result').dropload({
                scrollArea : window,
                loadDownFn : function(me){
                    pageNumber ++;
                    dropObj = me;
                    submiteData()
                }
            });
        }
        //滚动加载初始化
        resetScrollContent();
        //滚动加载初始化


        /**
         * 搜索回调方法
         * @param data
         */
        window.searchActionCallback = function (data) {
            // 根据data参数，查询数据
            if (data.corpNames && data.corpNames.length > 0) {
                searchParams.corpNames = data.corpNames;
                $("#corpId").val(data.corpNames);
            } else {
                $("#corpId").val('');
            }
            if (data.corpIds) {
                searchParams.corpIds = data.corpIds;
                searchParams.corpId = data.corpIds;
                setTimeout(function () {
                    resetScrollContent()
                   var data = BTAppBridge.post("/api/bankacc/mobileBankAccDtlData", searchParams, 'postData');
                    uni.postMessage({
                        data:data
                    })
                }, 100);
            }

var rowNum = 0;
var moneyType = "";
var dicts;
var dateFun;
var surplusMoney = "";//剩余本金(用于每次计算使用)
var surplusMoneyFixed = "";//固定的剩余金额（即除去已还金额，剩余的金额）
var loanDate = "";//发放日期
var repayDate = "";//还款日期
var loanMoney = "";//发放金额
var loanRate = "";//利率
var isRepay = "0";//初始化时，若为1：已还，则设置不可编辑
var repayTypeOld = "";
var repayType = "";//还款方式
var rateBase = 360;//利息测算基数
var repayCycel;//还款周期
var principal = 1;//在等额本金下，当本金除不尽时，控制本金合计 0:合计不做处理 1：合计需要做处理
var isInit = true;//判断是不是第一次进页面，初始化标识
bt.use(['form', 'element', 'moneyType', 'dateType', 'bttable', 'dicts', 'btImport', 'selectType'], function () {
    $ = bt.jquery, form = bt.form(), moneyFun = bt.moneyType.getFun();
    dicts = bt.dicts.init();
    moneyType = bt.moneyType.init();
    dateType = bt.dateType.init();
    selectType = bt.selectType.init();
    dateFun = dateType.getFun();
    var dateDis = "disabled";
    if (repayType == "03" || repayType == "06") {
        dateDis = "";
    }
    initVariable();
    var orig_repayType = $("#orig_repayType").val();
    //生成列表
    bt.bttable.init({
        elem: "#repayPlanTB",
        url: basePath + "/cms/basedata/updaterepaymentschedule/listUpdateRepayPlan?id=" + $("#id").val(),
        buttons: [
            {
                text: '<i class="layui-icon">&#xe654;</i>' + bt.lang('common.button.add'),
                action: function (e, dt, node, config) {
                    add();
                }
            }, {
                text: bt.lang('common.button.imports'),
                action: function (e, dt, node, config) {
                    importExcel();
                }
            }, {
                text: bt.lang('common.button.exports'),
                action: function (e, dt, node, config) {
                    exportExcel();
                }
            },
        ],
        columns: [
            {
                data: "prediceRepayDate",
                render: function (data, row) {
                    rowNum = row;
                    isRepay = data.isRepay == "1" ? "disabled" : "";
                    if (isNull(data.prediceRepayDate)) {
                        if (data.isRepay == "1") {
                            return '<input disabled data-biz-name="prediceRepayDate_' + rowNum + '" name="repayMents[' + rowNum + '].prediceRepayDate" id="prediceRepayDate_' + rowNum + '" type="text"  class="layui-input bt-biz-dateType" data-min="' + loanDate + '" data-max="' + repayDate + '" data-type="date" data-callback="clickEvent"/>';
                        } else {
                            return '<input ' + dateDis + ' data-biz-name="prediceRepayDate_' + rowNum + '" name="repayMents[' + rowNum + '].prediceRepayDate" id="prediceRepayDate_' + rowNum + '" type="text"  class="layui-input bt-biz-dateType" data-min="' + loanDate + '" data-max="' + repayDate + '" data-type="date" data-callback="clickEvent"/>';
                        }
                    } else {
                        if (data.isRepay == "1") {
                            return '<input disabled data-biz-name="prediceRepayDate_' + rowNum + '"name="repayMents[' + rowNum + '].prediceRepayDate" id="prediceRepayDate_' + rowNum + '" type="text" value="' + data.prediceRepayDate + '" class="layui-input bt-biz-dateType" data-min="' + loanDate + '" data-max="' + repayDate + '" data-type="date" data-callback="clickEvent"/>';
                        } else {
                            if ("07" == repayType) {
                                return '<input divName="prediceRepayDate" data-biz-name="prediceRepayDate_' + rowNum + '" name="repayMents[' + rowNum + '].prediceRepayDate" id="prediceRepayDate_' + rowNum + '" type="text" value="' + data.prediceRepayDate + '" class="layui-input bt-biz-dateType" data-min="' + loanDate + '" data-max="' + repayDate + '" data-type="date" data-callback="clickEvent"/>';
                            } else {
                                return '<input ' + dateDis + ' data-biz-name="prediceRepayDate_' + rowNum + '"name="repayMents[' + rowNum + '].prediceRepayDate" id="prediceRepayDate_' + rowNum + '" type="text" value="' + data.prediceRepayDate + '" class="layui-input bt-biz-dateType" data-min="' + loanDate + '" data-max="' + repayDate + '" data-type="date" data-callback="clickEvent"/>';
                            }
                        }
                    }
                }
            },
            {
                data: "repaymentMoney",
                render: function (data, row) {
                    if (data.isRepay != "1" && (orig_repayType == "03" || orig_repayType == "07")) {
                        return '<input divName="repaymentMoney" class="layui-input bt-input-inline  bt-biz-moneyType" value="' + (data.repaymentMoney == null ? "" : moneyFun.format(data.repaymentMoney)) + '" data-callback="bt.calMoney"  type="text" data-decimal="2" id="repaymentMoney_' + rowNum + '" data-min="0" data-max="' + loanMoney + '" id="repaymentMoney_' + rowNum + '" data-biz-name="repaymentMoney_' + rowNum + '" data-name="repayMents[' + rowNum + '].repaymentMoney"/>';
                    } else {
                        return '<input disabled divName="repaymentMoney" class="layui-input bt-input-inline  bt-biz-moneyType" value="' + (data.repaymentMoney == null ? "" : moneyFun.format(data.repaymentMoney)) + '" data-callback="bt.calMoney"  type="text" data-decimal="2" id="repaymentMoney_' + rowNum + '" data-min="0" data-max="' + loanMoney + '" id="repaymentMoney_' + rowNum + '" data-biz-name="repaymentMoney_' + rowNum + '" data-name="repayMents[' + rowNum + '].repaymentMoney"/>';
                    }
                }
            },
            {
                data: "repaymentIst",
                render: function (data, row) {
                    if (data.isRepay != "1" && orig_repayType == "03") {
                        return '<input divName="repaymentIst"  data-callback="bt.calMoney" class="layui-input bt-input-inline  bt-biz-moneyType" data-biz-name="repaymentIst_' + rowNum + '"  type="text" value="' + (data.repaymentIst == null ? "" : moneyFun.format(data.repaymentIst)) + '" data-decimal="2" id="repaymentIst_' + rowNum + '" data-min="0"  data-name="repayMents[' + rowNum + '].repaymentIst"/>';
                    } else if (data.isRepay != "1" && orig_repayType == "07") {
                        return '<input divName="repaymentIst"  data-callback="bt.calMoney" class="layui-input bt-input-inline  bt-biz-moneyType" data-biz-name="repaymentIst_' + rowNum + '"  type="text" value="' + (data.repaymentIst == null ? "" : moneyFun.format(data.repaymentIst)) + '" data-decimal="2" id="repaymentIst_' + rowNum + '" data-min="0"  data-name="repayMents[' + rowNum + '].repaymentIst"/>';
                    } else {
                        return '<input disabled divName="repaymentIst" class="layui-input bt-input-inline  bt-biz-moneyType" data-biz-name="repaymentIst_' + rowNum + '"  type="text" value="' + (data.repaymentIst == null ? "" : moneyFun.format(data.repaymentIst)) + '" data-decimal="2" id="repaymentIst_' + rowNum + '" data-min="0"  data-name="repayMents[' + rowNum + '].repaymentIst"/>';
                    }
                }
            },
            {
                data: "currentRepayMoney",
                render: function (data, row) {
                    if (orig_repayType == "03" || orig_repayType == "07") {
                        return '<input readonly="readonly" divName="currentRepayMoney" divName="currentRepayMoney" class="layui-input bt-input-inline  bt-biz-moneyType" data-biz-name="currentRepayMoney_' + rowNum + '" type="text" value="' + (data.currentRepayMoney == null ? "" : moneyFun.format(data.currentRepayMoney)) + '" data-decimal="2" id="currentRepayMoney_' + rowNum + '" data-min="0" data-name="repayMents[' + rowNum + '].currentRepayMoney"/>';
                    } else {
                        return '<input disabled divName="currentRepayMoney" class="layui-input bt-input-inline  bt-biz-moneyType" data-biz-name="currentRepayMoney_' + rowNum + '" type="text" value="' + (data.currentRepayMoney == null ? "" : moneyFun.format(data.currentRepayMoney)) + '" data-decimal="2" id="currentRepayMoney_' + rowNum + '" data-min="0" data-name="repayMents[' + rowNum + '].currentRepayMoney"/>';
                    }
                }
            },
            {
                data: "surplusMoney",
                render: function (data, row) {
                    if (orig_repayType == "03" || orig_repayType == "07") {
                        return '<input readonly="readonly"  value="' + (data.surplusMoney == null ? "" : moneyFun.format(data.surplusMoney)) + '" class="layui-input bt-input-inline  bt-biz-moneyType" data-biz-name="surplusMoney_' + rowNum + '" type="text" data-decimal="2" id="surplusMoney_' + rowNum + '" data-min="0" data-name="repayMents[' + rowNum + '].surplusMoney"/>';
                    } else {
                        return '<input disabled  value="' + (data.surplusMoney == null ? "" : moneyFun.format(data.surplusMoney)) + '" class="layui-input bt-input-inline  bt-biz-moneyType" data-biz-name="surplusMoney_' + rowNum + '" type="text" data-decimal="2" id="surplusMoney_' + rowNum + '" data-min="0" data-name="repayMents[' + rowNum + '].surplusMoney"/>';
                    }
                }
            },
            {
                data: "isRepay",
                render: function (data, row) {
                    return bt.dict('yn_state', data.isRepay) + '<input name="repayMents[' + rowNum + '].isRepay" value="' + data.isRepay + '"  type="hidden"/>';
                }
            },
            {
                data: "remark",
                render: function (data, type, full, meta) {
                    return '<input ' + isRepay + ' name="repayMents[' + rowNum + '].remark" id="remark" value="' + (data.remark == null ? "" : data.remark) + '" class="layui-input" type="text"/>';
                }
            },
            {
                data: "itemOrder",
                render: function (data, row) {
                    var html = ""
                    if (data.isRepay == "0") {
                        if (orig_repayType == "03" || orig_repayType == "07") {
                            html += '<button id="del" data-type="del" type="button" name="itemOrder" value="' + rowNum + '" class="layui-btn layui-btn-mini" ><i class="layui-icon">&#xe640;</i>' + bt.lang("common.button.delete") + '</button>';
                        } else {
                            html += '<button style="display:none" id="del" data-type="del" type="button" name="itemOrder" value="' + rowNum + '" class="layui-btn layui-btn-mini" ><i class="layui-icon">&#xe640;</i>' + bt.lang("common.button.delete") + '</button>';
                        }
                    }
                    return html;
                }
            }
        ],
        delRowCallback: function (data, $tr) {
            $tr.remove();
            MoneyCalculation();
        },
        tableInitCallback: function (data) {
            rowNum = data.length;
            setBeginDate();
            addFun();
        }
    });

    /**
     * 保存
     */
    form.on('submit(save)', function (data) {
        bt.loading.show();
        if (verification() == false) {
            bt.loading.hide();
            return false;
        }

        var action = "/cms/basedata/updaterepaymentschedule/updateRepayPlan";
        $.post(basePath + action, data.field, function (result) {
            bt.loading.hide();
            parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            if (result.success) {
                //parent.layer?parent.layer.closeAll():layer.closeAll();
                var webObj = bt.navtab.getParentDom();
                //给父级选项卡页面中id为planId的input赋值;
                webObj.bt.jquery("#planId").val(result.obj);
                bt.navtab.closeCurrent();
            }
        }, 'JSON');


        return false;
    });
    repayTypeChanges($("#orig_repayType").val());
});
//导出
exportExcel = function () {
    var url = basePath + "/cms/basedata/repaymentschedule/exportBudget?id=" + $("#id").val();
    window.location.href = url;
}

//导入初始化
importExcel = function () {
    if (repayType != "07") {
        return;
    }
    var surplusMoney = $("#loanMoney").val();
    console.log()
    up = bt.btImport.init({
        code: "70000003",
        titleRows: 0,
        headRows: 1,
        success: function (head, data, select) {
            for (let i = 0; i < select.length; i++) {
                surplusMoney = surplusMoney - select[i].repaymentMoney
                addImport(select[i], surplusMoney);
            }
        }
    });
};

//重新渲染日期、金额控件
function addFun() {
    //重新渲染datatype和moneyType
    dateType.render();
    moneyType.render();
    sumMoney();
    //+1为了以防id重复
    rowNum++;
}

/**
 * 预计还款日改变事件（其他：重新计算金额）
 * @param value
 */
function clickEvent(value) {
    if (repayType === "07") {
        checkDateByCustomRepay();
    } else {
        MoneyCalculation();
    }
}

/**
 * 还款开始日改变事件
 */
function beginDateChange() {
    if (isNull(dicts.get('repayCycel').val())) {
        return;
    }
    loadData();
}

/**
 * 还款周期改变事件
 * @param data
 */
function cycleChange(data) {
    //还款方式为一次性还款就返回
    repayCycel = data.value;
    if (data.value == "3") {
        var payDate;
        if (isNull(zqDate)) {
            payDate = repayDate;
        } else {
            payDate = zqDate;
        }
        var payMoney = surplusMoneyFixed;
        clearData();//清空未还数据(还款方式除了其他的时候)
        addOneOffPayment(payDate, payMoney);
        return;
    }
    //若没有选择还款开始日则提示选择日期
    if (isNull($('#repayBeginDate').val())) {
        parent.layer.alert(bt.lang("cms.RepaymentSchedule.noSelectBeginDate"));
        return;
    }
    loadData();
}


<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="username" value="$!{user}">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位ID
            <td class="textRight">#springMessage('table.nisPersonnelDetail.corpId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-resource="netbank:bankAcc:btnetukey:query"
                         data-scope="all"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.bankacc.btnetukey.UKey')</td>
            <td>
                <input type="text" name="likes_ukeyNo"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.bankacc.btnetukey.UKey')">
            </td>
            <td class="textRight">#springMessage('table.nisBillhead.bankAcc')</td>
            <td>
                <input type="text" name="likes_bankAcc"
                       autocomplete="off" class="bank layui-input"
                       placeholder="#springMessage('table.nisBillhead.bankAcc')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.bankacc.btnetukey.bankLimit')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-name="eqs_bankLimit"
                     data-group="bank.permissions" data-callback="bt.permission"></div>
            </td>
            <td class="textRight">#springMessage('table.btBankAccApp.accName')</td>
            <td>
                <input type="text" name="likes_accName"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.btBankAccApp.accName')">
            </td>
            <td class="textRight">
                #springMessage('table.bankacc.btnetukey.uKeyUser')
            </td>
            <td>
                <input type="hidden" name="eqs_ukeyUserId">
                <input type="text" class="layui-input uKeyUserId" lay-verify="tableData">
                <table id="uKeyUserId" class="hide">
                    <thead>
                    <tr>
                        <th>#springMessage('rasShopGrant.loginAcc')</th>
                        <th>#springMessage('table.guaLog.createName')</th>
                    </tr>
                    </thead>
                </table>
            </td>
        </tr>
        <tr>
            <td class="textRight">
                #springMessage('table.bankacc.btnetukey.custodian')
            </td>
            <td>
                <input type="hidden" name="eqs_custodianId">
                <input type="text" class="layui-input custodianId" lay-verify="tableData">
                <table id="custodianId" class="hide">
                    <thead>
                    <tr>
                        <th>#springMessage('rasShopGrant.loginAcc')</th>
                        <th>#springMessage('table.guaLog.createName')</th>
                    </tr>
                    </thead>
                </table>
            </td>
            <td class="textRight">#springMessage('table.bankacc.btnetukey.supervisor')</td>
            <td>
                <input type="hidden" name="eqs_supervisorId">
                <input type="text" class="layui-input supervisorId" lay-verify="tableData">
                <table id="supervisorId" class="hide">
                    <thead>
                    <tr>
                        <th>#springMessage('rasShopGrant.loginAcc')</th>
                        <th>#springMessage('table.guaLog.createName')</th>
                    </tr>
                    </thead>
                </table>
            </td>
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td>
                <input type="text" name="ged_expireDate" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_reqDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_expireDate" class="layui-input bt-input-inline bt-biz-dateType"
                       id="led_reqDate">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('是否总部保管')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-name="eqs_isHeadCustodian"
                     data-group="sf_yn"></div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td align="center" colspan="6">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary" onclick="flush()">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.bankacc.btnetukey.UKey')</th>
        <th>#springMessage('table.nisPersonnelDetail.corpId')</th>
        <th>#springMessage('table.bankacc.btnetukey.bankLimit')</th>
        <th>#springMessage('table.bankacc.btnetukey.personalLimit')</th>
        <th>#springMessage('table.bankacc.btnetukey.uKeyUser')</th>
        <th>#springMessage('网银登录名')</th>
        <th>#springMessage('table.guaPledge.keeper')</th>
        <th>#springMessage('table.bankacc.btnetukey.supervisor')</th>
        <th>#springMessage('table.bankacc.btnetukey.openDate')</th>
        <th>#springMessage('table.cmsProvideLoanSend.repayDate')</th>
        <th>#springMessage('table.nisBillhead.bankAcc')</th>
        <th>#springMessage('table.btBankAccApp.accName')</th>
        <th>#springMessage('table.accountDTO.bankName')</th>
        <th>#springMessage('是否总部保管')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btNetUKey.list.js?_btv=${resourceVersion}"></script>
</html>

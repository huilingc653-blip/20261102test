<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('bisAccAttribute.attributeCode')</td>
            <td width="40%">
                <input type="text" name="likes_attributeCode"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('bisAccAttribute.attributeCode')">
            </td>
            <td class="textRight">#springMessage('bisAccAttribute.attributeName')</td>
            <td width="40%">
                <input type="text" name="likes_attributeName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('bisAccAttribute.attributeName')">
            </td>
        </tr>
        <tr >
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('bisAccAttribute.attributeCode')</th>
        <th>#springMessage('bisAccAttribute.attributeName')</th>
        <th>#springMessage('bisAccAttribute.foreignDes')</th>
        <th>#springMessage('bisAccAttribute.sameDes')</th>
        <th>#springMessage('bisAccAttribute.superDes')</th>
        <th>#springMessage('bisAccAttribute.rmk')</th>
        <th>#springMessage('bisAccAttribute.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisAccAttribute.list.js?_btv=${resourceVersion}"></script>
</html>

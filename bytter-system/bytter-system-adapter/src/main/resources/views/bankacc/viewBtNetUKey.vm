<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-fluid">
    <table class="layui-table">
        <thead>
        <tr>
            <td colspan="4">#springMessage('table.externalCorp.basicInfo')</td>
        </tr>
        </thead>
        <tbody>
        <tr>
            ##UKey编号
            <td class="textRight">#springMessage('table.bankacc.btnetukey.UKey')</td>
            <td>
                $!{vo.ukeyNo}
            </td>
            <td class="textRight">#springMessage('table.nisPersonnelDetail.corpId')</td>
            <td>
                $!{vo.corpName}
            </td>
        </tr>
        <tr>
            ##银行类型
            <td class="textRight">#springMessage('table.ratBkration.bankType')</td>
            <td>
                $!{vo.bankTypeName}
            </td>
            ##银行账户
            <td class="textRight">#springMessage('table.nisBillhead.bankAcc')</td>
            <td>
                $!{bankAcc}
            </td>
        </tr>
        <tr>
            ##银行权限
            <td class="textRight">#springMessage('table.bankacc.btnetukey.bankLimit')</td>
            <td>
                $dictTag.get("bank.permissions",${vo.bankLimit})
            </td>
            ##个人权限
            <td class="textRight">#springMessage('table.bankacc.btnetukey.personalLimit')</td>
            <td>
                $dictTag.get("personal.permissions",${vo.personalLimit})
            </td>
        </tr>
        <tr>
            ##保管人
            <td class="textRight">#springMessage('table.bankacc.btnetukey.custodian')</td>
            <td>
                $!{vo.custodianName}
            </td>
            ##UKey用户
            <td class="textRight">#springMessage('table.bankacc.btnetukey.uKeyUser')</td>
            <td>
                $!{vo.ukeyUserId}
            </td>
        </tr>
        <tr>
            ##监交人
            <td class="textRight">#springMessage('table.bankacc.btnetukey.supervisor')</td>
            <td>
                $!{vo.supervisorName}
            </td>
            ##网银登录名
            <td class="textRight">#springMessage('网银登录名')</td>
            <td>
                $!{vo.ebankLoginName}
            </td>
        </tr>
        <tr>
            ##启用日期
            <td class="textRight">#springMessage('table.bankacc.btnetukey.openDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{vo.openDate})
            </td>
            ##到期日期
            <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{vo.expireDate})
            </td>
        </tr>
        <tr>
            ##是否总部保管
            <td class="textRight">#springMessage('是否总部保管')</td>
            <td>
                $dictTag.get("sf_yn",${vo.isHeadCustodian})
            </td>
            <td class="textRight"></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="4">#springMessage('table.bankacc.btnetukey.rpaInfo')</td>
        </tr>
        </thead>
        <tbody>
        <tr>
            ##网银登陆账号
            <td class="textRight" width="20%">#springMessage('table.bankacc.btnetukey.rpa.loginAccount')</td>
            <td colspan="3">
                $!{vo.loginAccount}
            </td>
        </tr>
        <tr>
            ##机器号/IP地址
            <td class="textRight" width="20%">#springMessage('table.bankacc.btnetukey.rpa.ipAddress')</td>
            <td width="30%">
                $!{vo.ipAddress}
            </td>
            ##端口号
            <td class="textRight" width="20%">#springMessage('table.bankacc.btnetukey.rpa.port')</td>
            <td width="30%">
                $!{vo.port}
            </td>
        </tr>
        <tr>
            ##密码设备号
            <td class="textRight" width="20%">#springMessage('table.bankacc.btnetukey.rpa.passwordNo')</td>
            <td width="30%">
                $!{vo.passwordNo}
            </td>
            ##密码组
            <td class="textRight" width="20%">#springMessage('table.bankacc.btnetukey.rpa.cipherSuite')</td>
            <td width="30%">
                $!{vo.cipherSuite}
            </td>
        </tr>
        </tbody>
    </table>
</div>
<!-- 附件上传 -->
<input id="attachmentId" name="attachmentId" type="hidden" value="$!{vo.attachmentId}">
<div id="uploader" class="layui-input-inline" style="width:100%"></div>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form','dateType','corp','selectType','dicts','btUpload','selectTable'], function () {
        var $ = bt.jquery, form = bt.form();
        bt.dateType.init();
        bt.corp.init();
        bt.selectType.init();
        bt.dicts.init();
        var up = bt.btUpload.init({
            elem: "#uploader",
            auto: false,
            hasDelete: false,
            hasUpload: false,
            isExpand: true,
            gid: $("#attachmentId").val()
        });
    })
</script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<table class="layui-table">
	<tbody>
		<tr>
            <td colspan="4" style="text-align: center;font-weight: 700">#springMessage('table.btBankAcc.info')</td>
        </tr>
        <tr>
        	<td width="20%" class="textRight">#springMessage('table.btBankAcc.bankAcc')</td>
        	<td width="30%">$!{btBankAccPage.bankAcc}</td>
        	<td width="20%" class="textRight">#springMessage('table.btBankAcc.accName')</td>
        	<td width="30%">$!{btBankAccPage.accName}</td>
        </tr>
         <tr>
        	<td class="textRight">#springMessage('table.btBankAcc.corpId')</td>
        	<td>$!{btBankAccPage.corpName}</td>
        	<td class="textRight">#springMessage('table.btBankAcc.bankName')</td>
        	<td>$!{btBankAccPage.bankName}</td>
        </tr>
         <tr>
        	<td class="textRight">#springMessage('table.btBankAcc.natureId')</td>
        	<td>$!{btBankAccPage.natureName}</td>
        	<td class="textRight">#springMessage('table.btBankAcc.attributeId')</td>
        	<td>$!{btBankAccPage.attributeName}</td>
        </tr>
         <tr>
        	<td class="textRight">#springMessage('table.btBankAcc.accType')</td>
        	<td>$!{btBankAccPage.accTypeName}</td>
        	<td class="textRight">#springMessage('table.btBankAccApp.curId')</td>
        	<td>$!{btBankAccPage.curName}</td>
        </tr>
         <tr>
        	<td class="textRight">#springMessage('table.btBankAcc.bifName')</td>
        	<td>$!{btBankAccPage.bifName}</td>
             <td class="textRight">#springMessage('table.btBankAccApp.isOnline')</td>
             <td>$!{btBankAccPage.isOnlineStr}</td>
        </tr>
         <tr>
             <td class="textRight">#springMessage('table.btBankAccApp.prentAccId')</td>
             <td>$!{prentBtBankAccPage.bankAcc}</td>
        	<td class="textRight">#springMessage('table.btBankAccApp.prentAccIdAccType')</td>
        	<td>$!{prentBtBankAccPage.accTypeName}</td>
        </tr>
         <tr>
        	<td class="textRight">#springMessage('table.btBankAcc.scanFlag')</td>
        	<td>$!{btBankAccPage.scanFlagStr}</td>
        	<td class="textRight">#springMessage('table.btBankAcc.regDate')</td>
        	<td>$!date.format('yyyy-MM-dd',$!{btBankAccPage.regDate})</td>
        </tr>
         <tr>
        	<td class="textRight">#springMessage('table.btBankAcc.rmk')</td>
        	<td colspan="3">$!{btBankAccPage.rmk}</td>
        </tr>
	</tbody>
	</table>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
    	<input id="id" name="id" type="hidden" value="$!{bisAccAttributePage.id}">
    	<input id="attributeDes" name="attributeDes" type="hidden" value="$!{bisAccAttributePage.attributeDes}">
    	<input id="createBy" name="createBy" type="hidden" value="$!{bisAccAttributePage.createBy}">
    	<input id="updateBy" name="updateBy" type="hidden" value="$!{bisAccAttributePage.updateBy}">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight" width="30%">#springMessage('bisAccAttribute.attributeCode')</td>
					<td>
						<input type="text" id="attributeCode" name="attributeCode"  lay-verify="required|langKey" readonly="readonly"
							autocomplete="off" class="layui-input" placeholder="#springMessage('bisAccAttribute.attributeCode')" value="$!{bisAccAttributePage.attributeCode}">
                    </td>
                </tr>
				<tr>
                    <td class="textRight">#springMessage('bisAccAttribute.attributeName')</td>
                    <td>
                        <input type="text" id="attributeName" name="attributeName" lay-verify="required"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('bisAccAttribute.attributeName')" value="$!{bisAccAttributePage.attributeName}">
                    </td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.foreignDes')</td>
					<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="attributeDes" data-defaultvalue="$!{bisAccAttributePage.foreignDes}" data-name="foreignDes" data-biz-name="foreignDes"></div>
                    </td>
                </tr>
				<tr>
                    <td class="textRight">#springMessage('bisAccAttribute.sameDes')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="attributeDes" data-defaultvalue="$!{bisAccAttributePage.sameDes}" data-name="sameDes" data-biz-name="sameDes"></div>
                    </td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.superDes')</td>
					<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="attributeDes" data-defaultvalue="$!{bisAccAttributePage.superDes}" data-name="superDes" data-biz-name="superDes"></div>
                    </td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
					<td>
						<textarea placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea " style="width:100%" id="rmk" name="rmk" >$!{bisAccAttributePage.rmk}</textarea>
                    </td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.validSign')</td>
					<td>
                        <div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="$!{bisAccAttributePage.validSign}" data-name="validSign" data-biz-name="validSign"></div>
                    </td>
                </tr>
    			<tr >
                    <td colspan="2" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisAccAttribute.edit.js?_btv=${resourceVersion}"></script>
</html>

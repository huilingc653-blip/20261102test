<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" id="applyCodes" name="applyCodes" value="$shiro.hasPermission("netbank:bankAcc:btBankAccRelation:apply")">
        <input type="hidden" id="poolCodes" name="poolCodes" value="$shiro.hasPermission("netbank:bankAcc:btBankAccRelation:pool:apply")">
        <input type="hidden" name="poolSign" id="poolSign" value="$!{poolSign}"/>
        <input type="hidden" name="netIdSel" id="netIdSel" value="$!{netId}"/>
        <input type="hidden" name="corpIdSel" id="corpIdSel" value="$!{corpId}"/>
        <table class="layui-table">
            <tbody>
            	<tr>
                #if($!{poolSign} == "1")
                    <td class="textRight" width="10%">#springMessage('nis.pool.fcCorpPool.pool')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-selectType" data-url="" data-name="netId" data-biz-name="netId" data-callback="netIdCallback"
                                 data-valuefield="id" data-textfield="showName" data-search="true" data-defaultValue="$!{netId}" data-required="required" data-url="${basePath}/bankacc/btbankaccrelation?getUserCorpPools"></div>
                        </div>
                    </td>
                    <td class="textRight" width="10%">#springMessage('table.btBankAccApp.corpId')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-selectType" data-url="" data-name="corpId" data-biz-name="corpId"
                                 data-valuefield="corpId" data-textfield="showName" data-search="true" data-defaultValue="$!{corpId}" data-extraData="false"></div>
                        </div>
                    </td>
                #else
                    <td class="textRight" width="10%">#springMessage('table.fcAcc.netId')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="net"
                                 data-type="selectTree"
								 data-biz-name="netId"
                                 data-name="netId"
                                 data-required="true"
								 data-defaultValue="$!{netId}"
                                 data-group="corpGroup"
                                 data-change="corpId"
                                 data-resource="netbank:bankAcc:btBankAccRelation:query"
                                 data-scope="net">
                            </div>
                        </div>
                    </td>
                    <td class="textRight" width="10%">#springMessage('table.btBankAccApp.corpId')</td>
                    <td width="25%">
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
								 data-biz-name="corpId"
                                 data-name="corpId"
                                 data-defaultValue="$!{corpId}"
                                 data-tips="#springMessage('common.placeholder.select')#springMessage('table.fcAcc.netId')"
                                 data-group="corpGroup"
                                 data-resource="netbank:bankAcc:btBankAccRelation:query"
                                 data-scope="all"></div>
                        </div>
                    </td>
                #end
                    <td class="textRight" width="10%">#springMessage('table.btBankAccApp.curId')</td>
                    <td width="20%">
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-defaultvalue="$!{curId}"
                             data-name ="curId" data-biz-name ="curId"  data-valueField="id" data-textField="curName"></div>
                    </td>
                </tr>
                <tr>
                	<td align="center" colspan="6">
                        <button type="button" class="layui-btn" lay-submit lay-filter="search" id="search">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary" data-callback="bt.searchResetCallback">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
    #set($btBankAccRelationApply=$shiro.hasPermission("netbank:bankAcc:btBankAccRelation:apply"))
    #set($btBankAccRelationPoolApply=$shiro.hasPermission("netbank:bankAcc:btBankAccRelation:pool:apply"))

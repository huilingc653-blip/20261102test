<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{btAccNaturePage.id}">
		<input id="createBy" name="createBy" type="hidden" value="$!{btAccNaturePage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{btAccNaturePage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{btAccNaturePage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{btAccNaturePage.updateDate}">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight" width="30%">#springMessage('btAccNature.natureCode')</td>
					<td>
						<input type="text" id="natureCode" name="natureCode" lay-verify="required|langKey|strlength" data-maxlength="4" data-minlength="4"
							autocomplete="off" class="layui-input" placeholder="#springMessage('btAccNature.natureCode')">
                    </td>
                </tr>
				<tr>
                    <td class="textRight">#springMessage('btAccNature.natureName')</td>
                    <td>
                        <input type="text" id="natureName" name="natureName" lay-verify="required|strlength" data-maxlength="10"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('btAccNature.natureName')">
                    </td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('btAccNature.rmk')</td>
					<td>
						<textarea placeholder="#springMessage('btAccNature.rmk')" lay-verify="strlength" data-maxlength="40"  class="layui-textarea" style="width:100%" id="rmk" name="rmk" ></textarea>
                    </td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('btAccNature.validSign')</td>
					<td >
						<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="1" data-name="validSign" data-biz-name="validSign"></div>
                    </td>
                </tr>
    			<tr >
                    <td colspan="2" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btAccNature.add.js?_btv=${resourceVersion}"></script>
</html>

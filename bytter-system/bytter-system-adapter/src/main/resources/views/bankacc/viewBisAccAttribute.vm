<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight" width="30%">#springMessage('bisAccAttribute.attributeCode')</td>
					<td>
						$!{bisAccAttributePage.attributeCode}
                    </td>
                </tr>
				<tr>
                    <td class="textRight">#springMessage('bisAccAttribute.attributeName')</td>
                    <td>
						$!{bisAccAttributePage.attributeName}
                    </td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.foreignDes')</td>
					<td>
						$dictTag.get("attributeDes",$!{bisAccAttributePage.foreignDes})
                    </td>
                </tr>
				<tr>
                    <td class="textRight">#springMessage('bisAccAttribute.sameDes')</td>
                    <td>
						$dictTag.get("attributeDes",$!{bisAccAttributePage.sameDes})
                    </td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.superDes')</td>
					<td>
						$dictTag.get("attributeDes",$!{bisAccAttributePage.superDes})
                    </td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
					<td>
						$!{bisAccAttributePage.rmk}
                    </td>
                </tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.validSign')</td>
					<td>
						$dictTag.get("valid_sign",$!{bisAccAttributePage.validSign})
                    </td>
                </tr>
            </tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
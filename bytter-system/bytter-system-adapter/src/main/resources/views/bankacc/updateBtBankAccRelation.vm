<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form id="searchForm" class="layui-form">
        <input type="hidden" name="nes_id" value="$!{btBankAcc.id}" id="id"/>
        <input type="hidden" name="eqs_curId" value="$!{btBankAcc.curId}" id="curId"/>
        <input type="hidden" name="poolSign" id="poolSign" value="$!{poolSign}"/>
        <input type="hidden" name="poolId" id="poolId" value="$!{btBankAcc.poolId}"/>
		<table class="layui-table">
            <tbody>
            	<tr>
                    <td class="textRight">#springMessage("table.btBankAcc.corpId")</td>
                    #if($!{poolSign} == "1")
                        <td>
                            <div class="layui-input-inline">
                                <div class="bt-biz-selectType" data-url="" data-name="eqs_corpId" data-biz-name="eqs_corpId"
                                     data-valuefield="corpId" data-textfield="showName" data-search="true"></div>
                            </div>
                        </td>
                    #else
                        <td>
                            <div class="layui-inline">
                                <div class="bt-biz-corp"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-name="eqs_corpId"
                                     data-scope="all"
                                     data-resource="netbank:bankAcc:btBankAccRelation:query"></div>
                            </div>
                        </td>
                    #end
                	<td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json" defaultVal="$!{btBankAcc.bankTypeId}"
                             data-name ="eqs_bankTypeId" data-biz-name ="eqs_bankTypeId"  data-valueField="id" data-textField="typeName"></div>
                    </td>
                </tr>
                <tr>
                	<td class="textRight">#springMessage('table.btBankAcc.attributeId')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/bankacc/bisaccattribute/json"
                             data-valuefield="id" data-textfield="attributeName" data-name="eqs_attributeId"
                             data-inputvalue="inputvalue" data-search="true" defaultVal="$!{btBankAcc.attributeId}"></div>
                    </td>
                    <td class="textRight">#springMessage('table.btBankAcc.bankAcc')</td>
                    <td>
                    	<input type="text" id="likes_bankAcc" name="likes_bankAcc" value="$!{btBankAcc.bankAcc}" class="layui-input" placeholder="#springMessage('table.btBankAcc.bankAcc')"/>
                    </td>
                </tr>
                <tr>
                	<td align="center" colspan="4">
                        <button class="layui-btn" lay-submit lay-filter="search" id="send">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.btBankAcc.bankAcc')</th>
                <th>#springMessage('table.btBankAcc.accName')</th>
                <th>#springMessage('table.btBankAccCur.cur')</th>
                <th>#springMessage('table.btBankAcc.bankName')</th>
                <th>#springMessage('table.btBankAcc.corpId')</th>
                <th>#springMessage('table.btBankAcc.attributeId')</th>
                <th>#springMessage('table.btBankAcc.bifName')</th>
                <th>#springMessage('table.btBankAcc.natureId')</th>
            </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btBankAccRelation.edit.js?_btv=${resourceVersion}"></script>
</html>
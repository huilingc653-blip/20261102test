<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <div class="layui-fluid">
        <table class="layui-table">
            <thead>
            <tr>
                <td colspan="4">#springMessage('table.externalCorp.basicInfo')</td>
            </tr>
            </thead>
            <tbody>
            <tr>
                ##UKey编号
                <td class="textRight">#springMessage('table.bankacc.btnetukey.UKey')</td>
                <td>
                    <input type="text" name="ukeyNo" lay-verify="required|strlength"
                           data-maxlength="60"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.bankacc.btnetukey.UKey')">
                </td>
                <td class="textRight">#springMessage('table.nisPersonnelDetail.corpId')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-name="corpId"
                             data-biz-name="corpId"
                             data-resource="netbank:bankAcc:btnetukey:query"
                             data-required="true"
                             data-scope="all"></div>
                    </div>
                </td>
            </tr>
            <tr>
                ##银行类型
                <td class="textRight">#springMessage('table.ratBkration.bankType')</td>
                <td>
                    <div data-name="bankTypeId" class="bt-biz-selectType"
                         data-url="${basePath}/basic/business/btbanktype/json"
                         data-valueField="id"
                         data-textField="typeName"
                         data-required="true"
                         data-biz-name="bankType"
                         data-search="true"></div>
                </td>
                ##银行账户
                <td class="textRight"><span class="pl"><span class="required-icon">*</span>#springMessage('table.nisBillhead.bankAcc')</td>
                <td>
                    <div>
                        <div class="layui-input-inline">
                            <button class="layui-btn bt-biz-mulSelectUserPage" type="button" data-beforeClick="bt.selectInfo" data-callback="bt.selectData">#springMessage('common.button.select')</button>
                            <button class="layui-btn bt-biz-mulViewUserPage" type="button" data-beforeClick="bt.viewBank" data-callback="bt.viewBank">#springMessage('common.button.view')</button>
                            <input type="hidden" name="bankAccIds">
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                ##银行权限
                <td class="textRight">#springMessage('table.bankacc.btnetukey.bankLimit')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-required="true" data-name="bankLimit"
                         data-group="bank.permissions" data-callback="bt.permission"></div>
                </td>
                ##个人权限
                <td class="textRight">#springMessage('table.bankacc.btnetukey.personalLimit')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-required="true" data-name="personalLimit" data-biz-name="personalLimit" data-disabled="true"
                         data-group="personal.permissions"></div>
                </td>
            </tr>
            <tr>
                ##保管人
                <td class="textRight">#springMessage('table.bankacc.btnetukey.custodian')</td>
                <td>
                    <input type="hidden" name="custodianId">
                    <input type="text" class="layui-input custodianId" lay-verify="required|tableData">
                    <table id="custodianId" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('rasShopGrant.loginAcc')</th>
                            <th>#springMessage('table.guaLog.createName')</th>
                        </tr>
                        </thead>
                    </table>
                </td>
                ##UKey用户
                <td class="textRight">#springMessage('table.bankacc.btnetukey.uKeyUser')</td>
                <td>
                    <input type="text" name="ukeyUserId" lay-verify="strlength"
                           data-maxlength="32"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.bankacc.btnetukey.uKeyUser')">
                </td>
            </tr>
            <tr>
                ##监交人
                <td class="textRight">#springMessage('table.bankacc.btnetukey.supervisor')</td>
                <td>
                    <input type="hidden" name="supervisorId">
                    <input type="text" class="layui-input supervisorId" lay-verify="tableData">
                    <table id="supervisorId" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('rasShopGrant.loginAcc')</th>
                            <th>#springMessage('table.guaLog.createName')</th>
                        </tr>
                        </thead>
                    </table>
                </td>
                ##网银登录名
                <td class="textRight">#springMessage('网银登录名')</td>
                <td>
                    <input type="text" name="ebankLoginName" lay-verify="strlength"
                           data-maxlength="32"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('网银登录名')">
                </td>
            </tr>
            <tr>
                ##启用日期
                <td class="textRight">#springMessage('table.bankacc.btnetukey.openDate')</td>
                <td>
                    <input type="text" name="openDate" class="layui-input bt-input-inline bt-biz-dateType" lay-verify="required" data-endid="led_reqDate" data-today="true">
                </td>
                ##到期日期
                <td class="textRight">#springMessage('table.cmsProvideLoanSend.repayDate')</td>
                <td>
                    <input type="text" name="expireDate" class="layui-input bt-input-inline bt-biz-dateType" lay-verify="required" id="led_reqDate">
                </td>
            </tr>
            <tr>
                ##是否总部保管
                <td class="textRight">#springMessage('是否总部保管')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-required="true" data-name="isHeadCustodian"
                         data-group="sf_yn"></div>
                </td>
                <td class="textRight"></td>
                <td></td>
            </tr>
            <tr>
                <td colspan="4">#springMessage('table.bankacc.btnetukey.rpaInfo')</td>
            </tr>
            </thead>
            <tbody>
            <tr>
                ##网银登陆账号
                <td class="textRight" width="20%">#springMessage('table.bankacc.btnetukey.rpa.loginAccount')</td>
                <td colspan="3">
                    <input type="text" name="loginAccount"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.bankacc.btnetukey.rpa.loginAccount')">
                </td>
            </tr>
            <tr>
                ##机器号/IP地址
                <td class="textRight" width="20%">#springMessage('table.bankacc.btnetukey.rpa.ipAddress')</td>
                <td width="30%">
                    <input type="text" name="ipAddress"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.bankacc.btnetukey.rpa.ipAddress')">
                </td>
                ##端口号
                <td class="textRight" width="20%">#springMessage('table.bankacc.btnetukey.rpa.port')</td>
                <td width="30%">
                    <input type="text" name="port"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.bankacc.btnetukey.rpa.port')">
                </td>
            </tr>
            <tr>
                ##密码设备号
                <td class="textRight" width="20%">#springMessage('table.bankacc.btnetukey.rpa.passwordNo')</td>
                <td width="30%">
                    <input type="text" name="passwordNo"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.bankacc.btnetukey.rpa.passwordNo')">
                </td>
                ##密码组
                <td class="textRight" width="20%">#springMessage('table.bankacc.btnetukey.rpa.cipherSuite')</td>
                <td width="30%">
                    <input type="text" name="cipherSuite"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.bankacc.btnetukey.rpa.cipherSuite')">
                </td>
            </tr>
            <tr>
                <td colspan="4" align="center">
                    <button class="layui-btn" lay-submit="" lay-filter="submit" value="95">#springMessage(
                        'common.button.save')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
    </div>
    <!-- 附件上传 -->
    <input id="attachmentId" name="attachmentId" type="hidden" value="">
    <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btNetUKey.add.js?_btv=${resourceVersion}"></script>
</html>
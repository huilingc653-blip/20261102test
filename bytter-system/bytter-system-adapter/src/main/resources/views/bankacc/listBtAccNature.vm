<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight">#springMessage('btAccNature.natureCode')</td>
					<td width="40%">
                        <input type="text" name="likes_natureCode"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('btAccNature.natureCode')">
                    </td>
					<td class="textRight">#springMessage('btAccNature.natureName')</td>
					<td width="40%">
                        <input type="text" name="likes_natureName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('btAccNature.natureName')">
                    </td>
                </tr>
    			<tr >
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    				</td>
    			</tr>
            </tbody>
		</table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('btAccNature.natureCode')</th>
            <th>#springMessage('btAccNature.natureName')</th>
            <th>#springMessage('btAccNature.rmk')</th>
            <th>#springMessage('btAccNature.validSign')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/btAccNature.list.js?_btv=${resourceVersion}"></script>
</html>

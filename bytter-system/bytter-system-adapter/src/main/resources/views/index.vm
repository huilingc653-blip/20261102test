    <script type="text/javascript">
        // $.get(basePath + "/sys/corp/initCorpRouter", function (json) {
        // }, 'JSON');
        var bytter_dict = store.get('bytter_dict')
        if(!bytter_dict){

            $.get(basePath + "/dict", function (json) {
                if (!json) {
                    return;
                }
                var dict = {};
                for (var i = 0; i < json.length; i++) {
                    var temp = json[i];
                    var tempGroupCode = temp.groupCode;
                    if (!dict[tempGroupCode]) {
                        dict[tempGroupCode] = {};
                    }
                    if (!dict[tempGroupCode][temp.code]) {
                        dict[tempGroupCode][temp.code] = {name: temp.name, index: i, code: temp.code};
                    }
                }
                store.remove('bytter_dict');//清除 liuyj 2018-06-05
                //  store.set('bytter_dict', dict);
                try{
                    store.set('bytter_dict', dict);
                }catch (e) {
                    bt.dictContext = dict;
                }
                //store.set('bytter_dict', JSON.stringify(dict));
            }, 'JSON');
        }else{
            bt.dictContext = store.get('bytter_dict')
        }

        $.post(basePath + "/sys/dict/allDictGroup", function (json) {
            if (!json) {
                return;
            }
            var dictGroup = new Array();
            for (var i = 0; i < json.length; i++) {
                var temp = json[i];
                if(temp && temp.groupCode){
                    dictGroup.push({"groupCode":temp.groupCode,"groupName":temp.groupName});
                }
            }
            try{
                store.set('bytter_dictGroup', dictGroup);
            }catch (e) {
                bt.dictContextGroup = dictGroup;
            }
        }, 'JSON');
        // 开启同步加载资源，确保子应用可以拿到权限
        $.ajaxSettings.async = false;
        //设置cadn
        var loginName = '$shiro.getPrincipal().loginName';
        $.ajax({
                url: basePath + "/sys/user/getCadnByLoginName",
                method: 'GET',
                data: {loginName:loginName},
                dataType: 'json',
                success: function (data) {
                 	store.set('cadn',data);
                }
            });



        /**
         * 获取用户资源权限
         * 避免使用用户角色资源判断权限，加载太慢导致页面报错
         * zuoy 2019-06-25
         * */
        $.get(basePath + "/userResource", function (json) {
            if (json) {
                store.remove('bytter_userresource');
                //store.set('bytter_userresource', json);
                try{
                    bt.userResource = json;
                    store.set('bytter_userresource', json);
                }catch (e) {
                    bt.userResource = json;
                }
            }
        }, 'JSON');

        /**
         * 获取用户单位资源权限
         *
         */
        $.get(basePath + "/resource", function (json) {
            if (json) {
                console.log(json);
                try {
                    store.remove('bytter_resource');//清除 liuyj 2018-06-05
                    bt.userCorpResource = json;
                    store.set('bytter_resource', json);
                } catch (error) {
                    //报错则表示store存储的数据大小超出了限制
                    //console.log('catch:', error);
                    bt.userCorpResource = json;
                    // var dataLength = 0;
                    // for (var key in json) {
                    //     dataLength++;
                    // }
                    // dfsIndexSaveResourcesToStore(json, dataLength);
                }
            }
        }, 'JSON');
        /**
         * 递归存储特殊资源权限
         * Created by chenlw on 2019/04/29.
         *
         * @param bytter_resource
         * @param dataLength
         */
        function dfsIndexSaveResourcesToStore(bytter_resource, dataLength) {
            try {
                var limitLength = dataLength / 2, length = 0;
                if (limitLength <= 0) {
                    return;
                }
                var bytter_resourceTemp = {};
                for (var key in bytter_resource) {
                    if (length < limitLength) {
                        length++;
                        bytter_resourceTemp[key] = bytter_resource[key];
                    }
                }
                store.remove('bytter_resource');
                store.set('bytter_resource', bytter_resourceTemp);

            } catch (error) {
                //报错则表示store存储的数据大小超出了限制，取数据的一半再次存储，若再次报错，递归下一轮再取一半数据存储。直到不报错或取一半数据的长度变为0。
                if (dataLength / 2 >= 1) {
                    dfsIndexSaveResourcesToStore(bytter_resource, dataLength / 2);
                } else {
                    store.remove('bytter_resource');
                    store.set('bytter_resource', {});
                }
            }
        }
        var bytter_lang = store.get('bytter_lang')
        if(!bytter_lang){
            $.ajax({
                url: basePath + "/lang", type: 'get', async: false, dataType: 'json',
                success: function (json) {
                    if (!json) {
                        return;
                    }
                    var lang =  {};
                    for (var i = 0; i < json.length; i++) {
                        lang[json[i].langKey] = json[i].langContext;
                    }
                    window.mutiLang = lang;
                    store.remove('bytter_lang');//清除 liuyj 2018-06-05
                    bt.bytterMutiLang = lang;
                    // store.set('bytter_lang', lang);
                    try {
                        store.set('bytter_lang', lang)
                    }catch (e) {

                    }
                }
            });
        }else{
            window.mutiLang = bytter_lang;
            bt.bytterMutiLang = bytter_lang;
        }


        //获取拥有批量撤消功能的url集合,并存贮在bt.tablUrl中
        var url = basePath + '/bpm/flowCategory/revokableUrl';
        $.get(url, function (res) {
            if (res) {
                bt.tableUrl = res;
            }
        }, "json");
        //获取汇率小数位数
        // $.ajaxSettings.async = false;
        var paramsConvert = {
            typeId: "40439bffb86146d8a12ebfc05e23a785"
        };
        $.post(basePath +"/basic/business/btratetype/getRateDecimalPlaces", paramsConvert, function (result) {
            if(result){
                store.remove('bytter_excRateConvert');
                //store.set('bytter_excRateConvert', result);
                try {
                    store.set('bytter_excRateConvert', result);
                    bt.excRateConvert = result;
                }catch (e) {
                    bt.excRateConvert = result;
                }
            }
        }, 'JSON');
        var paramsBudget = {
            typeId: "927d1b39382c4078987ddd1561428c71"
        };
        $.post(basePath +"/basic/business/btratetype/getRateDecimalPlaces", paramsBudget, function (result) {
            if(result){
                store.remove('bytter_excRateBudget');
               // store.set('bytter_excRateBudget', result);
                try {
                    store.set('bytter_excRateBudget', result);
                    bt.excRateBudget = result;
                }catch (e) {
                    bt.excRateBudget = result;
                }
            }
        }, 'JSON');
        $.ajaxSettings.async = true;

    </script>

        '/sub-netbank/': {
            name: 'bt_subsystem_netbank',
            entry: isdev?'http://192.168.8.223:3301':'/bt_subsystem_netbank/',
            container: '#' + window.BT_MICRO_APP_CONFIG.microAppContainerId,
            props: { basePath: basePath,sendInfo }
        },
        // 基础模板测试
        '/sub-custbasic/': {
            name: 'bt_subsystem_custbasic', // 新子应用唯一名称，不能重复
            entry: isdev?'http://192.168.8.223:3302':'/bt_subsystem_custbasic/', // 新子应用的访问地址
            container: '#' + window.BT_MICRO_APP_CONFIG.microAppContainerId,
            props: { basePath: basePath,sendInfo }
        }
        ,
        '/sub-finance/': {
            name: 'bt_subsystem_finance', // 新子应用唯一名称，不能重复
            entry: isdev?'http://192.168.8.223:3302':'/bt_subsystem_finance/', // 新子应用的访问地址
            container: '#' + window.BT_MICRO_APP_CONFIG.microAppContainerId,
            props: { basePath: basePath,sendInfo }
        },
        '/sub-other/': {
            name: 'bt_subsystem_other', // 新子应用唯一名称，不能重复
            entry: isdev?'http://192.168.8.223:3302':'/bt_subsystem_other/', // 新子应用的访问地址
            container: '#' + window.BT_MICRO_APP_CONFIG.microAppContainerId,
            props: { basePath: basePath,sendInfo }
        }
    };
    console.log('微前端子应用配置',window.microAppConfigs)

    // 主应用全局
    window.__TabEventBus = {
        list: [],
        // 订阅：pageTabId 订阅刷新
        onRefresh(pageTabId, cb) {
            // 存：哪个tab、回调是什么
            this.list.push({ pageTabId, cb });
        },
        // 触发：指定某个tab刷新
        emitRefresh(pageTabId) {
            this.list.forEach(item => {
                if(item.pageTabId === pageTabId){
                    item.cb();
                }
            })
        },
        // 页面销毁取消订阅
        offRefresh(pageTabId, cb) {
            this.list = this.list.filter(x =>!x.pageTabId===pageTabId);
        }
    };

    // 初始化qiankun
    function initQianKun() {
        if (!window.qiankun) {
            console.warn('qiankun未加载');
            return;
        }

        window.qiankun.start({
            singular: false,
            sandbox: { experimentalStyleIsolation: false },
            loadScriptMode: 'fetch',
            autoRegister: false,
            disableGlobalState: true,
            excludeAssetFilter: function() {
                return true;
            }
        });
    }

    function getSubLang(){
        if (!window.MASTER_I18N) {
            // === 获取当前语言 ===
            var lang = 'zh-CN';
            // === 合并目标对象 ===
            var allLangData = {};

            function mergeLangResponse(json) {
                if (Array.isArray(json)) {
                    for (var i = 0; i < json.length; i++) {
                        var item = json[i];
                        if (item && typeof item.keyId === 'string' && item.context != null) {
                            allLangData[item.keyId] = item.context;
                        }
                    }
                }
            }

            $.ajax({
                url: basePath + "/lang/internationBase?lang=" + encodeURIComponent(lang),
                type: "GET",
                async: false,
                dataType: "json"
            }).done(mergeLangResponse).fail(function() {
                // 可选错误处理
            });

            $.ajax({
                url: basePath + "/lang/internation?lang=" + encodeURIComponent(lang),
                type: "GET",
                async: false,
                dataType: "json"
            }).done(mergeLangResponse).fail(function() {
                // 可选错误处理
            });
            // === 挂载最终结果 ===
            window.MASTER_I18N = allLangData;
        }
    }
    getSubLang();

    // ========== 微前端配置结束 ==========


    $(function () {
        initScreenTimer($!configTag.getConfig('sys','screenTime'));
        // 解决锁屏刷新可以看到页面的内容的问题
        setTimeout(function () {
            $("#layoutBox").css('display','block');
        },100)

        // 锁屏 按钮显示
        $('#lockInput').focus(function () {
            if($(this).val()){
                $('#unlock').show()
            }
        })
        $('#lockInput').on('input propertychange',function () {
            if($(this).val()){
                $('#unlock').show()
            }
        })
        $('#lockInput').blur(function () {
            if(!$(this).val()){
                $('#unlock').hide()
            }
        })
    });
    // 注册常用菜单的hover事件
    function hoverCommonMenus() {
        $("#commonMenus").find('.common-menu-item').unbind('mouseenter').unbind('mouseleave')
        $("#commonMenus").find('.common-menu-item').hover(function () {
            var title = $(this).find('.common-menu-name').data('title')
            layer.tips(title, $(this), {time: 300000,
                tips: [1, "#666666"]});
        },function () {
            layer.closeAll('tips')
        })
    }

</script>
<script>
    var baseUrl = window.location.host
    var prot = window.location.protocol
    var wsPrefix = "ws";
    if("https:" == prot){
        wsPrefix="wss"
    }
    var ws = new WebSocket(wsPrefix + "://" + baseUrl + "/ws/$shiro.getPrincipal().id");
    ws.onopen = function() {
        console.log("open websocket...");
    };

    //close event
    ws.onclose = function() {
        console.log("close websocket...");
    };

    // 响应onmessage事件:
    ws.onmessage = function(msg) {
        //这里可以处理接收到服务器的数据
        console.log(msg);
        if(msg&&msg.data){
            var result = JSON.parse(msg.data);
            switch (result.type) {
                case "HOME_NOTICE":
                    loadPendingInformation();
                    Notice.fn.checkNotificationNumber();
                    break
                case "UI_UPDATE":
                    layer.open({
                        title: '系统风格变更' ,
                        btn: ['确认'],
                        content: '系统风格已经修改，请刷新！！',
                    })
                    break
                case "KICK_OUT":case "TOKEN_EX":
                    layer.open({
                        title: "登陆失效" ,
                        btn: ['确认'],
                        content: result.msg,
                        yes:function(index){
                            var pathUrl = basePath + '/oauth/logout';
                            $.get(pathUrl, function (json) {
                                //清除缓存的内容
                                clearCookies()
                                store.clearAll();
                                if (json.success) {
                                    // 清除cookie token
                                    document.cookie = "Access-Token="+store.set('Access-Token')+"; expires=" + new Date(0).toUTCString();
                                    location.href=basePath+"/login";
                                    layer.close(index);
                                }else{
                                    location.href=basePath+"/login";
                                    //抛异常?
                                }
                            }, 'JSON');
                        }
                    })
                    break
                default:
                    break
            }
        }
    };
</script>

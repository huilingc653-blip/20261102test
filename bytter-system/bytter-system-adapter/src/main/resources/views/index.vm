<div class="tab-more-container" id="tabMoreContainer"></div>
<script>
    bt.use(['layer', 'navtab', 'form', 'util', 'money','element'], function () {
        var layer = bt.layer, $ = bt.jquery;

        var element = layui.element();
        $("img.lazyload").lazyload();
        //关闭chrome 浏览器缩放页面功能功能
        $('body').css('zoom', 'reset');

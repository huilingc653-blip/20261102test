            $(".t2-tab-open").removeClass("t2-tab-open")
            // 隐藏tab更多的弹框
            $('#tabMoreContainer').hide()
        });
        //执行ESC键关闭弹框
        $(document).on('keydown', function (event) {
            var event = window.event || event;
            if (event.keyCode == 27) {
                layer.closeAll();
            }
            if (event.keyCode == 27) {
                layer.closeAll();
            }
        })


        // 子应用菜单
        $.get(basePath + "/getMenuList", function (res) {
            if (res) {
                var microMenuList = res.obj||[];
                window.microMenuList=microMenuList;
                initQianKun();
            }
        }, 'JSON');
    });

    // ========== 微前端配置==========
    var basePath = "${basePath}";
    var isdev=false;
    var sendInfo={
        login:{
          token: $.cookie("Access-Token") || "",
          username:$(".login-name").text(),
          extraInfo:{usernameStr:$(".user-name").text()},

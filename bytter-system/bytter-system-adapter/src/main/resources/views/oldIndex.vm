        <div class="layui-body my-body" >
            <a href="javascript:;" id="menuExpand" class="menu-toggle-btn t2-menu-toggle" title="#springMessage('sys.index.menuOpen')">
                <span class="font_family icon-zuodaohangzhankaianniu"></span>

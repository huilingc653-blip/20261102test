        <div class="layui-side" id="menuLeft">
            <span class="t2-menu-search">
                <input placeholder="#springMessage('sys.home.widget.search')" id="searchTree" autocomplete="off" type="text" class="span2" readonly onfocus="this.removeAttribute('readonly');" x-webkit-speech="" lang="zh-CN" x-webkit-grammar="builtin:translate">
                <span class="font_family icon-sousuo1"></span>
            </span>
            <div class="layui-side-content">
                <div class="layui-side-mini">
                    <ul class="bt-nav">
                        #foreach($menu in $menuList)
                            <li>
                                #if($menu.url)
                                    <a href="javascript:;" name="${menu.name}" data-name="${menu.name}"
                                       href-url="${basePath}$!{menu.url}" data-id="${menu.id}" data-type="tabAdd">
                                        #if($!{configTag.getConfig('sys','uiStyle')} == "1")
                                            ##新版UI
                                            <span class="iconfont #if($menu.icon) ${menu.icon}#else bysidebar_a#end"></span>
                                        #else
                                            ##旧版UI
                                            <span class="font_family #if($menu.oldIcon) ${menu.oldIcon}#else icon-jichupingtai1#end"></span>
                                        #end
                                        <span class="menu-arrow-tips menu-nav-tips">&nbsp;</span>
                                    </a>
                                #else
                                    <a href="javascript:;" data-name="${menu.name}" data-id="${menu.id}">
                                        #if($!{configTag.getConfig('sys','uiStyle')} == "1")
                                            ##新版UI
                                            <span class="iconfont #if($menu.icon) ${menu.icon}#else bysidebar_a#end"></span>
                                        #else
                                            ##旧版UI
                                            <span class="font_family #if($menu.oldIcon) ${menu.oldIcon}#else icon-jichupingtai1#end"></span>
                                        #end
                                        <span class="menu-arrow-tips menu-nav-tips">&nbsp;</span>
                                    </a>
                                #end
                            </li>
                        #end
                    </ul>
                </div>
                <div class="layui-side-scroll">
                    <ul id="sideMenuNav" class="tree treeFolder collapse bt-nav">
                        #foreach($menu in $menuList)
                            <li level="${menu.level}">
                                <a autobypy="bz" dataType="topmenu" childMneu="menus${menu.id}" data-id="${menu.id}" keyboard="A" class="menu-level${menu.level}" href="javascript:;"
                                   #if($menu.url)href-url="${basePath}$!{menu.url}" data-type="tabAdd"#end>
                                    #if($!{configTag.getConfig('sys','uiStyle')} == "1")
                                        ##新版UI
                                        <span class="iconfont-left iconfont #if($menu.icon) ${menu.icon}#else bysidebar_a#end"></span>
                                    #else
                                        ##旧版UI
                                        <span class="font_family #if($menu.oldIcon) ${menu.oldIcon}#else icon-jichupingtai1#end"></span>
                                    #end
                                    <span class="menu-name">$!{menu.name}</span>
                                    <span class="menu-border-left"></span>
                                </a>
                                #if(!$menu.url)
                                    <span class="bt-nav-more">
                                        <span class="font_family icon-zhankai_zuodaohang bt-nav-next"></span>
                                    </span>
                                    #oldMenuTemplate1($menu.children,0,$menu)
                                #end
                            </li>
                        #end
                    </ul>

                    #macro(oldMenuTemplate1 $menus $index $parent)
                        <ul id="menus${parent.id}"  class="bzmenus_sub">
                            #foreach($menu in $menus)
                                #set($hasChildren=$menu.children && $menu.children.size()>0)

                                <li level="${menu.level}" class="#if(!$hasChildren)menu-last-li #end">
                                    <a autobypy="$menu.id" class="menu-level${menu.level}" title="$!{menu.name}" href="javascript:;"
                                       #if($!menu.url)href-url="${basePath}$!{menu.url}" data-id="${menu.id}" data-type="tabAdd"
                                       name="$!{menu.name}" menu-collect #end>
                                        ##                                        <span class="font_pos"><i class="external_small"></i></span>
                                        #if(!$hasChildren)
                                            <span class="menu-last-text">&bull;</span>
                                        #end
                                        <span class="menu-name">$!{menu.name}</span>
                                    </a>
                                    <span class="bt-nav-more">
                                        #if($hasChildren)
                                             <span class="font_family icon-zhankai_zuodaohang bt-nav-next"></span>
                                        #else

                                            #if(!$lists.contains($menuCollectIds,$menu.id))
                                                ##                    添加收藏菜单
                                                <span class="font_family icon-xingxing_kongxin bt-menu-collect"></span>
                                            #else
                                                ##                    取消收藏菜单
                                                <span class="font_family icon-xingxing bt-menu-collect"></span>
                                            #end
                                        #end
                                    </span>
                                    #if($hasChildren)
                                        #oldMenuTemplate1($menu.children,1,$menu)
                                    #end
                                </li>
                            #end
                        </ul>
                    #end
                </div>
            </div>
        </div>
    </div>
    ##锁屏

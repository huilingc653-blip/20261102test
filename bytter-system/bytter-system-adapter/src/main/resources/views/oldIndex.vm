##                            <input type="password" autocomplete="new-password" placeholder="#springMessage('sys.login.enterPassword')" class="lock-srk" readonly onfocus="this.removeAttribute('readonly');">
                        </div>
                        <div>
                            <button type="button" class="unlock-btn" id="unlock">#springMessage('sys.user.button.unlock')</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    bt.use(['layer', 'navtab', 'form', 'util', 'money'], function () {
        var layer = bt.layer, $ = bt.jquery;
        $("img.lazyload").lazyload();
        //关闭chrome 浏览器缩放页面功能功能
        $('body').css('zoom', 'reset');

        // 解决锁屏刷新可以看到页面的内容的问题
        setTimeout(function () {
            $("#layoutBox").remove();
        },100)

        $(document).keydown(function (event) {
            //event.metaKey mac的command键
            if ((event.ctrlKey === true || event.metaKey === true) && (event.which === 61 || event.which === 107 || event.which === 173 || event.which === 109 || event.which === 187 || event.which === 189)) {
                event.preventDefault();
            }
        });
        $(window).bind('mousewheel DOMMouseScroll', function (event) {
            if (event.ctrlKey === true || event.metaKey) {
                event.preventDefault();
            }
        });
        //初始化tab
        bt.navtab.init();
        //美化滚动条
        $(".layui-side-content").mCustomScrollbar({theme: "minimal-dark"});

        //mini菜单弹出tips开始
        var leftNavEnterTimer = 0;
        var leftNavLeaveTimer = 0;
        $('.layui-side-mini li').mouseenter(function (e) {
            var that = $(this).find('a');
            clearTimeout(leftNavEnterTimer);
            leftNavEnterTimer = setTimeout(function () {
                var title = that.data("name");
                layer.closeAll('tips');
                layer.tips(title, that.find('.menu-arrow-tips'), {time: 30000});
            }, 50);
        }).mouseleave(function () {
            clearTimeout(leftNavLeaveTimer);
            leftNavLeaveTimer = setTimeout(function () {
                layer.closeAll('tips');
            }, 50)
        });
        //mini菜单弹出tips结束
//        菜单收缩开始
        var menuToggleFunc = function (that,open) {
            if ($('.my-body').hasClass('my-body-expand') && !open) {
                $('.my-body').removeClass('my-body-expand');
                $('.layui-side-scroll').hide();
                $('.layui-side-mini').show();
                $('.layui-side').addClass('layui-side-collapse').removeClass('layui-side-expand');
                // 展开菜单
                that.attr('title', bt.lang('sys.index.menuOpen')).removeClass("t2-menu-toggle-expand");
                // that.find('i').removeClass('fa-angle-double-left').addClass('fa-angle-double-right');
                that.find('.font_family ').addClass('icon-zuodaohangzhankaianniu').removeClass('icon-zuocedaohangshouqianniu');
            } else {
                $('.my-body').addClass('my-body-expand');
                $('.layui-side-mini').hide();
                $('.layui-side-scroll').show();
                $('.layui-side').addClass('layui-side-expand').removeClass('layui-side-collapse');
                // 收起菜单
                that.attr('title', bt.lang('sys.index.menuClose')).addClass("t2-menu-toggle-expand");
                that.find('.font_family ').removeClass('icon-zuodaohangzhankaianniu').addClass('icon-zuocedaohangshouqianniu');
            }
            adjustPendingInformationTitle();
            $.fn.dataTable.tables({visible: true, api: true}).columns.adjust();
            //设置地图的自适应模功能
            if ($('#main').is(":visible")){ //判断是不是世界地图或中国地图或大洲地图
                if (window.biz && window.biz['myChart'] && window.biz['myChart']['world']){
                    window.biz['myChart']['world'].resize();
                }
            }else if ($('#province1').is(":visible")){　//判断是不是省份柱状地图或折线图
                if (window.biz && window.biz['myChart'] && window.biz['myChart']['barChart']){
                    window.biz['myChart']['barChart'].resize();
                }
            } else if ($('#province2').is(":visible")){//判断是不是省份饼图
                if (window.biz && window.biz['myChart'] && window.biz['myChart']['pieChart']){
                    window.biz['myChart']['pieChart'].resize();
                }
            }
            //调整选项卡内容的宽度
            // adjustTabContentWidth();
        };
        //迷你菜单点击
        $('.layui-side-mini a').click(function () {
            var that = $(this);
            //如果mini菜单点开为直接打开链接则不执行
            if (that.data("type")) {
                return;
            }
            menuToggleFunc($('.menu-toggle-btn'));
            //根据id展开指定的一级菜单
            var id = $(this).data("id");
            var targetMenuElem = $("#sideMenuNav").children('li').find('[data-id="'+id+'"]');
            if (!targetMenuElem.hasClass("parent-active")){
                targetMenuElem.trigger('click');
            }
            var index = that.parents('li').index();
            var navItem = $('.layui-side-scroll .bt-nav li:eq(' + index + ') a.menu-level0');
            navClickFunc(navItem);
        });
        //展开、收起按钮点击
        $('.menu-toggle-btn').click(function () {
            menuToggleFunc($(this));
        });
        //聚焦时，展开
        $("#searchTree").on("focus",function(e){
            menuToggleFunc($('.menu-toggle-btn'),true);
        });

        $('.layui-side-content').bind("mousedown", function( event ) {
            event.preventDefault();
        }).hover(function(){
            $("#menuExpand").show();
            $("#menuExpand").animate({opacity:1})
        },function(){
            $("#menuExpand").animate({opacity:0})
        });
        //导航栏事件
        $('.t2-tab-title').on("mouseover ","li" ,function( event ) {
            $(this).next('li').find('.t2-tab-divider').hide();
        })
        $('.t2-tab-title').on("mouseout ","li" ,function( event ) {
            $(this).next('li').find('.t2-tab-divider').show();
        });
//菜单收缩结束
        //菜单点击事件
        var activeClassName = 'active';
        var navClickFunc = function (that) {
            var parent = that.parent();
            var level = parent.attr('level');

            //菜单为第一级，且为点开直接打开链接则不执行展开操作
            if (level == "0" && that.data("type")) {
                return;
            }
            if (that.data('id')) {
                return;
            }
            parent.siblings().removeClass(activeClassName);
            if (parent.hasClass('bt-nav-item')) {
                parent.siblings().find('.bt-nav-more i.fa-minus').removeClass('fa-minus').addClass('fa-plus');
            } else {
                parent.siblings().find('.bt-nav-more i.fa-angle-down').removeClass('fa-angle-down').addClass('fa-angle-right');
            }
            if (!parent.hasClass(activeClassName)) {
                parent.addClass(activeClassName);
                if (parent.hasClass('bt-nav-item')) {
                    that.siblings('.bt-nav-more').find('i').addClass('fa-minus');
                } else {
                    that.siblings('.bt-nav-more').find('i').addClass('fa-angle-down');
                }
            } else {
                parent.removeClass(activeClassName);
                if (parent.hasClass('bt-nav-item')) {
                    that.siblings('.bt-nav-more').find('i').removeClass('fa-minus');
                } else {
                    that.siblings('.bt-nav-more').find('i').removeClass('fa-angle-down');
                }
            }
        }
        //查看登录信息
        $(".show-loginInfo-btn").click(function () {
            bt.navtab.addNavtab(bt.lang('sys.index.loginInfo'), basePath + "/sys/loginLog/userLoginInfo");
        });
        //查看个人信息
        $('.view-userinfo-btn').click(function () {
            layer.open({
                type: 2,
                title: bt.lang('sys.index.selfInfo'),
                area: ['450px', '380px'],
                content: basePath + "/sys/user/view/$shiro.getPrincipal().id"
            });
        });
        //修改密码点击
        $('.modify-pwd-btn').click(function () {
            layer.open({
                type: 2,
                // 修改密码
                title: bt.lang('sys.index.editPassword'),
                area: ['410px', '250px'],
                content: basePath + "/sys/user/modifyPassword"
            });
        });
        $('.message-btn').click(function () {
        });
        $('.bg-btn').click(function () {
            bgImg = $(this).attr("value");
            $("body").css("background", "url('" + basePath + "/static/images/bg/" + bgImg + "') no-repeat top center fixed");
            var url = basePath + "/sys/config/saveSkin";
            $.ajax({
                type: "post",
                async: false, //同步执行
                url: url,
                data: {content: bgImg},
                dataType: "json", //返回数据形式为json
                success: function (result) {
                    parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                }
            });
        });
        $('.bg-btn').mouseover(function () {
            $("body").css("background", "url('" + basePath + "/static/images/bg/" + $(this).attr("value") + "') no-repeat top center fixed");
        });
        $('.bg-btn').mouseout(function () {
            $("body").css("background", "url('" + basePath + "/static/images/bg/" + bgImg + "') no-repeat top center fixed");
        });

//        退出系统按钮
        $('.logout-btn').click(function () {
            // 是否退出系统
            // layer.confirm(bt.lang('sys.index.isExit'), {icon: 3}, function (index) {
            //     location.href = basePath + '/oauth/logout';
            //     //清除缓存的内容 liuyj 2018-06-05
            //     // store.remove('rateType');
            //     // store.remove('bytter_dict');
            //     // store.remove('bytter_resource');
            //     // store.remove('bytter_lang');
            //     store.clearAll()
            //
            //     layer.close(index);
            // });
            layer.confirm(bt.lang('sys.index.isExit'), {icon: 3}, function (index) {
                var pathUrl = basePath + '/oauth/logout';
                $.get(pathUrl, function (json) {
                    //清除缓存的内容
                    clearCookies()
                    store.clearAll();
                    if (json.success) {
                        // 清除cookie token
                        // document.cookie = "Access-Token="+store.set('Access-Token')+"; expires=" + new Date(0).toUTCString();
                        location.href=basePath+"/login";
                        layer.close(index);
                    }else{
                        location.href=basePath+"/login";
                        //抛异常?
                    }
                    //清除缓存的内容
                    clearCookies()
                    store.clearAll();
                }, 'JSON');
            });
        });

        $.get(basePath + "/sys/user/checkUserPassword", function (json) {
            if (json.success) {
                if (json.params && parseInt(json.params[0]) !== 3) {
                    layer.alert(json.msg, {icon: 0}, function () {
                        layer.closeAll();
                        layer.open({
                            type: 2,
                            // 修改密码
                            title: bt.lang('sys.index.editPassword')/*'修改密码'*/,
                            area: ['350px', '250px'],
                            closeBtn: parseInt(json.params[0]),
                            content: basePath + "/sys/user/modifyPassword"
                        });
                    });
                }
            }
        }, 'JSON');

        var adjustTabContent = function () {
            var documentElem = $(document);
            var win = $(window);
            var cardTitleHeight = documentElem.find(".layui-tab[lay-filter='card'] ul.layui-tab-title").innerHeight();
            // 需要减去的高度
            var height = win.height() - $('.layui-header').height() - cardTitleHeight;
            // 设置高度
            // documentElem.find(".layui-tab[lay-filter='card'] div.layui-tab-content").height(height);
            $('#tab-content').height(height);

            //设置选项卡内容的宽度
            adjustTabContentWidth();

            if (!documentElem.find('li[lay-id="0"]').hasClass('layui-this')) {
                // bt.navtab.refreshCurrentTable();
            }
        }
        //设置选项内容的宽度
        var adjustTabContentWidth = function () {
            var width = $(".layui-layout-body").width();
            if ($(document).find('.layui-side-expand')[0]) {
                width = width - 250;
            } else {
                width = width - 100;

            }
            $(document).find('.my-body').width(width);
        }

        function adjustPendingInformationTitle(){
            bt.each($(".content-boby-name"),function () {
                var $c = $(this)
                        .clone()
                        .css({display: 'inline', width: 'auto', visibility: 'hidden'})
                        .appendTo('body');

                var c_width = $c.width();
                    $c.remove();
                if ( c_width > $(this).width() ){
                    $(this).attr('title',$(this).text())
                }else {
                    $(this).removeAttr('title')
                }
            })
        }
        adjustTabContent();
        // 左侧菜单容器高度设置
        var menuWrapperHeight = $("#menuLeft").height();
        $(".layui-side-content").height( menuWrapperHeight- 50 );
        // 自适应
        $(window).on('resize', function () {
            adjustTabContent();
            // 左侧菜单容器高度设置
            var menuWrapperHeight = $("#menuLeft").height();
            $(".layui-side-content").height( menuWrapperHeight- 60 );
            adjustPendingInformationTitle();
            $(".t2-tab-open").removeClass("t2-tab-open")
        });
        //执行ESC键关闭弹框
        $(document).on('keydown', function (event) {
            var event = window.event || event;
            if (event.keyCode == 27) {
                layer.closeAll();
            }
            if (event.keyCode == 27) {
                layer.closeAll();
            }
        })

        //首页待处理信息栏点击事件
        $("#workFlow").on("click",".content-information-item",function () {
            var title   = $(this).find(".content-boby-name").text().trim();      // 导航栏text
            var src     = basePath + $(this).attr('href-url');   // 导航栏跳转URL
            bt.navtab.addNavtab(title,src)
        });

    });
    $(function () {
        initScreenTimer($!configTag.getConfig('sys','screenTime'));
    });
</script>
<script>
    var baseUrl = window.location.host
    var ws = new WebSocket("ws://" + baseUrl + "/ws/$shiro.getPrincipal().id");
    ws.onopen = function() {
        console.log("open websocket...");
    };

    //close event
    ws.onclose = function() {
        console.log("close websocket...");
    };

    // 响应onmessage事件:
    ws.onmessage = function(msg) {
        //这里可以处理接收到服务器的数据
        console.log(msg);
        if(msg&&msg.data){
            var result = JSON.parse(msg.data);
            switch (result.type) {
                case "HOME_NOTICE":
                    loadPendingInformation();
                    break
                case "UI_UPDATE":
                    layer.open({
                        title: '系统风格变更' ,
                        btn: ['确认'],
                        content: '系统风格已经修改，请刷新！！',
                    })
                    break
                default:
                    break
            }
        }
    };
</script>

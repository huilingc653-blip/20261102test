                $(ele).siblings('.login-icon-right').addClass('layui-hide')
            } else {
                $(ele).siblings('.login-icon-right').removeClass('layui-hide')
            }
        }
        // 解决ie11、ie10自动触发input事件
        if (!!window.ActiveXObject || 'ActiveXObject' in window) {
            _theCount++
            if (_theCount < 3) {
                return
            }
            if(isAccBlur){
                isAccBlur=false
                return
            }
            if(ispwBlur==false){
                ispwBlur=true
            }
        }
        $(ele).attr('placeholder','')
    }


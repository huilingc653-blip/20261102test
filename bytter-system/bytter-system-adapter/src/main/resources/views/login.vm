            if( timeOutForRipple['ripple'] || timeOutForRipple['ripple1'] || timeOutForRipple['ripple2']){
                return
            }
            var target = this;
            createRipple(e, target, 'ripple')
            timeOutForRipple['ripple2'] = setTimeout(function () {

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" action="">
    <table class="layui-table">
        <tbody>
        <tr>
        ## 上级菜单
            <td class="textRight">#springMessage('sys.menu.menuParent')</td>
            <td>
                <input type="hidden" id="parentId" value="$!{menu.parentId}">
                <div class="layui-input-inline">
                    <div class="menu-parentId"></div>
                </div>
            </td>
        </tr>
        <tr>
        ## 菜单名称
            <td class="textRight">#springMessage('sys.menu.name')</td>
            <td>
                <input type="hidden" name="id" value="$!{menu.id}">
                <div class="layui-input-inline">
                    <input type="text" name="name" lay-verify="required|name" autocomplete="off" placeholder="#springMessage('sys.menu.name.show')" class="layui-input" value="$!{menu.name}">
                </div>
                <span data-toggle="i18n" data-type="base" data-key-id="$!{menu.id}"/>
            </td>
        </tr>
        <tr>
        ## URL
            <td class="textRight">URL</td>
            <td>
                <input type="text" name="url" lay-verify="url" autocomplete="off" placeholder="URL" class="layui-input" value="$!{menu.url}">
            </td>
        </tr>
        <tr>
        ## 代码编号
            <td class="textRight">#springMessage('sys.menu.codeNumber')</td>
            <td>
                <input type="text" name="code" lay-verify="code" autocomplete="off" placeholder="#springMessage('sys.menu.codeNumber.show')" class="layui-input" value="$!{menu.code}">
            </td>
        </tr>
        <tr>
        ## 是否启用
            <td class="textRight">#springMessage('sys.menu.isEnable')</td>
            <td>
                <input type="checkbox" #if(!$menu.status || $menu.status==1) checked #end name="status" lay-skin="switch" lay-filter="switchTest" lay-text="#springMessage("sys.user.yesOrNo")">
            </td>
        </tr>
        <tr>
        ## 是否是模块
            <td class="textRight">#springMessage('sys.menu.isModule')</td>
            <td>
                <input type="checkbox" #if($menu.isModule==1) checked #end name="isModule" lay-skin="switch" lay-text="#springMessage("sys.user.yesOrNo")">
            </td>
        </tr>
        <tr>
        ## 是否是二开菜单
            <td class="textRight">#springMessage('sys.menu.isExtend')</td>
            <td>
                <input type="checkbox" #if($menu.isExtend==1) checked #end name="isExtend" lay-skin="switch" lay-text="#springMessage("sys.user.yesOrNo")">
            </td>
        </tr>
        <tr>
        ## 图标
            <td class="textRight">#springMessage('sys.menu.icon')</td>
            <td>
                <input type="text" name="icon" lay-verify="icon" autocomplete="off" class="layui-input" value="$!{menu.icon}">
            </td>
        </tr>
        <tr>
        ## 排序
            <td class="textRight">#springMessage('common.message.sort')</td>
            <td>
                <input type="text" name="sort" lay-verify="sortVerify" autocomplete="off" placeholder="#springMessage('sys.menu.sort.scanShow')" class="layui-input" value="$!{menu.sort}">
            </td>
        </tr>
        <tr>
        ## 菜单描述
            <td class="textRight">#springMessage('sys.menu.description')</td>
            <td>
                <textarea placeholder="#springMessage('sys.menu.description.show')" class="layui-textarea" lay-verify="required|description" name="description">$!{menu.description}</textarea>
            </td>
        </tr>
        </tbody>
    </table>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="menuSubmit">#springMessage('common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
    <script src="${basePath}/static/modules/sys/menu/menu.view.js?_btv=${resourceVersion}"></script>
</body>
</html>

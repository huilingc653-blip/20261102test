<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-input-inline{
            width: auto !important;
        }
    </style>
</head>
<body>
<input type="hidden" id="categoryId" value="$!{category.id}">
<form class="layui-form">
    <div class="layui-form-item">
##        上级分类
        <label class="layui-form-label">#springMessage('sys.notification.category.parent')</label>
        <div class="layui-input-inline">
            <input type="hidden" id="categoryParentId" value="$!{category.parentId}">
            <input type="hidden" id="categoryMenuId" value="$!{category.menuId}">
            <div class="notificationCategory-parentId"></div>
        </div>
    </div>
    <div class="layui-form-item">
##        名称
        <label class="layui-form-label"><span style="color: red">*</span> #springMessage('sys.notification.name')</label>
        <div class="layui-input-inline">
            <input type="hidden" name="id" value="$!{category.id}">
##            消息推送分类名称
            <input type="text" name="name" lay-verify="required|name" autocomplete="off" placeholder="#springMessage('sys.notification.message.categoryName')" class="layui-input" value="$!{category.name}">
            <span data-toggle="i18n" data-key-id="$!{category.id}"/>
        </div>
    </div>
    <div class="layui-form-item">
##        排序
        <label class="layui-form-label">#springMessage('common.message.sort')</label>
        <div class="layui-input-inline">
##            排序值
            <input type="text" name="sort" lay-verify="sort" autocomplete="off" placeholder="#springMessage('common.message.sortValue')" class="layui-input" value="$!{category.sort}">
        </div>
    </div>
    <fieldset class="layui-elem-field layui-field-title">
##        本数据为最终节点时填写以下信息
        <legend>#springMessage('sys.notification.dataShow')</legend>
    </fieldset>
    <div class="layui-form-item">
##        标签名
        <label class="layui-form-label">#springMessage('sys.notification.labelName')</label>
        <div class="layui-input-inline">
            <input #if($!{category.id}) disabled="true" #end type="text" name="tag" lay-verify="tag" autocomplete="off" placeholder="消息推送后台标签名" class="layui-input" value="$!{category.tag}">
        </div>
        <div class="layui-form-mid layui-word-aux">后台代码填写常量，确保常量填写正确。填写该名称后，请选择所属菜单</div>
    </div>
    <div class="layui-form-item">
##        模版
        <label class="layui-form-label">#springMessage('sys.notification.template')</label>
        <div class="layui-input-inline">
            <input #if($!{category.id}) disabled="true" #end type="text" name="content" lay-verify="content" autocomplete="off" style="width: 500px;" placeholder="根据模版解析提醒标题信息" class="layui-input" value="$!{category.content}">
            <span data-toggle="i18n" data-key-id="$!{category.id}CategoryTpl"/>
        </div>
        <div class="layui-form-mid layui-word-aux">扩展模版属性，采用Velocity语法，调用消息通知接口的时候需要传入object对象参数</div>
    </div>

    <div class="layui-form-item">
##        所属菜单
        <label class="layui-form-label">#springMessage('sys.notification.menuBelong')</label>
        <div class="layui-input-inline">
            <div class="menu-parentId"></div>
        </div>
        <div class="layui-form-mid layui-word-aux">若下方资源未填写，则根据菜单获取用户</div>
    </div>
    <div class="layui-form-item">
##        列表跳转地址
        <label class="layui-form-label">#springMessage('sys.notification.listJump')</label>
        <div class="layui-input-inline">
##            用户点击时跳转的列表地址
            <input #if($!{category.id}) disabled="true" #end type="text" name="listUrl" lay-verify="listUrl" autocomplete="off" style="width: 400px" placeholder="#springMessage('sys.notification.listJump.userClick')" class="layui-input" value="$!{category.listUrl}">
        </div>
    </div>
    <div class="layui-form-item">
##        详情跳转地址
        <label class="layui-form-label">#springMessage('sys.notification.detailJump')</label>
        <div class="layui-input-inline">
##            用户点击时跳转的详情地址
            <input #if($!{category.id}) disabled="true" #end type="text" name="detailUrl" lay-verify="detailUrl" autocomplete="off" style="width: 400px" placeholder="#springMessage('sys.notification.detailJump.userClick')" class="layui-input" value="$!{category.detailUrl}">
        </div>
    </div>
    <div class="layui-form-item">
##        资源
        <label class="layui-form-label">#springMessage('sys.notification.resource')</label>
        <div class="layui-input-block">
            <input #if($!{category.id}) disabled="true" #end type="text" name="resourceContent" lay-verify="resourceContent" style="width: 400px" autocomplete="off" placeholder="根据资源值过滤，英文状态下逗号分隔" class="layui-input" value="$!{category.resourceContent}">
        </div>
        <div class="layui-form-mid layui-word-aux">填写了资源，则优先获取资源的用户</div>
    </div>
    <div class="layui-form-item">
##        消息类型
        <label class="layui-form-label">#springMessage('sys.notification.messageType')</label>
        <div class="layui-input-block">
##            通知
            <input type="radio" name="type" value="1" #if($category.type == 1)checked#end title="#springMessage('sys.notification.notify')">
##    待处理
            <input type="radio" name="type" value="2" #if($category.type == 2)checked#end title="#springMessage('sys.notification.toDeal')">
        </div>
##    通知类型仅提示！
        <div class="layui-form-mid layui-word-aux">#springMessage('sys.notification.notify.info')</div>
    </div>

    ## 推送企业微信
    <div class="layui-form-item">
        <label class="layui-form-label">#springMessage('sys.notification.push.weixin')</label>
        <div class="layui-input-block">
            <input type="radio" name="weixinInd" value="1" #if($category.weixinInd == 1)checked#end title="#springMessage('common.sc_yn.yes')">
            <input type="radio" name="weixinInd" value="0" #if($category.weixinInd == 0)checked#end title="#springMessage('common.sc_yn.no')">
        </div>
    </div>

    <div class="layui-form-item">
        ##        消息提醒对象
        <label class="layui-form-label">#springMessage('sys.notification.notify.object')</label>
        <div class="layui-input-inline">
            <input type="radio" lay-filter="notifyObjectType" name="notifyObjectType" value="0" title="所有角色" #if(!$category.notifyObjectType || ($category.notifyObjectType && $category.notifyObjectType=='0')) checked="" #end>
            <input type="radio" lay-filter="notifyObjectType" name="notifyObjectType" value="1" title="按角色发送" #if($category.notifyObjectType && $category.notifyObjectType=='1') checked="" #end>
            <input type="radio" lay-filter="notifyObjectType" name="notifyObjectType" value="2" title="按用户发送" #if($category.notifyObjectType && $category.notifyObjectType=='2') checked="" #end>
        </div>
        <div class="layui-form-mid layui-word-aux">勾上该选项，所有满足资源的角色用户都会收到消息提醒</div>
    </div>
    <div class="layui-form-item send-role #if($category.notifyObjectType!=1)hidden#end">
##        按角色发送
        <label class="layui-form-label">#springMessage('sys.notification.roleSend')</label>
        <div class="layui-input-block">
            #foreach($role in $roles)
                #set($currentId="")
                #foreach($notificationRole in $notificationRoles)
                    #if($role.id==$notificationRole.roleId)
                        #set($currentId = $role.id)
                    #end
                #end
                <input type="checkbox" lay-skin="primary" #if($currentId!="") checked #end title="$!{role.name}" value="$!{role.id}">
            #end
        </div>
    </div>

    <div class="layui-form-item send-user #if($category.notifyObjectType!=2)hidden#end">
        ##按用户发送
        <label class="layui-form-label">#springMessage('sys.notification.userSend')</label>
        <div class="layui-inline">
            <input type="text" id="userNames" name="userNames" style="width: 400px" autocomplete="off" placeholder="填写用户登陆名，多个用户以英文逗号分隔" class="layui-input" value="$!{userNames}">
##            <input type="hidden" id="userIds" name="userIds" class="layui-input" value="$!{userIds}">
##            <div class="bt-div-search" style="top: 1px;">
##                <button id="userIdsSearch" type="button"  title="选择">
##                    <span class="iconfont byicon_box_search"></span>
##                </button>
##            </div>
        </div>
    </div>

    <div class="layui-form-item">
        ##        重点关注
        <label class="layui-form-label">#springMessage('sys.home.widget.starTarget')</label>
        <div class="layui-input-inline">
            <input type="checkbox" #if($category.starTarget == "on") checked #end name="starTarget" lay-filter="starTarget" lay-skin="switch" lay-text="YES|NO">
        </div>
        <div class="layui-form-mid layui-word-aux">#springMessage('sys.home.widget.starTarget.desc')</div>
    </div>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
##            提交
            <button class="layui-btn" lay-submit="" lay-filter="categorySubmit">#springMessage('common.button.submit')</button>
##            重置
            <button type="button" class="layui-btn layui-btn-primary" onclick="categoryViewReset()">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>

    #parse("views/common/footer.vm")

<script src="${basePath}/static/modules/sys/notification/notification.categoryView.js?_btv=${resourceVersion}"></script>
</body>
</html>

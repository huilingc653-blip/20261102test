<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        html,body{
            height: 95%;
        }
        .menuContent{
            overflow: auto;
            height: 600px;
            padding: 10px 0;
        }
        .treeContainer{
            padding:0;
            height: 100%;
        }
        .treeContainer li.box{
            float: left;
            width: 300px;
            height: 100%;
            padding: 0 10px;
            border-right: 1px dashed #b7b7b7;
            overflow: auto;
        }
    </style>
</head>
<body>
<fieldset class="layui-elem-field layui-field-title">
    <legend>正在给“$!{module.name}”分配菜单</legend>
</fieldset>
<div class="treePositionButton layui-btn-group margin-bottom"></div>
<div class="menuContent"><ul class="treeContainer"></ul></div>
<input type="hidden" name="moduleId" value="$!{module.id}" />
<input type="hidden" name="hiddenModuleMenuIds" value="$!{hiddenModuleMenuIds}" />
<div style="text-align: center;" class="padding-top">
    <button class="layui-btn add ">#springMessage('common.button.save')</button>
    <button class="layui-btn close">#springMessage('common.button.close')</button>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/module/module.assign.js?_btv=${resourceVersion}"></script>
</body>
</html>
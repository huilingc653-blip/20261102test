<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form">
    <input type="hidden" name="id" id="id" value="$!{module.id}">
    <input type="hidden" name="parentId" id="parentId" value="$!{module.parentId}">
    <input type="hidden" name="icon" id="icon" value="$!{module.icon}">
    <table class="layui-table">
        <tbody>
        ##  上级模块
        <tr>
            <td class="text-right">#springMessage('sys.module.parent')</td>
            <td>
                <div class=layui-inline>
                    <div class="module-parentId"></div>
                </div>
            </td>
        </tr>
        ##  模块名称
        <tr>
            <td class="text-right">#springMessage('sys.module.name')</td>
            <td>
                <input type="text" name="name" lay-verify="required|name" autocomplete="off"
                       placeholder="#springMessage('sys.module.name.show')" class="layui-input" value="$!{module.name}">
            </td>
        </tr>
        ##  排序
        <tr>
            <td class="text-right">#springMessage('common.message.sort')</td>
            <td>
                <input type="text" name="sort" lay-verify="sortVerify" autocomplete="off"
                       placeholder="#springMessage('sys.menu.sort.scanShow')" class="layui-input"
                       value="$!{module.sort}">
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="moduleSubmit">#springMessage(
                'common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>

    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/module/module.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
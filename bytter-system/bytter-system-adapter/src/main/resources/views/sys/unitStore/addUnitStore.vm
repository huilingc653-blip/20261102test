<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .time-zone .layui-form-selected dl {
            width: 300px;
            text-align: left;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##所属单位
            <td class="textRight" width="16%">
                #springMessage('单位')
            </td>
            <td width="34%">
                <div class="bt-biz-corp"
                     data-tree-type="radio"
                     data-biz-name="corpId"
                     data-type="selectTree"
                     data-name="corpId"
                     data-required="true"
                     data-defaultvalue="$!{corpId}"
                     data-placeholder="#springMessage('单位')">
                </div>
            </td>
            <td class="textRight">#springMessage('仓库编码')</td>
            <td>
                <input type="text" id="storeCode" name="storeCode" lay-verify="required"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('仓库编码')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('仓库名称')</td>
            <td>
                <input type="text" id="storeName" name="storeName" lay-verify="required"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('仓库名称')">
            </td>

        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/sys/unitStore/unitStore.add.js?_btv=${resourceVersion}"></script>

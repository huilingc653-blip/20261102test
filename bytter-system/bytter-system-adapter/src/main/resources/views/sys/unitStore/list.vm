<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('单位')</td>
            <td width="34%">
                <div class="bt-biz-corp"
                     data-tree-type="radio"
                     data-biz-name="corp_Id"
                     data-type="selectTree"
                     data-name="corp_Id"
                     data-defaultvalue="$!{corp_Id}"
                     data-placeholder="#springMessage('单位')">
                </div>
            </td>
            <td class="textRight">#springMessage('仓库编码')</td>
            <td width="25%">
                <input type="text" name="likes_storeCode"
                       autocomplete="off" class="bank layui-input" placeholder="#springMessage('仓库编码')">
            </td>

            <td class="textRight">#springMessage('仓库名称')</td>
            <td width="25%">
                <input type="text" name="likes_storeName"
                       autocomplete="off" class="bank layui-input" placeholder="#springMessage('仓库名称')">
            </td>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('单位')</th>
        <th>#springMessage('仓库编码')</th>
        <th>#springMessage('仓库名称')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/unitStore/unitStore.list.js?_btv=${resourceVersion}"></script>
</html>

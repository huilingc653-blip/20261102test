<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-form-select input {width: 100%;}
        .text-center {text-align: center;}
        .dark-skin .i18n-table tbody tr {
            background-color: #1b1c21;
        }
        .i18n-table tbody tr .empty-td {
            border: none;
            margin-top: 60px;
        }
        .dark-skin .i18n-table {
            border: 1px solid #262936;
        }
        .dark-skin  .layui-table > tbody >tr > td {
            border: 1px solid #262936;
        }
        .layui-btn.table-btn {
            height: 24px;
        }
    </style>
</head>
<body>
<div class="layui-form">
    <input id="keyIdElement" name="keyId" type="hidden" value="$!{keyId}"/>
    <input id="typeElement" name="type" type="hidden" value="$!{type}"/>
    <table class="layui-table i18n-table" >
        <colgroup>
            <col width="10">
            <col width="100">
            <col width="150">
            <col width="50">
        </colgroup>
        <thead>
        <tr>
            <th class="text-center">No.</th>
            <th class="text-center">#springMessage("sys.lang.languageType")</th>
            <th class="text-center">#springMessage("sys.lang.codeValue")</th>
            <th class="text-center">#springMessage("common.table.thead.operation")</th>
        </tr>
        </thead>
        <tbody id="i18nItemListContainerElement"></tbody>
    </table>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block" style="margin:0;">
            <button id="addI18NItemElement" class="layui-btn">#springMessage("common.button.add")</button>
            <button class="layui-btn" lay-submit="" lay-filter="fieldMultiLangSubmit">#springMessage('common.button.submit')</button>
        </div>
    </div>
</div>
    #parse("views/common/footer.vm")
    <script src="${basePath}/static/modules/sys/i18n/view.js?_btv=${resourceVersion}"></script>
</body>
</html>

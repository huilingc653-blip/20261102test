<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm">
    <input type="hidden" name="userIds" value="$!{userIds}">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('common.ratCorp.corp')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-callbackData="bt.netChange"
                         data-scope="all"
                         data-placeholder="#springMessage('common.placeholder.select')"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('accountGrant.loginName')</td>
            <td>
                <input type="hidden" name="status" value="1">
                <input type="text" name="loginName" class="layui-input">
            </td>
            <td class="textRight">#springMessage('accountGrant.username')</td>
            <td>
                <input type="text" name="username" class="layui-input">
            </td>
        </tr>
        <tr>
            <td colspan="6" class="text-center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="userTable" class="layui-table">
    <thead>
    <tr>
        <th>#springMessage('accountGrant.loginName')</th>
        <th>#springMessage('accountGrant.username')</th>
        <th>#springMessage('common.ratCorp.corp')</th>
        <th style="width: 100px" class="queryDetail"><input type="checkbox" name="like" lay-skin="primary" lay-filter="queryDetailAll" title="#springMessage('accountGrant.detailSearch')"/></th>
        <th style="width: 100px" class="queryBalance"><input type="checkbox" name="like" lay-skin="primary" lay-filter="queryBalanceAll" title="#springMessage('accountGrant.balanceSearch')"/></th>
        <th style="width: 100px" class="transferAccounts"><input type="checkbox" name="like" lay-skin="primary" lay-filter="transferAccountsAll" title="#springMessage('table.fcSubjectDay.transfer_accounts')"/></th>
    </tr>
    </thead>
</table>
<input type="hidden" id="accountId" value="$!{accountId}" />
<input type="hidden" id="accountType" value="$!{accountType}" />
<input type="hidden" id="accountCorpId" value="$!{accountCorpId}" />
<div class="layui-form-item layui-form-submit">
    <div class="layui-input-block">
        <button class="layui-btn" type="button" id="submitAssign">#springMessage('common.button.submit')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/accountGrant/accountGrant.assignUser.js?_btv=${resourceVersion}"></script>
</body>
</html>
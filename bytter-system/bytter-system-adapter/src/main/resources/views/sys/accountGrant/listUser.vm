<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            <td class="textRight" width="10%">#springMessage('accountGrant.chooseAssignType')</td>
            <td colspan="5">
                <input type="radio" name="chooseAssignType" value="1" lay-filter="chooseAssignType" title="#springMessage('accountGrant.chooseAssignType.one')" />
                <input type="radio" name="chooseAssignType" value="2" lay-filter="chooseAssignType" title="#springMessage('accountGrant.chooseAssignType.two')" checked />
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('common.ratCorp.corp')</td>
            <td width="23%">
                <div class="layui-inline">
					 <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-callbackData="bt.netChange"
                         data-scope="all"
                         data-placeholder="#springMessage('common.placeholder.select')"></div>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('accountGrant.loginName')</td>
            <td width="24%">
                <input type="hidden" name="status" value="1">
                <input type="text" name="loginName" class="layui-input">
            </td>
            <td class="textRight" width="10%">#springMessage('accountGrant.username')</td>
            <td width="23%">
                <input type="text" name="username" class="layui-input">
            </td>
        </tr>
        <tr>
            <td colspan="6" class="text-center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="userTable" class="layui-table">
    <thead>
    <tr>
        <th>#springMessage('accountGrant.loginName')</th>
        <th>#springMessage('accountGrant.username')</th>
        <th>#springMessage('common.ratCorp.corp')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
<input type="hidden" id="accountId" value="$!{accountId}" />
<input type="hidden" id="accountType" value="$!{accountType}" />
<input type="hidden" id="accountCorpId" value="$!{accountCorpId}" />
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/accountGrant/accountGrant.listUser.js?_btv=${resourceVersion}"></script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <table class="layui-table">
        <thead>
            <tr>
##    缓存名称
            <td>#springMessage('sys.monitor.cacheName')</td>
##    新增次数
            <td>#springMessage('sys.monitor.addCount')</td>
##    更新次数
            <td>#springMessage('sys.monitor.updateCount')</td>
##    删除次数
            <td>#springMessage('sys.monitor.deleteCount')</td>
##    命中次数
            <td>#springMessage('sys.monitor.hitCount')</td>
##    命中率
            <td>#springMessage('sys.monitor.hitPercent')</td>
##    失效统计
            <td>#springMessage('sys.monitor.failureCount')</td>
##    失效次数
            <td>#springMessage('sys.monitor.failureCountNumber')</td>
##    缓存总对象数
            <td>#springMessage('sys.monitor.cacheObjectCount')</td>
            </tr>
        </thead>
        #foreach($cache in $caches)
            <tr>
                <td><a href="$!{basePath}/sys/monitor/ehcache/$!{cache.cacheName}/details">$!{cache.cacheName}</a></td>
                <td>$!{cache.putAddedCount}</td>
                <td>$!{cache.putUpdatedCount}</td>
                <td>$!{cache.removerCount}</td>
                <td>$!{cache.hitCount}</td>
                <td>$!{cache.hitRatio}</td>
                <td>$!{cache.missExpiredCount}</td>
                <td>$!{cache.missCount}</td>
                <td>$!{cache.objectCount}</td>
            </tr>
        #end
    </table>
    #parse("views/common/footer.vm")
    <script>
    </script>
</body>
</html>
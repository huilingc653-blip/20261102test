<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>

<div class="layui-tab layui-tab-brief" lay-filter="hibernateMonitorTab">
    <ul class="layui-tab-title">
        <li lay-id="home" class="layui-this" >Hibernate监控</li>
        <li lay-id="secondLevelCache">二级缓存统计</li>
        <li lay-id="queryCache">查询缓存统计</li>
        <li lay-id="entityAndCollectionCRUDCount">实体 & 集合 CRUD统计</li>
        <li lay-id="control">缓存控制</li>
    </ul>
    <div class="layui-tab-content"></div>
</div>
    #parse("views/common/footer.vm")
<script>
    layui.use('element', function(){
        var element = layui.element();
        var currentLayId;
        var getTabContent = function(layId){
            $.get(basePath + '/sys/monitor/hibernate/'+layId,function(result){
                $(".layui-tab-content").html(result);
            });
        }
        //监听Tab切换，以改变地址hash值
        element.on('tab(hibernateMonitorTab)', function(){
            var layId = this.getAttribute('lay-id');
            if(currentLayId != layId){
                currentLayId = layId;
                getTabContent(layId);
            }
        });
        getTabContent("home");
    });
</script>
</body>
</html>
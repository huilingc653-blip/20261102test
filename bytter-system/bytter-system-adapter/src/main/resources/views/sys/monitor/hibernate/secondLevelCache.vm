<h3>总体</h3>
<table class="layui-table">
    <tbody>

    <tr class="bold info">
        <td colspan="2">二级缓存统计（实体&集合缓存，不包括查询）</td>
    </tr>
    <tr>
        <td>总命中率:</td>
        <td>${secondLevelCacheHitPercent}</td>
    </tr>
    <tr>
        <td>命中次数:</td>
        <td>
            ${statistics.secondLevelCacheHitCount}
            &nbsp;&nbsp;
            平均:${secondLevelCacheHitCountAvg}次/秒
        </td>
    </tr>
    <tr>
        <td>失效次数:</td>
        <td>
            ${statistics.secondLevelCacheMissCount}
            &nbsp;&nbsp;
            平均:${secondLevelCacheMissCountAvg}次/秒
        </td>
    </tr>
    <tr>
        <td>被缓存的个数:</td>
        <td>${secondLevelCachePutCount}</td>
    </tr>

    <tr class="bold info">
        <td colspan="2">内存情况</td>
    </tr>
    <tr>
        <td style="width: 30%">当前系统使用内存:</td>
        <td>
            ${usedSystemMemory}
        </td>
    </tr>
    <tr>
        <td style="width: 30%">系统总内存:</td>
        <td>
            ${maxSystemMemory}
        </td>
    </tr>
    <tr>
        <td style="width: 30%">二级缓存使用内存:</td>
        <td>
            ${totalMemorySize}
        </td>
    </tr>
    <tr>
        <td style="width: 30%">内存中的总实体数:</td>
        <td>
            ${totalMemoryCount}
        </td>
    </tr>
    <tr>
        <td style="width: 30%">磁盘中的总实体数:</td>
        <td>
            ${totalDiskCount}
        </td>
    </tr>

    </tbody>
</table>

<br/>
<h3>详细</h3>

<table class="layui-table">
    <tbody>
    #foreach($secondLevelCache in $secondLevelCacheList)
    <tr class="bold info">
        <td colspan="2">${secondLevelCache.secondLevelCacheRegionName}</td>
    </tr>
    <tr>
        <td style="width: 30%">总命中率:</td>
        <td>${secondLevelCache.cacheHitPercent}</td>
    </tr>
    <tr>
        <td>命中次数:</td>
        <td>
            ${secondLevelCache.hitCount}
            &nbsp;&nbsp;
            平均:${secondLevelCache.hitCountAvg}次/秒
        </td>
    </tr>
    <tr>
        <td>失效次数:</td>
        <td>
            ${secondLevelCache.missCount}
            &nbsp;&nbsp;
            平均:${secondLevelCache.missCountAvg}次/秒
        </td>
    </tr>
    <tr>
        <td>往缓存中Put总次数:</td>
        <td>${secondLevelCache.putCount}</td>
    </tr>
    <tr>
        <td style="width: 30%">所占内存大小:</td>
        <td>${secondLevelCache.sizeInMemory}</td>
    </tr>
    <tr>
        <td style="width: 30%">内存中的实体数:</td>
        <td>${secondLevelCache.elementCountInMemory}</td>
    </tr>
    <tr>
        <td style="width: 30%">磁盘中的实体数:</td>
        <td>${secondLevelCache.elementCountOnDisk}</td>
    </tr>
    #end

    </tbody>
</table>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form ">
    <table class="layui-table ">
        <tbody>
        <tr>
            <td class="textRight" width="6%">#springMessage('table.btLog.userName')</td>
            <td width="19%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_username"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.btLog.userName')">
                </div>
            </td>
            <td class="textRight" width="6%">#springMessage('sys.user.loginType')</td>
            <td width="19%">
                <div class="layui-form">
                    <div class="bt-biz-dict" data-type="select"
                         data-name="eqi_type"  data-group="sys.user.loginType">
                    </div>
                </div>
            </td>
            <td class="textRight" width="6%">#springMessage('table.btLog.note')</td>
            <td width="19%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_host"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.btLog.note')">
                </div>
            </td>
            <td class="textRight" width="6%">#springMessage('table.log.loginDate')</td>
            <td width="19%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_loginDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="loginDate">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_loginDate" class="layui-input bt-input-inline bt-biz-dateType" id="loginDate">
                </div>
            </td>
        <tr>
            <td colspan="8" style="text-align:center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btLog.userName')</th>
        <th>#springMessage('table.btLog.logcontent')</th>
        <th>#springMessage('sys.user.loginType')</th>
        <th>#springMessage('table.btLog.broswer')</th>
        <th>#springMessage('table.btLog.note')</th>
        <th>#springMessage('table.log.loginDate')</th>
        <th>#springMessage('table.log.logoutDate')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/loginLog/currentUserLoginLog.index.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/plugins/js-xss/xss.min.js?_btv=${resourceVersion}"></script>
</body>
</html>

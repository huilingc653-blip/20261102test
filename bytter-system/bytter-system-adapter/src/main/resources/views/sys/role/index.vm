<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" id="searchForm">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('sys.role.code')</td>
            <td>
                <input type="text" id="roleCode" name="code" autocomplete="off" placeholder="#springMessage('sys.role.code')" class="layui-input" >
            </td>
            <td class="textRight">#springMessage('sys.role.roleName')</td>
            <td>
                <input type="text" id="roleName" name="name" autocomplete="off" placeholder="#springMessage('sys.role.roleName')" class="layui-input">
            </td>
        </tr>
        <tr>
            <td colspan="4" class="text-center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="button" id="queryReset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

   <table id="role-table"></table>

    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/role/role.index.js?_btv=${resourceVersion}"></script>
</body>
</html>
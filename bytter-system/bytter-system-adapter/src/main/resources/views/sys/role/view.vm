<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" action="">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="text-right">#springMessage('sys.role.code')</td>
            <td>
                <input type="text" #if($role.useable==2) disabled #end name="code" lay-verify="required|strlength"
                       maxlength="32" autocomplete="off" placeholder="#springMessage('sys.role.code')"
                       class="layui-input" value="$!{role.code}">
            </td>
        </tr>
        <tr>
            <td class="text-right">#springMessage('sys.role.roleName')</td>
            <td>
                <input type="hidden" name="id" value="$!{role.id}">
                <input type="hidden" name="useable" value="$!{role.useable}">
                <input type="text" #if($role.useable==2) disabled #end name="name" lay-verify="required|strlength"
                       maxlength="50"
                       autocomplete="off" placeholder="#springMessage('sys.role.roleName')" class="layui-input"
                       value="$!{role.name}">
                <span data-toggle="i18n" data-key-id="$!{role.id}"/>
            </td>
        </tr>
        <tr>
            <td class="text-right">#springMessage('sys.role.description')</td>
            <td>
                <textarea placeholder="#springMessage('sys.role.description')" style="width: 400px;" maxlength="200"
                          class="layui-textarea" name="description">$!{role.description}</textarea>
            </td>
        </tr>
        </tbody>
    </table>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" type="button" lay-filter="roleSubmit">#springMessage(
                'common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/role/role.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .time-zone .layui-form-selected dl {
            width: 300px;
            text-align: left;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <input type="hidden" name="newPage" id="newPage" value="$!{newPage}">
        <tr>
            <td class="textRight">#springMessage('营运区编码')</td>
            <td>
                <input type="text" id="operationAreaCode" name="operationAreaCode" lay-verify="required"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('营运区编码')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('营运区名称')</td>
            <td>
                <input type="text" id="operationAreaName" name="operationAreaName" lay-verify="required"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('营运区名称')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('所属省区')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="hidden" name="provinceId" id="provinceId">
                    <input type="text"  readonly="readonly" autocomplete="off" class="layui-input" placeholder="所属省区" id="systemProvinceName"/>
                    <div class="bt-div-search">
                        ## class="bt-biz-inputOperationarea" data-callback="bt.inputOperationAreaCallback"
                        <button  type="button" title="选择" id="inputProvinceIdBtn">
                            <span class="iconfont byicon_box_search"></span>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/sys/operationArea/operationArea.add.js?_btv=${resourceVersion}"></script>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-input{
            width:148px;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="joinBankType" name="joinBankType" value="$!{joinBankType}">
    <input type="hidden" id="layerType" name="layerType" value="$!{layerType}">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('营运区编码')</td>
            <td width="25%">
                <input type="text" name="likes_operationAreaCode"
                       autocomplete="off" class="bank layui-input" placeholder="#springMessage('营运区编码')">
            </td>
            <td class="textRight">#springMessage('营运区名称')</td>
            <td width="25%">
                <input type="text" name="likes_operationAreaName"
                       autocomplete="off" class="bank layui-input" placeholder="#springMessage('营运区名称')">
            </td>
        </tr>
        <tr>
            <td class="textRight">省区编码</td>
            <td width="25%">
                <input type="text" name="likes_provinceCode"
                       autocomplete="off" class="bank layui-input" placeholder="省区编码">
            </td>
            <td class="textRight">省区名称</td>
            <td width="25%">
                <input type="text" name="likes_provinceName"
                       autocomplete="off" class="bank layui-input" placeholder="省区名称">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
##                <button class="layui-btn" type="button" id="searchBtn">查询</button>
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<div>
    <table id="appTable" class="layui-table layui-form">
        <thead>
        <tr>
            <th width="30">#springMessage('营运区编码')</th>
            <th width="80">#springMessage('营运区名称')</th>
            <th>#springMessage('所属省区编码')</th>
            <th>#springMessage('所属省区名称')</th>
        </tr>
        </thead>
    </table>
</div>

    #parse("views/common/footer.vm")
<script>
    bt.use(['form','jquery','select','element','datatable','dicts','corp','dateType','moneyType','users','moneyType','btImport','region'], function () {
        var $ = bt.jquery,table;
        var region = bt.region.init();
        bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            checkbox: true,
            order: [[1, 'desc']],
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath + "/sys/operationArea/selectOperationArea"
            },
            ignoreButtons:['colvis','output','print','state'],
            buttons: [
                {
                    text:bt.lang('common.button.select'),
                    action: function ( e, dt, node, config ) {
                        // debugger;
                        if(!$("#layerType").val()){
                            bt.navtab.getCurrentDom().inputOperationAreaCallback(bt.datatable.getSelectData('#appTable'))
                            parent.layer.closeAll()
                        }else if($("#layerType").val() == 1){
                            var name = top.$('.layui-layer-iframe iframe')[0].name
                            var layerIframeWindow = top.frames[name];
                            layerIframeWindow.inputOperationAreaCallback(bt.datatable.getSelectData('#appTable'))
                            // var layerIndex = top.$('.layui-layer-iframe iframe').eq(1).parents('.layui-layer-iframe').attr('times');
                            //  parent.layer.close(layerIndex)
                        }

                    }
                }
            ]
            , columns: [
                {data: "operationAreaCode", sortable: false},
                {data: "operationAreaName", sortable: true},
                {data: "provinceCode", bSortable: false},
                {data: "provinceName", bSortable: false}
            ]
        });
    });
</script>
</body>
</html>

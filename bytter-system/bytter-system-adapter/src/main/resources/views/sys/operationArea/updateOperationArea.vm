<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{operationAreaVO.id}">
		<table class="layui-table">
			<tbody>
			<tr>
				<td class="textRight">#springMessage('营运区编码')</td>
				<td width="40%">
					<input type="text" id="operationAreaCode" name="operationAreaCode" lay-verify="required" readonly="readonly" value="$!{operationAreaVO.operationAreaCode}"
						   autocomplete="off" class="layui-input" placeholder="#springMessage('营运区编码')">
				</td>
				<td class="textRight">#springMessage('营运区名称')</td>
				<td width="40%">
					<input type="text" id="operationAreaName" name="operationAreaName" lay-verify="required"  value="$!{operationAreaVO.operationAreaName}"
						   autocomplete="off" class="layui-input" placeholder="#springMessage('营运区名称')">
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('所属省区')</td>
				<td>
					<div class="layui-input-inline">
						<input type="hidden" name="provinceId" id="provinceId" value="$!{operationAreaVO.provinceId}">
						<input type="text"  readonly="readonly" autocomplete="off" class="layui-input" placeholder="所属省区" id="systemProvinceName" value="$!{operationAreaVO.provinceName}"/>
						<div class="bt-div-search">
							## class="bt-biz-inputOperationarea" data-callback="bt.inputOperationAreaCallback"
							<button  type="button" title="选择" id="inputProvinceIdBtn">
								<span class="iconfont byicon_box_search"></span>
							</button>
						</div>
					</div>
				</td>
			</tr>
			<tr>
				<td colspan="4" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/sys/operationArea/operationArea.edit.js?_btv=${resourceVersion}"></script>
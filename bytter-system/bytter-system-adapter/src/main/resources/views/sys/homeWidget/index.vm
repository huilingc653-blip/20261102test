<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" id="searchForm">
    <table class="layui-table">
        <tbody>
        <tr>
        <tr>
            <td class="textRight">#springMessage("system.homeWidget.category")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="sys.home.widget.category" data-name="categoryId"  ></div>
            </td>
            <td class="textRight">#springMessage("system.homeWidget.pluginType")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="sys.home.widget.type" data-name="type"></div>
            </td>
            <td class="textRight">#springMessage("system.homeWidget.name")</td>
            <td>
                <input type="text" name="name" autocomplete="off" placeholder="#springMessage("system.homeWidget.name")" class="layui-input" value="$!{homeWidget.name}">
            </td>
        </tr>
        <tr>
        <tr>
            <td colspan="6" class="text-center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
##</form>
    <table id="userTable"></table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/homeWidget/homeWidget.index.js?_btv=${resourceVersion}"></script>
</body>
</html>
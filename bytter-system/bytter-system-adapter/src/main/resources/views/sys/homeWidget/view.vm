<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form">
    <input type="hidden" name="id" value="$!{homeWidget.id}" />

    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage("system.homeWidget.category")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="sys.home.widget.category" data-name="categoryId" data-defaultvalue="$!{homeWidget.categoryId}" ></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("system.homeWidget.pluginType")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="sys.home.widget.type" data-name="type" data-defaultvalue="$!{homeWidget.type}" ></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("system.homeWidget.name")</td>
            <td>
                <input type="text" name="name" autocomplete="off" placeholder="#springMessage("system.homeWidget.name")" class="layui-input" value="$!{homeWidget.name}">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("system.homeWidget.turnContent")</td>
            <td>
                <input type="text" name="content" autocomplete="off" placeholder="#springMessage("system.homeWidget.turnContent")" class="layui-input" value="$!{homeWidget.content}">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("system.homeWidget.minWidth")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="sys.home.widget.width" data-name="minWidth" data-defaultvalue="$!{homeWidget.minWidth}" ></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("system.homeWidget.maxWidth")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="sys.home.widget.width" data-name="maxWidth" data-defaultvalue="$!{homeWidget.maxWidth}" ></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("system.homeWidget.high")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="sys.home.widget.height" data-name="height" data-defaultvalue="$!{homeWidget.height}" ></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("system.homeWidget.sort")</td>
            <td>
                <input type="text" name="sort" lay-verify="required|sortVerify" autocomplete="off" placeholder="#springMessage("system.homeWidget.sort")" class="layui-input" value="$!{homeWidget.sort}">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("system.homeWidget.resourceValue")</td>
            <td>
                <input type="text" name="resourceContent" autocomplete="off" placeholder="#springMessage("system.homeWidget.resourceValue")" class="layui-input" value="$!{homeWidget.resourceContent}">
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="userSubmit">#springMessage("common.button.submit")</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage("common.button.reset")</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

    #parse("views/common/footer.vm")

<script src="${basePath}/static/modules/sys/homeWidget/homeWidget.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
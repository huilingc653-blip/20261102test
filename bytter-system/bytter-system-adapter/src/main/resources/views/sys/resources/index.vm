<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>

##添加资源
<button class="layui-btn add">#springMessage('sys.resource.add')</button>
<input type="hidden" id="menuId" value="$!{id}">
<div class="layui-form">
    <table class="layui-table layui-form dark-layui-table" lay-skin="line">
        <thead>
        <tr>
##            资源名称
            <th>#springMessage('sys.resource.name')</th>
##    权值
            <th>#springMessage('sys.notification.resourceValue')</th>
##    描述
            <th>URL</th>
##    描述
            <th>#springMessage('table.actDeModel.description')</th>
##    状态
            <th>#springMessage('common.table.status')</th>
##    操作
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
        <tbody>
        #foreach($resources in $list)
        <tr data-id="$!{resources.id}">
            <td>$!{resources.name}</td>
            <td>$!{resources.permission}</td>
            <td>$!{resources.url}</td>
            <td>$!{resources.description}</td>
            <td>
                #if($resources.status==1)
##                    启用
                    #springMessage('common.button.enable')
                #else
##                    停用
                    <span style="color: red;">#springMessage('common.button.stop')</span>
                #end
            </td>
            <td>
##                修改
                <a href="javascript:void(0)" class="update">#springMessage('common.button.update')</a>
##    删除
                <a href="javascript:void(0)" class="delete">#springMessage('common.button.delete')</a>
            </td>
        </tr>
        #end
        </tbody>
    </table>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/resources/resources.index.js?_btv=${resourceVersion}"></script>
</body>
</html>
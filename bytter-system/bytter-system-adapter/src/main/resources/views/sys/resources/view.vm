<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
    <input type="hidden" name="id" value="$!{resources.id}">
    <input type="hidden" name="menuId" value="$!{resources.menuId}"/>
    <table class="layui-table">
        <tbody>
        ##        资源名称
        <tr>
            <td class="textRight" widget="20%">#springMessage('sys.resource.name')</td>
            <td>
                <input type="text" name="name" lay-verify="name|required" autocomplete="off"
                       placeholder="#springMessage('sys.resource.name.show')" class="layui-input"
                       value="$!{resources.name}">
                <span data-toggle="i18n" data-type="base" data-key-id="$!{resources.id}"/>
            </td>
        </tr>
        ##        是否有效
        <tr>
            <td class="textRight">#springMessage('table.externalCorp.satus')</td>
            <td >
                <input type="checkbox" #if(!$resources.id || $resources.status==1) checked #end name="status"
                       lay-skin="switch" lay-text="是|否">
            </td>
        </tr>
        ##        资源值
        <tr>
            <td class="textRight">#springMessage('sys.notification.resourceValue')</td>
            <td >
                <input type="text" name="permission" autocomplete="off"
                       placeholder="#springMessage('sys.notification.resourceValue.show')"
                       class="layui-input" value="$!{resources.permission}" lay-verify="required">
            </td>
        </tr>
        <tr>
            ## URL
            <td class="textRight">URL</td>
            <td>
                <input type="text" name="url" autocomplete="off" placeholder="URL" class="layui-input" value="$!{resources.url}">
            </td>
        </tr>
        ##        资源描述
        <tr>
            <td class="textRight">#springMessage('sys.resource.description')</td>
            <td >
                <textarea placeholder="#springMessage('sys.resource.contentShow')" class="layui-textarea"
                          name="description">$!{resources.description}</textarea>
            </td>
        </tr>
        <tr>
            <td  colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="resourcesSubmit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/resources/resources.view.js?_btv=${resourceVersion}"></script>
</body>
</html>

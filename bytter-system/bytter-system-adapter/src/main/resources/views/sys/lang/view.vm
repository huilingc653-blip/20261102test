<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-form-select input {
            width:100%;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-form-item">
##        语种
        <label class="layui-form-label">#springMessage('sys.lang.languageType')</label>
        <div class="layui-input-inline" style="width: 148px;">
            <input type="hidden" name="id" value="$!{multiLang.id}">
            <select name="langCode" lay-verify="required">
                <option value=""></option>
##                中文
                <option value="zh_CN" #if($multiLang.langCode == "zh_CN")selected#end>#springMessage('sys.lang.chinese')</option>
                <option value="en_US" #if($multiLang.langCode == "en_US")selected#end>English</option>
            </select>
        </div>
    </div>


    <div class="layui-form-item">
##        代码
        <label class="layui-form-label">#springMessage('sys.lang.code')</label>
        <div class="layui-input-inline">
##            业务模块.子模块.功能
            <input type="text" style="width: 350px;" name="langKey" lay-verify="langKey" autocomplete="off" placeholder="#springMessage('sys.lang.code.show')" class="layui-input" value="$!{multiLang.langKey}" maxlength="50">
        </div>
    </div>

    <div class="layui-form-item">
##        代码值
        <label class="layui-form-label">#springMessage('sys.lang.codeValue')</label>
        <div class="layui-input-inline">
##            输入key值对应的文本内容
            <input type="text" style="width: 350px;" name="langContext" lay-verify="required" autocomplete="off" placeholder="#springMessage('sys.lang.codeValue.show')" class="layui-input" value="$!{multiLang.langContext}" maxlength="5000">
        </div>
    </div>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="multiLangSubmit">#springMessage('common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>

    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/lang/lang.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
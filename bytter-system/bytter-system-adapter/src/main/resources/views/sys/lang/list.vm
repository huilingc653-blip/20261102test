<!DOCTYPE html>
<html>
<head>
 #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form " action="" id="searchForm">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('sys.lang.languageType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="sys_lang" data-name="langCode"></div>
            </td>
            <td class="textRight">#springMessage('sys.lang.code')</td>
            <td>
                <input type="text" name="langKey" autocomplete="off" class="layui-input">
            </td>
            <td class="textRight">#springMessage('sys.lang.codeValue')</td>
            <td>
                <input type="text" name="langContext" autocomplete="off" class="layui-input">
            </td>
        </tr>
        <tr>
            <td colspan="6" class="text-center">
                <button class="layui-btn layui-btn-small" lay-submit="" lay-filter="search">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable"></table>

 #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/sys/lang/lang.list.js?_btv=${resourceVersion}"></script>
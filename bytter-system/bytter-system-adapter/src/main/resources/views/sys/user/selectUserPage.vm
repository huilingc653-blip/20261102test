<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" id="searchForm">
    <table class="layui-table">
        <tr>
            <td class="textRight" >#springMessage('sys.user.corpContain.show')</td>
            <td >
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="net"
                         data-type="selectTree"
                         data-name="corpId"
                         data-scope="all"
                         data-resource="sys:user:select"
                         data-placeholder="#springMessage('common.placeholder.select')"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('sys.user.status.show')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-group="sys.user.status" data-name="status" data-type="select"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('sys.user.loginName.show')</td>
            <td>
                <input type="text" name="loginName" class="layui-input">
            </td>
            <td class="textRight">#springMessage('sys.user.username.show')</td>
            <td>
                <input type="text" name="username" class="layui-input">
            </td>
        </tr>
        <tr>
            <td colspan="4" class="text-center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<div>
    <table id="userTable" class="layui-table">
        <thead>
        <tr>
            <th width="30">#springMessage('common.table.thead.operation')</th>
            <th>#springMessage('sys.user.loginName.show')</th>
            <th>#springMessage('sys.user.username.show')</th>
            <th>#springMessage('sys.user.corpContain.show')</th>
            <th>#springMessage('table.sysCorp.status')</th>
            <th>#springMessage('sys.user.isAdmin')</th>
            <th>#springMessage('common.table.createTime')</th>
##            <th>#springMessage('common.table.updateTime')</th>
        </tr>
        </thead>
    </table>
</div>

    #parse("views/common/footer.vm")
<script>
    bt.use(['datatable', 'jquery', 'selectType', 'corp', 'dicts'], function () {
        bt.selectType.init();
        bt.dicts.init();
        bt.corp.init();
        var layer = parent ? parent.bt.layer : bt.layer;
        var dataform = bt.dataform;
        var $ = bt.jquery;
        var table = bt.datatable.init({
            elem: "#userTable",
            selectCss: false,
            colReorder:true,
            // checkbox:true,
            ajax: {
                url: basePath + "/sys/user/datatable.json",
            },
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ignoreButtons:['colvis','output','print','state'],// 忽略的表单默认按钮 state取消状态保存按钮
            columns: [
                {
                    data: null, bSortable: false, className: 'center',
                    render: function (data, type, full, meta) {
                        return '<a href="javascript:void(0);" class="corp-select" data-row="' + meta.row + '">' + bt.lang("common.button.select") + '</a>';
                    }
                },
                {data: "loginName", orderable: false},
                {data: "username", orderable: false},
                {data: "corp", orderable: false,
                    render: function (data, type, full, meta) {
                        if (!full.corpCode) {
                            return "";
                        }
                        return "(" + full.corpCode + ")" + full.corpName;
                    }
                },
                {data: "status",className: 'center', orderable: false,
                    render: function (data, type, full, meta) {
                        return full.statusLang;
                    }
                },
                {data: "isAdmin", orderable: false,
                    render: function (data, type, full, meta) {
                        return full.isAdmin ? bt.lang('common.sc_yn.yes') : bt.lang('common.sc_yn.no');
                    }},
                {data: "createTime", orderable: false},
                // {data: "updateTime", orderable: false}
            ]
        });

        table.on('click', '.corp-select', function (event) {
            // console.log("parent.userIdLayerIndex==>" + parent.userIdLayerIndex)
            var data = table.row($(this).data('row')).data();
            top.frames['layui-layer-iframe'+parent.userIdLayerIndex].window.bt.getUerInfo(data);
        });

    });
</script>
</body>
</html>

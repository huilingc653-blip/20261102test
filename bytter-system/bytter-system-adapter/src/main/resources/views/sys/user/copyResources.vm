<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            min-width: 530px;
            width: 530px;
        }
        .ztree {
            overflow: auto;
            height: 400px;
        }
        .resource-node{
            float: left;
            background: #6ad6cb;
        }
        .resource-node span.button.center_docu,.resource-node span.button.bottom_docu{
            background-position: 25px -25px!important;
        }
    </style>
</head>
<body>
<form class="layui-form">
    <input type="hidden" id="userId" value="$!{userId}"/>
    <input type="hidden" id="sourceCorpId" value="$!{corpId}"/>
    <input type="hidden" id="userBelongCorp" value="$!{userBelongCorp}"/>
    <div class="line">
        <div class="xl12">
            <input type="text" id="corpSearch" autocomplete="off" class="layui-input">
            <a href="javascript:void(0);" id="corpSelectAll">#springMessage('common.select.all')</a>
            <span class="text-explode">|</span>
            <a href="javascript:void(0);" id="corpExpandAll">#springMessage('common.open.all')</a>
            <span class="text-explode">|</span>
            <a href="javascript:void(0);" id="corpCollapseAll">#springMessage('common.close.all')</a>
            <div class="ztree" id="corpTree"></div>
        </div>
    </div>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" id="sumitData">#springMessage('common.button.submit')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/user/user.copyResources.js?_btv=${resourceVersion}"></script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body style="min-width: 250px">
<form class="layui-form" action="">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('sys.user.loginName.show')</td>
            <td>
                $!{user.loginName}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('sys.user.username.show')</td>
            <td>
                $!{user.username}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('sys.user.corpContain.show')</td>
            <td>
                ($!{user.corp.code})$!{user.corp.name}
            </td>
        </tr>

        <tr>
            <td class="textRight">#springMessage('sys.user.phone.show')</td>
            <td>
                $!{user.phone}
            </td>
        </tr>
        <tr>
            <td class="textRight">EMAIL</td>
            <td>
                $!{user.email}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('sys.user.isAdmin')</td>
            <td>
                #if($user.isAdmin==1)
                    #springMessage('common.sc_yn.yes')
                #else
                    #springMessage('common.sc_yn.no')
                #end
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.tbLoanRateMaintence.isValid')</td>
            <td>
                #if(!$user.status || $user.status==1 )
                    #springMessage('common.sc_yn.yes')
                #else
                    #springMessage('common.sc_yn.no')
                #end
            </td>
        </tr>

        <tr>
            <td class="textRight">#springMessage('sys.user.showReport')</td>
            <td>
                #if($user.showReport && $user.showReport==1)
                    #springMessage('common.sc_yn.yes')
                #else
                    #springMessage('common.sc_yn.no')
                #end
            </td>
        </tr>

        #if($sysEncrypt && $sysEncrypt ne '0' )
            <tr>
                <td class="textRight">#springMessage('sys.user.loginType')</td>
                <td>
                    #if($user.loginType== 0 )#springMessage('sys.user.loginType.zero')#end
                    #if($user.loginType== 1 )#springMessage('sys.user.loginType.one')#end
                    #if($user.loginType== 2 )#springMessage('sys.user.loginType.two')#end
                </td>
            </tr>
        #end
    </table>
</form>
#parse("views/common/footer.vm")
</body>
</html>
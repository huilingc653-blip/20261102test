<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body style="padding: 0;">
<form class="layui-form" action="">
    <table class="layui-table">
        <tbody>
            <tr>
            ## 账号
                <td class="textRight">#springMessage('sys.user.loginName.show')</td>
                <td>
                    <input type="hidden" name="id" value="$!{user.id}">
                    <input type="text" #if($user.loginName=='admin') readonly #end name="loginName"
                           lay-verify="required|strlength" minlength="4" maxlength="30" autocomplete="off"
                           placeholder="#springMessage('sys.user.loginName')" class="layui-input" value="$!{user.loginName}">
                </td>
            </tr>
            <tr>
            ## 姓名
                <td class="textRight">#springMessage('sys.user.username.show')</td>
                <td>
                    <input type="text" #if($user.loginName=='admin') readonly #end name="username"
                           lay-verify="required|strlength" minlength="2" maxlength="30" autocomplete="off"
                           placeholder="#springMessage('sys.user.username')" class="layui-input" value="$!{user.username}">
                </td>
            </tr>
            <tr>
            ## 所属单位
                <td class="textRight"></span>#springMessage('sys.user.corpContain.show')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-name="corp.id"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-placeholder="#springMessage('sys.user.corpContain')"
                             data-required="true"
                             data-resource="sys:user:select"
                             data-defaultValue="$!{user.corp.id}"></div>
                    </div>
                </td>
            </tr>
            <tr>
            ## 手机号码
                <td class="textRight">#springMessage('sys.user.phone.show')</td>
                <td>
                    <input type="text" name="phone" autocomplete="off" placeholder="#springMessage('sys.user.phone')"
                           class="layui-input" lay-verify="phone1" maxlength="15" value="$!{user.phone}">
                </td>
            </tr>
            <tr>
            ## 邮件
                <td class="textRight">EMAIL</td>
                <td>
                    <input type="text" name="email" autocomplete="off" placeholder="EMAIL" class="layui-input"
                           lay-verify="email1" maxlength="50" value="$!{user.email}">
                </td>
            </tr>
            <tr>
            ## 是否管理员
                <td class="textRight">#springMessage('sys.user.isAdmin')</td>
                <td>
                    <input type="checkbox" #if($user.loginName=='admin') disabled #end #if($user.isAdmin==1) checked #end
                           name="isAdmin" lay-skin="switch" lay-text="#springMessage('sys.user.yesOrNo')">
                </td>
            </tr>
            <tr>
            ## 是否启用
                <td class="textRight">#springMessage('table.tbLoanRateMaintence.isValid')</td>
                <td>
                    <input type="checkbox" #if($user.loginName=='admin') disabled #end #if(!$user.status || $user.status==1)
                           checked #end name="status" lay-skin="switch" lay-filter="switchTest"
                           lay-text="#springMessage('sys.user.yesOrNo')">
                </td>
            </tr>
            <tr>
            ## 是否显示报表
                <td class="textRight">#springMessage('sys.user.showReport')</td>
                <td>
                    <input type="checkbox" #if($user.showReport && $user.showReport == 1) checked #end name="showReport"
                           lay-skin="switch" lay-text="#springMessage('sys.user.yesOrNo')">

                    <span style="vertical-align:middle;text-align: center;" class="layui-word-aux">
                        #springMessage('sys.user.showReport.rmk')
                    </span>
                </td>
            </tr>
        #if($sysEncrypt && $sysEncrypt ne '0' )
            ## 登录方式
            <tr>
                <td class="textRight">#springMessage('sys.user.loginType')</td>
                <td>
                    <input type="radio" name="loginType" value="0"
                           #if($user.id == '' || !$user.id) checked
                           #elseif($user.loginType== 0 )checked#end title="#springMessage('sys.user.loginType.zero')">
                    <input type="radio" name="loginType" value="1"
                           #if($user.loginType== 1 )checked#end title="#springMessage('sys.user.loginType.one')">
                    <input type="radio" name="loginType" value="2"
                           #if($user.loginType== 2 )checked#end title="#springMessage('sys.user.loginType.two')">
                </td>
            </tr>
        #end
        #if($isOpenFaceVerify && $isOpenFaceVerify == '1')
            ## 是否通过人脸复核
            <tr>
                <td class="textRight">#springMessage('sys.user.faceVerify')</td>
                <td>

                    #if($userFaceDetection)
                        <input type="checkbox" #if($userFaceDetection && $userFaceDetection.verifyStatus == 1) checked #end
                               name="faceVerifyStatus"
                               lay-skin="switch" lay-text="#springMessage('sys.user.yesOrNo')">
                        <br/>
                        <br/>
                        #if($userFaceDetection.verifyStatus == 1 && $userFaceDetection.face)
                            <img src="data:image/jpg;base64,$userFaceDetection.face" width="200" height="200"/>
                        #elseif($userFaceDetection.verifyStatus == 0 && $userFaceDetection.verifyFace)
                            <img src="data:image/jpg;base64,$userFaceDetection.verifyFace" width="200" height="200"/>
                        #end
                    #else
                        <span style="vertical-align:middle;text-align: center;" class="layui-word-aux">
                            #springMessage('sys.user.faceVerify.noFace')
                        </span>
                    #end
                </td>
            </tr>
        #end
                <tr>
                    ##钉钉UserID
                    <td class="textRight">#springMessage("sys.user.dingtalk.account")</td>
                    <td>
                        <input type="text" id="dingTalkUserId" placeholder="#springMessage("sys.user.dingtalk.account")" class="layui-input" value="$!{dingUserId}" maxlength="50">
                    </td>
                </tr>
                <tr>
                    ##微信UserID
                    <td class="textRight">#springMessage("sys.user.weixin.account")</td>
                    <td>
                        <input type="text" id="weiXinUserId" placeholder="#springMessage("sys.user.weixin.account")" class="layui-input" value="$!{weiUserId}" maxlength="50">
                    </td>
                </tr>
                <tr>
                    ##飞书UserID
                    <td class="textRight">#springMessage("sys.user.feishu.account")</td>
                    <td>
                        <input type="text" id="feishuUserId" placeholder="#springMessage("sys.user.feishu.account")" class="layui-input" value="$!{fsUserId}" maxlength="50">
                    </td>
                </tr>
        </tbody>
    </table>


    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="userSubmit">#springMessage(
                'common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>

    #parse("views/common/footer.vm")

<script src="${basePath}/static/modules/sys/user/user.view.js?_btv=${resourceVersion}"></script>
</body>
</html>

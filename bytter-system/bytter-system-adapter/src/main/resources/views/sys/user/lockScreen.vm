<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body style="min-width: 250px">
<form class="layui-form" action="">
    <input type="hidden" id="loginName" name="loginName" value="$!{loginName}">
    <table class="layui-table">
        <tr>
            <td>
                <div class="layui-input-inline">
                    <input type="password" name="password" lay-verify="required|checkPwd" autocomplete="off"
                           placeholder="#springMessage('sys.login.label.password')" class="layui-input">
                </div>
                <div class="layui-input-inline">
                    <button class="layui-btn" lay-submit="" lay-filter="unLockScreen">#springMessage("sys.login.button.login")</button>
                </div>
            </td>
        </tr>
        <tr>
        </tr>
    </table>
</form>

    #parse("views/common/footer.vm")

<script src="${basePath}/static/modules/sys/user/user.lockScreen.js?_btv=${resourceVersion}"></script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    #parse("views/common/caData.vm")
</head>
<body>
<form class="layui-form" id="searchForm">
    #caDataHidden()
    <table class="layui-table">
        <tr>
            <td class="textRight" >#springMessage('sys.user.corpContain.show')</td>
            <td >
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="net"
                         data-type="selectTree"
                         data-name="corpId"
                         data-scope="all"
                         data-resource="sys:user:select"
                         data-placeholder="#springMessage('common.placeholder.select')"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('sys.user.status.show')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-group="sys.user.status" data-name="status" data-type="select"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('sys.user.loginName.show')</td>
            <td>
                <input type="text" name="loginName" class="layui-input">
            </td>
            <td class="textRight">#springMessage('sys.user.username.show')</td>
            <td>
                <input type="text" name="username" class="layui-input">
            </td>
        </tr>
        <tr>
            <td colspan="4" class="text-center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
    <table id="userTable"></table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/user/user.index.js?_btv=${resourceVersion}"></script>
    #caDataScript()
</body>
</html>
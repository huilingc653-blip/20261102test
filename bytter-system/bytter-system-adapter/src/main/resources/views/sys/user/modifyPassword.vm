<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body style="min-width: 250px">
<form class="layui-form" action="">
    <input type="hidden" id="passwordModel" value="$!configTag.getConfig('sys','passwordModel')">
    <input type="hidden" id="passwordLength" value="$!configTag.getConfig('sys','passwordLength')">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('table.sysUser.oldPassword')</td>
            <td>
                $!{token}
                <input type="password" name="oldPassword" lay-verify="required" autocomplete="off"
                       placeholder="#springMessage('table.sysUser.oldPassword')" class="layui-input">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.sysUser.newPassword')</td>
            <td>
                <input type="password" name="newPassword" lay-verify="required" autocomplete="off"
                       placeholder="#springMessage('table.sysUser.newPassword')" class="layui-input">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.sysUser.newPasswordA')</td>
            <td>
                <input type="password" name="newPasswordA" lay-verify="required|checkPwd" autocomplete="off"
                       placeholder="#springMessage('table.sysUser.newPasswordA')" class="layui-input">
            </td>
        </tr>
        <tr>
            <td colspan="2" class="center">
                <button class="layui-btn" lay-submit="" lay-filter="modifySubmit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>

    #parse("views/common/footer.vm")
<script type="text/javascript" charset="utf-8" src="${basePath}/static/plugins/crypto/crypto-js.min.js"></script>
<script src="${basePath}/static/js/sm2.js"></script>
<script src="${basePath}/static/modules/sys/user/user.modifyPassword.js?_btv=${resourceVersion}"></script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" action="">
    <input type="hidden" name="id" value="$!{user.id}">

    <div class="layui-form-item">
            #foreach($role in $roles)
                #set($currentId="")
                #foreach($userRole in $user.userRoles)
                    #if($role.id==$userRole.role.id)
                        #set($currentId = $role.id)
                    #end
                #end
                <input type="checkbox" lay-skin="primary" #if($currentId!="") checked #end title="$!{role.name}" value="$!{role.id}">
            #end
    </div>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="userSubmit">#springMessage('common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>

    #parse("views/common/footer.vm")

<script src="${basePath}/static/modules/sys/user/user.assignRoles.js?_btv=${resourceVersion}"></script>
</body>
</html>
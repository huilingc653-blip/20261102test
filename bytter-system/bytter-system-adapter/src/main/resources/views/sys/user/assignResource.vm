<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body {
            padding: 10px;
        }

        .ztree {
            overflow: auto;
            height: 430px;
        }

        .resource-node {
            float: left;
        }

        .resource-node span.button.center_docu, .resource-node span.button.bottom_docu {
            background-position: 25px -25px !important;
        }

        .border-bottom-line {
            border-bottom: 1px solid #ddd;
        }

        .header-box {
            height: 40px;
            line-height: 40px;
        }

        .header-title {
            border-left: 4px solid #1E9FFF;
            font-size: 18px;
            padding-left: 6px;
        }

        .bt-selectTree-close {
            top: 4px;
        }

        .bt-selectTree-hover {
            color: #fff;
            background-color: #c2c2c2;
            border-radius: 8px;
            width: 16px;
            height: 16px;
            font-size: 12px;
            padding-left: 2px;
            padding-top: 1px;
            line-height: 15px;
            box-sizing: border-box;
        }

        input::-ms-clear, input::-ms-reveal {
            display: none;
        }

        #roleContainer a {
            height: 25px;
            display: block;
        }

        #roleContainer span.button {
            display: inline-block;
            margin: 0;
            width: 20px;
            height: 22px;
            vertical-align: middle;
            line-height: 0;
            border: 0 none;
            cursor: pointer;
            outline: none;
            background-color: transparent;
            background-repeat: no-repeat;
            background-attachment: scroll;
            background-image: url("${basePath}/static/plugins/ztree/css/metroStyle/img/zTreeStandard.png");
        }

        #roleContainer .checkbox_false {
            background-position: 1px -2px;
        }

        #roleContainer .checkbox_true {
            background-position: -18px -2px;
        }
        /* 核心样式：控制文字截断 */
        .text-ellipsis {
            /* 必须设置宽度（根据场景调整，也可设为max-width） */
            width: 100%;
            /* 强制单行显示 */
            white-space: nowrap;
            /* 超出部分隐藏 */
            overflow: hidden;
            /* 超出15字显示省略号（关键） */
            text-overflow: ellipsis;
            /* 让span支持宽度设置（span默认行内元素，需转为行内块） */
            display: inline-block;
            /* 可选：鼠标悬浮时显示手型，提升体验 */
            cursor: pointer;
        }
        .node_name.text-ellipsis {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex: 1; /* 让文字占满剩余空间 */
        }
    </style>
</head>
<body>
<form class="layui-form">
    <input type="hidden" id="userId" value="$!{userId}"/>
    <input type="hidden" id="corpId" value="$!{corpId}"/>
    <div class="layui-row layui-col-space20">
        #*单位*#
        <div class="layui-col-xs4" style="border-right: 1px dashed #ddd;">
            <div class="layui-inline">
                <input type="text" id="corpSearch" autocomplete="off" class="layui-input">
                <a href="javascript:void(0);"><i class="layui-icon bt-selectTree-close" style="right:7px;">ဆ</i></a>
            </div>

            <div class="margin-bottom border-bottom-line">
                <div class="header-box">
                    <div class="float-left">
                        <span class="header-title">#springMessage('table.nisBillhead.corpId')</span>
                    </div>
                    <div class="float-right">
                        <a href="javascript:void(0);" id="corpExpandAll">#springMessage('common.open.all')</a>
                        <span class="text-explode">|</span>
                        <a href="javascript:void(0);" id="corpCollapseAll">#springMessage('common.close.all')</a>
                    </div>
                </div>
            </div>
            #*单位的资源显示*#
            <ul class="ztree" id="corpTree" data-input="corpSearch"></ul>
        </div>
        <div class="layui-col-xs3" style="border-right: 1px dashed #ddd;">
            <div class="margin-bottom border-bottom-line header-box" style="margin-top: 24px;">
                <div class="float-left">
                    <span class="header-title">#springMessage('sys.role.roleName')</span>
                </div>
            </div>
            <div id="roleContainer" style="height: 430px;overflow: auto;"></div>
        </div>
        #*菜单资源*#
        <div class="layui-col-xs5">
            <div class="layui-inline">
                <input type="text" id="menuSearch" autocomplete="off" class="layui-input">
                <a href="javascript:void(0);"><i class="layui-icon bt-selectTree-close" style="right:7px;">ဆ</i></a>
            </div>
            <div class="margin-bottom border-bottom-line header-box">
                <div class="float-left">
                    <span class="header-title">#springMessage('sys.accountGrant.assignResouce')</span>
                </div>
                <div class="float-right">
                    <a href="javascript:void(0);" id="checkedAll">#springMessage('common.check.all')</a>
                    <span class="text-explode">|</span>
                    <a href="javascript:void(0);" id="menuExpandAll">#springMessage('common.open.all')</a>
                    <span class="text-explode">|</span>
                    <a href="javascript:void(0);" id="menuCollapseAll">#springMessage('common.close.all')</a>
                </div>
            </div>
            <ul class="ztree" id="menuTree" data-input="menuSearch"></ul>
        </div>
    </div>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" id="sumitData">#springMessage('common.button.submit')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")

<script src="${basePath}/static/modules/sys/user/user.assignResource.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{equityMaintenanceVo.id}">
		<table class="layui-table">
			<tbody>
			<tr>
				<td class="textRight">#springMessage('股权编码')</td>
				<td>
					<input type="text" id="equityCode" name="equityCode" lay-verify="required|strlength" readonly="readonly" value="$!{equityMaintenanceVo.equityCode}" data-maxlength="50" 
 autocomplete="off" class="layui-input" placeholder="#springMessage('股权编码')">
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('股权名称')</td>
				<td>
					<input type="text" id="equityName" name="equityName" lay-verify="required|strlength" value="$!{equityMaintenanceVo.equityName}" data-maxlength="100" 
 autocomplete="off" class="layui-input" placeholder="#springMessage('股权名称')">
				</td>
			</tr>
			<tr>
				<td colspan="4" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/sys/equityMaintenance/equityMaintenance.edit.js?_btv=${resourceVersion}"></script>
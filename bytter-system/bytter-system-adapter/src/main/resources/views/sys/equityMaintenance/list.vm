<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="isCheck" id="isCheck" value="0"/>
    <input type="hidden" name="poolSign" id="poolSign" value="$!{poolSign}"/>
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('股权编码')</td>
            <td width="25%">
                <input type="text" name="likes_code"
                       autocomplete="off" class="bank layui-input" placeholder="#springMessage('股权编码')">
            </td>
            <td class="textRight">#springMessage('股权名称')</td>
            <td width="25%">
                <input type="text" name="likes_name"
                       autocomplete="off" class="bank layui-input" placeholder="#springMessage('股权名称')">
            </td>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('股权编码')</th>
        <th>#springMessage('股权名称')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/equityMaintenance/equityMaintenance.list.js?_btv=${resourceVersion}"></script>
</html>

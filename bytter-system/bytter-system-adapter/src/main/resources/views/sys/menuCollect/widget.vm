#if($!{configTag.getConfig('sys','uiStyle')} == "1")

#set($basePath=$springMacroRequestContext.contextPath)
#if($menuCollects.size() > 0)
    #foreach($mc in $menuCollects)
    <div>
        <div class="common-menu-item">
            #set($num = $!velocityCount%4 + 1)
            <div class="common-menu-icon common-menu-icon-$!{num}">
                <span class="iconfont byicon_$!{num}"></span>
            </div>
            <div class="common-menu-name content-body-menu" data-title="$!{mc.parentNames}" data-id="$!{mc.menuId}" data-topparentid="$!{mc.topParentId}" mc-id="$!{mc.id}" data-name="$!{mc.name}" data-href="$!{mc.url}" data-sort="$!{mc.sort}" >$!{mc.name}</div>
            <ul class="layui-nav common-menu-operate">
                <li class="layui-nav-item">
                    <a href="javascript:;">
                        <span class="iconfont byicon_more"></span>
                    </a>
                    <dl class="layui-nav-child operate-container">
                        <dd class="operate-container-item1 menu-top">
                            <a href="javascript:;">#springMessage('sys.article.isTop')</a>
                        </dd>
                        <dd class="menu-delete">
                            <a href="javascript:;">#springMessage('common.button.delete')</a>
                        </dd>
                    </dl>
                </li>
            </ul>
        </div>
    </div>
    #end
#else
<div class="empty-data">
    <div>
        <img src="${basePath}/static/v3.2/images/pic_blank.png">
        <div class="empty-text">暂无常用菜单</div>
    </div>
</div>
#end

#else
    #if($menuCollects.size() == 0)

    <div style="font-size: 14px;text-align: center;padding-top: 50px;color: #a7a7a7;">
        ##    您还未添加菜单收藏
        #springMessage('sys.home.widget.noCommonMenus')
    </div>
    #else

        #foreach($mc in $menuCollects)
        <div class="t2-menus-item">
            <div class="layui-clear t2-drag-item">
                <span class="font_family icon-caidan fl" style="cursor: move;"></span>
                <span class="content-body-menu fl" data-id="$!{mc.menuId}" mc-id="$!{mc.id}" data-name="$!{mc.name}" data-href="$!{mc.url}" data-sort="$!{mc.sort}" >$!{mc.parentNames}</span>
                <span class="font_family menu-delete icon-changyongcaidan_shanchu1"></span>
                <span class="font_family menu-top icon-changyongcaidan_zhiding1 #if($velocityCount == 1) hide #end"></span>
            </div>
        </div>
        #end

    #end
#end
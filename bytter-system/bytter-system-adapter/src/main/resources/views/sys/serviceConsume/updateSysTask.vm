<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        html,body{height:100%;overflow-y: hidden;}
    </style>
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{sysTaskPage.id}">
		<input id="deletedsw" name="deletedsw" type="hidden" value="$!{sysTaskPage.deletedsw}">
		<input id="type" name="type" type="hidden" value="$!{sysTaskPage.type}">
		<input id="taskowner" name="taskowner" type="hidden" value="$!{sysTaskPage.taskowner}">
		<input id="createBy" name="createBy" type="hidden" value="$!{sysTaskPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{sysTaskPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{sysTaskPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{sysTaskPage.updateDate}">
        <table class="layui-table">
            <tbody>
				<tr>
					##任务名称
					<td class="textRight">#springMessage('table.sysTask.taskname')</td>
    				<td width="40%">
						<!--number-->
						<input type="text" id="taskname" name="taskname"
							    autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="100" placeholder="#springMessage('table.sysTask.taskname')" value="$!{sysTaskPage.taskname}">
											</td>
					##状态
					<td class="textRight">#springMessage('table.sysTask.active')</td>
    				<td width="40%">
                        <div class="selectactive" data-value="$!{sysTaskPage.active}"></div>
					</td>
        		</tr>
				<tr>
					##任务命令
					<td class="textRight">#springMessage('table.sysTask.command')</td>
    				<td >
                        <input type="text" id="command" name="command"
                               autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="120" placeholder="#springMessage('table.sysTask.command')" value="$!{sysTaskPage.command}">
                        <!--<div class="selectcommand" data-value="$!{sysTaskPage.command}"></div>-->
					</td>
					##执行方式
					<td class="textRight">#springMessage('table.sysTask.period')</td>
					<td >
                        <div class="selectperiod" data-value="$!{sysTaskPage.period}"></div>
					</td>
        		</tr>
				<tr>
					##任务参数
                    <td class="textRight">#springMessage('table.sysTask.arguments')</td>
                    <td colspan="3">
                        <textarea name="arguments" class="layui-textarea" style="width: 700px; height: 200px"
                                  >$!{sysTaskPage.arguments}</textarea>
                    </td>
				</tr>
                <tr>
					<td class="textRight">#springMessage('table.sysTask.cron')</td>
                    <td colspan="">
                        <input id="cron" class="layui-input" lay-verify="required" disabled="disabled" value="$!{sysTaskPage.second} $!{sysTaskPage.minute} $!{sysTaskPage.hour} $!{sysTaskPage.days} $!{sysTaskPage.month} $!{sysTaskPage.week}"/>
                    </td>
                </tr>
				<tr>
					##开始日期时间
					<td class="textRight">#springMessage('table.sysTask.startdtm')</td>
    				<td >
                        <input type="text" name="startdtm" data-type="datetime" lay-verify="required" class="layui-input bt-input-inline bt-biz-dateType" data-endid="enddtm" value="$!{sysTaskPage.startdtm}">
					</td>
					##结束日期时间
					<td class="textRight">#springMessage('table.sysTask.enddtm')</td>
					<td >
                        <input type="text" name="enddtm" data-type="datetime" lay-verify="required" class="layui-input bt-input-inline bt-biz-dateType" id="enddtm" value="$!{sysTaskPage.enddtm}">
					</td>
        		</tr>
				<tr>
					##提醒邮件
					<td class="textRight">#springMessage('table.sysTask.emailReminder')</td>
    				<td colspan="3">
						<input type="text" id="emailReminder" name="emailReminder"
							    autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="50" placeholder="#springMessage('table.sysTask.emailReminder')" value="$!{sysTaskPage.emailReminder}">
					</td>
        		</tr>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/serviceConsume/serviceConsume.edit.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
        <table class="layui-table">
            <tr>
                <td class="textRight">#springMessage('table.sysTask.taskname')</td>
                <td width="35%">$!{sysTaskPage.taskname}</td>
                <td class="textRight">#springMessage('table.sysTask.active')</td>
                <td width="35%">$dictTag.get("scheduler.status",$!{sysTaskPage.active})</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.sysTask.command')</td>
                <td width="35%">$!{sysTaskPage.command}</td>
                <td class="textRight">#springMessage('table.sysTask.arguments')</td>
                <td width="35%">$!{sysTaskPage.arguments}</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.sysTask.period')</td>
                <td width="35%">$dictTag.get("scheduler.type",$!{sysTaskPage.period})</td>
                <td class="textRight">#springMessage('table.sysTask.second')</td>
                <td width="35%">$!{sysTaskPage.second}</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.sysTask.minute')</td>
                <td width="35%">$!{sysTaskPage.minute}</td>
                <td class="textRight">#springMessage('table.sysTask.hour')</td>
                <td width="35%">$!{sysTaskPage.hour}</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.sysTask.days')</td>
                <td width="35%">$!{sysTaskPage.days}</td>
                <td class="textRight">#springMessage('table.sysTask.month')</td>
                <td width="35%">$!{sysTaskPage.month}</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.sysTask.week')</td>
                <td width="35%">$!{sysTaskPage.week}</td>
                <td class="textRight">#springMessage('table.sysTask.startdtm')</td>
                <td width="35%">$!date.format('yyyy-MM-dd HH:mm:ss',$!{sysTaskPage.startdtm})</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.sysTask.enddtm')</td>
                <td width="35%">$!date.format('yyyy-MM-dd HH:mm:ss',$!{sysTaskPage.enddtm})</td>
                <td class="textRight">#springMessage('table.sysTask.emailReminder')</td>
                <td width="35%">$!{sysTaskPage.emailReminder}</td>
            </tr>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
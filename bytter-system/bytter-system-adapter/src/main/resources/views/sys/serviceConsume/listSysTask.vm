<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##任务名称
                    <td class="textRight">#springMessage('table.sysTask.taskname')</td>
                    <td width="40%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_taskname"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.sysTask.taskname')">
                        </div>
                    </td>
                    ##状态
                    <td class="textRight">#springMessage('table.sysTask.active')</td>
                    <td width="40%">
                        <div class="layui-input-inline">
                            <div class="selectactive"></div>
                        </div>
                    </td>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.sysTask.taskname')</th>
        <th>#springMessage('table.sysTask.active')</th>
        <th>#springMessage('table.sysTask.period')</th>
        <th>#springMessage('table.sysTask.startdtm')</th>
        <th>#springMessage('table.sysTask.enddtm')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/js/dateForm.js?_btv=${resourceVersion}" charset="utf-8"></script>
<script src="${basePath}/static/modules/sys/serviceConsume/serviceConsume.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>


<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
    <legend>#springMessage('config.fundjr.title')</legend>
</fieldset>

<form class="layui-form" action="">
	<table class="layui-table">
        <thead>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
			<td width="80%">#springMessage('config.fbs.paramValue')</td>
		</tr>
        </thead>
		<tbody>
        <tr>
            <td class="textRight">#springMessage('config.fundjr.funServerAddress')</td>
            <td>
            <div class="layui-input-inline">
	        <input type="text" id="funServerAddress" name="fundjr.funServerAddress" autocomplete="off" class="layui-input" value="$!{config.fundjr.funServerAddress}" />
	    	</div>
			</td>
        </tr>
        </tbody>
    </table>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
	        <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
	        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/fundjr/fundjr.fundjrConfig.js?_btv=${resourceVersion}"></script>
</body>
</html>
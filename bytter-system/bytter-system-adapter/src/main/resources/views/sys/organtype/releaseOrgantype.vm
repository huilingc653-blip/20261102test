<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="id" name="id" value="$!{id}" />
    <table class="layui-table">
        <tbody>
        <tr>
        ##生效日期
            <td class="textRight" width="50%">#springMessage('sys.organtype.effective')</td>
            <td width="50%" >
                <input type="text" name="effectiveDate" data-name="effectiveDate" class="layui-input bt-biz-dateType" data-today="true"
                       data-biz-name="effectiveDate"  data-type="date" data-min="$!{todate}" >
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('sys.organtype.release')</button>
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>

<script language="javascript" type="text/javascript">
    var form;
    bt.use(['form','btdate','dateType'], function(){
        var $ = bt.jquery,date = new Date(),month;
        form = bt.form();
        bt.dateType.init();
        //监听提交
        form.on('submit(submit)', function (data) {
            bt.loading.show();
            var action = "/sys/organtype/organtype/release";
            var msg = bt.lang('sys.organtype.confirm.release');
            parent.layer.confirm(msg, function () {
                $.post(basePath + action, data.field, function (result) {
                    bt.loading.hide();
                    if (result.success) {
                        parent.layer ? parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}) : layer.alert(result.msg, {icon: result.success ? 1 : 2});
                        parent.layer ? parent.layer.closeAll() : layer.closeAll();
                    } else {
                        parent.layer ? parent.layer.alert(bt.lang("common.message.operate.fail"), {icon: result.success ? 1 : 2}) : layer.alert(result.msg, {icon: result.success ? 1 : 2});
                    }
                }, 'JSON');
            });
            bt.loading.hide();
            return false;
        });
    });
</script>
</html>

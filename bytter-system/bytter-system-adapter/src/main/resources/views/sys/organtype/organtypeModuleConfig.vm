<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>


<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
##    组织架构对应关系维护
    <legend>#springMessage('sys.organtype.moduleMaintain')</legend>
</fieldset>

<form class="layui-form" action="">
    <table class="layui-table">
        <thead>
        <tr>
            <th class="textRight" width="20%">#springMessage("sys.organtype.name")</th>##模块名称
            <th class="textLeft" width="80%">#springMessage("sys.organtype.organizational")</th>##组织架构
        </tr>
        </thead>
        <tr>
            <td class="textRight">$!{config.fbs.sysCodeName}</td>
            <td >
                <div class="layui-input-inline">
                    #if(!$config.fbs.orgtId)
                    <div class="bt-biz-selectType" data-biz-name="fbs" data-url="${basePath}/sys/organtype/organtype/getOrgantypeIsRelease"
                         data-valuefield="id" data-textfield="orgtName" data-name="fbs" data-search="true"
                         data-callback=""></div>
                     #else
                         $!{config.fbs.orgtName}
                     #end
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage("common.button.submit")</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/sys/organtype/organtypeModuleConfig.js?_btv=${resourceVersion}"></script>
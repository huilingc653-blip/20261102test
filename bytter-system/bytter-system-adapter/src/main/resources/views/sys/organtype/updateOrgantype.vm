<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="id" name="id" value="$!{organtypeVO.id}" />
    <input type="hidden" id="orgtNameStr" name="orgtNameStr" value="$!{organtypeVO.orgtName}" />
    <table class="layui-table">
        <tbody>
        <tr>
        ##组织架构
            <td class="textRight" width="40%">#springMessage('sys.organtype.organizational')</td>
            <td width="60%" >
                <input type="text" id="orgtName" name="orgtName"  lay-verify="required|strlength|nameCheck" data-maxlength="100"
                       value="$!{organtypeVO.orgtName}"   autocomplete="off" class="layui-input" placeholder="#springMessage('sys.organtype.organizational')">
            </td>
        </tr>
        <tr>
        ##状态
            <td class="textRight" width="50%">#springMessage('sys.organtype.status')</td>
            <td width="50%" >
                #if($!{organtypeVO.isAddCorp}==1)
                    $!{organtypeVO.validSignName}
                #else
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-type="radio" data-group="SYS_ORGANTYPE_STATUS"
                             data-required="true" data-defaultvalue="$!{organtypeVO.validSign}" data-name="validSign" data-biz-name="validSign" ></div>
                    </div>
                #end
            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight"  width="50%">#springMessage('sys.organtype.rmk')</td>
            <td width="50%">
                <input type="text" id="rmk" name="rmk"  lay-verify="strlength" data-maxlength="200" value="$!{organtypeVO.rmk}"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('sys.organtype.rmk')">
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/organtype/organtype.edit.js?_btv=${resourceVersion}"></script>
</html>

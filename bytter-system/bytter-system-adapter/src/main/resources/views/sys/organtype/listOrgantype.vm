<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .tableBox table {
            width:100%;
        }
        .tableBox thead {
            width:100%;
        }
        #corpTable, #corpTable_{
            width:100%;
            margin: 0;
            padding: 0 1px;
        }
        #corpTable tr th,#corpTable_ tr th {
            background:#F4F6FD;
            border-left: 1px solid #EBEDF1!important;
        }

        #corpTable tr th,#corpTable_ tr th {
            background:#F4F6FD;
            border-left: 1px solid #EBEDF1!important;
        }

        #corpTable tr:nth-child(even) td{
            line-height: 18px;
            height: 18px;
            background-color:#eeeeee!important;
            border-left: 1px solid #EBEDF1!important;
        }
        .dark-skin .type-table td {
            border: 1px solid #EBEDF1;
            background: #F4F6FD;
        }
        .dark-skin   #corpTable tr th,#corpTable_ tr th {
            background:#F4F6FD;
            border-left: 1px solid #EBEDF1!important;
        }
        .dark-skin  #corpTable tr:nth-child(even) td{
            line-height: 18px;
            height: 18px;
            background-color:#1B1C21!important;
            border-left: 1px solid #EBEDF1!important;
        }
        .dark-skin table.dataTable tbody tr:hover {
           background-color:#2A2B30!important
        }
    </style>
</head>
<body>

<form id="searchForm"  class="layui-form input150-container">
	<div class="layui-collapse" lay-filter="collapse">
	<div class="layui-colla-item">
	<h2 class="layui-colla-title"></h2>
	<div class="layui-colla-content layui-show">
    <table class="layui-table">
        <tbody>
        <tr>
            ##组织架构
            <td class="textRight" width="15%">#springMessage('sys.organtype.organizational')</td>
            <td width="35%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_orgtName" id="orgtName" autocomplete="off"
                           class="layui-input" placeholder="#springMessage('sys.organtype.organizational')">
                </div>
            </td>
            ##单位查询
            <td class="textRight" width="15%">#springMessage('sys.organtype.corp')</td>
            <td width="35%">
                <div class="layui-input-inline">
                    <input type="text" name="corpName" id="corpName" autocomplete="off"
                           class="layui-input" placeholder="#springMessage('sys.organtype.corp')">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" type="button" onclick="searchData()">#springMessage('common.button.search')</button>
                <button class="layui-btn layui-btn-primary" type="reset">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
	</div>
	</div>
	</div>
</form>
<div>
    <table class="layui-table type-table">
        <tr>
            <td width="33.5%" colspan="2" style="text-align: center;">
                <big><b>#springMessage("sys.organtype.organizational")</b></big>
            </td>
            <td width="66.5%" colspan="2" style="text-align: center;">
                <big><b>#springMessage("sys.organtype.corp")</b></big>
            </td>
        </tr>
    </table>
</div>
<div>
    <div>
        <div style='display:inline-block;height: 100%;' class="layui-col-md4">
            <table id="organtypeTb"  class="layui-table" >
                <thead>
                <tr>
                    <th>#springMessage("sys.organtype.name")</th>##组织架构名称
                    <th>#springMessage("sys.organtype.version")</th>##版本
                    <th>#springMessage("sys.organtype.releaseDate")</th>##发布时间
                    <th>#springMessage("sys.organtype.effective")</th>##生效日期
                    <th>#springMessage('common.table.thead.operation')</th>##操作
                </tr>
                </thead>
            </table>
        </div>
        <div style='display:inline-block;position: relative;padding-left: 5px' class="layui-col-md8">
            <div class="dt-buttons" style="display: block;margin-top: 10px">
                ##新增
                <a class="dt-button" tabindex="0"  aria-controls="organtypeTb" href="#"  onclick="addOrgtCorp()"><span>#springMessage('common.button.add')</span></a>
                ##导出
                <a class="dt-button" tabindex="0" aria-controls="organtypeTb" href="#"  onclick="excelCorp()" ><span>#springMessage('common.button.exports')</span></a>
            </div>
            <div style="padding:0;min-width:1000px;position:relative;" id="corpContainer" class="tableBox" >

                <table id="corpTable" class="layui-table">
                    <thead>
                    <tr>
                        <th width="30%">#springMessage("sys.organtype.corp")</th>##单位
                        <th>#springMessage("sys.organtype.orgType")</th>##组织类型
                        <th>#springMessage("sys.organtype.corpProperty")</th>##单位属性
                        <th>#springMessage("sys.organtype.cellManage")</th>##管理单元
                        <th>#springMessage("sys.organtype.status")</th>##状态
                        <th>#springMessage('common.table.thead.operation')</th>##操作
                    </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/sys/organtype/organtype.list.js?_btv=${resourceVersion}"></script>

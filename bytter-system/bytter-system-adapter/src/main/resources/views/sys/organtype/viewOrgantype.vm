<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="id" name="id" value="$!{organtypeVO.id}" />
    <table class="layui-table">
        <tbody>
        <tr>
        ##组织架构
            <td class="textRight" width="50%">#springMessage('sys.organtype.organizational')</td>
            <td width="50%" >
                $!{organtypeVO.orgtName}
            </td>
        </tr>
        <tr>
        ##状态
            <td class="textRight" width="50%">#springMessage('sys.organtype.status')</td>
            <td width="50%" >
                $dictTag.get("valid_sign",$!{organtypeVO.validSign})
                    #*$!{organtypeVO.validSignName}*#
            </td>
        </tr>
        #*<tr>
        ##初始化
            <td class="textRight" width="50%">#springMessage('sys.organtype.init')</td>
            <td width="50%" >
                <div class="layui-input-inline">
                    #if($organtypeVO.isInit)
                        $dictTag.get("sf_yn",$!{organtypeVO.isInit})
                    #else
                        $dictTag.get("sf_yn","0")
                    #end

                </div>
            </td>
        </tr>*#
        <tr>
        ##版本
            <td class="textRight" width="50%">#springMessage('sys.organtype.version')</td>
            <td width="50%" >
                $!{organtypeVO.orgtVersion}
            </td>
        </tr>
        <tr>
        ##发布时间
            <td class="textRight" width="50%">#springMessage('sys.organtype.releaseDate')</td>
            <td width="50%" >
                $!date.format('yyyy-MM-dd HH:mm:ss',$!{organtypeVO.releaseDate})
            </td>
        </tr>
        <tr>
        ##生效日期
            <td class="textRight" width="50%">#springMessage('sys.organtype.effective')</td>
            <td width="50%" >
                $!date.format('yyyy-MM-dd',$!{organtypeVO.effectiveDate})
            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight"  width="50%">#springMessage('sys.organtype.rmk')</td>
            <td width="50%">
               $!{organtypeVO.rmk}
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

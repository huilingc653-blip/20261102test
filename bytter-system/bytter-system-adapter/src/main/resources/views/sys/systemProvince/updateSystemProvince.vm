<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{systemProvinceVo.id}">
		<table class="layui-table">
			<tbody>
			<tr>
				<td class="textRight">省区编码</td>
				<td width="40%">
					<input type="text" id="provinceCode" name="provinceCode" lay-verify="required" readonly="readonly" value="$!{systemProvinceVo.provinceCode}"
						   autocomplete="off" class="layui-input" placeholder="省区编码">
				</td>
				<td class="textRight">省区名称</td>
				<td width="40%">
					<input type="text" id="provinceName" name="provinceName" lay-verify="required"  value="$!{systemProvinceVo.provinceName}"
						   autocomplete="off" class="layui-input" placeholder="省区名称">
				</td>
			</tr>
			<tr>
				<td colspan="4" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/sys/systemProvince/systemProvince.edit.js?_btv=${resourceVersion}"></script>
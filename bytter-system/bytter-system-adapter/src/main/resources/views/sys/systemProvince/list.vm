<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="isCheck" id="isCheck" value="0"/>
    <input type="hidden" name="poolSign" id="poolSign" value="$!{poolSign}"/>
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">省区编码</td>
            <td width="25%">
                <input type="text" name="likes_provinceCode"
                       autocomplete="off" class="bank layui-input" placeholder="省区编码">
            </td>
            <td class="textRight">省区名称</td>
            <td width="25%">
                <input type="text" name="likes_provinceName"
                       autocomplete="off" class="bank layui-input" placeholder="省区名称">
            </td>
        </tr>
        <tr>
            <td class="textRight">状态</td>
            <td>
                <div class="layui-input-inline">
                    <div class=bt-biz-dict data-type="select" data-name="eqs_status" data-group="SYS_ORGANTYPE_STATUS"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" id="searchId" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>省区编码</th>
        <th>省区名称</th>
        <th>状态</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/systemProvince/systemProvince.list.js?_btv=${resourceVersion}"></script>
</html>

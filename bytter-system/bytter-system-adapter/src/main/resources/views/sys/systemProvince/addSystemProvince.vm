<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .time-zone .layui-form-selected dl {
            width: 300px;
            text-align: left;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">省区编码</td>
            <td>
                <input type="text" id="provinceCode" name="provinceCode" lay-verify="required"
                       autocomplete="off" class="layui-input" placeholder="省区编码">
            </td>
        </tr>
        <tr>
            <td class="textRight">省区名称</td>
            <td>
                <input type="text" id="provinceName" name="provinceName" lay-verify="required"
                       autocomplete="off" class="layui-input" placeholder="省区名称">
            </td>

        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/sys/systemProvince/systemProvince.add.js?_btv=${resourceVersion}"></script>

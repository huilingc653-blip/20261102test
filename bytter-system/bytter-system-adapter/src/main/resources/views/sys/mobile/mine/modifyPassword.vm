<!DOCTYPE html>
    #set($basePath=$springMacroRequestContext.contextPath)
<html>
<head>
    <meta charset="utf-8">
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no,minimum-scale=1.0,maximum-scale=1.0">
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <title>修改密码</title>
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css"/>
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/base.css"/>
    <link rel="stylesheet" href="${basePath}/static/css/mobile/index.css"/>

    <style>
        .ui-tab-nav-multi li {
            display: inline;
        }

        body {
            background: #fff;
        }

        input::-webkit-input-placeholder {
            color: #666;
        }

        .input-label {
            width: 90px;
            text-align: center;
            word-wrap: break-word;
        }

        .hide-element {
            display: none;
        }

    </style>

</head>
<body>

<input type="hidden" id="passwordModel" value="$!{passwordModel}">
<input type="hidden" id="passwordLength" value="$!{passwordLength}">

<div class="ui-form ui-border-t">
    <div style="height: 15px;"></div>

    <form action="" onsubmit="return false;">
        <div class="ui-form-item ui-border-b ">
            <label class="input-label" style="text-align: right;">
                旧密码
            </label>
            <input id="inputOldPasswordElement" type="password" placeholder="旧密码">
            <a id="inputOldPasswordCleanElement" href="javascript:;"
               onclick="cleanPasswordInput('inputOldPasswordElement','inputOldPasswordCleanElement')"
               class="ui-icon-close hide-element"></a>
        </div>

        <div class="ui-form-item ui-border-b ">
            <label class="input-label" style="text-align: right;">
                新密码
            </label>
            <input id="inputNewPasswordElement" type="password" placeholder="新密码">
            <a id="inputNewPasswordCleanElement" href="javascript:;"
               onclick="cleanPasswordInput('inputNewPasswordElement','inputNewPasswordCleanElement')"
               class="ui-icon-close hide-element"></a>
        </div>
        <div class="ui-form-item ui-border-b">
            <label class="input-label" style="text-align: right;">
                确认新密码
            </label>
            <input id="inputConfirmPasswordElement" type="password" placeholder="确认新密码">
            <a id="inputConfirmPasswordCleanElement" href="javascript:;"
               onclick="cleanPasswordInput('inputConfirmPasswordElement','inputConfirmPasswordCleanElement')"
               class="ui-icon-close hide-element"></a>
        </div>
        <div class="ui-btn-wrap">
            <button style="background: linear-gradient(270deg, #79D7FF 0%, #3672FF 100%);" onclick="doModifyPassword()"
                    class="ui-btn-lg ui-btn-primary">
                确定
            </button>
        </div>
    </form>

    <div class="ui-whitespace">
        <p id="showPasswordLengthMsgElement" class="ui-txt-info">密码长度：</p>
        <p id="showPasswordModelMsgElement" class="ui-txt-info">密码组成方式：</p>
    </div>
    <br/>
    <div class="ui-whitespace">
        <p class="ui-txt-info">温馨提示：密码修改后将即刻生效，如忘记原密码，请联系系统管理员重置后再进行修改。</p>
    </div>

</div>

<script src="${basePath}/static/mobile/plugins/zepto/zepto.min.js?_btv=${resourceVersion}"></script>
<script type="text/javascript" charset="utf-8"
        src="${basePath}/static/plugins/crypto/crypto-js.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/plugins/web-view/webView.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/mobile/js/webViewScriptBridage.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">


    $(document).ready(function () {
        showPasswordLengthMsg();
        showPasswordModelMsg();

        // 监听输入框变化，动态显示【清除】按钮
        $('#inputOldPasswordElement').bind('input propertychange', function () {
            var value = $(this).val();
            if (value.length === 0) {
                $("#inputOldPasswordCleanElement").hide();
            } else {
                $("#inputOldPasswordCleanElement").show();
            }
        });

        $('#inputNewPasswordElement').bind('input propertychange', function () {
            var value = $(this).val();
            if (value.length === 0) {
                $("#inputNewPasswordCleanElement").hide();
            } else {
                $("#inputNewPasswordCleanElement").show();
            }
        });

        $('#inputConfirmPasswordElement').bind('input propertychange', function () {
            var value = $(this).val();
            if (value.length === 0) {
                $("#inputConfirmPasswordCleanElement").hide();
            } else {
                $("#inputConfirmPasswordCleanElement").show();
            }
        });

    });

    function showAppToast(message, type) {
        BTAppBridge && BTAppBridge.showToast && BTAppBridge.showToast(message, {
            type: type
        });
    }

    function doModifyPassword() {
        var inputOldPasswordElement = $('#inputOldPasswordElement');
        var inputNewPasswordElement = $('#inputNewPasswordElement');
        var inputConfirmPasswordElement = $('#inputConfirmPasswordElement');

        var oldPassword = inputOldPasswordElement.val();
        var newPassword = inputNewPasswordElement.val();
        var confirmPassword = inputConfirmPasswordElement.val();

        if (oldPassword.trim().length === 0) {
            showAppToast('请输入旧密码');
            $("#inputOldPasswordElement").focus();
            return false;
        }
        var inputNewPasswordElement = $("#inputNewPasswordElement");
        if (newPassword.trim().length === 0) {
            showAppToast('请输入新密码');
            inputNewPasswordElement.focus();
            return false;
        }
        if (confirmPassword.trim().length === 0) {
            showAppToast('请输入确认密码');
            $("#inputConfirmPasswordElement").focus();
            return false;
        }

        var minLength = $("#passwordLength").val() ? Number($("#passwordLength").val()) : 6;
        if (newPassword.length < minLength) {
            // 密码长度过小
            showAppToast("密码最小长度为" + minLength + '位');
            return false;
        }
        if (oldPassword === newPassword) {
            // 新密码不能和旧密码相同
            showAppToast("新旧密码不能一致");
            return false;
        }
        if (newPassword !== confirmPassword) {
            showAppToast("两次输入的新密码不一致");
            return false;
        }
        var passwordModel = $("#passwordModel").val();
        if (passwordModel === "0") {
            if (!/^[\d]+$/.test(newPassword)) {
                // 格式错误，密码必须由数字组合
                showAppToast("格式错误，密码必须由数字组合");
                return false;
            }
        } else if (passwordModel === "1") {
            if (!/^[a-zA-Z]+$/.test(newPassword)) {
                showAppToast("格式错误，密码必须由字母组合");
                return false;
            }
        } else if (passwordModel === "2") {
            if (!/[A-Za-z].*[0-9]|[0-9].*[A-Za-z]$/.test(newPassword)) {
                // 格式错误，密码必须由数字+字母组合
                showAppToast("格式错误，密码必须由数字+字母组合");
                return false;
            }

        } else if (passwordModel === "3") {
            if (!/(?=.*[\d]+)(?=.*[a-zA-Z]+)(?=.*[^a-zA-Z0-9]+)./.test(newPassword)) {
                // 格式错误，密码必须由字母+数字+特殊字符组合
                showAppToast("格式错误，密码必须由字母+数字+特殊字符组合");
                return false;
            }
        }
        setTimeout(function () {
           var data = BTAppBridge && BTAppBridge.get("/oauth2/randomString", {}, "getRandomStringCallback");
           uni.postMessage({
               data:data
           })
        }, 100);
        return true;
    }

    /**
     * 获取加密信息-回调
     */
    window.getRandomStringCallback = function (encryptInfoResponse) {

        var oldPassword = $('#inputOldPasswordElement').val();
        var newPassword = $('#inputNewPasswordElement').val();

        var key = CryptoJS.enc.Utf8.parse(encryptInfoResponse.key);
        var iv = CryptoJS.enc.Utf8.parse(encryptInfoResponse.iv);
        // 对密码进行加密传输
        var encryptedOldPassword = CryptoJS.AES.encrypt(oldPassword, key, {
            iv: iv,
            mode: CryptoJS.mode.CBC,
            padding: CryptoJS.pad.Pkcs7
        }) + '';
        var encryptedNewPassword = CryptoJS.AES.encrypt(newPassword, key, {
            iv: iv,
            mode: CryptoJS.mode.CBC,
            padding: CryptoJS.pad.Pkcs7
        }) + '';
        // 记录要提交数据
        submitData = {
            oldPassword: encryptedOldPassword,
            newPassword: encryptedNewPassword
        };
        BTAppBridge && BTAppBridge.showConfirmDialog
        && BTAppBridge.showConfirmDialog('提示信息', '确认修改密码吗？', {
            confirmCallback: 'doSubmitModifyRequest',
        });
    }

    var submitData = {};
    window.doSubmitModifyRequest = function () {
        // 提交修改密码请求到后端
        BTAppBridge && BTAppBridge.post("/api/modifyPassword", submitData, "submitModifyPasswordCallback");
    }

    /**
     * 提交修改密码请求 - 回调
     */
    window.submitModifyPasswordCallback = function (res) {
        // alert(JSON.stringify(res));
        if (res && res.success && res.success == true) {
            showAppToast(res.msg ? res.msg : "修改密码成功", 'success');
            BTAppBridge && BTAppBridge.updateAccessToken && BTAppBridge.updateAccessToken(res.obj);
            BTAppBridge && BTAppBridge.closePage && BTAppBridge.closePage();
        } else {
            BTAppBridge && BTAppBridge.showAlertDialog && BTAppBridge.showAlertDialog('操作失败', res.msg ? res.msg : "操作失败，请稍后再试");
        }
    }

    /**
     * 清空密码输入
     * @param elementId
     * @param cleanElementId
     * @returns {boolean}
     */
    function cleanPasswordInput(elementId, cleanElementId) {
        if (!elementId) {
            return;
        }
        var element = $("#" + elementId);
        element.val('');
        element.focus();
        $("#" + cleanElementId).hide();
        return false;
    }

    function showPasswordLengthMsg() {
        var minLength = $("#passwordLength").val() ? Number($("#passwordLength").val()) : 6;
        $('#showPasswordLengthMsgElement').html('密码最小长度：' + minLength + '位');
    }

    /**
     * 密码组成方式
     * - 0：数字。
     * - 1：字母。
     * - 2：数字+字母。
     * - 3：字母+数字+特殊字符。
     */
    function showPasswordModelMsg() {
        var passwordModelElement = document.getElementById("passwordModel");
        var value = passwordModelElement.value;
        var showMsg = '密码组成方式：';
        if (value == '0') {
            showMsg += '数字';
        } else if (value == '1') {
            showMsg += '字母';
        } else if (value == '2') {
            showMsg += '数字+字母';
        } else if (value == '3') {
            showMsg += '字母+数字+特殊字符';
        }
        var showPasswordModelMsgElement = document.getElementById("showPasswordModelMsgElement");
        showPasswordModelMsgElement.innerHTML = showMsg;
    }

    (function (doc, win) {


    })(document, window);

</script>


</body>

</html>

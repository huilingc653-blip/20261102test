##                <img class="icon-right-arrowlink" src="${basePath}/static/mobile/icon/common/icon_right_arrowlink@2x.png?_btv=${resourceVersion}" />
##            </div>
##        </li>

        <li id="openCmsReportElement" class="chart-row-container ui-border-t">
            <div class="row-item-icon-parent-container">
                <div class="row-item-icon-container">
                    <img class="row-item-icon"
                         src="${basePath}/static/mobile/icon/chartPage/icon_chart_cms@2x.png?_btv=${resourceVersion}"/>
                </div>
            </div>
            <div class="ui-list-info">
                <h4 class="ui-nowrap chart-name-text">
                    信贷融资
                </h4>
                <p class="ui-nowrap chart-description-text">授信额度综合统计、融资余额汇总 </p>
            </div>
            <div class="row-arrowlink-icon-container">
                <img class="icon-right-arrowlink"
                     src="${basePath}/static/mobile/icon/common/icon_right_arrowlink@2x.png?_btv=${resourceVersion}"/>
            </div>
        </li>

        <li id="openIntegratedQueryReportElement"
            class="chart-row-container ui-border-t">
            <div class="row-item-icon-parent-container">
                <div class="row-item-icon-container">
                    <img class="row-item-icon"
                         src="${basePath}/static/mobile/icon/chartPage/icon_chart_intergrated_query@2x.png?_btv=${resourceVersion}"/>
                </div>
            </div>
            <div class="ui-list-info">
                <h4 class="ui-nowrap chart-name-text">
                    综合查询
                </h4>
                <p class="ui-nowrap chart-description-text">资金存量汇总表、到期票据分析、到期贷款分析、贷款余额对比分析</p>
            </div>
            <div class="row-arrowlink-icon-container">
                <img class="icon-right-arrowlink" src="${basePath}/static/mobile/icon/common/icon_right_arrowlink@2x.png?_btv=${resourceVersion}" />
            </div>
        </li>

    </ul>


</section>
<script src="${basePath}/static/plugins/frozen/js/zepto.min.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">

    var corpId = $("#corpId").val();
    var netId = $("#netId").val();

    (function (doc, win) {

        $("#openIntegratedQueryReportElement").click(function () {
            console.log("netId"+netId)
            alert(netId)
            alert(corpId)
            alert("综合查询");
            setTimeout(function () {
                // tabsData为tab页面的必要数据
                // headerTitle为新打开页面的标题
                BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
                    tabsData: [
                        {
                            url: '/bi/capitalStock/listNetMoblie',
                            tabName: '资金存量汇总',
                            params: {
                                corpId: corpId,
                                netId: netId,
                            }
                        },
                        {
                            url: '/bill/report/soonExpireBill/mobile/list',
                            tabName: '到期票据分析',
                            params: {
                                corpId: corpId,
                                netId: netId,
                            }
                        },
                        {
                            url: '/cms/report/cmsExpireAnalysis/mobileExpireAnalysi',
                            tabName: '到期贷款分析',
                            params: {
                                corpId: corpId,
                                netId: netId,
                            }
                        },
                        {
                            url: '/cms/report/loanBalanceAnalysis/appList',
                            tabName: '贷款余额对比分析',
                            params: {
                                corpId: corpId,
                                netId: netId,
                            }
                        },
                        {
                            url: '/cms/report/loanTrend/mobileList',
                            tabName: '贷款余额趋势分析',
                            params: {
                                corpId: corpId,
                                netId: netId,
                            }
                        },
                        {
                            url: '/bill/accebill/balCompare/balCompareApp',
                            tabName: '票据余额分析',
                            params: {
                                corpId: corpId,
                                netId: netId,
                            }
                        },
                    ],
                    headerTitle: '综合查询'
                });
            }, 100);


        });

        $("#openAccebillReportElement").click(function () {
            // alert("承兑汇票");
            setTimeout(function () {

                BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
                    tabsData: [
                        {
                            url: '/bill/accebill/abbillTransferDown/toAppNetCollect',
                            tabName: '网点票据划拨汇总表',
                            params: {
                                corpId: $("#corpId").val(),
                            }
                        },
                    ],
                    headerTitle: '承兑汇票'
                });

            }, 100);
        });

        $("#openNetbankReportElement").click(function () {
            // alert("结算管理");
            setTimeout(function () {
                // BTAppBridge.jump({url: '/report/allocation/mobileAllocation', corpId: $("#corpId").val(),netId:$("#netId").val()});
                // tabsData为tab页面的必要数据
                // headerTitle为新打开页面的标题
                BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
                    tabsData: [
                        {
                            url: '/report/allocation/mobileAllocation',
                            tabName: '资金调拨明细表',
                            params: {
                                corpId: corpId,
                                netId: netId,
                            }
                        },
                        {
                            url: '/report/fundsbalancestatistics/mobileBalance',
                            tabName: '资金余额统计表',
                            params: {
                                corpId: corpId,
                                netId: netId,
                            }
                        },
                    ],
                    headerTitle: '结算管理'
                });
            }, 100);

        });

        $("#openCmsReportElement").click(function () {
            // alert("信贷融资");
            setTimeout(function () {
                // tabsData为tab页面的必要数据
                // headerTitle为新打开页面的标题
                BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
                    tabsData: [
                        {
                            url: '/cms/report/ratbkstatistics/mobileBkAmountRation',
                            tabName: '授信综合额度统计',
                            params: {
                                corpId: corpId,
                                netId: netId,
                            }
                        },
                        {
                            url: '/cms/report/cmsbalancegather/gatherApp',
                            tabName: '融资余额汇总',
                            params: {
                                corpId: corpId,
                                netId: netId,
                            }
                        },
                    ],
                    headerTitle: '信贷融资'
                });
            }, 100);
        });

    })(document, window);


</script>


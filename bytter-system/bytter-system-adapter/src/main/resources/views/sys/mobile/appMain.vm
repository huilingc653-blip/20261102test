<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
	<title>报表</title>
</head>
#set($resourceVersion=$resourceVersion.get())
#set($basePath=$springMacroRequestContext.contextPath)
<style>
    html {
        width: 100%
    }

    body {
        -webkit-user-select: initial;
        background-color: #FFFFFF;
        width: 100%;
        margin: 0;
    }
    p {
        margin:0;
    }


    .index-wrap .header {
        text-align: center;
        padding-top: 0;
        height: 245px;
        line-height:245px;
        -webkit-background-size: 100% auto;
        background-image:url("${basePath}/static/images/bg/bg_report@3x.png?v=165623");
        background-size: 100% 100%;
        margin-top: -1px;
    }
    .index-wrap {
        width: 100%;
        overflow-x: hidden;
    }
    a.nav-box{
        height: 124px;
        width: 50%;
        float: left;
        position: relative;
        color: #686868;
        font-size: .6875rem;
        display: block;
        padding-bottom: 10px;
        text-align: center;
        font-family: PingFang-Medium,PingFangSC-Regular,Helvetica;
        background-color: #FFFFFF;
        box-sizing: border-box;
    }

    .nav-box > span {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%,-50%);
    }


    .nav-box > div {
        height:40%;
        margin-bottom: 18px;
    }
    .nav-box  > p {
        color:#656565;
        font-size:14px;
        margin-top: 30px;
    }

    .nav-box  > div > img {
        margin-top:30px;
    }

    .nav-boder{
        border-left: 1px solid #E4E4E4;
        border-right: 1px solid #E4E4E4;
        border-bottom: 1px solid #E4E4E4;
    }

    .boderBottom{
        border-bottom: 1px solid #E4E4E4;
    }

    .header > h1 {
        margin: 0;
        color: #FFFFFF;
        font-size: 32px;
    }
</style>

<section class="ui-container">
	<input type="hidden" id="corpId" value="$!{corpId}">
    <input type="hidden" id="netId" value="$!{netId}">
    <div class="index-wrap">
        <div class="header" >
			<h1>拜特资金管理系统</h1>
        </div>
        <section id="list">
            <div class="context">
                <a class="nav-box boderBottom" data-href="/budget/fbsbudgetreport/listFbsBudgetForApp" id="seachFbsBudget">
                    <div>
                        <img src="${basePath}/static/images/bg/icon_list_1.png" >
                    </div>
                    <p>资金计划上报查询</p>
                </a>
                <a class="nav-box nav-boder" data-href="/bi/capitalStock/listNetApp" id="capitalStock">
                    <div>
                        <img src="${basePath}/static/images/bg/app1.png" >
                    </div>
                    <p>资金存量汇总表</p>
                </a>
            </div>
            <div>
                <a class="nav-box boderBottom" data-href="/report/fundsbalancestatistics/mobileBalanceList" id="fundsbalancestatistics">
                    <div>
                        <img src="${basePath}/static/images/bg/app2.png" >
                    </div>
                    <p>资金余额统计表</p>
                </a>
                <a class="nav-box nav-boder" data-href="/bill/accebill/abbillTransferDown/toAppNetCollect" id="abbillTransferDown">
                    <div>
                        <img src="${basePath}/static/images/bg/app3.png" >
                    </div>
                    <p>网点票据划拨汇总</p>
                </a>
            </div>
            <div>
                <a class="nav-box boderBottom" data-href="/api/bankacc/mobileBal" id="bal">
                    <div>
                        <img src="${basePath}/static/images/bg/app4.png" >
                    </div>
                    <p>银行账户余额</p>
                </a>
                <a class="nav-box nav-boder" data-href="/api/bankacc/mobileDtl" id="dtl">
                    <div>
                        <img src="${basePath}/static/images/bg/app5.png" >
                    </div>
                    <p>银行账户流水查询</p>
                </a>
            </div>
        </section>
    </div>
</section>
<script src="${basePath}/static/plugins/frozen/js/zepto.min.js"></script>
<script type="text/javascript">
    (function (doc, win) {
        // $('#list a').click(function () {
        //     var uri = $(this).data("href");
        //     BTAppBridge.jump({url:"/api/chart/toPage?"+uri,forwardURL:uri});
        // });
        // $('#seachFbsBudget').tap(function () {
        //     BTAppBridge.jump({url: $(this).attr("data-href"), corpId: $("#corpId").val(), selfUI: true, rightViews: ["search"]});
        // });

        // 要用click事件，这样可以避免IOS端在点击时触发两次事件
        $('#seachFbsBudget').click(function () {
            BTAppBridge.jump({url: $(this).attr("data-href"), corpId: $("#corpId").val(), selfUI: true, rightViews: ["search"]});
        });

        $('#fundsbalancestatistics').click(function () {
            BTAppBridge.jump({url: $(this).attr("data-href"),corpId:$("#corpId").val(), selfUI: true,rightViews:["search"]})
        });
        $('#capitalStock').click(function () {
            BTAppBridge.jump({url: $(this).attr("data-href"),netId:$("#netId").val(), selfUI: true,rightViews:["search"]})
        });
        $('#abbillTransferDown').click(function () {
            BTAppBridge.jump({url: $(this).attr("data-href"), corpId:$("#corpId").val(),selfUI: true,rightViews:["search"]})
        });
        $('#bal').click(function () {
            BTAppBridge.jump({url: $(this).attr("data-href"),selfUI: true,rightViews:["search"]})
        });
        $('#dtl').click(function () {
            BTAppBridge.jump({url: $(this).attr("data-href"),selfUI: true,rightViews:["search"]})
        });
    })(document, window);
</script>

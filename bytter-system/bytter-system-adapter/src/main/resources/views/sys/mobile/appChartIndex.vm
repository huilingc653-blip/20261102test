<script>
    var now = new Date();
    var basePath = "${basePath}";
    $("#days").val(new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate());
    window.getInitAccountBal = (data)=>{

        window.initAccountBal(data)
    }
    window.getBankAccountCapital = (data)=>{

        window.setBankAccountCapital(data)
    }

    //
    /**
     * 打开报表模块管理页面
     */
    function openChartModulesManagePage() {
        var data = BTAppBridge.openChartModulesManagePage && BTAppBridge.openChartModulesManagePage()
        console.log('点击了添加模块',data)
        //向uniapp传值
        uni.postMessage({
            data: data
        });
        // window.BTAppBridge.openChartModulesManagePage && window.BTAppBridge.openChartModulesManagePage();
    }

    // function onChartModuleClick(url) {
    //     BTAppBridge.jump({url: url, corpId: $("#corpId").val(), netId: $("#netId").val()});
    // }

    function onChartModuleClick(url, chartModuleKey) {
        var data = BTAppBridge.jump({
            url: "/api/chart/appSecondChartMenuPage",
            chartModuleKey: chartModuleKey,
            corpId: $("#corpId").val(),
            netId: $("#netId").val()
        });

        //向uniapp传值
        uni.postMessage({
            data: data
        });
    }


    (function (doc, win) {

        refreshBalance = function () {
            $('#bt-loading').show();
            var url = "/bi/reportAccountBalMobile/getAccountBal";
            // $.ajax({
            //     type: "post",
            //     url: url,
            //     async: true,
            //     data: {"type":"1"},
            //     dataType: "json",
            //     success: function (data) {
            //         initAccountBal(data);
            //     }
            // });

            setTimeout(function () {
                var data = BTAppBridge.post(url, {"type": "1", "corpId": "$!{corpId}"}, 'initAccountBal');
                uni.postMessage({
                    data:data
                })
            }, 100);
        }

        var url = "/bi/reportAccountBalMobile/getAccountBal";
        // $.ajax({
        //     type: "post",
        //     url: url,
        //     async: true,
        //     data: {"type":"0"},
        //     dataType: "json",
        //     success: function (data) {
        //         initAccountBal(data);
        //     }
        // });

        setTimeout(function () {
            $('#bt-loading').show();
            var data = BTAppBridge.post(url, {"type": "1", "corpId": "$!{corpId}"}, 'initAccountBal');
            uni.postMessage({
                data: data
            });
        }, 100);

        initAccountBal = function (data) {
            console.log(JSON.stringify(data))
            $('#bt-loading').hide();
            if (data) {
                var maxBalance = 0;
                $.each(data, function (index, item) {
                    if (item.bal > maxBalance) {
                        maxBalance = item.bal;
                    }
                });
                //数据
                var datas = [];
                // var datas = [{"name": "银行账户", "month": "6月", "value": 494}];
                var curMonth = new Date().getMonth() + 1;
                $.each(data, function (index, item) {
                    var d = {};
                    d["name"] = item.type;
                    d["month"] = item.month + "月";
                    d["value"] = item.bal;
                    d["bal"] = bt.money.format(item.bal);
                    d["yearOnYear"] = item.yearOnYear;
                    d["monthOnMonth"] = item.monthOnMonth;
                    datas.push(d);
                    if (curMonth == item.month) {
                        if (item.type === '内部账户') {
                            console.log(JSON.stringify(item))
                            $("#innerAccBal").text(bt.money.format(item.bal));
                            $("#innerAccYearOnYear").text(handleScale(item.yearOnYear));
                            $("#innerAccMonthOnMonth").text(handleScale(item.monthOnMonth));
                        } else if (item.type === '银行账户') {
                            $("#toMonthBal").val(item.bal);
                            var days = $("#days").val();
                            $("#avgDayBal").text(bt.money.format(bt.money.div(item.bal, days)));
                            $("#bankAccBal").text(bt.money.format(item.bal));
                            $("#bankAccYearOnYear").text(handleScale(item.yearOnYear));
                            $("#bankAccMonthOnMonth").text(handleScale(item.monthOnMonth));
                        }
                    }
                });
                // Step 1: 创建 Chart 对象
                F2.track(false);
                // https://antv-f2.gitee.io/zh
                const chart = new F2.Chart({
                    id: 'accountBal',
                    pixelRatio: window.devicePixelRatio, // 指定分辨率
                });

                // Step 2: 载入数据源
                var originDates = "$!{months}".split(",");
                maxBalance = Math.ceil(maxBalance);
                if(maxBalance>100){
                    maxBalance = Math.floor(maxBalance / 100 ) * 100
                }else{
                    maxBalance = 100
                }
                console.log(maxBalance)
                chart.source(datas, { //1、立即更新数据chart.changeData(data);　2、
                    'month': {
                        type: 'cat',
                        tickCount: 5,
                        values: originDates
                    },
                    steps: {
                        tickCount: 6
                    },
                    'value': { // value代表纵轴映射的健
                        tickCount: 5, //设置纵轴刻度
                        min: 0,
                        max: maxBalance
                    }
                });

                //设置横坐标样式
                chart.axis('month', { // 横坐标样式
                    tickLine: { // 横坐标名字上面那个突出的小线段
                        length: 0,
                        stroke: '#EFEFEF' //小线段的颜色
                    },
                    label: function (text, index, total) {  //横坐标文字设置
                        return {
                            text: text,//内容
                            fill: '#666666' //字体颜色
                        }
                    },
                    line: {
                        top: true
                    }
                });

                //设置纵坐标样式
                chart.axis('value', {
                    position: 'left', // 纵坐标位置
                    label: function label(text) {
                        return {
                            text: text,
                            fill: '#666666'
                        };
                    },
                    tickCount: 5,
                    grid: { //网格线
                        stroke: '#EFEFEF',
                        border: 'line'
                    }
                });

                chart.tooltip({
                    showItemMarker: false,
                    background: {
                        fill: '#69A4FF',
                        radius: 4,
                    },
                    valueStyle: {
                        fontSize: 10,
                        fill: '#fff',
                    },
                    titleStyle: {
                        fontSize: 10,
                        fill: '#fff',
                    }, // tooltip 标题的文本样式配置，showTitle 为 false 时不生效
                    nameStyle: {
                        fontSize: 10,
                        fill: '#fff',

                    },
                    onShow: function onShow(ev) {
                        var items = ev.items;
                        var bank;
                        var inner;
                        if (items[0] && items[0].origin) {
                            if (items[0].origin.name == "内部账户") {
                                inner = items[0].origin;
                            } else {
                                bank = items[0].origin;
                            }
                        }
                        if (items[1] && items[1].origin) {
                            if (items[1].origin.name == "内部账户") {
                                inner = items[1].origin;
                            } else {
                                bank = items[1].origin;
                            }
                        }
                        if (bank) {
                            $("#bankAccBal").text(bt.money.format(bank.bal));
                            $("#bankAccYearOnYear").text(handleScale(bank.yearOnYear));
                            $("#bankAccMonthOnMonth").text(handleScale(bank.monthOnMonth));
                        }
                        if (inner) {
                            $("#innerAccBal").text(bt.money.format(inner.bal));
                            $("#innerAccYearOnYear").text(handleScale(inner.yearOnYear));
                            $("#innerAccMonthOnMonth").text(handleScale(inner.monthOnMonth));
                        }
                    }
                });

                // Step 3：创建图形语法，绘制柱状图，由 month 和 value 两个属性决定图形位置，month 映射至 x 轴，value 映射至 y 轴
                chart.legend(false) // 是否显示图例
                chart.interval().position('month*value')
                        .size(6) //设置柱状大小
                        .color('name', function (name) { //设置柱状图的颜色
                            if (name === '内部账户') {
                                return '#99C2FF'
                            } else if (name === '银行账户') {
                                return '#2988FF'
                            }
                        })
                        .adjust({
                            type: 'dodge',
                            marginRatio: 0.05 // 设置分组间柱子的间距
                        })
                        .style('type', {
                            radius: function radius() {　//设置柱状图圆角
                                return [3, 3, 3, 3]
                            }
                        });

                // Step 4: 渲染图表
                chart.render();
            }

        }

        /**
         * 处理比例
         */
        function handleScale(scale) {
            var newScale = bt.money.changeDecimalBuZero(scale);
            return scale > 0 ? ("+" + newScale + "%") : (newScale + "%");
        }
        //轮播1
        window.mySwipe = new Swipe(document.getElementById('slider'), {
            startSlide: 0,
            speed: 400,
            auto: false,
            continuous: false,
            disableScroll: false,
            stopPropagation: false,
            callback: function (index, elem) {
                $('#swipBar').find('.active').removeClass('active');
                if (index === 0) {
                    $('#swipBar').find('.report-swipe-left').addClass('active');
                } else {
                    getDayBankAccountCapital();
                    $('#swipBar').find('.report-swipe-right').addClass('active');
                }
            },
            transitionEnd: function (index, elem) {

            }
        });

        /**
         * 获取银行账户当日资金信息
         */
        function getDayBankAccountCapital() {
            console.log('cscscsc')
            var url = "/bi/reportAccountBalMobile/getDayBankAccountCapital";
            // $.ajax({
            //     type: "post",
            //     url: url,
            //     async: true,
            //     data: {},
            //     dataType: "json",
            //     success: function (result) {
            //         setBankAccountCapital(result);
            //     }
            // });
            $('#bt-loading1').show();
            setTimeout(function () {
                var data = BTAppBridge.post(url, {"corpId": "$!{corpId}"}, 'setBankAccountCapital');
                uni.postMessage({
                    data:data
                })
            }, 100);
        }

        /**
         * 设置资金概览
         */
        setBankAccountCapital = function (result) {
            setToDayBal(result.toDay);
            setBankDepositTable(result.depositList);
            setEndBal(result);
        }

        /**
         * 设置当日余额情况
         */
        function setToDayBal(data) {
            console.log(JSON.stringify(data))
            $("#toDayBal").text(bt.money.format(data.toDayBal));
            $("#inDayAmt").text(bt.money.format(data.inDayAmt));
            $("#outDayAmt").text(bt.money.format(data.outDayAmt));
            var toMonthBal = $("#toMonthBal").val();
            var days = $("#days").val();
            $("#avgDayBal").text(bt.money.format(bt.money.div(toMonthBal, days)));
        }

        /**
         * 设置存款表格
         */
        function setBankDepositTable(data) {
            $('#bt-loading1').hide();
            $("#depositTable > tbody").html("");
            var html = '';
            $.each(data, function (index, item) {
                var row = (index + 1);
                html += '<tr>';
                html += '<td style="text-align: center"><img src="${basePath}/static/mobile/icon/common/' + row + '@2x.png" alt=""></td>';
                html += '<td style="text-align: center">' + item.busTypeName + '</td>';
                html += '<td style="text-align: right">' + bt.money.format(item.balance) + '</td>';
                html += '<td style="text-align: right">' + (item.proportion == 0 ? "0.00" : bt.money.changeDecimalBuZero(item.proportion)) + '%</td>';
                html += ' <td style="text-align: right" class="' + (row === 1 || row === 2 ? "green" : "red") + '">' + handleScale(item.monthOnMonth) + '</td>';
                html += '</tr>';
            });
            $("#depositTable > tbody").append(html)
        }

        /**
         * 设置到期余额
         */
        function setEndBal(data) {
            $("#endBillBal").text(bt.money.format(data.endBillBal));
            $("#endDepositBal").text(bt.money.format(data.endDepositBal));

        }

        window.mySwipe1 = new Swipe(document.getElementById('slider1'), {
            startSlide: 0,
            speed: 400,
            auto: false,
            continuous: false,
            disableScroll: false,
            stopPropagation: false,
            callback: function (index, elem) {
            },
            transitionEnd: function (index, elem) {

            }
        });

    })(document, window);

    /**
     * 下一页
     */
    function nextPage() {
        if (mySwipe1) {
            mySwipe1.next();
            var index = mySwipe1.getPos();
            if (index === 3) {
                $('#nextPage').hide();
                $('#prevPage').show();
            } else {
                $('#prevPage').show();
            }

        }
    }

    /**
     * 上一页
     */
    function prevPage() {
        if (mySwipe1) {
            mySwipe1.prev();
            var index = mySwipe1.getPos();
            if (index === 0) {
                $('#nextPage').show();
                $('#prevPage').hide();
            } else {
                $('#prevPage').show();
                $('#nextPage').show();
            }
        }
    }

</script>


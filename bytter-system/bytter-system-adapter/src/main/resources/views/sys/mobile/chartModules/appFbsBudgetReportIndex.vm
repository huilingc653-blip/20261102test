<script src="${basePath}/static/plugins/frozen/js/zepto.min.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">

    var chartModuleKey = "$!{chartModuleKey}";
    var corpId = $("#corpId").val();
    var netId = $("#netId").val();

    function onMenuItemClick(url, jumpType, menuId) {
        // alert("url=" + url + ",jumpType=" + jumpType + ",menuId=" + menuId);
        if (jumpType === 'tab') {
            // 获取该菜单下的tab报表菜单，一般都有数据。否则不会显示此菜单
            BTAppBridge.post("/api/chart/getMobileChartTabMenuList", {
                chartModuleKey: chartModuleKey,
                menuId: menuId
            }, "openTabPageCallback");
        } else {
            BTAppBridge.jump({
                url: '/api/bankacc/mobileBankAcc',
                corpId: corpId,
                netId: netId,
            });
        }
    }

    $(document).ready(function () {

        openTabPageCallback = function (data) {
            // alert(JSON.stringify(data));
            if (data) {
                let tabsData = [];
                data.forEach(function (item, index, arr) {
                    tabsData.push({
                        url: item.url,
                        tabName: item.name,
                        params: {
                            corpId: corpId,
                            netId: netId,
                        }
                    });
                });
                if (tabsData.length > 0) {
                    BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
                        tabsData: tabsData,
                        headerTitle: '计划上报'
                    });
                }
            }
        }
    });

    (function (doc, win) {


        $("#row1Element").click(function () {
            setTimeout(function () {
                BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
                    tabsData: [
                        {
                            url: '/budget/fbsbudget/mobileReqInput',
                            tabName: '计划上报'
                        },
                    ],
                    headerTitle: '计划上报'
                });
            }, 100);
        });
        $("#row2Element").click(function () {
            setTimeout(function () {
                BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
                    tabsData: [
                        {
                            url: '/budget/fbsbudget/mobileReqProess',
                            tabName: '计划执行'
                        },
                    ],
                    headerTitle: '计划执行'
                });
            }, 100);
        });

    })(document, window);


</script>


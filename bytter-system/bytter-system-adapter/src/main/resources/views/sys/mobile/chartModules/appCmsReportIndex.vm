<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>信贷融资</title>

</head>
#set($resourceVersion=$resourceVersion.get())
#set($basePath=$springMacroRequestContext.contextPath)
<link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css?_btv=${resourceVersion}">
<style>
    html {
        width: 100%
    }

    body {
        -webkit-user-select: initial;
        background-color: #F5F5F5;
        width: 100%;
        margin: 0;
    }

    .chart-row-container {
        padding-top: 5px;
        padding-bottom: 5px;
    }

    .row-item-icon-parent-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0px 10px 0px 0px;
    }

    .row-item-icon-container {
        display: flex;
        width: 42px;
        height: 42px;
        border-radius: 50px;
        justify-content: center;
        align-items: center;
    }

    .row-arrowlink-icon-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-right: 15px;
    }

    .chart-name-text {
        font-size: 16px;
        color: #333333;
        font-weight: bold;
    }

    .chart-description-text {
        margin-top: 5px;
        font-size: 14px;
        color: #999999;
    }

    .icon-right-arrowlink {
        width: 6px;
        height: 11px;
    }


</style>

<section class="ui-container">

    <input type="hidden" id="corpId" value="$!{corpId}">
    <input type="hidden" id="netId" value="$!{netId}">

    <ul class="ui-list ui-list-link ui-border-tb">

        <li id="row1Element"
            class="chart-row-container ui-border-t">
            <div class="row-item-icon-parent-container">
                <div class="row-item-icon-container" style="background-color: #FFECDE;">
                    <img width="22px" height="22px"
                         src="${basePath}/static/mobile/icon/chartPage/icon_chart_intergrated_query@2x.png?_btv=${resourceVersion}"/>
                </div>
            </div>
            <div class="ui-list-info">
                <h4 class="ui-nowrap chart-name-text">
                    查询
                </h4>
                <p class="ui-nowrap chart-description-text">银行借款查询</p>
            </div>
            <div class="row-arrowlink-icon-container">
                <img class="icon-right-arrowlink"
                     src="${basePath}/static/mobile/icon/common/icon_right_arrowlink@2x.png?_btv=${resourceVersion}"/>
            </div>
        </li>

        <li id="row2Element"
            class="chart-row-container ui-border-t">
            <div class="row-item-icon-parent-container">
                <div class="row-item-icon-container" style="background-color: #FFECDE;">
                    <img width="22px" height="22px"
                         src="${basePath}/static/mobile/icon/chartPage/icon_chart_intergrated_query@2x.png?_btv=${resourceVersion}"/>
                </div>
            </div>
            <div class="ui-list-info">
                <h4 class="ui-nowrap chart-name-text">
                    担保管理
                </h4>
                <p class="ui-nowrap chart-description-text">被担保合同查询</p>
            </div>
            <div class="row-arrowlink-icon-container">
                <img class="icon-right-arrowlink"
                     src="${basePath}/static/mobile/icon/common/icon_right_arrowlink@2x.png?_btv=${resourceVersion}"/>
            </div>
        </li>


    </ul>


</section>
<script src="${basePath}/static/plugins/frozen/js/zepto.min.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">

    var corpId = $("#corpId").val();
    var netId = $("#netId").val();

    (function (doc, win) {

        $("#row1Element").click(function () {

            alert("银行借款查询");

            setTimeout(function () {


            }, 100);


        });

        $("#row2Element").click(function () {

            alert("担保管理");

            setTimeout(function () {


            }, 100);


        });

    })(document, window);


</script>


<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>报表</title>

</head>
#set($resourceVersion=$resourceVersion.get())
#set($basePath=$springMacroRequestContext.contextPath)
<link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css?_btv=${resourceVersion}"">
<style>
    html {
        width: 100%
    }

    body {
        -webkit-user-select: initial;
        background-color: #FFFFFF;
        width: 100%;
        margin: 0;
    }

    p {
        margin: 0;
    }


    .index-wrap .header {
        text-align: center;
        padding-top: 0;
        height: 245px;
        line-height: 245px;
        -webkit-background-size: 100% auto;
        background-image: url("${basePath}/static/images/bg/bg_report@3x.png?v=165623");
        background-size: 100% 100%;
        margin-top: -1px;
    }

    .index-wrap {
        width: 100%;
        overflow-x: hidden;
    }

    a.nav-box {
        height: 124px;
        width: 50%;
        float: left;
        position: relative;
        color: #686868;
        font-size: .6875rem;
        display: block;
        padding-bottom: 10px;
        text-align: center;
        font-family: PingFang-Medium, PingFangSC-Regular, Helvetica;
        background-color: #FFFFFF;
        box-sizing: border-box;
    }

    .nav-box > span {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
    }


    .nav-box > div {
        height: 40%;
        margin-bottom: 18px;
    }

    .nav-box > p {
        color: #656565;
        font-size: 14px;
        margin-top: 30px;
    }

    .nav-box > div > img {
        margin-top: 30px;
    }

    .nav-boder {
        border-left: 1px solid #E4E4E4;
        border-right: 1px solid #E4E4E4;
        border-bottom: 1px solid #E4E4E4;
    }

    .boderBottom {
        border-bottom: 1px solid #E4E4E4;
    }

    .header > h1 {
        margin: 0;
        color: #FFFFFF;
        font-size: 32px;
    }
</style>

<input type="hidden" id="corpId" value="$!{corpId}">
<input type="hidden" id="netId" value="$!{netId}">

<section class="ui-container">

    <button onclick="openCorpSelectionPage()" class="ui-btn">打开成员单位选择页面</button>

    <button onclick="openDatePickerPage()" class="ui-btn">打开日期选择页面</button>

    <button onclick="openDatePickerPage({
            pickType: 'single',
            dateType: 'month',
            // minYear: 1990,
            // maxYear: 2025,
            format:'YYYY-MM',
            hintTextConfigs:{
                title:'选择统计月份',
            },
    })" class="ui-btn">打开日期选择页面(月份-单选)
    </button>

    <button onclick="openDatePickerPage({
            // pickType: 'range',
            dateType: 'month',
            // minYear: 1990,
            maxYear: 2025,
            format:'YYYY-MM',
            hintTextConfigs:{
                title:'选择统计月份',
                startDateHintText:'起始月份',
                endDateHintText:'结束月份',
            },
    })" class="ui-btn">打开日期选择页面(月份-区间选择)
    </button>

    <button onclick="openDatePickerPage({
            pickType: 'single',
            dateType: 'year',
            format:'YYYY-MM-DD',
            hintTextConfigs:{
                title:'选择年份',
                startDateHintText:'起始年份',
                endDateHintText:'结束年份',
            },
    })" class="ui-btn">打开日期选择页面(年份-单选)
    </button>

    <button onclick="openDatePickerPage({
            pickType: 'range',
            dateType: 'year',
            format:'YYYY-MM-DD',
            hintTextConfigs:{
                title:'选择年份',
                startDateHintText:'起始年份',
                endDateHintText:'结束年份',
            },
    })" class="ui-btn">打开日期选择页面(年份-区间选择)
    </button>

    <button onclick="singleDatePicker()" class="ui-btn">选择单个日期</button>


</section>

<script src="${basePath}/static/plugins/frozen/js/zepto.min.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">

    // 用于记录页面的查询参数
    const searchParams = {
        corpIds: [],
        corpNames: [],
        datePickData: {
            startDate: null,
            endDate: null,
        },
    };

    $(document).ready(function () {

        postCallback = function (data) {
            alert(JSON.stringify(data));
            $("#showTabContentElement").html(data);
        }

    });

    /**
     * 搜索回调方法
     * @param data
     */
    window.searchActionCallback = function (data) {
        // 根据data参数，查询数据
        if (data.corpNames && data.corpNames.length > 0) {
            let msg = "选择的成员单位名称：" + JSON.stringify(data.corpNames);
            msg = msg + ", 成员单位ID：" + JSON.stringify(data.corpIds)
            alert(msg);
            searchParams.corpNames = data.corpNames;
        }
        if (data.corpIds) {
            searchParams.corpIds = data.corpIds;
        }
        if (data.datePickData) {
            alert("选择的日期：" + JSON.stringify(data.datePickData));
            searchParams.datePickData = data.datePickData;
        }
        if (data.singleDatePickData) {
            alert("选择的单个日期：" + JSON.stringify(data.singleDatePickData));
            searchParams.datePickData = data.datePickData;
        }
    }

    function openCorpSelectionPage() {
        setTimeout(function(){
            BTAppBridge.openCorpSelectionPage && BTAppBridge.openCorpSelectionPage('searchActionCallback',{
                resource:'cms:rat:ration:query'
            });
        },100);
    }

    function openDatePickerPage(configs) {
        // BTAppBridge.openDatePickerPage && BTAppBridge.openDatePickerPage('searchActionCallback');
        // let configs = {
        //     title: '选择统计月份',
        //     pickType: 'range',
        //     dateType: 'month',
        // };
        BTAppBridge.openDatePickerPage && BTAppBridge.openDatePickerPage('searchActionCallback',configs);
    }

    function singleDatePicker() {
        // format：选中日期返回的数据格式。
        // callback：选择日期后回调方法。
        BTAppBridge.singleDatePicker && BTAppBridge.singleDatePicker({
            format: 'YYYYMMDD',
            callback: 'searchActionCallback',
        });
    }

</script>

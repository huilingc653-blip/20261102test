<script>
    $(function(){
        // window.scaleAction = function(index){
        //     alert("scaleAction" + index);
        // }


        //当点击页面上的按钮时，在APP中打开一个新的窗口，网页地址为"/a/b/c"
        $("#testJump").click(function(){
            BTAppBridge.jump({url:"/a/b/c"});
        });

        //当点击页面上的刷新按钮时，对APP当前页面进行刷新，并且携带参数
        //假设当前页面的URL为：/a/b/c，调用该方法后，a1:1,a2:2,b1:3将会参数传到后台
        $("#testRefresh").click(function(){
            BTAppBridge.refresh({a1:1,a2:2,b1:3});
        });

        //点击页面上的日期选择按钮后，打开手机的日期选择控件

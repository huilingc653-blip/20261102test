    <style type="text/css">
        .constrainer {
            width: 100%;
            height: 200px;
        }
        .scrolltable {
            overflow-x: scroll;
            height: 100%;
            display: flex;
            display: -webkit-flex;
            flex-direction: column;
            -webkit-flex-direction: column;
        }
        .scrolltable > .header {
        }
        .scrolltable > .body {
            width: -webkit-fit-content;
            overflow-y: scroll;
            flex: 1;
            -webkit-flex: 1;
            background: #fff
        }

        .scrolltable th, .scrolltable td {
            min-width: 80px;
            max-width: 150px;
        }

        .scrolltable table {
            border-collapse: collapse;
            word-break:break-all; word-wrap:break-all;
        }
        .scrolltable th, .scrolltable td {
            border: 1px solid gray;
            padding: 5px;
        }
        .scrolltable th {
            background-color: #d9e3c0;
            border-width: 1px;
            text-align: center
        }
        .scrolltable td {
            border-width: 1px;
        }
        .scrolltable tr:first-child td {
            border-top-width: 0;
        }
        .scrolltable tr:nth-child(even) {
            background-color: #f2f2f2;
        }
    </style>
</head>

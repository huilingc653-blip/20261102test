<head>
    <meta charset=utf-8>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>$!{pageTitle}</title>

</head>
#set($resourceVersion=$resourceVersion.get())
#set($basePath=$springMacroRequestContext.contextPath)
<link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css?_btv=${resourceVersion}">
<link rel="stylesheet" href="${basePath}/static/css/mobile/appChartListMenu.css?_btv=${resourceVersion}">

<input type="hidden" id="corpId" value="$!{corpId}">
<input type="hidden" id="netId" value="$!{netId}">

#if($menuList.size() == 0)
<div style="display: flex;flex: 1;height: 100%;flex-direction:column;justify-content: center;align-items: center;background-color: #ffffff;">
    <img src="${basePath}/static/mobile/images/common/img_chart_no_permission.png?_btv=${resourceVersion}"/>
    <div style="margin-top: 20px;padding-right: 30px;padding-left: 30px;">
        <h4 style="font-size: 16px;color:#999999">暂无报表查看权限，请联系管理员。</h4>
    </div>
</div>
#else
<section class="ui-container">


    <ul class="ui-list ui-list-link ui-border-tb">
        #foreach($menu in $menuList)

            <li onclick="onMenuItemClick('$!{menu.url}','$!{menu.jumpType}','$!{menu.menuId}','$!{menu.name}')"
                class="chart-row-container ui-border-t">
                <div class="row-item-icon-parent-container">
                    <div class="row-item-icon-container">
                        <img class="row-item-icon"
                             src="${basePath}$!{menu.iconUrl}?_btv=${resourceVersion}"/>
                    </div>
                </div>
                <div class="ui-list-info">
                    <h4 class="ui-nowrap chart-name-text">
                        $!{menu.name}
                    </h4>
                    <p class="ui-nowrap chart-description-text">$!{menu.description}</p>
                </div>
                <div class="row-arrowlink-icon-container">
                    <img class="icon-right-arrowlink"
                         src="${basePath}/static/mobile/icon/common/icon_right_arrowlink@2x.png?_btv=${resourceVersion}"/>
                </div>

            </li>

        #end
    </ul>
</section>
#end
<script src="$!{basePath}/static/modules/mobile/webViewAppScriptBridage.js?_btv=${resourceVersion}"></script>
<script src="$!{basePath}/static/modules/mobile/webViewApp.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/plugins/frozen/js/zepto.min.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">

    var chartModuleKey = "$!{chartModuleKey}";
    var pageTitle = "$!{pageTitle}";
    var headerTitle = null;

    var corpId = $("#corpId").val();
    var netId = $("#netId").val();

    function onMenuItemClick(url, jumpType, menuId, name) {
        // alert("url=" + url + ",jumpType=" + jumpType + ",menuId=" + menuId);
        if (jumpType === 'tab') {
            console.log('tab')
            headerTitle = name;
            // 获取该菜单下的tab报表菜单，一般都有数据。否则不会显示此菜单
            var data =  BTAppBridge.post("/api/chart/getMobileChartTabMenuList", {
                chartModuleKey: chartModuleKey,
                menuId: menuId,
                corpId:corpId,
                netId:netId
            }, "openTabPageCallback");
            console.log("data"+JSON.stringify(data))
            uni.postMessage({
                data: data
            });
        } else {
            console.log('tab1')

            var data = BTAppBridge.jump({
                url: url,
                corpId: corpId,
                netId: netId,
            });
            //向uniapp传值
            uni.postMessage({
                data: data
            });
        }
    }

    $(document).ready(function () {

        openTabPageCallback = function (data) {
            // alert(JSON.stringify(data));
            if (data && data.length == 0) {
                alert("暂无报表查看权限，请联系管理员。");
                return;
            }
            if (data) {
                let tabsData = [];
                data.forEach(function (item, index, arr) {
                    tabsData.push({
                        url: item.url,
                        tabName: item.name,
                        params: {
                            corpId: corpId,
                            netId: netId,
                        }
                    });
                });
                if (tabsData.length > 0) {
                    BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
                        tabsData: tabsData,
                        headerTitle: headerTitle ? headerTitle : pageTitle
                    });
                }
            }
        }
    });

    (function (doc, win) {

    })(document, window);


</script>


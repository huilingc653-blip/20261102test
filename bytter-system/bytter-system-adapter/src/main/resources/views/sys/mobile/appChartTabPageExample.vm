<!DOCTYPE html>
    #set($basePath=$springMacroRequestContext.contextPath)
<html>
<head>
    <meta charset="utf-8">
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no,minimum-scale=1.0,maximum-scale=1.0">
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <title>Tab切换demo</title>
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css"/>
    <link rel="stylesheet1" href="${basePath}/static/plugins/frozen/css/base.css"/>
    <link rel="stylesheet" href="${basePath}/static/css/mobile/index.css"/>

    <style>
        .ui-tab-nav-multi li {
            display: inline;
        }

        body {
            background: #fff;
        }

        .popup-block * {
            font-size: 0.14rem;
        }

        .ui-tab-nav-multi li {
            display: inline;

        }

        .ui-tab-content > li {
            padding: 0.1rem;
        }

        input::-webkit-input-placeholder {
            color: #666;
        }

    </style>

</head>
<body>

<input type="hidden" id="corpId" value="$!{corpId}">
<input type="hidden" id="netId" value="$!{netId}">


<button id="openChartTabPageElement" onclick="openChartTabPage()" class="ui-btn">打开报表tab页面</button>

<script src="${basePath}/static/mobile/plugins/zepto/zepto.min.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">

    var corpId = $("#corpId").val();
    var netId = $("#netId").val();

    $(document).ready(function () {

    });

    function openChartTabPage() {

        // tabsData为tab页面的必要数据
        // headerTitle为新打开页面的标题
        BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
            tabsData: [
                {
                    url: '/bi/capitalStock/listNetApp',
                    tabName: '资金存量汇总表',
                    params: {
                        corpId: corpId,
                        netId: netId,
                    }
                },
                {
                    url: '/bill/report/soonExpireBill/mobile/list',
                    tabName: '到期票据分析',
                    params: {
                        corpId: corpId,
                        netId: netId,
                    }
                },
                {
                    url: '/cms/report/loanBalanceAnalysis/appList',
                    tabName: '贷款对比分析',
                    params: {
                        corpId: corpId,
                        netId: netId,
                    }
                }
            ],
            headerTitle: '综合查询'
        });
    }


    (function (doc, win) {


    })(document, window);

</script>


</body>

</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <div class="layui-collapse" lay-filter="collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title"></h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table">
                        <tbody>
                            <tr>
                                <td class="textRight">账号</td>
                                <td>
                                    <input type="text" name="likes_loginName" autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('common.placeholder.select')">
                                </td>

                                <td class="textRight">姓名</td>
                                <td>
                                    <input type="text" name="likes_username" autocomplete="off" class="layui-input"
                                           placeholder="#springMessage('common.placeholder.select')">
                                </td>

                            </tr>

                            <tr>
                                <td class="textRight">单位</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <div class="bt-biz-corp" data-biz-type="corp"
                                             data-type="selectTree" data-tree-type="check"
                                             data-name="corpId" data-scope="all">
                                        </div>
                                    </div>

                                </td>

                                <td class="textRight">角色</td>
                                <td>
                                    <div class="layui-input-inline">
                                        <div class="bt-biz-mulselectType"
                                             data-url="${basePath}/sys/role/json"
                                             data-method="get" data-valuefield="id" data-textfield="name"
                                             data-name="roleId" data-search="true"
                                             data-placeholder="#springMessage('common.placeholder.select')">
                                        </div>
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="6" style="text-align: center;">
                                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>账号</th>
            <th>姓名</th>
            <th>单位编码</th>
            <th>单位名称</th>
            <th>角色</th>
            <th>权限分配时间</th>
        </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/permission/userPermission.list.js?_btv=${resourceVersion}"></script>
</html>

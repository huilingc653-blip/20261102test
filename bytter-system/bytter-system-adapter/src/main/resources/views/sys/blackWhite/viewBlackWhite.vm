<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
 	<input type="hidden" name="intercept" id="intercept" value="$!{intercept}"/>
    <input type="hidden" data-name="eqs_bwType"  name="eqs_bwType"  value="$!{intercept}"/>
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
    <table class="layui-table">
        <tbody>
        <tr>
        ##所属单位
         <td class="textRight" width="16%">#springMessage('table.abVoucherinfoVice.corpId')</td>
         <td width="34%">
        	$!{blackWhite.corpCodeName}
         </td>
        
	        ##黑\白名单类型
	            <td class="textRight" width="16%">
	            #if($!{intercept} == "01")
	               #springMessage('sys.black.type')
	            #else 
	               #springMessage('sys.white.type')
	            #end
	           </td>
	            <td width="34%">
	                <div class="layui-input-inline">
						$!{blackWhite.listTypeName}
	                </div>
	            </td>
        </tr>
         <tr>
		        ##黑\白名单编号
		        <td class="textRight" width="16%">
		        #if($!{intercept} == "01")
		           #springMessage('sys.black.list.number')
		        #else 
		           #springMessage('sys.white.list.number')
		        #end
		        </td>
		        <td width="34%">
		            <div class="layui-input-inline">
		           		$!{blackWhite.code}
		            </div>
		        </td>
		        
		         ##黑\白名单名称
		            <td class="textRight" width="16%">
		           	#if($!{intercept} == "01")
		               #springMessage('sys.black.name')
		            #else 
		               #springMessage('sys.white.name')
		            #end
		            </td>
		            <td width="34%">
		                <div class="layui-input-inline">
		                    $!{blackWhite.name}
		                </div>
		            </td>
        </tr>
         <tr>
	         ##数据来源
	         <td class="textRight" width="16%">#springMessage('sys.black.white.dataSource')</td>
	         <td width="34%">
	            $!{blackWhite.dataSourcesName}
	         </td>
	         ##是否有效
            <td class="textRight" width="16%">#springMessage('table.bvVoucherType.validSign')</td>
            <td width="34%">
            	$!{blackWhite.validSignName}
            </td>
        </tr>
        <tr>
        	##所属国家
            <td class="textRight" width="16%">
            	#springMessage('table.foreign.countryOrArea')
            </td>
            <td width="34%">
			   <div class="layui-input-inline">
                 $!{blackWhite.countryName}
               </div>
            </td>
            ##是否共享
            <td class="textRight" width="16%">#springMessage('sys.black.white.is.share')</td>
            <td width="34%">
				 <div class="layui-input-inline">
                 $!{blackWhite.isCommonName}
               </div>
            </td>
		</tr>
        <tr>
            <td colspan="4" style="text-align: center;">
				<button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
            </div>
        </div>
    </div>
</form>
	#parse("views/common/footer.vm")
</body>
</html>

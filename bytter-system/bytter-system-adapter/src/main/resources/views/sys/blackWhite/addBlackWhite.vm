<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="inputForm" class="layui-form input150-container">
    <input type="hidden" id="bwType" name="bwType" value="$!{intercept}"/>
 	<input type="hidden" id="id" name="id" value="$!{blackWhite.id}">
    <input type="hidden" id="operator" name="operator" value="$!{operator}">
    <div class="layui-collapse" lay-filter="collapse">
		<div class="layui-colla-item">
   		<h4 class="layui-colla-title">#springMessage('contract.type.basicInfo')</h4>
   		<div class="layui-colla-content layui-show">
    <table class="layui-table">
        <tr>
 			 ##黑\白名单类型
             <td class="textRight" width="16%">
             #if($!{intercept} == "01")
               #springMessage('sys.black.type')
            #else 
               #springMessage('sys.white.type')
            #end
            </td>
            <td width="34%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-required="true" 
                    data-callback="isCommonBack"
                    data-type="select" data-defaultvalue="$!{blackWhite.listType}" data-group="SYS_BM_LIST_TYPE" data-name="listType" name="listType"></div>
                </div>
            </td>
            ##数据来源
            <td class="textRight" width="16%">#springMessage('sys.black.white.dataSource')</td>
            <td width="34%">
                 <div class="bt-biz-dict" data-type="select" data-disabled="true" 
                 
                   #if($!{blackWhite.id} == "")
                data-defaultvalue="$!{blackWhite.dataSources}"
            #else 
                data-defaultvalue="02"
            #end
               
                 
                  data-group="SYS_BM_LIST_DATA_SOURCES" name="dataSources" data-name="dataSources"></div>
            </td>
        </tr>
        <tr>
         	##黑\白名单编号
            <td class="textRight" width="16%">
           	#if($!{intercept} == "01")
               #springMessage('sys.black.list.number')
            #else 
               #springMessage('sys.white.list.number')
            #end
            </td>
            <td width="34%">
                <input type="text" id="code" name="code"  data-maxlength="45"  maxlength="45"
                       autocomplete="off" class="layui-input"  value="$!{blackWhite.code}"
                       #if($!{intercept} == "01")
                		   placeholder="#springMessage('sys.black.list.number')"
            		    #else 
              			   placeholder="#springMessage('sys.white.list.number')"
                        #end
                     maxlength="50"  />
            </td>
        	##黑\白名单名称
            <td class="textRight" width="16%">
            #if($!{intercept} == "01")
               #springMessage('sys.black.name')
            #else 
               #springMessage('sys.white.name')
            #end
            </td>
            <td width="34%">
				  <input type="text" name="name" data-name="name" 
				  lay-verify="required|strlength" data-maxlength="450" maxlength="450"
				  autocomplete="off" class="layui-input"  value="$!{blackWhite.name}"
                    	#if($!{intercept} == "01")
                		   placeholder="#springMessage('sys.black.name')"
            		    #else 
              			   placeholder="#springMessage('sys.white.name')"
                        #end
                  maxlength="500"  >
            </td>
       </tr>
       
       <tr>
         	##是否有效
            <td class="textRight" width="16%">#springMessage('table.bvVoucherType.validSign')</td>
            <td width="34%">
            	<input type="checkbox" data-name="validSign"  name="validSign" 
            	
            	#if($!{blackWhite.validSign}=="1")
                                   checked  #end lay-skin="switch"  lay-text="#springMessage("common.sc_yn.yes")|#springMessage("common.sc_yn.no")">
            </td>
        	##所属国家
            <td class="textRight" width="16%">
            	#springMessage('table.foreign.countryOrArea')
            </td>
            <td width="34%">
			   <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-required="true"
                     data-callback="setArea" data-biz-name="countryId"  data-placeholder="" 
                     data-url="${basePath}/basic/business/syscountrycust/listSysCountryCust" 
                     data-defaultvalue="$!{blackWhite.countryId}"
                     data-valuefield="id" data-textfield="nameZh" data-name="countryId"></div>
               </div>
            </td>
       </tr>
       
        <tr>
         	##是否共享
            <td class="textRight" width="16%">#springMessage('sys.black.white.is.share')</td>
            <td width="34%">
              <input type="checkbox"
              #if($!{blackWhite.isCommon}=="1") 
                                   checked  #end  name="isCommon" data-defaultvalue="1" lay-skin="switch"  lay-text="#springMessage("common.sc_yn.yes")|#springMessage("common.sc_yn.no")">
            </td>
        	##所属单位
            <td class="textRight" width="16%">
            	#springMessage('table.abVoucherinfoVice.corpId')
            </td>
            <td width="34%">
			  <div class="bt-biz-corp"
                        data-tree-type="radio"
                        data-biz-name="corpId"
                        data-type="selectTree"
                        data-name="corpId"
                        ##data-required="true"
                         data-defaultvalue="$!{blackWhite.corpId}"
                        data-placeholder="#springMessage('table.abVoucherinfoVice.corpId')">
                   </div>
            </td>
       </tr>
    </table>
     <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" type="button" lay-filter="save">#springMessage('common.button.save')</button>
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
     </div></div></div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/blackWhite/blackWhite.add.js?_btv=${resourceVersion}"></script>
</html>

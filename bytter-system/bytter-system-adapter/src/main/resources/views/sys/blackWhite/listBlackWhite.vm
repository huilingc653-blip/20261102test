<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
 	<input type="hidden" name="intercept" id="intercept" value="$!{intercept}"/>
    <input type="hidden" data-name="eqs_bwType"  name="eqs_bwType"  value="$!{intercept}"/>
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
    <table class="layui-table">
        <tbody>
        <tr>
        ##所属单位
         <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
            <td>
           	 <div class="layui-input-inline">
                   <div class="bt-biz-corp"
                        data-tree-type="check"
                        data-biz-type="corp"
                        data-type="selectTree"
                        data-name="ins_corpId"
                        data-scope="all"
                        data-placeholder="#springMessage('table.abVoucherinfoVice.corpId')">
                   </div>
               </div>
            </td>
        
        ##黑\白名单编号
            <td class="textRight" width="8%">
            #if($!{intercept} == "01")
               #springMessage('sys.black.list.number')
            #else 
               #springMessage('sys.white.list.number')
            #end
            </td>
            <td width="25%">
                <div class="layui-input-inline">
               			<input type="text" name="likes_code" autocomplete="off" class="layui-input"
               			#if($!{intercept} == "01")
                		   placeholder="#springMessage('sys.black.list.number')"
            		    #else 
              			   placeholder="#springMessage('sys.white.list.number')"
                        #end
               			>
                </div>
            </td>
        ##黑\白名单类型
            <td class="textRight" width="8%">
            #if($!{intercept} == "01")
               #springMessage('sys.black.type')
            #else 
               #springMessage('sys.white.type')
            #end
           </td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict"  data-type="select" data-group="SYS_BM_LIST_TYPE" data-name="eqs_listType" ></div>
                </div>
            </td>
        </tr>
        <tr>
          ##黑\白名单名称
            <td class="textRight">
           	#if($!{intercept} == "01")
               #springMessage('sys.black.name')
            #else 
               #springMessage('sys.white.name')
            #end
            </td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_name" autocomplete="off" class="layui-input" 
                    	#if($!{intercept} == "01")
                		   placeholder="#springMessage('sys.black.name')"
            		    #else 
              			   placeholder="#springMessage('sys.white.name')"
                        #end
                    >
                </div>
            </td>
        
        ##是否共享
            <td class="textRight">#springMessage('sys.black.white.is.share')</td>
            <td>
           		    <div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-name="eqs_isCommon"></div>
            </td>
        ##数据来源
            <td class="textRight">#springMessage('sys.black.white.dataSource')</td>
            <td width="25%">
            	 <div class="bt-biz-dict" data-type="select" data-group="SYS_BM_LIST_DATA_SOURCES" data-name="eqs_dataSources"></div>
            </td>
           
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
            </div>
        </div>
    </div>
</form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
           <th>#springMessage('table.abVoucherinfoVice.corpId')</th>
            #if($!{intercept} == "01")
                <th>#springMessage('sys.black.list.number')</th>
                <th>#springMessage('sys.black.type')</th>
                <th>#springMessage('sys.black.name')</th>
            #else 
                <th>#springMessage('sys.white.list.number')</th>
                <th>#springMessage('sys.white.type')</th>
                <th>#springMessage('sys.white.name')</th>
            #end
            <th>#springMessage('sys.black.white.is.share')</th>
            <th>#springMessage('sys.black.white.dataSource')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/blackWhite/listBlackWhite.list.js?_btv=${resourceVersion}"></script>
</html>

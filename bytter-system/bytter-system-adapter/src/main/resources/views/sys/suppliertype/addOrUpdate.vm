<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-textarea {
            line-height: 20px;
            min-width: 120px;
            min-height:50px;
        }
    </style>
</head>
<body style="padding-bottom: 60px;">
<form class="layui-form" action="">
    <table class="layui-table">
        <input type="hidden" name="id" value="$!{supplierType.id}"/>
        <tbody>
        <tr>
            <td class="textRight">#springMessage("table.supplierType.code")</td>
            <td width="70%">
                <input type="text" id="code" name="code" lay-verify="required|numberOrletter|strlength"  data-maxlength="60"
                              autocomplete="off" class="layui-input" placeholder="#springMessage("table.supplierType.code")" value="$!{supplierType.code}"/>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("table.supplierType.name")</td>
            <td width="70%">
                <input type="text" id="name" name="name" lay-verify="required|strlength"  data-maxlength="100"
                       autocomplete="off" class="layui-input" placeholder="#springMessage("table.supplierType.name")" value="$!{supplierType.name}"/>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("table.btCurrency.rmk")</td>
            <td colspan="3">
                <div class="layui-form-item layui-form-text" style="margin-bottom:0px;padding-right:600px;">
                    <textarea lay-verify="strlength" name="rmk" placeholder="#springMessage("table.btCurrency.rmk")" class="layui-textarea" style="min-height:70px"  data-maxlength="100">$!{supplierType.rmk}</textarea>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("table.btCurrency.validSign")</td>
            <td>
                <input type="radio" name="validSign" value="1" #if($supplierType.validSign == 1 || !$supplierType.validSign)checked#end title="#springMessage('common.sc_yn.yes')">
                <input type="radio" name="validSign" value="0" #if($supplierType.validSign == 0)checked#end title="#springMessage('common.sc_yn.no')">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submitEvent">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
    <script>
        bt.use(['form', 'jquery'], function () {
            var form = bt.form(), $ = bt.jquery;
            var layer = parent ? parent.bt.layer : bt.layer;
            form.on('submit(submitEvent)', function (data) {
                var action = $('input[name="id"]').val() ? "update" : "save";
                $.post(basePath + '/sys/suppliertype/' + action, data.field, function (result) {
                    parent.layer.alert(result.msg, {icon: result.success ? 1 : 2},function () {
                        parent.layer.closeAll();
                        if (result.success) {
                            if(!bt.navtab){
                                parent.layer?parent.layer.closeAll():layer.closeAll();
                            }else{
                                bt.navtab.closeCurrent();
                                bt.navtab.refreshParent();
                            }
                        }
                    });
                }, 'JSON');
                return false;
            });
        })
    </script>
</body>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            background-color: #465568;
        }
        .page-container{
            margin: 90px auto 30px;
            width: 650px;
        }
        .page-container .page-body {
            width: 100%;
            margin-top: 50px;
            background-color: #3a4554;
            -webkit-border-radius: 7px;
            -moz-border-radius: 7px;
            -ms-border-radius: 7px;
            -o-border-radius: 7px;
            border-radius: 7px;
        }
        .license-head {
            display: block;
            background-color: #323d4b;
            text-align: center;
            padding-top: 15px;
            padding-bottom: 15px;
            font-size: 22px;
            font-weight: 400;
            color: #fff;
            -webkit-border-radius: 7px 7px 0 0;
            -moz-border-radius: 7px 7px 0 0;
            -ms-border-radius: 7px 7px 0 0;
            -o-border-radius: 7px 7px 0 0;
            border-radius: 7px 7px 0 0;
        }
        .license-body {
            display: block;
            margin: 35px;
            overflow: hidden;
        }
        .license-bottom {
            display: block;
            background-color: #323d4b;
            text-align: center;
            padding-top: 20px;
            padding-bottom: 20px;
            -webkit-border-radius: 0 0 7px 7px;
            -moz-border-radius: 0 0 7px 7px;
            -ms-border-radius: 0 0 7px 7px;
            -o-border-radius: 0 0 7px 7px;
            border-radius: 0 0 7px 7px;
        }
        .license-bottom a{
            color: #fff;
        }
        table{
            width: 100%;
        }
        table td{
            color:#fff;
            padding: 5px 10px;
        }
        table td:first-child{
            text-align: right;
        }
    </style>
</head>
<body>
<div class="page-container">
    <div class="page-body">
        <div class="license-head">
            #springMessage("common.license.permitDetail")
##            拜特资金管理系统 - 许可证书信息
        </div>
        <div class="license-body">
            <table class="table">
                <tr>
                    <td>
##                        许可类型
        #springMessage("common.license.permitType")

                    </td>
                    <td>
                        #if($licenseNode.type=="R")
##                            正式许可
                            #springMessage("common.license.formalPermit")
                        #elseif($licenseNode.type=="F")
                            #springMessage("common.license.finalPermit")
##                            最终许可
                        #elseif($licenseNode.type=="D")
                            #springMessage("common.license.developPermit")
##                            开发许可
                        #else
                            #springMessage("common.license.testPermit")
##                            测试许可
                        #end
                    </td>
                </tr>
                <tr>
                    <td>
                        #springMessage("common.license.groupOrCompanyNameInChinese")
##                        集团/公司名称（中文）
                    </td>
                    <td> $!{licenseNode.companyName}</td>
                </tr>
                <tr>
                    <td>
                        #springMessage("common.license.groupOrCompanyNameInForeign")
##                        集团/公司名称（外语）
                    </td>
                    <td>$!{licenseNode.companyNameForeign}</td>
                </tr>
                <tr>
                    <td>
                        #springMessage("common.license.permitEndDate")
##                        许可证截止日期
                    </td>
                    <td>
                    #if($_endDate)
                        #springMessage("common.license.neverValid")
                    #else
                        $!date.format('yyyy-MM-dd',$!licenseNode.endDate)
                    #end
                    </td>
                </tr>
                <tr>
                    <td>
                        #springMessage("common.license.permitStatus")
##                        许可证状态
                    </td>
                    <td>
                        #if($licenseStatus)
                            #springMessage("common.license.validDate")
##                        有效
                        #else
                            <span style="color:#f00">
                                #springMessage("common.ration.overdue")
##                                已过期
                            </span>
                        #end
                    </td>
                </tr>
                <tr>
                    <td>
                        #springMessage("common.license.controlCount")
##                        控制人数
                    </td>
                    <td>
                        #if($licenseNode.controlUserType=="O")
                            #springMessage("common.license.totalInline")
##                            总在线人数
                            ${licenseNode.controlUserNumber}人
                        #elseif($licenseNode.controlUserType=="R")
                            #springMessage("common.license.totalValidUsers")
##                            总有效用户
                            ${licenseNode.controlUserNumber}人
                        #end
                    </td>
                </tr>
                <tr>
                    <td>
                        #springMessage("common.license.totalNet")
##                        网点数量
                    </td>
                    <td>
                        #if($licenseNode.netNumber==0)
                            #springMessage("common.license.noControl")
##                            不做控制
                        #else
                            ${licenseNode.netNumber}#springMessage("table.dailyAccount.unitNumber")
##                            个
                        #end
                    </td>
                </tr>
                <tr>
                    <td>
                        #springMessage("common.license.totalCorp")
##                        单位数量
                    </td>
                    <td>
                        #if($licenseNode.corpNumber==0)
                            #springMessage("common.license.noControl")
##                            不做控制
                        #else
                            ${licenseNode.corpNumber}#springMessage("table.dailyAccount.unitNumber")
##                            个
                        #end
                    </td>
                </tr>
                <tr>
                    <td>
                        #springMessage("common.license.totalBankacc")
##                        银行账号数量
                    </td>
                    <td>
                        #if($licenseNode.bankAccountNumber==0)
                            #springMessage("common.license.noControl")
##                            不做控制
                        #else
                            ${licenseNode.bankAccountNumber}个
                        #end
                    </td>
                </tr>
            </table>
        </div>
        <div class="license-bottom">
##            更新许可
            <input type="file" name="license" title="#springMessage('common.license.updatePermit')" class="layui-upload-file">
        </div>
    </div>
    <div class="page-footer-custom"></div>
</div>

    #parse("views/common/footer.vm")
<script>
    bt.use(['upload','layer'], function () {
        var layer = bt.layer;
        bt.upload({
            url: basePath+'/sys/license/update'
            ,ext: 'lic'
            ,title:bt.lang('common.license.selectUpdatePermitFile')//'请选择需要更新的许可文件'
            ,success: function(result){
                layer.alert(result.msg, {icon: result.success?1:2},function(index){
                    location.reload();
                });
            }
        })
    });

</script>
</body>
</html>

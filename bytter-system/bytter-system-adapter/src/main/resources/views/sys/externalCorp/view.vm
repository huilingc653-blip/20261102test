<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-textarea {
            line-height: 20px;
        }
        form .layui-elem-field .layui-table > thead > tr > th, form .layui-elem-field .layui-table > tbody >tr > td, form .layui-elem-field .layui-table > thead > tr > td{
            border: 1px solid #EBEDF1;
        }
        form .uploader-list .layui-table > thead > tr > th, form .uploader-list .layui-table > tbody >tr > td, form .uploader-list .layui-table > thead > tr > td{
            border: 1px solid #EBEDF1;
        }
    </style>
</head>
<body style="padding-bottom: 60px;">
<form class="layui-form" action="">
    <input type="hidden" name="id" value="$!{externalCorp.id}"/>
    <input type="hidden" name="corpId" value="$!{corp.id}"/>
    <input type="hidden" id="isNative" name="isNative" value="$!{externalCorp.isNative}"/>
    <div class="layui-fluid" style="padding: 0">
        <div class="layui-row">
            <div class="layui-col-xs12">
                <table class="layui-table breakRow" width="800px;">
                    <thead>
                    <tr>
                        <td colspan="4">#springMessage('table.externalCorp.basicInfo')</td>
                    </tr>
                    </thead>
                    <tr>
                        <td class="text-right" width="15%">#springMessage('table.externalCorp.corpName')</td>
                        <td colspan="3" >#if($externalCorp.corpName) $!{externalCorp.corpName}
                                        #else
                            #springMessage('table.externalCorp.commonCorp')
                        #end</td>
                    </tr>
                    <tr>
                        <td class="text-right">#springMessage('table.externalCorp.code')</td>
                        <td width="35%">
                            $!{externalCorp.code}
                        </td>
                        <td class="text-right">#springMessage('table.externalCorp.source')</td>
                        <td width="35%">
                            $dictTag.get("sys.externalCorp.source", $!{externalCorp.sourceSystem})
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">#springMessage('table.externalCorp.name')</td>
                        <td>
                            $!{externalCorp.name}
                        </td>
                        <td class="text-right">#springMessage('table.externalCorp.abbreviate')</td>
                        <td>
                            $!{externalCorp.abbreviate}
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">#springMessage('table.externalCorp.nameEn')</td>
                        <td>
                            $!{externalCorp.nameEn}
                        </td>
                        <td class="text-right">#springMessage('table.externalCorp.externalType')</td>
                        <td>
                            $!{externalCorp.externalTypeStr}
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">#springMessage('sys.externalCorp.bwType')</td>
                        <td>
                            $!{externalCorp.bwTypeName}
                        </td>
                        #if($externalCorp.externalType == 0)
                            <td class="text-right"></td>
                            <td></td>
                        #else
                            <td class="text-right">#springMessage('table.externalCorp.supplier')</td>
                            <td>
                                $!{externalCorp.supplierName}
                            </td>
                        #end
                    </tr>
                    <tr>
                        <td class="text-right">#springMessage('table.externalCorp.corpStatus')</td>
                        <td>
                            $dictTag.get("sf_yn", $!{externalCorp.isNative})
                        </td>
                        <td class="text-right">#springMessage('table.externalCorp.satus')</td>
                        <td>
                            $dictTag.get("sf_yn", $!{externalCorp.status})
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">#springMessage('table.externalCorp.socCode')</td>
                        <td colspan="3">
                            $!{externalCorp.socCode}
                        </td>
                    </tr>
                </table>
            </div>
            <div class="layui-col-xs12">
                <table class="layui-table">
                    <thead>
                    <tr>
                        <td colspan="4">#springMessage('table.externalCorp.contactInfo')</td>
                    </tr>
                    </thead>
                    <tr>
                        #if(!$externalCorp.isNative || $externalCorp.isNative ==1)
                            <td class="text-right">#springMessage('table.externalCorp.provAndCity')</td>
                            <td width="35%">
                                $!{externalCorp.provName}&nbsp;&nbsp;$!{externalCorp.cityName}
                            </td>
                            <td class="text-right">#springMessage('table.externalCorp.address')</td>
                            <td width="35%">
                                $!{externalCorp.address}
                            </td>
                        #else
                            <td class="text-right">#springMessage('table.btswiftinfo.countryCode')/#springMessage('table.fcAccbookExt.city')</td>
                            <td width="35%">
                                $!{externalCorp.provinceFexName}&nbsp;&nbsp;$!{externalCorp.cityFexName}
                            </td>
                            <td class="text-right">#springMessage('table.externalCorp.provinceState')</td>
                            <td width="35%">
                                $!{externalCorp.provinceState}&nbsp;&nbsp;
                            </td>
                        #end
                    </tr>
                    #if(!$externalCorp.isNative || $externalCorp.isNative == 0)
                        <tr>
                            <td class="text-right">#springMessage('table.externalCorp.address1')</td>
                            <td>
                                $!{externalCorp.address1}
                            </td>
                            <td class="text-right">#springMessage('table.externalCorp.address2')</td>
                            <td>
                                $!{externalCorp.address2}
                            </td>
                        </tr>
                        <tr>
                            <td class="text-right">#springMessage('table.externalCorp.zipCode')</td>
                            <td>
                                $!{externalCorp.zipCode}
                            </td>
                            <td class="text-right">#springMessage('table.externalCorp.fullAddress')</td>
                            <td>
                                $!{externalCorp.address}
                            </td>
                        </tr>
                    #end
                    <tr>
                        <td class="text-right">#springMessage('table.externalCorp.linkMan')</td>
                        <td>
                            $!{externalCorp.linkMan}
                        </td>
                        <td class="text-right">#springMessage('table.externalCorp.tel')</td>
                        <td>
                            $!{externalCorp.tel}
                        </td>
                    </tr>
                    <tr>
                        <td class="text-right">#springMessage('table.externalCorp.fax')</td>
                        <td>
                            $!{externalCorp.fax}
                        </td>
                        <td class="text-right">#springMessage('table.externalCorp.email')</td>
                        <td>
                            $!{externalCorp.email}
                        </td>
                    </tr>
                    #if(!$externalCorp.isNative || $externalCorp.isNative == 1)
                        <tr>
                            <td class="text-right">#springMessage('table.externalCorp.addressEn')</td>
                            <td>
                                $!{externalCorp.addressEn}
                            </td>
                            <td class="text-right"></td>
                            <td>
                            </td>
                        </tr>
                    #end
                </table>
            </div>
        </div>
    </div>
    #if($actionType && $actionType == 'audit')
        <div class="layui-form-item layui-form-submit">
            <div class="layui-input-block">
                <button class="layui-btn" id="pass"  lay-submit="" lay-filter="storageEvent" type="button">#springMessage('common.button.pass')</button>
                <button class="layui-btn" id="back"  lay-submit="" lay-filter="submitEvent" type="button">#springMessage('common.button.back')</button>
            </div>
        </div>
    #end
    #if(!$externalCorp.isNative || $externalCorp.isNative == 0)
        <fieldset class="layui-elem-field">
            <legend>#springMessage('table.externalCorpQuickPay.quickPayInfo')</legend>
            <div class="layui-field-box">
                <table id="quickPay" style="width:100%">
                    <thead>
                    <tr>
                        <th>#springMessage('table.externalCorpQuickPay.proId')</th>##资金收付产品
                        <th>#springMessage('table.externalCorpQuickPay.email')</th>##邮箱
                        <th>#springMessage('table.externalCorpQuickPay.tel')</th>##电话号码
                        <th>#springMessage('table.externalCorpQuickPay.fpsId')</th>##FPS ID
                        <th>#springMessage('table.externalCorpQuickPay.creditCard')</th>##信用卡号
                        <th>#springMessage('table.externalCorpQuickPay.hkId')</th>##香港身份证号
                        <th>#springMessage('table.externalCorpQuickPay.isDefaultAcc')</th>##首选账号
                    </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </fieldset>
    #end
    <fieldset class="layui-elem-field">
        <legend>#springMessage('table.externalCorp.accountInfo')</legend>
        <div class="layui-field-box">
            <table id="bankAcc" style="width:100%">
                <thead>
                <tr>
                    <th>#springMessage('table.externalBankAcc.bankAcc')</th>##关联账号
                    <th>#springMessage('table.externalBankAcc.curId')</th>##账号币种
                    <th>#springMessage('table.externalBankAcc.bankName')</th>##开户行
                    #if(!$externalCorp.isNative || $externalCorp.isNative ==1)
                        <th>#springMessage('table.externalBankAcc.bankSourceCode')</th>##联行号
                        <th>#springMessage('table.externalBankAcc.prov')</th>##所在省
                        <th>#springMessage('table.externalBankAcc.city')</th>##所在市
                        <th>#springMessage('table.externalCorp.accIdentificationType')</th>##账户识别类型
                        <th>#springMessage('table.btswiftinfo.swiftCode')</th>##SWIFT CODE
                    #else
                        <th>#springMessage('table.externalBankAcc.name')</th>##账号名称
                        <th>#springMessage('table.btswiftinfo.swiftCode')</th>##SWIFT CODE
                        <th>#springMessage('table.btswiftinfo.localClearNo')</th>##本地清算号
                        <th>#springMessage('table.externalBankAcc.payExcType')</th>##支付指令类型
                        <th>#springMessage('table.externalBankAcc.intermediaryBank')</th>##中转行
                        <th>#springMessage('table.externalBankAcc.intermediaryBankSwiftCode')</th>##中转行SWIFT CODE
                        <th>#springMessage('table.externalBankAcc.intermediaryBankAcc')</th>##中转行银行账户

                    #end
                    <th>#springMessage('table.externalBankAcc.remark')</th>##备注
                    <th>#springMessage('table.externalBankAcc.isDefaultAcc')</th>##是否首选账号
                    #*<th>#springMessage('table.externalBankAcc.isSignAcc')</th>*#
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </fieldset>
    <!--附件上传 -->
    <input id="attachmentId" name="attachmentId" type="hidden" value="$!{externalCorp.attachmentId}">
    <div id="uploader" class="layui-input-inline" style="width: 100%"></div>
</form>
    #if($actionType && $actionType == 'viewWithAuditLog')
    <fieldset class="layui-elem-field" style="margin-top:15px">
        <legend>#springMessage('replenish.OpLog')</legend>
        <div class="layui-field-box">
            <div class="layui-col-xs12">
                <table class="layui-table" id="table_externalCorpAuditLog"  style="text-align:center">
                    <thead>
                    <tr>
                        <th>#springMessage('table.externalCorpAuditLog.createTime')</th>
                        <th>#springMessage('table.externalCorpAuditLog.createLoginName')</th>
                        <th>#springMessage('table.externalCorpAuditLog.createUsername')</th>
                        <th>#springMessage('table.externalCorpAuditLog.auditType')</th>
                        <th>#springMessage('table.externalCorpAuditLog.auditMessage')</th>
                    </tr>
                    </thead>
                </table>
            </div>
        </div>
    </fieldset>
    #end
    #if($actionType && $actionType == 'audit')
    <div class="layui-form-item layui-form-text margin-top">
        <label class="layui-form-label">#springMessage('bpm.model.approve')</label>
        <div class="layui-input-block" style="width: 600px;">
            <textarea name="auditMessage" placeholder="#springMessage('bpm.model.approve')" class="layui-textarea"></textarea>
        </div>
    </div>
    #end
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/externalCorp/externalCorp.view.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
	<style>
		body{
			padding-bottom:0;
			padding-top:5px;
		}
	</style>
</head>
<body>
<form class="layui-form input150-container" id="searchForm">
	##<input type="hidden" name="corpId" value="$!{corpId}">
	##标识清楚是仅仅取单位信息
	<input type="hidden" name="type" value="corp">
	<input type="hidden" id="ids" name="ids" value="">
	#if($!paramsVO.isView eq "1")
		<input type="hidden" name="isSelect" value="1">
	#else
		<input id="eqi_status" name="eqi_status" type="hidden" value="1">
	<table class="layui-table">
		<tbody>
		<tr>
			<td class="textRight" width="20%">#springMessage('table.sysCorp.code')</td>
			<td width="30%">
				<input type="text" name="likes_code" autocomplete="off" class="layui-input" placeholder="#springMessage('table.sysCorp.code')">
			</td>
			<td class="textRight" width="20%">#springMessage('table.sysCorp.name')</td>
			<td width="30%">
				<input type="text" name="likes_name" autocomplete="off" class="layui-input" placeholder="#springMessage('table.sysCorp.name')">
			</td>
		</tr>
		<tr>
			<td class="textRight">
				#springMessage('sys.common.isSelect')</td>
			<td>
				<div class=layui-form>
					<div class="bt-biz-dict"
						 data-group="sf_yn"
						 data-name="isSelect"
						 data-type="select">
					</div>
				</div>
			</td>
			<td class="textRight"></td>
			<td>
			</td>
		</tr>
		<tr>
			<td colspan="6" style="text-align: center;">
				<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</td>
		</tr>
		</tbody>
	</table>
	#end
</form>
<table id="corpTable" class="layui-table">
</table>
	#parse("views/common/footer.vm")
<script>
	var isShow="$!{paramsVO.isView}";
	if(isShow=="1"){
		$("#ids").val(parent.getCorpIdValArray());
	}
	bt.use(['datatable', 'jquery', 'selectType','dicts'], function () {
		bt.selectType.init();
		var layer = parent ? parent.bt.layer : bt.layer;
		var dataform = bt.dataform;
		var $ = bt.jquery;
		bt.dicts.init();
		var table = bt.datatable.init({
			elem: "#corpTable",
			#if($!paramsVO.isView eq "1")
				paging:false,
				checkbox:false,
				order: [[0,'asc']],
			#else
				checkbox:true,
				order: [[1,'asc']],
			#end
			colReorder: true,
			ignoreButtons:['colvis'],
			ajax: {
				url: basePath + "/sys/corp/selectCorp.json?type=corp",
			},
			searchForm: {
				formElem: "#searchForm",
				formFilter: "search"
			},
			columns: [
				{data: "name",title:bt.lang('table.sysCorp.name'), orderable: true,
					render: function (data, type, full, meta) {
						return "("+full.code+")"+full.name;
					}
				},
				{data: "type",title:bt.lang('table.sysCorp.type'),className: 'center', orderable: true,
					render: function (data, type, full, meta) {
						if(full.type==0){
							return '<span style="color:#ff0000;">'+bt.lang("common.button.center")+'</span>';
						}else{
							return bt.lang("common.button.resetAcceptor");
						}
					}
				},
				{data: "netName",title:bt.lang('table.sysCorp.netName'), orderable: false}
			],
			btClickRowCallback:function(data){
				parent.opCorpIdValArray(data);
				$("#ids").val(parent.getCorpIdValArray());
			},
			btDrawCallback:function(setting){
				if(parent.externalIdValArray && parent.corpIdValArray.length>0 && isShow!="1") {
					bt.datatable.onCheckRow("corpTable", {
						"key": "id",
						"value": parent.corpIdValArray,
						"checked": true
					});
					$("#ids").val(parent.getCorpIdValArray());
				}
			}
		});
	});
</script>
</body>
</html>
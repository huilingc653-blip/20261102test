<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab layui-tab-brief" lay-filter="externalCorpTabBrief">
    #*<ul class="layui-tab-title">
        <li data-status="1" class="layui-this">#springMessage("table.externalCorp.commonCorp")</li>
        <li data-status="0">#springMessage("table.externalCorp.privateCorp")</li>
    </ul>*#
    <div class="layui-tab-content">
        <form class="layui-form" id="searchForm">
            ##<input type="hidden" name="isCommon" value="1">
            <table class="layui-table">
                <tbody>
                <tr class="inlineCorp">
                    <td class="textRight">#springMessage('sys.user.corpContain.show')</td>
                    <td width="20%">
                        <div class="layui-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-type="selectTree"
                                 data-tree-type="check"
                                 data-name="corpId"
                                 data-callbackData="bt.netChange"
                                 data-scope="all"
                                 data-biz-name="corpId"
                                 data-placeholder="#springMessage('common.placeholder.select')">
                            </div>
                        </div>
                    </td>
                    <td class="textRight">#springMessage('table.externalCorp.corpStatus')</td>
                    <td width="30%">
                        <div class="bt-biz-dict" data-type="select" data-group="sf_yn"
                             data-defaultvalue="" data-name="eqg_isNative"></div>
                    </td>
                    <td class="textRight">#springMessage('table.externalCorpQuickPay.proId')</td>
                    <td width="20%">
                        <div class="layui-inline">
                            <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/getInitProductDate" data-method="get"
                                 data-valuefield="id" data-textfield="proName" data-name="eqs_proId" data-biz-name="voucherName"
                                 data-defaultvalue=""></div>
                        </div>
                    </td>
                </tr>
                <tr>

                    <td class="textRight">#springMessage('table.externalCorp.code')</td>
                    <td>
                        <input type="text" id="likes_code" name="likes_code"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.externalCorp.code')"/>
                    </td>
                    <td class="textRight">#springMessage('table.externalCorp.name')</td>
                    <td>
                        <input type="text" id="likes_name" name="likes_name"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.externalCorp.name')"/>
                    </td>
                    <td class="textRight">#springMessage("table.externalCorp.externalType")</td>
                    <td>
                        <div class="bt-biz-dict" data-type="mulselect" data-group="external.type"
                             name="ins_externalType" data-name="ins_externalType"></div>
                    </td>
                </tr>
                <tr>
                    <td class="textRight">#springMessage('sys.externalCorp.bwType')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="SYS_BUS_ENTITY_TYPE"
                            data-defaultvalue="" data-name="eqs_bwTypeName"></div>
                    </td>
                    <td class="textRight">#springMessage('table.externalCorp.socCode')</td>
                    <td>
                        <input type="text" id="socCode" name="likes_socCode"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.externalCorp.socCode')"/>
                    </td>
                    <td class="textRight">#springMessage('table.externalCorp.source')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="sys.externalCorp.source"
                             data-defaultvalue="$!{externalCorp.sourceSystem}" data-name="eqs_sourceSystem"
                             data-biz-name="eqs_sourceSystem"></div>
                    </td>
                </tr>
                <tr>
                    <td class="textRight">#springMessage('table.externalCorp.auditStatus')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" data-group="externalCorp.auditStatus"
                             data-defaultvalue="" data-name="eqs_auditStatus"></div>
                    </td>

                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
                </tbody>
            </table>
        </form>
        <table id="externalCorpTable" class="layui-table layui-form expandTableBox">
            <thead>
            <tr>
                <th>#springMessage('table.externalCorp.code')</th>
                <th>#springMessage('table.externalCorp.name')</th>
                <th>#springMessage('table.externalCorp.abbreviate')</th>
                <th>#springMessage('table.externalCorp.nameEn')</th>
                <th>#springMessage('table.externalCorp.corpStatus')</th>
                <th>#springMessage('sys.user.corpContain.show')</th>
                <th>#springMessage('table.externalCorp.source')</th>
                <th>#springMessage('table.externalCorp.satus')</th>
                <th>#springMessage("table.externalCorp.externalType")</th>
                <th>#springMessage("table.externalCorp.supplier")</th>
                <th>#springMessage('sys.externalCorp.bwType')</th>
                <th>#springMessage('table.externalCorp.socCode')</th>
                <th>#springMessage('table.externalCorpQuickPay.proId')</th>
                <th>#springMessage('table.externalCorp.auditStatus')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
        </table>
    </div>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/externalCorp/query/externalCorp.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

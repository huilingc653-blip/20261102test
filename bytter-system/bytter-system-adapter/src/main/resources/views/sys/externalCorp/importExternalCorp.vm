<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="externalCorps" name="externalCorps" value="$!{externalCorps}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.sysCorp.code')</td>
            <td>
                <input type="text" name="likes_code" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.sysCorp.code')">
            </td>
            <td class="textRight">#springMessage('table.externalCorp.corp.name')</td>
            <td>
                <input type="text" name="likes_name" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.externalCorp.corp.name')">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.sysCorp.code')</th>
        <th>#springMessage('sys.user.corpContain.show')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/externalCorp/externalCorp.import.js?_btv=${resourceVersion}"></script>
</body>
</html>

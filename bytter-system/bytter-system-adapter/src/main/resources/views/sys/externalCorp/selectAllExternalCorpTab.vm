<!DOCTYPE html>
<html lang="en" style="height: 100%;">
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-tab{
            margin:0px;
        }
        body{
            padding-bottom:0;
        }
        .layui-tab-content {
            padding-top:0px;
        }
    </style>
</head>
<body>
<div class="layui-tab layui-tab-brief">
    <ul class="layui-tab-title">
        <li class="layui-this">#springMessage("sys.select.title.ExternalCorp")</li>
        <li class="innerTab">#springMessage("sys.select.title.Corp")</li>
    </ul>
    <div class="layui-tab-content" style="height:512px">
        <div class="layui-tab-item layui-show" style="height:100%" data-refresh="true">
            <iframe id="ExternalCorpPage" name="ExternalCorpPage" src="${basePath}/sys/externalCorp/selectAllExternalTab" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
        <div class="layui-tab-item" style="height:100%" data-refresh="true">
            <iframe id="CorpPage" name="CorpPage" src="${basePath}/sys/externalCorp/selectAllCorpTab" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['element', 'form'], function(){
        var $ = bt.jquery,form = bt.form();
        var element = bt.element();
    });
</script>
</html>

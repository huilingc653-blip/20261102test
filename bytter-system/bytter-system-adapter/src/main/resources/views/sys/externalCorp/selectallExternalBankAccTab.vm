<!DOCTYPE html>
<html lang="en" style="height: 100%;">
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-tab{
            margin:0px;
        }
        body{
            padding-bottom:0;
        }
        .layui-tab-content {
            padding-top:0px;
        }
    </style>
</head>
<body>
<div class="layui-tab layui-tab-brief">
    <ul class="layui-tab-title">
        #if($!{innerBankAcc})
        <li #if($!{first}=="innerBankAcc") class="layui-this" #end>#springMessage("sys.select.title.ExternalCorp")(#springMessage("replenish.Domestic"))</li>
        #end
        #if($!{outerBankAcc})
        <li #if($!{first}=="outerBankAcc") class="layui-this" #end>#springMessage("sys.select.title.ExternalCorp")(#springMessage("replenish.Overseas"))</li>
        #end
        #if($!{corpBankAcc})
        <li #if($!{first}=="corpBankAcc") class="layui-this" #end>#springMessage("table.nisAllocationReport.netName")/#springMessage("table.bisFinanceExc.corpId")</li>
        #end
        #if($!{fps})
        <li #if($!{first}=="fps") class="layui-this" #end>#springMessage("香港FPS产品")</li>
        #end
        #if($!{payPal})
        <li #if($!{first}=="payPal") class="layui-this" #end>#springMessage("PAYPAL")</li>
        #end
    </ul>
    <div class="layui-tab-content" style="height:512px">
        #if($!{innerBankAcc})
        <div class="layui-tab-item #if($!{first}=="innerBankAcc") layui-show #end" style="height:100%" data-refresh="true">
            <iframe id="innerExternalCorpPage" name="ExternalCorpPage" src="${basePath}/sys/externalCorp/selectInnerExternalBankAcc?isCustom=$!{isCustom}" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
        #end
        #if($!{outerBankAcc})
        <div class="layui-tab-item #if($!{first}=="outerBankAcc") layui-show #end" style="height:100%" data-refresh="true">
            <iframe id="outerExternalCorpPage" name="CorpPage" src="${basePath}/sys/externalCorp/selectOuterExternalBankAcc?isCustom=$!{isCustom}" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
        #end
        #if($!{corpBankAcc})
        <div class="layui-tab-item #if($!{first}=="corpBankAcc") layui-show #end" style="height:100%" data-refresh="true">
            <iframe id="corpExternalCorpPage" name="CorpPage" src="${basePath}/sys/externalCorp/selectAllCorpBankAcc?isCustom=$!{isCustom}" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
        #end
        #if($!{fps})
        <div class="layui-tab-item #if($!{first}=="fps") layui-show #end" style="height:100%" data-refresh="true">
            <iframe id="fpsExternalCorpPage" name="CorpPage" src="${basePath}/sys/externalCorp/selectFpsExternalBankAcc?isCustom=$!{isCustom}" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
        #end
        #if($!{payPal})
        <div class="layui-tab-item" style="height:100%" data-refresh="true">
            <iframe id="payPalExternalCorpPage" name="CorpPage" src="${basePath}/sys/externalCorp/selectPayPalExternalBankAcc?isCustom=$!{isCustom}" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
        #end
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['element', 'form'], function(){
        var $ = bt.jquery,form = bt.form();
        var element = bt.element();
    });
</script>
</html>

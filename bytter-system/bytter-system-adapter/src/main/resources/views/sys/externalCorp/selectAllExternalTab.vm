<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            padding-bottom:0;
            padding-top:5px;
        }
    </style>
</head>
<body>
<form class="layui-form " id="searchForm">
    <table class="layui-table">
        <tbody>
        <tr>
            ##客商编号
            <td class="textRight">#springMessage('table.reporter.merchant.code')</td>
            <td>
                <input type="text" name="likes_code" autocomplete="off" class="layui-input" placeholder="#springMessage('table.reporter.merchant.code')">
            </td>
            ##客商属性
            <td class="textRight">#springMessage('sys.externalCorp.bwType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="SYS_BUS_ENTITY_TYPE"
                     data-defaultvalue="" data-name="eqs_bwTypeName"></div>
            </td>
            ##客商类型
            <td class="textRight">#springMessage('table.externalCorp.externalType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="external.type"
                     data-defaultvalue="" data-name="eqs_externalType"></div>
            </td>
        </tr>
        <tr>
            ##客商名称
        <td class="textRight">#springMessage('table.reporter.merchant.name')</td>
        <td>
            <input type="text" name="likes_name" autocomplete="off" class="layui-input" placeholder="#springMessage('table.reporter.merchant.name')">
        </td>
            ##是否国内
        <td class="textRight">#springMessage('table.externalCorp.corpStatus')</td>
        <td>
            <div class="bt-biz-dict" data-type="select" data-group="sf_yn"
                 data-defaultvalue="0" data-displayData="0" data-selecttext="false"
                 data-name="eqg_isNative"></div>
        </td>
            ##资金收付产品
            <td class="textRight">#springMessage('table.externalCorpQuickPay.proId')</td>
            <td >
                <div class="bt-biz-selectType" data-url="${basePath}/foreign/fexproduct/getInitProductDate"
                     data-name ="paymentProducts"   data-valueField="id" data-textField="proName"></div>
            </td>
        </tr>
        <tr>
            ##所属单位
            <td class="textRight">#springMessage('table.externalCorp.corpName')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-tree-type="check"
                         data-type="selectTree"
                         data-name="corpIds"
                         data-scope="all"
                         ></div>
                </div>
            </td>
            ##数据来源
            <td class="textRight">#springMessage('table.externalCorp.source')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="sys.externalCorp.source"
                     data-defaultvalue="" data-name="eqs_sourceSystem"></div>
            </td>
            ##统一社会信用代码
            <td class="textRight">#springMessage('table.externalCorp.socCode')</td>
            <td>
                <input type="text" name="likes_socCode" autocomplete="off" class="layui-input">
            </td>

        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    </div>
</form>
<table id="externalCorpTable" class="layui-table">
    <thead>
    <tr>
        <th width="30">#springMessage('common.table.thead.operation')</th>##操作
        <th>#springMessage('table.reporter.merchant.code')</th>##客商编号
        <th>#springMessage('table.externalCorp.name')</th>##客商名称
        <th>#springMessage('table.reporter.merchant.abbreviation')</th>##客商简称
        <th>#springMessage('table.externalCorp.name')(#springMessage('sys.lang.english'))</th>##客商名称（英文）
        <th>#springMessage('table.externalCorp.externalType')</th>##客商类型
        <th>#springMessage('sys.externalCorp.bwType')</th>##客商属性
        <th>#springMessage('table.externalCorpQuickPay.proId')</th>##资金收付产品
        <th>#springMessage('table.externalCorp.corpStatus')</th>##是否国内
        <th>#springMessage('table.externalCorp.corpName')</th>##所属单位
        <th>#springMessage('table.externalCorp.source')</th>##数据来源
        <th>#springMessage('table.externalCorp.satus')</th>##是否有效
        <th>#springMessage('table.externalCorp.supplier')</th>##供应商类别
        <th>#springMessage('table.externalCorp.socCode')</th>##统一社会信用代码
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
<script>

    bt.use(['datatable', 'jquery','dicts','corp','selectType'], function () {
        var layer = parent ? parent.bt.layer : bt.layer;
        var dataform = bt.dataform;
        var $ = bt.jquery;
        bt.corp.init();
        bt.dicts.init();
        bt.selectType.init();
        var table = bt.datatable.init({
            elem: "#externalCorpTable",
            selectCss: false,
            ajax: {
                url: basePath + "/sys/externalCorp/selectAllExternalDate",
            },
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            columns: [
                {
                    data: null, bSortable: false, className: 'center',
                    render: function (data, type, full, meta) {
                        return '<a href="javascript:void(0);" class="acc-bank-select" data-row="' + meta.row + '">' + bt.lang("common.button.select") + '</a>';
                    }
                },
                {data: "code", orderable: false},
                {data: "name", orderable: false},
                {data: "abbreviate", orderable: false},
                {data: "nameEn", orderable: false},
                {data: "externalTypeStr", orderable: false},
                {data: "bwTypeName", orderable: false},
                {data: "paymentProducts", orderable: false},
                {data: "isNativeStr", orderable: false},
                {data: "corpName", orderable: false,render:function (data, type, full, meta) {
                        if(!full.corpName){
                            return "";
                        }
                        return '<div style="max-width:200px" class="ellipsis" title="' + full.corpName + '">' + full.corpName + '</div>'
                    }},
                {data: "sourceSystem", orderable: false,
                    render: function ( data, type, full, meta ) {
                        return bt.dict("sys.externalCorp.source",full.sourceSystem);
                    }},
                {data: "statusString", orderable: false},
                {data: "supplierName", orderable: false},
                {data: "socCode", orderable: false}
            ]
        });


        table.on('click', '.acc-bank-select', function (event) {
//            var func = top.btSelectCallBack['bt-biz-externalCorpBankAcc']['callback'];
            var parentsIndex = parent.$('body').attr('layerindex'), currentParentIframe;
            if (parentsIndex != undefined) { //如果是弹框中再弹框中，将会有这个参数
                currentParentIframe = 'layui-layer-iframe'+parentsIndex;
            }else {
                currentParentIframe = top.$('.layui-tab-content > .layui-show').find('iframe')[0]['name'];
            }
            //var currentParentIframe = top.$('.layui-tab-content > .layui-show').find('iframe')[0]['name'];
            var isMultiIframes =  top.layer.getChildFrame('body').data('multiiframes'); //判断是否嵌套三层iframe
            if(isMultiIframes){
                var endIframeName = top.frames[currentParentIframe].window.$('.layui-tab-content > .layui-show').find('iframe')[0]['name'];
                var func = top.frames[currentParentIframe].window.frames[endIframeName].btSelectCallBack['bt-biz-allExternalCorp']['callback'];
            } else {
                var func = top.frames[currentParentIframe].window.btSelectCallBack['bt-biz-allExternalCorp']['callback'];
            }

            if (func) {
                var data = table.row($(this).data('row')).data();
                data.type="external";
                data.isExternal=true;
                func(data);
            }
        });
    });
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<table class="layui-table layui-form" style="width:100%;" >
    <thead>
    <tr>
        <th>#springMessage('table.externalCorp.name')</th>
        <th>#springMessage('table.externalCorp.corpStatus')</th>
        <th>#springMessage('table.externalCorp.isCommon')</th>
        <th>#springMessage('table.externalCorp.source')</th>
        <th>#springMessage("table.externalCorp.externalType")</th>
        <th>#springMessage("table.externalCorp.supplier")</th>
        <th>#springMessage("sys.externalCorp.bwType")</th>
    </tr>
    </thead>
    <tbody >
        #if($!list)
            #foreach($data in $list)
            <tr>
                <td>$!{data.name}</td>
                <td>$!{data.corpStatus}</td>
                <td align="center">$!{data.isCommonStr}</td>
                <td align="center">$!{data.sourceSystem}</td>
                <td align="center">$dictTag.get("external.type",$!{data.externalType})</td>
                <td>$!{data.supplierName}</td>
                <td>$!{data.bwTypeName}</td>
            </tr>
            #end
        #end
    </tbody>
</table>
<br />
<br />
<div class="layui-form-item layui-form-submit" id="buttonDiv">
    <div class="layui-input-block">
        <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.revert')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
</html>

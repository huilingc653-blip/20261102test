<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                    ##管理单元名称
                        <td class="textRight" width="20%">#springMessage('sys.cell.name')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <input type="text" name="cellCodeAndName" id="cellCodeAndName" autocomplete="off" value="$!{cellManageVO.cellCodeAndName}"
                                       class="layui-input" placeholder="#springMessage('sys.cell.name')">
                            </div>
                        </td>
                    ##有效标志
                        <td class="textRight" width="20%">#springMessage('sys.cell.validSign')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="valid_sign" data-selecttext="false"
                                    #if($!{cellManageVO.validSign})
                                     data-defaultvalue="$!{cellManageVO.validSign}"
                                    #else
                                     data-defaultvalue="1"
                                    #end
                                     data-name="validSign" data-biz-name="validSign" ></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            <button class="layui-btn" type="button" onclick="searchForm()">#springMessage('common.button.search')</button>
                            <button class="layui-btn" type="button" onclick="resetClick()">#springMessage('common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div style="padding-top: 10px;">
    ##新增
        <button class="layui-btn" type="button" onclick="addCell()" >#springMessage('common.button.add')</button>
    ##导出
        <button class="layui-btn" type="button" onclick="excelCell()" >#springMessage('common.button.exports')</button>
    </div>
    <div style="width: 100%;margin-bottom: 10px;">
        <table id="appTable" class="layui-table" style="width:100%;">
            <thead>
            <tr>
            ##管理单元名称
                <th>#springMessage('sys.cell.name')</th>
            ##备注
                <th>#springMessage('common.message.remark')</th>
            ##有效标志
                <th>#springMessage('sys.cell.validSign')</th>
            ##操作
                <th width="18%">#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
            <tbody>
                #foreach($info in $listInfo)
                <tr data-tt-id="$!{info.id}"  data-tt-parent-id="$!{info.parentId}" >
                    <td >$!{info.cellCodeAndName}</td>
                    <td >$!{info.rmk}</td>
                    <td align="center">
                        $!{info.validSignName}
                    </td>
                    <td align="center">
                    ##编辑
                        <a class="" href="#" onclick="updateCell('$!{info.id}')">#springMessage("common.button.edit")</a>
                        <span class="text-explode">|</span>
                    ##删除
                        <a class="" href="#" onclick="deleteCell('$!{info.id}')">#springMessage("common.button.delete")</a>
                        <span class="text-explode">|</span>
                    ##查看
                        <a class="" href="#" onclick="viewCell('$!{info.id}')">#springMessage("common.button.view")</a>
                    </td>
                </tr>
                #end
        </table>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/cellManage/cellManage.list.js?_btv=${resourceVersion}"></script>
</html>

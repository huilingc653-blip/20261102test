<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" name="parentId" id="parentId" value="$!{cellManageVO.parentId}"/>
    <input type="hidden" name="id" id="id" value="$!{id}"/>
    <table class="layui-table">
        <tbody>
        <tr>
        ##上级单元
            <td class="textRight" width="17%">#springMessage('sys.cell.parentCell')</td>
            <td style="width: 291px">
                <div class="layui-input-inline">
                    <div class="bt-biz-cell"
                         data-tree-type="radio"
                         data-biz-type="cell"
                         data-biz-name="parentId"
                         data-type="selectTree"
                         data-name="parentId"
                         data-currentNode="$!{id}"
                         data-defaultvalue="$!{cellManageVO.parentId}"
                         data-placeholder="#springMessage('sys.cell.parentCell')">
                    </div>
                </div>
            </td>
        ##管理单元代码
            <td class="textRight" width="17%">#springMessage('sys.cell.code')</td>
            <td style="width: 291px">
                <input type="text" name="cellCode" autocomplete="off" data-maxlength="20" class="layui-input" #if($!{id}) readonly #end
                       value="$!{cellManageVO.cellCode}" placeholder="#springMessage('sys.cell.code')" lay-verify="required|strlength" >
            </td>
        </tr>
        <tr>
        ##管理单元名称
            <td class="textRight">#springMessage('sys.cell.name')</td>
            <td>
                <input type="text" name="cellName" autocomplete="off" class="layui-input" value="$!{cellManageVO.cellName}"
                       placeholder="#springMessage('sys.cell.name')" lay-verify="required|strlength" data-maxlength="200">
            </td>
        ##备注
            <td class="textRight">#springMessage('common.message.remark')</td>
            <td>
                <input type="text" name="rmk" autocomplete="off" class="layui-input"  value="$!{cellManageVO.rmk}"
                       placeholder="#springMessage('common.message.remark')" lay-verify="strlength" data-maxlength="500">
            </td>
        </tr>
        <tr>
        ##有效标志
            <td class="textRight">#springMessage('sys.cell.validSign')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="radio" data-group="valid_sign"
                        #if($!{cellManageVO.validSign})
                         data-defaultvalue="$!{cellManageVO.validSign}"
                        #else
                         data-defaultvalue="1"
                        #end
                         data-name="validSign" data-biz-name="validSign" ></div>
                </div>
            </td>
            <td class="textRight"></td>
            <td>
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" type="button" lay-filter="save">#springMessage('common.button.save')</button>
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/cellManage/cellManage.add.js?_btv=${resourceVersion}"></script>
</html>

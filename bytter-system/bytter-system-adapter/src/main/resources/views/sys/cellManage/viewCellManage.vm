<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
        ##上级单元
            <td class="textRight" width="17%">#springMessage('sys.cell.parentCell')</td>
            <td style="width: 291px">
                $!{cellManageVO.parentCell}
            </td>
        ##管理单元代码
            <td class="textRight" width="17%">#springMessage('sys.cell.code')</td>
            <td style="width: 291px">
                $!{cellManageVO.cellCode}
            </td>
        </tr>
        <tr>
        ##管理单元名称
            <td class="textRight">#springMessage('sys.cell.name')</td>
            <td>
                $!{cellManageVO.cellName}
            </td>
        ##备注
            <td class="textRight">#springMessage('common.message.remark')</td>
            <td>
                $!{cellManageVO.rmk}
            </td>
        </tr>
        <tr>
        ##有效标志
            <td class="textRight">#springMessage('sys.cell.validSign')</td>
            <td>
                $dictTag.get("valid_sign",$!{cellManageVO.validSign})
                #*$!{cellManageVO.validSignName}*#
            </td>
            <td class="textRight"></td>
            <td>
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/cellManage/cellManage.add.js?_btv=${resourceVersion}"></script>
</html>

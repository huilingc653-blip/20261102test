        var moneyFun = bt.moneyType.getFun();
        selectType = bt.selectType.init();
        corp = bt.corp.init();
        var uiStyle = $('#uiStyle').val();
        if(uiStyle != '1') {
            $('body').addClass('old-skin');
        }
        var webSkin = store.get('web-skin')
        if(webSkin === 'dark-skin'){
            $('body').addClass('dark-skin')
        }else {
            $('body').removeClass('dark-skin')
        }
        // 美化滚动条
        $('.table-card1 .card-content').addClass('scroll-card-content')
        $('.table-card1 .card-content').mCustomScrollbar({theme: "minimal-dark"});

        window.onresize = function () {
            myChartCurMonthForecast.resize()
            myForecastFromBarChart.resize();
            myForecastFromPieChart.resize();
        }

        //本月资金预测期初、期末
        var myChartCurMonthForecast = echarts.init(document.getElementById('chartCurMonthForecast'));
        initCurMonthForecastBar = function () {
            var option = initCurMonthForecastChart();
            myChartCurMonthForecast.setOption(option, true);
            myChartCurMonthForecast.resize();
        };
        initCurMonthForecastBar();

        function initCurMonthForecastChart() {
            var option = {
                color: ['#4e6dec','#d2585d'],
                tooltip: {
                    trigger: 'axis',
                    axisPointer: {
                        type: 'cross',
                        crossStyle: {
                            color: '#999'
                        }
                    }
                },
                legend: {
                    data: ['预测数', '执行数']
                },
                xAxis: [
                    {
                        type: 'category',
                        data: ['2023-01', '2023-02', '2023-03', '2023-04', '2023-05', '2023-06'],
                        axisPointer: {
                            type: 'shadow'
                        }
                    }
                ],
                yAxis : [
                    {
                        type : 'value'
                    }
                ],
                series: [
                    {
                        name: '预测数',
                        type: 'bar',
                        barWidth:6,
                        yAxisIndex:0,
                        tooltip: {
                            valueFormatter: function (value) {
                                return value;
                            }
                        },
                        data: [10000, 70000, 170000, 90000, 50000, 100000]
                    },
                    {
                        name: '执行数',
                        type: 'bar',
                        barWidth:6,
                        yAxisIndex:0,
                        tooltip: {
                            valueFormatter: function (value) {
                                return value;
                            }
                        },
                        data: [5000, 50000, 80000, 60000, 40000, 70000]
                    }
                ]
            };
            return option;
        }


        //资金预测支出金额来源排行
        var myForecastFromBarChart = echarts.init(document.getElementById('chartForecastFromBar'));
        initForecastFromBar = function () {
            var option = initForecastFromBarChart();
            myForecastFromBarChart.setOption(option, true);
            myForecastFromBarChart.resize();
        };
        initForecastFromBar();
        function initForecastFromBarChart() {
            var option = {
                color: ['#4e6dec','#d2585d'],
                xAxis: {
                    type: 'category',
                    data: ['费用报销系统', '悦报销系统', 'CRM系统', 'OA系统', 'ERP系统']
                },
                yAxis: {
                    type: 'value'
                },
                series: [
                    {
                        barWidth:6,
                        yAxisIndex:0,
                        data: [120,150,80,110,130],
                        type: 'bar'
                    }
                ]
            }
            return option;
        }

        //资金预测支出金额来源占比
        var myForecastFromPieChart = echarts.init(document.getElementById('chartForecastFromPie'));
        initForecastFromPie = function () {
            var option = initForecastFromPieChart();
            myForecastFromPieChart.setOption(option, true);
            myForecastFromPieChart.resize();
        };
        initForecastFromPie();
        function initForecastFromPieChart() {
            var industryData = [
                { value: 120, name: '费用报销系统' },
                { value: 150, name: '悦报销系统' },
                { value: 80, name: 'CRM系统' },
                { value: 110, name: 'OA系统' },
                { value: 130, name: 'ERP系统' }
            ];
            var option = {
                color: ['#4e6dec','#d2585d','#ed955a','#ecda6c','#ec8b92'],
                tooltip: {
                    trigger: 'item'
                },
                legend: {
                    type: 'scroll',
                    orient: 'vertical',
                    x: '20%',
                    y: '60%',
                    data: ['费用报销系统', '悦报销系统', 'CRM系统', 'OA系统', 'ERP系统'],
                    formatter:function(name){  //该函数用于设置图例显示后的百分比
                        var total = 0;
                        var value;
                        industryData.forEach(function (item) {
                            total += Number(item.value);
                            if (item.name == name) {
                                value = item.value;
                            }
                        })
                        var p = Math.round(((value / total) * 100)); //求出百分比
                        return name+" "+p+"%";  //返回出图例所显示的内容是名称+百分比
                    }
                },
                series: [
                    {
                        name: '',
                        type: 'pie',
                        radius: ['40%', '60%'],  // 设置饼状图大小，100%时，最大直径=整个图形的min(宽，高)
                        //radius: ['30%', '60%'],  // 设置环形饼状图， 第一个百分数设置内圈大小，第二个百分数设置外圈大小
                        center: ['50%', '30%'],  // 设置饼状图位置，第一个百分数调水平位置，第二个百分数调垂直位置
                        label: {
                            normal: {
                                //formatter: '{b}:{c}' + '\n\r' + '({d}%)',
                                show: false,
                                position: 'center'
                            }
                        },
                        data: industryData,
                        emphasis: {
                            itemStyle: {
                                shadowBlur: 10,
                                shadowOffsetX: 0,
                                shadowColor: 'rgba(0, 0, 0, 0.5)'
                            }
                        }
                    }
                ],
            };
            return option;
        }
    });
</script>
</html>

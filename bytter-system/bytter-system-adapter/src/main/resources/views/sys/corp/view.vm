<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")

    <style>
        .select-tree .select-tree-list {
            max-height: 320px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
    <input type="hidden" name="newPage" id="newPage" value="$!{newPage}">
    <table class="layui-table">
        <tr>
            <input type="hidden" id="corpParentId" value="$!{corp.parentId}">
            <td class="text-right" width="20%">#springMessage('table.sysCorp.parentId')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-type="selectTree"
                         data-name="parentId"
						 data-callbackData="parentCorpFun"
                         data-defaultValue="$!{corp.parentId}"
                         data-placeholder="#springMessage('table.sysCorp.parentId')"></div>
                </div>
            </td>
            <td class="text-right" width="20%">#springMessage('table.sysCorp.code')</td>
            <td width="30%"><input type="text" id="code" name="code" lay-verify="required|code" autocomplete="off" placeholder="#springMessage('table.sysCorp.code')" class="layui-input" value="$!{corp.code}"></td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.externalCorp.socCode')</td>
            <td>
                <input type="text" id="socCode" name="socCode" lay-verify="socCode"
                       autocomplete="off" class="layui-input" value="$!{corp.socCode}" placeholder="#springMessage('table.externalCorp.socCode')"/>
            </td>
            <td class="text-right"></td>
            <td></td>
        </tr>
        <tr>
			<td class="text-right"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.sysCorp.name')</td>
            <td >
                <input type="hidden" name="id" value="$!{corp.id}">
                <input type="text" name="name" lay-verify="name" autocomplete="off" placeholder="#springMessage('table.sysCorp.name')" class="layui-input" value="$!{corp.name}" />
            </td>
            <td class="text-right">#springMessage('table.sysCorp.accountLicence')</td>
            <td><input type="text" name="accountLicence" lay-verify="accountLicence" autocomplete="off" placeholder="#springMessage('table.sysCorp.accountLicence')" class="layui-input" value="$!{corp.accountLicence}"></td>
         </tr>
        <tr>
			<td class="text-right">#springMessage('sys.sysCorp.nameEn')</td>
            <td colspan="3">
                <input type="text" style="width: 100%;" name="nameEn" lay-verify="strlength" data-maxlength="300" autocomplete="off" placeholder="#springMessage('sys.sysCorp.nameEn')" class="layui-input" value="$!{corp.nameEn}" />
            </td>
        </tr>
		 <tr>
            <td class="text-right">#springMessage('table.sysCorp.headPerson')</td>
            <td><input type="text" name="headPerson" lay-verify="headPerson" autocomplete="off" placeholder="#springMessage('table.sysCorp.headPerson')" class="layui-input" value="$!{corp.headPerson}"></td>
			<td class="text-right">#springMessage('table.sysCorp.useAccountCode')</td>
			<td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="userAccountCode"
                         data-defaultValue="$!{corp.userAccountCode}"
                         data-checkkboxtype='{ "Y": "", "N": "" }'
                         data-placeholder="#springMessage('table.sysCorp.useAccountCode')"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="text-right">#springMessage('table.foreign.countryOrArea')</td>
            <td>
                <div class="layui-input-inline">
                    <input id="countryId" name="countryId" type="hidden" value="$!{corp.countryId}">
                    <input type="text" id="countryName" name="countryName" lay-verify="tableData" data-biz-name="countryName" value="$!{country.nameZh}"
                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.foreign.countryOrArea')">
                    <table id="countryTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.tbCreditPeriod.code')</th>
                            <th>#springMessage('table.btswiftinfo.namezh')</th>
                            <th>#springMessage('table.btswiftinfo.nameen')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
            <td class="text-right">#springMessage('sys.region')</td>
            <td>
                <div class="layui-input-inline bt-biz-region" data-group="corp" data-name="province" data-change="city" data-defaultvalue="$!{corp.province}"></div>
                <div class="layui-input-inline bt-biz-region" data-group="corp" data-name="city" data-defaultvalue="$!{corp.city}"></div>
            </td>
        </tr>
        <tr>
            <td class="text-right">#springMessage('table.sysCorp.certType')</td>
            <td>
                <div class="bt-biz-dict" data-group="corp.certType" data-name="certType" data-type="select" data-defaultvalue="$!{corp.certType}" ></div>
            </td>
            <td class="text-right">#springMessage('table.sysCorp.certNo')</td>
            <td >
                <input type="text" name="certNo" lay-verify="certNo" autocomplete="off" placeholder="#springMessage("table.sysCorp.certNo")" class="layui-input" value="$!{corp.certNo}">
            </td>
        </tr>
        <tr>
            <td class="text-right">#springMessage('common.button.center')</td>
            <td><input type="checkbox" #if(!$corp || $corp.type==0) checked #end name="type" lay-skin="switch" lay-text="YES|NO"></td>
			<td class="text-right">#springMessage('table.sysCorp.listedCompany')</td>
            <td><input type="checkbox" #if(!$corp.listedCompany || $corp.listedCompany==1) checked #end name="listedCompany" lay-skin="switch" lay-filter="switchTest" lay-text="YES|NO"></td>
        </tr>
        <tr>
            <td class="text-right">#springMessage('table.sysCorp.status')</td>
            <td colspan="3"><input type="checkbox" #if(!$corp.status || $corp.status==1) checked #end name="status" lay-skin="switch" lay-text="YES|NO"></td>
        </tr>
        <tr>
            <td class="text-right">#springMessage('sys.sysCorp.unitAttribute')</td>
            <td>
				<div class="bt-biz-dict" data-group="sys_corp_attribute_type" data-name="unitAttribute" data-type="select" data-defaultvalue="$!{corp.unitAttribute}" data-required="true" data-callback="unitAttributeFun" ></div>
            </td>
            <td class="text-right">#springMessage("sys.sysCorp.unitCm")</td>
            <td >
                <div class="bt-biz-cell"
                     data-tree-type="check"
                     data-biz-name="unitCmBiz"
					 ##data-required="#if($corp && $corp.unitAttribute eq '02') required #end"
					 data-required="#if($corp&&$corp.unitAttribute eq '02')true#end"
                     data-type="selectTree"
                     data-name="unitCm"
                     data-defaultvalue="$!{corp.unitCm}"
                     data-placeholder="#springMessage('sys.sysCorp.unitCm')">
                </div>
            </td>
        </tr>
        <tr>
            <td class="text-right">#springMessage('table.sysCorp.curId')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-required="true" #if($!{corp.curId}) data-disabled="true" #end
                     data-name ="curId" data-biz-name ="curId"  data-valueField="id" data-textField="curName" data-defaultvalue="$!{corp.curId}"></div>
            </td>
            <td class="text-right">#springMessage("common.message.sort")</td>
            <td >
                <input type="text" name="sort" lay-verify="sortVerify" autocomplete="off" placeholder="#springMessage("common.message.sort")" class="layui-input" value="$!{corp.sort}">
            </td>
        </tr>
        <tr>
            <td class="text-right">#springMessage('table.sysCorp.address')</td>
            <td colspan="3">
                <textarea placeholder="#springMessage('table.sysCorp.address')" class="layui-textarea" name="address" lay-verify="address">$!{corp.address}</textarea>
            </td>
        </tr>
        <tr>
            <td class="text-right">#springMessage('sys.sysCorp.addressEn')</td>
            <td colspan="3">
                <textarea placeholder="#springMessage('sys.sysCorp.addressEn')" class="layui-textarea" name="addressEn" lay-verify="strlength" data-maxlength="300" >$!{corp.addressEn}</textarea>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('股权')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/sys/equityMaintenance/json"
                         data-name="equityMaintenanceId" data-valueField="equityCode" data-textField="equityName" data-value="$!{corp.equityMaintenanceId}"></div>
                </div>
            </td>
            <td class="textRight"></td>
            <td></td>
        </tr>
        #*<tr>
            <td class="textRight">#springMessage('营运区')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="hidden" name="operationAreaId" id="operationAreaId" value="$!{corp.operationAreaId}">
                    <input type="text"  readonly="readonly" autocomplete="off" class="layui-input" placeholder="营运区" id="operationAreaName" value="$!{corp.operationAreaName}"/>
                    <div class="bt-div-search">
                        ## class="bt-biz-inputOperationarea" data-callback="bt.inputOperationAreaCallback"
                        <button  type="button" title="选择" id="inputOperationareaBtn">
                            <span class="iconfont byicon_box_search"></span>
                        </button>
                    </div>
                </div>
            </td>
            <td class="textRight">#springMessage('省区')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="hidden" name="provinceId" id="provinceId" value="$!{corp.provinceId}">
                    <input type="text"  readonly="readonly" autocomplete="off" class="layui-input" placeholder="所属省区" id="systemProvinceName" value="$!{corp.provinceName}"/>
                    <div class="bt-div-search">
                        ## class="bt-biz-inputOperationarea" data-callback="bt.inputOperationAreaCallback"
                        <button  type="button" title="选择" id="inputProvinceIdBtn">
                            <span class="iconfont byicon_box_search"></span>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('股权')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/sys/equityMaintenance/json"
                         data-name="equityMaintenanceId" data-valueField="equityCode" data-textField="equityName" data-value="$!{corp.equityMaintenanceId}"></div>
                </div>
            </td>

            <td class="textRight">#springMessage('仓库')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="hidden" name="unitStoreMaintenanceId" id="unitStoreMaintenanceId" value="$!{corp.unitStoreMaintenanceId}">
                    <input type="text"  readonly="readonly" autocomplete="off" class="layui-input" placeholder="仓库" id="storeName" value="$!{corp.unitStoreMaintenanceName}"/>
                    <div class="bt-div-search">
                        ## class="bt-biz-inputUnitStore"  data-callback="bt.inputUnitStoreCallback"
                        <button  type="button" id="inputUnitStoreBtn" title="选择">
                            <span class="iconfont byicon_box_search"></span>
                        </button>
                    </div>
                </div>
            </td>
        </tr>*#
        <tr>
            <td class="textRight">#springMessage('报表是否显示')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{corp.reportDisplay}" data-name="reportDisplay" data-biz-name="reportDisplay"></div>
            </td>

        </tr>
    </table>

    <div onclick="divclick();" style="text-align: center">
        <i class="layui-icon" style="margin-right: 10px" id="otherInfoIcon">&#xe602;</i>#springMessage(
        'cms.loan.OtherInfo')</div>
    <div id="otherInfo" style="display: none">
        <table class="layui-table">
            <tbody>
            <tr>
                ## 是否启用限额管理
                <td class="textRight">#springMessage('table.sysCorp.enable.limit')</td>
                <td>
                    <input type="checkbox" #if($corp.isLimitQuota==1) checked #end name="isLimitQuota" lay-skin="switch" lay-text="YES|NO">
                </td>
                ## 日累计支付限额
                <td class="textRight">#springMessage('table.sysCorp.day.limit')</td>
                <td>
                    <input type="text" name="dayLimitQuota" autocomplete="off" class="layui-input bt-biz-moneyType"
                           data-moneyendid="t20" placeholder="#springMessage('table.sysCorp.day.limit')" value="$!{corp.dayLimitQuota}">
                </td>
            </tr>
            <tr>
                ## 月累计支付限额
                <td class="textRight">#springMessage('table.sysCorp.month.limit')</td>
                <td>
                    <input type="text" name="monthLimitQuota" autocomplete="off" class="layui-input bt-biz-moneyType"
                           data-moneyendid="t20" placeholder="#springMessage('table.sysCorp.month.limit')" value="$!{corp.monthLimitQuota}">
                </td>
                <td></td>
                <td></td>
            </tr>
            </tbody>
        </table>
    </div>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="corpSubmit">#springMessage('common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/corp/corp.view.js?_btv=${resourceVersion}"></script>
</body>
</html>

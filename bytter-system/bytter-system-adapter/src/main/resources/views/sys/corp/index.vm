<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" id="searchForm">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight">#springMessage('table.sysCorp.name')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="ins_corpId"
                         data-biz-name="ins_corpId"
                         data-scope="all"></div>
                </div>
            </td>
        ##状态
            <td class="textRight">#springMessage('table.sysCorp.status')</td>
            <td>
                <div class="layui-inline">
                    <select id="status" name="status">
                        <option value=" ">#springMessage('common.placeholder.select')</option>
                        <option value="1">#springMessage('common.button.enable')</option>
                        <option value="0">#springMessage('common.button.taboo')</option>
                    </select>
                </div>
            </td>
            <td>
                #*#if($shiro.hasPermission("sys:corp:transfer"))
                    <button class="layui-btn" type="button" id="unitMigration">单位迁移</button>
                #end*#
                <button class="layui-btn" type="button" id="searchBtn">#springMessage('common.button.search')</button>
                <button class="layui-btn layui-btn-primary" type="button" id="queryReset">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<br/>
<table id="corpTable"></table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/corp/corp.index.js?_btv=${resourceVersion}"></script>
</body>
</html>
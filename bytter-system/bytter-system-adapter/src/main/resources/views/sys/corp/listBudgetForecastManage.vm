            height: 22px;
            margin-bottom: 2px;
        }
        .balance-type .text-color1 {
            background: #D8E1FC;
        }
        .table1 {
            width: 100%;
        }
        .table1 th {
            background: #D8E1FC;
            color: #666;
        }
        .table1 th,

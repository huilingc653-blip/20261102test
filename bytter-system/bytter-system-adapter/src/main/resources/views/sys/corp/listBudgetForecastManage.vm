    <style>
        .forecast-wapper {
            padding: 0 20px 20px 20px;
        }
        .header {
            height: 24px;
            padding: 10px 0;
        }
        .header > * {
            float: left;
            height: 24px;
            line-height: 24px;
            margin-right: 8px;
        }
        .header .bt-biz-dict .layui-input {
            width: 120px;
        }
        .forecast-card {
            background: #FBFCFE;
            box-shadow: 0px 4px 28px 0px rgba(42,86,209,0.1000);
            border-radius: 6px;
            padding: 16px 20px;
            overflow: hidden;
            box-sizing: border-box;
        }
        .forecast-card .card-title {
            height: 22px;
            font-size: 16px;
            font-weight: 600;
            color: #333333;
            line-height: 22px;
            margin: 0px 20px 16px 18px;
            width: auto;
            position: relative;
        }
        .forecast-card .card-title img {
            position: absolute;
            width: 12px;
            left: -18px;
            top: 3px;
        }
        .text-color1 {
            color: #3857D6!important;
        }
        .manager-card1 {

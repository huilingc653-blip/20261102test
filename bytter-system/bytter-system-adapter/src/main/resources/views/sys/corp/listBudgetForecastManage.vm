<script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
<script type="text/javascript"
        src="${basePath}/static/plugins/scrollbar/jquery.mCustomScrollbar.concat.min.js?_btv=${resourceVersion}"></script>
<script>
    var corp;
    var selectType;
    var myChartSum;
    var search;
    bt.use(['form', 'selectType', 'corp', 'datatablecore','customTable','jquery','form', 'dicts'], function () {
        var $ = bt.jquery, form = bt.form();
        selectType = bt.selectType.init();
        corp = bt.corp.init();
        bt.dicts.init();
        var uiStyle = $('#uiStyle').val();
        if(uiStyle != '1') {
            $('body').addClass('old-skin');
        }
        var webSkin = store.get('web-skin')
        if(webSkin === 'dark-skin'){
            $('body').addClass('dark-skin')
        }else {
            $('body').removeClass('dark-skin')
        }
        // 美化滚动条
        $('.table-card1 .card-content').addClass('scroll-card-content')
        $('.table-card1 .card-content').mCustomScrollbar({theme: "minimal-dark",axis:'xy'});
        // 美化滚动条
        window.onresize = function () {
            myChartForecastLine.resize()
            myChartForecastBar.resize()
            myChartForecastPieChart.resize()
            myChartExecutePieChart.resize();
            myChartForecastPayLine.resize();
        }

        //资金预测分布图
        var myChartForecastLine = echarts.init(document.getElementById('chartForecastLine'));
        initForecastLine = function () {
            var option = initForecastLineChart();
            myChartForecastLine.setOption(option, true);
            myChartForecastLine.resize();
        };
        initForecastLine();

        function initForecastLineChart() {
            var option = {
                color: ['#4e6dec','#d2585d'],
                xAxis: {
                    type: 'category',
                    boundaryGap: false,
                    data: ['2022-07', '2022-09', '2022-10', '2022-11', '2022-12', '2023-01', '2023-02', '2023-03', '2023-04', '2023-05', '2023-06', '2023-07']
                },
                yAxis: {
                    type: 'value'
                },
                series: [
                    {
                        data: [400, 932, 901, 934, 1290, 1330, 1320,820, 932, 901, 934, 1290],
                        type: 'line',
                        areaStyle: {
                            color: {
                                type: 'linear',
                                x: 0,
                                y: 0,
                                x1: 0,
                                y1: 0,
                                colorStops: [{
                                    offset: 0, color: 'red'
                                },{
                                    offset: 1, color: 'blue'
                                }]
                            }
                        }
                    }
                ]
            };
            return option;
        }

        //直属单位预算支出预测数排行前五名
        var myChartForecastBar = echarts.init(document.getElementById('chartForecastBar'));
        initForecastBar = function () {
            var option = initForecastBarChart();
            myChartForecastBar.setOption(option, true);
            myChartForecastBar.resize();
        };
        initForecastBar();
        function initForecastBarChart() {
            var option = {
                color: ['#4e6dec','#d2585d'],
                xAxis: {
                    type: 'category',
                    data: ['深圳市拜特科技股份有限公司','深圳市前海拜特科技有限公司', '深圳市拜特数字科技有限公司', '上海市拜特股份有限公司', '北京市拜特科技股份有限公司']
                },
                yAxis: {
                    type: 'value'
                },
                series: [
                    {
                        barWidth:6,
                        yAxisIndex:0,
                        data: [120,150,80,110,130],
                        type: 'bar'
                    }
                ]
            }
            return option;
        }

        //主要支出项目预测数占比
        var myChartForecastPieChart = echarts.init(document.getElementById('chartForecastPie'));
        initForecastPie = function () {
            var option = initForecastPieChart();
            myChartForecastPieChart.setOption(option, true);
            myChartForecastPieChart.resize();
        };
        initForecastPie();
        function initForecastPieChart() {
            var industryData = [
                { value: 200, name: '流动资金计划/现款采购材料' },
                { value: 160, name: '流动资金计划/到期材料挂账' },
                { value: 100, name: '流动资金计划/其他费用' },
                { value: 150, name: '专项资金计划' },
                { value: 120, name: '其他' }
            ];
            var option = {
                color: ['#4e6dec','#d2585d','#ed955a','#ecda6c','#ec8b92'],
                tooltip: {
                    trigger: 'item'
                },
                legend: {
                    type: 'scroll',
                    orient: 'vertical',
                    x: 'left',
                    y: '5%',
                    data: ['流动资金计划/现款采购材料', '流动资金计划/到期材料挂账', '流动资金计划/其他费用', '专项资金计划', '其他'],
                    formatter:function(name){  //该函数用于设置图例显示后的百分比
                        var total = 0;
                        var value;
                        industryData.forEach(function (item) {
                            total += Number(item.value);
                            if (item.name == name) {
                                value = item.value;
                            }
                        })
                        var p = Math.round(((value / total) * 100)); //求出百分比
                        return name+" "+p+"%";  //返回出图例所显示的内容是名称+百分比
                    }
                },
                series: [
                    {
                        name: '',
                        type: 'pie',
                        radius: ['40%', '60%'],  // 设置饼状图大小，100%时，最大直径=整个图形的min(宽，高)
                        //radius: ['30%', '60%'],  // 设置环形饼状图， 第一个百分数设置内圈大小，第二个百分数设置外圈大小
                        center: ['60%', '60%'],  // 设置饼状图位置，第一个百分数调水平位置，第二个百分数调垂直位置
                        label: {
                            normal: {
                                //formatter: '{b}:{c}' + '\n\r' + '({d}%)',
                                show: false,
                                position: 'center'
                            }
                        },
                        data: industryData,
                        emphasis: {
                            itemStyle: {
                                shadowBlur: 10,
                                shadowOffsetX: 0,
                                shadowColor: 'rgba(0, 0, 0, 0.5)'
                            }
                        }
                    }
                ],
            };
            return option;
        }

        //主要支出项目执行数占比
        var myChartExecutePieChart = echarts.init(document.getElementById('chartExecutePie'));
        initExecutePie = function () {
            var option = initExecutePieChart();
            myChartExecutePieChart.setOption(option, true);
            myChartExecutePieChart.resize();
        };
        initExecutePie();
        function initExecutePieChart() {
            var industryData = [
                { value: 120, name: '流动资金计划/现款采购材料' },
                { value: 150, name: '流动资金计划/到期材料挂账' },
                { value: 80, name: '流动资金计划/其他费用' },
                { value: 110, name: '专项资金计划' },
                { value: 130, name: '其他' }
            ];
            var option = {
                color: ['#4e6dec','#d2585d','#ed955a','#ecda6c','#ec8b92'],
                tooltip: {
                    trigger: 'item'
                },
                legend: {
                    type: 'scroll',
                    orient: 'vertical',
                    x: 'left',
                    y: '5%',
                    data: ['流动资金计划/现款采购材料', '流动资金计划/到期材料挂账', '流动资金计划/其他费用', '专项资金计划', '其他'],
                    formatter:function(name){  //该函数用于设置图例显示后的百分比
                        var total = 0;
                        var value;
                        industryData.forEach(function (item) {
                            total += Number(item.value);
                            if (item.name == name) {
                                value = item.value;
                            }
                        })
                        var p = Math.round(((value / total) * 100)); //求出百分比
                        return name+" "+p+"%";  //返回出图例所显示的内容是名称+百分比
                    }
                },
                series: [
                    {
                        name: '',
                        type: 'pie',
                        radius: ['40%', '60%'],  // 设置饼状图大小，100%时，最大直径=整个图形的min(宽，高)
                        //radius: ['30%', '60%'],  // 设置环形饼状图， 第一个百分数设置内圈大小，第二个百分数设置外圈大小
                        center: ['60%', '60%'],  // 设置饼状图位置，第一个百分数调水平位置，第二个百分数调垂直位置
                        label: {
                            normal: {
                                //formatter: '{b}:{c}' + '\n\r' + '({d}%)',
                                show: false,
                                position: 'center'
                            }
                        },
                        data: industryData,
                        emphasis: {
                            itemStyle: {
                                shadowBlur: 10,
                                shadowOffsetX: 0,
                                shadowColor: 'rgba(0, 0, 0, 0.5)'
                            }
                        }
                    }
                ],
            };
            return option;
        }

        //直属单位预算支出预测数同比、环比分析
        var myChartForecastPayLine = echarts.init(document.getElementById('chartForecastPayLine'));
        initForecastPayLine = function () {
            var option = initForecastPayLineChart();
            myChartForecastPayLine.setOption(option, true);
            myChartForecastPayLine.resize();
        };
        initForecastPayLine();

        function initForecastPayLineChart() {
            var option = {
                color: ['#4e6dec','#d2585d'],
                gradientColor: ['#4e6dec','#d2585d'],
                tooltip: {
                    trigger: 'axis'
                },
                legend: {
                    data: ['同比', '环比']
                },
                grid: {
                    left: '3%',
                    right: '4%',
                    bottom: '3%',
                    containLabel: true
                },
                xAxis: {
                    type: 'category',
                    boundaryGap: false,
                    data: ['2022-01', '2022-02', '2022-03', '2022-04', '2022-05', '2022-06', '2022-07', '2022-08', '2022-09', '2022-10', '2022-11', '2022-12']
                },
                yAxis: {
                    type: 'value'
                },
                series: [
                    {
                        name: '同比',
                        type: 'line',
                        stack: 'Total',
                        markPoint: {
                            data: [
                                { type: 'max', name: 'Max' }
                            ]
                        },
                        data: [820, 932, 901, 934, 1290, 1330, 1320,820, 932, 901, 934, 1290],
                    },
                    {
                        name: '环比',
                        type: 'line',
                        stack: 'Total',
                        markPoint: {
                            data: [
                                { type: 'max', name: 'Max' }
                            ]
                        },
                        data: [820, 932, 901, 934, 1290, 1330, 1320,820, 932, 901, 934, 1290],
                    }
                ]
            };
            return option;
        }
    });
</script>

            height: 28px;
            border-bottom: 1px solid #E7EAF2;
            text-align: right;
            padding: 0 16px;
        }
        .table1 th.not-money,
        .table1 td.not-money {
            text-align: left;
        }
        .table1 tr.bg1 td {
            background: #F4F7FD;
            font-weight: 500;
            color: #333333;
        }

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .dark-skin .panel-head {
            background-color: #262936;
            border: 1px solid #2E2F34;
        }
        .dark-skin .panel {
            border: 1px solid #2E2F34;
        }
    </style>
</head>
<body>
<fieldset class="layui-elem-field layui-field-title">
    #if($region)
        <legend>${region.name}</legend>
    #else
        <legend>#springMessage('sys.region.index.manageProAndCity')</legend>
    #end
</fieldset>
<div class="margin-bottom">
##    新增
##    <button class="layui-btn layui-btn-primary add-btn" style="margin-left:15px;" data-id="$!{parentId}" >#springMessage('common.button.add')</button>
    #if($parentId)
##        返回
        <a class="layui-btn layui-btn-primary" href="javascript:history.go(-1);">#springMessage('common.button.revert')</a>
    #end
</div>
<div class="layui-fluid">
    <div class="layui-row layui-col-space10">
        #foreach($reg in $regions)
            <div class=" layui-col-sm4 layui-col-lg3">
                <div class="panel">
                    <div class="panel-head">${reg.name}</div>
                    <div class="panel-body text-center">
                        ##查看
                        <button class="layui-btn  layui-btn-primary view-btn" data-id="${reg.id}">#springMessage('common.button.view')</button>
                        ##                        编辑
##                        <button class="layui-btn  layui-btn-primary edit-btn" data-id="${reg.id}">#springMessage('common.button.edit')</button>
##                        删除
##                        <button class="layui-btn  layui-btn-danger delete-btn" data-id="${reg.id}">#springMessage('common.button.delete')</button>
                        #if(!$region)
##                            管理
                        <a class="layui-btn  layui-btn-primary" href="${basePath}/sys/region/index?parentId=${reg.id}">#springMessage('sys.region.manage')</a>
                        #end
                    </div>
                </div>
            </div>
        #end
    </div>
</div>

    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/region/region.index.js?_btv=${resourceVersion}"></script>
</body>
</html>

#set($basePath=$springMacroRequestContext.contextPath)
#set($user = $shiro.getPrincipal())
<div class="widget-user-info">
    <div class="layui-row">
##        <div class="layui-col-xs5">
##            <div style="margin: 30px 0;">
##                <img src="${basePath}/static/images/avatar.png" style="height: 140px;width: 140px" alt="$!{user.username}">
##            </div>
##        </div>
        <div class="layui-col-xs12">
            <div style="margin-top: 32px;height: 200px;">
                <p>欢迎回来,$!{user.username}</p>
                <div style="display: inline-block;margin: 0 auto;" >
                    <div style="text-align:left;padding-bottom: 8px">
                        所属单位:
                        <span>$!{corp.name}</span>
                    </div>

                    #set($roleArr = $!{roles.split("  ")})

                    <div title="$!{roles}" style="text-align: left;padding-top: 10px">
                        所属角色:
                        #foreach ($role in $!{roleArr})
                            #if($!{velocityCount} <= 3)
                                #if($!{velocityCount} == 1)
                                    <spanv>$!{role}</spanv>
                                #else
                                    <div style="margin-left: 64px;padding-top: 10px">$!{role}</div>#end
                            #end
                        #end
                    </div>
                </div>
            </div>

##            <div style="margin-top: 60px;height: 140px;">

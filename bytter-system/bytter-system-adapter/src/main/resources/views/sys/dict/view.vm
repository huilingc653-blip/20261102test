<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body style="min-width: 480px;">
<form class="layui-form" action="">
    <table class="layui-table">
        #if($dict)
        <tr>
##            字典组名称
            <td class="text-right">#springMessage('sys.dict.dictGroupName')</td>
            <td>
                <div class="layui-input-inline">
                    <select name="dictGroup.id" lay-verify="required">
                        <option value=""></option>
                        #foreach($dg in $dictGroupList)
                            <option value="${dg.id}" #if($dg.id == $dict.dictGroup.id) selected #end >${dg.groupName}</option>
                        #end
                    </select>
                </div>
            </td>
        </tr>
        #end
        #if(!$dict)
        <tr>
##            字典组名称
            <td class="text-right">#springMessage('sys.dict.dictGroupName')</td>
            <td>
                <input type="hidden" name="dictGroup.id">
                <input type="text" name="dictGroup.groupName" lay-verify="required" autocomplete="off" placeholder="#springMessage('sys.dict.dictGroupName.show')" class="layui-input" value="$!{dict.dictGroup.groupName}"   maxlength="50" >
            </td>
        </tr>
        #end
        <tr>
##            字典组
            <td class="text-right">#springMessage('sys.dict.groupCode')</td>
            <td>
                <input type="text" name="dictGroup.groupCode" lay-verify="required" autocomplete="off" placeholder="#springMessage('sys.dict.groupCode')" class="layui-input" value="$!{dict.dictGroup.groupCode}" maxlength="50">
            </td>
        </tr>

        #if($type)
            <tr>
##                字典名
                <td class="text-right">#springMessage('sys.dict.name')</td>
                <td>
                    <input type="hidden" name="id" >
                    <input type="text" name="name" lay-verify="required" autocomplete="off" placeholder="#springMessage('sys.dict.name.show')" class="layui-input" maxlength="50">
                </td>
            </tr>
            <tr>
##                字典值
                <td class="text-right">#springMessage('sys.dict.dictCode')</td>
                <td>
                    <input type="text" name="code" lay-verify="required" autocomplete="off" placeholder="#springMessage('sys.dict.dictCode.show')" class="layui-input" maxlength="50">
                </td>
            </tr>
            <tr>
##                字典排序
                <td class="text-right">#springMessage('sys.dict.dictSort')</td>
                <td>
                    <input type="text" name="sort" lay-verify="required" autocomplete="off" placeholder="#springMessage('sys.dict.dictSort.show')" class="layui-input" value="500"  maxlength="6">
                </td>
            </tr>
        #else
            <tr>
##                字典名
                <td class="text-right">#springMessage('sys.dict.name')</td>
                <td>
                    <input type="hidden" name="id" value="$!{dict.id}">
                    <input type="text" name="name" lay-verify="required" autocomplete="off" placeholder="#springMessage('sys.dict.name.show')" class="layui-input" value="$!{dict.name}" maxlength="50">
                    <span data-toggle="i18n" data-type="base" data-key-id="$!{dict.id}"/>
                </td>
            </tr>
            <tr>
##                字典值
                <td class="text-right">#springMessage('sys.dict.dictCode')</td>
                <td>
                    <input type="text" name="code" lay-verify="required" autocomplete="off" placeholder="#springMessage('sys.dict.dictCode.show')" class="layui-input" value="$!{dict.code}" maxlength="50">
                </td>
            </tr>
            <tr>
##                字典排序
                <td class="text-right">#springMessage('sys.dict.dictSort')</td>
                <td>
                    <input type="text" name="sort" lay-verify="required" autocomplete="off" placeholder="#springMessage('sys.dict.dictSort.show')" class="layui-input" value="$!{dict.sort}" maxlength="6">
                </td>
            </tr>
        #end
    </table>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="menuSubmit">#springMessage('common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>

    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/dict/dict.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
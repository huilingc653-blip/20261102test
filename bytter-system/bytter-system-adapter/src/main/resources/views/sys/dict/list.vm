<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form " action="" id="searchForm">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('sys.dict.dictGroup')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/sys/dict/list.json"
                     data-name ="dictGroupId" data-biz-name ="dictGroupId"  data-valueField="id" data-textField="groupName"
                     data-search="true"
                ></div>
            </td>
            <td class="textRight">#springMessage('sys.dict.groupCode')</td>
            <td>
                <input type="text" name="dictGroupCode" autocomplete="off" class="layui-input">
            </td>
            <td class="textRight">#springMessage('sys.dict.name')</td>
            <td>
                <input type="text" name="name" autocomplete="off" class="layui-input">
            </td>
        </tr>
        <tr>
            <td colspan="6" class="text-center">
                <button class="layui-btn layui-btn-small" lay-submit="" lay-filter="search">#springMessage("common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable"></table>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/dict/dict.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

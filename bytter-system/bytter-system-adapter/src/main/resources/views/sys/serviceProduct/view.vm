<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" action="">
    <input type="hidden" name="id" value="$!{serviceProduct.id}">
    <div class="layui-form-item">
        <label class="layui-form-label">服务名称</label>
        <div class="layui-input-inline">
            <input type="text" style="width: 350px;" name="name" lay-verify="required" autocomplete="off" placeholder="" class="layui-input" value="$!{serviceProduct.name}">
        </div>
    </div>

    <div class="layui-form-item">
        <label class="layui-form-label">服务描述</label>
        <div class="layui-input-inline">
            <input type="text" style="width: 350px;" name="description" lay-verify="required" autocomplete="off" placeholder="" class="layui-input" value="$!{serviceProduct.description}">
        </div>
    </div>

    <div class="layui-form-item">
        <label class="layui-form-label">服务URL</label>
        <div class="layui-input-inline">
            <input type="text" style="width: 350px;" name="url" lay-verify="required" autocomplete="off" placeholder="" class="layui-input" value="$!{serviceProduct.url}">
        </div>
    </div>

    <div class="layui-form-item">
        <label class="layui-form-label">服务状态</label>
        <div class="layui-input-inline">
            <input type="text" style="width: 350px;" name="status" lay-verify="required" autocomplete="off" placeholder="" class="layui-input" value="$!{serviceProduct.status}">
        </div>
    </div>

    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="serviceSubmit">#springMessage('common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
    </div>
</form>

    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/sys/serviceProduct/serviceProduct.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
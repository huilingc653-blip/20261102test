<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        body{padding-bottom: 10px;}
        .list-group {margin-bottom: 20px;padding-left: 0}
        .list-group-item {position: relative;display: block;padding: 5px 10px;margin-bottom: -1px;background-color: #fff;border: 1px solid #ddd}
        .list-group-item:first-child {border-top-right-radius: 4px;border-top-left-radius: 4px}
        .list-group-item:last-child {margin-bottom: 0;border-bottom-right-radius: 4px;border-bottom-left-radius: 4px}
        .list-group-item>.badge {float: right}
        .list-group-item>.badge+.badge {margin-right: 5px}
        a.list-group-item {color: #555}
        a.list-group-item .list-group-item-heading {color: #333}
        a.list-group-item:hover,a.list-group-item:focus {text-decoration: none;background-color: #f5f5f5}
        a.list-group-item.active,a.list-group-item.active:hover,a.list-group-item.active:focus {z-index: 2;color: #fff;background-color: #428bca;border-color: #428bca}
        a.list-group-item.active .list-group-item-heading,a.list-group-item.active:hover .list-group-item-heading,a.list-group-item.active:focus .list-group-item-heading {color: inherit}
        a.list-group-item.active .list-group-item-text,a.list-group-item.active:hover .list-group-item-text,a.list-group-item.active:focus .list-group-item-text {color: #e1edf7}
        .list-group-item-success {color: #3c763d;background-color: #dff0d8}
        a.list-group-item-success {color: #3c763d}
        a.list-group-item-success .list-group-item-heading {color: inherit}
        a.list-group-item-success:hover,a.list-group-item-success:focus {color: #3c763d;background-color: #d0e9c6}
        a.list-group-item-success.active,a.list-group-item-success.active:hover,a.list-group-item-success.active:focus {color: #fff;background-color: #3c763d;border-color: #3c763d}
        .list-group-item-info {color: #31708f;background-color: #d9edf7}
        a.list-group-item-info {color: #31708f}
        a.list-group-item-info .list-group-item-heading {color: inherit}
        a.list-group-item-info:hover,a.list-group-item-info:focus {color: #31708f;background-color: #c4e3f3}
        a.list-group-item-info.active,a.list-group-item-info.active:hover,a.list-group-item-info.active:focus {color: #fff;background-color: #31708f;border-color: #31708f}
        .list-group-item-warning {color: #8a6d3b;background-color: #fcf8e3}
        a.list-group-item-warning {color: #8a6d3b}
        a.list-group-item-warning .list-group-item-heading {color: inherit}
        a.list-group-item-warning:hover,a.list-group-item-warning:focus {color: #8a6d3b;background-color: #faf2cc}
        a.list-group-item-warning.active,a.list-group-item-warning.active:hover,a.list-group-item-warning.active:focus {color: #fff;background-color: #8a6d3b;border-color: #8a6d3b}
        .list-group-item-danger {color: #a94442;background-color: #f2dede}
        a.list-group-item-danger {color: #a94442}
        a.list-group-item-danger .list-group-item-heading {color: inherit}
        a.list-group-item-danger:hover,a.list-group-item-danger:focus {color: #a94442;background-color: #ebcccc}
        a.list-group-item-danger.active,a.list-group-item-danger.active:hover,a.list-group-item-danger.active:focus {color: #fff;background-color: #a94442;border-color: #a94442}
        .list-group-item-heading {margin-top: 0;margin-bottom: 5px}
        .list-group-item-text {margin-bottom: 0;line-height: 1.3}
        .select-user-name {font-size: 14px;font-weight: bold;}
        .select-user-op-icon {position: absolute;right: 10px;top: 17px;}
        .ztree {overflow: auto;height: 370px;}
        .article-required-icon {color: red;margin: 5px;font-weight: bold;}
    </style>
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-form-item">
        ## 消息标题
        <label class="layui-form-label"><span class="article-required-icon">*</span>#springMessage("sys.userMessage.title")</label>
        <div class="layui-input-block">
            <input type="text" name="title" required autocomplete="off" class="layui-input">
        </div>
    </div>
    <div class="layui-form-item layui-form-text">
        ## 消息内容
        <label class="layui-form-label"><span class="article-required-icon">*</span>#springMessage("sys.userMessage.context")</label>
        <div class="layui-input-block">
            <textarea name="context" rows="6"
                      lay-verify="strlength" data-maxlength="3000"
                      class="layui-textarea"></textarea>
        </div>
    </div>
    <div class="layui-form-item">
        ## 接收人
        <label class="layui-form-label">#springMessage("sys.userMessage.receiver")</label>
        <div class="layui-input-block">
            ## 所有用户
            <input type="radio" name="send-type" lay-filter="send-type" value="0" title="#springMessage("sys.userMessage.allUser")" checked>
            ## 指定用户
            <input type="radio" name="send-type" lay-filter="send-type" value="1" title="#springMessage("sys.userMessage.orderUser")">
        </div>
    </div>
    <div class="layui-row layui-col-space20 hide select-user-container" style="height: 450px;">
        <div class="layui-col-xs4">
            <div>
                <h4 style="display: inline;font-size: 18px;margin:10px 0;">#springMessage('sys.role.assignUser.title')</h4>
                <a href="javascript:void(0)"  style="color:blue;float:right;margin:10px;" id="display-child">#springMessage('sys.role.assignUser.notDisplayChildrenCorpUser')</a>
            </div>
            <hr>
            <div class="ztree" id="corpTree"></div>
        </div>
        <div class="layui-col-xs4" style="border-left: 1px dashed #b9b9b9;border-right: 1px dashed #b9b9b9;height: 100%">
            <h4 style="display: inline;font-size: 18px;margin:10px 0;">#springMessage('sys.role.assignUser.preUserSelect')</h4>
            <a href="javascript:void(0)"  style="color:blue;float:right;margin:10px;" id="select-all">#springMessage('common.select.all')</a>
            <hr>
            <div class="list-group" id="pre-select-user" style="height: 370px;overflow: auto;">
                <div>#springMessage('sys.role.assignUser.selectUser')</div>
            </div>
        </div>
        <div class="layui-col-xs4">
            <h4 style="display: inline;font-size: 18px;margin:10px 0;">#springMessage('sys.role.assignUser.selectedUser')</h4>
            <a href="javascript:void(0)"  style="color:blue;float:right;margin:10px;"  id="unselect-all">#springMessage('common.select.remove')</a>
            <hr>
            <div class="list-group" id="selected-user" style="height: 370px;overflow: auto;">
            </div>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" id="userMessageSubmit">#springMessage('common.button.submit')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script type="application/javascript">
    bt.use(['jquery', 'form', 'ztree'], function () {
        var $ = bt.jquery, form = layui.form();

        //当前是否显示下级单位的用户
        var displayChildUser = false;

        var preSelectUserList = [];
        var selectedUserList = [];
        //渲染准备选择用户
        var renderPreSelectUserList = function () {
            var html = '';
            if (preSelectUserList.length === 0) {
                //该网点、单位未分配用户
                html += '<div>'+bt.lang("sys.role.assign.unAssign")+'</div>';
                $("#pre-select-user").html(html);
                return;
            }
            for (var i = 0; i < preSelectUserList.length; i++) {
                var node = preSelectUserList[i];
                var checked = checkHasSelected(node);
                html += '<a href="javascript:void(0);" class="list-group-item ' + (checked ? "list-group-item-success" : "") + '" data-userid="' + node.id + '">';
                html += '<div class="select-user-name">(' + node.loginName + ')' + node.username + '</div>';
                html += '<div class="select-user-text">' + node.corpName + '</div>';
                if (checked) {
                    html += '<span class="select-user-op-icon"><i class="fa fa-times" aria-hidden="true"></i></span>';
                } else {
                    html += '<span class="select-user-op-icon"><i class="fa fa-plus" aria-hidden="true"></i></span>';
                }
                html += '</a>';
            }
            $("#pre-select-user").html(html);
        };

        //渲染被选中的用户
        var renderSelectUserList = function () {
            var html = '';
            for (var k in selectedUserList) {
                var node = selectedUserList[k];
                html += '<a href="javascript:void(0);" class="list-group-item" data-userid="' + node.id + '" data-select-userid="' + node.id + '">';
                html += '<div class="select-user-name">(' + node.loginName + ')' + node.username + '</div>';
                html += '<div class="select-user-text">' + node.corpName + '</div>';
                html += '<span class="select-user-op-icon"><i class="fa fa-times" aria-hidden="true"></i></span>';
                html += '</a>';
            }
            $("#selected-user").html(html);
        };

        $("#selected-user").on('click', 'a', function () {
            var _that = $(this);
            var userId = _that.data("userid");
            removeByValue(selectedUserList, userId)
            renderPreSelectUserList();
            renderSelectUserList();
        });

        $("#pre-select-user").on('click', 'a', function () {
            var _that = $(this);
            var userId = _that.data("userid");
            if (_that.hasClass("list-group-item-success")) {
                removeByValue(selectedUserList, userId)
            } else {
                for (var k in preSelectUserList) {
                    var user = preSelectUserList[k];
                    if (user.id === userId) {
                        selectedUserList.push(user);
                        break;
                    }
                }
            }
            renderPreSelectUserList();
            renderSelectUserList();
        });

        //备选用户全选
        $("#select-all").on('click', function () {
            if ($('.curSelectedNode').length < 1) {
                return;
            }
            // selectedUserList = [];
            for (var k in preSelectUserList) {
                var user = preSelectUserList[k];
                var selectUser = $("a[data-select-userid='" + user.id + "']");
                if(!(selectUser && selectUser.length)){
                    selectedUserList.push(user);
                }
            }
            renderPreSelectUserList();
            renderSelectUserList();
        });

        function removeByValue(arr, val) {
            for (var i = 0; i < arr.length; i++) {
                if (arr[i].id === val) {
                    arr.splice(i, 1);
                    break;
                }
            }
        }

        //已选用户全删
        $("#unselect-all").on('click', function () {
            selectedUserList = [];
            renderPreSelectUserList();
            renderSelectUserList();
        });

        function checkHasSelected(user) {
            for (var i = 0; i < selectedUserList.length; i++) {
                var sUser = selectedUserList[i];
                if (sUser.id === user.id) {
                    return true;
                }
            }
            return false;
        }

        var nodeClick = function (event, treeId, treeNode) {
            $('input[name="corpId"]').val(treeNode.id);
            $.ajax({
                url: basePath + "/sys/user/listByCorpId",
                async: false,
                dataType: "json",
                data: {corpId: treeNode.id},
                success: function (nodes) {
                    setTimeout(function () {
                        parent.layer.closeAll('loading');
                    }, 300);
                    for (var k in nodes) {
                        nodes[k]['corpId'] = treeNode.id;
                        nodes[k]['corpName'] = treeNode.name;
                    }
                    preSelectUserList = nodes;
                }
            });
            if (displayChildUser) {
                if (treeNode.children) {
                    getPreUser(treeNode.children, preSelectUserList);
                }
            }
            renderPreSelectUserList();
        };

        var setting = {
            data: {simpleData: {enable: true, idKey: "id", pIdKey: "pId"}},
            callback: {onClick: nodeClick}
        };
        var ztree;
        var sendUserType = "0";
        form.on('radio(send-type)',function(data){
            sendUserType = data.value;
            if(data.value==="1"){
                $('.select-user-container').show();
                if(ztree){
                    return;
                }
                bt.loading.show();
                $.ajax({
                    type: "GET",
                    url: basePath + "/sys/corp/tree",
                    dataType: "JSON",
                    success: function (nodes) {
                        for (var k in nodes) {
                            nodes[k]['name'] = "(" + nodes[k]['code'] + ") " + nodes[k]['name'];
                        }
                        ztree = $.fn.zTree.init($("#corpTree"), setting, nodes);
                        ztree.expandAll(true);
                        setTimeout(function () {bt.loading.hide();}, 500);
                    },
                    error: function () {
                        setTimeout(function () {bt.loading.hide();}, 500);
                    }
                });
            }else{
                $('.select-user-container').hide();
            }
        });


        //显示下级单位用户，这里用到递归去多次请求节点的用户。
        $('#display-child').on('click', function () {
            if ($('.curSelectedNode').length < 1) {
                layer.alert(bt.lang("common.select.corpNet"), {icon: 2});
                return;
            }
            var loading = parent.layer.load(1, {
                shade: [0.3, '#000'] //0.3透明度的白色背景
            });
            setTimeout(function () {
                parent.layer.close(loading);
            }, 800);
            var nodes = ztree.getSelectedNodes();
            if (displayChildUser) {
                displayChildUser = false;
                nodeClick(event, nodes[0].tId, nodes[0]);
                $('#display-child').text(bt.lang('sys.role.assignUser.notDisplayChildrenCorpUser'));
            } else {
                if (nodes.length > 0) {
                    var children = nodes[0].children;
                    if (children) {
                        getPreUser(children, preSelectUserList);
                        renderPreSelectUserList();
                    }
                }
                displayChildUser = true;
                $('#display-child').text(bt.lang('sys.role.assignUser.displayChildrenCorpUser'));
            }
        });

        //递归获取网点用户。
        function getPreUser(node, preUser) {
            //转换成数组对象,当node.length=1时，
            var nodeArray = [];
            node instanceof Array ? nodeArray = Array.from(node) : nodeArray.push(node);
            for (var i = 0; i < nodeArray.length; i++) {
                var tmpNode = ztree.getNodeByTId(nodeArray[i].tId);
                $.ajax({
                    type: "GET",
                    url: basePath + "/sys/user/listByCorpId",
                    async: false, //这里要把ajax请求设置成同步
                    dataType: 'json',
                    data: {corpId: tmpNode.id},
                    success: function (nodes) {
                        //赋值网点名称到页面显示
                        if (nodes instanceof Array) {
                            if (nodes.length > 0) {
                                for (var k in nodes) {
                                    nodes[k]['corpId'] = tmpNode.id;
                                    nodes[k]['corpName'] = tmpNode.name;
                                    preUser.push(nodes[k]);
                                }
                            }
                        }
                    }
                });
                if (tmpNode.isParent) {
                    var children = tmpNode.children;
                    //子节点获取角色
                    getPreUser(children, preUser);
                }
            }
        }


        $("#userMessageSubmit").click(function () {
            var temp = [];
            for (var k in selectedUserList) {
                var user = selectedUserList[k];
                temp.push(user.id);
            }
            var title = $('input[name="title"]').val();
            var context = $('textarea[name="context"]').val()
            if(!title || !context){
                //消息标题和消息内容不能为空
                parent.layer.alert(bt.lang("sys.userMessage.alert.titleEmpty"), {icon: 7});
                return;
            }
            if(title.length<5||title.length>=100){
                //消息标题过长，不能大于100
                parent.layer.alert(bt.lang("sys.userMessage.alert.titleLength"), {icon: 7});
                return;
            }
            if(context.length>1500){
                //消息标题过长，不能大于1500
                parent.layer.alert(bt.lang("sys.userMessage.alert.conentLength"), {icon: 7});
                return;
            }
            if(sendUserType==="1" && temp.length===0){
                parent.layer.alert(bt.lang("sys.user.please.selectUser"), {icon: 7});
                return;
            }
            var tempData = {
                title:title,
                context:context,
                type: sendUserType,
                userList: temp,
            };
            bt.loading.show();
            $.ajax({
                type: "POST",
                url: basePath + "/sys/userMessage/send",
                data: tempData,//将对象序列化成JSON字符串
                dataType: "json",
                success: function (result) {
                    bt.loading.hide();
                    parent.layer.alert(result.msg, {icon: result.success ? 1 : 2},function(){
                        parent.layer.closeAll();
                    });
                },
                error: function () {
                    bt.loading.hide();
                }
            });
        });
    });
</script>
</body>
</html>
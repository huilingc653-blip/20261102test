<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div style="text-align: center">
    <h1 style="margin-bottom: 10px;">${message.title}</h1>
    <div style="color:#999999">
        <span style="margin-right: 20px;">发送人:$!{message.createUserName}</span>
        <span>发送时间:$!date.format("yyyy-MM-dd HH:mm:ss",$!{message.createDate})</span>
    </div>
</div>
<div>
    <hr>
</div>
<div style="padding: 20px;">
    ${message.context}
</div>


<div class="layui-form-item layui-form-submit">
    <div class="layui-input-block" style="margin: 0;">
        <button type="button" class="layui-btn layui-btn-primary close-button">#springMessage('common.button.close')</button>
    </div>
</div>
    #parse("views/common/footer.vm")
<script type="application/javascript">
    bt.use(['jquery'], function () {$('.close-button').click(function(){parent.layer.closeAll();});});
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form ">
    <table class="layui-table ">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.btLog.userName')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_username"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.btLog.userName')">
                </div>
            </td>
            <td class="textRight">#springMessage('table.btLog.logcontent')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_logcontent"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.btLog.logcontent')">
                </div>
            </td>
            <td class="textRight">#springMessage('table.btLog.note')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" name="likes_note"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.btLog.note')">
                </div>
            </td>
            <td class="textRight">#springMessage('table.btLog.operatetime')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" name="ged_startTime" class="layui-input bt-input-inline bt-biz-dateType" data-endid="endTime">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_endTime" class="layui-input bt-input-inline bt-biz-dateType" id="endTime">
                </div>
            </td>
        <tr>
            <td colspan="8" style="text-align:center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btLog.logcontent')</th>
        <th>#springMessage('table.btLog.broswer')</th>
        <th>#springMessage('table.btLog.note')</th>
        <th>#springMessage('table.btLog.userName')</th>
        <th>#springMessage('table.btLog.operatetime')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/log/btLog.list.js"></script>
</html>

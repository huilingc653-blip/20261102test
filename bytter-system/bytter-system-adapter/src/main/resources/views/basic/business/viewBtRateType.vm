<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight">#springMessage('table.depositRateType.name')</td>
					<td width="60%">$!{btRateTypePage.typeName}</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
					<td>
						$!{btRateTypePage.rmk}
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.btRateType.decimalPlaces')</td>
					<td>
						$dictTag.get("btRateType.decimalPlaces",$!{btRateTypePage.decimalPlaces})
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.validSign')</td>
					<td>
						$dictTag.get("valid_sign",$!{btRateTypePage.validSign})
					</td>
				</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
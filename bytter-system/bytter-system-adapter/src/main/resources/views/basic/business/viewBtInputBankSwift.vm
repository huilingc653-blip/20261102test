<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
	<table class="layui-table">
			<tbody>
				<tr>
					##开户行行号
    				<td width="40%" class="textRight">#springMessage('table.btInputBankInfo.bankCode')</td>
					<td>
                        $!{btInputBankSwift.bankCode}
					</td>
				</tr>

				<tr>
					##开户行名称
					<td width="40%" class="textRight">#springMessage('table.btInputBankInfo.bankName')</td>
					<td>
						$!{btInputBankSwift.bankName}
					</td>
				</tr>

				<tr>
					##swiftCode
					<td width="40%" class="textRight">#springMessage('table.btInputBankSwift.swiftCode')</td>
					<td>
						$!{btInputBankSwift.swiftCode}
					</td>
				</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
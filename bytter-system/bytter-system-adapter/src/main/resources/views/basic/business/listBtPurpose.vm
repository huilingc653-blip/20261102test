<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('table.btPurpose.purpose')</td>
                <td>
                    <input type="text" id="likes_purpose" name="likes_purpose" maxlength="100"
                        autocomplete="off" class="layui-input" placeholder="#springMessage('table.btPurpose.purpose')"/>
                </td>
                <td class="textRight">#springMessage('table.btPurpose.corpId')</td>
                <td >
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"  data-biz-type="corp" data-type="selectTree"  data-name="likes_corpId" data-scope="all"></div>
                    </div>
                </td>
                <td class="textRight">#springMessage('table.btPurpose.sysBusType')</td>
                <td >
                    <div class="bt-biz-dict" data-type="select" data-group="btPurpose.sysBusType" data-defaultvalue="" data-name="likes_sysBusType"></div>
                </td>
            </tr>
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
        </div>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.btPurpose.purpose')</th>
                <th>#springMessage('table.btPurpose.sysBusType')</th>
                <th>#springMessage('table.btPurpose.corpId')</th>
                <th>#springMessage('table.nisBillhead.curId')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/btPurpose.list.js?_btv=${resourceVersion}"></script>
</html>

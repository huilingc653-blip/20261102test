<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{btInputBankInfoPage.id}">
		<input id="ibpsCode" name="ibpsCode" type="hidden" value="1">
		<input id="createBy" name="createBy" type="hidden" value="$!{btInputBankInfoPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{btInputBankInfoPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{btInputBankInfoPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{btInputBankInfoPage.updateDate}">
		<table class="layui-table">
			<tbody>
				<tr>
					##开户行行号
					<td class="textRight" width="30%">#springMessage('table.btInputBankInfo.bankCode')</td>
					<td>
						<input type="text" id="bankCode" name="bankCode" lay-verify="required|strlength|number" data-maxlength="30"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.btInputBankInfo.bankCode')">
					</td>
				</tr>
				<tr>
					##开户行名称
                    <td class="textRight">#springMessage('table.btInputBankInfo.bankName')</td>
                    <td>
                        <input type="text" id="bankName" name="bankName" lay-verify="required"
						   autocomplete="off" class="layui-input" placeholder="#springMessage('table.btInputBankInfo.bankName')">
                    </td>
				</tr>
##				<tr>
##					##所在省市
##					<td class="textRight">#springMessage('btInputBankInfo.prov')</td>
##					<td>
##                        <div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="prov" data-change="city" data-defaultvalue=""></div>
##                        <div class="layui-input-inline bt-biz-region" data-group="payeeAddr" data-name="city" data-defaultvalue=""></div>
##					</td>
##				</tr>
				<tr>
					<td colspan="2" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					 </td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/basic/business/btInputBankInfo.add.js?_btv=${resourceVersion}"></script>
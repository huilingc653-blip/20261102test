<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<input id="createBy" name="createBy" type="hidden" value="$!{btCurrencyPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{btCurrencyPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{btCurrencyPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{btCurrencyPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{btCurrencyPage.id}">
		<input id="curExrate" name="curExrate" type="hidden" value="$!{btCurrencyPage.curExrate}">
		<input id="nonworkDay" name="nonworkDay" type="hidden" value="$!{btCurrencyPage.nonworkDay}">
		<table class="layui-table">
			<tbody>
				<tr>
    				<td width="20%" class="textRight">#springMessage('table.btCurrency.curCode')</td>
					<td width="30%">
						$!{btCurrencyPage.curCode}
					</td>
					<td class="textRight" width="20%">#springMessage('table.btCurrency.sysCurName')</td>
					<td width="30%">$!{btCurrencyPage.sysCurName}</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.btCurrency.curName')</td>
					<td>
						$!{btCurrencyPage.curName}
					</td>
    				<td class="textRight">#springMessage('table.btCurrency.englishCode')</td>
					<td>
						$!{btCurrencyPage.englishCode}
					</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.btCurrency.curExrate')</td>
					<td>
						<label id="curExrateText"></label>
					</td>
    				<td class="textRight">#springMessage('table.btCurrency.curSign')</td>
					<td>
						$!{btCurrencyPage.curSign}
					</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.btCurrency.rmk')</td>
					<td colspan="3">
    					$!{btCurrencyPage.rmk} 
					</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.btCurrency.pbScaleCode')</td>
					<td>
						$!{btCurrencyPage.pbScaleCode}
					</td>
    				<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
					<td>
                        $dictTag.get("valid_sign",$!{btCurrencyPage.validSign})
					</td>
				</tr>
				<tr>
					<td class="textRight" width="30%">#springMessage('table.btCurrency.nonworkDayRule')</td>
					<td colspan="3">
						$dictTag.get("btCurrency.nonWorkDayRule",$!{btCurrencyPage.nonworkDayRule})
					</td>
				</tr>
				<tr>
					<td class="textRight" width="30%">#springMessage('table.btCurrency.nonworkDay')</td>
					<td colspan="3">
						<label id="nonworkDayText" ></label>
					</td>
				</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
<script>
	bt.use(['moneyType'],function () {
        var moneyFun = bt.moneyType.getFun();
        var opt = {
            separator: ",",
            decimal: 4
        }
        $("#curExrateText").text(moneyFun.format($("#curExrate").val(),opt));

		//非工作日规则组装
		var nonworkDays = $("#nonworkDay").val().split(",");
		var nonworkDay;
		$.each(nonworkDays, function(i, day){
			if(null == nonworkDay ){
				nonworkDay = bt.dict("btCurrency.nonWorkDay", day);
			}else{
				nonworkDay += "," + bt.dict("btCurrency.nonWorkDay", day);
			}
		});
		$("#nonworkDayText").html(nonworkDay);
    })
</script>
</body>
</html>
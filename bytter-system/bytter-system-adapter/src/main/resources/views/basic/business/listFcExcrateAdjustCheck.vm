<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="eqi_status" value="11">
    <table class="layui-table">
        <tbody>
        <tr>
        ##汇率类型
            <td class="textRight">#springMessage('table.btRateType.typeName')</td>
            <td>
                <div type="list" data-name="eqs_typeId" class="bt-biz-selectType"
                     data-url="${basePath}/basic/business/btratetype/json" data-valueField="id" data-textField="typeName"></div>
            </td>
            <td class="textRight">#springMessage('table.fcExcrateAdjust.cur')</td>
            <td >
                <div type="list" data-name ="eqs_curId" class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-valueField="id" data-textField="curName"></div>
            </td>
            <td class="textRight">#springMessage('table.fcExcrateAdjust.preTime')</td>
            <td colspan="3">
                <input type="text" name="ged_preTime" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="led_preTime" value="">
                <span class="date-mid">~</span>
                <input type="text" name="led_preTime" class="layui-input bt-input-inline bt-biz-dateType"
                       id="led_preTime">
            </td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btRateType.typeName')</th>
        <th>#springMessage('table.fcExcrateAdjust.cur')</th>
        <th>#springMessage('table.fcExcrateAdjust.referCurId')</th>
        <th>#springMessage('table.fcExcrateAdjust.preTime')</th>
        <th>#springMessage('table.fcExcrateAdjust.oldExchangeRate')</th>
        <th>#springMessage('table.fcExcrateAdjust.newExchangeRate')</th>
        <th>#springMessage('table.fcExcrateAdjust.foreignExchangePurchase')</th>
        <th>#springMessage('table.fcExcrateAdjust.foreignExchangeSell')</th>
        <th>#springMessage('table.fcExcrateAdjust.foreignExchangeMiddle')</th>
        <th>#springMessage('table.fcExcrateAdjust.status')</th>
        <th>#springMessage('table.fcExcrateAdjust.rmk')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/fcExcrateAdjustCheck.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                ##开户行行号
                    <td class="textRight">#springMessage('table.btInputBankInfo.bankCode')</td>
                    <td width="40%">
                           <input type="text" name="bankCode" autocomplete="off" class="layui-input" placeholder="#springMessage('table.btInputBankInfo.bankCode')">
                    </td>
                    ##开户行名称
                    <td class="textRight">#springMessage('table.btInputBankInfo.bankName')</td>
                    <td width="40%">
                            <input type="text" name="bankName" autocomplete="off" class="layui-input" placeholder="#springMessage('table.btInputBankInfo.bankName')">
                    </td>
                </tr>
                <tr>
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.btInputBankInfo.bankCode')</th>
                <th>#springMessage('table.btInputBankInfo.bankName')</th>
                <th>#springMessage('table.btInputBankInfo.prov')</th>
                <th>#springMessage('table.btInputBankInfo.city')</th>
                <th>#springMessage('common.table.updateTime')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/btInputBankInfo.list.js?_btv=${resourceVersion}"></script>
</html>

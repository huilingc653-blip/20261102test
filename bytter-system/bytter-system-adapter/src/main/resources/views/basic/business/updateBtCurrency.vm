<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>

	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{btCurrencyPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{btCurrencyPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{btCurrencyPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{btCurrencyPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{btCurrencyPage.id}">
		<input id="naturalSign" name="naturalSign" type="hidden" value="$!{btCurrencyPage.naturalSign}">
		<table class="layui-table">
			<tbody>
				#set($isSystem = $!{btCurrencyPage.isSystem} == 1)

				<tr>
##    				<td class="textRight" width="20%">#springMessage('table.btCurrency.naturalSign')</td>
##                    <td width="30%">
##
##                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{btCurrencyPage.naturalSign}" data-name="naturalSign"></div>
##    				</td>
    				<td class="textRight" width="20%">#springMessage('table.btCurrency.curCode')</td>
                    <td width="30%">
						<input type="text" id="curCode" name="curCode" lay-verify="required|numberOrletter" #if($isSystem) readonly="readonly" #end
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.btCurrency.curCode')" value="$!{btCurrencyPage.curCode}">
    				</td>
					<td class="textRight" width="20%">#springMessage('table.btCurrency.sysCurName')</td>
					<td width="30%">
						<div class="layui-input-inline">
							<input id="sysCurId" name="sysCurId" type="hidden" value="$!{btCurrencyPage.sysCurId}">
							<input type="text" id="sysCurName" name="sysCurName" lay-verify="required|tableData" data-biz-name="sysCurName" value="$!{btCurrencyPage.sysCurName}"
								   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.btCurrency.sysCurName')">
							<table id="sysCurTable" class="hide">
								<thead>
								<tr>
									<th>#springMessage('table.btCurrency.englishCode')</th>
									<th>#springMessage('table.btCurrency.curName')</th>
								</tr>
								</thead>
							</table>
						</div>
					</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.btCurrency.curName')</td>
                    <td>
						<div class="layui-inline">
							<input style="display: inline;" type="text" id="curName" name="curName" lay-verify="required|strlength"
								   data-maxlength="30" #if($isSystem) readonly="readonly" #end
								   autocomplete="off" class="layui-input"
								   placeholder="#springMessage('table.btCurrency.curName')"
								   value="$!{btCurrencyPage.curName}">
							<span data-toggle="i18n" data-key-id="$!{btCurrencyPage.id}"/>
						</div>
					</td>
    				<td class="textRight">#springMessage('table.btCurrency.englishCode')</td>
                    <td>
						$!{btCurrencyPage.englishCode}
						<input type="hidden" id="englishCode" name="englishCode" value="$!{btCurrencyPage.englishCode}">
    				</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.btCurrency.curExrate')</td>
                    <td>
						<input type="text" id="curExrate" name="curExrate"data-biz-name="curExrate" data-name="curExrate" data-decimal="4" lay-verify="required" data-max="99999999.9999"
							autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.btCurrency.curExrate')" value="$!{btCurrencyPage.curExrate}">
    				</td>
    				<td class="textRight">#springMessage('table.btCurrency.curSign')</td>
                    <td>
						<input type="text" id="curSign" name="curSign" lay-verify="strlength" data-maxlength="20"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.btCurrency.curSign')" value="$!{btCurrencyPage.curSign}">
    				</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.btCurrency.rmk')</td>
                    <td colspan="3">
        				<textarea id="rmk" name="rmk" class="layui-textarea" lay-verify="strlength"  data-maxlength="200" id="rmk" name="rmk" >$!{btCurrencyPage.rmk}</textarea>
					</td>
				</tr>
				<tr>
                    <td class="textRight">#springMessage('table.btCurrency.pbScaleCode')</td>
                    <td>
                        <input type="text" id="pbScaleCode" name="pbScaleCode" lay-verify="numberOrletter|strlength" data-maxlength="20"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.btCurrency.pbScaleCode')" value="$!{btCurrencyPage.pbScaleCode}">
                    </td>
    				<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
                    <td>
						<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="$!{btCurrencyPage.validSign}" data-name="validSign"></div>
    				</td>
				</tr>
				<tr>
					<td class="textRight" width="20%">#springMessage('table.btCurrency.nonworkDayRule')</td>
					<td colspan="3">
						<div class="bt-biz-dict" data-type="select" data-group="btCurrency.nonWorkDayRule" data-name="nonworkDayRule" data-required = "true" data-defaultvalue="$!{btCurrencyPage.nonworkDayRule}"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight" width="20%">#springMessage('table.btCurrency.nonworkDay')</td>
					<td colspan="3">
						<div class="bt-biz-dict" data-type="checkbox" data-group="btCurrency.nonWorkDay" data-name="nonworkDay" data-required = "true" data-defaultvalue="$!{btCurrencyPage.nonworkDay}"></div>
					</td>
				</tr>
				<tr>
				<td colspan="4" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
	<script src="${basePath}/static/modules/basic/business/btCurrency.edit.js?_btv=${resourceVersion}"></script>
</body>
</html>

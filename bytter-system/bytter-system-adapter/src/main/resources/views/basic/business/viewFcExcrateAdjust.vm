<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input type="hidden" id="id" name="id" value="$!{fcExcrateAdjustPage.id}">
    <input type="hidden" id="decimalPlaces"  value="$!{fcExcrateAdjustPage.decimalPlaces}">
    <input type="hidden" id="createBy" name="createBy" value="$!{fcExcrateAdjustPage.createBy}">
    <input type="hidden" id="createBy" name="createBy" value="$!{fcExcrateAdjustPage.createDate}">
    <input type="hidden" id="updateBy" name="updateBy" value="$!{fcExcrateAdjustPage.createBy}">
    <input type="hidden" id="updateDate" name="updateDate" value="$!{fcExcrateAdjustPage.updateDate}">
    <input type="hidden" id="oldExchangeRate" name="oldExchangeRate" value="$!{fcExcrateAdjustPage.oldExchangeRate}">
    <input type="hidden" id="referCurId" name="referCurId" value="$!{fcExcrateAdjustPage.referCurId}">
    <input type="hidden" id="newExchangeRate" name="newExchangeRate" value="$!{fcExcrateAdjustPage.newExchangeRate}">
    <input type="hidden" id="oldExchangeRate" name="oldExchangeRate" value="$!{fcExcrateAdjustPage.oldExchangeRate}">
    <input type="hidden" id="foreignExchangePurchase" name="foreignExchangePurchase"
           value="$!{fcExcrateAdjustPage.foreignExchangePurchase}">
    <input type="hidden" id="foreignExchangeSell" name="foreignExchangeSell"
           value="$!{fcExcrateAdjustPage.foreignExchangeSell}">
    <input type="hidden" id="foreignExchangeMiddle" name="foreignExchangeMiddle"
           value="$!{fcExcrateAdjustPage.foreignExchangeMiddle}">
    <table class="layui-table">
        <tbody>
        <tr>
        ##汇率类型
            <td class="textRight" width="30%">#springMessage('table.btRateType.typeName')</td>
            <td>
                $!{fcExcrateAdjustPage.typeName}
            </td>
        </tr>
        <tr>
        ##币别
            <td class="textRight" width="30%">#springMessage('table.fcExcrateAdjust.cur')</td>
            <td>
                $!{fcExcrateAdjustPage.curName}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcExcrateAdjust.referCurId')</td>
            <td>
                $!{fcExcrateAdjustPage.referCurName}
            </td>
        </tr>
        <tr>
        ##执行日期
            <td class="textRight">#springMessage('table.fcExcrateAdjust.preTime')</td>
            <td>
                $!date.format('yyyy-MM-dd HH:mm:ss',$!{fcExcrateAdjustPage.preTime})
            </td>
        </tr>
        <tr>
        ##原汇率
            <td class="textRight">#springMessage('table.fcExcrateAdjust.oldExchangeRate')</td>
            <td>
                <label id="oldExchangeRateText"></label>
            </td>
        </tr>
        <tr>
        ##当前汇率
            <td class="textRight">#springMessage('table.fcExcrateAdjust.newExchangeRate')</td>
            <td>
                <label id="newExchangeRateText"></label>
            </td>
        </tr>
        <tr>
        ##汇买价
            <td class="textRight">#springMessage('table.fcExcrateAdjust.foreignExchangePurchase')</td>
            <td>
                <label id="foreignExchangePurchaseText"></label>
            </td>
        </tr>
        <tr>
        ##汇卖价
            <td class="textRight">#springMessage('table.fcExcrateAdjust.foreignExchangeSell')</td>
            <td>
                <label id="foreignExchangeSellText"></label>
            </td>
        </tr>
        <tr>
        ##中间价
            <td class="textRight">#springMessage('table.fcExcrateAdjust.foreignExchangeMiddle')</td>
            <td>
                <label id="foreignExchangeMiddleText"></label>
            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight">#springMessage('table.fcExcrateAdjust.rmk')</td>
            <td>
                $!{fcExcrateAdjustPage.rmk}
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['moneyType'], function () {
        var moneyFun = bt.moneyType.getFun();
        var decimalPlaces = $("#decimalPlaces").val();
        var opt = {
            separator: ",",
            decimal: decimalPlaces
        }
        if ($("#oldExchangeRate").val()) {
            $("#oldExchangeRateText").text(moneyFun.format($("#oldExchangeRate").val(), opt));
        }
        $("#newExchangeRateText").text(moneyFun.format($("#newExchangeRate").val(), opt));

        if ($("#foreignExchangePurchase").val()) {
            $("#foreignExchangePurchaseText").text(moneyFun.format($("#foreignExchangePurchase").val(), opt));
        }
        if ($("#foreignExchangeSell").val()) {
            $("#foreignExchangeSellText").text(moneyFun.format($("#foreignExchangeSell").val(), opt));
        }
        if ($("#foreignExchangeMiddle").val()) {
            $("#foreignExchangeMiddleText").text(moneyFun.format($("#foreignExchangeMiddle").val(), opt));
        }
    })
</script>
</body>
</html>
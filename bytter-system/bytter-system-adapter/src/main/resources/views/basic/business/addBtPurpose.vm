<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{btPurposePage.id}">
    <input id="createBy" name="createBy" type="hidden" value="$!{btPurposePage.createBy}">
    <input id="createDate" name="createDate" type="hidden" value="$!{btPurposePage.createDate}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{btPurposePage.updateBy}">
    <input id="updateDate" name="updateDate" type="hidden" value="$!{btPurposePage.updateDate}">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="30%">#springMessage('table.btPurpose.sysBusType')</td>
            <td>
                <div class="bt-biz-dict" data-type="checkbox" data-group="btPurpose.sysBusType" data-required="true" data-name="sysBusType"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btPurpose.purpose')</td>
            <td>
                <input type="text" id="purpose" name="purpose" lay-verify="required|maxlength|strlength" data-maxlength="50"
 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btPurpose.purpose')">
             </td>
        </tr>
        ##币别
        <tr>
            <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name="curId" data-valueField="id" data-textField="curName" data-method="get"></div>
                </div>
            </td>
        </tr>
        ##国家地区
        <tr>
            <td class="textRight">#springMessage('table.foreign.countryOrArea')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/syscountrycust/listSysCountryCust"
                         data-name="countryId" data-valueField="id" data-textField="nameZh" data-method="get"></div>
                </div>
            </td>
        </tr>
        ##银行类别
        <tr>
            <td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json"
                         data-name="bankTypeId" data-valueField="id" data-textField="typeName" data-method="get"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btPurpose.corpId')</td>
            <td >
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-name="corpId" data-biz-type="corp" data-type="selectTree" data-tree-type="check"
                         data-checkkboxtype='{"Y":"s","N":"s"}' data-scope="all" data-required="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/basic/business/btPurpose.add.js?_btv=${resourceVersion}"></script>

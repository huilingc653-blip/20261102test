<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{btCurrencyPairPage.createBy}">
##		<input id="createDate" name="createDate" type="hidden" value="$!{btCurrencyPairPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{btCurrencyPairPage.updateBy}">
##		<input id="updateDate" name="updateDate" type="hidden" value="$!{btCurrencyPairPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{btCurrencyPairPage.id}">
		<table class="layui-table">
			<tbody>
				<tr>
    				<td class="textRight">#springMessage('table.btCurrencyPair.curId1')</td>
                    <td width="40%">
						<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="curId1" data-biz-name ="curId1" data-value="$!{btCurrencyPairPage.curId1}"
							 data-valueField="id" data-textField="englishCode" data-required = "true"  data-callback="bt.cur1"></div>
    				</td>
    				<td class="textRight">#springMessage('table.btCurrencyPair.curId2')</td>
                    <td width="40%">
						<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="curId2" data-biz-name ="curId2"  data-value="$!{btCurrencyPairPage.curId2}"
							 data-valueField="id" data-textField="englishCode" data-required = "true"  data-callback="bt.cur2"  data-initCallback="bt.cur3"></div>
    				</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.btCurrencyPair.baseCurId')</td>
                    <td>
						<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="baseCurId" data-biz-name ="baseCurId" data-value="$!{btCurrencyPairPage.baseCurId}"
							 data-valueField="id" data-extraData="false" data-textField="englishCode" data-required = "true"  data-displayData="$!{btCurrencyPairPage.curId1},$!{btCurrencyPairPage.curId2}"></div>
    				</td>
					<td class="textRight">#springMessage('table.btCurrencyPair.exchangeRate')</td>
					<td>
						<input type="text" id="exchangeRate" name="exchangeRate" data-biz-name="exchangeRate" data-name="exchangeRate" data-decimal="4" lay-verify="required" data-max="99999999.9999"
							   autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.btCurrencyPair.exchangeRate')" value="$!{btCurrencyPairPage.exchangeRate}">
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
					<td colspan="3">
						<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-name="validSign" data-defaultvalue="$!{btCurrencyPairPage.validSign}"></div>
					</td>
				</tr>
				<tr>
					<td colspan="4" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
						<button type="reset" class="layui-btn layui-btn-primary" data-callback="resetCallBack">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/basic/business/btCurrencyPair.edit.js?_btv=${resourceVersion}"></script>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input name="id" type="hidden" value="$!{btSwiftInfoVO.id}">
    <table class="layui-table">
        <tbody>
        ##	swift code
        <tr>
            <td class="textRight" width="30%">#springMessage('table.btswiftinfo.swiftCode')</td>
            <td>
                <input type="text" id="swiftCode" name="swiftCode" lay-verify="required|swiftCode"
                       data-maxlength="30"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.btswiftinfo.swiftCode')" value="$!{btSwiftInfoVO.swiftCode}">
            </td>
        </tr>
            ##	本地清算号
        <tr>
            <td class="textRight" width="30%">#springMessage('table.btswiftinfo.localClearNo')</td>
            <td>
                <input type="text" id="localClearNo" name="localClearNo" lay-verify="strlength"
                       data-maxlength="30"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.btswiftinfo.localClearNo')" value="$!{btSwiftInfoVO.localClearNo}">
            </td>
        </tr>

        ##	机构名称
        <tr>
            <td class="textRight">#springMessage('table.btswiftinfo.bankName')</td>
            <td>
                <input type="text" id="bankName" name="bankName" lay-verify="required|bankName|strlength"
                       data-maxlength="200"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.btswiftinfo.bankName')" value="$!{btSwiftInfoVO.bankName}">
            </td>
        </tr>

        <tr>
            <td class="textRight">#springMessage('table.btswiftinfo.bankType')</td>
            <td>
                <div class="layui-input-inline">
                    <div data-name="bankTypeId" class="bt-biz-selectType"
                         data-url="${basePath}/basic/business/btbanktype/json"
                         data-valueField="id"
                         data-biz-name="bankTypeId"
                         data-textField="typeName"
                         data-required="true"
                         data-search="true"
                         data-defaultvalue="$!{btSwiftInfoVO.bankTypeId}"></div>
                </div>
            </td>
        </tr>

        ##	开户银行代码类型
        #*<tr>
            <td class="textRight">#springMessage('table.btswiftinfo.clsFlag')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="clsFlag" data-defaultvalue="$!{btSwiftInfoVO.clsFlag}"
                     data-name="clsFlag" data-biz-name="clsFlag"></div>
        </tr>*#

        ##	所在国
        <tr>
            <td class="textRight">#springMessage('table.btswiftinfo.countryCode')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="hidden" name="countryCode" value="$!{btSwiftInfoVO.countryCode}">
                    <input type="text" name="nameZh" id="nameZh" class="layui-input text" lay-verify="required|tableData"
                           value="$!{btSwiftInfoVO.nameZh}" placeholder="#springMessage('table.btswiftinfo.countryCode')" >
                    <table id="countryCode" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.tbCreditPeriod.code')</th>
                            <th>#springMessage('table.btswiftinfo.namezh')</th>
                            <th>#springMessage('table.btswiftinfo.nameen')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
        </tr>

        ##	所在城市
        <tr>
            <td class="textRight">#springMessage('table.btswiftinfo.cityName')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="hidden" name="cityName" value="$!{btSwiftInfoVO.cityName}">
                    <input type="text" name="cityNameZh" id="cityNameZh" data-biz-name="cityNameZh" class="layui-input text" lay-verify="required|tableData"
                           value="$!{btSwiftInfoVO.cityNameZh}" placeholder="#springMessage('table.btswiftinfo.cityName')" >
                    <table id="cityNameTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.tbCreditPeriod.code')</th>
                            <th>#springMessage('table.btswiftinfo.namezh')</th>
                            <th>#springMessage('table.btswiftinfo.nameen')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
        </tr>

        ##	地址
        <tr>
            <td class="textRight">#springMessage('table.btswiftinfo.bankAdd')</td>
            <td>
                <input lay-verify="strlength" type="text" id="bankAdd" name="bankAdd" data-maxlength="300" maxlength="300"
 autocomplete="off" class="layui-input" placeholder="#springMessage('table.btswiftinfo.bankAdd')"
 value="$!{btSwiftInfoVO.bankAdd}">
            </td>
        </tr>

        ##  查询重置
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/basic/business/btSwiftInfo.add.js?_btv=${resourceVersion}"></script>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{btSwiftInfo.id}">
    <table class="layui-table">
        <tbody>
        <tr>
        ##	swift code
            <td class="textRight" width="30%">#springMessage('table.btswiftinfo.swiftCode')</td>
            <td>
                <input type="text" id="swiftCode" name="swiftCode" lay-verify="required|strlength|number"
                       data-maxlength="30"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.btswiftinfo.swiftCode')">
            </td>
        </tr>
        <tr>
        ##	机构名称
            <td class="textRight">#springMessage('table.btswiftinfo.bankName')</td>
            <td>
                <input type="text" id="bankName" name="bankName" lay-verify="required"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.btswiftinfo.bankName')">
            </td>
        </tr>
        <tr>
        ##	所在国
            <td class="textRight">#springMessage('table.btswiftinfo.countryCode')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="countryCode" class="layui-input" lay-verify="required">
                    <table id="countryCode" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.tbCreditPeriod.code')</th>
                            <th>#springMessage('table.btswiftinfo.namezh')</th>
                            <th>#springMessage('table.btswiftinfo.nameen')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
        </tr>
        <tr>
        ##	所在城市
            <td class="textRight">#springMessage('table.btswiftinfo.cityName')</td>
            <td>
                <input type="text" id="cityName" name="cityName" lay-verify="required"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.btswiftinfo.cityName')">
            </td>
        </tr>
        <tr>
        ##	地址
            <td class="textRight">#springMessage('table.btswiftinfo.bankAdd')</td>
            <td>
                <input type="text" id="bankAdd" name="bankAdd"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.btswiftinfo.bankAdd')">
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/basic/business/btInputBankInfo.edit.js?_btv=${resourceVersion}"></script>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
	<style>
		.time-zone .layui-form-selected dl {
			width: 300px;
			text-align: left;
		}
	</style>
</head>
<body>
	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{sysCountryCustPage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{sysCountryCustPage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{sysCountryCustPage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{sysCountryCustPage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{sysCountryCustPage.id}">
		<input id="countryLevel" name="countryLevel" type="hidden" value="0">
		<input id="sysId" name="sysId" type="hidden">
		<table class="layui-table">
##			<thead>
##			<tr>
##				<td colspan="4">#springMessage('table.sys.basic.country.info')</td>
##			</tr>
##			</thead>
			<tbody>
				<tr>
    				<td class="textRight">#springMessage('table.btswiftinfo.namezh')</td>
                    <td width="40%">
						<div class="layui-input-inline">
							<input type="text" id="nameZh" name="nameZh" lay-verify="required|tableData" data-biz-name="nameZh"
								   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.btswiftinfo.namezh')">
							<table id="countryTable" class="hide">
								<thead>
								<tr>
									<th>#springMessage('table.tbCreditPeriod.code')</th>
									<th>#springMessage('table.btswiftinfo.namezh')</th>
									<th>#springMessage('table.btswiftinfo.nameen')</th>
								</tr>
								</thead>
							</table>
						</div>
    				</td>
    				<td class="textRight">#springMessage('table.btswiftinfo.nameen')</td>
                    <td width="40%">
						<input type="text" id="nameEn" name="nameEn" lay-verify="required" readonly="readonly"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.btswiftinfo.nameen')">
    				</td>
				</tr>
				<tr>
    				<td class="textRight">#springMessage('table.bisAccDtl.curName')</td>
                    <td>
						<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name ="curId" data-biz-name ="curId"
							 data-valueField="id" data-textField="englishCode" data-required = "true"></div>
    				</td>
					<td class="textRight">#springMessage('table.sysCountryCust.enCode')</td>
					<td>
						<input type="text" id="enCode" name="enCode" lay-verify="required" readonly="readonly"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.sysCountryCust.enCode')">
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.sysCountryCust.code')</td>
					<td>
						<input type="text" id="code" name="code" lay-verify="required" readonly="readonly"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.sysCountryCust.code')">
					</td>
					<td class="textRight">#springMessage('table.sysTimeZone.timeZone')</td>
					<td >
						<div class="bt-biz-selectType" data-url="${basePath}/basic/business/syscountrycust/getSysTimeZone" data-name ="timeZoneId" data-biz-name ="timeZoneId"
							 data-valueField="id" data-textField="timeZone" data-required = "true" data-search="true"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
					<td colspan="3">
						<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="1" data-name="validSign"></div>
					</td>
				</tr>
				<tr>
					<td colspan="4" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
						<button type="button" class="layui-btn layui-btn-primary" onclick="countryCustReset()">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>

		<table id="dataTableArea" style="width:100%;" >
			<thead>
##			<tr>
##				<th colspan="5">
##					<span style="float: left">#springMessage("table.sys.basic.area.info")</span>
##				</th>
##			</tr>
			<tr>
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btswiftinfo.namezh')</th>
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.btswiftinfo.nameen')</th>
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.sysCountryCust.code')</th>
				<th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.sysTimeZone.timeZone')</th>
				<th>#springMessage('common.table.thead.operation')</th>
			</tr>
			</thead>
			<tbody class="ignore-required-icon layui-form">
			<tr id="tr0" row="0">
				<td align="center">
					<div class="layui-input-inline">
						<input type="text" id="nameZh0" name="nameZhRow" autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="100">
					</div>
				</td>
				<td align="center">
					<div class="layui-input-inline">
						<input type="text" id="nameEn0" name="nameEnRow" autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="200">
					</div>
				</td>
				<td align="center">
					<div class="layui-input-inline">
						<input type="text" id="code0" name="codeRow" autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="30">
					</div>
				</td>
				<td align="center" class="time-zone">
					<div class="layui-input-inline">
						<div class="bt-biz-selectType" data-url="${basePath}/basic/business/syscountrycust/getSysTimeZone" data-biz-name ="timeZoneId0" data-name ="timeZoneIdRow" data-valueField="id" data-textField="timeZone" data-required = "true"></div>
					</div>
				</td>
				<td></td>
			</tr>
			<tr id="sumTr" style="display: none">
				<td colspan="5"></td>
			</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/basic/business/sysCountryCust.add.js?_btv=${resourceVersion}"></script>

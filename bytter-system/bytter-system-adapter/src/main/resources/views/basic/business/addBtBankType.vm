<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{btBankTypePage.id}">
    <input id="fileId" name="fileId" type="hidden">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="30%">#springMessage("btBankType.bankType")</td>
            <td>
                <input type="text" id="bankType" name="bankType" lay-verify="required|numberOrletter|strlength"
 data-maxlength="4" data-minlength="4" 
 autocomplete="off" class="layui-input" placeholder="#springMessage('btBankType.bankType')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("btBankType.typeName")</td>
            <td>
                <input type="text" id="typeName" name="typeName" lay-verify="required|strlength" data-maxlength="60"
 
 autocomplete="off" class="layui-input" placeholder="#springMessage('btBankType.typeName')">
            </td>
        </tr>
        ##是否为第三方平台
        <tr>
            <td class="textRight">是否为第三方平台</td>
            <td>
                <div class="bt-biz-dict" data-group="sf_yn" data-name="isThirdParty" data-callback="bt.isThirdParty" data-type="radio"
                     data-defaultvalue="0" data-required="true"></div>
            </td>
        </tr>
            ##是否境内银行
        <tr>
            <td class="textRight">#springMessage("btBankType.isDomesticBank")</td>
            <td>
                <div class="bt-biz-dict" data-group="sf_yn" data-name="isDomesticBank" data-callback="bt.isDomesticBank" data-type="radio"
                     data-defaultvalue="1" data-required="true"></div>
            </td>
        </tr>
        <tr id="bankPrefixShow">
            <td class="textRight">#springMessage("btBankType.bankPrefix")</td>
            <td>
                <input type="text" id="bankPrefix" name="bankPrefix" lay-verify="required|numberOrletter|strlength"
 data-maxlength="3" data-minlength="3" 
 autocomplete="off" class="layui-input" placeholder="#springMessage('btBankType.bankPrefix')">
            </td>
        </tr>
        ## 开户行名称前缀
        <tr id="bankNamePrefixShow">
            <td class="textRight">#springMessage("btBankType.bankNamePrefix")</td>
            <td>
                <div class="layui-inline">
                    <input type="text" id="bankNamePrefix" name="bankNamePrefix" lay-verify="bankPrefix"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('btBankType.bankNamePrefix')">
                </div>
                #springMessage('btBankType.bankNamePrefix.tip')
            </td>
        </tr>
        ##银行种类
        <tr>
            <td class="textRight">#springMessage("btBankType.bankKind")</td>
            <td>
                <div class="bt-biz-dict" data-group="sys.bankType" data-name="bankKind" data-type="select" ></div>
            </td>
        </tr>
            ##网银证书到期日
        <tr>
            <td class="textRight">#springMessage('btBankType.netbankCFCADate')</td>
            <td>
                <input type="text" id="netbankCFCADate" name="netbankCFCADate" class="layui-input" autocomplete="off">
            </td>
        </tr>
        ##汇款方式
        <tr>
            <td class="textRight">#springMessage('table.fexForeignReq.remitMethod')</td>
            <td>
                <div class="bt-biz-dict" data-group="fexForeignReq.remitMethod" data-name="remitMethod" data-type="mulselect" data-filterData="0,1"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("btBankType.icon")</td>
            <td id="updiv" colspan="3">
                <img id="imger"/>
                <input type="file" lay-ext="png" name="file" class="layui-upload-file">
                <span style="color: red;">#springMessage('btBankType.icon.img.message')</span>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("btBankType.gradient")</td>
            <td>
                <input type="text" id="gradient" name="gradient" class="layui-input" autocomplete="off">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("btBankType.rmk")</td>
            <td>
                <textarea placeholder="#springMessage('btBankType.rmk')" class="layui-textarea" lay-verify="strlength"
                          data-maxlength="200" id="rmk" name="rmk"></textarea>
            </td>
        </tr>
        ##授信合同是否必须
        <tr>
            <td class="textRight">#springMessage("btBankType.creditContract")</td>
            <td>
                <div class="bt-biz-dict" data-group="sf_yn" data-name="creditContractRequired" data-type="radio"
                     data-defaultvalue="1"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("btBankType.validSign")</td>
            <td>
                <div class="bt-biz-dict" data-group="sf_yn" data-name="validSign" data-type="radio"
                     data-defaultvalue="1"></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.whether.connect.bank')</td>
            <td>
                <div class="bt-biz-dict" data-group="sf_yn" data-name="whetherConnectBank" data-type="radio"
                     data-defaultvalue="0"></div>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form', 'layedit', 'dicts', 'laydate','upload'], function () {
        var $ = bt.jquery, form = bt.form()
                , laydate = bt.laydate;

        laydate.render({
            elem: '#netbankCFCADate',//选择器
            type: 'date',//日期类型
            min: "1970-1-1",//默认最小值
        });

        var upload = layui.upload;
        layui.upload({
            url: basePath+'/basic/business/btbanktype/upload/'
            ,success: function(res, input){
                if(typeof res.success == 'boolean' && !res.success){
                    layer.alert(bt.lang(res.msg));
                }else{
                    $("#imger").attr("src", basePath+'/download/attachment?id='+res[0].id);
                    $("#fileId").attr("value",res[0].id);
                }
            }
        });

        //监听提交
        form.on('submit(submit)', function (data) {
            var action = "/basic/business/btbanktype/save";
            $.post(basePath + action, data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                if(result.success){
                    if (bt.navtab) {
                        bt.navtab.refreshParent();
                        bt.navtab.refreshCurrent()
                    } else {
                        parent.layer ? parent.layer.closeAll() : layer.closeAll();
                    }
                }
            }, 'JSON');
            return false;
        });

        //是否境外银行参数控制
        bt.isDomesticBank = function (data) {
            if (data.value == 0) {
                $("#bankPrefixShow").hide();
                $("#bankPrefix").attr('lay-verify','');
                $("#bankNamePrefixShow").hide();
                $("#bankNamePrefixShow").attr('lay-verify','');
            } else {
                $("#bankPrefixShow").show();
                $("#bankPrefix").attr('lay-verify','required|numberOrletter|strlength');
                $("#bankNamePrefixShow").show();
                $("#bankNamePrefixShow").attr('lay-verify','bankPrefix');
            }
        };

        bt.isThirdParty = function (data) {
            if (data.value == 1) {
                $("#bankPrefix").attr('lay-verify','');
            }else{
                $("#bankPrefix").attr('lay-verify','required|numberOrletter|strlength');
            }
            form.render();
            form.renderIcon();
        }

        bt.dicts.init();

        form.verify({
            bankPrefix: function (value, item) {
                var bankPrefix = $("#bankPrefix").val();
                if (bankPrefix == "313" || bankPrefix == "402" || bankPrefix == "314") {
                    if (!value) {
                        return bt.lang("basic.business.message.banknameprefix.null");
                    }
                }
            }
        });
    });
</script>
<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{fcInstrateAdjustPage.id}">
    <input id="createTime" name="createTime" type="hidden" value="$!{fcInstrateAdjustPage.createTime}">
    <input id="createBy" name="createBy" type="hidden" value="$!{fcInstrateAdjustPage.createBy}">
    <input id="updateTime" name="updateTime" type="hidden" value="$!{fcInstrateAdjustPage.updateTime}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{fcInstrateAdjustPage.updateBy}">
    <input id="types" name="types" type="hidden" value="">
    <input id="isView" name="isView" type="hidden" value="$!{isView}">
    <input id="poolSign" name="poolSign" type="hidden" value="$!{poolSign}">
    <table class="layui-table">
        <tbody>
        <tr>
            #if($!{poolSign} == "1")
            ##资金池
                <td class="textRight">#springMessage('nis.pool.fcCorpPool.pool')</td>
                <td>($!{netCode})$!{fcInstrateAdjustPage.netName}</td>
                <td class="textRight">#springMessage('nis.pool.fcCorpPool.poolsubCorp')</td>
                <td>($!{corpCode})$!{fcInstrateAdjustPage.corpName}</td>
            #else
                <td class="textRight">#springMessage('table.fcAcc.netId')</td>
                <td width="20%">&nbsp;
                    ($!{netCode})$!{fcInstrateAdjustPage.netName}
                </td>
                <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            ##开户单位ID
                <td width="20%">
                    &nbsp;
                    ($!{corpCode})$!{fcInstrateAdjustPage.corpName}
                </td>
            #end
		##科目
            <td class="textRight">#springMessage('fcAccBalanceQuery.subjectId'):</td>
            <td width="20%">
				$!{fcInstrateAdjustPage.subjectName}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.curId'):</td>
            <td>$!{fcInstrateAdjustPage.curName}</td>
		##调整类型
            <td class="textRight">#springMessage('table.fcInstrateAdjust.changtype')</td>
            <td>$dictTag.get("interestRateType","$!{fcInstrateAdjustPage.changtype}")</td>
            <td class="textRight">#springMessage('table.fcInstrateAdjust.account'):</td>
            <td>
				$!{fcInstrateAdjustPage.account}
            </td>

        </tr>
        <tr>
		##利率类型
            <td class="textRight">#springMessage('table.fcInstrateAdjust.instrtType')</td>
            <td>
                #if($!{poolSign} == "1")
                    $dictTag.get("Common.poolInstrtType","$!{fcInstrateAdjustPage.instrtType}")
                #else
                    $dictTag.get("Common.InstrtType","$!{fcInstrateAdjustPage.instrtType}")
                #end
            </td>
            <td class="textRight">#springMessage('table.fcInstrateAdjust.newInstrate')</td>
            <td>
                <input type="text" id="newInstrate" name="newInstrate"
                       autocomplete="off" class="layui-input bt-biz-rateType" value="$!{fcInstrateAdjustPage.newInstrate}" data-biz-name="newInstrate" placeholder="#springMessage('table.fcInstrateAdjust.newInstrate')" lay-verify="required">
            </td>
        ##生效日期
            <td class="textRight">#springMessage('table.fcInstrateAdjust.adjustTime'):</td>
            <td >
                <input type="text" name="adjustTime"  class="layui-input bt-biz-dateType" data-type="date" value="$!{fcInstrateAdjustPage.adjustTime}" data-biz-name="adjustTime" lay-verify="required"></div>
            </td>
        </tr>
        <tr>

        </tr>
        <tr>
            <td colspan="6" style="width: 100%">
                <table id="appTable" class="layui-table layui-form" style="width:100%;">
                    <thead>
                    <tr>
                        <td>#springMessage('table.fcAccbookDtlHis.lineNo')</td>
                        <td>#springMessage('table.fcInstrateAdjust.account')</td>
                        <td>#springMessage('table.fcAcc.accName')</td>
                        <td>#springMessage('table.fcInstrateAdjust.lastAdjustTime')</td>
                        <td>#springMessage('table.fcInstrateAdjust.oldInstrate')</td>
                        <td>#springMessage('table.fcInstrateAdjust.newInstrate')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>1</td>
                        <td> $!{fcInstrateAdjustPage.account}</td>
                        <td> $!{fcInstrateAdjustPage.accName}</td>
                        <td> $!date.format('yyyy-MM-dd',$!{fcInstrateAdjustPage.lastAdjustTime})</td>
                        <td> $rateTag.show($!{fcInstrateAdjustPage.oldInstrate})</td>
                        <td> $rateTag.show($!{fcInstrateAdjustPage.newInstrate})</td>
                    </tr>
                    </tbody>
                </table>

            </td>

        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit">#springMessage('common.button.submit')
                <button class="layui-btn" type="button" id="close">#springMessage('common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/fcInstrateAdjust.edit.js?_btv=${resourceVersion}"></script>
</html>
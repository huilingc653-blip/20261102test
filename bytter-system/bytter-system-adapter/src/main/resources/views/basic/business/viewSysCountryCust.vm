<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<table class="layui-table">
##			<thead>
##			<tr>
##				<td colspan="4">#springMessage('table.sys.basic.country.info')</td>
##			</tr>
##			</thead>
			<tbody>
			<tr>
				<td class="textRight">#springMessage('table.btswiftinfo.namezh')</td>
				<td width="40%">$!{sysCountryCustPage.nameZh}</td>
				<td class="textRight">#springMessage('table.btswiftinfo.nameen')</td>
				<td width="40%">$!{sysCountryCustPage.nameEn}</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.bisAccDtl.curName')</td>
				<td>$!{sysCountryCustPage.curName}</td>
				<td class="textRight">#springMessage('table.sysCountryCust.enCode')</td>
				<td>$!{sysCountryCustPage.enCode}</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.sysCountryCust.code')</td>
				<td>$!{sysCountryCustPage.code}</td>
				<td class="textRight">#springMessage('table.sysTimeZone.timeZone')</td>
				<td>$!{sysCountryCustPage.timeZone}</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
				<td colspan="3">$dictTag.get("valid_sign",$!{sysCountryCustPage.validSign})</td>
			</tr>
			</tbody>
		</table>

		<table class="layui-table">
			<thead>
##			<tr>
##				<th colspan="4">
##					<span style="float: left">#springMessage("table.sys.basic.area.info")</span>
##				</th>
##			</tr>
			<tr>
				<th>#springMessage('table.btswiftinfo.namezh')</th>
				<th>#springMessage('table.btswiftinfo.nameen')</th>
				<th>#springMessage('table.sysCountryCust.code')</th>
				<th>#springMessage('table.sysTimeZone.timeZone')</th>
			</tr>
			</thead>
			<tbody>
			#foreach($data in $dataList)
			<tr id="tr$!{velocityCount}" row="$!{velocityCount}">
				<td align="center">$!{data.nameZh}</td>
				<td align="center">$!{data.nameEn}</td>
				<td align="center">$!{data.code}</td>
				<td align="center">$!{data.timeZone}</td>
			</tr>
			#end
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
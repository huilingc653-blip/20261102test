<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <input type="hidden" id="id" name="id" value="$!{fcExcrateAdjustPage.id}">
        <input type="hidden" id="typeId" name="typeId" value="$!{fcExcrateAdjustPage.typeId}">
        <input type="hidden" id="createBy" name="createBy" value="$!{fcExcrateAdjustPage.createBy}">
        <input type="hidden" id="createDate" name="createDate" value="$!{fcExcrateAdjustPage.createDate}">
        <input type="hidden" id="updateBy" name="updateBy" value="$!{fcExcrateAdjustPage.createBy}">
        <input type="hidden" id="updateDate" name="updateDate" value="$!{fcExcrateAdjustPage.updateDate}">
        <input type="hidden" id="oldExchangeRate" name="oldExchangeRate" value="$!{fcExcrateAdjustPage.oldExchangeRate}">
        <input type="hidden" id="status" name="status" value="0">

        <table class="layui-table">
            <tbody>
            <tr>
                ##汇率类型
                <td class="textRight" width="30%">#springMessage('table.btRateType.typeName')</td>
                <td>
                    <div type="list" data-name="typeId" data-biz-name="typeId" class="bt-biz-selectType" data-required="true" data-defaultvalue="$!{fcExcrateAdjustPage.typeId}"
                         data-url="${basePath}/basic/business/btratetype/json" data-valueField="id" data-textField="typeName" data-callback="bt.typeId"></div>
                </td>
            </tr>
            <tr>
			##币别
                <td class="textRight" width="30%">#springMessage('table.fcExcrateAdjust.cur')</td>
                <td>
                    <div type="list" data-name="curId" data-biz-name="curId" class="bt-biz-selectType" data-required="true" data-defaultvalue="$!{fcExcrateAdjustPage.curId}"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valueField="id" data-textField="curName" data-callback="bt.cur"></div>
                    <span style="color: red;">#springMessage('table.fcExcrateAdjust.cur.message')</span>
                </td>
            </tr>
            <tr>
            ##参考币别
                <td class="textRight" width="30%">#springMessage('table.fcExcrateAdjust.referCurId')</td>
                <td>
                    <div type="list" data-name ="referCurId" data-biz-name ="referCurId" class="bt-biz-selectType"  data-required="true" data-callback="bt.referCurId"
                         data-url="${basePath}/basic/business/btcurrency/json" data-valueField="id" data-textField="curName"  data-defaultvalue="$!{fcExcrateAdjustPage.referCurId}"></div>
                </td>
            </tr>
            <tr>
			##执行日期
                <td class="textRight">#springMessage('table.fcExcrateAdjust.preTime')</td>
                <td>
                    <input type="text" name="preTime" class="layui-input bt-biz-dateType" data-type="datetime" data-callback="bt.preTime"
						   data-biz-name="preTime" lay-verify="datetime|required" value="$!{fcExcrateAdjustPage.preTime}" >
                </td>
            </tr>
            <tr>
            ##原汇率
                <td class="textRight" width="30%">#springMessage('table.fcExcrateAdjust.oldExchangeRate')</td>
                <td>
                    <input type="text" readonly="true" data-name="oldExchangeRateChange" autocomplete="off" data-decimal="4" data-biz-name="oldExchangeRateChange"
                           class="layui-input bt-biz-moneyType"  value="$!{fcExcrateAdjustPage.oldExchangeRate}">
                </td>
            </tr>
            <tr>
			##当前汇率
                <td class="textRight">#springMessage('table.fcExcrateAdjust.newExchangeRate')</td>
                <td>
                    <input type="text" data-biz-name="newExchangeRate" data-name="newExchangeRate" data-decimal="4" data-max="99999999.9999"
                           lay-verify="required"  autocomplete="off" class="layui-input bt-biz-moneyType"  value="$!{fcExcrateAdjustPage.newExchangeRate}">
                </td>
            </tr>
            <tr>
            ##汇买价
                <td class="textRight">#springMessage('table.fcExcrateAdjust.foreignExchangePurchase')</td>
                <td>
                    <input type="text" data-biz-name="foreignExchangePurchase" data-name="foreignExchangePurchase" data-decimal="4" data-max="99999999.9999"
                           autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{fcExcrateAdjustPage.foreignExchangePurchase}" placeholder="#springMessage('table.fcExcrateAdjust.foreignExchangePurchase')">
                </td>
            </tr>
            <tr>
            ##汇卖价
                <td class="textRight">#springMessage('table.fcExcrateAdjust.foreignExchangeSell')</td>
                <td>
                    <input type="text" data-biz-name="foreignExchangeSell" data-name="foreignExchangeSell" data-decimal="4" data-max="99999999.9999"
                           autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{fcExcrateAdjustPage.foreignExchangeSell}" placeholder="#springMessage('table.fcExcrateAdjust.foreignExchangeSell')">
                </td>
            </tr>
            <tr>
            ##中间价
                <td class="textRight">#springMessage('table.fcExcrateAdjust.foreignExchangeMiddle')</td>
                <td>
                    <input type="text" data-biz-name="foreignExchangeMiddle" data-name="foreignExchangeMiddle" data-decimal="4" data-max="99999999.9999"
                           autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{fcExcrateAdjustPage.foreignExchangeMiddle}" placeholder="#springMessage('table.fcExcrateAdjust.foreignExchangeMiddle')">
                </td>
            </tr>
            <tr>
			##备注
                <td class="textRight">#springMessage('table.fcExcrateAdjust.rmk')</td>
                <td>
                    <textarea type="text" id="rmk" name="rmk" autocomplete="off" style="width: 300px;" lay-verify="strlength" data-maxlength="255"
							  class="layui-textarea" placeholder="#springMessage('table.fcExcrateAdjust.rmk')">$!{fcExcrateAdjustPage.rmk}</textarea>
                </td>
            </tr>
            <tr>
                <td colspan="2" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
                    <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/fcExcrateAdjust.edit.js?_btv=${resourceVersion}"></script>
</html>

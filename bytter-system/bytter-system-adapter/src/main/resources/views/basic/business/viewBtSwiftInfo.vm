<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <table class="layui-table">
        <tbody>
        ##	swift code
        <tr>
            <td width="20%" class="textRight">#springMessage('table.btswiftinfo.swiftCode')</td>
            <td width="40%">
                $!{btSwiftInfoVO.swiftCode}
            </td>
        </tr>
        ##	本地清算号
        <tr>
            <td class="textRight" width="20%">#springMessage('table.btswiftinfo.localClearNo')</td>
            <td width="40%">$!{btSwiftInfoVO.localClearNo}</td>
        </tr>
        ##	机构名称
        <tr>
            <td width="20%" class="textRight">#springMessage('table.btswiftinfo.bankName')</td>
            <td width="40%">
                $!{btSwiftInfoVO.bankName}
            </td>
        </tr>
            ##	开户银行代码类型
        #*<tr>
            <td width="20%" class="textRight">#springMessage('table.btswiftinfo.clsFlag')</td>
            <td width="40%">
                $dictTag.get("clsFlag",$!{btSwiftInfoVO.clsFlag})
            </td>
        </tr>*#
        <tr>
            <td width="20%" class="textRight">#springMessage('table.btswiftinfo.bankType')</td>
            <td width="40%">
                $!{btSwiftInfoVO.bankTypeName}
            </td>
        </tr>
        ##	所在国
        <tr>
            <td width="20%" class="textRight">#springMessage('table.btswiftinfo.countryCode')</td>
            <td width="40%">
                <span id="countryName"></span>
                    $!{btSwiftInfoVO.nameZh}
            </td>
        </tr>
        ##	所在城市
        <tr>
            <td width="20%" class="textRight">#springMessage('table.btswiftinfo.cityName')</td>
            <td width="40%">
                $!{btSwiftInfoVO.cityNameZh}
            </td>
        </tr>
        ##	地址
        <tr>
            <td width="20%" class="textRight">#springMessage('table.btswiftinfo.bankAdd')</td>
            <td width="40%">
                $!{btSwiftInfoVO.bankAdd}
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

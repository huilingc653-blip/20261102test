<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
        <input id="id" name="id" type="hidden" value="$!{btPurposePage.id}">
        <input id="createBy" name="createBy" type="hidden" value="$!{btPurposePage.createBy}">
        <input id="createDate" name="createDate" type="hidden" value="$!{btPurposePage.createDate}">
        <input id="updateBy" name="updateBy" type="hidden" value="$!{btPurposePage.updateBy}">
        <input id="updateDate" name="updateDate" type="hidden" value="$!{btPurposePage.updateDate}">
        <input id="sysBusType" name="sysBusType" type="hidden" value="$!{btPurposePage.sysBusType}">
        <input id="corpId" name="corpId" type="hidden" value="$!{btPurposePage.corpId}">
        <table class="layui-table">
			<tbody>
				<tr>  
    				<td class="textRight" width="20%">#springMessage('table.btPurpose.sysBusType')</td>
                    <td>
                        <label id="sysBusTypeText" ></label>
    				</td>
                </tr>
                <tr>
    				<td class="textRight" width="20%">#springMessage('table.btPurpose.purpose')</td>
                    <td>
						$!{btPurposePage.purpose}
    				</td>
				</tr>
                    ##币别
                <tr>
                    <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
                    <td>
                        <div style="white-space: normal; word-break: break-all;">$!{btPurposePage.curName}</div>
                    </td>
                </tr>
                    ##国家地区
                <tr>
                    <td class="textRight">#springMessage('table.foreign.countryOrArea')</td>
                    <td>
                        <div style="white-space: normal; word-break: break-all;">$!{btPurposePage.countryName}</div>
                    </td>
                </tr>
                    ##银行类别
                <tr>
                    <td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
                    <td>
                        <div style="white-space: normal; word-break: break-all;">$!{btPurposePage.bankTypeName}</div>
                    </td>
                </tr>
				<tr>
    				<td class="textRight">#springMessage('table.btPurpose.corpId')</td>
                    <td colspan="3">
                        <table id="corpTable"></table>
    				</td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
    <script>
        bt.use(['form','treeGrid'], function(){
            var $ = bt.jquery,form = bt.form();
            
            // 分割用途所属类别组装输出
           var sysBusTypes = $("#sysBusType").val().split(","); 
           var sysBusType; 
           $.each(sysBusTypes, function(i, busType){        
               if(null == sysBusType ){
                   sysBusType = bt.dict("btPurpose.sysBusType", busType);   
                }else{
                    sysBusType += "," + bt.dict("btPurpose.sysBusType", busType);   
                }
           });
           $("#sysBusTypeText").html(sysBusType);


            var treeGrid = bt.treeGrid.init({
                elem:"#corpTable",
                url:basePath+"/basic/business/btpurpose/corpId.json/"+$("#id").val(),
                ExpandColumn:"name",
                expandable:true,
                colModel:[
                    { name: "name",label:bt.lang("table.sysCorp.name"),formatter:function(cellvalue, options, rowObject){
                        return "("+rowObject.corpCode+")"+rowObject.corpName;
                    }},
                ],
                loadComplete:function () {
                    $("#jqgh_corpTable_name").hide();
                }
            });
        });
    </script>
</body>
</html>
    

<script>
    bt.use(['form', 'datatable', 'dateType','dicts'], function () {
        $ = bt.jquery, form = bt.form();
        bt.dateType.init();
        bt.dicts.init();
        //生成列表
        var datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            colReorder: true,
            checkbox: true,
            order: [[1, 'asc']],
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath + "/basic/business/btbanktype/datatable"
            },
            buttons: [
                // {
                //     text: bt.lang('common.button.add'),
                //     action: function (e, dt, node, config) {
                //         add();
                //     }
                // },
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ]
            , columns: [
                {data: "bankType", bSortable: true},
                {data: "typeName", bSortable: true},
                {
                    data: "bankPrefix", bSortable: true, render: function (data, type, full, meta) {
                        if (full.isDomesticBank == '1') {
                            return full.bankPrefix;
                        } else {
                            return '-';
                        }
                    }
                },
                {data: "bankKindName", bSortable: false},
                {data: "bankNamePrefix", bSortable: false},
                // {
                //     data: "isDomesticBank", bSortable: false, render: function (data, type, full, meta) {
                //         if (full.isDomesticBank == '1') {
                //             return bt.lang("nis.sc_yn.yes");
                //         } else if(full.isDomesticBank == '0'){
                //             return bt.lang("nis.sc_yn.no");
                //         }else{
                //             return '';
                //         }
                //     }
                // },
                // {data: "netbankCFCADate", bSortable: false},
                // {data: "remitMethodName"},
                {data: "rmk", bSortable: false},
                {data: "validSignName", bSortable: false, className: 'center'},
                // {
                //     data: "whetherConnectBank", bSortable: false, render: function (data, type, full, meta) {
                //         if (full.whetherConnectBank == '1') {
                //             return bt.lang("nis.sc_yn.yes");
                //         } else if(full.whetherConnectBank == '0'){
                //             return bt.lang("nis.sc_yn.no");
                //         }else{
                //             return '';
                //         }
                //     }
                // },
                {
                    data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
                        var html = '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a>'
                    // <a class="" href="#" data-row="' + meta.row + '" onclick="update(this)">' + bt.lang("common.button.edit") + '</a>';
                        // if (full.isSystem == "0" || full.isSystem == null) {
                        //     html += '<span class="text-explode">|</span><a class="" href="#" data-row="' + meta.row + '" onclick="del(this)">' + bt.lang("common.button.delete") + '</a>';
                        // }
                        return html;
                    }
                }
            ]
        });
    });

    function add() {
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.add.data'), basePath + "/basic/business/btbanktype/add");
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/basic/business/btbanktype/add",
            end: function () {
                bt.datatable.refreshCurrentPage();
            }
        });
    }

    function view(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/basic/business/btbanktype/view/" + data.id
        });
    }

    function update(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (data) {
            if (bt.navtab) {
                bt.navtab.addNavtab(bt.lang('common.update.data'), basePath + "/basic/business/btbanktype/update?id=" + data.id);
                return;
            }
            parent.layer.open({
                type: 2,
                area: ['850px', '530px'],
                maxmin: true,
                content: basePath + "/basic/business/btbanktype/update?id=" + data.id,
                end: function () {
                    bt.datatable.refreshCurrentPage();
                }
            });
        }
    }

    function del(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        parent.layer.confirm(bt.lang('common.message.confirm.delete'), function () {
            $.post(basePath + "/basic/business/btbanktype/delete/" + data.id, function (result) {
                bt.datatable.refreshCurrentPage();
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, 'JSON');
        });
    }
</script>

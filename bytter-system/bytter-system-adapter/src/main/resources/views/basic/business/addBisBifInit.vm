<!DOCTYPE html>
<html>
<head>
	#parse("views/common/head.vm")
</head>
<body>

<form class="layui-form" method="post">
	<input id="id" name="id" type="hidden" value="$!{bisBifInitPage.id}">
	<table class="layui-table">
		<tbody>
		<tr>
			<td class="textRight" width="30%">#springMessage('table.bisBifInit.bifCode')</td>
			<td>
				<input type="text" id="bifCode" name="bifCode" lay-verify="required|langKey|strlength" data-maxlength="4" data-minlength="4" autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBifInit.bifCode')">
			</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage('table.bisBifInit.name')</td>
			<td>
				<input type="text" id="name" name="name" lay-verify="required|strlength" data-maxlength="30"  autocomplete="off" class="layui-input" placeholder="#springMessage('table.bisBifInit.name')">
			</td>
		</tr>
			##是否境内银行
		#*<tr>
			<td class="textRight">#springMessage("btBankType.isDomesticBank")</td>
			<td>
				<div class="bt-biz-dict" data-group="sf_yn" data-name="isDomesticBank" data-type="radio"
					 data-defaultvalue="1" data-required="true" data-callback="bt.isDomesticBank"></div>
			</td>
		</tr>*#
		<tr>
			<td class="textRight">#springMessage('table.bisBifInit.bankType')</td>
			<td>
				<div class="layui-input-inline">
					<div data-name="bankTypeId" class="bt-biz-selectType"
						 data-url="${basePath}/basic/business/btbanktype/json"
						 data-valueField="id"
						 data-biz-name="bankTypeId"
						 data-textField="typeName"
						 data-required="true"
						 data-search="true"></div>
				</div>
			</td>
		</tr>
			##掉线提醒
		<tr>
			<td class="textRight">#springMessage("table.bisBifInit.disConnectionAlert")</td>
			<td>
				<div class="bt-biz-dict" data-group="sf_yn" data-name="disConnectionAlert" data-biz-name="disConnectionAlert" data-type="radio"
					 data-defaultvalue="0" data-required="true"></div>
			</td>
		</tr>
			##是否支持银行外汇牌价查询
		<tr>
			<td class="textRight">#springMessage("table.bisBifInit.isSupportBankForeign")</td>
			<td>
				<div class="bt-biz-dict" data-group="sf_yn" data-name="isSupportBankForeign" data-biz-name="isSupportBankForeign" data-type="radio"
					 data-defaultvalue="0" data-required="true"></div>
			</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage('table.bisBifInit.validSign')</td>
			<td>
				<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="validSign" data-biz-name="validSign"></div>
			</td>
		</tr>
		<tr>
			<td colspan="2" style="text-align: center;">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</td>
		</tr>
		</tbody>
	</table>
</form>
	#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/basic/business/bisBifInit.add.js?_btv=${resourceVersion}"></script>
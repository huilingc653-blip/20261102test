<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##开户行行号
            <td width="40%" class="textRight">#springMessage('table.btInputBankInfo.bankCode')</td>
            <td>
                <div class="layui-inline">
                    <input class="layui-input" id="bankCode" name="bankCode" lay-verify="required" readonly="readonly" type="text"/>
                    <div class="bt-div-search">
                        <button class="bt-biz-bankInfo" type="button" data-callback="bankinfoCallback"
                                title="#springMessage('common.button.select')">
                            <i class="layui-icon">&#xe615;</i>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            ##开户行名称
            <td width="40%" class="textRight">#springMessage('table.btInputBankInfo.bankName')</td>
            <td>
                <input type="text" id="bankName" name="bankName" readonly="readonly"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.btInputBankInfo.bankName')">
            </td>
        </tr>

        <tr>
            ##swiftCode
            <td width="40%" class="textRight">#springMessage('table.btInputBankSwift.swiftCode')</td>
            <td>
                <input type="text" id="swiftCode" name="swiftCode" lay-verify="required|strlength"
                       data-minlength="8" data-maxlength="11"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.btInputBankSwift.swiftCode')">
            </td>
        </tr>

        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/btInputBankSwift.add.js?_btv=${resourceVersion}"></script>
</html>
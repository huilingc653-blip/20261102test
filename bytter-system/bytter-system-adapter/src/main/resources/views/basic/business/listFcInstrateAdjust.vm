<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden"  name="isCheck" id="isCheck" value="0"/>
    <input type="hidden"  name="poolSign" id="poolSign" value="$!{poolSign}"/>
    <table class="layui-table">
        <tr>
            #if($!{poolSign} == "1")
            ##资金池
                <td class="textRight">#springMessage('nis.pool.fcCorpPool.pool')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-name="eqs_netId" data-biz-name="netId" data-callback="netIdCallback"
                             data-url="${basePath}/basic/business/fcinstrateadjust?getUserCorpPools"
                             data-valuefield="id" data-textfield="showName" data-search="true" data-defaultValue="$!{netId}">
                        </div>
                    </div>
                </td>
            ##科目
                <td class="textRight">#springMessage('fcAccBalanceQuery.subjectId')</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-selectType" data-name="eqs_subjectId"  data-biz-name="subjectId" data-url="${basePath}/finacial/paramconfig/FcSubjectPool/jsonSubjectData" data-valuefield="id" data-textfield="subjectName" data-search="true"  data-beforeinit="beforeInit"></div>
                    </div>
                </td>
            #else
                <td class="textRight">#springMessage('table.fcAcc.netId')</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="net"
                             data-type="selectTree"
                             data-name="eqs_netId"
                             data-callbackData="netChange"
                             data-resource="netbank:innerAccount:rate:adjust"
                             data-scope="net"></div>
                    </div>
                </td>
            ##科目
                <td class="textRight">#springMessage('fcAccBalanceQuery.subjectId')</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-selectType" data-name="eqs_subjectId"  data-biz-name="subjectId" data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSubjectDate" data-valuefield="id" data-textfield="subjectName" data-search="true"  data-beforeinit="beforeInit"></div>
                    </div>
                </td>
            #end
            <td class="textRight">#springMessage('table.fcInstrateAdjust.account')</td>
            <td>
                <input type="text" name="likes_account"
                    autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.fcInstrateAdjust.account')">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td>
                <div class="layui-inline">
                    <div type="list"  class="bt-biz-selectType"  data-name= "eqs_curId" data-url="${basePath}/basic/business/btcurrency/json" data-valueField="id" data-textField="curName" ></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.fcInstrateAdjust.instrtType')</td>
            #if($!{poolSign} == "1")
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="Common.poolInstrtType" data-defaultvalue="" data-name="eqs_instrtType" data-biz-name="eqs_instrtType"></div>
                </td>
            #else
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="Common.InstrtType" data-defaultvalue="" data-name="eqs_instrtType" data-biz-name="eqs_instrtType"></div>
                </td>
            #end

            <td class="textRight">#springMessage('table.fcInstrateAdjust.status')</td>
            <td>
                <div class="layui-inline">
                    <select lay-filter="status" name="eqi_status" >
                        <option value=" ">#springMessage('common.placeholder.select')</option>
                        #foreach($dict in $dictTag.list("fcfreeze.status"))
                            #if("-1" == $dict.code || "11" == $dict.code || "95" == $dict.code)
                                <option value="$dict.code">$dict.name</option>
                            #end
                        #end

                    </select>
                </div>
##                <div class="bt-biz-dict" data-type="select" data-group="fcfreeze.status"
##                     data-defaultvalue=""
##                     data-name="eqi_status"
##                     data-biz-name="eqi_status"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
##                <button class="layui-btn" lay-submit="" lay-filter="adjust">#springMessage('common.button.adjust')</button>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        #if($!{poolSign} == "1")
            <th>#springMessage('nis.pool.fcCorpPool.pool')</th>
        #else
            <th>#springMessage('table.fcAcc.netId')</th>
        #end
        <th>#springMessage('table.fcAcc.subjectId')</th>
        <th>#springMessage('table.fcInstrateAdjust.account')</th>
        <th>#springMessage('table.fcAcc.curId')</th>
        <th>#springMessage('table.fcInstrateAdjust.instrtType')</th>
        <th>#springMessage('table.fcInstrateAdjust.oldInstrate')</th>
        <th>#springMessage('table.fcInstrateAdjust.newInstrate')</th>
        <th>#springMessage('table.fcInstrateAdjust.adjustTime')</th>
        <th>#springMessage('table.fcInstrateAdjust.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/fcInstrateAdjust.list.js?_btv=${resourceVersion}"></script>
</html>

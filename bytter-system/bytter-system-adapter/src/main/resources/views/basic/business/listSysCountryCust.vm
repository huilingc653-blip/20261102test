<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.btswiftinfo.namezh')</td>
            <td width="20%">
                <input type="text" name="likes_nameZh"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.btswiftinfo.namezh')">
            </td>
            <td class="textRight">#springMessage('table.btswiftinfo.nameen')</td>
            <td width="20%">
                <input type="text" name="likes_nameEn"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.btswiftinfo.nameen')">
            </td>
            <td class="textRight">#springMessage('table.sysCountryCust.enCode')</td>
            <td width="20%">
                <input type="text" name="likes_enCode"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.sysCountryCust.enCode')">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btswiftinfo.namezh')</th>
        <th>#springMessage('table.btswiftinfo.nameen')</th>
        <th>#springMessage('table.bisAccDtl.curName')</th>
        <th>#springMessage('table.sysCountryCust.enCode')</th>
        <th>#springMessage('table.sysTimeZone.timeZone')</th>
        <th>#springMessage('table.btCurrency.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/sysCountryCust.list.js?_btv=${resourceVersion}"></script>
</html>

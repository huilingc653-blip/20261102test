<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
	<table class="layui-table">
			<tbody>
				<tr>##开户行行号
    				<td width="10%" class="textRight">#springMessage('table.btInputBankInfo.bankCode')</td>
					<td width="40%">
                        $!{btInputBankInfoPage.bankCode}
					</td>##开户行名称
    				<td width="10%" class="textRight">#springMessage('table.btInputBankInfo.bankName')</td>
					<td width="40%">
						$!{btInputBankInfoPage.bankName}
					</td>
				</tr>
				<tr>##所在省
    				<td class="textRight">#springMessage('table.btInputBankInfo.prov')</td>
					<td>
						$!{btInputBankInfoPage.provName}
					</td>
					##所在市
    				<td class="textRight">#springMessage('table.btInputBankInfo.city')</td>
					<td>
						$!{btInputBankInfoPage.cityName}
					</td>
				</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
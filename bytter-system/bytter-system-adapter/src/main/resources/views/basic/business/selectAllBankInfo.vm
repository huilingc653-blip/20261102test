<!DOCTYPE html>
<html lang="en" style="height: 100%;">
<head>
    #parse("views/common/head.vm")
    <style>
        .layui-tab{
            margin:0px;
        }
        body{
            padding-bottom:0;
        }
        .layui-tab-content {
            padding-top:0px;
        }
    </style>
</head>
<body>
<div class="layui-tab layui-tab-brief">
    <ul class="layui-tab-title">
        #if($!{onlyShowOutBank} == "0")
            <li class="layui-this">#springMessage("replenish.Domestic")</li>
        #end
        <li class="innerTab #if($!{onlyShowOutBank} == '1')layui-this#end">#springMessage("replenish.Overseas")</li>
    </ul>
    <div class="layui-tab-content" style="height:512px">
        #if($!{onlyShowOutBank} == "0")
                <div class="layui-tab-item layui-show" style="height:100%" data-refresh="true">
                    <iframe id="ExternalCorpPage" name="ExternalCorpPage" src="${basePath}/basic/business/btinputbankinfo/selectInnerBankInfo?id=$!{id}&joinBankType=$!{joinBankType}&bankTypeId=$!{bankTypeId}" frameborder="0" style="width: 100%; height: 100%"></iframe>
                </div>
        #end
            #if($!{onlyShowOutBank} == "1")
                <div class="layui-tab-item layui-show" style="height:100%" data-refresh="true">
            #else
                <div class="layui-tab-item " style="height:100%" data-refresh="true">
            #end
            <iframe id="CorpPage" name="CorpPage" src="${basePath}/basic/business/btswiftinfo/selectOuterBankInfo" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['element', 'form'], function(){
        var $ = bt.jquery,form = bt.form();
        var element = bt.element();
    });
</script>
</html>

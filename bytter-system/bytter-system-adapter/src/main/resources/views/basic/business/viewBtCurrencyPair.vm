<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<input id="exchangeRate" name="curExrate" type="hidden" value="$!{btCurrencyPairPage.exchangeRate}">
		<table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight">#springMessage('table.btCurrencyPair.curId1')</td>
					<td width="40%">$!{btCurrencyPairPage.englishCode1}</td>
					<td class="textRight">#springMessage('table.btCurrencyPair.curId2')</td>
					<td width="40%">$!{btCurrencyPairPage.englishCode2}</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.btCurrencyPair.baseCurId')</td>
					<td>$!{btCurrencyPairPage.baseEnglishCode}</td>
					<td class="textRight">#springMessage('table.btCurrencyPair.exchangeRate')</td>
					<td><label id="exchangeRateText"></label></td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.btCurrency.validSign')</td>
					<td colspan="3">$dictTag.get("valid_sign",$!{btCurrencyPairPage.validSign})</td>
				</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
	<script>
		bt.use(['moneyType'],function () {
			var moneyFun = bt.moneyType.getFun();
			var opt = {
				separator: ",",
				decimal: 4
			}
			$("#exchangeRateText").text(moneyFun.format($("#exchangeRate").val(),opt));
		})
	</script>
</body>
</html>
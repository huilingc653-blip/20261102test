<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.btCurrencyPair.curId1')</td>
            <td width="20%">
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name="eqs_englishCode1"
                     data-valueField="englishCode" data-textField="englishCode" ></div>
            </td>
            <td class="textRight">#springMessage('table.btCurrencyPair.curId2')</td>
            <td width="20%">
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name="eqs_englishCode2"
                     data-valueField="englishCode" data-textField="englishCode" ></div>
            </td>
            <td class="textRight">#springMessage('table.btCurrencyPair.baseCurId')</td>
            <td width="20%">
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-name="eqs_baseEnglishCode"
                     data-valueField="englishCode" data-textField="englishCode" ></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btCurrencyPair.curId1')</th>
        <th>#springMessage('table.btCurrencyPair.curId2')</th>
        <th>#springMessage('table.btCurrencyPair.baseCurId')</th>
        <th>#springMessage('table.btCurrencyPair.exchangeRate')</th>
        <th>#springMessage('table.btCurrency.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/btCurrencyPair.list.js?_btv=${resourceVersion}"></script>
</html>

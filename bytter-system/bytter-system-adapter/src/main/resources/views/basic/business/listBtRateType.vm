<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.depositRateType.name')</td>
            <td width="60%">
                <input type="text" name="likes_typeName"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.depositRateType.name')">
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.depositRateType.name')</th>
        <th>#springMessage('bisAccAttribute.rmk')</th>
        <th>#springMessage('table.btRateType.decimalPlaces')</th>
        <th>#springMessage('bisAccAttribute.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/btRateType.list.js?_btv=${resourceVersion}"></script>
</html>

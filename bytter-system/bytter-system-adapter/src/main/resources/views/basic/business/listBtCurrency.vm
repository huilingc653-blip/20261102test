<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.btCurrency.curCode')</td>
            <td width="40%">
                <input type="text" name="likes_curCode" data-maxlength="10" lay-verify="strlength"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.btCurrency.curCode')">
            </td>
            <td class="textRight">#springMessage('table.btCurrency.curName')</td>
            <td width="40%">
                <input type="text" name="likes_curName" data-maxlength="60" lay-verify="strlength"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.btCurrency.curName')">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
##        <th>#springMessage('table.btCurrency.naturalSign')</th>
        <th>#springMessage('table.btCurrency.curCode')</th>
        <th>#springMessage('table.btCurrency.curName')</th>
        <th>#springMessage('table.btCurrency.englishCode')</th>
        <th>#springMessage('table.btCurrency.pbScaleCode')</th>
        <th>#springMessage('table.btCurrency.curExrate')</th>
        <th>#springMessage('table.btCurrency.curSign')</th>
        <th>#springMessage('table.btCurrency.rmk')</th>
        <th>#springMessage('table.btCurrency.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/btCurrency.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="createBy" name="createBy" type="hidden" value="$!{btRateTypePage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{btRateTypePage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{btRateTypePage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{btRateTypePage.updateDate}">
		<input id="id" name="id" type="hidden" value="$!{btRateTypePage.id}">
		<table class="layui-table">
			<tbody>
				<tr>
    				<td class="textRight">#springMessage('table.depositRateType.name')</td>
                    <td width="60%">
						<input type="text" style="display: inline;" id="typeName" name="typeName" lay-verify="required|strlength" data-maxlength="60"
							   autocomplete="off" class="layui-input" placeholder="#springMessage('table.depositRateType.name')">
    				</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.rmk')</td>
					<td >
						<textarea lay-verify="strlength" placeholder="#springMessage('bisAccAttribute.rmk')" class="layui-textarea" style="width:100%" id="rmk" name="rmk" data-maxlength="100"></textarea>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.btRateType.decimalPlaces')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="btRateType.decimalPlaces" data-defaultvalue="4" data-name="decimalPlaces" data-biz-name="decimalPlaces"></div>
					</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('bisAccAttribute.validSign')</td>
					<td>
						<div class="bt-biz-dict" data-type="radio" data-group="valid_sign" data-defaultvalue="1" data-name="validSign" data-biz-name="validSign"></div>
					</td>
				</tr>
				<tr>
					<td colspan="4" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.save')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/basic/business/btRateType.add.js?_btv=${resourceVersion}"></script>
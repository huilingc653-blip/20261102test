<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.bisBifInit.bifCode')</td>
            <td>
                <input type="text" name="likes_bifCode" autocomplete="off" lay-verify="langKey"  class="layui-input" placeholder="#springMessage('table.bisBifInit.bifCode')">
            </td>
            <td class="textRight">#springMessage('table.bisBifInit.name')</td>
            <td>
                <input type="text" name="likes_name" autocomplete="off"  class="layui-input" placeholder="#springMessage('table.bisBifInit.name')">
            </td>
            #*<td class="textRight">#springMessage('btBankType.isDomesticBank')</td>
            <td>
                <div class="bt-biz-dict" data-type="select"
                     data-group="sf_yn" data-name="eqs_isDomesticBank" ></div>
            </td>*#
        </tr>

        <tr>
            <td class="textRight">#springMessage('table.btBankAcc.isValidSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="select"
                     data-group="sf_yn" data-name="eqs_validSign" ></div>
            </td>
            <td class="textRight">#springMessage('table.bisBifInit.isSupportBankForeign')</td>
            <td>
                <div class="bt-biz-dict" data-type="select"
                     data-group="sf_yn" data-name="eqs_isSupportBankForeign" ></div>
            </td>
            #*<td class="textRight"></td>
            <td></td>*#
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.bisBifInit.bifCode')</th>
        <th>#springMessage('table.bisBifInit.name')</th>
        #*<th>#springMessage("btBankType.isDomesticBank")</th>*#
        <th>#springMessage('table.bisBifInit.bankType')</th>
        <th>#springMessage('table.bisBifInit.isSupportBankForeign')</th>
        <th>#springMessage('table.bisBifInit.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/basic/business/bisBifInit.list.js?_btv=${resourceVersion}"></script>
</html>

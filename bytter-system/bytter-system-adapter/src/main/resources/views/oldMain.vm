            <div class="layui-carousel" id="panorama-map" lay-filter="panorama-map">
                <div class="layui-carousel-ind" id="carouselBtn">
                    <ul>
                        <li class="layui-this" data-key="balIframe"></li>
                        <li class="" data-key="dtlIframe"></li>

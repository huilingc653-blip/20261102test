        <style type="text/css">
            .article .item{padding:0;cursor:pointer;border-bottom: 1px solid #eff1f5;}
            .article:last-child .item{border-bottom: none;}
            .article .item .date{height: 42px;line-height: 42px;float: right;color:#999999;font-size: 14px;}
            .message{min-height:600px;background-color: #fff;box-shadow:0 1px 10px 0 rgba(95,119,172,0.2);border-radius:6px;}
            .message .content-body{height: 100%}
            .message .panel-header{height: 45px;border-bottom:1px solid #eff1f5;}
            .message .tab-title{border-bottom:none;float:left;position: absolute;left: 10px;}
            .message .buttons{float: right;height: 43px;line-height: 43px;padding: 0 15px;}
            .message .tab-title .layui-this{color: #3D8EFF;}
            .message .tab-title .layui-this:after{border-bottom: 3px solid #3D8EFF;}
            .message .tab-title li{padding: 0;margin: 0 15px;font-size: 14px;font-weight: bold;}
            .message .tab-content{background:#fff;padding:5px 10px 15px 10px!important;clear: both;}
            .message .tab-content .layui-table th,.message .tab-content .layui-table td{border:none;overflow: hidden;max-width:200px;white-space: nowrap;text-overflow: ellipsis;}
            .message .tab-content .layui-table thead tr{background: #F5F8FF;}
            .message .tab-content .layui-table thead th{font-weight: bold}
            .message .tab-content .layui-table tbody tr:nth-child(even) {background:#F5F8FF;}
            .message .layui-laypage a,.message .layui-laypage span,.message .layui-laypage .layui-laypage-total{border:none;}
            .message .layui-laypage a,.message .layui-laypage .layui-laypage-curr{padding: 0 10px;height: 24px;line-height: 24px;}
            .message .layui-laypage .layui-laypage-curr .layui-laypage-em{background-color: #5BA6FA}
            .message .layui-laypage a:hover{color:#5BA6FA}
            .message .layui-form{float: left;margin-top: 8px;margin-right: 15px;}
            .message .layui-form input{border: 1px solid #C9C9C9;border-radius: 100px;height: 30px;line-height: 30px;padding: 0 10px;font-size: 12px;}
            .message .layui-form-select dl dd.layui-this{background-color: #5BA6FA}
            .message .search-conditions,.message .layui-form-select input {color:#555}
            .message .layui-form-select{width: 80px}
            .message .page{bottom: 20px;text-align:right}
            .message .view{color:#2C7EEC;padding:0 5px;}
            .message .delete{color:#EF6229;padding:0 5px;}
            .message input[type="checkbox"]{margin: .1em;cursor: pointer;text-align: center;vertical-align: middle;}
            .message .status{color:#999999}

            .article-more{cursor:pointer;float: right;margin-right: 18px;}
            .article-more-icon{width: 20px;height: 20px;}
            .more-article-container .article-view{color:#2C7EEC;padding:0 5px;}
            .more-article-container .article-top{color:#46C590;padding:0 5px;}
            .notice-container .content-body-menu,.law-container .content-body-menu{display: block;color:#333333;height: 42px;line-height: 42px;text-align: left;}
            .notice-container .content-body,.law-container .content-body{margin-right: 0}
            .am .dot{width: 6px;height: 6px;border-radius: 30px;margin: 8px 5px 4px 5px;float: left;}
            .am .dot-article{background-color: #3D8EFF;margin: 18px 0 18px 5px;}
            .am .dot-unread{background-color: #FAB630}
            .am .dot-read{background-color: #6FD57C}
        </style>

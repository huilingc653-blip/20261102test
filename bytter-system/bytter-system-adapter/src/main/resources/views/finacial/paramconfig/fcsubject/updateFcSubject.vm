<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    
    #if($!{fcSubjectPage.id} != "") 
		#set ($disab = "disabled")
	#end
</head>
<body>
	<form class="layui-form layui-form-pane" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcSubjectPage.id}">
		<input id="fatherId" name="fatherId" type="hidden" value="$!{fcSubjectPage.fatherId}">
		<table class="layui-table">
			<tr>
				<!-- 科目代码 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.subjectCode')</td>
				<td>
					<input type="text" id="subjectCode" name="subjectCode"
						autocomplete="off" class="layui-input" lay-verify="required" value="$!{fcSubjectPage.subjectCode}" placeholder="#springMessage('finacial.paramConfig.fcSubject.subjectCode')">
				</td>
				<!-- 科目种类 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.subjectSort')</td>
				<td>
					<input class="layui-input" value='$dictTag.get("Admin.SubjectSort",$!{fcSubjectPage.subjectSort})'  disabled >
        			<input type="hidden"  id="subjectSort" name="subjectSort" value="$!{fcSubjectPage.subjectSort}" >
				</td>
			</tr>
			<tr>
				<!-- 科目名称 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.subjectName')</td>
				<td>
                    <div class="layui-inline">
						<input type="text" style="display: inline;" id="subjectName" name="subjectName" lay-verify="required"
							autocomplete="off" class="layui-input" value="$!{fcSubjectPage.subjectNameShow}" placeholder="#springMessage('finacial.paramConfig.fcSubject.subjectName')">
						<span data-toggle="i18n" data-key-id="$!{fcSubjectPage.id}"/>
                    </div>
				
				
				</td>
				<!-- 系统科目 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.sysSubjectCode')</td>
				<td>
					<div class="bt-biz-selectType" data-name="sysSubjectCode" data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSysCode" 
						 data-valuefield="sysSubjectCode"
						 data-textfield="sysSubjectName" 
						 data-defaultvalue="$!{fcSubjectPage.sysSubjectCode}"></div>##$!i18nTag.getBusinessBaseContext($!{fcSubjectPage.sortId})
				</td>
			</tr>
			<tr>
				<!-- 利率 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.interestRate')</td>
				<td>
					<input class="layui-input bt-biz-rateType" data-name="interestRate" data-max="100" data-min="0" value="$!{fcSubjectPage.interestRate}" placeholder="#springMessage('finacial.paramConfig.fcSubject.interestRate')">
				</td>
				#if("G" == "$!{fcSubjectPage.subjectSort}")
				<!-- 单位 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.measureUnit')</td>
				<td>
					<div class="bt-biz-dict" data-name="measureUnit" data-value="$!{fcSubjectPage.measureUnit}" data-type="select" data-group="fcSubject.measureUnit"></div>
				</td>
				#else
				<td colspan="2"></td>
				#end
			</tr>
			<tr>
				<!--余额方向-->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.balanceWay')</td>
				<td>
		         	<div class="bt-biz-dict" data-name="balanceWay" data-type="radio" #if("G" == "$!{fcSubjectPage.subjectSort}") data-group="Tally.Direction" #else data-group="Admin.BalanceWay" #end data-value="$!{fcSubjectPage.balanceWay}" data-required="true"></div>
				</td>
				<!--计息标志-->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.interestSign')</td>
				<td>
##					#set ($interestSignMap = {"field":"interestSign","id":"interestSign","type":"radio","typeGroupCode":"Admin.InterestSign","defaultVal":"$!{fcSubjectPage.interestSign}"})
##		            #set ($formInterestSign = $dictSelect.instance($interestSignMap))
##		         	${formInterestSign.html()}
					 <div class="bt-biz-dict" data-name="interestSign" data-type="radio" data-group="Admin.InterestSign" data-value="$!{fcSubjectPage.interestSign}" data-required="true"></div>
				</td>
			</tr>
			<tr>
				<!--账户类型-->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.accType')</td>
				<td>
					<div class="bt-biz-dict" 
						 data-name="accType" 
						 data-type="select" 
						 data-group="InnerAccount.AccType" 
						 data-value="$!{fcSubjectPage.accType}" 
						 data-required="true"
                         data-filterData="15"></div>
				</td>
				<!--结息方式-->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.predrawSign')</td>
				<td>
					<div class="bt-biz-dict" data-name="predrawSign" data-type="select" data-group="Admin.PredrawSign" data-value="$!{fcSubjectPage.predrawSign}"></div>
				</td>
			</tr>
            <tr>
                <!--现金流科目-->
                <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.isCashItem')</td>
                <td>
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{fcSubjectPage.isCashItem}" data-name="isCashItem" data-biz-name="isCashItem" ></div>
                </td>
                <td class="textRight" rowspan="2"></td>
            </tr>
			<tr>
				<!-- 备注 -->	
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.rmk')</td>
				<td colspan="3">
					<textarea id="rmk" name="rmk" class="layui-textarea">$!{fcSubjectPage.rmk}</textarea>
				</td>
			</tr>
			<tr>
				<td colspan="4" align="center">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
			        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					<button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>
				</td>
			</tr>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','selectType','dicts','rateType'], function(){
    	var $ = bt.jquery,form = bt.form();
		bt.dicts.init();//字典
		bt.rateType.init();//利率
		bt.selectType.init();//下拉框


		//监听提交
        form.on('submit(submit)', function(data){
            var action = "/finacial/paramconfig/fcsubject/modify";
            $.post(basePath + action,data.field,function(result){
            	parent.layer.msg(result.msg, {icon: result.success?1:2});
                if(result.success){
                	var webObj = bt.navtab.getParentDom();
                	webObj.$("#send").click();
                	bt.navtab.closeCurrent(false);
                }
            },'JSON');
            return false;
        });

	});
</script>
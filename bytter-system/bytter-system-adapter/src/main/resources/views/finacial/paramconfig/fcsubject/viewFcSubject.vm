<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcSubjectPage.id}">
		<input id="fatherId" name="fatherId" type="hidden" value="$!{fcSubjectPage.fatherId}">
		<table class="layui-table">
			<tr>
				<!-- 科目代码 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.subjectCode')</td>
				<td>
					$!{fcSubjectPage.subjectCode}
				</td>
				<!-- 科目种类 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.subjectSort')</td>
				<td>
					$dictTag.get("Admin.SubjectSort",$!{fcSubjectPage.subjectSort})
				</td>
			</tr>
			<tr>
				<!-- 科目名称 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.subjectName')</td>
				<td>
					$!i18nTag.getBusinessBaseContext($!{fcSubjectPage.id})
				</td>
				<!-- 系统科目 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.sysSubjectCode')</td>
				<td>
					$!i18nTag.getBusinessBaseContext($!{fcSubjectPage.sortId})
				</td>
			</tr>
			<tr>
				<!-- 利率 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.interestRate')</td>
				<td>
					$rateTag.show(${fcSubjectPage.interestRate})
				</td>
				#if("G" == "$!{fcSubjectPage.subjectSort}")
				<!-- 单位 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.measureUnit')</td>
				<td>
					$dictTag.get("fcSubject.measureUnit",$fcSubjectPage.measureUnit)
				</td>
				#else
				<td colspan="2"></td>
				#end
			</tr>
			<tr>
				<!--余额方向-->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.balanceWay')</td>
				<td>
					#if("G" == "$!{fcSubjectPage.subjectSort}")
    					$dictTag.get("Tally.Direction",$fcSubjectPage.balanceWay)
    				#else
    					$dictTag.get("Admin.BalanceWay",$fcSubjectPage.balanceWay)
    				#end
				</td>
				<!--计息标志-->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.interestSign')</td>
				<td>
					$dictTag.get("Admin.InterestSign",$!{fcSubjectPage.interestSign})
				</td>
			</tr>
			<tr>
				<!--账户类型-->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.accType')</td>
				<td>
					$dictTag.get("InnerAccount.AccType",$!{fcSubjectPage.accType})
				</td>
				<!--结息方式-->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.predrawSign')</td>
				<td>					
					$dictTag.get("Admin.PredrawSign",$!{fcSubjectPage.predrawSign})
				</td>
			</tr>
            <tr>
                <!--现金流科目-->
                <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.isCashItem')</td>
                <td>
                    $dictTag.get("sf_yn",$!{fcSubjectPage.isCashItem})
                </td>
                <td class="textRight" rowspan="2"></td>
            </tr>
			<tr>
				<!-- 备注 -->	
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.rmk')</td>
				<td colspan="3">
					$!{fcSubjectPage.rmk}
				</td>
			</tr>
			<tr>
				<td colspan="4" align="center">
					<button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>
				</td>
			</tr>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<div>
		<table id="tableDate" class="layui-table layui-form" style="width:100%;">
		    <thead>
		    <tr>
		    	<th>#springMessage('finacial.paramConfig.fcSubject.subjectCode')</th>
		        <th>#springMessage('finacial.paramConfig.fcSubject.subjectName')</th>
		        <th>#springMessage('finacial.paramConfig.fcSubject.subjectSort')</th>
		        <th>#springMessage('finacial.paramConfig.fcSubject.balanceWay')</th>
		        <th>#springMessage('finacial.paramConfig.fcSubject.sysSubjectCode')</th>
		        <th>#springMessage('finacial.paramConfig.fcSubject.accType')</th>
		        <th>#springMessage('finacial.paramConfig.fcSubject.valid')</th>
		    </tr>
		    </thead>
		    <tbody>
		    	#foreach($sd in $listData)
		    		<tr>
			    		<td>$!{sd.subjectCode}</td>
		    			<td>$!{sd.subjectName}</td>
		    			<td>$dictTag.get("Admin.SubjectSort",$!{sd.subjectSort})</td>
		    			<td>
		    				#if("G" == "$!{sd.subjectSort}")
		    					$dictTag.get("Tally.Direction",$sd.balanceWay)
		    				#else
		    					$dictTag.get("Admin.BalanceWay",$sd.balanceWay)
		    				#end
		    			</td>
		    			<td>$!{sd.sysSubjectName}</td>
		    			<td>$dictTag.get("InnerAccount.AccType",$!{sd.accType})</td>
		    			<td>$dictTag.get("valid_sign",$!{sd.validSign})	</td>
	    			</tr>
		    	#end
		    </tbody>
		</table>
	</div>
	
	<div class="layui-form-item layui-form-submit ">
		<div class="layui-input-block">
	        <button class="layui-btn" id="imp" >#springMessage('common.button.imports')</button>
	        <!-- <button class="layui-btn layui-btn-primary" name="revert">#springMessage('common.button.revert')</button> -->
	        <button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>
	    </div>
	</div>
	#parse("views/common/footer.vm")
</body>
</html>

<script>
	bt.use(['form'], function(){
	    $ = bt.jquery;
	    $("#imp").click(function(){
	    	//var ss = parent.layer.confirm("#springMessage('finacial.para0.+mConfig.fcSubject.msg.importInit')",function(index){
	    		var action =  basePath + "/finacial/paramconfig/fcsubject/importSubjectDate";
	    		$.post(action, function(result){
	    			parent.layer.msg(bt.lang(result.msg), {icon: result.success?1:2});
	                if(result.success){
	                	var webObj = bt.navtab.getParentDom();
	                	webObj.$("#send").click();
	                	bt.navtab.closeCurrent(false);
	                }
	            },'JSON');
	    	//});
	    });
	    
	    $("[name='revert']").click(function(){
	    	parent.layer.closeAll();
	    }); 
	});
	
</script>
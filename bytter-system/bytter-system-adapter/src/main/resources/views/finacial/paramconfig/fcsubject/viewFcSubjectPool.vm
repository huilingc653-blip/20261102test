<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane" method="post">
		<input id="id" name="id" type="hidden" value="$!{FcSubjectPoolPage.id}">
		<input id="fatherId" name="fatherId" type="hidden" value="$!{FcSubjectPoolPage.fatherId}">
		<table class="layui-table">
			<tr>
				<!-- 科目代码 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.subjectCode')</td>
				<td>
					$!{FcSubjectPoolPage.subjectCode}
				</td>

                <!-- 科目名称 -->
                <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.subjectName')</td>
                <td>
##					$i18nTag.getBusinessBaseContext($!{FcSubjectPoolPage.id})
					$!{FcSubjectPoolPage.subjectName}
                </td>
			</tr>
			<tr>
                <!-- 科目种类 -->
                <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.subjectSort')</td>
                <td>
					$dictTag.get("Admin.SubjectSort",$!{FcSubjectPoolPage.subjectSort})
                </td>

                <!--余额方向-->
                <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.balanceWay')</td>
                <td>
					#if("G" == "$!{FcSubjectPoolPage.subjectSort}")
    					$dictTag.get("Tally.Direction",$FcSubjectPoolPage.balanceWay)
    				#else
						$dictTag.get("Admin.BalanceWay",$FcSubjectPoolPage.balanceWay)
					#end
                </td>
			</tr>
			
			<tr>
				<!--计息标志-->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.interestSign')</td>
				<td>
					$dictTag.get("Admin.InterestSign",$!{FcSubjectPoolPage.interestSign})
				</td>
				
                <!--账户类型-->
                <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.accType')</td>
                <td>
					$dictTag.get("InnerAccount.AccType",$!{FcSubjectPoolPage.accType})
                </td>
			</tr>
			<tr>
				<!-- 备注 -->	
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.rmk')</td>
				<td colspan="3">
					$!{FcSubjectPoolPage.rmk}
				</td>
			</tr>
			<tr>
				<td colspan="4" align="center">
					<button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>
				</td>
			</tr>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
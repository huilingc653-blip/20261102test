<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    
    #if($!{FcSubjectPoolPage.id} != "") 
		#set ($disab = "disabled")
	#end
</head>
<body>
	<form class="layui-form layui-form-pane" method="post">
		<input id="id" name="id" type="hidden" value="$!{FcSubjectPoolPage.id}">
		<input id="fatherId" name="fatherId" type="hidden" value="$!{FcSubjectPoolPage.fatherId}">
		<table class="layui-table">
			<tr>
				<!-- 科目代码 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.subjectCode')</td>
				<td>
					<input type="text" id="subjectCode" name="subjectCode" readonly="readonly" maxlength="20"
                           autocomplete="off" class="layui-input" lay-verify="required" value="$!{FcSubjectPoolPage.subjectCode}" placeholder="#springMessage('finacial.paramConfig.fcSubject.subjectCode')">
				</td>

                <!-- 科目名称 -->
                <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.subjectName')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text"  style="display: inline;" id="subjectName" name="subjectName" lay-verify="required" maxlength="40"
                               autocomplete="off" class="layui-input" value="$!{FcSubjectPoolPage.subjectName}" placeholder="#springMessage('finacial.paramConfig.fcSubject.subjectName')">
                        <span data-toggle="i18n" data-key-id="$!{FcSubjectPoolPage.id}"/>
                    </div>
                </td>
			</tr>
			<tr>
                <!-- 科目种类 -->
                <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.subjectSort')</td>
                <td>
                    <input class="layui-input" value='$dictTag.get("Admin.SubjectSort",$!{FcSubjectPoolPage.subjectSort})'  disabled data-required="true">
                    <input type="hidden"  id="subjectSort" name="subjectSort" value="$!{FcSubjectPoolPage.subjectSort}" >
                </td>

                <!--余额方向-->
                <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.balanceWay')</td>
                <td>
                    <div class="bt-biz-dict" data-name="balanceWay" data-type="radio" #if("G" == "$!{FcSubjectPoolPage.subjectSort}") data-group="Tally.Direction" #else data-group="Admin.BalanceWay" #end data-value="$!{FcSubjectPoolPage.balanceWay}" data-required="true"></div>
                </td>
			</tr>
			<tr>
                <!--账户类型-->
                <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.accType')</td>
                <td>
                    <div class="bt-biz-dict" data-name="accType" data-type="select" data-group="InnerAccount.AccType" 
						 data-value="$!{FcSubjectPoolPage.accType}" data-displayData="02,07,01" 
						 data-required="true" data-callback="setInterest"></div>
                </td>

                <!--计息标志-->
                <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.interestSign')</td>
                <td>
                    <div class="bt-biz-dict" data-name="interestSign" data-biz-name="interestSign" data-type="radio"
						 data-group="Admin.InterestSign" data-value="$!{FcSubjectPoolPage.interestSign}"  data-required="true" ></div>
                </td>
			</tr>
			
			<tr>
				<!-- 备注 -->	
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.rmk')</td>
				<td colspan="3">
					<textarea id="rmk" name="rmk" class="layui-textarea" maxlength="40">$!{FcSubjectPoolPage.rmk}</textarea>
				</td>
			</tr>
			<tr>
				<td colspan="4" align="center">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
			        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					<button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>
				</td>
			</tr>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','selectType','dicts','rateType'], function(){
    	var $ = bt.jquery,form = bt.form();
		bt.dicts.init();//字典
		bt.rateType.init();//利率
		bt.selectType.init();//下拉框


		//监听提交
        form.on('submit(submit)', function(data){
            var action = "/finacial/paramconfig/FcSubjectPool/modify";
            $.post(basePath + action,data.field,function(result){
                if(result.success){
                    parent.layer.closeAll();
                    bt.navtab.closeCurrent();
                    bt.navtab.refreshCurrent();
                }
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            },'JSON');
            return false;
        });

	});

    function setInterest(data){
        var dicts = bt.dicts.init();
        var accType = data.value;
        if(accType == "02" || accType == "07"){
            dicts.get("interestSign").val("0");
            dicts.get("interestSign").attr({'data-disabled':true});
        }else{
            dicts.get("interestSign").attr({'data-disabled':false});
            dicts.get("interestSign").val("1");
        }
        dicts.render();
    }
</script>

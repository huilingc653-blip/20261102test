<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #page .layui-box {
            justify-content: flex-end
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table" style="border: none;">
        <tbody>
        <tr>
            ##所属网点
            <td class="textRight">#springMessage('table.fcCarry.netId')</td>
            <td width="40%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-name="netId" data-biz-name="netId"
                         data-scope="net" data-biz-type="net" data-type="selectTree"
                         data-defaultvalue="$!{netId}" data-resource="finacial:fcsubjectday:sum:query"></div>
                </div>
            </td>
            ##结转日期
            <td class="textRight">#springMessage('table.fcSubjectDay.optDate')</td>
            <td width="40%">
                <input type="text" name="optDate" data-biz-name="optDate"
                       value="$!date.format('yyyy-MM-dd',$!{optDate})"
                       class="layui-input bt-input-inline bt-biz-dateType">
            </td>
            ##币别代码
            <td class="textRight">#springMessage('table.fcSubjectDay.curCode')</td>
            <td width="40%">
                <div class="bt-biz-selectType" data-biz-name="curId"
                     data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id"
                     data-textfield="curName" data-name="curId" data-search="true" data-value="$!{curId}"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" type="button" id="searchBtn">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary" data-callback="reset">#springMessage(
                    'common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>

<div class="layui-input-inline" style="width:25%;left: 30px">
    <span>#springMessage('table.fcAcc.netId'):</span>
    <span>$!{netName}</span>
</div>

<div class="layui-input-inline" style="width:25%">
    <span>#springMessage('table.fcSubjectDay.optDate'):</span>
    <span>$!{optDate1}</span>
</div>

<div class="layui-input-inline" style="width:25%">
    <span>#springMessage('table.fcSubjectDay.curCode'):</span>
    ##		#if($!curId)
    <span>$!{curName}</span>
    ##		#end
</div>


<!-- <tr>
		<td>#springMessage('table.fcCarry.netId')</td><td>$!{model.head.NETNAME}</td>
		<td >&nbsp;</td>
		<td >&nbsp;</td>
		<td >&nbsp;</td>
		<td>#springMessage('table.fcSubjectDay.optDate')</td><td>$!{model.head.OPTDATE}</td>
		<td >&nbsp;</td>
		<td >&nbsp;</td>
		<td >&nbsp;</td>
		<td>#springMessage('table.fcSubjectDay.curCode')</td><td>$!{model.head.CURNAME}</td>
		</tr> -->

<div>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr class="title">
            <th rowspan="2">#springMessage('table.subject_num')</th>
            <th rowspan="2">#springMessage('table.fcAcc.subjectId')</th>
            <th colspan="2">#springMessage('table.fcSubjectDay.cashDebit')</th>
            <th colspan="2">#springMessage('table.fcSubjectDay.trDebit')</th>
            <th colspan="2">#springMessage('table.fcSubjectDay.cashCredit')</th>
            <th colspan="2">#springMessage('table.fcSubjectDay.trCredit')</th>
        </tr>
        <tr class="title">
            <th>#springMessage('table.btNetChalk.money')</th>
            <th>#springMessage('table.fcAccBalance.cnt')</th>
            <th>#springMessage('table.btNetChalk.money')</th>
            <th>#springMessage('table.fcAccBalance.cnt')</th>
            <th>#springMessage('table.btNetChalk.money')</th>
            <th>#springMessage('table.fcAccBalance.cnt')</th>
            <th>#springMessage('table.btNetChalk.money')</th>
            <th>#springMessage('table.fcAccBalance.cnt')</th>
        </tr>
        </thead>
        <tbody>
            #foreach($fs in $model.dataList)
            <tr style="text-align: center">
                <td>$!{fs.subjectCode}</td>
                <td>$!{fs.subjectName}</td>
                <td class="bt-biz-moneyType" style="text-align:right;">$!number.formatNumeric($!{fs.cashDebitMoney})</td>
                <td>$!number.formatNumeric($!{fs.cashDebitCnt},'#,##0')</td>
                <td class="bt-biz-moneyType" style="text-align:right;">$!number.formatNumeric($!{fs.trDebitMoney})</td>
                <td>$!number.formatNumeric($!{fs.trDebitCnt},'#,##0')</td>
                <td class="bt-biz-moneyType" style="text-align:right;">$!number.formatNumeric($!{fs.cashCreditMoney})</td>
                <td>$!number.formatNumeric($!{fs.cashCreditCnt},'#,##0')</td>
                <td class="bt-biz-moneyType" style="text-align:right;">$!number.formatNumeric($!{fs.trCreditMoney})</td>
                <td>$!number.formatNumeric($!{fs.trCreditCnt},'#,##0')</td>
            </tr>
            #end
        </tbody>
        <tfoot>
        <tr id="sum" style="text-align: center;background-color:#ddd">
            <td colspan="2">#springMessage('common.button.collect')</td>
            <td class="bt-biz-moneyType" style="text-align:right;">$!number.formatNumeric($!{model.head.CASHDEBITMONEYSUM})</td>
            <td>$!number.formatNumeric($!{model.head.CASHDEBITCNTSUM},'#,##0')</td>
            <td class="bt-biz-moneyType" style="text-align:right;">$!number.formatNumeric($!{model.head.TRDEBITMONEYSUM})</td>
            <td>$!number.formatNumeric($!{model.head.TRDEBITCNTSUM},'#,##0')</td>
            <td class="bt-biz-moneyType" style="text-align:right;">$!number.formatNumeric($!{model.head.CASHCREDITMONEYSUM})</td>
            <td>$!number.formatNumeric($!{model.head.CASHCREDITCNTSUM},'#,##0')</td>
            <td class="bt-biz-moneyType" style="text-align:right;">$!number.formatNumeric($!{model.head.TRCREDITMONEYSUM})</td>
            <td>$!number.formatNumeric($!{model.head.TRCREDITCNTSUM},'#,##0')</td>
        </tr>
        </tfoot>
    </table>
</div>
<input type="hidden" id="total" value="$!{model.total}">
<input type="hidden" id="curr" value="$!{model.curr}">
<input type="hidden" id="curId" value="$!{curId}">
<input type="hidden" id="netId" value="$!{netId}">
<input type="hidden" id="optDate" value="$!date.format('yyyy-MM-dd',$!{optDate})">
<div id="page" style="margin-bottom:20px;width:100%"></div>

    #parse("views/common/footer.vm")
</body>

<script>
    bt.use(['form', 'corp', 'selectType', 'dateType', 'relaypage'], function () {
        $ = bt.jquery, form = bt.form();
        selectType = bt.selectType.init();
        dateType = bt.dateType.init();
        corps = bt.corp.init();
        $("#searchBtn").off("click").on('click', function () {
            var currentPage = $("#curr").val();
            var currentNetId = corps.get("netId").val()
            if (currentNetId != $('#netId').val()) {
                currentPage = 1;
            }

            var param = "netId=" + currentNetId + "&optDate=" + dateType.get("optDate").val() + "&curr=" + currentPage + "&curId=" + selectType.get("curId").val();
            location.href = basePath + "/finacial/closedeal/fcsubjectday/listSum?" + param;
        })


        bt.relaypage({
            cont: 'page',
            pages: $("#total").val(),
            curr: $("#curr").val(),
            resultCount: $("#total").val(),
            last: '尾页',
            layout: ['count', 'prev', 'page', 'next', 'refresh', 'skip'],
            skip: true,
            jump: function (obj, first) {
                if (!first) {
                    // 已经是最后一页，不查询
                    if (obj.curr != $("#curr").val()) {
                        var curr = obj.curr;
                        $("#curr").val(curr)
                        var param = "netId=" + $("#netId").val() + "&optDate=" + dateType.get("optDate").val()  + "&curId="
                                + selectType.get("curId").val()+"&curr="+obj.curr;
                        location.href = basePath + "/finacial/closedeal/fcsubjectday/listSum?" + param;
                    }
                }
            }
        });

    });

    function reset() {
        corps.get("netId").val("");
        selectType.get("curId").attr("data-value", "");
        dateType.get("optDate").val("")
    }
</script>
</html>

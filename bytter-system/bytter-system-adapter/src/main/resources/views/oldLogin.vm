            $("#loginType1").removeClass("loginTypeSelect");
            $("#loginType2").removeClass("loginTypeSelect");
            $("#loginType3").removeClass("loginTypeSelect");
        }else if(loginType == 1){
            $("#login").val("1").html('#springMessage("sys.login.button.calogin")');
            $("#accountDiv").show();
            $("#account").attr("lay-verify", "account");
            $("#passwordDiv").show();
            $("#password").attr("lay-verify", "password");
            $("#loginType0").removeClass("loginTypeSelect");
            $("#loginType1").addClass("loginTypeSelect");
            $("#loginType2").removeClass("loginTypeSelect");
            $("#loginType3").removeClass("loginTypeSelect");
        }else if(loginType == 2){
            $("#login").val("2").html('#springMessage("sys.login.button.calogin")');
            $("#accountDiv").show();
            $("#account").attr("lay-verify", "account");
            $("#passwordDiv").hide();
            $("#password").attr("lay-verify", "");
            $("#loginType0").removeClass("loginTypeSelect");
            $("#loginType1").removeClass("loginTypeSelect");
            $("#loginType2").addClass("loginTypeSelect");
            $("#loginType3").removeClass("loginTypeSelect");
//            var id = window.setTimeout(function () {
//                var encrypt = $("#encrypt").val();
//                if(encrypt == 1 && CurCert == null){
//                    var loginName = iTrusCa();
//                    $("#caMessageDiv").html(loginName);
//                }
//            },5000);
        }else if(loginType == 3){
            $("#login").val("3").html('#springMessage("sys.login.button.sso")');
            $("#accountDiv").hide();
            $("#account").attr("lay-verify", "");
            $("#passwordDiv").hide();
            $("#password").attr("lay-verify", "");
            $("#loginType0").removeClass("loginTypeSelect");
            $("#loginType1").removeClass("loginTypeSelect");
            $("#loginType2").removeClass("loginTypeSelect");
            $("#loginType3").addClass("loginTypeSelect");
        }
    }

    function iTrusCa(){
        var $ = bt.jquery,form = bt.form(),layer = bt.layer;
        var certList = selectiTrusCa();
        var userCadn = "";
        layer.open({
            title: bt.lang('sys.login.TianweiCertificate'),//'天威证书列表',
            content: certList,
            yes: function(index, layero){
                CurCert=selectSingleCert("",layero.find("select option:selected").val());
                userCadn = layero.find("select option:selected").val();
                $.post(basePath + '/getUserByCadn', 'userCadn='+userCadn,function (reslut) {
                    if (reslut.success) {
                        var attributes=reslut.attributes;
                        if(attributes && attributes.type!=-1){
                            layer.alert(reslut.attributes);
                        }
                    }
                }, 'JSON');
                layer.close(index);
            }
        });
    }

    var _theCount=0
    var ispwBlur=false
    var isAccBlur=false
    function userLoginType(obj){
        isAccBlur=true
        if(bt.jquery){
            var $ = bt.jquery;
            var loginCode=$(obj).val();
            if(loginCode){
                $.post(basePath + '/userLoginType', 'loginName='+loginCode, function (reslut) {
                    if (reslut.success) {
                        var attributes=reslut.attributes;
                        if(attributes && attributes.type!=-1){
                            toLoginType(attributes.type);
                        }else{
                            toLoginType($defaultLoginType);
                        }
                    }
                }, 'JSON');
            }else{
                toLoginType($defaultLoginType);
            }
        }
    }

    /**
     * 自定义密码框
     */
    var pwd = ''
    var symbol= '•'
    var isComposing = false;
    var passwordEle = document.getElementById('password');
    function CursorPosition (_inputEl) {
        this._inputEl = _inputEl
    }
    CursorPosition.prototype.getCursorPosition =function(){
        var rangeData = { text: '', start: 0, end: 0 }
        if (this._inputEl.setSelectionRange) {
            // W3C

            rangeData.start = this._inputEl.selectionStart
            rangeData.end = this._inputEl.selectionEnd
            rangeData.text = rangeData.start !== rangeData.end ? this._inputEl.value.substring(rangeData.start, rangeData.end) : ''
        } else if (document.selection) {
            // IE

            var i
            var oS = document.selection.createRange()
            var oR = document.body.createTextRange()
            oR.moveToElementText(this._inputEl)
            rangeData.text = oS.text
            rangeData.bookmark = oS.getBookmark()
            for (i = 0; oR.compareEndPoints('StartToStart', oS) < 0 && oS.moveStart('character', -1) !== 0; i++) {
                if (this._inputEl.value.charAt(i) === '\r') {
                    i++
                }
            }
            rangeData.start = i
            rangeData.end = rangeData.text.length + rangeData.start
        }

        return rangeData
    }
    CursorPosition.prototype.setCursorPosition=function(rangeData){
        var oR
        if (!rangeData) {
            alert('You must get cursor position first.')
        }
        if (this._inputEl.setSelectionRange) {
            // W3C
            this._inputEl.setSelectionRange(rangeData.start, rangeData.end)
        } else if (this._inputEl.createTextRange) {
            // IE
            oR = this._inputEl.createTextRange()
            if (this._inputEl.value.length === rangeData.start) {
                oR.collapse(false)
                oR.select()
            } else {
                oR.moveToBookmark(rangeData.bookmark)
                oR.select()
            }
        }
    }

    function pwdSetData (positionIndex, value) {
        // 写入原始数据
        var _pwd = value.split(symbol).join('')
        if (_pwd) {
            var index = pwd.length - (value.length - positionIndex.end)
            pwd = pwd.slice(0, positionIndex.end - _pwd.length) + _pwd + pwd.slice(index)
        } else {
            pwd = pwd.slice(0, positionIndex.end) + pwd.slice(positionIndex.end + pwd.length - value.length)
        }
        pwd = changePassword(pwd)
    }
    function changePassword (pwd) {
        if (!pwd) return ''
        var reg = /^[\u4E00-\u9FA5]+$/
        var newPwd = ''
        for (var i = 0; i < pwd.length; i++) {
            if (!reg.test(pwd[i])) {
                newPwd += pwd[i]
            }
        }
        return newPwd
    }

    passwordEle.addEventListener('compositionstart', function () {
        isComposing = true
    });
    passwordEle.addEventListener('compositionend', function (event) {
        if (isComposing) {
            isComposing = false
            // handleCompositionEnd比handleInput后执行，避免isComposing还为true时handleInput无法执行正确逻辑
            passwordInput(event.target)
        }
    });


    function passwordInput(ele){
        if (isComposing) return
        var cursorPosition = new CursorPosition(ele)
        var positionIndex = cursorPosition.getCursorPosition()
        pwdSetData(positionIndex, ele.value)
        if(!ele.value)return
        var data = ''
        var reg = /^[\u4E00-\u9FA5]+$/
        for (var i = 0; i < ele.value.length; i++) {
            if (!reg.test(ele.value[i])) {
                data += symbol
            }
        }
        ele.value = data
        cursorPosition.setCursorPosition(positionIndex, ele)
    }

    //输入框删除按钮控制
    function toggleIcon(ele){
        if(bt.jquery){
            var $ = bt.jquery;
            var inputVal = ele.value;
            if(inputVal == ''){
                $(ele).siblings('.login-icon-right').addClass('layui-hide')
            } else {
                $(ele).siblings('.login-icon-right').removeClass('layui-hide')
            }
            // 解决ie11、ie10自动触发input事件
            if (!!window.ActiveXObject || 'ActiveXObject' in window) {
                _theCount++
                if (_theCount < 3) {
                    return
                }
                if(isAccBlur){
                    isAccBlur=false
                    return
                }
                if(ispwBlur==false){
                    ispwBlur=true
                }
            }
        }
    }

    //密码输入框删除按钮控制
    function toggleIcon2(ele){
        if(bt.jquery){
            var $ = bt.jquery;
            var inputVal = ele.value;
            if(inputVal == ''){
                $(ele).siblings('.login-icon-right').addClass('layui-hide')
            } else {
                $(ele).siblings('.login-icon-right').removeClass('layui-hide')
            }
        }
        // 解决ie11、ie10自动触发input事件
        if (!!window.ActiveXObject || 'ActiveXObject' in window) {
            _theCount++
            if (_theCount < 3) {
                return
            }
            if(ispwBlur){
                ispwBlur=false
                return
            }
            if(isAccBlur==false){
                isAccBlur=true
            }
        }
        passwordInput(ele)
    }

    // 输入框失去焦点事件
    function lost(ele){
        ispwBlur=true
        var inputVal = ele.value;
        var clearEle = ele.nextElementSibling;
        if(bt.jquery){
            var $ = bt.jquery;
            setTimeout( function(){
                if(inputVal == ''){
                    $(ele).siblings('.login-icon-right').addClass('layui-hide')
                } else {
                    $(ele).siblings('.login-icon-right').removeClass('layui-hide')
                }
            }, 200);
        }
    }
    // 清空输入框
    function clearVlaue(ele) {
        if(bt.jquery){
            var $ = bt.jquery;
            $(ele).siblings('input').val("").focus();
            $(ele).addClass('layui-hide')
        }
    }

</script>
    #parse("views/common/caData.vm")
    #caDataScript()
    #caDataHidden()
</body>

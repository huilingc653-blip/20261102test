    function toSubmit(data,loginType) {
        var $ = bt.jquery,form = bt.form(),layer = bt.layer;
        data.field.rememberMe = data.field.rememberMe ? 1 : 0;
        $.get(basePath+'/oauth/loginToken',function(rs){
            if(!rs){
                layer.alert("鉴权服务异常，请刷新重试");
            }
            var publickey = rs.data;
            data.field.password=pwd
            var encrypted = sm2Encrypt(data.field.password, publickey, 1);
            sendData = {
                publickey:publickey,
                username:data.field.account,
                password:encrypted,
                scope:'read',
                grant_type:'password',
                client_id:'test_client',
                client_secret:'test_secret' ##从数据库里查出来TODO
            };
            $.ajax({
                type: "post",
                dataType:'json',
                contentType : 'application/x-www-form-urlencoded;charset=utf-8',
                headers:{'Authorization':'Basic dGVzdF9jbGllbnQ6dGVzdF9zZWNyZXQ=','x-forwarded-for':'dev'},
                url: basePath+'/oauth/token',
                data: sendData,
                success: function (result) {
                    if(result && result.access_token){
                        layer.msg(bt.lang('sys.login.message.login.success'),{time: 1500}, function (index) {
                            store.set('Access-Token',result.access_token);
                            document.cookie = "Access-Token=" + result.access_token;
                            location.href = basePath + "/index?_btv="+new Date().getTime() ;
                        });
                        // store.set('Access-Token',result.access_token);
                        // document.cookie = "Access-Token=" + result.access_token;
                        // location.href = basePath + "/index?_btv="+new Date().getTime() ;
                    }else {
                        layer.alert(result.msg, {icon: 2}, function (index) {
                            if ("SYS_LOGIN_CA_NO_BINDING" == result.messageEnum) {
                                if(loginType == 1) {
                                    location.href = basePath + "/caBinding?loginName=" + $("#account").val() + "&password=" + $("#password").val();//如果没有绑定证书跳转到证书绑定页面
                                }else{
                                    location.href = basePath + "/caBinding";
                                }
                            } else if (result.attributes && result.attributes.showCaptcha) {
                                location.href = basePath + "/index";
                            } else if("SYS_LICENSE_EXPIRE_PLEASE_UPDATE"== result.messageEnum){
                                location.href = basePath + "/sys/license/detail";
                            }
                            #if($showCaptcha)
                                    $reloadCaptchaImg()
                            #end
                            if(result.msg =="密码错误"){
                                $("#password").focus();
                            }else if(result.msg =="帐号不存在"){
                                $("#account").focus();
                            }
                            layer.close(index);
                        });
                    }
                }
            });
        },'JSON');
    }

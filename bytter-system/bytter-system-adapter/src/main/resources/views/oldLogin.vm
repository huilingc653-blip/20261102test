<script type="text/javascript">
    store.clearAll()
    // 加载字典资源
    $.get(basePath + "/dict", function (json) {
        console.log(basePath)
        if (!json) {
            return;
        }
        var dict = {};
        for (var i = 0; i < json.length; i++) {
            var temp = json[i];
            var tempGroupCode = temp.groupCode;
            if (!dict[tempGroupCode]) {
                dict[tempGroupCode] = {};
            }
            if (!dict[tempGroupCode][temp.code]) {
                dict[tempGroupCode][temp.code] = {name: temp.name, index: i, code: temp.code};
            }
        }
        // store.remove('bytter_dict');//清除 liuyj 2018-06-05
        //  store.set('bytter_dict', dict);
        try{
            store.set('bytter_dict', dict);
        }catch (e) {
            bt.dictContext = dict;
        }
        //store.set('bytter_dict', JSON.stringify(dict));
    }, 'JSON');

    // 登录页只加载公开的必要文本，不写入业务页面使用的完整语言缓存。
    bt.loginLangOnly = true;
    $.ajax({
        url: basePath + "/lang/login", type: 'get', async: false, dataType: 'json',
        success: function (json) {
            if (!json) {
                return;
            }
            var lang =  {};
            for (var i = 0; i < json.length; i++) {
                lang[json[i].langKey] = json[i].langContext;
            }
            window.mutiLang = lang;
            bt.bytterMutiLang = lang;
        }
    });

</script>

            $("#loginContainer").removeClass("active");
            location.href=basePath+"/login?locale="+selectValue;
        })

        $('#loginContainer').bind("mousedown", function( event ) {
            event.preventDefault();
        }).hover(function(){
        },function(){
            $("#loginContainer").removeClass("active");
        });
        //语言选择 结束

        // 验证
        form.verify({
            account: function (value) {
                if (value == "") {

    <style type="text/css">
        .admin-contextmenu {
            position: absolute;
            line-height: 36px;
            width: 130px;;
            background-color: white;
            border: 1px solid #d2d2d2;
            border-radius: 2px;
            box-shadow: 0 2px 4px rgba(0, 0, 0, .12);
            top: 105px;
            display: none;
            z-index: 9999;
        }
        .admin-contextmenu .fa { padding: 0 8px!important; }
        .admin-contextmenu ul { padding: 5px 0; }
        .admin-contextmenu ul li:hover { background-color: #eee; cursor: pointer; }
        .admin-contextmenu ul li {padding: 0 5px; }

        a {
            font-size: 12px;
        }
        .clearfix:after {
            content: "";
            display: block;
            clear:both;
            height: 0;
            line-height: 0;
            visibility: hidden;
        }
        .clearfix {
            zoom:1;
        }
        .active {
            color: #008cee;
        }
        .borderRightNone {
            border-right: none;
        }
        .clearBoreLeft {
            width: 4px;
            height: 40px;
            position: absolute;
            left: -3px;
            top: 0px;
            background: #fff;
        }
        .layui-layout {
            position: absolute;
            z-index: 2;
        }
        .layui-layout > .color {
            background-color: #008cee!important;
        }
        .color3 {
            background-color: #008cee!important;
        }
        .left-nav-part{
            height:100%;
            width: 70px;
            background-color: #393D49;
            position: fixed;
            top: 60px;
            left: 0;
        }
        .left-nav {
            height: 100%;
            overflow-y: auto;
        }
        .left-nav li > a {
            display: inline-block;
            width: 70px;
            height: 60px;
            /*text-align: center;*/
            line-height: 60px;
        }
        .left-nav li > a > div.top-menu-icon i{
            font-size: 30px;
        }
        .left-nav .navli-box > a {
            text-align: center;
        }
        .left-nav .navli-box > a > i {
            font-size: 30px;
        }
        .left-nav li.active>a>i{
            color: #fff;
        }
        .menu-detail-left{
            width: 200px;
            min-height: 100%;
            background: #ebeff1;
        }
        .box-shadow-1{
            -webkit-box-shadow: 10px 5px 10px rgba(0, 0, 0, 0.5);
            -moz-box-shadow:  10px 5px 10px rgba(0, 0, 0, 0.5);
            box-shadow:  10px 5px 10px rgba(0, 0, 0, 0.5);
        }
        .menu-detail-left .layui-nav {
            background: #ebeff1;
            /*overflow: auto;*/
        }
        .layui-nav li a  {
            color:#000;
        }
        .menu-detail-right{
            height: 100%;
            display: none;
            position: fixed;
            width: 300px;
            left: 270px;
            top: 60px;
            background:#fff;
            z-index: 999;
            border-left: none;
        }
        .menu-container{
            height: 100%;
            position: fixed;
            top: 60px;
            left:70px;
            width: 200px;
            display: none;
            z-index: 999;
        }
        .left-nav-part .layui-nav-tree li dl dd > a{
            font-size:12px;
            padding: 0 30px;
            box-sizing: border-box;
            width: 200px;
        }

        .left-nav-part .layui-nav .layui-nav-item >a{
            width: 160px;
            height: 36px;
            padding: 0 20px;
            line-height: 36px;
            font-size: 14px;

        }
        .color2 {
            background-color: #e4eaf4!important;
        }
        .color2 >.left-nav > li.active > a > i{
            color:#008cee!important;
        }
        .layui-nav-tree {
            width: 200px;
        }
        .layui-nav-tree .layui-nav-item >a:hover {
            width: 160px;
            background-color: #ebeff1;
            color: #000;
        }
        .left-nav-part .layui-nav-tree li dl dd > a {
            height:32px;
            font-size: 12px;
            line-height:32px;
            color:#000;
        }
        .left-nav-part .layui-nav-tree li > a {
            font-size: 12px;
        }
        .layui-nav-itemed > a {
            background-color: #ebeff1!important;
            background-color: red;
            color: #000!important;
        }
        .layui-nav-tree  .layui-nav-more {
            top:14px!important;
            right: 20px;
        }
        .layui-nav-itemed .layui-nav-more {
            top:12px;

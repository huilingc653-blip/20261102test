            z-index: 1;
            opacity: 0.4;
            -khtml-opacity:0.4;
            -moz-opacity:0.4;
            filter:alpha(opacity=4);
            background-color:#000;
            display: none;
        }
        .menu-collect-icon{
            position: absolute;
            right: 10px;
            top: 0;
            height: 36px;
            line-height: 36px;
            font-size: 16px;
            cursor: pointer;
            color:#a5a5a5;
        }

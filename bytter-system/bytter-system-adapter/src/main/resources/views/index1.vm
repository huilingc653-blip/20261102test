<script type="text/javascript">
    bt.use(['layer', 'navtab','form', 'util'], function () {
        var element = bt.element(), layer = bt.layer, $ = bt.jquery, util = bt.util; //导航的hover效果、二级菜单等功能，需要依赖element模块
        //初始化tab
        bt.navtab.init();

        var side = $('.left-nav-part');
        var body = $('.my-body');
        var loginName = $('[name="loginName"]').val();

        <!-- -------- zuoy 2017/11/16 锁屏校验 ------------- -->
        $.ajax({
            url: basePath + "/sys/user/checkLockScreen?id=" + loginName,
            method: 'GET',
            dataType: "json",
            contentType: 'application/json;charset=utf-8', //设置请求头信息
            success: function (json) {
                if(json){
                    lockScreen();
                }
            }
        });

        // 监听控制content高度
        function init() {
            // 选项卡高度
            cardTitleHeight = $(document).find(".layui-tab[lay-filter='card'] ul.layui-tab-title").height();
            // 需要减去的高度
            height = $(window).height() - $('.layui-header').height() - cardTitleHeight;
           // 设置高度
            $(document).find(".layui-tab[lay-filter='card'] div.layui-tab-content").height(height - 1);
            $(document).find(".menu-detail-left > ul ").height(height-2);
            $(document).find(".item-lastchild").height(height-2);

            <!-- -------- zuoy 2017/11/15 密码策略校验 ------------- -->
            var passwordCloseBtn = Number($("#passwordCloseBtn").val());
            if(passwordCloseBtn !== 3){
                $.ajax({
                    url: basePath + "/sys/user/checkUserPassword?loginName=" + loginName,
                    method: 'GET',
                    dataType: "json",
                    contentType: 'application/json;charset=utf-8', //设置请求头信息
                    success: function (json) {
                        if (json.success) {
                            layer.alert(json.msg, {icon: 0, closeBtn: passwordCloseBtn},function () {
                                layer.closeAll();
                                layer.open({
                                    type: 2,
                                    title: '修改密码',
                                    area: ['350px', '250px'],
                                    closeBtn: passwordCloseBtn,
                                    content: basePath + "/sys/user/modifyPassword?id=" + loginName
                                });
                            });

                        }
                    }
                });
            }
        }
        // 初始化
        init();

        var leftNavEnterTimer = 0;
        var leftNavLeaveTimer = 0;
        $('.left-nav-part .left-nav > li a').mouseenter(function(e){
            var that = $(this);
            clearTimeout(leftNavEnterTimer);
            leftNavEnterTimer = setTimeout(function(){
                var title = that.parent().data("title");
                layer.closeAll('tips');
                layer.tips(title,that.parent().find('span.menu-arrow-tips'),{
                    time: 30000
                });
            },50);
        }).mouseleave(function(){
            clearTimeout(leftNavLeaveTimer);
            leftNavLeaveTimer = setTimeout(function () {
                layer.closeAll('tips');
            },50)
        });

        var menuArrowAnimateTime = 300;
        //设置顶级菜单点击时的展开
        $('.left-nav-part').on('click','.left-nav > li',function(e){
            e.stopPropagation();
            layui.stope(e);
            var othis = $(this);
            var menuContainer = othis.find(".menu-container");

            //移除菜单上所有的箭头
            othis.siblings().find("span.menu-arrow").each(function(){
                $(this).animate({right:"-20px"},menuArrowAnimateTime,hideMenuArror)
            });
            if(othis.hasClass('active')){
                menuContainer.hide();
                othis.removeClass('active');
                //移除当前的箭头
                othis.find("span.menu-arrow").animate({right:"-20px"},menuArrowAnimateTime,hideMenuArror);
                $(".menu-shadow-model").hide();
            }else{
                layer.closeAll('tips');
                menuContainer.show();
                //显示自己的箭头
                othis.find(".menu-arrow").css({display:'block'}).animate({right:"0px"},menuArrowAnimateTime);
                othis.addClass("active").siblings().removeClass("active");
                othis.siblings().find(".menu-container").hide();
                othis.siblings().find(".menu-container li.layui-nav-itemed .layui-this ").removeClass("layui-this");
                othis.siblings().find(".menu-container li.layui-nav-itemed").removeClass("layui-nav-itemed");
                $(".menu-shadow-model").show();
            }
        })
        //设置二级菜单点击时的展开
        $('.menu-detail-left ').on('click','.layui-nav-item > a',function(e){
            var that = this;
            layui.stope(e)
            $(that).parent().siblings('.layui-nav-itemed').removeClass('layui-nav-itemed').find('dl.active').removeClass('active');
            $(that).parent().siblings().find('.layui-nav-child > .menu-detail-right ').hide();
        });
        //设置点击二级菜单时，不出现关闭菜单
        $('.menu-container').click(function (e) {
            layui.stope(e);
        })

        //设置三级菜单点击时的展开
        $('.layui-nav-child dd a').click(function (e) {
            layui.stope(e);
            var othis = $(this);
            var dl = othis.parent().parent('dl');
            dl.addClass('active');
            dl.siblings().removeClass('active');
            $(this).parent().parent().find(".menu-detail-right").show();
            $(this).parent().parent().siblings().find(".menu-detail-right").hide();
        });


        $(document).on("click",function () {
            $(".menu-container").hide();
            $(".left-nav > li").removeClass("active");
            $(".menu-open").removeClass("menu-open");
            $(".menu-shadow-model").hide();

            $(".left-nav > li span.menu-arrow").each(function(){
                $(this).animate({right:"-20px"},menuArrowAnimateTime,hideMenuArror)
            });
        });

        var hideMenuArror = function(){
            $(this).css({display:'none'});
        }


        $("#setColor").click(function () {
            $(".my-header").toggleClass("color")
            $(".left-nav-part").toggleClass("color2");
            $(".layui-btn").toggleClass("color3")
        })
        $(".menu-detail-left").find(".layui-nav-bar").remove();


        $("#modifyPassword").click(function(){
            layer.open({
                type: 2,
                title:'修改密码',
                area: ['350px', '250px'],
                content: basePath + "/sys/user/modifyPassword?id=" + loginName
            });
        });

        $("#edit-main").click(function(){
            vm.toggleEditMode();
        });

        $('.menu-collect-icon').click(function(){
            var that = $(this);
            var menuId = that.prev().data("id");
            $.get(basePath + '/sys/menuCollect/collect',{menuId:menuId},function(result){
                if(result.success){
                    var icon = that.find('i');
                    if(icon.hasClass('fa-star-o')){
                        icon.removeClass('fa-star-o').addClass('fa-star');
                        layer.msg('添加收藏成功');
                    }else{
                        icon.removeClass('fa-star').addClass('fa-star-o');
                        layer.msg('取消收藏成功');
                    }
                }
            },'JSON');
        });

        // 自适应
        $(window).on('resize', function() {
            // 选项卡高度
            cardTitleHeight = $(document).find(".layui-tab[lay-filter='card'] ul.layui-tab-title").height();
            // 需要减去的高度
            height = $(window).height() - $('.layui-header').height() - cardTitleHeight;
            // 设置高度
            $(document).find(".layui-tab[lay-filter='card'] div.layui-tab-content").height( height - 2 );
        });

//        $(document).bind("contextmenu",function(e){
//            return false;
//        });

        lockScreen = function () {
            var html = '';
            html +='<section class="lock-screen">';
            html +='    <div class="lock"></div>';
            html +='    <div class="screen">';
            html +='        <input name="" type="text" placeholder="请输入解锁密码" class="locksrk"><input type="button" value="解锁" class="lockbtn">';
            html +='    </div>';
            html +='</section>';
            layer.open({
                type: 1,
                title: false,
                closeBtn: 0,
                shadeClose: true,
                content: html
            });
            return;
            //阻止F5或者鼠标右键刷新,使锁屏失效。
            document.onkeydown = function(){
                //屏蔽 Alt+ 方向键 ←
                //屏蔽 Alt+ 方向键 →
                if ((event.altKey)&&((event.keyCode==37)||(event.keyCode==39))){
                    event.returnValue=false;
                    return false;
                }
                //禁止空格键翻页
                if(event.keyCode==32){
                    return false;
                }

                //屏蔽退格删除键
                if(event.keyCode==8){
                    return false;
                }

                //屏蔽F5刷新键
                if(event.keyCode==116){
                    return false;
                }
                //屏蔽alt+R
                if((event.ctrlKey) && (event.keyCode==82)){
                    return false;
                }
                //屏蔽F11
                if (event.keyCode == 122) {
                    event.keyCode = 0;
                    event.returnValue = false;
                }
                //屏蔽     Ctrl+n
                if (event.ctrlKey && event.keyCode == 78){
                    event.returnValue = false;
                }
                //屏蔽     shift+F10
                if (event.shiftKey && event.keyCode == 121){
                    event.returnValue = false;
                }
                //屏蔽     shift     加鼠标左键新开一网页
                if (window.event.srcElement.tagName == "A" && window.event.shiftKey) {
                    window.event.returnValue = false;
                }
                if(window.event.keyCode == 115 || window.event.keyCode == 117){
                    return false;
                }
                //屏蔽Alt+F4
                if ((window.event.altKey) && (window.event.keyCode == 115))
                {
                    window.showModelessDialog("about:blank", "", "dialogWidth:1px;dialogheight:1px");
                    return false;
                }
            }

            document.oncontextmenu = function() {event.returnValue = false;}
            layer.open({
                type: 2,
                title: bt.lang('common.button.lockScreen'),
                area: ['280px', '150px'],
                closeBtn: 0,
                content: basePath + "/sys/user/lockScreen?id=" + loginName,
                end: function () {
                    document.onkeydown = function(){

                    }

                }
            });
        }
    });
</script>
</body>
</html>
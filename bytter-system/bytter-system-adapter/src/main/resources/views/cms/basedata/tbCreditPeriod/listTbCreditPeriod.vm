<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
<input type="hidden" id="pageType" value="$!{pageType}">
		<table class="layui-table">
		<tr>
			<td width="20%" class="textRight">#springMessage('table.tbCreditPeriod.code')</td>
			<td width="30%">
				<input type="text" name="likes_code"
		                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.tbCreditPeriod.code')">
			</td>
			#*<td width="20%" class="textRight">#springMessage('table.tbCreditPeriod.currencytype')</td>
			<td width="30%">
			<div class="bt-biz-dict" data-type="select" data-group="cms.creditPeriod.moneyType" data-defaultvalue="" data-name="eqi_moneyType" data-biz-name="eqi_moneyType"></div>
			</td>*#
		</tr>
		<tr>
			<td colspan="4" align="center">
				<button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
				<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
			</td>
		</tr>
		</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.tbCreditPeriod.code')</th>
        <th>#springMessage('table.tbCreditPeriod.designation')</th>
        <th>#springMessage('table.tbCreditPeriod.period')</th>
        <th>#springMessage('table.cmsLoanInfo.loanClass')</th>
        #*<th>#springMessage('table.tbCreditPeriod.currencytype')</th>*#
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/basedata/tbCreditPeriod/tbCreditPeriod.list.js?_btv=${resourceVersion}"></script>
</html>

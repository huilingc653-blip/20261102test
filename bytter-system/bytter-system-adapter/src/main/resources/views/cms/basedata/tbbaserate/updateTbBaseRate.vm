<!DOCTYPE html>
<html lang="en">
<head>
#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	<input id="id" name="id" type="hidden" value="$!{tbBaseRatePage.id}">
	<table class="layui-table">
		<tbody>
			<tr>
				##编码
				<td class="textRight">#springMessage('table.tbBaseRate.code')</td>
				<td width="40%">
				<!--number-->

					<input type="text" id="code" name="code" lay-verify="required" autocomplete="off" class="layui-input" placeholder="#springMessage('table.tbBaseRate.code')" value="$!{tbBaseRatePage.code}">
				</td>
				##基准类型名称
				<td class="textRight">#springMessage('table.tbBaseRate.Interest.rate.type.name')</td>
				<td width="40%">
					<!--number-->
					<input type="text" id="baseTypeName" name="baseTypeName" autocomplete="off" class="layui-input" placeholder="#springMessage('table.tbBaseRate.Interest.rate.type.name')" value="$!{tbBaseRatePage.baseTypeName}" lay-verify="required">
				</td>
			</tr>
			<tr>
				##是否人民币利率
				<td class="textRight">#springMessage('table.tbBaseRate.isRmb')</td>
				<td>
					$dictTag.get("sf_yn",$!{tbBaseRatePage.isBankBaseRate})
##					<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{tbBaseRatePage.isBankBaseRate}" data-name="isBankBaseRate" data-biz-name="isBankBaseRate"  data-required="true"></div>
					#*#if($!{tbBaseRatePage.isBankBaseRate} == "1")
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="isBankBaseRate" data-biz-name="isBankBaseRate"   data-disabledValue = "0"  data-required="true">
					#elseif($!{isBankBaseRateExist})
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isBankBaseRate" data-biz-name="isBankBaseRate"   data-disabledValue = "1"  data-required="true">
					#else
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isBankBaseRate" data-biz-name="isBankBaseRate"  data-required="true"></div>
					#end*#
				</td>
				##生效日期
				<td class="textRight">#springMessage('table.tbBaseRate.timeoftakeeffect')</td>
				<td >
					<input type="text" id="tempTimeOfTakeEffect" name="timeOfTakeEffect" class="layui-input bt-biz-dateType" data-type="date" lay-verify="required"
						 data-biz-name="timeOfTakeEffect" value="$!{tbBaseRatePage.timeOfTakeEffect}">
				</td>
			</tr>
			<tr>
				##备注
				<td class="textRight">#springMessage('table.tbBaseRate.rmk')</td>
				<td >
					<!--number-->
					<input type="text" id="rmk" name="rmk" autocomplete="off" class="layui-input" placeholder="#springMessage('table.tbBaseRate.rmk')" value="$!{tbBaseRatePage.rmk}">
				</td>
				<td></td>
				<td></td>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
		</tbody>
	</table>
</form>
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','layedit','btdate','dicts','dateType'], function(){
    var $ = bt.jquery,form = bt.form();
    var dicts = bt.dicts.init();
   	var dateType =  bt.dateType.init();
   	dateType.get("timeOfTakeEffect").val($("#tempTimeOfTakeEffect").val());
    //时间
    $.each($("div[type='date']"),function(i,item){
        bt.btdate.init({
            elem: "[field='"+$(item).attr("field")+"']",
            name: $(item).attr("field"),
            placeholder: $(item).attr("defaultVal"),
            format: "YYYY-MM-DD",
            istime: false
        });
    });
    $.each($("div[type='datetime']"),function(i,item){
        bt.btdate.init({
            elem: "[field='"+$(item).attr("field")+"']",
            name: $(item).attr("field"),
            placeholder: $(item).attr("defaultVal"),
            format: "YYYY-MM-DD hh:mm:ss",
            istime: true
        });
    });

    EditCode();

    //监听提交
    form.on('submit(submit)', function(data){
        var action = "/rate/tbbaserate/modify";
        $.post(basePath + action,data.field,function(result){
            parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            if(bt.navtab && result.success){
    			bt.navtab.closeCurrent();
            }
        },'JSON');
        return false;
    });
});

function EditCode(){
    var code = $("#code").val();
    if(code == "lpr"){
        $("#code").attr("disabled",true);
	}
}
</script>
</html>

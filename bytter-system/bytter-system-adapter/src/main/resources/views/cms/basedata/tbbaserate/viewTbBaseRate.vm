<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form">
	<table id="appTable" class="layui-table layui-form" style="width:100%;">
		<tbody>
        	<tr>
	        	##编码
	            <td class="textRight">#springMessage('table.tbBaseRate.code')</td>
	            <td width="40%">
                	$!{tbBaseRatePage.code}
	            </td>
	            ##基准类型名称
	            <td class="textRight">#springMessage('table.tbBaseRate.Interest.rate.type.name')</td>
				<td>
					$!{tbBaseRatePage.baseTypeName}
            	</td>
            </tr>
            <tr>
	        	##是否人民币利率
	            <td class="textRight">#springMessage('table.tbBaseRate.isRmb')</td>
	            <td width="40%">
					$dictTag.get("sf_yn",$!{tbBaseRatePage.isBankBaseRate})
	            </td>
	            ##生效日期
	            <td class="textRight">#springMessage('table.tbBaseRate.isbankbaserate')</td>
				<td>
					$!date.format('yyyy-MM-dd',$!{tbBaseRatePage.timeOfTakeEffect})
            	</td>
            </tr>
             <tr>
	        	##备注
	            <td class="textRight">#springMessage('table.tbBaseRate.rmk')</td>
	            <td width="40%">
                	$!{tbBaseRatePage.rmk}
	            </td>
				 <td></td>
				 <td></td>
            </tr>
		</tbody>
	</table>
</form>
#parse("views/common/footer.vm")
</body>
</html>

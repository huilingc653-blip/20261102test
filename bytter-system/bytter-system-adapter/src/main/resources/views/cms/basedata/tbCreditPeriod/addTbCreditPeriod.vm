<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{tbCreditPeriodPage.id}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##编码
				<td class="textRight">#springMessage('table.tbCreditPeriod.code')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="code" name="code" lay-verify="required|strlength" data-maxlength="30"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.tbCreditPeriod.code')">
										</td>
        		##名称
				<td class="textRight">#springMessage('table.tbCreditPeriod.designation')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="periodName" name="periodName" lay-verify="required|strlength" data-maxlength="100"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.tbCreditPeriod.designation')">
										</td>
			</tr>
        	<tr>
        		##期限
				<td class="textRight">#springMessage('table.tbCreditPeriod.period')</td>
				<td >
					<input data-name="period" class="layui-input bt-biz-moneyType" data-decimal="0" data-max="99" lay-verify="required|strlength" data-maxlength="4" data-biz-name="period" data-callback="setloanClass"/>
				</td>
        		##周期类型
				<td class="textRight">#springMessage('table.tbCreditPeriod.cycletype')</td>
				<td >
					<div class="bt-biz-dict" data-type="select" data-group="cms.periodCycle" data-defaultvalue="1" data-name="periodCycle" data-biz-name="periodCycle" data-required="true" data-callback="setloanClass"></div>
				</td>
			</tr>
        	<tr>
        		##货币类型
				#*<td class="textRight">#springMessage('table.tbCreditPeriod.currencytype')</td>
				<td >
				<div class="bt-biz-dict" data-type="select" data-group="cms.creditPeriod.moneyType" data-defaultvalue="1" data-name="moneyType" data-biz-name="moneyType"></div>
				</td>*#
				##贷款种类
				<td class="textRight">#springMessage('table.cmsLoanInfo.loanClass')</td>
				<td>
					<div class="bt-biz-dict" data-type="select" data-group="cms.LoanClass" data-defaultvalue="01" data-name="loanClass" data-biz-name="loanClass" data-disabled="true"></div>
				</td>
			</tr>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/cms/basedata/tbCreditPeriod/tbCreditPeriod.add.js?_btv=${resourceVersion}"></script>
</html>
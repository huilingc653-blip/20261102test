<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
    <style>
        .biz-period {
            text-align: left!important;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post">
    <input id="interestRateType" name="interestRateType" type="hidden" value="1">
    <table class="layui-table">
        <tbody>
        <tr>
		## 类型编码
            <td class="textRight">#springMessage('table.depositRateType.code')</td>
            <td width="40%">
                <!--number-->
                <input type="text" id="code" name="code" lay-verify="required|strlength" data-maxlength="30"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.depositRateType.code')">
            </td>
		##类型名称
            <td class="textRight">#springMessage('table.depositRateType.name')</td>
            <td width="40%">
                <!--number-->
                <input type="text" id="name" name="name" lay-verify="required|strlength" data-maxlength="100"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.depositRateType.name')">
            </td>
        </tr>
        <tr>
		##存款类型
            <td class="textRight">#springMessage('table.depositRateType.depositType')</td>
            <td >
                <div class="bt-biz-dict" data-type="select" data-group="pricing.deposit.type" data-defaultvalue="" data-name="depositClass" data-biz-name="depositClass" data-required="true" data-callback="setShowTd"></div>
            </td>
		##期限
            <td class="textRight periodShow" style="display: none">#springMessage('table.depositRateType.period')</td>
            <td class="periodShow" style="display: none">
                <div class="layui-inline">
                    <input id="period" data-name="period" class="layui-input bt-biz-moneyType biz-period" data-decimal="0" data-max="99"  data-maxlength="4" data-biz-name="period" style="text-align: left;" />
                </div>
			##期限单位
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="pricing.fixedTerm" data-defaultvalue="1" data-name="periodCycle" data-biz-name="periodCycle"  ></div>
                </div>
            </td>
		##通知类型
            <td class="textRight noticeShow" style="display: none">#springMessage('table.depositRateType.noticeType')</td>
            <td class="noticeShow" style="display: none">
                <div class="bt-biz-dict" data-type="select" data-group="pricing.noticeType" data-defaultvalue="" data-name="noticeType" data-biz-name="noticeType" ></div>
            </td>
        </tr>
        <tr>
            ##存款账户标识
            <td class="textRight">#springMessage('table.depositRateType.depAccSign')</td>
            <td width="40%">
                <div class="bt-biz-dict" data-type="select" data-group="pricing.depAccSign" data-defaultvalue="" data-name="depositAccSign" data-biz-name="depositAccSign"  data-required="true"></div>
            </td>
        </tr>
		##备注
        <tr>
            <td class="textRight">#springMessage('table.depositRateType.remark')</td>
            <td colspan="3">
                <textarea type="text" id="remark" name="remark" class="layui-textarea" placeholder="#springMessage('table.depositRateType.remark')"></textarea>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button class="layui-btn" lay-submit="" onClick="closecurrent()">#springMessage('common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/pricing/depositRateType.add.js?_btv=${resourceVersion}"></script>
</html>

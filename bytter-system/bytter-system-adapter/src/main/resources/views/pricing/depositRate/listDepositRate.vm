<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
<input type="hidden" id="pageType" value="$!{pageType}">
	<input type="hidden" name="eqi_interestRateType" value="1">
		<table class="layui-table">
            <tr>
                <td width="15%" class="textRight">#springMessage('table.depositRateType.code')</td>## 类型编码
                <td>
                    <input type="text" name="likes_rateTypeCode"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.depositRateType.code')">
                </td>
                <td width="15%" class="textRight">#springMessage('table.depositRateType.name')</td>##类型名称
                <td>
                    <input type="text" name="likes_rateTypeName"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.depositRateType.name')">
                </td>
                <td width="15%" class="textRight">#springMessage('table.depositRateType.depositType')</td>##存款种类
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="pricing.deposit.type" data-defaultvalue=""
                         data-name="eqs_depositClass" data-biz-name="eqs_depositClass"></div>
                </td>
            </tr>
            <tr>
				<td width="15%" class="textRight">#springMessage('table.depositRate.curCode')</td>##币别
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                             data-name="eqs_moneyType" data-valueField="id" data-textField="curName"></div>
                    </div>
                </td>
                <td width="15%" class="textRight">#springMessage('table.depositRate.timeOfTakeEffect')</td>##生效日期
                <td>
                    <div class="layui-inline">
                        <input type="text" name="ged_timeOfTakeEffect" data-name="ged_timeOfTakeEffect"
                        class="layui-input bt-biz-dateType" data-endid="endDate" data-type="date">
                    </div>
                    <span class="date-mid">#springMessage('table.depositRate.range')</span>
                    <div class="layui-inline">
                        <input type="text" name="led_timeOfTakeEffect" data-name="led_timeOfTakeEffect"
                        class="layui-input bt-biz-dateType" id="endDate" data-type="date">
                    </div>
                </td>
                <td width="15%" class="textRight">#springMessage('common.table.status')</td>##状态
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-type="select" data-group="depositRate.status" data-defaulltvalue=""
                        data-name="eqi_status" data-biz-name="eqi_status"></div>
                    </div>
                </td>
            </tr>
		<tr>
			<td colspan="6" align="center">
				<button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
				<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
			</td>
		</tr>
		</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.depositRateType.code')</th>##类型编码
        <th>#springMessage('table.depositRateType.name')</th>##类型名称
        <th>#springMessage('table.depositRateType.depositType')</th>##存款种类
        <th>#springMessage('table.depositRateType.depAccSign')</th>##存款账户标识
        <th>#springMessage('table.depositRate.curCode')</th>##币别
        <th>#springMessage('table.depositRate.timeOfTakeEffect')</th>##生效日期
        <th>#springMessage('table.depositRate.referenceRate')/#springMessage('table.depositRate.baseRate')</th>##基准利率/基础利率
        <th>#springMessage('table.depositRate.interestRate')</th>##利率
        <th>#springMessage('table.LoanRate.Upper.limit.of.floating.range')</th>##浮动范围上限
        <th>#springMessage('table.LoanRate.Lower.limit.of.floating.range')</th>##浮动范围下限
        <th>#springMessage('common.table.status')</th>##状态
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/pricing/depositRate.list.js?_btv=${resourceVersion}"></script>
</html>

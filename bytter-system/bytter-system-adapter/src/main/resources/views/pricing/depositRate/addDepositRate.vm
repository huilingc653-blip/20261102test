<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="depositRateType" name="depositRateType" value="">
    <table class="layui-table">
        <tbody>
        <tr>
		## 类型编码
            <td class="textRight">#springMessage('table.depositRateType.code')</td>
            <td width="35%">
                <div class=layui-inline>
                    <div class=bt-biz-selectType
                         data-name="rateTypeCode"
                         data-textField="name"
                         data-valueField="code"
                         data-biz-name="rateTypeCode"
                         data-url="${basePath}/pricing/depositRateType/interestRateType/getDepositRateType"
                         data-callback="codeChange"
                         data-search="true"
                         data-required="true"
                         data-beforeInitResiveData="rateTypeBefore"></div>
                </div>
            </td>
		##类型名称
            <td class="textRight">#springMessage('table.depositRateType.name')</td>
            <td>
                <input type="text" id="rateTypeName" name="rateTypeName" lay-verify="required|strlength" data-maxlength="100" readonly="readonly"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.depositRateType.name')">
            </td>
        </tr>
        <tr>
		##存款类型
            <td class="textRight">#springMessage('table.depositRateType.depositType')</td>
            <td width="35%">
                <input type="hidden" name="depositClass" id="depositClass">
                <input type="text" id="depositClassName" lay-verify="required|strlength" data-maxlength="100" readonly="readonly"
                autocomplete="off" class="layui-input" placeholder="#springMessage('table.depositRateType.depositType')">
            </td>
            <td class="textRight">#springMessage('table.depositRate.curCode')</td>##币别
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name="moneyType" data-valueField="id" data-textField="curName" data-required="true"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##生效日期
            <td class="textRight">#springMessage('table.depositRate.timeOfTakeEffect')</td>
            <td>
                <input type="text" class="layui-input bt-biz-dateType" name="timeOfTakeEffect" data-name="timeOfTakeEffect"  data-biz-name="timeOfTakeEffect" data-type="date" lay-verify="required">
            </td>
        ##存款账户标识
            <td class="textRight">#springMessage('table.depositRateType.depAccSign')</td>
            <td>
                <input type="text" class="layui-input" id="depositAccSign" lay-verify="required" readonly="readonly">
            </td>
        </tr>
        <tr class="HqRateShow" style="display: none">
            ##基准利率/基础利率
            <td class="textRight">#springMessage('table.depositRate.referenceRate')/#springMessage('table.depositRate.baseRate')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="radio" data-biz-name="referenceRateType" data-required="true"
                         data-group="reference.RateType" data-name="referenceRateType" data-defaultvalue="0" data-callback="setRatShow"></div>
                </div>
            </td>
            ##基准利率
                <td class="textRight rateShow1">#springMessage('table.depositRate.referenceRate')</td>
                <td class="rateShow1">
                    <input type="text" class="layui-input bt-biz-rateType" name="referenceRate" lay-verify="required" id="rateShow1">
                </td>
            ##基础利率
                <td class="textRight rateShow2" style="display: none"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.depositRate.baseRate')</td>
                <td class="rateShow2" style="display: none">
                    <input type="text" class="layui-input bt-biz-rateType" name="baseRate" id="rateShow2" >
                </td>
        </tr>
        <tr class="HqRateShow floatRateShow" style="display: none">
        </tr>
        <tr class="rateShow" style="display: none">
        ##利率
            <td class="textRight">#springMessage('table.depositRate.interestRate')</td>
            <td>
                <input type="text" class="layui-input bt-biz-rateType" name="rate" lay-verify="required" >
            </td>
            <td></td>
            <td></td>
        </tr>

		##备注
        <tr>
            <td class="textRight">#springMessage('table.depositRateType.remark')</td>
            <td colspan="3">
                <textarea type="text" id="remark" name="remark" class="layui-textarea" placeholder="#springMessage('table.depositRateType.remark')"></textarea>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="1">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" lay-filter="temp" value="0">#springMessage('common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button class="layui-btn" lay-submit="" onClick="closecurrent()">#springMessage('common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/pricing/depositRate.add.js?_btv=${resourceVersion}"></script>
</html>

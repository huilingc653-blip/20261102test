<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
<input type="hidden" id="pageType" value="$!{pageType}">
	<input type="hidden" name="eqi_interestRateType" value="1">
		<table class="layui-table">
		<tr>
			<td width="15%" class="textRight">#springMessage('table.depositRateType.code')</td>
			<td >
				<input type="text" name="likes_code"
		               autocomplete="off" class="layui-input" placeholder="#springMessage('table.depositRateType.code')">
			</td>
            <td width="15%" class="textRight">#springMessage('table.depositRateType.name')</td>
            <td >
                <input type="text" name="likes_name"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.depositRateType.name')">
            </td>
			<td width="15%" class="textRight">#springMessage('table.depositRateType.depositType')</td>
			<td >
			<div class="bt-biz-dict" data-type="select" data-group="pricing.deposit.type" data-defaultvalue="" data-name="eqs_depositClass" data-biz-name="eqs_depositClass"></div>
			</td>
		</tr>
		<tr>
			<td colspan="6" align="center">
				<button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
				<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
			</td>
		</tr>
		</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.depositRateType.code')</th>## 类型编码
        <th>#springMessage('table.depositRateType.name')</th>##类型名称
        <th>#springMessage('table.depositRateType.depositType')</th>##存款种类
        <th>#springMessage('table.depositRateType.fixedTerm')/#springMessage('table.depositRateType.noticeType')</th>
        <th>#springMessage('table.depositRateType.depAccSign')</th>##存款账户标识
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/pricing/depositRateType.list.js?_btv=${resourceVersion}"></script>
</html>

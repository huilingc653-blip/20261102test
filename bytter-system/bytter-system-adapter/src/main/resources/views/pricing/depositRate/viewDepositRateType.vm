<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<table class="layui-table dark-layui-table">
        <tr>
		## 类型编码
            <td class="textRight">#springMessage('table.depositRateType.code')</td>
            <td width="40%">$!{depositRateType.code}</td>
		##类型名称
            <td class="textRight">#springMessage('table.depositRateType.name')</td>
            <td width="40%">$!{depositRateType.name}</td>
        </tr>
        <tr>
		##存款类型
            <td class="textRight">#springMessage('table.depositRateType.depositType')</td>
            <td >$dictTag.get("pricing.deposit.type",$!{depositRateType.depositClass})</td>
			#if($!{depositRateType.depositClass}=="04")##活期
                <td></td>
                <td></td>
			#end
			#if($!{depositRateType.depositClass}=="05")##定期
			##期限
                <td class="textRight periodShow" >#springMessage('table.depositRateType.period')</td>
                <td class="periodShow" >
                    <div class="layui-inline">
						$!{depositRateType.period}
                    </div>
				##期限单位
                    <div class="layui-inline">
						$dictTag.get("pricing.fixedTerm",$!{depositRateType.periodCycle})
                    </div>
                </td>
			#end
			#if($!{depositRateType.depositClass}=="06")##通知
			##通知类型
                <td class="textRight noticeShow" >#springMessage('table.depositRateType.noticeType')</td>
                <td class="noticeShow" >
					$dictTag.get("pricing.noticeType",$!{depositRateType.period})
                </td>
			#end
        </tr>
        <tr>
        ##存款账户标识
            <td class="textRight">#springMessage('table.depositRateType.depAccSign')</td>
            <td width="40%" colspan="3">
                #if($!{depositRateType.depositAccSign})
                     $dictTag.get("pricing.depAccSign",$!{depositRateType.depositAccSign})
                     #else
                    $dictTag.get("pricing.depAccSign",2)##为空时默认为资金池内部账户
                #end
            </td>
        </tr>
	##备注
        <tr>
            <td class="textRight">#springMessage('table.depositRateType.remark')</td>
            <td colspan="3">
                $!{depositRateType.remark}
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" type="button" onClick="closecurrent()">#springMessage('common.button.close')</button>
            </td>
        </tr>
	</table>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    function closecurrent(){
        parent.layer?parent.layer.closeAll():layer.closeAll();
        return false;
    }
</script>
</html>
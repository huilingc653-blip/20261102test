<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="interestRateType" name="interestRateType" type="hidden" value="1">
    <input name="id" type="hidden" value="$!{depositRateType.id}">
    <input name="depositClass" type="hidden" value="$!{depositRateType.depositClass}">
    <input name="periodCycle" type="hidden" value="$!{depositRateType.periodCycle}">
    <input name="noticeType" type="hidden" value="$!{depositRateType.period}">
    <table class="layui-table">
        <tbody>
        <tr>
        ## 类型编码
            <td class="textRight">#springMessage('table.depositRateType.code')</td>
            <td width="40%">
                <!--number-->
                <input type="text" id="code" name="code" lay-verify="required|strlength" data-maxlength="30" value="$!{depositRateType.code}"
                       autocomplete="off" class="layui-input" readonly="readonly" placeholder="#springMessage('table.depositRateType.code')">
            </td>
        ##类型名称
            <td class="textRight">#springMessage('table.depositRateType.name')</td>
            <td width="40%">
                <!--number-->
                <input type="text" id="name" name="name" lay-verify="required|strlength" data-maxlength="100" value="$!{depositRateType.name}"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.depositRateType.name')">
            </td>
        </tr>
        <tr>
        ##存款类型
            <td class="textRight">#springMessage('table.depositRateType.depositType')</td>
            <td >
                <input type="text" class="layui-input" lay-verify="required"  value="$dictTag.get("pricing.deposit.type",$!{depositRateType.depositClass})" readonly="readonly"/>
            </td>
            #if($!{depositRateType.depositClass}=="04")##活期
                <td></td>
                <td></td>
            #end
            #if($!{depositRateType.depositClass}=="05")##定期
            ##期限
                <td class="textRight periodShow" >#springMessage('table.depositRateType.period')</td>
                <td class="periodShow" >
                    <div class="layui-inline">
                        <input id="period" data-name="period" class="layui-input bt-biz-moneyType" data-decimal="0" data-max="99"  data-maxlength="4" data-biz-name="period" value="$!{depositRateType.period}" readonly="readonly"/>
                    </div>
                ##期限单位
                    <div class="layui-inline">
                        <input type="text"  class="layui-input" lay-verify="required"  value="$dictTag.get("pricing.fixedTerm",$!{depositRateType.periodCycle})" readonly="readonly"/>
                    </div>
                </td>
            #end
            #if($!{depositRateType.depositClass}=="06")##通知
            ##通知类型
                <td class="textRight noticeShow" >#springMessage('table.depositRateType.noticeType')</td>
                <td class="noticeShow" >
                    <input type="text" class="layui-input"  lay-verify="required"  value="$dictTag.get("pricing.noticeType",$!{depositRateType.period})" readonly="readonly"/>
                </td>
            #end
        </tr>
        <tr>
        ##存款账户标识
            <td class="textRight">#springMessage('table.depositRateType.depAccSign')</td>
            <td width="40%">
                #if($!{depositRateType.depositAccSign})
                    #set($depositAccSign=$!{depositRateType.depositAccSign})
                #else
                    #set($depositAccSign=2)
                #end
                <div class="bt-biz-dict" data-type="select" data-group="pricing.depAccSign" data-defaultvalue="$!{depositAccSign}" data-name="depositAccSign" data-biz-name="depositAccSign"  data-required="true"></div>
            </td>
        </tr>
        ##备注
        <tr>
            <td class="textRight">#springMessage('table.depositRateType.remark')</td>
            <td colspan="3">
                <textarea type="text" id="remark" name="remark" class="layui-textarea" placeholder="#springMessage('table.depositRateType.remark')">$!{depositRateType.remark}</textarea>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button class="layui-btn" lay-submit="" onClick="closecurrent()">#springMessage('common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/pricing/depositRateType.edit.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html>
<head>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <meta charset="UTF-8">
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>$!{companyName}--$springMacroRequestContext.contextPath</title>
    <script>
        var basePath = "${basePath}";
        if(top.location != this.location){top.location.replace(basePath+'/');}
    </script>
    ##<link rel="shortcut icon" href="${basePath}/static/images/favicon.ico" type="image/x-icon"/>
    <link rel="stylesheet" href="${basePath}/static/plugins/layui/css/layui.css">
    <link rel="stylesheet" href="${basePath}/static/v3.2/css/globel.css?_btv=${resourceVersion}">
    <link rel="stylesheet"
          href="${basePath}/static/v3.2/fonts/fonts/iconfont.css?_btv=${resourceVersion}"
          media="all">
    <link rel="stylesheet" href="${basePath}/static/css/login.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="${basePath}/static/v3.2/css/login.css?_btv=${resourceVersion}">
    <!--[if lt IE 9]>
    <script src="${basePath}/static/plugins/mq/html5.min.js"></script>
    <script src="${basePath}/static/plugins/mq/respond.min.js"></script>

    <![endif]-->
    <style>
    	.small-text {
    		font-size: 12px;
		}
		.medium-text {
		    font-size: 18px;
		}
		.large-text {
		    font-size: 24px;
		}
        .password-content input {
            color: #303343!important;
            border: 1px solid #fff;
        }
        ::-webkit-input-placeholder { /* WebKit, Blink, Edge */
            color: #9497AC; }

        :-moz-placeholder { /* Mozilla Firefox 4 to 18 */
            color: #9497AC;}

        ::-moz-placeholder { /* Mozilla Firefox 19+ */
            color: #9497AC; }

        :-ms-input-placeholder { /* Internet Explorer 10-11 */
            color: #9497AC; }
        .text-center {
            text-align: center;
        }
    </style>
</head>
<body>
<div class="layui-layer-shade" id="layui-layer-shade1" times="1" style="z-index: 19891014; background-color: rgb(255, 255, 255); opacity: 0.3;"></div>
<div class="layui-layer layui-layer-loading" id="layui-layer1" type="loading" times="1" showtime="0" contype="string" style="z-index: 19891015; top: 450px; left: 564.5px;"><div id="" class="layui-layer-content layui-layer-loading1"></div><span class="layui-layer-setwin"></span></div>
<div class="layout-wrapper">

    #if($i18nEnable=="1")
    <div class="layui-container">
    </div>
    #end
    <div id="login-wrapper">
        <div class="content">
            <div class="login-logo">
                <img src="${basePath}/static/v3.2/images/login/login_logo.png"  alt srcset>
            </div>
            <div class="title" id="loginName">
           
            </div>
            <div class="content-form">
                <form class="layui-form" method="post" autocomplete="off">
                   
                    <div class="password-content" id="">
                   			<font class="large-text">证书已到期 ,请联系供应商!</font>     
                    </div>
                    
                </form>
            </div>
           
        </div>
    </div>
</div>
<script type="text/javascript" src="${basePath}/static/plugins/jquery/jquery.min.js" charset="utf-8"></script>
<script type="text/javascript" src="${basePath}/static/plugins/jquery/jquery.ajax.extend.js?_btv=${resourceVersion}"></script>
<script type="text/javascript" src="${basePath}/static/plugins/layui/layui.js" charset="utf-8"></script>
##<script type="text/javascript" src="${basePath}/static/js/jquery3.4.1.min.js" charset="utf-8"></script>
##<script type="text/javascript" src="${basePath}/static/plugins/jquery/jquery.min.js?_btv=${resourceVersion}"></script>
</body>
</html>

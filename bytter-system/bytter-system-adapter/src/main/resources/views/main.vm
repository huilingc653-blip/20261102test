        <script>
            // 绘制重要通知内容或资金政策法规
            /* 格式要求
            * <div>
                   <span class="iconfont bynotice_a"></span>
                   <span class="text">你有8笔网银U-key即将到期。</span>
                    <span class="date">2022-05-27</span>
               </div>
            * */
            function renderArticleDataSimple(list,containerId,iconClass){
                var html = '';
                if(list){
                    for (var i = 0; i < list.length; i++) {
                        var data = list[i];
                        var readSign = data.readSign;
                        html += '<div data-id="'+data.id+'" class="item">'
                        html += '<span class="iconfont '+ iconClass +'"></span>'
                        if ("0" == readSign) {
                            html += '<span class="text">'+ data.title + ' &nbsp;&nbsp;&nbsp;&nbsp;[' + bt.lang('sys.userMessage.unread') + ']'+ '</span>'
                        } else {
                            html += '<span class="text">'+ data.title + ' &nbsp;&nbsp;&nbsp;&nbsp;[' + bt.lang('sys.userMessage.read') + ']'+ '</span>'
                        }
                        var itemDate = data.updateDate ? data.updateDate:data.createDate
                        html += '<span class="date">'+ itemDate.substring(0,10) +'</span>'
                        html += '</div>'
                    }
                }else {
                    html += '<div class="article-empty"><img src="'+ basePath +'/static/v3.2/images/pic_blank.png"><div class="empty-text">'+bt.lang('common.msg.temporarily_no_data')+'</div></div>'
                }
                $(containerId).html(html)
            }

            bt.use(['laypage', 'layer','form','element','jquery'], function(){
                var form = layui.form();
                var element = layui.element();
                var laypage = layui.laypage;

                var fetchArticleData = function(params){
                    params.formdata.home = 1;
                    if(typeof params.start==="undefined"){
                        params.start = 0;
                    }
                    if(typeof params.length==="undefined"){
                        params.length = 10;
                    }
                    if(typeof params.search==="undefined"){
                        params.search = null;
                    }
                    if(typeof params.order==="undefined"){
                        params.order = [];
                    }
                    if(typeof params.columns==="undefined"){
                        params.columns = [];
                    }
                    if(typeof params.formdata==="undefined"){
                        params.formdata = {};
                    }
                    if(typeof params.draw==="undefined"){
                        params.draw = 0;
                    }else{
                        params.draw++;
                    }
                    $.ajax({
                        type: "POST",
                        url: basePath + "/sys/article/list",
                        contentType: "application/json",
                        data: JSON.stringify(params),
                        dataType: 'json',
                        success: function (dataList) {
                            renderArticleTable(dataList.data);
                            initArticlePage(params,dataList);
                        }
                    });

                };
                var initArticlePage = function(params,dataList){
                    if(!dataList.data){
                        return;
                    }
                    laypage({
                        cont:'article-page', first:false, pages: Math.ceil(dataList.recordsTotal/params.length), curr:Math.floor(params.start/params.length)+1, prev: '<em><</em>', next: '<em>></em>',
                        jump: function(obj, first){
                            if(first){return;}
                            params.start = (obj.curr-1)*params.length;
                            fetchArticleData(params);
                        }
                    });
                };
                var renderArticleTable = function(dataList){
                    if(!dataList||dataList.length==0){
                        return;
                    }
                    var html = '';
                    for(var i=0;i<dataList.length;i++){
                        var data = dataList[i];
                        html += '<tr data-id="'+data.id+'">'+
                                '<td><a class="article-view" href="javascript:void(0)">'+data.title+'</a></td>' +
                                '<td>'+data.createByUserName+'</td>'+
                                '<td>'+data.updateDate+'</td>'+
                                '<td><a href="javascript:void(0)" class="article-view">'+bt.lang("common.button.view")+'</a></td></tr>';
                    }
                    $('.more-article-container table tbody').html(html);
                };
                $('.notice-more,.law-more').click(function(){
                    var type = $(this).parents('.tab-item-container').attr('class').indexOf('notice-container')!=-1?1:2;
                    fetchArticleData({formdata:{type:type}});
                    $('.notice-container,.law-container,.message-container').hide();
                    $('.more-article-container').find(".more-title").text($(this).parents('.tab-content-header').text().trim());
                    $('.more-article-container').show();
                });
                $('.article-back').click(function(){
                    $('.more-article-container').hide();
                    $('.more-article-container table tbody').html('');
                    $('.notice-container,.law-container,.message-container').show();
                });

                // $('.notice-container,.law-container').on('click','.item',function(){
                //     layer.open({type: 2, area: ['850px', '530px'], content: basePath +'/sys/article/view?id='+$(this).data('id')});
                // });
                $('.info-list-wrapper').on('click','.item',function(){
                    layer.open({type: 2, area: ['850px', '530px'], content: basePath +'/sys/article/view?id='+$(this).data('id')+'&flag=1'});
                    window.setTimeout(initHomeArticle, 2000);
                });
                $('.more-article-container').on('click','.article-view,.article-top',function(){
                    var action = $(this).attr('class');
                    var id = $(this).parents('tr').data('id');
                    if(action==="article-view"){
                        layer.open({type: 2, area: ['850px', '530px'], content: basePath +'/sys/article/view?id='+id+'&flag=1'});
                        window.setTimeout(initHomeArticle, 2000);
                    }else{
                        layer.confirm(bt.lang("common.message.confirm.delete"),{icon: 7},function(){
                            //console.log("delete");
                        })
                    }
                });
                //
                /**
                 *  加载重要通知内容和资金政策法规
                 *  @param type 加载数据类型
                 *    无时，加载重要通知内容和资金政策法规
                 *    law 时，只加载资金政策法规
                 * */
                var renderTypeObj = {
                    notice:{
                        id: '#noticeContainer',
                        icon: 'bynotice_a'
                    },
                    law:{
                        id: '#lawContainer',
                        icon: 'bynotice_b'
                    }
                }
                var initHomeArticle = function (type) {
                    $.ajax({
                        type: "GET",
                        url: basePath + "/sys/article/homeData",
                        dataType: 'json',
                        success: function (dataList) {
                            if(type){
                                renderArticleDataSimple(dataList[type],renderTypeObj[type].id, renderTypeObj[type].icon);
                            }else{
                                renderArticleDataSimple(dataList['notice'],"#noticeContainer", 'bynotice_a');
                                renderArticleDataSimple(dataList['law'],"#lawContainer", 'bynotice_b');
                            }
                        }
                    });
                };

                // 刷新重要通知
                $('#refreshNoticeData').click(function () {
                    initHomeArticle('notice')
                })

                // 刷新资金政策法规数据
                $('#refreshLawData').click(function () {
                    initHomeArticle('law')
                })
                // 执行加载重要通知内容和资金政策法规
                initHomeArticle();

                ## ================消息公告开始 ================
                //用于记录删除时，刷新数据
                var currentParams={};
                var fetchMessageData = function(params){
                    $.ajax({
                        type: "GET",
                        url: basePath + "/sys/userMessage/list",
                        dataType: 'json',
                        contentType:"application/json",
                        data: params,
                        success: function (dataList) {
                            params.pages = dataList.totalPages;
                            params.curr = dataList.number+1;
                            renderMessageTable(dataList.content,params.type);
                            initMessagePage(params);
                            currentParams[params.type] = params;
                        }
                    });
                };
                var initMessagePage = function(params){
                    $('.message .'+params.type+' table').find('tr:eq(0) th:eq(0) input[type="checkbox"]').prop("checked", false);
                    laypage({
                        cont: params.type+'-page', first:false, pages: params.pages, curr:params.page||1, prev: '<em><</em>', next: '<em>></em>',
                        jump: function(obj, first){
                            if(first){return;}
                            params.page = obj.curr;
                            params.type = obj.cont.replace("-page","");
                            fetchMessageData(params,params.page);
                        }
                    });
                };
                var renderMessageTable = function(dataList,type){
                    var html = '';
                    if(dataList && dataList.length){
                        for(var i=0;i<dataList.length;i++){
                            var data = dataList[i];
                            html += '<tr data-id="'+data.id+'">\n'+
                                    '<td><input type="checkbox"/></td>\n'+
                                    '<td>'+data.title+'</td>\n' +
                                    '<td>'+data.context+'</td>\n'+
                                    '<td>'+data.createUserName+'</td>\n'+
                                    '<td>'+data.createDate+'</td>\n';
                            if("receive-message"===type){
                                html+='<td class="status"><span class="dot '+(data.status===0?"dot-unread":"dot-read")+'"></span>'+(data.status===0?bt.lang("sys.userMessage.unread"):bt.lang("sys.userMessage.read"))+'</td>\n';
                            }
                            html+= '<td><a href="javascript:void(0)" class="view">'+bt.lang("common.button.view")+'</a><a href="javascript:void(0)" class="delete">'+bt.lang("common.button.delete")+'</a></td></tr>';
                        }
                    }else{
                        html += '<tr class="message-empty"><td colspan="7"><div><img src="'+ basePath +'/static/v3.2/images/pic_blank.png"><div class="empty-text">'+bt.lang('common.msg.temporarily_no_data')+'</div></div></td></tr>'
                    }

                    $('.message-table .'+type+' table tbody').html(html);
                };

                $('.batch-delete,.tag-read').click(function(){
                    var checkboxs = $(this).parents('.message-container').find('.layui-show td input[type="checkbox"]');
                    var ids = [];
                    for(var i=0;i<checkboxs.length;i++){
                        var checkbox = $(checkboxs[i]);
                        if(checkbox.prop("checked")){
                            ids.push(checkbox.parents('tr').data('id'))
                        }
                    }
                    if(ids.length===0){
                        layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 7});
                        return;
                    }
                    var action = $(this).attr('class');
                    if(action.indexOf("batch-delete")>0){
                        layer.confirm(bt.lang("common.message.confirm.delete"),{icon: 7},function(){
                            deleteMessage(ids);
                        });
                    }else{
                        $.ajax({
                            type: "POST",
                            url: basePath + "/sys/userMessage/read",
                            data: {"ids":ids},
                            dataType: "json",
                            success: function (result) {
                                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                                fetchMessageData(currentParams["receive-message"]);
                            }
                        });
                    }
                });
                $('.send-btn').click(function(){
                    layer.open({
                        type: 2,
                        area: ['850px', '530px'],
                        content: basePath +'/sys/userMessage/sendView',
                        end:function(){
                            fetchMessageData({page:1,type:"send-message"});
                        }
                    });
                });
                ## 处理checkbox
                $('.message input.receive-message-select,.message input.send-message-select').click(function(){
                    var className = $(this).attr('class').replace("-select","");
                    $('.message .'+className+' td input[type="checkbox"]').prop("checked",$(this).prop("checked"));
                });
                $('.message table tbody').on('click','input[type="checkbox"]',function(){
                    var checkboxs = $(this).parents('table').find('td input[type="checkbox"]');
                    var flag = true;
                    for(var i=0;i<checkboxs.length;i++){
                        flag &= $(checkboxs[i]).prop("checked");
                    }
                    $(this).parents('table').find('tr:eq(0) th:eq(0) input[type="checkbox"]').prop("checked", flag);
                });
                $('.message table tbody').on('click','.view,.delete',function(){
                    var action = $(this).attr('class');
                    var id = $(this).parents('tr').data('id');
                    if(action==="view"){
                        layer.open({type: 2, area: ['850px', '530px'], content: basePath +'/sys/userMessage/view?messageId='+id, end:function(){
                                var currentType = $(".user-message-type.active").data("id");
                                fetchMessageData(currentParams[currentType]);
                            }});
                    }else{
                        layer.confirm(bt.lang("common.message.confirm.delete"),{icon: 7},function(){deleteMessage([id]);});
                    }
                });
                var deleteMessage = function(ids){
                    $.ajax({
                        type: "POST",
                        url: basePath + "/sys/userMessage/delete",
                        data: {"ids":ids},
                        dataType: "json",
                        success: function (result) {
                            parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                            var currentType = $(".user-message-type.active").data("id");
                            if(currentParams[currentType].page!==1 && ids.length===$('.message .'+currentType+' table tbody tr').length){
                                currentParams[currentType].page--;
                            }
                            fetchMessageData(currentParams[currentType]);
                        }
                    });
                };
                // 切换 我的收到信息 与 我发送的信息 表格
                $(".user-message-type").click(function () {
                    $('.user-message-type').removeClass('active');
                    $(this).addClass('active');
                    if($(this).data('id') === "send-message"){
                        $(".message-condition,.tag-read").hide();
                        $('.receive-message').removeClass('layui-show')
                        $('.send-message').addClass('layui-show')
                    }else{
                        $(".message-condition,.tag-read").show();
                        $('.send-message').removeClass('layui-show')
                        $('.receive-message').addClass('layui-show')
                    }
                })
                // 信息类别 选择 全选 已读  未读
                element.on('nav(message-condition)', function(){
                    $("#selectedText").html($(this).text());
                    var status = $(this).data('key')
                    fetchMessageData({page:1,status:status,type:"receive-message"});
                    // if(this.getAttribute('lay-id')==="send-message"){
                    //     $(".search-conditions,.tag-read").hide();
                    // }else{
                    //     $(".search-conditions,.tag-read").show();
                    // }
                });

                // form.on('select(message-condition)',function(data){
                //     fetchMessageData({page:1,status:data.value,type:"receive-message"});
                // });

                fetchMessageData({page:1,type:"receive-message",status:"2"});
                fetchMessageData({page:1,type:"send-message"});
                ## ================消息公告结束 ================
            });
        </script>

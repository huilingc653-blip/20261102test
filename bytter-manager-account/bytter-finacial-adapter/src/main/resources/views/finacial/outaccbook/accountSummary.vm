<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" style="padding: 0px 20px;" class="layui-form tt">
<table class="layui-table ">
	<tbody>
	
		<tr>
			<!-- 网点 -->
			<td class="textRight">#springMessage('table.fcAcc.netId'):</td>
			<td width="40%"><div class="bt-biz-corp" data-name="eqs_netId" data-biz-type="net" data-type="select"></div></td>
			
			<!-- 记账日期 -->
			<td class="textRight">#springMessage('table.nisBillhead.tallyDate'):</td>
			<td width="40%">
				<div class="layui-form">
					<div class="layui-form-item">
						<div class="date-interval"></div>
					</div>
				</div>
			</td>	
		</tr>	

		<tr>
			<!-- 科目 -->
	     	<td class="textRight">#springMessage('fcInstrate.subjectCode'):</td>
	     	<td width="40%">
	     		<div class="layui-form">
	     			<div class="bt-biz-dict" data-type="select" data-name="eqs_subjectSort" data-biz-name="demo-dict"  data-group="Admin.SubjectSort"></div>
				</div>
	     		
	     	</td>
	     	
	     	 <!-- 币别 -->
	    	 <td class="textRight">#springMessage('table.fcAcc.curId'):</td>
	   	 	 <td width="40%">
                    <div class="layui-inline">
                        <div type="list" field="eqs_curId" name = "eqs_curId" fieldHref="${basePath}/basic/business/btcurrency/json" dictField="id" dictText="curName" ></div>
                    </div>
			</td>
	     	
	    </tr>
	    
		<tr>
		<!-- 计量单位 -->
			<td class="textRight">#springMessage('table.fcOutAccbook.unit'):</td>
			 <td width="40%">
			 	<select name=""> 
				     <option>#springMessage('common.placeholder.all')</option>
						      
				</select>
			</td>
		</tr>

	<!--提交按钮 -->
	<tr>
	   <td style="text-align: center;" colSpan="6">
	 		 <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
             <button type="reset" class="layui-btn layui-btn-primary" style="background-color:#009688;color:#fbfbfb;">#springMessage('common.button.reset')</button>
             <button class="layui-btn" lay-submit lay-filter="excel">#springMessage('common.button.exports')</button>
             <button class="layui-btn" lay-submit lay-filter="print" type=" ">#springMessage('common.button.print')</button>
	   </td>
	</tr>

</tbody>
</table>
</form>

##网点
<div style="position:relative;left:30px;">#springMessage('table.fcAcc.netId'):</div> 
##日期范围
<div style="position:absolute;left:350px;top:210px;">#springMessage('table.accountSummary.date_scope'):</div> 
##科目代码
<div style="position:absolute;left:700px;top:210px;">#springMessage('table.fc_instrate.subject_code'):</div> 
##科目名称
<div style="position:absolute;left:1050px;top:210px;">#springMessage('finacial.paramConfig.fcSubject.subjectName'):</div>  
##币别
<div style="position:absolute;left:40px;top:240px;">#springMessage('table.btBankAccCur.cur'):</div> 
##期初笔数
<div style="position:absolute;left:350px;top:240px;">#springMessage('table.accountSummary.beginning _num'):</div>
##期初余额
<div style="position:absolute;left:700px;top:240px;">#springMessage('table.accountSummary.beginning_balance'):</div>

#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/outaccbook/accountSummary.list.js?_btv=${resourceVersion}"></script>
</html>

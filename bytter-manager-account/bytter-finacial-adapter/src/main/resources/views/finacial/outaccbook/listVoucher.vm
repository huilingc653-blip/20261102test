<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" style="padding: 0px 20px;" class="layui-form tt">
<table class="layui-table ">
	<tbody>
	
		<tr>
			<!-- 网点 -->
			<td class="textRight">#springMessage('table.fcAcc.netId')</td>
			<td width="40%"><div class="bt-biz-corp" data-name="eqs_netId" data-scope="net" data-biz-type="net" data-type="selectTree" data-resource="finacial:outaccbook:voucherList:query"></div></td>
			
			<!-- 账号 -->
			<td class="textRight">#springMessage('table.fcAccuBalance.account')</td>
			<td width="40%"><input class="layui-input" name="eqs_account" type="text" autocomplete="off" id="account"/></td>
			
			<!-- 流水号 -->
			<td class="textRight">#springMessage('table.fcAccbookHis.orderNo')</td>
			<td width="40%"><input class="layui-input" name="eqs_orderNo" type="text" autocomplete="off" id="orderNo"/></td>
		</tr>
		
		<tr>
			<!-- 记账日期 -->
			<td class="textRight">#springMessage('table.nisBillhead.tallyDate')</td>
			<td width="40%">
				 <input class="layui-input bt-input-inline bt-biz-dateType" type=text name="ged_tallyDate"  data-endid="t2">
				 <span class=date-mid>~</span>
				 <input id=t2 class="layui-input bt-input-inline bt-biz-dateType" type=text name="led_tallyDate">
			</td>
			
			<!-- 方向 -->
			<td class="textRight">#springMessage('table.fcOutAccbook.direction')</td>
			<td width="40%">
				<div class="layui-form">
	     			<div class="bt-biz-dict" data-type="select" data-name="eqs_direction" data-group="Tally.Direction" data-biz-name="demo-dict"></div>
	     		</div>
	     	</td>
	     	
	     	<!-- 金额区间 -->
	     	<td class="textRight">#springMessage('table.accbookmoneySection')</td>
	     	<td width="40%">
	     		<div class="layui-inline">
	     			<input class="layui-input bt-input-inline" type="text" name="eqg_smoney">
	     				<span class="date-mid">~</span>
	     			<input class="layui-input bt-input-inline" type="text" name="eqg_emoeny">
	     		</div>
	     		
	     	</td>
		</tr>

		<tr>
			<!-- 凭证状态 -->
			<td class="textRight">#springMessage('table.fcOutAccbook.status')</td>
			<td width="40%">
				<div class="layui-form">
	     			<div class="bt-biz-dict" data-type="select" data-name="eqi_status"  data-group="Outer.Status"></div>
	     		</div>
	     	</td>
	     	
	     	<td></td>
	     	<td></td>
	     	<td></td>
	     	<td></td> 	
	     </tr>
			
	<!--提交按钮 -->
	<tr>
	   <td style="text-align: center;" colSpan="6">
	 		 <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
             <button type="reset" class="layui-btn layui-btn-primary" style="background-color:#009688;color:#fbfbfb;">#springMessage('common.button.reset')</button>
	   </td>
	</tr>

</tbody>
</table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="print">
    <thead>
    <tr>
    	<th>#springMessage('table.fcOutAccbook.tallyDate')</th>
    	<th>#springMessage('table.fcOutAccbook.voucherNo')</th>
    	<th>#springMessage('table.fcOutAccbook.orderNo')</th>
    	<th>#springMessage('table.fcAccuBalance.account')</th>
    	<th>#springMessage('table.fcAcc.accName')</th>
    	<th>#springMessage('fcAccDetail.creditMoney')</th>
    	<th>#springMessage('fcAccDetail.debitMoney')</th>
    	<th>#springMessage('fcInstrate.subjectCode')</th>
    	<th>#springMessage('table.fcOutAccbook.unit')</th>
    	<th>#springMessage('table.fcAccbookDtl.summaryContent')</th>
    	<th>#springMessage('table.fcBankBalanceAdjust.status')</th>
    	<th>#springMessage('common.table.thead.operation')</th> 	
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/outaccbook/voucher.list.js?_btv=${resourceVersion}"></script>
</html>

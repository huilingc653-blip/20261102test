<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input type="hidden" id="fcOutAccbookId" name="book.id" value="$!{fcOutAccbookPage.id}" />
        <table class="layui-table">
			<tbody>
        	<tr>
        		##记账日期
				<td class="textRight">#springMessage('table.fcOutAccbook.tallyDate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!fcOutAccbookPage.tallyDate)
				</td>
        		##流水号
				<td class="textRight">#springMessage('table.fcOutAccbook.orderNo')</td>
				<td width="40%">
					$!{fcOutAccbookPage.orderNo}
				</td>
			</tr>
        	<tr>
        		##票据号码
				<td class="textRight">#springMessage('table.fcOutAccbook.billsNo')</td>
				<td >
					$!{fcOutAccbookPage.billsNo}
				</td>
        		##合同号码
				<td class="textRight">#springMessage('table.fcOutAccbook.contractNo')</td>
				<td >
					$!{fcOutAccbookPage.contractNo}
				</td>
			</tr>
        	<tr>
        		##到期日
				<td class="textRight">#springMessage('table.fcOutAccbook.endDate')</td>
				<td >
					$!date.format('yyyy-MM-dd',$!fcOutAccbookPage.endDate)
				</td>
				<td colspan="2">
					
				</td>
			</tr>
			<tr>
				<td colspan="4">
					<table id="editTable" style="width: 100%">
						<thead>
						<tr>
							<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.summaryContent')</th>
							<th width="10%" style="text-align: center;">#springMessage('table.fcOutAccbook.acc')</th>
							<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.accName')</th>
							<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.subject')</th>
							<th width="10%" style="text-align: center;">#springMessage('table.fcOutAccbook.unit')</th>
							<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.income')</th>
							<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.expend')</th>
						</tr>
						</thead>
						<tbody>
						#foreach($dtl in $listDtl)
        				<tr>
							<td style="text-align: center;">
								$!{dtl.summaryContent}
							</td>
			      			<td style="text-align: center;">
			      				$!{dtl.acc}
			      			</td>
			     			<td style="text-align: center;">
			    				$!{dtl.accName}
			     			</td>
			     			<td style="text-align: center;">
			     				$!{dtl.subjectName}
			     			</td>
			     			<td style="text-align: center;">
			     				$dictTag.get("fcSubject.measureUnit", $!{dtl.unit})
			     			</td>
			     			<td style="text-align: right;">
			     				$number.formatNumeric($!{dtl.debitMoney})
			     			</td>
			     			<td style="text-align: right;">
			     				$number.formatNumeric($!{dtl.creditMoney})
			     			</td>
			      		</tr>
			      		#end
        				</tbody>
					</table>
				</td>
			</tr>
        	
				<tr>
					<td colspan="6" style="text-align: center;">
						<button type="button" class="layui-btn" onClick="closeWindow();">#springMessage('common.button.close')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
function closeWindow(){
	bt.navtab.closeCurrent();
}
</script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" style="padding: 0px 20px;" class="layui-form tt">
<input id="pageNum" name="pageNum" type="hidden" value="$!{pageNum}"> 
<table class="layui-table ">
	<tbody>
	
		<tr>
			<!-- 网点 -->
			<td class="textRight">#springMessage('table.fcAcc.netId')</td>
			<td width="40%"><div id="netId"class="bt-biz-corp" data-biz-name="netId" data-name="netId" 
				data-biz-type="net" data-type="selectTree" data-resource="finacial:outaccbook:subjectBalanceList:query" data-defaultvalue="$!{search.netId}"></div>
			</td>
			
			 <!-- 币别 -->
	    	 <td class="textRight">#springMessage('table.fcAcc.curId')</td>
	   	 	 <td width="40%">
                    <div class="layui-inline">
                    	  	<div id="curId" class=bt-biz-selectType  data-name="curId" data-textField="curName"  data-valuefield="id" data-url="${basePath}/basic/business/btcurrency/json" data-biz-name="curId" data-defaultvalue="$!{search.curId}"></div>
					</div>
			</td>
		</tr>	

		<tr>
			<!-- 科目 -->
	     	<td class="textRight">#springMessage('fcInstrate.subjectCode')</td>
	     	<td width="40%">
	     		<div class="layui-form">
	     			<!-- <div class="bt-biz-dict" data-type="select" data-name="subjectSort" 
	     					data-biz-name="subjectSort"  data-group="Admin.SubjectSort" data-defaultvalue="$!{search.subjectSort}"></div> -->
					<div class="layui-inline">
            			<div id="subjectSort" />
            			<input type="hidden" id="subjectSortValue" data-biz-name="subjectSortValue" value="$!{search.subjectSort}" >
	            	</div>
				
				</div>
	     		
	     	</td>
	     	
	     	<!-- 日期 -->
	     	<td class="textRight">#springMessage('table.btBankAccFreeze.freezeDate')</td>
	     	<td width="40%">
	     		<div class=layui-input-inline>
	     			<input id="startDate" class="layui-input bt-biz-dateType" data-biz-name="startDate" type=text name="startDate" data-type="date" value="$!date.format('yyyy-MM-dd',$!search.startDate)">
	     		</div>
	     	</td>
	    </tr>

	<!--提交按钮 -->
	<tr>
	   <td style="text-align: center;" colSpan="6">
	 		 <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
             <button id="reset" type="button" class="layui-btn" style="background-color:#009688;color:#fbfbfb;">#springMessage('common.button.reset')</button>
	   </td>
	</tr>

</tbody>
</table>
</form>


##网点
<div class="layui-input-inline" style="padding-left: 100px;">#springMessage('table.fcAcc.netId'):&nbsp;&nbsp;$!{head.netName}</div> 
##日期
<div class="layui-input-inline" style="padding-left: 350px;">#springMessage('table.btBankAccFreeze.freezeDate'):&nbsp;&nbsp;$!{head.startDate}</div>  
##币别
<div class="layui-input-inline" style="padding-left: 350px;">#springMessage('table.fcAcc.curId'):&nbsp;&nbsp;$!{head.curName}</div>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
    	<th  width="10%" align="center">#springMessage('table.fc_instrate.subject_code')</th>
    	<th  width="15%" align="center">#springMessage('finacial.paramConfig.fcSubject.subjectName')</th>
    	<th  width="15%" align="center">#springMessage('table.accountSummary.beginning_balance')</th>
    	<th  width="15%" align="center">#springMessage('table.fcAccbookDtlHis.debitMoney')</th>
    	<th  width="15%" align="center">#springMessage('table.fcAccbookDtlHis.creditMoney')</th>
    	<th  width="15%" align="center">#springMessage('table.fcOutAccbook.direction')</th> 
    	<th  width="15%" align="center">#springMessage('table.accbook.endMoney')</th>	
    </tr>
    </thead>
    <tbody>
    #if($!{list})
    	#foreach($item in $list)
		<tr>
			<td width="10%" align="center">$!{item.subjectCode}</td>
			<td width="15%" align="center">$!{item.subjectName}</td>
			<td width="15%" align="right">$number.formatNumeric($!{item.yBalance})</td>
			<td width="15%" align="right">$number.formatNumeric($!{item.debitMoney})</td>
			<td width="15%" align="right">$number.formatNumeric($!{item.creditMoney})</td>
			<td width="15%" align="center">$dictTag.get("Tally.Direction",$!{item.balanceWay})</td>
			<td width="15%" align="right">$number.formatNumeric($!{item.tBalance})</td>
		</tr>
   		 #end
   		 <tr>
   			 <td width="10%"></td>
   			 <td width="15%" align="center">$!{total.subjectName}</td>
   			 <td width="15%" align="right">$!{total.yBalance}</td>
   			 <td width="15%" align="right">$!{total.debitMoney}</td>
   			 <td width="15%" align="right">$!{total.creditMoney}</td>
   			 <td width="15%" align="center">$dictTag.get("Tally.Direction",$!{item.balanceWay})</td>
   			 <td width="15%" align="right">$!{total.tBalance}</td>
   		</tr>
    </tbody>			
   #end
  
   
    
</table>
<div id="page" style="position:fixed ; bottom:0px;width:100%"></div>
<input id="size" type="hidden" value="$!{size}">
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/outaccbook/subjectBalance.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<!-- 表外查看页面 -->
<body>
<form id="searchForm"  class="layui-form tt">
<table class="layui-table ">
	<tbody>
	
		<tr>
			<!-- 记账凭证 -->
			 <td width="100%" align="center" colSpan="6" style="font-size:15px; font-weight:bold;">#springMessage('table.fcAccbook.tallyTitle')</td>
		</tr>
	
		<tr>
			<!-- 币别 -->
			<td  width="15%" class="textRight">#springMessage('table.nisBillhead.curCode'):</td>
			<td width="25%">$!{FcOutAccbookVo.curName}</td></td>
			
			<!-- 计量单位 -->
			<td  width="15%" class="textRight">#springMessage('table.fcOutAccbook.unit'):</td>
			<td width="25%">$dictTag.get("fcSubject.measureUnit",$!{FcOutAccbookVo.measureUnit})</td>
			
			
			<!-- 制单日期 /用的是当前时间-->
			<td width="20%" style="text-align: center;" rowspan="3" colspan="2">#springMessage('table.bisAccBal.createDate'):&nbsp;&nbsp;&nbsp;&nbsp;$!date.format('yyyy-MM-dd',$!date)</td>
			
		</tr>
			
		<tr>
			<!-- 流水号 -->
			<td class="textRight">#springMessage('table.fcAccbook.orderNo'):</td>
			<td >$!{FcOutAccbookVo.orderNo}</td>
			
			
			<!-- 凭证号 -->
			<td class="textRight">#springMessage('table.fcAccbookHis.voucherNo'):</td>
			<td>
				$!{FcOutAccbookVo.voucherNo}
			</td>
	     </tr>	
	
		<tr>
			<!-- 票据号码 -->
			<td class="textRight">#springMessage('table.abVoucherinfo.origNo'):</td>
			<td>$!{FcOutAccbookVo.billsNo}</td>
	     	
	     	<!-- 到期日-->
	     	<td class="textRight">#springMessage('table.fcAcc.deadlineDate'):</td>
	     	<td>$!{FcOutAccbookVo.endDate}</td>
		</tr>
	
</tbody>
</table>


<table class="layui-table ">
   <tbody>
   		<tr>
   			<td align="center">#springMessage('table.fcChargeRule.summary')</td>
   			
   			<td align="center">#springMessage('table.intere.subjectAcc')</td>
   			
   			<td align="center">#springMessage('table.nisPersonnelDetail.accName')</td>
   			
   			<td align="center">#springMessage('fcAccDetail.creditMoney')</td>
   			
   			<td align="center">#springMessage('fcAccDetail.debitMoney')</td>
  		
   		</tr>
   
   		<tr>
   		<td align="center">$!{FcOutAccbookVo.summaryContent}</td>
   		<td  align="center">$!{FcOutAccbookVo.account}</td>
   		<td align="center">$!{FcOutAccbookVo.accname}</td>
   		<td align="right">$!number.formatNumeric($!{FcOutAccbookVo.debitMoney})</td>
   		<td align="right">$!number.formatNumeric($!{FcOutAccbookVo.creditMoney})</td>
  		
   		</tr>
   		
   		<!-- <tr>
   		<td align="center">#springMessage('table.btBankAcc.rmk')</td>
   		<td style="text-align: center;" colSpan="4">
   			$!{FcOutAccbookVo.summaryContent}
   		</td>
   		</tr> -->

   </tbody>
  
</table>
<!-- 		<div class="layui-input-inline" style="padding-left:50px; "> -->
<!-- 			<span>#springMessage('table.accbook.principal'):</span> -->
<!-- 			<span></span> -->
<!-- 		</div> -->
		
		<div class="layui-input-inline" style="padding-left:120px; ">
			<span>#springMessage('table.accbook.recombination'):</span>
			<span>$!{FcOutAccbookVo.checkerName}</span>
		</div>
		
		<div class="layui-input-inline" style="padding-left:240px; ">
			<span>#springMessage('Finacial.accbook.common.button.add'):</span>
			<span>$!{FcOutAccbookVo.username}</span>
		</div>
		<table class="layui-table no-print">
		<tbody>
			<tr>
				<td width="10%" align="center" colspan="3">
				<button class="layui-btn layui-btn-mini" lay-submit="" lay-filter="submit">#springMessage('common.button.revert')</button>
				##打印
				<button type="button" class="layui-btn layui-btn-mini" onclick="print()">#springMessage('common.button.print')</button>
				</td>
			</tr>
		</tbody>
	</table>
		
<!-- 		<div class="layui-input-inline" style="padding-left:240px; "> -->
<!-- 			<span>#springMessage('table.accbook.admin'):</span> -->
<!-- 			<span></span> -->
<!-- 		</div> -->
			      
</form>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">
bt.use(['form','layedit'], function(){
	var $ = bt.jquery,form = bt.form();
    //监听提交
    form.on('submit(submit)', function(data){
    	parent.layer ? parent.layer.closeAll() : layer.closeAll();
    	return false;
    });
});
function print() {
		var LODOP=getLodop();
		$(".no-print").hide();
		LODOP.SET_PRINT_MODE("PRINT_PAGE_PERCENT","Width:90%");
		  LODOP.ADD_PRINT_HTM('9mm','0mm','RightMargin:0mm',"BottomMargin:9mm",document.documentElement.innerHTML);
		$(".no-print").show();
		LODOP.PREVIEW();
    }
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" style="padding: 0px 20px;" class="layui-form tt">
<input id="pageNum" type="hidden" name="pageNum" value="$!{pageNum}"/>##当前页
<table class="layui-table ">
	<tbody>
		<tr>
			<!-- 网点 -->
			<td class="textRight">#springMessage('table.fcAcc.netId')</td>
			<td width="40%"><div class="bt-biz-corp" data-scope="net" data-biz-name="netId"data-name="netId" data-biz-type="net" data-type="selectTree" data-resource="finacial:outaccbook:dailyAccountList:query" data-defaultvalue="$!{search.netId}"></div></td>
			
			<!-- 币别 -->
	    	 <td class="textRight">#springMessage('table.fcAcc.curId')</td>
	   	 	 <td width="40%">
                    <div class="layui-inline">
                    	  	<div class=bt-biz-selectType  data-name="curId" data-textField="curName"  data-valuefield="id" data-url="${basePath}/basic/business/btcurrency/json" data-biz-name="curId" data-defaultvalue="$!{search.curId}"></div>
					</div>
			</td>
				
			<!-- 日期 -->
			<td class="textRight">#springMessage('table.btBankAccFreeze.freezeDate')</td>
			<td width="40%">
				 <input class="layui-input bt-biz-dateType" type="text" name="startDate" data-type="date" data-biz-name="startDate" value="$!date.format('yyyy-MM-dd',$!search.startDate)">
			</td>
		</tr>	
	
		<tr>
			<!-- 计量单位 -->
			<td class="textRight">#springMessage('table.fcOutAccbook.unit')</td>
			 <td width="40%">
				 <div class=layui-form>
			 		<div class=bt-biz-dict data-type="select" data-width="120px" data-biz-name="measureUnit" data-name="measureUnit"  data-group="fcSubject.measureUnit" data-defaultvalue="$!{search.measureUnit}"></div>
				 </div>
			</td>
			
			<!-- 是否显示明细科目 -->
	     	<td class="textRight">#springMessage('is_detail_subject')</td>	
	     	<td width="40%">
	     		 <div class=bt-biz-dict data-type="radio" data-name="isShowChild" data-biz-name="isShowChild" data-group="sf_yn" data-defaultvalue="$!{search.isShowChild}"></div>
			</td> 	
			
			<td></td>
			<td></td> 
	     	
	    </tr>

	<!--提交按钮 -->
	<tr>
	   <td style="text-align: center;" colSpan="6">
	 		 <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
             <button id="reset" type="button" class="layui-btn" style="background-color:#009688;color:#fbfbfb;">#springMessage('common.button.reset')</button>
	   </td>
	</tr>
	
</tbody>
</table>
</form>
##网点
<div class="layui-input-inline" style="width:28%;">#springMessage('table.fcAcc.netId'):&nbsp;&nbsp;$!{head.netName}</div> 
##日期
<div class="layui-input-inline" style="width:28%;">#springMessage('table.btBankAccFreeze.freezeDate'):&nbsp;&nbsp;$!{optDate}</div>  
##币别
<div class="layui-input-inline" style="width:28%;">#springMessage('table.fcAcc.curId'):&nbsp;&nbsp;$!{head.curName}</div> 


<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
    	<th rowspan="2">#springMessage('table.subject_num')</th>
    	<th rowspan="2">#springMessage('finacial.paramConfig.fcSubject.subjectName')</th>
    	<th colspan="4">#springMessage('table.accountSummary.BeginPeriod')</th>
    	<th colspan="4">#springMessage('fcAccDetail.creditMoney')</th>
    	<th colspan="4">#springMessage('fcAccDetail.debitMoney')</th>
    	<th colspan="4">#springMessage('table.accountSummary.end_of_term')</th>
    	   	
    </tr>
 	
    <tr>
    	<th>#springMessage('table.fcAccBalance.cnt')</th>
    	<th>#springMessage('table.nisBillhead.payMoney')</th>
    	<th>#springMessage('table.dailyAccount.number')</th>
    	<th>#springMessage('table.dailyAccount.Frame')</th>
    	
    	<th>#springMessage('table.fcAccBalance.cnt')</th>
    	<th>#springMessage('table.nisBillhead.payMoney')</th>
    	<th>#springMessage('table.dailyAccount.number')</th>
    	<th>#springMessage('table.dailyAccount.Frame')</th>
    	
    	<th>#springMessage('table.fcAccBalance.cnt')</th>
    	<th>#springMessage('table.nisBillhead.payMoney')</th>
    	<th>#springMessage('table.dailyAccount.number')</th>
    	<th>#springMessage('table.dailyAccount.Frame')</th>
    	
    	<th>#springMessage('table.fcAccBalance.cnt')</th>
    	<th>#springMessage('table.nisBillhead.payMoney')</th>
    	<th>#springMessage('table.dailyAccount.number')</th>
    	<th>#springMessage('table.dailyAccount.Frame')</th>
    
    </tr>
     </thead>
    
     <tbody> 
    #if($!{size} > 0)
    	#foreach($item in $list)
    	<tr>
    		<td align="center">$!{item.subjectCode}</td>
    		<td align="center">$!{item.subjectName}</td>
    		<td align="center">$!{item.yCount}</td>
    		<td align="right">$number.formatNumeric($!{item.yBalance})</td>
    		<td align="center">$!{item.yNumber}</td>
    		<td align="center">$!{item.yTicket}</td>
    		<td align="center">$!{item.debitCount}</td>
    		<td align="right">$number.formatNumeric($!{item.debitMoney})</td>
    		<td align="center">$!{item.debitNumber}</td>
    		<td align="center">$!{item.debitTicket}</td>
    		<td align="center">$!{item.creditCount}</td>
    		<td align="right">$number.formatNumeric($!{item.creditMoney})</td>
    		<td align="center">$!{item.creditNumber}</td>
    		<td align="center">$!{item.creditTicket}</td>
    		<td align="center">$!{item.tCount}</td>
    		<td align="right">$number.formatNumeric($!{item.tBalance})</td>
    		<td align="center">$!{item.tNumber}</td>
    		<td align="center">$!{item.tTicket}</td>  	
    	</tr>
   		#end
 	#else
   			<tr>
   				<td colspan="18" align="center">#springMessage('common.msg.temporarily_no_data')</td>
   			</tr>
   	#end
   </tbody>   
</table>
<div id="page" style="position:fixed ; bottom:0px;width:100%"></div>##页码
		<input id="size" type="hidden" value="$!{size}">##总页数
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/outaccbook/dailyAccount.list.js?_btv=${resourceVersion}"></script>
</html>

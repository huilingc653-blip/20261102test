<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input type="hidden" id="oriId" value="$!{oriAcc.id}" />
		<input type="hidden" id="rushId" value="$!{fcOutAccbookPage.id}" />
		<div class="layui-body2" style="width: 100%; height: 100%">
			<div class="layui-tab"  style="width: 100%; height: 100%">
				<ul class="layui-tab-title">
					<li class="layui-this" lay-id="rushbook">#springMessage('table.fcOutAccbook.strikeVoucher')</li>##冲账凭证
					<li lay-id="oribook">#springMessage('table.fcOutAccbook.origVoucher')</li>##原始凭证
				</ul>
		    	<div class="layui-tab-content" style="width: 100%; height: 100%">
			      	##冲账凭证
			       	<div class="layui-tab-item layui-show" style="width: 100%; height: 100%">
			           	<table class="layui-table">
							<tbody>
				        	<tr>
				        		##记账日期
								<td class="textRight">#springMessage('table.fcOutAccbook.tallyDate')</td>
								<td >
									$!date.format('yyyy-MM-dd',$!fcOutAccbookPage.tallyDate)
								</td>
				        		##流水号
								<td class="textRight">#springMessage('table.fcOutAccbook.orderNo')</td>
								<td width="40%">
									$!{fcOutAccbookPage.orderNo}
								</td>
							</tr>
				        	<tr>
				        		##票据号码
								<td class="textRight">#springMessage('table.fcOutAccbook.billsNo')</td>
								<td >
									$!{fcOutAccbookPage.billsNo}
								</td>
				        		##合同号码
								<td class="textRight">#springMessage('table.fcOutAccbook.contractNo')</td>
								<td >
									$!{fcOutAccbookPage.contractNo}
								</td>
							</tr>
				        	<tr>
				        		##到期日
								<td class="textRight">#springMessage('table.fcOutAccbook.endDate')</td>
								<td >
									$!date.format('yyyy-MM-dd',$!fcOutAccbookPage.endDate)
								</td>
								<td colspan="2">
									
								</td>
							</tr>
							<tr>
								<td colspan="4">
									<table id="editTable" class="layui-table layui-form" style="width: 100%">
										<thead>
										<tr>
											<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.summaryContent')</th>
											<th width="10%" style="text-align: center;">#springMessage('table.fcOutAccbook.acc')</th>
											<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.accName')</th>
											<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.subject')</th>
											<th width="10%" style="text-align: center;">#springMessage('table.fcOutAccbook.unit')</th>
											<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.income')</th>
											<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.expend')</th>
										</tr>
										</thead>
										<tbody>
										#foreach($dtl in $listDtl)
				        				<tr>
											<td style="text-align: center;">
												$!{dtl.summaryContent}
											</td>
							      			<td style="text-align: center;">
							      				$!{dtl.acc}
							      			</td>
							     			<td style="text-align: center;">
							    				$!{dtl.accName}
							     			</td>
							     			<td style="text-align: center;">
							     				$!{dtl.subjectName}
							     			</td>
							     			<td style="text-align: center;">
							     				$dictTag.get("fcSubject.measureUnit", $!{dtl.unit})
							     			</td>
							     			<td style="text-align: right; color:red;">
							     				$number.formatNumeric($!{dtl.debitMoney})
							     			</td>
							     			<td style="text-align: right; color:red;">
							     				$number.formatNumeric($!{dtl.creditMoney})
							     			</td>
							      		</tr>
							      		#end
				        				</tbody>
									</table>
								</td>
							</tr>
							<tr>
								<td class="textRight">#springMessage('table.fcOutAccbook.rushReason')</td>
								<td colspan="3" style="word-wrap: break-word;">
									$!{fcOutAccbookPage.rushReason}
								</td>
							</tr>
							<tr>
								<td class="textRight">#springMessage('table.fcOutAccbook.backReason')</td>
								<td colspan="3">
									<textarea id="backReason" name="backReason" class="layui-textarea"></textarea>
								</td>
							</tr>
				        	</tbody>
				        </table>
			        </div>
		            ##原始凭证
		            <div class="layui-tab-item" style="width: 100%; height: 100%">
		            	<table class="layui-table">
							<tbody>
				        	<tr>
				        		##记账日期
								<td class="textRight">#springMessage('table.fcOutAccbook.tallyDate')</td>
								<td >
									$!date.format('yyyy-MM-dd',$!oriAcc.tallyDate)
								</td>
				        		##流水号
								<td class="textRight">#springMessage('table.fcOutAccbook.orderNo')</td>
								<td width="40%">
									$!{oriAcc.orderNo}
								</td>
							</tr>
				        	<tr>
				        		##票据号码
								<td class="textRight">#springMessage('table.fcOutAccbook.billsNo')</td>
								<td >
									$!{oriAcc.billsNo}
								</td>
				        		##合同号码
								<td class="textRight">#springMessage('table.fcOutAccbook.contractNo')</td>
								<td >
									$!{oriAcc.contractNo}
								</td>
							</tr>
				        	<tr>
				        		##到期日
								<td class="textRight">#springMessage('table.fcOutAccbook.endDate')</td>
								<td >
									$!date.format('yyyy-MM-dd',$!oriAcc.endDate)
								</td>
								<td colspan="2">
									
								</td>
							</tr>
							<tr>
								<td colspan="4">
									<table id="editTable" class="layui-table layui-form" style="width: 100%">
										<thead>
										<tr>
											<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.summaryContent')</th>
											<th width="10%" style="text-align: center;">#springMessage('table.fcOutAccbook.acc')</th>
											<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.accName')</th>
											<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.subject')</th>
											<th width="10%" style="text-align: center;">#springMessage('table.fcOutAccbook.unit')</th>
											<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.income')</th>
											<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.expend')</th>
										</tr>
										</thead>
										<tbody>
										#foreach($oriDtl in $oriListDtl)
				        				<tr>
											<td style="text-align: center;">
												$!{oriDtl.summaryContent}
											</td>
							      			<td style="text-align: center;">
							      				$!{oriDtl.acc}
							      			</td>
							     			<td style="text-align: center;">
							    				$!{oriDtl.accName}
							     			</td>
							     			<td style="text-align: center;">
							     				$!{oriDtl.subjectName}
							     			</td>
							     			<td style="text-align: center;">
							     				$dictTag.get("fcSubject.measureUnit", $!{oriDtl.unit})
							     			</td>
							     			<td style="text-align: right;">
							     				$number.formatNumeric($!{oriDtl.debitMoney})
							     			</td>
							     			<td style="text-align: right;">
							     				$number.formatNumeric($!{oriDtl.creditMoney})
							     			</td>
							      		</tr>
							      		#end
				        				</tbody>
									</table>
								</td>
							</tr>
				        	</tbody>
				        </table>
		       	    </div>
		       </div>
		    </div>
		</div>
		
        
        <div class="layui-form-item layui-form-submit ">
		    <div class="layui-input-block center">
		        <button class="layui-btn" type="button" onClick="sub('0');" >#springMessage('common.button.pass')</button>
		        <button class="layui-btn" type="button" onClick="sub('1');">#springMessage('common.button.back')</button>
		    </div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
bt.use(['element','form','jquery','dateType'], function(){
    $ = bt.jquery,form = bt.form();
    var element = layui.element();
    //时间
    bt.dateType.init();
});
	function sub(indx){
		var rea = $("#backReason").val();
		var rushId = $("#rushId").val();
		
		if(indx == '1'){
			url = basePath + "/finacial/outaccbook/tallyCharge/tallyChargeBack";
			if(rea.length > 0 && rea.length <= 50){
		    	parent.layer.confirm("#springMessage('common.message.confirm.back')",function(){
		            $.post(url , {id:rushId,backReason:rea} ,function(result){
		            	if(result.success){
		            		parent.layer.closeAll();
			        	}
		                parent.layer.alert(result.msg, {icon: result.success?1:2});
		            },'JSON');
		        });
		    }else if(rea.length > 50){
		    	parent.layer.alert("#springMessage('common.message.config.tooLength')");
		    }else{
		    	parent.layer.alert("#springMessage('common.message.config.please')");
		    }
		}else{
			url = basePath + "/finacial/outaccbook/tallyCharge/tallyChargeCheck";
			parent.layer.confirm("#springMessage('common.message.confirm.check')",function(){
				$.post(url , {id:rushId} ,function(result){
	            	if(result.success){
	            		parent.layer.closeAll();
		        	}
	                parent.layer.alert(result.msg, {icon: result.success?1:2});
	            },'JSON');
			});
		}
	}
</script>
</html>
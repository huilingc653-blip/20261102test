<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" style="padding: 0px 20px;" class="layui-form tt">
<table class="layui-table ">
	<tbody>
	
		<tr>
			<!-- 网点 -->
			<td class="textRight">#springMessage('table.fcAcc.netId')</td>
			<td width="40%"><div class="bt-biz-corp" data-name="eqs_netId" data-biz-type="net" data-type="select"></div></td>

			 <!-- 币别 -->
	    	 <td class="textRight">#springMessage('table.fcAcc.curId')</td>
	   	 	 <td width="40%">
                    <div class="layui-inline">
                        <div type="list" field="eqs_curId" name = "eqs_curId" fieldHref="${basePath}/basic/business/btcurrency/json" dictField="id" dictText="curName" ></div>
                    </div>
			</td>
			
			<!-- 日期 -->
			<td class="textRight">#springMessage('table.fcOutAccbook.YearAndMonth')</td>
			<td width="40%">
					<select>
						<option>2007</option>
						<option>2008</option>
						<option>2009</option>
						<option>2010</option>
						<option>2011</option>
						<option>2012</option>
						<option>2013</option>
						<option>2014</option>
						<option>2015</option>
						<option>2016</option>
						<option>2017</option>
						<option>2018</option>
						<option>2019</option>
						<option>2020</option>
						<option>2021</option>
						<option>2022</option>
			
					</select>
					<span>#springMessage('table.fcDayClose.closeYear')</span>
					<select>
						<option>01</option>
						<option>02</option>
						<option>03</option>
						<option>04</option>
						<option>05</option>
						<option>06</option>
						<option>07</option>
						<option>08</option>
						<option>09</option>
						<option>10</option>
						<option>11</option>
						<option>12</option>			
					</select>
					<span>#springMessage('table.fcDayClose.closeMonth')</span>	
			</td>
		</tr>	

		<tr>
			<!-- 计量单位 -->
			<td class="textRight">#springMessage('table.fcOutAccbook.unit')</td>
			<td width="40%">
			 	<div class=layui-form>
			 		<div class=bt-biz-dict data-type="select" data-name="testSelct" data-width="120px" data-biz-name="demodict1" data-group="fcSubject.measureUnit"></div>
			 	</div>
			</td>
			
			<!-- 是否选明细科目 -->
	     	<td class="textRight">#springMessage('is_detail_subject')</td>	
	     	<td width="40%">
	     		<input title="#springMessage('common.sc_yn.yes')" name="a" value="1"   CHECKED="" type="radio">
				<div class="layui-unselect layui-form-radio layui-form-radioed">
					 <i class="layui-anim layui-icon"> </i>
					 <span>#springMessage('common.sc_yn.yes')</span>
				</div>
				
				<input title="#springMessage('common.sc_yn.no')" name="a" value="0"  type="radio">
				<div class="layui-unselect layui-form-radio layui-form-radioed">
					 <i class="layui-anim layui-icon"> </i>
					 <span>#springMessage('common.sc_yn.no')</span>
				</div>
			</td> 	 
		</tr>
	
	<!--提交按钮 -->
	<tr>
	   <td style="text-align: center;" colSpan="6">
	 		 <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
             <button type="reset" class="layui-btn layui-btn-primary" style="background-color:#009688;color:#fbfbfb;">#springMessage('common.button.reset')</button>
             <button class="layui-btn" lay-submit lay-filter="excel">#springMessage('common.button.exports')</button>
             <button class="layui-btn" lay-submit lay-filter="print" type=" ">#springMessage('common.button.print')</button>
	   </td>
	</tr>
	
</tbody>
</table>
</form>

##网点
<div style="position:relative;left:30px;">#springMessage('table.fcAcc.netId'):</div> 
##日期
<div style="position:relative;left:500px;top:-15px;">#springMessage('table.btBankAccFreeze.freezeDate'):</div>  
##币别
<div style="position:relative;left:1000px;top:-30px;">#springMessage('table.fcAcc.curId'):</div> 


<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
    	<th rowspan="2">#springMessage('table.subject_num')</th>
    	<th rowspan="2">#springMessage('finacial.paramConfig.fcSubject.subjectName')</th>
    	<th colspan="4">#springMessage('table.accountSummary.BeginPeriod')</th>
    	<th colspan="4">#springMessage('fcAccDetail.creditMoney')</th>
    	<th colspan="4">#springMessage('fcAccDetail.debitMoney')</th>
    	<th colspan="4">#springMessage('table.accountSummary.end_of_term')</th>	   	
    </tr>
    
    <tr>
    	<th >#springMessage('table.fcAccBalance.cnt')</th>
    	<th>#springMessage('table.nisBillhead.payMoney')</th>
    	<th>#springMessage('table.dailyAccount.number')</th>
    	<th>#springMessage('table.dailyAccount.Frame')</th>
    	
    	<th>#springMessage('table.fcAccBalance.cnt')</th>
    	<th>#springMessage('table.nisBillhead.payMoney')</th>
    	<th>#springMessage('table.dailyAccount.number')</th>
    	<th>#springMessage('table.dailyAccount.Frame')</th>
    	
    	<th>#springMessage('table.fcAccBalance.cnt')</th>
    	<th>#springMessage('table.nisBillhead.payMoney')</th>
    	<th>#springMessage('table.dailyAccount.number')</th>
    	<th>#springMessage('table.dailyAccount.Frame')</th>
    	
    	<th>#springMessage('table.fcAccBalance.cnt')</th>
    	<th>#springMessage('table.nisBillhead.payMoney')</th>
    	<th>#springMessage('table.dailyAccount.number')</th>
    	<th>#springMessage('table.dailyAccount.Frame')</th>
    </tr>
    </thead>
</table>

#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/outaccbook/monthlyBalance.list.js?_btv=${resourceVersion}"></script>
</html>

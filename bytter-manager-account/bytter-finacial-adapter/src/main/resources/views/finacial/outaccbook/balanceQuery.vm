<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<!-- 余额查询 -->
<body>
<form id="searchForm" style="padding: 0px 20px;" class="layui-form tt">
<table class="layui-table ">
	<tbody>
	
		<tr>
			<!-- 网点 -->
			<td class="textRight">#springMessage('table.fcAcc.netId')</td>
			<td width="40%"><div class="bt-biz-corp" data-scope="net" data-name="eqs_netId" data-biz-type="net" data-type="selectTree" data-resource="finacial:outaccbook:balanceList:query"></div></td>
			
			<!-- 开户单位 -->
			<td class="textRight">#springMessage('table.fcAcc.corpId')</td>
			<td width="40%"><div class="bt-biz-corp" data-name="eqs_corpId" data-biz-type="corp" data-type="selectTree" data-resource="finacial:outaccbook:balanceList:query"></div></td>
		</tr>	

		<tr>
			<!-- 记账日期 -->
			<td class="textRight">#springMessage('table.nisBillhead.tallyDate')</td>
			<td width="40%">
				<input class="layui-input bt-input-inline bt-biz-dateType" type=text name="ged_balanceOptDate"  data-endid="t2">
				<span class=date-mid>~</span>
				<input id=t2 class="layui-input bt-input-inline bt-biz-dateType" type=text name="led_balanceOptDate">
			</td>
			
			<!-- 账号 -->
			<td class="textRight">#springMessage('table.nisBillhead.accId')</td>
			<td width="40%">
				<input type="text" name="likes_balanceAccount" class="layui-input bank" />
	     	</td>
	     	
	    </tr>

	<!--提交按钮 -->
	<tr>
	   <td style="text-align: center;" colSpan="6">
	 		 <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
             <button type="reset" class="layui-btn layui-btn-primary" style="background-color:#009688;color:#fbfbfb;">#springMessage('common.button.reset')</button>
	   </td>
	</tr>

</tbody>
</table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="print">
    <thead>
    <tr>
    	<th>#springMessage('table.btBankAccFreeze.freezeDate')</th>
    	<th>#springMessage('table.nisBillhead.accId')</th>
    	<th>#springMessage('table.fcOutAccbook.accName')</th>
    	<th>#springMessage('fcInstrate.subjectCode')</th>
    	<th>#springMessage('table.fcOutAccbook.direction')</th>
    	<th>#springMessage('finacial.check.erpDataManager.balance')</th> 	
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/outaccbook/balanceQuery.list.js?_btv=${resourceVersion}"></script>
</html>

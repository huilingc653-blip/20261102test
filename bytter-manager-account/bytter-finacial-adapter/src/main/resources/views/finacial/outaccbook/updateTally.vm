<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input type="hidden" id="fcOutAccbookId" name="book.id" value="$!{fcOutAccbookPage.id}" />
        <table class="layui-table">
			<tbody>
        	<tr>
        		##记账日期
				<td class="textRight">#springMessage('table.fcOutAccbook.tallyDate')</td>
				<td >
					<input name="book.tallyDate" class="layui-input bt-biz-dateType" id="tallyDate" value="$!date.format('yyyy-MM-dd',$!fcOutAccbookPage.tallyDate)" data-endid="endDate" data-type="date" type="text" >
				</td>
        		##流水号
				<td class="textRight">#springMessage('table.fcOutAccbook.orderNo')</td>
				<td width="40%">
					$!{fcOutAccbookPage.orderNo}
				</td>
			</tr>
        	<tr>
        		##票据号码
				<td class="textRight">#springMessage('table.fcOutAccbook.billsNo')</td>
				<td >
					<input type="text" id="billsNo" name="book.billsNo" value="$!{fcOutAccbookPage.billsNo}"
						autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcOutAccbook.billsNo')">
				</td>
        		##合同号码
				<td class="textRight">#springMessage('table.fcOutAccbook.contractNo')</td>
				<td >
					<input type="text" id="contractNo" name="book.contractNo" value="$!{fcOutAccbookPage.contractNo}"
						autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcOutAccbook.contractNo')">
				</td>
			</tr>
        	<tr>
        		##到期日
				<td class="textRight">#springMessage('table.fcOutAccbook.endDate')</td>
				<td >
					<input name="book.endDate" class="layui-input bt-biz-dateType" id="endDate" value="$!date.format('yyyy-MM-dd',$!fcOutAccbookPage.endDate)" data-type="date" type="text">
				</td>
				<td colspan="2">
					
				</td>
			</tr>
			<tr>
				<td colspan="4">
					<table id="editTable" style="width: 100%">
						<thead>
						<tr>
							<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.summaryContent')</th>
							<th width="10%" style="text-align: center;">#springMessage('table.fcOutAccbook.acc')</th>
							<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.accName')</th>
							<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.subject')</th>
							<th width="10%" style="text-align: center;">#springMessage('table.fcOutAccbook.unit')</th>
							<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.income')</th>
							<th width="15%" style="text-align: center;">#springMessage('table.fcOutAccbook.expend')</th>
							<!-- <th width="5%" style="text-align: center;">#springMessage('common.table.thead.operation')</th> -->
						</tr>
						</thead>
						<tbody>
						<!-- 模板开始 -->
        				<tr style="display: none;" id="template">
							<td style="text-align: center;">
								<input id="summaryContent_index" name="template[index].summaryContent" class="layui-input" placeholder="#springMessage('table.fcOutAccbook.summaryContent')"/>
								<input type="hidden" name="template[index].lineNo" value="index" />
							</td>
			      			<td style="text-align: center;">
			      					<input id="account_index" name="template[index].account" class="layui-input" type="text" placeholder="#springMessage('table.fcOutAccbook.acc')"/>
			      				<table id="accountTable_index">
					    			<thead>
						    			<tr>
						    				<th>#springMessage('table.fcVoucherEntryDefine.account')</th>##账号
						    				<th>#springMessage('table.fcAcc.accName')</th>##账户名称
						    				<th>#springMessage('fcInstrate.subjectCode')</th>##科目
						    			</tr>
					    			</thead>
				    			</table>
			      			</td>
			     			<td style="text-align: center;">
			    				<div id="accName_index"></div>
			    				<input type="hidden" id="curCode_index" name="template[index].curCode">
			     			</td>
			     			<td style="text-align: center;">
			     				<div id="subject_index"></div>
			     			</td>
			     			<td style="text-align: center;">
			     				<div id="unit_index"></div>
			     			</td>
			     			<td style="text-align: center;">
			     				<input id="debitMoney_index" data-name="template[index].debitMoney" data-decimal="2" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fcOutAccbook.income')" />
			     			</td>
			     			<td style="text-align: center;">
			     				<input id="creditMoney_index" data-name="template[index].creditMoney" data-decimal="2" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.fcOutAccbook.expend')" />
			     			</td>
			     			<!-- <td>
			     				<button data-type="del" type="button" class="layui-btn layui-btn-mini">#springMessage("common.button.delete")</button>
			     			</td> -->
			      		</tr>
        				<!-- 结束开始 -->
        				</tbody>
					</table>
				</td>
			</tr>
        	
				<tr>
					<td colspan="6" style="text-align: center;">
						#if($!{fcOutAccbookPage.status} != ${STATUE_TALLY_WAIT_CHECK})
						<button type="button" class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
						#end
						<button type="button" class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
						<button type="button" class="layui-btn" onClick="closeWindow();">#springMessage('common.button.close')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/outaccbook/tally.edit.js?_btv=${resourceVersion}"></script>
</html>
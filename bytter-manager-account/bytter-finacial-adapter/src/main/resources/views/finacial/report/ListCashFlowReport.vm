<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        .dataTables_scroll{
            border: 1px solid #d2d2d2!important;
        }　
    </style>
</head>
<body>
<!-- 这里填写新HTML的代码 -->
<form class="layui-form" method="post" id="searchForm">
    <table class="layui-table">
        <tr>
            <td class="textRight" style="width: 10%">#springMessage('table.fcCheckInit.netId')</td>
            <td style="width: 23%">
                <div class="layui-inline">
                    <div class="layui-input-inline" >
                        <div class="bt-biz-corp"
                             data-biz-type="net"
                             data-type="selectTree"
                             data-name="netCode"
                             data-resource="finacial:cashFlow:query"
                             data-biz-name="netCode"
                             data-required="true"
                             data-callback="corpCallBack"
                             
                             data-scope="net"
                             data-resource="finacial:cashFlow:query"

                        ></div>
                    </div>
                </div>
            </td>
            <td class="textRight" style="width: 13%">#springMessage('table.ratBkrationRelief.curCode')</td>
            <td style="width: 23%">
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-biz-name="curId"
                     data-name="curId" data-valueField="id" data-textField="curName" ></div>
            </td>
            <td class="textRight" style="width: 10%">#springMessage('table.fcAccuBalance.date')</td>
            <td style="width: 23%">
                <div class="layui-inline">
                    <input name="startDate" data-biz-name="startDate" lay-verify="required" data-endid="endDate" class="layui-input bt-biz-dateType" type="text">
                </div>
                <div class="layui-inline">
                    <span class="date-mid">~</span>
                </div>
                <div class="layui-inline">
                    <input name="endDate" id="endDate" data-biz-name="endDate" lay-verify="required" class="layui-input bt-biz-dateType" type="text" data-callback="endDateCallBack">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('cms.report.loan.convertLoaclCur')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-value="0"
                     data-callback="isConvertCallBack"
                     data-name="isConvert" data-biz-name="isConvert"></div>
            </td>
            <td class="textRight">#springMessage('table.curName.natualCurrency')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-biz-name="convertCurId" data-disabled="true" data-callback="rateTypeCallBack"
                     data-name="convertCurId" data-valueField="id" data-textField="curName" ></div>
            </td>
            <td class="textRight">#springMessage('table.report.convertCurType')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btratetype/json"
                     data-biz-name="rateType" data-callback="rateTypeCallBack"
                     data-name="rateType" data-disabled="true" data-valueField="id" data-textField="typeName" ></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.report.execRateDate')</td>
            <td>
                <input name="convertDate" data-biz-name="convertDate" class="layui-input bt-biz-dateType" type="text">
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center">
                <button class="layui-btn" type="button" lay-submit="" lay-filter="search">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<div id="print" class="print-list">
<table id="datatable" class="layui-table" style="width:100%">
    <thead>
    <tr>
        <td colspan="2">#springMessage('table.fcIncomStatement.corp')<span id="reportCorp"></span></td>
        <td colspan="2">#springMessage('table.fcAccuBalance.date')：<span id="reportDate"></span></td>
        <td colspan="2">#springMessage('table.ratBkrationRelief.curCode')：<span id="reportCur"></span></td>
    </tr>
    <tr>
        <th>#springMessage('table.fcReportFormat.item')</th>##项目
        <th>#springMessage('table.fcReportFormat.orderNo')</th>##行次
        <th>#springMessage('table.fcAccbook.money')</th>##金额
        <th>#springMessage('table.fcReportFormat.item')</th>##项目
        <th>#springMessage('table.fcReportFormat.orderNo')</th>##行次
        <th>#springMessage('table.fcAccbook.money')</th>##金额
    </tr>
    </thead>
</table>
</div>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/finacial/report/ListCashFlowReport.js?_btv=${resourceVersion}"></script>
</body>
</html>

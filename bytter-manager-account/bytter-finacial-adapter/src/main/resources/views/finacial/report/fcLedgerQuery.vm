<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
		#page .wrapper {
			margin-right: 20px;
		}
	</style>
</head>
<body>
    <form id="searchForm" class="layui-form input150-container"> 
    <input type="hidden" id="currentPage" value="1">
    <input type="hidden" id="count" value="1"> 
        <table class="layui-table">
                <tr> 
                	##网点
                    <td class="textRight">#springMessage('table.fcAcc.netId')</td>
	        		<td class="rCode">
	       				<div class="layui-input-inline">
	                   		<div class="bt-biz-corp" data-biz-type="net" data-type="selectTree" data-resource="finacial:fcledger:query"
	                   		data-name="netId" data-scope="net" data-biz-name="netId" data-defaultvalue="$!{netId}"  data-required="true"></div>
	           			</div>
	           		</td>
	           		##帐号
                    <td class="textRight">#springMessage('table.fcAccbookDtl.account')</td>
	        		<td class="rCode">
	        		<div class="layui-inline">
	        		<input type="text" name="account" id="account" class="layui-input text" data-biz-name="account" value="$!{account}">
						<table id="example" class="hide">
							<thead>
								<tr>
									<th>#springMessage("table.fcAccbookDtl.account")</th>
									<th>#springMessage("table.fcAccbookDtl.accName")</th>
								</tr>
							</thead>
						</table>
					</div>
					</td>
            		##账户类别
                	<td class="textRight">#springMessage('table.fcAcc.accType')</td>
		            <td>
		                <div class="layui-inline">
		                    <div class="bt-biz-dict" data-type="select" data-name="accType" data-biz-name="accType" 
                                data-group="InnerAccount.AccType"></div>
		                </div>
		            </td>
                </tr>
                <tr>
                	##币别
        			<td class="textRight">
        				#springMessage('table.fcBusinessRuleDefine.curCode')
	        		</td> 
	                <td class="rCode">
	                <div class="layui-input-inline">
						<div class="bt-biz-selectType" data-biz-name="curCode" data-url="${basePath}/basic/business/btcurrency/json" 
						data-valuefield="id" data-textfield="curName" data-name="curCode" data-defaultvalue="$!{curCode}"></div>
						</div>
	                </td>
                	##记账日期
	           		<td class="textRight">#springMessage('table.fcAccbook.tallyDate')</td>
            		<td class="rCode"> 
            		<div class="layui-inline">
                    	<input type="text" name="gedTallyDate" data-type="date" data-biz-name="gedTallyDate"
                    	class="layui-input bt-biz-dateType" data-endid="startDate" value="$!{gedTallyDate}">
                	</div> 
                	<div class="layui-inline">~</div>
                	<div class="layui-inline">
                    	<input type="text" name="ledTallyDate" data-type="date" data-biz-name="ledTallyDate"
                    	class="layui-input bt-biz-dateType" id="startDate" value="$!{ledTallyDate}">
                	</div>
            		</td>
					##凭证号
					<td class="textRight">#springMessage('table.fcAccbook.voucherNo')</td>
            		<td class="rCode">
            		<div class="layui-inline">
                        <input type="text" name="gesVoucherNo" value="$!{gesVoucherNo}" id="gesVoucherNo"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbook.voucherNo')">
                    </div>
                    <div class="layui-inline">~</div>
                    <div class="layui-inline">
                        <input type="text" name="lesVoucherNo" value="$!{lesVoucherNo}" id="lesVoucherNo"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbook.voucherNo')">
                    </div>
            		</td>
                </tr>
                <tr>
                	##科目
                	<td class="textRight">
                		#springMessage('table.fcAccbookDtl.subjectCode')
                	</td> 
					<td class="rCode">
					<div class="bt-biz-selectType" data-biz-name="subjectId" data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSubjectDate" data-valuefield="id" 
							data-textfield="subjectName" data-name="subjectId" data-search="true" data-defaultvalue="$!{subjectId}"></div>
					</td>

                	##借方发生额
                	<td class="textRight">#springMessage('table.fcAccbookDtl.debitMoney')</td>
                	<td class="rCode"> 
                		<div class="layui-inline">
	                        <input type="text" name="gesDebitMoney" class="layui-input bt-input-inline  bt-biz-moneyType" 
	                        data-biz-name="gesDebitMoney" data-moneyendid="debitMoney" value="$!{gesDebitMoney}" >
						</div>
						<div class="layui-inline">~</div> 
                    	<div class="layui-inline">
	                         <input type="text" name="lesDebitMoney" class="layui-input bt-input-inline  bt-biz-moneyType" 
	                        	data-biz-name="lesDebitMoney" id="debitMoney" value="$!{lesDebitMoney}">
                    	</div>
                	</td>
                	##贷方发生额
                	<td class="textRight">#springMessage('table.fcAccbookDtl.creditMoney')</td>
                	<td class="rCode">
                		<div class="layui-inline"> 
                         <input type="text" name="gesCreditMoney" class="layui-input bt-input-inline  bt-biz-moneyType" 
                         data-biz-name="gesCreditMoney" data-moneyendid="creditMoney" value="$!{gesCreditMoney}">
						</div>
						<div class="layui-inline">~</div>
                    	<div class="layui-inline">
	                         <input type="text" name="lesCreditMoney" class="layui-input bt-input-inline  bt-biz-moneyType" 
	                        	data-biz-name="lesCreditMoney" id="creditMoney" value="$!{lesCreditMoney}"> 
                    	</div> 
                	</td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
            			<button type="reset" class="layui-btn layui-btn-primary" >#springMessage('common.button.reset')</button>
						<button class="layui-btn " lay-submit lay-filter="excel">#springMessage('common.button.exports')</button>
						<button class="layui-btn bt-biz-printType" type="button" data-printareaid="print">打印</button>
                    </td>
                </tr>
        </table>
    </form>
<div id="tbl" style="width:100%;overflow:auto" >
<div id="print">
	<table width="100%" align="center" id="search">
			<tr>
				<td align="right" width="15%">#springMessage('table.divided.tally_date')：</td>
				<td width="15%"><span id="tallyDateStr" ></span></td>
				<td align="right" width="15%">#springMessage("table.fcloanrepay.corpName")：</td>
				<td width="25%"><span id="corpName"></span></td>
				<td align="right" width="15%">#springMessage('table.fcBusinessRuleDefine.curCode')：</td>
				<td width="15%"><span id="curName"></span></td>
			</tr>
			<tr>
				<td align="right" width="15%">#springMessage('table.fcAccbookDtl.account')：</td>
				<td width="15%"><span id="accountStr" ></span></td>
				<td align="right" width="15%">#springMessage("table.fcAccbookDtl.accName")：</td>
				<td width="25%"><span id="accName"></span></td>
				<td align="right" width="15%">#springMessage('table.accountSummary.beginning_balance')：</td>
				<td width="15%"><span id="beginningBalance"></span></td>
			</tr>
		</table>
	<table id="appTable" class="layui-table layui-form" style="width:100%;">
		<thead>
		<tr>
			<th width="10%">#springMessage('table.fcAccbook.tallyDate')</th>
			<th width="10%">#springMessage('table.fcAccbook.busRaceId')</th>
			<th width="10%">#springMessage('table.fcAccbook.voucherType')</th>
			<th width="15%">#springMessage('table.fcAccbook.voucherNo')</th>
			<th width="15%">#springMessage('table.fcAccbookDtl.summaryContent')</th>
			<th width="10%">#springMessage('table.fcAccbookDtl.debitMoney')</th>
			<th width="10%">#springMessage('table.fcAccbookDtl.creditMoney')</th>
			<th width="10%">#springMessage('table.fcAccbookDtlHis.balance')</th>
			<th width="10%">#springMessage('table.fcAccBalance.balanceWay')</th>
		</tr>
		</thead>
	</table>
</div>
<div id="page" style="position:fixed ; bottom:0px;width:100%"></div> 
</div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/report/export.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">
var corpInit;
var dateType;
var selectType;
var dicts;
var moneyType;
var moneyFun;
bt.use(['form','bttable','btdate','datatable','corp','moneyType','laypage','dateType','selectType','date','dicts','jquery','element','selectTable','page','printType'], function(){
	$ = bt.jquery,form = bt.form();
	dateType=bt.dateType.init();
	selectType=bt.selectType.init();
	dicts=bt.dicts.init();
	moneyType=bt.moneyType.init();
	moneyFun = bt.moneyType.getFun();
	corpInit = bt.corp.init();
	bt.printType.init();
   	bt.selectTable.init({
	   	 elem: "#example",
	   	 url: basePath+"/inneraccount/fcacc/getValidAccount",
	   	 scrollX:"500px",
	   	 scrollY:"200px",
	   	 searchInput:"#account",
	   	 columns: [
            {data:"blnctrAcc",},
            {data:"accName",}
	   	 ],
	   	clickCallback:function(data){
	   		 //设置账户
	   		$("#account").val(data.blnctrAcc);
	   	 }
	});
   	var page = null;
    var table = null;
    var headOtherInfo=null;
    table=bt.bttable.init({
	        elem: "#appTable",
	       /* scrollY:"200px",*/
	        url: basePath+"/finacial/report/ledgerquery/loadData",
	        urldata:getParam(), 
	        columns: [
	            {data:"tallyDate",className:"center",bSortable:false},
	         	{data:"busRaceName",className:"center",bSortable:false,render: function (data, type, full, meta) {
                    var busRaceName = data.busRaceName;
                    if(null == busRaceName || "null" == busRaceName){
                        return "";
                    }
                    return busRaceName;
                }},
	            {data:"voucherTypeName",className:"center",bSortable:false},
	            {data:"voucherNo",className:"center",bSortable:false},
	            {data:"summaryContent",className:"center",bSortable:false},
	            {data:"debitMoney",className:"textRight",bSortable:false,
	            	render: function (data, type, full, meta) {
	            		var money = moneyFun.format(data.debitMoney);
	            		return money;
	            	}
	            },
	            {data:"creditMoney",className:"textRight",bSortable:false,
	            	render: function (data, type, full, meta) {
	            		var money = moneyFun.format(data.creditMoney); 
	            		return money;
	            	} 
	            },
	            {data:"balance",className:"textRight",bSortable:false,
	            	render: function (data, type, full, meta) {
	            		var money = moneyFun.format(data.balance); 
	            		return money;
	            	}
	            },
	         	{data:"balanceWay",className:"center",bSortable:false,
	            	render:function(data, type, full, meta){
	         			var str="";
	         			if(data.balanceWay==1){
	         				str = bt.lang("finacial.check.cdSign.debit");
	         			}else if(data.balanceWay==-1){
	         				str = bt.lang("finacial.check.cdSign.credit");
	         			}
	         			return str;
	         	}}
	        ],
	        tableInitCallback:function(data){ 
	        	headOtherInfo(data);
	        },
	        tableDrawCallback:function (data) {
	            if(!page && data){
	            	var pages;
	            	if(data.length){
	            		pages=data[0].accNum;
	            	}else{
	            		pages=1;
	            	}
	                page = bt.page.init({
	                    elem:'#page',//分页组件容器
	                    pages:pages,
	                    count:data.length, //表格总页码
	                    currentPage:$("#currentPage").val(),//当前页码，默认值为 0,即第一页
	                    len : data.length, //当前显示条数
	                    lengthMenu:false,
	                    custom:{
	                        start:1
	                    },
	                    jump:function(obj){ //翻页回调方法
	                        var curr = obj.curr;
	                        var len = obj.len;
	                        $("#currentPage").val(curr); 
	                        if(table){
	                            table.draw({
	                                url: basePath+"/finacial/report/ledgerquery/loadData",
	                                urldata:getParam() + "&querySign=1"
	                            })
	                        }
	                    }
	                })
	            }else{
	                var elem = $("#page").find('.wrapper');
	                var pages;
	                var currentPage = $("#currentPage").val();
	                var start = 1;
	                if(data.length){
	                    pages = data[0].accNum;
	                }else{ 
	                    pages = 1;
	                    currentPage = 1;
	                    start = 0;
	                }
	                elem.find('.total').text(pages);
	                elem.find('.table-record .table-startRecord1').text( start );
	                elem.find('.table-pageNumber').val(currentPage);//更新当前页码
	                page.updateStyle(elem.find('.table-record '),currentPage,pages);//更新样式
	                elem.find('.table-record .table-endRecord1').text( data.length );//更新结束数据条数
	                elem.find('.table-record .table-totalRecord1').text( data.length );//更新总条数
	            }
	            headOtherInfo(data);
	        }
	    });
  //监听提交
   	form.on('submit(search)', function(data) { 
   		
   		if(table){
            $("#currentPage").val(1);
            table.draw({
                url: basePath+"/finacial/report/ledgerquery/loadData",
                urldata:getParam() + "&querySign=1"
			})
		}
   	});

	form.on('submit(excel)', function(data) {
		var url = basePath+"/finacial/report/ledgerquery/exportExcel";
		DownLoadFile({url:url,data:data.field,method:'post'});
		return false;
	});
   	
   	headOtherInfo=function(data){
   		if(data !=null && data.length){
   			$("#tallyDateStr").html(dateType.get('gedTallyDate').val()+" - "+dateType.get('ledTallyDate').val());
    		$("#corpName").html(data[0].corpName);
       		$("#curName").html(data[0].curName);
       		$("#accountStr").html(data[0].account); 
       		$("#accName").html(data[0].accName);
       		$("#beginningBalance").html(moneyFun.format(data[0].beginningBalance));
       		$("#count").val(data[0].accNum);
   		}else{ 
   			//清空账户信息
   	   		$("#search tr").each(function(){
   	   			$(this).children('td').children('span').text("");
   	   		}); 
   		}
   	}
    
});

var getParam = function(){
	var param="";
	param += "netId="+corpInit.get('netId').val()+
	"&gedTallyDate="+dateType.get('gedTallyDate').val()+"&ledTallyDate="+dateType.get('ledTallyDate').val()+
	"&account="+$("#account").val()+"&gesVoucherNo="+$("#gesVoucherNo").val()+"&lesVoucherNo="+$("#lesVoucherNo").val()+
	"&accType="+dicts.get('accType').val()+"&curCode="+selectType.get('curCode').val()+
	"&subjectId="+selectType.get('subjectId').val()+"&gesDebitMoney="+moneyType.get("gesDebitMoney").val()+
	"&lesDebitMoney="+moneyType.get("lesDebitMoney").val()+"&gesCreditMoney="+moneyType.get("gesCreditMoney").val()+
	"&lesCreditMoney="+moneyType.get("lesCreditMoney").val()+"&start="+$("#currentPage").val(); 
	return param;
}

function view(id){
    parent.layer.open({
        type: 2,
        area: ['1120px', '700px'],
        maxmin: true,
        content: basePath + "/finacial/accbook/fcaccbookblned/view?id=" + id
    });
}
</script>
</html>
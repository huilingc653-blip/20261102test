<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #page .wrapper {
            margin-right: 20px;
        }
    </style>
</head>
<body>
<input type="hidden" id="size" value="$!{size}">
<div style="text-align: center;">
    <button id="printBt" class="layui-btn" type="button" onclick="print()">#springMessage('common.button.print')</button>
</div>
#foreach($item in $!{map.entrySet()})
    <div  style="width:100%;overflow:auto">
        <div id="headInfoContainerElement_${velocityCount}">
            <input type="hidden" id="netName_${velocityCount}" value="$!{item.value.fcBookDtlListVO.netName}">
            <table width="100%" align="center" style="border: 0px;margin-top: 5px;font-family: 'Microsoft YaHei';">
                <tr>
                    <td align="right" width="15%">#springMessage('table.fcAccbookDtl.account')：</td>
                    <td colspan="2" width="15%"><span id="accountStr_${velocityCount}">$!{item.value.fcBookDtlListVO.account}</span></td>
                    <td align="right" width="15%">#springMessage("table.fcAccbookDtl.accName")：</td>
                    <td width="25%"><span id="accName_${velocityCount}">$!{item.value.fcBookDtlListVO.accName}</span></td>
                    <td align="right" width="15%">#springMessage('table.fcBusinessRuleDefine.curCode')：</td>
                    <td width="15%"><span id="curName_${velocityCount}">$!{item.value.fcBookDtlListVO.curName}</span></td>
                </tr>
                <tr>
                    <td align="right">#springMessage('table.fcAccbookDtl.subjectCode')：</td>
                    <td colspan="2"><span id="subjectName_${velocityCount}">$!{item.value.fcBookDtlListVO.subjectName}</span></td>
                    <td align="right"></td>
                    <td></td>
                    <td align="right">#springMessage('table.accountSummary.beginning_balance')：</td>
                    <td><span id="beginningBalance_${velocityCount}">$!number.formatNumeric($!{item.value.fcBookDtlListVO.beginningBalance})</span></td>
                </tr>
            </table>
        </div>
        <div  class="print-list" id="print_${velocityCount}">
            <table id="appTable" class="layui-table layui-form" style="width:100%;">
                <thead>
                <tr>
                    <th rowspan="2" width="10%">#springMessage('table.fcAccbook.tallyDate')</th>
                    <th rowspan="2" width="15%">#springMessage('table.fcAccbook.voucherNo')</th>
                    <th rowspan="2" width="10%">#springMessage('table.fcAccbook.voucherType')</th>
                    <th rowspan="2" width="15%">#springMessage('table.fcAccbookDtl.summaryContent')</th>
                    <th rowspan="2" width="10%">#springMessage('table.fcAccbookDtl.debitMoney')</th>
                    <th rowspan="2" width="10%">#springMessage('table.fcAccbookDtl.creditMoney')</th>
                    <th colspan="2" width="30%">#springMessage('table.accountSummary.end_of_term')</th>
                </tr>
                <tr>
                    <th width="15%">#springMessage('table.fcAccBalance.balanceWay')</th>
                    <th width="15%">#springMessage('table.fcAccbookDtlHis.balance')</th>
                </tr>
                </thead>
                #foreach($entity in $!{item.value.fcBookDtlListVOList})
                    <tbody>
                        <tr>
                            <td align="center">$!date.format('yyyy-MM-dd',$!{entity.tallyDate})</td>
                            <td align="center">$!{entity.voucherNo}</td>
                            <td align="center">$!{entity.voucherName}</td>
                            <td align="center">$!{entity.summaryContent}</td>
                            <td align="right">$!number.formatNumeric($!{entity.debitMoney})</td>
                            <td align="right">$!number.formatNumeric($!{entity.creditMoney})</td>
                            <td align="center">$!{entity.balanceWay}</td>
                            <td align="right">$!number.formatNumeric($!{entity.balance})</td>
                        </tr>
                    </tbody>
                #end
                    <tr >
                        <td align="center">#springMessage('table.interet.sum')</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td  align="right">$!number.formatNumeric($!{item.value.sumDebitMoney})</td>
                        <td  align="right">$!number.formatNumeric($!{item.value.sumCreditMoney})</td>
                        <td></td>
                        <td></td>
                    </tr>
            </table>
        </div>
    </div>
#end
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/report/fcbookDtl.batchPrint.js?_btv=${resourceVersion}"></script>
</html>
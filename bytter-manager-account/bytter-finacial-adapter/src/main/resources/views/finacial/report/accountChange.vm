<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<table class="layui-table">
		<tbody>
			<tr>
				##网点
				<td width="10%" class="textRight">#springMessage("table.fbsBudget.net")</td>
				<td width="40%">
					<div class="layui-inline">
						<div class="bt-biz-corp"
							 data-biz-type="net"
							 data-type="selectTree"
							 data-biz-name="netId"
							 data-name="netId"
							 data-group="corpGroup"
							 data-change="corpId"
							 data-defaultvalue="$!{search.netId}"
							 data-resource="finacial:account:change:query"
							 data-scope="net"></div>
					</div>
				</td>

				##单位
				<td width="10%"  class="textRight">#springMessage("table.fbsBudget.corpId")</td>
				<td width="40%">
					<div class="layui-inline">
						<div class="bt-biz-corp"
							 data-biz-type="corp"
							 data-type="selectTree"
							 data-biz-name="corpId"
							 data-name="corpId"
							 data-tips="#springMessage('common.placeholder.select')#springMessage('table.fcAcc.netId')"
							 data-group="corpGroup"
							 data-defaultvalue="$!{search.corpId}"
							 data-weakcontrol="true"
							 data-resource="finacial:account:change:query"
							 data-scope="all"></div>
					</div>
				</td>
			</tr>

			<tr>
				##账号
				<td class="textRight">#springMessage("table.fcLessPayBill.account")</td>

				<td>

				 	<div class=layui-inline>
				 		<input id="account1" class="layui-input bt-input-inline" type="type" name="le_account" data-biz-name="selectTable1" value="$!{search.le_account}">
				 	</div>
				 	 <!-- <SPAN class=date-mid>~</SPAN>
				 	<div class=layui-inline>
				 		<input id="account2" class="layui-input bt-input-inline" type="type" name="ge_account" data-biz-name="selectTable2">
				 	</div> -->
				 </td>

				##科目名称
				<td class="textRight">#springMessage("table.fbsBudgetYear.itemName")</td>
				<td width="25%">
					<div class="layui-input-inline">
						<div class="bt-biz-selectType" data-url="${basePath}/paramconfig/fcbusinessruledefine/jsonSubject" data-valuefield="id" data-textfield="subjectName"
								data-biz-name="subjectId" data-name="subjectId"  data-search="true" data-defaultvalue="$!{search.subjectId}"></div>
					</div>
				</td>

			</tr>


			<tr>
				##日期
				<td class="textRight">#springMessage("table.fcOutSubjectDay.optDate")</td>
				<td width="25%">
					<div class=layui-inline>
						<input id="t1"class="layui-input bt-input-inline bt-biz-dateType" type=text name="le_balanceDate"  data-endid="t2" value="$!{lBalanceDate}" lay-verify="required">
						<span class=date-mid>~</SPAN>
						<input id=t2 class="layui-input bt-input-inline bt-biz-dateType" type=text name="ge_balanceDate" value="$!{gBalanceDate}" lay-verify="required">
					</div>
				</td>
				<td ></td>
				<td ></td>
			</tr>


			##查询条件
			<input type="hidden" name="" value="">
			<input type="hidden" name="" value="">
			<input type="hidden" name="" value="">
			<input type="hidden" name="" value="">
			<input type="hidden" name="" value="">
			<input type="hidden" name="" value="">




			<!--提交按钮 -->
			<tr>
	   			<td style="text-align: center;" colSpan="6">
	 				 <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
            		 <button id="reset" type="button"  class="layui-btn layui-btn-primary" >#springMessage('common.button.reset')</button>
            		 <button class="layui-btn" lay-submit lay-filter="excel">#springMessage('common.button.exports')</button>
	   				 <button class="layui-btn bt-biz-printType" type="button" data-printareaid="print">打印</button>
	   			</td>
			</tr>
			</tr>
		</tbody>
	</table>
</form>

<div id="print">
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="print">
    <thead>
   	 <tr>
        <th>#springMessage('table.fcLessPayBill.account')</th>##账号
        <th style="max-width: 270px">#springMessage('table.accountDTO.accName')</th>##户名
        <th>#springMessage('table.fcOutAccbook.direction')</th>##方向
        <th>#springMessage('table.accountSummary.beginning_balance')</th>##期初余额
       	<th>#springMessage('table.fcAccbookDtlHis.debitMoney')</th>##借方发生额
       	<th>#springMessage('table.fcAccbookDtlHis.creditMoney')</th>##贷方发生额
       	<th>#springMessage('table.accbook.endMoney')</th>##期末余额

   	 </tr>
    </thead>

    <tbody>
   		#foreach($item in $list)
   		#set($account = $!{item.account})

   		##币别/日期
   		<tr>
    		#if("$!{item.accName}" == "")
    			#set($account=$item.account)
    			#set($accountArray=$account.split("_"))
    			<td colSpan="7" style='color: red;'>
    				#foreach($acc in $accountArray)
    					&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    					$!{acc}
    					&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    					&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    				#end
    			</td>

    		#else

    			<td style="text-align: center;">$!{item.account}</td>
    			<td style="text-align: center;max-width: 270px;word-break: break-all;white-space:normal;">$!{item.accName}</td>
    			<td style="text-align: center;">$!{item.balanceName}</td>
    			<td style="text-align: right;">$number.formatNumeric($!{item.yesterBalance})</td>
    			<td style="text-align: right;">$number.formatNumeric($!{item.debitMoney})</td>
    			<td style="text-align: right;">$number.formatNumeric($!{item.creditMoney})</td>
    			<td style="text-align: right;">$number.formatNumeric($!{item.balance})</td>
    		#end
    		</tr>
    	#end
    </tbody>

</table>
</div>

#parse("views/common/footer.vm")
<script src="${basePath}/static/modules/finacial/report/accountChange.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .tableHead {
            background-color: #f2f2f2
        }

        .tableHead td {
            padding: 6px 10px 6px 18px;
            font-weight: 700;
            font-size: 12px;
            border: 1px solid #e2e2e2;
            text-align: center;
            line-height: 22px;
        }

    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="searchFlag" id="searchFlag" value="0">
    <input type="hidden" id="total" value="$!{total}">
    <input type="hidden" id="currentPage" value="$!{curr}">
    <input type="hidden" name="blnctrAcc" value="$!{searchVO.account}">
    <input type="hidden" id="netName" value="$!{accountVo.netName}">
    <input type="hidden" id="initStartDate" value="$!date.format("yyyy-MM-dd",$!{initStartDate})">
    <input type="hidden" id="curDate" value="$!date.format("yyyy/MM/dd",$!{curDate})">
    <table class="layui-table">
        <tbody>
        <tr style="border: 0px;">
            ##单位
            <td class="textRight">#springMessage("table.accountStatement.corpName")</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-biz-name="corpId"
                         data-name="corpId"
                         data-group="corpGroup"
                         data-scope="all"
                         data-resource="finacial:account:statement:print"
                         data-callback="selectNetTable"
                         data-defaultvalue="$!{searchVO.corpId}"></div>
                </div>
            </td>

            ##账号
            <td class="textRight">#springMessage("table.fcLessPayBill.account")</td>
            <td>
                <div class=layui-input-inline>
                    <input id="account" class="layui-input" type="type" name="account" data-biz-name="selectTable"
                           value="$!{account}">
                </div>
            </td>
            ##凭证种类
            <td class="textRight">
                #springMessage('table.fcAccbook.voucherType')
            </td>
            <td class="rCode">
                <div class="bt-biz-selectType" data-name="voucherType" data-defaultvalue="$!{searchVO.voucherType}"
                     data-biz-name="voucherType"
                     data-url="${basePath}/netbank/fcvouchertype/getValidVoucherType" data-valuefield="id"
                     data-textfield="voucherName"></div>
            </td>
        </tr>
        <tr>
            ##币别
            <td class="textRight">#springMessage("table.fbsBudgetDetail.curId")</td>
            <td>
                <div class=bt-biz-selectType data-name="curId" data-textField="curName" data-valueField="id"
                     data-url="${basePath}/basic/business/btcurrency/json" data-biz-name="curId"
                     data-defaultvalue="$!{searchVO.curId}"></div>
            </td>
            ##记账日期
            <td class="textRight">#springMessage('fcAccDetail.tallyDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-biz-name="startDate" name="startDate"
                           class="layui-input bt-input-inline bt-biz-dateType" data-endid="endDate"
                           value="$!date.format("yyyy-MM-dd",$!{searchVO.startDate})">
                    <span class="date-mid">~</span>
                    <input type="text" data-biz-name="endDate" name="endDate"
                           class="layui-input bt-input-inline bt-biz-dateType" id="endDate"
                           value="$!date.format("yyyy-MM-dd",$!{searchVO.endDate})">
                </div>
            </td>
            ##摘要
            <td class="textRight">#springMessage('fcAccDetail.summaryContent')</td>
            <td>
                <input type="text" id="summaryContent" name="summaryContent" value="$!{searchVO.summaryContent}"
                       autocomplete="off" class="layui-input"
                       placeholder="#springMessage('fcAccDetail.summaryContent')">
            </td>
        </tr>

        <!--提交按钮 -->
        <tr>
            <td style="text-align: center;" colSpan="6">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button id="reset" type="button" class="layui-btn layui-btn-primary"
                >#springMessage('common.button.reset')</button>
                <button class="layui-btn " lay-submit lay-filter="excel">#springMessage(
                    'common.button.exports')</button>
                <button id="printBt" class="layui-btn" type="button">#springMessage(
                    'common.button.print')</button> ##data-printareaid="print"
                <button id="printBatch" class="layui-btn" type="button">#springMessage(
                    'common.button.batchPrint')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<div id="accountStatementHeaderInfoContainer"
     style="display: flex;flex-direction:row;justify-content: space-between;align-items: center;width:100%;margin-top: 5px;margin-bottom: 5px;">
    <span id="accountShowContainerElement"
          style="flex: 1;justify-content: center;align-items: center;text-align: center;">#springMessage(
        "table.accountStatement.account"):$!{accountVo.account}</span>
    <span id="accNameShowContainerElement"
          style="flex: 1;justify-content: center;align-items: center;text-align: center;">#springMessage(
        'table.accountStatement.accName'):$!{accountVo.accName}</span>
    <span id="yesterBalanceShowContainerElement"
          style="flex: 1;justify-content: center;align-items: center;text-align: center;">#springMessage(
        'table.accountStatement.beginningBalance'):$!number.formatNumeric($!{accountVo.yesterBalance})</span>
    <span id="curNameShowContainerElement"
          style="flex: 1;justify-content: center;align-items: center;text-align: center;">#springMessage(
        "table.accountStatement.curId"):$!{accountVo.curName}</span>
</div>
<!-- 用于打印，打印时候分页时，需加上一个上页余额 -->
<div id="print" style="display: none">
    <table id="appTable" class="layui-table layui-form dark-layui-table" style="width:100%;" data-btns="print">
        <thead>
        <tr class="tableHead">
            <td align="center">#springMessage("fcAccDetail.tallyDate")</td>##记账日期
            <td align="center">#springMessage('table.fcCompareAcc.interestStartDate')</td>##起息日期
            <td align="center">#springMessage('table.accountStatement.voucherNo')</td>##凭证号
            <td align="center">#springMessage('table.fcAccbook.voucherType')</td>##凭证种类
            <td align="center">#springMessage('table.fbsBudgetProcess.billNo')</td>##单据号
            <td align="center">#springMessage('table.fcAccbookDtl.summaryContent')</td>##摘要
            <td align="center">#springMessage('table.fcAccbookDtlHis.debitMoney')</td>##借方发生额
            <td align="center">#springMessage('table.fcAccbookDtlHis.creditMoney')</td>##贷方发生额
            <td align="center">#springMessage('table.fcAccbookDtl.balance')</td>##余额
        </tr>
        </thead>
        <tbody>
            #foreach($accountDtlVO in $!{accountVo.accountDtlVOList})
                #if($accountDtlVO.tallyDate)
                <tr>
                    <td align="center">$!date.format("yyyy-MM-dd",$!{accountDtlVO.tallyDate})</td>
                    <td align="center">$!date.format("yyyy-MM-dd",$!{accountDtlVO.interestStartDate})</td>
                    <td align="center">$!{accountDtlVO.voucherNo}</td>
                    <td align="center">$!{accountDtlVO.voucherName}</td>
                    <td align="center">$!{accountDtlVO.billNo}</td>
                    <td align="center">$!{accountDtlVO.summaryContent}</td>
                    <td align="right">$!number.formatNumeric($!{accountDtlVO.debitMoney})</td>
                    <td align="right">$!number.formatNumeric($!{accountDtlVO.creditMoney})</td>
                    <td align="right">$!number.formatNumeric($!{accountDtlVO.balance})</td>
                </tr>
                #else
                <tr>
                    <td align="center">#springMessage('table.fcAccbookDtl.upbalance')</td>
                    <td align="right" colspan="8">$!number.formatNumeric($!{accountDtlVO.balance})</td>
                </tr>
                #end
            #end
        <tr>
            <td align="center">#springMessage('common.button.collect'):</td>##汇总
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td align="right">$!number.formatNumeric($!{accountVo.debitMoneySum})</td>
            <td align="right">$!number.formatNumeric($!{accountVo.creditMoneySum})</td>
            <td></td>
        </tr>
        </tbody>
    </table>
</div>
<!-- 用于列表显示 -->
<div>
    <table id="appTable" class="layui-table layui-form dark-layui-table" style="width:100%;">
        <thead>
        <tr class="tableHead">
            <td align="center">#springMessage("fcAccDetail.tallyDate")</td>##记账日期
            <td align="center">#springMessage('table.fcCompareAcc.interestStartDate')</td>##起息日期
            <td align="center">#springMessage('table.accountStatement.voucherNo')</td>##凭证号
            <td align="center">#springMessage('table.fcAccbook.voucherType')</td>##凭证种类
            <td align="center">#springMessage('table.fbsBudgetProcess.billNo')</td>##单据号
            <td align="center">#springMessage('table.fcAccbookDtl.summaryContent')</td>##摘要
            <td align="center">#springMessage('table.fcAccbookDtlHis.debitMoney')</td>##借方发生额
            <td align="center">#springMessage('table.fcAccbookDtlHis.creditMoney')</td>##贷方发生额
            <td align="center">#springMessage('table.fcAccbookDtl.balance')</td>##余额
        </tr>
        </thead>
        <tbody>
            #foreach($accountDtlVO in $!{accountVo.accountDtlVOList})
                #if($accountDtlVO.tallyDate)
                <tr>
                    <td align="center">$!date.format("yyyy-MM-dd",$!{accountDtlVO.tallyDate})</td>
                    <td align="center">$!date.format("yyyy-MM-dd",$!{accountDtlVO.interestStartDate})</td>
                    <td align="center">$!{accountDtlVO.voucherNo}</td>
                    <td align="center">$!{accountDtlVO.voucherName}</td>
                    <td align="center">$!{accountDtlVO.billNo}</td>
                    <td align="center">$!{accountDtlVO.summaryContent}</td>
                    <td align="right">$!number.formatNumeric($!{accountDtlVO.debitMoney})</td>
                    <td align="right">$!number.formatNumeric($!{accountDtlVO.creditMoney})</td>
                    <td align="right">$!number.formatNumeric($!{accountDtlVO.balance})</td>
                </tr>
                #else
                #end
            #end
        <tr>
            <td align="center">#springMessage('common.button.collect'):</td>##汇总
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td align="right">$!number.formatNumeric($!{accountVo.debitMoneySum})</td>
            <td align="right">$!number.formatNumeric($!{accountVo.creditMoneySum})</td>
            <td></td>
        </tr>
        </tbody>
    </table>
</div>
<div id="page" style="position:fixed ; bottom:0px;width:100%"></div>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/finacial/report/accountStatement.list.js?_btv=${resourceVersion}"></script>
</html>

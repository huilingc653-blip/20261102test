<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #page .wrapper {
            margin-right: 20px;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" id="currentPage" value="1">
    <input type="hidden" id="count" value="1">
    <table class="layui-table">
        <tr>
            ##网点
            <td class="textRight">#springMessage('table.fcAcc.netId')</td>
            <td class="rCode">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-biz-type="net" data-type="selectTree"
                         data-resource="finacial:fcbookdtl:query"
                         data-name="netId" data-scope="net" data-biz-name="netId" data-defaultvalue="$!{netId}"></div>
                </div>
            </td>
            ##记账日期
            <td class="textRight">#springMessage('table.fcAccbook.tallyDate')</td>
            <td class="rCode">
                <div class="layui-inline">
                    <input type="text" name="gedTallyDate" data-type="date" data-biz-name="gedTallyDate"
                           class="layui-input bt-biz-dateType" data-endid="startDate" value="$!{gedTallyDate}">
                </div>
                <div class="layui-inline">~</div>
                <div class="layui-inline">
                    <input type="text" name="ledTallyDate" data-type="date" data-biz-name="ledTallyDate"
                           class="layui-input bt-biz-dateType" id="startDate" value="$!{ledTallyDate}">
                </div>
            </td>
            ##凭证状态
            <td class="textRight">#springMessage('table.fcAccbook.voucherState')</td>
            <td class="rCode">
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="select" data-name="voucherState" data-biz-name="voucherState"
                         data-group="Finacial.VoucherState" data-defaultvalue="$!{voucherState}"
                         data-filterData="T,F,C,D,M,W"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##帐号
            <td class="textRight">#springMessage('table.fcAccbookDtl.account')</td>
            <td class="rCode">
                <div class="layui-inline">
                    <input type="text" name="account" id="account" class="layui-input text" data-biz-name="account"
                           value="$!{account}">
                    <table id="example" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage("table.fcAccbookDtl.account")</th>
                            <th>#springMessage("table.fcAccbookDtl.accName")</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
            ##凭证号
            <td class="textRight">#springMessage('table.fcAccbook.voucherNo')</td>
            <td class="rCode">
                <div class="layui-inline">
                    <input type="text" name="gesVoucherNo" value="$!{gesVoucherNo}" id="gesVoucherNo"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.fcAccbook.voucherNo')">
                </div>
                <div class="layui-inline">~</div>
                <div class="layui-inline">
                    <input type="text" name="lesVoucherNo" value="$!{lesVoucherNo}" id="lesVoucherNo"
                           autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.fcAccbook.voucherNo')">
                </div>
            </td>
            ##币别
            <td class="textRight">
                #springMessage('table.fcBusinessRuleDefine.curCode')
            </td>
            <td class="rCode">
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-biz-name="curCode"
                         data-url="${basePath}/basic/business/btcurrency/json"
                         data-valuefield="id" data-textfield="curName" data-name="curCode"
                         data-defaultvalue="$!{curCode}"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##科目
            <td class="textRight">
                #springMessage('table.fcAccbookDtl.subjectCode')
            </td>
            <td class="rCode">
                <div class="bt-biz-selectType" data-biz-name="subjectId"
                     data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSubjectDate" data-valuefield="id"
                     data-textfield="subjectName" data-name="subjectId" data-search="true"
                     data-defaultvalue="$!{subjectId}"></div>
            </td>

            ##借方发生额
            <td class="textRight">#springMessage('table.fcAccbookDtl.debitMoney')</td>
            <td class="rCode">
                <div class="layui-inline">
                    <input type="text" name="debitMoney" class="layui-input bt-input-inline  bt-biz-moneyType"
                           data-biz-name="debitMoney" data-moneyendid="debitMoney" value="$!{debitMoney}">
                </div>
            </td>
            ##贷方发生额
            <td class="textRight">#springMessage('table.fcAccbookDtl.creditMoney')</td>
            <td class="rCode">
                <div class="layui-inline">
                    <input type="text" name="creditMoney" class="layui-input bt-input-inline  bt-biz-moneyType"
                           data-biz-name="creditMoney" data-moneyendid="creditMoney" value="$!{creditMoney}">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary"
                        >#springMessage('common.button.reset')</button>
                <button class="layui-btn " lay-submit lay-filter="excel">#springMessage(
                    'common.button.exports')</button>
                ##						<button class="layui-btn bt-biz-printType" type="button" data-printareaid="print">打印</button>
                <button id="printBt" class="layui-btn" type="button">#springMessage('common.button.print')</button>
                <button id="printBatch" class="layui-btn" type="button">#springMessage('common.button.batchPrint')</button>
            </td>
        </tr>
    </table>
</form>

<input type="hidden" id="netName" value="">

<div id="tbl" style="width:100%;overflow:auto">
    <div id="headInfoContainerElement">
        <table width="100%" align="center" style="border: 0px;margin-top: 5px;font-family: 'Microsoft YaHei';">
            <tr>
                <td align="right" width="15%">#springMessage('table.fcAccbookDtl.account')：</td>
                <td colspan="2" width="15%"><span id="accountStr"></span></td>
                <td align="right" width="15%">#springMessage("table.fcAccbookDtl.accName")：</td>
                <td width="25%"><span id="accName"></span></td>
                <td align="right" width="15%">#springMessage('table.fcBusinessRuleDefine.curCode')：</td>
                <td width="15%"><span id="curName"></span></td>
            </tr>
            <tr>
                <td align="right">#springMessage('table.fcAccbookDtl.subjectCode')：</td>
                <td colspan="2"><span id="subjectName"></span></td>
                <td align="right"></td>
                <td></td>
                <td align="right">#springMessage('table.accountSummary.beginning_balance')：</td>
                <td><span id="beginningBalance"></span></td>
            </tr>
        </table>
    </div>


    <div id="print" class="print-list">
        <table id="appTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th rowspan="2" width="10%">#springMessage('table.fcAccbook.tallyDate')</th>
                <th rowspan="2" width="15%">#springMessage('table.fcAccbook.voucherNo')</th>
                <th rowspan="2" width="10%">#springMessage('table.fcAccbook.voucherType')</th>
                <th rowspan="2" width="15%">#springMessage('table.fcAccbookDtl.summaryContent')</th>
                <th rowspan="2" width="10%">#springMessage('table.fcAccbookDtl.debitMoney')</th>
                <th rowspan="2" width="10%">#springMessage('table.fcAccbookDtl.creditMoney')</th>
                <th colspan="2" width="30%">#springMessage('table.accountSummary.end_of_term')</th>
            </tr>
            <tr>
                <th width="15%">#springMessage('table.fcAccBalance.balanceWay')</th>
                <th width="15%">#springMessage('table.fcAccbookDtlHis.balance')</th>
            </tr>
            </thead>
            ## 注释掉表尾，因为打印时会每页都显示，合计看上去就不合理
            ##            </thead>
            ##            <tfoot>
            ##            <tr id="sum">
            ##                <td align="center">#springMessage('table.interet.sum')</td>
            ##                <td></td>
            ##                <td></td>
            ##                <td></td>
            ##                <td name="sumDebitMoney" align="right"></td>
            ##                <td name="sumCreditMoney" align="right"></td>
            ##                <td></td>
            ##                <td></td>
            ##            </tr>
            ##            </tfoot>
        </table>
    </div>
    <div id="page" style="position:fixed ; bottom:0px;width:100%"></div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/report/export.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/finacial/report/fcbookDtl.list.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")

<style type="text/css">
.layui-body2 {
	padding：0px;
	position: absolute;
	left: 0px;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 2000;
	width: auto;
	overflow: hidden;
	overflow-y: auto;
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box;
}
</style> 
</head>
<body>
<div class="layui-body2" style="width: 100%; height: 100%">
	<div class="layui-tab layui-tab-brief"  style="width: 100%; height: 605px">
		<ul class="layui-tab-title">
			<li class="layui-this" lay-id="sendbook">#springMessage('cms.provide.send')</li>##发放
			<li lay-id="topbook">#springMessage('cms.provide.online.loanRepay')</li>##线上还款
			<li lay-id="downbook">#springMessage('cms.provide.Offline.loanRepay')</li>##线下还款
			<!-- <li lay-id="confirmbook">还款确认</li> -->
		</ul>
    	<div class="layui-tab-content" style="width: 100%; height: 100%">
    	
      		##银行借款发放
       		<div class="layui-tab-item layui-show" style="width: 100%; height: 100%">
           		<iframe id="sendbook" src="${basePath}/finacial/bankCollect/provideSendTally/manualPage?opType=$!{opType}&menuType=21" frameborder="0" style="width: 100%; height: 100%"></iframe>
       		</div>
        
         	##线上还款
       	  	<div class="layui-tab-item" style="width: 100%; height: 100%">
         		<iframe id="topbook" src="${basePath}/finacial/bankCollect/provideSendTally/manualPage?opType=$!{opType}&menuType=22&onlineSign=1" frameborder="0" style="width: 100%; height: 100%"></iframe>
       		</div>
         
         	##线上还款
       		<div class="layui-tab-item" style="width: 100%; height: 100%">
         		<iframe id="downbook" src="${basePath}/finacial/bankCollect/provideSendTally/manualPage?opType=$!{opType}&menuType=23&onlineSign=0" frameborder="0" style="width: 100%; height: 100%"></iframe>
         	</div>
         	
         	##还款确认
       	<!-- 	<div class="layui-tab-item" style="width: 100%; height: 100%">
         		<iframe id="confirmbook" src="${basePath}/finacial/bankCollect/provideSendTally/manualPage?opType=$!{opType}&menuType=24&confirm=true" frameborder="0" style="width: 100%; height: 100%"></iframe>
         	</div> -->
         	
       </div>
    </div>
</div> 
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['element', 'form','layedit','btdate'], function(){
	//注意：选项卡 依赖 element 模块，否则无法进行功能性操作 
	var $ = bt.jquery,form = bt.form();
	var element = layui.element();
});

</script>
</html>
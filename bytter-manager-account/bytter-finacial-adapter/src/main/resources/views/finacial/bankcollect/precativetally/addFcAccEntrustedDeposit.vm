function setTerm(ele,data){
	var startValue = $("#sendDate").val();
	var endValue = $("#deadlineDate").val();
	var startDate = new Date(startValue);
	var endDate = new Date(endValue);
	var ternUnit = dicts.get("endUnit").val();
	if(ternUnit == "M"){
		//$("#term").val((endDate.getYear() - startDate.getYear())*12 + endDate.getMonth() - startDate.getMonth());
		$("#notifyType").val(dataSubtract(startValue,endValue,"M"));
	}else if(ternUnit == "D"){
		$("#notifyType").val((endDate-startDate)/(1000*60*60*24));
	}
}

/**计算data1 与 data2 相差多少param单位 data为字符串*/
function dataSubtract(data1,data2,param){
    var dates;
	var start = new Date(data1);
    var end = new Date(data2);
    var addMonth = end.getMonth() - start.getMonth();//月份差
    var startLastDay = mGetDate(start.getYear(),start.getMonth());//开始时间当前月总共多少天
    var endLastDay = mGetDate(end.getYear(),end.getMonth());//结束时间当前月总共多少天
    if(startLastDay == start.getDate()){//开始日期月末最后一天
    	if(endLastDay == end.getDate()){//结束日期月末最后一天
    		addMonth ++;//月份+1
    	}else{
    		if(end.getDate() > start.getDate()){//结束日期当月天数 > 开始日期单月天数
	    		addMonth ++;//月份+1
	    	}
    	}
    }else{
    	if(endLastDay == end.getDate()){//结束日期月末最后一天
    		addMonth ++;//月份+1
    	}else{
    		if(end.getDate() > start.getDate()){//结束日期当月天数 > 开始日期单月天数
	    		addMonth ++;//月份+1
	    	}
    	}
    }
	dates = (end.getYear() - start.getYear())*12 + addMonth;     
    return  dates;
}

function mGetDate(year, month){
    var d = new Date(year, month  + 1, 0);
    return d.getDate();
}

//只能输入数字
function zhzs(value) {
    value = value.replace(/[^\d]/g, '');
    return value;
}

//截取科目代码
function subNum(subjectCode) {
    var codeNum = subjectCode + "000000";
    if (subjectCode.trim()) {
        codeNum = codeNum.substring(0,6);
    }
    return codeNum;
}



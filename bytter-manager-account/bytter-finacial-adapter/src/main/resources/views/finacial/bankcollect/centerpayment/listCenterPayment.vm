<script>
function submitData(data,action){
	data.field["accbook.attachmentId"] = uploader.getGroupId();
	bt.loading.show();//显示加载中
	if($("#opType").val() == 'listTallyChange'){
		data.field['opType'] = "MODIFY";
	}else if($("#opType").val() == 'listTally'){
		data.field['opType'] = "SUBMIT";
	}
	$.post(basePath + action,data.field,function(result){
		if(result.success){
			location.reload();
			parent.layer?parent.layer.closeAll():layer.closeAll();
		}
		bt.loading.hide(); //关闭加载中
		parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
	},'JSON');
	return false;
}
bt.use(['form','layedit','selectTable','btdate','bank','select','moneyType','dicts','bttable','element','datatable','mulselect','corp','dateType','selectType','region'], function(){
	var tableData ;
	element = layui.element();
    $ = bt.jquery,form = bt.form();
    tt = bt.mulselect.init();
    bt.bank.init({ elem:'.bank',})
    region = bt.region.init();
    moneyType = bt.moneyType.init();
    moneyFun = bt.moneyType.getFun();
    dataType = bt.dateType.init();
    bt.corp.init();
    selectType = bt.selectType.init();
    dicts = bt.dicts.init();
  	//监听暂存
    form.on('submit(temp)', function(data){
		var action = "/finacial/bankCollect/centerPayment/save";
    	return submitData(data,action);
    });
	
    //监听提交
    form.on('submit(submit)', function(data){
        var action = "/finacial/bankCollect/centerPayment/submit";
        return submitData(data,action);
    });
    
    //监听打回
    form.on('submit(back)', function(data){
    	bt.loading.show();//显示加载中
        var action = "/finacial/bankCollect/centerPayment/back";
        parent.layer.prompt({
	        	title: bt.lang('table.cmsLoanInfo.refuseWhy'),
	        	formType: 2,
	        	cancel: function(index, layero){
	        		bt.loading.hide(); //关闭加载中
	        	},
	        	end:function(){
	        		bt.loading.hide(); //关闭加载中
	        	}
        	},function(pass){
				data.field['bookExt.invalidReason'] = pass;
				//内部参数配置不一致,转换为枚举参数
				if($("#opType").val() == 'listTallyChange'){
					data.field['opType'] = "MODIFY";
				}else if($("#opType").val() == 'listTallyCheck'){
					data.field['opType'] = "CHECK";
				}
				$.post(basePath + action,data.field,function(result){
				   if(result.success){
				   	location.reload();
				       parent.layer?parent.layer.closeAll():layer.closeAll();
				   }
				   bt.loading.hide(); //关闭加载中
				   parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
				},'JSON');
        	});
        return false;
    }); 
  
    //监听通过
    form.on('submit(pass)', function(data){
    	bt.loading.show();//显示加载中
        var action = "/finacial/bankCollect/centerPayment/pass";
        data.field['opType'] = "CHECK";
        $.post(basePath + action,data.field,function(result){
            if(result.success){
            	location.reload();
                parent.layer?parent.layer.closeAll():layer.closeAll();
            }
            bt.loading.hide(); //关闭加载中
            parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
        },'JSON');
        return false;
    });
    
    var rowMR=0;
    var rowFmtDtl=0;
    var initPrintMRTable=function(){
	    //生成列表
	    bt.bttable.init({
	    	elem: "#printMRTable",
	    	url: basePath+"/finacial/accbook/fcaccbook/getFcAccBookDtls",
	    	scrollX : false,
	    	scrollY : false,
	    	buttons: [],   
		      columns:[],            
		       tableInitCallback:function(){  
		    	   bt.dicts.init();
	          }
	    });
    }

    //初始化账号
    var initSelectAccount = function(row){
    	var selectTab = bt.selectTable.init({
			elem: "#example"+row,
			url: basePath+"/finacial/bankCollect/centerPayment/findFcAcc?voucherNo="+$("#key").val(),
			scrollX: true,
			scrollY:"200px",
			paging:true,
			searchInput:"#account"+row,
			columns: [
			    {data:"blnctrAcc",},
			    {data:"accName",},
			    {data:"subjectName",},
			],
			clickCallback:function(data){
				$("#account"+row).val(data.blnctrAcc);
				$("#accName"+row).text(data.accName);
				$("#baccName"+row).val(data.accName);
				// 加载现金流项目
				loadCashFlowItem(row, data.blnctrAcc, null, null);
			}
    	
       	});
    }
    
    //添加行
    var  add = function(bookDtl , rowMR){
    	var controlVo = bookDtl.controlVo;
    	var account = "";
    	if(controlVo.accountEditable){
    		account = '<td><div class="layui-inline"><input type="text" name="bookDtls[' + rowMR + '].account" id="account' + rowMR + '" class="layui-input text"  style="width: 100%" >'
      		 + '<table id="example' + rowMR + '">'
      		 + '	<thead>'
      		 + '    	<tr>'
      		 + '        	<th>' + bt.lang("table.fcAccbookDtl.account")+ '</th>'
      		 + '            <th>' + bt.lang("table.fcAccbookDtl.accName")+ '</th>'
      		 + '            <th>' + bt.lang("table.fcAccbookDtl.subjectCode")+ '</th>'
      		 + '    	</tr>'
      		 + '    </thead>'
      		 + '</table>'
      		 + '</div></td>';
    	}else{
    		account = '<td><div class="layui-inline"><input type="text" name="bookDtls[' + rowMR + '].account" id="account' + rowMR + '" value = "'+ ( bookDtl.account == null ? "" : bookDtl.account ) +'" class="layui-input text" readonly="readonly" style="width: 100%">'
   		 + '</div></td>';
    	} 
  		 + '</div></td>';
		var html='<tr row="'+rowMR+'">';
		if(controlVo.summaryEditable){
			html+='<td><input type="text" name="bookDtls[' + rowMR + '].summaryContent" id="summaryContent' + rowMR + '"  class="layui-input" maxlength="32" style="width: 100%" value = "'+ ( bookDtl.summaryContent == null ? "" : bookDtl.summaryContent ) +'"/></td>';
		}else{
			html+='<td><input type="text" name="bookDtls[' + rowMR + '].summaryContent" id="summaryContent' + rowMR + '"  class="layui-input" maxlength="32" style="width: 100%" value = "'+ ( bookDtl.summaryContent == null ? "" : bookDtl.summaryContent ) +'" readonly="readonly"/></td>';

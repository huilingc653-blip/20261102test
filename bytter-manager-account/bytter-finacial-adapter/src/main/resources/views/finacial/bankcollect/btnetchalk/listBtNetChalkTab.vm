<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")

<style type="text/css">
.layui-body2 {
	padding：0px;
	position: absolute;
	left: 0px;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 2000;
	width: auto;
	overflow: hidden;
	overflow-y: auto;
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box;
}
</style> 
</head>
<body>
<div class="layui-body2" style="width: 100%; height: 100%">
	<div class="layui-tab layui-tab-brief"  style="width: 100%; height: 100%">
		<ul class="layui-tab-title">
			<li class="layui-this" lay-id="rushbook">#springMessage("table.btNetChalk.payeeAcc")</li>
			<li lay-id="dialDownBook">#springMessage("下拨")</li>
			<li lay-id="otherReceiveBook">#springMessage("其他收款")</li>
			<li lay-id="otherPayBook">#springMessage("其他付款")</li>
			<li lay-id="oribook">#springMessage("table.btNetChalk.isCancel")</li>
		</ul>
    	<div class="layui-tab-content" style="width: 100%; height: 100%">
      	##收款
       	<div class="layui-tab-item layui-show" style="width: 100%; height: 100%">##listBtNetChalk
           	<iframe id="rushiframe" src="${basePath}/finacial/bankCollect/btnetchalk/list/Init" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>

			##下拨
			<div class="layui-tab-item" style="width: 100%; height: 100%">
				<iframe id="dialDownframe" src="${basePath}/finacial/bankCollect/bisAccDtlTally/list/Init" frameborder="0" style="width: 100%; height: 100%"></iframe>
			</div>

			##其他收款
			<div class="layui-tab-item" style="width: 100%; height: 100%">
				<iframe id="otherReceiveframe" src="${basePath}/finacial/bankCollect/otherReceive/list/Init" frameborder="0" style="width: 100%; height: 100%"></iframe>
			</div>

			##其他付款
			<div class="layui-tab-item" style="width: 100%; height: 100%">##listBtNetChalkCancel
				<iframe id="otherPayframe" src="${basePath}/finacial/bankCollect/bisAccDtlTallyOtherPay/list/Init" frameborder="0" style="width: 100%; height: 100%"></iframe>
			</div>

           ##已取消
           <div class="layui-tab-item" style="width: 100%; height: 100%">##listBtNetChalkCancel
           	<iframe id="oriiframe" src="${basePath}/finacial/bankCollect/btnetchalk/list/initCancel" frameborder="0" style="width: 100%; height: 100%"></iframe>
           </div>
       </div>
    </div>
</div> 
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['element', 'form','layedit','btdate'], function(){
	//注意：选项卡 依赖 element 模块，否则无法进行功能性操作
	var $ = bt.jquery,form = bt.form();
	var element = layui.element();
});

</script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
		<input type="hidden"  id="corp" value="$!{info.corpId}">
		<input type="hidden"  id="cur" value="$!{info.curId}">
		<input type="hidden"  id="net" value="$!{net.code}">
		<input type="hidden"  id="billCode" value="$!{send.billCode}">
		<input type="hidden"  id="sendDate" value="$!{send.sendDate}">
		<input type="hidden"  id="deadlineDate" value="$!{send.deadlineDate}">
		<input type="hidden"  id="lastSubjectId" value="$!{dto.subjectId}">
		<input type="hidden"  id="forDeductAcc" value="$!{dto.accForDeduct}">
		<input type="hidden"  id="interestSignValue" value="$!{dto.interestSign}">
        <input type="hidden" id="accAccNoRule" value="$!{accAccNoRule}">
        <table class="layui-table"> 
            <tbody> 
            <tr>
				##网点
                <td width="10%" class="textRight">#springMessage('table.fcAcc.netId')</td>
                <td width="40%">
                    <!-- <div class="layui-inline">
                        <div class="bt-biz-corp" data-biz-type="net" data-type="selectTree" data-name="netId" data-biz-name="netId" data-scope="net"
                   		 		 data-required="true" data-defaultvalue="$!{info.corpId}" data-disabled="true"></div>
					</div> -->
					$!{info.corpName}
					<input type="hidden" name="netId" id="netId" class="layui-input" value="$!{info.corpId}">
				</td>
            	##账户类别
                <td width="10%" class="textRight">#springMessage('table.fcAcc.accType')</td>
                <td width="40%">
                    <div class="layui-inline">
                        <select lay-filter="accType" lay-verify="required" name="accType" disabled="disabled">
                            <option value="">#springMessage("common.placeholder.select")</option>
                            #foreach($dict in $dictTag.list("InnerAccount.AccType"))
                                <option #if($!{subject.accType} == $dict.code) selected="selected" #end value="$dict.code">$dict.name</option>
                            #end
                        </select>
                    </div>
                	##科目代码
                    <div class="layui-inline">
                        <select lay-filter="subjectId" name="subjectId" id="subjectId" lay-verify="required" lay-search="">
                            <option value="" >#springMessage("common.placeholder.select")</option>
                        </select>
                    </div>
                </td>
			</tr>
            <tr>
				##币别
                <td class="textRight">#springMessage('table.fcAcc.curId')</td>
                <td>
                    <div class="layui-input-inline">
			         	<div class="bt-biz-selectType" data-biz-name="curId" data-url="${basePath}/basic/business/btcurrency/json"
			         		 	data-valuefield="id" data-textfield="curName" data-name="curId" data-disabled="true"
			         		 	data-search="true" data-defaultvalue="$!{info.curId}" data-required="true"></div>
			         	<input type="hidden" name="curCode" id="curCode" value="${curInfo.curCode}"/>
                    </div>
                    </div>
                </td>
            	##结算中心账号
                <td class="textRight">#springMessage('table.fcAcc.blnctrAcc')</td>
                <td>
                    <input type="text" id="blnctrAcc" name="blnctrAcc"
                           autocomplete="off" class="layui-input" readonly="readonly" placeholder="#springMessage('table.fcAcc.blnctrAcc')" readonly="readonly">
                </td>
            </tr>
            <tr>
				##顺序号
                <td class="textRight">#springMessage('table.fcAcc.seqNum')</td>
                <td>
					#*	<input type="text" id="seqNum" name="seqNum"
							   autocomplete="off" class="layui-input" readonly="readonly" placeholder="#springMessage('table.fcAcc.seqNum')">*#
                        #if($!{seqNumPage} == '0')
                            <input type="text" id="seqNum" name="seqNum" maxlength="$!{relen}"
                                   autocomplete="off" class="layui-input" onchange="getNum(this)"
                                   onkeyup="value=zhzs(this.value)"
                                   placeholder="#springMessage('table.fcAcc.seqNum')">
                        #else
                            <input type="text" id="seqNum" name="seqNum"
                                   autocomplete="off" class="layui-input" readonly="readonly"
                                   placeholder="#springMessage('table.fcAcc.seqNum')">
                        #end
				</td>
				##助记码
                <td class="textRight">#springMessage('table.fcAcc.shortcut')</td>
                <td>
                        <input type="text" id="shortcut" name="shortcut" lay-verify="strlength"
                               autocomplete="off" class="layui-input" data-maxlength="10" placeholder="#springMessage('table.fcAcc.shortcut')">
                </td>
            </tr>
            <tr>
				##开户单位ID
                <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
				<td>
					<div class="layui-inline">
                           <!-- <div class="bt-biz-corp" data-biz-type="corp" data-type="selectTree" data-name="corpId" data-biz-name="corpId" data-scope="all"
                   		 		 data-required="true" data-defaultvalue="$!{info.loanOpp}" data-disabled></div> -->
						$!{info.loanOppName}
						<input type="hidden" name="corpId" id="corpId" class="layui-input" value="$!{info.loanOpp}">
					</div>
				</td>
				##账户名称
                <td class="textRight">#springMessage('table.fcAcc.accName')</td>
                <td>
					<input type="text" id="accName" name="accName" lay-verify="required|strlength" value="$!{info.loanOppName}" class="layui-input">
                </td>
            </tr>
            <tr>
				##联行网点
                <td class="textRight">#springMessage('table.fcAcc.unionNet')</td>
                <td>
					<div class="layui-inline">
					    <div class="bt-biz-corp" data-biz-type="net" data-type="selectTree" data-callback="unionNetChange"
					         data-resource="netbank:innerAccount:fcAcc:query" data-name="unionNet" data-scope="net">
						</div>
					</div>
				</td>
				##联行账号
                <td class="textRight">#springMessage('table.fcAcc.unionAcc')</td>
				<td>
                    <div class="layui-input-inline">
                        <input type="text" name="unionAcc" lay-verify="tableData" id="unionAcc" class="layui-input acc" data-biz-name="unionAcc">
                    </div>
                </td>
			</tr>
            <tr>
            	##余额方向
                <td class="textRight">#springMessage('table.fcAcc.balanceWay')</td>
                <td>
                    <div class="layui-inline">
                        <select lay-filter="balanceWay" name="balanceWay" disabled="disabled">
                            <option value="0">#springMessage("common.placeholder.select")</option>
                            #foreach($dict in $dictTag.list("Admin.BalanceWay"))
                                <option #if($!{subject.balanceWay} == $dict.code) selected="selected" #end value="$dict.code">$dict.name</option>
                            #end
                        </select>
                    </div>
                </td>
                <td></td>
                <td></td>
            </tr>
            </tbody>
        </table>
		<table class="layui-table">
    <tbody>
    <tr>
    	##期限
        <td width="10%" class="textRight">#springMessage('table.fcAcc.term')</td>
        <td width="40%">
            <div class="layui-input-inline">
            	<input type="text" name="notifyType" id="notifyType" readonly="readonly" class="layui-input" lay-verify="required" value="$!{dto.notifyType}">
            </div>
            <div class="layui-inline">
                <div class="bt-biz-dict" data-type="select" data-group="PrecativeLoanInfo.ternUnit" data-value="$!{dto.endUnit}" 
                			data-defaultvalue="M" data-name="endUnit" data-biz-name="endUnit" data-callback="setTerm"></div>
            </div>
        </td>
        ##展期到期日期
        <td width="10%" class="textRight">#springMessage('table.fcAcc.delayDeadlineDate')</td>
        <td width="40%">
            <div class="layui-input-inline">
                <input type="text" name="delayDeadlineDate" value="$!date.format('yyyy-MM-dd',$!{dto.delayDeadlineDate})" class="layui-input bt-biz-dateType" >
            </div>
        </td>
    </tr>
    <tr>
        <td class="textRight">#springMessage('table.fcAcc.precationCorp')</td>
        <td>
            <div class="layui-inline">
                <!-- <div class="bt-biz-corp" data-type="selectTree" data-name="precationCorp" data-biz-name="precationCorp" data-defaultvalue="$!{info.precativeId}" 
                		data-scope="all" data-required="true" data-callbackData="precationCorpChange"></div> -->
                $!{info.precativeName}
				<input type="hidden" name="precationCorp" id="precationCorp" class="layui-input" value="$!{info.precativeId}">
            </div>
        </td>
        <td class="textRight">#springMessage('table.fcAcc.precationAcc')</td>
        <td>
            <div class="layui-input-inline">
                <input type="text" name="precationAcc" id="precationAcc" readonly="readonly" class="layui-input" value="$!{precationAcc}" data-biz-name="precationAcc">
            </div>
        </td>
    </tr>
    <tr>
    	##手续费率
        <td class="textRight">#springMessage('table.fcAcc.poundageRate')</td>
        <td>
            <input type="text" id="poundageRate" name="poundageRate" autocomplete="off" class="layui-input bt-biz-rateType" 
            			data-biz-name="poundageRate" placeholder="#springMessage('table.fcAcc.poundageRate')" value="$!{dto.poundageRate}">
        </td>
        ##扣息活期账户
        <td class="textRight">#springMessage('table.fcAcc.accForDeduct')</td>
        <td>
            <div class="layui-inline">
                <select  id="accForDeduct" name="accForDeduct" lay-verify="required">
                    <option></option>
                </select>
            </div>
        </td>

    </tr>
    <tr>
    	##逾期利率
        <td class="textRight">#springMessage('table.fcAcc.overdueRate')</td>
        <td>
            <input type="text" id="overdueRate" name="overdueRate" class="layui-input bt-biz-rateType"  data-biz-name="overdueRate"  data-biz-name="overdueRate" value="$!{dto.overdueRate}">
        </td>
        ##展期利率
        <td class="textRight">#springMessage('table.fcAcc.delayRate')</td>
        <td>
            <input type="text" id="delayRate" name="delayRate"
                    class="layui-input bt-biz-rateType" data-biz-name="delayRate" value="$!{dto.delayRate}" >
        </td>
    </tr>
    <tr>
	    ##计息标志
        <td class="textRight">#springMessage('table.fcAcc.interestSign')</td>
        <td>
            <div class="layui-inline">
                <input type="radio" lay-filter="interestSign" name="interestSign" value="1" title="#springMessage('table.fcAcc.interestSignOk')" #if($!{dto.interestSign} == 1) checked #end>
                <input type="radio" lay-filter="interestSign" name="interestSign" value="0" title="#springMessage('table.fcAcc.interestSignNo')" #if($!{dto.interestSign} == 0) checked #end>
            </div>
        </td>
	    ##利率
        <td class="textRight">#springMessage('table.fcAcc.interestRate')</td>
        <td>
            <input type="text" id="interestRate" name="interestRate"
                   autocomplete="off" class="layui-input bt-biz-rateType"  data-biz-name="interestRate" value="$!{dto.interestRate}">
        </td>
    </tr>
    <tr>
    	##合同编号
        <td class="textRight">#springMessage('table.fcAcc.contractNo')</td>
        <td>
            <input type="text" id="contractNo" name="contractNo" autocomplete="off" class="layui-input" lay-verify="required" value="$!{dto.contractNo}">
        </td>
        ##起息日期
        <td class="textRight">#springMessage('table.fcAcc.interestStartDate')</td>
        <td>
            <div class="layui-input-inline">
                <input type="text" name="interestStartDate" data-biz-name="interestStartDate" data-callback="clickNotice" 
                		lay-verify="required"  class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!{tallyDate})">
            </div>
        </td>
    </tr>
    <tr>
    	##预提标志	
        <td class="textRight">#springMessage('table.fcAcc.predrawSign')</td>
        <td>
            <div class="layui-inline">
                <!-- <select lay-filter="predrawSign" name="predrawSign">
                    <option value=" "></option>
                </select> -->
                <div class="bt-biz-dict" data-name="predrawSign" data-type="select" data-group="Admin.PredrawSign" data-value="$!{dto.predrawSign}"
                 		data-defaultvalue="2" data-required="true" data-filterData="1,4">
            </div>
        </td>
        ##到期日期
        <td class="textRight">#springMessage('table.fcAcc.deadlineDate')</td>
        <td>
            <div class="layui-input-inline">
                <input type="text" name="deadlineDate" data-biz-name="deadlineDate" lay-verify="required" 
                		data-callback="clickNotice" class="layui-input bt-biz-dateType" value="$!date.format('yyyy-MM-dd',$!{dto.deadlineDate})">
            </div>
        </td>
    </tr>
    <tr>
    	##开户日期
        <td class="textRight">#springMessage('table.fcAcc.accOpenTime')</td>
        <td>
            <div class="layui-input-inline">
                <input type="text" name="accOpenTime" readonly="readonly" value="$!date.format('yyyy-MM-dd',$!{tallyDate})" class="layui-input bt-biz-dateType" >
            </div>
        </td>
        ##启用日期
        <td class="textRight">#springMessage('table.fcAcc.accStartDate')</td>
        <td>
            <div class="layui-input-inline">
                <input type="text" name="accStartDate" lay-verify="required" readonly="readonly" value="$!date.format('yyyy-MM-dd',$!{tallyDate})" class="layui-input bt-biz-dateType" >
            </div>
        </td>
    </tr>
    </tbody>
</table>
	<table class="layui-table">
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" type="button" lay-submit="" lay-filter="submit">#springMessage('table.bisAccBal.btn.confirm')</button>
            </td>
        </tr>
    </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','select','corp','bankInfo','dateType','selectTableType','selectType','rateType','dicts','dateType'], function(){
	$ = bt.jquery;
	form = bt.form();
    corps = bt.corp.init();
    bt.bankInfo.init();
    selectType = bt.selectType.init();
   	rateType = bt.rateType.init();
    dateType = bt.dateType.init();
   	dicts = bt.dicts.init();
  	//监听提交
    form.on('submit(submit)', function(data){
    	var webObj = bt.navtab.getParentDom();
    	webObj.bt.jquery("#account2").val(data.field.blnctrAcc);
    	webObj.bt.jquery("#accName2").text(data.field.accName);
    	webObj.bt.jquery("#baccName2").val(data.field.accName);
    	data.field['accState'] = "N";
    	webObj.loanAcc = data.field;//委贷
        // 加载现金流项目
        var debitMoney = webObj.bt.jquery("#debitMoney2").val();
        var creditMoney = webObj.bt.jquery("#creditMoney2").val();
        var subjectId = $("select[name='subjectId']").find("option:selected").val();
        webObj.loadCashFlowItem(2, data.field.blnctrAcc, debitMoney, creditMoney, subjectId);
        bt.navtab.closeCurrent('false');
    });
  	//监控计息标志
    form.on('radio(interestSign)',function (data) {
        fn_interestSign(data.value);
        form.render();
    });
    /**
     * 生成账号
     */
    genBlnctrAcc = function() {
        /**
         * 自动生成顺序号
         */
        createSequence();
        var netCode = $("#net").val();
        //自定义属性值获取
        var curCode = $("#curCode").val();
        var subjectCode = $("select[name='subjectId']").find("option:selected").attr("data-subjectcode");
        var seqNum = $("#seqNum").val();
        if(!netCode || !seqNum || !curCode||!subjectCode){
            $("#blnctrAcc").attr("value","");
            return;
        }
        var rule = $("#accAccNoRule").val();
        if(rule == 4) {
            if (subjectCode && subjectCode.length > 0) {
                if (subjectCode.trim().length < 6) {
                    subjectCode = subNum(subjectCode);
                }
            }
        }
        $("#blnctrAcc").val(netCode + "" + curCode +""+subjectCode+""+seqNum);
        form.render();
    };
    
    
    /**
    自动生成序列号
    **/
   var createSequence=function(){
       var netId= $("#corp").val();
       var curId= $("#cur").val();
       var accType=$("select[name='accType']").val();
       /**
        如果为空不自动生成
        **/
       if(netId.length==0||curId.length==0||accType.length==0) {
           return;
       }
       var param={
           netId:netId,
           curId:curId,
           accType:accType,
           date:(new Date()).getTime()
       };
       var url=basePath + "/inneraccount/fcacc/createSequence";
       $.ajax({
           url: url, method: 'GET', data: param, async:false, dataType: 'json',
           success: function (data) {
               if (data) {
                   $("#seqNum").val(data.obj);
               }
               form.render();
           }
       });
   };

    /**
     * 手动生成账号
     */
    bt.genBlnctrManualAcc = function() {
        /**
         *	从末级科目得到计息标志和利率和透支利率，余额方向
         */
        lastSubjectChange();

        var netCode = $("#net").val();
        //自定义属性值获取
        var curCode = $("#curCode").val();

        var subjectCode = $("#subjectId").find("option:selected").attr("data-subjectcode");
        var seqNum = $("#seqNum").val();
        if(!netCode || !seqNum || !curCode||!subjectCode){
            $("#blnctrAcc").attr("value","");
            return;
        }
        //科目代码截取生成
        var rule = $("#accAccNoRule").val();
        if(rule == 4) {
            if (subjectCode && subjectCode.length > 0) {
                if (subjectCode.trim().length < 6) {
                    subjectCode = subNum(subjectCode);
                }
            }
        }
        $("#blnctrAcc").val(netCode + "" + curCode +""+subjectCode+""+seqNum);
    };

    /**
     * 手动生成顺序号
     * @param data
     * @returns {boolean}
     */
    getNum = function(data) {
        var poolSign = $("#poolSign").val();
        var netId= $('input[name="netId"]').val();
        var curId=$("select[name='curId']").val();
        var accType=$("select[name='accType']").val();
        var seqNumTemp = data.value;
        if(poolSign==1){
            netId=bt.selectType.get("netId").val();
        }
        /**
         如果为空不生成
         **/
        if(netId.length==0||curId.length==0||accType.length==0 || seqNumTemp.length == 0) {
            return;
        }
        var param={
            netId:netId,
            curId:curId,
            accType:accType,
            poolSign:poolSign,
            date:(new Date()).getTime(),
            seqNum:seqNumTemp
        };
        var url=basePath + "/inneraccount/fcacc/createSequence";
        $.ajax({
            url: url, method: 'GET', data: param, async:false, dataType: 'json',
            success: function (data) {
                if (data) {
                    $("#seqNum").val(data.obj);
                    bt.genBlnctrManualAcc();
                }
            }
        });
    }
   
   bt.unionAcc = function () {
       var unionNetId = $('input[name="unionNet"]').val();
       var curId = $("select[name='curId']").val();
       var url = basePath+"/inneraccount/fcacc/getAccountTableData";
       if(unionNetId && curId){
           var urldata={
               netId:unionNetId,
               corpId:unionNetId,
               curId:curId,
               type:''
           };
           $("#unionAcc").val("");
           bt.unionAccTable.get("unionAcc").setUrl(urldata);
       }
   };
   
   bt.unionAccTable=bt.selectTableType.init({
       elem:".acc",
       url: basePath+"/inneraccount/fcacc/getAccountTableData",
       paging:true,
       urldata:{
           type:'init'
       },
       columns:[
           {"data":"blnctrAcc",title:bt.lang("table.fcAcc.blnctrAcc")},
           {"data":"accName",title:bt.lang("table.fcAcc.accName")},
           {"data":"subjectName",title:bt.lang("table.fcAcc.subjectId")}
       ],
       clickCallback:function(data,$tr,$elem,full){
           
       },
       tableInitCallback:function(full,$elem){
       }
   });
   
/*    bt.precationAccTable=bt.selectTableType.init({
       elem:".precationAcc",
       url: basePath+"/inneraccount/fcacc/getAccountTableData",
       paging:true,
       urldata:{
           type:'init'
       },
       columns:[
           {"data":"blnctrAcc",title:bt.lang("table.fcAcc.blnctrAcc")},
           {"data":"accName",title:bt.lang("table.fcAcc.accName")},
           {"data":"subjectName",title:bt.lang("table.fcAcc.subjectId")}
       ],
       clickCallback:function(data,$tr,$elem,full){
    	   var blnctrAcc = data.blnctrAcc;
    	   $elem.val(blnctrAcc);
       }
   }); */

    /**
     *根据末级科目得到是否计息和透支利率 余额方向
     */
    var lastSubjectChange=function(){

        var balanceWay = $("#subjectId").find("option:selected").attr("data-balanceway");
        if(!balanceWay){
            return ;
        }
        $("select[name='balanceWay']").val(balanceWay);
    };

   $(function(){
	   	var accType=$("select[name='accType']").val();
        $.ajax({
            url: basePath+"/finacial/paramconfig/fcsubject/jsonSubjectDate/"+accType+"?tk="+(new Date()).getTime(),
            method: 'GET',
            dataType: 'json',
            success: function(data){
                $("#subjectId").empty();
                $("#subjectId").append("<option value=''>"+bt.lang("common.placeholder.select")+"</option>");
                if(data){
                    $.each(data,function(index){
                    	var lastSubjectId = $("#lastSubjectId").val();
                    	var str = "";
                    	if(lastSubjectId == data[index].id){
                    		str = "selected='selected'";
                    		bt.fn_chargeAcc("accForDeduct",$("select[name='accType']").val());
                    	}
                        $("#subjectId").append("<option value='"+data[index].id+"'"
                        + " data-balanceWay='"+data[index].balanceWay+"'"  //余额方向
                        + " data-interestSign='"+data[index].interestSign+"'"  //计息标志
                        + " data-interestRate='"+(data[index].interestRate==null?"":data[index].interestRate)+"'"  //利率
                        + " data-subjectCode='"+data[index].subjectCode+"'"   //科目代码
                        + " data-predrawSign='"+data[index].predrawSign+"'" + str //结息方式
                        + ">("+data[index].subjectCode+")"+ data[index].subjectName+"</option>");
                    });
                }
                form.render('select');
            }
        });
        var loanAcc = bt.navtab.getParentDom().loanAcc;
    	if(loanAcc != null && loanAcc != undefined){
    		$("#blnctrAcc").val(loanAcc.blnctrAcc);
    	}
    	fn_interestSign($("#interestSignValue").val());
        form.render();
   })
   
   form.on('select(subjectId)',function (data) {
		genBlnctrAcc(data.elem);
		form.render();
		bt.fn_chargeAcc("accForDeduct",$("select[name='accType']").val());
   });
   
   bt.fn_chargeAcc = function(elem,accType) {
       $("#"+elem).empty();
       $("#"+elem).append("<option value=' '>"+bt.lang("common.placeholder.select")+"</option>");
       var curId=$("select[name='curId']").val();
       var corpId=$('input[name="corpId"]');
       if(corpId && corpId.val()!=""){
           var param={
               curId:curId,
               corpId:corpId.val(),
               accType:accType,
               elem: elem,
               date:(new Date()).getTime()
           };
           var url= basePath+"/inneraccount/fcacc?getChangeAcc";
           $element(url,param,elem);
       }
   };

   $element = function (url,param,elem) {
       $.ajax({url: url, method: 'POST', data: param,dataType: 'json',
           success: function(data){
               if(data && data.obj!=null){
                   $.each(data.obj,function(index,item){
                	   var blnctrAcc = $("#forDeductAcc").val();
                	   var str = "";
                	   if(blnctrAcc == item.blnctrAcc){
                		   str = "selected='selected'"; 
                	   }
                       $("#"+elem).append("<option value="+item.blnctrAcc+" "+ str +">"+item.blnctrAcc+"</option>");
                   });
                   form.render('select');
               }
           }
       });
   };
   
   $callNotice = function(value) {
       if($("select[name='endUnit']").length>0){
           var endUnit = $("select[name='endUnit']").val();
           if($("#notifyType").length>0) {
               var dateFun = bt.dateType.getFun();//获取时间操作方法
               var startDate = curDate.get("interestStartDate").val();
               var deadlineDate = curDate.get("deadlineDate").val();

               if(startDate == "" || deadlineDate == ""){
                   return;
               }

               if(dateFun.compare(startDate,deadlineDate)>0){
                   layer.msg(bt.lang("nis.fcAcc.message.less.Due.value"));
               }
               if(endUnit == "D"){
                   var days = dateFun.getBetweenDay(startDate, deadlineDate);//运用getBetweenDay()，获取天数
                   $("#notifyType").val(days);
               }else if(endUnit == "M"){
                   var months = dateFun.getBetweenMonth(startDate, deadlineDate);
                   $("#notifyType").val(months);
               }else{
                   var years = dateFun.getBetweenYear(startDate, deadlineDate);
                   $("#notifyType").val(years);
               }
           }
       }

   }
})

function fn_interestSign(val) {
    if(val == "1"){
        if($("input[data-biz-name='interestRate']").length>0 ){
            $("input[data-biz-name='interestRate']").removeAttr("readonly");
            $("input[data-biz-name='interestRate']").attr("lay-verify","required");
        }
        if($("input[data-biz-name='overdueRate']").length>0) {
            $("input[data-biz-name='overdueRate']").attr("lay-verify", "required");
        }
        if($("select[name='predrawSign']").length>0 ){
            $("select[name='predrawSign']").removeAttr("disabled");
            $("select[name='predrawSign']").attr("lay-verify","required");
        }
        if($("#interestStartDate").length>0){
            $("#interestStartDate").parent().attr("lay-verify","required");
        }
        if( $("select[name='accForDeduct']").length>0){
            $("select[name='accForDeduct']").attr("lay-verify","required");
        }
        if($("input[data-biz-name='overdraftRate']").length>0 ){
            if($("select[name='overdraftSign']").length>0){
                var overdraftSign = $("select[name='overdraftSign']").val();
                if(overdraftSign == "D" || overdraftSign == "R"){
                    $("input[data-biz-name='overdraftRate']").attr("lay-verify","required");
                    $("input[data-biz-name='overdraftRate']").removeAttr("readonly");
                }
            }else{
                $("input[data-biz-name='overdraftRate']").attr("lay-verify","required");
                $("input[data-biz-name='overdraftRate']").removeAttr("readonly");
            }
        }
    }else{
        //利率
        if($("input[data-biz-name='interestRate']").length>0 ) {
            $("input[data-biz-name='interestRate']").attr("readonly", "readonly");
            $("input[data-biz-name='interestRate']").removeAttr("lay-verify");
            rateType.get("interestRate").val("");
        }
        if($("input[data-biz-name='overdueRate']").length>0) {
            $("input[data-biz-name='overdueRate']").removeAttr("lay-verify");
            rateType.get("overdueRate").val("");
        }
        //预提类型
        if($("select[name='predrawSign']").length>0 ) {
            var options = $("select[name='predrawSign']").find("option");
            options.attr("selected", false);
            $("select[name='predrawSign']").removeAttr("lay-verify");
            $("select[name='predrawSign']").attr("disabled", "disabled");
        }
        if($("#interestStartDate").length>0){
            $("#interestStartDate").parent().removeAttr("lay-verify");
        }
        if( $("select[name='accForDeduct']").length>0){
            $("select[name='accForDeduct']").removeAttr("lay-verify");
        }
        if($("input[data-biz-name='overdraftRate']").length>0){
            $("input[data-biz-name='overdraftRate']").removeAttr("lay-verify");
            $("input[data-biz-name='overdraftRate']").attr("readonly","readonly");
            rateType.get("overdraftRate").val("");
        }
    }
    form.renderIcon();
    form.render();
}

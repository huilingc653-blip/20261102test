<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 22px;
	text-decoration: underline;
	text-align: center;
	/*color: blue;*/
	/*color: #00CC33;*/
}
.sign{
    color: red;
}
body > .dataTables_wrapper {
    padding: 0;
}
@media screen and (max-width: 1366px) {
    body > .dataTables_wrapper {
        padding: 0;
    }
}
</style>
</head>
<body style="padding: 20px 5px 10px 5px;">
<form id="searchForm" class="layui-form">
	<input type="hidden" id="opType" name="opType" value="$!{opType}">
	<input type="hidden" id="menuType" name="menuType" value="$!{menuType}">
	<table class="layui-table">
		<tbody>
			<tr>
                    <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                    <td>
                        <div class="layui-inline">
                        	<div class="bt-biz-corp"
                                data-biz-type="corp"
                                data-type="selectTree"
                                data-name="likes_corpId"
                                data-resource="fcl:nisallocationreq:tally:apply"
                                data-scope="all"></div>
                        </div>
                    </td>
                    <td class="textRight">#springMessage('table.nisBillhead.voucherTypeId')</td>
                    <td>
                        <div class="layui-inline">
                            <div type="list" field="eqs_voucherTypeId" fieldHref="${basePath}/netbank/fcvouchertype/json" dictField="id" dictText="voucherName" defaultVal="$!{nisBillheadPage.voucherTypeId}"></div>
                        </div>
                    </td>
                    <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" data-name="geg_payMoney"
								autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <input type="text" data-name="leg_payMoney"
                                    autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                        </div>
                    </td>
                </tr>
				<tr>
                    <td class="textRight">#springMessage('table.nisBillhead.payeeAcc')</td>
                    <td>
                        <input type="text" name="likes_payeeAcc"
                                autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.nisBillhead.payeeAcc')">
                    </td>
                    <td class="textRight">#springMessage('table.nisBillhead.payeeAccName')</td>
                    <td>
                        <input type="text" name="likes_payeeAccName"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.payeeAccName')">
                    </td>
                    <td class="textRight">#springMessage('table.nisBillhead.wishPayday')</td>
                    <td>
                        <input type="text" name="ged_wishPayday" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_wishPayday" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_wishPayday" class="layui-input bt-input-inline bt-biz-dateType" id="led_wishPayday">
                    </td>
                </tr>
				<tr>
                    <td class="textRight">#springMessage('table.nisBillhead.billNo')</td>
                    <td>
                        <input type="text" name="likes_billNo"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.nisBillhead.billNo')">
                    </td>
                    <td class="textRight">#springMessage('table.nisBillhead.billFrom')</td>
                    <td>
						<div class="bt-biz-dict" data-type="select" data-filterData="2"
							data-group="nisBillhead.billFrom" data-name="eqs_billFrom"></div>
                    </td>
                    <td></td>
                    <td></td>
                </tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn">#springMessage('common.button.reset')</button>
				</td>
			</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
			<tr>
	            <th>#springMessage('table.nisBillhead.billNo')</th>
	            <th>#springMessage('table.nisBillhead.corpId')</th>
	            <th>#springMessage('table.nisBillhead.voucherTypeId')</th>
	            <th>#springMessage('table.nisBillhead.payerAcc')</th>
	            <th>#springMessage('table.nisBillhead.payerAccName')</th>
	            <th>#springMessage('table.nisBillhead.payerBank')</th>
	            <th>#springMessage('table.nisBillhead.curId')</th>
	            <th>#springMessage('table.nisBillhead.payMoney')</th>
	            <th>#springMessage('table.nisBillhead.payeeAcc')</th>
	            <th>#springMessage('table.nisBillhead.payeeAccName')</th>
	            <th>#springMessage('table.nisBillhead.payeeBankCode')</th>
	            <th>#springMessage('table.nisBillhead.payeeBank')</th>
	            <th>#springMessage('table.nisBillhead.wishPayday')</th>
                <th>#springMessage('table.btNetChalk.transTime')</th>
	            <th>#springMessage('table.nisBillhead.busType')</th>
	            <th>#springMessage('table.nisBillhead.purpose')</th>
	            <th>#springMessage('table.nisBillhead.billFrom')</th>
	            <th>#springMessage('table.cmsPrecativeLoanInfo.tallySign')</th>
                <th>#springMessage('fcVoucherType.rmk')</th>
            </tr>
	</thead>
</table>

#parse("views/common/footer.vm")
</body>
<script>
var datatable;
bt.use(['form','layedit','selectTable','btdate','bank','select','moneyType','dicts','bttable','element','datatable','mulselect','corp','dateType','selectType','region'], function(){
	var tableData ;
	element = layui.element();
    $ = bt.jquery;
    form = bt.form();
    tt = bt.mulselect.init();
    bt.bank.init({ elem:'.bank',})
    region = bt.region.init();
    moneyType = bt.moneyType.init();
    moneyFun = bt.moneyType.getFun();
    dataType = bt.dateType.init();
    bt.corp.init();
    selectType = bt.selectType.init();
    bt.dicts.init();
  	//下拉框
    $.each($("div[type='list']"),function(i,item){
        bt.select.init({
            elem: "[field='"+$(item).attr("field")+"']",
            name: $(item).attr("field"),
            defaultVal: $(item).attr("defaultVal"),
            valueField: $(item).attr("dictField"),
            textField: $(item).attr("dictText"),
            search: true,
            disabled: false,
            url: $(item).attr("fieldhref")
        });
    });
    var opType = $("#opType").val();
    var buttonName = "Finacial.accbook.common.button.batchAdd";
    if($("#opType").val() == 'Check'){
        buttonName = "Finacial.accbook.common.button.batchCheck";
    }else if($("#opType").val() == 'Edit'){
        buttonName = "Finacial.accbook.common.button.batchEdit";
    }

    var buttonOptions = [];
    if("Init" == opType){
        buttonOptions = [{text: bt.lang('Finacial.accbook.common.button.batchAdd'),
            action: function ( e, dt, node, config ) {
                var data = dt.rows('.selected').data();
                var len = data.length;
                if(len<1){
                    layer.msg("#springMessage('table.fcBankBill.msg.chooseLeastOne')");
                    return;
                }
                var rowData = data.splice(0,len);
                var billNos = "";
                var firstBillNo = "";//选中的第一笔单据的单据号
                var firstVoucherName = "";//选中的第一笔单据的付款方式
                var firstPayerAcc = "";//选中的第一笔单据的付款方式
                for (var i = 0; i < rowData.length; i++) {
                    if (billNos == "") {
                        billNos += rowData[i].billNo;
                        firstBillNo = rowData[i].billNo;
                        firstVoucherName = rowData[i].voucherName;
                        firstPayerAcc = rowData[i].payerAcc;
                    } else {
                        billNos += "," + rowData[i].billNo;
                        if(firstVoucherName != rowData[i].voucherName){
                            layer.msg("#springMessage('fc.tally.message.vouchertype.same')");
                            return;
                        }
                        if(firstPayerAcc != rowData[i].payerAcc){
                            layer.msg("#springMessage('fc.tally.message.payerAcc.same')");
                            return;
                        }
                    }
                }
                var type = $("#opType").val();
                var menuType = $("#menuType").val();
                parent.layer.open({
                    type: 2,
                    area: ['850px', '530px'],
                    maxmin: true,
                    content: basePath + "/finacial/bankCollect/manualFinacial/batchTally/" + billNos + "/" + type + "/" + firstBillNo + "/" + menuType
                });
            }
        }];
    } else if ("Edit" == opType){
        buttonOptions = [{text: bt.lang('Finacial.accbook.common.button.batchAdd'),
                            action: function (e, dt, node, config) {
                                var data = dt.rows('.selected').data();
                                submitEditPass(data);
                            }},
                            {text: bt.lang('common.button.batchBack'),
                            action: function (e, dt, node, config) {
                                var data = dt.rows('.selected').data();
                                submitEditBack(data);
                            }}];
    } else if ("Check" == opType){
        buttonOptions = [{text: bt.lang('common.button.batchadopt'),
            action: function (e, dt, node, config) {
                var data = dt.rows('.selected').data();
                submitPass(data);
            }},
            {text: bt.lang('common.button.batchBack'),
                action: function (e, dt, node, config) {
                    var data = dt.rows('.selected').data();
                    submitBack(data);
                }}];
    }


    //生成列表
    datatable = bt.datatable.init({
    	elem: "#appTable",
        dom: 'Brtlip',
        colReorder: true,
        checkbox:true,
        mulselect:true,
        selectCss:true,
        order: [[1, 'desc']],
        fixedColumns:{
        	leftColumns:0
        },
        ajax: {
            'url': basePath+"/finacial/bankCollect/manualFinacial/datatable"
        },searchForm:{
            formFilter:"search",
            formElem:"#searchForm"
        },
        buttons : buttonOptions,
        /* buttons: [{
            text: bt.lang("Finacial.accbook.common.button.add"),
            action: function ( e, dt, node, config ) {
            	var length = $("#printMRTable tbody>tr").length;
            	var data = dt.rows('.selected').data();
            	var len = data.length;
                if(len<1){
                	layer.msg("#springMessage('table.fcBankBill.msg.chooseLeastOne')");
                	return;
                }
                var rowData = data.splice(0,len);
             	var id = rowData[0].billNo;
             	var type = $("#opType").val();
             	var menuType = $("#menuType").val();
             	parent.$("#curCode").val(rowData[0].curId);
             	parent.$("#netId").val(rowData[0].corpId);
             	//parent.parent.$("#precativeId").val(rowData[0].precativeId);
             	//parent.parent.$("#loanOpp").val(rowData[0].loanOpp);
             	parent.$("#key").val(id);
             	$.post(basePath + "/finacial/bankCollect/manualFinacial/processAccbook/",{key:id,type:type,menuType:menuType}, function(result){
             		if(typeof result.success == "boolean" && result.success == false){
             			layer.alert(result.msg);
                    	return;
             		}
             		parent.bt.setDate(result);
             	},'JSON');
            }
        }
        ], */
        columns: [
            {data:"billNo",bSortable:true,className:'center'},
            {data:"corpName",bSortable:true},
            {data:"voucherName",bSortable:true},
            {data:"payerAcc",bSortable:true},
            {data:"payerAccName",bSortable:true},
            {data:"payerBank",bSortable:true},
            {data:"curName",bSortable:false},
            {data:"payMoney",bSortable:true,className:'textRight',
                render: function ( data, type, full, meta ) {
                	return bt.money.format(full.payMoney);
                }
            },
            {data:"payeeAcc",bSortable:true},
            {data:"payeeAccName",bSortable:true},
            {data:"payeeBankCode",bSortable:true},
            {data:"payeeBank",bSortable:true},
            {data:"wishPayday",bSortable:true,className:'center'},
            {data:"transTime",bSortable:true,className:'center'},
            {data:"busTypeName",bSortable:true},
            {data:"purpose",bSortable:true},
            {data:"billFrom",bSortable:true,className:'center',
                render: function ( data, type, full, meta ) {
                    return bt.dict("nisBillhead.billFrom",full.billFrom);
                }
            },
            {data:"tallySign",bSortable:false,className:"center",
			    render:function(data,type,full,meta){
                    if(full.tallySign == null || full.tallySign == ""){
                        full.tallySign = 0;
                    }
				   return bt.dict("cms.tallySign",full.tallySign == null ? 0 : full.tallySign );
				}
			},
            {data:"rmk",bSortable:true},
        ],
        btInitComplete:function(setting,json){
        	tableData = json.data;
        },
		btDrawCallback:function(setting){
        	tableData = setting.json.data;
        }
    });

    $('#appTable tbody').on('dblclick','tr',function(data){
        var dataIndex = $(this).context.rowIndex - 1;
        //var data = tableData.rows('.selected').data();
        rowData = tableData[dataIndex];
        var id = rowData.billNo;
     	var type = $("#opType").val();
     	var menuType = $("#menuType").val();
     	parent.$("#curCode").val(rowData.curId);
     	parent.$("#netId").val(rowData.corpId);
     	parent.$("#key").val(id);
     	parent.$("#menuType").val(menuType);
     	$.post(basePath + "/finacial/bankCollect/manualFinacial/processAccbook/",{key:id,type:type,menuType:menuType}, function(result){
     		if(typeof result.success == "boolean" && result.success == false){
     			layer.alert(result.msg);
            	return;
     		}
            //增加背景色
            var row = datatable.row(dataIndex).node();
            $(".row_bg").removeClass("row_bg");
            $(row).addClass("row_bg");
            parent.uploaderRender(type,result);
            result.interestStartDate = (null == rowData.transTime || rowData.transTime == undefined || "" == rowData.transTime) ? rowData.wishPayday : rowData.transTime;
     		parent.bt.setDate(result);
     	},'JSON');
	});
});

//批量复核通过
function submitPass(rowData) {
    var ids = "";
    for (var i = 0; i < rowData.length; i++) {
        if (ids == "") {
            ids += rowData[i].billNo;
        } else {
            ids += "," + rowData[i].billNo;
        }
    }

    if (ids != "") {
        //请确认批量提交所选记账凭证
        layer.confirm(bt.lang('fin.collect.check.batchSubmit.comfirm'), {icon: 3}, function () {
            bt.loading.show();
            $.post(basePath + "/finacial/bankCollect/nisBillhead/batchPass", {billNo: ids, menuType : $("#menuType").val(), opType : $("#opType").val()}, function (result) {
                if(result.success){
                    datatable.draw();
                }
                bt.loading.hide(); //关闭加载中
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            }, 'JSON');
        });
    } else {
        parent.layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 2});
        return false;
    }
    return false;
}

//批量复核打回
function submitBack(rowData) {
    var ids = "";
    for (var i = 0; i < rowData.length; i++) {
        if (ids == "") {
            ids += rowData[i].billNo;
        } else {
            ids += "," + rowData[i].billNo;
        }
    }

    if (ids != "") {
        //请确认批量提交所选记账凭证
        bt.loading.show();//显示加载中
        parent.layer.prompt({
            title: bt.lang('table.cmsLoanInfo.refuseWhy'),
            formType: 2,
            cancel: function(index, layero){
                bt.loading.hide(); //关闭加载中
            },
            end:function(){
                bt.loading.hide(); //关闭加载中
            }
        },function(reason){
            $.post(basePath + "/finacial/bankCollect/nisBillhead/batchBack", {billNo: ids, menuType : $("#menuType").val(), opType : $("#opType").val(), backReason : reason}, function (result) {
                if(result.success){
                    datatable.draw();
                    parent.layer?parent.layer.closeAll():layer.closeAll();
                }
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
                bt.loading.hide(); //关闭加载中
            }, 'JSON');
        });
    } else {
        parent.layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 2});
        return false;
    }
    return false;
}

//批量改账提交
function submitEditPass(rowData) {
    var ids = "";
    for (var i = 0; i < rowData.length; i++) {
        if (ids == "") {
            ids += rowData[i].billNo;
        } else {
            ids += "," + rowData[i].billNo;
        }
    }

    if (ids != "") {
        //请确认批量提交所选记账凭证
        layer.confirm(bt.lang('fin.collect.tally.batchSubmit.comfirm'), {icon: 3}, function () {
            bt.loading.show();
            $.post(basePath + "/finacial/bankCollect/nisBillhead/batchEditPass", {billNo: ids, menuType : $("#menuType").val(), opType : $("#opType").val()}, function (result) {
                if(result.success){
                    datatable.draw();
                }
                bt.loading.hide(); //关闭加载中
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            }, 'JSON');
        });
    } else {
        parent.layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 2});
        return false;
    }
    return false;
}

//批量改账打回
function submitEditBack(rowData) {
    var ids = "";
    for (var i = 0; i < rowData.length; i++) {
        if (ids == "") {
            ids += rowData[i].billNo;
        } else {
            ids += "," + rowData[i].billNo;
        }
    }

    if (ids != "") {
        //请确认批量提交所选记账凭证
        bt.loading.show();//显示加载中
        parent.layer.prompt({
            title: bt.lang('table.cmsLoanInfo.refuseWhy'),
            formType: 2,
            cancel: function(index, layero){
                bt.loading.hide(); //关闭加载中
            },
            end:function(){
                bt.loading.hide(); //关闭加载中
            }
        },function(reason){
            $.post(basePath + "/finacial/bankCollect/nisBillhead/batchEditBack", {billNo: ids, menuType : $("#menuType").val(), opType : $("#opType").val(), backReason : reason}, function (result) {
                if(result.success){
                    datatable.draw();
                    parent.layer?parent.layer.closeAll():layer.closeAll();
                }
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
                bt.loading.hide(); //关闭加载中
            }, 'JSON');
        });
    } else {
        parent.layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 2});
        return false;
    }
    return false;
}

</script>
</html>

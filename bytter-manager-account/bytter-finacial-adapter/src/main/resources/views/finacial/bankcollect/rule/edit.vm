<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<table id="typeTab" class="layui-table">
		<input id="opType" name="opType" type="hidden" value="$!{opType}">
			<tr>
		   		##业务种类Code
				<td class="textRight" width="25%">#springMessage('table.FcManualFinacialType.sysRaceCode')</td>
		   		<td width="25%">
		   			<input name="sysRaceCode" value="$!{finacialType.sysRaceCode}" lay-verify="required" class="layui-input" placeholder="#springMessage('table.FcManualFinacialType.sysRaceCode')">
		   			<input id="id" name="id" type="hidden" value="$!{finacialType.id}">
		   		</td>
		   		##业务种类名称
		   		<td class="textRight" width="25%">#springMessage('table.FcManualFinacialType.name')</td>
		   		<td width="25%">
					<input name="name" value="$!{finacialType.name}" lay-verify="required" class="layui-input" placeholder="#springMessage('table.FcManualFinacialType.name')">
		   		</td>
		   	</tr>
		   	<tr>
		   		##流程种类
				<td class="textRight" width="25%">#springMessage('table.FcManualFinacialType.flowType')</td>
		   		<td width="25%">
		   			<div class="bt-biz-dict" 
		         		data-name="flowType"
		         		data-value="$!{finacialType.flowType}"
		         		data-required="true"
		         		data-type="select" 
		         		data-biz-name="flowType" 
		         		data-group="manual.finacial.flow.type" >
		         	</div>
		   		</td>
		   		##数据列表地址
				<td class="textRight" width="25%">#springMessage('table.FcManualFinacialType.url')</td>
		   		<td width="25%">
		   			<input name="url" value="$!{finacialType.url}" lay-verify="required" class="layui-input" placeholder="#springMessage('table.FcManualFinacialType.url')">
		   		</td>
		   	</tr>
		</table>
		
		<table id="editTable" style="width:100%">
	        <thead>
	            <tr>
	                <th>#springMessage('table.FcManualFinacialColumn.writeBackTable')</th>
	                <th>#springMessage('table.FcManualFinacialColumn.businessId')</th>
	                <th>#springMessage('table.FcManualFinacialColumn.writeBackColumn')</th>
	                <th>#springMessage('table.FcManualFinacialColumn.writeBackValueType')</th>
	                <th>#springMessage('table.FcManualFinacialColumn.writeBackValueColumn')</th>
	                <th>#springMessage('common.table.thead.operation')</th>
	            </tr>
	        </thead>
	        <tbody>
	        	<!-- 模板 -->
	    		<tr style="display: none;">
		    		<td><input name="writeBackTable"  class="layui-input" placeholder="#springMessage('table.FcManualFinacialColumn.writeBackTable')"/></td>
	        		<td><input name="businessId"  class="layui-input" type="text" placeholder="#springMessage('table.FcManualFinacialColumn.businessId')"/></td>
	        		<td><input name="writeBackColumn" class="layui-input" type="text" placeholder="#springMessage('table.FcManualFinacialColumn.writeBackColumn')"/></td>
	        		<td><div data-name="writeBackValueType" data-group="manual.finacial.back.type" class="bt-biz-dict" data-type="select"></div></td>
	        		<td><input name="writeBackValueColumn" class="layui-input" type="text" placeholder="#springMessage('table.FcManualFinacialColumn.writeBackValueColumn')"/></td>
	        		<td><button type="button" data-type="del" class="layui-btn layui-btn-mini">#springMessage('common.button.delete')</button></td>
	        	</tr>
	        </tbody>
		</table>
		
		<div style="text-align: center;" class="layui-input-block">
	        <button class="layui-btn" lay-submit id="submitBut">#springMessage('common.button.submit')</button>
	        <button class="layui-btn" type="button" onClick="javascript:bt.navtab.closeCurrent();">#springMessage('common.button.close')</button>
	    </div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
bt.use(['form','jquery','selectType','dicts','bttable'], function(){
	$ = bt.jquery,form = bt.form();
    selectTypes = bt.selectType.init();//下拉框
    dicts = bt.dicts.init();//字典
    
  //初始化可编辑表格
    bt.bttable.init({
		elem: "#editTable",
		url: basePath+"/finacial/bankCollect/manualFinacial/getColumnByTypeId?id="+$("#id").val(),
		buttons: [
			{
				text: bt.lang('common.addTr'),
				action: function(e, dt, node, config){
					addTr();
				}
			}
		],
		columns:[
			{
				data:"writeBackTable",
				render:function(data, row){
					var s = '<input name="writeBackTable" value="'+ data.writeBackTable +'" class="layui-input" placeholder="'+bt.lang('table.FcManualFinacialColumn.writeBackTable')+'"/>';
					return s;
				}
			},
			{
				data:"businessId",
				render:function(data, row){
					var s = '<input name="businessId" value="'+ data.businessId +'" class="layui-input" type="text" placeholder="'+bt.lang('table.FcManualFinacialColumn.businessId')+'"/>';
					return s;
				}
			},
			{
				data:"writeBackColumn",
				render:function(data, row){
					var s = '<input name="writeBackColumn" value="'+ data.writeBackColumn +'" class="layui-input" type="text" placeholder="'+bt.lang('table.FcManualFinacialColumn.writeBackColumn')+'"/>';
					return s;
				}
			},
			{
				data:"writeBackValueType",
				render:function(data, row){
					var s = '<div data-name="writeBackValueType" data-defaultvalue="'+ data.writeBackValueType +'" data-group="manual.finacial.back.type" class="bt-biz-dict" data-type="select"></div>';
					return s;
				}
			},
			{
				data:"writeBackValueColumn",
				render:function(data, row){
					var s = '<input name="writeBackValueColumn" value="'+ (data.writeBackValueColumn == null ? "" : data.writeBackValueColumn) +'" class="layui-input" type="text" placeholder="'+bt.lang('table.FcManualFinacialColumn.writeBackValueColumn')+'"/>';
					return s;
				}
			},
			{
				data:null,
				render:function(data, row){
					var reInfo='<button type="button" data-type="del" class="layui-btn layui-btn-mini">'+bt.lang("common.button.delete")+'</button>';
					return reInfo;
				}
			}
		],
        tableInitCallback:function(){            
        	bt.dicts.init();
        },
		delRowCallback:function(data,$tr){
	    	$tr.remove();
	    }
    });
    
    
	//监听提交
	form.on('submit', function(d){
		bt.loading.show();//显示加载中
		var data = new Object();
		//类型主体
		var typeTds = $("#typeTab tbody");
		typeTds.each(function(ind,td){
			var inputs = $(td).find('[name]');
			inputs.each(function(index,inp){
				var name = $(inp).attr('name');
				if(typeof(name) != "undefined"){
					var text ;
					if(name == "flowType"){
	 					text = dicts.get(inp.name).val();
	 				}else{
	 					text = inp.value;
	 				}
					data[name] = text;
				}
			});
		});
		
		//获取集合数据
		var trs = $("#editTable tbody").children('tr:visible');
 		trs.each(function(ind,tr){
 			var tds = $(tr).children('td');
 			tds.each(function(index,td){
 				var $input = $(td).find('[name]');
 				var name = $input.attr('name');
 				if(typeof(name) != "undefined"){
 					var text ;
 					if(name == "flowType"){
 	 					text = dicts.get($input[0].name).val();
 	 				}else{
 	 					text = $input[0].value;
 	 				}
	 				data["colList["+ ind +"]."+ name ] = text;
 				}
 			});
 		});
 		
		var action =  "/finacial/bankCollect/manualFinacial/saveOrUpdate";
        $.post(basePath + action,data,function(result){
            bt.loading.hide(); //关闭加载中
            if(result.success){
            	bt.navtab.closeCurrent();
            }
            parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
        },'JSON');
        
        return false;
    });
});

var tds = $("#editTable tbody tr:eq(0)").html();
var i = 0;
function addTr(){
	i++;
	var $tr = $('<tr data-id="' + i + '">'+ tds +'</tr>');
	$('#editTable > tbody').append($tr);
	bt.dicts.init();
}

</script>
</html>
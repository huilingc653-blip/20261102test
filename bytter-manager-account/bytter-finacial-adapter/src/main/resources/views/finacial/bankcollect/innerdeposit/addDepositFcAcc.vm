<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <input type="hidden"  id="corp" value="$!{info.netId}">
    <input type="hidden"  id="cur" value="$!{info.curId}">
    <input type="hidden"  id="net" value="$!{net.code}">
    <input type="hidden"  id="billCode" value="$!{info.billNo}">
    <input type="hidden" id="accAccNoRule" value="$!{accAccNoRule}">

    <table class="layui-table">
        <thead>
            <tr>
                <td colspan="4">#springMessage('contract.type.basicInfo')</td>##基础信息
            </tr>
        </thead>
        <tbody>
            <tr>
                ##网点
                <td width="10%" class="textRight">#springMessage('table.fcAcc.netId')</td>
                <td width="40%">
                    $!{net.name}
                    <input type="hidden" name="netId" id="netId" class="layui-input" value="$!{net.Id}">
                </td>
                ##账户类别
                <td width="10%" class="textRight">#springMessage('table.fcAcc.accType')</td>
                <td width="40%">
                    <div class="layui-inline">
                        <select lay-filter="accType" lay-verify="required" name="accType" disabled="disabled">
                            <option value="">#springMessage("common.placeholder.select")</option>
                            #foreach($dict in $dictTag.list("InnerAccount.AccType"))
                                <option #if($!{subject.accType} == $dict.code) selected="selected" #end value="$dict.code">$dict.name</option>
                             #end
                        </select>
                    </div>
                    ##科目代码
                    <div class="layui-inline">
                        <select lay-filter="subjectId" name="subjectId" id="subjectId" lay-verify="required" lay-search="">
                            <option value="" >#springMessage("common.placeholder.select")</option>
                        </select>
                    </div>
                </td>
            </tr>
            <tr>
                ##币别
                <td width="10%" class="textRight">#springMessage('table.fcAcc.curId')</td>
                <td width="40%">
                    <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-biz-name="curId" data-url="${basePath}/basic/business/btcurrency/json"
                        data-valuefield="id" data-textfield="curName" data-name="curId" data-disabled="true"
                        data-search="true" data-defaultvalue="$!{info.curId}" data-required="true"></div>
                    <input type="hidden" name="curCode" id="curCode" value="${curInfo.curCode}"/>
                    </div>
                </td>
                ##结算中心账号
                <td width="10%" class="textRight">#springMessage('table.fcAcc.blnctrAcc')</td>
                <td width="40%">
                    <input type="text" id="blnctrAcc" name="blnctrAcc"
                        autocomplete="off" class="layui-input" readonly="readonly" placeholder="#springMessage('table.fcAcc.blnctrAcc')" readonly="readonly">
                </td>
            </tr>
            <tr>
                ##顺序号
                <td width="10%" class="textRight">#springMessage('table.fcAcc.seqNum')</td>
                <td width="40%">
                #*    <input type="text" id="seqNum" name="seqNum"
                    autocomplete="off" class="layui-input" readonly="readonly" placeholder="#springMessage('table.fcAcc.seqNum')">*#
                    #if($!{seqNumPage} == '0')
                        <input type="text" id="seqNum" name="seqNum" maxlength="$!{relen}"
                               autocomplete="off" class="layui-input" onchange="getNum(this)"
                               onkeyup="value=zhzs(this.value)"
                               placeholder="#springMessage('table.fcAcc.seqNum')">
                    #else
                        <input type="text" id="seqNum" name="seqNum"
                               autocomplete="off" class="layui-input" readonly="readonly"
                               placeholder="#springMessage('table.fcAcc.seqNum')">
                    #end
                </td>
                ##助记码
                <td width="10%" class="textRight">#springMessage('table.fcAcc.shortcut')</td>
                <td width="40%">
                    <input type="text" id="shortcut" name="shortcut" lay-verify="strlength"
                    autocomplete="off" class="layui-input" data-maxlength="10" placeholder="#springMessage('table.fcAcc.shortcut')">
                </td>
            </tr>
            <tr>
                ##开户单位ID
                <td width="10%"  class="textRight">#springMessage('table.fcAcc.corpId')</td>
                <td width="40%">
                    <div class="layui-inline">
                        $!{info.corpName}
                        <input type="hidden" name="corpId" id="corpId" class="layui-input" value="$!{info.corpId}">
                    </div>
                </td>
                ##账户名称
                <td width="10%" class="textRight">#springMessage('table.fcAcc.accName')</td>
                <td width="40%">
                    <input type="text" id="accName" name="accName" lay-verify="required|strlength" value="$!{info.corpName}" class="layui-input">
                </td>
            </tr>
            <tr>
                ##联行网点
                <td width="10%" class="textRight">#springMessage('table.fcAcc.unionNet')</td>
                <td width="40%">
                    <div class="layui-inline">
                        <div class="bt-biz-corp" data-biz-type="net" data-type="selectTree" data-callback="unionNetChange"
                        data-resource="netbank:innerAccount:fcAcc:query" data-name="unionNet" data-scope="net"></div>
                    </div>
                </td>
                ##联行账号
                <td width="10%" class="textRight">#springMessage('table.fcAcc.unionAcc')</td>
                <td width="40%">
                    <div class="layui-input-inline">
                        <input type="text" name="unionAcc" lay-verify="tableData" id="unionAcc" class="layui-input acc" data-biz-name="unionAcc">
                    </div>
                </td>
            </tr>
            <tr>
                ##余额方向
                <td width="10%" class="textRight">#springMessage('table.fcAcc.balanceWay')</td>
                <td width="40%">
                    <div class="layui-inline">
                        <select lay-filter="balanceWay" name="balanceWay" disabled="disabled">
                            <option value="0">#springMessage("common.placeholder.select")</option>
                            #foreach($dict in $dictTag.list("Admin.BalanceWay"))
                                <option #if($!{subject.balanceWay} == $dict.code) selected="selected" #end value="$dict.code">$dict.name</option>
                            #end
                        </select>
                    </div>
                </td>
                <td width="10%"></td>
                <td width="40%"></td>
            </tr>
        </tbody>
    </table>

    <table class="layui-table">
        <thead>
            <tr>
            <td colspan="4">#springMessage('table.fcAgreedDeposit.accInfo')</td>##账户信息
            </tr>
        </thead>
        <tbody>
            <tr>
                <td width="10%" class="textRight">#springMessage('table.fcAcc.accOpenTime')</td>
                <td width="40%">##开户日期
                    <div class="layui-input-inline">
                        <input type="text" name="accOpenTime"  readonly="readonly" data-today="true" value="$!date.format('yyyy-MM-dd',$!info.interestStartDate)" class="layui-input bt-biz-dateType" >
                    </div>
                </td>
                
                <td width="10%" class="textRight">#springMessage('table.fcAcc.accStartDate')</td>
                <td width="40%">##启用日期
                    <div class="layui-input-inline">
                        <input type="text" name="accStartDate" data-biz-name="accStartDate" lay-verify="required" data-today="true" data-min="$!{closeDate}"  class="layui-input bt-biz-dateType" >##value="$!{closeDate}"
                    </div>
                </td>
            </tr>
            
            <tr>
                <td width="10%" class="textRight">#springMessage('table.fcAcc.relationAcc')</td>
                <td width="40%">##关联活期账号
                    <div class="layui-inline">
                        #if("$!{menuType}" == "191")
                            <input name="relationAcc" type="text" class="layui-input" lay-verify="required" value="$!{relationAcc}"> ##lay-filter="getAccInfo" id="relationAcc"
                         #else
                         <input name="relationAcc" type="text" class="layui-input"  value="$!{relationAcc}"> ##lay-filter="getAccInfo" id="relationAcc" 
                         #end
                          
                    </div>
                </td>
                <td width="10%"></td>
                <td width="40%"></td>
            </tr>
        </tbody>
    </table>

    <table class="layui-table">
        <thead>
            <tr>
                <td colspan="4">#springMessage('table.fcAgreedDeposit.interestInfo')</td>##计息信息
            </tr>
        </thead>
        <tbody>
            <tr>
                <td width="10%" class="textRight">#springMessage('table.fcAcc.interestSign')</td>
                <td width="40%">##计息标志
                    <div class="layui-inline">
                        <input type="radio" lay-filter="interestSign" name="interestSign" value="1" title="#springMessage('table.fcAcc.interestSignOk')" checked>
                        <input type="radio" lay-filter="interestSign" name="interestSign" value="0" title="#springMessage('table.fcAcc.interestSignNo')">
                    </div>
                </td>

            
                <td width="10%" class="textRight">#springMessage('table.fcAcc.predrawSign')</td>
                <td width="40%">##预提标志
                    <div class="bt-biz-dict" data-name="predrawSign" data-type="select" data-group="Admin.PredrawSign" 
                             data-biz-name="predrawSign" data-required="true" data-required="true" data-filterData="1,2,3">
                    </div>
                </td>
           
            </tr>
               
            <tr>
                #if( $!{menuType} == "191")
                    <td width="10%" class="textRight">#springMessage('table.fcAcc.certificateWay')</td>
                    <td width="40%">##到期续存方式
                    <div class="layui-inline">
                        <select lay-filter="certificateWay" name="certificateWay" data-required="true">
                            #foreach($dict in $dictTag.list("fcAcc.certificateWay"))
                                <option value="$dict.code">$dict.name</option>
                            #end
                        </select>
                    </div>
                    </td>

                    <td width="10%" class="textRight">#springMessage('table.fcAcc.term')</td>
                    <td width="40%">##期限
                        <div class="layui-input-inline">
                            <input type="text" id="notifyType" name="notifyType"
                                   autocomplete="off" readonly="readonly" class="layui-input"  value="$!{info.dayLimit}" placeholder="#springMessage('table.fcAcc.term')">
                        </div>
                        <div class="layui-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="pricing.fixedTerm" data-value="$!{info.dateUnit}"
                                 data-name="endUnit" data-biz-name="endUnit" data-callback="setTerm" ></div>##data-value="$!{info.dateUnit}" 
                        </div>
                    </td>
                #end
                
            </tr>
            
            <tr>
                #if( $!{menuType} == "193")
                    <td width="10%" class="textRight">#springMessage('table.fcAcc.notifyType')</td>
                    <td width="40%">##通知类型
                        <div class="layui-inline">##通知类型
                            <div class="layui-form">
                                <div class="bt-biz-dict" data-type="select" data-value="$!{info.noticeType}" data-name="notifyType" data-biz-name="notifyType"
                                     data-group="fcAcc.notifyType"></div>
                            </div>
                        </div>
                    </td>
                #end
                
                <td width="10%" class="textRight">#springMessage('table.fcAcc.interestStartDate')</td>
                <td width="40%">##起息日期
                    <div class="layui-input-inline">
                        <input type="text" name="interestStartDate" data-biz-name="interestStartDate" 
                               value="$!date.format('yyyy-MM-dd',$!info.interestStartDate)" data-callback="clickNotice" lay-verify="required" data-endid="t2" class="layui-input bt-biz-dateType" >
                    </div>
                </td>
                
            #if( $!{menuType} == "191")
                <td width="10%" class="textRight">#springMessage('table.fcAcc.deadlineDate')</td>
                <td width="40%">##到期日期
                    <div class="layui-input-inline">
                        <input type="text" name="deadlineDate" data-biz-name="deadlineDate"  value="$!date.format('yyyy-MM-dd',$!info.deadlineDate)"  lay-verify="required" data-callback="clickNotice" id="t2" class="layui-input bt-biz-dateType" >
                    </div>
                </td>
            #end
                
            </tr>
            
            <tr>
                <td width="10%" class="textRight">#springMessage('table.fcAcc.interestRate')</td>
                <td width="40%">##利率
                    <input type="text" id="interestRate" name="interestRate" lay-verify="required" value="$!{info.interestRate}"
                        autocomplete="off" class="layui-input  bt-biz-rateType" data-biz-name="interestRate" placeholder="#springMessage('table.fcAcc.interestRate')">
                </td>
                <td width="10%"></td>
                <td width="40%"></td>
            </tr>
        </tbody>
    </table>
    <table class="layui-table">
        <thead>
            <tr>
                <td colspan="4">#springMessage('cms.loan.OtherInfo')</td>##其他信息
            </tr>
        </thead>
        <tbody>
            
             #if( $!{menuType} == "191")
                 <tr>
                    <td width="10%" class="textRight">#springMessage('table.fcAcc.contractNo')</td>
                    <td width="40%">##合同编号
                        <input type="text" id="contractNo" name="contractNo"
                            autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAcc.contractNo')" value="$!{send.contractCode}">
                    </td>
           
                    <td width="10%" class="textRight">#springMessage('table.fcAcc.overdueRate.Pass')</td>
                    <td width="40%">##超期利率
                        <input type="text" id="overdueRate" name="overdueRate" lay-verify="required"
                            autocomplete="off" class="layui-input  bt-biz-rateType" value="$!{send.overdueRate}" data-biz-name="overdueRate" placeholder="#springMessage('table.fcAcc.overdueRate')">
                    </td>
                </tr>
            #end
            <tr>
                <td width="10%" class="textRight">#springMessage('table.fcAcc.overdraftRate.pre')</td>
                <td width="40%">##提前利率
                    <input type="text"  name="overdraftRate" lay-verify="required"
                        autocomplete="off" class="layui-input  bt-biz-rateType" data-biz-name="overdraftRate" placeholder="#springMessage('table.fcAcc.overdraftRate')">
                </td>
                #if( $!{menuType} == "191")
                    <td width="10%"></td>
                    <td width="40%"></td>
                #else
                    ##备注
                    <td class="textRight" width="10%">#springMessage('table.fcInitAcc.rmk')</td>
                    <td width="40%">
                        <input type="text" class="layui-input" id="rmk" name="rmk"/>
                    </td>
                #end
            </tr>
        </tbody>
    </table>
    <table class="layui-table">
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" type="button" lay-submit="" lay-filter="submit">#springMessage('table.bisAccBal.btn.confirm')</button>
            </td>
        </tr>
    </table>    
</form>
    #parse("views/common/footer.vm")
</body>
<script>

var dateFun;
bt.use(['form','select','corp','bankInfo','dateType','selectTableType','selectType','rateType','dicts','dateType'], function(){
	$ = bt.jquery;
	form = bt.form();
    corps = bt.corp.init();
    bt.bankInfo.init();
    selectType = bt.selectType.init();
   	rateType = bt.rateType.init();
    dateType = bt.dateType.init();
   	dicts = bt.dicts.init();
    dateFun = bt.dateType.getFun();
  	//监听提交
    form.on('submit(submit)', function(data){
    	var webObj = bt.navtab.getParentDom();
    	webObj.bt.jquery("#account1").val(data.field.blnctrAcc);
    	webObj.bt.jquery("#accName1").text(data.field.accName);
    	webObj.bt.jquery("#baccName1").val(data.field.accName);
        // 加载现金流项目
        var debitMoney = webObj.bt.jquery("#debitMoney1").val();
        var creditMoney = webObj.bt.jquery("#creditMoney1").val();
        var subjectId = $("select[name='subjectId']").find("option:selected").val();
        webObj.loadCashFlowItem(1, data.field.blnctrAcc, debitMoney, creditMoney, subjectId);

    	data.field['accState'] = "N";
        var endUnitTemp = dicts.get("endUnit").val();
        if(endUnitTemp == "1"){
            data.field.endUnit = "M"
        }else if(endUnitTemp == "2"){
            data.field.endUnit = "Y"
        }else{
            data.field.endUnit = "D"
        }
    	webObj.chAccount = data.field;
    	bt.navtab.closeCurrent('false');
    });
  	//监控计息标志
    form.on('radio(interestSign)',function (data) {
        fn_interestSign(data.value);
        form.render();
    });
    
    
    /**
     * 生成账号
     */
    genBlnctrAcc = function() {
        /**
         * 自动生成顺序号
         */
        createSequence();
        var netCode = $("#net").val();
        //自定义属性值获取
        var curCode = $("#curCode").val();
        var subjectCode = $("select[name='subjectId']").find("option:selected").attr("data-subjectcode");
        var seqNum = $("#seqNum").val();
        if(!netCode || !seqNum || !curCode||!subjectCode){
            $("#blnctrAcc").attr("value","");
            return;
        }
        //科目代码截取生成
        var rule = $("#accAccNoRule").val();
        if(rule == 4) {
            if (subjectCode && subjectCode.length > 0) {
                if (subjectCode.trim().length < 6) {
                    subjectCode = subNum(subjectCode);
                }
            }
        }
        $("#blnctrAcc").val(netCode + "" + curCode +""+subjectCode+""+seqNum);
        form.render();
    };
    
    
    /**
    自动生成序列号
    **/
   var createSequence=function(){
       var netId= $("#corp").val();
       var curId= $("#cur").val();
       var accType=$("select[name='accType']").val();
       /**
        如果为空不自动生成
        **/
       if(netId.length==0||curId.length==0||accType.length==0) {
           return;
       }
       var param={
           netId:netId,
           curId:curId,
           accType:accType,
           date:(new Date()).getTime()
       };
       var url=basePath + "/inneraccount/fcacc/createSequence";
       $.ajax({
           url: url, method: 'GET', data: param, async:false, dataType: 'json',
           success: function (data) {
               if (data) {
                   $("#seqNum").val(data.obj);
               }
               form.render();
           }
       });
   };

    /**
    * 手动生成账号
    */
    bt.genBlnctrManualAcc = function() {
        /**
         *	从末级科目得到计息标志和利率和透支利率，余额方向
         */
        lastSubjectChange();

        var netCode = $("#net").val();
        //自定义属性值获取
        var curCode = $("#curCode").val();

        var subjectCode = $("#subjectId").find("option:selected").attr("data-subjectcode");
        var seqNum = $("#seqNum").val();
        if(!netCode || !seqNum || !curCode||!subjectCode){
            $("#blnctrAcc").attr("value","");
            return;
        }
        //科目代码截取生成
        var rule = $("#accAccNoRule").val();
        if(rule == 4) {
            if (subjectCode && subjectCode.length > 0) {
                if (subjectCode.trim().length < 6) {
                    subjectCode = subNum(subjectCode);
                }
            }
        }
        $("#blnctrAcc").val(netCode + "" + curCode +""+subjectCode+""+seqNum);
        form.render();
    };

    /**
     * 手动生成顺序号
     * @param data
     * @returns {boolean}
     */
    getNum = function(data) {
        var poolSign = $("#poolSign").val();
        var netId= $('input[name="netId"]').val();
        var curId=$("select[name='curId']").val();
        var accType=$("select[name='accType']").val();
        var seqNumTemp = data.value;
        if(poolSign==1){
            netId=bt.selectType.get("netId").val();
        }
        /**
         如果为空不生成
         **/
        if(netId.length==0||curId.length==0||accType.length==0 || seqNumTemp.length == 0) {
            return;
        }
        var param={
            netId:netId,
            curId:curId,
            accType:accType,
            poolSign:poolSign,
            date:(new Date()).getTime(),
            seqNum:seqNumTemp
        };
        var url=basePath + "/inneraccount/fcacc/createSequence";
        $.ajax({
            url: url, method: 'GET', data: param, async:false, dataType: 'json',
            success: function (data) {
                if (data) {
                    $("#seqNum").val(data.obj);
                    bt.genBlnctrManualAcc();
                }
                form.render();
            }
        });
    }

    /**
     *根据末级科目得到是否计息和透支利率 余额方向
     */
    var lastSubjectChange=function(){

        var balanceWay = $("#subjectId").find("option:selected").attr("data-balanceway");
        if(!balanceWay){
            return ;
        }
        $("select[name='balanceWay']").val(balanceWay);
        form.render();

    };

   bt.unionAcc = function () {
       var unionNetId = $('input[name="unionNet"]').val();
       var curId = $("select[name='curId']").val();
       var url = basePath+"/inneraccount/fcacc/getAccountTableData";
       if(unionNetId && curId){
           var urldata={
               netId:unionNetId,
               corpId:unionNetId,
               curId:curId,
               type:''
           };
           $("#unionAcc").val("");
           bt.unionAccTable.get("unionAcc").setUrl(urldata);
       }
   };
   
   bt.unionAccTable=bt.selectTableType.init({
       elem:".acc",
       url: basePath+"/inneraccount/fcacc/getAccountTableData",
       paging:true,
       urldata:{
           type:'init'
       },
       columns:[
           {"data":"blnctrAcc",title:bt.lang("table.fcAcc.blnctrAcc")},
           {"data":"accName",title:bt.lang("table.fcAcc.accName")},
           {"data":"subjectName",title:bt.lang("table.fcAcc.subjectId")}
       ],
       clickCallback:function(data,$tr,$elem,full){
           
       },
       tableInitCallback:function(full,$elem){
       }
   });
   

   $(function(){
	   	var accType=$("select[name='accType']").val();
        $.ajax({
            url: basePath+"/finacial/paramconfig/fcsubject/jsonSubjectDate/"+accType+"?tk="+(new Date()).getTime(),
            method: 'GET',
            dataType: 'json',
            success: function(data){
                $("#subjectId").empty();
                $("#subjectId").append("<option value=''>"+bt.lang("common.placeholder.select")+"</option>");
                if(data){
                    $.each(data,function(index){
                        $("#subjectId").append("<option value='"+data[index].id+"'"
                        + " data-balanceWay='"+data[index].balanceWay+"'"  //余额方向
                        + " data-interestSign='"+data[index].interestSign+"'"  //计息标志
                        + " data-interestRate='"+(data[index].interestRate==null?"":data[index].interestRate)+"'"  //利率
                        + " data-subjectCode='"+data[index].subjectCode+"'"   //科目代码
                        + " data-predrawSign='"+data[index].predrawSign+"'" //结息方式
                        + ">("+data[index].subjectCode+")"+ data[index].subjectName+"</option>");
                    });
                }
                form.render('select');
            }
        });
        var loanAcc = bt.navtab.getParentDom().loanAcc;
    	if(loanAcc != null && loanAcc != undefined){
    		$("#blnctrAcc").val(loanAcc.blnctrAcc);
    		
    	}
   })
   
   form.on('select(subjectId)',function (data) {
		genBlnctrAcc(data.elem);
		form.render();
		bt.fn_chargeAcc("accForDeduct",$("select[name='accType']").val());
        bt.showEle();
   });

    form.on('select(getAccInfo)',function (data) {
        getAccountInfo(data)
    });
   
   bt.fn_chargeAcc = function(elem,accType) {
       $("#"+elem).empty();
       $("#"+elem).append("<option value=' '>"+bt.lang("common.placeholder.select")+"</option>");
       var curId=$("select[name='curId']").val();
       var corpId=$('input[name="corpId"]');
       if(corpId && corpId.val()!=""){
           var param={
               curId:curId,
               corpId:corpId.val(),
               accType:accType,
               elem: elem,
               date:(new Date()).getTime()
           };
           var url= basePath+"/inneraccount/fcacc?getChangeAcc";
           $element(url,param,elem);

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 22px; 
	text-decoration: underline;
	text-align: center;
}
.layui-input {
	width:148px; 
}
	.sign{
		color: red;
	}
</style>  
<script src="${basePath}/static/modules/finacial/nbconsole/enterpriseLoan/tally.js?_btv=${resourceVersion}"></script> 
</head>
<body>
<form class="layui-form">
<input type="hidden" id="isSelect" value="0">
<input type="hidden" id="busGlobalId" name ="accbook.busGlobalId">
<input type="hidden" id="accbookId" name="accbook.id">
<input type="hidden" id="bookdtlId1" name="bookDtls[0].id">
<input type="hidden" id="bookdtlId2" name="bookDtls[1].id">
<div class="voucher-title">
			##记账凭证
			<label >#springMessage('table.fcAccbook.tallyTitle')</label>
	</div>
	<table class="layui-table">
		<colgroup>
			<col width="10%">
			<col width="23%">
			<col width="10%">
			<col width="23%">
			<col width="10%">
			<col width="24%">
		</colgroup>
		<tr>
			##凭证种类
			<td class="textRight">#springMessage('table.fcAccbook.voucherType')</td>
			<td><div class="bt-biz-selectType" data-url="${basePath}/netbank/fcvouchertype/json" data-required="true" data-biz-name="voucherType"
		        				data-valuefield="id" data-textfield="voucherName" data-name="accbook.voucherType" data-search="true"></div>
		    </td>
			##流水号
			<td class="textRight">#springMessage('table.fcAccbook.orderNo')</td>
			<td>
				<span id="orderNoShow"></span>
				<input type="hidden" name="accbook.orderNo" id="orderNo">
			</td>
			##附件数
			<td class="textRight">#springMessage('table.fcAccbook.affixAmount')</td>
			<td><input type="text" name="accbook.affixAmount" id="affixAmount" class="layui-input" placeholder="#springMessage('table.fcAccbook.affixAmount')" lay-verify="integer"></td>
		</tr>
		<tr>
			##业务种类
			<td class="textRight"><span class="sign">*</span>#springMessage('table.fcAccbook.busRaceId')</td>
			<td>
				<input type="hidden" name="accbook.busRaceId" id="busRaceId">
				<span id="raceNameShow"></span>
			</td>
			##记账日期
			<td class="textRight">#springMessage('table.fcAccbook.tallyDate')</td>
			<td><input type="text" name="accbook.tallyDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="tallyDate" data-today="true" lay-verify="required"></td>
			##起息日期
			<td class="textRight">#springMessage('table.fcAccbook.interestStartDate')</td>
			<td><input type="text" name="accbook.interestStartDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="interestStartDate" data-today="true" lay-verify="required"></td>
		</tr>
	</table>
	<table class="layui-table">
		<colgroup>
			<col width="15%">
			<col width="15%">
			<col width="15%">
			<col width="15%">
			<col width="15%">
			<col width="15%">
			<col width="10%">
		</colgroup>
		<thead>
			<tr align="center">
				<td><span class="sign">*</span>#springMessage('table.fcAccbookDtl.summaryContent')</td>
				<td><span class="sign">*</span>#springMessage('table.fcAccbookDtl.account')</td>
				<td>#springMessage('table.fcAccbookDtl.accName')</td>
				<td>#springMessage('table.fcAccbookDtl.origVoucherNo')</td>
				<td><span class="sign">*</span>#springMessage('table.fcAccbookDtl.debitMoney')</td>
				<td><span class="sign">*</span>#springMessage('table.fcAccbookDtl.creditMoney')</td>
				<td>#springMessage('finacial.common.cashFlow.item')</td>#*现金流项目*#
			</tr>
		</thead>
		<tbody>
			<tr>
				<td>
					<div class="bt-biz-selectType" data-extraData="true" data-biz-name="summary0" data-search="true" data-url="${basePath}/finacial/paramconfig/btsummary/json" data-valuefield="summaryContent" data-textfield="summaryContent" data-name="bookDtls[0].summaryContent" data-width="200px" data-inputvalue ="inputvalue"></div>
				</td>
				<td align="center">
					<input type="text" ondblclick="selectAcc()" style="display:none" id="account1" class="layui-input" name="bookDtls[0].account">
				</td>
				<td align="center">
					<input type="hidden" name="bookDtls[0].accName" id="accName1">
					<span id="accNameShow1"></span>
				</td>
				<td align="center">
					<input type="hidden" name="bookDtls[0].origVoucherNo" id="origVoucherNo1">
					<span id="origVoucherNoShow1"></span>
				</td>
				<td class="textRight">
					<input type="hidden" name="bookDtls[0].debitMoney" id="debitMoney1">
					<span id="debitMoneyShow1"></span>
				</td>
				<td class="textRight">
					<input type="hidden" name="bookDtls[0].creditMoney" id="creditMoney1">
					<span id="creditMoneyShow1"></span>
				</td>
				<td class="center">
					<span id="cashFlowItem0"></span>
				</td>
			</tr>
			<tr>
				<td><div class="bt-biz-selectType" data-extraData="true" data-url="${basePath}/finacial/paramconfig/btsummary/json" data-valuefield="summaryContent" data-biz-name="summary1" data-textfield="summaryContent" data-name="bookDtls[1].summaryContent"  data-inputvalue ="inputvalue" data-width="200px"  data-search="true"></div></td>
				<td align="center">
					<div class="layui-input-inline">
						<input type="type" style="display:none" name="bookDtls[1].account" id="account2"  class="layui-input acc" data-biz-name="account2">
					</div>
				</td>
				<td align="center">
					<input type="hidden" name="bookDtls[1].accName" id="accName2">
					<span id="accNameShow2"></span>
				</td>
				<td align="center">
					<input type="hidden" name="bookDtls[1].origVoucherNo" id="origVoucherNo2">
					<span id="origVoucherNoShow2"></span>
				</td>
				<td class="textRight">
					<input type="hidden" name="bookDtls[1].debitMoney" id="debitMoney2">
					<span id="debitMoneyShow2"></span>
				</td>
				<td class="textRight">
					<input type="hidden" name="bookDtls[1].creditMoney" id="creditMoney2">
					<span id="creditMoneyShow2"></span>
				</td>
				<td class="center">
					<span id="cashFlowItem1"></span>
				</td>
			</tr>
			<tr>
				##合计
				<td class="textRight">#springMessage('table.interet.sum')</td>
				<td></td>
				<td></td>
				<td></td>
				<td class="textRight"><span id="debitMoneySumShow"></span></td>
				<td class="textRight"><span id="creditMoneySumShow"></span></td>
				<td></td>
			</tr>
			<tr>
				##加急标志
				<td class="textRight">#springMessage('table.fcAccbook.emergencySign')</td>
				<td>
					<div class=bt-biz-dict data-type="radio" data-biz-name="emergencySign" data-name="accbook.emergencySign" data-group="Accbook.EmergencySign" data-defaultvalue="G" data-disabled="true"></div>
				</td>
				##备注
				<td class="textRight">#springMessage('table.fcAccbook.rmk')</td>
				<td colspan="4">
					<input type="text" name="accbook.rmk" id="rmk" class="layui-input" style="width:100%;" placeholder="#springMessage('table.fcAccbook.rmk')">
				</td>
			</tr>
		</tbody>
		<tfoot>
		<tr>
			<td colspan="7" >#parse("views/finacial/common/uploader.vm")</td>
		</tr>
			<tr>
				<td colspan="7" style="text-align: center;">
					<button class="layui-btn" type="button" lay-submit="" value="1"  lay-filter="submit">#springMessage('common.button.submit')</button>
					<button class="layui-btn" type="button" lay-submit="" value="2"  lay-filter="submit">#springMessage('common.button.back')</button>
				</td>
			</tr>
		</tfoot>
	</table>

</form>
<div class="layui-collapse">
  <div class="layui-colla-item">
    <h2 class="layui-colla-title">#springMessage("cms.loan.tallyData")</h2>
    <div class="layui-colla-content layui-show">
	<form id="searchForm" class="layui-form">
	<input type="hidden" id="pageType" value="$!{pageType}">
			<table class="layui-table">
			<tr>
				##所属资金中心
				<td class="textRight">#springMessage("table.cmsLoanInfo.net")</td>
				<td>
					<div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="net"
                             data-type="selectTree"
                             data-name="ins_netCode"
                             data-biz-name="netCode"
                             data-scope="all"
                             data-tree-type="check"
                             data-resource="fcl:loan:tally:apply"></div>
					</div>
				</td>
				##贷款申请编号
				<td class="textRight">#springMessage('table.cmsLoanSend.loanCode')</td>
				<td>
					<input type="text" name="likes_infoBillCode"
			                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanSend.loanCode')">
				</td>
			</tr>
			<tr>
				##发放单号
				<td class="textRight">#springMessage("table.cmsLoanRepay.sendCode")</td>
				<td>
					<input type="text" name="likes_sendBillCode"
			                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanSend.loanCode')">
				</td>
				##合同号
				<td class="textRight">#springMessage("table.cmsLoanSend.contractCode")</td>
				<td>
					<input type="text" name="likes_contractCode"
			                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.cmsLoanSend.loanCode')">
				</td>
			</tr>
			<tr>
                <td colspan="4" style="text-align: center;">
					<button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
					<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
				</td>
			</tr>
			</table>
	</form>
	<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage("table.cmsLoanSend.loanCode")</th>
        <th>#springMessage("table.cmsLoanRepay.sendCode")</th>
       <!--  <th>#springMessage("table.cmsLoanSend.status")</th> -->
        <th>#springMessage("table.cmsLoanInfo.net")</th>
        <th>#springMessage("table.cmsLoanInfo.corp")</th>
        <th>#springMessage("table.cmsLoanInfo.curCode")</th>
        <th>#springMessage("table.cmsLoanSend.loanMoney")</th>
        <th>#springMessage("table.fcAcc.term")</th>
        <th>#springMessage("table.cmsLoanSend.loanDate")</th>
        <th>#springMessage("cms.common.deadlineDate")</th>
        <!-- <th>#springMessage("table.cmsLoanSend.payType")</th> -->
        <th>#springMessage("table.cmsLoanSend.contractCode")</th>
        <th>#springMessage("table.cmsLoanSend.loanAcc")</th>
        <th>#springMessage("table.cmsLoanSend.repayType")</th>
        <th>#springMessage("table.cmsLoanInfo.loanClass")</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.tallySign')</th> 
    </tr>
    </thead>
</table>
		</div>
	</div>
</div>
#parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/finacial/common/uploader.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/finacial/common/common.setCashFlowItem.js?_btv=${resourceVersion}"></script>
<script>
var tableData;
var selectData;
var fcAccData;
var selectT;
bt.use(['form','element','datatable','layedit','dateType','selectType','dicts','corp','moneyType','selectTableType'], function(){
	$ = bt.jquery,form = bt.form(),element = layui.element,moneyFun = bt.moneyType.getFun();
	var dateTypes = bt.dateType.init();
	selectT = bt.selectType.init();
	bt.dicts.init();
	bt.corp.init();

	datatable = bt.datatable.init({
        elem: "#appTable",
        dom: 'Brtlip',
        colReorder: true,
        order: [1,'desc'],
        ajax: {
            'url': basePath+"/cms/loan/cmsloansend/getLoanTallyList?opType=edit"
        },
        searchForm:{
            formElem:"#searchForm",
            formFilter:"search"
        },
        columns: [
			{data:"infoBillCode",className:'center',bSortable:false},
			{data:"sendBillCode",className:'center',bSortable:false},
			/* {data:"bizStatus",className:'center',bSortable:true,
				render: function ( data, type, full, meta ) {
                    return bt.dict("cms.bizStatus",full.bizStatus);
                }	
			}, */
			{data:"netName",className:'center',bSortable:false},
			{data:"corpName",className:'center',bSortable:false},
			{data:"curName",className:'center',bSortable:false},
			{data:"sendMoney",className:'textRight',bSortable:false,
				render: function (data, type, full, meta) {
            		var money = moneyFun.format(full.sendMoney);
            		return money;
            	}	
			},
			{data:"loanTerm",className:'center',bSortable:false,
				render: function ( data, type, full, meta ) {
            		if(full.ternUnit==2){
            			return full.loanTerm + bt.lang("cms.loan.ternUnit.day");
            		}else if(full.ternUnit==1){
            			return full.loanTerm + bt.lang("cms.loan.ternUnit.month");
            		}else{
            			return full.loanTerm;
            		}
                }	
			},
			{data:"loanDate",className:'center',bSortable:false},
			{data:"repayDate",className:'center',bSortable:false},
			/* {data:"payType",className:'center',bSortable:true,
				render: function (data, type, full, meta) {
            		return bt.dict("cms.loan.payType",full.payType);
            	}
			}, */
			{data:"contractCode",className:'center',bSortable:false},
			{data:"loanAcc",className:'center',bSortable:false},
			{data:"repayTypeName",className:'center',bSortable:false},
			{data:"loanGenreName",className:'center',bSortable:false},
			{data:"status",bSortable:false,className:"center",
			    render:function(data,type,full,meta){
					return bt.dict("cms.loanTallySign",full.status );
				}
			}
        ],
        btInitComplete:function(setting,json){
        	tableData = json.data;
        },
        btDrawCallback:function(setting){
        	tableData = setting.json.data;
        }
    });
	
	
	$('#appTable tbody').on('dblclick','tr',function(){ 
		var dataIndex = $(this).context.rowIndex - 1;
		selectData = tableData[dataIndex];
		$("#isSelect").val(1);
		$.ajax({
    		type: "POST",
    		url: basePath+"/finacial/enterpriseLoan/getFcAccbookTempInfo",
    		data: {"sendCode" : selectData.sendBillCode},
    		dataType : "json",
    		success: function(rs){
				//增加背景色
				var row = datatable.row(dataIndex).node();
				$(".row_bg").removeClass("row_bg");
				$(row).addClass("row_bg");
    			selectT.get("voucherType").render();
    			$("#busGlobalId").val(rs.accbook.busGlobalId);
    			$("#accbookId").val(rs.accbook.id);
    			$("#bookdtlId1").val(rs.bookDtls[0].id);
    			$("#bookdtlId2").val(rs.bookDtls[1].id);
    			selectT.get("voucherType").val(rs.accbook.voucherType);
    			$("#orderNoShow").html(rs.accbook.orderNo);
    			$("#orderNo").val(rs.accbook.orderNo);
    			$("#affixAmount").val(rs.accbook.affixAmount);
				uploaderRender(null,rs);//双击行上传控件渲染事件
    			initRaceId(rs.accbook.netId,"1");
    			dateTypes.get("tallyDate").val(rs.accbook.tallyDate);
    			dateTypes.get("interestStartDate").val(rs.accbook.interestStartDate);
    			fcAccData = rs.bookDtls[0].accDTO;
    			selectT.get("summary0").attr("data-defaultvalue",rs.bookDtls[0].summaryContent);
    			selectT.get("summary1").attr("data-defaultvalue",rs.bookDtls[1].summaryContent);
    			// selectT.get("summary0").render();
    			// selectT.get("summary1").render();
    			initTallyAccs(selectData.netCode,selectData.corpId,selectData.curCode);
    			$("#account2").val(rs.bookDtls[1].account);
	       		$("#accName2").val(rs.bookDtls[1].accDTO.accName);
	       		$("#accNameShow2").html(rs.bookDtls[1].accDTO.accName);
	       		$("#origVoucherNo1").val(rs.accbook.origVoucherNo);
				$("#origVoucherNo2").val(rs.accbook.origVoucherNo);
				$("#origVoucherNoShow1").html(rs.accbook.origVoucherNo);
				$("#origVoucherNoShow2").html(rs.accbook.origVoucherNo);
				$("#debitMoney1").val(rs.bookDtls[0].debitMoney);
				$("#creditMoney1").val(0);
				$("#debitMoney2").val(0);
				$("#creditMoney2").val(rs.bookDtls[1].creditMoney);
				$("#creditMoneyShow1").html('0.00');
				$("#debitMoneyShow2").html('0.00');
				$("#debitMoneyShow1").html(moneyFun.format(rs.bookDtls[0].debitMoney));
				$("#creditMoneyShow2").html(moneyFun.format(rs.bookDtls[1].creditMoney));
				$("#debitMoneySumShow").html(moneyFun.format(bt.money.add(rs.bookDtls[0].debitMoney, rs.bookDtls[1].debitMoney)));
				$("#creditMoneySumShow").html(moneyFun.format(bt.money.add(rs.bookDtls[0].creditMoney,rs.bookDtls[1].creditMoney)));
				$("#account1").show();
				$("#account1").val(rs.bookDtls[0].account);
				$("#accName1").val(rs.bookDtls[0].accName);
				$("#accNameShow1").html(rs.bookDtls[0].accName);
				$("#cashFlowItem0").html('<input type="hidden" value="' + (isNotEmpty(rs.bookDtls[0].cashFlux) ? rs.bookDtls[0].cashFlux : "") + '" name="bookDtls[0].cashFlux">' + (rs.bookDtls[0].cashFluxName == null ? "":rs.bookDtls[0].cashFluxName));
				$("#cashFlowItem1").html('<input type="hidden" value="' + (isNotEmpty(rs.bookDtls[1].cashFlux) ? rs.bookDtls[1].cashFlux : "") + '" name="bookDtls[1].cashFlux">' + (rs.bookDtls[1].cashFluxName == null ? "":rs.bookDtls[1].cashFluxName));
				$("#rmk").val(rs.accbook.rmk);
    		}
    	});
	});
	
	
	form.on('submit(submit)', function(data){
		if($("#isSelect").val()=="0"){
			layer.alert(bt.lang("common.message.confirm.selectData"),{icon:5});
			return false;
		}
		data.field["accbook.attachmentId"] = uploader.getGroupId();
        var action = "/finacial/enterpriseLoan/save";
        var status=$(this).attr("value");
        data.field.opT = status;
        data.field.type = "edit";
        bt.loading.show();
        for(var key in fcAccData){
            data.field['bookDtls[0].accDTO.'+key+''] = fcAccData[key];
        }
        $.post(basePath + action,data.field,function(result){
            parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            if(result.success){
            	bt.loading.hide();
            	location.reload();
            }else{
            	bt.loading.hide();
            }
        },'JSON');
        return false;
    });
	
});
</script>
                <div id="orderNo"></div>
            </td>
        </tr>
        </tbody>
    </table>
    ## 凭证表格数据
    <table id="printMRTable" class="layui-table">
        <thead>
        <tr>
            <th style="text-align: center;"><span class="sign">*</span>#springMessage(
                'table.fcAccbookDtl.summaryContent')</th>
            <th style="text-align: center;"><span class="sign">*</span>#springMessage('table.fcAccbookDtl.account')</th>
            <th style="text-align: center;">#springMessage('table.fcAccbookDtl.accName')</th>

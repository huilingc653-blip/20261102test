<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        .voucher-title {
            font-weight: bold;
            font-size: 22px;
            text-decoration: underline;
            text-align: center;
            /*color: blue;*/
            /*color: #00CC33;*/
        }

        .sign {
            color: red;
        }
    </style>
</head>
<body>
<form class="layui-form requr">
    <input type="hidden" id="key" name="key">
    <input type="hidden" name="accbook.rmk" id="accbookRmk">
    <input type="hidden" id="opType" value="$!{opType}">

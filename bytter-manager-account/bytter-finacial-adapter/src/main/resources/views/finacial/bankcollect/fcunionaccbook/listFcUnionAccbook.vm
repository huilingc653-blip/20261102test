<script src="${basePath}/static/modules/finacial/common/uploader.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/finacial/common/common.setCashFlowItem.js?_btv=${resourceVersion}"></script>
<script>
    bt.use(['form', 'layedit', 'bank', 'selectTable', 'btdate', 'select', 'moneyType', 'dicts', 'bttable', 'element', 'datatable', 'mulselect', 'corp', 'dateType', 'selectType', 'region'], function () {
        element = layui.element();
        $ = bt.jquery, form = bt.form();
        tt = bt.mulselect.init();
        region = bt.region.init();
        moneyType = bt.moneyType.init();
        moneyFun = bt.moneyType.getFun();
        dataType = bt.dateType.init();
        selectType = bt.selectType.init();
        bt.corp.init();
        bt.bank.init({elem: '.bank',})
        dicts = bt.dicts.init();
        //监听暂存
        form.on('submit(temp)', function (data) {
            var action = "/finacial/bankCollect/fcunionaccbook/save";
            return submitData(data, action);
        });
        //监听提交
        form.on('submit(submit)', function (data) {
            var action = "/finacial/bankCollect/fcunionaccbook/submit";
            return submitData(data, action);
        });
        //监听打回
        form.on('submit(back)', function (data) {
            bt.loading.show();//显示加载中
            var action = "/finacial/bankCollect/fcunionaccbook/back";
            parent.layer.prompt({
                title: bt.lang('table.cmsLoanInfo.refuseWhy'),
                formType: 2,
                cancel: function (index, layero) {
                    bt.loading.hide(); //关闭加载中
                },
                end: function () {
                    bt.loading.hide(); //关闭加载中
                }
            }, function (pass) {
                data.field['bookExt.invalidReason'] = pass;
                //内部参数配置不一致,转换为枚举参数
                if ($("#opType").val() == 'Edit') {
                    data.field['opType'] = "MODIFY";
                } else if ($("#opType").val() == 'Check') {
                    data.field['opType'] = "CHECK";
                } else if ($("#opType").val() == 'Init') {
                    data.field['opType'] = "SUBMIT";
                }
                $.post(basePath + action, data.field, function (result) {
                    if (result.success) {
                        location.reload();
                        parent.layer ? parent.layer.closeAll() : layer.closeAll();
                    }
                    bt.loading.hide(); //关闭加载中
                    parent.layer ? parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}) : layer.alert(result.msg, {icon: result.success ? 1 : 2});
                }, 'JSON');
            });
            return false;
        });
        //监听通过
        form.on('submit(pass)', function (data) {
            bt.loading.show();//显示加载中
            var action = "/finacial/bankCollect/fcunionaccbook/pass";
            $.post(basePath + action, data.field, function (result) {
                if (result.success) {
                    location.reload();
                    parent.layer ? parent.layer.closeAll() : layer.closeAll();
                }
                bt.loading.hide(); //关闭加载中
                parent.layer ? parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}) : layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, 'JSON');
            return false;
        });
        var rowMR = 0;
        var rowFmtDtl = 0;
        var bttable;
        var initPrintMRTable = function () {
            //生成列表
            bttable = bt.bttable.init({
                elem: "#printMRTable",
                url: basePath + "/finacial/accbook/fcaccbook/getFcAccBookDtls",
                scrollX: false,
                scrollY: false,
                buttons: [],
                columns: [],
                tableInitCallback: function () {
                    bt.dicts.init();
                }
            });
        }
        var initSelectAccount = function (row) {
            var cls = "";
            if (row != undefined) {
                cls = row
            }
            bt.selectTable.init({
                elem: "#example" + cls,
                url: basePath + "/finacial/bankCollect/fcunionaccbook/getValidAccount?corpId=" + $("#netId").val(),
                scrollX: true,
                paging: true,
                scrollY: "200px",
                searchInput: "#account" + cls,
                columns: [
                    {data: "blnctrAcc",},
                    {data: "accName",},
                    {data: "subjectName",}
                ],
                clickCallback: function (data) {
                    //设置账户名称
                    $("#account" + cls).val(data.blnctrAcc);
                    $("#accName" + cls).text(data.accName);
                    $("#baccName" + cls).val(data.accName);
                    // 加载现金流项目
                    loadCashFlowItem(row, data.blnctrAcc, null, null);
                }
            });
        }
        var add = function (bookDtl, rowMR) {
            var controlVo = bookDtl.controlVo;
            var account = "";
            if (controlVo.accountEditable) {
                account = '<td><div class="layui-inline"><input type="text" name="bookDtls[' + rowMR + '].account" id="account' + rowMR + '" class="layui-input text"  style="width: 100%;" maxlength="32">'
                        + '<table id="example' + rowMR + '">'
                        + '	<thead>'
                        + '    	<tr>'
                        + '        	<th>' + bt.lang("table.fcAccbookDtl.account") + '</th>'
                        + '            <th>' + bt.lang("table.fcAccbookDtl.accName") + '</th>'
                        + '            <th>' + bt.lang("table.fcAccbookDtl.subjectCode") + '</th>'
                        + '    	</tr>'
                        + '    </thead>'
                        + '</table>'
                        + '</div></td>';
            } else {
                account = '<td><div class="layui-inline"><input type="text" name="bookDtls[' + rowMR + '].account" id="account' + rowMR + '" value = "' + (bookDtl.account == null ? "" : bookDtl.account) + '" class="layui-input text" readonly="readonly" style="width: 100%">'
                        + '</div></td>';
            }
            var html = '<tr row="' + rowMR + '">';
            if (controlVo.summaryEditable) {
                html += '<td><input type="text" name="bookDtls[' + rowMR + '].summaryContent" id="summaryContent' + rowMR + '"  class="layui-input" maxlength="32" style="width: 100%" value = "' + (bookDtl.summaryContent == null ? "" : bookDtl.summaryContent) + '"/></td>';
            } else {
                html += '<td><input type="text" name="bookDtls[' + rowMR + '].summaryContent" id="summaryContent' + rowMR + '"  class="layui-input" maxlength="32" style="width: 100%" value = "' + (bookDtl.summaryContent == null ? "" : bookDtl.summaryContent) + '" readonly="readonly"/></td>';
            }
            html += account;
            html += '<td><div id="accName' + rowMR + '">&nbsp;' + (bookDtl.accName == null ? "" : bookDtl.accName) + '&nbsp;</div>'
                    + '<input id="baccName' + rowMR + '" name="bookDtls[' + rowMR + '].accName" type="hidden" value = "' + (bookDtl.accName == null ? "" : bookDtl.accName) + '" ></td>';
            html += '<td><input type="text" name="bookDtls[' + rowMR + '].origVoucherNo" value = "' + (bookDtl.origVoucherNo == null ? "" : bookDtl.origVoucherNo) + '" id="origVoucherNo' + rowMR + '"  class="layui-input" maxlength="32" style="width: 100%" readonly="readonly" /></td>';
            html += '<td><input id="debitMoney' + rowMR + '"  class="layui-input bt-biz-moneyType"   value = "' + (bookDtl.debitMoney == null ? "" : bookDtl.debitMoney) + '" name="bookDtls[' + rowMR + '].debitMoney" type="text" readonly="readonly"  style="width: 100%" /></td>';
            html += '<td><input id="creditMoney' + rowMR + '"   class="layui-input bt-biz-moneyType"  value = "' + (bookDtl.creditMoney == null ? "" : bookDtl.creditMoney) + '"  name="bookDtls[' + rowMR + '].creditMoney" type="text" readonly="readonly" style="width: 100%" /></td>';
            //html+='<td><input type="text" name="bookDtls[' + rowMR + '].cashFlux" value = "'+ ( bookDtl.cashFlux == null ? "" : bookDtl.cashFlux ) +'" id="cashFlux' + rowMR + '" class="layui-input" maxlength="32" style="width: 100%"  /></td>';
            html += '<td><span id="cashFlowItem' + rowMR + '"><input type="hidden" value="' + (isNotEmpty(bookDtl.cashFlux) ? bookDtl.cashFlux : "") + '" name="bookDtls[' + rowMR + '].cashFlux">' + (isNotEmpty(bookDtl.cashFluxName) ? bookDtl.cashFluxName : "") + '</span></td>';
            html += '</tr>';
            $("#printMRTable>tbody").append(html);
            bt.dicts.init();
            if (controlVo.accountEditable) {
                initSelectAccount(rowMR);
                $("#account" + rowMR).val(bookDtl.account);
            }
            // 加载现金流项目
            if (isEmpty(bookDtl.cashFlux)) {
                loadCashFlowItem(rowMR, bookDtl.account, bookDtl.debitMoney, bookDtl.creditMoney);
            }
            rowMR++;
        }
        initPrintMRTable();
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            colReorder: true,
            checkbox: false,
            mulselect: false,
            selectCss: true,
            order: [[15, 'desc']],
            ajax: {
                'url': basePath + "/finacial/bankCollect/fcunionaccbook/datatable/?type=" + $("#opType").val()
            }, searchForm: {
                formFilter: "search",
                formElem: "#searchForm"
            },
            /*         buttons: [{
                        text: bt.lang("Finacial.accbook.common.button.add"),
                        action: function ( e, dt, node, config ) {
                            var length = $("#printMRTable tbody>tr").length;
                            var data = dt.rows('.selected').data();
                            var len = data.length;
                            if( len < 1 ){
                                layer.msg("#springMessage('table.fcBankBill.msg.chooseLeastOne')");
                	return;
                }
                var rowData = data.splice(0,len);
             	var id = rowData[0].id;
             	$("#key").val(id);
             	var type = $("#opType").val();
             	$.post(basePath + "/finacial/bankCollect/fcunionaccbook/queryFcUnionAccbook/",{id:id,type:type}, function(result){
             		if(typeof result.success == "boolean" && result.success == false){
             			layer.alert(result.msg);
                    	return;
             		}
             		$("#printMRTable>tbody>tr").remove();
             		add(result.bookDtls[0] , 0);
             		add(result.bookDtls[1] , 1);
                    $("#externalCorp").val(result.bookExt.externalCorp);//对方账号
                    $("#externalAcc").val(result.bookExt.externalAcc);// 对方账户名
                    $("#externalBank").val(result.bookExt.externalBank);  //对方账号开户行
					$("#ExtRmk").val(result.bookExt.rmk);   //摘要
					//$("#ExtCity").val(result.bookExt.city);
					dicts.get("ExtEmergencySign").val(result.accbook.emergencySign);   //紧急标志
					//设置省市
					region.get('test1').set([{
			            name:'bookExt.prov',
			            defaultValue:result.bookExt.prov
			        },{
			            name:'bookExt.city',
			            defaultValue:result.bookExt.city

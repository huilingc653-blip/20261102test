                            <div class="bt-biz-region" data-group="test1" data-name="bookExt.prov"
                                 data-change="bookExt.city" data-label="#springMessage('table.fcAccbookExt.prov')"
                                 style="float: left"></div>
                            <div style="float: left" class="date-mid"> ~</div>
                            <div class="bt-biz-region" data-group="test1" data-name="bookExt.city"
                                 data-label="#springMessage('table.sysCorp.city')" style="float: left"></div>
                        </td>
                        <td>#springMessage('table.fcAccbookHis.emergencySign')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-biz-name="ExtEmergencySign"
                                     data-name="accbook.emergencySign" data-type="radio"
                                     data-group="Accbook.EmergencySign" data-defaultvalue="G"
                                     data-disabled="true"></div>
                            </div>
                        </td>
                        <td>#springMessage('table.btNetChalk.purpose')</td>
                        <td width="30%" colspan="3">
                            <input type="text" name="accbook.rmk" id="ExtRmk" autocomplete="off" class="layui-input"
                                   style="width: 100%">
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
<div class="layui-collapse">
    <div class="layui-colla-item">

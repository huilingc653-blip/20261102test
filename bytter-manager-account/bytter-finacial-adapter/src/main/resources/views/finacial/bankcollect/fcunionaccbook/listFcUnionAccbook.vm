    <input id="netId" type="hidden">
    <div class="voucher-title">
        ##记账凭证
        <label>#springMessage('table.fcAccbook.tallyTitle')</label>
    </div>
    <table class="layui-table self-adaption">
        <tbody>
        <tr>
            ##凭证总类
            <td class="textRight">#springMessage('table.fcAccbook.voucherType')</td>
            <td width="20%">
                #if( $!{type}== "Check")
                    <input type="text" id="voucherTypeView" readonly="readonly" class="layui-input"
                           lay-verify="required">
                    <input type="hidden" id="voucherType" name="accbook.voucherType">
                #else
                    <div class="bt-biz-selectType" data-biz-name="voucherType"
                         data-url="${basePath}/netbank/fcvouchertype/json"
                         data-valuefield="id" data-textfield="voucherName" data-name="accbook.voucherType"
                         data-search="true" data-required="true"></div>
                #end
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            ##附件张数
            <td class="textRight">#springMessage('table.fcAccbook.affixAmount')</td>
            <td width="20%">
                <input type="text" id="affixAmount" data-name="accbook.affixAmount" data-type="int" maxlength="2"
                       name="accbook.affixAmount"
                       decimal="0" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.fcAccbook.affixAmount')">
            </td>
        </tr>
        <tr>
            ##业务总类
            <td class="textRight">#springMessage('table.fcAccbook.busRaceId')</td>
            <td width="20%">
                <input type="text" id="busRaceIdView" readonly="readonly" class="layui-input" lay-verify="required">
                <input type="hidden" id="busRaceId" name="accbook.busRaceId">
            </td>
            ##起息日期
            <td class="textRight">#springMessage('table.fcAccbook.interestStartDate')</td>
            <td width="20%">
                #if( $!{type}== "Check")
                    <input type="text" id="interestStartDate" name="accbook.interestStartDate" readonly="readonly"
                           class="layui-input" lay-verify="required">
                #else
                    <input type="text" data-biz-name="interestStartDate" name="accbook.interestStartDate"
                           class="layui-input bt-biz-dateType" data-type="date" lay-verify="required">
                #end
            </td>
            ##记账日期
            <td class="textRight">#springMessage('table.fcAccbook.tallyDate')</td>
            <td width="20%">
                #if( $!{type}== "Check")
                    <input type="text" id="tallyDate" name="accbook.tallyDate" readonly="readonly" class="layui-input"
                           lay-verify="required">
                #else
                    <input type="text" data-biz-name="tallyDate" name="accbook.tallyDate"

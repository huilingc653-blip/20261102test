            var type = $("#opType").val();
            $("#key").val(id);
            $("#curCode").val(rowData.curId);
            $("#netId").val(rowData.receiveNet);
            $("#corpCode").val(rowData.receiveNet);
            $.post(basePath + "/finacial/bankCollect/fcunionaccbook/queryFcUnionAccbook/", {
                key: id,
                type: type
            }, function (result) {
                if (typeof result.success == "boolean" && result.success == false) {
                    layer.alert(result.msg);
                    return;
                }
                //增加背景色
                var row = datatable.row(dataIndex).node();
                $(".row_bg").removeClass("row_bg");

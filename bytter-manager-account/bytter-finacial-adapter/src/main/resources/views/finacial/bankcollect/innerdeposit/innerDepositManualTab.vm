<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")

<style type="text/css">
.layui-body2 {
	padding：0px;
	position: absolute;
	left: 0px;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 2000;
	width: auto;
	overflow: hidden;
	overflow-y: auto;
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box;
}
</style> 
</head>
<body>
<div class="layui-body2" style="width: 100%; height: 100%">
	<div class="layui-tab layui-tab-brief"  style="width: 100%; height: 605px">
		<ul class="layui-tab-title">
			<li class="layui-this" lay-id="current_to_regular">#springMessage('current.to.regular')</li>##活期转定期
			<li lay-id="regular_to_current">#springMessage('regular.to.current')</li>##定期转活期
			<li lay-id="current_to_inform">#springMessage('current.to.inform')</li>##活期转通知
            <li lay-id="inform_to_current">#springMessage('inform.to.current')</li>##通知转活期
		</ul>
    	<div class="layui-tab-content" style="width: 100%; height: 100%">
    	
      		##活期转定期
       		<div class="layui-tab-item layui-show" style="width: 100%; height: 100%">
           		<iframe id="current_to_regular" src="${basePath}/finacial/bankCollect/innerDeposit/manualPage?opType=$!{opType}&menuType=191" frameborder="0" style="width: 100%; height: 100%"></iframe>
       		</div>
        
         	##定期转活期
       	  	<div class="layui-tab-item" style="width: 100%; height: 100%">
         		<iframe id="regular_to_current" src="${basePath}/finacial/bankCollect/innerDeposit/manualPage?opType=$!{opType}&menuType=192" frameborder="0" style="width: 100%; height: 100%"></iframe>
       		</div>
         
         	##活期转通知
       		<div class="layui-tab-item" style="width: 100%; height: 100%">
         		<iframe id="current_to_inform" src="${basePath}/finacial/bankCollect/innerDeposit/manualPage?opType=$!{opType}&menuType=193" frameborder="0" style="width: 100%; height: 100%"></iframe>
         	</div>
         	
         	##通知转活期
			<div class="layui-tab-item" style="width: 100%; height: 100%">
					<iframe id="inform_to_current" src="${basePath}/finacial/bankCollect/innerDeposit/manualPage?opType=$!{opType}&menuType=194" frameborder="0" style="width: 100%; height: 100%"></iframe>
				</div>
		   </div>
		
    </div>
</div> 
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['element', 'form','layedit','btdate'], function(){
	//注意：选项卡 依赖 element 模块，否则无法进行功能性操作 
	var $ = bt.jquery,form = bt.form();
	var element = layui.element();
});

</script>
</html>
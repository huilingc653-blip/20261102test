<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")

<style type="text/css">
.layui-body2 {
	padding：0px;
	position: absolute;
	left: 0px;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 2000;
	width: auto;
	overflow: hidden;
	overflow-y: auto;
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box;
}
</style> 
</head>
<body>
<div class="layui-body2" style="width: 100%; height: 100%">
	<div class="layui-tab layui-tab-brief"  style="width: 100%; height: 660px">
		<ul class="layui-tab-title">
			<li lay-id="payMent" class="layui-this">#springMessage('table.nisAllocationReport.ask')</li>##请款
			<li lay-id="rushbook">#springMessage('nis.position.of.allocation')</li>##头寸调拨
			<li lay-id="oribook">#springMessage('table.nisAllocationReport.down')</li>##下拨
		</ul>
    	<div class="layui-tab-content" style="width: 100%; height: 100%">
	    	##请款
	         <div class="layui-tab-item layui-show" style="width: 100%; height: 100%">
	         	<iframe id="payMentiframe"  name="payMentiframe" src="${basePath}/finacial/bankCollect/manualFinacial/manualPage?opType=$!{opType}&menuType=12" frameborder="0" style="width: 100%; height: 100%"></iframe>
	         </div>
	      	##头寸调拨
	       	<div class="layui-tab-item" style="width: 100%; height: 100%">
	           	<iframe id="rushiframe" name="rushiframe" src="${basePath}/finacial/bankCollect/manualFinacial/manualPage?opType=$!{opType}&menuType=13" frameborder="0" style="width: 100%; height: 100%"></iframe>
	        </div>
	         ##下拨
			<div class="layui-tab-item" style="width: 100%; height: 100%">
	         	<iframe id="oriiframe" name="oriiframe" src="${basePath}/finacial/bankCollect/manualFinacial/manualPage?opType=$!{opType}&menuType=11" frameborder="0" style="width: 100%; height: 100%"></iframe>
			</div>
		</div>
    </div>
</div> 
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['element', 'form','layedit','btdate'], function(){
	//注意：选项卡 依赖 element 模块，否则无法进行功能性操作
	var $ = bt.jquery,form = bt.form();
	var element = layui.element();
});

</script>
</html>
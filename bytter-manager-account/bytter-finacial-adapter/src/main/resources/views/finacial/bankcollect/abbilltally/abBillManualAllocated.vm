<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 22px; 
	text-decoration: underline;
	text-align: center;
	/*color: blue;*/
	/*color: #00CC33;*/
}
</style>    
</head>
<body>
<form id="searchForm" class="layui-form">
	<input type="hidden" id="opType" name="opType" value="$!{opType}">
	<input type="hidden" id="menuType" name="menuType" value="$!{menuType}">
	<input type="hidden" id="sysRaceCode">
	<table class="layui-table">
		<tbody>
			<tr>
			##持票单位
                <td style="text-align:right;" width="14%" >#springMessage('bill.accebill.isCorp')</td>
                <td width="36%" style="text-align:left;">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp" 
                             data-biz-type="corp" 
                             data-type="selectTree" 
                             data-name="eqs_corpId" 
                             data-biz-name="corpId" 
                             data-scope="all"
                             data-tree-type="check"
                             data-resource="finacial:abbilltally:apply"></div>
                    </div>
                </td>

			##票据号码
                <td style="text-align:right;" width="14%">#springMessage('table.ratUrationApply.billNo')</td>
                <td width="36%" style="text-align:left;">
                    <input name="likes_origNo" class="layui-input">
                </td>

            </tr>
      			
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn">#springMessage('common.button.reset')</button>
				</td>
			</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
				<tr>
		      	  	<th>#springMessage('table.abBillTransfer.allocatedCode.down')</th>##下拨单号
		       		<th>#springMessage('table.abBillTransfer.recordCorpId')</th>##录入单位
		       	 	<th>#springMessage('table.abBillTransfer.recevieCorpId')</th>##收票单位
		       		##<th>#springMessage('table.abBillTransfer.recevieBankAcc')</th>##收票单位账号
		      		##<th>#springMessage('table.abVoucherinfo.startDate')</th>##申请金额
		        	<th>#springMessage('table.abBillTransfer.downMoney')</th>##下拨金额
					<th>#springMessage('table.abBillTransfer.downReason')</th>##下拨原因
                    <th>#springMessage('table.fbsBudget.status')</th> ##状态

		        	
  			</tr>
		</thead>
</table>

#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','layedit','selectTable','btdate','bank','select','moneyType','dicts','bttable','element','datatable','mulselect','corp','dateType','selectType','region'], function(){
	var tableData ;
	element = layui.element();
    $ = bt.jquery;
    form = bt.form();
    tt = bt.mulselect.init();
    bt.bank.init({ elem:'.bank',})
    region = bt.region.init();
    moneyType = bt.moneyType.init();
    moneyFun = bt.moneyType.getFun();
    dataType = bt.dateType.init();
    bt.corp.init();
    selectType = bt.selectType.init();
    bt.dicts.init();

    
    //生成列表
    datatable = bt.datatable.init({
        elem: "#appTable",
        dom: 'rtlip',
        colReorder: true,
        checkbox:false,
        mulselect:false,
        selectCss:true,
        buttonsLayout:false,
        order: [0,'desc'],
        fixedColumns:{
        	leftColumns:0
        },
        ajax: {
            'url': basePath+"/finacial/bankCollect/abBillTallyController/datatable?menuType="+$("#menuType").val()+"&opType="+$("#opType").val()
        },searchForm:{
            formFilter:"search",
            formElem:"#searchForm"
        },

        columns: [
            {data:"allocatedCode",bSortable:false,className:"center"},
            {data:"recordCorpName",bSortable:false,className:"center"},
            {data:"recevieCorpName",bSortable:false,className:"center"},
         //   {data:"recevieBankacc",bSortable:true,className:"center"},
//            {data:"applyMoney",bSortable:true,className:'textRight',
//                render: function ( data, type, full, meta ) {
//                    return bt.money.format(full.applyMoney);
//                }
//            },
            {data:"allocationMoney",bSortable:false,className:"textRight",
                render: function ( data, type, full, meta ) {
                    return bt.money.format(full.allocationMoney);
                }
            },
            {data:"allocationReason",bSortable:false,className:"center"},
            {data:"voucherState",bSortable:false,className:"center",
                render:function(data,type,full,meta){
               		if(full.voucherState== null){
                    	return bt.lang("table.tally.wait.for.an.account");
					}else{
                    	return bt.dict("Finacial.VoucherStatus",full.voucherState);
             }}},

        ],
        btInitComplete:function(setting,json){
        	tableData = json.data;
        },
		btDrawCallback:function(setting){
        	tableData = setting.json.data;
        }
    });
    
     $('#appTable tbody').on('dblclick','tr',function(data){
        var dataIndex = $(this).context.rowIndex - 1;
        //var data = tableData.rows('.selected').data();
        rowData = tableData[dataIndex];
        var id = rowData.aid;
     	var type = $("#opType").val();
     	var menuType = $("#menuType").val();
     	var sysRaceCode = rowData.sysRaceCode;

     	parent.parent.$("#buId").val(rowData.aid);
     	parent.parent.$("#menuType").val(menuType);
     	parent.parent.$("#key").val(id);
     	parent.parent.$("#curCode").val(rowData.curId);
     	parent.parent.$("#netId").val(rowData.netId);
     	parent.parent.$("#corpCode").val(rowData.corpId);
     	parent.parent.$("#sysRaceCode").val(sysRaceCode);
     	$.post(basePath + "/finacial/bankCollect/abBillTallyController/processAccbook/",{id:id,type:type,menuType:menuType,sysRaceCode:sysRaceCode}, function(result){
     		if(typeof result.success == "boolean" && result.success == false){
     			layer.alert(result.msg);
            	return;
     		}
            //增加背景色
            var row = datatable.row(dataIndex).node();
            $(".row_bg").removeClass("row_bg");
            $(row).addClass("row_bg");
            parent.parent.uploaderRender(type,result);
     		parent.parent.bt.setDate(result);
     	},'JSON');
	});   
});

</script>
</html>
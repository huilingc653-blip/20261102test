                    creditMoneySum = bt.money.add(creditMoneySum, result.bookDtls[a].creditMoney)
                    add(result.bookDtls[a], a, isDel);
                }
                $("#debitTot").text(moneyFun.format(debitMoneySum));
                $("#creditTot").text(moneyFun.format(creditMoneySum));
                $("#accbookId").val(result.accbook.id);

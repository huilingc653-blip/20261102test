                $("#affixAmount").val(result.accbook.affixAmount == null ? "" : result.accbook.affixAmount);
                bt.moneyType.init();
                //复核时设置凭证总类不可选
                if ($("#opType").val() == 'Check') {
                    $('#affixAmount').attr("readonly", "readonly");
                    //设置起始日期和记账日期
                    $("#interestStartDate").val(result.accbook.interestStartDate);
                    $("#tallyDate").val(result.accbook.tallyDate);
                    $("#voucherTypeView").val(result.accbook.voucherName);
                    $("#voucherType").val(result.accbook.voucherType);
                } else if ($("#opType").val() == 'Edit') {
                    dateType.get("interestStartDate").val(result.accbook.interestStartDate);
                    dateType.get("tallyDate").val(result.accbook.tallyDate);
                    selectType.get("voucherType").val(result.accbook.voucherType);
                    selectType.render();
                } else {
                    selectType.get("voucherType").val(result.accbook.voucherType);
                    // 设置起息息日期为交易日期
                    dateType.get("interestStartDate").val(result.accbook.interestStartDate);
                    selectType.render();
                }
                $("#busRaceId").val(result.accbook.busRaceId);
                $("#busRaceIdView").val(result.accbook.raceName);
                //设置按钮可选
                $("button[lay-filter='temp'] ").removeClass("layui-btn-disabled");
                $("button[lay-filter='temp'] ").removeAttr("disabled");
                $("button[lay-filter='submit'] ").removeClass("layui-btn-disabled");
                $("button[lay-filter='submit'] ").removeAttr("disabled");
                $("button[lay-filter='back'] ").removeClass("layui-btn-disabled");
                $("button[lay-filter='back'] ").removeAttr("disabled");
                $("button[lay-filter='pass'] ").removeClass("layui-btn-disabled");
                $("button[lay-filter='pass'] ").removeAttr("disabled");
            }, 'JSON');
        }

        /**
         * 对方账号信息清空并隐藏
         */
        function clearOppInfo() {
            $("#oppInfoDiv").hide();
            $("#externalCorp").val('');//对方账号
            $("#externalAcc").val('');// 对方账户名
            $("#externalBank").val('');  //对方账号开户行
            $("#startBank").val('');//委托收款的收款银行
            $("#startCorp").val('');//委托收款的收款单位
            $("#startCorpAcc").val(''); //第三方账号,子账号银行活期
            $("#ExtRmk").val('');   //摘要
            dicts.get("ExtEmergencySign").val('G');   //紧急标志
            //设置省市
            region.get('test1').set([{
                name: 'bookExt.prov',
                defaultValue: ''
            }, {
                name: 'bookExt.city',
                defaultValue: ''
            }]);
            $(".bt-biz-region").find('select').attr('disabled', 'disabled');
            region.render();
        }
    });

    /**
     *
     * @param data
     * @param action
     * @returns {boolean}
     */
    function submitData(data, action) {
        var trs = $("#printMRTable > tbody > tr").length;
        if (trs <= 0) {
            layer.alert(bt.lang('fin.book.tally.dtl.null'), {icon: 2})
            return false;
        }
        data.field["accbook.attachmentId"] = uploader.getGroupId();
        bt.loading.show();//显示加载中
        if ($("#opType").val() == 'Edit') {
            data.field['opType'] = "MODIFY";
        } else if ($("#opType").val() == 'Init') {
            data.field['opType'] = "SUBMIT";
        }
        // setTimeout(function () {
        //     clearInterval(timer);
        $("#submitDiv").find('button').addClass("layui-btn-disabled").attr('disabled', 'disabled');
        // }, 350);
        $.post(basePath + action, data.field, function (result) {
            if (result.success) {
                // location.reload();
                refreshTable();
                parent.layer ? parent.layer.closeAll() : layer.closeAll();
            } else {
                $("button[lay-filter='temp'] ").removeClass("layui-btn-disabled");
                $("button[lay-filter='temp'] ").removeAttr("disabled");
                $("button[lay-filter='submit'] ").removeClass("layui-btn-disabled");
                $("button[lay-filter='submit'] ").removeAttr("disabled");
                $("button[lay-filter='back'] ").removeClass("layui-btn-disabled");
                $("button[lay-filter='back'] ").removeAttr("disabled");
                $("button[lay-filter='pass'] ").removeClass("layui-btn-disabled");
                $("button[lay-filter='pass'] ").removeAttr("disabled");
            }
            bt.loading.hide(); //关闭加载中
            parent.layer ? parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}) : layer.alert(result.msg, {icon: result.success ? 1 : 2});
        }, 'JSON');
        return false;
    }

    function refreshTable() {
        $("#printMRTable").find("tbody tr").remove();
        $("#printMRTable").find("tfoot td span").text('0.00');
        uploaderRender($("#opType").val(), null);
        if ($.fn.dataTable) {
            var tableLen = $.fn.dataTable.tables({visible: true, api: true}).page.len();
            $.fn.dataTable.tables({visible: true, api: true}).page.len(tableLen).draw('page');// 对表格进行重绘，要求页码/每页多少条不变
        }
    }

    /**
     * 日期校验
     */
    function checkInterestStartDate() {
        //记账日期
        var tallyDate = dateType.get("tallyDate").val();
        // 起息日期
        var interestDate = dateType.get("interestStartDate").val();
        if (isNotNull(tallyDate) && isNotNull(interestDate)) {
            if (bt.date.compare(interestDate, tallyDate) > 0) {
                layer.alert(bt.lang("fin.book.tally.intereststart.after"), {icon: false ? 1 : 2})
                dateType.get("interestStartDate").val("");
            }
        }
        //设置按钮可选
        $("button[lay-filter='temp'] ").removeClass("layui-btn-disabled");
        $("button[lay-filter='temp'] ").removeAttr("disabled");
        $("button[lay-filter='submit'] ").removeClass("layui-btn-disabled");
        $("button[lay-filter='submit'] ").removeAttr("disabled");
        $("button[lay-filter='back'] ").removeClass("layui-btn-disabled");
        $("button[lay-filter='back'] ").removeAttr("disabled");
    }

    /**
     * 是否为空
     * @param val
     * @returns {boolean}
     */
    function isNull(val) {
        if (null == val || undefined == val || "" == val || " " == val) {
            return true;
        } else {
            return false;
        }
    }

    /**
     * 是否为空
     * @param val
     * @returns {boolean}
     */
    function isNotNull(val) {
        return !isNull(val);
    }
</script>
</html>

                    var origVoucherNo = $("#origVoucherNo" + rowIndex).val();
                    $("." + origVoucherNo).remove();

                    var ids = $("#key").val();
                    var idArr = ids.split(",");
                    idArr.forEach(function (item, index, arr) {

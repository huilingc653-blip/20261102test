         */
        function mergeTally(ids, type, rowData, dataIndex, isDel) {
            debugger
            $.post(basePath + "/finacial/bankCollect/bisAccDtlTallyOtherPay/batchQueryBisAccDtl/", {
                ids: ids,
                type: type
            }, function (result) {

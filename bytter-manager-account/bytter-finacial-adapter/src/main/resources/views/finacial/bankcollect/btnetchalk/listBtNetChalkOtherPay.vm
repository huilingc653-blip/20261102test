        /**
         * 单个记账回显账务明细
         *
         * id 银企接口收款表主键id
         * type 类型 Init:记账，Edit:改账，Check:复核
         * rowData 当前行对象
         * dataIndex 当前行下标
         */
        function singleTally(id, type, rowData, dataIndex) {
            $.post(basePath + "/finacial/bankCollect/bisAccDtlTallyOtherPay/queryAndCreateAccbook/", {
                id: id,
                type: type
            }, function (result) {
                if (typeof result.success == "boolean" && !result.success) {
                    layer.alert(result.msg);
                    return;
                }

                $("#key").val(id);
                $("#curCode").val(rowData.curId);
                $("#corpId").val(rowData.corpId);
                // 对方信息显示
                $("#oppInfoDiv").show();
                $("#cashFlag").val(result.cashFlag);
                $("#mergeFlag").val("0");// 单个记账
                //增加背景色
                var row = datatable.row(dataIndex).node();
                $(".row_bg").removeClass("row_bg");
                $(row).addClass("row_bg");
                $("#printMRTable>tbody>tr").remove();
                add(result.bookDtls[0], 0, false);
                add(result.bookDtls[1], 1, false);
                $("#accbookId").val(result.accbook.id);
                $("#busGlobalId").val(result.accbook.busGlobalId);
                $("#accbookRmk").val(result.accbook.rmk);  //摘要
                $("#externalCorp").val(result.bookExt.externalCorp);//对方账号
                uploaderRender(type, result);//双击行上传控件渲染事件
                $("#externalAcc").val(result.bookExt.externalAcc);// 对方账户名
                $("#externalBank").val(result.bookExt.externalBank);  //对方账号开户行
                $("#startBank").val(result.bookExt.startBank);//委托收款的收款银行
                $("#startCorp").val(result.bookExt.startCorp);//委托收款的收款单位
                $("#startCorpAcc").val(result.bookExt.startCorpAcc); //第三方账号,子账号银行活期
                $("#ExtRmk").val(result.accbook.rmk);   //摘要
                dicts.get("ExtEmergencySign").val(result.accbook.emergencySign);   //紧急标志
                //设置省市
                region.get('test1').set([{
                    name: 'bookExt.prov',
                    defaultValue: result.bookExt.prov
                }, {
                    name: 'bookExt.city',
                    defaultValue: result.bookExt.city
                }]);
                $(".bt-biz-region").find('select').attr('disabled', 'disabled');
                region.render();
                $("#debitTot").text(moneyFun.format(result.bookDtls[0].debitMoney));
                $("#creditTot").text(moneyFun.format(result.bookDtls[1].creditMoney));
                $("#orderNo").text((result.accbook.orderNo == null ? "" : result.accbook.orderNo));
                $("#accbookOrderNo").val(result.accbook.orderNo == null ? "" : result.accbook.orderNo);
                $("#affixAmount").val(result.accbook.affixAmount == null ? "" : result.accbook.affixAmount);
                bt.moneyType.init();
                //复核时设置凭证总类不可选
                if ($("#opType").val() == 'Check') {
                    $('#affixAmount').attr("readonly", "readonly");
                    //设置起始日期和记账日期
                    $("#interestStartDate").val(result.accbook.interestStartDate);
                    $("#tallyDate").val(result.accbook.tallyDate);
                    $("#voucherTypeView").val(result.accbook.voucherName);
                    $("#voucherType").val(result.accbook.voucherType);
                } else if ($("#opType").val() == 'Edit') {
                    dateType.get("interestStartDate").val(result.accbook.interestStartDate);
                    dateType.get("tallyDate").val(result.accbook.tallyDate);
                    selectType.get("voucherType").val(result.accbook.voucherType);
                    selectType.render();
                } else {
                    selectType.get("voucherType").val(result.accbook.voucherType);
                    // 设置起息息日期为交易日期
                    dateType.get("interestStartDate").val(rowData.transTime);
                    dateType.get("tallyDate").val(rowData.transTime);
                    selectType.render();
                }
                $("#busRaceId").val(result.accbook.busRaceId);
                $("#busRaceIdView").val(result.accbook.raceName);
                //设置按钮可选
                $("button[lay-filter='temp'] ").removeClass("layui-btn-disabled");
                $("button[lay-filter='temp'] ").removeAttr("disabled");
                $("button[lay-filter='submit'] ").removeClass("layui-btn-disabled");
                $("button[lay-filter='submit'] ").removeAttr("disabled");
                $("button[lay-filter='back'] ").removeClass("layui-btn-disabled");
                $("button[lay-filter='back'] ").removeAttr("disabled");
                $("button[lay-filter='pass'] ").removeClass("layui-btn-disabled");
                $("button[lay-filter='pass'] ").removeAttr("disabled");
            }, 'JSON');
        }


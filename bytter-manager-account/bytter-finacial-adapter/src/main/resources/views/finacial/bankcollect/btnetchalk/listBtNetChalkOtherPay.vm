        $('#appTable tbody').on('dblclick', 'tr', function (data) {
            var dataIndex = $(this).context.rowIndex - 1;
            rowData = tableData[dataIndex];
            var id = rowData.id;
            var type = $("#opType").val();
            var bookId = rowData.bookId;
            if (type === 'Check' || type === 'Edit') {
                // 存在单个记账或合并记账
                if (isNull(bookId)) {
                    // 单个记账
                    singleTally(id, type, rowData, dataIndex);
                } else {
                    $.post(basePath + "/finacial/bankCollect/bisAccDtlTallyOtherPay/listByBookId/", {bookId: bookId}, function (result) {
                        if (typeof result.success == "boolean" && !result.success) {
                            layer.alert(result.msg);
                            return;
                        }
                        if (result.length === 1) {
                            // 单个记账
                            singleTally(id, type, rowData, dataIndex);
                        }
                        if (result.length > 1) {
                            var ids = "";
                            for (var i = 0; i < result.length; i++) {
                                if (ids === "") {
                                    ids += result[i];
                                } else {
                                    ids += "," + result[i];
                                }
                            }
                            // 合并记账或汇总记账
                            mergeTally(ids, type, rowData, dataIndex, false);
                        }
                    }, 'JSON');
                }
            } else {
                // 单个记账
                singleTally(id, type, rowData, dataIndex);
            }



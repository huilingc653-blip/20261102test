<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        .voucher-title {
            font-weight: bold;
            font-size: 22px;
            text-decoration: underline;
            text-align: center;
            /*color: blue;*/
            /*color: #00CC33;*/
        }

        .sign {
            color: red;
        }
    </style>
</head>
<body>
<form class="layui-form" id="inputForm">
    <input type="hidden" id="key" name="key">
    <input type="hidden" name="accbook.rmk" id="accbookRmk">
    <input type="hidden" id="opType" value="$!{opType}">
    <input type="hidden" name="accbook.id" id="accbookId">
    <input type="hidden" name="accbook.busGlobalId" id="busGlobalId">
    <input name="accbook.orderNo" id="accbookOrderNo" type="hidden">
    <input id="curCode" type="hidden">
    <input id="corpId" type="hidden">
    <input id="mergeFlag" name="mergeFlag" type="hidden" value=""><!-- 合并记账标识：1-合并记账或汇总记账，0-单个记账 -->
    <div class="input150-container">
        <div class="voucher-title">
            ##记账凭证
            <label>#springMessage('table.fcAccbook.tallyTitle')</label>
        </div>
        <table class="layui-table self-adaption">
            <tbody>
            <tr>
                ##凭证种类
                <td class="textRight">#springMessage('table.fcAccbook.voucherType')</td>
                <td width="20%">
                    #if( $!{type} =="Check")
                        <input type="text" id="voucherTypeView" readonly="readonly" class="layui-input"
                               lay-verify="required">
                        <input type="hidden" id="voucherType" name="accbook.voucherType">
                    #else
                        <div class="bt-biz-selectType" data-biz-name="voucherType"
                             data-url="${basePath}/paramconfig/fcbusinessruledefine/getFcVoucherType"
                             data-valuefield="id" data-textfield="voucherName" data-name="accbook.voucherType"
                             data-search="true" data-required="true"></div>
                    #end
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                ##附件张数
                <td class="textRight">#springMessage('table.fcAccbook.affixAmount')</td>
                <td width="20%">
                    <input type="text" id="affixAmount" data-name="accbook.affixAmount" data-type="int" maxlength="2"
                           name="accbook.affixAmount"
                           decimal="0" autocomplete="off" class="layui-input"
                           placeholder="#springMessage('table.fcAccbook.affixAmount')">
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.fcAccbook.busRaceId')</td>
                <td width="20%">
                    <input type="text" id="busRaceIdView" readonly="readonly" class="layui-input" lay-verify="required">
                    <input type="hidden" id="busRaceId" name="accbook.busRaceId">
                </td>
                ##起息日期
                <td class="textRight">#springMessage('table.fcAccbook.interestStartDate')</td>
                <td width="20%">
                    #if( $!{type}== "Check")
                        <input type="text" id="interestStartDate" data-biz-name="interestStartDate"
                               name="accbook.interestStartDate" readonly="readonly" class="layui-input bt-biz-dateType"
                               lay-verify="required">
                    #else
                        <input type="text" data-biz-name="interestStartDate" data-callback="checkInterestStartDate"
                               data-today="true" name="accbook.interestStartDate" class="layui-input bt-biz-dateType"
                               data-type="date" lay-verify="required">
                    #end
                </td>
                ##记账日期
                <td class="textRight">#springMessage('table.fcAccbook.tallyDate')</td>
                <td width="20%">
                    #if( $!{type}== "Check")
                        <input type="text" id="tallyDate" name="accbook.tallyDate" readonly="readonly"
                               class="layui-input" lay-verify="required">
                    #else
                        <input type="text" data-biz-name="tallyDate" data-callback="checkInterestStartDate"
                               data-today="true" name="accbook.tallyDate" class="layui-input bt-biz-dateType"
                               data-type="date" lay-verify="required">
                    #end
                </td>
                ##流水号
                <td class="textRight">#springMessage('table.fcAccbook.orderNo')</td>
                <td width="20%">
                    <div id="orderNo"></div>
                </td>
            </tr>
            </tbody>
        </table>
        ## 凭证表格数据
        <table id="printMRTable" class="layui-table">
            <thead>
            <tr>
                <th style="text-align: center;"><span class="sign">*</span>#springMessage(
                    'table.fcAccbookDtl.summaryContent')</th>
                <th style="text-align: center;"><span class="sign">*</span>#springMessage('table.fcAccbookDtl.account')
                </th>
                <th style="text-align: center;">#springMessage('table.fcAccbookDtl.accName')</th>
                <th style="text-align: center;">#springMessage('table.fcAccbookDtl.origVoucherNo')</th>
                <th style="text-align: center;"><span class="sign">*</span>#springMessage(
                    'table.fcAccbookDtl.debitMoney')</th>
                <th style="text-align: center;"><span class="sign">*</span>#springMessage(
                    'table.fcAccbookDtl.creditMoney')</th>
                <th style="text-align: center;">#springMessage('finacial.common.cashFlow.item')</th>#*现金流项目*#
                <th class="del-class" style="text-align: center; display: none">#springMessage(
                    'common.table.thead.operation')</th>#*操作*#
            </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
            <tr>
                <td style="text-align: right">#springMessage('table.interet.sum')</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td>&nbsp;</td>
                <td style="text-align: right;"><span id='debitTot' val="0">0.00</span></td>
                <td style="text-align: right;"><span id='creditTot' val="0" class=" bt-biz-moneyType">0.00</span></td>
                <td></td>
                <td class="del-class" style="text-align: center; display: none"></td>
            </tr>

            </tfoot>

        </table>
    </div>
    #parse("views/finacial/common/uploader.vm")
    <div style="text-align: center; margin-top: 10px; margin-bottom: 5px;" id="submitDiv">
        #if( $!{type}== "Init")
            <button class="layui-btn layui-btn-disabled" lay-submit="" lay-filter="temp"
                    disabled="disabled">#springMessage('common.button.temp')</button>
            <button class="layui-btn layui-btn-disabled" lay-submit="" lay-filter="submit"
                    disabled="disabled">#springMessage('common.button.submit')</button>
        #elseif( $!{type} == "Edit" )
            <button class="layui-btn layui-btn-disabled" lay-submit="" lay-filter="submit"
                    disabled="disabled">#springMessage('common.button.submit')</button>
            <button class="layui-btn layui-btn-disabled" lay-submit="" lay-filter="back"
                    disabled="disabled">#springMessage('common.button.back')</button>
        #elseif( $!{type} == "Check" )
            <button class="layui-btn layui-btn-disabled" lay-submit="" id="back" lay-filter="back"
                    disabled="disabled">#springMessage('common.button.back')</button>
            <button class="layui-btn layui-btn-disabled" lay-submit="" lay-filter="pass"
                    disabled="disabled">#springMessage('common.button.pass')</button>
        #end
    </div>
    <div class="layui-collapse" id="oppInfoDiv">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('table.btNetChalk.hide')</h2>
            <div class="layui-colla-content">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        <td>#springMessage('table.btNetChalk.oppAccNo')</td>
                        <td width="30%">
                            <input type="text" name="bookExt.externalAcc" id="externalAcc" autocomplete="off"
                                   class="layui-input" readonly="readonly" style="width: 100%">
                        </td>
                        <td>#springMessage('table.btNetChalk.oppAccName')</td>
                        <td width="30%">
                            <input type="text" name="bookExt.externalCorp" id="externalCorp" autocomplete="off"
                                   class="layui-input" readonly="readonly" style="width: 100%">
                        </td>
                        <td>#springMessage('table.btNetChalk.oppBankName')</td>
                        <td width="30%">
                            <input type="text" name="bookExt.externalBank" id="externalBank" autocomplete="off"
                                   class="layui-input" readonly="readonly" style="width: 100%">
                        </td>
                        <input type="hidden" name="bookExt.startBank" id="startBank">
                        <input type="hidden" name="bookExt.startCorp" id="startCorp">
                        <input type="hidden" name="bookExt.startCorpAcc" id="startCorpAcc">
                    </tr>
                    <tr>
                        <td>#springMessage('table.fcAccbook.prov')</td>
                        <td width="30%">
                            <div class="bt-biz-region" data-group="test1" data-name="bookExt.prov"
                                 data-change="bookExt.city" data-label="#springMessage('table.fcAccbookExt.prov')"
                                 style="float: left"></div>
                            <div style="float: left" class="date-mid"> ~</div>
                            <div class="bt-biz-region" data-group="test1" data-name="bookExt.city"
                                 data-label="#springMessage('table.sysCorp.city')" style="float: left"></div>
                        </td>
                        <td>#springMessage('table.fcAccbookHis.emergencySign')</td>
                        <td width="30%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-biz-name="ExtEmergencySign"
                                     data-name="accbook.emergencySign" data-type="radio"
                                     data-group="Accbook.EmergencySign" data-defaultvalue="G"
                                     data-disabled="true"></div>
                            </div>
                        </td>
                        <td>#springMessage('table.fcAccbook.rmk')</td>
                        <td width="30%" colspan="3">
                            <input type="text" name="accbook.rmk" id="ExtRmk" autocomplete="off" class="layui-input"
                                   readonly="readonly" style="width: 100%">
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </div>
</form>
<div class="input150-container">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('common.button.search')</h2>
            <div class="layui-colla-content  layui-show">
                <form id="searchForm" class="layui-form">
                    <table class="layui-table">
                        <tbody>
                        <tr>
                            ##交易日期
                            <td class="textRight">#springMessage('table.btNetChalk.transTime')</td>
                            <td width="40%">
                                <div class="date-interval"></div>
                            </td>
                            ##收款单位CORP_ID
                            <td class="textRight">#springMessage('table.btNetChalk.corpId')</td>
                            <td width="40%">
                                <div class="bt-biz-corp"
                                     data-biz-type="net"
                                     data-type="selectTree"
                                     data-name="ins_corpId"
                                     data-tree-type="check"
                                     data-scope="all"
                                     data-callback="corpCallback"
                                     data-resource="fcl:btnetchalk:common:query"></div>
                            </td>
                            ##本方账号 BANK_ACC
                            <td class="textRight">#springMessage('table.btNetChalk.bankAcc')</td>
                            <td>
                                <input type="text" id="likes_bankAcc" name="likes_bankAcc" data-name="likes_bankAcc" data-biz-name="likes_bankAcc" accountType="2,3" autocomplete="off" containDelBankAcc="true"
                                       data-resource="fcl:btnetchalk:common:query"  class="layui-input bt-biz-accountTable" data-callback="accountCallBack" permission="D"/>
                                ##                                <input type="text" name="likes_bankAcc" class="layui-input bank">
                            </td>
                        </tr>
                        <tr>
                            ##本方账号名 accName
                            <td class="textRight">#springMessage('table.btNetChalk.accName')</td>
                            <td>
                                <input type="text" name="likes_accName" class="layui-input">
                            </td>
                            ##币别代码
                            <td class="textRight">#springMessage('table.btNetChalk.curId')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <div class="bt-biz-selectType" data-biz-name="curId"
                                         data-url="${basePath}/basic/business/btcurrency/json"
                                         data-valuefield="id" data-textfield="curName" data-name="eqs_curId"
                                         data-search="true"></div>
                                </div>
                            </td>
                            ##金额
                            <td class="textRight">#springMessage('table.btNetChalk.money')</td>
                            <td>
                                <input type="text" data-name="geg_money"
                                       class="layui-input bt-input-inline  bt-biz-moneyType" data-moneyendid="t2">
                                <span class="date-mid">~</span>
                                <input type="text" data-name="leg_money"
                                       class="layui-input bt-input-inline  bt-biz-moneyType" id="t2">
                            </td>
                        </tr>
                        <tr>
                            ##摘要
                            <td class="textRight">#springMessage('table.btNetChalk.purpose')</td>
                            <td>
                                <input type="text" name="likes_remark" autocomplete="off" class="layui-input">
                            </td>
                            ##附言
                            <td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
                            <td>
                                <input type="text" name="likes_postscript" autocomplete="off" class="layui-input">
                            </td>
                            ##备注
                            <td class="textRight">#springMessage('table.ratItemCustom.remark')</td>
                            <td>
                                <input type="text" name="likes_purpose" autocomplete="off" class="layui-input">
                            </td>
                        </tr>
                        <tr>
                            ##对方账号
                            <td class="textRight">#springMessage('table.btNetChalk.oppAccNo')</td>
                            <td>
                                <input type="text" name="likes_oppAccNo" class="layui-input">
                            </td>
                            ##对方账号名
                            <td class="textRight">#springMessage('table.btNetChalk.oppAccName')</td>
                            <td>
                                <input type="text" name="likes_oppAccName" class="layui-input">
                            </td>
                            ##对方账号开户行
                            <td class="textRight">#springMessage('table.btNetChalk.oppBankName')</td>
                            <td>
                                <input type="text" name="likes_oppBankName" class="layui-input">
                            </td>
                        </tr>

                        <tr>
                            <td colspan="6" style="text-align: center;">
                                <button class="layui-btn" lay-submit="" lay-filter="search"
                                        type="button">#springMessage('common.button.search')</button>
                                <button type="reset" class="layui-btn">#springMessage('common.button.reset')</button>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </form>
                <table id="appTable" class="layui-table layui-form" style="width:100%;">
                    <thead>
                    <tr>
                        <th>#springMessage('table.btNetChalk.transTime')</th>
                        <th>#springMessage('table.btNetChalk.bankName')</th>
                        <th>#springMessage('table.btNetChalk.corpId')</th>
                        <th>#springMessage('table.btNetChalk.bankAcc')</th>
                        <th>#springMessage('table.btNetChalk.cntAccount')</th>
                        <th>#springMessage('table.btNetChalk.accName')</th>
                        <th>#springMessage('table.btNetChalk.curId')</th>
                        <th>#springMessage('table.btNetChalk.money')</th>
                        <th>#springMessage('table.btNetChalk.oppAccNo')</th>
                        <th>#springMessage('table.btNetChalk.oppAccName')</th>
                        <th>#springMessage('table.btNetChalk.oppBankName')</th>
                        <th>#springMessage('table.btNetChalk.orderNo')</th>
                        <th>#springMessage('table.btNetChalk.purpose')</th>
                        <th>#springMessage('table.nisBillhead.addWord')</th>
                        <th>#springMessage('table.ratItemCustom.remark')</th>
                        <th>#springMessage('table.cmsPrecativeLoanInfo.tallySign')</th>
                    </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/common/uploader.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/finacial/common/common.setCashFlowItem.js?_btv=${resourceVersion}"></script>
<script>
    bt.use(['form', 'layedit', 'selectTable', 'btdate', 'bank', 'select', 'accountTable', 'moneyType', 'dicts', 'bttable', 'element', 'datatable', 'mulselect', 'corp', 'dateType', 'selectType', 'region'], function () {
        element = layui.element();
        $ = bt.jquery, form = bt.form();
        tt = bt.mulselect.init();
        bt.bank.init({elem: '.bank',})
        region = bt.region.init();
        moneyType = bt.moneyType.init();
        moneyFun = bt.moneyType.getFun();
        dateType = bt.dateType.init();
        selectType = bt.selectType.init();
        dicts = bt.dicts.init();
        dicts = bt.dicts.init();

        accountCallBack = function (data) {
            $("#likes_bankAcc").val(data.bankAcc);
            selectType.get("curId").val(data.curId);
        }
        var accountTable = bt.accountTable.init();

        // 选择单位回调
        corpCallback = function (id) {
            // 重新根据单位ID加载账户表格
            accountTable.get("likes_bankAcc").setCorp(id);
        }
        bt.corp.init();

        var tableData;
        //监听暂存
        form.on('submit(temp)', function (data) {
            var mergeFlag = $("#mergeFlag").val();
            var action = "/finacial/bankCollect/bisAccDtlTallyOtherPay/save";
            if (mergeFlag === '1') {
                // 合并记账
                action = "/finacial/bankCollect/bisAccDtlTallyOtherPay/mergeSave";
            }
            return submitData(data, action);
        });
        //监听提交
        form.on('submit(submit)', function (data) {
            var mergeFlag = $("#mergeFlag").val();
            var action = "/finacial/bankCollect/bisAccDtlTallyOtherPay/submit";
            if (mergeFlag === '1') {
                // 合并记账
                action = "/finacial/bankCollect/bisAccDtlTallyOtherPay/mergeSubmit";
            }
            return submitData(data, action);
        });

        var opType = $("#opType").val();

        var buttonOptions = [];

        if (opType == "Init") {
            buttonOptions = [
                {
                    text: bt.lang('Finacial.accbook.common.button.totalAdd'),
                    action: function (e, dt, node, config) {
                        var data = dt.rows('.selected').data();
                        var len = data.length;
                        if (len < 2) {
                            layer.msg(bt.lang('netbank.message.confirm.selectdata'));
                            return;
                        }
                        var rowData = data.splice(0, len);
                        // 必须同本方账号，交易日期
                        var ids = "";
                        for (var i = 0; i < rowData.length; i++) {
                            if (ids === "") {
                                ids += rowData[i].id;
                            } else {
                                ids += "," + rowData[i].id;
                            }
                        }
                        var type = $("#opType").val();
                        totalTally(ids, type, rowData[0]);
                    }
                },
                {
                    text: bt.lang('Finacial.accbook.common.button.mergeAdd'),
                    action: function (e, dt, node, config) {
                        var data = dt.rows('.selected').data();
                        var len = data.length;
                        if (len < 2) {
                            layer.msg(bt.lang('netbank.message.confirm.selectdata'));
                            return;
                        }
                        var rowData = data.splice(0, len);
                        // 必须同网点、同交易日期、同币别
                        var ids = "";
                        for (var i = 0; i < rowData.length; i++) {
                            if (ids === "") {
                                ids += rowData[i].id;
                            } else {
                                ids += "," + rowData[i].id;
                            }
                        }
                        var type = $("#opType").val();
                        mergeTally(ids, type, rowData[0], null, true);
                    }
                },
                {
                    text: bt.lang("common.button.cancel"),
                    action: function (e, dt, node, config) {
                        var data = dt.rows('.selected').data();
                        var len = data.length;
                        if (len < 1) {
                            layer.msg("#springMessage('table.fcBankBill.msg.chooseLeastOne')");
                            return;
                        }
                        var ids = "";
                        var rowData = data.splice(0, len);
                        for (var i = 0; i < rowData.length; i++) {
                            if (ids == "") {
                                ids += rowData[i].id;
                            } else {
                                ids += "," + rowData[i].id;
                            }
                        }
                        parent.layer.confirm(bt.lang("common.message.confirm.cancel"), function () {
                            $.post(basePath + "/finacial/bankCollect/bisAccDtlTallyOtherPay/cancelBisAccDtl/", {ids: ids}, function (result) {
                                datatable.draw();
                            }, 'JSON');
                        });
                    }
                }
            ];
        }

        //监听打回
        form.on('submit(back)', function (data) {
            bt.loading.show();//显示加载中
            var mergeFlag = $("#mergeFlag").val();
            var action = "/finacial/bankCollect/bisAccDtlTallyOtherPay/back";
            if (mergeFlag === '1') {
                // 合并记账
                action = "/finacial/bankCollect/bisAccDtlTallyOtherPay/mergeBack";
            }
            parent.layer.prompt({
                title: bt.lang('table.cmsLoanInfo.refuseWhy'),
                formType: 2,
                cancel: function (index, layero) {
                    bt.loading.hide(); //关闭加载中
                },
                end: function () {
                    bt.loading.hide(); //关闭加载中
                }
            }, function (pass) {
                data.field['bookExt.invalidReason'] = pass;
                //内部参数配置不一致,转换为枚举参数
                if ($("#opType").val() == 'Edit') {
                    data.field['opType'] = "MODIFY";
                } else if ($("#opType").val() == 'Check') {
                    data.field['opType'] = "CHECK";
                }

                $("#submitDiv").find('button').addClass("layui-btn-disabled").attr('disabled', 'disabled');
                // }, 350);
                $.post(basePath + action, data.field, function (result) {
                    if (result.success) {
                        // location.reload();
                        refreshTable();
                        parent.layer ? parent.layer.closeAll() : layer.closeAll();
                    } else {
                        $("button[lay-filter='temp'] ").removeClass("layui-btn-disabled");
                        $("button[lay-filter='temp'] ").removeAttr("disabled");
                        $("button[lay-filter='submit'] ").removeClass("layui-btn-disabled");
                        $("button[lay-filter='submit'] ").removeAttr("disabled");
                        $("button[lay-filter='back'] ").removeClass("layui-btn-disabled");
                        $("button[lay-filter='back'] ").removeAttr("disabled");
                        $("button[lay-filter='pass'] ").removeClass("layui-btn-disabled");
                        $("button[lay-filter='pass'] ").removeAttr("disabled");
                    }
                    bt.loading.hide(); //关闭加载中
                    parent.layer ? parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}) : layer.alert(result.msg, {icon: result.success ? 1 : 2});
                }, 'JSON');
            });
            return false;
        });

        //监听通过
        form.on('submit(pass)', function (data) {
            data.field["accbook.attachmentId"] = uploader.getGroupId();
            bt.loading.show();//显示加载中
            var mergeFlag = $("#mergeFlag").val();
            var action = "/finacial/bankCollect/bisAccDtlTallyOtherPay/pass";
            if (mergeFlag === '1') {
                // 合并记账
                action = "/finacial/bankCollect/bisAccDtlTallyOtherPay/mergePass";
            }
            data.field['opType'] = "CHECK";

            $("#submitDiv").find('button').addClass("layui-btn-disabled").attr('disabled', 'disabled');
            $.post(basePath + action, data.field, function (result) {
                if (result.success) {
                    refreshTable();
                    parent.layer ? parent.layer.closeAll() : layer.closeAll();
                } else {
                    $("button[lay-filter='temp'] ").removeClass("layui-btn-disabled");
                    $("button[lay-filter='temp'] ").removeAttr("disabled");
                    $("button[lay-filter='submit'] ").removeClass("layui-btn-disabled");
                    $("button[lay-filter='submit'] ").removeAttr("disabled");
                    $("button[lay-filter='back'] ").removeClass("layui-btn-disabled");

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 22px; 
	text-decoration: underline;
	text-align: center;
	/*color: blue;*/
	/*color: #00CC33;*/
}
</style>    
</head>
<body>
<form id="searchForm" class="layui-form">
	<input type="hidden" id="opType" name="opType" value="$!{opType}">
	<input type="hidden" id="menuType" name="menuType" value="$!{menuType}">
	<table class="layui-table">
		<tbody>
			<tr>
				##委托单位
        		<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.precativeId')</td>
        		<td width="40%" style="text-align:left;">
       				<div class="layui-input-inline">
                   		<div class="bt-biz-corp" 
							 data-biz-type="corp" 
							 data-type="selectTree" 
							 data-name="eqs_precativeId" 
							 data-biz-name="precativeId" 
							 data-scope="all"
							 data-tree-type="check" 
							 data-resource="fcl:precative:tally:apply"></div>
           			</div>
           		</td>
           		##借款单位
           		<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</td>
        		<td width="40%" style="text-align:left;">
       				<div class="layui-input-inline">
       					<div class="bt-biz-corp" 
							 data-biz-type="corp" 
							 data-type="selectTree" 
							 data-name="eqs_loanOpp" 
							 data-scope="all" 
							 data-tree-type="check"
                             data-resource="fcl:precative:tally:apply"></div>
           			</div>
           		</td>
       		</tr>
        	<tr>
        		##申请日期
        		<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.startDate')</td>
       			<td width="40%" style="text-align:left;">
                   	<input type="text" name="ged_startDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="startDate">
   					<span class="date-mid">~</span>
   					<input type="text" name="led_startDate" class="layui-input bt-input-inline bt-biz-dateType" id="startDate">
          			</td>
				##币别
				<td class="textRight">#springMessage('table.btNetChalk.curId')</td>
				<td>
		         	<div class="layui-input-inline">
		         		<div class="bt-biz-selectType" data-biz-name="curId" data-url="${basePath}/basic/business/btcurrency/json" 
		         				data-valuefield="id" data-textfield="curName" data-name="eqs_curId" data-search="true"></div>
                   	</div>
				</td>	 
			</tr>
      			<tr>
				##金额
          			<td style="text-align:right;">#springMessage('table.cmsPrecativeLoanInfo.money')</td>
       			<td width="40%" style="text-align:left;">
                    <input type="text" data-name="geg_infoMoney" class="layui-input bt-input-inline  bt-biz-moneyType" data-moneyendid="money">
       				<span class="date-mid">~</span>
        			<input type="text" data-name="leg_infoMoney" class="layui-input bt-input-inline  bt-biz-moneyType" id="money">
           		</td>
       		 	##合同编号
	            <td class="textRight">#springMessage('table.cmsPrecativeLoanInfo.contractCode')</td>
	            <td width="30%">
                	<input name="eqs_contractCode" class="layui-input">
	            </td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn">#springMessage('common.button.reset')</button>
				</td>
			</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
			<tr>
		        <th>#springMessage('table.cmsPrecativeLoanInfo.billCode')</th>
		        <th>#springMessage('table.cmsPrecativeLoanInfo.precativeId')</th>
		        <th>#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</th>
		        <th>#springMessage('table.cmsPrecativeLoanInfo.contractCode')</th>
		        <th>#springMessage('table.cmsPrecativeLoanInfo.startDate')</th>
		        <th>#springMessage('table.cmsPrecativeLoanInfo.endDate')</th>
		        <th>#springMessage('table.cmsPrecativeLoanSend.sendDate')</th>
		        <th>#springMessage('table.cmsPrecativeLoanInfo.term')</th>
		        <th>#springMessage('table.cmsPrecativeLoanInfo.curId')</th>
		        <th>#springMessage('table.cmsPrecativeLoanInfo.money')</th>
		        <th>#springMessage('table.cmsPrecativeLoanSend.money')</th>
		        <th>#springMessage('table.cmsPrecativeLoanSend.contractCode')</th>
		        <th>#springMessage('table.cmsPrecativeLoanSend.money')</th>
		        <th>#springMessage('table.cmsPrecativeLoanInfo.loanSendOutType')</th>
		   		<th>#springMessage('table.cmsPrecativeLoanInfo.tallySign')</th> 
  			</tr>
	</thead>
</table>

#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','layedit','selectTable','btdate','bank','select','moneyType','dicts','bttable','element','datatable','mulselect','corp','dateType','selectType','region'], function(){
	var tableData ;
	element = layui.element();
    $ = bt.jquery;
    form = bt.form();
    tt = bt.mulselect.init();
    bt.bank.init({ elem:'.bank',})
    region = bt.region.init();
    moneyType = bt.moneyType.init();
    moneyFun = bt.moneyType.getFun();
    dataType = bt.dateType.init();
	dateFun = bt.dateType.getFun();
    bt.corp.init();
    selectType = bt.selectType.init();
    
    //生成列表
    datatable = bt.datatable.init({
        elem: "#appTable",
        dom: 'Brtlip',
        colReorder: true,
        checkbox:false,
        mulselect:false,
        selectCss:true,
        order: [1,'desc'],
        fixedColumns:{
        	leftColumns:0
        },
        ajax: {
            'url': basePath+"/finacial/bankCollect/precativeTally/datatable"
        },searchForm:{
            formFilter:"search",
            formElem:"#searchForm"
        },
       /*  buttons: [{
            text: bt.lang("Finacial.accbook.common.button.add"),
            action: function ( e, dt, node, config ) {
            	var length = $("#printMRTable tbody>tr").length;
            	var data = dt.rows('.selected').data();
            	var len = data.length;
                if(len<1){
                	layer.msg("#springMessage('table.fcBankBill.msg.chooseLeastOne')");
                	return;
                }
                var rowData = data.splice(0,len);
             	var id = rowData[0].billCode;
             	var type = $("#opType").val();
             	var menuType = $("#menuType").val();
             	parent.parent.$("#menuType").val(menuType);
             	parent.parent.$("#key").val(id);
             	parent.parent.$("#curCode").val(rowData[0].curId);
             	parent.parent.$("#netId").val(rowData[0].corpId);
             	parent.parent.$("#precativeId").val(rowData[0].precativeId);
             	parent.parent.$("#loanOpp").val(rowData[0].loanOpp);
             	$.post(basePath + "/finacial/bankCollect/precativeTally/processAccbook/",{key:id,type:type,menuType:menuType}, function(result){
             		if(typeof result.success == "boolean" && result.success == false){
             			layer.alert(result.msg);
                    	return;
             		}
             		parent.parent.bt.setDate(result);
             	},'JSON');
            }
        }
        ], */
        columns: [
            {data:"infoBillCode",bSortable:false,className:"center"},
            {data:"precativeName",bSortable:false,className:"center"},
            {data:"loanOppName",bSortable:false,className:"center"},
            {data:"infoContractCode",bSortable:false,className:"center"},
            {data:"startDate",bSortable:false,className:'center',
				render:function (data){
					return dateFun.format(data, 'yyyy-MM-dd')
				}},
            {data:"endDate",bSortable:false,className:'center',
				render:function (data){
					return dateFun.format(data, 'yyyy-MM-dd')
				}},
            {data:"sendDate",bSortable:false,className:"center",
				render:function (data){
					return dateFun.format(data, 'yyyy-MM-dd')
				}},
            {data:"term",bSortable:false,className:"center",
            	render : function( data , type , full , meta ){
            		return full.term + full.ternUnitStatus;
            	}	
            },
            {data:"curName",bSortable:false,className:"center"},
            {data:"infoMoney",bSortable:false,className:"textRight",
            	render: function (data, type, full, meta) {
            		return moneyFun.format(full.infoMoney);
            	}
            },
            {data:"money",bSortable:false,className:"textRight",
            	render: function (data, type, full, meta) {
            		return moneyFun.format(full.money);
            	}
            },
            {data:"contractCode",bSortable:false,className:"center"},
            {data:"sendApproveMoney",bSortable:false,className:"textRight",
            	render: function (data, type, full, meta) {
            		return moneyFun.format(full.sendApproveMoney);
            	}
            },
         /*    {data:"plName",bSortable:true,className:"textRight"}, */
         	{data:"loanSendOutType",bSortable:false,className:"center",
            	render: function (data, type, full, meta) {
                	return bt.dict("cms.loan.loanSendOutType",full.loanSendOutType);
            	}
         	},
			{data:"tallySign",bSortable:false,className:"center",
			    render:function(data,type,full,meta){
					return bt.dict("cms.tallySign",full.tallySign == null ? 0 : full.tallySign );
				}
			}
        ],
        btInitComplete:function(setting,json){
        	tableData = json.data;
        },
		btDrawCallback:function(setting){
        	tableData = setting.json.data;
        }
    });
    
    $('#appTable tbody').on('dblclick','tr',function(data){  
        var dataIndex = $(this).context.rowIndex - 1;
        //var data = tableData.rows('.selected').data();
        rowData = tableData[dataIndex];
        var id = rowData.billCode;
     	var type = $("#opType").val();
     	var menuType = $("#menuType").val();
     	parent.parent.$("#menuType").val(menuType);
     	parent.parent.$("#key").val(id);
     	parent.parent.$("#curCode").val(rowData.curId);
     	parent.parent.$("#netId").val(rowData.corpId);
     	parent.parent.$("#precativeId").val(rowData.precativeId);
     	parent.parent.$("#loanOpp").val(rowData.loanOpp);
     	$.post(basePath + "/finacial/bankCollect/precativeTally/processAccbook/",{key:id,type:type,menuType:menuType}, function(result){
     		if(typeof result.success == "boolean" && result.success == false){
     			layer.alert(result.msg);
            	return;
			}
			//增加背景色
			var row = datatable.row(dataIndex).node();
			$(".row_bg").removeClass("row_bg");
			$(row).addClass("row_bg");
			parent.parent.uploaderRender(type,result);
     		parent.parent.bt.setDate(result);
     	},'JSON');
	});  
});

</script>

</html>
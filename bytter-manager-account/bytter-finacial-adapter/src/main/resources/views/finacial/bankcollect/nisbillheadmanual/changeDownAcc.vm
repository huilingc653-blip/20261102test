#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','layedit','selectTable'], function(){
	$ = bt.jquery, form = bt.form();
	//资金下拨账号
    var downAccInit = bt.selectTable.init({
        elem: "#downAccTable",
        url: basePath + "/finacial/bankCollect/manualFinacial/getDownAcc",
        urldata: {creditAcc: $("#creditAcc").val(), curId: $('#curId').val(), debitAcc: $("#debitAcc").val()},
        scrollX: "600px",
        scrollY: "200px",
        searchInput: "#downAcc",
        paging: true,
        columns: [
            {data: "bankAcc",},
            {data: "accName",},
            {data: "bankName",},
            {data: "curName"}
        ],
        clickCallback: function (data) {
            if (data) {
                $('#downAccId').val(data.id);
                $('#downAcc').val(data.bankAcc);
            } else {
                $('input.text').val('');
            }
        }
    });
	
  //监听通过
    form.on('submit(submit)', function(data){
    	var opType = $("#opType").val();
    	if(opType == 'Check'){
    		var action = "/finacial/bankCollect/manualFinacial/payPass";
    		$.post(basePath + action,data.field,function(result){
                bt.loading.hide(); //关闭加载中
                if(result.success){
                	bt.navtab.refresh($(top.document).find('.layui-tab-title li.layui-this').attr('lay-id'));//刷新父页面
                    $("#submitDiv").find('button').addClass("layui-btn-disabled").attr('disabled','disabled');
                    parent.layer?parent.layer.closeAll():layer.closeAll();
                   
                }
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            },'JSON');
    		
    		
    	}else{
	    	bt.navtab.getCurrentDom().bt.jquery("#downAccId").val($("#downAccId").val());
	    	parent.layer?parent.layer.closeAll():layer.closeAll();
	    	//parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
    	}
    	//parent.layer ? parent.layer.closeAll() : layer.closeAll();
    });
});

</script>

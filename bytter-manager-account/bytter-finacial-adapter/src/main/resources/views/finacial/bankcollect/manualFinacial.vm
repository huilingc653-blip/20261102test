    	}else{
    		account = '<td><div><input type="text" name="bookDtls[' + rowMR + '].account" id="account' + rowMR + '" value = "'+ ( bookDtl.account == null ? "" : bookDtl.account ) +'" class="layui-input text" readonly="readonly" style="width: 100%">'
   		 + '</div></td>';
    	}
		var html='<tr row="'+rowMR+'">';

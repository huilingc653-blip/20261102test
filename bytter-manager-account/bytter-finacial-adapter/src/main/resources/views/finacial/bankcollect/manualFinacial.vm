    //初始化账号
    bt.initSelectAccount = function(row, obj){
        var menuType = $("#menuType").val();
    	var key = $("#key").val();
    	var url = basePath+"/finacial/bankCollect/manualFinacial/getFcAcc?menuType="+menuType +"&key=" + key;
    	var loadDownAcc = true;
    	if(menuType == "1" || menuType == "5"){
    		//借方账号查询模式（转付、代付、下拨、请款借方账户获取单位对应的内部账户）
    		if(row == 0 && obj.controlVo.debitAccountLoadModle) {
				url = basePath + "/finacial/bankCollect/manualFinacial/getFcAccDebit?menuType=" + menuType + "&key=" + key;
				loadDownAcc = false;
			}
		}

		selectTableIds.push("#example"+row);

		var selectTab = bt.selectTable.init({
			elem: "#example"+row,
			url: url,
			scrollX: true,
			scrollY:"200px",
       	  	paging:true,
			searchInput:"#account"+row,
			columns: [
			    {data:"blnctrAcc",},
			    {data:"accName",},
			    {data:"subjectName",},
			],
			clickCallback:function(data){
				$("#account"+row).val(data.blnctrAcc);
				$("#accName"+row).text(data.accName);
				$("#baccName"+row).val(data.accName);
				// 加载现金流项目
				loadCashFlowItem(row, data.blnctrAcc, null, null);
				if(menuType == "5" && row == 1){
					$("#creditAcc").val(data.blnctrAcc);
				}
				if(flag && loadDownAcc){
					var cur = $("#curCode").val();
					var corpId = $("#netId").val();
					var account = $("#payerAcc").val();
					parent.layer.open({
						title: bt.lang("table.tally.change.account"),
				        type: 2,
				        area: ['60%', '50%'],
				        maxmin: false,
				        content: basePath + "/finacial/bankCollect/manualFinacial/changeDownAcc?curId="+ cur +"&menuType="+$("#menuType").val()
		        			+"&account="+ account+ "&creditAcc=" + $("#creditAcc").val() + "&key=" + key,
				        end:function(){
				            //location.reload();
				        }
					});
				}
			}
       	});
    }


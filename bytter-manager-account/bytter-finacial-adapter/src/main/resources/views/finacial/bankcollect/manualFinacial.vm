			html+='<td><input type="text" name="bookDtls[' + rowMR + '].summaryContent" id="summaryContent' + rowMR + '"  class="layui-input" maxlength="32" style="width: 100%" value = "'+ ( bookDtl.summaryContent == null ? "" : bookDtl.summaryContent ) +'"/></td>';
		}else{
			html+='<td><input type="text" name="bookDtls[' + rowMR + '].summaryContent" id="summaryContent' + rowMR + '"  class="layui-input" maxlength="32" style="width: 100%" value = "'+ ( bookDtl.summaryContent == null ? "" : bookDtl.summaryContent ) +'" readonly="readonly"/></td>';
		}
		html+= account;
		html+='<td><div id="accName' + rowMR + '">'+ ( bookDtl.accName == null ? "" : bookDtl.accName ) +'</div>'
		+ '<input id="baccName' + rowMR + '" name="bookDtls[' + rowMR + '].accName" type="hidden" value = "'+ ( bookDtl.accName == null ? "" : bookDtl.accName ) +'" ></td>';
		html+='<td><input type="text" class="layui-input border0" maxlength="32" name="bookDtls[' + rowMR + '].origVoucherNo" value = "'+ (bookDtl.origVoucherNo == null ? "" : bookDtl.origVoucherNo) +'" id="origVoucherNo' + rowMR + '"  style="width: 100%" readonly="readonly" />';
		html+='<input type="hidden" name="bookDtls[' + rowMR + '].origVoucherId" value = "'+ (bookDtl.origVoucherId == null ? "" : bookDtl.origVoucherId) +'" id="origVoucherId' + rowMR + '"  /></td>';
		html+= '<td><input id="debitMoney' + rowMR + '"  class="layui-input bt-biz-moneyType border0"   value = "'+ ( bookDtl.debitMoney == null ? "" : bookDtl.debitMoney ) +'" name="bookDtls[' + rowMR + '].debitMoney" type="text" readonly="readonly"  style="width: 100%" /></td>';
		html+='<td><input id="creditMoney' + rowMR + '"   class="layui-input bt-biz-moneyType border0"  value = "'+ ( bookDtl.creditMoney == null ? "" : bookDtl.creditMoney ) +'"  name="bookDtls[' + rowMR + '].creditMoney" type="text" readonly="readonly" style="width: 100%" /></td>';
		html += '<td><span id="cashFlowItem' + rowMR + '"><input type="hidden" value="' + (isNotEmpty(bookDtl.cashFlux) ? bookDtl.cashFlux : "") + '" name="bookDtls[' + rowMR + '].cashFlux">' + (isNotEmpty(bookDtl.cashFluxName) ? bookDtl.cashFluxName : "") + '</span></td>';
		//html+='<td><input type="text" name="bookDtls[' + rowMR + '].cashFlux" value = "'+ ( bookDtl.cashFlux == null ? "" : bookDtl.cashFlux ) +'" id="cashFlux' + rowMR + '" class="layui-input" maxlength="32" style="width: 100%" readonly="readonly" /></td>';
		html+='</tr>';
		// 加载现金流项目
		if (isEmpty(bookDtl.cashFlux)) {
			loadCashFlowItem(rowMR, bookDtl.account, bookDtl.debitMoney, bookDtl.creditMoney);
		}
        return html;
	}

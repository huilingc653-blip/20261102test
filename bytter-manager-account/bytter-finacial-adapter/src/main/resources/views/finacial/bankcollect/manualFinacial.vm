function checkVoucherType(voucherType){
	var action = "/finacial/bankCollect/manualFinacial/chenckVoucherType";
	$.post(basePath + action, {voucherType : voucherType},function(result){
		flag = result;
    },'JSON');
}

function checkVoucherTypeInner(voucherType){
	//var isOk ;
	var action = "/finacial/bankCollect/manualFinacial/chenckVoucherTypeInner";
	$.post(basePath + action, {voucherType : voucherType},function(result){
		if(result == true) {
			$("#back").show();
		}
    },'JSON');
	//return isOk;
}

/**判断字符串是否为空*/
function isEmpty(ms){
	if(typeof(ms) === "undefined" || ms === null || ms === ""){
		return true;
	}
	return false;
}


/**
 * 日期校验
 */
function checkInterestStartDate() {
	//记账日期
	var tallyDate = dataType.get("tallyDate").val();
	// 起息日期
	var interestDate = dataType.get("interestStartDate").val();
	if (!isEmpty(tallyDate) && !isEmpty(interestDate)) {
		if (bt.date.compare(interestDate, tallyDate) > 0) {
			layer.alert(bt.lang("fin.book.tally.intereststart.after"), {icon: false ? 1 : 2})
			dataType.get("interestStartDate").val("");
		}
	}
}



var testCreate=function(billCode,rowMR,subjectCode){
	var params = "billCode=" + billCode + "&subjectCode=" + subjectCode;
	if(rowMR == 2){
		params+="&precationAcc="+depositAcc.blnctrAcc;
	}
	if(bt.navtab){
        bt.navtab.addNavtab(bt.lang("table.innerAcc.acc"),basePath + "/finacial/bankCollect/precativeTally/createFcAcc?" + params);
    }
}


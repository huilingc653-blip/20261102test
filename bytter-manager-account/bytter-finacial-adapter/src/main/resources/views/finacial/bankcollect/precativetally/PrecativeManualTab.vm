<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")

<style type="text/css">
.layui-body2 {
	padding：0px;
	position: absolute;
	left: 0px;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 2000;
	width: auto;
	overflow: hidden;
	overflow-y: auto;
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box; 
}
</style> 
</head>
<body>
<div class="layui-body2" style="width: 100%; height: 100%">
	<div class="layui-tab layui-tab-brief"  style="width: 100%; height:710px">
		<ul class="layui-tab-title">
			<li class="layui-this" lay-id="rushbook">#springMessage('cms.precative.loan')</li>##贷款
			<li lay-id="oribook">#springMessage('cms.precative.repay')</li>##还款
		</ul>
    	<div class="layui-tab-content" style="width: 100%; height:670px;padding: 0px;">
      	##委托贷款
       	<div class="layui-tab-item layui-show" style="width: 100%; height: 100%">
           	<iframe id="sendPage" src="${basePath}/finacial/bankCollect/precativeTally/manualPage?opType=$!{opType}&menuType=41" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
         ##还款
         <div class="layui-tab-item" style="width: 100%; height:670px;padding: 0px;">
         	<iframe id="repayPage" src="${basePath}/finacial/bankCollect/precativeTally/manualPage?opType=$!{opType}&menuType=42" frameborder="0" style="width: 100%; height: 100%"></iframe>
         </div>
       </div>
    </div>
</div> 
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['element', 'form','layedit','btdate'], function(){
	//注意：选项卡 依赖 element 模块，否则无法进行功能性操作
	var $ = bt.jquery,form = bt.form();
	var element = layui.element();
});

</script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##所属网点
                    <td class="textRight">#springMessage('table.fcDayClose.netCode')</td>
                    <td width="40%">
                        <div class="layui-input-inline">
                            <input type="text" name="eqs_netCode"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcDayClose.netCode')">
                        </div>
                    </td>
                    ##日结日期
                    <td class="textRight">#springMessage('table.fcDayClose.closeDate')</td>
                    <td width="40%">
                        <div class="layui-inline">
                            <div type="date" field="liked_closeDate" defaultVal="$!{fcDayClosePage.closeDate}"></div>
                        </div>
                    </td>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcDayClose.lastCloseDate')</th>
        <th>#springMessage('table.fcDayClose.netCode')</th>
        <th>#springMessage('table.fcDayClose.closeDate')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/closedeal/fcDayClose.list.js?_btv=${resourceVersion}"></script>
</html>

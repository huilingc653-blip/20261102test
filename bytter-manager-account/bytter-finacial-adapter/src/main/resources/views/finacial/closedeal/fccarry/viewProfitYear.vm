<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
        .voucher-title {
            font-weight: bold;
            font-size: 22px;
            text-decoration: underline;
            text-align: center;
        }
    </style>
</head>
<body>
#if($!{showNoDataBox} == "1")
<div style="text-align: center;margin-top: 80px;">
                <img src="${basePath}/static/v3.2/images/pic_blank.png" class="empty-pic" style="margin-top: 30px;">
                <div class="empty-text">#springMessage("common.msg.temporarily_no_data")</div>
</div>
#else
<!-- 这里填写新HTML的代码 -->
<div class="layui-tab layui-tab-card" lay-filter="accbookTab">
    <ul class="layui-tab-title">
        #foreach($fcAccbookVoucherVO in $voucher.target)
            #if($!{velocityCount} == 1)
                <li lay-id="tab$!{velocityCount}" class="layui-this">$!{fcAccbookVoucherVO.accbook.rmk}</li>
            #else
                <li lay-id="tab$!{velocityCount}">$!{fcAccbookVoucherVO.accbook.rmk}</li>
            #end
        #end
    </ul>
    <div class="layui-tab-content" style="height: auto;">
        #foreach($fcAccbookVoucherVO in $voucher.target)
            #if($!{velocityCount} == 1)
                <div class="layui-tab-item layui-show">
                    <div class="voucher-title">
                    ##记账凭证
                        <label>#springMessage('table.fcAccbook.tallyTitle')</label>
                    </div>
                    <div style="position:relative;text-align:right;top:-22px;height:10px;margin-bottom:-20px">
                    ##                        附件张数
                        <div><span style="width:250px;text-align:left;white-space: nowrap;">#springMessage(
                            'table.fcAccbook.affixAmount')：<span
                                style="width:50px">$!{fcAccbookVoucherVO.accbook.affixAmount}</span></span></div>
                    ##                        业务种类，币别
                        <div><span style="width:250px;text-align:left;white-space: nowrap;">#springMessage(
                            'table.fcAccbook.busRaceId')：<span
                                style="width:50px">$!{fcAccbookVoucherVO.accbook.raceName}</span>&nbsp;&nbsp;#springMessage(
                            'table.fcAcc.curId')：<span
                                style="width:50px">$!{fcAccbookVoucherVO.bookDtls[0].accDTO.curName}</span></span></div>
                    </div>
                    <br>
                    <table class="layui-table">
                        <tr>
                        ##                          摘要
                            <td colspan="3">#springMessage('table.fcChargeRule.summary')</td>
                        ##                          科目
                            <td colspan="2">#springMessage('table.intere.subjectAcc')</td>
                        ##                            户名
                            <td colspan="4">#springMessage('table.accountDTO.accName')</td>
                        ##                            凭证种类
                            <td>#springMessage('table.bvPrintFormat.voucherType')</td>
                        ##                              原始凭证号码
                            <td>#springMessage('table.interetDtl.oldVoucher')</td>
                        ##                            借方发生额
                            <td colspan="1">#springMessage('table.fcAccbookDtl.debitMoney')</td>
                        ##                          贷方发生额
                            <td>#springMessage('table.fcAccBalance.creditMoney')</td>
                        </tr>
                        #foreach($!bookDtl in $!{fcAccbookVoucherVO.bookDtls})
                            <tr>
                                <td rowspan="2" colspan=3 nowrap>$!{bookDtl.summaryContent}</td>
                                <td colspan=2 nowrap>$!{bookDtl.accDTO.subjectName}</td>
                                <td rowspan="2" colspan=4 style="" nowrap>$!{bookDtl.accDTO.accName}</td>
                                <td rowspan="2" nowrap>&nbsp;$!{fcAccbookVoucherVO.accbook.voucherName}</td>
                                <td rowspan="2" nowrap>&nbsp;$!{fcAccbookVoucherVO.accbook.origVoucherNo}</td>
                                <td rowspan="2" colspan=1 align='right' class="money-color"
                                    nowrap>$!number.formatNumeric($!{bookDtl.debitMoney})</td>
                                <td rowspan="2" align='right' class="money-color"
                                    nowrap>$!number.formatNumeric($!{bookDtl.creditMoney})</td>
                            </tr>
                            <tr>
                                <td colspan=2 nowrap>$!{bookDtl.accDTO.blnctrAcc}</td>
                            </tr>
                        #end
                        <tr>
                            <td nowrap rowspan="4" style="width:60px">#springMessage('fcVoucherType.rmk')</td>
                            <td nowrap>#springMessage('table.fcAccbook.tallyDate')</td>
                            <td nowrap>$!{fcAccbookVoucherVO.accbook.tallyDate}</td>
                            <td nowrap>#springMessage('table.fcAccbook.interestStartDate')</td>
                            <td nowrap style="width:80px;"
                                colspan=3>$!{fcAccbookVoucherVO.accbook.interestStartDate}</td>
                            <td nowrap>#springMessage('table.fcChargeType.emergencySign')</td>
                            <td>#springMessage('common.sc_yn.no')</td>
                            <td rowspan="2" align="right" colspan=2>#springMessage('table.datatable.total'):</td>
                            <td rowspan="2" colspan=1
                                align='right'>$!number.formatNumeric($!{fcAccbookVoucherVO.debitSum})</td>
                            <td rowspan="2" align='right'>$!number.formatNumeric($!{fcAccbookVoucherVO.creditSum})</td>
                        </tr>
                        <tr>
                            <td nowrap>#springMessage('fcAccDetail.voucherType')</td>
                            <td>&nbsp;</td>
                            <td nowrap>#springMessage('fcAccbook.relevant.voucher.number')</td>
                            <td colspan=3>&nbsp;</td>
                            <td nowrap>#springMessage('table.fcAccbookExt.tradeRate')</td>
                            <td style="width:50px">&nbsp;</td>
                        </tr>
                        <tr>
                            <td nowrap>#springMessage('table.fcAccbookExt.externalCorp')</td>
                            <td colspan=9 style="width:100px;" nowrap></td>
                            <td nowrap>#springMessage('table.fcAccbookExt.externalAcc')</td>
                            <td></td>
                        </tr>
                        <tr>
                            <td nowrap>#springMessage('table.accountDTO.bankName')</td>
                            <td colspan=5 nowrap></td>
                            <td nowrap>#springMessage('table.fcAccbookExt.prov')</td>
                            <td colspan=3 nowrap></td>
                            <td nowrap>#springMessage('table.fcAccbookExt.city')</td>
                            <td nowrap></td>
                        </tr>
                    </table>
                </div>
            #else
                <div class="layui-tab-item">
                    <div class="voucher-title">
                    ##记账凭证
                        <label>#springMessage('table.fcAccbook.tallyTitle')</label>
                    </div>
                    <div style="position:relative;text-align:right;top:-22px;height:10px;margin-bottom:-20px">
                        <div><span style="width:250px;text-align:left;white-space: nowrap;">#springMessage(
                            'table.fcAccbook.affixAmount')：<span
                                style="width:50px">$!{fcAccbookVoucherVO.accbook.affixAmount}</span></span></div>
                        <div><span style="width:250px;text-align:left;white-space: nowrap;">#springMessage(
                            'table.fcAccbook.busRaceId')：<span
                                style="width:50px">$!{fcAccbookVoucherVO.accbook.raceName}</span>&nbsp;&nbsp;#springMessage(
                            'table.fcAcc.curId')：<span
                                style="width:50px">$!{fcAccbookVoucherVO.bookDtls[0].accDTO.curName}</span></span></div>
                    </div>
                    <br>
                    <table class="layui-table">
                        <tr>
                            <td colspan="3">#springMessage('table.fcChargeRule.summary')</td>
                            <td colspan="2">#springMessage('table.intere.subjectAcc')</td>
                            <td colspan="4">#springMessage('table.accountDTO.accName')</td>
                            <td>#springMessage('table.bvPrintFormat.voucherType')</td>
                            <td>#springMessage('table.interetDtl.oldVoucher')</td>
                            <td colspan="1">#springMessage('table.fcAccbookDtl.debitMoney')</td>
                            <td>#springMessage('table.fcAccBalance.creditMoney')</td>
                        </tr>
                        #foreach($!bookDtl in $!{fcAccbookVoucherVO.bookDtls})
                            <tr>
                                <td rowspan="2" colspan=3 nowrap>$!{bookDtl.summaryContent}</td>
                                <td colspan=2 nowrap>$!{bookDtl.accDTO.subjectName}</td>
                                <td rowspan="2" colspan=4 style="" nowrap>$!{bookDtl.accDTO.accName}</td>
                                <td rowspan="2" nowrap>&nbsp;$!{fcAccbookVoucherVO.accbook.voucherName}</td>
                                <td rowspan="2" nowrap>&nbsp;$!{fcAccbookVoucherVO.accbook.origVoucherNo}</td>
                                <td rowspan="2" colspan=1 align='right' class="money-color"
                                    nowrap>$!number.formatNumeric($!{bookDtl.debitMoney})</td>
                                <td rowspan="2" align='right' class="money-color"
                                    nowrap>$!number.formatNumeric($!{bookDtl.creditMoney})</td>
                            </tr>
                            <tr>
                                <td colspan=2 nowrap>$!{bookDtl.accDTO.blnctrAcc}</td>
                            </tr>
                        #end
                        <tr>
                        ##                            备注
                            <td nowrap rowspan="4" style="width:30px">#springMessage('fcVoucherType.rmk')</td>
                        ##                            记账日期
                            <td nowrap>#springMessage('table.fcAccbook.tallyDate')</td>
                            <td nowrap>$!{fcAccbookVoucherVO.accbook.tallyDate}</td>
                        ##                            起息日期
                            <td nowrap>#springMessage('table.fcAccbook.interestStartDate')</td>
                            <td nowrap style="width:80px;"
                                colspan=3>$!{fcAccbookVoucherVO.accbook.interestStartDate}</td>
                        ##    加急标志
                            <td nowrap>#springMessage('table.fcChargeType.emergencySign')</td>
                            <td>#springMessage('common.sc_yn.no')</td>
                        ##    合计
                            <td rowspan="2" align="right" colspan=2>#springMessage('table.datatable.total'):</td>
                            <td rowspan="2" colspan=1 align='right' class="money-color"
                                nowrap>$!number.formatNumeric($!{bookDtl.debitMoney})</td>
                            <td rowspan="2" align='right' class="money-color"
                                nowrap>$!number.formatNumeric($!{bookDtl.creditMoney})</td>
                        </tr>
                        <tr>
                            <td nowrap>#springMessage('fcAccDetail.voucherType')</td>
                            <td>&nbsp;</td>
                            <td nowrap>#springMessage('fcAccbook.relevant.voucher.number')</td>
                            <td colspan=3>&nbsp;</td>
                            <td nowrap>#springMessage('table.fcAccbookExt.tradeRate')</td>
                            <td style="width:50px">&nbsp;</td>
                        </tr>
                        <tr>
                        ##                            外单位名称
                            <td nowrap>#springMessage('table.fcAccbookExt.externalCorp')</td>
                        ##    外单位账号
                            <td colspan=9 style="width:100px;" nowrap></td>
                            <td nowrap>#springMessage('table.fcAccbookExt.externalAcc')</td>
                            <td></td>
                        </tr>
                        <tr>
                        ##                            开户行
                            <td nowrap>#springMessage('table.accountDTO.bankName')</td>
                            <td colspan=5 nowrap></td>
                        ##                            省份
                            <td nowrap>#springMessage('table.fcAccbookExt.prov')</td>
                            <td colspan=3 nowrap></td>
                        ##                            城市
                            <td nowrap>#springMessage('table.fcAccbookExt.city')</td>
                            <td nowrap></td>
                        </tr>
                    </table>
                </div>
            #end
        #end
    </div>
</div>
#end
    #parse("views/common/footer.vm")
<script>
    bt.use(['jquery', 'element', 'datatable', 'btdate', 'corp', 'date', 'dateType'], function () {
        $ = bt.jquery;
        form = bt.form();
        var corp = bt.corp.init();
        dateType = bt.dateType.init();
        //这里填写新的js代码，请参考前端文档
    });
</script>
</body>
</html>

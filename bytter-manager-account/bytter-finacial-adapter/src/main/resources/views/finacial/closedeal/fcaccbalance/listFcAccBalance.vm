<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<input type="hidden"  id="corpId" name="eqs_corpId">
	<table class="layui-table">
		<tbody>
			<tr>
				<!-- 单位网点 -->
				<td class="textRight">#springMessage("table.fcCheckInit.netId")</td>
				<td width="40%">
					<div class="layui-input-inline">
						<div class="bt-biz-corp"  data-id="netId" data-type="selectTree" data-name="eqs_netId"
								data-scope="net" data-resource="finacial:fcaccountbalance:query" data-callbackData="checkType" ></div>
					</div>
				</td>
				##余额日期
				<td class="textRight">#springMessage('table.fcAccBalance.balanceDate')</td>
				<td width="40%">
					<input type="text" name="ged_balanceDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="balanceDate">
    				<span class="date-mid">~</span>
    				<input type="text" name="led_balanceDate" class="layui-input bt-input-inline bt-biz-dateType" id="balanceDate">
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.fcAccBalance.curId')</td>
				<td width="40%">
					<div>
						<div class="bt-biz-selectType" data-biz-name="curId" data-url="${basePath}/basic/business/btcurrency/json"
								data-valuefield="id" data-textfield="curName" data-name="eqs_curId" data-search="true"></div>
					</div>
				</td>
				<td class="textRight">#springMessage('fcInstrate.subjectCode')</td>
				<td width="40%">
					<div class="bt-biz-selectType" data-biz-name="subjectid" data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSubjectDate" data-valuefield="id"
							data-textfield="subjectName" data-name="eqs_subjectId" data-search="true"></div>
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.fcBankBill.account')</td>
				<td width="40%">
					<input type="text" name="eqs_account" class="layui-input bankAccInput" >
					<table id="accountTable" class="hide">
						<thead>
							<tr>
								<th>#springMessage("table.fcAcc.blnctrAcc")</th>
		    				   	<th>#springMessage("table.fcCheckInit.bankAccName")</th>
							</tr>
						</thead>
					</table>
				</td>
				<td></td>
				<td></td>
			</tr>
			<tr>
				<td colspan="4" style="text-align: center;">
					<button class="layui-btn" lay-submit lay-filter="search"type="button">#springMessage('common.button.search')</button>
					<!-- <button class="layui-btn" lay-submit lay-filter="excel" >#springMessage('common.button.exports')</button> -->
					<button type="reset"  class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
	    <tr>
	        <th>#springMessage('table.fcAccBalance.balanceDate')</th>
	        <th>#springMessage('table.fcAccBalance.account')</th>
	        <th>#springMessage('table.fcAccBalance.accName')</th>
	        <th>#springMessage('table.fcAccBalance.curId')</th>
	        <th>#springMessage('table.fcAccBalance.balanceWay')</th>
	        <th>#springMessage('table.fcAccBalance.yesterBalance')</th>
	        <th>#springMessage('table.fcAccBalance.debitMoney')</th>
	        <th>#springMessage('table.fcAccBalance.creditMoney')</th>
	        <th>#springMessage('table.fcAccBalance.balance')</th>
	        <th>#springMessage('table.fcAccBalance.subjectId')</th>
	    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/closedeal/fcAccBalance.list.js?_btv=${resourceVersion}"></script>
</html>

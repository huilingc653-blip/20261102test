<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcDayClosePage.id}">
		<input id="netId" name="netId" type="hidden" value="$!{monthClose.netCode}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##所属网点
				<td class="textRight">#springMessage('table.fcDayClose.netCode')</td>
				<td width="40%">
					<div class="layui-inline">
                	<div class="bt-biz-corp" data-name="netCode" data-biz-name="netCode" data-biz-type="net" data-type="selectTree" data-callback="getCloseDate" data-resource="fcl:close:common:apply" data-scope="net" data-required="true" data-defaultvalue="$!{monthClose.netCode}"></div>
					</div>
				</td>
        		##年月
				<td class="textRight">#springMessage('table.fcDayClose.monthCloseDate')</td>
				<td width="40%">
					<div class="layui-inline">
					<input type="text" id="closeYear" name="closeYear" class="layui-input" disabled="disabled" value="$!{monthClose.closeYear}">
					</div>
					<div class="layui-inline">#springMessage('table.fcDayClose.closeYear')</div>
					<div class="layui-inline">
					<input type="text" id="closeMonth" name="closeMonth" class="layui-input" disabled="disabled" value="$!{monthClose.closeMonth}">
					</div>
					<div class="layui-inline">#springMessage('table.fcDayClose.closeMonth')</div>
				</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.finacial.reMonthClose')</button>
					<button type="button" class="layui-btn layui-btn-primary" onClick="resetCode()">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/closedeal/dayclose/fcMonthClose.restore.js?_btv=${resourceVersion}"></script>
</html>
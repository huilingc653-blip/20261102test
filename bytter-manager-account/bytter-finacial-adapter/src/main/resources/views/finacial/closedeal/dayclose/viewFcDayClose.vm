<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
						<div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.fcDayClose.lastCloseDate')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!date.format('yyyy-MM-dd',$!{fcDayClosePage.lastCloseDate})
                    </label>
                </div>
            </div>
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.fcDayClose.netCode')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!{fcDayClosePage.netCode}
                    </label>
                </div>
            </div>
				</div>
				<div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">#springMessage('table.fcDayClose.closeDate')</label>
        		<div class="layui-input-inline">
                    <label class="layui-form-label">
					$!date.format('yyyy-MM-dd',$!{fcDayClosePage.closeDate})
                    </label>
                </div>
            </div>
				</div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
        ##所属网点
            <td class="textRight">#springMessage('table.fcCarry.netId')</td>
            <td width="40%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-name="netId" data-biz-type="net"  data-scope="net" data-type="selectTree"  data-resource="finacial:fccarry:dayreport:query"></div>
                </div>
            </td>
        ##结转日期
            <td class="textRight">#springMessage('table.fcCarry.carryTime')</td>
            <td width="40%">
                <input type="text" name="opDate" data-today="true" class="layui-input bt-biz-dateType">
            </td>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcCarry.netId')</th>
        <th>#springMessage('table.fcCarry.OpDate')</th>
        <th>#springMessage('table.fcCarry.status')</th>
        <th>#springMessage('table.fcCarry.carryTime')</th>
        <th>#springMessage('table.fcCarry.operatorCode')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form','datatable','btdate','corp','date','dateType'], function(){
        $ = bt.jquery,form = bt.form();
        bt.corp.init();
        dateType = bt.dateType.init();
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath+"/finacial/closedeal/fccarry/datatable"
            },
            columns: [
                {data:"netName",bSortable:false},
                {data:"opDate",bSortable:false,
                    render: function ( data, type, full, meta ) {
                        return bt.date.format(full.opDate,'yyyy-mm-dd');
                    }
                },
                {data:"status",bSortable:false},
                {data:"carryTime",bSortable:false},
                {data:"operatorCode",bSortable:false},
            ]
        });
        //时间
        $.each($("div[type='date']"),function(i,item){
            bt.btdate.init({
                elem: "[field='"+$(item).attr("field")+"']",
                name: $(item).attr("field"),
                start: $(item).attr("defaultVal"),
                format: "YYYY-MM-DD",
                istime: false
            });
        });
        $.each($("div[type='datetime']"),function(i,item){
            bt.btdate.init({
                elem: "[field='"+$(item).attr("field")+"']",
                name: $(item).attr("field"),
                start: $(item).attr("defaultVal"),
                format: "YYYY-MM-DD hh:mm:ss",
                istime: true
            });
        });
    });

</script>
</html>

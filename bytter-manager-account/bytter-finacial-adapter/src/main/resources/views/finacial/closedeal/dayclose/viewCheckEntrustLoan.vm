<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
<input type="hidden"  id="netCode" name="netCode" value="$!{fcDayClose.netCode}">
<input type="hidden"  id="closeDate" name="closeDate" value="$!{fcDayClose.closeDateStr}">
<input type="hidden"  id="lastCloseDate" name="lastCloseDate" value="$!{fcDayClose.lastCloseDateStr}">
<input type="hidden"  id="checkType" name="checkType" value="$!{checkType}">
<input type="hidden"  id="method" name="method" value="view$!{checkType}">
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.cmsPrecativeLoanSend.loanAcc')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.precativeId')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.loanOpp')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.contractCode')</th>
        <th>#springMessage('table.cmsPrecativeLoanSend.money')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.startDate')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.endDate')</th>
        <th>#springMessage('table.cmsPrecativeLoanInfo.curId')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/closedeal/dayclose/view$!{checkType}.js?_btv=${resourceVersion}"></script>
</html>

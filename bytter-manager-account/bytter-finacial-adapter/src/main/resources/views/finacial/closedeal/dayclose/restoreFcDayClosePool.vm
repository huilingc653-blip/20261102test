<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>

<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcDayClosePage.id}">
		<input id="netId" name="netId" type="hidden" value="$!{dayClose.netCode}">
		<input id="poolSign" name="poolSign" type="hidden" value="1">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##所属资金池
				<td class="textRight">#springMessage('nis.pool.fcCorpPool.pool')</td>
				<td width="40%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-url="" data-name="netCode" data-biz-name="netCode" data-callback="getCloseDate"
                             data-defaultvalue="$!{dayClose.netCode}" data-valuefield="id" data-textfield="showName" data-required="required" ></div>
                    </div>
				</td>
        		##上次日结日期
				<td class="textRight">#springMessage('table.fcDayClose.lastCloseDate')</td>
				<td width="40%">
					<input type="text" id="lastCloseDate" name="lastCloseDate" class="layui-input" disabled="disabled" value="$!{dayClose.lastCloseDate}">
				</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.finacial.redayClose')</button>
					<button type="button" class="layui-btn layui-btn-primary" onClick="resetCode()">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/closedeal/dayclose/fcDayClosePool.restore.js?_btv=${resourceVersion}"></script>
</html>
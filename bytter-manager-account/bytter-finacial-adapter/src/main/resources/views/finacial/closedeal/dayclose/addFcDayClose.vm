<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcDayClosePage.id}">
		<input id="netId" name="netId" type="hidden" value="$!{dayClose.netCode}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##所属网点
				<td class="textRight">#springMessage('table.fcDayClose.netCode')</td>
				<td width="40%">
					<div class="layui-inline">
                		<div class="bt-biz-corp" data-name="netCode" data-biz-name="netCode" data-biz-type="net" data-type="selectTree" data-callback="getCloseDate" data-required="true" data-resource="fcl:close:common:apply" data-scope="net" data-defaultvalue="$!{dayClose.netCode}"></div>
					</div>
				</td>
        		##上次日结日期
				<td class="textRight">#springMessage('table.fcDayClose.lastCloseDate')</td>
				<td width="40%">
					<input type="text" id="lastCloseDate" name="lastCloseDate" disabled="disabled" class="layui-input" value="$!{dayClose.lastCloseDate}">
				</td>
			</tr>
        	<tr>
        		##日结天数
				<td class="textRight">#springMessage('table.fcDayClose.closeDay')</td>
				<td >
                	<input type="text" id="closeDay" name="closeDay" class="layui-input bt-money" lay-verify="required" value="1" data-min="1" data-type="int" minus="false"></div>
				</td>
        		##日结日期
				<td class="textRight">#springMessage('table.fcDayClose.closeDate')</td>
				<td >
                	<input type="text" data-biz-name="closeDate" data-name="closeDate" name="closeDate" lay-verify="required" class="layui-input bt-biz-dateType" data-type="date" data-callback="setCloseDay" value="$!date.format('yyyy-MM-dd',$!dayClose.closeDate)"></div>
				</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.finacial.dayClose')</button>
					<button type="button" class="layui-btn layui-btn-primary" onClick="resetCode()">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
        <table class="layui-table hide" id="closeTable">
	    	<tr>
	           	<td colspan="2" style="text-align: center;" class="successHide">#springMessage('table.fcDayClose.closeFail')</td>
	           	<td colspan="2" style="text-align: center;">#springMessage('table.fcDayClose.closeRemind')</td>
	        </tr>
	        <tr>
	            <td width="50%" colspan="2" style="vertical-align:top" class="successHide">
	            <div style='width:100%;height:370px;overflow:auto;'>
	                <table id="checkTable" style='width:100%;margin: 0px'>
	                    <thead>
	                        <tr>
	                            <th>#springMessage('table.fcDayClose.modelName')</th>
	                            <th>#springMessage('table.fcDayClose.remindMsg')</th>
                            	<th>#springMessage('common.table.thead.operation')</th>
	                        </tr>
	                    </thead>
	                </table>
	                </div>
	            </td>
	            <td width="50%" colspan="2" style="vertical-align:top">
	            <div style='width:100%;height:370px;overflow:auto;'>
	                <table  id="unCheckTable" style='width:100%;margin: 0px'>
	                    <thead>
	                        <tr>
	                            <th>#springMessage('table.fcDayClose.modelName')</th>
	                            <th>#springMessage('table.fcDayClose.remindMsg')</th>
                            	<th>#springMessage('common.table.thead.operation')</th>
	                        </tr>
	                    </thead>
	                </table>
	                </div>
	            </td>
	        </tr>
	    </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/closedeal/dayclose/fcDayClose.add.js?_btv=${resourceVersion}"></script>
</html>
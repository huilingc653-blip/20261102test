<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
<input type="hidden"  id="netCode" name="netCode" value="$!{fcDayClose.netCode}">
<input type="hidden"  id="closeDate" name="closeDate" value="$!{fcDayClose.closeDateStr}">
<input type="hidden"  id="lastCloseDate" name="lastCloseDate" value="$!{fcDayClose.lastCloseDateStr}">
<input type="hidden"  id="checkType" name="checkType" value="$!{checkType}">
<input type="hidden"  id="method" name="method" value="view$!{checkType}">
<input type="hidden"  id="poolSign" name="poolSign" value="$!{fcDayClose.poolSign}">
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcAccbook.busOriType')</th>
        <th>#springMessage('table.fcAccbook.busRaceId')</th>
        <th>#springMessage('table.fcAccbook.voucherType')</th>
        <th>#springMessage('table.fcAccbook.tallyDate')</th>
        <th>#springMessage('table.fcAccbook.interestStartDate')</th>
        <th>#springMessage('table.fcAccbook.orderNo')</th>
        <th>#springMessage('table.fcAccbookDtl.account')</th>
        <th>#springMessage('table.fcAccbookDtl.debitMoney')</th>
        <th>#springMessage('table.fcAccbookDtl.creditMoney')</th>
        <th>#springMessage('table.fcAccbook.voucherState')</th>
        <th>#springMessage('table.fcAccbook.operatorCode')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/closedeal/dayclose/view$!{checkType}.js?_btv=${resourceVersion}"></script>
</html>

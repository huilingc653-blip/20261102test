<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <input type="hidden" name="eqd_startDate" id="startDate" value="$!{param.startDate}">
        <input type="hidden" id="eqs_netId_id" value="$!{param.netCode}">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##所属网点
                    <td class="textRight">#springMessage('table.fcCarry.netId')</td>
                    <td width="40%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp" data-id = "eqs_netId" data-name="eqs_netId" data-biz-name="netId"
                                 data-biz-type="net"  data-scope="net" data-type="selectTree"
                                 data-defaultvalue="$!{param.netCode}" data-resource="fcl:close:fccarry:apply" lay-verify="required"
                                 data-callback="bt.corpCallback" ></div>
                        </div>
                    </td>
                    ##日期
                    <td class="textRight">#springMessage('table.fcCarry.carryTime')</td>
                    <td width="40%">
						<input type="text" name="eqd_opDate" data-today="true" data-biz-name="eqd_opDate" class="layui-input bt-biz-dateType" value="$!{param.opDate}" lay-verify="required">
						<span id="startDateInfo">
							#if(${param.startDateFlag} == '1')
						    	#springMessage('finacial.closedeal.fccarry.profitYearInfo')：${param.startDate}
							#end
				    	</span>
                    </td>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button class="layui-btn" lay-submit="" type="button" onclick="viewProfitYear('C')">#springMessage('common.button.viewClose')</button>
                        <button class="layui-btn" lay-submit="" type="button" onclick="doProfitYear()">#springMessage('Finacial.accbook.common.button.add')</button>
                        <button class="layui-btn" lay-submit="" type="button" onclick="viewProfitYear('F')">#springMessage('common.button.viewBack')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('fcAccBalanceQuery.account')</th>
        <th>#springMessage('fcAccBalanceQuery.accName')</th>
        <th>#springMessage('fcAccBalanceQuery.curId')</th>
        <th>#springMessage('table.fcInitAcc.yearTotal')</th>
        <th>#springMessage('table.fcAccBalance.balanceWay')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/finacial/closedeal/fccarry/profitYear.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##所属网点
                    <td class="textRight">#springMessage('table.fcCarry.netId')</td>
                    <td width="40%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp" data-name="eqs_netId" data-biz-type="net" data-scope="net" data-type="selectTree" data-resource="finacial:fccarry:log:query"></div>
                        </div>
                    </td>
                    ##日期
                    <td class="textRight">#springMessage('table.fcDayClose.closeDate')</td>
                    <td width="40%">
                        <div class="layui-inline">
                             <div class="date-interval"></div>
                        </div>
                    </td>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcCarry.netId')</th>
        <th>#springMessage('table.fcCarry.operatorCode')</th>
        <th>#springMessage('table.fcCarry.carryTime')</th>
        <th>#springMessage('table.day.report.startDate')</th>
        <th>#springMessage('table.day.report.endDate')</th>
        <th>#springMessage('table.fcCarry.restoreCarryTime')</th>
        <th>#springMessage('table.fcCarry.restoreCarryOptor')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','datatable','btdate','corp','date'], function(){
    $ = bt.jquery,form = bt.form();
    bt.corp.init();
    var dd = bt.btdate.init({
        elem:".date-interval",
        startname:"ged_voucherStartDate",
        endname:"led_voucherEndDate"
        }
    );
    //生成列表
    datatable = bt.datatable.init({
        elem: "#appTable",
        colReorder: true,
        checkbox:true,
        searchForm: {
            formElem: "#searchForm",
            formFilter: "search"
        },
        ajax: {
            'url': basePath+"/finacial/closedeal/fccarry/LogDatatable"
        }
        ,columns: [
            {data:"netName",bSortable:true},
            {data:"operatorCode",bSortable:true},
            {data:"carryTime",bSortable:true},
            {data:"voucherStartDate",bSortable:true},
            {data:"voucherEndDate",bSortable:true},
            {data:"restoreCarryTime",bSortable:true},
            {data:"restoreCarryOptor",bSortable:true}
        ]
    });
    //时间
    $.each($("div[type='date']"),function(i,item){
        bt.btdate.init({
            elem: "[field='"+$(item).attr("field")+"']",
            name: $(item).attr("field"),
            start: $(item).attr("defaultVal"),
            format: "YYYY-MM-DD",
            istime: false
        });
    });
    $.each($("div[type='datetime']"),function(i,item){
        bt.btdate.init({
            elem: "[field='"+$(item).attr("field")+"']",
            name: $(item).attr("field"),
            start: $(item).attr("defaultVal"),
            format: "YYYY-MM-DD hh:mm:ss",
            istime: true
        });
    });
});

</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
						<input id="id" name="id" type="hidden" value="$!{fcChargeRulePage.id}">
		<table class="layui-table">
			<tr>
			##业务种类
				<td class="textRight">#springMessage('table.fcChargeRule.raceCode')</td>
				<td>
		         	<div class="layui-input-inline">              
		                <div class=bt-biz-selectType data-name="raceCode" data-biz-name="raceCode"  data-required="true"
		                		data-search="true" data-textField="sysRaceName" data-valueField="sysRaceCode" data-url="${basePath}/paramconfig/fcbusinessruledefine/json" >
		                </div>
	              	</div>
				</td>
			##凭证种类代码
				<td class="textRight">#springMessage('table.fcChargeRule.voucherType')</td>
				<td>
					<div class="bt-biz-selectType" data-url="${basePath}/paramconfig/fcchargerule/json" data-valuefield="id" data-textfield="voucherName" data-name="voucherType"  data-search="true" data-defaultvalue="" data-required="true"></div>
					</td>
			</tr>
			<tr>
			##收费借方科目
			<td class="textRight">#springMessage('table.fcChargeRule.debitSubjCode')</td>
			<td>
				<div class="bt-biz-selectType" data-url="${basePath}/paramconfig/fcbusinessruledefine/jsonSubject" data-valuefield="id" data-textfield="subjectName" data-name="debitSubjCode"  data-search="true" data-defaultvalue="" data-required="true"></div>
			</td>
			##收费贷方科目
			<td class="textRight">#springMessage('table.fcChargeRule.creditSubjCode')</td>
			<td>
				<div class="bt-biz-selectType" data-url="${basePath}/paramconfig/fcbusinessruledefine/jsonSubject" data-valuefield="id" data-textfield="subjectName" data-name="creditSubjCode"  data-search="true" data-defaultvalue="" data-required="true"></div>
			</td>
			</tr>
			<tr>
			##摘要
				<td class="textRight">#springMessage('table.fcChargeRule.summary')</td>
				<td>
					<div class="bt-biz-selectType" data-url="${basePath}/finacial/paramconfig/btsummary/json" data-valuefield="summaryContent" data-textfield="summaryContent" data-name="summary" data-inputvalue ="inputvalue"  data-search="true" data-defaultvalue=""></div>
				</td>
			##所属网点
				<td class="textRight">#springMessage('table.fcChargeRule.netId')</td>
				<td>
					<div class="bt-biz-corp" data-name="netId" data-biz-name="netId" data-biz-type="net" data-type="select" data-defaultvalue="$!{initNetId}" data-callback="changeNet" data-required="true"></div>
					<input type="hidden" id="initNetId" value="$!{initNetId}">
				</td>
			</tr>
			##币别
			<tr>
				<td class="textRight">#springMessage('table.fcChargeType.curCode')</td>
				<td colspan="3">
					<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-textfield="curName" data-name="curCode" data-defaultvalue=""></div>
				</td>
			</tr>
			<tr>
			##费用类型
				<td class="textRight" id="chargeMsg"><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fcChargeRule.fcChargeType')</td>
				<td colspan="3">
				<input type="checkbox" lay-skin="primary" title="#springMessage('common.check.all')"  lay-filter="allChoose"/>
	                #foreach($type in $chargeType)
	                	#set($num = $!{velocityCount} - 1) 
	                	<input type="checkbox" name="chargeTypeId" lay-skin="primary" value="${type.id}" title="${type.chargeTypeName}"/>
	                #end
				</td>
			</tr>
		</table>
				<hr>
				<table id="dataTable" class="layui-table">
				<colgroup>
			      <col width="20%">
			      <col width="10%">
			      <col width="25%">
			      <col width="25%">
			      <col width="20%">
			    </colgroup>
					<thead>
						<tr>
							<td><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fcVoucherEntryDefine.summary')</td>
							<td>#springMessage('table.fcVoucherEntryDefine.balanceWay')</td>
							<td>#springMessage('table.fcVoucherEntryDefine.subjectCode')</td>
							<td>#springMessage('table.fcVoucherEntryDefine.account')</td>
							<td>#springMessage('table.fcVoucherEntryDefine.voucherType')</td>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>
						      	<div class="bt-biz-selectType" data-url="${basePath}/finacial/paramconfig/btsummary/json" data-valuefield="summaryContent" data-textfield="summaryContent" data-name="fcVoucherEntryDefines[0].summary"  data-inputvalue ="inputvalue" data-width="200px"  data-search="true" data-defaultvalue="first" data-required="true"></div>
							</td>
							<td><input type="hidden"  name="fcVoucherEntryDefines[0].balanceWay" value="1">#springMessage('table.fcVoucherEntryDefine.debit')</td>
							<td>
						      	<div class="bt-biz-selectType" data-url="${basePath}/paramconfig/fcbusinessruledefine/jsonSubject" data-valuefield="id" data-textfield="subjectName" data-name="fcVoucherEntryDefines[0].subjectCode" data-biz-name="subjectCode0"  data-width="200px" data-search="true" data-callback="changesubjectCode0"></div>
							</td>
							<td>
						      	<div class="bt-biz-selectType" data-url="${basePath}/paramconfig/fcchargerule/getChargeAcc" data-valuefield="blnctrAcc" data-textfield="blnctrAcc" data-name="fcVoucherEntryDefines[0].account" data-biz-name="account0" data-width="200px"  data-search="true" data-defaultvalue="first"></div>
							</td>
							<td>
						      	<div class="bt-biz-selectType" data-url="${basePath}/paramconfig/fcchargerule/json" data-valuefield="id" data-textfield="voucherName" data-name="fcVoucherEntryDefines[0].voucherType"  data-search="true" data-defaultvalue="first"></div>
							</td>
						</tr>
						<tr>
							<td>
						        <div class="bt-biz-selectType" data-url="${basePath}/finacial/paramconfig/btsummary/json" data-valuefield="summaryContent" data-textfield="summaryContent" data-name="fcVoucherEntryDefines[1].summary" data-inputvalue ="inputvalue" data-width="200px"  data-search="true" data-defaultvalue="first" data-required="true"></div>
							</td>
							<td><input type="hidden"  name="fcVoucherEntryDefines[1].balanceWay" value="-1">#springMessage('table.fcVoucherEntryDefine.credit')</td>
							<td>
								<div class="bt-biz-selectType" data-url="${basePath}/paramconfig/fcbusinessruledefine/jsonSubject" data-valuefield="id" data-textfield="subjectName" data-name="fcVoucherEntryDefines[1].subjectCode" data-biz-name="subjectCode1" data-width="200px"  data-search="true" data-callback="changesubjectCode1"></div>
							</td>
							<td>
						      	<div class="bt-biz-selectType" data-url="${basePath}/paramconfig/fcchargerule/getChargeAcc" data-valuefield="blnctrAcc" data-textfield="blnctrAcc" data-name="fcVoucherEntryDefines[1].account" data-biz-name="account1" data-width="200px"  data-search="true" data-defaultvalue="first"></div>
							</td>
							<td>
						      	<div class="bt-biz-selectType" data-url="${basePath}/paramconfig/fcchargerule/json" data-valuefield="id" data-textfield="voucherName" data-name="fcVoucherEntryDefines[1].voucherType"  data-search="true" data-defaultvalue="first"></div>
							</td>
						</tr>
						<tr>
							<td colspan="5" align="center">
								<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage("common.button.submit")</button>
	                    		<button type="button" class="layui-btn layui-btn-primary" onClick="doReset()">#springMessage('common.button.reset')</button>
	                    		<button class="layui-btn"  onClick="doClose()">#springMessage('common.button.close')</button>
							</td>
						</tr>
					</tbody>
				</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','layedit','moneynum','btdate','selectType','corp'], function(){
		var $ = bt.jquery,form = bt.form();
		
		changesubjectCode0 = function(data,ele){
			changeChargeAcc($("#initNetId").val(),data.id,'account0');
		}
		changesubjectCode1 = function(data,ele){
			changeChargeAcc($("#initNetId").val(),data.id,'account1');
		}
		changeNet = function(data,ele){
			changeChargeAcc(data.value,selectType.get("subjectCode0").val(),'account0');
			changeChargeAcc(data.value,selectType.get("subjectCode1").val(),'account1');
			$("#initNetId").val(data.value);
		}
		
		var corp = bt.corp.init();
		var selectType = bt.selectType.init();
		
		//格式化数字
		$.each($("input[decimal]"),function(i,item){
			if($(item).attr("decimal")!=""){
				bt.moneynum.setnum({trigger:$(item),decimal:$(item).attr('decimal')*1});
			}
		});
		//时间
		$.each($("div[type='date']"),function(i,item){
			bt.btdate.init({
				elem: "[field='"+$(item).attr("field")+"']",
				name: $(item).attr("field"),
                start: $(item).attr("defaultVal"),
                format: "YYYY-MM-DD",
				istime: false
			});
		});
		$.each($("div[type='datetime']"),function(i,item){
			bt.btdate.init({
				elem: "[field='"+$(item).attr("field")+"']",
				name: $(item).attr("field"),
                start: $(item).attr("defaultVal"),
				format: "YYYY-MM-DD hh:mm:ss",
				istime: true
			});
		});
		
		//重新加载手续费账号
		changeChargeAcc = function (netId,subcode,item){
			selectType.get(item).attr("data-url",basePath+"/paramconfig/fcchargerule/getChargeAcc?subCode="+subcode+"&netId="+netId);
			selectType.get(item).render();
		}
		
		
		//监听提交
        form.on('submit(submit)', function(data){
        	
        	var chargeTypeIds = [];
        	$('form').find('input[name="chargeTypeId"]:checked').each(function(){
        		chargeTypeIds.push($(this).val());
            });
        	if(chargeTypeIds.length<1){
        		layer.tips(bt.lang('finacial.fcchargerule.chargeTypeIdIsNull'), '#chargeMsg');
        		return false;
        	}
            if(chargeTypeIds){
            	data.field.chargeTypeIds = chargeTypeIds;
            }
        	
            var action = "/paramconfig/fcchargerule/save";
            $.post(basePath + action,data.field,function(result){
                if(result.success){
                	if(!bt.navtab){
                        parent.layer?parent.layer.closeAll():layer.closeAll();
                    } else {
                    	bt.navtab.refreshParent();
                    	bt.navtab.closeCurrent();
                    }
                }
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            },'JSON');
            return false;
        });
		
     	 //全选
        form.on('checkbox(allChoose)', function(data){
            var child = $('input[name="chargeTypeId"]');
            child.each(function(index, item){
                item.checked = data.elem.checked;
            });
            form.render('checkbox');
        });
     	 
      	//重置
        doReset = function(){
        	bt.navtab.refreshCurrent();
        }
      
      	//关闭窗口
        doClose = function(){
        	if(bt.navtab){
    			bt.navtab.closeCurrent();
    		}
        }
      
	});
</script>
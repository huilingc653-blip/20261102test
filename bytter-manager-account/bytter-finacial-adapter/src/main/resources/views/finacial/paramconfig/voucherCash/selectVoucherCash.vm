<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="20%">#springMessage("借方科目")</td>
            <td width="30%">
                <input type="text" name="likes_debitSubName" autocomplete="off" class="layui-input">
            </td>
            <td class="textRight" width="20%">#springMessage("贷方科目")</td>
            <td width="30%">
                <input type="text" name="likes_creditSubName" autocomplete="off" class="layui-input">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.eExchangeBill.debit')</th>#*借方科目*#
        <th>#springMessage('finacial.paramconfig.debit.subjectName')</th>#*借方科目名称*#
        <th>#springMessage('table.eExchangeBill.credit')</th>#*贷方科目*#
        <th>#springMessage('finacial.paramconfig.credit.subjectName')</th>#*贷方科目名称*#
        <th>#springMessage('finacial.paramconfig.debit.CashFlow.Item')</th>#*借方现金流项目*#
        <th>#springMessage('finacial.paramconfig.credit.CashFlow.Item')</th>#*贷方现金流项目*#
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    var dataTable;
    bt.use(['form','datatable','corp'], function(){
        $ = bt.jquery,form = bt.form();
        bt.corp.init();
        //生成列表
        dataTable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            checkbox:true,
            mulselect: false,
            ignoreButtons: ["colvis", "output", "print"],
            ajax: {
                'url': basePath + "/finacial/paramconfig/voucherCash/datatable"
            }, searchForm: {
                formFilter: "search",
                formElem: "#searchForm"
            },
            columns: [
                {data: "debitSubCode", className: 'center'},
                {data: "debitSubName", className: 'center'},
                {data: "creditSubCode", className: 'center'},
                {data: "creditSubName", className: 'center'},
                {data: "debitItemName", className: 'center'},
                {data: "creditItemName", className: 'center'}
            ]
        });
    });

    /**
     * 返回选中数据
     * @returns {[]|null}
     */
    function getSelectData() {
        return bt.datatable.getSelectData("#appTable");
    }

</script>
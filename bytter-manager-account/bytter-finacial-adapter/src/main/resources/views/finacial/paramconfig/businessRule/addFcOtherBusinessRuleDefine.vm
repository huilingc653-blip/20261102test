<script>
	var dicts;
    bt.use(['form', 'layedit', 'selectTree', 'select', 'btdate', 'corp', 'moneyType', 'selectType', 'dicts', 'selectTable'], function () {
        var $ = bt.jquery, form = bt.form();
        bt.corp.init();
        bt.selectType.init();

        bt.moneyType.init({elem: $('[data-type="int"]'), decimal: 0, minus: true});


        //监听提交
        form.on('submit(submit)', function (data) {
            var action = "/paramconfig/fcotherbusinessruledefine/save";
            bt.loading.show();
            $.post(basePath + action, $('#fcOtherBusinessRuleForm').serialize(), function (result) {
                bt.loading.hide();
                parent.layer ? parent.layer.alert(result.msg, {icon: result.success ? 1 : 2}) : layer.alert(result.msg, {icon: result.success ? 1 : 2});
                if (result.success) {
                    $.each($(".layui-form"), function () {
                        this.reset();
                    });
                    if (!bt.navtab) {
                        parent.layer ? parent.layer.closeAll() : layer.closeAll();
                    } else {
                        bt.navtab.closeCurrent();
                    }
                }
            }, 'JSON');
            return false;
        });
        dicts = bt.dicts.init();
        form.on('select', function (data) {
            var row = data.othis.closest("tr").attr('row');
            if(data.value == 1 || data.value == 2){
                if($("#matchContent"+ row).is(":hidden")) {
                    $("#matchContent" + row).val(data.value);
                }
            }
        });
        //第一行初始化账号
        initSelectAccount(0);
    });

    function addTr1() {
        var form = bt.form();
        var tab = document.getElementById("dataTable");
        var rowsCount = tab.rows.length;
        var index = rowsCount - 1;
        var html = '<tr row="' + index + '">';
        html += '<td><input type="text" data-name="vouchers[' + index + '].groupNums" name="vouchers[' + index + '].groupNum" selectAttr="vouchers_' + index + '" data-type="int" minus="false" class="layui-input" maxlength="2" lay-verify="required"/></td>';
        html += '<td><div class="bt-biz-selectType" data-biz-name="vouchers[' + index + '].summary" data-search="true" data-inputvalue="true" data-url="${basePath}/finacial/paramconfig/btsummary/json" data-valuefield="summaryContent" data-textfield="summaryContent" data-name="vouchers[' + index + '].summary" data-defaultvalue="$!{table.fcVoucherEntryDefine.summary}"></div></td>';
        html += '<td><div class=bt-biz-dict data-type="select" data-biz-name="vouchers[' + index + '].balanceWay" data-name="vouchers[' + index + '].balanceWay"  data-group="Admin.BalanceWay" data-defaultvalue="1"></div></td> ';
        /* html+='<td><div class="bt-biz-selectType" data-biz-name="vouchers['+index+'].subjectCode" data-valuefield="id"  data-textfield="subjectName" data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSubjectDate" data-name="vouchers['+index+'].subjectCode" data-required="true"></div></td>'; */

        html += '<td><div class="bt-biz-selectType" data-biz-name="vouchers[' + index + '].subjectCode" data-valuefield="id" ' +
                ' data-textfield="subjectName" data-url="${basePath}/paramconfig/fcbusinessruledefine/jsonSubject" data-name="vouchers[' + index + '].subjectCode" '+
                ' data-required="true" data-search="true" data-width="250px"></div></td>';

        html += '<td><div class="layui-inline"><input type="text" name="vouchers[' + index + '].blnctrAcc" id="blnctrAcc' + index + '" class="layui-input">';
        html += '<table id="example' + index + '" class="hide" >' +
                '<thead>' +
                '   <tr>' +
                '       <th>' + bt.lang("table.fcAccbookDtl.account") + '</th>' +
                '       <th>' + bt.lang("table.fcAccbookDtl.accName") + '</th>' +
                '       <th>' + bt.lang("table.fcAccbookDtl.subjectCode") + '</th>' +
                '   </tr>' +
                '</thead>' +
                '</table>';
        html += '</div></td>';

        /* html+='<td><div class="bt-biz-selectType" data-biz-name="vouchers['+index+'].voucherType" data-url="${basePath}/netbank/fcvouchertype/json" data-valuefield="id" data-textfield="voucherName" data-name="vouchers['+index+'].voucherType" data-required="true"></div></td>'; */
        html += '<td><div class=bt-biz-dict data-type="select" data-biz-name="vouchers[' + index + '].entryType" data-name="vouchers[' + index + '].entryType"  data-group="Finacial.EntryType" data-defaultvalue="10"></div></td>';
        html += '<td><a href="#" title="#springMessage(
            'common.delTr')" onClick="remoTr(this.parentElement.parentElement.rowIndex)"><i class="layui-icon">&#xe640;</i></a></td>';
        html += '</tr>';
        $("#dataTable>tbody").append(html);
        dicts.render();
        bt.selectType.init();
        form.render("select");
        var groupName = "vouchers_" + index;
        bt.use(['form', 'moneyType'], function () {
            var $ = bt.jquery, form = bt.form();
            $.each($('[selectAttr="' + groupName + '"]'), function (i, item) {
                bt.moneyType.init({elem: $(this), decimal: 0, minus: true});
            });
        });
        //初始化内部账户
        initSelectAccount(index);
    }

    //内部账号列表加载
    var initSelectAccount = function (row) {
        var cls = "";
        if (row != undefined) {
            cls = row
        }
        if ($("#example" + cls).length > 0) {
            bt.selectTable.init({
                elem: "#example" + cls,
                url: basePath + "/finacial/accbook/fcaccbook/getTallyAccs",
                scrollX: true,
                paging: true,
                scrollY: "200px",
                searchInput: "#blnctrAcc" + cls,
                columns: [
                    {data: "blnctrAcc",},
                    {data: "accName",},
                    {data: "subjectName",}
                ],
                clickCallback: function (data) {
                    //设置账户名称
                    $("#blnctrAcc" + cls).val(data.blnctrAcc);
                }
            });
        }
    }

    //为空判断
    function isEmpty(stringData) {
        if (null == stringData || stringData == "" || stringData == undefined || stringData == " ") {
            return true;
        } else {
            return false;
        }
    }

    //非空判断
    function isNotEmpty(stringData) {
        return !isEmpty(stringData)
    }

    function remoTr(rowIndex) {
        var tab = document.getElementById("dataTable");
        tab.deleteRow(rowIndex);
        console.log(rowIndex);
        //循环修改元素的名字
        for (var i = rowIndex; i < (tab.rows.length - 1); i++) {
            var tempTr = tab.rows.item(i);
            for (var x = 0; x < tempTr.cells.length; x++) {
                var tempTd = tempTr.cells.item(x);
                var strHTML = tempTd.innerHTML;
                console.log(strHTML);
                while (strHTML.indexOf("[" + (i - 1) + "]") > 0) {
                    strHTML = strHTML.replace("[" + (i - 1) + "]", "["
                            + (i - 2) + "]");
                }
                while (strHTML.indexOf("[" + (i) + "]") > 0) {
                    strHTML = strHTML.replace("[" + (i) + "]", "[" + (i - 1)
                            + "]");
                }
                tempTd.innerHTML = strHTML;
            }
        }
        return false;
    }

    /**
     * 增加一行
     */
    addTr2 = function () {
        var row = $("#matchContentTable tbody tr:last").attr('row');
        if (isNaN(row)) {
            row = 0;
        }
        var newRow = row + 1;
        var html = '<tr row="' + newRow + '">';
        html += '<td class="textCenter"><div class="bt-biz-dict" data-type="select" data-group="FUNDWARN_NUM_OPERATOR"  data-name="matchRule"></div></td>';
        html += '\t<td class="textCenter">\n' +
                '<div class="layui-input-inline">\n' +
                '<select name="leftParenthesis"   data-search="false" data-inputvalue="true">\n' +
                '<option value=" ">'+ bt.lang("common.placeholder.select")+'</option>\n' +
                '<option value="(">(</option>\n' +
                '</select>\n' +
                '</div>\n' +
                '</td>';
        html += '<td class="textCenter"><div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchElements"  data-name="matchElements" data-biz-name="matchElements' + newRow + '" data-callback="onchangeMatchElements"></div></td>';
        html += '<td class="textCenter"><div class="bt-biz-dict" data-type="select" data-group="nisBusTypeRule.matchRelations"  data-name="matchRelations" data-biz-name="matchRelations' + newRow + '" data-filterData="5,6,7,8" data-callback="onchangeMatchRelations"></div></td>';
        html += '<td class="textCenter"><input type="text" name="matchContent"  id="matchContent' + newRow + '" placeholder="'+bt.lang('table.netbank.nisproject.matchContent')+'" autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="100">' +
                '<div class="layui-input-inline" id="number' + newRow + '" style="display: none;">\n' +
                '<select  lay-search="" data-inputvalue="true" >\n' +
                '<option value="1">'+ bt.lang("table.number.odd") +'</option>\n' +
                '<option value="2">'+ bt.lang("table.number.even") +'</option>\n' +
                '</select>\n' +
                '</div></td>';
        html += '<td class="textCenter">\n' +
                '<div class="layui-input-inline">\n' +
                '<select name="rightParenthesis"  data-search="false" data-inputvalue="true">\n' +
                '<option value=" ">'+ bt.lang("common.placeholder.select")+'</option>\n' +
                '<option value=")">)</option>\n' +
                '</select>\n' +
                '</div>\n' +
                '</td>';
        html += '<td class="textCenter"><a href="javascript:void (0)" onclick="deleteDtl(this)">' + bt.lang("common.button.delete") + '</a></td>';
        html += '</tr>';
        $("#matchContentTable").find('tbody').append(html);
        dicts.render();
    }
    /**
     * 删除
     * @param _this
     */
    deleteDtl = function (_this) {
        $(_this).parents("tr").not("#matchContentTr").remove();
    }
    onchangeMatchElements = function (data) {
        var row = data.othis.closest("tr").attr('row');
        var val = data.value;
        if(val == "amt"){
            $("#matchContent"+row).hide();
            $("#number"+row).show();
            $("#matchContent"+row).val("1");
            dicts.get('matchRelations'+row).attr({'data-filterData': ''});
            dicts.get('matchRelations'+row).val("3");
        }else{
            $("#matchContent"+row).show();
            $("#number"+row).hide();
            $("#matchContent"+row).val("");
            dicts.get('matchRelations'+row).attr({'data-filterData': '5,6,7,8'});
            dicts.get('matchRelations'+row).val("");
        }
    }
    onchangeMatchRelations = function (data) {
        var row = data.othis.closest("tr").attr('row');
        var val = data.value;
        var matchElements = dicts.get('matchElements'+row).val();
        if(matchElements == "amt" && (val == "1" || val == "2" || val == "3" || val == "4")){
            $("#matchContent"+row).hide();
            $("#number"+row).show();
            $("#matchContent"+row).val("1");
        } else {
            $("#matchContent"+row).show();
            $("#number"+row).hide();
            $("#matchContent"+row).val("");
        }
    }
</script>

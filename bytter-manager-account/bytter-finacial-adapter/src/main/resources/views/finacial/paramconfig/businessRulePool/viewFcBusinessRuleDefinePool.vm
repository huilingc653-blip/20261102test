<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tr>
				<td class="textRight">#springMessage('finacial.paramconfig.fcbusracepool.poolId'):</td>
				<td>
					$!{fcBusinessRuleDefinePage.poolId}
				</td>
				<td class="textRight">#springMessage('table.fcBusinessRuleDefine.sysRaceName'):</td>
				<td>
					$!{fcBusinessRuleDefinePage.sysRaceCode}
				</td>
            </tr>
            <tr>
            	<td class="textRight">#springMessage('table.fcBusinessRuleDefine.subjCode'):</td>
            	<td>
					$!{fcBusinessRuleDefinePage.subjectId}
            	</td>
            	<td class="textRight">#springMessage('table.fcBusinessRuleDefine.curCode'):</td>
            	<td>
					$i18nTag.getBusinessBaseContext($!{fcBusinessRuleDefinePage.curId})
            	</td>
            </tr>
            <tr>
            	<td class="textRight">#springMessage('table.fcBusinessRuleDefine.voucherType')</td>
				<td>
					$i18nTag.getBusinessBaseContext($!{fcBusinessRuleDefinePage.voucherType})
        		</td>
            	<td class="textRight">#springMessage('table.fcBusinessRuleDefine.validSign'):</td>
            	<td>
            		$dictTag.get('sf_yn',$!{fcBusinessRuleDefinePage.validSign})
            	</td>
            </tr>
		</table>
		<table id="dataTable" class="layui-table">
			<thead>
				<tr>
					<th>#springMessage('table.fcVoucherEntryDefine.groupNum')</th>
					<th>#springMessage('table.fcVoucherEntryDefine.summary')</th>
					<th>#springMessage('table.fcVoucherEntryDefine.balanceWay')</th>
					<th>#springMessage('table.fcVoucherEntryDefine.subjectCode')</th>
					<!-- <th>#springMessage('table.fcVoucherEntryDefine.voucherType')</th> -->
					<th>#springMessage('table.fcVoucherEntryDefine.entryType')</th>
				</tr>
			</thead>
			<tbody>
				#foreach($entryDefine in $!{fcBusinessRuleDefinePage.vouchers})
					#set($vcount = $velocityCount - 1)
				<tr>
					<td>$!{entryDefine.groupNum}</td>
					<td>$!{entryDefine.summary}</td>
					<td>$dictTag.get('Admin.BalanceWay',$!{entryDefine.balanceWay})</td>
					<td>$!{entryDefine.subjectName}</td>
					<td>$dictTag.get('Finacial.EntryType',$!{entryDefine.entryType})</td>##
				</tr>
				#end
			</tbody>
		</table>				
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
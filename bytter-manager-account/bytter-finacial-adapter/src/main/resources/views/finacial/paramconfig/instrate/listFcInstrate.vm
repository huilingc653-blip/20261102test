<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
            <tr>
                <td class="textRight">#springMessage('table.fbsItem.itemName')</td>
                <td >
                    <div class="layui-inline">
                        <!-- <input type="text" name="likes_subjectName"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.fbsItem.itemName')"> -->
                                <div class="bt-biz-selectType" data-valuefield="id"  data-textfield="subjectName" 
								data-url="${basePath}/paramconfig/fcbusinessruledefine/jsonSubject" data-name="eqs_subjectCode" data-search="true"></div>
                    </div>
            	</td>
                <td class="textRight">#springMessage('table.fc_instrate.instrt_type')</td>
                <td >
	                <div class="layui-inline">
	                    #set ($instrtTypeMap = {"field":"eqs_instrtType","id":"instrtType","type":"list","typeGroupCode":"Common.InstrtType","defaultVal":"$!{fcInstratePage.instrtType}"})
			            #set ($formInstrtType = $dictSelect.instance($instrtTypeMap))
			         	${formInstrtType.html()}
	                </div>
            	</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.fc_instrate.exe_date')</td>
                <td >
                <div class="layui-inline">
                    <div type="date" field="eqd_exeDate" defaultVal="$!{fcInstratePage.exeDate}"></div>
                </div>
            	</td>
                <td class="textRight">#springMessage('table.nisBillhead.curCode')</td>
                <td >
                    <div class="layui-inline">
                    	<div type="list" field="eqs_curCode" fieldHref="${basePath}/basic/business/btcurrency/json" dictField="id" dictText="curName" defaultVal="$!{table.fc_instrate.cur_code}"></div>
                    </div>
				</td>
            </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
	            <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
	            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        	</td>
        </tr>
    
    </tbody>
    </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fc_instrate.subject_code')</th>
        <th>#springMessage('table.fc_instrate.cur_code')</th>
        <th>#springMessage('table.fc_instrate.instrt_type')</th>
        <th>#springMessage('table.fc_instrate.old_instrate')</th>
        <th>#springMessage('table.fc_instrate.interest_rate')</th>
        <th>#springMessage('table.fc_instrate.exe_date')</th>
        <th>#springMessage('table.fc_instrate.end_unit')</th>
        <th>#springMessage('table.fc_instrate.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','datatable','select','btdate','date','money','selectType','rateType'], function(){
        $ = bt.jquery,form = bt.form();
        bt.selectType.init();
        //生成列表
        bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            colReorder: true,
            
            checkbox:false,order: [1,'desc'],
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath+"/paramconfig/fcinstrate/datatable"
            },
            buttons: [
                {
                    text: bt.lang('common.button.add'),
                    action: function ( e, dt, node, config ) {
                        add();
                    }
                },{
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                }
            ],
            fixedColumns: {
                rightColumns:1//代表冻结右边一列
            }
            ,columns: [
                {data:"subjectName",bSortable:true,className:'center'},
                {data:"curName",bSortable:true,className:'center'},
                {data:"instrtType",bSortable:true,className:'center',
                	render: function ( data, type, full, meta ) {
                        return bt.dict("Common.InstrtType",full.instrtType);
                    }	
                },
                {data:"oldInstrate",bSortable:true,className:'textRight',
                	render: function ( data, type, full, meta ) {
                		var moneyFun = bt.rateType.getFun();
                		return moneyFun.format(data);
                	}
                },
                {data:"interestRate",bSortable:true,className:'textRight',
                	render: function ( data, type, full, meta ) {
                		var moneyFun = bt.rateType.getFun();
                		return moneyFun.format(data);
                	}
                },
                {data:"exeDate",bSortable:true,className:'center'},
                {data:"endUnit",bSortable:true,className:'center',
                	render: function ( data, type, full, meta ) {
                		var endUnit = bt.dict("finacial.EndUnit",full.endUnit);
                        return endUnit;
                    }
                },
                {data:"status",bSortable:true,className:'center',
                	render: function ( data, type, full, meta ) {
                		return bt.dict('valid_sign',full.status);
                	}
                },
                {data:null,bSortable:false,className:'center',render: function (data, type, full, meta) {
                    var html = '<a class="" href="#" data-row="'+meta.row+'" onclick="view(this)">'+bt.lang("common.button.view")+'</a>';
                    if(full.status==1 && full.isShow == "1"){
                    	html += ' <a class="" href="#" data-row="'+meta.row+'" onclick="update(this)">'+bt.lang("common.button.edit")+'</a>';
                    	html += ' <a class="" href="#" data-row="'+meta.row+'" onclick="del(this)">'+bt.lang("common.button.delete")+'</a>';
                    }
                    return html;
                }}
            ]
        });
            //时间
            $.each($("div[type='date']"),function(i,item){
                bt.btdate.init({
                    elem: "[field='"+$(item).attr("field")+"']",
                    name: $(item).attr("field"),
                    start: $(item).attr("defaultVal"),
                    format: "YYYY-MM-DD",
                    istime: false
                });
            });
            $.each($("div[type='datetime']"),function(i,item){
                bt.btdate.init({
                    elem: "[field='"+$(item).attr("field")+"']",
                    name: $(item).attr("field"),
                    start: $(item).attr("defaultVal"),
                    format: "YYYY-MM-DD hh:mm:ss",
                    istime: true
                });
            });
            //下拉框
            $.each($("div[type='list']"),function(i,item){
                bt.select.init({
                    elem: "[field='"+$(item).attr("field")+"']",
                    name: $(item).attr("field"),
                    defaultVal: $(item).attr("defaultVal"),
                    valueField: $(item).attr("dictField"),
                    textField: $(item).attr("dictText"),
                    search: true,
                    disabled: false,
                    url: $(item).attr("fieldhref")
                });
            });
    });
    function add(){
    	if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.add.data'),basePath + "/paramconfig/fcinstrate/add");
			bt.navtab.refreshCurrentTable();
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/paramconfig/fcinstrate/add",
            end:function(){
               bt.navtab.refreshCurrentTable();
            }
        });
    }
    function view(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        // debugger;
        // console.log("data",data);
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'),basePath + "/paramconfig/fcinstrate/view/" + data.id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/paramconfig/fcinstrate/view/" + data.id
        });
    }
    function update(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.update.data'),basePath + "/paramconfig/fcinstrate/update?id=" + data.id);
			bt.navtab.refreshCurrentTable();
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/paramconfig/fcinstrate/update?id=" + data.id,
            end:function(){
                bt.navtab.refreshCurrentTable();
            }
        });
    }
    function del(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        parent.layer.confirm("#springMessage('common.message.confirm.delete')",function(){
            $.post(basePath + "/paramconfig/fcinstrate/delete/" + data.id, function(result){
                bt.navtab.refreshCurrentTable();
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },'JSON');
        });
    }
</script>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
	<table class="layui-table">
        <tbody>
        	<tr>
        		<td style="text-align:right;">#springMessage("finacial.paramconfig.fcbusrace.raceCode")</td>
				<td width="35%">
						$!{fcBusRacePage.raceCode}
				</td>
				<td style="text-align:right;">#springMessage("finacial.paramconfig.fcbusrace.raceName")</td>
				<td width="35%">
					<div class="layui-input-inline">
						#if($i18nTag.getBusinessBaseContext($!{fcBusRacePage.id}) == "")
							$!{fcBusRacePage.raceNameShow}
						#else
							$i18nTag.getBusinessBaseContext($!{fcBusRacePage.id})
						#end
					</div>
				</td>
			</tr>
			<tr>
        		<td style="text-align:right;">#springMessage("finacial.paramconfig.fcbusracepool.poolId")</td>
				<td width="35%">
					<div class="layui-input-inline">
						$!{fcBusRacePage.netName}
					</div>
				</td>
				<td style="text-align:right;">#springMessage("finacial.paramconfig.fcbusrace.sysRaceCode")</td>
				<td width="35%">
					<div class="layui-input-inline">
						$!{fcBusRacePage.sysRaceName}
					</div>
				</td>
			</tr>
			<tr>
        		<td style="text-align:right;">#springMessage("fcVoucherType.validSign")</td>
				<td width="35%">
					<div class="layui-input-inline">
						$dictTag.get("sf_yn",$!{fcBusRacePage.validSign})
					</div>
				</td>
				<td style="text-align:right;">###springMessage("finacial.paramconfig.fcbusrace.fatherId"):</td>
				<td width="35%">
					<div class="layui-input-inline">
						##$!{fcBusRacePage.fatherId}
					</div>
				</td>
			</tr>
		</tbody>
	</table>
</form>
#parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	<input id="method" name="method" type="hidden" value="$!{method}" >
	<input id="ids" name="ids" type="hidden" value="$!{fcBusRaceVoPage.ids}">
	<table class="layui-table">
        <tbody>
        	<tr>
        		##所属资金池
				<td style="text-align:right;">#springMessage("finacial.paramconfig.fcbusracepool.poolId"):</td>
				<td width="55%">
					#if($!{method} == 'copyFcBusRace')
					<!--number-->
                      #*  <div class="bt-biz-selectType" data-name="poolId" data-biz-name="poolId" data-required="true" data-url="${basePath}/paramconfig/fcbusracepool/getCorpPools"
                             data-valuefield="id" data-textfield="showName" data-search="true" data-defaultv></div>*#
						<div class="bt-biz-selectType" data-name="poolId" data-biz-name="poolId"
							 data-url="${basePath}/paramconfig/fcbusracepool/getCorpPools" data-required="true"
							 data-valuefield="id" data-textfield="showName" data-search="true" data-defaultValue="$!{netId}">
					#end
					#if($!{method} == 'batchUpdate')
                       #* <div class="bt-biz-selectType" data-name="poolId" data-biz-name="poolId" data-required="true" data-url="${basePath}/paramconfig/fcbusracepool/getCorpPools"
                             data-valuefield="id" data-textfield="showName" data-search="true" ></div>*#
						<div class="bt-biz-selectType" data-name="poolId" data-biz-name="poolId"
							 data-url="${basePath}/paramconfig/fcbusracepool/getCorpPools" data-required="true"
							 data-valuefield="id" data-textfield="showName" data-search="true" data-defaultValue="$!{netId}">
   					#end
				</td>
        	</tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                  	<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage("common.button.submit")</button>
                	<button type="reset" class="layui-btn layui-btn-primary">#springMessage("common.button.reset")</button>
				</td>
			</tr>
		</tbody>
  	</table>
</form>
#parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','corp','selectType'], function(){
		var $ = bt.jquery,form = bt.form();
		bt.corp.init();
        bt.selectType.init();

		//监听提交
        form.on('submit(submit)', function(data){
        	bt.loading.show();//显示加载中
        	var method = $("#method");
            var action = "/paramconfig/fcbusracepool/"+method.val();
            $.post(basePath + action,data.field,function(result){
                if(result.success){
                    parent.layer?parent.layer.closeAll():layer.closeAll();
                }
                bt.loading.hide(); //关闭加载中
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            },'JSON');
            return false;
        });
	});
</script>
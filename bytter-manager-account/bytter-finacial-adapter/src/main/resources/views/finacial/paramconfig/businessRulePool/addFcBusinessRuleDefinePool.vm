	                <div class=bt-biz-selectType data-name="sysRaceCode" data-biz-name="sysRaceCode" data-search="true" data-required="true"
	                		 data-textField="sysRaceName" data-valueField="sysRaceCode" data-url="${basePath}/paramconfig/fcbusinessruledefinepool/json" ></div>
	                		</div>
                 </td>
			</tr>
			<tr>
				<td class="textRight">
					#springMessage('table.fcBusinessRuleDefine.subjCode')

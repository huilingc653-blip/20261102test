        			</div>
        		</td>
				<td class="textRight">
					#springMessage('table.fcBusinessRuleDefine.validSign')
				</td>
				<td>
				<div class="layui-input-inline">
					<div class="bt-biz-dict" data-type="radio" data-biz-name="validSign" data-required="true"
							data-group="sf_yn" data-name="validSign" data-defaultvalue="1"></div>
                	</div>
				</td>
			</tr>
			</table>	
			<table id="dataTable" class="layui-table">
				<thead>
					<tr>
						<th>#springMessage('table.fcVoucherEntryDefine.groupNum')<span style="color:red">*</span></th>
						<th>#springMessage('table.fcVoucherEntryDefine.summary')</th>
						<th>#springMessage('table.fcVoucherEntryDefine.balanceWay')</th>
						<th>#springMessage('table.fcVoucherEntryDefine.subjectCode')<span style="color:red">*</span></th>
						<!-- <th>#springMessage('table.fcVoucherEntryDefine.voucherType')<span style="color:red">*</span></th> -->
						<th>#springMessage('table.fcVoucherEntryDefine.entryType')</th>
						<th><a href="#" title="#springMessage('common.addTr')" onClick="addTr()"><i class="layui-icon">&#xe654;</i></a></th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td><input type="text" data-name="vouchers[0].groupNums" name="vouchers[0].groupNum" data-type="int" minus="false" class="layui-input" maxlength="2" lay-verify="required" value="1"/></td>
						<td>
							<div class="bt-biz-selectType" data-biz-name="vouchers[0].summary" data-search="true" data-inputvalue="true" data-url="${basePath}/finacial/paramconfig/btsummary/json" data-valuefield="summaryContent" data-textfield="summaryContent" data-name="vouchers[0].summary" data-defaultvalue="$!{table.fcVoucherEntryDefine.summary}"></div>
						</td>
						<td>
							<div class=bt-biz-dict data-type="select" data-biz-name="vouchers[0].balanceWay" data-name="vouchers[0].balanceWay"  data-group="Admin.BalanceWay" data-defaultvalue="1"></div>
						</td>
						<!-- <td><div class="bt-biz-selectType" data-biz-name="vouchers[0].subjectCode" data-valuefield="id"  data-textfield="subjectName" data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSubjectDate" data-name="vouchers[0].subjectCode" data-required="true"></div></td> -->
						<td><div class="bt-biz-selectType" data-biz-name="vouchers[0].subjectCode" data-valuefield="id"  data-textfield="subjectName" data-url="${basePath}/paramconfig/fcbusinessruledefinepool/jsonSubject" data-name="vouchers[0].subjectCode" data-required="true" data-search="true" ></div></td>
						<!-- <td><div class="bt-biz-selectType" data-biz-name="vouchers[0].voucherType" data-url="${basePath}/netbank/fcvouchertype/json" data-valuefield="id" data-textfield="voucherName" data-name="vouchers[0].voucherType" data-required="true"></div></td> -->
						<td>
							<div class=bt-biz-dict data-type="select" data-biz-name="vouchers[0].entryType" data-name="vouchers[0].entryType"  data-group="Finacial.EntryType" data-defaultvalue="10"></div>
						</td>
						<td><a href="#" title="#springMessage('common.delTr')"
							onClick="remoTr(this.parentElement.parentElement.rowIndex)"><i
								class="layui-icon">&#xe640;</i></a></td>
					</tr>
					<!-- 模板 start 点击“增加明细”按钮时按照这列来生成下一行-->
					<!-- <tr id="template" style="display: none;">
						<td><input type="text" data-name="template[x].groupNums" name="template[x].groupNum" selectAttr="template_x" data-type="int" minus="false" class="layui-input" maxlength="2"/></td>
						<td><div type="list" field="template[x].summary" fieldHref="${basePath}/finacial/paramconfig/btsummary/json" dictField="id" dictText="summaryContent" defaultVal="$!{table.fcVoucherEntryDefine.summary}"></div></td>
						<td>
							<div class="layui-input-inline">
								#set ($balanceWayMap = {"field":"template[x].balanceWay","id":"vouchers[x].balanceWay","type":"list","typeGroupCode":"Admin.BalanceWay","defaultVal":"1","title":"#springMessage('fcVoucherEntryDefine.balanceWay')"})
								#set ($formbalanceWay = $dictSelect.instance($balanceWayMap))
								${formbalanceWay.html()}
							</div>
						</td>
						<td><div class="selectDemo" field="template[x].subjectCode"></div></td>
						<td><div type="list" field="template[x].voucherType" fieldHref="${basePath}/netbank/fcvouchertype/json" dictField="id" dictText="voucherName" ></div></td>
						<td>
							<div class="layui-input-inline">
								#set ($entryTypeMap = {"field":"template[x].entryType","id":"template[x].entryType","type":"list","typeGroupCode":"Finacial.EntryType","defaultVal":"10","title":"#springMessage('fcVoucherEntryDefine.entryType')"})
								#set ($formentryType = $dictSelect.instance($entryTypeMap))
								${formentryType.html()}
							</div>
						</td>
						<td><a href="#" title="#springMessage('common.delTr')"
							onClick="remoTr(this.parentElement.parentElement.rowIndex)"><i
								class="layui-icon">&#xe640;</i></a></td>
					</tr> -->
					<!-- 模板 end -->
				</tbody>
			</table>
			
            <div class="layui-form-item" align="center">
                <div class="layui-input-block">
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </div>
            </div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>

bt.use(['form','layedit','selectTree','select','btdate','corp','moneyType','selectType','dicts'], function(){
	var $ = bt.jquery, form = bt.form();
    bt.corp.init();
    bt.selectType.init();
    bt.dicts.init();
    bt.moneyType.init({elem:$('[data-type="int"]'),decimal:0,minus:true});
    
    
    //监听提交
    form.on('submit(submit)', function(data){
        var action = "/paramconfig/fcbusinessruledefinepool/save";
        $.post(basePath + action,data.field,function(result){
        	parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            if(result.success){
            	$.each($(".layui-form"), function(){
                    this.reset();
                });
            	if(!bt.navtab){
                	parent.layer?parent.layer.closeAll():layer.closeAll();
            	}else{            		
                	bt.navtab.closeCurrent();
            	}
            }
        },'JSON');
        return false;
    });
    
    
});

	function addTr() {
		var form = bt.form();
		var tab = document.getElementById("dataTable");
		var rowsCount = tab.rows.length;
		var index = rowsCount - 1;
		var html='<tr row="'+index+'">';
		html+= '<td><input type="text" data-name="vouchers['+index+'].groupNums" name="vouchers['+index+'].groupNum" selectAttr="vouchers_'+index+'" data-type="int" minus="false" class="layui-input" maxlength="2" lay-verify="required"/></td>';
		html+='<td><div class="bt-biz-selectType" data-biz-name="vouchers['+index+'].summary" data-search="true" data-inputvalue="true" data-url="${basePath}/finacial/paramconfig/btsummary/json" data-valuefield="summaryContent" data-textfield="summaryContent" data-name="vouchers['+index+'].summary" data-defaultvalue="$!{table.fcVoucherEntryDefine.summary}"></div></td>';
		html+='<td><div class=bt-biz-dict data-type="select" data-biz-name="vouchers['+index+'].balanceWay" data-name="vouchers['+index+'].balanceWay"  data-group="Admin.BalanceWay" data-defaultvalue="1"></div></td> ';
		/* html+='<td><div class="bt-biz-selectType" data-biz-name="vouchers['+index+'].subjectCode" data-valuefield="id"  data-textfield="subjectName" data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSubjectDate" data-name="vouchers['+index+'].subjectCode" data-required="true"></div></td>'; */
		html+='<td><div class="bt-biz-selectType" data-biz-name="vouchers['+index+'].subjectCode" data-valuefield="id"  data-textfield="subjectName" data-url="${basePath}/paramconfig/fcbusinessruledefinepool/jsonSubject" data-name="vouchers['+index+'].subjectCode" data-required="true" data-search="true" ></div></td>';
		/* html+='<td><div class="bt-biz-selectType" data-biz-name="vouchers['+index+'].voucherType" data-url="${basePath}/netbank/fcvouchertype/json" data-valuefield="id" data-textfield="voucherName" data-name="vouchers['+index+'].voucherType" data-required="true"></div></td>'; */
		html+='<td><div class=bt-biz-dict data-type="select" data-biz-name="vouchers['+index+'].entryType" data-name="vouchers['+index+'].entryType"  data-group="Finacial.EntryType" data-defaultvalue="10"></div></td>';
		html+='<td><a href="#" title="#springMessage('common.delTr')" onClick="remoTr(this.parentElement.parentElement.rowIndex)"><i class="layui-icon">&#xe640;</i></a></td>';
		html+='</tr>';
		$("#dataTable>tbody").append(html);
		bt.dicts.init();
		bt.selectType.init();
		form.render("select");
		var groupName = "vouchers_" + index;
		bt.use(['form','moneyType'], function(){
		    var $ = bt.jquery,form = bt.form();
		    $.each($('[selectAttr="' + groupName + '"]'),function(i,item){
			    bt.moneyType.init({elem:$(this),decimal:0,minus:true});
		    });
		});
	}
	function remoTr(rowIndex) {
		var tab = document.getElementById("dataTable");
		tab.deleteRow(rowIndex);
		console.log(rowIndex);
		//循环修改元素的名字
		for (var i = rowIndex; i < (tab.rows.length - 1); i++) {
			var tempTr = tab.rows.item(i);
			for (var x = 0; x < tempTr.cells.length; x++) {
				var tempTd = tempTr.cells.item(x);
				var strHTML = tempTd.innerHTML;
				console.log(strHTML);
				while (strHTML.indexOf("[" + (i - 1) + "]") > 0) {
					strHTML = strHTML.replace("[" + (i - 1) + "]", "["
							+ (i - 2) + "]");
				}
				while (strHTML.indexOf("[" + (i) + "]") > 0) {
					strHTML = strHTML.replace("[" + (i) + "]", "[" + (i - 1)
							+ "]");
				}
				tempTd.innerHTML = strHTML;
			}
		}
		return false;
	}
</script>

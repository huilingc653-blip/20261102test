<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcInstratePage.id}">
		<input id="status" name="status" type="hidden" value="$!{fcInstratePage.status}">
		<input id="createTime" name="createTime" type="hidden" value="$!{fcInstratePage.createTime}">
		<input id="createBy" name="createBy" type="hidden" value="$!{fcInstratePage.createBy}">
		<input id="updateTime" name="updateTime" type="hidden" value="$!{fcInstratePage.updateTime}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fcInstratePage.updateBy}">
		<table class="layui-table">
			<tr>
				##科目代码
				<td class="textRight">#springMessage('table.fbsItem.itemName')</td>
       			<td>
					<!--number-->
					<!-- <div class="selectDemo" field="subjectCode" defaultVal="$!{fcInstratePage.subjectCode}"></div> -->
					<div class="bt-biz-selectType" data-biz-name="subjectCode" data-valuefield="id"  data-textfield="subjectName" data-required="true"
							data-url="${basePath}/paramconfig/fcbusinessruledefine/jsonSubject" data-name="subjectCode" data-search="true" data-defaultvalue="$!{fcInstratePage.subjectCode}"></div>
				</td>
				##利率类型
				<td class="textRight">#springMessage('table.fc_instrate.instrt_type')</td>
				<td>
	                <div class="bt-biz-dict" data-type="select" data-biz-name="instrtType" data-required="true"
							data-group="Common.InstrtType" data-name="instrtType" data-defaultvalue="$!{fcInstratePage.instrtType}"></div>
                </td>
            </tr>
			<tr>
				##币别代码
				<td class="textRight">#springMessage('table.nisBillhead.curCode')</td>
        		<td>
					<div class="bt-biz-selectType" data-biz-name="curCode" data-url="${basePath}/basic/business/btcurrency/json" data-required="true"
				            	data-valuefield="id" data-textfield="curName" data-name="curCode" data-search="true" data-defaultvalue="$!{fcInstratePage.curCode}"></div>
				</td>
            	##利率
				<td class="textRight">#springMessage('table.fc_instrate.interest_rate')</td>
        		<td>
					<!--number-->
					<input type="text" lay-verify="required" data-name="interestRate" minus="false" data-biz-name="interestRate"
					 	class="layui-input bt-biz-rateType" placeholder="#springMessage('table.fc_instrate.interest_rate')" value="$!{fcInstratePage.interestRate}">
				</td>
			</tr>
			<tr>
            	##执行日期
				<td class="textRight">#springMessage('table.fc_instrate.exe_date')</td>
        		<td>
					<input type="text" name="exeDate" class="layui-input bt-biz-dateType" data-type="date" lay-verify="required"
							data-biz-name="exeDate" placeholder="$!date.format('yyyy-MM-dd',$!fcInstratePage.exeDate)" 
							value="$!date.format('yyyy-MM-dd',$!fcInstratePage.exeDate)">   
				
                </td>
                ##期限单位
				<td class="textRight">#springMessage('table.fc_instrate.end_unit')</td>
				<td>
					<div class="bt-biz-dict" data-type="select" data-biz-name="endUnit" data-required="true"
							data-group="finacial.EndUnit" data-name="endUnit" data-defaultvalue="$!{fcInstratePage.endUnit}"></div>
				</td>
			</tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
    	</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','layedit','select','btdate','rateType','selectType','dicts','dateType'], function(){
		var $ = bt.jquery,form = bt.form();
		bt.dateType.init();
		var rate = bt.rateType.init();
		bt.selectType.init();
		bt.dicts.init();
		//bt.moneynum.init({elem:$('[data-type="percent"]'),decimal:6,minus:true});
		
		$.each($(".selectDemo"),function(i,item){
	        bt.select.init({
	            elem: "[field='"+$(item).attr("field")+"']",
	            name: $(item).attr("field"),
	            defaultVal: $(item).attr("defaultVal"),
	            valueField: "id",
	            textField:"subjectName",
	            search: true,
	            disabled: false,
	            required:true,
	            placeholder:{value:'',text:bt.lang("finacial.fcChargeType.notConsider")},
	            url:basePath+"/finacial/paramconfig/fcsubject/jsonSubjectDate",
	            change:function(data){
	            	//console.log(data);
	            }
	        });
	    });
		
		//格式化数字
		$.each($("input[decimal]"),function(i,item){
			if($(item).attr("decimal")!=""){
				bt.moneynum.setnum({trigger:$(item),decimal:$(item).attr('decimal')*1});
			}
		});
		//时间
		$.each($("div[type='date']"),function(i,item){
			bt.btdate.init({
				elem: "[field='"+$(item).attr("field")+"']",
				name: $(item).attr("field"),
				start: $(item).attr("defaultVal"),
				format: "YYYY-MM-DD",
				istime: true,
				required: true,
				defaultVal: $(item).attr("defaultVal")
			});
		});
		$.each($("div[type='datetime']"),function(i,item){
			bt.btdate.init({
				elem: "[field='"+$(item).attr("field")+"']",
				name: $(item).attr("field"),
				start: $(item).attr("defaultVal"),
				format: "YYYY-MM-DD hh:mm:ss",
				istime: true,
				required: true
			});
		});
		//下拉框
		$.each($("div[type='list']"),function(i,item){
			bt.select.init({
				elem: "[field='"+$(item).attr("field")+"']",
				name: $(item).attr("field"),
				defaultVal: $(item).attr("defaultVal"),
				valueField: $(item).attr("dictField"),
				textField: $(item).attr("dictText"),
				search: true,
				disabled: false,
				url: $(item).attr("fieldhref")
			});
		});
		
		//监听提交
        form.on('submit(submit)', function(data){
        	var interestRate=rate.get("interestRate").val();
        	data.field.interestRate=interestRate;
            var action = "/paramconfig/fcinstrate/modify";
            $.post(basePath + action,data.field,function(result){
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
                if(result.success){
                	if(!bt.navtab){
                        parent.layer?parent.layer.closeAll():layer.closeAll();
                    } else {
                    	bt.navtab.closeCurrent();
                    }
                }
            },'JSON');
            return false;
        });

	});
</script>
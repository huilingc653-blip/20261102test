<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="20%">#springMessage("finacial.paramconfig.debit.subjectName")</td>
            <td width="30%">
                <input type="text" name="likes_debitSubName" autocomplete="off" class="layui-input">
            </td>
            <td class="textRight" width="20%">#springMessage("finacial.paramconfig.credit.subjectName")</td>
            <td width="30%">
                <input type="text" name="likes_creditSubName" autocomplete="off" class="layui-input">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.eExchangeBill.debit')</th>#*借方科目*#
        <th>#springMessage('finacial.paramconfig.debit.subjectName')</th>#*借方科目名称*#
        <th>#springMessage('table.eExchangeBill.credit')</th>#*贷方科目*#
        <th>#springMessage('finacial.paramconfig.credit.subjectName')</th>#*贷方科目名称*#
        <th>#springMessage('finacial.paramconfig.debit.CashFlow.Item')</th>#*借方现金流项目*#
        <th>#springMessage('finacial.paramconfig.credit.CashFlow.Item')</th>#*贷方现金流项目*#
        <th>#springMessage('table.erpDataType.validSign')</th>#*是否有效*#
        <th>#springMessage('common.table.thead.operation')</th>#*操作*#
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','datatable','corp'], function(){
        $ = bt.jquery,form = bt.form();
        bt.corp.init();
        //生成列表
        bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            ajax: {
                'url': basePath+"/finacial/paramconfig/voucherCash/datatable"
            },searchForm:{
                formFilter:"search",
                formElem:"#searchForm"
            },
            buttons: [
                {
                    text: "#springMessage('common.button.add')",
                    action: function ( e, dt, node, config ) {
                        add();
                    }
                }
            ],
            columns: [
                {data: "debitSubCode", className: 'center'},
                {data: "debitSubName", className: 'center'},
                {data: "creditSubCode", className: 'center'},
                {data: "creditSubName", className: 'center'},
                {data: "debitItemName", className: 'center'},
                {data: "creditItemName", className: 'center'},
                {
                    data: "validSign", bSortable: true, className: 'center',
                    render: function (data, type, full, meta) {
                        var validSign = bt.dict("sf_yn", full.validSign);
                        return validSign;
                    }
                },
                {
                    data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
                        var html = '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a>';
                        html += '  <a class="" href="#" data-row="' + meta.row + '" onclick="update(this)">' + bt.lang("common.button.edit") + '</a>';
                        html += '  <a class="" href="#" data-row="' + meta.row + '" onclick="del(this)">' + bt.lang("common.button.delete") + '</a>';
                        return html;
                    }
                }
            ]
        });
    });
    function add(){
        parent.layer.open({
            type: 2,
            area: ['850px', '500px'],
            maxmin: true,
            content: basePath + "/finacial/paramconfig/voucherCash/add",
            end:function(){
                bt.navtab.refreshCurrentTable();
            }
        });
    }

    function view(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        parent.layer.open({
            type: 2,
            area: ['850px', '400px'],
            maxmin: true,
            content: basePath + "/finacial/paramconfig/voucherCash/view/" + data.id
        });
    }

    function update(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (data) {
            parent.layer.open({
                type: 2,
                area: ['850px', '500px'],
                maxmin: true,
                content: basePath + "/finacial/paramconfig/voucherCash/update/" + data.id,
                end: function () {
                    bt.navtab.refreshCurrentTable();
                }
            });
        }
    }

    function del(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if (data) {
            parent.layer.confirm("" + bt.lang('common.message.confirm.delete') + "", function () {
                $.post(basePath + "/finacial/paramconfig/voucherCash/delete?voucherCashId=" + data.id, function (result) {
                    bt.datatable.refreshCurrentPage();
                    parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                }, 'JSON');
            });
        }
    }
</script>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
	
	<table class="layui-table">
		<tr>
		##业务种类
			<td class="textRight">#springMessage('table.fcChargeRule.raceCode')</td>
			<td>$!{fcChargeRulePage.raceCode}</td>
		##凭证种类代码
			<td class="textRight">#springMessage('table.fcChargeRule.voucherType')</td>
			<td>$!{fcChargeRulePage.voucherType}</td>
		</tr>
		<tr>
		##收费借方科目
			<td class="textRight">#springMessage('table.fcChargeRule.debitSubjCode')</td>
			<td>$!{fcChargeRulePage.debitSubjCode}</td>
		##收费贷方科目
			<td class="textRight">#springMessage('table.fcChargeRule.creditSubjCode')</td>
			<td>$!{fcChargeRulePage.creditSubjCode}</td>
		</tr>
		
		<tr>
		##摘要
			<td class="textRight">#springMessage('table.fcChargeRule.summary')</td>
			<td>$!{fcChargeRulePage.summary}</td>
		##所属网点
			<td class="textRight">#springMessage('table.fcChargeRule.netId')</td>
			<td>$!{fcChargeRulePage.netId}</td>
		</tr>
		<tr>
			<td class="textRight">#springMessage('table.fcChargeRule.fcChargeType')</td>
			<td>$!{ChargeRuleChargeType}</td>
			##币别
			<td class="textRight">#springMessage('table.fcChargeType.curCode')</td>
			<td>$!{fcChargeRulePage.curName}</td>
		</tr>
	</table>
	
	<hr>
				<table  class="layui-table" style="text-align: center;">
				<colgroup>
			      <col width="20%">
			      <col width="10%">
			      <col width="25%">
			      <col width="25%">
			      <col width="20%">
			    </colgroup>
					<thead>
						<tr>
							<td>#springMessage('table.fcVoucherEntryDefine.summary')</td>
							<td>#springMessage('table.fcVoucherEntryDefine.balanceWay')</td>
							<td>#springMessage('table.fcVoucherEntryDefine.subjectCode')</td>
							<td>#springMessage('table.fcVoucherEntryDefine.account')</td>
							<td>#springMessage('table.fcVoucherEntryDefine.voucherType')</td>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>
								$!{voucherEntryDefines[0].summaryContent}
							</td>
							<td>
								#if(${voucherEntryDefines[0].balanceWay}=='1') 
									#springMessage('table.fcVoucherEntryDefine.debit')  
								#elseif(${voucherEntryDefines[0].balanceWay}=='-1') 
									#springMessage('table.fcVoucherEntryDefine.credit')
								#end
							</td>
							<td>
								$!{voucherEntryDefines[0].subjectName}
							</td>
							<td>
								$!{voucherEntryDefines[0].account}
							</td>
							<td>
								$!{voucherEntryDefines[0].voucherName}
							</td>
						</tr>
						<tr>
							<td>
								$!{voucherEntryDefines[1].summaryContent}
							</td>
							<td>
								#if(${voucherEntryDefines[1].balanceWay}=='1') 
									#springMessage('table.fcVoucherEntryDefine.debit') 
								#elseif(${voucherEntryDefines[1].balanceWay}=='-1') 
									#springMessage('table.fcVoucherEntryDefine.credit') 
								#end
							</td>
							<td>
								$!{voucherEntryDefines[1].subjectName}
							</td>
							<td>
								$!{voucherEntryDefines[1].account}
							</td>
							<td>
								$!{voucherEntryDefines[1].voucherName}
							</td>
						</tr>
						<tr>
							<td colspan="5" align="center">
								<button class="layui-btn"  onClick="doClose()">#springMessage('common.button.close')</button>
							</td>
						</tr>
					</tbody>
				</table>
	
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
bt.use(['form'], function(){
	//关闭窗口
    doClose = function(){
    	if(bt.navtab){
			bt.navtab.closeCurrent();
		}
    }
});
</script>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
	<input id="id" name="id" type="hidden" value="$!{fcChargeTypePage.id}">
		<table class="layui-table">
			<colgroup>
				<col width="20%">
				<col width="30%">
				<col width="20%">
				<col width="30%">
			</colgroup>
			<tr>
			##费用代码
				<td class="textRight">#springMessage('table.fcChargeType.chargeTypeCode')</td>
				<td>$!{fcChargeTypePage.chargeTypeCode}</td>
			##费用名称
				<td class="textRight">#springMessage('table.fcChargeType.chargeTypeName')</td>
				<td>$!{fcChargeTypePage.chargeTypeName}</td>
			</tr>
			<!-- <tr>
			##币别
				<td class="textRight">#springMessage('table.fcChargeType.curCode')</td>
				<td>$!{fcChargeTypePage.curCode}</td>
			##加急标志
				<td class="textRight">#springMessage('table.fcChargeType.emergencySign')</td>
				<td>$!dictTag.get("emergency_sign",${fcChargeTypePage.emergencySign}) </td>
			</tr> -->
			<!-- <tr>
			##跨行标志
				<td class="textRight">#springMessage('table.fcChargeType.difBank')</td>
				<td>$!dictTag.get("nisBillhead.difBank",${fcChargeTypePage.difBank})</td>
			##地域标志
				<td class="textRight">#springMessage('table.fcChargeType.areaSign')</td>
				<td>$!dictTag.get("nisBillhead.areaSign",${fcChargeTypePage.areaSign}) </td>
			</tr> -->
			<!-- <tr>
			##银行类型
				<td class="textRight">#springMessage('table.chargeTypeBankTypeRel.bankType')</td>
				<td colspan="3">$!{bankNames}</td>
			</tr> -->
			<tr>
			##收取费用
				<td class="textRight">#springMessage('table.fcChargeType.charge')</td>
				<td colspan="3">
					$!number.formatNumeric($!{fcChargeTypePage.charge})
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.fcChargeType.createTime')</td>
				<td>$!date.format('yyyy-MM-dd',$!{fcChargeTypePage.createTime})</td>
				<td class="textRight">#springMessage('table.fcChargeType.createBy')</td>
				<td>$!{fcChargeTypePage.createBy}</td>
			</tr>
		</table>
		##明细数据
		<table id="dttable" class="layui-table">
				<thead>
					<tr>
						<th>#springMessage('table.fc_charge_type_dtl.min_range_money')</th>
						<th>#springMessage('table.fc_charge_type_dtl.max_range_money')</th>
						<th>#springMessage('table.fc_charge_type_dtl.calc_type')</th>
						<th>#springMessage('table.fc_charge_type_dtl.fix_percent')</th>
						<th>#springMessage('table.fc_charge_type_dtl.max_charge')</th>
					</tr>
				</thead>
				<tfoot>
					<tr>
						<td colspan="5" align="center">
							<button class="layui-btn"  onClick="doClose()">#springMessage('common.button.close')</button>
						</td>
					</tr>
				</tfoot>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
bt.use(['form','bttable','moneyType'], function(){
	var $ = bt.jquery,form = bt.form(),moneyFun = bt.moneyType.getFun();
	bt.bttable.init({
		elem: "#dttable",
		url: basePath + "/paramconfig/fcchargetype/listFcChargeTypeDtls",
		urldata:{"fcChargeTypeId":$("#id").val()},	
		scrollX:true,
		columns:[{data:"minRangeMoney",className:"center",
			render:function(data, row){
				return moneyFun.format(data.minRangeMoney);
			}
		},
		         {data:"maxRangeMoney",className:"center",
			render:function(data, row){
				return moneyFun.format(data.maxRangeMoney);
			}
		},{
			data:"calcType",className:"center",
			render:function(data, row){
				return bt.dict('chargeTypeDtls.calcType',data.calcType);
			}
		},{
			data:"fixChargeMoney",className:"center",
			render:function(data, row){
				if(data.calcType=="10"){
					return moneyFun.format(data.fixChargeMoney);
				}else{
					return moneyFun.format(data.percent)+"%";
				}
			}
		},{
			data:"maxCharge",className:"center",
			render:function(data, row){
				return moneyFun.format(data.maxCharge);
			}
		}]
	});
	
	//关闭窗口
    doClose = function(){
    	if(bt.navtab){
			bt.navtab.closeCurrent();
		}
    }
});
</script>
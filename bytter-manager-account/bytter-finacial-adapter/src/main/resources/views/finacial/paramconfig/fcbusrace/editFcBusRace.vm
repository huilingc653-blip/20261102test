<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	<input id="method" name="method" type="hidden" value="$!{method}" >
	<input id="ids" name="ids" type="hidden" value="$!{fcBusRaceVoPage.ids}">
	<table class="layui-table">
        <tbody>
        	<tr>
        		##委托人
				<td style="text-align:right;">#springMessage("finacial.paramconfig.fcbusrace.netId"):</td>
				<td width="55%">
					#if($!{method} == 'copyFcBusRace')
					<!--number-->
						<div class="bt-biz-corp"  data-biz-type="net" data-required="true" data-type="selectTree"  data-name="netIds" data-scope="net" data-tree-type="check"></div>
					#end
					#if($!{method} == 'batchUpdate')
						<div class="bt-biz-corp"  data-biz-type="net" data-type="selectTree" data-required="true"  data-name="netIds" data-scope="net" ></div>
   					#end
				</td>
        	</tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                  	<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage("common.button.submit")</button>
                	<button type="reset" class="layui-btn layui-btn-primary">#springMessage("common.button.reset")</button>
				</td>
			</tr>
		</tbody>
  	</table>
</form>
#parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','corp'], function(){
		var $ = bt.jquery,form = bt.form();
		bt.corp.init();
		//$("#ids").val(parent[0].getId())
		//监听提交
        form.on('submit(submit)', function(data){
        	bt.loading.show();//显示加载中
        	var method = $("#method");
            var action = "/paramconfig/fcbusrace/"+method.val();
            $.post(basePath + action,data.field,function(result){
                if(result.success){
                    parent.layer?parent.layer.closeAll():layer.closeAll();
					window.top.refreshParentFlag = true
                }
                bt.loading.hide(); //关闭加载中
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            },'JSON');
            return false;
        });
	});
</script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form">
		<input  name="netCode" type="hidden" value="$!{format.netCode}">
		<input  name="reportType" type="hidden" value="$!{format.reportType}">
        <table class="layui-table">
			<tbody>
				<tr>
					<td class="textRight">网点</td>
					<td width="55%"><div class="bt-biz-corp" data-name="newNetCode" data-biz-type="net" data-type="select" data-required="true"></div></td>
				</tr>
				<tr>
				<td colspan="4" style="text-align: center;">
					<button class="layui-btn" lay-submit lay-filter="submit">#springMessage('common.button.clone')</button>
				</td>
			</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script>
bt.use(['form','layedit','selectTable','btdate','select','money','dicts','bttable','corp','selectType','dicts'], function(){
    $ = bt.jquery,form = bt.form();
    bt.corp.init();
    selectType = bt.selectType.init();
    dicts = bt.dicts.init();
    //监听提交
    form.on('submit(submit)', function(data){
    	bt.loading.show();//显示加载中
    	if(data.field.netCode == " "){
    		layer.msg(bt.lang('table.fcReportFormat.firstSelectNet'));
    		return false;
    	}
        var action = "/finacial/paramconfig/fcreportformat/copySubmit";
        $.post(basePath + action,data.field,function(result){
        	if(result.success){
            	location.reload();
                parent.layer?parent.layer.closeAll():layer.closeAll();
            }
        	bt.loading.hide(); //关闭加载中
            parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
        },'JSON');
        return false;
    });
    
});
</script>
</html>
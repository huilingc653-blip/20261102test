						</div>
					</td>
            		<td class="textRight" style="width: 15%">#springMessage('table.fcBusinessRuleDefine.sysRaceName')</td>
            		<td style="width: 35%">
            			<div class="layui-inline">
                			<div class=bt-biz-selectType data-name="sysRaceCode" data-biz-name="sysRaceCode" data-width="280px" data-defaultvalue="$!{fcBusinessRuleDefinePage.sysRaceCode}"
                			data-search="true" data-textField="sysRaceName" data-valueField="sysRaceCode" data-url="${basePath}/paramconfig/fcbusinessruledefine/json" ></div>
            			</div>
            		</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.fcBusinessRuleDefine.subjCode')</td>
					<td>
						<div class="layui-input-inline">
							<!-- <div class="bt-biz-selectType" data-biz-name="subjCode" data-valuefield="id"  data-textfield="subjectName"
							data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSubjectDate" data-name="subjCode" data-defaultvalue="$!{fcBusinessRuleDefinePage.subjCode}"></div> -->
							<div class="bt-biz-selectType" data-biz-name="subjCode" data-valuefield="id"  data-textfield="subjectName" data-width="250px"
							data-url="${basePath}/paramconfig/fcbusinessruledefine/jsonSubject" data-name="subjCode" data-search="true" data-defaultvalue="$!{fcBusinessRuleDefinePage.subjCode}"></div>
						</div>
					</td>
            		<td class="textRight">#springMessage('table.fcBusinessRuleDefine.curCode')<span style="color:red">*</span></td>
            		<td>
            			<div class="layui-input-inline">
						<!--number-->
							<div class="bt-biz-selectType" data-biz-name="curCode" data-url="${basePath}/basic/business/btcurrency/json" data-required="true"
							data-valuefield="id" data-textfield="curName" data-name="curCode" data-defaultvalue="$!{fcBusinessRuleDefinePage.curCode}"></div>
						</div>
            		</td>
				</tr>
				<tr>
					<td class="textRight">#springMessage('table.fcBusinessRuleDefine.voucherType')<span style="color:red">*</span></td>
					<td>
						<div class="layui-input-inline">
        					<div class="bt-biz-selectType" data-biz-name="voucherType" data-url="${basePath}/paramconfig/fcbusinessruledefine/getFcVoucherType"
        					data-valuefield="id" data-textfield="voucherName" data-name="voucherType" data-defaultvalue="$!{fcBusinessRuleDefinePage.voucherType}" data-required="true"></div>
        				</div>
					</td>
					<td class="textRight">#springMessage('table.fcBusinessRuleDefine.validSign')</td>
					<td>
						<div class="layui-input-inline">
							<div class="bt-biz-dict" data-type="radio" data-biz-name="validSign" data-required="true"
								data-group="sf_yn" data-name="validSign" data-defaultvalue="$!{fcBusinessRuleDefinePage.validSign}"></div>
                		</div>
					</td>
				</tr>
			</table>

			<table id="dataTable" class="layui-table">
				<thead>
##					<tr>
						<th>#springMessage('table.fcVoucherEntryDefine.groupNum')<span style="color:red">*</span></th>
						<th>#springMessage('table.fcVoucherEntryDefine.summary')</th>
						<th>#springMessage('table.fcVoucherEntryDefine.balanceWay')</th>
						<th>#springMessage('table.fcVoucherEntryDefine.subjectCode')<span style="color:red">*</span></th>
						<!-- <th>#springMessage('table.fcVoucherEntryDefine.voucherType')</th> -->
						<th>#springMessage('table.fcVoucherEntryDefine.entryType')</th>
						<th><a href="#" title="#springMessage('common.addTr')" onClick="addTr()"><i class="layui-icon">&#xe654;</i></a></th>
##					</tr>
				</thead>
				<tbody id="dataTableTbody">
					#foreach($entryDefine in $!{fcBusinessRuleDefinePage.vouchers})
						#set($vcount = $velocityCount - 1)
					<tr>
						<td><input type="text" data-name="vouchers[${vcount}].groupNums" name="vouchers[${vcount}].groupNum" data-type="int" class="layui-input" minus="false" maxlength="2" lay-verify="required" value="$!{entryDefine.groupNum}"/></td>
						<td>
							<!-- <div type="list" field="vouchers[${vcount}].summary" fieldHref="${basePath}/finacial/paramconfig/btsummary/json" dictField="id" dictText="summaryContent" defaultVal="$!{entryDefine.summary}"></div> -->
							<div class="bt-biz-selectType" data-biz-name="vouchers[${vcount}].summary" data-search="true" data-inputvalue="true" data-url="${basePath}/finacial/paramconfig/btsummary/json" data-valuefield="summaryContent" data-textfield="summaryContent" data-name="vouchers[${vcount}].summary" data-defaultvalue="$!{entryDefine.summary}" data-extraData="true"></div>
						</td>
						<td>
							<!-- #set ($balanceWayMap = {"field":"vouchers[${vcount}].balanceWay","id":"vouchers[${vcount}].balanceWay","type":"list","typeGroupCode":"Admin.BalanceWay","defaultVal":"$!{entryDefine.balanceWay}","title":"#springMessage('table.fcVoucherEntryDefine.balanceWay')"})
							#set ($formbalanceWay = $dictSelect.instance($balanceWayMap))
							${formbalanceWay.html()} -->
							<div class=bt-biz-dict data-type="select" data-biz-name="vouchers[${vcount}].balanceWay" data-name="vouchers[${vcount}].balanceWay"  data-group="Admin.BalanceWay" data-defaultvalue="$!{entryDefine.balanceWay}"></div>
						</td>
						<!-- <td><div class="selectDemo" field="vouchers[${vcount}].subjectCode" defaultVal="$!{entryDefine.subjectCode}"></div></td> -->
						<!-- <td><div class="bt-biz-selectType" data-biz-name="vouchers[${vcount}].subjectCode" data-valuefield="id"  data-textfield="subjectName" data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSubjectDate" data-name="vouchers[${vcount}].subjectCode" data-required="true" data-defaultvalue="$!{entryDefine.subjectCode}"></div></td> -->
						<td><div class="bt-biz-selectType" data-required="true" data-biz-name="vouchers[${vcount}].subjectCode" data-valuefield="id"  data-textfield="subjectName" data-url="${basePath}/paramconfig/fcbusinessruledefine/jsonSubject" data-name="vouchers[${vcount}].subjectCode" data-search="true" data-defaultvalue="$!{entryDefine.subjectCode}" data-width="250px"></div></td>
						<!-- <td><div type="list" field="vouchers[${vcount}].voucherType" fieldHref="${basePath}/netbank/fcvouchertype/json" defaultVal="$!{entryDefine.voucherType}" dictField="id" dictText="voucherName" ></div></td> -->
						<td>
							<div class="layui-input-inline">
##								#set ($entryTypeMap = {"field":"vouchers[${vcount}].entryType","id":"vouchers[${vcount}].entryType","type":"list","typeGroupCode":"Finacial.EntryType","defaultVal":"$!{entryDefine.entryType}","title":"#springMessage('table.fcVoucherEntryDefine.entryType')"})
##								#set ($formentryType = $dictSelect.instance($entryTypeMap))
##								${formentryType.html()}
    							<div class=bt-biz-dict data-type="select" data-biz-name="vouchers[${vcount}].entryType" data-name="vouchers[${vcount}].entryType"  data-group="Finacial.EntryType" data-defaultvalue="$!{entryDefine.entryType}"></div>
							</div>
						</td>
						<td><a href="#" title="#springMessage('common.delTr')"
							onClick="remoTr(this.parentElement.parentElement.rowIndex)"><i
								class="layui-icon">&#xe640;</i></a></td>
					</tr>
					#end
				</tbody>

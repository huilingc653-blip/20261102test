            <div class="layui-form-item" style="text-align: center">
                <div>
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </div>
            </div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
bt.use(['form','layedit','selectTree','select','btdate','corp','moneyType','selectType','dicts'], function(){
    var $ = bt.jquery,form = bt.form();
    bt.corp.init();
    bt.selectType.init();
    bt.dicts.init();
    bt.moneyType.init({elem:$('[data-type="int"]'),decimal:0,minus:true});

    $.each($(".selectDemo"),function(i,item){
        bt.select.init({
            elem: "[field='"+$(item).attr("field")+"']",
            name: $(item).attr("field"),
            defaultVal: $(item).attr("defaultVal"),
            valueField: "id",
            textField:"subjectName",
            search: true,
            disabled: false,
            placeholder:{value:'',text:bt.lang("finacial.fcChargeType.notConsider")},
            url:basePath+"/finacial/paramconfig/fcsubject/jsonSubjectDate",
            change:function(data){
            	//console.log(data);
            }
        });
    });

    //下拉框
    $.each($("div[type='list']"),function(i,item){
        bt.select.init({
            elem: "[field='"+$(item).attr("field")+"']",
            name: $(item).attr("field"),
            defaultVal: $(item).attr("defaultVal"),
            valueField: $(item).attr("dictField"),
            textField: $(item).attr("dictText"),
            search: true,
            disabled: false,
            url: $(item).attr("fieldhref"),
            placeholder:{value:'',text:bt.lang("finacial.fcChargeType.notConsider")}
        });
    });

    //监听提交
    form.on('submit(submit)', function(data){
        var action = "/paramconfig/fcbusinessruledefine/modify";
        $.post(basePath + action,data.field,function(result){
        	parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            if(result.success){
            	$.each($(".layui-form"), function(){
                    this.reset();
                });
            	if(!bt.navtab){
                	parent.layer?parent.layer.closeAll():layer.closeAll();
            	}else{
                	bt.navtab.closeCurrent();
            	}
            }
        },'JSON');
        return false;
    });
});


	function addTr() {
		var form = bt.form();
		var tab = document.getElementById("dataTableTbody");
		var templateTable = document.getElementById("templateTable");
		var rowsCount = tab.rows.length+1;
		var lastTr = templateTable.rows.item(0);
		var newTr = tab.insertRow(rowsCount - 1);
		for (var i = 0; i < lastTr.cells.length; i++) {
			var newTd = newTr.insertCell(i);
			str = lastTr.cells.item(i).innerHTML;
			while (str.indexOf("[x]") > 0) {
				str = str.replace("[x]", "[" + (rowsCount - 1) + "]");
			}
			while (str.indexOf("init") > 0) {
				str = str.replace("init", "");
			}

			while (str.indexOf("template") > 0){
				str = str.replace("template", "vouchers");
			}
			newTd.innerHTML = str;
		}
		// form.render('select');//刷新下拉框
		// var groupName = "vouchers_" + index;
		bt.use(['form','moneyType','selectType','dicts'], function(){
		    var $ = bt.jquery,form = bt.form();
		    $.each($('.group-money'),function(i,item){
			    bt.moneyType.init({elem:$(this),decimal:0,minus:true});
		    });
			bt.selectType.init();
			bt.dicts.init();
		});

	}
	function remoTr(rowIndex) {
		var tab = document.getElementById("dataTableTbody");
		rowIndex = rowIndex - 1
		tab.deleteRow(rowIndex);
		//循环修改元素的名字
		for (var i = rowIndex; i < tab.rows.length; i++) {
			var tempTr = tab.rows.item(i);
			for (var x = 0; x < tempTr.cells.length; x++) {
				var tempTd = tempTr.cells.item(x);
				var strHTML = tempTd.innerHTML;
				while (strHTML.indexOf("[" + (i + 1) + "]") > 0) {
					strHTML = strHTML.replace("[" + (i + 1) + "]", "["
							+ i + "]");
				}
				// while (strHTML.indexOf("[" + (i) + "]") > 0) {
				// 	strHTML = strHTML.replace("[" + (i) + "]", "[" + (i - 1)
				// 			+ "]");
				// }

				while (strHTML.indexOf("_" + (i+1)) > 0) {
					strHTML = strHTML.replace("_" + (i+1), "_" + i);
				}

				// while (strHTML.indexOf("_" + (i)) > 0) {
				// 	strHTML = strHTML.replace("_" + (i), "_" + (i - 1));
				// }
				tempTd.innerHTML = strHTML;
			}
		}
		return false;
	}

</script>

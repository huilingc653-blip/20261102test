<body>
	<table id="templateTable">
		<!-- 模板 start 点击“增加明细”按钮时按照这列来生成下一行-->
		<tr id="template" style="display: none;">
			<td><input type="text" data-name="template[x].groupNums" name="template[x].groupNum" selectAttr="template_[x]" data-type="int" minus="false" class="layui-input group-money" maxlength="2" /></td>
			<td>
				<!-- <div type="list" field="template[x].summary" fieldHref="${basePath}/finacial/paramconfig/btsummary/json" dictField="id" dictText="summaryContent" defaultVal="$!{table.fcVoucherEntryDefine.summary}"></div> -->

				   onClick="remoTr(this.parentElement.parentElement.rowIndex)"><i
					class="layui-icon">&#xe640;</i></a></td>
		</tr>
		<!-- 模板 end -->
	</table>
	<form class="layui-form ignore-required-icon" method="post">
						<input id="id" name="id" type="hidden" value="$!{fcBusinessRuleDefinePage.id}">
			<table class="layui-table">
				<tr>

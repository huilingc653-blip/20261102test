<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="20%">#springMessage("finacial.paramconfig.fcCashItem.itemCode")</td>
            <td width="30%">
                <input type="text" name="likes_itemCode" autocomplete="off" class="layui-input" placeholder="#springMessage('finacial.paramconfig.fcCashItem.itemCode')">
            </td>
            <td class="textRight" width="20%">#springMessage("finacial.paramconfig.fcCashItem.itemName")</td>
            <td width="30%">
                <input type="text" name="likes_itemName" autocomplete="off" class="layui-input" placeholder="#springMessage('finacial.paramconfig.fcCashItem.itemName')">
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('finacial.paramconfig.fcCashItem.itemCode')</th>
        <th>#springMessage('finacial.paramconfig.fcCashItem.itemName')</th>
        <th>#springMessage('finacial.paramconfig.fcCashItem.rmk')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','datatable','corp'], function(){
        $ = bt.jquery,form = bt.form();
        bt.corp.init();
        //生成列表
        bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            checkbox:true,
            mulselect: false,
            ajax: {
                'url': basePath+"/finacial/paramconfig/cashItem/datatable"
            },searchForm:{
                formFilter:"search",
                formElem:"#searchForm"
            },
            columns: [
           		{data:"itemCode",bSortable:true,className:'center'},
           		{data:"itemName",bSortable:true,className:'center'},
                {data:"rmk",bSortable:true,className:'center'}
            ]
        });
    });

    /**
     * 返回选中数据
     * @returns {[]|null}
     */
    function getSelectData() {
        return bt.datatable.getSelectData("#appTable")[0];
    }
</script>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<table class="layui-table">
	<colgroup>
	<col width="20%">
	<col width="30%">
	<col width="20%">
	<col width="30%">
	</colgroup>
		<tr>
		##费用代码
			<td class="textRight">#springMessage('table.fcChargeType.chargeTypeCode')</td>
			<td>
			 <input type="text" name="eqs_chargeTypeCode" maxlength="4"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeType.chargeTypeCode')">
			</td>
			##费用名称
			<td  class="textRight">#springMessage("table.fcChargeType.chargeTypeName")</td>
			<td>
				<input type="text" name="likes_chargeTypeName"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeType.chargeTypeName')">
			</td>
		</tr>
		<tr>
			<td colspan="4" align="center">
				<button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
            	<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
            	<!-- <button class="layui-btn layui-btn-small" lay-submit="false" onClick="add()">#springMessage('common.button.add')</button> -->
			</td>
		</tr>
	</table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcChargeType.chargeTypeCode')</th>
        <th>#springMessage('table.fcChargeType.chargeTypeName')</th>
        <!-- <th>#springMessage('table.fcChargeType.curCode')</th>
        <th>#springMessage('table.fcChargeType.emergencySign')</th> -->
        <th>#springMessage('table.fcChargeType.charge')</th>
        <!-- <th>#springMessage('table.fcChargeType.difBank')</th>
        <th>#springMessage('table.fcChargeType.areaSign')</th> -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','datatable','moneyType'], function(){
        $ = bt.jquery,form = bt.form(),moneyFun = bt.moneyType.getFun();
        $.fn.serializeObject = function() {
            var o = {};
            var a = this.serializeArray();
            $.each(a, function() {
                if (o[this.name] !== undefined) {
                    if (!o[this.name].push) {
                        o[this.name] = [o[this.name]];
                    }
                    o[this.name].push(this.value || '');
                } else {
                    o[this.name] = this.value || '';
                }
            });
            return o;
        };
        //生成列表
        bt.datatable.init({
            elem: "#appTable",
            dom: 'rtlip',
            colReorder: true,
            order: [0,'asc'],
            ajax: {
                'url': basePath+"/paramconfig/fcchargetype/datatable"
            },
            searchForm:{
                formElem:"#searchForm",
                formFilter:"search"
            },
            buttons: [
                      {
                          text: bt.lang('common.button.add'),
                          action: function ( e, dt, node, config ) {
                              add();
                          }
                      }
                  ],
            columns: [
                {data:"chargeTypeCode",className:"center",bSortable:true},
                {data:"chargeTypeName",className:"center",bSortable:true},
                /* {data:"curCode",className:"center",bSortable:false},
                {data:"emergencySign",className:"center",bSortable:false,
                	render: function ( data, type, full, meta ) {
                        return bt.dict("emergency_sign",full.emergencySign);
                    }
                }, */
                {data:"charge",className:"center",bSortable:false,
                	render: function ( data, type, full, meta ) {
                		if(full.charge==null){
                			return '';
                		}else{
                        	return moneyFun.format(full.charge);
                		}
                    }
                },
                /* {data:"difBank",className:"center",bSortable:false,
                	render: function ( data, type, full, meta ) {
                        return bt.dict("nisBillhead.difBank",full.difBank);
                    }	
                },
                {data:"areaSign",className:"center",bSortable:false,
                	render: function ( data, type, full, meta ) {
                        return bt.dict("nisBillhead.areaSign",full.areaSign);
                    }	
                }, */
                {data:null,className:"center",bSortable:false,className:'center',render: function (data, type, full, meta) {
                    var html = '<a class="" href="#" data-row="'+meta.row+'" onclick="view(this)">#springMessage("common.button.view")</a>\
                    <a class="" href="#" data-row="'+meta.row+'" onclick="update(this)">#springMessage("common.button.edit")</a>\
                    <a class="" href="#" data-row="'+meta.row+'" onclick="del(this)">#springMessage("common.button.delete")</a>';
                    return html;
                }}
            ]

        });
    });
    function add(){
    	if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.add.data'),basePath + "/paramconfig/fcchargetype/add");
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['950px', '630px'],
            maxmin: true,
            content: basePath + "/paramconfig/fcchargetype/add",
            end:function(){
                //location.reload();
            }
        });
    }
    function view(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
    	if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.view.data'),basePath + "/paramconfig/fcchargetype/view/" + data.id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['950px', '630px'],
            maxmin: true,
            content: basePath + "/paramconfig/fcchargetype/view/" + data.id
        });
    }
    function update(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        if(bt.navtab){
            bt.navtab.addNavtab(bt.lang('common.update.data'),basePath + "/paramconfig/fcchargetype/update?id=" + data.id);
            return;
        }
        parent.layer.open({
            type: 2,
            area: ['950px', '630px'],
            maxmin: true,
            content: basePath + "/paramconfig/fcchargetype/update?id=" + data.id,
            end:function(){
                location.reload();
            }
        });
    }
    function del(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        parent.layer.confirm(bt.lang('common.message.confirm.delete'),function(){
            $.post(basePath + "/paramconfig/fcchargetype/delete/" + data.id, function(result){
                bt.datatable.refreshCurrentPage();
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },'JSON');
        });
    }
</script>
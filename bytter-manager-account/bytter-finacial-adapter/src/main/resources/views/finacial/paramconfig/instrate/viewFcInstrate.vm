<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<input id="exeDate" value="$!{fcInstratePage.exeDate}" type="hidden">
		<table class="layui-table">
			<tr>
				<td class="textRight">#springMessage('table.fc_instrate.subject_code')</td>
				<td>
				$!{fcInstratePage.subjectName}
				</td>
				<td class="textRight">#springMessage('table.fc_instrate.instrt_type')</td>
				<td>
					$dictTag.get('Common.InstrtType',$!{fcInstratePage.instrtType})
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.fc_instrate.old_instrate')</td>
				<td>
					<!-- $number.formatDoubleWithSix($!{fcInstratePage.oldInstrate})<span>%</span> -->
   					$rateTag.show($!{fcInstratePage.oldInstrate})
				</td>
				<td class="textRight">#springMessage('table.fc_instrate.interest_rate')</td>
				<td>
					<!-- $number.formatDoubleWithSix($!{fcInstratePage.interestRate})<span>%</span> -->
   					$rateTag.show($!{fcInstratePage.interestRate})
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.fc_instrate.exe_date')</td>
				<td>
					$!date.format('yyyy-MM-dd',$!{fcInstratePage.exeDate})
				</td>
				<td class="textRight">#springMessage('table.fc_instrate.end_unit')</td>
				<td>
					$dictTag.get('finacial.EndUnit',$!{fcInstratePage.endUnit})
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.fc_instrate.cur_code')</td>
				<td>
					$!{fcInstratePage.curName}
				</td>
				<td class="textRight">#springMessage('table.fc_instrate.status')</td>
				<td>
					$dictTag.get("valid_sign",$!{fcInstratePage.status})
				</td>
			</tr>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
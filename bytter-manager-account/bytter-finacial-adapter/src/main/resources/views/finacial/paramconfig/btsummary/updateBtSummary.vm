<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	<input id="id" name="id" type="hidden" value="$!{btSummaryPage.id}">
	<input id="createTime" name="createTime" type="hidden" value="$!{btSummaryPage.createTime}">
	<input id="createBy" name="createBy" type="hidden" value="$!{btSummaryPage.createBy}">
	<input id="updateTime" name="updateTime" type="hidden" value="$!{btSummaryPage.updateTime}">
	<input id="updateBy" name="updateBy" type="hidden" value="$!{btSummaryPage.updateBy}">
	<input id="summaryCode" name="summaryCode" type="hidden" value="$!{btSummaryPage.summaryCode}">
	<table class="layui-table">
		<tbody>
			<tr>
				<td class="textRight">#springMessage('finacial.paramconfig.btsummary.summaryContent'):</td>
				<td width="35%"> 
						<input type="text" id="summaryContent" name="summaryContent"
								 autocomplete="off" lay-verify="strlength" data-maxlength="80" class="layui-input" placeholder="#springMessage('finacial.paramconfig.btsummary.summaryContent')" value="$!{btSummaryPage.summaryContent}">
				</td>
				<!-- #if($!{btSummaryPage.summaryCode})
				<td>#springMessage('finacial.paramconfig.btsummary.summaryCode')</td>
				<td width="35%"> 
						<input type="text" id="summaryCode" name="summaryCode"
							   lay-verify="required"
								 autocomplete="off" readonly="readonly" class="layui-input" lay-verify="required" placeholder="#springMessage('finacial.paramconfig.btsummary.summaryCode')" value="$!{btSummaryPage.summaryCode}">
				</td>
				#end -->
				
				<td class="textRight">#springMessage('finacial.paramconfig.btsummary.rmk'):</td>
				<td width="35%"> 
						<input type="text" id="rmk" name="rmk"
						 autocomplete="off" lay-verify="strlength" data-maxlength="40" class="layui-input" placeholder="#springMessage('finacial.paramconfig.btsummary.rmk')" value="$!{btSummaryPage.rmk}">
				</td>
				
			</tr>
		
			<tr>
				<td class="textRight">#springMessage('table.fbsItem.validSign'):</td>
				<td width="35%"> 
					<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{btSummaryPage.validSign}" data-name="validSign" data-biz-name="validSign"></div>
				</td>
				
			
				<td class="textRight">#springMessage('finacial.paramconfig.btsummary.usingtype'):</td>
				<td width="35%"> 
						<input type="text" id="usingtype" name="usingtype"
						 autocomplete="off" class="layui-input" placeholder="#springMessage('finacial.paramconfig.btsummary.usingtype')" value="$!{btSummaryPage.usingtype}">
				</td>
			
			</tr>
			<tr>
			<tr>
				<td colspan="8" style="text-align: center;">
                	<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage("common.button.submit")</button>
               		<button type="reset" class="layui-btn layui-btn-primary">#springMessage("common.button.reset")</button>
           		</td>
       		</tr>
   		 </tbody>
	</table>
</form>
#parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','layedit','dicts'], function(){
		var $ = bt.jquery,form = bt.form();
		bt.dicts.init();
		//监听提交
        form.on('submit(submit)', function(data){
        	bt.loading.show();//显示加载中
            var action = "/finacial/paramconfig/btsummary/modify";
            $.post(basePath + action,data.field,function(result){
                if(result.success){
                    parent.layer?parent.layer.closeAll():layer.closeAll();
                }
                bt.loading.hide(); //关闭加载中
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            },'JSON');
            return false;
        });

	});
</script>
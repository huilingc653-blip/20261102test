<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tr>
				<td class="textRight">#springMessage('table.fcBusinessRuleDefine.netId'):</td>
				<td>
					$!{fcOtherBusinessRuleDefinePage.netId}
				</td>
				<td class="textRight">#springMessage('table.fcBusinessRuleDefine.sysRaceName'):</td>
				<td>
					$!{fcOtherBusinessRuleDefinePage.sysRaceCode}
				</td>
            </tr>
			<tr>
				<td class="textRight">规则编码</td>
				<td>
					$!{fcOtherBusinessRuleDefinePage.code}
				</td>
				<td class="textRight">规则名称</td>
				<td>
					$!{fcOtherBusinessRuleDefinePage.name}
				</td>
			</tr>
            <tr>
				<td class="textRight">收支标识:</td>
				<td>
					$dictTag.get('btBankAccDtl.cdSign',$!{fcOtherBusinessRuleDefinePage.cdSign})
				</td>
            	<td class="textRight">#springMessage('table.fcBusinessRuleDefine.curCode'):</td>
            	<td>
            		$!{fcOtherBusinessRuleDefinePage.curCode}
            	</td>
            </tr>
            <tr>
            	<td class="textRight">#springMessage('table.fcBusinessRuleDefine.voucherType')</td>
				<td>
					$!{fcOtherBusinessRuleDefinePage.voucherType}
        		</td>
            	<td class="textRight">#springMessage('table.fcBusinessRuleDefine.validSign'):</td>
            	<td>
            		$dictTag.get('sf_yn',$!{fcOtherBusinessRuleDefinePage.validSign})
            	</td>
            </tr>
		</table>
		<table id="dataTable" class="layui-table">
			<thead>
				<tr>
					<th>#springMessage('table.fcVoucherEntryDefine.groupNum')</th>
					<th>#springMessage('table.fcVoucherEntryDefine.summary')</th>
					<th>#springMessage('table.fcVoucherEntryDefine.balanceWay')</th>
					<th>#springMessage('table.fcVoucherEntryDefine.subjectCode')</th>
					<th>#springMessage('table.fcAcc.blnctrAcc')</th>##内部账号
					<!-- <th>#springMessage('table.fcVoucherEntryDefine.voucherType')</th> -->
					<th>#springMessage('table.fcVoucherEntryDefine.entryType')</th>
				</tr>
			</thead>
			<tbody>
				#foreach($entryDefine in $!{fcOtherBusinessRuleDefinePage.vouchers})
					#set($vcount = $velocityCount - 1)
				<tr>
					<td>$!{entryDefine.groupNum}</td>
					<td>$!{entryDefine.summary}</td>
					<td>$dictTag.get('Admin.BalanceWay',$!{entryDefine.balanceWay})</td>
					<td>$!{entryDefine.subjectName}</td>
					<td>$!{entryDefine.blnctrAcc}</td>
					<!-- <td>$!{entryDefine.voucherName}</td> -->
					<td>$dictTag.get('Finacial.EntryType',$!{entryDefine.entryType})</td>
				</tr>
				#end

				<tr id="matchContentTr">
					##匹配规则
					<td colspan="5">
						<table class="layui-table layui-table-border" width="100%" id="matchContentTable">
							<tr style="background:#c6c6c6;">
								<td colspan="6">#springMessage('table.netbank.nisproject.matchContent')</td>
							</tr>
							<tr>
								<td class="textCenter" width="20%">#springMessage('table.bvPrintMatchRule.matchRule')</td>
								<td class="textCenter" width="5%">#springMessage('table.symbol.brackets')</td>
								<td class="textCenter" width="20%">#springMessage('table.netbank.nisproject.matchAttr')</td>
								<td class="textCenter" width="20%">#springMessage('table.netbank.nisproject.matchRelation')</td>
								<td class="textCenter" width="20%">#springMessage('table.netbank.nisproject.matchContent')</td>
								<td class="textCenter" width="5%">#springMessage('table.symbol.brackets')</td>
							</tr>
							#foreach($nisBusTypeRuleVO in $!{nisBusTypeRuleVOList})
								<tr>
									<td class="textCenter">
										$dictTag.get("FUNDWARN_NUM_OPERATOR",$!{nisBusTypeRuleVO.matchRule})
									</td>
									<td class="textCenter">
										$!{nisBusTypeRuleVO.leftParenthesis}
									</td>
									<td class="textCenter">
										$dictTag.get("nisBusTypeRule.matchElements",$!{nisBusTypeRuleVO.matchElements})
									</td>
									<td class="textCenter">
										$dictTag.get("nisBusTypeRule.matchRelations",$!{nisBusTypeRuleVO.matchRelations})
									</td>
									<td class="textCenter">
										$!{nisBusTypeRuleVO.matchContent}
									</td>
									<td class="textCenter">
										$!{nisBusTypeRuleVO.rightParenthesis}
									</td>
								</tr>
							#end
						</table>
					</td>
				</tr>
			</tbody>
		</table>				
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
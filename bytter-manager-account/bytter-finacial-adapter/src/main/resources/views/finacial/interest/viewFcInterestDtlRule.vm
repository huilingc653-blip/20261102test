<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight" width="30%">#springMessage('table.fcInterestDtlRule.bankTypeId')</td>
            <td>
                $!{interestDtlRule.bankName}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcInterestDtlRule.remark')</td>
            <td>
                $!{interestDtlRule.remark}
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcInterestDtlRule.transTime')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{interestDtlRule.transTime})
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcInterestDtlRule.validSign')</td>
            <td>
                $dictTag.get("fcInterestDtlRule.validSign","$!{interestDtlRule.validSign}")
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<input id="isPool" type="hidden" value="$!{isPool}">
	<input id="eqs_generateMode" name="eqs_generateMode" type="hidden" value="I">
	<table class="layui-table">
		<tbody>
			<tr>
				##网点
				<td class="textRight">#springMessage('table.fcAcc.netId')</td>
				<td width="25%">
					<div class="layui-inline">
						<div class="bt-biz-interestCorp"
							 data-biz-type="net"
							 data-type="selectTree"
							 data-name="eqs_netId"
							 data-biz-name="eqs_netId"
							 data-group="corpGroup"
							 data-change="ins_corpId"
							 data-resource="finacial:interest:single:query"
							 data-scope="net"></div>
					</div>
				</td>
				##开户单位
				<td class="textRight">#springMessage('table.fcAcc.corpId')</td>
				<td width="25%">
					<div class="layui-inline">
						<div class="bt-biz-interestCorp"
							 data-tree-type="check"
							 data-biz-type="corp"
							 data-type="selectTree"
							 data-name="ins_corpId"
							 data-lazyload="false"
							 data-biz-name="ins_corpId"
							 #*data-tips="#springMessage('common.placeholder.select')#springMessage('table.fcAcc.netId')"*#
							 data-group="corpGroup"
							 data-resource="finacial:interest:single:query"
							 data-scope="all"></div>
					</div>
				</td>
				<!--计息日期 -->
				<td class="textRight">#springMessage('table.interet.blnInstDate')</td>
				<td width="40%">
					<input type="text" name="ged_blnInstDate" data-biz-name="ged_blnInstDate" data-type="date"
						   class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_blnInstDate"
						   value="">
					<span class="date-mid">~</span>
					<input type="text" name="led_blnInstDate" data-biz-name="led_blnInstDate" data-type="date"
						   class="layui-input bt-input-inline bt-biz-dateType" id="led_blnInstDate"
						   value="">
				</td>
			</tr>
			<tr>
				<!-- 开户种类 -->
				<td class="textRight">#springMessage('finacial.paramConfig.fcSubject.accType')</td>
				<td width="40%">
					<div class="layui-input-inline">
						<div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType"  data-name="eqs_accType" data-displayData="01,05,03,08"></div>
					</div>
				</td>
				<!-- 帐号 -->
				<td class="textRight">#springMessage('table.fcAccuBalance.account')</td>
				<td width="40%">
					<input type="text" name="likes_account" class="layui-input bank">
				</td>

				<!--起息日期 -->
				<td class="textRight">#springMessage('table.fcAccbookHis.interestStartDate')</td>
				<td width="40%">
					<input type="text" name="ged_interestStartDate" data-biz-name="ged_interestStartDate" data-type="date"
						   class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_interestStartDate"
						   value="">
					<span class="date-mid">~</span>
					<input type="text" name="led_interestStartDate" data-biz-name="led_interestStartDate" data-type="date"
						   class="layui-input bt-input-inline bt-biz-dateType" id="led_interestStartDate"
						   value="">
				</td>
			<tr>
				<td colspan="6" align="center">
					<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
	<thead>
	<tr>
		<th>#springMessage('table.fcInterestDtl.account')</th>
		<th>#springMessage('table.nisPersonnelDetail.accName')</th>
		<th>#springMessage('table.fbsBudgetDetail.curId')</th>
		<th>#springMessage('table.fcPredrawDtlTemp.interestTime')</th>
		<th>#springMessage('table.fcInterestDtl.interestStartDate')</th>
		<th>#springMessage('table.interet.blnInstDate')</th>
		<th>#springMessage('table.fcInterestDtl.days')</th>
		<th>#springMessage('table.fcInterestDtl.cumulation')</th>
		<th>#springMessage('table.fcInterestDtl.interestRate')</th>
		<th>#springMessage('table.fcInterestDtl.interest')</th>
		<th id="aa">#springMessage('table.fcInterestDtl.interestSign')</th>
	</tr>
	</thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/single/tda/fcInterestSingleAll.list.js?_btv=${resourceVersion}"></script>
</html>
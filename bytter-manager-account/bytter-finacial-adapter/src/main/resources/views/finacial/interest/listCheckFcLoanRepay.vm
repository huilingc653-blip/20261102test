<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm"  class="layui-form">
<table class="layui-table">
	<tr>
	##网点单位
		<td class="textRight">#springMessage('table.fcloanrepay.netId')</td>
		<td><div class="layui-input-inline">
                			<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-name="eqs_corpId"
                            data-scope="all"
                            data-resource="finacial:interest:fcloanrepay:check"
                            placeholder="#springMessage('table.cmsLoanInfo.corpId')"></div>
							</div></td>
		<td class="textRight">#springMessage('table.fcloanrepay.curCode')</td>
		<td>
			<div class="bt-biz-selectType" data-biz-name="curCode" data-url="${basePath}/basic/business/btcurrency/json" data-valuefield="id" data-textfield="curName" data-name="eqs_curCode" data-search="true"></div>
		</td>
	</tr>
	<tr>
		<td class="textRight">#springMessage('table.fcloanrepay.loanAcc')</td>
		<td>
		<input type="text" name="likes_loanAcc"
		                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcloanrepay.loanAcc')">
		</td>
		<td class="textRight">#springMessage('table.fcloanrepay.status')</td>
		<td>
		<div class="layui-input-inline">
			<select name="eqi_status">
				<option value="">#springMessage('common.placeholder.all')</option>
				<option value="0">#springMessage('common.button.temp')</option>
				<option value="-1">#springMessage('common.button.back')</option>
			</select>
			</div>
		</td>
	</tr>
	<tr>
		<td colspan="6" align="center">
		<button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
		<button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
		</td>
	</tr>
</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcAcc.netId')</th><!--网点  -->
        <th>#springMessage('table.fcloanrepay.corpName')</th><!--单位名称  -->
        <th>#springMessage('table.fcloanrepay.busType')</th><!--业务类型  -->
        <th>#springMessage('table.cmsLoanSend.loanAcc')</th><!--贷款账号  -->
        <th>#springMessage('table.fcAcc.accName')</th><!--账户名称  -->
        <th>#springMessage('table.fcAcc.curId')</th><!--币别  -->
        <th>#springMessage('table.fcloanrepay.needInterestAcc')</th><!--应收利息账号  -->
        <th>#springMessage('table.cmsLoanRepay.repayAcc')</th><!--还款账号  -->
        <th>#springMessage('table.fcloanrepay.repayType')</th><!--还款类型  -->
        <th style="text-align: center">#springMessage('table.fcLessPayBill.interest')</th><!--利息  -->
        <th>#springMessage('table.fcloanrepay.enterDate')</th><!--经办日期  -->
        <th>#springMessage('table.fcloanrepay.status')</th><!--状态  -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/fcLoanRepayCheck.list.js?_btv=${resourceVersion}"></script>
</html>
        		

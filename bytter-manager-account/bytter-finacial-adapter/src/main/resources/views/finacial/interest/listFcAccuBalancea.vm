<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<!-- 利息管理调整积数 -->
<form id="searchForm"  class="layui-form">
<table class="layui-table">
	<tbody>
	
		<tr>
			<!-- 网点 -->
			<td class="textRight">#springMessage('table.fcAcc.netId')</td>
			<td width="40%"><div class="bt-biz-corp" data-name="eqs_netId" data-scope="net"  data-biz-type="net" data-type="selectTree" data-resource="finacial:accubalancea:query"></div></td>
		
			<!-- 账号 -->
			<td class="textRight">#springMessage('table.fcAccuBalance.account')</td>
			<td width="40%"><input class="layui-input" name="likes_account" type="text"  id="account"/></td>	
		</tr>
		
		<tr>
			<!-- 日期 -->
			<td class="textRight">#springMessage('table.fcAccuBalance.balanceDate')</td>
			<td width="40%">
	  	 		<div class="layui-inline">
	    			<input name="ged_balanceDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="t2"  type="text">
  						<span class="date-mid">~</span>
    				<input name="led_balanceDate" class="layui-input bt-input-inline bt-biz-dateType" id="t2" type="text">
				</div>
	  	 	   
		 	</td>
		  
			<!-- 科目 -->
			<td class="textRight">#springMessage('fcInstrate.subjectCode')</td>
	    	<td width="40%">
	    	 	<div class="layui-form">
	     			<div class="bt-biz-dict" data-type="select" data-name="eqs_subjectSort" data-group="Admin.SubjectSort" data-biz-name="demo.dict"></div>
	     		</div>
	   		</td>
		</tr>

		<tr>
	  		<!-- 币别 -->
	  		<td class="textRight">#springMessage('table.fcAcc.curId')</td>
	  	 	<td width="40%">
                    <div class="layui-inline">
                        <div type="list" field="eqs_curCode" name = "eqs_curId" fieldHref="${basePath}/basic/business/btcurrency/json" dictField="id" dictText="curName" ></div>
                    </div>
         	</td>
         	
         	<!-- 计息标志 -->
			<td class="textRight">#springMessage('table.fcInterestDtl.interestSign')</td>
		 	<td width="40%">
	    		 <div class="layui-form">
	     			<div class="bt-biz-dict" data-type="select" data-name="eqs_interestSign"  data-group="Balance.InterestSign" data-biz-name="Admin.InterestSign"></div>
	     		</div>
	     	</td>
	   </tr>
	   	
		<!--按钮组-->
		<tr>
	  		<td style="text-align: center;" colSpan="6">
	 			 <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
            	 <button type="reset" class="layui-btn layui-btn-primary" >#springMessage('common.button.reset')</button>
	  	 	</td>
		</tr>
	
</tbody>
</table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
  <thead>
    <tr>
        <th>#springMessage('table.fcAccuBalance.account')</th>
       	<th>#springMessage('table.fcAcc.accName')</th>
        <th>#springMessage('table.fcAccuBalance.balanceDate')</th>
        <th>#springMessage('table.fcAccuBalance.todaycumu')</th>
        <th>#springMessage('table.fcAccuBalance.adjustCumu')</th>
        <th>#springMessage('table.fcAccuBalance.interestSign')</th>
        <th>#springMessage('table.fcAccuBalance.interestTime')</th>
        <th>#springMessage('table.fcAccuBalance.preSign')</th>
    </tr>
  </thead>
</table>

#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/fcAccuBalancea.list.js?_btv=${resourceVersion}"></script>
</html>

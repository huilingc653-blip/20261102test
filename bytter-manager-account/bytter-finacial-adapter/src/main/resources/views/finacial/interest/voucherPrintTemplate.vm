<div id="print">
#if($sum>0)
#foreach($voucher in $voucherInfos)
    #set($index = $velocityCount)
#foreach($accbook in $voucher.voucherInfo)
<div id="voucherInfo_${index}">
<div class="print-list">
##凭证头部
    <div class="print-header">
    ##记账凭证
        <div style="text-align:center;">
            <div class="print-header-name">#springMessage('table.fcAccbook.tallyTitle')</div>
        </div>
##        #if($!{voucher.accbook.voucherState} =="B")
##            <div style="float:right;">
##                <label align="right" style="color: #ff0000;font-weight:bold; ">#springMessage('table.fcAccbook.invalidFlag')</label>
##            </div>
##        #end
    </div>
##凭证内容
    <div class="print-body">
        <table style="width: 100%; " class="print-body-header">
            <tr>
            ##业务种类
                <td width="33%" align="left"></td>
            ##币别
                <td width="33%" align="left"></td>
            ##附件数
                <td width="33%" align="left" >
                    <div style="display: inline-block;width:80px;text-align: right">
                        #springMessage('table.fcAccbook.affixAmount')：
                    </div>
                    <span style="width:50%" id="affixAmount">$!{accbook.affixAmount}</span>
                </td>
            </tr>
            <tr>
            ##业务种类
                <td width="33%"></td>
            ##币别
                <td width="33%"></td>
            ##附件数
                <td width="33%" align="left">
                    <div style="width:60%;display: inline-block;">
                        <div style="display: inline-block;width:80px;text-align: right" >#springMessage('table.fcAccbook.busRaceId')：</div>
                        <span id="busRaceId">$!{accbook.busRaceName}</span>
                    </div>&nbsp;&nbsp;<!-- 业务种类 -->
                    <div style="width:30%;display: inline-block;" >
                        #springMessage(
                        'table.fcChargeType.curCode')：<span id="curCode">$!{accbook.fcAccbookDtls[0].fcAcc.curName}</span></div>
                    <!-- 币别 -->
                </td>
            </tr>
            <tr>
            ##业务种类
                <td width="33%" align="left" >#springMessage('table.fcAccbook.orderNo')：<span id="orderNo">$!{accbook.orderNo}</span></span><!-- 流水号 -->
                </td>
            ##币别
                <td width="33%" align="left" >
                    <!-- 制单日期 -->
                    #springMessage(
                    'table.bisAccBal.createDate')：<span id="createDate">$!date.format('yyyy-MM-dd',$!accbook.enrolTime)</span>
                </td>
            ##附件数
                <td width="33%" align="left">
                    <div style="display: inline-block;width:80px;text-align: right">
                        #springMessage(
                            'table.fcAccbook.voucherNo')：
                    </div>
                    <span id="voucherNo"></span><!-- 凭证号 -->
                </td>
            </tr>
        </table>
    ## 凭证表格数据
        <div id="listContainer">
            <table id="dataTable" style="width: 100%;table-layout:fixed;margin-left: -10px" class="layui-table breakRow">
            <colgroup>
                <col width="40px">
                <col width="80px">
                <col width="100px">
                <col width="100px">
                <col width="100px">
                <col width="40px">##6
                <col width="30px">
                <col width="30px">
                <col width="40px">
                <col width="80px">
                <col width="120px">
                <col width="120px">
                <col width="120px">
            </colgroup>
            <thead>
            <tr>
                <th style="text-align: center;max-width:300px;height: 40px;" colspan="3">#springMessage('table.fcAccbookDtl.summaryContent')</th><!-- 摘要 -->
                <th style="text-align: center;" colspan="2">#springMessage('table.intere.subjectAcc')</th><!--科目账号  -->
                <th style="text-align: center;" colspan="4">#springMessage('table.fcAcc.accName')</th><!--户名  -->
                <th style="text-align: center;" >#springMessage('table.fcAccbook.voucherType')</th><!--凭证种类  -->
                <th style="text-align: center;">#springMessage('table.interetDtl.oldVoucher')</th><!--原始凭证号码  -->
                <th style="text-align: center;">#springMessage('table.fcAccbookDtl.debitMoney')</th><!--借方发生额  -->
                <th>#springMessage('table.fcAccbookDtl.creditMoney')</th><!--贷方发生额  -->
            </tr>
            </thead>
            <tbody>
                #foreach($dtl in $accbook.fcAccbookDtls)
                <tr>
                    <td rowspan="2" colspan="3">$!{dtl.summaryContent}</td>
                    <td colspan=2 nowrap>$!{dtl.fcAcc.subjectName}</td>
                    <td rowspan="2" colspan="4"><div>$!{dtl.accName}</div></td>
                    <td rowspan="2" nowrap>$!{voucher.voucherTypeName}</td>
                    <td rowspan="2" nowrap>#if(${dtl.origVoucherNo}) $!{dtl.origVoucherNo} #end</td>
                    <td rowspan="2" colspan=1 align='right' class="money-color"
                        nowrap>$!number.formatNumeric($dtl.debitMoney)</td>
                    <td rowspan="2" align='right' class="money-color"
                        nowrap style="min-width: 120px;">$!number.formatNumeric($dtl.creditMoney)</td>
                </tr>
                <tr>
                    <td colspan=2 nowrap>$!{dtl.fcAcc.blnctrAcc}</td>
                </tr>
                #end
            <tr>
                <td nowrap rowspan="3">#springMessage('table.fcAccbook.rmk')</td><!--备注  -->
                <td nowrap>#springMessage('table.fcAccbook.tallyDate')</td><!--记账日期  -->
                <td nowrap><span>$!date.format('yyyy-MM-dd',$!accbook.tallyDate)</span></td>
                <td nowrap>#springMessage('table.fcInterestDtl.interestStartDate')</td><!--起息日期  -->
                <td nowrap colspan="1"><span>$!date.format('yyyy-MM-dd',$!accbook.tallyDate)</span></td>
                <td nowrap colspan="2">#springMessage('table.fcAccbook.emergencySign')</td><!--加急标志  -->
                <td colspan="2"><span class='control' ></span></td>
                <td align="right" colspan="2">#springMessage('table.interet.sum'):</td><!--合计  -->
                <td align='right'><span>$!number.formatNumeric($accbook.debitSum)</span></td>
                <td align='right'><span>$!number.formatNumeric($accbook.creditSum)</span></td>
            </tr>
            <tr>
                <td >#springMessage('table.nisBillhead.voucherTypeId')</td><!--付款方式  -->
                <td>&nbsp;</td>
                <td >#springMessage('table.fcAccbookExt.externalCorp')</td><!--外单位名称  -->#**#
                <td colspan="6">&nbsp;</td>
                <td >
                ####springMessage('table.fcAccbookExt.externalAcc')
                    外单位账号
                </td><!--外单位账号  -->
                <td colspan="2">&nbsp;</td>
            </tr>
            <tr>
                <td nowrap>#springMessage('table.fcAccbookExt.paysysbankcode')</td><!--开户行  -->
                <td colspan="7" nowrap></td>
                <td nowrap>#springMessage('table.fcAccbookExt.prov')</td><!--省份  -->
                <td colspan="1" nowrap></td>
                <td nowrap>#springMessage('table.fcAccbookExt.city')</td><!--城市  -->
                <td nowrap></td>
            </tr>
            <tr>
                <td></td>
                <td nowrap>#springMessage('table.fcAccbook.rmk')</td><!--备注  -->
                <td colspan=11 nowrap></td>
            </tr>
            </tbody>
        </table></div>
    </div>
</div>
</div>
    #end
    #end
#end
</div>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">
    function printVoucher() {
        var sumN = $("#sumN").val();
        var LODOP = getLodop();
        if (!LODOP) {
            return
        }
        var style = '<link rel="stylesheet" href="' + basePath + '/static/plugins/layui/css/layui.css" media="all" />';
        style += '<link rel="stylesheet" href="' + basePath + '/static/css/common.css" />';
        style += '<style>'
                + ' table.layui-table{border:1px solid #000!important;}'
                + ' table th {border:1px solid #000!important; height:20px;font-size: 12px!important;font-weight: 400!important;}'
                + ' table td {border:1px solid #000!important; font-size: 12px!important; line-height: 15px!important;min-height: 20px!important;}'
                + ' .center {text-align:center} .textLeft{text-align:left;} .left{text-align:left;}  .textRight{text-align:right;} .right{text-align:right;}table.layui-table *{font-family: "宋体"}'
                + ' </style>';

        LODOP.SET_PRINT_MODE("PRINT_PAGE_PERCENT", "Auto-Width");
        for (var i = 1; i <= sumN; i++) {
            LODOP.NewPageA();
            var tableHtml = $("#voucherInfo_"+ i).find('#listContainer').html();
            var printContainer = $("#voucherInfo_"+ i);
            if(i === 1){
                LODOP.ADD_PRINT_TEXT('2mm', '50%', '300', 100,printContainer.find('.print-header-name').text());
                LODOP.SET_PRINT_STYLEA(1, "FontSize", 22);
                LODOP.SET_PRINT_STYLEA(0, "FontName", "宋体");
                LODOP.SET_PRINT_STYLEA(1, "Bold", 1);
                // 文本框里 内容对于文本框居中
                LODOP.SET_PRINT_STYLEA(0, "Alignment", 2);
                // 打印项在纸张中水平居中
                LODOP.SET_PRINT_STYLEA(0, "Horient", 2);
                // 每一页都打印
                LODOP.SET_PRINT_STYLEA(0, "ItemType", 1);

            }

            // 表头信息
            //第一行
            LODOP.SET_PRINT_STYLEA(0, "ItemType", 1);
            LODOP.ADD_PRINT_TEXT('13mm', '3%', '60%', 100, '');
            LODOP.SET_PRINT_STYLEA(0, "FontName", "宋体");
            //LODOP.SET_PRINT_STYLEA(0, "Alignment", 2);
            LODOP.SET_PRINT_STYLEA(0, "ItemType", 1);
            LODOP.ADD_PRINT_TEXT('13mm', '45%', '20%', 100, '');
            LODOP.SET_PRINT_STYLEA(0, "FontName", "宋体");
            //LODOP.SET_PRINT_STYLEA(0, "Alignment", 2);
            LODOP.SET_PRINT_STYLEA(0, "ItemType", 1);
            LODOP.ADD_PRINT_TEXT('13mm', '70%', '20%', 100, bt.lang("table.fcAccbook.affixAmount") + ":"+$("#affixAmount").text());  // 附件数
            LODOP.SET_PRINT_STYLEA(0, "FontName", "宋体");

            //第二行
            LODOP.SET_PRINT_STYLEA(0, "ItemType", 1);
            LODOP.ADD_PRINT_TEXT('17mm', '3%', '80%', 100, '');   // 占位
            LODOP.SET_PRINT_STYLEA(0, "FontName", "宋体");
            //LODOP.SET_PRINT_STYLEA(0, "Alignment", 2);
            LODOP.SET_PRINT_STYLEA(0, "ItemType", 1);
            LODOP.ADD_PRINT_TEXT('17mm', '70%', '20%', 100, bt.lang("table.fcAccbook.busRaceId") + ":"+$("#busRaceId").text());   // 业务种类
            LODOP.SET_PRINT_STYLEA(0, "FontName", "宋体");
            //LODOP.SET_PRINT_STYLEA(0, "Alignment", 2);
            LODOP.SET_PRINT_STYLEA(0, "ItemType", 1);
            LODOP.ADD_PRINT_TEXT('17mm', '90%', '10%', 100, bt.lang("table.fcChargeType.curCode") + ":"+$("#curCode").text());  // 币别
            LODOP.SET_PRINT_STYLEA(0, "FontName", "宋体");

            //第三行
            LODOP.SET_PRINT_STYLEA(0, "ItemType", 1);
            LODOP.ADD_PRINT_TEXT('21mm', '3%', '60%', 100, bt.lang("table.fcAccbook.orderNo") + ':'+$("#orderNo").text());   // 流水号
            LODOP.SET_PRINT_STYLEA(0, "FontName", "宋体");
            //LODOP.SET_PRINT_STYLEA(0, "Alignment", 2);
            LODOP.SET_PRINT_STYLEA(0, "ItemType", 1);
            LODOP.ADD_PRINT_TEXT('21mm', '45%', '20%', 100, bt.lang("table.bisAccBal.createDate") + ":"+$("#createDate").text());   // 制单日期
            LODOP.SET_PRINT_STYLEA(0, "FontName", "宋体");
            //LODOP.SET_PRINT_STYLEA(0, "Alignment", 2);
            LODOP.SET_PRINT_STYLEA(0, "ItemType", 1);
            LODOP.ADD_PRINT_TEXT('21mm', '70%', '20%', 100, bt.lang("table.fcAccbook.voucherNo") + ":"+$("#voucherNo").text());  // 凭证号
            LODOP.SET_PRINT_STYLEA(0, "FontName", "宋体");
            LODOP.SET_PRINT_STYLEA(0, "ItemType", 1);

            LODOP.ADD_PRINT_TABLE(100,9, 'RightMargin:0mm', "BottomMargin:9mm",'<head>' + style + '</head><body>' + tableHtml + '</body>');
        }
        LODOP.PREVIEW();
    }
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
	<input type="hidden" name="id" value="$!{fcLoanRepayPage.id}">
	<table class="layui-table layui-table-border">
	<colgroup>
		<col width="15%">
   		<col width="18%">
   		<col width="15%">
   		<col width="18%">
   		<col width="15%">
   		<col width="19%">
	</colgroup>
		<thead>
		##详细信息
			<tr><td colspan="6" align="center">#springMessage('table.fcloanrepay.Info')</td></tr>
		</thead>
		<tbody>
			<tr>
				<td class="textRight">#springMessage('table.fcloanrepay.netId')</td>
				<td>$!{fcLoanRepayPage.corpName}</td>
				##贷款账号
				<td class="textRight">#springMessage('table.fcloanrepay.loanAcc')</td>
				<td>
					$!{fcLoanRepayPage.loanAcc}
				</td>
				##应收利息账号
				<td class="textRight">#springMessage('table.fclesspaybill.needinterestAcc')</td>
				<td>
					$!{fcLoanRepayPage.needInterestAcc}
				</td>
			</tr>
			<tr>
			##选择归还明细
				<td class="textRight">#springMessage("interet.button.selectDtl")</td>
				<td>
				</td>
				##贷款账户名称
				<td class="textRight">#springMessage('table.fcloanrepay.loanAccName')</td>
				<td>
				$!{fcLoanRepayPage.accName}
				</td>
				##应收利息账号户名
				<td class="textRight">#springMessage('table.fclesspaybill.needinterestAccName')</td>
				<td>
					$!{creditaccName}
				</td>
			</tr>
			<tr>
			##还款账号
				<td class="textRight">#springMessage('table.fcloanrepay.repayAcc')</td>
				<td>
					$!{fcLoanRepayPage.repayAcc}
				</td>
				##还款账号余额
				<td class="textRight">#springMessage('table.fcloanrepay.repayAccBal')</td>
				<td>
					$number.formatNumeric($!{checkBalance})
				</td>
				##利息
				<td class="textRight">#springMessage('table.fcLessPayBill.interest')</td>
				<td>
					$number.formatNumeric($!{fcLoanRepayPage.interest})
				</td>
			</tr>
			<tr>
			##记账日期
				<td class="textRight">#springMessage('table.fcloanrepay.tallyDate')</td>
				<td>
				$!date.format('yyyy-MM-dd',$!loanRepayPage.tallyDate)
				##凭证种类
				<td class="textRight">#springMessage('table.fcloanrepay.voucherType')</td>
				<td>
					<div class="bt-biz-selectType" data-biz-name="voucherType" data-url="${basePath}/netbank/fcvouchertype/json" data-valuefield="id" data-textfield="voucherName" data-search="true" data-disabled="true" data-name="voucherType" data-defaultvalue="$!{vourcherType}"></div>
				</td>
				<td></td>
				<td></td>
			</tr>
		</tbody>
	</table>

	<table class="layui-table layui-table-border">
		<thead>
			<tr align="center">
				<td>#springMessage('table.fcAccbookDtl.summaryContent')</td><!-- 摘要 -->
				<td>#springMessage('table.fcAcc.account')</td><!-- 账号 -->
				<!-- <td>#springMessage('table.fcloanrepay.oriVoucherNo')</td>原始凭证号 -->
				<td>#springMessage('table.fcloanrepay.debitMoney')</td><!-- 借方金额 -->
				<td>#springMessage('table.fcloanrepay.creditMoney')</td><!--贷方金额  -->
			</tr>
		</thead>
		<tbody>
			<tr id="voucher1">
				<td align="center" >
					$!{summaryContent}
				</td>
				<td align="center" >
					$!{fcLoanRepayPage.repayAcc}
				</td>
				<!-- <td align="center" >
				</td> -->
				<td align="center" >
					$number.formatNumeric($!{fcLoanRepayPage.interest})
				</td>
				<td align="center" >
					0.00
				</td>
			</tr>
			<tr id="voucher2">
				<td align="center" >
					$!{summaryContent}
				</td>
				<td align="center" >
					$!{lessPayBill.needinterestAcc}
				</td>
				<!-- <td align="center" >
				</td> -->
				<td align="center" >
					0.00
				</td>
				<td align="center" >
					$number.formatNumeric($!{fcLoanRepayPage.interest})
				</td>
			</tr>
			<tr>
				<td></td>
				<!-- <td></td> -->
				##合计
				<td class="textRight">#springMessage("table.interet.sum")</td>
				<td class="textRight">$number.formatNumeric($!{fcLoanRepayPage.interest}) </td>
				<td class="textRight">$number.formatNumeric($!{fcLoanRepayPage.interest})</td>
			</tr>
##			<tr>
##				<td class="textRight">#springMessage("table.cmsLoanInfo.refuseWhy")</td>
##				<td colspan="3">
##
##			</tr>
##			<tr>
##				<td colspan="4" align="center">
##						<button class="layui-btn" lay-submit="" value="0" lay-filter="submit">#springMessage('common.button.back')</button>
##						<button class="layui-btn" lay-submit="" value="1" lay-filter="submit">#springMessage('common.button.check')</button>
##				</td>
##			</tr>
		</tbody>
	</table>
	<table class="layui-table layui-table-border">
		<thead>
			##打回原因
		<tr><td align="center">#springMessage("table.cmsLoanInfo.refuseWhy")</td></tr>
		</thead>
		<tbody>
		<tr>
			<td width="100%">
				<textarea id="refuseWhy" name="refuseWhy" style="min-height:70px"
						  class="layui-textarea" placeholder="#springMessage('table.cmsLoanInfo.refuseWhy')"></textarea>
			</td>
		</tr>
		<tr>
			<td  align="center">
				<button class="layui-btn" lay-submit="" value="0" lay-filter="submit">#springMessage('common.button.back')</button>
				<button class="layui-btn" lay-submit="" value="1" lay-filter="submit">#springMessage('common.button.check')</button>
			</td>
		</tr>
		</tbody>
	</table>
</form>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/fcLoanRepay.check.js?_btv=${resourceVersion}"></script>
</html>

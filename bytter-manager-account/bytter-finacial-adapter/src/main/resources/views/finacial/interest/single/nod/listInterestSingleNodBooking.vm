<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位
            <td class="textRight" width="10%">#springMessage('table.interestSingleNod.corpId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="likes_corpId"
                         data-resource="finacial:interest:nod:booking:query"
                         data-scope="all"></div>
                </div>
            </td>
            ##付款账号
            <td class="textRight" width="10%">#springMessage('table.interestSingleNod.noticeAccount')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="eqs_noticeAccount" name="eqs_noticeAccount" lay-verify="tableData"
                           data-biz-name="eqs_noticeAccount"
                           autocomplete="off" class="layui-input text">
                    <table id="noticeAccountTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.nisBillhead.payerAcc')</th>
                            <th>#springMessage('table.nisBillhead.payerAccName')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
            ##金额
            <td class="textRight" width="10%">#springMessage('table.interestSingleNod.bookMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_bookMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           data-moneyendid="t20">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_bookMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           id="t20">
                </div>
            </td>
        </tr>
        <tr>
            ##日期区间
            <td class="textRight">#springMessage('table.interestSingleNod.bookDate')</td>
            <td>
                <input type="text" name="ged_bookDate" class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="endDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_bookDate" class="layui-input bt-input-inline bt-biz-dateType" id="endDate">
            </td>
            ##状态
            <td class="textRight">#springMessage('table.interestSingleNod.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select"
                     data-group="InterestSingleNodBook.status" data-name="eqi_status"></div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.interestSingleNod.billNo')</th>
        <th>#springMessage('table.interestSingleNod.corpId')</th>
        <th>#springMessage('table.interestSingleNod.noticeAccount')</th>
        <th>#springMessage('table.interestSingleNod.bookDate')</th>
        <th>#springMessage('table.interestSingleNod.bookMoney')</th>
        <th>#springMessage('table.interestSingleNod.purpose')</th>
        <th>#springMessage('table.interestSingleNod.noticeType')</th>
        <th>#springMessage('table.interestSingleNod.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/single/nod/interestSingleNodBooking.list.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            <td class="textRight">#springMessage('table.fcInterestDtlRule.bankTypeId')</td>
            <td width="40%">
                <div data-name="eqs_bankTypeId" class="bt-biz-selectType"
                     data-url="${basePath}/basic/business/btbanktype/json"
                     data-biz-name="eqs_bankTypeId"
                     data-valueField="id"
                     data-textField="typeName"
                     data-search="true"></div>
            </td>
            <td class="textRight">#springMessage('table.fcInterestDtlRule.validSign')</td>
            <td width="40%">
                <div class="bt-biz-dict" data-type="select" data-group="fcInterestDtlRule.validSign" data-name="eqs_validSign" data-biz-name="validSign"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcInterestDtlRule.bankTypeId')</th>
        <th>#springMessage('table.fcInterestDtlRule.remark')</th>
        <th>#springMessage('table.fcInterestDtlRule.transTime')</th>
        <th>#springMessage('table.fcInterestDtlRule.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/fcInterestDtlRule.list.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="fcInterestDtlRuleForm">
    <table class="layui-table">
        <tbody>
        <tr>
            ##银行类别
            <td class="textRight">#springMessage('table.fcInterestDtlRule.bankTypeId')</td>
            <td>
                <div class="layui-input-inline">
                    <div data-name="bankTypeId" class="bt-biz-selectType"
                         data-url="${basePath}/basic/business/btbanktype/json"
                         data-biz-name="bankTypeId"
                         data-valueField="id"
                         data-textField="typeName"
                         data-required="true"
                         data-search="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##用途/摘要
            <td class="textRight" width="30%">#springMessage('table.fcInterestDtlRule.remark')</td>
            <td>
                <input type="text" id="remark" name="remark" lay-verify="required|strlength" data-maxlength="80" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.fcInterestDtlRule.remark')">
            </td>
        </tr>
        <tr>
            ##入账日期
            <td class="textRight">#springMessage('table.fcInterestDtlRule.transTime')</td>
            <td>
                <input type="text" id="transTime" name="transTime" lay-verify="required" class="layui-input bt-input-inline bt-biz-dateType" autocomplete="off" placeholder="#springMessage('table.fcInterestDtlRule.transTime')">
            </td>
        </tr>
        <tr>
            ##状态
            <td class="textRight" width="15%">#springMessage('table.fcInterestDtlRule.validSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="fcInterestDtlRule.validSign" data-defaultvalue="1" data-name="validSign" data-biz-name="validSign" ></div>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/fcInterestDtlRule.add.js?_btv=${resourceVersion}"></script>
</html>
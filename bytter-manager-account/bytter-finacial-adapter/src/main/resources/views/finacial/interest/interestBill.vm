<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
     #page {
     	border:1px solid #d2d2d2;
     	border-top:none;
     	min-height:438px;
     	position:relative;
     }
     #page > .wrapper {
     	border:none;
     	border-top:1px solid #d2d2d2;
     	position:absolute;
     	bottom:0px;
     	width:100%;
     }
	 .dark-skin #page,
	 .dark-skin #page > .wrapper {
		 border-color: #2E2F34;
		 padding: 0;
	 }
     #page table thead tr th:first-child,#page table tbody tr td:first-child {
     	border-left:none!important;
     }
     #page table thead tr th:last-child,#page table tbody tr td:last-child {
     	border-right:none!important;
     }
     #page table.layui-table {
     	border-left:none!important;
     	border-right:none!important;
     	margin-bottom:100px;
     
     }
    
    </style>
    
</head>
<body>
<form id="searchForm" class="layui-form">
<div class="layui-row">
    <div class="layui-col-xs4" align="center" style="font-size: 15px;">$!{netName}</div>
</div>
<div class="layui-row">
    <div class="layui-col-xs4" align="center">#springMessage('table.fcChargeType.curCode')：#if($model.pageData) $!{model.pageData.get('CURNAME')} #end</div>
##    <div class="layui-col-xs4" align="center">#springMessage('table.nisBillhead.corpId')：#if($model.pageData) $!{model.pageData.get('CORPNAME')} #end</div>
    <div class="layui-col-xs4" align="center">#springMessage('table.interet.AccType')：#if($model.pageData) $dictTag.get("InnerAccount.AccType",$!{model.pageData.get('ACCTYPE')}) #end</div>
</div>
<div id="page">
<table id="jxTb" style='width:100%' class="layui-table">
	                    <thead id="detailThead">
	                        <tr>
	                            <th>#springMessage('table.fcAccuBalance.account')</th><!--账号  -->
	                            <th>#springMessage('table.fcAcc.accName')</th><!--户名  -->
                            	<th>#springMessage('table.fcInterestDtlTemp.interestStartDate')</th><!--起息日期  -->
                            	<th>#springMessage('table.fcInterestDtlTemp.blnInstDate')</th><!--结束日期  -->
	                            <th>#springMessage('table.fcInterestDtlTemp.days')</th><!--天数  -->
	                            <th>#springMessage('table.fcInterestDtlTemp.cumulation')</th><!--积数  -->
	                            <th>#springMessage('table.fcInterestDtlTemp.interestRate')</th><!--利率  -->
                            	<th>#springMessage('table.fcInterestDtlTemp.interest')</th><!--利息  -->
                            	<th>#springMessage('table.fcInterestDtlTemp.rateType')</th><!--利率类型  -->
	                            <th>#springMessage('table.fcInterestDtlTemp.interestType')</th><!--计息类型  -->
	                            <th>#springMessage('table.fcInterestDtlTemp.busStatus')</th><!--状态   -->
	                        </tr>
	                    </thead>
	                    <tbody id="detailTable">
	                    #if($model.interestDtls && $model.interestDtls.size()>0)
	                    	#foreach($interestDtl in $model.interestDtls)
	                    		<tr>
	                    			<td align="center" width="12%">$interestDtl.account</td>
	                    			<td align="center" width="12%">$interestDtl.accName</td>
	                    			<td align="center" width="9%">$!date.format('yyyy-MM-dd',$!interestDtl.interestStartDate)</td>
	                    			<td align="center" width="9%">$!date.format('yyyy-MM-dd',$!interestDtl.blnInstDate)</td>
	                    			<td align="center" width="8%">$interestDtl.days</td>
	                    			<td align="right" width="8%">$!number.formatNumeric($interestDtl.cumulation)</td>
	                    			<td align="center" width="8%">$rateTag.show($interestDtl.interestRate)</td>
	                    			<td align="right" width="8%">$!number.formatNumeric($interestDtl.interest)</td>
	                    			<td align="center" width="9%">$dictTag.get("interest.type",$!{interestDtl.interestType})</td>
	                    			<td align="center" width="9%">$dictTag.get("interest.sign",$!{interestDtl.interestSign})</td>
	                    			<td align="center" width="8%">$dictTag.get("interest.busStatus",$!{interestDtl.busStatus})</td>
	                    		</tr>
							#end
							<tr>
								<td colspan=6></td>
								<td></td>
								<td align=right>$!number.formatNumeric(${model.interestTot})</td>
								<td></td>
								<td></td>
								<td></td>
							  </tr>
							<tr>
								<td colspan=6 rowspan=2></td>
								<td rowspan=2>#springMessage('table.interet.vourcherfl')</td><!-- 凭证分录 -->
								<td colspan=4>$!{model.voucherInfo[0]}</td>
							  </tr>
							   <tr>
								<td colspan=4>&nbsp;&nbsp;&nbsp;&nbsp;$!{model.voucherInfo[1]}</td>
							  </tr>
							  #else
							  <tr>
								<td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td>
								<td></td><td></td><td></td><td></td><td></td>
							  </tr>
							  <tr>
								<td>&nbsp;</td><td></td><td></td><td></td><td></td><td></td>
								<td></td><td></td><td></td><td></td><td></td>
							  </tr>
							  <tr>
								<td colspan=6>&nbsp;</td><td></td><td></td><td></td><td></td><td></td>
							  </tr>
							  <tr>
								<td colspan=6 rowspan=2>&nbsp;</td>
								<td rowspan=2>#springMessage('table.interet.vourcherfl')</td><!-- 凭证分录 -->
								<td colspan=4>&nbsp;</td>
							  </tr>
							   <tr>
								<td colspan=4>&nbsp;</td>
							  </tr>
							  #end
	                    </tbody>
	                </table>
	                </div>
</form>	                
#parse("views/common/footer.vm")
</body>
<input type="hidden" id="total" value="$!{model.total}">
<input type="hidden" id="curr" value="$!{model.curr}">
<input type="hidden" id="opType" value="$!{model.opType}">
<input type="hidden" id="pageType" value="$!{model.pageType}">
<input type="hidden" id="netId" value="$!{model.netId}">
<input type="hidden" id="accType" value="$!{model.accType}">
<input type="hidden" id="endInstDate" value="$!{model.endInstDate}">
<input type="hidden" id="tallyDate" value="$!{model.tallyDate}">
<input type="hidden" id="poolSign" name="poolSign" value="$!{model.poolSign}">
<script src="${basePath}/static/modules/finacial/interest/interestBill.js?_btv=${resourceVersion}"></script>
</html>
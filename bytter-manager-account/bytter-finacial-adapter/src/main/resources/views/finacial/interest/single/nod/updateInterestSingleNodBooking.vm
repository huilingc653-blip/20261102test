<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{interestSingleNodBookVO.id}">
		<input id="status" name="status" type="hidden" value="$!{interestSingleNodBookVO.status}">
		<input id="noticeAccountId" name="noticeAccountId" type="hidden" value="$!{interestSingleNodBookVO.noticeAccountId}">
        <input id="capitalAccId" name="capitalAccId" type="hidden" value="$!{interestSingleNodBookVO.capitalAccId}">
        <input id="interestAccId" name="interestAccId" type="hidden" value="$!{interestSingleNodBookVO.interestAccId}">
        <input id="curId" name="curId" type="hidden" value="$!{interestSingleNodBookVO.curId}">

        <input type="hidden" id="createBy" name="createBy" value="$!{interestSingleNodBookVO.createBy}">
        <input type="hidden" id="createDate" name="createDate" value="$!{interestSingleNodBookVO.createDate}">
        <input type="hidden" id="updateBy" name="updateBy" value="$!{interestSingleNodBookVO.updateBy}">
        <input type="hidden" id="updateDate" name="updateDate" value="$!{interestSingleNodBookVO.updateDate}">
        <input type="hidden" id="defaultCorpId" value="$!{interestSingleNodBookVO.corpId}">


        <div class="layui-collapse" lay-filter="collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.choInnerFinance.noticeInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table">
                        <tbody>
                        <tr>
                            ##单位ID
                            <td class="textRight" width="10%">#springMessage('table.interestSingleNod.corpId')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <div class="bt-biz-corp"
                                         data-biz-type="corp"
                                         data-type="selectTree"
                                         data-name="corpId"
                                         data-scope="all"
                                         data-defaultvalue="$!{interestSingleNodBookVO.corpId}"
                                         data-required="true"
                                         data-resource="finacial:interest:nod:booking:query"
                                         data-callback="bt.corpCallback"></div>
                                </div>
                            </td>
                            ##付款账号
                            <td class="textRight" width="10%">#springMessage('table.interestSingleNod.noticeAccount')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="noticeAccount" name="noticeAccount" lay-verify="required|tableData"
                                           data-biz-name="noticeAccount" value="$!{interestSingleNodBookVO.noticeAccount}"
                                           autocomplete="off" class="layui-input text">
                                    <table id="noticeAccountTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.nisBillhead.payerAcc')</th>
                                            <th>#springMessage('table.nisBillhead.payerAccName')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##通知类型
                            <td class="textRight">#springMessage('table.interestSingleNod.noticeType')</td>
                            <td >
                                <input type="hidden" id="noticeType" name="noticeType" readonly="readonly" autocomplete="off" class="layui-input text" value="$!{interestSingleNodBookVO.noticeType}">
                                <div class="bt-biz-dict" data-type="select" data-group="fcAcc.notifyType" data-disabled="true" data-defaultvalue="$!{interestSingleNodBookVO.noticeType}" data-name="noticeTypeShow" data-biz-name="noticeTypeShow"></div>
                            </td>
                            ##存款金额
                            <td class="textRight">#springMessage('table.interestSingleNod.balance')</td>
                            <td width="40%">
                                <input type="text" id="balance" name="balance" style="text-align:right" data-name="balance" data-biz-name="balance" value="$!{interestSingleNodBookVO.balance}"
                                       autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.choInnerFinance.depositMoney')" readonly="readonly">
                            </td>
                        </tr>
                        <tr>
                            ##存款利率
                            <td class="textRight">#springMessage('table.interestSingleNod.interestRate')</td>
                            <td >
                                <input type="text" id="interestRate" name="interestRate" style="text-align:right" data-name="interestRate" data-biz-name="interestRate" value="$!{interestSingleNodBookVO.interestRate}"
                                       autocomplete="off" class="layui-input bt-biz-rateType" placeholder="#springMessage('table.eTransBill.depositRate')" readonly="readonly">
                            </td>
                            ##起息日期
                            <td class="textRight">#springMessage('table.interestSingleNod.interestStartDate')</td>
                            <td >
                                <input type="text" id="interestStartDate" name="interestStartDate" data-name="interestStartDate" data-biz-name="interestStartDate" readonly="readonly"
                                       class="layui-input bt-biz-dateType" data-type="date" value="$date.format("yyyy-MM-dd", $!{interestSingleNodBookVO.interestStartDate})" >
                            </td>
                        </tr>
                        </tbody>
                    </table>
				</div>
			</div>
		</div>
        <div class="layui-collapse" lay-filter="collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.choInnerFinance.bookInfo')</h2>
                <div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
                        <tr>
                            ##预约日期
                            <td class="textRight">#springMessage('table.interestSingleNod.bookDate')</td>
                            <td >
                                <div class="layui-input-inline">
                                    <input type="text" id="bookDate" name="bookDate" data-name="bookDate" data-biz-name="bookDate" lay-verify="required" class="layui-input bt-biz-dateType"
                                           data-today="true" data-type="date" data-min="$!{sysDate}" data-callback="bt.bookMoneyCallback" value="$date.format("yyyy-MM-dd", $!{interestSingleNodBookVO.bookDate})">
                                </div>
                            </td>
                            <td class="textRight">#springMessage('table.interestSingleNod.billNo')</td>
                            <td>
                                <input type="text" id="billNo" name="billNo" lay-verify="required" readonly="readonly" class="layui-input bt-input-inline " value="$!{interestSingleNodBookVO.billNo}">
                            </td>
                        </tr>
						<tr>
                        <tr>
							##预约金额（小写）
                            <td class="textRight">#springMessage('table.choInnerFinance.orderMoney.lower')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="text" id="bookMoney" name="bookMoney" style="text-align:right" lay-verify="required" data-name="bookMoney" data-biz-name="bookMoney" data-toUp="bookMoneyUp"
                                           value="$!{interestSingleNodBookVO.bookMoney}"
                                           autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.choInnerFinance.orderMoney.lower')" data-callback="bt.bookMoneyCallback">
                                </div>
                            </td>
							##预约金额（大写）
                            <td class="textRight">#springMessage('table.choInnerFinance.orderMoney.upper')</td>
                            <td width="40%" style="padding-left:0px">
                                <div id="bookMoneyUp"></div>
                            </td>
                        </tr>
						<tr>
							##本金转入账号
                            <td class="textRight">#springMessage('table.choInnerFinance.capitalAcc')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="text" id="capitalAcc" name="capitalAcc" data-biz-name="capitalAcc" lay-verify="required|tableData"
                                           value="$!{interestSingleNodBookVO.capitalAcc}"
                                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.choInnerFinance.capitalAcc')">
                                    <table id="capitalAccTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.choBankFinance.acc')</th>
                                            <th>#springMessage('table.choBankFinance.accName')</th>
                                            <th>#springMessage('table.choBankFinance.curId')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </div>
                            </td>
							##本金转入账户名称
							<td class="textRight">#springMessage('table.choInnerFinance.capitalAccName')</td>
							<td >
                                <input type="text" id="capitalAccName" name="capitalAccName" lay-verify="required" readonly="readonly" style="width:300px;"
                                       value="$!{interestSingleNodBookVO.capitalAccName}"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.choInnerFinance.capitalAccName')">
							</td>
						</tr>
                        <tr>
							##利息转入账号
                            <td class="textRight">#springMessage('table.choInnerFinance.interestAcc')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="text" id="interestAcc" name="interestAcc" data-biz-name="interestAcc" lay-verify="required|tableData"
                                           value="$!{interestSingleNodBookVO.interestAcc}"
                                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.choInnerFinance.interestAcc')">
                                    <table id="interestAccTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.choBankFinance.acc')</th>
                                            <th>#springMessage('table.choBankFinance.accName')</th>
                                            <th>#springMessage('table.choBankFinance.curId')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </div>
                            </td>
							##利息转入账户名称
                            <td class="textRight">#springMessage('table.choInnerFinance.interestAccName')</td>
                            <td>
                                <input type="text" id="interestAccName" name="interestAccName" lay-verify="required" readonly="readonly" style="width:300px;"
                                       value="$!{interestSingleNodBookVO.interestAccName}"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.choInnerFinance.interestAccName')">
                            </td>
                        </tr>
						<tr>
							##预计利息
                            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.anticInterest')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="text" id="expectInterest" name="expectInterest" style="text-align:right" lay-verify="required" data-name="expectInterest" data-biz-name="expectInterest"
                                           value="$!{interestSingleNodBookVO.expectInterest}"
                                           autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.cmsProvideLoanInfo.anticInterest')" readonly="readonly">
                                </div>
                            </td>
							##用途
							<td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
							<td>
								<div class="layui-input-inline">
									<div class="bt-biz-selectType" data-url="${basePath}/basic/business/btpurpose?getByList&sysBusType=4&corpId=$!{interestSingleNodBookVO.corpId}"
                                         data-name="purpose" data-biz-name="purpose" data-defaultvalue="$!{interestSingleNodBookVO.purpose}" data-required="true" data-extraData="true"
										 data-valuefield="purpose" data-textfield="purpose" data-inputvalue="inputvalue" data-search="true"></div>
								</div>
							</td>
						</tr>
						<tr>
							<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
							<td colspan="3">
								<textarea placeholder="#springMessage('fcVoucherType.rmk')" lay-verify="strlength" data-maxlength="100" class="layui-textarea" id="remark" name="remark" >$!{interestSingleNodBookVO.remark}</textarea>
							</td>
						</tr>
						<tr>
							<td colspan="4" style="text-align: center;">
								<button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.save')</button>
								<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
							</td>
						</tr>
						</tbody>
					</table>
			</div>
		</div>
	</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/single/nod/interestSingleNodBooking.edit.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<table class="layui-table">
		<tbody>
		<tr>
			<input type="hidden" name="eqs_accType" id="eqs_accType" value="08" />
			<input type="hidden" name="opType" id="opType" value="checkList" />
			##网点
			<td class="textRight" width="15%">#springMessage('table.interestSingleNod.netName')</td>
			<td >
				<div class="layui-inline">
					<div class="bt-biz-corp"
						 data-biz-type="net"
						 data-type="selectTree"
						 data-name="eqs_netId"
						 data-group="corpGroup"
						 data-change="ins_corpId"
						 data-resource="finacial:interest:nod:hand"
						 data-scope="net"></div>
				</div>
			</td>
			##开户单位
			<td class="textRight" width="15%">#springMessage('table.interestSingleNod.corpName')</td>
			<td >
				<div class="layui-inline">
					<div class="bt-biz-corp"
						 data-tree-type="check"
						 data-biz-type="corp"
						 data-type="selectTree"
						 data-name="ins_corpId"
						 data-tips="#springMessage('common.placeholder.select')#springMessage('table.interestSingleNod.netName')"
						 data-group="corpGroup"
						 data-resource="finacial:interest:nod:hand"
						 data-scope="all"></div>
				</div>
			</td>

		</tr>
		<tr>
			<td class="textRight" width="15%">#springMessage('table.interestSingleNod.account')</td>
			<td >
				<input type="text" name="likes_account"
					   autocomplete="off" class="bank layui-input" placeholder="#springMessage('table.interestSingleNod.account')">
			</td>
			<td class="textRight" width="15%">#springMessage('table.interestSingleNod.businessStatus')</td>
			<td >
				<div class="bt-biz-dict" data-type="select" data-group="interest.busStatus" data-name="eqi_status" data-displayData="-1,0"></div>
			</td>
		</tr>
		<tr>
			<td colspan="6" align="center">
				<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</td>
		</tr>
		</tbody>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
	<thead>
	<tr>
		<th>#springMessage('table.interestSingleNod.corpName')</th>
		<th>#springMessage('table.interestSingleNod.account')</th>
		<th>#springMessage('table.interestSingleNod.accountName')</th>
		<th>#springMessage('table.interestSingleNod.curId')</th>
		<th>#springMessage('table.interestSingleNod.withdrawalDate')</th>
		<th>#springMessage('table.interestSingleNod.withdrawalMoney')</th>
		<th>#springMessage('table.interestSingleNod.businessStatus')</th>
		<th>#springMessage('common.table.thead.operation')</th>
	</tr>
	</thead>
</table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/single/nod/fcInterestNod.check.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
	<style type="text/css">
		.layui-body2 {
			padding：0px;
			position: absolute;
			left: 0px;
			right: 0;
			top: 0;
			bottom: 0;
			z-index: 998;
			width: auto;
			overflow: hidden;
			overflow-y: auto;
			-webkit-box-sizing: border-box;
			-moz-box-sizing: border-box;
			box-sizing: border-box;
		}
		.layui-tab-content{
			box-sizing:border-box;
		}
		.layui-tab-item {
			min-height:600px;
		}
		.layui-tab-item .layui-layer-loading1 {
			margin: 10px auto;
		}

	</style>
</head>
<body>
<form id="searchForm" class="layui-form">
	<table class="layui-table">
		<tbody>
		<tr>
			##网点
			<td width="8%" align="right">#springMessage('table.fcAcc.netId')</td>
			<td width="17%" align="left">
				<div class="bt-biz-corp" data-name="netId" data-biz-type="net"
					 data-defaultvalue="${searchBean.netId}" data-type="select"
					 data-biz-name="netValue" data-selecttext="false"
					 data-filterdata="$!{notAuthNets}"
					 data-callback="corpCall"></div>
				<input type="hidden" id="netId" value="${searchBean.netId}">
				<input type="hidden" id="netName" value="${netName}">
			</td>
			##开户种类
			<td width="8%" align="right">#springMessage('finacial.paramConfig.fcSubject.accType')</td>
			<td width="17%" align="left">
				<div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType" data-biz-name="accType"  data-name="accType" data-defaultvalue="$!{searchBean.accType}"  data-callback="accTypeCall" data-filterData=",06,07,10,14,15"></div>
			</td>
			##记账日期
			<td width="8%" align="right">#springMessage('table.fcAccbook.tallyDate')</td>
			<td width="17%" align="left">
				<input type="text" name="tallyDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="tallyDate" value="$!date.format('yyyy-MM-dd',$!searchBean.tallyDate)">
			</td>
			##止息日期
			<td width="8%" align="right">#springMessage('table.interet.blnInstDate')</td>
			<td width="17%" align="left">
				<input type="text" name="blnInstDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="blnInstDate" value="$!date.format('yyyy-MM-dd',$!searchBean.blnInstDate)">
			</td>
		</tr>
		<tr>
			<td colspan="8" align="center">
				#set($opTypeCurr = 'initList')
				#if($opTypeCurr.equals($opType))
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="calcInterest">#springMessage('table.fcAcc.interestSignOk')</button><!-- 计息 -->
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="doDeleteByBatch">#springMessage('common.button.delete')</button><!-- 删除 -->
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="calcSubmit">#springMessage('common.button.submit')</button><!--提交 -->
				#else
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="doCheck">#springMessage('common.button.check')</button><!--复核 -->
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="doBack">#springMessage('common.button.back')</button><!--打回 -->
				#end
				<button class="layui-btn layui-btn-mini" lay-submit lay-filter="doExportInterestBill">#springMessage('table.interet.printlxqd')</button><!--导出利息清单 -->
				<button type="button" class="layui-btn" onclick="doPrintInterestBill()">#springMessage('table.interet.Exportlxqd')</button><!--打印利息清单 -->
				<button class="layui-btn layui-btn-mini" lay-submit lay-filter="doBatchPrint">#springMessage('table.interet.vourcher')</button>
				<button class="layui-btn layui-btn-mini" lay-submit lay-filter="doPrintRateNotice">#springMessage('table.interet.lxtzd')</button><!-- 打印利息通知单 -->
			</td>
		</tr>
		</tbody>
	</table>
</form>

<div class="layui-tab layui-tab-card my-tab" lay-filter="card2" style="height: 100%">
	<ul class="layui-tab-title">
		<li lay-id="lxqd" class="layui-this" >#springMessage('table.interet.lxqd')</li><!--利息清单  -->
		<li lay-id="jxpz">#springMessage('table.interet.jxpz')</li><!--计息凭证  -->
		<li lay-id="jsqd">#springMessage('table.interet.jsqd')</li><!--积数清单  -->
		#if($opTypeCurr.equals($opType))
			<li lay-id="bzkqd" >#springMessage('table.interet.bzkqd')</li><!--不足款清单  -->
		#end
	</ul>
	<div class="layui-tab-content" style="width: 100%; height: 100%" id="tabContent">
		<div id="lxqd" class="layui-tab-item layui-show" style="width: 100%; height: 100%">
			<iframe id="lxqdiframe" src="" frameborder="0" style="width: 100%; height: 100%"></iframe>
		</div>
		<div id="jxpz" class="layui-tab-item" style="width: 100%; height: 100%" >
			<div class="layui-layer layui-layer-loading layui-hide" id="loading" type="loading" times="1" showtime="0" contype="string" style="position: relative;width: 100%;">
				<div id="" class="layui-layer-content layui-layer-loading1"></div>
			</div>
		</div>
		## id="newiframeDiv"
		<div id="jsqd" class="layui-tab-item"  style="width: 100%; height: 100%; overflow-y: auto; display: none">
			##<iframe id="jsqdiframe" src="" frameborder="0" style="width: 100%; height: 100%;display: none"></iframe>
		</div>
		#if($opTypeCurr.equals($opType))
			## id="newiframeDiv1"
			<div id="bzkqd" class="layui-tab-item"  style="width: 100%; height: 100%; overflow: hidden; display: none">
				##<iframe id="bzkqdiframe" src="" frameborder="0" style="width: 100%; height: 100%;display: none"></iframe>
			</div>
		#end
	</div>
</div>

<input type="hidden" name="method" id="method" value="doDispatchPage"/>
<input type="hidden" id="busType" name="busType" value="interestBatch"/>
<input type="hidden" id="opType" name="opType" value="${opType}"/>
<input type="hidden" id="dayCloseDate" name="dayCloseDate" value="${closeDate}"/>
<input type="hidden" id="batchInstWay" name="batchInstWay" value="${batchInstWay}"/>
<input type="hidden" id="userName" name="userName" value="${userName}"/>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/finacial/interest/batchInterest.js?_btv=${resourceVersion}"></script>
</html>

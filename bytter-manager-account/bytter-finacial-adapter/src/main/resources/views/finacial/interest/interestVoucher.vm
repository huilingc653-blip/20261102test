				}
			}
		}
 }); */

	//组件初始化页码起始页为0,后台的页码起始页为1
	bt.page.init({
	     elem:'#page',
	     count:10,
	     currentPage:empstr($("#curr").val()),
	     pages:empstr($("#interestTot").val()),
	     record:false,
	     lengthMenu:false,
	     jump:function(obj){
	    	 var curr = obj.curr;
			 var param = "";
	    	 if($("#pageType").val()=="interest"){//计息凭证
					param = "netId="+$("#netId").val()+"&accType="+$("#accType").val()+"&opType="+$("#opType").val()
                            +"&curr="+curr+"&poolSign=" + $("#poolSign").val()+"&endDate="+$("#endDate").val();
					location.href = basePath + "/finacial/interest/fcinterest/toLoadInterestVoucher?"+param;
				}
				if($("#pageType").val()=="rush"){//计息冲预提凭证
					param = "netId="+$("#netId").val()+"&accType="+$("#accType").val()+"&opType="+$("#opType").val() +"&curr="+curr+"&endInstDate="+$("#endInstDate").val()+"&tallyDate="+$("#tallyDate").val();
					location.href = basePath + "/finacial/interest/fcinterest/toLoadInterestRushVoucher?"+param;
				}
	     }
	   });

	   function empstr(str){
		 if(str==""||str=="0"||str==null||typeof(str)=="undefined"||isNaN(str)){
			 return 1;
		 }else{
			 return str;
		 }
	 }
});
</script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
    	.voucher-title {
			font-weight: bold;
			font-size: 22px; 
			text-decoration: underline;
			text-align: center;
		}
		.voucher-head span{
			display:inline-block;
		}
		
		#page {
     	border:1px solid #d2d2d2;
     	border-top:none;
     	min-height:300px;
     	position:relative;
     }
     #page > .wrapper {
     	border:none;
     	border-top:1px solid #d2d2d2;
     	position:absolute;
     	bottom:0px;
     	width:100%;
     	
     }
	.dark-skin #page,
	.dark-skin #page > .wrapper {
		border-color: #2E2F34;
		padding: 0;
	}
     #page table thead tr th:first-child,#page table tbody tr td:first-child {
     	border-left:none!important;
     }
     #page table thead tr th:last-child,#page table tbody tr td:last-child {
     	border-right:none!important;
     }
     #page table.layui-table {
     	border-left:none!important;
     	border-right:none!important;
     	margin-bottom:107px;
     	margin-top:30px;
     }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
</form>
	#if($model.voucherInfo)
		#foreach($accbook in $model.voucherInfo)
		<div class="voucher-title">#springMessage('table.fcAccbook.tallyTitle')</div>
		    <div class="voucher-head" style="position:relative;text-align:right;top:-22px;height:10px;margin-bottom:-20px">
			<div>
				<span style="width:350px;text-align:left;white-space: nowrap;">
				#springMessage('table.fcAccbook.affixAmount')：<span style="width:50px">$!{accbook.affixAmount}</span><!-- 附件张数 -->
				</span>
			</div>
			<div>
				<span style="width:350px;text-align:left;white-space: nowrap;">
				#springMessage('table.fcAccbook.busRaceId')：<span style="width:150px">$!{accbook.busRaceName}</span>&nbsp;&nbsp;<!-- 业务种类 -->
				#springMessage('table.fcChargeType.curCode')：<span style="width:50px">$!{accbook.fcAccbookDtls[0].fcAcc.curName}</span><!-- 币别 -->
				</span>
			</div>
		</div> 
		<div class="voucher-head" style="position:relative;text-align:left;top:22px;height:10px;">
			<span style="width: 43%; float:left; ">#springMessage('table.fcAccbook.orderNo')：<span>$!{accbook.orderNo}</span></span><!-- 流水号 -->
			<span style="float:left; padding:0px;margin: 0px" >#springMessage('table.bisAccBal.createDate')：<!-- 制单日期 -->
				<span>$!date.format('yyyy-MM-dd',$!accbook.enrolTime)</span>
			</span>
			<span style="width: 350px; text-align: left;float:right;vertical-align: bottom;">#springMessage('table.fcAccbook.voucherNo')：<span></span></span><!-- 凭证号 -->
		</div>
		<div id="page">
		<table class="layui-table" >
		<tr>
		 <td colspan="3" style="width:90px;text-align:center" nowrap>#springMessage('table.fcAccbookDtl.summaryContent')</td><!-- 摘要 -->
		 <td colspan="2" style="width:100px;text-align:center" nowrap>#springMessage('table.intere.subjectAcc')</td><!--科目账号  -->
		 <td colspan="4" style="width:100px;text-align:center" nowrap>#springMessage('table.fcAcc.accName')</td><!--户名  -->
		 <td style="width:60px;text-align:center" nowrap>#springMessage('table.fcAccbook.voucherType')</td><!--凭证种类  -->
		 <td style="width:100px;text-align:center" nowrap>#springMessage('table.interetDtl.oldVoucher')</td><!--原始凭证号码  -->
		 <td colspan="1" style="width:100px;text-align:center" nowrap>#springMessage('table.fcAccbookDtl.debitMoney')</td><!--借方发生额  -->
		 <td style="width:100px;text-align:center" nowrap>#springMessage('table.fcAccbookDtl.creditMoney')</td><!--贷方发生额  -->
		</tr>

		#foreach($dtl in $accbook.fcAccbookDtls)
		<tr>
		 <td rowspan="2" colspan=3 nowrap>$!{dtl.summaryContent}</td>
		 <td colspan=2 nowrap>$!{dtl.fcAcc.subjectName}</td>
		 <td rowspan="2" colspan=4 style="" nowrap>$!{dtl.accName}</td>
		 <td rowspan="2" nowrap>$!{model.voucherTypeName}</td>
		 <td rowspan="2" nowrap>#if(${dtl.origVoucherNo}) $!{dtl.origVoucherNo} #end</td>
		 <td rowspan="2" colspan=1 align='right' class="money-color" nowrap>$!number.formatNumeric($dtl.debitMoney)</td>
		 <td rowspan="2" align='right' class="money-color" nowrap>$!number.formatNumeric($dtl.creditMoney)</td>
		</tr>
		<tr>
			<td colspan=2 nowrap>$!{dtl.fcAcc.blnctrAcc}</td>
		</tr>
		#end
		<tr >
		 <td nowrap rowspan="3" style="width:40px">#springMessage('table.fcAccbook.rmk')</td><!--备注  -->
		 <td nowrap>#springMessage('table.fcAccbook.tallyDate')</td><!--记账日期  -->
		 <td nowrap><span>$!date.format('yyyy-MM-dd',$!accbook.tallyDate)</span></td>
		 <td nowrap>#springMessage('table.fcInterestDtl.interestStartDate')</td><!--起息日期  -->
		 <td nowrap style="width:80px;" colspan=3><span>$!date.format('yyyy-MM-dd',$!accbook.tallyDate)</span></td>
		 <td nowrap>#springMessage('table.fcAccbook.emergencySign')</td><!--加急标志  -->
		 <td><span class='control'></span></td>
		 <td align="right" colspan=2>#springMessage('table.interet.sum'):</td><!--合计  -->
		 <td align='right'><span>$!number.formatNumeric($accbook.debitSum)</span></td>
		 <td align='right'><span>$!number.formatNumeric($accbook.creditSum)</span></td>
		</tr>
		<tr>
		 <td nowrap>#springMessage('table.nisBillhead.voucherTypeId')</td><!--付款方式  -->
		 <td>&nbsp;</td>
		 <td nowrap>#springMessage('table.fcAccbookExt.externalCorp')</td><!--外单位名称  -->
		 <td colspan=4 >&nbsp;</td>
		 <td nowrap>#springMessage('table.fcAccbookExt.externalAcc')</td><!--外单位账号  -->
		 <td colspan=4 style="width:50px">&nbsp;</td>
		</tr>
		<tr>
		 <td nowrap>#springMessage('table.fcAccbookExt.paysysbankcode')</td><!--开户行  -->
		 <td colspan=5 nowrap></td>
		 <td nowrap>#springMessage('table.fcAccbookExt.prov')</td><!--省份  -->
		 <td colspan=3 nowrap></td>
		 <td nowrap>#springMessage('table.fcAccbookExt.city')</td><!--城市  -->
		 <td nowrap></td>
		</tr>
		<tr>
		 <td></td>
		 <td nowrap>#springMessage('table.fcAccbook.rmk')</td><!--备注  -->
		 <td colspan=11 nowrap></td>
		</tr>
	</table>
	</div>
		#end
	#end

	#if(!$model.voucherInfo)
	<div class="voucher-title" style="font-size: 22px;">#springMessage('table.fcAccbook.tallyTitle')</div>

				</span>
			</div>
		</div>
		<div class="voucher-head" style="position:relative;text-align:left;top:22px;height:10px;">
			<span style="width: 43%; float:left; ">#springMessage('table.fcAccbook.orderNo')：<span></span></span><!--流水号  -->
			<span style="float:left; padding:0px;margin: 0px" >#springMessage('table.bisAccBal.createDate')：<!--制单日期  -->
				<span></span>
			</span>
			<span style="width: 250px; text-align: left;float:right;vertical-align: bottom;">#springMessage('table.fcAccbook.voucherNo')：<span></span></span><!--凭证号  -->
		</div>
		<div id="page">
		<table class="layui-table dark-layui-table" >
		<tr>
		 <td colspan="3" style="width:90px" nowrap>#springMessage('table.fcAccbookDtl.summaryContent')</td><!--摘要  -->
		 <td colspan="2" style="width:100px" nowrap>#springMessage('table.intere.subjectAcc')</td><!--科目账号  -->
		 <td colspan="4" style="width:100px" nowrap>#springMessage('table.fcAcc.accName')</td><!--户名  -->
		 <td style="width:60px" nowrap>#springMessage('table.fcAccbook.voucherType')</td><!--凭证种类  -->
		 <td style="width:100px" nowrap>#springMessage('table.interetDtl.oldVoucher')</td><!--原始凭证号码  -->
		 <td colspan="1" style="width:100px;text-align:center" nowrap>#springMessage('table.fcAccbookDtl.debitMoney')</td><!--借方发生额  -->
		 <td style="width:100px" nowrap>#springMessage('table.fcAccbookDtl.creditMoney')</td><!--贷方发生额  -->
		</tr>
		<tr>
		 <td rowspan="2" colspan=3 nowrap></td>
		 <td colspan=2 nowrap>&nbsp;</td>
		 <td rowspan="2" colspan=4 style="" nowrap></td>
		 <td rowspan="2" nowrap></td>
		 <td rowspan="2" nowrap></td>
		 <td rowspan="2" colspan=1 align='right' class="money-color" nowrap></td>
		 <td rowspan="2" align='right' class="money-color" nowrap></td>
		</tr>
		<tr>
			<td colspan=2 nowrap>&nbsp;</td>
		</tr>
		<tr>
		 <td rowspan="2" colspan=3 nowrap></td>
		 <td colspan=2 nowrap>&nbsp;</td>
		 <td rowspan="2" colspan=4 style="" nowrap></td>
		 <td rowspan="2" nowrap></td>
		 <td rowspan="2" nowrap></td>
		 <td rowspan="2" colspan=1 align='right' class="money-color" nowrap></td>
		 <td rowspan="2" align='right' class="money-color" nowrap></td>
		</tr>
		<tr>
			<td colspan=2 nowrap>&nbsp;</td>
		</tr>
		<tr >
		 <td nowrap rowspan="3" style="width:40px">#springMessage('table.fcAccbook.rmk')</td><!-- 备注 -->
		 <td nowrap>#springMessage('table.fcAccbook.tallyDate')</td><!--记账日期  -->
		 <td nowrap><span></span></td>
		 <td nowrap>#springMessage('table.fcInterestDtl.interestStartDate')</td><!--起息日期  -->
		 <td nowrap style="width:80px;" colspan=3><span></span></td>
		 <td nowrap>#springMessage('table.fcAccbook.emergencySign')</td><!--加急标志  -->
		 <td><span class='control'></span></td>
		 <td align="right" colspan=2>#springMessage('table.interet.sum'):</td><!--合计  -->
		 <td align='right'><span></span></td>
		 <td align='right'><span></span></td>
		</tr>
		<tr>
		 <td nowrap>#springMessage('table.nisBillhead.voucherTypeId')</td><!--付款方式  -->
		 <td>&nbsp;</td>
		 <td nowrap>#springMessage('table.fcAccbookExt.externalCorp')</td><!--外单位名称  -->
		 <td colspan=4 >&nbsp;</td><!--  -->
		 <td nowrap>#springMessage('table.fcAccbookExt.externalAcc')</td><!--外单位账号  -->
		 <td colspan=4 style="width:50px">&nbsp;</td>
		</tr>
		<tr>
		 <td nowrap>#springMessage('table.fcAccbookExt.paysysbankcode')</td><!--开户行  -->
		 <td colspan=5 nowrap></td>
		 <td nowrap>#springMessage('table.fcAccbookExt.prov')</td><!--省份  -->
		 <td colspan=3 nowrap></td>
		 <td nowrap>#springMessage('table.fcAccbookExt.city')</td><!--城市  -->
		 <td nowrap></td>
		</tr>
		<tr>
		 <td></td>
		 <td nowrap>#springMessage('table.fcAccbook.rmk')</td><!--备注  -->
		 <td colspan=11 nowrap></td>
		</tr>
	</table>
	#end
	</div>
	<input type="hidden" id="interestTot" value="${model.interestTot}">
	<input type="hidden" id="curr" value="${model.curr}">
	<input type="hidden" id="opType" value="${model.opType}">
	<input type="hidden" id="pageType" value="${model.pageType}">
	<input type="hidden" id="netId" value="${model.netId}">
	<input type="hidden" id="accType" value="${model.accType}">
	<input type="hidden" id="endInstDate" value="${model.endInstDate}">
	<input type="hidden" id="tallyDate" value="${model.tallyDate}">
	<input type="hidden" id="poolSign" name="poolSign" value="$!{model.poolSign}">
	#parse("views/common/footer.vm")
</body>
</html>

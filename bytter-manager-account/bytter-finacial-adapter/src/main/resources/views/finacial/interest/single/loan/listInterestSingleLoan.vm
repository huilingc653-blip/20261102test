<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            <input type="hidden" name="eqs_accType" id="eqs_accType" value="$!{accType}"/>
            <input type="hidden" name="opType" id="opType" value="initList"/>
            ## 网点
            <td class="textRight">#springMessage('table.fcAcc.netId')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="net"
                         data-type="selectTree"
                         data-name="eqs_netId"
                         data-group="corpGroup"
                         data-change="ins_corpId"
                         data-resource="finacial:interest:loan:hand"
                         data-scope="net"></div>
                </div>
            </td>
            ## 开户单位
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-tips="#springMessage('common.placeholder.select')#springMessage('table.fcAcc.netId')"
                         data-group="corpGroup"
                         data-resource="finacial:interest:loan:hand"
                         data-scope="all"></div>
                </div>
            </td>
            ## 业务状态
            <td class="textRight">#springMessage('table.fcInterestDtl.busStatus')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-type="select" data-group="interest.busStatus" data-name="eqs_status"
                     data-displayData="-1,0"></div>
            </td>

        </tr>
        <tr>
            ## 账号 table.fcAcc.account
            <td class="textRight">#springMessage('table.fcAcc.blnctrAcc')</td>
            <td width="25%">
                <input type="text"
                       name="likes_account"
                       autocomplete="off"
                       class="bank layui-input"
                       placeholder="#springMessage('table.fcAcc.blnctrAcc')">
            </td>

            ## 还款方式
            <td class="textRight">#springMessage('table.cmsLoanInfo.repayType')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-type="select" data-group="cms.repayType" data-name="eqs_payWay"
                     data-displayData="1,2,3,4"></div>
            </td>

        </tr>
        <tr>
            <td colspan="6" align="center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcCheckInit.corpId')</th>
        <th>#springMessage('table.fcAccuBalance.account')</th>
        <th>#springMessage('table.fcAcc.accName')</th>
        <th>#springMessage('table.fcAcc.curId')</th>
        <th>#springMessage('table.cmsLoanInfo.repayType')</th>
        <th>#springMessage('table.cmsLoanRepay.repayDate')</th>
        <th>#springMessage('table.cmsLoanRepay.repayMoney')</th>
        <th>#springMessage('table.fcInterestDtl.busStatus')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/single/loan/fcInterestLoan.list.js?_btv=${resourceVersion}"></script>
</html>
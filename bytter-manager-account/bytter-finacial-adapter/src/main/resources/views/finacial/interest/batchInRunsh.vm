<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
.layui-body2 {
	padding：0px;
	position: absolute;
	left: 0px;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 998;
	width: auto;
	overflow: hidden;
	overflow-y: auto;
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box;
}
.layui-tab-content{
	box-sizing:border-box;
}
.layui-tab-item {
	min-height:500px;
}
</style>
</head>
<body>
<form id="searchForm" class="layui-form">
	<table class="layui-table">
		<tbody>
			<tr>
				##网点
				<td width="8%" align="right">#springMessage('table.fcAcc.netId')</td>
				<td width="17%" align="left">
					<div class="bt-biz-corp" data-name="netId" data-biz-type="net"
							data-defaultvalue="${searchBean.netId}" data-type="select"
							data-biz-name="netValue" data-selecttext="false"
							data-filterdata="$!{notAuthNets}"
							data-callback="corpCall"></div> 
							<input type="hidden" id="netId" value="${searchBean.netId}">
				</td>
				##开户种类
				<td width="8%" align="right">#springMessage('finacial.paramConfig.fcSubject.accType')</td>
				<td width="17%" align="left">
					<div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType" data-biz-name="accType"  data-name="accType" data-defaultvalue="$!{searchBean.accType}" data-callback="accTypeCall" data-filterData="05,06,07,08,10,14"></div>
				</td>
				##记账日期
				<td width="8%" align="right">#springMessage('table.fcAccbook.tallyDate')</td>
				<td width="17%" align="left">
				 	<input type="text" name="tallyDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="tallyDate" value="$!date.format('yyyy-MM-dd',$!searchBean.tallyDate)">
				</td>
				##止息日期
				<td width="8%" align="right">#springMessage('table.interet.blnInstDate')</td>
				<td width="17%" align="left">
					<input type="text" name="blnInstDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="blnInstDate" value="$!date.format('yyyy-MM-dd',$!searchBean.blnInstDate)">
				</td>
			</tr>
			<tr id="individualAccType" style='display:none;'>
				##账号
				<td width="8%" align="right">#springMessage('table.fcAcc.account')</td>
				<td width="17%" align="left">
					<div type="list" field="account1"></div>
				    <input type="hidden" class="layui-input" id="account">
				</td>
				##冲预提金额
				<td width="8%" align="right">#springMessage('table.interet.strikeInterest')</td>
				<td width="17%" align="left">
					<input type="text" class="layui-input bt-biz-moneyType" data-name="strikeInterest" data-biz-name="strikeInterest" data-minus="true" data-callback="strikeCall">
				</td>
				<td colspan="4"></td>
			</tr>
			<tr>
				<td colspan="8" align="center">
				#set($opTypeCurr = 'initList') 
				#if($opTypeCurr.equals($opType))
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="temp">#springMessage('table.interet.predrawRush')</button><!-- 冲预提 -->
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="remove">#springMessage('common.button.delete')</button><!-- 删除 -->
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="submit">#springMessage('common.button.submit')</button><!--提交 -->
				#else
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="check">#springMessage('common.button.check')</button><!--复核  -->
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="back">#springMessage('common.button.back')</button><!--打回  -->
				#end
				</td>
			</tr>
		</tbody>
	</table>
</form>

 <div class="layui-tab layui-tab-card my-tab" lay-filter="card2" style="height: 100%">
 	<ul class="layui-tab-title">
		<li class="layui-this" lay-id="ytqd">#springMessage('table.interet.ytqd')</li><!-- 预提清单 -->
		<li lay-id="lxqd">#springMessage('table.interet.lxqd')</li><!-- 利息清单 -->
		<li lay-id="jxpz">#springMessage('table.interet.jxpz')</li><!--计息凭证  -->
	</ul>
	<div class="layui-tab-content" style="width: 100%; height: 100%">
		<div class="layui-tab-item layui-show" style="width: 100%; height: 100%; overflow-y: auto; display: none">
        	<iframe id="ytqdiframe" src="" frameborder="0" style="width: 100%; height: 100%;"></iframe>
        </div>
        <div class="layui-tab-item" style="width: 100%; height: 100%">
        	<iframe id="lxqdiframe" src="" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
        <div class="layui-tab-item" style="width: 100%; height: 100%">
        	<iframe id="jxpziframe" src="" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
    </div>
 </div>

<input type="hidden" name="method" id="method" value="doDispatchPage"/>
<input type="hidden" id="busType" name="busType" value="interestBatch"/>
<input type="hidden" id="opType" name="opType" value="${opType}"/>
<input type="hidden" id="dayCloseDate" name="dayCloseDate" value=""/>
<input type="hidden" id="batchInstWay" name="batchInstWay" value="${batchInstWay}"/>
<input type="hidden" id="rushMoney" name="rushMoney" />
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/batchInRunsh.js?_btv=${resourceVersion}"></script>
</html>
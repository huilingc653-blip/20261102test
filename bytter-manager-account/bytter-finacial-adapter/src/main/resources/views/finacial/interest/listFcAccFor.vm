<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm"  class="layui-form">

    <table class="layui-table">
        <tbody>
        <tr>
            <!-- 网点 -->
            <td class="textRight" width="14%">#springMessage('table.fcCheckInit.netId')</td>
            <td width="36%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-scope="net"  data-name="eqs_netId" data-biz-type="net" data-type="selectTree"
                         data-resource="fcl:interest:inventory:query"></div>
                </div>
            </td>
            <!-- 单位 -->
            <td class="textRight" width="14%">#springMessage('table.fcCheckInit.corpId')</td>
            <td width="36%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-scope="all"
                         data-tree-type="check"
                         data-resource="fcl:interest:inventory:query">
                    </div>
                </div>
            </td>
            <!-- 计息日期区间 -->
            <td class="textRight" width="14">#springMessage('table.fcAccuBalance.interestTime')</td>
            <td width="36">
                <div class="layui-inline">
                    <input type="text" name="ged_interestTime" class="layui-input bt-input-inline bt-biz-dateType" data-endid="t2"  >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_interestTime" class="layui-input bt-input-inline bt-biz-dateType" id="t2">
                    ##                <input id="date" type="hidden" name="led_interestTime">
                </div>
            </td>
        </tr>
        <tr>
            <!-- 帐号 -->
            <td class="textRight" width="14%">#springMessage('table.fcAccuBalance.account')</td>
            <td width="36%">
                <input type="text" name="likes_blnctrAcc" class="layui-input bank">
            </td>
            <!-- 开户种类 -->
            <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.accType')</td>
            <td >
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType"  data-name="ins_accType" data-filterData="06,07,08,10,14,15"></div>
                </div>
            </td>
            <!-- 起息日期区间 -->
            <td class="textRight">#springMessage('table.FcAcc.ValueDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="ged_interestStartDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="t3">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_interestStartDate" class="layui-input bt-input-inline bt-biz-dateType" id="t3">
                </div>
            </td>
        </tr>
        <tr>
            <td style="text-align: center;" colSpan="6">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button class="layui-btn" type="button" lay-submit="" lay-filter="print" id="print">#springMessage('common.button.print')</button>
                <button class="layui-btn" type="button" lay-submit="" lay-filter="batchPrint" id="batchPrint">#springMessage('common.button.batchPrint')</button>
                <button type="reset" class="layui-btn" data-callback="reset">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>

    <table class="layui-table layui-form" style="width:100%;" >
        <thead>
        <tr>
            <th>#springMessage('table.fcInterestDtl.account'):</th>
            <td id="account"></td>
            <th>#springMessage('table.nisPersonnelDetail.accName'):</th>
            <td id="accName"></td>
            <th>#springMessage('table.fbsBudgetDetail.curId'):</th>
            <td id="curName"></td>
        </tr>
        </thead>
    </table>
    <table id="appTable" class="layui-table layui-form" style="width:100%;" >
        <thead>
        <tr>
            <th>#springMessage('table.fcInterestDtl.account'):</th>
            <th>#springMessage('table.nisPersonnelDetail.accName'):</th>
            <th>#springMessage('table.fbsBudgetDetail.curId'):</th>
            <th>#springMessage('table.fcInterestDtl.interestStartDate')</th>
            <th>#springMessage('table.interet.blnInstDate')</th>
            <th>#springMessage('table.fcInterestDtl.days')</th>
            <th>#springMessage('table.fcInterestDtl.cumulation')</th>
            <th>#springMessage('table.fcInterestDtl.interestRate')</th>
            <th>#springMessage('table.fcInterestDtl.interest')</th>
        </tr>
        </thead>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/fcAcc.list.js?_btv=${resourceVersion}"></script>
</html>
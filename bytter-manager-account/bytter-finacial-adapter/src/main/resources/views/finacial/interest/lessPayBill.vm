<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
<input type="hidden" value="initList" id="opType" name="opType"/>
<input type="hidden" value="${netId}" id="netId" name="netId"/>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fclesspaybill.sendaccount')</th><!-- 放款账号 -->
        <th>#springMessage('table.fcAcc.accName')</th><!--户名  -->
        <th>#springMessage('table.fclesspaybill.accfordeduct')</th><!--扣款账号  -->
        <th>#springMessage('table.fcInterestDtl.interest')</th><!--利息  -->
        <th>#springMessage('table.fclesspaybill.deductbalance')</th><!--扣款当前可用余额  -->
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
</html>
<script>
    bt.use(['form','datatable','moneyType'], function(){
    	$ = bt.jquery,form = bt.form(),moneyFun = bt.moneyType.getFun();
    	//生成列表
        bt.datatable.init({
            elem: "#appTable",
            dom: 'rtlip',
            colReorder: false,
            ajax: {
                'url': basePath+"/finacial/interest/fcinterest/toLoadLessPayBill"
            },
            searchForm:{
                formElem:"#searchForm",
                formFilter:"search"
            },
            columns: [
                {data:'account',className:'center',bSortable:false},
                {data:'accName',className:'center',bSortable:false},
                {data:'accForDeduct',className:'center',bSortable:false},
                {data:'interest',className:'textRight',bSortable:false,
                    render: function ( data, type, full, meta ) {
                        return moneyFun.format(full.interest);
                    }
                },
                {data:'balance',className:'textRight',bSortable:false,
                    render: function ( data, type, full, meta ) {
                        return moneyFun.format(full.balance);
                    }
                }
            ]
    });
    });
</script>
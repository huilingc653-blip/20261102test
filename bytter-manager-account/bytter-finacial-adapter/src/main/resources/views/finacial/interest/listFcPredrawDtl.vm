<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <!-- 预提明细查询表 -->
        <tr>
            <!-- 网点 -->
            <td class="textRight">#springMessage('table.fcAcc.netId')</td>
            <td width="40%"><div class="bt-biz-corp" data-scope="net" data-biz-name="netId" data-name="eqs_netId" data-biz-type="net" data-type="selectTree" data-resource="finacial:fcpredrawdtl:detail:query"></div></td>

            <!-- 帐号 -->
            <td class="textRight">#springMessage('table.fcAccuBalance.account')</td>
            <td width="40%">
                <input id="account" type="text" name="likes_account" class="layui-input bank"/>
            </td>

        </tr>

        <tr>
            <!-- 预提日期 -->
            <td class="textRight">#springMessage('table.fcPredraw.withholdingDate')</td>
            <td width="40%">
                <div class=layui-inline>
                    <input class="layui-input bt-input-inline bt-biz-dateType" data-biz-name="ged_interestTime" type=text name="ged_interestTime"  data-endid="t2">
                    <span class=date-mid>~</span>
                    <input id=t2 class="layui-input bt-input-inline bt-biz-dateType" type=text  data-callback="formatDate">
                    <input id="date" type="hidden" name="led_interestTime">
                </div>
            </td>

            <!-- 开户种类 -->
            <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.accType')
            <td width="40%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType" data-name="ins_accType" data-displayData="01,02,03,04,05,08,09"></div>
                </div>
            </td>
        </tr>

        <!--提交按钮 -->
        <tr>
            <td style="text-align: center;" colSpan="6">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary"  data-callback="reset">#springMessage('common.button.reset')</button>
            </td>
        </tr>

        </tbody>

    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="print">
    <thead>
    <tr>
        <th>#springMessage('table.fcPredrawDtl.account')</th>
        <th>#springMessage('table.nisPersonnelDetail.accName')	</th>
        <th>#springMessage('table.fcPredrawDtl.orderNo')</th>
        <th>#springMessage('table.fcPredraw.withholdingDate')</th>
        <th>#springMessage('table.fcInterestDtl.interestStartDate')</th>
        <th>#springMessage('table.fcPredraw.endDate')</th>
        <th>#springMessage('table.fcInterestDtl.interestRate')</th>
        <th>#springMessage('table.faPredraw.withholding.interest')</th>
        <th>#springMessage('table.fcPredrawRushDtl.strikeDate')</th>
        <th>#springMessage('table.interet.strikeInterest')</th>
    </tr>
    </thead>
</table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/fcPredrawDtl.list.js?_btv=${resourceVersion}"></script>
</html>

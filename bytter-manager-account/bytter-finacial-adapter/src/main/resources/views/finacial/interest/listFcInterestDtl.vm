<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>

<body>
<form id="searchForm"  class="layui-form">
    <table class="layui-table">

        <!-- 利息明细查询表 -->
        <tr>
			#if($!{isPool} == '1')
                <td class="textRight" width="10%">#springMessage('nis.pool.fcCorpPool.pool')</td>
                <td width="25%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-url="${basePath}/finacial/interest/fcinterestdtl?getUserCorpPools" data-name="eqs_netId"
                             data-biz-name="ins_netId" data-callback="netIdCallback" data-valuefield="id" data-textfield="showName" data-search="true"></div>
                    </div>
                </td>
                <td class="textRight" width="10%">#springMessage('table.btBankAccApp.corpId')</td>
                <td width="25%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-url="" data-name="eqs_corpId" data-biz-name="ins_corpId"
                             data-valuefield="corpId" data-textfield="showName" data-search="true"></div>
                    </div>
                </td>
			#else
                <!-- 网点 -->
                <td class="textRight">#springMessage('table.fcAcc.netId')</td>
                <td width="40%"><div class="bt-biz-corp" data-scope="net"  data-name="eqs_netId" data-biz-type="net" data-type="selectTree" data-resource="finacial:fcinterestdtl:query"></div></td>

                <!-- 单位 -->
                <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
                <td width="40%"><div class="bt-biz-corp" data-name="eqs_corpId" data-biz-type="corp" data-type="selectTree" data-resource="finacial:fcinterestdtl:query"></div></td>
			#end

            <!--计息日期 -->
            <td class="textRight">#springMessage('table.fcAccuBalance.interestTime')</td>
            <td width="40%">
                <div class=layui-inline>
                    <input class="layui-input bt-input-inline bt-biz-dateType" type=text name="ged_interestTime" data-endid="t1">
                    <span class=date-mid>~</span>
                    <input id=t1 class="layui-input bt-input-inline bt-biz-dateType" type=text data-callback="formatDate">
                    <input id="date" type="hidden" name="led_interestTime">
                </div>
            </td>
        </tr>

        <tr>
            <!-- 开户种类 -->
            <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.accType')</td>
            <td width="40%">
                <div class="layui-input-inline">
					#if($!{isPool} == '0')
                        <div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType"  data-name="eqs_accType" data-filterData=",06,07,10,14,15"></div>
					#else
                        <div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType"  data-name="eqs_accType" data-displayData="01"></div>
					#end
                </div>
            </td>


            <!-- 帐号 -->
            <td class="textRight">#springMessage('table.fcAccuBalance.account')</td>
            <td width="40%">
                <input type="text" name="likes_account" class="layui-input bank">
            </td>

            <!--起息日期 -->
            <td class="textRight">#springMessage('table.fcAccbookHis.interestStartDate')</td>
            <td width="40%">
                <div class=layui-inline>
                    <input class="layui-input bt-input-inline bt-biz-dateType" type=text name="ged_interestStartDate" data-endid="t2">
                    <span class=date-mid>~</span>
                    <input id=t2 class="layui-input bt-input-inline bt-biz-dateType" type=text name="led_interestStartDate">
                </div>
            </td>
        </tr>

        <input id="isPool" type="hidden" value="$!{isPool}">

        <!--提交按钮 -->
        <tr>
            <td style="text-align: center;" colSpan="6">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary"  data-callback="reset">#springMessage('common.button.reset')</button>
            </td>
        </tr>

        </tbody>
    </table>
</form>


<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="print">
    <thead>
    <tr>
        <th>#springMessage('table.fcInterestDtl.account')</th>
        <th>#springMessage('table.nisPersonnelDetail.accName')</th>
        <th>#springMessage('table.fbsBudgetDetail.curId')</th>
        <th>#springMessage('table.fcBond.operateTime')</th>
        <th>#springMessage('table.fcInterestDtl.interestStartDate')</th>
        <th>#springMessage('table.interet.blnInstDate')</th>
        <th>#springMessage('table.fcInterestDtl.days')</th>
        <th>#springMessage('table.fcInterestDtl.cumulation')</th>
        <th>#springMessage('table.fcInterestDtl.interestRate')</th>
        <th>#springMessage('table.fcInterestDtl.interest')</th>
        <th id="aa">#springMessage('table.fcInterestDtl.interestSign')</th>

    </tr>
    </thead>
</table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/interest/fcInterestDtl.list.js?_btv=${resourceVersion}"></script>
</html>

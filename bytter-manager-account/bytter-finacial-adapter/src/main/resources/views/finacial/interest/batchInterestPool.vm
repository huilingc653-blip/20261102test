<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style type="text/css">
.layui-body2 {
	padding：0px;
	position: absolute;
	left: 0px;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 998;
	width: auto;
	overflow: hidden;
	overflow-y: auto;
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box;
}
.layui-tab-content{
	box-sizing:border-box;
}
.layui-tab-item {
	min-height:500px;
}

</style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="netId" id="netId" value="$!{searchBean.netId}">
	<table class="layui-table">
		<tbody>
			<tr>
				##网点
				<td width="10%" align="right">#springMessage('nis.pool.fcCorpPool.pool')</td>
				<td width="20%" align="left">
                    <div class="layui-input-inline">
						<div class="bt-biz-selectType"
							 data-url="${basePath}/finacial/interest/fcinterest?getUserCorpPools&opType=${opType}"
							 data-name="netCode" data-biz-name="netCode" data-callback="corpCall"
							 data-defaultvalue="$!{searchBean.netId}" data-valuefield="id" data-textfield="showName" data-required="required" ></div>
                    </div>
				</td>

				##开户种类
				<td width="10%" align="right">#springMessage('finacial.paramConfig.fcSubject.accType')</td>
				<td width="20%" align="left">
					<div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType" data-biz-name="accType"  data-name="accType"
						 data-defaultvalue="$!{searchBean.accType}"  data-callback="accTypeCall" data-displayData="01"></div>
				</td>
				<td width="10%" align="right">#springMessage('table.fcAcc.blnctrAcc')</td>
				<td width="25%" align="left">
                    <input type="text" id="account" name="account" lay-verify="tableData" data-biz-name="account"
                                   autocomplete="off" class="layui-input text" placeholder="#springMessage('table.fcAcc.blnctrAcc')">
                    <table id="accountTable" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.fcAcc.blnctrAcc')</th>
                            <th>#springMessage('table.fcAcc.accName')</th>
                            <th>#springMessage('table.fcAcc.curId')</th>
                        </tr>
                        </thead>
                    </table>
				</td>
            </tr>
            <tr>
				##记账日期
				<td width="8%" align="right">#springMessage('table.fcAccbook.tallyDate')</td>
				<td width="17%" align="left">
				 	<input type="text" name="tallyDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="tallyDate" value="$!date.format('yyyy-MM-dd',$!searchBean.tallyDate)">
				</td>
				##止息日期
				<td width="8%" align="right">#springMessage('table.interet.blnInstDate')</td>
				<td width="17%" align="left">
					<input type="text" name="blnInstDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="blnInstDate" value="$!date.format('yyyy-MM-dd',$!searchBean.blnInstDate)">
				</td>
			</tr>
			<tr>
				<td colspan="8" align="center">
				#set($opTypeCurr = 'initList') 
				#if($opTypeCurr.equals($opType))
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="calcInterest">#springMessage('table.fcAcc.interestSignOk')</button><!-- 计息 -->
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="doDeleteByBatch">#springMessage('common.button.delete')</button><!-- 删除 -->
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="calcSubmit">#springMessage('common.button.submit')</button><!--提交 -->
				#else
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="doCheck">#springMessage('common.button.check')</button><!--复核 -->
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="doBack">#springMessage('common.button.back')</button><!--打回 -->
				#end 
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="doExportInterestBill">#springMessage('table.interet.printlxqd')</button><!--导出利息清单 -->
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="doBatchPrint">#springMessage('table.interet.vourcher')</button>
					<button class="layui-btn layui-btn-mini" lay-submit lay-filter="doPrintRateNotice">#springMessage('table.interet.lxtzd')</button><!-- 打印利息通知单 -->
				</td>
			</tr>
		</tbody>
	</table>
</form>

 <div class="layui-tab layui-tab-card my-tab" lay-filter="card2" style="height: 100%">
 	<ul class="layui-tab-title">
		<li class="layui-this" lay-id="lxqd">#springMessage('table.interet.lxqd')</li><!--利息清单  -->
		<li lay-id="jxpz">#springMessage('table.interet.jxpz')</li><!--计息凭证  -->
		<li lay-id="jsqd">#springMessage('table.interet.jsqd')</li><!--积数清单  -->
	</ul>
	<div class="layui-tab-content" style="width: 100%; height: 100%">
        <div class="layui-tab-item layui-show" style="width: 100%; height: 100%">
        	<iframe id="lxqdiframe" src="" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
        <div class="layui-tab-item" style="width: 100%; height: 100%">
        	<iframe id="jxpziframe" src="" frameborder="0" style="width: 100%; height: 100%"></iframe>
        </div>
        <div class="layui-tab-item" id="newiframeDiv" style="width: 100%; height: 100%; overflow-y: auto; display: none">
        	<iframe id="jsqdiframe" src="" frameborder="0" style="width: 100%; height: 100%;display: none"></iframe>
        </div>
    </div>
 </div>

<input type="hidden" name="method" id="method" value="doDispatchPage"/>
<input type="hidden" id="busType" name="busType" value="interestBatch"/>
<input type="hidden" id="opType" name="opType" value="${opType}"/>
<input type="hidden" name="poolSign" id="poolSign" value="1">
<input type="hidden" id="dayCloseDate" name="dayCloseDate" value="${closeDate}"/>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/finacial/interest/batchInterestPool.js?_btv=${resourceVersion}"></script>
</html>
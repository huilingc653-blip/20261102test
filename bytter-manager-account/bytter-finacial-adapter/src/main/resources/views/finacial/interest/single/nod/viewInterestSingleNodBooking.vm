<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="status" name="status" type="hidden" value="0">
    <input id="noticeAccountId" name="noticeAccountId" type="hidden" value="">
    <input id="capitalAccId" name="capitalAccId" type="hidden" value="">
    <input id="interestAccId" name="interestAccId" type="hidden" value="">
    <input id="curId" name="curId" type="hidden" value="">

    <div id="print">
        <div class="layui-collapse" lay-filter="collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.choInnerFinance.noticeInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table">
                        <tbody>
                        <tr>
                            ##单位ID
                            <td class="textRight" width="10%">#springMessage('table.interestSingleNod.corpId')</td>
                            <td width="40%">
                                $!{interestSingleNodBookVO.corpName}
                            </td>
                            ##付款账号
                            <td class="textRight" width="10%">#springMessage('table.interestSingleNod.noticeAccount')</td>
                            <td>
                                $!{interestSingleNodBookVO.noticeAccount}
                            </td>
                        </tr>
                        <tr>
                            ##通知类型
                            <td class="textRight">#springMessage('table.interestSingleNod.noticeType')</td>
                            <td>
                                $!{interestSingleNodBookVO.noticeTypeName}
                            </td>
                            ##余额
                            <td class="textRight">#springMessage('table.interestSingleNod.balance')</td>
                            <td width="40%">
                                $number.formatNumeric($!{interestSingleNodBookVO.balance})
                            </td>
                        </tr>
                        <tr>
                            ##存款利率
                            <td class="textRight">#springMessage('table.interestSingleNod.interestRate')</td>
                            <td>
                                $rateTag.show($!{interestSingleNodBookVO.interestRate})
                            </td>
                            ##起息日期
                            <td class="textRight">#springMessage('table.interestSingleNod.interestStartDate')</td>
                            <td>
                                $date.format("yyyy-MM-dd", $!{interestSingleNodBookVO.interestStartDate})
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="layui-collapse" lay-filter="collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.choInnerFinance.bookInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table">
                        <tbody>
                        <tr>
                            ##预约日期
                            <td class="textRight">#springMessage('table.interestSingleNod.bookDate')</td>
                            <td>
                                $date.format("yyyy-MM-dd", $!{interestSingleNodBookVO.bookDate})
                            </td>
                            <td class="textRight">#springMessage('table.interestSingleNod.billNo')</td>
                            <td>
                                $!{interestSingleNodBookVO.billNo}
                            </td>
                        </tr>
                        <tr>
                        <tr>
                            ##预约金额（小写）
                            <td class="textRight">#springMessage('table.choInnerFinance.orderMoney.lower')</td>
                            <td width="40%">
                                $number.formatNumeric($!{interestSingleNodBookVO.bookMoney})
                                <input type="hidden" data-name="bookMoney" data-toUp="bookMoneyUp" autocomplete="off"
                                       class="layui-input bt-biz-moneyType" value="$!{interestSingleNodBookVO.bookMoney}">
                            </td>
                            ##预约金额（大写）
                            <td class="textRight">#springMessage('table.choInnerFinance.orderMoney.upper')</td>
                            <td width="40%" style="padding-left:0px">
                                <div id="bookMoneyUp"></div>
                            </td>
                        </tr>
                        <tr>
                            ##本金转入账号
                            <td class="textRight">#springMessage('table.choInnerFinance.capitalAcc')</td>
                            <td width="40%">
                                $!{interestSingleNodBookVO.capitalAcc}
                            </td>
                            ##本金转入账户名称
                            <td class="textRight">#springMessage('table.choInnerFinance.capitalAccName')</td>
                            <td>
                                $!{interestSingleNodBookVO.capitalAccName}
                            </td>
                        </tr>
                        <tr>
                            ##利息转入账号
                            <td class="textRight">#springMessage('table.choInnerFinance.interestAcc')</td>
                            <td width="40%">
                                $!{interestSingleNodBookVO.interestAcc}
                            </td>
                            ##利息转入账户名称
                            <td class="textRight">#springMessage('table.choInnerFinance.interestAccName')</td>
                            <td>
                                $!{interestSingleNodBookVO.interestAccName}
                            </td>
                        </tr>
                        <tr>
                            ##预计利息
                            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.anticInterest')</td>
                            <td width="40%">
                                $number.formatNumeric($!{interestSingleNodBookVO.expectInterest})
                            </td>
                            ##用途
                            <td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
                            <td>
                                $!{interestSingleNodBookVO.purpose}
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight">#springMessage('fcVoucherType.rmk')</td>
                            <td colspan="3">
                                $!{interestSingleNodBookVO.remark}
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script >
    bt.use(['form','layedit','moneyType','printType'], function(){
        var $ = bt.jquery,form = bt.form();
        var moneyType = bt.moneyType.init();
        var moneyFun = bt.moneyType.getFun();
        bt.printType.init();

    });
</script>
</html>
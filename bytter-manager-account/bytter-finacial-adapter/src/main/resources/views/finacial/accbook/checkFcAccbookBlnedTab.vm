<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")

<style type="text/css">
.layui-body2 {
	padding：0px;
	position: absolute;
	left: 0px;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 998;
	width: auto;
	overflow: hidden;
	overflow-y: auto;
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box;
}
</style> 
</head>
<body>
	<form class="layui-form" method="post" >
	<input id="id" name="id" type="hidden" value="$!{id}">
	<input id="origVoucherNo" name="origVoucherNo" value="$!{origVoucherNo}" type="hidden"/>
	<input id="busGlobalId" name="busGlobalId" value="$!{busGlobalId}" type="hidden"/>
	<input id="newId" name="newId" value="$!{newId}" type="hidden"/>
	<input id="pageType" name="pageType" value="check" type="hidden"/>
		<div class="layui-body2 my-body">
	        <div class="layui-tab layui-tab-card my-tab" lay-filter="card2" >
				<ul class="layui-tab-title">
					<li class="layui-this" lay-id="rushbook">#springMessage('table.fcOutAccbook.strikeVoucher')</li>##冲账凭证
					<li lay-id="oribook">#springMessage('table.fcOutAccbook.oldVoucher')</li>##原凭证
					<li lay-id="newbook" >#springMessage('table.fcOutAccbook.newVoucher')</li>##录入新凭证
				</ul>
	            <div class="layui-tab-content" style="width: 100%; height: 100%">
	                <div class="layui-tab-item layui-show" style="width: 100%; height: 100%">
	                	<iframe id="rushiframe" src="${basePath}/finacial/accbook/fcaccbookblned/viewDes?id=$!{id}&opType=check" frameborder="0" style="width: 100%; height: 100%"></iframe>
	                </div>
	                <div class="layui-tab-item" style="width: 100%; height: 100%">
	                ##已日结凭证
	                	<iframe id="oriiframe" src="${basePath}/finacial/accbook/fcaccbookblned/view?id=$!{origVoucherNo}" frameborder="0" style="width: 100%; height: 100%"></iframe>
	                </div>
	                <div class="layui-tab-item" id="newiframeDiv" style="width: 100%; height: 100%; overflow-y: auto; display: none">
	                	<iframe id="newiframe" src="${basePath}/finacial/accbook/fcaccbook/view?id=$!{newId}&opType=check" frameborder="0" style="width: 100%; height: 100%;"></iframe>
	                </div>
	            </div>
				<div class="layui-form-item" style="text-align: center;position: absolute;bottom: 0px;width: 100%;padding: 0px 20px;background: #fff;box-sizing: border-box;">
				    <table id="endTable" class="layui-table">
				        <tr>
				            <td width="10%" class="textRight" >#springMessage('table.fcAccbookExt.backReason')</td>
				            <td colspan="6">
				                <div class="layui-input-inline" style="width:100%">
				                    <textarea placeholder="#springMessage('table.fcAccbookExt.backReason')" rows=4 cols=64 class="layui-textarea" id="backReason" name="backReason" data-maxlength="200">$!{fcAccPage.checkBackReason}</textarea>
				                </div>
				            </td>
				        </tr>
						<tr>
							##附件
							<td>#springMessage('cms.loan.attachment')</td>
							<td colspan="6">
								<input id="attachmentId" name="attachmentId" type="hidden" value="$!{voucher.accbook.attachmentId}"/>
								<div id="uploader" class="layui-input-inline" style="width:100%"></div>
							</td>
						</tr>
			    	</table>
					<div class="layui-inline">
						<button class="layui-btn" lay-submit lay-filter="back">#springMessage('common.button.back')</button>
						<button class="layui-btn" lay-submit lay-filter="pass">#springMessage('common.button.pass')</button>
						<button class="layui-btn" lay-submit lay-filter="revert">#springMessage('common.button.revert')</button>
					</div>
				</div>
			</div>
	    </div>
	</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/accbook/fcAccbookBlned.check.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 22px;
	text-decoration: underline;
	text-align: center;
	/*color: blue;*/
	/*color: #00CC33;*/
}
.layui-input {
	width: 148px;
}
#searchTable td,#searchTable{
	border:none!important;
}
</style>
</head>
<body>
	<form class="layui-form enter-switch" method="post">
        <input id="pageType" name="pageType" value="edit" type="hidden"/>
		<input id="id" name="accbook.id" type="hidden" value="$!{voucher.accbook.id}">
		<input id="id" name="accbook.busGlobalId" type="hidden" value="$!{voucher.accbook.busGlobalId}">
		<input id="tenantId" name="accbook.tenantId" type="hidden" value="$!{voucher.accbook.tenantId}">
		<input id="netId" name="accbook.netId" type="hidden" value="$!{voucher.accbook.netId}">
		<input id="orderNo" name="accbook.orderNo" type="hidden" value="$!{voucher.accbook.orderNo}">
		<input id="voucherNo" name="accbook.voucherNo" type="hidden" value="$!{voucher.accbook.voucherNo}">
		<input id="operatorCode" name="accbook.operatorCode" type="hidden" value="$!{voucher.accbook.operatorCode}">
		<input id="bookDtlSize" name="bookDtlSize" type="hidden" value="$!{bookDtlSize}">
		<input id="externalType" type="hidden" value="$!{voucher.bookExt.externalType}">
		<input id="typeSign" type="hidden" value="$!{voucher.bookExt.typeSign}">
		<input id="bankTypeAcc" name="bankCode" type="hidden"/>
		<div id="multiIframes" style="display: none" data-flag="$!{multiIframes}"></div>
	<div class="input150-container">
		<table class="layui-table" id="searchTable">
			<tr>
				<td colspan="6">
					<div class="voucher-title">
					##记账凭证
						<label>#springMessage('table.fcAccbook.tallyTitle')</label>
					</div>
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.fcAccbook.voucherType')<span style="color:red">*</span></td>
				<td>
					<div class="layui-input-inline">
						<!-- <div type="list" field="accbook.voucherType" search="false" fieldHref="${basePath}/netbank/fcvouchertype/json" dictField="id" dictText="voucherName" defaultVal="$!{voucher.accbook.voucherType}"></div> -->
						<div class="bt-biz-selectType" data-name="accbook.voucherType"
							 data-url="${basePath}/netbank/fcvouchertype/getValidVoucherType" data-valuefield="id" data-textfield="voucherName" data-required="true" data-defaultvalue="$!{voucher.accbook.voucherType}"></div>
					</div>
				</td>
				<td></td>
				<td></td>
				<td class="textRight">#springMessage('table.fcAccbook.affixAmount')</td>
				<td>
					<div class="layui-input-inline">
						<!--number-->
						<input type="text" id="affixAmount" data-name="accbook.affixAmount" data-type="int" maxlength="2" value="$!{voucher.accbook.affixAmount}"
							   decimal="0" autocomplete="off" class="layui-input input-normal" placeholder="#springMessage('table.fcAccbook.affixAmount')">
					</div>
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('table.fcAccbook.busRaceId')<span style="color:red">*</span></td>
				<td>
					<div class="layui-input-inline">
						<!-- <div type="list" field="accbook.busRaceId" fieldHref="${basePath}/finacial/accbook/fcaccbook/getUserBusRace"
						dictField="id" dictText="raceName" defaultVal="$!{voucher.accbook.busRaceId}"></div> -->
						<div class="bt-biz-selectType" data-name="accbook.busRaceId"
							 data-url="${basePath}/finacial/accbook/fcaccbook/getUserBusRace"
							 data-valuefield="id" data-textfield="raceName" data-required="true" data-defaultvalue="$!{voucher.accbook.busRaceId}"></div>
					</div>
				</td>
				<td class="textRight">#springMessage('table.fcAccbook.tallyDate')<span style="color:red">*</span></td>
				<td>
					<div class="layui-input-inline">
						<input type="text" name="accbook.tallyDate" class="layui-input bt-biz-dateType" data-type="date"
							   data-biz-name="tallyDate" lay-verify="required" value="$!date.format('yyyy-MM-dd',$!voucher.accbook.tallyDate)">
					</div>
				</td>
				<td class="textRight">#springMessage('table.fcAccbook.interestStartDate')<span style="color:red">*</span></td>
				<td>
					<div class="layui-input-inline">
						<input type="text" name="accbook.interestStartDate" class="layui-input bt-biz-dateType" data-type="date"
							   data-biz-name="interestStartDate" lay-verify="required" value="$!date.format('yyyy-MM-dd',$!voucher.accbook.interestStartDate)">
					</div>
				</td>
			</tr>
		</table>
		## 凭证表格数据
		<table id="printMRTable" class="layui-table layui-table-border ignore-required-icon">
			<thead>
				<tr>
					<th style="text-align: center;">#springMessage('table.fcAccbookDtl.summaryContent')<span style="color:red">*</span></th>
					<th style="text-align: center;">#springMessage('table.fcAccbookDtl.account')<span style="color:red">*</span></th>
					<th style="text-align: center;">#springMessage('table.fcAccbookDtl.accName')</th>
					<th style="text-align: center;">#springMessage('table.fcAccbookDtl.origVoucherNo')</th>
					<th style="text-align: center;">#springMessage('table.fcAccbookDtl.debitMoney')<span style="color:red">*</span></th>
					<th style="text-align: center;">#springMessage('table.fcAccbookDtl.creditMoney')<span style="color:red">*</span></th>
					<th style="text-align: center;">#springMessage('finacial.common.cashFlow.item')</th>#*现金流项目*#
					<th style="text-align: center;">#springMessage('common.table.thead.operation')</th>
				</tr>
			</thead>
			<tfoot>
				<td style="text-align: right">#springMessage('table.interet.sum')：</td>
				<td >&nbsp;</td>
				<td >&nbsp;</td>
				<td >&nbsp;</td>
				<td style="text-align: right;" ><span id='debitTot' val="$!{debitTot}">$!{debitTotStr}</span></td>
				<td style="text-align: right;" ><span id='creditTot' val="$!{debitTot}">$!{debitTotStr}</span></td>
				<td >&nbsp;</td>
				<td >&nbsp;</td>
			</tfoot>
		</table>
		<table class="layui-table">
			<thead>
			<tr>
				<th style="text-align: left;" colspan="7">#springMessage('对方信息')</th>
			</tr>
			</thead>

			<input type="hidden" id="externalSign" value="$!{externalSign}">
			<tbody>
			<tr>
				<td colspan="7">
					<div class="layui-form">
						<div class="bt-biz-dict"
							 data-type="radio"
							 data-group="fin.tally.other.info"
							 data-defaultvalue="$!{voucher.bookExt.externalType}"
							 data-name="bookExt.externalType"
							 data-biz-name="externalType"
							 data-callback="otherInfoChange"></div>
					</div>
				</td>
			</tr>
			<tr>
				<td colspan="7">
					<div class="layui-form">
						<div class="bt-biz-dict"
							 data-type="radio"
							 data-group="btBankAcc.isDomesticBank"
							 data-defaultvalue="$!{voucher.bookExt.typeSign}"
							 data-name="bookExt.typeSign"
							 data-biz-name="typeSign"
							 data-callback="isDomesticBankChange"></div>
					</div>
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('对方名称')</td>
				<td>
					<div class="layui-input-inline">
						<input type="text" id="accName" name="bookExt.externalCorp" value="$!{voucher.bookExt.externalCorp}" readonly="readonly" autocomplete="off" class="layui-input" data-biz-name="bankAccTable1">
						<div class="ke">##客商
							<div class="bt-div-search" id="domestic">##境内
								<button  class="bt-biz-externalCorpBankAcc" type="button" data-beforeClick="bt.externalCorpBankAccParams" data-callback="bt.externalCorpCallback" title="#springMessage('common.button.select')">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>

							<div class="bt-div-search" id="abroad" style="display: none">##境外
								<button  class="bt-biz-externalCorpBankAccFex" type="button" data-beforeClick="bt.externalCorpBankAccFexParams" data-callback="bt.externalCorpCallback" title="#springMessage('common.button.select')">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>
						</div>

						<div class="corp" style="display: none">##网点/单位
							<div class="bt-div-search bankDomestic">##境内
								<button class="bt-biz-bankAccDomestic" type="button"  data-callback="bt.bankAccCallback">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>

							<div class="bt-div-search bankAbroad" style="display: none">##境外
								<button class="bt-biz-bankAccAbroad"  type="button"  data-callback="bt.bankAccCallback">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>
						</div>

						<div class="bank" style="display: none">##银行
							<div class="bt-div-search isSwiftN">
								<button class="bt-biz-bankInfo" type="button" data-callback="bt.bankinfoCallback" data-beforeClick="bt.bankInfoBeforeClick">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>
						##境外
							<div class="bt-div-search isSwiftY" style="display:none">
								<button class="bt-biz-swiftInfo" type="button"  data-callback="bt.swiftInfoCallback">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>
						</div>
					</div>
				</td>

				<td class="textRight">#springMessage('table.btBankAccDtl.oppAccNo')</td>
				<td>
					<input type="text" id="acc" name="bookExt.externalAcc" value="$!{voucher.bookExt.externalAcc}" readonly="readonly" autocomplete="off" class="layui-input">
				</td>

				<td class="textRight">#springMessage('table.btNetChalk.oppBankName')</td>
				<td>
					<div class="layui-input-inline">
						<input id="externalProv" name="bookExt.externalProv" type="hidden"/>
						<input id="externalCity" name="bookExt.externalCity" type="hidden"/>
						<input type="text" id="accBank" name="bookExt.externalBank" value="$!{voucher.bookExt.externalBank}" autocomplete="off" readonly="readonly"  class="layui-input">
						<div class="keBankType" style="display: none">##客商
							<div class="bt-div-search isSwiftNType">##境内
								<button class="bt-biz-bankInfo" type="button"  data-callback="bt.bankTypeCallback" data-beforeClick="bt.bankInfoBeforeClick">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>

							<div class="bt-div-search isSwiftYType" style="display:none">##境外
								<button class="bt-biz-swiftInfo" type="button"  data-callback="bt.swiftTypeCallback">
									<i class="layui-icon">&#xe615;</i>
								</button>
							</div>
						</div>
					</div>
				</td>
			</tr>

			</tbody>
		</table>
		<div class="layui-form-item">
			<div class="layui-inline" >
				##加急标志
				<label class="layui-form-label">#springMessage('table.fcAccbook.emergencySign')</label>
				<div class="layui-input-inline">
					<!-- #set ($emergencySignMap = {"field":"accbook.emergencySign","type":"radio","typeGroupCode":"Accbook.EmergencySign","defaultVal":"$!{voucher.accbook.emergencySign}","title":"table.fcAccbook.emergencySign"})
					#set ($emergencyForm = $dictSelect.instance($emergencySignMap))
					${emergencyForm.html()} -->
					#if("$!{opType}" == "true")
					<div class="bt-biz-dict" data-group="Accbook.EmergencySign" data-name="accbook.emergencySign" data-type="radio" data-required="true"  data-defaultvalue="$!{voucher.accbook.emergencySign}"></div>
					#else
					<div class="bt-biz-dict" data-group="Accbook.EmergencySign" data-name="accbook.emergencySign" data-type="radio" data-required="true"  data-defaultvalue="F"></div>
					#end
				</div>
			</div>
		</div>
	</div>
		<div class="layui-form-item">
			<div class="layui-block">
				##备注
				<label class="layui-form-label">#springMessage('table.fcAccbook.rmk')<span style="color:red">*</span></label>
				<div class="layui-input-block">
					<!--number-->
					<input type="text" id="rmk" name="accbook.rmk" maxlength="40" style='width:100%;' lay-verify="required"
					 autocomplete="off" class="layui-input" value="$!{voucher.accbook.rmk}" placeholder="#springMessage('table.fcAccbook.rmk')">
				</div>
			</div>
		</div>
		<div class="layui-form-item">
			<div class="layui-block">
				##附件
				<label class="layui-form-label">#springMessage('cms.loan.attachment')</label>
				<div class="layui-input-block" >
					<input id="attachmentId" name="accbook.attachmentId" type="hidden" value="$!{voucher.accbook.attachmentId}" >
					<div id="uploader" class="layui-input-inline" style="width:100%"></div>
				</div>
			</div>
		</div>
		#if($!{opType} == "true")
		<div class="layui-form-item">
			<div class="layui-input-block">
				<button class="layui-btn" lay-submit="" lay-filter="temp">#springMessage('common.button.temp')</button>
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
			</div>
		</div>
		#end
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/accbook/fcAccbook.edit.js?_btv=${resourceVersion}"></script>

</html>

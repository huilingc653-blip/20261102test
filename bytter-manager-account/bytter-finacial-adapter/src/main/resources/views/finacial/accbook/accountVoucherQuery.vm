<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
	<style>
		.bgRed td{
			background-color: #F4F4F6;
		}
		.dark-skin .bgRed td{
			background-color: #2C2D31;
		}
	</style>
</head>
<body>
<form id="searchForm" class="layui-form">
	<table class="layui-table">
		<input type="hidden" id="opt" name="opt" value="query">
		<input type="hidden" id="total" value="${model.total}">
		<input type="hidden" id="curr" value="${model.curr}">
		<input type="hidden" id="len" value="${model.len}">
		<tbody>
		<tr>
			##网点
			<td class="textRight">#springMessage('table.fcAcc.netId')</td>
			<td class="rCode">
				<div class="layui-input-inline">
					<div class="bt-biz-corp" data-biz-type="net" data-type="selectTree" data-resource="fcl:accbook:common:query"
						 data-name="netCode" data-scope="net" data-biz-name="netCode" data-defaultvalue="$!{netId}"></div>
				</div>
			</td>
			##业务种类
			<td class="textRight">#springMessage('table.fcAccbook.busRaceId')</td>
			<td class="rCode">
				<div class="layui-input-inline">
					<div class="bt-biz-selectType" data-name="busRaceId" id="busRaceId" data-biz-name="busRaceId" data-defaultvalue="$!{busRaceId}"
						 data-url="${basePath}/finacial/accbook/fcaccbook/getBusRace" data-valuefield="id" data-textfield="raceName"></div>
				</div>
			</td>
			##记账日期
			<td class="textRight">#springMessage('table.fcAccbook.tallyDate')</td>
			<td class="rCode">
				<div class="layui-inline">
					<input type="text" data-biz-name="gedTallyDate" name="gedTallyDate"
						   class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date" value="$!{gedTallyDate}">
				</div>
				<div class="layui-inline">~</div>
				<div class="layui-inline">
					<input type="text" data-biz-name="ledTallyDate" name="ledTallyDate"
						   class="layui-input bt-biz-dateType" id="startDate" data-type="date" value="$!{ledTallyDate}">
				</div>
			</td>
		</tr>
		<tr>
			##帐号
			<td class="textRight">#springMessage('table.fcAccbookDtl.account')</td>
			<td class="rCode"><div class="layui-inline">
				<input type="text" name="account" id="account" class="layui-input text" data-biz-name="account" value="$!{account}">
				<table id="example" class="hide">
					<thead>
					<tr>
						<th>#springMessage("table.fcAccbookDtl.account")</th>
						<th>#springMessage("table.fcAccbookDtl.accName")</th>
					</tr>
					</thead>
				</table>
			</div>
			</td>
			##账户名称
			<td class="textRight">#springMessage('table.fcAcc.accName')</td>
			<td class="rCode">
				<div class="layui-inline">
					<input type="text" name="accName" id="accName" value="$!{accName}" autocomplete="off" class="layui-input">
				</div>
			</td>

			##凭证号
			<td class="textRight">#springMessage('table.fcAccbook.voucherNo')</td>
			<td class="rCode input100" >
				<div class="layui-inline">
					<input type="text" name="gesVoucherNo" id="gesVoucherNo" value="$!{gesVoucherNo}"
						   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbook.voucherNo')">
				</div>
				<div class="layui-inline">~</div>
				<div class="layui-inline">
					<input type="text" name="lesVoucherNo" id="lesVoucherNo" value="$!{lesVoucherNo}"
						   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbook.voucherNo')">
				</div>
			</td>
		</tr>
		<tr>
			##凭证种类
			<td class="textRight">
				#springMessage('table.fcAccbook.voucherType')
			</td>
			<td class="rCode">
				<div class="bt-biz-selectType" data-name="voucherType" data-defaultvalue="$!{voucherType}" data-biz-name="voucherType"
					 data-url="${basePath}/netbank/fcvouchertype/getValidVoucherType" data-valuefield="id" data-textfield="voucherName"></div>
			</td>
			##币别
			<td class="textRight">
				#springMessage('table.fcBusinessRuleDefine.curCode')
			</td>
			<td class="rCode">
				<div class="layui-input-inline">
					<div class="bt-biz-selectType" data-biz-name="curCode" data-url="${basePath}/basic/business/btcurrency/json"
						 data-valuefield="id" data-textfield="curName" data-name="curCode" data-defaultvalue="$!{curCode}"></div>
				</div>
			</td>
			##流水号
			<td class="textRight">#springMessage('table.fcAccbook.orderNo')</td>
			<td class="rCode input100">
				<div class="layui-inline">
					<input type="text" name="gesOrderNo" id="gesOrderNo" value="$!{gesOrderNo}"
						   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbook.orderNo')">
				</div>
				<div class="layui-inline">~</div>
				<div class="layui-inline">
					<input type="text" name="lesOrderNo" id="lesOrderNo" value="$!{lesOrderNo}"
						   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbook.orderNo')">##	流水号
				</div>
			</td>
		</tr>

		<tr>
			##凭证状态
			<td class="textRight">#springMessage('table.fcAccbook.voucherState')</td>
			<td class="rCode">
				<div class="layui-inline">
					<div class="bt-biz-dict" data-type="select" data-name="voucherState" data-biz-name="voucherState"
						 data-group="Finacial.VoucherStatus" data-defaultvalue="$!{voucherState}"></div>
				</div>
			</td>
			##	金额
			<td class="textRight">#springMessage('table.ratUration.money')</td>
			<td style="text-align:left;">
				<input type="text" data-name="gegMoney" data-biz-name="gegMoney" id="gegMoney" value="$!{gegMoney}" class="layui-input bt-input-inline  bt-biz-moneyType" data-moneyendid="money" data-minus="true">
				<span class="date-mid">~</span>
				<input type="text" data-name="legMoney" data-biz-name="legMoney" id="legMoney" value="$!{legMoney}" class="layui-input bt-input-inline  bt-biz-moneyType" id="money" data-minus="true">
			</td>

			##原始凭证号
			<td class="textRight">#springMessage('table.fcAccbookDtl.origVoucherNo')</td>
			<td class="rCode">
				<div class="layui-inline">
					<input type="text" name="origVoucherNo" id="origVoucherNo" value="$!{origVoucherNo}"
						   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookDtl.origVoucherNo')">
				</div>
			</td>
		</tr>
		<tr>
			##摘要
			<td class="textRight">#springMessage('table.fcAccbookDtl.summaryContent')</td>
			<td class="rCode">
				<div class="layui-inline">
					<input type="text" name="summaryContent" id="summaryContent" value="$!{summaryContent}"
						   autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookDtl.summaryContent')">
				</div>
			</td>
			<td></td>
			<td></td>
			<td></td>
			<td></td>
		</tr>
		<tr>
			<td colspan="6" style="text-align: center;">
				<button type="button" class="layui-btn" lay-submit="" lay-filter="search">#springMessage('common.button.search')</button>
				#*打印记账凭证*#
				<button type="button" class="layui-btn" lay-submit="" lay-filter="voucher">#springMessage('table.interet.vourcher')</button>
				<button type="reset" class="layui-btn layui-btn-primary" data-callback = "resetCode()">#springMessage('common.button.reset')</button>
				<button type="button" class="layui-btn " lay-submit="" lay-filter="excel">#springMessage('common.button.exports')</button>
				<button class="layui-btn bt-biz-printType" type="button" data-printareaid="appTable_tableData">打印</button>
			</td>
		</tr>
		</tbody>
	</table>
</form>
<div>
<div id="tbl" style="width:100%;overflow:auto;margin-top:10px;display: none;" >
	<div id="print">
		<table id="appTable" class="layui-table layui-form dark-layui-table" style="width:100%;">
			<thead>
			<tr class="title">
				<!-- <td colspan="1">选择</td> -->
				<td colspan="7" align="center">#springMessage('cms.loan.oldInfo')</td>
				<td colspan="7" align="center">#springMessage('table.Account.entry.info')</td>
				<td colspan="4" align="center">#springMessage('cms.loan.OtherInfo')</td>
			</tr>
			<tr>
				<th style="padding-left: 11px"><div id="testtest" style=""><input type="checkbox" lay-skin="primary" value="test" lay-filter="choseAll" class="choseAll"/></div></th>
				<th>#springMessage('table.fcAccbook.tallyDate')</th>
				<th>#springMessage('table.fcAccbook.interestStartDate')</th>
				<th>#springMessage('table.fcAccbook.busRaceId')</th>
				<th>#springMessage('table.fcAccbook.orderNo')</th>
				<th>#springMessage('table.fcAccbook.voucherNo')</th>
				##	凭证种类 voucherType
				<th>#springMessage('table.fcAccbook.voucherType')</th>
				<th>#springMessage('table.fcAccbookDtl.account')</th>
				<th>#springMessage('table.fcAccbookDtl.accName')</th>
				<th>#springMessage('table.fcAccbookDtl.summaryContent')</th>
				<th>#springMessage('table.fcAccbookDtl.origVoucherNo')</th>
				<th>#springMessage('table.fcAccbookDtl.debitMoney')</th>
				<th>#springMessage('table.fcAccbookDtl.creditMoney')</th>
				<th>#springMessage('table.fcAccbookDtl.balance')</th>
				<th>#springMessage('table.fcAccbook.operatorCode')</th>
				<th>#springMessage('table.fcAccbook.checkerCode')</th>
				<th>#springMessage('table.fcAccbook.emergencySign')</th>
				<th>#springMessage('table.fcAccbook.voucherState')</th>
			</tr>
			</thead>
			<tbody id="check">
				#foreach($bookAndBlneds in $!{model.bookAndBlneds})
				<tr class="testBg">
					<td class="rid" align="center" rowspan="$!{bookAndBlneds.dtlSize}"><input type="checkbox" name="test1" lay-skin="primary" value="$!{bookAndBlneds.id}" /></td>
					<td align="center" rowspan="$!{bookAndBlneds.dtlSize}">$!date.format('yyyy-MM-dd',$!bookAndBlneds.tallyDate)</td>
					<td align="center" rowspan="$!{bookAndBlneds.dtlSize}">$!date.format('yyyy-MM-dd',$!bookAndBlneds.interestStartDate)</td>
					<td align="center" rowspan="$!{bookAndBlneds.dtlSize}">
						#if($i18nTag.getBusinessBaseContext($!{bookAndBlneds.raceId}) == "")
							$!{bookAndBlneds.raceName}
						#else
							$i18nTag.getBusinessBaseContext($!{bookAndBlneds.raceId})
						#end
					</td>
					<td align="center" rowspan="$!{bookAndBlneds.dtlSize}"><a href="#" onclick="view('$!{bookAndBlneds.id}')">$!{bookAndBlneds.orderNo}</a></td>
					<td align="center" rowspan="$!{bookAndBlneds.dtlSize}">$!{bookAndBlneds.voucherNo}</td>
					<td align="center" rowspan="$!{bookAndBlneds.dtlSize}">$!{bookAndBlneds.voucherName}</td>
					#foreach($bookDtl in $!{bookAndBlneds.accbookDtl})
						#if($velocityCount == 1)
							<td align="center" > $!{bookDtl.account}</td>
							<td align="center" >$!{bookDtl.accName}</td>
							<td align="center" >$!{bookDtl.summaryContent}</td>
							#if(${bookAndBlneds.busOriType} >= 80 && ${bookAndBlneds.busOriType} <= 109)
								<td align="center"><a href="#"  onclick="viewByVoucherNo('$!{bookAndBlneds.busOriType}','$!{bookDtl.origVoucherId}')">$!{bookDtl.origVoucherNo}</a></td>##票据
							#elseif(${bookAndBlneds.busOriType} == 49)
								<td></td>
							#elseif(${bookAndBlneds.busOriType} == 23 || ${bookAndBlneds.busOriType} == 10 || ${bookAndBlneds.busOriType} == 29)
								<td align="center">$!{bookDtl.origVoucherNo}</td>
							#else
								<td align="center"><a href="#"  onclick="viewByVoucherNo('$!{bookAndBlneds.busOriType}','$!{bookDtl.origVoucherNo}')">$!{bookDtl.origVoucherNo}</a></td>
							#end
							<td align="right" >$number.formatNumeric($!{bookDtl.debitMoney})</td>
							<td align="right" >$number.formatNumeric($!{bookDtl.creditMoney})</td>
							<td align="right" >$number.formatNumeric($!{bookDtl.balance})</td>
						#end
					#end
					<td align="center" rowspan="$!{bookAndBlneds.dtlSize}">$!{bookAndBlneds.operatorCode}</td>
					<td align="center" rowspan="$!{bookAndBlneds.dtlSize}">$!{bookAndBlneds.checkerCode}</td>
					<td align="center" rowspan="$!{bookAndBlneds.dtlSize}">$dictTag.get("Accbook.EmergencySign", $!{bookAndBlneds.emergencySign})</td>
					<td align="center" rowspan="$!{bookAndBlneds.dtlSize}">$dictTag.get("Finacial.VoucherStatus", $!{bookAndBlneds.voucherState})</td>
				</tr>
					#foreach($bookDtl in $!{bookAndBlneds.accbookDtl})
						#if($velocityCount > 1)
						<tr class="testBg" >
							<td align="center">
								$!{bookDtl.account}
							</td>
							<td align="center">
								$!{bookDtl.accName}
							</td>
							<td align="center">
								$!{bookDtl.summaryContent}
							</td>
							<td align="center">
								#if(${bookAndBlneds.busOriType} >= 80 && ${bookAndBlneds.busOriType} <= 109)
									<a href="#"  onclick="viewByVoucherNo('$!{bookAndBlneds.busOriType}','$!{bookDtl.origVoucherId}')">$!{bookDtl.origVoucherNo}</a>##票据
								#elseif(${bookAndBlneds.busOriType} == 49)
								#elseif(${bookAndBlneds.busOriType} == 23 || ${bookAndBlneds.busOriType} == 10 || ${bookAndBlneds.busOriType} == 29)
									$!{bookDtl.origVoucherNo}
								#else
									<a href="#"  onclick="viewByVoucherNo('$!{bookAndBlneds.busOriType}','$!{bookDtl.origVoucherNo}')">$!{bookDtl.origVoucherNo}</a>
								#end
							</td>
							<td align="right">
								$number.formatNumeric($!{bookDtl.debitMoney})
							</td>
							<td align="right">
								$number.formatNumeric($!{bookDtl.creditMoney})
							</td>
							<td align="right">
								$number.formatNumeric($!{bookDtl.balance})
							</td>
						</tr>
						#end
					#end
				</tr>
				#end
			</tbody>
		</table>
	</div>
</div>
<div id="page" style="width:100%"></div>
</div>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/report/export.js?_btv=${resourceVersion}"></script>
<script type="text/javascript" charset="utf-8">
	var corpInit;
	var dateType;
	var selectType;
	var dicts,form;
	var moneyType;
	bt.use(['form','datatable','btdate','corp','moneyType','laypage','dateType','selectType','date','dicts','jquery','element','selectTable','page','printType','freezeTable','relaypage'], function(){
		var $ = bt.jquery;
		form = bt.form();
		dateType=bt.dateType.init();
		selectType=bt.selectType.init();
		dicts=bt.dicts.init();
		moneyType=bt.moneyType.init();
		bt.printType.init();
		bt.selectTable.init({
			elem: "#example",
			url: basePath+"/inneraccount/fcacc/getValidAccountIsHavDel",
			scrollX:"500px",
			scrollY:"200px",
			searchInput:"#account",
			columns: [
				{data:"blnctrAcc",},
				{data:"accName",}
			],
			clickCallback:function(data){
				//设置账户
				$("#account").val(data.blnctrAcc);
			}
		});

		var pages = 0
		try {
			pages = Math.ceil($!{model.total} / $!{model.len})
		}catch (e) {
			pages = 0
		}
		bt.relaypage({
			cont: 'page',
			pages: pages,
			curr:$!{model.curr},
			resultCount:$!{model.total},
			limit:$!{model.len}, // 每页显示的数量
			limits:[10,25,50,100,500], // 每页条数选项
			layout: ['count', 'prev', 'page', 'next', 'limit', 'refresh', 'skip'],
			skip:true,
			jump:function(obj, first){
				if(!first){
					location.href = basePath + "/finacial/accbook/financialquery/list?"+getParam()+"&start="+obj.curr+"&len="+obj.limit;
				}
			}
		});

		## bt.page.init({
		## 	elem:'#page',//分页组件容器
		## 	count:$!{model.total}, //表格总页码
		## 	currentPage:$!{model.curr},//当前页码，默认值为 0,即第一页
		## 	len : $!{model.len}, //当前显示条数，默认值为10
		## 	jump:function(obj){ //翻页回调方法
		## 		var curr = obj.curr;
		## 		var len = obj.len;
		## 		location.href = basePath + "/finacial/accbook/financialquery/list?"+getParam()+"&start="+curr+"&len="+len;
		## 	}
		## })

		$("#tbl").show();
		var height = $(window).height();
		var tableHeight = height - 260;
		if (tableHeight < 400){
			tableHeight = 400;
		}
		bt.freezeTable.init({
			elem:'#appTable',//表格id
			freezeRowNum:'2',//冻结几行
			//注意：本表使用 rowspan 合并单元格，且明细行(7列)与主行(18列)列数不一致，
			//freezeTable 的冻结列是“整表克隆 + 窄容器裁切”实现，克隆表列宽/行高都与原表对不上，
			//会把克隆表第2列(记账日期)的内容露在冻结区里，表现为“记账日期左侧多出一个小符号”，
			//因此这里不冻结列(freezeColumnNum:'0')，与 listVoucherBook.vm 保持一致
			freezeColumnNum:'0',//冻结几列
			height:tableHeight+'px', //表格高度
			callBack:function (){
				$(".freeze-table-container").css({"overflow" : "visible"});
				$("#tbl").css({"overflow" : "visible"});
			}
		})

		var queryVoucher = function(){
		}
		//重置
		resetCode = function(){
			var inputs = $('.rCode').find('input');
			inputs.each(function(){
				$(this).val("");
			})
			moneyType.get("legMoney").val("");
			moneyType.get("gegMoney").val("");
			moneyType.render();
			var selects = $('.rCode').find('.bt-biz-selectType,.bt-biz-dict');
			bt.each(selects,function () {
				$(this).find('select').val(' ');
			})
			form.render('select');
		}

		//查询
		form.on('submit(search)', function(data){
			search();
			//form.render();
		});

		//打印记账凭证
		form.on('submit(voucher)',function(data){
			var id_array=new Array();
			$('input[name="test1"]:checked').each(function(){
				var value = $(this).val();
				if (id_array.indexOf(value) === -1){
					id_array.push(value);//向数组中添加元素
				}
			});
			var ids = id_array.join(',');//将数组元素连接起来以构建一个字符串
			if (ids == null || ids == "" || ids == undefined) {
				parent.layer?parent.layer.alert(bt.lang("common.select.voucher"), {icon: 2}):layer.alert(bt.lang("common.select.voucher"), {icon:2});
				return false;
			}
			voucher(ids);
		});

		form.on('submit(excel)', function(data) {
			var url = basePath+"/finacial/accbook/financialquery/exportExcel";
			DownLoadFile({url:url,data:data.field,method:'post'});
			return false;
		});

		corpInit = bt.corp.init();
		//实现全选反选
		form.on('checkbox(choseAll)',function (data) {
			$(".choseAll").each(function () {
				this.checked = data.elem.checked;
			})
			$("input[name=test1]").each(function () {//循环改变单选框的选中状态
				this.checked = data.elem.checked;
			});
			//获取name=test1
			if(data.elem.checked) {
				$("#appTable_tableLayout").find("table tbody").find('tr').addClass("bgRed");
			}else{
				$("#appTable_tableLayout").find("table tbody").find('tr').removeClass("bgRed");
			}
			form.render("checkbox");
		});
		var addSelectedTr = function(currentTr,rowspan) {
			var nextTr;
			if( rowspan > 1) {
				nextTr = currentTr.next('tr').toggleClass('bgRed');
				rowspan --;
			}
			if(rowspan > 1 && nextTr && nextTr.length ){//使用递归方式动态减少样式
				rowspan = addSelectedTr(nextTr,rowspan)
			}
			return rowspan;
		}

		var clickChildrenCheckboxFn = function(currentTr){
			var rowspan = currentTr.find("td:eq(1)").attr("rowspan");
			//颜色控制// 如果没有某个样式则加上，否则去除
			if (currentTr.hasClass("bgRed")){//如果有某个样式则表明，这一行已经被选中
				addSelectedTr(currentTr,rowspan);
				//改变复选框的选中状态
				currentTr.children().first().children().prop("checked", "");
			} else {
				//改变复选框的选中状态
				currentTr.children().first().children().prop("checked", "checked");
				addSelectedTr(currentTr,rowspan);
			}
			currentTr.toggleClass("bgRed");
		}
		//单选
		$("#check tr").click(function () {
			//1 如果当前行没有复选框，不执行选中逻辑
			if (!$(this).find("input[name=test1]").length){
				return
			}
			//2 由于有冻结表格，需要获取所有的表格对象对就索引的tr行；
			var rowIndex = $(this).index();
			var linkAllTrs = $("#appTable_tableLayout").find("table tbody").find("tr:eq("+rowIndex+")");
			//3 遍历获取的tr，添加对应的样式及选中
			bt.each(linkAllTrs,function () {
				clickChildrenCheckboxFn($(this));
			})
			//选中时的长度
			var length=$("input[name=test1]:checked").length;
			//未选中时的长度
			var len=$("input[name=test1]").length;
			//长度相等全选框选中
			var isCheckedAll = length==len;
			$(".choseAll").each(function () {
				this.checked = isCheckedAll;
			})
			form.render("checkbox");
		});
	});

	var getParam = function(){
		var param="";
        var accName = window.encodeURI(window.encodeURI($("#accName").val()));
		param += "netCode="+corpInit.get('netCode').val()+"&busRaceId="+selectType.get('busRaceId').val()+
				"&gedTallyDate="+dateType.get('gedTallyDate').val()+"&ledTallyDate="+dateType.get('ledTallyDate').val()+
				"&account="+$("#account").val()+"&origVoucherNo="+$("#origVoucherNo").val()+"&summaryContent="+$("#summaryContent").val()+"&gesVoucherNo="+$("#gesVoucherNo").val()+
				"&lesVoucherNo="+$("#lesVoucherNo").val()+"&voucherType="+selectType.get('voucherType').val()+
				"&curCode="+selectType.get('curCode').val()+"&lesOrderNo="+$("#lesOrderNo").val()+"&gesOrderNo="+$("#gesOrderNo").val()+
				"&voucherState="+dicts.get('voucherState').val()+"&opt="+$("#opt").val()+"&legMoney="+$("#legMoney").val()+"&gegMoney="+$("#gegMoney").val()+
				"&accName="+accName;
		return param;
	}

	function search(){
        location.replace(basePath +"/finacial/accbook/financialquery/list?"+getParam());
	}
	//打印记账凭证
	function voucher(ids) {
		parent.layer.open({
			type: 2,
			area: ['1000px', '600px'],
			maxmin: true,
			//batchPrint  view
			content: basePath + "/finacial/accbook/fcaccbook/batchPrint?ids=" + ids
		});
	}
	/*记账凭证页面*/
	function view(id){
		parent.layer.open({
			type: 2,
			area: ['1000px', '580px'],
			maxmin: true,
			content: basePath + "/finacial/accbook/fcaccbook/batchPrint?ids=" + id+"&showFlag=true"
		});
	}
	/**原始凭证关联页面**/
	function viewByVoucherNo(busOriType,voucherNo) {
		if(busOriType != null){
			var url = '';
			//银企、网点间来账没有
			if(busOriType == 33 || busOriType == 34 || busOriType == 32){//资金调拨
				url = "/allocation/nisallocationreq/viewByBillNo/"
			}
			if(busOriType == 32 && (voucherNo.indexOf("RA") != -1 || voucherNo.indexOf("RB") != -1 || voucherNo.indexOf("RC") != -1)){//需求单（下拨单）
				url = "/netbank/nisdemand/viewByBillNo/"
			}
			if(busOriType == 48){//中心申请付款
				url = "/bdlink/bisexc/viewByVoucherNo/"
			}
			if(busOriType == 46){//委托贷款
				url = "/cms/precative/loansend/viewbybillcode?billCode="
			}
			if( busOriType == 47){//委托还款
				url = "/cms/precative/loanrepay/view?sendCode=''&type=tally"+"&billCode="
			}
			if(busOriType == 37){//内部
				url = "/cms/loan/cmsloansend/viewByBillCode/"
			}
			if(busOriType == 38){//内部还款
				url = "/cms/loan/cmsloanrepay/viewbybillcode/"
			}
			if(busOriType == 35){//借款发放
				url = "/cms/provide/loansend/viewSend/"
			}
			if(busOriType == 36 || busOriType == 55){//借款
				url = "/cms/provide/loanrepay/viewRepayBybillCode?repayBillCode="
			}
			if(busOriType == 30){//单位申请付款
				url = "/netbank/nisbillhead/viewByBillNo/"
			}
			if((busOriType >= 80) && (busOriType <= 109)){//票据
				url = "/bill/accebill/abreceivebill/view?accId="
			}

			if((busOriType >= 113) && (busOriType <= 116)){//内部存款
				url = "/chowmatistic/choinnerfinance/viewByBillNo/"
			}
			parent.layer.open({
				type: 2,
				area: ['1000px', '580px'],
				maxmin: true,
				content: url + basePath + voucherNo
			});
		}

	}
</script>
</html>

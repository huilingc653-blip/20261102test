<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")

<style type="text/css">
.layui-body2 {
	padding：0px;
	position: absolute;
	left: 0px;
	right: 0;
	top: 0;
	bottom: 0;
	z-index: 998;
	width: auto;
	overflow: hidden;
	overflow-y: auto;
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box;
}
</style> 
</head>
<body>
	<form class="layui-form" method="post" >
	<input id="id" name="id" type="hidden" value="$!{id}">
	<input id="origVoucherNo" name="origVoucherNo" value="$!{origVoucherNo}" type="hidden"/>
	<input id="busGlobalId" name="busGlobalId" value="$!{busGlobalId}" type="hidden"/>
	<input id="newId" name="newId" value="$!{newId}" type="hidden"/>
	<input id="pageType" name="pageType" value="edit" type="hidden"/>
        <div class="layui-body2 my-body">
	        <div class="layui-tab layui-tab-card my-tab" lay-filter="card2" >
				<ul class="layui-tab-title">
					<li class="layui-this" lay-id="rushbook">#springMessage('table.fcOutAccbook.strikeVoucher')</li>##冲账凭证
					<li lay-id="oribook">#springMessage('table.fcOutAccbook.oldVoucher')</li>##原凭证
					<li lay-id="newbook" >#springMessage('table.fcOutAccbook.newVoucher')</li>##录入新凭证
				</ul>
	            <div class="layui-tab-content" style="width: 100%; height: 100%">
	                <div class="layui-tab-item layui-show" style="width: 100%; height: 100%">
	                	<iframe id="rushiframe" name="rushiframe" src="${basePath}/finacial/accbook/fcaccbookblned/loadRushVoucher?oriId=$!{origVoucherNo}&id=$!{id}" frameborder="0" style="width: 100%; height: 100%"></iframe>
	                </div>
	                <div class="layui-tab-item" style="width: 100%; height: 100%">
	                ##已日结凭证
	                	<iframe id="oriiframe" name="oriiframe" src="${basePath}/finacial/accbook/fcaccbookblned/view?id=$!{origVoucherNo}" frameborder="0" style="width: 100%; height: 100%"></iframe>
	                </div>
	                <div class="layui-tab-item" id="newiframeDiv" style="width: 100%; height: 100%; overflow-y: auto; display: none">
	                	<iframe id="newiframe" name="newiframe" src="" frameborder="0" style="width: 100%; height: 100%;display: none"></iframe>
	                </div>
	            </div>
				<div class="layui-form-item" style="text-align: center;">
					<div class="layui-inline">
					#if($!{checkNew} == "checked")
						<input type="checkbox" name="addNewVoucher" id="addNewVoucher" checked="checked" value='true'>
					#else
						<input type="checkbox" name="addNewVoucher" id="addNewVoucher" value='true'>
					#end
						录入新凭证
						<button class="layui-btn" lay-submit lay-filter="temp">#springMessage('common.button.temp')</button>
						<button class="layui-btn" lay-submit lay-filter="submit">#springMessage('common.button.submit')</button>
						<button class="layui-btn" lay-submit lay-filter="revert">#springMessage('common.button.revert')</button>
					</div>
				</div>
			</div>
	    </div>
	</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/accbook/fcAccbookBlned.edit.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##所属网点
                    <td class="textRight">#springMessage('table.fcAccbookBlned.netId')</td>
                    <td width="40%">
                        <div class="layui-input-inline">
                            <!-- <input type="text" name="eqs_netId"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookBlned.netId')"> -->
                            <div class="bt-biz-corp" data-name="eqs_netId" data-biz-type="net" data-type="selectTree" data-resource="fcl:accbook:common:query" data-scope="net" ></div>        
                        </div>
                    </td>
                    ##账号
                    <td class="textRight">#springMessage('table.fcAccbookDtl.account')</td>
					<td >
						<input type="text" name="likes_account" class="layui-input bank">
					</td>
                </tr>
                <tr>
                    ##流水号
                    <td class="textRight">#springMessage('table.fcAccbookBlned.orderNo')</td>
                    <td width="40%" class="input100">
                        <div class="layui-input-inline">
                            <input type="text" name="ges_orderNo"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookBlned.orderNo')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-input-inline">
                            <input type="text" name="les_orderNo"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookBlned.orderNo')">
                        </div>
                    </td>
                    ##凭证号
                    <td class="textRight">#springMessage('table.fcAccbookBlned.voucherNo')</td>
                    <td class="input100">
                        <div class="layui-input-inline">
                            <input type="text" name="ges_voucherNo"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookBlned.voucherNo')">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-input-inline">
                            <input type="text" name="les_voucherNo"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookBlned.voucherNo')">
                        </div>
                    </td>
                </tr>
                <tr>
                    ##记账日期
                    <td class="textRight">#springMessage('table.fcAccbookBlned.tallyDate')</td>
                    <td >
                        <div class="layui-inline">
                            <!-- <div type="date" field="ged_tallyDate" defaultVal="$!{fcAccbookBlnedPage.tallyDate}"></div> -->
                            <input type="text" name="ged_tallyDate" data-name="ged_tallyDate" class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <!-- <div type="date" field="led_tallyDate" defaultVal="$!{fcAccbookBlnedPage.tallyDate}"></div> -->
                            <input type="text" name="led_tallyDate"　data-name="led_tallyDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date">
                        </div>
                    </td>
                    ##起息日期
                    <td class="textRight">#springMessage('table.fcAccbookBlned.interestStartDate')</td>
                    <td >
                        <div class="layui-inline">
                            <!-- <div type="date" field="ged_interestStartDate" defaultVal="$!{fcAccbookBlnedPage.interestStartDate}"></div> -->
                            <input type="text" name="ged_interestStartDate" data-name="ged_interestStartDate" class="layui-input bt-biz-dateType" data-endid="startDate1" data-type="date">
                        </div>
                        <span class="date-mid">~</span>
                        <div class="layui-inline">
                            <!-- <div type="date" field="led_interestStartDate" defaultVal="$!{fcAccbookBlnedPage.interestStartDate}"></div> -->
                            <input type="text" name="led_interestStartDate"　data-name="led_interestStartDate" class="layui-input bt-biz-dateType" id="startDate1" data-type="date">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="textRight">#springMessage('table.fcAccbook.voucherState')</td>
	            	<td >
	            		<div class="layui-inline">
	                        <!-- <input type="text" name="eqs_voucherState"
	                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbook.voucherState')"> -->
	                                <div class="bt-biz-dict" data-type="select" data-name="eqs_voucherState" data-biz-name="eqs_voucherState" 
	                                data-group="Finacial.VoucherState" data-displayData="M,D,W"></div>
	                    </div>
	            	</td>
                    ##	金额
                    <td class="textRight">#springMessage('table.fcAccbook.money')</td>
                    <td style="text-align:left;">
                        <input type="text" data-name="geg_debitMoney" data-biz-name="geg_debitMoney" id="geg_debitMoney" data-moneyendid="t20" class="layui-input bt-input-inline  bt-biz-moneyType" data-minus="true">
                        <span class="date-mid">~</span>
                        <input type="text" data-name="leg_debitMoney" data-biz-name="leg_debitMoney" id="t20" class="layui-input bt-input-inline  bt-biz-moneyType" id="money" data-minus="true">
                    </td>
                </tr>
                <tr>
                    <td colspan="4" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcAccbook.busRaceId')</th>
        <th>#springMessage('table.fcAccbook.voucherType')</th>
        <th>#springMessage('table.fcAccbook.tallyDate')</th>
        <th>#springMessage('table.fcAccbook.interestStartDate')</th>
        <th>#springMessage('table.fcAccbook.orderNo')</th>
        <th>#springMessage('table.fcAccbook.money')</th>
        <th>#springMessage('table.fcAccbook.rmk')</th>
        <th>#springMessage('table.fcAccbook.voucherState')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/accbook/invalid/fcAccbookInvalid.editlist.js?_btv=${resourceVersion}"></script>
</html>

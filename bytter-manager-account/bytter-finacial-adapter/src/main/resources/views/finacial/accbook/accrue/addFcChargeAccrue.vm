<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{fcChargeAccruePage.id}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##借方账号
				<td class="textRight">#springMessage('table.fcChargeAccrue.account')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="account" name="account" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeAccrue.account')">
										</td>
        		##凭证种类代码
				<td class="textRight">#springMessage('table.fcChargeAccrue.voucherType')</td>
				<td width="40%">
						<!--number-->
                        <input type="text" id="voucherType" name="voucherType" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeAccrue.voucherType')">
										</td>
			</tr>
        	<tr>
        		##是否入账
				<td class="textRight">#springMessage('table.fcChargeAccrue.tallySign')</td>
				<td >
						<!--number-->
                        <input type="text" id="tallySign" name="tallySign" lay-verify="required"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeAccrue.tallySign')">
										</td>
        		##费用规则
				<td class="textRight">#springMessage('table.fcChargeAccrue.chargeRuleId')</td>
				<td >
						<!--number-->
                        <input type="text" id="chargeRuleId" name="chargeRuleId" lay-verify="required"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeAccrue.chargeRuleId')">
										</td>
			</tr>
        	<tr>
        		##费用金额
				<td class="textRight">#springMessage('table.fcChargeAccrue.chargeMoney')</td>
				<td >
						<!--number-->
                        <input type="text" id="chargeMoney" name="chargeMoney" lay-verify="required"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeAccrue.chargeMoney')">
										</td>
        		##计提时间
				<td class="textRight">#springMessage('table.fcChargeAccrue.accrueTime')</td>
				<td >
						                        <div type="date" field="accrueTime" defaultVal="$!{fcChargeAccruePage.accrueTime}"></div>
				</td>
			</tr>
        	<tr>
        		##经办人代码
				<td class="textRight">#springMessage('table.fcChargeAccrue.operatorCode')</td>
				<td >
						<!--number-->
                        <input type="text" id="operatorCode" name="operatorCode" lay-verify="required"
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeAccrue.operatorCode')">
										</td>
        		##复核时间
				<td class="textRight">#springMessage('table.fcChargeAccrue.checkTime')</td>
				<td >
						                        <div type="date" field="checkTime" defaultVal="$!{fcChargeAccruePage.checkTime}"></div>
				</td>
			</tr>
        	<tr>
        		##复核人代码
				<td class="textRight">#springMessage('table.fcChargeAccrue.checkerCode')</td>
				<td >
						<!--number-->
                        <input type="text" id="checkerCode" name="checkerCode" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeAccrue.checkerCode')">
										</td>
        		##关联流水号
				<td class="textRight">#springMessage('table.fcChargeAccrue.targetOrderNo')</td>
				<td >
						<!--number-->
                        <input type="text" id="targetOrderNo" name="targetOrderNo" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeAccrue.targetOrderNo')">
										</td>
			</tr>
        	<tr>
        		##创建时间
				<td class="textRight">#springMessage('table.fcChargeAccrue.createTime')</td>
				<td >
						                        <div type="date" field="createTime" defaultVal="$!{fcChargeAccruePage.createTime}"></div>
				</td>
        		##创建用户代码
				<td class="textRight">#springMessage('table.fcChargeAccrue.createBy')</td>
				<td >
						<!--number-->
                        <input type="text" id="createBy" name="createBy" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeAccrue.createBy')">
										</td>
			</tr>
        	<tr>
        		##最后更新时间
				<td class="textRight">#springMessage('table.fcChargeAccrue.updateTime')</td>
				<td >
						                        <div type="date" field="updateTime" defaultVal="$!{fcChargeAccruePage.updateTime}"></div>
				</td>
        		##最后更新用户代码
				<td class="textRight">#springMessage('table.fcChargeAccrue.updateBy')</td>
				<td >
						<!--number-->
                        <input type="text" id="updateBy" name="updateBy" 
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeAccrue.updateBy')">
										</td>
			</tr>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/accrue/fcChargeAccrue.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##凭证种类代码
                    <td class="textRight">#springMessage('table.fcChargeAccrue.voucherType')</td>
                    <td width="40%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_voucherName"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeAccrue.voucherType')">
                        </div>
                    </td>
                    ##是否入账
                    <td class="textRight">#springMessage('table.fcChargeAccrue.tallySign')</td>
                    <td width="40%">
                        <div class="layui-input-inline">
                            <!-- <input type="text" name="eqs_tallySign"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcChargeAccrue.tallySign')"> -->
                             <div class="bt-biz-dict" data-name="eqs_tallySign" data-type="select" data-group="fcCharge.tallySign" data-biz-name="tallySign"></div>
                        </div>
                    </td>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button class="layui-btn" lay-submit="" lay-filter="charge">#springMessage('Finacial.accbook.common.button.charge')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcChargeAccrue.account')</th>
        <th>#springMessage('table.fcAccbookBlned.voucherNo')</th>
        <th>#springMessage('table.fcAcc.accName')</th>
        <th>#springMessage('table.fcChargeAccrue.voucherType')</th>
        <th>#springMessage('table.fcChargeAccrue.sumMoney')</th>
        <th>#springMessage('table.fcChargeAccrue.tallySign')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/finacial/accbook/accrue/fcChargeAccrue.list.js?_btv=${resourceVersion}"></script>
</html>

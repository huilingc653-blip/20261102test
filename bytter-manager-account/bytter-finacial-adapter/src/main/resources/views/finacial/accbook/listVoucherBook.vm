							</td>
							<td align="right">
								$number.formatNumeric($!{bookDtl.creditMoney})
							</td>
							<td align="right">
								$number.formatNumeric($!{bookDtl.balance})
							</td>
						</tr>
						#end
					#end
				</tr>
				#end
			</tbody>
		</table>
	</div>
</div>
<div id="page" style="bottom:0px;width:100%;margin-bottom: 20px;"></div>
	#parse("views/common/footer.vm")

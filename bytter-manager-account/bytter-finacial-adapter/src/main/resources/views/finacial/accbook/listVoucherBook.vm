							#end
							<td align="right" >$number.formatNumeric($!{bookDtl.debitMoney})</td>
							<td align="right" >$number.formatNumeric($!{bookDtl.creditMoney})</td>
							<td align="right" >$number.formatNumeric($!{bookDtl.balance})</td>

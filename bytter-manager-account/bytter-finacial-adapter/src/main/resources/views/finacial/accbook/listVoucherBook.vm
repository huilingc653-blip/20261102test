<script type="text/javascript" charset="utf-8">
	var corpInit;
	var dateType;
	var selectType;
	var dicts,form;
	var moneyType;
	bt.use(['form','datatable','btdate','corp','moneyType','laypage','dateType','selectType','date','dicts','jquery','element','selectTable','relaypage','printType','freezeTable'], function(){
		var $ = bt.jquery;
		form = bt.form();
		dateType=bt.dateType.init();
		selectType=bt.selectType.init();
		dicts=bt.dicts.init();
		moneyType=bt.moneyType.init();
		bt.printType.init();
		bt.selectTable.init({
			elem: "#example",
			url: basePath+"/inneraccount/fcacc/getValidAccount",
			scrollX:"500px",
			scrollY:"200px",
			searchInput:"#account",
			columns: [
				{data:"blnctrAcc",},
				{data:"accName",}
			],
			clickCallback:function(data){
				//设置账户
				$("#account").val(data.blnctrAcc);
			}
		});

		if($("#appTable").find("tbody tr").length > 1){
			bt.freezeTable.init({
				elem:'#appTable',//表格id
				freezeRowNum:'2',//冻结几行
				freezeColumnNum:'0',//冻结几列
				height:'500px' //表格高度
			})
		}

		var pages = 0
		try {
			pages = Math.ceil($!{model.total} / $!{model.len})
		}catch (e) {
			pages = 0
		}
		bt.relaypage({
			cont: 'page',
			pages: pages,
			curr:$!{model.curr},
			resultCount:$!{model.total},
			limit:$!{model.len}, // 每页显示的数量
			limits:[10,25,50,100,500], // 每页条数选项
			layout: ['count', 'prev', 'page', 'next', 'limit', 'refresh', 'skip'],
			skip:true,
			jump:function(obj, first){
				if(!first){
					location.href = basePath + "/finacial/accbook/fcaccbook/listVoucherBook?"+getParam()+"&start="+obj.curr+"&len="+obj.limit;
				}
			}
		});
		## bt.page.init({
		## 	elem:'#page',//分页组件容器
		## 	count:$!{model.total}, //表格总页码
		## 	currentPage:$!{model.curr},//当前页码，默认值为 0,即第一页
		## 	len : $!{model.len}, //当前显示条数，默认值为10
		## 	jump:function(obj){ //翻页回调方法
		## 		var curr = obj.curr;
		## 		var len = obj.len;
		## 		location.href = basePath + "/finacial/accbook/fcaccbook/listVoucherBook?"+getParam()+"&start="+curr+"&len="+len;
		## 	}
		## })
		var queryVoucher = function(){
		}
		//重置
		resetCode = function(){
			var inputs = $('.rCode').find('input');
			inputs.each(function(){
				$(this).val("");
			})
			moneyType.get("legMoney").val("");
			moneyType.get("gegMoney").val("");
			moneyType.render();
			var selects = $('.rCode').find('.bt-biz-selectType,.bt-biz-dict');
			bt.each(selects,function () {
				$(this).find('select').val(' ');
			})
			form.render('select');
		}

		//查询
		$('#search').click(function(){
			location.href = basePath + "/finacial/accbook/fcaccbook/listVoucherBook?"+getParam();
		});

		corpInit = bt.corp.init();
	});

	var getParam = function(){
		var param="";
		param += "netCode="+corpInit.get('netCode').val()+"&sysRaceCode="+selectType.get('sysRaceCode').val()+
				"&gedTallyDate="+dateType.get('gedTallyDate').val()+"&ledTallyDate="+dateType.get('ledTallyDate').val()+
				"&account="+$("#account").val()+"&origVoucherNo="+$("#origVoucherNo").val()+"&gesVoucherNo="+$("#gesVoucherNo").val()+
				"&lesVoucherNo="+$("#lesVoucherNo").val()+"&voucherType="+selectType.get('voucherType').val()+
				"&curCode="+selectType.get('curCode').val()+"&lesOrderNo="+$("#lesOrderNo").val()+"&gesOrderNo="+$("#gesOrderNo").val()+
				"&voucherState="+dicts.get('voucherState').val()+"&opt="+$("#opt").val()+"&legMoney="+$("#legMoney").val()+"&gegMoney="+$("#gegMoney").val()+
				"&accName="+$("#accName").val() ;
		return param;
	}


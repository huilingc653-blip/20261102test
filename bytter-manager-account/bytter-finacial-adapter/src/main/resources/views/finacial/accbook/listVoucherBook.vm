	/**原始凭证关联页面**/
	function viewByVoucherNo(busOriType,voucherNo) {
		if(busOriType != null){
			//银企、网点间来账没有
			if(busOriType == 33 || busOriType == 34 || busOriType == 32){//资金调拨
				parent.layer.open({
					type: 2,
					area: ['800px', '580px'],
					maxmin: true,
					content: basePath + "/allocation/nisallocationreq/viewByBillNo/" + voucherNo
				});
			}
			if(busOriType == 48){//中心申请付款
				parent.layer.open({
					type: 2,
					area: ['800px', '580px'],
					maxmin: true,
					content: basePath + "/bdlink/bisexc/viewByVoucherNo/" + voucherNo
				});
			}
			if(busOriType == 46){//委托贷款
				parent.layer.open({
					type: 2,
					area: ['800px', '580px'],
					maxmin: true,
					content: basePath + "/cms/precative/loansend/viewbybillcode?billCode=" + voucherNo
				});
			}
			if( busOriType == 47){//委托还款
				parent.layer.open({
					type: 2,
					area: ['800px', '580px'],
					maxmin: true,
					content: basePath + "/cms/precative/loanrepay/view?sendCode=''&type=view"+"&billCode="+voucherNo
				});
			}
			if(busOriType == 37){//内部
				parent.layer.open({
					type: 2,
					area: ['800px', '580px'],
					maxmin: true,
					content: basePath + "/cms/loan/cmsloansend/viewByBillCode/" + voucherNo
				});
			}
			if(busOriType == 38){//内部还款
				parent.layer.open({
					type: 2,
					area: ['800px', '580px'],
					maxmin: true,
					content: basePath + "/cms/loan/cmsloanrepay/viewbybillcode/" + voucherNo
				});
			}
			if(busOriType == 35){//借款发放
				parent.layer.open({
					type: 2,
					area: ['800px', '580px'],
					maxmin: true,
					content: basePath + "/cms/provide/loansend/viewSend/" + voucherNo
				});
			}
			if(busOriType == 36 || busOriType == 55){//借款
				parent.layer.open({
					type: 2,
					area: ['800px', '580px'],
					maxmin: true,
					content: basePath + "/cms/provide/loanrepay/viewRepayBybillCode?repayBillCode=" + voucherNo
				});
			}
			if(busOriType == 30){//单位申请付款
				parent.layer.open({
					type: 2,
					area: ['800px', '580px'],
					maxmin: true,
					content: basePath + "/netbank/nisbillhead/viewByBillNo/" + voucherNo
				});
			}
			if((busOriType >= 80) && (busOriType <= 109)){//票据
				parent.layer.open({
					type: 2,
					area: ['800px', '580px'],
					maxmin: true,
					content: basePath + "/bill/accebill/abreceivebill/view?accId=" + voucherNo
				});
			}

			if((busOriType >= 113) && (busOriType <= 116)){//内部存款
				parent.layer.open({
					type: 2,
					area: ['800px', '580px'],
					maxmin: true,
					content: basePath + "/chowmatistic/choinnerfinance/viewByBillNo/" + voucherNo
				});
			}
		}

	}

	/**
	 * 记账凭证现金流项目调整
	 * @param id
	 */
	function updateVoucherBookItem(id){
		if(bt.navtab){

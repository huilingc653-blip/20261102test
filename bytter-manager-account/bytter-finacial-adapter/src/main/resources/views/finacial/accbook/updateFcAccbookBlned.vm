<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{fcAccbookBlnedPage.id}">
		<input id="voucherType" name="voucherType" type="hidden" value="$!{fcAccbookBlnedPage.voucherType}">
		<input id="origVoucherNo" name="origVoucherNo" type="hidden" value="$!{fcAccbookBlnedPage.origVoucherNo}">
		<input id="emergencySign" name="emergencySign" type="hidden" value="$!{fcAccbookBlnedPage.emergencySign}">
		<input id="operatorCode" name="operatorCode" type="hidden" value="$!{fcAccbookBlnedPage.operatorCode}">
		<input id="checkerCode" name="checkerCode" type="hidden" value="$!{fcAccbookBlnedPage.checkerCode}">
		<input id="checkTime" name="checkTime" type="hidden" value="$!{fcAccbookBlnedPage.checkTime}">
		<input id="chargedSign" name="chargedSign" type="hidden" value="$!{fcAccbookBlnedPage.chargedSign}">
		<input id="rushSign" name="rushSign" type="hidden" value="$!{fcAccbookBlnedPage.rushSign}">
		<input id="generateMode" name="generateMode" type="hidden" value="$!{fcAccbookBlnedPage.generateMode}">
		<input id="busOriType" name="busOriType" type="hidden" value="$!{fcAccbookBlnedPage.busOriType}">
		<input id="rmk" name="rmk" type="hidden" value="$!{fcAccbookBlnedPage.rmk}">
		<input id="postscript" name="postscript" type="hidden" value="$!{fcAccbookBlnedPage.postscript}">
		<input id="curCode" name="curCode" type="hidden" value="$!{fcAccbookBlnedPage.curCode}">
		<input id="createTime" name="createTime" type="hidden" value="$!{fcAccbookBlnedPage.createTime}">
		<input id="createBy" name="createBy" type="hidden" value="$!{fcAccbookBlnedPage.createBy}">
		<input id="updateTime" name="updateTime" type="hidden" value="$!{fcAccbookBlnedPage.updateTime}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{fcAccbookBlnedPage.updateBy}">
        <table class="layui-table">
            <tbody>
				<tr>
					##所属网点
					<td class="textRight">#springMessage('table.fcAccbookBlned.netId')</td>
    				<td width="40%">
						<!--number-->
						<input type="text" id="netId" name="netId"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookBlned.netId')" value="$!{fcAccbookBlnedPage.netId}">
											</td>
					##流水号
					<td class="textRight">#springMessage('table.fcAccbookBlned.orderNo')</td>
    				<td width="40%">
						<!--number-->
						<input type="text" id="orderNo" name="orderNo"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookBlned.orderNo')" value="$!{fcAccbookBlnedPage.orderNo}">
											</td>
        		</tr>
				<tr>
					##凭证号
					<td class="textRight">#springMessage('table.fcAccbookBlned.voucherNo')</td>
    				<td >
						<!--number-->
						<input type="text" id="voucherNo" name="voucherNo"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookBlned.voucherNo')" value="$!{fcAccbookBlnedPage.voucherNo}">
											</td>
					##录入日期
					<td class="textRight">#springMessage('table.fcAccbookBlned.enrolTime')</td>
    				<td >
												<div type="date" field="enrolTime" defaultVal="$!{fcAccbookBlnedPage.enrolTime}"></div>
					</td>
        		</tr>
				<tr>
					##记账日期
					<td class="textRight">#springMessage('table.fcAccbookBlned.tallyDate')</td>
    				<td >
												<div type="date" field="tallyDate" defaultVal="$!{fcAccbookBlnedPage.tallyDate}"></div>
					</td>
					##起息日期
					<td class="textRight">#springMessage('table.fcAccbookBlned.interestStartDate')</td>
    				<td >
												<div type="date" field="interestStartDate" defaultVal="$!{fcAccbookBlnedPage.interestStartDate}"></div>
					</td>
        		</tr>
				<tr>
					##附件张数
					<td class="textRight">#springMessage('table.fcAccbookBlned.affixAmount')</td>
    				<td >
						<!--number-->
						<input type="text" id="affixAmount" name="affixAmount"
							   
							   decimal="0" autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookBlned.affixAmount')" value="$!{fcAccbookBlnedPage.affixAmount}">
											</td>
					##红蓝标志
					<td class="textRight">#springMessage('table.fcAccbookBlned.redblueSign')</td>
    				<td >
						<!--number-->
						<input type="text" id="redblueSign" name="redblueSign"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookBlned.redblueSign')" value="$!{fcAccbookBlnedPage.redblueSign}">
											</td>
        		</tr>
				<tr>
					##凭证状态
					<td class="textRight">#springMessage('table.fcAccbookBlned.voucherState')</td>
    				<td >
						<!--number-->
						<input type="text" id="voucherState" name="voucherState"
							   
							    autocomplete="off" class="layui-input" placeholder="#springMessage('table.fcAccbookBlned.voucherState')" value="$!{fcAccbookBlnedPage.voucherState}">
											</td>
				<tr>
					<td colspan="6" style="text-align: center;">
						<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
					</td>
				</tr>
			</tbody>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/accbook/fcAccbookBlned.edit.js?_btv=${resourceVersion}"></script>
</html>
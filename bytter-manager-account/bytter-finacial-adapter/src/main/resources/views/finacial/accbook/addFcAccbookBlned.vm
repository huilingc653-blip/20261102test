<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
<style type="text/css">
.voucher-title {
	font-weight: bold;
	font-size: 22px;
	text-decoration: underline;
	text-align: center;
	/*color: blue;*/
	/*color: #00CC33;*/
}
</style>
</head>
<body>
	<form class="layui-form layui-form-pane requr" method="post">
		<div class="voucher-title">
			##记账凭证
			<label >#springMessage('table.fcAccbook.tallyTitle')</label>
		</div>
		<table style="width: 100%; " class="layui-table" lay-skin="nob" >
			<tr>
				##记账凭证
				<td colspan="6" align="center" style="font-size:15px; font-weight:bold;">
				</td>
				##作废标识
				<td align="left" style="color: red;font-weight:bold; ">

				</td>
			</tr>
			<tr>
				##业务种类
				<td align="right" width="12%">#springMessage('table.fcAccbook.busRaceId')：</td>
				<td width="18%">$!{voucher.accbook.raceName}</td>
				##币别
				<td align="right" width="12%">#springMessage('table.fbsBudgetDetail.curId')：</td>
				<td width="20%">$!{voucher.accbook.curName}</td>
				##附件数
				<td align="right" width="12%">#springMessage('table.fcAccbook.affixAmount')：</td>
				<td width="20%">$!{voucher.accbook.affixAmount}</td>
				<td ></td>
			</tr>
			<tr>
				##流水号
				<td align="right">#springMessage('table.fcAccbook.orderNo')：</td>
				<td >$!{voucher.accbook.orderNo}</td>
				##凭证号
				<td align="right">#springMessage('table.fcAccbook.voucherNo')：</td>
				<td >$!{voucher.accbook.voucherNo}</td>
				##制单日期
				<td align="right">#springMessage('table.fcAccbook.enrolTime')：</td>
				<td >$!date.format('yyyy-MM-dd',$!voucher.accbook.enrolTime)</td>
				<td align="right"></td>
			</tr>
		</table>
		## 凭证表格数据
		<table id="dataTable" class="layui-table layui-table-border">
			<thead>
				<tr>
					<th style="text-align: center;" colspan="2">#springMessage('table.fcAccbookDtl.summaryContent')</th>
					<th style="text-align: center;" colspan="3">#springMessage('table.fcAccbookDtl.account')</th>
					<th style="text-align: center;" colspan="2">#springMessage('table.fcAccbookDtl.accName')</th>
					<th style="text-align: center;">#springMessage('table.fcAccbookDtl.origVoucherNo')</th>
					<th style="text-align: center;">#springMessage('table.fcAccbookDtl.debitMoney')</th>
					<th style="text-align: center;">#springMessage('table.fcAccbookDtl.creditMoney')</th>
					<th style="text-align: center;">#springMessage('finacial.common.cashFlow.item')</th>#*现金流项目*#
				</tr>
			</thead>
			<tbody>
			#foreach($bookDtl in $!{voucher.bookDtls})
				#set($vcount = $velocityCount - 1)
				<tr>
					<td colspan="2">
						$!{bookDtl.summaryContent}
					</td>
					<td colspan="3">
						$!{bookDtl.subjectName}
						<br>
						$!{bookDtl.account}
					</td>
					<td colspan="2">
						$!{bookDtl.accName}
					</td>
					<td>$!{bookDtl.origVoucherNo}</td>
					<td align="right" style="color: red;">
						$number.formatNumeric($!{bookDtl.debitMoney})
					</td>
					<td align="right" style="color: red;">
						$number.formatNumeric($!{bookDtl.creditMoney})
					</td>
					<td>
						$!{bookDtl.cashFluxName}
					</td>
				</tr>
				#end
			</tbody>
			<tr>
				<td rowspan="5">#springMessage('table.fcAccbook.rmk')</td>
				<td >#springMessage('table.fcAccbook.voucherType')</td>
				<td colspan="3">$!{voucher.accbook.voucherName}</td>
				<td >#springMessage('table.fcAccbook.tallyDate')</td>
				<td >
					<div class=layui-input-inline>
						<input class="layui-input bt-biz-dateType" type=text name="rushtallyDate" data-type="date" data-biz-name="rushtallyDate" value="$!date.format('yyyy-MM-dd',$!voucher.accbook.tallyDate)" lay-verify="required">
					</div>
				</td>
				<td style="text-align: right;" rowspan="2">#springMessage('table.interet.sum')：</td>
				<td style="text-align: right;" rowspan="2"><span id='debitTot' val="0">$!{debitTotStr}</span></td>
				<td style="text-align: right;" rowspan="2"><span id='creditTot' val="0">$!{debitTotStr}</span></td>
				<td></td>
			</tr>
			<tr>
				<td >#springMessage('table.fcAccbook.emergencySign')</td>
				<td >$dictTag.get('Accbook.EmergencySign',$!{voucher.accbook.emergencySign})</td>
				<td >#springMessage('table.fcAccbookExt.tradeRate')</td>
				<td >$!{voucher.bookExt.tradeRate}</td>
				<td >#springMessage('table.fcAccbook.interestStartDate')</td>
				<td >
					<!-- <div type="date" field="rushinterestStartDate" name="rushinterestStartDate" lay-verify="required" defaultVal="$!date.format('yyyy-MM-dd',$!voucher.accbook.interestStartDate)"></div> -->
					<input type="text" name="rushinterestStartDate" data-name="rushinterestStartDate" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="rushinterestStartDate" value="$!date.format('yyyy-MM-dd',$!voucher.accbook.interestStartDate)" lay-verify="required">
				</td>
				<td></td>
			</tr>
			<tr>
				<td >#springMessage('table.fcAccbookExt.externalCorp') </td>
				<td colspan="3">$!{voucher.bookExt.externalCorp}</td>
				<td >#springMessage('table.fcAccbookExt.externalAcc')</td>
				<td colspan="4">$!{voucher.bookExt.externalAcc}</td>
				<td></td>
			</tr>
			<tr>
				<td >#springMessage('table.fcAccbookExt.paysysbankcode') </td>
				<td colspan="3">$!{voucher.bookExt.externalBank}</td>
				<td >#springMessage('table.fcAccbookExt.prov')</td>
				<td >$!{voucher.bookExt.prov}</td>
				<td >#springMessage('table.fcAccbookExt.city')</td>
				<td colspan="2">$!{voucher.bookExt.city}</td>
				<td></td>
			</tr>
			<tr>
				<td >#springMessage('table.fcAccbook.rmk') </td>
				<td colspan="9">$!{voucher.accbook.rmk}</td>
			</tr>
			<tr>
				<td >#springMessage('table.fcAccbookExt.desReason') </td>
				<td colspan="10">
					<textarea class="layui-textarea" name='desReason' id='desReason' maxlength="80" style='width:100%;' value="$!{voucher.bookExt.desReason}" lay-verify="required">
						$!{voucher.bookExt.desReason}
					</textarea>
				</td>
			</tr>
		</table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
var desReason,tallyDate, interestStartDate;
bt.use(['form','btdate','dateType'], function(){
	var $ = bt.jquery,form = bt.form();
	var dateType = bt.dateType.init();
	$("#desReason").val($.trim($("#desReason").val()))
	//时间
	$.each($("div[type='date']"),function(i,item){
		bt.btdate.init({
			elem: "[field='"+$(item).attr("field")+"']",
			name: $(item).attr("field"),
            start: $(item).attr("defaultVal"),
            format: "YYYY-MM-DD",
			istime: false,
			required : true,
			defaultVal: $(item).attr("defaultVal"),
			choose:function(data){
		    	//$("input[name='" + $(item).attr("field") + "'").val(data);
			}
		});
	});
	desReason = $("#desReason").val();
	//tallyDate = $("#tallyDate").val();
	//interestStartDate = $("#interestStartDate").val();
	tallyDate=dateType.get("rushtallyDate").val();
	interestStartDate=dateType.get("rushinterestStartDate").val();
});

</script>
</html>

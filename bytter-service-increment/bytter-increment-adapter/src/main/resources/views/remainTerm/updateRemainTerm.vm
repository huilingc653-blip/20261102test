<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input type="hidden" name="id" value="$!{remainTerm.id}" />
		<input type="hidden" name="sort" value="$!{remainTerm.sort}" />
		<input type="hidden" name="createBy" value="$!{remainTerm.createBy}" />
		<input type="hidden" name="createDate" value="$!{remainTerm.createDate}" />
		<input type="hidden" id="rowIndex" value="$!{remainTerm.remainTermDtl.size()}">
		<table class="layui-table">
			<tbody>
				<tr>
					<td width="20%" class="textRight">#springMessage("table.remainTerm.termName")</td>
					<td width="30%">
						<input type="text" name="termName" class="layui-input" lay-verify="required|strlength" data-max-length="100" autocomplete="off" value="$!{remainTerm.termName}"/>
					</td>
					<td width="20%" class="textRight">#springMessage("table.remainTerm.isValid")</td>
					<td width="30%">
                        <div class="bt-biz-dict" data-type="radio" data-defaultvalue="$!{remainTerm.isValid}" data-biz-name="isValid" data-name="isValid" data-group="sf_yn"></div>
					</td>
				</tr>
				<tr>
					<td width="20%" class="textRight">#springMessage("table.remainTerm.formula")</td>
					<td width="80%" id="formulas" colspan="3">
						$!{remainTerm.formulas}
					</td>
				</tr>
                <tr>
                    <td colspan="8">
                        <button type="button" class="layui-btn" lay-filter="add" id="add">#springMessage('common.addTr')</button>
                    </td>
                </tr>
			</tbody>
		</table>
        <table class="layui-table ignore-required-icon isDown" id="editTable">
        	<thead>
		   		<tr>
					<th>#springMessage("table.remainTerm.field1")</th>
					<th>#springMessage("table.remainTerm.symbol")</th>
					<th>#springMessage("table.remainTerm.field2")</th>
					<th>#springMessage("table.remainTerm.condition")</th>
					<th>#springMessage("table.remainTerm.days")</th>
                    <th>#springMessage("table.remainTerm.unit")</th>
					<th>#springMessage("table.remainTerm.logicalRelationship")</th>
                    <th>#springMessage("common.table.thead.operation")</th>
				</tr>
		    </thead>
            <tbody>
			#foreach($dtl in $!{remainTerm.remainTermDtl})
				#set($vcount = $velocityCount - 1)
            	<tr data-row="$vcount">
					<td class="center">
						$dictTag.get("remainTerm.field",$!{dtl.field1})
                        <div class="layui-inline">
							<input type="hidden" name="remainTermDtl[$vcount].field1" id="${vcount}field1" value="$!{dtl.field1}"/>
						</div>
					</td>
                    <td class="center">
						$dictTag.get("remainTerm.symbol",$!{dtl.symbol})
                        <div class="layui-inline">
                            <input type="hidden" name="remainTermDtl[$vcount].symbol" id="${vcount}symbol" value="$!{dtl.symbol}"/>
                        </div>
                    </td>
                    <td class="center">
						$dictTag.get("remainTerm.field",$!{dtl.field2})
                        <div class="layui-inline">
                            <input type="hidden" name="remainTermDtl[$vcount].field2" id="${vcount}field2" value="$!{dtl.field2}"/>
                        </div>
                    </td>
					<td class="center">
						<div class="layui-inline">
                            <div class="bt-biz-dict" data-type="select" data-name="remainTermDtl[$vcount].conditions" data-biz-name="remainTermDtl[$vcount].conditions"
								 data-group="remainTerm.condition"  data-callback="bt.createFormula" data-defaultvalue="${dtl.conditions}" data-required="true"></div>
						</div>
					</td>
					<td class="center">
						<div class="layui-inline">
                            <input type="text" data-name="remainTermDtl[$vcount].days" id="${vcount}days" class="layui-input bt-biz-moneyType" data-min="0" data-decimal="0"
								value="${dtl.days}" data-callback="bt.changeDays" lay-verify="required"/>
						</div>
					</td>
					<td class="center">
						<div class="layui-inline">
                            <div class="bt-biz-dict" data-type="select" data-name="remainTermDtl[$vcount].unit" data-biz-name="remainTermDtl[$vcount].unit"
                              data-group="remainTerm.unit"  data-callback="bt.createFormula" data-defaultvalue="${dtl.unit}" data-required="true"></div>
						</div>
					</td>
					<td class="center">
                        <div class="layui-inline">
							<div class="bt-biz-dict" data-type="select"  data-name="remainTermDtl[$vcount].logicalRelationship" data-defaultvalue="${dtl.logicalRelationship}"
							data-biz-name="remainTermDtl[$vcount].logicalRelationship" data-callback="bt.createFormula" data-group="remainTerm.logicalRelationship" ></div>
						</div>
					</td>
					<td class="center">
                        <button data-type="del" type="button" class="layui-btn layui-btn-mini">#springMessage("common.button.delete")</button>
					</td>
					<td style="display: none">
                    	<input type="hidden" readonly="true" name="remainTermDtl[$vcount].formula" id="${vcount}formula" value="${dtl.formula}"/>
                    </td>
                    <td style="display: none">
                        <input type="hidden" readonly="true" name="remainTermDtl[$vcount].sort" id="${vcount}sort" value="${dtl.sort}"/>
                    </td>
				</tr>
			#end
            </tbody>
        </table>
        <div class="layui-form-item">
			<div class="layui-input-block" style="text-align: center;">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" type="button" lay-filter="reset">#springMessage('common.button.reset')</button>
				<button class="layui-btn" type="button" onClick="closeWindow();">#springMessage('common.button.close')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bi/remainTerm/remainTerm.add.js?_btv=${resourceVersion}"></script>
</html>
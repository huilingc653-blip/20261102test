<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input type="hidden" name="isBaseLoanRate" value="$!{baseSign}" />
        <input type="hidden" id="rowIndex" value="0">
		<table class="layui-table">
			<tbody>
				<tr>
					<td width="20%" class="textRight">#springMessage("table.remainTerm.termName")</td>
					<td width="30%">
						<input type="text" name="termName" class="layui-input" lay-verify="required|strlength" data-max-length="100" autocomplete="off" />
					</td>
					<td width="20%" class="textRight">#springMessage("table.remainTerm.isValid")</td>
					<td width="30%">
                        <div class="bt-biz-dict" data-type="radio" data-defaultvalue="1" data-biz-name="isValid" data-name="isValid" data-group="sf_yn" ></div>
					</td>
				</tr>
				<tr>
					<td width="20%" class="textRight">#springMessage("table.remainTerm.formula")</td>
					<td width="80%" id="formulas" colspan="3">

					</td>
				</tr>
                <tr>
                    <td colspan="8">
                        <button type="button" class="layui-btn" lay-filter="add" id="add">#springMessage('common.addTr')</button>
                    </td>
                </tr>
			</tbody>
		</table>
        <table class="layui-table ignore-required-icon isDown" id="editTable" width="100%">
        	<thead>
		   		<tr>
					<th>#springMessage("table.remainTerm.field1")</th>
					<th>#springMessage("table.remainTerm.symbol")</th>
					<th>#springMessage("table.remainTerm.field2")</th>
					<th>#springMessage("table.remainTerm.condition")</th>
					<th>#springMessage("table.remainTerm.days")</th>
                    <th>#springMessage("table.remainTerm.unit")</th>
					<th>#springMessage("table.remainTerm.logicalRelationship")</th>
                    <th>#springMessage("common.table.thead.operation")</th>
				</tr>
		    </thead>
            <tbody>
            </tbody>
        </table>
        <div class="layui-form-item">
			<div class="layui-input-block" style="text-align: center;">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button class="layui-btn" type="button" lay-filter="reset">#springMessage('common.button.reset')</button>
				<button class="layui-btn" type="button" onClick="closeWindow();">#springMessage('common.button.close')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bi/remainTerm/remainTerm.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html>
<head>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="font-src *  data:">
    <meta name="viewport"
          content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0, user-scalable=no">
    <title>理财产品详情</title>
    <!-- 引入 FrozenUI -->
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css" media="all"/>
    <style>
        html {
            font-size: 26.66667vw;
        }

        .cho-body {
            background-color: #F5F5F5;
        }

        .cho-border {
            border-top: 1px solid #EDEDED;
            padding: 0.1rem 0;
            padding-bottom: 0;
        }

        #tab {
            background: rgba(255, 255, 255, 1);
        }

        .cho-panel-view-item .cho-panel-item-title {
            font-size: 0.16rem;
            font-family: PingFangSC-Semibold, PingFang SC;
            font-weight: 600;
            color: rgba(51, 51, 51, 1);
            line-height: 0.22rem;
            padding: 0.1rem 0.26rem;
        }

        .cho-panel-item-money-left {
            font-size: 0.24rem;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(228, 70, 29, 1);
            padding: 0.02rem 0.26rem;
            padding-bottom: 0
        }

        .cho-panel-item-font-left {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.17rem;
            padding: 0.02rem 0.26rem;
            padding-bottom: 0.12rem;
        }

        .cho-panel-item-money-right {
            font-size: 0.18rem;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(51, 51, 51, 1);
            padding: 0.06rem 0.02rem;;
            padding-bottom: 0;
        }

        .cho-panel-item-font-right {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.17rem;
            padding: 0.06rem 0.02rem;
            padding-bottom: 0.12rem;
        }

        .box-border {
            padding: 0 0.15rem;
        }

        .cho-panel-item-date {
            overflow: hidden;
            font-size: 0.16rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(51, 51, 51, 1);
            line-height: 0.27rem;
            height: 0.27rem;
        }

        .cho-panel-day {
            font-size: 0.18rem;
            font-family: PingFangSC-Semibold, PingFang SC;
            font-weight: 600;
            color: #C7A277;
        }

        .cho-panel-item-date-font {
            font-size: 12px;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.17rem;
            padding: 0.04rem 0;
            padding-bottom: 0.1rem
        }

        #tab1 {
            margin-top: 0.04rem;
            background: rgba(255, 255, 255, 1);
        }

        #tab1 .cho-content-item {
            background: rgba(255, 255, 255, 1);
            border-top: 1px solid #EDEDED;
        }

        #tab1 .cho-content-item-title-left {
            font-size: 14px;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(153, 153, 153, 1);
            line-height: 14px;
            padding-top: 0.14rem;
            padding-left: 0.16rem;
        }

        #tab1 .cho-content-item-money-left {
            min-height: 16px;
            font-size: 14px;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(51, 51, 51, 1);
            line-height: 14px;
            padding-top: 0.14rem;
            padding-right: 0.2rem;
        }
    </style>

</head>
<body>
<section class="cho-body ui-container">
    <section id="tab">
        <div class="cho-panel-view-item">
            <ul class="ui-row">
                <li class="ui-col ui-col-100">
                    <div class="cho-border">
                        <div class="cho-panel-item-title">$!{vo.productName}（$!{vo.productCode}）</div>
                    </div>
                </li>
            </ul>
            <div class="cho-border">
                <ul class="ui-row">
                    <li class="ui-col ui-col-50">
                        <div class="cho-panel-item-money-left">
                            $number.formatNumeric($!{vo.referIncomeMoney})
                        </div>
                        <div class="cho-panel-item-font-left">
                            参考收益（元）
                        </div>
                    </li>
                    <li class="ui-col ui-col-50">
                        <div class="cho-panel-item-money-right">
                            $number.formatNumeric($!{vo.buyMoney})
                        </div>
                        <div class="cho-panel-item-font-right">
                            赎买金额（元）
                        </div>
                    </li>
                </ul>
            </div>
            <div class="box-border">
                <div class="cho-border">
                    <div class="ui-row-flex ui-whitespace">
                        <div class="ui-col ui-col">
                            <div class="cho-panel-item-date">
                                <span class="cho-panel-day">$!{vo.dayLimit}</span>
                            </div>
                            <div class="cho-panel-item-date-font">
                                期限（天）
                            </div>
                        </div>
                        <div class="ui-col ui-col-4">
                            <div class="ui-row-flex ui-whitespace" style="padding-right: 0">
                                <div class="ui-col ui-col">
                                    <div class="cho-panel-item-date">
                                        $!{vo.interestStartDate}
                                    </div>
                                    <div class="cho-panel-item-date-font">
                                        起息日期
                                    </div>
                                </div>
                                <div class="ui-col ui-col">
                                    <div class="cho-panel-item-date">
                                        $!{vo.deadlineDate}
                                    </div>
                                    <div class="cho-panel-item-date-font">
                                        到期日期
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="tab1" style="height: calc(100vh - 2.1rem); overflow-y: auto;">
        <div class="cho-content-item">
            <ul class="ui-row">
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">币别</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $!{vo.curName}
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">银行类别</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $!{vo.bankTypeName}
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">购买银行</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $!{vo.bankName}
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">参考收益率</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $!{vo.referIncomeRate}%
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">收益条款</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $!{vo.incomeClause}
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">赎回日期</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $!{vo.redeemDate}
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">应收利息</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $number.formatNumeric($!{vo.receivableMoney})
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">实收利息</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $number.formatNumeric($!{vo.actualMoney})
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">应收未收利息</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $number.formatNumeric($!{vo.uncollectedMoney})
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">申购费</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $number.formatNumeric($!{vo.subFeeMoney})
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">赎回费</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $number.formatNumeric($!{vo.redeemChargeMoney})
                    </div>
                </li>
                <li class="ui-col ui-col-33">
                    <div class="cho-content-item-title-left">其他手续费</div>
                </li>
                <li class="ui-col ui-col-67">
                    <div class="cho-content-item-money-left">
                        $number.formatNumeric($!{vo.chargeMoney})
                    </div>
                </li>
            </ul>
        </div>
    </section>
</section>

<!-- 注意：如果你直接复制所有代码到本地，上述js路径需要改成你本地的 -->
<script src="${basePath}/static/mobile/plugins/zepto/zepto.min.js"></script>
<script src="${basePath}/static/plugins/f2/f2.min.js"></script>
<script>
    (function (doc, win) {

    })(document, window);
</script>

</body>
</html>

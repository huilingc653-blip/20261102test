#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<input id="id" name="id" type="hidden" value="$!{choBankFinancePage.id}">
<input id="busType" name="busType" type="hidden" value="$!{busType}">

<ul class="mui-table-view">
    <li class="mui-table-view-cell">
        #springMessage('table.choBankFinance.billNo')
        <span class="mui-badge mui-badge-inverted">
            $!{choBankFinancePage.billNo}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.choBankFinance.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{choBankFinancePage.corpName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #if($!{choBankFinancePage.busType} == 10 || $!{choBankFinancePage.busType} == 12)
            #springMessage('table.choBankFinance.currentAcc')
        #elseif($!{choBankFinancePage.busType} == 11)
            #springMessage('table.choBankFinance.timeAcc')
        #elseif($!{choBankFinancePage.busType} == 13)
            #springMessage('table.choBankFinance.noticeAcc')
        #end
        <span class="mui-badge mui-badge-inverted">
            $!{choBankFinancePage.payerAcc}
        </span>
    </li>

    #if($!{choBankFinancePage.busType} == 10 || $!{choBankFinancePage.busType} == 12)
        <li class="mui-table-view-cell">
            #springMessage('table.choBankFinance.interestRate')
            <span class="mui-badge mui-badge-inverted">
                $!rateTag.show($!{choBankFinancePage.interestRate})
        </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.choBankFinance.balance')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{choBankFinancePage.balance})
        </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.choBankFinance.payMoney')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{choBankFinancePage.payMoney})
            </span>
        </li>
        #if($!{choBankFinancePage.busType} == 10)
            <li class="mui-table-view-cell">
                #springMessage('table.choBankFinance.interestStartDate')
                <span class="mui-badge mui-badge-inverted">
                    $!date.format('yyyy-MM-dd',$!{choBankFinancePage.interestStartDate})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.choBankFinance.dayLimit')
                <span class="mui-badge mui-badge-inverted">
                    $!{choBankFinancePage.dayLimit}$dictTag.get("choBankFinance.dateUnit",$!{choBankFinancePage.dateUnit})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.choBankFinance.deadlineDate')
                <span class="mui-badge mui-badge-inverted">
                    $!date.format('yyyy-MM-dd',$!{choBankFinancePage.deadlineDate})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.choBankFinance.certificateWay')
                <span class="mui-badge mui-badge-inverted">
                    $dictTag.get("choBankFinance.certificateWay",$!{choBankFinancePage.certificateWay})
                </span>
            </li>
        #else
            <li class="mui-table-view-cell">
                #springMessage('table.choBankFinance.interestStartDate')
                <span class="mui-badge mui-badge-inverted">
                    $!date.format('yyyy-MM-dd',$!{choBankFinancePage.interestStartDate})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.choBankFinance.deadlineDate')
                <span class="mui-badge mui-badge-inverted">
                    $!date.format('yyyy-MM-dd',$!{choBankFinancePage.deadlineDate})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.choBankFinance.noticeDayLimit')
                <span class="mui-badge mui-badge-inverted">
                    $!{choBankFinancePage.dayLimit}$dictTag.get("choBankFinance.dateUnit",$!{choBankFinancePage.dateUnit})
                </span>
            </li>
            <li class="mui-table-view-cell">
                #springMessage('table.choBankFinance.purpose')
                <span class="mui-badge mui-badge-inverted">
                    $!{choBankFinancePage.purpose}
                </span>
            </li>
        #end
    #else
        <li class="mui-table-view-cell">
            #springMessage('table.choBankFinance.currentAcc')
            <span class="mui-badge mui-badge-inverted">
                $!{choBankFinancePage.payeeAcc}
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.choBankFinance.balance')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{choBankFinancePage.balance})
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.choBankFinance.payMoney')
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{choBankFinancePage.payMoney})
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.choBankFinance.noticeDayLimit')
            <span class="mui-badge mui-badge-inverted">
                $!{choBankFinancePage.dayLimit}$dictTag.get("choBankFinance.dateUnit",$!{choBankFinancePage.dateUnit})
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.choBankFinance.interestRate')
            <span class="mui-badge mui-badge-inverted">
                $!rateTag.show($!{choBankFinancePage.interestRate})
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.choBankFinance.wishPayday')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!{choBankFinancePage.wishPayday})
            </span>
        </li>
        <li class="mui-table-view-cell">
            #springMessage('table.choBankFinance.purpose')
            <span class="mui-badge mui-badge-inverted">
                $!{choBankFinancePage.purpose}
            </span>
        </li>
    #end
    </tbody>
    #if($!{choBankFinancePage.busType} == 10 || $!{choBankFinancePage.busType} == 12)
        <li class="mui-table-view-cell  mui-collapse keep-unfold">
            <a class="mui-navigate-right" href="#">
                #springMessage('table.choBankFinance.bl')
            </a>
            <ul class="mui-table-view H-theme-background-color-white">
                <li class="mui-table-view-cell">
                    #springMessage('table.choBankFinance.bankBillNo')
                    <span class="mui-badge mui-badge-inverted">
                        $!{choBankFinancePage.bankBillNo}
                    </span>
                </li>
                <li class="mui-table-view-cell">
                    #springMessage('table.choBankFinance.blInterestRate')
                    <span class="mui-badge mui-badge-inverted">
                        $!rateTag.show($!{choBankFinancePage.blInterestRate})
                    </span>
                </li>
                <li class="mui-table-view-cell">
                    #if($!{choBankFinancePage.busType} == 10)
                        #springMessage('table.choBankFinance.timeAcc')
                    #end
                    #if($!{choBankFinancePage.busType} == 12)
                        #springMessage('table.choBankFinance.noticeAcc')
                    #end
                    <span class="mui-badge mui-badge-inverted">
                        $!number.formatNumeric($!{choBankFinancePage.blInterest})
                    </span>
                </li>
                <li class="mui-table-view-cell">
                    #springMessage('table.choBankFinance.blInterest')
                    <span class="mui-badge mui-badge-inverted">
                        $!{choBankFinancePage.payeeAcc}
                    </span>
                </li>
            </ul>
        </li>
    #end
</ul>
    #parse("views/common/wapfooter.vm")
</body>

</html>

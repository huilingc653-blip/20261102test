<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input id="id" name="id" type="hidden" value="$!{choProductReqPage.id}">
    <input id="billNo" name="billNo" type="hidden" value="$!{choProductReqPage.billNo}">
    <input id="busType" name="busType" type="hidden" value="$!{busType}">
    #if($!{choProductReqTempPage})
        <div>
            <table class="layui-table">
                <thead>
                <tr>
                    <th colspan="4" style="text-align:center">理财产品购买申请</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    ##单位
                    <td class="textRight">#springMessage("table.choBankFinance.corpId")</td>
                    <td width="35%">$!{choProductReqTempPage.corpName}</td>
                    ##理财类型
                    <td class="textRight">#springMessage("table.choProduct.financialType")</td>
                    <td width="35%">$!{choProductReqTempPage.financialTypeName}</td>
                </tr>
                <tr>
                    ##产品类型
                    <td class="textRight">#springMessage("table.choProduct.productType")</td>
                    <td width="35%">
                        $dictTag.get("cho.productType",$!{choProductReqTempPage.productType})
                    </td>
                    ##产品代码
                    <td class="textRight">#springMessage("table.choProduct.productCode")</td>
                    <td width="35%">$!{choProductReqTempPage.productCode}</td>
                </tr>
                <tr>
                    ##产品名称
                    <td class="textRight">#springMessage("table.choProduct.productName")</td>
                    <td width="35%">$!{choProductReqTempPage.productName}</td>
                    ##银行类别
                    <td class="textRight">#springMessage("table.choProduct.bankTypeId")</td>
                    <td width="35%">$!{choProductReqTempPage.bankTypeName}</td>
                </tr>
                <tr>
                    ##购买银行
                    <td class="textRight">#springMessage("table.choProductReq.bankName")</td>
                    <td width="35%">$!{choProductReqTempPage.bankName}</td>
                    ##币别
                    <td class="textRight">#springMessage("table.choProduct.curId")</td>
                    <td width="35%">$!{choProductReqTempPage.curName}</td>
                </tr>
                <tr>
                    ##购买金额
                    <td class="textRight">#springMessage("table.choProductReq.buyMoneyLow")</td>
                    <td width="35%">
                        $!number.formatNumeric($!{choProductReqTempPage.buyMoney})
                        <input type="hidden" data-name="buyMoney" autocomplete="off"
                               class="layui-input bt-biz-moneyType" value="$!{choProductReqTempPage.buyMoney}">
                    </td>
                    ##理财账号
                    <td class="textRight">#springMessage("table.choProductReq.bankAcc")</td>
                    <td width="35%">$!{choProductReqTempPage.bankAcc}</td>
                </tr>
                <tr>
                    ##购买日期
                    <td class="textRight">#springMessage("table.choProductReq.buyDate")</td>
                    <td width="35%">$!date.format('yyyy-MM-dd',$!{choProductReqTempPage.buyDate})</td>
                    ##收益条款
                    <td class="textRight">#springMessage("table.choProductReq.incomeClause")</td>
                    <td width="35%">
                        $dictTag.get("choProduct.incomeClause",$!{choProductReqTempPage.incomeClause})
                    </td>
                </tr>
                <tr>
                    ##起息日期
                    <td class="textRight">#springMessage("table.choProductReq.interestStartDate")</td>
                    <td width="35%">$!date.format('yyyy-MM-dd',$!{choProductReqTempPage.interestStartDate})</td>
                    ##到期日期
                    <td class="textRight">#springMessage("table.choProductReq.deadlineDate")</td>
                    <td width="35%">$!date.format('yyyy-MM-dd',$!{choProductReqTempPage.deadlineDate})</td>
                </tr>
                <tr>
                    ##兑付日期
                    <td class="textRight">#springMessage("table.choProductReq.cashDate")</td>
                    <td width="35%">$!date.format('yyyy-MM-dd',$!{choProductReqTempPage.cashDate})</td>
                    ##参考收益率
                    <td class="textRight">#springMessage("table.choProductReq.referIncomeRate")</td>
                    <td width="35%">
                        #if($!{choProductReqTempPage.endReferIncomeRate})
                            $rateTag.show($!{choProductReqTempPage.referIncomeRate},6)-$rateTag.show($!{choProductReqTempPage.endReferIncomeRate},6)
                        #else
                            #if($!{choProductReqTempPage.referIncomeRate})
                                $rateTag.show($!{choProductReqTempPage.referIncomeRate},6)
                            #end
                        #end
                    </td>
                </tr>
                <tr>
                    ##参考收益
                    <td class="textRight">#springMessage("table.choProductReq.referIncomeMoney")</td>
                    <td width="35%">
                        #if($!{choProductReqTempPage.endReferIncomeMoney})
                            $!number.formatNumeric($!{choProductReqTempPage.referIncomeMoney})-$!number.formatNumeric($!{choProductReqTempPage.endReferIncomeMoney})
                        #else
                            #if($!{choProductReqTempPage.referIncomeMoney})
                                $!number.formatNumeric($!{choProductReqTempPage.referIncomeMoney})
                            #end
                        #end
                    </td>
                    ##资金来源
                    <td class="textRight">#springMessage("table.choProductReq.capitalSource")</td>
                    <td width="35%">$dictTag.get("choProduct.capitalSource",$!{choProductReqTempPage.capitalSource})</td>
                </tr>
                <tr>
                    ##期限
                    <td class="textRight">#springMessage("table.choProductReq.dayLimit")</td>
                    <td width="35%">
                        $!{choProductReqTempPage.dayLimit}
                    </td>
                    ##申购费
                    <td class="textRight">#springMessage("table.choProductReq.subFeeMoneyRedeem")</td>
                    <td width="35%">
                        <label id="reqSubFeeMoney">$!number.formatNumeric($!{choProductReqTempPage.subFeeMoney})</label>
                    </td>
                </tr>
                <tr>
                    ##其他手续费
                    <td class="textRight">#springMessage("table.choProductReq.chargeMoneyRedeem")</td>
                    <td width="35%">
                        <label id="reqChargeMoney">$!number.formatNumeric($!{choProductReqTempPage.chargeMoney})</label>
                    </td>
                    ##资金来源
                    <td class="textRight">#springMessage("table.choProductReq.capitalSource")</td>
                    <td>
                        <label id="capitalSource">$dictTag.get("choProduct.capitalSource",$!{choProductReqTempPage.capitalSource})</label>
                    </td>
                </tr>
                <tr>
                    ##是否可提前赎回
                    <td class="textRight">#springMessage("table.choProductReq.isMoveUp")</td>
                    <td width="35%">
                        $dictTag.get("sf_yn",$!{choProductReqTempPage.isMoveUp})
                    </td>
                    #if($!{choProductReqTempPage.financialType} eq 0)
                        ##到期是否续存
                        <td class="textRight fType" >#springMessage("table.choProduct.isStore")</td>
                        <td class="fType" >
                            <label id="isStore">$dictTag.get("sf_yn",$!{choProductReqTempPage.isStore})</label>
                        </td>
                    #end
                    ## 是否维护日净值
                    #if($!{choProductReqTempPage.financialType} eq 2)
                        <td class="textRight fType" >#springMessage("table.choProductReq.isMaintainVal")</td>
                        <td class="fType" >
                            <label id="isMaintainVal">$dictTag.get("sf_yn",$!{choProductReqTempPage.isMaintainVal})</label>
                        </td>
                    #end
                </tr>
                    #if($!{choProductReqTempPage.financialType} eq 0)
                    <tr class="fType" >
                        ##付息方式
                        <td class="textRight" #if($!{choProductReqPage.financialType} ne '0') style="display: none" #end>#springMessage("table.cmsProvideLoanInfo.cplInterestPayment")</td>
                        <td #if($!{choProductReqPage.financialType} ne '0') style="display: none" #end>
                            <label id="payWay">$dictTag.get("financial.payWay",$!{choProductReqTempPage.payWay})</label>
                        </td>
                        ##收益类型
                        <td class="textRight">#springMessage("table.choProduct.incomeType")</td>
                        <td>
                            <label id="incomeType">
                                #if($dictTag.get("financial.type",$!{choProductReqTempPage.incomeType}) ne '')
                            $dictTag.get("financial.type",$!{choProductReqTempPage.incomeType})
                        #else
                                    $!{choProductReqTempPage.incomeType}
                                #end
                            </label>
                        </td>
                    </tr>
                    <tr >
                        ##合同号
                        <td class="textRight">#springMessage("table.ratUrationApply.contactNo")</td>
                        <td>
                            <label id="contractNo">$!{choProductReqTempPage.contractNo}</label>
                        </td>
                        ##合同利率
                        <td class="textRight">#springMessage('table.choProductReq.contractRate')</td>
                        <td>
                            <label id="contractRate">
                                #if($!{choProductReqTempPage.endContractRate})
                                    $rateTag.show($!{choProductReqTempPage.startContractRate},6)
                                    ~
                                    $rateTag.show($!{choProductReqTempPage.endContractRate},6)
                                #else
                                    #if($!{choProductReqTempPage.startContractRate})
                                        $rateTag.show($!{choProductReqTempPage.startContractRate},6)
                                    #end
                                #end
                            </label>

                        </td>
                    </tr>
                    #end
                <tr>
                    ##提前回购条约
                    <td class="textRight">#springMessage("table.choProductReq.moveUpRmk")</td>
                    <td colspan="3">
                        <textarea readonly type="text" id="moveUpRmk" name="moveUpRmk" class="layui-textarea" placeholder="#springMessage("table.choProductReq.moveUpRmk")">$!{choProductReqTempPage.moveUpRmk}</textarea>
                    </td>
                </tr>
                <tr>
                    ##备注
                    <td class="textRight">#springMessage("table.choProduct.rmk")</td>
                    <td colspan="3">
                        <textarea readonly type="text" id="rmk" name="rmk" class="layui-textarea" placeholder="#springMessage("table.choProduct.rmk")">$!{choProductReqTempPage.rmk}</textarea>
                    </td>
                </tr>
                </tbody>
            </table>
        </div> #end
    <div id="print">
        <table class="layui-table">
            <thead>
            <tr>
                <th colspan="4" style="text-align:center">理财登记</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                ##单位
                <td class="textRight">#springMessage("table.choBankFinance.corpId")</td>
                <td width="35%">$!{choProductReqPage.corpName}</td>
                ##理财类型
                <td class="textRight">#springMessage("table.choProduct.financialType")</td>
                <td width="35%">$!{choProductReqPage.financialTypeName}</td>
            </tr>
            <tr>
                ##产品类型
                <td class="textRight">#springMessage("table.choProduct.productType")</td>
                <td width="35%">
                    $dictTag.get("cho.productType",$!{choProductReqPage.productType})
                </td>
                ##产品代码
                <td class="textRight">#springMessage("table.choProduct.productCode")</td>
                <td width="35%">$!{choProductReqPage.productCode}</td>
            </tr>
            <tr>
                ##产品名称
                <td class="textRight">#springMessage("table.choProduct.productName")</td>
                <td width="35%">$!{choProductReqPage.productName}</td>
                ##银行类别
                <td class="textRight">#springMessage("table.choProduct.bankTypeId")</td>
                <td width="35%">$!{choProductReqPage.bankTypeName}</td>
            </tr>
            <tr>
                ##购买银行
                <td class="textRight">#springMessage("table.choProductReq.bankName")</td>
                <td width="35%">$!{choProductReqPage.bankName}</td>
                ##币别
                <td class="textRight">#springMessage("table.choProduct.curId")</td>
                <td width="35%">$!{choProductReqPage.curName}</td>
            </tr>
            <tr>
                ##购买金额
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.buyMoney} eq $!{choProductReqTempPage.buyMoney}))) style="color: red" #end>#springMessage("table.choProductReq.buyMoneyLow")</td>
                <td width="35%">
                    $!number.formatNumeric($!{choProductReqPage.buyMoney})
                    <input type="hidden" data-name="buyMoney" autocomplete="off"
                           class="layui-input bt-biz-moneyType" value="$!{choProductReqPage.buyMoney}">
                </td>
                ##理财账号
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.bankAcc} eq $!{choProductReqTempPage.bankAcc}))) style="color: red" #end>#springMessage("table.choProductReq.bankAcc")</td>
                <td width="35%">$!{choProductReqPage.bankAcc}</td>
            </tr>
            <tr>
                ##购买日期
                <td class="textRight">#springMessage("table.choProductReq.buyDate")</td>
                <td width="35%">$!date.format('yyyy-MM-dd',$!{choProductReqPage.buyDate})</td>
                ##收益条款
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.incomeClause} eq $!{choProductReqTempPage.incomeClause}))) style="color: red" #end>#springMessage("table.choProductReq.incomeClause")</td>
                <td width="35%">
                    $dictTag.get("choProduct.incomeClause",$!{choProductReqPage.incomeClause})
                </td>
            </tr>
            <tr>
                ##起息日期
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.interestStartDate} eq $!{choProductReqTempPage.interestStartDate}))) style="color: red" #end>#springMessage("table.choProductReq.interestStartDate")</td>
                <td width="35%">$!date.format('yyyy-MM-dd',$!{choProductReqPage.interestStartDate})</td>
                ##到期日期
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.deadlineDate} eq $!{choProductReqTempPage.deadlineDate}))) style="color: red" #end>#springMessage("table.choProductReq.deadlineDate")</td>
                <td width="35%">$!date.format('yyyy-MM-dd',$!{choProductReqPage.deadlineDate})</td>
            </tr>
            <tr>
                ##兑付日期
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.cashDate} eq $!{choProductReqTempPage.cashDate}))) style="color: red" #end>#springMessage("table.choProductReq.cashDate")</td>
                <td width="35%">$!date.format('yyyy-MM-dd',$!{choProductReqPage.cashDate})</td>
                ##参考收益率
                <td class="textRight"  #if($!{choProductReqPage.financialType} eq '2') style="display: none"
                #elseif($!{choProductReqPage.status} && $!{choProductReqTempPage} &&
                (!($!{choProductReqPage.referIncomeRate} eq $!{choProductReqTempPage.referIncomeRate}) || !($!{choProductReqPage.endReferIncomeRate} eq $!{choProductReqTempPage.endReferIncomeRate}))) style="color: red" #end>
                    #springMessage("table.choProductReq.referIncomeRate")</td>
                <td width="35%"  #if($!{choProductReqPage.financialType} eq '2') style="display: none" #end>
                    #if($!{choProductReqPage.endReferIncomeRate})
                        $rateTag.show($!{choProductReqPage.referIncomeRate},6)-$rateTag.show($!{choProductReqPage.endReferIncomeRate},6)
                    #else
                        #if($!{choProductReqPage.referIncomeRate})
                            $rateTag.show($!{choProductReqPage.referIncomeRate},6)
                        #end
                    #end
                </td>
                ##购买日净值
                <td class="textRight"  #if($!{choProductReqPage.financialType} ne '2') style="display: none"
                #elseif($!{choProductReqPage.status} && $!{choProductReqTempPage} &&
                (!($!{choProductReqPage.dailyNetVal} eq $!{choProductReqTempPage.dailyNetVal}))) style="color: red" #end>#springMessage("table.choProductReq.dailyNetVal")</td>
                <td width="35%"  #if($!{choProductReqPage.financialType} ne '2') style="display: none" #end>
                    <input type="text" data-name="dailyNetVal" data-biz-name="dailyNetVal" class="layui-input bt-biz-moneyType" data-decimal="6" value="$!{choProductReqPage.dailyNetVal}"
                           placeholder="#springMessage("table.choProductReq.dailyNetVal")" readonly>
                </td>
            </tr>
            <tr>
                ##参考收益
                <td class="textRight" #if($!{choProductReqPage.financialType} eq '2') style="display: none"
                #elseif($!{choProductReqPage.status} && $!{choProductReqTempPage} &&
                (!($!{choProductReqPage.referIncomeMoney} eq $!{choProductReqTempPage.referIncomeMoney}) || !($!{choProductReqPage.endReferIncomeMoney} eq $!{choProductReqTempPage.endReferIncomeMoney}))) style="color: red" #end>#springMessage("table.choProductReq.referIncomeMoney")</td>
                <td width="35%" #if($!{choProductReqPage.financialType} eq '2') style="display: none" #end>
                    #if($!{choProductReqPage.endReferIncomeMoney})
                        $!number.formatNumeric($!{choProductReqPage.referIncomeMoney})-$!number.formatNumeric($!{choProductReqPage.endReferIncomeMoney})
                    #else
                        #if($!{choProductReqPage.referIncomeMoney})
                            $!number.formatNumeric($!{choProductReqPage.referIncomeMoney})
                        #end
                    #end
                </td>
                ##份额
                <td class="textRight"  #if($!{choProductReqPage.financialType} ne '2') style="display: none"
                #elseif($!{choProductReqPage.status} && $!{choProductReqTempPage} &&
                (!($!{choProductReqPage.portion} eq $!{choProductReqTempPage.portion}))) style="color: red" #end>#springMessage("table.choProductReq.portion")</td>
                <td width="35%"  #if($!{choProductReqPage.financialType} ne '2') style="display: none" #end>
                    <input type="text" id="portion" name="portion" style="text-align:right" data-name="portion" data-biz-name="portion" data-decimal="6"
                           autocomplete="off" class="layui-input bt-biz-moneyType"  value="$!{choProductReqPage.portion}"  readonly>
                </td>
                ##资金来源
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.capitalSource} eq $!{choProductReqTempPage.capitalSource}))) style="color: red" #end>#springMessage("table.choProductReq.capitalSource")</td>
                <td width="35%">$dictTag.get("choProduct.capitalSource",$!{choProductReqPage.capitalSource})</td>
            </tr>
            <tr>
                ##期限
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.dayLimit} eq $!{choProductReqTempPage.dayLimit}))) style="color: red" #end>#springMessage("table.choProductReq.dayLimit")</td>
                <td width="35%">
                    $!{choProductReqPage.dayLimit}
                </td>
                ##申购费
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.subFeeMoney} eq $!{choProductReqTempPage.subFeeMoney}))) style="color: red" #end>#springMessage("table.choProductReq.subFeeMoneyRedeem")</td>
                <td width="35%">
                    <label id="reqSubFeeMoney">$!number.formatNumeric($!{choProductReqPage.subFeeMoney})</label>
                </td>
            </tr>
            <tr>
                ##其他手续费
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.chargeMoney} eq $!{choProductReqTempPage.chargeMoney}))) style="color: red" #end>#springMessage("table.choProductReq.chargeMoneyRedeem")</td>
                <td width="35%">
                    <label id="reqChargeMoney">$!number.formatNumeric($!{choProductReqPage.chargeMoney})</label>
                </td>
            </tr>
            <tr>
                ##是否可提前赎回
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.isMoveUp} eq $!{choProductReqTempPage.isMoveUp}))) style="color: red" #end>#springMessage("table.choProductReq.isMoveUp")</td>
                <td width="35%">
                    $dictTag.get("sf_yn",$!{choProductReqPage.isMoveUp})
                </td>
                #if($!{choProductReqPage.financialType} eq 0)
                    ##到期是否续存
                    <td class="textRight fType"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.isStore} eq $!{choProductReqTempPage.isStore}))) style="color: red" #end>#springMessage("table.choProduct.isStore")</td>
                    <td class="fType" >
                        <label id="isStore">$dictTag.get("sf_yn",$!{choProductReqPage.isStore})</label>
                    </td>
                #end
                ## 是否维护日净值
                #if($!{choProductReqPage.financialType} eq 2)
                    <td class="textRight fType" >#springMessage("table.choProductReq.isMaintainVal")</td>
                    <td class="fType" >
                        <label id="isMaintainVal">$dictTag.get("sf_yn",$!{choProductReqPage.isMaintainVal})</label>
                    </td>
                #end
            </tr>
                #if($!{choProductReqPage.financialType} eq 0 || $!{choProductReqPage.financialType} eq 2)
                <tr class="fType" >
                    ##付息方式
                    <td class="textRight" #if($!{choProductReqPage.financialType} ne '0') style="display: none" #elseif(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.payWay} eq $!{choProductReqTempPage.payWay}))) style="color: red" #end>#springMessage("table.cmsProvideLoanInfo.cplInterestPayment")</td>
                    <td #if($!{choProductReqPage.financialType} ne '0') style="display: none" #end>
                        <label id="payWay">$dictTag.get("financial.payWay",$!{choProductReqPage.payWay})</label>
                    </td>
                    ##收益类型
                    <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.incomeType} eq $!{choProductReqTempPage.incomeType}))) style="color: red" #end>#springMessage("table.choProduct.incomeType")</td>
                    <td>
                        <label id="incomeType">
                            #if($dictTag.get("financial.type",$!{choProductReqPage.incomeType}) ne '')
                            $dictTag.get("financial.type",$!{choProductReqPage.incomeType})
                        #else
                                $!{choProductReqPage.incomeType}
                            #end
                        </label>
                    </td>
                </tr>
                <tr >
                    ##合同号
                    <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.contractNo} eq $!{choProductReqTempPage.contractNo}))) style="color: red" #end>#springMessage("table.ratUrationApply.contactNo")</td>
                    <td>
                        <label id="contractNo">$!{choProductReqPage.contractNo}</label>
                    </td>
                    ##合同利率
                    <td class="textRight" #if($!{choProductReqPage.status} && $!{choProductReqTempPage} &&
                    (!($!{choProductReqPage.startContractRate} eq $!{choProductReqTempPage.startContractRate}) || !($!{choProductReqPage.endContractRate} eq $!{choProductReqTempPage.endContractRate}))) style="color: red" #end>#springMessage('table.choProductReq.contractRate')</td>
                    <td>
                        <label id="contractRate">
                            #if($!{choProductReqPage.endContractRate})
                                $rateTag.show($!{choProductReqPage.startContractRate},6)
                                ~
                                $rateTag.show($!{choProductReqPage.endContractRate},6)
                            #else
                                #if($!{choProductReqPage.startContractRate})
                                    $rateTag.show($!{choProductReqPage.startContractRate},6)
                                #end
                            #end
                        </label>

                    </td>
                </tr>
                #end
            <tr>
                ##提前回购条约
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.moveUpRmk} eq $!{choProductReqTempPage.moveUpRmk}))) style="color: red" #end>#springMessage("table.choProductReq.moveUpRmk")</td>
                <td colspan="3">
                    <textarea readonly type="text" id="moveUpRmk" name="moveUpRmk" class="layui-textarea" placeholder="#springMessage("table.choProductReq.moveUpRmk")">$!{choProductReqPage.moveUpRmk}</textarea>
                </td>
            </tr>
            <tr>
                ##备注
                <td class="textRight"  #if(($!{choProductReqPage.status} && $!{choProductReqTempPage} && !($!{choProductReqPage.rmk} eq $!{choProductReqTempPage.rmk}))) style="color: red" #end>#springMessage("table.choProduct.rmk")</td>
                <td colspan="3">
                    <textarea readonly type="text" id="rmk" name="rmk" class="layui-textarea" placeholder="#springMessage("table.choProduct.rmk")">$!{choProductReqPage.rmk}</textarea>
                </td>
            </tr>
            </tbody>
        </table>
        <!-- 附件上传 -->
        <input id="attachmentId" name="attachmentId" type="hidden" value="$!{choProductReqPage.attachmentId}">
        <div id="uploader" class="layui-input-inline" style="width:100%"></div>
        <br><br>
    <p>
        <!-- 赎回记录 -->
        #if($!{list})
            <div id="redeemMsg">
                <table id="appTable" class="layui-table layui-form" style="width:100%;">
                    <thead>
                    <tr>
                        <th>#springMessage("table.choProductRedeem.redeemDate")</th>
                        <th>#springMessage("table.choProductRedeem.redeemMoney")</th>
                        <th>#springMessage("table.choProductRedeem.incomeMoney")</th>
                        <th>#springMessage("table.choProductRedeem.incomeRate")</th>
                        <th>#springMessage("table.choProductReq.subFeeMoneyRedeem")</th>
                        <th>#springMessage("table.choProductRedeem.redeemChargeMoney")</th>
                        <th>#springMessage("table.choProductReq.chargeMoneyRedeem")</th>
                        <th>#springMessage("table.choProduct.rmk")</th>
                        <th>#springMessage("table.choProductReq.status")</th>
                    </tr>
                    </thead>
                    #foreach($redeem in $list)
                        <tr>
                            <td class="textCenter">$!date.format('yyyy-MM-dd',$!{redeem.redeemDate})</td>
                            <td class="textCenter">$number.formatNumeric($!{redeem.redeemMoney})</td>
                            <td class="textCenter">$number.formatNumeric($!{redeem.incomeMoney})</td>
                        <td class="textCenter">
                            #if($!{redeem.incomeRate})
                               $rateTag.show($!{redeem.incomeRate},6)</td>
                            #end
                            <td class="textCenter">
                                #if($!{redeem.subFeeMoney})
                                $number.formatNumeric($!{redeem.subFeeMoney})
                            #end
                            </td>
                            <td class="textCenter">
                                #if($!{redeem.redeemChargeMoney})
                                $number.formatNumeric($!{redeem.redeemChargeMoney})
                            #end
                            </td>
                            <td class="textCenter">
                                #if($!{redeem.chargeMoney})
                                $number.formatNumeric($!{redeem.chargeMoney})
                            #end
                            </td>
                            <td class="textCenter">
                                $!{redeem.rmk}
                            </td>
                            <td class="textCenter">$dictTag.get('choBankFinance.status',$!{redeem.status})</td>
                        </tr>
                    #end
                </table>
            </div>
        #end
        #if($!{choProductReqPage.financialType} eq '0' && $!{renewalList})
            <!-- 续期记录 -->
            <div id="renewalMsg">
                <table id="renewalTable" class="layui-table layui-form" style="width:100%;">
                    <thead>
                    <tr>
                        <th>#springMessage("btwarnstrategy.updateDate")</th>
                        <th>#springMessage("table.choProductReq.renewalDate")</th>
                        <th>#springMessage("table.choProductReq.status")</th>
                    </tr>
                    </thead>
                    #foreach($renewal in $renewalList)
                        <tr>
                            <td class="textCenter">$!date.format('yyyy-MM-dd',$!{renewal.updateDate})</td>
                            <td class="textCenter">$!date.format('yyyy-MM-dd',$!{renewal.deadlineDate})</td>
                            <td class="textCenter">$dictTag.get('choBankFinance.status',$!{renewal.status})</td>
                        </tr>
                    #end
                </table>
            </div>
        #end
        <!-- 净值维护记录 -->
        #if($!{choProductReqPage.financialType} eq '2' && $!{netValList})
            <div>
                <form id="searchForm" class="layui-form">
                    <input type="hidden" id="reqId" name="reqId" value="$!{choProductReqPage.id}">
                </form>
                <table id="appTable" class="layui-table layui-form" style="width: 100%;">
                    <thead>
                    <tr>
                        <th>#springMessage("table.fcAccuBalance.date")</th>
                        <th>#springMessage("table.choProductReq.buyMoney")</th>
                        <th>#springMessage("table.choProductReq.buyPortion")</th>
                        <th>#springMessage("table.choProductReq.netVal")</th>
                        <th>#springMessage("table.choProductReq.tenThousandIncome")</th>
                        <th>#springMessage("table.choProductReq.dayIncome")</th>
                        <th>#springMessage("table.choProductReq.actualIncome")</th>
                        <th>#springMessage("table.fcPredrawDtlTemp.balance")</th>
                    </tr>
                    </thead>
                    #foreach($netVal in $netValList)
                        <tr>
                            <td class="textCenter">$!date.format('yyyy-MM-dd',$!{netVal.netValDate})</td>
                            <td class="textCenter">$number.formatNumeric($!{netVal.buyMoney})</td>
                            <td class="textCenter">$number.formatNumeric($!{netVal.buyPortion})</td>
                            <td class="textCenter">$number.formatNumeric($!{netVal.dailyNetVal})</td>
                            <td class="textCenter">$number.formatNumeric($!{netVal.tenThousandIncome})</td>
                            <td class="textCenter">$number.formatNumeric($!{netVal.dayIncome})</td>
                            <td class="textCenter">$number.formatNumeric($!{netVal.actualIncome})</td>
                            <td class="textCenter">$number.formatNumeric($!{netVal.bal})</td>
                        </tr>
                    #end
                </table>
            </div>
        #end
        <!-- 日志 -->
        <div id="tagMsg"></div>
        <p>
    </div>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn"
                    onclick="bt.trackFlowByBusinessId('$!{choProductReqPage.id}')">#springMessage(
                'common.button.trackFlow')</button>
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage(
                'common.button.print')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form', 'layedit', 'moneyType', 'printType', 'btUpload','datatable'], function () {
        var $ = bt.jquery, form = bt.form();
        var moneyType = bt.moneyType.init();
        var moneyFun = bt.moneyType.getFun();
        bt.printType.init();
        var up = bt.btUpload.init({
            elem: "#uploader",
            auto: false,
            hasDelete: true,
            hasUpload: true,
            isExpand: true,
            gid: $("#attachmentId").val()
        });


        /**
         * 生成日志列表
         * @return
         */
            $genMsgHtml = function () {
            var url = basePath + "/chowmatistic/chomessage/list/" + $('#id').val() + "/" + $("#busType").val() + "?timestamp=" + new Date().getTime();
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                    form.render();
                }
            });
        }
            $genMsgHtml();
    });
</script>
</body>
</html>

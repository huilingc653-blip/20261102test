<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<table class="layui-table">
        <tbody>
            <tr>
                ##单位
                <td class="textRight">#springMessage('table.choBankFinance.corpId')</td>
                <td>
                    <div class="layui-inline">
                    	<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-name="likes_corpId"
                            data-scope="all"
							data-resource="cho:bankFinance:choBankFinance:report:query"
							data-callback="bt.corpCallback"></div>
                    </div>
                </td>
                ##业务类型
                <td class="textRight">#springMessage('table.choBankFinance.busType')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select"
                         data-group="choBankFinance.busTypeQuery" data-name="eqi_busType"></div>
                </td>
                ##截止日期
                <td class="textRight">#springMessage('table.choBankFinance.calEndDate')</td>
                <td>
                    <input type="text" name="calEndDate" class="layui-input bt-input-inline bt-biz-dateType" data-today="true" data-type="date">
                </td>
            </tr>
			<tr>
                ##付款账号
                <td class="textRight">#springMessage('table.choBankFinance.acc')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="likes_payerAcc" id="payerAcc" data-biz-name="payerAcc"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.choBankFinance.acc')">
                        <table id="payerAccTable" class="hide">
                            <thead>
                            <tr>
                                <th>#springMessage('table.choBankFinance.acc')</th>
                                <th>#springMessage('table.choBankFinance.accName')</th>
                                <th>#springMessage('table.choBankFinance.accBank')</th>
                                <th>#springMessage('table.choBankFinance.curId')</th>
                            </tr>
                            </thead>
                        </table>
                    </div>
                </td>
				##金额
                <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" data-name="geg_payMoney"
                            autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')" data-moneyendid="t2">
                    </div>
                    <span class="date-mid">~</span>
                    <div class="layui-inline">
                        <input type="text" data-name="leg_payMoney"
                            autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')" id="t2">
                    </div>
                </td>
                ##起息日期
                    <td class="textRight">#springMessage('table.choBankFinance.interestStartDate')</td>
                    <td>
                        <input type="text" name="ged_interestStartDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_interestStartDate" >
                        <span class="date-mid">~</span>
                        <input type="text" name="led_interestStartDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_interestStartDate">
                    </td>
            </tr>
            <tr>
                <td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </tbody>
    </table>
</form>	
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.choBankFinance.corpId')</th>
		<th>#springMessage('table.choBankFinance.busType')</th>
        <th>#springMessage('table.choBankFinance.billNo')</th>
        <th>#springMessage('table.choBankFinance.curId')</th>
        <th>#springMessage('table.choBankFinance.dayLimit')</th>
		<th>#springMessage('table.choBankFinance.acc')</th>
		<th>#springMessage('table.btBankAccApp.accName')</th>
		<th>#springMessage('table.btBankAccApp.bankName')</th>
        <th>#springMessage('table.choBankFinance.payMoney')</th>
        <th>#springMessage('table.choBankFinance.interestRate')</th>
        <th>#springMessage('table.choBankFinance.referInterest')</th>
        <th>#springMessage('table.choBankFinance.interestStartDate')</th>
        <th>#springMessage('table.choBankFinance.deadlineDate')</th>
        <th>#springMessage('table.choBankFinance.wishPayday')</th>
		<th>#springMessage('table.choBankFinance.drawMoney')</th>
        <th>#springMessage('table.choBankFinance.calEndDate')</th>
        <th>#springMessage('table.choBankFinance.calDays')</th>
        <th>#springMessage('table.choBankFinance.interestReceivable')</th>
        <th>#springMessage('table.choBankFinance.blInterest')</th>
        <th>#springMessage('table.choBankFinance.interestReceivableNot')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead> 
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choBankFinance.report.js?_btv=${resourceVersion}"></script>
</html>

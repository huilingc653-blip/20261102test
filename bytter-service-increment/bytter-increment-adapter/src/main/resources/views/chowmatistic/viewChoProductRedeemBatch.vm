<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input id="billNo" name="billNo" type="hidden" value="$!{choProductRedeemPage.billNo}">
    <input id="busType" name="busType" type="hidden" value="$!{busType}">
    <div id="print">
        <table class="layui-table">
            <thead>
            <tr>
                <th colspan="4" style="text-align:center">理财赎回</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                ##单位
                <td class="textRight">#springMessage("table.choBankFinance.corpId")</td>
                <td width="35%">$!{choProductRedeemPage.corpName}</td>
                ##理财类型
                <td class="textRight">#springMessage("table.choProduct.financialType")</td>
                <td width="35%">$!{choProductRedeemPage.financialTypeName}</td>
            </tr>
            <tr>
                ##产品类型
                <td class="textRight">#springMessage("table.choProduct.productType")</td>
                <td width="35%">
                    $dictTag.get("cho.productType",$!{choProductRedeemPage.productType})
                </td>
                ##产品代码
                <td class="textRight">#springMessage("table.choProduct.productCode")</td>
                <td width="35%">$!{choProductRedeemPage.productCode}</td>
            </tr>
            <tr>
                ##产品名称
                <td class="textRight">#springMessage("table.choProduct.productName")</td>
                <td width="35%">$!{choProductRedeemPage.productName}</td>
                ##银行类别
                <td class="textRight">#springMessage("table.choProduct.bankTypeId")</td>
                <td width="35%">$!{choProductRedeemPage.bankTypeName}</td>
            </tr>
            <tr>
                ##购买银行
                <td class="textRight">#springMessage("table.choProductReq.bankName")</td>
                <td width="35%">$!{choProductRedeemPage.bankName}</td>
                ##币别
                <td class="textRight">#springMessage("table.choProduct.curId")</td>
                <td width="35%">$!{choProductRedeemPage.curName}</td>
            </tr>
            <tr>
                ##理财账号
                <td class="textRight">#springMessage("table.choProductReq.bankAcc")</td>
                <td width="35%">$!{choProductRedeemPage.bankAcc}</td>
                <td></td>
                <td></td>
            </tr>
            </tbody>
        </table>
        <table class="layui-table dark-layui-table layui-table-border" id="batchRedeem" style="display: block;">
            <thead id="batchRedeemHead">
            <tr align="center">
                #if($choProductRedeemPage.financialType == 2)
                    <th><span style="color: red">*</span>#springMessage("table.choProductReq.redeemDailyNetVal")</th>
                    <th><span style="color: red">*</span>#springMessage("table.choProductReq.redeemPortion")</th>
                #end
                <th><span style="color: red">*</span>#springMessage("table.choProductRedeem.redeemDate")</th>
                <th><span style="color: red">*</span>#springMessage("table.choProductRedeem.redeemMoney")</th>
                <th><span style="color: red">*</span>#springMessage("table.choProductRedeem.transferDate")</th>
                <th><span style="color: red">*</span>#springMessage("table.choProductRedeem.incomeMoney")</th>
                <th><span style="color: red">*</span>#springMessage("table.choProductRedeem.incomeRate")</th>
                #if($choProductRedeemPage.financialType == '1' && $choProductRedeemPage.productType == '7')
                    <th>#springMessage("table.cho.expect.rate")</th>
                #end
                <th>#springMessage("table.choProduct.rmk")</th>
                <th>#springMessage("table.choProductReq.subFeeMoneyRedeem")</th>
                <th>#springMessage("table.choProductRedeem.redeemChargeMoney")</th>
                <th>#springMessage("table.choProductReq.chargeMoneyRedeem")</th>
                <th>#springMessage("table.choProductRedeem.lastRedeemDate")</th>
                <th>#springMessage("table.choProductReq.incomeClause")</th>
                <th>#springMessage("table.choProductReq.buyDate")</th>
                <th>#springMessage("table.choProductReq.interestStartDate")</th>
                <th>#springMessage("table.choProductReq.deadlineDate")</th>
                <th>#springMessage("table.choProductReq.dayLimit")</th>
                <th>#springMessage("table.choProductReq.cashDate")</th>
                <th>#springMessage("table.choProductReq.buyMoney")</th>
                <th>#springMessage("cho.product.redeem.leftMoney")</th>
                #if($choProductRedeemPage.financialType != 2)
                    <th>#springMessage("table.choProductReq.referIncomeRate")</th>
                    <th>#springMessage("table.choProductReq.referIncomeMoney")</th>
                #end
                <th>#springMessage("table.choProductReq.isMoveUp")</th>
                #if($choProductRedeemPage.financialType != 1)
                    <th>#springMessage("table.choProduct.isStore")</th>
                    <th>#springMessage("table.cmsProvideLoanInfo.cplInterestPayment")</th>
                    <th>#springMessage("table.choProduct.incomeType")</th>
                    <th>#springMessage("table.ratUrationApply.contactNo")</th>
                    <th>#springMessage("table.choProductReq.contractRate")</th>
                #end
                <th>#springMessage("table.choProductReq.capitalSource")</th>
                <th>#springMessage("table.choProductReq.subFeeMoney")</th>
                <th>#springMessage("table.choProductReq.chargeMoney")</th>
            </tr>
            </thead>
            #foreach($data in $list)
                <tr>
                    #if($choProductRedeemPage.financialType == 2)
                        <td>
                            $!number.formatNumeric($!{data.redeemDailyNetVal})
                        </td>
                        <td>
                            $!number.formatNumeric($!{data.redeemPortion})
                        </td>
                    #end
                    <td>$!date.format('yyyy-MM-dd',$!{data.redeemDate})</td>
                    <td>$!number.formatNumeric($!{data.redeemMoney})</td>
                    <td>$!date.format('yyyy-MM-dd',$!{data.transferDate})</td>
                    <td>$!number.formatNumeric($!{data.incomeMoney})</td>
                    <td>$rateTag.show($!{data.incomeRate},6)</td>
                    #if($choProductRedeemPage.financialType == '1' && $choProductRedeemPage.productType == '7')
                        <td>
                            $!{data.expectRate}
                        </td>
                    #end
                    <td>$!{data.rmk}</td>
                    <td>$!number.formatNumeric($!{data.subFeeMoney})</td>
                    <td>$!number.formatNumeric($!{data.redeemChargeMoney})</td>
                    <td>$!number.formatNumeric($!{data.chargeMoney})</td>
                    <td>$!date.format('yyyy-MM-dd',$!{data.lastRedeemDate})</td>
                    <td>$dictTag.get("choProduct.incomeClause",$!{data.incomeClause})</td>
                    <td>$!date.format('yyyy-MM-dd',$!{data.buyDate})</td>
                    <td>$!date.format('yyyy-MM-dd',$!{data.interestStartDate})</td>
                    <td>$!date.format('yyyy-MM-dd',$!{data.deadlineDate})</td>
                    <td>$!{data.dayLimit}</td>
                    <td>$!date.format('yyyy-MM-dd',$!{data.cashDate})</td>
                    <td>$!number.formatNumeric($!{data.buyMoney})</td>
                    <td>$!number.formatNumeric($!{data.leftMoney})</td>
                    #if($choProductRedeemPage.financialType != 2)
                        <td>$rateTag.show($!{data.referIncomeRate},6)
                            #if($!{data.endReferIncomeRate})
                                ~$rateTag.show($!{data.endReferIncomeRate},6)
                            #end
                        </td>
                        <td>$!number.formatNumeric($!{data.referIncomeMoney})
                            #if($!{data.endReferIncomeMoney})
                                ~$!number.formatNumeric($!{data.endReferIncomeMoney})
                            #end
                        </td>
                    #end
                    <td>$dictTag.get("sf_yn",$!{data.isMoveUp})</td>
                    #if($choProductRedeemPage.financialType != 1)
                        <td>$dictTag.get("sf_yn",$!{data.isStore})</td>
                        <td>$dictTag.get("financial.payWay",$!{data.payWay})</td>
                        <td>
                            #if($dictTag.get("financial.type",$!{data.incomeType}) ne '')
                        $dictTag.get("financial.type",$!{data.incomeType})
                     #else
                                $!{data.incomeType}
                            #end
                        </td>
                        <td>$!{data.contactNo}</td>
                        <td>
                            #if($!{data.endContractRate})
                                $rateTag.show($!{data.startContractRate},6)
                                ~
                                $rateTag.show($!{data.endContractRate},6)
                            #else
                                #if($!{data.startContractRate})
                                    $rateTag.show($!{data.startContractRate},6)
                                #end
                            #end
                        </td>
                    #end
                    <td>$dictTag.get("financial.payWay",$!{data.capitalSource})</td>
                    <td>$!number.formatNumeric($!{data.subFeeMoney})</td>
                    <td>$!number.formatNumeric($!{data.chargeMoney})</td>
                </tr>
            #end
        </table>
    </div>
    <!-- 日志 -->
    <div id="tagMsg"></div>
    <p>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{choProductRedeemPage.id}')">#springMessage('common.button.trackFlow')</button>
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form', 'layedit', 'moneyType', 'printType'], function () {
        var $ = bt.jquery, form = bt.form();
        var moneyType = bt.moneyType.init();
        var moneyFun = bt.moneyType.getFun();
        bt.printType.init();

        /**
         * 生成日志列表
         * @return
         */
            $genMsgHtml = function () {
            var url = basePath + "/chowmatistic/chomessage/list/" + $('#billNo').val() + "/" + $("#busType").val() + "?timestamp=" + new Date().getTime();
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                    form.render();
                }
            });
        }
            $genMsgHtml();
    });
</script>
</body>
</html>
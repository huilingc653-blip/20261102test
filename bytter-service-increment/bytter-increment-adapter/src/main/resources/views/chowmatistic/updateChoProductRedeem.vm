<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <table class="layui-table">
        <input id="id" name="id" type="hidden" value="$!{choProductRedeemPage.id}">
        <input id="billNo" name="billNo" type="hidden" value="$!{choProductRedeemPage.billNo}">
        <input id="status" name="status" type="hidden" value="0">
        <input id="reqId" name="reqId" type="hidden" value="$!{choProductRedeemPage.reqId}">
        <input id="dayLimit" name="dayLimit" type="hidden" value="">
        <input id="incomeClause" name="incomeClause" type="hidden" value="$!{choProductRedeemPage.incomeClause}">
        <input id="financialType" name="financialType" type="hidden" value="$!{choProductRedeemPage.financialType}">
        <tbody>
        <tr>
            ##单位名称
            <td class="textRight" width="14%">#springMessage("table.choBankFinance.corpId")</td>
            <td width="36%">
                <div class="layui-input-inline">
                    <span id="showName">$!{choProductRedeemPage.corpName}</span>
                    <input type="hidden" class="layui-input text" id="corpId" name="corpId" value="$!{choProductRedeemPage.corpId}">
                </div>
            </td>
            ##理财类型
            <td class="textRight" width="14%">#springMessage("table.choProduct.financialType")</td>
            <td width="36%">
                <div class="layui-input-inline">
                    <label id="financialTypeName">$!{choProductRedeemPage.financialTypeName}</label>
                </div>
            </td>
        </tr>
        <tr>
            ##产品类型
            <td class="textRight">#springMessage("table.choProduct.productType")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="cho.productType" data-defaultvalue="$!{choProductRedeemPage.productType}" data-required="true"
                     data-name="productType" data-biz-name="productType" id="productType" data-disabled="true"></div>
            </td>
            ##产品代码
            <td class="textRight">#springMessage("table.choProduct.productCode")</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="productCode" name="productCode" lay-verify="required" readonly value="$!{choProductRedeemPage.productCode}"
                           autocomplete="off" class="layui-input text" placeholder="#springMessage("table.choProduct.productCode")">
                </div>
                <div class="layui-input-inline">
                    <button class="layui-btn bt-biz-choProduct" id="selProductBut" type="button" data-callback="callbackProduct">#springMessage('common.button.select')</button>
                </div>
            </td>
        </tr>
        <tr>
            ##产品名称
            <td class="textRight">#springMessage("table.choProduct.productName")</td>
            <td>
                <label id="productName">$!{choProductRedeemPage.productName}</label>
            </td>
            ##银行类别
            <td class="textRight" width="14%">#springMessage("table.choProduct.bankTypeId")</td>
            <td width="36%">
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json" data-required="true"
                     data-name ="bankTypeId" data-biz-name ="bankTypeId"  data-valueField="id" data-textField="typeName"
                     data-disabled="true" data-defaultvalue="$!{choProductRedeemPage.bankTypeId}"></div>
            </td>
        </tr>
        <tr>
            ##购买银行
            <td class="textRight">#springMessage("table.choProductReq.bankName")</td>
            <td>
                <label id="bankName">$!{choProductRedeemPage.bankName}</label>
            </td>
            ##币别
            <td class="textRight">#springMessage("table.choProduct.curId")</td>
            <td>
                <label id="curName">$!{choProductRedeemPage.curName}</label>
            </td>
        </tr>
        <tr>
            ##购买金额(小写)
            <td class="textRight">#springMessage("table.choProductReq.buyMoneyLow")</td>
            <td>
                <label id="buyMoney">$!number.formatNumeric($!{choProductRedeemPage.buyMoney})</label>
                <input type="hidden" id="buyMoneyVal" value="$!{choProductRedeemPage.buyMoney}">
            </td>
            ##理财账号
            <td class="textRight">#springMessage("table.choProductReq.bankAcc")</td>
            <td>
                <label id="bankAcc">$!{choProductRedeemPage.bankAcc}</label>
            </td>
        </tr>
        <tr>
            ##购买日期
            <td class="textRight">#springMessage("table.choProductReq.buyDate")</td>
            <td>
                <label id="buyDate">$!date.format('yyyy-MM-dd',$!{choProductRedeemPage.buyDate})</label>
            </td>
            ##收益条款
            <td class="textRight">#springMessage("table.choProductReq.incomeClause")</td>
            <td>
                <label id="incomeClauseShow">$dictTag.get("choProduct.incomeClause", $!{choProductRedeemPage.incomeClause})</label>
            </td>
        </tr>
        <tr>
            ##起息日期
            <td class="textRight">#springMessage("table.choProductReq.interestStartDate")</td>
            <td>
                <label id="interestStartDate">$!date.format('yyyy-MM-dd',$!{choProductRedeemPage.interestStartDate})</label>
            </td>
            ##期限
            <td class="textRight">#springMessage("table.choProductReq.dayLimit")</td>
            <td>
                <label id="dayLimitShow">$!{choProductRedeemPage.dayLimit}</label>
            </td>
        </tr>
        <tr>
            ##兑付日期
            <td class="textRight">#springMessage("table.choProductReq.cashDate")</td>
            <td>
                <label id="cashDate">$!date.format('yyyy-MM-dd',$!{choProductRedeemPage.cashDate})</label>
            </td>
            ##到期日期
            <td class="textRight">#springMessage("table.choProductReq.deadlineDate")</td>
            <td>
                <label id="deadlineDate">$!date.format('yyyy-MM-dd',$!{choProductRedeemPage.deadlineDate})</label>
            </td>
        </tr>
        <tr>
            ##申购费
            <td class="textRight">#springMessage("table.choProductReq.subFeeMoney")</td>
            <td width="35%">
                <label id="reqSubFeeMoney">$!number.formatNumeric($!{choProductRedeemPage.reqSubFeeMoney})</label>
            </td>
            ##其他手续费
            <td class="textRight">#springMessage("table.choProductReq.chargeMoney")</td>
            <td width="35%">
               <label id="reqChargeMoney">$!number.formatNumeric($!{choProductRedeemPage.reqChargeMoney})</label>
            </td>
        </tr>
        <tr>
            ##参考收益率
            <td class="textRight isShowReferIncome"
                #if($!{choProductRedeemPage.financialType} eq '2') style="display: none" #end>
                #springMessage("table.choProductReq.referIncomeRate")</td>
            <td width="40%" class="isShowReferIncome"
                #if($!{choProductRedeemPage.financialType} eq '2') style="display: none" #end>
                <label id="referIncomeRate">$rateTag.show($!{choProductRedeemPage.referIncomeRate},6)</label>
            </td>
            ##购买日净值
            <td class="textRight isShowDaily"
                #if($!{choProductRedeemPage.financialType} ne '2') style="display: none" #end
            >#springMessage("table.choProductReq.dailyNetVal")</td>
            <td width="35%"  class="isShowDaily"
                #if($!{choProductRedeemPage.financialType} ne '2') style="display: none" #end>
                <input type="text" data-name="dailyNetVal" data-biz-name="dailyNetVal" class="layui-input bt-biz-moneyType" data-decimal="6"
                       placeholder="#springMessage("table.choProductReq.dailyNetVal")" value="$!{choProductRedeemPage.dailyNetVal}" readonly>
            </td>
            ##资金来源
            <td class="textRight">#springMessage("table.choProductReq.capitalSource")</td>
            <td>
                <label id="capitalSource">$dictTag.get("choProduct.capitalSource",$!{choProductRedeemPage.capitalSource})</label>
            </td>
        </tr>
        <tr>
            ##参考收益
            <td class="textRight isShowReferIncome" #if($!{choProductRedeemPage.financialType} eq '2') style="display: none" #end
            >#springMessage("table.choProductReq.referIncomeMoney")</td>
            <td class="isShowReferIncome" #if($!{choProductRedeemPage.financialType} eq '2') style="display: none" #end
            >
                <label id="referIncomeMoney">$!number.formatNumeric($!{choProductRedeemPage.referIncomeMoney})</label>
            </td>
            ##份额
            <td class="textRight isShowDaily"
                #if($!{choProductRedeemPage.financialType} ne '2') style="display: none" #end
            >#springMessage("table.choProductReq.portion")</td>
            <td class="isShowDaily"
                #if($!{choProductRedeemPage.financialType} ne '2') style="display: none" #end>
                <input type="text" id="portion" name="portion" style="text-align:right" data-name="portion" data-biz-name="portion" data-decimal="6"
                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{choProductRedeemPage.portion}" readonly>
            </td>
            ## 可赎回金额
            <td class="textRight showLeftMoney" #if($!{choProductRedeemPage.isMaintainVal} eq '0') style="display: none" #end>#springMessage("cho.product.redeem.leftMoney")</td>
            <td class="showLeftMoney" #if($!{choProductRedeemPage.isMaintainVal} eq '0') style="display: none" #end><label id="leftMoney">
                $!number.formatNumeric($!{leftMoney})
            </label></td>
            <input type="hidden" id="leftMoneyVal" value="$!{leftMoney}">
        </tr>
        <tr>
            ##是否可提前赎回
            <td class="textRight">#springMessage("table.choProductReq.isMoveUp")</td>
            <td width="35%">
                <label id="isMoveUp">$dictTag.get("sf_yn",$!{choProductRedeemPage.isMoveUp})</label>
            </td>
            ## 可赎回本金
            <td class="textRight redeemableMoneyTd"  #if($!{choProductRedeemPage.financialType} ne '2') style="display: none" #end>#springMessage("cho.product.redeemable.money")</td>
            <td class="redeemableMoneyTd" #if($!{choProductRedeemPage.financialType} ne '2') #end><label id="redeemableMoney">
                $!number.formatNumeric($!{redeemableMoney})
            </label></td>
            <input type="hidden" id="redeemableMoneyVal" value="$!{redeemableMoney}">
            ##到期是否续存
            <td class="textRight fType"  #if($!{choProductRedeemPage.financialType} ne '0') style="display: none" #end>#springMessage("table.choProduct.isStore")</td>
            <td class="fType"  #if($!{choProductRedeemPage.financialType} ne '0') style="display: none" #end>
                <label id="isStore">$dictTag.get("sf_yn",$!{choProductRedeemPage.isStore})</label>
            </td>
        </tr>
        <tr >
            ##付息方式
            <td class="textRight fType"
                #if($!{choProductRedeemPage.financialType} ne '0') style="display: none" #end>
                #springMessage("table.cmsProvideLoanInfo.cplInterestPayment")</td>
            <td class="fType" #if($!{choProductRedeemPage.financialType} ne '0') style="display: none" #end>
                <label id="payWay">$dictTag.get("financial.payWay",$!{choProductRedeemPage.payWay})</label>
            </td>
            ##收益类型
            <td class="textRight fType fType2"
                #if($!{choProductRedeemPage.financialType} eq '1') style="display: none" #end
            >#springMessage("table.choProduct.incomeType")</td>
            <td class="fType fType2"
                #if($!{choProductRedeemPage.financialType} eq '1') style="display: none" #end>
                <label id="incomeType">
                    #if($dictTag.get("financial.type",$!{choProductRedeemPage.incomeType}) ne '')
                            $dictTag.get("financial.type",$!{choProductRedeemPage.incomeType})
                        #else
                        $!{choProductRedeemPage.incomeType}
                    #end
                </label>
            </td>
            ##是否维护日净值
            <td class="textRight showIsMaintainVal" #if($!{choProductRedeemPage.financialType} ne '2') style="display: none" #end>#springMessage("table.choProductReq.isMaintainVal")</td>
            <td class="showIsMaintainVal"  #if($!{choProductRedeemPage.financialType} ne '2') style="display: none" #end>
                <label id="isMaintainVal">$dictTag.get("sf_yn",$!{choProductRedeemPage.isMaintainVal})</label>
            </td>
        </tr>
        <tr class="fType fType2" #if($!{choProductRedeemPage.financialType} eq '1') style="display: none" #end>
            ##合同号
            <td class="textRight">#springMessage("table.ratUrationApply.contactNo")</td>
            <td>
                <label id="contractNo">$!{choProductRedeemPage.contractNo}</label>
            </td>
            ##合同利率
            <td class="textRight">#springMessage('table.choProductReq.contractRate')</td>
            <td>
                <label id="contractRate">
                    #if($!{choProductRedeemPage.endContractRate})
                        $rateTag.show($!{choProductRedeemPage.startContractRate},6)
                        ~
                        $rateTag.show($!{choProductRedeemPage.endContractRate},6)
                    #else
                        #if($!{choProductRedeemPage.startContractRate})
                            $rateTag.show($!{choProductRedeemPage.startContractRate},6)
                        #end
                    #end
                </label>

            </td>
        </tr>
        <tr class="isShowRedeem" #if($!{choProductRedeemPage.financialType} ne '2') style="display: none" #end>
            ##赎回日净值
            <td class="textRight isShowRedeem" >#springMessage("table.choProductReq.redeemDailyNetVal")</td>
            <td width="40%" class="isShowRedeem" >
                <input type="text" id="redeemDailyNetVal" name="redeemDailyNetVal" data-name="redeemDailyNetVal" data-biz-name="redeemDailyNetVal" class="layui-input bt-biz-moneyType" data-decimal="6"
                       placeholder="#springMessage("table.choProductReq.redeemDailyNetVal")"
                        #if($!{choProductRedeemPage.financialType} eq '2') lay-verify="required"
                            #if($!{choProductRedeemPage.isMaintainVal} ne '0') disabled #end
                        #end
                       value="$!{choProductRedeemPage.redeemDailyNetVal}" data-callback="redeemDailyNetValCallback">
            </td>
            ##赎回份额
            <td class="textRight isShowRedeem" >#springMessage("table.choProductReq.redeemPortion")</td>
            <td class="isShowRedeem" >
                <input type="text" id="redeemPortion" name="redeemPortion" style="text-align:right" data-name="redeemPortion" data-biz-name="redeemPortion" data-decimal="6"
                       autocomplete="off" class="layui-input bt-biz-moneyType"
                        #if($!{choProductRedeemPage.financialType} eq '2') lay-verify="required" #end
                       data-max="$!{maxPortion}" value="$!{choProductRedeemPage.redeemPortion}" data-callback="redeemPortionCallback" >
            </td>
        </tr>
        <tr>
            ##赎回金额(小写)
            <td class="textRight"><span class="redeemMoneyTd1">
                #if($!{choProductRedeemPage.financialType} eq '2')
                    赎回本金(小写)
                #else
                    #springMessage("table.choProductRedeem.redeemMoneyLow")
                #end
            </span></td>
            <td>
                <input type="text" id="redeemMoney" name="redeemMoney" style="text-align:right" lay-verify="required"
                       data-name="redeemMoney" data-biz-name="redeemMoney" data-toUp="redeemMoneyUp"
                       autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.choProductRedeem.redeemMoneyLow')" data-callback="redeemMoneyCallback" value="$!{choProductRedeemPage.redeemMoney}">
            </td>
            ##赎回金额(大写)
            <td class="textRight redeemMoneyTd2">
                #if($!{choProductRedeemPage.financialType} eq '2')
                    赎回本金(大写)
                #else
                    #springMessage("table.choProductRedeem.redeemMoneyUpper")
                #end
            </td>
            <td>
                <div id="redeemMoneyUp"></div>
            </td>
        </tr>
        <tr>
            ##赎回日期
            <td class="textRight">#springMessage("table.choProductRedeem.redeemDate")</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="redeemDate" name="redeemDate" data-name="redeemDate" data-biz-name="redeemDate" lay-verify="required"
                           class="layui-input bt-biz-dateType" data-max="$!{maxRedeemDate}" data-min="$!{minDate}" data-today="true"
                           data-type="date" data-callback="redeemDateCallback" value="$!{choProductRedeemPage.redeemDate}">
                </div>
                <div class="layui-input-inline" id="lastRedeemDateShow"
                    #if($!{choProductRedeemPage.payWay} ne '2' or !$!{lastRedeemDate}) style="display: none" #end >
                    <label style="color: rgb(184,184,184)">&nbsp;&nbsp;上次赎回日期:</label>
                    <label id="lastRedeemDate" style="color: rgb(184,184,184)">$!{lastRedeemDate}</label>
                </div>
            </td>
            ##收益金额
            <td class="textRight">#springMessage("table.choProductRedeem.incomeMoney")</td>
            <td>
                <input type="text" id="incomeMoney" name="incomeMoney" style="text-align: right;" lay-verify="required" data-name="incomeMoney" value="$!{choProductRedeemPage.incomeMoney}" data-minus="true"
                       data-decimal="2" data-biz-name="incomeMoney" autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="incomeMoneyCallback">
                <input hidden id="incomeMoneyMax">
            </td>
        </tr>
        <tr>
            ##到账日期
            <td class="textRight">#springMessage("table.choProductRedeem.transferDate")</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="transferDate" name="transferDate" data-name="transferDate"
                           data-max="$!{maxRedeemDate}" data-min="$!{minDate}" data-biz-name="transferDate" lay-verify="required"
                           class="layui-input bt-biz-dateType" data-today="true" data-type="date" value="$!{choProductRedeemPage.transferDate}">
                </div>
            </td>
            ##实际收益率
            <td class="textRight isShowReferIncome"
                #if($!{choProductRedeemPage.financialType} eq '2') style="display: none" #end
            >#springMessage("table.choProductRedeem.incomeRate")</td>
            <td class="isShowReferIncome"
                #if($!{choProductRedeemPage.financialType} eq '2') style="display: none" #end>
                <input type="text" data-name="incomeRate" data-biz-name="incomeRate" class="layui-input bt-biz-rateType" data-decimal="6"
                       placeholder="#springMessage("table.choProductRedeem.incomeRate")"
                       #if($!{choProductRedeemPage.financialType} ne '2') lay-verify="required" #end
                       data-callback="bt.incomeRateCallback" value="$!{choProductRedeemPage.incomeRate}">

            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight">#springMessage("table.choProduct.rmk")</td>
            <td colspan="3">
                <textarea type="text" id="rmk" name="rmk" class="layui-textarea" placeholder="#springMessage("table.choProduct.rmk")">$!{choProductRedeemPage.rmk}</textarea>
            </td>
        </tr>

        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button type="button" class="layui-btn" onclick="closeTab()">#springMessage('common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <table class="layui-table layui-form dark-layui-table layui-table-border">
        <thead>
            <th>#springMessage("table.choProductReq.subFeeMoney")</th>
            <th>#springMessage("table.choProductRedeem.redeemChargeMoney")</th>
            <th>#springMessage("table.choProductReq.chargeMoney")</th>
        </thead>
        <tbody>
            <tr>
                <td style="text-align: center;">
                    <input name="subFeeMoney" style="width: 90%; height: 22px;" class="layui-input bt-biz-moneyType" value="$!{choProductRedeemPage.subFeeMoney}">
                </td>
                <td style="text-align: center;">
                    <input name="redeemChargeMoney" style="width: 90%; height: 22px;" class="layui-input bt-biz-moneyType" value="$!{choProductRedeemPage.redeemChargeMoney}">
                </td>
                <td style="text-align: center;">
                    <input name="chargeMoney" style="width: 90%; height: 22px;" class="layui-input bt-biz-moneyType" value="$!{choProductRedeemPage.chargeMoney}">
                </td>
            </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choProductRedeem.update.js?_btv=${resourceVersion}"></script>
</html>
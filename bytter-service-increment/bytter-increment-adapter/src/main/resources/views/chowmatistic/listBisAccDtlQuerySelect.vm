<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody >
        <tr>
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.corp')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="ins_corpId"
                         data-defaultvalue="$!{corpId}"
                         data-scope="all" data-resource="netbank:bankAcc:btBankAccDtl:query"
                         data-callback="corpCallback"></div>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.bankAcc')</td>
            <td width="20%">
                <div class="layui-input-inline">
                    <input type="text" id="likes_bankAcc" name="likes_bankAcc" data-name="likes_bankAcc" data-biz-name="likes_bankAcc" accountType="2,3" autocomplete="off" containDelBankAcc="true"
                           data-resource="netbank:bankAcc:btBankAccDtl:query"  class="layui-input bt-biz-accountTable" data-callback="accountCallBack" permission="D" value="$!{bankAcc}"/>
                </div>
            </td>
            <td class="textRight" width="10%">#springMessage('table.btNetChalk.accName')</td>
            <td width="30%">
                <input type="text" id="likes_accName" name="likes_accName" class="layui-input" autocomplete="off">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAccDtl.oppAccNo')</td>
            <td>
                <input type="text" id="likes_oppAccNo" name="likes_oppAccNo" class="layui-input bank" autocomplete="off">
            </td>
            <td class="textRight">#springMessage('table.btBankAccDtl.oppAccName')</td>
            <td>
                <input type="text" id="likes_oppAccName" name="likes_oppAccName" class="layui-input" autocomplete="off">
            </td>
            <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.transTime')</td>
            <td width="30%">
                <input type="text" name="ged_transTime" data-type="date" data-biz-name="ged_transTime" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_transTime" data-today="true" value="$!{transTime}">
                <span class="date-mid">~</span>
                <input type="text" name="led_transTime" data-type="date" data-biz-name="led_transTime" class="layui-input bt-input-inline bt-biz-dateType" id="led_transTime" data-today="true" value="$!{transTime}">
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAccDtl.bifCode')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/bisbifinit/listFilter" data-method="get"
                         data-valuefield="id" data-textfield="name" data-name="ins_bifCode" data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.btBankAccDtl.curName')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name ="eqs_curId" data-biz-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
            </td>
        ##金额
            <td class="textRight">#springMessage('table.btBankAccDtl.amt')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="geg_amt" autocomplete="off" data-minus="true" class="layui-input bt-biz-moneyType bt-input-inline"
                           style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.bisExc.payMoney')" value="$!{amtMin}">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_amt" autocomplete="off" data-minus="true" class="layui-input bt-biz-moneyType bt-input-inline"
                           data-moneyendid="t20" style="text-align:right" id="t20" placeholder="#springMessage('table.bisExc.payMoney')" value="$!{amtMax}">
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAccDtl.cdSign')</td>
            <td >
                <div class="bt-biz-dict" data-type="select" data-group="btBankAccDtl.cdSign" data-name="eqs_cdSign" data-biz-name="cdSign"></div>
            </td>
            <td class="textRight">#springMessage('table.btBankAccApp.attributeId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/bankacc/bisaccattribute/json" data-method="get"
                         data-valuefield="id" data-textfield="attributeName" data-name="ins_attributeId"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisBillhead.addWord')</td>
            <td>
                <input type="text" id="likes_postscript" name="likes_postscript" class="layui-input" />
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.btBankAcc.natureId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/bankacc/btaccnature/json" data-method="get"
                         data-valuefield="id" data-textfield="natureName" data-name="ins_natureId"
                         data-inputvalue="inputvalue" data-search="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.btBankAccApp.accType')</td>
            <td>
                <div class="bt-biz-dict" data-type="mulselect" data-group="btBankAcc.accType" data-name="ins_accType"
                     data-biz-name="accType"></div>
            </td>
            <td class="textRight">#springMessage('table.btBankAccDtl.uses')</td>
            <td>
                <input type="text" id="likes_uses" name="likes_uses" class="layui-input" />
            </td>
        </tr>
            ##银行流水号
        <tr>
            <td class="textRight">#springMessage('table.bisExc.bankSerialNo')</td>
            <td>
                <input type="text" id="likes_bankSerialNo" name="likes_bankSerialNo" class="bank layui-input" autocomplete="off"
                       placeholder="#springMessage('table.bisExc.bankSerialNo')">
            </td>
            <td class="textRight">#springMessage('table.btBankAccDtl.remark')</td>
            <td >
                <input type="text" id="likes_remark" name="likes_remark" class="layui-input" />
            </td>
            ##账户状态
            <td class="textRight">
                #springMessage('table.fcAcc.accState')
            </td>
            <td colspan="3">
                <div class="bt-biz-dict" data-type="select"
                     data-group="btBankAcc.accStatus" data-name="accStatus"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" class="center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btBankAccDtl.transTime')</th>
        <th>#springMessage('table.btBankAccDtl.corp')</th>
        <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
        <th>#springMessage('table.btBankAccDtl.accName')</th>
        <th>#springMessage('table.btBankAccDtl.bankName')</th>
        <th>#springMessage('table.btBankAccApp.attributeId')</th>
        <th>#springMessage('table.btBankAcc.natureId')</th>
        <th>#springMessage('table.btBankAccApp.accType')</th>
        <th>#springMessage('table.btBankAccDtl.cdSign')</th>
        <th>#springMessage('table.btBankAccDtl.curName')</th>
        <th>#springMessage('table.btBankAccDtl.amt')</th>
        <th>#springMessage('table.btBankAccDtl.bal')</th>
        <th>#springMessage('table.bisExc.bankSerialNo')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
        <th>#springMessage('table.btBankAccDtl.oppAccBank')</th>
        <th>#springMessage('table.btBankAccDtl.remark')</th>
        <th>#springMessage('table.nisBillhead.addWord')</th>
        <th>#springMessage('table.btBankAccDtl.projectRemark')</th>
        <th>#springMessage('table.btBankAccDtl.uses')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisAccDtlQuerySelect.list.js?_btv=${resourceVersion}"></script>
</html>

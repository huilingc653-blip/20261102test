<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<input id="eqi_busType" name="eqi_busType" type="hidden" value="$!{busType}">
	<input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}" />
    <input type="hidden" id="cycleTime" name="cycleTime" value="$!{cycleTime}"/>
    <table class="layui-table">
        <tbody>
            <tr>
                ##单位
                <td class="textRight">#springMessage('table.choBankFinance.corpId')</td>
                <td>
                    <div class="layui-inline">
                    	<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-name="likes_corpId"
                            data-scope="all"
							data-callback="bt.corpCallback"></div>
                    </div>
                </td>
                ##金额
                <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" data-name="geg_payMoney"
                               autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                               data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                    </div>
                    <span class="date-mid">~</span>
                    <div class="layui-inline">
                        <input type="text" data-name="leg_payMoney"
                               autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                               id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
					<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </tbody>
    </table>
</form>	
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.choBankFinance.billNo')</th>
        <th>#springMessage('table.choBankFinance.corpId')</th>
        <th>#springMessage('table.choBankFinance.curId')</th>
        <th>#springMessage('table.choBankFinance.payMoney')</th>
        <th>#springMessage('table.choBankFinance.noticeDayLimit')</th>
        <th>#springMessage('table.choInnerFinance.drawDate')</th>
        <th>#springMessage('table.choBankFinance.purpose')</th>
        <th>#springMessage('table.choInnerFinance.noticeBillNo')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead> 
</table>
    #workFlowHtml()
    #parse("views/common/footer.vm")
    #workFlowScript()
</body>
<script>
    bt.use(['form','datatable','select','corp','dicts','selectTable','moneyType','rateType'], function(){
        $ = bt.jquery,form = bt.form();
        bt.dicts.init();
        var moneyType = bt.moneyType.init();
    	var moneyFun = bt.moneyType.getFun();
        var rateType = bt.rateType.getFun();

        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            colReorder: true,
            checkbox:true,
            order: [1,'desc'],
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath+"/chowmatistic/choinnerfinance/dataTableApprove"
            },
            buttons: [
            ],
            fixedColumns: {
                rightColumns:1//代表冻结右边一列
            }
            ,columns: [
                {data:"billNo",bSortable:true,className:'center'},
                {data:"corpName",bSortable:true},
                {data:"curName",bSortable:true},
                {data:"payMoney",bSortable:true,className:'textRight',
                    render: function ( data, type, full, meta ) {
                        return bt.money.format(full.payMoney);
                    }
                },
                {data:"noticeType",bSortable:true,className:'textRight',
                    render: function ( data, type, full, meta ) {
                        return bt.dict("pricing.noticeType",full.noticeType);
                    }
                },
                {data:"payDate",bSortable:true,className:'center'},
                {data:"purpose",bSortable:true},
                {data:"relatedBillNo",bSortable:true,className:'center'},
                {data:null,bSortable:false,className:'center',render: function (data, type, full, meta) {
                    var html='';
                	if($("#flowStatus").val()=='todo'){
                		html += '<a class="" href="#" data-row="'+meta.row+'" onclick="approve(this)">'+bt.lang("common.button.approve")+'</a>&nbsp;|&nbsp;';
                	}
                    if($("#flowStatus").val() == 'pass'){
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a><span class="text-explode">|</span>';
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.trackFlowByBusinessId(\'' + full.id + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                    }else {
                        html += '<a class="" href="#" data-row="' + meta.row + '" onclick="bt.workFlow.trackFlow(\'' + full.processInstanceId + '\')">' + bt.lang("common.button.trackFlow") + '</a>';
                    }
                    return html;
                }}
            ],
            summary: {
                pageSum: false,
                allSum: true,
                selectSum: true,
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '7',
                        dataName: 'payMoney'
                    }
                ]
            }
        });

        //初始化单位
        bt.corp.init();
    });

    function view(el){
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        parent.layer.open({
            type: 2,
            area: ['850px', '530px'],
            maxmin: true,
            content: basePath + "/chowmatistic/choinnerfinance/view/" + data.id
        });
    }
</script>
<script src="${basePath}/static/modules/chowmatistic/choInnerFinanceApprove.list.js?_btv=${resourceVersion}"></script>
</html>

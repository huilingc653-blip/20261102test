<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form">
    <table class="layui-table">
        <thead>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
            <td width="80%">#springMessage('config.fbs.paramValue')</td>
        </tr>
        </thead>
        <tbody>
        ##定期起存金额
        <tr>
            <td class="textRight">#springMessage('config.choInner.regularOnset')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="choInner.regularOnset" style="text-align:right" autocomplete="off"
                           data-name="choInner.regularOnset" lay-verify="required | number2" class="layui-input bt-biz-moneyType"
                           value="$!{config.choInner.regularOnset}">
                </div>
                <div class="layui-input-inline">#springMessage('config.choBank.moneyUnit')</div>
            </td>
        </tr>
        ##定期留存金额
        <tr>
            <td class="textRight">#springMessage('config.choInner.regularKeep')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="choInner.regularKeep" style="text-align:right" autocomplete="off"
                           data-name="choInner.regularKeep" lay-verify="required | number2" class="layui-input bt-biz-moneyType"
                           value="$!{config.choInner.regularKeep}">
                </div>
                <div class="layui-input-inline">#springMessage('config.choBank.moneyUnit')</div>
            </td>
        </tr>
        ##通知起存金额
        <tr>
            <td class="textRight">#springMessage('config.choInner.noticeOnset')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="choInner.noticeOnset" style="text-align:right" autocomplete="off"
                           data-name="choInner.noticeOnset" lay-verify="required | number2" class="layui-input bt-biz-moneyType"
                           value="$!{config.choInner.noticeOnset}">
                </div>
                <div class="layui-input-inline">#springMessage('config.choBank.moneyUnit')</div>
            </td>
        </tr>
        ##通知留存金额
        <tr>
            <td class="textRight">#springMessage('config.choInner.noticeKeep')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="choInner.noticeKeep" style="text-align:right"
                           data-name="choInner.noticeKeep"
                           lay-verify="required | number2"
                           autocomplete="off" class="layui-input bt-biz-moneyType"
                           value="$!{config.choInner.noticeKeep}">

                </div>
                <div class="layui-input-inline">#springMessage('config.choBank.moneyUnit')</div>
            </td>
        </tr>
        ##协定存款到期提醒天数
        <tr>
            <td class="textRight">#springMessage('config.choInner.agreedDepositAlertDays')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="choInner.agreedDepositAlertDays"  lay-verify="required" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" value="$!{config.choInner.agreedDepositAlertDays}" >
                </div>
                <div class="layui-input-inline">#springMessage('config.nis.day')</div>
            </td>
        </tr>
        ##定期存款到期提醒天数
        <tr>
            <td class="textRight">#springMessage('config.choInner.regularAlertDays')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="choInner.regularAlertDays" lay-verify="required" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" value="$!{config.choInner.regularAlertDays}" >
                </div>
                <div class="layui-input-inline">#springMessage('config.nis.day')</div>
            </td>
        </tr>
        ##通知存款到期提醒天数
        #*<tr>
            <td class="textRight">#springMessage('config.choInner.noticeAlertDays')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="choInner.noticeAlertDays" lay-verify="required" autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" value="$!{config.choInner.noticeAlertDays}" >
                </div>
                <div class="layui-input-inline">#springMessage('config.nis.day')</div>
            </td>
        </tr>*#
        ##是否自动记账
##        <tr>
##            <td class="textRight">#springMessage('config.choInner.isAutoAccount')</td>
##            <td>
##                <div class="layui-input-inline">
##                    <input type="radio" name="choInner.isAutoAccount" value="1" #if($config.choInner.isAutoAccount == 1)checked#end title="#springMessage('config.choInner.yes')" lay-filter="isAutoAccount">
##                    <input type="radio" name="choInner.isAutoAccount" value="0" #if($config.choInner.isAutoAccount == 0)checked#end title="#springMessage('config.choInner.no')" lay-filter="isAutoAccount">
##                </div>
##            </td>
##        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form', 'jquery', 'moneyType'], function () {
        var form = bt.form(), $ = bt.jquery;
        var moneyType = bt.moneyType.init();
        //监听提交
        form.on('submit(configSubmit)', function (data) {
            $.post(basePath + "/sys/config/save", data.field, function (result) {
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, "JSON");
            return false;
        });
    });
</script>
</body>
</html>
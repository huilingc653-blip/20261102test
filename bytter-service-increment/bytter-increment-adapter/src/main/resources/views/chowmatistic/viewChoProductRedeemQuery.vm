<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input id="id" name="id" type="hidden" value="$!{choProductReqPage.id}">
    <input id="billNo" name="billNo" type="hidden" value="$!{choProductReqPage.billNo}">
    <input id="incomeClause" name="incomeClause" type="hidden" value="$!{choProductReqPage.incomeClause}">
    <input id="interestStartDate" name="interestStartDate" type="hidden" value="$!date.format('yyyy-MM-dd',$!{choProductReqPage.interestStartDate})">
    <input id="bankAcc" name="bankAcc" type="hidden" value="$!{choProductReqPage.bankAcc}">
    <input id="corpId" name="corpId" type="hidden" value="$!{choProductReqPage.corpId}">
        <!-- 赎回记录 -->
        #if($!{list})
        <div id="redeemMsg">
            <table id="appTable" class="layui-table layui-form" style="width:100%;">
                <thead>
                <tr>
                    <th>#springMessage("table.choProductRedeem.redeemDate")</th>
                    <th>#springMessage("table.choProductRedeem.redeemMoney")</th>
                    <th>#springMessage("table.choProductRedeem.incomeMoney")</th>
                    <th>#springMessage("table.choProductRedeem.incomeRate")</th>
                    <th>#springMessage("table.choProductReq.subFeeMoneyRedeem")</th>
                    <th>#springMessage("table.choProductRedeem.redeemChargeMoney")</th>
                    <th>#springMessage("table.choProductReq.chargeMoneyRedeem")</th>
                    <th>#springMessage("table.choProduct.rmk")</th>
                    <th>#springMessage("table.choProductReq.status")</th>
                </tr>
                </thead>
                #foreach($redeem in $list)
                    <tr>
                        <input id="redeemDetailId_$velocityCount" type="hidden" value="$!{redeem.id}">
                        <td class="textCenter" id="redeemDate_$velocityCount">$!date.format('yyyy-MM-dd',$!{redeem.redeemDate})</td>
                        <td class="textCenter" >$number.formatNumeric($!{redeem.redeemMoney})</td>
                        <input id="redeemMoney_$velocityCount" name="redeemMoney_$velocityCount" type="hidden" value="$!{redeem.redeemMoney}">
                        <td class="textCenter">$number.formatNumeric($!{redeem.incomeMoney})</td>
                        <td class="textCenter" id="incomeRate_$velocityCount">
                            #if($!{redeem.incomeRate})
                               $rateTag.show($!{redeem.incomeRate},6)</td>
                            #end
                        <td class="textCenter">
                            #if($!{redeem.subFeeMoney})
                                $number.formatNumeric($!{redeem.subFeeMoney})
                            #end
                        </td>
                        <td class="textCenter">
                            #if($!{redeem.redeemChargeMoney})
                                $number.formatNumeric($!{redeem.redeemChargeMoney})
                            #end
                        </td>
                        <td class="textCenter">
                            #if($!{redeem.chargeMoney})
                                $number.formatNumeric($!{redeem.chargeMoney})
                            #end
                        </td>
                        <td class="textCenter">
                            $!{redeem.rmk}
                        </td>
                        <td class="textCenter">$dictTag.get('choBankFinance.status',$!{redeem.status})</td>
                    </tr>
                #end
            </table>
        </div>
        #end
</form>
    #parse("views/common/footer.vm")
<script>
    var index;
    var moneyFun;
    bt.use(['form', 'layedit', 'moneyType','datatable','bisAccDtl','dateType'], function () {
        var $ = bt.jquery, form = bt.form();
        var moneyType = bt.moneyType.init();
        moneyFun = bt.moneyType.getFun();
        var bisAccDtl = bt.bisAccDtl.init();
        bt.bisAccDtlBeforeClick = function (data) {
            var id = layui.jquery(data).data("biz-name");
            index = id.substr(id.lastIndexOf("_") + 1);

            bisAccDtl.set({
                "bankAcc": $("#bankAcc").val(),
                "corpId": $("#corpId").val(),
                "redeemMoney": $("#redeemMoney_"+index).val(),
                "redeemDate": $("#redeemDate_"+index).text()
            });
            return true;
        }
    });

    //银行流水选择回调回调方法
    var callbackBisAccDtl = function (data) {
        var amt = 0;
        for(var i=0;i<data.length;i++){
            amt = amt + data[i].amt;
        }
        var incomeClause = $("#incomeClause").val();
        var interestStartDate = $("#interestStartDate").val();
        var redeemDate = $("#redeemDate_"+index).text();
        var redeemMoney = $("#redeemMoney_"+index).val();
        var incomeMoney = amt-redeemMoney;

        var dayLimit = getBetweenDay(interestStartDate,redeemDate,incomeClause);//赎回日期-起息日期
        var number = redeemMoney*dayLimit;
        var incomeRate = number === 0 ? 0 : incomeMoney/(number/incomeClause);

        var redeemDetailId = $("#redeemDetailId_"+index).val();

        $.post(basePath + "/chowmatistic/choproductredeem/updateRedeemDetail",
                {
                    redeemDetailId:redeemDetailId,
                    incomeMoney:incomeMoney,
                    incomeRate:incomeRate
                },
                function(result){
                    parent.layer.alert(result.msg, {icon: result.success?1:2});
                    if(bt.navtab) {
                        bt.navtab.refreshCurrent()
                    }
                },'JSON');
    };

    /**
     * 计算两个日期之间的间隔
     * @param startDate
     * @param endDate
     * @returns {number}
     */
    var getBetweenDay = function (startDate,endDate,incomeClause){
        if (null == startDate || null == endDate || '' == startDate || '' == endDate){
            return;
        }
        var date1 = bt.date.get(startDate);
        var date2 = bt.date.get(endDate);
        //判断收益条款，为0（30/360）时，需要对年对月对日取期限
        var btt;
        if(incomeClause == 0){
            var startDateDay = date1.getDate();
            var endDateDay = date2.getDate();
            var startDateMonth = date1.getMonth();
            var endDateMonth = date2.getMonth();
            var startDateYear = date1.getFullYear();
            var endDateYear = date2.getFullYear();
            //起息日的天数D1    到期日的天数D2     判断日期天数大小
            if(startDateDay <= endDateDay){
                //D1<=D2   N=360*(y2-y1)+30*(m2-m1)+(d2-d1)
                btt = 360*(endDateYear-startDateYear) + 30*(endDateMonth-startDateMonth) + (endDateDay-startDateDay);
            }else{
                //D1>D2
                //判断D2是不是当月的最后一天
                var maxDay = new Date(endDateYear, endDateMonth + 1, 0).getDate();
                if(endDateDay === maxDay){
                    //d2是m2最后一天时，N=360*(y2-y1)+30*(m2-m1)
                    btt = 360*(endDateYear-startDateYear) + 30*(endDateMonth-startDateMonth);
                }else{
                    //当月没有那个日期，特殊处理
                    var lastDay = new Date(startDateYear, endDateMonth, 0).getDate();
                    if(startDateDay>lastDay){
                        startDateDay = lastDay;
                    }
                    var newDate = new Date(endDateYear, endDateMonth-1, startDateDay);

                    btt = 360*(endDateYear-startDateYear) + 30*(endDateMonth-startDateMonth-1) +
                            bt.date.getBetweenDay(newDate,date2);
                }
            }
        }else{
            btt = (date2 - date1)/(1000*60*60*24);
        }
        return btt;
    }
</script>
</body>
</html>

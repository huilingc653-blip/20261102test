<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" >
    <table class="layui-table" >
        <input id="lastBuyMoney" name="lastBuyMoney" type="hidden" value="$!{lastChoProductNetVal.buyMoney}">
        <input id="lastDailyNetVal" name="lastDailyNetVal" type="hidden" value="$!{lastChoProductNetVal.dailyNetVal}">
        <input id="lastTenThousandIncome" name="lastTenThousandIncome" type="hidden" value="$!{lastChoProductNetVal.tenThousandIncome}">
        <input id="lastDayIncome" name="lastDayIncome" type="hidden" value="$!{lastChoProductNetVal.dayIncome}">
        <input id="lastActualIncome" name="lastActualIncome" type="hidden" value="$!{lastChoProductNetVal.actualIncome}">
        <input id="lastBal" name="lastBal" type="hidden" value="$!{lastChoProductNetVal.bal}">
        <input id="reqId" name="reqId" type="hidden" value="$!{lastChoProductNetVal.reqId}">
        <input id="isRedeem" name="isRedeem" type="hidden" value="$!{isRedeem}">
        <input id="redeemPortion" type="hidden" value="$!{redeemPortion}">
        <input id="buyDailyNetVal" type="hidden" value="$!{choProductReq.dailyNetVal}">
        <input id="id" name="id" type="hidden" value="$!{choProductNetVal.id}">
        <tbody>
        <tr>
            ##日期
            <td class="textRight" width="40%">#springMessage("table.fcAccuBalance.date")</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="netValDate" name="netValDate" data-name="netValDate" data-biz-name="netValDate"
                           class="layui-input bt-biz-dateType" data-type="date" value="$!{choProductNetVal.netValDate}" readonly >
                </div>
            </td>
        </tr>
        <tr>
            ##购买金额
            <td class="textRight">#springMessage("table.choProductReq.buyMoney")</td>
            <td>
                <input type="text" id="buyMoney" name="buyMoney" style="text-align:right" data-name="buyMoney" data-biz-name="buyMoney"
                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{choProductNetVal.buyMoney}" readonly >
            </td>
        </tr>
        <tr>
            ##购买份额
            <td class="textRight">#springMessage("table.choProductReq.buyPortion")</td>
            <td>
                <input type="text" id="buyPortion" name="buyPortion" style="text-align:right" data-name="buyPortion" data-biz-name="buyPortion" data-decimal="0"
                       autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{choProductNetVal.buyPortion}" readonly>
            </td>
        </tr>
        <tr>
            ##日净值
            <td class="textRight">#springMessage("table.choProductReq.netVal")</td>
            <td>
                <input type="text" data-name="dailyNetVal" data-biz-name="dailyNetVal" class="layui-input bt-biz-moneyType" data-decimal="2"
                       value="$!{choProductNetVal.dailyNetVal}"
                       placeholder="#springMessage("table.choProductReq.netVal")" lay-verify="required" data-callback="dailyNetValCallback">
            </td>
        </tr>
        <tr>
            ##每万份收益
            <td class="textRight">#springMessage("table.choProductReq.tenThousandIncome")</td>
            <td>
                <input type="text" id="tenThousandIncome" name="tenThousandIncome" style="text-align:right" lay-verify="required"
                       data-name="tenThousandIncome" data-biz-name="tenThousandIncome" data-decimal="2"
                       placeholder="#springMessage("table.choProductReq.tenThousandIncome")"
                       value="$!{choProductNetVal.tenThousandIncome}" data-minus="true"
                       autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="tenThousandIncomeCallback" >
            </td>
        </tr>
        <tr>
            ##当日收益
            <td class="textRight">#springMessage("table.choProductReq.dayIncome")</td>
            <td>
                <input type="text" id="dayIncome" name="dayIncome" style="text-align:right"
                       data-name="dayIncome" data-biz-name="dayIncome" readonly
                       value="$!{choProductNetVal.dayIncome}" data-minus="true"
                       autocomplete="off" class="layui-input bt-biz-moneyType" >
            </td>
        </tr>
        <tr>
            ## 实际收益
            <td class="textRight">#springMessage("table.choProductReq.actualIncome")</td>
            <td>
                <input type="text" id="actualIncome" name="actualIncome" style="text-align:right"
                       data-name="actualIncome" data-biz-name="actualIncome" readonly
                       value="$!{choProductNetVal.actualIncome}" data-minus="true"
                       autocomplete="off" class="layui-input bt-biz-moneyType" >
            </td>
        </tr>
        <tr>
            ## 余额
            <td class="textRight">#springMessage("table.fcPredrawDtlTemp.balance")</td>
            <td>
                <input type="text" id="bal" name="bal" style="text-align:right"
                       data-name="bal" data-biz-name="bal" readonly
                       value="$!{choProductNetVal.bal}"
                       autocomplete="off" class="layui-input bt-biz-moneyType" >
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choProductNetValDetail.update.js?_btv=${resourceVersion}"></script>
</html>
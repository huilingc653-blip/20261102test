<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位
            <td class="textRight">#springMessage('table.choBankFinance.corpId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="likes_corpId"
                         data-scope="all"
                         data-resource="cho:innerFinance:choInnerFinance:query"
                         data-callback="bt.corpCallback"></div>
                </div>
            </td>
            ##付款账号
            <td class="textRight">#springMessage('table.choBankFinance.payerAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_payerAcc" id="payerAcc" data-biz-name="payerAcc"
                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.choBankFinance.payerAcc')">
                </div>
            </td>
            ##币别
            <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name="eqs_curId" data-valueField="id" data-textField="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##业务类型
            <td class="textRight">#springMessage('table.choBankFinance.busType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select"
                     data-group="choInnerFinance.busType" data-name="eqi_busType"></div>
            </td>
            ##金额
            <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_payMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')" data-moneyendid="t2">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_payMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')" id="t2">
                </div>
            </td>
            ##交易日期
            <td class="textRight">#springMessage('table.btNetChalk.transTime')</td>
            <td>
                <input type="text" name="ged_tranDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_tranDate" >
                <span class="date-mid">~</span>
                <input type="text" name="led_tranDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_tranDate">
            </td>
        </tr>
        <tr>
            ##业务单号
            <td class="textRight">#springMessage('table.choBankFinance.billNo')</td>
            <td>
                <input type="text" name="likes_billNo"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.choBankFinance.billNo')">
            </td>
            ##用途
            <td class="textRight">#springMessage('table.choBankFinance.purpose')</td>
            <td>
                <input type="text" name="likes_purpose"
                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.choBankFinance.purpose')">
            </td>
            ##状态
            <td class="textRight">#springMessage('table.choBankFinance.status')</td>
            <td colspan="3">
                <div class="bt-biz-dict" data-type="select" data-group="choInnerFinance.status" data-name="eqi_status" data-filterData="-2"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.choBankFinance.billNo')</th>
        <th>#springMessage('table.choBankFinance.corpId')</th>
        <th>#springMessage('table.choBankFinance.busType')</th>
        <th>#springMessage('table.choBankFinance.curId')</th>
        <th>#springMessage('table.choBankFinance.payMoney')</th>
        <th>#springMessage('table.choBankFinance.payerAcc')</th>
        <th>#springMessage('table.choBankFinance.payerAccName')</th>
        <th>#springMessage('table.choBankFinance.payeeAcc')</th>
        <th>#springMessage('table.bisFinanceExc.payeeAccName')</th>
        <th>#springMessage('table.choBankFinance.dayLimit')</th>
        <th>#springMessage('table.btNetChalk.transTime')</th>
        <th>#springMessage('table.nisBillhead.purpose')</th>
        <th>#springMessage('table.choBankFinance.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choInnerFinance.query.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html>
<head>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <script>var basePath = "${basePath}"</script>
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="font-src *  data:">
    <meta name="viewport"
          content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0, user-scalable=no">
    <title>理财产品</title>
    <!-- 引入 FrozenUI -->
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css" media="all"/>
    <link rel="stylesheet" href="${basePath}/static/css/mobile/index.css" media="all"/>
    <style>
        html {
            font-size: 26.66667vw;
        }

        .cho-body {
            background-color: #F5F5F5;
        }

        .cho-border {
            border-top: 1px solid #EDEDED;
            padding: 0.1rem 0;
        }

        #tab {
            background: rgba(255, 255, 255, 1);
        }

        #tab .cho-panel-item {
            background-image: url("${basePath}/static/modules/images/reqbg2x.png");
            border-radius: 0.1rem;
            height: 1.22rem;
            margin: 0.14rem 0.2rem;
            padding: 0 0.26rem;
            margin-bottom: 0;
            background-repeat: no-repeat;
            background-size: contain;
        }

        #tab .cho-panel-item-title {
            font-size: 0.14rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(199, 162, 119, 1);
            padding-top: 0.17rem;
            padding-bottom: 0.04rem;
        }

        .cho-panel-item .cho-panel-item-money {
            font-size: 0.22rem;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(255, 255, 255, 1);
        }

        .cho-panel-item-bottom {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(167, 168, 225, 1);
            padding: 0.15rem;
            padding-left: 0;
            line-height: 0.16rem;
        }

        .cho-panel-item-bottom span {
            display: inline-block;
            height: 100%;
            font-size: 0.16rem;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(167, 168, 225, 1);
            line-height: 0.16rem;
        }

        .cho-content-item {
            background: rgba(255, 255, 255, 1);
            border-top: 1px solid #EDEDED;
        }

        .cho-content-item-title-left {
            display: inline-block;
            font-size: 0.14rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(51, 51, 51, 1);
            line-height: 0.20rem;
            padding: 0.14rem 0.26rem;
            padding-right: 0.10rem;
        }

        .cho-content-item-btn-left {
            display: inline-block;
            background: rgba(229, 230, 255, 1);
            border-radius: 2px;
            height: 0.20rem;
            padding: 0.03rem 0.05rem;
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(27, 29, 117, 1);
            line-height: 0.20rem;
            margin-left: 0.18rem;
            padding-bottom: 0;
        }

        .cho-content-item-money-left {
            font-size: 0.24rem;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(228, 70, 29, 1);
            line-height: 0.28rem;
            padding: 0.09rem 0.24rem;
        }

        .cho-content-item-font-left {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(153, 153, 153, 1);
            line-height: 0.18rem;
            padding: 0.06rem 0.24rem;
        }

        .cho-content-item-money-right {
            font-size: 0.18rem;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(51, 51, 51, 1);
            line-height: 0.47rem;
            padding-bottom: 0;
        }

        .cho-content-item-font-right {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(153, 153, 153, 1);
            padding: 0.06rem 0.06rem;
            line-height: 0.18rem;
        }

        .cho-content-item-acc-right span {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.17rem;
            padding: 0.10rem 1rem;
            padding-right: 0rem;
        }

        #tab1 {
            margin-top: 0.04rem;
        }

        .cho-tab-title {
            height: 0.44rem;
            background-color: #fff;
            padding-left: 0.15rem;
        }

        .cho-tab-title span {
            display: inline-block;
            height: 0.24rem;
            border-radius: 0.12rem;
            margin: 0.06rem;
            margin-top: 0.1rem;
            color: #333;
            padding: 0 0.1rem;
            font-size: 0.14rem;
            font-family: PingFangSC-Regular, PingFang SC;
            margin-left: 0;
            line-height: 0.25rem;
        }

        .cho-tab-title span:nth-child(3) {
            margin-right: 0;
        }

        .cho-tab-title .active {
            background-color: #1B1D75;
            color: #fff !important;
        }

        .cho-date-item-bottom {
            height: 0.6rem;
            padding-top: 0.06rem;
            padding-bottom: 0.08rem;
            padding: 0 0.12rem;
        }

        .cho-date-item-bottom > div > div {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.22rem;
            height: 0.22rem;
        }

        /* 弹框选择 */
        .bt-select-popup {
            position: relative;
            margin-right: 6px;
        }

        .ui-actionsheet {
            display: none
        }

        .ui-actionsheet .show {
            display: block;
        }

        .ui-actionsheet.show .ui-actionsheet-cnt {
            transition: none;
        }

        .ui-actionsheet .ui-actionsheet-cnt {
            transition: none;
        }

        .bt-select-popup input {
            border: none;
            width: 0.58rem;
            height: 0.32rem;
            background-color: #F5F5F5;
            border-radius: 0.16rem;
            padding: 0 0.15rem;
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 600;
            color: rgba(102, 102, 102, 1);
        }

        .bt-select-popup.active input {
            color: #2988FF;
            background-color: #E9F1FF;
        }

        .bt-select-popup.active:after {
            color: #2988FF;
        }

        .bt-select-popup:after {
            position: absolute;
            top: 49%;
            right: 0.15rem;
            margin-top: -4px;
            width: 0;
            height: 0;
            border-top: 6px solid;
            border-right: 5px solid transparent;
            border-left: 5px solid transparent;
            color: #a6a6a6;
            content: "";
            pointer-events: none;
        }

        .ui-btn-wrap {
            font-size: 14px;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 500;
            color: rgba(51, 51, 51, 1);
            margin-left: 0;
            padding-top: 0.15rem;
        }

        .ui-btn-corp {
            background-color: #F5F5F5;
            border-radius: 0.16rem;
            padding: 0 0.15rem;
            margin-right: 0.08rem;
        }

        .btn-corp {
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 600;
            color: rgba(102, 102, 102, 1);
            padding-top: 0.06rem;
        }

        .bt-date-btn input {
            border: none;
            width: 0.58rem;
            height: 0.32rem;
            background-color: #F5F5F5;
            border-radius: 0.16rem;
            padding: 0 0.15rem;
            width: 0.36rem;
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 600;
            color: rgba(102, 102, 102, 1);
            padding-right: 0.04rem;
        }

        .popup-block * {
            font-size: 0.14rem;
        }

        .bt-card {
            background-color: #fff;
        }

        .bt-card .active {
            color: #2988FF;
            font-weight: 700;
        }

        .bt-card-header {
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 700;
            color: rgba(51, 51, 51, 1);
            line-height: 0.35rem;
            height: 0.35rem;
            padding-left: 0.1rem;
            text-align: left;
        }

        .bt-card-body {
            padding-bottom: 0.15rem;
        }

        .bt-card-item {
            height: 0.34rem;
            background: rgba(240, 240, 240, 1);
            border-radius: 0.18rem;
            line-height: 0.34rem;
            text-align: center;
            margin: 0.05rem 0.1rem 0.05rem 0;
            font-size: 0.14rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
        }

        .bt-card-body .ui-col:nth-last-child(1) .bt-card-item {
            margin-right: 0;
        }

        .ui-sp-btn {
            background: #f3f3f3;
            border-radius: 0.16rem;
            width: 1.11rem;
            height: 0.3rem;
            line-height: 0.3rem;
        }

        .ui-sp-btn > input {
            font-size: 0.12rem;
            font-family: 苹方-简 常规体;
            font-weight: 400;
            color: #333333;
            width: 1.11rem;
        }

        .ui-form-item input {
            padding-left: 0.16rem;
        }

    </style>

</head>
<body>
<section class="cho-body ui-container">
    <section id="tab">
        <div class="cho-panel-item" id="cho-panel-info">
            <div>
                <div class="cho-panel-item-title">持仓总额（元）</div>
                <div class="cho-panel-item-money"><span id="bt1"></span></div>
                <div class="cho-panel-item-bottom">
                    参考收益总额（元）
                    <span id="bt2"></span>
                </div>
            </div>
        </div>


        <div>
            <div class="ui-btn-wrap">
                ##单位
                <div class="ui-btn-corp">
                    <button class="btn-corp" onclick="openCorpSelectionPage()">单位(<span id="cs">0</span>)</button>
                </div>
                ##状态
                <div class="bt-select-popup" style="margin: 0px 0.5rem">
                    <input type="text" id="btn1" readonly="readonly" placeholder="状态" value="状态"
                           style="width: 0.4rem">
                </div>
                ##更多
                <div class="bt-select-popup">
                    <input type="text" id="btn2" readonly="readonly" placeholder="更多" value="更多"
                           style="width: 0.4rem;">
                </div>
                ##状态控制
                <div class="popup-block">
                    <div class="ui-actionsheet" id="actionsheet1" style="height:calc(100% - 1.85rem);top:1.85rem;"
                         data-link="btn1">
                        <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 1.85rem;">
                            <section class="bt-popup-container">
                                <div class="bt-card" id="isExpireCard">
                                    <div class="bt-card-header">
                                        状态
                                        <input type="hidden" id="isExpireStr" name="isExpireStr" value="">
                                    </div>
                                    <div class="bt-card-body">
                                        <div class="ui-row-flex ui-whitespace">
                                            <div class="ui-col ui-col">
                                                <div class="bt-card-item" data-value="0">全部</div>
                                            </div>
                                            <div class="ui-col ui-col">
                                                <div class="bt-card-item" data-value="1">已到期</div>
                                            </div>
                                            <div class="ui-col ui-col">
                                                <div class="bt-card-item" data-value="2">未到期</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>
                            <div class="bt-popup-bottom">
                                <button type="button" id="clearValue1" class="bt-popup-reset resetBtn">重置</button>
                                <button type="button" id="submitValue1" class="bt-popup-submit submitBtn">确定</button>
                            </div>
                        </div>
                    </div>
                </div>
                ##币别控制
                <div class="popup-block">
                    <div class="ui-actionsheet" id="actionsheet2"
                         style="height:calc(100% - 1.85rem);top:1.85rem;" data-link="btn2">
                    <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 1.85rem;">
                    <section class="bt-popup-container">
                    <div class="bt-card" id="currency">
                        <div class="bt-card-header">
                            币别选择
                            <input type="hidden" id="curId" name="currency" value="">
                        </div>
                        ##vcount 下标   velocityCount length
                    <div class="bt-card-body">
                        #foreach($cur in $curList)
                            #set($vcount = $velocityCount - 1)
                            #if($!{vcount}%3 == 0)
                            <div class="ui-row-flex ui-whitespace">
                            #end
                            <div class="ui-col ui-col">
                                <div class="bt-card-item"
                                     data-value="$!{cur.id}">$!{cur.curName}</div>
                            </div>
                            #if($!{foreach.last})
                                #if($velocityCount % 3 == 1)
                                    <div class="ui-col ui-col"></div>
                                    <div class="ui-col ui-col"></div>
                                </div>
                                #elseif($velocityCount % 3 == 2)
                                    <div class="ui-col ui-col"></div>
                                </div>
                                #else
                                </div>
                                #end
                            #else
                                #if($velocityCount % 3 == 0)
                                </div>
                                #end
                            #end
                        #end
                    </div>
                    <div class="bt-card" id="calEndDateCard">
                        <div class="bt-card-header">
                            截止日期
                        </div>
                        <div class="ui-form-item" style="height: 0.36rem; margin-top: 0.15rem;">
                            <div class="ui-sp-btn">
                                <input type="text" class="caldate" id="calEndDate" readonly="readonly"
                                       value="" placeholder="截止日期"/>
                            </div>
                        </div>
                    </div>
    </section>
    <div class="bt-popup-bottom">
        <button type="button" id="clearValue2" class="bt-popup-reset resetBtn">重置</button>
        <button type="button" id="submitValue2" class="bt-popup-submit submitBtn">确定</button>
    </div>
    </div>
    </div>
    </div>
    </div>
    </div>
</section>
<div class="cho-tab-title">
    <input type="hidden" id="signVal" name="signVal" value="">
    <span id="deal1" class="deal active" data-value="1">1个月内</span>
    <span id="deal2" class="deal" data-value="2">3个月内</span>
    <span id="deal3" class="deal" data-value="3">6个月内</span>
    <span id="deal4" class="deal" data-value="4">6个月以上</span>
</div>
<section id="tab1" style="height: calc(100vh - 2.5rem); overflow-y: auto;">
</section>
</section>

<!-- 注意：如果你直接复制所有代码到本地，上述js路径需要改成你本地的 -->
<script src="${basePath}/static/mobile/plugins/zepto/zepto.min.js"></script>
<script src="${basePath}/static/plugins/f2/f2.min.js"></script>
<script src="${basePath}/static/js/mobile/date.js"></script>
<script src="${basePath}/static/js/mobile/money.js"></script>
<script src="${basePath}/static/mobile/js/popup.js?_btv=${resourceVersion}" id="tableJS"></script>
<script src="${basePath}/static/mobile/js/webViewScriptBridage.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/plugins/web-view/webView.js?_btv=${resourceVersion}"></script>
<script>
    var seachType = ''

    // 用于记录页面的查询参数
    const searchParams = {
        corpIds: [],
        corpNames: [],
        calEndDateStr: null,
        curId: null,
        status: null,
        corpId: null,
        sign: null
    };
    window.getFinancialList = (data)=>{
        console.log('333理财')
        window.postData(data)
    }
    window.getCallback = (data)=>{
        console.log('333搜索')

        seachType = 'seach'
        searchActionCallback(JSON.parse(data))
    }
    /**
     * 搜索回调方法
     * @param data
     */
    window.searchActionCallback = function (data) {
        console.log("datadata"+data)
        // 根据data参数，查询数据
        if (data.corpNames && data.corpNames.length > 0) {
            // let msg = "选择的成员单位名称：" + JSON.stringify(data.corpNames);
            // msg = msg + ", 成员单位ID：" + JSON.stringify(data.corpIds)
            searchParams.corpNames = data.corpNames;
        }
        //单位回调
        if (data.corpIds) {
            $("#cs").html(data.corpIds.length);
            searchParams.corpId = data.corpIds;
            setTimeout(function () {
               var data = BTAppBridge.post("/chowmatistic/choproductreqquery/getReqMoblieList", searchParams, 'postData');
               uni.postMessage({
                   data:data
               })
            }, 100);
            searchParams.corpIds = data.corpIds;
        }
        //日期回调
        if (data.singleDatePickData) {
            var dateObj = data.singleDatePickData;
            $("#calEndDate").val(dateObj);
        }
        seachType = ''

    }

    function openCorpSelectionPage() {
        setTimeout(function () {
            var data = BTAppBridge.openCorpSelectionPage && BTAppBridge.openCorpSelectionPage('searchActionCallback',{
                resource:"cho:productReq:choProductReq:dtl:query"
            });
            uni.postMessage({
                data:data
            })
        }, 100);

    }

    //截止日期弹窗
    function singleDatePicker() {
        // format：选中日期返回的数据格式。
        // callback：选择日期后回调方法。
        var data = BTAppBridge.singleDatePicker && BTAppBridge.singleDatePicker({
            format: 'YYYY-MM-DD',
            callback: 'searchActionCallback',
        });
        uni.postMessage({
            data: data
        });
    }


    (function (doc, win) {

        //初始化数据
        submiteData(true);

        function addSheet($this, id) {
            if ( $this.parent().hasClass('active')) {
                hideSheet($this);
                return
            }
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
                $this.parent().addClass('active');
            $(id).addClass('show');
        }

        //弹框选择
        function hideSheet($this) {
            $('.ui-actionsheet').removeClass('show');
                $this.parent().removeClass('active');
        }

        //状态控制
        $("#btn1").click(function () {
            addSheet($(this), '#actionsheet1')
        });
        //币别控制
        $("#btn2").click(function () {
            addSheet($(this), '#actionsheet2')
        });

        var ACTIVE = 'active';

        function initCard(id, value, clickCallback, isNotInit) {
            if (!id) {
                return
            }
            var $card =$(id);
            var hiddenInput = $card.find('.bt-card-header input');
            var items = $card.find('.bt-card-item');
            items.removeClass(ACTIVE);
            hiddenInput.val('');
            //设置选中值
            if (value) {
                for (var i = 0; i < items.length; i++) {
                    if (value === $(items[i]).data('value')) {
                        $(items[i]).addClass(ACTIVE);
                        hiddenInput.val(value);
                        break
                    }
                }
            }
            if (isNotInit) {
                return;
            }

            $(id).on('click', '.bt-card-item', function () {
                var value = '';
                if ($(this).hasClass(ACTIVE)) { //如果当前被选中时，点击会取消选中
                    $(this).removeClass(ACTIVE);
                } else {
                        $card.find('.bt-card-item').removeClass(ACTIVE);
                    $(this).addClass(ACTIVE);
                    value = $(this).data('value');
                }
                hiddenInput.val(value);
                if (clickCallback) {
                    clickCallback(value);
                }
            })
        }

        //初始化
        initCard('#currency', '');
        initCard('#isExpireCard', '');

        //点击确定
        $('.submitBtn').on('click', function () {
            var btn = $(this).parents('.ui-actionsheet').removeClass('show')
                    .data('link');
            $('#' + btn).removeClass('active');
            $('.bt-select-popup').removeClass('active');
            //确认提交
            submiteData(false);
        })

        //点击重置
        $('#clearValue1').on('click', function () {
            initCard('#isExpireCard', '', '', true);
        })
        $('#clearValue2').on('click', function () {
            initCard('#currency', '', '', true);

            $("#calEndDate").val("");
            searchParams.calEndDateStr = null;
        })

        postData = function (result) {
            setDataHead(result);
            setDataDiv(result);
        }

        //拼装数据列表
        function setDataHead(data) {
            $("#bt1").html(bt.money.format(data.buyTotal));
            $("#bt2").html(bt.money.format(data.referIncomeTotal));
        }

        //拼装数据列表
        function setDataDiv(result) {
            var showHtml = '';
            var data = result.dataList;
            for (var i = 0; i < data.length; i++) {
                showHtml += '<div class="cho-content-item">';
                showHtml += '<ul class="ui-row" onclick="view(\'' + data[i].id + '\')">';
                showHtml += '<li class="ui-col ui-col-100">';
                showHtml += '<div class="cho-content-item-title-left">' + data[i].productName;
                showHtml += '<span class="cho-content-item-btn-left">' + data[i].productType + '</span></div></li>';
                showHtml += '<li class="ui-col ui-col-50">';
                showHtml += '<div><div class="cho-content-item-money-left">';
                showHtml += bt.money.format(data[i].referIncomeMoney);
                showHtml += '</div>';
                showHtml += '<div class="cho-content-item-font-left">参考收益（元）</div></div></li>';
                showHtml += '<li class="ui-col ui-col-50">';
                showHtml += '<div><div class="cho-content-item-money-right">';
                showHtml += bt.money.format(data[i].buyMoney);
                showHtml += '</div><div class="cho-content-item-font-right">赎买金额（元）</div></div></li>';
                showHtml += '<li class="ui-col ui-col-100 cho-date-item-bottom">';
                showHtml += '<div class="cho-border">';
                showHtml += '<div class="ui-col ui-col-50">账号：' + data[i].bankAcc + '</div>';
                var dealDateTemp = "";
                if (!isEmpty(data[i].deadlineDate)) {
                    dealDateTemp = bt.date.format(data[i].deadlineDate)
                }
                showHtml += '<div class="ui-col ui-col-50">到期日：' + dealDateTemp + '</div>';
                showHtml += '<div>' + data[i].corpName + '</div></div></li>';
                showHtml += '</ul></div>'
            }
            var dataDiv = document.getElementById("tab1");
            dataDiv.innerHTML = showHtml;
        }

        //数据提交
        function submiteData(isInit) {
            console.log('初始化'+isInit)
            console.log(seachType)
            if(seachType){
                return
            }
            if (isInit) {
                searchParams.sign = "1";
            } else {
                searchParams.sign = $("#signVal").val();
            }
            searchParams.curId = $("#curId").val();
            searchParams.isExpireStr = $("#isExpireStr").val();
            searchParams.calEndDateStr = $("#calEndDate").val();

            setTimeout(function () {
                var data = BTAppBridge.post("/chowmatistic/choproductreqquery/getReqMoblieList", searchParams, 'postData');
                console.log(data+"data5")
                uni.postMessage({
                    data: data
                });
            }, 500);
        }

        //时间选择
        $('.caldate').on('click', function () {
            singleDatePicker();
        });

        $('.cho-tab-title > span').on('click', function () {
            $(".deal").removeClass('active');
            $(this).addClass('active');
            var signTemp = $(this).data('value');
            $("#signVal").val(signTemp);
            submiteData(false);
        })

    })(document, window);

    function view(id) {
        var calTemp = $("#calEndDate").val();
        setTimeout(function () {
           var data = BTAppBridge.jump({url: "/chowmatistic/choproductreqquery/mobileViewReq", id: id, calEndDateStr: calTemp});
           uni.postMessage({
               data:data
           })
        }, 100);
    }

    /**判断字符串是否为空*/
    function isEmpty(ms) {
        if (typeof (ms) == "undefined" || ms == null || ms == "" || ms == " ") {
            return true;
        }
        return false;
    }

</script>


#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<!-- 系统参数 -->
<input id="id" name="id" type="hidden" value="$!{choProductRedeemPage.id}">
<input id="busType" name="busType" type="hidden" value="$!{busType}">

<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell">
        #springMessage("table.choBankFinance.corpId")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductRedeemPage.corpName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProduct.productCode")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductRedeemPage.productCode}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProduct.productType")
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("cho.productType",$!{choProductRedeemPage.productType})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProduct.bankTypeId")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductRedeemPage.bankTypeName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProduct.productName")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductRedeemPage.productName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProduct.curId")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductRedeemPage.curName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.bankName")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductRedeemPage.bankName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.bankAcc")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductRedeemPage.bankAcc}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.buyMoneyLow")
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{choProductRedeemPage.buyMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.incomeClause")
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("choProduct.incomeClause",$!{choProductRedeemPage.incomeClause})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.buyDate")
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{choProductRedeemPage.buyDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.dayLimit")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductRedeemPage.dayLimit}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.interestStartDate")
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{choProductRedeemPage.interestStartDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.deadlineDate")
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{choProductRedeemPage.deadlineDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.cashDate")
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{choProductRedeemPage.cashDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.referIncomeRate")
        <span class="mui-badge mui-badge-inverted">
            $rateTag.show($!{choProductRedeemPage.referIncomeRate},6)
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.referIncomeMoney")
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{choProductRedeemPage.referIncomeMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductRedeem.redeemMoneyLow")
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{choProductRedeemPage.redeemMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductRedeem.redeemDate")
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{choProductRedeemPage.redeemDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductRedeem.incomeMoney")
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{choProductRedeemPage.incomeMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductRedeem.transferDate")
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{choProductRedeemPage.transferDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductRedeem.incomeRate")
        <span class="mui-badge mui-badge-inverted">
            $rateTag.show($!{choProductRedeemPage.incomeRate},6)
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProduct.rmk")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductRedeemPage.rmk}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.subFeeMoney")
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{choProductRedeemPage.subFeeMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductRedeem.redeemChargeMoney")
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{choProductRedeemPage.redeemChargeMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.chargeMoney")
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{choProductRedeemPage.chargeMoney})
        </span>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

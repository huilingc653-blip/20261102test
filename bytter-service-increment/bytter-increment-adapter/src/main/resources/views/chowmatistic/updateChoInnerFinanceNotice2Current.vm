<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{choInnerFinancePage.id}">
		<input id="billNo" name="billNo" type="hidden" value="$!{choInnerFinancePage.billNo}">
        <input id="createBy" name="createBy" type="hidden" value="$!{choInnerFinancePage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{choInnerFinancePage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{choInnerFinancePage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{choInnerFinancePage.updateDate}">
		<input id="busType" name="busType" type="hidden" value="$!{choInnerFinancePage.busType}">
		<input id="status" name="status" type="hidden" value="$!{choInnerFinancePage.id}">
		<input id="payerAccId" name="payerAccId" type="hidden" value="$!{choInnerFinancePage.payerAccId}">
        <input id="payeeAccId" name="payeeAccId" type="hidden" value="$!{choInnerFinancePage.payeeAccId}">
        <input id="capitalAccId" name="capitalAccId" type="hidden" value="$!{choInnerFinancePage.capitalAccId}">
        <input id="interestAccId" name="interestAccId" type="hidden" value="$!{choInnerFinancePage.interestAccId}">
		<input id="curId" name="curId" type="hidden" value="$!{choInnerFinancePage.curId}">
        <input id="relatedBillId" name="relatedBillId" type="hidden" value="$!{choInnerFinancePage.relatedBillId}">
        <input id="dayLimit" name="dayLimit" type="hidden" value="$!{choInnerFinancePage.dayLimit}">
        <input id="dateUnit" name="dateUnit" type="hidden" value="$!{choInnerFinancePage.dateUnit}">
        <input id="depositRateType" name="depositRateType" type="hidden" value="$!{choInnerFinancePage.depositRateType}">

        <div class="layui-collapse" lay-filter="collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.choInnerFinance.noticeInfo')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table">
                        <tbody>
                        <tr>
                            ##单位ID
                            <td class="textRight">#springMessage('table.choBankFinance.corpId')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="hidden" id="corpIdDef" value="$!{choInnerFinancePage.corpId}">
                                    <div class="bt-biz-corp"
                                         data-biz-type="corp"
                                         data-type="selectTree"
                                         data-name="corpId"
                                         data-scope="all"
                                         data-required="true"
                                         data-defaultvalue="$!{choInnerFinancePage.corpId}"
                                         data-resource="cho:innerFinanceT2C:choInnerFinance:apply"
                                         data-callback="bt.corpCallback"></div>
                                </div>
                            </td>
                            ##支取日期
                            <td class="textRight">#springMessage('table.choInnerFinance.drawDate')</td>
                            <td >
                                <div class="layui-input-inline">
                                    <input type="text" id="payDate" name="payDate" data-name="payDate" data-biz-name="payDate" lay-verify="required" class="layui-input bt-biz-dateType"
                                           data-today="true" data-type="date" value="$!{choInnerFinancePage.payDate}" data-min="$!{sysDate}">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##通知存款编号
                            <td class="textRight">#springMessage('table.choInnerFinance.noticeBillNo')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="hidden" id="payerAcc" name="payerAcc" readonly="readonly" value="$!{choInnerFinancePage.payerAcc}"
                                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.choBankFinance.noticeAcc')">
                                    <input type="text" id="relatedBillNo" name="relatedBillNo" lay-verify="required" readonly="readonly" value="$!{choInnerFinancePage.relatedBillNo}"
                                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.choInnerFinance.noticeBillNo')">
                                </div>
                                <div class="layui-input-inline">
                                    <button class="layui-btn bt-biz-choInnerFinance" id="selDepositBut" type="button" data-callback="bt.depositCallback">#springMessage('common.button.select')</button>
                                </div>
                            </td>
                            ##收款账号
                            <td class="textRight">#springMessage('table.choBankFinance.currentAcc')</td>
                            <td >
                                <input type="text" id="payeeAcc" name="payeeAcc" lay-verify="required" readonly="readonly" value="$!{choInnerFinancePage.payeeAcc}"
                                       autocomplete="off" class="layui-input text" placeholder="#springMessage('table.choBankFinance.currentAcc')">
                            </td>
                        </tr>
                        <tr>
                            ##通知类型
                            <td class="textRight">#springMessage('table.choBankFinance.noticeDayLimit')</td>
                            <td >
                                <input type="hidden" id="noticeType" name="noticeType" readonly="readonly" autocomplete="off" class="layui-input text"value="$!{choInnerFinancePage.noticeType}">
                                <div class="bt-biz-dict" data-type="select" data-group="pricing.noticeType" data-disabled="true" data-defaultvalue="1" data-name="noticeTypeShow" data-biz-name="noticeTypeShow" data-value="$!{choInnerFinancePage.noticeType}"></div>
                            </td>
                            ##到期处理方式 0-不处理 1-本金续存 2-本息续存
                            #*<td class="textRight">#springMessage('table.choBankFinance.certificateWay')</td>
                            <td >
                                <input type="hidden" id="certificateWay" name="certificateWay" readonly="readonly" autocomplete="off" class="layui-input text" value="$!{choInnerFinancePage.certificateWay}">
                                <div class="bt-biz-dict" data-type="select" data-value="0" data-value="$!{choInnerFinancePage.certificateWay}" data-disabled="true"
                                     data-group="choInnerFinance.certificateWay" data-name="certificateWayShow" data-biz-name="certificateWayShow"></div>
                            </td>*#
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            ##存款金额
                            <td class="textRight">#springMessage('table.choInnerFinance.depositMoney')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="text" id="depositMoney" name="depositMoney" style="text-align:right" data-name="depositMoney" data-biz-name="depositMoney" value="$!{choInnerFinanceRelatedPage.payMoney}"
                                           autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.choInnerFinance.depositMoney')" readonly="readonly">
                                </div>
                            </td>
                            ##存款利率
                            <td class="textRight">#springMessage('table.eTransBill.depositRate')</td>
                            <td >
                                ##存款利率(通知利率)
                                <input type="text" id="interestRate" name="interestRate" style="text-align:right" data-name="interestRate" data-biz-name="interestRate" value="$!{choInnerFinancePage.interestRate}"
                                       autocomplete="off" class="layui-input bt-biz-rateType" placeholder="#springMessage('table.eTransBill.depositRate')" readonly="readonly">
                                <div style="display: none;">
                                ##活期账号利率
                                <input type="text" id="accInterestRate" name="accInterestRate" style="text-align:right" data-name="accInterestRate" data-biz-name="accInterestRate" value="$!{choInnerFinancePage.accInterestRate}"
                                       autocomplete="off" class="layui-input bt-biz-rateType" placeholder="#springMessage('table.eTransBill.depositRate')" readonly="readonly">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##已支取金额
                            <td class="textRight">#springMessage('table.choBankFinance.drawMoney')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="text" id="drawMoney" name="drawMoney" style="text-align:right" data-name="drawMoney" data-biz-name="drawMoney" value="$!{choInnerFinanceRelatedPage.drawMoney}"
                                           autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.choBankFinance.drawMoney')" readonly="readonly">
                                </div>
                            </td>
                            ##剩余存款金额
                            <td class="textRight">#springMessage('table.choBankFinance.drawBal')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="text" id="drawBal" name="drawBal" style="text-align:right" data-name="drawBal" data-biz-name="drawBal" value="$!{choInnerFinanceRelatedPage.timeBalance}"
                                           autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.choBankFinance.drawBal')" readonly="readonly">
                                </div>
                            </td>
                        </tr>
                        <tr>
                            ##起息日期
                            <td class="textRight">#springMessage('table.choBankFinance.interestStartDate')</td>
                            <td >
                                <div class="layui-input-inline">
                                    <input type="text" id="interestStartDate" name="interestStartDate" data-name="interestStartDate" data-biz-name="interestStartDate" readonly="readonly"
                                           class="layui-input bt-biz-dateType" data-type="date" value="$!{choInnerFinancePage.interestStartDate}">
                                </div>
                                <div class="layui-input-inline">
                                    <input type="hidden" id="deadlineDate" name="deadlineDate" data-name="deadlineDate" data-biz-name="deadlineDate" readonly="readonly"
                                           class="layui-input bt-biz-dateType" data-type="date" value="$!{choInnerFinancePage.deadlineDate}">
                                </div>
                            </td>
                            ##到期日期
                            #*<td class="textRight">#springMessage('table.choBankFinance.deadlineDate')</td>
                            <td >
                                <div class="layui-input-inline">
                                    <input type="text" id="deadlineDate" name="deadlineDate" data-name="deadlineDate" data-biz-name="deadlineDate" readonly="readonly"
                                           class="layui-input bt-biz-dateType" data-type="date" value="$!{choInnerFinancePage.deadlineDate}">
                                </div>
                            </td>
                        </tr>
                        <tr>*#
                            ##用途
                            <td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="depositPurpose" name="depositPurpose" data-name="depositPurpose" data-biz-name="depositPurpose"
                                           class="layui-input" readonly="readonly" value="$!{choInnerFinanceRelatedPage.purpose}">
                                </div>
                            </td>
                        </tr>
                        </tbody>
                    </table>
				</div>
			</div>
		</div>
        <div class="layui-collapse" lay-filter="collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.choInnerFinance.drawInfo')</h2>
                <div class="layui-colla-content layui-show">
					<table class="layui-table">
						<tbody>
                        <tr>
							##支取金额（小写）
                            <td class="textRight">#springMessage('table.common.drawMoney.lower')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="text" id="payMoney" name="payMoney" style="text-align:right" lay-verify="required" data-name="payMoney" data-biz-name="payMoney" data-toUp="payMoneyUp" data-moneyendid="drawBal"
                                           autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.common.drawMoney.lower')" data-callback="bt.payMoneyCallback" value="$!{choInnerFinancePage.payMoney}">
                                </div>
                            </td>
							##支取金额（大写）
                            <td class="textRight">#springMessage('table.common.drawMoney.upper')</td>
                            <td width="40%" style="padding-left:0px">
                                <div id="payMoneyUp"></div>
                            </td>
                        </tr>
						<tr>
							##本金转入账号
                            <td class="textRight">#springMessage('table.choInnerFinance.capitalAcc')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="text" id="capitalAcc" name="capitalAcc" data-biz-name="capitalAcc" lay-verify="required|tableData" value="$!{choInnerFinancePage.capitalAcc}"
                                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.choInnerFinance.capitalAcc')">
                                    <table id="capitalAccTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.choBankFinance.acc')</th>
                                            <th>#springMessage('table.choBankFinance.accName')</th>
                                            <th>#springMessage('table.choBankFinance.curId')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </div>
                            </td>
							##本金转入账户名称
							<td class="textRight">#springMessage('table.choInnerFinance.capitalAccName')</td>
							<td >
                                <div class="layui-input-inline">
                                    <input type="text" id="capitalAccName" name="capitalAccName" lay-verify="required" readonly="readonly" style="width:300px;" value="$!{choInnerFinancePage.capitalAccName}"
                                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.choInnerFinance.capitalAccName')">
                                </div>
							</td>
						</tr>
                        <tr>
							##利息转入账号
                            <td class="textRight">#springMessage('table.choInnerFinance.interestAcc')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="text" id="interestAcc" name="interestAcc" data-biz-name="interestAcc" lay-verify="required|tableData" value="$!{choInnerFinancePage.interestAcc}"
                                           autocomplete="off" class="layui-input text" placeholder="#springMessage('table.choInnerFinance.interestAcc')">
                                    <table id="interestAccTable" class="hide">
                                        <thead>
                                        <tr>
                                            <th>#springMessage('table.choBankFinance.acc')</th>
                                            <th>#springMessage('table.choBankFinance.accName')</th>
                                            <th>#springMessage('table.choBankFinance.curId')</th>
                                        </tr>
                                        </thead>
                                    </table>
                                </div>
                            </td>
							##利息转入账户名称
                            <td class="textRight">#springMessage('table.choInnerFinance.interestAccName')</td>
                            <td>
                                <div class="layui-input-inline">
                                    <input type="text" id="interestAccName" name="interestAccName" lay-verify="required" readonly="readonly" style="width:300px;" value="$!{choInnerFinancePage.interestAccName}"
                                           autocomplete="off" class="layui-input" placeholder="#springMessage('table.choInnerFinance.interestAccName')">
                                </div>
                            </td>
                        </tr>
						<tr>
							##预计利息
                            <td class="textRight">#springMessage('table.cmsProvideLoanInfo.anticInterest')</td>
                            <td width="40%">
                                <div class="layui-input-inline">
                                    <input type="text" id="expectInterest" name="expectInterest" style="text-align:right" lay-verify="required" data-name="expectInterest" data-biz-name="expectInterest" value="$!{choInnerFinancePage.expectInterest}"
                                           autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.cmsProvideLoanInfo.anticInterest')" readonly="readonly">
                                </div>
                            </td>
							##用途
							<td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
							<td>
								<div class="layui-input-inline">
                                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btpurpose?getByList&sysBusType=4&corpId=${choInnerFinancePage.corpId}"
                                         data-name="purpose" data-biz-name="purpose" data-defaultvalue="$!{choInnerFinancePage.purpose}" data-required="true"
                                         data-valuefield="purpose" data-textfield="purpose" data-inputvalue="inputvalue" data-search="true" data-extraData="true"></div>
								</div>
							</td>
						</tr>
						<tr>
							<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
							<td colspan="3">
								<textarea placeholder="#springMessage('fcVoucherType.rmk')" lay-verify="strlength" data-maxlength="100" class="layui-textarea" id="addWord" name="addWord" >$!{choInnerFinancePage.addWord}</textarea>
							</td>
						</tr>
						<tr>
							<td colspan="4" style="text-align: center;">
								<button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
								<button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
								<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
							</td>
						</tr>
						</tbody>
					</table>
			</div>
		</div>
	</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choInnerFinanceNotice2Current.edit.js?_btv=${resourceVersion}"></script>
</html>
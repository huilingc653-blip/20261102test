<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{choBankFinancePage.id}">
    <input id="billNo" name="billNo" type="hidden" value="$!{choBankFinancePage.billNo}">
    <input id="createBy" name="createBy" type="hidden" value="$!{choBankFinancePage.createBy}">
    <input id="createDate" name="createDate" type="hidden" value="$!{choBankFinancePage.createDate}">
    <input id="updateBy" name="updateBy" type="hidden" value="$!{choBankFinancePage.updateBy}">
    <input id="updateDate" name="updateDate" type="hidden" value="$!{choBankFinancePage.updateDate}">
    <input id="busType" name="busType" type="hidden" value="$!{choBankFinancePage.busType}">
    <input id="status" name="status" type="hidden" value="$!{choBankFinancePage.status}">
    <input id="isBl" name="isBl" type="hidden" value="$!{choBankFinancePage.isBl}">
    <input id="payerAccId" name="payerAccId" type="hidden" value="$!{choBankFinancePage.payerAccId}">
    <input id="bankAccOnline" name="bankAccOnline" type="hidden" value="$!{choBankFinancePage.bankAccOnline}">
    <input id="curId" name="curId" type="hidden" value="$!{choBankFinancePage.curId}">
    <input id="dateUnit" name="dateUnit" type="hidden" value="$!{choBankFinancePage.dateUnit}">
    <input id="payBillId" name="payBillId" type="hidden" value="$!{choBankFinancePage.payBillId}">
    <table class="layui-table">
        <thead>
        <tr>
            <th colspan="4" style="text-align:center">$dictTag.get(
                "choBankFinance.busType",$!{choBankFinancePage.busType})</th>
        </tr>
        </thead>
        <tbody>
        <tr>
        ##单位ID
            <td class="textRight" width="20%">#springMessage('table.choBankFinance.corpId')</td>
            <td width="30%">
                <input type="hidden" id="corpIdDef" value="$!{choBankFinancePage.corpId}">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-scope="all"
                         data-required="true"
                         data-defaultvalue="$!{choBankFinancePage.corpId}"
                         data-resource="cho:bankFinanceN2C:choBankFinance:apply"
                         data-callback="bt.corpCallback"></div>
                </div>
            </td>
        ##付款账号
            <td class="textRight" width="20%">#springMessage('table.choBankFinance.noticeAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="payerAcc" name="payerAcc" lay-verify="required"
                           value="$!{choBankFinancePage.payerAcc}" data-link="balanceDiv"
                           autocomplete="off" class="layui-input text"
                           placeholder="#springMessage('table.choBankFinance.timeAcc')">
                </div>
                <div class="layui-input-inline">
                    <button class="layui-btn bt-biz-bisFinanceExc" id="selBisFinanceExcBut" type="button"
                            data-callback="bt.bisFinanceExcCallback">#springMessage('common.button.select')</button>
                </div>
            </td>
        </tr>
        <tr>
        ##收款账号
            <td class="textRight">#springMessage('table.choBankFinance.currentAcc')</td>
            <td>
                <input type="text" id="payeeAcc" name="payeeAcc" lay-verify="required" readonly="readonly"
                       value="$!{choBankFinancePage.payeeAcc}"
                       autocomplete="off" class="layui-input text"
                       placeholder="#springMessage('table.choBankFinance.currentAcc')">
            </td>
        ##付款账户余额
            <td class="textRight">#springMessage('table.choBankFinance.balance')</td>
            <td>
                <div id="balanceDiv" name="balanceDiv">$!{choBankFinancePage.balance}</div>
                <!--number-->
                <input type="hidden" id="balance" name="balance" style="text-align:right" readonly="readonly"
                       data-name="balance" data-biz-name="balance"
                       autocomplete="off" class="layui-input bt-biz-moneyType"
                       placeholder="#springMessage('table.choBankFinance.balance')"
                       value="$!{choBankFinancePage.balance}">
            </td>
        </tr>
        <tr>
        ##起息日期
            <td class="textRight">#springMessage('table.choBankFinance.interestStartDate')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" id="interestStartDate" name="interestStartDate" data-name="interestStartDate" data-biz-name="interestStartDate" readonly="readonly" lay-verify="required" value="$!{choBankFinancePage.interestStartDate}" class="layui-input bt-biz-dateType" data-type="date">
                </div>
            </td>
        ##到期日期
            <td class="textRight">#springMessage('table.choBankFinance.deadlineDate')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" id="deadlineDate" name="deadlineDate" data-name="deadlineDate" data-biz-name="deadlineDate" readonly="readonly" lay-verify="required" value="$!{choBankFinancePage.deadlineDate}" class="layui-input bt-biz-dateType" data-type="date">
                </div>
            </td>
        </tr>
        <tr>
        ##通知类型（活期转通知）：1天、7天
            <td class="textRight">#springMessage('table.choBankFinance.noticeDayLimit')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-required="true" data-disabled="true"
                     data-value="$!{choBankFinancePage.dayLimit}"
                     data-group="choBankFinance.noticeDayLimit" data-name="dayLimit" data-biz-name="dayLimit"></div>
            </td>
        ##利率
            <td class="textRight">#springMessage('table.choBankFinance.interestRate')</td>
            <td>
                <input type="text" id="interestRate" name="interestRate" lay-verify="required"
                       value="$!{choBankFinancePage.interestRate}"
                       autocomplete="off" class="layui-input bt-biz-rateType"
                       placeholder="#springMessage('table.choBankFinance.interestRate')" data-biz-name="interestRate">
            </td>
        </tr>
        <tr>
        ##金额
            <td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <input type="text" id="payMoney" name="payMoney" style="text-align:right"
                           lay-verify="required" data-name="payMoney" data-toUp="payMoneyUp" data-biz-name="payMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType"
                           placeholder="#springMessage('table.nisBillhead.payMoney.lower')"
                           value="$!{choBankFinancePage.payMoney}">
                </div>
            </td>
            <td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
            <td width="30%" style="padding-left:0px">
                <div id="payMoneyUp"></div>
            </td>
        </tr>
        <tr>
        ##期望支付日期
            <td class="textRight">#springMessage('table.choBankFinance.wishPayday')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="wishPayday" name="wishPayday" lay-verify="required" class="layui-input bt-biz-dateType" value="$!{choBankFinancePage.wishPayday}"
                           data-today="true" data-type="date" data-min="$!{sysDate}" data-max="$!{choBankFinancePage.deadlineDate}">
                </div>
            </td>
        ##是否上线
            <td class="textRight" width="20%">#springMessage('table.btBankAcc.isOnline')</td>
            <td>
                <div class="layui-inline" id="isOnlineDiv">
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-required = "true" data-defaultvalue="$!{choBankFinancePage.isOnline}" data-name="isOnline"
                         data-biz-name="isOnline"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##用途
            <td class="textRight">#springMessage('table.choBankFinance.purpose')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="hidden" id="purposeDef" value="$!{choBankFinancePage.purpose}">
                    <select name="purpose" id="purpose" lay-verify="required" lay-search="" data-inputvalue="true">
                        <option value=" "></option>
                        <option value="inputText"></option>
                    </select>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage(
                    'common.button.submit')</button>
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage(
                    'common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choBankFinanceNotice2Current.edit.js?_btv=${resourceVersion}"></script>
</html>

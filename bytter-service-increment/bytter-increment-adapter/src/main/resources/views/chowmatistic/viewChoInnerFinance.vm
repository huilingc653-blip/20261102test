<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<input id="id" name="id" type="hidden" value="$!{choInnerFinancePage.id}">
		<input id="busType" name="busType" type="hidden" value="$!{busType}">
		<div id="print">
            #if($!{choInnerFinancePage.busType} == 10 || $!{choInnerFinancePage.busType} == 12)
			<table class="layui-table">
				<thead>
				<tr>
					<th colspan="4" style="text-align:center">$dictTag.get("choInnerFinance.busType",$!{choInnerFinancePage.busType})</th>
				</tr>
				</thead>
				<tbody>
				<tr>
					##业务单号
					<td width="15%" class="textRight">#springMessage('table.choBankFinance.billNo')</td>
					<td width="35%">$!{choInnerFinancePage.billNo}</td>
					<td width="15%" class="textRight">#springMessage('table.choBankFinance.createDate')</td>
					<td width="35%">$!date.format('yyyy-MM-dd',$!{choInnerFinancePage.createDate})</td>
				</tr>
				<tr>
					##单位
					<td class="textRight">#springMessage('table.choBankFinance.corpId')</td>
					<td width="35%">$!{choInnerFinancePage.corpName}</td>
					##付款账号
					<td class="textRight">
						#if($!{choInnerFinancePage.busType} == 10 || $!{choInnerFinancePage.busType} == 12)
							#springMessage('table.choBankFinance.currentAcc')
						#elseif($!{choInnerFinancePage.busType} == 11)
							#springMessage('table.choBankFinance.timeAcc')
						#else($!{choInnerFinancePage.busType} == 13)
							#springMessage('table.choBankFinance.noticeAcc')
						#end
					</td>
					<td width="35%">$!{choInnerFinancePage.payerAcc}</td>
				</tr>
				<tr>
					##存款类型
					<td class="textRight">#springMessage('table.eTransBill.depositType')</td>
					<td width="35%">$!{choInnerFinancePage.depositRateTypeName}</td>
					#if($!{choInnerFinancePage.busType} == 10)
						##期限
						<td class="textRight">#springMessage('table.tbCreditPeriod.period')</td>
						<td width="35%">$!{choInnerFinancePage.dayLimit}$dictTag.get("pricing.fixedTerm",$!{choInnerFinancePage.dateUnit})</td>
					#elseif($!{choInnerFinancePage.busType} == 12)
						##通知类型
						<td class="textRight">#springMessage('table.choBankFinance.noticeDayLimit')</td>
						<td width="35%">$dictTag.get("pricing.noticeType",$!{choInnerFinancePage.noticeType})</td>
					#end
				</tr>
				<tr>
					##起息日期
					<td class="textRight">#springMessage('table.choBankFinance.interestStartDate')</td>
					<td width="35%">$!date.format('yyyy-MM-dd',$!{choInnerFinancePage.interestStartDate})</td>
                    #if($!{choInnerFinancePage.busType} == 10)
                        ##到期日期
                        <td class="textRight">#springMessage('table.choBankFinance.deadlineDate')</td>
                        <td width="35%">$!date.format('yyyy-MM-dd',$!{choInnerFinancePage.deadlineDate})</td>
                    #else
                        <td></td>
                        <td></td>
                    #end
				</tr>
				<tr>
					##金额
					<td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
					<td width="35%">
						$!number.formatNumeric($!{choInnerFinancePage.payMoney})
						<input type="hidden" data-name="payMoney" data-toUp="payMoneyUp" autocomplete="off"
							   class="layui-input bt-biz-moneyType" value="$!{choInnerFinancePage.payMoney}">
					</td>
					<td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
					<td width="35%" style="padding-left:0px"><div id="payMoneyUp"></div></td>
				</tr>
				<tr>
					##用途
					<td class="textRight">#springMessage('table.choBankFinance.purpose')</td>
					<td width="35%">$!{choInnerFinancePage.purpose}</td>
                    #if($!{choInnerFinancePage.busType} == 10)
                        ##到期处理方式
                        <td class="textRight">#springMessage('table.choBankFinance.certificateWay')</td>
                        <td width="35%">$dictTag.get("choInnerFinance.certificateWay",$!{choInnerFinancePage.certificateWay})</td>
                    #else
                        <td></td>
                        <td></td>
                    #end
				</tr>
                <tr>
                    ##参考利率
                    <td class="textRight">#springMessage('table.choInnerFinance.interestRate')</td>
                    <td width="35%">$!rateTag.show($!{choInnerFinancePage.interestRate})</td>
                    ##参考利息
                    <td class="textRight">#springMessage('table.choInnerFinance.expectInterest')</td>
                    <td width="35%">$!number.formatNumeric($!{choInnerFinancePage.expectInterest})</td>
                </tr>
				<tr>
					##备注
					<td class="textRight">#springMessage('fcVoucherType.rmk')</td>
					<td colspan="3">$!{choInnerFinancePage.addWord}</td>
				</tr>
				</tbody>
			</table>
            #elseif($!{choInnerFinancePage.busType} == 11 || $!{choInnerFinancePage.busType} == 13 || $!{choInnerFinancePage.busType} == 14)
            <div class="layui-collapse" lay-filter="collapse">
                <div class="layui-colla-item">
                    <h2 class="layui-colla-title">
						#if($!{choInnerFinancePage.busType} == 11)
							#springMessage('table.choInnerFinance.timeInfo')
						#else
							#springMessage('table.choInnerFinance.noticeInfo')
						#end
					</h2>
                    <div class="layui-colla-content layui-show">
                        <table class="layui-table">
                            <tbody>
                            <tr>
								##业务单号
                                <td width="15%" class="textRight">#springMessage('table.choBankFinance.billNo')</td>
                                <td width="35%">$!{choInnerFinancePage.billNo}</td>
                                <td width="15%" class="textRight">#springMessage('table.choBankFinance.createDate')</td>
                                <td width="35%">$!date.format('yyyy-MM-dd',$!{choInnerFinancePage.createDate})</td>
                            </tr>
                            <tr>
								##单位
                                <td class="textRight">#springMessage('table.choBankFinance.corpId')</td>
                                <td>$!{choInnerFinancePage.corpName}</td>
								##支取日期/预约日期
                                <td class="textRight">
									#if($!{choInnerFinancePage.busType} == 11 || $!{choInnerFinancePage.busType} == 13)
										#springMessage('table.choInnerFinance.drawDate')
									#else
										#springMessage('table.choInnerFinance.orderDate')
									#end
								</td>
                                <td width="35%" >$!date.format('yyyy-MM-dd',$!{choInnerFinancePage.payDate})</td>
                            </tr>
                            <tr>
								##关联编号
                                <td class="textRight">
									#if($!{choInnerFinancePage.busType} == 11)
										#springMessage('table.choInnerFinance.timeBillNo')
									#else
										#springMessage('table.choInnerFinance.noticeBillNo')
									#end
                                </td>
                                <td width="35%" >$!{choInnerFinancePage.relatedBillNo}</td>
								##收款账号
                                <td class="textRight">#springMessage('table.choBankFinance.currentAcc')</td>
                                <td width="35%" >$!{choInnerFinancePage.payeeAcc}</td>
                            </tr>
                            <tr>
								##期限
                                <td class="textRight">
									#if($!{choInnerFinancePage.busType} == 11)
										#springMessage('table.choBankFinance.dayLimit')
									#else
										#springMessage('table.choBankFinance.noticeDayLimit')
									#end
								</td>
                                <td >
									#if($!{choInnerFinancePage.busType} == 11)
										$!{choInnerFinancePage.dayLimit}$dictTag.get("pricing.fixedTerm",$!{choInnerFinancePage.dateUnit})
									#else
										$dictTag.get("pricing.noticeType",$!{choInnerFinancePage.noticeType})
									#end
                                </td>
                                #if($!{choInnerFinancePage.busType} == 11)
                                    ##到期处理方式 0-不处理 1-本金续存 2-本息续存
                                    <td class="textRight">#springMessage('table.choBankFinance.certificateWay')</td>
                                    <td >$dictTag.get("choInnerFinance.certificateWay",$!{choInnerFinancePage.certificateWay})</td>
                                #else
                                    <td></td>
                                    <td></td>
                                #end
                            </tr>
                            <tr>
								##存款金额
                                <td class="textRight">#springMessage('table.choInnerFinance.depositMoney')</td>
                                <td width="35%">$!number.formatNumeric($!{choInnerFinanceRelatedPage.payMoney})</td>
								##存款利率
                                <td class="textRight">#springMessage('table.eTransBill.depositRate')</td>
                                <td width="35%" >$!rateTag.show($!{choInnerFinancePage.interestRate})</td>
                            </tr>
                            <tr>
								##已支取金额
                                <td class="textRight">#springMessage('table.choBankFinance.drawMoney')</td>
                                <td width="35%" >$!number.formatNumeric($!{choInnerFinanceRelatedPage.drawMoney})</td>
								##剩余存款金额
                                <td class="textRight">#springMessage('table.choBankFinance.drawBal')</td>
                                <td width="35%">$!number.formatNumeric($!{choInnerFinanceRelatedPage.timeBalance})</td>
                            </tr>
                            <tr>
								##起息日期
                                <td class="textRight">#springMessage('table.choBankFinance.interestStartDate')</td>
                                <td width="35%">$!date.format('yyyy-MM-dd',$!{choInnerFinancePage.interestStartDate})</td>
                                #if($!{choInnerFinancePage.busType} == 11)
                                    ##到期日期
                                    <td class="textRight">#springMessage('table.choBankFinance.deadlineDate')</td>
                                    <td width="35%">$!date.format('yyyy-MM-dd',$!{choInnerFinancePage.deadlineDate})</td>
                                #else
                                    <td></td>
                                    <td></td>
                                #end
                            </tr>
                            <tr>
							##用途
                                <td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
                                <td colspan="3">$!{choInnerFinanceRelatedPage.purpose}</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="layui-collapse" lay-filter="collapse">
                <div class="layui-colla-item">
                    <h2 class="layui-colla-title">
						#if($!{choInnerFinancePage.busType} == 14)
							#springMessage('table.choInnerFinance.bookInfo')
						#else
							#springMessage('table.choInnerFinance.drawInfo')
						#end
					</h2>
                    <div class="layui-colla-content layui-show">
                        <table class="layui-table">
                            <tbody>
                            <tr>
								##金额
                                <td width="15%" class="textRight">
									#if($!{choInnerFinancePage.busType} == 14)
										#springMessage('table.choInnerFinance.orderMoney.lower')
									#else
										#springMessage('table.common.drawMoney.lower')
									#end
								</td>
                                <td width="35%">
									$!number.formatNumeric($!{choInnerFinancePage.payMoney})
                                    <input type="hidden" data-name="payMoney" data-toUp="payMoneyUp" autocomplete="off"
                                           class="layui-input bt-biz-moneyType" value="$!{choInnerFinancePage.payMoney}">
                                </td>
                                <td width="15%" class="textRight">
									#if($!{choInnerFinancePage.busType} == 14)
										#springMessage('table.choInnerFinance.orderMoney.upper')
									#else
										#springMessage('table.common.drawMoney.upper')
									#end
								</td>
                                <td width="35%" style="padding-left:0px"><div id="payMoneyUp"></div></td>
                            </tr>
                            <tr>
								##本金转入账号
                                <td class="textRight">#springMessage('table.choInnerFinance.capitalAcc')</td>
                                <td width="35%">$!{choInnerFinancePage.capitalAcc}</td>
								##本金转入账户名称
                                <td class="textRight">#springMessage('table.choInnerFinance.capitalAccName')</td>
                                <td width="35%" >$!{choInnerFinancePage.capitalAccName}</td>
                            </tr>
                            <tr>
								##利息转入账号
                                <td class="textRight">#springMessage('table.choInnerFinance.interestAcc')</td>
                                <td width="35%">$!{choInnerFinancePage.interestAcc}</td>
								##利息转入账户名称
                                <td class="textRight">#springMessage('table.choInnerFinance.interestAccName')</td>
                                <td width="35%">$!{choInnerFinancePage.interestAccName}</td>
                            </tr>
                            <tr>
								##预计利息
                                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.anticInterest')</td>
                                <td width="35%">$!number.formatNumeric($!{choInnerFinancePage.expectInterest})</td>
								##用途
                                <td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
                                <td width="35%">$!{choInnerFinancePage.purpose}</td>
                            </tr>
                            <tr>
                                <td class="textRight">#springMessage('fcVoucherType.rmk')</td>
                                <td colspan="3">$!{choInnerFinancePage.addWord}</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            #else
            <div class="layui-collapse" lay-filter="collapse">
                <div class="layui-colla-item">
                    <h2 class="layui-colla-title">#springMessage('table.choInnerFinance.bookInfo')</h2>
                    <div class="layui-colla-content layui-show">
                        <table class="layui-table">
                            <tbody>
                            <tr>
								##业务单号
                                <td width="15%" class="textRight">#springMessage('table.choBankFinance.billNo')</td>
                                <td width="35%">$!{choInnerFinancePage.billNo}</td>
                                <td width="15%" class="textRight">#springMessage('table.choBankFinance.createDate')</td>
                                <td width="35%">$!date.format('yyyy-MM-dd',$!{choInnerFinancePage.createDate})</td>
                            </tr>
                            <tr>
								##单位
                                <td class="textRight">#springMessage('table.choBankFinance.corpId')</td>
                                <td width="35%">$!{choInnerFinancePage.corpName}</td>
								##取消预约日期
                                <td class="textRight">#springMessage('table.choInnerFinance.cancelOrderDate')</td>
                                <td width="35%" >$!date.format('yyyy-MM-dd',$!{choInnerFinancePage.payDate})</td>
                            </tr>
                            <tr>
								##关联编号
                                <td class="textRight">#springMessage('table.choInnerFinance.noticeOrderBillNo')</td>
                                <td width="35%" >$!{choInnerFinancePage.relatedBillNo}</td>
								##收款账号
                                <td class="textRight">#springMessage('table.choBankFinance.currentAcc')</td>
                                <td width="35%" >$!{choInnerFinancePage.payeeAcc}</td>
                            </tr>
                            <tr>
								##期限
                                <td class="textRight">#springMessage('table.choBankFinance.noticeDayLimit')</td>
                                <td >$dictTag.get("pricing.noticeType",$!{choInnerFinancePage.noticeType})</td>
								##到期处理方式 0-不处理 1-本金续存 2-本息续存
                                #*<td class="textRight">#springMessage('table.choBankFinance.certificateWay')</td>
                                <td >$dictTag.get("choInnerFinance.certificateWay",$!{choInnerFinancePage.certificateWay})</td>*#
                                <td></td>
                                <td></td>
                            </tr>
                            <tr>
								##金额
                                <td class="textRight">#springMessage('table.choInnerFinance.orderMoney.lower')</td>
                                <td width="35%">
									$!number.formatNumeric($!{choInnerFinancePage.payMoney})
                                    <input type="hidden" data-name="payMoney" data-toUp="payMoneyUp" autocomplete="off"
                                           class="layui-input bt-biz-moneyType" value="$!{choInnerFinancePage.payMoney}">
                                </td>
                                <td class="textRight">#springMessage('table.choInnerFinance.orderMoney.upper')</td>
                                <td width="35%" style="padding-left:0px"><div id="payMoneyUp"></div></td>
                            </tr>
                            <tr>
								##本金转入账号
                                <td class="textRight">#springMessage('table.choInnerFinance.capitalAcc')</td>
                                <td width="35%">$!{choInnerFinancePage.capitalAcc}</td>
								##本金转入账户名称
                                <td class="textRight">#springMessage('table.choInnerFinance.capitalAccName')</td>
                                <td >$!{choInnerFinancePage.capitalAccName}</td>
                            </tr>
                            <tr>
								##利息转入账号
                                <td class="textRight">#springMessage('table.choInnerFinance.interestAcc')</td>
                                <td width="35%">$!{choInnerFinancePage.interestAcc}</td>
								##利息转入账户名称
                                <td class="textRight">#springMessage('table.choInnerFinance.interestAccName')</td>
                                <td>$!{choInnerFinancePage.interestAccName}</td>
                            </tr>
                            <tr>
								##预计利息
                                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.anticInterest')</td>
                                <td width="35%">$!number.formatNumeric($!{choInnerFinancePage.expectInterest})</td>
								##用途
                                <td class="textRight">#springMessage('table.nisBillhead.purpose')</td>
                                <td>$!{choInnerFinancePage.purpose}</td>
                            </tr>
                            <tr>
                                <td class="textRight">#springMessage('fcVoucherType.rmk')</td>
                                <td colspan="3">$!{choInnerFinancePage.addWord}</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            #end
		</div>
		<!-- 日志 -->
		<div id="tagMsg"></div>
        <p>
        <div class="layui-form-item layui-form-submit" id="buttonDiv">
			<div class="layui-input-block">
				<button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{choInnerFinancePage.id}')">#springMessage('common.button.trackFlow')</button>
				<button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
			</div>
        </div>
	</form>
    #parse("views/common/footer.vm")
	<script src="${basePath}/static/modules/chowmatistic/choBankFinance.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
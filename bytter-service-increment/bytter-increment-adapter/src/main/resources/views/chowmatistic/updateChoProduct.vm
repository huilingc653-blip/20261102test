<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <input id="id" name="id" type="hidden" value="$!{choProductPage.id}">
        <input id="validSign" name="validSign" type="hidden" value="$!{choProductPage.validSign}">
        <tbody>
        <tr>
        ##银行类别
            <td class="textRight" width="30%">#springMessage("table.choProduct.bankTypeId")</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json" data-required="true"
                     data-defaultvalue="$!{choProductPage.bankTypeId}" data-name ="bankTypeId" data-biz-name ="bankTypeId"  data-valueField="id" data-textField="typeName"></div>
            </td>
        </tr>
        <tr>
            ##理财类型
            <td class="textRight">#springMessage("table.choProduct.financialType")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="financial.type" data-defaultvalue="$!{choProductPage.financialType}"
                     data-required="true" data-name="financialType" data-biz-name="financialType" id="financialType" data-callback="financialTypeCallback" ></div>
            </td>
        </tr>
        <tr>
        ##产品类别
            <td class="textRight">#springMessage("table.choProduct.productType")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="cho.productType" data-defaultvalue="$!{choProductPage.productType}"
                    #if($!{choProductPage.financialType} eq 1)
                        data-filterData="3,4,5,6"
                    #else
                        #if($!{choProductPage.financialType} eq 0)
                            data-filterData="1,2"
                        #else
                            data-filterData="2,3,4,5,6"
                        #end
                    #end
                     data-required="true" data-name="productType" data-biz-name="productType" id="productType"></div>
            </td>
        </tr>
        <tr>
        ##产品代码
            <td class="textRight">#springMessage("table.choProduct.productCode")</td>
            <td>
                <input type="text" name="productCode" autocomplete="off" class="layui-input" value="$!{choProductPage.productCode}"
                       lay-verify="required|strlength|numberOrletter" data-maxlength="60" disabled="true">
            </td>
        </tr>
        <tr>
        ##产品名称
            <td class="textRight">#springMessage("table.choProduct.productName")</td>
            <td>
                <input type="text" id="productName" name="productName" lay-verify="required|strlength" data-maxlength="100"
                       autocomplete="off" class="layui-input" value="$!{choProductPage.productName}">
            </td>
        </tr>
        <tr>
        ##币别
            <td class="textRight">#springMessage("table.choProduct.curId")</td>
            <td>
                <div class=bt-biz-selectType  data-name="curId" data-textField="curName" data-valueField="id" data-required="true"
                     data-url="${basePath}/basic/business/btcurrency/json" data-biz-name="curId" data-defaultvalue="$!{choProductPage.curId}"></div>
            </td>
        </tr>
##        <tr>
##        ##有效标志
##            <td class="textRight">#springMessage("table.choProduct.validSign")</td>
##            <td>
##                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="validSign"
##                      data-biz-name="validSign" id="validSign" data-defaultvalue="$!{choProductPage.validSign}"></div>
##            </td>
        </tr>
        #*<tr>
            ##到期续存方式
            <td class="textRight">#springMessage("table.fcAcc.certificateWay")</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="radio" data-group="choBankFinance.certificateWay" data-defaultvalue="$!{choProductPage.certificateWay}" data-filterData="0" data-name="certificateWay" data-biz-name="certificateWay"></div>
                </div>
            </td>
        </tr>*#
        ##备注
        <tr>
            <td class="textRight">#springMessage("table.choProduct.rmk")</td>
            <td>
                <textarea placeholder="#springMessage('table.erpDataType.rmk')" class="layui-textarea" rows=3 cols=20 lay-verify="strlength"
                          data-maxlength="100"  id="rmk" name="rmk">$!{choProductPage.rmk}</textarea>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choProduct.update.js?_btv=${resourceVersion}"></script>
</html>
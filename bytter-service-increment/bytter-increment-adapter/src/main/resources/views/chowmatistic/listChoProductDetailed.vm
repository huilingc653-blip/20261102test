<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
        ##单位名称
            <td class="textRight">#springMessage("table.choBankFinance.corpId")</td>
            <td width="20%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-tree-type="check"
                         data-name="corpId"
                         data-defaultvalue="$!{search.corpId}"
                         data-resource="cho:report:choProductDetailed:query"
                         data-scope="all"></div>
                </div>
            </td>
        ##银行类别
            <td class="textRight">#springMessage("table.choProduct.bankTypeId")</td>
            <td width="20%">
                <div class="bt-biz-mulselectType layui-inline" data-url="${basePath}/basic/business/btbanktype/json"
                     data-defaultvalue="$!{search.bankTypeId}" data-method="get"
                     data-name="bankTypeId" data-biz-name="bankTypeId" data-valueField="id"
                     data-textField="typeName"></div>
            </td>
        ##产品类别
            <td class="textRight">#springMessage("table.choProduct.productType")</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="select" data-group="cho.productType"
                     data-defaultvalue="$!{search.productType}"
                     data-name="productType" data-biz-name="productType" id="productType"></div>
            </td>
        </tr>
        <tr>
        ##币别
            <td class="textRight">#springMessage("table.choProduct.curId")</td>
            <td width="20%">
                <div class="bt-biz-mulselectType layui-inline" data-url="${basePath}/basic/business/btcurrency/json" data-method="get"
                     data-name="curId" data-biz-name="curId" data-valueField="id" data-defaultvale="$!{search.curId}"
                     data-textField="curName"></div>
            </td>
        ##查询时间
            <td class="textRight">#springMessage("netbanck.reporter.checktime")</td>
            <td width="20%">
                <input type="text" name="currentStartDate" class="layui-input bt-input-inline bt-biz-dateType"
                       data-today="true"
                       data-endid="led_deadlineDate" value="$!date.format("yyyy-MM-dd",$!{search.currentStartDate})">
                <span class="date-mid">~</span>
                <input type="text" name="currentEndDate" class="layui-input bt-input-inline bt-biz-dateType"
                       id="led_deadlineDate"
                       value="$!date.format("yyyy-MM-dd",$!{search.currentEndDate})" data-today="true">
            </td>
            ##是否到期
            <td class="textRight">#springMessage("table.choProductQuery.expire")</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="mulselect" data-group="sf_yn"
                     data-name="isDeadline" data-biz-name="isDeadline"></div>
            </td>
        </tr>


        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                        'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage(
                        'common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-form layui-table" style="width: 100%">
    <thead>
    ##    <tr>
    ##        <th colspan="17">#springMessage("cho.productDetailed.baseInfo")</th>
    ##        <th  colspan="14">#springMessage("cho.productDetailed.incomeInfo")</th>
    ##        <th  colspan="15">#springMessage("cho.productDetailed.currentIncomeInfo")</th>
    ##    </tr>
    <tr>
        <th colspan="16">#springMessage("cho.productDetailed.baseInfo")</th>
        <th colspan="14">#springMessage("cho.productDetailed.incomeInfo")</th>
        <th colspan="2">#springMessage("cho.productDetailed.currentDefine")</th>
        <th colspan="5">#springMessage("cho.productDetailed.currentRedeemedIncomeInfo")</th>
        <th colspan="5">#springMessage("cho.productDetailed.currentWaitRedeemIncomeInfo")</th>
        <th colspan="3">#springMessage("cho.productDetailed.currentProductIncomeInfo")</th>
    </tr>
    <tr>
        <th>#springMessage("cho.productDetailed.corpName")</th>
        <th>#springMessage("cho.productDetailed.bankTypeName")</th>
        <th style="min-width: 300px;">#springMessage("cho.productDetailed.bankName")</th>
        <th>#springMessage("cho.productDetailed.productType")</th>
        <th>#springMessage("cho.productDetailed.productCode")</th>
        <th>#springMessage("cho.productDetailed.productName")</th>
        <th>#springMessage("cho.productDetailed.bankAcc")</th>
        <th>#springMessage("cho.productDetailed.buyMoney")</th>
        <th>#springMessage("cho.productDetailed.curName")</th>
        <th>#springMessage("cho.productDetailed.incomeClause")</th>
        <th>#springMessage("cho.productDetailed.referIncomeRate")</th>
        <th>#springMessage("cho.productDetailed.referIncomeMoney")</th>
        <th>#springMessage("cho.productDetailed.dayLimit")</th>
        <th>#springMessage("cho.productDetailed.buyDate")</th>
        <th>#springMessage("cho.productDetailed.interestStartDate")</th>
        <th>#springMessage("cho.productDetailed.deadlineDate")</th>
        <th>#springMessage("cho.productDetailed.redeemedMoney")</th>
        <th>#springMessage("cho.productDetailed.redeemedDate")</th>
        <th>#springMessage("cho.productDetailed.redeemedDay")</th>
        <th>#springMessage("cho.productDetailed.redeemedWeight")</th>
        <th>#springMessage("cho.productDetailed.redeemedReferIncomeMoney")</th>
        <th>#springMessage("cho.productDetailed.redeemedIncomeMoney")</th>
        <th>#springMessage("cho.productDetailed.redeemedWeightAverageInvest")</th>
        <th>#springMessage("cho.productDetailed.redeemedAnnualizedReturn")</th>
        <th>#springMessage("cho.productDetailed.redeemedsMoney")</th>
        <th>#springMessage("cho.productDetailed.waitRedeemMoney")</th>
        <th>#springMessage("cho.productDetailed.lastRedeemedDate")</th>
        <th>#springMessage("cho.productDetailed.redeemedsIncomeMoney")</th>
        <th>#springMessage("cho.productDetailed.redeemedsWeightAverageInvest")</th>
        <th>#springMessage("cho.productDetailed.redeemedsAnnualizedReturn")</th>
        <th>#springMessage("cho.productDetailed.currentStartDate")</th>
        <th>#springMessage("cho.productDetailed.currentEndDate")</th>
        <th>#springMessage("cho.productDetailed.currentDay")</th>
        <th>#springMessage("cho.productDetailed.currentWeight")</th>
        <th>#springMessage("cho.productDetailed.currentIncomeMoney")</th>
        <th>#springMessage("cho.productDetailed.currentRedeemedWeightAverageInvest")</th>
        <th>#springMessage("cho.productDetailed.currentRedeensAnnualizedReturn")</th>
        <th>#springMessage("cho.productDetailed.currentWaitRedeemDay")</th>
        <th>#springMessage("cho.productDetailed.currentWaitRedeemWeight")</th>
        <th>#springMessage("cho.productDetailed.currentWaitRedeemIncomeMoney")</th>
        <th>#springMessage("cho.productDetailed.currentWaitRedeemWeightAverageInvest")</th>
        <th>#springMessage("cho.productDetailed.currentWaitRedeemAnnualizedReturn")</th>
        <th>#springMessage("cho.productDetailed.currentReferIncomeRate")</th>
        <th>#springMessage("cho.productDetailed.currentWeightAverageInvest")</th>
        <th>#springMessage("cho.productDetailed.currentAnnualizedReturn")</th>
    </tr>
    </thead>
    <tbody>
    </tbody>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choProductDetailed.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
 <table class="layui-table">
        <thead>
        <tr>
            <td width="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
			<td width="80%">#springMessage('config.fbs.paramValue')</td>
		</tr>
        </thead>
		<tbody>
		##定期存款起存额度
        <tr>
            <td class="textRight">#springMessage('config.choBank.regularOnset')</td>
            <td>
            <div class="layui-input-inline">
				<input type="text" name="choBank.regularOnset" style="text-align:right" data-name="choBank.regularOnset" lay-verify="required|number2"
							 autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{config.choBank.regularOnset}">
			</div>
			<div class="layui-input-inline">#springMessage('config.choBank.moneyUnit')</div>
			</td>
        </tr>
        ##定期存款最低留存额度
		<tr style="display: none">
            <td class="textRight">#springMessage('config.choBank.regularKeep')</td>
            <td>
            <div class="layui-input-inline">
				<input type="text" name="choBank.regularKeep" style="text-align:right" data-name="choBank.regularKeep" lay-verify="required|number2"
							 autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{config.choBank.regularKeep}">
			</div>
			<div class="layui-input-inline">#springMessage('config.choBank.moneyUnit')</div>
			</td>
        </tr>
		##定期存款取款次数
		<!-- <tr>
            <td class="textRight">#springMessage('config.choBank.regularNum')</td>
            <td>
            <div class="layui-input-inline">
				<input type="text" name="choBank.regularNum" style="text-align:right" data-name="choBank.regularNum" lay-verify="required|number2"
							 autocomplete="off" class="layui-input bt-biz-moneyType" data-decimal="0" value="$!{config.choBank.regularNum}">
			</div>
			</td>
        </tr> -->
		##通知存款起存额度
        <tr>
            <td class="textRight">#springMessage('config.choBank.noticeOnset')</td>
            <td>
            <div class="layui-input-inline">
				<input type="text" name="choBank.noticeOnset" style="text-align:right" data-name="choBank.noticeOnset" lay-verify="required|number2"
							 autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{config.choBank.noticeOnset}">
			</div>
			<div class="layui-input-inline">#springMessage('config.choBank.moneyUnit')</div>
			</td>
        </tr>
        ##通知存款最低留存额度
		<tr style="display: none">
            <td class="textRight">#springMessage('config.choBank.noticeKeep')</td>
            <td>
            <div class="layui-input-inline">
				<input type="text" name="choBank.noticeKeep" style="text-align:right" data-name="choBank.noticeKeep" lay-verify="required|number2"
							 autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{config.choBank.noticeKeep}">
			</div>
			<div class="layui-input-inline">#springMessage('config.choBank.moneyUnit')</div>
			</td>
        </tr>
		##通知存款最低取款额度
		<tr style="display: none">
            <td class="textRight">#springMessage('config.choBank.noticeMinLimit')</td>
            <td>
            <div class="layui-input-inline">
				<input type="text" name="choBank.noticeMinLimit" style="text-align:right" data-name="choBank.noticeMinLimit" lay-verify="required|number2"
							 autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{config.choBank.noticeMinLimit}">
			</div>
			<div class="layui-input-inline">#springMessage('config.choBank.moneyUnit')</div>
			</td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
	       	 	<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
            </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form','jquery','moneyType'], function(){
        var form = bt.form(),$  = bt.jquery;
        var moneyType = bt.moneyType.init();
        //监听提交
        form.on('submit(configSubmit)', function(data){
            $.post(basePath + "/sys/config/save",data.field,function(result){
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },"JSON");
            return false;
        });
    });
</script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <input type="hidden" lay-verify="isNatualCur" value="$!{curId}">##value是本位币的值
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight">#springMessage("table.btBankAcc.corpId")</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp" data-name="ins_corpId" data-biz-type="corp" data-type="selectTree"
                         data-biz-name="corpId"
                         data-tree-type="check"
                         data-resource="cho:finance:report:query"
                         data-checkkboxtype='{"Y":"s","N":"s"}'
                    ></div>
                </div>
            </td>
        ##内部/银行存款
            <td class="textRight">#springMessage("report.chofinancereport.opType")</td>
            <td>
                <div class="layui-form">
                    <div class="bt-biz-dict" data-type="select" data-defaultvalue="1" data-biz-name="opType"
                         data-name="eqs_opType" data-group="financeReport.opType"></div>
                </div>
            </td>
        ##币别
            <td class="textRight">#springMessage("table.btBankAccCur.cur")</td>
            <td>
                <div class="bt-biz-selectType"
                     data-biz-name="curId"
                     data-url="${basePath}/basic/business/btcurrency/json"
                     data-valuefield="id"
                     data-textfield="curName"
                     data-callback="clearCur"
                     data-name="eqs_curId"
                     data-search="true"
                     data-defaultvalue=""
                     data-required="true"></div>
            </td>
        </tr>
        <tr>
        ##展示方式
            <td class="textRight">#springMessage("common.display.mode")</td>
            <td>
                <div class="layui-form" autocomplete="off">
                    <div class="bt-biz-dict" data-type="radio" data-biz-name="displayMode" data-name="displayMode"
                         data-group="display.mode" data-defaultvalue="1"></div>
                </div>
            </td>
        ##金额单位
            <td class="textRight">#springMessage("table.choProductReq.moneyUnit")</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="select" data-group="cms.MoneyType" data-biz-name="moneyUnit"
                     data-name="moneyUnit" data-defaultvalue="1" data-required="true"></div>
            </td>
        ##是否折合币种
            <td class="textRight">#springMessage("common.isConvert.currency")</td>
            <td>
                <div class="layui-form">
                    <div class="bt-biz-dict" data-type="radio" data-defaultvalue="0" data-biz-name="isToCurr" data-callback="callToCurr"
                         data-name="isToCurr" data-group="sf_yn"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##折合币种
            <td class="textRight">#springMessage("commom.converted.into.currency")</td>
            <td>
                <div class="bt-biz-selectType"
                     data-biz-name="reducedCurId"
                     data-url="${basePath}/basic/business/btcurrency/json"
                     data-valuefield="id"
                     data-textfield="curName"
                     data-name="reducedCurId"
                     data-search="true"
                     data-defaultvalue="$!{cur}"
                     data-disabled = "true"
                     data-callback="checkConvertCurCallBack"
                ></div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary" data-callback="callbackReset">#springMessage(
                    'common.button.reset')</button>
            </td>
        </tr>
        </tbody>

    </table>
</form>

<div id="chartSum" style="width:100%;height:500px;display: none;"></div>

<div id="typeTable">
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr class="tables">
            <th
                ##单位
                #if($terms.size()>0) rowspan="2" #end>#springMessage("table.fbsBudget.corpId")</th>
            #foreach($date in $terms)
                <th #if($terms) colspan="3 #end " class="m">$!{date.termName}</th>##期限
            #end
        </tr>
        #if($terms.size()>0)
            <tr class="tables">
                #foreach($date in $terms)
                    <th class="m">#springMessage("table.accountDTO.balance")</th>##余额
                    <th class="m">#springMessage("table.fcInterestDtl.interest")</th>##利息
                    <th class="m">#springMessage("table.datatable.total")</th>##合计
                #end
            </tr>
        #end
        </thead>
    </table>
</div>

    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
<script language="javascript" type="text/javascript">
    var datatable = {}, dateType, corp, dict, myChartSum;
    var appTable = {"isInit": true};
    var isFirstForm = true;
    var selectType,form;
    bt.use(['form', 'select', 'dicts', 'corp', 'element', 'datatable', 'jquery', 'selectType','date'], function () {
        $ = bt.jquery, form = bt.form();
        dict = bt.dicts.init();
        corp = bt.corp.init();
        selectType = bt.selectType.init();
        ##校验本位币
        form.verify({
            isNatualCur: function(value, item){ //value：表单的值、item：表单的DOM对象
                var isToCurr = dict.get("isToCurr").val();##是否折合本位币的值
                if(!value && isToCurr == "1"){
                    return bt.lang("table.report.isNatualCur");
                }
            }
        });

        //初始化表格
        initTable("#appTable", appTable.columns);
        appTable.isInit = true;
    });

    function callToCurr(data){
        if(data.value =="1"){
            selectType.get("reducedCurId").attr({'data-disabled':false,'data-required':true});
            selectType.get("curId").attr({'data-disabled':true,'data-required':false});
        }else {
            selectType.get("reducedCurId").val("");
            selectType.get("reducedCurId").attr({'data-disabled':true,'data-required':false});
            selectType.get("curId").val("");
            selectType.get("curId").attr({'data-disabled':false,'data-required':true});
        }
        form.renderIcon();
        checkConvertCurCallBack();
    }

    function clearCur(){
        selectType.get("reducedCurId").val("");
    }

    /**
     * 币种转换校验
     */
    function checkConvertCurCallBack() {
        var reducedCurId = selectType.get("reducedCurId").val();
        if (isNotEmpty(reducedCurId)) {
            $.ajax({
                url: basePath + "/report/deposit/balance/checkConvertCurId",
                type:"post",
                data:{
                    "isAllCur":"1",
                    "convertCurId": reducedCurId
                },
                dataType: "json",
                success:function (data) {
                    if (!data.success) {
                        parent.layer ? parent.layer.alert(data.msg, {icon: data.success ? 1 : 2}) : layer.alert(data.msg, {icon: data.success ? 1 : 2});
                        selectType.get("reducedCurId").val("");
                    }
                }
            });
        }
    }

    /**
     * 为空判断
     * @param stringData
     * @returns {boolean}
     */
    function isEmpty(stringData) {
        if (null == stringData || stringData == "" || stringData == undefined || stringData == " " || stringData == "null") {
            return true;
        } else {
            return false;
        }
    }
    /**
     * 非空判断
     * @param stringData
     * @returns {boolean}
     */
    function isNotEmpty(stringData) {
        return !isEmpty(stringData)
    }

    /**
     * datatable渲染
     */
    function initTable(id, columns) {
        bt.datatable.init({
            elem: id,
            colReorder: true,
            order: [0, 'desc'],
            ajax: {
                'url': basePath + "/report/chofinancereport/datatable"
            },
            paging:true,
            isInitData: false,
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search",
                customizeFormSearchFunction: function (data) {
                    var mode = data.field.displayMode;
                    if (mode == "1") {
                        $("#chartSum").hide();
                        $("#typeTable").show();
                        tableAdjust();
                    } else {
                        $("#typeTable").hide();
                        $("#chartSum").show();
                    }
                    initTableSet("appTable");

                    return false;
                }
            },
            exportFile:{
                customPrint:{
                    breakword:[{title:bt.lang('table.sysCorp.corpName'),width:100,name:'corpName'}],
                    header:function(){
                        var html = '<tr>' +
                                '<th rowspan="2">'+bt.lang('table.fbsBudget.corpId')+'</th>';
                        var htmlTh='';
                        #foreach($term in $terms)
                            html += '<th colspan="3" style="text-align: center;">'+'$term.termName'+'</th>';
                            htmlTh += '<th style="text-align: center;">'+bt.lang("table.accountDTO.balance")+'</th>'+
                                    '<th style="text-align: center;">'+bt.lang("table.fcInterestDtl.interest")+'</th>'+
                                    '<th style="text-align: center;">'+bt.lang("table.datatable.total")+'</th>';
                        #end
                        html += '</tr><tr>';
                        html += htmlTh+'</tr>';
                        return html
                    }
                }
            },
            columns: columns,
            btInitComplete: function (settings, data) {

            },
            btDrawCallback: function (setting) {
                if (dict.get("displayMode").val() == "2") {//图表
                    initBar();
                    myChartSum.resize();
                }
            }
        });
    }

    /**
     * 初始化设置
     * @param layId
     */
    function initTableSet(layId) {
        var tableId = "#" + layId;
        var table = new $.fn.dataTable.Api(tableId);
        if (isFirstForm) { //无初始化数据时，点击查询就加载数据
            table.ajax.url(basePath + "/report/chofinancereport/datatable");
            table.ajax.reload(function () { //表格列宽对不齐的问题
                table.columns.adjust().draw();
            }, true);
            isFirstForm = false;
        } else {
            table.draw();
        }
    }

    /**
     * 列表数据
     */
    appTable.columns = [
        {data: "corpName", bSortable: false, className: 'textRight'},
        #foreach($term in $terms)
            {
                data: "balanceTotal" +$velocityCount, bSortable: false, className: 'textRight',
                render: function (data, type, full, meta) {
                    return bt.money.format(full['$term.id' + '_bal']);
                }
            },
            {
                data: "interestTotal" +$velocityCount, bSortable: false, className: 'textRight',
                render: function (data, type, full, meta) {
                    return bt.money.format(full['$term.id' + '_inter']);
                }
            },
            {
                data: "total" +$velocityCount, bSortable: false, className: 'textRight',
                render: function (data, type, full, meta) {
                    return bt.money.format(full['$term.id' + '_total']);
                }
            },
        #end
    ];

    /**
     * 重置
     */
    callbackReset = function () {
        corp.get("corpId").val("");
        dict.get("opType").val("1");
        selectType.get("curId").val("${curId}");
        dict.get("displayMode").val("1");
        dict.get("moneyUnit").val("1");
        dict.get("isToCurr").val("1");
        selectType.get("reducedCurId").val("");
    };

    var flag = false;
    //图表
    myChartSum = echarts.init(document.getElementById('chartSum'));

    function initBar() {
        var data = {
            corpId: corp.get("corpId").val(),
            opType: dict.get("opType").val(),
            curId: selectType.get("curId").val(),
            moneyUnit: dict.get("moneyUnit").val(),
            isToCurr: dict.get("isToCurr").val(),
            reducedCurId: selectType.get("reducedCurId").val(),
        };
        var url = basePath + "/report/chofinancereport/getData";
        if (!flag) {
            myChartSum = echarts.init(document.getElementById('chartSum'));
            flag = true;
        }
        $.ajax({
            type: "post",
            async: false, //同步执行
            url: url,
            data: data,
            dataType: "json", //返回数据形式为json
            success: function (result) {
                //result = $.parseJSON(result);
                //字体多不显示特殊处理
                result.xAxis[0].axisLabel.formatter =
                function(value)
                {
                    var ret = "";//拼接加\n返回的类目项
                    var maxLength = 3;//每项显示文字个数
                    var valLength = value.length;//X轴类目项的文字个数
                    var rowN = Math.ceil(valLength / maxLength); //类目项需要换行的行数
                    if (rowN > 1)//如果类目项的文字大于3,
                    {
                        for (var i = 0; i < rowN; i++) {
                            var temp = "";//每次截取的字符串
                            var start = i * maxLength;//开始截取的位置
                            var end = start + maxLength;//结束截取的位置
                            //这里也可以加一个是否是最后一行的判断，但是不加也没有影响，那就不加吧
                            temp = value.substring(start, end) + "\n";
                            ret += temp; //凭借最终的字符串
                        }
                        return ret;
                    }
                    else {
                        return value;
                    }
                }
                var option = initChartSum(result);
                myChartSum.hideLoading();
                myChartSum.setOption(option, true);
                window.onresize = myChartSum.resize;
            }
        });
    }

    /**
     * 图表赋值
     */
    function initChartSum(result) {
        var option = result;
        return option;
    }

    /**
     * 表格切换时错乱调整
     */
    function tableAdjust() {
        $.fn.dataTable.tables({visible: true, api: true}).columns.adjust();
    }

</script>
</html>

#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<!-- 系统参数 -->
<input id="id" name="id" type="hidden" value="$!{choProductRedeemPage.id}">
<input id="busType" name="busType" type="hidden" value="$!{busType}">

<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell">
        #springMessage("table.choBankFinance.corpId")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductReqPage.corpName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProduct.productCode")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductReqPage.productCode}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProduct.productType")
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("cho.productType",$!{choProductReqPage.productType})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProduct.bankTypeId")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductReqPage.bankTypeName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProduct.productName")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductReqPage.productName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProduct.curId")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductReqPage.curName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.bankName")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductReqPage.bankName}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.bankAcc")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductReqPage.bankAcc}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.buyMoneyLow")
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{choProductReqPage.buyMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.incomeClause")
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("choProduct.incomeClause",$!{choProductReqPage.incomeClause})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.buyDate")
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{choProductReqPage.buyDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.dayLimit")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductReqPage.dayLimit}#springMessage("table.choProductReq.day")
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.interestStartDate")
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{choProductReqPage.interestStartDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.deadlineDate")
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{choProductReqPage.deadlineDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.cashDate")
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{choProductReqPage.cashDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.referIncomeRate")
        <span class="mui-badge mui-badge-inverted">
            $rateTag.show($!{choProductReqPage.referIncomeRate},6)
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.subFeeMoney")
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{choProductReqPage.subFeeMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.referIncomeMoney")
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{choProductReqPage.referIncomeMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.chargeMoney")
        <span class="mui-badge mui-badge-inverted">
            $!number.formatNumeric($!{choProductReqPage.chargeMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.isMoveUp")
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("sf_yn",$!{choProductReqPage.isMoveUp})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.moveUpRmk")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductReqPage.moveUpRmk}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProduct.rmk")
        <span class="mui-badge mui-badge-inverted">
            $!{choProductReqPage.rmk}
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.isGuaranteed")
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("sf_yn",$!{choProductReqPage.isGuaranteed})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage("table.choProductReq.capitalSource")
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("choProduct.capitalSource",$!{choProductReqPage.capitalSource})
        </span>
    </li>
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        #batchRedeem td {
            word-break:keep-all;
        }
        #batchRedeem td label {
            /*width: 70px;*/
            /*display: block;*/
            white-space: nowrap;      /* 禁止换行 */
            display: inline-block;    /* 保持inline-block以便内容撑开 */
        }
        #batchRedeem td .bt-biz-dateType {
            width: 88px;
        }

        .icon-1,
        .icon-2{
            display: inline-block;width: 16px;height: 16px;border-radius: 8px;background: #FFB800;position: relative;
            color: #fff;
        }
        .icon-1{
            cursor: pointer;
            margin-right: 16px;
        }
        .icon-2 {
            color: #fff;text-align: center;
        }
        .table-tips-box {
            position: absolute;
            top: 5px;
            left: 0px;
            top: -96px;
            left: -20px;
            height: 88px;
            width: 200px;
            border-radius: 4px;
            background-color: #fff;
            box-shadow: 1px 1px 4px rgba(0, 0, 0, 0.2);
            display: none;
        }
        .table-tips-box > div {
            height: 32px;
            margin: 8px 20px;
            text-align: left;
        }
        .table-tips-box > div:nth-child(3){
            text-align: right;
        }
        .table-tips-box .layui-icon {
            position: absolute;
            bottom: -14px;
            left: 20px;
            color: #fff;
        }
        .table-tips-box .tips-text {
            color: #666;
            line-height: 32px;
            display: inline-block;
            height: 32px;
            padding-left: 8px;
            font-size: 14px;
        }
        .table-tips-box button {
            height: 28px;
        }
        .table-tips-box .layui-btn-primary {
            background-color: #B4B7C1;
            border-color: #B4B7C1;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <table class="layui-table">
        <input id="id" name="id" type="hidden" value="$!{choProductRedeemPage.id}">
        <input id="billNo" name="billNo" type="hidden" value="$!{choProductRedeemPage.billNo}">
        <input id="status" name="status" type="hidden" value="0">
        <input id="financialType" name="financialType" type="hidden" value="$!{choProductRedeemPage.financialType}">
        <input id="certificateWay" name="certificateWay" type="hidden" value="$!{choProductRedeemPage.certificateWay}">
        <tbody>
        <tr>
            ##单位名称
            <td class="textRight" width="14%">#springMessage("table.choBankFinance.corpId")</td>
            <td width="36%">
                <div class="layui-input-inline">
                    <span id="showName">$!{choProductRedeemPage.corpName}</span>
                    <input type="hidden" class="layui-input text" id="corpId" name="corpId" value="$!{choProductRedeemPage.corpId}">
                </div>
            </td>
            ##理财类型
            <td class="textRight" width="14%">#springMessage("table.choProduct.financialType")</td>
            <td width="36%">
                <div class="layui-input-inline">
                    <label id="financialTypeName">$!{choProductRedeemPage.financialTypeName}</label>
                </div>
            </td>
        </tr>
        <tr>
            ##产品类型
            <td class="textRight">#springMessage("table.choProduct.productType")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="cho.productType" data-defaultvalue="$!{choProductRedeemPage.productType}" data-required="true"
                     data-name="productType" data-biz-name="productType" id="productType" data-disabled="true"></div>
            </td>
            ##产品代码
            <td class="textRight">#springMessage("table.choProduct.productCode")</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="productCode" name="productCode" lay-verify="required" readonly value="$!{choProductRedeemPage.productCode}"
                           autocomplete="off" class="layui-input text" placeholder="#springMessage("table.choProduct.productCode")">
                </div>
                <div class="layui-input-inline">
                    <button class="layui-btn bt-biz-choProduct" id="selProductBut" type="button" data-callback="callbackProduct">#springMessage('common.button.select')</button>
                </div>
            </td>
        </tr>
        <tr>
            ##产品名称
            <td class="textRight">#springMessage("table.choProduct.productName")</td>
            <td>
                <label id="productName">$!{choProductRedeemPage.productName}</label>
            </td>
            ##银行类别
            <td class="textRight" width="14%">#springMessage("table.choProduct.bankTypeId")</td>
            <td width="36%">
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json" data-required="true"
                     data-name ="bankTypeId" data-biz-name ="bankTypeId"  data-valueField="id" data-textField="typeName"
                     data-disabled="true" data-defaultvalue="$!{choProductRedeemPage.bankTypeId}"></div>
            </td>
        </tr>
        <tr>
            ##购买银行
            <td class="textRight">#springMessage("table.choProductReq.bankName")</td>
            <td>
                <label id="bankName">$!{choProductRedeemPage.bankName}</label>
                <input type="hidden" id="bankNameHid" name="bankName">
            </td>
            ##币别
            <td class="textRight">#springMessage("table.choProduct.curId")</td>
            <td>
                <label id="curName">$!{choProductRedeemPage.curName}</label>
            </td>
        </tr>
        <tr>
            ##理财账号
            <td class="textRight">#springMessage("table.choProductReq.bankAcc")</td>
            <td>
                <label id="bankAcc">$!{choProductRedeemPage.bankAcc}</label>
                <input type="hidden" id="bankAccHid" name="bankAcc">
            </td>
            ##到期是否续存
            <td class="textRight fType"
                #if(!($!{choProductRedeemPage.financialType} eq '0')) style="display: none" #end >#springMessage("table.choProduct.isStore")</td>
            <td class="fType" #if(!($!{choProductRedeemPage.financialType} eq '0')) style="display: none" #end>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{choProductRedeemPage.isStore}" data-name="isStore" data-biz-name="isStore"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button type="button" class="layui-btn" onclick="closeTab()">#springMessage('common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
    ##批量赎回列表
    <table class="layui-table dark-layui-table layui-table-border" id="batchRedeem" style="display: block;">
        <thead id="batchRedeemHead">
        <tr align="center">
            <th><div style="width: 100px;">#springMessage("common.table.thead.operation")</div></th>
            #if($choProductRedeemPage.financialType == 2)
                <th><span style="color: red">*</span>#springMessage("table.choProductReq.redeemDailyNetVal")</th>
                <th><span style="color: red">*</span>#springMessage("table.choProductReq.redeemPortion")</th>
            #end
            <th><span style="color: red">*</span>#springMessage("table.choProductRedeem.redeemDate")</th>
            <th><span style="color: red">*</span>#springMessage("table.choProductRedeem.redeemMoney")</th>
            <th><span style="color: red">*</span>#springMessage("table.choProductRedeem.transferDate")</th>
            <th><span style="color: red">*</span>#springMessage("table.choProductRedeem.incomeMoney")
            #if($choProductRedeemPage.financialType == 0)
                &nbsp;<span class="icon-1" style="">
                <span>!</span>
                    <div class="table-tips-box">
                        <i class="layui-icon">&#xe625;</i>
                        <div>
                            <span class="icon-2">!</span>
                            <span class="tips-text">关闭利率计算器</span>
                        </div>
                        <div>
                            <button id="reset" type="reset" class="layui-btn layui-btn-primary">关闭</button>
                            <button id="button" type="button" class="layui-btn">开启</button>
                        </div>
                    </div>
                </span>
            #end
            </th>
            <th><span style="color: red">*</span>#springMessage("table.choProductRedeem.incomeRate")</th>
            <th>#springMessage("table.choProduct.rmk")</th>
            <th>#springMessage("table.choProductReq.subFeeMoneyRedeem")</th>
            <th>#springMessage("table.choProductRedeem.redeemChargeMoney")</th>
            <th>#springMessage("table.choProductReq.chargeMoneyRedeem")</th>
            <th>#springMessage("table.choProductRedeem.lastRedeemDate")</th>
            <th>#springMessage("table.choProductReq.incomeClause")</th>
            <th>#springMessage("table.choProductReq.buyDate")</th>
            <th>#springMessage("table.choProductReq.interestStartDate")</th>
            <th>#springMessage("table.choProductReq.deadlineDate")</th>
            <th>#springMessage("table.choProductReq.dayLimit")</th>
            <th>#springMessage("table.choProductReq.cashDate")</th>
            <th>#springMessage("table.choProductReq.buyMoney")</th>
            <th>#springMessage("cho.product.redeem.leftMoney")</th>
            #if($choProductRedeemPage.financialType != 2)
            <th>#springMessage("table.choProductReq.referIncomeRate")</th>
            <th>#springMessage("table.choProductReq.referIncomeMoney")</th>
            #end
            <th>#springMessage("table.choProductReq.isMoveUp")</th>
            #if($choProductRedeemPage.financialType != 1)
            <th>#springMessage("table.choProduct.isStore")</th>
            <th>#springMessage("table.cmsProvideLoanInfo.cplInterestPayment")</th>
            <th>#springMessage("table.choProduct.incomeType")</th>
            <th>#springMessage("table.ratUrationApply.contactNo")</th>
            <th>#springMessage("table.choProductReq.contractRate")</th>
            #end
            <th>#springMessage("table.choProductReq.capitalSource")</th>
            <th>#springMessage("table.choProductReq.subFeeMoney")</th>
            <th>#springMessage("table.choProductReq.chargeMoney")</th>
        </tr>
        </thead>
        <tbody id="batchRedeemBody">
            #foreach($data in $list)
                #set($row = $math.sub($velocityCount,1))
            <tr id="$row">
                <td align="center">
                    <a href="#" onclick="deleteDtl(this)">#springMessage("common.button.delete")</a>
                    <input name="reqId" type="hidden" value="$!{data.reqId}">
                    <input id="dayLimit_$row" name="dayLimit" type="hidden" value="$!{data.dayLimit}">
                    <input id="incomeClause_$row" name="incomeClause" type="hidden" value="$!{data.incomeClause}">
                </td>
                #if($choProductRedeemPage.financialType == 2)
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" id="redeemDailyNetVal_$row" name="redeemDailyNetVal" data-name="redeemDailyNetVal" data-biz-name="redeemDailyNetVal_$row" class="layui-input bt-biz-moneyType" data-decimal="6"
                                   placeholder="#springMessage("table.choProductReq.redeemDailyNetVal")"
                                   value="$!{data.redeemDailyNetVal}" data-callback="redeemDailyNetValCallback">
                        </div>
                    </td>
                    <td>
                        <input type="text" id="redeemPortion_$row" name="redeemPortion" style="text-align:right" data-name="redeemPortion" data-biz-name="redeemPortion_$row" data-decimal="6"
                               autocomplete="off" class="layui-input bt-biz-moneyType"
                               value="$!{data.redeemPortion}" data-callback="redeemPortionCallback" >
                    </td>
                #end
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="redeemDate_$row" name="redeemDate" data-name="redeemDate"
                               data-biz-name="redeemDate_$row"
                               class="layui-input bt-biz-dateType" data-today="true" data-min="$!{data.minDate}" data-max="$!{data.deadlineDate}"
                               data-type="date" data-callback="redeemDateCallback" value="$!{data.redeemDate}">
                    </div>
                </td>
                <td>
                    <input type="text" id="redeemMoney_$row" name="redeemMoney" style="text-align:right"
                           data-name="redeemMoney" data-biz-name="redeemMoney_$row" data-callback="redeemMoneyCallback"
                           autocomplete="off" class="layui-input bt-biz-moneyType" data-max="$!{data.leftMoney}"
                           value="$!{data.redeemMoney}" placeholder="#springMessage('table.choProductRedeem.redeemMoney')">
                </td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="transferDate_$row" name="transferDate" data-name="transferDate"
                               data-biz-name="transferDate_$row"
                               class="layui-input bt-biz-dateType" data-today="true" data-min="$!{data.minDate}" value="$!{data.transferDate}"
                               data-type="date">
                    </div>
                </td>
                <td>
                    <input type="text" id="incomeMoney_$row" name="incomeMoney" style="text-align: right;"
                           data-name="incomeMoney"
                           data-decimal="2" data-minus="true" value="$!{data.incomeMoney}"
                           data-biz-name="incomeMoney_$row" autocomplete="off" class="layui-input bt-biz-moneyType"
                           data-callback="incomeMoneyCallback">
                </td>
                <td>
                    <input type="text" data-name="incomeRate" id="incomeRate_$row" data-biz-name="incomeRate_$row"
                           class="layui-input bt-biz-rateType" data-decimal="6" value="$!{data.incomeRate}"
                           placeholder="#springMessage('table.choProductRedeem.incomeRate')"
                           data-callback="bt.incomeRateCallback">
                </td>
                <td>
                    <input type="text" name="rmk" id="rmk$row" class="layui-input" value="$!{data.rmk}"
                           placeholder="#springMessage('table.choProduct.rmk')" >
                </td>
                <td>
                    <input name="subFeeMoney" id="subFeeMoney$row" class="layui-input bt-biz-moneyType" value="$!{data.subFeeMoney}">
                </td>
                <td>
                    <input name="redeemChargeMoney" id="redeemChargeMoney$row" class="layui-input bt-biz-moneyType" value="$!{data.redeemChargeMoney}">
                </td>
                <td>
                    <input name="chargeMoney" id="chargeMoney$row" class="layui-input bt-biz-moneyType" value="$!{data.chargeMoney}">
                </td>
                <td>
                    <label id="lastRedeemDate_$row" style="color: rgb(184,184,184)">$!date.format('yyyy-MM-dd',$!{data.lastRedeemDate})</label>
                </td>
                <td>
                    <label id="incomeClauseShow_$row">$dictTag.get("choProduct.incomeClause",$!{data.incomeClause})</label>
                </td>
                <td>
                    <label id="buyDate_$row">$!date.format('yyyy-MM-dd',$!{data.buyDate})</label>
                </td>
                <td>
                    <label id="interestStartDate_$row">$!date.format('yyyy-MM-dd',$!{data.interestStartDate})</label>
                </td>
                <td>
                    <label id="deadlineDate_$row">$!date.format('yyyy-MM-dd',$!{data.deadlineDate})</label>
                </td>
                <td>
                    <label id="dayLimitShow_$row">$!{data.dayLimit}</label>
                </td>
                <td>
                    <label id="cashDate_$row">$!date.format('yyyy-MM-dd',$!{data.cashDate})</label>
                </td>
                <td>
                    <label id="buyMoney_$row">$!number.formatNumeric($!{data.buyMoney})</label>
                </td>
                <td>
                    <label id="leftMoney_$row">$!number.formatNumeric($!{data.leftMoney})</label>
                </td>
                #if($choProductRedeemPage.financialType != 2)
                    <td>
                        <div id="referIncomeRate_$row">$rateTag.show($!{data.referIncomeRate},6)
                            #if($!{data.endReferIncomeRate})
                                ~$rateTag.show($!{data.endReferIncomeRate},6)
                            #end
                        </div>
                    </td>
                    <td>
                        <div id="referIncomeMoney_$row">$!number.formatNumeric($!{data.referIncomeMoney})
                            #if($!{data.endReferIncomeMoney})
                                ~$!number.formatNumeric($!{data.endReferIncomeMoney})
                            #end
                        </div>
                    </td>
                #end
                <td>
                    <label id="isMoveUp_$row">$dictTag.get("sf_yn",$!{data.isMoveUp})</label>
                </td>
                #if($choProductRedeemPage.financialType != 1)
                    <td>
                        <label id="isStore_$row">$dictTag.get("sf_yn",$!{data.isStore})</label>
                    </td>
                    <td>
                        <label id="payWay_$row">$dictTag.get("financial.payWay",$!{data.payWay})</label>
                    </td>
                    <td>
                        <label id="incomeType_$row">
                            #if($dictTag.get("financial.type",$!{data.incomeType}) ne '')
                        $dictTag.get("financial.type",$!{data.incomeType})
                     #else
                                $!{data.incomeType}
                            #end
                        </label>
                    </td>
                    <td>
                        <label id="contractNo_$row">$!{data.contractNo}</label>
                    </td>
                    <td>
                        <label id="contractRate_$row">
                            #if($!{data.endContractRate})
                                $rateTag.show($!{data.startContractRate},6)
                                ~
                                $rateTag.show($!{data.endContractRate},6)
                            #else
                                #if($!{data.startContractRate})
                                    $rateTag.show($!{data.startContractRate},6)
                                #end
                            #end
                        </label>
                    </td>
                #end
                <td>
                    <label id="capitalSource_$row">$dictTag.get("financial.payWay",$!{data.capitalSource})</label>
                </td>
                <td>
                    <label id="reqSubFeeMoney_$row">$!number.formatNumeric($!{data.subFeeMoney})</label>
                </td>
                <td>
                    <label id="reqChargeMoney_$row">$!number.formatNumeric($!{data.chargeMoney})</label>
                </td>
            </tr>
            #end
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choProductRedeemBatch.update.js?_btv=${resourceVersion}"></script>
</html>

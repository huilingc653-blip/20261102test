<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input id="busType" name="busType" type="hidden" value="$!{busType}">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight">#springMessage('table.choBankFinance.corpId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="likes_corpId"
                         data-resource="cho:innerFinanceN2C:choInnerFinance:query"
                         data-scope="all"></div>
                </div>
            </td>
        ##金额
            <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_payMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_payMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right"
                           id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                </div>
            </td>
        </tr>
        <tr>
        ##币别
            <td class="textRight">#springMessage('table.nisBillhead.curId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-name="eqs_curId" data-valueField="id" data-textField="curName"></div>
                </div>
            </td>
        ##状态
            <td class="textRight">#springMessage('table.choBankFinance.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-displayData="0,-1"
                     data-group="choBankFinance.status" data-name="eqi_status"></div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.choBankFinance.billNo')</th>
        <th>#springMessage('table.choBankFinance.corpId')</th>
        <th>#springMessage('table.choBankFinance.curId')</th>
        <th>#springMessage('table.choBankFinance.payMoney')</th>
        <th>#springMessage('table.choBankFinance.noticeDayLimit')</th>
        <th>#springMessage('table.choInnerFinance.drawDate')</th>
        <th>#springMessage('table.choBankFinance.purpose')</th>
        <th>#springMessage('table.choInnerFinance.noticeBillNo')</th>
        <th>#springMessage('table.choBankFinance.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choInnerFinanceNotice2Current.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        html,body,form,iframe,.layui-tab,.layui-tab-content,.layui-tab-item {
            height: 100%;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post" >
    <div class="layui-tab layui-tab-brief" lay-filter="billPay">
        <ul class="layui-tab-title">
            <li class="layui-this">#springMessage('table.choProductReq.queryTitle')</li>
            <li>#springMessage('table.choProductReq.queryNonTitle')</li>
        </ul>
        <div class="layui-tab-content">
            <div class="layui-tab-item layui-show">
                ##保本列表信息
                <iframe id="applyiframe" src="" frameborder="0" style="width: 100%;" name="applyiframe" ></iframe>
            </div>
            <div class="layui-tab-item">
                ##非保本列表信息
                <iframe id="trackiframe" src="" frameborder="0" style="width: 100%;" name="trackiframe"></iframe>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choProductReqUncollectedDir.list.js?_btv=${resourceVersion}"></script>
#if(${pageContent} eq 'listChoProductReqUncollected')
<script src="${basePath}/static/modules/chowmatistic/choProductReqQuery.list.js?_btv=${resourceVersion}"></script>
#else
<script src="${basePath}/static/modules/chowmatistic/choProductReqNonQuery.list.js?_btv=${resourceVersion}"></script>
#end
</html>









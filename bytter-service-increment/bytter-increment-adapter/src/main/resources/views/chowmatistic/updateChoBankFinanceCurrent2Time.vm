<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{choBankFinancePage.id}">
		<input id="billNo" name="billNo" type="hidden" value="$!{choBankFinancePage.billNo}">
        <input id="createBy" name="createBy" type="hidden" value="$!{choBankFinancePage.createBy}">
		<input id="createDate" name="createDate" type="hidden" value="$!{choBankFinancePage.createDate}">
		<input id="updateBy" name="updateBy" type="hidden" value="$!{choBankFinancePage.updateBy}">
		<input id="updateDate" name="updateDate" type="hidden" value="$!{choBankFinancePage.updateDate}">
		<input id="busType" name="busType" type="hidden" value="$!{choBankFinancePage.busType}">
		<input id="status" name="status" type="hidden" value="$!{choBankFinancePage.status}">
		<input id="isBl" name="isBl" type="hidden" value="$!{choBankFinancePage.isBl}">
		<input id="payerAccId" name="payerAccId" type="hidden" value="$!{choBankFinancePage.payerAccId}">
		<input id="bankAccOnline" name="bankAccOnline" type="hidden" value="$!{choBankFinancePage.bankAccOnline}">
		<input id="curId" name="curId" type="hidden" value="$!{choBankFinancePage.curId}">
		<input id="dayLimit" name="dayLimit" type="hidden" value="$!{choBankFinancePage.dayLimit}">
		<input id="dateUnit" name="dateUnit" type="hidden" value="$!{choBankFinancePage.dateUnit}">
        <input type="hidden" name="wishPayday" lay-verify="required" class="bt-biz-dateType" data-today="true" data-type="date">
		<!-- 系统参数 -->
		<input id="regularOnset" name="regularOnset" type="hidden" value="$!{regularOnset}">
		<input id="regularKeep" name="regularKeep" type="hidden" value="$!{regularKeep}">
		<input id="isOpenLimit" name="isOpenLimit" type="hidden" value="$!{isOpenLimit}">
		<table class="layui-table">
			<thead>
            <tr>
                <th colspan="4" style="text-align:center">$dictTag.get("choBankFinance.busType",$!{choBankFinancePage.busType})</th>
			</tr>
			</thead>
			<tbody>
        	<tr>
        		##单位ID
				<td class="textRight" width="20%">#springMessage('table.choBankFinance.corpId')</td>
				<td width="30%">
					<input type="hidden" id="corpIdDef" value="$!{choBankFinancePage.corpId}">
					<div class="layui-input-inline">
						<div class="bt-biz-corp"
						data-biz-type="corp"
						data-type="selectTree"
						data-name="corpId"
						data-scope="all"
						data-required="true"
						data-defaultvalue="$!{choBankFinancePage.corpId}"
						data-resource="cho:bankFinanceC2T:choBankFinance:apply"
						data-callback="bt.corpCallback"></div>
					</div>
				</td>
				##付款账号
				<td class="textRight" width="20%">#springMessage('table.choBankFinance.currentAcc')</td>
				<td width="30%">
					<div class="layui-input-inline">
						<input type="text" id="payerAcc" name="payerAcc" data-biz-name="payerAcc" lay-verify="required|tableData" value="$!{choBankFinancePage.payerAcc}" data-link="balanceDiv"
							 autocomplete="off" class="layui-input text" placeholder="#springMessage('table.choBankFinance.currentAcc')">
						<table id="payerAccTable" class="hide">
							<thead>
								<tr>
									<th>#springMessage('table.choBankFinance.acc')</th>
									<th>#springMessage('table.choBankFinance.accName')</th>
									<th>#springMessage('table.choBankFinance.accBank')</th>
									<th>#springMessage('table.choBankFinance.curId')</th>
								</tr>
							</thead>
						</table>
					</div>
				</td>
			</tr>
        	<tr>
				##利率
				<td class="textRight">#springMessage('table.choBankFinance.interestRate')</td>
				<td >
					<input type="text" id="interestRate" name="interestRate" lay-verify="required" value="$!{choBankFinancePage.interestRate}"
						   autocomplete="off" class="layui-input bt-biz-rateType" placeholder="#springMessage('table.choBankFinance.interestRate')">
				</td>
        		##付款账户余额
				<td class="textRight">#springMessage('table.choBankFinance.balance')</td>
				<td >
					<div id="balanceDiv" name="balanceDiv">$!{choBankFinancePage.balance}</div>
					<!--number-->
					<input type="hidden" id="balance" name="balance" style="text-align:right" readonly="readonly" data-name="balance" data-biz-name="balance"
					 autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.choBankFinance.balance')" value="$!{choBankFinancePage.balance}">
				</td>
			</tr>
			<tr>
				##金额
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
				<td>
					<div class="layui-input-inline">
						<input type="text" id="payMoney" name="payMoney" style="text-align:right" lay-verify="required" data-name="payMoney" data-biz-name="payMoney" data-toUp="payMoneyUp"
						 autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.nisBillhead.payMoney.lower')" value="$!{choBankFinancePage.payMoney}" data-min="${regularOnset}"
						 title="#springMessage('config.choBank.regularOnset')${regularOnset}#springMessage('config.choBank.moneyUnit')">
					</div>
				</td>
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
				<td style="padding-left:0px">
					<div id="payMoneyUp"></div>
				</td>
			</tr>
        	<tr>
				##起息日期
                <td class="textRight">#springMessage('table.choBankFinance.interestStartDate')</td>
                <td >
                    <div class="layui-input-inline">
                        <input type="text" id="interestStartDate" name="interestStartDate" data-name="interestStartDate" data-biz-name="interestStartDate" lay-verify="required"
							   value="$!{choBankFinancePage.interestStartDate}" class="layui-input bt-biz-dateType" data-type="date" data-endid="deadlineDate" data-callback="bt.interestStartDateCallback">
                    </div>
                </td>
        		##期限（活期转定期）：3个月、6个月、1年、2年、3年、5年
				<td class="textRight">#springMessage('table.choBankFinance.dayLimit')</td>
				<td >
					<div class="bt-biz-dict" data-type="select" data-required="true" data-value="$!{choBankFinancePage.dayLimit}$!{choBankFinancePage.dateUnit}"
							data-group="choBankFinance.dayLimit"  data-name="dayLimitSel" data-callback="bt.dayLimitCallback"></div>
				</td>
			</tr>
        	<tr>
				##到期日期
                <td class="textRight">#springMessage('table.choBankFinance.deadlineDate')</td>
                <td >
                    <div class="layui-input-inline">
                        <input type="text" id="deadlineDate" name="deadlineDate" data-name="deadlineDate" data-biz-name="deadlineDate" value="$!{choBankFinancePage.deadlineDate}" lay-verify="required" class="layui-input bt-biz-dateType" data-type="date">
                    </div>
                </td>
        		##到期处理方式 0-不处理 1-本金续存 2-本息续存
				<td class="textRight">#springMessage('table.choBankFinance.certificateWay')</td>
				<td >
					<div class="bt-biz-dict" data-type="select" data-required="true" data-value="$!{choBankFinancePage.certificateWay}"
							data-group="choBankFinance.certificateWay" data-name="certificateWay"></div>
				</td>
			</tr>
        	<tr>
				##是否上线
				<td class="textRight" width="20%">#springMessage('table.btBankAcc.isOnline')</td>
				<td>
					<div class="layui-inline" id="isOnlineDiv">
						<div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-required = "true" data-defaultvalue="$!{choBankFinancePage.isOnline}" data-name="isOnline"
							 data-biz-name="isOnline"></div>
					</div>
				</td>
        		##用途
				<td class="textRight">#springMessage('table.choBankFinance.purpose')</td>
				<td>
					<div class="layui-input-inline">
						<input type="hidden" id="purposeDef" value="$!{choBankFinancePage.purpose}">
						<select name="purpose" id="purpose" lay-verify="required" lay-search="" data-inputvalue="true">
							<option value=" "></option>
							<option value="inputText"></option>
						</select>
					</div>
				</td>
			</tr>
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
					<button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choBankFinanceCurrent2Time.edit.js?_btv=${resourceVersion}"></script>
</html>
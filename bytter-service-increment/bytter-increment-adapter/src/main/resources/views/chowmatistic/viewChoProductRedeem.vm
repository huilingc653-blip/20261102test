<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input id="billNo" name="billNo" type="hidden" value="$!{choProductRedeemPage.billNo}">
    <input id="busType" name="busType" type="hidden" value="$!{busType}">
    <div id="print">
        <table class="layui-table">
            <thead>
            <tr>
                <th colspan="4" style="text-align:center">理财赎回</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                ##单位
                <td class="textRight">#springMessage("table.choBankFinance.corpId")</td>
                <td width="35%">$!{choProductRedeemPage.corpName}</td>
                ##理财类型
                <td class="textRight">#springMessage("table.choProduct.financialType")</td>
                <td width="35%">$!{choProductRedeemPage.financialTypeName}</td>
            </tr>
            <tr>
                ##产品类型
                <td class="textRight">#springMessage("table.choProduct.productType")</td>
                <td width="35%">
                    $dictTag.get("cho.productType",$!{choProductRedeemPage.productType})
                </td>
                ##产品代码
                <td class="textRight">#springMessage("table.choProduct.productCode")</td>
                <td width="35%">$!{choProductRedeemPage.productCode}</td>
            </tr>
            <tr>
                ##产品名称
                <td class="textRight">#springMessage("table.choProduct.productName")</td>
                <td width="35%">$!{choProductRedeemPage.productName}</td>
                ##银行类别
                <td class="textRight">#springMessage("table.choProduct.bankTypeId")</td>
                <td width="35%">$!{choProductRedeemPage.bankTypeName}</td>
            </tr>
            <tr>
                ##购买银行
                <td class="textRight">#springMessage("table.choProductReq.bankName")</td>
                <td width="35%">$!{choProductRedeemPage.bankName}</td>
                ##币别
                <td class="textRight">#springMessage("table.choProduct.curId")</td>
                <td width="35%">$!{choProductRedeemPage.curName}</td>
            </tr>
            <tr>
                ##购买金额
                <td class="textRight">#springMessage("table.choProductReq.buyMoneyLow")</td>
                <td width="35%">
                    $!number.formatNumeric($!{choProductRedeemPage.buyMoney})
                    <input type="hidden" data-name="buyMoney" autocomplete="off"
                           class="layui-input bt-biz-moneyType" value="$!{choProductRedeemPage.buyMoney}">
                </td>
                ##理财账号
                <td class="textRight">#springMessage("table.choProductReq.bankAcc")</td>
                <td width="35%">$!{choProductRedeemPage.bankAcc}</td>
            </tr>
            <tr>
                ##购买日期
                <td class="textRight">#springMessage("table.choProductReq.buyDate")</td>
                <td width="35%">$!date.format('yyyy-MM-dd',$!{choProductRedeemPage.buyDate})</td>
                ##收益条款
                <td class="textRight">#springMessage("table.choProductReq.incomeClause")</td>
                <td width="35%">
                    $dictTag.get("choProduct.incomeClause",$!{choProductRedeemPage.incomeClause})
                </td>
            </tr>
            <tr>
                ##起息日期
                <td class="textRight">#springMessage("table.choProductReq.interestStartDate")</td>
                <td width="35%">$!date.format('yyyy-MM-dd',$!{choProductRedeemPage.interestStartDate})</td>
                ##到期日期
                <td class="textRight">#springMessage("table.choProductReq.deadlineDate")</td>
                <td width="35%">$!date.format('yyyy-MM-dd',$!{choProductRedeemPage.deadlineDate})</td>
            </tr>
            <tr>
                ##兑付日期
                <td class="textRight">#springMessage("table.choProductReq.cashDate")</td>
                <td width="35%">$!date.format('yyyy-MM-dd',$!{choProductRedeemPage.cashDate})</td>
                #if($!{choProductRedeemPage.financialType} eq '2')
                    ##购买日净值
                    <td class="textRight">#springMessage("table.choProductReq.dailyNetVal")</td>
                    <td width="35%">
                        <input type="text" data-name="dailyNetVal" data-biz-name="dailyNetVal" class="layui-input bt-biz-moneyType" data-decimal="6"
                               value="$!{choProductRedeemPage.dailyNetVal}" readonly>
                    </td>
                #else
                    ##参考收益率
                    <td class="textRight">#springMessage("table.choProductReq.referIncomeRate")</td>
                    <td width="35%">
                        $rateTag.show($!{choProductRedeemPage.referIncomeRate},6)
                    </td>
                #end
            </tr>
            <tr>
                #if($!{choProductRedeemPage.financialType} eq '2')
                    ##份额
                    <td class="textRight">#springMessage("table.choProductReq.portion")</td>
                    <td width="35%">
                        <input type="text" data-name="portion" data-biz-name="portion" class="layui-input bt-biz-moneyType" data-decimal="6"
                               value="$!{choProductRedeemPage.portion}" readonly>
                    </td>
                #else
                    ##参考收益
                    <td class="textRight">#springMessage("table.choProductReq.referIncomeMoney")</td>
                    <td width="35%">
                        $!number.formatNumeric($!{choProductRedeemPage.referIncomeMoney})
                    </td>
                #end
                ##资金来源
                <td class="textRight">#springMessage("table.choProductReq.capitalSource")</td>
                <td width="35%">$dictTag.get("choProduct.capitalSource",$!{choProductRedeemPage.capitalSource})</td>
            </tr>
            <tr>
                ##是否可提前赎回
                <td class="textRight">#springMessage("table.choProductReq.isMoveUp")</td>
                <td width="35%">
                    $dictTag.get("sf_yn",$!{choProductRedeemPage.isMoveUp})
                </td>
                #if($!{choProductRedeemPage.financialType} eq '0')
                    ##到期是否续存
                    <td class="textRight fType" >#springMessage("table.choProduct.isStore")</td>
                    <td class="fType" >
                        <label id="isStore">$dictTag.get("sf_yn",$!{choProductRedeemPage.isStore})</label>
                    </td>
                #end
            </tr>
            <tr class="fType" >
                #if($!{choProductRedeemPage.financialType} eq '0')
                    ##付息方式
                    <td class="textRight">#springMessage("table.cmsProvideLoanInfo.cplInterestPayment")</td>
                    <td>
                        <label id="payWay">$dictTag.get("financial.payWay",$!{choProductRedeemPage.payWay})</label>
                    </td>
                #end
                #if($!{choProductRedeemPage.financialType} ne '1')
                    ##收益类型
                    <td class="textRight">#springMessage("table.choProduct.incomeType")</td>
                    <td>
                        #if($dictTag.get("financial.type",$!{choProductRedeemPage.incomeType}) ne '')
                            $dictTag.get("financial.type",$!{choProductRedeemPage.incomeType})
                        #else
                            $!{choProductRedeemPage.incomeType}
                        #end
                    </td>
                #end
            </tr>
                #if($!{choProductRedeemPage.financialType} ne '1')
                <tr >
                    ##合同号
                    <td class="textRight">#springMessage("table.ratUrationApply.contactNo")</td>
                    <td>
                        <label id="contractNo">$!{choProductRedeemPage.contractNo}</label>
                    </td>
                    ##合同利率
                    <td class="textRight">#springMessage('table.choProductReq.contractRate')</td>
                    <td>
                        <label id="contractRate">
                            #if($!{choProductRedeemPage.endContractRate})
                                $rateTag.show($!{choProductRedeemPage.startContractRate},6)
                                ~
                                $rateTag.show($!{choProductRedeemPage.endContractRate},6)
                            #else
                                #if($!{choProductRedeemPage.startContractRate})
                                    $rateTag.show($!{choProductRedeemPage.startContractRate},6)
                                #end
                            #end
                        </label>

                    </td>
                </tr>
                #end
                #if($!{choProductRedeemPage.financialType} eq '2')
                    ##赎回日净值
                <td class="textRight">#springMessage("table.choProductReq.redeemDailyNetVal")</td>
                <td width="35%">
                    <input type="text" data-name="redeemDailyNetVal" data-biz-name="redeemDailyNetVal" class="layui-input bt-biz-moneyType" data-decimal="6"
                           value="$!{choProductRedeemPage.redeemDailyNetVal}" readonly>
                </td>
                    ##赎回份额
                <td class="textRight">#springMessage("table.choProductReq.redeemPortion")</td>
                <td width="35%">
                    <input type="text" data-name="redeemPortion" data-biz-name="redeemPortion" class="layui-input bt-biz-moneyType" data-decimal="6"
                           value="$!{choProductRedeemPage.redeemPortion}" readonly>
                </td>
                #end
            <tr>
                ##赎回金额(小写)
                <td class="textRight">#springMessage("table.choProductRedeem.redeemMoneyLow")</td>
                <td width="35%">
                    $!number.formatNumeric($!{choProductRedeemPage.redeemMoney})
                    <input type="hidden" data-name="redeemMoney" data-toUp="redeemMoneyUp" autocomplete="off"
                           class="layui-input bt-biz-moneyType" value="$!{choProductRedeemPage.redeemMoney}">
                </td>
                ##赎回金额(大写)
                <td class="textRight">#springMessage("table.choProductRedeem.redeemMoneyUpper")</td>
                <td width="35%">
                    <div id="redeemMoneyUp"></div>
                </td>
            </tr>
            <tr>
                ##赎回日期
                <td class="textRight">#springMessage("table.choProductRedeem.redeemDate")</td>
                <td width="35%">
                    $!date.format('yyyy-MM-dd',$!{choProductRedeemPage.redeemDate})
                </td>
                ##收益金额
                <td class="textRight">#springMessage("table.choProductRedeem.incomeMoney")</td>
                <td width="35%">
                    $!number.formatNumeric($!{choProductRedeemPage.incomeMoney})
                </td>
            </tr>
            <tr>
                ##到账日期
                <td class="textRight">#springMessage("table.choProductRedeem.transferDate")</td>
                <td width="35%">
                    $!date.format('yyyy-MM-dd',$!{choProductRedeemPage.transferDate})
                </td>
                #if($!{choProductRedeemPage.financialType} ne '2')
                    ##实际收益率
                    <td class="textRight">#springMessage("table.choProductRedeem.incomeRate")</td>
                    <td width="35%">
                        $rateTag.show($!{choProductRedeemPage.incomeRate},6)
                    </td>
                #end
            </tr>
            <tr>
                ##申购费
                <td class="textRight">#springMessage("table.choProductReq.subFeeMoney")</td>
                <td width="35%">
                    $!number.formatNumeric($!{choProductRedeemPage.subFeeMoney})
                </td>
                ##赎回费
                <td class="textRight">#springMessage("table.choProductRedeem.redeemChargeMoney")</td>
                <td width="35%">
                    $!number.formatNumeric($!{choProductRedeemPage.redeemChargeMoney})
                </td>
            </tr>
            <tr>
                ##其他手续费
                <td class="textRight">#springMessage("table.choProductReq.chargeMoney")</td>
                <td width="35%">
                    $!number.formatNumeric($!{choProductRedeemPage.chargeMoney})
                </td>
                ##备注
                <td class="textRight">#springMessage("table.choProduct.rmk")</td>
                <td colspan="3">$!{choProductRedeemPage.rmk}</td>
            </tr>
            </tbody>
        </table>
    </div>
    <!-- 日志 -->
    <div id="tagMsg"></div>
    <p>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn" onclick="bt.trackFlowByBusinessId('$!{choBankFinancePage.id}')">#springMessage('common.button.trackFlow')</button>
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form', 'layedit', 'moneyType', 'printType'], function () {
        var $ = bt.jquery, form = bt.form();
        var moneyType = bt.moneyType.init();
        var moneyFun = bt.moneyType.getFun();
        bt.printType.init();

        /**
         * 生成日志列表
         * @return
         */
            $genMsgHtml = function () {
            var url = basePath + "/chowmatistic/chomessage/list/" + $('#billNo').val() + "/" + $("#busType").val() + "?timestamp=" + new Date().getTime();
            $.ajax({
                url: url,
                method: 'GET',
                async: false,
                success: function (json) {
                    $("#tagMsg").html("");
                    $("#tagMsg").html(json);
                    form.render();
                }
            });
        }
            $genMsgHtml();
    });
</script>
</body>
</html>
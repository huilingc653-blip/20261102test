<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <input id="eqi_redeemStatus" name="eqi_redeemStatus" type="hidden">
        <input name="initType" type="hidden" value="0,1">
        <tr>
            ##单位名称
            <td class="textRight">#springMessage("table.choBankFinance.corpId")</td>
            <td width="20%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-tree-type="check"
                         data-resource="cho:productReq:choProductReq:bus:query"
                         data-scope="all"></div>
                </div>
            </td>
            ##理财类型
            <td class="textRight">#springMessage("table.choProduct.financialType")</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="mulselect" data-group="financial.type"
                     data-name="ins_financialType" data-biz-name="financialType" id="financialType" data-filterData="2"></div>
            </td>
            ##产品类型
            <td class="textRight">#springMessage("table.choProduct.productType")</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="mulselect" data-group="cho.productType"
                     data-name="ins_productType" data-biz-name="productType"></div>
            </td>
        </tr>
        <tr>
            ##产品代码
            <td class="textRight">#springMessage("table.choProduct.productCode")</td>
            <td width="20%">
                <div class="bt-biz-selectType" data-url="${basePath}/chowmatistic/choproduct/json"
                     data-name ="eqs_productCode" data-biz-name ="eqs_productCode"  data-valueField="productCode" data-textField="productCode"></div>
            </td>
            ##产品名称
            <td class="textRight">#springMessage("table.choProduct.productName")</td>
            <td width="20%">
                <div class="bt-biz-selectType" data-url="${basePath}/chowmatistic/choproduct/json"
                     data-name ="likes_productName" data-biz-name ="likes_productName"  data-valueField="productName" data-textField="productName"></div>

            </td>
            ##银行类别
            <td class="textRight">#springMessage("table.choProduct.bankTypeId")</td>
            <td width="20%">
                <div class="layui-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btbanktype/json" data-method="get"
                         data-name ="ins_bankTypeId" data-biz-name ="ins_bankTypeId"  data-valueField="id" data-textField="typeName"></div>
                </div>
            </td>
        </tr>
        <tr>
            ##购买金额
            <td class="textRight">#springMessage("table.choProductReq.buyMoney")</td>
            <td width="20%">
                <div class="layui-inline">
                    <input type="text" data-name="geg_buyMoney" name="geg_buyMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_buyMoney" name="leg_buyMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                </div>
            </td>
            ##到期日
            <td class="textRight">#springMessage("table.choProductReq.deadlineDate")</td>
            <td width="20%">
                <input type="text" name="ged_deadlineDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_deadlineDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_deadlineDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_deadlineDate">
            </td>
            ##状态
            <td class="textRight">#springMessage("table.choProductReq.status")</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="mulselect" data-group="choProduct.bizStatus" data-name="ins_bizStatus"
                     data-biz-name="eqi_bizStatus" id="eqi_bizStatus"></div>
            </td>
        </tr>
        <tr>
            ##金额单位
            <td class="textRight">#springMessage("table.choProductReq.moneyUnit")</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="radio" data-group="common.MoneyType"  data-biz-name="moneyUnit" data-name="moneyUnit"
                     data-defaultvalue="1"></div>
            </td>
            ##币别
            <td class="textRight">#springMessage("table.choProduct.curId")</td>
            <td width="20%">
                <div class="layui-inline">
                    <div class="bt-biz-mulselectType" data-url="${basePath}/basic/business/btcurrency/json" data-method="get"
                         data-name ="ins_curId" data-biz-name ="ins_curId"  data-valueField="id" data-textField="curName"></div>
                </div>
            </td>
            ##合同利率
            <td class="textRight">#springMessage('table.choProductReq.contractRate')</td>
            <td width="20%">
                <div class="layui-inline">
                    <input type="text" data-name="geg_startContractRate" name="geg_startContractRate"  data-max="100"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="startContractRate" placeholder="#springMessage('table.choProductReq.contractRate')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_startContractRate" name="leg_startContractRate" data-max="100"  data-min="0.0001"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="startContractRate" placeholder="#springMessage('table.choProductReq.contractRate')">
                </div>
            </td>
        </tr>
        <tr>
            ##合同号
            <td class="textRight">#springMessage("table.ratUrationApply.contactNo")</td>
            <td>
                <input type="text" name="likes_contractNo" id="contractNo" class="layui-input">
            </td>
            ##付息方式
            <td class="textRight">#springMessage("table.cmsProvideLoanInfo.cplInterestPayment")</td>
            <td>
                <div class="bt-biz-dict" data-type="mulselect" data-group="financial.payWay"
                     data-name="ins_payWay" data-biz-name="payWay"></div>
            </td>
            ##购买日期
            <td class="textRight">#springMessage("table.choProductReq.buyDate")</td>
            <td width="20%">
                <input type="text" name="ged_buyDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_buyDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_buyDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_buyDate">
            </td>
        </tr>
        <tr>
            ##起息日
            <td class="textRight">#springMessage("table.choBankFinance.interestStartDate")</td>
            <td width="20%">
                <input type="text" name="ged_interestStartDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_interestStartDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_interestStartDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_interestStartDate">
            </td>
            ##资金来源
            <td class="textRight">#springMessage("table.choProductReq.capitalSource")</td>
            <td>
                <div class="bt-biz-dict" data-type="mulselect" data-group="choProduct.capitalSource"
                     data-name="ins_capitalSourceStr" data-biz-name="capitalSourceStr"></div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary" onclick="resetProductType()">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width: 100%;">
    <thead>
    <tr>
        <th>#springMessage("table.choBankFinance.corpId")</th>
        <th>#springMessage("table.choProduct.bankTypeId")</th>
        <th>#springMessage("table.choProductReq.bankName")</th>
        <th>#springMessage("table.choProduct.financialType")</th>
        <th>#springMessage("table.choProduct.productCode")</th>
        <th>#springMessage("table.choProduct.productName")</th>
        <th>#springMessage("table.choProduct.productType")</th>
        <th>#springMessage("table.choProductReq.incomeClause")</th>
        <th>#springMessage("table.choProduct.incomeType")</th>
        <th>#springMessage("table.choProductReq.bankAcc")</th>
        <th>#springMessage("table.choProductReq.buyMoney")</th>
        <th>#springMessage("table.choProduct.curId")</th>
        <th>#springMessage("table.choProductRedeem.redeemDate")</th>
        <th>#springMessage("table.choProductQuery.redeemedMoney")</th>
        <th>#springMessage("table.choProductQuery.waitRedeemMoney")</th>
        <th>#springMessage("table.choProductReq.buyDate")</th>
        <th>#springMessage("table.choProductReq.interestStartDate")</th>
        <th>#springMessage("table.choProductReq.deadlineDate")</th>
        <th>#springMessage("table.choProductReq.dayLimit")</th>
        <th>#springMessage("table.choProductReq.referIncomeRate")</th>
        <th>#springMessage("table.choProductReq.referIncomeMoney")</th>
        <th>#springMessage("table.choProductQuery.averageIncomeRate")</th>
        <th>#springMessage("table.choProductRedeem.incomeRate")</th>
        <th>#springMessage("table.choProductRedeem.incomeMoney")</th>
        <th>#springMessage("table.choProductQuery.subMoney")</th>
        <th>#springMessage("table.choProductReq.subFeeMoneyRedeem")</th>
        <th>#springMessage("table.choProductRedeem.redeemChargeMoney")</th>
        <th>#springMessage("table.choProductReq.chargeMoneyRedeem")</th>
        <th>#springMessage("table.cmsProvideLoanInfo.cplInterestPayment")</th>
        <th>#springMessage("table.ratUrationApply.contactNo")</th>
        <th>#springMessage("table.choProductReq.contractRate")</th>
        <th>#springMessage("table.choProductReq.isMoveUp")</th>
        <th>#springMessage("table.choProductReq.capitalSource")</th>
        <th>#springMessage("table.choProductReq.status")</th>
        <th>#springMessage("common.table.thead.operation")</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
    <script src="${basePath}/static/modules/chowmatistic/choProductReqQuery.list.js?_btv=${resourceVersion}"></script>
</html>
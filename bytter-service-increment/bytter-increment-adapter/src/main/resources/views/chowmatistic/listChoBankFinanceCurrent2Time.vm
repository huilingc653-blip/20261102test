<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<input id="busType" name="busType" type="hidden" value="$!{busType}">
	<table class="layui-table">
        <tbody>
            <tr>
                ##单位
                <td class="textRight">#springMessage('table.choBankFinance.corpId')</td>
                <td>
                    <div class="layui-inline">
                    	<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-name="likes_corpId"
                            data-scope="all"
							data-resource="cho:bankFinanceC2T:choBankFinance:query"
							data-callback="bt.corpCallback"></div>
                    </div>
                </td>
				##付款账号
                <td class="textRight">#springMessage('table.choBankFinance.currentAcc')</td>
                <td>
					<div class="layui-input-inline">
                        <input type="text" name="likes_payerAcc" id="payerAcc" data-biz-name="payerAcc"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.choBankFinance.currentAcc')">
    					<table id="payerAccTable" class="hide">
    						<thead>
    							<tr>
    								<th>#springMessage('table.choBankFinance.acc')</th>
    								<th>#springMessage('table.choBankFinance.accName')</th>
    								<th>#springMessage('table.choBankFinance.accBank')</th>
    								<th>#springMessage('table.choBankFinance.curId')</th>
    							</tr>
    						</thead>
    					</table>
					</div>
                </td>
                ##状态
                <td class="textRight">#springMessage('table.choBankFinance.status')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-displayData="0,-1" 
							data-group="choBankFinance.status" data-name="eqi_status"></div>
                </td>
            </tr>
            <tr>
                <td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </tbody>
    </table>
</form>	
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.choBankFinance.billNo')</th>
        <th>#springMessage('table.choBankFinance.currentAcc')</th>
		<th>#springMessage('table.choBankFinance.corpId')</th>
        <th>#springMessage('table.choBankFinance.curId')</th>
        <th>#springMessage('table.choBankFinance.payMoney')</th>
        <th>#springMessage('table.choBankFinance.interestRate')</th>
        <th>#springMessage('table.choBankFinance.interestStartDate')</th>
        <th>#springMessage('table.choBankFinance.deadlineDate')</th>
        <th>#springMessage('table.btBankAcc.isOnline')</th>
        <th>#springMessage('table.choBankFinance.purpose')</th>
        <th>#springMessage('table.choBankFinance.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead> 
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choBankFinanceCurrent2Time.list.js?_btv=${resourceVersion}"></script>
</html>

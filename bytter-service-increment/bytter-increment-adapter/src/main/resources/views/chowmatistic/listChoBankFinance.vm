<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input id="loginName" name="loginName" type="hidden" value="$shiro.getPrincipal().loginName">
	<table class="layui-table">
        <tbody>
            <tr>
                ##单位
                <td class="textRight">#springMessage('table.choBankFinance.corpId')</td>
                <td>
                    <div class="layui-inline">
                    	<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-name="likes_corpId"
                            data-scope="all"
							data-resource="cho:bankFinance:choBankFinance:query"
							data-callback="bt.corpCallback"></div>
                    </div>
                </td>
				##付款账号
                <td class="textRight">#springMessage('table.choBankFinance.payerAcc')</td>
                <td>
					<div class="layui-input-inline">
                        <input type="text" name="likes_payerAcc" id="payerAcc" data-biz-name="payerAcc"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.choBankFinance.payerAcc')">
    					<table id="payerAccTable" class="hide">
    						<thead>
    							<tr>
    								<th>#springMessage('table.choBankFinance.acc')</th>
    								<th>#springMessage('table.choBankFinance.accName')</th>
    								<th>#springMessage('table.choBankFinance.accBank')</th>
    								<th>#springMessage('table.choBankFinance.curId')</th>
    							</tr>
    						</thead>
    					</table>
					</div>
                </td>
                ##创建日期
                <td class="textRight">#springMessage('table.nisBillhead.createDate')</td>
                <td>
                    <input type="text" name="ged_createDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_createDate" >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_createDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_createDate">
                </td>
            </tr>
			<tr>
                ##业务类型
                <td class="textRight">#springMessage('table.choBankFinance.busType')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" 
							data-group="choBankFinance.busType" data-name="eqi_busType"></div>
                </td>
                ##收款账号
                <td class="textRight">#springMessage('table.choBankFinance.payeeAcc')</td>
                <td>
                    <input type="text" name="likes_payeeAcc"
                        autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.choBankFinance.payeeAcc')">
                </td>
				##金额
                <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" data-name="geg_payMoney"
                            autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')" data-moneyendid="t2">
                    </div>
                    <span class="date-mid">~</span>
                    <div class="layui-inline">
                        <input type="text" data-name="leg_payMoney"
                            autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')" id="t2">
                    </div>
                </td>
            </tr>
			<tr>
                ##状态
                <td class="textRight">#springMessage('table.choBankFinance.status')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select"
							data-group="choBankFinance.status" data-name="eqi_status"></div>
                </td>
				##交易状态
                <td class="textRight">#springMessage('table.bisExc.voucherStat')</td>
                <td>
					<div class="bt-biz-dict" data-type="select" data-group="bisExc.voucherStat" data-name="eqs_voucherStat"></div>
                </td>
                ##是否上线
                <td class="textRight">#springMessage('table.btBankAcc.isOnline')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-name="eqs_isOnline"></div>
                </td>
            </tr>
##            <tr>
##                <td></td>
##                <td>
##                    <div class="layui-input-inline" id="payeeBankCodeDiv">
##                        <input type="text" id="payeeSwiftCode" name="payeeSwiftCode" readonly="readonly" style="width:300px;"
##                               autocomplete="off" class="layui-input" placeholder="#springMessage('common.button.select')">
##                        <div class="bt-div-search">
##                            <button class="bt-biz-choProductRedeem"  type="button"  data-callback="bt.choProductRedeemCallback" title="#springMessage('common.button.select')">
##                                <i class="layui-icon">&#xe615;</i>
##                            </button>
##                        </div>
##                    </div>
##                </td>
##                <td></td>
##                <td>
##                    <div class="layui-input-inline" id="payeeBankCodeDiv">
##                        <input type="text" id="bankFinance" name="bankFinance" readonly="readonly" style="width:300px;"
##                               autocomplete="off" class="layui-input" placeholder="#springMessage('common.button.select')">
##                        <div class="bt-div-search">
##                            <button class="bt-biz-mulSelectBankFinancePage"  type="button"  data-callback="bt.bankFinanceCallback" title="#springMessage('common.button.select')">
##                                <i class="layui-icon">&#xe615;</i>
##                            </button>
##                        </div>
##                    </div>
##                </td>
##            </tr>
            <tr>
                <td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </tbody>
    </table>
</form>	
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.choBankFinance.billNo')</th>
		<th>#springMessage('table.choBankFinance.corpId')</th>
		<th>#springMessage('table.choBankFinance.busType')</th>
		<th>#springMessage('table.choBankFinance.payerAcc')</th>
		<th>#springMessage('table.choBankFinance.payerAccName')</th>
		<th>#springMessage('table.choBankFinance.payerBank')</th>
        <th>#springMessage('table.choBankFinance.curId')</th>
		<th>#springMessage('table.choBankFinance.dayLimit')</th>
        <th>#springMessage('table.choBankFinance.payMoney')</th>
		<th>#springMessage('table.choBankFinance.payeeAcc')</th>
        <th>#springMessage('table.btBankAcc.isOnline')</th>
		<th>#springMessage('table.choBankFinance.status')</th>
		<th>#springMessage('table.bisFinanceExc.voucherStat')</th>
        <th>#springMessage('table.fcInitAcc.operator')</th>
        <th>#springMessage('table.choBankFinance.createDate')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead> 
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choBankFinance.list.js?_btv=${resourceVersion}"></script>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <table class="layui-table layui-form">
        <thead>
        <tr>
            <th>#springMessage('table.choBankFinance.billNo')</th>
            <th>#springMessage('table.choBankFinance.corpId')</th>
            <th>#springMessage('table.choBankFinance.busType')</th>
            <th>#springMessage('table.choBankFinance.payerAcc')</th>
            <th>#springMessage('table.choBankFinance.payerAccName')</th>
            <th>#springMessage('table.choBankFinance.payerBank')</th>
            <th>#springMessage('table.choBankFinance.curId')</th>
            <th>#springMessage('table.choBankFinance.dayLimit')</th>
            <th>#springMessage('table.choBankFinance.payMoney')</th>
            <th>#springMessage('table.choBankFinance.payeeAcc')</th>
        </tr>
        </thead>
		<tbody >
			#if($!infoList)
    		#foreach($info in $infoList)
			<tr>
				<td>$!{info.billNo}</td>
				<td>$!{info.corpName}</td>
				<td>$dictTag.get("choBankFinance.busType",$!{info.busType})</td>
				<td>$!{info.payerAcc}</td>
				<td>$!{info.payerAccName}</td>
				<td>$!{info.payerBank}</td>
				<td>$!{info.curName}</td>
				<td>$!{info.dayLimit}$dictTag.get("choBankFinance.dateUnit",$!{info.dateUnit})</td>
				<td>$!number.formatNumeric($!{info.payMoney})</td>
                <td>$!{info.payeeAcc}</td>
			</tr>
            #end
            #end
        </tbody>
    </table>
#parse("views/common/footer.vm")
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post" id="inputForm">
    <table class="layui-table">
        <input id="status" name="status" type="hidden" value="0">
        <input id="reqId" name="reqId" type="hidden" value="">
        <input id="dayLimit" name="dayLimit" type="hidden" value="">
        <input id="incomeClause" name="incomeClause" type="hidden" value="">
        <input id="financialType" name="financialType" type="hidden" value="">
        <tbody>
        <tr>
            ##单位名称
            <td class="textRight" width="14%">#springMessage("table.choBankFinance.corpId")</td>
            <td width="36%">
                <input type="hidden" class="layui-input text" id="corpId" name="corpId" value="">
                <span id="showName"></span>
            </td>
            ##理财类型
            <td class="textRight" width="14%">#springMessage("table.choProduct.financialType")</td>
            <td width="36%">
                <div class="layui-input-inline">
                    <label id="financialTypeName">$!{choProductRedeemPage.financialTypeName}</label>
                </div>
            </td>
        </tr>
        <tr>
            ##产品类型
            <td class="textRight">#springMessage("table.choProduct.productType")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="cho.productType" data-defaultvalue="" data-required="true"
                     data-name="productType" data-biz-name="productType" id="productType" data-disabled="true"></div>
            </td>
            ##产品代码
            <td class="textRight">#springMessage("table.choProduct.productCode")</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="productCode" name="productCode" lay-verify="required" readonly
                           autocomplete="off" class="layui-input text" placeholder="#springMessage("table.choProduct.productCode")">
                </div>
                <div class="layui-input-inline">
                    <button class="layui-btn bt-biz-choProduct" id="selProductBut" type="button" data-callback="callbackProduct">#springMessage('common.button.select')</button>
                </div>
            </td>
        </tr>
        <tr>
            ##产品名称
            <td class="textRight">#springMessage("table.choProduct.productName")</td>
            <td>
                <label id="productName"></label>
            </td>
            ##银行类别
            <td class="textRight" width="14%">#springMessage("table.choProduct.bankTypeId")</td>
            <td width="36%">
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json" data-required="true"
                     data-name ="bankTypeId" data-biz-name ="bankTypeId"  data-valueField="id" data-textField="typeName"
                     data-disabled="true"></div>
            </td>
        </tr>
        <tr>
            ##购买银行
            <td class="textRight">#springMessage("table.choProductReq.bankName")</td>
            <td>
                <label id="bankName"></label>
            </td>
            ##币别
            <td class="textRight">#springMessage("table.choProduct.curId")</td>
            <td>
                <label id="curName"></label>
            </td>
        </tr>
        <tr>
            ##购买金额(小写)
            <td class="textRight">#springMessage("table.choProductReq.buyMoneyLow")</td>
            <td>
                <label id="buyMoney"></label>
                <input type="hidden" id="buyMoneyVal">
            </td>
            ##理财账号
            <td class="textRight">#springMessage("table.choProductReq.bankAcc")</td>
            <td>
                <label id="bankAcc"></label>
            </td>
        </tr>
        <tr>
            ##购买日期
            <td class="textRight">#springMessage("table.choProductReq.buyDate")</td>
            <td>
                <label id="buyDate"></label>
            </td>
            ##收益条款
            <td class="textRight">#springMessage("table.choProductReq.incomeClause")</td>
            <td>
                <label id="incomeClauseShow"></label>
            </td>
        </tr>
        <tr>
            ##起息日期
            <td class="textRight">#springMessage("table.choProductReq.interestStartDate")</td>
            <td>
                <label id="interestStartDate"></label>
            </td>
            ##期限
            <td class="textRight">#springMessage("table.choProductReq.dayLimit")</td>
            <td>
                <label id="dayLimitShow"></label>
            </td>
        </tr>
        <tr>
            ##兑付日期
            <td class="textRight">#springMessage("table.choProductReq.cashDate")</td>
            <td>
                <label id="cashDate"></label>
            </td>
            ##到期日期
            <td class="textRight">#springMessage("table.choProductReq.deadlineDate")</td>
            <td>
                <label id="deadlineDate"></label>
            </td>
        </tr>
        <tr>
            ##申购费
            <td class="textRight">#springMessage("table.choProductReq.subFeeMoney")</td>
            <td width="35%">
                <label id="reqSubFeeMoney">$!number.formatNumeric($!{choProductRedeemPage.reqSubFeeMoney})</label>
            </td>
            ##其他手续费
            <td class="textRight">#springMessage("table.choProductReq.chargeMoney")</td>
            <td width="35%">
                <label id="reqChargeMoney">$!number.formatNumeric($!{choProductRedeemPage.reqChargeMoney})</label>
            </td>
        </tr>
        <tr>
            ##参考收益率
            <td class="textRight isShowReferIncome">#springMessage("table.choProductReq.referIncomeRate")</td>
            <td width="40%" class="isShowReferIncome">
                <label id="referIncomeRate"></label>
            </td>
            ##购买日净值
            <td class="textRight isShowDaily" style="display: none">#springMessage("table.choProductReq.dailyNetVal")</td>
            <td width="35%"  class="isShowDaily" style="display: none">
                <input type="text" data-name="dailyNetVal" data-biz-name="dailyNetVal" class="layui-input bt-biz-moneyType" data-decimal="6"
                       placeholder="#springMessage("table.choProductReq.dailyNetVal")" readonly>
            </td>
            ##资金来源
            <td class="textRight">#springMessage("table.choProductReq.capitalSource")</td>
            <td>
                <label id="capitalSource">$dictTag.get("choProduct.capitalSource",$!{choProductRedeemPage.capitalSource})</label>
            </td>
        </tr>
        <tr>
            ##参考收益
            <td class="textRight isShowReferIncome">#springMessage("table.choProductReq.referIncomeMoney")</td>
            <td class="isShowReferIncome">
                <label id="referIncomeMoney"></label>
            </td>
            ##份额
            <td class="textRight isShowDaily" style="display: none">#springMessage("table.choProductReq.portion")</td>
            <td class="isShowDaily" style="display: none">
                <input type="text" id="portion" name="portion" style="text-align:right" data-name="portion" data-biz-name="portion" data-decimal="6"
                       autocomplete="off" class="layui-input bt-biz-moneyType" readonly>
            </td>
            ## 可赎回金额
            <td class="textRight showLeftMoney">#springMessage("cho.product.redeem.leftMoney")</td>
            <td class="showLeftMoney"><label id="leftMoney"></label></td>
            <input type="hidden" id="leftMoneyVal">
        </tr>
        <tr>
            ##是否可提前赎回
            <td class="textRight">#springMessage("table.choProductReq.isMoveUp")</td>
            <td width="35%">
                <label id="isMoveUp">$dictTag.get("sf_yn",$!{choProductRedeemPage.isMoveUp})</label>
            </td>
            ## 可赎回本金
            <td class="textRight redeemableMoneyTd" style="display: none">#springMessage("cho.product.redeemable.money")</td>
            <td class="redeemableMoneyTd"><label id="redeemableMoney"></label></td>
            <input type="hidden" id="redeemableMoneyVal">
            ##到期是否续存
            <td class="textRight fType"  style="display: none">#springMessage("table.choProduct.isStore")</td>
            <td class="fType"  style="display: none">
                <label id="isStore">$dictTag.get("sf_yn",$!{choProductRedeemPage.isStore})</label>
            </td>
        </tr>
        <tr >
            ##付息方式
            <td class="textRight fType" style="display: none">#springMessage("table.cmsProvideLoanInfo.cplInterestPayment")</td>
            <td class="fType" style="display: none">
                <label id="payWay">$dictTag.get("financial.payWay",$!{choProductRedeemPage.payWay})</label>
            </td>
            ##收益类型
            <td class="textRight fType fType2" style="display: none">#springMessage("table.choProduct.incomeType")</td>
            <td class="fType fType2" style="display: none">
                <label id="incomeType">
                    #if($dictTag.get("financial.type",$!{choProductRedeemPage.incomeType}) ne '')
                            $dictTag.get("financial.type",$!{choProductRedeemPage.incomeType})
                        #else
                        $!{choProductRedeemPage.incomeType}
                    #end
                </label>
            </td>
            ##是否维护日净值
            <td class="textRight showIsMaintainVal"  style="display: none">#springMessage("table.choProductReq.isMaintainVal")</td>
            <td class="showIsMaintainVal"  style="display: none">
                <label id="isMaintainVal">$dictTag.get("sf_yn",$!{choProductRedeemPage.isMaintainVal})</label>
            </td>
        </tr>
        <tr class="fType fType2" style="display: none">
            ##合同号
            <td class="textRight">#springMessage("table.ratUrationApply.contactNo")</td>
            <td>
                <label id="contractNo">$!{choProductRedeemPage.contractNo}</label>
            </td>
            ##合同利率
            <td class="textRight">#springMessage('table.choProductReq.contractRate')</td>
            <td>
                <label id="contractRate">
                    #if($!{choProductRedeemPage.endContractRate})
                        $rateTag.show($!{choProductRedeemPage.startContractRate},6)
                        ~
                        $rateTag.show($!{choProductRedeemPage.endContractRate},6)
                    #else
                        #if($!{choProductRedeemPage.startContractRate})
                            $rateTag.show($!{choProductRedeemPage.startContractRate},6)
                        #end
                    #end
                </label>

            </td>
        </tr>
        <tr>
            ##赎回日净值
            <td class="textRight isShowRedeem" style="display: none">#springMessage("table.choProductReq.redeemDailyNetVal")</td>
            <td width="40%" class="isShowRedeem" style="display: none">
                <input type="text" id="redeemDailyNetVal" name="redeemDailyNetVal"  data-name="redeemDailyNetVal" data-biz-name="redeemDailyNetVal" class="layui-input bt-biz-moneyType" data-decimal="6"
                       placeholder="#springMessage("table.choProductReq.redeemDailyNetVal")" lay-verify="required" data-callback="redeemDailyNetValCallback">
            </td>
            ##赎回份额
            <td class="textRight isShowRedeem" style="display: none">#springMessage("table.choProductReq.redeemPortion")</td>
            <td class="isShowRedeem" style="display: none">
                <input type="text" id="redeemPortion" name="redeemPortion" style="text-align:right" data-name="redeemPortion" data-biz-name="redeemPortion" data-decimal="6"
                       autocomplete="off" class="layui-input bt-biz-moneyType" lay-verify="required" data-callback="redeemPortionCallback">
            </td>
            <input type="hidden" id="maxRedeemPortion">
        </tr>
        <tr>
            ##赎回金额(小写)
            <td class="textRight"><span class="redeemMoneyTd1">#springMessage("table.choProductRedeem.redeemMoneyLow")</span></td>
            <td>
                <input type="text" id="redeemMoney" name="redeemMoney" style="text-align:right" lay-verify="required" data-name="redeemMoney" data-biz-name="redeemMoney" data-toUp="redeemMoneyUp"
                       autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage("table.choProductRedeem.redeemMoney")" data-callback="redeemMoneyCallback">
            </td>
            ##赎回金额(大写)
            <td class="textRight redeemMoneyTd2">#springMessage("table.choProductRedeem.redeemMoneyUpper")</td>
            <td>
                <div id="redeemMoneyUp"></div>
            </td>
        </tr>
        <tr>
            ##赎回日期
            <td class="textRight">#springMessage("table.choProductRedeem.redeemDate")</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="redeemDate" name="redeemDate" data-name="redeemDate" data-biz-name="redeemDate" lay-verify="required"
                           class="layui-input bt-biz-dateType" data-today="true" data-type="date" data-callback="redeemDateCallback">
                </div>
                <div class="layui-input-inline" id="lastRedeemDateShow" style="display: none">
                    <label style="color: rgb(184,184,184)">&nbsp;&nbsp;上次赎回日期:</label>
                    <label id="lastRedeemDate" style="color: rgb(184,184,184)"></label>
                </div>
            </td>
            ##收益金额
            <td class="textRight">#springMessage("table.choProductRedeem.incomeMoney")</td>
            <td>
                <input type="text" id="incomeMoney" name="incomeMoney" style="text-align: right;" lay-verify="required" data-name="incomeMoney"
                       data-decimal="2" data-minus="true"
                       data-biz-name="incomeMoney" autocomplete="off" class="layui-input bt-biz-moneyType" data-callback="incomeMoneyCallback">
                <input hidden id="incomeMoneyMax">
            </td>
        </tr>
        <tr>
            ##到账日期
            <td class="textRight">#springMessage("table.choProductRedeem.transferDate")</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="transferDate" name="transferDate" data-name="transferDate" data-biz-name="transferDate" lay-verify="required"
                           class="layui-input bt-biz-dateType" data-today="true" data-type="date">
                </div>
            </td>
            ##实际收益率
            <td class="textRight isShowReferIncome">#springMessage("table.choProductRedeem.incomeRate")</td>
            <td class="isShowReferIncome">
                <input type="text" data-name="incomeRate" data-biz-name="incomeRate" class="layui-input bt-biz-rateType" data-decimal="6"
                       placeholder="#springMessage("table.choProductRedeem.incomeRate")" lay-verify="required" data-callback="bt.incomeRateCallback">

            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight">#springMessage("table.choProduct.rmk")</td>
            <td colspan="3">
                <textarea type="text" id="rmk" name="rmk" class="layui-textarea" placeholder="#springMessage("table.choProduct.rmk")"></textarea>
            </td>
        </tr>

        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="11">#springMessage('common.button.submit')</button>
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="0">#springMessage('common.button.temp')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button type="button" class="layui-btn" onclick="closeTab()">#springMessage('common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
    <table class="layui-table layui-form dark-layui-table layui-table-border">
        <thead>
            <th>#springMessage("table.choProductReq.subFeeMoney")</th>
            <th>#springMessage("table.choProductRedeem.redeemChargeMoney")</th>
            <th>#springMessage("table.choProductReq.chargeMoney")</th>
        </thead>
        <tbody>
            <tr>
                <td style="text-align: center;">
                    <input name="subFeeMoney" style="width: 90%; height: 22px;" class="layui-input bt-biz-moneyType">
                </td>
                <td style="text-align: center;">
                    <input name="redeemChargeMoney" style="width: 90%; height: 22px;" class="layui-input bt-biz-moneyType">
                </td>
                <td style="text-align: center;">
                    <input name="chargeMoney" style="width: 90%; height: 22px;" class="layui-input bt-biz-moneyType">
                </td>
            </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choProductRedeem.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{choBankFinancePage.id}">
		<input id="interestRateDef" type="hidden" value="$!{choBankFinancePage.interestRate}"  >
		<input id="calculationRule" name="calculationRule" type="hidden" value="$!{choBankFinancePage.calculationRule}">
		<input type="hidden" id="interestStartDate" name="interestStartDate" data-name="interestStartDate" data-biz-name="interestStartDate"
			   value="$!{choBankFinancePage.interestStartDate}" class="layui-input bt-biz-dateType" data-type="date" />
		<input type="hidden" id="deadlineDate" name="deadlineDate" data-name="deadlineDate" data-biz-name="deadlineDate"
			   value="$!{choBankFinancePage.deadlineDate}" class="layui-input bt-biz-dateType" data-type="date" />
		<input id="corpId"  type="hidden" value="$!{choBankFinancePage.corpId}">
		<input id="bankTypeId"  type="hidden" value="$!{bankTypeId}">
		<input id="bankName"  type="hidden" value="$!{bankName}">

		<table class="layui-table">
			<thead>
            <tr>
                <th colspan="4" style="text-align:center">$dictTag.get("choBankFinance.busType",$!{choBankFinancePage.busType})</th>
			</tr>
			</thead>
			<tbody>
			<tr>
        		##业务单号
				<td class="textRight">#springMessage('table.choBankFinance.billNo')</td>
				<td width="35%">$!{choBankFinancePage.billNo}</td>
				<td class="textRight">#springMessage('table.choBankFinance.createDate')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{choBankFinancePage.createDate})</td>				
        	</tr>
        	<tr>
        		##单位
				<td class="textRight">#springMessage('table.choBankFinance.corpId')</td>
				<td width="35%">$!{choBankFinancePage.corpName}</td>
        		##付款账号
				<td class="textRight">
					#if($!{choBankFinancePage.busType} == 10 || $!{choBankFinancePage.busType} == 12)
						#springMessage('table.choBankFinance.currentAcc')
					#elseif($!{choBankFinancePage.busType} == 11)
						#springMessage('table.choBankFinance.tiemAcc')	
					#elseif($!{choBankFinancePage.busType} == 13)
						#springMessage('table.choBankFinance.noticeAcc')
					#end
				</td>
				<td width="35%">$!{choBankFinancePage.payerAcc}</td>
        	</tr>
			#if($!{choBankFinancePage.busType} == 10 || $!{choBankFinancePage.busType} == 12)
			<tr>
        		##利率
				<td class="textRight">#springMessage('table.choBankFinance.interestRate')</td>
				<td width="35%">
					$!rateTag.show($!{choBankFinancePage.interestRate})
				</td>
        		##账户余额
				<td class="textRight">#springMessage('table.choBankFinance.balance')</td>
				<td width="35%">
					$!number.formatNumeric($!{choBankFinancePage.balance})
				</td>
        	</tr>	
			<tr>
        		##金额
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
                <td width="35%">
					$!number.formatNumeric($!{choBankFinancePage.payMoney})
					<input type="hidden" data-name="payMoney" data-toUp="payMoneyUp" autocomplete="off" 
						class="layui-input bt-biz-moneyType" value="$!{choBankFinancePage.payMoney}">
				</td>
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
				<td width="35%" style="padding-left:0px"><div id="payMoneyUp"></div></td>
        	</tr>
    			#if($!{choBankFinancePage.busType} == 10)
    			<tr>
					##起息日期
                    <td class="textRight">#springMessage('table.choBankFinance.interestStartDate')</td>
                    <td width="35%">$!date.format('yyyy-MM-dd',$!{choBankFinancePage.interestStartDate})</td>
    				##期限
    				<td class="textRight">#springMessage('table.choBankFinance.dayLimit')</td>
    				<td width="35%">$!{choBankFinancePage.dayLimit}$dictTag.get("choBankFinance.dateUnit",$!{choBankFinancePage.dateUnit})</td>
            	</tr>
    			<tr>
					##到期日期
                    <td class="textRight">#springMessage('table.choBankFinance.deadlineDate')</td>
                    <td width="35%">$!date.format('yyyy-MM-dd',$!{choBankFinancePage.deadlineDate})</td>
            		##到期处理方式
    				<td class="textRight">#springMessage('table.choBankFinance.certificateWay')</td>
    				<td width="35%">$dictTag.get("choBankFinance.certificateWay",$!{choBankFinancePage.certificateWay})</td>
            	</tr>
    			<tr>
					##是否上线
					<td class="textRight" width="20%">#springMessage('table.btBankAcc.isOnline')</td>
					<td>$dictTag.get("sf_yn",$!{choBankFinancePage.isOnline})</td>
            		##用途
    				<td class="textRight">#springMessage('table.choBankFinance.purpose')</td>
    				<td>$!{choBankFinancePage.purpose}</td>
            	</tr>
    			#else
    			<tr>
					##起息日期
                    <td class="textRight">#springMessage('table.choBankFinance.interestStartDate')</td>
                    <td width="35%">$!date.format('yyyy-MM-dd',$!{choBankFinancePage.interestStartDate})</td>
					##到期日期
					<td class="textRight">#springMessage('table.choBankFinance.deadlineDate')</td>
					<td width="35%">$!date.format('yyyy-MM-dd',$!{choBankFinancePage.deadlineDate})</td>
            	</tr>
				<tr>
					##期限
                    <td class="textRight">#springMessage('table.choBankFinance.noticeDayLimit')</td>
                    <td width="35%">$!{choBankFinancePage.dayLimit}$dictTag.get("choBankFinance.dateUnit",$!{choBankFinancePage.dateUnit})</td>
            		##用途
    				<td class="textRight">#springMessage('table.choBankFinance.purpose')</td>
    				<td width="35%">$!{choBankFinancePage.purpose}</td>
            	</tr>
				<tr>
					##是否上线
					<td class="textRight" width="20%">#springMessage('table.btBankAcc.isOnline')</td>
					<td colspan="3">$dictTag.get("sf_yn",$!{choBankFinancePage.isOnline})</td>
				</tr>
				#end
			#end
			</tbody>
			<thead>
            <tr>
                <th colspan="4" style="text-align:center">#springMessage('table.choBankFinance.bl')</th>
			</tr>
			</thead>
			<tr>
        		##补录单号
				<td class="textRight">#springMessage('table.choBankFinance.bankBillNo')</td>
				<td>
					<input type="text" id="bankBillNo" name="bankBillNo"
							 autocomplete="off" class="layui-input text" placeholder="#springMessage('table.choBankFinance.bankBillNo')">
				</td>
				##补录利率
				<td class="textRight">#springMessage('table.choBankFinance.blInterestRate')</td>
				<td >
					<input type="text" id="blInterestRate" name="blInterestRate" lay-verify="required" value="$!{choBankFinancePage.interestRate}" data-callback="bt.blInterestRate"
						   autocomplete="off" class="layui-input bt-biz-rateType" placeholder="#springMessage('table.choBankFinance.blInterestRate')">
				</td>
        	</tr>
			<tr>
				##利息
				<td class="textRight">#springMessage('table.choBankFinance.blInterest')</td>
				<td>
					<div class="layui-input-inline">
						<input type="text" id="blInterest" name="blInterest" style="text-align:right" lay-verify="required" data-name="blInterest" data-biz-name="blInterest" value="$!{choBankFinancePage.anticInterest}"
						 autocomplete="off" class="layui-input bt-biz-moneyType"   placeholder="#springMessage('table.choBankFinance.blInterest')" />
					</div>
				</td>
				##定期账号/通知账号
				<td class="textRight">
					#if($!{choBankFinancePage.busType} == 10)
						#springMessage('table.choBankFinance.timeAcc')
					#end
					#if($!{choBankFinancePage.busType} == 12)
						#springMessage('table.choBankFinance.noticeAcc')
					#end
				</td>
				<td>
					#if($!{choBankFinancePage.busType} == 10)
						<input type="text" id="payeeAcc" name="payeeAcc" data-biz-name="payeeAcc"
							   autocomplete="off" class="layui-input bankAcc" placeholder="#springMessage('table.choBankFinance.timeAcc')">
						<input id="accType"  type="hidden" value="02">
						<table id="payeeAccTable" class="hide">
							<thead>
							<tr>
								<th>#springMessage('table.choBankFinance.acc')</th>
								<th>#springMessage('table.choBankFinance.accName')</th>
								<th>#springMessage('table.choBankFinance.accBank')</th>
								<th>#springMessage('table.choBankFinance.curId')</th>
							</tr>
							</thead>
						</table>
					#end
					#if($!{choBankFinancePage.busType} == 12)
						<input type="text" id="payeeAcc" name="payeeAcc" data-biz-name="payeeAcc"
							   autocomplete="off" class="layui-input bankAcc" placeholder="#springMessage('table.choBankFinance.noticeAcc')">
						<input id="accType"  type="hidden" value="06">
						<table id="payeeAccTable" class="hide">
							<thead>
							<tr>
								<th>#springMessage('table.choBankFinance.acc')</th>
								<th>#springMessage('table.choBankFinance.accName')</th>
								<th>#springMessage('table.choBankFinance.accBank')</th>
								<th>#springMessage('table.choBankFinance.curId')</th>
							</tr>
							</thead>
						</table>
					#end
				</td>
			</tr>
			<tr>
				<td colspan="4" style="text-align: center;">
					<button class="layui-btn" lay-submit="" lay-filter="submit" value="$!{choBankFinancePage.status}">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/chowmatistic/choBankFinance.bl.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <input id="eqi_redeemStatus" name="eqi_redeemStatus" type="hidden">
        <input id="row"  type="hidden" value="$!{row}"/>
        <tr>
            ##单位名称
            <td class="textRight">#springMessage("table.choBankFinance.corpId")</td>
            <td>
                $!{corp.name}
                <input type="hidden" name="eqs_corpId" value="$!{corp.id}">
            </td>
            ##产品类型
            <td class="textRight">#springMessage("table.choProduct.productType")</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="cho.productType"
                     data-name="eqs_productType" data-biz-name="eqs_productType" id="eqs_productType"></div>
            </td>
        </tr>
        <tr>
            ##产品名称
            <td class="textRight">#springMessage("table.choProduct.productName")</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/chowmatistic/choproduct/json"
                     data-name ="likes_productName" data-biz-name ="likes_productName"  data-valueField="productName" data-textField="productName"></div>
            </td>
            ##产品代码
            <td class="textRight">#springMessage("table.choProduct.productCode")</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/chowmatistic/choproduct/json"
                     data-name ="eqs_productCode" data-biz-name ="eqs_productCode"  data-valueField="productCode" data-textField="productCode"></div>
            </td>
        </tr>
        <tr>
            ##币别
            <td class="textRight">#springMessage("table.choProduct.curId")</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-name ="eqs_curId" data-biz-name ="eqs_curId"  data-valueField="id" data-textField="curName"
                     data-selecttext="false" data-displayData="$!{dto.curId}"  data-defaultvalue="$!{dto.curId}"></div>
            </td>

            <td class="textRight">#springMessage('table.btBankAccApp.bankTypeId')</td>
            <td>
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json"
                     data-name ="eqs_bankTypeId" data-biz-name ="eqs_bankTypeId"  data-valueField="id" data-textField="typeName" data-defaultvalue="$!{btBankAccAppPage.bankTypeId}" ></div>
            </td>
        </tr>
        <tr>
            ##购买金额
            <td class="textRight">#springMessage("table.choProductRedeem.redeemMoney")</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_redeemMoney" name="geg_buyMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_redeemMoney" name="leg_buyMoney" value="$!{dto.amt}"
                           autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                </div>
            </td>
            ##赎回日期
            <td class="textRight">#springMessage("table.choProductRedeem.redeemDate")</td>
            <td>
                <input type="text" name="ged_redeemDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_deadlineDate"
                       data-endid="led_deadlineDate">
                <span class="date-mid">~</span>
                <input type="text" name="led_redeemDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_deadlineDate"
                       value="$!{endDate}">
            </td>
        </tr>
        <tr>
            ##状态
            <td class="textRight">#springMessage("table.choProductReq.status")</td>
            <td width="20%">
                <div class="bt-biz-dict" data-type="select" data-group="choBankFinance.status" data-name="eqi_redeemStatus" data-selecttext="false"
                     data-biz-name="eqi_redeemStatus" id="eqi_redeemStatus" data-displayData="95"  data-defaultvalue="95"></div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
##                #if($shiro.hasPermission("cho:productReq:choProductReq:bus:query"))
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
##                #end
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width: 100%;">
    <thead>
    <tr>
        <th width="30">#springMessage('common.table.thead.operation')</th>
        <th>#springMessage("table.choBankFinance.corpId")</th>
        <th>#springMessage("table.choProduct.bankTypeId")</th>
        <th>#springMessage("table.choProductReq.bankName")</th>
        <th>#springMessage("table.choProduct.productCode")</th>
        <th>#springMessage("table.choProduct.productName")</th>
        <th>#springMessage("table.choProduct.productType")</th>
        <th>#springMessage("table.choProductReq.bankAcc")</th>
        <th>#springMessage("table.choProduct.curId")</th>
        <th>#springMessage("table.choProductRedeem.redeemMoney")</th>
        <th>#springMessage("table.choProductRedeem.redeemDate")</th>
        <th>#springMessage("table.choProductRedeem.incomeRate")</th>
        <th>#springMessage("table.choProductRedeem.incomeMoney")</th>
        <th>#springMessage("table.choProductReq.subFeeMoney")</th>
        <th>#springMessage("table.choProductRedeem.redeemChargeMoney")</th>
        <th>#springMessage("table.choProductReq.chargeMoney")</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form','datatable','selectType','dicts','rateType','corp','dateType','moneyType'],function () {
        var selectType=bt.selectType.init();
        var dict = bt.dicts.init();
        var corp = bt.corp.init();
        bt.moneyType.init();
        bt.dateType.init();
        var rateType = bt.rateType.getFun();
        table = bt.datatable.init({
            elem: "#appTable",
            dom: "Brtlip",
            order: [[0,'asc'],[3,'asc'],[13,'asc']],
            colReorder:true,
            searchForm:{
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath+"/chowmatistic/choproductredeem/datatableForSelect"
            },
            buttons:[
                {
                    extend: "colvis",
                    text: bt.lang("common.button.theadHide"),
                    columns: ':not(:first):not(:last)'
                }
            ],
            columns:[
                {
                    data: null, bSortable: false, className: 'center',
                    render: function (data, type, full, meta) {
                        return '<a href="javascript:void(0);" class="country-select" data-row="' + meta.row + '">' + bt.lang("common.button.select") + '</a>';
                    }
                },
                {data:"corpName",bSortable:true,className:'center'},
                {data:"bankTypeName",bSortable:true,className:'center'},
                {data:"bankName",bSortable:true,className:'center'},
                {data:"productCode",bSortable:true,className:'center'},
                {data:"productName",bSortable:true,className:'center'},
                {data:"productType",bSortable:true,className:'center',
                    render:function (data, type, full, meta) {
                        return bt.dict("cho.productType",full.productType);
                    }
                },
                {data:"bankAcc",bSortable:true,className:'center'},
                {data:"curName",bSortable:true,className:'center'},
                {data:"redeemMoney",bSortable:true,className:'textRight',
                    render:function (data, type, full, meta) {
                        return bt.money.format(full.redeemMoney);
                    }
                },
                {data:"redeemDate",bSortable:true,className:'center'},
                {data:"incomeRate",bSortable:true,className:'textRight',
                    render:function (data, type, full, meta) {
                        return rateType.format(full.incomeRate, 'percent', 6);
                    }
                },
                {data:'incomeMoney',bSortable:false,className:'textRight',
                    render:function (data, type, full, meta) {
                        return bt.money.format(full.incomeMoney);
                    }
                },
                {data:'subFeeMoney',bSortable:false,className:'textRight',
                    render:function (data, type, full, meta) {
                        return bt.money.format(full.subFeeMoney);
                    }
                },
                {data:'redeemChargeMoney',bSortable:false,className:'textRight',
                    render:function (data, type, full, meta) {
                        return bt.money.format(full.redeemChargeMoney);
                    }
                },
                {data:'chargeMoney',bSortable:false,className:'textRight',
                    render:function (data, type, full, meta) {
                        return bt.money.format(full.chargeMoney);
                    }
                },
            ]
        })


        /**选择的数据进行数据传输  begin*/
        table.on('click', '.country-select', function (event) {
            var currentParentIframe = top.$('.layui-tab-content > .layui-show').find('iframe')[0]['name'];
            // var func = top.frames[currentParentIframe].window.btSelectCallBack['bt-biz-choProductRedeem']['callback'];
            // if (func) {
            //     var data = table.row($(this).data('row')).data();
            //     func(data);
            // }
            top.frames[currentParentIframe].window.busTypeCallback(table.row($(this).data('row')).data(),$("#row").val());
        });
        /**数据传输  end*/
    });
</script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
    <style type="text/css">
        .sign {
            color: red;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{fcAgreedDepositPage.id}">
    <input type="hidden" name="poolSign" id="poolSign" value="$!{fcAgreedDepositPage.poolSign}"/>
    <input id="blnctrAcc" name="blnctrAcc" type="hidden">
    <input id="opType" name="opType" type="hidden" value="0">
##账号信息
    <input id="netId" name="dto.netId" type="hidden">
    <input id="fcCorpId" name="dto.corpId" type="hidden">
    <input id="fcBlnctrAcc" name="dto.blnctrAcc" type="hidden">
    <input id="fcCurId" name="dto.curId" type="hidden">
    <input id="fcAccName" name="dto.accName" type="hidden">
    <input id="subjectId" name="dto.subjectId" type="hidden">
    <input id="accType" name="dto.accType" type="hidden">
    <input id="shortcut" name="dto.shortcut" type="hidden">
    <input id="unionNet" name="dto.unionNet" type="hidden">
    <input id="unionAcc" name="dto.unionAcc" type="hidden">
    <input id="attributeId" name="dto.attributeId" type="hidden">
    <input id="natureCodeId" name="dto.natureCodeId" type="hidden">
    <input id="balanceWay" name="dto.balanceWay" type="hidden">
    <input id="accOpenTime" name="dto.accOpenTime" type="hidden">
    <input id="accStartDate" name="dto.accStartDate" type="hidden">
    <input id="relationAcc" name="dto.relationAcc" type="hidden">
    <input id="interestRate" name="dto.interestRate" type="hidden">
    <input id="interestSign" name="dto.interestSign" type="hidden">
    <input id="predrawSign" name="dto.predrawSign" type="hidden">
    <input id="chargeAcc" name="dto.chargeAcc" type="hidden">
    <input id="overdraftSign" name="dto.overdraftSign" type="hidden">
    <input id="overdraftRate" name="dto.overdraftRate" type="hidden">
    <input id="overdraftMoney" name="dto.overdraftMoney" type="hidden">
    <input id="rmk" name="dto.rmk" type="hidden">
    <input id="accState" name="dto.accState" type="hidden" value="N">
    <input id="poolSign" name="dto.poolSign" type="hidden" value="0">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-biz-name="corpId"
                         data-scope="all"
                         data-resource="cho:inneragreeddeposit:agreeddeposit:reg:apply"
                         data-required="true"
                         data-callback="bt.corpCallback"></div>
                </div>
            </td>
        ##账号
            <td class="textRight">#springMessage('table.fcAcc.account')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="" data-name="accId" data-biz-name="accId"
                         data-required="required"
                         data-valuefield="id" data-textfield="blnctrAcc" data-search="true"
                         data-callback="getAccCallBack" data-disabled="true"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##账户名称
            <td class="textRight">#springMessage('table.fcAcc.accName')</td>
            <td>
                <div class="layui-input-inline">
                    <div id="accName"></div>
                </div>
            </td>
        ##币别
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td>
                <input type="hidden" name="curId" id="curId" autocomplete="off" class="layui-input">
                <div class="layui-inline">
                    <div id="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##合同号
            <td class="textRight">#springMessage('table.cgsBill.pactCode')</td>
            <td>
                <input type="text" name="contractNo" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.cgsBill.pactCode')" lay-verify="required">
            </td>
        ##到期处理方式
            <td class="textRight">#springMessage('table.bisFinanceExc.certificateWay')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="agreed.certificateWay" data-defaultvalue="0"
                     data-name="certificateWay" data-biz-name="certificateWay" data-required="true"></div>
            </td>
        </tr>
        <tr>
        ##开始日期
            <td class="textRight">#springMessage('table.fbsBudgetReport.beginDate')</td>
            <td>
                <input type="text" name="beginDate" data-biz-name="beginDate"
                       class="layui-input bt-input-inline bt-biz-dateType"
                       data-endid="endDate" lay-verify="required"
                       data-type="date" placeholder="#springMessage('table.fbsBudgetReport.beginDate')">
            </td>
        ##结束日期
            <td class="textRight">#springMessage('table.fbsBudgetReport.endDate')</td>
            <td>
                <input type="text" name="endDate" data-biz-name="endDate"
                       class="layui-input bt-input-inline bt-biz-dateType"
                       id="endDate" lay-verify="required" data-type="date"
                       placeholder="#springMessage('table.fbsBudgetReport.endDate')">
            </td>
        </tr>
        <tr>
        ##是否存入协定账号
            <td class="textRight">#springMessage('table.fcAgreedDeposit.isAgreedDepositAcc')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0"
                     data-name="isAgreedDepositAcc" data-biz-name="isAgreedDepositAcc" data-required="true"
                     data-callback="bt.isAgreedDepositAcc"></div>
            </td>
        ##协定利率
            <td class="textRight isAcc" style="display: none;">#springMessage('table.btBankAcc.agrInterest')</td>
            <td class="isAcc" style="display: none">
                <input type="text" data-id="agrInterest" data-name="agrInterest"
                       class="layui-input bt-biz-rateType" data-biz-name="agrInterest"
                       placeholder="#springMessage('table.btBankAcc.agrInterest')">
            </td>
        </tr>
        <tr class="isAcc" style="display: none;">
        ##协定账号
            <td class="textRight">#springMessage('table.fcAgreedDeposit.agrAcc')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" ondblclick="selectAcc()" id="agrAcc" class="layui-input" name="agrAcc"
                           readonly="readonly" placeholder="#springMessage('table.fcAgreedDeposit.agrAcc')">
                </div>

            </td>
        ##活期账号留存金额
            <td class="textRight">#springMessage('table.fcAgreedDeposit.retainedBal')</td>
            <td><input type="text" id="retainedBal" name="retainedBal" style="text-align:right"
                       data-name="retainedBal" data-biz-name="retainedBal"
                       autocomplete="off" class="layui-input bt-biz-moneyType"
                       placeholder="#springMessage('table.fcAgreedDeposit.retainedBal')"></td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit" value="0">#springMessage(
                    'common.button.temp')</button>
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit" value="11">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
## 协定表格数据
    <table id="dataTable" class="layui-table ignore-required-icon">
        <thead>
        <th style="text-align: center;"><span class="sign">*</span>#springMessage(
            'table.fc_charge_type_dtl.min_range_money')（>）
        </th>
        <th style="text-align: center;"><span class="sign">*</span>#springMessage(
            'table.fc_charge_type_dtl.max_range_money')（<=）
        </th>
        <th style="text-align: center;"><span class="sign">*</span>#springMessage('table.btBankAcc.agrInterest')</th>
        <th style="text-align: center;">#springMessage('table.createRepayPlan.operation')</th>
        </thead>
        <tbody>
        <tr data-row="0">
            <td>
                <input type="text" id="minMoney0" name="detailList[0].minMoney" style="text-align:right"
                       lay-verify="required" data-name="detailList[0].minMoney" data-biz-name="minMoney0"
                       autocomplete="off" class="layui-input bt-biz-moneyType min" data-callback="changeMinMoney">
            </td>
            <td>
                <input type="text" id="maxMoney0" name="detailList[0].maxMoney" style="text-align:right"
                       data-name="detailList[0].maxMoney" data-biz-name="maxMoney0"
                       autocomplete="off" class="layui-input bt-biz-moneyType max" data-callback="changeMaxMoney">
            </td>
            <td>
                <input type="text" id="agreeRate0" name="detailList[0].agreeRate" data-name="detailList[0].agreeRate"
                       class="layui-input bt-biz-rateType" data-biz-name="agreeRate0" lay-verify="required">
            </td>
            <td>
                <a href="#" title="#springMessage('common.addTr')" onClick="addTr()"><i class="layui-icon">&#xe654;</i></a>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/agreeddeposit/choRegAgreedDeposit.add.js?_btv=${resourceVersion}"></script>
</html>
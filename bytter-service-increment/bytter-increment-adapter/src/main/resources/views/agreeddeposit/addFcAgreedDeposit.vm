<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
    <style type="text/css">
        .sign {
            color: red;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{fcAgreedDepositPage.id}">
    <input id="blnctrAcc" name="blnctrAcc" type="hidden">
    <input id="opType" name="opType" type="hidden" value="0">
    <table class="layui-table">
        <tbody>
        <tr>
        ##资金池
            <td class="textRight">#springMessage('nis.pool.fcCorpPool.pool')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-name="netId" data-biz-name="netId"
                         data-callback="getNetIdCallback"
                         data-url="${basePath}/agreeddeposit/fcagreeddeposit?getUserCorpPools&opType=0&checkSign=0"
                         data-required="required"
                         data-valuefield="id" data-textfield="showName" data-search="true"
                         data-defaultValue="$!{netId}">
                    </div>
                </div>
            </td>
        ##开户单位
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            <td>$!{netId}
                <div class="layui-input-inline">$!{netId}
                    <div class="bt-biz-selectType" data-name="corpId" data-biz-name="corpId"
                         data-callback="getCorpCallback"
                         data-url="${basePath}/agreeddeposit/fcagreeddeposit?listUserCorpPoolChilds&poolId=$!{netId}&opType=0&checkSign=0"
                         data-valuefield="corpId" data-textfield="showName" data-search="true" data-required="required"
                         data-defaultValue="$!{corpId}"></div>
                </div>
        </tr>
        <tr>
        ##账号
            <td class="textRight" width="15%">#springMessage('table.fcAcc.account')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="" data-name="accId" data-biz-name="accId"
                         data-required="required"
                         data-valuefield="id" data-textfield="blnctrAcc" data-search="true"
                         data-callback="getAccCallBack" data-disabled="true"></div>
                </div>
            </td>
        ##账户名称
            <td class="textRight" width="15%">#springMessage('table.fcAcc.accName')</td>
            <td>
                <div class="layui-input-inline">
                    <div id="accName"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##开始日期
            <td class="textRight" width="15%">#springMessage('table.fbsBudgetReport.beginDate')</td>
            <td>
                <input type="text" name="beginDate" data-biz-name="beginDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="endDate" lay-verify="required" data-type="date">
            </td>
        ##结束日期
            <td class="textRight" width="15%">#springMessage('table.fbsBudgetReport.endDate')</td>
            <td>
                <input type="text" name="endDate" data-biz-name="endDate" class="layui-input bt-input-inline bt-biz-dateType"
                       id="endDate" lay-verify="required" data-type="date">
            </td>
        </tr>
        <tr>
        ##合同号
            <td class="textRight">#springMessage('table.cgsBill.pactCode')</td>
            <td width="40%">
                <input type="text" name="contractNo" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.cgsBill.pactCode')" lay-verify="required">
            </td>
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td width="25%">
                <input type="hidden" name="curId" id="curId" autocomplete="off" class="layui-input">
                <div class="layui-inline">
                    <div id="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit" value="0">#springMessage(
                    'common.button.temp')</button>
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit" value="11">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button type="button" onclick="closeDoc()" class="layui-btn layui-btn-primary">#springMessage(
                    'common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
## 协定表格数据
    <table id="dataTable" class="layui-table">
        <thead>
        <th style="text-align: center;"><span class="sign">*</span>#springMessage(
            'table.fc_charge_type_dtl.min_range_money')（>）
        </th>
        <th style="text-align: center;"><span class="sign">*</span>#springMessage(
            'table.fc_charge_type_dtl.max_range_money')（<=）
        </th>
        <th style="text-align: center;"><span class="sign">*</span>#springMessage('table.btBankAcc.agrInterest')</th>
        <th style="text-align: center;">#springMessage('table.createRepayPlan.operation')</th>
        </thead>
        <tbody>
        <tr data-row="0">
            <td>
                <input type="text" id="minMoney0" name="detailList[0].minMoney" style="text-align:right"
                       lay-verify="required|number2" data-name="detailList[0].minMoney" data-biz-name="minMoney0"
                       autocomplete="off" class="layui-input bt-biz-moneyType min" data-callback="changeMinMoney">
            </td>
            <td>
                <input type="text" id="maxMoney0" name="detailList[0].maxMoney" style="text-align:right"
                       data-name="detailList[0].maxMoney" data-biz-name="maxMoney0"
                       autocomplete="off" class="layui-input bt-biz-moneyType max" data-callback="changeMaxMoney">
            </td>
            <td>
                <input type="text" id="agreeRate0" name="detailList[0].agreeRate" data-name="detailList[0].agreeRate"
                       class="layui-input bt-biz-rateType" data-biz-name="agreeRate0" lay-verify="required|number2">
            </td>
            <td>
                <a href="#" title="#springMessage('common.addTr')" onClick="addTr()"><i class="layui-icon">&#xe654;</i></a>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/agreeddeposit/fcAgreedDeposit.add.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
    <style type="text/css">
        .sign {
            color: red;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post">
    <input id="agreedDepositOriId" name="agreedDepositOriId" type="hidden"
           value="$!{fcAgreedDepositPage.agreedDepositOriId}">
    <input id="id" name="id" type="hidden" value="$!{fcAgreedDepositPage.id}">
    <input type="hidden" name="poolSign" id="poolSign" value="$!{fcAgreedDepositPage.poolSign}"/>
    <input id="blnctrAcc" name="blnctrAcc" type="hidden">
    <input id="opType" name="opType" type="hidden" value="1">
    ##协定账号信息
    <input id="agrAccId" name="agrAccId" type="hidden" value="$!{fcAgreedDepositPage.agrAccId}">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-biz-name="corpId"
                         data-scope="all"
                         data-resource="cho:inneragreeddeposit:agreeddeposit:pos:apply"
                         data-required="true"
                         data-callback="bt.corpCallback"></div>
                </div>
            </td>
        ##账号
            <td class="textRight">#springMessage('table.fcAcc.account')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="" data-name="accId" data-biz-name="accId"
                         data-required="required"
                         data-valuefield="id" data-textfield="blnctrAcc" data-search="true"
                         data-callback="getAccCallBack" data-disabled="true"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##账户名称
            <td class="textRight">#springMessage('table.fcAcc.accName')</td>
            <td>
                <div class="layui-input-inline">
                    <div id="accName"></div>
                </div>
            </td>
        ##币别
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td>
                <input type="hidden" name="curId" id="curId" autocomplete="off" class="layui-input">
                <div class="layui-inline">
                    <div id="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##合同号
            <td class="textRight">#springMessage('table.cgsBill.pactCode')</td>
            <td>
                <input type="text" id="contractNo" name="contractNo" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.cgsBill.pactCode')" lay-verify="required" readonly="readonly">
            </td>
            <td class="textRight"></td>
            <td></td>
        </tr>
        <tr>
        ##开始日期
            <td class="textRight">#springMessage('table.fbsBudgetReport.beginDate')</td>
            <td>
                <input type="text" class="layui-input" name="beginDate" id="beginDate" readonly="readonly"
                       placeholder="#springMessage('table.fbsBudgetReport.beginDate')">

            ##结束日期
            <td class="textRight" width="15%">#springMessage('table.fbsBudgetReport.endDate')</td>
            <td>
                <input type="text" class="layui-input" name="oldEndDate" id="oldEndDate" readonly="readonly"
                       placeholder="#springMessage('table.fbsBudgetReport.endDate')">
            </td>
        </tr>
        <tr>
        ##到期处理方式
            <td class="textRight">#springMessage('table.bisFinanceExc.certificateWay')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio"
                     data-group="agreed.certificateWay" data-defaultvalue="0"
                     data-name="certificateWay" data-biz-name="certificateWay" data-required="true"
                     data-callback="wayCallBack"></div>
            </td>
        ##新结束日期
            <td class="textRight">#springMessage('table.fcAgreedDeposit.endDate')</td>
            <td>
                <input type="text" id="endDate" name="endDate" data-biz-name="endDate"
                       class="layui-input bt-input-inline bt-biz-dateType"
                       lay-verify="required" data-type="date" data-callback="endCallBack"
                       placeholder="#springMessage('table.fcAgreedDeposit.endDate')">
        </tr>

        <tr>
        ##是否存入协定账号
            <td class="textRight">#springMessage('table.fcAgreedDeposit.isAgreedDepositAcc')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0"
                     data-name="isAgreedDepositAcc" data-biz-name="isAgreedDepositAcc" data-required="true"
                     data-callback="bt.isAgreedDepositAcc" data-disabled="true"></div>
            </td>
        ##协定利率
            <td class="textRight isAcc" style="display: none;">#springMessage('table.btBankAcc.agrInterest')</td>
            <td class="isAcc" style="display: none">
                <input type="text" data-id="agrInterest" data-name="agrInterest"
                       class="layui-input bt-biz-rateType inter" data-biz-name="agrInterest"
                       placeholder="#springMessage('table.btBankAcc.agrInterest')" readonly="readonly">
            </td>
        </tr>
        <tr class="isAcc" style="display: none;">
        ##协定账号
            <td class="textRight">#springMessage('table.fcAgreedDeposit.agrAcc')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" id="agrAcc" class="layui-input" name="agrAcc"
                           readonly="readonly" placeholder="#springMessage('table.fcAgreedDeposit.agrAcc')" readonly="readonly">
                </div>

            </td>
        ##活期账号留存金额
            <td class="textRight">#springMessage('table.fcAgreedDeposit.retainedBal')</td>
            <td><input type="text" id="retainedBal" name="retainedBal" style="text-align:right"
                       data-name="retainedBal" data-biz-name="retainedBal"
                       autocomplete="off" class="layui-input bt-biz-moneyType"
                       placeholder="#springMessage('table.fcAgreedDeposit.retainedBal')" readonly="readonly"></td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit" value="0">#springMessage(
                    'common.button.temp')</button>
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit" value="11">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
## 协定表格数据
    <table id="dataTable" class="layui-table">
    </table>
</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/agreeddeposit/choPosAgreedDeposit.add.js?_btv=${resourceVersion}"></script>
</html>
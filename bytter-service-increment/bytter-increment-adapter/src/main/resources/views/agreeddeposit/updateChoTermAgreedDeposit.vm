<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
    <style type="text/css">
        .sign {
            color: red;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post">
    <input id="agreedDepositOriId" name="agreedDepositOriId" type="hidden"
           value="$!{fcAgreedDepositPage.agreedDepositOriId}">
    <input id="id" name="id" type="hidden" value="$!{fcAgreedDepositPage.id}">
    <input id="blnctrAcc" name="blnctrAcc" type="hidden" value="$!{fcAgreedDepositPage.blnctrAcc}">
    <input type="hidden" name="poolSign" id="poolSign" value="$!{fcAgreedDepositPage.poolSign}"/>
    <input type="hidden" id="isAgreedDepositAccTemp" value="$!{fcAgreedDepositPage.isAgreedDepositAcc}"/>
    <input id="opType" name="opType" type="hidden" value="2">
    ##协定账号信息
    <input type="hidden" id="isAgreedDepositAccTemp" value="$!{fcAgreedDepositPage.isAgreedDepositAcc}"/>
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-biz-name="corpId"
                         data-scope="all"
                         data-resource="cho:inneragreeddeposit:agreeddeposit:pos:apply"
                         data-required="true"
                         data-defaultvalue="$!{fcAgreedDepositPage.corpId}"
                         data-callback="bt.corpCallback"></div>
                </div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
        ##账号
            <td class="textRight">#springMessage('table.fcAcc.account')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType"
                         data-url="${basePath}/agreeddeposit/choinneragreeddeposit?getBlnctrAccByCorpId&corpId=$!{fcAgreedDepositPage.corpId}&busType=2"
                         data-name="accId" data-biz-name="accId"
                         data-valuefield="id" data-textfield="blnctrAcc" data-search="true"
                         data-defaultValue="$!{fcAgreedDepositPage.accId}" data-required="required"
                         data-callback="getAccCallBack" data-extraData="false"></div>
                </div>
            </td>
        ##账户名称
            <td class="textRight">#springMessage('table.fcAcc.accName')</td>
            <td>
                <div class="layui-input-inline">
                    <div id="accName">$!{fcAgreedDepositPage.accName}</div>
                </div>
            </td>
        </tr>
        <tr>
        ##合同号
            <td class="textRight">#springMessage('table.cgsBill.pactCode')</td>
            <td width="40%">
                <input type="text" name="contractNo" id="contractNo" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.cgsBill.pactCode')"
                       lay-verify="required" readonly="readonly"
                       value="$!{fcAgreedDepositPage.contractNo}">
            </td>
        ##币别
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td>
                <input type="hidden" name="curId" id="curId" autocomplete="off" class="layui-input"
                       value="$!{fcAgreedDepositPage.curId}">
                <div class="layui-inline">
                    <div id="curName">$!{fcAgreedDepositPage.curName}</div>
                </div>
            </td>
        </tr>
        <tr>
        ##开始日期
            <td class="textRight" width="15%">#springMessage('table.fbsBudgetReport.beginDate')</td>
            <td>
                <input type="text" class="layui-input" name="beginDate" id="beginDate" readonly="readonly"
                       value="$!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.beginDate)"
                       placeholder="#springMessage('table.fbsBudgetReport.beginDate')">
            </td>
        ##结束日期
            <td class="textRight" width="15%">#springMessage('table.fbsBudgetReport.endDate')</td>
            <td>
                <input type="text" class="layui-input" name="endDate" id="endDate" readonly="readonly"
                       value="$!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.endDate)"
                       placeholder="#springMessage('table.fbsBudgetReport.endDate')">
            </td>
        </tr>

        <tr>
        ##到期处理方式
            <td class="textRight">#springMessage('table.bisFinanceExc.certificateWay')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="agreed.certificateWay"
                     data-defaultvalue="$!{fcAgreedDepositPage.certificateWay}" data-name="certificateWay"
                     data-biz-name="certificateWay" data-required="true" data-disabled="true"></div>
            </td>
        ##终止日期
            <td class="textRight" width="15%">#springMessage('table.fcPredraw.endDate')</td>
            <td>
                <input type="text" name="stopDate" id="stopDate"
                       class="layui-input bt-input-inline bt-biz-dateType"
                       value="$!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.stopDate)"
                       lay-verify="required" data-biz-name="stopDate"
                       data-type="date" data-callback="stopCallBack"
                       placeholder="#springMessage('table.fcPredraw.endDate')">
            </td>
        </tr>
        <tr>
        ##是否存入协定账号
            <td class="textRight">#springMessage('table.fcAgreedDeposit.isAgreedDepositAcc')</td>
            <td>
                <div class="bt-biz-dict" data-type="radio" data-group="sf_yn"
                     data-defaultvalue="$!{fcAgreedDepositPage.isAgreedDepositAcc}" data-name="isAgreedDepositAcc"
                     data-biz-name="isAgreedDepositAcc" data-required="true"
                     data-callback="bt.isAgreedDepositAcc" data-disabled="true"></div>
            </td>
        ##协定利率
            <td class="textRight isAcc">#springMessage('table.btBankAcc.agrInterest')</td>
            <td class="isAcc">
                <input type="text" data-id="agrInterest" data-name="agrInterest"
                       class="layui-input bt-biz-rateType inter" data-biz-name="agrInterest"
                       value="$!{fcAgreedDepositPage.agrInterest}"
                       placeholder="#springMessage('table.btBankAcc.agrInterest')" readonly="readonly">
            </td>
        </tr>
        <tr class="isAcc">
        ##协定账号
            <td class="textRight">#springMessage('table.fcAgreedDeposit.agrAcc')</td>
            <td>
                <input type="text" id="agrAcc" class="layui-input" name="agrAcc"
                       value="$!{fcAgreedDepositPage.agrAcc}" readonly="readonly"
                       placeholder="#springMessage('table.fcAgreedDeposit.agrAcc')" readonly="readonly">
            </td>
        ##活期账号留存金额
            <td class="textRight">#springMessage('table.fcAgreedDeposit.retainedBal')</td>
            <td><input type="text" id="retainedBal" name="retainedBal" style="text-align:right"
                       data-name="retainedBal" data-biz-name="retainedBal"
                       autocomplete="off" class="layui-input bt-biz-moneyType"
                       value="$!{fcAgreedDepositPage.retainedBal}"
                       placeholder="#springMessage('table.fcAgreedDeposit.retainedBal')" readonly="readonly">
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit" value="0">#springMessage(
                    'common.button.temp')</button>
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit" value="11">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
    #if($!{fcAgreedDepositPage.isAgreedDepositAcc} == 0)
    ## 协定表格数据
        <table id="dataTable" class="layui-table">
            <thead>
            <th style="text-align: center;">#springMessage('table.fc_charge_type_dtl.min_range_money')（>）</th>
            <th style="text-align: center;">#springMessage('table.fc_charge_type_dtl.max_range_money')（<=）</th>
            <th style="text-align: center;">#springMessage('table.btBankAcc.agrInterest')</th>
            </thead>
            <tbody>
                #foreach($detail in $!{fcAgreedDepositPage.detailList})
                    #set($vcount = $velocityCount - 1)
                <tr data-row="${vcount}">
                    <td class="textRight">
                        $!number.formatNumeric(${detail.minMoney})
                        <input type="hidden" id="minMoney${vcount}" name="detailList[${vcount}].minMoney"
                               data-name="detailList[${vcount}].minMoney" value="$!{detail.minMoney}" class="min">
                    </td>
                    <td class="textRight">
                        $!number.formatNumeric(${detail.maxMoney})
                        <input type="hidden" id="maxMoney${vcount}" name="detailList[${vcount}].maxMoney"
                               data-name="detailList[${vcount}].maxMoney" value="$!{detail.maxMoney}" class="max">
                    </td>
                    <td class="textRight">
                        $!rateTag.show($!{detail.agreeRate})
                        <input type="hidden" id="agreeRate${vcount}" name="detailList[${vcount}].agreeRate"
                               data-name="detailList[${vcount}].agreeRate" value="$!{detail.agreeRate}"
                               class="agreeRate">
                    </td>
                </tr>
                #end
            </tbody>
        </table>
    #end
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/agreeddeposit/updateChoTermAgreedDeposit.edit.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <table class="layui-table">
        <tbody>
        <tr>
        ##资金池
            <td class="textRight">#springMessage('nis.pool.fcCorpPool.pool')</td>
            <td width="35%">$!{fcAgreedDepositPage.netName}</td>
        ##开户单位
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            <td width="35%">$!{fcAgreedDepositPage.corpName}</td>
        </tr>
        <tr>
        ##账号
            <td class="textRight">#springMessage('table.fcAcc.account')</td>
            <td width="35%">$!{fcAgreedDepositPage.blnctrAcc}</td>
        ##账户名称
            <td class="textRight">#springMessage('table.fcAcc.accName')</td>
            <td width="35%">$!{fcAgreedDepositPage.accName}</td>
        </tr>
        <tr>
        ##开始日期
            <td class="textRight">#springMessage('table.fbsBudgetReport.beginDate')</td>
            <td width="35%">$!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.beginDate)</td>
        ##结束日期
            <td class="textRight">#springMessage('table.fbsBudgetReport.endDate')</td>
            <td width="35%">$!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.endDate)</td>
        </tr>
        <tr>
        ##合同号
            <td class="textRight">#springMessage('table.cgsBill.pactCode')</td>
            <td width="35%">$!{fcAgreedDepositPage.contractNo}</td>
        ##终止日期
            <td class="textRight" width="15%">#springMessage('table.fcPredraw.endDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.stopDate)
            </td>
        </tr>
        </tbody>
    </table>
    <table id="dataTable" class="layui-table">
        <thead>
        <th style="text-align: center;">#springMessage('table.fc_charge_type_dtl.min_range_money')（>）</th>
        <th style="text-align: center;">#springMessage('table.fc_charge_type_dtl.max_range_money')（<=）</th>
        <th style="text-align: center;">#springMessage('table.btBankAcc.agrInterest')</th>
        </thead>
        <tbody>
            #foreach($detail in $!{fcAgreedDepositPage.detailList})
                #set($vcount = $velocityCount - 1)
            <tr data-row="${vcount}">
                <td class="textRight">
                    $!number.formatNumeric($!{detail.minMoney})

                </td>
                <td class="textRight">
                    $!number.formatNumeric($!{detail.maxMoney})

                </td>
                <td class="textRight">
                    ##$number.formatDoubleWithSix(${detail.agreeRate})
                        $!rateTag.show($!{detail.agreeRate})
                </td>
            </tr>
            #end
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
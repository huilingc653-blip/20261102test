<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
    <style type="text/css">
        .sign {
            color: red;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post">
    <input id="agreedDepositOriId" name="agreedDepositOriId" type="hidden">
    <input id="blnctrAcc" name="blnctrAcc" type="hidden">
    <input id="curId" name="curId" type="hidden">
    <input id="opType" name="opType" type="hidden" value="1">
    <input id="dateStr" type="hidden" value="">

    <table class="layui-table">
        <tbody>
        <tr>
        ##资金池
            <td class="textRight">#springMessage('nis.pool.fcCorpPool.pool')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-name="netId" data-biz-name="netId"
                         data-callback="getNetIdCallback"
                         data-url="${basePath}/agreeddeposit/fcagreeddeposit?getUserCorpPools&opType=1&checkSign=0"
                         data-required="required"
                         data-valuefield="id" data-textfield="showName" data-search="true"
                         data-defaultValue="$!{netId}">
                    </div>
                </div>
            </td>
        ##开户单位
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-name="corpId" data-biz-name="corpId"
                         data-callback="getCorpCallback"
                         data-url="${basePath}/agreeddeposit/fcagreeddeposit?listUserCorpPoolChilds&poolId=$!{netId}&opType=1&checkSign=0"
                         data-valuefield="corpId" data-textfield="showName" data-search="true" data-required="required"
                         data-defaultValue="$!{corpId}"></div>
                </div>
        </tr>
        <tr>
        ##账号
            <td class="textRight" width="15%">#springMessage('table.fcAcc.account')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-url="" data-name="accId" data-biz-name="accId"
                         data-required="required"
                         data-valuefield="id" data-textfield="blnctrAcc" data-search="true"
                         data-callback="getAccCallBack" data-disabled="true"></div>
                </div>
            </td>
        ##账户名称
            <td class="textRight" width="15%">#springMessage('table.fcAcc.accName')</td>
            <td>
                <div class="layui-input-inline">
                    <div id="accName"></div>
                </div>
            </td>
        </tr>
        <tr>
        ##开始日期
            <td class="textRight" width="15%">#springMessage('table.fbsBudgetReport.beginDate')</td>
            <td>
                <input type="text" class="layui-input" name="oldBeginDate" id="oldBeginDate" readonly="readonly">
            </td>
        ##结束日期
            <td class="textRight" width="15%">#springMessage('table.fbsBudgetReport.endDate')</td>
            <td>
                <input type="text" class="layui-input" name="oldEndDate" id="oldEndDate" readonly="readonly">
            </td>
        </tr>
        <tr>
        ##合同号
            <td class="textRight">#springMessage('table.cgsBill.pactCode')</td>
            <td width="40%">
                <input type="text" name="contractNo" id="contractNo" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.cgsBill.pactCode')" lay-verify="required" readonly="readonly">
            </td>
        ##币别
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div id="curName"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit" value="0">#springMessage(
                    'common.button.temp')</button>
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit" value="11">#springMessage(
                    'common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button type="button" onclick="closeDoc()" class="layui-btn layui-btn-primary">#springMessage(
                    'common.button.close')</button>
            </td>
        </tr>
        </tbody>
    </table>
## 协定表格数据
    <table id="dataTable" class="layui-table">
    </table>
    <table id="regTable" class="layui-table">
        <thead>
        <th colspan="4" style="text-align: left;">延期信息</th>
        </thead>
        <tbody>
        <tr>
        ##开始日期
            <td class="textRight" width="15%">#springMessage('table.fcAgreedDeposit.beginDate')</td>
            <td>
                <input type="text" name="beginDate" class="layui-input bt-input-inline bt-biz-dateType"
                       id="beginDate" lay-verify="required" data-callback="beginCallBack" data-type="date"
                       data-biz-name="beginDate">
            </td>
        ##结束日期
            <td class="textRight" width="15%">#springMessage('table.fcAgreedDeposit.endDate')</td>
            <td>
                <input type="text" name="endDate" class="layui-input bt-input-inline bt-biz-dateType"
                       id="endDate" lay-verify="required" data-biz-name="endDate" readonly="readonly" data-type="date">
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/agreeddeposit/addPosAgreedDeposit.add.js?_btv=${resourceVersion}"></script>
</html>
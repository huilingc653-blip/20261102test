<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <input type="hidden" id="poolSign" name="poolSign" value="0">
        <input type="hidden" id="accAccNoRule" name="accAccNoRule" value="$!{agrAccInfo.accAccNoRule}">
        <table class="layui-table">
            <thead>
            <tr>
                <td colspan="4">#springMessage('table.externalCorp.basicInfo')</td>
            </tr>
            </thead>
            <tbody>
            <tr>
			##网点
                <td width="10%" class="textRight">#springMessage('table.fcAcc.netId')</td>
                <td width="40%">
                    <span id="netNameShow">$!{netInfo.name}</span>
                    <input id="netId" name="netId" type="hidden" value="$!{netInfo.id}">
                    <input id="netCode" type="hidden" value="$!{netInfo.code}">
				</td>
            ##账户类别
                <td width="10%" class="textRight">#springMessage('table.fcAcc.accType')</td>
                <td width="40%">
                <div class="bt-biz-dict" data-type="select" data-group="InnerAccount.AccType" data-defaultvalue="16" data-name="accType" data-biz-name="accType" data-disabled="true" data-defaultvalue="$!{agrAccInfo.accType}"></div>
                ##科目代码
                    <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/finacial/paramconfig/fcsubject/jsonSubjectDate/16" data-valuefield="id" data-textfield="subjectName"  data-name="subjectId"  data-search="true" data-biz-name="subjectId" data-callback="changeSubject" id="subjectId" data-defaultvalue="$!{agrAccInfo.subjectId}"></div>
                    </div>
                </td>
			</tr>
            <tr>
			##币别
                <td class="textRight">#springMessage('table.fcAcc.curId')</td>
                <td>
                	<span id="curNameShow">$!{curInfo.curName}</span>
                	<input id="curId" name="curId" type="hidden" value="$!{curInfo.id}">
                	<input id="curCode" type="hidden" value="$!{curInfo.curCode}">
                </td>
            ##结算中心账号
                <td class="textRight">#springMessage('table.fcAcc.blnctrAcc')</td>
                <td>
                    <input type="text" id="blnctrAcc" name="blnctrAcc" lay-verify="required"
                           autocomplete="off" class="layui-input" readonly="readonly" placeholder="#springMessage('table.fcAcc.blnctrAcc')" readonly="readonly" value="$!{agrAccInfo.blnctrAcc}">

                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.fcAcc.seqNum')</td>
				##顺序号
                <td>
##						<input type="text" id="seqNum" name="seqNum"
##							   autocomplete="off" class="layui-input" readonly="readonly" placeholder="#springMessage('table.fcAcc.seqNum')" value="$!{agrAccInfo.seqNum}">
                    #if($!{poolSign} != '1' && $!{seqNumPage} == '0')
                        <input type="text" id="seqNum" name="seqNum" maxlength="$!{relen}"
                               autocomplete="off" class="layui-input" onchange="getNum(this)"
                               onkeyup="value=zhzs(this.value)"
                               placeholder="#springMessage('table.fcAcc.seqNum')" value="">
                    #else
                        <input type="text" id="seqNum" name="seqNum"
                               autocomplete="off" class="layui-input" readonly="readonly"
                               placeholder="#springMessage('table.fcAcc.seqNum')" value="">
                    #end
				</td>
                <td class="textRight">#springMessage('table.fcAcc.shortcut')</td>
				##助记码
                <td>
                        <input type="text" id="shortcut" name="shortcut" lay-verify="strlength"
                               autocomplete="off" class="layui-input" data-maxlength="10" placeholder="#springMessage('table.fcAcc.shortcut')" value="$!{agrAccInfo.shortcut}">
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
					##开户单位ID
				<td>
						<span id="corpNameShow">$!{corpInfo.name}</span>
						<input id="corpId" name="corpId" type="hidden" value="$!{corpInfo.id}">
				</td>
                <td class="textRight">#springMessage('table.fcAcc.accName')</td>
					##账户名称
                <td>
							<input type="text" id="accName" name="accName"
								   lay-verify="required|strlength"
                                    value="$dictTag.get("InnerAccount.AccType","16")-$!{corpInfo.name}"
							 autocomplete="off" class="layui-input" data-maxlength="80" placeholder="#springMessage('table.fcAcc.accName')">
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.fcAcc.unionNet')</td>
				##联行网点
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-corp" data-biz-type="net" data-type="selectTree" data-callback="unionNetChange"
                             data-resource="cho:inneragreeddeposit:agreeddeposit:reg:apply" data-name="unionNet" data-scope="net" data-defaultvalue="$!{agrAccInfo.unionNetChange}">
                        </div>
                    </div>
				</td>
                <td class="textRight">#springMessage('table.fcAcc.unionAcc')</td>
					##联行账号
				<td>
                    <div class="layui-input-inline">
                        <input type="text" name="unionAcc"  lay-verify="tableData" id="unionAcc" class="layui-input acc" data-biz-name="unionAcc" value="$!{agrAccInfo.unionAcc}">
                    </div>
                </td>
			</tr>
            <tr>
                <td class="textRight">#springMessage('table.fcAcc.balanceWay')</td>
            ##余额方向
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-type="select" data-disabled="disabled" data-group="Admin.BalanceWay" data-defaultvalue="$!{agrAccInfo.balanceWay}" data-name="balanceWay" data-biz-name="balanceWay"></div>
                    </div>
                </td>
                <td></td>
                <td></td>
            </tr>
            </tbody>
        </table>
        <table class="layui-table">
            <thead>
            <tr>
                <td colspan="4">#springMessage('table.fcAgreedDeposit.accInfo')</td>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td width="10%" class="textRight">#springMessage('table.fcAcc.natureCodeId')</td>
                <td width="40%">##账户性质
                    <div class="layui-inline">
                        <div class="bt-biz-selectType" data-required="true" data-url="${basePath}/bankacc/btaccnature/json" data-valuefield="id" data-textfield="natureName" data-name="natureCodeId" data-defaultvalue="$!{accInfo.natureCodeId}" data-disabled="true">
                        </div>
                    </div>
                </td>
                <td width="10%" class="textRight">#springMessage('table.fcAcc.attributeId')</td>
                <td width="40%">##账户属性
                    <div class="layui-inline">
                        <div class="bt-biz-selectType"  data-required="true" data-url="${basePath}/bankacc/bisaccattribute/json" data-valuefield="id" data-textfield="attributeName" data-name="attributeId" data-defaultvalue="$!{accInfo.attributeId}" data-disabled="true">
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.fcAcc.accOpenTime')</td>
                <td>##开户日期
                    <div class="layui-input-inline">
                        <input type="text" name="accOpenTime" data-name="accOpenTime" data-biz-name="accOpenTime" lay-verify="required" value="$!{beginDate}" class="layui-input bt-biz-dateType" readonly="readonly">
                    </div>
                </td>
                <td class="textRight">#springMessage('table.fcAcc.accStartDate')</td>
                <td>##启用日期
                    <div class="layui-input-inline">
                        <input type="text" name="accStartDate" data-name="accStartDate" data-biz-name="accStartDate" lay-verify="required" value="$!{beginDate}" class="layui-input bt-biz-dateType" readonly="readonly">
                    </div>
                </td>
            </tr>
            <tr>

                <td class="textRight">#springMessage('table.fcAcc.relationAcc')</td>
                <td>##关联活期账号
                    <div class="layui-inline">
                        <input type="text" class="layui-input" name="relationAcc" id="relationAcc" value="$!{accInfo.blnctrAcc}" readonly="readonly">
                    </div>
                </td>
                <td></td>
                <td></td>
            </tr>
            </tbody>
        </table>
        <table class="layui-table">
            <thead>
            <tr>
                <td colspan="4">#springMessage('table.fcAgreedDeposit.interestInfo')</td>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td width="10%" class="textRight">#springMessage('table.fcAcc.interestRate')</td>
                <td width="40%">##利率
                    <input type="text" id="interestRate" name="interestRate" value="$!{fcAgreedDepositPage.agrInterest}" lay-verify="required"
                           autocomplete="off" class="layui-input  bt-biz-rateType" data-biz-name="interestRate" placeholder="#springMessage('table.fcAcc.interestRate')" readonly="readonly">
                </td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td width="10%" class="textRight">#springMessage('table.fcAcc.interestSign')</td>
                <td width="40%">##计息标志
                    <div class="layui-inline">
                        <div class=bt-biz-dict data-type="radio" data-group="Admin.InterestSign" data-defaultvalue="$!{agrAccInfo.interestSign}" data-biz-name="interestSign" data-name="interestSign" data-callback="changeInterestSign"></div>
                    </div>
                </td>
                <td width="10%" class="textRight">#springMessage('table.fcAcc.predrawSign')</td>
                <td width="40%">##预提标志
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-type="select" data-required="true" data-group="Admin.PredrawSign" data-defaultvalue="$!{agrAccInfo.predrawSign}" data-name="predrawSign" data-biz-name="predrawSign" data-filterData="1,2,4,5"></div>
                    </div>
                </td>
            </tr>
            </tbody>
        </table>
        <table class="layui-table">
            <thead>
            <tr>
                <td colspan="4">#springMessage('cms.loan.OtherInfo')</td>
            </tr>
            </thead>
            <tbody>
                <td class="textRight" width="10%">#springMessage('table.fcAcc.chargeAcc')</td>
                <td width="40%">##手续费收取账号
                    <div class="layui-inline">
                        <select  id="chargeAcc" name="chargeAcc">
                            <option></option>
                        </select>
                    </div>
                </td>
                <td class="textRight">#springMessage('table.fcAcc.overdraftSign')</td>
            ##透支类型
                <td>
                    <div class="layui-inline">
                        <select lay-filter="overdraftSign" name="overdraftSign">
                            #foreach($dict in $dictTag.list("fcAcc.overdraftSign"))
                                <option value="$dict.code">$dict.name</option>
                            #end
                        </select>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.fcAcc.overdraftRate')</td>
            ##透支利率
                <td>
                    <input type="text" id="overdraftRate" name="overdraftRate"
                           autocomplete="off" class="layui-input  bt-biz-rateType"  data-biz-name="overdraftRate" placeholder="#springMessage('table.fcAcc.overdraftRate')" value="$!{agrAccInfo.overdraftRate}">
                </td>
                <td class="textRight">#springMessage('table.fcAcc.overdraftMoney')</td>
            ##透支金额
                <td>
                    <input type="text" id="overdraftMoney" name="overdraftMoney"
                           autocomplete="off" class="layui-input bt-biz-moneyType" data-biz-name="overdraftMoney" placeholder="#springMessage('table.fcAcc.overdraftMoney')" value="$!{agrAccInfo.overdraftMoney}">
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.fcInitAcc.rmk')</td>
                <td>
                    <input type="text" class="layui-input" id="rmk" name="rmk" value="$!{agrAccInfo.rmk}"/>
                </td>
                <td></td>
                <td></td>
            </tr>
            </tbody>
        </table>
        <table class="layui-table">
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" type="button" lay-submit=""  lay-filter="submit">#springMessage('common.button.confirm')</button>
            </td>
        </tr>
    </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/agreeddeposit/agreedAcc.add.js?_btv=${resourceVersion}"></script>
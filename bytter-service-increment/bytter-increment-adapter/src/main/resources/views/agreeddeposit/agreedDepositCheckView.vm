<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
    <style type="text/css">
        .sign {
            color: red;
        }
    </style>
</head>
<body>
    #if($busType eq '0')
        #parse("views/agreeddeposit/viewFcAgreedDeposit.vm")
    #elseif($busType eq '1')
        #parse("views/agreeddeposit/viewPosFcAgreedDeposit.vm")
    #elseif($busType eq '2')
        #parse("views/agreeddeposit/viewTermFcAgreedDeposit.vm")
    #end
<form class="layui-form" method="post">
    <input id="id" name="id" type="hidden" value="$!{id}">
    <input id="busType" name="busType" type="hidden" value="$!{busType}">
    <table id="endTable" class="layui-table">
        <tr id="endTrCheckBackReason">
            <td width="10%" class="textRight" >#springMessage('table.fcAcc.checkBackReason')</td>
            <td colspan="6" >
                <div class="layui-input-inline">
                    <textarea placeholder="#springMessage('table.fcAcc.checkBackReason')" rows="4" cols="64" lay-verify="strlength" data-maxlength="150"  class="layui-textarea" id="checkBackReason" name="checkBackReason"></textarea>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" value="95"  lay-filter="submit">#springMessage('common.button.pass')</button>
                <button class="layui-btn" lay-submit="" type="button" value="-1"  lay-filter="submit">#springMessage('common.button.back')</button>
                <button type="button" onclick="closeDoc()" class="layui-btn layui-btn-primary">#springMessage(
                    'common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>

<script src="${basePath}/static/modules/agreeddeposit/agreedDepositCheckView.add.js?_btv=${resourceVersion}"></script>
</html>
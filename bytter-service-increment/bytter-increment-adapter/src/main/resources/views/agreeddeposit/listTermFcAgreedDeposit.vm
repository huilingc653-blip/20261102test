<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input id="opType" name="opType" type="hidden" value="2">
    <table class="layui-table">
        <tr>
        ##资金池
            <td class="textRight">#springMessage('nis.pool.fcCorpPool.pool')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-name="eqs_netId" data-biz-name="eqs_netId"
                         data-callback="getNetIdCallback"
                         data-url="${basePath}/agreeddeposit/fcagreeddeposit?getUserCorpPools&opType=2&checkSign=0"
                         data-valuefield="id" data-textfield="showName" data-search="true"
                         data-defaultValue="$!{netId}">
            </td>
        ##子单位
            <td class="textRight">#springMessage('table.fcAcc.corpId')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-selectType" data-name="eqs_corpId" data-biz-name="eqs_corpId"
                         data-url="${basePath}/agreeddeposit/fcagreeddeposit?listUserCorpPoolChilds&poolId=$!{netId}&opType=2&checkSign=0"
                         data-valuefield="corpId" data-textfield="showName" data-search="true"
                         data-defaultValue="$!{corpId}"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-biz-name="curCode"
                         data-url="${basePath}/basic/business/btcurrency/json"
                         data-valuefield="id" data-textfield="curName" data-required="false"
                         data-name="eqs_curId" data-search="true" data-value="$!{paramDTO.curCode}"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.account')</td>
            <td>
                <input type="text" name="likes_blnctrAcc" autocomplete="off" class="layui-input"
                       placeholder="#springMessage('table.fcAcc.account')">
            </td>
            <td class="textRight">#springMessage('table.btBankAcc.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="agreed.status" data-name="eqi_status"
                     data-biz-name="status" data-filterData="-2"></div>
            </td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary resetBtn">#springMessage(
                    'common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('nis.pool.fcCorpPool.pool')</th>
        <th>#springMessage('table.fcAcc.corpId')</th>
        <th>#springMessage('table.fcAcc.account')</th>
        <th>#springMessage('table.fcAcc.accName')</th>
        <th>#springMessage('table.fcAcc.curId')</th>
        <th>#springMessage('table.cgsBill.pactCode')</th>
        <th>#springMessage('table.fbsBudgetReport.beginDate')</th>
        <th>#springMessage('table.fbsBudgetReport.endDate')</th>
        <th>#springMessage('table.fcPredraw.endDate')</th>
        <th>#springMessage('table.btBankAcc.status')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/agreeddeposit/termfcAgreedDeposit.list.js?_btv=${resourceVersion}"></script>
</html>
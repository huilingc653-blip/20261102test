#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<input id="id" name="id" type="hidden" value="$!{fcAgreedDepositPage.id}">
<input id="busType" name="busType" type="hidden" value="$!{busType}">

<ul class="mui-table-view">
##单位
    <li class="mui-table-view-cell">
        #springMessage('table.nisBillhead.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{fcAgreedDepositPage.corpName}
        </span>
    </li>
##账号
    <li class="mui-table-view-cell">
        #springMessage('table.fcAcc.account')
        <span class="mui-badge mui-badge-inverted">
            $!{fcAgreedDepositPage.blnctrAcc}
        </span>
    </li>
##账户名称
    <li class="mui-table-view-cell">
        #springMessage('table.fcAcc.accName')
        <span class="mui-badge mui-badge-inverted">
            $!{fcAgreedDepositPage.accName}
        </span>
    </li>
##币别
    <li class="mui-table-view-cell">
        #springMessage('table.fcAcc.curId')
        <span class="mui-badge mui-badge-inverted">
            $!{fcAgreedDepositPage.curName}
        </span>
    </li>
##合同号
    <li class="mui-table-view-cell">
        #springMessage('table.cgsBill.pactCode')
        <span class="mui-badge mui-badge-inverted">
            $!{fcAgreedDepositPage.contractNo}
        </span>
    </li>
##到期处理方式
    <li class="mui-table-view-cell">
        #springMessage('table.bisFinanceExc.certificateWay')
        <span class="mui-badge mui-badge-inverted">
            $dictTag.get("agreed.certificateWay",$!{fcAgreedDepositPage.certificateWay})
        </span>
    </li>
##开始日期
    <li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetReport.beginDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.beginDate)
        </span>
    </li>

    #if($!{fcAgreedDepositPage.busType} == 0)
    ##结束日期
        <li class="mui-table-view-cell">
            #springMessage('table.fbsBudgetReport.endDate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.endDate)
        </span>
        </li>
    #elseif($!{fcAgreedDepositPage.busType} == 1)
    ##结束日期
        <li class="mui-table-view-cell">
            #springMessage('table.fbsBudgetReport.endDate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.oldEndDate)
        </span>
        </li>
    ##新结束日期
        <li class="mui-table-view-cell">
            #springMessage('table.fcAgreedDeposit.endDate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.endDate)
        </span>
        </li>
    #elseif($!{fcAgreedDepositPage.busType} == 2)
    ##结束日期
        <li class="mui-table-view-cell">
            #springMessage('table.fbsBudgetReport.endDate')
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.endDate)
        </span>
        </li>
    ##终止日期
        <li class="mui-table-view-cell">
            <td class="textRight">#springMessage('table.fcPredraw.endDate')</td>
            <span class="mui-badge mui-badge-inverted">
                $!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.stopDate)
        </span>
        </li>
    #end
    #if($!{fcAgreedDepositPage.busType} == 0)
    ##是否存入协定账号
        <li class="mui-table-view-cell">
            <td class="textRight">#springMessage('table.fcAgreedDeposit.isAgreedDepositAcc')</td>
            <span class="mui-badge mui-badge-inverted">
                $dictTag.get("sf_yn",$!{fcAgreedDepositPage.isAgreedDepositAcc})
        </span>
        </li>
    #end


    #if($!{fcAgreedDepositPage.isAgreedDepositAcc} == 1)
    ##协定账号
        <li class="mui-table-view-cell">
            <td class="textRight">#springMessage('table.fcAgreedDeposit.agrAcc')</td>
            <span class="mui-badge mui-badge-inverted">
                $!{fcAgreedDepositPage.agrAcc}
        </span>
        </li>
    ##协定利率
        <li class="mui-table-view-cell">
            <td class="textRight">#springMessage('table.btBankAcc.agrInterest')</td>
            <span class="mui-badge mui-badge-inverted">
                $!rateTag.show($!{fcAgreedDepositPage.agrInterest})
        </span>
        </li>
    ##活期账号留存金额
        <li class="mui-table-view-cell">
            <td class="textRight">#springMessage('table.fcAgreedDeposit.retainedBal')</td>
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{fcAgreedDepositPage.retainedBal})
        </span>
        </li>
    #else
    ##协定明细
        <li class="ui-border-t">
            <div class="ui-list-info">
                <ul class="ui-row"
                    style="border-width: 1px; text-align: center;">
                    <li class="ui-col ui-col-50" style="background: #C4E1FF;"
                        style="border-width: 1px; width: 100%;">
                        <table style="border-collapse: collapse;border-spacing: 0; width: 100%; text-align: center;">
                            <thead>
                            <tr>
                                <th>#springMessage('table.fc_charge_type_dtl.min_range_money')（>）</th>##下限金额
                                <th>#springMessage('table.fc_charge_type_dtl.max_range_money')（<=）</th>##上限金额
                                <th>#springMessage('table.btBankAcc.agrInterest')</th>##协定利率
                            </tr>
                            </thead>
                            <tbody style="background: #fff;">
                                #foreach($detail in $!{fcAgreedDepositPage.detailList})
                                    #set($vcount = $velocityCount - 1)
                                <tr data-row="${vcount}">
                                    <td class="textRight">
                                        $!number.formatNumeric($!{detail.minMoney})
                                    </td>
                                    <td class="textRight">
                                        $!number.formatNumeric($!{detail.maxMoney})
                                    </td>
                                    <td class="textRight">
                                        $!rateTag.show($!{detail.agreeRate})
                                    </td>
                                </tr>
                                #end
                            </tbody>
                        </table>
                    </li>
                </ul>
            </div>
        </li>
    #end
</ul>
    #parse("views/common/wapfooter.vm")
</body>

</html>

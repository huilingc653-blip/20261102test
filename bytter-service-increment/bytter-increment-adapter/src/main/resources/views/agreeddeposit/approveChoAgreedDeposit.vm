<!DOCTYPE html>
<html lang="en">
<body>
	<form class="layui-form layui-form-pane">
		<input type="hidden" id="taskId" name= "taskId" value="$!{taskId}">
	</form>
	## 单据类型 0-登记 1-延期 2-终止
		#if($!{fcAgreedDepositPage.busType} == '0')
			#parse("views/agreeddeposit/viewChoRegAgreedDeposit.vm")
		#elseif($!{fcAgreedDepositPage.busType} == '1')
			#parse("views/agreeddeposit/viewChoPosAgreedDeposit.vm")
		#elseif($!{fcAgreedDepositPage.busType} == '2')
			#parse("views/agreeddeposit/viewChoTermAgreedDeposit.vm")
		#end
	#workFlowHtml()
	#workFlowScript()
	<script>
		bt.use(['form','jquery'], function(){
			var $ = bt.jquery,form = bt.form();
			bt.workFlow.beforeSubmit = function(submitData){
				var taskIds = [];
				taskIds.push($("#taskId").val());
				bt.workFlow.taskList = taskIds;
				return true;
			}
			bt.workFlow.afterSubmit = function(){
				parent.layer?parent.layer.closeAll():layer.closeAll();
			}
		});
	</script>
</body>
</html>
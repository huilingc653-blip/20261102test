<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <input type="hidden" id="isAgreedDepositAccTemp" value="$!{fcAgreedDepositPage.isAgreedDepositAcc}"/>
    <input type="hidden" id="id" value="$!{fcAgreedDepositPage.id}"/>
    <input type="hidden" id="busType" value="$!{busType}"/>
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位
            <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
            <td width="35%">$!{fcAgreedDepositPage.corpName}</td>
        ##账号
            <td class="textRight">#springMessage('table.fcAcc.account')</td>
            <td width="35%">$!{fcAgreedDepositPage.blnctrAcc}</td>
        </tr>
        <tr>
        ##账户名称
            <td class="textRight">#springMessage('table.fcAcc.accName')</td>
            <td width="35%">$!{fcAgreedDepositPage.accName}</td>
        ##币别
            <td class="textRight">#springMessage('table.fcAcc.curId')</td>
            <td width="35%">$!{fcAgreedDepositPage.curName}</td>
        </tr>
        <tr>
        ##合同号
            <td class="textRight">#springMessage('table.cgsBill.pactCode')</td>
            <td width="35%">$!{fcAgreedDepositPage.contractNo}</td>
        ##到期处理方式
            <td class="textRight">#springMessage('table.bisFinanceExc.certificateWay')</td>
            <td width="35%">$dictTag.get("agreed.certificateWay",$!{fcAgreedDepositPage.certificateWay})</td>
        </tr>
        <tr>
        ##开始日期
            <td class="textRight">#springMessage('table.fbsBudgetReport.beginDate')</td>
            <td width="35%">$!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.beginDate)</td>
        ##结束日期
            <td class="textRight">#springMessage('table.fbsBudgetReport.endDate')</td>
            <td width="35%">$!date.format('yyyy-MM-dd',$!fcAgreedDepositPage.endDate)</td>
        </tr>
        <tr>
        ##是否存入协定账号
            <td class="textRight">#springMessage('table.fcAgreedDeposit.isAgreedDepositAcc')</td>
            <td width="35%">$dictTag.get("sf_yn",$!{fcAgreedDepositPage.isAgreedDepositAcc})</td>
            #if($!{fcAgreedDepositPage.isAgreedDepositAcc} == 1)
            ##协定利率
                <td class="textRight isAcc">#springMessage('table.btBankAcc.agrInterest')</td>
                <td class="isAcc isAcc" width="35%">$!rateTag.show($!{fcAgreedDepositPage.agrInterest})</td>
            #else
                <td></td>
                <td></td>
            #end

        </tr>
            #if($!{fcAgreedDepositPage.isAgreedDepositAcc} == 1)
            <tr class="isAcc">
            ##协定账号
                <td class="textRight">#springMessage('table.fcAgreedDeposit.agrAcc')</td>
                <td width="35%">$!{fcAgreedDepositPage.agrAcc}</td>
            ##活期账号留存金额
                <td class="textRight">#springMessage('table.fcAgreedDeposit.retainedBal')</td>
                <td width="35%">$!number.formatNumeric($!{fcAgreedDepositPage.retainedBal})</td>
            </tr>
            #end

        </tbody>
    </table>
    #if($!{fcAgreedDepositPage.isAgreedDepositAcc} == 0)
        <table id="dataTable" class="layui-table">
            <thead>
            <th style="text-align: center;">#springMessage('table.fc_charge_type_dtl.min_range_money')（>）</th>
            <th style="text-align: center;">#springMessage('table.fc_charge_type_dtl.max_range_money')（<=）</th>
            <th style="text-align: center;">#springMessage('table.btBankAcc.agrInterest')</th>
            </thead>
            <tbody>
                #foreach($detail in $!{fcAgreedDepositPage.detailList})
                    #set($vcount = $velocityCount - 1)
                <tr data-row="${vcount}">
                    <td class="textRight">
                        $!number.formatNumeric($!{detail.minMoney})
                    </td>
                    <td class="textRight">
                        $!number.formatNumeric($!{detail.maxMoney})
                    </td>
                    <td class="textRight">
                        $!rateTag.show($!{detail.agreeRate})
                    </td>
                </tr>
                #end
            </tbody>
        </table>
    #end
    <!-- 日志 -->
    <div id="tagMsg"></div>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button type="button" class="layui-btn"
                    onclick="bt.trackFlowByBusinessId('$!{fcAgreedDepositPage.id}')">#springMessage(
                'common.button.trackFlow')</button>
            <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage(
                'common.button.print')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/agreeddeposit/choRegAgreedDeposit.view.js?_btv=${resourceVersion}"></script>
</body>
</html>
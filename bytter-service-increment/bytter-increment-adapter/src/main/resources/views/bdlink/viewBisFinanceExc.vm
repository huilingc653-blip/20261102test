<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<div id="print">
			<input id="id" name="id" type="hidden" value="$!{bisFinanceExcPage.id}">
			<input id="busType" name="busType" type="hidden" value="$!{busType}">
		<table class="layui-table">
			<thead>
            <tr>
                <th colspan="4" style="text-align:center">#springMessage('table.bisFinanceExc.view')</th>
			</tr>
			</thead>
			<tbody>
			<tr>
        		##指令编号
				<td class="textRight">#springMessage('table.bisFinanceExc.voucherNo')</td>
				<td width="35%">$!{bisFinanceExcPage.voucherNo}</td>
				##申请日期
				<td class="textRight">#springMessage('table.bisFinanceExc.reqDate')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{bisFinanceExcPage.reqDate})</td>		
        	</tr>
			<tr>
				##单位
				<td class="textRight">#springMessage('table.bisFinanceExc.corpId')</td>
				<td width="35%">$!{bisFinanceExcPage.corpName}</td>	
				##业务类型
				<td class="textRight">#springMessage('table.bisFinanceExc.busType')</td>
				<td width="35%">$dictTag.get("choBankFinance.busType",$!{bisFinanceExcPage.busType})</td>
        	</tr>
			<tr>
        		##付款账号
				<td class="textRight">#springMessage('table.bisFinanceExc.payerAcc')</td>
				<td width="35%">$!{bisFinanceExcPage.payerAcc}</td>
				##付款账号名称
				<td class="textRight">#springMessage('table.bisFinanceExc.payerAccName')</td>
				<td width="35%">$!{bisFinanceExcPage.payerAccName}</td>				
        	</tr>
			<tr>
        		##收款账号
				<td class="textRight">#springMessage('table.bisFinanceExc.payeeAcc')</td>
				<td width="35%">$!{bisFinanceExcPage.payeeAcc}</td>
				##收款账号名称
				<td class="textRight">#springMessage('table.bisFinanceExc.payeeAccName')</td>
				<td width="35%">$!{bisFinanceExcPage.payeeAccName}</td>				
        	</tr>
        	<tr>
        		##银企接口
				<td class="textRight">#springMessage('table.bisFinanceExc.bifCode')</td>
				<td width="35%">$!{bisFinanceExcPage.bifName}</td>
				##币别
				<td class="textRight">#springMessage('table.bisFinanceExc.curId')</td>
				<td width="35%">$!{bisFinanceExcPage.curName}</td>				
        	</tr>
			<tr>
        		##金额
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
				<td width="35%">
                    $!number.formatNumeric($!{bisFinanceExcPage.payMoney})
					<input type="hidden" data-name="payMoney" data-toUp="payMoneyUp" autocomplete="off" 
						class="layui-input bt-biz-moneyType" value="$!{bisFinanceExcPage.payMoney}">
				</td>
				<td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
				<td width="35%" style="padding-left:0px"><div id="payMoneyUp"></div></td>
        	</tr>
			<tr>
				##期限
				<td class="textRight">#springMessage('table.bisFinanceExc.dayLimit')</td>
				<td width="35%">$!{bisFinanceExcPage.dayLimit}$dictTag.get("choBankFinance.dateUnit",$!{bisFinanceExcPage.dateUnit})</td>
        		##会计凭证号
				<td class="textRight">#springMessage('table.bisFinanceExc.bursarBillNo')</td>
				<td width="35%">$!{bisFinanceExcPage.bursarBillNo}</td>
        	</tr>
			<tr>
        		##到期处理方式
				<td class="textRight">#springMessage('table.bisFinanceExc.certificateWay')</td>
				<td width="35%">$dictTag.get("choBankFinance.certificateWay",$!{bisFinanceExcPage.certificateWay})</td>
        		##期望支付日期
				<td class="textRight">#springMessage('table.bisFinanceExc.wishPayday')</td>
				<td width="35%">$!date.format('yyyy-MM-dd',$!{bisFinanceExcPage.wishPayday})</td>
        	</tr>
			<tr>
        		##用途
				<td class="textRight">#springMessage('table.bisFinanceExc.purpose')</td>
				<td colspan="3">$!{bisFinanceExcPage.purpose}</td>
        	</tr>
			<tr>
        		##交易状态
				<td class="textRight">#springMessage('table.bisExc.voucherStat')</td>
				<td width="35%">$dictTag.get("bisExc.voucherStat",$!{bisFinanceExcPage.voucherStat})</td>
				##交易时间
				<td class="textRight">#springMessage('table.bisExc.transTime')</td>
				<td width="35%">$!date.format('yyyy-MM-dd HH:mm:ss',$!{bisFinanceExcPage.transTime})</td>
        	</tr>
			<tr>
        		##银行返回时间
				<td class="textRight">#springMessage('table.bisExc.returnTime')</td>
				<td width="35%">$!date.format('yyyy-MM-dd HH:mm:ss',$!{bisFinanceExcPage.returnTime})</td>
				##银行流水号
				<td class="textRight">#springMessage('table.bisExc.bankSerialNo')</td>
				<td width="35%">$!{bisFinanceExcPage.bankSerialNo}</td>
        	</tr>
			<tr>
        		##返回信息
				<td class="textRight">#springMessage('table.bisExc.firstReturnMsg')</td>
				<td width="35%">$!{bisFinanceExcPage.firstReturnMsg}</td>
				##返回信息
				<td class="textRight">#springMessage('table.bisExc.nextReturnMsg')</td>
				<td width="35%">$!{bisFinanceExcPage.nextReturnMsg}</td>
        	</tr>
			</tbody>
        </table>
		</div>
		<!-- 日志 -->
		<div id="tagMsg"></div>
		<div class="layui-form-item layui-form-submit" id="buttonDiv">
    		<div class="layui-input-block">
                <button type="button" class="layui-btn bt-biz-printType" data-printareaid="print">#springMessage('common.button.print')</button>
    		</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script >
bt.use(['form','layedit','moneyType','printType'], function(){
    var $ = bt.jquery,form = bt.form();
    var moneyType = bt.moneyType.init();
    var moneyFun = bt.moneyType.getFun();
	bt.printType.init();
	
	/**
     * 生成日志列表
     * @return
     */
	$genMsgHtml= function() {
		var url=basePath + "/chowmatistic/chomessage/list/"+$('#id').val()+"/"+$("#busType").val();
        $.ajax({
            url:url,
            method: 'GET',
            async:false,
            success: function (json) {
                $("#tagMsg").html("");
                $("#tagMsg").html(json);
                form.render();
            }
        });
    }
	$genMsgHtml();
});
</script>
</html>
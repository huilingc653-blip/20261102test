<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<input id="opType" name="opType" type="hidden" value="listSend">
        <table class="layui-table">
            <tbody>
				<tr>
					##单位
                    <td class="textRight">#springMessage('table.bisExc.corpId')</td>
                    <td>
                        <div class="layui-inline">
                        	<div class="bt-biz-corp"
                            data-biz-type="corp"
                            data-type="selectTree"
                            data-name="likes_corpId"
							data-resource="netbank:bdLink:bisFinanceExc:sendQuery"
                            data-scope="all"></div>
                        </div>
                    </td>
					##接口代码
                    <td class="textRight">#springMessage('table.bisFinanceExc.bifCode')</td>
                    <td >
                        <div data-name="eqs_bifCode" class="bt-biz-selectType" data-url="${basePath}/basic/business/bisbifinit/listFilter" data-valueField="id" data-textField="name"
                             data-search="true" data-defaultval="$!{bisFinanceExcPage.bifCode}"></div>
                    </td>
                    ##付款账号
                    <td class="textRight">#springMessage('table.bisFinanceExc.payerAcc')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_payerAcc"
                                    autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.bisFinanceExc.payerAcc')">
                        </div>
                    </td>
				</tr>
                <tr>
					##业务类型
                    <td class="textRight">#springMessage('table.bisFinanceExc.busType')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="select" 
    							data-group="choBankFinance.busType" data-name="eqi_busType"></div>
                    </td>
                    ##收款账号
                    <td class="textRight">#springMessage('table.bisFinanceExc.payeeAcc')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_payeeAcc"
                                    autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.bisFinanceExc.payeeAcc')">
                        </div>
                    </td>
                    ##金额
                    <td class="textRight">#springMessage('table.bisFinanceExc.payMoney')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" name="geg_payMoney"
                                    autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.bisFinanceExc.payMoney')">
                        <span class="date-mid">~</span>
                            <input type="text" name="leg_payMoney"
                                    autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" style="text-align:right" id="t20"  placeholder="#springMessage('table.bisFinanceExc.payMoney')">
                        </div>
                	</td>
				</tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('table.bisFinanceExc.voucherNo')</th>
		<th>#springMessage('table.bisFinanceExc.corpId')</th>
		<th>#springMessage('table.bisFinanceExc.busType')</th>
		<th>#springMessage('table.bisFinanceExc.bifCode')</th>
		<th>#springMessage('table.bisFinanceExc.payerAcc')</th>
        <th>#springMessage('table.bisFinanceExc.payerAccName')</th>
        <th>#springMessage('table.bisFinanceExc.payerBank')</th>
		<th>#springMessage('table.bisFinanceExc.payeeAcc')</th>
		<th>#springMessage('table.bisFinanceExc.dayLimit')</th>
		<th>#springMessage('table.bisFinanceExc.curId')</th>
		<th>#springMessage('table.bisFinanceExc.payMoney')</th>
		<th>#springMessage('table.bisFinanceExc.reqDate')</th>
		<th>#springMessage('table.bisFinanceExc.cbsBillId')</th>
        <th>#springMessage('table.bisFinanceExc.voucherStat')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bdlink/bisFinanceExc.listSend.js?_btv=${resourceVersion}"></script>
</html>

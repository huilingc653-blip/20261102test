<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
		<input id="opType" name="opType" type="hidden" value="listSel">
		<input id="busType" name="busType" type="hidden" value="$!{busType}">
		<input id="likes_corpId" name="likes_corpId" type="hidden" value="$!{corpId}">
        <table class="layui-table">
            <tbody>
				<tr>
                    ##业务单号
                    <td class="textRight">#springMessage('table.choBankFinance.billNo')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_billNo"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.choBankFinance.billNo')">
                        </div>
                    </td>
                    ##付款账号
                    <td class="textRight">#springMessage('table.choBankFinance.currentAcc')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_payerAcc"
                                    autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.choBankFinance.payerAcc')">
                        </div>
                    </td>
                    ##收款账号
                    <td class="textRight">
                        #if($!{busType} == 10)
                            #springMessage('table.choBankFinance.timeAcc')
                        #end
                        #if($!{busType} == 12)
                            #springMessage('table.choBankFinance.noticeAcc')
                        #end
                    </td>
                    <td>
                        <div class="layui-input-inline">
                            #if($!{busType} == 10)
                                <input type="text" name="likes_payeeAcc"
                                       autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.choBankFinance.timeAcc')">
                            #end
                            #if($!{busType} == 12)
                                <input type="text" name="likes_payeeAcc"
                                       autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.choBankFinance.noticeAcc')">
                            #end
                        </div>
                    </td>
				</tr>
                <tr>
                    ##单号
                    <td class="textRight">#springMessage('table.choBankFinance.bankBillNo')</td>
                    <td>
                        <div class="layui-input-inline">
                                <input type="text" name="likes_bankBillNo"
                                       autocomplete="off" class="layui-input" placeholder="#springMessage('table.choBankFinance.bankBillNo')">
                        </div>
                    </td>
                    ##金额
                    <td class="textRight">#springMessage('table.bisFinanceExc.payMoney')</td>
                    <td colspan="3">
                        <div class="layui-inline">
                            <input type="text" name="geg_payMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.bisFinanceExc.payMoney')">
                            <span class="date-mid">~</span>
                            <input type="text" name="leg_payMoney"
                                   autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline" style="text-align:right" id="t20"  placeholder="#springMessage('table.bisFinanceExc.payMoney')">
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('common.table.thead.operation')</th>
        <th>#springMessage('table.choBankFinance.billNo')</th>
        <th>#springMessage('table.choBankFinance.currentAcc')</th>
        #if($!{busType} == 10)
            <th>#springMessage('table.choBankFinance.timeAcc')</th>
        #end
        #if($!{busType} == 12)
            <th>#springMessage('table.choBankFinance.noticeAcc')</th>
        #end
        <th>#springMessage('table.choBankFinance.corpId')</th>
        <th>#springMessage('table.choBankFinance.curId')</th>
        <th>#springMessage('table.choBankFinance.payMoney')</th>
        <th>#springMessage('table.choBankFinance.drawMoney')</th>
        <th>#springMessage('table.choBankFinance.drawBal')</th>
        <th>#springMessage('table.choBankFinance.blInterestRate')</th>
        <th>#springMessage('table.choBankFinance.interestStartDate')</th>
        <th>#springMessage('table.choBankFinance.deadlineDate')</th>
        <th>#springMessage('table.btBankAcc.isOnline')</th>
        <th>#springMessage('table.choBankFinance.bankBillNo')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bdlink/bisFinanceExc.select.js?_btv=${resourceVersion}"></script>
</html>

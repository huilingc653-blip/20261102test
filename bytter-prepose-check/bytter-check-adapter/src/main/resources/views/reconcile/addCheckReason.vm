<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="inputForm" class="layui-form input150-container">
	<input type="hidden" id="id" name="id" value="$!{checkReasonVo.id}"/> 
	<input type="hidden" id="createBy" name="createBy" value="$!{checkReasonVo.createBy}"/>
	<input type="hidden" id="createDate" name="createDate" value="$!{checkReasonVo.createDate}"/>
    <table class="layui-table">
        <tbody>
        <tr>
	        ##原因代码
	        <td class="textRight" width="16%">#springMessage('bis.check.reson.code')</td>
	        <td width="34%">
               <div class="layui-input-inline">
                   <input type="text" name="reasonCode"  
                   value="$!{checkReasonVo.reasonCode}"
                   	#if($!{flag}) disabled #end
                   lay-verify="required" 
                   autocomplete="off" class="layui-input" placeholder="#springMessage('bis.check.reson.code')">
               </div>
	        </td>
	        ##原因名称
	        <td class="textRight" width="16%">#springMessage('bis.check.reson.name')</td>
	        <td width="34%">
	               <div class="layui-input-inline">
	                   <input type="text" name="reasonName" 
	                    value="$!{checkReasonVo.reasonName}"
	                    lay-verify="required"  autocomplete="off" class="layui-input" placeholder="#springMessage('bis.check.reson.name')">
	               </div>
	        </td>
        </tr>
        <tr>
	        ##银行类型
	        <td class="textRight" width="16%">#springMessage('table.ratBkration.bankType')</td>
	        <td width="34%">
	              	<div data-name="bankTypeId" class="bt-biz-selectType"
							 data-url="${basePath}/basic/business/btbanktype/json/1"
							 data-valueField="id"
							 data-biz-name="bankTypeId"
							 data-textField="typeName"
							 data-required="true"
							 data-search="true" data-defaultvalue="$!{checkReasonVo.bankTypeId}"></div>
	        </td>
	        ##适用范围
	        <td class="textRight" width="16%">#springMessage('bis.check.reson.appScope')</td>
	        <td width="34%">
                <div class="layui-input-inline">
                      <div class="bt-biz-dict"
                      data-defaultvalue="$!{checkReasonVo.appScope}"
                       data-type="mulselect" data-group="BIS_CHECK_REASON_SCOPE" data-name="appScope"
                         data-biz-name="appScope" data-required="true"></div>
                </div>
	        </td>
        </tr>
        <tr>
	        ##有效标记
	        <td class="textRight" width="16%">#springMessage('btBankType.validSign')</td>
	        <td width="34%">
               <div class="layui-inline">
                    <div class="bt-biz-dict"
                    	value="$!{checkReasonVo.validSign}"
                     data-type="radio" data-group="valid_sign" data-defaultvalue="1" data-name="validSign" data-biz-name="validSign" data-required="true"></div>
                </div>
	        </td>
        </tr>
        
        </tbody>
    </table>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" type="button" lay-filter="save">#springMessage('common.button.save')</button>
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/reconcile/bisCheckReason.add.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="inputForm" class="layui-form input150-container">
    <table class="layui-table">
       <tbody>
        #if($!dtlVo.checkResult eq 'Y')
         <tr>
	        ##余额核对状态
	        <td class="textRight" width="16%">#springMessage('bis.check.the.status')</td>
	        <td width="34%">
               <div class="layui-input-inline">
					$!{dtlVo.checkResultName}
               </div>
	        </td>
        </tr>
        #end
        #if($!dtlVo.checkResult eq 'N' || $!dtlVo.checkResult eq 'T')
        <tr>
	        ##余额核对状态
	        <td class="textRight" width="16%">#springMessage('bis.check.the.status')</td>
	        <td width="34%">
               <div class="layui-input-inline">
					$!{dtlVo.checkResultName}
               </div>
	        </td>
	         #if($!dtlVo.checkResult eq 'N')
	         ##余额对账不符原因
	        <td class="textRight" width="16%">#springMessage('bis.check.not.why')</td>
	        <td width="34%">
               <div class="layui-input-inline">
					$!{dtlVo.reasonName}
               </div>
	        </td>
	         #end
	         #if($!dtlVo.checkResult eq 'T')
	         ##余额对账调节原因类型
	        <td class="textRight" width="16%">#springMessage('bis.check.reson.suretype')</td>
	        <td width="34%">
               <div class="layui-input-inline">
					$!{dtlVo.reasonName}
               </div>
	        </td>
	        #end
        </tr>
        <tr>
	        ##手机号
	        <td class="textRight" width="16%">#springMessage('bis.check.mobileNo')</td>
	        <td width="34%">
	               <div class="layui-input-inline">
					$!{dtlVo.mobileNo}
	               </div>
	        </td>
	        ##备注
	        <td class="textRight" width="16%">#springMessage('btBankType.rmk')</td>
	        <td width="34%">
               <div class="layui-input-inline">
					$!{dtlVo.rmk}
               </div>
	        </td>
        </tr>
        #end
        
       </tbody>
    </table>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

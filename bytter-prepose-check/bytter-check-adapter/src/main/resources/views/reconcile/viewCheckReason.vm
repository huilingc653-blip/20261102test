<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="inputForm" class="layui-form input150-container">
    <table class="layui-table">
       <tbody>
        <tr>
	        ##原因代码
	        <td class="textRight" width="16%">#springMessage('bis.check.reson.code')</td>
	        <td width="34%">
	               <div class="layui-input-inline">
						$!{checkReasonVo.reasonCode}
	               </div>
	        </td>
	        ##原因名称
	        <td class="textRight" width="16%">#springMessage('bis.check.reson.name')</td>
	        <td width="34%">
               <div class="layui-input-inline">
					$!{checkReasonVo.reasonName}
               </div>
	        </td>
        </tr>
        <tr>
	        ##银行类型
	        <td class="textRight" width="16%">#springMessage('table.ratBkration.bankType')</td>
	        <td width="34%">
	              	$!{checkReasonVo.bankTypeName}
	        </td>
	        ##适用范围
	        <td class="textRight" width="16%">#springMessage('bis.check.reson.appScope')</td>
	        <td width="34%">
              		$!{checkReasonVo.appScopeName}
	        </td>
        </tr>
        
         <tr>
	        ##有效标记
	        <td class="textRight" width="16%">#springMessage('btBankType.validSign')</td>
	        <td width="34%">
					$!{checkReasonVo.validSignName}
	        </td>
        </tr>
        
       </tbody>
    </table>
    <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" type="button" onclick="closeForms()">#springMessage('common.button.revert')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <div class="layui-collapse" lay-filter="collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title"></h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table">
                    <tbody>
                    <tr>
                        ## 所属单位
                        <td class="textRight" width="8%">#springMessage('table.abVoucherinfoVice.corpId')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-corp"
                                     data-biz-type="corp"
                                     data-type="selectTree"
                                     data-biz-name="corpId"
                                     data-name="ins_corpId"
                                     data-scope="all"
                                     data-resource="bis:bank:statetracking:check:query"
                                     data-callbackData="corpCallback"
                                     data-placeholder="#springMessage('table.abVoucherinfoVice.corpId')">
                                </div>
                            </div>
                        </td>
                        ## 银行类型
                        <td class="textRight">#springMessage('table.ratBkration.bankType')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-selectType"
                                     data-url="${basePath}/basic/business/btbanktype/json/1"
                                     data-method="get" data-callback="bankTypeChange" data-extraData="false"
                                     data-valuefield="id" data-textfield="typeName" data-biz-name="bankTypeId"
                                     data-name="ins_bankTypeId" data-inputvalue="inputvalue" data-search="true"></div>
                            </div>
                        </td>
                        ## 账单日期
                        <td class="textRight">#springMessage('ttpay.billDate')</td>
                        <td width="25%">
                            <div class="layui-inline">
                                <input type="text" name="ged_toBillDate" data-name="ged_toBillDate"
                                       class="layui-input bt-biz-dateType" id="dateStart" data-endid="dateEnd"
                                       value="$!{dateStart}" data-type="date"/>
                            </div>
                            ~
                            <div class="layui-inline">
                                <input type="text" name="led_toBillDate" data-name="led_toBillDate"
                                       class="layui-input bt-biz-dateType" id="dateEnd"
                                       value="$!{dateEnd}" data-type="date"/>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('bis.bank.Enterprise.billNo')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="likes_billNo" autocomplete="off" class="layui-input"
                                       placeholder="#springMessage('bis.bank.Enterprise.billNo')">
                            </div>
                        </td>
                        <td class="textRight">#springMessage('table.btBankAccApp.bankAcc')</td>
                        <td width="25%">
                            <div class="layui-input-inline" id="pledgeeAccDiv1">
                                <input type="text" id="ins_bankAcc" name="ins_bankAcc" data-name="ins_bankAcc"
                                       data-biz-name="ins_bankAcc"
                                       class="bank layui-input bt-biz-accountTable" data-callback="accountPayeeCallBack"
                                       placeholder="#springMessage('table.rasbankcardbinding.bankNo')">
                            </div>

                        </td>
                        <td class="textRight">#springMessage('table.fcPredrawDtlTemp.balance')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input type="text" name="geg_bal" data-moneyendid="leg_bal" autocomplete="off"
                                       data-endid="mEnd"
                                       class="layui-input bt-input-inline  bt-biz-moneyType">
                                <span class="date-mid">~</span>
                                <input type="text" name="leg_bal" id="leg_bal" autocomplete="off" id="mEnd"
                                       class="layui-input bt-input-inline  bt-biz-moneyType">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">#springMessage('bis.bank.enterprise.check.data')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-beforeinit="busBefore"
                                     data-type="mulselect" data-group="bisExc.voucherStat" data-name="ins_voucherStat"
                                     data-biz-name="voucherStat"></div>
                            </div>
                        </td>
                        <td class="textRight">#springMessage('bis.bank.enterprise.check.restate')</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict"
                                     data-type="mulselect" data-group="bisCheckDtl.checkStatus" data-name="ins_checkStatus"
                                     data-biz-name="checkStatus"></div>
                            </div>
                        </td>
                        <td class="textRight">对账账户</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <input class="layui-input" type="text" name="checkAccount" autocomplete="off" placeholder="对账账户">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="textRight">是否保证金</td>
                        <td width="25%">
                            <div class="layui-input-inline">
                                <div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-name="isBail" data-biz-name="isBail"></div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
                            <button class="layui-btn" lay-submit="" type="button" lay-filter="search"
                                    type="button">#springMessage('common.button.search')</button>
                            <button type="reset" onclick="resetFristCarryOver()"
                                    class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.nisPersonnelDetail.corpId')</th>
        <th>#springMessage('btBankType.typeName')</th>
        <th>#springMessage('bis.bank.Enterprise.billNo')</th>
        <th>#springMessage('table.btBankAccApp.bankAcc')</th>
        <th>#springMessage('table.btBankAccApp.accName')</th>
        <th>#springMessage('table.fcAccBalance.curId')</th>
        <th>#springMessage('ttpay.billDate')</th>
        <th>#springMessage('table.fcPredrawDtlTemp.balance')</th>
        <th>#springMessage('bis.bank.enterprise.results')</th>
        <th>#springMessage('bis.bank.enterprise.compare.data')</th>
        <th>对账账户</th>
        <th>是否保证金</th>
        <th>#springMessage('bis.bank.enterprise.check.data')</th>
        <th>#springMessage('bis.bank.enterprise.result.data')</th>
        <th>#springMessage('bis.bank.enterprise.check.restate')</th>
        <th>#springMessage('bis.bank.enterprise.restate')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>

    #parse("views/common/footer.vm")
</body>
    ##<script src="${basePath}/static/modules/reconcile/bisBankEnterpriseCheck.list.js?_btv=${resourceVersion}"></script>
<script>
    var datatable = {}, mulselect, corp, accccountTable;
    bt.use(['form', 'selectTable', 'datatable', 'bank', 'accountTable', 'moneyType', 'layedit', 'btdate', 'corp', 'selectType', 'dateType', 'element', 'dicts', 'mulselect'], function () {
        $ = bt.jquery, form = bt.form();
        bt.corp.init();
        bt.bank.init({elem: '.bank'});
        bt.dicts.init();
        bt.moneyType.init();
        bt.dateType.init();
        mulselect = bt.mulselect.init();
        accccountTable = bt.accountTable.init({urldata: {accountType: '2'}});
        corp = bt.corp.init();
        var selectType = bt.selectType.init();
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            dom: 'Brtlip',
            colReorder: true,
            checkbox: true,
            order: [[1, 'desc']],
            searchForm: {
                formElem: "#searchForm",
                formFilter: "search"
            },
            ajax: {
                'url': basePath + "/bis/stateTracking/datatable"
            },
            buttons: [
                {
                    text: bt.lang('common.button.batchCheck'),
                    hide: bt.isnotResource('bis:bank:statetracking:check:opt'),
                    action: function (e, dt, node, config) {
                        optSure(dt.rows('.selected').data(), "N");
                    }
                }, {
                    text: bt.lang('common.button.batchResend'),
                    hide: bt.isnotResource('bis:bank:statetracking:check:opt'),
                    action: function (e, dt, node, config) {
                        batchResend(dt.rows('.selected').data());
                    }
                },
                {
                    extend: "colvis",
                    text: bt.lang('common.button.theadHide'),
                    columns: ':not(:first):not(:last)'
                }
            ]
            , columns: [
                {data: "corpCodeAndName", bSortable: false, className: 'center'},
                {data: "bankTypeName", bSortable: false, className: 'center'},
                {data: "billNo", bSortable: true, className: 'center'},
                {data: "bankAcc", bSortable: true, className: 'center'},
                {data: "accName", bSortable: false, className: 'center'},
                {data: "curName", bSortable: false, className: 'center'},
                {data: "toBillDate", bSortable: true, className: 'center'},
                {
                    data: "bal", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.bal);
                    }
                },
                {data: "checkResultName", bSortable: false, className: 'center'},
                {
                    data: "checkDate", bSortable: true, className: 'textRight',
                    render: function (data, type, full, meta) {
                        return bt.date.format(full.checkDate, "yyyy-mm-dd");
                    }
                },
                {data: "checkAccount", bSortable: false, className: 'center'},
                {
                    data: "isBail", bSortable: false, className: 'center',
                    render: function (data, type, full, meta) {
                        return bt.dict("sf_yn", full.isBail)
                    }
                },
                {data: "voucherStatName", bSortable: false, className: 'center'},
                {data: "returnTime", bSortable: true, className: 'center'},
                {data: "checkStatusName", bSortable: false, className: 'center'},
                {data: "checkStatName", bSortable: false, className: 'center'},
                {
                    data: null, bSortable: false, className: 'center', render: function (data, type, full, meta) {
                        var html = '';
                        html = html + '<a class="" href="#" data-row="' + meta.row + '" onclick="view(this)">' + bt.lang("common.button.view") + '</a>';
                        if (data.checkStatus == "0" && bt.isResource('bis:bank:statetracking:check:opt')) {
                            html = html + '<span class="text-explode">|</span><a class="" href="#" data-row="' + meta.row + '" onclick="recombination(this)">' + bt.lang("table.accbook.recombination") + '</a>';
                        }
                        if ((data.voucherStat == "2" || data.voucherStat == "9") && bt.isResource('bis:bank:statetracking:check:opt')) {
                            html = html + '<span class="text-explode">|</span><a class="" href="#" data-row="' + meta.row + '" onclick="resend(this)">' + bt.lang("common.button.resend") + '</a>';
                        }
                        return html;
                    }
                }
            ]
        });

    });


    //业务种类初始化前回调
    var busBefore = function (data, arguments) {
        var bs = new Array(3);
        var i, j = 0;
        for (i = 0; i < data.length; i++) {
            if (data[i].value == "1" | data[i].value == "3" | data[i].value == "2"
                    | data[i].value == "9" | data[i].value == "0") {
                bs[j++] = data[i]
            }
        }
        return bs;
    }


    function view(el) {
        var data = datatable.row(layui.jquery(el).data("row")).data();
        if (bt.navtab) {
            bt.navtab.addNavtab(bt.lang('common.button.view'), basePath + "/bis/stateTracking/view/" + data.id);
            return;
        }
    }

    function recombination(el) {
        var data = datatable.row(layui.jquery(el).data("row")).data();
        var opt;
        var url = basePath + "/bis/stateTracking/reviewRecord?opt=" + opt + "&ids=" + data.id + "&bankTypeId=" + data.bankTypeId;
        parent.layer.open({
            type: 2,
            area: ['750px', '269px'],
            maxmin: true,
            content: url,
            end: function () {
                bt.datatable.refreshCurrentPage();
            }
        });

    }


    function optSure(data, opt) {
        var len = data.length;
        if (!len) {
            layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 7});
            return;
        }
        //校验数据权限
        var rowData = data.splice(0, len);
        var ids;
        var appScope = rowData[0].appScope;
        var bankTypeId = rowData[0].bankTypeId;
        var corpId = rowData[0].corpId;
        for (i = 0; i < len; i++) {
            if (bankTypeId != rowData[i].bankTypeId | corpId != rowData[i].corpId) {
                layer.alert(bt.lang('bis.bank.enterprise.repeat.msg'), {icon: 2});
                return false;
            }
            if (ids) {
                ids = ids + "," + rowData[i].id;
            } else {
                ids = rowData[i].id;
            }

        }
        var url = basePath + "/bis/stateTracking/reviewRecord?opt=" + opt + "&ids=" + ids + "&bankTypeId=" + bankTypeId;
        parent.layer.open({
            type: 2,
            area: ['750px', '269px'],
            scrollbar: false,
            content: url,
            end: function () {
                bt.datatable.refreshCurrentPage();
            }
        });

    }

    //批量重发
    function batchResend(data) {
        var len = data.length;
        if (!len) {
            layer.alert(bt.lang('common.message.confirm.selectData'), {icon: 7});
            return;
        }
        //校验数据权限
        var rowData = data.splice(0, len);
        var ids;
        var bankTypeId = rowData[0].bankTypeId;
        var corpId = rowData[0].corpId;
        for (i = 0; i < len; i++) {
            if (bankTypeId != rowData[i].bankTypeId | corpId != rowData[i].corpId) {
                layer.alert(bt.lang('bis.bank.enterprise.repeat.msg'), {icon: 2});
                return false;
            }
            //如果选择的数据不为接口处理失败或银行接口处理失败的数据则不能重发
            if (rowData[i].voucherStat != "2" && rowData[i].voucherStat != "9") {
                layer.alert(bt.lang('bis.bank.enterprise.resend.msg'), {icon: 2});
                return false;
            }
            if (ids) {
                ids = ids + "," + rowData[i].bisExcId;
            } else {
                ids = rowData[i].bisExcId;
            }

        }
        var bean = new Object();
        bean.bisExcId = ids;
        parent.layer.confirm(bt.lang('common.message.confirm.bisquerycmd.resend'), function () {
            bt.loading.show();
            $.post(basePath + "/bis/stateTracking/reSend", bean, function (result) {
                bt.loading.hide();
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                if (result.success) {
                    bt.datatable.refreshCurrentPage();
                }
            }, 'JSON');
        });
    }

    //重发
    function resend(el) {
        var data = datatable.row(layui.jquery(el).data("row")).data();
        var bean = new Object();
        bean.bisExcId = data.bisExcId;
        parent.layer.confirm(bt.lang('common.message.confirm.bisquerycmd.resend'), function () {
            bt.loading.show();
            $.post(basePath + "/bis/stateTracking/reSend", bean, function (result) {
                bt.loading.hide();
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                if (result.success) {
                    bt.datatable.refreshCurrentPage();
                }
            }, 'JSON');
        });
    }

    //选择出票人账户回调方法
    function accountPayeeCallBack(data) {
        var $ = bt.jquery;
        $("#ins_bankAcc").val(data.bankAcc);
    }


    function resetFristCarryOver() {
        accccountTable.get("ins_bankAcc").reload({urldata: {corpId: null}});
    }


    function corpCallback(data) {
        var bankTypeId = $('select[name="ins_bankTypeId"]').val();
        accccountTable.get("ins_bankAcc").reload({
            urldata: {
                corpId: data.id,
                bankTypeId: bankTypeId,
                permission: "",
                ignorePermission: "true"
            }
        });
    }

    function bankTypeChange(data) {
        var corpId = bt.corp.get("corpId").val();
        accccountTable.get("ins_bankAcc").reload({
            urldata: {
                corpId: corpId,
                bankTypeId: data.id,
                permission: "",
                ignorePermission: "true"
            }
        });
    }

</script>
</html>

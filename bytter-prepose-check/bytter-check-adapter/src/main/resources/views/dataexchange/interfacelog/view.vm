<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<input id="id" name="id" type="hidden" value="$!{dslInterfaceLogVo.id}">

		<table class="layui-table">
			<tbody>
				<tr>
    				<td width="10%" class="textRight">接口名称</td>
					<td width="40%">
						$!{dslInterfaceLogVo.interfaceName}
					</td>
                    <td width="10%" class="textRight">接口代码</td>
                    <td width="40%">
						$!{dslInterfaceLogVo.interfaceCode}
                    </td>

				</tr>
                <tr>
                    <td width="10%" class="textRight">状态</td>
                    <td width="40%">
						#if($!{dslInterfaceLogVo.type} == "1")
							成功
						#else
							失败
						#end
                    </td>
                    <td width="10%" class="textRight">时间</td>
                    <td width="40%">
						$!date.format('yyyy-MM-dd HH:mm:ss',$!{dslInterfaceLogVo.logTime})
                    </td>
                </tr>
				<tr>
    				<td class="textRight">日志详情</td>
					<td colspan="3">
                        <textarea style="height:320px" id="log" name="log" class="layui-textarea" lay-verify="strlength" id="log" name="log" >$!{dslInterfaceLogVo.log}</textarea>
					</td>
				</tr>
			</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
        ##付款账号
            <td class="textRight">#springMessage('table.nisBillhead.payerAcc')</td>
            <td>
                <input type="text" class="layui-input" id="payerAccNo" name="likes_payerAccNo"
                       placeholder="#springMessage('table.nisBillhead.payeeAcc')"/>
            </td>
        ##收款账号
            <td class="textRight">#springMessage('table.nisBillhead.payeeAcc')</td>
            <td>
                <input type="text" class="layui-input" id="oppBankAcc" name="likes_oppBankAcc"
                       placeholder="#springMessage('table.nisBillhead.payeeAcc')"/>
            </td>
        ##收款开户行名称
            <td class="textRight">#springMessage('table.nisBillhead.payeeBank')</td>
            <td>
                <input type="text" class="layui-input" id="oppBankName" name="likes_oppBankName"
                       placeholder="#springMessage('table.nisBillhead.payeeBank')"/>
            </td>
        </tr>
        <tr>
        ##单位
            <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="likes_corpCode"
                         data-resource="erp:payinfo:apply"
                         data-scope="all"
                    ></div>
                </div>
            </td>
        ##付款方式
            <td class="textRight">#springMessage('table.nisBillhead.voucerType')</td>
            <td>
                <div class="layui-inline">
                    <div type="list" field="eqs_voucherType" fieldHref="${basePath}/netbank/fcvouchertype/getVoucherTypeForErp" dictField="id" dictText="voucherName"></div>
                </div>
            </td>
        ##是否已转移
            <td class="textRight">#springMessage('table.erp.transfer')</td>
            <td>
                <div class="bt-biz-dict" data-type="select"
                     data-group="erp.payinfo.transfer" data-name="eqs_status" data-defaultvalue="0" data-displayData="0,1"></div>
            </td>
        </tr>
        <tr>
            ##同步时间
            <td class="textRight">#springMessage('table.erp.synchronization.time')</td>
            <td>
                <input type="text" name="ged_createDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_createDate" value="$!date.format('yyyy-MM-dd',$!{startWishPayday})">
                <span class="date-mid">~</span>
                <input type="text" name="led_createDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_createDate" value="$!date.format('yyyy-MM-dd',$!{endWishPayday})">
            </td>
            ##ERP凭证号
                <td class="textRight">#springMessage('table.fcBankBillTemp.erpVoucherNo')</td>
                <td>
                    <input type="text" class="layui-input" id="voucherNoErp" name="likes_voucherNoErp"
                           placeholder="#springMessage('table.fcBankBillTemp.erpVoucherNo')"/>
                </td>
            ##金额
                <td class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
                <td>
                    <div class="layui-inline">
                        <input type="text" data-name="geg_amt"
                               autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                    </div>
                    <span class="date-mid">~</span>
                    <div class="layui-inline">
                        <input type="text" data-name="leg_amt"
                               autocomplete="off" class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                    </div>
                </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.fcBankBillTemp.erpVoucherNo')</th>
        <th>#springMessage('table.nisBillhead.wishPayday')</th>
        <th>#springMessage('table.nisBillhead.payMoney')</th>
        <th>#springMessage('table.nisAllocationReport.payerCorpId')</th>
        <th>#springMessage('table.nisBillhead.payerAcc')</th>
        <th>#springMessage('table.nisBillhead.payerAccName')</th>
        <th>#springMessage('table.nisBillhead.payerBank')</th>
        <th>#springMessage('table.nisBillhead.voucerType')</th>
        <th>#springMessage('table.abVoucherinfo.billType')</th>
        <th>#springMessage('table.erp.billFlag')</th>
        <th>#springMessage('table.nisBillhead.payeeAcc')</th>
        <th>#springMessage('table.nisBillhead.payeeAccName')</th>
        <th>#springMessage('table.nisBillhead.payeeBank')</th>
        <th>#springMessage('table.externalCorp.source')</th>
        <th>#springMessage('table.nisBillhead.isQuick')</th>
        <th>#springMessage('table.bisAccDtlClaim.remark')</th>
        <th>#springMessage('table.erp.synchronization.time')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/dataexchange/basic/erpPayInfo.list.js?_btv=${resourceVersion}"></script>
</html>

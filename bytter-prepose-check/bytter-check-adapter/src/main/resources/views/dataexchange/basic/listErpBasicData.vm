<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="hidTypeCode" >
    <input type="hidden" id="hidDataTypeCode" >
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.erpBasicData.typeCode')</td>
            <td width="40%" >
                <div class="layui-inline">
                    <div class="bt-biz-selectType"  data-required="true" data-biz-name="typeCode" data-url="${basePath}/dataexchange2/basic/erptype/json"
                         data-valuefield="typeCode" data-textfield="typeName"
                         data-method ="get"
                         data-name="typeCode" data-search="true"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.erpBasicData.dataTypeCode')</td>
            <td width="40%">
                <div class="layui-inline">
                    <div class="bt-biz-selectType"  data-required="true" data-biz-name="dataTypeCode" data-url="${basePath}/dataexchange2/basic/erpbasicdata/json"
                         data-valuefield="code" data-textfield="name"
                         data-method ="get"
                         data-name="dataTypeCode" data-search="true"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.erpBasicData.bytterCode')</td>
            <td>
                <input type="text" name="bytterCode" autocomplete="off" class="layui-input" placeholder="#springMessage('table.erpBasicData.bytterCode')">
            </td>
            <td class="textRight"></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                ###if($shiro.hasPermission("dataexchange:basic:erpbasicdata:add"))
                    <button class="layui-btn" lay-submit="" type="button" value="save"  lay-filter="submit">#springMessage('common.button.save')</button>
                ###end
            </td>
        </tr>
        </tbody>
    </table>
</form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.erpBasicData.bytterCode')</th>
        <th>#springMessage('table.erpBasicData.bytterName')</th>
        <th>#springMessage('table.erpBasicData.erpCode')</th>
        <th>#springMessage('table.erpBasicData.erpName')</th>
        <th>#springMessage('table.erpBasicData.erpReverse')</th>
##        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/dataexchange2/basic/erpbasicdata.list.js?_btv=${resourceVersion}"></script>
</html>

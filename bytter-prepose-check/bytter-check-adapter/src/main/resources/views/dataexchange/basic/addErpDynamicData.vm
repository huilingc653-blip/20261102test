<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
        <table class="layui-table">
			<tbody>
            <tr>
                <td class="textRight">#springMessage('table.erpBasicData.typeCode')</td>
                <td width="40%" >
                    <div class="layui-inline">
                        <div class="bt-biz-selectType"  data-required="true" data-biz-name="typeCode" data-url="${basePath}/dataexchange2/basic/erptype/json"
                             data-valuefield="typeCode" data-textfield="showName" data-value="$!{typeCode}"
                             data-method ="get" data-name="typeCode" data-search="true"></div>
                    </div>
                </td>
                <td class="textRight">#springMessage('table.erpBasicData.dataTypeCode')</td>
                <td width="40%">
                    <div class="layui-inline">
                        <div class="bt-biz-selectType"  data-required="true" data-biz-name="dataTypeId" data-url="${basePath}/dataexchange2/basic/erpdynamicdata/dataType"
                             data-valuefield="id" data-textfield="showName" data-inputvalue="true"  data-value="$!{dataTypeId}"
                             data-method ="get" data-name="dataTypeId" data-search="true"></div>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.erpBasicData.bytterCode')</td>
                <td>
                    <input type="text" name="innerCode" autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="50" 
						placeholder="#springMessage('table.erpBasicData.bytterCode')">
                </td>
                <td class="textRight">#springMessage('table.erpBasicData.erpCode')</td>
                <td>
    				<input type="text" name="externalCode" autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="50" 
						placeholder="#springMessage('table.erpBasicData.erpCode')">
    			</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.erpBasicData.bytterName')</td>
                <td>
                    <input type="text" name="innerName" autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="100" 
						placeholder="#springMessage('table.erpBasicData.bytterName')">
                </td>
                <td class="textRight">#springMessage('table.erpBasicData.erpName')</td>
                <td>
    				<input type="text" name="externalName" autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="100" 
						placeholder="#springMessage('table.erpBasicData.erpName')">
    			</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.erpBasicData.bytterReverse')</td>
                <td>
                    <input type="text" name="innerReserve" autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="500" 
						placeholder="#springMessage('table.erpBasicData.bytterReverse')">
                </td>
                <td class="textRight">#springMessage('table.erpBasicData.erpReverse')</td>
                <td>
    				<input type="text" name="externalReserve" autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="500" 
						placeholder="#springMessage('table.erpBasicData.erpReverse')">
    			</td>
            </tr>
        	</tbody>
        </table>
		<div class="layui-form-item layui-form-submit-adaptive ">
			<div class="layui-input-block">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/dataexchange2/basic/erpdynamicdata.add.js?_btv=${resourceVersion}"></script>
</html>
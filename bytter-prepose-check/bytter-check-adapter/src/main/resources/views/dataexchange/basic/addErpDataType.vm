<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{erpDataTypePage.id}">
##		<input id="isSystem" name="isSystem" type="hidden" value="$!{erpDataTypePage.isSystem}">
        <table class="layui-table">
			<tbody>
        	<tr>
        		##类型代码
				<td width="40%" class="textRight">#springMessage('table.erpDataType.code')</td>
				<td >
						<!--number-->
                        <input type="text" id="code" name="code" autocomplete="off" class="layui-input" lay-verify="required|strlength"
							   data-maxlength="50" placeholder="#springMessage('table.erpDataType.code')">
										</td>
                    </td>
            </tr>
            <tr>
        		##类型名称
				<td class="textRight">#springMessage('table.erpDataType.name')</td>
				<td>
						<!--number-->
                        <input type="text" id="name" name="name" 
							    autocomplete="off" class="layui-input" lay-verify="required"  placeholder="#springMessage('table.erpDataType.name')">
										</td>
			</tr>
        	<tr>
        		##表名
				<td class="textRight">#springMessage('table.erpDataType.tableName')</td>
				<td >
						<!--number-->
                        <input type="text" id="tableName" name="tableName" 
							    autocomplete="off" class="layui-input" lay-verify="required|strlength|langKey" data-maxlength="50" placeholder="#springMessage('table.erpDataType.tableName')">
										</td>
                    </td>
            </tr>
            <tr>
        		##CODE字段
				<td class="textRight">#springMessage('table.erpDataType.keyField')</td>
				<td >
						<!--number-->
                        <input type="text" id="keyField" name="keyField" 
							    autocomplete="off" class="layui-input" lay-verify="required|strlength|langKey" data-maxlength="50" placeholder="#springMessage('table.erpDataType.keyField')">
										</td>
			</tr>
        	<tr>
        		##NAME字段
				<td class="textRight">#springMessage('table.erpDataType.valueField')</td>
				<td >
						<!--number-->
                        <input type="text" id="valueField" name="valueField" 
							    autocomplete="off" class="layui-input" lay-verify="required|strlength|langKey" data-maxlength="50" placeholder="#springMessage('table.erpDataType.valueField')">
										</td>
                    </td>
            </tr>
            <tr>
				##是否有效
                    <td class="textRight">#springMessage('table.erpDataType.validSign')</td>
                    <td>
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="1" data-name="validSign" data-biz-name="validSign"></div>
                    </td>

			</tr>
        	<tr>
			##条件
                <td class="textRight">#springMessage('table.erpDataType.condition')</td>
                <td >
                    <input type="text" id="queryCondition" name="queryCondition" lay-verify="langKey"
                           autocomplete="off" class="layui-input  layui-input-inline"  style="width:50%" placeholder="#springMessage('table.erpDataType.condition')">
                    <span style="color: #8e241f">#springMessage('table.erpDataType.conditionExplain')</span>
##                    <textarea placeholder="#springMessage('table.erpDataType.condition')" class="layui-textarea"  rows=3 cols=20  lay-verify="strlength" data-maxlength="100"  id="condition" name="condition" ></textarea>
                </td>
                </td>
            </tr>
            <tr>
			##备注
                <td class="textRight">#springMessage('table.erpDataType.rmk')</td>
                <td >
                    <textarea placeholder="#springMessage('table.erpDataType.rmk')" class="layui-textarea"   rows=3 cols=20 lay-verify="strlength" data-maxlength="100"  id="rmk" name="rmk" ></textarea>
                </td>
			</tr>

			<tr>
				<td colspan="6" style="text-align: center;">
					<button type="button" class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
					<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
			</tr>
        	</tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/dataexchange2/basic/erpbasicdata.add.js?_btv=${resourceVersion}"></script>
</html>
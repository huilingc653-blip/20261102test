<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
			<input id="id" name="id" type="hidden" value="$!{erpDataTypePage.id}">
        <table class="layui-table">
            <tbody>
            <tr>
			##类型代码
                <td width="30%" class="textRight">#springMessage('table.erpDataType.code')</td>
                <td >
                    <!--number-->
                    <input type="text" id="code" name="code"
                           autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="50" value="$!{erpDataTypePage.code}" placeholder="#springMessage('table.erpDataType.code')">
                </td>
            </tr>
            <tr>
			##类型名称
                <td class="textRight">#springMessage('table.erpDataType.name')</td>
                <td>
                    <!--number-->
                    <input type="text" id="name" name="name"
                           autocomplete="off" class="layui-input" lay-verify="required" value="$!{erpDataTypePage.name}" placeholder="#springMessage('table.erpDataType.name')">
                </td>
            </tr>
            <tr>
			##表名
                <td class="textRight">#springMessage('table.erpDataType.tableName')</td>
                <td >
                    <!--number-->
                    <input type="text" id="tableName" name="tableName"
                           autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="50" value="$!{erpDataTypePage.tableName}" placeholder="#springMessage('table.erpDataType.tableName')">
                </td>

            </tr>
            <tr>
			##CODE字段
                <td class="textRight">#springMessage('table.erpDataType.keyField')</td>
                <td >
                    <!--number-->
                    <input type="text" id="keyField" name="keyField"
                           autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="50" value="$!{erpDataTypePage.keyField}"  placeholder="#springMessage('table.erpDataType.keyField')">
                </td>
            </tr>
            <tr>
			##NAME字段
                <td class="textRight">#springMessage('table.erpDataType.valueField')</td>
                <td >
                    <!--number-->
                    <input type="text" id="valueField" name="valueField"
                           autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="50" value="$!{erpDataTypePage.valueField}" placeholder="#springMessage('table.erpDataType.valueField')">
                </td>

            </tr>
            <tr>
			##是否有效
                <td class="textRight">#springMessage('table.erpDataType.validSign')</td>
                <td>
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="$!{erpDataTypePage.validSign}" data-name="validSign" data-biz-name="validSign"></div>
                </td>

            </tr>
            <tr>
			##条件
                <td class="textRight">#springMessage('table.erpDataType.condition')</td>
                <td >
                    <input type="text" id="queryCondition" name="queryCondition"
                           autocomplete="off" class="layui-input layui-input-inline"  style="width:50%" value="$!{erpDataTypePage.queryCondition}" placeholder="#springMessage('table.erpDataType.condition')"/>
                    <span style="color: #8e241f">#springMessage('table.erpDataType.conditionExplain')</span>
				##                    <textarea placeholder="#springMessage('table.erpDataType.condition')" class="layui-textarea"  rows=3 cols=20  lay-verify="strlength" data-maxlength="100"  id="condition" name="condition" ></textarea>
                </td>
            </tr>
            <tr>
			##备注
                <td class="textRight">#springMessage('table.erpDataType.rmk')</td>
                <td >
                    <textarea placeholder="#springMessage('table.erpDataType.rmk')" class="layui-textarea"   rows=3 cols=20 lay-verify="strlength" data-maxlength="100"  id="rmk" name="rmk" >$!{erpDataTypePage.rmk}</textarea>
                </td>
            </tr>

            <tr>
                <td colspan="6" style="text-align: center;">
                    <button type="button" class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/dataexchange2/basic/erpbasicdata.edit.js?_btv=${resourceVersion}"></script>
</html>
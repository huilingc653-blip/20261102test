<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-field-box">
	<table id="editTable" class="layui-table layui-form dark-layui-table" style="width: 100%">
	    <thead>
	    <tr>
	        <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fcCompareAcc.voucherNo')</th><!-- 凭证号 -->
	        <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('finacial.check.centralityDataManager.centralityAcc')</th><!-- 中心帐号 -->
	        <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fcCompareAcc.tallyDate')</th><!-- 发生日期 -->
	        <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fcCompareAcc.debitMoney')</th><!-- 借方金额 -->
	        <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fcCompareAcc.creditMoney')</th><!-- 贷方金额 -->
	        <th><span class="pl"><span class="required-icon">*</span></span>#springMessage('table.fcCompareAcc.redblueSign')</th><!-- 红蓝标识 -->
	        <th>#springMessage('table.fcCompareAcc.billNo')</th><!-- 票据号 -->
	        <th>#springMessage('table.fcCompareAcc.compareSign')</th><!-- 对账标识 -->
	        <th>#springMessage('common.table.thead.operation')</th>
	    </tr>
	    </thead>
	    <tbody>
	    <!-- 模板 -->
	    <tr style="display: none;">
	    	<td><!-- 凭证号选择 -->
	    		<div class="layui-input-inline">
	    			<input name="voucherNo_index" id="voucherNo_index" class="layui-input" type="text" placeholder="#springMessage('table.fcCompareAcc.voucherNo')" autocomplete="off"/>
	    			<!-- <table id="voucherNoTable_index">
		    			<thead>
			    			<tr>
			    				<th>凭证</th>
			    				<th>流水号</th>
			    			</tr>
		    			</thead>
	    			</table> -->
	    		</div>
	    	</td>
	    	<td><!-- 中心账号 -->
	    		<div class="layui-input-inline">
	    			<input id="compAcc_index" name="compAcc_index" class="layui-input" type="text" placeholder="#springMessage('finacial.check.centralityDataManager.centralityAcc')" autocomplete="off"/>
	    			<input type="hidden" name="curId_index" id="curId_index"/>
	    			<table id="compAccTable_index">
		    			<thead>
			    			<tr>
			    				<th>#springMessage('table.fcVoucherEntryDefine.account')</th>
			    				<th>#springMessage('table.btBankAcc.accName')</th>
			    				<th>#springMessage('table.fcVoucherEntryDefine.subjectCode')</th>
			    			</tr>
		    			</thead>
	    			</table>
	    		</div>
	    	</td>
	    	<td><!-- 发生日期 -->
	    		
	    		<div class="layui-input-inline">
					<input id="tallyDate_index" name="tallyDate_index" data-biz-name="tallyDate_index" class="layui-input bt-biz-dateType" autocomplete="off"/>
				</div>
	    	</td>
	    	<td><!-- 借方金额 -->
	    		<div class="layui-input-inline">
	    			<input class="layui-input bt-biz-moneyType" data-decimal="2" data-biz-name="debitMoney_index" data-name="debitMoney_index" placeholder="#springMessage('table.fcCompareAcc.debitMoney')" autocomplete="off"/>
	    		</div>
	    	</td>
	    	<td><!-- 贷方金额 -->
	    		<div class="layui-input-inline">
	    			<input class="layui-input bt-biz-moneyType" data-decimal="2" data-biz-name="creditMoney_index" data-name="creditMoney_index" placeholder="#springMessage('table.fcCompareAcc.creditMoney')" autocomplete="off"/>
	   			</div>
	    	</td>
	    	<td><!-- 红蓝标识 -->
	    		<div class="layui-input-inline">
	   				## #set ($redblueSignMap = {"field":"redblueSign_index","type":"radio","typeGroupCode":"Finacial.RedBlueSign","defaultVal":"$!{redblueSign}"})
		            ## #set ($formRedblueSign = $dictSelect.instance($redblueSignMap))
		         	## ${formRedblueSign.html()}
		         	<div class="bt-biz-dict" data-group="Finacial.RedBlueSign" data-name="redblueSign_index" data-biz-name="redblueSign_index" data-type="radio" data-defaultvalue="$!{redblueSign}"></div>
	    		</div>
	    	</td>
	    	<td><!-- 票据号 -->
	    		<div class="layui-input-inline">
	    			<input class="layui-input" id="billNo_index" name="billNo_index" placeholder="#springMessage('table.fcCompareAcc.billNo')" />
	    		</div>
	    	</td>
	    	<td><!-- 对账标识 -->
	    		<div class="layui-input-inline">
		         	<div class="layui-input-inline"> 
		         		<div class="bt-biz-dict" data-group="finacial.CompareSign" data-name="compareSign_index" data-biz-name="compareSign_index" data-type="select" data-disabled="true" data-defaultvalue="$!{compareSign}"></div>
	         		</div>
	         	</div>
	    	</td>
	    	<td>
	    		<button data-type="del" class="layui-btn layui-btn-mini">#springMessage("common.button.delete")</button>
	    	</td>
	    </tr>
	    </tbody>
	</table>
	<div class="layui-form-item layui-form-submit ">
		<div class="layui-input-block">
	        <button class="layui-btn" id="submitBut">#springMessage('common.button.submit')</button>
	    </div>
	</div>
</div>
#parse("views/common/footer.vm")
</body>
<script type="text/javascript">
	bt.use(['jquery','form','selectTable','dateType','moneyType','bttable','dicts'],function(){
		/**判断字符串是否为空*/
	    bt.empty = function(ms){
	    	if(typeof(ms) == "undefined" || ms == null || ms == ""){
	    		return true;
	    	}
	    	return false;
	    }
		
		$ = bt.jquery;
		var form = bt.form();
		
		//可编辑表格初始化
		bt.bttable.init({
			elem: "#editTable",
			scrollY:"500px",
			url: null,
			buttons: [
				{
					text: '<i class="layui-icon">&#xe642;</i>'+bt.lang('common.addTr'),
					action: function(e, dt, node, config){
						addTr();
					}
				}
			],
			columns:[
				{
					data:"voucherNo",
					render:function(data, row){
					 
						return "";
					}
				},
				{
					data:"compAcc",
					render:function(data, row){
					 
					}
				},
				{
					data:"tallyDate",
					render:function(data, row){
					 
					}
				},
				{
					data:"debitMoney",
					render:function(data, row){
					 
					}
				},
				{
					data:"creditMoney",
					render:function(data, row){
					 
					}
				},
				{
					data:"redblueSign",
					render:function(data, row){
					 
					}
				},
				{
					data:"billNo",
					render:function(data, row){
					 
					}
				},
				{
					data:"compareSign",
					render:function(data, row){
					 
					}
				},
				{
					data:null,
					render:function(data, row){
						var reInfo='<button data-type="del" class="layui-btn layui-btn-mini">'+bt.lang("common.button.delete")+'</button>';
						return reInfo;
					}
				}
			],
			delRowCallback:function(data,$tr){
		    	$tr.remove();
		    },            
		    tableInitCallback:function(){  
	       }
		});
		
		var html = $("#editTable tbody tr:eq(0)").html();
		//添加控件
		var i = 0;    
		var addTr = function(){
			i++;
			var index = "_" + i;
			var reg = new RegExp("_index","g");
			var tds = html.replace(reg,index);
	 		var $tr = $('<tr data-id="_' + i + '">'+ tds +'</tr>');
	 		$('#editTable > tbody > tr:last').after($tr);
	 		
			//中心账号下拉表格初始化
			bt.selectTable.init({
				elem: "#compAccTable" + index,
				searchInput: '#compAcc' + index,
		        scrollX:true,
		        scrollY:true,
				url:  basePath+"/finacial/check/centralityDataManage/validAccount",
				columns: [
				    {data:"account",},
	                {data:"accName",},
	                {data:"subjectName",}
				],
		        clickCallback: function(severData,data){
		            $("#compAcc" + index).val(severData.account);
		            $("#curId" + index).val(severData.curId);
		        }
			});
	 		
			bt.moneyType.init();
			bt.dateType.init();//时间
			//初始化 字典控件bt.dicts.init()初始化全部  使用_jquery的class选择器选择不到
			bt.dicts.init();
			
			//复制上行的值
			var befromIndex = $('#editTable > tbody > tr').eq(-2).data("id");
			if(!bt.empty(befromIndex)){
				//$("#voucherNo" + index).val($("#voucherNo" + befromIndex).val());
				$("#compAcc" + index).val($("#compAcc" + befromIndex).val());
	            $("#curId" + index).val($("#curId" + befromIndex).val());
	            
	            /* var td = bt.dateType.init().get("tallyDate" + befromIndex).val();
	            bt.dateType.init().get("tallyDate" + index).val(td);
	            
	            var dm = bt.moneyType.init().get("debitMoney" + befromIndex).val();
	            bt.moneyType.init().get("debitMoney" + index).val(dm);
	            
	            var cm = bt.moneyType.init().get("creditMoney" + befromIndex).val();
	            bt.moneyType.init().get("creditMoney" + index).val(cm);
	            
	            var rs = bt.dicts.init().get("redblueSign" + befromIndex).val();
	            bt.dicts.init().get("redblueSign" + index).val(rs);
	            
	            $("#billNo" + index).val($("#billNo" + befromIndex).val()); */
			}
			
		}
		
		addTr();
		
		//提交
		$("#submitBut").on("click",function(){
			$('button.addBtn').addClass('layui-btn-disabled')
			var trs = $("#editTable > tbody").children('tr:visible');
			if(trs.length > 0){
				var data = new Object();
		 		trs.each(function(i,tr){
		 			var subIndex = $(tr).data("id");
		 			data["accList["+ i +"].voucherNo"] = $("#voucherNo" + subIndex).val();
		 			data["accList["+ i +"].compAcc"] = $("#compAcc" + subIndex).val();
		 			data["accList["+ i +"].curId"] = $("#curId" + subIndex).val();
		            var td = bt.dateType.init().get("tallyDate" + subIndex).val();
		            data["accList["+ i +"].tallyDate"] = td;
		            
		            var dm = bt.moneyType.init().get("debitMoney" + subIndex).val();
		            data["accList["+ i +"].debitMoney"] = dm;
		            
		            var cm = bt.moneyType.init().get("creditMoney" + subIndex).val();
		            data["accList["+ i +"].creditMoney"] = cm;
		            
		            var rs = bt.dicts.init().get("redblueSign" + subIndex).val();
		            data["accList["+ i +"].redblueSign"] = rs;
		            
		            data["accList["+ i +"].billNo"] = $("#billNo" + subIndex).val();
		            
		 			
		 			/* var tds = $(tr).children('td');
		 			tds.each(function(index,td){
		 				var inputs = $(td).find('[name]');
		 				inputs.each(function(ix,inp){
		 					var $input = $(inp);
		 					var name = $input.attr('name');
			 				if(typeof(name) != "undefined"){
			 					name = name.substring(0,name.indexOf("_"));
				 				var text = $input.val();
				 				data["accList["+ i +"]."+ name ] = text;
			 				}
		 				});
		 			}); */
		 		});

				var action = "/finacial/check/centralityDataManage/save";
		        $.post(basePath + action,data,function(result){
		            if(result.success){
		                parent.layer?parent.layer.closeAll():layer.closeAll();
		            }else{
		            	$('button.addBtn').addClass('layui-btn')
		            }
		            parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
		        },'JSON');
			}else{
				layer.alert("#springMessage('finacial.check.manager.msg.nulldata')");
			}
		});
	});
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcCompareAccPage.id}">
		  <table class="layui-table">
	    	<tbody>
	    	<tr>
	    		<!-- 凭证号选择 -->
	    		<td class="textRight">#springMessage('table.fcCompareAcc.voucherNo')</td>
	    		<td>
	    			<input name="voucherNo" id="voucherNo" class="layui-input" lay-verify="required" type="text" value="$!{fcCompareAccPage.voucherNo}" placeholder="#springMessage('table.fcCompareAcc.voucherNo')" />
	    			<!-- <table id="voucherNoTable">
		    			<thead>
			    			<tr>
			    				<th>凭证</th>
			    				<th>流水号</th>
			    			</tr>
		    			</thead>
	    			</table> -->
	    		</td>
	    		<!-- 中心帐号 -->
	    		<td class="textRight">#springMessage('finacial.check.centralityDataManager.centralityAcc')</td>
	    		<td>
	    			<input id="compAcc" name="compAcc" class="layui-input" lay-verify="required" type="text" value="$!{fcCompareAccPage.compAcc}"  placeholder="#springMessage('finacial.check.centralityDataManager.centralityAcc')" />
	    			<input type="hidden" name="curId" id="curId" value="$!{fcCompareAccPage.curId}" />
	    			<table id="compAccTable">
		    			<thead>
			    			<tr>
			    				<th>#springMessage('table.fcVoucherEntryDefine.account')</th>
			    				<th>#springMessage('table.btBankAcc.accName')</th>
			    				<th>#springMessage('table.fcVoucherEntryDefine.subjectCode')</th>
			    			</tr>
		    			</thead>
	    			</table>
	    		</td>
	    	</tr>
	    	<tr>
	    		<!-- 发生日期 -->
	    		<td class="textRight">#springMessage('table.fcCompareAcc.tallyDate')</td>
	    		<td colspan="3">
	    			<INPUT class="layui-input bt-biz-dateType" type=text name="tallyDate" data-type="date" lay-verify="required" value="$!date.format('yyyy-MM-dd',$!fcCompareAccPage.tallyDate)">
	    		</td>
	    	</tr>
	    	<tr>
	    		 <!-- 贷方金额 -->
	    		<td class="textRight">
	    			#springMessage('table.fcCompareAcc.creditMoney')
	    		</td>
	    		<td>
	    			<input class="layui-input bt-biz-moneyType" data-decimal="2" data-name="creditMoney" value="$!{fcCompareAccPage.creditMoney}" placeholder="#springMessage('table.fcCompareAcc.creditMoney')"/>
	    			<input type="hidden" value="1" lay-verify="required" />
	    		</td>
	    		<!-- 借方金额 -->
	    		<td class="textRight">
	    			#springMessage('table.fcCompareAcc.debitMoney')
	    		</td>
	    		<td>
	    			<input class="layui-input bt-biz-moneyType" data-decimal="2" data-name="debitMoney" value="$!{fcCompareAccPage.debitMoney}" placeholder="#springMessage('table.fcCompareAcc.debitMoney')"/>
	    			<input type="hidden" value="1" lay-verify="required" />
	    		</td>
	    	</tr>
	    	<tr>
	    		<!-- 红蓝标识 -->
	    		<td class="textRight">
		    		
		    		#springMessage('table.fcCompareAcc.redblueSign')
	    		</td>
	    		<td colspan="3">
	    			<input title="#springMessage('table.btBankAccDtl.rbSign.blue')" name="redblueSign" value="B" #if($fcCompareAccPage.redblueSign == 'B')checked#end type="radio">
					<!-- <div class="layui-unselect layui-form-radio">
						<i class="layui-anim layui-icon"> </i>
						<span>#springMessage("fcl.acc_shortcut.one")</span>
					</div> -->
							    
					<input title="#springMessage('table.btBankAccDtl.rbSign.red')" name="redblueSign" value="R" #if($fcCompareAccPage.redblueSign == 'R')checked#end  type="radio">
					<!-- <div class="layui-unselect layui-form-radio layui-form-radioed">
						<i class="layui-anim layui-icon"> </i>
						<span>#springMessage("fcl.acc_shortcut.two")</span>
					</div> -->
	    		
	    		
	    		</td>
	    	</tr>
	    	<tr>
	    		<!-- 票据号 -->
	    		<td class="textRight">#springMessage('table.fcCompareAcc.billNo')</td>
	    		<td>
	    			<input class="layui-input" id="billNo" name="billNo" value="$!{fcCompareAccPage.billNo}" placeholder="#springMessage('table.fcCompareAcc.billNo')"/>
	    		</td>
	    		<!-- 对账标识 -->
	    		<td class="textRight">#springMessage('table.fcCompareAcc.compareSign')</td>
	    		<td>
	    			<div class="layui-input-inline"> 
##		    			#set ($compareSignMap = {"field":"compareSign","type":"select","readonly":"readonly","typeGroupCode":"finacial.CompareSign","defaultVal":"$!{fcCompareAccPage.compareSign}"})
##			            #set ($formCompareSign = $dictSelect.instance($compareSignMap))
##			         	${formCompareSign.html()}
						<div class="bt-biz-dict" data-type="select" data-group="finacial.CompareSign"
							 data-name="compareSign" data-biz-name="compareSign" data-disabled="true"
							 data-defaultvalue="$!{fcCompareAccPage.compareSign}"></div>
			         	
		         	</div>
	    		</td>
	    	</tr>
	    	</tbody>
	    </table>
		<div class="layui-form-item layui-form-submit ">
			<div class="layui-input-block">
		        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
		        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		    </div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
	bt.use(['jquery','form','selectTable','btdate','moneyType','dateType','dicts'],function(){
		$ = bt.jquery;
		form = bt.form();
		bt.dateType.init();
		bt.dicts.init();
		//凭证下拉表格初始化
		/* bt.selectTable.init({
			elem: "#voucherNoTable",
	        searchInput: '#voucherNo',
	        scrollX:true,
	        scrollY:true,
			url: basePath+"/finacial/check/centralityDataManage/jsonVoucherNo",
			columns: [
				{data:"voucherNo"},
				{data:"orderNo"}
			],
			clickCallback: function(severData,data){
		    	$("#voucherNo").val(severData.voucherNo);
		    },
		}); */
			
		//中心账号下拉表格初始化
		bt.selectTable.init({
			elem: "#compAccTable",
			searchInput: '#compAcc',
	        scrollX:true,
	        scrollY:true,
	        url:  basePath+"/finacial/check/centralityDataManage/validAccount",
			columns: [
			    {data:"account",},
                {data:"accName",},
                {data:"subjectName",}
			],
			clickCallback: function(severData,data){
		    	$("#compAcc").val(severData.blnctrAcc);
		    	$("#curId").val(severData.curId);
		    },
		});
			
		//日期控件初始化
		$.each($("div[type='date']"),function(i,item){
			bt.btdate.init({
				elem: "[field='"+$(item).attr("field")+"']",
				name: $(item).attr("field"),
				format: "YYYY-MM-DD",
				istime: true,
				placeholder: $(item).attr("defaultVal"),
				choose : function(datas){
				}
			});
		});
		
		//金额控件
		bt.moneyType.init();
		
		//监听提交
        form.on('submit(submit)', function(data){
            var action = "/finacial/check/centralityDataManage/modify";
            $.post(basePath + action,data.field,function(result){
                if(result.success){
                    parent.layer?parent.layer.closeAll():layer.closeAll();
                }
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            },'JSON');
            return false;
        });
	});
</script>
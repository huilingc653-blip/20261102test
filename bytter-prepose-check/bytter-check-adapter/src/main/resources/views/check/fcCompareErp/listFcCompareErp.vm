<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" action="" method="post">
    <table class="layui-table">
        <tr>
        ##网点
            <td class="textRight" width="7%">#springMessage("table.fbsBudget.net")</td>
            <td width="17.5%">

                <div class="bt-biz-corp"
                     data-biz-type="corp"
                     data-type="selectTree"
                     data-name="netId"
                     data-biz-name="netId"
                     data-required="true"
                     data-scope="all"
                     data-callback="changeNet"
                     data-resource="finacial:check:erp:check" ></div>
            </td>
        ##开始日期
            <td class="textRight" width="7%">#springMessage("table.fbsBudgetPeriod.beginDate")</td>
            <td width="17.5%">
                <span id="beginDate"></span>
            </td>
        ##结束日期
            <td class="textRight" width="7%">#springMessage("table.fbsBudgetPeriod.endDate")</td>
            <td width="17.5%">
                <input type="text" name="transTime" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="transTime"  lay-verify="required" data-callback="dateChangeCallback">##value="${initNetOverDate}"
            </td>
        ##核对标准
            <td class="textRight" width="7%">#springMessage("table.fcCompare.Check_the_standard")</td>
            <td width="17.5%">
                <div class=layui-form>
                    <div class=bt-biz-dict data-type="select" data-width="150px" data-biz-name="checkType" data-name="checkType" data-group="fcCompare.checkType" data-defaultvalue="1" data-required="true"></div>
                #*<div class="bt-biz-selectType" data-url="${basePath}/finacial/paramconfig/fccomparechecktype/json" data-valuefield="sort" data-textfield="checkTypeName" data-name="checkType" data-required="true"></div>*#
                </div>
            </td>
        </tr>
        <tr>
        ##账户性质
            <td class="textRight">#springMessage("table.btBankAcc.natureId")</td>
            <td>
                <div class="bt-biz-selectType" data-biz-name="natureId" data-url="${basePath}/bankacc/btaccnature/json" data-valuefield="id" data-textfield="natureName" data-name="natureId" data-search="true" data-defaultvalue="" data-placeholder="#springMessage('common.placeholder.all')" data-callback="changeNature"></div>
            </td>
        ##银行账号
            <td class="textRight">#springMessage("table.nisBillhead.bankAcc")</td>
            <td>
                <div class="layui-input-inline" style="display: none;" id="bankDiv">
                    <input type="text" name="bankAcc" id="bankAcc"  class="layui-input acc" data-biz-name="bankAcc" lay-verify="required">
                </div>
            </td>
            <td class="textRight">#springMessage("table.corp.book.balance")</td>##单位账面余额
            <td>
                <input type="hidden"  class="layui-input" name="blnBalance" id="blnBalance" value=""  readonly="readonly"/>
                <span id="blnBalanceShow"></span>
            </td>
            <td class="textRight">#springMessage("table.fcBankBalanceAdjust.bankInitBalance")</td>##银行账面余额
            <td>
                <input type="hidden"  class="layui-input" name="bankBalance" id="bankBalance" value=""  readonly="readonly"/>
                <span id="bankBalanceShow"></span>
            </td>
        </tr>
        <tr>
            <td colspan="8" align="center">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="doCheck" >#springMessage("table.fcCompare.check")</button>##对  账
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="doHandOver" >#springMessage("table.fcCompare.doHandOver")</button>##勾对保存
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="doReverseHandOver" >#springMessage("table.fcCompare.doReverseHandOver")</button>##反勾对
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="doAdjustOver" >#springMessage("table.fcCompare.doAdjustOver")</button>##结   转
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="doHandStay" >#springMessage("table.fcCompare.doHandStay")</button>##确认未达
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="doPrint" >#springMessage("common.button.print")</button>##打印
            </td>

        </tr>
    </table>

    <table class="layui-table">
        <tr>
            <td colspan="2">#springMessage("table.fcCompare.bankmsg")</td>##上期企业已记，银行未达账（提取企业日记账）
            <td colspan="2">#springMessage("table.fcCompare.qymsg")</td>##上期银行已记，企业未达账（提取银行日记账）
        </tr>
        <tr>
            <td width="50%" colspan="2" style="vertical-align:top">
                <div style='width:100%;height:370px;overflow:auto;'>
                    <table id="cntrTb" style='width:100%'>
                        <thead>
                        <tr>
                            <th width="15%">#springMessage("table.fcAccuBalance.date")</th>##日期
                            <th width="30%">#springMessage("table.fcCompareAcc.billNo")</th>##票据号
                            <th width="10%">#springMessage("table.fcCompare.provide")</th>##借/贷
                            <th width="25%">#springMessage("table.fcUnionAccbook.sendMoney")</th>##金额
                            <th width="20%">#springMessage("table.fcAccbookHis.voucherNo") </th>##凭证号
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
            <td width="50%" colspan="2" style="vertical-align:top">
                <div style='width:100%;height:370px;overflow:auto;'>
                    <table id="bankTb" style='width:100%'>
                        <thead>
                        <tr>
                            <th width="15%">#springMessage("table.fcAccuBalance.date")</th>##日期
                            <th width="30%">#springMessage("table.fcBankBillTemp.billNo")</th>##票据号
                            <th width="10%">#springMessage("table.fcCompare.provide")</th>##借/贷
                            <th width="25%">#springMessage("table.fcUnionAccbook.sendMoney")</th>##金额
                            <th width="20%">#springMessage("table.fcAccbookHis.voucherNo") </th>##凭证号
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
        </tr>
        <tr>
        ##选中笔数
            <td width="50%" colspan="2">#springMessage("table.fcUnionAccbook.pitch_on.num")：<span id="cntrCount">0</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            ##借方合计
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;#springMessage("table.fcUnionAccbook.debit.total")：<span id="cntrDebMoney">0.00</span>
            ##贷方合计
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;#springMessage("table.fcUnionAccbook.lender.total")：<span id="cntrCreMoney">0.00</span>
            </td>
        ##选中笔数
            <td width="50%" colspan="2">#springMessage("table.fcUnionAccbook.pitch_on.num")：<span id="bankCount">0</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            ##借方合计
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;#springMessage("table.fcUnionAccbook.debit.total")： <span id="bankDebMoney">0.00</span>
            ##贷方合计
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;#springMessage("table.fcUnionAccbook.lender.total")： <span id="bankCreMoney">0.00</span>
            </td>
        </tr>
        <tr>
        ##调节后余额
            <td width="50%" colspan="2" align="center">#springMessage("table.fcUnionAccbook.adjust.balance")：<span id="adjustCntrMoney"></span></td>
            <td width="50%" colspan="2" align="center">#springMessage("table.fcUnionAccbook.adjust.balance")：<span id="adjustBankMoney"></span></td>
        </tr>
    </table>
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h5 class="layui-colla-title">#springMessage("table.fcUnionAccbook.color.checking")</h5>##颜色标识对账记录
            <div class="layui-colla-content">
                <table class="layui-table" align="center">
                    <tr>
                        <td width="150px" align="center"><i class="layui-icon" style="font-size: 20px; color: #FFFF80;">&#xe617;</i>  </td>
                        <td width="100px" align="center">#springMessage("table.fcUnionAccbook.To_check_for")</td>##未勾对记录
                        <td width="280px" align="center">
                            <div class="layui-input-block">
                                <input type="radio" name="noHandRadios"  title="#springMessage('common.sc_yn.yes')" value="1" checked lay-filter = "noHandRadios">
                                <input type="radio" name="noHandRadios"  title="#springMessage('common.sc_yn.no')" value="0" lay-filter = "noHandRadios"/>
                            </div>
                        </td>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td width="150px" align="center"><i class="layui-icon" style="font-size: 20px; color: #FF8080;">&#xe617;</i></td>
                        <td width="100px" align="center">#springMessage("table.fcUnionAccbook.outstanding.entry")</td>##未达账记录
                        <td width="280px" align="center">
                            <div class="layui-input-block">
                                <input type="radio" name="stayRadios"  title="#springMessage('common.sc_yn.yes')" value="1" lay-filter = "stayRadios">
                                <input type="radio" name="stayRadios"  title="#springMessage('common.sc_yn.no')" value="0" lay-filter = "stayRadios"/>
                            </div>
                        </td>
                        <td ><span style="color: red">#springMessage("table.fcUnionAccbook.To_check_for.msg")</span></td>##当勾对完成，并标记未达账，余额调节表显示平衡。
                    </tr>
                    <tr>
                        <td width="150px" align="center"><i class="layui-icon" style="font-size: 20px; color: #B0DC81;">&#xe617;</i></td>
                        <td width="100px" align="center">#springMessage("table.fcUnionAccbook.To_check_for.yes")</td>##已经勾对记录
                        <td width="280px" align="center">
                            <div class="layui-input-block">
                                <input type="radio" name="handRadios"  title="#springMessage('common.sc_yn.yes')" value="1" lay-filter = "handRadios">
                                <input type="radio" name="handRadios"  title="#springMessage('common.sc_yn.no')" value="0" lay-filter = "handRadios"/>
                            </div>
                        </td>
                        <td ><span style="color:red">#springMessage("table.fcUnionAccbook.To_check_for.yes.msg")</span></td>##显示已经勾对数据，点击勾对，还原勾对数据，变成未勾对数据。
                    </tr>
                    <tr>
                        <td width="150px" align="center"><i class="layui-icon" style="font-size: 20px; color: #4FBAE6;">&#xe617;</i></td>
                        <td width="100px" align="center">#springMessage("table.fcUnionAccbook.checking.yes")</td>##已经对账记录
                        <td width="280px" align="center">
                            <div class="layui-input-block">
                                <input type="radio" name="checkRadios"  title="#springMessage('common.sc_yn.yes')" value="1" lay-filter = "checkRadios">
                                <input type="radio" name="checkRadios"  title="#springMessage('common.sc_yn.no')" value="0" lay-filter = "checkRadios"/>
                            </div>
                        </td>
                        <td >&nbsp;</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <input type="hidden" id="paramType" name="paramType" value="1"><!-- Erp对账 -->
    <input type="hidden" name="checkFlag" id="checkFlag" value="2" />
    <input type="hidden" name="account" id="account"/>
    <input type="hidden" name="adjustId" id="adjustId" value="" />
    <input type="hidden" name="accDisplayType" id="accDisplayType" value="0"/><!--余额初始化账号显示 ERP-银行账号  -->
    <input type="hidden" name="checkDate" id="checkDate" value=""/>
    <input type="hidden" name="blnAdjustBalance" id="blnAdjustBalance"/>
    <input type="hidden" name="bankAdjustBalance" id="bankAdjustBalance"/>
    <input type="hidden" id="searchNetId" value="$!{initNetId}">
    <input type="hidden" id="searchNatureId" value="">
    <input type="hidden" id="curId" name="curId" value="">
</form>

    #parse("views/common/footer.vm")
</body>
<script >
    var cntrCount = 0;
    var cntrDebMoney = 0;
    var cntrCreMoney = 0;
    var bankCount = 0;
    var bankDebMoney = 0;
    var bankCreMoney = 0;
    var cntrTbData = new Array();
    var bankTbData = new Array();
    var CntrCheckDatas;
    var BankCheckDatas;
    var dateChangeCallback;
    var selectTableType;
    bt.use(['form','jquery','datatable','bttable','dateType','selectTableType','btdate','corp','selectType','element','money','dicts'], function(){
        $ = bt.jquery,form = bt.form();
        /**判断字符串是否为空*/
        bt.empty = function(ms){
            if(typeof(ms) == "undefined" || ms == null || ms == ""){
                return true;
            }
            return false;
        }
        //网点变更
        changeNet = function(data){
            if(!bt.empty($.trim(data.value))){//单位id不为空
                $.ajax({
                    type: "POST",
                    url: basePath+"/finacial/check/fccompareerp.do?getDayCloseDate",
                    data: {"netId":data.value},
                    dataType : "json",
                    success: function(rs){
                        /*if(rs.obj) {
                            dateTypes.get("transTime").attr("data-max", rs.obj);
                            dateTypes.get("transTime").val(rs.obj);
                            dateTypes.get("transTime").reset();
                        }else{
                            dateTypes.get("transTime").attr("data-max", "2099-12-31");
                            dateTypes.get("transTime").val('');
                            dateTypes.get("transTime").reset();
                        }*/
                    }
                });
            }
            $("#bankAcc").val("");//清空账号
            selectTableType.get("bankAcc").setUrl({netCode:$.trim(data),natureCode:$("#searchNatureId").val()});//重新加载账号
            $("#bankDiv").show();
            $("#searchNetId").val($.trim(data.value));
        }
        //账户性质变更
        changeNature = function(data){
            $("#searchNatureId").val($.trim(data.id));
            selectTableType.get("bankAcc").setUrl({netCode:$("#searchNetId").val(),natureCode:$.trim(data.id)});
        }

        var isInitDateFlag = true;
        dateChangeCallback = function () { //
            if(isInitDateFlag){
                $("#bankDiv").show();
                isInitDateFlag = false;
            }
            //清除值
            $(".acc").val('');

        }

        var corps = bt.corp.init();
        var dicts = bt.dicts.init();
        var dateTypes = bt.dateType.init()
        var selectTypes = bt.selectType.init();

        /**加载银行账号*/
        selectTableType = bt.selectTableType.init({
            elem:".acc",
            url: basePath+"/finacial/check/fccompareerp/getBankAccByOpType",
            urldata:{netCode:$("#searchNetId").val()},
            paging:true,
            scrollX:'650px',
            columns:[
                {"data":"bankAcc",title:bt.lang('table.nisBillhead.bankAcc')},
                {"data":"bankName",title:bt.lang('table.accountDTO.bankName')},
                {"data":"erpCode",title:bt.lang('table.erp.basic.erpid')},
                {"data":"curName",title:bt.lang('table.fbsBudgetDetail.curId')},
            ],
            clickCallback:function(data,$tr,$elem,full){
                    $getAccBalance(data.erpCode,data.bankAcc);
                $("#bankAcc").val(data.bankAcc);  //给当前输入框赋name值;
                $('#account').val(data.erpCode);
                $('#curId').val(data.curId);
            },
            tableInitCallback:function(full,$elem){
            }
        });


        //-----------------------------按钮模块------------------------------------------
        //对账
        form.on('submit(doCheck)', function(data){
            if($doValidate()){
                var action = "/finacial/check/fccompareerp/docheck";
                $.post(basePath + action,data.field,function(result){
                    layer.alert(result.msg, {icon: result.success?1:2});
                    if(result.success){
                        layer.alert(bt.lang("finacial.check.succeed"), {icon:1});
                        $("#checkFlag").val("1");
                            $reloadTotalInfo();
                    }else{
                        layer.alert(bt.lang("finacial.check.fail"), {icon:2});
                    }
                },'JSON');
            }
            return false;
        });

        //手工勾兑
        form.on('submit(doHandOver)', function(data){
                $doOverOp("1", "0");
            return false;
        });

        //手工反勾对
        form.on('submit(doReverseHandOver)', function(data){
                $doOverOp("2", "2");
            return false;
        });

        //确认未达
        form.on('submit(doHandStay)', function(data){
            doHandStay();
            return false;
        });

        //结转
        form.on('submit(doAdjustOver)', function(data){
            doAdjustOver(data);
            return false;
        });

        //打印
        form.on('submit(doPrint)', function(data){
                $doPrint(data);
            return false;
        });
        //未勾对记录
        form.on('radio(noHandRadios)', function(data){
                $reloadTotalInfo();
        });
        //未达账记录
        form.on('radio(stayRadios)', function(data){
                $reloadTotalInfo();
        });
        //已经勾对记录
        form.on('radio(handRadios)', function(data){
                $reloadTotalInfo();
        });
        //已经对账记录
        form.on('radio(checkRadios)', function(data){
                $reloadTotalInfo();
        });

        //-----------------------------方法模块------------------------------------------
        //重新加载列表数据
        $reloadTotalInfo = function(){
            if("1" == $("#checkFlag").val()){
                if(CntrCheckDatas == null || CntrCheckDatas == undefined){
                    loadCntrCheckDatas(getQueryParam("1"));
                    loadBankCheckDatas(getQueryParam("0"));
                }else{//重新渲染
                    CntrCheckDatas.config.urldata = getQueryParam("1");
                    CntrCheckDatas.reload();
                    BankCheckDatas.config.urldata = getQueryParam("0");
                    BankCheckDatas.reload();
                }
                calAdjustBal();//计算余额调节表数据
            }
        }

        function getQueryParam(queryType){
            var queryParam = {};
            queryParam = { "queryType":queryType,"account" : $("#account").val(),
                "bankAcc" : $("#bankAcc")[0].value, "transDate" : dateTypes.get("transTime").val(), "checkFlag" : $("#checkFlag").val()}
            var noHandRadios = $('input[name="noHandRadios"]:checked').val();
            var stayRadios = $('input[name="stayRadios"]:checked').val();
            var handRadios = $('input[name="handRadios"]:checked').val();
            var checkRadios = $('input[name="checkRadios"]:checked').val();
            queryParam.noHandRadios = noHandRadios;
            queryParam.stayRadios = stayRadios;
            queryParam.handRadios = handRadios;
            queryParam.checkRadios = checkRadios;
            return queryParam;
        }

        //加载企业日记账数据
        function loadCntrCheckDatas(queryParam){
            CntrCheckDatas = bt.bttable.init({
                elem:"#cntrTb",
                checkbox:true,
                url:basePath+"/finacial/check/fccompareerp/toLoadCheckDatas",
                urldata:queryParam,
                mulselect:true,
                selectCss:false,
                scrollX:true,
                scrollY:"370px",
                columns:[
                    {data:"tallyDate",className:'center'},
                    {data:"billNo",render:function(data,id){
                        if(data.billNo==null){
                            return '';
                        }else{
                            return data.billNo;
                        }
                    }},
                    {data:"cdSign",className:'center',render:function(data,id){
                        if(data.cdSign=="1"){
                            return bt.lang("finacial.check.cdSign.debit");//借
                        }else{
                            return bt.lang("finacial.check.cdSign.credit");//贷
                        }
                    }
                    },
                    {data:"money",className:'textRight',
                        render:function(data,id){
                            return bt.money.format(data.money);
                        }
                    },
                    {data:"voucherNo",
                        render:function(data,id){
                            if(data.voucherNo == null || data.voucherNo == undefined){
                                return "";
                            }else{
                                return data.voucherNo;
                            }
                        }
                    }
                ],
                checkChildCallback:function(data,elem){ //更新勾选信息
                    //data为本行数据; $tr 代表本行jq对象
                    //var c_rowdata=tabledata[elem.attr("row")];
                    calCheckTotalData("cntrTb",data);
                },
                clickCallback:function(data,elem){//更新勾选信息
                    calCheckTotalData("cntrTb",data);
                },
                tableInitCallback:function(data){
                    calCheckTotalData("cntrTb",data);
                    $("#cntrTb tr").each(function(index,eml){//初始化表格背景色
                        if(index>0){
                            if(data[index-1].compareSign=="1"){//已对账
                                eml.style.backgroundColor="#4FBAE6";
                            }else if(data[index-1].compareSign=="2"){//手工勾兑
                                eml.style.backgroundColor="#B0DC81";
                            }else if(data[index-1].compareSign=="4"){//本期未达
                                eml.style.backgroundColor="#FF8080";
                            }else{//未对账
                                eml.style.backgroundColor="#FFFF80";
                            }
                        }
                    });
                },
                checkAllCallback:function(data){//全选
                    calCheckTotalData("cntrTb",data);
                }
            });
        }


        //加载银行日记账数据
        function loadBankCheckDatas(queryParam){
            BankCheckDatas = bt.bttable.init({
                elem:"#bankTb",
                checkbox:true,
                url:basePath+"/finacial/check/fccompareerp/toLoadCheckDatas",
                urldata:queryParam,
                mulselect:true,
                selectCss:false,
                scrollX:true,
                scrollY:"370px",
                columns:[
                    {data:"tallyDate",className:'center'},
                    {data:"billNo",render:function(data,id){
                        if(data.billNo==null){
                            return '';
                        }else{
                            return data.billNo;
                        }
                    }},
                    {data:"cdSign",className:'center',render:function(data,id){
                        if(data.cdSign=="1"){
                            return bt.lang("finacial.check.cdSign.debit");
                        }else{
                            return bt.lang("finacial.check.cdSign.credit");
                        }
                    }},
                    {data:"money",className:'textRight',
                        render:function(data,id){
                            return bt.money.format(data.money);
                        }
                    },
                    {data:"voucherNo",
                        render:function(data,id){
                            if(data.voucherNo == null || data.voucherNo == undefined){
                                return "";
                            }else{
                                return data.voucherNo;
                            }
                        }
                    }
                ],
                checkChildCallback:function(data,elem){//更新勾选信息
                    calCheckTotalData("bankTb",data);
                },
                clickCallback:function(data){//更新勾选信息
                    calCheckTotalData("bankTb",data);
                },
                tableInitCallback:function(data){//初始化表格背景色
                    calCheckTotalData("bankTb",data);
                    $("#bankTb tr").each(function(index,eml){
                        if(index>0){
                            if(data[index-1].compareSign=="1"){//已对账
                                eml.style.backgroundColor="#4FBAE6";
                            }else if(data[index-1].compareSign=="2"){//手工勾兑
                                eml.style.backgroundColor="#B0DC81";
                            }else if(data[index-1].compareSign=="4"){//本期未达
                                eml.style.backgroundColor="#FF8080";
                            }else{//未对账
                                eml.style.backgroundColor="#FFFF80";
                            }
                        }
                    });
                },
                checkAllCallback:function(data,elem){//全选
                    calCheckTotalData("bankTb",data);
                }
            })
        }

        //查询账号余额
        $getAccBalance = function(account,bankAcc){
                $clearDatas();//清空数据
            var transDate = dateTypes.get("transTime").val();
            if(!transDate||transDate.trim()==""){


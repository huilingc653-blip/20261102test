<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="account" name="account" value="${fcBankCheck.account}"><!-- 银行中心对账 -->
    <input type="hidden" name="bankAcc" id="bankAcc"  value="${fcBankCheck.bankAcc}"/>
    <input type="hidden" name="curId" id="curId"  value="${fcBankCheck.curId}"/>
    <input type="hidden" name="netId" id="netId"  value="${initNetId}"/>
    <input type="hidden" name="paramType" id="paramType"  value="${fcBankCheck.paramType}"/>
    <input type="hidden" name="checkType" id="checkType"  value="${fcBankCheck.checkType}"/>
    <input type="hidden" name="transTime" id="transTime"  value="$!date.format('yyyy-MM-dd',$!{fcBankCheck.transTime})"/>

</form>
<table id="adjustTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btBankAcc.corpId')</th><!--银行账号  -->
        <th>#springMessage('table.fcBankBalanceAdjust.bankAcc')</th><!--银行账号  -->
        <th>#springMessage('table.fcCheckInit.bankAccName')</th><!--户名  -->
        <th>#springMessage('table.erp.basic.erpid')</th><!--企业账号  -->
        <th>#springMessage('table.nisBillhead.curId')</th><!--币别  -->
        <th>#springMessage('table.fcCheckInit.checkDate')</th><!--对账初始日期  -->
		<th>#springMessage('table.fcBankBalanceAdjust.last.beginDate')</th><!--上次对账开始日期  -->
        <th>#springMessage('table.fcBankBalanceAdjust.last.endDate')</th><!--上次对账结束日期  -->
        <th>#springMessage('table.fcBankBalanceAdjust.queryEndDate')</th><!--对账结束日期  -->
        <th>#springMessage('table.checking.status')</th><!--对账状态  -->
        <th>#springMessage('table.fcBankBalanceAdjust.centreInitBalance')</th><!--企业账面余额  -->
        <th>#springMessage('table.fcBankBalanceAdjust.bankInitBalance')</th><!--银行账面余额  -->
        <th>#springMessage('table.fcBankBalanceAdjust.blnAdjBalance')</th><!--企业调节后余额  -->
        <th>#springMessage('table.fcBankBalanceAdjust.bankAdjBal')</th><!--银行调节后余额  -->
        <th>#springMessage('table.fcBankBalanceAdjust.erpCnt')</th><!--ERP未对笔数  -->
        <th>#springMessage('table.fcBankBalanceAdjust.bankCnt')</th><!--银行未对笔数  -->
        <th>#springMessage('common.table.thead.operation')</th><!--操作  -->
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/check/fcCompareErpAdjust.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<table class="layui-table">
		<tr>
		    <!-- 单位网点 -->
			<td class="textRight">#springMessage("table.btBankAcc.corpId")</td>
			<td>
				<div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-biz-name="corpId"
                         data-callback="corpCallBack"
                         data-scope="all"
                         data-resource="finacial:check:erp:check"></div>
                </div>
            </td>
            <!-- 对账标识-->
            <td class="textRight">#springMessage('finacial.check.erpDataManager.compareSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="finacial.CompareSign"
                     data-name="eqs_compareSign" data-biz-name="compareSign" data-filterdata="2,3,4,5,6"
                     data-defaultvalue=" "></div>
            </td>
            <!-- 结束日期 -->
            <td class="textRight">#springMessage("table.fcBankBalanceAdjust.queryEndDate")</td>
            <td >
                <input type="text" name="endDate" lay-verify="required" class="layui-input bt-biz-dateType"
                       data-today="endDate" data-type="date" data-name="endDate" data-biz-name="endDate" >
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage(
                    "common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage(
                    "common.button.reset")</button>
            </td>
        </tr>
	</table>
</form>
<table id="appTable2" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btBankAcc.corpId')</th><!--银行账号  -->
        <th>#springMessage('table.fcCheckInit.checkDate')</th><!--对账初始日期  -->
		<th>#springMessage('table.fcBankBalanceAdjust.last.beginDate')</th><!--上次对账开始日期  -->
        <th>#springMessage('table.fcBankBalanceAdjust.last.endDate')</th><!--上次对账结束日期  -->
        <th>#springMessage('table.fcBankBalanceAdjust.queryEndDate')</th><!--对账结束日期  -->
        <th>#springMessage('table.checking.status')</th><!--对账状态  -->
        <th>#springMessage('table.fcBankBalanceAdjust.erpCnt')</th><!--ERP未对笔数  -->
        <th>#springMessage('table.fcBankBalanceAdjust.bankCnt')</th><!--银行未对笔数  -->
        <th>#springMessage('common.table.thead.operation')</th><!--操作  -->
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/check/fcCorpCheck.list.js?_btv=${resourceVersion}"></script>
</html>

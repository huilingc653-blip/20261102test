<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        html,body,form,iframe,.layui-tab,.layui-tab-content,.layui-tab-item {
            height: 100%;
        }
    </style>
</head>
<body>
<form class="layui-form" method="post" >
    <div class="layui-tab layui-tab-brief" lay-filter="check">
        <ul class="layui-tab-title">
            <li class="layui-this">#springMessage('finacial.fccompareerp.bankCheck')</li>
            <li>#springMessage('finacial.fccompareerp.corpCheck')</li>
        </ul>
        <div class="layui-tab-content">
            ##ERP对账列表信息
            <div class="layui-tab-item layui-show">
                ##帐号对账列表信息
                <iframe id="backiframe" src="" frameborder="0" style="width: 100%;" name="backiframe" ></iframe>
            </div>
            <div class="layui-tab-item">
                ##单位对账列表信息
                <iframe id="corpiframe" src="" frameborder="0" style="width: 100%;" name="corpiframe"></iframe>
            </div>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/check/fcBankCheck.list.js?_btv=${resourceVersion}"></script>
</html>
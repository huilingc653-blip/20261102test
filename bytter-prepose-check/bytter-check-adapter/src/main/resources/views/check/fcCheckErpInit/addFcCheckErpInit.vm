<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <input type="hidden" name="curId" value="$!{vo.curId}"/>
        <input type="hidden" name="id" value="$!{vo.id}"/>
        <tr>
            <td colspan="2" width="100%" align="center" style="font-weight:bold;font-size: 13px;">ERP余额初始化</td>
        </tr>
        <tr>
            <!-- 银行账号 -->
            <td class="textRight">#springMessage('table.fcCheckInit.bankAcc')：</td>
            <td width="60%">
                <input type="text" name="bankAcc" autocomplete="off" class="layui-input" value="$!{vo.bankAcc}" disabled="disabled">
            </td>
        </tr>
        <tr>
            <!-- 银行账号币别 -->
            <td class="textRight">#springMessage('table.nisBillhead.curId')：</td>
            <td width="60%">
                <input type="text" name="curName" autocomplete="off" class="layui-input" value="$!{vo.curName}" disabled="disabled">
            </td>
        </tr>
        <tr>
            <!-- 企业科目-->
            <td class="textRight" width="40%">#springMessage('table.erp.basic.erpid')：</td>
            <td width="60%">
                <input type="text"  name="account" autocomplete="off" class="layui-input"  value="$!{vo.erpCode}" disabled="disabled">
            </td>
        </tr>
        <tr>
            <!-- 初始对账日期-->
            <td class="textRight">#springMessage('table.fcCheckInit.checkDate')：</td>
            <td width="60%">
                <input id="checkDate" name="checkDate" data-type="date" value="$!{vo.checkDate}" class="layui-input bt-biz-dateType" lay-verify="required" />
            </td>
        </tr>

        <tr>
            <!-- 银行账户初始余额 -->
            <td class="textRight">#springMessage('table.bankacc.init.balance')：</td>
            <td width="60%">
                <input class="layui-input bt-biz-moneyType" data-name="bankBalance" lay-verify="required" value="$!{vo.bankBalance}">
            </td>
        </tr>
        <tr>
            <!--企业余额-->
            <td class="textRight">#springMessage('table.fcCheckInit.blnBalance')：</td>
            <td width="50%">
                <input class="layui-input bt-biz-moneyType" data-name="blnBalance" lay-verify="required" value="$!{vo.blnBalance}">
            </td>
        </tr>
        <tr>
            <!-- 备注 -->
            <td class="textRight">#springMessage('table.fcCheckInit.rmk')：</td>
            <td width="60%">
                <input type="text" id="rmk" name="rmk" autocomplete="off" class="layui-input" value="$!{vo.rmk}">
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script>
    bt.use(['form','dateType','moneyType'], function(){
        var $ = bt.jquery,form = bt.form();
        bt.moneyType.init();
        bt.dateType.init();
        //监听提交
        form.on('submit(submit)', function(data){
            bt.loading.show();//显示加载中
            var action = "/finacial/check/fccheckinit/erpsave";
            $.post(basePath + action,data.field,function(result){
                if(result.success){
                    if(!bt.navtab){
                        bt.navtab.refreshParentTable()
                        parent.layer?parent.layer.closeAll():layer.closeAll();
                    } else {
                        bt.navtab.refreshParentTable()
                        bt.navtab.closeCurrent();
                    }
                }else{
                    bt.loading.hide();
                }
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            },'JSON');
            return false;
        });
    });
</script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" id="paramType" name="paramType" value="0"><!-- 银行中心对账 -->
    <input type="hidden" name="checkDate" id="checkDate" value=""/>

	<table class="layui-table">
		<tr>
		    <!-- 单位网点 -->
			<td class="textRight">#springMessage("table.fcCheckInit.netId")</td>
			<td>
                <div class="bt-biz-corp"
                     data-name="netId"
                     data-biz-type="net"
                     data-type="select"
                     data-required="true"
                     data-filterdata="$!{notAuthNets}"
                     data-biz-name="netId"paramType
                     data-defaultvalue="$!{initNetId}" data-callback="changeNet"></div>
                <input type="hidden" name="netIdStr" id="netIdStr" value="$!{initNetId}"/>
            </td>
            <!--银行账号 -->
            <td class="textRight">#springMessage("table.fcBankBalanceAdjust.bankAcc")</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="eqs_bankAcc" id="bankAcc" data-biz-name="eqs_bankAcc"
                           class="layui-input bank"/><input type="hidden" name="eqs_curId"
                                                            id="curId"/>
                </div>
                <div class="layui-input-inline" id="mulAccDiv" >
                    <button class="bt-biz-mulBankAccInfo" id="mulBankAccInfo" type="button" data-beforeClick="bt.externalMulAccInfoNetIdParams" data-callback="bt.externalMulAccInfoCallback" title="#springMessage('table.btwarnstrategy.accountselect.title')" >
                        #springMessage('table.btwarnstrategy.accountselect.title')
                    </button>
                </div>
            </td>

            <!-- 对账标识-->
            <td class="textRight">#springMessage('finacial.check.erpDataManager.compareSign')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="finacial.CompareSign"
                     data-name="eqs_compareSign" data-biz-name="compareSign" data-filterdata="2,3,4,5,6"
                     data-defaultvalue=" "></div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage("table.checking.endDate")</td>
            <td >
                <input type="text" id="transTime" name="transTime" lay-verify="required" class="layui-input bt-biz-dateType"
                        data-type="date" data-name="transTime" data-biz-name="transTime" value="$!{initNetOverDate}" data-max="$!{initNetOverDate}" >
            </td>
            ##核对标准
            <td class="textRight" width="7%">#springMessage("table.fcCompare.Check_the_standard")</td>
            <td width="17.5%">
                <div class=layui-form>
                    <div class="bt-biz-selectType" data-url="${basePath}/finacial/paramconfig/fccomparechecktype/json" data-valuefield="id" data-textfield="checkTypeName" data-name="checkType"></div>
                </div>
            </td>
        </tr>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage(
                    "common.button.search")</button>
                <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage(
                    "common.button.reset")</button>
            </td>
        </tr>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btBankAcc.corpId')</th><!--银行账号  -->
        <th>#springMessage('table.fcBankBalanceAdjust.bankAcc')</th><!--银行账号  -->
        <th>#springMessage('table.fcCheckInit.bankAccName')</th><!--户名  -->
        <th>#springMessage('table.erp.basic.erpid')</th><!--企业账号  -->
        <th>#springMessage('table.nisBillhead.curId')</th><!--币别  -->
        <th>#springMessage('table.fcCheckInit.checkDate')</th><!--对账初始日期  -->
		<th>#springMessage('table.fcBankBalanceAdjust.last.beginDate')</th><!--上次对账开始日期  -->
        <th>#springMessage('table.fcBankBalanceAdjust.last.endDate')</th><!--上次对账结束日期  -->
        <th>#springMessage('table.checking.endDate')</th><!--对账结束日期  -->
        <th>#springMessage('table.checking.status')</th><!--对账状态  -->
        <th>#springMessage('table.fcBankBalanceAdjust.erpCnt')</th><!--ERP未对笔数  -->
        <th>#springMessage('table.fcBankBalanceAdjust.bankCnt')</th><!--银行未对笔数  -->
        <th>#springMessage('common.table.thead.operation')</th><!--操作  -->
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/check/fcCompareCenter.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
        .dt-buttons {
            display: none;
        }
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            <!-- 单位111222 -->
            <td class="textRight" width="8%">#springMessage("table.fbsBudget.corpId")</td>
            <td class="rCode" width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="net"
                         data-type="selectTree"
                         data-name="eqs_netCode"
                         data-scope="net"
                         data-biz-name="corpId"
                         data-required="true"
                         data-callback="corpCallBack"
                         data-resource="finacial:banlanceSheet:query"


                    ></div>
                </div>
            </td>
            <!-- 币别-->
            <td class="textRight" width="8%">#springMessage('table.nisAllocationReport.curName')</td>
            <td class="rCode" width="25%">
                <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                     data-biz-name="curId"
                     data-name="eqs_curCode" data-valueField="id" data-textField="curName"></div>
            </td>

            <td class="textRight" width="8%">#springMessage('table.fcAccuBalance.date')</td>
            <td>
                <input type="text" name="checkDate" data-type="month" data-biz-name="checkDate"
                       data-callback="checkDateCallBack"
                       class="layui-input bt-biz-dateType" lay-verify="required">
            </td>
        </tr>
        <tr>
            ##是否折合本位币
            <td class="textRight">#springMessage('cms.report.loan.convertLoaclCur')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-value="0"
                         data-callback="isConvertCallBack"
                         data-name="isConvert" data-biz-name="isConvert"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.curName.natualCurrency')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                         data-biz-name="convertCurId" data-callback="convertCurIdCallBack"
                         data-name="convertCurId" data-disabled="true" data-valueField="id"
                         data-textField="curName"></div>
                </div>
            </td>
            <td class="textRight">#springMessage('table.report.convertCurType')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btratetype/json"
                         data-biz-name="rateType" data-callback="rateTypeCallBack"
                         data-name="rateType" data-disabled="true" data-valueField="id" data-textField="typeName"></div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.report.execRateDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="preDate" id="preDate" data-biz-name="preDate"
                           data-callback="preDateCallBack"
                           class="layui-input bt-biz-dateType">
                </div>
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td colspan="6" align="center">
                <button class="layui-btn" lay-submit lay-filter="search">#springMessage(
                    "common.button.search")</button>
                <button id="reset" type="reset" class="layui-btn layui-btn-primary"
                        >#springMessage('common.button.reset')</button>
                <button class="layui-btn" lay-submit lay-filter="excel">#springMessage('common.button.exports')</button>
                <button id="printBt" class="layui-btn" type="button">#springMessage('common.button.print')</button>
                ##				 <button class="layui-btn" lay-submit lay-filter="excel">#springMessage('common.button.exports')</button>
            </td>
        </tr>
    </table>
</form>
## 表头信息
<div id="headInfoContainerElement"
     style="display: flex;flex-direction:row;justify-content: space-between;align-items: center;width:100%;margin-top: 5px;margin-bottom: 5px;">
    <span id="netNameShowContainerElement"
          style="flex: 1;justify-content: center;align-items: center;text-align: center;">#springMessage(
        'table.fcIncomStatement.corp')<span id="netName"></span></span>
    <span id="dateTimeShowContainerElement"
          style="flex: 1;justify-content: center;align-items: center;text-align: center;">#springMessage(
        'table.fcIncomStatement.state')<span id="dateTime"></span></span>
    <span id="curShowContainerElement"
          style="flex: 1;justify-content: center;align-items: center;text-align: center;">#springMessage(
        'table.fcIncomStatement.cur')<span id="cur"></span></span>
</div>
<div id="print" class="print-list">
    <table id="appTable" class="layui-table layui-form" style="width:100%;font-family: '宋体';">
        <thead>
            ##        <tr style="border: 0px;">
            ##            <td colspan="3">#springMessage('table.fcIncomStatement.corp')<span id="netName"></span></td>
            ##            <td colspan="3">#springMessage('table.fcIncomStatement.state')<span id="dateTime"></span></td>
            ##            <td colspan="2">#springMessage('table.fcIncomStatement.cur')<span id="cur"></span></td>
            ##        </tr>
        <tr>
            <th>#springMessage('table.fcBalanceSheet.aItem')</th><!--资产项目 -->
            <th>#springMessage('table.fcReportFormat.orderNo')</th><!--行次 -->
            <th>#springMessage('table.fcBalanceSheet.yearBalance')</th><!--资产年初数-->
            <th>#springMessage('table.fcBalanceSheet.monthBalance')</th><!--资产期末数 -->
            <th>#springMessage('table.fcBalanceSheet.lItem')</th><!--负债项目 -->
            <th>#springMessage('table.fcReportFormat.orderNo')</th><!--行次 -->
            <th>#springMessage('table.fcBalanceSheet.yearBalance')</th><!--负债年初数-->
            <th>#springMessage('table.fcBalanceSheet.monthBalance')</th><!--负债期末数 -->
        </tr>
        </thead>
    </table>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/check/listFcBanlanceSheet.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
	<table class="layui-table">
		<tr>
		    <!-- 单位网点 -->
			<td class="textRight">#springMessage("table.btBankAcc.corpId")</td>
			<td>
				<div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-biz-name="corpId"
                         data-scope="all"
                         data-resource="finacial:check:opposite:carryover:query"
                         placeholder="#springMessage('table.fcCheckInit.netId')"></div>
                </div>
            </td>

            <!--银行账号 -->
            <td class="textRight">#springMessage("table.fcCheckInit.bankAcc")</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="likes_bankAcc" id="bankAcc" data-biz-name="bankAcc"
                           class="layui-input bank"/><input type="hidden" name="eqs_curCode"
                                                            id="curCode"/>
                </div>
            </td>
        </tr>
        <tr>
            <!-- 企业账号 -->
            <td class="textRight">#springMessage("table.erp.basic.erpid")</td>
            <td>
                <div class="layui-inline"><input type="text" name="likes_account" class="layui-input bank"/></div>
            </td>
            <td class="textRight">#springMessage("table.fcBankBalanceAdjust.adjustDate")</td>
            <td >
                <div class="layui-inline"><div class="date-interval"></div></div>
            </td>
        </tr>
		<tr>
            <!-- 对账类型 -->
			<td class="textRight">#springMessage("table.fcBankBalanceAdjust.checkType")</td>
			<td colspan="3">
##				<div class="layui-inline">
##					#set ($mymap ={"field":"eqs_checkType","type":"radio","typeGroupCode":"fcBankBalanceAdjust.checkType","defaultVal":"0","title":"table.fcBankBalanceAdjust.checkType"})
##					#set ($formB = $dictSelect.instance($mymap)) ${formB.html()}
##				</div>
				<div class="layui-form">
					<div class="bt-biz-dict" data-type="radio" data-defaultvalue="0" data-biz-name="eqs_checkType"  data-name="eqs_checkType" data-group="fcBankBalanceAdjust.checkType"></div>
				</div>
			</td>
		</tr>
		<tr>
			<td colspan="4" align="center">
	            <button class="layui-btn layui-btn-small" lay-submit lay-filter="search">#springMessage("common.button.search")</button>
	            <button class="layui-btn layui-btn-small" lay-submit lay-filter="restore">#springMessage("common.button.restore")</button>
	            <button type="reset" class="layui-btn layui-btn-primary layui-btn-small">#springMessage("common.button.reset")</button>
        	</td>
        </tr>
	</table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('table.fcBankBalanceAdjust.beginDate')</th><!--开始日期  -->
        <th>#springMessage('table.fcBankBalanceAdjust.endDate')</th><!--结束日期  -->
        <th>#springMessage('table.btBankAcc.corpId')</th><!--单位  -->
        <th>#springMessage('table.fcBankBalanceAdjust.bankAcc')</th><!--银行账号  -->
        <th>#springMessage('table.nisBillhead.curId')</th><!--币别  -->
        <th>#springMessage('table.fcBankBalanceAdjust.bankInitBalance')</th><!--银行账面余额  -->
        <th>#springMessage('table.fcBankBalanceAdjust.bankAdjBal')</th><!--银行调节余额  -->
        <th>#springMessage('table.erp.basic.erpid')</th><!--企业账号  -->
        <th>#springMessage('table.fcBankBalanceAdjust.blnInitBalance')</th><!--企业账面余额  -->
        <th>#springMessage('table.fcBankBalanceAdjust.blnAdjBalance')</th><!--企业调节余额  -->
        <th>#springMessage('table.fcBankBalanceAdjust.adjustDate')</th><!--结转日期  -->
        <th>#springMessage('table.fcBankBalanceAdjust.checkType')</th><!--对账类型  -->
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/check/redoAdjustOver.js?_btv=${resourceVersion}"></script>
</html>

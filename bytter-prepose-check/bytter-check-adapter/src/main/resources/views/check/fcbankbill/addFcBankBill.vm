		//提交
		$("#submitBut").on("click",function(){
			//bt.loading.show();//显示加载中
			$('button.addBtn').addClass('layui-btn-disabled')
			var trs = $("#editTable > tbody").children('tr:visible');
			if(trs.length > 0){
				var data = new Object();
				trs.each(function(i,tr){
					var tds = $(tr).children('td');
					tds.each(function(index,td){
						var $input = $(td).find('[name]');
						var name = $input.attr('name');
						if(typeof(name) != "undefined"){
							name = name.substring(0,name.indexOf("_"));
							var text ;
							if(name == "redblueSign"){
								text = dicts.get($input[0].name).val();
							}else{
								text = $input.val();
							}
							data["accList["+ i +"]."+ name ] = text;
							/*if(name == "bankAcc"){
                                name =## $input[1].name;
			 					name = name.substring(0,name.indexOf("_"));
			 					text =## $input[1].value;
			 					data["accList["+ i +"]."+ name ] = text;
			 				}*/
						}

						/* if($input[1] !== undefined && flag){
		 					var name = $input[1].name;
		 					if(typeof(name) != "undefined"){
			 					name = name.substring(0,name.indexOf("_"));
				 				var text = $input[1].value;
				 				data["accList["+ i +"]."+ name ] = text;
			 				}
		 				} */
					});
				});
				var action =  "/finacial/check/fcbankbill/save";
				$.post(basePath + action,data,function(result){
					if(result.success){
						bt.navtab.refreshParent();
						bt.navtab.closeCurrent();
						parent.layer?parent.layer.closeAll():layer.closeAll();
					}else{
						var lang  = bt.lang(result.msg,result.params);
						$('button.addBtn').addClass('layui-btn')
					}
					//bt.loading.hide(); //关闭加载中
					parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
				},'JSON');
			}else{
				layer.alert("#springMessage('finacial.check.manager.msg.nulldata')");
				//bt.loading.hide(); //关闭加载中
				return false;
			}
		});
	});

	//非空校验
	function doValidater(){
		if($("#editTable > tbody > tr").length < 1){
			return true;
		}
		var lastBankAcc = $("#editTable>tbody>tr:last input[name^='bankAcc']")[0].value;
		var lastCurId = $("#editTable > tbody > tr:last input[name^='curId']")[0].value;
		var lastTallyDate = $("#editTable > tbody > tr:last input[name^='tallyDate']")[0].value;
		if($.trim(lastBankAcc) == "" || $.trim(lastCurId) ==="" || $.trim(lastTallyDate) == "" ){
			return false ;
		}
		return true;
	};


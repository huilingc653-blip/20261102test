<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
	<style>
		table tbody td,table thead th{
			word-break: keep-all;
			white-space:nowrap;
		}
		.required{
			color: red;
		}

		.layui-form-item{
			text-align: center;
		}

	</style>
</head>
<body>
<div class="layui-field-box">
	<div class="input150-container">
		<table id="editTable" class="layui-table layui-form" style="width: 100%">
			<thead>
			<tr>
				<th ><span class="required">*</span>#springMessage('table.fcBankBill.bankAcc')</th><!-- 银行账号 -->
				#*<th ><span class="required">*</span>#springMessage('table.account.or.erpSubject')</th><!-- 内部账号/erp企业科目 -->*#
				<th ><span class="required">*</span>#springMessage('table.fcBankBill.curId')</th><!-- 币别 -->
				<th ><span class="required">*</span>#springMessage('table.fcBankBill.tallyDate')</th><!-- 发生日期 -->
				<th ><span class="required">*</span>#springMessage('table.fcBankBill.debitMoney')</th><!-- 借方金额 -->
				<th ><span class="required">*</span>#springMessage('table.fcBankBill.creditMoney')</th><!-- 贷方金额 -->
				<th ><span class="required">*</span>#springMessage('table.fcBankBill.redblueSign')</th><!-- 红蓝标识 -->
				<th>#springMessage('table.fcBankBill.billNo')</th><!-- 票据号 -->
				<th>#springMessage('table.fcBankBill.voucherNo')</th><!-- 凭证号 -->
				<th>#springMessage('table.fcBankBill.compareSign')</th><!-- 对账标识 -->
				<th>#springMessage('common.table.thead.operation')</th>
			</tr>
			</thead>
			<tbody>
			</tbody>
		</table>
	</div>
	<div class="layui-form-item">
		<div class="layui-input-block">
			<button class="layui-btn" id="submitBut">#springMessage('common.button.submit')</button>
		</div>
	</div>
</div>
	#parse("views/common/footer.vm")
</body>
<script>
	bt.use(['jquery','form','selectTable','btdate','moneynum','bttable','dicts','dateType','moneyType'],function(){
		$ = bt.jquery;
		form = bt.form();

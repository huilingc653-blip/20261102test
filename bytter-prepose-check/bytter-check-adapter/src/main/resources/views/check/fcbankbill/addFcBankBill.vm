			return false;
		}
		var otherName;
		if(signType == 'debitMoney'){
			otherName = 'creditMoney';
		}else{
			otherName = 'debitMoney';
		}
		var temdebit = moneyType.get(otherName+"_index"+index).val();
		if( data == 0){

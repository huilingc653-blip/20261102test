			if(temdebit > 0){
				layer.msg("借贷方不能都不为0");
				return false;
			}
		} */
	}

	function addAttr(){
		//非空校验
		//去掉前台页面新增行必填数据校验
		/* if(!doValidater()){
			layer.msg("#springMessage('table.fcBankBill.dataNotNull')");
			return false;
		} */
		var $lastTr = $("#editTable>tbody>tr");
		var bank_Acc = '<td><div class="layui-inline"><input type="text" name="bankAcc_index' + rowMR + '" id="bankAcc_index' + rowMR + '" class="layui-input text" autocomplete="off">'
				//+ '<input type="hidden" name="account_index' + rowMR + '" id="account_index' + rowMR + '" >'
				+ '<table id="example' + rowMR + '">'
				+ '	<thead>'
				+ '    	<tr>'
				+ '        	<th>#springMessage('table.fcBankBill.bankAcc')</th>'
				+ '			<th>#springMessage('table.fcCheckInit.bankName')</th>'
				+ '			<th>#springMessage('table.fcBankBill.curId')</th>'
				+ '    	</tr>'
				+ '    </thead>'
				+ '</table>'
				+ '</div></td>';
		var html='<tr row="'+rowMR+'">';
		html+= bank_Acc;
		/*html+='<td><input class="layui-input" id="account_index'+ rowMR +'" name="account_index'+ rowMR +'" /></td>';*/
		html+='<td><input id="curId_index'+ rowMR +'" name="curId_index'+ rowMR +'" class="layui-input" type="hidden" readonly="readonly"/>';
		html+='<input id="curName_index'+ rowMR +'" name="curName_index'+ rowMR +'" class="layui-input" type="text" readonly="readonly"/></td>';
		html+='<td><input type="text" name="tallyDate_index'+ rowMR +'" data-biz-name="tallyDate_index'+ rowMR +'" id="tallyDate_index'+ rowMR +'" class="layui-input bt-input-inline bt-biz-dateType" autocomplete="off"></td>';
		html+='<td><input type="text" data-biz-name="debitMoney_index'+ rowMR +'" data-name="debitMoney_index'+ rowMR +'" class="layui-input bt-biz-moneyType" data-decimal="2" data-minus="true" data-callback="validateAcc"></td>';
		html+='<td><input type="text" data-biz-name="creditMoney_index'+ rowMR +'" data-name="creditMoney_index'+ rowMR +'" class="layui-input bt-biz-moneyType" data-decimal="2" data-minus="true" data-callback="validateAcc"></td>';
		html+='<td><div class="bt-biz-dict" data-type="radio" data-group="Finacial.RedBlueSign" data-defaultvalue="B"  data-name="redblueSign_index'+ rowMR +'" data-biz-name="redblueSign_index'+ rowMR +'"></td>';
		html+='<td><input type="text" autocomplete="off" class="layui-input" id="billNo_index'+ rowMR +'" name="billNo_index'+ rowMR +'" /></td>';
		html+='<td><input type="text" autocomplete="off" class="layui-input" id="voucherNo_index'+ rowMR +'" name="voucherNo_index'+ rowMR +'" /></td>';
		html+='<td><div class="bt-biz-dict" data-type="select" data-group="finacial.CompareSign" data-defaultvalue="0" data-name="compareSign_index'+ rowMR +'" data-biz-name="compareSign_index'+ rowMR +'" data-disabled="true"></td>';
		html+='<td><input id="bankAccId_index'+ rowMR +'" name="bankAccId_index'+ rowMR +'" class="layui-input" type="hidden" /><button data-type="del" class="layui-btn layui-btn-mini">'+bt.lang("common.button.delete")+'</button></td>';
		html+='</tr>';
		$("#editTable>tbody").append(html);
		bt.dicts.init();
		dateType.init();
		moneyType.init();
		initSelectAccount(rowMR);
		if($lastTr.length  > 0){
			var index = rowMR - 1;
			$("#bankAcc_index"+rowMR).val($("#bankAcc_index"+index).val());
			$("#bankAccId_index"+rowMR).val($("#bankAccId_index"+index).val());
			$("#curId_index"+rowMR).val($("#curId_index"+index).val());
			$("#curName_index"+rowMR).val($("#curName_index"+index).val());
			$("#account_index"+rowMR).val($("#account_index"+index).val());
		}
		rowMR++;
	}

	function initSelectAccount(row){
		var cls="";
		if(row!= undefined){
			cls=row
		}
		bt.use(['jquery','form','selectTable'],function(){
			bt.selectTable.init({
				elem: "#example"+cls,
				url: basePath+"/finacial/check/fcbankbill/queryBank",
				scrollX: true,
				scrollY:"200px",
				searchInput:"#bankAcc_index"+cls,
				columns: [
					{data:"bankAcc",},
					{data:"bankName",},
					{data:"curName",},
					//{data:"account",},
				],
				clickCallback:function(data){
					//设置账户名称
					$("#bankAcc_index"+cls).val(data.bankAcc);
					$("#bankAccId_index"+cls).val(data.bankAccId);
					$("#curId_index"+cls).val(data.curId);
					//$("#account_index"+cls).val(data.account);
					$("#curName_index"+cls).val(data.curName);
				}
			});
		});
	}
</script>
</html>

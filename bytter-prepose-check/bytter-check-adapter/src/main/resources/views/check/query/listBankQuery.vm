<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form id="searchForm"  style="padding: 0px 20px;" class="layui-form tt">
  <table class="layui-table ">
	<tbody>
					
        <tr>
            <!-- 单位名称 -->
            <td class="textRight">#springMessage('table.nisPersonnelDetail.corpId')</td>
        ##            <td width="40%">
        ##                <div class="bt-biz-corp" data-name="eqs_corpId" data-biz-type="corp" data-type="select"></div>
        ##            </td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-biz-name="corpId"
                         data-callback="corpCallBack"
                         data-scope="all"
                         data-resource="finacial:check:bank:query"></div>
                </div>
            </td>

            <!-- 对账标志 -->
            <td class="textRight">#springMessage('table.fcBankBill.compareSign')</td>
            <td>
                <div class="layui-input-inline">
                    <div class=layui-form>
                        <div class=bt-biz-dict data-type="select" data-name="eqs_compareSign"
                             data-biz-name="compareSign"
                             data-group="finacial.CompareSign" data-disabled="false"></div>
                    </div>
                </div>
            </td>
        </tr>
          
        <tr>
            <!-- 银行卡号 -->
            <td class="textRight">#springMessage('table.fcBankBill.bankAcc')</td>
            <td>
                <input type="text" name="likes_bankAcc" id="bankAcc" data-biz-name="bankAcc"
                        class="layui-input bank"/>
                <input type="hidden" name="eqs_curId"
                       id="curId"/>
            </td>

            <!--发生日期 -->
            <td class="textRight">#springMessage('finacial.check.erpDataManager.occurDate')</td>
            <td>
                <div class="layui-form-item">
                    <div class="date-interval"></div>
                </div>
            </td>
        </tr>

        <!-- 按钮组 -->
        <tr>
            <td style="text-align: center;" colSpan="6">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <!-- <button class="layui-btn" lay-submit lay-filter="excel">#springMessage(
                    'common.button.exports')</button> -->
            </td>
        </tr>


        </tbody>
    </table>
</form>

<table id="appTable" id='oDiv2' class="layui-table layui-form" style="width:100%;" data-btns="print">
  <thead>
    <tr>
        <th>#springMessage('table.fcBankBill.tallyDate')</th>
        <th>#springMessage('table.fcBankBill.bankAcc')</th>
        <th>#springMessage('table.nisBillhead.curId')</th><!--币别  -->
        <th>#springMessage('table.fcBankBill.debitMoney')</th>
        <th>#springMessage('table.fcBankBill.creditMoney')</th>
      <!--   <th>#springMessage('table.fcBankBill.balance')</th> -->
        <th>#springMessage('fcAccSummons.summaryContent')</th>
        <th>#springMessage('table.fcBankBill.billNo')</th>
        <th>#springMessage('table.fcBankBill.redblueSign')</th>
        <th>#springMessage('table.fcBankBill.compareSign')</th>      
    </tr>
 </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/check/bankQuery.list.js?_btv=${resourceVersion}"></script>
</html>

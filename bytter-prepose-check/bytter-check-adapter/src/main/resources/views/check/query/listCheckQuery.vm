<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>

  <form id="searchForm" class="layui-form tt">
   <table class="layui-table ">
    <tbody>
    	<tr>
            <input type="hidden" id="type" value="$!{type}">
        	<!-- 记账日期 -->
            <td class="textRight">#springMessage('table.fcCompareAcc.tallyDate')</td>
            <td width="40%">
            	<div class=layui-inline>
					<input id="tallyDateStart" class="layui-input bt-input-inline bt-biz-dateType" type=text name="ged_tallyDate" data-endid="tallyDateSend"/>
					<span class=date-mid>~</span>
					<input id="tallyDateSend" class="layui-input bt-input-inline bt-biz-dateType" type=text name="led_tallyDate"/>
				</div>
			</td>
			
			<!-- 中心帐号 -->
         	<td class="textRight">#springMessage('finacial.check.centralityDataManager.centralityAcc')</td>
            <td width="40%">
               <div class="layui-input-inline"> 
                    <input type="text" name="likes_compAcc" class="layui-input bank" placeholder="#springMessage('finacial.check.centralityDataManager.centralityAcc')"> 
               </div> 
      		</td>
         	
         	<!-- 对账标志 -->
            <td class="textRight">#springMessage('table.fcBankBill.compareSign')</td>
         	<td width="40%">
				<div class=layui-form>
					<div class=bt-biz-dict data-type="select" data-name="eqs_compareSign" data-width="120px" data-biz-name="eqs_compareSign"  data-group="finacial.CompareSign"></div>
				</div>
			</td>
      </tr>
            
            
		<!-- 按钮组 -->
		<tr>
			<td style="text-align: center;" colSpan="6">    
 				 <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
            	 <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
    		</td>
    	</tr>
    	
    </tbody>
</table>

</form>
    
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('finacial.check.centralityDataManager.centralityAcc')</th>
        <th>#springMessage('table.nisBillhead.curId')</th><!--币别  -->
        <th>#springMessage('table.fcCompareAcc.voucherNo')</th><!-- 凭证号 -->
        <th>#springMessage('table.fcCompareAcc.billNo')</th><!-- 票据号 -->
        <th>#springMessage('table.fcCompareAcc.redblueSign')</th><!-- 红蓝标识 -->
       	<th>#springMessage('table.fcCompareAcc.tallyDate')</th>
        <th>#springMessage('table.fcCompareAcc.debitMoney')</th>
        <th>#springMessage('table.fcCompareAcc.creditMoney')</th>
        <!-- <th>#springMessage('table.fcCompareAcc.balance')</th> -->
        <th>#springMessage('table.fcBankBillTemp.compareSign')</th>
	 </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/check/checkQuery.list.js?_btv=${resourceVersion}"></script>
</html>

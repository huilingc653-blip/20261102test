<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
</head>
<body>
<div id="print">
    <form id="searchForm" class="layui-form tt">
        <table class="layui-table ">
            <tbody>
            <input type="hidden" id="type" value="$!{type}">
            <tr>
                <!-- 单位名称 -->
                <td class="textRight">#springMessage('table.nisPersonnelDetail.corpId')</td>
                #*<td>
                    <div class="bt-biz-corp" data-name="eqs_corpId" data-biz-type="corp" data-type="select"></div>
                </td>*#

                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-name="eqs_corpId"
                             data-biz-name="corpId"
                             data-callback="corpCallBack"
                             data-scope="all"
                             data-resource="finacial:check:erp:query"></div>
                    </div>
                </td>

                <!-- 对账标志 -->
                <td class="textRight">#springMessage('table.fcBankBill.compareSign')</td>
                <td>
                    <div class=layui-form>
                        <div class=bt-biz-dict data-type="select" data-name="eqs_compareSign"
                             data-biz-name="eqs_compareSign" data-group="finacial.CompareSign"></div>
                    </div>
                </td>
            </tr>

            <tr>
                <!-- 银行卡号 -->
                <td class="textRight">#springMessage('table.fcBankBill.bankAcc')</td>
            #*    <td><input class="layui-input bank" name="likes_compAcc" type="text"/></td>*#
                <td>
                    <div class="layui-inline">
                        <input type="text" name="likes_compAcc" id="compAcc" data-biz-name="compAcc"
                               class="layui-input bank"/><input type="hidden" name="eqs_curCode"
                                                                id="curId"/>
                    </div>
                </td>


                <!--发生日期 -->
                <td class="textRight">#springMessage('finacial.check.erpDataManager.occurDate')</td>
                <td>
                    <div class="layui-form-item">
                        <div class="date-interval"></div>
                    </div>
                </td>
            </tr>

				<!-- 按钮组 -->
				<tr>
					<td style="text-align: center;" colSpan="6">
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
						##<button class="layui-btn " lay-submit lay-filter="excel">#springMessage('common.button.exports')</button>

					</td>
				</tr>

			</tbody>
		</table>

	</form>


	<table id="appTable" class="layui-table layui-form"
		style="width: 100%;" data-btns="print">
		<thead>
			<tr>
				<th>#springMessage('table.fcCompareAcc.tallyDate')</th>
				<th>#springMessage('table.fcBankBill.bankAcc')</th>
                <th>#springMessage('table.nisBillhead.curId')</th><!--币别  -->
				<th>#springMessage('table.fcCompareAcc.debitMoney')</th>
				<th>#springMessage('table.fcCompareAcc.creditMoney')</th>
				<th>#springMessage('table.fcCompareAcc.balance')</th>
				<th>#springMessage('table.fcCompareAcc.voucherNo')</th>
				<th>#springMessage('table.fcCompareAcc.redblueSign')</th>
				<th>#springMessage('table.fcCompareAcc.compareSign')</th>
				<th>#springMessage('table.fcCompareAcc.summaryContent')</th>
				<th>#springMessage('table.fcCompareAcc.dataSource')</th>

			</tr>
		</thead>
	</table>
	#parse("views/common/footer.vm")
</div>
</body>
<script src="${basePath}/static/modules/check/erpQuery.list.js?_btv=${resourceVersion}"></script>
</html>

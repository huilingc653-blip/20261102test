	        <th>#springMessage('table.fcBankBillTemp.curCode')</th><!-- 币别 -->
	        <th>#springMessage('table.fcBankBillTemp.debitMoney')</th><!-- 借方金额 -->
	        <th>#springMessage('table.fcBankBillTemp.creditMoney')</th><!-- 贷方金额 -->
	        <th>#springMessage('table.fcBankBillTemp.redblueSign')</th><!-- 红蓝标识 -->
	        <th>#springMessage('table.fcBankBillTemp.summaryContent')</th><!-- 对账标识 -->
	    </tr>
    </thead>
    <tbody>
    </tbody>
</table>
#parse("views/common/footer.vm")
</body>

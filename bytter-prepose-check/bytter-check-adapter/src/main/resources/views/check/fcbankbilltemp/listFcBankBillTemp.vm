	$("#import").click(function(){
		up = bt.btImport.init({
	        code: "30000001",
	        titleRows: 0,
	        width: "1000px",
	        headRows: 1,
	        success: function (head, data, select) { //点击确认后回调方法，这里导入组件写了success方法这里可以不用此方法
	            $.ajax({
	                type: "POST",
	                url: basePath + "/finacial/check/fcbankbilltemp/saveImport",
	                dataType: "json",
	                contentType: "application/json",
	                data: JSON.stringify(up.getSelectData()),
	                success: function (result) {
	           			var importData;
	      		  		if(typeof result.success == 'boolean' && !result.success){
	  	    				importData = {};
	      		 		}else{
	  	    				importData = data;
	      		  		}
	          		  	bt.bttable.init({
	          		    	elem: "#appTable",
	          		    	data:importData,
	          		    	columns: [
	      	    		        { "data": "bankAcc" },
	      	    		        { "data": "tallyDate",render: function ( data, type, full, meta ) {
	      	    		        	return bt.date.format(data.tallyDate,'yyyy-mm-dd');
	      	                    } },
	      	    		        { "data": "curName" },
	      	    		        { "data": "debitMoney",className:'textRight',render: function ( data, type, full, meta ) {
	      	                        return moneyFun.format(data.debitMoney);
	      	                    }},
	      	    		        { "data": "creditMoney",className:'textRight',render: function ( data, type, full, meta ) {
	      	                        return moneyFun.format(data.creditMoney);
	      	                    } },
	      	    		        { "data": "redblueSign" },
	      	    		        { "data": "summaryContent" }
	      	 		    		]
	          		    });
	                	parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
	            	}
	        	});
	    	}
		});
	});

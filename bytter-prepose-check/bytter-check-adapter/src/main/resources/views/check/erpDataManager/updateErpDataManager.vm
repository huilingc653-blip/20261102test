<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
	<style>
		.required{
			color: red;
		}
	</style>
</head>
<body>
	<form class="layui-form layui-form-pane" method="post">
		<input id="id" name="id" type="hidden" value="$!{fcCompareAccPage.id}">
		<table class="layui-table">
	    	<tbody>
		    	<tr>
		    		<!-- 中心帐号 -->
		    		<td class="textRight"><span class="required">*</span>#springMessage('finacial.check.erpDataManager.bankAcc')</td>
		    		<td>
		    			<input id="compAcc" name="compAcc" class="layui-input" type="text" value="$!{fcCompareAccPage.compAcc}" />
		    			<input type="hidden" name="curId" id="curId" value="$!{fcCompareAccPage.curId}"/>
		    			<table id="compAccTable" class="hide">
			    			<thead>
				    			<tr>
				    				<th>#springMessage('table.nisBillhead.bankAcc')</th>
				    				<th>#springMessage('table.accountDTO.bankName')</th>
				    				<th>#springMessage('table.fcCompareAcc.finacialAccount')</th>
				    			</tr>
			    			</thead>
		    			</table>
		    		</td>
		    		<!-- 发生日期 -->
		    		<td class="textRight"><span class="required">*</span>#springMessage('finacial.check.erpDataManager.occurDate')</td>
		    		<td>
	    				<div type="date" field="tallyDate" defaultVal="$!date.format('yyyy-MM-dd',$!fcCompareAccPage.tallyDate)"></div>
		    		</td>
		    	</tr>
		    	<tr>
		    		<!-- 贷方金额 -->
		    		<td class="textRight"><span class="required">*</span>#springMessage('finacial.check.erpDataManager.creditMoney')</td>
		    		<td>
		    			<input class="layui-input bt-biz-moneyType" lay-verify="required" data-decimal="2" data-name="creditMoney" value="$!{fcCompareAccPage.creditMoney}"/>
		    		</td>
		    		<!-- 借方金额 -->
		    		<td class="textRight"><span class="required">*</span>#springMessage('finacial.check.erpDataManager.debitMoney')</td>
		    		<td>
		    			<input class="layui-input bt-biz-moneyType" lay-verify="required" data-decimal="2" data-name="debitMoney" value="$!{fcCompareAccPage.debitMoney}"/>
		    		</td>
		    	</tr>
		    	<tr>
		    		<!-- 红蓝标识 -->
		    		<td class="textRight">#springMessage('finacial.check.erpDataManager.redblueSign')</td>
		    		<td colspan="3">
##		    			#set ($redblueSignMap = {"field":"redblueSign","type":"radio","typeGroupCode":"Finacial.RedBlueSign","defaultVal":"$!{fcCompareAccPage.redblueSign}"})
##			            #set ($formRedblueSign = $dictSelect.instance($redblueSignMap))
##			         	${formRedblueSign.html()}
						<div class="bt-biz-dict" data-group="Finacial.RedBlueSign" data-name="redblueSign" data-biz-name="redblueSign" data-type="radio" data-defaultvalue="$!{fcCompareAccPage.redblueSign}"></div>
		    		</td>
		    	</tr>
		    	<tr>
		    		<!-- 凭证号 -->
		    		<td class="textRight"><span class="required">*</span>#springMessage('finacial.check.erpDataManager.voucherNo')</td>
		    		<td>
		    			<input class="layui-input" id="voucherNo" name="voucherNo" value="$!{fcCompareAccPage.voucherNo}"/>
		    		</td>
		    		<!-- 对账标识 -->
		    		<td class="textRight">#springMessage('finacial.check.erpDataManager.compareSign')</td>
		    		<td>
		    			<div class="layui-input-inline">
##			    			#set ($compareSignMap = {"field":"compareSign","type":"select","typeGroupCode":"finacial.CompareSign","defaultVal":"$!{fcCompareAccPage.compareSign}"})
##				            #set ($formCompareSign = $dictSelect.instance($compareSignMap))
##				         	${formCompareSign.html()}
							<div class="bt-biz-dict" data-type="select" data-group="finacial.CompareSign"
								 data-name="compareSign" data-biz-name="compareSign" data-defaultvalue="$!{fcCompareAccPage.compareSign}"></div>
			         	</div>
		    		</td>
		    	</tr>
		    	<tr>
		    		<!-- 摘要 -->
		    		<td class="textRight">#springMessage('finacial.check.erpDataManager.summaryContent')</td>
		    		<td>
		    			<input class="layui-input" id="summaryContent" name="summaryContent" value="$!{fcCompareAccPage.summaryContent}"/>
		    		</td>
		    		<!-- 企业账来源 -->
		    		<td class="textRight">#springMessage('finacial.check.erpDataManager.dataSource')</td>
		    		<td>
		    			<div class="layui-input-inline">
##			    			#set ($dataSourceMap = {"field":"dataSource","type":"select","typeGroupCode":"Finacial.DataSource","defaultVal":"$!{fcCompareAccPage.dataSource}"})
##				            #set ($formDataSource = $dictSelect.instance($dataSourceMap))
##				         	${formDataSource.html()}
							<div class="bt-biz-dict" data-type="select" data-group="Finacial.DataSource"
								 data-name="dataSource" data-biz-name="dataSource" data-defaultvalue="$!{fcCompareAccPage.dataSource}"></div>
						</div>
		    		</td>
		    	</tr>
	    	</tbody>
	    </table>
		<div class="layui-form-item layui-form-submit ">
		    <div class="layui-input-block">
		        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
		        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		    </div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script type="text/javascript">
	bt.use(['jquery','form','selectTable','btdate','moneyType','dicts'],function(){
		$ = bt.jquery;
		form = bt.form();

		//银行账号下拉表格初始化
		bt.selectTable.init({
			elem: "#compAccTable",
			searchInput: '#compAcc',
	        scrollX:true,
	        scrollY:true,
	        url: basePath+"/finacial/check/erpDataManager/jsonBankAcc",
			columns: [
				{data:"bankAcc"},
				{data:"bankName"},
				{data:"counterAccId"},
			],
			clickCallback:function(severData,data){
				 $("#compAcc").val(severData.bankAcc);
				 $("#curId" + index).val(severData.curId);
	        }
		});

		//日期控件初始化
		$.each($("div[type='date']"),function(i,item){
			bt.btdate.init({
				elem: "[field='"+$(item).attr("field")+"']",
				name: $(item).attr("field"),
				format: "YYYY-MM-DD",
				istime: true,
				placeholder: $(item).attr("defaultVal"),
				choose : function(datas){
				}
			});
		});

		//金额控件
		bt.moneyType.init();
		bt.dicts.init();

		//监听提交
        form.on('submit(submit)', function(data){
            var action = "/finacial/check/erpDataManager/modify";
            $.post(basePath + action,data.field,function(result){
                if(result.success){
					window.top.refreshParentFlag = true;
                    parent.layer?parent.layer.closeAll():layer.closeAll();

                }
                parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
            },'JSON');
            return false;
        });
	});
</script>

<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
    <style>
        .required{
            color: red;
        }
    </style>
</head>
<body>
<div class="layui-field-box">
    <table id="editTable" class="layui-table layui-form dark-layui-table" style="width: 100%">
        <thead>
        <tr>
            <th><span class="required">*</span>#springMessage('finacial.check.erpDataManager.bankAcc')</th><!-- 银行帐号 -->
            <th><span class="required">*</span>#springMessage('finacial.check.erpDataManager.occurDate')</th><!-- 发生日期 -->
            <th><span class="required">*</span>#springMessage('finacial.check.erpDataManager.debitMoney')</th><!-- 借方金额 -->
            <th><span class="required">*</span>#springMessage('finacial.check.erpDataManager.creditMoney')</th><!-- 贷方金额 -->
            <th><span class="required">*</span>#springMessage('finacial.check.erpDataManager.voucherNo')</th><!-- 凭证号 -->
            <th>#springMessage('finacial.check.erpDataManager.redblueSign')</th><!-- 红蓝标识 -->
            <th>#springMessage('finacial.check.erpDataManager.compareSign')</th><!-- 对账标识 -->
            <th>#springMessage('finacial.check.erpDataManager.summaryContent')</th><!-- 摘要 -->
            <th>#springMessage('finacial.check.erpDataManager.dataSource')</th><!-- 企业账来源  -->
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
        <tbody>
        <!-- 模板 -->
        <tr style="display: none;">
            <td><!-- 银行帐号 -->
                <div class="layui-input-inline">
                    <input name="compAcc_index" id="compAcc_index" class="layui-input" type="text" autocomplete="off" placeholder="#springMessage('finacial.check.erpDataManager.bankAcc')">
                    <input type="hidden" name="curId_index" id="curId_index"/>
                    <table id="compAccTable_index" class="hide">
                        <thead>
                        <tr>
                            <th>#springMessage('table.nisBillhead.bankAcc')</th>
                            <th>#springMessage('table.accountDTO.bankName')</th>
                            <th>#springMessage('table.accountDTO.curName')</th>
                        </tr>
                        </thead>
                    </table>
                </div>
            </td>
            <td><!-- 发生日期 -->
                <div class="layui-input-inline">
                    ##<div class="date-single_index" data-name="tallyDate_index"></div>
                    <input type="text" name="tallyDate_index" class="layui-input bt-biz-dateType" autocomplete="off">
                </div>
            </td>
            <td><!-- 借方金额 -->
                <div class="layui-input-inline">
                    <input class="layui-input bt-biz-moneyType" data-decimal="2" data-type="moneynum_index" data-name="debitMoney_index" placeholder="#springMessage('finacial.check.erpDataManager.debitMoney')" />
                </div>
            </td>
            <td><!-- 贷方金额 -->
                <div class="layui-input-inline">
                    <input class="layui-input bt-biz-moneyType" data-decimal="2" data-type="moneynum_index" data-name="creditMoney_index" placeholder="#springMessage('finacial.check.erpDataManager.creditMoney')" />
                </div>
            </td>
            <td><!-- 凭证号 -->
                <div class="layui-input-inline">
                    <input type="text" autocomplete="off" class="layui-input" id="voucherNo_index" name="voucherNo_index" placeholder="#springMessage('finacial.check.erpDataManager.voucherNo')" />
                </div>
            </td>
            <td><!-- 红蓝标识 -->
                <div class="layui-input-inline">
##					#set ($redblueSignMap = {"field":"redblueSign_index","type":"radio","typeGroupCode":"Finacial.RedBlueSign","defaultVal":"$!{redblueSign}"})
##		            #set ($formRedblueSign = $dictSelect.instance($redblueSignMap))
##		         	${formRedblueSign.html()}
                    <div class="bt-biz-dict" data-group="Finacial.RedBlueSign" data-name="redblueSign_index" data-biz-name="redblueSign_index" data-type="radio" data-defaultvalue="$!{redblueSign}"></div>
                </div>
            </td>
            <td><!-- 对账标识 -->
                <div class="layui-input-inline">
##					#set ($compareSignMap = {"field":"compareSign_index","type":"select","typeGroupCode":"finacial.CompareSign","defaultVal":"$!{compareSign}"})
##		            #set ($formCompareSign = $dictSelect.instance($compareSignMap))
##		         	${formCompareSign.html()}
                    <div class="bt-biz-dict" data-type="select" data-group="finacial.CompareSign"
                         data-name="compareSign_index" data-biz-name="compareSign_index" data-defaultvalue="$!{compareSign}"></div>
                </div>
            </td>
            <td><!-- 摘要 -->
                <div class="layui-input-inline">
                    <input class="layui-input" id="summaryContent_index" name="summaryContent_index"  placeholder="#springMessage('finacial.check.erpDataManager.summaryContent')"  />
                </div>
            </td>
            <td><!-- 企业账来源 -->
                <div class="layui-input-inline">
##					#set ($dataSourceMap = {"field":"dataSource_index","type":"select","typeGroupCode":"Finacial.DataSource","defaultVal":"$!{dataSource}"})
##		            #set ($formDataSource = $dictSelect.instance($dataSourceMap))
##		         	${formDataSource.html()}
                    <div class="bt-biz-dict" data-type="select" data-group="Finacial.DataSource"
                         data-name="dataSource_index" data-biz-name="dataSource_index" data-defaultvalue="$!{dataSource}"></div>
                </div>
            </td>
            <td>
                <button data-type="del" class="layui-btn layui-btn-mini">#springMessage("common.button.delete")</button>
            </td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit ">
        <div class="layui-input-block">
            <button class="layui-btn" id="submitBut">#springMessage('common.button.submit')</button>
        </div>
    </div>
</div>
	#parse("views/common/footer.vm")
</body>
<!-- <script src="${basePath}/static/modules/finacial/check/centralityDataManager.add.js?_btv=${resourceVersion}"></script> -->
<script type="text/javascript">
    var dicts;
    bt.use(['jquery','form','selectTable','btdate','moneyType','bttable','dateType','dicts'],function(){
        $ = bt.jquery;
        var form = bt.form();
        bt.bttable.init({
            elem: "#editTable",
            url: null,
            buttons: [
                {
                    text: '<i class="layui-icon">&#xe642;</i>'+bt.lang('common.addTr'),
                    action: function(e, dt, node, config){
                        addTr();
                    }
                }
            ],
            columns:[
                {
                    data:"compAcc",
                    render:function(data, row){

                    }
                },
                {
                    data:"tallyDate",
                    render:function(data, row){

                    }
                },
                {
                    data:"debitMoney",
                    render:function(data, row){

                    }
                },
                {
                    data:"creditMoney",
                    render:function(data, row){

                    }
                },
                {
                    data:"voucherNo",
                    render:function(data, row){

                    }
                },
                {
                    data:"redblueSign",
                    render:function(data, row){

                    }
                },
                {
                    data:"compareSign",
                    render:function(data, row){

                    }
                },
                {
                    data:"summaryContent",
                    render:function(data, row){

                    }
                },
                {
                    data:"dataSource",
                    render:function(data, row){

                    }
                },
                {
                    data:null,
                    render:function(data, row){
                        var reInfo='<button data-type="del" class="layui-btn layui-btn-mini">'+bt.lang("common.button.delete")+'</button>';
                        return reInfo;
                    }
                }
            ],
            delRowCallback:function(data,$tr){
					$tr.remove();
            },
            tableInitCallback:function(){
                bt.dateType.init();
                bt.dicts.init();
            }
        });


        var html = $("#editTable tbody tr:eq(0)").html();
        //添加控件
        var i = 0;
        var addTr = function(){
            i++;
            var index = "_" + i;
            var reg = new RegExp("_index","g");
            var tds = html.replace(reg,index);
            var $tr = $('<tr data-id="' + i + '">'+ tds +'</tr>');
            $('#editTable > tbody > tr:last').after($tr);

            //银行账号下拉表格初始化
            bt.selectTable.init({
                elem: "#compAccTable" + index,
                searchInput: '#compAcc' + index,
                scrollX:true,
                paging:true,
                scrollY:"200px",
                url: basePath+"/finacial/check/fcbankbill/queryBank",
                columns: [
                    {data:"bankAcc"},
                    {data:"bankName"},
                    {data:"curName"}
                ],
                clickCallback:function(severData,data){
                    $("#compAcc" + index).val(severData.bankAcc);
                    $("#curId" + index).val(severData.curId);//TODO
                }
            });

            //日期控件初始化
            bt.dateType.init();
           /* bt.dateType.init({
                elem:".date-single"+ index,
                name:"tallyDate" + index,
                event: 'focus',
                choose:function(data){
                }
            });*/
            //金额控件
            bt.moneyType.init();
            bt.dicts.init();
            form.render();
        }


        //进入页面默认添加一行
        addTr();

        //提交
        $("#submitBut").on("click",function(){
            $('button.addBtn').addClass('layui-btn-disabled')
            var trs = $("#editTable > tbody").children('tr:visible');
            if(trs.length > 0){
                var data = new Object();
                trs.each(function(i,tr){
                    var fieldElem = $(tr).find('input,select,textarea');
                    bt.each(fieldElem, function(_, item){
                        if(!item.name) return;
                        if(/^checkbox|radio$/.test(item.type)){
                            if("radio"===item.type && !item.checked){
                                return;
                            }
                        }
                        var name = item.name;
                        name = name.substring(0,name.indexOf("_"));
                        data["accList["+ i +"]."+ name ] = $.trim( item.value );
                    });
                });

                var action = "/finacial/check/erpDataManager/save";
                $.post(basePath + action,data,function(result){
                    if(result.success){
                        window.top.refreshParentFlag = true;
                        parent.layer?parent.layer.closeAll():layer.closeAll();
                    }else{
                        $('button.addBtn').addClass('layui-btn')
                    }
                    parent.layer?parent.layer.alert(result.msg, {icon: result.success?1:2}):layer.alert(result.msg, {icon: result.success?1:2});
                },'JSON');
            }else{
                layer.alert("#springMessage('finacial.check.manager.msg.nulldata')");
            }
        });
    });
</script>
</html>

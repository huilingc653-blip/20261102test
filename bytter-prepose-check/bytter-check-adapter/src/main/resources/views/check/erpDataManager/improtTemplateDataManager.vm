</html>

<script>
#if(${result})
	var result = $!{result};
	if(result){
		//layer.msg(msg);
		if(result.success){
			
		}else{
			layer.alert(result.msg, {icon: result.success?1:2});
		}
		
	}
#end
bt.use(['form','datatable','upload','dicts','date','btImport','moneyType','selectTable'], function(){
    $ = bt.jquery,form = bt.form();
    var upload = layui.upload;
    bt.dicts.init();
    var moneyFun = bt.moneyType.getFun();
    
    var datatable = bt.datatable.init({
        elem: "#appTable",
        dom: 'Brtlip',
        searchForm:{
            formElem:"#importsForm",
            formFilter:"search"
        },
        ajax: {
            'url': basePath+"/finacial/check/erpDataManager/erpImpDatatable"
        }
        ,columns: [
            {data:"compAcc",bSortable:true,className:"center"},
            {data:"curName",bSortable:false,className:"center"},
            {data:"tallyDate",bSortable:false,className:"center",
//                render: function( data, type, full, meta ){
//                    return bt.date.format(full.tallyDate,'yyyy-mm-dd');
//            }
			},
            {data:"voucherNo",bSortable:false,className:"center"},
            {data:"debitMoney",bSortable:false,className:"textRight",
                render: function( data, type, full, meta ){
                    return moneyFun.format(full.debitMoney, {decimal:2});
            }},
            {data:"creditMoney",bSortable:false,className:"textRight",
                render: function( data, type, full, meta ){
                    return moneyFun.format(full.creditMoney, {decimal:2});
                }},
            {data:"balance",bSortable:false,className:"textRight",
                render: function( data, type, full, meta ){
                    return moneyFun.format(full.balance, {decimal:2});
                }},
            {data:"redblueSign",bSortable:false,className:"center",
                render: function( data, type, full, meta ){
                    return bt.dict("Finacial.RedBlueSign",full.redblueSign);
             }},
            {data:"summaryContent",bSortable:false,className:"center"},
            {data:"dataSource",bSortable:false,className:"center"}
        ]

    });
    
  //银行账号下拉表格初始化
	bt.selectTable.init({
		elem: "#compAccTable",
		searchInput: '#compAcc',
		scrollX:"500px",
        paging:true,
	   	scrollY:"200px",
		url: basePath+"/finacial/check/erpDataManager/jsonBankAccErpData",
		columns: [
		    {data:"bankAcc"},
		    {data:"bankName"},
		    {data:"curName"}
		],
		clickCallback:function(severData,data){
			 $("#compAcc").val(severData.bankAcc);
			 $("#curId").val(severData.curId);
        }
	});
    
    $("#search").on('click',function(){
        var bankAcc = $("#bankAcc").val();
    	var url = basePath + "/finacial/check/erpDataManager/impDataSave?bankAcc="+bankAcc;
    	$("#importsForm").attr("action",url);
    	$("#importsForm").submit();
    });

    /**
     * 导入Excel
     */
    
    importExcel = function () {
        var bankAcc = $("#compAcc").val();
        var curId = $("#curId").val();
        up = bt.btImport.init({
            code: "30000003",
            titleRows: 0,
            width: "100%",
            height: "100%",
            headRows: 1,
            success: function (head, data, select) { //点击确认后回调方法，这里导入组件写了success方法这里可以不用此方法
                $.ajax({
                    type: "POST",	
                    url: basePath + "/finacial/check/erpDataManager/impDataSave?bankAcc="+bankAcc+"&curId="+curId,
                    dataType: "json",
                    contentType: "application/json",
                    data: JSON.stringify(up.getSelectData()),
                    success: function (result) {
                        bt.datatable.refreshCurrentPage();
                        parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                    }
                });
            }
        });
    }
    
    
}); 
</script>

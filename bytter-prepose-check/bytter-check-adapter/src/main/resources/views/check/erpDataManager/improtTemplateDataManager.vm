	        <th>#springMessage('finacial.check.erpDataManager.bankAcc')</th><!-- 银行帐号 -->
	        <th>#springMessage('table.accountDTO.curName')</th><!-- 币别 -->
	        <th>#springMessage('finacial.check.erpDataManager.occurDate')</th><!-- 发生日期 -->
	        <th>#springMessage('finacial.check.erpDataManager.voucherNo')</th><!-- 发生日期 -->
	        <th>#springMessage('finacial.check.erpDataManager.debitMoney')</th><!-- 借方金额 -->
	        <th>#springMessage('finacial.check.erpDataManager.creditMoney')</th><!-- 贷方金额 -->
	        <th>#springMessage('finacial.check.erpDataManager.balance')</th><!-- 余额 -->
	        <th>#springMessage('finacial.check.erpDataManager.redblueSign')</th><!-- 红蓝标识 -->
	        <th>#springMessage('finacial.check.erpDataManager.summaryContent')</th><!-- 摘要 -->

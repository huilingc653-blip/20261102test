<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <input type="hidden" name="eqs_checkType" value="$!{checkType}"/>
    <table class="layui-table">
        <tbody>
        <tr>
            <!-- 单位网点 -->
            <td class="textRight">#springMessage("table.btBankAcc.corpId")</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-biz-name="corpId"
                         data-callback="corpCallBack"
                         data-scope="all"
                         data-resource="finacial:check:erp:data:query"></div>
                </div>
            </td>

            <!-- 中心账号-->
            <td class="textRight">#springMessage('finacial.check.erpDataManager.bankAcc')</td>
            <td>
                <!-- <input type="text" name="likes_compAcc" class="layui-input" placeholder="#springMessage(
                    'finacial.check.erpDataManager.bankAcc')"> -->
                <div class="layui-input-inline">
                ##<input name="eqs_compAcc" id="compAcc" class="layui-input" type="text" placeholder="#springMessage('finacial.check.erpDataManager.bankAcc')">
                    <input name="eqs_compAcc" id="compAcc" class="layui-input" type="text" data-biz-name="compAcc"
                           placeholder="#springMessage('finacial.check.erpDataManager.bankAcc')">
                    <input type="hidden" name="eqs_curId" id="curId"/>
                #*<table id="compAccTable" style="display: none;">
                    <thead>
                        <tr>
                            <th>#springMessage('table.nisBillhead.bankAcc')</th>
                            <th>#springMessage('table.accountDTO.bankName')</th>
                            <th>#springMessage('table.accountDTO.curName')</th>
                        </tr>
                    </thead>
                </table>*#
                </div>
            </td>
        </tr>
        <tr>
            <!-- 发生日期 -->
            <td class="textRight">#springMessage('finacial.check.erpDataManager.occurDate')</td>
            <td width="30%">
                <div class="date-interval"></div>
            </td>
            <!-- 对账标识-->
            <td class="textRight">#springMessage('finacial.check.erpDataManager.compareSign')</td>
        ##	    		<td width="25%">
        ##	    			<div class="layui-input-inline">
        ##		    			#set ($compareSignMap = {"field":"eqs_compareSign","type":"select","typeGroupCode":"finacial.CompareSign"})
        ##			            #set ($formCompareSign = $dictSelect.instance($compareSignMap))
        ##			         	${formCompareSign.html()}
        ##		         	</div>
        ##	    		</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="finacial.CompareSign"
                     data-name="eqs_compareSign" data-biz-name="compareSign"></div>
            </td>
        </tr>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage(
                    'common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.btBankAcc.corpId')</th><!-- 单位名称-->
        <th>#springMessage('finacial.check.erpDataManager.bankAcc')</th><!-- 银行帐号 -->
        <th>#springMessage('table.accountDTO.curName')</th><!-- 币别 -->
        <th>#springMessage('finacial.check.erpDataManager.occurDate')</th><!-- 发生日期 -->
        <th>#springMessage('finacial.check.erpDataManager.debitMoney')</th><!-- 借方金额 -->
        <th>#springMessage('finacial.check.erpDataManager.creditMoney')</th><!-- 贷方金额 -->
        <th>#springMessage('finacial.check.erpDataManager.voucherNo')</th><!-- 凭证号 -->
        <th>#springMessage('finacial.check.erpDataManager.redblueSign')</th><!-- 红蓝标识 -->
        <th>#springMessage('finacial.check.erpDataManager.compareSign')</th><!-- 对账标识 -->
        <th>#springMessage('finacial.check.erpDataManager.summaryContent')</th><!-- 摘要 -->
        <th>#springMessage('finacial.check.erpDataManager.dataSource')</th><!-- 企业账来源  -->
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
<!-- <script src="${basePath}/static/modules/finacial/check/centralityDataManager.list.js?_btv=${resourceVersion}"></script> -->
<script type="text/javascript">
    var table;
    bt.use(['jquery', 'datatable', 'btdate', 'date', 'moneyType', 'selectTableType', "corp", "dicts"], function () {
        corp = bt.corp.init();
        bt.dicts.init();
        $ = bt.jquery;
        var moneyFun = bt.moneyType.getFun();
		//初始化日期控件
	    bt.btdate.init({
	        elem: ".date-interval",
	        startname: "ged_tallyDate",
	        endname: "led_tallyDate"
	    });
		//
	  	// //银行账号下拉表格初始化
		// bt.selectTable.init({
		// 	elem: "#compAccTable",
		// 	searchInput: '#compAcc',
	    //     scrollX:"500px",
	    //     paging:true,
   	 //   	 	scrollY:"200px",
		// 	url: basePath+"/finacial/check/erpDataManager/jsonBankAccErpData",
		// 	columns: [
		// 	    {data:"bankAcc"},
		// 	    {data:"bankName"},
		// 	    {data:"curName"}
		// 	],
		// 	clickCallback:function(severData,data){
		// 		 $("#compAcc").val(severData.bankAcc);
		// 		 $("#curId").val(severData.curId);
	    //     }
		// });

		selectTable = bt.selectTableType.init({
			elem: "#compAcc",
			type: 'POST',
			paging: true,
            // scrollX:"500px",scrollY:"200px",
			url: basePath + "/finacial/check/erpDataManager/jsonBankAccErpData",
			columns: [
				{"data": "bankAcc", title: bt.lang("table.btBankAcc.bankAcc")},
				{"data": "curName", title: bt.lang("international.payment.curName")},
				{"data": "accName", title: bt.lang("table.btBankAcc.accName")},
				{"data": "bankName", title: bt.lang("table.btBankAcc.bankName")}
			],
			clickCallback: function (data, tr, elem, full) {
				if (data&&data.bankAcc) {
					 $("#compAcc").val(data.bankAcc);
					 $("#curId").val(data.curId);
				}
			}
		});

		//表格控件初始化设置
		table = bt.datatable.init({
			elem: "#appTable",
			dom: 'Brtlip',
	        colReorder: true,
			checkbox: true ,
			searchForm:{
                formElem:"#searchForm",
                formFilter:"search"
            },
            ajax: {
                url: basePath + "/finacial/check/erpDataManager/datatable"
            },
            buttons: [
                {
                    hide: bt.isnotResource('finacial:check:erp:data:edit'),
                    text: '#springMessage("common.button.add")',
                    action:

                            function (e, dt, node, config) {
                                add();
                            }
                },
                {
                    hide: bt.isnotResource('finacial:check:erp:data:delete'),
                    text: '#springMessage("common.button.batchDelete")',
                    action:

                            function (e, dt, node, config) {
                                var data = dt.rows('.selected').data();
                                var len = data.length;
                                var rowData = data.splice(0, len);
                                var ids = [];
                                for (var i = 0; i < rowData.length; i++) {
                                    ids.push(rowData[i].id);
                                }
                                if (ids.length > 0) {
                                    parent.layer.confirm("#springMessage(
                                        'common.message.confirm.batchDelete')", function () {
                                        $.post(basePath + "/finacial/check/erpDataManager/batchDelete", {ids: ids}, function (result) {
                                            if (result.success) {
                                                table.draw();
                                            }
                                            parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
                                        }, 'JSON');
                                    });
                                } else {
                                    parent.layer.alert("#springMessage('common.message.confirm.selectData')");
                                }

                            }
                }
            ],
            columns: [
                {data: "corpId", className: 'center', bSortable: false,
                    render: function (data, type, full, meta) {
                        return full.corpName;
                    }
                },
                {
                    data: "compAcc",
                    className: 'center',
                    bSortable: false
                },
			    {
			    	data: "curName",
			    	className:'center',
			    	bSortable:false
			    },
                {
                    data: "tallyDate",
                    className: 'center',
                    bSortable: false,
                    render: function (data, type, full, meta) {
                        return bt.date.format(full.tallyDate, 'yyyy-mm-dd');
                    }
                },
                {
                    data: "debitMoney",
                    className: 'textRight',
                    bSortable: false,
                    render: function (data, type, full, meta) {
                        return moneyFun.format(full.debitMoney, {decimal: 2});
                    }
			    },
			    {
			    	data: "creditMoney",
			    	className:'textRight',
			    	bSortable:false,
                    render: function( data, type, full, meta ){
                        return moneyFun.format(full.creditMoney, {decimal:2});
                    }
			    },
			    {
			    	data: "voucherNo",
			    	className:'center',
			    	bSortable:false
			    },
			    {
			    	data: "redblueSign",
			    	className:'center',
			    	bSortable:false,
			    	render: function( data, type, full, meta ){
			    		return bt.dict("Finacial.RedBlueSign",full.redblueSign);
			    	}
			    },
			    {
			    	data: "compareSign",
			    	className:'center',
			    	bSortable:false,
			    	render: function( data, type, full, meta ){
			    		return bt.dict("finacial.CompareSign",full.compareSign);
			    	}
			    },
			    {
			    	data: "summaryContent",
			    	className:'center',
			    	bSortable:false
			    },
			    {
			    	data: "dataSource",
			    	className:'center',
			    	bSortable:false
			    },
			    {
			    	data: null,
			    	bSortable:false,
			    	className:'center',
			    	render: function( data, type, full, meta ){
			    		var buts = "";
                        if(full.compareSign == '0'){
			    			buts = "<a name='edit' data-row='"+meta.row+"' onclick='edit(this)' >"+bt.lang("common.button.edit")+"</a>";
				    		buts += "<span class=\"text-explode\">|</span>\<a name='del' data-row='"+meta.row+"' onclick='del(this)' >"+bt.lang("common.button.delete")+"</a>";
			    		}
			    		return buts;
			    	}
			    }
			], summary: {
				pageSum: false,//小计功能关闭
				allSum: true,//汇总功能开启
				selectSum: true,//已选汇总功能开启
				// groupColumn: 'curName',//分类汇总列参数
				format: {
					decimal: 2
				},
				sumList: [
					{
						colNum: '3',//汇总列序号
						dataName: 'debitMoney',//汇总列数据
					},
					{
						colNum: '4',//汇总列序号
						dataName: 'creditMoney',//汇总列数据
					}
				]
			}
		});
	});

	//新增
	function add(){
		parent.layer.open({
	    	title: "#springMessage('finacial.check.erpDataManager.title.add')",
	        type: 2,
	        area: ['1000px', '600px'],
	        maxmin: true,
	        content: basePath + "/finacial/check/erpDataManager/add",
	        end:function(){
	        	table.draw();
            }
	    });
	}

	//修改
	function edit(el){
		var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
	    parent.layer.open({
	    	title: "#springMessage('finacial.check.erpDataManager.title.edit')",
	        type: 2,
	        area: ['750px', '530px'],
	        maxmin: true,
	        content: basePath + "/finacial/check/erpDataManager/update/" + data.id,
	        end:function(){
                if(window.top.refreshParentFlag){
                    table.draw();
                }
                window.top.refreshParentFlag = false
            }
        });
    }

    //删除
    function del(el) {
        var data = layui.jquery("#appTable").DataTable().row(layui.jquery(el).data("row")).data();
        parent.layer.confirm("#springMessage('common.message.confirm.delete')", function () {
            var url = basePath + "/finacial/check/erpDataManager/delete/" + data.id;
            $.post(url, function (result) {
                if (result.success) {
                    table.draw();
                }
                parent.layer.alert(result.msg, {icon: result.success ? 1 : 2});
            }, 'JSON');
        });
    }

    /**
     * 单位回调
     */
    function corpCallBack() {
        var corpId = corp.get("corpId").val();
        selectTable.get("compAcc").setUrl({corpId: corpId});
    }

</script>
</html>

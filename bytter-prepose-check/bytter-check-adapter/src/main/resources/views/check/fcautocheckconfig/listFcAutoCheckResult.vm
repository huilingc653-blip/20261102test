<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位
            <td class="textRight">#springMessage('table.nisBillhead.corpId')</td>
            <td>
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="likes_corpId"
                         data-resource="finacial:check:aotoResult:query"
                         data-scope="all"
                    ></div>
                </div>
            </td>
            ##对账类型
            <td class="textRight">#springMessage('finacial.autoCheck.checkType')</td>
            <td>
                <div class="bt-biz-dict" data-group="fcAutoCheckConfig.checkType" data-name="eqs_checkType" data-type="select" ></div>
            </td>
            ##对账周期
            <td class="textRight">#springMessage('finacial.autoCheck.checkCycle')</td>
            <td>
                <div class="bt-biz-dict" data-group="fcAutoCheckConfig.checkCycle" data-name="eqs_checkCycle" data-type="select" ></div>
            </td>

        </tr>
        <tr>
            ##自动对账策略代码
            <td class="textRight">#springMessage('finacial.autoCheck.autoCheckCode')</td>
            <td>
                <input type="text"  name="likes_autoCheckCode" autocomplete="off"
                       class="layui-input"/>
            </td>
            ##自动对账策略代码名称
            <td class="textRight">#springMessage('finacial.autoCheck.autoCheckName')</td>
            <td>
                <input type="text"  name="likes_autoCheckName" autocomplete="off"
                       class="layui-input"/>
            </td>
            ##生效时间
            <td class="textRight" >#springMessage('finacial.autoCheck.launchTime')</td>
            <td>
                <input type="text" name="ged_beginDate" data-biz-name="ged_launchTime" data-type="datetime"
                       class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_launchTime" >
                <span class="date-mid">~</span>
                <input type="text" name="led_beginDate" data-biz-name="led_launchTime" data-type="datetime"
                       class="layui-input bt-input-inline bt-biz-dateType" id="led_launchTime" >
            </td>
        </tr>
        <tr>
             ##执行情况
         <td class="textRight">#springMessage('finacial.autoCheck.isSuccess')</td>
            <td>
                <div class="bt-biz-dict" data-group="fcAutoCheckConfig.result" data-name="eqs_isSuccess" data-type="select" ></div>
         </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.bisAccDtlBudgetRule.processTime')</th>##执行时间
        <th>#springMessage('finacial.autoCheck.launchTime')</th>##策略生效时间
        <th>#springMessage('finacial.autoCheck.corpName')</th>##单位名称
        <th>#springMessage('table.btBankAccApp.bankAcc')</th>##银行账号
        <th>#springMessage('table.fcCheckInit.bankAccName')</th>##银行账户名称
        <th>#springMessage('finacial.autoCheck.checkType')</th>##对账类型
        <th>#springMessage('finacial.autoCheck.checkCycle')</th>##对账周期
        <th>#springMessage('finacial.autoCheck.autoCheckCode')</th>##自动对账策略代码
        <th>#springMessage('finacial.autoCheck.autoCheckName')</th>##自动对账策略名称
        <th>#springMessage('finacial.autoCheck.isSuccess')</th>##执行情况
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
    #workFlowScript()
<script src="${basePath}/static/modules/check/fcAutoCheckResult.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

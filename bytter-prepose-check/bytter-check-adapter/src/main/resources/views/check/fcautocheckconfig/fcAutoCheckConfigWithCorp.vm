<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form ignore-required-icon" method="post">
    <table id="appTable" class="layui-table layui-form">
        <input type="hidden" id="autoCheckCode" name="autoCheckCode" value="$!{autoCheckCode}">
        <input type="hidden" id="checkType" name="checkType" value="$!{checkType}">
        <input type="hidden" id="validSign" value="$!{validSign}">
<tr>
    <td colspan="4" style="height: 300px">
        <div class="layui-tab-item  layui-show ">
            <table id="nextTable" class="layui-table  treeTable">
                <thead>
                <tr>
                    <th width="25%">#springMessage('finacial.autoCheck.corpName')</th>
                    <th width="25%">#springMessage('finacial.autoCheck.autoCheckCode')</th>
                    <th width="15%">#springMessage('common.button.select')</th>
                    <th width="25%">#springMessage('table.fcCompare.Check_the_standard')</th>

                </tr>
                </thead>
                <tbody>
                    #foreach($date in $checkCorpVOS)
                    <tr data-tt-id="$!{date.corpId}" data-tt-parent-id="$!{date.parentId}"
                        data-tt-subject-sort="$!{date.id}">
                        <td>$!{date.corpName}</td>
                        <td style="text-align:center">$!{date.autoCheckCode}</td>
                        <td style="text-align:center">
                            <input type="checkbox" class="check" lay-skin="primary" value="$!{date.corpId}" vcount="$velocityCount"
                                   lay-filter="checkCorp"
                                #if("$!{date.autoCheckCode}"!="")
                                   checked="checked"
                                   #if($!{date.autoCheckCode}!=$!{autoCheckCode})
                                   disabled
                                   #end
                                #end/>
                        </td>
                        <td style="text-align:center">
                            #if($!{checkType}=="0")
                                <div class="bt-biz-selectType" data-url="${basePath}/finacial/paramconfig/fccomparechecktype/json" data-defaultvalue="$!{date.checkTheStandard}"
                                     data-valuefield="id" data-textfield="checkTypeName" wcorp="$!{date.corpId}" data-biz-name="checkTheStandard_$velocityCount"
                                     data-name="checkTheStandard_$velocityCount"
                                    #if($!{date.autoCheckCode}!=$!{autoCheckCode})
                                     data-disabled="true"
                                    #end
                                     data-callback="theChange1"
                                ></div>

                            #else
                                <div class=bt-biz-dict data-type="select" data-width="150px" data-biz-name="checkTheStandard_$velocityCount" data-name="checkTheStandard_$velocityCount"
                                     data-group="fcCompare.checkType" data-defaultvalue="1" data-filterData="2,4" data-value="$!{date.checkTheStandard}"
                                     wcorp="$!{date.corpId}" data-required="true"
                                    #if($!{date.autoCheckCode}!=$!{autoCheckCode})
                                     data-disabled="true"
                                    #end
                                     data-callback="theChange"
                                ></div>
                            #end


                        </td>
                    </tr>
                    #end
                </tbody>
            </table>
        </div>
    </td>
</tr>
        <tr>
            <td colspan="4" style="text-align: center">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                        'common.button.submit')</button>
                <button class="layui-btn" onClick="doClose()">#springMessage(
                        'common.button.close')</button>
            </td>
        </tr>
    </table>
</form>
    #parse("views/common/footer.vm")
<script >
    var parm={};
    bt.use(['form','jquery','dateType','treeTable','selectType','dicts'], function() {
        $ = bt.jquery;
        form = bt.form();

        selectTypes = bt.selectType.init();//下拉框
        dicts = bt.dicts.init();//字典
        bt.treeTable.init({elem: ".treeTable", column: 0});
        //关闭窗口
        doClose=function () {
            if (bt.navtab) {
                bt.navtab.closeCurrent();
            }
        }

        form.on('checkbox(checkCorp)', function(obj) {
            var checkType=$("#checkType").val();
            var num=$(obj.elem).attr("vcount")
            if (obj.elem.checked == true) {
                //选中事件
                if(checkType=="0"){//中心
                    parm[obj.value]='';
                    selectTypes.get("checkTheStandard_"+num).attr({"data-required":true,"data-disabled":false})
                }else {//erp
                    dicts.get("checkTheStandard_"+num).attr({"data-disabled":false})
                    parm[obj.value]='1';
                }

            }else {
                if(checkType=="0") {//中心
                    selectTypes.get("checkTheStandard_"+num).attr({"data-required":false,"data-disabled": true})
                }else {//erp
                    dicts.get("checkTheStandard_" + num).attr({"data-disabled": true})
                }
                if( !parm.hasOwnProperty(obj.value)){//不含这个key，说明是之前关联的
                    parm[obj.value]="";
                    if(checkType=="0") {//中心
                        selectTypes.get("checkTheStandard_"+num).val("");
                    }else {
                        dicts.get("checkTheStandard_"+num).val("1");
                    }
                }else {
                    delete parm[obj.value];
                }

            }
            form.render();
            // dicts.render();
            // selectTypes.render();
        })

        //监听提交
        form.on('submit(submit)', function(data){
            var autoCheckCode=$("#autoCheckCode").val();
            var checkType=$("#checkType").val();
            var validSign=$("#validSign").val();
            if(validSign=="0"){
                layer.msg(bt.lang('该配置为无效配置，无法进行单位的关联！'),{icon: 7});
                return false;
            }
            parm['autoCheckCode']=autoCheckCode;
            parm['checkType']=checkType;
            var action = "/finacial/check/fcautocheckconfig/saveWithCorp"
            bt.jquery.ajax({
                type: "POST",
                url: basePath + action,
                data: JSON.stringify(parm),
                dataType:"json",
                async: false,
                contentType : 'application/json;charset=utf-8', //设置请求头信息
                success: function(result){
                    parent.layer.msg(result.msg, {icon: result.success?1:2});
                    if(result.success){
                        if(!bt.navtab){
                            location.reload();
                            parent.layer?parent.layer.closeAll():layer.closeAll();
                        } else {
                            if(data.field.id == ""){
                                bt.navtab.refreshCurrent();
                            }else{
                                bt.navtab.closeCurrent();
                                bt.navtab.refreshCurrent();
                            }

                        }
                    }else{
                        bt.loading.hide();
                    }
                }
            });
        });


        /**判断字符串是否为空*/
        bt.empty = function (ms) {
            if (typeof (ms) == "undefined" || ms == null || ms == "" || ms == "null") {
                return true;
            }
            return false;
        }


    })
    function theChange(data){
        var $ = bt.jquery, form = bt.form();
        var wcorp = $(data.elem).parent().attr('wcorp');
        parm[wcorp]=data.value

    }

    function theChange1(data,el) {
        var $ = bt.jquery, form = bt.form();
        var wcorp = $(el.elem).parent().attr('wcorp');
        parm[wcorp]=el.value;
    }
</script>
</body>
</html>

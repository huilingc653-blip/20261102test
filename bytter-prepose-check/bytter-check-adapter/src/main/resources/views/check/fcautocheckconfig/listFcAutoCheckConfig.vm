<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	#parse("views/flow/flow.vm")
</head>
<body>
<form id="searchForm" class="layui-form" method="post">
    <table class="layui-table">
        <tbody>
        <tr>
            ##自动对账策略代码
            <td class="textRight" >#springMessage('finacial.autoCheck.autoCheckCode')</td>
            <td width="25%">
                <input type="text"  name="likes_autoCheckCode" autocomplete="off"
                       class="layui-input"/>
            </td>
            ##自动对账策略代码名称
            <td class="textRight" >#springMessage('finacial.autoCheck.autoCheckName')</td>
            <td width="25%">
                <input type="text"  name="likes_autoCheckName" autocomplete="off"
                       class="layui-input"/>
            </td>
        </tr>
        <tr>
            ##对账类型
            <td width="8%" class="textRight">#springMessage('finacial.autoCheck.checkType')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-group="fcAutoCheckConfig.checkType" data-name="eqs_checkType" data-type="select" ></div>
            </td>
            ##对账周期
            <td width="8%" class="textRight">#springMessage('finacial.autoCheck.checkCycle')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-group="fcAutoCheckConfig.checkCycle" data-name="eqs_checkCycle" data-type="select" ></div>
            </td>
        </tr>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('finacial.autoCheck.autoCheckCode')</th>
        <th>#springMessage('finacial.autoCheck.autoCheckName')</th>
        <th>#springMessage('finacial.autoCheck.checkType')</th>
        <th>#springMessage('finacial.autoCheck.launchTime')</th>
        <th>#springMessage('finacial.autoCheck.checkCycle')</th>
        <th>#springMessage('finacial.paramConfig.fcSubject.valid')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
    #workFlowScript()
<script src="${basePath}/static/modules/check/fcAutoCheckConfig.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

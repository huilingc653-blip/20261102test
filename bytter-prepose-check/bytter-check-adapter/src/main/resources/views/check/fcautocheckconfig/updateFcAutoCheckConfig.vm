<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" method="post">
    <input type="hidden" id="id" name="id" value="$!{fcAutoCheckConfig.id}">
    <input type="hidden" id="oldcheckType" value="$!{fcAutoCheckConfig.checkType}">
    <input type="hidden" id="oldvalidSign" value="$!{fcAutoCheckConfig.validSign}">
    <input type="hidden" id="size"  value="$!{size}">
        <table id="appTable" class="layui-table layui-form">
            <tr>
                ##自动对账策略代码
                <td class="textRight">#springMessage('finacial.autoCheck.autoCheckCode')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" id="autoCheckCode" name="autoCheckCode" maxlength="4"
                               lay-verify="required|strlength" class="layui-input" value="$!{fcAutoCheckConfig.autoCheckCode}">
                    </div>
                </td>
                ##自动对账策略名称
                <td class="textRight">#springMessage('finacial.autoCheck.autoCheckName')</td>
                <td>
                    <input type="text" name="autoCheckName" lay-verify="required|strlength" maxlength="10"
                           class="layui-input" value="$!{fcAutoCheckConfig.autoCheckName}">
                </td>
            </tr>
            <tr>
                ##对账类型
                <td class="textRight">#springMessage('finacial.autoCheck.checkType')</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-name="checkType" data-biz-name="checkType" data-type="select"
                             data-group="fcAutoCheckConfig.checkType" data-defaultvalue="$!{fcAutoCheckConfig.checkType}"
                             data-required="true"></div>
                    </div>
                </td>

                ##对账周期
                <td class="textRight">#springMessage('finacial.autoCheck.checkCycle')</td>
                <td>
                    <div class="layui-inline">
                        <div class="bt-biz-dict" data-name="checkCycle" data-biz-name="checkCycle" data-type="select"
                             data-group="fcAutoCheckConfig.checkCycle" data-defaultvalue="$!{fcAutoCheckConfig.checkCycle}"
                             data-required="true"></div>
                    </div>
                </td>
            </tr>
            <tr>
                ##策略生效时间
                <td class="textRight">#springMessage('finacial.autoCheck.launchTime')</td>
                <td>
                    <input type="text" name="launchTime" lay-verify="required" class="layui-input bt-biz-dateType"
                           value="$!{fcAutoCheckConfig.launchTime}" data-type="datetime">

                </td>
                ##有效标识
                <td class="textRight">#springMessage('finacial.paramConfig.fcSubject.valid')</td>
                <td>
                    <div class="bt-biz-dict" data-type="radio" data-group="valid_sign"
                         data-required="true"
                         data-defaultvalue="$!{fcAutoCheckConfig.validSign}" data-name="validSign"
                         data-biz-name="validSign"></div>
                </td>
            </tr>
            <tr>
                ##备注
                <td class="textRight">#springMessage('table.cmsProvideLoanInfo.rmk')</td>
                <td colspan="3">
                                <textarea type="text" id="rmk" name="rmk" class="layui-textarea"
                                          placeholder="#springMessage('table.cmsProvideLoanInfo.rmk')">$!{fcAutoCheckConfig.rmk}</textarea>
                </td>
            </tr>

            <tr>
                <td colspan="4" style="text-align: center">
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage(
                        'common.button.submit')</button>
                    <button class="layui-btn" onClick="doClose()">#springMessage(
                        'common.button.close')</button>
                </td>
            </tr>
        </table>
</form>
    #parse("views/common/footer.vm")
<script src="${basePath}/static/modules/check/fcAutoCheckConfig.update.js?_btv=${resourceVersion}"></script>
</body>
</html>

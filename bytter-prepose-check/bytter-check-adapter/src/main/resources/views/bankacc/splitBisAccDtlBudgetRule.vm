<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form ">
    <input id="id" name="id" type="hidden" value="$!{bisAccDtlBudgetRulePage.id}">
    <input id="transTimeStr" name="transTimeStr" type="hidden" value="$!{bisAccDtlBudgetRulePage.transTimeStr}">
    <input id="corpName" name="corpName" type="hidden" value="$!{bisAccDtlBudgetRulePage.corpName}">
    <input id="bankAcc" name="bankAcc" type="hidden" value="$!{bisAccDtlBudgetRulePage.bankAcc}">
    <input id="accName" name="accName" type="hidden" value="$!{bisAccDtlBudgetRulePage.accName}">
    <input id="oppAccNo" name="oppAccNo" type="hidden" value="$!{bisAccDtlBudgetRulePage.oppAccNo}">
    <input id="oppAccName" name="oppAccName" type="hidden" value="$!{bisAccDtlBudgetRulePage.oppAccName}">
    <input id="curName" name="curName" type="hidden" value="$!{bisAccDtlBudgetRulePage.curName}">
    <input id="cdSign" name="cdSign" type="hidden" value="$dictTag.get("btBankAccDtl.cdSign",$!{bisAccDtlBudgetRulePage.cdSign})">
    <input id="remark" name="remark" type="hidden" value="$!{bisAccDtlBudgetRulePage.remark}">
    <input id="fbsStatus" name="fbsStatus" type="hidden" value="$dictTag.get("bisAccDtlBudgetRule.fbsStatus",$!{bisAccDtlBudgetRulePage.fbsStatus})">
    <div style="display:inline-block;width:100%;">
        #springMessage('table.fbsBudgetProcess.sumMoney') $!number.formatNumeric($!{bisAccDtlBudgetRulePage.amt})
        <input id="oldAmt" name="oldAmt" type="hidden" value="$!{bisAccDtlBudgetRulePage.amt}">
        <input id="newAmt" name="newAmt" type="hidden">
    </div>
    <table id="dataTable" style="width:100%;" >
        <thead>
        <tr>
            <th>#springMessage('table.btBankAccDtl.transTime')</th>
            <th>#springMessage('table.nisPersonnelDetail.corpId')</th>
            <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
            <th>#springMessage('table.btBankAccDtl.accName')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
            <th>#springMessage('table.btBankAccDtl.curName')</th>
            <th>#springMessage('table.bisAccDtlBudgetRule.sign')</th>
            <th>#springMessage('table.bisAccDtlBudgetRule.amt')</th>
            <th>#springMessage('table.btBankAccDtl.remark')</th>
            <th>#springMessage('table.btBankAccDtl.status')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
        <tbody>
        <tr row="0">
            <td>$!{bisAccDtlBudgetRulePage.transTimeStr}</td>
            <td>$!{bisAccDtlBudgetRulePage.corpName}</td>
            <td>$!{bisAccDtlBudgetRulePage.bankAcc}</td>
            <td>$!{bisAccDtlBudgetRulePage.accName}</td>
            <td>$!{bisAccDtlBudgetRulePage.oppAccNo}</td>
            <td>$!{bisAccDtlBudgetRulePage.oppAccName}</td>
            <td>$!{bisAccDtlBudgetRulePage.curName}</td>
            <td>$dictTag.get("btBankAccDtl.cdSign",$!{bisAccDtlBudgetRulePage.cdSign})</td>
            <td align="center">
                <div class="layui-input-inline">
                    <input type="text" id="amt0" name="amt" lay-verify="number2" data-name="amt"  value="0.00"
                               autocomplete="off" class="layui-input bt-biz-moneyType" data-biz-name="amt0" data-callback="calItemMoney">
                </div>
            </td>
            <td>$!{bisAccDtlBudgetRulePage.remark}</td>
            <td>$dictTag.get("bisAccDtlBudgetRule.fbsStatus",$!{bisAccDtlBudgetRulePage.fbsStatus})</td>
            <td></td>
        </tr>
        <tr row="1">
            <td>$!{bisAccDtlBudgetRulePage.transTimeStr}</td>
            <td>$!{bisAccDtlBudgetRulePage.corpName}</td>
            <td>$!{bisAccDtlBudgetRulePage.bankAcc}</td>
            <td>$!{bisAccDtlBudgetRulePage.accName}</td>
            <td>$!{bisAccDtlBudgetRulePage.oppAccNo}</td>
            <td>$!{bisAccDtlBudgetRulePage.oppAccName}</td>
            <td>$!{bisAccDtlBudgetRulePage.curName}</td>
            <td>$dictTag.get("btBankAccDtl.cdSign",$!{bisAccDtlBudgetRulePage.cdSign})</td>
            <td align="center">
                <div class="layui-input-inline">
                    <input type="text" id="amt1" name="amt" lay-verify="number2" data-name="amt"  value="0.00"
                           autocomplete="off" class="layui-input bt-biz-moneyType" data-biz-name="amt1" data-callback="calItemMoney">
                </div>
            </td>
            <td>$!{bisAccDtlBudgetRulePage.remark}</td>
            <td>$dictTag.get("bisAccDtlBudgetRule.fbsStatus",$!{bisAccDtlBudgetRulePage.fbsStatus})</td>
            <td></td>
        </tr>
        <tr id="sumTr">
            <td colspan="8" align="right">#springMessage('table.datatable.total')</td>
            <td><div id="sumMoney">0.00</div></td>
            <td colspan="3"></td>
        </tr>
        </tbody>
    </table>
    <div class="layui-form-item layui-form-submit" id="buttonDiv">
        <div class="layui-input-block">
            <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
        </div>
    </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/bisAccDtlBudgetRule.split.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")

    <style>
        .select-column {
            overflow: visible!important;
        }

    </style>
</head>
<body>
    <form id="searchForm" class="layui-form">
		<table class="layui-table">
			<tbody >
				<tr>
                    ##单位
					<td class="textRight" width="10%">#springMessage('table.btBankAccDtl.corp')</td>
                    <td width="20%">
						<div class="layui-input-inline">
    						 <div class="bt-biz-corp"
                                data-biz-type="corp"
                                data-type="selectTree"
                                data-tree-type="check"
                                data-name="ins_corpId"
                                data-scope="all" data-resource="netbank:bankAcc:paymentBlending:query"
                                data-callback="corpCallback"></div>
                        </div>
					</td>
                    ##交易时间
                    <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.transTime')</td>
                    <td width="30%">
                        <input type="text" name="ged_transTime" data-type="date" data-biz-name="ged_transTime" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_transTime" data-today="true">
                        <span class="date-mid">~</span>
                        <input type="text" name="led_transTime" data-type="date" data-biz-name="led_transTime" class="layui-input bt-input-inline bt-biz-dateType" id="led_transTime" data-today="true">
                    </td>
                    ##币别
                    <td class="textRight">#springMessage('table.btBankAccDtl.curName')</td>
                    <td>
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                             data-name ="eqs_curId" data-biz-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
                    </td>
                </tr>
                <tr>
                    ##本方账号
                    <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.bankAcc')</td>
                    <td width="30%">
                        <input type="text" id="likes_bankAcc" name="likes_bankAcc" lay-verify="strlength" data-maxlength="30"
                               autocomplete="off" class="layui-input bank" placeholder="#springMessage('table.btBankAccDtl.bankAcc')" data-callback="test">
                    </td>
                    ##交易金额
                    <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.amt')</td>
                    <td width="30%">
                        <div class="layui-inline">
                            <input type="text" name="geg_amt" autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                                   style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.bisExc.payMoney')">
                            <span class="date-mid">~</span>
                            <input type="text" name="leg_amt" autocomplete="off" class="layui-input bt-biz-moneyType bt-input-inline"
                                   style="text-align:right" id="t20" placeholder="#springMessage('table.bisExc.payMoney')">
                        </div>
                    </td>
                    ##对方账号
                    <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.oppAccNo')</td>
                    <td width="30%">
                        <input type="text" id="likes_oppAccNo" name="likes_oppAccNo" lay-verify="strlength" data-maxlength="30"
                               autocomplete="off" class="layui-input bt-biz-accountTable bank" placeholder="#springMessage('table.btBankAccDtl.oppAccNo')" data-callback="test">
                    </td>
                    ##状态
                    <input type="hidden" name="eqs_blendSign" id="blendSign" value="$!{blendSign}"/>
##                    <td class="textRight" width="10%">#springMessage('table.fbsBudget.status')</td>
##                    <td width="30%">
##                        <div class="bt-biz-dict" data-type="select" data-group="paymentblending_status" data-name="eqs_blendSign" data-biz-name="blendSign"
##                             data-defaultvalue="0" data-displayData="0,1"></div>
##                    </td>
                </tr>
                <tr>
                    ##对方账户名
                    <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.oppAccName')</td>
                    <td width="30%">
                        <input type="text" id="likes_oppAccName" name="likes_oppAccName"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.oppAccName')">
                    </td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
                ##查询
                <tr>
                    <td colspan="6" class="center">
                        <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
		</table>
    </form>
    <form id="searchFormBill" class="layui-form">
        <input type="hidden" name="eqs_bankSerialNo" id="eqs_bankSerialNo" />
        <input type="hidden" name="eqg_payMoney" id="eqg_payMoney" />
        <input type="hidden" name="eqs_payerAcc" id="eqs_payerAcc" />
        <input type="hidden" name="eqs_payeeAcc" id="eqs_payeeAcc" />
        <input type="hidden" name="wishPayday" id="wishPayday" />
        <input type="hidden" name="eqs_curId" id="eqs_curId" />
    </form>
    <table id="appTableDtl" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.listPaymentBlending.blendSign')</th>
            <th>#springMessage('table.btNetChalk.transTime')</th>
            <th>#springMessage('table.btBankAccDtl.corp')</th>
            <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
            <th>#springMessage('table.btBankAccDtl.accName')</th>
            <th>#springMessage('table.btBankAccDtl.curName')</th>
            <th>#springMessage('table.btBankAccDtl.amt')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
            <th>#springMessage('table.bisAccDtl.summary')</th>
            <th>#springMessage('table.nisBillhead.purpose')</th>
        </tr>
        </thead>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bankacc/paymentScrap.list.js?_btv=${resourceVersion}"></script>
</html>

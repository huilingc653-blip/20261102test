##                    <th>#springMessage('table.bisAccDtlBudgetRule.matchBudget')</th>
                    <th>#springMessage('table.fbsBudgetPeriod.rmk')</th>
                    <th>#springMessage('common.table.thead.operation')</th>
                </tr>
                </thead>
            </table>
            <!-- 资金计划 -->
            <div id="box" style="width:99%;">
                <table class="layui-table dark-layui-table layui-table-border" style="width:100%;">
                    <tr>
                        #if($!{isClaimBusType} == 1)
                            <td  class="textRight" width="10%">#springMessage('table.nisBillhead.busType')</td>
                            <td width="15%">
                                <div class="layui-form" id="batchBusTypeDiv">
                                </div>
                            </td>
                        #end
                        <td class="textRight" width="10%">#springMessage('table.fbsBudgetProcess.settlType')</td>
                        <td width="15%">
                            <div class="layui-form">
                                <div class="bt-biz-dict" data-type="select" data-group="settlType" data-name="settlTypeBatch" data-biz-name="settlTypeBatch"
                                     data-callback="settlTypeBatchCallback"></div>
                            </div>
                        </td>
                        #if($!{budgetSel} == 1)
                            <td class="textRight" width="10%">#springMessage("table.bisAccDtlBudgetRule.processTime")</td>
                            <td width="10%">
                                <div class="layui-input-inline"width="10%">

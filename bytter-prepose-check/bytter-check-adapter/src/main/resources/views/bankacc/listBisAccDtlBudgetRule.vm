                                </div>
                            </td>
                            <td class="textRight" width="10%">#springMessage("table.fbsBudgetProcess.itemCode")</td>
                            <td width="15%">
                                <div class="layui-inline" id="itemDiv">
                                    <div class="bt-biz-itemType"
                                         data-type="selectTree"
                                         id="itemInfo"
                                         data-name="itemInfo"
                                         data-biz-name="itemInfo"
                                         data-corpId=""
                                         data-itemCode=""
                                         data-sign="1"
                                         data-tree-type="radio"
                                         data-callbackData="itemChange"
                                         data-initcomplete = "itemInfoInit"
                                         data-scope=""></div>
                                </div>
                                <input type="hidden" id="itemName" name="itemName" autocomplete="off" class="layui-input"/>
                            </td>
                        #end
                        <td class="leftRight" width="20%">
##                            #if($shiro.hasPermission("netbank:bankAcc:bisAccDtlBudgetRule:apply"))
                                <div class="layui-input-inline">
                                    <button class="layui-btn" onclick="batchSure('appTable')" type="button">#springMessage('common.button.sure')</button>
                                </div>
                                <div class="layui-input-inline">
                                    <button class="layui-btn" onclick="batchDelete('appTable')" type="button">#springMessage('common.button.delete')</button>
                                </div>
##                            #end
                        </td>
                    </tr>
                </table>
                <table id="budgetProcessDataTable" class="layui-table dark-layui-table layui-table-border" style="display: none;width:100%;">
                    <thead>
                    <tr>
                        <th>#springMessage('table.fbsBudgetProcess.itemCode')</th>
                        <th>#springMessage('table.fbsBudgetProcess.itemName')</th>
                        <th>#springMessage('table.fbsBudgetProcess.itemBalance')</th>
                        <th>#springMessage('table.fbsBudgetProcess.superItemBalance')</th>
                        <th>#springMessage('table.fbsBudgetProcess.topItemBalance')</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr row="0">
                        <td >
                            <input id="isControl" name="isControl" type="hidden">
                            <span id="itemCodeText"></span>
                        </td>
                        <td >
                            <span id="itemNameText"></span>
                        </td>
                        <td class="textRight">
                            <span id="itemBalanceText"></span>
                        </td>
                        <td class="textRight">
                            <span id="superItemBalanceText"></span>
                        </td>
                        <td class="textRight">
                            <span id="topItemBalanceText"></span>
                        </td>
                    </tr>
                    </tbody>
                </table>
        </div>
    </div>

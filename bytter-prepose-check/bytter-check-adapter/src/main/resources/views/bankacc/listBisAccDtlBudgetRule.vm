                        </td>
                    ##收款账号名称
                        <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.oppAccName')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" id="likes_oppAccName" name="likes_oppAccName" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.oppAccName')">
                            </div>
                        </td>
                    </tr>
                    <tr>
                    ##币别

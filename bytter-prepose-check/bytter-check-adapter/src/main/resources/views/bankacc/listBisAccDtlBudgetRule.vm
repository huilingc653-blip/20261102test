                <input id="isEnableSplit" name="isEnableSplit" type="hidden" value="$!{isEnableSplit}">
                ##是否启用合并
                <input id="isEnableMerge" name="isEnableMerge" type="hidden" value="$!{isEnableMerge}">
                ##是否认领到业务类别
                <input id="isClaimBusType" name="isClaimBusType" type="hidden" value="$!{isClaimBusType}">
                <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
                <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
                <input id="itemCode" name="itemCode" type="hidden">
                <input id="defItemCode" name="defItemCode" type="hidden">
                <input id="corpId" name="corpId" type="hidden">
                <input id="cdSign" name="cdSign" type="hidden">

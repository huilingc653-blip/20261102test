<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab layui-tab-brief" lay-filter="paymentblending">
    <ul class="layui-tab-title" id="intTab">
        <li lay-id="inner1"  class="layui-this">#springMessage('table.netbank.receiptclaim')</li>
        <li lay-id="inner2" onclick="pushTable('otherTable')">#springMessage('table.netbank.otherreceiptclaim')</li>
    </ul>
    <div class="layui-tab-content">

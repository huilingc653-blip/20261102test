                        <td>
                            <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                                 data-name ="eqs_curId" data-biz-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
                        </td>
                    ##摘要
                        <td class="textRight" width="10%">#springMessage('table.btBankAccDtl.remark')</td>
                        <td>
                            <div class="layui-input-inline">
                                <input type="text" id="likes_remark" name="likes_remark" class="layui-input" placeholder="#springMessage('table.btBankAccDtl.remark')">
                            </div>
                        </td>
                    ##查询收款明细
                        <input type="hidden" name="eqs_cdSign" value="0"/>
                    ##                        <td class="textRight">#springMessage('table.bisAccDtlBudgetRule.sign')</td>
                    ##                        <td >
                    ##                            <div class="bt-biz-dict" data-type="select" data-group="btBankAccDtl.cdSign"
                    ##                                 data-name="eqs_cdSign" data-biz-name="cdSign" ></div>
                    ##                        </td>
                    ##状态
                        <td class="textRight">#springMessage('table.btBankAccDtl.status')</td>
                        <td>
                            <div class="bt-biz-dict" data-type="select"
                                 data-group="bisAccDtlBudgetRule.fbsStatus" data-name="eqs_fbsStatus" data-defaultvalue="0"></div>
                        </td>
                    </tr>
                    <tr>
                    ##发生额
                        <td class="textRight">#springMessage('table.bisAccDtlBudgetRule.amt')</td>
                        <td>
                            <div class="layui-inline">
                                <input data-name="geg_amt" data-moneyendid="endAmt" class="layui-input bt-biz-moneyType" type="text">
                            </div>
                            <div class="layui-inline">
                                <span class="date-mid">~</span>
                            </div>
                            <div class="layui-inline">
                                <input id="endAmt" data-name="leg_amt" class="layui-input bt-biz-moneyType" type="text">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="6" style="text-align: center;">
##                           ## #if($shiro.hasPermission("netbank:bankAcc:bisAccDtlBudgetRule:apply"))
                                <button class="layui-btn" lay-submit lay-filter="search1" type="button">#springMessage('common.button.search')</button>
                                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
##                           ## #end
                        </td>
                    </tr>
                    </tbody>
                </table>
            </form>
            <table id="appTable" class="layui-table layui-form" style="width:100%;">
                <thead>
                <tr>
                    <th>#springMessage('table.btBankAccDtl.transTime')</th>
                    <th>#springMessage('table.nisPersonnelDetail.corpId')</th>
                    <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
                    <th>#springMessage('table.btBankAccDtl.accName')</th>
                    <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
                    <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
                    <th>#springMessage('table.btBankAccDtl.curName')</th>

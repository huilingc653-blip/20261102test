<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <input id="id" name="id" type="hidden" value="$!{bisAccDtlBudgetRulePage.id}">
    <input id="billNo" name="billNo" type="hidden" value="$!{bisAccDtlBudgetRulePage.accNo}">
    <input id="businessName" name="businessName" type="hidden" value="$!{businessName}">
    <input id="processSysname" name="processSysname" type="hidden" value="$!{processSysname}">
    <input id="processDate" name="processDate" type="hidden" value="$!{bisAccDtlBudgetRulePage.processDate}">
    <input id="corpId" name="corpId" type="hidden" value="$!{bisAccDtlBudgetRulePage.corpId}">
    <input id="wishPayday" name="wishPayday" type="hidden" value="$!{bisAccDtlBudgetRulePage.processDate}">
    <input id="settlType" name="settlType" type="hidden" value="$!{bisAccDtlBudgetRulePage.settlType}">
    <input id="curId" name="curId" type="hidden" value="$!{bisAccDtlBudgetRulePage.curId}">
    <input id="payerAcc" name="payerAcc" type="hidden" value="$!{bisAccDtlBudgetRulePage.bankAcc}">
    <input id="payeeAccName" name="payeeAccName" type="hidden" value="$!{bisAccDtlBudgetRulePage.oppAccName}">
    <input id="payeeAcc" name="payeeAcc" type="hidden" value="$!{bisAccDtlBudgetRulePage.oppAccNo}">
    <input id="payeeBank" name="payeeBank" type="hidden" value="$!{bisAccDtlBudgetRulePage.oppAccBank}">
<table class="layui-table dark-layui-table layui-table-border">
    <thead>
    <tr>
        <th colspan="4" style="text-align:center"><h5><strong>#springMessage('table.bisAccDtl.view')</strong></h5></th>
    </tr>
    </thead>
    <tbody>
    <tr>
        ##单位名称
        <td class="textRight" width="20%">#springMessage('table.bisAccDtl.corpName')</td>
        <td width="30%">$!{bisAccDtlBudgetRulePage.corpName}</td>
        ##交易时间
        <td class="textRight" width="20%">#springMessage('table.bisAccDtl.transTime')</td>
        <td width="30%">$!date.format('yyyy-MM-dd HH:mm:ss',$!{bisAccDtlBudgetRulePage.transTime})</td>
    </tr>
    <tr>
        ##本方账号
        <td class="textRight">#springMessage('table.btNetChalk.bankAcc')</td>
        <td>$!{bisAccDtlBudgetRulePage.bankAcc}</td>
        ##对方账号
        <td class="textRight">#springMessage('table.btNetChalk.oppAccNo')</td>
        <td>$!{bisAccDtlBudgetRulePage.oppAccNo}</td>
    </tr>
    <tr>
        ##本方账号名
        <td class="textRight">#springMessage('table.btNetChalk.accName')</td>
        <td>$!{bisAccDtlBudgetRulePage.accName}</td>
        ##对方账号名
        <td class="textRight">#springMessage('billPool.bail.oppAccName')</td>
        <td>$!{bisAccDtlBudgetRulePage.oppAccName}</td>
    </tr>
    <tr>
        ##本方账号开户行
        <td class="textRight">#springMessage('table.btNetChalk.bankName')</td>
        <td>$!{bisAccDtlBudgetRulePage.bankName}</td>
        ##对方账号开户行
        <td class="textRight">#springMessage('table.btNetChalk.oppBankName')</td>
        <td>$!{bisAccDtlBudgetRulePage.oppAccBank}</td>
    </tr>
    <tr>
        ##币别
        <td class="textRight">#springMessage('table.fbsBudgetDetail.curId')</td>
        <td>$!{bisAccDtlBudgetRulePage.curName}</td>
        <td class="textRight"></td>
        <td></td>
    </tr>
    <tr>
        ##金额
        <td class="textRight">#springMessage('table.nisBillhead.payMoney.lower')</td>
        <td>$!number.formatNumeric($!{bisAccDtlBudgetRulePage.amt})
            <input type="hidden" data-name="amt" data-toUp="amtUp" autocomplete="off"
                   class="layui-input bt-biz-moneyType" value="$!{bisAccDtlBudgetRulePage.amt}">
        </td>
        <td class="textRight">#springMessage('table.nisBillhead.payMoney.upper')</td>
        <td style="padding-left:0px"><div id="amtUp"></div></td>
    </tr>
    <tr>
        ##摘要
        <td class="textRight">#springMessage('table.btBankAccDtl.remark')</td>
        <td>$!{bisAccDtlBudgetRulePage.remark}</td>
        <td class="textRight"></td>
        <td></td>
    </tr>
    <tr>
        ##业务类别
        <td class="textRight">#springMessage('table.nisBillhead.busType')</td>
        <td>$!{bisAccDtlBudgetRulePage.busTypeName}</td>
        ##单号
        <td class="textRight">#springMessage('table.choBankFinance.bankBillNo')</td>
        <td>$!{bisAccDtlBudgetRulePage.billNo}</td>
    </tr>
    <tr>
        ##结算类型
        <td class="textRight">#springMessage('table.fbsBudgetProcess.settlType')</td>
        <td>$dictTag.get("settlType",$!{bisAccDtlBudgetRulePage.settlType})</td>
        ##备注
        <td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
        <td>$!{bisAccDtlBudgetRulePage.rmk}</td>
    </tr>
    </tbody>
</table>

    <!-- 资金计划 -->
    <div id="tagItemDetail"></div>
    #if($!{bisAccDtlBudgetRulePage.cdSign} == '1')
        <table id="dataTable" style="width:100%;display: none"  class="layui-table">
    #else
        <table id="dataTable" style="width:100%;"  class="layui-table">
    #end
        <thead>
        <tr>
            <th colspan="9" style="text-align:center"><h5><strong>#springMessage('table.bisAccDtl.oldView')</strong></h5></th>
        </tr>
        <tr>
            <th>#springMessage('table.btBankAccDtl.transTime')</th>
            <th>#springMessage('table.nisPersonnelDetail.corpId')</th>
            <th>#springMessage('table.btBankAccDtl.bankAcc')</th>
            <th>#springMessage('table.btBankAccDtl.accName')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccNo')</th>
            <th>#springMessage('table.btBankAccDtl.oppAccName')</th>
            <th>#springMessage('table.btBankAccDtl.curName')</th>
            <th>#springMessage('table.bisAccDtlBudgetRule.amt')</th>
            <th>#springMessage('table.btBankAccDtl.remark')</th>
        </tr>
        </thead>
        <tbody>
        #foreach($bisAccDtlBudgetRule in $!{dtlList})
        <tr>
            <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{bisAccDtlBudgetRule.transTime})</td>
            <td>$!{bisAccDtlBudgetRule.corpName}</td>
            <td>$!{bisAccDtlBudgetRule.bankAcc}</td>
            <td>$!{bisAccDtlBudgetRule.accName}</td>
            <td>$!{bisAccDtlBudgetRule.oppAccNo}</td>
            <td>$!{bisAccDtlBudgetRule.oppAccName}</td>
            <td>$!{bisAccDtlBudgetRule.curName}</td>
            <td align="center">
                $!number.formatNumeric($!{bisAccDtlBudgetRule.amt})
            </td>
            <td>$!{bisAccDtlBudgetRule.remark}</td>
        </tr>
        #end
        </tbody>
    </table>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bankacc/bisAccDtlBudgetRule.view1.js?_btv=${resourceVersion}"></script>
</html>

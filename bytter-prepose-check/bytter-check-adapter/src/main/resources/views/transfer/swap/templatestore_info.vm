<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	<style>
        #template_edit_fen_table .layui-input{width:120px;}
	</style>
</head>
<body>
<form id="searchForm" class="layui-form">
     ##模板是否能编辑
    <input type="hidden" id="enteringIsEdit" value="$!{enteringIsEdit}">
    <input type="hidden" name="dealType" value="$!{configType}">
    <input type="hidden" id="newSet" value="$!{newSet}">
    <input type="hidden" name="serialId" value="$!{templateStore.dtlId}">
    <table class="layui-table">
        <tbody>
            <tr><td colspan="6" class="textCenter">#if($!configType=="payer")付款单 #else 收款单#end</td></tr>
            <tr><td colspan="6" class="textCenter">申请单位：$!{templateStore.corpName}</td></tr>
            <tr>
                <td class="textCenter" rowSpan="4">收<br>款<br>单<br>位</td>
                <td class="textRight">收款人：</td>
                <td class="textLeft">#if($!configType=="payer")$!{templateStore.oppAccName} #else $!{templateStore.accName} #end </td>
                <td class="textCenter" rowSpan="4">付<br>款<br>单<br>位</td>
                <td class="textRight">付款人：</td>
                <td class="textLeft">#if($!configType=="payer")$!{templateStore.accName} #else $!{templateStore.oppAccName}#end </td>
            </tr>
            <tr>
                <td class="textRight">收款账号：</td>
                <td class="textLeft">#if($!configType=="payer")$!{templateStore.oppAccNo} #else $!{templateStore.bankAcc}#end</td>
                <td class="textRight">付款账号：</td>
                <td class="textLeft">#if($!configType=="payer")$!{templateStore.bankAcc} #else $!{templateStore.oppAccNo}#end</td>
            </tr>
            <tr>
                <td class="textRight">收款开户行：</td>
                <td class="textLeft">#if($!configType=="payer")$!{templateStore.oppAccBank} #else $!{templateStore.bankName}#end</td>
                <td class="textRight">付款开户行：</td>
                <td class="textLeft">#if($!configType=="payer")$!{templateStore.bankName} #else $!{templateStore.oppAccBank}#end</td>
            </tr>
            <tr>
                <td class="textRight">人民币（大写）：</td>
                <td class="textLeft" id="info_money"></td>
                <td class="textRight">人民币（小写）：</td>
                <td class="textLeft" id="info_money_val">$!{templateStore.amt}</td>
            </tr>
            <tr>
                <td class="textRight" colSpan="2">模版类型：</td>
                <td class="textLeft">
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-biz-name="typeId" data-url="$!{basePath}/erp/swap/templatetype/listjson" data-valuefield="id"
                             data-textfield="typeName" data-name="typeId" data-search="true" data-callback="chageCild" data-link="true"
                             data-defaultvalue="$!{templateStore.typeId}" data-required="true"></div>
                    </div>
                </td>
                <td class="textRight" colSpan="2">模版名称：</td>
                <td class="textLeft">
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-url="#if($templateStore.typeId)$!{basePath}/erp/swap/template/jsons/$!{templateStore.typeId}#end" data-valuefield="id"
                             data-textfield="templateName" data-name="templateId" data-search="true" data-biz-name="templateId"
                             data-link="true" data-defaultvalue="$!{templateStore.templateId}" data-required="true" data-callback="chageTemplate" data-initCallback="chageTemplate" ></div>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
	#set($vmPage = "views/transfer/swap/templatestore_base.vm")
	#parse($vmPage)
    <div class="layui-form-item layui-form-submit">
        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
        <button type="reset" data-callback="chageCild" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
	</div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/swap/templatestore.info.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/swap/templatestore.base.js?_btv=${resourceVersion}"></script>
</html>

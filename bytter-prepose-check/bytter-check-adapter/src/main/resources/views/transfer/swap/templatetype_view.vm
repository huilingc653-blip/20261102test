<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <script type="text/javascript">var typeId = "$!{templateType.id}";</script>
</head>
<body>
	<form class="layui-form layui-form-pane">
        <table class="layui-table">
            <tr>
                <td class="textRight">#springMessage('table.template.code')</td>
                <td width="35%">$!{templateType.typeCode}</td>
                <td class="textRight">#springMessage('table.template.name')</td>
                <td width="35%">$!{templateType.typeName}</td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.header.matches')</td>
                <td width="35%">$!{templateType.matchingName}</td>
                <td class="textRight">#springMessage('Remarks')</td>
                <td width="35%">$!{templateType.rmk}</td>
            </tr>
        </table>
        <div class="layui-collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.header.field')</h2>
                <div class="layui-colla-content layui-show" style="height:auto;overflow-y:auto;">
                    <table class="layui-table">
                        <thead>
                        <tr>
                            <th>#springMessage('table.field.name')</th>
                            <th>#springMessage('bpm.option.extendparams.visible')</th>
                            <th>#springMessage('table.is.entry')</th>
                            <th>#springMessage('bpm.option.invoiceconfig.name')</th>
                            <th>#springMessage('table.abVoucherinfo.source')</th>
                            <th>#springMessage('table.input.method')</th>
                        </tr>
                        </thead>
                        <tbody id="head_table"></tbody>
                    </table>
                </div>
            </div>
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.credential.entry.set')</h2>
                <div class="layui-colla-content layui-show" style="height:auto;overflow-y:auto;">
                    <table class="layui-table ">
                        <thead>
                        <tr>
                            <th>#springMessage('table.field.name')</th>
                            <th>#springMessage('bpm.option.extendparams.visible')</th>
                            <th>#springMessage('table.is.entry')</th>
                            <th>#springMessage('bpm.option.invoiceconfig.name')</th>
                            <th>#springMessage('table.abVoucherinfo.source')</th>
                            <th>#springMessage('table.input.method')</th>
                        </tr>
                        </thead>
                        <tbody id="botton_table"></tbody>
                    </table>
                </div>
            </div>
        </div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/swap/templatetype.view.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="dealType" value="$!{configType}">
    <input type="hidden" name="serialIds" value="$!{ids}">
    ##模板是否能编辑
    <input type="hidden" id="enteringIsEdit">
    <table class="layui-table">
        <tbody>
            <tr>
                <td class="textRight" width="15%">模版类型：</td>
                <td class="textLeft" width="35%">
                    <div class="bt-biz-selectType" data-biz-name="typeId" data-url="$!{basePath}/erp/swap/templatetype/listjson" data-valuefield="id"
                         data-textfield="typeName" data-name="typeId" data-search="true" data-callback="chageCild" data-link="true" 
                         data-required="true"></div>
                </td>
                <td class="textRight" width="15%">模版名称：</td>
                <td class="textLeft" width="35%">
                    <div class="bt-biz-selectType" data-url="" data-valuefield="id" 
                         data-textfield="templateName" data-name="templateId" data-search="true" data-biz-name="templateId"
                         data-link="true" data-required="true" data-callback="chageTemplate" data-initCallback="chageTemplate"></div>
                </td>
            </tr>
        </tbody>
    </table>
	#set($vmPage = "views/transfer/swap/templatestore_base.vm")
	#parse($vmPage)
	<div class="layui-form-item layui-form-submit">
        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
	</div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/swap/templatestore.infos.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/swap/templatestore.base.js?_btv=${resourceVersion}"></script>
</html>

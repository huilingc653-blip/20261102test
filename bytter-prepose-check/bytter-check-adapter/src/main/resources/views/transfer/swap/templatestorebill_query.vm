<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab layui-tab-brief">
    <form id="searchForm" class="layui-form">
        <input type="hidden" name="dealType" value="$!{configType}">
        <table class="layui-table">
            <tbody >
            <tr>
                <td class="textRight">#springMessage('table.abVoucherinfoVice.corpId')</td>
                <td width="20%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-tree-type="check"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-name="ins_corpId"
                             data-resource="transfer:erphisdtl:$!{configType}:query"
                             data-scope="all">
                        </div>
                    </div>
                </td>
                <td class="textRight">#springMessage('table.abVoucherinfo.origNo')</td>
                <td width="35%">
                    <div class="layui-input-inline">
                        <input type="text" name="likes_code"
                               autocomplete="off" class="layui-input" placeholder="#springMessage('table.abVoucherinfo.origNo')">
                    </div>
                </td>
                <td class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                <td width="20%">
                    <div class="bt-biz-dict" data-type="select" data-group="AB_BILL_TYPE" data-name="eqi_billType"></div>
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.abAccrecords.status')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="transfer_deal_status" data-name="status"></div>
                </td>
                <td class="textRight">#springMessage('table.abVoucherinfo.billMoney')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="geg_money" data-moneyendid="endMoney" autocomplete="off"
                               class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                        <span class="date-mid">~</span>
                        <input type="text" name="leg_money" id="endMoney" autocomplete="off"
                               class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                    </div>
                </td>
                <td class="textRight">#springMessage('bill.accebill.bustype')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="bill_operation_type" data-name="eqs_tradeType"></div>
                </td>
            </tr>
            <tr>
                ##出票日期
                <td class="textRight">#springMessage('table.abVoucherinfo.startDate')</td>
                <td width="35%">
                    <div class="layui-inline">
                        <input type="text" name="ged_transTime" data-name="ged_transTime" class="layui-input bt-biz-dateType" data-endid="transTime" data-type="date">
                    </div>
                    ~
                    <div class="layui-inline">
                    <input type="text" name="led_transTime"　data-name="led_transTime" class="layui-input bt-biz-dateType" id="transTime" data-type="date">
                </div>
                </td>
                ##业务办理日期
                <td class="textRight">#springMessage('table.abVoucherinfo.Business.date')</td>
                <td width="35%">
                    <div class="layui-inline">
                        <input type="text" name="ged_businessDate" data-name="ged_businessDate" class="layui-input bt-biz-dateType" data-endid="businessDate" data-type="date">
                    </div>
                    ~
                    <div class="layui-inline">
                        <input type="text" name="led_businessDate"　data-name="led_businessDate" class="layui-input bt-biz-dateType" id="businessDate" data-type="date">
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="6" class="center">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.abVoucherinfo.origNo')</th>
            <th>#springMessage('table.abAccrecords.status')</th>
            <th>#springMessage('table.abVoucherinfo.billType')</th>
            <th>#springMessage('table.abVoucherinfo.billFlag')</th>
            <th>#springMessage('bill.accebill.bustype')</th>
            <th>#springMessage('table.abVoucherinfoVice.corpId')</th>
            <th>#springMessage('table.abVoucherinfo.payer')</th>
            <th>#springMessage('table.abVoucherinfo.acceptor')</th>
            <th>#springMessage('table.abVoucherinfo.billMoney')</th>
            <th>#springMessage('table.abVoucherinfo.Business.date')</th>
            <th>#springMessage('table.abVoucherinfo.startDate')</th>
            <th>#springMessage('table.abVoucherinfo.endDate')</th>
            <th>#springMessage('table.abVoucherinfo.payee')</th>
            <th>#springMessage('table.erpBasicData.erpSendCode')</th>
            <th>#springMessage('table.erpBasicData.erpSendReason')</th>
            <th>#springMessage('bill.accebill.op')</th>
            <th>#springMessage('table.transfer.templateName')</th>
            <th>#springMessage('table.transfer.templateTypeName')</th>
        </tr>
        </thead>
    </table>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/swap/templatestorebill.query.js?_btv=${resourceVersion}"></script>
</html>

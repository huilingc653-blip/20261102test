<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	<style>
		html,body{height:100%;overflow-y: hidden;}
	</style>
</head>
<body>
	<form class="layui-form task_form" method="post">
        <input type="hidden" name="id" value="$!{template.id}"/>
        <input type="hidden" name="templateTypeId" value="$!{template.templateTypeId}">
        <table class="layui-table">
			<tbody>
            <tr>
                <td class="textRight">#springMessage('table.template.type')</td>
                <td width="40%">$!{templateType.typeName}</td>
                <td class="textRight">#springMessage('table.template.type.rmk')</td>
                <td width="40%">$!{templateType.rmk}</td>
            </tr>
        	<tr>
				<td class="textRight">#springMessage('table.template.code')</td>
				<td>$!{template.templateCode}</td>
				<td class="textRight">#springMessage('table.template.name')</td>
				<td>$!{template.templateName}</td>
			</tr>
        	<tr>
				<td class="textRight">#springMessage('table.supplement.is.edited')</td>
				<td>
					#if($template.enteringIsEdit eq '1')
						是
					#else
						否
					#end
				</td>
				<td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
				<td>$!{template.rmk}</td>
			</tr>
        	</tbody>
        </table>
        <fieldset class="layui-elem-field layui-field-title" style="margin-top:0px;">
            <legend>#springMessage('table.header.matches')</legend>
        </fieldset>
        <table class="layui-table" style="width: 100%;overflow: auto;">
            <thead id="head_thead"></thead>
            <tbody id="head_table" class="ignore-required-icon"></tbody>
        </table>

        <fieldset class="layui-elem-field layui-field-title" style="margin-top:0px;">
            <legend>#springMessage('table.interet.vourcherfl')</legend>
        </fieldset>
        <table class="layui-table" style="width: 100%;overflow: auto;">
            <thead id="botton_thead"></thead>
            <tbody id="botton_table" class="ignore-required-icon"></tbody>
        </table>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/swap/template.view.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="dealType" value="$!{configType}">
    <input type="hidden" name="serialIds" value="$!{ids}">
    <table class="layui-table">
        <tr>
            <td  colspan="6" class="textCenter">补录信息</td>
        </tr>
        #set($list = $configFills)
        #set($count = $configFills.size())
        #foreach($obj in $list)
            #set($num = $velocityCount - 1)
            #if( $num%2 == 0)
                #set($vcount = $velocityCount +1)
                #set($ds = $list[$num].dataSource)
                <tr>
                    <td class="textRight" colSpan="2"id="dyna$velocityCount">$list[$num].showName</td>
                    <td class="textLeft">
                        #if($ds.trim().length()==0)
                            <input type="text" id="$list[$num].fieldCode" name="$list[$num].fieldCode"
                                   autocomplete="off" class="layui-input" flag="defineStyle" lay-verify="#if($list[$num].isNotNull==1)required#end">

                        #else
                            <div class="layui-input-inline">
                                <div class="bt-biz-selectType" data-flag="defineStyle" data-url="$!{basePath}/erp/swap/template/source?code=$ds" data-valuefield="code"
                                     data-textfield="name" data-name="$list[$num].fieldCode" data-search="true" data-biz-name="$list[$num].fieldCode"
                                     data-link="true" data-required="#if($list[$num].isNotNull==1)true#end" ></div>
                            </div>
                        #end
                    </td>
                    #if($vcount>$count)
                        <td class="textRight" colSpan="2"></td>
                        <td class="textLeft"></td>
                    #else
                        #set($vds = $list[$velocityCount].dataSource)
                        <td class="textRight" colSpan="2" id='"dyna$vcount'>$list[$velocityCount].showName</td>
                        <td class="textLeft">
                            #if($vds.trim().length()==0)
                                <input type="text" id="$list[$velocityCount].fieldCode" name="$list[$velocityCount].fieldCode"
                                       autocomplete="off" class="layui-input" flag="defineStyle" lay-verify="#if($list[$velocityCount].isNotNull==1)required#end" >
                            #else
                                <div class="layui-input-inline">
                                    <div class="bt-biz-selectType" data-flag="defineStyle" data-url="$!{basePath}/erp/swap/template/source?code=$vds" data-valuefield="code"
                                         data-textfield="name" data-name="$list[$velocityCount].fieldCode" data-search="true" data-biz-name="$list[$velocityCount].fieldCode"
                                         data-link="true" data-required="#if($list[$velocityCount].isNotNull==1)true#end" ></div>
                                </div>
                            #end
                        </td>
                    #end

                </tr>
            #end
        #end
    </table>
	<div class="layui-form-item layui-form-submit">
        <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
	</div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/swap/templatestore.info.newSets.js?_btv=${resourceVersion}"></script>
</html>

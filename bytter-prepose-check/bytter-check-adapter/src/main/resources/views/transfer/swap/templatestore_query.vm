<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div class="layui-tab layui-tab-brief">
    <form id="searchForm" class="layui-form">
        <input type="hidden" name="dealType" value="$!{configType}">
        <input type="hidden" id="newSet" value="$!{newSet}">
        <table class="layui-table">
            <tbody >
            <tr>
                <td class="textRight" width="5%">#springMessage('table.bisAccDtlClaim.transTime')</td>
                <td width="35%">
                    <input type="text" name="ged_transTime" data-type="date" data-biz-name="ged_transTime"
                           class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_transTime" data-today="true" data-max="$!{maxDate}">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_transTime" data-type="date" data-biz-name="
                        led_transTime" class="layui-input bt-input-inline bt-biz-dateType" id="led_transTime" data-today="true" data-max="$!{maxDate}">
                </td>
                <td class="textRight" width="5%">#springMessage('table.bisAccDtlClaim.corp')</td>
                <td width="25%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-tree-type="check"
                             data-name="ins_corpId"
                             data-resource="transfer:erphisdtl:$!{configType}:query"
                             data-scope="all"></div>
                    </div>
                </td>
                <td class="textRight" width="5%">#springMessage('table.bisAccDtlClaim.bankType')</td>
                <td width="25%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btbanktype/json"
                             data-name ="eqs_bankTypeId" data-biz-name ="eqs_bankTypeId"  data-valueField="id" data-textField="typeName"></div>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="textRight" width="10%">#springMessage('table.bisAccDtlClaim.bankAcc')</td>
                <td width="20%">
                    <input type="text" id="likes_bankAcc" name="likes_bankAcc" class="layui-input bank" autocomplete="off">
                </td>
                <td class="textRight">#springMessage('table.btBankAccDtl.oppAccName')</td>
                <td width="20%">
                    <input type="text" id="likes_oppAccNo" name="likes_oppAccName" class="layui-input " autocomplete="off">
                </td>
                <td class="textRight">#springMessage('table.bisAccDtlClaim.curName')</td>
                <td>
                    <div class="layui-input-inline">
                        <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                             data-name ="eqs_curId" data-biz-name ="eqs_curId"  data-valueField="id" data-textField="curName"></div>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="textRight">#springMessage('table.cgsBill.money')</td>
                <td>
                    <input type="text" data-name="geg_amt" class="layui-input bt-input-inline  bt-biz-moneyType" data-moneyendid="leg_amt">
                    <span class="date-mid">~</span>
                    <input type="text" data-name="leg_amt" class="layui-input bt-input-inline  bt-biz-moneyType" id="leg_amt">
                </td>
                <td class="textRight">#springMessage('table.bisAccDtlClaim.remark')</td>
                <td>
                    <input type="text" id="likes_remark" name="likes_remark" class="layui-input" />
                </td>
                <td class="textRight">#springMessage('table.abAccrecords.status')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="transfer_deal_status" data-name="status"></div>
                </td>
            </tr>
            <tr>
                <td colspan="6" class="center">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
            </tbody>
        </table>
    </form>

    <table id="appTable" class="layui-table layui-form" style="width:100%;">
##        <thead>
##        <tr>
##            <th>#springMessage('table.abAccrecords.status')</th>
##            <th>#springMessage('table.bisAccDtlClaim.transTime')</th>
##            <th>#springMessage('table.bisAccDtlClaim.corp')</th>
##            <th>#springMessage('table.bisAccDtlClaim.bankAcc')</th>
##            <th>#springMessage('table.bisAccDtlClaim.accName')</th>
##            <th>#springMessage('table.bisAccDtlClaim.oppAccNo')</th>
##            <th>#springMessage('table.bisAccDtlClaim.oppAccName')</th>
##            <th>#springMessage('table.bisAccDtlClaim.curName')</th>
##            <th>#springMessage('table.bisAccDtlClaim.amt')</th>
##            <th>#springMessage('table.bisAccDtlClaim.remark')</th>
##            <th>#springMessage('table.erpBasicData.erpSendCode')</th>
##            <th>#springMessage('table.erpBasicData.erpSendReason')</th>
##            <th>#springMessage('操作人')</th>
##            <th>#springMessage('table.transfer.templateName')</th>
##            <th>#springMessage('table.transfer.templateTypeName')</th>
##        </tr>
##        </thead>
    </table>
</div>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/swap/dynaSource.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/swap/templatestore.query.js?_btv=${resourceVersion}"></script>
</html>

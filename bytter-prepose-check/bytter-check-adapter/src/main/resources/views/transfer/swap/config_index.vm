<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
    <style>
        body{
            font-size:14px;
            padding-bottom: 60px;
        }
        .layui-form-label{
            width: 180px;
        }
        .layui-input-block{
            margin-left: 220px;
        }
    </style>
</head>
<body>
<form class="layui-form" action="">
    <fieldset class="layui-elem-field layui-field-title" style="margin-top:20px;">
        <legend>#springMessage('table.bank.payment.interface')</legend>
    </fieldset>
    <table class="layui-table">
        <tr>
            <td class="textRight" width="15%">#springMessage('config.nis.autoBisExcAccount')</td>
            <td width="85%">
                <input type="radio" name="payer.autosend" value="1" #if($payer.autosend == 1)checked#end title="#springMessage('common.sc_yn.yes')">
                <input type="radio" name="payer.autosend" value="0" #if($payer.autosend != 1)checked#end title="#springMessage('common.sc_yn.no')">
            </td>
        </tr>
        <tr>
            <td class="textRight" width="15%">#springMessage('table.through.setting')</td>
            <td width="85%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict"
                         data-type="radio"
                         data-defaultvalue="$!{payer.newSet}"
                         data-callback="isPayerSet"
                         data-name="payer.newSet"
                         data-biz-name="newSetr"
                         data-group="sf_yn"></div>
                </div>
                <span id="payerSet" style="display:none"><a class="" href="#" onclick="configSet('payer');">#springMessage('common.button.setting')</a></span>
            </td>
        </tr>
    </table>
    <fieldset class="layui-elem-field layui-field-title" style="margin-top:10px;">
        <legend>#springMessage('table.bank.collection.interface')</legend>
    </fieldset>
    <table class="layui-table">
        <tr>
            <td class="textRight" width="15%">#springMessage('config.nis.autoBisExcAccount')</td>
            <td width="85%">
                <input type="radio" name="payee.autosend" value="1" #if($payee.autosend == 1)checked#end title="#springMessage('common.sc_yn.yes')">
                <input type="radio" name="payee.autosend" value="0" #if($payee.autosend != 1)checked#end title="#springMessage('common.sc_yn.no')">
            </td>
        </tr>
        <tr>
            <td class="textRight" width="15%">#springMessage('table.through.setting')</td>
            <td width="85%">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict"
                         data-type="radio"
                         data-defaultvalue="$!{payee.newSet}"
                         data-callback="isPayeeSet"
                         data-name="payee.newSet"
                         data-biz-name="newSet"
                         data-group="sf_yn"></div>
                </div>
                <span id="payeeSet" style="display:none"><a class="" href="#" onclick="configSet('payee');">#springMessage('common.button.setting')</a></span>
            </td>
        </tr>
    </table>
    <fieldset class="layui-elem-field layui-field-title" style="margin-top:10px;">
        <legend>#springMessage('table.bill.interface.setting')</legend>
    </fieldset>
    <table class="layui-table">
        <tr>
            <td class="textRight" width="15%">#springMessage('config.nis.autoBisExcAccount')</td>
            <td width="85%">
                <input type="radio" name="accebill.autosend" value="1" #if($accebill.autosend == 1)checked#end title="#springMessage('common.sc_yn.yes')">
                <input type="radio" name="accebill.autosend" value="0" #if($accebill.autosend != 1)checked#end title="#springMessage('common.sc_yn.no')">
            </td>
        </tr>
    </table>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="20%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage("common.button.submit")</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage("common.button.reset")</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>

</script>
<script src="${basePath}/static/modules/swap/config.index.js?_btv=${resourceVersion}">

</script>
</body>
</html>
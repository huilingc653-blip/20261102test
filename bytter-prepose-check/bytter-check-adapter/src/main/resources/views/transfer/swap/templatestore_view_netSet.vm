<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="dealType" value="$!{configType}">
    <table class="layui-table">
        <tbody>
            <tr><td colspan="6" class="textCenter">#if($!configType=="payer")付款单 #else 收款单#end</td></tr>
            <tr><td colspan="6" class="textCenter">申请单位：$!{templateStore.corpName}</td></tr>
            <tr>
                <td class="textCenter" rowSpan="4">收<br>款<br>单<br>位</td>
                <td class="textRight">收款人：</td>
                <td class="textLeft">#if($!configType=="payer")$!{templateStore.oppAccName} #else $!{templateStore.accName} #end</td>
                <td class="textCenter" rowSpan="4">付<br>款<br>单<br>位</td>
                <td class="textRight">付款人：</td>
                <td class="textLeft">#if($!configType=="payer")$!{templateStore.accName} #else $!{templateStore.oppAccName}#end</td>
            </tr>
            <tr>
                <td class="textRight">收款账号：</td>
                <td class="textLeft">#if($!configType=="payer")$!{templateStore.oppAccNo} #else $!{templateStore.bankAcc}#end</td>
                <td class="textRight">付款账号：</td>
                <td class="textLeft">#if($!configType=="payer")$!{templateStore.bankAcc} #else $!{templateStore.oppAccNo}#end</td>
            </tr>
            <tr>
                <td class="textRight">开户行：</td>
                <td class="textLeft">#if($!configType=="payer")$!{templateStore.oppAccBank} #else $!{templateStore.bankName}#end</td>
                <td class="textRight">付款开户行：</td>
                <td class="textLeft">#if($!configType=="payer")$!{templateStore.bankName} #else $!{templateStore.oppAccBank}#end</td>
            </tr>
            <tr>
                <td class="textRight">人民币（大写）：</td>
                <td class="textLeft" id="info_money"></td>
                <td class="textRight">人民币（小写）：</td>
                <td class="textLeft" id="info_money_val">$!{templateStore.amt}</td>
            </tr>
            <tr>
                <td class="textRight" colSpan="2" width="15%">#springMessage('操作人')</td>
                <td width="35%">$!{templateStore.opName}</td>
                <td class="textRight" colSpan="2" width="15%">#springMessage('操作日期')</td>
                <td width="35%">
					$!date.format('yyyy-MM-dd HH:mm:ss',$!{templateStore.opDate})
                </td>
            </tr>
            <tr>
                <td  colspan="6" class="textCenter">补录信息</td>
            </tr>
                #set($list = $templateStore.erpHisDtlComFields)
                #set($count = $list.size())
                #foreach($obj in $list)
                    #set($num = $velocityCount - 1)
                    #if( $num%2 == 0)
                        #set($vcount = $velocityCount +1)
                        #set($ds = $list[$num].dataSource)
                    <tr>
                        <td class="textRight" colSpan="2"id="dyna$velocityCount">$list[$num].showName</td>
                        <td class="textLeft">
                            #if($ds.trim().length()==0)
                                $!list[$num].textValue
                            #else
                                <div class="layui-input-inline">
                                    <div class="bt-biz-selectType" data-flag="defineStyle" data-url="$!{basePath}/erp/swap/template/source?code=$ds" data-valuefield="code"
                                         data-textfield="name" data-name="$list[$num].fieldCode" data-search="true" data-biz-name="$list[$num].fieldCode"
                                         data-link="true" data-defaultvalue="$!list[$num].textValue" data-disabled = "true"></div>
                                </div>
##                                <span id="$list[$num].fieldCode">$!list[$num].textValue</span>
                            #end
                        </td>
                        #if($vcount>$count)
                            <td class="textRight" colSpan="2"></td>
                            <td class="textLeft"></td>
                        #else
                            #set($vds = $list[$velocityCount].dataSource)
                            <td class="textRight" colSpan="2" id='"dyna$vcount'>$list[$velocityCount].showName</td>
                            <td class="textLeft">
                                #if($vds.trim().length()==0)
                                   $!list[$velocityCount].textValue
                                #else
##                                    <span id="$list[$velocityCount].fieldCode">$!list[$velocityCount].textValue</span>
                                    <div class="layui-input-inline">
                                        <div class="bt-biz-selectType" data-flag="defineStyle" data-url="$!{basePath}/erp/swap/template/source?code=$vds" data-valuefield="code"
                                             data-textfield="name" data-name="$list[$velocityCount].fieldCode" data-search="true" data-biz-name="$list[$velocityCount].fieldCode"
                                             data-link="true" data-defaultvalue="$!list[$velocityCount].textValue"  data-disabled = "true" ></div>
                                    </div>
                                #end
                            </td>
                        #end

                    </tr>
                    #end
                #end
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
    <script>
        var selectType;
        bt.use(['moneyType','selectType'], function(){
            $  = bt.jquery;
            selectType = bt.selectType.init();
            var money = $("#info_money_val").text();
            if(money){
                $("#info_money").html(bt.money.toChinese(money));
            }
        })
    </script>
</body>
</html>

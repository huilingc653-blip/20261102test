<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form" action="">
    <div class="layui-collapse">
        <div class="layui-colla-item">
            <h2 class="layui-colla-title">#springMessage('config.nis.param.titile')</h2>
            <div class="layui-colla-content layui-show">
                <table class="layui-table breakRow">
                    <thead>
                    <tr>
                        <td widget="20%" class="textRight">#springMessage('config.fbs.paramName')</td>
                        <td widget="80%">#springMessage('config.erp.isAllowdEdit')</td>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('table.nisBillhead.voucherTypeId')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="erp.voucherTypeId"
                                 data-biz-name="erp.voucherTypeId" data-defaultvalue="$config.erp.voucherTypeId"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('table.nisBillhead.payerAcc')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="erp.payerAcc"
                                 data-biz-name="erp.payerAcc" data-defaultvalue="$config.erp.payerAcc"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('table.nisBillhead.payMoney')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="erp.payMoney"
                                 data-biz-name="erp.payMoney" data-defaultvalue="$config.erp.payMoney"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('table.nisBillhead.payeeAcc')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="erp.payeeAcc"
                                 data-biz-name="erp.payeeAcc" data-defaultvalue="$config.erp.payeeAcc"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('table.nisBillhead.payeeAccName')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="erp.payeeAccName"
                                 data-biz-name="erp.payeeAccName" data-defaultvalue="$config.erp.payeeAccName"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('table.nisBillhead.payeeBank')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="erp.payeeBank"
                                 data-biz-name="erp.payeeBank" data-defaultvalue="$config.erp.payeeBank"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('table.nisBillhead.isForindividual')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="erp.isForindividual"
                                 data-biz-name="erp.isForindividual" data-defaultvalue="$config.erp.isForindividual"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('table.nisBillhead.wishPayday')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="erp.wishPayday"
                                 data-biz-name="erp.wishPayday" data-defaultvalue="$config.erp.wishPayday"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('table.nisBillhead.purpose')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="erp.purpose"
                                 data-biz-name="erp.purpose" data-defaultvalue="$config.erp.purpose"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('table.abVoucherinfo.billType')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="erp.billType"
                                 data-biz-name="erp.billType" data-defaultvalue="$config.erp.billType"></div>
                        </td>
                    </tr>
                    <tr>
                        <td width="20%" class="textRight">#springMessage('table.erp.billFlag')</td>
                        <td width="80%">
                            <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-name="erp.billFlag"
                                 data-biz-name="erp.billFlag" data-defaultvalue="$config.erp.billFlag"></div>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <table class="layui-table border0">
        <tbody>
        <tr>
            <td width="20%"></td>
            <td>
                <button class="layui-btn" lay-submit="" lay-filter="configSubmit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form','jquery', 'dicts'], function(){
        var form = bt.form(),$  = bt.jquery;
        bt.dicts.init();
        //监听提交
        form.on('submit(configSubmit)', function(data){
            $.post(basePath + "/sys/config/save",data.field,function(result){
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },"JSON");
            return false;
        });
    });
</script>
</body>
</html>
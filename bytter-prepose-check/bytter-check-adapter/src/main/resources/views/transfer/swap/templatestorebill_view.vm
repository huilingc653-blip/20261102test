<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table" width="100%">
        <tbody>
            <tr><td colspan="6" class="textCenter">#springMessage('table.abVoucherinfoVice.corpId')：$!{templateStore.corpName}</td></tr>
            <tr>
                <td class="textRight" colspan="2" width="15%">#springMessage('table.abVoucherinfo.origNo')</td>
                <td width="35%">$!{templateStore.code}</td>
                <td class="textRight" colspan="2" width="15%">#springMessage('bill.accebill.bustype')</td>
                <td width="35%"><div class="bt-biz-dict" data-group="bill_operation_type" data-value="$!{templateStore.tradeType}"></div></td>
            </tr>
            <tr>
                <td class="textRight" colspan="2" width="15%">#springMessage('table.abVoucherinfo.billMoney')</td>
                <td width="35%">$number.formatNumeric($!{templateStore.money})</td>
                <td class="textRight" colspan="2" width="15%">#springMessage('table.abVoucherinfo.billMoneyUp')</td>
                <td width="35%"><div id="moneyUp" data-value="$!{templateStore.money}"></div></td>
            </tr>
            <tr>
                <td class="textRight" colspan="2" width="15%">#springMessage('table.abVoucherinfo.startDate')</td>
                <td width="35%">$!date.format('yyyy-MM-dd',$!{templateStore.transTime})</td>
                <td class="textRight" colspan="2" width="15%">#springMessage('table.abVoucherinfo.endDate')</td>
                <td width="35%">$!date.format('yyyy-MM-dd',$!{templateStore.maturityDate})</td>
            </tr>
            <tr>
                <td class="textRight" colspan="2" width="15%">#springMessage('table.abVoucherinfo.billType')</td>
                <td width="35%"><div class="bt-biz-dict" data-group="AB_BILL_TYPE" data-value="$!{templateStore.billType}"></td>
                <td class="textRight" colspan="2" width="15%">#springMessage('table.abVoucherinfo.billFlag')</td>
                <td width="35%"><div class="bt-biz-dict" data-group="AB_BILL_FLAG" data-value="$!{templateStore.billFlag}"></td>
            </tr>
            <tr>
                <td rowspan="3" width="5%">#springMessage('bill.accebill.view.payer')</td>
                <td class="textRight" width="10%">#springMessage('bill.accebill.view.name')</td>
                <td width="35%">$!{templateStore.payer}</td>
                <td rowspan="3" width="5%">#springMessage('bill.accebill.view.payee')</td>
                <td class="textRight" width="10%">#springMessage('bill.accebill.view.name')</td>
                <td width="35%">$!{templateStore.receiver}</td>
            </tr>
            <tr>
                <td class="textRight" width="10%">#springMessage('bill.accebill.view.acc')</td>
                <td width="35%">$!{templateStore.payerAcc}</td>
                <td class="textRight" width="10%">#springMessage('bill.accebill.view.acc')</td>
                <td width="35%">$!{templateStore.receiverAcc}</td>
            </tr>
            <tr>
                <td class="textRight" width="10%">#springMessage('bill.accebill.view.BankName')</td>
                <td width="35%">$!{templateStore.payerName}</td>
                <td class="textRight">#springMessage('bill.accebill.view.BankName')</td>
                <td width="35%">$!{templateStore.receiverName}</td>
            </tr>
            <tr>
                <td rowspan="2" width="5%">#springMessage('bill.accebill.view.acceptor')</td>
                <td class="textRight" width="10%">#springMessage('bill.accebill.view.name')</td>
                <td width="35%">$!{templateStore.acceptor}</td>
                <td class="textRight" colspan="2" width="15%">#springMessage('bill.accebill.bankno')</td>
                <td width="35%">$!{templateStore.acceptorBankNo}</td>
            </tr>
            <tr>
                <td class="textRight" width="10%">#springMessage('bill.accebill.view.acc')</td>
                <td width="35%">$!{templateStore.acceptorAcc}</td>
                <td class="textRight" colspan="2" width="15%">#springMessage('bill.accebill.bankname')</td>
                <td width="35%">$!{templateStore.acceptorBankName}</td>
            </tr>
            <tr>
                <td class="textRight" colspan="2" width="15%">#springMessage('table.abAccrecords.abs')</td>
                <td width="35%">$!{templateStore.abs}</td>
                <td class="textRight" colspan="2" width="15%">#springMessage('table.abAccrecords.rmk')</td>
                <td width="35%">$!{templateStore.rmk}</td>
            </tr>
            <tr>
                <td class="textRight" colSpan="2" width="15%">#springMessage('table.transfer.templateName')</td>
                <td width="35%">$!{templateStore.templateName}</td>
                <td class="textRight" colSpan="2" width="15%">#springMessage('table.transfer.templateTypeName')</td>
                <td width="35%">$!{templateStore.typeName}
                </td>
            </tr>
            <tr>
                <td class="textRight" colSpan="2" width="15%">#springMessage('操作人')</td>
                <td width="35%">$!{templateStore.opName}</td>
                <td class="textRight" colSpan="2" width="15%">#springMessage('操作日期')</td>
                <td width="35%">
					$!date.format('yyyy-MM-dd HH:mm:ss',$!{templateStore.opDate})
                </td>
            </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['moneyType','form'], function() {
        var $ = bt.jquery,form = bt.form();
        var money = $("#moneyUp").data("value");
        $("#moneyUp").html(bt.moneyType.getFun().toChinese(money));
        $.each($("div.bt-biz-dict"),function (i,item) {
            var v = bt.dict($(this).data("group"),$(this).data("value"));
            $(this).parent("td").html(v);
        })
    })
</script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <script type="text/javascript">var typeId = "$!{templateType.id}";</script>
	<style>
        .layui-table {
            margin: 0px 0;
        }
        body {
            margin-bottom:30px;
        }
	</style>
</head>
<body>
	<form class="layui-form" method="post">

        <div class="layui-collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.main.set')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table">
                        <tbody>
                        <tr>
                            <input type="hidden" name="id" value="$!{templateType.id}"/>
                            <td class="textRight">#springMessage('table.template.code')</td>
                            <td width="40%">
                                <input type="text" id="typeCode" name="typeCode"
                                       autocomplete="off" class="layui-input" value="$!{templateType.typeCode}" lay-verify="required|strlength" data-maxlength="50" placeholder="#springMessage('table.template.code')">
                            </td>
                            <td class="textRight">#springMessage('table.template.name')</td>
                            <td width="40%">
                                <input type="text" id="typeName" name="typeName"
                                       autocomplete="off" class="layui-input" value="$!{templateType.typeName}" lay-verify="required|strlength" data-maxlength="100" placeholder="#springMessage('table.template.name')">
                            </td>
                        </tr>
                        <tr>
                            <td class="textRight">#springMessage('table.header.matches')</td>
                            <td>
                                <div class="selectFiled" data-defaultvalue="$!{templateType.matchingField}"></div>
                            </td>
                            <td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
                            <td>
                                <input type="text" id="rmk" name="rmk"
                                       autocomplete="off" class="layui-input" value="$!{templateType.rmk}" lay-verify="strlength" data-maxlength="500" placeholder="#springMessage('table.fbsBudgetPeriod.rmk')">
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="layui-collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.header.field')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table">
                        <thead>
                        <tr>
                            <th>#springMessage('table.field.name')</th>
                            <th>#springMessage('bpm.option.extendparams.visible')</th>
                            <th>#springMessage('table.is.entry')</th>
                            <th>#springMessage('bpm.option.invoiceconfig.name')</th>
                            <th>#springMessage('table.abVoucherinfo.source')</th>
                            <th>#springMessage('table.input.method')</th>
                        </tr>
                        </thead>
                        <tbody id="head_table"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="layui-collapse">
            <div class="layui-colla-item">
                <h2 class="layui-colla-title">#springMessage('table.credential.entry.set')</h2>
                <div class="layui-colla-content layui-show">
                    <table class="layui-table ">
                        <thead>
                        <tr>
                            <th>#springMessage('table.field.name')</th>
                            <th>#springMessage('bpm.option.extendparams.visible')</th>
                            <th>#springMessage('table.is.entry')</th>
                            <th>#springMessage('bpm.option.invoiceconfig.name')</th>
                            <th>#springMessage('table.abVoucherinfo.source')</th>
                            <th>#springMessage('table.input.method')</th>
                        </tr>
                        </thead>
                        <tbody id="botton_table"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="layui-form-item layui-form-submit ">
            <div class="layui-input-block">
                <!--<button class="layui-btn" lay-submit="" type="button" lay-filter="save">#springMessage('common.button.temp')</button> 修改没有暂存按钮-->
                <button class="layui-btn" lay-submit="" type="button" lay-filter="submit">#springMessage('common.button.submit')</button>
            </div>
        </div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/swap/templatetype.edit.js?_btv=${resourceVersion}"></script>
</html>
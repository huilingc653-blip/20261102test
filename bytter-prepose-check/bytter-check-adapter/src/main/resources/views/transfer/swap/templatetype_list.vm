<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##任务名称
                    <td class="textRight">#springMessage('table.template.code')</td>
                    <td width="40%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_typeCode"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.template.code')">
                        </div>
                    </td>
                    ##状态
                    <td class="textRight">#springMessage('table.template.name')</td>
                    <td width="40%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_typeName"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.template.name')">
                        </div>
                    </td>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.tbBaseRate.code')</th>
        <th>#springMessage('table.tbCreditPeriod.designation')</th>
        <th>#springMessage('table.fbsBudgetDetail.updateDate')</th>
        <th>#springMessage('table.fbsBudgetPeriod.status')</th>
        <th>#springMessage('table.fbsBudgetPeriod.rmk')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/js/dateForm.js?_btv=${resourceVersion}" charset="utf-8"></script>
<script src="${basePath}/static/modules/swap/templatetype.list.js?_btv=${resourceVersion}"></script>
</html>

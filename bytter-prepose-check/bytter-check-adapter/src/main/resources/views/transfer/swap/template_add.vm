<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
	<style>
        #template_edit_fen_table .layui-input{width:120px;}
	</style>
</head>
<body>
	<form class="layui-form task_form" method="post">
        <input type="hidden" name="templateTypeId" value="$!{templateType.id}">
        <table class="layui-table">
			<tbody>
            <tr>
                <td class="textRight">#springMessage('table.template.type')</td>
                <td width="40%">$!{templateType.typeName}</td>
                <td class="textRight">#springMessage('table.template.type.rmk')</td>
                <td width="40%">$!{templateType.rmk}</td>
            </tr>
        	<tr>
				<td class="textRight">#springMessage('table.template.code')</td>
				<td>
					<input type="text" id="typeCode" name="templateCode"
						   autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="50" placeholder="#springMessage('table.template.code')">
				</td>
				<td class="textRight">#springMessage('table.template.name')</td>
				<td>
                    <input type="text" id="typeName" name="templateName"
                           autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="100" placeholder="#springMessage('table.template.name')">
				</td>
			</tr>
        	<tr>
				<td class="textRight">#springMessage('table.supplement.is.edited')</td>
				<td>
					<div class="bt-biz-dict"
						data-type="radio"
						data-defaultvalue="0"
						data-name="enteringIsEdit"
						data-biz-name="enteringIsEdit"
						data-group="sf_yn"></div>
				</td>
				<td class="textRight">#springMessage('table.fbsBudgetPeriod.rmk')</td>
				<td>
                    <input type="text" id="rmk" name="rmk"
                           autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="500" placeholder="#springMessage('table.fbsBudgetPeriod.rmk')">
				</td>
			</tr>
			</tbody>
		</table>
        <fieldset class="layui-elem-field layui-field-title" style="margin-top:0px;">
            <legend>#springMessage('table.header.matches')</legend>
        </fieldset>
        <div class="dataTables_wrapper isDown" style="">
            <table class="layui-table" id="template_edit_head_table">
                <thead id="head_thead"></thead>
                <tbody id="head_table" class="ignore-required-icon"></tbody>
            </table>
		</div>
        <fieldset class="layui-elem-field layui-field-title" style="margin-top:0px;">
            <legend>#springMessage('table.interet.vourcherfl')</legend>
        </fieldset>
        <div class="dataTables_wrapper isDown" style="min-height:400px;">
			<table class="layui-table" id="template_edit_fen_table">
				<thead id="botton_thead"></thead>
				<tbody id="botton_table" class="ignore-required-icon"></tbody>
			</table>
		</div>
        <div class="layui-form-item layui-form-submit" style="margin-top:10px;text-align:center;">
            <button class="layui-btn addtr">#springMessage('common.addTr')</button>
            <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/swap/template.add.js?_btv=${resourceVersion}"></script>
</html>
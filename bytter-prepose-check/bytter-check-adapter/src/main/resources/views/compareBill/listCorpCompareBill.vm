<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    #if($type=="approve")
        #parse("views/flow/flow.vm")
    #end
    <style>
        .selectDate .layui-form-select{width: 80px;float: left}
        .selectDate .layui-form-select input{width: 80px}
        .date-char {width: 20px;line-height: 32px;height: 32px;float: left;margin:0 4px 0 4px;text-align: center}
    </style>
</head>
<body>
<form id="searchForm" class="layui-form">
    <input type="hidden" name="type" id="type" value="${type}"/>
    <input type="hidden" id="flowStatus" name="flowStatus" value="$!{flowStatus}"/>
    <table class="layui-table">
        <tbody>
        <tr>
            <td class="textRight">#springMessage('table.fcAcc.blnctrAcc')</td>
            <td width="25%">
                <input type="text" name="account"
                       autocomplete="off" class="bank layui-input"
                       placeholder="#springMessage('table.fcAcc.blnctrAcc')">
            </td>
            <td class="textRight">#springMessage('table.bisAccDtl.corpName')</td>
            <td width="25%">
                <div class="layui-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-tips="#springMessage('common.placeholder.select')#springMessage('table.fcAcc.netId')"
                         data-group="corpGroup"
                         data-resource="fc:corpCompareBill"
                         data-scope="all"></div>
                </div>
            </td>
            ## 账户类型
            <td class="textRight">#springMessage("accountGrant.sysAccountType")</td>
            <td width="25%">
                <div class="layui-inline">
                    <select name="accountType">
                        ## 全部
                        <option value=" ">#springMessage("common.placeholder.all")</option>
                        #foreach($dict in $dictTag.list("InnerAccount.AccType"))
                            #if($dict.code=="01"||$dict.code=="02"||$dict.code=="05")
                                <option value="$dict.code">$dict.name</option>
                            #end
                        #end
                    </select>
                </div>
            </td>
        </tr>
        #if($type!="approve")
        <tr>
            ## 账单月份
            <td class="textRight">#springMessage("fc.corpCompareBill.billMonth")</td>
            <td width="25%">
                <div class="selectDate">
                    <select name="year" lay-filter="aihao">
                        #foreach($year in [2000..$currentYear])
                            <option value="$year" #if($currentYear==$year)selected#end>$year</option>
                        #end
                    </select>
                    <div class="date-char">#springMessage('table.fcDayClose.closeYear')</div>
                    <select name="month" lay-filter="aihao">
                        #foreach($month in [1..12])
                            #if($month<10)
                                <option value="0$month" #if($currentMonth==$month)selected#end>0$month</option>
                            #else
                                <option value="$month" #if($currentMonth==$month)selected#end>$month</option>
                            #end
                        #end
                    </select>
                    ## 月
                    <div class="date-char">#springMessage("common.unit.month")</div>
                </div>
            </td>
            ## 状态
            <td class="textRight">#springMessage("common.table.status")</td>
            <td width="25%">
                <div class="layui-inline">
                    <select name="status">
                        ## 全部
                        <option value="">#springMessage("common.placeholder.all")</option>
                        #foreach($dict in $dictTag.list("fc.corpCompareBill"))
                            <option value="$dict.code" #if(($type=="query" && $dict.code=="95")||$type!="query" && $dict.code=="-2")selected#end>$dict.name</option>
                        #end
                    </select>
                </div>
            </td>
            #if($type=="query")
                ## 核对结果
                <td class="textRight">#springMessage("fc.corpCompareBill.checkResult")</td>
                <td>
                    <div class="layui-inline">
                        <select name="same">
                            ## 全部
                            <option value="">#springMessage("common.placeholder.all")</option>
                            #foreach($dict in $dictTag.list("fc.corpCompareBillSame"))
                                <option value="$dict.code">$dict.name</option>
                            #end
                        </select>
                    </div>
                </td>
            #else
                <td class="textRight"></td>
                <td>
                </td>
            #end
        </tr>
        #end
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        ## 单位名称
        <th>#springMessage("table.bisAccDtl.corpName")</th>
        ## 账号
        <th>#springMessage('table.fcAcc.blnctrAcc')</th>
        ## 账户名称
        <th>#springMessage("table.fcAcc.accName")</th>
        ## 币别
        <th>#springMessage("table.fcAccBalance.curId")</th>
        ## 账户类型
        <th>#springMessage("accountGrant.sysAccountType")</th>
        ##账户余额
        <th>#springMessage("table.nisBillhead.balance")</th>
        ## 企业账面余额
        <th>#springMessage("fc.corpCompareBill.erpBalance")</th>
        ## 状态
        <th>#springMessage("table.sysCorp.status")</th>
        #if($type=="query"||$type=="approve")
            ## 账单月份
            <th>#springMessage("fc.corpCompareBill.billMonth")</th>
            ## 核对结果
            <th>#springMessage("fc.corpCompareBill.checkResult")</th>
            ## 操作人
            <th>#springMessage("common.message.operator")</th>
            ## 操作日期
            <th>#springMessage("table.fcFreeze.operateTime")</th>
        #end
        ## 操作
        <th>#springMessage("common.table.thead.operation")</th>
    </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
    #if($type=="approve")
        #workFlowHtml()
        #workFlowScript()
    #end
<script src="${basePath}/static/modules/compareBill/corpCompareBill.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form">
		<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('bill.blankvou.bvStorageBox.title')</legend>
        </fieldset>
		<table class="layui-table">
		      <tr> 
                <td class="textRight" width="15%"> #springMessage('table.bvStorageBox.code')</td>
				<td width="35%">$!{bvStorageBoxPage.code}</td>
                <td class="textRight" width="15%">#springMessage('table.bvStorageBox.name')</td>
                <td width="35%">$!{bvStorageBoxPage.name}</td>
			  </tr> 	
			  <tr> 
                <td class="textRight">#springMessage('table.bvStorageBox.corpId')</td>
			    <td >$!{bvStorageBoxPage.corpName}</td>
                <td class="textRight"> #springMessage('table.bvStorageBox.validSign')</td>
			    <td >$!{bvStorageBoxPage.validSignName}</td>
        	  </tr>
			  <tr>
                <td class="textRight" >#springMessage('table.bvStorageBox.keeperUid')</td>
				<td >$!{bvStorageBoxPage.keeperName}</td>
                <td class="textRight" > #springMessage('table.bvStorageBox.address')</td>
				<td >$!{bvStorageBoxPage.address}</td>
              </tr>
			  <tr>
				<td class="textRight" > #springMessage('table.bvStorageBox.rmk')</td>
				<td colspan="3">$!{bvStorageBoxPage.rmk}</td>
              </tr>
		</table>	
	</form>
	
		<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('bill.logInfo.title')</legend>
        </fieldset>
		<div>
	<table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
            <tr>
                <th>#springMessage('table.bvLog.logType')</th>
                <th>#springMessage('table.bvLog.msg')</th>
                <th>#springMessage('table.bvLog.createName')</th>
                <th>#springMessage('table.bvLog.createBy')</th>
                <th>#springMessage('table.bvLog.createDate')</th>
            </tr>
        </thead>
		 <body>
				#if($!bvlogList)
				#foreach($bvLog in $bvlogList)
				<tr>
                <td>$!{bvLog.logTypeName}</td>
                <td>#springMessage($!{bvLog.msg})</td>
                <td>$!{bvLog.createName}</td>
                <td>$!{bvLog.createBy}</td>
                <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{bvLog.createDate})</td>
				</tr>
                #end
                #end
            </body>
	</table>
   </div> 
    #parse("views/common/footer.vm")
</body>
</script>
</html>
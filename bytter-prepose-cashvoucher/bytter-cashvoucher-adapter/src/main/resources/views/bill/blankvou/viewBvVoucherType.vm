<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form">
		<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('bill.blankvou.bvVoucherType.title')</legend>
        </fieldset>
		  <table class="layui-table">
		      <tr> 
                <td class="textRight" width="15%">#springMessage('table.bvVoucherType.code')</td>
				<td width="35%">$!{bvVoucherTypePage.code}</td>
                <td class="textRight" width="15%">#springMessage('table.bvVoucherType.name')</td>
                <td width="35%">$!{bvVoucherTypePage.name}</td>
			  </tr> 	
			  <tr> 
                <td class="textRight">#springMessage('table.bvVoucherType.isInbox')</td>
			    <td >$!{bvVoucherTypePage.isInboxName}</td>
                <td class="textRight">#springMessage('table.bvVoucherType.dataSource')</td>
			    <td >$!{bvVoucherTypePage.dataSource}</td>
        	  </tr>
			  <tr>
                <td class="textRight" >#springMessage('table.bvVoucherType.validSign')</td>
				<td >$!{bvVoucherTypePage.validSignName}</td>
                <td class="textRight" >#springMessage('table.bvVoucherType.rmk')</td>
				<td >$!{bvVoucherTypePage.rmk}</td>
              </tr> 
		</table>
		
		<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
				<legend>#springMessage('blankvou.printScene.title')</legend>
        </fieldset>	
		<div>
        <table id="fieldDataTable" class="layui-table layui-form" style="width:100%;">
       <thead>
            <tr>
                <th>#springMessage('blankvou.printScene.name')</th>
                <th>#springMessage('table.bvVoutypeDataField.validSign')</th>
            </tr>
        </thead>	
    			<body>
    				#if($!{bvVouTypeSceneListPage})
    				#foreach($bvVoutypeSceneVo in ${bvVouTypeSceneListPage})
    				<tr>
                    <td>#springMessage($!{bvVoutypeSceneVo.name})</td>
                    <td>$!{bvVoutypeSceneVo.validSignName}</td>
    				</tr>
                    #end
                    #end
                </body>
            </table>
    	</div>
		
		<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('bill.blankvou.bvVoutypeDataField.title')</legend>
        </fieldset>	
		<div>
        <table id="fieldDataTable" class="layui-table layui-form" style="width:100%;">
       <thead>
        <tr>        
        <th>#springMessage('table.bvVoutypeDataField.fieldCode')</th>
        <th>#springMessage('table.bvVoutypeDataField.fieldName')</th>
		<th>#springMessage('table.bvVoutypeDataField.dataType')</th>
		<th>#springMessage('table.bvVoutypeDataField.dictGroup')</th>
        <th>#springMessage('table.bvVoutypeDataField.validSign')</th>
        <th>#springMessage('table.bvVoutypeDataField.isShow')</th>
        </tr>
    </thead>	
			<body>
				#if($!{bvVouTypeDataFieldListPage})
				#foreach($bvVoutypeDataFieldVo in ${bvVouTypeDataFieldListPage})
				<tr>
                <td>$!{bvVoutypeDataFieldVo.fieldCode}</td>
                <td>#springMessage($!{bvVoutypeDataFieldVo.fieldName})</td>
				<td>$!{bvVoutypeDataFieldVo.dataTypeName}</td>
				<td>$!{bvVoutypeDataFieldVo.dictGroupName}</td>
                <td>$!{bvVoutypeDataFieldVo.validSignName}</td>
                <td>$!{bvVoutypeDataFieldVo.isShowName}</td>
				</tr>
                #end
                #end
            </body>
        </table>
	</div>
		
		<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('bill.logInfo.title')</legend>
        </fieldset>
		<div>
		<table class="layui-table layui-form" style="width: 100%;">
            <thead>
            <tr>
                <th>#springMessage('table.bvLog.logType')</th>
                <th>#springMessage('table.bvLog.msg')</th>
                <th>#springMessage('table.bvLog.createName')</th>
                <th>#springMessage('table.bvLog.createBy')</th>
                <th>#springMessage('table.bvLog.createDate')</th>
            </tr>
            </thead>
		   <body>
				#if($!bvlogList)
				#foreach($bvLog in $bvlogList)
				<tr>
                <td>$!{bvLog.logTypeName}</td>
                <td>#springMessage($!{bvLog.msg})</td>
                <td>$!{bvLog.createName}</td>
                <td>$!{bvLog.createBy}</td>
                <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{bvLog.createDate})</td>
				</tr>
                #end
                #end
            </body>
    	</table>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
	<table class="layui-table">
		<tbody>
		<tr>
		##所属单位
			<td class="textRight">#springMessage('table.bvPayeeCheque.corpId')</td>
			<td width="35%">
				$!{bvPayeeChequePage.corpName}
			</td>
		##票据编号
			<td class="textRight">#springMessage('table.bvPayeeCheque.origNo')</td>
			<td width="35%">
				$!{bvPayeeChequePage.origNo}
			</td>
		</tr>
		<tr>
		##票据金额
			<td class="textRight">#springMessage('table.bvPayeeCheque.billMoney')</td>
			<td width="35%">
				$number.formatNumeric($!{bvPayeeChequePage.billMoney})
			</td>
		##登记时间
			<td class="textRight">#springMessage('table.bvPayeeCheque.inputDate')</td>
			<td width="35%">
				$!date.format('yyyy-MM-dd',$!{bvPayeeChequePage.inputDate})
			</td>
		</tr>

		<tr>
		##开票日期
			<td class="textRight">#springMessage('table.bvPayeeCheque.startDate')</td>
			<td width="35%">
				$!date.format('yyyy-MM-dd',$!{bvPayeeChequePage.startDate})
			</td>
		##到期日期
			<td class="textRight">#springMessage('table.bvPayeeCheque.endDate')</td>
			<td width="35%">
				$!date.format('yyyy-MM-dd',$!{bvPayeeChequePage.endDate})
			</td>
		</tr>

		<tr>
		##收款人
			<td class="textRight">#springMessage('table.bvPayeeCheque.payee')</td>
			<td>
				$!{bvPayeeChequePage.payee}
			</td>
		##收款人账户
			<td class="textRight">#springMessage('table.bvPayeeCheque.payeeAcc')</td>
			<td>
				$!{bvPayeeChequePage.payeeAcc}
			</td>
		</tr>
		<tr>
		##收款人开户行
			<td class="textRight">#springMessage('table.bvPayeeCheque.payeeBankNo')</td>
			<td>
				$!{bvPayeeChequePage.payeeBankNo}
			</td>
		##收款人开户行名称
			<td class="textRight">#springMessage('table.bvPayeeCheque.payeeBankName')</td>
			<td>
				$!{bvPayeeChequePage.payeeBankName}
			</td>
		</tr>

		<tr>
		##币别
			<td class="textRight">#springMessage('table.fbsBudgetDetail.curId')</td>
			<td width="35%">
				$!{bvPayeeChequePage.curName}
			</td>
		## 汇率
			<td class="textRight">#springMessage('table.btCurrency.curExrate')</td>
			<td>
				#if($!{bvPayeeChequePage.curExrate})
					$!excRateTag.getConvert($!{bvPayeeChequePage.curExrate})
				#end
			</td>
		</tr>

		<tr>
		##折算本位币
			<td class="textRight">#springMessage('table.bvPayeeCheque.baseCurrency')</td>
			<td width="35%">
				$!number.formatNumeric($!{bvPayeeChequePage.nativeCreditMoney})
			</td>
		##用途
			<td class="textRight">#springMessage('table.bvPayeeCheque.use')</td>
			<td>
				$!{bvPayeeChequePage.uses}
			</td>
		</tr>

		<tr>
		##付款人
			<td class="textRight">#springMessage('table.bvPayeeCheque.payer')</td>
			<td>
				$!{bvPayeeChequePage.payer}
			</td>
		##付款人账户
			<td class="textRight">#springMessage('table.bvPayeeCheque.payerAcc')</td>
			<td>
				$!{bvPayeeChequePage.payerAcc}
			</td>
		</tr>
		<tr>
		##付款人开户行
			<td class="textRight">#springMessage('table.bvPayeeCheque.payerBankNo')</td>
			<td>
				$!{bvPayeeChequePage.payerBankNo}
			</td>
		##状态
			<td class="textRight">#springMessage('table.bvPayeeCheque.payerBankName')</td>
			<td>
				$!{bvPayeeChequePage.payerBankName}
			</td>
		</tr>
		<tr>
		##状态
			<td class="textRight">#springMessage('table.bvPayeeCheque.status')</td>
			<td>
				$!{bvPayeeChequePage.statusName}
			</td>
		##用途
			<td class="textRight"></td>
			<td>
			</td>
		</tr>
		</tbody>
	</table>
	<div>
		<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
			<tr>
				<th>#springMessage('table.bvLog.logType')</th>
				<th>#springMessage('table.bvLog.msg')</th>
				<th>#springMessage('table.bvLog.createName')</th>
				<th>#springMessage('table.bvLog.createBy')</th>
				<th>#springMessage('table.bvLog.createDate')</th>
			</tr>
			</thead>
			<body>
				#if($!bvlogList)
					#foreach($bvLog in $bvlogList)
					<tr>
						<td>$!{bvLog.logTypeName}</td>
						#if($!{bvLog.msg})
							<td>#springMessage($!{bvLog.msg})</td>
						#else
							<td></td>
						#end
						<td>$!{bvLog.createName}</td>
						<td>$!{bvLog.createBy}</td>
						<td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{bvLog.createDate})</td>
					</tr>
					#end
				#end
			</body>
		</table>
	</div>
</form>
	#parse("views/common/footer.vm")
</body>
</html>

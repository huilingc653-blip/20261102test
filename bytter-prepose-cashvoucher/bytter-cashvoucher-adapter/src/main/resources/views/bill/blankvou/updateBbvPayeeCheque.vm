<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
	<style type="text/css">
		.ruleNumber {
			display: inline;
			width: 60px;
		}
	</style>
</head>
<body>
<form class="layui-form" method="post">
	<input id="id" name="id" type="hidden" value="$!{bvPayeeChequeVO.id}">
	<input type="hidden" id="corpIdOld" value="$!{bvPayeeChequeVO.corpId}">
	<input id="createName" name="createName" type="hidden" value="$!{bvPayeeChequeVO.createName}">
	<input id="createBy" name="createBy" type="hidden" value="$!{bvPayeeChequeVO.createBy}">
	<input id="createDate" name="createDate" type="hidden" value="$!{bvPayeeChequeVO.createDate}">
	<input id="updateName" name="updateName" type="hidden" value="$!{bvPayeeChequeVO.updateName}">
	<input id="updateBy" name="updateBy" type="hidden" value="$!{bvPayeeChequeVO.updateBy}">
	<input id="updateDate" name="updateDate" type="hidden" value="$!{bvPayeeChequeVO.updateDate}">
	<input type="hidden" id="curId" name="curId" value="$!{bvPayeeChequeVO.curId}">
	<div class="layui-collapse">
		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('bill.blankvou.bvPayeeCheque.infos')</h2>
			<div class="layui-colla-content layui-show" >
				<table class="layui-table">
					<tbody>
					<tr>
					##所属单位
						<td class="textRight" width="15%"><span class="pl"><span class="required-icon">*</span>#springMessage('table.bvPayeeCheque.corpId')</td>
						<td>
							<div class="layui-input-inline">
								<div class="bt-biz-corp"
									 data-biz-type="corp"
									 data-type="selectTree"
									 id="corpId"
									 data-name="corpId"
									 data-required="true"
									 data-biz-name="corpId"
									 data-placeholder="#springMessage('table.bvPayeeCheque.corpId')"
									 data-callbackdata="corpCallback"
									 data-defaultvalue="$!{bvPayeeChequeVO.corpId}">
								</div>
							</div>

						</td>
					##票据编号
						<td class="textRight" width="15%">#springMessage('table.bvPayeeCheque.origNo')</td>
						<td width="35%">
							<input type="hidden" name="origNo"  value="$!{bvPayeeChequeVO.origNo}">
							$!{bvPayeeChequeVO.origNo}
						</td>
					</tr>
					<tr>
					##票据金额
						<td class="textRight" width="15%">#springMessage('table.bvPayeeCheque.billMoney')</td>
						<td width="35%">
							<input type="text" id="billMoney" name="billMoney"  value="$!{bvPayeeChequeVO.billMoney}" lay-verify="required|number2" data-name="billMoney"  data-biz-name="billMoney" autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.bvPayeeCheque.billMoney')">
						</td>
					##登记时间
						<td class="textRight" width="15%" >#springMessage('table.bvPayeeCheque.inputDate')</td>
						<td width="35%">
							<input type="text" name="inputDate" lay-verify="required" value="$!{bvPayeeChequeVO.inputDate}" data-today="true" class="layui-input bt-biz-dateType" data-type="date" data-biz-name="inputDate" lay-verify="date">
						</td>
					</tr>
					<tr>
					##开票日期
						<td class="textRight" width="15%">#springMessage('table.bvPayeeCheque.startDate')</td>
						<td width="35%">
							<input type="text" name="startDate" data-name="startDate" class="layui-input bt-biz-dateType" data-type="date"
								   data-biz-name="startDate" data-endid="endDate"  value="$!{bvPayeeChequeVO.startDate}">
						</td>
					##到期日期
						<td class="textRight" width="15%" >#springMessage('table.bvPayeeCheque.endDate')</td>
						<td width="35%">
							<input type="text" name="endDate" data-name="endDate" class="layui-input bt-biz-dateType" data-type="date"
								   data-biz-name="endDate" id="endDate" value="$!{bvPayeeChequeVO.endDate}">
						</td>
					</tr>
					</tbody>
				</table>
			</div>

		</div>
		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('bill.blankvou.bvPayeeCheque.payeeandpayer.info')</h2>
			<div class="layui-colla-content layui-show">
				<table class="layui-table">
					<tbody>
					<tr>
					##收款人
						<td class="textRight" width="15%">#springMessage('table.bvPayeeCheque.payee')</td>
						<td width="35%">
							<input type="text" id="payee" name="payee" autocomplete="off" value="$!{bvPayeeChequeVO.payee}" class="layui-input" placeholder="#springMessage('table.bvPayeeCheque.payee')" lay-verify="required|strlength" data-maxlength="50">
						</td>
					##收款人账户
						<td class="textRight" width="15%">#springMessage('table.bvPayeeCheque.payeeAcc')</td>
						<td width="35%">
							<div class="layui-input-inline">
								<input type="text" id="payeeAcc" name="payeeAcc" data-name="payeeAcc" value="$!{bvPayeeChequeVO.payeeAcc}" data-biz-name="payeeAcc" class="bank layui-input bt-biz-accountTable" data-callback="clickCallback" placeholder="#springMessage('table.bvPayeeCheque.payeeAcc')" lay-verify="required|strlength" data-maxlength="50"/>
							</div>
						</td>
					</tr>
					<tr>
					##收款人开户行
						<td class="textRight" width="15%">#springMessage('table.bvPayeeCheque.payeeBankNo')</td>
						<td width="35%">
							<div class="layui-input-inline"><input id="payeeBankNo" class="layui-input" value="$!{bvPayeeChequeVO.payeeBankNo}" name="payeeBankNo" placeholder="#springMessage('table.bvPayeeCheque.payeeBankNo')" lay-verify="required|strlength" data-maxlength="50"/></div>
						</td>
					##收款人开户行名称
						<td class="textRight" width="15%">#springMessage('table.bvPayeeCheque.payeeBankName')</td>
						<td width="35%">
							<input type="text" id="payeeBankName" name="payeeBankName" autocomplete="off" value="$!{bvPayeeChequeVO.payeeBankName}" class="layui-input" placeholder="#springMessage('table.bvPayeeCheque.payeeBankName')" lay-verify="required|strlength" data-maxlength="50">
						</td>
					</tr>
					<tr >
					##币别
						<td class="textRight" width="15%">#springMessage('table.fbsBudgetDetail.curId')</td>
						<td>
							<div class="layui-input-inline">
								<div id="curName">$!{currencyTag.getCurName($!{bvPayeeChequeVO.curId})}</div>
							</div>
						</td>
						<td></td>
						<td></td>
					</tr>
					<tr>
					##付款人
						<td class="textRight" width="15%">#springMessage('table.bvPayeeCheque.payer')</td>
						<td width="35%">
							<div class="layui-input-inline">
								<input id="payer" class="layui-input" name="payer" value="$!{bvPayeeChequeVO.payer}"  placeholder="#springMessage('table.bvPayeeCheque.payer')" lay-verify="required|strlength" data-maxlength="50"/>
								<div class="bt-div-search">
									<button  class="bt-biz-externalCorpBankAcc" id="selPayeeAccBut" type="button" data-callback="bt.bailCorpCallback" opType="payerExternalClick" title="#springMessage('common.button.select')">
										<i class="layui-icon">&#xe615;</i>
									</button>
								</div>
							</div>
						</td>
					##付款人账户
						<td class="textRight" width="15%">#springMessage('table.bvPayeeCheque.payerAcc')</td>
						<td width="35%">
							<input type="text" id="payerAcc" name="payerAcc" autocomplete="off" value="$!{bvPayeeChequeVO.payerAcc}" class="layui-input" placeholder="#springMessage('table.bvPayeeCheque.payerAcc')" lay-verify="required|strlength" data-maxlength="50">
						</td>
					</tr>
					<tr>
					##付款人开户行
						<td class="textRight" width="15%">#springMessage('table.bvPayeeCheque.payerBankNo')</td>
						<td width="35%">
							<div class="layui-input-inline" id="payerBankNoCallback">
								<input type="text" id="payerBankNo" name="payerBankNo" value="$!{bvPayeeChequeVO.payerBankNo}" autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvPayeeCheque.payerBankNo')"  lay-verify="required|strlength" data-maxlength="50">
								<div class="bt-div-search">
									<button class="bt-biz-bankInfo" id="selPayeeBankBut" type="button"  data-callback="bt.bailBankInfoCallback" opType="payerBankClick" title="#springMessage('common.button.select')">
										<i class="layui-icon">&#xe615;</i>
									</button>
								</div>
							</div>

						</td>
					##付款人开户行名称
						<td class="textRight" width="15%">#springMessage('table.bvPayeeCheque.payerBankName')</td>
						<td width="35%">
							<input type="text" id="payerBankName" name="payerBankName" autocomplete="off" value="$!{bvPayeeChequeVO.payerBankName}" class="layui-input" placeholder="#springMessage('table.bvPayeeCheque.payerBankName')" lay-verify="required|strlength" data-maxlength="50">
						</td>
					</tr>
					<tr rowspan="2" >
					##用途
						<td class="textRight" width="15%">#springMessage('table.bvPayeeCheque.use')</td>
						<td>
							<input type="text" id="use" name="use" autocomplete="off" class="layui-input" value="$!{bvPayeeChequeVO.uses}" placeholder="#springMessage('table.bvPayeeCheque.use')"  lay-verify="strlength"  maxlength="100">
						</td>
						<td></td>
						<td></td>
					</tr>
					</tbody>
				</table>
			</div>

		</div>
		<br>
		<div class="layui-form-submit-adaptive">
			<div style="text-align: center;">
				<button class="layui-btn" lay-submit="" lay-filter="temp" value="temp">#springMessage('common.button.temp')</button>
				<button class="layui-btn" lay-submit="" lay-filter="submit" value="submit">#springMessage('common.button.submit')</button>
			</div>
		</div>
	</div>
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/blackWhite/blackWhiteBase.check.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/blankvou/bvPayeeCheque.edit.js?_btv=${resourceVersion}"></script>
</html>	

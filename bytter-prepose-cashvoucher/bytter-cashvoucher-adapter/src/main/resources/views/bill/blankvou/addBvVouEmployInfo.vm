<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{bvVouEmployInfoPage.id}">
		<input id="voudNo" name="voudNo" type="hidden" value="$!{bvVouEmployInfoPage.vouNo}">
		<input id="voudtlId" name="voudtlId" type="hidden" value="$!{bvVouEmployInfoPage.id}">
		<input id="dataSource" name="dataSource" type="hidden" value="$!{bvVouEmployInfoPage.dataSource}">
        <input id="inputDate" type="hidden" value="$!date.format('yyyy-MM-dd',$!{bvVouEmployInfoPage.inputDate})">
		<table class="layui-table">
			<tbody>
				<tr>
    				##所属单位
                	<td class="textRight">#springMessage('table.bvVouInfoDtl.corpId')</td>
    				<td width="35%">
						<label class="layui-form-label;text-align:right;">
							$!{bvVouEmployInfoPage.corpName}
                        </label>
                    </td>
    				##所属账户
    				<td class="textRight">#springMessage('table.bvVouInfoDtl.bankAcc')</td>
    				<td width="35%">
						<label class="layui-form-label;text-align:right;">
							$!{bvVouEmployInfoPage.bankAcc}
						</label>
                    </td>
				</tr>
				
				<tr>
    				##所属银行
                	<td class="textRight">#springMessage('table.bvVouInfoDtl.bankId')</td>
    				<td>
    					<label class="layui-form-label;text-align:right;">
    					$!{bvVouEmployInfoPage.bankName}
                        </label>
                    </td>
					##币别
						<td class="textRight">#springMessage('table.fbsBudgetDetail.curId')</td>
						<td>
							$!{bvVouEmployInfoPage.curName}
						</td>
				</tr>

				<tr>
				##凭证种类
					<td class="textRight">#springMessage('table.bvVouInfoDtl.vouTid')</td>
					<td>
						<label class="layui-form-label;text-align:right;">
							$!{bvVouEmployInfoPage.voucherTypeName}
						</label>
					</td>
    				##所属库箱
                	<td class="textRight">#springMessage('table.bvVouInfoDtl.sboxId')</td>
    				<td>
    					<label class="layui-form-label;text-align:right;">
    					$!{bvVouEmployInfoPage.storageBoxName}
                        </label>
                    </td>
				</tr>

				<tr>
				##凭证编号
					<td class="textRight">#springMessage('table.bvVouInfoDtl.vouNo')</td>
					<td>
						<label class="layui-form-label;text-align:right;">
							$!{bvVouEmployInfoPage.vouNo}
						</label>
					</td>
					##购入日期
					<td class="textRight">#springMessage('table.bvVouInfoDtl.inputDate')</td>
                    <td>
						<label class="layui-form-label;text-align:right;">
    					$!date.format('yyyy-MM-dd',$!{bvVouEmployInfoPage.inputDate})
                        </label>
					</td>
				</tr>

				<tr>
				##领用日期
					<td class="textRight">#springMessage('table.bvVouEmployInfo.employDate')</td>
                    <td>
##						<div type="date" field="employDate" defaultVal="$!{bvVouEmployInfoPage.employDate}" data-required="true"></div>
						<input type="text" name="employDate" data-name="employDate" class="layui-input bt-biz-dateType" data-type="date"
							   data-biz-name="employDate" lay-verify="required" data-today="true">
					</td>
					##领用人
					<td class="textRight">#springMessage('table.bvVouEmployInfo.employPerson')</td>
					<td>
						<input type="text" id="employPerson" name="employPerson" lay-verify="required|strlength" class="layui-input bt-input-inline"
                            data-maxlength="10"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvVouEmployInfo.employPerson')">
                    </td>
				</tr>
				<tr>
					##领用金额
					<td class="textRight">#springMessage('table.bvVouEmployInfo.vouMoney')</td>
					<td>
						<input type="text" id="vouMoney" name="vouMoney" lay-verify="required" class="layui-input bt-input-inline"
							autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvVouEmployInfo.vouMoney')">
                    </td>
					##
						<td class="textRight"></td>
						<td>
						</td>
                </tr>
				
                <tr>
					##使用说明
					<td class="textRight">#springMessage('table.bvVouEmployInfo.rmk')</td>
                    <td colspan="5">
						<textarea name="rmk" placeholder="#springMessage('table.bvVouEmployInfo.rmk')"
                                  lay-verify="strlength" data-maxlength="100" class="layui-textarea" style="width:512px"></textarea>
					</td>
				</tr>
				
        	</tbody>
        </table>

        <div class="layui-form-submit-adaptive">
            <div style="text-align: center;">
				<button class="layui-btn" lay-submit="" type="button" lay-filter="submit">#springMessage('common.button.submit')</button>
				<button class="layui-btn layui-btn-primary" type="button" name="revert">#springMessage('common.button.revert')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/blankvou/bvVouEmployInfo.add.js?_btv=${resourceVersion}"></script>
</html>
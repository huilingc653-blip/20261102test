<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="get">
		<input id="id" name="id" type="hidden" value="$!{bvStorageBoxPage.id}">
		   <table class="layui-table">
			<tbody>
        	<tr>
				<td class="textRight" width="15%">#springMessage('table.bvStorageBox.code')</td>
				<td width="35%"><input type="text" id="code" name="code" autocomplete="off" class="layui-input" lay-verify="required|codeCheck|strlength"
                                       data-maxlength="10" placeholder="#springMessage('table.bvStorageBox.code')"></td>
				<td class="textRight"  width="15%">#springMessage('table.bvStorageBox.name')</td>
				<td width="35%"><input style="display: inline;" type="text" id="name" name="name" autocomplete="off" class="layui-input" lay-verify="required|strlength"
                                       data-maxlength="50" placeholder="#springMessage('table.bvStorageBox.name')"><span data-toggle="i18n" data-key-id="$!{bvStorageBoxPage.id}"/></td>
				</tr>
				<tr>
				<td class="textRight">#springMessage('table.bvStorageBox.address')</td>
				<td ><input type="text" id="address" name="address" autocomplete="off" class="layui-input" lay-verify="required|strlength"
                            data-maxlength="100" placeholder="#springMessage('table.bvStorageBox.address')"></td>
				<td class="textRight"><span class="pl"><span class="required-icon">*</span>#springMessage('table.bvStorageBox.corpId')</td>
				<td>
					 <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                                data-biz-type="corp"
                                data-type="selectTree"
                                data-name="corpId"
                                data-scope="all"
							    data-required="true"
								data-callback="bt.funUserReset"
								data-placeholder="#springMessage('table.bvStorageBox.corpId')"
								data-callback="getCorpId"
								data-resource="bill:blankvou:bvStorageBox:query">
        				 </div>
                         </div>
				         </td>
			    </tr>
			<tr>
				<td class="textRight">#springMessage('table.bvStorageBox.keeperUid')</td>	
				<td >
				    <div class="layui-input-inline">
                       <div class="bt-biz-user" 
					           data-biz-name="userName" 
					           data-corp-value="" 
					           data-corp-id="" 
					           data-corp-name="corpId" 
					           data-name="keeperUid"
                               data-required="true"
					           data-type="select"
					           data-resource='bill:blankvou:bvVouInput:save'>
				         </div>
				         </div>
				         </td>
				<td class="textRight">#springMessage('table.bvStorageBox.rmk')</td>
				<td ><input class="layui-input" name="rmk" id="rmk" autocomplete="off"
                            lay-verify="strlength" data-maxlength="100"
							placeholder="#springMessage('table.bvStorageBox.rmk')"></input></td>
            </tr>
           </tbody>
        </table>
        <div class="layui-form-submit-adaptive">
            <div style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </div>
        </div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/blankvou/bvStorageBox.add.js?_btv=${resourceVersion}"></script>
</html>
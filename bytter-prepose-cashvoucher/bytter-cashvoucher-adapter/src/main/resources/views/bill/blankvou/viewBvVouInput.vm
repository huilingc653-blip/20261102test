<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
	<table class="layui-table">
		<tbody>
		<tr>
		##所属单位
			<td class="textRight">#springMessage('table.bvVouInput.corpId')</td>
			<td width="35%">
				$!{bvVouInputPage.corpName}
			</td>
		##所属账户
			<td class="textRight">#springMessage('table.bvVouInput.bankAcc')</td>
			<td width="35%">
				$!{bvVouInputPage.bankAcc}
			</td>
		</tr>
		<tr>
		##币别
			<td class="textRight">#springMessage('table.fbsBudgetDetail.curId')</td>
			<td>
				$!{bvVouInputPage.curName}
			</td>
		##状态
			<td class="textRight">#springMessage('table.bvVouInput.status')</td>
			<td>
				$!{bvVouInputPage.statusName}
			</td>
		</tr>
		<tr>
		##所属银行
			<td class="textRight">#springMessage('table.bvVouInput.bankId')</td>
			<td>
				$!{bvVouInputPage.bankName}
			</td>
		##凭证种类
			<td class="textRight">#springMessage('table.bvVouInput.vouTid')</td>
			<td>
				$!{bvVouInputPage.voucherTypeName}
			</td>
		</tr>
		<tr>
		##所属库箱
			<td class="textRight">#springMessage('table.bvVouInput.sboxId')</td>
			<td>
				$!{bvVouInputPage.storageBoxName}
			</td>
		##编码规则
			<td class="textRight">#springMessage('table.bvVouInput.ruleNo')</td>
			<td>
				$!{bvVouInputPage.ruleNo}
			</td>
		</tr>
		<tr>
		##起始号码
			<td class="textRight">#springMessage('table.bvVouInput.beginNo')</td>
			<td>
				$!{bvVouInputPage.beginNo}
			</td>
		##截止号码
			<td class="textRight">#springMessage('table.bvVouInput.endNo')</td>
			<td>
				$!{bvVouInputPage.endNo}
			</td>
		</tr>
		<tr>
		##份数
			<td class="textRight">#springMessage('table.bvVouInput.numSize')</td>
			<td>
				$!{bvVouInputPage.numSize}
			</td>
		##购入日期
			<td class="textRight">#springMessage('table.bvVouInput.inputDate')</td>
			<td>
				$!date.format('yyyy-MM-dd',$!{bvVouInputPage.inputDate})
			</td>
		</tr>
		<tr>
		##备注
			<td class="textRight">#springMessage('table.bvVouInput.rmk')</td>
			<td>
				$!{bvVouInputPage.rmk}
			</td>
		##状态
			<td class="textRight"></td>
			<td>
			</td>
		</tr>
		</tbody>
	</table>
	<div>
		<table id="appTable" class="layui-table layui-form" style="width:100%;">
			<thead>
			<tr>
				<th>#springMessage('table.bvLog.logType')</th>
				<th>#springMessage('table.bvLog.msg')</th>
				<th>#springMessage('table.bvLog.createName')</th>
				<th>#springMessage('table.bvLog.createBy')</th>
				<th>#springMessage('table.bvLog.createDate')</th>
			</tr>
			</thead>
			<body>
				#if($!bvlogList)
					#foreach($bvLog in $bvlogList)
					<tr>
						<td>$!{bvLog.logTypeName}</td>
						<td>#springMessage($!{bvLog.msg})</td>
						<td>$!{bvLog.createName}</td>
						<td>$!{bvLog.createBy}</td>
						<td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{bvLog.createDate})</td>
					</tr>
					#end
				#end
			</body>
		</table>
	</div>
</form>
	#parse("views/common/footer.vm")
</body>
</html>

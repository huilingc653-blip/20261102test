<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
		<table class="layui-table">
			<tbody>      
           <tr>
               <td class="textRight"> #springMessage('table.bvPrintFormat.voucherType')</td>
                    <td width="25%">
					<div class="layui-inline">
						<div id="voucherType" ></div>
                    </div>
					</td>            
           
                <td class="textRight">#springMessage('table.bvPrintFormat.fmtNo')</td>
                    <td width="25%">
					<div class="layui-inline">
                        <input type="text" name="likes_fmtNo"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvPrintFormat.fmtNo')">
                    </div>
            	</td>
            
                <td>#springMessage('table.bvPrintFormat.fmtName')</td>
                    <td><div class="layui-inline">
                        <input type="text" name="likes_fmtName"
                                autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvPrintFormat.fmtName')">
                    </div>
					</td>
            </tr>
			<tr>
				<td colspan="6" style="text-align: center;">		
        <div class="layui-inline">
            <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
        </div>
				</td>
			</tr>
		</tbody>
		</table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
        <th>#springMessage('table.bvPrintFormat.fmtNo')</th>
        <th>#springMessage('table.bvPrintFormat.fmtName')</th>
        <th>#springMessage('table.bvPrintFormat.voucherType')</th>
        <th>#springMessage('blankvou.printScene')</th>
        <th>#springMessage('table.bvPrintFormat.paperSize')</th>
        <th>#springMessage('table.bvPrintFormat.validSign')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/blankvou/bvPrintFormat.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('bill.blankvou.printInfo.title')</legend>
        </fieldset>
		<table class="layui-table layui-form" style="width: 100%;">
			<tbody >
				<tr >
					<td width="15%" class="textRight">#springMessage('table.bvPrintFormat.fmtNo')</td>
                    <td width="35%">$!{bvPrintFormatPage.fmtNo}</td>
                    <td width="15%" class="textRight"></td>
                    <td width="35%"></td>
                </tr>
				<tr >
                    <td width="15%" class="textRight">#springMessage('table.bvPrintFormat.fmtName')</td>
                    <td width="35%">$!{bvPrintFormatPage.fmtName}</td>
					<td width="15%" class="textRight">#springMessage('table.bvPrintFormat.paperSize')</td>
                    <td width="35%">$!{bvPrintFormatPage.paperSize}</td>
                </tr>
				<tr >
					<td width="15%" class="textRight">#springMessage('table.bvPrintFormat.voucherType')</td>
                    <td width="35%">$!{bvPrintFormatPage.voucherType}</td>
					<td width="15%" class="textRight">#springMessage('blankvou.printScene')</td>
                    <td width="35%">$!{bvPrintFormatPage.sceneName}</td>
                </tr>
				<tr >
                    <td width="15%" class="textRight">#springMessage('table.bvPrintFormat.leftBorder')</td>
                    <td width="35%">$!{bvPrintFormatPage.leftBorder}</td>
					<td width="15%" class="textRight">#springMessage('table.bvPrintFormat.upBorder')</td>
                    <td width="35%">$!{bvPrintFormatPage.upBorder}</td>
                </tr>
				<tr >
                    <td width="15%" class="textRight">#springMessage('table.bvPrintFormat.validSign')</td>
                    <td width="35%">$!{bvPrintFormatPage.validSignName}</td>
                    <td width="15%" class="textRight">#springMessage('bill.accebill.backgroundImage')</td>
                    <td width="35%">
                        #if($bvPrintFormatPage.backgroundImage && $bvPrintFormatPage.backgroundImage ne "" )
                            <img id="imger" src="$!{basePath}/download/attachment?id=$!{bvPrintFormatPage.backgroundImage}" width="60px" height="30px"/>
                        #else
                            <img id="imger"/>
                        #end
                    </td>
                </tr>
            </tbody>
        </table>
		
    	<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('bill.blankvou.printMatchRule.title')</legend>
        </fieldset>
		<div>
        <table id="printMRTable" class="layui-table layui-form" style="width:100%;">
            <thead>
				<tr>
                <th>#springMessage('table.bvPrintMatchRule.code')</th>
                <th>#springMessage('table.bvPrintMatchRule.matchVal')</th>
                <th>#springMessage('table.bvPrintMatchRule.matchRule')</th>
                <th>#springMessage('table.bvPrintFormat.validSign')</th>
				</tr>
            </thead>
			<body>
				#if($!{bvPrintFormatPage.printMR})
				#foreach($printMR in ${bvPrintFormatPage.printMR})
				<tr>
                <td>$!{printMR.codeName}</td>
                <td>$!{printMR.matchVal}</td>
                <td>$!{printMR.matchRuleName}</td>
                <td>$!{printMR.validSignName}</td>
				</tr>
                #end
                #end
            </body>
        </table>
		</div>
    	<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('bill.blankvou.printdtl.title')</legend>
        </fieldset>
        <div>
		<table id="printFmtDtlTable" class="layui-table layui-form" style="width: 100%;">
            <thead>
                <tr>
                <th>#springMessage('table.bvPrintFormatDtl.code')</th>
                <th>#springMessage('table.bvPrintFormatDtl.name')</th>
                <th>#springMessage('table.bvPrintFormatDtl.printCoord')</th>
                <th>#springMessage('table.bvPrintFormatDtl.isPrint')</th>
                <th>#springMessage('table.bvPrintFormatDtl.fontSize')</th>
                <th>#springMessage('table.bvPrintFormatDtl.fontSpace')</th>
                <th>#springMessage('table.bvPrintFormatDtl.charSizeBr')</th>
                <th>#springMessage('table.bvPrintFormatDtl.prefixVal')</th>
                <th>#springMessage('table.bvPrintFormatDtl.otherVal')</th>
                <th>#springMessage('table.bvPrintFormatDtl.valPrintType')</th>
                <th>#springMessage('table.bvPrintFormatDtl.valPrintFmt')</th>
				</tr>
           </thead>
		   <body>
				#if($!{bvPrintFormatPage.printFmtDtl})
				#foreach($printFmtDtl in ${bvPrintFormatPage.printFmtDtl})
				<tr>
                <td>#springMessage($!{printFmtDtl.codeName})</td>
                <td>$!{printFmtDtl.name}</td>
                <td>$!{printFmtDtl.printCoord}</td>
                <td>$!{printFmtDtl.isPrintName}</td>
                <td>$!{printFmtDtl.fontSize}</td>
                <td>$!{printFmtDtl.fontSpace}</td>
                <td>$!{printFmtDtl.charSizeBr}</td>
                <td>$!{printFmtDtl.prefixVal}</td>
                <td>$!{printFmtDtl.otherVal}</td>
                <td>$!{printFmtDtl.valPrintTypeName}</td>
                <td>$!{printFmtDtl.valPrintFmtName}</td>
				</tr>
                #end
                #end
            </body>
    	</table>
		</div>
		<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('bill.logInfo.title')</legend>
        </fieldset>
		<div>
		<table class="layui-table layui-form" style="width: 100%;">
            <thead>
            <tr>
                <th>#springMessage('table.bvLog.logType')</th>
                <th>#springMessage('table.bvLog.msg')</th>
                <th>#springMessage('table.bvLog.createName')</th>
                <th>#springMessage('table.bvLog.createBy')</th>
                <th>#springMessage('table.bvLog.createDate')</th>
            </tr>
            </thead>
		   <body>
				#if($!bvlogList)
				#foreach($logInfo in $bvlogList)
				<tr>
                <td>$!{logInfo.logTypeName}</td>
                <td>#springMessage($!{logInfo.msg})</td>
                <td>$!{logInfo.createName}</td>
                <td>$!{logInfo.createBy}</td>
                <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.createDate})</td>
				</tr>
                #end
                #end
            </body>
    	</table>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
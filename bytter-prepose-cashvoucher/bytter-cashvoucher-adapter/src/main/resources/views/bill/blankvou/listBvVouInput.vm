<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
        ##所属单位
            <td class="textRight">#springMessage('table.bvVouInput.corpId')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-scope="all"
                         data-callback="corpCallback"
                         data-resource="bill:blankvou:bvVouInput:query">
                    </div>
                </div>
            </td>
        ##所属银行
            <td class="textRight">#springMessage('table.bvVouInput.bankId')</td>
            <td width="25%">
                <div class="selectBankId layui-input-inline"></div>
            </td>
        ##所属库箱
            <td class="textRight">#springMessage('table.bvVouInput.sboxId')</td>
            <td>
                <div class="selectSboxId layui-input-inline"></div>
            </td>
        </tr>
        <tr>
        ##所属账户
            <td class="textRight">#springMessage('table.bvVouInput.bankAcc')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" id="bankAcc" name="likes_bankAcc" class="bank layui-input">
                </div>
            </td>
        ##凭证种类
            <td class="textRight">#springMessage('table.bvVouInput.vouTid')</td>
            <td>
                <div class="selectVouTid layui-input-inline"></div>
            </td>
        ##购入日期
            <td class="textRight">#springMessage('table.bvVouInput.inputDate')</td>
            <td>
                <div class="layui-inline">
                <input type="text" name="ged_inputDate" data-name="ged_inputDate" class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date">
                </div>
                ~
                <div class="layui-inline">
                <input type="text" name="led_inputDate"　data-name="led_inputDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date">
                </div>
            </td>
        </tr>

##            #if($shiro.hasPermission("bill:blankvou:bvVouInput:query"))
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" type="button" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" type="button" class="layui-btn layui-btn-primary" onclick="resetUpdate()">#springMessage('common.button.reset')</button>
                </td>
            </tr>
##            #end
        </tbody>
    </table>
</form>
##    #if($shiro.hasPermission("bill:blankvou:bvVouInput:query"))
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.bvVouInput.vouTid')</th>
            <th>#springMessage('table.bvVouInput.bankId')</th>
            <th>#springMessage('table.bvVouInput.bankAcc')</th>
            <th>#springMessage('table.fbsBudgetDetail.curId')</th>
            <th>#springMessage('table.bvVouInput.corpId')</th>
            <th>#springMessage('table.bvVouInput.ruleNo')</th>
            <th>#springMessage('table.bvVouInput.beginNo')</th>
            <th>#springMessage('table.bvVouInput.endNo')</th>
            <th>#springMessage('table.bvVouInput.numSize')</th>
            <th>#springMessage('table.bvVouInput.sboxId')</th>
            <th>#springMessage('table.bvVouInput.inputDate')</th>
            <th>#springMessage('table.bvVouInput.status')</th>
            <th>#springMessage('table.bvVouInput.rmk')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
##    #end
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/blankvou/bvVouInput.list.js?_btv=${resourceVersion}"></script>
</html>

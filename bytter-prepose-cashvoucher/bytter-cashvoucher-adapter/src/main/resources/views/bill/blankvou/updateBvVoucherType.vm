<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input type="hidden"  id="initDataSource" value="$!{bvVoucherTypePage.dataSource}"></input>
		<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
        <legend>#springMessage('bill.blankvou.bvVoucherType.title')</legend>
        </fieldset>	
				<input id="id" name="id" type="hidden" value="$!{bvVoucherTypePage.id}">
				<input id="initCode" name="initCode" type="hidden" value="$!{bvVoucherTypePage.code}">
		    <table class="layui-table">
			<tbody>
			<tr>
				<td class="textRight" width="15%">#springMessage('table.bvVoucherType.code')</td>
				<td width="35">
						<input  type="text" id="code" name="code" autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvVoucherType.code')"
							   value="$!{bvVoucherTypePage.code}"  lay-verify="required|checkCode|strlength" data-maxlength="10">
				</td>        
        		<td class="textRight"  width="15%">#springMessage('table.bvVoucherType.name')</td>
				<td width="35">           
				<input type="text" style="display: inline;" id="name" name="name" autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvVoucherType.name')" value="$!{bvVoucherTypePage.name}" lay-verify="required|strlength" data-maxlength="50">
					<span data-toggle="i18n" data-key-id="$!{bvVoucherTypePage.id}"/>
		         </td>
		   </tr>
		   <tr>
				<td class="textRight">#springMessage('table.bvVoucherType.isInbox')</td>
				<td>
				<div class="bt-biz-dict" data-group="sf_yn" data-name="isInbox" data-type="radio" data-required="true" data-defaultvalue="$!{bvVoucherTypePage.isInbox}"></div>
				 </td>          		
				<td class="textRight" >#springMessage('table.bvVoucherType.dataSource')</td>
				<td>
					<input type="text" id="dataSource" name="dataSource"  autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvVoucherType.dataSource')" value="$!{bvVoucherTypePage.dataSource}" onblur="checkDataSource()" lay-verify="strlength|checkDataSource" data-maxlength="32">
				 </td>
				 </tr>
				 <tr>
				<td class="textRight">#springMessage('table.bvVoucherType.validSign')</td>
				<td>
					<div class="bt-biz-dict" data-group="sf_yn" data-name="bvValidSign" data-type="radio" data-required="true" data-defaultvalue="$!{bvVoucherTypePage.validSign}"></div>
                </td>    
        		<td class="textRight">#springMessage('table.bvVoucherType.rmk')</td>
				<td>
				      <input type="text" id="rmk" name="rmk" autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvVoucherType.rmk')" value="$!{bvVoucherTypePage.rmk}" lay-verify="strlength" data-maxlength="100">
				</td>
				</tr>
				</tbody>
             </table>
			 <div >
			 <fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
				<legend>#springMessage('blankvou.printScene.title')</legend>
			 </fieldset>
			 <table id="sceneDataTable" class="layui-table layui-form" style="width:100%;">
				<thead>
					<tr>
                    <th>#springMessage('blankvou.printScene.name')</th>
                    <th>#springMessage('table.bvVoutypeDataField.validSign')</th>
                    <th>#springMessage('common.table.thead.operation')</th>
					</tr>
                </thead>
              </table>	
             </div>
			 <div >
    		<fieldset class="layui-elem-field layui-field-title" style="margin-top: 20px;">
            <legend>#springMessage('bill.blankvou.bvVoutypeDataField.title')</legend>
            </fieldset>	
        	<table id="fieldDataTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('table.bvVoutypeDataField.fieldCode')</th>
                <th>#springMessage('table.bvVoutypeDataField.fieldName')</th>
        		<th>#springMessage('table.bvVoutypeDataField.dataType')</th>
        		<th>#springMessage('table.bvVoutypeDataField.dictGroup')</th>
                <th>#springMessage('table.bvVoutypeDataField.validSign')</th>
                <th>#springMessage('table.bvVoutypeDataField.isShow')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
           </table>	
             </div>
           <br/>
			<div class="layui-form-submit-adaptive">
				<div style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
                    <button type="reset" class="layui-btn layui-btn-primary" id="reset">#springMessage('common.button.reset')</button>
                </div>
            </div>
	</form>
	
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/blankvou/bvVoucherType.edit.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<div >
		<table class="layui-table layui-form" style="width: 100%;">
			<tbody >
				#if($!vouTypeInfo&&$!{vouTypeInfo.isInbox} eq '1')
				<tr >
					<td width="15%" class="textRight">#springMessage('table.bvPrintVouOpinfo.vouNo')</td>
                    <td width="35%">$!{vouOpInfo.vouNo}</td>
                    <td width="15%" class="textRight"></td>
                    <td width="35%"></td>
                </tr>
				#end
				<tr >
					<td width="15%" class="textRight">#springMessage('table.bvPrintVouOpinfo.printSize')</td>
                    <td width="35%">$!{vouOpInfo.printSize}</td>
                    <td width="15%" class="textRight">#springMessage('table.bvPrintVouOpinfo.opName')</td>
                    <td width="35%">$!{vouOpInfo.updateName}</td>
                </tr>
				<tr >
					<td width="15%" class="textRight">#springMessage('table.bvPrintVouOpinfo.opDate')</td>
                    <td width="35%">$!date.format('yyyy-MM-dd HH:mm:ss',$!{vouOpInfo.updateDate})</td>
                    <td width="15%" class="textRight"></td>
                    <td width="35%"></td>
                </tr>
				#if($!vtDaFieldList)
					#set($name = "num")
					#set($num = 0)
        		#foreach($vtDaField in $vtDaFieldList)
					
        			#if($vtDaField.isShow eq '1')
						
					#set($num = $num + 1)
					#if($num%2 eq 1)
						<tr >
					#end
					<td width="15%" class="textRight">#springMessage($!{vtDaField.fieldName})</td>
                    <td width="35%">$!{vtDaField.fieldVal}</td>
					#if($num%2 eq 0)
						</tr>
					#end
					#end
				#end
					#if($num%2 eq 1)
						<td width="15%" class="textRight"></td>
						<td width="35%"></td>
						</tr>
					#end
        		#end
            </tbody>
        </table>
        </div>
		<div >
		<table class="layui-table layui-form" style="width: 100%;">
            <thead>
            <tr>
                <th>#springMessage('table.bvLog.logType')</th>
                <th>#springMessage('table.bvLog.msg')</th>
                <th>#springMessage('table.bvLog.createName')</th>
                <th>#springMessage('table.bvLog.createBy')</th>
                <th>#springMessage('table.bvLog.createDate')</th>
            </tr>
            </thead>
		   <body>
				#if($!bvlogList)
				#foreach($logInfo in $bvlogList)
				<tr>
                <td>$!{logInfo.logTypeName}</td>
                <td>#springMessage($!{logInfo.msg})</td>
                <td>$!{logInfo.createName}</td>
                <td>$!{logInfo.createBy}</td>
                <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.createDate})</td>
				</tr>
                #end
                #end
            </body>
    	</table>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{id}">
		<input id="ids" name="ids" type="hidden" value="$!{ids}">
		
		<div class="layui-form-item">
			<div class="layui-inline">
				##原因
				<label class="layui-form-label"><span style="color:red;font-size: 14px;font-weight:bold;vertical-align: middle;">*</span>#springMessage('table.bvVouEmployInfo.reason')</label>
				<div class="layui-input-inline">
					<textarea name="reason" lay-verify="required|strlength" placeholder="#springMessage('table.bvVouEmployInfo.reason')"
                              maxlength="1000" class="layui-textarea" style="width:512px"></textarea>
				</div>
			</div>
		</div>

        <div class="layui-form-submit-adaptive">
            <div style="text-align: center;">
				<button class="layui-btn" lay-submit="" type="button" lay-filter="$!{submit}">#springMessage('common.button.submit')</button>
				<button class="layui-btn layui-btn-primary" type="button" name="revert">#springMessage('common.button.revert')</button>
			</div>
		</div>
		
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/blankvou/bvpayeechequecheck.retreatOrTovoid.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post" id="fromVerify">
		<div class="layui-collapse">
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.blankvou.printInfo.title')</h2>
		<div class="layui-colla-content layui-show">
		<input id="id" name="id" type="hidden" value="$!{bvPrintFormatPage.id}">
		<table class="layui-table">
			<tbody>
			<tr>
                <td class="textRight">#springMessage('table.bvPrintFormat.fmtNo')</td>
				<td width="40%">
					<input id="fmtNo" name="fmtNo" type="hidden" value="$!{fmtNo}">
                    $!{fmtNo}
				<!--number-->
				#*
				*	<input type="text" id="fmtNo" name="fmtNo" lay-verify="required|fmtNoCheck"
				*	 autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvPrintFormat.fmtNo')" value="$!{bvPrintFormatPage.fmtNo}">
				*#
                </td>
                <td class="textRight"></td>
				<td width="40%">
                </td>
            </tr>
			<tr>
                <td class="textRight">#springMessage('table.bvPrintFormat.fmtName')</td>
				<td width="40%">
				##打印格式说明
				<!--number-->
					<input type="text" id="fmtName" name="fmtName" lay-verify="required|strlength" data-maxlength="50" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvPrintFormat.fmtName')" value="$!{bvPrintFormatPage.fmtName}">
                </td>
                <td class="textRight">#springMessage('table.bvPrintFormat.paperSize')</td>
				<td width="40%">
				##纸张大小
				<!--number-->
					<input type="text" id="paperSize" name="paperSize" lay-verify="required|coordVfy|strlength" data-maxlength="20" 
					 autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvPrintFormat.paperSize')***,***" value="$!{bvPrintFormatPage.paperSize}">
                </td>
            </tr>
			<tr>
                <td class="textRight">#springMessage('table.bvPrintFormat.voucherType')</td>
				<td width="40%">
				##凭证类型ID
					<div id="voucherType"></div>
					<input id="vouTid" type="hidden" value="$!{bvPrintFormatPage.vouTid}">
                </td>
                <td class="textRight">#springMessage('blankvou.printScene')</td>
                <td width="40%">
    				##凭证类型ID
    				<div id="voucherTypeScene" ></div>
					<input id="sceneId" type="hidden" value="$!{bvPrintFormatPage.sceneId}">
				</td>
            </tr>
			<tr>
                <td class="textRight">#springMessage('table.bvPrintFormat.leftBorder')</td>
				<td width="40%">
				##左边距
				<!--number-->
					<input type="text" data-id="leftBorder" data-name="leftBorder" 
					decimal="0" autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.bvPrintFormat.leftBorder')" value="$!{bvPrintFormatPage.leftBorder}">
                </td>
                <td class="textRight">#springMessage('table.bvPrintFormat.upBorder')</td>
				<td width="40%">
				##下边距
				<!--number-->
					<input type="text" data-id="upBorder" data-name="upBorder" 
					decimal="0" autocomplete="off" class="layui-input bt-biz-moneyType" placeholder="#springMessage('table.bvPrintFormat.upBorder')" value="$!{bvPrintFormatPage.upBorder}">
                </td>
            </tr>
			<tr>
                <td class="textRight">#springMessage('table.bvPrintFormat.validSign')</td>
				<td width="40%">
				## 有效标志
					#set ($mymap = {"field":"valSign","type":"radio","typeGroupCode":"sf_yn","defaultVal":"$!{bvPrintFormatPage.validSign}","title":"table.bvPrintFormat.validSign"})
					#set ($formB = $dictSelect.instance($mymap))
					${formB.html()}
                </td>
                <td class="textRight">#springMessage('bill.accebill.backgroundImage')</td>
                <td width="40%">
                    <input id="backgroundImage" name="backgroundImage" type="hidden" value="$!{bvPrintFormatPage.backgroundImage}">
					#if($bvPrintFormatPage.backgroundImage && $bvPrintFormatPage.backgroundImage ne "")
                        <img id="imger" src="$!{basePath}/download/attachment?id=$!{bvPrintFormatPage.backgroundImage}" width="60px" height="30px"/>
					#else
                        <img id="imger"/>
					#end
                    <input type="file" lay-ext="jpg|png|gif" name="file" class="layui-upload-file">
                    <font color=red>#springMessage('bill.accebill.img.checkInfo')</font>
                </td>
            </tr>
			</tbody>
		</table>
    	</div>
  		</div>
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.blankvou.printMatchRule.title')</h2>
		<div class="layui-colla-content">
        <table id="printMRTable" class="layui-table layui-form" style="width:100%;">
            <thead>
            <tr>
                <th>#springMessage('table.bvPrintMatchRule.code')</th>
                <th>#springMessage('table.bvPrintMatchRule.matchVal')</th>
                <th>#springMessage('table.bvPrintMatchRule.matchRule')</th>
                <th>#springMessage('table.bvPrintFormat.validSign')</th>
                <th>#springMessage('common.table.thead.operation')</th>
            </tr>
            </thead>
        </table>
		</div>
  		</div>
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('bill.blankvou.printdtl.title')</h2>
		<div class="layui-colla-content">
		<table id="printFmtDtlTable" class="layui-table layui-form" style="width: 100%;">
            <thead>
                <tr>
                <th>#springMessage('table.bvPrintFormatDtl.code')</th>
                <th>#springMessage('table.bvPrintFormatDtl.name')</th>
                <th>#springMessage('table.bvPrintFormatDtl.printCoord')</th>
                <th>#springMessage('table.bvPrintFormatDtl.isPrint')</th>
                <th>#springMessage('table.bvPrintFormatDtl.fontSize')</th>
                <th>#springMessage('table.bvPrintFormatDtl.fontSpace')</th>
                <th>#springMessage('table.bvPrintFormatDtl.charSizeBr')</th>
                <th>#springMessage('table.bvPrintFormatDtl.prefixVal')</th>
                <th>#springMessage('table.bvPrintFormatDtl.otherVal')</th>
                <th>#springMessage('table.bvPrintFormatDtl.valPrintType')</th>
                <th>#springMessage('table.bvPrintFormatDtl.valPrintFmt')</th>
                <th>#springMessage('common.table.thead.operation')</th>
				</tr>
           </thead>
    	</table>
		</div>
  		</div>
  		</div>
		<span style="color:red">
		#springMessage('bill.bvPrintFormat.notice')
		</span>
		<br>
		<br>
        <div class="layui-form-submit-adaptive">
            <div style="text-align: center;">
				<button class="layui-btn" lay-submit="" lay-filter="submit">#springMessage('common.button.submit')</button>
				<button type="button" class="layui-btn" onclick="printViewTest()">#springMessage('common.button.preview')</button>
				<button type="reset" onclick="resetFun()" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
			</div>
		</div>
	</form>
	<object  id="LODOP_OB" classid="clsid:2105C259-1E0C-4534-8141-A753534CB4CA" width=0 height=0> 
       <embed id="LODOP_EM" type="application/x-print-lodop" width=0 height=0></embed>
	</object>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/plugins/Lodop/LodopFuncs.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/blankvou/bvLodopPrint.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/blankvou/bvPrintFormat.copy.js?_btv=${resourceVersion}"></script>
</html>
    <!DOCTYPE html>
    <html lang="en">
    <head>
        #parse("views/common/head.vm")
    </head>
    <body>   	
        <form id="searchForm" class="layui-form input150-container"> 			           
				<table class="layui-table">
				<tbody>
					<tr>
    			##持票单位
				 <td class="textRight">#springMessage('table.bvStorageBox.corpId')</td>
						<td width="25%">
						 <div class="layui-inline">
                         <div class="bt-biz-corp"
                                data-tree-type="check"
                                data-biz-type="corp"
                                data-type="selectTree"
                                data-name="ins_corpId"
                                data-scope="all"
								data-placeholder="#springMessage('table.bvStorageBox.corpId')"
								data-callback="bt.funUserReset"
								data-resource="bill:blankvou:bvStorageBox:query"
    							>
        					</div>
                    </div>
                        </td>               			 
                 <td class="textRight">#springMessage('table.bvStorageBox.code')</td>
					<td width="25%">

                            <input type="text" name="likes_code"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvStorageBox.code')">

                        </td>				 
               <td>#springMessage('table.bvStorageBox.keeperUid')</td>
               <td width="25%">
				<div class="bt-biz-user" 
					data-biz-name="userName" 
					data-corp-value="" 
					data-corp-id="" 
					data-corp-name="ins_corpId" 
					data-name="eqs_keeperUid" 
					data-type="select" 
					data-resource='bill:blankvou:bvVouInput:save' ></div>
			   </td>		 				
				<tr>
                    <td class="textRight">#springMessage('table.bvStorageBox.validSign')</td>                   
					<td>
                        <div class="bt-biz-dict" data-type="select" data-group="bvstorageBox_status" data-name="eqs_validSign" ></div>
                    </td>	
					<td><td></td></td>
					<td><td></td></td>
                </tr>				
				 
##				#if($shiro.hasPermission("bill:blankvou:bvStorageBox:query"))
    			<tr>
                    <td colspan="6" style="text-align: center;">		
						<button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
						<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>				
					</td>
                </tr>
##				#end
      
		</tbody>
		</table>
        </form>
    	
##    #if($shiro.hasPermission("bill:blankvou:bvStorageBox:query"))
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>       
            <th>#springMessage('table.bvStorageBox.code')</th>
            <th>#springMessage('table.bvStorageBox.name')</th>
            <th>#springMessage('table.bvStorageBox.corpId')</th>
            <th>#springMessage('table.bvStorageBox.keeperUid')</th>
            <th>#springMessage('table.bvStorageBox.address')</th>
            <th>#springMessage('table.bvStorageBox.validSign')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
##	#end
    #parse("views/common/footer.vm")
    </body>
    <script src="${basePath}/static/modules/bill/blankvou/bvStorageBox.list.js?_btv=${resourceVersion}"></script>
    </html>

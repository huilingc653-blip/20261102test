<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
	<h2 class="layui-colla-title">#springMessage('table.bvVouInfoDtl.title')</h2>
	<table class="layui-table">
		<tbody>
		<tr>
		##所属单位
			<td class="textRight">#springMessage('table.bvVouInfoDtl.corpId')</td>
			<td width="35%">
				$!{bvVouInfoDtlPage.corpName}
			</td>
		##所属库箱
			<td class="textRight">#springMessage('table.bvVouInfoDtl.sboxId')</td>
			<td width="35%">
				$!{bvVouInfoDtlPage.storageBoxName}
			</td>
		</tr>
		<tr>
		##所属账户
			<td class="textRight">#springMessage('table.bvVouInfoDtl.bankAcc')</td>
			<td width="35%">
				$!{bvVouInfoDtlPage.bankAcc}
			</td>
		##所属银行
			<td class="textRight">#springMessage('table.bvVouInfoDtl.bankId')</td>
			<td width="35%">
				$!{bvVouInfoDtlPage.bankName}
			</td>
		</tr>
		<tr>
		##币别
			<td class="textRight">#springMessage('table.fbsBudgetDetail.curId')</td>
			<td>
				$!{bvVouInfoDtlPage.curName}
			</td>
		##凭证种类
			<td class="textRight">#springMessage('table.bvVouInfoDtl.vouTid')</td>
			<td width="35%">
				$!{bvVouInfoDtlPage.voucherTypeName}
			</td>
		</tr>
		<tr>
		##凭证编号
			<td class="textRight">#springMessage('table.bvVouInfoDtl.vouNo')</td>
			<td width="35%">
				$!{bvVouInfoDtlPage.vouNo}
			</td>
		##凭证状态
			<td class="textRight">#springMessage('table.bvVouInfoDtl.vouStatus')</td>
			<td width="35%">
				$!{bvVouInfoDtlPage.vouStatusName}
			</td>
		</tr>
		<tr>
		##购入日期
			<td class="textRight">#springMessage('table.bvVouInfoDtl.inputDate')</td>
			<td width="35%">
				$!date.format('yyyy-MM-dd',$!{bvVouInfoDtlPage.inputDate})
			</td>
		##凭证备注
			<td class="textRight">#springMessage('table.bvVouInfoDtl.bvVouInfoDtlRmk')</td>
			<td width="35%">
				$!{bvVouInfoDtlPage.rmk}
			</td>
		</tr>
		<tr>
		##入库人
			<td class="textRight">#springMessage('table.bvVouInfoDtl.createNameNickName')</td>
			<td width="35%">
				$!{bvVouInfoDtlPage.createName}
			</td>
		##
			<td class="textRight"></td>
			<td width="35%">
			</td>
		</tr>
		</tbody>
	</table>

	#if($isUse)
		<h2 class="layui-colla-title">#springMessage('table.bvVouInfoDtlUse.title')</h2>
		<table class="layui-table">
			<tbody>
			<tr>
			##领用日期
				<td class="textRight">#springMessage('table.bvVouEmployInfo.employDate')</td>
				<td width="35%">
					$!{bvVouEmployInfoVo.employDate}
				</td>
			##领用人
				<td class="textRight">#springMessage('table.bvVouEmployInfo.employPerson')</td>
				<td width="35%">
					$!{bvVouEmployInfoVo.employPerson}
				</td>
			</tr>
			<tr>
			##领用金额
				<td class="textRight">#springMessage('table.bvVouEmployInfo.vouMoney')</td>
				<td width="35%">
					$!{bvVouEmployInfoVo.vouMoney}
				</td>
			##数据来源
				<td class="textRight">#springMessage('table.bvVouEmployInfo.dataSource')</td>
				<td width="35%">
					$!{bvVouEmployInfoVo.dataSourceName}
				</td>
			</tr>
			<tr>
			##使用说明
				<td class="textRight">#springMessage('table.bvVouEmployInfo.rmk')</td>
				<td width="35%">
					$!{bvVouEmployInfoVo.rmk}
				</td>
				<td class="textRight"></td>
				<td width="35%"></td>
			</tr>
			</tbody>
		</table>
	#end

	<div >
		<h2 class="layui-colla-title">#springMessage('bill.logInfo.title')</h2>
		<table class="layui-table layui-form" style="width: 100%;">
			<thead>
			<tr>
				<th>#springMessage('table.bvLog.logType')</th>
				<th>#springMessage('table.bvLog.msg')</th>
				<th>#springMessage('table.bvLog.createName')</th>
				<th>#springMessage('table.bvLog.createBy')</th>
				<th>#springMessage('table.bvLog.createDate')</th>
			</tr>
			</thead>
			<body>
				#if($!bvlogList)
					#foreach($bvLog in $bvlogList)
					<tr>
						<td>$!{bvLog.logTypeName}</td>
						<td>#springMessage($!{bvLog.msg})</td>
						<td>$!{bvLog.createName}</td>
						<td>$!{bvLog.createBy}</td>
						<td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{bvLog.createDate})</td>
					</tr>
					#end
				#end
			</body>
		</table>
	</div>
</form>
	#parse("views/common/footer.vm")
</body>
</html>
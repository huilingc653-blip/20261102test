<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
	<table class="layui-table">
		<tbody>
		<tr>
		##所属单位
			<td class="textRight">#springMessage('table.bvVouInfoDtl.corpId')</td>
			<td width="25%">
				<div class="layui-input-inline">
					<div class="bt-biz-corp"
						 data-tree-type="check"
						 data-biz-type="corp"
						 data-type="selectTree"
						 data-name="ins_corpId"
						 data-scope="all"
						 data-callback="corpCallback"
						 data-resource="bill:blankvou:bvVouInfoDtl:query">
					</div>
				</div>
			</td>
		##所属银行
			<td class="textRight">#springMessage('table.bvVouInfoDtl.bankId')</td>
			<td width="25%">
				<div class="layui-input-inline">
					<div class="selectBankId layui-input-inline"></div>
				</div>
			</td>
		##所属库箱
			<td class="textRight">#springMessage('table.bvVouInfoDtl.sboxId')</td>
			<td>
				<div class="selectSboxId layui-input-inline" ></div>
			</td>
		</tr>
		<tr>
		##所属账户
			<td class="textRight">#springMessage('table.bvVouInfoDtl.bankAcc')</td>
			<td width="25%">
				<div class="layui-input-inline">
					<input type="text" id="bankAcc" name="likes_bankAcc" class="bank layui-input">
				</div>
			</td>
		##凭证种类
			<td class="textRight">#springMessage('table.bvVouInfoDtl.vouTid')</td>
			<td>
				<div class="selectVouTid layui-input-inline"></div>
			</td>
		##凭证编号
			<td class="textRight">#springMessage('table.bvVouInfoDtl.vouNo')</td>
			<td>
				<div class="layui-input-inline">
					<input type="text" name="likes_vouNo"
						   autocomplete="off" class="layui-input" placeholder="#springMessage('table.bvVouInfoDtl.vouNo')">
				</div>
			</td>
		</tr>
		<tr>
		##购入日期
			<td class="textRight">#springMessage('table.bvVouInfoDtl.inputDate')</td>
			<td>
				<div class="layui-inline">
				<input type="text" name="ged_inputDate" data-name="ged_inputDate" class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date">
				</div>
				~
				<div class="layui-inline">
				<input type="text" name="led_inputDate"　data-name="led_inputDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date">
				</div>
			</td>
		##凭证状态
			<td class="textRight">#springMessage('table.bvVouInfoDtl.vouStatus')</td>
			<td>
				<div class="bt-biz-dict" data-type="select" data-group="bvvouinfodtl_voustatus" data-name="eqs_vouStatusName" data-filterData="06,02" ></div>
			</td>
		##凭证编号
			<td class="textRight"></td>
			<td></td>
		</tr>

##			#if($shiro.hasPermission("bill:blankvou:bvVouInfoDtl:query"))
			<tr>
				<td colspan="6" style="text-align: center;">
					<button class="layui-btn" lay-submit type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
					<button type="reset" type="button" class="layui-btn layui-btn-primary" onclick="resetUpdate()" >#springMessage('common.button.reset')</button>
				</td>
			</tr>
##			#end
		</tbody>
	</table>
</form>
##	#if($shiro.hasPermission("bill:blankvou:bvVouInfoDtl:query"))
	<table id="appTable" class="layui-table layui-form" style="width:100%;">
		<thead>
		<tr>
			<th>#springMessage('table.bvVouInfoDtl.vouNo')</th>
			<th>#springMessage('table.bvVouInfoDtl.vouTid')</th>
			<th>#springMessage('table.bvVouInfoDtl.corpId')</th>
			<th>#springMessage('table.bvVouInfoDtl.bankId')</th>
			<th>#springMessage('table.bvVouInfoDtl.bankAcc')</th>
			<th>#springMessage('table.fbsBudgetDetail.curId')</th>
			<th>#springMessage('table.bvVouInfoDtl.sboxId')</th>
			<th>#springMessage('table.bvVouInfoDtl.inputDate')</th>
			<th>#springMessage('table.bvVouInfoDtl.createNameNickName')</th>
			<th>#springMessage('table.bvVouInfoDtl.vouStatus')</th>
			<th>#springMessage('common.table.thead.operation')</th>
		</tr>
		</thead>
	</table>
##	#end
<form class="layui-form">
	<div class="layui-form-item"  style="padding-top:25px;">
		<div class="layui-inline" style="width:10%"></div>
		<div class="layui-inline">
		##移库库箱
			<label class="layui-form-label">#springMessage('table.bvVouInfoDtl.transfSboxId')</label>
			<div id="transfSboxId" type="button" class="selectSboxId" ></div>
		</div>
		<div class="layui-inline">
		##批量出售
			<button class="layui-btn" type="button" lay-submit="" lay-filter="batchSell">#springMessage('common.button.batchSell')</button>
		</div>
		<div class="layui-inline">
		##批量丢失
			<button class="layui-btn" type="button" lay-submit="" lay-filter="batchLose">#springMessage('common.button.batchLose')</button>
		</div>
		<div class="layui-inline">
		##批量作废
			<button class="layui-btn" type="button" lay-submit="" lay-filter="batchTovoid">#springMessage('common.button.batchTovoid')</button>
		</div>
		<div class="layui-inline">
		##批量退票
			<button class="layui-btn" type="button" lay-submit="" lay-filter="batchRetreat">#springMessage('common.button.batchRetreat')</button>
		</div>
		<div class="layui-inline">
		##批量移库
			<button class="layui-btn" type="button" lay-submit="" lay-filter="batchTransf">#springMessage('common.button.batchTransf')</button>
		</div>
	</div>
</form>

	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/blankvou/bvVouInfoDtl.list.js?_btv=${resourceVersion}"></script>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
        ##所属单位
            <td class="textRight">#springMessage('table.bvPayeeCheque.corpId')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-scope="all"
                         data-callback="corpCallback"
                         data-resource="bill:blankvou:bvPayeeCheque:query">
                    </div>
                </div>
            </td>
        ##票据号码
            <td class="textRight">#springMessage('table.bvPayeeCheque.origNo')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" id="origNo" name="likes_origNo" class="layui-input">
                </div>
            </td>


        ##付款人
            <td class="textRight">#springMessage('table.bvPayeeCheque.payer')</td>
            <td width="25%">
                <div class="layui-input-inline">
                    <input type="text" id="payer" name="likes_payer" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
        ##票据金额
            <td class="textRight">#springMessage('table.bvPayeeCheque.billMoney')</td>
            <td width="30%">
                <div class="layui-input-inline">
                    <input type="text" name="geg_billMoney" data-moneyendid="endMoney" autocomplete="off"
                           class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_billMoney" id="endMoney" autocomplete="off"
                           class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('table.abVoucherinfo.billMoney')">
                </div>
            </td>
        ##收款人
            <td class="textRight">#springMessage('table.bvPayeeCheque.payee')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="payee" name="likes_payee" class="layui-input">
                </div>
            </td>
        ##付款人账号
            <td class="textRight">#springMessage('table.bvPayeeCheque.payerAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" id="payerAcc" name="likes_payerAcc" class="layui-input">
                </div>
            </td>
        </tr>
        ##登记日期
        <td class="textRight">#springMessage('table.bvPayeeCheque.inputDate')</td>
        <td>
            <div class="layui-inline"">
            <input type="text" name="ged_inputDate" data-name="ged_inputDate" class="layui-input bt-biz-dateType" data-endid="startDate" data-type="date">
            </div>
            ~
            <div class="layui-inline"">
            <input type="text" name="led_inputDate"　data-name="led_inputDate" class="layui-input bt-biz-dateType" id="startDate" data-type="date">
            </div>
        </td>
        ##收款人账户
        <td class="textRight">#springMessage('table.bvPayeeCheque.payeeAcc')</td>
        <td>
            <div class="layui-input-inline">
                <input type="text" id="payeeAcc" name="likes_payeeAcc" class="bank layui-input">
            </div>
        </td>
        ##状态
        <td class="textRight">#springMessage('table.bvPayeeCheque.status')</td>
        <td>

            <div class=layui-form>
                <div class=bt-biz-dict data-type="select" data-name="eqs_status"  data-group="BVCHEQUE_STATUS_STORAGE"></div>
            </div>
        </td>
        <tr>

        </tr>

##            #if($shiro.hasPermission("bill:blankvou:bvPayeeCheque:query"))
            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" type="button" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" type="button" class="layui-btn layui-btn-primary" onclick="resetUpdate()">#springMessage('common.button.reset')</button>
                </td>
            </tr>
##            #end
        </tbody>
    </table>
</form>
##    #if($shiro.hasPermission("bill:blankvou:bvPayeeCheque:query"))
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.bvPayeeCheque.corpId')</th>
            <th>#springMessage('table.bvPayeeCheque.origNo')</th>
            <th>#springMessage('table.bvPayeeCheque.inputDate')</th>
            <th>#springMessage('table.bvPayeeCheque.billMoney')</th>
            <th>#springMessage('table.bvPayeeCheque.startDate')</th>
            <th>#springMessage('table.bvPayeeCheque.endDate')</th>
            <th>#springMessage('table.fbsBudgetDetail.curId')</th>
            <th>#springMessage('table.bvPayeeCheque.payee')</th>
            <th>#springMessage('table.bvPayeeCheque.payeeBankName')</th>
            <th>#springMessage('table.bvPayeeCheque.payeeAcc')</th>
            <th>#springMessage('table.bvPayeeCheque.payer')</th>
            <th>#springMessage('table.bvPayeeCheque.payerBankName')</th>
            <th>#springMessage('table.bvPayeeCheque.payerAcc')</th>
            <th>#springMessage('table.bvPayeeCheque.use')</th>
            <th>#springMessage('table.bvPayeeCheque.status')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
##    #end
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/sys/blackWhite/blackWhiteBase.check.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/bill/blankvou/bvPayeeCheque.list.js?_btv=${resourceVersion}"></script>
</html>

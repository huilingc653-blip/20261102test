<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
		<table class="layui-table">
			<tbody>
			<tr>
                <td class="textRight">#springMessage('table.bvVoucherType.name')</td>
                    <td width="25%">
                         <div class="selectDemo" field="eqs_name"></div>
                    </td>
           
         
               <td class="textRight">#springMessage('table.bvVoucherType.isInbox')</td>
            <td width="25%">
                <div class="bt-biz-dict" data-type="select" data-group="sf_yn" data-defaultvalue="$!{bvVoucherTypePage.isInbox}" data-name="eqs_isInbox"></div>
            </td>
            </tr>
			<tr>
				<td colspan="6" style="text-align: center;">
            <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
            <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				</td>
            </tr>
            </tbody>
        </table>
    </form>
<br>
<table id="appTable" class="layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.bvVoucherType.code')</th>
        <th>#springMessage('table.bvVoucherType.name')</th>
        <th>#springMessage('table.bvVoucherType.isInbox')</th>
		<th>#springMessage('table.bvVoucherType.validSign')</th>
        <th>#springMessage('table.bvVoucherType.dataSource')</th>
        <th>#springMessage('table.bvVoucherType.rmk')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/bill/blankvou/bvVoucherType.list.js?_btv=${resourceVersion}"></script>
</html>

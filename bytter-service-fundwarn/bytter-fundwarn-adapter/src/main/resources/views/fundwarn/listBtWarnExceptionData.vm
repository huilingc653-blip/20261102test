<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
					##渠道
					<td class="textRight" width="10%">#springMessage('table.warndata.channel')</td>
					<td width="20%">
						<div class="layui-input-inline">
                            <div class="bt-biz-dict"
                                 data-type="select"
                                 data-group="EXCEPTION_WARN_DATA_CHANNEL"
                                 data-name="eqs_channel"
                                 data-biz-name="channel"
                            ></div>
                        </div>
                    </td>
					##告警类型
                    <td class="textRight" width="10%">#springMessage('table.warndata.warnType')</td>
                    <td width="20%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" 
								data-type="select" 
								data-group="EXCEPTION_WARN_DATA_TYPE"
								data-name="eqs_warnType"
								data-biz-name="warnType"
								></div>
                        </div>
                    </td>
					##发送时间
                    <td class="textRight">#springMessage('table.warndata.sendDate')</td>
                    <td>
                        <div class="layui-inline">
                            <input type="text" name="ged_sendDate" data-name="ged_sendDate" class="layui-input bt-biz-dateType" data-endid="sendDate" data-type="date">
                        </div>
                        ~
                        <div class="layui-inline">
                        <input type="text" name="led_sendDate"　data-name="led_sendDate" class="layui-input bt-biz-dateType" id="warnDate" data-type="date">
                        </div>
                    </td>
				</tr>
				<tr>
                    ##告警内容
                    <td class="textRight">#springMessage('table.warndata.content')</td>
                    <td >
                        <div class="layui-input-inline">
                            <input type="text" name="likes_warnContent"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.warndata.content')">
                        </div>
                    </td>
                    <td class="textRight"></td>
                    <td >
                    </td>	
                    <td class="textRight"></td>
                    <td >
                    </td>	
				</tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
            </tbody>
        </table>
    </form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.warndata.sendDate')</th>
            <th>#springMessage('table.warndata.sendStatus')</th>
            <th>#springMessage('table.warndata.channel')</th>
            <th>#springMessage('table.warndata.warnType')</th>
            <th>#springMessage('table.warndata.content')</th>
            <th>#springMessage('table.warndata.reqmsg')</th>
            <th>#springMessage('table.warndata.respmsg')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/fundwarn/btWarnExceptionData.list.js?_btv=${resourceVersion}"></script>
</html>

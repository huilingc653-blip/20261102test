<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <link rel="stylesheet" href="${basePath}/static/modules/fundwarn/static/homeWarnDataReport.css">
</head>
<body class="$!{shiro.getPrincipal().sysSkin}" style="padding: 0;">
<input id="uiStyle" name="uiStyle" type="hidden" value="$!{configTag.getConfig('sys','uiStyle')}">
    <div class="card-wrapper background-a">
        #*<div class="card-header text-color-b">
            ##预警指标
            #springMessage('repot.bankAccBal.warnDataTitle')
        </div>*#
        <div class="select-wrapper layui-form">
            <form id="searchForm" class="layui-form input150-container" style="border: none;">
                <input id="barColor" name="barColor" type="hidden"
                    #if($shiro.getPrincipal().sysSkin == 'dark-skin')
                       value="#797979"
                    #else
                       value="#9497AC"
                    #end
                >
            <label class="text-color-b">
                #springMessage('table.btwarnstrategy.corpName')
            </label>
            ##单位
            <div class="layui-inline">
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-tree-type="check"
                         data-type="selectTree"
                         data-name="ins_corpId"
                         data-biz-name="corpId"
                         data-scope="all"
                         data-resource="fundwarn:warnsdata:netop"
                    >
                    </div>
                </div>
            </div>
            <label class="text-color-b">
                #springMessage('table.btwarnstrategy.typeCode')
            </label>
            ##预警类别
            <div class="layui-inline">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict"
                         data-type="select"
                         data-group="FUNDWARN_TYPE_CODE"
                         data-name="eqs_typeCode"
                         data-biz-name="typeCode"
                         data-callback="initDimensionCode"
                    ></div>
                </div>
            </div>
            <label class="text-color-b">
                #springMessage('table.btwarnstrategy.dimensionCode')
            </label>
            ##预警维度
            <div class="layui-inline">
                <div class="layui-input-inline">
                    <div class="bt-biz-dict"
                         data-type="select"
                         data-group="FUNDWARN_DIMENSION_CODE"
                         data-name="eqs_dimensionCode"
                         data-biz-name="dimensionCode"
                         data-callback="initWarnDataTable"></div>
                </div>
            </div>
            <label class="text-color-b">
                #springMessage('table.fcOutAccBalance.optDate')
            </label>
            ##业务日期
            <div class="layui-inline">
                <div class="layui-input-inline">
                <input type="text" name="ged_warnDate" data-name="ged_warnDate" data-biz-name="ged_warnDate" style="width: 90px"
                       class="layui-input bt-biz-dateType" data-endid="warnDate" data-type="date" value="$!{beginDate}">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-input-inline">
                <input type="text" name="led_warnDate"　data-name="led_warnDate" data-biz-name="led_warnDate" style="width: 90px"
                       class="layui-input bt-biz-dateType" id="warnDate" data-type="date" data-today="true" value="$!{endDate}">
                </div>
            </div>
                <div class="layui-inline">
                    <div class="layui-input-inline">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    </div>
                </div>
            </form>
        </div>
        <div class="card-content">
            <div id="chartWarnData" style="width:calc(100%);height:264px;"></div>
            <table id="appTable" class="layui-table layui-form no-border-table" style="width:100%;">
                <thead>
                <tr>
                    <th>#springMessage('table.btwarnstrategy.corpName')</th>
                    <th>#springMessage('table.btwarnstrategy.typeCode')</th>
                    <th>#springMessage('table.btwarnstrategy.dimensionCode')</th>
                    <th>#springMessage('table.btwarnstrategy.level')</th>
                    <th>#springMessage('table.btwarnstrategy.warnDate')</th>
                    <th>#springMessage('table.fbsBudgetPeriod.createDate')</th>
                </tr>
                </thead>
            </table>
        </div>
    </div>

#parse("views/common/footer.vm")
</body>
  #parse("views/fundwarn/BaseBtWarnData.vm")
<script src="${basePath}/static/plugins/echarts/echarts.common.min.js?_btv=${resourceVersion}"></script>
<script src="${basePath}/static/modules/fundwarn/homeWarnDataReport.js?_btv=${resourceVersion}"></script>
</html>

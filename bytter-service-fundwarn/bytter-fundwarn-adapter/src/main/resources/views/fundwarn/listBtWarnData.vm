<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
					##单位
					<td class="textRight" width="10%">#springMessage('table.btwarnstrategy.corpName')</td>
					<td width="20%">
						<div class="layui-input-inline">
        					<div class="bt-biz-corp"
                                data-tree-type="check"
                                data-type="selectTree"
                                data-name="ins_corpId"
                                data-scope="all"
                                data-resource="fundwarn:warnsdata:netop"
    							>
        					</div>
                        </div>
                    </td>
					##预警类别
                    <td class="textRight" width="10%">#springMessage('table.btwarnstrategy.typeCode')</td>
                    <td width="20%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" 
								data-type="select" 
								data-group="FUNDWARN_TYPE_CODE"  
								data-name="eqs_typeCode"
								data-biz-name="typeCode"
								data-callback="initDimensionCode"initWarnDataTable
								data-required="true"
								></div>
                        </div>
                    </td>
					##预警维度
                    <td class="textRight" width="10%">#springMessage('table.btwarnstrategy.dimensionCode')</td>
                    <td width="20%">
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" 
								data-type="select" 
								data-group="FUNDWARN_DIMENSION_CODE"  
								data-name="eqs_dimensionCode" 
								data-biz-name="dimensionCode"
								data-callback="initWarnDataTable"
								data-required="true"></div>
                        </div>
                    </td>			
				</tr>
				
				<tr>
					##策略代码
                    <td class="textRight">#springMessage('table.btwarnstrategy.code')</td>
                    <td>
                        <div class="layui-input-inline">
                            <input type="text" name="likes_code"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.btwarnstrategy.code')">
                        </div>
                    </td>	
                    ##策略名称
                    <td class="textRight">#springMessage('table.btwarnstrategy.name')</td>
                    <td >
                        <div class="layui-input-inline">
                            <input type="text" name="likes_name"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.btwarnstrategy.name')">
                        </div>
                    </td>	
                    ##预警币别
                    <td class="textRight">#springMessage('table.btwarnstrategy.curName')</td>
                    <td>
						 <div class="bt-biz-selectType" data-url="${basePath}/basic/business/btcurrency/json"
                             data-name ="eqs_curId" data-biz-name ="curId"  data-valueField="id" data-textField="curName"></div>
                    </td>
				</tr>
				<tr>
					##业务日期
					<td class="textRight">#springMessage('table.btwarnstrategy.warnDate')</td>
					<td>
						<div class="layui-inline">
                        <input type="text" name="ged_warnDate" data-name="ged_warnDate" class="layui-input bt-biz-dateType" data-endid="warnDate" data-type="date">
                        </div>
                        ~
                        <div class="layui-inline"">
                        <input type="text" name="led_warnDate"　data-name="led_warnDate" class="layui-input bt-biz-dateType" id="warnDate" data-type="date">
                        </div>
                    </td>
                    <td class="textRight"></td>
                    <td >
                    </td>	
                    <td class="textRight"></td>
                    <td >
                    </td>	
				</tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
            </tbody>
        </table>
    </form>
<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
</table>	
#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/fundwarn/btWarnData.list.js?_btv=${resourceVersion}"></script>
#parse("views/fundwarn/BaseBtWarnData.vm")
</html>

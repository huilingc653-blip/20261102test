<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
					##网点
					<td class="textRight">#springMessage('table.btwarnstrategy.netId')</td>
					<td width="25%">
						<div class="layui-input-inline">
        					<div class="bt-biz-corp"
                                data-tree-type="radio"
                                data-biz-type="net"
                                data-type="selectTree"
                                data-name="likes_netId"
                                data-scope="net"
                                data-resource="fundwarn:warnstrategy:query"
    							>
        					</div>
                        </div>
                    </td>
					##策略代码
                    <td class="textRight">#springMessage('table.btwarnstrategy.code')</td>
                    <td width="20%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_code"
                                    autocomplete="off" class="layui-input" placeholder="#springMessage('table.btwarnstrategy.code')">
                        </div>
                    </td>
                    ##预警币别
                    <td class="textRight">#springMessage('table.btwarnstrategy.curName')</td>
                    <td width="20%">
                        <div class="currency"></div>
                    </td>					
				</tr>
				
				<tr>
					##预警类别
                    <td class="textRight">#springMessage('table.btwarnstrategy.typeCode')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="FUNDWARN_TYPE_CODE"  data-name="eqs_typeCode"></div>
                        </div>
                    </td>
                    ##策略名称
                    <td class="textRight">#springMessage('table.btwarnstrategy.name')</td>
                    <td >
                        <div class="layui-input-inline">
                            <input type="text" name="likes_name"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.btwarnstrategy.name')">
                        </div>
                    </td>
					##状态
                    <td class="textRight">#springMessage('table.btwarnstrategy.status')</td>
                    <td >
                        <div class=layui-form>
                            <div class=bt-biz-dict data-type="select" data-name="eqi_status"  data-group="FUNDWARN_STATUS"></div>
                        </div>
                    </td>
				</tr>
                <tr>
                    <td colspan="8" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;" data-btns="colvis">
    <thead>
    <tr>
		<th>#springMessage('table.btwarnstrategy.netName')</th>
		<th>#springMessage('table.btwarnstrategy.code')</th>
		<th>#springMessage('table.btwarnstrategy.name')</th>
		<th>#springMessage('table.btwarnstrategy.typeCode')</th>
		<th>#springMessage('table.btwarnstrategy.curName')</th>
        <th>#springMessage('table.btwarnstrategy.dimensionCode')</th>
        <th>#springMessage('table.btwarnstrategy.level')</th>
		<th>#springMessage('table.btwarnstrategy.status')</th>
		<th>#springMessage('table.btwarnstrategy.createDate')</th>
		<th>#springMessage('table.btwarnstrategy.updateDate')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>	

#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/fundwarn/btWarnStrategy.list.js?_btv=${resourceVersion}"></script>
</html>

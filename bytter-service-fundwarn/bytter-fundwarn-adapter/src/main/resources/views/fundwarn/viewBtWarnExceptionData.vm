<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form class="layui-form layui-form-pane">
    <table class="layui-table" >
        <tbody >
        <tr >
            <td class="textRight" width="40%">#springMessage('table.warndata.sendDate')</td>
            <td>
                $!date.format('yyyy-MM-dd',$!{dataInfo.sendDate})
            </td>
        </tr>
        <tr >
            <td class="textRight">#springMessage('table.warndata.sendStatus')</td>
            <td>
                $!{dataInfo.sendStatusName}
            </td>
        </tr>
        <tr >
            <td class="textRight">#springMessage('table.warndata.channel')</td>
            <td>
                $!{dataInfo.channelName}
            </td>
        </tr>
        <tr >
            <td class="textRight">#springMessage('table.warndata.warnType')</td>
            <td>
                $!{dataInfo.warnTypeName}
            </td>
        </tr>
        <tr >
            <td class="textRight">#springMessage('table.warndata.content')</td>
            <td>
              <textarea style="min-height:70px"
                        class="layui-textarea" readonly="readonly">$!{dataInfo.warnContent}</textarea>
            </td>
        </tr>
        <tr >
            <td class="textRight">#springMessage('table.warndata.reqmsg')</td>
            <td>
             <textarea style="min-height:150px"
                       class="layui-textarea" readonly="readonly">$!{dataInfo.reqMsg}</textarea>
            </td>
        </tr>
        <tr>
            <td class="textRight">#springMessage('table.warndata.respmsg')</td>
            <td>
                <textarea style="min-height:150px"
                          class="layui-textarea" readonly="readonly">$!{dataInfo.respMsg}</textarea>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
<script>
    bt.use(['form','dicts','layedit','externalCorpView', 'bankAccView', 'moneyType'],function () {
        var moneyType = bt.moneyType.init();
        bt.dicts.init();
    })
</script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>#parse("views/common/head.vm")
    <style>
        html,body{height:100%;overflow-y: hidden;}
    </style>
</head>
<body>
	<form class="layui-form" method="post">
        <input type="hidden" name="id" id="id" value="$!{btWarnStrategy.id}"/>
        <input type="hidden" name="taskId" id="taskId" value="$!{btWarnStrategy.taskId}"/>
        <input type="hidden" name="forwardTime" id="forwardTime" value="$!{btWarnStrategy.forwardTime}"/>
		<table class="layui-table">
			<tbody>
                <tr>
                    <td class="textRight">#springMessage('table.btwarnstrategy.warnDate')</td>
                    <td >
                        <input type="text" id="runDate" data-name="runDate" class="layui-input bt-biz-dateType" data-type="date" data-today="true"/>
                    </td>
                </tr>
                <tr>
                    <td class="textRight">#springMessage('table.sysTask.cron')</td>
                    <td >
                        <input id="cron" class="layui-input" lay-verify="required" disabled="disabled" value="$!{btWarnStrategy.taskCron}"/>
                    </td>
                </tr>
                <tr>
                    <td class="textRight">#springMessage('table.btwarnstrategy.status')</td>
                ##状态
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-dict" data-type="select" data-group="FUNDWARN_STATUS" data-defaultvalue="$!{btWarnStrategy.status}"
                                 data-name="status"  data-biz-name="status"  id="status"  data-required="true" ></div>
                        </div>
                    </td>
                </tr>

                <tr>
                    <td style="text-align: center;"  colspan="2">
                        <button class="layui-btn" type="button" lay-submit="" value="W"  lay-filter="submit">#springMessage('common.button.submit')</button>
                        <button class="layui-btn" type="button" onclick="executeScan()" >#springMessage('btwarnstrategy.button.execute')</button>
                    </td>
                </tr>
			</tbody>
		</table>
	</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/fundwarn/scanParameter.js?_btv=${resourceVersion}"></script>
</html>
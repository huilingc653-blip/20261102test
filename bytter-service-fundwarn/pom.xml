<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bytter</groupId>
        <artifactId>bytter-parent</artifactId>
        <version>2.0.0.RELEASE</version>
        <relativePath/>
    </parent>

    <artifactId>bytter-service-fundwarn</artifactId>
    <version>2.0.0.RELEASE</version>
    <packaging>pom</packaging>
    <name>bytter-service-fundwarn</name>
    <description>bytter-service-fundwarn</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <modules>
        <module>bytter-fundwarn-adapter</module>
        <module>bytter-fundwarn-client</module>
        <module>bytter-fundwarn-domain</module>
        <module>bytter-fundwarn-start</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.bytter</groupId>
                <artifactId>bytter-fundwarn-adapter</artifactId>
                <version>${project.parent.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bytter</groupId>
                <artifactId>bytter-fundwarn-client</artifactId>
                 <version>${project.parent.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bytter</groupId>
                <artifactId>bytter-fundwarn-domain</artifactId>
                 <version>${project.parent.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bytter</groupId>
            <artifactId>bytter-framework</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bytter</groupId>
            <artifactId>bytter-velocity</artifactId>
            <version>${revision}</version>
        </dependency>
    </dependencies>
</project>

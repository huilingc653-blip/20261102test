<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
     <style>
    	.layui-table {
            margin: 0px 0;
		}
    </style>
</head>
<body>
	<form class="layui-form" method="post">
	<input id="id" name="id" type="hidden" value="$!{rasBankCardBindingVo.id}">
	<input id="validSign" name="validSign" type="hidden" value="$!{rasBankCardBindingVo.validSign}">
			<table class="layui-table">
			<tbody>
			<tr>
				##所属单位
				<td class="textRight" width="15%">#springMessage('table.sysCorp.corpName')</td>
				<td>
	                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
						        data-biz-type="corp"
								data-type="selectTree"
								id="corpId"
								data-name="corpId"
								data-required="true"
								data-biz-name="corpId"
								data-placeholder="#springMessage('table.sysCorp.corpName')"
								data-resource="ras:bankCardBinding:op"
								data-callbackdata="corpCallback"
								data-defaultvalue="$!{rasBankCardBindingVo.corpId}">
								
					</div>
                    </div>
                </td>
        		<td class="textRight" width="15%"></td>
				<td width="35%">
			    </td>
		   </tr>
	        <tr>
	        	##门店名称
				<td class="textRight" width="15%">#springMessage('table.rasPosBinding.shopName')</td>
				<td width="35%"> 
						<div class="layui-input-inline">
							<div class="bt-biz-rasShop" id="shopId" name="shopId" data-name="shopId" data-biz-name="shopId" data-defaultValue="$!{rasBankCardBindingVo.shopId}" data-grant-type="audit" data-required="true" data-callback="shopCallback" > </div>
						</div>                
				</td>  
               ##门店编码        		
				<td class="textRight" width="15%">#springMessage('table.rasPosBinding.shopCode')</td>   
				<td width="35%">
		 			 <input type="text" id="shopCode"  data-callback="shopCallback" name="shopCode" autocomplete="off" value="$!{rasBankCardBindingVo.shopCode}" class="layui-input" placeholder="#springMessage('table.rasPosBinding.shopCode')" data-required="true" readonly  data-maxlength="100">
                </td>
			 </tr>
			 <tr>
	        	##是否虚拟账号
				<td class="textRight" width="15%">#springMessage('table.rasbankcardbinding.isVirtualAcc')</td>
				<td width="35%"> 
						<div class="bt-biz-dict" data-type="radio" 
						data-group="sf_yn" data-defaultvalue="$!{rasBankCardBindingVo.isVirtualAcc}"  name="isVirtualAcc"
						data-name="isVirtualAcc" data-biz-name="isVirtualAcc" data-callback="isVirtualAccCallBack" 
						id="isVirtualAcc" data-required="true">
                </td>
                ##银行账户
				<td class="textRight" width="15%">#springMessage('table.rasbankcardbinding.bankNo')</td>
				<td width="35%"> 
					<div class="layui-input-inline">
					  <input type="hidden" id="accId" value="$!{rasBankCardBindingVo.accId}" name="accId" />
					  <input type="text" id="accNo" 
						  name="accNo" data-name="accNo" 
						  data-biz-name="selectTable" 
						  class="layui-input rasBank" 
						  data-callback="clickCallback" 
						  value="$!{rasBankCardBindingVo.accNo}"
						  placeholder="#springMessage('table.rasbankcardbinding.bankNo')" 
						  lay-verify="required|strlength" 
						  data-maxlength="50"/>
					</div>
                </td>  
              </tr>		
            <tr>
	        	##账号名称
				<td class="textRight" width="15%">#springMessage('table.rasbankcardbinding.bankName')</td>
				<td width="35%"> 
					<div class="layui-inline">
						<input type="text" readonly id="accName" value="$!{rasBankCardBindingVo.accName}" name="accName" autocomplete="off" lay-verify="required|strlength"  class="layui-input" placeholder="#springMessage('table.rasbankcardbinding.bankName')"   data-maxlength="100">
					</div>
                </td>  
                ##开户行名称
				<td class="textRight" width="15%">#springMessage('table.rasbankcardbinding.bankAccName')</td>
				<td width="35%"> 
					<div class="layui-inline">
						<input type="text" id="accBankName" readonly  value="$!{rasBankCardBindingVo.accBankName}" name="accBankName" lay-verify="required|strlength" autocomplete="off" class="layui-input" placeholder="#springMessage('table.rasbankcardbinding.bankAccName')"  data-maxlength="100">
					</div>
                </td>  
              </tr>	
             #if(${rasBankCardBindingVo.isVirtualAcc}=="0")##
              <tr  style="display: none"  id="entityAcc" name="entityAcc">
             #end##
             #if(${rasBankCardBindingVo.isVirtualAcc}=="1")##
              <tr  id="entityAcc" name="entityAcc">
             #end##
	        	##关联实体账号
				<td class="textRight" width="15%">
				<span class="pl"><span class="required-icon">*</span>
				#springMessage('table.rasbankcardbinding.entityAcc')</td>
				<input type="hidden" id="entityAccId" name="entityAccId" value="$!{rasBankCardBindingVo.entityAccId}"/>
				<td width="35%"> 
					<div class="layui-inline">
						<input type="text" id="entityAccNo" value="$!{rasBankCardBindingVo.entityAccNo}" name="entityAccNo" autocomplete="off" class="layui-input" placeholder="#springMessage('table.rasbankcardbinding.entityAcc')"    data-maxlength="100">
					</div>
                </td>  
                ##
				<td class="textRight" width="15%"></td>
				<td width="35%"> 
                </td>  
              </tr>	
              <tr>
	        	##备注
				<td class="textRight" width="15%">#springMessage('table.rasbankcardbinding.rmk')</td>
				<td width="35%"> 
					<div class="layui-inline">
						<input type="text" id="rmk" name="rmk" value="$!{rasBankCardBindingVo.rmk}" autocomplete="off" class="layui-input" placeholder="#springMessage('table.rasbankcardbinding.rmk')"   data-maxlength="200">
					</div>
                </td>  
                ##
				<td class="textRight" width="15%"></td>
				<td width="35%"> 
                </td>  
              </tr>	
				</tbody>
             </table>	
            <div class="layui-form-submit-adaptive">
                <div style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="save" value="submit">#springMessage('common.button.submit')</button>
                    <button class="layui-btn" type="reset" lay-filter="reset" id="reset">#springMessage('common.button.reset')</button>
                	<button class="layui-btn" type="button" id="cancel">#springMessage('common.button.cancel')</button>
                </div>
            </div>	
            		
</form>
    #parse("views/common/footer.vm")
</body> 
<script src="${basePath}/static/modules/ras/rasBankCardBinding.edit.js?_btv=${resourceVersion}"></script>
</html>
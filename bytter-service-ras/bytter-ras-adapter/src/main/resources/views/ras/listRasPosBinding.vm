<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form input150-container">
        <table class="layui-table">
            <tbody>
                <tr>
                    ##单位名称
                    <td class="textRight">#springMessage('table.rasPosBinding.corpName')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-biz-name="corpId"
                                 data-type="selectTree"
                                 data-name="eqs_corpId"
                                 data-scope="all"
                                 data-callbackData="corpCallback"
                                 data-resource="ras:posBinding:op"
                                 placeholder="#springMessage('table.rasPosBinding.corpName')">
                            </div>
                        </div>
                    </td>
					##门店名称
                    <td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
                    <td>
                        <div class="layui-input-inline">
                            <div class="bt-biz-rasShop" id="shopId" name="shopId" data-name="eqs_shopId" data-biz-name="shopId" data-grant-type="audit"> </div>
                        </div>
                    </td>
                    ##终端号
                    <td class="textRight">#springMessage('table.rasPosBinding.posNo')</td>
                    <td width="25%">
                        <div class="layui-input-inline">
                            <input type="text" name="likes_posNo"
                                   autocomplete="off" class="layui-input" placeholder="#springMessage('table.rasPosBinding.posNo')">
                        </div>
                    </td>
				</tr>
                <tr>
                    <td colspan="6" style="text-align: center;">
                        <button class="layui-btn" lay-submit="" type="button" lay-filter="search" type="button">#springMessage('common.button.search')</button>
                        <button type="reset" type="button" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                    </td>
				</tr>
            </tbody>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
		<th>#springMessage('table.rasPosBinding.corpName')</th>
		<th>#springMessage('table.rasPosBinding.shopCode')</th>
		<th>#springMessage('table.rasPosBinding.shopName')</th>
		<th>#springMessage('table.rasPosBinding.posNo')</th>
		<th>#springMessage('table.rasPosBinding.rmk')</th>
		<th>#springMessage('table.rasPosBinding.status')</th>
		<th>#springMessage('table.rasPosBinding.createDate')</th>
		<th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>



#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ras/rasPosBinding.list.js?_btv=${resourceVersion}"></script>
</html>

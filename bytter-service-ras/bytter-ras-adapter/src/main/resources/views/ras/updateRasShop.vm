<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input id="id" name="id" type="hidden" value="$!{shopPage.id}">
        <table class="layui-table">
			<tbody>
        	<tr>
                ##单位
				<td class="textRight" style="width: 15%">#springMessage('table.rasPosBinding.corpName')</td>
				<td>
                    ##选择单位时，备份名称跟编码
                    <input type="hidden" id="backUpCode" value="$!{shopPage.code}">
                    <input type="hidden" id="backUpName" value="$!{shopPage.name}">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-biz-name="corpId"
                             data-type="selectTree"
                             data-name="corpId"
                             data-scope="all"
                             data-required="true"
                             data-defaultvalue="$!{shopPage.corpId}"
                             data-resource="ras:shop:op"
                        </div>
                    </div>
				</td>
                ##是否单位级别门店
				<td class="textRight" style="width: 15%">#springMessage('table.rasShop.isCorpShop')</td>
				<td>
                    <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-required="true"
                         data-defaultvalue="$!{shopPage.isCorp}" data-name="isCorp" data-biz-name="isCorp"></div>
				</td>
			</tr>
        	<tr>
                ##门店编码
				<td class="textRight">#springMessage('table.rasPosBinding.shopCode')</td>
				<td >
                    <input type="text" id="code" name="code" lay-verify="required|strlength" data-maxlength="30"
                           class="layui-input" value = "$!{shopPage.code}"placeholder="#springMessage('table.rasPosBinding.shopCode')">
				</td>
                ##门店名称
				<td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
				<td>
					<input type="text" id="name" name="name" class="layui-input" lay-verify="required|strlength"
                           data-maxlength="30" value="$!{shopPage.name}" placeholder="#springMessage('table.rasPosBinding.shopName')">
				</td>
            </tr>
            <tr>
                ##门店类别
                <td class="textRight">#springMessage('table.rasShop.shopType')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="RAS_SHOP_TYPE" data-required="true"
                         data-defaultvalue="$!{shopPage.shopType}" data-name="shopType"></div>
                </td>
                ##开始稽核日期
                <td class="textRight">#springMessage('table.rasShop.auditStartDate')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="asDate" lay-verify="required" class="layui-input bt-biz-dateType"
                               value="$!{shopPage.asDate}" data-type="date" data-name="asDate" data-biz-name="asDate">
                    </div>
                </td>
            </tr>
            <tr>
                ##商户号
                <td class="textRight">#springMessage('table.rasShop.shopNo')</td>
                <td >
                    <input type="text" name="shopNo" class="layui-input" value="$!{shopPage.shopNo}"
                           lay-verify="strlength" placeholder="#springMessage('table.rasShop.shopNo')">
                </td>
                ##商户名称
                <td class="textRight">#springMessage('table.rasShop.shopName')</td>
                <td>
                    <input type="text" name="shopName" class="layui-input" lay-verify="strlength"
                            value="$!{shopPage.shopName}" placeholder="#springMessage('table.rasShop.shopName')">
                </td>
            </tr>
            <tr>
                ##尾款阈值
                <td class="textRight">#springMessage('table.rasShop.endCheckMoney')</td>
                <td>
                    <div class="layui-input-inline">
                        <input type="text" name="ecMoney" style="text-align:right" lay-verify="required|number2" data-name="ecMoney" data-biz-name="ecMoney"
                               autocomplete="off" class="layui-input bt-biz-moneyType" value="$!{shopPage.ecMoney}" placeholder="#springMessage('table.rasShop.endCheckMoney')">
                    </div>
                </td>
                <td class="textRight"></td>
                <td>
                </td>
            </tr>
            <tr>
                ##对应其他系统门店编码
                <td class="textRight">#springMessage('table.rasShop.otherShopCode')</td>
                <td colspan="3">
                    <div class="layui-input-inline">
                        <input type="text" name="extemalNo" class="layui-input" style="width: 300px"
                               value="$!{shopPage.extemalNo}" placeholder="#springMessage('table.rasShop.otherShopCode')">
                    </div>&nbsp;
                    <font color="red">#springMessage('ras.shop.otherCode.rmk')</font>
                </td>
            </tr>
            <tr>
                ##备注
                <td class="textRight">#springMessage('table.rasPosBinding.rmk')</td>
                <td colspan="3">
                    <div class="layui-input-inline">
                        <input type="text" name="rmk" class="layui-input" style="width: 300px" value="$!{shopPage.rmk}"
                               placeholder="#springMessage('table.rasPosBinding.rmk')">
                    </div>
                </td>
            </tr>
        	</tbody>
        </table>
        <div class="layui-form-submit-adaptive">
            <div style="text-align: center;">
                <button class="layui-btn" lay-submit="" lay-filter="submit" value="submit">#springMessage('common.button.submit')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                <button class="layui-btn layui-btn-primary" type="button" onclick="closeForms()">#springMessage('common.button.cancel')</button>
            </div>
        </div>
	</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/ras/rasShop.edit.js?_btv=${resourceVersion}"></script>
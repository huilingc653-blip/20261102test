<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>	
<form class="layui-form" method="post">
	<table class="layui-table">
        <tbody>
        <tr>
			<td class="textRight" width="15%">#springMessage('common.table.filetype')</td>
			<td width="85%">
				<div class=layui-inline>
					<div class="bt-biz-dict" data-filterData="txt" data-defaultvalue="$!{fileType}" data-callback="selectfileType" data-type="select" id="fileType" name="fileType" data-name="fileType" data-group="RAS_IMPORT_FILE_DICT"></div>
				</div> 
		    </td>
        </tr>
        <tr>
			<td class="textRight" width="15%">#springMessage('table.rasImportconf.begin.row')</td>
			<td width="85%">
				<div class="layui-inline">
					<input type="text" id="startLine" lay-verify="required|number" value="$!{rasBindVoInfo.startLine}" name="startLine" autocomplete="off" class="layui-input"  placeholder="#springMessage('table.rasImportconf.begin.row')"   data-maxlength="200">
				</div>
		    </td>
        </tr>
        </tbody>
    </table>
    <table  id="appTable" class="layui-table self-adaption" style="width:100%;">
        <thead>
     	<input  type="hidden" id="id" name="id" value="$!{rasBindVoInfo.id}" autocomplete="off" class="layui-input" >
        #if($!headList)
        <tr>
        	<th></th>
    		#foreach($headSera in $headList)
    			<th>#if(${headSera.required}==true)<span style="color:red;">*</span> #end #springMessage(${headSera.name})</th>
            #end
        </tr>
        </thead>
        <tbody>
        <tr id="dataText">
        	<td>#springMessage('ras.currer.row')</td>
    		#foreach($rasImportConfVO in $headList)
		    <td>
				<input  type="hidden" name="dtlList[${velocityCount}].fieldKey" value="$!{rasImportConfVO.key}" autocomplete="off" class="layui-input" >
				<input  type="hidden" name="dtlList[${velocityCount}].id" value="$!{rasImportConfVO.id}" autocomplete="off" class="layui-input" >
				<input  type="text"  #if(${rasImportConfVO.required}=='true') lay-verify="required" #end name="dtlList[${velocityCount}].startVal" value="$!{rasImportConfVO.value}" autocomplete="off" class="layui-input" >
			</td>
            #end
        </tr>
         </tbody>
    </table>
    <span style="color:red;font-weight: bold;">#springMessage('ras.reven.confrm.msg')</span>
      #end
    
        <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" lay-filter="save" value="submit">#springMessage('common.button.submit')</button>
        	<button class="layui-btn" type="button" id="cancel">#springMessage('common.button.cancel')</button>
        </div>
   </div>	
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ras/rasImportConfig.js?_btv=${resourceVersion}"></script>
</html>

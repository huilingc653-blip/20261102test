<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            ##单位名称
            <td class="textRight" style="width: 7%">#springMessage('table.rasPosBinding.corpName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-scope="all"
                         data-resource="ras:differentDtl:op"
                         data-callbackData="corpCallback"
                         placeholder="#springMessage('table.rasPosBinding.corpName')">
                    </div>
                </div>
            </td>
            ##门店名称
            <td class="textRight" style="width: 7%">#springMessage('table.rasPosBinding.shopName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-rasShop" id="shopId" name="shopId" data-name="eqs_shopId"
                         data-biz-name="shopId" data-grant-type="query"> </div>
                </div>
            </td>
            ##缴款方式
            <td class="textRight" style="width: 7%">#springMessage('table.rasBackOp.payType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="RAS_PAY_TYPE" data-name="eqs_payType" data-biz-name="payType"></div>
            </td>
        </tr>
        <tr>
            ##确认差异日期
            <td class="textRight" style="width: 7%">#springMessage('table.query.lessDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="ged_createDate" class="layui-input bt-biz-dateType" data-endid="led_createDate" data-today="true">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" name="led_createDate" class="layui-input bt-biz-dateType" id="led_createDate" data-today="true">
                </div>
            </td>
            ##差异金额
            <td class="textRight" style="width: 7%">#springMessage('rasAuditInfo.lessMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_lessMoney"
                           class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('rasAuditInfo.lessMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_lessMoney"
                           class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('rasAuditInfo.lessMoney')">
                </div>
            </td>
            ##稽核人
            <td class="textRight" style="width: 7%">#springMessage('rasAuditInfo.auditPeople')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="createBy" class="layui-input" placeholder="#springMessage('rasAuditInfo.auditPeople')">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search">#springMessage('common.button.search')</button>
                <button class="layui-btn layui-btn-primary" type="reset">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('rasAuditInfo.auditNo')</th>
            <th>#springMessage('table.rasPosBinding.corpName')</th>
            <th>#springMessage('table.rasPosBinding.shopName')</th>
            <th>#springMessage('table.rasBackOp.payType')</th>
            <th>#springMessage('rasAuditInfo.revenueMoneySum')</th>
            <th>#springMessage('table.query.revenueSize')</th>
            <th>#springMessage('rasAuditInfo.receivedMoneySum')</th>
            <th>#springMessage('table.query.receivedSize')</th>
            <th>#springMessage('rasAuditInfo.lessMoney')</th>
            <th>#springMessage('table.query.lessDate')</th>
            <th>#springMessage('rasAuditInfo.auditPeople')</th>
            <th>#springMessage('table.rasPosBinding.rmk')</th>
        </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/ras/rasDifferentDtlQuery.list.js?_btv=${resourceVersion}"></script>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<div>
    <table class="layui-table">
        <thead>
        <tr>
            <h2 class="layui-colla-title">#springMessage('ras.message.reveandrece')</h2>
        </tr>
        </thead>
        <tbody>
        <tr>
        ##稽核码
            <td class="textRight" style="width: 15%">#springMessage('rasAuditInfo.auditNo')</td>
            <td style="width: 35%">
                $!{audit.auditNo}
            </td>
        ##稽核日期
            <td class="textRight" style="width: 15%">#springMessage('rasAuditInfo.auditDate')</td>
            <td style="width: 35%">
                $!date.format('yyyy-MM-dd',$!{audit.createDate})
            </td>
        </tr>
        <tr>
        ##所属单位
            <td class="textRight" style="width: 15%">#springMessage('table.query.corpName')</td>
            <td style="width: 35%">
                $!{audit.corpCodeAndName}
            </td>
        ##门店名称
            <td class="textRight" style="width: 15%">#springMessage('table.rasPosBinding.shopName')</td>
            <td style="width: 35%">
                $!{audit.shopName}
            </td>
        </tr>
        <tr>
        ##营收合计
            <td class="textRight" style="width: 15%">#springMessage('rasAuditInfo.revenueMoneySum')</td>
            <td style="width: 35%">
                $!number.formatNumeric($!{audit.revenueMoney})
            </td>
        ##实收合计
            <td class="textRight" style="width: 15%">#springMessage('rasAuditInfo.receivedMoneySum')</td>
            <td style="width: 35%">
                $!number.formatNumeric($!{audit.receivedMoney})
            </td>
        </tr>
        <tr>
        ##差异金额
            <td class="textRight">#springMessage('rasAuditInfo.lessMoney')</td>
            <td>
                $!number.formatNumeric($!{audit.lessMoney})
            </td>
        ##缴款方式
            <td class="textRight">#springMessage('table.rasBackOp.payType')</td>
            <td>
                $dictTag.get("RAS_PAY_TYPE",$!{audit.payType})
            </td>
        </tr>
        <tr>
        ##营收笔数
            <td class="textRight" style="width: 15%">#springMessage('table.query.revenueSize')</td>
            <td style="width: 35%">
                $!{audit.revenueSize}
            </td>
        ##实收笔数
            <td class="textRight" style="width: 15%">#springMessage('table.query.receivedSize')</td>
            <td style="width: 35%">
                $!{audit.receivedSize}
            </td>
        </tr>
        <tr>
        ##稽核人
            <td class="textRight" style="width: 15%">#springMessage('rasAuditInfo.auditPeople')</td>
            <td style="width: 35%">
                $!{audit.createName}
            </td>
        ##稽核方式
            <td class="textRight" style="width: 15%">#springMessage('table.query.auditType')</td>
            <td style="width: 35%">
                $dictTag.get("RAS_AUDIT_TYPE",$!{audit.type})
            </td>
        </tr>
        <tr>
        ##备注
            <td class="textRight" style="width: 15%">#springMessage('table.rasPosBinding.rmk')</td>
            <td style="width: 35%">
                $!{audit.rmk}
            </td>
            <td class="textRight" style="width: 15%">
            </td>
            <td style="width: 35%">
            </td>
        </tr>
        </tbody>
    </table>
<h2 class="layui-colla-title">#springMessage('table.query.revenueDtl')</h2>
<table class="layui-table">
    <thead>
    <tr>
    ##交易流水号
        <th>#springMessage('ras.revenue.Conf.serialNo')</th>
    ##营收订单号
        <th>#springMessage('ras.revenue.Conf.orderNo')</th>
    ##交易金额
        <th>#springMessage('ras.revenue.Conf.money')</th>
    ##交易时间
        <th>#springMessage('table.revenue.transTime')</th>
    ##客户名称
        <th>#springMessage('table.rasBackOp.custName')</th>
    ##客户账号
        <th>#springMessage('table.rasBackOp.custAcc')</th>
    ##导入时间
        <th>#springMessage('table.revenue.importTime')</th>
    ##备注
        <th>#springMessage('ras.received.Conf.rmk')</th>
    </tr>
    </thead>
    <body>
        #foreach($revenue in $listRevenue)
        <tr>
        <td class="textCenter">
            $!{revenue.serialNo}
        </td>
        <td class="textCenter">
            $!{revenue.orderNo}
        </td>
            <td class="textCenter">
                $!number.formatNumeric($!{revenue.money})
            </td>
            <td class="textCenter">
                $!date.format('yyyy-MM-dd',$!{revenue.transDate})
            </td>
        <td class="textCenter">
            $!{revenue.custName}
        </td>
        <td class="textCenter">
            $!{revenue.custAcc}
        </td>
            <td class="textCenter">
                $!date.format('yyyy-MM-dd',$!{revenue.createDate})
            </td>
        <td class="textCenter">
            $!{revenue.rmk}
        </td>
        </tr>
        #end
    </body>
</table>
<h2 class="layui-colla-title">#springMessage('table.query.receivedDtl')</h2>
<table class="layui-table">
    <thead>
    <tr>
    ##交易流水号
        <th>#springMessage('ras.received.Conf.serialNo')</th>
    ##实收订单号
        <th>#springMessage('ras.received.Conf.orderNo')</th>
    ##实收金额
        <th>#springMessage('ras.received.Conf.money')</th>
    ##交易金额
        <th>#springMessage('ras.received.Conf.transMoney')</th>
    ##交易日期
        <th>#springMessage('ras.received.Conf.transDate')</th>
    ##收款账号
        <th>#springMessage('ras.received.Conf.payeeAcc')</th>
    ##收款户名
        <th>#springMessage('ras.received.Conf.payeeAccName')</th>
    ##收款账号开户行
        <th>#springMessage('ras.received.Conf.payeeBankName')</th>
    ##数据来源
        <th>#springMessage('table.received.dataSource')</th>
    ##客户名称
        <th>#springMessage('ras.received.Conf.custName')</th>
    ##客户账号
        <th>#springMessage('ras.received.Conf.custAcc')</th>
    ##导入时间
        <th>#springMessage('table.received.importTime')</th>
    ##备注
        <th>#springMessage('ras.received.Conf.rmk')</th>
    </tr>
    </thead>
    <body>
    #foreach($received in $listReceived)
    <tr>
        <td class="textCenter">
            $!{received.serialNo}
        </td>
        <td class="textCenter">
            $!{received.orderNo}
        </td>
        <td class="textCenter">
            $!number.formatNumeric($!{received.money})
        </td>
        <td class="textCenter">
            $!number.formatNumeric($!{received.transMoney})
        </td>
        <td class="textCenter">
            $!date.format('yyyy-MM-dd',$!{received.transDate})
        </td>
        <td class="textCenter">
            $!{received.payeeAcc}
        </td>
        <td class="textCenter">
            $!{received.payeeAccName}
        </td>
        <td class="textCenter">
            $!{received.payeeBankName}
        </td>
        <td class="textCenter">
            $dictTag.get("RAS_PAY_TYPE",$!{received.dataSource})
        </td>
        <td class="textCenter">
            $!{received.custName}
        </td>
        <td class="textCenter">
            $!{received.custAcc}
        </td>
        <td class="textCenter">
            $!date.format('yyyy-MM-dd',$!{received.createDate})
        </td>
        <td class="textCenter">
            $!{received.rmk}
        </td>
    </tr>
        #end
    </body>
</table>
</div>
    #parse("views/common/footer.vm")
</body>
</html>
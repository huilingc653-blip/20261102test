<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	.layui-table {
            margin: 0px 0;
		}
		body {
			margin-bottom:30px;
		}
    </style>
</head>
<body>
        <input type="hidden" id="bdId" name="bdId" value="$!{rasPosBindingVO.id}">
        <div>
		<h2 class="layui-colla-title">#springMessage('table.rasPosBinding.posBindingInfo')</h2>
			<table class="layui-table">
				<tbody>
					<tr>
						##单位名称
						<td class="textRight">#springMessage('table.rasPosBinding.corpName')</td>
						<td>
							($!{rasPosBindingVO.corpCode})$!{rasPosBindingVO.corpName}
						</td>
						<td class="textRight" width="15%"></td>
						<td width="35%">
						</td>
					</tr>
					<tr>
						##门店名称
						<td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
						<td>
							$!{rasPosBindingVO.shopName}
						</td>
						##门店编码
						<td class="textRight" width="15%">#springMessage('table.rasPosBinding.shopCode')</td>
						<td width="35%">
							$!{rasPosBindingVO.shopCode}
						</td>
					</tr>
					<tr>
						##终端号
						<td class="textRight">#springMessage('table.rasPosBinding.posNo')</td>
						<td width="35%">
							$!{rasPosBindingVO.posNo}
						</td>
						##备注
						<td class="textRight">#springMessage('table.rasPosBinding.rmk')</td>
						<td width="35%">
							$!{rasPosBindingVO.rmk}
						</td>
					</tr>
				</tbody>
			</table>
		<h2 class="layui-colla-title">#springMessage('table.rasPosBinding.borrowInfo')</h2>
			<table class="layui-table layui-form" style="width: 100%;">
				<thead>
				<tr>
					<th>#springMessage('table.rasPosBinding.corpName')</th>
					<th>#springMessage('table.rasPosBinding.shopName')</th>
					<th>#springMessage('table.rasPosBinding.shopCode')</th>
					<th>#springMessage('table.rasPosBinding.status')</th>
					<th>#springMessage('table.rasPosBinding.rmk')</th>
					<th>#springMessage('table.rasPosBinding.createDate')</th>
					<th>#springMessage('table.rasPosBinding.ubdDate')</th>
					<th>#springMessage('table.rasPosBinding.msg')</th>
				</tr>
				</thead>
				<body>
					#if($!rasPosBorrowVOList)
						#foreach($logInfo in $rasPosBorrowVOList)
						<tr>

							<td>$!{logInfo.corpName}</td>
							<td>$!{logInfo.shopName}</td>
							<td>$!{logInfo.shopCode}</td>
							<td>$!{logInfo.statusName}</td>
							<td>$!{logInfo.rmk}</td>
							<td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.bdDate})</td>
							<td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.ubdDate})</td>
							<td>$!{logInfo.msg}</td>
						</tr>
						#end
					#end
				</body>
			</table>
			<br/>
            <br/>
            <br/>
		<h2 class="layui-colla-title">#springMessage('bill.logInfo.title')</h2>
			<table class="layui-table layui-form" style="width: 100%;">
				<thead>
				<tr>
                    <th>#springMessage('table.rasLog.logType')</th>
                    <th>#springMessage('table.rasLog.msg')</th>
                    <th>#springMessage('table.rasLog.createDate')</th>
                    <th>#springMessage('table.rasLog.createBy')</th>
                    <th>#springMessage('table.rasLog.createName')</th>
				</tr>
				</thead>
				<body>
					#if($!logList)
						#foreach($logInfo in $logList)
                        <tr>
                            <td>$!{logInfo.logTypeName}</td>
                            <td>#springMessage($!{logInfo.msg})</td>
                            <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.createDate})</td>
                            <td>$!{logInfo.createBy}</td>
                            <td>$!{logInfo.createName}</td>
                        </tr>
						#end
					#end
				</body>
			</table>
        <div class="layui-form-submit-adaptive" id="buttonDiv">
            <div style="text-align: center;">
                <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.close')</button>
            </div>
        </div>
        </div>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['moneyType','form'], function() {
        var $ = bt.jquery,form = bt.form();

    });

</script>
</html>
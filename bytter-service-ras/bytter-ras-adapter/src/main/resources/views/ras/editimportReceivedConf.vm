<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-form input150-container" method="post">
	  <table class="layui-table">
        <tbody>
        <tr>
		    <td class="textRight" width="15%">#springMessage('table.abVoucherinfo.source')</td>
			<td width="21%"  >
				<div class="layui-inline">
					<div class="bt-biz-dict"  data-disabled="true" data-defaultvalue="$!{pageDateVo.dateSource}" data-callback="selectfileType" data-type="select" id="dateSource" name="dateSource" data-name="dateSource" data-group="RAS_AUDIT_DATASOURCE"></div>
				</div> 
		    </td>
			<td class="textRight" width="15%">#springMessage('table.rasBackOp.payType')</td>
			<td width="35%"> 
				<div class=layui-form>
					<div class="bt-biz-dict"   data-type="select" data-defaultvalue="$!{pageDateVo.payType}" id="payType" name="payType" data-name="payType" data-group="RAS_PAY_TYPE"></div>
				</div>  
            </td>
		   <td class="textRight" width="15%">#springMessage('common.table.filetype')</td>
			<td width="21%">
				<div class=layui-inline>
					<div class="bt-biz-dict" data-disabled="true" data-defaultvalue="$!{pageDateVo.fileType}" data-callback="selectfileType" data-type="select" id="fileType" name="fileType" data-name="fileType" data-group="RAS_IMPORT_FILE_DICT"></div>
				</div> 
		    </td>
        </tr>
        <tr>
            #if(${pageDateVo.fileType}=='txt')##TXT格式才显示
            ##<td class="textRight" id="isFormatText" width="15%">#springMessage('ras.received.import.isseparator')</td>
			<td width="21%" id="isFormatValue"> 
				##<div class=layui-form>
					##<div class="bt-biz-dict" data-type="radio" 
						##data-callback="selectfileType" data-defaultvalue="$!{pageDateVo.isFormat}"
						##data-group="RAS_RECEIVED_SEPARATOR"  name="isFormat" data-filterData="0"
						##data-name="isFormat" data-biz-name="isFormat" data-callback="isFormatCallBack" 
						##id="isFormat">
				##</div>  
			<input  type="hidden" id="isFormat" name="isFormat" value="$!{pageDateVo.isFormat}" autocomplete="off" class="layui-input" >
            ##</td>
            #if(${pageDateVo.isFormat}=='1')##TXT格式才显示
		    <td class="textRight"  id="txtFormatText" width="15%">#springMessage('table.ras.received.import.separator')</td>
			<td width="21%" id="txtFormatValue">
				<div class="layui-inline">
					<input type="text" id="txtFormat" value="$!{pageDateVo.txtFormat}" name="txtFormat" autocomplete="off" class="layui-input" placeholder="#springMessage('table.ras.received.import.separator')"   data-maxlength="200">
				</div>
		    </td>
		   #end
		   #end
		    <td class="textRight" width="15%">#springMessage('table.rasImportconf.begin.row')</td>
			<td width="21%">
				<div class="layui-inline">
					<input type="text" id="startLine" value="$!{pageDateVo.startLine}" lay-verify="required|number" name="startLine" autocomplete="off" class="layui-input" placeholder="#springMessage('table.rasImportconf.begin.row')"   data-maxlength="200">
				</div>
		    </td>
        </tr>
      
        </tbody>
    </table>
    <table  id="appTable" class="layui-table self-adaption" style="width:100%;">
        <thead>
     	<input  type="hidden" id="id" name="id" value="$!{pageDateVo.id}" autocomplete="off" class="layui-input" >
        <tr>
        	#if($!headList)
        	<th></th>
    		#foreach($headSera in $headList)
    			<th>#if(${headSera.required}==true)<span style="color:red;">*</span> #end #springMessage(${headSera.name})</th>
            #end
            #end
        </tr>
         </thead>
         <tbody>
         #if($!headList)
         #if(${pageDateVo.fileType}!='txt')##TXT格式才显示
         <tr>
      		<td>#springMessage('ras.currer.row')</td>
    		#foreach($rasImportConfVO in $headList)
		    <td>
				<input  type="hidden" name="dtlList[${velocityCount}].fieldKey" value="$!{rasImportConfVO.key}" autocomplete="off" class="layui-input" >
				<input  type="hidden" name="dtlList[${velocityCount}].id" value="$!{rasImportConfVO.id}" autocomplete="off" class="layui-input" >
				<input  type="text" name="dtlList[${velocityCount}].startVal" #if(${rasImportConfVO.required}=='true') lay-verify="required" #end value="$!{rasImportConfVO.value}" autocomplete="off" class="layui-input" >
			</td>
            #end
        </tr>
        #end
         #if(${pageDateVo.fileType}=='txt')##TXT格式才显示
         <tr>
        	<td>
        		#if(${pageDateVo.isFormat}=='0')起始位#end
        		#if(${pageDateVo.isFormat}=='1')分隔符读取位置#end
        	</td>
    		#foreach($rasImportConfVO in $headList)
		    <td>
				<input  type="hidden" name="dtlList[${velocityCount}].fieldKey" value="$!{rasImportConfVO.key}" autocomplete="off" class="layui-input" >
				<input  type="hidden" name="dtlList[${velocityCount}].id" value="$!{rasImportConfVO.id}" autocomplete="off" class="layui-input" >
				<input  type="text" name="dtlList[${velocityCount}].startVal" #if(${rasImportConfVO.required}=='true') lay-verify="required" #end value="$!{rasImportConfVO.value}" autocomplete="off" class="layui-input" >
			</td>
            #end
        </tr>
        #if(${pageDateVo.isFormat}=='0')
        #if($!endList)
        <tr>
        	<td>截止位</td>
    		#foreach($endRasImportConfVO in $endList)
		    <td>
				<input  type="text" #if(${endRasImportConfVO.required}=='true') lay-verify="required" #end name="dtlList[${velocityCount}].endVal" value="$!{endRasImportConfVO.value}" autocomplete="off" class="layui-input" >
			</td>
            #end
        </tr>
        #end
        #end
        #end
        #end
         </tbody>
    </table>
     #if($!headList)
     #if(${pageDateVo.fileType}!='txt')##TXT格式才显示
     <span style="color:red;font-weight: bold;">#springMessage('ras.reven.confrm.msg')</span>
      #end
        #if(${pageDateVo.fileType}=='txt')##TXT格式才显示
            #if(${pageDateVo.isFormat}=='1')
           		<span style="color:red;font-weight: bold;">#springMessage('ras.reven.confrm.msg')</span>
        	 #end
        	 #if(${pageDateVo.isFormat}=='0')
           		<span style="color:red;font-weight: bold;">#springMessage('ras.reven.confrm.msg')</span>
        	 #end
        #end
      #end
        <div class="layui-form-submit-adaptive">
        <div style="text-align: center;">
            <button class="layui-btn" lay-submit="" lay-filter="save" value="submit">#springMessage('common.button.submit')</button>
        	<button class="layui-btn" type="button" id="cancel">#springMessage('common.button.cancel')</button>
        </div>
   </div>	
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ras/importReceivedConf.add.js?_btv=${resourceVersion}"></script>
</html>

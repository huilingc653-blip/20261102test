<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	.layui-table {
            margin: 0px 0;
		}
		body {
			margin-bottom:30px;
		}
    </style>
</head>
<body>
	<form class="layui-form" method="post" id="inputForm">
        <input type="hidden" id="bdId" name="bdId" value="$!{rasPosBindingVO.id}">
        <div class="layui-collapse">
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('table.rasPosBinding.lendInfo')</h2>
		<div class="layui-colla-content layui-show">
		<table class="layui-table">
			<tbody>
				<tr>
					##单位名称
					<td class="textRight">#springMessage('table.rasPosBinding.corpName')</td>
					<td>
                        ($!{rasPosBindingVO.corpCode})$!{rasPosBindingVO.corpName}
					</td>
					<td class="textRight" width="15%"></td>
					<td width="35%">
					</td>
				</tr>
				<tr>
					##门店名称
					<td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
					<td>
						$!{rasPosBindingVO.shopName}
					</td>
					##门店编码
					<td class="textRight" width="15%">#springMessage('table.rasPosBinding.shopCode')</td>
					<td width="35%">
                        $!{rasPosBindingVO.shopCode}
					</td>
				</tr>
				<tr>
					##终端号
					<td class="textRight">#springMessage('table.rasPosBinding.posNo')</td>
					<td width="35%">
                        $!{rasPosBindingVO.posNo}
					</td>
					##备注
					<td class="textRight">#springMessage('table.rasPosBinding.rmk')</td>
					<td width="35%">
						$!{rasPosBindingVO.rmk}
					</td>
				</tr>
			</tbody>
		</table>
		</div>
		</div>
		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('table.rasPosBinding.borrowInfo')</h2>
			<div class="layui-colla-content layui-show">
				<table class="layui-table">
					<tbody>
					<tr>
					##单位名称
						<td class="textRight">#springMessage('table.rasPosBinding.corpName')</td>
						<td>
							<div class="layui-input-inline">
								<div class="bt-biz-corp"
									 data-biz-type="corp"
									 data-biz-name="corpId"
									 data-type="selectTree"
									 data-name="corpId"
									 data-scope="all"
									 data-required="true"
									 data-callbackData="corpCallback"
									 placeholder="#springMessage('table.rasPosBinding.corpName')">
								</div>
							</div>
						</td>
						<td class="textRight" width="15%"></td>
						<td width="35%">
						</td>
					</tr>
					<tr>
					##门店名称
						<td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
						<td>
							<div class="layui-input-inline">
								<div class="bt-biz-rasShop" id="shopId" name="shopId" data-name="shopId" data-biz-name="shopId"
									 data-grant-type="audit" data-required="true"   data-callback="shopCallback"> </div>
							</div>
						</td>
					##门店编码
						<td class="textRight" width="15%">#springMessage('table.rasPosBinding.shopCode')</td>
						<td width="35%">
							<input class="layui-input-inline layui-input" type="text" name="shopCode" id="shopCode" disabled></input>
						</td>
					</tr>
					<tr>
					##备注
						<td class="textRight">#springMessage('table.rasPosBinding.rmk')</td>
						<td width="35%">
							<div class="layui-input-inline">
								<input type="text" name="rmk" id="rmk"   autocomplete="off" class="layui-input" lay-verify="strlength" data-maxlength="200"
                                       placeholder="#springMessage('table.rasPosBinding.rmk')">
							</div>
						</td>
                        <td class="textRight"></td>
                        <td width="35%"></td>
					</tr>
					</tbody>
				</table>
			</div>
		</div>
		</div>
		<div class="layui-form-submit-adaptive">
			<div style="text-align: center;">
				<button class="layui-btn" lay-submit="" lay-filter="submit" value="submit">#springMessage('common.button.submit')</button>
				<button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
				<button class="layui-btn layui-btn-primary" type="button" onclick="closeForms()">#springMessage('common.button.cancel')</button>
			</div>
		</div>
	</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ras/rasPosBinding.lend.js?_btv=${resourceVersion}"></script>
</html>
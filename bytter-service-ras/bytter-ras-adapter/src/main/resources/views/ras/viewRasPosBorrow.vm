<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
    <style>
    	.layui-table {
            margin: 0px 0;
		}
		body {
			margin-bottom:30px;
		}
    </style>
</head>
<body>
        <input type="hidden" id="bdId" name="bdId" value="$!{rasPosBindingVO.id}">
        <div class="layui-collapse">
		<div class="layui-colla-item">
		<h2 class="layui-colla-title">#springMessage('table.rasPosBinding.lendInfo')</h2>
		<div class="layui-colla-content layui-show">
		<table class="layui-table">
			<tbody>
				<tr>
					##单位名称
					<td class="textRight">#springMessage('table.rasPosBinding.corpName')</td>
					<td>
                        ($!{rasPosBindingVO.corpCode})$!{rasPosBindingVO.corpName}
					</td>
					<td class="textRight" width="15%"></td>
					<td width="35%">
					</td>
				</tr>
				<tr>
					##门店名称
					<td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
					<td>
						$!{rasPosBindingVO.shopName}
					</td>
					##门店编码
					<td class="textRight" width="15%">#springMessage('table.rasPosBinding.shopCode')</td>
					<td width="35%">
                        $!{rasPosBindingVO.shopCode}
					</td>
				</tr>
				<tr>
					##终端号
					<td class="textRight">#springMessage('table.rasPosBinding.posNo')</td>
					<td width="35%">
                        $!{rasPosBindingVO.posNo}
					</td>
					##备注
					<td class="textRight">#springMessage('table.rasPosBinding.rmk')</td>
					<td width="35%">
						$!{rasPosBindingVO.rmk}
					</td>
				</tr>
			</tbody>
		</table>
		</div>
		</div>
		<div class="layui-colla-item">
			<h2 class="layui-colla-title">#springMessage('table.rasPosBinding.borrowInfo')</h2>
			<div class="layui-colla-content layui-show">
				<table class="layui-table">
					<tbody>
                    <tr>
					##单位名称
                        <td class="textRight">#springMessage('table.rasPosBinding.corpName')</td>
                        <td>
                            ($!{rasPosBorrowVO.corpCode})$!{rasPosBorrowVO.corpName}
                        </td>
						##状态
                        <td class="textRight">#springMessage('table.rasPosBinding.status')</td>
                        <td >
							$!{rasPosBorrowVO.statusName}
                        </td>
                    </tr>
                    <tr>
					##门店名称
                        <td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
                        <td>
							$!{rasPosBorrowVO.shopName}
                        </td>
					##门店编码
                        <td class="textRight" width="15%">#springMessage('table.rasPosBinding.shopCode')</td>
                        <td width="35%">
							$!{rasPosBorrowVO.shopCode}
                        </td>
                    </tr>
                    <tr>
					##绑定时间
                        <td class="textRight">#springMessage('table.rasPosBinding.createDate')</td>
                        <td>
							$!date.format('yyyy-MM-dd HH:mm:ss',$!{rasPosBorrowVO.bdDate})
                        </td>
					##解绑时间
                        <td class="textRight" width="15%">#springMessage('table.rasPosBinding.ubdDate')</td>
                        <td width="35%">
							$!date.format('yyyy-MM-dd HH:mm:ss',$!{rasPosBorrowVO.ubdDate})
                        </td>
                    </tr>
                    <tr>
						##备注
                        <td class="textRight">#springMessage('table.rasPosBinding.rmk')</td>
                        <td width="35%">
							$!{rasPosBorrowVO.rmk}
                        </td>
                        <td class="textRight"></td>
                        <td width="35%">
                        </td>
                    </tr>
					</tbody>
				</table>
			</div>
		</div>
		</div>
        <div class="layui-form-submit-adaptive" id="buttonDiv">
            <div style="text-align: center;">
                <button type="button" class="layui-btn" onclick="closeForms()">#springMessage('common.button.close')</button>
            </div>
        </div>
    #parse("views/common/footer.vm")
</body>
<script type="text/javascript">
    bt.use(['moneyType','form'], function() {
        var $ = bt.jquery,form = bt.form();

    });

</script>
</html>
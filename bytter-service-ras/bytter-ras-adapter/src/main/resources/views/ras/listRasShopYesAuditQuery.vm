<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            ##单位名称
            <td class="textRight" style="width: 7%">#springMessage('table.rasPosBinding.corpName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-scope="all"
                         data-resource="ras:shopYesAudit:op"
                         data-callbackData="corpCallback"
                         placeholder="#springMessage('table.rasPosBinding.corpName')">
                    </div>
                </div>
            </td>
            ##门店名称
            <td class="textRight" style="width: 7%">#springMessage('table.rasPosBinding.shopName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-rasShop" id="shopId" name="shopId" data-name="eqs_shopId"
                         data-biz-name="shopId" data-grant-type="query"> </div>
                </div>
            </td>
            ##稽核码
            <td class="textRight" style="width: 7%">#springMessage('rasAuditInfo.auditNo')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="likes_auditNo" class="layui-input" placeholder="#springMessage('rasAuditInfo.auditNo')">
                </div>
            </td>
        </tr>
        <tr>
            ##缴款方式
            <td class="textRight" style="width: 7%">#springMessage('table.rasBackOp.payType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="RAS_PAY_TYPE" data-name="eqs_payType" data-biz-name="payType"></div>
            </td>
            ##营收(实收)合计
            <td class="textRight" style="width: 7%">#springMessage('table.query.nueOrvedMoney')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_nueOrVedMoney"
                           class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.query.nueOrvedMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_nueOrVedMoney"
                           class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.query.nueOrvedMoney')">
                </div>
            </td>
            ##稽核日期
            <td class="textRight" style="width: 7%">#springMessage('rasAuditInfo.auditDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="ged_auditDate" class="layui-input bt-biz-dateType" data-endid="led_auditDate" data-today="true">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" name="led_auditDate" class="layui-input bt-biz-dateType" id="led_auditDate" data-today="true">
                </div>
            </td>
        </tr>
        <tr>
            ##稽核人
            <td class="textRight" style="width: 7%">#springMessage('rasAuditInfo.auditPeople')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="createBy" class="layui-input" placeholder="#springMessage('rasAuditInfo.auditPeople')">
                </div>
            </td>
            ##是否历史数据
                <td class="textRight" style="width: 7%">#springMessage('table.rasBackOp.isHistory')</td>
                <td>
                    <div class="layui-form">
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isHistory"></div>
                    </div>
                </td>
            <td class="textRight"></td>
            <td>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search">#springMessage('common.button.search')</button>
                <button class="layui-btn layui-btn-primary" type="reset">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('rasAuditInfo.auditNo')</th>
            <th>#springMessage('table.rasPosBinding.corpName')</th>
            <th>#springMessage('table.rasPosBinding.shopName')</th>
            <th>#springMessage('table.query.nueOrvedMoney')</th>
            <th>#springMessage('table.rasBackOp.payType')</th>
            <th>#springMessage('rasAuditInfo.auditDate')</th>
            <th>#springMessage('rasAuditInfo.auditPeople')</th>
            <th>#springMessage('table.query.auditType')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/ras/rasShopYesAuditQuery.list.js?_btv=${resourceVersion}"></script>
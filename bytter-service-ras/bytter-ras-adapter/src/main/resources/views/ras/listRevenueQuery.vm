<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            ##单位名称
            <td class="textRight" style="width: 7%">#springMessage('table.rasPosBinding.corpName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-scope="all"
                         data-resource="ras:revenueQuery:op"
                         data-callbackData="corpCallback"
                         placeholder="#springMessage('table.rasPosBinding.corpName')">
                    </div>
                </div>
            </td>
            ##门店名称 
            <td class="textRight" style="width: 7%">#springMessage('table.rasPosBinding.shopName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-rasShop" id="shopId" name="shopId" data-name="eqs_shopId" data-biz-name="shopId" data-grant-type="query"> </div>
                </div>
            </td>
            ##交易流水号
            <td class="textRight" style="width: 7%">#springMessage('table.revenue.serialNo')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_serialNo" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            ##交易日期
            <td class="textRight" style="width: 7%">#springMessage('table.revenue.transTime')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="ged_transDate" class="layui-input bt-biz-dateType" data-endid="led_transDate" data-today="true">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" name="led_transDate" class="layui-input bt-biz-dateType" id="led_transDate" data-today="true">
                </div>
            </td>
            ##营收金额
            <td class="textRight" style="width: 7%">#springMessage('table.revenue.amt')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_money"
                           class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_money"
                           class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.nisBillhead.payMoney')">
                </div>
            </td>
            ##缴款方式
            <td class="textRight" style="width: 7%">#springMessage('table.rasBackOp.payType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="RAS_PAY_TYPE" data-name="eqs_payType" data-biz-name="payType"></div>
            </td>
        </tr>
        <tr>
            ##状态
            <td class="textRight" style="width: 7%">#springMessage('common.table.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="RAS_AUDIT_STATUS" data-filterData="0,-1,-2" data-defaultvalue="1" data-name="eqi_status" data-biz-name="status"></div>
            </td>
            ##是否历史数据
                <td class="textRight" style="width: 7%">#springMessage('table.rasBackOp.isHistory')</td>
                <td>
                    <div class="layui-form">
                        <div class="bt-biz-dict" data-type="radio" data-group="sf_yn" data-defaultvalue="0" data-name="isHistory"></div>
                    </div>
                </td>
            <td class="textRight"></td>
            <td>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search">#springMessage('common.button.search')</button>
                <button class="layui-btn layui-btn-primary" type="reset">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.revenue.serialNo')</th>
            <th>#springMessage('table.revenue.orderNo')</th>
            <th>#springMessage('table.rasPosBinding.shopName')</th>
            <th>#springMessage('table.rasPosBinding.corpName')</th>
            <th>#springMessage('table.revenue.transTime')</th>
            <th>#springMessage('table.revenue.amt')</th>
            <th>#springMessage('table.rasBackOp.payType')</th>
            <th>#springMessage('table.rasBackOp.custName')</th>
            <th>#springMessage('table.rasBackOp.custAcc')</th>
            <th>#springMessage('table.rasPosBinding.rmk')</th>
            <th>#springMessage('table.revenue.importTime')</th>
            <th>#springMessage('common.table.status')</th>
        </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/ras/rasRevenueQuery.list.js?_btv=${resourceVersion}"></script>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##所属单位
            <td class="textRight">#springMessage('sys.user.corpContain.show')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-scope="all"
                         data-callbackData="corpCallback"
                         data-resource="ras:receivedClaim:op"
                         placeholder="#springMessage('table.rasPosBinding.corpName')">
                    </div>
                </div>
            </td>
            ##门店名称
            <td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-rasShop" id="shopId" name="shopId" data-name="eqs_shopId" data-biz-name="shopId" data-grant-type="audit"> </div>
                </div>
            </td>
            ##缴款方式
            <td class="textRight" >#springMessage('table.rasBackOp.payType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="RAS_PAY_TYPE" data-name="eqs_payType" data-biz-name="payType"></div>
            </td>
        </tr>
        <tr>
            ##交易日期
            <td class="textRight" >#springMessage('ras.received.Conf.transDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="ged_transDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_transDate" id="transDate">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_transDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_transDate">
                </div>
            </td>
            ##交易金额
            <td class="textRight">#springMessage('ras.received.Conf.transMoney')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" name="geg_transMoney" data-moneyendid="endMoney" autocomplete="off" id="transMoney" data-biz-name="transMoney"
                           class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('ras.received.Conf.transMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_transMoney" id="endMoney" autocomplete="off" data-biz-name="endMoney"
                           class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('ras.received.Conf.transMoney')">
                </div>
            </td>
            ##收款账号
            <td class="textRight">#springMessage('ras.received.Conf.payeeAcc')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_payeeAcc" id="payeeAcc" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
        ##认领状态
            <td class="textRight" >#springMessage('table.ras.claimType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="RAS_CLAIM_TYPE" data-defaultvalue="0" data-placeholder="" data-name="eqi_claimType" data-biz-name="claimType" ></div>
            </td>
            <td class="textRight"></td>
            <td >
            </td>
            <td class="textRight"></td>
            <td>
            </td>
        </tr>

        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search">#springMessage('common.button.search')</button>
                <button class="layui-btn layui-btn-primary" type="reset">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.revenue.serialNo')</th>
            <th>#springMessage('table.received.orderNo')</th>
            <th>#springMessage('ras.received.Conf.shopName')</th>
            <th>#springMessage('table.rasPosBinding.corpName')</th>
            <th>#springMessage('ras.received.Conf.payeeAcc')</th>
            <th>#springMessage('ras.received.Conf.payeeAccName')</th>
            <th>#springMessage('ras.received.Conf.payeeBankName')</th>
            <th>#springMessage('table.rasBackOp.payType')</th>
            <th>#springMessage('ras.received.Conf.transDate')</th>
            <th>#springMessage('ras.received.Conf.money')</th>
            <th>#springMessage('ras.received.Conf.yhMoney')</th>
            <th>#springMessage('ras.received.Conf.transMoney')</th>
            <th>#springMessage('ras.received.Conf.custName')</th>
            <th>#springMessage('ras.received.Conf.custAcc')</th>
            <th>#springMessage('table.rasPosBinding.rmk')</th>
            <th>#springMessage('table.received.dataSource')</th>
            <th>#springMessage('rasAuditInfo.status')</th>
            <th>#springMessage('table.ras.claimType')</th>
        </tr>
    </thead>
</table>
<form class="layui-form" method="post" id="inputForm">
    <input type="hidden" id="id" name="id" value="$!{rasReceivedClaimVO.id}">
    <table class="layui-table">
        <tbody>
        <tr>
        ##单位名称
            <td class="textRight">#springMessage('table.rasPosBinding.corpName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="rasCorpId"
                         data-type="selectTree"
                         data-name="rasCorpId"
                         data-scope="all"
                         data-callbackData="rasCorpCallback"
                         data-resource="ras:receivedClaim:op"
                         placeholder="#springMessage('table.rasPosBinding.corpName')">
                    </div>
                </div>
            </td>
        ##门店名称
            <td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-rasShop" id="rasShopId" name="rasShopId" data-name="rasShopId" data-biz-name="rasShopId"
                         data-grant-type="audit"   > </div>
                </div>
            </td>
        ##缴款方式
            <td class="textRight" >#springMessage('table.rasBackOp.payType')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-dict" data-type="select" data-group="RAS_PAY_TYPE" id="rasPayType" name="rasPayType" data-name="rasPayType" data-biz-name="rasPayType"></div>
                </div>
            </td>
        </tr>
        </tbody>
    </table>
</form>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/ras/rasReceivedClaim.list.js?_btv=${resourceVersion}"></script>
<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
			<td class="textRight" width="20%">#springMessage('ras.auditStrategy.name')</td>
			<td width="30%">
				<div class="layui-input-inline">
                	<input type="text" id="name" name="likes_name" class="layui-input">
				</div>
			</td>
			<td class="textRight" width="20%">#springMessage('ras.payType')</td>
			<td width="30%">
				<div class="layui-input-inline">
                	<div class="bt-biz-dict" data-type="mulselect" id="payType" data-name="ins_payType" data-group="RAS_PAY_TYPE"></div>
				</div>
			</td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" type="button" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" type="button" class="layui-btn layui-btn-primary" >#springMessage('common.button.reset')</button>
            </td>
        </tr>
    	</tbody>
    </table>
</form>
    <table id="appTable" class="layui-table layui-form" >
        <thead>
        <tr>
            <th>#springMessage('common.message.sort')</th>
            <th>#springMessage('ras.payType')</th>
            <th>#springMessage('ras.auditStrategy.name')</th>
            <th>#springMessage('ras.auditStrategy.rules')</th>
            <th>#springMessage('common.message.createDate')</th>
            <th>#springMessage('ras.validSign')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ras/rasAuditStrategy.list.js?_btv=${resourceVersion}"></script>
</html>

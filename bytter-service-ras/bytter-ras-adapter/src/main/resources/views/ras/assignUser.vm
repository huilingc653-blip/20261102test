<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input type="hidden" id="accountCorp" value="#if($accountCorp)$accountCorp#end"  />
<input type="hidden" id="innerAccountCorp" value="#if($innerAccountCorp)$innerAccountCorp#end"  />
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
        ## 单位名称
            <td class="textRight">#springMessage('table.rasPosBinding.corpName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-type="selectTree"
                         data-name="corpId"
                         data-callbackData="bt.netChange"
                         data-scope="all"
                         data-placeholder="#springMessage('common.placeholder.select')"></div>
                </div>
            </td>
            ##登录账号
            <td class="textRight">#springMessage('rasShopGrant.loginAcc')</td>
            <td>
                <input type="text" name="loginName" class="layui-input" placeholder="#springMessage('rasShopGrant.loginAcc')">
            </td>
        </tr>
        <tr>
             ##姓名
            <td class="textRight">#springMessage('sys.user.username.show')</td>
            <td>
                <input type="hidden" name="status" value="1">
                <input type="text" name="username" class="layui-input">
            </td>
            <td class="textRight"></td>
            <td>
            </td>
        </tr>
        <tr>
            <td colspan="4" class="text-center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form ">
    <thead>
    <tr>
        <th>#springMessage('rasShopGrant.loginAcc')</th>
        <th>#springMessage('sys.user.username.show')</th>
        <th>#springMessage('sys.user.corpContain.show')</th>
        <th style="width: 120px" class="query"><input class="queryAll" type="checkbox" name="like" lay-skin="primary" lay-filter="queryAll" title="#springMessage('rasShopGrant.assign.query')"/></th>
        <th style="width: 120px" class="canAudit"><input class="canAuditAll" type="checkbox" name="like" lay-skin="primary" lay-filter="canAuditAll" title="#springMessage('rasShopGrant.assign.audit')"/></th>
    </tr>
    </thead>
</table>
<div class="layui-form-item layui-form-submit">
    <div style="text-align: center;">
        <button class="layui-btn" type="button" id="submitAssign">#springMessage('common.button.submit')</button>
    </div>
</div>
<input type="hidden" id="userId" value="$!{userId}"/>
<input type="hidden" id="shopId" value="$!{shopId}"/>
#parse("views/common/footer.vm")
<script src="${basePath}/static/modules/ras/rasShopGrant.assignUser.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<table class="layui-table">
    <thead>
        <tr>
            <th colspan="4" style="text-align:center">#springMessage('table.query.message')</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            ##所属单位
            <td class="textRight" style="width: 15%">#springMessage('table.query.corpName')</td>
            <td style="width: 35%">
                $!{auditInfo.corpCodeAndName}
            </td>
            ##门店名称
            <td class="textRight" style="width: 15%">#springMessage('table.rasPosBinding.shopName')</td>
            <td style="width: 35%">
                $!{auditInfo.shopName}
            </td>
        </tr>
        <tr>
            ##缴款方式
            <td class="textRight">#springMessage('table.rasBackOp.payType')</td>
            <td>
                $dictTag.get("RAS_PAY_TYPE",$!{payType})
            </td>
            #if($!queryType=='different')
                ##确认差异日期
                <td class="textRight">#springMessage('table.query.lessDate')</td>
                <td>
                    $!date.format('yyyy-MM-dd',$!{auditInfo.lessDate})
                </td>
            #else
                <td class="textRight"></td>
                <td>
                </td>
            #end
        </tr>
    </tbody>
</table>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.revenue.serialNo')</th>
            <th>#springMessage('table.received.orderNo')</th>
            <th>#springMessage('table.rasPosBinding.shopName')</th>
            <th>#springMessage('table.rasPosBinding.corpName')</th>
            <th>#springMessage('table.received.payeeAcc')</th>
            <th>#springMessage('table.received.payeeName')</th>
            <th>#springMessage('table.received.payeeBank')</th>
            <th>#springMessage('table.rasBackOp.payType')</th>
            <th>#springMessage('table.revenue.transTime')</th>
            <th>#springMessage('ras.received.Conf.transMoney')</th>
            <th>#springMessage('table.rasBackOp.custName')</th>
            <th>#springMessage('table.rasBackOp.custAcc')</th>
            <th>#springMessage('table.rasPosBinding.rmk')</th>
            <th>#springMessage('table.received.dataSource')</th>
            <th>#springMessage('table.revenue.importTime')</th>
            <th>#springMessage('common.table.status')</th>
        </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script>
    var datatable;
    bt.use(['datatable','moneyType','date','dicts'], function(){
        $ = bt.jquery;
        bt.moneyType.init();
        bt.dicts.init();
        //生成列表
        datatable = bt.datatable.init({
            elem: "#appTable",
            colReorder: true,
            checkbox:true,
            ajax: {
                'url': basePath+"/ras/query/datatableReceivedDifferent/$!{id}/$!{queryType}"
            }
            ,columns: [
                {data:"serialNo",className:'center',bSortable:true},
                {data:"orderNo",className:'center',bSortable:true},
                {data:"shopName",className:'center',bSortable:true},
                {data:"corpName",className:'center',bSortable:true},
                {data:"payeeAcc",className:'center',bSortable:true},
                {data:"payeeAccName",className:'textRight',bSortable:true},
                {data:"payeeBankName",className:'center',bSortable:true},
                {data:"payTypeName",className:'center',bSortable:true},
                {data:"transDate",className:'center',bSortable:true,
                    render: function (data, type, full, meta) {
                        if(full.transDate){
                            return bt.date.format(full.transDate, "yyyy-MM-dd hh:mm:ss");
                        }
                        return "";
                    }
                },
                {data:"transMoney",className:'textRight',bSortable:true,
                    render: function (data, type, full, meta) {
                        return bt.money.format(full.transMoney);
                    }
                },
                {data:"custName",className:'center',bSortable:true},
                {data:"custAcc",className:'center',bSortable:true},
                {data:"rmk",className:'center',bSortable:true},
                {data:"dateSourceName",className:'center',bSortable:true},
                {data:"createDate",className:'center',bSortable:true,
                    render: function (data, type, full, meta) {
                        if(full.createDate){
                            return bt.date.format(full.createDate, "yyyy-MM-dd hh:mm:ss");
                        }
                        return "";
                    }
                },
                {data:"statusName",className:'center',bSortable:true}
            ],
            summary: {
                pageSum: false,
                allSum: true,
                selectSum: true,
                sumTextCol:1,
                format: {
                    decimal: 2
                },
                sumList: [
                    {
                        colNum: '10',
                        dataName: 'transMoney'
                    }
                ]
            }
        });
    });
</script>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位名称
            <td class="textRight">#springMessage('table.rasPosBinding.corpName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-scope="all"
                         data-callbackData="corpCallback"
                         data-resource="ras:shop:op"
                         placeholder="#springMessage('table.rasPosBinding.corpName')">
                    </div>
                </div>
            </td>
            ##门店名称
            <td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-rasShop" id="shopId" name="shopId" data-name="eqs_shopId" data-biz-name="shopId" data-grant-type="audit"> </div>
                </div>
            </td>
        </tr>
        <tr>
            ##退款申请日期
            <td class="textRight" style="width: 7%">#springMessage('table.rasBackOp.backDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="ged_backDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_backDate" data-today="true">
                    <span class="date-mid">~</span>
                    <input type="text" name="led_backDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_backDate" data-today="true">
                </div>
            </td>
            ##退款申请号
            <td class="textRight" style="width: 7%">#springMessage('table.rasBackOp.backNo')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_backNo" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            ##退款订单号
            <td class="textRight" style="width: 7%">#springMessage('table.rasBackOp.orderNo')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_orderNo" class="layui-input">
                </div>
            </td>
            ##缴款方式
            <td class="textRight" style="width: 7%">#springMessage('table.rasBackOp.payType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="RAS_PAY_TYPE" data-name="eqs_payType" data-biz-name="payType"></div>
            </td>
        </tr>
        <tr>
            ##状态
            <td class="textRight" style="width: 7%">#springMessage('common.table.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="RAS_BACK_PAY_STATUS" data-name="eqs_status" data-biz-name="status"></div>
            </td>
            <td class="textRight" style="width: 7%"></td>
            <td>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search">#springMessage('common.button.search')</button>
                <button class="layui-btn layui-btn-primary" type="reset">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.rasPosBinding.shopName')</th>
            <th>#springMessage('table.rasPosBinding.corpName')</th>
            <th>#springMessage('table.rasBackOp.backNo')</th>
            <th>#springMessage('table.rasBackOp.backDate')</th>
            <th>#springMessage('table.rasBackOp.backMoney')</th>
            <th>#springMessage('table.rasBackOp.orderNo')</th>
            <th>#springMessage('table.rasBackOp.orderDate')</th>
            <th>#springMessage('table.rasBackOp.orderMoney')</th>
            <th>#springMessage('table.rasBackOp.recMoney')</th>
            <th>#springMessage('table.rasBackOp.payType')</th>
            <th>#springMessage('table.rasBackOp.custName')</th>
            <th>#springMessage('table.rasBackOp.custAcc')</th>
            <th>#springMessage('table.rasPosBinding.rmk')</th>
            <th>#springMessage('common.table.status')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/ras/rasBackPayOp.list.js?_btv=${resourceVersion}"></script>
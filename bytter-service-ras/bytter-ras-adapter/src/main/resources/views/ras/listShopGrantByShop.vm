<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">

        <table class="layui-table">
            <tr>
##                	授权模式
                <td class="textRight" width="10%">#springMessage('rasShopGrant.chooseAssignType')</td>
                <td colspan="3">
                    <input type="radio" name="chooseAssignType" value="1" lay-filter="chooseAssignType" title="#springMessage('rasShopGrant.chooseAssignType.user')"  />
                    <input type="radio" name="chooseAssignType" value="2" lay-filter="chooseAssignType" title="#springMessage('rasShopGrant.chooseAssignType.shop')"  checked/>
                </td>
            </tr>
            <tr>
                 ##单位名称
                <td class="textRight">#springMessage('table.rasPosBinding.corpName')</td>
                <td width="40%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-biz-name="corpId"
                             data-type="selectTree"
                             data-name="eqs_corpId"
                             data-scope="all"
                             data-callbackData=""
                             placeholder="#springMessage('table.rasPosBinding.corpName')">
                        </div>
                    </div>
                </td>
                 ##门店名称
                <td class="textRight" width="10%">#springMessage('table.rasPosBinding.shopName')</td>
                <td width="40%">
                    <div class="layui-input-inline">
                        <input type="text" name="likes_name" class="layui-input">
                    </div>
                </td>
            </tr>
            <tr>
                ##门店类别
                <td class="textRight">#springMessage('table.rasShop.shopType')</td>
                <td>
                    <div class="bt-biz-dict" data-type="select" data-group="RAS_SHOP_TYPE" data-name="eqs_shopTypeName" ></div>
                </td>
                <td class="textRight"></td>
                <td>
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('table.rasPosBinding.corpName')</th>
        <th>#springMessage('table.rasPosBinding.shopName')</th>
        <th>#springMessage('table.rasShop.shopType')</th>
        <th>#springMessage('table.rasShop.shopName')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>

#parse("views/common/footer.vm")
<script src="${basePath}/static/modules/ras/rasShopGrantByShop.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

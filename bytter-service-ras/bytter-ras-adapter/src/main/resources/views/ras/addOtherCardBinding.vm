<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
     <style>
    	.layui-table {
            margin: 0px 0;
		}
    </style>
</head>
<body>
	<form class="layui-form" method="post">
			<table class="layui-table">
			<tbody>
			<tr>
				##所属单位
				<td class="textRight" width="15%">#springMessage('table.sysCorp.corpName')</td>
				<td>
	                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
						        data-biz-type="corp"
								data-type="selectTree"
								id="corpId"
								data-name="corpId"
								data-required="true"
								data-biz-name="corpId"
								data-resource="ras:otherCardBinding:op"
								data-placeholder="#springMessage('table.sysCorp.corpName')"
								data-callbackdata="corpCallback">
					</div>
                    </div>
                </td>
        		<td class="textRight" width="15%"></td>
				<td width="35%">
			    </td>
		   </tr>
	        <tr>
	        	##门店名称
				<td class="textRight" width="15%">#springMessage('table.rasPosBinding.shopName')</td>
				<td width="35%">
						<div class="layui-input-inline">
							<div class="bt-biz-rasShop" id="shopId" name="shopId" data-name="shopId" data-biz-name="shopInfo" data-grant-type="audit" data-required="true" data-callback="shopCallback" > </div>
						</div>
				</td>
               ##门店编码
				<td class="textRight" width="15%">#springMessage('table.rasPosBinding.shopCode')</td>
				<td width="35%">
		 			 <input type="text" id="shopCode"  data-callback="shopCallback" name="shopCode" autocomplete="off" class="layui-input" placeholder="#springMessage('table.rasPosBinding.shopCode')" data-required="true" readonly  data-maxlength="100">
                </td>
			 </tr>
			 <tr>
	        	##缴费方式
				<td class="textRight" width="15%">#springMessage('table.rasBackOp.payType')</td>
				<td width="35%">
					<div class=layui-form>
						<div class="bt-biz-dict" data-filterData="001,006" data-required="true" data-type="select" id="payType" name="payType" data-name="payType" data-group="RAS_PAY_TYPE"></div>
					</div>
                </td>
				##账号
				<td class="textRight" width="15%">#springMessage('table.rasothercardbinding.accNo')</td>
				<td width="35%">
					<div class="layui-inline">
						<input type="text" id="accNo" name="accNo" autocomplete="off" lay-verify="required|strlength"  class="layui-input" placeholder="#springMessage('table.rasothercardbinding.accNo')"   data-maxlength="50">
					</div>
                </td>
              </tr>
              <tr>
	        	##账户名称
				<td class="textRight" width="15%">#springMessage('table.rasbankcardbinding.bankName')</td>
				<td width="35%">
					<div class="layui-inline">
						<input type="text" id="accName" name="accName" autocomplete="off" lay-verify="required|strlength" class="layui-input" placeholder="#springMessage('table.rasbankcardbinding.bankName')"   data-maxlength="200">
					</div>
                </td>
                ##备注
				<td class="textRight" width="15%">#springMessage('table.rasbankcardbinding.rmk')</td>
				<td width="35%">
					<div class="layui-inline">
						<input type="text" id="rmk" name="rmk" autocomplete="off" class="layui-input" placeholder="#springMessage('table.rasbankcardbinding.rmk')"   data-maxlength="200">
					</div>
                </td>
              </tr>
				</tbody>
             </table>
            <div class="layui-form-submit-adaptive">
                <div style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="save" value="submit">#springMessage('common.button.submit')</button>
                    <button class="layui-btn" type="reset" lay-filter="reset" id="reset">#springMessage('common.button.reset')</button>
                	<button class="layui-btn" type="button" id="cancel">#springMessage('common.button.cancel')</button>
                </div>
            </div>
</form>
    #parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ras/rasOtherCardBinding.add.js?_btv=${resourceVersion}"></script>
</html>
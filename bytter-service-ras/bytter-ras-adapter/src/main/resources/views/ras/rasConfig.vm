    #parse("views/common/footer.vm")
<script>
	var form ={};
	var dicts={};
	var corps={};
	var rasShops={};
	var moneyType={};
    bt.use(['form','layedit','jquery','element','dicts','corp','moneyType','rasShop'], function(){
        form = bt.form(),$  = bt.jquery;
        //监听提交
        form.on('submit(configSubmit)', function(data){
            $.post(basePath + "/sys/config/save",data.field,function(result){
                parent.layer.alert(result.msg, {icon: result.success?1:2});
            },"JSON");
            return false;
        });
        dicts=bt.dicts.init();
        corps=bt.corp.init();
        rasShops=bt.rasShop.init();
    	moneyType = bt.moneyType.init();
    });

				<td width="80%">
				<div class="layui-input-inline">
				<input type="text" id="receivedRollDay" name="ras.receivedRollDay" autocomplete="off" lay-verify="required" class="layui-input bt-biz-moneyType" data-decimal="0" data-min="0" data-max="1000" value="$!{config.ras.receivedRollDay}"  >
				</div>
				</td>
			</tr>
			<tr>
				<td class="textRight">#springMessage('config.ras.defaultAuditUser')</td>
				<td>
				<div class="layui-input-inline">
				<input type="text" id="defaultAuditUser" name="ras.defaultAuditUser" autocomplete="off" class="layui-input" lay-verify="required|strlength" data-maxlength="20" value="$!{config.ras.defaultAuditUser}" >
				</div>
				</td>
			</tr>

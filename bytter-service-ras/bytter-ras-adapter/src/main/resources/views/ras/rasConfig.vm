				#else
					<input type="text" id="historyMoveDay" name="ras.historyMoveDay" autocomplete="off" lay-verify="required" class="layui-input bt-biz-moneyType" data-decimal="0" data-min="1" data-max="1000" value="$!{config.ras.historyMoveDay}"  >

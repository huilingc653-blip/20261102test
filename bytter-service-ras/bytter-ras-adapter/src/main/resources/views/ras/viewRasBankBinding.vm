<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form layui-form-pane">
		<table class="layui-table">
			<tbody>
				<tr>
					##单位名称
					<td class="textRight">#springMessage('table.sysCorp.corpName')</td>
					<td width="35%">
						($!{rasBankCardBindingVo.corpCode})$!{rasBankCardBindingVo.corpName}
                    </td>
                    
                    <td class="textRight"></td>
					<td width="35%">
                    </td>
				</tr>
				<tr>
					##门店名称
					<td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
					<td width="35%">
						$!{rasBankCardBindingVo.shopName}
                    </td>
					##门店编码        		
					<td class="textRight">#springMessage('table.rasPosBinding.shopCode')</td>
					<td width="35%">
						$!{rasBankCardBindingVo.shopCode}
                    </td>
				</tr>
				<tr>
					##是否虚拟账号
					<td class="textRight">#springMessage('table.rasbankcardbinding.isVirtualAcc')</td>
					<td width="35%">
						$!{rasBankCardBindingVo.isVirtualAccName}
                    </td>
					##银行账户
					<td class="textRight">#springMessage('table.rasbankcardbinding.bankNo')</td>
					<td>
						$!{rasBankCardBindingVo.accNo}
                    </td>
				</tr>
				<tr>
					##账号名称
					<td class="textRight">#springMessage('table.rasbankcardbinding.bankName')</td>
					<td>
						$!{rasBankCardBindingVo.accName}
                    </td>
					##开户行名称
					<td class="textRight">#springMessage('table.rasbankcardbinding.bankAccName')</td>
					<td>
						$!{rasBankCardBindingVo.accBankName}
                    </td>
				</tr>
				<tr>
					##关联实体账户
					<td class="textRight">#springMessage('table.rasbankcardbinding.entityAcc')</td>
					<td>
						$!{rasBankCardBindingVo.entityAccNo}
                    </td>
					<td class="textRight"></td>
					<td>
                    </td>
				</tr>
				<tr>
					##付款人开户行
					<td class="textRight">#springMessage('table.rasbankcardbinding.rmk')</td>
					<td>
						$!{rasBankCardBindingVo.rmk}
                    </td>
					##状态
					<td class="textRight">#springMessage('table.rasbankcardbinding.bankStatus')</td>
					<td>
						$!{rasBankCardBindingVo.validSignName}
                    </td>
				</tr>
            </tbody>
        </table>
	<div>
		<table id="appTable" class="layui-table layui-form" style="width:100%;">
            <thead>
                <tr>
                    <th>#springMessage('table.bvLog.logType')</th>
                    <th>#springMessage('table.bvLog.msg')</th>
                    <th>#springMessage('table.bvLog.createName')</th>
                    <th>#springMessage('table.bvLog.createBy')</th>
                    <th>#springMessage('table.bvLog.createDate')</th>
                </tr>
            </thead>
           <body>
        		#if($!raslogList)
        		#foreach($bvLog in $raslogList)
        		<tr>
                <td>$!{bvLog.logTypeName}</td>
				#if($!{bvLog.msg})
                <td>#springMessage($!{bvLog.msg})</td>
				#else
                <td></td>
				#end
                <td>$!{bvLog.createName}</td>
                <td>$!{bvLog.createBy}</td>
                <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{bvLog.createDate})</td>
        		</tr>
                #end
                #end
            </body>
    	</table>
	</div>	
	</form>
    #parse("views/common/footer.vm")
</body>
</html>

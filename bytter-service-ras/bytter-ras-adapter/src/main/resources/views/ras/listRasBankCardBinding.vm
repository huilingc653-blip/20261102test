<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form input150-container">
    <table class="layui-table">
        <tbody>
        <tr>
				<td class="textRight">#springMessage('table.sysCorp.corpName')</td>
				<td>
					<div class="layui-input-inline">
                            <div class="bt-biz-corp"
                                 data-biz-type="corp"
                                 data-biz-name="corpId"
                                 data-type="selectTree"
                                 data-name="eqs_corpId"
                                 data-scope="all"
                                 data-resource="ras:bankCardBinding:op"
                                 data-callbackData="corpCallback"
                                 placeholder="#springMessage('table.sysCorp.corpName')">
                            </div>
                    </div>
				</td>
				<td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
				<td>
					<div class="layui-input-inline">
							<div class="bt-biz-rasShop" id="shopId" name="shopId" data-name="eqs_shopId" data-biz-name="shopInfo" data-grant-type="audit"> </div>
					</div>
				</td>
				
				<td class="textRight">#springMessage('table.rasbankcardbinding.bankNo')</td>
				<td>
					<div class="layui-input-inline">
                    	<input type="text" id="accNo" name="likes_accNo" class="layui-input">
					</div>
				</td>
				
        </tr>

            <tr>
                <td colspan="6" style="text-align: center;">
                    <button class="layui-btn" type="button" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" type="button" class="layui-btn layui-btn-primary" onclick="resetUpdate()">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </tbody>
    </table>
</form>
    <table id="appTable" class="layui-table layui-form" style="width:100%;">
        <thead>
        <tr>
            <th>#springMessage('table.rasPosBinding.corpName')</th>
            <th>#springMessage('table.rasPosBinding.shopCode')</th>
            <th>#springMessage('table.rasPosBinding.shopName')</th>
            <th>#springMessage('table.rasbankcardbinding.isVirtualAcc')</th>
            <th>#springMessage('table.rasbankcardbinding.bankNo')</th>
            <th>#springMessage('table.rasbankcardbinding.bankName')</th>
            <th>#springMessage('table.rasbankcardbinding.bankAccName')</th>
            <th>#springMessage('table.rasbankcardbinding.rmk')</th>
            <th>#springMessage('table.rasbankcardbinding.bankStatus')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
        </thead>
    </table>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ras/rasBankCardBinding.list.js?_btv=${resourceVersion}"></script>
</html>

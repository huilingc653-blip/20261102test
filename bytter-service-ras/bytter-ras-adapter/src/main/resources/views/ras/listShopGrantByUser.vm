<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <form id="searchForm" class="layui-form">

        <table class="layui-table">
            <tr>
##                	授权模式
                <td class="textRight" width="10%">#springMessage('rasShopGrant.chooseAssignType')</td>
                <td colspan="3">
                    <input type="radio" name="chooseAssignType" value="1" lay-filter="chooseAssignType" title="#springMessage('rasShopGrant.chooseAssignType.user')" checked />
                    <input type="radio" name="chooseAssignType" value="2" lay-filter="chooseAssignType" title="#springMessage('rasShopGrant.chooseAssignType.shop')"  />
                </td>
            </tr>
            <tr>
                 ##单位名称
                <td class="textRight">#springMessage('table.rasPosBinding.corpName')</td>
                <td width="40%">
                    <div class="layui-input-inline">
                        <div class="bt-biz-corp"
                             data-biz-type="corp"
                             data-type="selectTree"
                             data-name="corpId"
                             data-callbackData="bt.netChange"
                             data-scope="all"
                             data-placeholder="#springMessage('common.placeholder.select')"></div>
                    </div>
                </td>
                 ##登录账号
                <td class="textRight" width="10%">#springMessage('rasShopGrant.loginAcc')</td>
                <td width="40%">
                    <input type="text" name="loginName" class="layui-input" placeholder="#springMessage('rasShopGrant.loginAcc')">
                </td>
            </tr>
            <tr>
                ##姓名
                <td class="textRight">#springMessage('sys.user.username.show')</td>
                <td>
                    <input type="hidden" name="status" value="1">
                    <input type="text" name="username" class="layui-input">
                </td>
                <td class="textRight"></td>
                <td>
                </td>
            </tr>
            <tr>
                <td colspan="4" style="text-align: center;">
                    <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                    <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
                </td>
            </tr>
        </table>
    </form>

<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
    <tr>
        <th>#springMessage('rasShopGrant.loginAcc')</th>
        <th>#springMessage('sys.user.username.show')</th>
        <th>#springMessage('sys.user.corpContain.show')</th>
        <th>#springMessage('common.table.thead.operation')</th>
    </tr>
    </thead>
</table>

#parse("views/common/footer.vm")
<script src="${basePath}/static/modules/ras/rasShopGrantByUser.list.js?_btv=${resourceVersion}"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input type="hidden" id="id" name="id" value="$!{info.id}" >
		<div class="layui-colla-item">
		<div class="layui-colla-content layui-show" >
			<table class="layui-table">
			<tbody>
	        <tr>
	        	##稽核规则名称
				<td class="textRight" width="15%">#springMessage('ras.auditStrategy.name')</td>
				<td width="35%"> 
    				<div class="layui-input-inline">
                    	<input style="display: inline;" type="text" name="name" class="layui-input" lay-verify="required|strlength" data-maxlength="200"  placeholder="#springMessage('ras.auditStrategy.name')" value="$!{info.name}" >
    				</div>
				</td>  
               ##缴款方式		
				<td class="textRight" width="15%">#springMessage('ras.payType')</td>   
				<td width="35%">
    				<div class="layui-input-inline">
                    	<div class="bt-biz-dict" data-type="select" data-name="payType" data-biz-name="payType" data-group="RAS_PAY_TYPE" data-required="true" data-callback="funPayTypeSetRules" data-value="$!{info.payType}"></div>
    				</div>
                </td>
			 </tr>
			 <tr>
	        	##排序
				<td class="textRight" width="15%">#springMessage('common.message.sort')</td>
				<td width="35%"> 
    				<div class="layui-input-inline">
							<input type="text" data-name="sortNo" class="layui-input bt-biz-moneyType" lay-verify="required" data-decimal="0"
								placeholder="#springMessage('common.message.sort')" data-biz-name="sortNo" data-min="1" data-max="100" value="$!{info.sortNo}">
    				</div>
                </td>
                ##启用标志
				<td class="textRight" width="15%">#springMessage('ras.validSign')</td>
				<td width="35%">  
    				<div class="layui-input-inline">
                    	<div class="bt-biz-dict" data-type="radio" data-name="validSign" data-biz-name="validSign" data-group="RAS_VALID_SIGN" data-value="$!{info.validSign}"></div>
    				</div>
                </td>  
              </tr>		
            <tr>
	        	##稽核规则
				<td class="textRight" width="15%">#springMessage('ras.auditStrategy.rules')</td>
				<td colspan="3">
    				<div class="layui-input-inline">
                    	<div class="bt-biz-dict" data-type="checkbox" data-name="rulesArray" data-biz-name="rules" data-group="RAS_AUDIT_RULES" data-required="true" data-value="$!{info.rules}" data-displayData="$!{rulesDisplay}" data-filterData="$!{rulesFilter}"></div>
    				</div>
                </td>  
              </tr>	
				</tbody>
             </table>	
  			</div>
            <div class="layui-form-submit-adaptive">
                <div style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="save" value="submit">#springMessage('common.button.submit')</button>
                    <button class="layui-btn layui-btn-primary" type="reset" lay-filter="reset" id="reset">#springMessage('common.button.reset')</button>
                	<button class="layui-btn layui-btn-primary" type="button" onclick="closeForms()">#springMessage('common.button.cancel')</button>
                </div>
            </div>	
            		
		</div>					
					
</form>
    #parse("views/common/footer.vm")
</body> 
<script src="${basePath}/static/modules/ras/rasAuditStrategy.edit.js?_btv=${resourceVersion}"></script>
</html>
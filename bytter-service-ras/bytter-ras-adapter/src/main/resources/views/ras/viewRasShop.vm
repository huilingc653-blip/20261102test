<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
    <table class="layui-table">
        <thead>
            <tr>
                <th colspan="4" style="text-align:center">#springMessage('table.rasShop.message')</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                ##单位名称
                <td class="textRight" style="width: 15%">#springMessage('table.rasPosBinding.corpName')</td>
                <td style="width: 30%">
                    $!{shopPage.corpName}
                </td>
                ##是否单位级别门店
                <td class="textRight" style="width: 15%">#springMessage('table.rasShop.isCorpShop')</td>
                <td style="width: 30%">
                    $!{shopPage.isCorpName}
                </td>
            </tr>
            <tr>
                ##门店编码
                <td class="textRight">#springMessage('table.rasPosBinding.shopCode')</td>
                <td>
                    $!{shopPage.code}
                </td>
                ##门店名称
                <td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
                <td>
                    $!{shopPage.name}
                </td>
            </tr>
            <tr>
                ##门店类别
                <td class="textRight">#springMessage('table.rasShop.shopType')</td>
                <td>
                    $!{shopPage.shopTypeName}
                </td>
                ##开始稽核日期
                <td class="textRight">#springMessage('table.rasShop.auditStartDate')</td>
                <td>
                    $!date.format('yyyy-MM-dd',$!{shopPage.asDate})
                </td>
            </tr>
            <tr>
                ##商户号
                <td class="textRight">#springMessage('table.rasShop.shopNo')</td>
                <td>
                    $!{shopPage.shopNo}
                </td>
                ##商户名称
                <td class="textRight">#springMessage('table.rasShop.shopName')</td>
                <td>
                    $!{shopPage.shopName}
                </td>
            </tr>
            <tr>
                ##尾款阈值
                <td class="textRight">#springMessage('table.rasShop.endCheckMoney')</td>
                <td>
                    $!number.formatNumeric($!{shopPage.ecMoney})
                </td>
                <td class="textRight"></td>
                <td>
                </td>
            </tr>
            <tr>
                ##对应其他系统门店编码
                <td class="textRight">#springMessage('table.rasShop.otherShopCode')</td>
                <td colspan="3">
                    $!{shopPage.extemalNo}
                </td>
            </tr>
            <tr>
                ##备注
                <td class="textRight">#springMessage('table.rasPosBinding.rmk')</td>
                <td colspan="3">
                    $!{shopPage.rmk}
                </td>
            </tr>
        </tbody>
    </table>

    <table class="layui-table layui-form" style="width: 100%;">
        <thead>
            <tr>
                <th colspan="5" style="text-align:center">#springMessage('table.rasShop.logMsg')</th>
            </tr>
        </thead>
        <thead>
        <tr>
            <th>#springMessage('table.rasPosBinding.corpName')</th>
            <th>#springMessage('table.rasPosBinding.shopName')</th>
            <th>#springMessage('table.rasShop.logType')</th>
            <th>#springMessage('table.rasShop.log.opBy')</th>
            <th>#springMessage('table.rasShop.log.opTime')</th>
        </tr>
        </thead>
        <body>
            #if($!shopLogList)
                #foreach($logInfo in $shopLogList)
                <tr>
                    <td>$!{shopPage.corpName}</td>
                    <td>$!{shopPage.name}</td>
                    <td>$!{logInfo.logTypeName}</td>
                    <td>$!{logInfo.createName}</td>
                    <td>$!date.format('yyyy-MM-dd HH:mm:ss',$!{logInfo.createDate})</td>
                </tr>
                #end
            #end
        </body>
    </table>
    #parse("views/common/footer.vm")
</body>
</html>

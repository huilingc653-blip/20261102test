<!DOCTYPE html>
<html lang="en">
<head>
	#parse("views/common/head.vm")
</head>
<body>
<form class="layui-table self-adaption">
	#if($shiro.hasPermission("ras:receivedImportConf:op"))
	<button class="layui-btn" id="btn_add">#springMessage('common.button.add')</button>
	#end
	  <table class="layui-table">
        <thead>
        <tr>
      	 	<th class="center" width="15%">#springMessage('table.bvVouEmployInfo.dataSource')</th>
      	 	<th class="center" width="15%">#springMessage('table.rasBackOp.payType')</th>
      	 	<th class="center" width="15%">#springMessage('ras.RasImportConf.fileType')</th>
      	 	<th class="center" width="15%">#springMessage('ras.RasImportConf.operate')</th>
        </tr>
        </thead>
        	#if($!receivedList)
    		#foreach($received in $receivedList)
    		  <tr>
    			<td class="center">$!{received.dateSourceName}</td>
    			<td class="center">$!{received.payTypeName}</td>
    			<td class="center">$!{received.fileTypeName}</td>
    			<td class="center">					 
    				<button class="layui-btn" id="btn_edit" onclick=edit('$!{received.id}','$!{received.fileType}','$!{received.isFormat}',1)>#springMessage('common.button.edit')</button>
    				<button class="layui-btn" id="btn_del"  onclick=del('$!{received.id}')>#springMessage('common.button.delete')</button>
    			</td>
    		  </tr>
            #end
            #end
    </table>
</form>
	#parse("views/common/footer.vm")
</body>
<script src="${basePath}/static/modules/ras/rasImportReceivedConfConfig.js?_btv=${resourceVersion}"></script>
</html>

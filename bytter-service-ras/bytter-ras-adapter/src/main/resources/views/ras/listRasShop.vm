<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##单位名称
            <td class="textRight" style="width: 7%">#springMessage('table.rasPosBinding.corpName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-scope="all"
                         data-resource="ras:shop:op"
                         placeholder="#springMessage('table.rasPosBinding.corpName')">
                    </div>
                </div>
            </td>
            ##门店编码
            <td class="textRight" style="width: 7%">#springMessage('table.rasPosBinding.shopCode')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_code" class="layui-input">
                </div>
            </td>
            ##门店名称
            <td class="textRight" style="width: 7%">#springMessage('table.rasPosBinding.shopName')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_name" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search">#springMessage('common.button.search')</button>
                <button class="layui-btn layui-btn-primary" type="reset">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.rasPosBinding.shopCode')</th>
            <th>#springMessage('table.rasPosBinding.shopName')</th>
            <th>#springMessage('table.rasPosBinding.corpName')</th>
            <th>#springMessage('table.rasShop.shopType')</th>
            <th>#springMessage('table.rasShop.auditStartDate')</th>
            <th>#springMessage('table.rasShop.endCheckMoney')</th>
            <th>#springMessage('table.rasShop.shopNo')</th>
            <th>#springMessage('table.rasShop.shopName')</th>
            <th>#springMessage('table.rasShop.isCorpShop')</th>
            <th>#springMessage('table.rasPosBinding.rmk')</th>
            <th>#springMessage('table.rasShop.shopStatus')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/ras/rasShop.list.js?_btv=${resourceVersion}"></script>
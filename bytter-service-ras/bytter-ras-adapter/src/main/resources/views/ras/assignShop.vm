<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
<input type="hidden" id="accountCorp" value="#if($accountCorp)$accountCorp#end"  />
<input type="hidden" id="innerAccountCorp" value="#if($innerAccountCorp)$innerAccountCorp#end"  />
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
        ## 单位名称
            <td class="textRight">#springMessage('table.rasPosBinding.corpName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-scope="all"
                         data-callbackData=""
                         placeholder="#springMessage('table.rasPosBinding.corpName')">
                    </div>
                </div>
            </td>
            ##门店名称
            <td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_name" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            ##门店类别
            <td class="textRight">#springMessage('table.rasShop.shopType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="RAS_SHOP_TYPE" data-name="eqs_shopTypeName" ></div>
            </td>
            <td class="textRight"></td>
            <td>
            </td>
        </tr>
        <tr>
            <td colspan="4" class="text-center">
                <button class="layui-btn" lay-submit lay-filter="search" type="button">#springMessage('common.button.search')</button>
                <button type="reset" class="layui-btn layui-btn-primary">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>

<table id="appTable" class="layui-table layui-form ">
    <thead>
    <tr>
        <th>#springMessage('table.rasPosBinding.corpName')</th>
        <th>#springMessage('table.rasPosBinding.shopName')</th>
        <th>#springMessage('table.rasShop.shopType')</th>
        <th>#springMessage('table.rasShop.shopName')</th>
        <th style="width: 120px" class="query"><input class="queryAll" type="checkbox" name="like" lay-skin="primary" lay-filter="queryAll" title="#springMessage('rasShopGrant.assign.query')"/></th>
        <th style="width: 120px" class="canAudit"><input class="canAuditAll" type="checkbox" name="like" lay-skin="primary" lay-filter="canAuditAll" title="#springMessage('rasShopGrant.assign.audit')"/></th>
    </tr>
    </thead>
</table>
<div class="layui-form-item layui-form-submit">
    <div style="text-align: center;">
        <button class="layui-btn" type="button" id="submitAssign">#springMessage('common.button.submit')</button>
    </div>
</div>
<input type="hidden" id="userId" value="$!{userId}"/>
<input type="hidden" id="shopId" value="$!{shopId}"/>
#parse("views/common/footer.vm")
<script src="${basePath}/static/modules/ras/rasShopGrant.assignShop.js?_btv=${resourceVersion}"></script>
</body>
</html>

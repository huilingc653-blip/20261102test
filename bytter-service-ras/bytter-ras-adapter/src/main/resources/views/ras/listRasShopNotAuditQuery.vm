<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>
<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tr>
            ##单位名称
            <td class="textRight" style="width: 7%">#springMessage('table.rasPosBinding.corpName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-scope="all"
                         data-resource="ras:shopNotAudit:op"
                         data-callbackData="corpCallback"
                         placeholder="#springMessage('table.rasPosBinding.corpName')">
                    </div>
                </div>
            </td>
            ##门店名称
            <td class="textRight" style="width: 7%">#springMessage('table.rasPosBinding.shopName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-rasShop" id="shopId" name="shopId" data-name="eqs_shopId"
                         data-biz-name="shopId" data-grant-type="query"> </div>
                </div>
            </td>
            ##营收金额
            <td class="textRight" style="width: 7%">#springMessage('table.revenue.amt')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_nueMoney"
                           class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t20" placeholder="#springMessage('table.revenue.amt')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_nueMoney"
                           class="layui-input bt-biz-moneyType" style="text-align:right" id="t20" placeholder="#springMessage('table.revenue.amt')">
                </div>
            </td>
        </tr>
        <tr>
            ##实收金额
            <td class="textRight" style="width: 7%">#springMessage('table.received.amt')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" data-name="geg_vedMoney"
                           class="layui-input bt-biz-moneyType" style="text-align:right" data-moneyendid="t21" placeholder="#springMessage('table.received.amt')">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" data-name="leg_vedMoney"
                           class="layui-input bt-biz-moneyType" style="text-align:right" id="t21" placeholder="#springMessage('table.received.amt')">
                </div>
            </td>
            ##缴款方式
            <td class="textRight" style="width: 7%">#springMessage('table.rasBackOp.payType')</td>
            <td>
            <div class="bt-biz-dict" data-type="select" data-group="RAS_PAY_TYPE" data-name="eqs_payType" data-biz-name="payType"></div>
            </td>
            ##数据日期
            <td class="textRight" style="width: 7%">#springMessage('table.query.dataDate')</td>
            <td>
                <div class="layui-inline">
                    <input type="text" name="transDateStart" class="layui-input bt-biz-dateType" data-endid="transDateEnd" value="$!{dataDate}">
                </div>
                <span class="date-mid">~</span>
                <div class="layui-inline">
                    <input type="text" name="transDateEnd" class="layui-input bt-biz-dateType" id="transDateEnd" data-today="true">
                </div>
            </td>
        </tr>
        <tr>
            ##状态
            <td class="textRight" style="width: 7%">#springMessage('common.table.status')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="RAS_AUDIT_STATUS" data-filterData="2,3,4,5,6,-1,-2" data-name="eqi_status" data-biz-name="status"></div>
            </td>
            <td class="textRight"></td>
            <td>
            </td>
            <td class="textRight"></td>
            <td>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search">#springMessage('common.button.search')</button>
                <button class="layui-btn layui-btn-primary" type="reset">#springMessage('common.button.reset')</button>
            </td>
        </tr>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('table.rasPosBinding.corpName')</th>
            <th>#springMessage('table.rasPosBinding.shopName')</th>
            <th>#springMessage('table.rasBackOp.payType')</th>
            <th>#springMessage('table.query.dataDate')</th>
            <th>#springMessage('table.query.notAuditNueMoney')</th>
            <th>#springMessage('table.query.notAuditVedMoney')</th>
            <th>#springMessage('common.table.status')</th>
        </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/ras/rasShopNotAuditQuery.list.js?_btv=${resourceVersion}"></script>
<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input type="hidden" id="id" name="id" value="" >
		<div class="layui-colla-item">
		<div class="layui-colla-content layui-show" >
			<table class="layui-table breakRow">
			<tbody>
	        <tr>
	        	##任务名称
				<td class="textRight" width="15%">#springMessage('ras.task.name')</td>
				<td width="35%"> 
    				<div class="layui-input-inline">
                    	<input type="text" name="name" class="layui-input" lay-verify="required|strlength" data-maxlength="200"  placeholder="#springMessage('ras.task.name')" value="" >
    				</div>
				</td>  
	        	##任务编号
				<td class="textRight" width="15%">#springMessage('ras.task.code')</td>
				<td width="35%"> 
    				<div class="layui-input-inline">
                    	<input type="text" name="code" class="layui-input" lay-verify="required|strlength|codeCheck" data-maxlength="10"  placeholder="#springMessage('ras.task.code')" value="" >
    				</div>
				</td>  
			 </tr>
            <tr>
               ##缴款方式		
				<td class="textRight" width="15%">#springMessage('ras.payType')</td>   
				<td colspan="3">
    				<div class="layui-input-inline">
                    	<div class="bt-biz-dict" data-type="checkbox" data-name="payTypeArray" data-biz-name="payType" data-group="RAS_PAY_TYPE" data-required="true"></div>
    				</div>
                </td>
              </tr>	
				</tbody>
             </table>	
  			</div>
            <div class="layui-form-submit-adaptive">
                <div style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="save" value="submit">#springMessage('common.button.submit')</button>
                    <button class="layui-btn layui-btn-primary" type="button" onclick="closeForms()">#springMessage('common.button.cancel')</button>
                </div>
            </div>	
            		
		</div>					
					
</form>
    #parse("views/common/footer.vm")
</body> 
<script src="${basePath}/static/modules/ras/rasAuditTask.add.js?_btv=${resourceVersion}"></script>
</html>
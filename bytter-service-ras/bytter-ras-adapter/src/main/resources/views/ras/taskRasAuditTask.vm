<!DOCTYPE html>
<html lang="en">
<head>
    #parse("views/common/head.vm")
</head>
<body>
	<form class="layui-form" method="post">
		<input type="hidden" id="id" name="id" value="$!{info.id}" >
		<input type="hidden" id="opType" name="opType" value="$!{info.opType}" >
		<input type="hidden" id="payType" name="payType" value="$!{info.payType}" >
		<div class="layui-colla-item">
		<div class="layui-colla-content layui-show" >
			<table class="layui-table">
			<tbody>
	        <tr>
	        	##开始执行日期
				<td class="textRight">#springMessage('ras.task.startDate')</td>
				<td> 
    				<div class="layui-input-inline">
						<input type="text" id="startDate" data-name="startDate" class="layui-input bt-biz-dateType" data-type="date" data-today="true" lay-verify="required" value="$!{info.startDate}"/>
    				</div>
				</td>  
			 </tr>
	        <tr>
	        	##执行周期
				<td class="textRight">#springMessage('table.sysTask.cron')</td>
				<td> 
    				<div class="layui-input-inline">
                    	<input id="cron" class="layui-input" lay-verify="required" disabled="disabled" value="$!{info.taskCron}"/>
    				</div>
				</td>  
			 </tr>
            <tr>
	        	##启用状态
				<td class="textRight">#springMessage('ras.validSign')</td>
				<td> 
    				<div class="layui-input-inline">
                    	<div class="bt-biz-dict" data-type="radio" data-name="validSign" data-biz-name="validSign" data-group="RAS_VALID_SIGN" data-value="$!{info.validSign}"></div>
    				</div>
				</td>  
              </tr>	
				</tbody>
             </table>	
  			</div>
            <div class="layui-form-submit-adaptive">
                <div style="text-align: center;">
                    <button class="layui-btn" lay-submit="" lay-filter="save" value="submit">#springMessage('common.button.submit')</button>
                    <button class="layui-btn" type="button" onclick="executeScan()">#springMessage('common.button.handworkExecute')</button>
                    <button class="layui-btn layui-btn-primary" type="button" onclick="closeForms()">#springMessage('common.button.cancel')</button>
                </div>
            </div>	
            		
		</div>					
					
</form>
    #parse("views/common/footer.vm")
</body> 
<script src="${basePath}/static/modules/ras/rasAuditTask.task.js?_btv=${resourceVersion}"></script>
</html>
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/head.vm")
</head>
<body>

<form id="searchForm" class="layui-form">
    <table class="layui-table">
        <tbody>
        <tr>
            ##所属单位
            <td class="textRight">#springMessage('sys.user.corpContain.show')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-corp"
                         data-biz-type="corp"
                         data-biz-name="corpId"
                         data-type="selectTree"
                         data-name="eqs_corpId"
                         data-scope="all"
                         data-callbackData="corpCallback"
                         data-resource="ras:backAudit:op"
                         placeholder="#springMessage('table.rasPosBinding.corpName')">
                    </div>
                </div>
            </td>
            ##门店名称
            <td class="textRight">#springMessage('table.rasPosBinding.shopName')</td>
            <td>
                <div class="layui-input-inline">
                    <div class="bt-biz-rasShop" id="shopId" name="shopId" data-name="eqs_shopId" data-biz-name="shopId" data-grant-type="audit"> </div>
                </div>
            </td>
            ##缴款方式
            <td class="textRight" >#springMessage('table.rasBackOp.payType')</td>
            <td>
                <div class="bt-biz-dict" data-type="select" data-group="RAS_PAY_TYPE" data-name="eqs_payType" data-biz-name="payType"></div>
            </td>
        </tr>
        <tr>
            ##稽核码
            <td class="textRight">#springMessage('rasAuditInfo.auditNo')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_auditNo" id="auditNo" class="layui-input">
                </div>
            </td>
            ##差异金额
            <td class="textRight">#springMessage('rasAuditInfo.lessMoney')</td>
            <td >
                <div class="layui-input-inline">
                    <input type="text" name="geg_lessMoney" data-moneyendid="endMoney" autocomplete="off" id="lessMoney" data-biz-name="lessMoney"
                           class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('rasAuditInfo.lessMoney')">
                    <span class="date-mid">~</span>
                    <input type="text" name="leg_lessMoney" id="endMoney" autocomplete="off" data-biz-name="endMoney"
                           class="layui-input bt-input-inline  bt-biz-moneyType" placeholder="#springMessage('rasAuditInfo.lessMoney')">
                </div>
            </td>
            ##稽核人
            <td class="textRight">#springMessage('rasAuditInfo.auditPeople')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="likes_createName" id="createName" class="layui-input">
                </div>
            </td>
        </tr>
        <tr>
            ##稽核日期
            <td class="textRight" >#springMessage('rasAuditInfo.auditDate')</td>
            <td>
                <div class="layui-input-inline">
                    <input type="text" name="ged_createDate" class="layui-input bt-input-inline bt-biz-dateType" data-endid="led_createDate" id="createDate" >
                    <span class="date-mid">~</span>
                    <input type="text" name="led_createDate" class="layui-input bt-input-inline bt-biz-dateType" id="led_createDate" >
                </div>
            </td>
            <td class="textRight"></td>
            <td>
            </td>
            <td class="textRight" ></td>
            <td>
            </td>
        </tr>
        <tr>
            <td colspan="6" style="text-align: center;">
                <button class="layui-btn" lay-submit="" type="button" lay-filter="search">#springMessage('common.button.search')</button>
                <button class="layui-btn layui-btn-primary" type="reset">#springMessage('common.button.reset')</button>
            </td>
        </tr>
        </tbody>
    </table>
</form>
<table id="appTable" class="layui-table layui-form" style="width:100%;">
    <thead>
        <tr>
            <th>#springMessage('rasAuditInfo.auditNo')</th>
            <th>#springMessage('table.rasPosBinding.corpName')</th>
            <th>#springMessage('table.rasPosBinding.shopName')</th>
            <th>#springMessage('table.rasBackOp.payType')</th>
            <th>#springMessage('rasAuditInfo.revenueMoneySum')</th>
            <th>#springMessage('rasAuditInfo.receivedMoneySum')</th>
            <th>#springMessage('rasAuditInfo.lessMoney')</th>
            <th>#springMessage('rasAuditInfo.auditDate')</th>
            <th>#springMessage('rasAuditInfo.auditPeople')</th>
            <th>#springMessage('table.rasPosBinding.rmk')</th>
            <th>#springMessage('rasAuditInfo.status')</th>
            <th>#springMessage('table.query.auditType')</th>
            <th>#springMessage('common.table.thead.operation')</th>
        </tr>
    </thead>
</table>
    #parse("views/common/footer.vm")
</body>
</html>
<script src="${basePath}/static/modules/ras/rasAuditBack.list.js?_btv=${resourceVersion}"></script>
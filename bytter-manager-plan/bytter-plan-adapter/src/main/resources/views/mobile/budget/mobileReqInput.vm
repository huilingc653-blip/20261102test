                                    <div class="bt-card" id="voucherFrom">
                                        <div class="bt-card-header">
                                            类别
                                            <input type="hidden" id="timeType" name="timeType" value="">
                                        </div>
                                        ##vcount 下标   velocityCount length
                                    <div class="bt-card-body">
                                        #foreach($data in $!timeTypeList)
                                            #set($vcount = $velocityCount - 1)
                                            #if($!{vcount}%3 == 0)
                                            <div class="ui-row-flex ui-whitespace">
                                            #end
                                            <div class="ui-col ui-col">
                                                <div class="bt-card-item"
                                                     data-value="$!{data.value}">$!{data.name}</div>
                                            </div>
                                            #if($!{foreach.last})
                                                #if($velocityCount % 3 == 1)
                                                    <div class="ui-col ui-col"></div>
                                                    <div class="ui-col ui-col"></div>
                                                </div>
                                                #elseif($velocityCount % 3 == 2)
                                                    <div class="ui-col ui-col"></div>
                                                </div>
                                                #end
                                            #else
                                                #if($velocityCount % 3 == 0)
                                                </div>
                                                #end
                                            #end
                                        #end
                                    </section>
                                    <div class="bt-popup-bottom">
                                        <button type="button" id="clearValue1" class="bt-popup-reset resetBtn">重置</button>
                                        <button type="button" id="submitValue1" class="bt-popup-submit submitBtn">确定</button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                    ##日期控制
                    <div class="popup-block">
                        <div class="ui-actionsheet" id="actionsheet3" style="top:1.4rem;" data-link="btn3">
                            <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 1rem;">
                                <section class="bt-popup-container">
                                    <div class="bt-card" id="checkDate">
                                        <div class="bt-card-header">
                                            日期
                                        </div>
                                        <div class="bt-card-body">
                                            <div class="ui-row-flex ui-whitespace">
                                                <div style="width: 30%;color:#bbb;" class="bt-card-item date" data-begin="" id="startDateBegin">开始时间</div>
                                                <span style="border-bottom: 1px #D3D3D3 solid; width: 0.25rem;display: block;height: 0.23rem;margin-right: 0.1rem;margin-left: 0.1rem"></span>
                                                <div style="width: 30%;color:#bbb;" class="bt-card-item date" data-end="" id="startDateEnd">结束时间</div>
                                            </div>
                                        </div>
                                    </div>
                                </section>
                                <div class="bt-popup-bottom">
                                    <button type="button" id="clearValue3" class="bt-popup-reset resetBtn">重置</button>
                                    <button type="button" id="submitValue3" class="bt-popup-submit submitBtn">确定</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </section>
    <section id="tab1" style="height: 80%; overflow-y: auto;">

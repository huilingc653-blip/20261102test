<script>
    var seachType = ""
    var timer = null

    window.getMobileReqInput = (data)=>{
        clearTimeout(timer);
        timer = setTimeout( function() {
            if(seachType && seachType != "seach"){
                return
            }
            postData(data)
        }, 500);

    }
    window.getSearchMobileReq = (data)=>{
        seachType = "seach"
        searchActionCallback(data)
    }
    // 用于记录页面的查询参数
    const searchParams = {
        corpId: null,
        startDateStr: null,
        endDateStr: null,
        timeType:null,
        resource:'fbs:report:fbsBudget:query'
    };

    /**
     * 搜索回调方法
     * @param data
     */
    window.searchActionCallback = function (data) {
        console.log('1111')
        // 根据data参数，查询数据
        if (data.corpNames && data.corpNames.length > 0) {
            /* let msg = "选择的成员单位名称：" + JSON.stringify(data.corpNames);
             msg = msg + ", 成员单位ID：" + JSON.stringify(data.corpIds)*/
            $("#corpId").val(data.corpNames);
            $("#select_corp").text(data.corpNames);

        } else {
            $("#corpId").val('');
            $("#select_corp").text('');

        }
        if (data.corpIds) {
            searchParams.corpId = data.corpIds;
            setTimeout(function () {
                var data = BTAppBridge.post("/mobile/budget/fbsbudget/getInputMoblieList", searchParams, 'postData');
                uni.postMessage({
                    data:data
                })
            }, 100);
        }
        if (data.datePickData) {
            var dateObj = data.datePickData;
            var startDate = dateObj.startDate;
            var endDate = dateObj.endDate;
            var startTemp = bt.date.format(parseInt(startDate), "yyyy-MM-dd");
            var endTemp = bt.date.format(parseInt(endDate), "yyyy-MM-dd");
            $("#startDateBegin").html(startTemp);
            $("#startDateEnd").html(endTemp);
            $("#startDateBegin").attr("data-begin",startTemp);
            $("#startDateEnd").attr("data-end",endTemp);
        }
    }
    //单位搜索组件
    function openCorpSelectionPage() {
        console.log('2222')
        setTimeout(function () {
            var data = BTAppBridge.openCorpSelectionPage && BTAppBridge.openCorpSelectionPage('searchActionCallback',{resource:'fbs:report:fbsBudget:query'});
            uni.postMessage({
                data:data
            })
        }, 100);

    }
    //时间组件
    function openDatePickerPage() {
        var data = BTAppBridge.openDatePickerPage && BTAppBridge.openDatePickerPage('searchActionCallback');
        uni.postMessage({
            data:data
        })
    }

    (function (doc, win) {

        //初始化数据
        submiteData();
        $('.ui-tab-nav > li').on('click', function () {
            $(this).addClass('current').siblings('li').removeClass('current');
            $('.ui-tab-content>li').removeClass('bt-show');
            $('.ui-tab-content li').eq($(this).index()).addClass('bt-show');
            initChart('pieChart' + $(this).index());
        })

        //搜索框点击
        $('.ui-searchbar').on('click', function () {
            $('.ui-searchbar-wrap').addClass('focus');
            $('.ui-searchbar-input input').focus();
        });
        $('.ui-searchbar-cancel').on('click', function () {
            $('.ui-searchbar-wrap').removeClass('focus');
        });

        //弹框选择
        function addSheet($this,id){
            if( $this.parent().hasClass('active')){
                hideSheet($this);
                return
            }
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
                $this.parent().addClass('active');
            $(id).addClass('show');
        }
        //弹框选择
        function hideSheet($this){
            $('.ui-actionsheet').removeClass('show');
                $this.parent().removeClass('active');
        }

        //业务类别控制
        $("#btn1").click(function () {
            addSheet($(this),'#actionsheet1')
        });
        //日期控制
        $("#btn3").click(function () {
            addSheet($(this),'#actionsheet3')
        });
        //时间选择
        $('.date').on('click', function () {
            openDatePickerPage();
        });


        //单位选择
        $("#corpDiv").click(function () {
            openCorpSelectionPage();
        });

        //数据列表
        postData = function (result) {
            setDataDiv(result);
        }

        //拼装数据列表
        function setDataDiv(data) {
            var showHtml = '';
            for (var i = 0; i < data.length; i++) {
                showHtml += '<div class="box-item" onclick="view(\''+data[i].id+'\')">';
                showHtml += '<div class="box-left-style"></div>';
                showHtml += '<div class="box-left-info">';
                showHtml += '<div class="box-left-info-title">'+data[i].corpName+'</div>';
                showHtml += '<div class="box-left-info-time"><span class="box-left-info-time-style"> </span>开始日期</div>';
                showHtml += '<div class="box-left-info-time-value">'+bt.date.format(data[i].beginDate)+'</div>';
                showHtml += '</div>';
                showHtml += '<div class="box-right-style"><img class="box-right-style-font" src="${basePath}/static/mobile/icon/common/icon_right_arrowlink@2x.png?_btv=${resourceVersion}" /></div>';
                showHtml += '<div class="box-right-info">';
                showHtml += '<div class="box-left-info-time" style="margin-top: 0.37rem"><span class="box-left-info-time-style" style="background-color: #F69154"> </span>结束日期</div>';
                showHtml += '<div class="box-left-info-time-value">'+bt.date.format(data[i].endDate)+'</div>';
                showHtml += '</div>';
                showHtml += '</div>';
            }
            var balDiv = document.getElementById("tab1");
            balDiv.innerHTML = showHtml;
        }

        var ACTIVE = 'active';

        function initCard(id,value,clickCallback,isNotInit){
            if(!id){
                return
            }
            var $card = $(id);
            var hiddenInput = $card.find('.bt-card-header input');
            var items = $card.find('.bt-card-item');
            items.removeClass(ACTIVE);
            hiddenInput.val('');
            //设置选中值
            if(value){
                for( var i=0;i < items.length; i++ ){
                    if(value === $(items[i]).data('value')){
                        $(items[i]).addClass(ACTIVE);
                        hiddenInput.val(value);
                        break
                    }
                }
            }
            if(isNotInit){
                return;
            }

            $(id).on('click','.bt-card-item',function(){
                var value = '';
                if($(this).hasClass(ACTIVE)){ //如果当前被选中时，点击会取消选中
                    $(this).removeClass(ACTIVE);
                } else {
                        $card.find('.bt-card-item').removeClass(ACTIVE);
                    $(this).addClass(ACTIVE);
                    value = $(this).data('value');
                }
                hiddenInput.val(value);
                if(clickCallback){
                    clickCallback(value);
                }
            })
        }

        //初始化
        initCard('#voucherFrom','');

        //点击确定
        $('.submitBtn').on('click',function(){
            var btn = $(this).parents('.ui-actionsheet').removeClass('show')
                    .data('link');
            $('#'+btn).removeClass('active');
            //确认提交
            submiteData();
        })
        //点击重置
        $('#clearValue1').on('click',function(){
            initCard('#voucherFrom','','',true);
        })
        $('#clearValue3').on('click',function(){
            searchParams.startDateStr = null;
            searchParams.endDateStr = null;
            $("#startDateBegin").html("开始时间");
            $("#startDateEnd").html("结束时间");
            $("#startDateBegin").attr("data-begin","");
            $("#startDateEnd").attr("data-end","");
        })

        //数据提交
        function submiteData() {
            console.log('初始化')
            searchParams.startDateStr = $("#startDateBegin").data("begin");
            searchParams.endDateStr =  $("#startDateEnd").data("end");
            searchParams.timeType = $("#timeType").val();
            setTimeout(function () {
                var data = BTAppBridge.post("/mobile/budget/fbsbudget/getInputMoblieList", searchParams, 'postData');
                console.log(JSON.stringify(data))
                uni.postMessage({
                    data: data
                });
            }, 100);
        }
    })(document, window);

    //查看详情页面
    function view(id) {
        setTimeout(function () {
            var data = BTAppBridge.jump({url: "/mobile/budget/fbsbudget/mobileFbsBudgetInfo", id: id});
            uni.postMessage({
                data:data
            })
        }, 100);
    }
</script>
</body>
</html>

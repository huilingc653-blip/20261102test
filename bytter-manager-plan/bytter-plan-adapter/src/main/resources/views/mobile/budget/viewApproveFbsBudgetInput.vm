#* 
*公共审批基础页面
*#
<!DOCTYPE html>
<html>
<head>
    #parse("views/common/waphead.vm")
</head>
<body>
<!-- 系统参数 -->
<input id="id" name="id" type="hidden" value="$!{fbsBudgetPage.id}">
<ul class="mui-table-view" id="mulTable">
    <li class="mui-table-view-cell">
        #springMessage('table.fbsBudget.corpId')
        <span class="mui-badge mui-badge-inverted">
            $!{fbsBudgetPage.corpName}
        </span>
    </li>
	<li class="mui-table-view-cell">
        #springMessage('table.fbsBudget.timeType')
        <span class="mui-badge mui-badge-inverted">
			$dictTag.get("fbs.timeType",$!{fbsBudgetPage.timeType})
        </span>
    </li>
	<li class="mui-table-view-cell">
        #springMessage('table.fbsBudget.checkMoney')
        <span class="mui-badge mui-badge-inverted">
			$!number.formatNumeric($!{fbsBudgetPage.checkMoney})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fbsBudget.enrolDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fbsBudgetPage.enrolDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fbsBudget.beginDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fbsBudgetPage.beginDate})
        </span>
    </li>
	<li class="mui-table-view-cell">
        #springMessage('table.fbsBudget.endDate')
        <span class="mui-badge mui-badge-inverted">
            $!date.format('yyyy-MM-dd',$!{fbsBudgetPage.endDate})
        </span>
    </li>
    <li class="mui-table-view-cell">
        #springMessage('table.fbsBudgetDetail.itemName')
        <span class="mui-badge mui-badge-inverted">
            #springMessage('table.fbsBudgetDetail.bMoney')
        </span>
    </li>
    #foreach($dtl in $dltList)
        <li class="mui-table-view-cell">
           $!{dtl.itemName}
            <span class="mui-badge mui-badge-inverted">
                $!number.formatNumeric($!{dtl.bMoney})
            </span>
        </li>
    #end
</ul>
    #parse("views/common/wapfooter.vm")
</body>
</html>

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>资金计划</title>

</head>
#set($resourceVersion=$resourceVersion.get())
#set($basePath=$springMacroRequestContext.contextPath)
<link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css?_btv=${resourceVersion}">
<style>
    html {
        width: 100%
    }

    body {
        -webkit-user-select: initial;
        background-color: #F5F5F5;
        width: 100%;
        margin: 0;
    }

    .chart-row-container {
        padding-top: 5px;
        padding-bottom: 5px;
    }

    .row-item-icon-parent-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0px 10px 0px 0px;
    }

    .row-item-icon-container {
        display: flex;
        width: 42px;
        height: 42px;
        border-radius: 50px;
        justify-content: center;
        align-items: center;
    }

    .row-arrowlink-icon-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-right: 15px;
    }

    .chart-name-text {
        font-size: 16px;
        color: #333333;
        font-weight: bold;
    }

    .chart-description-text {
        margin-top: 5px;
        font-size: 14px;
        color: #999999;
    }

    .icon-right-arrowlink {
        width: 6px;
        height: 11px;
    }

</style>

<section class="ui-container">
    <ul class="ui-list ui-list-link ui-border-tb">

        <li id="row1Element"
            class="chart-row-container ui-border-t">
            <div class="row-item-icon-parent-container">
                <div class="row-item-icon-container" style="background-color: #D5F9FF;">
                    <img width="20px" height="20px"
                         src="${basePath}/static/mobile/icon/chartModule/fbsbudgetInput.png"/>
                </div>
            </div>
            <div class="ui-list-info">
                <h4 class="ui-nowrap chart-name-text">
                    计划上报
                </h4>
                <p class="ui-nowrap chart-description-text">上报情况汇总表</p>
            </div>
            <div class="row-arrowlink-icon-container">
                <img class="icon-right-arrowlink"
                     src="${basePath}/static/mobile/icon/common/icon_right_arrowlink@2x.png"/>
            </div>
        </li>

        <li id="row2Element"
            class="chart-row-container ui-border-t">
            <div class="row-item-icon-parent-container">
                <div class="row-item-icon-container" style="background-color: #FFECDE;">
                    <img width="20px" height="20px"
                         src="${basePath}/static/mobile/icon/chartModule/fbsbudgetprocess.png"/>
                </div>
            </div>
            <div class="ui-list-info">
                <h4 class="ui-nowrap chart-name-text">
                    计划执行
                </h4>
                <p class="ui-nowrap chart-description-text">执行情况汇总表</p>
            </div>
            <div class="row-arrowlink-icon-container">
                <img class="icon-right-arrowlink"
                     src="${basePath}/static/mobile/icon/common/icon_right_arrowlink@2x.png"/>
            </div>
        </li>


    </ul>


</section>
<script src="${basePath}/static/plugins/frozen/js/zepto.min.js?_btv=${resourceVersion}"></script>
<script type="text/javascript">
    (function (doc, win) {

        $("#row1Element").click(function () {
            setTimeout(function () {
                BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
                    tabsData: [
                        {
                            url: '/mobile/budget/fbsbudget/mobileReqInput',
                            tabName: '计划上报'
                        },
                    ],
                    headerTitle: '计划上报'
                });
            }, 100);
        });
        $("#row2Element").click(function () {
            setTimeout(function () {
                BTAppBridge.openChartTabPage && BTAppBridge.openChartTabPage({
                    tabsData: [
                        {
                            url: '/mobile/budget/fbsbudget/mobileReqProess',
                            tabName: '计划执行'
                        },
                    ],
                    headerTitle: '计划执行'
                });
            }, 100);
        });
    })(document, window);
</script>


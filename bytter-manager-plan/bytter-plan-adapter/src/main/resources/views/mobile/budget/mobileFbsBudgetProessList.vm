            </span>
                <span>$!{fbsBudgetVO.corpName}</span>
            </div>
            <div class="box-left-info-item">类型： $dictTag.get("fbs.timeType",$!{fbsBudgetVO.timeType})</div>
            <div class="box-left-info-item" style="margin-top: 0.77rem">周期： $!date.format('yyyy-MM-dd',$!{fbsBudgetVO.beginDate})-$!date.format('yyyy-MM-dd',$!{fbsBudgetVO.endDate})</div>
            <div class="box-right-item">币别：$!{fbsBudgetVO.curName}</div>
            <div class="box-right-item" style="margin-top: 0.77rem"></div>
        </div>
        <div class="ui-tab ">
            <ul class="ui-tab-content" style="width:100%">
                <li class="bt-show">
                    <div class="ui-btn-wrap bt-select-popup-right">
                        ##筛选
                        <div class="bt-select-popup">
                            <input type="text" id="btn1" readonly="readonly" placeholder="筛选" value="筛选"
                                   style="width: 0.8rem">
                        </div>
                        ##筛选控制
                        <div class="popup-block">
                            <div class="ui-actionsheet" id="actionsheet1" style="height:40%;top:1.4rem;" data-link="btn1">
                                <div class="ui-actionsheet-cnt am-actionsheet-down" style="top: 1.4rem;">
                                    <section class="bt-popup-container" style="height: 40%">
                                        <div class="bt-card" id="voucherFrom">
                                            <div class="bt-card-header">
                                                <input type="hidden" id="col" name="col" value="">
                                            </div>
                                            ##vcount 下标   velocityCount length
                                            <div class="bt-card-body">
                                                <div class="ui-row-flex ui-whitespace">
                                                    <div class="ui-col ui-col"><div class="bt-card-item" data-value="1" style="font-size: 10px">上报金额</div></div>
                                                    <div class="ui-col ui-col"><div class="bt-card-item" data-value="2" style="font-size: 10px">追加金额(已追加)</div></div>
                                                    <div class="ui-col ui-col"><div class="bt-card-item" data-value="3" style="font-size: 10px">追加金额(在途)</div></div>
                                                </div>
                                                <div class="ui-row-flex ui-whitespace">
                                                    <div class="ui-col ui-col"><div class="bt-card-item" data-value="4" style="font-size: 10px">上报合计金额</div></div>
                                                    <div class="ui-col ui-col"><div class="bt-card-item" data-value="5" style="font-size: 10px">执行金额(内部-占用)</div></div>
                                                    <div class="ui-col ui-col"><div class="bt-card-item" data-value="6" style="font-size: 10px">执行金额(内部-在途)</div></div>
                                                </div>
                                                <div class="ui-row-flex ui-whitespace">
                                                    <div class="ui-col ui-col"><div class="bt-card-item" data-value="7" style="font-size: 10px">执行金额(外部-占用)</div></div>
                                                    <div class="ui-col ui-col"><div class="bt-card-item" data-value="8" style="font-size: 10px">执行金额(外部-在途)</div></div>
                                                    <div class="ui-col ui-col"><div class="bt-card-item" data-value="9" style="font-size: 10px">可用金额</div></div>
                                                </div>
                                                <div class="ui-row-flex ui-whitespace">
                                                    <div class="ui-col ui-col"><div class="bt-card-item" data-value="10" style="font-size: 10px">执行比例</div></div>
                                                    <div class="ui-col ui-col"><div class="bt-card-item" data-value="11" style="font-size: 10px">误差率</div></div>
                                                    <div class="ui-col ui-col"><div class="bt-card-item" data-value="12" style="font-size: 10px">可用金额占比</div></div>
                                                </div>
                                            </div>
                                        </div>
                                    </section>
                                    <div class="bt-popup-bottom">
                                        <button type="button" id="clearValue1" class="bt-popup-reset resetBtn">重置</button>
                                        <button type="button" id="submitValue1" class="bt-popup-submit submitBtn">确定</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </div>
    </section>

<html>
<head>
    #set($resourceVersion=$resourceVersion.get())
    #set($basePath=$springMacroRequestContext.contextPath)
    <meta charset="UTF-8">
    <meta http-equiv="Content-Security-Policy" content="font-src *  data:">
    <meta name="viewport"
          content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0, user-scalable=no">
    <title>执行情况明细</title>
    <!-- 引入 FrozenUI -->
    <link rel="stylesheet" href="${basePath}/static/mobile/plugins/fixedTable/table.min.css?_btv=${resourceVersion}">
    <link rel="stylesheet" href="${basePath}/static/plugins/frozen/css/frozenui.css" media="all"/>
    <link rel="stylesheet" href="${basePath}/static/css/mobile/index.css" media="all"/>
    <style>
        body{
            font-size: 0;
        }
        .cho-body {
            background-color: #F5F5F5;
        }

        #tab {
            background: rgba(255, 255, 255, 1);
        }

        .popup-block * {
            font-size: 0.14rem;
        }

        .ui-tab-content li {
            display: none;
        }

        .ui-tab-content li.bt-show {
            display: list-item;
        }

        /* 弹框选择 */
        .bt-select-popup {
            position: relative;
            margin-right: 10px;
        }

        .ui-actionsheet {
            display: none
        }

        .ui-actionsheet.show {
            display: block;
        }

        .ui-actionsheet.show .ui-actionsheet-cnt {
            transition: none;
        }

        .ui-actionsheet .ui-actionsheet-cnt {
            transition: none;
        }

        .bt-select-popup input {
            border: none;
            width: 0.58rem;
            height: 0.32rem;
            background-color: #F5F5F5;
            border-radius: 0.16rem;
            padding: 0 0.15rem;
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 600;
            color: rgba(102, 102, 102, 1);
        }

        .bt-select-popup.active input {
            color: #2988FF;
            background-color: #E9F1FF;
        }

        .bt-select-popup.active:after {
            color: #2988FF;
        }

        .ui-btn-wrap {
            font-size: 14px;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 500;
            color: rgba(51, 51, 51, 1);
            margin-left: 0;
            padding-left: 0.12rem;
        }

        .ui-row-flex .ui-col {
            text-align: center;
        }

        .ui-btn-date input {
            border: none;
            width: 0.64rem;
            height: 0.12rem;
            background-color: #F5F5F5;
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(51, 51, 51, 1);
            line-height: 0.14rem;
            text-align: center;
        }


        #tab1 {
            background-color: #F5F5F5;
            margin-top: 0.04rem;
        }


        .nis-tab-title span {
            display: inline-block;
            height: 0.24rem;
            border-radius: 0.12rem;
            margin: 0.06rem;
            margin-top: 0.1rem;
            color: #333;
            padding: 0 0.1rem;
            font-size: 0.14rem;
            font-family: PingFangSC-Regular, PingFang SC;
            margin-left: 0;
        }

        .nis-tab-title span:nth-child(3) {
            margin-right: 0;
        }

        .nis-tab-title .active {
            background-color: #2988FF;
            color: #fff !important;
        }

        .cho-date-item-bottom > div > div {
            font-size: 0.12rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
            line-height: 0.22rem;
            height: 0.22rem;
        }
            ##调拨数据样式
        #tab1 .cho-content-item {
            height: 70px;
            background: rgba(255, 255, 255, 1);
            border-radius: 0.06rem;
            margin: 0.1rem 0.15rem;
            margin-top: 0;
        }

        .cho-content-item .cho-content-item-money-left {
            width: 108px;
            height: 18px;
            font-size: 18px;
            font-family: DINAlternate-Bold, DINAlternate;
            font-weight: bold;
            color: rgba(51, 51, 51, 1);
            line-height: 18px;
            padding: 0.14rem 0.14rem;
        }


        .cho-content-item .cho-content-item-date-right {
            font-size: 12px;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(153, 153, 153, 1);
            line-height: 12px;
            padding-top: 0.18rem;
            padding-right: 0.18rem;
            text-align: right;
        }




        /*网格一排三个选择*/
        .bt-card {
            background-color: #fff;
        }

        .bt-card .active {
            color: #2988FF;
            font-weight: 700;
        }

        .bt-card-header {
            font-size: 0.14rem;
            font-family: PingFangSC-Medium, PingFang SC;
            font-weight: 700;
            color: rgba(51, 51, 51, 1);
            line-height: 0.35rem;
            height: 0.35rem;
            padding-left: 0.1rem;
            text-align: left;
        }

        .bt-card-body {
            padding-bottom: 0.15rem;
        }

        .bt-card-item {
            height: 0.34rem;
            background: rgba(240, 240, 240, 1);
            border-radius: 0.18rem;
            line-height: 0.34rem;
            text-align: center;
            margin: 0.05rem 0.1rem 0.05rem 0;
            font-size: 0.14rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
            color: rgba(102, 102, 102, 1);
        }

        .bt-card-body .ui-col:nth-last-child(1) .bt-card-item {
            margin-right: 0;
        }

        /*浮框的按钮*/
        .bt-popup-bottom button {
            height: 0.4rem;
            line-height: 0.4rem;
            border-radius: 0.2rem;
            font-size: 0.16rem;
            font-family: PingFangSC-Regular, PingFang SC;
            font-weight: 400;
        }

        .bt-popup-bottom {
            background-color: #ffffff;
            position:relative;
        }

        .bt-popup-container {
            position: relative;
            background-color: #fff;
            max-height: calc(100% - 0.5rem);
            overflow-y: auto;
        }

        .ui-sp-btn > input{
            /*margin-left: 0.01rem;*/
            font-size: 0.12rem;
            font-family:苹方-简 常规体;
            font-weight:400;
            color:#333333;
            width: 1.11rem;
        }


        .ui-form-item input{
            padding-left: 0.16rem;
        }

        .ui-tab-nav li {
            text-align: left;
        }
        .box-head{
            height: 1.26rem;
            margin-top: 0.1rem;
            margin-left: 0.15rem;
            margin-right: 0.15rem;
            background:rgba(255,255,255,1);
            box-shadow:0 0 0.04rem 0 rgba(178,178,178,0.2);
            border-radius:0.04rem;
        }
        .box-left-style{
            background-color: #2988FF;
            float: left;
            width: 0.04rem;
            height: 1.26rem;
            border-bottom-left-radius: 0.04rem;
            border-top-left-radius: 0.04rem;
        }
        .box-left-info-icon{
            width:0.16rem;
            height:0.14rem;
            background-repeat: no-repeat;
            background-size: contain;
            display: inline-block;
            background-color: #2988FF;
            padding: 0.035rem 0.03rem 0.035rem 0.03rem;
            border-radius: 50%;
        }
        .box-left-info-icon img{
            margin-left: 0.02rem;
            width:0.13rem;
        }
        .box-left-info-title{
            position: absolute;
            margin-left: 0.2rem;
            margin-top: 0.16rem;
            font-size:0.16rem;
            font-family:PingFangSC-Medium,PingFang SC;
            font-weight:500;
            color:rgba(41,136,255,1);
            line-height:0.16rem;
        }
        .box-left-info-item{
            position: absolute;
            margin-left: 0.2rem;
            margin-top: 0.49rem;
            font-size:0.14rem;
            font-family:PingFangSC-Medium,PingFang SC;
            font-weight:400;
            color:#333333;
            line-height:0.14rem;
        }
        .box-right-item{
            position: absolute;
            margin-left: 67%;
            font-size:0.12rem;
            font-family:PingFangSC-Regular,PingFang SC;
            font-weight:400;
            color:rgba(153,153,153,1);
            line-height:0.12rem;
            margin-top: 0.49rem;
        }

        .box-body{
            padding: 0.15rem 0 0.15rem 0;
            border-right: 1px solid rgb(95,153,242);
            display: inline-block;
            text-align: center;
            overflow-x:auto;
            width: 1rem;
            background:rgba(41,136,255,0.6);
            font-size: 12px;
        }

        .box-data{
            background-color: #ffffff;
            border-right: 1px solid #D4DADF;
            border-bottom:1px solid #D4DADF;
        }
    </style>

</head>

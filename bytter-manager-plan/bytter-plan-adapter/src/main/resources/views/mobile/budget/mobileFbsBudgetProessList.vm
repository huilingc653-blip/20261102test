    <div class="data-content" style="margin-bottom: 0.1rem; height: calc(100% - 2rem);overflow-y: auto;" id="tableList">
        <div id="sp-list" class="data-table" >
            <!--1.0 冻列 -->
            <div class="t_l" style="width: 100px;">
                <!--1.1 冻结列表头-->
                <table>
                    <tbody id="biBody">
                    <tr>
                        <th>科目代码</th>
                    </tr>
                    </tbody>
                </table>
                <!--1.2 冻结列表体-->
                <div class="t_l_freeze">
                    <table width="100%">
                        <tbody id="biLeft">
                            #foreach($report in $reportList)
                            <tr>
                                <td>$!{report.itemCode}</td>
                            </tr>
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
            <!--2.0 表格-->
            <div class="t_r" style="margin-left: 100px;">
                <!--2.1　冻结行表头-->
                <div class="t_r_t">
                    <table style="width: 700px;">
                        <tbody id="biHead">
                        <tr>
                            <th>名称</th>
                            <th class="col1">上报</th>
                            <th class="col2">追加金额(已追加)</th>
                            <th class="col3">追加金额(在途)</th>
                            <th class="col4">上报合计金额</th>
                            <th class="col5">执行金额(内部-占用)</th>
                            <th class="col6">执行金额(内部-在途)</th>
                            <th class="col7">执行金额(外部-占用)</th>
                            <th class="col8">执行金额(外部-在途)</th>
                            <th class="col9">可用金额</th>
                            <th class="col10">执行比例</th>
                            <th class="col11">误差率</th>
                            <th class="col12">可用金额占比</th>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <!--2.2 表格中心内容区域-->
                <div class="t_r_content">
                    <table style="width: 700px;">
                        <tbody id="biRight">
                            #foreach($report in $reportList)
                            <tr>
                                <td>$!{report.itemName}</td>
                                <td class="col1" style="text-align: right">$!number.formatNumeric($!{report.bMoney})&nbsp;</td>
                                <td class="col2" style="text-align: right">$!number.formatNumeric($!{report.bsuperMoney})&nbsp;</td>
                                <td class="col3" style="text-align: right">$!number.formatNumeric($!{report.btempMoney})&nbsp;</td>
                                <td class="col4" style="text-align: right">$!number.formatNumeric($!{report.bMoneySum})&nbsp;</td>
                                <td class="col5" style="text-align: right"><a class="" href="#" data-row="$!{velocityCount}" onclick="openProcess($report.itemCode,95, 1)"> $!number.formatNumeric($!{report.inProcessMoney}) </a>&nbsp;</td>
                                <td class="col6" style="text-align: right"><a class="" href="#" data-row="$!{velocityCount}" onclick="openProcess($report.itemCode,0, 1)"> $!number.formatNumeric($!{report.inTempProcessMoney})</a>&nbsp;</td>
                                <td class="col7" style="text-align: right"><a class="" href="#" data-row="$!{velocityCount}" onclick="openProcess($report.itemCode,95, 0)"> $!number.formatNumeric($!{report.outProcessMoney})</a>&nbsp;</td>
                                <td class="col8" style="text-align: right"><a class="" href="#" data-row="$!{velocityCount}" onclick="openProcess($report.itemCode,0, 0)"> $!number.formatNumeric($!{report.outTempProcessMoney})</a>&nbsp;</td>
                                <td class="col9" style="text-align: right">$!number.formatNumeric($!{report.canBMoney})&nbsp;</td>
                                <td class="col10" style="text-align: right">$!number.formatNumeric($!{report.exerciseRatio})&nbsp;</td>
                                <td class="col11" style="text-align: right">$!number.formatNumeric($!{report.errorRate})&nbsp;</td>
                                <td class="col12" style="text-align: right">$!number.formatNumeric($!{report.canBMoneyRatio})&nbsp;</td>
                            </tr>
                            #end
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div id="sp-map" class="chart-wrapper" style="display: none;margin-left: 0px">
        </div>
        <div></div>

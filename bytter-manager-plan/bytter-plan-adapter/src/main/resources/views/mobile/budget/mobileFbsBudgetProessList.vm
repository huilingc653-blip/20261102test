<section class="cho-body ui-container">
    <input type="hidden" name="timeType" id="timeType" value="$!{fbsBudgetVO.timeType}"/>
    <input type="hidden" name="corpId" id="corpId" value="${fbsBudgetVO.corpId}"/>
    <input type="hidden" name="beginDate" id="beginDate"

<script>
    (function (doc, win) {
        $('.ui-tab-nav > li').on('click', function () {
            $(this).addClass('current').siblings('li').removeClass('current');
            $('.ui-tab-content>li').removeClass('bt-show');
            $('.ui-tab-content li').eq($(this).index()).addClass('bt-show');
            initChart('pieChart' + $(this).index());
        })

        //弹框选择
        function addSheet($this,id){
            if( $this.parent().hasClass('active')){
                hideSheet($this);
                return
            }
            $('.ui-actionsheet').removeClass('show');
            $('.bt-select-popup').removeClass('active');
                $this.parent().addClass('active');
            $(id).addClass('show');
        }
        //弹框选择
        function hideSheet($this){
            $('.ui-actionsheet').removeClass('show');
                $this.parent().removeClass('active');
        }

        //业务类别控制
        $("#btn1").click(function () {
            addSheet($(this),'#actionsheet1')
        });
        var ACTIVE = 'active';
        function initCard(id,value,clickCallback,isNotInit){
            if(!id){
                return
            }
            var $card = $(id);
            var hiddenInput = $card.find('.bt-card-header input');
            var items = $card.find('.bt-card-item');
            items.removeClass(ACTIVE);
            hiddenInput.val('');
            //设置选中值
            if (value) {
                var valueStr = value.split(",");
                for(var j=0;j<valueStr.length;j++) {
                    for (var i = 0; i < items.length; i++) {
                        if (valueStr[j] == $(items[i]).data('value')) {
                            $(items[i]).addClass(ACTIVE);
                            var hiddenValue = hiddenInput.val();
                            if (isNotEmpty(hiddenValue)) {
                                hiddenInput.val(hiddenInput.val() + "," + valueStr[j]);
                            } else {
                                hiddenInput.val(valueStr[j]);
                            }
                            break;
                        }
                    }
                }
                for(var i=1;i<=12;i++){
                    $(".col"+i).hide();
                }
                for(var i = 0; i<valueStr.length;i++){
                    $(".col"+valueStr[i]).show();
                }
            }
            if(isNotInit){
                return;
            }

            $(id).on('click', '.bt-card-item', function () {
                var value = '';
                var isHas = false;
                if ($(this).hasClass(ACTIVE)) { //如果当前被选中时，点击会取消选中
                    $(this).removeClass(ACTIVE);
                } else {
                    $(this).addClass(ACTIVE);
                    isHas = true;
                }
                value = $(this).data('value');
                var hiddenValue = hiddenInput.val();
                if (isNotEmpty(hiddenValue)) {
                    if (isHas) {
                        hiddenInput.val(hiddenInput.val() + "," + value);
                    }else {
                        hiddenInput.val(hiddenInput.val().replace(value,""));
                    }
                } else {
                    if (isHas) {
                        hiddenInput.val(value);
                    }else{
                        hiddenInput.val(hiddenInput.val().replace(value,""));
                    }
                }
                if (clickCallback) {
                    clickCallback(value);
                }
            })
        }
        //初始化
        initCard('#voucherFrom','1,2,3,4,7,8');
        //点击确定
        $('.submitBtn').on('click',function(){
            var btn = $(this).parents('.ui-actionsheet').removeClass('show')
                    .data('link');
            $('#'+btn).removeClass('active');
            // //确认提交
            var col = $("#col").val();
            var show = col.split(",");
            for(var i=1;i<=12;i++){
                $(".col"+i).hide();
            }
            for(var i = 0; i<show.length;i++){
                $(".col"+show[i]).show();
            }
            var widthStr = show.length*100+100;
            adjustHeight();
            initTableSize(widthStr+'px');
        })
        //点击重置
        $('#clearValue1').on('click',function(){
            initCard('#voucherFrom','','',true);
        })

        /**
         * 为空判断
         * @param stringData
         * @returns {boolean}
         */
        function isEmpty(stringData) {
            if (null == stringData || stringData == "" || stringData == undefined || stringData == " ") {
                return true;
            } else {
                return false;
            }
        }

        /**
         * 非空判断
         * @param stringData
         * @returns {boolean}
         */
        function isNotEmpty(stringData) {
            return !isEmpty(stringData)
        }
    })(document, window);

    function openProcess(itemCode, status, innerSign) {
        var statusFlag = "95" == status;
        var innerSignFlag = "1" == innerSign;
        var url = "/mobile/budget/fbsbudget/mobileFbsBudgetProessDetailList";
        var beginDate = $("#beginDate").val();
        var endDate = $("#endDate").val();
        var corpId = $("#corpId").val();
        setTimeout(function () {
            var data = BTAppBridge.jump({url: url, itemCode: itemCode,corpId:corpId,statusFlag:statusFlag,innerSignFlag:innerSignFlag,beginDate:beginDate,endDate:endDate});
            uni.postMessage({
                data:data
            })
        }, 100);
    }
</script>
</body>
</html>
